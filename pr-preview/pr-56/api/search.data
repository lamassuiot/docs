_42621":118851,"_5":43098,"_30085":187776,"_28538":187777,"_5847":187778},[],"/docs/pr-preview/pr-56/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_6944":118854,"_42621":118851,"_5":43098,"_30085":187780,"_28538":187781,"_5847":187782},[],"/docs/pr-preview/pr-56/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_6944":118855,"_42621":118851,"_5":43098,"_30085":187784,"_28538":187785,"_5847":187786},[],"/docs/pr-preview/pr-56/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_6944":118856,"_42621":118851,"_5":43098,"_30085":187788,"_28538":187789,"_5847":187790},[],"/docs/pr-preview/pr-56/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_6944":118857,"_42621":118851,"_5":43098,"_30085":187792,"_28538":187793,"_5847":187794},[],"/docs/pr-preview/pr-56/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_6944":118858,"_42621":118851,"_5":43098,"_30085":187796,"_28538":187797,"_5847":187798},[],"/docs/pr-preview/pr-56/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_6944":118859,"_42621":118851,"_5":43098,"_30085":187800,"_28538":187801,"_5847":187802},[],"/docs/pr-preview/pr-56/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_6944":118860,"_42621":118851,"_30085":187804,"_5":21646,"_28538":118851,"_5847":187805},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_6944":118861,"_42621":118851,"_30085":187807,"_5":21646,"_28538":187777,"_5847":187808},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_6944":118862,"_42621":118851,"_30085":187810,"_5":21646,"_28538":187777,"_5847":187811},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_6944":118863,"_42621":118851,"_30085":187813,"_5":21646,"_28538":187777,"_5847":187814},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_6944":118864,"_42621":118851,"_30085":187816,"_5":21646,"_28538":187781,"_5847":187817},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_6944":118865,"_42621":118851,"_30085":187819,"_5":21646,"_28538":187781,"_5847":187820},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_6944":118866,"_42621":118851,"_30085":187822,"_5":21646,"_28538":187781,"_5847":187823},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_6944":118867,"_42621":118851,"_30085":187825,"_5":21646,"_28538":187785,"_5847":187826},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_6944":118868,"_42621":118851,"_30085":187828,"_5":21646,"_28538":187789,"_5847":187829},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_6944":118869,"_42621":118851,"_30085":187831,"_5":21646,"_28538":187793,"_5847":187832},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_6944":118870,"_42621":118851,"_30085":187834,"_5":21646,"_28538":187797,"_5847":187835},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_6944":118871,"_42621":118851,"_30085":187837,"_5":21646,"_28538":187801,"_5847":187838},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_6944":118872,"_42621":118872,"_5":22076,"_5847":187840,"_43101":187841,"_30085":187842,"_28538":118872},"Despliega Lamassu",[78004,187769],[],{"_6944":118873,"_42621":118872,"_30085":187844,"_5":21646,"_28538":118872,"_5847":187845},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_6944":118874,"_42621":118872,"_5":43098,"_30085":187847,"_28538":187848,"_5847":187849},[],"/docs/pr-preview/pr-56/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_6944":118875,"_42621":118872,"_5":43098,"_30085":187851,"_28538":187852,"_5847":187853},[],"/docs/pr-preview/pr-56/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_6944":118876,"_42621":118872,"_5":43098,"_30085":187855,"_28538":187856,"_5847":187857},[],"/docs/pr-preview/pr-56/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_6944":118877,"_42621":118872,"_30085":187859,"_5":21646,"_28538":118872,"_5847":187860},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_6944":118878,"_42621":118872,"_30085":187862,"_5":21646,"_28538":187848,"_5847":187863},[],"Modelo",{"_6944":118879,"_42621":118872,"_30085":187865,"_5":21646,"_28538":187848,"_5847":187866},[],"Recomendado para",{"_6944":118880,"_42621":118872,"_30085":187868,"_5":21646,"_28538":187848,"_5847":187869},[],"Quién opera la infraestructura",{"_6944":118881,"_42621":118872,"_30085":187871,"_5":21646,"_28538":187848,"_5847":187872},[],"Punto de partida",{"_6944":118882,"_42621":118872,"_30085":187874,"_5":21646,"_28538":187848,"_5847":78111},[],{"_6944":118883,"_42621":118872,"_30085":187876,"_5":21646,"_28538":187848,"_5847":187877},[],"Producción, entornos regulados y despliegues personalizados",{"_6944":118884,"_42621":118872,"_30085":187879,"_5":21646,"_28538":187848,"_5847":187880},[],"Tu equipo",{"_6944":118885,"_42621":118872,"_30085":187882,"_5":21646,"_28538":187848,"_5847":187883},[],"Helm o Fastlane",{"_6944":118886,"_42621":118872,"_30085":187885,"_5":21646,"_28538":187848,"_5847":78123},[],{"_6944":118887,"_42621":118872,"_30085":187887,"_5":21646,"_28538":187848,"_5847":187888},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_6944":118888,"_42621":118872,"_30085":187890,"_5":21646,"_28538":187848,"_5847":187880},[],{"_6944":118889,"_42621":118872,"_30085":187892,"_5":21646,"_28538":187848,"_5847":187893},[],"Imagen preconfigurada en EC2",{"_6944":118890,"_42621":118872,"_30085":187895,"_5":21646,"_28538":187848,"_5847":78134},[],{"_6944":118891,"_42621":118872,"_30085":187897,"_5":21646,"_28538":187848,"_5847":187898},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_6944":118892,"_42621":118872,"_30085":187900,"_5":21646,"_28538":187848,"_5847":78140},[],{"_6944":118893,"_42621":118872,"_30085":187902,"_5":21646,"_28538":187848,"_5847":187903},[],"Suscripción gestionada",{"_6944":118894,"_42621":118872,"_30085":187905,"_5":21646,"_28538":187848,"_5847":187906},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_6944":118895,"_42621":118872,"_30085":187908,"_5":21646,"_28538":187848,"_5847":187909},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_6944":118896,"_42621":118872,"_30085":187911,"_5":21646,"_28538":187848,"_5847":187912},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_6944":118897,"_42621":118872,"_30085":187914,"_5":21646,"_28538":187852,"_5847":187915},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_6944":118898,"_42621":118872,"_30085":187917,"_5":21646,"_28538":187856,"_5847":187918},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_6944":118899,"_42621":118899,"_5":22076,"_5847":187920,"_43101":187921,"_30085":187922,"_28538":118899},"Utiliza Lamassu como SaaS",[78004,187769,187770],[],{"_6944":118900,"_42621":118899,"_30085":187924,"_5":21646,"_28538":118899,"_5847":187925},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_6944":118901,"_42621":118899,"_5":43098,"_30085":187927,"_28538":187928,"_5847":187929},[],"/docs/pr-preview/pr-56/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_6944":118902,"_42621":118899,"_5":43098,"_30085":187931,"_28538":187932,"_5847":187933},[],"/docs/pr-preview/pr-56/es/deployment/saas#planes","Planes",{"_6944":118903,"_42621":118899,"_5":43098,"_30085":187935,"_28538":187936,"_5847":187937},[],"/docs/pr-preview/pr-56/es/deployment/saas#solicita-acceso","Solicita acceso",{"_6944":118904,"_42621":118899,"_30085":187939,"_5":21646,"_28538":118899,"_5847":187940},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_6944":118905,"_42621":118899,"_30085":187942,"_5":21646,"_28538":187928,"_5847":187943},[],"Disponibilidad y mantenimiento de la plataforma.",{"_6944":118906,"_42621":118899,"_30085":187945,"_5":21646,"_28538":187928,"_5847":187946},[],"Copias de seguridad automáticas.",{"_6944":118907,"_42621":118899,"_30085":187948,"_5":21646,"_28538":187928,"_5847":187949},[],"Actualizaciones de versión.",{"_6944":118908,"_42621":118899,"_30085":187951,"_5":21646,"_28538":187928,"_5847":187952},[],"Soporte técnico y SLA según el plan contratado.",{"_6944":118909,"_42621":118899,"_30085":187954,"_5":21646,"_28538":187932,"_5847":78195},[],{"_6944":118910,"_42621":118899,"_30085":187956,"_5":21646,"_28538":187932,"_5847":187957},[],"Dispositivos",{"_6944":118911,"_42621":118899,"_30085":187959,"_5":21646,"_28538":187932,"_5847":187960},[],"Soporte",{"_6944":118912,"_42621":118899,"_30085":187962,"_5":21646,"_28538":187932,"_5847":78204},[],{"_6944":118913,"_42621":118899,"_30085":187964,"_5":21646,"_28538":187932,"_5847":78207},[],{"_6944":118914,"_42621":118899,"_30085":187966,"_5":21646,"_28538":187932,"_5847":187967},[],"Hasta 1.000",{"_6944":118915,"_42621":118899,"_30085":187969,"_5":21646,"_28538":187932,"_5847":78213},[],{"_6944":118916,"_42621":118899,"_30085":187971,"_5":21646,"_28538":187932,"_5847":187972},[],"99,5 %",{"_6944":118917,"_42621":118899,"_30085":187974,"_5":21646,"_28538":187932,"_5847":78219},[],{"_6944":118918,"_42621":118899,"_30085":187976,"_5":21646,"_28538":187932,"_5847":187977},[],"Hasta 10.000",{"_6944":118919,"_42621":118899,"_30085":187979,"_5":21646,"_28538":187932,"_5847":187980},[],"Email y chat",{"_6944":118920,"_42621":118899,"_30085":187982,"_5":21646,"_28538":187932,"_5847":187983},[],"99,9 %",{"_6944":118921,"_42621":118899,"_30085":187985,"_5":21646,"_28538":187932,"_5847":78231},[],{"_6944":118922,"_42621":118899,"_30085":187987,"_5":21646,"_28538":187932,"_5847":187988},[],"Ilimitados",{"_6944":118923,"_42621":118899,"_30085":187990,"_5":21646,"_28538":187932,"_5847":187991},[],"Dedicado",{"_6944":118924,"_42621":118899,"_30085":187993,"_5":21646,"_28538":187932,"_5847":187994},[],"99,99 %",{"_6944":118925,"_42621":118899,"_30085":187996,"_5":21646,"_28538":187936,"_5847":187997},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_6944":118926,"_42621":118899,"_30085":187999,"_5":21646,"_28538":187936,"_5847":188000},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_6944":118927,"_42621":118927,"_5":22076,"_5847":78248,"_43101":188002,"_30085":188004,"_28538":118927},[78004,187769,188003],"Kubernetes autogestionado",[],{"_6944":118928,"_42621":118927,"_30085":188006,"_5":21646,"_28538":118927,"_5847":188007},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_6944":118929,"_42621":118927,"_5":43098,"_30085":188009,"_28538":188010,"_5847":188011},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_6944":118930,"_42621":118927,"_5":43098,"_30085":188013,"_28538":188014,"_5847":188015},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_6944":118931,"_42621":118927,"_5":43098,"_30085":188017,"_28538":188018,"_5847":188019},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_6944":118932,"_42621":118927,"_5":43098,"_30085":188021,"_28538":188022,"_5847":188023},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_6944":118933,"_42621":118927,"_5":43098,"_30085":188025,"_28538":188026,"_5847":188027},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_6944":118934,"_42621":118927,"_5":43098,"_30085":188029,"_28538":188030,"_5847":188031},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_6944":118935,"_42621":118927,"_5":43098,"_30085":188033,"_28538":188034,"_5847":188035},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_6944":118936,"_42621":118927,"_5":43098,"_30085":188037,"_28538":188038,"_5847":188039},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_6944":118937,"_42621":118927,"_5":43098,"_30085":188041,"_28538":188042,"_5847":188043},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_6944":118938,"_42621":118927,"_5":43098,"_30085":188045,"_28538":188046,"_5847":188047},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_6944":118939,"_42621":118927,"_5":43098,"_30085":188049,"_28538":188050,"_5847":188051},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_6944":118940,"_42621":118927,"_30085":188053,"_5":21646,"_28538":188010,"_5847":188054},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_6944":118941,"_42621":118927,"_30085":188056,"_5":21646,"_28538":188010,"_5847":188057},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_6944":118942,"_42621":118927,"_30085":188059,"_5":21646,"_28538":188014,"_5847":188060},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_6944":118943,"_42621":118927,"_30085":188062,"_5":21646,"_28538":188014,"_5847":188063},[],"Fastlane instala o configura",{"_6944":118944,"_42621":118927,"_30085":188065,"_5":21646,"_28538":188014,"_5847":188066},[],"Tú sigues proporcionando",{"_6944":118945,"_42621":118927,"_30085":188068,"_5":21646,"_28538":188014,"_5847":188069},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_6944":118946,"_42621":118927,"_30085":188071,"_5":21646,"_28538":188014,"_5847":188072},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_6944":118947,"_42621":118927,"_30085":188074,"_5":21646,"_28538":188014,"_5847":188075},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_6944":118948,"_42621":118927,"_30085":188077,"_5":21646,"_28538":188014,"_5847":188078},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_6944":118949,"_42621":118927,"_30085":188080,"_5":21646,"_28538":188014,"_5847":188081},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_6944":118950,"_42621":118927,"_30085":188083,"_5":21646,"_28538":188014,"_5847":188084},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_6944":118951,"_42621":118927,"_30085":188086,"_5":21646,"_28538":188014,"_5847":188087},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_6944":118952,"_42621":118927,"_30085":188089,"_5":21646,"_28538":188014,"_5847":188090},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_6944":118953,"_42621":118927,"_30085":188092,"_5":21646,"_28538":188014,"_5847":188093},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_6944":118954,"_42621":118927,"_30085":188095,"_5":21646,"_28538":188018,"_5847":188096},[],"Necesitas:",{"_6944":118955,"_42621":118927,"_30085":188098,"_5":21646,"_28538":188018,"_5847":188099},[],"un clúster Kubernetes existente",{"_6944":118956,"_42621":118927,"_30085":188101,"_5":21646,"_28538":188018,"_5847":188102},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_6944":118957,"_42621":118927,"_30085":188104,"_5":21646,"_28538":188018,"_5847":78350},[],{"_6944":118958,"_42621":118927,"_30085":188106,"_5":21646,"_28538":188018,"_5847":33363},[],{"_6944":118959,"_42621":118927,"_30085":188108,"_5":21646,"_28538":188018,"_5847":188109},[],"`jq` solo si usas `--sample-data` o `--development`",{"_6944":118960,"_42621":118927,"_30085":188111,"_5":21646,"_28538":188018,"_5847":188112},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_6944":118961,"_42621":118927,"_30085":188114,"_5":21646,"_28538":188018,"_5847":188115},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_6944":118962,"_42621":118927,"_30085":188117,"_5":21646,"_28538":188018,"_5847":188118},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_6944":118963,"_42621":118927,"_30085":188120,"_5":21646,"_28538":188018,"_5847":188121},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_6944":118964,"_42621":118927,"_30085":188123,"_5":21646,"_28538":188022,"_5847":188124},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_6944":118965,"_42621":118927,"_30085":188126,"_5":21646,"_28538":188022,"_5847":188127},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_6944":118966,"_42621":118927,"_30085":188129,"_5":21646,"_28538":188026,"_5847":188130},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_6944":118967,"_42621":118927,"_30085":188132,"_5":21646,"_28538":188026,"_5847":188133},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_6944":118968,"_42621":118927,"_30085":188135,"_5":21646,"_28538":188026,"_5847":188136},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_6944":118969,"_42621":118927,"_30085":188138,"_5":21646,"_28538":188026,"_5847":188139},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_6944":118970,"_42621":118927,"_30085":188141,"_5":21646,"_28538":188030,"_5847":188142},[],"Opción",{"_6944":118971,"_42621":118927,"_30085":188144,"_5":21646,"_28538":188030,"_5847":188145},[],"Valor predeterminado",{"_6944":118972,"_42621":118927,"_30085":188147,"_5":21646,"_28538":188030,"_5847":188148},[],"Propósito",{"_6944":118973,"_42621":118927,"_30085":188150,"_5":21646,"_28538":188030,"_5847":78397},[],{"_6944":118974,"_42621":118927,"_30085":188152,"_5":21646,"_28538":188030,"_5847":78400},[],{"_6944":118975,"_42621":118927,"_30085":188154,"_5":21646,"_28538":188030,"_5847":188155},[],"Muestra la ayuda",{"_6944":118976,"_42621":118927,"_30085":188157,"_5":21646,"_28538":188030,"_5847":78406},[],{"_6944":118977,"_42621":118927,"_30085":188159,"_5":21646,"_28538":188030,"_5847":188160},[],"contexto actual",{"_6944":118978,"_42621":118927,"_30085":188162,"_5":21646,"_28538":188030,"_5847":188163},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_6944":118979,"_42621":118927,"_30085":188165,"_5":21646,"_28538":188030,"_5847":78415},[],{"_6944":118980,"_42621":118927,"_30085":188167,"_5":21646,"_28538":188030,"_5847":11430},[],{"_6944":118981,"_42621":118927,"_30085":188169,"_5":21646,"_28538":188030,"_5847":188170},[],"Omite prompts y genera credenciales para las dependencias",{"_6944":118982,"_42621":118927,"_30085":188172,"_5":21646,"_28538":188030,"_5847":78423},[],{"_6944":118983,"_42621":118927,"_30085":188174,"_5":21646,"_28538":188030,"_5847":78426},[],{"_6944":118984,"_42621":118927,"_30085":188176,"_5":21646,"_28538":188030,"_5847":188177},[],"Namespace de la instalación",{"_6944":118985,"_42621":118927,"_30085":188179,"_5":21646,"_28538":188030,"_5847":78432},[],{"_6944":118986,"_42621":118927,"_30085":188181,"_5":21646,"_28538":188030,"_5847":78435},[],{"_6944":118987,"_42621":118927,"_30085":188183,"_5":21646,"_28538":188030,"_5847":188184},[],"Dominio usado por la UI, OIDC y el certificado",{"_6944":118988,"_42621":118927,"_30085":188186,"_5":21646,"_28538":188030,"_5847":78441},[],{"_6944":118989,"_42621":118927,"_30085":188188,"_5":21646,"_28538":188030,"_5847":22738},[],{"_6944":118990,"_42621":118927,"_30085":188190,"_5":21646,"_28538":188030,"_5847":188191},[],"Versión del chart de Lamassu",{"_6944":118991,"_42621":118927,"_30085":188193,"_5":21646,"_28538":188030,"_5847":78449},[],{"_6944":118992,"_42621":118927,"_30085":188195,"_5":21646,"_28538":188030,"_5847":78452},[],{"_6944":118993,"_42621":118927,"_30085":188197,"_5":21646,"_28538":188030,"_5847":188198},[],"Puerto del listener HTTPS",{"_6944":118994,"_42621":118927,"_30085":188200,"_5":21646,"_28538":188030,"_5847":78458},[],{"_6944":118995,"_42621":118927,"_30085":188202,"_5":21646,"_28538":188030,"_5847":78461},[],{"_6944":118996,"_42621":118927,"_30085":188204,"_5":21646,"_28538":188030,"_5847":188205},[],"Puerto del listener HTTP",{"_6944":118997,"_42621":118927,"_30085":188207,"_5":21646,"_28538":188030,"_5847":78467},[],{"_6944":118998,"_42621":118927,"_30085":188209,"_5":21646,"_28538":188030,"_5847":78400},[],{"_6944":118999,"_42621":118927,"_30085":188211,"_5":21646,"_28538":188030,"_5847":188212},[],"Certificado PEM para TLS downstream",{"_6944":119000,"_42621":118927,"_30085":188214,"_5":21646,"_28538":188030,"_5847":78475},[],{"_6944":119001,"_42621":118927,"_30085":188216,"_5":21646,"_28538":188030,"_5847":78400},[],{"_6944":119002,"_42621":118927,"_30085":188218,"_5":21646,"_28538":188030,"_5847":188219},[],"Clave privada PEM para TLS downstream",{"_6944":119003,"_42621":118927,"_30085":188221,"_5":21646,"_28538":188030,"_5847":78483},[],{"_6944":119004,"_42621":118927,"_30085":188223,"_5":21646,"_28538":188030,"_5847":188224},[],"chart del repositorio",{"_6944":119005,"_42621":118927,"_30085":188226,"_5":21646,"_28538":188030,"_5847":188227},[],"Usa un chart local de Lamassu sin empaquetar",{"_6944":119006,"_42621":118927,"_30085":188229,"_5":21646,"_28538":188030,"_5847":78492},[],{"_6944":119007,"_42621":118927,"_30085":188231,"_5":21646,"_28538":188030,"_5847":188232},[],"detección automática",{"_6944":119008,"_42621":118927,"_30085":188234,"_5":21646,"_28538":188030,"_5847":188235},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_6944":119009,"_42621":118927,"_30085":188237,"_5":21646,"_28538":188030,"_5847":78500},[],{"_6944":119010,"_42621":118927,"_30085":188239,"_5":21646,"_28538":188030,"_5847":11430},[],{"_6944":119011,"_42621":118927,"_30085":188241,"_5":21646,"_28538":188030,"_5847":188242},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_6944":119012,"_42621":118927,"_30085":188244,"_5":21646,"_28538":188030,"_5847":78508},[],{"_6944":119013,"_42621":118927,"_30085":188246,"_5":21646,"_28538":188030,"_5847":11430},[],{"_6944":119014,"_42621":118927,"_30085":188248,"_5":21646,"_28538":188030,"_5847":188249},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_6944":119015,"_42621":118927,"_30085":188251,"_5":21646,"_28538":188030,"_5847":78516},[],{"_6944":119016,"_42621":118927,"_30085":188253,"_5":21646,"_28538":188030,"_5847":11430},[],{"_6944":119017,"_42621":118927,"_30085":188255,"_5":21646,"_28538":188030,"_5847":188256},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_6944":119018,"_42621":118927,"_30085":188258,"_5":21646,"_28538":188030,"_5847":78524},[],{"_6944":119019,"_42621":118927,"_30085":188260,"_5":21646,"_28538":188030,"_5847":11430},[],{"_6944":119020,"_42621":118927,"_30085":188262,"_5":21646,"_28538":188030,"_5847":188263},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_6944":119021,"_42621":118927,"_30085":188265,"_5":21646,"_28538":188030,"_5847":78532},[],{"_6944":119022,"_42621":118927,"_30085":188267,"_5":21646,"_28538":188030,"_5847":78535},[],{"_6944":119023,"_42621":118927,"_30085":188269,"_5":21646,"_28538":188030,"_5847":188270},[],"Usa otro chart local de SoftHSM",{"_6944":119024,"_42621":118927,"_30085":188272,"_5":21646,"_28538":188030,"_5847":188273},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_6944":119025,"_42621":118927,"_30085":188275,"_5":21646,"_28538":188034,"_5847":188276},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_6944":119026,"_42621":118927,"_30085":188278,"_5":21646,"_28538":188034,"_5847":188279},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_6944":119027,"_42621":118927,"_30085":188281,"_5":21646,"_28538":188034,"_5847":188282},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_6944":119028,"_42621":118927,"_30085":188284,"_5":21646,"_28538":188034,"_5847":188285},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_6944":119029,"_42621":118927,"_30085":188287,"_5":21646,"_28538":188034,"_5847":188288},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_6944":119030,"_42621":118927,"_30085":188290,"_5":21646,"_28538":188034,"_5847":188291},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_6944":119031,"_42621":118927,"_30085":188293,"_5":21646,"_28538":188038,"_5847":78562},[],{"_6944":119032,"_42621":118927,"_30085":188295,"_5":21646,"_28538":188038,"_5847":188296},[],"valida las herramientas locales y el clúster seleccionado",{"_6944":119033,"_42621":118927,"_30085":188298,"_5":21646,"_28538":188038,"_5847":188299},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_6944":119034,"_42621":118927,"_30085":188301,"_5":21646,"_28538":188038,"_5847":188302},[],"crea el namespace",{"_6944":119035,"_42621":118927,"_30085":188304,"_5":21646,"_28538":188038,"_5847":188305},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_6944":119036,"_42621":118927,"_30085":188307,"_5":21646,"_28538":188038,"_5847":188308},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_6944":119037,"_42621":118927,"_30085":188310,"_5":21646,"_28538":188038,"_5847":188311},[],"instala RabbitMQ",{"_6944":119038,"_42621":118927,"_30085":188313,"_5":21646,"_28538":188038,"_5847":188314},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_6944":119039,"_42621":118927,"_30085":188316,"_5":21646,"_28538":188038,"_5847":188317},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_6944":119040,"_42621":118927,"_30085":188319,"_5":21646,"_28538":188038,"_5847":188320},[],"carga datos de ejemplo opcionalmente",{"_6944":119041,"_42621":118927,"_30085":188322,"_5":21646,"_28538":188038,"_5847":188323},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_6944":119042,"_42621":118927,"_30085":188325,"_5":21646,"_28538":188042,"_5847":188326},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_6944":119043,"_42621":118927,"_30085":188328,"_5":21646,"_28538":188042,"_5847":188329},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_6944":119044,"_42621":118927,"_30085":188331,"_5":21646,"_28538":188046,"_5847":188332},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_6944":119045,"_42621":118927,"_30085":188334,"_5":21646,"_28538":188046,"_5847":188335},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_6944":119046,"_42621":118927,"_30085":188337,"_5":21646,"_28538":188046,"_5847":188338},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_6944":119047,"_42621":118927,"_30085":188340,"_5":21646,"_28538":188050,"_5847":188341},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_6944":119048,"_42621":119048,"_5":22076,"_5847":188343,"_43101":188344,"_30085":188345,"_28538":119048},"Instala con Helm",[78004,187769,188003],[],{"_6944":119049,"_42621":119048,"_30085":188347,"_5":21646,"_28538":119048,"_5847":188348},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_6944":119050,"_42621":119048,"_5":43098,"_30085":188350,"_28538":188351,"_5847":188352},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_6944":119051,"_42621":119048,"_5":43098,"_30085":188354,"_28538":188355,"_5847":188019},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/helm#antes-de-comenzar",{"_6944":119052,"_42621":119048,"_5":43098,"_30085":188357,"_28538":188358,"_5847":188359},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_6944":119053,"_42621":119048,"_5":43098,"_30085":188361,"_28538":188362,"_5847":188363},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_6944":119054,"_42621":119048,"_5":43098,"_30085":188365,"_28538":188366,"_5847":188367},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_6944":119055,"_42621":119048,"_5":43098,"_30085":188369,"_28538":188370,"_5847":188371},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_6944":119056,"_42621":119048,"_5":43098,"_30085":188373,"_28538":188374,"_5847":188375},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_6944":119057,"_42621":119048,"_5":43098,"_30085":188377,"_28538":188378,"_5847":188379},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_6944":119058,"_42621":119048,"_5":43098,"_30085":188381,"_28538":188382,"_5847":188383},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_6944":119059,"_42621":119048,"_5":43098,"_30085":188385,"_28538":188386,"_5847":188387},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_6944":119060,"_42621":119048,"_5":43098,"_30085":188389,"_28538":188390,"_5847":188391},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_6944":119061,"_42621":119048,"_30085":188393,"_5":21646,"_28538":188351,"_5847":188394},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_6944":119062,"_42621":119048,"_30085":188396,"_5":21646,"_28538":188355,"_5847":188397},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_6944":119063,"_42621":119048,"_30085":188399,"_5":21646,"_28538":188355,"_5847":188400},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_6944":119064,"_42621":119048,"_30085":188402,"_5":21646,"_28538":188355,"_5847":188403},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_6944":119065,"_42621":119048,"_30085":188405,"_5":21646,"_28538":188355,"_5847":188406},[],"un broker RabbitMQ accesible y sus credenciales",{"_6944":119066,"_42621":119048,"_30085":188408,"_5":21646,"_28538":188355,"_5847":188409},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_6944":119067,"_42621":119048,"_30085":188411,"_5":21646,"_28538":188355,"_5847":188412},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_6944":119068,"_42621":119048,"_30085":188414,"_5":21646,"_28538":188355,"_5847":188415},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_6944":119069,"_42621":119048,"_30085":188417,"_5":21646,"_28538":188355,"_5847":188418},[],"una StorageClass y un diseño de tráfico externo",{"_6944":119070,"_42621":119048,"_30085":188420,"_5":21646,"_28538":188355,"_5847":188421},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_6944":119071,"_42621":119048,"_30085":188423,"_5":21646,"_28538":188355,"_5847":188424},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_6944":119072,"_42621":119048,"_30085":188426,"_5":21646,"_28538":188355,"_5847":188427},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_6944":119073,"_42621":119048,"_30085":188429,"_5":21646,"_28538":188358,"_5847":188430},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_6944":119074,"_42621":119048,"_30085":188432,"_5":21646,"_28538":188358,"_5847":188433},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_6944":119075,"_42621":119048,"_30085":188435,"_5":21646,"_28538":188358,"_5847":188436},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_6944":119076,"_42621":119048,"_30085":188438,"_5":21646,"_28538":188362,"_5847":188439},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_6944":119077,"_42621":119048,"_30085":188441,"_5":21646,"_28538":188362,"_5847":188442},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_6944":119078,"_42621":119048,"_30085":188444,"_5":21646,"_28538":188362,"_5847":188445},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_6944":119079,"_42621":119048,"_30085":188447,"_5":21646,"_28538":188362,"_5847":188448},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_6944":119080,"_42621":119048,"_30085":188450,"_5":21646,"_28538":188366,"_5847":188451},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_6944":119081,"_42621":119048,"_30085":188453,"_5":21646,"_28538":188370,"_5847":188454},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_6944":119082,"_42621":119048,"_30085":188456,"_5":21646,"_28538":188370,"_5847":188457},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_6944":119083,"_42621":119048,"_30085":188459,"_5":21646,"_28538":188370,"_5847":188460},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_6944":119084,"_42621":119048,"_30085":188462,"_5":21646,"_28538":188370,"_5847":188463},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_6944":119085,"_42621":119048,"_30085":188465,"_5":21646,"_28538":188370,"_5847":188466},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_6944":119086,"_42621":119048,"_30085":188468,"_5":21646,"_28538":188370,"_5847":188469},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_6944":119087,"_42621":119048,"_30085":188471,"_5":21646,"_28538":188370,"_5847":188472},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_6944":119088,"_42621":119048,"_30085":188474,"_5":21646,"_28538":188374,"_5847":188475},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_6944":119089,"_42621":119048,"_30085":188477,"_5":21646,"_28538":188374,"_5847":188478},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_6944":119090,"_42621":119048,"_30085":188480,"_5":21646,"_28538":188374,"_5847":188481},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_6944":119091,"_42621":119048,"_30085":188483,"_5":21646,"_28538":188374,"_5847":188484},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_6944":119092,"_42621":119048,"_30085":188486,"_5":21646,"_28538":188378,"_5847":188487},[],"Para instalar un checkout local:",{"_6944":119093,"_42621":119048,"_30085":188489,"_5":21646,"_28538":188382,"_5847":188490},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_6944":119094,"_42621":119048,"_30085":188492,"_5":21646,"_28538":188382,"_5847":188493},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_6944":119095,"_42621":119048,"_30085":188495,"_5":21646,"_28538":188386,"_5847":188496},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_6944":119096,"_42621":119048,"_30085":188498,"_5":21646,"_28538":188386,"_5847":188499},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_6944":119097,"_42621":119048,"_30085":188501,"_5":21646,"_28538":188386,"_5847":188502},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_6944":119098,"_42621":119048,"_30085":188504,"_5":21646,"_28538":188386,"_5847":188505},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_6944":119099,"_42621":119048,"_30085":188507,"_5":21646,"_28538":188386,"_5847":188508},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_6944":119100,"_42621":119048,"_30085":188510,"_5":21646,"_28538":188390,"_5847":188511},[],"Antes de pasar a producción, revisa:",{"_6944":119101,"_42621":119048,"_30085":188513,"_5":21646,"_28538":188390,"_5847":188514},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_6944":119102,"_42621":119048,"_30085":188516,"_5":21646,"_28538":188390,"_5847":188517},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_6944":119103,"_42621":119048,"_30085":188519,"_5":21646,"_28538":188390,"_5847":188520},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_6944":119104,"_42621":119048,"_30085":188522,"_5":21646,"_28538":188390,"_5847":188523},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_6944":119105,"_42621":119048,"_30085":188525,"_5":21646,"_28538":188390,"_5847":188526},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_6944":119106,"_42621":119048,"_30085":188528,"_5":21646,"_28538":188390,"_5847":188529},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_6944":119107,"_42621":119048,"_30085":188531,"_5":21646,"_28538":188390,"_5847":188532},[],"SMTP, observabilidad y entrega de alertas",{"_6944":119108,"_42621":119048,"_30085":188534,"_5":21646,"_28538":188390,"_5847":188535},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_6944":119109,"_42621":119048,"_30085":188537,"_5":21646,"_28538":188390,"_5847":188538},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_6944":119110,"_42621":119110,"_5":22076,"_5847":188540,"_43101":188541,"_30085":188542,"_28538":119110},"Expón el Gateway",[78004,187769,188003],[],{"_6944":119111,"_42621":119110,"_30085":188544,"_5":21646,"_28538":119110,"_5847":188545},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_6944":119112,"_42621":119110,"_5":43098,"_30085":188547,"_28538":188548,"_5847":188549},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_6944":119113,"_42621":119110,"_5":43098,"_30085":188551,"_28538":188552,"_5847":188553},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_6944":119114,"_42621":119110,"_5":43098,"_30085":188555,"_28538":188556,"_5847":188557},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_6944":119115,"_42621":119110,"_5":43098,"_30085":188559,"_28538":188560,"_5847":78830},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/networking#k3s",{"_6944":119116,"_42621":119110,"_5":43098,"_30085":188562,"_28538":188563,"_5847":188564},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_6944":119117,"_42621":119110,"_5":43098,"_30085":188566,"_28538":188567,"_5847":188568},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_6944":119118,"_42621":119110,"_5":43098,"_30085":188570,"_28538":188571,"_5847":188572},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_6944":119119,"_42621":119110,"_5":43098,"_30085":188574,"_28538":188575,"_5847":188576},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_6944":119120,"_42621":119110,"_5":43098,"_30085":188578,"_28538":188579,"_5847":188580},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_6944":119121,"_42621":119110,"_5":43098,"_30085":188582,"_28538":188583,"_5847":188584},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_6944":119122,"_42621":119110,"_30085":188586,"_5":21646,"_28538":188548,"_5847":188587},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_6944":119123,"_42621":119110,"_30085":188589,"_5":21646,"_28538":188548,"_5847":188590},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_6944":119124,"_42621":119110,"_30085":188592,"_5":21646,"_28538":188552,"_5847":188593},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_6944":119125,"_42621":119110,"_30085":188595,"_5":21646,"_28538":188552,"_5847":188596},[],"Defínelo únicamente cuando:",{"_6944":119126,"_42621":119110,"_30085":188598,"_5":21646,"_28538":188552,"_5847":188599},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_6944":119127,"_42621":119110,"_30085":188601,"_5":21646,"_28538":188552,"_5847":188602},[],"esa dirección está asignada a este Gateway",{"_6944":119128,"_42621":119110,"_30085":188604,"_5":21646,"_28538":188552,"_5847":188605},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_6944":119129,"_42621":119110,"_30085":188607,"_5":21646,"_28538":188552,"_5847":188608},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_6944":119130,"_42621":119110,"_30085":188610,"_5":21646,"_28538":188552,"_5847":188611},[],"No confundas estos valores:",{"_6944":119131,"_42621":119110,"_30085":188613,"_5":21646,"_28538":188552,"_5847":188614},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_6944":119132,"_42621":119110,"_30085":188616,"_5":21646,"_28538":188552,"_5847":188617},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_6944":119133,"_42621":119110,"_30085":188619,"_5":21646,"_28538":188552,"_5847":188620},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_6944":119134,"_42621":119110,"_30085":188622,"_5":21646,"_28538":188556,"_5847":188623},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_6944":119135,"_42621":119110,"_30085":188625,"_5":21646,"_28538":188556,"_5847":188626},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_6944":119136,"_42621":119110,"_30085":188628,"_5":21646,"_28538":188560,"_5847":188629},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_6944":119137,"_42621":119110,"_30085":188631,"_5":21646,"_28538":188560,"_5847":188632},[],"Para el diseño recomendado:",{"_6944":119138,"_42621":119110,"_30085":188634,"_5":21646,"_28538":188560,"_5847":188635},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_6944":119139,"_42621":119110,"_30085":188637,"_5":21646,"_28538":188560,"_5847":188638},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_6944":119140,"_42621":119110,"_30085":188640,"_5":21646,"_28538":188560,"_5847":188641},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_6944":119141,"_42621":119110,"_30085":188643,"_5":21646,"_28538":188560,"_5847":188644},[],"Apunta DNS a la dirección accesible de la VM.",{"_6944":119142,"_42621":119110,"_30085":188646,"_5":21646,"_28538":188560,"_5847":188647},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_6944":119143,"_42621":119110,"_30085":188649,"_5":21646,"_28538":188563,"_5847":188650},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_6944":119144,"_42621":119110,"_30085":188652,"_5":21646,"_28538":188567,"_5847":188653},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_6944":119145,"_42621":119110,"_30085":188655,"_5":21646,"_28538":188567,"_5847":188656},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_6944":119146,"_42621":119110,"_30085":188658,"_5":21646,"_28538":188571,"_5847":188659},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_6944":119147,"_42621":119110,"_30085":188661,"_5":21646,"_28538":188571,"_5847":188662},[],"Requisito",{"_6944":119148,"_42621":119110,"_30085":188664,"_5":21646,"_28538":188571,"_5847":188665},[],"Diseño recomendado",{"_6944":119149,"_42621":119110,"_30085":188667,"_5":21646,"_28538":188571,"_5847":188668},[],"Consecuencia",{"_6944":119150,"_42621":119110,"_30085":188670,"_5":21646,"_28538":188571,"_5847":188671},[],"Varias URL o servicios de Lamassu",{"_6944":119151,"_42621":119110,"_30085":188673,"_5":21646,"_28538":188571,"_5847":188674},[],"Un Gateway con varias rutas",{"_6944":119152,"_42621":119110,"_30085":188676,"_5":21646,"_28538":188571,"_5847":188677},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_6944":119153,"_42621":119110,"_30085":188679,"_5":21646,"_28538":188571,"_5847":188680},[],"Gateways independientes e IP externas distintas",{"_6944":119154,"_42621":119110,"_30085":188682,"_5":21646,"_28538":188571,"_5847":188683},[],"Una VIP por Gateway",{"_6944":119155,"_42621":119110,"_30085":188685,"_5":21646,"_28538":188571,"_5847":188686},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_6944":119156,"_42621":119110,"_30085":188688,"_5":21646,"_28538":188571,"_5847":188689},[],"Gateways independientes, un nodo y una IP",{"_6944":119157,"_42621":119110,"_30085":188691,"_5":21646,"_28538":188571,"_5847":188692},[],"Puertos externos diferentes",{"_6944":119158,"_42621":119110,"_30085":188694,"_5":21646,"_28538":188571,"_5847":188695},[],"Los clientes deben indicar puertos no estándar",{"_6944":119159,"_42621":119110,"_30085":188697,"_5":21646,"_28538":188571,"_5847":188698},[],"Terminación TLS/mTLS separada detrás de una IP",{"_6944":119160,"_42621":119110,"_30085":188700,"_5":21646,"_28538":188571,"_5847":188701},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_6944":119161,"_42621":119110,"_30085":188703,"_5":21646,"_28538":188571,"_5847":188704},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_6944":119162,"_42621":119110,"_30085":188706,"_5":21646,"_28538":188571,"_5847":188707},[],"Recursos Gateway separados pero proxy compartido",{"_6944":119163,"_42621":119110,"_30085":188709,"_5":21646,"_28538":188571,"_5847":188710},[],"Modo merged Gateway de Envoy",{"_6944":119164,"_42621":119110,"_30085":188712,"_5":21646,"_28538":188571,"_5847":188713},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_6944":119165,"_42621":119110,"_30085":188715,"_5":21646,"_28538":188571,"_5847":188716},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_6944":119166,"_42621":119110,"_30085":188718,"_5":21646,"_28538":188571,"_5847":188719},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_6944":119167,"_42621":119110,"_30085":188721,"_5":21646,"_28538":188571,"_5847":188722},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_6944":119168,"_42621":119110,"_30085":188724,"_5":21646,"_28538":188571,"_5847":188725},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_6944":119169,"_42621":119110,"_30085":188727,"_5":21646,"_28538":188575,"_5847":188728},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_6944":119170,"_42621":119110,"_30085":188730,"_5":21646,"_28538":188575,"_5847":188731},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_6944":119171,"_42621":119110,"_30085":188733,"_5":21646,"_28538":188575,"_5847":188734},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_6944":119172,"_42621":119110,"_30085":188736,"_5":21646,"_28538":188575,"_5847":188737},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_6944":119173,"_42621":119110,"_30085":188739,"_5":21646,"_28538":188575,"_5847":188740},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_6944":119174,"_42621":119110,"_30085":188742,"_5":21646,"_28538":188579,"_5847":188743},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_6944":119175,"_42621":119110,"_30085":188745,"_5":21646,"_28538":188579,"_5847":188746},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_6944":119176,"_42621":119110,"_30085":188748,"_5":21646,"_28538":188583,"_5847":188749},[],"Comprueba, en orden:",{"_6944":119177,"_42621":119110,"_30085":188751,"_5":21646,"_28538":188583,"_5847":188752},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_6944":119178,"_42621":119110,"_30085":188754,"_5":21646,"_28538":188583,"_5847":188755},[],"Su estado contiene la dirección esperada.",{"_6944":119179,"_42621":119110,"_30085":188757,"_5":21646,"_28538":188583,"_5847":188758},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_6944":119180,"_42621":119110,"_30085":188760,"_5":21646,"_28538":188583,"_5847":188761},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_6944":119181,"_42621":119110,"_30085":188763,"_5":21646,"_28538":188583,"_5847":188764},[],"DNS resuelve al endpoint accesible externamente.",{"_6944":119182,"_42621":119110,"_30085":188766,"_5":21646,"_28538":188583,"_5847":188767},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_6944":119183,"_42621":119110,"_30085":188769,"_5":21646,"_28538":188583,"_5847":188770},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_6944":119184,"_42621":119184,"_5":22076,"_5847":78111,"_43101":188772,"_30085":188773,"_28538":119184},[78004,187769,188003],[],{"_6944":119185,"_42621":119184,"_30085":188775,"_5":21646,"_28538":119184,"_5847":188776},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_6944":119186,"_42621":119184,"_5":43098,"_30085":188778,"_28538":188779,"_5847":188780},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_6944":119187,"_42621":119184,"_5":43098,"_30085":188782,"_28538":188783,"_5847":188784},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_6944":119188,"_42621":119184,"_5":43098,"_30085":188786,"_28538":188787,"_5847":188788},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_6944":119189,"_42621":119184,"_5":43098,"_30085":188790,"_28538":188791,"_5847":188792},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_6944":119190,"_42621":119184,"_5":43098,"_30085":188794,"_28538":188795,"_5847":188796},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_6944":119191,"_42621":119184,"_5":43098,"_30085":188798,"_28538":188799,"_5847":188800},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_6944":119192,"_42621":119184,"_30085":188802,"_5":21646,"_28538":188779,"_5847":188803},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_6944":119193,"_42621":119184,"_30085":188805,"_5":21646,"_28538":188783,"_5847":188806},[],"Flujo",{"_6944":119194,"_42621":119184,"_30085":188808,"_5":21646,"_28538":188783,"_5847":188809},[],"Úsalo para",{"_6944":119195,"_42621":119184,"_30085":188811,"_5":21646,"_28538":188783,"_5847":188812},[],"Qué instala",{"_6944":119196,"_42621":119184,"_30085":188814,"_5":21646,"_28538":188783,"_5847":79085},[],{"_6944":119197,"_42621":119184,"_30085":188816,"_5":21646,"_28538":188783,"_5847":188817},[],"Producción y entornos controlados",{"_6944":119198,"_42621":119184,"_30085":188819,"_5":21646,"_28538":188783,"_5847":188820},[],"Servicios de Lamassu y recursos de Gateway API",{"_6944":119199,"_42621":119184,"_30085":188822,"_5":21646,"_28538":188783,"_5847":78248},[],{"_6944":119200,"_42621":119184,"_30085":188824,"_5":21646,"_28538":188783,"_5847":188825},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_6944":119201,"_42621":119184,"_30085":188827,"_5":21646,"_28538":188783,"_5847":188828},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_6944":119202,"_42621":119184,"_30085":188830,"_5":21646,"_28538":188787,"_5847":188831},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_6944":119203,"_42621":119184,"_30085":188833,"_5":21646,"_28538":188787,"_5847":188834},[],"Área",{"_6944":119204,"_42621":119184,"_30085":188836,"_5":21646,"_28538":188787,"_5847":188837},[],"El chart de Lamassu proporciona",{"_6944":119205,"_42621":119184,"_30085":188839,"_5":21646,"_28538":188787,"_5847":188840},[],"Tú proporcionas",{"_6944":119206,"_42621":119184,"_30085":188842,"_5":21646,"_28538":188787,"_5847":188843},[],"Aplicaciones Lamassu",{"_6944":119207,"_42621":119184,"_30085":188845,"_5":21646,"_28538":188787,"_5847":188846},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_6944":119208,"_42621":119184,"_30085":188848,"_5":21646,"_28538":188787,"_5847":188849},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_6944":119209,"_42621":119184,"_30085":188851,"_5":21646,"_28538":188787,"_5847":188852},[],"Datos PostgreSQL",{"_6944":119210,"_42621":119184,"_30085":188854,"_5":21646,"_28538":188787,"_5847":188855},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_6944":119211,"_42621":119184,"_30085":188857,"_5":21646,"_28538":188787,"_5847":188858},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_6944":119212,"_42621":119184,"_30085":188860,"_5":21646,"_28538":188787,"_5847":188861},[],"Mensajería",{"_6944":119213,"_42621":119184,"_30085":188863,"_5":21646,"_28538":188787,"_5847":188864},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_6944":119214,"_42621":119184,"_30085":188866,"_5":21646,"_28538":188787,"_5847":188867},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_6944":119215,"_42621":119184,"_30085":188869,"_5":21646,"_28538":188787,"_5847":188870},[],"Identidad",{"_6944":119216,"_42621":119184,"_30085":188872,"_5":21646,"_28538":188787,"_5847":188873},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_6944":119217,"_42621":119184,"_30085":188875,"_5":21646,"_28538":188787,"_5847":188876},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_6944":119218,"_42621":119184,"_30085":188878,"_5":21646,"_28538":188787,"_5847":188879},[],"Enrutamiento externo",{"_6944":119219,"_42621":119184,"_30085":188881,"_5":21646,"_28538":188787,"_5847":188882},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_6944":119220,"_42621":119184,"_30085":188884,"_5":21646,"_28538":188787,"_5847":188885},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_6944":119221,"_42621":119184,"_30085":188887,"_5":21646,"_28538":188787,"_5847":79159},[],{"_6944":119222,"_42621":119184,"_30085":188889,"_5":21646,"_28538":188787,"_5847":188890},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_6944":119223,"_42621":119184,"_30085":188892,"_5":21646,"_28538":188787,"_5847":188893},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_6944":119224,"_42621":119184,"_30085":188895,"_5":21646,"_28538":188787,"_5847":188896},[],"Datos persistentes de la aplicación",{"_6944":119225,"_42621":119184,"_30085":188898,"_5":21646,"_28538":188787,"_5847":188899},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_6944":119226,"_42621":119184,"_30085":188901,"_5":21646,"_28538":188787,"_5847":188902},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_6944":119227,"_42621":119184,"_30085":188904,"_5":21646,"_28538":188787,"_5847":188905},[],"Integraciones opcionales",{"_6944":119228,"_42621":119184,"_30085":188907,"_5":21646,"_28538":188787,"_5847":188908},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_6944":119229,"_42621":119184,"_30085":188910,"_5":21646,"_28538":188787,"_5847":188911},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_6944":119230,"_42621":119184,"_30085":188913,"_5":21646,"_28538":188787,"_5847":188914},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_6944":119231,"_42621":119184,"_30085":188916,"_5":21646,"_28538":188787,"_5847":188917},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_6944":119232,"_42621":119184,"_30085":188919,"_5":21646,"_28538":188791,"_5847":188920},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_6944":119233,"_42621":119184,"_30085":188922,"_5":21646,"_28538":188791,"_5847":188923},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_6944":119234,"_42621":119184,"_30085":188925,"_5":21646,"_28538":188795,"_5847":188926},[],"Kubernetes 1.24 o posterior",{"_6944":119235,"_42621":119184,"_30085":188928,"_5":21646,"_28538":188795,"_5847":188929},[],"Helm 3.2 o posterior",{"_6944":119236,"_42621":119184,"_30085":188931,"_5":21646,"_28538":188795,"_5847":188932},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_6944":119237,"_42621":119184,"_30085":188934,"_5":21646,"_28538":188795,"_5847":188935},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_6944":119238,"_42621":119184,"_30085":188937,"_5":21646,"_28538":188795,"_5847":188938},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_6944":119239,"_42621":119184,"_30085":188940,"_5":21646,"_28538":188795,"_5847":188941},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_6944":119240,"_42621":119184,"_30085":188943,"_5":21646,"_28538":188795,"_5847":188944},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_6944":119241,"_42621":119184,"_30085":188946,"_5":21646,"_28538":188799,"_5847":188947},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_6944":119242,"_42621":119184,"_30085":188949,"_5":21646,"_28538":188799,"_5847":188950},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_6944":119243,"_42621":119184,"_30085":188952,"_5":21646,"_28538":188799,"_5847":188953},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_6944":119244,"_42621":119184,"_30085":188955,"_5":21646,"_28538":188799,"_5847":188956},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_6944":119245,"_42621":119245,"_5":22076,"_5847":188958,"_43101":188959,"_30085":188961,"_28538":119245},"Resolución de problemas de despliegue",[78004,187769,188960],"Operación",[],{"_6944":119246,"_42621":119245,"_30085":188963,"_5":21646,"_28538":119245,"_5847":188964},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_6944":119247,"_42621":119245,"_5":43098,"_30085":188966,"_28538":188967,"_5847":188968},[],"/docs/pr-preview/pr-56/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_6944":119248,"_42621":119245,"_5":43098,"_30085":188970,"_28538":188971,"_5847":188972},[],"/docs/pr-preview/pr-56/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_6944":119249,"_42621":119245,"_5":43098,"_30085":188974,"_28538":188975,"_5847":188976},[],"/docs/pr-preview/pr-56/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_6944":119250,"_42621":119245,"_5":43098,"_30085":188978,"_28538":188979,"_5847":188980},[],"/docs/pr-preview/pr-56/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_6944":119251,"_42621":119245,"_5":43098,"_30085":188982,"_28538":188983,"_5847":188984},[],"/docs/pr-preview/pr-56/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_6944":119252,"_42621":119245,"_5":43098,"_30085":188986,"_28538":188987,"_5847":188988},[],"/docs/pr-preview/pr-56/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_6944":119253,"_42621":119245,"_5":43098,"_30085":188990,"_28538":188991,"_5847":188992},[],"/docs/pr-preview/pr-56/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_6944":119254,"_42621":119245,"_5":43098,"_30085":188994,"_28538":188995,"_5847":188996},[],"/docs/pr-preview/pr-56/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_6944":119255,"_42621":119245,"_5":43098,"_30085":188998,"_28538":188999,"_5847":189000},[],"/docs/pr-preview/pr-56/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_6944":119256,"_42621":119245,"_5":43098,"_30085":189002,"_28538":189003,"_5847":189004},[],"/docs/pr-preview/pr-56/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_6944":119257,"_42621":119245,"_5":43098,"_30085":189006,"_28538":189007,"_5847":189008},[],"/docs/pr-preview/pr-56/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_6944":119258,"_42621":119245,"_5":43098,"_30085":189010,"_28538":189011,"_5847":189012},[],"/docs/pr-preview/pr-56/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_6944":119259,"_42621":119245,"_5":43098,"_30085":189014,"_28538":189015,"_5847":189016},[],"/docs/pr-preview/pr-56/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_6944":119260,"_42621":119245,"_30085":189018,"_5":21646,"_28538":119245,"_5847":189019},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_6944":119261,"_42621":119245,"_30085":189021,"_5":21646,"_28538":188971,"_5847":189022},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_6944":119262,"_42621":119245,"_30085":189024,"_5":21646,"_28538":188975,"_5847":189025},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_6944":119263,"_42621":119245,"_30085":189027,"_5":21646,"_28538":188979,"_5847":189028},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_6944":119264,"_42621":119245,"_30085":189030,"_5":21646,"_28538":188983,"_5847":189031},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_6944":119265,"_42621":119245,"_30085":189033,"_5":21646,"_28538":188987,"_5847":189034},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_6944":119266,"_42621":119245,"_30085":189036,"_5":21646,"_28538":188991,"_5847":189037},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_6944":119267,"_42621":119245,"_30085":189039,"_5":21646,"_28538":188991,"_5847":189040},[],"Ejecuta también la prueba de conectividad del chart:",{"_6944":119268,"_42621":119245,"_30085":189042,"_5":21646,"_28538":188991,"_5847":189043},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_6944":119269,"_42621":119245,"_30085":189045,"_5":21646,"_28538":188991,"_5847":189046},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_6944":119270,"_42621":119245,"_30085":189048,"_5":21646,"_28538":188995,"_5847":189049},[],"Si recibes un 401:",{"_6944":119271,"_42621":119245,"_30085":189051,"_5":21646,"_28538":188995,"_5847":189052},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_6944":119272,"_42621":119245,"_30085":189054,"_5":21646,"_28538":188995,"_5847":189055},[],"verifica emisor, audiencia y expiración del token;",{"_6944":119273,"_42621":119245,"_30085":189057,"_5":21646,"_28538":188995,"_5847":189058},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_6944":119274,"_42621":119245,"_30085":189060,"_5":21646,"_28538":188995,"_5847":189061},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_6944":119275,"_42621":119245,"_30085":189063,"_5":21646,"_28538":188995,"_5847":189064},[],"Si el login termina pero las APIs devuelven 403:",{"_6944":119276,"_42621":119245,"_30085":189066,"_5":21646,"_28538":188995,"_5847":189067},[],"inspecciona los claims reales del token;",{"_6944":119277,"_42621":119245,"_30085":189069,"_5":21646,"_28538":188995,"_5847":189070},[],"confirma que coinciden con un principal activo;",{"_6944":119278,"_42621":119245,"_30085":189072,"_5":21646,"_28538":188995,"_5847":189073},[],"revisa las políticas concedidas al principal;",{"_6944":119279,"_42621":119245,"_30085":189075,"_5":21646,"_28538":188995,"_5847":189076},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_6944":119280,"_42621":119245,"_30085":189078,"_5":21646,"_28538":188995,"_5847":189079},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_6944":119281,"_42621":119245,"_30085":189081,"_5":21646,"_28538":188999,"_5847":189082},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_6944":119282,"_42621":119245,"_30085":189084,"_5":21646,"_28538":188999,"_5847":189085},[],"Localiza el pod y Service de authz.",{"_6944":119283,"_42621":119245,"_30085":189087,"_5":21646,"_28538":188999,"_5847":189088},[],"Comprueba /health, logs y conexión a su base de datos.",{"_6944":119284,"_42621":119245,"_30085":189090,"_5":21646,"_28538":188999,"_5847":189091},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_6944":119285,"_42621":119245,"_30085":189093,"_5":21646,"_28538":188999,"_5847":189094},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_6944":119286,"_42621":119245,"_30085":189096,"_5":21646,"_28538":188999,"_5847":189097},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_6944":119287,"_42621":119245,"_30085":189099,"_5":21646,"_28538":189003,"_5847":189100},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_6944":119288,"_42621":119245,"_30085":189102,"_5":21646,"_28538":189007,"_5847":189103},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_6944":119289,"_42621":119245,"_30085":189105,"_5":21646,"_28538":189007,"_5847":189106},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_6944":119290,"_42621":119245,"_30085":189108,"_5":21646,"_28538":189007,"_5847":189109},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_6944":119291,"_42621":119245,"_30085":189111,"_5":21646,"_28538":189007,"_5847":189112},[],"volumen persistente sin enlazar;",{"_6944":119292,"_42621":119245,"_30085":189114,"_5":21646,"_28538":189007,"_5847":189115},[],"imagen inaccesible o política de pull incorrecta;",{"_6944":119293,"_42621":119245,"_30085":189117,"_5":21646,"_28538":189007,"_5847":189118},[],"configuración inválida del motor criptográfico;",{"_6944":119294,"_42621":119245,"_30085":189120,"_5":21646,"_28538":189007,"_5847":189121},[],"límites de CPU o memoria demasiado bajos;",{"_6944":119295,"_42621":119245,"_30085":189123,"_5":21646,"_28538":189007,"_5847":189124},[],"migración previa incompleta.",{"_6944":119296,"_42621":119245,"_30085":189126,"_5":21646,"_28538":189007,"_5847":189127},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_6944":119297,"_42621":119245,"_30085":189129,"_5":21646,"_28538":189007,"_5847":189130},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_6944":119298,"_42621":119245,"_30085":189132,"_5":21646,"_28538":189007,"_5847":189133},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_6944":119299,"_42621":119245,"_30085":189135,"_5":21646,"_28538":189011,"_5847":189136},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_6944":119300,"_42621":119245,"_30085":189138,"_5":21646,"_28538":189011,"_5847":189139},[],"verifica que esté habilitado en el servicio emisor;",{"_6944":119301,"_42621":119245,"_30085":189141,"_5":21646,"_28538":189011,"_5847":189142},[],"comprueba conectividad y credenciales AMQP;",{"_6944":119302,"_42621":119245,"_30085":189144,"_5":21646,"_28538":189011,"_5847":189145},[],"revisa exchange, routing key, colas y consumidores;",{"_6944":119303,"_42621":119245,"_30085":189147,"_5":21646,"_28538":189011,"_5847":189148},[],"inspecciona dead-letter queues;",{"_6944":119304,"_42621":119245,"_30085":189150,"_5":21646,"_28538":189011,"_5847":189151},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_6944":119305,"_42621":119245,"_30085":189153,"_5":21646,"_28538":189011,"_5847":189154},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_6944":119306,"_42621":119245,"_30085":189156,"_5":21646,"_28538":189011,"_5847":189157},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_6944":119307,"_42621":119245,"_30085":189159,"_5":21646,"_28538":189011,"_5847":189160},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_6944":119308,"_42621":119245,"_30085":189162,"_5":21646,"_28538":189011,"_5847":189163},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_6944":119309,"_42621":119245,"_30085":189165,"_5":21646,"_28538":189011,"_5847":189166},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_6944":119310,"_42621":119245,"_30085":189168,"_5":21646,"_28538":189011,"_5847":189169},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_6944":119311,"_42621":119245,"_30085":189171,"_5":21646,"_28538":189011,"_5847":189172},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_6944":119312,"_42621":119245,"_30085":189174,"_5":21646,"_28538":189015,"_5847":189175},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_6944":119313,"_42621":119245,"_30085":189177,"_5":21646,"_28538":189015,"_5847":189178},[],"Antes de cerrar una incidencia, guarda:",{"_6944":119314,"_42621":119245,"_30085":189180,"_5":21646,"_28538":189015,"_5847":189181},[],"causa confirmada;",{"_6944":119315,"_42621":119245,"_30085":189183,"_5":21646,"_28538":189015,"_5847":189184},[],"alcance temporal y recursos afectados;",{"_6944":119316,"_42621":119245,"_30085":189186,"_5":21646,"_28538":189015,"_5847":189187},[],"comandos o consultas utilizados;",{"_6944":119317,"_42621":119245,"_30085":189189,"_5":21646,"_28538":189015,"_5847":189190},[],"cambio aplicado y forma de revertirlo;",{"_6944":119318,"_42621":119245,"_30085":189192,"_5":21646,"_28538":189015,"_5847":189193},[],"validación desde un consumidor;",{"_6944":119319,"_42621":119245,"_30085":189195,"_5":21646,"_28538":189015,"_5847":189196},[],"acción preventiva y propietario.",{"_6944":119320,"_42621":119320,"_5":22076,"_5847":189198,"_43101":189199,"_30085":189202,"_28538":119320},"Control de acceso",[78004,189200,189201],"Plataforma","Administración",[],{"_6944":119321,"_42621":119320,"_30085":189204,"_5":21646,"_28538":119320,"_5847":189205},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_6944":119322,"_42621":119320,"_5":43098,"_30085":189207,"_28538":189208,"_5847":189209},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_6944":119323,"_42621":119320,"_5":43098,"_30085":189211,"_28538":189212,"_5847":189213},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_6944":119324,"_42621":119320,"_5":43098,"_30085":189215,"_28538":189216,"_5847":189217},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_6944":119325,"_42621":119320,"_5":43098,"_30085":189219,"_28538":189220,"_5847":189221},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_6944":119326,"_42621":119320,"_5":43098,"_30085":189223,"_28538":189224,"_5847":189225},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_6944":119327,"_42621":119320,"_5":43098,"_30085":189227,"_28538":189228,"_5847":189229},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_6944":119328,"_42621":119320,"_5":43098,"_30085":189231,"_28538":189232,"_5847":189233},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_6944":119329,"_42621":119320,"_5":43098,"_30085":189235,"_28538":189236,"_5847":189237},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#principales-x509","Principales X.509",{"_6944":119330,"_42621":119320,"_5":43098,"_30085":189239,"_28538":189240,"_5847":189241},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_6944":119331,"_42621":119320,"_5":43098,"_30085":189243,"_28538":189244,"_5847":189245},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_6944":119332,"_42621":119320,"_5":43098,"_30085":189247,"_28538":189248,"_5847":189249},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_6944":119333,"_42621":119320,"_5":43098,"_30085":189251,"_28538":189252,"_5847":189253},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_6944":119334,"_42621":119320,"_5":43098,"_30085":189255,"_28538":189256,"_5847":189257},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_6944":119335,"_42621":119320,"_5":43098,"_30085":189259,"_28538":189260,"_5847":189261},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_6944":119336,"_42621":119320,"_5":43098,"_30085":189263,"_28538":189264,"_5847":189265},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_6944":119337,"_42621":119320,"_5":43098,"_30085":189267,"_28538":189268,"_5847":188375},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_6944":119338,"_42621":119320,"_5":43098,"_30085":189270,"_28538":189271,"_5847":189272},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_6944":119339,"_42621":119320,"_5":43098,"_30085":189274,"_28538":189275,"_5847":189276},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_6944":119340,"_42621":119320,"_5":43098,"_30085":189278,"_28538":189279,"_5847":189280},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_6944":119341,"_42621":119320,"_5":43098,"_30085":189282,"_28538":189283,"_5847":189284},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_6944":119342,"_42621":119320,"_5":43098,"_30085":189286,"_28538":189287,"_5847":189288},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_6944":119343,"_42621":119320,"_5":43098,"_30085":189290,"_28538":189291,"_5847":189292},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_6944":119344,"_42621":119320,"_5":43098,"_30085":189294,"_28538":189295,"_5847":189296},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_6944":119345,"_42621":119320,"_5":43098,"_30085":189298,"_28538":189299,"_5847":189300},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_6944":119346,"_42621":119320,"_5":43098,"_30085":189302,"_28538":189303,"_5847":189304},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_6944":119347,"_42621":119320,"_5":43098,"_30085":189306,"_28538":189307,"_5847":189308},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_6944":119348,"_42621":119320,"_5":43098,"_30085":189310,"_28538":189311,"_5847":189312},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_6944":119349,"_42621":119320,"_5":43098,"_30085":189314,"_28538":189315,"_5847":189316},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_6944":119350,"_42621":119320,"_5":43098,"_30085":189318,"_28538":189319,"_5847":189320},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_6944":119351,"_42621":119320,"_5":43098,"_30085":189322,"_28538":189323,"_5847":189324},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_6944":119352,"_42621":119320,"_5":43098,"_30085":189326,"_28538":189327,"_5847":189328},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_6944":119353,"_42621":119320,"_30085":189330,"_5":21646,"_28538":119320,"_5847":189331},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_6944":119354,"_42621":119320,"_30085":189333,"_5":21646,"_28538":119320,"_5847":189334},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_6944":119355,"_42621":119320,"_30085":189336,"_5":21646,"_28538":119320,"_5847":189337},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_6944":119356,"_42621":119320,"_30085":189339,"_5":21646,"_28538":189208,"_5847":189340},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_6944":119357,"_42621":119320,"_30085":189342,"_5":21646,"_28538":189208,"_5847":189343},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_6944":119358,"_42621":119320,"_30085":189345,"_5":21646,"_28538":189208,"_5847":189346},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_6944":119359,"_42621":119320,"_30085":189348,"_5":21646,"_28538":189208,"_5847":189349},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_6944":119360,"_42621":119320,"_30085":189351,"_5":21646,"_28538":189208,"_5847":189352},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_6944":119361,"_42621":119320,"_30085":189354,"_5":21646,"_28538":189208,"_5847":189355},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_6944":119362,"_42621":119320,"_30085":189357,"_5":21646,"_28538":189212,"_5847":189358},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_6944":119363,"_42621":119320,"_30085":189360,"_5":21646,"_28538":189212,"_5847":189361},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_6944":119364,"_42621":119320,"_30085":189363,"_5":21646,"_28538":189216,"_5847":189364},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_6944":119365,"_42621":119320,"_30085":189366,"_5":21646,"_28538":189216,"_5847":189367},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_6944":119366,"_42621":119320,"_30085":189369,"_5":21646,"_28538":189216,"_5847":189370},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_6944":119367,"_42621":119320,"_30085":189372,"_5":21646,"_28538":189216,"_5847":189373},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_6944":119368,"_42621":119320,"_30085":189375,"_5":21646,"_28538":189216,"_5847":189376},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_6944":119369,"_42621":119320,"_30085":189378,"_5":21646,"_28538":189216,"_5847":189379},[],"Carga por separado las políticas concedidas a cada principal.",{"_6944":119370,"_42621":119320,"_30085":189381,"_5":21646,"_28538":189216,"_5847":189382},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_6944":119371,"_42621":119320,"_30085":189384,"_5":21646,"_28538":189216,"_5847":189385},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_6944":119372,"_42621":119320,"_30085":189387,"_5":21646,"_28538":189216,"_5847":189388},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_6944":119373,"_42621":119320,"_30085":189390,"_5":21646,"_28538":189216,"_5847":189391},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_6944":119374,"_42621":119320,"_30085":189393,"_5":21646,"_28538":189216,"_5847":189394},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_6944":119375,"_42621":119320,"_30085":189396,"_5":21646,"_28538":189216,"_5847":189397},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_6944":119376,"_42621":119320,"_30085":189399,"_5":21646,"_28538":189220,"_5847":189400},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_6944":119377,"_42621":119320,"_30085":189402,"_5":21646,"_28538":189220,"_5847":189403},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_6944":119378,"_42621":119320,"_30085":189405,"_5":21646,"_28538":189220,"_5847":189406},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_6944":119379,"_42621":119320,"_30085":189408,"_5":21646,"_28538":189220,"_5847":189409},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_6944":119380,"_42621":119320,"_30085":189411,"_5":21646,"_28538":189220,"_5847":189412},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_6944":119381,"_42621":119320,"_30085":189414,"_5":21646,"_28538":189220,"_5847":189415},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_6944":119382,"_42621":119320,"_30085":189417,"_5":21646,"_28538":189220,"_5847":189418},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_6944":119383,"_42621":119320,"_30085":189420,"_5":21646,"_28538":189220,"_5847":189421},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_6944":119384,"_42621":119320,"_30085":189423,"_5":21646,"_28538":189224,"_5847":189424},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_6944":119385,"_42621":119320,"_30085":189426,"_5":21646,"_28538":189224,"_5847":189427},[],"La decisión se toma con el contexto de la operación de dominio:",{"_6944":119386,"_42621":119320,"_30085":189429,"_5":21646,"_28538":189224,"_5847":189430},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_6944":119387,"_42621":119320,"_30085":189432,"_5":21646,"_28538":189224,"_5847":189433},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_6944":119388,"_42621":119320,"_30085":189435,"_5":21646,"_28538":189224,"_5847":189436},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_6944":119389,"_42621":119320,"_30085":189438,"_5":21646,"_28538":189224,"_5847":189439},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_6944":119390,"_42621":119320,"_30085":189441,"_5":21646,"_28538":189224,"_5847":189442},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_6944":119391,"_42621":119320,"_30085":189444,"_5":21646,"_28538":189224,"_5847":189445},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_6944":119392,"_42621":119320,"_30085":189447,"_5":21646,"_28538":189224,"_5847":189448},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_6944":119393,"_42621":119320,"_30085":189450,"_5":21646,"_28538":189224,"_5847":189451},[],"Las acciones se dividen en dos grupos:",{"_6944":119394,"_42621":119320,"_30085":189453,"_5":21646,"_28538":189224,"_5847":189454},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_6944":119395,"_42621":119320,"_30085":189456,"_5":21646,"_28538":189224,"_5847":189457},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_6944":119396,"_42621":119320,"_30085":189459,"_5":21646,"_28538":189224,"_5847":189460},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_6944":119397,"_42621":119320,"_30085":189462,"_5":21646,"_28538":189228,"_5847":189463},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_6944":119398,"_42621":119320,"_30085":189465,"_5":21646,"_28538":189228,"_5847":189466},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_6944":119399,"_42621":119320,"_30085":189468,"_5":21646,"_28538":189228,"_5847":189469},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_6944":119400,"_42621":119320,"_30085":189471,"_5":21646,"_28538":189232,"_5847":189472},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_6944":119401,"_42621":119320,"_30085":189474,"_5":21646,"_28538":189232,"_5847":189475},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_6944":119402,"_42621":119320,"_30085":189477,"_5":21646,"_28538":189232,"_5847":189478},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_6944":119403,"_42621":119320,"_30085":189480,"_5":21646,"_28538":189232,"_5847":189481},[],"Los operadores implementados son:",{"_6944":119404,"_42621":119320,"_30085":189483,"_5":21646,"_28538":189232,"_5847":189484},[],"`equals`, para igualdad exacta;",{"_6944":119405,"_42621":119320,"_30085":189486,"_5":21646,"_28538":189232,"_5847":189487},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_6944":119406,"_42621":119320,"_30085":189489,"_5":21646,"_28538":189232,"_5847":189490},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_6944":119407,"_42621":119320,"_30085":189492,"_5":21646,"_28538":189232,"_5847":189493},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_6944":119408,"_42621":119320,"_30085":189495,"_5":21646,"_28538":189236,"_5847":189496},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_6944":119409,"_42621":119320,"_30085":189498,"_5":21646,"_28538":189236,"_5847":189499},[],"Los modos disponibles son:",{"_6944":119410,"_42621":119320,"_30085":189501,"_5":21646,"_28538":189236,"_5847":189502},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_6944":119411,"_42621":119320,"_30085":189504,"_5":21646,"_28538":189236,"_5847":189505},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_6944":119412,"_42621":119320,"_30085":189507,"_5":21646,"_28538":189236,"_5847":189508},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_6944":119413,"_42621":119320,"_30085":189510,"_5":21646,"_28538":189236,"_5847":189511},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_6944":119414,"_42621":119320,"_30085":189513,"_5":21646,"_28538":189236,"_5847":189514},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_6944":119415,"_42621":119320,"_30085":189516,"_5":21646,"_28538":189236,"_5847":189517},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_6944":119416,"_42621":119320,"_30085":189519,"_5":21646,"_28538":189240,"_5847":189520},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_6944":119417,"_42621":119320,"_30085":189522,"_5":21646,"_28538":189240,"_5847":189523},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_6944":119418,"_42621":119320,"_30085":189525,"_5":21646,"_28538":189240,"_5847":189526},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_6944":119419,"_42621":119320,"_30085":189528,"_5":21646,"_28538":189240,"_5847":189529},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_6944":119420,"_42621":119320,"_30085":189531,"_5":21646,"_28538":189248,"_5847":189532},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_6944":119421,"_42621":119320,"_30085":189534,"_5":21646,"_28538":189248,"_5847":189535},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_6944":119422,"_42621":119320,"_30085":189537,"_5":21646,"_28538":189252,"_5847":189538},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_6944":119423,"_42621":119320,"_30085":189540,"_5":21646,"_28538":189252,"_5847":189541},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_6944":119424,"_42621":119320,"_30085":189543,"_5":21646,"_28538":189256,"_5847":189544},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_6944":119425,"_42621":119320,"_30085":189546,"_5":21646,"_28538":189256,"_5847":189547},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_6944":119426,"_42621":119320,"_30085":189549,"_5":21646,"_28538":189256,"_5847":189550},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_6944":119427,"_42621":119320,"_30085":189552,"_5":21646,"_28538":189260,"_5847":189553},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_6944":119428,"_42621":119320,"_30085":189555,"_5":21646,"_28538":189260,"_5847":189556},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_6944":119429,"_42621":119320,"_30085":189558,"_5":21646,"_28538":189260,"_5847":189559},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_6944":119430,"_42621":119320,"_30085":189561,"_5":21646,"_28538":189260,"_5847":189562},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_6944":119431,"_42621":119320,"_30085":189564,"_5":21646,"_28538":189260,"_5847":189565},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_6944":119432,"_42621":119320,"_30085":189567,"_5":21646,"_28538":189260,"_5847":189568},[],"Ten en cuenta que:",{"_6944":119433,"_42621":119320,"_30085":189570,"_5":21646,"_28538":189260,"_5847":189571},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_6944":119434,"_42621":119320,"_30085":189573,"_5":21646,"_28538":189260,"_5847":189574},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_6944":119435,"_42621":119320,"_30085":189576,"_5":21646,"_28538":189260,"_5847":189577},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_6944":119436,"_42621":119320,"_30085":189579,"_5":21646,"_28538":189264,"_5847":189580},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_6944":119437,"_42621":119320,"_30085":189582,"_5":21646,"_28538":189264,"_5847":189583},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_6944":119438,"_42621":119320,"_30085":189585,"_5":21646,"_28538":189264,"_5847":189586},[],"acceso completo y de solo lectura a KMS;",{"_6944":119439,"_42621":119320,"_30085":189588,"_5":21646,"_28538":189264,"_5847":189589},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_6944":119440,"_42621":119320,"_30085":189591,"_5":21646,"_28538":189264,"_5847":189592},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_6944":119441,"_42621":119320,"_30085":189594,"_5":21646,"_28538":189264,"_5847":189595},[],"acceso a la interfaz;",{"_6944":119442,"_42621":119320,"_30085":189597,"_5":21646,"_28538":189264,"_5847":189598},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_6944":119443,"_42621":119320,"_30085":189600,"_5":21646,"_28538":189264,"_5847":189601},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_6944":119444,"_42621":119320,"_30085":189603,"_5":21646,"_28538":189264,"_5847":189604},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_6944":119445,"_42621":119320,"_30085":189606,"_5":21646,"_28538":189268,"_5847":189607},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_6944":119446,"_42621":119320,"_30085":189609,"_5":21646,"_28538":189268,"_5847":189610},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_6944":119447,"_42621":119320,"_30085":189612,"_5":21646,"_28538":189268,"_5847":189613},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_6944":119448,"_42621":119320,"_30085":189615,"_5":21646,"_28538":189271,"_5847":189616},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_6944":119449,"_42621":119320,"_30085":189618,"_5":21646,"_28538":189275,"_5847":189619},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_6944":119450,"_42621":119320,"_30085":189621,"_5":21646,"_28538":189275,"_5847":189622},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_6944":119451,"_42621":119320,"_30085":189624,"_5":21646,"_28538":189279,"_5847":189625},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_6944":119452,"_42621":119320,"_30085":189627,"_5":21646,"_28538":189283,"_5847":189628},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_6944":119453,"_42621":119320,"_30085":189630,"_5":21646,"_28538":189287,"_5847":189631},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_6944":119454,"_42621":119320,"_30085":189633,"_5":21646,"_28538":189291,"_5847":189634},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_6944":119455,"_42621":119320,"_30085":189636,"_5":21646,"_28538":189291,"_5847":189637},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_6944":119456,"_42621":119320,"_30085":189639,"_5":21646,"_28538":189295,"_5847":189640},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_6944":119457,"_42621":119320,"_30085":189642,"_5":21646,"_28538":189295,"_5847":189643},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_6944":119458,"_42621":119320,"_30085":189645,"_5":21646,"_28538":189295,"_5847":189646},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_6944":119459,"_42621":119320,"_30085":189648,"_5":21646,"_28538":189295,"_5847":189649},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_6944":119460,"_42621":119320,"_30085":189651,"_5":21646,"_28538":189295,"_5847":189652},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_6944":119461,"_42621":119320,"_30085":189654,"_5":21646,"_28538":189295,"_5847":189655},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_6944":119462,"_42621":119320,"_30085":189657,"_5":21646,"_28538":189295,"_5847":189658},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_6944":119463,"_42621":119320,"_30085":189660,"_5":21646,"_28538":189295,"_5847":189661},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_6944":119464,"_42621":119320,"_30085":189663,"_5":21646,"_28538":189299,"_5847":189664},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_6944":119465,"_42621":119320,"_30085":189666,"_5":21646,"_28538":189299,"_5847":189667},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_6944":119466,"_42621":119320,"_30085":189669,"_5":21646,"_28538":189299,"_5847":189670},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_6944":119467,"_42621":119320,"_30085":189672,"_5":21646,"_28538":189303,"_5847":189673},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_6944":119468,"_42621":119320,"_30085":189675,"_5":21646,"_28538":189303,"_5847":189676},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_6944":119469,"_42621":119320,"_30085":189678,"_5":21646,"_28538":189303,"_5847":189679},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_6944":119470,"_42621":119320,"_30085":189681,"_5":21646,"_28538":189303,"_5847":189682},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_6944":119471,"_42621":119320,"_30085":189684,"_5":21646,"_28538":189303,"_5847":189685},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_6944":119472,"_42621":119320,"_30085":189687,"_5":21646,"_28538":189303,"_5847":189688},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_6944":119473,"_42621":119320,"_30085":189690,"_5":21646,"_28538":189303,"_5847":189691},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_6944":119474,"_42621":119320,"_30085":189693,"_5":21646,"_28538":189303,"_5847":189694},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_6944":119475,"_42621":119320,"_30085":189696,"_5":21646,"_28538":189311,"_5847":189697},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_6944":119476,"_42621":119320,"_30085":189699,"_5":21646,"_28538":189315,"_5847":189700},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_6944":119477,"_42621":119320,"_30085":189702,"_5":21646,"_28538":189315,"_5847":189703},[],"que exista un principal activo del tipo correcto;",{"_6944":119478,"_42621":119320,"_30085":189705,"_5":21646,"_28538":189315,"_5847":189706},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_6944":119479,"_42621":119320,"_30085":189708,"_5":21646,"_28538":189315,"_5847":189709},[],"que todas las condiciones del principal se cumplan;",{"_6944":119480,"_42621":119320,"_30085":189711,"_5":21646,"_28538":189315,"_5847":189712},[],"que el principal tenga concedida la política esperada;",{"_6944":119481,"_42621":119320,"_30085":189714,"_5":21646,"_28538":189315,"_5847":189715},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_6944":119482,"_42621":119320,"_30085":189717,"_5":21646,"_28538":189315,"_5847":189718},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_6944":119483,"_42621":119320,"_30085":189720,"_5":21646,"_28538":189315,"_5847":189721},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_6944":119484,"_42621":119320,"_30085":189723,"_5":21646,"_28538":189319,"_5847":189724},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_6944":119485,"_42621":119320,"_30085":189726,"_5":21646,"_28538":189323,"_5847":189727},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_6944":119486,"_42621":119320,"_30085":189729,"_5":21646,"_28538":189327,"_5847":189730},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_6944":119487,"_42621":119320,"_30085":189732,"_5":21646,"_28538":189327,"_5847":189733},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_6944":119488,"_42621":119488,"_5":22076,"_5847":189735,"_43101":189736,"_30085":189737,"_28538":119488},"Alertas y suscripciones",[78004,189200,189201],[],{"_6944":119489,"_42621":119488,"_30085":189739,"_5":21646,"_28538":119488,"_5847":189740},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_6944":119490,"_42621":119488,"_5":43098,"_30085":189742,"_28538":189743,"_5847":189744},[],"/docs/pr-preview/pr-56/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_6944":119491,"_42621":119488,"_5":43098,"_30085":189746,"_28538":189747,"_5847":189748},[],"/docs/pr-preview/pr-56/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_6944":119492,"_42621":119488,"_5":43098,"_30085":189750,"_28538":189751,"_5847":189752},[],"/docs/pr-preview/pr-56/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_6944":119493,"_42621":119488,"_5":43098,"_30085":189754,"_28538":189755,"_5847":189756},[],"/docs/pr-preview/pr-56/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_6944":119494,"_42621":119488,"_5":43098,"_30085":189758,"_28538":189759,"_5847":189760},[],"/docs/pr-preview/pr-56/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_6944":119495,"_42621":119488,"_5":43098,"_30085":189762,"_28538":189763,"_5847":189764},[],"/docs/pr-preview/pr-56/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_6944":119496,"_42621":119488,"_5":43098,"_30085":189766,"_28538":189767,"_5847":189768},[],"/docs/pr-preview/pr-56/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_6944":119497,"_42621":119488,"_5":43098,"_30085":189770,"_28538":189771,"_5847":189772},[],"/docs/pr-preview/pr-56/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_6944":119498,"_42621":119488,"_5":43098,"_30085":189774,"_28538":189775,"_5847":189776},[],"/docs/pr-preview/pr-56/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_6944":119499,"_42621":119488,"_5":43098,"_30085":189778,"_28538":189779,"_5847":189780},[],"/docs/pr-preview/pr-56/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_6944":119500,"_42621":119488,"_5":43098,"_30085":189782,"_28538":189783,"_5847":189784},[],"/docs/pr-preview/pr-56/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_6944":119501,"_42621":119488,"_30085":189786,"_5":21646,"_28538":119488,"_5847":189787},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_6944":119502,"_42621":119488,"_30085":189789,"_5":21646,"_28538":189743,"_5847":189790},[],"Un servicio publica un evento de dominio.",{"_6944":119503,"_42621":119488,"_30085":189792,"_5":21646,"_28538":189743,"_5847":189793},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_6944":119504,"_42621":119488,"_30085":189795,"_5":21646,"_28538":189743,"_5847":189796},[],"El filtro de cada suscripción decide si debe notificarse.",{"_6944":119505,"_42621":119488,"_30085":189798,"_5":21646,"_28538":189743,"_5847":189799},[],"Lamassu entrega el evento al canal configurado.",{"_6944":119506,"_42621":119488,"_30085":189801,"_5":21646,"_28538":189743,"_5847":189802},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_6944":119507,"_42621":119488,"_30085":189804,"_5":21646,"_28538":189747,"_5847":189805},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_6944":119508,"_42621":119488,"_30085":189807,"_5":21646,"_28538":189747,"_5847":189808},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_6944":119509,"_42621":119488,"_30085":189810,"_5":21646,"_28538":189747,"_5847":189811},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_6944":119510,"_42621":119488,"_30085":189813,"_5":21646,"_28538":189747,"_5847":189814},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_6944":119511,"_42621":119488,"_30085":189816,"_5":21646,"_28538":189747,"_5847":189817},[],"`apikey_options` necesita `header` y `key`.",{"_6944":119512,"_42621":119488,"_30085":189819,"_5":21646,"_28538":189747,"_5847":189820},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_6944":119513,"_42621":119488,"_30085":189822,"_5":21646,"_28538":189747,"_5847":189823},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_6944":119514,"_42621":119488,"_30085":189825,"_5":21646,"_28538":189747,"_5847":189826},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_6944":119515,"_42621":119488,"_30085":189828,"_5":21646,"_28538":189755,"_5847":189829},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_6944":119516,"_42621":119488,"_30085":189831,"_5":21646,"_28538":189759,"_5847":189832},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_6944":119517,"_42621":119488,"_30085":189834,"_5":21646,"_28538":189763,"_5847":189835},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_6944":119518,"_42621":119488,"_30085":189837,"_5":21646,"_28538":189763,"_5847":189838},[],"**None** notifica todas las instancias del evento.",{"_6944":119519,"_42621":119488,"_30085":189840,"_5":21646,"_28538":189763,"_5847":189841},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_6944":119520,"_42621":119488,"_30085":189843,"_5":21646,"_28538":189763,"_5847":189844},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_6944":119521,"_42621":119488,"_30085":189846,"_5":21646,"_28538":189763,"_5847":189847},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_6944":119522,"_42621":119488,"_30085":189849,"_5":21646,"_28538":189763,"_5847":189850},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_6944":119523,"_42621":119488,"_30085":189852,"_5":21646,"_28538":189763,"_5847":189853},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_6944":119524,"_42621":119488,"_30085":189855,"_5":21646,"_28538":189767,"_5847":189856},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_6944":119525,"_42621":119488,"_30085":189858,"_5":21646,"_28538":189771,"_5847":189859},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_6944":119526,"_42621":119488,"_30085":189861,"_5":21646,"_28538":189771,"_5847":189862},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_6944":119527,"_42621":119488,"_30085":189864,"_5":21646,"_28538":189771,"_5847":189865},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_6944":119528,"_42621":119488,"_30085":189867,"_5":21646,"_28538":189771,"_5847":189868},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_6944":119529,"_42621":119488,"_30085":189870,"_5":21646,"_28538":189771,"_5847":189871},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_6944":119530,"_42621":119488,"_30085":189873,"_5":21646,"_28538":189771,"_5847":189874},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_6944":119531,"_42621":119488,"_30085":189876,"_5":21646,"_28538":189771,"_5847":189877},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_6944":119532,"_42621":119488,"_30085":189879,"_5":21646,"_28538":189771,"_5847":189880},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_6944":119533,"_42621":119488,"_30085":189882,"_5":21646,"_28538":189775,"_5847":189883},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_6944":119534,"_42621":119488,"_30085":189885,"_5":21646,"_28538":189775,"_5847":189886},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_6944":119535,"_42621":119488,"_30085":189888,"_5":21646,"_28538":189775,"_5847":189889},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_6944":119536,"_42621":119488,"_30085":189891,"_5":21646,"_28538":189775,"_5847":189892},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_6944":119537,"_42621":119488,"_30085":189894,"_5":21646,"_28538":189775,"_5847":189895},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_6944":119538,"_42621":119488,"_30085":189897,"_5":21646,"_28538":189775,"_5847":189898},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_6944":119539,"_42621":119488,"_30085":189900,"_5":21646,"_28538":189775,"_5847":189901},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_6944":119540,"_42621":119488,"_30085":189903,"_5":21646,"_28538":189775,"_5847":189904},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_6944":119541,"_42621":119488,"_30085":189906,"_5":21646,"_28538":189779,"_5847":189907},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_6944":119542,"_42621":119488,"_30085":189909,"_5":21646,"_28538":189779,"_5847":189910},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_6944":119543,"_42621":119488,"_30085":189912,"_5":21646,"_28538":189783,"_5847":189913},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_6944":119544,"_42621":119488,"_30085":189915,"_5":21646,"_28538":189783,"_5847":189916},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_6944":119545,"_42621":119488,"_30085":189918,"_5":21646,"_28538":189783,"_5847":189919},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_6944":119546,"_42621":119488,"_30085":189921,"_5":21646,"_28538":189783,"_5847":189922},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_6944":119547,"_42621":119488,"_30085":189924,"_5":21646,"_28538":189783,"_5847":189925},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_6944":119548,"_42621":119488,"_30085":189927,"_5":21646,"_28538":189783,"_5847":189928},[],"**Validación:** `va.role.crl.create`.",{"_6944":119549,"_42621":119488,"_30085":189930,"_5":21646,"_28538":189783,"_5847":189931},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_6944":119550,"_42621":119488,"_30085":189933,"_5":21646,"_28538":189783,"_5847":189934},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_6944":119551,"_42621":119551,"_5":22076,"_5847":189936,"_43101":189937,"_30085":189938,"_28538":119551},"Registros de auditoría",[78004,189200,189201],[],{"_6944":119552,"_42621":119551,"_30085":189940,"_5":21646,"_28538":119551,"_5847":189941},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_6944":119553,"_42621":119551,"_5":43098,"_30085":189943,"_28538":189944,"_5847":189945},[],"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_6944":119554,"_42621":119551,"_5":43098,"_30085":189947,"_28538":189948,"_5847":189949},[],"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#cobertura","Cobertura",{"_6944":119555,"_42621":119551,"_5":43098,"_30085":189951,"_28538":189952,"_5847":189953},[],"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_6944":119556,"_42621":119551,"_5":43098,"_30085":189955,"_28538":189956,"_5847":189957},[],"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_6944":119557,"_42621":119551,"_5":43098,"_30085":189959,"_28538":189960,"_5847":189961},[],"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_6944":119558,"_42621":119551,"_5":43098,"_30085":189963,"_28538":189964,"_5847":189965},[],"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_6944":119559,"_42621":119551,"_5":43098,"_30085":189967,"_28538":189968,"_5847":189969},[],"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_6944":119560,"_42621":119551,"_5":43098,"_30085":189971,"_28538":189972,"_5847":189973},[],"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_6944":119561,"_42621":119551,"_5":43098,"_30085":189975,"_28538":189976,"_5847":189977},[],"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_6944":119562,"_42621":119551,"_5":43098,"_30085":189979,"_28538":189980,"_5847":189981},[],"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_6944":119563,"_42621":119551,"_5":43098,"_30085":189983,"_28538":189984,"_5847":189985},[],"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_6944":119564,"_42621":119551,"_30085":189987,"_5":21646,"_28538":119551,"_5847":189988},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_6944":119565,"_42621":119551,"_30085":189990,"_5":21646,"_28538":189944,"_5847":189991},[],"El cuerpo de auditoría incluye:",{"_6944":119566,"_42621":119551,"_30085":189993,"_5":21646,"_28538":189944,"_5847":189994},[],"input: datos recibidos por la operación;",{"_6944":119567,"_42621":119551,"_30085":189996,"_5":21646,"_28538":189944,"_5847":189997},[],"has\\_error: indica si el servicio devolvió un error;",{"_6944":119568,"_42621":119551,"_30085":189999,"_5":21646,"_28538":189944,"_5847":190000},[],"output: resultado producido o mensaje de error;",{"_6944":119569,"_42621":119551,"_30085":190002,"_5":21646,"_28538":189944,"_5847":190003},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_6944":119570,"_42621":119551,"_30085":190005,"_5":21646,"_28538":189944,"_5847":190006},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_6944":119571,"_42621":119551,"_30085":190008,"_5":21646,"_28538":189944,"_5847":190009},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_6944":119572,"_42621":119551,"_30085":190011,"_5":21646,"_28538":189948,"_5847":190012},[],"El backend aplica auditoría a mutaciones de:",{"_6944":119573,"_42621":119551,"_30085":190014,"_5":21646,"_28538":189948,"_5847":190015},[],"autoridades, certificados y perfiles de emisión;",{"_6944":119574,"_42621":119551,"_30085":190017,"_5":21646,"_28538":189948,"_5847":190018},[],"claves y motores KMS;",{"_6944":119575,"_42621":119551,"_30085":190020,"_5":21646,"_28538":189948,"_5847":190021},[],"dispositivos e identidades;",{"_6944":119576,"_42621":119551,"_30085":190023,"_5":21646,"_28538":189948,"_5847":190024},[],"DMS y operaciones de enrolamiento;",{"_6944":119577,"_42621":119551,"_30085":190026,"_5":21646,"_28538":189948,"_5847":190027},[],"funciones de validación y CRL;",{"_6944":119578,"_42621":119551,"_30085":190029,"_5":21646,"_28538":189948,"_5847":190030},[],"principales, políticas y concesiones de autorización.",{"_6944":119579,"_42621":119551,"_30085":190032,"_5":21646,"_28538":189948,"_5847":190033},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_6944":119580,"_42621":119551,"_30085":190035,"_5":21646,"_28538":189952,"_5847":190036},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_6944":119581,"_42621":119551,"_30085":190038,"_5":21646,"_28538":189952,"_5847":190039},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_6944":119582,"_42621":119551,"_30085":190041,"_5":21646,"_28538":189952,"_5847":190042},[],"Diseña el consumidor para:",{"_6944":119583,"_42621":119551,"_30085":190044,"_5":21646,"_28538":189952,"_5847":190045},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_6944":119584,"_42621":119551,"_30085":190047,"_5":21646,"_28538":189952,"_5847":190048},[],"conservar el CloudEvent completo sin modificar;",{"_6944":119585,"_42621":119551,"_30085":190050,"_5":21646,"_28538":189952,"_5847":190051},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_6944":119586,"_42621":119551,"_30085":190053,"_5":21646,"_28538":189952,"_5847":190054},[],"cifrar en tránsito y en reposo;",{"_6944":119587,"_42621":119551,"_30085":190056,"_5":21646,"_28538":189952,"_5847":190057},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_6944":119588,"_42621":119551,"_30085":190059,"_5":21646,"_28538":189952,"_5847":190060},[],"aplicar una política explícita de retención y legal hold;",{"_6944":119589,"_42621":119551,"_30085":190062,"_5":21646,"_28538":189952,"_5847":190063},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_6944":119590,"_42621":119551,"_30085":190065,"_5":21646,"_28538":189956,"_5847":190066},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_6944":119591,"_42621":119551,"_30085":190068,"_5":21646,"_28538":189956,"_5847":190069},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_6944":119592,"_42621":119551,"_30085":190071,"_5":21646,"_28538":189964,"_5847":190072},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_6944":119593,"_42621":119551,"_30085":190074,"_5":21646,"_28538":189968,"_5847":190075},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_6944":119594,"_42621":119551,"_30085":190077,"_5":21646,"_28538":189972,"_5847":190078},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_6944":119595,"_42621":119551,"_30085":190080,"_5":21646,"_28538":189976,"_5847":190081},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_6944":119596,"_42621":119551,"_30085":190083,"_5":21646,"_28538":189980,"_5847":190084},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_6944":119597,"_42621":119551,"_30085":190086,"_5":21646,"_28538":189984,"_5847":190087},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_6944":119598,"_42621":119551,"_30085":190089,"_5":21646,"_28538":189984,"_5847":190090},[],"aparece un evento de auditoría correcto;",{"_6944":119599,"_42621":119551,"_30085":190092,"_5":21646,"_28538":189984,"_5847":190093},[],"el principal coincide con la identidad utilizada;",{"_6944":119600,"_42621":119551,"_30085":190095,"_5":21646,"_28538":189984,"_5847":190096},[],"el consumidor lo persiste una sola vez;",{"_6944":119601,"_42621":119551,"_30085":190098,"_5":21646,"_28538":189984,"_5847":190099},[],"puede recuperarse por recurso, actor y periodo;",{"_6944":119602,"_42621":119551,"_30085":190101,"_5":21646,"_28538":189984,"_5847":190102},[],"una interrupción del consumidor produce una alerta.",{"_6944":119603,"_42621":119551,"_30085":190104,"_5":21646,"_28538":189984,"_5847":190105},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_6944":119604,"_42621":119604,"_5":22076,"_5847":190107,"_43101":190108,"_30085":190109,"_28538":119604},"Arquitectura de la plataforma",[78004,189200],[],{"_6944":119605,"_42621":119604,"_30085":190111,"_5":21646,"_28538":119604,"_5847":190112},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_6944":119606,"_42621":119604,"_5":43098,"_30085":190114,"_28538":190115,"_5847":190116},[],"/docs/pr-preview/pr-56/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_6944":119607,"_42621":119604,"_5":43098,"_30085":190118,"_28538":190119,"_5847":190120},[],"/docs/pr-preview/pr-56/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_6944":119608,"_42621":119604,"_5":43098,"_30085":190122,"_28538":190123,"_5847":190124},[],"/docs/pr-preview/pr-56/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_6944":119609,"_42621":119604,"_5":43098,"_30085":190126,"_28538":190127,"_5847":190128},[],"/docs/pr-preview/pr-56/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_6944":119610,"_42621":119604,"_5":43098,"_30085":190130,"_28538":190131,"_5847":190132},[],"/docs/pr-preview/pr-56/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_6944":119611,"_42621":119604,"_30085":190134,"_5":21646,"_28538":119604,"_5847":190135},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_6944":119612,"_42621":119604,"_30085":190137,"_5":21646,"_28538":119604,"_5847":190138},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_6944":119613,"_42621":119604,"_30085":190140,"_5":21646,"_28538":190115,"_5847":190141},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_6944":119614,"_42621":119604,"_30085":190143,"_5":21646,"_28538":190119,"_5847":190144},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_6944":119615,"_42621":119604,"_30085":190146,"_5":21646,"_28538":190123,"_5847":190147},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_6944":119616,"_42621":119604,"_30085":190149,"_5":21646,"_28538":190127,"_5847":190150},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_6944":119617,"_42621":119604,"_30085":190152,"_5":21646,"_28538":190131,"_5847":190153},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_6944":119618,"_42621":119618,"_5":22076,"_5847":190155,"_43101":190156,"_30085":190157,"_28538":119618},"Cómo funciona Lamassu",[78004,189200],[],{"_6944":119619,"_42621":119618,"_30085":190159,"_5":21646,"_28538":119618,"_5847":190160},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_6944":119620,"_42621":119618,"_5":43098,"_30085":190162,"_28538":190163,"_5847":190164},[],"/docs/pr-preview/pr-56/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_6944":119621,"_42621":119618,"_5":43098,"_30085":190166,"_28538":190167,"_5847":190168},[],"/docs/pr-preview/pr-56/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_6944":119622,"_42621":119618,"_30085":190170,"_5":21646,"_28538":119618,"_5847":190171},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_6944":119623,"_42621":119618,"_30085":190173,"_5":21646,"_28538":190163,"_5847":190174},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_6944":119624,"_42621":119618,"_30085":190176,"_5":21646,"_28538":190163,"_5847":190177},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_6944":119625,"_42621":119618,"_30085":190179,"_5":21646,"_28538":190163,"_5847":190180},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_6944":119626,"_42621":119618,"_30085":190182,"_5":21646,"_28538":190163,"_5847":190183},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_6944":119627,"_42621":119618,"_30085":190185,"_5":21646,"_28538":190163,"_5847":190186},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_6944":119628,"_42621":119618,"_30085":190188,"_5":21646,"_28538":190167,"_5847":190189},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_6944":119629,"_42621":119618,"_30085":190191,"_5":21646,"_28538":190167,"_5847":190192},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_6944":119630,"_42621":119618,"_30085":190194,"_5":21646,"_28538":190167,"_5847":190195},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_6944":119631,"_42621":119618,"_30085":190197,"_5":21646,"_28538":190167,"_5847":190198},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_6944":119632,"_42621":119618,"_30085":190200,"_5":21646,"_28538":190167,"_5847":190201},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_6944":119633,"_42621":119618,"_30085":190203,"_5":21646,"_28538":190167,"_5847":190204},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_6944":119634,"_42621":119618,"_30085":190206,"_5":21646,"_28538":190167,"_5847":190207},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_6944":119635,"_42621":119635,"_5":22076,"_5847":190209,"_43101":190210,"_30085":190211,"_28538":119635},"Dispositivos e identidades",[78004,189200,80483,190209],[],{"_6944":119636,"_42621":119635,"_30085":190213,"_5":21646,"_28538":119635,"_5847":190214},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_6944":119637,"_42621":119635,"_5":43098,"_30085":190216,"_28538":190217,"_5847":190218},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_6944":119638,"_42621":119635,"_5":43098,"_30085":190220,"_28538":190221,"_5847":190222},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_6944":119639,"_42621":119635,"_5":43098,"_30085":190224,"_28538":190225,"_5847":190226},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_6944":119640,"_42621":119635,"_5":43098,"_30085":190228,"_28538":190229,"_5847":190230},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_6944":119641,"_42621":119635,"_5":43098,"_30085":190232,"_28538":190233,"_5847":190234},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_6944":119642,"_42621":119635,"_5":43098,"_30085":190236,"_28538":190237,"_5847":190238},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_6944":119643,"_42621":119635,"_5":43098,"_30085":190240,"_28538":190241,"_5847":190242},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_6944":119644,"_42621":119635,"_5":43098,"_30085":190244,"_28538":190245,"_5847":190246},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_6944":119645,"_42621":119635,"_5":43098,"_30085":190248,"_28538":190249,"_5847":190250},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_6944":119646,"_42621":119635,"_5":43098,"_30085":190252,"_28538":190253,"_5847":190254},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_6944":119647,"_42621":119635,"_5":43098,"_30085":190256,"_28538":190257,"_5847":190258},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_6944":119648,"_42621":119635,"_30085":190260,"_5":21646,"_28538":119635,"_5847":190261},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_6944":119649,"_42621":119635,"_30085":190263,"_5":21646,"_28538":119635,"_5847":190264},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_6944":119650,"_42621":119635,"_30085":190266,"_5":21646,"_28538":190217,"_5847":190267},[],"Vista operativa",{"_6944":119651,"_42621":119635,"_30085":190269,"_5":21646,"_28538":190217,"_5847":190270},[],"Interpretación",{"_6944":119652,"_42621":119635,"_30085":190272,"_5":21646,"_28538":190217,"_5847":80546},[],{"_6944":119653,"_42621":119635,"_30085":190274,"_5":21646,"_28538":190217,"_5847":190275},[],"Hay registro, pero todavía no hay identidad asociada.",{"_6944":119654,"_42621":119635,"_30085":190277,"_5":21646,"_28538":190217,"_5847":80552},[],{"_6944":119655,"_42621":119635,"_30085":190279,"_5":21646,"_28538":190217,"_5847":190280},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_6944":119656,"_42621":119635,"_30085":190282,"_5":21646,"_28538":190217,"_5847":80558},[],{"_6944":119657,"_42621":119635,"_30085":190284,"_5":21646,"_28538":190217,"_5847":190285},[],"La identidad está en la ventana operativa de renovación.",{"_6944":119658,"_42621":119635,"_30085":190287,"_5":21646,"_28538":190217,"_5847":80564},[],{"_6944":119659,"_42621":119635,"_30085":190289,"_5":21646,"_28538":190217,"_5847":190290},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_6944":119660,"_42621":119635,"_30085":190292,"_5":21646,"_28538":190217,"_5847":80570},[],{"_6944":119661,"_42621":119635,"_30085":190294,"_5":21646,"_28538":190217,"_5847":190295},[],"La identidad ha vencido.",{"_6944":119662,"_42621":119635,"_30085":190297,"_5":21646,"_28538":190217,"_5847":80576},[],{"_6944":119663,"_42621":119635,"_30085":190299,"_5":21646,"_28538":190217,"_5847":190300},[],"La identidad está marcada como revocada.",{"_6944":119664,"_42621":119635,"_30085":190302,"_5":21646,"_28538":190217,"_5847":80582},[],{"_6944":119665,"_42621":119635,"_30085":190304,"_5":21646,"_28538":190217,"_5847":190305},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_6944":119666,"_42621":119635,"_30085":190307,"_5":21646,"_28538":190217,"_5847":190308},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_6944":119667,"_42621":119635,"_30085":190310,"_5":21646,"_28538":190221,"_5847":190311},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_6944":119668,"_42621":119635,"_30085":190313,"_5":21646,"_28538":190221,"_5847":190314},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_6944":119669,"_42621":119635,"_30085":190316,"_5":21646,"_28538":190221,"_5847":190317},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_6944":119670,"_42621":119635,"_30085":190319,"_5":21646,"_28538":190221,"_5847":190320},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_6944":119671,"_42621":119635,"_30085":190322,"_5":21646,"_28538":190225,"_5847":190323},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_6944":119672,"_42621":119635,"_30085":190325,"_5":21646,"_28538":190229,"_5847":190326},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_6944":119673,"_42621":119635,"_30085":190328,"_5":21646,"_28538":190233,"_5847":190329},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_6944":119674,"_42621":119635,"_30085":190331,"_5":21646,"_28538":190237,"_5847":190332},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_6944":119675,"_42621":119635,"_30085":190334,"_5":21646,"_28538":190241,"_5847":190335},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_6944":119676,"_42621":119635,"_30085":190337,"_5":21646,"_28538":190241,"_5847":190338},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_6944":119677,"_42621":119635,"_30085":190340,"_5":21646,"_28538":190245,"_5847":190341},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_6944":119678,"_42621":119635,"_30085":190343,"_5":21646,"_28538":190245,"_5847":190344},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_6944":119679,"_42621":119635,"_30085":190346,"_5":21646,"_28538":190245,"_5847":190347},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_6944":119680,"_42621":119635,"_30085":190349,"_5":21646,"_28538":190245,"_5847":190350},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_6944":119681,"_42621":119635,"_30085":190352,"_5":21646,"_28538":190245,"_5847":190353},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_6944":119682,"_42621":119635,"_30085":190355,"_5":21646,"_28538":190245,"_5847":190356},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_6944":119683,"_42621":119635,"_30085":190358,"_5":21646,"_28538":190249,"_5847":190359},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_6944":119684,"_42621":119635,"_30085":190361,"_5":21646,"_28538":190249,"_5847":190362},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_6944":119685,"_42621":119635,"_30085":190364,"_5":21646,"_28538":190253,"_5847":190365},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_6944":119686,"_42621":119635,"_30085":190367,"_5":21646,"_28538":190253,"_5847":190368},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_6944":119687,"_42621":119635,"_30085":190370,"_5":21646,"_28538":190253,"_5847":190371},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_6944":119688,"_42621":119635,"_30085":190373,"_5":21646,"_28538":190253,"_5847":190374},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_6944":119689,"_42621":119635,"_30085":190376,"_5":21646,"_28538":190257,"_5847":190377},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_6944":119690,"_42621":119635,"_30085":190379,"_5":21646,"_28538":190257,"_5847":190380},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_6944":119691,"_42621":119691,"_5":22076,"_5847":190382,"_43101":190383,"_30085":190385,"_28538":119691},"Identidad inicial y autenticación",[78004,189200,80483,190209,190384],"Enrolamiento con PKI",[],{"_6944":119692,"_42621":119691,"_30085":190387,"_5":21646,"_28538":119691,"_5847":190388},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_6944":119693,"_42621":119691,"_5":43098,"_30085":190390,"_28538":190391,"_5847":190392},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_6944":119694,"_42621":119691,"_5":43098,"_30085":190394,"_28538":190395,"_5847":190396},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_6944":119695,"_42621":119691,"_5":43098,"_30085":190398,"_28538":190399,"_5847":190400},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_6944":119696,"_42621":119691,"_5":43098,"_30085":190402,"_28538":190403,"_5847":190404},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_6944":119697,"_42621":119691,"_5":43098,"_30085":190406,"_28538":190407,"_5847":190408},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_6944":119698,"_42621":119691,"_30085":190410,"_5":21646,"_28538":119691,"_5847":190411},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_6944":119699,"_42621":119691,"_30085":190413,"_5":21646,"_28538":190391,"_5847":190414},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_6944":119700,"_42621":119691,"_30085":190416,"_5":21646,"_28538":190391,"_5847":190417},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_6944":119701,"_42621":119691,"_30085":190419,"_5":21646,"_28538":190395,"_5847":190420},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_6944":119702,"_42621":119691,"_30085":190422,"_5":21646,"_28538":190395,"_5847":190423},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_6944":119703,"_42621":119691,"_30085":190425,"_5":21646,"_28538":190395,"_5847":190426},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_6944":119704,"_42621":119691,"_30085":190428,"_5":21646,"_28538":190399,"_5847":190429},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_6944":119705,"_42621":119691,"_30085":190431,"_5":21646,"_28538":190399,"_5847":190432},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_6944":119706,"_42621":119691,"_30085":190434,"_5":21646,"_28538":190403,"_5847":190435},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_6944":119707,"_42621":119691,"_30085":190437,"_5":21646,"_28538":190403,"_5847":190438},[],"Ejemplo de cuerpo:",{"_6944":119708,"_42621":119691,"_30085":190440,"_5":21646,"_28538":190403,"_5847":190441},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_6944":119709,"_42621":119691,"_30085":190443,"_5":21646,"_28538":190403,"_5847":190444},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_6944":119710,"_42621":119691,"_30085":190446,"_5":21646,"_28538":190403,"_5847":190447},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_6944":119711,"_42621":119691,"_30085":190449,"_5":21646,"_28538":190403,"_5847":190450},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_6944":119712,"_42621":119691,"_30085":190452,"_5":21646,"_28538":190407,"_5847":190453},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_6944":119713,"_42621":119691,"_30085":190455,"_5":21646,"_28538":190407,"_5847":190456},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_6944":119714,"_42621":119714,"_5":22076,"_5847":190458,"_43101":190459,"_30085":190460,"_28538":119714},"Configura y opera el DMS",[78004,189200,80483,190209,190384],[],{"_6944":119715,"_42621":119714,"_30085":190462,"_5":21646,"_28538":119714,"_5847":190463},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_6944":119716,"_42621":119714,"_5":43098,"_30085":190465,"_28538":190466,"_5847":187778},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_6944":119717,"_42621":119714,"_5":43098,"_30085":190468,"_28538":190469,"_5847":190470},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_6944":119718,"_42621":119714,"_5":43098,"_30085":190472,"_28538":190473,"_5847":190474},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_6944":119719,"_42621":119714,"_5":43098,"_30085":190476,"_28538":190477,"_5847":190478},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_6944":119720,"_42621":119714,"_5":43098,"_30085":190480,"_28538":190481,"_5847":190482},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_6944":119721,"_42621":119714,"_5":43098,"_30085":190484,"_28538":190485,"_5847":190486},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_6944":119722,"_42621":119714,"_5":43098,"_30085":190488,"_28538":190489,"_5847":190490},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_6944":119723,"_42621":119714,"_5":43098,"_30085":190492,"_28538":190493,"_5847":190494},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_6944":119724,"_42621":119714,"_5":43098,"_30085":190496,"_28538":190497,"_5847":80778},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_6944":119725,"_42621":119714,"_5":43098,"_30085":190499,"_28538":190500,"_5847":80782},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_6944":119726,"_42621":119714,"_5":43098,"_30085":190502,"_28538":190503,"_5847":190504},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_6944":119727,"_42621":119714,"_5":43098,"_30085":190506,"_28538":190507,"_5847":190508},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_6944":119728,"_42621":119714,"_5":43098,"_30085":190510,"_28538":190511,"_5847":190512},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_6944":119729,"_42621":119714,"_5":43098,"_30085":190514,"_28538":190515,"_5847":190516},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_6944":119730,"_42621":119714,"_5":43098,"_30085":190518,"_28538":190519,"_5847":80802},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_6944":119731,"_42621":119714,"_5":43098,"_30085":190521,"_28538":190522,"_5847":190523},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_6944":119732,"_42621":119714,"_5":43098,"_30085":190525,"_28538":190526,"_5847":190527},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_6944":119733,"_42621":119714,"_5":43098,"_30085":190529,"_28538":190530,"_5847":190531},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_6944":119734,"_42621":119714,"_30085":190533,"_5":21646,"_28538":119714,"_5847":190534},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_6944":119735,"_42621":119714,"_30085":190536,"_5":21646,"_28538":190466,"_5847":190537},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_6944":119736,"_42621":119714,"_30085":190539,"_5":21646,"_28538":190466,"_5847":190540},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_6944":119737,"_42621":119714,"_30085":190542,"_5":21646,"_28538":190473,"_5847":190543},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_6944":119738,"_42621":119714,"_30085":190545,"_5":21646,"_28538":190477,"_5847":190546},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_6944":119739,"_42621":119714,"_30085":190548,"_5":21646,"_28538":190481,"_5847":190549},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_6944":119740,"_42621":119714,"_30085":190551,"_5":21646,"_28538":190485,"_5847":190552},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_6944":119741,"_42621":119714,"_30085":190554,"_5":21646,"_28538":190489,"_5847":190555},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_6944":119742,"_42621":119714,"_30085":190557,"_5":21646,"_28538":190497,"_5847":190558},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_6944":119743,"_42621":119714,"_30085":190560,"_5":21646,"_28538":190497,"_5847":190561},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_6944":119744,"_42621":119714,"_30085":190563,"_5":21646,"_28538":190500,"_5847":190564},[],"Campo de `settings.enrollment_settings`",{"_6944":119745,"_42621":119714,"_30085":190566,"_5":21646,"_28538":190500,"_5847":190567},[],"Decisión",{"_6944":119746,"_42621":119714,"_30085":190569,"_5":21646,"_28538":190500,"_5847":80853},[],{"_6944":119747,"_42621":119714,"_30085":190571,"_5":21646,"_28538":190500,"_5847":190572},[],"`EST_RFC7030` para estas operaciones.",{"_6944":119748,"_42621":119714,"_30085":190574,"_5":21646,"_28538":190500,"_5847":80859},[],{"_6944":119749,"_42621":119714,"_30085":190576,"_5":21646,"_28538":190500,"_5847":190577},[],"ID de la CA que firmará.",{"_6944":119750,"_42621":119714,"_30085":190579,"_5":21646,"_28538":190500,"_5847":80865},[],{"_6944":119751,"_42621":119714,"_30085":190581,"_5":21646,"_28538":190500,"_5847":190582},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_6944":119752,"_42621":119714,"_30085":190584,"_5":21646,"_28538":190500,"_5847":80871},[],{"_6944":119753,"_42621":119714,"_30085":190586,"_5":21646,"_28538":190500,"_5847":190587},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_6944":119754,"_42621":119714,"_30085":190589,"_5":21646,"_28538":190500,"_5847":80877},[],{"_6944":119755,"_42621":119714,"_30085":190591,"_5":21646,"_28538":190500,"_5847":190592},[],"Uno de los cuatro modos de autenticación.",{"_6944":119756,"_42621":119714,"_30085":190594,"_5":21646,"_28538":190500,"_5847":190595},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_6944":119757,"_42621":119714,"_30085":190597,"_5":21646,"_28538":190503,"_5847":190598},[],"Los bloques son independientes:",{"_6944":119758,"_42621":119714,"_30085":190600,"_5":21646,"_28538":190503,"_5847":190601},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_6944":119759,"_42621":119714,"_30085":190603,"_5":21646,"_28538":190503,"_5847":190604},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_6944":119760,"_42621":119714,"_30085":190606,"_5":21646,"_28538":190503,"_5847":80895},[],{"_6944":119761,"_42621":119714,"_30085":190608,"_5":21646,"_28538":190503,"_5847":190609},[],"Control aplicado en la operación configurada",{"_6944":119762,"_42621":119714,"_30085":190611,"_5":21646,"_28538":190503,"_5847":80901},[],{"_6944":119763,"_42621":119714,"_30085":190613,"_5":21646,"_28538":190503,"_5847":190614},[],"Validación del certificado presentado.",{"_6944":119764,"_42621":119714,"_30085":190616,"_5":21646,"_28538":190503,"_5847":80907},[],{"_6944":119765,"_42621":119714,"_30085":190618,"_5":21646,"_28538":190503,"_5847":190619},[],"Autorización del webhook configurado.",{"_6944":119766,"_42621":119714,"_30085":190621,"_5":21646,"_28538":190503,"_5847":80913},[],{"_6944":119767,"_42621":119714,"_30085":190623,"_5":21646,"_28538":190503,"_5847":190624},[],"Validación del certificado y, después, aprobación del webhook.",{"_6944":119768,"_42621":119714,"_30085":190626,"_5":21646,"_28538":190503,"_5847":80919},[],{"_6944":119769,"_42621":119714,"_30085":190628,"_5":21646,"_28538":190503,"_5847":190629},[],"Sin autenticación del solicitante por el DMS.",{"_6944":119770,"_42621":119714,"_30085":190631,"_5":21646,"_28538":190503,"_5847":190632},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_6944":119771,"_42621":119714,"_30085":190634,"_5":21646,"_28538":190503,"_5847":190635},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_6944":119772,"_42621":119714,"_30085":190637,"_5":21646,"_28538":190503,"_5847":190638},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_6944":119773,"_42621":119714,"_30085":190640,"_5":21646,"_28538":190503,"_5847":190641},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_6944":119774,"_42621":119714,"_30085":190643,"_5":21646,"_28538":190507,"_5847":190644},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_6944":119775,"_42621":119714,"_30085":190646,"_5":21646,"_28538":190507,"_5847":190647},[],"Campo de `external_webhook_settings`",{"_6944":119776,"_42621":119714,"_30085":190649,"_5":21646,"_28538":190507,"_5847":190567},[],{"_6944":119777,"_42621":119714,"_30085":190651,"_5":21646,"_28538":190507,"_5847":80945},[],{"_6944":119778,"_42621":119714,"_30085":190653,"_5":21646,"_28538":190507,"_5847":190654},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_6944":119779,"_42621":119714,"_30085":190656,"_5":21646,"_28538":190507,"_5847":80951},[],{"_6944":119780,"_42621":119714,"_30085":190658,"_5":21646,"_28538":190507,"_5847":190659},[],"`POST` o `PUT`; `POST` por defecto.",{"_6944":119781,"_42621":119714,"_30085":190661,"_5":21646,"_28538":190507,"_5847":80957},[],{"_6944":119782,"_42621":119714,"_30085":190663,"_5":21646,"_28538":190507,"_5847":190664},[],"Etiqueta usada en los logs del servicio.",{"_6944":119783,"_42621":119714,"_30085":190666,"_5":21646,"_28538":190507,"_5847":80963},[],{"_6944":119784,"_42621":119714,"_30085":190668,"_5":21646,"_28538":190507,"_5847":190669},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_6944":119785,"_42621":119714,"_30085":190671,"_5":21646,"_28538":190507,"_5847":80969},[],{"_6944":119786,"_42621":119714,"_30085":190673,"_5":21646,"_28538":190507,"_5847":190674},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_6944":119787,"_42621":119714,"_30085":190676,"_5":21646,"_28538":190507,"_5847":80975},[],{"_6944":119788,"_42621":119714,"_30085":190678,"_5":21646,"_28538":190507,"_5847":190679},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_6944":119789,"_42621":119714,"_30085":190681,"_5":21646,"_28538":190507,"_5847":80981},[],{"_6944":119790,"_42621":119714,"_30085":190683,"_5":21646,"_28538":190507,"_5847":190684},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_6944":119791,"_42621":119714,"_30085":190686,"_5":21646,"_28538":190507,"_5847":80987},[],{"_6944":119792,"_42621":119714,"_30085":190688,"_5":21646,"_28538":190507,"_5847":190689},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_6944":119793,"_42621":119714,"_30085":190691,"_5":21646,"_28538":190507,"_5847":80993},[],{"_6944":119794,"_42621":119714,"_30085":190693,"_5":21646,"_28538":190507,"_5847":190694},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_6944":119795,"_42621":119714,"_30085":190696,"_5":21646,"_28538":190507,"_5847":80999},[],{"_6944":119796,"_42621":119714,"_30085":190698,"_5":21646,"_28538":190507,"_5847":190699},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_6944":119797,"_42621":119714,"_30085":190701,"_5":21646,"_28538":190507,"_5847":190702},[],"Reglas de esa configuración:",{"_6944":119798,"_42621":119714,"_30085":190704,"_5":21646,"_28538":190507,"_5847":190705},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_6944":119799,"_42621":119714,"_30085":190707,"_5":21646,"_28538":190507,"_5847":190708},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_6944":119800,"_42621":119714,"_30085":190710,"_5":21646,"_28538":190507,"_5847":190711},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_6944":119801,"_42621":119714,"_30085":190713,"_5":21646,"_28538":190507,"_5847":190714},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_6944":119802,"_42621":119714,"_30085":190716,"_5":21646,"_28538":190507,"_5847":190717},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_6944":119803,"_42621":119714,"_30085":190719,"_5":21646,"_28538":190507,"_5847":190720},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_6944":119804,"_42621":119714,"_30085":190722,"_5":21646,"_28538":190507,"_5847":190723},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_6944":119805,"_42621":119714,"_30085":190725,"_5":21646,"_28538":190507,"_5847":190726},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_6944":119806,"_42621":119714,"_30085":190728,"_5":21646,"_28538":190507,"_5847":190729},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_6944":119807,"_42621":119714,"_30085":190731,"_5":21646,"_28538":190511,"_5847":190732},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_6944":119808,"_42621":119714,"_30085":190734,"_5":21646,"_28538":190515,"_5847":190735},[],"Campo de `settings.reenrollment_settings`",{"_6944":119809,"_42621":119714,"_30085":190737,"_5":21646,"_28538":190515,"_5847":190738},[],"Función",{"_6944":119810,"_42621":119714,"_30085":190740,"_5":21646,"_28538":190515,"_5847":81043},[],{"_6944":119811,"_42621":119714,"_30085":190742,"_5":21646,"_28538":190515,"_5847":190743},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_6944":119812,"_42621":119714,"_30085":190745,"_5":21646,"_28538":190515,"_5847":81049},[],{"_6944":119813,"_42621":119714,"_30085":190747,"_5":21646,"_28538":190515,"_5847":190748},[],"Umbral operativo preventivo de monitorización.",{"_6944":119814,"_42621":119714,"_30085":190750,"_5":21646,"_28538":190515,"_5847":81055},[],{"_6944":119815,"_42621":119714,"_30085":190752,"_5":21646,"_28538":190515,"_5847":190753},[],"Umbral operativo crítico de monitorización.",{"_6944":119816,"_42621":119714,"_30085":190755,"_5":21646,"_28538":190515,"_5847":81061},[],{"_6944":119817,"_42621":119714,"_30085":190757,"_5":21646,"_28538":190515,"_5847":190758},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_6944":119818,"_42621":119714,"_30085":190760,"_5":21646,"_28538":190515,"_5847":81067},[],{"_6944":119819,"_42621":119714,"_30085":190762,"_5":21646,"_28538":190515,"_5847":190763},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_6944":119820,"_42621":119714,"_30085":190765,"_5":21646,"_28538":190515,"_5847":81073},[],{"_6944":119821,"_42621":119714,"_30085":190767,"_5":21646,"_28538":190515,"_5847":190768},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_6944":119822,"_42621":119714,"_30085":190770,"_5":21646,"_28538":190515,"_5847":190771},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_6944":119823,"_42621":119714,"_30085":190773,"_5":21646,"_28538":190519,"_5847":190774},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_6944":119824,"_42621":119714,"_30085":190776,"_5":21646,"_28538":190522,"_5847":188142},[],{"_6944":119825,"_42621":119714,"_30085":190778,"_5":21646,"_28538":190522,"_5847":190779},[],"Qué publica",{"_6944":119826,"_42621":119714,"_30085":190781,"_5":21646,"_28538":190522,"_5847":81090},[],{"_6944":119827,"_42621":119714,"_30085":190783,"_5":21646,"_28538":190522,"_5847":190784},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_6944":119828,"_42621":119714,"_30085":190786,"_5":21646,"_28538":190522,"_5847":81096},[],{"_6944":119829,"_42621":119714,"_30085":190788,"_5":21646,"_28538":190522,"_5847":190789},[],"Certificado de la CA emisora seleccionada.",{"_6944":119830,"_42621":119714,"_30085":190791,"_5":21646,"_28538":190522,"_5847":81102},[],{"_6944":119831,"_42621":119714,"_30085":190793,"_5":21646,"_28538":190522,"_5847":190794},[],"Certificados de las CAs elegidas explícitamente.",{"_6944":119832,"_42621":119714,"_30085":190796,"_5":21646,"_28538":190522,"_5847":190797},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_6944":119833,"_42621":119714,"_30085":190799,"_5":21646,"_28538":190526,"_5847":190800},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_6944":119834,"_42621":119714,"_30085":190802,"_5":21646,"_28538":190526,"_5847":190803},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_6944":119835,"_42621":119714,"_30085":190805,"_5":21646,"_28538":190526,"_5847":190806},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_6944":119836,"_42621":119714,"_30085":190808,"_5":21646,"_28538":190530,"_5847":190809},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_6944":119837,"_42621":119837,"_5":22076,"_5847":190811,"_43101":190812,"_30085":190813,"_28538":119837},"Integra el cliente EST",[78004,189200,80483,190209,190384],[],{"_6944":119838,"_42621":119837,"_30085":190815,"_5":21646,"_28538":119837,"_5847":190816},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_6944":119839,"_42621":119837,"_5":43098,"_30085":190818,"_28538":190819,"_5847":187778},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_6944":119840,"_42621":119837,"_5":43098,"_30085":190821,"_28538":190822,"_5847":190823},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_6944":119841,"_42621":119837,"_5":43098,"_30085":190825,"_28538":190826,"_5847":190827},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_6944":119842,"_42621":119837,"_5":43098,"_30085":190829,"_28538":190830,"_5847":190831},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_6944":119843,"_42621":119837,"_5":43098,"_30085":190833,"_28538":190834,"_5847":190835},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_6944":119844,"_42621":119837,"_5":43098,"_30085":190837,"_28538":190838,"_5847":190839},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_6944":119845,"_42621":119837,"_30085":190841,"_5":21646,"_28538":119837,"_5847":190842},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_6944":119846,"_42621":119837,"_30085":190844,"_5":21646,"_28538":190819,"_5847":190845},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_6944":119847,"_42621":119837,"_30085":190847,"_5":21646,"_28538":190819,"_5847":190848},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_6944":119848,"_42621":119837,"_30085":190850,"_5":21646,"_28538":190819,"_5847":190851},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_6944":119849,"_42621":119837,"_30085":190853,"_5":21646,"_28538":190822,"_5847":190854},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_6944":119850,"_42621":119837,"_30085":190856,"_5":21646,"_28538":190822,"_5847":190857},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_6944":119851,"_42621":119837,"_30085":190859,"_5":21646,"_28538":190826,"_5847":190860},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_6944":119852,"_42621":119837,"_30085":190862,"_5":21646,"_28538":190826,"_5847":190863},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_6944":119853,"_42621":119837,"_30085":190865,"_5":21646,"_28538":190830,"_5847":190866},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_6944":119854,"_42621":119837,"_30085":190868,"_5":21646,"_28538":190830,"_5847":190869},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_6944":119855,"_42621":119837,"_30085":190871,"_5":21646,"_28538":190834,"_5847":190872},[],"Para el caso de una raíz que emite directamente:",{"_6944":119856,"_42621":119837,"_30085":190874,"_5":21646,"_28538":190834,"_5847":190875},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_6944":119857,"_42621":119837,"_30085":190877,"_5":21646,"_28538":190834,"_5847":190878},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_6944":119858,"_42621":119837,"_30085":190880,"_5":21646,"_28538":190838,"_5847":190881},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_6944":119859,"_42621":119859,"_5":22076,"_5847":190883,"_43101":190884,"_30085":190885,"_28538":119859},"Referencia EST",[78004,189200,80483,190209,190384],[],{"_6944":119860,"_42621":119859,"_30085":190887,"_5":21646,"_28538":119859,"_5847":190888},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_6944":119861,"_42621":119859,"_5":43098,"_30085":190890,"_28538":190891,"_5847":190892},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_6944":119862,"_42621":119859,"_5":43098,"_30085":190894,"_28538":190895,"_5847":32264},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_6944":119863,"_42621":119859,"_5":43098,"_30085":190897,"_28538":190898,"_5847":36546},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_6944":119864,"_42621":119859,"_5":43098,"_30085":190900,"_28538":190901,"_5847":36553},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_6944":119865,"_42621":119859,"_5":43098,"_30085":190903,"_28538":190904,"_5847":35641},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_6944":119866,"_42621":119859,"_5":43098,"_30085":190906,"_28538":190907,"_5847":190908},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_6944":119867,"_42621":119859,"_5":43098,"_30085":190910,"_28538":190911,"_5847":190912},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_6944":119868,"_42621":119859,"_5":43098,"_30085":190914,"_28538":190915,"_5847":190916},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_6944":119869,"_42621":119859,"_30085":190918,"_5":21646,"_28538":119859,"_5847":190919},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_6944":119870,"_42621":119859,"_30085":190921,"_5":21646,"_28538":190891,"_5847":190922},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_6944":119871,"_42621":119859,"_30085":190924,"_5":21646,"_28538":190891,"_5847":188960},[],{"_6944":119872,"_42621":119859,"_30085":190926,"_5":21646,"_28538":190891,"_5847":190927},[],"Método",{"_6944":119873,"_42621":119859,"_30085":190929,"_5":21646,"_28538":190891,"_5847":190930},[],"Autenticación y condición",{"_6944":119874,"_42621":119859,"_30085":190932,"_5":21646,"_28538":190891,"_5847":81245},[],{"_6944":119875,"_42621":119859,"_30085":190934,"_5":21646,"_28538":190891,"_5847":81248},[],{"_6944":119876,"_42621":119859,"_30085":190936,"_5":21646,"_28538":190891,"_5847":190937},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_6944":119877,"_42621":119859,"_30085":190939,"_5":21646,"_28538":190891,"_5847":81254},[],{"_6944":119878,"_42621":119859,"_30085":190941,"_5":21646,"_28538":190891,"_5847":81257},[],{"_6944":119879,"_42621":119859,"_30085":190943,"_5":21646,"_28538":190891,"_5847":190944},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_6944":119880,"_42621":119859,"_30085":190946,"_5":21646,"_28538":190891,"_5847":81263},[],{"_6944":119881,"_42621":119859,"_30085":190948,"_5":21646,"_28538":190891,"_5847":81257},[],{"_6944":119882,"_42621":119859,"_30085":190950,"_5":21646,"_28538":190891,"_5847":190951},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_6944":119883,"_42621":119859,"_30085":190953,"_5":21646,"_28538":190891,"_5847":81271},[],{"_6944":119884,"_42621":119859,"_30085":190955,"_5":21646,"_28538":190891,"_5847":81257},[],{"_6944":119885,"_42621":119859,"_30085":190957,"_5":21646,"_28538":190891,"_5847":190958},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_6944":119886,"_42621":119859,"_30085":190960,"_5":21646,"_28538":190891,"_5847":190961},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_6944":119887,"_42621":119859,"_30085":190963,"_5":21646,"_28538":190895,"_5847":190964},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_6944":119888,"_42621":119859,"_30085":190966,"_5":21646,"_28538":190895,"_5847":190967},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_6944":119889,"_42621":119859,"_30085":190969,"_5":21646,"_28538":190898,"_5847":190970},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_6944":119890,"_42621":119859,"_30085":190972,"_5":21646,"_28538":190898,"_5847":190973},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_6944":119891,"_42621":119859,"_30085":190975,"_5":21646,"_28538":190901,"_5847":190976},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_6944":119892,"_42621":119859,"_30085":190978,"_5":21646,"_28538":190901,"_5847":190979},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_6944":119893,"_42621":119859,"_30085":190981,"_5":21646,"_28538":190904,"_5847":190982},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_6944":119894,"_42621":119859,"_30085":190984,"_5":21646,"_28538":190904,"_5847":190985},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_6944":119895,"_42621":119859,"_30085":190987,"_5":21646,"_28538":190907,"_5847":190988},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_6944":119896,"_42621":119859,"_30085":190990,"_5":21646,"_28538":190907,"_5847":190991},[],"Parte",{"_6944":119897,"_42621":119859,"_30085":190993,"_5":21646,"_28538":190907,"_5847":190994},[],"Contenido tras decodificar su Base64",{"_6944":119898,"_42621":119859,"_30085":190996,"_5":21646,"_28538":190907,"_5847":81315},[],{"_6944":119899,"_42621":119859,"_30085":190998,"_5":21646,"_28538":190907,"_5847":190999},[],"Clave privada PKCS#8 DER sin cifrar.",{"_6944":119900,"_42621":119859,"_30085":191001,"_5":21646,"_28538":190907,"_5847":81321},[],{"_6944":119901,"_42621":119859,"_30085":191003,"_5":21646,"_28538":190907,"_5847":191004},[],"PKCS#7 DER con el certificado emitido.",{"_6944":119902,"_42621":119859,"_30085":191006,"_5":21646,"_28538":190907,"_5847":191007},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_6944":119903,"_42621":119859,"_30085":191009,"_5":21646,"_28538":190911,"_5847":191010},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_6944":119904,"_42621":119859,"_30085":191012,"_5":21646,"_28538":190911,"_5847":191013},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_6944":119905,"_42621":119859,"_30085":191015,"_5":21646,"_28538":190911,"_5847":191016},[],"Convierte y comprueba el resultado:",{"_6944":119906,"_42621":119859,"_30085":191018,"_5":21646,"_28538":190911,"_5847":191019},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_6944":119907,"_42621":119859,"_30085":191021,"_5":21646,"_28538":190915,"_5847":191022},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_6944":119908,"_42621":119859,"_30085":191024,"_5":21646,"_28538":190915,"_5847":191025},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_6944":119909,"_42621":119909,"_5":22076,"_5847":190384,"_43101":191027,"_30085":191028,"_28538":119909},[78004,189200,80483,190209,190384],[],{"_6944":119910,"_42621":119909,"_30085":191030,"_5":21646,"_28538":119909,"_5847":191031},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_6944":119911,"_42621":119909,"_5":43098,"_30085":191033,"_28538":191034,"_5847":191035},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_6944":119912,"_42621":119909,"_5":43098,"_30085":191037,"_28538":191038,"_5847":191039},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_6944":119913,"_42621":119909,"_5":43098,"_30085":191041,"_28538":191042,"_5847":191043},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_6944":119914,"_42621":119909,"_5":43098,"_30085":191045,"_28538":191046,"_5847":191047},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_6944":119915,"_42621":119909,"_30085":191049,"_5":21646,"_28538":119909,"_5847":191050},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_6944":119916,"_42621":119909,"_30085":191052,"_5":21646,"_28538":191034,"_5847":191053},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_6944":119917,"_42621":119909,"_30085":191055,"_5":21646,"_28538":191034,"_5847":191056},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_6944":119918,"_42621":119909,"_30085":191058,"_5":21646,"_28538":191034,"_5847":191059},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_6944":119919,"_42621":119909,"_30085":191061,"_5":21646,"_28538":191034,"_5847":191062},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_6944":119920,"_42621":119909,"_30085":191064,"_5":21646,"_28538":191034,"_5847":191065},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_6944":119921,"_42621":119909,"_30085":191067,"_5":21646,"_28538":191034,"_5847":191068},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_6944":119922,"_42621":119909,"_30085":191070,"_5":21646,"_28538":191038,"_5847":191071},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_6944":119923,"_42621":119909,"_30085":191073,"_5":21646,"_28538":191038,"_5847":191074},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_6944":119924,"_42621":119909,"_30085":191076,"_5":21646,"_28538":191038,"_5847":191077},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_6944":119925,"_42621":119909,"_30085":191079,"_5":21646,"_28538":191038,"_5847":191080},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_6944":119926,"_42621":119909,"_30085":191082,"_5":21646,"_28538":191042,"_5847":191083},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_6944":119927,"_42621":119909,"_30085":191085,"_5":21646,"_28538":191042,"_5847":191086},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_6944":119928,"_42621":119909,"_30085":191088,"_5":21646,"_28538":191042,"_5847":191089},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_6944":119929,"_42621":119909,"_30085":191091,"_5":21646,"_28538":191042,"_5847":191092},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_6944":119930,"_42621":119909,"_30085":191094,"_5":21646,"_28538":191046,"_5847":191095},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_6944":119931,"_42621":119909,"_30085":191097,"_5":21646,"_28538":191046,"_5847":191098},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_6944":119932,"_42621":119932,"_5":22076,"_5847":191100,"_43101":191101,"_30085":191102,"_28538":119932},"Estrategias de aprovisionamiento",[78004,189200,80483,190209,190384],[],{"_6944":119933,"_42621":119932,"_30085":191104,"_5":21646,"_28538":119932,"_5847":191105},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_6944":119934,"_42621":119932,"_5":43098,"_30085":191107,"_28538":191108,"_5847":191109},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_6944":119935,"_42621":119932,"_5":43098,"_30085":191111,"_28538":191112,"_5847":191113},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_6944":119936,"_42621":119932,"_5":43098,"_30085":191115,"_28538":191116,"_5847":191117},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_6944":119937,"_42621":119932,"_5":43098,"_30085":191119,"_28538":191120,"_5847":191121},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_6944":119938,"_42621":119932,"_5":43098,"_30085":191123,"_28538":191124,"_5847":191125},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_6944":119939,"_42621":119932,"_30085":191127,"_5":21646,"_28538":119932,"_5847":191128},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_6944":119940,"_42621":119932,"_30085":191130,"_5":21646,"_28538":191108,"_5847":191131},[],"Recorrido",{"_6944":119941,"_42621":119932,"_30085":191133,"_5":21646,"_28538":191108,"_5847":191134},[],"Cuándo existe el dispositivo",{"_6944":119942,"_42621":119932,"_30085":191136,"_5":21646,"_28538":191108,"_5847":191137},[],"Qué compruebas",{"_6944":119943,"_42621":119932,"_30085":191139,"_5":21646,"_28538":191108,"_5847":191140},[],"Asignación manual",{"_6944":119944,"_42621":119932,"_30085":191142,"_5":21646,"_28538":191108,"_5847":191143},[],"El operador lo crea antes de asociar un certificado.",{"_6944":119945,"_42621":119932,"_30085":191145,"_5":21646,"_28538":191108,"_5847":191146},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_6944":119946,"_42621":119932,"_30085":191148,"_5":21646,"_28538":191108,"_5847":191149},[],"EST con `JITP`",{"_6944":119947,"_42621":119932,"_30085":191151,"_5":21646,"_28538":191108,"_5847":191152},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_6944":119948,"_42621":119932,"_30085":191154,"_5":21646,"_28538":191108,"_5847":191155},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_6944":119949,"_42621":119932,"_30085":191157,"_5":21646,"_28538":191108,"_5847":191158},[],"EST con `PRE_REGISTRATION`",{"_6944":119950,"_42621":119932,"_30085":191160,"_5":21646,"_28538":191108,"_5847":191161},[],"Debe existir antes de `/simpleenroll`.",{"_6944":119951,"_42621":119932,"_30085":191163,"_5":21646,"_28538":191108,"_5847":191164},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_6944":119952,"_42621":119932,"_30085":191166,"_5":21646,"_28538":191108,"_5847":191167},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_6944":119953,"_42621":119932,"_30085":191169,"_5":21646,"_28538":191108,"_5847":191170},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_6944":119954,"_42621":119932,"_30085":191172,"_5":21646,"_28538":191112,"_5847":191173},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_6944":119955,"_42621":119932,"_30085":191175,"_5":21646,"_28538":191112,"_5847":191176},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_6944":119956,"_42621":119932,"_30085":191178,"_5":21646,"_28538":191112,"_5847":191179},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_6944":119957,"_42621":119932,"_30085":191181,"_5":21646,"_28538":191116,"_5847":191182},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_6944":119958,"_42621":119932,"_30085":191184,"_5":21646,"_28538":191116,"_5847":191185},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_6944":119959,"_42621":119932,"_30085":191187,"_5":21646,"_28538":191116,"_5847":191188},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_6944":119960,"_42621":119932,"_30085":191190,"_5":21646,"_28538":191116,"_5847":191191},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_6944":119961,"_42621":119932,"_30085":191193,"_5":21646,"_28538":191116,"_5847":191194},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_6944":119962,"_42621":119932,"_30085":191196,"_5":21646,"_28538":191116,"_5847":191197},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_6944":119963,"_42621":119932,"_30085":191199,"_5":21646,"_28538":191120,"_5847":188142},[],{"_6944":119964,"_42621":119932,"_30085":191201,"_5":21646,"_28538":191120,"_5847":191202},[],"Material que atraviesa EST",{"_6944":119965,"_42621":119932,"_30085":191204,"_5":21646,"_28538":191120,"_5847":191205},[],"Clave generada por el dispositivo",{"_6944":119966,"_42621":119932,"_30085":191207,"_5":21646,"_28538":191120,"_5847":191208},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_6944":119967,"_42621":119932,"_30085":191210,"_5":21646,"_28538":191120,"_5847":191211},[],"Clave ya disponible en el dispositivo",{"_6944":119968,"_42621":119932,"_30085":191213,"_5":21646,"_28538":191120,"_5847":191214},[],"CSR firmada con la clave existente y certificado nuevo.",{"_6944":119969,"_42621":119932,"_30085":191216,"_5":21646,"_28538":191120,"_5847":80802},[],{"_6944":119970,"_42621":119932,"_30085":191218,"_5":21646,"_28538":191120,"_5847":191219},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_6944":119971,"_42621":119932,"_30085":191221,"_5":21646,"_28538":191120,"_5847":191222},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_6944":119972,"_42621":119932,"_30085":191224,"_5":21646,"_28538":191124,"_5847":191225},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_6944":119973,"_42621":119973,"_5":22076,"_5847":191227,"_43101":191228,"_30085":191229,"_28538":119973},"Renovación y recuperación",[78004,189200,80483,190209,190384],[],{"_6944":119974,"_42621":119973,"_30085":191231,"_5":21646,"_28538":119973,"_5847":191232},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_6944":119975,"_42621":119973,"_5":43098,"_30085":191234,"_28538":191235,"_5847":191236},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_6944":119976,"_42621":119973,"_5":43098,"_30085":191238,"_28538":191239,"_5847":191240},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_6944":119977,"_42621":119973,"_5":43098,"_30085":191242,"_28538":191243,"_5847":191244},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_6944":119978,"_42621":119973,"_5":43098,"_30085":191246,"_28538":191247,"_5847":191248},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_6944":119979,"_42621":119973,"_5":43098,"_30085":191250,"_28538":191251,"_5847":191252},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_6944":119980,"_42621":119973,"_30085":191254,"_5":21646,"_28538":119973,"_5847":191255},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_6944":119981,"_42621":119973,"_30085":191257,"_5":21646,"_28538":191235,"_5847":191258},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_6944":119982,"_42621":119973,"_30085":191260,"_5":21646,"_28538":191235,"_5847":191261},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_6944":119983,"_42621":119973,"_30085":191263,"_5":21646,"_28538":191235,"_5847":191264},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_6944":119984,"_42621":119973,"_30085":191266,"_5":21646,"_28538":191235,"_5847":191267},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_6944":119985,"_42621":119973,"_30085":191269,"_5":21646,"_28538":191239,"_5847":191270},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_6944":119986,"_42621":119973,"_30085":191272,"_5":21646,"_28538":191239,"_5847":191273},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_6944":119987,"_42621":119973,"_30085":191275,"_5":21646,"_28538":191243,"_5847":191276},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_6944":119988,"_42621":119973,"_30085":191278,"_5":21646,"_28538":191243,"_5847":191279},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_6944":119989,"_42621":119973,"_30085":191281,"_5":21646,"_28538":191243,"_5847":191282},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_6944":119990,"_42621":119973,"_30085":191284,"_5":21646,"_28538":191247,"_5847":191285},[],"Situación",{"_6944":119991,"_42621":119973,"_30085":191287,"_5":21646,"_28538":191247,"_5847":191288},[],"Procedimiento",{"_6944":119992,"_42621":119973,"_30085":191290,"_5":21646,"_28538":191247,"_5847":191291},[],"Certificado vigente, fuera de ventana",{"_6944":119993,"_42621":119973,"_30085":191293,"_5":21646,"_28538":191247,"_5847":191294},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_6944":119994,"_42621":119973,"_30085":191296,"_5":21646,"_28538":191247,"_5847":191297},[],"Certificado vencido, clave disponible",{"_6944":119995,"_42621":119973,"_30085":191299,"_5":21646,"_28538":191247,"_5847":191300},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_6944":119996,"_42621":119973,"_30085":191302,"_5":21646,"_28538":191247,"_5847":191303},[],"Renovación por webhook o `NO_AUTH`",{"_6944":119997,"_42621":119973,"_30085":191305,"_5":21646,"_28538":191247,"_5847":191306},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_6944":119998,"_42621":119973,"_30085":191308,"_5":21646,"_28538":191247,"_5847":191309},[],"Clave perdida o inaccesible",{"_6944":119999,"_42621":119973,"_30085":191311,"_5":21646,"_28538":191247,"_5847":191312},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_6944":120000,"_42621":119973,"_30085":191314,"_5":21646,"_28538":191247,"_5847":191315},[],"Identidad actual revocada",{"_6944":120001,"_42621":119973,"_30085":191317,"_5":21646,"_28538":191247,"_5847":191318},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_6944":120002,"_42621":119973,"_30085":191320,"_5":21646,"_28538":191247,"_5847":191321},[],"Dispositivo sin identidad",{"_6944":120003,"_42621":119973,"_30085":191323,"_5":21646,"_28538":191247,"_5847":191324},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_6944":120004,"_42621":119973,"_30085":191326,"_5":21646,"_28538":191247,"_5847":191327},[],"Dispositivo retirado",{"_6944":120005,"_42621":119973,"_30085":191329,"_5":21646,"_28538":191247,"_5847":191330},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_6944":120006,"_42621":119973,"_30085":191332,"_5":21646,"_28538":191247,"_5847":191333},[],"Timeout, HTTP 500 o fallo de instalación",{"_6944":120007,"_42621":119973,"_30085":191335,"_5":21646,"_28538":191247,"_5847":191336},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_6944":120008,"_42621":119973,"_30085":191338,"_5":21646,"_28538":191251,"_5847":191339},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_6944":120009,"_42621":119973,"_30085":191341,"_5":21646,"_28538":191251,"_5847":191342},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_6944":120010,"_42621":120010,"_5":22076,"_5847":191344,"_43101":191345,"_30085":191346,"_28538":120010},"Diagnóstico de enrolamiento",[78004,189200,80483,190209,190384],[],{"_6944":120011,"_42621":120010,"_30085":191348,"_5":21646,"_28538":120010,"_5847":191349},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_6944":120012,"_42621":120010,"_5":43098,"_30085":191351,"_28538":191352,"_5847":191353},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_6944":120013,"_42621":120010,"_5":43098,"_30085":191355,"_28538":191356,"_5847":191357},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_6944":120014,"_42621":120010,"_5":43098,"_30085":191359,"_28538":191360,"_5847":190916},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_6944":120015,"_42621":120010,"_5":43098,"_30085":191362,"_28538":191363,"_5847":191364},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_6944":120016,"_42621":120010,"_30085":191366,"_5":21646,"_28538":120010,"_5847":191367},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_6944":120017,"_42621":120010,"_30085":191369,"_5":21646,"_28538":191356,"_5847":191370},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_6944":120018,"_42621":120010,"_30085":191372,"_5":21646,"_28538":191356,"_5847":191373},[],"Síntoma o mensaje",{"_6944":120019,"_42621":120010,"_30085":191375,"_5":21646,"_28538":191356,"_5847":191376},[],"Qué revisar",{"_6944":120020,"_42621":120010,"_30085":191378,"_5":21646,"_28538":191356,"_5847":191379},[],"curl rechaza TLS, nombre o emisor",{"_6944":120021,"_42621":120010,"_30085":191381,"_5":21646,"_28538":191356,"_5847":191382},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_6944":120022,"_42621":120010,"_30085":191384,"_5":21646,"_28538":191356,"_5847":191385},[],"404 o APS ausente",{"_6944":120023,"_42621":120010,"_30085":191387,"_5":21646,"_28538":191356,"_5847":191388},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_6944":120024,"_42621":120010,"_30085":191390,"_5":21646,"_28538":191356,"_5847":191391},[],"400, error de CSR o formato",{"_6944":120025,"_42621":120010,"_30085":191393,"_5":21646,"_28538":191356,"_5847":191394},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_6944":120026,"_42621":120010,"_30085":191396,"_5":21646,"_28538":191356,"_5847":191397},[],"Credencial ausente o certificado no válido",{"_6944":120027,"_42621":120010,"_30085":191399,"_5":21646,"_28538":191356,"_5847":191400},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_6944":120028,"_42621":120010,"_30085":191402,"_5":21646,"_28538":191356,"_5847":191403},[],"Webhook deniega, expira o responde sin autorización",{"_6944":120029,"_42621":120010,"_30085":191405,"_5":21646,"_28538":191356,"_5847":191406},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_6944":120030,"_42621":120010,"_30085":191408,"_5":21646,"_28538":191356,"_5847":81728},[],{"_6944":120031,"_42621":120010,"_30085":191410,"_5":21646,"_28538":191356,"_5847":191411},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_6944":120032,"_42621":120010,"_30085":191413,"_5":21646,"_28538":191356,"_5847":81734},[],{"_6944":120033,"_42621":120010,"_30085":191415,"_5":21646,"_28538":191356,"_5847":191416},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_6944":120034,"_42621":120010,"_30085":191418,"_5":21646,"_28538":191356,"_5847":81740},[],{"_6944":120035,"_42621":120010,"_30085":191420,"_5":21646,"_28538":191356,"_5847":191421},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_6944":120036,"_42621":120010,"_30085":191423,"_5":21646,"_28538":191356,"_5847":81746},[],{"_6944":120037,"_42621":120010,"_30085":191425,"_5":21646,"_28538":191356,"_5847":191426},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_6944":120038,"_42621":120010,"_30085":191428,"_5":21646,"_28538":191356,"_5847":81752},[],{"_6944":120039,"_42621":120010,"_30085":191430,"_5":21646,"_28538":191356,"_5847":191431},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_6944":120040,"_42621":120010,"_30085":191433,"_5":21646,"_28538":191356,"_5847":191434},[],"400 `struct validation error` al crear o actualizar un DMS",{"_6944":120041,"_42621":120010,"_30085":191436,"_5":21646,"_28538":191356,"_5847":191437},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_6944":120042,"_42621":120010,"_30085":191439,"_5":21646,"_28538":191356,"_5847":191440},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_6944":120043,"_42621":120010,"_30085":191442,"_5":21646,"_28538":191356,"_5847":191443},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_6944":120044,"_42621":120010,"_30085":191445,"_5":21646,"_28538":191356,"_5847":81770},[],{"_6944":120045,"_42621":120010,"_30085":191447,"_5":21646,"_28538":191356,"_5847":191448},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_6944":120046,"_42621":120010,"_30085":191450,"_5":21646,"_28538":191356,"_5847":81776},[],{"_6944":120047,"_42621":120010,"_30085":191452,"_5":21646,"_28538":191356,"_5847":191453},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_6944":120048,"_42621":120010,"_30085":191455,"_5":21646,"_28538":191356,"_5847":191456},[],"DMS propietario distinto",{"_6944":120049,"_42621":120010,"_30085":191458,"_5":21646,"_28538":191356,"_5847":191459},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_6944":120050,"_42621":120010,"_30085":191461,"_5":21646,"_28538":191356,"_5847":81788},[],{"_6944":120051,"_42621":120010,"_30085":191463,"_5":21646,"_28538":191356,"_5847":191464},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_6944":120052,"_42621":120010,"_30085":191466,"_5":21646,"_28538":191356,"_5847":81794},[],{"_6944":120053,"_42621":120010,"_30085":191468,"_5":21646,"_28538":191356,"_5847":191469},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_6944":120054,"_42621":120010,"_30085":191471,"_5":21646,"_28538":191356,"_5847":191472},[],"Certificado actual revocado",{"_6944":120055,"_42621":120010,"_30085":191474,"_5":21646,"_28538":191356,"_5847":191475},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_6944":120056,"_42621":120010,"_30085":191477,"_5":21646,"_28538":191356,"_5847":191478},[],"Error de CA, perfil o firma",{"_6944":120057,"_42621":120010,"_30085":191480,"_5":21646,"_28538":191356,"_5847":191481},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_6944":120058,"_42621":120010,"_30085":191483,"_5":21646,"_28538":191356,"_5847":191484},[],"HTTP 200 sin conexión del dispositivo",{"_6944":120059,"_42621":120010,"_30085":191486,"_5":21646,"_28538":191356,"_5847":191487},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_6944":120060,"_42621":120010,"_30085":191489,"_5":21646,"_28538":191356,"_5847":191490},[],"Timeout o error después de emitir",{"_6944":120061,"_42621":120010,"_30085":191492,"_5":21646,"_28538":191356,"_5847":191493},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_6944":120062,"_42621":120010,"_30085":191495,"_5":21646,"_28538":191360,"_5847":191496},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_6944":120063,"_42621":120010,"_30085":191498,"_5":21646,"_28538":191360,"_5847":191499},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_6944":120064,"_42621":120010,"_30085":191501,"_5":21646,"_28538":191363,"_5847":191502},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_6944":120065,"_42621":120010,"_30085":191504,"_5":21646,"_28538":191363,"_5847":191505},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_6944":120066,"_42621":120010,"_30085":191507,"_5":21646,"_28538":191363,"_5847":191508},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_6944":120067,"_42621":120010,"_30085":191510,"_5":21646,"_28538":191363,"_5847":191511},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_6944":120068,"_42621":120010,"_30085":191513,"_5":21646,"_28538":191363,"_5847":191514},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_6944":120069,"_42621":120010,"_30085":191516,"_5":21646,"_28538":191363,"_5847":191517},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_6944":120070,"_42621":120010,"_30085":191519,"_5":21646,"_28538":191363,"_5847":191520},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_6944":120071,"_42621":120071,"_5":22076,"_5847":191522,"_43101":191523,"_30085":191524,"_28538":120071},"Distribución y actualización de confianza",[78004,189200,80483,190209,190384],[],{"_6944":120072,"_42621":120071,"_30085":191526,"_5":21646,"_28538":120071,"_5847":191527},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_6944":120073,"_42621":120071,"_5":43098,"_30085":191529,"_28538":191530,"_5847":191531},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_6944":120074,"_42621":120071,"_5":43098,"_30085":191533,"_28538":191534,"_5847":191535},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_6944":120075,"_42621":120071,"_5":43098,"_30085":191537,"_28538":191538,"_5847":191539},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_6944":120076,"_42621":120071,"_5":43098,"_30085":191541,"_28538":191542,"_5847":191543},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_6944":120077,"_42621":120071,"_5":43098,"_30085":191545,"_28538":191546,"_5847":191547},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_6944":120078,"_42621":120071,"_30085":191549,"_5":21646,"_28538":120071,"_5847":191550},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_6944":120079,"_42621":120071,"_30085":191552,"_5":21646,"_28538":191530,"_5847":191553},[],"Relación",{"_6944":120080,"_42621":120071,"_30085":191555,"_5":21646,"_28538":191530,"_5847":191556},[],"Material que prepara el responsable",{"_6944":120081,"_42621":120071,"_30085":191558,"_5":21646,"_28538":191530,"_5847":191559},[],"Dispositivo → servidor EST",{"_6944":120082,"_42621":120071,"_30085":191561,"_5":21646,"_28538":191530,"_5847":191562},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_6944":120083,"_42621":120071,"_30085":191564,"_5":21646,"_28538":191530,"_5847":191565},[],"DMS → solicitante",{"_6944":120084,"_42621":120071,"_30085":191567,"_5":21646,"_28538":191530,"_5847":191568},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_6944":120085,"_42621":120071,"_30085":191570,"_5":21646,"_28538":191530,"_5847":191571},[],"Consumidor → dispositivo",{"_6944":120086,"_42621":120071,"_30085":191573,"_5":21646,"_28538":191530,"_5847":191574},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_6944":120087,"_42621":120071,"_30085":191576,"_5":21646,"_28538":191530,"_5847":191577},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_6944":120088,"_42621":120071,"_30085":191579,"_5":21646,"_28538":191534,"_5847":191580},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_6944":120089,"_42621":120071,"_30085":191582,"_5":21646,"_28538":191534,"_5847":191583},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_6944":120090,"_42621":120071,"_30085":191585,"_5":21646,"_28538":191538,"_5847":191586},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_6944":120091,"_42621":120071,"_30085":191588,"_5":21646,"_28538":191538,"_5847":191589},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_6944":120092,"_42621":120071,"_30085":191591,"_5":21646,"_28538":191538,"_5847":191592},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_6944":120093,"_42621":120071,"_30085":191594,"_5":21646,"_28538":191538,"_5847":191595},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_6944":120094,"_42621":120071,"_30085":191597,"_5":21646,"_28538":191538,"_5847":191598},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_6944":120095,"_42621":120071,"_30085":191600,"_5":21646,"_28538":191538,"_5847":191601},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_6944":120096,"_42621":120071,"_30085":191603,"_5":21646,"_28538":191542,"_5847":191604},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_6944":120097,"_42621":120071,"_30085":191606,"_5":21646,"_28538":191542,"_5847":191607},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_6944":120098,"_42621":120071,"_30085":191609,"_5":21646,"_28538":191542,"_5847":191610},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_6944":120099,"_42621":120071,"_30085":191612,"_5":21646,"_28538":191546,"_5847":191613},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_6944":120100,"_42621":120100,"_5":22076,"_5847":81943,"_43101":191615,"_30085":191617,"_28538":120100},[78004,189200,80483,190209,191616],"Integraciones",[],{"_6944":120101,"_42621":120100,"_30085":191619,"_5":21646,"_28538":120100,"_5847":191620},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_6944":120102,"_42621":120100,"_5":43098,"_30085":191622,"_28538":191623,"_5847":191624},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_6944":120103,"_42621":120100,"_5":43098,"_30085":191626,"_28538":191627,"_5847":191628},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_6944":120104,"_42621":120100,"_5":43098,"_30085":191630,"_28538":191631,"_5847":191632},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_6944":120105,"_42621":120100,"_5":43098,"_30085":191634,"_28538":191635,"_5847":191636},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_6944":120106,"_42621":120100,"_5":43098,"_30085":191638,"_28538":191639,"_5847":191640},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_6944":120107,"_42621":120100,"_5":43098,"_30085":191642,"_28538":191643,"_5847":191644},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_6944":120108,"_42621":120100,"_5":43098,"_30085":191646,"_28538":191647,"_5847":191648},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_6944":120109,"_42621":120100,"_5":43098,"_30085":191650,"_28538":191651,"_5847":191652},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_6944":120110,"_42621":120100,"_5":43098,"_30085":191654,"_28538":191655,"_5847":81985},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_6944":120111,"_42621":120100,"_5":43098,"_30085":191657,"_28538":191658,"_5847":81989},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_6944":120112,"_42621":120100,"_5":43098,"_30085":191660,"_28538":191661,"_5847":191662},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_6944":120113,"_42621":120100,"_5":43098,"_30085":191664,"_28538":191665,"_5847":191666},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_6944":120114,"_42621":120100,"_5":43098,"_30085":191668,"_28538":191669,"_5847":191670},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_6944":120115,"_42621":120100,"_5":43098,"_30085":191672,"_28538":191673,"_5847":191674},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_6944":120116,"_42621":120100,"_5":43098,"_30085":191676,"_28538":191677,"_5847":191678},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_6944":120117,"_42621":120100,"_5":43098,"_30085":191680,"_28538":191681,"_5847":191682},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_6944":120118,"_42621":120100,"_5":43098,"_30085":191684,"_28538":191685,"_5847":191686},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_6944":120119,"_42621":120100,"_5":43098,"_30085":191688,"_28538":191689,"_5847":191690},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_6944":120120,"_42621":120100,"_5":43098,"_30085":191692,"_28538":191693,"_5847":191694},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_6944":120121,"_42621":120100,"_5":43098,"_30085":191696,"_28538":191697,"_5847":191698},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_6944":120122,"_42621":120100,"_5":43098,"_30085":191700,"_28538":191701,"_5847":191702},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_6944":120123,"_42621":120100,"_5":43098,"_30085":191704,"_28538":191705,"_5847":191706},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_6944":120124,"_42621":120100,"_5":43098,"_30085":191708,"_28538":191709,"_5847":191710},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_6944":120125,"_42621":120100,"_5":43098,"_30085":191712,"_28538":191713,"_5847":191714},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_6944":120126,"_42621":120100,"_5":43098,"_30085":191716,"_28538":191717,"_5847":191718},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_6944":120127,"_42621":120100,"_30085":191720,"_5":21646,"_28538":120100,"_5847":191721},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_6944":120128,"_42621":120100,"_30085":191723,"_5":21646,"_28538":120100,"_5847":191724},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_6944":120129,"_42621":120100,"_30085":191726,"_5":21646,"_28538":120100,"_5847":191727},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_6944":120130,"_42621":120100,"_30085":191729,"_5":21646,"_28538":191623,"_5847":191730},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_6944":120131,"_42621":120100,"_30085":191732,"_5":21646,"_28538":191623,"_5847":191733},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_6944":120132,"_42621":120100,"_30085":191735,"_5":21646,"_28538":191623,"_5847":191736},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_6944":120133,"_42621":120100,"_30085":191738,"_5":21646,"_28538":191623,"_5847":191739},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_6944":120134,"_42621":120100,"_30085":191741,"_5":21646,"_28538":191627,"_5847":191742},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_6944":120135,"_42621":120100,"_30085":191744,"_5":21646,"_28538":191631,"_5847":191745},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_6944":120136,"_42621":120100,"_30085":191747,"_5":21646,"_28538":191631,"_5847":191748},[],"Acción IAM",{"_6944":120137,"_42621":120100,"_30085":191750,"_5":21646,"_28538":191631,"_5847":188148},[],{"_6944":120138,"_42621":120100,"_30085":191752,"_5":21646,"_28538":191631,"_5847":82084},[],{"_6944":120139,"_42621":120100,"_30085":191754,"_5":21646,"_28538":191631,"_5847":191755},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_6944":120140,"_42621":120100,"_30085":191757,"_5":21646,"_28538":191631,"_5847":82090},[],{"_6944":120141,"_42621":120100,"_30085":191759,"_5":21646,"_28538":191631,"_5847":191760},[],"Registrar la CA en AWS IoT",{"_6944":120142,"_42621":120100,"_30085":191762,"_5":21646,"_28538":191631,"_5847":82096},[],{"_6944":120143,"_42621":120100,"_30085":191764,"_5":21646,"_28538":191631,"_5847":191765},[],"Consultar el estado del registro de la CA",{"_6944":120144,"_42621":120100,"_30085":191767,"_5":21646,"_28538":191631,"_5847":82102},[],{"_6944":120145,"_42621":120100,"_30085":191769,"_5":21646,"_28538":191631,"_5847":191770},[],"Crear o actualizar Things en IoT Core",{"_6944":120146,"_42621":120100,"_30085":191772,"_5":21646,"_28538":191631,"_5847":82108},[],{"_6944":120147,"_42621":120100,"_30085":191774,"_5":21646,"_28538":191631,"_5847":191775},[],"Aprovisionar Things mediante plantilla",{"_6944":120148,"_42621":120100,"_30085":191777,"_5":21646,"_28538":191631,"_5847":82114},[],{"_6944":120149,"_42621":120100,"_30085":191779,"_5":21646,"_28538":191631,"_5847":191780},[],"Registrar certificados de dispositivo",{"_6944":120150,"_42621":120100,"_30085":191782,"_5":21646,"_28538":191631,"_5847":82120},[],{"_6944":120151,"_42621":120100,"_30085":191784,"_5":21646,"_28538":191631,"_5847":191785},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_6944":120152,"_42621":120100,"_30085":191787,"_5":21646,"_28538":191631,"_5847":82126},[],{"_6944":120153,"_42621":120100,"_30085":191789,"_5":21646,"_28538":191631,"_5847":191790},[],"Crear y adjuntar políticas IoT",{"_6944":120154,"_42621":120100,"_30085":191792,"_5":21646,"_28538":191631,"_5847":82132},[],{"_6944":120155,"_42621":120100,"_30085":191794,"_5":21646,"_28538":191631,"_5847":191795},[],"Gestionar grupos de Things",{"_6944":120156,"_42621":120100,"_30085":191797,"_5":21646,"_28538":191631,"_5847":82138},[],{"_6944":120157,"_42621":120100,"_30085":191799,"_5":21646,"_28538":191631,"_5847":191800},[],"Crear plantillas JITP",{"_6944":120158,"_42621":120100,"_30085":191802,"_5":21646,"_28538":191631,"_5847":82144},[],{"_6944":120159,"_42621":120100,"_30085":191804,"_5":21646,"_28538":191631,"_5847":191805},[],"Leer y escribir el Device Shadow",{"_6944":120160,"_42621":120100,"_30085":191807,"_5":21646,"_28538":191631,"_5847":191808},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_6944":120161,"_42621":120100,"_30085":191810,"_5":21646,"_28538":191635,"_5847":191811},[],"Parámetro",{"_6944":120162,"_42621":120100,"_30085":191813,"_5":21646,"_28538":191635,"_5847":191814},[],"Tipo",{"_6944":120163,"_42621":120100,"_30085":191816,"_5":21646,"_28538":191635,"_5847":191817},[],"Requerido",{"_6944":120164,"_42621":120100,"_30085":191819,"_5":21646,"_28538":191635,"_5847":191820},[],"Descripción",{"_6944":120165,"_42621":120100,"_30085":191822,"_5":21646,"_28538":191635,"_5847":82165},[],{"_6944":120166,"_42621":120100,"_30085":191824,"_5":21646,"_28538":191635,"_5847":35152},[],{"_6944":120167,"_42621":120100,"_30085":191826,"_5":21646,"_28538":191635,"_5847":191827},[],"Sí",{"_6944":120168,"_42621":120100,"_30085":191829,"_5":21646,"_28538":191635,"_5847":191830},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_6944":120169,"_42621":120100,"_30085":191832,"_5":21646,"_28538":191635,"_5847":82176},[],{"_6944":120170,"_42621":120100,"_30085":191834,"_5":21646,"_28538":191635,"_5847":35152},[],{"_6944":120171,"_42621":120100,"_30085":191836,"_5":21646,"_28538":191635,"_5847":191827},[],{"_6944":120172,"_42621":120100,"_30085":191838,"_5":21646,"_28538":191635,"_5847":191839},[],"Región AWS donde opera el conector.",{"_6944":120173,"_42621":120100,"_30085":191841,"_5":21646,"_28538":191635,"_5847":82186},[],{"_6944":120174,"_42621":120100,"_30085":191843,"_5":21646,"_28538":191635,"_5847":35152},[],{"_6944":120175,"_42621":120100,"_30085":191845,"_5":21646,"_28538":191635,"_5847":191827},[],{"_6944":120176,"_42621":120100,"_30085":191847,"_5":21646,"_28538":191635,"_5847":191848},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_6944":120177,"_42621":120100,"_30085":191850,"_5":21646,"_28538":191635,"_5847":82196},[],{"_6944":120178,"_42621":120100,"_30085":191852,"_5":21646,"_28538":191635,"_5847":35152},[],{"_6944":120179,"_42621":120100,"_30085":191854,"_5":21646,"_28538":191635,"_5847":191855},[],"Solo con `auth_method=static`",{"_6944":120180,"_42621":120100,"_30085":191857,"_5":21646,"_28538":191635,"_5847":191858},[],"Clave de acceso AWS.",{"_6944":120181,"_42621":120100,"_30085":191860,"_5":21646,"_28538":191635,"_5847":82207},[],{"_6944":120182,"_42621":120100,"_30085":191862,"_5":21646,"_28538":191635,"_5847":35152},[],{"_6944":120183,"_42621":120100,"_30085":191864,"_5":21646,"_28538":191635,"_5847":191855},[],{"_6944":120184,"_42621":120100,"_30085":191866,"_5":21646,"_28538":191635,"_5847":191867},[],"Clave secreta AWS.",{"_6944":120185,"_42621":120100,"_30085":191869,"_5":21646,"_28538":191635,"_5847":82217},[],{"_6944":120186,"_42621":120100,"_30085":191871,"_5":21646,"_28538":191635,"_5847":35152},[],{"_6944":120187,"_42621":120100,"_30085":191873,"_5":21646,"_28538":191635,"_5847":82222},[],{"_6944":120188,"_42621":120100,"_30085":191875,"_5":21646,"_28538":191635,"_5847":191876},[],"Token de sesión (con `auth_method=static`).",{"_6944":120189,"_42621":120100,"_30085":191878,"_5":21646,"_28538":191635,"_5847":82228},[],{"_6944":120190,"_42621":120100,"_30085":191880,"_5":21646,"_28538":191635,"_5847":35152},[],{"_6944":120191,"_42621":120100,"_30085":191882,"_5":21646,"_28538":191635,"_5847":191883},[],"Solo con `auth_method=role`",{"_6944":120192,"_42621":120100,"_30085":191885,"_5":21646,"_28538":191635,"_5847":191886},[],"ARN del rol a asumir.",{"_6944":120193,"_42621":120100,"_30085":191888,"_5":21646,"_28538":191635,"_5847":82239},[],{"_6944":120194,"_42621":120100,"_30085":191890,"_5":21646,"_28538":191635,"_5847":35152},[],{"_6944":120195,"_42621":120100,"_30085":191892,"_5":21646,"_28538":191635,"_5847":82222},[],{"_6944":120196,"_42621":120100,"_30085":191894,"_5":21646,"_28538":191635,"_5847":191895},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_6944":120197,"_42621":120100,"_30085":191897,"_5":21646,"_28538":191635,"_5847":82249},[],{"_6944":120198,"_42621":120100,"_30085":191899,"_5":21646,"_28538":191635,"_5847":145206},[],{"_6944":120199,"_42621":120100,"_30085":191901,"_5":21646,"_28538":191635,"_5847":191827},[],{"_6944":120200,"_42621":120100,"_30085":191903,"_5":21646,"_28538":191635,"_5847":191904},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_6944":120201,"_42621":120100,"_30085":191906,"_5":21646,"_28538":191635,"_5847":82259},[],{"_6944":120202,"_42621":120100,"_30085":191908,"_5":21646,"_28538":191635,"_5847":35152},[],{"_6944":120203,"_42621":120100,"_30085":191910,"_5":21646,"_28538":191635,"_5847":191827},[],{"_6944":120204,"_42621":120100,"_30085":191912,"_5":21646,"_28538":191635,"_5847":191913},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_6944":120205,"_42621":120100,"_30085":191915,"_5":21646,"_28538":191635,"_5847":82269},[],{"_6944":120206,"_42621":120100,"_30085":191917,"_5":21646,"_28538":191635,"_5847":35152},[],{"_6944":120207,"_42621":120100,"_30085":191919,"_5":21646,"_28538":191635,"_5847":191827},[],{"_6944":120208,"_42621":120100,"_30085":191921,"_5":21646,"_28538":191635,"_5847":191922},[],"URL HTTP del Device Manager de Lamassu.",{"_6944":120209,"_42621":120100,"_30085":191924,"_5":21646,"_28538":191635,"_5847":82279},[],{"_6944":120210,"_42621":120100,"_30085":191926,"_5":21646,"_28538":191635,"_5847":35152},[],{"_6944":120211,"_42621":120100,"_30085":191928,"_5":21646,"_28538":191635,"_5847":191827},[],{"_6944":120212,"_42621":120100,"_30085":191930,"_5":21646,"_28538":191635,"_5847":191931},[],"URL HTTP del servicio de CA de Lamassu.",{"_6944":120213,"_42621":120100,"_30085":191933,"_5":21646,"_28538":191639,"_5847":191934},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_6944":120214,"_42621":120100,"_30085":191936,"_5":21646,"_28538":191639,"_5847":191937},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_6944":120215,"_42621":120100,"_30085":191939,"_5":21646,"_28538":191639,"_5847":191940},[],"Tipo de CloudEvent",{"_6944":120216,"_42621":120100,"_30085":191942,"_5":21646,"_28538":191639,"_5847":191943},[],"Recurso en Lamassu",{"_6944":120217,"_42621":120100,"_30085":191945,"_5":21646,"_28538":191639,"_5847":191946},[],"Recurso AWS",{"_6944":120218,"_42621":120100,"_30085":191948,"_5":21646,"_28538":191639,"_5847":191949},[],"Acciones IAM",{"_6944":120219,"_42621":120100,"_30085":191951,"_5":21646,"_28538":191639,"_5847":191952},[],"Llamadas AWS y efecto",{"_6944":120220,"_42621":120100,"_30085":191954,"_5":21646,"_28538":191639,"_5847":191955},[],"Dónde en esta página",{"_6944":120221,"_42621":120100,"_30085":191957,"_5":21646,"_28538":191639,"_5847":82313},[],{"_6944":120222,"_42621":120100,"_30085":191959,"_5":21646,"_28538":191639,"_5847":82316},[],{"_6944":120223,"_42621":120100,"_30085":191961,"_5":21646,"_28538":191639,"_5847":82319},[],{"_6944":120224,"_42621":120100,"_30085":191963,"_5":21646,"_28538":191639,"_5847":82322},[],{"_6944":120225,"_42621":120100,"_30085":191965,"_5":21646,"_28538":191639,"_5847":191966},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_6944":120226,"_42621":120100,"_30085":191968,"_5":21646,"_28538":191639,"_5847":191652},[],{"_6944":120227,"_42621":120100,"_30085":191970,"_5":21646,"_28538":191639,"_5847":82330},[],{"_6944":120228,"_42621":120100,"_30085":191972,"_5":21646,"_28538":191639,"_5847":82333},[],{"_6944":120229,"_42621":120100,"_30085":191974,"_5":21646,"_28538":191639,"_5847":82336},[],{"_6944":120230,"_42621":120100,"_30085":191976,"_5":21646,"_28538":191639,"_5847":82339},[],{"_6944":120231,"_42621":120100,"_30085":191978,"_5":21646,"_28538":191639,"_5847":191979},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_6944":120232,"_42621":120100,"_30085":191981,"_5":21646,"_28538":191639,"_5847":191678},[],{"_6944":120233,"_42621":120100,"_30085":191983,"_5":21646,"_28538":191639,"_5847":82347},[],{"_6944":120234,"_42621":120100,"_30085":191985,"_5":21646,"_28538":191639,"_5847":191986},[],"Dispositivo",{"_6944":120235,"_42621":120100,"_30085":191988,"_5":21646,"_28538":191639,"_5847":82353},[],{"_6944":120236,"_42621":120100,"_30085":191990,"_5":21646,"_28538":191639,"_5847":82356},[],{"_6944":120237,"_42621":120100,"_30085":191992,"_5":21646,"_28538":191639,"_5847":191993},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_6944":120238,"_42621":120100,"_30085":191995,"_5":21646,"_28538":191639,"_5847":191686},[],{"_6944":120239,"_42621":120100,"_30085":191997,"_5":21646,"_28538":191639,"_5847":82364},[],{"_6944":120240,"_42621":120100,"_30085":191999,"_5":21646,"_28538":191639,"_5847":192000},[],"Certificado",{"_6944":120241,"_42621":120100,"_30085":192002,"_5":21646,"_28538":191639,"_5847":82370},[],{"_6944":120242,"_42621":120100,"_30085":192004,"_5":21646,"_28538":191639,"_5847":192005},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_6944":120243,"_42621":120100,"_30085":192007,"_5":21646,"_28538":191639,"_5847":192008},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_6944":120244,"_42621":120100,"_30085":192010,"_5":21646,"_28538":191639,"_5847":191698},[],{"_6944":120245,"_42621":120100,"_30085":192012,"_5":21646,"_28538":191639,"_5847":82381},[],{"_6944":120246,"_42621":120100,"_30085":192014,"_5":21646,"_28538":191639,"_5847":192015},[],"Certificado / Dispositivo",{"_6944":120247,"_42621":120100,"_30085":192017,"_5":21646,"_28538":191639,"_5847":82387},[],{"_6944":120248,"_42621":120100,"_30085":192019,"_5":21646,"_28538":191639,"_5847":78400},[],{"_6944":120249,"_42621":120100,"_30085":192021,"_5":21646,"_28538":191639,"_5847":192022},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_6944":120250,"_42621":120100,"_30085":192024,"_5":21646,"_28538":191639,"_5847":191706},[],{"_6944":120251,"_42621":120100,"_30085":192026,"_5":21646,"_28538":191643,"_5847":192027},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_6944":120252,"_42621":120100,"_30085":192029,"_5":21646,"_28538":191647,"_5847":192030},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_6944":120253,"_42621":120100,"_30085":192032,"_5":21646,"_28538":191647,"_5847":192033},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_6944":120254,"_42621":120100,"_30085":192035,"_5":21646,"_28538":191651,"_5847":192036},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_6944":120255,"_42621":120100,"_30085":192038,"_5":21646,"_28538":191651,"_5847":192039},[],"Transición",{"_6944":120256,"_42621":120100,"_30085":192041,"_5":21646,"_28538":191651,"_5847":192042},[],"Llamadas AWS",{"_6944":120257,"_42621":120100,"_30085":192044,"_5":21646,"_28538":191651,"_5847":192045},[],"`NoRegistrada` → `Solicitada`",{"_6944":120258,"_42621":120100,"_30085":192047,"_5":21646,"_28538":191651,"_5847":192048},[],"ninguna (solo escritura de metadatos)",{"_6944":120259,"_42621":120100,"_30085":192050,"_5":21646,"_28538":191651,"_5847":192051},[],"`Solicitada` → `Registrando`",{"_6944":120260,"_42621":120100,"_30085":192053,"_5":21646,"_28538":191651,"_5847":192054},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_6944":120261,"_42621":120100,"_30085":192056,"_5":21646,"_28538":191651,"_5847":192057},[],"`Registrando` → `Completada`",{"_6944":120262,"_42621":120100,"_30085":192059,"_5":21646,"_28538":191651,"_5847":192060},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_6944":120263,"_42621":120100,"_30085":192062,"_5":21646,"_28538":191651,"_5847":192063},[],"`Registrando` → `Fallida`",{"_6944":120264,"_42621":120100,"_30085":192065,"_5":21646,"_28538":191651,"_5847":192066},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_6944":120265,"_42621":120100,"_30085":192068,"_5":21646,"_28538":191651,"_5847":192069},[],"`Fallida` / `Completada` → `Solicitada`",{"_6944":120266,"_42621":120100,"_30085":192071,"_5":21646,"_28538":191651,"_5847":192072},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_6944":120267,"_42621":120100,"_30085":192074,"_5":21646,"_28538":191655,"_5847":192075},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_6944":120268,"_42621":120100,"_30085":192077,"_5":21646,"_28538":191655,"_5847":192078},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_6944":120269,"_42621":120100,"_30085":192080,"_5":21646,"_28538":191655,"_5847":192081},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_6944":120270,"_42621":120100,"_30085":192083,"_5":21646,"_28538":191655,"_5847":192084},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_6944":120271,"_42621":120100,"_30085":192086,"_5":21646,"_28538":191655,"_5847":192087},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_6944":120272,"_42621":120100,"_30085":192089,"_5":21646,"_28538":191655,"_5847":192090},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_6944":120273,"_42621":120100,"_30085":192092,"_5":21646,"_28538":191658,"_5847":192093},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_6944":120274,"_42621":120100,"_30085":192095,"_5":21646,"_28538":191661,"_5847":192096},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_6944":120275,"_42621":120100,"_30085":192098,"_5":21646,"_28538":191661,"_5847":192099},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_6944":120276,"_42621":120100,"_30085":192101,"_5":21646,"_28538":191665,"_5847":192102},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_6944":120277,"_42621":120100,"_30085":192104,"_5":21646,"_28538":191669,"_5847":192105},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_6944":120278,"_42621":120100,"_30085":192107,"_5":21646,"_28538":191669,"_5847":192108},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_6944":120279,"_42621":120100,"_30085":192110,"_5":21646,"_28538":191669,"_5847":192111},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_6944":120280,"_42621":120100,"_30085":192113,"_5":21646,"_28538":191669,"_5847":192114},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_6944":120281,"_42621":120100,"_30085":192116,"_5":21646,"_28538":191669,"_5847":192117},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_6944":120282,"_42621":120100,"_30085":192119,"_5":21646,"_28538":191669,"_5847":192120},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_6944":120283,"_42621":120100,"_30085":192122,"_5":21646,"_28538":191673,"_5847":192123},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_6944":120284,"_42621":120100,"_30085":192125,"_5":21646,"_28538":191673,"_5847":192126},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_6944":120285,"_42621":120100,"_30085":192128,"_5":21646,"_28538":191673,"_5847":192129},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_6944":120286,"_42621":120100,"_30085":192131,"_5":21646,"_28538":191673,"_5847":192132},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_6944":120287,"_42621":120100,"_30085":192134,"_5":21646,"_28538":191673,"_5847":192135},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_6944":120288,"_42621":120100,"_30085":192137,"_5":21646,"_28538":191677,"_5847":192138},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_6944":120289,"_42621":120100,"_30085":192140,"_5":21646,"_28538":191677,"_5847":192039},[],{"_6944":120290,"_42621":120100,"_30085":192142,"_5":21646,"_28538":191677,"_5847":192042},[],{"_6944":120291,"_42621":120100,"_30085":192144,"_5":21646,"_28538":191677,"_5847":192145},[],"`SinConfigurar` → `None` / `Auto`",{"_6944":120292,"_42621":120100,"_30085":192147,"_5":21646,"_28538":191677,"_5847":192148},[],"ninguna (solo configuración)",{"_6944":120293,"_42621":120100,"_30085":192150,"_5":21646,"_28538":191677,"_5847":82524},[],{"_6944":120294,"_42621":120100,"_30085":192152,"_5":21646,"_28538":191677,"_5847":192148},[],{"_6944":120295,"_42621":120100,"_30085":192154,"_5":21646,"_28538":191677,"_5847":192155},[],"Cualquiera → `Jitp`",{"_6944":120296,"_42621":120100,"_30085":192157,"_5":21646,"_28538":191677,"_5847":192158},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_6944":120297,"_42621":120100,"_30085":192160,"_5":21646,"_28538":191677,"_5847":82535},[],{"_6944":120298,"_42621":120100,"_30085":192162,"_5":21646,"_28538":191677,"_5847":192163},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_6944":120299,"_42621":120100,"_30085":192165,"_5":21646,"_28538":191681,"_5847":192166},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_6944":120300,"_42621":120100,"_30085":192168,"_5":21646,"_28538":191681,"_5847":192169},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_6944":120301,"_42621":120100,"_30085":192171,"_5":21646,"_28538":191681,"_5847":192172},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_6944":120302,"_42621":120100,"_30085":192174,"_5":21646,"_28538":191685,"_5847":192175},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_6944":120303,"_42621":120100,"_30085":192177,"_5":21646,"_28538":191685,"_5847":192039},[],{"_6944":120304,"_42621":120100,"_30085":192179,"_5":21646,"_28538":191685,"_5847":192042},[],{"_6944":120305,"_42621":120100,"_30085":192181,"_5":21646,"_28538":191685,"_5847":192182},[],"`Ausente` → `Aprovisionado`",{"_6944":120306,"_42621":120100,"_30085":192184,"_5":21646,"_28538":191685,"_5847":192185},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_6944":120307,"_42621":120100,"_30085":192187,"_5":21646,"_28538":191685,"_5847":192188},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_6944":120308,"_42621":120100,"_30085":192190,"_5":21646,"_28538":191685,"_5847":192191},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_6944":120309,"_42621":120100,"_30085":192193,"_5":21646,"_28538":191685,"_5847":192194},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_6944":120310,"_42621":120100,"_30085":192196,"_5":21646,"_28538":191689,"_5847":192197},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_6944":120311,"_42621":120100,"_30085":192199,"_5":21646,"_28538":191689,"_5847":192200},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_6944":120312,"_42621":120100,"_30085":192202,"_5":21646,"_28538":191689,"_5847":192203},[],"Para que el flujo JITP funcione correctamente:",{"_6944":120313,"_42621":120100,"_30085":192205,"_5":21646,"_28538":191689,"_5847":192206},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_6944":120314,"_42621":120100,"_30085":192208,"_5":21646,"_28538":191689,"_5847":192209},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_6944":120315,"_42621":120100,"_30085":192211,"_5":21646,"_28538":191689,"_5847":192212},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_6944":120316,"_42621":120100,"_30085":192214,"_5":21646,"_28538":191689,"_5847":192215},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_6944":120317,"_42621":120100,"_30085":192217,"_5":21646,"_28538":191693,"_5847":192218},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_6944":120318,"_42621":120100,"_30085":192220,"_5":21646,"_28538":191693,"_5847":192221},[],"Estado en Lamassu",{"_6944":120319,"_42621":120100,"_30085":192223,"_5":21646,"_28538":191693,"_5847":192224},[],"Razón de revocación",{"_6944":120320,"_42621":120100,"_30085":192226,"_5":21646,"_28538":191693,"_5847":192227},[],"Estado en AWS IoT Core",{"_6944":120321,"_42621":120100,"_30085":192229,"_5":21646,"_28538":191693,"_5847":82605},[],{"_6944":120322,"_42621":120100,"_30085":192231,"_5":21646,"_28538":191693,"_5847":192232},[],"Ninguna",{"_6944":120323,"_42621":120100,"_30085":192234,"_5":21646,"_28538":191693,"_5847":82611},[],{"_6944":120324,"_42621":120100,"_30085":192236,"_5":21646,"_28538":191693,"_5847":82614},[],{"_6944":120325,"_42621":120100,"_30085":192238,"_5":21646,"_28538":191693,"_5847":82617},[],{"_6944":120326,"_42621":120100,"_30085":192240,"_5":21646,"_28538":191693,"_5847":82620},[],{"_6944":120327,"_42621":120100,"_30085":192242,"_5":21646,"_28538":191693,"_5847":82614},[],{"_6944":120328,"_42621":120100,"_30085":192244,"_5":21646,"_28538":191693,"_5847":192245},[],"Cualquier otra razón",{"_6944":120329,"_42621":120100,"_30085":192247,"_5":21646,"_28538":191693,"_5847":82628},[],{"_6944":120330,"_42621":120100,"_30085":192249,"_5":21646,"_28538":191693,"_5847":192250},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_6944":120331,"_42621":120100,"_30085":192252,"_5":21646,"_28538":191697,"_5847":192253},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_6944":120332,"_42621":120100,"_30085":192255,"_5":21646,"_28538":191697,"_5847":192039},[],{"_6944":120333,"_42621":120100,"_30085":192257,"_5":21646,"_28538":191697,"_5847":192042},[],{"_6944":120334,"_42621":120100,"_30085":192259,"_5":21646,"_28538":191697,"_5847":192260},[],"`NoSincronizado` → `Active`",{"_6944":120335,"_42621":120100,"_30085":192262,"_5":21646,"_28538":191697,"_5847":82120},[],{"_6944":120336,"_42621":120100,"_30085":192264,"_5":21646,"_28538":191697,"_5847":82646},[],{"_6944":120337,"_42621":120100,"_30085":192266,"_5":21646,"_28538":191697,"_5847":192267},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_6944":120338,"_42621":120100,"_30085":192269,"_5":21646,"_28538":191697,"_5847":82652},[],{"_6944":120339,"_42621":120100,"_30085":192271,"_5":21646,"_28538":191697,"_5847":192267},[],{"_6944":120340,"_42621":120100,"_30085":192273,"_5":21646,"_28538":191697,"_5847":82657},[],{"_6944":120341,"_42621":120100,"_30085":192275,"_5":21646,"_28538":191697,"_5847":82120},[],{"_6944":120342,"_42621":120100,"_30085":192277,"_5":21646,"_28538":191697,"_5847":82662},[],{"_6944":120343,"_42621":120100,"_30085":192279,"_5":21646,"_28538":191697,"_5847":192280},[],"ninguna (estos estados no se sincronizan con AWS)",{"_6944":120344,"_42621":120100,"_30085":192282,"_5":21646,"_28538":191701,"_5847":192283},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_6944":120345,"_42621":120100,"_30085":192285,"_5":21646,"_28538":191701,"_5847":192286},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_6944":120346,"_42621":120100,"_30085":192288,"_5":21646,"_28538":191701,"_5847":192289},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_6944":120347,"_42621":120100,"_30085":192291,"_5":21646,"_28538":191705,"_5847":192292},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_6944":120348,"_42621":120100,"_30085":192294,"_5":21646,"_28538":191705,"_5847":192295},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_6944":120349,"_42621":120100,"_30085":192297,"_5":21646,"_28538":191709,"_5847":192298},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_6944":120350,"_42621":120100,"_30085":192300,"_5":21646,"_28538":191709,"_5847":192301},[],"Existen dos tipos de acciones:",{"_6944":120351,"_42621":120100,"_30085":192303,"_5":21646,"_28538":191709,"_5847":192304},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_6944":120352,"_42621":120100,"_30085":192306,"_5":21646,"_28538":191709,"_5847":192307},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_6944":120353,"_42621":120100,"_30085":192309,"_5":21646,"_28538":191709,"_5847":192310},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_6944":120354,"_42621":120100,"_30085":192312,"_5":21646,"_28538":191713,"_5847":192313},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_6944":120355,"_42621":120100,"_30085":192315,"_5":21646,"_28538":191713,"_5847":192316},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_6944":120356,"_42621":120100,"_30085":192318,"_5":21646,"_28538":191713,"_5847":192319},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_6944":120357,"_42621":120100,"_30085":192321,"_5":21646,"_28538":191717,"_5847":192322},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_6944":120358,"_42621":120100,"_30085":192324,"_5":21646,"_28538":191717,"_5847":192325},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_6944":120359,"_42621":120100,"_30085":192327,"_5":21646,"_28538":191717,"_5847":192328},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_6944":120360,"_42621":120100,"_30085":192330,"_5":21646,"_28538":191717,"_5847":192331},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_6944":120361,"_42621":120100,"_30085":192333,"_5":21646,"_28538":191717,"_5847":192334},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_6944":120362,"_42621":120100,"_30085":192336,"_5":21646,"_28538":191717,"_5847":192337},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_6944":120363,"_42621":120100,"_30085":192339,"_5":21646,"_28538":191717,"_5847":192340},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_6944":120364,"_42621":120100,"_30085":192342,"_5":21646,"_28538":191717,"_5847":192343},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_6944":120365,"_42621":120100,"_30085":192345,"_5":21646,"_28538":191717,"_5847":192346},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_6944":120366,"_42621":120100,"_30085":192348,"_5":21646,"_28538":191717,"_5847":192349},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_6944":120367,"_42621":120100,"_30085":192351,"_5":21646,"_28538":191717,"_5847":192352},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_6944":120368,"_42621":120100,"_30085":192354,"_5":21646,"_28538":191717,"_5847":192355},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_6944":120369,"_42621":120100,"_30085":192357,"_5":21646,"_28538":191717,"_5847":192358},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_6944":120370,"_42621":120100,"_30085":192360,"_5":21646,"_28538":191717,"_5847":192361},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_6944":120371,"_42621":120100,"_30085":192363,"_5":21646,"_28538":191717,"_5847":192364},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_6944":120372,"_42621":120100,"_30085":192366,"_5":21646,"_28538":191717,"_5847":192367},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_6944":120373,"_42621":120100,"_30085":192369,"_5":21646,"_28538":191717,"_5847":192370},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_6944":120374,"_42621":120100,"_30085":192372,"_5":21646,"_28538":191717,"_5847":192373},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_6944":120375,"_42621":120100,"_30085":192375,"_5":21646,"_28538":191717,"_5847":192376},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_6944":120376,"_42621":120100,"_30085":192378,"_5":21646,"_28538":191717,"_5847":192379},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_6944":120377,"_42621":120100,"_30085":192381,"_5":21646,"_28538":191717,"_5847":192382},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_6944":120378,"_42621":120100,"_30085":192384,"_5":21646,"_28538":191717,"_5847":192385},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_6944":120379,"_42621":120100,"_30085":192387,"_5":21646,"_28538":191717,"_5847":192388},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_6944":120380,"_42621":120100,"_30085":192390,"_5":21646,"_28538":191717,"_5847":192391},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_6944":120381,"_42621":120381,"_5":22076,"_5847":80483,"_43101":192393,"_30085":192394,"_28538":120381},[78004,189200,80483],[],{"_6944":120382,"_42621":120381,"_30085":192396,"_5":21646,"_28538":120381,"_5847":192397},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_6944":120383,"_42621":120381,"_5":43098,"_30085":192399,"_28538":192400,"_5847":192401},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_6944":120384,"_42621":120381,"_5":43098,"_30085":192403,"_28538":192404,"_5847":190209},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_6944":120385,"_42621":120381,"_5":43098,"_30085":192406,"_28538":192407,"_5847":190384},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_6944":120386,"_42621":120381,"_5":43098,"_30085":192409,"_28538":192410,"_5847":191616},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/overview#integraciones",{"_6944":120387,"_42621":120381,"_5":43098,"_30085":192412,"_28538":192413,"_5847":192414},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/overview#actualizaciones-de-software","Actualizaciones de software",{"_6944":120388,"_42621":120381,"_5":43098,"_30085":192416,"_28538":192417,"_5847":192418},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_6944":120389,"_42621":120381,"_30085":192420,"_5":21646,"_28538":120381,"_5847":192421},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_6944":120390,"_42621":120381,"_30085":192423,"_5":21646,"_28538":192400,"_5847":192424},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_6944":120391,"_42621":120381,"_30085":192426,"_5":21646,"_28538":192400,"_5847":192427},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_6944":120392,"_42621":120381,"_30085":192429,"_5":21646,"_28538":192404,"_5847":192430},[],"Recurso",{"_6944":120393,"_42621":120381,"_30085":192432,"_5":21646,"_28538":192404,"_5847":192433},[],"Qué representa",{"_6944":120394,"_42621":120381,"_30085":192435,"_5":21646,"_28538":192404,"_5847":192436},[],"**Dispositivo**",{"_6944":120395,"_42621":120381,"_30085":192438,"_5":21646,"_28538":192404,"_5847":192439},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_6944":120396,"_42621":120381,"_30085":192441,"_5":21646,"_28538":192404,"_5847":192442},[],"**Identidad**",{"_6944":120397,"_42621":120381,"_30085":192444,"_5":21646,"_28538":192404,"_5847":192445},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_6944":120398,"_42621":120381,"_30085":192447,"_5":21646,"_28538":192404,"_5847":82833},[],{"_6944":120399,"_42621":120381,"_30085":192449,"_5":21646,"_28538":192404,"_5847":192450},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_6944":120400,"_42621":120381,"_30085":192452,"_5":21646,"_28538":192404,"_5847":192453},[],"**Flota**",{"_6944":120401,"_42621":120381,"_30085":192455,"_5":21646,"_28538":192404,"_5847":192456},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_6944":120402,"_42621":120381,"_30085":192458,"_5":21646,"_28538":192404,"_5847":192459},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_6944":120403,"_42621":120381,"_30085":192461,"_5":21646,"_28538":192404,"_5847":192462},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_6944":120404,"_42621":120381,"_30085":192464,"_5":21646,"_28538":192407,"_5847":192465},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_6944":120405,"_42621":120381,"_30085":192467,"_5":21646,"_28538":192407,"_5847":192468},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_6944":120406,"_42621":120381,"_30085":192470,"_5":21646,"_28538":192407,"_5847":192471},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_6944":120407,"_42621":120381,"_30085":192473,"_5":21646,"_28538":192407,"_5847":192474},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_6944":120408,"_42621":120381,"_30085":192476,"_5":21646,"_28538":192407,"_5847":192477},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_6944":120409,"_42621":120381,"_30085":192479,"_5":21646,"_28538":192407,"_5847":192480},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_6944":120410,"_42621":120381,"_30085":192482,"_5":21646,"_28538":192407,"_5847":192483},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_6944":120411,"_42621":120381,"_30085":192485,"_5":21646,"_28538":192407,"_5847":192486},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_6944":120412,"_42621":120381,"_30085":192488,"_5":21646,"_28538":192410,"_5847":192489},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_6944":120413,"_42621":120381,"_30085":192491,"_5":21646,"_28538":192410,"_5847":192492},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_6944":120414,"_42621":120381,"_30085":192494,"_5":21646,"_28538":192413,"_5847":192495},[],"Cuando los dispositivos ya tienen identidad, Lamassu Updates les entrega firmware y software por aire. Publicas un paquete, eliges los dispositivos o grupos que lo reciben y sigues el despliegue; los dispositivos lo instalan con SWUpdate y los paquetes pueden firmarse y cifrarse.",{"_6944":120415,"_42621":120381,"_30085":192497,"_5":21646,"_28538":192413,"_5847":192498},[],"<Card title=\"Lamassu Updates\" description=\"Entiende el servicio, sus dos backends y el ciclo de vida de una actualización.\" href=\"/docs/platform/updates/overview\" />",{"_6944":120416,"_42621":120381,"_30085":192500,"_5":21646,"_28538":192413,"_5847":192501},[],"<Card title=\"Publica y despliega una actualización\" description=\"Crea un pack, genera el paquete y lánzalo a un grupo de dispositivos.\" href=\"/docs/platform/updates/guides/publish-and-roll-out\" />",{"_6944":120417,"_42621":120381,"_30085":192503,"_5":21646,"_28538":192417,"_5847":192504},[],"Participante",{"_6944":120418,"_42621":120381,"_30085":192506,"_5":21646,"_28538":192417,"_5847":192507},[],"Responsabilidad",{"_6944":120419,"_42621":120381,"_30085":192509,"_5":21646,"_28538":192417,"_5847":192510},[],"Administrador PKI",{"_6944":120420,"_42621":120381,"_30085":192512,"_5":21646,"_28538":192417,"_5847":192513},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_6944":120421,"_42621":120381,"_30085":192515,"_5":21646,"_28538":192417,"_5847":192516},[],"Administrador del aprovisionamiento",{"_6944":120422,"_42621":120381,"_30085":192518,"_5":21646,"_28538":192417,"_5847":192519},[],"DMS, admisión, autenticación por operación e inventario.",{"_6944":120423,"_42621":120381,"_30085":192521,"_5":21646,"_28538":192417,"_5847":192522},[],"Integrador del dispositivo",{"_6944":120424,"_42621":120381,"_30085":192524,"_5":21646,"_28538":192417,"_5847":192525},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_6944":120425,"_42621":120381,"_30085":192527,"_5":21646,"_28538":192417,"_5847":192528},[],"Integrador del consumidor",{"_6944":120426,"_42621":120381,"_30085":192530,"_5":21646,"_28538":192417,"_5847":192531},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_6944":120427,"_42621":120381,"_30085":192533,"_5":21646,"_28538":192417,"_5847":192534},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_6944":120428,"_42621":120428,"_5":22076,"_5847":192536,"_43101":192537,"_30085":192539,"_28538":120428},"Enrola y conecta tu primer dispositivo",[78004,189200,80483,192538],"Primeros pasos",[],{"_6944":120429,"_42621":120428,"_30085":192541,"_5":21646,"_28538":120428,"_5847":192542},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_6944":120430,"_42621":120428,"_5":43098,"_30085":192544,"_28538":192545,"_5847":187778},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_6944":120431,"_42621":120428,"_5":43098,"_30085":192547,"_28538":192548,"_5847":192549},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_6944":120432,"_42621":120428,"_5":43098,"_30085":192551,"_28538":192552,"_5847":192553},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_6944":120433,"_42621":120428,"_5":43098,"_30085":192555,"_28538":192556,"_5847":192557},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_6944":120434,"_42621":120428,"_5":43098,"_30085":192559,"_28538":192560,"_5847":192561},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_6944":120435,"_42621":120428,"_5":43098,"_30085":192563,"_28538":192564,"_5847":192565},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_6944":120436,"_42621":120428,"_5":43098,"_30085":192567,"_28538":192568,"_5847":192569},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_6944":120437,"_42621":120428,"_5":43098,"_30085":192571,"_28538":192572,"_5847":192573},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_6944":120438,"_42621":120428,"_30085":192575,"_5":21646,"_28538":120428,"_5847":192576},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_6944":120439,"_42621":120428,"_30085":192578,"_5":21646,"_28538":192545,"_5847":192579},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_6944":120440,"_42621":120428,"_30085":192581,"_5":21646,"_28538":192545,"_5847":192582},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_6944":120441,"_42621":120428,"_30085":192584,"_5":21646,"_28538":192545,"_5847":192585},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_6944":120442,"_42621":120428,"_30085":192587,"_5":21646,"_28538":192545,"_5847":192588},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_6944":120443,"_42621":120428,"_30085":192590,"_5":21646,"_28538":192545,"_5847":192591},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_6944":120444,"_42621":120428,"_30085":192593,"_5":21646,"_28538":192548,"_5847":192594},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_6944":120445,"_42621":120428,"_30085":192596,"_5":21646,"_28538":192548,"_5847":192597},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_6944":120446,"_42621":120428,"_30085":192599,"_5":21646,"_28538":192552,"_5847":192600},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_6944":120447,"_42621":120428,"_30085":192602,"_5":21646,"_28538":192552,"_5847":192603},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_6944":120448,"_42621":120428,"_30085":192605,"_5":21646,"_28538":192552,"_5847":192606},[],"Ajuste",{"_6944":120449,"_42621":120428,"_30085":192608,"_5":21646,"_28538":192552,"_5847":192609},[],"Valor de evaluación",{"_6944":120450,"_42621":120428,"_30085":192611,"_5":21646,"_28538":192552,"_5847":82998},[],{"_6944":120451,"_42621":120428,"_30085":192613,"_5":21646,"_28538":192552,"_5847":192614},[],"Raíz emisora de `device-root.pem`.",{"_6944":120452,"_42621":120428,"_30085":192616,"_5":21646,"_28538":192552,"_5847":190512},[],{"_6944":120453,"_42621":120428,"_30085":192618,"_5":21646,"_28538":192552,"_5847":192619},[],"Perfil final de 1 hora que acabas de preparar.",{"_6944":120454,"_42621":120428,"_30085":192621,"_5":21646,"_28538":192552,"_5847":83009},[],{"_6944":120455,"_42621":120428,"_30085":192623,"_5":21646,"_28538":192552,"_5847":83012},[],{"_6944":120456,"_42621":120428,"_30085":192625,"_5":21646,"_28538":192552,"_5847":83015},[],{"_6944":120457,"_42621":120428,"_30085":192627,"_5":21646,"_28538":192552,"_5847":192628},[],"Habilitado.",{"_6944":120458,"_42621":120428,"_30085":192630,"_5":21646,"_28538":192552,"_5847":83021},[],{"_6944":120459,"_42621":120428,"_30085":192632,"_5":21646,"_28538":192552,"_5847":192633},[],"Deshabilitado; el ID debe ser nuevo.",{"_6944":120460,"_42621":120428,"_30085":192635,"_5":21646,"_28538":192552,"_5847":192636},[],"Autenticación inicial",{"_6944":120461,"_42621":120428,"_30085":192638,"_5":21646,"_28538":192552,"_5847":192639},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_6944":120462,"_42621":120428,"_30085":192641,"_5":21646,"_28538":192552,"_5847":192642},[],"Autenticación de renovación",{"_6944":120463,"_42621":120428,"_30085":192644,"_5":21646,"_28538":192552,"_5847":192645},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_6944":120464,"_42621":120428,"_30085":192647,"_5":21646,"_28538":192552,"_5847":83039},[],{"_6944":120465,"_42621":120428,"_30085":192649,"_5":21646,"_28538":192552,"_5847":192650},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_6944":120466,"_42621":120428,"_30085":192652,"_5":21646,"_28538":192552,"_5847":83045},[],{"_6944":120467,"_42621":120428,"_30085":192654,"_5":21646,"_28538":192552,"_5847":192655},[],"1 hora.",{"_6944":120468,"_42621":120428,"_30085":192657,"_5":21646,"_28538":192552,"_5847":83051},[],{"_6944":120469,"_42621":120428,"_30085":192659,"_5":21646,"_28538":192552,"_5847":192660},[],"30 minutos / 10 minutos.",{"_6944":120470,"_42621":120428,"_30085":192662,"_5":21646,"_28538":192552,"_5847":83057},[],{"_6944":120471,"_42621":120428,"_30085":192664,"_5":21646,"_28538":192552,"_5847":192665},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_6944":120472,"_42621":120428,"_30085":192667,"_5":21646,"_28538":192552,"_5847":80802},[],{"_6944":120473,"_42621":120428,"_30085":192669,"_5":21646,"_28538":192552,"_5847":192670},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_6944":120474,"_42621":120428,"_30085":192672,"_5":21646,"_28538":192552,"_5847":83068},[],{"_6944":120475,"_42621":120428,"_30085":192674,"_5":21646,"_28538":192552,"_5847":192675},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_6944":120476,"_42621":120428,"_30085":192677,"_5":21646,"_28538":192552,"_5847":192678},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_6944":120477,"_42621":120428,"_30085":192680,"_5":21646,"_28538":192556,"_5847":192681},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_6944":120478,"_42621":120428,"_30085":192683,"_5":21646,"_28538":192556,"_5847":192684},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_6944":120479,"_42621":120428,"_30085":192686,"_5":21646,"_28538":192560,"_5847":192687},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_6944":120480,"_42621":120428,"_30085":192689,"_5":21646,"_28538":192560,"_5847":192690},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_6944":120481,"_42621":120428,"_30085":192692,"_5":21646,"_28538":192560,"_5847":192693},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_6944":120482,"_42621":120428,"_30085":192695,"_5":21646,"_28538":192564,"_5847":192696},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_6944":120483,"_42621":120428,"_30085":192698,"_5":21646,"_28538":192564,"_5847":192699},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_6944":120484,"_42621":120428,"_30085":192701,"_5":21646,"_28538":192568,"_5847":192702},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_6944":120485,"_42621":120428,"_30085":192704,"_5":21646,"_28538":192568,"_5847":192705},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_6944":120486,"_42621":120428,"_30085":192707,"_5":21646,"_28538":192568,"_5847":192708},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_6944":120487,"_42621":120428,"_30085":192710,"_5":21646,"_28538":192568,"_5847":192711},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_6944":120488,"_42621":120428,"_30085":192713,"_5":21646,"_28538":192568,"_5847":192714},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_6944":120489,"_42621":120428,"_30085":192716,"_5":21646,"_28538":192572,"_5847":192717},[],"Comprobación",{"_6944":120490,"_42621":120428,"_30085":192719,"_5":21646,"_28538":192572,"_5847":192720},[],"Resultado esperado",{"_6944":120491,"_42621":120428,"_30085":192722,"_5":21646,"_28538":192572,"_5847":192723},[],"Registro",{"_6944":120492,"_42621":120428,"_30085":192725,"_5":21646,"_28538":192572,"_5847":192726},[],"ID creado automáticamente y DMS correcto.",{"_6944":120493,"_42621":120428,"_30085":192728,"_5":21646,"_28538":192572,"_5847":192000},[],{"_6944":120494,"_42621":120428,"_30085":192730,"_5":21646,"_28538":192572,"_5847":192731},[],"CN, perfil, serie y clave verificados.",{"_6944":120495,"_42621":120428,"_30085":192733,"_5":21646,"_28538":192572,"_5847":192734},[],"Inventario",{"_6944":120496,"_42621":120428,"_30085":192736,"_5":21646,"_28538":192572,"_5847":192737},[],"Serie recibida visible como identidad actual y en el historial.",{"_6944":120497,"_42621":120428,"_30085":192739,"_5":21646,"_28538":192572,"_5847":192740},[],"Consumidor",{"_6944":120498,"_42621":120428,"_30085":192742,"_5":21646,"_28538":192572,"_5847":192743},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_6944":120499,"_42621":120428,"_30085":192745,"_5":21646,"_28538":192572,"_5847":192746},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_6944":120500,"_42621":120428,"_30085":192748,"_5":21646,"_28538":192572,"_5847":192749},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_6944":120501,"_42621":120501,"_5":22076,"_5847":190226,"_43101":192751,"_30085":192752,"_28538":120501},[78004,189200,80483,192538],[],{"_6944":120502,"_42621":120501,"_30085":192754,"_5":21646,"_28538":120501,"_5847":192755},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_6944":120503,"_42621":120501,"_5":43098,"_30085":192757,"_28538":192758,"_5847":187778},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_6944":120504,"_42621":120501,"_5":43098,"_30085":192760,"_28538":192761,"_5847":192762},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_6944":120505,"_42621":120501,"_5":43098,"_30085":192764,"_28538":192765,"_5847":192766},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_6944":120506,"_42621":120501,"_5":43098,"_30085":192768,"_28538":192769,"_5847":192770},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_6944":120507,"_42621":120501,"_5":43098,"_30085":192772,"_28538":192773,"_5847":192774},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_6944":120508,"_42621":120501,"_5":43098,"_30085":192776,"_28538":192777,"_5847":192778},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_6944":120509,"_42621":120501,"_5":43098,"_30085":192780,"_28538":192781,"_5847":192720},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_6944":120510,"_42621":120501,"_5":43098,"_30085":192783,"_28538":192784,"_5847":192785},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_6944":120511,"_42621":120501,"_5":43098,"_30085":192787,"_28538":192788,"_5847":192789},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_6944":120512,"_42621":120501,"_30085":192791,"_5":21646,"_28538":120501,"_5847":192792},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_6944":120513,"_42621":120501,"_30085":192794,"_5":21646,"_28538":120501,"_5847":192795},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_6944":120514,"_42621":120501,"_30085":192797,"_5":21646,"_28538":192758,"_5847":192798},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_6944":120515,"_42621":120501,"_30085":192800,"_5":21646,"_28538":192758,"_5847":192801},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_6944":120516,"_42621":120501,"_30085":192803,"_5":21646,"_28538":192758,"_5847":192804},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_6944":120517,"_42621":120501,"_30085":192806,"_5":21646,"_28538":192758,"_5847":192807},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_6944":120518,"_42621":120501,"_30085":192809,"_5":21646,"_28538":192761,"_5847":192810},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_6944":120519,"_42621":120501,"_30085":192812,"_5":21646,"_28538":192761,"_5847":192813},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_6944":120520,"_42621":120501,"_30085":192815,"_5":21646,"_28538":192761,"_5847":192816},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_6944":120521,"_42621":120501,"_30085":192818,"_5":21646,"_28538":192761,"_5847":192819},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_6944":120522,"_42621":120501,"_30085":192821,"_5":21646,"_28538":192761,"_5847":192822},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_6944":120523,"_42621":120501,"_30085":192824,"_5":21646,"_28538":192761,"_5847":192825},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_6944":120524,"_42621":120501,"_30085":192827,"_5":21646,"_28538":192761,"_5847":192828},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_6944":120525,"_42621":120501,"_30085":192830,"_5":21646,"_28538":192761,"_5847":192831},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_6944":120526,"_42621":120501,"_30085":192833,"_5":21646,"_28538":192765,"_5847":192834},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_6944":120527,"_42621":120501,"_30085":192836,"_5":21646,"_28538":192765,"_5847":83233},[],{"_6944":120528,"_42621":120501,"_30085":192838,"_5":21646,"_28538":192765,"_5847":192839},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_6944":120529,"_42621":120501,"_30085":192841,"_5":21646,"_28538":192765,"_5847":192842},[],"**Icon** y **Tags**: clasificación opcional.",{"_6944":120530,"_42621":120501,"_30085":192844,"_5":21646,"_28538":192765,"_5847":192845},[],"Confirma el registro.",{"_6944":120531,"_42621":120501,"_30085":192847,"_5":21646,"_28538":192769,"_5847":192848},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_6944":120532,"_42621":120501,"_30085":192850,"_5":21646,"_28538":192769,"_5847":192851},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_6944":120533,"_42621":120501,"_30085":192853,"_5":21646,"_28538":192773,"_5847":192854},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_6944":120534,"_42621":120501,"_30085":192856,"_5":21646,"_28538":192773,"_5847":192857},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_6944":120535,"_42621":120501,"_30085":192859,"_5":21646,"_28538":192777,"_5847":192860},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_6944":120536,"_42621":120501,"_30085":192862,"_5":21646,"_28538":192777,"_5847":192863},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_6944":120537,"_42621":120501,"_30085":192865,"_5":21646,"_28538":192781,"_5847":192717},[],{"_6944":120538,"_42621":120501,"_30085":192867,"_5":21646,"_28538":192781,"_5847":192868},[],"Resultado",{"_6944":120539,"_42621":120501,"_30085":192870,"_5":21646,"_28538":192781,"_5847":191986},[],{"_6944":120540,"_42621":120501,"_30085":192872,"_5":21646,"_28538":192781,"_5847":192873},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_6944":120541,"_42621":120501,"_30085":192875,"_5":21646,"_28538":192781,"_5847":192876},[],"Identidad actual",{"_6944":120542,"_42621":120501,"_30085":192878,"_5":21646,"_28538":192781,"_5847":192879},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_6944":120543,"_42621":120501,"_30085":192881,"_5":21646,"_28538":192781,"_5847":192882},[],"Historial",{"_6944":120544,"_42621":120501,"_30085":192884,"_5":21646,"_28538":192781,"_5847":192885},[],"La emisión asociada aparece con su número de serie y fechas.",{"_6944":120545,"_42621":120501,"_30085":192887,"_5":21646,"_28538":192781,"_5847":192888},[],"Clave y certificado",{"_6944":120546,"_42621":120501,"_30085":192890,"_5":21646,"_28538":192781,"_5847":192891},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_6944":120547,"_42621":120501,"_30085":192893,"_5":21646,"_28538":192784,"_5847":192894},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_6944":120548,"_42621":120501,"_30085":192896,"_5":21646,"_28538":192784,"_5847":192897},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_6944":120549,"_42621":120501,"_30085":192899,"_5":21646,"_28538":192784,"_5847":192900},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_6944":120550,"_42621":120501,"_30085":192902,"_5":21646,"_28538":192784,"_5847":192903},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_6944":120551,"_42621":120501,"_30085":192905,"_5":21646,"_28538":192788,"_5847":192906},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_6944":120552,"_42621":120501,"_30085":192908,"_5":21646,"_28538":192788,"_5847":192909},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_6944":120553,"_42621":120501,"_30085":192911,"_5":21646,"_28538":192788,"_5847":192912},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_6944":120554,"_42621":120554,"_5":22076,"_5847":192914,"_43101":192915,"_30085":192916,"_28538":120554},"Plataforma Lamassu IoT",[78004,189200],[],{"_6944":120555,"_42621":120554,"_30085":192918,"_5":21646,"_28538":120554,"_5847":192919},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_6944":120556,"_42621":120554,"_5":43098,"_30085":192921,"_28538":192922,"_5847":192401},[],"/docs/pr-preview/pr-56/es/platform/overview#empieza-aquí",{"_6944":120557,"_42621":120554,"_5":43098,"_30085":192924,"_28538":192925,"_5847":192926},[],"/docs/pr-preview/pr-56/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_6944":120558,"_42621":120554,"_5":43098,"_30085":192928,"_28538":192929,"_5847":192930},[],"/docs/pr-preview/pr-56/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_6944":120559,"_42621":120554,"_5":43098,"_30085":192932,"_28538":192933,"_5847":192934},[],"/docs/pr-preview/pr-56/es/platform/overview#capacidades-principales","Capacidades principales",{"_6944":120560,"_42621":120554,"_5":43098,"_30085":192936,"_28538":192937,"_5847":192938},[],"/docs/pr-preview/pr-56/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_6944":120561,"_42621":120554,"_5":43098,"_30085":192940,"_28538":192941,"_5847":192942},[],"/docs/pr-preview/pr-56/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_6944":120562,"_42621":120554,"_5":43098,"_30085":192944,"_28538":192945,"_5847":192946},[],"/docs/pr-preview/pr-56/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_6944":120563,"_42621":120554,"_5":43098,"_30085":192948,"_28538":192949,"_5847":192950},[],"/docs/pr-preview/pr-56/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_6944":120564,"_42621":120554,"_5":43098,"_30085":192952,"_28538":192953,"_5847":192954},[],"/docs/pr-preview/pr-56/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_6944":120565,"_42621":120554,"_5":43098,"_30085":192956,"_28538":192957,"_5847":192958},[],"/docs/pr-preview/pr-56/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_6944":120566,"_42621":120554,"_5":43098,"_30085":192960,"_28538":192961,"_5847":192962},[],"/docs/pr-preview/pr-56/es/platform/overview#referencia-operativa","Referencia operativa",{"_6944":120567,"_42621":120554,"_30085":192964,"_5":21646,"_28538":120554,"_5847":192965},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_6944":120568,"_42621":120554,"_30085":192967,"_5":21646,"_28538":192922,"_5847":192968},[],"Elige el resultado que necesitas obtener:",{"_6944":120569,"_42621":120554,"_30085":192970,"_5":21646,"_28538":192922,"_5847":192971},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_6944":120570,"_42621":120554,"_30085":192973,"_5":21646,"_28538":192922,"_5847":192974},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_6944":120571,"_42621":120554,"_30085":192976,"_5":21646,"_28538":192922,"_5847":192977},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_6944":120572,"_42621":120554,"_30085":192979,"_5":21646,"_28538":192925,"_5847":192980},[],"Bloque",{"_6944":120573,"_42621":120554,"_30085":192982,"_5":21646,"_28538":192925,"_5847":192983},[],"Qué gestionas",{"_6944":120574,"_42621":120554,"_30085":192985,"_5":21646,"_28538":192925,"_5847":192986},[],"Punto de entrada",{"_6944":120575,"_42621":120554,"_30085":192988,"_5":21646,"_28538":192925,"_5847":83386},[],{"_6944":120576,"_42621":120554,"_30085":192990,"_5":21646,"_28538":192925,"_5847":192991},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_6944":120577,"_42621":120554,"_30085":192993,"_5":21646,"_28538":192925,"_5847":192994},[],"Visión general de PKI",{"_6944":120578,"_42621":120554,"_30085":192996,"_5":21646,"_28538":192925,"_5847":83395},[],{"_6944":120579,"_42621":120554,"_30085":192998,"_5":21646,"_28538":192925,"_5847":192999},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_6944":120580,"_42621":120554,"_30085":193001,"_5":21646,"_28538":192925,"_5847":193002},[],"Visión general de IoT Fleets",{"_6944":120581,"_42621":120554,"_30085":193004,"_5":21646,"_28538":192925,"_5847":193005},[],"**Administración**",{"_6944":120582,"_42621":120554,"_30085":193007,"_5":21646,"_28538":192925,"_5847":193008},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_6944":120583,"_42621":120554,"_30085":193010,"_5":21646,"_28538":192925,"_5847":189198},[],{"_6944":120584,"_42621":120554,"_30085":193012,"_5":21646,"_28538":192925,"_5847":193013},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_6944":120585,"_42621":120554,"_30085":193015,"_5":21646,"_28538":192929,"_5847":193016},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_6944":120586,"_42621":120554,"_30085":193018,"_5":21646,"_28538":192929,"_5847":193019},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_6944":120587,"_42621":120554,"_30085":193021,"_5":21646,"_28538":192929,"_5847":193022},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_6944":120588,"_42621":120554,"_30085":193024,"_5":21646,"_28538":192929,"_5847":193025},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_6944":120589,"_42621":120554,"_30085":193027,"_5":21646,"_28538":192929,"_5847":193028},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_6944":120590,"_42621":120554,"_30085":193030,"_5":21646,"_28538":192929,"_5847":193031},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_6944":120591,"_42621":120554,"_30085":193033,"_5":21646,"_28538":192937,"_5847":193034},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_6944":120592,"_42621":120554,"_30085":193036,"_5":21646,"_28538":192941,"_5847":193037},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_6944":120593,"_42621":120554,"_30085":193039,"_5":21646,"_28538":192945,"_5847":193040},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_6944":120594,"_42621":120554,"_30085":193042,"_5":21646,"_28538":192949,"_5847":193043},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_6944":120595,"_42621":120554,"_30085":193045,"_5":21646,"_28538":192953,"_5847":193046},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_6944":120596,"_42621":120554,"_30085":193048,"_5":21646,"_28538":192957,"_5847":193049},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_6944":120597,"_42621":120554,"_30085":193051,"_5":21646,"_28538":192961,"_5847":192507},[],{"_6944":120598,"_42621":120554,"_30085":193053,"_5":21646,"_28538":192961,"_5847":193054},[],"Qué prepara o comprueba",{"_6944":120599,"_42621":120554,"_30085":193056,"_5":21646,"_28538":192961,"_5847":192510},[],{"_6944":120600,"_42621":120554,"_30085":193058,"_5":21646,"_28538":192961,"_5847":193059},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_6944":120601,"_42621":120554,"_30085":193061,"_5":21646,"_28538":192961,"_5847":193062},[],"Administrador de la flota",{"_6944":120602,"_42621":120554,"_30085":193064,"_5":21646,"_28538":192961,"_5847":193065},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_6944":120603,"_42621":120554,"_30085":193067,"_5":21646,"_28538":192961,"_5847":192522},[],{"_6944":120604,"_42621":120554,"_30085":193069,"_5":21646,"_28538":192961,"_5847":193070},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_6944":120605,"_42621":120554,"_30085":193072,"_5":21646,"_28538":192961,"_5847":192528},[],{"_6944":120606,"_42621":120554,"_30085":193074,"_5":21646,"_28538":192961,"_5847":193075},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_6944":120607,"_42621":120554,"_30085":193077,"_5":21646,"_28538":192961,"_5847":193078},[],"Operador de infraestructura",{"_6944":120608,"_42621":120554,"_30085":193080,"_5":21646,"_28538":192961,"_5847":193081},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_6944":120609,"_42621":120554,"_30085":193083,"_5":21646,"_28538":192961,"_5847":193084},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_6944":120610,"_42621":120610,"_5":22076,"_5847":193086,"_43101":193087,"_30085":193089,"_28538":120610},"Jerarquía y rotación de CAs",[78004,189200,83487,193088],"Claves, autoridades y certificados",[],{"_6944":120611,"_42621":120610,"_30085":193091,"_5":21646,"_28538":120610,"_5847":193092},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_6944":120612,"_42621":120610,"_5":43098,"_30085":193094,"_28538":193095,"_5847":193096},[],"/docs/pr-preview/pr-56/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_6944":120613,"_42621":120610,"_5":43098,"_30085":193098,"_28538":193099,"_5847":193100},[],"/docs/pr-preview/pr-56/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_6944":120614,"_42621":120610,"_5":43098,"_30085":193102,"_28538":193103,"_5847":193104},[],"/docs/pr-preview/pr-56/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_6944":120615,"_42621":120610,"_5":43098,"_30085":193106,"_28538":193107,"_5847":193108},[],"/docs/pr-preview/pr-56/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_6944":120616,"_42621":120610,"_5":43098,"_30085":193110,"_28538":193111,"_5847":193112},[],"/docs/pr-preview/pr-56/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_6944":120617,"_42621":120610,"_5":43098,"_30085":193114,"_28538":193115,"_5847":193116},[],"/docs/pr-preview/pr-56/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_6944":120618,"_42621":120610,"_5":43098,"_30085":193118,"_28538":193119,"_5847":193120},[],"/docs/pr-preview/pr-56/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_6944":120619,"_42621":120610,"_5":43098,"_30085":193122,"_28538":193123,"_5847":193124},[],"/docs/pr-preview/pr-56/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_6944":120620,"_42621":120610,"_5":43098,"_30085":193126,"_28538":193127,"_5847":193128},[],"/docs/pr-preview/pr-56/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_6944":120621,"_42621":120610,"_5":43098,"_30085":193130,"_28538":193131,"_5847":193132},[],"/docs/pr-preview/pr-56/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_6944":120622,"_42621":120610,"_5":43098,"_30085":193134,"_28538":193135,"_5847":193136},[],"/docs/pr-preview/pr-56/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_6944":120623,"_42621":120610,"_5":43098,"_30085":193138,"_28538":193139,"_5847":193140},[],"/docs/pr-preview/pr-56/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_6944":120624,"_42621":120610,"_30085":193142,"_5":21646,"_28538":120610,"_5847":193143},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_6944":120625,"_42621":120610,"_30085":193145,"_5":21646,"_28538":120610,"_5847":193146},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_6944":120626,"_42621":120610,"_30085":193148,"_5":21646,"_28538":193095,"_5847":193149},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_6944":120627,"_42621":120610,"_30085":193151,"_5":21646,"_28538":193095,"_5847":193152},[],"entorno, como producción y preproducción;",{"_6944":120628,"_42621":120610,"_30085":193154,"_5":21646,"_28538":193095,"_5847":193155},[],"propietario o equipo operador;",{"_6944":120629,"_42621":120610,"_30085":193157,"_5":21646,"_28538":193095,"_5847":193158},[],"familia de dispositivos o proceso de fabricación;",{"_6944":120630,"_42621":120610,"_30085":193160,"_5":21646,"_28538":193095,"_5847":193161},[],"región o requisito regulatorio;",{"_6944":120631,"_42621":120610,"_30085":193163,"_5":21646,"_28538":193095,"_5847":193164},[],"motor criptográfico o política de clave;",{"_6944":120632,"_42621":120610,"_30085":193166,"_5":21646,"_28538":193095,"_5847":193167},[],"ventana de mantenimiento y ritmo de renovación.",{"_6944":120633,"_42621":120610,"_30085":193169,"_5":21646,"_28538":193095,"_5847":193170},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_6944":120634,"_42621":120610,"_30085":193172,"_5":21646,"_28538":193095,"_5847":193173},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_6944":120635,"_42621":120610,"_30085":193175,"_5":21646,"_28538":193099,"_5847":193176},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_6944":120636,"_42621":120610,"_30085":193178,"_5":21646,"_28538":193099,"_5847":193179},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_6944":120637,"_42621":120610,"_30085":193181,"_5":21646,"_28538":193099,"_5847":193182},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_6944":120638,"_42621":120610,"_30085":193184,"_5":21646,"_28538":193103,"_5847":193185},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_6944":120639,"_42621":120610,"_30085":193187,"_5":21646,"_28538":193103,"_5847":193188},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_6944":120640,"_42621":120610,"_30085":193190,"_5":21646,"_28538":193103,"_5847":193191},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_6944":120641,"_42621":120610,"_30085":193193,"_5":21646,"_28538":193103,"_5847":193194},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_6944":120642,"_42621":120610,"_30085":193196,"_5":21646,"_28538":193111,"_5847":193197},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_6944":120643,"_42621":120610,"_30085":193199,"_5":21646,"_28538":193115,"_5847":193200},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_6944":120644,"_42621":120610,"_30085":193202,"_5":21646,"_28538":193119,"_5847":193203},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_6944":120645,"_42621":120610,"_30085":193205,"_5":21646,"_28538":193123,"_5847":193206},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_6944":120646,"_42621":120610,"_30085":193208,"_5":21646,"_28538":193127,"_5847":193209},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_6944":120647,"_42621":120610,"_30085":193211,"_5":21646,"_28538":193131,"_5847":193212},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_6944":120648,"_42621":120610,"_30085":193214,"_5":21646,"_28538":193135,"_5847":193215},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_6944":120649,"_42621":120610,"_30085":193217,"_5":21646,"_28538":193135,"_5847":193218},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_6944":120650,"_42621":120610,"_30085":193220,"_5":21646,"_28538":193135,"_5847":193221},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_6944":120651,"_42621":120610,"_30085":193223,"_5":21646,"_28538":193135,"_5847":193224},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_6944":120652,"_42621":120610,"_30085":193226,"_5":21646,"_28538":193139,"_5847":193227},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_6944":120653,"_42621":120610,"_30085":193229,"_5":21646,"_28538":193139,"_5847":193230},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_6944":120654,"_42621":120610,"_30085":193232,"_5":21646,"_28538":193139,"_5847":193233},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_6944":120655,"_42621":120610,"_30085":193235,"_5":21646,"_28538":193139,"_5847":193236},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_6944":120656,"_42621":120610,"_30085":193238,"_5":21646,"_28538":193139,"_5847":193239},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_6944":120657,"_42621":120610,"_30085":193241,"_5":21646,"_28538":193139,"_5847":193242},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_6944":120658,"_42621":120610,"_30085":193244,"_5":21646,"_28538":193139,"_5847":193245},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_6944":120659,"_42621":120659,"_5":22076,"_5847":193247,"_43101":193248,"_30085":193249,"_28538":120659},"Autoridades de certificación",[78004,189200,83487,193088],[],{"_6944":120660,"_42621":120659,"_30085":193251,"_5":21646,"_28538":120659,"_5847":193252},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_6944":120661,"_42621":120659,"_5":43098,"_30085":193254,"_28538":193255,"_5847":193256},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_6944":120662,"_42621":120659,"_5":43098,"_30085":193258,"_28538":193259,"_5847":193260},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_6944":120663,"_42621":120659,"_5":43098,"_30085":193262,"_28538":193263,"_5847":187778},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#antes-de-empezar",{"_6944":120664,"_42621":120659,"_5":43098,"_30085":193265,"_28538":193266,"_5847":193267},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_6944":120665,"_42621":120659,"_5":43098,"_30085":193269,"_28538":193270,"_5847":193271},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_6944":120666,"_42621":120659,"_5":43098,"_30085":193273,"_28538":193274,"_5847":193275},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_6944":120667,"_42621":120659,"_5":43098,"_30085":193277,"_28538":193278,"_5847":193279},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_6944":120668,"_42621":120659,"_5":43098,"_30085":193281,"_28538":193282,"_5847":193283},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_6944":120669,"_42621":120659,"_5":43098,"_30085":193285,"_28538":193286,"_5847":193287},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_6944":120670,"_42621":120659,"_5":43098,"_30085":193289,"_28538":193290,"_5847":193291},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_6944":120671,"_42621":120659,"_5":43098,"_30085":193293,"_28538":193294,"_5847":193295},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_6944":120672,"_42621":120659,"_5":43098,"_30085":193297,"_28538":193298,"_5847":193299},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_6944":120673,"_42621":120659,"_5":43098,"_30085":193301,"_28538":193302,"_5847":193303},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_6944":120674,"_42621":120659,"_5":43098,"_30085":193305,"_28538":193306,"_5847":193307},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_6944":120675,"_42621":120659,"_5":43098,"_30085":193309,"_28538":193310,"_5847":193311},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_6944":120676,"_42621":120659,"_5":43098,"_30085":193313,"_28538":193314,"_5847":193315},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_6944":120677,"_42621":120659,"_5":43098,"_30085":193317,"_28538":193318,"_5847":193319},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_6944":120678,"_42621":120659,"_5":43098,"_30085":193321,"_28538":193322,"_5847":193323},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_6944":120679,"_42621":120659,"_5":43098,"_30085":193325,"_28538":193326,"_5847":193327},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_6944":120680,"_42621":120659,"_5":43098,"_30085":193329,"_28538":193330,"_5847":193331},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_6944":120681,"_42621":120659,"_5":43098,"_30085":193333,"_28538":193334,"_5847":193335},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_6944":120682,"_42621":120659,"_5":43098,"_30085":193337,"_28538":193338,"_5847":193339},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_6944":120683,"_42621":120659,"_5":43098,"_30085":193341,"_28538":193342,"_5847":193343},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_6944":120684,"_42621":120659,"_30085":193345,"_5":21646,"_28538":120659,"_5847":193346},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_6944":120685,"_42621":120659,"_30085":193348,"_5":21646,"_28538":120659,"_5847":193349},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_6944":120686,"_42621":120659,"_30085":193351,"_5":21646,"_28538":120659,"_5847":193352},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_6944":120687,"_42621":120659,"_30085":193354,"_5":21646,"_28538":193255,"_5847":193355},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_6944":120688,"_42621":120659,"_30085":193357,"_5":21646,"_28538":193255,"_5847":193358},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_6944":120689,"_42621":120659,"_30085":193360,"_5":21646,"_28538":193255,"_5847":193361},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_6944":120690,"_42621":120659,"_30085":193363,"_5":21646,"_28538":193255,"_5847":193364},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_6944":120691,"_42621":120659,"_30085":193366,"_5":21646,"_28538":193255,"_5847":193367},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_6944":120692,"_42621":120659,"_30085":193369,"_5":21646,"_28538":193263,"_5847":193370},[],"Decide si la CA será raíz o intermedia.",{"_6944":120693,"_42621":120659,"_30085":193372,"_5":21646,"_28538":193263,"_5847":193373},[],"Elige el motor que custodiará la clave.",{"_6944":120694,"_42621":120659,"_30085":193375,"_5":21646,"_28538":193263,"_5847":193376},[],"Define una validez superior a la de los certificados que emitirá.",{"_6944":120695,"_42621":120659,"_30085":193378,"_5":21646,"_28538":193263,"_5847":193379},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_6944":120696,"_42621":120659,"_30085":193381,"_5":21646,"_28538":193266,"_5847":193382},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_6944":120697,"_42621":120659,"_30085":193384,"_5":21646,"_28538":193270,"_5847":193385},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_6944":120698,"_42621":120659,"_30085":193387,"_5":21646,"_28538":193270,"_5847":193388},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_6944":120699,"_42621":120659,"_30085":193390,"_5":21646,"_28538":193274,"_5847":193391},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_6944":120700,"_42621":120659,"_30085":193393,"_5":21646,"_28538":193278,"_5847":193394},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_6944":120701,"_42621":120659,"_30085":193396,"_5":21646,"_28538":193278,"_5847":193397},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_6944":120702,"_42621":120659,"_30085":193399,"_5":21646,"_28538":193278,"_5847":193400},[],"`ST`: estado o provincia.",{"_6944":120703,"_42621":120659,"_30085":193402,"_5":21646,"_28538":193278,"_5847":193403},[],"`L`: localidad.",{"_6944":120704,"_42621":120659,"_30085":193405,"_5":21646,"_28538":193278,"_5847":193406},[],"`O`: organización.",{"_6944":120705,"_42621":120659,"_30085":193408,"_5":21646,"_28538":193278,"_5847":193409},[],"`OU`: unidad organizativa.",{"_6944":120706,"_42621":120659,"_30085":193411,"_5":21646,"_28538":193278,"_5847":193412},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_6944":120707,"_42621":120659,"_30085":193414,"_5":21646,"_28538":193282,"_5847":193415},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_6944":120708,"_42621":120659,"_30085":193417,"_5":21646,"_28538":193282,"_5847":193418},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_6944":120709,"_42621":120659,"_30085":193420,"_5":21646,"_28538":193286,"_5847":193421},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_6944":120710,"_42621":120659,"_30085":193423,"_5":21646,"_28538":193286,"_5847":193424},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_6944":120711,"_42621":120659,"_30085":193426,"_5":21646,"_28538":193290,"_5847":193427},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_6944":120712,"_42621":120659,"_30085":193429,"_5":21646,"_28538":193290,"_5847":193430},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_6944":120713,"_42621":120659,"_30085":193432,"_5":21646,"_28538":193294,"_5847":193433},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_6944":120714,"_42621":120659,"_30085":193435,"_5":21646,"_28538":193294,"_5847":193436},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_6944":120715,"_42621":120659,"_30085":193438,"_5":21646,"_28538":193294,"_5847":193439},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_6944":120716,"_42621":120659,"_30085":193441,"_5":21646,"_28538":193298,"_5847":193442},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_6944":120717,"_42621":120659,"_30085":193444,"_5":21646,"_28538":193302,"_5847":193445},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_6944":120718,"_42621":120659,"_30085":193447,"_5":21646,"_28538":193306,"_5847":193448},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_6944":120719,"_42621":120659,"_30085":193450,"_5":21646,"_28538":193310,"_5847":193451},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_6944":120720,"_42621":120659,"_30085":193453,"_5":21646,"_28538":193310,"_5847":193454},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_6944":120721,"_42621":120659,"_30085":193456,"_5":21646,"_28538":193314,"_5847":193457},[],"Abre una CA desde el inventario para consultar:",{"_6944":120722,"_42621":120659,"_30085":193459,"_5":21646,"_28538":193314,"_5847":193460},[],"Estado y periodo de validez.",{"_6944":120723,"_42621":120659,"_30085":193462,"_5":21646,"_28538":193314,"_5847":193463},[],"Certificado y cadena en formato PEM.",{"_6944":120724,"_42621":120659,"_30085":193465,"_5":21646,"_28538":193314,"_5847":193466},[],"Número de certificados activos, expirados y revocados.",{"_6944":120725,"_42621":120659,"_30085":193468,"_5":21646,"_28538":193314,"_5847":193469},[],"Certificados emitidos en **Issued Certificates**.",{"_6944":120726,"_42621":120659,"_30085":193471,"_5":21646,"_28538":193314,"_5847":193472},[],"CRL vinculada a la autoridad.",{"_6944":120727,"_42621":120659,"_30085":193474,"_5":21646,"_28538":193314,"_5847":193475},[],"Metadatos y motor criptográfico asociado.",{"_6944":120728,"_42621":120659,"_30085":193477,"_5":21646,"_28538":193314,"_5847":193478},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_6944":120729,"_42621":120659,"_30085":193480,"_5":21646,"_28538":193318,"_5847":193481},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_6944":120730,"_42621":120659,"_30085":193483,"_5":21646,"_28538":193318,"_5847":193484},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_6944":120731,"_42621":120659,"_30085":193486,"_5":21646,"_28538":193318,"_5847":193487},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_6944":120732,"_42621":120659,"_30085":193489,"_5":21646,"_28538":193318,"_5847":193490},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_6944":120733,"_42621":120659,"_30085":193492,"_5":21646,"_28538":193322,"_5847":193493},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_6944":120734,"_42621":120659,"_30085":193495,"_5":21646,"_28538":193326,"_5847":193496},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_6944":120735,"_42621":120659,"_30085":193498,"_5":21646,"_28538":193330,"_5847":193499},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_6944":120736,"_42621":120659,"_30085":193501,"_5":21646,"_28538":193334,"_5847":193502},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_6944":120737,"_42621":120659,"_30085":193504,"_5":21646,"_28538":193338,"_5847":193505},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_6944":120738,"_42621":120659,"_30085":193507,"_5":21646,"_28538":193342,"_5847":193508},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_6944":120739,"_42621":120659,"_30085":193510,"_5":21646,"_28538":193342,"_5847":193511},[],"El rol VA de la CA se conserva. Si no queda otra CA con el mismo SKI, deja de ser editable (consulta CRL), así que ajusta antes su validez y su firmante. La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_6944":120740,"_42621":120659,"_30085":193513,"_5":21646,"_28538":193342,"_5847":193514},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. Si el certificado nuevo usa la misma clave, comparte el SKI con el rol VA retenido de la CA eliminada, cuyo firmante es el certificado antiguo: comprueba que la CRL se genera y, si no es así, asigna con `PUT` un firmante de la CA nueva (consulta CRL).",{"_6944":120741,"_42621":120741,"_5":22076,"_5847":193516,"_43101":193517,"_30085":193518,"_28538":120741},"Perfiles de certificado",[78004,189200,83487,193088],[],{"_6944":120742,"_42621":120741,"_30085":193520,"_5":21646,"_28538":120741,"_5847":193521},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_6944":120743,"_42621":120741,"_5":43098,"_30085":193523,"_28538":193524,"_5847":193525},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_6944":120744,"_42621":120741,"_5":43098,"_30085":193527,"_28538":193528,"_5847":193529},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#validez","Validez",{"_6944":120745,"_42621":120741,"_5":43098,"_30085":193531,"_28538":193532,"_5847":193533},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_6944":120746,"_42621":120741,"_5":43098,"_30085":193535,"_28538":193536,"_5847":193537},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_6944":120747,"_42621":120741,"_5":43098,"_30085":193539,"_28538":193540,"_5847":193541},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_6944":120748,"_42621":120741,"_5":43098,"_30085":193543,"_28538":193544,"_5847":193545},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_6944":120749,"_42621":120741,"_5":43098,"_30085":193547,"_28538":193548,"_5847":193549},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_6944":120750,"_42621":120741,"_5":43098,"_30085":193551,"_28538":193552,"_5847":193553},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_6944":120751,"_42621":120741,"_5":43098,"_30085":193555,"_28538":193556,"_5847":193557},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_6944":120752,"_42621":120741,"_5":43098,"_30085":193559,"_28538":193560,"_5847":193561},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_6944":120753,"_42621":120741,"_5":43098,"_30085":193563,"_28538":193564,"_5847":193565},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_6944":120754,"_42621":120741,"_5":43098,"_30085":193567,"_28538":193568,"_5847":193569},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_6944":120755,"_42621":120741,"_5":43098,"_30085":193571,"_28538":193572,"_5847":193573},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_6944":120756,"_42621":120741,"_5":43098,"_30085":193575,"_28538":193576,"_5847":193577},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_6944":120757,"_42621":120741,"_5":43098,"_30085":193579,"_28538":193580,"_5847":193581},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_6944":120758,"_42621":120741,"_5":43098,"_30085":193583,"_28538":193584,"_5847":193585},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_6944":120759,"_42621":120741,"_30085":193587,"_5":21646,"_28538":120741,"_5847":193588},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_6944":120760,"_42621":120741,"_30085":193590,"_5":21646,"_28538":120741,"_5847":193591},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_6944":120761,"_42621":120741,"_30085":193593,"_5":21646,"_28538":193528,"_5847":193594},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_6944":120762,"_42621":120741,"_30085":193596,"_5":21646,"_28538":193528,"_5847":193597},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_6944":120763,"_42621":120741,"_30085":193599,"_5":21646,"_28538":193532,"_5847":193600},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_6944":120764,"_42621":120741,"_30085":193602,"_5":21646,"_28538":193536,"_5847":193603},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_6944":120765,"_42621":120741,"_30085":193605,"_5":21646,"_28538":193536,"_5847":193606},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_6944":120766,"_42621":120741,"_30085":193608,"_5":21646,"_28538":193536,"_5847":193609},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_6944":120767,"_42621":120741,"_30085":193611,"_5":21646,"_28538":193540,"_5847":193612},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_6944":120768,"_42621":120741,"_30085":193614,"_5":21646,"_28538":193544,"_5847":193615},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_6944":120769,"_42621":120741,"_30085":193617,"_5":21646,"_28538":193544,"_5847":193618},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_6944":120770,"_42621":120741,"_30085":193620,"_5":21646,"_28538":193548,"_5847":193621},[],"La aplicación criptográfica puede:",{"_6944":120771,"_42621":120741,"_30085":193623,"_5":21646,"_28538":193548,"_5847":193624},[],"permitir o bloquear claves RSA;",{"_6944":120772,"_42621":120741,"_30085":193626,"_5":21646,"_28538":193548,"_5847":193627},[],"limitar los tamaños RSA admitidos;",{"_6944":120773,"_42621":120741,"_30085":193629,"_5":21646,"_28538":193548,"_5847":193630},[],"permitir o bloquear claves ECDSA;",{"_6944":120774,"_42621":120741,"_30085":193632,"_5":21646,"_28538":193548,"_5847":193633},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_6944":120775,"_42621":120741,"_30085":193635,"_5":21646,"_28538":193548,"_5847":193636},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_6944":120776,"_42621":120741,"_30085":193638,"_5":21646,"_28538":193552,"_5847":193639},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_6944":120777,"_42621":120741,"_30085":193641,"_5":21646,"_28538":193552,"_5847":188960},[],{"_6944":120778,"_42621":120741,"_30085":193643,"_5":21646,"_28538":193552,"_5847":193644},[],"Primera opción",{"_6944":120779,"_42621":120741,"_30085":193646,"_5":21646,"_28538":193552,"_5847":193647},[],"Segunda opción",{"_6944":120780,"_42621":120741,"_30085":193649,"_5":21646,"_28538":193552,"_5847":193650},[],"Si no hay ninguna",{"_6944":120781,"_42621":120741,"_30085":193652,"_5":21646,"_28538":193552,"_5847":193653},[],"Firma directa con una CA",{"_6944":120782,"_42621":120741,"_30085":193655,"_5":21646,"_28538":193552,"_5847":193656},[],"`issuance_profile` incluido en la solicitud",{"_6944":120783,"_42621":120741,"_30085":193658,"_5":21646,"_28538":193552,"_5847":193659},[],"`issuance_profile_id` de la solicitud",{"_6944":120784,"_42621":120741,"_30085":193661,"_5":21646,"_28538":193552,"_5847":193662},[],"Perfil predeterminado de la CA (`profile_id`).",{"_6944":120785,"_42621":120741,"_30085":193664,"_5":21646,"_28538":193552,"_5847":193665},[],"Emisión mediante DMS",{"_6944":120786,"_42621":120741,"_30085":193667,"_5":21646,"_28538":193552,"_5847":84068},[],{"_6944":120787,"_42621":120741,"_30085":193669,"_5":21646,"_28538":193552,"_5847":193670},[],"`settings.issuance_profile` incluido en el DMS",{"_6944":120788,"_42621":120741,"_30085":193672,"_5":21646,"_28538":193552,"_5847":193673},[],"Perfil predeterminado de la CA de enrolamiento.",{"_6944":120789,"_42621":120741,"_30085":193675,"_5":21646,"_28538":193552,"_5847":193676},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_6944":120790,"_42621":120741,"_30085":193678,"_5":21646,"_28538":193552,"_5847":193679},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_6944":120791,"_42621":120741,"_30085":193681,"_5":21646,"_28538":193560,"_5847":193682},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_6944":120792,"_42621":120741,"_30085":193684,"_5":21646,"_28538":193564,"_5847":193685},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_6944":120793,"_42621":120741,"_30085":193687,"_5":21646,"_28538":193568,"_5847":193688},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_6944":120794,"_42621":120741,"_30085":193690,"_5":21646,"_28538":193572,"_5847":193691},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_6944":120795,"_42621":120741,"_30085":193693,"_5":21646,"_28538":193576,"_5847":193694},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_6944":120796,"_42621":120741,"_30085":193696,"_5":21646,"_28538":193576,"_5847":193697},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_6944":120797,"_42621":120741,"_30085":193699,"_5":21646,"_28538":193580,"_5847":193700},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_6944":120798,"_42621":120741,"_30085":193702,"_5":21646,"_28538":193580,"_5847":193703},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_6944":120799,"_42621":120741,"_30085":193705,"_5":21646,"_28538":193580,"_5847":193706},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_6944":120800,"_42621":120741,"_30085":193708,"_5":21646,"_28538":193580,"_5847":193709},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_6944":120801,"_42621":120741,"_30085":193711,"_5":21646,"_28538":193584,"_5847":193712},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_6944":120802,"_42621":120741,"_30085":193714,"_5":21646,"_28538":193584,"_5847":193715},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_6944":120803,"_42621":120803,"_5":22076,"_5847":193717,"_43101":193718,"_30085":193720,"_28538":120803},"Validación de certificados",[78004,189200,83487,193719],"Validación",[],{"_6944":120804,"_42621":120803,"_30085":193722,"_5":21646,"_28538":120803,"_5847":193723},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_6944":120805,"_42621":120803,"_5":43098,"_30085":193725,"_28538":193726,"_5847":193727},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_6944":120806,"_42621":120803,"_5":43098,"_30085":193729,"_28538":193730,"_5847":193731},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_6944":120807,"_42621":120803,"_5":43098,"_30085":193733,"_28538":193734,"_5847":193735},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_6944":120808,"_42621":120803,"_30085":193737,"_5":21646,"_28538":120803,"_5847":193738},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_6944":120809,"_42621":120803,"_30085":193740,"_5":21646,"_28538":193726,"_5847":193741},[],"Verifica estos criterios juntos:",{"_6944":120810,"_42621":120803,"_30085":193743,"_5":21646,"_28538":193726,"_5847":192717},[],{"_6944":120811,"_42621":120803,"_30085":193745,"_5":21646,"_28538":193726,"_5847":193746},[],"Resultado necesario",{"_6944":120812,"_42621":120803,"_30085":193748,"_5":21646,"_28538":193726,"_5847":193749},[],"Cadena y firma",{"_6944":120813,"_42621":120803,"_30085":193751,"_5":21646,"_28538":193726,"_5847":193752},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_6944":120814,"_42621":120803,"_30085":193754,"_5":21646,"_28538":193726,"_5847":193755},[],"Fechas",{"_6944":120815,"_42621":120803,"_30085":193757,"_5":21646,"_28538":193726,"_5847":193758},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_6944":120816,"_42621":120803,"_30085":193760,"_5":21646,"_28538":193726,"_5847":188870},[],{"_6944":120817,"_42621":120803,"_30085":193762,"_5":21646,"_28538":193726,"_5847":193763},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_6944":120818,"_42621":120803,"_30085":193765,"_5":21646,"_28538":193726,"_5847":193766},[],"Uso",{"_6944":120819,"_42621":120803,"_30085":193768,"_5":21646,"_28538":193726,"_5847":193769},[],"KU, EKU y restricciones permiten la operación concreta.",{"_6944":120820,"_42621":120803,"_30085":193771,"_5":21646,"_28538":193726,"_5847":193772},[],"Revocación",{"_6944":120821,"_42621":120803,"_30085":193774,"_5":21646,"_28538":193726,"_5847":193775},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_6944":120822,"_42621":120803,"_30085":193777,"_5":21646,"_28538":193726,"_5847":193778},[],"Autorización",{"_6944":120823,"_42621":120803,"_30085":193780,"_5":21646,"_28538":193726,"_5847":193781},[],"La aplicación permite la acción a esa identidad.",{"_6944":120824,"_42621":120803,"_30085":193783,"_5":21646,"_28538":193726,"_5847":193784},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_6944":120825,"_42621":120803,"_30085":193786,"_5":21646,"_28538":193730,"_5847":193787},[],"Mecanismo",{"_6944":120826,"_42621":120803,"_30085":193789,"_5":21646,"_28538":193730,"_5847":193790},[],"Cuándo utilizarlo",{"_6944":120827,"_42621":120803,"_30085":193792,"_5":21646,"_28538":193730,"_5847":193793},[],"Qué debes mantener",{"_6944":120828,"_42621":120803,"_30085":193795,"_5":21646,"_28538":193730,"_5847":84196},[],{"_6944":120829,"_42621":120803,"_30085":193797,"_5":21646,"_28538":193730,"_5847":193798},[],"Consulta del estado de un certificado concreto.",{"_6944":120830,"_42621":120803,"_30085":193800,"_5":21646,"_28538":193730,"_5847":193801},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_6944":120831,"_42621":120803,"_30085":193803,"_5":21646,"_28538":193730,"_5847":84205},[],{"_6944":120832,"_42621":120803,"_30085":193805,"_5":21646,"_28538":193730,"_5847":193806},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_6944":120833,"_42621":120803,"_30085":193808,"_5":21646,"_28538":193730,"_5847":193809},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_6944":120834,"_42621":120803,"_30085":193811,"_5":21646,"_28538":193730,"_5847":193812},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_6944":120835,"_42621":120803,"_30085":193814,"_5":21646,"_28538":193730,"_5847":193815},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_6944":120836,"_42621":120803,"_30085":193817,"_5":21646,"_28538":193734,"_5847":193818},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_6944":120837,"_42621":120803,"_30085":193820,"_5":21646,"_28538":193734,"_5847":193821},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_6944":120838,"_42621":120803,"_30085":193823,"_5":21646,"_28538":193734,"_5847":193824},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_6944":120839,"_42621":120803,"_30085":193826,"_5":21646,"_28538":193734,"_5847":193827},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_6944":120840,"_42621":120803,"_30085":193829,"_5":21646,"_28538":193734,"_5847":193830},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_6944":120841,"_42621":120803,"_30085":193832,"_5":21646,"_28538":193734,"_5847":193833},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_6944":120842,"_42621":120803,"_30085":193835,"_5":21646,"_28538":193734,"_5847":193836},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_6944":120843,"_42621":120803,"_30085":193838,"_5":21646,"_28538":193734,"_5847":193839},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_6944":120844,"_42621":120803,"_30085":193841,"_5":21646,"_28538":193734,"_5847":193842},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_6944":120845,"_42621":120845,"_5":22076,"_5847":193844,"_43101":193845,"_30085":193846,"_28538":120845},"Certificados",[78004,189200,83487,193088],[],{"_6944":120846,"_42621":120845,"_30085":193848,"_5":21646,"_28538":120845,"_5847":193849},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_6944":120847,"_42621":120845,"_5":43098,"_30085":193851,"_28538":193852,"_5847":193853},[],"/docs/pr-preview/pr-56/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_6944":120848,"_42621":120845,"_5":43098,"_30085":193855,"_28538":193856,"_5847":193857},[],"/docs/pr-preview/pr-56/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_6944":120849,"_42621":120845,"_5":43098,"_30085":193859,"_28538":193860,"_5847":193861},[],"/docs/pr-preview/pr-56/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_6944":120850,"_42621":120845,"_5":43098,"_30085":193863,"_28538":193864,"_5847":193865},[],"/docs/pr-preview/pr-56/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_6944":120851,"_42621":120845,"_5":43098,"_30085":193867,"_28538":193868,"_5847":193869},[],"/docs/pr-preview/pr-56/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_6944":120852,"_42621":120845,"_5":43098,"_30085":193871,"_28538":193872,"_5847":193873},[],"/docs/pr-preview/pr-56/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_6944":120853,"_42621":120845,"_5":43098,"_30085":193875,"_28538":193876,"_5847":193877},[],"/docs/pr-preview/pr-56/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_6944":120854,"_42621":120845,"_5":43098,"_30085":193879,"_28538":193880,"_5847":193881},[],"/docs/pr-preview/pr-56/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_6944":120855,"_42621":120845,"_5":43098,"_30085":193883,"_28538":193884,"_5847":193885},[],"/docs/pr-preview/pr-56/es/platform/pki/certificates#continúa","Continúa",{"_6944":120856,"_42621":120845,"_30085":193887,"_5":21646,"_28538":120845,"_5847":193888},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_6944":120857,"_42621":120845,"_30085":193890,"_5":21646,"_28538":193852,"_5847":193891},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos. Los detalles del certificado incluyen la referencia a la clave (`key_id`) y si la clave privada está gestionada (`has_private_key`), y las listas de certificados pueden filtrarse por `has_private_key`.",{"_6944":120858,"_42621":120845,"_30085":193893,"_5":21646,"_28538":193852,"_5847":193894},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_6944":120859,"_42621":120845,"_30085":193896,"_5":21646,"_28538":193856,"_5847":193897},[],"Descarga el PEM e inspecciónalo:",{"_6944":120860,"_42621":120845,"_30085":193899,"_5":21646,"_28538":193856,"_5847":193900},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_6944":120861,"_42621":120845,"_30085":193902,"_5":21646,"_28538":193860,"_5847":193903},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_6944":120862,"_42621":120845,"_30085":193905,"_5":21646,"_28538":193860,"_5847":193906},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_6944":120863,"_42621":120845,"_30085":193908,"_5":21646,"_28538":193860,"_5847":193909},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_6944":120864,"_42621":120845,"_30085":193911,"_5":21646,"_28538":193860,"_5847":193912},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_6944":120865,"_42621":120845,"_30085":193914,"_5":21646,"_28538":193860,"_5847":193915},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_6944":120866,"_42621":120845,"_30085":193917,"_5":21646,"_28538":193860,"_5847":193918},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_6944":120867,"_42621":120845,"_30085":193920,"_5":21646,"_28538":193860,"_5847":193921},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_6944":120868,"_42621":120845,"_30085":193923,"_5":21646,"_28538":193864,"_5847":193924},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_6944":120869,"_42621":120845,"_30085":193926,"_5":21646,"_28538":193868,"_5847":193927},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_6944":120870,"_42621":120845,"_30085":193929,"_5":21646,"_28538":193872,"_5847":193930},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_6944":120871,"_42621":120845,"_30085":193932,"_5":21646,"_28538":193876,"_5847":193933},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_6944":120872,"_42621":120845,"_30085":193935,"_5":21646,"_28538":193876,"_5847":193936},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_6944":120873,"_42621":120845,"_30085":193938,"_5":21646,"_28538":193876,"_5847":193939},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_6944":120874,"_42621":120845,"_30085":193941,"_5":21646,"_28538":193880,"_5847":193942},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_6944":120875,"_42621":120845,"_30085":193944,"_5":21646,"_28538":193880,"_5847":193945},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_6944":120876,"_42621":120845,"_30085":193947,"_5":21646,"_28538":193880,"_5847":193948},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_6944":120877,"_42621":120845,"_30085":193950,"_5":21646,"_28538":193884,"_5847":193951},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_6944":120878,"_42621":120845,"_30085":193953,"_5":21646,"_28538":193884,"_5847":193954},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_6944":120879,"_42621":120879,"_5":22076,"_5847":193956,"_43101":193957,"_30085":193959,"_28538":120879},"Ciclo de vida de un certificado",[78004,189200,83487,193958],"Conceptos",[],{"_6944":120880,"_42621":120879,"_30085":193961,"_5":21646,"_28538":120879,"_5847":193962},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_6944":120881,"_42621":120879,"_5":43098,"_30085":193964,"_28538":193965,"_5847":193966},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_6944":120882,"_42621":120879,"_5":43098,"_30085":193968,"_28538":193969,"_5847":193970},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_6944":120883,"_42621":120879,"_5":43098,"_30085":193972,"_28538":193973,"_5847":193974},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_6944":120884,"_42621":120879,"_5":43098,"_30085":193976,"_28538":193977,"_5847":193978},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_6944":120885,"_42621":120879,"_5":43098,"_30085":193980,"_28538":193981,"_5847":193982},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_6944":120886,"_42621":120879,"_5":43098,"_30085":193984,"_28538":193985,"_5847":193986},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_6944":120887,"_42621":120879,"_5":43098,"_30085":193988,"_28538":193989,"_5847":191698},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_6944":120888,"_42621":120879,"_5":43098,"_30085":193991,"_28538":193992,"_5847":193993},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_6944":120889,"_42621":120879,"_5":43098,"_30085":193995,"_28538":193996,"_5847":193997},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_6944":120890,"_42621":120879,"_5":43098,"_30085":193999,"_28538":194000,"_5847":194001},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_6944":120891,"_42621":120879,"_30085":194003,"_5":21646,"_28538":120879,"_5847":194004},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_6944":120892,"_42621":120879,"_30085":194006,"_5":21646,"_28538":193969,"_5847":194007},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_6944":120893,"_42621":120879,"_30085":194009,"_5":21646,"_28538":193973,"_5847":194010},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_6944":120894,"_42621":120879,"_30085":194012,"_5":21646,"_28538":193977,"_5847":194013},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_6944":120895,"_42621":120879,"_30085":194015,"_5":21646,"_28538":193981,"_5847":194016},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_6944":120896,"_42621":120879,"_30085":194018,"_5":21646,"_28538":193985,"_5847":194019},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_6944":120897,"_42621":120879,"_30085":194021,"_5":21646,"_28538":193989,"_5847":194022},[],"Lamassu persiste cuatro estados X.509:",{"_6944":120898,"_42621":120879,"_30085":194024,"_5":21646,"_28538":193989,"_5847":194025},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_6944":120899,"_42621":120879,"_30085":194027,"_5":21646,"_28538":193989,"_5847":194028},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_6944":120900,"_42621":120879,"_30085":194030,"_5":21646,"_28538":193989,"_5847":194031},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_6944":120901,"_42621":120879,"_30085":194033,"_5":21646,"_28538":193989,"_5847":194034},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_6944":120902,"_42621":120879,"_30085":194036,"_5":21646,"_28538":193989,"_5847":194037},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_6944":120903,"_42621":120879,"_30085":194039,"_5":21646,"_28538":193992,"_5847":194040},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_6944":120904,"_42621":120879,"_30085":194042,"_5":21646,"_28538":193992,"_5847":194043},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_6944":120905,"_42621":120879,"_30085":194045,"_5":21646,"_28538":193992,"_5847":194046},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_6944":120906,"_42621":120879,"_30085":194048,"_5":21646,"_28538":193996,"_5847":194049},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_6944":120907,"_42621":120879,"_30085":194051,"_5":21646,"_28538":193996,"_5847":194052},[],"Antes de confirmar:",{"_6944":120908,"_42621":120879,"_30085":194054,"_5":21646,"_28538":193996,"_5847":194055},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_6944":120909,"_42621":120879,"_30085":194057,"_5":21646,"_28538":193996,"_5847":194058},[],"Distribuye la nueva cadena de confianza.",{"_6944":120910,"_42621":120879,"_30085":194060,"_5":21646,"_28538":193996,"_5847":194061},[],"Reemite las identidades necesarias.",{"_6944":120911,"_42621":120879,"_30085":194063,"_5":21646,"_28538":193996,"_5847":194064},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_6944":120912,"_42621":120879,"_30085":194066,"_5":21646,"_28538":193996,"_5847":194067},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_6944":120913,"_42621":120879,"_30085":194069,"_5":21646,"_28538":193996,"_5847":194070},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_6944":120914,"_42621":120879,"_30085":194072,"_5":21646,"_28538":194000,"_5847":194073},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_6944":120915,"_42621":120879,"_30085":194075,"_5":21646,"_28538":194000,"_5847":194076},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_6944":120916,"_42621":120879,"_30085":194078,"_5":21646,"_28538":194000,"_5847":194079},[],"Cambios de estado y razones de revocación.",{"_6944":120917,"_42621":120879,"_30085":194081,"_5":21646,"_28538":194000,"_5847":194082},[],"Publicación y vigencia de OCSP y CRLs.",{"_6944":120918,"_42621":120879,"_30085":194084,"_5":21646,"_28538":194000,"_5847":194085},[],"Dependencias que todavía presentan un certificado sustituido.",{"_6944":120919,"_42621":120879,"_30085":194087,"_5":21646,"_28538":194000,"_5847":194088},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_6944":120920,"_42621":120920,"_5":22076,"_5847":194090,"_43101":194091,"_30085":194092,"_28538":120920},"Modelo de confianza",[78004,189200,83487,193958],[],{"_6944":120921,"_42621":120920,"_30085":194094,"_5":21646,"_28538":120920,"_5847":194095},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_6944":120922,"_42621":120920,"_5":43098,"_30085":194097,"_28538":194098,"_5847":194099},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_6944":120923,"_42621":120920,"_5":43098,"_30085":194101,"_28538":194102,"_5847":194103},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_6944":120924,"_42621":120920,"_5":43098,"_30085":194105,"_28538":194106,"_5847":194107},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_6944":120925,"_42621":120920,"_5":43098,"_30085":194109,"_28538":194110,"_5847":194111},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_6944":120926,"_42621":120920,"_5":43098,"_30085":194113,"_28538":194114,"_5847":194115},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_6944":120927,"_42621":120920,"_5":43098,"_30085":194117,"_28538":194118,"_5847":194119},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_6944":120928,"_42621":120920,"_5":43098,"_30085":194121,"_28538":194122,"_5847":194123},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_6944":120929,"_42621":120920,"_5":43098,"_30085":194125,"_28538":194126,"_5847":194127},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_6944":120930,"_42621":120920,"_5":43098,"_30085":194129,"_28538":194130,"_5847":194131},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_6944":120931,"_42621":120920,"_5":43098,"_30085":194133,"_28538":194134,"_5847":194135},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_6944":120932,"_42621":120920,"_30085":194137,"_5":21646,"_28538":120920,"_5847":194138},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_6944":120933,"_42621":120920,"_30085":194140,"_5":21646,"_28538":194102,"_5847":194141},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_6944":120934,"_42621":120920,"_30085":194143,"_5":21646,"_28538":194106,"_5847":194144},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_6944":120935,"_42621":120920,"_30085":194146,"_5":21646,"_28538":194110,"_5847":194147},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_6944":120936,"_42621":120920,"_30085":194149,"_5":21646,"_28538":194114,"_5847":194150},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_6944":120937,"_42621":120920,"_30085":194152,"_5":21646,"_28538":194118,"_5847":194153},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_6944":120938,"_42621":120920,"_30085":194155,"_5":21646,"_28538":194118,"_5847":194156},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_6944":120939,"_42621":120920,"_30085":194158,"_5":21646,"_28538":194118,"_5847":194159},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_6944":120940,"_42621":120920,"_30085":194161,"_5":21646,"_28538":194118,"_5847":194162},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_6944":120941,"_42621":120920,"_30085":194164,"_5":21646,"_28538":194118,"_5847":194165},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_6944":120942,"_42621":120920,"_30085":194167,"_5":21646,"_28538":194118,"_5847":194168},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_6944":120943,"_42621":120920,"_30085":194170,"_5":21646,"_28538":194122,"_5847":194171},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_6944":120944,"_42621":120920,"_30085":194173,"_5":21646,"_28538":194122,"_5847":194174},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_6944":120945,"_42621":120920,"_30085":194176,"_5":21646,"_28538":194122,"_5847":194177},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_6944":120946,"_42621":120920,"_30085":194179,"_5":21646,"_28538":194122,"_5847":194180},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_6944":120947,"_42621":120920,"_30085":194182,"_5":21646,"_28538":194122,"_5847":194183},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_6944":120948,"_42621":120920,"_30085":194185,"_5":21646,"_28538":194126,"_5847":194186},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_6944":120949,"_42621":120920,"_30085":194188,"_5":21646,"_28538":194126,"_5847":194189},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_6944":120950,"_42621":120920,"_30085":194191,"_5":21646,"_28538":194126,"_5847":194192},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_6944":120951,"_42621":120920,"_30085":194194,"_5":21646,"_28538":194126,"_5847":194195},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_6944":120952,"_42621":120920,"_30085":194197,"_5":21646,"_28538":194126,"_5847":194198},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_6944":120953,"_42621":120920,"_30085":194200,"_5":21646,"_28538":194126,"_5847":194201},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_6944":120954,"_42621":120920,"_30085":194203,"_5":21646,"_28538":194126,"_5847":194204},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_6944":120955,"_42621":120920,"_30085":194206,"_5":21646,"_28538":194130,"_5847":194207},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_6944":120956,"_42621":120920,"_30085":194209,"_5":21646,"_28538":194134,"_5847":194210},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_6944":120957,"_42621":120920,"_30085":194212,"_5":21646,"_28538":194134,"_5847":194213},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_6944":120958,"_42621":120920,"_30085":194215,"_5":21646,"_28538":194134,"_5847":194216},[],"Asigna perfiles explícitos a cada caso de uso.",{"_6944":120959,"_42621":120920,"_30085":194218,"_5":21646,"_28538":194134,"_5847":194219},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_6944":120960,"_42621":120920,"_30085":194221,"_5":21646,"_28538":194134,"_5847":194222},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_6944":120961,"_42621":120920,"_30085":194224,"_5":21646,"_28538":194134,"_5847":194225},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_6944":120962,"_42621":120920,"_30085":194227,"_5":21646,"_28538":194134,"_5847":194228},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_6944":120963,"_42621":120963,"_5":22076,"_5847":194230,"_43101":194231,"_30085":194232,"_28538":120963},"Listas de revocación (CRL)",[78004,189200,83487,193719],[],{"_6944":120964,"_42621":120963,"_30085":194234,"_5":21646,"_28538":120963,"_5847":194235},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_6944":120965,"_42621":120963,"_5":43098,"_30085":194237,"_28538":194238,"_5847":194239},[],"/docs/pr-preview/pr-56/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_6944":120966,"_42621":120963,"_5":43098,"_30085":194241,"_28538":194242,"_5847":194243},[],"/docs/pr-preview/pr-56/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_6944":120967,"_42621":120963,"_5":43098,"_30085":194245,"_28538":194246,"_5847":194247},[],"/docs/pr-preview/pr-56/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_6944":120968,"_42621":120963,"_5":43098,"_30085":194249,"_28538":194250,"_5847":194251},[],"/docs/pr-preview/pr-56/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_6944":120969,"_42621":120963,"_5":43098,"_30085":194253,"_28538":194254,"_5847":194255},[],"/docs/pr-preview/pr-56/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_6944":120970,"_42621":120963,"_5":43098,"_30085":194257,"_28538":194258,"_5847":194259},[],"/docs/pr-preview/pr-56/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_6944":120971,"_42621":120963,"_5":43098,"_30085":194261,"_28538":194262,"_5847":194263},[],"/docs/pr-preview/pr-56/es/platform/pki/crl#errores-frecuentes-del-rol-va","Errores frecuentes del rol VA",{"_6944":120972,"_42621":120963,"_5":43098,"_30085":194265,"_28538":194266,"_5847":194267},[],"/docs/pr-preview/pr-56/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_6944":120973,"_42621":120963,"_5":43098,"_30085":194269,"_28538":194270,"_5847":194271},[],"/docs/pr-preview/pr-56/es/platform/pki/crl#referencias","Referencias",{"_6944":120974,"_42621":120963,"_30085":194273,"_5":21646,"_28538":120963,"_5847":194274},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_6944":120975,"_42621":120963,"_30085":194276,"_5":21646,"_28538":194238,"_5847":194277},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_6944":120976,"_42621":120963,"_30085":194279,"_5":21646,"_28538":194238,"_5847":194280},[],"Campo de `crl_options`",{"_6944":120977,"_42621":120963,"_30085":194282,"_5":21646,"_28538":194238,"_5847":190738},[],{"_6944":120978,"_42621":120963,"_30085":194284,"_5":21646,"_28538":194238,"_5847":194285},[],"Valor inicial del backend",{"_6944":120979,"_42621":120963,"_30085":194287,"_5":21646,"_28538":194238,"_5847":84691},[],{"_6944":120980,"_42621":120963,"_30085":194289,"_5":21646,"_28538":194238,"_5847":194290},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_6944":120981,"_42621":120963,"_30085":194292,"_5":21646,"_28538":194238,"_5847":194293},[],"7 días.",{"_6944":120982,"_42621":120963,"_30085":194295,"_5":21646,"_28538":194238,"_5847":84700},[],{"_6944":120983,"_42621":120963,"_30085":194297,"_5":21646,"_28538":194238,"_5847":194298},[],"Se guarda y se devuelve por la API, pero la VA no lo utiliza: la renovación programada no depende de él (consulta Regeneración periódica y automática).",{"_6944":120984,"_42621":120963,"_30085":194300,"_5":21646,"_28538":194238,"_5847":194301},[],"6 días y 23 horas.",{"_6944":120985,"_42621":120963,"_30085":194303,"_5":21646,"_28538":194238,"_5847":84709},[],{"_6944":120986,"_42621":120963,"_30085":194305,"_5":21646,"_28538":194238,"_5847":194306},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_6944":120987,"_42621":120963,"_30085":194308,"_5":21646,"_28538":194238,"_5847":84715},[],{"_6944":120988,"_42621":120963,"_30085":194310,"_5":21646,"_28538":194238,"_5847":84718},[],{"_6944":120989,"_42621":120963,"_30085":194312,"_5":21646,"_28538":194238,"_5847":194313},[],"Número de serie del certificado existente que firma la CRL.",{"_6944":120990,"_42621":120963,"_30085":194315,"_5":21646,"_28538":194238,"_5847":194316},[],"Número de serie del certificado actual de la CA.",{"_6944":120991,"_42621":120963,"_30085":194318,"_5":21646,"_28538":194238,"_5847":194319},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_6944":120992,"_42621":120963,"_30085":194321,"_5":21646,"_28538":194238,"_5847":194322},[],"Al reemitir una CA, el rol sigue apuntando al certificado anterior. Las CRL siguen siendo válidas porque ambos certificados comparten sujeto y clave, pero el certificado anterior no puede eliminarse mientras el rol lo use. Para retirarlo, actualiza el firmante del rol.",{"_6944":120993,"_42621":120963,"_30085":194324,"_5":21646,"_28538":194238,"_5847":194325},[],"Al eliminar una CA, su rol VA se conserva y no puede borrarse por API. Si no queda ninguna otra CA con el mismo SKI, el rol puede consultarse pero cualquier `PUT` devuelve 404, y el trabajo de renovación registra un aviso en cada ciclo porque ya no encuentra la CA. La API no ofrece salida; solo se corrige editando la base de datos. Si queda otra CA con ese SKI, el rol sigue siendo editable (consulta CAs que comparten clave). Ajusta validez y firmante antes de eliminar la CA.",{"_6944":120994,"_42621":120963,"_30085":194327,"_5":21646,"_28538":194238,"_5847":194328},[],"Una CA cuyo certificado no tiene `cRLSign` no puede generar su CRL ni editar su rol (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y asígnalo como firmante con `PUT`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original.",{"_6944":120995,"_42621":120963,"_30085":194330,"_5":21646,"_28538":194238,"_5847":194331},[],"El `PUT` valida siempre el firmante, aunque la petición no lo cambie. Si el firmante guardado ya no es válido, no se puede modificar ningún campo del rol, ni siquiera la validez, hasta asignar uno válido.",{"_6944":120996,"_42621":120963,"_30085":194333,"_5":21646,"_28538":194238,"_5847":194334},[],"Compartir una clave entre CA puede impedir la validación de las CRL. Consulta CAs que comparten clave.",{"_6944":120997,"_42621":120963,"_30085":194336,"_5":21646,"_28538":194238,"_5847":194337},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_6944":120998,"_42621":120963,"_30085":194339,"_5":21646,"_28538":194242,"_5847":194340},[],"La VA identifica cada CRL por el SKI de la CA, y el SKI se deriva de su clave. Dos CAs con la misma clave tienen el mismo SKI y comparten un único rol VA y una única CRL. Ocurre al crear una CA sobre una clave ya existente del KMS, o al importar una CA cuyo certificado declara un SKI en uso. Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. El rol lo crea la primera CA y las demás lo conservan.",{"_6944":120999,"_42621":120963,"_30085":194342,"_5":21646,"_28538":194242,"_5847":194343},[],"Los certificados de todas ellas apuntan a `/crl/{ski}`, pero la lista publicada tiene como emisor a la primera CA y solo incluye sus revocaciones. Un verificador compara el emisor de la CRL con el del certificado que valida (RFC 5280, §6.3.2) y rechaza la lista si no coinciden. Según su política, el certificado queda bloqueado (*hard-fail*) o se acepta aunque esté revocado (*soft-fail*). Las revocaciones de las CAs secundarias no aparecen en ninguna lista.",{"_6944":121000,"_42621":120963,"_30085":194345,"_5":21646,"_28538":194242,"_5847":194346},[],"Si la primera CA se elimina, la generación de CRL de la restante falla porque el firmante configurado ya no corresponde a una CA con ese nombre. Hasta que se actualice el firmante del rol a un certificado de la CA restante, se sigue sirviendo la última lista publicada hasta que venza (7 días por defecto).",{"_6944":121001,"_42621":120963,"_30085":194348,"_5":21646,"_28538":194242,"_5847":194349},[],"Antes de actualizar, revisa las CAs que comparten clave. Para detectar el problema, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos. Una CA importada con un SKI ya en uso no sustituye a la existente como emisora de la CRL, porque el emisor se resuelve a partir del firmante del rol. Sin embargo, sus propios certificados apuntan a esa misma URL y sus revocaciones no se publican. Hasta que Lamassu rechace estas importaciones, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión, así que tampoco reutilices claves entre CAs. Una CRL por CA y el rechazo de importaciones cuyo SKI colisiona con el de una CA existente están planteados en lamassuiot#834, y ninguno está implementado todavía.",{"_6944":121002,"_42621":120963,"_30085":194351,"_5":21646,"_28538":194246,"_5847":194352},[],"El trabajo programado de la VA revisa todos los roles en cada ejecución y solicita otra lista cuando a `latest_crl` le queda menos validez que el intervalo entre ejecuciones. La frecuencia se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. `refresh_interval` no interviene. Mantén `validity` claramente por encima del intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_6944":121003,"_42621":120963,"_30085":194354,"_5":21646,"_28538":194246,"_5847":194355},[],"Si la generación falla (por ejemplo, por un rol sin CA o un firmante inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ski>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_6944":121004,"_42621":120963,"_30085":194357,"_5":21646,"_28538":194246,"_5847":194358},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla (rol inexistente, firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_6944":121005,"_42621":120963,"_30085":194360,"_5":21646,"_28538":194246,"_5847":194361},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_6944":121006,"_42621":120963,"_30085":194363,"_5":21646,"_28538":194250,"_5847":194364},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_6944":121007,"_42621":120963,"_30085":194366,"_5":21646,"_28538":194250,"_5847":194367},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_6944":121008,"_42621":120963,"_30085":194369,"_5":21646,"_28538":194254,"_5847":194370},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_6944":121009,"_42621":120963,"_30085":194372,"_5":21646,"_28538":194254,"_5847":194373},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_6944":121010,"_42621":120963,"_30085":194375,"_5":21646,"_28538":194254,"_5847":194376},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_6944":121011,"_42621":120963,"_30085":194378,"_5":21646,"_28538":194254,"_5847":194379},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_6944":121012,"_42621":120963,"_30085":194381,"_5":21646,"_28538":194254,"_5847":194382},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_6944":121013,"_42621":120963,"_30085":194384,"_5":21646,"_28538":194258,"_5847":194385},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_6944":121014,"_42621":120963,"_30085":194387,"_5":21646,"_28538":194258,"_5847":190927},[],{"_6944":121015,"_42621":120963,"_30085":194389,"_5":21646,"_28538":194258,"_5847":194390},[],"Path relativo",{"_6944":121016,"_42621":120963,"_30085":194392,"_5":21646,"_28538":194258,"_5847":188960},[],{"_6944":121017,"_42621":120963,"_30085":194394,"_5":21646,"_28538":194258,"_5847":84803},[],{"_6944":121018,"_42621":120963,"_30085":194396,"_5":21646,"_28538":194258,"_5847":84806},[],{"_6944":121019,"_42621":120963,"_30085":194398,"_5":21646,"_28538":194258,"_5847":194399},[],"Consultar `crl_options` y `latest_crl`.",{"_6944":121020,"_42621":120963,"_30085":194401,"_5":21646,"_28538":194258,"_5847":84812},[],{"_6944":121021,"_42621":120963,"_30085":194403,"_5":21646,"_28538":194258,"_5847":84806},[],{"_6944":121022,"_42621":120963,"_30085":194405,"_5":21646,"_28538":194258,"_5847":194406},[],"Sustituir la configuración de CRL.",{"_6944":121023,"_42621":120963,"_30085":194408,"_5":21646,"_28538":194258,"_5847":194409},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_6944":121024,"_42621":120963,"_30085":194411,"_5":21646,"_28538":194258,"_5847":194412},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_6944":121025,"_42621":120963,"_30085":194414,"_5":21646,"_28538":194262,"_5847":194415},[],"Síntoma",{"_6944":121026,"_42621":120963,"_30085":194417,"_5":21646,"_28538":194262,"_5847":194418},[],"Causa",{"_6944":121027,"_42621":120963,"_30085":194420,"_5":21646,"_28538":194262,"_5847":194421},[],"Acción",{"_6944":121028,"_42621":120963,"_30085":194423,"_5":21646,"_28538":194262,"_5847":194424},[],"`PUT /v1/roles/{ca-ski}` devuelve 404 y `GET` devuelve 200.",{"_6944":121029,"_42621":120963,"_30085":194426,"_5":21646,"_28538":194262,"_5847":194427},[],"Se eliminó la CA del rol y no queda otra con el mismo SKI.",{"_6944":121030,"_42621":120963,"_30085":194429,"_5":21646,"_28538":194262,"_5847":194430},[],"No hay salida por API; requiere intervención en la base de datos. Evítalo ajustando el rol antes de eliminar la CA.",{"_6944":121031,"_42621":120963,"_30085":194432,"_5":21646,"_28538":194262,"_5847":194433},[],"`PUT` devuelve 400.",{"_6944":121032,"_42621":120963,"_30085":194435,"_5":21646,"_28538":194262,"_5847":194436},[],"El firmante no tiene `cRLSign`, o su sujeto y su clave no coinciden con ninguna CA de ese SKI (por ejemplo, tras eliminar la primera de dos CAs que comparten clave).",{"_6944":121033,"_42621":120963,"_30085":194438,"_5":21646,"_28538":194262,"_5847":194439},[],"Asigna con `PUT` el número de serie de un certificado válido de la CA restante.",{"_6944":121034,"_42621":120963,"_30085":194441,"_5":21646,"_28538":194262,"_5847":194442},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_6944":121035,"_42621":120963,"_30085":194444,"_5":21646,"_28538":194262,"_5847":194445},[],"`crl_options.subject_key_id_signer` se sustituyó por `signer_certificate_serial_number`, que es obligatorio.",{"_6944":121036,"_42621":120963,"_30085":194447,"_5":21646,"_28538":194262,"_5847":194448},[],"Actualiza el cliente para enviar el campo nuevo.",{"_6944":121037,"_42621":120963,"_30085":194450,"_5":21646,"_28538":194262,"_5847":194451},[],"La CRL no cambia tras revocar un certificado.",{"_6944":121038,"_42621":120963,"_30085":194453,"_5":21646,"_28538":194262,"_5847":194454},[],"`regenerate_on_revoke` es `false`, o el evento falló por falta de rol o por un firmante inválido.",{"_6944":121039,"_42621":120963,"_30085":194456,"_5":21646,"_28538":194262,"_5847":194457},[],"Revisa los logs de la VA y la cola de eventos fallidos; corrige el firmante.",{"_6944":121040,"_42621":120963,"_30085":194459,"_5":21646,"_28538":194262,"_5847":194460},[],"Un verificador rechaza la CRL por el emisor.",{"_6944":121041,"_42621":120963,"_30085":194462,"_5":21646,"_28538":194262,"_5847":194463},[],"Varias CAs comparten SKI.",{"_6944":121042,"_42621":120963,"_30085":194465,"_5":21646,"_28538":194262,"_5847":194466},[],"Consulta CAs que comparten clave.",{"_6944":121043,"_42621":120963,"_30085":194468,"_5":21646,"_28538":194266,"_5847":194469},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_6944":121044,"_42621":120963,"_30085":194471,"_5":21646,"_28538":194270,"_5847":194472},[],"RFC 5280: perfil X.509 y CRL.",{"_6944":121045,"_42621":120963,"_30085":194474,"_5":21646,"_28538":194270,"_5847":84886},[],{"_6944":121046,"_42621":120963,"_30085":194476,"_5":21646,"_28538":194270,"_5847":84889},[],{"_6944":121047,"_42621":120963,"_30085":194478,"_5":21646,"_28538":194270,"_5847":194479},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_6944":121048,"_42621":120963,"_30085":194481,"_5":21646,"_28538":194270,"_5847":194482},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_6944":121049,"_42621":121049,"_5":22076,"_5847":194484,"_43101":194485,"_30085":194486,"_28538":121049},"Claves y motores criptográficos",[78004,189200,83487,193088],[],{"_6944":121050,"_42621":121049,"_30085":194488,"_5":21646,"_28538":121049,"_5847":194489},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_6944":121051,"_42621":121049,"_5":43098,"_30085":194491,"_28538":194492,"_5847":194493},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_6944":121052,"_42621":121049,"_5":43098,"_30085":194495,"_28538":194496,"_5847":194497},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_6944":121053,"_42621":121049,"_5":43098,"_30085":194499,"_28538":194500,"_5847":84914},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#file-system",{"_6944":121054,"_42621":121049,"_5":43098,"_30085":194502,"_28538":194503,"_5847":84918},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#hashicorp-vault",{"_6944":121055,"_42621":121049,"_5":43098,"_30085":194505,"_28538":194506,"_5847":84922},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#aws-secrets-manager",{"_6944":121056,"_42621":121049,"_5":43098,"_30085":194508,"_28538":194509,"_5847":84926},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#aws-kms",{"_6944":121057,"_42621":121049,"_5":43098,"_30085":194511,"_28538":194512,"_5847":84930},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#pkcs11",{"_6944":121058,"_42621":121049,"_5":43098,"_30085":194514,"_28538":194515,"_5847":84934},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#azure-key-vault",{"_6944":121059,"_42621":121049,"_5":43098,"_30085":194517,"_28538":194518,"_5847":194519},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_6944":121060,"_42621":121049,"_5":43098,"_30085":194521,"_28538":194522,"_5847":194523},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_6944":121061,"_42621":121049,"_5":43098,"_30085":194525,"_28538":194526,"_5847":194527},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_6944":121062,"_42621":121049,"_5":43098,"_30085":194529,"_28538":194530,"_5847":194531},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_6944":121063,"_42621":121049,"_5":43098,"_30085":194533,"_28538":194534,"_5847":194535},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_6944":121064,"_42621":121049,"_5":43098,"_30085":194537,"_28538":194538,"_5847":194539},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_6944":121065,"_42621":121049,"_5":43098,"_30085":194541,"_28538":194542,"_5847":194543},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_6944":121066,"_42621":121049,"_5":43098,"_30085":194545,"_28538":194546,"_5847":84966},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#sign",{"_6944":121067,"_42621":121049,"_5":43098,"_30085":194548,"_28538":194549,"_5847":84970},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#verify",{"_6944":121068,"_42621":121049,"_5":43098,"_30085":194551,"_28538":194552,"_5847":194553},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_6944":121069,"_42621":121049,"_5":43098,"_30085":194555,"_28538":194556,"_5847":194557},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_6944":121070,"_42621":121049,"_5":43098,"_30085":194559,"_28538":194560,"_5847":194561},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_6944":121071,"_42621":121049,"_30085":194563,"_5":21646,"_28538":121049,"_5847":194564},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_6944":121072,"_42621":121049,"_30085":194566,"_5":21646,"_28538":121049,"_5847":194567},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_6944":121073,"_42621":121049,"_30085":194569,"_5":21646,"_28538":194492,"_5847":194570},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_6944":121074,"_42621":121049,"_30085":194572,"_5":21646,"_28538":194492,"_5847":194573},[],"En la práctica, permite:",{"_6944":121075,"_42621":121049,"_30085":194575,"_5":21646,"_28538":194492,"_5847":194576},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_6944":121076,"_42621":121049,"_30085":194578,"_5":21646,"_28538":194492,"_5847":194579},[],"Importar claves creadas externamente.",{"_6944":121077,"_42621":121049,"_30085":194581,"_5":21646,"_28538":194492,"_5847":194582},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_6944":121078,"_42621":121049,"_30085":194584,"_5":21646,"_28538":194492,"_5847":194585},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_6944":121079,"_42621":121049,"_30085":194587,"_5":21646,"_28538":194496,"_5847":194588},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_6944":121080,"_42621":121049,"_30085":194590,"_5":21646,"_28538":194496,"_5847":194591},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_6944":121081,"_42621":121049,"_30085":194593,"_5":21646,"_28538":194496,"_5847":194594},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_6944":121082,"_42621":121049,"_30085":194596,"_5":21646,"_28538":194500,"_5847":194597},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_6944":121083,"_42621":121049,"_30085":194599,"_5":21646,"_28538":194503,"_5847":194600},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_6944":121084,"_42621":121049,"_30085":194602,"_5":21646,"_28538":194503,"_5847":194603},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_6944":121085,"_42621":121049,"_30085":194605,"_5":21646,"_28538":194506,"_5847":194606},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_6944":121086,"_42621":121049,"_30085":194608,"_5":21646,"_28538":194509,"_5847":194609},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_6944":121087,"_42621":121049,"_30085":194611,"_5":21646,"_28538":194512,"_5847":194612},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_6944":121088,"_42621":121049,"_30085":194614,"_5":21646,"_28538":194515,"_5847":194615},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_6944":121089,"_42621":121049,"_30085":194617,"_5":21646,"_28538":194515,"_5847":194618},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_6944":121090,"_42621":121049,"_30085":194620,"_5":21646,"_28538":194515,"_5847":194621},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_6944":121091,"_42621":121049,"_30085":194623,"_5":21646,"_28538":194515,"_5847":194624},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_6944":121092,"_42621":121049,"_30085":194626,"_5":21646,"_28538":194518,"_5847":194627},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_6944":121093,"_42621":121049,"_30085":194629,"_5":21646,"_28538":194518,"_5847":194630},[],"La tabla incluye los siguientes campos:",{"_6944":121094,"_42621":121049,"_30085":194632,"_5":21646,"_28538":194518,"_5847":194633},[],"**Name**: nombre descriptivo de la clave.",{"_6944":121095,"_42621":121049,"_30085":194635,"_5":21646,"_28538":194518,"_5847":194636},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_6944":121096,"_42621":121049,"_30085":194638,"_5":21646,"_28538":194518,"_5847":194639},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_6944":121097,"_42621":121049,"_30085":194641,"_5":21646,"_28538":194518,"_5847":194642},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_6944":121098,"_42621":121049,"_30085":194644,"_5":21646,"_28538":194518,"_5847":194645},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_6944":121099,"_42621":121049,"_30085":194647,"_5":21646,"_28538":194518,"_5847":194648},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_6944":121100,"_42621":121049,"_30085":194650,"_5":21646,"_28538":194518,"_5847":194651},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_6944":121101,"_42621":121049,"_30085":194653,"_5":21646,"_28538":194518,"_5847":194654},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_6944":121102,"_42621":121049,"_30085":194656,"_5":21646,"_28538":194518,"_5847":194657},[],"Desde esta vista también se accede a las acciones más habituales:",{"_6944":121103,"_42621":121049,"_30085":194659,"_5":21646,"_28538":194518,"_5847":194660},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_6944":121104,"_42621":121049,"_30085":194662,"_5":21646,"_28538":194518,"_5847":194663},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_6944":121105,"_42621":121049,"_30085":194665,"_5":21646,"_28538":194518,"_5847":194666},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_6944":121106,"_42621":121049,"_30085":194668,"_5":21646,"_28538":194518,"_5847":194669},[],"**Delete Key** para eliminar la clave del sistema.",{"_6944":121107,"_42621":121049,"_30085":194671,"_5":21646,"_28538":194522,"_5847":194672},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_6944":121108,"_42621":121049,"_30085":194674,"_5":21646,"_28538":194526,"_5847":194675},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_6944":121109,"_42621":121049,"_30085":194677,"_5":21646,"_28538":194526,"_5847":194678},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_6944":121110,"_42621":121049,"_30085":194680,"_5":21646,"_28538":194526,"_5847":194681},[],"**Key Name**: nombre único y descriptivo.",{"_6944":121111,"_42621":121049,"_30085":194683,"_5":21646,"_28538":194526,"_5847":194684},[],"**Crypto Engine**: motor que custodiará la clave.",{"_6944":121112,"_42621":121049,"_30085":194686,"_5":21646,"_28538":194526,"_5847":194687},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_6944":121113,"_42621":121049,"_30085":194689,"_5":21646,"_28538":194526,"_5847":194690},[],"**Tags**: metadatos para clasificar la clave.",{"_6944":121114,"_42621":121049,"_30085":194692,"_5":21646,"_28538":194526,"_5847":194693},[],"**Metadata**: información adicional para usos avanzados.",{"_6944":121115,"_42621":121049,"_30085":194695,"_5":21646,"_28538":194530,"_5847":194696},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_6944":121116,"_42621":121049,"_30085":194698,"_5":21646,"_28538":194530,"_5847":194699},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_6944":121117,"_42621":121049,"_30085":194701,"_5":21646,"_28538":194530,"_5847":194702},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_6944":121118,"_42621":121049,"_30085":194704,"_5":21646,"_28538":194530,"_5847":194705},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_6944":121119,"_42621":121049,"_30085":194707,"_5":21646,"_28538":194530,"_5847":194708},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_6944":121120,"_42621":121049,"_30085":194710,"_5":21646,"_28538":194530,"_5847":194711},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_6944":121121,"_42621":121049,"_30085":194713,"_5":21646,"_28538":194530,"_5847":194714},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_6944":121122,"_42621":121049,"_30085":194716,"_5":21646,"_28538":194530,"_5847":194717},[],"**Tags**: etiquetas para organización y búsqueda.",{"_6944":121123,"_42621":121049,"_30085":194719,"_5":21646,"_28538":194530,"_5847":194720},[],"**Metadata**: información adicional opcional.",{"_6944":121124,"_42621":121049,"_30085":194722,"_5":21646,"_28538":194530,"_5847":194723},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_6944":121125,"_42621":121049,"_30085":194725,"_5":21646,"_28538":194530,"_5847":194726},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_6944":121126,"_42621":121049,"_30085":194728,"_5":21646,"_28538":194534,"_5847":194729},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_6944":121127,"_42621":121049,"_30085":194731,"_5":21646,"_28538":194538,"_5847":194732},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_6944":121128,"_42621":121049,"_30085":194734,"_5":21646,"_28538":194538,"_5847":194735},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_6944":121129,"_42621":121049,"_30085":194737,"_5":21646,"_28538":194538,"_5847":194738},[],"**Key Name**: nombre descriptivo.",{"_6944":121130,"_42621":121049,"_30085":194740,"_5":21646,"_28538":194538,"_5847":194741},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_6944":121131,"_42621":121049,"_30085":194743,"_5":21646,"_28538":194538,"_5847":194744},[],"**Tags**: etiquetas asociadas.",{"_6944":121132,"_42621":121049,"_30085":194746,"_5":21646,"_28538":194538,"_5847":194747},[],"**Aliases**: nombres alternativos.",{"_6944":121133,"_42621":121049,"_30085":194749,"_5":21646,"_28538":194538,"_5847":194750},[],"**Crypto Engine**: motor en el que reside la clave.",{"_6944":121134,"_42621":121049,"_30085":194752,"_5":21646,"_28538":194538,"_5847":194753},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_6944":121135,"_42621":121049,"_30085":194755,"_5":21646,"_28538":194538,"_5847":194756},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_6944":121136,"_42621":121049,"_30085":194758,"_5":21646,"_28538":194538,"_5847":194759},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_6944":121137,"_42621":121049,"_30085":194761,"_5":21646,"_28538":194542,"_5847":194762},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_6944":121138,"_42621":121049,"_30085":194764,"_5":21646,"_28538":194542,"_5847":194765},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_6944":121139,"_42621":121049,"_30085":194767,"_5":21646,"_28538":194542,"_5847":194768},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_6944":121140,"_42621":121049,"_30085":194770,"_5":21646,"_28538":194546,"_5847":194771},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_6944":121141,"_42621":121049,"_30085":194773,"_5":21646,"_28538":194546,"_5847":194774},[],"Campos principales:",{"_6944":121142,"_42621":121049,"_30085":194776,"_5":21646,"_28538":194546,"_5847":194777},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_6944":121143,"_42621":121049,"_30085":194779,"_5":21646,"_28538":194546,"_5847":194780},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_6944":121144,"_42621":121049,"_30085":194782,"_5":21646,"_28538":194546,"_5847":194783},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_6944":121145,"_42621":121049,"_30085":194785,"_5":21646,"_28538":194546,"_5847":194786},[],"**Message**: contenido que se va a firmar.",{"_6944":121146,"_42621":121049,"_30085":194788,"_5":21646,"_28538":194546,"_5847":194789},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_6944":121147,"_42621":121049,"_30085":194791,"_5":21646,"_28538":194549,"_5847":194792},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_6944":121148,"_42621":121049,"_30085":194794,"_5":21646,"_28538":194549,"_5847":194774},[],{"_6944":121149,"_42621":121049,"_30085":194796,"_5":21646,"_28538":194549,"_5847":194797},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_6944":121150,"_42621":121049,"_30085":194799,"_5":21646,"_28538":194549,"_5847":194800},[],"**Message Type**: `Raw` o `Digest`.",{"_6944":121151,"_42621":121049,"_30085":194802,"_5":21646,"_28538":194549,"_5847":194803},[],"**Payload Encoding**: codificación del mensaje.",{"_6944":121152,"_42621":121049,"_30085":194805,"_5":21646,"_28538":194549,"_5847":194806},[],"**Message**: mensaje original o hash.",{"_6944":121153,"_42621":121049,"_30085":194808,"_5":21646,"_28538":194549,"_5847":194809},[],"**Signature**: firma que se desea comprobar.",{"_6944":121154,"_42621":121049,"_30085":194811,"_5":21646,"_28538":194549,"_5847":194812},[],"**Result**: indicador del resultado de la validación.",{"_6944":121155,"_42621":121049,"_30085":194814,"_5":21646,"_28538":194552,"_5847":194815},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_6944":121156,"_42621":121049,"_30085":194817,"_5":21646,"_28538":194552,"_5847":194818},[],"Este flujo es útil para:",{"_6944":121157,"_42621":121049,"_30085":194820,"_5":21646,"_28538":194552,"_5847":194821},[],"Solicitar certificados a una CA externa.",{"_6944":121158,"_42621":121049,"_30085":194823,"_5":21646,"_28538":194552,"_5847":194824},[],"Renovar una identidad manteniendo la misma clave.",{"_6944":121159,"_42621":121049,"_30085":194826,"_5":21646,"_28538":194552,"_5847":194827},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_6944":121160,"_42621":121049,"_30085":194829,"_5":21646,"_28538":194552,"_5847":194830},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_6944":121161,"_42621":121049,"_30085":194832,"_5":21646,"_28538":194552,"_5847":194833},[],"**Organization (O)**: organización o empresa.",{"_6944":121162,"_42621":121049,"_30085":194835,"_5":21646,"_28538":194552,"_5847":194836},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_6944":121163,"_42621":121049,"_30085":194838,"_5":21646,"_28538":194552,"_5847":194839},[],"**Country (C)**: código de país de dos letras.",{"_6944":121164,"_42621":121049,"_30085":194841,"_5":21646,"_28538":194552,"_5847":194842},[],"**State / Province (ST)**: estado o provincia.",{"_6944":121165,"_42621":121049,"_30085":194844,"_5":21646,"_28538":194552,"_5847":194845},[],"**Locality (L)**: ciudad o localidad.",{"_6944":121166,"_42621":121049,"_30085":194847,"_5":21646,"_28538":194552,"_5847":194848},[],"**Email Address**: correo de contacto.",{"_6944":121167,"_42621":121049,"_30085":194850,"_5":21646,"_28538":194552,"_5847":194851},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_6944":121168,"_42621":121049,"_30085":194853,"_5":21646,"_28538":194552,"_5847":194854},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_6944":121169,"_42621":121049,"_30085":194856,"_5":21646,"_28538":194556,"_5847":194857},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_6944":121170,"_42621":121049,"_30085":194859,"_5":21646,"_28538":194556,"_5847":194860},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_6944":121171,"_42621":121049,"_30085":194862,"_5":21646,"_28538":194560,"_5847":194863},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_6944":121172,"_42621":121049,"_30085":194865,"_5":21646,"_28538":194560,"_5847":194866},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves. La guía de actualización describe las referencias heredadas que conserva la migración.",{"_6944":121173,"_42621":121173,"_5":22076,"_5847":194868,"_43101":194869,"_30085":194870,"_28538":121173},"Validación online con OCSP",[78004,189200,83487,193719],[],{"_6944":121174,"_42621":121173,"_30085":194872,"_5":21646,"_28538":121173,"_5847":194873},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_6944":121175,"_42621":121173,"_5":43098,"_30085":194875,"_28538":194876,"_5847":194877},[],"/docs/pr-preview/pr-56/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_6944":121176,"_42621":121173,"_5":43098,"_30085":194879,"_28538":194880,"_5847":194881},[],"/docs/pr-preview/pr-56/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_6944":121177,"_42621":121173,"_5":43098,"_30085":194883,"_28538":194884,"_5847":194885},[],"/docs/pr-preview/pr-56/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_6944":121178,"_42621":121173,"_5":43098,"_30085":194887,"_28538":194888,"_5847":194889},[],"/docs/pr-preview/pr-56/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_6944":121179,"_42621":121173,"_5":43098,"_30085":194891,"_28538":194892,"_5847":194893},[],"/docs/pr-preview/pr-56/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_6944":121180,"_42621":121173,"_5":43098,"_30085":194895,"_28538":194896,"_5847":194271},[],"/docs/pr-preview/pr-56/es/platform/pki/ocsp#referencias",{"_6944":121181,"_42621":121173,"_30085":194898,"_5":21646,"_28538":121173,"_5847":194899},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_6944":121182,"_42621":121173,"_30085":194901,"_5":21646,"_28538":194876,"_5847":194902},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_6944":121183,"_42621":121173,"_30085":194904,"_5":21646,"_28538":194876,"_5847":194905},[],"Estado del registro",{"_6944":121184,"_42621":121173,"_30085":194907,"_5":21646,"_28538":194876,"_5847":194908},[],"Respuesta firmada",{"_6944":121185,"_42621":121173,"_30085":194910,"_5":21646,"_28538":194876,"_5847":82611},[],{"_6944":121186,"_42621":121173,"_30085":194912,"_5":21646,"_28538":194876,"_5847":85334},[],{"_6944":121187,"_42621":121173,"_30085":194914,"_5":21646,"_28538":194876,"_5847":82628},[],{"_6944":121188,"_42621":121173,"_30085":194916,"_5":21646,"_28538":194876,"_5847":194917},[],"`Revoked`, con razón y fecha de revocación.",{"_6944":121189,"_42621":121173,"_30085":194919,"_5":21646,"_28538":194876,"_5847":194920},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_6944":121190,"_42621":121173,"_30085":194922,"_5":21646,"_28538":194876,"_5847":194923},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_6944":121191,"_42621":121173,"_30085":194925,"_5":21646,"_28538":194876,"_5847":194926},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_6944":121192,"_42621":121173,"_30085":194928,"_5":21646,"_28538":194876,"_5847":194929},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_6944":121193,"_42621":121173,"_30085":194931,"_5":21646,"_28538":194876,"_5847":194932},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_6944":121194,"_42621":121173,"_30085":194934,"_5":21646,"_28538":194880,"_5847":194935},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_6944":121195,"_42621":121173,"_30085":194937,"_5":21646,"_28538":194880,"_5847":194938},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_6944":121196,"_42621":121173,"_30085":194940,"_5":21646,"_28538":194884,"_5847":194941},[],"El servicio acepta:",{"_6944":121197,"_42621":121173,"_30085":194943,"_5":21646,"_28538":194884,"_5847":190927},[],{"_6944":121198,"_42621":121173,"_30085":194945,"_5":21646,"_28538":194884,"_5847":194946},[],"Ruta del servicio VA",{"_6944":121199,"_42621":121173,"_30085":194948,"_5":21646,"_28538":194884,"_5847":194949},[],"Formato",{"_6944":121200,"_42621":121173,"_30085":194951,"_5":21646,"_28538":194884,"_5847":85374},[],{"_6944":121201,"_42621":121173,"_30085":194953,"_5":21646,"_28538":194884,"_5847":85377},[],{"_6944":121202,"_42621":121173,"_30085":194955,"_5":21646,"_28538":194884,"_5847":194956},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_6944":121203,"_42621":121173,"_30085":194958,"_5":21646,"_28538":194884,"_5847":84803},[],{"_6944":121204,"_42621":121173,"_30085":194960,"_5":21646,"_28538":194884,"_5847":85385},[],{"_6944":121205,"_42621":121173,"_30085":194962,"_5":21646,"_28538":194884,"_5847":194963},[],"Solicitud DER codificada en Base64 URL con padding.",{"_6944":121206,"_42621":121173,"_30085":194965,"_5":21646,"_28538":194884,"_5847":194966},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_6944":121207,"_42621":121173,"_30085":194968,"_5":21646,"_28538":194888,"_5847":194969},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_6944":121208,"_42621":121173,"_30085":194971,"_5":21646,"_28538":194888,"_5847":194972},[],"Genera la solicitud:",{"_6944":121209,"_42621":121173,"_30085":194974,"_5":21646,"_28538":194888,"_5847":194975},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_6944":121210,"_42621":121173,"_30085":194977,"_5":21646,"_28538":194888,"_5847":194978},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_6944":121211,"_42621":121173,"_30085":194980,"_5":21646,"_28538":194888,"_5847":194981},[],"Verifica el DER recibido:",{"_6944":121212,"_42621":121173,"_30085":194983,"_5":21646,"_28538":194888,"_5847":194984},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_6944":121213,"_42621":121173,"_30085":194986,"_5":21646,"_28538":194892,"_5847":194987},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_6944":121214,"_42621":121173,"_30085":194989,"_5":21646,"_28538":194892,"_5847":194990},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_6944":121215,"_42621":121173,"_30085":194992,"_5":21646,"_28538":194896,"_5847":85418},[],{"_6944":121216,"_42621":121173,"_30085":194994,"_5":21646,"_28538":194896,"_5847":85421},[],{"_6944":121217,"_42621":121173,"_30085":194996,"_5":21646,"_28538":194896,"_5847":194997},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_6944":121218,"_42621":121173,"_30085":194999,"_5":21646,"_28538":194896,"_5847":194482},[],{"_6944":121219,"_42621":121219,"_5":22076,"_5847":83487,"_43101":195001,"_30085":195002,"_28538":121219},[78004,189200,83487],[],{"_6944":121220,"_42621":121219,"_30085":195004,"_5":21646,"_28538":121219,"_5847":195005},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_6944":121221,"_42621":121219,"_5":43098,"_30085":195007,"_28538":195008,"_5847":192401},[],"/docs/pr-preview/pr-56/es/platform/pki/overview#empieza-aquí",{"_6944":121222,"_42621":121219,"_5":43098,"_30085":195010,"_28538":195011,"_5847":195012},[],"/docs/pr-preview/pr-56/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_6944":121223,"_42621":121219,"_5":43098,"_30085":195014,"_28538":195015,"_5847":192934},[],"/docs/pr-preview/pr-56/es/platform/pki/overview#capacidades-principales",{"_6944":121224,"_42621":121219,"_5":43098,"_30085":195017,"_28538":195018,"_5847":192938},[],"/docs/pr-preview/pr-56/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_6944":121225,"_42621":121219,"_5":43098,"_30085":195020,"_28538":195021,"_5847":192942},[],"/docs/pr-preview/pr-56/es/platform/pki/overview#protege-las-claves-criptográficas",{"_6944":121226,"_42621":121219,"_5":43098,"_30085":195023,"_28538":195024,"_5847":192946},[],"/docs/pr-preview/pr-56/es/platform/pki/overview#emite-y-controla-certificados",{"_6944":121227,"_42621":121219,"_5":43098,"_30085":195026,"_28538":195027,"_5847":192954},[],"/docs/pr-preview/pr-56/es/platform/pki/overview#publica-el-estado-de-validación",{"_6944":121228,"_42621":121219,"_5":43098,"_30085":195029,"_28538":195030,"_5847":195031},[],"/docs/pr-preview/pr-56/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_6944":121229,"_42621":121219,"_5":43098,"_30085":195033,"_28538":195034,"_5847":193885},[],"/docs/pr-preview/pr-56/es/platform/pki/overview#continúa",{"_6944":121230,"_42621":121219,"_30085":195036,"_5":21646,"_28538":121219,"_5847":195037},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_6944":121231,"_42621":121219,"_30085":195039,"_5":21646,"_28538":195008,"_5847":195040},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_6944":121232,"_42621":121219,"_30085":195042,"_5":21646,"_28538":195008,"_5847":195043},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_6944":121233,"_42621":121219,"_30085":195045,"_5":21646,"_28538":195011,"_5847":195046},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_6944":121234,"_42621":121219,"_30085":195048,"_5":21646,"_28538":195011,"_5847":195049},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_6944":121235,"_42621":121219,"_30085":195051,"_5":21646,"_28538":195011,"_5847":195052},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_6944":121236,"_42621":121219,"_30085":195054,"_5":21646,"_28538":195011,"_5847":195055},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_6944":121237,"_42621":121219,"_30085":195057,"_5":21646,"_28538":195011,"_5847":195058},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_6944":121238,"_42621":121219,"_30085":195060,"_5":21646,"_28538":195018,"_5847":195061},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_6944":121239,"_42621":121219,"_30085":195063,"_5":21646,"_28538":195021,"_5847":195064},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_6944":121240,"_42621":121219,"_30085":195066,"_5":21646,"_28538":195024,"_5847":195067},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_6944":121241,"_42621":121219,"_30085":195069,"_5":21646,"_28538":195027,"_5847":195070},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_6944":121242,"_42621":121219,"_30085":195072,"_5":21646,"_28538":195030,"_5847":195073},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_6944":121243,"_42621":121219,"_30085":195075,"_5":21646,"_28538":195030,"_5847":195076},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_6944":121244,"_42621":121219,"_30085":195078,"_5":21646,"_28538":195030,"_5847":195079},[],"su clave pública corresponda a la clave privada del cliente;",{"_6944":121245,"_42621":121219,"_30085":195081,"_5":21646,"_28538":195030,"_5847":195082},[],"su cadena alcance una raíz confiable para el consumidor;",{"_6944":121246,"_42621":121219,"_30085":195084,"_5":21646,"_28538":195030,"_5847":195085},[],"sus fechas y usos permitan la operación;",{"_6944":121247,"_42621":121219,"_30085":195087,"_5":21646,"_28538":195030,"_5847":195088},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_6944":121248,"_42621":121219,"_30085":195090,"_5":21646,"_28538":195030,"_5847":195091},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_6944":121249,"_42621":121219,"_30085":195093,"_5":21646,"_28538":195034,"_5847":195094},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_6944":121250,"_42621":121219,"_30085":195096,"_5":21646,"_28538":195034,"_5847":195097},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_6944":121251,"_42621":121219,"_30085":195099,"_5":21646,"_28538":195034,"_5847":195100},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_6944":121252,"_42621":121252,"_5":22076,"_5847":195102,"_43101":195103,"_30085":195104,"_28538":121252},"Crea tu primera CA",[78004,189200,83487,192538],[],{"_6944":121253,"_42621":121252,"_30085":195106,"_5":21646,"_28538":121252,"_5847":195107},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_6944":121254,"_42621":121252,"_5":43098,"_30085":195109,"_28538":195110,"_5847":187778},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_6944":121255,"_42621":121252,"_5":43098,"_30085":195112,"_28538":195113,"_5847":195114},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_6944":121256,"_42621":121252,"_5":43098,"_30085":195116,"_28538":195117,"_5847":195118},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_6944":121257,"_42621":121252,"_5":43098,"_30085":195120,"_28538":195121,"_5847":195122},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_6944":121258,"_42621":121252,"_5":43098,"_30085":195124,"_28538":195125,"_5847":195126},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_6944":121259,"_42621":121252,"_5":43098,"_30085":195128,"_28538":195129,"_5847":195130},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_6944":121260,"_42621":121252,"_5":43098,"_30085":195132,"_28538":195133,"_5847":195134},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_6944":121261,"_42621":121252,"_5":43098,"_30085":195136,"_28538":195137,"_5847":192785},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_6944":121262,"_42621":121252,"_5":43098,"_30085":195139,"_28538":195140,"_5847":187802},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_6944":121263,"_42621":121252,"_30085":195142,"_5":21646,"_28538":121252,"_5847":195143},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_6944":121264,"_42621":121252,"_30085":195145,"_5":21646,"_28538":195110,"_5847":195146},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_6944":121265,"_42621":121252,"_30085":195148,"_5":21646,"_28538":195110,"_5847":195149},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_6944":121266,"_42621":121252,"_30085":195151,"_5":21646,"_28538":195110,"_5847":195152},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_6944":121267,"_42621":121252,"_30085":195154,"_5":21646,"_28538":195110,"_5847":195155},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_6944":121268,"_42621":121252,"_30085":195157,"_5":21646,"_28538":195113,"_5847":195158},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_6944":121269,"_42621":121252,"_30085":195160,"_5":21646,"_28538":195113,"_5847":195161},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_6944":121270,"_42621":121252,"_30085":195163,"_5":21646,"_28538":195117,"_5847":195164},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_6944":121271,"_42621":121252,"_30085":195166,"_5":21646,"_28538":195117,"_5847":195167},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_6944":121272,"_42621":121252,"_30085":195169,"_5":21646,"_28538":195121,"_5847":195170},[],"Selecciona **Root CA** y completa:",{"_6944":121273,"_42621":121252,"_30085":195172,"_5":21646,"_28538":195121,"_5847":85600},[],{"_6944":121274,"_42621":121252,"_30085":195174,"_5":21646,"_28538":195121,"_5847":195175},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_6944":121275,"_42621":121252,"_30085":195177,"_5":21646,"_28538":195121,"_5847":195178},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_6944":121276,"_42621":121252,"_30085":195180,"_5":21646,"_28538":195121,"_5847":195181},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_6944":121277,"_42621":121252,"_30085":195183,"_5":21646,"_28538":195121,"_5847":195184},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_6944":121278,"_42621":121252,"_30085":195186,"_5":21646,"_28538":195125,"_5847":195187},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_6944":121279,"_42621":121252,"_30085":195189,"_5":21646,"_28538":195129,"_5847":195190},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_6944":121280,"_42621":121252,"_30085":195192,"_5":21646,"_28538":195129,"_5847":195193},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_6944":121281,"_42621":121252,"_30085":195195,"_5":21646,"_28538":195133,"_5847":195196},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_6944":121282,"_42621":121252,"_30085":195198,"_5":21646,"_28538":195133,"_5847":195199},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_6944":121283,"_42621":121252,"_30085":195201,"_5":21646,"_28538":195133,"_5847":195202},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_6944":121284,"_42621":121252,"_30085":195204,"_5":21646,"_28538":195137,"_5847":195205},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_6944":121285,"_42621":121252,"_30085":195207,"_5":21646,"_28538":195137,"_5847":195208},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_6944":121286,"_42621":121252,"_30085":195210,"_5":21646,"_28538":195137,"_5847":195211},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_6944":121287,"_42621":121252,"_30085":195213,"_5":21646,"_28538":195137,"_5847":195214},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_6944":121288,"_42621":121252,"_30085":195216,"_5":21646,"_28538":195140,"_5847":195217},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_6944":121289,"_42621":121289,"_5":22076,"_5847":195219,"_43101":195220,"_30085":195221,"_28538":121289},"Emite y verifica un certificado",[78004,189200,83487,192538],[],{"_6944":121290,"_42621":121289,"_30085":195223,"_5":21646,"_28538":121289,"_5847":195224},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_6944":121291,"_42621":121289,"_5":43098,"_30085":195226,"_28538":195227,"_5847":187778},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_6944":121292,"_42621":121289,"_5":43098,"_30085":195229,"_28538":195230,"_5847":195231},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_6944":121293,"_42621":121289,"_5":43098,"_30085":195233,"_28538":195234,"_5847":195235},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_6944":121294,"_42621":121289,"_5":43098,"_30085":195237,"_28538":195238,"_5847":195239},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_6944":121295,"_42621":121289,"_5":43098,"_30085":195241,"_28538":195242,"_5847":195243},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_6944":121296,"_42621":121289,"_5":43098,"_30085":195245,"_28538":195246,"_5847":195247},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_6944":121297,"_42621":121289,"_5":43098,"_30085":195249,"_28538":195250,"_5847":195251},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_6944":121298,"_42621":121289,"_5":43098,"_30085":195253,"_28538":195254,"_5847":195255},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_6944":121299,"_42621":121289,"_5":43098,"_30085":195257,"_28538":195258,"_5847":195259},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_6944":121300,"_42621":121289,"_5":43098,"_30085":195261,"_28538":195262,"_5847":195263},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_6944":121301,"_42621":121289,"_5":43098,"_30085":195265,"_28538":195266,"_5847":192785},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_6944":121302,"_42621":121289,"_5":43098,"_30085":195268,"_28538":195269,"_5847":187802},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_6944":121303,"_42621":121289,"_30085":195271,"_5":21646,"_28538":121289,"_5847":195272},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_6944":121304,"_42621":121289,"_30085":195274,"_5":21646,"_28538":195227,"_5847":195275},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_6944":121305,"_42621":121289,"_30085":195277,"_5":21646,"_28538":195227,"_5847":195278},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_6944":121306,"_42621":121289,"_30085":195280,"_5":21646,"_28538":195227,"_5847":195281},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_6944":121307,"_42621":121289,"_30085":195283,"_5":21646,"_28538":195227,"_5847":195284},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_6944":121308,"_42621":121289,"_30085":195286,"_5":21646,"_28538":195227,"_5847":195287},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_6944":121309,"_42621":121289,"_30085":195289,"_5":21646,"_28538":195230,"_5847":195290},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_6944":121310,"_42621":121289,"_30085":195292,"_5":21646,"_28538":195234,"_5847":195293},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_6944":121311,"_42621":121289,"_30085":195295,"_5":21646,"_28538":195234,"_5847":195296},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_6944":121312,"_42621":121289,"_30085":195298,"_5":21646,"_28538":195238,"_5847":195299},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_6944":121313,"_42621":121289,"_30085":195301,"_5":21646,"_28538":195238,"_5847":195302},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_6944":121314,"_42621":121289,"_30085":195304,"_5":21646,"_28538":195242,"_5847":195305},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_6944":121315,"_42621":121289,"_30085":195307,"_5":21646,"_28538":195242,"_5847":195308},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_6944":121316,"_42621":121289,"_30085":195310,"_5":21646,"_28538":195246,"_5847":195311},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_6944":121317,"_42621":121289,"_30085":195313,"_5":21646,"_28538":195250,"_5847":195314},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_6944":121318,"_42621":121289,"_30085":195316,"_5":21646,"_28538":195254,"_5847":195317},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_6944":121319,"_42621":121289,"_30085":195319,"_5":21646,"_28538":195258,"_5847":195320},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_6944":121320,"_42621":121289,"_30085":195322,"_5":21646,"_28538":195258,"_5847":195323},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_6944":121321,"_42621":121289,"_30085":195325,"_5":21646,"_28538":195258,"_5847":195326},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_6944":121322,"_42621":121289,"_30085":195328,"_5":21646,"_28538":195262,"_5847":195329},[],"En Bash, compara los dos resúmenes de clave pública:",{"_6944":121323,"_42621":121289,"_30085":195331,"_5":21646,"_28538":195262,"_5847":195332},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_6944":121324,"_42621":121289,"_30085":195334,"_5":21646,"_28538":195262,"_5847":195335},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_6944":121325,"_42621":121289,"_30085":195337,"_5":21646,"_28538":195266,"_5847":192868},[],{"_6944":121326,"_42621":121289,"_30085":195339,"_5":21646,"_28538":195266,"_5847":191376},[],{"_6944":121327,"_42621":121289,"_30085":195341,"_5":21646,"_28538":195266,"_5847":195342},[],"La CA rechaza la emisión",{"_6944":121328,"_42621":121289,"_30085":195344,"_5":21646,"_28538":195266,"_5847":195345},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_6944":121329,"_42621":121289,"_30085":195347,"_5":21646,"_28538":195266,"_5847":195348},[],"Sujeto o usos diferentes",{"_6944":121330,"_42621":121289,"_30085":195350,"_5":21646,"_28538":195266,"_5847":195351},[],"Perfil aplicado y valores solicitados.",{"_6944":121331,"_42621":121289,"_30085":195353,"_5":21646,"_28538":195266,"_5847":195354},[],"No se encuentra el emisor",{"_6944":121332,"_42621":121289,"_30085":195356,"_5":21646,"_28538":195266,"_5847":195357},[],"CA descargada y cadena intermedia necesaria.",{"_6944":121333,"_42621":121289,"_30085":195359,"_5":21646,"_28538":195266,"_5847":195360},[],"Falla la vigencia",{"_6944":121334,"_42621":121289,"_30085":195362,"_5":21646,"_28538":195266,"_5847":195363},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_6944":121335,"_42621":121289,"_30085":195365,"_5":21646,"_28538":195266,"_5847":195366},[],"Los resúmenes de clave difieren",{"_6944":121336,"_42621":121289,"_30085":195368,"_5":21646,"_28538":195266,"_5847":195369},[],"Archivos de certificado y clave de la misma emisión.",{"_6944":121337,"_42621":121289,"_30085":195371,"_5":21646,"_28538":195266,"_5847":195372},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_6944":121338,"_42621":121289,"_30085":195374,"_5":21646,"_28538":195269,"_5847":195375},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_6944":121339,"_42621":121289,"_30085":195377,"_5":21646,"_28538":195269,"_5847":195378},[],"Gestionar certificados para inspección, estado y revocación.",{"_6944":121340,"_42621":121289,"_30085":195380,"_5":21646,"_28538":195269,"_5847":195381},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_6944":121341,"_42621":121289,"_30085":195383,"_5":21646,"_28538":195269,"_5847":195384},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_6944":121342,"_42621":121289,"_30085":195386,"_5":21646,"_28538":195269,"_5847":195387},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_6944":121343,"_42621":121343,"_5":22076,"_5847":195389,"_43101":195390,"_30085":195391,"_28538":121343},"Primeros pasos de PKI",[78004,189200,83487,192538],[],{"_6944":121344,"_42621":121343,"_30085":195393,"_5":21646,"_28538":121343,"_5847":195394},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_6944":121345,"_42621":121343,"_5":43098,"_30085":195396,"_28538":195397,"_5847":187778},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_6944":121346,"_42621":121343,"_5":43098,"_30085":195399,"_28538":195400,"_5847":195401},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_6944":121347,"_42621":121343,"_5":43098,"_30085":195403,"_28538":195404,"_5847":192720},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/overview#resultado-esperado",{"_6944":121348,"_42621":121343,"_5":43098,"_30085":195406,"_28538":195407,"_5847":195408},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_6944":121349,"_42621":121343,"_30085":195410,"_5":21646,"_28538":121343,"_5847":195411},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_6944":121350,"_42621":121343,"_30085":195413,"_5":21646,"_28538":195397,"_5847":195414},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_6944":121351,"_42621":121343,"_30085":195416,"_5":21646,"_28538":195397,"_5847":195417},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_6944":121352,"_42621":121343,"_30085":195419,"_5":21646,"_28538":195397,"_5847":195420},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_6944":121353,"_42621":121343,"_30085":195422,"_5":21646,"_28538":195397,"_5847":195423},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_6944":121354,"_42621":121343,"_30085":195425,"_5":21646,"_28538":195397,"_5847":195426},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_6944":121355,"_42621":121343,"_30085":195428,"_5":21646,"_28538":195400,"_5847":195429},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_6944":121356,"_42621":121343,"_30085":195431,"_5":21646,"_28538":195400,"_5847":195432},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_6944":121357,"_42621":121343,"_30085":195434,"_5":21646,"_28538":195400,"_5847":195435},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_6944":121358,"_42621":121343,"_30085":195437,"_5":21646,"_28538":195400,"_5847":195438},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_6944":121359,"_42621":121343,"_30085":195440,"_5":21646,"_28538":195404,"_5847":195441},[],"Archivo o recurso",{"_6944":121360,"_42621":121343,"_30085":195443,"_5":21646,"_28538":195404,"_5847":192717},[],{"_6944":121361,"_42621":121343,"_30085":195445,"_5":21646,"_28538":195404,"_5847":195446},[],"CA raíz activa y `ca.pem`",{"_6944":121362,"_42621":121343,"_30085":195448,"_5":21646,"_28538":195404,"_5847":195449},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_6944":121363,"_42621":121343,"_30085":195451,"_5":21646,"_28538":195404,"_5847":195452},[],"Certificado final y `device.crt`",{"_6944":121364,"_42621":121343,"_30085":195454,"_5":21646,"_28538":195404,"_5847":195455},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_6944":121365,"_42621":121343,"_30085":195457,"_5":21646,"_28538":195404,"_5847":195458},[],"Clave privada `device.key`",{"_6944":121366,"_42621":121343,"_30085":195460,"_5":21646,"_28538":195404,"_5847":195461},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_6944":121367,"_42621":121343,"_30085":195463,"_5":21646,"_28538":195404,"_5847":195464},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_6944":121368,"_42621":121343,"_30085":195466,"_5":21646,"_28538":195407,"_5847":195467},[],"Para operar certificados, continúa con Certificados y Validación.",{"_6944":121369,"_42621":121343,"_30085":195469,"_5":21646,"_28538":195407,"_5847":195470},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_6944":121370,"_42621":121343,"_30085":195472,"_5":21646,"_28538":195407,"_5847":195473},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_6944":121371,"_42621":121371,"_5":22076,"_5847":195475,"_43101":195476,"_30085":195478,"_28538":121371},"Resolución de problemas PKI",[78004,189200,83487,195477],"Resolución de problemas",[],{"_6944":121372,"_42621":121371,"_30085":195480,"_5":21646,"_28538":121371,"_5847":195481},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_6944":121373,"_42621":121371,"_5":43098,"_30085":195483,"_28538":195484,"_5847":195485},[],"/docs/pr-preview/pr-56/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_6944":121374,"_42621":121371,"_5":43098,"_30085":195487,"_28538":195488,"_5847":195489},[],"/docs/pr-preview/pr-56/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_6944":121375,"_42621":121371,"_5":43098,"_30085":195491,"_28538":195492,"_5847":195493},[],"/docs/pr-preview/pr-56/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_6944":121376,"_42621":121371,"_30085":195495,"_5":21646,"_28538":121371,"_5847":195496},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_6944":121377,"_42621":121371,"_30085":195498,"_5":21646,"_28538":121371,"_5847":195499},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_6944":121378,"_42621":121371,"_30085":195501,"_5":21646,"_28538":195484,"_5847":192717},[],{"_6944":121379,"_42621":121371,"_30085":195503,"_5":21646,"_28538":195484,"_5847":191376},[],{"_6944":121380,"_42621":121371,"_30085":195505,"_5":21646,"_28538":195484,"_5847":187802},[],{"_6944":121381,"_42621":121371,"_30085":195507,"_5":21646,"_28538":195484,"_5847":82316},[],{"_6944":121382,"_42621":121371,"_30085":195509,"_5":21646,"_28538":195484,"_5847":195510},[],"Existe, está activa y sus fechas son utilizables.",{"_6944":121383,"_42621":121371,"_30085":195512,"_5":21646,"_28538":195484,"_5847":195513},[],"Autoridades.",{"_6944":121384,"_42621":121371,"_30085":195515,"_5":21646,"_28538":195484,"_5847":195516},[],"Clave",{"_6944":121385,"_42621":121371,"_30085":195518,"_5":21646,"_28538":195484,"_5847":195519},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_6944":121386,"_42621":121371,"_30085":195521,"_5":21646,"_28538":195484,"_5847":195522},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_6944":121387,"_42621":121371,"_30085":195524,"_5":21646,"_28538":195484,"_5847":85954},[],{"_6944":121388,"_42621":121371,"_30085":195526,"_5":21646,"_28538":195484,"_5847":195527},[],"PEM correcto y firma verificable.",{"_6944":121389,"_42621":121371,"_30085":195529,"_5":21646,"_28538":195484,"_5847":85960},[],{"_6944":121390,"_42621":121371,"_30085":195531,"_5":21646,"_28538":195484,"_5847":195532},[],"Perfil",{"_6944":121391,"_42621":121371,"_30085":195534,"_5":21646,"_28538":195484,"_5847":195535},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_6944":121392,"_42621":121371,"_30085":195537,"_5":21646,"_28538":195484,"_5847":195538},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_6944":121393,"_42621":121371,"_30085":195540,"_5":21646,"_28538":195484,"_5847":192868},[],{"_6944":121394,"_42621":121371,"_30085":195542,"_5":21646,"_28538":195484,"_5847":195543},[],"Sujeto, SAN, usos y fechas adecuados.",{"_6944":121395,"_42621":121371,"_30085":195545,"_5":21646,"_28538":195484,"_5847":195546},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_6944":121396,"_42621":121371,"_30085":195548,"_5":21646,"_28538":195484,"_5847":195549},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_6944":121397,"_42621":121371,"_30085":195551,"_5":21646,"_28538":195484,"_5847":195552},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_6944":121398,"_42621":121371,"_30085":195554,"_5":21646,"_28538":195488,"_5847":195555},[],"Revisa cada frontera por separado:",{"_6944":121399,"_42621":121371,"_30085":195557,"_5":21646,"_28538":195488,"_5847":195558},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_6944":121400,"_42621":121371,"_30085":195560,"_5":21646,"_28538":195488,"_5847":195561},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_6944":121401,"_42621":121371,"_30085":195563,"_5":21646,"_28538":195488,"_5847":195564},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_6944":121402,"_42621":121371,"_30085":195566,"_5":21646,"_28538":195488,"_5847":195567},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_6944":121403,"_42621":121371,"_30085":195569,"_5":21646,"_28538":195488,"_5847":195570},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_6944":121404,"_42621":121371,"_30085":195572,"_5":21646,"_28538":195488,"_5847":195573},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_6944":121405,"_42621":121371,"_30085":195575,"_5":21646,"_28538":195492,"_5847":195576},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_6944":121406,"_42621":121371,"_30085":195578,"_5":21646,"_28538":195492,"_5847":195579},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_6944":121407,"_42621":121407,"_5":22076,"_5847":195581,"_43101":195582,"_30085":195584,"_28538":121407},"Arquitectura",[78004,189200,195583,193958],"[Enterprise] Actualizaciones",[],{"_6944":121408,"_42621":121407,"_30085":195586,"_5":21646,"_28538":121407,"_5847":195587},[],"Los componentes de Lamassu Updates, cómo se conectan en cada backend y qué se ejecuta en segundo plano.",{"_6944":121409,"_42621":121407,"_5":43098,"_30085":195589,"_28538":195590,"_5847":195591},[],"/docs/pr-preview/pr-56/es/platform/updates/architecture#modo-nativo","Modo nativo",{"_6944":121410,"_42621":121407,"_5":43098,"_30085":195593,"_28538":195594,"_5847":195595},[],"/docs/pr-preview/pr-56/es/platform/updates/architecture#cómo-se-conectan-los-dispositivos","Cómo se conectan los dispositivos",{"_6944":121411,"_42621":121407,"_5":43098,"_30085":195597,"_28538":195598,"_5847":195599},[],"/docs/pr-preview/pr-56/es/platform/updates/architecture#modo-hawkbit","Modo hawkBit",{"_6944":121412,"_42621":121407,"_5":43098,"_30085":195601,"_28538":195602,"_5847":195595},[],"/docs/pr-preview/pr-56/es/platform/updates/architecture#cómo-se-conectan-los-dispositivos-1",{"_6944":121413,"_42621":121407,"_5":43098,"_30085":195604,"_28538":195605,"_5847":195606},[],"/docs/pr-preview/pr-56/es/platform/updates/architecture#qué-se-ejecuta-dentro-del-servicio","Qué se ejecuta dentro del servicio",{"_6944":121414,"_42621":121407,"_5":43098,"_30085":195608,"_28538":195609,"_5847":195610},[],"/docs/pr-preview/pr-56/es/platform/updates/architecture#dependencias","Dependencias",{"_6944":121415,"_42621":121407,"_5":43098,"_30085":195612,"_28538":195613,"_5847":195614},[],"/docs/pr-preview/pr-56/es/platform/updates/architecture#dónde-se-almacena-cada-cosa","Dónde se almacena cada cosa",{"_6944":121416,"_42621":121407,"_5":43098,"_30085":195616,"_28538":195617,"_5847":195618},[],"/docs/pr-preview/pr-56/es/platform/updates/architecture#ejecutar-más-de-una-réplica","Ejecutar más de una réplica",{"_6944":121417,"_42621":121407,"_5":43098,"_30085":195620,"_28538":195621,"_5847":190839},[],"/docs/pr-preview/pr-56/es/platform/updates/architecture#siguientes-pasos",{"_6944":121418,"_42621":121407,"_30085":195623,"_5":21646,"_28538":121407,"_5847":195624},[],"Lamassu Updates es un único proceso que sirve la API de Updates (`/updates/v1`) y, embebido en ella, SymKMS (`/symkms/v1`). También responde a `GET /health`. Detrás de la API hay dos backends intercambiables. El ajuste `mode` elige uno al arrancar el servicio. Los clientes, incluido el dashboard de Lamassu, no pueden distinguirlos salvo a través de las capacidades.",{"_6944":121419,"_42621":121407,"_30085":195626,"_5":21646,"_28538":195590,"_5847":195627},[],"En modo nativo el servicio es dueño de los datos. Postgres guarda paquetes, lanzamientos e historial de dispositivos, WFX guarda un job por dispositivo, y el servicio gobierna ambos.",{"_6944":121420,"_42621":121407,"_30085":195629,"_5":21646,"_28538":195590,"_5847":195630},[],"El servicio es un único proceso. Sus partes, y cuáles usan cada dependencia, están en Qué se ejecuta dentro del servicio.",{"_6944":121421,"_42621":121407,"_30085":195632,"_5":21646,"_28538":195594,"_5847":195633},[],"Un dispositivo nunca habla con el servicio salvo para descargar su paquete. Consulta a WFX los jobs y le notifica cada cambio de estado. El servicio se entera de los cambios por el flujo de eventos de WFX.",{"_6944":121422,"_42621":121407,"_30085":195635,"_5":21646,"_28538":195594,"_5847":195636},[],"La dirección de descarga de cada job es la ruta de descarga del paquete bajo `update_domain`, con el ID del dispositivo añadido para que funcionen los paquetes por dispositivo y la autorización en el gateway. Cuando el almacén de blobs `builds` está en S3 con las descargas prefirmadas activadas, una descarga se responde con un `302` a una URL firmada de corta duración del objeto, en lugar de transmitir los bytes a través del servicio. El almacenamiento local siempre transmite. Ambos admiten peticiones `Range`, así que una descarga interrumpida se reanuda.",{"_6944":121423,"_42621":121407,"_30085":195638,"_5":21646,"_28538":195598,"_5847":195639},[],"En modo hawkBit el servicio es un gateway. Los paquetes se convierten en distribution sets, los lanzamientos en rollouts, y hawkBit es dueño de esos datos y se lee en vivo en cada petición. El servicio guarda en Postgres solo lo que hawkBit no tiene dónde almacenar. Consulta el Modelo de datos.",{"_6944":121424,"_42621":121407,"_30085":195641,"_5":21646,"_28538":195602,"_5847":195642},[],"Los dispositivos hablan con hawkBit y nunca con este servicio para consultar. Consultan la API DDI de hawkBit y le envían su feedback. El servicio lee el progreso de hawkBit cada vez que se le pide, y no tiene ningún flujo de eventos que seguir.",{"_6944":121425,"_42621":121407,"_30085":195644,"_5":21646,"_28538":195602,"_5847":195645},[],"La descarga del artefacto también puede pasar por este servicio. Sirve la ruta de artefactos de dispositivo de hawkBit (`/{tenant}/controller/v1/{controllerId}/softwaremodules/{id}/artifacts/{filename}`, bajo la ruta de `hawkbit.ddi_url`) sin reescribirla, de modo que un gateway delante de ambos siga aplicando sus reglas de autorización. El servicio solo responde por un módulo asignado o instalado en ese dispositivo, y en caso contrario devuelve `404`. Con el prefirmado activado en `hawkbit.artifact_store`, redirige (`302`) a una URL firmada del bucket S3 de hawkBit. Consulta Conectar un dispositivo.",{"_6944":121426,"_42621":121407,"_30085":195647,"_5":21646,"_28538":195605,"_5847":190991},[],{"_6944":121427,"_42621":121407,"_30085":195649,"_5":21646,"_28538":195605,"_5847":195650},[],"Qué hace",{"_6944":121428,"_42621":121407,"_30085":195652,"_5":21646,"_28538":195605,"_5847":195653},[],"Nativo",{"_6944":121429,"_42621":121407,"_30085":195655,"_5":21646,"_28538":195605,"_5847":86087},[],{"_6944":121430,"_42621":121407,"_30085":195657,"_5":21646,"_28538":195605,"_5847":195658},[],"API de Updates",{"_6944":121431,"_42621":121407,"_30085":195660,"_5":21646,"_28538":195605,"_5847":195661},[],"Paquetes, módulos, artefactos, lanzamientos, inventario de dispositivos, cumplimiento de versiones",{"_6944":121432,"_42621":121407,"_30085":195663,"_5":21646,"_28538":195605,"_5847":191827},[],{"_6944":121433,"_42621":121407,"_30085":195665,"_5":21646,"_28538":195605,"_5847":195666},[],"Sí (traducida a llamadas a hawkBit)",{"_6944":121434,"_42621":121407,"_30085":195668,"_5":21646,"_28538":195605,"_5847":86101},[],{"_6944":121435,"_42621":121407,"_30085":195670,"_5":21646,"_28538":195605,"_5847":195671},[],"Almacena claves simétricas y las asigna a dispositivos. Se usa en el cifrado compartido y por dispositivo",{"_6944":121436,"_42621":121407,"_30085":195673,"_5":21646,"_28538":195605,"_5847":191827},[],{"_6944":121437,"_42621":121407,"_30085":195675,"_5":21646,"_28538":195605,"_5847":195676},[],"Sí, para cifrado con clave compartida, si hay un almacenamiento SymKMS o `sym_keys_dir` configurado",{"_6944":121438,"_42621":121407,"_30085":195678,"_5":21646,"_28538":195605,"_5847":195679},[],"Constructor SWU",{"_6944":121439,"_42621":121407,"_30085":195681,"_5":21646,"_28538":195605,"_5847":195682},[],"Ejecuta `swugenerator` para ensamblar, firmar y cifrar paquetes `.swu`",{"_6944":121440,"_42621":121407,"_30085":195684,"_5":21646,"_28538":195605,"_5847":191827},[],{"_6944":121441,"_42621":121407,"_30085":195686,"_5":21646,"_28538":195605,"_5847":195687},[],"Sí (por módulo), si `swugenerator_path` está definido",{"_6944":121442,"_42621":121407,"_30085":195689,"_5":21646,"_28538":195605,"_5847":195690},[],"Almacenes de blobs",{"_6944":121443,"_42621":121407,"_30085":195692,"_5":21646,"_28538":195605,"_5847":195693},[],"Artefactos, builds y claves, en disco local o S3, opcionalmente cifrados en reposo",{"_6944":121444,"_42621":121407,"_30085":195695,"_5":21646,"_28538":195605,"_5847":191827},[],{"_6944":121445,"_42621":121407,"_30085":195697,"_5":21646,"_28538":195605,"_5847":195698},[],"Solo claves (los bytes de los artefactos viven en el almacén de artefactos de hawkBit)",{"_6944":121446,"_42621":121407,"_30085":195700,"_5":21646,"_28538":195605,"_5847":195701},[],"Consumidor de eventos de WFX",{"_6944":121447,"_42621":121407,"_30085":195703,"_5":21646,"_28538":195605,"_5847":195704},[],"Lee el flujo de eventos server-sent de WFX, actualiza el estado de cada dispositivo en su lanzamiento y libera el siguiente lote",{"_6944":121448,"_42621":121407,"_30085":195706,"_5":21646,"_28538":195605,"_5847":191827},[],{"_6944":121449,"_42621":121407,"_30085":195708,"_5":21646,"_28538":195605,"_5847":82222},[],{"_6944":121450,"_42621":121407,"_30085":195710,"_5":21646,"_28538":195605,"_5847":195711},[],"Disparador de lanzamientos programados",{"_6944":121451,"_42621":121407,"_30085":195713,"_5":21646,"_28538":195605,"_5847":195714},[],"Inicia los lanzamientos cuyo `scheduled_at` ha pasado, consultando cada 30 segundos, y repara los lotes cuyo envío se interrumpió",{"_6944":121452,"_42621":121407,"_30085":195716,"_5":21646,"_28538":195605,"_5847":191827},[],{"_6944":121453,"_42621":121407,"_30085":195718,"_5":21646,"_28538":195605,"_5847":195719},[],"No (el planificador propio de hawkBit)",{"_6944":121454,"_42621":121407,"_30085":195721,"_5":21646,"_28538":195605,"_5847":195722},[],"Elección de líder",{"_6944":121455,"_42621":121407,"_30085":195724,"_5":21646,"_28538":195605,"_5847":195725},[],"Garantiza que una sola réplica ejecute el trabajo en segundo plano",{"_6944":121456,"_42621":121407,"_30085":195727,"_5":21646,"_28538":195605,"_5847":191827},[],{"_6944":121457,"_42621":121407,"_30085":195729,"_5":21646,"_28538":195605,"_5847":195730},[],"No es necesaria",{"_6944":121458,"_42621":121407,"_30085":195732,"_5":21646,"_28538":195605,"_5847":195733},[],"Reconciliación",{"_6944":121459,"_42621":121407,"_30085":195735,"_5":21646,"_28538":195605,"_5847":195736},[],"Cada vez que se conecta el flujo de eventos (al arrancar y tras una caída), reproduce las finalizaciones de dispositivos que se perdió, porque el flujo no tiene repetición",{"_6944":121460,"_42621":121407,"_30085":195738,"_5":21646,"_28538":195605,"_5847":191827},[],{"_6944":121461,"_42621":121407,"_30085":195740,"_5":21646,"_28538":195605,"_5847":82222},[],{"_6944":121462,"_42621":121407,"_30085":195742,"_5":21646,"_28538":195605,"_5847":195743},[],"Descargas prefirmadas",{"_6944":121463,"_42621":121407,"_30085":195745,"_5":21646,"_28538":195605,"_5847":195746},[],"Responden las descargas con una redirección a una URL firmada del almacén de objetos",{"_6944":121464,"_42621":121407,"_30085":195748,"_5":21646,"_28538":195605,"_5847":195749},[],"Almacén `builds`",{"_6944":121465,"_42621":121407,"_30085":195751,"_5":21646,"_28538":195605,"_5847":86185},[],{"_6944":121466,"_42621":121407,"_30085":195753,"_5":21646,"_28538":195609,"_5847":195754},[],"Sistema",{"_6944":121467,"_42621":121407,"_30085":195756,"_5":21646,"_28538":195609,"_5847":190738},[],{"_6944":121468,"_42621":121407,"_30085":195758,"_5":21646,"_28538":195609,"_5847":195759},[],"Necesario en",{"_6944":121469,"_42621":121407,"_30085":195761,"_5":21646,"_28538":195609,"_5847":86197},[],{"_6944":121470,"_42621":121407,"_30085":195763,"_5":21646,"_28538":195609,"_5847":195764},[],"Los datos propios del servicio",{"_6944":121471,"_42621":121407,"_30085":195766,"_5":21646,"_28538":195609,"_5847":195767},[],"Ambos",{"_6944":121472,"_42621":121407,"_30085":195769,"_5":21646,"_28538":195609,"_5847":86206},[],{"_6944":121473,"_42621":121407,"_30085":195771,"_5":21646,"_28538":195609,"_5847":195772},[],"Fuente de grupos de dispositivos y dispositivos",{"_6944":121474,"_42621":121407,"_30085":195774,"_5":21646,"_28538":195609,"_5847":195775},[],"Nativo. Opcional en modo hawkBit: sin él, el servicio lee las etiquetas `group:<id>` de los targets del propio hawkBit",{"_6944":121475,"_42621":121407,"_30085":195777,"_5":21646,"_28538":195609,"_5847":86215},[],{"_6944":121476,"_42621":121407,"_30085":195779,"_5":21646,"_28538":195609,"_5847":195780},[],"Claves de firma, para el paquete y para los manifiestos de versión",{"_6944":121477,"_42621":121407,"_30085":195782,"_5":21646,"_28538":195609,"_5847":195783},[],"Al firmar",{"_6944":121478,"_42621":121407,"_30085":195785,"_5":21646,"_28538":195609,"_5847":86224},[],{"_6944":121479,"_42621":121407,"_30085":195787,"_5":21646,"_28538":195609,"_5847":195788},[],"Orquestación de jobs",{"_6944":121480,"_42621":121407,"_30085":195790,"_5":21646,"_28538":195609,"_5847":195653},[],{"_6944":121481,"_42621":121407,"_30085":195792,"_5":21646,"_28538":195609,"_5847":86232},[],{"_6944":121482,"_42621":121407,"_30085":195794,"_5":21646,"_28538":195609,"_5847":195795},[],"El servidor de actualizaciones",{"_6944":121483,"_42621":121407,"_30085":195797,"_5":21646,"_28538":195609,"_5847":86087},[],{"_6944":121484,"_42621":121407,"_30085":195799,"_5":21646,"_28538":195609,"_5847":195800},[],"swugenerator (incluido)",{"_6944":121485,"_42621":121407,"_30085":195802,"_5":21646,"_28538":195609,"_5847":195803},[],"Construye ficheros `.swu`",{"_6944":121486,"_42621":121407,"_30085":195805,"_5":21646,"_28538":195609,"_5847":195806},[],"Al construir",{"_6944":121487,"_42621":121407,"_30085":195808,"_5":21646,"_28538":195613,"_5847":195809},[],"Dato",{"_6944":121488,"_42621":121407,"_30085":195811,"_5":21646,"_28538":195613,"_5847":195653},[],{"_6944":121489,"_42621":121407,"_30085":195813,"_5":21646,"_28538":195613,"_5847":86087},[],{"_6944":121490,"_42621":121407,"_30085":195815,"_5":21646,"_28538":195613,"_5847":195816},[],"Paquetes, versiones, módulos",{"_6944":121491,"_42621":121407,"_30085":195818,"_5":21646,"_28538":195613,"_5847":86259},[],{"_6944":121492,"_42621":121407,"_30085":195820,"_5":21646,"_28538":195613,"_5847":86087},[],{"_6944":121493,"_42621":121407,"_30085":195822,"_5":21646,"_28538":195613,"_5847":195823},[],"Bytes de los artefactos",{"_6944":121494,"_42621":121407,"_30085":195825,"_5":21646,"_28538":195613,"_5847":195826},[],"Almacén de blobs (`artifacts`)",{"_6944":121495,"_42621":121407,"_30085":195828,"_5":21646,"_28538":195613,"_5847":195829},[],"Almacén de artefactos de hawkBit",{"_6944":121496,"_42621":121407,"_30085":195831,"_5":21646,"_28538":195613,"_5847":195832},[],"`.swu` y paquetes construidos",{"_6944":121497,"_42621":121407,"_30085":195834,"_5":21646,"_28538":195613,"_5847":195835},[],"Almacén de blobs (`builds`)",{"_6944":121498,"_42621":121407,"_30085":195837,"_5":21646,"_28538":195613,"_5847":195838},[],"hawkBit (como artefactos de módulo)",{"_6944":121499,"_42621":121407,"_30085":195840,"_5":21646,"_28538":195613,"_5847":37747},[],{"_6944":121500,"_42621":121407,"_30085":195842,"_5":21646,"_28538":195613,"_5847":195843},[],"Postgres (una columna del paquete y del módulo)",{"_6944":121501,"_42621":121407,"_30085":195845,"_5":21646,"_28538":195613,"_5847":86197},[],{"_6944":121502,"_42621":121407,"_30085":195847,"_5":21646,"_28538":195613,"_5847":195848},[],"Lanzamientos y asignaciones de dispositivos",{"_6944":121503,"_42621":121407,"_30085":195850,"_5":21646,"_28538":195613,"_5847":86197},[],{"_6944":121504,"_42621":121407,"_30085":195852,"_5":21646,"_28538":195613,"_5847":195853},[],"Rollouts y actions de hawkBit",{"_6944":121505,"_42621":121407,"_30085":195855,"_5":21646,"_28538":195613,"_5847":195856},[],"Jobs de dispositivo",{"_6944":121506,"_42621":121407,"_30085":195858,"_5":21646,"_28538":195613,"_5847":86224},[],{"_6944":121507,"_42621":121407,"_30085":195860,"_5":21646,"_28538":195613,"_5847":195861},[],"Actions de hawkBit",{"_6944":121508,"_42621":121407,"_30085":195863,"_5":21646,"_28538":195613,"_5847":195864},[],"Historial de actualizaciones de dispositivo",{"_6944":121509,"_42621":121407,"_30085":195866,"_5":21646,"_28538":195613,"_5847":86197},[],{"_6944":121510,"_42621":121407,"_30085":195868,"_5":21646,"_28538":195613,"_5847":195869},[],"Se lee de hawkBit",{"_6944":121511,"_42621":121407,"_30085":195871,"_5":21646,"_28538":195613,"_5847":195872},[],"Claves de cifrado",{"_6944":121512,"_42621":121407,"_30085":195874,"_5":21646,"_28538":195613,"_5847":195875},[],"Almacén de blobs de SymKMS",{"_6944":121513,"_42621":121407,"_30085":195877,"_5":21646,"_28538":195613,"_5847":195875},[],{"_6944":121514,"_42621":121407,"_30085":195879,"_5":21646,"_28538":195613,"_5847":195880},[],"El modo nativo también usa `update_files_base_dir` como espacio temporal de construcción: ahí prepara las entradas de un build, y las salidas construidas se publican en el almacén `builds`.",{"_6944":121515,"_42621":121407,"_30085":195882,"_5":21646,"_28538":195617,"_5847":195883},[],"El trabajo en segundo plano (el consumidor de eventos de WFX y el disparador de lanzamientos programados) se ejecuta en exactamente una réplica a la vez. La elección de líder la decide: Leases de Kubernetes cuando se ejecuta dentro de un clúster, un advisory lock de Postgres en cualquier otro caso, configurable con `leader_election.mode` (`\"\"`, `kubernetes` o `database`). Sin elección, cada réplica contaría las mismas finalizaciones de jobs y liberaría lotes antes de tiempo, por lo que un fallo al configurarla detiene el servicio al arrancar. El envío de un lote también está protegido por un lock por lanzamiento, de modo que dos llamadas nunca envían el mismo lote dos veces.",{"_6944":121516,"_42621":121407,"_30085":195885,"_5":21646,"_28538":195617,"_5847":195886},[],"Si `builds` está en disco local, el servicio registra una advertencia y el despliegue queda limitado a una réplica, porque otras réplicas no podrían servir los builds. Pon `builds`, `artifacts` y el almacén de SymKMS en S3 para escalar horizontalmente. Consulta Operaciones.",{"_6944":121517,"_42621":121407,"_30085":195888,"_5":21646,"_28538":195621,"_5847":195889},[],"<Card title=\"Flujos\" description=\"La secuencia de cada operación importante.\" href=\"/docs/platform/updates/flows\" />",{"_6944":121518,"_42621":121407,"_30085":195891,"_5":21646,"_28538":195621,"_5847":195892},[],"<Card title=\"Modelo de datos\" description=\"Las tablas que guarda el servicio y cómo se relacionan.\" href=\"/docs/platform/updates/data-model\" />",{"_6944":121519,"_42621":121407,"_30085":195894,"_5":21646,"_28538":195621,"_5847":195895},[],"<Card title=\"Operaciones\" description=\"Despliega, escala, respalda y actualiza.\" href=\"/docs/platform/updates/operations\" />",{"_6944":121520,"_42621":121520,"_5":22076,"_5847":193958,"_43101":195897,"_30085":195898,"_28538":121520},[78004,189200,195583,193958],[],{"_6944":121521,"_42621":121520,"_30085":195900,"_5":21646,"_28538":121520,"_5847":195901},[],"Paquetes de actualización, módulos de software, campañas de lanzamiento, workflows y cómo llega una actualización a un dispositivo.",{"_6944":121522,"_42621":121520,"_5":43098,"_30085":195903,"_28538":195904,"_5847":195905},[],"/docs/pr-preview/pr-56/es/platform/updates/concepts#vocabulario","Vocabulario",{"_6944":121523,"_42621":121520,"_5":43098,"_30085":195907,"_28538":195908,"_5847":195909},[],"/docs/pr-preview/pr-56/es/platform/updates/concepts#paquetes-de-actualización","Paquetes de actualización",{"_6944":121524,"_42621":121520,"_5":43098,"_30085":195911,"_28538":195912,"_5847":195913},[],"/docs/pr-preview/pr-56/es/platform/updates/concepts#módulos-de-software","Módulos de software",{"_6944":121525,"_42621":121520,"_5":43098,"_30085":195915,"_28538":195916,"_5847":195917},[],"/docs/pr-preview/pr-56/es/platform/updates/concepts#campañas-de-lanzamiento","Campañas de lanzamiento",{"_6944":121526,"_42621":121520,"_5":43098,"_30085":195919,"_28538":195920,"_5847":195921},[],"/docs/pr-preview/pr-56/es/platform/updates/concepts#estrategia","Estrategia",{"_6944":121527,"_42621":121520,"_5":43098,"_30085":195923,"_28538":195924,"_5847":195925},[],"/docs/pr-preview/pr-56/es/platform/updates/concepts#ciclo-de-vida","Ciclo de vida",{"_6944":121528,"_42621":121520,"_5":43098,"_30085":195927,"_28538":195928,"_5847":195929},[],"/docs/pr-preview/pr-56/es/platform/updates/concepts#versiones-cumplimiento-e-inventario","Versiones, cumplimiento e inventario",{"_6944":121529,"_42621":121520,"_5":43098,"_30085":195931,"_28538":195932,"_5847":195933},[],"/docs/pr-preview/pr-56/es/platform/updates/concepts#cómo-llega-una-actualización-a-un-dispositivo-modo-nativo","Cómo llega una actualización a un dispositivo (modo nativo)",{"_6944":121530,"_42621":121520,"_5":43098,"_30085":195935,"_28538":195936,"_5847":190839},[],"/docs/pr-preview/pr-56/es/platform/updates/concepts#siguientes-pasos",{"_6944":121531,"_42621":121520,"_30085":195938,"_5":21646,"_28538":121520,"_5847":195939},[],"Los términos que usa Lamassu Updates y cómo encajan entre sí. Lee esta página antes de las guías si «paquete de actualización», «lanzamiento» o «módulo» son conceptos nuevos para ti.",{"_6944":121532,"_42621":121520,"_30085":195941,"_5":21646,"_28538":195904,"_5847":195942},[],"El dashboard y esta documentación hablan de **paquete de actualización** (update pack). La API REST y el código hablan de **distribution set** (`/distribution-sets/...`). Son lo mismo.",{"_6944":121533,"_42621":121520,"_30085":195944,"_5":21646,"_28538":195904,"_5847":195945},[],"Término",{"_6944":121534,"_42621":121520,"_30085":195947,"_5":21646,"_28538":195904,"_5847":195948},[],"Significado",{"_6944":121535,"_42621":121520,"_30085":195950,"_5":21646,"_28538":195904,"_5847":195951},[],"Nombre en API / código",{"_6944":121536,"_42621":121520,"_30085":195953,"_5":21646,"_28538":195904,"_5847":195954},[],"Paquete de actualización",{"_6944":121537,"_42621":121520,"_30085":195956,"_5":21646,"_28538":195904,"_5847":195957},[],"Un entregable con nombre y versión que envías a los dispositivos",{"_6944":121538,"_42621":121520,"_30085":195959,"_5":21646,"_28538":195904,"_5847":86400},[],{"_6944":121539,"_42621":121520,"_30085":195961,"_5":21646,"_28538":195904,"_5847":195962},[],"Módulo de software",{"_6944":121540,"_42621":121520,"_30085":195964,"_5":21646,"_28538":195904,"_5847":195965},[],"Un componente con tipo y nombre dentro de un paquete, como una aplicación. Se identifica con la clave `type:name`, donde `type` es `os` o `application`",{"_6944":121541,"_42621":121520,"_30085":195967,"_5":21646,"_28538":195904,"_5847":86409},[],{"_6944":121542,"_42621":121520,"_30085":195969,"_5":21646,"_28538":195904,"_5847":195970},[],"Artefacto",{"_6944":121543,"_42621":121520,"_30085":195972,"_5":21646,"_28538":195904,"_5847":195973},[],"Un fichero (binario) asociado a un módulo o a un paquete",{"_6944":121544,"_42621":121520,"_30085":195975,"_5":21646,"_28538":195904,"_5847":86418},[],{"_6944":121545,"_42621":121520,"_30085":195977,"_5":21646,"_28538":195904,"_5847":195978},[],"Grupo de dispositivos",{"_6944":121546,"_42621":121520,"_30085":195980,"_5":21646,"_28538":195904,"_5847":195981},[],"Un conjunto de dispositivos registrados en Lamassu IoT. Un paquete pertenece a un grupo",{"_6944":121547,"_42621":121520,"_30085":195983,"_5":21646,"_28538":195904,"_5847":86427},[],{"_6944":121548,"_42621":121520,"_30085":195985,"_5":21646,"_28538":195904,"_5847":195986},[],"Campaña de lanzamiento",{"_6944":121549,"_42621":121520,"_30085":195988,"_5":21646,"_28538":195904,"_5847":195989},[],"Un despliegue de una versión de un paquete sobre los dispositivos de un grupo",{"_6944":121550,"_42621":121520,"_30085":195991,"_5":21646,"_28538":195904,"_5847":86436},[],{"_6944":121551,"_42621":121520,"_30085":195993,"_5":21646,"_28538":195904,"_5847":195994},[],"Trabajo (job)",{"_6944":121552,"_42621":121520,"_30085":195996,"_5":21646,"_28538":195904,"_5847":195997},[],"La actualización de un dispositivo dentro de un lanzamiento",{"_6944":121553,"_42621":121520,"_30085":195999,"_5":21646,"_28538":195904,"_5847":86445},[],{"_6944":121554,"_42621":121520,"_30085":196001,"_5":21646,"_28538":195908,"_5847":196002},[],"Un paquete tiene una **versión** (semántica, `x.y.z`) y un **estado**:",{"_6944":121555,"_42621":121520,"_30085":196004,"_5":21646,"_28538":195908,"_5847":196005},[],"Estado",{"_6944":121556,"_42621":121520,"_30085":196007,"_5":21646,"_28538":195908,"_5847":195948},[],{"_6944":121557,"_42621":121520,"_30085":196009,"_5":21646,"_28538":195908,"_5847":86456},[],{"_6944":121558,"_42621":121520,"_30085":196011,"_5":21646,"_28538":195908,"_5847":196012},[],"Editable. Se pueden añadir o reemplazar artefactos. Aún no está construido.",{"_6944":121559,"_42621":121520,"_30085":196014,"_5":21646,"_28538":195908,"_5847":86462},[],{"_6944":121560,"_42621":121520,"_30085":196016,"_5":21646,"_28538":195908,"_5847":196017},[],"El entregable existe. La versión es inmutable. Crea una versión nueva para cambiarla.",{"_6944":121561,"_42621":121520,"_30085":196019,"_5":21646,"_28538":195908,"_5847":86468},[],{"_6944":121562,"_42621":121520,"_30085":196021,"_5":21646,"_28538":195908,"_5847":196022},[],"Se intentó construir y falló. Sigue siendo editable y se puede reintentar. El motivo está en `last_build_error`.",{"_6944":121563,"_42621":121520,"_30085":196024,"_5":21646,"_28538":195908,"_5847":196025},[],"Un paquete tiene un **empaquetado** (packaging):",{"_6944":121564,"_42621":121520,"_30085":196027,"_5":21646,"_28538":195908,"_5847":196028},[],"Empaquetado",{"_6944":121565,"_42621":121520,"_30085":196030,"_5":21646,"_28538":195908,"_5847":196031},[],"Se entrega como",{"_6944":121566,"_42621":121520,"_30085":196033,"_5":21646,"_28538":195908,"_5847":196034},[],"Estado terminal del workflow",{"_6944":121567,"_42621":121520,"_30085":196036,"_5":21646,"_28538":195908,"_5847":86486},[],{"_6944":121568,"_42621":121520,"_30085":196038,"_5":21646,"_28538":195908,"_5847":196039},[],"Un `.swu` construido con swugenerator, opcionalmente firmado y cifrado",{"_6944":121569,"_42621":121520,"_30085":196041,"_5":21646,"_28538":195908,"_5847":86492},[],{"_6944":121570,"_42621":121520,"_30085":196043,"_5":21646,"_28538":195908,"_5847":86495},[],{"_6944":121571,"_42621":121520,"_30085":196045,"_5":21646,"_28538":195908,"_5847":196046},[],"Los artefactos en bruto. El modo nativo construye un paquete `.tar.gz` (opcionalmente cifrado, `.tar.gz.enc`). El modo hawkBit entrega el único fichero de un módulo `raw` tal como se subió (opcionalmente cifrado) y archiva varios ficheros como `<name>.tar.gz`",{"_6944":121572,"_42621":121520,"_30085":196048,"_5":21646,"_28538":195908,"_5847":86501},[],{"_6944":121573,"_42621":121520,"_30085":196050,"_5":21646,"_28538":195908,"_5847":196051},[],"Un paquete también puede llevar **precondiciones**: reglas como «el dispositivo ya debe tener el paquete X en la versión 1.2.0 o superior», o «el módulo `os:gateway-fw` en la versión 2.1.0 o superior». Cada precondición nombra exactamente un paquete (`required_distribution_set_name`) o un módulo (`required_module_key`) y una `min_version` semántica. Un dispositivo que no cumple una precondición no es desplegable, salvo que un operador fuerce el lanzamiento. Cada lanzamiento registra qué dispositivos fallaron y por qué.",{"_6944":121574,"_42621":121520,"_30085":196053,"_5":21646,"_28538":195912,"_5847":196054},[],"Un paquete es una composición de módulos. Contiene un módulo `os` (el ancla obligatoria) y cualquier número de módulos `application`. En modo nativo, un paquete sin filas de módulo se muestra con un módulo implícito `os:<nombre del paquete>`, y los ficheros que subes al paquete le pertenecen. Un módulo guarda sus propios ficheros y, opcionalmente, notas de versión. Puedes:",{"_6944":121575,"_42621":121520,"_30085":196056,"_5":21646,"_28538":195912,"_5847":196057},[],"crear un módulo por separado en el **catálogo** (`POST /updates/v1/softwaremodules`) y componer paquetes con él más adelante,",{"_6944":121576,"_42621":121520,"_30085":196059,"_5":21646,"_28538":195912,"_5847":196060},[],"añadir un módulo directamente a un paquete, o",{"_6944":121577,"_42621":121520,"_30085":196062,"_5":21646,"_28538":195912,"_5847":196063},[],"importar un módulo que ya tiene otro paquete.",{"_6944":121578,"_42621":121520,"_30085":196065,"_5":21646,"_28538":195912,"_5847":196066},[],"La **intención de entrega** (delivery intent) de un módulo indica cómo se enviará: `undecided` (por defecto), `swu-build`, `swu-prebuilt` o `raw`.",{"_6944":121579,"_42621":121520,"_30085":196068,"_5":21646,"_28538":195912,"_5847":196069},[],"Cómo se relacionan los módulos con la construcción depende del backend:",{"_6944":121580,"_42621":121520,"_30085":196071,"_5":21646,"_28538":195912,"_5847":196072},[],"**native**: los módulos son *entradas de la construcción*. El paquete construye un único `.swu` con todos ellos, y un lanzamiento envía a cada dispositivo una única dirección de descarga.",{"_6944":121581,"_42621":121520,"_30085":196074,"_5":21646,"_28538":195912,"_5847":196075},[],"**hawkbit**: cada módulo tiene su *propio entregable*, construido en el catálogo de módulos antes de que exista el paquete. Solo los módulos ya construidos se pueden enlazar a un paquete, y un módulo enlazado queda congelado. hawkBit entrega al dispositivo los artefactos de cada módulo, de modo que un paquete con varios módulos se instala como varias transacciones SWUpdate independientes. SWUpdate no puede hacer rollback entre varios ficheros `.swu`.",{"_6944":121582,"_42621":121520,"_30085":196077,"_5":21646,"_28538":195912,"_5847":196078},[],"La importación de un módulo también difiere. En modo hawkBit la importación lo **enlaza**, así que ambos paquetes comparten el módulo y una reconstrucción se ve en los dos. En modo nativo lo **copia**, así que los dos divergen después. El listado de módulos reutilizables te indica cuál obtendrás (`shared`).",{"_6944":121583,"_42621":121520,"_30085":196080,"_5":21646,"_28538":195916,"_5847":196081},[],"Un lanzamiento despliega una versión de un paquete sobre los dispositivos de un grupo en **lotes**.",{"_6944":121584,"_42621":121520,"_30085":196083,"_5":21646,"_28538":195920,"_5847":196084},[],"Campo",{"_6944":121585,"_42621":121520,"_30085":196086,"_5":21646,"_28538":195920,"_5847":195948},[],{"_6944":121586,"_42621":121520,"_30085":196088,"_5":21646,"_28538":195920,"_5847":86542},[],{"_6944":121587,"_42621":121520,"_30085":196090,"_5":21646,"_28538":195920,"_5847":196091},[],"Cómo se dimensiona un lote. Solo `percentage` hace que `rollout_value` sea un porcentaje. Cualquier otro valor (`fixed`, o `numeric`, que es el que envía el dashboard) lo convierte en un número de dispositivos",{"_6944":121588,"_42621":121520,"_30085":196093,"_5":21646,"_28538":195920,"_5847":86548},[],{"_6944":121589,"_42621":121520,"_30085":196095,"_5":21646,"_28538":195920,"_5847":196096},[],"El porcentaje o el número de dispositivos. Debe ser mayor que 0",{"_6944":121590,"_42621":121520,"_30085":196098,"_5":21646,"_28538":195920,"_5847":86554},[],{"_6944":121591,"_42621":121520,"_30085":196100,"_5":21646,"_28538":195920,"_5847":196101},[],"El workflow de WFX: `direct` (sin confirmación), `phased` (con pasos de confirmación) o `download-install`. Usa `download-install` para paquetes `non-swu`. Cualquier otro valor se pasa a WFX como nombre completo de workflow, como `wfx.workflow.dau.simple`. En modo hawkBit no hay WFX: `phased` se convierte en una acción soft de hawkBit (el dispositivo confirma o pospone) y cualquier otro valor en una acción forced",{"_6944":121592,"_42621":121520,"_30085":196103,"_5":21646,"_28538":195920,"_5847":86560},[],{"_6944":121593,"_42621":121520,"_30085":196105,"_5":21646,"_28538":195920,"_5847":196106},[],"Un canario. El primer lote es este único dispositivo, y debe tener éxito antes de tocar a ningún otro",{"_6944":121594,"_42621":121520,"_30085":196108,"_5":21646,"_28538":195920,"_5847":86566},[],{"_6944":121595,"_42621":121520,"_30085":196110,"_5":21646,"_28538":195920,"_5847":196111},[],"Libera el siguiente lote automáticamente cuando se cumplen las condiciones",{"_6944":121596,"_42621":121520,"_30085":196113,"_5":21646,"_28538":195920,"_5847":86572},[],{"_6944":121597,"_42621":121520,"_30085":196115,"_5":21646,"_28538":195920,"_5847":196116},[],"% del lote actual que debe tener éxito antes de empezar el siguiente (0 a 100). Sin definir, 0 o 100 significa el lote completo",{"_6944":121598,"_42621":121520,"_30085":196118,"_5":21646,"_28538":195920,"_5847":86578},[],{"_6944":121599,"_42621":121520,"_30085":196120,"_5":21646,"_28538":195920,"_5847":196121},[],"El lanzamiento se cancela cuando este % de todos los dispositivos ha fallado (redondeado hacia arriba: con el 10 % de 100 dispositivos se cancela en el décimo fallo). `0` significa sin límite",{"_6944":121600,"_42621":121520,"_30085":196123,"_5":21646,"_28538":195920,"_5847":86584},[],{"_6944":121601,"_42621":121520,"_30085":196125,"_5":21646,"_28538":195920,"_5847":196126},[],"Hora de inicio prevista (RFC 3339). El modo nativo lanza el primer lote cuando pasa esa hora (consulta cada 30 segundos); el modo hawkBit se la entrega a hawkBit como hora de inicio del rollout",{"_6944":121602,"_42621":121520,"_30085":196128,"_5":21646,"_28538":195920,"_5847":86590},[],{"_6944":121603,"_42621":121520,"_30085":196130,"_5":21646,"_28538":195920,"_5847":196131},[],"Nombre para mostrar (por defecto, el nombre del paquete) y notas de texto libre",{"_6944":121604,"_42621":121520,"_30085":196133,"_5":21646,"_28538":195920,"_5847":86596},[],{"_6944":121605,"_42621":121520,"_30085":196135,"_5":21646,"_28538":195920,"_5847":196136},[],"Una pista de prioridad almacenada, de 0 a 1000. Nada la lee",{"_6944":121606,"_42621":121520,"_30085":196138,"_5":21646,"_28538":195924,"_5847":196139},[],"Un lanzamiento está `running`, `paused` (se puede reanudar), `cancelled` (terminal) o `completed` (terminal). Un dispositivo dentro de él pasa de `pending` → `active` → `completed` o `failed`. Puedes reintentar solo los dispositivos fallidos (`retry-failed`). En modo nativo esto también reabre un lanzamiento terminado o cancelado. Los controles del operador son `rollout`, `pause`, `resume`, `cancel`, `complete` y `retry-failed`, y la estrategia se puede editar mientras el lanzamiento exista. El modo nativo los soporta todos. El modo hawkBit no tiene `complete` ni edición de la estrategia, porque los grupos y umbrales de un rollout se fijan al crearlo (consulta Capacidades).",{"_6944":121607,"_42621":121520,"_30085":196141,"_5":21646,"_28538":195928,"_5847":196142},[],"Además de los lanzamientos puntuales, puedes declarar la **última versión** de un paquete para un grupo. El servicio informa entonces de la **desviación** (drift): los dispositivos que no están en la última versión. Puedes forzar un dispositivo a la última versión, o a una exacta. Consulta la referencia de la API.",{"_6944":121608,"_42621":121520,"_30085":196144,"_5":21646,"_28538":195928,"_5847":196145},[],"El servicio también mantiene un **inventario de dispositivos**: qué versión de paquete lleva ahora cada dispositivo, con los artefactos que declara el manifiesto de esa versión, y el historial de intentos de actualización. Ambos se rellenan a medida que se ejecutan los lanzamientos del servicio.",{"_6944":121609,"_42621":121520,"_30085":196147,"_5":21646,"_28538":195932,"_5847":196148},[],"La máquina de estados del lado del dispositivo es un workflow de WFX, en `wfx/workflow/dau/` del repositorio:",{"_6944":121610,"_42621":121520,"_30085":196150,"_5":21646,"_28538":195932,"_5847":196151},[],"Fichero de workflow",{"_6944":121611,"_42621":121520,"_30085":196153,"_5":21646,"_28538":195932,"_5847":196154},[],"Estados",{"_6944":121612,"_42621":121520,"_30085":196156,"_5":21646,"_28538":195932,"_5847":193766},[],{"_6944":121613,"_42621":121520,"_30085":196158,"_5":21646,"_28538":195932,"_5847":86623},[],{"_6944":121614,"_42621":121520,"_30085":196160,"_5":21646,"_28538":195932,"_5847":86626},[],{"_6944":121615,"_42621":121520,"_30085":196162,"_5":21646,"_28538":195932,"_5847":196163},[],"Paquetes SWU, sin confirmación",{"_6944":121616,"_42621":121520,"_30085":196165,"_5":21646,"_28538":195932,"_5847":86632},[],{"_6944":121617,"_42621":121520,"_30085":196167,"_5":21646,"_28538":195932,"_5847":86635},[],{"_6944":121618,"_42621":121520,"_30085":196169,"_5":21646,"_28538":195932,"_5847":196170},[],"Paquetes SWU, con pasos de confirmación",{"_6944":121619,"_42621":121520,"_30085":196172,"_5":21646,"_28538":195932,"_5847":86641},[],{"_6944":121620,"_42621":121520,"_30085":196174,"_5":21646,"_28538":195932,"_5847":86644},[],{"_6944":121621,"_42621":121520,"_30085":196176,"_5":21646,"_28538":195932,"_5847":196177},[],"Paquetes `non-swu`. Se selecciona con `workflow_type`: un lanzamiento no lo elige por ti",{"_6944":121622,"_42621":121520,"_30085":196179,"_5":21646,"_28538":195932,"_5847":86650},[],{"_6944":121623,"_42621":121520,"_30085":196181,"_5":21646,"_28538":195932,"_5847":196182},[],"DOWNLOAD → INSTALL → INSTALLED o TERMINATED",{"_6944":121624,"_42621":121520,"_30085":196184,"_5":21646,"_28538":195932,"_5847":196185},[],"Flujo mínimo",{"_6944":121625,"_42621":121520,"_30085":196187,"_5":21646,"_28538":195932,"_5847":196188},[],"Todos los workflows terminan en `TERMINATED` si hay un fallo. El servicio registra los cuatro ficheros al arrancar. `workflow_file` debe nombrar el fichero `direct`, y los otros tres se buscan a su lado sustituyendo `direct` en el nombre del fichero (consulta Configuración). En modo hawkBit no hay jobs de WFX: consulta Modo hawkBit.",{"_6944":121626,"_42621":121520,"_30085":196190,"_5":21646,"_28538":195936,"_5847":196191},[],"<Card title=\"Arquitectura\" description=\"Los componentes y lo que se ejecuta dentro del servicio.\" href=\"/docs/platform/updates/architecture\" />",{"_6944":121627,"_42621":121520,"_30085":196193,"_5":21646,"_28538":195936,"_5847":196194},[],"<Card title=\"Flujos\" description=\"Diagramas de secuencia de cada operación importante.\" href=\"/docs/platform/updates/flows\" />",{"_6944":121628,"_42621":121520,"_30085":196196,"_5":21646,"_28538":195936,"_5847":196197},[],"<Card title=\"Publicar y desplegar una actualización\" description=\"Hazlo de principio a fin.\" href=\"/docs/platform/updates/guides/publish-and-roll-out\" />",{"_6944":121629,"_42621":121629,"_5":22076,"_5847":196199,"_43101":196200,"_30085":196201,"_28538":121629},"Modelo de datos",[78004,189200,195583,193958],[],{"_6944":121630,"_42621":121629,"_30085":196203,"_5":21646,"_28538":121629,"_5847":196204},[],"Las tablas que guarda el servicio, cómo se relacionan y cómo se crea y migra el esquema.",{"_6944":121631,"_42621":121629,"_5":43098,"_30085":196206,"_28538":196207,"_5847":196208},[],"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-nativo","Tablas del modo nativo",{"_6944":121632,"_42621":121629,"_5":43098,"_30085":196210,"_28538":196211,"_5847":196212},[],"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-hawkbit","Tablas del modo hawkBit",{"_6944":121633,"_42621":121629,"_5":43098,"_30085":196214,"_28538":196215,"_5847":196216},[],"/docs/pr-preview/pr-56/es/platform/updates/data-model#diagramas-entidad-relación","Diagramas entidad-relación",{"_6944":121634,"_42621":121629,"_5":43098,"_30085":196218,"_28538":196219,"_5847":196220},[],"/docs/pr-preview/pr-56/es/platform/updates/data-model#paquetes-módulos-y-artefactos","Paquetes, módulos y artefactos",{"_6944":121635,"_42621":121629,"_5":43098,"_30085":196222,"_28538":196223,"_5847":196224},[],"/docs/pr-preview/pr-56/es/platform/updates/data-model#lanzamientos-y-dispositivos","Lanzamientos y dispositivos",{"_6944":121636,"_42621":121629,"_5":43098,"_30085":196226,"_28538":196227,"_5847":196228},[],"/docs/pr-preview/pr-56/es/platform/updates/data-model#cómo-leer-el-diagrama","Cómo leer el diagrama",{"_6944":121637,"_42621":121629,"_5":43098,"_30085":196230,"_28538":196231,"_5847":196232},[],"/docs/pr-preview/pr-56/es/platform/updates/data-model#creación-del-esquema-y-migraciones","Creación del esquema y migraciones",{"_6944":121638,"_42621":121629,"_5":43098,"_30085":196234,"_28538":196235,"_5847":190839},[],"/docs/pr-preview/pr-56/es/platform/updates/data-model#siguientes-pasos",{"_6944":121639,"_42621":121629,"_30085":196237,"_5":21646,"_28538":121629,"_5847":196238},[],"Las tablas que Lamassu Updates guarda en Postgres, cómo se relacionan y cómo se crea y migra el esquema. Es una referencia para operadores e integradores que consultan la base de datos, la dimensionan o planifican una actualización de versión.",{"_6944":121640,"_42621":121629,"_30085":196240,"_5":21646,"_28538":196207,"_5847":196241},[],"Se crean en Postgres al arrancar, en la base de datos `updates`. Los tipos de Go están en `pkg/models/updates.go` del repositorio ota.",{"_6944":121641,"_42621":121629,"_30085":196243,"_5":21646,"_28538":196207,"_5847":196244},[],"Tabla",{"_6944":121642,"_42621":121629,"_30085":196246,"_5":21646,"_28538":196207,"_5847":196247},[],"Contiene",{"_6944":121643,"_42621":121629,"_30085":196249,"_5":21646,"_28538":196207,"_5847":86721},[],{"_6944":121644,"_42621":121629,"_30085":196251,"_5":21646,"_28538":196207,"_5847":196252},[],"Un paquete de actualización: nombre, versión, grupo, tipo, empaquetado, estado, la sw-description (`sw_descriptor`), precondiciones, ajustes de cifrado y firma, y la cobertura del build por dispositivo",{"_6944":121645,"_42621":121629,"_30085":196254,"_5":21646,"_28538":196207,"_5847":86727},[],{"_6944":121646,"_42621":121629,"_30085":196256,"_5":21646,"_28538":196207,"_5847":196257},[],"Una instantánea de cada versión construida, con su manifiesto firmado",{"_6944":121647,"_42621":121629,"_30085":196259,"_5":21646,"_28538":196207,"_5847":86733},[],{"_6944":121648,"_42621":121629,"_30085":196261,"_5":21646,"_28538":196207,"_5847":196262},[],"Los módulos de una versión de paquete, con clave formada por paquete, versión, tipo de módulo y nombre. También contiene módulos de catálogo que no pertenecen a ningún paquete, con el ID de paquete vacío",{"_6944":121649,"_42621":121629,"_30085":196264,"_5":21646,"_28538":196207,"_5847":86418},[],{"_6944":121650,"_42621":121629,"_30085":196266,"_5":21646,"_28538":196207,"_5847":196267},[],"Un artefacto global: la entrada de catálogo de un fichero subido, único por nombre y versión",{"_6944":121651,"_42621":121629,"_30085":196269,"_5":21646,"_28538":196207,"_5847":86744},[],{"_6944":121652,"_42621":121629,"_30085":196271,"_5":21646,"_28538":196207,"_5847":196272},[],"El enlace entre una versión de paquete, un artefacto y, opcionalmente, un módulo",{"_6944":121653,"_42621":121629,"_30085":196274,"_5":21646,"_28538":196207,"_5847":86750},[],{"_6944":121654,"_42621":121629,"_30085":196276,"_5":21646,"_28538":196207,"_5847":196277},[],"Una campaña de lanzamiento: estrategia, estado, umbrales y contabilidad de lotes",{"_6944":121655,"_42621":121629,"_30085":196279,"_5":21646,"_28538":196207,"_5847":86756},[],{"_6944":121656,"_42621":121629,"_30085":196281,"_5":21646,"_28538":196207,"_5847":196282},[],"El estado de cada dispositivo dentro de un lanzamiento: `pending`, `active`, `completed` o `failed`",{"_6944":121657,"_42621":121629,"_30085":196284,"_5":21646,"_28538":196207,"_5847":86762},[],{"_6944":121658,"_42621":121629,"_30085":196286,"_5":21646,"_28538":196207,"_5847":196287},[],"Qué versión de paquete lleva ahora un dispositivo",{"_6944":121659,"_42621":121629,"_30085":196289,"_5":21646,"_28538":196207,"_5847":86768},[],{"_6944":121660,"_42621":121629,"_30085":196291,"_5":21646,"_28538":196207,"_5847":196292},[],"El historial de actualizaciones de un dispositivo",{"_6944":121661,"_42621":121629,"_30085":196294,"_5":21646,"_28538":196207,"_5847":86774},[],{"_6944":121662,"_42621":121629,"_30085":196296,"_5":21646,"_28538":196207,"_5847":196297},[],"La última versión declarada por grupo y paquete",{"_6944":121663,"_42621":121629,"_30085":196299,"_5":21646,"_28538":196207,"_5847":86780},[],{"_6944":121664,"_42621":121629,"_30085":196301,"_5":21646,"_28538":196207,"_5847":196302},[],"Una fila por cada migración de datos que debe ejecutarse una sola vez (la migración del umbral de aprobación)",{"_6944":121665,"_42621":121629,"_30085":196304,"_5":21646,"_28538":196207,"_5847":196305},[],"Los bytes de los ficheros (artefactos, builds, claves) no están en Postgres. Viven en los almacenes de blobs descritos en Configuración. La sw-description está en Postgres (una columna del paquete y de cada módulo).",{"_6944":121666,"_42621":121629,"_30085":196307,"_5":21646,"_28538":196211,"_5847":196308},[],"En modo hawkBit, los paquetes, rollouts y jobs viven en hawkBit. Este servicio guarda solo lo siguiente en el mismo Postgres (la base de datos `updates`), para aquello para lo que hawkBit no tiene equivalente:",{"_6944":121667,"_42621":121629,"_30085":196310,"_5":21646,"_28538":196211,"_5847":196244},[],{"_6944":121668,"_42621":121629,"_30085":196312,"_5":21646,"_28538":196211,"_5847":196247},[],{"_6944":121669,"_42621":121629,"_30085":196314,"_5":21646,"_28538":196211,"_5847":86796},[],{"_6944":121670,"_42621":121629,"_30085":196316,"_5":21646,"_28538":196211,"_5847":196317},[],"Bytes de `POST /artifacts`. Las subidas con más de 30 minutos se descartan la próxima vez que alguien sube un artefacto, y siguen siendo legibles hasta entonces. No se pueden enlazar a un paquete en este modo",{"_6944":121671,"_42621":121629,"_30085":196319,"_5":21646,"_28538":196211,"_5847":86802},[],{"_6944":121672,"_42621":121629,"_30085":196321,"_5":21646,"_28538":196211,"_5847":196322},[],"Se lee al resolver un ID de artefacto, pero ya nada la escribe",{"_6944":121673,"_42621":121629,"_30085":196324,"_5":21646,"_28538":196211,"_5847":86808},[],{"_6944":121674,"_42621":121629,"_30085":196326,"_5":21646,"_28538":196211,"_5847":196327},[],"sw-descriptions, precondiciones de lanzamiento y banderas de rollout (un almacén de texto clave-valor de uso general, con clave formada por instancia, tipo e ID)",{"_6944":121675,"_42621":121629,"_30085":196329,"_5":21646,"_28538":196211,"_5847":86814},[],{"_6944":121676,"_42621":121629,"_30085":196331,"_5":21646,"_28538":196211,"_5847":196332},[],"Manifiestos firmados de los sets construidos",{"_6944":121677,"_42621":121629,"_30085":196334,"_5":21646,"_28538":196211,"_5847":86820},[],{"_6944":121678,"_42621":121629,"_30085":196336,"_5":21646,"_28538":196211,"_5847":196337},[],"Rollouts cancelados a través de este servicio",{"_6944":121679,"_42621":121629,"_30085":196339,"_5":21646,"_28538":196211,"_5847":86774},[],{"_6944":121680,"_42621":121629,"_30085":196341,"_5":21646,"_28538":196211,"_5847":196342},[],"Últimas versiones declaradas (compartida con el modo nativo)",{"_6944":121681,"_42621":121629,"_30085":196344,"_5":21646,"_28538":196211,"_5847":196345},[],"Las filas con clave formada por un ID de hawkBit llevan un `instance_id`, un marcador de los datos de hawkBit que describen. Si hawkBit pierde sus datos y empieza de nuevo, los IDs se repiten, y el servicio deja de leer las filas escritas para la instancia anterior. El servicio vuelve a comprobar el marcador cada 30 segundos.",{"_6944":121682,"_42621":121629,"_30085":196347,"_5":21646,"_28538":196211,"_5847":196348},[],"hawkBit mantiene su propio esquema en su propia base de datos `hawkbit`. En el stack de Docker Compose, `init.sql` crea ambas bases de datos la primera vez que arranca el contenedor de Postgres.",{"_6944":121683,"_42621":121629,"_30085":196350,"_5":21646,"_28538":196215,"_5847":196351},[],"Las tablas del modo nativo, con sus columnas principales. Las columnas `*_id` que apuntan a otra tabla se dibujan como las líneas de relación. Son referencias lógicas: el servicio no crea restricciones de clave foránea en la base de datos, y `FK` solo marca qué columna contiene la referencia.",{"_6944":121684,"_42621":121629,"_30085":196353,"_5":21646,"_28538":196223,"_5847":196354},[],"Valores que conviene conocer:",{"_6944":121685,"_42621":121629,"_30085":196356,"_5":21646,"_28538":196223,"_5847":196357},[],"`distribution_set.status` es `draft`, `built` o `build_failed`. `packaging` es `swu` o `non-swu`. `encryption_mode` es vacío, `shared` o `per-device`.",{"_6944":121686,"_42621":121629,"_30085":196359,"_5":21646,"_28538":196223,"_5847":196360},[],"`launchtrack.status` es `running`, `paused`, `cancelled` o `completed`. Un lanzamiento nuevo se guarda con estado vacío, que significa running. `aborted` es verdadero en un lanzamiento cancelado (por el operador o por el umbral de error) y detiene todas las vías de despliegue. El resultado de las precondiciones del lanzamiento (`forced_preconditions`, `precondition_failures`) se guarda en la fila, pero no las precondiciones en sí: esas viven en el paquete.",{"_6944":121687,"_42621":121629,"_30085":196362,"_5":21646,"_28538":196223,"_5847":196363},[],"`rollout_type` no se valida: solo el valor `percentage` hace que `rollout_value` sea un porcentaje, y cualquier otro valor (el dashboard envía `numeric`, los ejemplos usan `fixed`) lo convierte en un número de dispositivos.",{"_6944":121688,"_42621":121629,"_30085":196365,"_5":21646,"_28538":196223,"_5847":196366},[],"`launch_device_assignments.status` es `pending`, `active`, `completed` o `failed`. (`cancelled` también existe como valor, pero solo lo informa el modo hawkBit, para un canario cuyo lanzamiento se canceló; nunca se almacena.)",{"_6944":121689,"_42621":121629,"_30085":196368,"_5":21646,"_28538":196223,"_5847":196369},[],"`device_distribution_set_update.status` es `pending`, `running`, `success` o `failed` (el modo hawkBit también puede informar `cancelled`), y su `source` es `service`.",{"_6944":121690,"_42621":121629,"_30085":196371,"_5":21646,"_28538":196223,"_5847":196372},[],"`distribution_set_module` es único por paquete, versión de paquete, tipo y nombre. Un módulo de catálogo independiente tiene `distribution_set_id` vacío, y su `distribution_set_version` es igual a su propia `version`.",{"_6944":121691,"_42621":121629,"_30085":196374,"_5":21646,"_28538":196223,"_5847":196375},[],"`distribution_set_version` es único por paquete y versión, y `distribution_set_artifact` por paquete, versión y artefacto.",{"_6944":121692,"_42621":121629,"_30085":196377,"_5":21646,"_28538":196223,"_5847":196378},[],"No dibujadas: `updates_schema_migrations`, una tabla de marcas que usan las migraciones de datos del arranque, y las tablas del modo hawkBit listadas arriba.",{"_6944":121693,"_42621":121629,"_30085":196380,"_5":21646,"_28538":196227,"_5847":196381},[],"Un **paquete** (`distribution_set`) es una fila que avanza por versiones. Cada versión construida se guarda como instantánea en `distribution_set_version`, con su manifiesto firmado.",{"_6944":121694,"_42621":121629,"_30085":196383,"_5":21646,"_28538":196227,"_5847":196384},[],"Los **módulos** y los **artefactos** son cosas distintas: un artefacto es un fichero del catálogo global, y `distribution_set_artifact` lo enlaza a una versión de paquete (y opcionalmente a un módulo). Un módulo cuyo `distribution_set_id` está vacío es un módulo de catálogo que ningún paquete contiene todavía.",{"_6944":121695,"_42621":121629,"_30085":196386,"_5":21646,"_28538":196227,"_5847":196387},[],"Un **lanzamiento** (`launchtrack`) se dirige a un grupo mediante una fila de asignación por dispositivo. La asignación pasa de `pending` → `active` → `completed` o `failed`, y `batch_index` registra qué lote la envió.",{"_6944":121696,"_42621":121629,"_30085":196389,"_5":21646,"_28538":196227,"_5847":196390},[],"Dos tablas de dispositivo responden a preguntas distintas. `device_distribution_set_version` es lo que un dispositivo lleva **ahora**. `device_distribution_set_update` es el **historial** de intentos, con `version_from` y `version_to`.",{"_6944":121697,"_42621":121629,"_30085":196392,"_5":21646,"_28538":196227,"_5847":196393},[],"`latest_distribution_set_version` es la versión en la que un operador declaró que deben estar los dispositivos de un grupo, y se usa para la desviación y el cumplimiento.",{"_6944":121698,"_42621":121629,"_30085":196395,"_5":21646,"_28538":196231,"_5847":196396},[],"No hay ficheros de migración. En modo nativo, el servicio crea y actualiza su propio esquema al arrancar, manteniendo un lock de Postgres para que las réplicas que arrancan a la vez no compitan. Ejecuta estos pasos en orden (el modo hawkBit solo crea sus seis tablas):",{"_6944":121699,"_42621":121629,"_30085":196398,"_5":21646,"_28538":196231,"_5847":196399},[],"**Paso de renombrado** (`MigrateDistributionSetNaming`). A las bases de datos creadas antes del cambio de nombre «update pack» → «distribution set» se les renombran tablas y columnas. Se ejecuta antes del paso 2 para que las tablas nuevas no se creen vacías junto a las antiguas.",{"_6944":121700,"_42621":121629,"_30085":196401,"_5":21646,"_28538":196231,"_5847":196402},[],"**Crear y añadir** (GORM `AutoMigrate`). Se crean las tablas y columnas que faltan. Nunca elimina ni renombra nada.",{"_6944":121701,"_42621":121629,"_30085":196404,"_5":21646,"_28538":196231,"_5847":196405},[],"**Migraciones de datos.** Módulos independientes (las filas de `software_module_definition` pasan a las tablas de módulos y artefactos, conservando IDs y ficheros, y se elimina la tabla antigua), asignaciones de dispositivos (reconstruidas a partir de las columnas heredadas del lanzamiento) y la semántica del umbral de aprobación.",{"_6944":121702,"_42621":121629,"_30085":196407,"_5":21646,"_28538":196231,"_5847":196408},[],"La mayoría de los pasos comprueban el esquema actual en lugar de un número de versión, y la migración del umbral de aprobación registra una fila en `updates_schema_migrations` para ejecutarse solo una vez. Arrancar varias veces es seguro, y una base de datos nueva no tiene nada que migrar. Tras los pasos de esquema, el servicio también copia al almacén de artefactos los binarios del esquema heredado, organizado por paquete en disco, omitiendo los que ya están allí.",{"_6944":121703,"_42621":121629,"_30085":196410,"_5":21646,"_28538":196231,"_5847":196411},[],"`init.sql` es una semilla de Docker Compose: crea las bases de datos `updates` y `hawkbit` y aún contiene definiciones de tablas antiguas, así que no lo uses para definir tú mismo el esquema.",{"_6944":121704,"_42621":121629,"_30085":196413,"_5":21646,"_28538":196231,"_5847":196414},[],"Consulta Operaciones para saber qué hacer antes de actualizar de versión.",{"_6944":121705,"_42621":121629,"_30085":196416,"_5":21646,"_28538":196235,"_5847":196417},[],"<Card title=\"Configuración\" description=\"Almacenes de blobs, storage y cada campo de configuración.\" href=\"/docs/platform/updates/reference/configuration\" />",{"_6944":121706,"_42621":121629,"_30085":196419,"_5":21646,"_28538":196235,"_5847":196420},[],"<Card title=\"Operaciones\" description=\"Respalda, escala y actualiza la base de datos.\" href=\"/docs/platform/updates/operations\" />",{"_6944":121707,"_42621":121707,"_5":22076,"_5847":196422,"_43101":196423,"_30085":196424,"_28538":121707},"Flujos",[78004,189200,195583,193958],[],{"_6944":121708,"_42621":121707,"_30085":196426,"_5":21646,"_28538":121707,"_5847":196427},[],"Diagramas de secuencia de las operaciones importantes, para los backends nativo y hawkBit.",{"_6944":121709,"_42621":121707,"_5":43098,"_30085":196429,"_28538":196430,"_5847":195591},[],"/docs/pr-preview/pr-56/es/platform/updates/flows#modo-nativo",{"_6944":121710,"_42621":121707,"_5":43098,"_30085":196432,"_28538":196433,"_5847":196434},[],"/docs/pr-preview/pr-56/es/platform/updates/flows#1-publicar-y-construir-un-paquete","1\\. Publicar y construir un paquete",{"_6944":121711,"_42621":121707,"_5":43098,"_30085":196436,"_28538":196437,"_5847":196438},[],"/docs/pr-preview/pr-56/es/platform/updates/flows#2-crear-un-lanzamiento","2\\. Crear un lanzamiento",{"_6944":121712,"_42621":121707,"_5":43098,"_30085":196440,"_28538":196441,"_5847":196442},[],"/docs/pr-preview/pr-56/es/platform/updates/flows#3-desplegar-un-lote-y-actualizar-un-dispositivo","3\\. Desplegar un lote y actualizar un dispositivo",{"_6944":121713,"_42621":121707,"_5":43098,"_30085":196444,"_28538":196445,"_5847":196446},[],"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","4\\. Reaccionar cuando un dispositivo termina",{"_6944":121714,"_42621":121707,"_5":43098,"_30085":196448,"_28538":196449,"_5847":196450},[],"/docs/pr-preview/pr-56/es/platform/updates/flows#5-construir-un-paquete-cifrado-por-dispositivo","5\\. Construir un paquete cifrado por dispositivo",{"_6944":121715,"_42621":121707,"_5":43098,"_30085":196452,"_28538":196453,"_5847":195599},[],"/docs/pr-preview/pr-56/es/platform/updates/flows#modo-hawkbit",{"_6944":121716,"_42621":121707,"_5":43098,"_30085":196455,"_28538":196456,"_5847":196457},[],"/docs/pr-preview/pr-56/es/platform/updates/flows#6-construir-un-módulo-y-crear-un-paquete","6\\. Construir un módulo y crear un paquete",{"_6944":121717,"_42621":121707,"_5":43098,"_30085":196459,"_28538":196460,"_5847":196461},[],"/docs/pr-preview/pr-56/es/platform/updates/flows#7-lanzamiento-y-actualización-del-dispositivo","7\\. Lanzamiento y actualización del dispositivo",{"_6944":121718,"_42621":121707,"_5":43098,"_30085":196463,"_28538":196464,"_5847":190839},[],"/docs/pr-preview/pr-56/es/platform/updates/flows#siguientes-pasos",{"_6944":121719,"_42621":121707,"_30085":196466,"_5":21646,"_28538":121707,"_5847":196467},[],"Estos diagramas siguen lo que hace el servicio, paso a paso. Las rutas son relativas a `/updates/v1`. Para ver comandos ejecutables consulta las guías de curl nativa y hawkBit, y la referencia de la API para cada ruta y cuerpo.",{"_6944":121720,"_42621":121707,"_30085":196469,"_5":21646,"_28538":196433,"_5847":196470},[],"Construir convierte los artefactos subidos y la sw-description en un único `.swu`. Nada se firma ni se cifra salvo que la petición de build lo pida.",{"_6944":121721,"_42621":121707,"_30085":196472,"_5":21646,"_28538":196433,"_5847":196473},[],"Cosas que conviene saber sobre el build:",{"_6944":121722,"_42621":121707,"_30085":196475,"_5":21646,"_28538":196433,"_5847":196476},[],"El paquete se crea con un nombre, una `version` semántica, un `group_id`, un `type` y un `packaging` opcional. Un nombre duplicado en el grupo da un `409`.",{"_6944":121723,"_42621":121707,"_30085":196478,"_5":21646,"_28538":196433,"_5847":196479},[],"Subir un artefacto (o un entregable ya construido) a una versión que ya está construida se rechaza con `409`: crea primero una versión nueva. Un build o cambio que colisione con otro sobre el mismo paquete también responde `409`.",{"_6944":121724,"_42621":121707,"_30085":196481,"_5":21646,"_28538":196433,"_5847":196482},[],"Un fichero mayor que `max_artifact_size_mb` (10240 MiB por defecto) se rechaza con `413`.",{"_6944":121725,"_42621":121707,"_30085":196484,"_5":21646,"_28538":196433,"_5847":196485},[],"El cifrado lo decide el cuerpo del build: `user` más `encryption_key_name` es cifrado con clave compartida, y `encryption_alg_name` solo es cifrado por dispositivo (flujo 5).",{"_6944":121726,"_42621":121707,"_30085":196487,"_5":21646,"_28538":196433,"_5847":196488},[],"Si el build falla, el paquete pasa a `build_failed`, `last_build_error` dice por qué, y el paquete sigue siendo editable. Los artefactos seleccionados reemplazan los enlaces de artefactos anteriores de la versión del paquete.",{"_6944":121727,"_42621":121707,"_30085":196490,"_5":21646,"_28538":196433,"_5847":196491},[],"Sin campos de firma, el manifiesto se guarda sin firmar. Si se indica una clave de firma pero no un certificado, el build falla.",{"_6944":121728,"_42621":121707,"_30085":196493,"_5":21646,"_28538":196433,"_5847":196494},[],"Un paquete `non-swu` se construye con `POST .../package` en un `.tar.gz`, y un entregable construido fuera se adjunta con `POST .../swu/upload` o `.../package/upload`.",{"_6944":121729,"_42621":121707,"_30085":196496,"_5":21646,"_28538":196437,"_5847":196497},[],"Crear un lanzamiento decide a quién se dirige y comprueba que el paquete se puede entregar. Todavía no se envía nada a ningún dispositivo.",{"_6944":121730,"_42621":121707,"_30085":196499,"_5":21646,"_28538":196437,"_5847":196500},[],"`?dry_run=true` se detiene tras la comprobación de precondiciones y responde `200` con `qualifying_devices`, `precondition_failures`, `superseded_devices` y `never_seen_devices`. `force_preconditions` apunta a todos los dispositivos del grupo y aun así registra cuáles fallaron. `distribution_set_name`, `workflow_type` y `rollout_type` son obligatorios, y también un `rollout_value` mayor que cero. `approval_threshold` y `error_threshold` deben estar entre 0 y 100, y cada incumplimiento es un `400`. Un lanzamiento también puede llevar `auto`, `scheduled_at`, `name`, `description` y `weight` (consulta Conceptos).",{"_6944":121731,"_42621":121707,"_30085":196502,"_5":21646,"_28538":196441,"_5847":196503},[],"Una llamada `rollout` envía el siguiente lote. El canario va solo primero, y después lotes del tamaño configurado, elegidos al azar entre los dispositivos que siguen pendientes. El lado del dispositivo de abajo es el workflow `direct`, donde un job empieza en `INSTALL`.",{"_6944":121732,"_42621":121707,"_30085":196505,"_5":21646,"_28538":196441,"_5847":196506},[],"Con el workflow `phased`, un job empieza en `CREATED`, y algunas transiciones necesitan que una persona o un sistema las confirme en WFX. Este servicio no las avanza. El workflow `download-install`, que usan los paquetes `non-swu`, recorre `DOWNLOAD → DOWNLOADING → DOWNLOADED → INSTALL → INSTALLING → INSTALLED`.",{"_6944":121733,"_42621":121707,"_30085":196508,"_5":21646,"_28538":196441,"_5847":196509},[],"Con `auto` activado, una llamada `rollout` inicia el lanzamiento y los lotes siguientes los libera el flujo 4. Un lanzamiento con `scheduled_at` lo inicia el disparador de lanzamientos programados en la réplica líder cuando pasa esa hora.",{"_6944":121734,"_42621":121707,"_30085":196511,"_5":21646,"_28538":196441,"_5847":196512},[],"La llamada `rollout` no siempre es un `200` simple:",{"_6944":121735,"_42621":121707,"_30085":196514,"_5":21646,"_28538":196441,"_5847":196515},[],"Se rechaza con `400` cuando el lanzamiento está pausado, cancelado, completado o abortado, y en un lanzamiento `auto` una vez que ha salido algún lote.",{"_6944":121736,"_42621":121707,"_30085":196517,"_5":21646,"_28538":196441,"_5847":196518},[],"No hace nada y responde `200` mientras `scheduled_at` esté todavía en el futuro, y mientras el canario siga activo. Devuelve un error si el canario falló.",{"_6944":121737,"_42621":121707,"_30085":196520,"_5":21646,"_28538":196441,"_5847":196521},[],"Si no se pueden crear algunos jobs, esos dispositivos siguen `pending` y la llamada devuelve un error de «partial rollout» (`500`).",{"_6944":121738,"_42621":121707,"_30085":196523,"_5":21646,"_28538":196445,"_5847":196524},[],"Cada cambio de estado que notifica WFX ejecuta la misma lógica. Es lo que hace funcionar el lote automático, la compuerta del canario y el umbral de error.",{"_6944":121739,"_42621":121707,"_30085":196526,"_5":21646,"_28538":196445,"_5847":196527},[],"En **cada** evento, el servicio actualiza el historial de actualizaciones del dispositivo y escribe el evento en los metadatos del dispositivo en Lamassu. Después, solo si el estado es terminal en el workflow, ejecuta estas comprobaciones en orden, y la primera que se cumple decide lo que ocurre:",{"_6944":121740,"_42621":121707,"_30085":196529,"_5":21646,"_28538":196445,"_5847":87016},[],{"_6944":121741,"_42621":121707,"_30085":196531,"_5":21646,"_28538":196445,"_5847":192717},[],{"_6944":121742,"_42621":121707,"_30085":196533,"_5":21646,"_28538":196445,"_5847":196534},[],"Si se cumple",{"_6944":121743,"_42621":121707,"_30085":196536,"_5":21646,"_28538":196445,"_5847":7088},[],{"_6944":121744,"_42621":121707,"_30085":196538,"_5":21646,"_28538":196445,"_5847":196539},[],"¿Es el estado terminal en el workflow?",{"_6944":121745,"_42621":121707,"_30085":196541,"_5":21646,"_28538":196445,"_5847":196542},[],"Si no, no ocurre nada más",{"_6944":121746,"_42621":121707,"_30085":196544,"_5":21646,"_28538":196445,"_5847":7102},[],{"_6944":121747,"_42621":121707,"_30085":196546,"_5":21646,"_28538":196445,"_5847":196547},[],"(siempre)",{"_6944":121748,"_42621":121707,"_30085":196549,"_5":21646,"_28538":196445,"_5847":196550},[],"Marcar la asignación del dispositivo como `completed` o `failed`. Si tuvo éxito, registrar la versión instalada",{"_6944":121749,"_42621":121707,"_30085":196552,"_5":21646,"_28538":196445,"_5847":7108},[],{"_6944":121750,"_42621":121707,"_30085":196554,"_5":21646,"_28538":196445,"_5847":196555},[],"¿Falló el dispositivo canario?",{"_6944":121751,"_42621":121707,"_30085":196557,"_5":21646,"_28538":196445,"_5847":196558},[],"Pausar el lanzamiento. Reanuda para reintentar",{"_6944":121752,"_42621":121707,"_30085":196560,"_5":21646,"_28538":196445,"_5847":7095},[],{"_6944":121753,"_42621":121707,"_30085":196562,"_5":21646,"_28538":196445,"_5847":196563},[],"¿Está el lanzamiento pausado, cancelado o completado?",{"_6944":121754,"_42621":121707,"_30085":196565,"_5":21646,"_28538":196445,"_5847":196566},[],"Parar: no hay más lotes",{"_6944":121755,"_42621":121707,"_30085":196568,"_5":21646,"_28538":196445,"_5847":16675},[],{"_6944":121756,"_42621":121707,"_30085":196570,"_5":21646,"_28538":196445,"_5847":196571},[],"¿Está definido `error_threshold`, y los fallos han alcanzado esa proporción de todos los dispositivos (redondeada hacia arriba)?",{"_6944":121757,"_42621":121707,"_30085":196573,"_5":21646,"_28538":196445,"_5847":196574},[],"Cancelar el lanzamiento. Los dispositivos pendientes no se envían",{"_6944":121758,"_42621":121707,"_30085":196576,"_5":21646,"_28538":196445,"_5847":28545},[],{"_6944":121759,"_42621":121707,"_30085":196578,"_5":21646,"_28538":196445,"_5847":196579},[],"¿No hay nada pendiente ni nada activo?",{"_6944":121760,"_42621":121707,"_30085":196581,"_5":21646,"_28538":196445,"_5847":196582},[],"Marcar el lanzamiento como `completed`",{"_6944":121761,"_42621":121707,"_30085":196584,"_5":21646,"_28538":196445,"_5847":21762},[],{"_6944":121762,"_42621":121707,"_30085":196586,"_5":21646,"_28538":196445,"_5847":196587},[],"¿Está `auto` desactivado, o no queda nada por enviar?",{"_6944":121763,"_42621":121707,"_30085":196589,"_5":21646,"_28538":196445,"_5847":196590},[],"Esperar a la siguiente llamada `rollout` del operador, o a los dispositivos que siguen en curso",{"_6944":121764,"_42621":121707,"_30085":196592,"_5":21646,"_28538":196445,"_5847":14079},[],{"_6944":121765,"_42621":121707,"_30085":196594,"_5":21646,"_28538":196445,"_5847":196595},[],"¿Tuvo éxito al menos `approval_threshold` de este lote? (0, 100 o más significa todo el lote)",{"_6944":121766,"_42621":121707,"_30085":196597,"_5":21646,"_28538":196445,"_5847":196598},[],"Enviar el siguiente lote. Si no, esperar más resultados",{"_6944":121767,"_42621":121707,"_30085":196600,"_5":21646,"_28538":196445,"_5847":196601},[],"Solo los dispositivos enviados en el lote actual cuentan para su aprobación: un rezagado de un lote anterior nunca cuenta. Las comprobaciones mueven el lanzamiento entre estos estados:",{"_6944":121768,"_42621":121707,"_30085":196603,"_5":21646,"_28538":196445,"_5847":196604},[],"Un lanzamiento nuevo se guarda con estado vacío, que significa `running`. Reanudar tras un fallo del canario vuelve a encolar el canario para que se intente de nuevo. Cancelar detiene los lotes siguientes, pero no retira los jobs que ya se están ejecutando en los dispositivos.",{"_6944":121769,"_42621":121707,"_30085":196606,"_5":21646,"_28538":196449,"_5847":196607},[],"Cada dispositivo recibe su propio paquete, cifrado con su propia clave. El build resuelve primero la clave de cada dispositivo y después construye. Un dispositivo sin clave se omite, y se rechaza un lanzamiento sobre un paquete con dispositivos omitidos.",{"_6944":121770,"_42621":121707,"_30085":196609,"_5":21646,"_28538":196449,"_5847":196610},[],"`uncovered_devices` lista los dispositivos sin clave y también aquellos cuyo propio build falló. Un build en el que ningún dispositivo obtuvo paquete deja el paquete en `build_failed`.",{"_6944":121771,"_42621":121707,"_30085":196612,"_5":21646,"_28538":196456,"_5847":196613},[],"El propio hawkBit no tiene noción de módulo construido, y este servicio solo enlaza módulos construidos a un distribution set de hawkBit. Un set nunca se construye directamente: `POST .../swu` y `.../package` responden `501` en este modo. Primero se construye el módulo, en el catálogo, y el paquete se crea a partir de él. El diagrama muestra la intención `swu-build`.",{"_6944":121772,"_42621":121707,"_30085":196615,"_5":21646,"_28538":196456,"_5847":196616},[],"Las otras intenciones de entrega se saltan pasos: `swu-prebuilt` solo sube el `.swu` terminado, que es lo que construye el módulo, y `raw` solo cifra o firma los ficheros, sin swugenerator ni sw-description (firmar añade un documento de checksum `.sha256` y su firma desacoplada como artefactos extra). Un build puede firmar a través del KMS y cifrar con una clave compartida de SymKMS. El cifrado por dispositivo se rechaza en modo hawkBit. Un módulo enlazado queda congelado: para cambiarlo, edítalo y constrúyelo en el catálogo, y vuelve a enlazarlo.",{"_6944":121773,"_42621":121707,"_30085":196618,"_5":21646,"_28538":196460,"_5847":196619},[],"El dispositivo habla con hawkBit, no con este servicio. El servicio lee el progreso de hawkBit cada vez que se le pide.",{"_6944":121774,"_42621":121707,"_30085":196621,"_5":21646,"_28538":196460,"_5847":196622},[],"Un grupo canario existe solo cuando se indica `test_device_id`. hawkBit decide cuándo un grupo tiene éxito y empieza el siguiente, usando los umbrales de aprobación y de error que le dio el servicio. Con `auto` desactivado, hawkBit se pausa tras cada grupo y la siguiente llamada `rollout` libera el siguiente. La respuesta del lanzamiento también lista `superseded_devices` (dispositivos cuya actualización en curso reemplaza el nuevo rollout) y `never_seen_devices` (dispositivos que nunca han consultado, lo que puede bloquear un grupo que debe alcanzar su umbral de éxito).",{"_6944":121775,"_42621":121707,"_30085":196624,"_5":21646,"_28538":196460,"_5847":196625},[],"La llamada `rollout` depende del estado del rollout:",{"_6944":121776,"_42621":121707,"_30085":196627,"_5":21646,"_28538":196460,"_5847":196628},[],"Un rollout `ready` se inicia, y no ocurre nada mientras su hora de inicio esté en el futuro.",{"_6944":121777,"_42621":121707,"_30085":196630,"_5":21646,"_28538":196460,"_5847":196631},[],"Un rollout pausado solo se reanuda si está pausado entre lotes. Una pausa del operador necesita `resume`, y un rollout detenido por su umbral de error no se puede reanudar.",{"_6944":121778,"_42621":121707,"_30085":196633,"_5":21646,"_28538":196460,"_5847":196634},[],"Un rollout manual en ejecución libera su siguiente grupo.",{"_6944":121779,"_42621":121707,"_30085":196636,"_5":21646,"_28538":196460,"_5847":196637},[],"Un rollout `auto` que ya está en ejecución se rechaza con `400`.",{"_6944":121780,"_42621":121707,"_30085":196639,"_5":21646,"_28538":196460,"_5847":196640},[],"Un segundo `rollout` sobre el mismo lanzamiento mientras hay otro en curso responde `409`.",{"_6944":121781,"_42621":121707,"_30085":196642,"_5":21646,"_28538":196460,"_5847":196643},[],"La autenticación de dispositivos es un ajuste del tenant de hawkBit. Los tokens de seguridad de target vienen desactivados por defecto. Consulta Conectar un dispositivo.",{"_6944":121782,"_42621":121707,"_30085":196645,"_5":21646,"_28538":196464,"_5847":196646},[],"<Card title=\"Publicar y desplegar una actualización\" description=\"Recorre los flujos 1 a 4 de principio a fin.\" href=\"/docs/platform/updates/guides/publish-and-roll-out\" />",{"_6944":121783,"_42621":121707,"_30085":196648,"_5":21646,"_28538":196464,"_5847":196649},[],"<Card title=\"Modelo de datos\" description=\"Las tablas detrás de estos flujos.\" href=\"/docs/platform/updates/data-model\" />",{"_6944":121784,"_42621":121707,"_30085":196651,"_5":21646,"_28538":196464,"_5847":196652},[],"<Card title=\"Firma y cifrado\" description=\"Claves, firmas y el manifiesto.\" href=\"/docs/platform/updates/signing-and-encryption\" />",{"_6944":121785,"_42621":121785,"_5":22076,"_5847":196654,"_43101":196655,"_30085":196656,"_28538":121785},"Primeros pasos con Lamassu Updates",[78004,189200,195583,192538],[],{"_6944":121786,"_42621":121785,"_30085":196658,"_5":21646,"_28538":121785,"_5847":196659},[],"Ejecuta Lamassu Updates y sus dependencias en local con Docker Compose y comprueba que la API responde.",{"_6944":121787,"_42621":121785,"_5":43098,"_30085":196661,"_28538":196662,"_5847":187778},[],"/docs/pr-preview/pr-56/es/platform/updates/getting-started#antes-de-empezar",{"_6944":121788,"_42621":121785,"_5":43098,"_30085":196664,"_28538":196665,"_5847":196666},[],"/docs/pr-preview/pr-56/es/platform/updates/getting-started#arranca-el-stack","Arranca el stack",{"_6944":121789,"_42621":121785,"_5":43098,"_30085":196668,"_28538":196669,"_5847":196670},[],"/docs/pr-preview/pr-56/es/platform/updates/getting-started#clona-el-repositorio","Clona el repositorio",{"_6944":121790,"_42621":121785,"_5":43098,"_30085":196672,"_28538":196673,"_5847":196674},[],"/docs/pr-preview/pr-56/es/platform/updates/getting-started#indica-la-dirección-del-host","Indica la dirección del host",{"_6944":121791,"_42621":121785,"_5":43098,"_30085":196676,"_28538":196677,"_5847":196678},[],"/docs/pr-preview/pr-56/es/platform/updates/getting-started#crea-la-red-y-arranca","Crea la red y arranca",{"_6944":121792,"_42621":121785,"_5":43098,"_30085":196680,"_28538":196681,"_5847":196682},[],"/docs/pr-preview/pr-56/es/platform/updates/getting-started#servicios","Servicios",{"_6944":121793,"_42621":121785,"_5":43098,"_30085":196684,"_28538":196685,"_5847":196686},[],"/docs/pr-preview/pr-56/es/platform/updates/getting-started#verifica-la-api","Verifica la API",{"_6944":121794,"_42621":121785,"_5":43098,"_30085":196688,"_28538":196689,"_5847":196690},[],"/docs/pr-preview/pr-56/es/platform/updates/getting-started#ejecuta-sin-docker","Ejecuta sin Docker",{"_6944":121795,"_42621":121785,"_5":43098,"_30085":196692,"_28538":196693,"_5847":196694},[],"/docs/pr-preview/pr-56/es/platform/updates/getting-started#prueba-el-modo-hawkbit","Prueba el modo hawkBit",{"_6944":121796,"_42621":121785,"_5":43098,"_30085":196696,"_28538":196697,"_5847":191718},[],"/docs/pr-preview/pr-56/es/platform/updates/getting-started#solución-de-problemas",{"_6944":121797,"_42621":121785,"_5":43098,"_30085":196699,"_28538":196700,"_5847":190839},[],"/docs/pr-preview/pr-56/es/platform/updates/getting-started#siguientes-pasos",{"_6944":121798,"_42621":121785,"_30085":196702,"_5":21646,"_28538":121785,"_5847":196703},[],"Esta guía arranca Lamassu Updates (el OTA Update Service) con Docker Compose, en su modo nativo por defecto, y comprueba que la API responde. Lleva unos diez minutos más la construcción de las imágenes. Cuando funcione, continúa con Publica y lanza una actualización.",{"_6944":121799,"_42621":121785,"_30085":196705,"_5":21646,"_28538":196662,"_5847":196706},[],"Docker con el plugin Compose.",{"_6944":121800,"_42621":121785,"_30085":196708,"_5":21646,"_28538":196662,"_5847":196709},[],"Una instancia de Lamassu IoT en ejecución a la que lleguen los contenedores. El servicio lee los grupos de dispositivos y sus dispositivos desde su Device Manager (`dms_endpoint`) y firma con su KMS (`kms_endpoint`) solo cuando pides construcciones firmadas.",{"_6944":121801,"_42621":121785,"_30085":196711,"_5":21646,"_28538":196662,"_5847":196712},[],"Una copia del repositorio `ota` con los módulos `core` y `sdk` de Lamassu a su lado. `go.mod` sustituye `lamassuiot/core` y `lamassuiot/sdk` por rutas locales, y la construcción de Docker los copia desde el **directorio padre** de la copia (`context: ..` en `docker-compose.yml`), así que ese directorio debe contener `ota/` y `lamassuiot/`.",{"_6944":121802,"_42621":121785,"_30085":196714,"_5":21646,"_28538":196662,"_5847":196715},[],"Acceso a la imagen `ghcr.io/lamassuiot/wfx:otaq`, que usa el servicio `custom-wfx`.",{"_6944":121803,"_42621":121785,"_30085":196717,"_5":21646,"_28538":196662,"_5847":196718},[],"Opcional, para el modo hawkBit: un servidor hawkBit. Compose construye uno desde `docker/hawkbit`: hawkBit 1.1.0 más un plugin de artefactos S3, etiquetado en local como `lamassu/hawkbit-update-server:1.1.0-s3`. Esa imagen se construye en local y no está publicada.",{"_6944":121804,"_42621":121785,"_30085":196720,"_5":21646,"_28538":196662,"_5847":196721},[],"Opcional, para ejecutar el servicio fuera de Docker: Go 1.26.2 o superior y Python 3.8 o superior con los requisitos de `swugenerator` instalados. La imagen de Docker ya contiene el binario compilado y Python con `swugenerator`.",{"_6944":121805,"_42621":121785,"_30085":196723,"_5":21646,"_28538":196673,"_5847":196724},[],"El contenedor `updates` llega a Lamassu a través de `host.docker.internal`, que `docker-compose.yml` sustituye por `HOST_IP`. En WSL2, `host.docker.internal` apunta por defecto a la pasarela de Docker Desktop y no al host de WSL, así que indica tu propia dirección:",{"_6944":121806,"_42621":121785,"_30085":196726,"_5":21646,"_28538":196673,"_5847":196727},[],"Después comprueba que `dms_endpoint` y `kms_endpoint` de `config-docker.yml` apuntan a la API de tu Lamassu (por defecto son `http://host.docker.internal:8080/api/...`).",{"_6944":121807,"_42621":121785,"_30085":196729,"_5":21646,"_28538":196677,"_5847":196730},[],"`docker-compose.yml` se conecta a una red existente llamada `ota-net` y no arranca sin ella.",{"_6944":121808,"_42621":121785,"_30085":196732,"_5":21646,"_28538":196681,"_5847":196733},[],"Servicio",{"_6944":121809,"_42621":121785,"_30085":196735,"_5":21646,"_28538":196681,"_5847":196736},[],"Puerto del host",{"_6944":121810,"_42621":121785,"_30085":196738,"_5":21646,"_28538":196681,"_5847":196739},[],"Qué es",{"_6944":121811,"_42621":121785,"_30085":196741,"_5":21646,"_28538":196681,"_5847":87230},[],{"_6944":121812,"_42621":121785,"_30085":196743,"_5":21646,"_28538":196681,"_5847":87233},[],{"_6944":121813,"_42621":121785,"_30085":196745,"_5":21646,"_28538":196681,"_5847":196746},[],"La API de Updates, con SymKMS embebido",{"_6944":121814,"_42621":121785,"_30085":196748,"_5":21646,"_28538":196681,"_5847":87239},[],{"_6944":121815,"_42621":121785,"_30085":196750,"_5":21646,"_28538":196681,"_5847":196751},[],"`9080` (cliente), `9081` (gestión)",{"_6944":121816,"_42621":121785,"_30085":196753,"_5":21646,"_28538":196681,"_5847":196754},[],"WFX, el servidor de trabajos que los dispositivos consultan en modo nativo",{"_6944":121817,"_42621":121785,"_30085":196756,"_5":21646,"_28538":196681,"_5847":87248},[],{"_6944":121818,"_42621":121785,"_30085":196758,"_5":21646,"_28538":196681,"_5847":196759},[],"`5000` (contenedor `5432`)",{"_6944":121819,"_42621":121785,"_30085":196761,"_5":21646,"_28538":196681,"_5847":196762},[],"Base de datos. `init.sql` crea las bases `updates` y `hawkbit` en el primer arranque",{"_6944":121820,"_42621":121785,"_30085":196764,"_5":21646,"_28538":196681,"_5847":87257},[],{"_6944":121821,"_42621":121785,"_30085":196766,"_5":21646,"_28538":196681,"_5847":78461},[],{"_6944":121822,"_42621":121785,"_30085":196768,"_5":21646,"_28538":196681,"_5847":196769},[],"Un cliente de dispositivo SWUpdate de ejemplo",{"_6944":121823,"_42621":121785,"_30085":196771,"_5":21646,"_28538":196681,"_5847":87265},[],{"_6944":121824,"_42621":121785,"_30085":196773,"_5":21646,"_28538":196681,"_5847":87268},[],{"_6944":121825,"_42621":121785,"_30085":196775,"_5":21646,"_28538":196681,"_5847":196776},[],"Servidor hawkBit, solo para el modo hawkBit",{"_6944":121826,"_42621":121785,"_30085":196778,"_5":21646,"_28538":196681,"_5847":87274},[],{"_6944":121827,"_42621":121785,"_30085":196780,"_5":21646,"_28538":196681,"_5847":196781},[],"`9000` (S3), `9001` (consola)",{"_6944":121828,"_42621":121785,"_30085":196783,"_5":21646,"_28538":196681,"_5847":196784},[],"Almacén S3 local, solo con `--profile s3`",{"_6944":121829,"_42621":121785,"_30085":196786,"_5":21646,"_28538":196681,"_5847":196787},[],"`docker compose --profile s3 up -d` también arranca `rustfs` y `s3-init`, que crea el bucket cifrado `ota-updates` que pueden usar los artefactos, las construcciones y el almacenamiento de artefactos de hawkBit. Sin ese perfil, y con `config-docker.yml`, los artefactos y las construcciones se quedan en el volumen `update_files`.",{"_6944":121830,"_42621":121785,"_30085":196789,"_5":21646,"_28538":196685,"_5847":196790},[],"La segunda llamada informa del backend activo y de lo que admite. En modo nativo se parece a esto (abreviado):",{"_6944":121831,"_42621":121785,"_30085":196792,"_5":21646,"_28538":196685,"_5847":196793},[],"`supported` tiene una entrada por cada una de las 22 capacidades. Consulta Capacidades para saber qué significa cada una.",{"_6944":121832,"_42621":121785,"_30085":196795,"_5":21646,"_28538":196689,"_5847":196796},[],"Arranca el punto de entrada monolítico con un fichero de configuración. Ejecuta juntos la API de Updates y SymKMS.",{"_6944":121833,"_42621":121785,"_30085":196798,"_5":21646,"_28538":196689,"_5847":196799},[],"Si `OTA_CONFIG_FILE` no está definida, el servicio lee `/etc/lamassuiot/config.yml`.",{"_6944":121834,"_42621":121785,"_30085":196801,"_5":21646,"_28538":196689,"_5847":196802},[],"Para construir ficheros `.swu` fuera de Docker, instala `swugenerator` en el entorno de Python al que apunta la configuración (la imagen hace lo mismo desde `swugenerator/requirements.txt`):",{"_6944":121835,"_42621":121785,"_30085":196804,"_5":21646,"_28538":196689,"_5847":196805},[],"El `config.yml` de la raíz del repositorio es un punto de partida para desarrollo local, no un fichero listo para usar:",{"_6944":121836,"_42621":121785,"_30085":196807,"_5":21646,"_28538":196689,"_5847":196808},[],"Necesita Postgres (`localhost:5000`) y la API de gestión de WFX (`localhost:9081`), que proporciona `docker compose up -d postgres custom-wfx`.",{"_6944":121837,"_42621":121785,"_30085":196810,"_5":21646,"_28538":196689,"_5847":196811},[],"Contiene valores de una máquina de desarrollo concreta: rutas absolutas `/home/alvaro/...` para el almacenamiento de artefactos y de SymKMS, el script de firma y `swugenerator`, y una IP de la LAN para los endpoints de Lamassu. Edítalos con rutas que el usuario del servicio pueda crear; el servicio se detiene al arrancar si no puede crear sus directorios.",{"_6944":121838,"_42621":121785,"_30085":196813,"_5":21646,"_28538":196689,"_5847":196814},[],"Guarda artefactos y salidas de construcción en el bucket local de RustFS (`docker compose --profile s3 up -d`). Para usar disco local en su lugar, elimina los bloques `artifacts:` y `builds:`; cuando no están, los artefactos van por defecto a `{update_files_base_dir}/artifacts`.",{"_6944":121839,"_42621":121785,"_30085":196816,"_5":21646,"_28538":196693,"_5847":196817},[],"El modo hawkBit sirve la misma API sobre un servidor hawkBit real. Arranca hawkBit y Postgres, espera a que hawkBit responda y arranca el servicio con la configuración de hawkBit:",{"_6944":121840,"_42621":121785,"_30085":196819,"_5":21646,"_28538":196693,"_5847":196820},[],"`config-hawkbit.yml` también contiene rutas de una máquina de desarrollo, en los ajustes de construcción de SWU. Un servicio apuntado a un hawkBit sin dispositivos registrados construye y lanza con normalidad, pero nada descarga la actualización, porque en modo hawkBit los dispositivos consultan a hawkBit directamente. Lee el modo hawkBit antes de usarlo.",{"_6944":121841,"_42621":121785,"_30085":196822,"_5":21646,"_28538":196697,"_5847":194415},[],{"_6944":121842,"_42621":121785,"_30085":196824,"_5":21646,"_28538":196697,"_5847":196825},[],"Causa probable",{"_6944":121843,"_42621":121785,"_30085":196827,"_5":21646,"_28538":196697,"_5847":196828},[],"`docker compose up` falla por la red",{"_6944":121844,"_42621":121785,"_30085":196830,"_5":21646,"_28538":196697,"_5847":196831},[],"`ota-net` no existe. Ejecuta `docker network create ota-net`",{"_6944":121845,"_42621":121785,"_30085":196833,"_5":21646,"_28538":196697,"_5847":196834},[],"El contenedor `updates` no llega a Lamassu",{"_6944":121846,"_42621":121785,"_30085":196836,"_5":21646,"_28538":196697,"_5847":196837},[],"`HOST_IP` está vacío en `.env`, o `dms_endpoint` de `config-docker.yml` apunta a una dirección que el contenedor no alcanza",{"_6944":121847,"_42621":121785,"_30085":196839,"_5":21646,"_28538":196697,"_5847":196840},[],"`docker compose up --build` falla al copiar `lamassuiot/core`",{"_6944":121848,"_42621":121785,"_30085":196842,"_5":21646,"_28538":196697,"_5847":196843},[],"El contexto de construcción (el padre de `ota/`) no contiene `lamassuiot/`",{"_6944":121849,"_42621":121785,"_30085":196845,"_5":21646,"_28538":196697,"_5847":196846},[],"El servicio termina al arrancar cuando se ejecuta en el host",{"_6944":121850,"_42621":121785,"_30085":196848,"_5":21646,"_28538":196697,"_5847":196849},[],"Un directorio de la configuración (`update_files_base_dir`, `sym_keys_dir`) no se puede crear, o Postgres o WFX no son alcanzables en las direcciones del fichero",{"_6944":121851,"_42621":121785,"_30085":196851,"_5":21646,"_28538":196697,"_5847":196852},[],"`capabilities` responde pero los grupos de dispositivos fallan con un error del Device Manager",{"_6944":121852,"_42621":121785,"_30085":196854,"_5":21646,"_28538":196697,"_5847":196855},[],"`dms_endpoint` es incorrecto. La API de Updates lee de él los dispositivos de cada grupo",{"_6944":121853,"_42621":121785,"_30085":196857,"_5":21646,"_28538":196700,"_5847":196858},[],"<Card title=\"Publica y lanza una actualización\" href=\"/docs/platform/updates/guides/publish-and-roll-out\" description=\"Crea un paquete, constrúyelo y lánzalo a un grupo de dispositivos.\" />",{"_6944":121854,"_42621":121785,"_30085":196860,"_5":21646,"_28538":196700,"_5847":196861},[],"<Card title=\"Conecta un dispositivo\" href=\"/docs/platform/updates/guides/connect-a-device\" description=\"Qué debe hacer un dispositivo para recibir actualizaciones en cada backend.\" />",{"_6944":121855,"_42621":121785,"_30085":196863,"_5":21646,"_28538":196700,"_5847":196864},[],"<Card title=\"Referencia de configuración\" href=\"/docs/platform/updates/reference/configuration\" description=\"Cada campo de configuración y su valor por defecto.\" />",{"_6944":121856,"_42621":121856,"_5":22076,"_5847":196866,"_43101":196867,"_30085":196869,"_28538":121856},"Conecta un dispositivo",[78004,189200,195583,196868],"Guías",[],{"_6944":121857,"_42621":121856,"_30085":196871,"_5":21646,"_28538":121856,"_5847":196872},[],"Qué debe hacer un dispositivo para recibir actualizaciones de Lamassu Updates, en modo nativo y en modo hawkBit.",{"_6944":121858,"_42621":121856,"_5":43098,"_30085":196874,"_28538":196875,"_5847":187778},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#antes-de-empezar",{"_6944":121859,"_42621":121856,"_5":43098,"_30085":196877,"_28538":196878,"_5847":196879},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#modo-nativo-el-dispositivo-consulta-a-wfx","Modo nativo: el dispositivo consulta a WFX",{"_6944":121860,"_42621":121856,"_5":43098,"_30085":196881,"_28538":196882,"_5847":196883},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#el-trabajo-que-recibe-el-dispositivo","El trabajo que recibe el dispositivo",{"_6944":121861,"_42621":121856,"_5":43098,"_30085":196885,"_28538":196886,"_5847":196887},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#la-descarga","La descarga",{"_6944":121862,"_42621":121856,"_5":43098,"_30085":196889,"_28538":196890,"_5847":196891},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#los-estados-que-comunica-el-dispositivo","Los estados que comunica el dispositivo",{"_6944":121863,"_42621":121856,"_5":43098,"_30085":196893,"_28538":196894,"_5847":196895},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#modo-hawkbit-el-dispositivo-consulta-a-hawkbit","Modo hawkBit: el dispositivo consulta a hawkBit",{"_6944":121864,"_42621":121856,"_5":43098,"_30085":196897,"_28538":196898,"_5847":196899},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#haz-del-dispositivo-un-target-de-hawkbit","Haz del dispositivo un target de hawkBit",{"_6944":121865,"_42621":121856,"_5":43098,"_30085":196901,"_28538":196902,"_5847":196903},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#configura-swupdate","Configura SWUpdate",{"_6944":121866,"_42621":121856,"_5":43098,"_30085":196905,"_28538":196906,"_5847":196907},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#apunta-al-hawkbit-correcto","Apunta al hawkBit correcto",{"_6944":121867,"_42621":121856,"_5":43098,"_30085":196909,"_28538":196910,"_5847":196911},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#imágenes-firmadas-y-cifradas","Imágenes firmadas y cifradas",{"_6944":121868,"_42621":121856,"_5":43098,"_30085":196913,"_28538":196914,"_5847":195251},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#verifica-el-resultado",{"_6944":121869,"_42621":121856,"_5":43098,"_30085":196916,"_28538":196917,"_5847":191718},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#solución-de-problemas",{"_6944":121870,"_42621":121856,"_5":43098,"_30085":196919,"_28538":196920,"_5847":190839},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#siguientes-pasos",{"_6944":121871,"_42621":121856,"_30085":196922,"_5":21646,"_28538":121856,"_5847":196923},[],"Esta guía describe el contrato entre un dispositivo y Lamassu Updates, para cada backend. El software del dispositivo es SWUpdate: esta página cubre lo que el dispositivo debe enviar y recibir, no la instalación ni la configuración de SWUpdate, que describe su documentación. Úsala cuando haya un lanzamiento en marcha y ningún dispositivo avance.",{"_6944":121872,"_42621":121856,"_30085":196925,"_5":21646,"_28538":196875,"_5847":196926},[],"Un dispositivo con SWUpdate instalado y una forma de ejecutar un cliente de actualización: un agente pequeño o el módulo `suricatta` de SWUpdate.",{"_6944":121873,"_42621":121856,"_30085":196928,"_5":21646,"_28538":196875,"_5847":196929},[],"Una identidad de dispositivo: un único ID igual en todas partes. Es el ID de cliente de WFX en modo nativo y el ID de controlador de hawkBit en modo hawkBit, y debe coincidir con el ID del dispositivo en el registro de dispositivos de Lamassu (consulta Dispositivos e identidades).",{"_6944":121874,"_42621":121856,"_30085":196931,"_5":21646,"_28538":196875,"_5847":196932},[],"El dispositivo debe ser miembro de un grupo de dispositivos de Lamassu IoT, porque un paquete pertenece a un grupo y un lanzamiento apunta a los dispositivos del grupo. En modo hawkBit, la pertenencia al grupo también se lee del registro cuando `dms_endpoint` está definido.",{"_6944":121875,"_42621":121856,"_30085":196934,"_5":21646,"_28538":196875,"_5847":196935},[],"Solo modo nativo: `update_domain` debe ser una dirección que el dispositivo alcance. Consulta Configuración. En modo hawkBit los dispositivos descargan desde hawkBit.",{"_6944":121876,"_42621":121856,"_30085":196937,"_5":21646,"_28538":196878,"_5847":196938},[],"En modo nativo, un lanzamiento crea un trabajo de WFX por dispositivo. El dispositivo consulta a WFX los trabajos dirigidos a su ID, descarga el entregable de la API de Updates, lo instala y comunica cada estado a WFX. Lamassu Updates lee esos estados de WFX para conducir el lanzamiento.",{"_6944":121877,"_42621":121856,"_30085":196940,"_5":21646,"_28538":196878,"_5847":196941},[],"El dispositivo de ejemplo de `docker-compose.yml` (`swupdate-device1`) muestra la configuración mínima. Usa tres variables: `DEVICE_NAME` (su ID), `WFX_URI` (la API **cliente** de WFX, `http://custom-wfx:8080/api/wfx/v1` dentro de la red de Compose, `localhost:9080` desde el host) y `PORT`. La API de gestión de WFX, en el `9081`, es para el servicio, no para los dispositivos.",{"_6944":121878,"_42621":121856,"_30085":196943,"_5":21646,"_28538":196882,"_5847":196944},[],"El trabajo está dirigido al dispositivo (el `clientId` de WFX es el ID del dispositivo), nombra un workflow y lleva etiquetas del lanzamiento (`lms://secure-updates/<launch id>`) y del grupo (`lms://dms/<group id>`). Su definición es así:",{"_6944":121879,"_42621":121856,"_30085":196946,"_5":21646,"_28538":196882,"_5847":196084},[],{"_6944":121880,"_42621":121856,"_30085":196948,"_5":21646,"_28538":196882,"_5847":195948},[],{"_6944":121881,"_42621":121856,"_30085":196950,"_5":21646,"_28538":196882,"_5847":87447},[],{"_6944":121882,"_42621":121856,"_30085":196952,"_5":21646,"_28538":196882,"_5847":196953},[],"El tipo del paquete: `rawfile`, `firmware`, o ambos (`[\"rawfile\",\"firmware\"]`)",{"_6944":121883,"_42621":121856,"_30085":196955,"_5":21646,"_28538":196882,"_5847":87453},[],{"_6944":121884,"_42621":121856,"_30085":196957,"_5":21646,"_28538":196882,"_5847":196958},[],"Dónde descargar el entregable. El servicio añade el ID del dispositivo, así que cada dispositivo descarga su propio fichero. Un `.swu` para paquetes SWU, un `.tar.gz` para paquetes `non-swu`",{"_6944":121885,"_42621":121856,"_30085":196960,"_5":21646,"_28538":196882,"_5847":87459},[],{"_6944":121886,"_42621":121856,"_30085":196962,"_5":21646,"_28538":196882,"_5847":196963},[],"Presentes solo en un paquete cifrado: el algoritmo y, en paquetes de clave compartida, el IV o nonce en hexadecimal. Un paquete por dispositivo lleva el algoritmo pero no `iv`",{"_6944":121887,"_42621":121856,"_30085":196965,"_5":21646,"_28538":196882,"_5847":87465},[],{"_6944":121888,"_42621":121856,"_30085":196967,"_5":21646,"_28538":196882,"_5847":196968},[],"Presentes solo en un paquete firmado",{"_6944":121889,"_42621":121856,"_30085":196970,"_5":21646,"_28538":196882,"_5847":196971},[],"El dispositivo necesita la clave para descifrar, y la tiene él mismo. En un paquete por dispositivo es la clave que SymKMS asignó a ese dispositivo, y cada dispositivo descarga un fichero distinto.",{"_6944":121890,"_42621":121856,"_30085":196973,"_5":21646,"_28538":196886,"_5847":196974},[],"La descarga responde con los bytes, o con `302` a una URL firmada de corta duración cuando las descargas prefirmadas están activadas para el almacén de construcciones. Asegúrate de que el cliente HTTP del dispositivo sigue redirecciones. La ruta también responde a `HEAD` y a peticiones de rango de bytes (`206`), de modo que una descarga interrumpida puede reanudarse. La URL se fija al construir el paquete, así que un dispositivo no ve un `update_domain` nuevo hasta que reconstruyes.",{"_6944":121891,"_42621":121856,"_30085":196976,"_5":21646,"_28538":196890,"_5847":196977},[],"El dispositivo mueve su trabajo por los estados del workflow, y el workflow decide quién puede hacer cada movimiento. Para el workflow `direct`:",{"_6944":121892,"_42621":121856,"_30085":196979,"_5":21646,"_28538":196890,"_5847":196980},[],"El dispositivo comunica `INSTALLING`, `INSTALLED`, `ACTIVATING` y `ACTIVATED`. El paso `INSTALLED → ACTIVATE` lo hace el propio WFX. Desde `INSTALL`, `INSTALLING`, `ACTIVATE` y `ACTIVATING` el dispositivo puede pasar a `TERMINATED` para comunicar un fallo; `INSTALLED` no tiene transición de fallo.",{"_6944":121893,"_42621":121856,"_30085":196982,"_5":21646,"_28538":196890,"_5847":79076},[],{"_6944":121894,"_42621":121856,"_30085":196984,"_5":21646,"_28538":196890,"_5847":196985},[],"Se usa para",{"_6944":121895,"_42621":121856,"_30085":196987,"_5":21646,"_28538":196890,"_5847":196988},[],"Estados terminales",{"_6944":121896,"_42621":121856,"_30085":196990,"_5":21646,"_28538":196890,"_5847":87491},[],{"_6944":121897,"_42621":121856,"_30085":196992,"_5":21646,"_28538":196890,"_5847":196163},[],{"_6944":121898,"_42621":121856,"_30085":196994,"_5":21646,"_28538":196890,"_5847":196995},[],"`ACTIVATED` (éxito), `TERMINATED` (fallo)",{"_6944":121899,"_42621":121856,"_30085":196997,"_5":21646,"_28538":196890,"_5847":87499},[],{"_6944":121900,"_42621":121856,"_30085":196999,"_5":21646,"_28538":196890,"_5847":197000},[],"Paquetes SWU con pasos de confirmación (`CREATED → DOWNLOAD → ... → ACTIVATED`)",{"_6944":121901,"_42621":121856,"_30085":197002,"_5":21646,"_28538":196890,"_5847":87505},[],{"_6944":121902,"_42621":121856,"_30085":197004,"_5":21646,"_28538":196890,"_5847":87508},[],{"_6944":121903,"_42621":121856,"_30085":197006,"_5":21646,"_28538":196890,"_5847":197007},[],"Paquetes `non-swu`: `DOWNLOAD → ... → INSTALLED`, cada movimiento lo hace el dispositivo",{"_6944":121904,"_42621":121856,"_30085":197009,"_5":21646,"_28538":196890,"_5847":87514},[],{"_6944":121905,"_42621":121856,"_30085":197011,"_5":21646,"_28538":196890,"_5847":87517},[],{"_6944":121906,"_42621":121856,"_30085":197013,"_5":21646,"_28538":196890,"_5847":197014},[],"Mínimo `DOWNLOAD → INSTALL → INSTALLED`",{"_6944":121907,"_42621":121856,"_30085":197016,"_5":21646,"_28538":196890,"_5847":87514},[],{"_6944":121908,"_42621":121856,"_30085":197018,"_5":21646,"_28538":196890,"_5847":197019},[],"Un trabajo `phased` tiene movimientos que hace WFX o un operador, y nada en Lamassu Updates los avanza: se queda en `CREATED` hasta que alguien lo confirma a través de WFX (el botón **Next** del dashboard lo hace). Los endpoints `force-version` y `sync-to-latest` usan `phased` para los paquetes SWU salvo que indiques un `workflow`. Los ficheros de workflow están en `wfx/workflow/dau/` del repositorio. La API HTTP de WFX (listar trabajos, actualizar estado) la documenta WFX.",{"_6944":121909,"_42621":121856,"_30085":197021,"_5":21646,"_28538":196894,"_5847":197022},[],"En modo hawkBit los dispositivos no consultan a Lamassu Updates. Consultan la API DDI de hawkBit, y Lamassu Updates lee de hawkBit el estado resultante de las acciones.",{"_6944":121910,"_42621":121856,"_30085":197024,"_5":21646,"_28538":196898,"_5847":197025},[],"El dispositivo necesita un ID de controlador y un target etiquetado `group:<id>` para su grupo. Con `dms_endpoint` definido, el servicio lo hace por sí mismo: cuando lee del registro los dispositivos de un grupo, crea los targets que faltan y los etiqueta. Sin `dms_endpoint`, creas tú los targets y las etiquetas. En ambos casos el dispositivo debe consultar a hawkBit con credenciales válidas.",{"_6944":121911,"_42621":121856,"_30085":197027,"_5":21646,"_28538":196902,"_5847":197028},[],"Apunta el SWUpdate del dispositivo (`suricatta`) a la URL de hawkBit (`hawkbit.ddi_url`, que por defecto es `hawkbit.base_url`), con el tenant, el ID de controlador y un método de autenticación que acepte tu tenant de hawkBit. hawkBit rechaza por defecto a los dispositivos sin autenticar. Con tokens de seguridad de target, actívalos para el tenant (`PUT /rest/v1/system/configs/authentication.targettoken.enabled` con `{\"value\":true}`) y entrega a cada dispositivo el `securityToken` de su target, que envía como `Authorization: TargetToken <token>`. La guía curl de hawkBit muestra cada petición.",{"_6944":121912,"_42621":121856,"_30085":197030,"_5":21646,"_28538":196906,"_5847":197031},[],"El dispositivo debe consultar el **mismo hawkBit** para el que está configurado el servicio. Un servicio apuntado a un hawkBit sin targets construye y lanza sin error, y nada lo descarga. Consulta Solución de problemas.",{"_6944":121913,"_42621":121856,"_30085":197033,"_5":21646,"_28538":196906,"_5847":197034},[],"hawkBit entrega entonces al dispositivo todos los artefactos de su conjunto de distribución. Un paquete con varios módulos ejecuta varias instalaciones independientes.",{"_6944":121914,"_42621":121856,"_30085":197036,"_5":21646,"_28538":196906,"_5847":197037},[],"Cuando tu pasarela enruta las URL de artefactos de dispositivo de hawkBit (la ruta de `hawkbit.ddi_url`, `.../<tenant>/controller/v1/<controller>/softwaremodules/<id>/artifacts/<file>`) hacia Lamassu Updates, el servicio las sirve solo para módulos asignados o instalados en ese controlador, y responde `404` en los demás casos. Con las descargas prefirmadas activadas, redirige a una URL firmada del bucket S3 de hawkBit en lugar de transmitir el fichero.",{"_6944":121915,"_42621":121856,"_30085":197039,"_5":21646,"_28538":196910,"_5847":197040},[],"Si el dispositivo verifica firmas, define su clave pública (`public-key-file` en la configuración de SWUpdate) y firma el paquete con la clave correspondiente. Si descifra, necesita la misma clave y el mismo algoritmo con que se construyó el paquete. Una discrepancia es la causa habitual de que una instalación falle en silencio tras una descarga correcta. Firma y cifrado explica qué clave, algoritmo e IV usa cada modo y qué recibe el dispositivo.",{"_6944":121916,"_42621":121856,"_30085":197042,"_5":21646,"_28538":196914,"_5847":197043},[],"Tras un lanzamiento, el trabajo del dispositivo llega a `ACTIVATED` (o a `INSTALLED` en un paquete `non-swu`), los contadores del lanzamiento se actualizan y el inventario del dispositivo lista el paquete:",{"_6944":121917,"_42621":121856,"_30085":197045,"_5":21646,"_28538":196914,"_5847":197046},[],"Consulta Publica y lanza una actualización para el resto de comprobaciones.",{"_6944":121918,"_42621":121856,"_30085":197048,"_5":21646,"_28538":196917,"_5847":194415},[],{"_6944":121919,"_42621":121856,"_30085":197050,"_5":21646,"_28538":196917,"_5847":196825},[],{"_6944":121920,"_42621":121856,"_30085":197052,"_5":21646,"_28538":196917,"_5847":197053},[],"El dispositivo nunca ve un trabajo (nativo)",{"_6944":121921,"_42621":121856,"_30085":197055,"_5":21646,"_28538":196917,"_5847":197056},[],"Consulta un endpoint de WFX equivocado o usa un ID distinto del miembro del grupo. El `clientId` de WFX debe coincidir con el ID del dispositivo",{"_6944":121922,"_42621":121856,"_30085":197058,"_5":21646,"_28538":196917,"_5847":197059},[],"El trabajo se queda en `CREATED`",{"_6944":121923,"_42621":121856,"_30085":197061,"_5":21646,"_28538":196917,"_5847":197062},[],"El lanzamiento usa `phased`. Confírmalo a través de WFX o del dashboard, o vuelve a lanzar con `direct`",{"_6944":121924,"_42621":121856,"_30085":197064,"_5":21646,"_28538":196917,"_5847":197065},[],"La descarga falla con `404`",{"_6944":121925,"_42621":121856,"_30085":197067,"_5":21646,"_28538":196917,"_5847":197068},[],"El paquete está cifrado por dispositivo y el dispositivo no tiene clave, o la URL nombra a otro dispositivo. Revisa la cobertura del paquete y que la URL termine con el ID de este dispositivo",{"_6944":121926,"_42621":121856,"_30085":197070,"_5":21646,"_28538":196917,"_5847":197071},[],"La descarga termina bien y la instalación falla",{"_6944":121927,"_42621":121856,"_30085":197073,"_5":21646,"_28538":196917,"_5847":197074},[],"La firma o la clave no coinciden con lo que tiene el dispositivo. Consulta Firma y cifrado",{"_6944":121928,"_42621":121856,"_30085":197076,"_5":21646,"_28538":196917,"_5847":197077},[],"Un lanzamiento `non-swu` parece atascado aunque el dispositivo terminó",{"_6944":121929,"_42621":121856,"_30085":197079,"_5":21646,"_28538":196917,"_5847":197080},[],"Se lanzó con `direct` o `phased`, que esperan `ACTIVATED`. Lanza los paquetes `non-swu` con `download-install`",{"_6944":121930,"_42621":121856,"_30085":197082,"_5":21646,"_28538":196917,"_5847":197083},[],"El lanzamiento nunca avanza (hawkBit)",{"_6944":121931,"_42621":121856,"_30085":197085,"_5":21646,"_28538":196917,"_5847":197086},[],"El dispositivo no consulta este hawkBit, no está etiquetado en el grupo o no puede autenticarse",{"_6944":121932,"_42621":121856,"_30085":197088,"_5":21646,"_28538":196920,"_5847":197089},[],"<Card title=\"Firma y cifrado\" href=\"/docs/platform/updates/signing-and-encryption\" description=\"Claves, algoritmos y qué debe tener el dispositivo.\" />",{"_6944":121933,"_42621":121856,"_30085":197091,"_5":21646,"_28538":196920,"_5847":197092},[],"<Card title=\"Modo hawkBit\" href=\"/docs/platform/updates/hawkbit-mode\" description=\"Cómo el adaptador traduce paquetes y campañas a hawkBit.\" />",{"_6944":121934,"_42621":121856,"_30085":197094,"_5":21646,"_28538":196920,"_5847":197095},[],"<Card title=\"Solución de problemas\" href=\"/docs/platform/updates/troubleshooting\" description=\"Actualizaciones que no llegan a los dispositivos y otros fallos.\" />",{"_6944":121935,"_42621":121935,"_5":22076,"_5847":197097,"_43101":197098,"_30085":197099,"_28538":121935},"Usa el dashboard",[78004,189200,195583,196868],[],{"_6944":121936,"_42621":121935,"_30085":197101,"_5":21646,"_28538":121935,"_5847":197102},[],"Publica, lanza y sigue una actualización desde el dashboard de Lamassu, pantalla a pantalla.",{"_6944":121937,"_42621":121935,"_5":43098,"_30085":197104,"_28538":197105,"_5847":187778},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#antes-de-empezar",{"_6944":121938,"_42621":121935,"_5":43098,"_30085":197107,"_28538":197108,"_5847":197109},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#conéctalo-al-servicio","Conéctalo al servicio",{"_6944":121939,"_42621":121935,"_5":43098,"_30085":197111,"_28538":197112,"_5847":197113},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#dónde-está-cada-cosa","Dónde está cada cosa",{"_6944":121940,"_42621":121935,"_5":43098,"_30085":197115,"_28538":197116,"_5847":197117},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#1-crea-un-distribution-set","1\\. Crea un distribution set",{"_6944":121941,"_42621":121935,"_5":43098,"_30085":197119,"_28538":197120,"_5847":197121},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#2-añade-ficheros-y-construye-nativo","2\\. Añade ficheros y construye (nativo)",{"_6944":121942,"_42621":121935,"_5":43098,"_30085":197123,"_28538":197124,"_5847":197125},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#hawkbit-construye-primero-un-módulo","hawkBit: construye primero un módulo",{"_6944":121943,"_42621":121935,"_5":43098,"_30085":197127,"_28538":197128,"_5847":197129},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#3-inicia-una-campaña","3\\. Inicia una campaña",{"_6944":121944,"_42621":121935,"_5":43098,"_30085":197131,"_28538":197132,"_5847":197133},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#4-ejecuta-y-vigila-la-campaña","4\\. Ejecuta y vigila la campaña",{"_6944":121945,"_42621":121935,"_5":43098,"_30085":197135,"_28538":197136,"_5847":197137},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#5-sigue-los-dispositivos","5\\. Sigue los dispositivos",{"_6944":121946,"_42621":121935,"_5":43098,"_30085":197139,"_28538":197140,"_5847":197141},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#qué-cambia-según-el-backend","Qué cambia según el backend",{"_6944":121947,"_42621":121935,"_5":43098,"_30085":197143,"_28538":197144,"_5847":197145},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#lo-que-no-está-en-el-dashboard","Lo que no está en el dashboard",{"_6944":121948,"_42621":121935,"_5":43098,"_30085":197147,"_28538":197148,"_5847":191718},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#solución-de-problemas",{"_6944":121949,"_42621":121935,"_5":43098,"_30085":197150,"_28538":197151,"_5847":190839},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#siguientes-pasos",{"_6944":121950,"_42621":121935,"_30085":197153,"_5":21646,"_28538":121935,"_5847":197154},[],"El dashboard de Lamassu es la interfaz web de la API de Updates. Esta guía sigue la misma actualización que las guías curl (nativa y hawkBit) a través de las pantallas. Los nombres en negrita son las etiquetas que muestra el dashboard.",{"_6944":121951,"_42621":121935,"_30085":197156,"_5":21646,"_28538":121935,"_5847":197157},[],"El dashboard es un proyecto aparte (`lamassu-dashboard`). Esta guía lo describe a partir de su código fuente y no tiene capturas, así que una etiqueta puede diferir en una versión más reciente. El dashboard no tiene traducciones: sus etiquetas están en inglés, y aquí se mantienen tal cual.",{"_6944":121952,"_42621":121935,"_30085":197159,"_5":21646,"_28538":197105,"_5847":197160},[],"Lamassu Updates está en marcha y el dashboard puede alcanzarlo. Consulta Conéctalo al servicio.",{"_6944":121953,"_42621":121935,"_30085":197162,"_5":21646,"_28538":197105,"_5847":197163},[],"Un **grupo de dispositivos** de Lamassu IoT que contenga los dispositivos que vas a actualizar (**Device Groups** dentro de **IoT**). Los miembros de un grupo son los dispositivos que cumplen sus criterios.",{"_6944":121954,"_42621":121935,"_30085":197165,"_5":21646,"_28538":197105,"_5847":197166},[],"Para una construcción SWU con firma o cifrado: una clave de firma en **Asymmetric Keys** o una clave simétrica en **Symmetric Keys** (ambas en **KMS**) y, para el cifrado por dispositivo, claves asignadas a los dispositivos en **Device Key Inventory** (en **IoT**).",{"_6944":121955,"_42621":121935,"_30085":197168,"_5":21646,"_28538":197108,"_5847":197169},[],"El dashboard habla con la API de Updates en la dirección indicada en `LAMASSU_UPDATES_API`, en su `public/config.js`. En la imagen de contenedor procede de la variable de entorno del mismo nombre.",{"_6944":121956,"_42621":121935,"_30085":197171,"_5":21646,"_28538":197108,"_5847":197172},[],"El dashboard le añade `/updates/v1` y `/symkms/v1`. Se acepta y se elimina un `/updates/v1` final.",{"_6944":121957,"_42621":121935,"_30085":197174,"_5":21646,"_28538":197108,"_5847":197175},[],"Si está vacía, el dashboard usa `LAMASSU_API`.",{"_6944":121958,"_42621":121935,"_30085":197177,"_5":21646,"_28538":197108,"_5847":197178},[],"Cuando la autenticación está activada, cada llamada lleva el bearer token del usuario. El servicio lo ignora, así que pon delante una pasarela que lo compruebe. Consulta Seguridad.",{"_6944":121959,"_42621":121935,"_30085":197180,"_5":21646,"_28538":197108,"_5847":197181},[],"Debe apuntar a la instancia del servicio que ejecuta el backend que quieres usar. Un servicio ejecuta modo nativo o modo hawkBit, nunca los dos: para usar ambos a la vez ejecutas dos instancias, cada una en su puerto, y apuntas el dashboard a una de ellas.",{"_6944":121960,"_42621":121935,"_30085":197183,"_5":21646,"_28538":197108,"_5847":197184},[],"El dashboard lee `GET /updates/v1/capabilities` una vez, después de iniciar sesión, y oculta lo que el backend no puede hacer. Por eso las mismas pantallas se ven distintas en modo nativo y en modo hawkBit. Qué cambia según el backend enumera las diferencias. Si la petición de capacidades falla, el dashboard asume que todo está admitido y no oculta nada.",{"_6944":121961,"_42621":121935,"_30085":197186,"_5":21646,"_28538":197108,"_5847":197187},[],"Para comparar ambos backends, el menú de usuario tiene un selector **Updates backend** con las opciones **Auto**, **native** y **hawkbit**. Aparece solo en compilaciones de desarrollo, o cuando el contenedor del dashboard se ejecuta con `DEV_OPTIONS_ENABLED=true`. Elegir native o hawkbit sustituye `LAMASSU_UPDATES_API` en ese navegador, muestra un campo editable **Updates API base URL** y recarga la página. Los valores por defecto son `http://localhost:10090` (native) y `http://localhost:10091` (hawkbit) en localhost, y `<origin>/api` y `<origin>/api/hawkbit` en cualquier otro host.",{"_6944":121962,"_42621":121935,"_30085":197189,"_5":21646,"_28538":197112,"_5847":197190},[],"El grupo de la barra lateral **OTA UPDATES MANAGER** tiene:",{"_6944":121963,"_42621":121935,"_30085":197192,"_5":21646,"_28538":197112,"_5847":197193},[],"Elemento",{"_6944":121964,"_42621":121935,"_30085":197195,"_5":21646,"_28538":197112,"_5847":197196},[],"Ruta",{"_6944":121965,"_42621":121935,"_30085":197198,"_5":21646,"_28538":197112,"_5847":196739},[],{"_6944":121966,"_42621":121935,"_30085":197200,"_5":21646,"_28538":197112,"_5847":87707},[],{"_6944":121967,"_42621":121935,"_30085":197202,"_5":21646,"_28538":197112,"_5847":87710},[],{"_6944":121968,"_42621":121935,"_30085":197204,"_5":21646,"_28538":197112,"_5847":197205},[],"Título de página **OTA Dashboard**: salud de los lanzamientos, campañas que requieren atención, distribución de versiones y próxima planificación",{"_6944":121969,"_42621":121935,"_30085":197207,"_5":21646,"_28538":197112,"_5847":87716},[],{"_6944":121970,"_42621":121935,"_30085":197209,"_5":21646,"_28538":197112,"_5847":87719},[],{"_6944":121971,"_42621":121935,"_30085":197211,"_5":21646,"_28538":197112,"_5847":197212},[],"Todos los dispositivos con su versión instalada y su versión objetivo",{"_6944":121972,"_42621":121935,"_30085":197214,"_5":21646,"_28538":197112,"_5847":87725},[],{"_6944":121973,"_42621":121935,"_30085":197216,"_5":21646,"_28538":197112,"_5847":87728},[],{"_6944":121974,"_42621":121935,"_30085":197218,"_5":21646,"_28538":197112,"_5847":197219},[],"Grupos, con cuántos dispositivos van retrasados",{"_6944":121975,"_42621":121935,"_30085":197221,"_5":21646,"_28538":197112,"_5847":87734},[],{"_6944":121976,"_42621":121935,"_30085":197223,"_5":21646,"_28538":197112,"_5847":87737},[],{"_6944":121977,"_42621":121935,"_30085":197225,"_5":21646,"_28538":197112,"_5847":197226},[],"Los paquetes de actualización de todos los grupos",{"_6944":121978,"_42621":121935,"_30085":197228,"_5":21646,"_28538":197112,"_5847":87743},[],{"_6944":121979,"_42621":121935,"_30085":197230,"_5":21646,"_28538":197112,"_5847":87746},[],{"_6944":121980,"_42621":121935,"_30085":197232,"_5":21646,"_28538":197112,"_5847":197233},[],"El catálogo de módulos",{"_6944":121981,"_42621":121935,"_30085":197235,"_5":21646,"_28538":197112,"_5847":87752},[],{"_6944":121982,"_42621":121935,"_30085":197237,"_5":21646,"_28538":197112,"_5847":87755},[],{"_6944":121983,"_42621":121935,"_30085":197239,"_5":21646,"_28538":197112,"_5847":197240},[],"Lanzamientos: lista, creación, ejecución",{"_6944":121984,"_42621":121935,"_30085":197242,"_5":21646,"_28538":197112,"_5847":197243},[],"El grupo **IoT** tiene **Devices**, **Device Groups** (el registro de dispositivos de Lamassu y sus grupos), **Device Key Inventory** y **Platform Integrations**. El grupo **JOB MANAGER** (**Jobs**, **Workflows**) lista trabajos y workflows de WFX en bruto. No usa la API de Updates y no crea lanzamientos.",{"_6944":121985,"_42621":121935,"_30085":197245,"_5":21646,"_28538":197112,"_5847":197246},[],"En el dashboard, un paquete es un **distribution set** y un lanzamiento es una **campaign**.",{"_6944":121986,"_42621":121935,"_30085":197248,"_5":21646,"_28538":197116,"_5847":197249},[],"Abre **Distribution Set**. La lista muestra los paquetes de todos los grupos, con filtros de grupo de dispositivos y de estado, un cuadro de búsqueda y un botón **Refresh**. Pulsa **New Distribution Set**.",{"_6944":121987,"_42621":121935,"_30085":197251,"_5":21646,"_28538":197116,"_5847":196084},[],{"_6944":121988,"_42621":121935,"_30085":197253,"_5":21646,"_28538":197116,"_5847":197254},[],"Notas",{"_6944":121989,"_42621":121935,"_30085":197256,"_5":21646,"_28538":197116,"_5847":87775},[],{"_6944":121990,"_42621":121935,"_30085":197258,"_5":21646,"_28538":197116,"_5847":197259},[],"Al menos 3 caracteres, sin espacios. Usa guiones bajos. El modo nativo, además, solo acepta letras, dígitos, `.`, `_` y `-`",{"_6944":121991,"_42621":121935,"_30085":197261,"_5":21646,"_28538":197116,"_5847":87781},[],{"_6944":121992,"_42621":121935,"_30085":197263,"_5":21646,"_28538":197116,"_5847":197264},[],"Semver, por defecto `1.0.0`",{"_6944":121993,"_42621":121935,"_30085":197266,"_5":21646,"_28538":197116,"_5847":87787},[],{"_6944":121994,"_42621":121935,"_30085":197268,"_5":21646,"_28538":197116,"_5847":197269},[],"Obligatorio. Un paquete pertenece a un grupo y solo se puede lanzar a sus dispositivos",{"_6944":121995,"_42621":121935,"_30085":197271,"_5":21646,"_28538":197116,"_5847":87793},[],{"_6944":121996,"_42621":121935,"_30085":197273,"_5":21646,"_28538":197116,"_5847":197274},[],"**Raw File** (sin reinicio), **Firmware** (con reinicio), **Both** u **Other Type**",{"_6944":121997,"_42621":121935,"_30085":197276,"_5":21646,"_28538":197116,"_5847":87799},[],{"_6944":121998,"_42621":121935,"_30085":197278,"_5":21646,"_28538":197116,"_5847":197279},[],"Nativo: **SWU** construye una imagen firmada (la firma es opcional), **Generic** entrega los ficheros tal cual. hawkBit: **SWU** acepta solo módulos SWU, **Generic** acepta binarios y otros ficheros. No se puede cambiar tras crear el paquete",{"_6944":121999,"_42621":121935,"_30085":197281,"_5":21646,"_28538":197116,"_5847":87805},[],{"_6944":122000,"_42621":121935,"_30085":197283,"_5":21646,"_28538":197116,"_5847":197284},[],"Permite que los dispositivos descarguen versiones anteriores de este paquete",{"_6944":122001,"_42621":121935,"_30085":197286,"_5":21646,"_28538":197116,"_5847":87811},[],{"_6944":122002,"_42621":121935,"_30085":197288,"_5":21646,"_28538":197116,"_5847":197289},[],"Precondiciones de lanzamiento opcionales (plegado): los dispositivos ya deben tener otro distribution set, o un módulo de software, en una versión mínima",{"_6944":122003,"_42621":121935,"_30085":197291,"_5":21646,"_28538":197116,"_5847":197292},[],"Pulsa **Create Distribution Set**. Llegas a la página del paquete. Las precondiciones siguen siendo editables allí, en **Launch Preconditions** de la pestaña **Overview** (**Save preconditions**).",{"_6944":122004,"_42621":121935,"_30085":197294,"_5":21646,"_28538":197116,"_5847":197295},[],"En modo hawkBit el formulario tiene una sección más, **Software modules**. Un conjunto de hawkBit enlaza módulos construidos, así que marca al menos un módulo construido, y como mucho un módulo OS. La tabla lista solo los módulos que encajan con el **Driver**: un conjunto SWU oculta los módulos entregados como ficheros en bruto, y uno Generic oculta los módulos entregados como SWU prefabricado. Si no encaja ninguno, dice «No built module fits this driver», y primero construyes uno (consulta hawkBit: construye primero un módulo).",{"_6944":122005,"_42621":121935,"_30085":197297,"_5":21646,"_28538":197116,"_5847":197298},[],"En el backend nativo, el **Driver** decide además qué workflow puede instalar el paquete: los paquetes SWU necesitan **Direct** o **Phased** y los Generic necesitan **Download-Install**. Una discrepancia deja la actualización pareciendo atascada cuando el dispositivo ya terminó.",{"_6944":122006,"_42621":121935,"_30085":197300,"_5":21646,"_28538":197120,"_5847":197301},[],"En la página del paquete (`/updates/pack-details`) abre la pestaña **Software Modules**. Un paquete nativo empieza con un módulo OS con el nombre del paquete («Not composed»). Abre el menú de su fila y elige **Add files**, suelta tu fichero y súbelo. El nombre del artefacto es por defecto el del fichero sin su extensión, y la versión es opcional (semver). Para componer el paquete con más módulos, usa **Add module** (un módulo de aplicación nuevo) o **Import module** (copia uno existente); el paquete sigue construyendo un único SWU.",{"_6944":122007,"_42621":121935,"_30085":197303,"_5":21646,"_28538":197120,"_5847":197304},[],"Después pulsa **Generate SWU** en la cabecera. La hoja **SWU deliverable** tiene dos pestañas.",{"_6944":122008,"_42621":121935,"_30085":197306,"_5":21646,"_28538":197120,"_5847":197307},[],"**Build here** construye el paquete a partir de los artefactos del paquete:",{"_6944":122009,"_42621":121935,"_30085":197309,"_5":21646,"_28538":197120,"_5847":190991},[],{"_6944":122010,"_42621":121935,"_30085":197311,"_5":21646,"_28538":197120,"_5847":197312},[],"Qué hacer",{"_6944":122011,"_42621":121935,"_30085":197314,"_5":21646,"_28538":197120,"_5847":87840},[],{"_6944":122012,"_42621":121935,"_30085":197316,"_5":21646,"_28538":197120,"_5847":197317},[],"Casillas, todas marcadas por defecto",{"_6944":122013,"_42621":121935,"_30085":197319,"_5":21646,"_28538":197120,"_5847":87846},[],{"_6944":122014,"_42621":121935,"_30085":197321,"_5":21646,"_28538":197120,"_5847":197322},[],"Obligatorio. Carga el fichero o escríbelo en el editor. Una lista de comprobación muestra cada fichero que declara la descripción, y un fichero declarado pero no seleccionado bloquea la construcción",{"_6944":122015,"_42621":121935,"_30085":197324,"_5":21646,"_28538":197120,"_5847":87852},[],{"_6944":122016,"_42621":121935,"_30085":197326,"_5":21646,"_28538":197120,"_5847":197327},[],"**Signing key**: ninguna (sin firmar) o una clave del KMS. Con una clave, elige un **Method** y un **Certificate**",{"_6944":122017,"_42621":121935,"_30085":197329,"_5":21646,"_28538":197120,"_5847":87858},[],{"_6944":122018,"_42621":121935,"_30085":197331,"_5":21646,"_28538":197120,"_5847":197332},[],"Ninguno, &#x2A;*Shared (one key for all devices)** o &#x2A;*Per-device (key per device)**",{"_6944":122019,"_42621":121935,"_30085":197334,"_5":21646,"_28538":197120,"_5847":197335},[],"Para el cifrado compartido elige una **Symmetric key** y si cifrar el descriptor (**Encrypt the descriptor**) y todos los ficheros (**Encrypt all files**), o marca ficheros individuales. Para el cifrado por dispositivo elige un **Algorithm** (por defecto `Ascon-128a`). Cada dispositivo usa entonces su propia clave del inventario de claves de dispositivo. Si no eliges ninguna seguridad, la hoja dice «No security selected».",{"_6944":122020,"_42621":121935,"_30085":197337,"_5":21646,"_28538":197120,"_5847":197338},[],"Pulsa **Generate SWU**. La hoja sube el sw-description y después construye. La insignia pasa a **Built** y el botón de la cabecera pasa a decir **Regenerate SWU**. Junto a él aparece **Download SWU**, salvo en un paquete por dispositivo: no hay descarga del conjunto completo, y el paquete de cada dispositivo se descarga por dispositivo.",{"_6944":122021,"_42621":121935,"_30085":197340,"_5":21646,"_28538":197120,"_5847":197341},[],"**Upload pre-built** adjunta un `.swu` que construiste por tu cuenta, hasta el `max_artifact_size_mb` del servicio (10 GiB por defecto). Se guarda y se sirve sin cambios, no se firma ni se cifra nada por ti, y la versión pasa a estar construida e inmutable.",{"_6944":122022,"_42621":121935,"_30085":197343,"_5":21646,"_28538":197120,"_5847":197344},[],"Un paquete **non-swu** tiene **Generate Package** en su lugar. Construye un `.tar.gz` con los artefactos seleccionados, con firma opcional y cifrado compartido o por dispositivo opcional (el cifrado es AES-GCM), y también tiene una pestaña **Upload pre-built**. **Download Package** descarga el resultado.",{"_6944":122023,"_42621":121935,"_30085":197346,"_5":21646,"_28538":197120,"_5847":197347},[],"Para cambiar un paquete construido, crea una versión nueva: usa **New Version** en el menú de fila de la lista de paquetes (el diálogo tiene **Create Version**), o **New Version to Edit** en la pestaña **Artifacts** del paquete. La versión nueva debe ser mayor que la actual, y borra el paquete construido.",{"_6944":122024,"_42621":121935,"_30085":197349,"_5":21646,"_28538":197124,"_5847":197350},[],"En modo hawkBit, los ficheros de un paquete viven en módulos, construidos en el catálogo.",{"_6944":122025,"_42621":121935,"_30085":197352,"_5":21646,"_28538":197124,"_5847":197353},[],"Abre **Software Modules** y pulsa **New module**. Rellena **Module name** (no puede contener `/` ni `:`), **Type** (**Application** u **OS / base image**), **Version**, el **Distribution set** (deja **Catalog only — no set** para enlazarlo más tarde) y el **Delivery intent**:",{"_6944":122026,"_42621":121935,"_30085":197355,"_5":21646,"_28538":197124,"_5847":87885},[],{"_6944":122027,"_42621":121935,"_30085":197357,"_5":21646,"_28538":197124,"_5847":197358},[],"Significa",{"_6944":122028,"_42621":121935,"_30085":197360,"_5":21646,"_28538":197124,"_5847":87891},[],{"_6944":122029,"_42621":121935,"_30085":197362,"_5":21646,"_28538":197124,"_5847":197363},[],"Aportas ficheros y un sw-description, y el servicio construye un `.swu`",{"_6944":122030,"_42621":121935,"_30085":197365,"_5":21646,"_28538":197124,"_5847":87897},[],{"_6944":122031,"_42621":121935,"_30085":197367,"_5":21646,"_28538":197124,"_5847":197368},[],"Subes un `.swu` terminado",{"_6944":122032,"_42621":121935,"_30085":197370,"_5":21646,"_28538":197124,"_5847":87903},[],{"_6944":122033,"_42621":121935,"_30085":197372,"_5":21646,"_28538":197124,"_5847":197373},[],"Los ficheros se entregan tal cual, y el módulo cuenta como construido tras un paso de construcción que puede cifrarlos y firmarlos de forma opcional",{"_6944":122034,"_42621":121935,"_30085":197375,"_5":21646,"_28538":197124,"_5847":87909},[],{"_6944":122035,"_42621":121935,"_30085":197377,"_5":21646,"_28538":197124,"_5847":197378},[],"Aún no se puede usar",{"_6944":122036,"_42621":121935,"_30085":197380,"_5":21646,"_28538":197124,"_5847":197381},[],"Añade los ficheros y, para **Build SWU from inputs**, el sw-description. Las tarjetas de seguridad ofrecen firma y cifrado compartido. Para **Build SWU from inputs**, el interruptor **Build this module now** está activado por defecto: desactívalo para guardar solo los ficheros y construir más tarde desde el menú de fila **Files and build**. Para **Upload prebuilt SWU** no hay interruptor: el módulo queda construido en cuanto se guarda el `.swu`. Para **Deliver files unchanged** el interruptor es **Build now**.",{"_6944":122037,"_42621":121935,"_30085":197383,"_5":21646,"_28538":197124,"_5847":197384},[],"Pulsa **Create Module**.",{"_6944":122038,"_42621":121935,"_30085":197386,"_5":21646,"_28538":197124,"_5847":197387},[],"Crea el distribution set y marca el módulo construido.",{"_6944":122039,"_42621":121935,"_30085":197389,"_5":21646,"_28538":197124,"_5847":197390},[],"Un módulo enlazado a un conjunto queda congelado. Desenlázalo para cambiarlo, o añade una versión nueva desde **Upgrade to a new version** en el menú de su fila del catálogo. Consulta Modo hawkBit.",{"_6944":122040,"_42621":121935,"_30085":197392,"_5":21646,"_28538":197124,"_5847":197393},[],"El catálogo también funciona en el backend nativo: lista los módulos de todos los paquetes, y **New module** puede dejar un módulo en **Catalog only — no set** hasta que lo añadas a un paquete con **Import module**. La importación nativa copia el módulo, mientras que el enlace de hawkBit lo comparte.",{"_6944":122041,"_42621":121935,"_30085":197395,"_5":21646,"_28538":197128,"_5847":197396},[],"Pulsa **Start Campaign** en el menú de fila del paquete en **Distribution Set** (habilitado una vez construido el paquete), o **New Campaign** en la página **Campaigns**. El formulario, **Create campaign**, está en `/updates/new`.",{"_6944":122042,"_42621":121935,"_30085":197398,"_5":21646,"_28538":197128,"_5847":197399},[],"Sección",{"_6944":122043,"_42621":121935,"_30085":197401,"_5":21646,"_28538":197128,"_5847":197402},[],"Campos",{"_6944":122044,"_42621":121935,"_30085":197404,"_5":21646,"_28538":197128,"_5847":87938},[],{"_6944":122045,"_42621":121935,"_30085":197406,"_5":21646,"_28538":197128,"_5847":197407},[],"**Campaign name (optional)**, **Distribution set**. **Device group** y **Driver** se heredan y son de solo lectura. **Workflow**: en nativo, todos los workflows de WFX registrados (Direct, Phased, Download-Install...), con un aviso cuando no encaja con el driver. En hawkBit el campo es **Install mode**: **Forced** (el dispositivo instala en cuanto consulta) o **Soft** (el dispositivo puede confirmar o posponer)",{"_6944":122046,"_42621":121935,"_30085":197409,"_5":21646,"_28538":197128,"_5847":87944},[],{"_6944":122047,"_42621":121935,"_30085":197411,"_5":21646,"_28538":197128,"_5847":197412},[],"**Start as soon as it is executed** o **Start at a planned time** (fecha y hora, en la zona horaria de tu navegador)",{"_6944":122048,"_42621":121935,"_30085":197414,"_5":21646,"_28538":197128,"_5847":87950},[],{"_6944":122049,"_42621":121935,"_30085":197416,"_5":21646,"_28538":197128,"_5847":197417},[],"**Batch mode** (**Fixed count** o **Percentage**), el tamaño o porcentaje del lote y el interruptor **Auto rollout**",{"_6944":122050,"_42621":121935,"_30085":197419,"_5":21646,"_28538":197128,"_5847":87956},[],{"_6944":122051,"_42621":121935,"_30085":197421,"_5":21646,"_28538":197128,"_5847":197422},[],"Solo con Auto rollout activado: **Approval threshold** (%) y **Error threshold** (%)",{"_6944":122052,"_42621":121935,"_30085":197424,"_5":21646,"_28538":197128,"_5847":87962},[],{"_6944":122053,"_42621":121935,"_30085":197426,"_5":21646,"_28538":197128,"_5847":197427},[],"**Test device** (el canario, que se actualiza primero), las **Preconditions** del conjunto (solo lectura), **Notes**, **Weight**",{"_6944":122054,"_42621":121935,"_30085":197429,"_5":21646,"_28538":197128,"_5847":197430},[],"No hay selector de dispositivos. Una campaña apunta a todos los dispositivos del grupo del paquete, y el panel **Campaign summary** muestra cuántos coinciden y el número estimado de lotes.",{"_6944":122055,"_42621":121935,"_30085":197432,"_5":21646,"_28538":197128,"_5847":197433},[],"Si el paquete tiene precondiciones, el dashboard ejecuta primero una simulación (dry run) y muestra **Campaign preconditions**: cuántos dispositivos cumplen, cuáles no y por qué. Marca &#x2A;*Force deploy to non-qualifying devices (not recommended)** para enviar también a los que no cumplen y después **Confirm campaign**.",{"_6944":122056,"_42621":121935,"_30085":197435,"_5":21646,"_28538":197128,"_5847":197436},[],"Pulsa **Create campaign**. La campaña se crea pero todavía no se envía nada: vuelves a **Campaigns**.",{"_6944":122057,"_42621":121935,"_30085":197438,"_5":21646,"_28538":197132,"_5847":197439},[],"En **Campaigns** (`/updates`), cada fila tiene el progreso, el estado (como **Scheduled**, **Rolling Out**, **Paused**, **Completed**, **Cancelled**) y el progreso por lotes. Las tarjetas de la parte superior (**Active campaigns**, **Scheduled**, **Rolling out**, **Requires attention**, **Completed**) filtran la lista. La página se actualiza cada cuatro segundos mientras algo se mueve.",{"_6944":122058,"_42621":121935,"_30085":197441,"_5":21646,"_28538":197132,"_5847":197442},[],"El botón principal de la fila libera un lote:",{"_6944":122059,"_42621":121935,"_30085":197444,"_5":21646,"_28538":197132,"_5847":197445},[],"**Send to test device** envía primero el canario.",{"_6944":122060,"_42621":121935,"_30085":197447,"_5":21646,"_28538":197132,"_5847":197448},[],"**Execute next batch** envía el siguiente lote.",{"_6944":122061,"_42621":121935,"_30085":197450,"_5":21646,"_28538":197132,"_5847":197451},[],"Se oculta cuando la campaña está completada o cancelada, en pausa, programada para más tarde, sin nada pendiente, o es una campaña con **Auto rollout** que ya está en marcha. Mientras se prueba el canario o ha fallado, sigue visible pero deshabilitado. Un canario fallido pausa una campaña nativa: usa **Resume** para reintentarlo. Una campaña programada empieza sola a la hora planificada.",{"_6944":122062,"_42621":121935,"_30085":197453,"_5":21646,"_28538":197132,"_5847":197454},[],"El menú de fila tiene **Open details**, **Resume**, **Pause**, **Retry N failed** y **Cancel campaign** (pregunta «Cancel Campaign?»). **Pause** detiene los lotes siguientes mientras los dispositivos que ya están en curso terminan; **Resume** continúa. No hay botón para marcar una campaña como completada: una campaña nativa se completa sola cuando no queda ningún dispositivo pendiente ni en curso.",{"_6944":122063,"_42621":121935,"_30085":197456,"_5":21646,"_28538":197132,"_5847":197457},[],"Debajo de la tabla, un panel muestra los **Batches** de la campaña seleccionada y una tabla **Device progress**. Sigue la primera fila activa hasta que seleccionas otra. Abre **View** para `/updates/details`:",{"_6944":122064,"_42621":121935,"_30085":197459,"_5":21646,"_28538":197132,"_5847":197460},[],"**Overview**: identidad, precondiciones y la **Rollout Configuration** (workflow o install mode, tipo y valor del rollout, modo automático, dispositivo de prueba). **Edit** sobre el valor del rollout funciona solo donde el backend admite editar una estrategia en ejecución.",{"_6944":122065,"_42621":121935,"_30085":197462,"_5":21646,"_28538":197132,"_5847":197463},[],"**Device Jobs**: una fila por dispositivo con el estado de su trabajo, un botón **Refresh Jobs** y, en cada fila, un botón **Workflow** que abre la línea de tiempo del dispositivo. Para el workflow Phased, un botón **Next** y una tira de transiciones te permiten confirmar pasos, que es como avanza una campaña `phased`.",{"_6944":122066,"_42621":121935,"_30085":197465,"_5":21646,"_28538":197132,"_5847":197466},[],"La cabecera de la página repite el botón principal (**Execute Campaign**, o **Send to Test Device** antes del canario) y &#x2A;*Retry N failed device(s)**. No tiene pausar, reanudar ni cancelar: están en el menú de fila de la lista. En hawkBit, **Pause** está oculto hasta que la campaña ha empezado a despachar.",{"_6944":122067,"_42621":121935,"_30085":197468,"_5":21646,"_28538":197136,"_5847":197469},[],"Abre **Devices** (en **IoT**) y elige un dispositivo. La página tiene más pestañas que las relacionadas con actualizaciones que se listan aquí:",{"_6944":122068,"_42621":121935,"_30085":197471,"_5":21646,"_28538":197136,"_5847":197472},[],"Pestaña",{"_6944":122069,"_42621":121935,"_30085":197474,"_5":21646,"_28538":197136,"_5847":197475},[],"Muestra",{"_6944":122070,"_42621":121935,"_30085":197477,"_5":21646,"_28538":197136,"_5847":88016},[],{"_6944":122071,"_42621":121935,"_30085":197479,"_5":21646,"_28538":197136,"_5847":197480},[],"Los distribution sets que lleva, y **Up to date** u **Outdated** respecto al objetivo declarado",{"_6944":122072,"_42621":121935,"_30085":197482,"_5":21646,"_28538":197136,"_5847":88022},[],{"_6944":122073,"_42621":121935,"_30085":197484,"_5":21646,"_28538":197136,"_5847":197485},[],"Nativo: el workflow de eventos de WFX. hawkBit: la actualización en curso con los pasos Assigned, Installing e Installed",{"_6944":122074,"_42621":121935,"_30085":197487,"_5":21646,"_28538":197136,"_5847":88028},[],{"_6944":122075,"_42621":121935,"_30085":197489,"_5":21646,"_28538":197136,"_5847":197490},[],"**Installed Distribution Sets** con sus artefactos, y el **Pack Update History**",{"_6944":122076,"_42621":121935,"_30085":197492,"_5":21646,"_28538":197136,"_5847":88034},[],{"_6944":122077,"_42621":121935,"_30085":197494,"_5":21646,"_28538":197136,"_5847":197495},[],"Los trabajos de WFX del dispositivo",{"_6944":122078,"_42621":121935,"_30085":197497,"_5":21646,"_28538":197136,"_5847":197498},[],"Usa &#x2A;*Launch Update...** en el menú de acciones del dispositivo para enviar una versión a un dispositivo. El diálogo **Launch update for device** pide el grupo de dispositivos (cuando el dispositivo está en varios), el distribution set, la versión y el workflow (o el install mode), y crea un trabajo. El menú de acciones del propio paquete tiene **Targeted Update**, que hace lo mismo con los dispositivos que marques en una lista, siempre con el workflow `direct`, y se habilita cuando el paquete está construido. En **OTA Devices**, selecciona dispositivos de un mismo grupo y pulsa **Update** para hacerlo con muchos dispositivos; el botón está deshabilitado cuando la selección abarca varios grupos.",{"_6944":122079,"_42621":121935,"_30085":197500,"_5":21646,"_28538":197136,"_5847":197501},[],"**OTA Dashboard**, **OTA Devices** y **OTA Device Groups** muestran el cumplimiento de versiones: qué dispositivos están al día, por detrás de un objetivo declarado o sin objetivo. La página de un grupo también lista la versión que ejecuta cada dispositivo frente a la versión publicada del grupo, con un botón **Update to vX** para los desactualizados. Sin soporte de cumplimiento de versiones en el backend, siguen listando dispositivos y campañas, pero las versiones objetivo aparecen como **No target** o con un guion largo, con la alerta «Target versions unavailable on this backend».",{"_6944":122080,"_42621":121935,"_30085":197503,"_5":21646,"_28538":197140,"_5847":197504},[],"Pantalla",{"_6944":122081,"_42621":121935,"_30085":197506,"_5":21646,"_28538":197140,"_5847":195653},[],{"_6944":122082,"_42621":121935,"_30085":197508,"_5":21646,"_28538":197140,"_5847":86087},[],{"_6944":122083,"_42621":121935,"_30085":197510,"_5":21646,"_28538":197140,"_5847":197511},[],"Lista de paquetes",{"_6944":122084,"_42621":121935,"_30085":197513,"_5":21646,"_28538":197140,"_5847":197514},[],"Estado, empaquetado y tarjetas **Built / Not built / Build failed**",{"_6944":122085,"_42621":121935,"_30085":197516,"_5":21646,"_28538":197140,"_5847":197517},[],"Esas tarjetas, el filtro y la columna de estado se ocultan. Un conjunto no tiene estado de construcción propio: está listo cuando todos sus módulos están construidos, y **Start Campaign** sigue deshabilitado hasta entonces",{"_6944":122086,"_42621":121935,"_30085":197519,"_5":21646,"_28538":197140,"_5847":197520},[],"Paquete nuevo",{"_6944":122087,"_42621":121935,"_30085":197522,"_5":21646,"_28538":197140,"_5847":197523},[],"Sin sección de módulos",{"_6944":122088,"_42621":121935,"_30085":197525,"_5":21646,"_28538":197140,"_5847":197526},[],"Sección **Software modules** obligatoria",{"_6944":122089,"_42621":121935,"_30085":197528,"_5":21646,"_28538":197140,"_5847":197529},[],"Cabecera de la página del paquete",{"_6944":122090,"_42621":121935,"_30085":197531,"_5":21646,"_28538":197140,"_5847":197532},[],"**Generate SWU** y **Download SWU** (o **Generate Package** y **Download Package**)",{"_6944":122091,"_42621":121935,"_30085":197534,"_5":21646,"_28538":197140,"_5847":197535},[],"Un botón **Software modules** en su lugar: se construye en el catálogo",{"_6944":122092,"_42621":121935,"_30085":197537,"_5":21646,"_28538":197140,"_5847":197538},[],"Pestañas de la página del paquete",{"_6944":122093,"_42621":121935,"_30085":197540,"_5":21646,"_28538":197140,"_5847":197541},[],"**Overview**, **Software Modules**, **Contents**, **Manifest**, **Version History** (la composición está admitida, así que no hay pestaña **Artifacts** a nivel de paquete)",{"_6944":122094,"_42621":121935,"_30085":197543,"_5":21646,"_28538":197140,"_5847":197544},[],"Las mismas. La pestaña **Artifacts** aparece en su lugar solo si el servidor hawkBit no tiene los tipos de módulo",{"_6944":122095,"_42621":121935,"_30085":197546,"_5":21646,"_28538":197140,"_5847":197547},[],"Seguridad",{"_6944":122096,"_42621":121935,"_30085":197549,"_5":21646,"_28538":197140,"_5847":197550},[],"En la hoja **Generate SWU**",{"_6944":122097,"_42621":121935,"_30085":197552,"_5":21646,"_28538":197140,"_5847":197553},[],"Por módulo",{"_6944":122098,"_42621":121935,"_30085":197555,"_5":21646,"_28538":197140,"_5847":197556},[],"Formulario de campaña",{"_6944":122099,"_42621":121935,"_30085":197558,"_5":21646,"_28538":197140,"_5847":197559},[],"**Workflow**: Direct, Phased o cualquier workflow de WFX registrado",{"_6944":122100,"_42621":121935,"_30085":197561,"_5":21646,"_28538":197140,"_5847":197562},[],"**Install mode**: **Forced** o **Soft**",{"_6944":122101,"_42621":121935,"_30085":197564,"_5":21646,"_28538":197140,"_5847":197565},[],"Umbral de error",{"_6944":122102,"_42621":121935,"_30085":197567,"_5":21646,"_28538":197140,"_5847":197568},[],"La campaña se cancela cuando este % de todos sus dispositivos ha fallado",{"_6944":122103,"_42621":121935,"_30085":197570,"_5":21646,"_28538":197140,"_5847":197571},[],"La campaña se detiene cuando falla más de este % de un lote",{"_6944":122104,"_42621":121935,"_30085":197573,"_5":21646,"_28538":197140,"_5847":197574},[],"Pestaña **Update Status**",{"_6944":122105,"_42621":121935,"_30085":197576,"_5":21646,"_28538":197140,"_5847":197577},[],"Workflow de eventos de WFX",{"_6944":122106,"_42621":121935,"_30085":197579,"_5":21646,"_28538":197140,"_5847":197580},[],"Pasos de la acción de hawkBit",{"_6944":122107,"_42621":121935,"_30085":197582,"_5":21646,"_28538":197140,"_5847":197583},[],"Editar un rollout en ejecución",{"_6944":122108,"_42621":121935,"_30085":197585,"_5":21646,"_28538":197140,"_5847":197586},[],"Admitido",{"_6944":122109,"_42621":121935,"_30085":197588,"_5":21646,"_28538":197140,"_5847":197589},[],"No admitido",{"_6944":122110,"_42621":121935,"_30085":197591,"_5":21646,"_28538":197140,"_5847":197592},[],"Catálogo de módulos",{"_6944":122111,"_42621":121935,"_30085":197594,"_5":21646,"_28538":197140,"_5847":197595},[],"Los módulos se crean sin conjunto o se añaden a un paquete, y la importación los copia",{"_6944":122112,"_42621":121935,"_30085":197597,"_5":21646,"_28538":197140,"_5847":197598},[],"Los módulos se construyen en el catálogo y un paquete los enlaza",{"_6944":122113,"_42621":121935,"_30085":197600,"_5":21646,"_28538":197140,"_5847":197601},[],"La pestaña **Manifest** (el manifiesto de versión firmado) aparece solo cuando el backend admite firmas de artefactos.",{"_6944":122114,"_42621":121935,"_30085":197603,"_5":21646,"_28538":197144,"_5847":197604},[],"Estas funciones de la API no tienen pantalla: marcar una campaña como completada (`/complete`), sincronizar de una vez todos los conjuntos de un dispositivo con las últimas versiones del grupo (`/sync-to-latest`) y declarar la última versión de un grupo. Usa la API para ellas. Para enviar un conjunto a un dispositivo, lo hacen &#x2A;*Launch Update...** y el botón **Update to vX** por dispositivo en la página de un grupo.",{"_6944":122115,"_42621":121935,"_30085":197606,"_5":21646,"_28538":197148,"_5847":194415},[],{"_6944":122116,"_42621":121935,"_30085":197608,"_5":21646,"_28538":197148,"_5847":196825},[],{"_6944":122117,"_42621":121935,"_30085":197610,"_5":21646,"_28538":197148,"_5847":197611},[],"Faltan pantallas o botones que deberían existir",{"_6944":122118,"_42621":121935,"_30085":197613,"_5":21646,"_28538":197148,"_5847":197614},[],"La petición de capacidades tuvo éxito y el backend no los admite. Revisa **Updates backend** en el menú de usuario (compilaciones de desarrollo) o `GET /updates/v1/capabilities`",{"_6944":122119,"_42621":121935,"_30085":197616,"_5":21646,"_28538":197148,"_5847":197617},[],"Las pantallas de actualizaciones no cargan o muestran errores",{"_6944":122120,"_42621":121935,"_30085":197619,"_5":21646,"_28538":197148,"_5847":197620},[],"`LAMASSU_UPDATES_API` apunta al servicio o puerto equivocado, o tu pasarela no enruta `/updates/v1`",{"_6944":122121,"_42621":121935,"_30085":197622,"_5":21646,"_28538":197148,"_5847":197623},[],"**Start Campaign** está deshabilitado",{"_6944":122122,"_42621":121935,"_30085":197625,"_5":21646,"_28538":197148,"_5847":197626},[],"El paquete no está construido (nativo), o no todos los módulos están construidos (hawkBit)",{"_6944":122123,"_42621":121935,"_30085":197628,"_5":21646,"_28538":197148,"_5847":197629},[],"Al crear un paquete no se ofrece ningún grupo de dispositivos",{"_6944":122124,"_42621":121935,"_30085":197631,"_5":21646,"_28538":197148,"_5847":197632},[],"Aún no existe ningún grupo de dispositivos. Crea uno en **Device Groups**",{"_6944":122125,"_42621":121935,"_30085":197634,"_5":21646,"_28538":197148,"_5847":197635},[],"Una campaña parece atascada en **Rolling Out** cuando los dispositivos ya terminaron",{"_6944":122126,"_42621":121935,"_30085":197637,"_5":21646,"_28538":197148,"_5847":197638},[],"El workflow no encaja con el driver del paquete. Los paquetes SWU necesitan **Direct** o **Phased**; los Generic necesitan **Download-Install**",{"_6944":122127,"_42621":121935,"_30085":197640,"_5":21646,"_28538":197151,"_5847":197641},[],"<Card title=\"Publica y lanza una actualización\" href=\"/docs/platform/updates/guides/publish-and-roll-out\" description=\"El mismo flujo como peticiones a la API.\" />",{"_6944":122128,"_42621":121935,"_30085":197643,"_5":21646,"_28538":197151,"_5847":197644},[],"<Card title=\"Conceptos\" href=\"/docs/platform/updates/concepts\" description=\"Paquetes, módulos, campañas y workflows.\" />",{"_6944":122129,"_42621":121935,"_30085":197646,"_5":21646,"_28538":197151,"_5847":197647},[],"<Card title=\"Capacidades\" href=\"/docs/platform/updates/reference/capabilities\" description=\"Qué admite cada backend y qué oculta la interfaz.\" />",{"_6944":122130,"_42621":122130,"_5":22076,"_5847":197649,"_43101":197650,"_30085":197651,"_28538":122130},"Flujo de actualización con curl, backend hawkBit",[78004,189200,195583,196868],[],{"_6944":122131,"_42621":122130,"_30085":197653,"_5":21646,"_28538":122130,"_5847":197654},[],"Todas las peticiones de una actualización completa en modo hawkBit, incluido el lado del dispositivo por DDI, con respuestas reales.",{"_6944":122132,"_42621":122130,"_5":43098,"_30085":197656,"_28538":197657,"_5847":187778},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/hawkbit-curl#antes-de-empezar",{"_6944":122133,"_42621":122130,"_5":43098,"_30085":197659,"_28538":197660,"_5847":197661},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/hawkbit-curl#1-comprueba-el-backend","1\\. Comprueba el backend",{"_6944":122134,"_42621":122130,"_5":43098,"_30085":197663,"_28538":197664,"_5847":197665},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/hawkbit-curl#2-crea-un-módulo-en-el-catálogo","2\\. Crea un módulo en el catálogo",{"_6944":122135,"_42621":122130,"_5":43098,"_30085":197667,"_28538":197668,"_5847":197669},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/hawkbit-curl#3-sube-el-archivo-y-el-sw-description","3\\. Sube el archivo y el sw-description",{"_6944":122136,"_42621":122130,"_5":43098,"_30085":197671,"_28538":197672,"_5847":197673},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/hawkbit-curl#4-compila-el-módulo","4\\. Compila el módulo",{"_6944":122137,"_42621":122130,"_5":43098,"_30085":197675,"_28538":197676,"_5847":197677},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/hawkbit-curl#5-crea-el-pack-a-partir-del-módulo-compilado","5\\. Crea el pack a partir del módulo compilado",{"_6944":122138,"_42621":122130,"_5":43098,"_30085":197679,"_28538":197680,"_5847":197681},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/hawkbit-curl#6-simula-el-lanzamiento-y-créalo","6\\. Simula el lanzamiento y créalo",{"_6944":122139,"_42621":122130,"_5":43098,"_30085":197683,"_28538":197684,"_5847":197685},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/hawkbit-curl#7-inicia-el-rollout","7\\. Inicia el rollout",{"_6944":122140,"_42621":122130,"_5":43098,"_30085":197687,"_28538":197688,"_5847":197689},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/hawkbit-curl#8-haz-de-dispositivo-ddi","8\\. Haz de dispositivo (DDI)",{"_6944":122141,"_42621":122130,"_5":43098,"_30085":197691,"_28538":197692,"_5847":197693},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/hawkbit-curl#9-libera-los-siguientes-lotes","9\\. Libera los siguientes lotes",{"_6944":122142,"_42621":122130,"_5":43098,"_30085":197695,"_28538":197696,"_5847":197697},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/hawkbit-curl#10-comprueba-el-resultado","10\\. Comprueba el resultado",{"_6944":122143,"_42621":122130,"_5":43098,"_30085":197699,"_28538":197700,"_5847":197701},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/hawkbit-curl#lo-que-se-comporta-de-forma-distinta","Lo que se comporta de forma distinta",{"_6944":122144,"_42621":122130,"_5":43098,"_30085":197703,"_28538":197704,"_5847":191718},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/hawkbit-curl#solución-de-problemas",{"_6944":122145,"_42621":122130,"_5":43098,"_30085":197706,"_28538":197707,"_5847":190839},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/hawkbit-curl#siguientes-pasos",{"_6944":122146,"_42621":122130,"_30085":197709,"_5":21646,"_28538":122130,"_5847":197710},[],"La misma actualización que en la guía native, contra el servicio en modo hawkBit. Las peticiones de gestión van a Lamassu Updates. El lado del dispositivo es otro protocolo: los dispositivos consultan la API DDI de hawkBit, no este servicio ni WFX. Los comandos se ejecutaron contra un hawkBit 1.1.0 real, y las respuestas son reales, recortadas cuando son largas. Los ejemplos que indican que no se ejecutaron solo se comprobaron contra el código.",{"_6944":122147,"_42621":122130,"_30085":197712,"_5":21646,"_28538":122130,"_5847":197713},[],"Las diferencias respecto al modo native, en resumen:",{"_6944":122148,"_42621":122130,"_30085":197715,"_5":21646,"_28538":122130,"_5847":86084},[],{"_6944":122149,"_42621":122130,"_30085":197717,"_5":21646,"_28538":122130,"_5847":86087},[],{"_6944":122150,"_42621":122130,"_30085":197719,"_5":21646,"_28538":122130,"_5847":197720},[],"Compilación",{"_6944":122151,"_42621":122130,"_30085":197722,"_5":21646,"_28538":122130,"_5847":197723},[],"Sube artefactos y un sw-description al pack y luego compila el pack",{"_6944":122152,"_42621":122130,"_30085":197725,"_5":21646,"_28538":122130,"_5847":197726},[],"Compila primero un **módulo** en el catálogo y luego crea el pack a partir de él",{"_6944":122153,"_42621":122130,"_30085":197728,"_5":21646,"_28538":122130,"_5847":197729},[],"Pack tras crearlo",{"_6944":122154,"_42621":122130,"_30085":197731,"_5":21646,"_28538":122130,"_5847":86456},[],{"_6944":122155,"_42621":122130,"_30085":197733,"_5":21646,"_28538":122130,"_5847":197734},[],"Ya está `built`",{"_6944":122156,"_42621":122130,"_30085":197736,"_5":21646,"_28538":122130,"_5847":197737},[],"Quién avisa al dispositivo",{"_6944":122157,"_42621":122130,"_30085":197739,"_5":21646,"_28538":122130,"_5847":197740},[],"Un job de WFX",{"_6944":122158,"_42621":122130,"_30085":197742,"_5":21646,"_28538":122130,"_5847":197743},[],"Una acción de hawkBit, leída por DDI",{"_6944":122159,"_42621":122130,"_30085":197745,"_5":21646,"_28538":122130,"_5847":197746},[],"El dispositivo informa a",{"_6944":122160,"_42621":122130,"_30085":197748,"_5":21646,"_28538":122130,"_5847":86224},[],{"_6944":122161,"_42621":122130,"_30085":197750,"_5":21646,"_28538":122130,"_5847":197751},[],"hawkBit (feedback DDI)",{"_6944":122162,"_42621":122130,"_30085":197753,"_5":21646,"_28538":122130,"_5847":197754},[],"Siguiente lote, con `auto` activado",{"_6944":122163,"_42621":122130,"_30085":197756,"_5":21646,"_28538":122130,"_5847":197757},[],"El servicio, a partir de eventos de WFX",{"_6944":122164,"_42621":122130,"_30085":197759,"_5":21646,"_28538":122130,"_5847":197760},[],"hawkBit, a partir de sus grupos de rollout",{"_6944":122165,"_42621":122130,"_30085":197762,"_5":21646,"_28538":197657,"_5847":197763},[],"El stack está en marcha en modo hawkBit: este servicio, su Postgres, hawkBit y el device manager de Lamassu.",{"_6944":122166,"_42621":122130,"_30085":197765,"_5":21646,"_28538":197657,"_5847":197766},[],"Un grupo de dispositivos en Lamassu con dispositivos dentro. Esta guía usa `fleet-a` con `dev-001` a `dev-004`.",{"_6944":122167,"_42621":122130,"_30085":197768,"_5":21646,"_28538":197657,"_5847":197769},[],"`curl` y `jq`.",{"_6944":122168,"_42621":122130,"_30085":197771,"_5":21646,"_28538":197657,"_5847":197772},[],"Un compilador de SWU configurado (`swugenerator_path`), para compilar un módulo `swu-build`. Sin él, `POST .../build` sobre un módulo así responde `501`.",{"_6944":122169,"_42621":122130,"_30085":197774,"_5":21646,"_28538":197657,"_5847":197775},[],"`config-hawkbit.yml` del repositorio sirve la API en el puerto `10090`, igual que el stack native, así que ejecuta un solo backend a la vez en ese puerto. `config-hawkbit-demo.yml` la sirve en el `10091`, al que apunta el entorno de desarrollo del dashboard del repositorio para el backend hawkBit. Ajusta `API` a donde escuche tu instancia. A través de un gateway de Lamassu la API suele ser `https://lamassu.example.com/api/updates/v1` y cada llamada necesita la credencial de tu gateway, por ejemplo `-H \"Authorization: Bearer $TOKEN\"`.",{"_6944":122170,"_42621":122130,"_30085":197777,"_5":21646,"_28538":197660,"_5847":197778},[],"`artifact_encryption`, `software_module_composition`, `standalone_software_modules` y `software_module_replace` también aparecen en esa lista si faltan los ajustes de compilación o los tipos de módulo de hawkBit. Consulta Capabilities.",{"_6944":122171,"_42621":122130,"_30085":197780,"_5":21646,"_28538":197664,"_5847":197781},[],"Un conjunto de distribución de hawkBit solo puede enlazar módulos **compilados**, así que el módulo va primero. `delivery_intent` indica cómo se entrega: `swu-build` compila un `.swu` a partir de tus archivos y un sw-description. Consulta Modo hawkBit para las demás intenciones (`swu-prebuilt`, `raw`).",{"_6944":122172,"_42621":122130,"_30085":197783,"_5":21646,"_28538":197664,"_5847":197784},[],"`type` es `os` o `application`, y `type`, `name` y `version` son obligatorios. Sin `delivery_intent` el módulo queda `undecided`: acepta archivos, pero no se puede compilar ni enlazar hasta que elijas una con `PUT /softwaremodules/by-id/$MID`.",{"_6944":122173,"_42621":122130,"_30085":197786,"_5":21646,"_28538":197668,"_5847":197787},[],"Usa el mismo `index.html` y `sw-description` que en la guía native.",{"_6944":122174,"_42621":122130,"_30085":197789,"_5":21646,"_28538":197668,"_5847":197790},[],"Un módulo `swu-build` rechaza un `.swu` terminado como entrada, y un módulo `swu-prebuilt` admite exactamente un `.swu`.",{"_6944":122175,"_42621":122130,"_30085":197792,"_5":21646,"_28538":197672,"_5847":197793},[],"La compilación sustituyó los archivos de entrada del módulo por el `.swu` terminado. El cuerpo de la compilación es opcional. Para cifrar o firmar, envía `user`, `encryption_key_name`, `encryption_alg_name`, `signature_key_id`, `signature_alg_name` y `signature_certificate`, como en la página de firma y cifrado. Un módulo se compila una sola vez: para cambiarlo, publica una nueva versión del módulo.",{"_6944":122176,"_42621":122130,"_30085":197795,"_5":21646,"_28538":197676,"_5847":197796},[],"El pack está compilado desde el principio. Su `uri` es una dirección de descarga de hawkBit que los dispositivos resuelven por sí mismos. En modo hawkBit `modules` solo admite entradas `source_module_id`, y cada módulo debe estar compilado y ser compatible con el empaquetado del pack. Varias entradas forman un pack con varios módulos, y entonces `GET .../swu/download` responde `400`: descarga el entregable de cada módulo con `GET .../modules/:moduleKey/artifact/download`.",{"_6944":122177,"_42621":122130,"_30085":197798,"_5":21646,"_28538":197680,"_5847":197799},[],"Los dispositivos de un grupo solo existen en hawkBit cuando el servicio los ha registrado. El servicio lo hace cada vez que lista los dispositivos del grupo, algo que hacen un lanzamiento, una simulación, un listado de jobs o una lectura de conformidad. La comprobación del canario se ejecuta **antes**, así que en el primer lanzamiento de un grupo que aún no se ha listado, un `test_device_id` falla:",{"_6944":122178,"_42621":122130,"_30085":197801,"_5":21646,"_28538":197680,"_5847":197802},[],"Ejecuta primero la simulación sin canario. Registra los dispositivos del grupo en hawkBit como targets y los etiqueta `group:fleet-a`:",{"_6944":122179,"_42621":122130,"_30085":197804,"_5":21646,"_28538":197680,"_5847":197805},[],"`never_seen_devices` lista los targets que aún no han contactado con hawkBit. Un grupo de rollout no puede terminar mientras sus dispositivos nunca consulten, así que revisa esta lista. `superseded_devices` lista los dispositivos que ya tienen una actualización en curso: crear el lanzamiento **cancela** esas acciones, porque hawkBit sustituye las acciones sin terminar de un target por la nueva. Ahora crea el lanzamiento con el canario:",{"_6944":122180,"_42621":122130,"_30085":197807,"_5":21646,"_28538":197680,"_5847":197808},[],"`workflow_type` no tiene aquí significado de WFX: `phased` crea una acción `soft` de hawkBit (el dispositivo decide cuándo instalar) y cualquier otro valor una `forced`. Define una función auxiliar para seguir el lanzamiento:",{"_6944":122181,"_42621":122130,"_30085":197810,"_5":21646,"_28538":197680,"_5847":197811},[],"Para iniciar el rollout más tarde, añade `scheduled_at` (RFC 3339) al cuerpo de creación. El planificador propio de hawkBit lo inicia entonces, y una llamada a `rollout` antes de esa hora respeta la programación. No se ejecutó aquí.",{"_6944":122182,"_42621":122130,"_30085":197813,"_5":21646,"_28538":197684,"_5847":197814},[],"El servicio inició un rollout de hawkBit: el canario en el primer grupo y el resto después.",{"_6944":122183,"_42621":122130,"_30085":197816,"_5":21646,"_28538":197688,"_5847":197817},[],"Un dispositivo real ejecuta `suricatta` de SWUpdate, que hace esto por sí mismo. Estas son las peticiones que realiza.",{"_6944":122184,"_42621":122130,"_30085":197819,"_5":21646,"_28538":197688,"_5847":197820},[],"Primero, los dispositivos deben autenticarse. Por defecto hawkBit los rechaza. Activa una sola vez los tokens de seguridad del tenant y lee el token del target:",{"_6944":122185,"_42621":122130,"_30085":197822,"_5":21646,"_28538":197688,"_5847":197823},[],"Esta es la configuración local. En un despliegue donde los dispositivos llegan a hawkBit a través del gateway de Lamassu, `hawkbit.ddi_url` es la ruta del gateway (por ejemplo `https://lamassu.example.com/api/hawkbit-ddi`) y los dispositivos se autentican como exija el gateway, normalmente con su certificado de cliente. Consulta Conectar un dispositivo.",{"_6944":122186,"_42621":122130,"_30085":197825,"_5":21646,"_28538":197688,"_5847":197826},[],"Consulta. Cuando hay trabajo, la respuesta enlaza a un `deploymentBase`:",{"_6944":122187,"_42621":122130,"_30085":197828,"_5":21646,"_28538":197688,"_5847":197829},[],"Lee el despliegue y descarga su artefacto:",{"_6944":122188,"_42621":122130,"_30085":197831,"_5":21646,"_28538":197688,"_5847":197832},[],"Cuando el servicio publica la URL de artefactos del dispositivo (la ruta de `ddi_url`), sirve él mismo esa misma ruta, solo para los módulos del conjunto asignado o instalado del dispositivo, y con la firma previa de S3 activada responde `302` a una URL firmada de corta duración. Un dispositivo no necesita notar la diferencia: sigue la redirección.",{"_6944":122189,"_42621":122130,"_30085":197834,"_5":21646,"_28538":197688,"_5847":197835},[],"Informa del progreso y del resultado. `closed` con `finished: success` es el final:",{"_6944":122190,"_42621":122130,"_30085":197837,"_5":21646,"_28538":197688,"_5847":197838},[],"El servicio lee hawkBit cuando se lo pides, así que el lanzamiento está al día:",{"_6944":122191,"_42621":122130,"_30085":197840,"_5":21646,"_28538":197688,"_5847":197841},[],"Para informar de un fallo, envía `\"finished\":\"failure\"` en el feedback `closed`.",{"_6944":122192,"_42621":122130,"_30085":197843,"_5":21646,"_28538":197692,"_5847":197844},[],"Con `auto` desactivado, hawkBit se detiene tras cada grupo. Cada llamada a `rollout` libera el siguiente:",{"_6944":122193,"_42621":122130,"_30085":197846,"_5":21646,"_28538":197692,"_5847":197847},[],"Aquí una acción de hawkBit se muestra como un estado de workflow: una acción programada es `CREATED`, una en curso `DOWNLOADING` (hawkBit no informa de pasos más finos), una terminada (o terminada con una advertencia) `ACTIVATED`, y una fallida, cancelada o en cancelación `TERMINATED`. Repite el paso 8 para `dev-002` y `dev-003` (el token sale de cada target) y vuelve a llamar a `rollout` para `dev-004`. Cuando todas las acciones han terminado:",{"_6944":122194,"_42621":122130,"_30085":197849,"_5":21646,"_28538":197692,"_5847":197850},[],"hawkBit decide cuándo termina un lote. Cuando informa el último dispositivo de un lote, hawkBit pausa el rollout, y durante un momento su grupo sigue figurando como `running`. El servicio no distingue esa pausa de una hecha por un operador, así que una llamada a `rollout` en esa ventana responde `400` con `rollout 1 is paused; resume it first`. Llama a `resume` y hawkBit libera por sí mismo el siguiente lote:",{"_6944":122195,"_42621":122130,"_30085":197852,"_5":21646,"_28538":197700,"_5847":197853},[],"**Rollout automático.** Con `auto: true`, hawkBit avanza los grupos por sí mismo cuando se cumple `approval_threshold`. El servicio no ejecuta un consumidor de eventos en este modo. Los umbrales se establecen en cada grupo de rollout, y hawkBit evalúa ambos porcentajes **por grupo**, no sobre todos los dispositivos como hace native. Un umbral sin definir o `0` pasa a 100, así que un `error_threshold` sin definir nunca se activa. El grupo del canario siempre necesita el 100 %. Se aplican también con `auto` desactivado.",{"_6944":122196,"_42621":122130,"_30085":197855,"_5":21646,"_28538":197700,"_5847":197856},[],"**Un umbral de error activado.** hawkBit pausa entonces el rollout, y el servicio informa el lanzamiento como `cancelled`. `resume` y `rollout` responden ambos `400`.",{"_6944":122197,"_42621":122130,"_30085":197858,"_5":21646,"_28538":197700,"_5847":197859},[],"**Pausar y reanudar.** `pause` y `resume` se corresponden con la pausa y la reanudación de rollouts de hawkBit, pero solo se puede reanudar una pausa hecha por un operador. hawkBit ya retiene el rollout entre grupos cuando `auto` está desactivado, así que `pause` responde entonces `400` («Rollout can only be paused in state running but current state is paused») y `resume` responde `400` («not paused; use Execute to release the next batch»). Usa `rollout` para liberar el siguiente grupo.",{"_6944":122198,"_42621":122130,"_30085":197861,"_5":21646,"_28538":197700,"_5847":197862},[],"**Lectura de la estrategia.** La estrategia que se muestra de un lanzamiento se deriva de los grupos del rollout de hawkBit, no se almacena. Un lanzamiento creado con un lote fijo de 2 para 4 dispositivos se lee como `percentage` 50.",{"_6944":122199,"_42621":122130,"_30085":197864,"_5":21646,"_28538":197700,"_5847":197865},[],"**Pertenencia estática.** Un rollout se construye con los dispositivos del grupo en el momento de crear el lanzamiento. Los dispositivos añadidos después al grupo no se incorporan (`launch_device_assignment` no está admitido).",{"_6944":122200,"_42621":122130,"_30085":197867,"_5":21646,"_28538":197700,"_5847":197868},[],"**No disponible.** Cifrado por dispositivo, workflows personalizados (`GET /workflows` devuelve una lista vacía), editar una estrategia en curso, marcar un lanzamiento como completado, eventos de job enviados por el servidor (el progreso se sondea), subida de un precompilado a nivel de conjunto y compilar un pack directamente. `POST .../swu` responde `501`:",{"_6944":122201,"_42621":122130,"_30085":197870,"_5":21646,"_28538":197704,"_5847":194415},[],{"_6944":122202,"_42621":122130,"_30085":197872,"_5":21646,"_28538":197704,"_5847":197873},[],"Causa y solución",{"_6944":122203,"_42621":122130,"_30085":197875,"_5":21646,"_28538":197704,"_5847":197876},[],"`501` al compilar un módulo: no hay compilador de SWU",{"_6944":122204,"_42621":122130,"_30085":197878,"_5":21646,"_28538":197704,"_5847":197879},[],"`swugenerator_path` no está configurado. Configúralo, o sube un `.swu` precompilado con la intención `swu-prebuilt`",{"_6944":122205,"_42621":122130,"_30085":197881,"_5":21646,"_28538":197704,"_5847":197882},[],"`501` al compilar un módulo: no hay SymKMS o no hay endpoint de KMS",{"_6944":122206,"_42621":122130,"_30085":197884,"_5":21646,"_28538":197704,"_5847":197885},[],"El cifrado necesita `symkms_endpoint` y la firma necesita `kms_endpoint`. Compila sin esos campos, o configúralos",{"_6944":122207,"_42621":122130,"_30085":197887,"_5":21646,"_28538":197704,"_5847":197888},[],"`400 ... is not built` al crear un pack",{"_6944":122208,"_42621":122130,"_30085":197890,"_5":21646,"_28538":197704,"_5847":197891},[],"Un módulo enlazado a un pack debe estar compilado antes. Compílalo en el catálogo",{"_6944":122209,"_42621":122130,"_30085":197893,"_5":21646,"_28538":197704,"_5847":88436},[],{"_6944":122210,"_42621":122130,"_30085":197895,"_5":21646,"_28538":197704,"_5847":197896},[],"Un módulo `raw` no puede ir en un pack `swu`, y un módulo `swu-prebuilt` no puede ir en un pack `non-swu`",{"_6944":122211,"_42621":122130,"_30085":197898,"_5":21646,"_28538":197704,"_5847":197899},[],"`400 ... frozen` al cambiar un módulo",{"_6944":122212,"_42621":122130,"_30085":197901,"_5":21646,"_28538":197704,"_5847":197902},[],"Un módulo enlazado a un pack está congelado. Edítalo y compílalo en el catálogo y enlázalo de nuevo",{"_6944":122213,"_42621":122130,"_30085":197904,"_5":21646,"_28538":197704,"_5847":88448},[],{"_6944":122214,"_42621":122130,"_30085":197906,"_5":21646,"_28538":197704,"_5847":197907},[],"Un módulo se compila una sola vez. Publica una nueva versión del módulo",{"_6944":122215,"_42621":122130,"_30085":197909,"_5":21646,"_28538":197704,"_5847":88454},[],{"_6944":122216,"_42621":122130,"_30085":197911,"_5":21646,"_28538":197704,"_5847":197912},[],"Otra petición retiene el módulo. Reintenta cuando termine",{"_6944":122217,"_42621":122130,"_30085":197914,"_5":21646,"_28538":197704,"_5847":197915},[],"Crear un módulo responde `400` mencionando que hawkBit reserva el nombre y la versión",{"_6944":122218,"_42621":122130,"_30085":197917,"_5":21646,"_28538":197704,"_5847":197918},[],"hawkBit conserva el nombre y la versión de un módulo que se asignó a un dispositivo, incluso después de eliminarlo. Usa una versión nueva",{"_6944":122219,"_42621":122130,"_30085":197920,"_5":21646,"_28538":197704,"_5847":197921},[],"El canario falla con `device ... does not exist`",{"_6944":122220,"_42621":122130,"_30085":197923,"_5":21646,"_28538":197704,"_5847":197924},[],"Los dispositivos del grupo aún no están en hawkBit. Ejecuta antes una simulación sin `test_device_id`",{"_6944":122221,"_42621":122130,"_30085":197926,"_5":21646,"_28538":197704,"_5847":197927},[],"Un lanzamiento nunca avanza",{"_6944":122222,"_42621":122130,"_30085":197929,"_5":21646,"_28538":197704,"_5847":197930},[],"Revisa `never_seen_devices`: un dispositivo que nunca consulta bloquea su grupo de rollout",{"_6944":122223,"_42621":122130,"_30085":197932,"_5":21646,"_28538":197707,"_5847":197933},[],"Modo hawkBit, para módulos, intenciones de entrega y qué vive dónde",{"_6944":122224,"_42621":122130,"_30085":197935,"_5":21646,"_28538":197707,"_5847":197936},[],"Conectar un dispositivo, para la configuración del lado del dispositivo",{"_6944":122225,"_42621":122130,"_30085":197938,"_5":21646,"_28538":197707,"_5847":197939},[],"Referencia de la API",{"_6944":122226,"_42621":122130,"_30085":197941,"_5":21646,"_28538":197707,"_5847":191718},[],{"_6944":122227,"_42621":122227,"_5":22076,"_5847":197943,"_43101":197944,"_30085":197945,"_28538":122227},"Flujo de actualización con curl, backend native",[78004,189200,195583,196868],[],{"_6944":122228,"_42621":122227,"_30085":197947,"_5":21646,"_28538":122227,"_5847":197948},[],"Todas las peticiones de una actualización completa en modo native, desde crear un pack hasta el último dispositivo, con respuestas reales.",{"_6944":122229,"_42621":122227,"_5":43098,"_30085":197950,"_28538":197951,"_5847":187778},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#antes-de-empezar",{"_6944":122230,"_42621":122227,"_5":43098,"_30085":197953,"_28538":197954,"_5847":197661},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#1-comprueba-el-backend",{"_6944":122231,"_42621":122227,"_5":43098,"_30085":197956,"_28538":197957,"_5847":197958},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#2-crea-el-pack","2\\. Crea el pack",{"_6944":122232,"_42621":122227,"_5":43098,"_30085":197960,"_28538":197961,"_5847":197962},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#3-sube-el-sw-description-y-el-artefacto","3\\. Sube el sw-description y el artefacto",{"_6944":122233,"_42621":122227,"_5":43098,"_30085":197964,"_28538":197965,"_5847":197966},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#4-compila-el-swu","4\\. Compila el `.swu`",{"_6944":122234,"_42621":122227,"_5":43098,"_30085":197968,"_28538":197969,"_5847":197970},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#5-simula-y-crea-el-lanzamiento","5\\. Simula y crea el lanzamiento",{"_6944":122235,"_42621":122227,"_5":43098,"_30085":197972,"_28538":197973,"_5847":197974},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#6-despliega-el-canario","6\\. Despliega el canario",{"_6944":122236,"_42621":122227,"_5":43098,"_30085":197976,"_28538":197977,"_5847":197978},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#7-haz-de-dispositivo","7\\. Haz de dispositivo",{"_6944":122237,"_42621":122227,"_5":43098,"_30085":197980,"_28538":197981,"_5847":197982},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#8-despliega-el-resto","8\\. Despliega el resto",{"_6944":122238,"_42621":122227,"_5":43098,"_30085":197984,"_28538":197985,"_5847":197986},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#9-comprueba-el-resultado","9\\. Comprueba el resultado",{"_6944":122239,"_42621":122227,"_5":43098,"_30085":197988,"_28538":197989,"_5847":197990},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#variaciones","Variaciones",{"_6944":122240,"_42621":122227,"_5":43098,"_30085":197992,"_28538":197993,"_5847":197994},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#deja-que-el-servicio-libere-los-lotes","Deja que el servicio libere los lotes",{"_6944":122241,"_42621":122227,"_5":43098,"_30085":197996,"_28538":197997,"_5847":197998},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#pausar-reanudar-reintentar-y-cancelar","Pausar, reanudar, reintentar y cancelar",{"_6944":122242,"_42621":122227,"_5":43098,"_30085":198000,"_28538":198001,"_5847":198002},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#programar-un-lanzamiento","Programar un lanzamiento",{"_6944":122243,"_42621":122227,"_5":43098,"_30085":198004,"_28538":198005,"_5847":198006},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#exigir-una-versión-antes-de-actualizar","Exigir una versión antes de actualizar",{"_6944":122244,"_42621":122227,"_5":43098,"_30085":198008,"_28538":198009,"_5847":198010},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#actualizar-un-dispositivo-a-una-versión","Actualizar un dispositivo a una versión",{"_6944":122245,"_42621":122227,"_5":43098,"_30085":198012,"_28538":198013,"_5847":198014},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#una-nueva-versión","Una nueva versión",{"_6944":122246,"_42621":122227,"_5":43098,"_30085":198016,"_28538":198017,"_5847":198018},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#cifrar-con-una-clave-compartida","Cifrar con una clave compartida",{"_6944":122247,"_42621":122227,"_5":43098,"_30085":198020,"_28538":198021,"_5847":198022},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#cifrar-por-dispositivo","Cifrar por dispositivo",{"_6944":122248,"_42621":122227,"_5":43098,"_30085":198024,"_28538":198025,"_5847":198026},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#firmar-el-paquete","Firmar el paquete",{"_6944":122249,"_42621":122227,"_5":43098,"_30085":198028,"_28538":198029,"_5847":191718},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#solución-de-problemas",{"_6944":122250,"_42621":122227,"_5":43098,"_30085":198031,"_28538":198032,"_5847":190839},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#siguientes-pasos",{"_6944":122251,"_42621":122227,"_30085":198034,"_5":21646,"_28538":122227,"_5847":198035},[],"Una actualización completa, petición a petición: crear un pack, compilarlo, enviarlo a un grupo por lotes, hacer de dispositivo y seguir el progreso. Todos los comandos se ejecutaron contra un stack en modo native, y las respuestas son reales, recortadas cuando son largas, salvo donde una sección indica que no se ejecutó: esos ejemplos solo se comprobaron contra el código.",{"_6944":122252,"_42621":122227,"_30085":198037,"_5":21646,"_28538":122227,"_5847":198038},[],"Si usas el backend hawkBit, el flujo cambia, sobre todo en cómo se compila un pack y en cómo informan los dispositivos. Para las pantallas que hacen lo mismo, consulta la guía del dashboard.",{"_6944":122253,"_42621":122227,"_30085":198040,"_5":21646,"_28538":197951,"_5847":198041},[],"El stack está en marcha en modo native: el servicio, Postgres, WFX y el device manager de Lamassu.",{"_6944":122254,"_42621":122227,"_30085":198043,"_5":21646,"_28538":197951,"_5847":198044},[],"Existe un grupo de dispositivos en Lamassu con dispositivos dentro. Esta guía usa el grupo `fleet-a` con los dispositivos `dev-001` a `dev-004`.",{"_6944":122255,"_42621":122227,"_30085":198046,"_5":21646,"_28538":197951,"_5847":198047},[],"Tienes `curl` y `jq` instalados. `jq` solo se usa para extraer valores de las respuestas.",{"_6944":122256,"_42621":122227,"_30085":198049,"_5":21646,"_28538":197951,"_5847":198050},[],"Estas son las direcciones del stack de Docker Compose del repositorio. A través de un gateway de Lamassu la API suele ser `https://lamassu.example.com/api/updates/v1`, y entonces cada llamada necesita la credencial que exija tu gateway, por ejemplo `-H \"Authorization: Bearer $TOKEN\"`. El servicio en sí no autentica. Consulta Seguridad.",{"_6944":122257,"_42621":122227,"_30085":198052,"_5":21646,"_28538":197957,"_5847":198053},[],"El pack está en `draft`. Sigue siendo editable hasta que se compila. `name`, `version` (semver) y `group_id` son obligatorios; el nombre debe ser único en el grupo, o la petición responde `409`.",{"_6944":122258,"_42621":122227,"_30085":198055,"_5":21646,"_28538":197961,"_5847":198056},[],"El sw-description le dice a SWUpdate qué instalar. Este, mínimo, instala una página web. Consulta las reglas del sw-description en Publicar y desplegar una actualización.",{"_6944":122259,"_42621":122227,"_30085":198058,"_5":21646,"_28538":197961,"_5847":198059},[],"El nombre del artefacto es global: todos los packs comparten un único catálogo, y un nombre solo se puede reutilizar con una `version` **mayor**. Volver a subir `index.html` como `1.0.0` falla con `version 1.0.0 must be greater than the current latest version`. Un archivo llamado `.swu` o `.tar.gz` debe serlo realmente, o la subida responde `400`.",{"_6944":122260,"_42621":122227,"_30085":198061,"_5":21646,"_28538":197965,"_5847":198062},[],"`selected_artifact_ids` es lo que incorpora artefactos a la compilación. Sin él, la compilación falla.",{"_6944":122261,"_42621":122227,"_30085":198064,"_5":21646,"_28538":197965,"_5847":198065},[],"La `uri` empieza por el `update_domain` del servicio. En el stack de Compose es `http://updates:10090/updates/v1/` (`config-docker.yml`), un nombre que solo se resuelve dentro de la red de Compose, porque es la dirección que usan los dispositivos. Desde tu host, llama a la misma ruta en `localhost:10090`, como hace el siguiente comando.",{"_6944":122262,"_42621":122227,"_30085":198067,"_5":21646,"_28538":197965,"_5847":198068},[],"El pack ya está `built`: ya no se pueden añadir ni enlazar artefactos. Puedes descargar el paquete compartido (este no está cifrado):",{"_6944":122263,"_42621":122227,"_30085":198070,"_5":21646,"_28538":197965,"_5847":198071},[],"Las descargas admiten `Range` y `HEAD`, así que un cliente puede conocer antes el tamaño y reanudar una transferencia interrumpida, por ejemplo con `curl -C - -o water.swu $P/swu/download`. Con almacenamiento S3 y la firma previa activada, la misma petición puede responder `302` a una URL firmada de corta duración, que `curl -L` sigue.",{"_6944":122264,"_42621":122227,"_30085":198073,"_5":21646,"_28538":197965,"_5847":198074},[],"Si la compilación falla, el pack pasa a `build_failed` y `last_build_error` contiene el motivo. Sigue siendo editable: corrige la causa y compila de nuevo.",{"_6944":122265,"_42621":122227,"_30085":198076,"_5":21646,"_28538":197969,"_5847":198077},[],"Una simulación (dry run) muestra quién recibiría la actualización, sin crear nada:",{"_6944":122266,"_42621":122227,"_30085":198079,"_5":21646,"_28538":197969,"_5847":198080},[],"Créalo. `test_device_id` es el canario: va solo primero y debe tener éxito antes de tocar a ningún otro. `rollout_value` 2 significa lotes de dos dispositivos.",{"_6944":122267,"_42621":122227,"_30085":198082,"_5":21646,"_28538":197969,"_5847":198083},[],"Una pequeña función auxiliar facilita seguir el lanzamiento en los pasos siguientes:",{"_6944":122268,"_42621":122227,"_30085":198085,"_5":21646,"_28538":197973,"_5847":198086},[],"Un `status` vacío significa en ejecución. Solo el canario está activo. El servicio creó un job de WFX para `dev-001`:",{"_6944":122269,"_42621":122227,"_30085":198088,"_5":21646,"_28538":197977,"_5847":198089},[],"Un dispositivo real hace esto por sí mismo. Estos comandos son lo que envía a WFX, de modo que puedes manejar a mano un dispositivo de prueba. Primero el dispositivo le pide su job a WFX:",{"_6944":122270,"_42621":122227,"_30085":198091,"_5":21646,"_28538":197977,"_5847":198092},[],"El dispositivo descarga la `uri`, la instala e informa de cada paso:",{"_6944":122271,"_42621":122227,"_30085":198094,"_5":21646,"_28538":197977,"_5847":198095},[],"El workflow `direct` es `INSTALL → INSTALLING → INSTALLED → ACTIVATE → ACTIVATING → ACTIVATED`. El propio WFX da el paso `INSTALLED → ACTIVATE`. Para informar de un fallo, mueve un job a `TERMINATED`.",{"_6944":122272,"_42621":122227,"_30085":198097,"_5":21646,"_28538":197977,"_5847":198098},[],"El servicio se entera de cada cambio por WFX a través de su flujo de eventos y actualiza el lanzamiento. Tarda un instante, así que si `status` aún muestra el dispositivo como activo, vuelve a ejecutarlo al cabo de un segundo:",{"_6944":122273,"_42621":122227,"_30085":198100,"_5":21646,"_28538":197981,"_5847":198101},[],"El canario ha pasado. Cada llamada a `rollout` envía ahora el siguiente lote de dos:",{"_6944":122274,"_42621":122227,"_30085":198103,"_5":21646,"_28538":197981,"_5847":198104},[],"Haz pasar a esos dispositivos por pasos como los del paso 7 y vuelve a llamar a `rollout` para el último dispositivo. Cuando no queda nada pendiente ni activo, el lanzamiento se completa solo:",{"_6944":122275,"_42621":122227,"_30085":198106,"_5":21646,"_28538":197981,"_5847":198107},[],"`completed_count` cuenta solo los éxitos: un dispositivo fallido se cuenta en `failed_count`. Un lanzamiento se marca como `completed` cuando no queda nada pendiente ni activo, aunque algunos dispositivos hayan fallado, así que comprueba `failed_count` antes de dar la actualización por buena.",{"_6944":122276,"_42621":122227,"_30085":198109,"_5":21646,"_28538":197985,"_5847":198110},[],"Para seguir la deriva, declara la versión en la que deben estar los dispositivos y lee después la conformidad:",{"_6944":122277,"_42621":122227,"_30085":198112,"_5":21646,"_28538":197985,"_5847":198113},[],"La vista de toda la flota con el último intento por dispositivo y pack, incluidos los intentos ajenos a cualquier lanzamiento, es una sola llamada. No se ejecutó aquí; los corchetes de un filtro necesitan `curl -g`:",{"_6944":122278,"_42621":122227,"_30085":198115,"_5":21646,"_28538":197993,"_5847":198116},[],"Con `auto` activado, el servicio envía por sí mismo el siguiente lote cuando ha tenido éxito una parte suficiente del actual. `approval_threshold` es el porcentaje del lote que debe tener éxito (0 o 100 significan todo el lote). `error_threshold` se aplica a todos los lanzamientos, con `auto` o sin él: el lanzamiento se cancela cuando el número de dispositivos fallidos alcanza ese porcentaje de **todos** los dispositivos, redondeado hacia arriba. Con 4 dispositivos al 75 %, el tercer fallo lo cancela.",{"_6944":122279,"_42621":122227,"_30085":198118,"_5":21646,"_28538":197993,"_5847":198119},[],"Este ejemplo usa un segundo pack, `valve-panel`, creado y compilado como `water-panel` (pasos 2 a 4). Los nombres de artefacto son globales y un nombre que ya existe debe recibir una versión mayor, así que dale a este su propio nombre de archivo:",{"_6944":122280,"_42621":122227,"_30085":198121,"_5":21646,"_28538":197993,"_5847":198122},[],"Llama a `rollout` una vez para empezar. Una segunda llamada se rechaza:",{"_6944":122281,"_42621":122227,"_30085":198124,"_5":21646,"_28538":197993,"_5847":198125},[],"Si un dispositivo del primer lote falla (`TERMINATED`) y el otro tiene éxito, el 50 % de éxitos cumple el umbral y el siguiente lote se despacha solo.",{"_6944":122282,"_42621":122227,"_30085":198127,"_5":21646,"_28538":197997,"_5847":198128},[],"Una pausa deja terminar el lote en curso y retiene el siguiente. `retry-failed` devuelve los dispositivos fallidos al conjunto de pendientes y libera el siguiente lote. Ese lote se saca al azar de todos los dispositivos pendientes, así que también puede incluir dispositivos a los que nunca se envió nada, y si han fallado más dispositivos de los que caben en un lote, solo sale un lote. Responde `400` cuando no ha fallado nada, y reabre un lanzamiento completado o cancelado (`\"status\":\"running\"`). Un canario fallido pausa el lanzamiento por sí mismo, y `resume` vuelve entonces a enviar el canario. Un lanzamiento cancelado no se puede reanudar, y los dispositivos en curso terminan su job actual.",{"_6944":122283,"_42621":122227,"_30085":198130,"_5":21646,"_28538":198001,"_5847":198131},[],"No se ejecutó aquí. `scheduled_at` (RFC 3339) retrasa el primer lote. El servicio busca lanzamientos pendientes aproximadamente cada 30 segundos, así que el inicio puede retrasarse hasta ese tiempo. Una llamada a `rollout` antes de la hora no hace nada.",{"_6944":122284,"_42621":122227,"_30085":198133,"_5":21646,"_28538":198001,"_5847":198134},[],"La programación sobrevive a un reinicio y la ejecuta la réplica que tenga en cada momento el rol de líder, de modo que un lanzamiento programado se despacha una sola vez aunque haya varias réplicas.",{"_6944":122285,"_42621":122227,"_30085":198136,"_5":21646,"_28538":198005,"_5847":198137},[],"No se ejecutó aquí. Un pack puede exigir que un dispositivo ya tenga otro pack, o un módulo, en una versión mínima. La regla vive en el pack que lanzas. Los dispositivos que no la cumplen se dejan fuera, y la simulación los lista:",{"_6944":122286,"_42621":122227,"_30085":198139,"_5":21646,"_28538":198005,"_5847":198140},[],"Cada fallo indica el `device_id`, el `distribution_set_name` (y `module_key` en una regla de módulo), la `current_version` que tiene el dispositivo (vacía si no tiene ninguna) y la restricción `required`, por ejemplo `>=1.0.0`. Usa `required_module_key` con un valor `type:name` para exigir un módulo en su lugar. `force_preconditions: true` en el cuerpo del lanzamiento despliega a todos los dispositivos de todos modos y registra los fallos.",{"_6944":122287,"_42621":122227,"_30085":198142,"_5":21646,"_28538":198009,"_5847":198143},[],"No se ejecutó aquí. `force-version` lanza un solo dispositivo a una versión exacta de un pack, fuera de cualquier campaña, y responde `202`. El dispositivo debe ser miembro del grupo del pack:",{"_6944":122288,"_42621":122227,"_30085":198145,"_5":21646,"_28538":198009,"_5847":198146},[],"Sin `workflow`, un pack `swu` usa `phased`. Solo se puede forzar la versión actual del pack, salvo que el pack se haya creado con `allow_previous_version_download`.",{"_6944":122289,"_42621":122227,"_30085":198148,"_5":21646,"_28538":198013,"_5847":198149},[],"La versión debe ser mayor que la actual, y el pack conserva su id. La nueva versión empieza como `draft`. Los enlaces de artefactos y la composición de módulos se heredan, pero el sw-description no: súbelo de nuevo. Después compila con `selected_artifact_ids` (una compilación sustituye los enlaces heredados por los que selecciones), tras subir una nueva versión del artefacto si el archivo cambió.",{"_6944":122290,"_42621":122227,"_30085":198151,"_5":21646,"_28538":198017,"_5847":198152},[],"Una sola clave cifra el `.swu` para todos los dispositivos. El sw-description debe marcar los archivos que se cifran con `encrypted = true;`. Usa un pack distinto para cada variante de cifrado: una nueva versión hereda los ajustes de cifrado de la anterior, y una compilación sin cifrado no los borra. Recompilar un pack ya compilado con otros ajustes también deja campos obsoletos. Consulta Limitaciones.",{"_6944":122291,"_42621":122227,"_30085":198154,"_5":21646,"_28538":198017,"_5847":198155},[],"Esta función auxiliar crea un pack, sube un sw-description que marca su archivo con `encrypted = true;` y sube el artefacto. Imprime el id del artefacto.",{"_6944":122292,"_42621":122227,"_30085":198157,"_5":21646,"_28538":198017,"_5847":198158},[],"El pack informa entonces `\"encryption_mode\":\"shared\"`. El dispositivo necesita la misma clave y el mismo algoritmo. Consulta Firma y cifrado.",{"_6944":122293,"_42621":122227,"_30085":198160,"_5":21646,"_28538":198021,"_5847":198161},[],"Cada dispositivo recibe su propio paquete y su propia clave. Es otro pack, compilado con la misma función auxiliar. El sw-description debe marcar un archivo con `encrypted = true;`, o la compilación se rechaza.",{"_6944":122294,"_42621":122227,"_30085":198163,"_5":21646,"_28538":198021,"_5847":198164},[],"Si un dispositivo no tiene clave en el momento de la compilación, la compilación termina bien y el pack registra el hueco. Si **ningún** dispositivo tiene clave, la compilación falla.",{"_6944":122295,"_42621":122227,"_30085":198166,"_5":21646,"_28538":198021,"_5847":198167},[],"Un lanzamiento sobre ese pack se rechaza, simulaciones incluidas, y `force_preconditions` no lo anula:",{"_6944":122296,"_42621":122227,"_30085":198169,"_5":21646,"_28538":198021,"_5847":198170},[],"La cobertura se registra cuando se compila el pack, así que asignar la clave que falta no basta. Compila el pack de nuevo (una nueva versión) con una clave para cada dispositivo.",{"_6944":122297,"_42621":122227,"_30085":198172,"_5":21646,"_28538":198025,"_5847":198173},[],"Añade los campos de firma con KMS al cuerpo de la compilación. Necesitan una clave de firma y un certificado en el KMS de Lamassu, con `kms_endpoint` y `sign_script_path` configurados. Esta petición no se ejecutó aquí, porque necesita un KMS. Consulta Firma y cifrado.",{"_6944":122298,"_42621":122227,"_30085":198175,"_5":21646,"_28538":198029,"_5847":194415},[],{"_6944":122299,"_42621":122227,"_30085":198177,"_5":21646,"_28538":198029,"_5847":197873},[],{"_6944":122300,"_42621":122227,"_30085":198179,"_5":21646,"_28538":198029,"_5847":198180},[],"`409` en `artifact/upload` o `artifact/link`",{"_6944":122301,"_42621":122227,"_30085":198182,"_5":21646,"_28538":198029,"_5847":198183},[],"La versión del pack ya está `built`. Crea una nueva versión con `POST .../new`",{"_6944":122302,"_42621":122227,"_30085":198185,"_5":21646,"_28538":198029,"_5847":198186},[],"`409` en `POST .../distribution-sets`",{"_6944":122303,"_42621":122227,"_30085":198188,"_5":21646,"_28538":198029,"_5847":198189},[],"Ya existe un pack con ese nombre en el grupo",{"_6944":122304,"_42621":122227,"_30085":198191,"_5":21646,"_28538":198029,"_5847":88737},[],{"_6944":122305,"_42621":122227,"_30085":198193,"_5":21646,"_28538":198029,"_5847":198194},[],"El nombre de un artefacto es global y su versión debe aumentar. Sube con una `version` mayor",{"_6944":122306,"_42621":122227,"_30085":198196,"_5":21646,"_28538":198029,"_5847":198197},[],"La compilación falla con un directorio de binarios vacío",{"_6944":122307,"_42621":122227,"_30085":198199,"_5":21646,"_28538":198029,"_5847":198200},[],"La compilación no recibió `selected_artifact_ids`",{"_6944":122308,"_42621":122227,"_30085":198202,"_5":21646,"_28538":198029,"_5847":198203},[],"`400` al crear un lanzamiento: el pack no se ha compilado",{"_6944":122309,"_42621":122227,"_30085":198205,"_5":21646,"_28538":198029,"_5847":198206},[],"Compílalo primero. Un pack en `build_failed` tampoco se puede lanzar",{"_6944":122310,"_42621":122227,"_30085":198208,"_5":21646,"_28538":198029,"_5847":88755},[],{"_6944":122311,"_42621":122227,"_30085":198210,"_5":21646,"_28538":198029,"_5847":198211},[],"Algunos dispositivos no tienen clave `firmware-encryption`. Asigna claves y compila una nueva versión",{"_6944":122312,"_42621":122227,"_30085":198213,"_5":21646,"_28538":198029,"_5847":198214},[],"`rollout` responde `400` con `rolls out automatically`",{"_6944":122313,"_42621":122227,"_30085":198216,"_5":21646,"_28538":198029,"_5847":198217},[],"El lanzamiento tiene `auto` activado y ya ha empezado. Espera al umbral de aprobación, o páusalo",{"_6944":122314,"_42621":122227,"_30085":198219,"_5":21646,"_28538":198029,"_5847":198220},[],"`rollout` responde `400` con `test device ... failed`",{"_6944":122315,"_42621":122227,"_30085":198222,"_5":21646,"_28538":198029,"_5847":198223},[],"El canario falló. Reanuda el lanzamiento para reintentarlo, o cancélalo",{"_6944":122316,"_42621":122227,"_30085":198225,"_5":21646,"_28538":198029,"_5847":198226},[],"`413` en una subida",{"_6944":122317,"_42621":122227,"_30085":198228,"_5":21646,"_28538":198029,"_5847":198229},[],"El archivo supera `max_artifact_size_mb` (10 GiB por defecto), o el límite del gateway o del ingress que hay delante del servicio es menor",{"_6944":122318,"_42621":122227,"_30085":198231,"_5":21646,"_28538":198029,"_5847":198232},[],"`501` en una ruta de módulo",{"_6944":122319,"_42621":122227,"_30085":198234,"_5":21646,"_28538":198029,"_5847":198235},[],"El modo native no tiene entregables por módulo. Compila el pack en su lugar",{"_6944":122320,"_42621":122227,"_30085":198237,"_5":21646,"_28538":198032,"_5847":197649},[],{"_6944":122321,"_42621":122227,"_30085":198239,"_5":21646,"_28538":198032,"_5847":198240},[],"Conectar un dispositivo, para saber qué debe implementar un dispositivo real",{"_6944":122322,"_42621":122227,"_30085":198242,"_5":21646,"_28538":198032,"_5847":197939},[],{"_6944":122323,"_42621":122227,"_30085":198244,"_5":21646,"_28538":198032,"_5847":191718},[],{"_6944":122324,"_42621":122324,"_5":22076,"_5847":198246,"_43101":198247,"_30085":198248,"_28538":122324},"Publica y lanza una actualización",[78004,189200,195583,196868],[],{"_6944":122325,"_42621":122324,"_30085":198250,"_5":21646,"_28538":122324,"_5847":198251},[],"Crea un paquete de actualización, adjunta un artefacto, construye el entregable y lánzalo por lotes a un grupo de dispositivos.",{"_6944":122326,"_42621":122324,"_5":43098,"_30085":198253,"_28538":198254,"_5847":187778},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/publish-and-roll-out#antes-de-empezar",{"_6944":122327,"_42621":122324,"_5":43098,"_30085":198256,"_28538":198257,"_5847":198258},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/publish-and-roll-out#1-crea-el-paquete","1\\. Crea el paquete",{"_6944":122328,"_42621":122324,"_5":43098,"_30085":198260,"_28538":198261,"_5847":198262},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/publish-and-roll-out#2-sube-el-sw-description-y-el-artefacto","2\\. Sube el sw-description y el artefacto",{"_6944":122329,"_42621":122324,"_5":43098,"_30085":198264,"_28538":198265,"_5847":198266},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/publish-and-roll-out#compón-un-paquete-con-varios-módulos-opcional","Compón un paquete con varios módulos (opcional)",{"_6944":122330,"_42621":122324,"_5":43098,"_30085":198268,"_28538":198269,"_5847":198270},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/publish-and-roll-out#3-construye-el-entregable","3\\. Construye el entregable",{"_6944":122331,"_42621":122324,"_5":43098,"_30085":198272,"_28538":198273,"_5847":198274},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/publish-and-roll-out#4-crea-el-lanzamiento","4\\. Crea el lanzamiento",{"_6944":122332,"_42621":122324,"_5":43098,"_30085":198276,"_28538":198277,"_5847":198278},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/publish-and-roll-out#5-lánzalo","5\\. Lánzalo",{"_6944":122333,"_42621":122324,"_5":43098,"_30085":198280,"_28538":198281,"_5847":195251},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/publish-and-roll-out#verifica-el-resultado",{"_6944":122334,"_42621":122324,"_5":43098,"_30085":198283,"_28538":198284,"_5847":198285},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/publish-and-roll-out#publica-la-siguiente-versión","Publica la siguiente versión",{"_6944":122335,"_42621":122324,"_5":43098,"_30085":198287,"_28538":198288,"_5847":195599},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/publish-and-roll-out#modo-hawkbit",{"_6944":122336,"_42621":122324,"_5":43098,"_30085":198290,"_28538":198291,"_5847":191718},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/publish-and-roll-out#solución-de-problemas",{"_6944":122337,"_42621":122324,"_5":43098,"_30085":198293,"_28538":198294,"_5847":190839},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/publish-and-roll-out#siguientes-pasos",{"_6944":122338,"_42621":122324,"_30085":198296,"_5":21646,"_28538":122324,"_5847":198297},[],"Esta guía lleva una actualización desde cero hasta los dispositivos: crea un paquete de actualización, adjunta un artefacto y un `sw-description`, construye el entregable, crea un lanzamiento (una campaña en el dashboard) y libéralo lote a lote. Las peticiones usan el modo nativo. El modo hawkBit construye y crea los paquetes en otro orden, que se describe en Modo hawkBit. Para hacer lo mismo con pantallas, sigue Usa el dashboard.",{"_6944":122339,"_42621":122324,"_30085":198299,"_5":21646,"_28538":198254,"_5847":198300},[],"El stack está en marcha y `curl localhost:10090/health` responde.",{"_6944":122340,"_42621":122324,"_30085":198302,"_5":21646,"_28538":198254,"_5847":198303},[],"Un grupo de dispositivos de Lamassu IoT que contenga los dispositivos que quieres actualizar. Su ID es `$GROUP`. Un paquete pertenece a un grupo y solo se puede lanzar a los dispositivos de ese grupo.",{"_6944":122341,"_42621":122324,"_30085":198305,"_5":21646,"_28538":198254,"_5847":198306},[],"El binario que vas a entregar y, para un paquete SWU, un fichero `sw-description`.",{"_6944":122342,"_42621":122324,"_30085":198308,"_5":21646,"_28538":198254,"_5847":198309},[],"Dispositivos que puedan recibir la actualización. Consulta Conecta un dispositivo.",{"_6944":122343,"_42621":122324,"_30085":198311,"_5":21646,"_28538":198254,"_5847":198312},[],"El servicio no tiene autenticación propia, así que estos ejemplos no envían ninguna. Pon delante una pasarela que autentique a quien llama: consulta Seguridad.",{"_6944":122344,"_42621":122324,"_30085":198314,"_5":21646,"_28538":198257,"_5847":198315},[],"La respuesta es `201` con el paquete, incluido su `id`. Un paquete empieza como `draft`.",{"_6944":122345,"_42621":122324,"_30085":198317,"_5":21646,"_28538":198257,"_5847":196084},[],{"_6944":122346,"_42621":122324,"_30085":198319,"_5":21646,"_28538":198257,"_5847":197254},[],{"_6944":122347,"_42621":122324,"_30085":198321,"_5":21646,"_28538":198257,"_5847":80957},[],{"_6944":122348,"_42621":122324,"_30085":198323,"_5":21646,"_28538":198257,"_5847":198324},[],"Obligatorio. Único dentro del grupo; un duplicado responde `409`. El modo nativo lo usa como segmento de ruta, así que solo puede contener letras, dígitos, `.`, `_` y `-` (sin espacios)",{"_6944":122349,"_42621":122324,"_30085":198326,"_5":21646,"_28538":198257,"_5847":88874},[],{"_6944":122350,"_42621":122324,"_30085":198328,"_5":21646,"_28538":198257,"_5847":198329},[],"Obligatorio. Semver estricto `x.y.z`, la defines tú",{"_6944":122351,"_42621":122324,"_30085":198331,"_5":21646,"_28538":198257,"_5847":88880},[],{"_6944":122352,"_42621":122324,"_30085":198333,"_5":21646,"_28538":198257,"_5847":198334},[],"Obligatorio en el cuerpo. Usa el mismo valor que en la ruta",{"_6944":122353,"_42621":122324,"_30085":198336,"_5":21646,"_28538":198257,"_5847":87447},[],{"_6944":122354,"_42621":122324,"_30085":198338,"_5":21646,"_28538":198257,"_5847":198339},[],"`rawfile` o `firmware`. Se registra en el paquete y se envía al dispositivo en el trabajo; el dashboard también ofrece `both` y `other`. No se valida al crear",{"_6944":122355,"_42621":122324,"_30085":198341,"_5":21646,"_28538":198257,"_5847":88891},[],{"_6944":122356,"_42621":122324,"_30085":198343,"_5":21646,"_28538":198257,"_5847":198344},[],"`swu` (por defecto) o `non-swu`. Un paquete `non-swu` entrega sus ficheros como un `.tar.gz` y usa el workflow `download-install`",{"_6944":122357,"_42621":122324,"_30085":198346,"_5":21646,"_28538":198257,"_5847":88897},[],{"_6944":122358,"_42621":122324,"_30085":198348,"_5":21646,"_28538":198257,"_5847":198349},[],"Opcional. Permite que los dispositivos descarguen versiones anteriores del paquete",{"_6944":122359,"_42621":122324,"_30085":198351,"_5":21646,"_28538":198257,"_5847":88903},[],{"_6944":122360,"_42621":122324,"_30085":198353,"_5":21646,"_28538":198257,"_5847":198354},[],"Opcional. Reglas que un dispositivo debe cumplir para recibir el paquete. Consulta Conceptos",{"_6944":122361,"_42621":122324,"_30085":198356,"_5":21646,"_28538":198257,"_5847":88909},[],{"_6944":122362,"_42621":122324,"_30085":198358,"_5":21646,"_28538":198257,"_5847":198359},[],"**Solo modo hawkBit**: la composición del paquete, como módulos del catálogo ya construidos. El modo nativo lo ignora",{"_6944":122363,"_42621":122324,"_30085":198361,"_5":21646,"_28538":198261,"_5847":198362},[],"El `sw-description` es un fichero de SWUpdate que enumera lo que instala el dispositivo. Su formato es el de SWUpdate, y la documentación de SWUpdate es la referencia. Cuando el servicio construye el `.swu`, `swugenerator` lee este fichero y los binarios preparados, así que el `filename` de cada imagen debe ser el nombre de un fichero subido. Un ejemplo mínimo:",{"_6944":122364,"_42621":122324,"_30085":198364,"_5":21646,"_28538":198261,"_5847":198365},[],"`swugenerator` rellena el `filename` final (con `.zlib` añadido, y `.enc` en los ficheros cifrados), el `sha256` y, en los ficheros cifrados, la propiedad `ivt`. Para una construcción cifrada, añade `encrypted = true;` a cada imagen que deba cifrarse. Dos reglas causan la mayoría de los fallos:",{"_6944":122365,"_42621":122324,"_30085":198367,"_5":21646,"_28538":198261,"_5847":198368},[],"`encrypted = true` solo debe aparecer en una construcción que aporte una clave (la construcción falla sin ella), y una construcción por dispositivo rechaza una descripción en la que ninguna imagen lo tenga.",{"_6944":122366,"_42621":122324,"_30085":198370,"_5":21646,"_28538":198261,"_5847":198371},[],"Las imágenes comprimidas necesitan `decompressed-size`.",{"_6944":122367,"_42621":122324,"_30085":198373,"_5":21646,"_28538":198261,"_5847":198374},[],"Si construyes tú el `.swu` y lo subes como entregable prefabricado, rellenas tú mismo `sha256` e `ivt`, y el `sha256` es sobre los bytes que descarga el dispositivo, porque SWUpdate calcula el hash antes de descifrar.",{"_6944":122368,"_42621":122324,"_30085":198376,"_5":21646,"_28538":198261,"_5847":198377},[],"`artifact_name` es por defecto el nombre del fichero sin su extensión. `version` es opcional; cuando subes un fichero nuevo con un `artifact_name` existente, debe ser estrictamente mayor que la versión más alta ya guardada con ese nombre.",{"_6944":122369,"_42621":122324,"_30085":198379,"_5":21646,"_28538":198261,"_5847":198380},[],"El artefacto se guarda como artefacto global y se enlaza a este paquete. La respuesta contiene su `id`. Para reutilizar un artefacto ya subido, enlázalo con `POST .../artifact/link` y `{\"artifact_id\":\"<id>\"}`.",{"_6944":122370,"_42621":122324,"_30085":198382,"_5":21646,"_28538":198261,"_5847":198383},[],"El fichero más grande admitido es `max_artifact_size_mb` (10 GiB por defecto). Una subida mayor responde `413`.",{"_6944":122371,"_42621":122324,"_30085":198385,"_5":21646,"_28538":198261,"_5847":198386},[],"Una vez construido el paquete, las subidas y los enlaces responden `409`: crea antes una versión nueva.",{"_6944":122372,"_42621":122324,"_30085":198388,"_5":21646,"_28538":198265,"_5847":198389},[],"Un paquete nativo es una composición de módulos de software: un módulo `os` más cualquier número de módulos `application`. Un paquete sin módulos declarados se comporta como un único módulo `os` implícito que posee los artefactos que subiste antes. Para añadir un módulo de aplicación y darle sus propios ficheros:",{"_6944":122373,"_42621":122324,"_30085":198391,"_5":21646,"_28538":198265,"_5847":198392},[],"La clave del módulo es `<type>:<name>`. El modo nativo sigue construyendo un único `.swu` para todo el paquete, a partir de los artefactos de todos los módulos y del único `sw-description` del paquete. También puedes componer desde un módulo que ya existe con `POST .../modules/import`; en modo nativo eso copia el módulo, mientras que en modo hawkBit enlaza el mismo módulo. Consulta Conceptos para el modelo.",{"_6944":122374,"_42621":122324,"_30085":198394,"_5":21646,"_28538":198269,"_5847":198395},[],"`selected_artifact_ids` es lo que mete artefactos en la construcción: solo se preparan los listados. Con una lista vacía la construcción falla porque no se preparó ningún binario, y el paquete pasa a `build_failed`. Toma el ID de la respuesta de la subida del artefacto, o de `GET $API/artifacts`.",{"_6944":122375,"_42621":122324,"_30085":198397,"_5":21646,"_28538":198269,"_5847":198398},[],"El cuerpo anterior construye un `.swu` sin cifrar y sin firmar. Para firmar o cifrar, añade campos como se describe en Firma y cifrado.",{"_6944":122376,"_42621":122324,"_30085":198400,"_5":21646,"_28538":198269,"_5847":198401},[],"Para un paquete `non-swu`, llama a `POST .../package` en lugar de `.../swu`. Sin `selected_artifact_ids` empaqueta los artefactos enlazados al paquete.",{"_6944":122377,"_42621":122324,"_30085":198403,"_5":21646,"_28538":198269,"_5847":198404},[],"Para entregar un fichero que construiste por tu cuenta, súbelo a `POST .../swu/upload` (o `.../package/upload`) como un `file` multipart. Se guarda y se sirve sin cambios, así que ya debe estar firmado y cifrado como esperan tus dispositivos. Solo modo nativo.",{"_6944":122378,"_42621":122324,"_30085":198406,"_5":21646,"_28538":198269,"_5847":198407},[],"Cuando la construcción termina bien, el paquete pasa a `built` y sus artefactos y su composición son inmutables. Si falla, el paquete pasa a `build_failed` y `last_build_error` guarda el motivo: corrige la entrada y construye de nuevo. Una construcción que se ejecuta mientras otra tiene bloqueado el mismo paquete responde `409`.",{"_6944":122379,"_42621":122324,"_30085":198409,"_5":21646,"_28538":198273,"_5847":198410},[],"El lanzamiento apunta a todos los dispositivos del grupo en el momento de crearlo, y necesita un paquete construido. La respuesta es `201` con `launch_id`, `precondition_failures`, `forced` y, en modo hawkBit, `superseded_devices` y `never_seen_devices`.",{"_6944":122380,"_42621":122324,"_30085":198412,"_5":21646,"_28538":198273,"_5847":196084},[],{"_6944":122381,"_42621":122324,"_30085":198414,"_5":21646,"_28538":198273,"_5847":197254},[],{"_6944":122382,"_42621":122324,"_30085":198416,"_5":21646,"_28538":198273,"_5847":88970},[],{"_6944":122383,"_42621":122324,"_30085":198418,"_5":21646,"_28538":198273,"_5847":198419},[],"Obligatorios. `rollout_value` debe ser mayor que 0",{"_6944":122384,"_42621":122324,"_30085":198421,"_5":21646,"_28538":198273,"_5847":86542},[],{"_6944":122385,"_42621":122324,"_30085":198423,"_5":21646,"_28538":198273,"_5847":198424},[],"`percentage` del grupo por lote, o `fixed` (un número de dispositivos). Cualquier valor distinto de `percentage` se interpreta como un número",{"_6944":122386,"_42621":122324,"_30085":198426,"_5":21646,"_28538":198273,"_5847":86554},[],{"_6944":122387,"_42621":122324,"_30085":198428,"_5":21646,"_28538":198273,"_5847":198429},[],"Nativo: `direct`, `phased`, `download-install`, o el nombre completo de otro workflow registrado en WFX (`GET $API/workflows`). hawkBit: `phased` crea una acción soft, cualquier otro valor una forced",{"_6944":122388,"_42621":122324,"_30085":198431,"_5":21646,"_28538":198273,"_5847":86560},[],{"_6944":122389,"_42621":122324,"_30085":198433,"_5":21646,"_28538":198273,"_5847":198434},[],"Canario opcional: un miembro del grupo que se actualiza primero y debe tener éxito antes de tocar ningún otro dispositivo",{"_6944":122390,"_42621":122324,"_30085":198436,"_5":21646,"_28538":198273,"_5847":88991},[],{"_6944":122391,"_42621":122324,"_30085":198438,"_5":21646,"_28538":198273,"_5847":198439},[],"Opcionales. `auto` libera los lotes siguientes por sí solo. Ambos umbrales son porcentajes de 0 a 100",{"_6944":122392,"_42621":122324,"_30085":198441,"_5":21646,"_28538":198273,"_5847":86584},[],{"_6944":122393,"_42621":122324,"_30085":198443,"_5":21646,"_28538":198273,"_5847":198444},[],"Hora RFC 3339 opcional. El primer lote se retrasa hasta entonces",{"_6944":122394,"_42621":122324,"_30085":198446,"_5":21646,"_28538":198273,"_5847":89002},[],{"_6944":122395,"_42621":122324,"_30085":198448,"_5":21646,"_28538":198273,"_5847":198449},[],"Opcionales. `name` es por defecto el nombre del paquete. `weight` (de 0 a 1000) se guarda pero nada lo lee",{"_6944":122396,"_42621":122324,"_30085":198451,"_5":21646,"_28538":198273,"_5847":89008},[],{"_6944":122397,"_42621":122324,"_30085":198453,"_5":21646,"_28538":198273,"_5847":198454},[],"Despliega también en los dispositivos que no cumplen las precondiciones del paquete. Los fallos se registran igualmente",{"_6944":122398,"_42621":122324,"_30085":198456,"_5":21646,"_28538":198273,"_5847":198457},[],"Elige el workflow según el paquete:",{"_6944":122399,"_42621":122324,"_30085":198459,"_5":21646,"_28538":198273,"_5847":198460},[],"Usa `direct` para paquetes SWU salvo que gestiones WFX tú mismo. El workflow `phased` tiene pasos que WFX o un operador deben confirmar, y este servicio no los avanza. Un lanzamiento `phased` se queda en su primer estado hasta que alguien lo confirma a través de WFX.",{"_6944":122400,"_42621":122324,"_30085":198462,"_5":21646,"_28538":198273,"_5847":198463},[],"Para un paquete `non-swu`, pon `workflow_type` a `download-install`. El lanzamiento usa el valor que indicas tal cual, así que `direct` ejecutaría el workflow SWU y la actualización parecería atascada cuando el dispositivo ya terminó.",{"_6944":122401,"_42621":122324,"_30085":198465,"_5":21646,"_28538":198273,"_5847":198466},[],"En modo hawkBit no hay WFX. La elección es el modo de instalación de hawkBit.",{"_6944":122402,"_42621":122324,"_30085":198468,"_5":21646,"_28538":198273,"_5847":198469},[],"Si el paquete tiene precondiciones, previsualiza qué dispositivos cumplen antes de crear nada añadiendo `?dry_run=true` a la misma petición. Responde `200` con `qualifying_devices`, `precondition_failures`, `superseded_devices` y `never_seen_devices`, y no crea nada.",{"_6944":122403,"_42621":122324,"_30085":198471,"_5":21646,"_28538":198273,"_5847":198472},[],"**Umbrales de aprobación y de error.** Con `auto: true`, el siguiente lote se libera cuando al menos `approval_threshold` por ciento del lote actual ha tenido éxito (0 significa el lote completo). En modo nativo, la campaña se cancela cuando `error_threshold` por ciento de todos sus dispositivos ha fallado; en modo hawkBit se detiene cuando falla más de ese porcentaje de un lote. En cambio, un canario fallido pausa una campaña nativa: reanúdala para reintentar el canario.",{"_6944":122404,"_42621":122324,"_30085":198474,"_5":21646,"_28538":198273,"_5847":198475},[],"Toma el ID del lanzamiento de la respuesta. Es `$LAUNCH` más abajo.",{"_6944":122405,"_42621":122324,"_30085":198477,"_5":21646,"_28538":198277,"_5847":198478},[],"Sin `auto`, cada llamada despacha el siguiente lote (primero el canario, si lo definiste). Con `auto: true`, llama una vez para iniciar el primer lote: el servicio libera después los demás lotes por sí solo al cumplirse el umbral de aprobación, y las llamadas posteriores responden `400`. Si el lanzamiento tiene un `scheduled_at` futuro, la llamada se acepta pero no hace nada: el servicio lo inicia solo a esa hora (el modo nativo comprueba cada 30 segundos; en hawkBit inicia el rollout el propio planificador de hawkBit).",{"_6944":122406,"_42621":122324,"_30085":198480,"_5":21646,"_28538":198277,"_5847":198481},[],"Un lanzamiento nativo pasa por estos estados:",{"_6944":122407,"_42621":122324,"_30085":198483,"_5":21646,"_28538":198277,"_5847":198484},[],"Puedes dirigir un lanzamiento mientras se ejecuta:",{"_6944":122408,"_42621":122324,"_30085":198486,"_5":21646,"_28538":198277,"_5847":194421},[],{"_6944":122409,"_42621":122324,"_30085":198488,"_5":21646,"_28538":198277,"_5847":198489},[],"Petición",{"_6944":122410,"_42621":122324,"_30085":198491,"_5":21646,"_28538":198277,"_5847":198492},[],"Efecto",{"_6944":122411,"_42621":122324,"_30085":198494,"_5":21646,"_28538":198277,"_5847":198495},[],"Pausar",{"_6944":122412,"_42621":122324,"_30085":198497,"_5":21646,"_28538":198277,"_5847":89054},[],{"_6944":122413,"_42621":122324,"_30085":198499,"_5":21646,"_28538":198277,"_5847":198500},[],"No hay más lotes hasta reanudar. Los dispositivos que ya están en curso terminan",{"_6944":122414,"_42621":122324,"_30085":198502,"_5":21646,"_28538":198277,"_5847":198503},[],"Reanudar",{"_6944":122415,"_42621":122324,"_30085":198505,"_5":21646,"_28538":198277,"_5847":89063},[],{"_6944":122416,"_42621":122324,"_30085":198507,"_5":21646,"_28538":198277,"_5847":198508},[],"Nativo: una campaña automática libera su siguiente lote de inmediato si el actual ya cumplió el umbral, y reanudar tras un canario fallido lo reintenta",{"_6944":122417,"_42621":122324,"_30085":198510,"_5":21646,"_28538":198277,"_5847":198511},[],"Reintentar dispositivos fallidos",{"_6944":122418,"_42621":122324,"_30085":198513,"_5":21646,"_28538":198277,"_5847":89072},[],{"_6944":122419,"_42621":122324,"_30085":198515,"_5":21646,"_28538":198277,"_5847":198516},[],"Vuelve a poner en cola los dispositivos fallidos y los despacha. Responde `400` si no hay ninguno",{"_6944":122420,"_42621":122324,"_30085":198518,"_5":21646,"_28538":198277,"_5847":198519},[],"Cancelar (terminal)",{"_6944":122421,"_42621":122324,"_30085":198521,"_5":21646,"_28538":198277,"_5847":89081},[],{"_6944":122422,"_42621":122324,"_30085":198523,"_5":21646,"_28538":198277,"_5847":198524},[],"Los dispositivos pendientes no se actualizan",{"_6944":122423,"_42621":122324,"_30085":198526,"_5":21646,"_28538":198277,"_5847":198527},[],"Marcar como completado (terminal)",{"_6944":122424,"_42621":122324,"_30085":198529,"_5":21646,"_28538":198277,"_5847":89090},[],{"_6944":122425,"_42621":122324,"_30085":198531,"_5":21646,"_28538":198277,"_5847":198532},[],"No disponible en modo hawkBit",{"_6944":122426,"_42621":122324,"_30085":198534,"_5":21646,"_28538":198277,"_5847":198535},[],"Leer o cambiar la estrategia",{"_6944":122427,"_42621":122324,"_30085":198537,"_5":21646,"_28538":198277,"_5847":89099},[],{"_6944":122428,"_42621":122324,"_30085":198539,"_5":21646,"_28538":198277,"_5847":198540},[],"Cambiarla no está disponible en modo hawkBit",{"_6944":122429,"_42621":122324,"_30085":198542,"_5":21646,"_28538":198277,"_5847":198543},[],"En modo hawkBit, un rollout solo se puede pausar después de que haya empezado a despachar.",{"_6944":122430,"_42621":122324,"_30085":198545,"_5":21646,"_28538":198281,"_5847":198546},[],"El listado de lanzamientos responde `{\"list\":[...],\"next\":\"...\"}`. Un lanzamiento ha terminado cuando `pending_count` y `active_count` valen cero; un lanzamiento nativo pone entonces su `status` en `completed` por sí solo. Los dispositivos terminan como `completed` (estado del trabajo `ACTIVATED`, o `INSTALLED` para `non-swu`) o `failed` (`TERMINATED`).",{"_6944":122431,"_42621":122324,"_30085":198548,"_5":21646,"_28538":198284,"_5847":198549},[],"Una versión construida de un paquete es inmutable. Para cambiarla, crea la versión siguiente, sube lo que haya cambiado y construye de nuevo:",{"_6944":122432,"_42621":122324,"_30085":198551,"_5":21646,"_28538":198284,"_5847":198552},[],"La versión debe ser estrictamente mayor que la actual. La versión nueva empieza sin construir y arrastra los artefactos actuales.",{"_6944":122433,"_42621":122324,"_30085":198554,"_5":21646,"_28538":198284,"_5847":198555},[],"Para actualizar un dispositivo a una versión exacta sin campaña, usa `POST $API/devices/<device-id>/force-version` con `{\"distribution_set_id\":\"<pack id>\",\"version\":\"1.1.0\"}`; en modo nativo crea un lanzamiento de un solo dispositivo y usa por defecto el workflow `phased` para paquetes SWU (`download-install` para `non-swu`), salvo que indiques un `workflow`.",{"_6944":122434,"_42621":122324,"_30085":198557,"_5":21646,"_28538":198288,"_5847":198558},[],"Los paquetes de hawkBit se ensamblan a partir de módulos del catálogo ya construidos, así que los pasos 2 y 3 del lado del paquete pasan al catálogo:",{"_6944":122435,"_42621":122324,"_30085":198560,"_5":21646,"_28538":198288,"_5847":198561},[],"Crea el módulo: `POST $API/softwaremodules` con `type` (`os` o `application`), `name`, `version` y un `delivery_intent`: `swu-build`, `swu-prebuilt` o `raw`. `undecided` se acepta, pero un módulo no puede entrar en un paquete hasta que elijas.",{"_6944":122436,"_42621":122324,"_30085":198563,"_5":21646,"_28538":198288,"_5847":198564},[],"Sube el fichero con `POST $API/softwaremodules/by-id/<id>/artifacts`. Para `swu-build`, sube también el `sw-description` a `.../descriptor` y llama a `POST $API/softwaremodules/by-id/<id>/build`. Para `swu-prebuilt`, subir el `.swu` es la construcción. Para `raw`, llama a `.../build` para que los ficheros sean el entregable; firmar y cifrar es opcional.",{"_6944":122437,"_42621":122324,"_30085":198566,"_5":21646,"_28538":198288,"_5847":198567},[],"Crea el paquete con `\"modules\":[{\"source_module_id\":\"<id>\"}]`. Se crea ya construido.",{"_6944":122438,"_42621":122324,"_30085":198569,"_5":21646,"_28538":198288,"_5847":198570},[],"Después continúa en el paso 4. Los detalles, incluidas las intenciones de entrega, están en Modo hawkBit, y una secuencia completa de peticiones en la guía curl de hawkBit.",{"_6944":122439,"_42621":122324,"_30085":198572,"_5":21646,"_28538":198291,"_5847":194415},[],{"_6944":122440,"_42621":122324,"_30085":198574,"_5":21646,"_28538":198291,"_5847":196825},[],{"_6944":122441,"_42621":122324,"_30085":198576,"_5":21646,"_28538":198291,"_5847":198577},[],"Una llamada devuelve `501 Not Implemented`",{"_6944":122442,"_42621":122324,"_30085":198579,"_5":21646,"_28538":198291,"_5847":198580},[],"El backend activo no la admite. Consulta Capacidades",{"_6944":122443,"_42621":122324,"_30085":198582,"_5":21646,"_28538":198291,"_5847":198583},[],"`400` «has not been built yet» al crear un lanzamiento",{"_6944":122444,"_42621":122324,"_30085":198585,"_5":21646,"_28538":198291,"_5847":198586},[],"El paquete está en `draft` o `build_failed`. Constrúyelo primero",{"_6944":122445,"_42621":122324,"_30085":198588,"_5":21646,"_28538":198291,"_5847":198589},[],"`400` sobre dispositivos sin paquete",{"_6944":122446,"_42621":122324,"_30085":198591,"_5":21646,"_28538":198291,"_5847":198592},[],"Un paquete cifrado por dispositivo se construyó solo para algunos. El mensaje nombra los dispositivos sin clave; corrígelos y reconstruye",{"_6944":122447,"_42621":122324,"_30085":198594,"_5":21646,"_28538":198291,"_5847":198595},[],"`400` «group has no devices to launch to»",{"_6944":122448,"_42621":122324,"_30085":198597,"_5":21646,"_28538":198291,"_5847":198598},[],"El grupo no tiene miembros, o ninguno cumple. Revisa los criterios del grupo y las precondiciones del paquete",{"_6944":122449,"_42621":122324,"_30085":198600,"_5":21646,"_28538":198291,"_5847":198601},[],"La construcción devuelve un error sobre `encrypted = true`",{"_6944":122450,"_42621":122324,"_30085":198603,"_5":21646,"_28538":198291,"_5847":198604},[],"Una construcción por dispositivo necesita al menos una imagen marcada con `encrypted = true` en el `sw-description`",{"_6944":122451,"_42621":122324,"_30085":198606,"_5":21646,"_28538":198291,"_5847":198607},[],"La construcción SWU falla con «failed to read binaries directory» o «binaries directory is empty»",{"_6944":122452,"_42621":122324,"_30085":198609,"_5":21646,"_28538":198291,"_5847":198610},[],"No se preparó nada: falta `selected_artifact_ids` en el cuerpo de la construcción",{"_6944":122453,"_42621":122324,"_30085":198612,"_5":21646,"_28538":198291,"_5847":198613},[],"`409` al subir, enlazar o construir",{"_6944":122454,"_42621":122324,"_30085":198615,"_5":21646,"_28538":198291,"_5847":198616},[],"La versión ya está construida (crea una versión nueva), o otra petición está construyendo el mismo paquete",{"_6944":122455,"_42621":122324,"_30085":198618,"_5":21646,"_28538":198291,"_5847":198619},[],"`413` al subir",{"_6944":122456,"_42621":122324,"_30085":198621,"_5":21646,"_28538":198291,"_5847":198622},[],"El fichero supera `max_artifact_size_mb`",{"_6944":122457,"_42621":122324,"_30085":198624,"_5":21646,"_28538":198291,"_5847":198625},[],"El lanzamiento responde `400` «paused» o «rolls out automatically»",{"_6944":122458,"_42621":122324,"_30085":198627,"_5":21646,"_28538":198291,"_5847":198628},[],"Reanuda el lanzamiento, o deja que la campaña automática libere sus propios lotes",{"_6944":122459,"_42621":122324,"_30085":198630,"_5":21646,"_28538":198291,"_5847":198631},[],"El lanzamiento sigue en `running` sin progreso de dispositivos (hawkBit)",{"_6944":122460,"_42621":122324,"_30085":198633,"_5":21646,"_28538":198291,"_5847":198634},[],"Los dispositivos nunca contactaron con hawkBit. Un grupo de rollout no avanza hasta que sus dispositivos consultan",{"_6944":122461,"_42621":122324,"_30085":198636,"_5":21646,"_28538":198291,"_5847":198637},[],"Los dispositivos no pueden descargar el `.swu` (nativo)",{"_6944":122462,"_42621":122324,"_30085":198639,"_5":21646,"_28538":198291,"_5847":198640},[],"`update_domain` no es alcanzable desde el dispositivo, o no es la base completa `.../updates/v1/` con barra final. La URL de descarga se fija al construir el paquete, así que reconstruye tras cambiarla",{"_6944":122463,"_42621":122324,"_30085":198642,"_5":21646,"_28538":198291,"_5847":198643},[],"Falla la creación del paquete en modo hawkBit",{"_6944":122464,"_42621":122324,"_30085":198645,"_5":21646,"_28538":198291,"_5847":198646},[],"Ya existe un paquete con ese nombre en el grupo (`409`), un módulo no está construido o no se enlazó con `source_module_id`, o el nombre y la versión de un módulo anterior están reservados. Sube la versión",{"_6944":122465,"_42621":122324,"_30085":198648,"_5":21646,"_28538":198291,"_5847":198649},[],"Un lanzamiento `non-swu` ejecuta los estados SWU",{"_6944":122466,"_42621":122324,"_30085":198651,"_5":21646,"_28538":198291,"_5847":198652},[],"Se creó con `workflow_type: direct`. Usa `download-install`",{"_6944":122467,"_42621":122324,"_30085":198654,"_5":21646,"_28538":198294,"_5847":198655},[],"<Card title=\"Conceptos\" href=\"/docs/platform/updates/concepts\" description=\"Paquetes, módulos, lanzamientos, workflows y precondiciones.\" />",{"_6944":122468,"_42621":122324,"_30085":198657,"_5":21646,"_28538":198294,"_5847":198658},[],"<Card title=\"Guía curl nativa\" href=\"/docs/platform/updates/guides/native-curl\" description=\"Todas las peticiones del flujo nativo, en orden.\" />",{"_6944":122469,"_42621":122324,"_30085":198660,"_5":21646,"_28538":198294,"_5847":198661},[],"<Card title=\"Referencia de la API\" href=\"/docs/platform/updates/reference/api\" description=\"Todas las rutas, cuerpos y códigos de estado.\" />",{"_6944":122470,"_42621":122470,"_5":22076,"_5847":195599,"_43101":198663,"_30085":198664,"_28538":122470},[78004,189200,195583,193958],[],{"_6944":122471,"_42621":122470,"_30085":198666,"_5":21646,"_28538":122470,"_5847":198667},[],"Ejecuta la misma API de Lamassu Updates sobre un servidor Eclipse hawkBit, qué guarda el adaptador en Postgres y qué difiere del modo native.",{"_6944":122472,"_42621":122470,"_5":43098,"_30085":198669,"_28538":198670,"_5847":198671},[],"/docs/pr-preview/pr-56/es/platform/updates/hawkbit-mode#requisitos-previos","Requisitos previos",{"_6944":122473,"_42621":122470,"_5":43098,"_30085":198673,"_28538":198674,"_5847":198675},[],"/docs/pr-preview/pr-56/es/platform/updates/hawkbit-mode#actívalo","Actívalo",{"_6944":122474,"_42621":122470,"_5":43098,"_30085":198677,"_28538":198678,"_5847":198679},[],"/docs/pr-preview/pr-56/es/platform/updates/hawkbit-mode#ejecútalo-en-local","Ejecútalo en local",{"_6944":122475,"_42621":122470,"_5":43098,"_30085":198681,"_28538":198682,"_5847":198683},[],"/docs/pr-preview/pr-56/es/platform/updates/hawkbit-mode#crear-y-construir-un-paquete","Crear y construir un paquete",{"_6944":122476,"_42621":122470,"_5":43098,"_30085":198685,"_28538":198686,"_5847":198687},[],"/docs/pr-preview/pr-56/es/platform/updates/hawkbit-mode#crea-el-módulo-en-el-catálogo","Crea el módulo en el catálogo",{"_6944":122477,"_42621":122470,"_5":43098,"_30085":198689,"_28538":198690,"_5847":198691},[],"/docs/pr-preview/pr-56/es/platform/updates/hawkbit-mode#sube-sus-ficheros","Sube sus ficheros",{"_6944":122478,"_42621":122470,"_5":43098,"_30085":198693,"_28538":198694,"_5847":198695},[],"/docs/pr-preview/pr-56/es/platform/updates/hawkbit-mode#haz-que-quede-construido","Haz que quede construido",{"_6944":122479,"_42621":122470,"_5":43098,"_30085":198697,"_28538":198698,"_5847":198699},[],"/docs/pr-preview/pr-56/es/platform/updates/hawkbit-mode#crea-el-paquete-a-partir-de-los-módulos-construidos","Crea el paquete a partir de los módulos construidos",{"_6944":122480,"_42621":122470,"_5":43098,"_30085":198701,"_28538":198702,"_5847":198703},[],"/docs/pr-preview/pr-56/es/platform/updates/hawkbit-mode#correspondencia","Correspondencia",{"_6944":122481,"_42621":122470,"_5":43098,"_30085":198705,"_28538":198706,"_5847":198707},[],"/docs/pr-preview/pr-56/es/platform/updates/hawkbit-mode#qué-vive-dónde","Qué vive dónde",{"_6944":122482,"_42621":122470,"_5":43098,"_30085":198709,"_28538":198710,"_5847":198711},[],"/docs/pr-preview/pr-56/es/platform/updates/hawkbit-mode#dispositivos-y-targets","Dispositivos y targets",{"_6944":122483,"_42621":122470,"_5":43098,"_30085":198713,"_28538":198714,"_5847":198715},[],"/docs/pr-preview/pr-56/es/platform/updates/hawkbit-mode#autenticación-de-dispositivos-en-producción","Autenticación de dispositivos en producción",{"_6944":122484,"_42621":122470,"_5":43098,"_30085":198717,"_28538":198718,"_5847":198719},[],"/docs/pr-preview/pr-56/es/platform/updates/hawkbit-mode#almacenamiento-de-artefactos-y-descargas","Almacenamiento de artefactos y descargas",{"_6944":122485,"_42621":122470,"_5":43098,"_30085":198721,"_28538":198722,"_5847":198723},[],"/docs/pr-preview/pr-56/es/platform/updates/hawkbit-mode#qué-difiere-del-modo-native","Qué difiere del modo native",{"_6944":122486,"_42621":122470,"_5":43098,"_30085":198725,"_28538":198726,"_5847":198727},[],"/docs/pr-preview/pr-56/es/platform/updates/hawkbit-mode#escalado","Escalado",{"_6944":122487,"_42621":122470,"_30085":198729,"_5":21646,"_28538":122470,"_5847":198730},[],"En modo `hawkbit`, Lamassu Updates sirve la misma API `/updates/v1` sobre un servidor Eclipse hawkBit en lugar de su propio backend basado en Postgres, WFX y SymKMS. El servicio se convierte en un **adaptador**: hawkBit es el dueño de los paquetes, módulos, rollouts y trabajos, y se lee en vivo en cada petición, y los dispositivos hablan directamente con hawkBit.",{"_6944":122488,"_42621":122470,"_30085":198732,"_5":21646,"_28538":122470,"_5847":198733},[],"Úsalo cuando hawkBit ya sea el backend de actualizaciones de tu flota, o para comparar los dos backends. Para elegir entre ellos, consulta la descripción general.",{"_6944":122489,"_42621":122470,"_30085":198735,"_5":21646,"_28538":198670,"_5847":198736},[],"Un servidor hawkBit (1.x) accesible y sus credenciales de la API de gestión.",{"_6944":122490,"_42621":122470,"_30085":198738,"_5":21646,"_28538":198670,"_5847":198739},[],"Postgres para este servicio. Consulta Qué vive dónde.",{"_6944":122491,"_42621":122470,"_30085":198741,"_5":21646,"_28538":198670,"_5847":198742},[],"Dispositivos que consultan hawkBit mediante el módulo `suricatta` de SWUpdate. Con `dms_endpoint` definido, el propio servicio crea y etiqueta los targets de hawkBit de los dispositivos de un grupo (consulta Dispositivos y targets). Sin él, los registras y etiquetas tú en hawkBit.",{"_6944":122492,"_42621":122470,"_30085":198744,"_5":21646,"_28538":198674,"_5847":198745},[],"`mode` vale `native` cuando no está definido, así que las configuraciones existentes no se ven afectadas. El arranque falla si `hawkbit.base_url` o `storage.hostname` están vacíos. Un hawkBit inaccesible no detiene el arranque: se manifiesta como errores en las peticiones.",{"_6944":122493,"_42621":122470,"_30085":198747,"_5":21646,"_28538":198674,"_5847":198748},[],"Para construir entregables en este modo, añade encima lo que necesites. Todo se lee una sola vez al arrancar:",{"_6944":122494,"_42621":122470,"_30085":198750,"_5":21646,"_28538":198674,"_5847":198751},[],"Quieres",{"_6944":122495,"_42621":122470,"_30085":198753,"_5":21646,"_28538":198674,"_5847":198754},[],"Define",{"_6944":122496,"_42621":122470,"_30085":198756,"_5":21646,"_28538":198674,"_5847":198757},[],"Módulos `swu-build` (`.swu` ensamblado)",{"_6944":122497,"_42621":122470,"_30085":198759,"_5":21646,"_28538":198674,"_5847":89321},[],{"_6944":122498,"_42621":122470,"_30085":198761,"_5":21646,"_28538":198674,"_5847":198762},[],"Firma con el KMS de Lamassu",{"_6944":122499,"_42621":122470,"_30085":198764,"_5":21646,"_28538":198674,"_5847":198765},[],"además `sign_script_path` y `kms_endpoint` (los módulos raw solo necesitan `kms_endpoint`)",{"_6944":122500,"_42621":122470,"_30085":198767,"_5":21646,"_28538":198674,"_5847":198768},[],"Cifrado con clave compartida",{"_6944":122501,"_42621":122470,"_30085":198770,"_5":21646,"_28538":198674,"_5847":198771},[],"`symkms_endpoint`, más el bloque `symkms` o `sym_keys_dir` para que el proceso registre las rutas `/symkms/v1`",{"_6944":122502,"_42621":122470,"_30085":198773,"_5":21646,"_28538":198674,"_5847":198774},[],"Consulta la referencia de configuración y Firma y cifrado. Sin estas claves, `GET /updates/v1/capabilities` informa `artifact_encryption: false` y el dashboard oculta el selector de cifrado.",{"_6944":122503,"_42621":122470,"_30085":198776,"_5":21646,"_28538":198674,"_5847":198777},[],"La API escucha en `app.server.port`, y lo eliges tú. El dashboard lee la URL de su API de `LAMASSU_UPDATES_API`, así que apúntala a la instancia que ejecuta el modo que quieres. Si ejecutas a la vez una instancia native y una `hawkbit`, dales puertos distintos y define el `symkms_endpoint` de cada instancia con **su propio** puerto: apunta al mismo proceso.",{"_6944":122504,"_42621":122470,"_30085":198779,"_5":21646,"_28538":198678,"_5847":198780},[],"El `docker-compose.yml` del repositorio arranca un hawkBit (puerto `8090` del host, respaldado por la base de datos Postgres `hawkbit`) y el Postgres que usan ambos servicios:",{"_6944":122505,"_42621":122470,"_30085":198782,"_5":21646,"_28538":198678,"_5847":198783},[],"`config-hawkbit.yml` contiene valores de una máquina de desarrollo: rutas absolutas para `swugenerator_path`, `sign_script_path` y los directorios de SymKMS, y una dirección de red local para `kms_endpoint`. Edítalos primero y apúntalos a rutas que el usuario del servicio pueda crear. El fichero no tiene `dms_endpoint`: añade la URL de tu Device Manager de Lamassu, o el servicio no tendrá grupos de dispositivos a los que lanzar.",{"_6944":122506,"_42621":122470,"_30085":198785,"_5":21646,"_28538":198678,"_5847":198786},[],"Comprueba el backend:",{"_6944":122507,"_42621":122470,"_30085":198788,"_5":21646,"_28538":198682,"_5847":198789},[],"Un distribution set de hawkBit solo puede enlazar módulos de software **construidos**, así que el orden difiere del modo native. El flujo empieza por el catálogo:",{"_6944":122508,"_42621":122470,"_30085":198791,"_5":21646,"_28538":198686,"_5847":198792},[],"`POST /updates/v1/softwaremodules` con su `type`, `name`, `version` y `delivery_intent`.",{"_6944":122509,"_42621":122470,"_30085":198794,"_5":21646,"_28538":198690,"_5847":198795},[],"`POST /updates/v1/softwaremodules/by-id/:moduleID/artifacts`. Esta ruta transmite el fichero a hawkBit en streaming.",{"_6944":122510,"_42621":122470,"_30085":198797,"_5":21646,"_28538":198694,"_5847":198798},[],"Cómo depende del delivery intent (tabla siguiente).",{"_6944":122511,"_42621":122470,"_30085":198800,"_5":21646,"_28538":198698,"_5847":198801},[],"`POST /updates/v1/groups/:groupID/distribution-sets` con `modules: [{\"source_module_id\": \"<id>\"}]`. El paquete se crea ya construido.",{"_6944":122512,"_42621":122470,"_30085":198803,"_5":21646,"_28538":198698,"_5847":89366},[],{"_6944":122513,"_42621":122470,"_30085":198805,"_5":21646,"_28538":198698,"_5847":198806},[],"Cómo queda construido el módulo",{"_6944":122514,"_42621":122470,"_30085":198808,"_5":21646,"_28538":198698,"_5847":198809},[],"Se une a paquetes con",{"_6944":122515,"_42621":122470,"_30085":198811,"_5":21646,"_28538":198698,"_5847":89375},[],{"_6944":122516,"_42621":122470,"_30085":198813,"_5":21646,"_28538":198698,"_5847":198814},[],"Sube su sw-description con `POST /softwaremodules/by-id/:moduleID/descriptor` y después `POST /softwaremodules/by-id/:moduleID/build`. Necesita `swugenerator_path`: sin ella la construcción responde `501`. Los campos de firma y cifrado van en el cuerpo de la construcción.",{"_6944":122517,"_42621":122470,"_30085":198816,"_5":21646,"_28538":198698,"_5847":198817},[],"`swu` (por defecto) o `non-swu`",{"_6944":122518,"_42621":122470,"_30085":198819,"_5":21646,"_28538":198698,"_5847":89384},[],{"_6944":122519,"_42621":122470,"_30085":198821,"_5":21646,"_28538":198698,"_5847":198822},[],"Sube el `.swu` terminado: subirlo construye el módulo. Llamar a build responde `400`.",{"_6944":122520,"_42621":122470,"_30085":198824,"_5":21646,"_28538":198698,"_5847":86486},[],{"_6944":122521,"_42621":122470,"_30085":198826,"_5":21646,"_28538":198698,"_5847":89392},[],{"_6944":122522,"_42621":122470,"_30085":198828,"_5":21646,"_28538":198698,"_5847":198829},[],"`POST .../build` cifra (clave compartida) y/o firma los ficheros; con ninguna de las dos cosas, los ficheros se entregan sin cambios y el servicio registra una advertencia. Varios ficheros se archivan en `<name>.tar.gz`. Un entregable cifrado recibe el sufijo `.enc`; una firma añade `<file>.sha256` y `<file>.sha256.sig`.",{"_6944":122523,"_42621":122470,"_30085":198831,"_5":21646,"_28538":198698,"_5847":86495},[],{"_6944":122524,"_42621":122470,"_30085":198833,"_5":21646,"_28538":198698,"_5847":89400},[],{"_6944":122525,"_42621":122470,"_30085":198835,"_5":21646,"_28538":198698,"_5847":198836},[],"No se puede construir ni enlazar. Elige antes un intent con `PUT /softwaremodules/by-id/:moduleID`.",{"_6944":122526,"_42621":122470,"_30085":198838,"_5":21646,"_28538":198698,"_5847":155402},[],{"_6944":122527,"_42621":122470,"_30085":198840,"_5":21646,"_28538":198698,"_5847":198841},[],"Una construcción **sustituye** los ficheros de entrada del módulo por el entregable, así que un módulo construido no se puede construir otra vez: publica una versión nueva del módulo.",{"_6944":122528,"_42621":122470,"_30085":198843,"_5":21646,"_28538":198698,"_5847":198844},[],"Las operaciones que no tienen sentido para un paquete construido y congelado responden así:",{"_6944":122529,"_42621":122470,"_30085":198846,"_5":21646,"_28538":198698,"_5847":198489},[],{"_6944":122530,"_42621":122470,"_30085":198848,"_5":21646,"_28538":198698,"_5847":198849},[],"Respuesta",{"_6944":122531,"_42621":122470,"_30085":198851,"_5":21646,"_28538":198698,"_5847":198852},[],"`POST .../distribution-sets/:name/swu` y `.../package`",{"_6944":122532,"_42621":122470,"_30085":198854,"_5":21646,"_28538":198698,"_5847":198855},[],"`501`: construye los módulos en el catálogo.",{"_6944":122533,"_42621":122470,"_30085":198857,"_5":21646,"_28538":198698,"_5847":198858},[],"`.../swu/upload` y `.../package/upload`",{"_6944":122534,"_42621":122470,"_30085":198860,"_5":21646,"_28538":198698,"_5847":198861},[],"`409`: un paquete de hawkBit siempre está ya construido.",{"_6944":122535,"_42621":122470,"_30085":198863,"_5":21646,"_28538":198698,"_5847":198864},[],"Enlazar un artefacto a un paquete, subir sw-description, descriptor de módulo, construir módulo, borrar artefacto, todos con ámbito de paquete",{"_6944":122536,"_42621":122470,"_30085":198866,"_5":21646,"_28538":198698,"_5847":198867},[],"`400`: un módulo enlazado está congelado. Desenlázalo, cámbialo y constrúyelo en el catálogo, y enlázalo de nuevo.",{"_6944":122537,"_42621":122470,"_30085":198869,"_5":21646,"_28538":198698,"_5847":198870},[],"Crear un módulo dentro de un paquete",{"_6944":122538,"_42621":122470,"_30085":198872,"_5":21646,"_28538":198698,"_5847":198873},[],"No es posible. Créalo en el catálogo.",{"_6944":122539,"_42621":122470,"_30085":198875,"_5":21646,"_28538":198698,"_5847":198876},[],"Cambiar la composición de un paquete ya asignado a dispositivos",{"_6944":122540,"_42621":122470,"_30085":198878,"_5":21646,"_28538":198698,"_5847":198879},[],"`400`: crea una versión nueva.",{"_6944":122541,"_42621":122470,"_30085":198881,"_5":21646,"_28538":198698,"_5847":198882},[],"Consulta la guía de publicación y despliegue para el procedimiento completo.",{"_6944":122542,"_42621":122470,"_30085":198884,"_5":21646,"_28538":198702,"_5847":89452},[],{"_6944":122543,"_42621":122470,"_30085":198886,"_5":21646,"_28538":198702,"_5847":86087},[],{"_6944":122544,"_42621":122470,"_30085":198888,"_5":21646,"_28538":198702,"_5847":198889},[],"Versión de un paquete de actualización",{"_6944":122545,"_42621":122470,"_30085":198891,"_5":21646,"_28538":198702,"_5847":198892},[],"Distribution set. Cada versión es su propio distribution set.",{"_6944":122546,"_42621":122470,"_30085":198894,"_5":21646,"_28538":198702,"_5847":195962},[],{"_6944":122547,"_42621":122470,"_30085":198896,"_5":21646,"_28538":198702,"_5847":86403},[],{"_6944":122548,"_42621":122470,"_30085":198898,"_5":21646,"_28538":198702,"_5847":198899},[],"Artefacto de módulo",{"_6944":122549,"_42621":122470,"_30085":198901,"_5":21646,"_28538":198702,"_5847":198902},[],"Artefacto del software module",{"_6944":122550,"_42621":122470,"_30085":198904,"_5":21646,"_28538":198702,"_5847":191986},[],{"_6944":122551,"_42621":122470,"_30085":198906,"_5":21646,"_28538":198702,"_5847":198907},[],"Target. El controller ID es el ID del dispositivo.",{"_6944":122552,"_42621":122470,"_30085":198909,"_5":21646,"_28538":198702,"_5847":195978},[],{"_6944":122553,"_42621":122470,"_30085":198911,"_5":21646,"_28538":198702,"_5847":198912},[],"Etiqueta de target `group:<id>`",{"_6944":122554,"_42621":122470,"_30085":198914,"_5":21646,"_28538":198702,"_5847":198915},[],"Lanzamiento (campaña)",{"_6944":122555,"_42621":122470,"_30085":198917,"_5":21646,"_28538":198702,"_5847":198918},[],"Rollout (estático)",{"_6944":122556,"_42621":122470,"_30085":198920,"_5":21646,"_28538":198702,"_5847":198921},[],"Trabajo por dispositivo",{"_6944":122557,"_42621":122470,"_30085":198923,"_5":21646,"_28538":198702,"_5847":198924},[],"Acción del rollout",{"_6944":122558,"_42621":122470,"_30085":198926,"_5":21646,"_28538":198702,"_5847":198927},[],"Lanzamiento programado",{"_6944":122559,"_42621":122470,"_30085":198929,"_5":21646,"_28538":198702,"_5847":198930},[],"La hora de inicio del rollout (la arranca el planificador de hawkBit)",{"_6944":122560,"_42621":122470,"_30085":198932,"_5":21646,"_28538":198706,"_5847":198933},[],"hawkBit almacena los paquetes, los rollouts y los trabajos. El servicio sigue necesitando Postgres (la base de datos `updates`) para lo que hawkBit no tiene equivalente: subidas de artefactos en tránsito y alias, sw-descriptions, manifiestos de conjunto firmados, rollouts cancelados y fijaciones de última versión declaradas. Guardarlos en Postgres, y no en memoria, es lo que permite ejecutar varias réplicas con seguridad.",{"_6944":122561,"_42621":122470,"_30085":198935,"_5":21646,"_28538":198706,"_5847":198936},[],"**Las sw-descriptions** viven en Postgres, no en los metadatos de hawkBit, porque hawkBit limita el valor de un metadato a 4000 caracteres. Los descriptores escritos allí por versiones anteriores se siguen leyendo.",{"_6944":122562,"_42621":122470,"_30085":198938,"_5":21646,"_28538":198706,"_5847":198939},[],"**Las filas están acotadas a una instancia de hawkBit.** Los ids de hawkBit se repiten entre servidores y tras vaciar su base de datos, así que el servicio marca el hawkBit con el que habla con una etiqueta (una etiqueta de distribution set llamada `lamassu:instance`) e ignora las filas que pertenecen a otra instancia. No borres esa etiqueta.",{"_6944":122563,"_42621":122470,"_30085":198941,"_5":21646,"_28538":198706,"_5847":198942},[],"**Las subidas en tránsito son pesadas.** `POST /updates/v1/artifacts` (la subida global de artefactos) lee el fichero entero en memoria y lo guarda en Postgres durante 30 minutos salvo que un paquete lo enlace, y el modo hawkBit se niega a enlazar ficheros a paquetes. Para ficheros grandes, sube siempre por la ruta de catálogo de la sección anterior, que transmite a hawkBit en streaming.",{"_6944":122564,"_42621":122470,"_30085":198944,"_5":21646,"_28538":198710,"_5847":198945},[],"Los dispositivos consultan a hawkBit, no a este servicio. Un paquete lanzado contra un hawkBit sin targets registrados no lo descarga nada.",{"_6944":122565,"_42621":122470,"_30085":198947,"_5":21646,"_28538":198710,"_5847":198948},[],"Con `dms_endpoint` definido, cada lectura de los dispositivos de un grupo crea los targets que falten (controller ID = ID del dispositivo) y los etiqueta `group:<id>`. Un dispositivo que no se puede reconciliar queda excluido de esa lectura y se registra. Sin `dms_endpoint`, los grupos son las etiquetas `group:<id>` existentes.",{"_6944":122566,"_42621":122470,"_30085":198950,"_5":21646,"_28538":198710,"_5847":198951},[],"El primer lanzamiento con un `test_device_id` (canario) falla con `test device X cannot act as this group's canary` hasta que los dispositivos del grupo existen en hawkBit. Ejecuta antes una simulación (`POST .../launch?dry_run=true`), que los registra.",{"_6944":122567,"_42621":122470,"_30085":198953,"_5":21646,"_28538":198714,"_5847":198954},[],"Es hawkBit quien decide cómo se autentican los dispositivos, no este servicio. hawkBit 1.1.0 no tiene modo anónimo: un despliegue debe habilitar al menos uno entre el token de seguridad del target, el token de seguridad de gateway o el autenticador por cabecera de proxy inverso (`X-Controller-Id` más `X-Authority`). Elige uno y habilítalo como ajuste del tenant de hawkBit; una instalación con todos desactivados responde `401` a todos los dispositivos. Recomendado en producción:",{"_6944":122568,"_42621":122470,"_30085":198956,"_5":21646,"_28538":198714,"_5847":198957},[],"Termina el mTLS de los dispositivos en un gateway, haz que fije las cabeceras del autenticador por cabecera a partir del certificado del dispositivo, y deja que hawkBit confíe en esas cabeceras solo desde las direcciones del gateway (el ajuste de proxies de confianza de hawkBit). Cualquier cosa que alcance hawkBit directamente podría, si no, suplantar a cualquier dispositivo.",{"_6944":122569,"_42621":122470,"_30085":198959,"_5":21646,"_28538":198714,"_5847":198960},[],"O habilita los tokens de seguridad de target (`authentication.targettoken.enabled`) y configura cada dispositivo con su propio token; SWUpdate lo envía como `Authorization: TargetToken <token>`.",{"_6944":122570,"_42621":122470,"_30085":198962,"_5":21646,"_28538":198714,"_5847":198963},[],"No expongas nunca la API de gestión a los dispositivos. Usa una contraseña robusta para el usuario de la API de gestión (`HAWKBIT_SECURITY_USER_ADMIN_PASSWORD` en la imagen) y sírvela por HTTPS. Si el gateway publica el DDI bajo un prefijo de ruta, define `hawkbit.ddi_url` con la URL pública del DDI para que los enlaces de artefactos que reciben los dispositivos sean alcanzables.",{"_6944":122571,"_42621":122470,"_30085":198965,"_5":21646,"_28538":198718,"_5847":198966},[],"Por defecto hawkBit guarda los bytes de los artefactos en su propio sistema de ficheros. El directorio `docker/hawkbit` del repositorio construye una imagen de hawkBit con un **plugin de almacenamiento de artefactos en S3**, que se selecciona con `HAWKBIT_ARTIFACT_STORAGE=s3` (`fs` es el valor por defecto) y las variables `HAWKBIT_ARTIFACT_S3_*` (bucket, endpoint, región, acceso path-style, prefijo de claves; las credenciales vienen de la cadena de credenciales por defecto de AWS). hawkBit se niega a arrancar si se selecciona S3 pero el bucket no es alcanzable: nunca recurre en silencio al disco local. Los metadatos permanecen en Postgres en ambos casos. El plugin y sus instrucciones de construcción y pruebas están en `docker/hawkbit`; la imagen se construye en local y no se publica en ningún registro.",{"_6944":122572,"_42621":122470,"_30085":198968,"_5":21646,"_28538":198718,"_5847":198969},[],"Con el plugin y `hawkbit.artifact_store.presign` configurados, las descargas de artefactos de módulo se responden con `302` a una URL firmada de corta duración del bucket, en lugar de transmitirse a través de hawkBit o de este servicio. Los dispositivos conservan el enlace de artefacto que les dio hawkBit: el adaptador sirve esa ruta DDI (`<ddi path>/:tenant/controller/v1/:controllerId/softwaremodules/:id/artifacts/:filename`), comprueba que el módulo está asignado o instalado en ese dispositivo (si no, `404`) y redirige. Para que esto funcione, el gateway debe encaminar esa ruta a Lamassu Updates y el resto del DDI a hawkBit. Consulta Configuración y Seguridad.",{"_6944":122573,"_42621":122470,"_30085":198971,"_5":21646,"_28538":198718,"_5847":198972},[],"hawkBit tiene sus propios límites de artefactos. La imagen de este repositorio los sube a 11 GiB por fichero y 1 TiB en total, para coincidir con el `max_artifact_size_mb` por defecto de 10 GiB (`SPRING_SERVLET_MULTIPART_MAXFILESIZE`, `SPRING_SERVLET_MULTIPART_MAXREQUESTSIZE`, `HAWKBIT_SERVER_SECURITY_DOS_MAXARTIFACTSIZE` y `HAWKBIT_SERVER_SECURITY_DOS_MAXARTIFACTSTORAGE`). Con hawkBit estándar el límite es de 1 GiB por fichero y 20 GiB en total. hawkBit escribe primero la subida en un fichero temporal, así que dale ese espacio libre en disco.",{"_6944":122574,"_42621":122470,"_30085":198974,"_5":21646,"_28538":198718,"_5847":198975},[],"La imagen de hawkBit dimensiona su JVM con las variables de entorno `X_MS` y `X_MX` (por defecto `768m` cada una), además de `XX_MAX_METASPACE_SIZE`, `XSS` y `GC`. `JAVA_OPTS` no fija el heap. Reducir `X_MX` baja el techo, no el uso de memoria en régimen estable.",{"_6944":122575,"_42621":122470,"_30085":198977,"_5":21646,"_28538":198722,"_5847":188834},[],{"_6944":122576,"_42621":122470,"_30085":198979,"_5":21646,"_28538":198722,"_5847":198980},[],"Modo `hawkbit`",{"_6944":122577,"_42621":122470,"_30085":198982,"_5":21646,"_28538":198722,"_5847":198983},[],"A quién consultan los dispositivos",{"_6944":122578,"_42621":122470,"_30085":198985,"_5":21646,"_28538":198722,"_5847":198986},[],"A hawkBit (DDI), no a este servicio.",{"_6944":122579,"_42621":122470,"_30085":198988,"_5":21646,"_28538":198722,"_5847":198989},[],"Capacidades",{"_6944":122580,"_42621":122470,"_30085":198991,"_5":21646,"_28538":198722,"_5847":198992},[],"No existen todas las funciones del modo native. `GET /updates/v1/capabilities` lista lo que soporta el backend activo: en modo `hawkbit` no hay workflows personalizados, ni edición de la estrategia tras la creación, ni cierre anticipado de una campaña, ni añadir dispositivos a una campaña en curso, ni eventos push, ni cifrado por dispositivo. Consulta Capacidades.",{"_6944":122581,"_42621":122470,"_30085":198994,"_5":21646,"_28538":198722,"_5847":198995},[],"Cifrado",{"_6944":122582,"_42621":122470,"_30085":198997,"_5":21646,"_28538":198722,"_5847":198998},[],"**Solo clave compartida.** Un distribution set sirve artefactos idénticos a todos los targets, así que no hay dónde poner una carga distinta por dispositivo. Usa el modo `native` para cifrado por dispositivo.",{"_6944":122583,"_42621":122470,"_30085":199000,"_5":21646,"_28538":198722,"_5847":199001},[],"Paquetes con varios módulos",{"_6944":122584,"_42621":122470,"_30085":199003,"_5":21646,"_28538":198722,"_5847":199004},[],"Cada módulo tiene su propio entregable, así que un paquete con varios módulos se instala como **varias transacciones SWUpdate independientes**. SWUpdate no puede revertir entre varios ficheros `.swu`. Consulta Conceptos.",{"_6944":122585,"_42621":122470,"_30085":199006,"_5":21646,"_28538":198722,"_5847":199007},[],"Nombres",{"_6944":122586,"_42621":122470,"_30085":199009,"_5":21646,"_28538":198722,"_5847":199010},[],"hawkBit borra los módulos de software de forma lógica (soft-delete), así que el nombre y la versión de un módulo que alguna vez se asignó a un dispositivo quedan ocupados para siempre. Sube la versión.",{"_6944":122587,"_42621":122470,"_30085":199012,"_5":21646,"_28538":198722,"_5847":199013},[],"Estrategia de lanzamiento",{"_6944":122588,"_42621":122470,"_30085":199015,"_5":21646,"_28538":198722,"_5847":199016},[],"Se lee de vuelta de los grupos del rollout, así que un lote fijo puede leerse como un porcentaje. No se puede editar tras la creación.",{"_6944":122589,"_42621":122470,"_30085":199018,"_5":21646,"_28538":198722,"_5847":199019},[],"Cambios concurrentes",{"_6944":122590,"_42621":122470,"_30085":199021,"_5":21646,"_28538":198722,"_5847":199022},[],"Construir o cambiar el mismo módulo desde dos peticiones responde `409` (`software module N is being built or changed by another request`).",{"_6944":122591,"_42621":122470,"_30085":199024,"_5":21646,"_28538":198722,"_5847":198727},[],{"_6944":122592,"_42621":122470,"_30085":199026,"_5":21646,"_28538":198722,"_5847":199027},[],"hawkBit es su propio servicio con su propia base de datos. El chart de Helm de este repositorio no lo despliega ni lo gestiona.",{"_6944":122593,"_42621":122470,"_30085":199029,"_5":21646,"_28538":198726,"_5847":199030},[],"En modo `hawkbit` no se elige líder y no hay ficheros locales que compartir, así que puede ejecutarse cualquier número de réplicas: el estado está en Postgres y en hawkBit, y las operaciones de módulos y lanzamientos toman bloqueos de Postgres. Si usas cifrado con clave compartida, pon el almacén de claves de SymKMS (`symkms.storage`) en almacenamiento compartido o en S3. Consulta Operaciones.",{"_6944":122594,"_42621":122594,"_5":22076,"_5847":199032,"_43101":199033,"_30085":199034,"_28538":122594},"Limitaciones y problemas conocidos",[78004,189200,195583,188960],[],{"_6944":122595,"_42621":122594,"_30085":199036,"_5":21646,"_28538":122594,"_5847":199037},[],"Lo que Lamassu Updates no soporta o aún no hace, reunido en un solo lugar y con la página que explica cada punto.",{"_6944":122596,"_42621":122594,"_5":43098,"_30085":199039,"_28538":199040,"_5847":197547},[],"/docs/pr-preview/pr-56/es/platform/updates/limitations#seguridad",{"_6944":122597,"_42621":122594,"_5":43098,"_30085":199042,"_28538":199043,"_5847":89612},[],"/docs/pr-preview/pr-56/es/platform/updates/limitations#backends",{"_6944":122598,"_42621":122594,"_5":43098,"_30085":199045,"_28538":199046,"_5847":199047},[],"/docs/pr-preview/pr-56/es/platform/updates/limitations#paquetes-y-versiones","Paquetes y versiones",{"_6944":122599,"_42621":122594,"_5":43098,"_30085":199049,"_28538":199050,"_5847":199051},[],"/docs/pr-preview/pr-56/es/platform/updates/limitations#escalado-y-recursos","Escalado y recursos",{"_6944":122600,"_42621":122594,"_5":43098,"_30085":199053,"_28538":199054,"_5847":199055},[],"/docs/pr-preview/pr-56/es/platform/updates/limitations#firma-y-cifrado","Firma y cifrado",{"_6944":122601,"_42621":122594,"_5":43098,"_30085":199057,"_28538":199058,"_5847":199059},[],"/docs/pr-preview/pr-56/es/platform/updates/limitations#despliegue-y-configuración","Despliegue y configuración",{"_6944":122602,"_42621":122594,"_5":43098,"_30085":199061,"_28538":199062,"_5847":189016},[],"/docs/pr-preview/pr-56/es/platform/updates/limitations#observabilidad",{"_6944":122603,"_42621":122594,"_30085":199064,"_5":21646,"_28538":122594,"_5847":199065},[],"Esta página reúne lo que no está soportado, está soportado en parte o resulta sorprendente, para que lo compruebes antes de diseñar un despliegue. Cada punto indica la página que lo explica.",{"_6944":122604,"_42621":122594,"_30085":199067,"_5":21646,"_28538":199040,"_5847":199068},[],"El servicio no tiene autenticación, autorización, TLS ni mTLS. Usa un gateway. Consulta Seguridad.",{"_6944":122605,"_42621":122594,"_30085":199070,"_5":21646,"_28538":199040,"_5847":199071},[],"Las claves `app.server.cert_file`, `key_file` y `authentication.mutual_tls.*` no tienen efecto.",{"_6944":122606,"_42621":122594,"_30085":199073,"_5":21646,"_28538":199040,"_5847":199074},[],"La conexión a Postgres usa siempre `sslmode=disable`. En modo `native` el servicio no verifica el certificado TLS del KMS, y el script firmante de SWU llama a `curl -k`.",{"_6944":122607,"_42621":122594,"_30085":199076,"_5":21646,"_28538":199040,"_5847":199077},[],"El servicio envía la identidad fija `X-Principal-ID: admin-mode` al Device Manager y al KMS, y sus llamadas a SymKMS no llevan credencial.",{"_6944":122608,"_42621":122594,"_30085":199079,"_5":21646,"_28538":199040,"_5847":199080},[],"No hay limitación de tasa de peticiones.",{"_6944":122609,"_42621":122594,"_30085":199082,"_5":21646,"_28538":199043,"_5847":199083},[],"Los dos backends difieren en funciones. Consulta Capacidades. En particular, el modo `hawkbit` no tiene cifrado por dispositivo, ni workflows personalizados, ni edición de la estrategia de un lanzamiento tras su creación, ni cierre anticipado de una campaña, ni añadir dispositivos a una campaña en curso, ni eventos push, ni subida de un precompilado a nivel de conjunto. Un módulo de catálogo `swu-prebuilt` sí acepta un `.swu` terminado. El modo `native` construye un entregable por paquete y no tiene entregables por módulo.",{"_6944":122610,"_42621":122594,"_30085":199085,"_5":21646,"_28538":199043,"_5847":199086},[],"En modo `hawkbit`, un paquete con varios módulos se instala como varias transacciones SWUpdate independientes. SWUpdate no puede revertir entre varios ficheros `.swu`.",{"_6944":122611,"_42621":122594,"_30085":199088,"_5":21646,"_28538":199043,"_5847":199089},[],"hawkBit reserva el nombre y la versión de un módulo que alguna vez se asignó a un dispositivo. Sube la versión.",{"_6944":122612,"_42621":122594,"_30085":199091,"_5":21646,"_28538":199043,"_5847":199092},[],"En modo `hawkbit`, una construcción de módulo sustituye los ficheros de entrada del módulo por el entregable, así que un módulo no se puede construir dos veces: publica una versión nueva.",{"_6944":122613,"_42621":122594,"_30085":199094,"_5":21646,"_28538":199043,"_5847":199095},[],"Los rollouts de hawkBit se crean estáticos: los dispositivos añadidos a un grupo después de crear un lanzamiento no los recoge ese lanzamiento.",{"_6944":122614,"_42621":122594,"_30085":199097,"_5":21646,"_28538":199043,"_5847":199098},[],"El modo `hawkbit` lee la estrategia de un lanzamiento de los grupos del rollout, así que un lanzamiento creado con un lote fijo puede leerse como un porcentaje.",{"_6944":122615,"_42621":122594,"_30085":199100,"_5":21646,"_28538":199043,"_5847":199101},[],"Un primer lanzamiento en modo `hawkbit` con un `test_device_id` falla hasta que los dispositivos del grupo existen en hawkBit. Consulta Resolución de problemas.",{"_6944":122616,"_42621":122594,"_30085":199103,"_5":21646,"_28538":199043,"_5847":199104},[],"`POST /updates/v1/artifacts` en modo `hawkbit` mantiene el fichero entero en memoria y en Postgres durante 30 minutos y no se puede enlazar a un paquete. Sube por la ruta de catálogo en su lugar. Consulta Modo hawkBit.",{"_6944":122617,"_42621":122594,"_30085":199106,"_5":21646,"_28538":199043,"_5847":199107},[],"Los límites de artefactos propios de hawkBit (1 GiB por fichero, 20 GiB en total) se aplican salvo que uses la imagen de este repositorio o los subas. La imagen con el plugin S3 de artefactos se construye desde `docker/hawkbit` y no se publica en ningún registro.",{"_6944":122618,"_42621":122594,"_30085":199109,"_5":21646,"_28538":199046,"_5847":199110},[],"**Una versión nueva de un paquete `native` hereda los ajustes de cifrado de la versión anterior en las construcciones de `.swu`.** `POST .../new` los copia, y una construcción de `.swu` sin campos de cifrado no los borra. Tras una construcción por dispositivo, todas las versiones posteriores de ese paquete siguen informando `per-device`, conservan los `uncovered_devices` antiguos y las descargas de los dispositivos fallan con `404` (`SWU not available for device ...`). Usa un paquete distinto para cada variante de cifrado. (Las construcciones `.../package` restablecen estos campos.)",{"_6944":122619,"_42621":122594,"_30085":199112,"_5":21646,"_28538":199046,"_5847":199113},[],"`POST .../new` no arrastra la sw-description del paquete: cada versión necesita su propia subida.",{"_6944":122620,"_42621":122594,"_30085":199115,"_5":21646,"_28538":199046,"_5847":199116},[],"**Los nombres de artefacto son globales.** Un nombre solo se puede reutilizar con una `version` mayor, y la API responde una infracción con `500`, no con un `4xx`.",{"_6944":122621,"_42621":122594,"_30085":199118,"_5":21646,"_28538":199046,"_5847":199119},[],"Una versión construida es inmutable. Para cambiarla, crea una versión nueva.",{"_6944":122622,"_42621":122594,"_30085":199121,"_5":21646,"_28538":199050,"_5847":199122},[],"Con almacenamiento local en un único volumen `ReadWriteOnce`, solo puede ejecutarse una réplica `native`. Pasa `artifacts`, `builds` y `symkms` a S3 para escalar. Consulta Operaciones.",{"_6944":122623,"_42621":122594,"_30085":199124,"_5":21646,"_28538":199050,"_5847":199125},[],"Las claves de SymKMS también usan almacenamiento local por defecto: apunta `symkms.storage` a S3, o comparte un volumen, o se pierden.",{"_6944":122624,"_42621":122594,"_30085":199127,"_5":21646,"_28538":199050,"_5847":199128},[],"Las construcciones por dispositivo están limitadas por CPU y crecen con el número de dispositivos. Consulta Firma y cifrado.",{"_6944":122625,"_42621":122594,"_30085":199130,"_5":21646,"_28538":199050,"_5847":199131},[],"Cifrar necesita el fichero en memoria (`swugenerator`, los paquetes AES-GCM y los módulos raw, y cualquier almacén con cifrado en reposo), así que los ficheros cifrados muy grandes necesitan memoria proporcionalmente grande. Firmar un módulo raw transmite el fichero en streaming.",{"_6944":122626,"_42621":122594,"_30085":199133,"_5":21646,"_28538":199050,"_5847":199134},[],"Cada subida en curso necesita disco temporal libre del tamaño del fichero.",{"_6944":122627,"_42621":122594,"_30085":199136,"_5":21646,"_28538":199054,"_5847":199137},[],"La firma necesita un KMS que devuelva CMS (`PKCS7 SignedData`). El servicio rechaza una respuesta que no sea CMS cuando firma manifiestos y sumas de verificación de módulos raw, pero el script firmante de SWU no lo comprueba: con un KMS sin soporte CMS una construcción de `.swu` puede salir bien y aun así ser rechazada por un dispositivo que define `public-key-file`. Consulta Firma y cifrado.",{"_6944":122628,"_42621":122594,"_30085":199139,"_5":21646,"_28538":199054,"_5847":199140},[],"Los paquetes `non-swu` y los módulos raw son siempre AES-GCM, sea cual sea el nombre de algoritmo que envíes, y para ellos se rechaza una clave Ascon-80pq.",{"_6944":122629,"_42621":122594,"_30085":199142,"_5":21646,"_28538":199054,"_5847":199143},[],"SymKMS no aplica propósitos de clave: se acepta cualquier propósito y uno vacío es un comodín (un marcador de posición intencionado). Rechaza un IV aportado por quien llama para GCM, CTR y Ascon.",{"_6944":122630,"_42621":122594,"_30085":199145,"_5":21646,"_28538":199054,"_5847":199146},[],"Los nombres de algoritmo no se normalizan de extremo a extremo: SymKMS ignora mayúsculas y `_` frente a `-`, pero `swugenerator` necesita guiones (`aes-256-gcm`), y `ascon128a` no es `ASCON-128A`.",{"_6944":122631,"_42621":122594,"_30085":199148,"_5":21646,"_28538":199058,"_5847":199149},[],"`app.server.protocol`, `app.server.log_level`, `app.server.health_check` y el `health_check_logging` de los ejemplos se aceptan pero no se leen. El registro de peticiones está siempre activado.",{"_6944":122632,"_42621":122594,"_30085":199151,"_5":21646,"_28538":199058,"_5847":199152},[],"La base de datos se llama siempre `updates`, y el servicio no la crea.",{"_6944":122633,"_42621":122594,"_30085":199154,"_5":21646,"_28538":199058,"_5847":199155},[],"Los ficheros de configuración de ejemplo contienen valores de una máquina de desarrollo y secretos de desarrollo.",{"_6944":122634,"_42621":122594,"_30085":199157,"_5":21646,"_28538":199058,"_5847":199158},[],"El valor por defecto de `config.update_domain` en el chart de Helm (`http://updates:10090/v1/`) carece del prefijo `/updates`: el valor debe ser la base completa de la API terminada en `/updates/v1/`, o las URLs de descarga no resuelven.",{"_6944":122635,"_42621":122594,"_30085":199160,"_5":21646,"_28538":199058,"_5847":199161},[],"El chart de Helm declara valores `postgresql.*` e `ingress.*` pero no despliega PostgreSQL y no tiene plantilla de ingress. Usa siempre la estrategia `Recreate`, vuelca todo `config` (contraseñas incluidas) en un ConfigMap y no tiene valores para añadir variables de entorno, volúmenes ni un Secret existente.",{"_6944":122636,"_42621":122594,"_30085":199163,"_5":21646,"_28538":199058,"_5847":199164},[],"La imagen de contenedor no reduce privilegios, e incluye un `config.yml` de desarrollo: monta el tuyo.",{"_6944":122637,"_42621":122594,"_30085":199166,"_5":21646,"_28538":199058,"_5847":199167},[],"Para construir tú mismo la imagen Docker, el contexto de construcción debe contener los checkouts de `lamassuiot/core` y `lamassuiot/sdk` junto a `ota/`.",{"_6944":122638,"_42621":122594,"_30085":199169,"_5":21646,"_28538":199058,"_5847":199170},[],"`GET /health` no comprueba la base de datos, WFX ni hawkBit.",{"_6944":122639,"_42621":122594,"_30085":199172,"_5":21646,"_28538":199062,"_5847":199173},[],"El servicio no exporta trazas, métricas ni registros, y no tiene endpoint de métricas. Consulta Operaciones.",{"_6944":122640,"_42621":122640,"_5":22076,"_5847":199175,"_43101":199176,"_30085":199177,"_28538":122640},"Operaciones",[78004,189200,195583,188960],[],{"_6944":122641,"_42621":122640,"_30085":199179,"_5":21646,"_28538":122640,"_5847":199180},[],"Despliega Lamassu Updates con Docker Compose o Helm, escálalo, dimensiónalo, obsérvalo, haz copias de seguridad y actualízalo.",{"_6944":122642,"_42621":122640,"_5":43098,"_30085":199182,"_28538":199183,"_5847":187769},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#despliegue",{"_6944":122643,"_42621":122640,"_5":43098,"_30085":199185,"_28538":199186,"_5847":199187},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#la-imagen-de-contenedor","La imagen de contenedor",{"_6944":122644,"_42621":122640,"_5":43098,"_30085":199189,"_28538":199190,"_5847":89760},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#docker-compose",{"_6944":122645,"_42621":122640,"_5":43098,"_30085":199192,"_28538":199193,"_5847":79085},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#helm",{"_6944":122646,"_42621":122640,"_5":43098,"_30085":199195,"_28538":199196,"_5847":199197},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#secretos-con-helm","Secretos con Helm",{"_6944":122647,"_42621":122640,"_5":43098,"_30085":199199,"_28538":199200,"_5847":199201},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#escalar-horizontalmente","Escalar horizontalmente",{"_6944":122648,"_42621":122640,"_5":43098,"_30085":199203,"_28538":199204,"_5847":199205},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#dimensionado-de-recursos","Dimensionado de recursos",{"_6944":122649,"_42621":122640,"_5":43098,"_30085":199207,"_28538":199208,"_5847":199209},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#tamaño-de-subida-y-proxies","Tamaño de subida y proxies",{"_6944":122650,"_42621":122640,"_5":43098,"_30085":199211,"_28538":199212,"_5847":199213},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#salud-registro-y-apagado","Salud, registro y apagado",{"_6944":122651,"_42621":122640,"_5":43098,"_30085":199215,"_28538":199216,"_5847":189016},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#observabilidad",{"_6944":122652,"_42621":122640,"_5":43098,"_30085":199218,"_28538":199219,"_5847":199220},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#copias-de-seguridad-y-restauración","Copias de seguridad y restauración",{"_6944":122653,"_42621":122640,"_5":43098,"_30085":199222,"_28538":199223,"_5847":199224},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#actualizaciones","Actualizaciones",{"_6944":122654,"_42621":122640,"_5":43098,"_30085":199226,"_28538":199227,"_5847":199228},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#haz-una-copia-de-seguridad","Haz una copia de seguridad",{"_6944":122655,"_42621":122640,"_5":43098,"_30085":199230,"_28538":199231,"_5847":199232},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#despliega-la-imagen-nueva","Despliega la imagen nueva",{"_6944":122656,"_42621":122640,"_5":43098,"_30085":199234,"_28538":199235,"_5847":199236},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#verifica","Verifica",{"_6944":122657,"_42621":122640,"_5":43098,"_30085":199238,"_28538":199239,"_5847":199240},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#operaciones-de-hawkbit","Operaciones de hawkBit",{"_6944":122658,"_42621":122640,"_5":43098,"_30085":199242,"_28538":199243,"_5847":199244},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#lista-de-comprobación-de-seguridad","Lista de comprobación de seguridad",{"_6944":122659,"_42621":122640,"_30085":199246,"_5":21646,"_28538":122640,"_5847":199247},[],"Esta página es para quien opera el servicio: cómo desplegarlo, qué poner a su alrededor, cómo se comporta con varias réplicas, qué respaldar y cómo actualizarlo. Las claves de configuración están en la referencia de configuración; el modelo de amenazas, en Seguridad.",{"_6944":122660,"_42621":122640,"_30085":199249,"_5":21646,"_28538":199186,"_5847":199250},[],"Las imágenes de release se publican en `ghcr.io/lamassuiot/ota`. La imagen ejecuta un único proceso, el monolito (la API de Updates y SymKMS), en el puerto `10090`. Contiene la herramienta `swugenerator`, los scripts firmantes (`/app/sign_kms.sh`) y los ficheros de workflow de WFX (`/app/wfx/workflow/dau/`). No define un usuario sin privilegios.",{"_6944":122661,"_42621":122640,"_30085":199252,"_5":21646,"_28538":199186,"_5847":199253},[],"La imagen incluye el `config.yml` de desarrollo del repositorio en `/etc/lamassuiot/config.yml`: monta siempre tu propio fichero encima, o apunta `OTA_CONFIG_FILE` al tuyo (consulta cómo se carga la configuración). Para construir tú mismo la imagen, el Dockerfile espera que su contexto sea el directorio padre del checkout de `ota`, que además debe contener `lamassuiot/core` y `lamassuiot/sdk`.",{"_6944":122662,"_42621":122640,"_30085":199255,"_5":21646,"_28538":199190,"_5847":199256},[],"`docker-compose.yml` es para uso local y de demostración. Necesita la red externa `ota-net` (`docker network create ota-net`) y un fichero `.env` (copia `.env.example`; `HOST_IP` permite a los contenedores alcanzar Lamassu en el host). Define estos volúmenes con nombre:",{"_6944":122663,"_42621":122640,"_30085":199258,"_5":21646,"_28538":199190,"_5847":199259},[],"Volumen",{"_6944":122664,"_42621":122640,"_30085":199261,"_5":21646,"_28538":199190,"_5847":196247},[],{"_6944":122665,"_42621":122640,"_30085":199263,"_5":21646,"_28538":199190,"_5847":89833},[],{"_6944":122666,"_42621":122640,"_30085":199265,"_5":21646,"_28538":199190,"_5847":199266},[],"Datos de Postgres: las bases de datos `updates` y `hawkbit`, y la base `wfx` que guarda los trabajos de los dispositivos en modo `native`",{"_6944":122667,"_42621":122640,"_30085":199268,"_5":21646,"_28538":199190,"_5847":89839},[],{"_6944":122668,"_42621":122640,"_30085":199270,"_5":21646,"_28538":199190,"_5847":199271},[],"Espacio temporal de construcción y ficheros de actualización locales del servicio `updates`",{"_6944":122669,"_42621":122640,"_30085":199273,"_5":21646,"_28538":199190,"_5847":89845},[],{"_6944":122670,"_42621":122640,"_30085":199275,"_5":21646,"_28538":199190,"_5847":199276},[],"Material de claves de SymKMS",{"_6944":122671,"_42621":122640,"_30085":199278,"_5":21646,"_28538":199190,"_5847":89851},[],{"_6944":122672,"_42621":122640,"_30085":199280,"_5":21646,"_28538":199190,"_5847":199281},[],"Ficheros de artefactos de hawkBit, con `HAWKBIT_ARTIFACT_STORAGE=fs`",{"_6944":122673,"_42621":122640,"_30085":199283,"_5":21646,"_28538":199190,"_5847":89857},[],{"_6944":122674,"_42621":122640,"_30085":199285,"_5":21646,"_28538":199190,"_5847":199286},[],"El almacén S3 local, con `--profile s3`",{"_6944":122675,"_42621":122640,"_30085":199288,"_5":21646,"_28538":199190,"_5847":199289},[],"`docker compose --profile s3 up -d` arranca además RustFS (API S3 en el puerto `9000`) y un trabajo `s3-init` que crea un único bucket, `ota-updates`, con el cifrado del lado del servidor activado por defecto. Por convención cada backend usa un prefijo: `hawkbit/` para los artefactos de hawkBit y `ota/artifacts/` y `ota/builds/` para el modo `native`. Para guardar artefactos y compilaciones en S3, añade los bloques `artifacts` y `builds` que muestra `config.yml`, y define `HAWKBIT_ARTIFACT_STORAGE=s3` para hawkBit.",{"_6944":122676,"_42621":122640,"_30085":199291,"_5":21646,"_28538":199193,"_5847":199292},[],"El chart es `helm/updates-monolithic` del repositorio. Despliega solo el servicio `updates`: Postgres, WFX, Lamassu y, en modo `hawkbit`, hawkBit son externos.",{"_6944":122677,"_42621":122640,"_30085":199294,"_5":21646,"_28538":199193,"_5847":199295},[],"Valor",{"_6944":122678,"_42621":122640,"_30085":199297,"_5":21646,"_28538":199193,"_5847":199298},[],"Por defecto",{"_6944":122679,"_42621":122640,"_30085":199300,"_5":21646,"_28538":199193,"_5847":195948},[],{"_6944":122680,"_42621":122640,"_30085":199302,"_5":21646,"_28538":199193,"_5847":89876},[],{"_6944":122681,"_42621":122640,"_30085":199304,"_5":21646,"_28538":199193,"_5847":89879},[],{"_6944":122682,"_42621":122640,"_30085":199306,"_5":21646,"_28538":199193,"_5847":199307},[],"La imagen a ejecutar. Define `ghcr.io/lamassuiot/ota` y una etiqueta de release.",{"_6944":122683,"_42621":122640,"_30085":199309,"_5":21646,"_28538":199193,"_5847":89885},[],{"_6944":122684,"_42621":122640,"_30085":199311,"_5":21646,"_28538":199193,"_5847":89888},[],{"_6944":122685,"_42621":122640,"_30085":199313,"_5":21646,"_28538":199193,"_5847":199314},[],"Réplicas. Consulta Escalar horizontalmente.",{"_6944":122686,"_42621":122640,"_30085":199316,"_5":21646,"_28538":199193,"_5847":89894},[],{"_6944":122687,"_42621":122640,"_30085":199318,"_5":21646,"_28538":199193,"_5847":89897},[],{"_6944":122688,"_42621":122640,"_30085":199320,"_5":21646,"_28538":199193,"_5847":199321},[],"El chart no tiene plantilla de ingress: `ingress.*` en `values.yaml` no tiene efecto. Expón el servicio con tu propio ingress o gateway.",{"_6944":122689,"_42621":122640,"_30085":199323,"_5":21646,"_28538":199193,"_5847":89903},[],{"_6944":122690,"_42621":122640,"_30085":199325,"_5":21646,"_28538":199193,"_5847":199326},[],"límites `2000m` de CPU, `4Gi`; peticiones `500m`, `1Gi`",{"_6944":122691,"_42621":122640,"_30085":199328,"_5":21646,"_28538":199193,"_5847":199329},[],"Consulta Dimensionado de recursos.",{"_6944":122692,"_42621":122640,"_30085":199331,"_5":21646,"_28538":199193,"_5847":89912},[],{"_6944":122693,"_42621":122640,"_30085":199333,"_5":21646,"_28538":199193,"_5847":199334},[],"activado, `ReadWriteOnce`, `10Gi`",{"_6944":122694,"_42621":122640,"_30085":199336,"_5":21646,"_28538":199193,"_5847":199337},[],"El volumen montado en `/data`: espacio temporal de construcción y, por defecto, ficheros de actualización locales.",{"_6944":122695,"_42621":122640,"_30085":199339,"_5":21646,"_28538":199193,"_5847":89921},[],{"_6944":122696,"_42621":122640,"_30085":199341,"_5":21646,"_28538":199193,"_5847":89924},[],{"_6944":122697,"_42621":122640,"_30085":199343,"_5":21646,"_28538":199193,"_5847":199344},[],"Consulta Escalar horizontalmente. El chart inyecta `leader_election.mode` en la configuración por ti.",{"_6944":122698,"_42621":122640,"_30085":199346,"_5":21646,"_28538":199193,"_5847":89930},[],{"_6944":122699,"_42621":122640,"_30085":199348,"_5":21646,"_28538":199193,"_5847":199349},[],"consulta `values.yaml`",{"_6944":122700,"_42621":122640,"_30085":199351,"_5":21646,"_28538":199193,"_5847":199352},[],"Toda la configuración del servicio, volcada en un ConfigMap.",{"_6944":122701,"_42621":122640,"_30085":199354,"_5":21646,"_28538":199193,"_5847":89939},[],{"_6944":122702,"_42621":122640,"_30085":199356,"_5":21646,"_28538":199193,"_5847":89942},[],{"_6944":122703,"_42621":122640,"_30085":199358,"_5":21646,"_28538":199193,"_5847":199359},[],"Crea la cuenta de servicio y, con la elección de líder activada, un Role sobre `leases` (`get`, `list`, `watch`, `create`, `update`, `patch`).",{"_6944":122704,"_42621":122640,"_30085":199361,"_5":21646,"_28538":199193,"_5847":89948},[],{"_6944":122705,"_42621":122640,"_30085":199363,"_5":21646,"_28538":199193,"_5847":199364},[],"vacíos",{"_6944":122706,"_42621":122640,"_30085":199366,"_5":21646,"_28538":199193,"_5847":199367},[],"No se definen por defecto.",{"_6944":122707,"_42621":122640,"_30085":199369,"_5":21646,"_28538":199193,"_5847":89956},[],{"_6944":122708,"_42621":122640,"_30085":199371,"_5":21646,"_28538":199193,"_5847":199372},[],"no se usa",{"_6944":122709,"_42621":122640,"_30085":199374,"_5":21646,"_28538":199193,"_5847":199375},[],"Declarado, pero nada despliega PostgreSQL: usa una base de datos externa.",{"_6944":122710,"_42621":122640,"_30085":199377,"_5":21646,"_28538":199193,"_5847":199378},[],"Fijado por las plantillas: la estrategia de despliegue es &#x2A;*`Recreate`** (un despliegue tiene una breve interrupción), el periodo de gracia de terminación del pod es de 120 s con una pausa `preStop` de 5 s, las sondas llaman a `GET /health`, y un cambio en `config` reinicia los pods (una anotación con una suma de verificación).",{"_6944":122711,"_42621":122640,"_30085":199380,"_5":21646,"_28538":199193,"_5847":199381},[],"Apunta `config.*` a las dependencias. En particular, crea antes la base de datos `updates` en tu Postgres. El servicio crea sus tablas, no la base de datos. El valor por defecto del chart para `config.update_domain` es `http://updates:10090/v1/`, que carece del prefijo `/updates`: defínelo con la base completa de la API, terminada en `/updates/v1/`, tal como la alcanzan los dispositivos, o las URLs de descarga guardadas en los paquetes no resolverán.",{"_6944":122712,"_42621":122640,"_30085":199383,"_5":21646,"_28538":199196,"_5847":199384},[],"El chart vuelca todo el valor `config`, incluidos `storage.password`, `encryption.local_key`, las claves de S3 y `hawkbit.password`, en un ConfigMap. No tiene opción `existingSecret`, ni un valor para añadir variables de entorno o volúmenes, así que las sobrescrituras por variables de entorno del servicio y sus credenciales `*_file` no se pueden alimentar desde un Secret de Kubernetes sin parchear o envolver el chart. Mientras tanto:",{"_6944":122713,"_42621":122640,"_30085":199386,"_5":21646,"_28538":199196,"_5847":199387},[],"Guarda los valores reales en un fichero de valores que no se versione (`-f secrets.values.yaml`), o genéralo desde tu gestor de secretos en el momento del despliegue.",{"_6944":122714,"_42621":122640,"_30085":199389,"_5":21646,"_28538":199196,"_5847":199390},[],"Restringe quién puede leer ConfigMaps y secretos de release de Helm en el espacio de nombres.",{"_6944":122715,"_42621":122640,"_30085":199392,"_5":21646,"_28538":199196,"_5847":199393},[],"Prefiere credenciales que eviten claves estáticas: omite las claves de acceso de S3 para usar la cadena de credenciales por defecto de AWS (IRSA o un perfil de instancia).",{"_6944":122716,"_42621":122640,"_30085":199395,"_5":21646,"_28538":199196,"_5847":199396},[],"Sustituye la contraseña de base de datos de ejemplo que incluye el chart en `config.storage`.",{"_6944":122717,"_42621":122640,"_30085":199398,"_5":21646,"_28538":199196,"_5847":199399},[],"`helm/updates.yaml` es una sobrescritura de valores para el chart paraguas de Lamassu, que se usa como `helm upgrade lamassu lamassu/lamassu -f lamassu.yaml -f updates.yaml`. Allí define la imagen, las réplicas, los recursos, la persistencia y el `config` del servicio `updates`. Su límite de recursos de ejemplo (`500m` de CPU) es menor que el del chart: consulta Dimensionado de recursos.",{"_6944":122718,"_42621":122640,"_30085":199401,"_5":21646,"_28538":199200,"_5847":199402},[],"Servir HTTP funciona con cualquier número de réplicas en ambos modos. Lo que cambia es el estado que necesita cada réplica.",{"_6944":122719,"_42621":122640,"_30085":199404,"_5":21646,"_28538":199200,"_5847":89992},[],{"_6944":122720,"_42621":122640,"_30085":199406,"_5":21646,"_28538":199200,"_5847":87265},[],{"_6944":122721,"_42621":122640,"_30085":199408,"_5":21646,"_28538":199200,"_5847":199409},[],"Trabajo en segundo plano",{"_6944":122722,"_42621":122640,"_30085":199411,"_5":21646,"_28538":199200,"_5847":199412},[],"Con líder elegido: el consumidor de eventos de WFX y el disparador de lanzamientos programados se ejecutan en una réplica",{"_6944":122723,"_42621":122640,"_30085":199414,"_5":21646,"_28538":199200,"_5847":199415},[],"Ninguno",{"_6944":122724,"_42621":122640,"_30085":199417,"_5":21646,"_28538":199200,"_5847":196005},[],{"_6944":122725,"_42621":122640,"_30085":199419,"_5":21646,"_28538":199200,"_5847":199420},[],"Postgres, WFX, los almacenes `artifacts`, `builds` y `symkms`",{"_6944":122726,"_42621":122640,"_30085":199422,"_5":21646,"_28538":199200,"_5847":199423},[],"Postgres y hawkBit",{"_6944":122727,"_42621":122640,"_30085":199425,"_5":21646,"_28538":199200,"_5847":199426},[],"Ficheros locales",{"_6944":122728,"_42621":122640,"_30085":199428,"_5":21646,"_28538":199200,"_5847":199429},[],"Solo espacio temporal de construcción (cada réplica lo recrea)",{"_6944":122729,"_42621":122640,"_30085":199431,"_5":21646,"_28538":199200,"_5847":199415},[],{"_6944":122730,"_42621":122640,"_30085":199433,"_5":21646,"_28538":199200,"_5847":199434},[],"Requisito adicional",{"_6944":122731,"_42621":122640,"_30085":199436,"_5":21646,"_28538":199200,"_5847":199437},[],"Almacenes S3 y elección de líder",{"_6944":122732,"_42621":122640,"_30085":199439,"_5":21646,"_28538":199200,"_5847":199440},[],"`symkms.storage` compartido o en S3 si usas cifrado con clave compartida",{"_6944":122733,"_42621":122640,"_30085":199442,"_5":21646,"_28538":199200,"_5847":199443},[],"Para ejecutar más de una réplica `native`:",{"_6944":122734,"_42621":122640,"_30085":199445,"_5":21646,"_28538":199200,"_5847":199446},[],"**Almacenamiento compartido.** El valor por defecto es un volumen `ReadWriteOnce`, que no pueden montar pods de nodos distintos, así que limita el despliegue a una réplica sea cual sea `replicaCount`. Apunta `config.artifacts`, `config.builds` y `config.symkms.storage` a S3 y define `persistence.enabled: false`. Las claves de SymKMS también usan por defecto almacenamiento local, y no se compartirían entre réplicas. El servicio registra una advertencia al arrancar cuando las salidas de compilación están en almacenamiento local. Las sw-descriptions se guardan en Postgres, así que ninguna réplica necesita nada local de otra.",{"_6944":122735,"_42621":122640,"_30085":199448,"_5":21646,"_28538":199200,"_5847":199449},[],"**Elección de líder.** Deja `leaderElection.enabled: true`. El consumidor de eventos de WFX avanza los lotes de una campaña con cada trabajo completado, y el disparador inicia los lanzamientos programados que vencen y repara los lotes interrumpidos. Con varias réplicas y sin elección, cada una cuenta las mismas finalizaciones y libera el siguiente lote antes de que el actual haya tenido éxito.",{"_6944":122736,"_42621":122640,"_30085":199451,"_5":21646,"_28538":199200,"_5847":199452},[],"`leaderElection.mode` (`leader_election.mode` en el fichero) es:",{"_6944":122737,"_42621":122640,"_30085":199454,"_5":21646,"_28538":199200,"_5847":199295},[],{"_6944":122738,"_42621":122640,"_30085":199456,"_5":21646,"_28538":199200,"_5847":199457},[],"Comportamiento",{"_6944":122739,"_42621":122640,"_30085":199459,"_5":21646,"_28538":199200,"_5847":199460},[],"vacío (automático)",{"_6944":122740,"_42621":122640,"_30085":199462,"_5":21646,"_28538":199200,"_5847":199463},[],"Leases de Kubernetes dentro de un clúster; en caso contrario, un bloqueo consultivo de Postgres. Es el valor por defecto del binario.",{"_6944":122741,"_42621":122640,"_30085":199465,"_5":21646,"_28538":199200,"_5847":90054},[],{"_6944":122742,"_42621":122640,"_30085":199467,"_5":21646,"_28538":199200,"_5847":199468},[],"Leases, obligatorio. El arranque falla si la cuenta de servicio no puede usarlos. Es el valor por defecto del chart.",{"_6944":122743,"_42621":122640,"_30085":199470,"_5":21646,"_28538":199200,"_5847":90060},[],{"_6944":122744,"_42621":122640,"_30085":199472,"_5":21646,"_28538":199200,"_5847":199473},[],"Un bloqueo consultivo de Postgres, para cuando conceder RBAC no es una opción.",{"_6944":122745,"_42621":122640,"_30085":199475,"_5":21646,"_28538":199200,"_5847":199476},[],"Con Leases, se crea un Lease por rol en el espacio de nombres del pod (`lamassu-updates-wfx-event-consumer` y `lamassu-updates-scheduled-launch-trigger`), y `kubectl get lease` muestra el pod que lidera (`POD_NAME` es el titular). El lease dura 15 s y se renueva en 10 s, así que una conmutación por fallo tarda aproximadamente eso. Con el bloqueo de base de datos, una réplica en espera reintenta cada 15 s y el líder verifica cada 5 s que su conexión sigue viva.",{"_6944":122746,"_42621":122640,"_30085":199478,"_5":21646,"_28538":199200,"_5847":199479},[],"Otras garantías con varias réplicas: las construcciones y cambios de versión del mismo paquete toman un bloqueo de Postgres (una petición concurrente responde `409`), las migraciones de esquema también, y un lote de campaña se reclama de forma atómica para que no se libere dos veces. Cada réplica mantiene hasta 25 conexiones de base de datos: calcula `25 x réplicas` frente al `max_connections` de Postgres.",{"_6944":122747,"_42621":122640,"_30085":199481,"_5":21646,"_28538":199200,"_5847":199482},[],"En modo `hawkbit` no hay nada que elegir ni ficheros locales que compartir. El chart sigue montando el volumen `ReadWriteOnce` mientras `persistence.enabled` es true, así que defínelo en `false` para ejecutar réplicas en nodos distintos.",{"_6944":122748,"_42621":122640,"_30085":199484,"_5":21646,"_28538":199200,"_5847":199485},[],"Como el chart usa la estrategia `Recreate`, un despliegue detiene todas las réplicas antes de arrancar las nuevas, incluso con `replicaCount` superior a 1.",{"_6944":122749,"_42621":122640,"_30085":199487,"_5":21646,"_28538":199204,"_5847":199488},[],"**La CPU** es la palanca del tiempo de construcción por dispositivo. Una construcción ejecuta un `swugenerator` por dispositivo, y el paralelismo se deriva del límite de CPU del contenedor, no de los núcleos del nodo: un límite de `500m` lo reduce a medio núcleo. El valor por defecto del chart, `2000m`, es un punto de partida para grupos de cientos.",{"_6944":122750,"_42621":122640,"_30085":199490,"_5":21646,"_28538":199204,"_5847":199491},[],"**Memoria.** Las subidas, las descargas y las construcciones sin cifrado se transmiten en streaming, así que la memoria no crece con el fichero (los mantenedores midieron un pico de unos 150 MiB residentes para una subida de 10 GiB y para una descarga de 10 GiB). Cifrar necesita el fichero en memoria: `swugenerator` lee un artefacto en memoria para cifrarlo, el AES-GCM de los paquetes `non-swu` y de los módulos `raw` trabaja sobre un único búfer, y un almacén con cifrado en reposo descifra objetos enteros en memoria. Dimensiona la memoria para el mayor fichero que cifres multiplicado por las construcciones concurrentes. En modo `hawkbit`, `build_memory_limit_mb` rechaza una construcción así antes de que el pod muera.",{"_6944":122751,"_42621":122640,"_30085":199493,"_5":21646,"_28538":199204,"_5847":199494},[],"**Disco.** Cada subida en curso se escribe en un fichero temporal bajo `TMPDIR` antes de almacenarse, así que las subidas simultáneas necesitan ese espacio libre. El espacio temporal de construcción usa además `update_files_base_dir` (`/data` en el chart). Da al volumen margen para varias subidas simultáneas (el ejemplo del chart paraguas usa `50Gi`). El chart no expone valores de entorno, así que fijar `TMPDIR` en el volumen exige un chart parcheado o envuelto.",{"_6944":122752,"_42621":122640,"_30085":199496,"_5":21646,"_28538":199208,"_5847":199497},[],"`max_artifact_size_mb` (por defecto 10 GiB) limita un fichero subido. Todo lo que haya delante del servicio debe permitir el mismo tamaño y mantener la conexión abierta tanto como dure la transferencia: el propio servicio usa tiempos de lectura y escritura de 6 horas y cierra las conexiones inactivas a los 5 minutos. Para ingress-nginx:",{"_6944":122753,"_42621":122640,"_30085":199499,"_5":21646,"_28538":199208,"_5847":199500},[],"El límite de cuerpo por defecto de nginx es de 1 MiB, que es lo que rechaza subidas de «unos pocos MB» antes de que lleguen al servicio. Un fichero por encima del límite propio del servicio recibe `413` con el límite indicado.",{"_6944":122754,"_42621":122640,"_30085":199502,"_5":21646,"_28538":199212,"_5847":199503},[],"Qué",{"_6944":122755,"_42621":122640,"_30085":199505,"_5":21646,"_28538":199212,"_5847":199506},[],"Cómo",{"_6944":122756,"_42621":122640,"_30085":199508,"_5":21646,"_28538":199212,"_5847":199509},[],"Liveness y readiness",{"_6944":122757,"_42621":122640,"_30085":199511,"_5":21646,"_28538":199212,"_5847":199512},[],"`GET /health` devuelve `{\"status\":\"ok\"}` sin comprobar Postgres, WFX ni hawkBit, así que solo demuestra que el proceso responde. El chart lo usa para ambas sondas, y la imagen Docker lo ejecuta cada 30 segundos.",{"_6944":122758,"_42621":122640,"_30085":199514,"_5":21646,"_28538":199212,"_5847":198989},[],{"_6944":122759,"_42621":122640,"_30085":199516,"_5":21646,"_28538":199212,"_5847":199517},[],"`GET /updates/v1/capabilities` muestra el backend activo y lo que soporta. No requiere autenticación y no tiene efectos secundarios, pero en modo `hawkbit` consulta a hawkBit, así que no lo uses como sonda.",{"_6944":122760,"_42621":122640,"_30085":199519,"_5":21646,"_28538":199212,"_5847":199520},[],"Registros",{"_6944":122761,"_42621":122640,"_30085":199522,"_5":21646,"_28538":199212,"_5847":199523},[],"Se escriben en la salida estándar: el registro de la aplicación (nivel `app.logs.level`) y un registro de acceso de cada petición. Con `debug`, el registro de arranque incluye toda la configuración, secretos también.",{"_6944":122762,"_42621":122640,"_30085":199525,"_5":21646,"_28538":199212,"_5847":199526},[],"Apagado",{"_6944":122763,"_42621":122640,"_30085":199528,"_5":21646,"_28538":199212,"_5847":199529},[],"Con `SIGTERM` o `SIGINT` el servicio deja de aceptar peticiones, drena las que están en curso hasta `app.server.shutdown_timeout` (60 s), cede el liderazgo y, en modo `native`, espera hasta 30 s más a que termine un envío de lote en marcha. El periodo de gracia del chart (120 s) lo cubre.",{"_6944":122764,"_42621":122640,"_30085":199531,"_5":21646,"_28538":199216,"_5847":199532},[],"El servicio no exporta trazas, métricas ni registros. Sus clientes HTTP salientes (el cliente de SymKMS) y su capa de base de datos están instrumentados con OpenTelemetry, pero no se configura ningún proveedor de trazas ni exportador, y no hay endpoint de métricas. El directorio `otel/` del repositorio contiene una pila local de desarrollo (Grafana Alloy con receptores OTLP en 4317 y 4318, Loki, Tempo, Prometheus, Grafana; Jaeger en `otel/jaeger/`) a la que hoy no envía nada. Mientras no haya exportadores, monitoriza el registro del proceso y `/health`, y vigila los eventos y los Leases de Kubernetes.",{"_6944":122765,"_42621":122640,"_30085":199534,"_5":21646,"_28538":199219,"_5847":199535},[],"Qué respaldar",{"_6944":122766,"_42621":122640,"_30085":199537,"_5":21646,"_28538":199219,"_5847":199538},[],"Por qué",{"_6944":122767,"_42621":122640,"_30085":199540,"_5":21646,"_28538":199219,"_5847":199541},[],"Postgres: la base de datos `updates`, más `wfx` en modo `native` (los trabajos de los dispositivos) y `hawkbit` en modo `hawkbit`",{"_6944":122768,"_42621":122640,"_30085":199543,"_5":21646,"_28538":199219,"_5847":199544},[],"Paquetes, lanzamientos, historial de dispositivos y, en modo `hawkbit`, sw-descriptions, manifiestos firmados y estado en tránsito",{"_6944":122769,"_42621":122640,"_30085":199546,"_5":21646,"_28538":199219,"_5847":199547},[],"Los buckets S3 `artifacts` y `builds` (o el volumen `update_files`)",{"_6944":122770,"_42621":122640,"_30085":199549,"_5":21646,"_28538":199219,"_5847":199550},[],"Binarios de artefactos y salidas de compilación. Las compilaciones se pueden reconstruir a partir de los artefactos y la sw-description (guardada en Postgres); los artefactos en sí no se pueden recrear.",{"_6944":122771,"_42621":122640,"_30085":199552,"_5":21646,"_28538":199219,"_5847":199553},[],"El almacén `symkms` (bucket S3 o el volumen `sym_keys`)",{"_6944":122772,"_42621":122640,"_30085":199555,"_5":21646,"_28538":199219,"_5847":199556},[],"Claves de cifrado de dispositivo y compartidas. Si se pierden, los paquetes ya entregados no se pueden reconstruir de forma idéntica y los dispositivos no pueden descifrar los nuevos.",{"_6944":122773,"_42621":122640,"_30085":199558,"_5":21646,"_28538":199219,"_5847":199559},[],"`encryption.local_key` (o la clave de AWS KMS)",{"_6944":122774,"_42621":122640,"_30085":199561,"_5":21646,"_28538":199219,"_5847":199562},[],"Todo blob guardado con cifrado en reposo es ilegible sin ella. Guárdala separada de los datos.",{"_6944":122775,"_42621":122640,"_30085":199564,"_5":21646,"_28538":199219,"_5847":199565},[],"El almacén de artefactos de hawkBit (volumen o bucket), modo `hawkbit`",{"_6944":122776,"_42621":122640,"_30085":199567,"_5":21646,"_28538":199219,"_5847":199568},[],"Los ficheros de artefactos",{"_6944":122777,"_42621":122640,"_30085":199570,"_5":21646,"_28538":199219,"_5847":199571},[],"Restaura la base de datos y los almacenes de blobs desde el mismo instante: una base de datos que referencia un artefacto ausente del almacenamiento devuelve errores al descargar y al reconstruir. En modo `hawkbit`, mantén además coherentes las bases de datos `updates` y `hawkbit`: las filas de la base `updates` están acotadas a la instancia de hawkBit que las escribió, y se ignoran si hawkBit vuelve con un conjunto de datos distinto.",{"_6944":122778,"_42621":122640,"_30085":199573,"_5":21646,"_28538":199227,"_5847":199574},[],"Haz las copias de arriba, sobre todo de la base de datos `updates`.",{"_6944":122779,"_42621":122640,"_30085":199576,"_5":21646,"_28538":199231,"_5847":199577},[],"No hay ficheros de migración. Al arrancar, el servicio renombra, crea y migra sus propias tablas bajo un bloqueo consultivo de Postgres, así que las réplicas que arrancan a la vez no compiten. Entre otras cosas, renombra las tablas y columnas del antiguo vocabulario de «update pack» al de «distribution set», integra la tabla de módulos independientes en las tablas de módulos, rellena las asignaciones de dispositivos y convierte los umbrales de aprobación. Consulta Modelo de datos.",{"_6944":122780,"_42621":122640,"_30085":199579,"_5":21646,"_28538":199235,"_5847":199580},[],"Comprueba `GET /health` y `GET /updates/v1/capabilities`, y lee el registro de arranque en busca de errores de migración.",{"_6944":122781,"_42621":122640,"_30085":199582,"_5":21646,"_28538":199235,"_5847":199583},[],"No hay reversión automática, y las migraciones son de un solo sentido: una imagen anterior no entiende las tablas renombradas. Para volver atrás, restaura la base de datos y los almacenes de blobs desde la copia de seguridad y ejecuta la imagen anterior.",{"_6944":122782,"_42621":122640,"_30085":199585,"_5":21646,"_28538":199239,"_5847":199586},[],"En modo `hawkbit`, hawkBit es un servicio aparte que operas tú. Su heap de JVM se fija con `X_MS` y `X_MX` (el valor por defecto de la imagen es `768m` cada una; `JAVA_OPTS` no lo fija), sus límites de artefactos con las variables `SPRING_SERVLET_MULTIPART_*` y `HAWKBIT_SERVER_SECURITY_DOS_*`, y su almacén de artefactos con `HAWKBIT_ARTIFACT_STORAGE`. Consulta Modo hawkBit.",{"_6944":122783,"_42621":122640,"_30085":199588,"_5":21646,"_28538":199243,"_5847":199589},[],"Consulta Seguridad. En resumen: pon delante del servicio un gateway con TLS y autenticación, mantén `enable_test_endpoints: false`, restringe las rutas de claves de SymKMS, mantén Postgres, la gestión de WFX, el KMS y hawkBit en redes privadas, y no dejes secretos en el repositorio ni en los registros.",{"_6944":122784,"_42621":122784,"_5":22076,"_5847":89452,"_43101":199591,"_30085":199592,"_28538":122784},[78004,189200,195583],[],{"_6944":122785,"_42621":122784,"_30085":199594,"_5":21646,"_28538":122784,"_5847":199595},[],"Qué hace el servicio, cómo encaja con Lamassu IoT, WFX y hawkBit, y por dónde empezar.",{"_6944":122786,"_42621":122784,"_5":43098,"_30085":199597,"_28538":199598,"_5847":199599},[],"/docs/pr-preview/pr-56/es/platform/updates/overview#con-qué-se-conecta","Con qué se conecta",{"_6944":122787,"_42621":122784,"_5":43098,"_30085":199601,"_28538":199602,"_5847":199603},[],"/docs/pr-preview/pr-56/es/platform/updates/overview#elige-tu-backend","Elige tu backend",{"_6944":122788,"_42621":122784,"_5":43098,"_30085":199605,"_28538":199606,"_5847":190839},[],"/docs/pr-preview/pr-56/es/platform/updates/overview#siguientes-pasos",{"_6944":122789,"_42621":122784,"_30085":199608,"_5":21646,"_28538":122784,"_5847":199609},[],"Lamassu Updates (también llamado OTA Update Service) orquesta las actualizaciones de software por aire (OTA) de flotas IoT. Publicas una actualización, eliges qué dispositivos la reciben y sigues el despliegue. El servicio construye el paquete que instalan los clientes SWUpdate y puede firmarlo y cifrarlo.",{"_6944":122790,"_42621":122784,"_30085":199611,"_5":21646,"_28538":122784,"_5847":199612},[],"Hay una única API HTTP y dos backends intercambiables detrás de ella, que se eligen con el ajuste `mode`. El backend decide con qué servidor de actualizaciones hablan los dispositivos, así que los sistemas que rodean al servicio dependen de él.",{"_6944":122791,"_42621":122784,"_30085":199614,"_5":21646,"_28538":199598,"_5847":195754},[],{"_6944":122792,"_42621":122784,"_30085":199616,"_5":21646,"_28538":199598,"_5847":195650},[],{"_6944":122793,"_42621":122784,"_30085":199618,"_5":21646,"_28538":199598,"_5847":89992},[],{"_6944":122794,"_42621":122784,"_30085":199620,"_5":21646,"_28538":199598,"_5847":87265},[],{"_6944":122795,"_42621":122784,"_30085":199622,"_5":21646,"_28538":199598,"_5847":90213},[],{"_6944":122796,"_42621":122784,"_30085":199624,"_5":21646,"_28538":199598,"_5847":199625},[],"Registro de dispositivos (grupos de dispositivos) y KMS. Las claves de firma viven en su KMS",{"_6944":122797,"_42621":122784,"_30085":199627,"_5":21646,"_28538":199598,"_5847":199628},[],"Obligatorio",{"_6944":122798,"_42621":122784,"_30085":199630,"_5":21646,"_28538":199598,"_5847":199631},[],"Opcional: sin él, los grupos se leen de las etiquetas `group:<id>` de los targets del propio hawkBit",{"_6944":122799,"_42621":122784,"_30085":199633,"_5":21646,"_28538":199598,"_5847":86224},[],{"_6944":122800,"_42621":122784,"_30085":199635,"_5":21646,"_28538":199598,"_5847":199636},[],"Orquestación de trabajos. Cada actualización de un dispositivo es un trabajo (job) de WFX que el dispositivo consulta",{"_6944":122801,"_42621":122784,"_30085":199638,"_5":21646,"_28538":199598,"_5847":199628},[],{"_6944":122802,"_42621":122784,"_30085":199640,"_5":21646,"_28538":199598,"_5847":199641},[],"No se usa",{"_6944":122803,"_42621":122784,"_30085":199643,"_5":21646,"_28538":199598,"_5847":86232},[],{"_6944":122804,"_42621":122784,"_30085":199645,"_5":21646,"_28538":199598,"_5847":199646},[],"Servidor de actualizaciones. Almacena paquetes, módulos y rollouts, y los dispositivos lo consultan",{"_6944":122805,"_42621":122784,"_30085":199648,"_5":21646,"_28538":199598,"_5847":199641},[],{"_6944":122806,"_42621":122784,"_30085":199650,"_5":21646,"_28538":199598,"_5847":199628},[],{"_6944":122807,"_42621":122784,"_30085":199652,"_5":21646,"_28538":199598,"_5847":86197},[],{"_6944":122808,"_42621":122784,"_30085":199654,"_5":21646,"_28538":199598,"_5847":195764},[],{"_6944":122809,"_42621":122784,"_30085":199656,"_5":21646,"_28538":199598,"_5847":199628},[],{"_6944":122810,"_42621":122784,"_30085":199658,"_5":21646,"_28538":199598,"_5847":199628},[],{"_6944":122811,"_42621":122784,"_30085":199660,"_5":21646,"_28538":199598,"_5847":37705},[],{"_6944":122812,"_42621":122784,"_30085":199662,"_5":21646,"_28538":199598,"_5847":199663},[],"Herramienta Python, incluida en el repositorio ota, que ensambla el fichero `.swu` firmado y, opcionalmente, cifrado",{"_6944":122813,"_42621":122784,"_30085":199665,"_5":21646,"_28538":199598,"_5847":195806},[],{"_6944":122814,"_42621":122784,"_30085":199667,"_5":21646,"_28538":199598,"_5847":195806},[],{"_6944":122815,"_42621":122784,"_30085":199669,"_5":21646,"_28538":199598,"_5847":199670},[],"El dashboard de Lamassu es la interfaz web de esta API. Lee su URL base de `LAMASSU_UPDATES_API` en `public/config.js` (si no está definida, usa la URL base de la API principal) y añade él mismo `/updates/v1` y `/symkms/v1`. También lee una vez `GET /updates/v1/capabilities` y oculta las funciones que el backend activo no soporta.",{"_6944":122816,"_42621":122784,"_30085":199672,"_5":21646,"_28538":199602,"_5847":199673},[],"La API HTTP es la misma en ambos casos. Lo que cambia es quién almacena los datos y con quién hablan los dispositivos.",{"_6944":122817,"_42621":122784,"_30085":199675,"_5":21646,"_28538":199602,"_5847":199676},[],"`native` (por defecto)",{"_6944":122818,"_42621":122784,"_30085":199678,"_5":21646,"_28538":199602,"_5847":87265},[],{"_6944":122819,"_42621":122784,"_30085":199680,"_5":21646,"_28538":199602,"_5847":199681},[],"Almacena paquetes, lanzamientos y trabajos",{"_6944":122820,"_42621":122784,"_30085":199683,"_5":21646,"_28538":199602,"_5847":199684},[],"El Postgres de este servicio, más WFX",{"_6944":122821,"_42621":122784,"_30085":199686,"_5":21646,"_28538":199602,"_5847":199687},[],"Un servidor Eclipse hawkBit",{"_6944":122822,"_42621":122784,"_30085":199689,"_5":21646,"_28538":199602,"_5847":199690},[],"Los dispositivos consultan",{"_6944":122823,"_42621":122784,"_30085":199692,"_5":21646,"_28538":199602,"_5847":86224},[],{"_6944":122824,"_42621":122784,"_30085":199694,"_5":21646,"_28538":199602,"_5847":199695},[],"hawkBit (API DDI)",{"_6944":122825,"_42621":122784,"_30085":199697,"_5":21646,"_28538":199602,"_5847":199698},[],"Un paquete se construye",{"_6944":122826,"_42621":122784,"_30085":199700,"_5":21646,"_28538":199602,"_5847":199701},[],"Entero, a partir de los ficheros de todos sus módulos, en un único `.swu`",{"_6944":122827,"_42621":122784,"_30085":199703,"_5":21646,"_28538":199602,"_5847":199704},[],"Un `.swu` (o entregable raw) por módulo, construido en el catálogo de módulos",{"_6944":122828,"_42621":122784,"_30085":199706,"_5":21646,"_28538":199602,"_5847":199707},[],"Cifrado por dispositivo",{"_6944":122829,"_42621":122784,"_30085":199709,"_5":21646,"_28538":199602,"_5847":199710},[],"Soportado",{"_6944":122830,"_42621":122784,"_30085":199712,"_5":21646,"_28538":199602,"_5847":199713},[],"No soportado",{"_6944":122831,"_42621":122784,"_30085":199715,"_5":21646,"_28538":199602,"_5847":199716},[],"Elígelo cuando",{"_6944":122832,"_42621":122784,"_30085":199718,"_5":21646,"_28538":199602,"_5847":199719},[],"Empiezas de cero, o necesitas cifrado por dispositivo",{"_6944":122833,"_42621":122784,"_30085":199721,"_5":21646,"_28538":199602,"_5847":199722},[],"hawkBit ya es el backend de actualizaciones de tu flota",{"_6944":122834,"_42621":122784,"_30085":199724,"_5":21646,"_28538":199602,"_5847":199725},[],"Se configura con el campo `mode` de la configuración. Los backends no son equivalentes en todas las funciones: consulta Capacidades y Modo hawkBit.",{"_6944":122835,"_42621":122784,"_30085":199727,"_5":21646,"_28538":199606,"_5847":199728},[],"Quiero...",{"_6944":122836,"_42621":122784,"_30085":199730,"_5":21646,"_28538":199606,"_5847":199731},[],"Lee",{"_6944":122837,"_42621":122784,"_30085":199733,"_5":21646,"_28538":199606,"_5847":199734},[],"Ejecutar toda la pila en local",{"_6944":122838,"_42621":122784,"_30085":199736,"_5":21646,"_28538":199606,"_5847":192538},[],{"_6944":122839,"_42621":122784,"_30085":199738,"_5":21646,"_28538":199606,"_5847":199739},[],"Entender los términos (paquete, módulo, lanzamiento)",{"_6944":122840,"_42621":122784,"_30085":199741,"_5":21646,"_28538":199606,"_5847":199742},[],"Conceptos y Modelo de datos",{"_6944":122841,"_42621":122784,"_30085":199744,"_5":21646,"_28538":199606,"_5847":199745},[],"Ver los componentes y cómo fluyen los datos",{"_6944":122842,"_42621":122784,"_30085":199747,"_5":21646,"_28538":199606,"_5847":199748},[],"Arquitectura y Flujos",{"_6944":122843,"_42621":122784,"_30085":199750,"_5":21646,"_28538":199606,"_5847":199751},[],"Publicar una actualización y desplegarla",{"_6944":122844,"_42621":122784,"_30085":199753,"_5":21646,"_28538":199606,"_5847":199754},[],"Publicar y desplegar una actualización",{"_6944":122845,"_42621":122784,"_30085":199756,"_5":21646,"_28538":199606,"_5847":199757},[],"Probar todo el flujo con curl",{"_6944":122846,"_42621":122784,"_30085":199759,"_5":21646,"_28538":199606,"_5847":199760},[],"Nativo o hawkBit",{"_6944":122847,"_42621":122784,"_30085":199762,"_5":21646,"_28538":199606,"_5847":199763},[],"Hacerlo desde la interfaz web",{"_6944":122848,"_42621":122784,"_30085":199765,"_5":21646,"_28538":199606,"_5847":199766},[],"Usar el dashboard",{"_6944":122849,"_42621":122784,"_30085":199768,"_5":21646,"_28538":199606,"_5847":199769},[],"Conectar un dispositivo",{"_6944":122850,"_42621":122784,"_30085":199771,"_5":21646,"_28538":199606,"_5847":199769},[],{"_6944":122851,"_42621":122784,"_30085":199773,"_5":21646,"_28538":199606,"_5847":199774},[],"Usar un hawkBit existente",{"_6944":122852,"_42621":122784,"_30085":199776,"_5":21646,"_28538":199606,"_5847":195599},[],{"_6944":122853,"_42621":122784,"_30085":199778,"_5":21646,"_28538":199606,"_5847":199779},[],"Firmar o cifrar actualizaciones",{"_6944":122854,"_42621":122784,"_30085":199781,"_5":21646,"_28538":199606,"_5847":199055},[],{"_6944":122855,"_42621":122784,"_30085":199783,"_5":21646,"_28538":199606,"_5847":199784},[],"Ajustar un campo de configuración",{"_6944":122856,"_42621":122784,"_30085":199786,"_5":21646,"_28538":199606,"_5847":199787},[],"Configuración",{"_6944":122857,"_42621":122784,"_30085":199789,"_5":21646,"_28538":199606,"_5847":199790},[],"Llamar a la API",{"_6944":122858,"_42621":122784,"_30085":199792,"_5":21646,"_28538":199606,"_5847":197939},[],{"_6944":122859,"_42621":122784,"_30085":199794,"_5":21646,"_28538":199606,"_5847":199795},[],"Desplegarlo, escalarlo, respaldarlo o actualizarlo",{"_6944":122860,"_42621":122784,"_30085":199797,"_5":21646,"_28538":199606,"_5847":199175},[],{"_6944":122861,"_42621":122784,"_30085":199799,"_5":21646,"_28538":199606,"_5847":199800},[],"Securizarlo",{"_6944":122862,"_42621":122784,"_30085":199802,"_5":21646,"_28538":199606,"_5847":197547},[],{"_6944":122863,"_42621":122784,"_30085":199804,"_5":21646,"_28538":199606,"_5847":199805},[],"Resolver un problema",{"_6944":122864,"_42621":122784,"_30085":199807,"_5":21646,"_28538":199606,"_5847":195477},[],{"_6944":122865,"_42621":122784,"_30085":199809,"_5":21646,"_28538":199606,"_5847":199810},[],"Ver qué no está soportado",{"_6944":122866,"_42621":122784,"_30085":199812,"_5":21646,"_28538":199606,"_5847":199813},[],"Limitaciones",{"_6944":122867,"_42621":122784,"_30085":199815,"_5":21646,"_28538":199606,"_5847":199816},[],"El código fuente, las configuraciones de ejemplo y el chart de Helm están en el repositorio ota.",{"_6944":122868,"_42621":122868,"_5":22076,"_5847":197939,"_43101":199818,"_30085":199820,"_28538":122868},[78004,189200,195583,199819],"Referencia",[],{"_6944":122869,"_42621":122868,"_30085":199822,"_5":21646,"_28538":122868,"_5847":199823},[],"Todas las rutas de las APIs HTTP de Lamassu Updates y SymKMS, con cuerpos de petición, códigos de estado y comportamiento por backend.",{"_6944":122870,"_42621":122868,"_5":43098,"_30085":199825,"_28538":199826,"_5847":199827},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#convenciones","Convenciones",{"_6944":122871,"_42621":122868,"_5":43098,"_30085":199829,"_28538":199830,"_5847":199831},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#códigos-de-estado","Códigos de estado",{"_6944":122872,"_42621":122868,"_5":43098,"_30085":199833,"_28538":199834,"_5847":199835},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#descargas","Descargas",{"_6944":122873,"_42621":122868,"_5":43098,"_30085":199837,"_28538":199838,"_5847":199839},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#endpoints-de-listado","Endpoints de listado",{"_6944":122874,"_42621":122868,"_5":43098,"_30085":199841,"_28538":199842,"_5847":199843},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#capabilities-y-workflows","Capabilities y workflows",{"_6944":122875,"_42621":122868,"_5":43098,"_30085":199845,"_28538":199846,"_5847":199847},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#packs-de-actualización","Packs de actualización",{"_6944":122876,"_42621":122868,"_5":43098,"_30085":199849,"_28538":199850,"_5847":199851},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#descriptor-artefactos-y-precondiciones","Descriptor, artefactos y precondiciones",{"_6944":122877,"_42621":122868,"_5":43098,"_30085":199853,"_28538":199854,"_5847":199855},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#compilación-y-descarga","Compilación y descarga",{"_6944":122878,"_42621":122868,"_5":43098,"_30085":199857,"_28538":199858,"_5847":199859},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#versiones","Versiones",{"_6944":122879,"_42621":122868,"_5":43098,"_30085":199861,"_28538":199862,"_5847":199863},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#cuerpos-de-las-peticiones","Cuerpos de las peticiones",{"_6944":122880,"_42621":122868,"_5":43098,"_30085":199865,"_28538":199866,"_5847":199867},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#respuestas","Respuestas",{"_6944":122881,"_42621":122868,"_5":43098,"_30085":199869,"_28538":199870,"_5847":199871},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#objetos","Objetos",{"_6944":122882,"_42621":122868,"_5":43098,"_30085":199873,"_28538":199874,"_5847":90459},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#pack",{"_6944":122883,"_42621":122868,"_5":43098,"_30085":199876,"_28538":199877,"_5847":199878},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#lanzamiento","Lanzamiento",{"_6944":122884,"_42621":122868,"_5":43098,"_30085":199880,"_28538":199881,"_5847":195962},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#módulo-de-software",{"_6944":122885,"_42621":122868,"_5":43098,"_30085":199883,"_28538":199884,"_5847":195970},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#artefacto",{"_6944":122886,"_42621":122868,"_5":43098,"_30085":199886,"_28538":199887,"_5847":199888},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#módulos-dentro-de-un-pack","Módulos dentro de un pack",{"_6944":122887,"_42621":122868,"_5":43098,"_30085":199890,"_28538":199891,"_5847":199892},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#catálogo-de-módulos-de-software","Catálogo de módulos de software",{"_6944":122888,"_42621":122868,"_5":43098,"_30085":199894,"_28538":199895,"_5847":199863},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#cuerpos-de-las-peticiones-1",{"_6944":122889,"_42621":122868,"_5":43098,"_30085":199897,"_28538":199898,"_5847":199899},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#artefactos-globales","Artefactos globales",{"_6944":122890,"_42621":122868,"_5":43098,"_30085":199901,"_28538":199902,"_5847":195917},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#campañas-de-lanzamiento",{"_6944":122891,"_42621":122868,"_5":43098,"_30085":199904,"_28538":199905,"_5847":90491},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#jobs",{"_6944":122892,"_42621":122868,"_5":43098,"_30085":199907,"_28538":199908,"_5847":199909},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#inventario-de-dispositivos","Inventario de dispositivos",{"_6944":122893,"_42621":122868,"_5":43098,"_30085":199911,"_28538":199912,"_5847":199913},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#conformidad-de-versiones-y-últimas-versiones","Conformidad de versiones y últimas versiones",{"_6944":122894,"_42621":122868,"_5":43098,"_30085":199915,"_28538":199916,"_5847":199917},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#descarga-de-artefactos-por-el-dispositivo-modo-hawkbit","Descarga de artefactos por el dispositivo, modo hawkBit",{"_6944":122895,"_42621":122868,"_5":43098,"_30085":199919,"_28538":199920,"_5847":86101},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#symkms",{"_6944":122896,"_42621":122868,"_5":43098,"_30085":199922,"_28538":199923,"_5847":190839},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#siguientes-pasos",{"_6944":122897,"_42621":122868,"_30085":199925,"_5":21646,"_28538":122868,"_5847":199926},[],"Referencia de la API HTTP de Lamassu Updates, tal como la implementa el servicio en `internal/updates/httpapi` (compartido por los backends native y hawkBit). Úsala para consultar una ruta, un campo de un cuerpo o un código de estado. Para ejemplos completos, sigue la guía de curl con el backend native o con hawkBit.",{"_6944":122898,"_42621":122868,"_30085":199928,"_5":21646,"_28538":199826,"_5847":199929},[],"La API de Updates se sirve bajo `/updates/v1` y SymKMS bajo `/symkms/v1`. Las rutas de esta página son relativas a `/updates/v1`, salvo las que empiezan por `/health` o `/symkms`. Detrás del gateway de Lamassu el prefijo suele ser `/api/updates/v1`, que es lo que llama el dashboard.",{"_6944":122899,"_42621":122868,"_30085":199931,"_5":21646,"_28538":199826,"_5847":199932},[],"`:groupID` es un grupo de dispositivos de Lamassu. `:name` es el nombre de un pack. `:moduleKey` es `type:name` (por ejemplo `os:water-panel`), literal o codificado en porcentaje. En las rutas un pack es un recurso `distribution-sets` (consulta Conceptos).",{"_6944":122900,"_42621":122868,"_30085":199934,"_5":21646,"_28538":199826,"_5847":199935},[],"Tema",{"_6944":122901,"_42621":122868,"_30085":199937,"_5":21646,"_28538":199826,"_5847":199457},[],{"_6944":122902,"_42621":122868,"_30085":199939,"_5":21646,"_28538":199826,"_5847":199940},[],"Cuerpos",{"_6944":122903,"_42621":122868,"_30085":199942,"_5":21646,"_28538":199826,"_5847":199943},[],"JSON, salvo las subidas, que son `multipart/form-data` con el archivo en el campo `file`",{"_6944":122904,"_42621":122868,"_30085":199945,"_5":21646,"_28538":199826,"_5847":199946},[],"Errores",{"_6944":122905,"_42621":122868,"_30085":199948,"_5":21646,"_28538":199826,"_5847":199949},[],"El cuerpo es `{\"err\":\"<mensaje>\"}`",{"_6944":122906,"_42621":122868,"_30085":199951,"_5":21646,"_28538":199826,"_5847":90538},[],{"_6944":122907,"_42621":122868,"_30085":199953,"_5":21646,"_28538":199826,"_5847":199954},[],"`GET /health` devuelve `{\"status\":\"ok\"}`, fuera de `/updates/v1`",{"_6944":122908,"_42621":122868,"_30085":199956,"_5":21646,"_28538":199826,"_5847":199957},[],"Autenticación",{"_6944":122909,"_42621":122868,"_30085":199959,"_5":21646,"_28538":199826,"_5847":199960},[],"Ninguna en el servicio: no autentica a quien llama. En un despliegue de Lamassu lo hace el gateway que tiene delante. Consulta Seguridad",{"_6944":122910,"_42621":122868,"_30085":199962,"_5":21646,"_28538":199826,"_5847":199963},[],"Límite de subida",{"_6944":122911,"_42621":122868,"_30085":199965,"_5":21646,"_28538":199826,"_5847":199966},[],"Un archivo puede tener hasta `max_artifact_size_mb` MiB, 10240 (10 GiB) por defecto. Uno mayor responde `413`",{"_6944":122912,"_42621":122868,"_30085":199968,"_5":21646,"_28538":199826,"_5847":90556},[],{"_6944":122913,"_42621":122868,"_30085":199970,"_5":21646,"_28538":199826,"_5847":199971},[],"Una petición puede leer o escribir hasta 6 horas; una conexión inactiva se cierra a los 5 minutos. Las subidas se escriben en disco en streaming, no se mantienen en memoria",{"_6944":122914,"_42621":122868,"_30085":199973,"_5":21646,"_28538":199826,"_5847":90562},[],{"_6944":122915,"_42621":122868,"_30085":199975,"_5":21646,"_28538":199826,"_5847":199976},[],"Se permite cualquier origen y cualquier cabecera de petición",{"_6944":122916,"_42621":122868,"_30085":199978,"_5":21646,"_28538":199826,"_5847":199979},[],"El ingress o el gateway que tiene delante el servicio necesita sus propios límites elevados en consonancia: consulta Configuración.",{"_6944":122917,"_42621":122868,"_30085":199981,"_5":21646,"_28538":199830,"_5847":199982},[],"Código",{"_6944":122918,"_42621":122868,"_30085":199984,"_5":21646,"_28538":199830,"_5847":195948},[],{"_6944":122919,"_42621":122868,"_30085":199986,"_5":21646,"_28538":199830,"_5847":90576},[],{"_6944":122920,"_42621":122868,"_30085":199988,"_5":21646,"_28538":199830,"_5847":199989},[],"Correcto",{"_6944":122921,"_42621":122868,"_30085":199991,"_5":21646,"_28538":199830,"_5847":90582},[],{"_6944":122922,"_42621":122868,"_30085":199993,"_5":21646,"_28538":199830,"_5847":199994},[],"Creado: packs, módulos, lanzamientos, subidas de artefactos independientes",{"_6944":122923,"_42621":122868,"_30085":199996,"_5":21646,"_28538":199830,"_5847":90588},[],{"_6944":122924,"_42621":122868,"_30085":199998,"_5":21646,"_28538":199830,"_5847":199999},[],"Aceptado: `sync-to-latest` y `force-version`",{"_6944":122925,"_42621":122868,"_30085":200001,"_5":21646,"_28538":199830,"_5847":90594},[],{"_6944":122926,"_42621":122868,"_30085":200003,"_5":21646,"_28538":199830,"_5847":200004},[],"Eliminado, sin cuerpo: artefactos, archivos preparados, registros de última versión, archivos de módulo",{"_6944":122927,"_42621":122868,"_30085":200006,"_5":21646,"_28538":199830,"_5847":90600},[],{"_6944":122928,"_42621":122868,"_30085":200008,"_5":21646,"_28538":199830,"_5847":200009},[],"Contenido parcial, o rango no satisfacible, en las descargas",{"_6944":122929,"_42621":122868,"_30085":200011,"_5":21646,"_28538":199830,"_5847":90606},[],{"_6944":122930,"_42621":122868,"_30085":200013,"_5":21646,"_28538":199830,"_5847":200014},[],"`sync-to-latest` despachó algunos dispositivos y falló en otros",{"_6944":122931,"_42621":122868,"_30085":200016,"_5":21646,"_28538":199830,"_5847":90612},[],{"_6944":122932,"_42621":122868,"_30085":200018,"_5":21646,"_28538":199830,"_5847":200019},[],"Una descarga redirigida a una URL firmada de corta duración",{"_6944":122933,"_42621":122868,"_30085":200021,"_5":21646,"_28538":199830,"_5847":90618},[],{"_6944":122934,"_42621":122868,"_30085":200023,"_5":21646,"_28538":199830,"_5847":200024},[],"Entrada no válida, u operación no válida en el estado actual (por ejemplo, cambiar la composición de módulos de un pack ya compilado)",{"_6944":122935,"_42621":122868,"_30085":200026,"_5":21646,"_28538":199830,"_5847":90624},[],{"_6944":122936,"_42621":122868,"_30085":200028,"_5":21646,"_28538":199830,"_5847":200029},[],"Prohibido por política (por ejemplo, descargar una versión anterior que el pack no permite)",{"_6944":122937,"_42621":122868,"_30085":200031,"_5":21646,"_28538":199830,"_5847":90630},[],{"_6944":122938,"_42621":122868,"_30085":200033,"_5":21646,"_28538":199830,"_5847":200034},[],"El recurso no existe",{"_6944":122939,"_42621":122868,"_30085":200036,"_5":21646,"_28538":199830,"_5847":90636},[],{"_6944":122940,"_42621":122868,"_30085":200038,"_5":21646,"_28538":199830,"_5847":200039},[],"Conflicto: la versión del pack ya está compilada (subida o enlace de artefacto, subida de un entregable precompilado), el nombre del pack ya existe, u otra petición está trabajando sobre el mismo recurso",{"_6944":122941,"_42621":122868,"_30085":200041,"_5":21646,"_28538":199830,"_5847":90642},[],{"_6944":122942,"_42621":122868,"_30085":200043,"_5":21646,"_28538":199830,"_5847":200044},[],"Un archivo subido supera el límite de tamaño",{"_6944":122943,"_42621":122868,"_30085":200046,"_5":21646,"_28538":199830,"_5847":90648},[],{"_6944":122944,"_42621":122868,"_30085":200048,"_5":21646,"_28538":199830,"_5847":200049},[],"El backend activo no admite la operación. Consulta Capabilities",{"_6944":122945,"_42621":122868,"_30085":200051,"_5":21646,"_28538":199834,"_5847":200052},[],"Las rutas de descarga transmiten el archivo y permiten reanudar:",{"_6944":122946,"_42621":122868,"_30085":200054,"_5":21646,"_28538":199834,"_5847":200055},[],"`HEAD` funciona en todas las rutas de descarga y devuelve el tamaño y `Accept-Ranges: bytes`.",{"_6944":122947,"_42621":122868,"_30085":200057,"_5":21646,"_28538":199834,"_5847":200058},[],"`Range: bytes=...` con un único rango responde `206` con `Content-Range`. Un rango que no se puede satisfacer responde `416`. Una petición con varios rangos recibe el archivo completo.",{"_6944":122948,"_42621":122868,"_30085":200060,"_5":21646,"_28538":199834,"_5847":200061},[],"Con almacenamiento S3 y la firma previa (presign) activada, un `GET` puede responder `302` a una URL firmada del almacén de objetos, con `Cache-Control: no-store`. Primero se autoriza al que llama; el almacén solo comprueba después la firma. Un `HEAD` nunca se redirige. El modo native firma las salidas de compilación (`.swu` y paquetes); el modo hawkBit firma los objetos del plugin S3 de artefactos de hawkBit. Si falla la firma, el servicio transmite el archivo directamente.",{"_6944":122949,"_42621":122868,"_30085":200063,"_5":21646,"_28538":199834,"_5847":200064},[],"`Content-Disposition: attachment` lleva el nombre del archivo.",{"_6944":122950,"_42621":122868,"_30085":200066,"_5":21646,"_28538":199838,"_5847":200067},[],"Las rutas que devuelven colecciones comparten estos parámetros de consulta:",{"_6944":122951,"_42621":122868,"_30085":200069,"_5":21646,"_28538":199838,"_5847":191811},[],{"_6944":122952,"_42621":122868,"_30085":200071,"_5":21646,"_28538":199838,"_5847":195948},[],{"_6944":122953,"_42621":122868,"_30085":200073,"_5":21646,"_28538":199838,"_5847":90676},[],{"_6944":122954,"_42621":122868,"_30085":200075,"_5":21646,"_28538":199838,"_5847":200076},[],"Elementos por página. Por defecto `25`, como máximo `500`",{"_6944":122955,"_42621":122868,"_30085":200078,"_5":21646,"_28538":199838,"_5847":90682},[],{"_6944":122956,"_42621":122868,"_30085":200080,"_5":21646,"_28538":199838,"_5847":200081},[],"Cursor opaco de la página anterior",{"_6944":122957,"_42621":122868,"_30085":200083,"_5":21646,"_28538":199838,"_5847":90688},[],{"_6944":122958,"_42621":122868,"_30085":200085,"_5":21646,"_28538":199838,"_5847":200086},[],"Un campo filtrable, y `asc` (por defecto) o `desc`. Un `sort_by` que no sea un campo filtrable se ignora",{"_6944":122959,"_42621":122868,"_30085":200088,"_5":21646,"_28538":199838,"_5847":90694},[],{"_6944":122960,"_42621":122868,"_30085":200090,"_5":21646,"_28538":199838,"_5847":200091},[],"`field[operand]value`, repetible",{"_6944":122961,"_42621":122868,"_30085":200093,"_5":21646,"_28538":199838,"_5847":200094},[],"Los operandos del filtro dependen del tipo de campo:",{"_6944":122962,"_42621":122868,"_30085":200096,"_5":21646,"_28538":199838,"_5847":200097},[],"Tipo de campo",{"_6944":122963,"_42621":122868,"_30085":200099,"_5":21646,"_28538":199838,"_5847":200100},[],"Operandos",{"_6944":122964,"_42621":122868,"_30085":200102,"_5":21646,"_28538":199838,"_5847":90709},[],{"_6944":122965,"_42621":122868,"_30085":200104,"_5":21646,"_28538":199838,"_5847":200105},[],"`eq`, `ne`, `ct` (contiene), `nc` (no contiene), cada uno con una variante `_ic` que no distingue mayúsculas",{"_6944":122966,"_42621":122868,"_30085":200107,"_5":21646,"_28538":199838,"_5847":200108},[],"Fecha",{"_6944":122967,"_42621":122868,"_30085":200110,"_5":21646,"_28538":199838,"_5847":200111},[],"`bf` (antes), `eq`, `af` (después)",{"_6944":122968,"_42621":122868,"_30085":200113,"_5":21646,"_28538":199838,"_5847":200114},[],"Número",{"_6944":122969,"_42621":122868,"_30085":200116,"_5":21646,"_28538":199838,"_5847":90724},[],{"_6944":122970,"_42621":122868,"_30085":200118,"_5":21646,"_28538":199838,"_5847":90727},[],{"_6944":122971,"_42621":122868,"_30085":200120,"_5":21646,"_28538":199838,"_5847":90730},[],{"_6944":122972,"_42621":122868,"_30085":200122,"_5":21646,"_28538":199838,"_5847":200123},[],"Por ejemplo `GET /groups/g1/distribution-sets?filter=name[ct]firmware&sort_by=name&sort_mode=desc`.",{"_6944":122973,"_42621":122868,"_30085":200125,"_5":21646,"_28538":199838,"_5847":200126},[],"Los listados paginados devuelven `{\"next\": \"<bookmark>\", \"list\": [...]}`. Pasa `next` como `bookmark` para obtener la página siguiente; `next` está vacío en la última. Campos filtrables por listado:",{"_6944":122974,"_42621":122868,"_30085":200128,"_5":21646,"_28538":199838,"_5847":200129},[],"Listado",{"_6944":122975,"_42621":122868,"_30085":200131,"_5":21646,"_28538":199838,"_5847":200132},[],"Campos filtrables",{"_6944":122976,"_42621":122868,"_30085":200134,"_5":21646,"_28538":199838,"_5847":90745},[],{"_6944":122977,"_42621":122868,"_30085":200136,"_5":21646,"_28538":199838,"_5847":90748},[],{"_6944":122978,"_42621":122868,"_30085":200138,"_5":21646,"_28538":199838,"_5847":200139},[],"Lanzamientos: `/groups/:groupID/launch`",{"_6944":122979,"_42621":122868,"_30085":200141,"_5":21646,"_28538":199838,"_5847":90754},[],{"_6944":122980,"_42621":122868,"_30085":200143,"_5":21646,"_28538":199838,"_5847":200144},[],"Instantáneas de versión: `.../versions`, `/distribution-sets/:id/versions`",{"_6944":122981,"_42621":122868,"_30085":200146,"_5":21646,"_28538":199838,"_5847":200147},[],"`version` (número), `created_at`",{"_6944":122982,"_42621":122868,"_30085":200149,"_5":21646,"_28538":199838,"_5847":200150},[],"Catálogo de artefactos de la flota: `GET /artifacts`",{"_6944":122983,"_42621":122868,"_30085":200152,"_5":21646,"_28538":199838,"_5847":90766},[],{"_6944":122984,"_42621":122868,"_30085":200154,"_5":21646,"_28538":199838,"_5847":200155},[],"Versiones de pack e inventario de dispositivos: `/devices/distribution-sets`, `/devices/:deviceID/distribution-sets`, `.../distribution-set-inventory`",{"_6944":122985,"_42621":122868,"_30085":200157,"_5":21646,"_28538":199838,"_5847":200158},[],"`device_id`, `distribution_set_id`, `distribution_set_name`, `group_id`, `version` (número), `packaging` (enum), `installed_at`",{"_6944":122986,"_42621":122868,"_30085":200160,"_5":21646,"_28538":199838,"_5847":200161},[],"Historial de actualizaciones de dispositivo: `/devices/:deviceID/distribution-set-updates`, `/devices/distribution-set-updates/latest`",{"_6944":122987,"_42621":122868,"_30085":200163,"_5":21646,"_28538":199838,"_5847":90778},[],{"_6944":122988,"_42621":122868,"_30085":200165,"_5":21646,"_28538":199838,"_5847":200166},[],"Últimas versiones: `.../latest-distribution-sets`",{"_6944":122989,"_42621":122868,"_30085":200168,"_5":21646,"_28538":199838,"_5847":90784},[],{"_6944":122990,"_42621":122868,"_30085":200170,"_5":21646,"_28538":199838,"_5847":200171},[],"Algunos listados no paginan ni filtran:",{"_6944":122991,"_42621":122868,"_30085":200173,"_5":21646,"_28538":199838,"_5847":200174},[],"Los listados de jobs (`/groups/:groupID/device/:deviceID/jobs`, `.../history`, `/launch/:launchID/jobs`) solo respetan `page_size` y `bookmark`. El bookmark es un desplazamiento numérico.",{"_6944":122992,"_42621":122868,"_30085":200176,"_5":21646,"_28538":199838,"_5847":200177},[],"Los listados de módulos, `/updatable-distribution-sets`, el `.../artifact-catalog` de un pack, `/version-compliance`, `/version-status` y `/workflows` devuelven todo.",{"_6944":122993,"_42621":122868,"_30085":200179,"_5":21646,"_28538":199838,"_5847":200180},[],"`GET /devices/distribution-set-updates/latest` devuelve todo, tras aplicar los filtros.",{"_6944":122994,"_42621":122868,"_30085":200182,"_5":21646,"_28538":199838,"_5847":200183},[],"En modo hawkBit ningún listado pagina (`next` siempre está vacío). Solo `/devices/distribution-sets` y `/devices/distribution-set-updates/latest`, de ámbito flota, aplican `filter`.",{"_6944":122995,"_42621":122868,"_30085":200185,"_5":21646,"_28538":199838,"_5847":200186},[],"Algunas rutas existen en un solo backend o se comportan de forma distinta. Consulta antes Capabilities.",{"_6944":122996,"_42621":122868,"_30085":200188,"_5":21646,"_28538":199842,"_5847":190927},[],{"_6944":122997,"_42621":122868,"_30085":200190,"_5":21646,"_28538":199842,"_5847":197196},[],{"_6944":122998,"_42621":122868,"_30085":200192,"_5":21646,"_28538":199842,"_5847":191820},[],{"_6944":122999,"_42621":122868,"_30085":200194,"_5":21646,"_28538":199842,"_5847":84803},[],{"_6944":123000,"_42621":122868,"_30085":200196,"_5":21646,"_28538":199842,"_5847":90813},[],{"_6944":123001,"_42621":122868,"_30085":200198,"_5":21646,"_28538":199842,"_5847":200199},[],"Backend activo y lo que admite. Consulta Capabilities",{"_6944":123002,"_42621":122868,"_30085":200201,"_5":21646,"_28538":199842,"_5847":84803},[],{"_6944":123003,"_42621":122868,"_30085":200203,"_5":21646,"_28538":199842,"_5847":90821},[],{"_6944":123004,"_42621":122868,"_30085":200205,"_5":21646,"_28538":199842,"_5847":200206},[],"Workflows registrados en WFX, como `{\"content\": [...]}`. Vacío en modo hawkBit",{"_6944":123005,"_42621":122868,"_30085":200208,"_5":21646,"_28538":199846,"_5847":190927},[],{"_6944":123006,"_42621":122868,"_30085":200210,"_5":21646,"_28538":199846,"_5847":197196},[],{"_6944":123007,"_42621":122868,"_30085":200212,"_5":21646,"_28538":199846,"_5847":191820},[],{"_6944":123008,"_42621":122868,"_30085":200214,"_5":21646,"_28538":199846,"_5847":85374},[],{"_6944":123009,"_42621":122868,"_30085":200216,"_5":21646,"_28538":199846,"_5847":90835},[],{"_6944":123010,"_42621":122868,"_30085":200218,"_5":21646,"_28538":199846,"_5847":200219},[],"Crea un pack",{"_6944":123011,"_42621":122868,"_30085":200221,"_5":21646,"_28538":199846,"_5847":84803},[],{"_6944":123012,"_42621":122868,"_30085":200223,"_5":21646,"_28538":199846,"_5847":90835},[],{"_6944":123013,"_42621":122868,"_30085":200225,"_5":21646,"_28538":199846,"_5847":200226},[],"Lista los packs de un grupo",{"_6944":123014,"_42621":122868,"_30085":200228,"_5":21646,"_28538":199846,"_5847":84803},[],{"_6944":123015,"_42621":122868,"_30085":200230,"_5":21646,"_28538":199846,"_5847":90850},[],{"_6944":123016,"_42621":122868,"_30085":200232,"_5":21646,"_28538":199846,"_5847":200233},[],"Los packs compilados del grupo, que se pueden lanzar",{"_6944":123017,"_42621":122868,"_30085":200235,"_5":21646,"_28538":199846,"_5847":90856},[],{"_6944":123018,"_42621":122868,"_30085":200237,"_5":21646,"_28538":199846,"_5847":90859},[],{"_6944":123019,"_42621":122868,"_30085":200239,"_5":21646,"_28538":199846,"_5847":200240},[],"Elimina un pack. Se rechaza con `400` una vez que un lanzamiento lo ha despachado (native), o mientras una campaña lo retiene (hawkBit)",{"_6944":123020,"_42621":122868,"_30085":200242,"_5":21646,"_28538":199846,"_5847":85374},[],{"_6944":123021,"_42621":122868,"_30085":200244,"_5":21646,"_28538":199846,"_5847":90867},[],{"_6944":123022,"_42621":122868,"_30085":200246,"_5":21646,"_28538":199846,"_5847":200247},[],"Crea una nueva versión de un pack",{"_6944":123023,"_42621":122868,"_30085":200249,"_5":21646,"_28538":199846,"_5847":84803},[],{"_6944":123024,"_42621":122868,"_30085":200251,"_5":21646,"_28538":199846,"_5847":90875},[],{"_6944":123025,"_42621":122868,"_30085":200253,"_5":21646,"_28538":199846,"_5847":200254},[],"Todos los packs de todos los grupos, incluidos los huérfanos",{"_6944":123026,"_42621":122868,"_30085":200256,"_5":21646,"_28538":199846,"_5847":84803},[],{"_6944":123027,"_42621":122868,"_30085":200258,"_5":21646,"_28538":199846,"_5847":90883},[],{"_6944":123028,"_42621":122868,"_30085":200260,"_5":21646,"_28538":199846,"_5847":200261},[],"Instantáneas de versión, por ID único",{"_6944":123029,"_42621":122868,"_30085":200263,"_5":21646,"_28538":199846,"_5847":90856},[],{"_6944":123030,"_42621":122868,"_30085":200265,"_5":21646,"_28538":199846,"_5847":90891},[],{"_6944":123031,"_42621":122868,"_30085":200267,"_5":21646,"_28538":199846,"_5847":200268},[],"Elimina un pack por ID único. Es la única forma de eliminar un pack huérfano",{"_6944":123032,"_42621":122868,"_30085":200270,"_5":21646,"_28538":199850,"_5847":190927},[],{"_6944":123033,"_42621":122868,"_30085":200272,"_5":21646,"_28538":199850,"_5847":200273},[],"Ruta (tras `/groups/:groupID/distribution-sets/:name`)",{"_6944":123034,"_42621":122868,"_30085":200275,"_5":21646,"_28538":199850,"_5847":191820},[],{"_6944":123035,"_42621":122868,"_30085":200277,"_5":21646,"_28538":199850,"_5847":85374},[],{"_6944":123036,"_42621":122868,"_30085":200279,"_5":21646,"_28538":199850,"_5847":90906},[],{"_6944":123037,"_42621":122868,"_30085":200281,"_5":21646,"_28538":199850,"_5847":200282},[],"Sube el sw-description (campo de archivo `file`, hasta 1 MiB en modo native). Modo hawkBit: `400`, usa la ruta del catálogo",{"_6944":123038,"_42621":122868,"_30085":200284,"_5":21646,"_28538":199850,"_5847":84803},[],{"_6944":123039,"_42621":122868,"_30085":200286,"_5":21646,"_28538":199850,"_5847":90914},[],{"_6944":123040,"_42621":122868,"_30085":200288,"_5":21646,"_28538":199850,"_5847":200289},[],"Lo lee, como `text/plain`",{"_6944":123041,"_42621":122868,"_30085":200291,"_5":21646,"_28538":199850,"_5847":85374},[],{"_6944":123042,"_42621":122868,"_30085":200293,"_5":21646,"_28538":199850,"_5847":90922},[],{"_6944":123043,"_42621":122868,"_30085":200295,"_5":21646,"_28538":199850,"_5847":200296},[],"Sube un artefacto global y lo enlaza al pack (campos `file`, `artifact_name`, `version`). `409` si el pack ya está compilado, lo cual ocurre siempre en modo hawkBit",{"_6944":123044,"_42621":122868,"_30085":200298,"_5":21646,"_28538":199850,"_5847":85374},[],{"_6944":123045,"_42621":122868,"_30085":200300,"_5":21646,"_28538":199850,"_5847":90930},[],{"_6944":123046,"_42621":122868,"_30085":200302,"_5":21646,"_28538":199850,"_5847":200303},[],"Enlaza un artefacto global ya subido (cuerpo `{\"artifact_id\":\"...\"}`). `409` si el pack está compilado",{"_6944":123047,"_42621":122868,"_30085":200305,"_5":21646,"_28538":199850,"_5847":90856},[],{"_6944":123048,"_42621":122868,"_30085":200307,"_5":21646,"_28538":199850,"_5847":200308},[],"`/artifact?artifact=<nombre de archivo>`",{"_6944":123049,"_42621":122868,"_30085":200310,"_5":21646,"_28538":199850,"_5847":200311},[],"Elimina un archivo preparado del directorio de compilación. No desenlaza un artefacto del catálogo. Responde `204`. Modo hawkBit: `400`",{"_6944":123050,"_42621":122868,"_30085":200313,"_5":21646,"_28538":199850,"_5847":84803},[],{"_6944":123051,"_42621":122868,"_30085":200315,"_5":21646,"_28538":199850,"_5847":90946},[],{"_6944":123052,"_42621":122868,"_30085":200317,"_5":21646,"_28538":199850,"_5847":200318},[],"Nombres de los archivos preparados en el directorio de compilación, como array simple",{"_6944":123053,"_42621":122868,"_30085":200320,"_5":21646,"_28538":199850,"_5847":84803},[],{"_6944":123054,"_42621":122868,"_30085":200322,"_5":21646,"_28538":199850,"_5847":90954},[],{"_6944":123055,"_42621":122868,"_30085":200324,"_5":21646,"_28538":199850,"_5847":200325},[],"Descarga un archivo preparado por nombre",{"_6944":123056,"_42621":122868,"_30085":200327,"_5":21646,"_28538":199850,"_5847":84803},[],{"_6944":123057,"_42621":122868,"_30085":200329,"_5":21646,"_28538":199850,"_5847":90962},[],{"_6944":123058,"_42621":122868,"_30085":200331,"_5":21646,"_28538":199850,"_5847":200332},[],"Artefactos a los que hace referencia el pack",{"_6944":123059,"_42621":122868,"_30085":200334,"_5":21646,"_28538":199850,"_5847":84803},[],{"_6944":123060,"_42621":122868,"_30085":200336,"_5":21646,"_28538":199850,"_5847":90970},[],{"_6944":123061,"_42621":122868,"_30085":200338,"_5":21646,"_28538":199850,"_5847":200339},[],"Lee las precondiciones de lanzamiento del pack. Responde con el pack completo, con `preconditions`",{"_6944":123062,"_42621":122868,"_30085":200341,"_5":21646,"_28538":199850,"_5847":84812},[],{"_6944":123063,"_42621":122868,"_30085":200343,"_5":21646,"_28538":199850,"_5847":90970},[],{"_6944":123064,"_42621":122868,"_30085":200345,"_5":21646,"_28538":199850,"_5847":200346},[],"Sustituye las precondiciones de lanzamiento del pack. Una lista vacía las borra. Responde con el pack",{"_6944":123065,"_42621":122868,"_30085":200348,"_5":21646,"_28538":199854,"_5847":190927},[],{"_6944":123066,"_42621":122868,"_30085":200350,"_5":21646,"_28538":199854,"_5847":200273},[],{"_6944":123067,"_42621":122868,"_30085":200352,"_5":21646,"_28538":199854,"_5847":191820},[],{"_6944":123068,"_42621":122868,"_30085":200354,"_5":21646,"_28538":199854,"_5847":85374},[],{"_6944":123069,"_42621":122868,"_30085":200356,"_5":21646,"_28538":199854,"_5847":90991},[],{"_6944":123070,"_42621":122868,"_30085":200358,"_5":21646,"_28538":199854,"_5847":200359},[],"Compila el `.swu` (cuerpo: consulta Cuerpos de las peticiones). Modo hawkBit: `501`, compila los módulos",{"_6944":123071,"_42621":122868,"_30085":200361,"_5":21646,"_28538":199854,"_5847":85374},[],{"_6944":123072,"_42621":122868,"_30085":200363,"_5":21646,"_28538":199854,"_5847":90999},[],{"_6944":123073,"_42621":122868,"_30085":200365,"_5":21646,"_28538":199854,"_5847":200366},[],"Compila el `.tar.gz` de un pack `non-swu`. Modo hawkBit: `501`",{"_6944":123074,"_42621":122868,"_30085":200368,"_5":21646,"_28538":199854,"_5847":85374},[],{"_6944":123075,"_42621":122868,"_30085":200370,"_5":21646,"_28538":199854,"_5847":91007},[],{"_6944":123076,"_42621":122868,"_30085":200372,"_5":21646,"_28538":199854,"_5847":200373},[],"Adjunta un entregable compilado externamente (campo de archivo `file`, `user` opcional). Ambas rutas son una sola operación: el empaquetado del pack decide qué archivo se espera. Solo native (`501` en modo hawkBit)",{"_6944":123077,"_42621":122868,"_30085":200375,"_5":21646,"_28538":199854,"_5847":84803},[],{"_6944":123078,"_42621":122868,"_30085":200377,"_5":21646,"_28538":199854,"_5847":91015},[],{"_6944":123079,"_42621":122868,"_30085":200379,"_5":21646,"_28538":199854,"_5847":200380},[],"Descarga el `.swu` compartido actual. Modo hawkBit: `400` para un pack con varios módulos, así que usa `/modules/:moduleKey/artifact/download`",{"_6944":123080,"_42621":122868,"_30085":200382,"_5":21646,"_28538":199854,"_5847":84803},[],{"_6944":123081,"_42621":122868,"_30085":200384,"_5":21646,"_28538":199854,"_5847":91023},[],{"_6944":123082,"_42621":122868,"_30085":200386,"_5":21646,"_28538":199854,"_5847":200387},[],"Descarga el `.swu` de un dispositivo. En un pack con cifrado por dispositivo es el archivo propio de ese dispositivo; en otro caso, el compartido",{"_6944":123083,"_42621":122868,"_30085":200389,"_5":21646,"_28538":199854,"_5847":84803},[],{"_6944":123084,"_42621":122868,"_30085":200391,"_5":21646,"_28538":199854,"_5847":91031},[],{"_6944":123085,"_42621":122868,"_30085":200393,"_5":21646,"_28538":199854,"_5847":200394},[],"Descarga una versión anterior. Modo native: `403` salvo que el pack tenga `allow_previous_version_download`, y `404` si no hay instantánea registrada. El modo hawkBit sirve cualquier versión",{"_6944":123086,"_42621":122868,"_30085":200396,"_5":21646,"_28538":199854,"_5847":84803},[],{"_6944":123087,"_42621":122868,"_30085":200398,"_5":21646,"_28538":199854,"_5847":91039},[],{"_6944":123088,"_42621":122868,"_30085":200400,"_5":21646,"_28538":199854,"_5847":200401},[],"Lo mismo, para packs `non-swu` (`application/gzip`)",{"_6944":123089,"_42621":122868,"_30085":200403,"_5":21646,"_28538":199854,"_5847":84803},[],{"_6944":123090,"_42621":122868,"_30085":200405,"_5":21646,"_28538":199854,"_5847":91047},[],{"_6944":123091,"_42621":122868,"_30085":200407,"_5":21646,"_28538":199854,"_5847":200408},[],"`.tar.gz` con los artefactos de la versión actual",{"_6944":123092,"_42621":122868,"_30085":200410,"_5":21646,"_28538":199854,"_5847":84803},[],{"_6944":123093,"_42621":122868,"_30085":200412,"_5":21646,"_28538":199854,"_5847":91055},[],{"_6944":123094,"_42621":122868,"_30085":200414,"_5":21646,"_28538":199854,"_5847":200415},[],"Manifiesto firmado de la versión actual",{"_6944":123095,"_42621":122868,"_30085":200417,"_5":21646,"_28538":199858,"_5847":190927},[],{"_6944":123096,"_42621":122868,"_30085":200419,"_5":21646,"_28538":199858,"_5847":200273},[],{"_6944":123097,"_42621":122868,"_30085":200421,"_5":21646,"_28538":199858,"_5847":191820},[],{"_6944":123098,"_42621":122868,"_30085":200423,"_5":21646,"_28538":199858,"_5847":84803},[],{"_6944":123099,"_42621":122868,"_30085":200425,"_5":21646,"_28538":199858,"_5847":91069},[],{"_6944":123100,"_42621":122868,"_30085":200427,"_5":21646,"_28538":199858,"_5847":200428},[],"Instantáneas de versión almacenadas",{"_6944":123101,"_42621":122868,"_30085":200430,"_5":21646,"_28538":199858,"_5847":84803},[],{"_6944":123102,"_42621":122868,"_30085":200432,"_5":21646,"_28538":199858,"_5847":91077},[],{"_6944":123103,"_42621":122868,"_30085":200434,"_5":21646,"_28538":199858,"_5847":200435},[],"Una instantánea, con los metadatos del manifiesto",{"_6944":123104,"_42621":122868,"_30085":200437,"_5":21646,"_28538":199858,"_5847":84803},[],{"_6944":123105,"_42621":122868,"_30085":200439,"_5":21646,"_28538":199858,"_5847":91085},[],{"_6944":123106,"_42621":122868,"_30085":200441,"_5":21646,"_28538":199858,"_5847":200442},[],"Manifiesto firmado, firma y certificado",{"_6944":123107,"_42621":122868,"_30085":200444,"_5":21646,"_28538":199858,"_5847":84803},[],{"_6944":123108,"_42621":122868,"_30085":200446,"_5":21646,"_28538":199858,"_5847":91093},[],{"_6944":123109,"_42621":122868,"_30085":200448,"_5":21646,"_28538":199858,"_5847":200449},[],"Módulos de esa versión",{"_6944":123110,"_42621":122868,"_30085":200451,"_5":21646,"_28538":199858,"_5847":84803},[],{"_6944":123111,"_42621":122868,"_30085":200453,"_5":21646,"_28538":199858,"_5847":91101},[],{"_6944":123112,"_42621":122868,"_30085":200455,"_5":21646,"_28538":199858,"_5847":200456},[],"El entregable de un módulo en esa versión. Native: `501`",{"_6944":123113,"_42621":122868,"_30085":200458,"_5":21646,"_28538":199858,"_5847":84803},[],{"_6944":123114,"_42621":122868,"_30085":200460,"_5":21646,"_28538":199858,"_5847":91109},[],{"_6944":123115,"_42621":122868,"_30085":200462,"_5":21646,"_28538":199858,"_5847":200463},[],"`.tar.gz` con los artefactos de esa versión",{"_6944":123116,"_42621":122868,"_30085":200465,"_5":21646,"_28538":199862,"_5847":197196},[],{"_6944":123117,"_42621":122868,"_30085":200467,"_5":21646,"_28538":199862,"_5847":200468},[],"Cuerpo",{"_6944":123118,"_42621":122868,"_30085":200470,"_5":21646,"_28538":199862,"_5847":200471},[],"Crear pack",{"_6944":123119,"_42621":122868,"_30085":200473,"_5":21646,"_28538":199862,"_5847":200474},[],"Obligatorios: `name`, `version` (semver `x.y.z`), `group_id`. Opcionales: `type` (`rawfile` o `firmware`), `packaging` (`swu`, el valor por defecto, o `non-swu`), `allow_previous_version_download`, `modules`, `preconditions`. Cada entrada de `modules` es un módulo nuevo (`type`, `name`, y opcionalmente `version` y `delivery_intent`) o uno existente (`source_module_id`). El modo hawkBit solo acepta entradas `source_module_id`, de módulos **compilados**",{"_6944":123120,"_42621":122868,"_30085":200476,"_5":21646,"_28538":199862,"_5847":91126},[],{"_6944":123121,"_42621":122868,"_30085":200478,"_5":21646,"_28538":199862,"_5847":200479},[],"`{\"version\":\"x.y.z\"}`: semver y mayor que la versión actual, o `400`",{"_6944":123122,"_42621":122868,"_30085":200481,"_5":21646,"_28538":199862,"_5847":91132},[],{"_6944":123123,"_42621":122868,"_30085":200483,"_5":21646,"_28538":199862,"_5847":200484},[],"`{\"preconditions\":[{\"required_distribution_set_name\":\"...\",\"min_version\":\"1.2.0\"}]}`. Usa `required_module_key` (`type:name`) en lugar del nombre del pack para apuntar a un módulo. Exactamente uno de los dos por entrada, y `min_version` debe ser `x.y.z`. Un dispositivo debe cumplir todas las entradas",{"_6944":123124,"_42621":122868,"_30085":200486,"_5":21646,"_28538":199862,"_5847":91138},[],{"_6944":123125,"_42621":122868,"_30085":200488,"_5":21646,"_28538":199862,"_5847":200489},[],"`user`, `encryption_key_name`, `encryption_alg_name`, `sw_desc_encrypted`, `signature_key_id`, `signature_alg_name`, `signature_certificate` (PEM), `selected_artifact_ids`. Todos opcionales, pero `user` es obligatorio junto con `encryption_key_name`. Un cuerpo solo con `encryption_alg_name` solicita cifrado por dispositivo. Un cuerpo vacío o no válido compila sin cifrado. Consulta Firma y cifrado",{"_6944":123126,"_42621":122868,"_30085":200491,"_5":21646,"_28538":199862,"_5847":200492},[],"Los artefactos llegan a una compilación solo mediante `selected_artifact_ids`; sin ellos normalmente no hay nada preparado y la compilación falla. Una compilación sustituye los enlaces de artefactos heredados del pack por los seleccionados.",{"_6944":123127,"_42621":122868,"_30085":200494,"_5":21646,"_28538":199866,"_5847":200495},[],"Las rutas de creación responden `201` con el objeto: un pack, un módulo o, en un lanzamiento, el ID del lanzamiento y el resultado de las precondiciones. `modules` es una entrada de la creación del pack y no se devuelve en las lecturas.",{"_6944":123128,"_42621":122868,"_30085":200497,"_5":21646,"_28538":199866,"_5847":200498},[],"`DELETE` de un pack responde `200` con `{\"message\": \"...\"}`. `POST .../new`, `.../swu` y `.../package` responden `200` con `{\"message\": \"...\"}`.",{"_6944":123129,"_42621":122868,"_30085":200500,"_5":21646,"_28538":199866,"_5847":200501},[],"Las subidas de artefactos responden `{\"msg\": \"...\", \"artifact\": {...}}`: `201` para `POST /artifacts`, `200` para las subidas de ámbito pack y de ámbito módulo.",{"_6944":123130,"_42621":122868,"_30085":200503,"_5":21646,"_28538":199866,"_5847":200504},[],"Las subidas de descriptor sobre un pack o sobre un módulo de un pack responden `{\"msg\": \"...\"}`.",{"_6944":123131,"_42621":122868,"_30085":200506,"_5":21646,"_28538":199866,"_5847":200507},[],"Los listados de módulos responden `{\"modules\": [...]}`. El listado `.../artifacts` de un pack responde un array simple.",{"_6944":123132,"_42621":122868,"_30085":200509,"_5":21646,"_28538":199866,"_5847":200510},[],"Una compilación fallida deja el pack en estado `build_failed`, con el motivo en `last_build_error`. Sigue siendo editable y se puede volver a compilar.",{"_6944":123133,"_42621":122868,"_30085":200512,"_5":21646,"_28538":199870,"_5847":200513},[],"Las definiciones de los campos están en `pkg/models/updates.go` del repositorio. Estos son los campos que más leen los clientes.",{"_6944":123134,"_42621":122868,"_30085":200515,"_5":21646,"_28538":199874,"_5847":196084},[],{"_6944":123135,"_42621":122868,"_30085":200517,"_5":21646,"_28538":199874,"_5847":195948},[],{"_6944":123136,"_42621":122868,"_30085":200519,"_5":21646,"_28538":199874,"_5847":91172},[],{"_6944":123137,"_42621":122868,"_30085":200521,"_5":21646,"_28538":199874,"_5847":200522},[],"Identidad. La versión es semver",{"_6944":123138,"_42621":122868,"_30085":200524,"_5":21646,"_28538":199874,"_5847":87447},[],{"_6944":123139,"_42621":122868,"_30085":200526,"_5":21646,"_28538":199874,"_5847":200527},[],"`rawfile` o `firmware`",{"_6944":123140,"_42621":122868,"_30085":200529,"_5":21646,"_28538":199874,"_5847":88891},[],{"_6944":123141,"_42621":122868,"_30085":200531,"_5":21646,"_28538":199874,"_5847":200532},[],"`swu` o `non-swu`",{"_6944":123142,"_42621":122868,"_30085":200534,"_5":21646,"_28538":199874,"_5847":91188},[],{"_6944":123143,"_42621":122868,"_30085":200536,"_5":21646,"_28538":199874,"_5847":200537},[],"`draft`, `built` o `build_failed`",{"_6944":123144,"_42621":122868,"_30085":200539,"_5":21646,"_28538":199874,"_5847":91194},[],{"_6944":123145,"_42621":122868,"_30085":200541,"_5":21646,"_28538":199874,"_5847":200542},[],"URI de descarga del entregable compilado. Vacía hasta que se compila",{"_6944":123146,"_42621":122868,"_30085":200544,"_5":21646,"_28538":199874,"_5847":91200},[],{"_6944":123147,"_42621":122868,"_30085":200546,"_5":21646,"_28538":199874,"_5847":200547},[],"El texto del sw-description (la clave lleva guion)",{"_6944":123148,"_42621":122868,"_30085":200549,"_5":21646,"_28538":199874,"_5847":91206},[],{"_6944":123149,"_42621":122868,"_30085":200551,"_5":21646,"_28538":199874,"_5847":200552},[],"Vacío, `shared` o `per-device`",{"_6944":123150,"_42621":122868,"_30085":200554,"_5":21646,"_28538":199874,"_5847":91212},[],{"_6944":123151,"_42621":122868,"_30085":200556,"_5":21646,"_28538":199874,"_5847":200557},[],"Ajustes de cifrado de la última compilación",{"_6944":123152,"_42621":122868,"_30085":200559,"_5":21646,"_28538":199874,"_5847":91218},[],{"_6944":123153,"_42621":122868,"_30085":200561,"_5":21646,"_28538":199874,"_5847":200562},[],"Ajustes de firma de la última compilación",{"_6944":123154,"_42621":122868,"_30085":200564,"_5":21646,"_28538":199874,"_5847":91224},[],{"_6944":123155,"_42621":122868,"_30085":200566,"_5":21646,"_28538":199874,"_5847":200567},[],"Solo en compilaciones por dispositivo: cobertura, y los dispositivos sin paquete con su `reason`",{"_6944":123156,"_42621":122868,"_30085":200569,"_5":21646,"_28538":199874,"_5847":88897},[],{"_6944":123157,"_42621":122868,"_30085":200571,"_5":21646,"_28538":199874,"_5847":200572},[],"Si se pueden descargar versiones anteriores",{"_6944":123158,"_42621":122868,"_30085":200574,"_5":21646,"_28538":199874,"_5847":88903},[],{"_6944":123159,"_42621":122868,"_30085":200576,"_5":21646,"_28538":199874,"_5847":200577},[],"Las precondiciones de lanzamiento del pack",{"_6944":123160,"_42621":122868,"_30085":200579,"_5":21646,"_28538":199874,"_5847":91240},[],{"_6944":123161,"_42621":122868,"_30085":200581,"_5":21646,"_28538":199874,"_5847":200582},[],"Por qué falló la última compilación",{"_6944":123162,"_42621":122868,"_30085":200584,"_5":21646,"_28538":199874,"_5847":91246},[],{"_6944":123163,"_42621":122868,"_30085":200586,"_5":21646,"_28538":199874,"_5847":200587},[],"Modo hawkBit: el backend congeló la composición porque el pack se envió a dispositivos",{"_6944":123164,"_42621":122868,"_30085":200589,"_5":21646,"_28538":199874,"_5847":91252},[],{"_6944":123165,"_42621":122868,"_30085":200591,"_5":21646,"_28538":199874,"_5847":200592},[],"Marcas de tiempo",{"_6944":123166,"_42621":122868,"_30085":200594,"_5":21646,"_28538":199877,"_5847":200595},[],"Un lanzamiento lleva `id`, `group_id`, `name`, `description`, `version`, `exec_date`, `scheduled_at`, `status`, los campos de la estrategia (`workflow_type`, `rollout_type`, `rollout_value`, `test_device_id`, `auto`, `approval_threshold`, `error_threshold`, `weight`), `distribution_set_id`, `distribution_set_name`, los contadores `pending_count`, `active_count`, `completed_count`, `failed_count`, `total_devices`, `completed_in_batch`, `test_device_status`, `aborted`, `forced_preconditions` y `precondition_failures`.",{"_6944":123167,"_42621":122868,"_30085":200597,"_5":21646,"_28538":199877,"_5847":200598},[],"`status` es `running` (vacío en un lanzamiento native que aún no ha cambiado de estado, lo que también significa en ejecución), `paused`, `cancelled` o `completed`. `test_device_status` es `pending`, `active`, `completed`, `failed` o `cancelled`.",{"_6944":123168,"_42621":122868,"_30085":200600,"_5":21646,"_28538":199881,"_5847":196084},[],{"_6944":123169,"_42621":122868,"_30085":200602,"_5":21646,"_28538":199881,"_5847":195948},[],{"_6944":123170,"_42621":122868,"_30085":200604,"_5":21646,"_28538":199881,"_5847":91268},[],{"_6944":123171,"_42621":122868,"_30085":200606,"_5":21646,"_28538":199881,"_5847":200607},[],"ID del catálogo y clave `type:name`",{"_6944":123172,"_42621":122868,"_30085":200609,"_5":21646,"_28538":199881,"_5847":91274},[],{"_6944":123173,"_42621":122868,"_30085":200611,"_5":21646,"_28538":199881,"_5847":200612},[],"`type` es `os` o `application`",{"_6944":123174,"_42621":122868,"_30085":200614,"_5":21646,"_28538":199881,"_5847":89366},[],{"_6944":123175,"_42621":122868,"_30085":200616,"_5":21646,"_28538":199881,"_5847":200617},[],"`undecided`, `swu-build`, `swu-prebuilt` o `raw`",{"_6944":123176,"_42621":122868,"_30085":200619,"_5":21646,"_28538":199881,"_5847":91285},[],{"_6944":123177,"_42621":122868,"_30085":200621,"_5":21646,"_28538":199881,"_5847":200622},[],"Si existe su entregable, y si está congelado porque una versión suya ya se ha entregado",{"_6944":123178,"_42621":122868,"_30085":200624,"_5":21646,"_28538":199881,"_5847":91291},[],{"_6944":123179,"_42621":122868,"_30085":200626,"_5":21646,"_28538":199881,"_5847":200627},[],"Los archivos del módulo",{"_6944":123180,"_42621":122868,"_30085":200629,"_5":21646,"_28538":199881,"_5847":91297},[],{"_6944":123181,"_42621":122868,"_30085":200631,"_5":21646,"_28538":199881,"_5847":200632},[],"Cómo se compiló",{"_6944":123182,"_42621":122868,"_30085":200634,"_5":21646,"_28538":199881,"_5847":91303},[],{"_6944":123183,"_42621":122868,"_30085":200636,"_5":21646,"_28538":199881,"_5847":200637},[],"El registro de cambios del operador",{"_6944":123184,"_42621":122868,"_30085":200639,"_5":21646,"_28538":199881,"_5847":91309},[],{"_6944":123185,"_42621":122868,"_30085":200641,"_5":21646,"_28538":199881,"_5847":200642},[],"URI de descarga, marcas de tiempo",{"_6944":123186,"_42621":122868,"_30085":200644,"_5":21646,"_28538":199884,"_5847":200645},[],"`id`, `name`, `version`, `filename`, `checksum` (SHA-256 del archivo), `size` en bytes y `uploaded_at`. El listado de toda la flota añade `distribution_sets`: los packs que lo referencian, cada uno con `distribution_set_id`, `distribution_set_name`, `distribution_set_version` y `group_id`. Un archivo cuyo nombre termina en `.swu` o `.tar.gz` debe serlo realmente, o la subida responde `400`.",{"_6944":123187,"_42621":122868,"_30085":200647,"_5":21646,"_28538":199887,"_5847":190927},[],{"_6944":123188,"_42621":122868,"_30085":200649,"_5":21646,"_28538":199887,"_5847":200273},[],{"_6944":123189,"_42621":122868,"_30085":200651,"_5":21646,"_28538":199887,"_5847":191820},[],{"_6944":123190,"_42621":122868,"_30085":200653,"_5":21646,"_28538":199887,"_5847":84803},[],{"_6944":123191,"_42621":122868,"_30085":200655,"_5":21646,"_28538":199887,"_5847":91326},[],{"_6944":123192,"_42621":122868,"_30085":200657,"_5":21646,"_28538":199887,"_5847":200658},[],"Lista los módulos del pack",{"_6944":123193,"_42621":122868,"_30085":200660,"_5":21646,"_28538":199887,"_5847":85374},[],{"_6944":123194,"_42621":122868,"_30085":200662,"_5":21646,"_28538":199887,"_5847":91326},[],{"_6944":123195,"_42621":122868,"_30085":200664,"_5":21646,"_28538":199887,"_5847":200665},[],"Añade un módulo (cuerpo: `type`, `name`, y opcionalmente `version`, `delivery_intent`). Responde `201`. Modo hawkBit: `400`, crea el módulo en el catálogo",{"_6944":123196,"_42621":122868,"_30085":200667,"_5":21646,"_28538":199887,"_5847":84803},[],{"_6944":123197,"_42621":122868,"_30085":200669,"_5":21646,"_28538":199887,"_5847":91341},[],{"_6944":123198,"_42621":122868,"_30085":200671,"_5":21646,"_28538":199887,"_5847":200672},[],"Módulos de otros packs, ofrecidos para importar. Cada uno informa `shared` y su pack de origen",{"_6944":123199,"_42621":122868,"_30085":200674,"_5":21646,"_28538":199887,"_5847":85374},[],{"_6944":123200,"_42621":122868,"_30085":200676,"_5":21646,"_28538":199887,"_5847":91349},[],{"_6944":123201,"_42621":122868,"_30085":200678,"_5":21646,"_28538":199887,"_5847":200679},[],"Compone a partir de un módulo existente. Responde `201`",{"_6944":123202,"_42621":122868,"_30085":200681,"_5":21646,"_28538":199887,"_5847":84812},[],{"_6944":123203,"_42621":122868,"_30085":200683,"_5":21646,"_28538":199887,"_5847":91357},[],{"_6944":123204,"_42621":122868,"_30085":200685,"_5":21646,"_28538":199887,"_5847":200686},[],"Sustituye el módulo por otra versión de sí mismo (cuerpo `{\"source_module_id\":\"<id del catálogo>\"}`). Native: `501`",{"_6944":123205,"_42621":122868,"_30085":200688,"_5":21646,"_28538":199887,"_5847":90856},[],{"_6944":123206,"_42621":122868,"_30085":200690,"_5":21646,"_28538":199887,"_5847":91357},[],{"_6944":123207,"_42621":122868,"_30085":200692,"_5":21646,"_28538":199887,"_5847":200693},[],"Quita un módulo del pack",{"_6944":123208,"_42621":122868,"_30085":200695,"_5":21646,"_28538":199887,"_5847":84812},[],{"_6944":123209,"_42621":122868,"_30085":200697,"_5":21646,"_28538":199887,"_5847":91372},[],{"_6944":123210,"_42621":122868,"_30085":200699,"_5":21646,"_28538":199887,"_5847":200700},[],"Establece el registro de cambios del operador (cuerpo `{\"notes\":\"...\"}`; vacío lo borra). Permitido en versiones compiladas",{"_6944":123211,"_42621":122868,"_30085":200702,"_5":21646,"_28538":199887,"_5847":85374},[],{"_6944":123212,"_42621":122868,"_30085":200704,"_5":21646,"_28538":199887,"_5847":91380},[],{"_6944":123213,"_42621":122868,"_30085":200706,"_5":21646,"_28538":199887,"_5847":200707},[],"Sube un binario a un módulo (campos `file`, `artifact_name`, `version`). Modo hawkBit: se rechaza, un módulo enlazado está congelado",{"_6944":123214,"_42621":122868,"_30085":200709,"_5":21646,"_28538":199887,"_5847":85374},[],{"_6944":123215,"_42621":122868,"_30085":200711,"_5":21646,"_28538":199887,"_5847":91388},[],{"_6944":123216,"_42621":122868,"_30085":200713,"_5":21646,"_28538":199887,"_5847":200714},[],"Enlaza un artefacto global al módulo (cuerpo `{\"artifact_id\":\"...\"}`). Modo hawkBit: se rechaza",{"_6944":123217,"_42621":122868,"_30085":200716,"_5":21646,"_28538":199887,"_5847":85374},[],{"_6944":123218,"_42621":122868,"_30085":200718,"_5":21646,"_28538":199887,"_5847":91396},[],{"_6944":123219,"_42621":122868,"_30085":200720,"_5":21646,"_28538":199887,"_5847":200721},[],"El sw-description propio de un módulo. Native: `501`. Modo hawkBit: `400`, usa `POST /softwaremodules/by-id/:moduleID/descriptor`",{"_6944":123220,"_42621":122868,"_30085":200723,"_5":21646,"_28538":199887,"_5847":85374},[],{"_6944":123221,"_42621":122868,"_30085":200725,"_5":21646,"_28538":199887,"_5847":91404},[],{"_6944":123222,"_42621":122868,"_30085":200727,"_5":21646,"_28538":199887,"_5847":200728},[],"Compilación de un módulo desde el pack. Siempre se rechaza: `501` en modo native y `400` en modo hawkBit. Usa `POST /softwaremodules/by-id/:moduleID/build`",{"_6944":123223,"_42621":122868,"_30085":200730,"_5":21646,"_28538":199887,"_5847":84803},[],{"_6944":123224,"_42621":122868,"_30085":200732,"_5":21646,"_28538":199887,"_5847":91412},[],{"_6944":123225,"_42621":122868,"_30085":200734,"_5":21646,"_28538":199887,"_5847":200735},[],"Descarga el entregable de un módulo. Native: `501`",{"_6944":123226,"_42621":122868,"_30085":200737,"_5":21646,"_28538":199887,"_5847":200738},[],"Cuerpo de importación: `source_module_id`, o `source_distribution_set_name` y `module_key` (con `source_group_id` y `source_distribution_set_version` opcionales). La intención de entrega de un módulo debe estar decidida y ser compatible con el empaquetado del pack antes de poder importarlo.",{"_6944":123227,"_42621":122868,"_30085":200740,"_5":21646,"_28538":199891,"_5847":200741},[],"Módulos que existen con independencia de cualquier pack. Crea uno con `POST /softwaremodules`, indicando `type`, `name`, `version` y, opcionalmente, `delivery_intent` (por defecto `undecided`). Usa el `id` devuelto en las rutas `by-id`.",{"_6944":123228,"_42621":122868,"_30085":200743,"_5":21646,"_28538":199891,"_5847":190927},[],{"_6944":123229,"_42621":122868,"_30085":200745,"_5":21646,"_28538":199891,"_5847":197196},[],{"_6944":123230,"_42621":122868,"_30085":200747,"_5":21646,"_28538":199891,"_5847":191820},[],{"_6944":123231,"_42621":122868,"_30085":200749,"_5":21646,"_28538":199891,"_5847":84803},[],{"_6944":123232,"_42621":122868,"_30085":200751,"_5":21646,"_28538":199891,"_5847":91432},[],{"_6944":123233,"_42621":122868,"_30085":200753,"_5":21646,"_28538":199891,"_5847":200754},[],"Catálogo de toda la flota, con el pack de origen",{"_6944":123234,"_42621":122868,"_30085":200756,"_5":21646,"_28538":199891,"_5847":85374},[],{"_6944":123235,"_42621":122868,"_30085":200758,"_5":21646,"_28538":199891,"_5847":91432},[],{"_6944":123236,"_42621":122868,"_30085":200760,"_5":21646,"_28538":199891,"_5847":200761},[],"Declara un módulo sin pack todavía. Responde `201`. `type`, `name` y `version` son obligatorios",{"_6944":123237,"_42621":122868,"_30085":200763,"_5":21646,"_28538":199891,"_5847":90856},[],{"_6944":123238,"_42621":122868,"_30085":200765,"_5":21646,"_28538":199891,"_5847":91447},[],{"_6944":123239,"_42621":122868,"_30085":200767,"_5":21646,"_28538":199891,"_5847":200768},[],"Elimina un módulo que ningún pack retiene. `400` si algún pack todavía lo retiene",{"_6944":123240,"_42621":122868,"_30085":200770,"_5":21646,"_28538":199891,"_5847":84803},[],{"_6944":123241,"_42621":122868,"_30085":200772,"_5":21646,"_28538":199891,"_5847":91455},[],{"_6944":123242,"_42621":122868,"_30085":200774,"_5":21646,"_28538":199891,"_5847":200775},[],"Lee un módulo",{"_6944":123243,"_42621":122868,"_30085":200777,"_5":21646,"_28538":199891,"_5847":84812},[],{"_6944":123244,"_42621":122868,"_30085":200779,"_5":21646,"_28538":199891,"_5847":91455},[],{"_6944":123245,"_42621":122868,"_30085":200781,"_5":21646,"_28538":199891,"_5847":200782},[],"Actualiza `delivery_intent` y `release_notes`. Envía al menos uno",{"_6944":123246,"_42621":122868,"_30085":200784,"_5":21646,"_28538":199891,"_5847":85374},[],{"_6944":123247,"_42621":122868,"_30085":200786,"_5":21646,"_28538":199891,"_5847":91470},[],{"_6944":123248,"_42621":122868,"_30085":200788,"_5":21646,"_28538":199891,"_5847":200789},[],"Sube un archivo (campo `file`). Responde `201` con el artefacto",{"_6944":123249,"_42621":122868,"_30085":200791,"_5":21646,"_28538":199891,"_5847":84803},[],{"_6944":123250,"_42621":122868,"_30085":200793,"_5":21646,"_28538":199891,"_5847":91478},[],{"_6944":123251,"_42621":122868,"_30085":200795,"_5":21646,"_28538":199891,"_5847":200796},[],"Descarga un archivo almacenado",{"_6944":123252,"_42621":122868,"_30085":200798,"_5":21646,"_28538":199891,"_5847":90856},[],{"_6944":123253,"_42621":122868,"_30085":200800,"_5":21646,"_28538":199891,"_5847":91486},[],{"_6944":123254,"_42621":122868,"_30085":200802,"_5":21646,"_28538":199891,"_5847":200803},[],"Quita un archivo. Responde `204`",{"_6944":123255,"_42621":122868,"_30085":200805,"_5":21646,"_28538":199891,"_5847":85374},[],{"_6944":123256,"_42621":122868,"_30085":200807,"_5":21646,"_28538":199891,"_5847":91494},[],{"_6944":123257,"_42621":122868,"_30085":200809,"_5":21646,"_28538":199891,"_5847":200810},[],"Sube el sw-description que lee la compilación (campo `file`). Responde con el módulo",{"_6944":123258,"_42621":122868,"_30085":200812,"_5":21646,"_28538":199891,"_5847":85374},[],{"_6944":123259,"_42621":122868,"_30085":200814,"_5":21646,"_28538":199891,"_5847":91502},[],{"_6944":123260,"_42621":122868,"_30085":200816,"_5":21646,"_28538":199891,"_5847":200817},[],"Compila el entregable de este módulo. Solo modo hawkBit (`501` en native). El comportamiento depende de `delivery_intent`. El cuerpo es opcional y admite `user`, `encryption_key_name`, `encryption_alg_name`, `sw_desc_encrypted`, `signature_key_id`, `signature_alg_name`, `signature_certificate`",{"_6944":123261,"_42621":122868,"_30085":200819,"_5":21646,"_28538":199891,"_5847":200820},[],"Se aceptan archivos mientras la entrega es `undecided`. Un módulo `swu-build` admite entradas de compilación y rechaza un `.swu`; un módulo `swu-prebuilt` admite exactamente un `.swu`. Elige una intención de entrega compatible antes de importar el módulo con `source_module_id`. Una vez que un módulo se ha entregado (lo retiene una versión de pack publicada, o hawkBit lo bloqueó) queda bloqueado: su contenido está protegido, mientras que las notas de versión siguen siendo editables. En modo native el pack compila un único `.swu` a partir de las entradas de todos sus módulos, y un SWU precompilado se sube al pack completo en lugar de importarse como entrada de un módulo.",{"_6944":123262,"_42621":122868,"_30085":200822,"_5":21646,"_28538":199895,"_5847":197196},[],{"_6944":123263,"_42621":122868,"_30085":200824,"_5":21646,"_28538":199895,"_5847":200468},[],{"_6944":123264,"_42621":122868,"_30085":200826,"_5":21646,"_28538":199895,"_5847":91515},[],{"_6944":123265,"_42621":122868,"_30085":200828,"_5":21646,"_28538":199895,"_5847":200829},[],"`type` (`os` o `application`), `name` (sin `/` ni `:`), `version`, `delivery_intent`",{"_6944":123266,"_42621":122868,"_30085":200831,"_5":21646,"_28538":199895,"_5847":91521},[],{"_6944":123267,"_42621":122868,"_30085":200833,"_5":21646,"_28538":199895,"_5847":200834},[],"`source_module_id`, o `source_distribution_set_name` y `module_key`",{"_6944":123268,"_42621":122868,"_30085":200836,"_5":21646,"_28538":199895,"_5847":91527},[],{"_6944":123269,"_42621":122868,"_30085":200838,"_5":21646,"_28538":199895,"_5847":200839},[],"`delivery_intent` y/o `release_notes`",{"_6944":123270,"_42621":122868,"_30085":200841,"_5":21646,"_28538":199895,"_5847":200842},[],"Subidas",{"_6944":123271,"_42621":122868,"_30085":200844,"_5":21646,"_28538":199895,"_5847":200845},[],"`multipart/form-data` con el archivo en `file`. Las subidas de artefactos de ámbito pack (`.../artifact/upload`, `.../modules/:moduleKey/artifact/upload`) admiten además `artifact_name` y `version`. `POST /artifacts` admite `name` y `version`. `POST /softwaremodules/by-id/:moduleID/artifacts` solo admite el archivo",{"_6944":123272,"_42621":122868,"_30085":200847,"_5":21646,"_28538":199898,"_5847":190927},[],{"_6944":123273,"_42621":122868,"_30085":200849,"_5":21646,"_28538":199898,"_5847":197196},[],{"_6944":123274,"_42621":122868,"_30085":200851,"_5":21646,"_28538":199898,"_5847":191820},[],{"_6944":123275,"_42621":122868,"_30085":200853,"_5":21646,"_28538":199898,"_5847":85374},[],{"_6944":123276,"_42621":122868,"_30085":200855,"_5":21646,"_28538":199898,"_5847":90946},[],{"_6944":123277,"_42621":122868,"_30085":200857,"_5":21646,"_28538":199898,"_5847":200858},[],"Sube un artefacto independiente (campos `file`, `name`, `version`). Modo hawkBit: solo queda preparado (se descarta a los 30 minutos, en la siguiente subida) y no se puede asociar a un módulo, así que usa `POST /softwaremodules/by-id/:moduleID/artifacts`",{"_6944":123278,"_42621":122868,"_30085":200860,"_5":21646,"_28538":199898,"_5847":84803},[],{"_6944":123279,"_42621":122868,"_30085":200862,"_5":21646,"_28538":199898,"_5847":90946},[],{"_6944":123280,"_42621":122868,"_30085":200864,"_5":21646,"_28538":199898,"_5847":200865},[],"Catálogo de toda la flota, con las referencias de los packs",{"_6944":123281,"_42621":122868,"_30085":200867,"_5":21646,"_28538":199898,"_5847":84803},[],{"_6944":123282,"_42621":122868,"_30085":200869,"_5":21646,"_28538":199898,"_5847":91561},[],{"_6944":123283,"_42621":122868,"_30085":200871,"_5":21646,"_28538":199898,"_5847":200872},[],"Un artefacto",{"_6944":123284,"_42621":122868,"_30085":200874,"_5":21646,"_28538":199898,"_5847":84803},[],{"_6944":123285,"_42621":122868,"_30085":200876,"_5":21646,"_28538":199898,"_5847":91569},[],{"_6944":123286,"_42621":122868,"_30085":200878,"_5":21646,"_28538":199898,"_5847":200879},[],"Descarga el binario",{"_6944":123287,"_42621":122868,"_30085":200881,"_5":21646,"_28538":199898,"_5847":90856},[],{"_6944":123288,"_42621":122868,"_30085":200883,"_5":21646,"_28538":199898,"_5847":91561},[],{"_6944":123289,"_42621":122868,"_30085":200885,"_5":21646,"_28538":199898,"_5847":200886},[],"Elimina. Responde `204`",{"_6944":123290,"_42621":122868,"_30085":200888,"_5":21646,"_28538":199898,"_5847":200889},[],"`name` y `version` son opcionales al subir. `name` toma por defecto el nombre del archivo sin su extensión. Una `version`, si se indica, debe ser `x.y.z` y mayor que cualquier versión existente de ese nombre, o la subida responde `400`.",{"_6944":123291,"_42621":122868,"_30085":200891,"_5":21646,"_28538":199902,"_5847":190927},[],{"_6944":123292,"_42621":122868,"_30085":200893,"_5":21646,"_28538":199902,"_5847":197196},[],{"_6944":123293,"_42621":122868,"_30085":200895,"_5":21646,"_28538":199902,"_5847":191820},[],{"_6944":123294,"_42621":122868,"_30085":200897,"_5":21646,"_28538":199902,"_5847":85374},[],{"_6944":123295,"_42621":122868,"_30085":200899,"_5":21646,"_28538":199902,"_5847":91593},[],{"_6944":123296,"_42621":122868,"_30085":200901,"_5":21646,"_28538":199902,"_5847":200902},[],"Crea un lanzamiento. Con `?dry_run=true`, solo evalúa",{"_6944":123297,"_42621":122868,"_30085":200904,"_5":21646,"_28538":199902,"_5847":84803},[],{"_6944":123298,"_42621":122868,"_30085":200906,"_5":21646,"_28538":199902,"_5847":91593},[],{"_6944":123299,"_42621":122868,"_30085":200908,"_5":21646,"_28538":199902,"_5847":200909},[],"Historial de lanzamientos",{"_6944":123300,"_42621":122868,"_30085":200911,"_5":21646,"_28538":199902,"_5847":85374},[],{"_6944":123301,"_42621":122868,"_30085":200913,"_5":21646,"_28538":199902,"_5847":91608},[],{"_6944":123302,"_42621":122868,"_30085":200915,"_5":21646,"_28538":199902,"_5847":200916},[],"Despacha el siguiente lote",{"_6944":123303,"_42621":122868,"_30085":200918,"_5":21646,"_28538":199902,"_5847":85374},[],{"_6944":123304,"_42621":122868,"_30085":200920,"_5":21646,"_28538":199902,"_5847":91616},[],{"_6944":123305,"_42621":122868,"_30085":200922,"_5":21646,"_28538":199902,"_5847":200923},[],"Pausa. El lote en curso termina",{"_6944":123306,"_42621":122868,"_30085":200925,"_5":21646,"_28538":199902,"_5847":85374},[],{"_6944":123307,"_42621":122868,"_30085":200927,"_5":21646,"_28538":199902,"_5847":91624},[],{"_6944":123308,"_42621":122868,"_30085":200929,"_5":21646,"_28538":199902,"_5847":200930},[],"Reanuda un lanzamiento en pausa",{"_6944":123309,"_42621":122868,"_30085":200932,"_5":21646,"_28538":199902,"_5847":85374},[],{"_6944":123310,"_42621":122868,"_30085":200934,"_5":21646,"_28538":199902,"_5847":91632},[],{"_6944":123311,"_42621":122868,"_30085":200936,"_5":21646,"_28538":199902,"_5847":200937},[],"Vuelve a encolar los dispositivos fallidos y los despliega. `400` si no hay ninguno fallido",{"_6944":123312,"_42621":122868,"_30085":200939,"_5":21646,"_28538":199902,"_5847":85374},[],{"_6944":123313,"_42621":122868,"_30085":200941,"_5":21646,"_28538":199902,"_5847":91640},[],{"_6944":123314,"_42621":122868,"_30085":200943,"_5":21646,"_28538":199902,"_5847":200944},[],"Cancela de forma permanente",{"_6944":123315,"_42621":122868,"_30085":200946,"_5":21646,"_28538":199902,"_5847":85374},[],{"_6944":123316,"_42621":122868,"_30085":200948,"_5":21646,"_28538":199902,"_5847":91648},[],{"_6944":123317,"_42621":122868,"_30085":200950,"_5":21646,"_28538":199902,"_5847":200951},[],"Marca como completado. Modo hawkBit: `501`",{"_6944":123318,"_42621":122868,"_30085":200953,"_5":21646,"_28538":199902,"_5847":84803},[],{"_6944":123319,"_42621":122868,"_30085":200955,"_5":21646,"_28538":199902,"_5847":91656},[],{"_6944":123320,"_42621":122868,"_30085":200957,"_5":21646,"_28538":199902,"_5847":200958},[],"Lee la estrategia",{"_6944":123321,"_42621":122868,"_30085":200960,"_5":21646,"_28538":199902,"_5847":91662},[],{"_6944":123322,"_42621":122868,"_30085":200962,"_5":21646,"_28538":199902,"_5847":91656},[],{"_6944":123323,"_42621":122868,"_30085":200964,"_5":21646,"_28538":199902,"_5847":200965},[],"Actualiza la estrategia. Modo hawkBit: `501`. El pack lanzado no se puede cambiar",{"_6944":123324,"_42621":122868,"_30085":200967,"_5":21646,"_28538":199902,"_5847":200968},[],"Un lanzamiento de otro grupo responde `404`, como si no existiera.",{"_6944":123325,"_42621":122868,"_30085":200970,"_5":21646,"_28538":199902,"_5847":200971},[],"Cuerpo de creación:",{"_6944":123326,"_42621":122868,"_30085":200973,"_5":21646,"_28538":199902,"_5847":196084},[],{"_6944":123327,"_42621":122868,"_30085":200975,"_5":21646,"_28538":199902,"_5847":199628},[],{"_6944":123328,"_42621":122868,"_30085":200977,"_5":21646,"_28538":199902,"_5847":195948},[],{"_6944":123329,"_42621":122868,"_30085":200979,"_5":21646,"_28538":199902,"_5847":91682},[],{"_6944":123330,"_42621":122868,"_30085":200981,"_5":21646,"_28538":199902,"_5847":191827},[],{"_6944":123331,"_42621":122868,"_30085":200983,"_5":21646,"_28538":199902,"_5847":200984},[],"El pack que se lanza. Debe estar compilado",{"_6944":123332,"_42621":122868,"_30085":200986,"_5":21646,"_28538":199902,"_5847":86554},[],{"_6944":123333,"_42621":122868,"_30085":200988,"_5":21646,"_28538":199902,"_5847":191827},[],{"_6944":123334,"_42621":122868,"_30085":200990,"_5":21646,"_28538":199902,"_5847":200991},[],"`direct` o `phased`. Se aceptan los nombres completos de WFX (`wfx.workflow.dau.direct`). Modo hawkBit: `phased` crea una acción soft, cualquier otro valor una forzada",{"_6944":123335,"_42621":122868,"_30085":200993,"_5":21646,"_28538":199902,"_5847":86542},[],{"_6944":123336,"_42621":122868,"_30085":200995,"_5":21646,"_28538":199902,"_5847":191827},[],{"_6944":123337,"_42621":122868,"_30085":200997,"_5":21646,"_28538":199902,"_5847":200998},[],"`fixed` (un número de dispositivos) o `percentage`",{"_6944":123338,"_42621":122868,"_30085":201000,"_5":21646,"_28538":199902,"_5847":86548},[],{"_6944":123339,"_42621":122868,"_30085":201002,"_5":21646,"_28538":199902,"_5847":191827},[],{"_6944":123340,"_42621":122868,"_30085":201004,"_5":21646,"_28538":199902,"_5847":201005},[],"Mayor que 0",{"_6944":123341,"_42621":122868,"_30085":201007,"_5":21646,"_28538":199902,"_5847":86560},[],{"_6944":123342,"_42621":122868,"_30085":201009,"_5":21646,"_28538":199902,"_5847":82222},[],{"_6944":123343,"_42621":122868,"_30085":201011,"_5":21646,"_28538":199902,"_5847":201012},[],"El canario: va solo primero y debe tener éxito antes que el resto",{"_6944":123344,"_42621":122868,"_30085":201014,"_5":21646,"_28538":199902,"_5847":86566},[],{"_6944":123345,"_42621":122868,"_30085":201016,"_5":21646,"_28538":199902,"_5847":82222},[],{"_6944":123346,"_42621":122868,"_30085":201018,"_5":21646,"_28538":199902,"_5847":201019},[],"Libera el siguiente lote automáticamente. Por defecto `false`",{"_6944":123347,"_42621":122868,"_30085":201021,"_5":21646,"_28538":199902,"_5847":86572},[],{"_6944":123348,"_42621":122868,"_30085":201023,"_5":21646,"_28538":199902,"_5847":82222},[],{"_6944":123349,"_42621":122868,"_30085":201025,"_5":21646,"_28538":199902,"_5847":201026},[],"Porcentaje de un lote que debe tener éxito antes del siguiente, de 0 a 100. 0 significa todo el lote",{"_6944":123350,"_42621":122868,"_30085":201028,"_5":21646,"_28538":199902,"_5847":86578},[],{"_6944":123351,"_42621":122868,"_30085":201030,"_5":21646,"_28538":199902,"_5847":82222},[],{"_6944":123352,"_42621":122868,"_30085":201032,"_5":21646,"_28538":199902,"_5847":201033},[],"Porcentaje de todos los dispositivos que pueden fallar antes de cancelar el lanzamiento, de 0 a 100. 0 significa sin límite",{"_6944":123353,"_42621":122868,"_30085":201035,"_5":21646,"_28538":199902,"_5847":89008},[],{"_6944":123354,"_42621":122868,"_30085":201037,"_5":21646,"_28538":199902,"_5847":82222},[],{"_6944":123355,"_42621":122868,"_30085":201039,"_5":21646,"_28538":199902,"_5847":201040},[],"Despliega a todos los dispositivos aunque fallen las precondiciones. Los fallos se registran igualmente",{"_6944":123356,"_42621":122868,"_30085":201042,"_5":21646,"_28538":199902,"_5847":86584},[],{"_6944":123357,"_42621":122868,"_30085":201044,"_5":21646,"_28538":199902,"_5847":82222},[],{"_6944":123358,"_42621":122868,"_30085":201046,"_5":21646,"_28538":199902,"_5847":201047},[],"Hora de inicio en RFC 3339. Native: el servicio inicia el lanzamiento unos 30 segundos después, como mucho. Modo hawkBit: lo inicia el planificador de hawkBit",{"_6944":123359,"_42621":122868,"_30085":201049,"_5":21646,"_28538":199902,"_5847":86590},[],{"_6944":123360,"_42621":122868,"_30085":201051,"_5":21646,"_28538":199902,"_5847":82222},[],{"_6944":123361,"_42621":122868,"_30085":201053,"_5":21646,"_28538":199902,"_5847":201054},[],"Nombre visible (por defecto, el nombre del pack) y notas del operador",{"_6944":123362,"_42621":122868,"_30085":201056,"_5":21646,"_28538":199902,"_5847":86596},[],{"_6944":123363,"_42621":122868,"_30085":201058,"_5":21646,"_28538":199902,"_5847":82222},[],{"_6944":123364,"_42621":122868,"_30085":201060,"_5":21646,"_28538":199902,"_5847":201061},[],"Una pista de prioridad almacenada, de 0 a 1000. Nada la aplica",{"_6944":123365,"_42621":122868,"_30085":201063,"_5":21646,"_28538":199902,"_5847":201064},[],"El cuerpo de actualización de la estrategia admite `workflow_type`, `rollout_type`, `rollout_value` (mayor que 0), `test_device_id`, `auto`, `approval_threshold` y `error_threshold`. Sustituye todos ellos: un campo omitido vuelve a su valor cero, así que envía la estrategia completa.",{"_6944":123366,"_42621":122868,"_30085":201066,"_5":21646,"_28538":199902,"_5847":201067},[],"Una creación responde `201` con `launch_id`, `precondition_failures`, `forced`, `superseded_devices` y `never_seen_devices`. Una simulación (dry run) responde `200` con `qualifying_devices`, `precondition_failures`, `superseded_devices` y `never_seen_devices`. Los dos últimos solo se rellenan en modo hawkBit: dispositivos con una actualización en curso, que la creación del lanzamiento cancela, y dispositivos que nunca han contactado con hawkBit.",{"_6944":123367,"_42621":122868,"_30085":201069,"_5":21646,"_28538":199902,"_5847":201070},[],"Un lanzamiento se rechaza con `400` cuando el pack no está compilado, o cuando un pack con cifrado por dispositivo tiene dispositivos sin paquete (simulaciones incluidas, y `force_preconditions` no lo anula).",{"_6944":123368,"_42621":122868,"_30085":201072,"_5":21646,"_28538":199905,"_5847":190927},[],{"_6944":123369,"_42621":122868,"_30085":201074,"_5":21646,"_28538":199905,"_5847":197196},[],{"_6944":123370,"_42621":122868,"_30085":201076,"_5":21646,"_28538":199905,"_5847":191820},[],{"_6944":123371,"_42621":122868,"_30085":201078,"_5":21646,"_28538":199905,"_5847":84803},[],{"_6944":123372,"_42621":122868,"_30085":201080,"_5":21646,"_28538":199905,"_5847":91784},[],{"_6944":123373,"_42621":122868,"_30085":201082,"_5":21646,"_28538":199905,"_5847":201083},[],"Los jobs de un dispositivo. `404` si el dispositivo no está en el grupo",{"_6944":123374,"_42621":122868,"_30085":201085,"_5":21646,"_28538":199905,"_5847":84803},[],{"_6944":123375,"_42621":122868,"_30085":201087,"_5":21646,"_28538":199905,"_5847":91792},[],{"_6944":123376,"_42621":122868,"_30085":201089,"_5":21646,"_28538":199905,"_5847":201090},[],"El historial de jobs de un dispositivo. `404` si no hay ninguno",{"_6944":123377,"_42621":122868,"_30085":201092,"_5":21646,"_28538":199905,"_5847":84803},[],{"_6944":123378,"_42621":122868,"_30085":201094,"_5":21646,"_28538":199905,"_5847":91800},[],{"_6944":123379,"_42621":122868,"_30085":201096,"_5":21646,"_28538":199905,"_5847":201097},[],"Todos los jobs de un lanzamiento",{"_6944":123380,"_42621":122868,"_30085":201099,"_5":21646,"_28538":199905,"_5847":84812},[],{"_6944":123381,"_42621":122868,"_30085":201101,"_5":21646,"_28538":199905,"_5847":91808},[],{"_6944":123382,"_42621":122868,"_30085":201103,"_5":21646,"_28538":199905,"_5847":201104},[],"Fuerza un job a un estado (cuerpo `state`, y opcionalmente `message`, `progress`, `context`). Solo se registra cuando `enable_test_endpoints` es true. Solo para pruebas: no comprueba la propiedad",{"_6944":123383,"_42621":122868,"_30085":201106,"_5":21646,"_28538":199908,"_5847":190927},[],{"_6944":123384,"_42621":122868,"_30085":201108,"_5":21646,"_28538":199908,"_5847":197196},[],{"_6944":123385,"_42621":122868,"_30085":201110,"_5":21646,"_28538":199908,"_5847":191820},[],{"_6944":123386,"_42621":122868,"_30085":201112,"_5":21646,"_28538":199908,"_5847":84803},[],{"_6944":123387,"_42621":122868,"_30085":201114,"_5":21646,"_28538":199908,"_5847":91822},[],{"_6944":123388,"_42621":122868,"_30085":201116,"_5":21646,"_28538":199908,"_5847":201117},[],"Versiones de pack en todos los dispositivos, filtrable",{"_6944":123389,"_42621":122868,"_30085":201119,"_5":21646,"_28538":199908,"_5847":84803},[],{"_6944":123390,"_42621":122868,"_30085":201121,"_5":21646,"_28538":199908,"_5847":91830},[],{"_6944":123391,"_42621":122868,"_30085":201123,"_5":21646,"_28538":199908,"_5847":201124},[],"Versiones de pack en un dispositivo",{"_6944":123392,"_42621":122868,"_30085":201126,"_5":21646,"_28538":199908,"_5847":84803},[],{"_6944":123393,"_42621":122868,"_30085":201128,"_5":21646,"_28538":199908,"_5847":91838},[],{"_6944":123394,"_42621":122868,"_30085":201130,"_5":21646,"_28538":199908,"_5847":201131},[],"Los packs del dispositivo, cada uno con sus artefactos",{"_6944":123395,"_42621":122868,"_30085":201133,"_5":21646,"_28538":199908,"_5847":84803},[],{"_6944":123396,"_42621":122868,"_30085":201135,"_5":21646,"_28538":199908,"_5847":91846},[],{"_6944":123397,"_42621":122868,"_30085":201137,"_5":21646,"_28538":199908,"_5847":201138},[],"Historial de actualizaciones del dispositivo, el más reciente primero",{"_6944":123398,"_42621":122868,"_30085":201140,"_5":21646,"_28538":199908,"_5847":84803},[],{"_6944":123399,"_42621":122868,"_30085":201142,"_5":21646,"_28538":199908,"_5847":91854},[],{"_6944":123400,"_42621":122868,"_30085":201144,"_5":21646,"_28538":199908,"_5847":201145},[],"El intento de actualización más reciente de cada dispositivo y pack, incluidos los intentos ajenos a cualquier lanzamiento. Los filtros se aplican a ese intento, así que `status[eq]failed` lista los dispositivos cuya última actualización falló",{"_6944":123401,"_42621":122868,"_30085":201147,"_5":21646,"_28538":199912,"_5847":201148},[],"Declara la versión en la que deben estar los dispositivos, y luego informa y corrige la deriva.",{"_6944":123402,"_42621":122868,"_30085":201150,"_5":21646,"_28538":199912,"_5847":190927},[],{"_6944":123403,"_42621":122868,"_30085":201152,"_5":21646,"_28538":199912,"_5847":197196},[],{"_6944":123404,"_42621":122868,"_30085":201154,"_5":21646,"_28538":199912,"_5847":191820},[],{"_6944":123405,"_42621":122868,"_30085":201156,"_5":21646,"_28538":199912,"_5847":84803},[],{"_6944":123406,"_42621":122868,"_30085":201158,"_5":21646,"_28538":199912,"_5847":91871},[],{"_6944":123407,"_42621":122868,"_30085":201160,"_5":21646,"_28538":199912,"_5847":201161},[],"Las últimas versiones declaradas de un grupo",{"_6944":123408,"_42621":122868,"_30085":201163,"_5":21646,"_28538":199912,"_5847":84812},[],{"_6944":123409,"_42621":122868,"_30085":201165,"_5":21646,"_28538":199912,"_5847":91879},[],{"_6944":123410,"_42621":122868,"_30085":201167,"_5":21646,"_28538":199912,"_5847":201168},[],"Declara la última versión de un pack (cuerpo `{\"version\":\"1.2.0\"}`)",{"_6944":123411,"_42621":122868,"_30085":201170,"_5":21646,"_28538":199912,"_5847":90856},[],{"_6944":123412,"_42621":122868,"_30085":201172,"_5":21646,"_28538":199912,"_5847":91879},[],{"_6944":123413,"_42621":122868,"_30085":201174,"_5":21646,"_28538":199912,"_5847":201175},[],"Quita la declaración. Responde `204`",{"_6944":123414,"_42621":122868,"_30085":201177,"_5":21646,"_28538":199912,"_5847":84803},[],{"_6944":123415,"_42621":122868,"_30085":201179,"_5":21646,"_28538":199912,"_5847":91894},[],{"_6944":123416,"_42621":122868,"_30085":201181,"_5":21646,"_28538":199912,"_5847":201182},[],"La deriva de un dispositivo respecto a las últimas versiones de su grupo. `?groupID=` opcional",{"_6944":123417,"_42621":122868,"_30085":201184,"_5":21646,"_28538":199912,"_5847":85374},[],{"_6944":123418,"_42621":122868,"_30085":201186,"_5":21646,"_28538":199912,"_5847":91902},[],{"_6944":123419,"_42621":122868,"_30085":201188,"_5":21646,"_28538":199912,"_5847":201189},[],"Fuerza al dispositivo a coincidir. Responde `202` con la deriva",{"_6944":123420,"_42621":122868,"_30085":201191,"_5":21646,"_28538":199912,"_5847":85374},[],{"_6944":123421,"_42621":122868,"_30085":201193,"_5":21646,"_28538":199912,"_5847":91910},[],{"_6944":123422,"_42621":122868,"_30085":201195,"_5":21646,"_28538":199912,"_5847":201196},[],"Lanza un solo dispositivo a una versión. Responde `202`",{"_6944":123423,"_42621":122868,"_30085":201198,"_5":21646,"_28538":199912,"_5847":84803},[],{"_6944":123424,"_42621":122868,"_30085":201200,"_5":21646,"_28538":199912,"_5847":91918},[],{"_6944":123425,"_42621":122868,"_30085":201202,"_5":21646,"_28538":199912,"_5847":201203},[],"Dispositivos que no están en la última versión, como `{\"group_id\", \"devices\": [...]}`",{"_6944":123426,"_42621":122868,"_30085":201205,"_5":21646,"_28538":199912,"_5847":84803},[],{"_6944":123427,"_42621":122868,"_30085":201207,"_5":21646,"_28538":199912,"_5847":91926},[],{"_6944":123428,"_42621":122868,"_30085":201209,"_5":21646,"_28538":199912,"_5847":201210},[],"La matriz completa por dispositivo, conformes y desactualizados, como `{\"group_id\", \"rows\": [...]}`",{"_6944":123429,"_42621":122868,"_30085":201212,"_5":21646,"_28538":199912,"_5847":201213},[],"`sync-to-latest` admite un cuerpo opcional con `groupID` (también aceptado como `?groupID=`), `distribution_set_ids` para limitar los packs y `workflow`. Si algunos dispositivos no se pudieron despachar responde `207`, o `400` si no se despachó ninguno, con `{\"err\": \"...\", \"drift\": {...}}`.",{"_6944":123430,"_42621":122868,"_30085":201215,"_5":21646,"_28538":199912,"_5847":201216},[],"`force-version` admite `distribution_set_id` y `version` (obligatorios), `group_id` y `workflow`. El dispositivo debe ser miembro del grupo del pack. En un pack `swu`, `workflow` toma por defecto `phased`, y en un pack `non-swu`, `download-install`. El modo native solo acepta la versión actual del pack salvo que el pack tenga `allow_previous_version_download`, y `sync-to-latest` tiene el mismo límite. El modo hawkBit ignora `workflow` en ambas rutas.",{"_6944":123431,"_42621":122868,"_30085":201218,"_5":21646,"_28538":199912,"_5847":201219},[],"Una entrada de deriva tiene `distribution_set_id`, `distribution_set_name`, `current_version`, `latest_version`, `in_sync` y `missing`. Una fila de `version-status` tiene `device_id`, `distribution_set_id`, `distribution_set_name`, `current_version`, `latest_version`, `in_sync` y, cuando es más reciente que la declarada, `newest_version`.",{"_6944":123432,"_42621":122868,"_30085":201221,"_5":21646,"_28538":199916,"_5847":201222},[],"En modo hawkBit el servicio también sirve la URL de artefactos de dispositivo de hawkBit, de modo que un gateway puede publicarla en el mismo host que el resto de la API:",{"_6944":123433,"_42621":122868,"_30085":201224,"_5":21646,"_28538":199916,"_5847":190927},[],{"_6944":123434,"_42621":122868,"_30085":201226,"_5":21646,"_28538":199916,"_5847":197196},[],{"_6944":123435,"_42621":122868,"_30085":201228,"_5":21646,"_28538":199916,"_5847":191820},[],{"_6944":123436,"_42621":122868,"_30085":201230,"_5":21646,"_28538":199916,"_5847":91950},[],{"_6944":123437,"_42621":122868,"_30085":201232,"_5":21646,"_28538":199916,"_5847":91953},[],{"_6944":123438,"_42621":122868,"_30085":201234,"_5":21646,"_28538":199916,"_5847":201235},[],"El artefacto de un módulo, o su archivo auxiliar `.MD5SUM` como `text/plain`",{"_6944":123439,"_42621":122868,"_30085":201237,"_5":21646,"_28538":199916,"_5847":201238},[],"`<prefix>` es la ruta de `hawkbit.ddi_url`, por ejemplo `/api/hawkbit-ddi`. La ruta solo se registra en modo hawkBit. Responde únicamente para módulos del conjunto asignado o instalado del dispositivo, y `404` en otro caso, y `:tenant` debe ser el tenant configurado. Con la firma previa activada responde `302` como las demás descargas.",{"_6944":123440,"_42621":122868,"_30085":201240,"_5":21646,"_28538":199920,"_5847":201241},[],"Se sirve en `/symkms/v1` desde el mismo proceso cuando SymKMS está configurado. Almacena claves simétricas y las asocia a dispositivos. Los cuerpos y formatos de cifrado, descifrado y MAC están en Firma y cifrado. Los errores usan el mismo cuerpo `{\"err\":\"...\"}`.",{"_6944":123441,"_42621":122868,"_30085":201243,"_5":21646,"_28538":199920,"_5847":190927},[],{"_6944":123442,"_42621":122868,"_30085":201245,"_5":21646,"_28538":199920,"_5847":197196},[],{"_6944":123443,"_42621":122868,"_30085":201247,"_5":21646,"_28538":199920,"_5847":191820},[],{"_6944":123444,"_42621":122868,"_30085":201249,"_5":21646,"_28538":199920,"_5847":85374},[],{"_6944":123445,"_42621":122868,"_30085":201251,"_5":21646,"_28538":199920,"_5847":91973},[],{"_6944":123446,"_42621":122868,"_30085":201253,"_5":21646,"_28538":199920,"_5847":201254},[],"Almacena una clave. Cuerpo `user_id`, `algorithm`, `key` (hex o Base64), `id` opcional. Responde `201` con `id`, `user_id`, `algorithm`, `created_at`",{"_6944":123447,"_42621":122868,"_30085":201256,"_5":21646,"_28538":199920,"_5847":84803},[],{"_6944":123448,"_42621":122868,"_30085":201258,"_5":21646,"_28538":199920,"_5847":91981},[],{"_6944":123449,"_42621":122868,"_30085":201260,"_5":21646,"_28538":199920,"_5847":201261},[],"Lista las claves de un usuario. `user_id` es obligatorio. Paginado, filtrable por `user_id`, `algorithm`, `created_at`",{"_6944":123450,"_42621":122868,"_30085":201263,"_5":21646,"_28538":199920,"_5847":90856},[],{"_6944":123451,"_42621":122868,"_30085":201265,"_5":21646,"_28538":199920,"_5847":91989},[],{"_6944":123452,"_42621":122868,"_30085":201267,"_5":21646,"_28538":199920,"_5847":201268},[],"Elimina una clave. `user_id` es obligatorio y debe ser su propietario",{"_6944":123453,"_42621":122868,"_30085":201270,"_5":21646,"_28538":199920,"_5847":84803},[],{"_6944":123454,"_42621":122868,"_30085":201272,"_5":21646,"_28538":199920,"_5847":91997},[],{"_6944":123455,"_42621":122868,"_30085":201274,"_5":21646,"_28538":199920,"_5847":201275},[],"Material de clave en bruto (`key_id`, `key_hex`, `algorithm`). Privilegiada",{"_6944":123456,"_42621":122868,"_30085":201277,"_5":21646,"_28538":199920,"_5847":85374},[],{"_6944":123457,"_42621":122868,"_30085":201279,"_5":21646,"_28538":199920,"_5847":92005},[],{"_6944":123458,"_42621":122868,"_30085":201281,"_5":21646,"_28538":199920,"_5847":201282},[],"Cifra o descifra con una clave almacenada",{"_6944":123459,"_42621":122868,"_30085":201284,"_5":21646,"_28538":199920,"_5847":85374},[],{"_6944":123460,"_42621":122868,"_30085":201286,"_5":21646,"_28538":199920,"_5847":92013},[],{"_6944":123461,"_42621":122868,"_30085":201288,"_5":21646,"_28538":199920,"_5847":201289},[],"Calcula o verifica un MAC (cuerpo JSON)",{"_6944":123462,"_42621":122868,"_30085":201291,"_5":21646,"_28538":199920,"_5847":85374},[],{"_6944":123463,"_42621":122868,"_30085":201293,"_5":21646,"_28538":199920,"_5847":92021},[],{"_6944":123464,"_42621":122868,"_30085":201295,"_5":21646,"_28538":199920,"_5847":201296},[],"Lo mismo, con los datos como `file` subido",{"_6944":123465,"_42621":122868,"_30085":201298,"_5":21646,"_28538":199920,"_5847":85374},[],{"_6944":123466,"_42621":122868,"_30085":201300,"_5":21646,"_28538":199920,"_5847":92029},[],{"_6944":123467,"_42621":122868,"_30085":201302,"_5":21646,"_28538":199920,"_5847":201303},[],"Asigna una clave a un dispositivo. Cuerpo opcional `purpose`, `expires_at` (RFC 3339). Responde `201` con la asociación",{"_6944":123468,"_42621":122868,"_30085":201305,"_5":21646,"_28538":199920,"_5847":90856},[],{"_6944":123469,"_42621":122868,"_30085":201307,"_5":21646,"_28538":199920,"_5847":92029},[],{"_6944":123470,"_42621":122868,"_30085":201309,"_5":21646,"_28538":199920,"_5847":201310},[],"Revoca una clave de un dispositivo",{"_6944":123471,"_42621":122868,"_30085":201312,"_5":21646,"_28538":199920,"_5847":84803},[],{"_6944":123472,"_42621":122868,"_30085":201314,"_5":21646,"_28538":199920,"_5847":92044},[],{"_6944":123473,"_42621":122868,"_30085":201316,"_5":21646,"_28538":199920,"_5847":201317},[],"Las asociaciones de claves de un dispositivo. Paginado, filtrable por `purpose`, `status`, `assigned_at`",{"_6944":123474,"_42621":122868,"_30085":201319,"_5":21646,"_28538":199920,"_5847":84803},[],{"_6944":123475,"_42621":122868,"_30085":201321,"_5":21646,"_28538":199920,"_5847":92052},[],{"_6944":123476,"_42621":122868,"_30085":201323,"_5":21646,"_28538":199920,"_5847":201324},[],"Los dispositivos a los que está asignada una clave, como `key_id` y `device_ids`",{"_6944":123477,"_42621":122868,"_30085":201326,"_5":21646,"_28538":199920,"_5847":84803},[],{"_6944":123478,"_42621":122868,"_30085":201328,"_5":21646,"_28538":199920,"_5847":92060},[],{"_6944":123479,"_42621":122868,"_30085":201330,"_5":21646,"_28538":199920,"_5847":201331},[],"La clave en bruto del dispositivo para un propósito, por defecto `firmware-encryption`. Privilegiada. `404` si no hay asociación",{"_6944":123480,"_42621":122868,"_30085":201333,"_5":21646,"_28538":199920,"_5847":201334},[],"Un `purpose` vacío es un comodín que coincide con cualquier consulta, y un propósito concreto se compara de forma exacta. Las rutas que devuelven material de clave en bruto confían en que el gateway autentique a quien llama: no las expongas sin mTLS o tokens con ámbito. Consulta Seguridad.",{"_6944":123481,"_42621":122868,"_30085":201336,"_5":21646,"_28538":199923,"_5847":201337},[],"Capabilities para saber qué admite cada backend",{"_6944":123482,"_42621":122868,"_30085":201339,"_5":21646,"_28538":199923,"_5847":197943},[],{"_6944":123483,"_42621":122868,"_30085":201341,"_5":21646,"_28538":199923,"_5847":197649},[],{"_6944":123484,"_42621":123484,"_5":22076,"_5847":89556,"_43101":201343,"_30085":201344,"_28538":123484},[78004,189200,195583,199819],[],{"_6944":123485,"_42621":123484,"_30085":201346,"_5":21646,"_28538":123484,"_5847":201347},[],"Las 22 capacidades de Lamassu Updates, qué admite cada backend y cómo las lee un cliente.",{"_6944":123486,"_42621":123484,"_5":43098,"_30085":201349,"_28538":201350,"_5847":201351},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/capabilities#lee-las-capacidades","Lee las capacidades",{"_6944":123487,"_42621":123484,"_5":43098,"_30085":201353,"_28538":201354,"_5847":201355},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/capabilities#soporte-por-backend","Soporte por backend",{"_6944":123488,"_42621":123484,"_5":43098,"_30085":201357,"_28538":201358,"_5847":201359},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/capabilities#capacidades-condicionales-en-modo-hawkbit","Capacidades condicionales en modo hawkBit",{"_6944":123489,"_42621":123484,"_5":43098,"_30085":201361,"_28538":201362,"_5847":201363},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/capabilities#capacidades-cuyo-significado-cambia","Capacidades cuyo significado cambia",{"_6944":123490,"_42621":123484,"_5":43098,"_30085":201365,"_28538":201366,"_5847":201367},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/capabilities#qué-debe-hacer-un-cliente","Qué debe hacer un cliente",{"_6944":123491,"_42621":123484,"_5":43098,"_30085":201369,"_28538":201370,"_5847":190839},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/capabilities#siguientes-pasos",{"_6944":123492,"_42621":123484,"_30085":201372,"_5":21646,"_28538":123484,"_5847":201373},[],"`GET /updates/v1/capabilities` indica a un cliente qué backend está activo (`native` o `hawkbit&#x60;) y cuáles de las 22 funciones admite. Léela una vez y oculta lo que no aplique. Una operación que el backend no implementa responde &#x2A;*`501 Not Implemented`**, nunca `500`; un `501` es una propiedad permanente del despliegue, así que reintentar no sirve de nada. La única excepción es `GET /workflows`, que en modo hawkBit responde una lista vacía.",{"_6944":123493,"_42621":123484,"_30085":201375,"_5":21646,"_28538":201350,"_5847":201376},[],"La ruta no recibe parámetros y no tiene efectos secundarios. El servicio la sirve sin autenticación, igual que `/health`; un gateway delante de él puede seguir exigiendo un token.",{"_6944":123494,"_42621":123484,"_30085":201378,"_5":21646,"_28538":201350,"_5847":201379},[],"La respuesta tiene tres campos:",{"_6944":123495,"_42621":123484,"_30085":201381,"_5":21646,"_28538":201350,"_5847":196084},[],{"_6944":123496,"_42621":123484,"_30085":201383,"_5":21646,"_28538":201350,"_5847":191814},[],{"_6944":123497,"_42621":123484,"_30085":201385,"_5":21646,"_28538":201350,"_5847":195948},[],{"_6944":123498,"_42621":123484,"_30085":201387,"_5":21646,"_28538":201350,"_5847":92120},[],{"_6944":123499,"_42621":123484,"_30085":201389,"_5":21646,"_28538":201350,"_5847":35152},[],{"_6944":123500,"_42621":123484,"_30085":201391,"_5":21646,"_28538":201350,"_5847":201392},[],"`native` o `hawkbit`",{"_6944":123501,"_42621":123484,"_30085":201394,"_5":21646,"_28538":201350,"_5847":92128},[],{"_6944":123502,"_42621":123484,"_30085":201396,"_5":21646,"_28538":201350,"_5847":145206},[],{"_6944":123503,"_42621":123484,"_30085":201398,"_5":21646,"_28538":201350,"_5847":201399},[],"Un booleano por capacidad. Siempre incluye las 22 claves, así que una clave ausente indica una diferencia de versión entre cliente y servidor, no que esté admitida",{"_6944":123504,"_42621":123484,"_30085":201401,"_5":21646,"_28538":201350,"_5847":92136},[],{"_6944":123505,"_42621":123484,"_30085":201403,"_5":21646,"_28538":201350,"_5847":201404},[],"array de strings",{"_6944":123506,"_42621":123484,"_30085":201406,"_5":21646,"_28538":201350,"_5847":201407},[],"Las capacidades en `false`, repetidas por comodidad, en el orden de la tabla siguiente",{"_6944":123507,"_42621":123484,"_30085":201409,"_5":21646,"_28538":201350,"_5847":201410},[],"Un ejemplo para un despliegue native:",{"_6944":123508,"_42621":123484,"_30085":201412,"_5":21646,"_28538":201354,"_5847":201413},[],"«Sí» significa admitido. «Condicional» significa que depende de la configuración o del servidor hawkBit; consulta las notas tras la tabla.",{"_6944":123509,"_42621":123484,"_30085":201415,"_5":21646,"_28538":201354,"_5847":201416},[],"Capacidad",{"_6944":123510,"_42621":123484,"_30085":201418,"_5":21646,"_28538":201354,"_5847":34130},[],{"_6944":123511,"_42621":123484,"_30085":201420,"_5":21646,"_28538":201354,"_5847":30471},[],{"_6944":123512,"_42621":123484,"_30085":201422,"_5":21646,"_28538":201354,"_5847":201423},[],"`latest_versions`: declarar la última versión por grupo, más la deriva por dispositivo y la sincronización forzada",{"_6944":123513,"_42621":123484,"_30085":201425,"_5":21646,"_28538":201354,"_5847":191827},[],{"_6944":123514,"_42621":123484,"_30085":201427,"_5":21646,"_28538":201354,"_5847":191827},[],{"_6944":123515,"_42621":123484,"_30085":201429,"_5":21646,"_28538":201354,"_5847":201430},[],"`version_compliance`: informes de conformidad y estado de versión de todo el grupo",{"_6944":123516,"_42621":123484,"_30085":201432,"_5":21646,"_28538":201354,"_5847":191827},[],{"_6944":123517,"_42621":123484,"_30085":201434,"_5":21646,"_28538":201354,"_5847":191827},[],{"_6944":123518,"_42621":123484,"_30085":201436,"_5":21646,"_28538":201354,"_5847":201437},[],"`artifact_signatures`: manifiestos de versión firmados y el archivo de artefactos",{"_6944":123519,"_42621":123484,"_30085":201439,"_5":21646,"_28538":201354,"_5847":191827},[],{"_6944":123520,"_42621":123484,"_30085":201441,"_5":21646,"_28538":201354,"_5847":191827},[],{"_6944":123521,"_42621":123484,"_30085":201443,"_5":21646,"_28538":201354,"_5847":201444},[],"`artifact_encryption`: cifrado con clave compartida y firma con KMS durante la compilación",{"_6944":123522,"_42621":123484,"_30085":201446,"_5":21646,"_28538":201354,"_5847":191827},[],{"_6944":123523,"_42621":123484,"_30085":201448,"_5":21646,"_28538":201354,"_5847":201449},[],"Condicional",{"_6944":123524,"_42621":123484,"_30085":201451,"_5":21646,"_28538":201354,"_5847":201452},[],"`per_device_encryption`: un entregable por dispositivo, cada uno con su propia clave",{"_6944":123525,"_42621":123484,"_30085":201454,"_5":21646,"_28538":201354,"_5847":191827},[],{"_6944":123526,"_42621":123484,"_30085":201456,"_5":21646,"_28538":201354,"_5847":92192},[],{"_6944":123527,"_42621":123484,"_30085":201458,"_5":21646,"_28538":201354,"_5847":201459},[],"`artifact_download_by_name`: descargar un archivo preparado de un pack por nombre",{"_6944":123528,"_42621":123484,"_30085":201461,"_5":21646,"_28538":201354,"_5847":191827},[],{"_6944":123529,"_42621":123484,"_30085":201463,"_5":21646,"_28538":201354,"_5847":191827},[],{"_6944":123530,"_42621":123484,"_30085":201465,"_5":21646,"_28538":201354,"_5847":201466},[],"`workflows`: elegir el workflow de WFX por lanzamiento",{"_6944":123531,"_42621":123484,"_30085":201468,"_5":21646,"_28538":201354,"_5847":191827},[],{"_6944":123532,"_42621":123484,"_30085":201470,"_5":21646,"_28538":201354,"_5847":92192},[],{"_6944":123533,"_42621":123484,"_30085":201472,"_5":21646,"_28538":201354,"_5847":201473},[],"`launch_strategy_update`: editar la estrategia tras crear el lanzamiento",{"_6944":123534,"_42621":123484,"_30085":201475,"_5":21646,"_28538":201354,"_5847":191827},[],{"_6944":123535,"_42621":123484,"_30085":201477,"_5":21646,"_28538":201354,"_5847":92192},[],{"_6944":123536,"_42621":123484,"_30085":201479,"_5":21646,"_28538":201354,"_5847":201480},[],"`launch_complete`: marcar un lanzamiento como completado antes de tiempo",{"_6944":123537,"_42621":123484,"_30085":201482,"_5":21646,"_28538":201354,"_5847":191827},[],{"_6944":123538,"_42621":123484,"_30085":201484,"_5":21646,"_28538":201354,"_5847":92192},[],{"_6944":123539,"_42621":123484,"_30085":201486,"_5":21646,"_28538":201354,"_5847":201487},[],"`launch_device_assignment`: añadir dispositivos a un lanzamiento tras crearlo (una operación del servicio sin ruta HTTP)",{"_6944":123540,"_42621":123484,"_30085":201489,"_5":21646,"_28538":201354,"_5847":191827},[],{"_6944":123541,"_42621":123484,"_30085":201491,"_5":21646,"_28538":201354,"_5847":92192},[],{"_6944":123542,"_42621":123484,"_30085":201493,"_5":21646,"_28538":201354,"_5847":201494},[],"`scheduled_launch`: iniciar un lanzamiento en un momento futuro",{"_6944":123543,"_42621":123484,"_30085":201496,"_5":21646,"_28538":201354,"_5847":201497},[],"Sí (el servicio sondea)",{"_6944":123544,"_42621":123484,"_30085":201499,"_5":21646,"_28538":201354,"_5847":201500},[],"Sí (el planificador propio de hawkBit)",{"_6944":123545,"_42621":123484,"_30085":201502,"_5":21646,"_28538":201354,"_5847":201503},[],"`push_events`: estado de los jobs enviado por el servidor",{"_6944":123546,"_42621":123484,"_30085":201505,"_5":21646,"_28538":201354,"_5847":191827},[],{"_6944":123547,"_42621":123484,"_30085":201507,"_5":21646,"_28538":201354,"_5847":201508},[],"**No** (sondeo)",{"_6944":123548,"_42621":123484,"_30085":201510,"_5":21646,"_28538":201354,"_5847":201511},[],"`launch_preconditions`: acotar los dispositivos desplegables según las versiones instaladas",{"_6944":123549,"_42621":123484,"_30085":201513,"_5":21646,"_28538":201354,"_5847":191827},[],{"_6944":123550,"_42621":123484,"_30085":201515,"_5":21646,"_28538":201354,"_5847":191827},[],{"_6944":123551,"_42621":123484,"_30085":201517,"_5":21646,"_28538":201354,"_5847":201518},[],"`campaigns`: planificar, iniciar, pausar, reanudar, cancelar y reintentar los fallidos",{"_6944":123552,"_42621":123484,"_30085":201520,"_5":21646,"_28538":201354,"_5847":191827},[],{"_6944":123553,"_42621":123484,"_30085":201522,"_5":21646,"_28538":201354,"_5847":191827},[],{"_6944":123554,"_42621":123484,"_30085":201524,"_5":21646,"_28538":201354,"_5847":201525},[],"`canary_device`: el primer lote es un dispositivo concreto",{"_6944":123555,"_42621":123484,"_30085":201527,"_5":21646,"_28538":201354,"_5847":191827},[],{"_6944":123556,"_42621":123484,"_30085":201529,"_5":21646,"_28538":201354,"_5847":191827},[],{"_6944":123557,"_42621":123484,"_30085":201531,"_5":21646,"_28538":201354,"_5847":201532},[],"`device_inventory`: qué versión de pack tiene un dispositivo y su historial de actualizaciones",{"_6944":123558,"_42621":123484,"_30085":201534,"_5":21646,"_28538":201354,"_5847":191827},[],{"_6944":123559,"_42621":123484,"_30085":201536,"_5":21646,"_28538":201354,"_5847":191827},[],{"_6944":123560,"_42621":123484,"_30085":201538,"_5":21646,"_28538":201354,"_5847":201539},[],"`artifact_catalog`: catálogo de artefactos de toda la flota y listado por pack",{"_6944":123561,"_42621":123484,"_30085":201541,"_5":21646,"_28538":201354,"_5847":191827},[],{"_6944":123562,"_42621":123484,"_30085":201543,"_5":21646,"_28538":201354,"_5847":191827},[],{"_6944":123563,"_42621":123484,"_30085":201545,"_5":21646,"_28538":201354,"_5847":201546},[],"`prebuilt_deliverable`: adjuntar a un pack un archivo compilado externamente",{"_6944":123564,"_42621":123484,"_30085":201548,"_5":21646,"_28538":201354,"_5847":191827},[],{"_6944":123565,"_42621":123484,"_30085":201550,"_5":21646,"_28538":201354,"_5847":92192},[],{"_6944":123566,"_42621":123484,"_30085":201552,"_5":21646,"_28538":201354,"_5847":201553},[],"`software_module_composition`: un pack es una composición de módulos tipados",{"_6944":123567,"_42621":123484,"_30085":201555,"_5":21646,"_28538":201354,"_5847":191827},[],{"_6944":123568,"_42621":123484,"_30085":201557,"_5":21646,"_28538":201354,"_5847":201449},[],{"_6944":123569,"_42621":123484,"_30085":201559,"_5":21646,"_28538":201354,"_5847":201560},[],"`software_module_deliverables`: cada módulo tiene su propio entregable",{"_6944":123570,"_42621":123484,"_30085":201562,"_5":21646,"_28538":201354,"_5847":92192},[],{"_6944":123571,"_42621":123484,"_30085":201564,"_5":21646,"_28538":201354,"_5847":191827},[],{"_6944":123572,"_42621":123484,"_30085":201566,"_5":21646,"_28538":201354,"_5847":201567},[],"`standalone_software_modules`: crear un módulo sin pack",{"_6944":123573,"_42621":123484,"_30085":201569,"_5":21646,"_28538":201354,"_5847":191827},[],{"_6944":123574,"_42621":123484,"_30085":201571,"_5":21646,"_28538":201354,"_5847":201449},[],{"_6944":123575,"_42621":123484,"_30085":201573,"_5":21646,"_28538":201354,"_5847":201574},[],"`software_module_replace`: sustituir un módulo por otra versión de sí mismo",{"_6944":123576,"_42621":123484,"_30085":201576,"_5":21646,"_28538":201354,"_5847":92192},[],{"_6944":123577,"_42621":123484,"_30085":201578,"_5":21646,"_28538":201354,"_5847":201449},[],{"_6944":123578,"_42621":123484,"_30085":201580,"_5":21646,"_28538":201358,"_5847":201581},[],"**`artifact_encryption`** se informa como no admitida solo cuando no está configurado ninguno de `swugenerator_path`, `symkms_endpoint` y `kms_endpoint`. Cada opción de compilación sigue necesitando su propia configuración: consulta Firma y cifrado.",{"_6944":123579,"_42621":123484,"_30085":201583,"_5":21646,"_28538":201358,"_5847":201584},[],"**`software_module_composition`, `standalone_software_modules` y `software_module_replace`** dependen de que el servidor hawkBit tenga los tipos de módulo preinstalados `os` y `application` y el tipo de conjunto `os_app` o `app`. El servicio lo sondea con un timeout de 5 segundos, guarda el resultado unos cinco minutos y asume que hay soporte cuando hawkBit no responde. Si el sondeo falla, las tres capacidades se informan juntas como no admitidas.",{"_6944":123580,"_42621":123484,"_30085":201586,"_5":21646,"_28538":201358,"_5847":201587},[],"**`software_module_deliverables`** siempre se informa como admitida en modo hawkBit. Compilar un módulo `swu-build` sigue necesitando un `swugenerator_path`; sin él, la compilación responde `501`.",{"_6944":123581,"_42621":123484,"_30085":201589,"_5":21646,"_28538":201358,"_5847":201590},[],"**`prebuilt_deliverable`**: un pack de hawkBit nunca se compila directamente. Un módulo `swu-prebuilt` del catálogo acepta en su lugar un `.swu` terminado.",{"_6944":123582,"_42621":123484,"_30085":201592,"_5":21646,"_28538":201362,"_5847":201593},[],"Ambos backends informan `software_module_composition`, pero importar un módulo lo **enlaza** en modo hawkBit (ambos packs comparten un único módulo) y lo **copia** en modo native. La lista de módulos reutilizables lo indica por candidato en su campo `shared`, de modo que un cliente puede decirle al operador cuál de los dos casos tiene. Consulta Conceptos.",{"_6944":123583,"_42621":123484,"_30085":201595,"_5":21646,"_28538":201362,"_5847":201596},[],"En modo native un lanzamiento despacha un job por dispositivo con una única URI de descarga, así que un módulo no tiene entregable propio: el pack compila un único `.swu` a partir de las entradas de todos sus módulos. Por eso `software_module_deliverables` y `software_module_replace` no están admitidas allí.",{"_6944":123584,"_42621":123484,"_30085":201598,"_5":21646,"_28538":201366,"_5847":201599},[],"Llama a `capabilities` una vez al arrancar y antes de mostrar una función que la tabla marque como dependiente del backend.",{"_6944":123585,"_42621":123484,"_30085":201601,"_5":21646,"_28538":201366,"_5847":201602},[],"Trata un `501` en una ruta como definitivo: oculta la acción en lugar de reintentar.",{"_6944":123586,"_42621":123484,"_30085":201604,"_5":21646,"_28538":201366,"_5847":201605},[],"No deduzcas el backend por la URL. Ambos sirven las mismas rutas `/updates/v1`; consulta la Referencia de la API para saber qué rutas responden `501` en cada backend.",{"_6944":123587,"_42621":123484,"_30085":201607,"_5":21646,"_28538":201366,"_5847":201608},[],"Vuelve a leer las capacidades tras cambiar los tipos de módulo de hawkBit o la configuración de compilación.",{"_6944":123588,"_42621":123484,"_30085":201610,"_5":21646,"_28538":201370,"_5847":197939},[],{"_6944":123589,"_42621":123484,"_30085":201612,"_5":21646,"_28538":201370,"_5847":195599},[],{"_6944":123590,"_42621":123590,"_5":22076,"_5847":201614,"_43101":201615,"_30085":201616,"_28538":123590},"Referencia de configuración",[78004,189200,195583,199819],[],{"_6944":123591,"_42621":123590,"_30085":201618,"_5":21646,"_28538":123590,"_5847":201619},[],"Todas las claves de configuración de Lamassu Updates, su valor por defecto, qué backend las lee y cómo sobrescribirlas con variables de entorno.",{"_6944":123592,"_42621":123590,"_5":43098,"_30085":201621,"_28538":201622,"_5847":201623},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#cómo-se-carga-la-configuración","Cómo se carga la configuración",{"_6944":123593,"_42621":123590,"_5":43098,"_30085":201625,"_28538":201626,"_5847":201627},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#qué-claves-lee-cada-modo","Qué claves lee cada modo",{"_6944":123594,"_42621":123590,"_5":43098,"_30085":201629,"_28538":201630,"_5847":201631},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#ajustes-generales-y-del-servidor","Ajustes generales y del servidor",{"_6944":123595,"_42621":123590,"_5":43098,"_30085":201633,"_28538":201634,"_5847":201635},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#base-de-datos","Base de datos",{"_6944":123596,"_42621":123590,"_5":43098,"_30085":201637,"_28538":201638,"_5847":201639},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#endpoints-de-otros-servicios","Endpoints de otros servicios",{"_6944":123597,"_42621":123590,"_5":43098,"_30085":201641,"_28538":201642,"_5847":201643},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#construcción-y-firma","Construcción y firma",{"_6944":123598,"_42621":123590,"_5":43098,"_30085":201645,"_28538":201646,"_5847":201647},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#límites-de-subida","Límites de subida",{"_6944":123599,"_42621":123590,"_5":43098,"_30085":201649,"_28538":201650,"_5847":201651},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#bloques-de-almacenamiento-de-blobs","Bloques de almacenamiento de blobs",{"_6944":123600,"_42621":123590,"_5":43098,"_30085":201653,"_28538":201654,"_5847":201655},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#almacenamiento-storage","Almacenamiento (`*.storage`)",{"_6944":123601,"_42621":123590,"_5":43098,"_30085":201657,"_28538":201658,"_5847":201659},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#cifrado-en-reposo-encryption","Cifrado en reposo (`*.encryption`)",{"_6944":123602,"_42621":123590,"_5":43098,"_30085":201661,"_28538":201662,"_5847":201663},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#descargas-prefirmadas-presign","Descargas prefirmadas (`*.presign`)",{"_6944":123603,"_42621":123590,"_5":43098,"_30085":201665,"_28538":201666,"_5847":201667},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#bloque-hawkbit","Bloque `hawkbit`",{"_6944":123604,"_42621":123590,"_5":43098,"_30085":201669,"_28538":201670,"_5847":201671},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#variables-de-entorno","Variables de entorno",{"_6944":123605,"_42621":123590,"_5":43098,"_30085":201673,"_28538":201674,"_5847":201675},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#configuraciones-mínimas","Configuraciones mínimas",{"_6944":123606,"_42621":123590,"_5":43098,"_30085":201677,"_28538":201678,"_5847":201679},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#symkms-como-proceso-independiente","SymKMS como proceso independiente",{"_6944":123607,"_42621":123590,"_5":43098,"_30085":201681,"_28538":201682,"_5847":201683},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#páginas-relacionadas","Páginas relacionadas",{"_6944":123608,"_42621":123590,"_30085":201685,"_5":21646,"_28538":123590,"_5847":201686},[],"Lamassu Updates lee un único fichero YAML al arrancar. Esta página lista todas las claves que lee el código, su valor por defecto y qué backend (`native` o `hawkbit`) las usa. Las claves que aparecen en los ficheros de ejemplo pero no se leen se indican aparte para que no confíes en ellas.",{"_6944":123609,"_42621":123590,"_30085":201688,"_5":21646,"_28538":201622,"_5847":201689},[],"Indica la ubicación del fichero con la variable de entorno `OTA_CONFIG_FILE`. Si no está definida, el servicio lee `/etc/lamassuiot/config.yml`, que es donde la imagen Docker y el chart de Helm lo montan.",{"_6944":123610,"_42621":123590,"_30085":201691,"_5":21646,"_28538":201622,"_5847":201692},[],"Si `OTA_CONFIG_FILE` apunta a un fichero que no se puede cargar (no existe, o el YAML no es válido), el servicio registra una advertencia y &#x2A;*recurre a `/etc/lamassuiot/config.yml`**. En la imagen Docker esa ruta contiene el `config.yml` de desarrollo del repositorio, así que un error al escribir la ruta puede arrancar el servicio con una configuración equivocada. Si esa alternativa también falla, el servicio termina.",{"_6944":123611,"_42621":123590,"_30085":201694,"_5":21646,"_28538":201622,"_5847":201695},[],"El fichero se lee una sola vez. Reinicia el servicio tras cualquier cambio.",{"_6944":123612,"_42621":123590,"_30085":201697,"_5":21646,"_28538":201622,"_5847":201698},[],"`LAMASSU_CONFIG_FILE`, que definen el Dockerfile y el chart de Helm, no lo lee el código. Solo importa `OTA_CONFIG_FILE`.",{"_6944":123613,"_42621":123590,"_30085":201700,"_5":21646,"_28538":201622,"_5847":201701},[],"Cualquier clave se puede sobrescribir con una variable de entorno. Consulta Variables de entorno.",{"_6944":123614,"_42621":123590,"_30085":201703,"_5":21646,"_28538":201622,"_5847":201704},[],"El repositorio incluye tres ejemplos:",{"_6944":123615,"_42621":123590,"_30085":201706,"_5":21646,"_28538":201622,"_5847":201707},[],"Fichero",{"_6944":123616,"_42621":123590,"_30085":201709,"_5":21646,"_28538":201622,"_5847":201710},[],"Para",{"_6944":123617,"_42621":123590,"_30085":201712,"_5":21646,"_28538":201622,"_5847":92449},[],{"_6944":123618,"_42621":123590,"_30085":201714,"_5":21646,"_28538":201622,"_5847":201715},[],"Desarrollo local en modo `native`",{"_6944":123619,"_42621":123590,"_30085":201717,"_5":21646,"_28538":201622,"_5847":92455},[],{"_6944":123620,"_42621":123590,"_30085":201719,"_5":21646,"_28538":201622,"_5847":201720},[],"El contenedor `updates` de `docker-compose.yml`",{"_6944":123621,"_42621":123590,"_30085":201722,"_5":21646,"_28538":201622,"_5847":92461},[],{"_6944":123622,"_42621":123590,"_30085":201724,"_5":21646,"_28538":201622,"_5847":201725},[],"Desarrollo local en modo `hawkbit` contra el hawkBit del fichero compose (puerto 8090 del host)",{"_6944":123623,"_42621":123590,"_30085":201727,"_5":21646,"_28538":201622,"_5847":201728},[],"Los ejemplos contienen valores de una máquina de desarrollo (rutas absolutas y direcciones de red local) y secretos de desarrollo. Sustitúyelos todos y no reutilices nunca sus claves ni contraseñas.",{"_6944":123624,"_42621":123590,"_30085":201730,"_5":21646,"_28538":201626,"_5847":195516},[],{"_6944":123625,"_42621":123590,"_30085":201732,"_5":21646,"_28538":201626,"_5847":89992},[],{"_6944":123626,"_42621":123590,"_30085":201734,"_5":21646,"_28538":201626,"_5847":87265},[],{"_6944":123627,"_42621":123590,"_30085":201736,"_5":21646,"_28538":201626,"_5847":92476},[],{"_6944":123628,"_42621":123590,"_30085":201738,"_5":21646,"_28538":201626,"_5847":191827},[],{"_6944":123629,"_42621":123590,"_30085":201740,"_5":21646,"_28538":201626,"_5847":191827},[],{"_6944":123630,"_42621":123590,"_30085":201742,"_5":21646,"_28538":201626,"_5847":92483},[],{"_6944":123631,"_42621":123590,"_30085":201744,"_5":21646,"_28538":201626,"_5847":201745},[],"Sí (obligatoria)",{"_6944":123632,"_42621":123590,"_30085":201747,"_5":21646,"_28538":201626,"_5847":201748},[],"Opcional",{"_6944":123633,"_42621":123590,"_30085":201750,"_5":21646,"_28538":201626,"_5847":92492},[],{"_6944":123634,"_42621":123590,"_30085":201752,"_5":21646,"_28538":201626,"_5847":191827},[],{"_6944":123635,"_42621":123590,"_30085":201754,"_5":21646,"_28538":201626,"_5847":201755},[],"Sí, solo para construir o firmar",{"_6944":123636,"_42621":123590,"_30085":201757,"_5":21646,"_28538":201626,"_5847":92500},[],{"_6944":123637,"_42621":123590,"_30085":201759,"_5":21646,"_28538":201626,"_5847":191827},[],{"_6944":123638,"_42621":123590,"_30085":201761,"_5":21646,"_28538":201626,"_5847":201762},[],"Sí, solo para cifrar",{"_6944":123639,"_42621":123590,"_30085":201764,"_5":21646,"_28538":201626,"_5847":92508},[],{"_6944":123640,"_42621":123590,"_30085":201766,"_5":21646,"_28538":201626,"_5847":191827},[],{"_6944":123641,"_42621":123590,"_30085":201768,"_5":21646,"_28538":201626,"_5847":191827},[],{"_6944":123642,"_42621":123590,"_30085":201770,"_5":21646,"_28538":201626,"_5847":92515},[],{"_6944":123643,"_42621":123590,"_30085":201772,"_5":21646,"_28538":201626,"_5847":191827},[],{"_6944":123644,"_42621":123590,"_30085":201774,"_5":21646,"_28538":201626,"_5847":82222},[],{"_6944":123645,"_42621":123590,"_30085":201776,"_5":21646,"_28538":201626,"_5847":92522},[],{"_6944":123646,"_42621":123590,"_30085":201778,"_5":21646,"_28538":201626,"_5847":191827},[],{"_6944":123647,"_42621":123590,"_30085":201780,"_5":21646,"_28538":201626,"_5847":82222},[],{"_6944":123648,"_42621":123590,"_30085":201782,"_5":21646,"_28538":201626,"_5847":92529},[],{"_6944":123649,"_42621":123590,"_30085":201784,"_5":21646,"_28538":201626,"_5847":191827},[],{"_6944":123650,"_42621":123590,"_30085":201786,"_5":21646,"_28538":201626,"_5847":82222},[],{"_6944":123651,"_42621":123590,"_30085":201788,"_5":21646,"_28538":201626,"_5847":87265},[],{"_6944":123652,"_42621":123590,"_30085":201790,"_5":21646,"_28538":201626,"_5847":82222},[],{"_6944":123653,"_42621":123590,"_30085":201792,"_5":21646,"_28538":201626,"_5847":201745},[],{"_6944":123654,"_42621":123590,"_30085":201794,"_5":21646,"_28538":201626,"_5847":92542},[],{"_6944":123655,"_42621":123590,"_30085":201796,"_5":21646,"_28538":201626,"_5847":82222},[],{"_6944":123656,"_42621":123590,"_30085":201798,"_5":21646,"_28538":201626,"_5847":191827},[],{"_6944":123657,"_42621":123590,"_30085":201800,"_5":21646,"_28538":201626,"_5847":201801},[],"`mode` vale `native` cuando está vacío o contiene cualquier valor distinto de `hawkbit`.",{"_6944":123658,"_42621":123590,"_30085":201803,"_5":21646,"_28538":201630,"_5847":195516},[],{"_6944":123659,"_42621":123590,"_30085":201805,"_5":21646,"_28538":201630,"_5847":191814},[],{"_6944":123660,"_42621":123590,"_30085":201807,"_5":21646,"_28538":201630,"_5847":199298},[],{"_6944":123661,"_42621":123590,"_30085":201809,"_5":21646,"_28538":201630,"_5847":191820},[],{"_6944":123662,"_42621":123590,"_30085":201811,"_5":21646,"_28538":201630,"_5847":92560},[],{"_6944":123663,"_42621":123590,"_30085":201813,"_5":21646,"_28538":201630,"_5847":125353},[],{"_6944":123664,"_42621":123590,"_30085":201815,"_5":21646,"_28538":201630,"_5847":201816},[],"vacío (`native`)",{"_6944":123665,"_42621":123590,"_30085":201818,"_5":21646,"_28538":201630,"_5847":201819},[],"`native` o `hawkbit`. Consulta Modo hawkBit.",{"_6944":123666,"_42621":123590,"_30085":201821,"_5":21646,"_28538":201630,"_5847":92571},[],{"_6944":123667,"_42621":123590,"_30085":201823,"_5":21646,"_28538":201630,"_5847":125353},[],{"_6944":123668,"_42621":123590,"_30085":201825,"_5":21646,"_28538":201630,"_5847":92576},[],{"_6944":123669,"_42621":123590,"_30085":201827,"_5":21646,"_28538":201630,"_5847":201828},[],"`trace`, `debug`, `info`, `warn`, `error`, `fatal` o `none` (sin distinguir mayúsculas). Un valor no reconocido se convierte en `info`. Con `info`, el registro de arranque muestra una advertencia inofensiva de «unknown log level». `none` descarta toda la salida de registro.",{"_6944":123670,"_42621":123590,"_30085":201830,"_5":21646,"_28538":201630,"_5847":92582},[],{"_6944":123671,"_42621":123590,"_30085":201832,"_5":21646,"_28538":201630,"_5847":125353},[],{"_6944":123672,"_42621":123590,"_30085":201834,"_5":21646,"_28538":201630,"_5847":201835},[],"vacío (todas las interfaces)",{"_6944":123673,"_42621":123590,"_30085":201837,"_5":21646,"_28538":201630,"_5847":201838},[],"Dirección en la que escuchar. Los ejemplos usan `0.0.0.0`.",{"_6944":123674,"_42621":123590,"_30085":201840,"_5":21646,"_28538":201630,"_5847":92593},[],{"_6944":123675,"_42621":123590,"_30085":201842,"_5":21646,"_28538":201630,"_5847":132393},[],{"_6944":123676,"_42621":123590,"_30085":201844,"_5":21646,"_28538":201630,"_5847":201845},[],"ninguno (obligatorio)",{"_6944":123677,"_42621":123590,"_30085":201847,"_5":21646,"_28538":201630,"_5847":201848},[],"Puerto HTTP. `0` elige un puerto aleatorio. Los ejemplos y el chart usan `10090`.",{"_6944":123678,"_42621":123590,"_30085":201850,"_5":21646,"_28538":201630,"_5847":92604},[],{"_6944":123679,"_42621":123590,"_30085":201852,"_5":21646,"_28538":201630,"_5847":201853},[],"duración",{"_6944":123680,"_42621":123590,"_30085":201855,"_5":21646,"_28538":201630,"_5847":92609},[],{"_6944":123681,"_42621":123590,"_30085":201857,"_5":21646,"_28538":201630,"_5847":201858},[],"Cuánto esperar a las peticiones en curso tras `SIGTERM` o `SIGINT`. Mantenlo por debajo del periodo de gracia de terminación del pod (el chart fija 120 s).",{"_6944":123682,"_42621":123590,"_30085":201860,"_5":21646,"_28538":201630,"_5847":92615},[],{"_6944":123683,"_42621":123590,"_30085":201862,"_5":21646,"_28538":201630,"_5847":157664},[],{"_6944":123684,"_42621":123590,"_30085":201864,"_5":21646,"_28538":201630,"_5847":92620},[],{"_6944":123685,"_42621":123590,"_30085":201866,"_5":21646,"_28538":201630,"_5847":201867},[],"Registra `PUT /updates/v1/jobs/:jobID/transition`, que falsifica un cambio de estado de un trabajo sin comprobar propiedad. Úsalo solo en pruebas; mantenlo en `false` en cualquier otro sitio.",{"_6944":123686,"_42621":123590,"_30085":201869,"_5":21646,"_28538":201630,"_5847":201870},[],"El servicio sirve siempre HTTP sin cifrar. Estas claves existen en las estructuras de configuración y en los ficheros de ejemplo pero **no se leen**, así que definirlas no tiene efecto: `app.server.protocol`, `app.server.log_level`, `app.server.health_check` (y el `health_check_logging` de los ejemplos), `app.server.cert_file`, `app.server.key_file` y `app.server.authentication.mutual_tls.*`. Termina TLS delante del servicio. Consulta Seguridad.",{"_6944":123687,"_42621":123590,"_30085":201872,"_5":21646,"_28538":201634,"_5847":195516},[],{"_6944":123688,"_42621":123590,"_30085":201874,"_5":21646,"_28538":201634,"_5847":191814},[],{"_6944":123689,"_42621":123590,"_30085":201876,"_5":21646,"_28538":201634,"_5847":199298},[],{"_6944":123690,"_42621":123590,"_30085":201878,"_5":21646,"_28538":201634,"_5847":191820},[],{"_6944":123691,"_42621":123590,"_30085":201880,"_5":21646,"_28538":201634,"_5847":92637},[],{"_6944":123692,"_42621":123590,"_30085":201882,"_5":21646,"_28538":201634,"_5847":125353},[],{"_6944":123693,"_42621":123590,"_30085":201884,"_5":21646,"_28538":201634,"_5847":155402},[],{"_6944":123694,"_42621":123590,"_30085":201886,"_5":21646,"_28538":201634,"_5847":201887},[],"Solo existe `postgres`. El valor no se comprueba.",{"_6944":123695,"_42621":123590,"_30085":201889,"_5":21646,"_28538":201634,"_5847":92647},[],{"_6944":123696,"_42621":123590,"_30085":201891,"_5":21646,"_28538":201634,"_5847":125353},[],{"_6944":123697,"_42621":123590,"_30085":201893,"_5":21646,"_28538":201634,"_5847":201845},[],{"_6944":123698,"_42621":123590,"_30085":201895,"_5":21646,"_28538":201634,"_5847":201896},[],"Host de Postgres. En modo `hawkbit` el arranque falla si está vacío.",{"_6944":123699,"_42621":123590,"_30085":201898,"_5":21646,"_28538":201634,"_5847":92657},[],{"_6944":123700,"_42621":123590,"_30085":201900,"_5":21646,"_28538":201634,"_5847":132393},[],{"_6944":123701,"_42621":123590,"_30085":201902,"_5":21646,"_28538":201634,"_5847":201845},[],{"_6944":123702,"_42621":123590,"_30085":201904,"_5":21646,"_28538":201634,"_5847":201905},[],"Puerto de Postgres. No hay valor por defecto.",{"_6944":123703,"_42621":123590,"_30085":201907,"_5":21646,"_28538":201634,"_5847":92667},[],{"_6944":123704,"_42621":123590,"_30085":201909,"_5":21646,"_28538":201634,"_5847":125353},[],{"_6944":123705,"_42621":123590,"_30085":201911,"_5":21646,"_28538":201634,"_5847":155402},[],{"_6944":123706,"_42621":123590,"_30085":201913,"_5":21646,"_28538":201634,"_5847":201914},[],"Credenciales.",{"_6944":123707,"_42621":123590,"_30085":201916,"_5":21646,"_28538":201634,"_5847":92677},[],{"_6944":123708,"_42621":123590,"_30085":201918,"_5":21646,"_28538":201634,"_5847":125353},[],{"_6944":123709,"_42621":123590,"_30085":201920,"_5":21646,"_28538":201634,"_5847":92576},[],{"_6944":123710,"_42621":123590,"_30085":201922,"_5":21646,"_28538":201634,"_5847":201923},[],"Nivel de registro de la capa de base de datos. Las sentencias SQL se registran en `trace`.",{"_6944":123711,"_42621":123590,"_30085":201925,"_5":21646,"_28538":201634,"_5847":201926},[],"El nombre de la base de datos está fijado en &#x2A;*`updates`**. No hay clave para cambiarlo. El servicio crea sus tablas y las migra al arrancar, pero no crea la base de datos: crea `updates` antes. En Docker Compose, `init.sql` crea `updates` y `hawkbit`, y `POSTGRES_DB` crea `wfx`.",{"_6944":123712,"_42621":123590,"_30085":201928,"_5":21646,"_28538":201634,"_5847":201929},[],"La conexión usa `sslmode=disable`. No hay forma de activar TLS hacia Postgres desde la configuración. Mantén la base de datos en una red privada.",{"_6944":123713,"_42621":123590,"_30085":201931,"_5":21646,"_28538":201634,"_5847":201932},[],"Cada proceso mantiene como máximo 25 conexiones abiertas y 10 inactivas (las conexiones se reciclan a los 30 minutos, o a los 5 minutos de inactividad). Calcula `25 x réplicas` frente al `max_connections` de Postgres.",{"_6944":123714,"_42621":123590,"_30085":201934,"_5":21646,"_28538":201638,"_5847":195516},[],{"_6944":123715,"_42621":123590,"_30085":201936,"_5":21646,"_28538":201638,"_5847":199298},[],{"_6944":123716,"_42621":123590,"_30085":201938,"_5":21646,"_28538":201638,"_5847":201939},[],"Modo",{"_6944":123717,"_42621":123590,"_30085":201941,"_5":21646,"_28538":201638,"_5847":191820},[],{"_6944":123718,"_42621":123590,"_30085":201943,"_5":21646,"_28538":201638,"_5847":92483},[],{"_6944":123719,"_42621":123590,"_30085":201945,"_5":21646,"_28538":201638,"_5847":155402},[],{"_6944":123720,"_42621":123590,"_30085":201947,"_5":21646,"_28538":201638,"_5847":201948},[],"Obligatoria en `native`, opcional en `hawkbit`",{"_6944":123721,"_42621":123590,"_30085":201950,"_5":21646,"_28538":201638,"_5847":201951},[],"URL base de la API Device Manager de Lamassu, por ejemplo `http://host:8080/api/devmanager`. Es el origen de los grupos de dispositivos. Sin ella en modo `hawkbit`, los grupos se leen de las etiquetas `group:<id>` de los targets de hawkBit. El servicio envía `X-Principal-ID: admin-mode` en estas llamadas.",{"_6944":123722,"_42621":123590,"_30085":201953,"_5":21646,"_28538":201638,"_5847":92715},[],{"_6944":123723,"_42621":123590,"_30085":201955,"_5":21646,"_28538":201638,"_5847":155402},[],{"_6944":123724,"_42621":123590,"_30085":201957,"_5":21646,"_28538":201638,"_5847":195767},[],{"_6944":123725,"_42621":123590,"_30085":201959,"_5":21646,"_28538":201638,"_5847":201960},[],"URL base de la API KMS de Lamassu, por ejemplo `http://host:8080/api/kms/v1`. Necesaria para firmar. Consulta Firma y cifrado.",{"_6944":123726,"_42621":123590,"_30085":201962,"_5":21646,"_28538":201638,"_5847":92725},[],{"_6944":123727,"_42621":123590,"_30085":201964,"_5":21646,"_28538":201638,"_5847":155402},[],{"_6944":123728,"_42621":123590,"_30085":201966,"_5":21646,"_28538":201638,"_5847":195767},[],{"_6944":123729,"_42621":123590,"_30085":201968,"_5":21646,"_28538":201638,"_5847":201969},[],"URL base de SymKMS, **sin** la ruta `/symkms/v1`. En el monolito apunta al propio servicio (por ejemplo `http://localhost:10090`) y debe coincidir con `app.server.port`. Vacío significa que se rechaza el cifrado.",{"_6944":123730,"_42621":123590,"_30085":201971,"_5":21646,"_28538":201638,"_5847":92735},[],{"_6944":123731,"_42621":123590,"_30085":201973,"_5":21646,"_28538":201638,"_5847":155402},[],{"_6944":123732,"_42621":123590,"_30085":201975,"_5":21646,"_28538":201638,"_5847":89992},[],{"_6944":123733,"_42621":123590,"_30085":201977,"_5":21646,"_28538":201638,"_5847":201978},[],"URL base de la API de **gestión** de WFX (puerto `8081` dentro de la red de Compose, `9081` en el host). El servicio añade `/api/wfx/v1/`. El arranque falla si no se puede alcanzar WFX. Los dispositivos usan el puerto de cliente de WFX.",{"_6944":123734,"_42621":123590,"_30085":201980,"_5":21646,"_28538":201638,"_5847":92745},[],{"_6944":123735,"_42621":123590,"_30085":201982,"_5":21646,"_28538":201638,"_5847":155402},[],{"_6944":123736,"_42621":123590,"_30085":201984,"_5":21646,"_28538":201638,"_5847":89992},[],{"_6944":123737,"_42621":123590,"_30085":201986,"_5":21646,"_28538":201638,"_5847":201987},[],"URL base pública que usan los dispositivos para descargar compilaciones, por ejemplo `http://updates:10090/updates/v1/`. **Debe terminar en `/updates/v1/`, con la barra final**: el servicio añade `groups/...` directamente y guarda el resultado como URI del paquete. Debe ser alcanzable desde los dispositivos.",{"_6944":123738,"_42621":123590,"_30085":201989,"_5":21646,"_28538":201642,"_5847":195516},[],{"_6944":123739,"_42621":123590,"_30085":201991,"_5":21646,"_28538":201642,"_5847":199298},[],{"_6944":123740,"_42621":123590,"_30085":201993,"_5":21646,"_28538":201642,"_5847":201939},[],{"_6944":123741,"_42621":123590,"_30085":201995,"_5":21646,"_28538":201642,"_5847":191820},[],{"_6944":123742,"_42621":123590,"_30085":201997,"_5":21646,"_28538":201642,"_5847":89321},[],{"_6944":123743,"_42621":123590,"_30085":201999,"_5":21646,"_28538":201642,"_5847":202000},[],"`swugenerator` en el `PATH` en `native`; sin definir en `hawkbit`",{"_6944":123744,"_42621":123590,"_30085":202002,"_5":21646,"_28538":201642,"_5847":195767},[],{"_6944":123745,"_42621":123590,"_30085":202004,"_5":21646,"_28538":201642,"_5847":202005},[],"Ruta del binario `swugenerator`. En modo `hawkbit` el constructor de SWU existe solo si se define: sin ella, los módulos `swu-build` no se pueden construir (`501`). Las construcciones de módulos raw no la necesitan.",{"_6944":123746,"_42621":123590,"_30085":202007,"_5":21646,"_28538":201642,"_5847":92773},[],{"_6944":123747,"_42621":123590,"_30085":202009,"_5":21646,"_28538":201642,"_5847":155402},[],{"_6944":123748,"_42621":123590,"_30085":202011,"_5":21646,"_28538":201642,"_5847":195767},[],{"_6944":123749,"_42621":123590,"_30085":202013,"_5":21646,"_28538":201642,"_5847":202014},[],"El script firmante que llama swugenerator para firmar un `.swu`, `sign_kms.sh` (`/app/sign_kms.sh` en la imagen). Firmar un `.swu` necesita esta clave y `kms_endpoint`; el servicio rechaza una petición de firma cuando falta alguna de las dos.",{"_6944":123750,"_42621":123590,"_30085":202016,"_5":21646,"_28538":201642,"_5847":92783},[],{"_6944":123751,"_42621":123590,"_30085":202018,"_5":21646,"_28538":201642,"_5847":202019},[],"`wfx.workflow.dau.direct.yml` (relativo al directorio de trabajo)",{"_6944":123752,"_42621":123590,"_30085":202021,"_5":21646,"_28538":201642,"_5847":89992},[],{"_6944":123753,"_42621":123590,"_30085":202023,"_5":21646,"_28538":201642,"_5847":202024},[],"Ruta del workflow `direct` de WFX. El nombre &#x2A;*debe contener `direct`**: los ficheros `phased`, `download-install` y `simple` se localizan sustituyendo esa palabra en la ruta, y el arranque falla en caso contrario. El servicio sube al arrancar los workflows que falten en WFX.",{"_6944":123754,"_42621":123590,"_30085":202026,"_5":21646,"_28538":201642,"_5847":92794},[],{"_6944":123755,"_42621":123590,"_30085":202028,"_5":21646,"_28538":201642,"_5847":155402},[],{"_6944":123756,"_42621":123590,"_30085":202030,"_5":21646,"_28538":201642,"_5847":89992},[],{"_6944":123757,"_42621":123590,"_30085":202032,"_5":21646,"_28538":201642,"_5847":202033},[],"Directorio base para el espacio temporal de construcción (`in/`) y, hasta que las compilaciones se publican en el almacén `builds`, las salidas de compilación (`out/`). También proporciona el `local_dir` por defecto de `artifacts` y `builds`.",{"_6944":123758,"_42621":123590,"_30085":202035,"_5":21646,"_28538":201642,"_5847":92804},[],{"_6944":123759,"_42621":123590,"_30085":202037,"_5":21646,"_28538":201642,"_5847":155402},[],{"_6944":123760,"_42621":123590,"_30085":202039,"_5":21646,"_28538":201642,"_5847":195767},[],{"_6944":123761,"_42621":123590,"_30085":202041,"_5":21646,"_28538":201642,"_5847":202042},[],"Directorio alternativo para el almacén de claves de SymKMS cuando `symkms.storage.local_dir` está vacío.",{"_6944":123762,"_42621":123590,"_30085":202044,"_5":21646,"_28538":201642,"_5847":92542},[],{"_6944":123763,"_42621":123590,"_30085":202046,"_5":21646,"_28538":201642,"_5847":202047},[],"`0` (sin comprobación)",{"_6944":123764,"_42621":123590,"_30085":202049,"_5":21646,"_28538":201642,"_5847":87265},[],{"_6944":123765,"_42621":123590,"_30085":202051,"_5":21646,"_28538":201642,"_5847":202052},[],"Rechaza una construcción que cifraría un fichero en memoria (unas dos veces su tamaño) por encima de este límite, en MiB, antes de que el proceso muera por falta de memoria.",{"_6944":123766,"_42621":123590,"_30085":202054,"_5":21646,"_28538":201646,"_5847":195516},[],{"_6944":123767,"_42621":123590,"_30085":202056,"_5":21646,"_28538":201646,"_5847":191814},[],{"_6944":123768,"_42621":123590,"_30085":202058,"_5":21646,"_28538":201646,"_5847":199298},[],{"_6944":123769,"_42621":123590,"_30085":202060,"_5":21646,"_28538":201646,"_5847":191820},[],{"_6944":123770,"_42621":123590,"_30085":202062,"_5":21646,"_28538":201646,"_5847":92832},[],{"_6944":123771,"_42621":123590,"_30085":202064,"_5":21646,"_28538":201646,"_5847":132393},[],{"_6944":123772,"_42621":123590,"_30085":202066,"_5":21646,"_28538":201646,"_5847":92837},[],{"_6944":123773,"_42621":123590,"_30085":202068,"_5":21646,"_28538":201646,"_5847":202069},[],"Mayor fichero individual subido en MiB: artefacto o `.swu` precompilado. Un fichero multipart mayor recibe `413` con el mensaje `file \"<name>\" is <n> MiB; the maximum upload size is <m> MiB`. El límite del cuerpo HTTP es este valor más 1 MiB. Los valores `0` o menores equivalen al valor por defecto.",{"_6944":123774,"_42621":123590,"_30085":202071,"_5":21646,"_28538":201646,"_5847":202072},[],"Las subidas se transmiten en streaming: la memoria no crece con el fichero, pero cada subida en curso se escribe primero en un fichero temporal bajo `TMPDIR` (por defecto `/tmp`), así que necesita ese espacio libre en disco. Cualquier proxy delante del servicio debe aceptar el mismo tamaño y mantener la conexión abierta: los tiempos de lectura y escritura son de 6 horas y las conexiones inactivas se cierran a los 5 minutos. Consulta Operaciones.",{"_6944":123775,"_42621":123590,"_30085":202074,"_5":21646,"_28538":201650,"_5847":202075},[],"Cuatro bloques comparten un mismo formato, de modo que artefactos, salidas de compilación y material de claves pueden vivir cada uno en disco local o en S3:",{"_6944":123776,"_42621":123590,"_30085":202077,"_5":21646,"_28538":201650,"_5847":192980},[],{"_6944":123777,"_42621":123590,"_30085":202079,"_5":21646,"_28538":201650,"_5847":201939},[],{"_6944":123778,"_42621":123590,"_30085":202081,"_5":21646,"_28538":201650,"_5847":196247},[],{"_6944":123779,"_42621":123590,"_30085":202083,"_5":21646,"_28538":201650,"_5847":199298},[],{"_6944":123780,"_42621":123590,"_30085":202085,"_5":21646,"_28538":201650,"_5847":91291},[],{"_6944":123781,"_42621":123590,"_30085":202087,"_5":21646,"_28538":201650,"_5847":89992},[],{"_6944":123782,"_42621":123590,"_30085":202089,"_5":21646,"_28538":201650,"_5847":202090},[],"Binarios de artefactos subidos",{"_6944":123783,"_42621":123590,"_30085":202092,"_5":21646,"_28538":201650,"_5847":92865},[],{"_6944":123784,"_42621":123590,"_30085":202094,"_5":21646,"_28538":201650,"_5847":92868},[],{"_6944":123785,"_42621":123590,"_30085":202096,"_5":21646,"_28538":201650,"_5847":89992},[],{"_6944":123786,"_42621":123590,"_30085":202098,"_5":21646,"_28538":201650,"_5847":202099},[],"Salidas de compilación que descargan los dispositivos: `.swu` y `.tar.gz`",{"_6944":123787,"_42621":123590,"_30085":202101,"_5":21646,"_28538":201650,"_5847":92876},[],{"_6944":123788,"_42621":123590,"_30085":202103,"_5":21646,"_28538":201650,"_5847":92879},[],{"_6944":123789,"_42621":123590,"_30085":202105,"_5":21646,"_28538":201650,"_5847":195767},[],{"_6944":123790,"_42621":123590,"_30085":202107,"_5":21646,"_28538":201650,"_5847":202108},[],"Claves simétricas y asignaciones de claves a dispositivos",{"_6944":123791,"_42621":123590,"_30085":202110,"_5":21646,"_28538":201650,"_5847":202111},[],"Local, `sym_keys_dir`, o `data` relativo al directorio de trabajo si ambos están vacíos",{"_6944":123792,"_42621":123590,"_30085":202113,"_5":21646,"_28538":201650,"_5847":86185},[],{"_6944":123793,"_42621":123590,"_30085":202115,"_5":21646,"_28538":201650,"_5847":87265},[],{"_6944":123794,"_42621":123590,"_30085":202117,"_5":21646,"_28538":201650,"_5847":202118},[],"Solo lectura, para firmar URLs de descarga del bucket S3 de hawkBit (consulta el bloque `hawkbit`)",{"_6944":123795,"_42621":123590,"_30085":202120,"_5":21646,"_28538":201650,"_5847":199415},[],{"_6944":123796,"_42621":123590,"_30085":202122,"_5":21646,"_28538":201654,"_5847":195516},[],{"_6944":123797,"_42621":123590,"_30085":202124,"_5":21646,"_28538":201654,"_5847":199298},[],{"_6944":123798,"_42621":123590,"_30085":202126,"_5":21646,"_28538":201654,"_5847":191820},[],{"_6944":123799,"_42621":123590,"_30085":202128,"_5":21646,"_28538":201654,"_5847":87447},[],{"_6944":123800,"_42621":123590,"_30085":202130,"_5":21646,"_28538":201654,"_5847":92907},[],{"_6944":123801,"_42621":123590,"_30085":202132,"_5":21646,"_28538":201654,"_5847":202133},[],"`local` o `s3`.",{"_6944":123802,"_42621":123590,"_30085":202135,"_5":21646,"_28538":201654,"_5847":92913},[],{"_6944":123803,"_42621":123590,"_30085":202137,"_5":21646,"_28538":201654,"_5847":202138},[],"valor por defecto del bloque, arriba",{"_6944":123804,"_42621":123590,"_30085":202140,"_5":21646,"_28538":201654,"_5847":202141},[],"Directorio para `local`. Se crea con modo `0700`.",{"_6944":123805,"_42621":123590,"_30085":202143,"_5":21646,"_28538":201654,"_5847":92922},[],{"_6944":123806,"_42621":123590,"_30085":202145,"_5":21646,"_28538":201654,"_5847":155402},[],{"_6944":123807,"_42621":123590,"_30085":202147,"_5":21646,"_28538":201654,"_5847":202148},[],"Obligatorio para `s3`. El bucket debe existir: el servicio comprueba el acceso al arrancar y se detiene si falla (`S3 bucket \"x\" is not accessible at ...`).",{"_6944":123808,"_42621":123590,"_30085":202150,"_5":21646,"_28538":201654,"_5847":92930},[],{"_6944":123809,"_42621":123590,"_30085":202152,"_5":21646,"_28538":201654,"_5847":92933},[],{"_6944":123810,"_42621":123590,"_30085":202154,"_5":21646,"_28538":201654,"_5847":202155},[],"Región de AWS.",{"_6944":123811,"_42621":123590,"_30085":202157,"_5":21646,"_28538":201654,"_5847":92939},[],{"_6944":123812,"_42621":123590,"_30085":202159,"_5":21646,"_28538":201654,"_5847":202160},[],"vacío (AWS)",{"_6944":123813,"_42621":123590,"_30085":202162,"_5":21646,"_28538":201654,"_5847":202163},[],"URL de un almacén compatible con S3, como RustFS o MinIO.",{"_6944":123814,"_42621":123590,"_30085":202165,"_5":21646,"_28538":201654,"_5847":92948},[],{"_6944":123815,"_42621":123590,"_30085":202167,"_5":21646,"_28538":201654,"_5847":92620},[],{"_6944":123816,"_42621":123590,"_30085":202169,"_5":21646,"_28538":201654,"_5847":202170},[],"Direcciona los buckets como `<endpoint>/<bucket>`. La mayoría de los almacenes autoalojados necesitan `true`.",{"_6944":123817,"_42621":123590,"_30085":202172,"_5":21646,"_28538":201654,"_5847":92956},[],{"_6944":123818,"_42621":123590,"_30085":202174,"_5":21646,"_28538":201654,"_5847":202175},[],"vacío",{"_6944":123819,"_42621":123590,"_30085":202177,"_5":21646,"_28538":201654,"_5847":202178},[],"Mantiene todas las claves bajo una «carpeta» del bucket. Un mismo bucket puede contener varios almacenes, incluidos los artefactos de hawkBit. Se añade la `/` final si falta.",{"_6944":123820,"_42621":123590,"_30085":202180,"_5":21646,"_28538":201654,"_5847":92964},[],{"_6944":123821,"_42621":123590,"_30085":202182,"_5":21646,"_28538":201654,"_5847":155402},[],{"_6944":123822,"_42621":123590,"_30085":202184,"_5":21646,"_28538":201654,"_5847":202185},[],"Credenciales estáticas. Define ambas o ninguna.",{"_6944":123823,"_42621":123590,"_30085":202187,"_5":21646,"_28538":201654,"_5847":92972},[],{"_6944":123824,"_42621":123590,"_30085":202189,"_5":21646,"_28538":201654,"_5847":155402},[],{"_6944":123825,"_42621":123590,"_30085":202191,"_5":21646,"_28538":201654,"_5847":202192},[],"Las mismas credenciales leídas de ficheros, por ejemplo un Secret de Kubernetes montado. Se releen cada minuto, así que rotar el Secret no exige reiniciar. Define ambas o ninguna, y no junto con el par en línea.",{"_6944":123826,"_42621":123590,"_30085":202194,"_5":21646,"_28538":201654,"_5847":202195},[],"Sin credenciales definidas se aplica la cadena de credenciales por defecto de AWS (entorno, IRSA, perfil de instancia).",{"_6944":123827,"_42621":123590,"_30085":202197,"_5":21646,"_28538":201658,"_5847":195516},[],{"_6944":123828,"_42621":123590,"_30085":202199,"_5":21646,"_28538":201658,"_5847":199298},[],{"_6944":123829,"_42621":123590,"_30085":202201,"_5":21646,"_28538":201658,"_5847":191820},[],{"_6944":123830,"_42621":123590,"_30085":202203,"_5":21646,"_28538":201658,"_5847":87447},[],{"_6944":123831,"_42621":123590,"_30085":202205,"_5":21646,"_28538":201658,"_5847":92991},[],{"_6944":123832,"_42621":123590,"_30085":202207,"_5":21646,"_28538":201658,"_5847":202208},[],"`none`, `local` o `awskms`.",{"_6944":123833,"_42621":123590,"_30085":202210,"_5":21646,"_28538":201658,"_5847":92997},[],{"_6944":123834,"_42621":123590,"_30085":202212,"_5":21646,"_28538":201658,"_5847":155402},[],{"_6944":123835,"_42621":123590,"_30085":202214,"_5":21646,"_28538":201658,"_5847":202215},[],"Obligatoria para `local`: una clave de 32 bytes codificada en hexadecimal.",{"_6944":123836,"_42621":123590,"_30085":202217,"_5":21646,"_28538":201658,"_5847":93005},[],{"_6944":123837,"_42621":123590,"_30085":202219,"_5":21646,"_28538":201658,"_5847":155402},[],{"_6944":123838,"_42621":123590,"_30085":202221,"_5":21646,"_28538":201658,"_5847":202222},[],"Obligatoria para `awskms`: ARN o alias de la clave.",{"_6944":123839,"_42621":123590,"_30085":202224,"_5":21646,"_28538":201658,"_5847":93013},[],{"_6944":123840,"_42621":123590,"_30085":202226,"_5":21646,"_28538":201658,"_5847":92933},[],{"_6944":123841,"_42621":123590,"_30085":202228,"_5":21646,"_28538":201658,"_5847":202229},[],"Región de la clave de AWS KMS.",{"_6944":123842,"_42621":123590,"_30085":202231,"_5":21646,"_28538":201658,"_5847":202232},[],"Un objeto cifrado se cifra y descifra entero, en memoria: con cifrado en reposo, leer o escribir un artefacto de 10 GiB necesita esa misma memoria, y los rangos de bytes se cortan de la copia descifrada. Un almacén con el cifrado activado no puede usar descargas prefirmadas. Para ficheros grandes, es preferible cifrar en el propio almacén (por ejemplo, con cifrado del lado del servidor de S3).",{"_6944":123843,"_42621":123590,"_30085":202234,"_5":21646,"_28538":201662,"_5847":202235},[],"Con almacenamiento S3, una descarga puede responderse con `302` a una URL firmada de corta duración del almacén, en lugar de transmitir los bytes a través del servicio. Antes se autoriza al solicitante, como en cualquier descarga. El modo `native` firma las salidas de compilación (`builds.presign`); el modo `hawkbit` firma los objetos del plugin S3 de hawkBit (`hawkbit.artifact_store.presign`). Las descargas de artefactos por ID en modo `native` siempre se transmiten a través del servicio.",{"_6944":123844,"_42621":123590,"_30085":202237,"_5":21646,"_28538":201662,"_5847":195516},[],{"_6944":123845,"_42621":123590,"_30085":202239,"_5":21646,"_28538":201662,"_5847":199298},[],{"_6944":123846,"_42621":123590,"_30085":202241,"_5":21646,"_28538":201662,"_5847":191820},[],{"_6944":123847,"_42621":123590,"_30085":202243,"_5":21646,"_28538":201662,"_5847":93033},[],{"_6944":123848,"_42621":123590,"_30085":202245,"_5":21646,"_28538":201662,"_5847":92620},[],{"_6944":123849,"_42621":123590,"_30085":202247,"_5":21646,"_28538":201662,"_5847":202248},[],"Activa la función.",{"_6944":123850,"_42621":123590,"_30085":202250,"_5":21646,"_28538":201662,"_5847":93041},[],{"_6944":123851,"_42621":123590,"_30085":202252,"_5":21646,"_28538":201662,"_5847":202253},[],"el `s3_endpoint` del almacenamiento",{"_6944":123852,"_42621":123590,"_30085":202255,"_5":21646,"_28538":201662,"_5847":202256},[],"Origen del almacén **tal como lo alcanzan los dispositivos**, sin ruta (por ejemplo, el gateway que publica el bucket). Es lo que se firma: la firma cubre la cabecera `Host`, así que una URL firmada para una dirección interna del clúster se rechaza cuando un dispositivo la usa a través del gateway. Obligatoria salvo que los dispositivos alcancen el almacén en su propio endpoint (por ejemplo, AWS S3).",{"_6944":123853,"_42621":123590,"_30085":202258,"_5":21646,"_28538":201662,"_5847":93050},[],{"_6944":123854,"_42621":123590,"_30085":202260,"_5":21646,"_28538":201662,"_5847":92609},[],{"_6944":123855,"_42621":123590,"_30085":202262,"_5":21646,"_28538":201662,"_5847":202263},[],"Cuánto tiempo puede una URL **iniciar** una descarga. Entre `1s` y 7 días. Una transferencia ya en curso no se corta al caducar.",{"_6944":123856,"_42621":123590,"_30085":202265,"_5":21646,"_28538":201662,"_5847":93058},[],{"_6944":123857,"_42621":123590,"_30085":202267,"_5":21646,"_28538":201662,"_5847":93061},[],{"_6944":123858,"_42621":123590,"_30085":202269,"_5":21646,"_28538":201662,"_5847":202270},[],"Una URL ya firmada para el mismo objeto se entrega de nuevo mientras le quede al menos esta validez, de modo que un reintento o una reanudación nunca recibe una URL a punto de caducar. Un valor negativo firma una URL nueva en cada petición. Debe ser menor que `ttl`.",{"_6944":123859,"_42621":123590,"_30085":202272,"_5":21646,"_28538":201662,"_5847":202273},[],"`access_key_id`, `secret_access_key` (o las variantes `_file`)",{"_6944":123860,"_42621":123590,"_30085":202275,"_5":21646,"_28538":201662,"_5847":155402},[],{"_6944":123861,"_42621":123590,"_30085":202277,"_5":21646,"_28538":201662,"_5847":202278},[],"La credencial que firma. &#x2A;*Obligatoria, y debe ser una credencial de solo lectura distinta de la del almacenamiento.**",{"_6944":123862,"_42621":123590,"_30085":202280,"_5":21646,"_28538":201662,"_5847":202281},[],"Al arrancar, el servicio se niega a ejecutarse si la credencial de firma es la del almacenamiento, si puede escribir en el bucket (lo comprueba intentando una escritura), si el almacén la rechaza (espera hasta 2 minutos a que el almacén la acepte) o si `encryption.type` no es `none` (los dispositivos recibirían texto cifrado). Si no se puede consultar el almacén en absoluto, registra una advertencia y continúa. El dispositivo debe poder resolver y alcanzar `public_endpoint`. Consulta Seguridad.",{"_6944":123863,"_42621":123590,"_30085":202283,"_5":21646,"_28538":201666,"_5847":202284},[],"Se usa solo cuando `mode: hawkbit`.",{"_6944":123864,"_42621":123590,"_30085":202286,"_5":21646,"_28538":201666,"_5847":195516},[],{"_6944":123865,"_42621":123590,"_30085":202288,"_5":21646,"_28538":201666,"_5847":199298},[],{"_6944":123866,"_42621":123590,"_30085":202290,"_5":21646,"_28538":201666,"_5847":191820},[],{"_6944":123867,"_42621":123590,"_30085":202292,"_5":21646,"_28538":201666,"_5847":93087},[],{"_6944":123868,"_42621":123590,"_30085":202294,"_5":21646,"_28538":201666,"_5847":202295},[],"ninguno (obligatoria)",{"_6944":123869,"_42621":123590,"_30085":202297,"_5":21646,"_28538":201666,"_5847":202298},[],"Raíz de la API de gestión de hawkBit, por ejemplo `http://hawkbit:8080`. El arranque falla si está vacía. Las llamadas caducan a los 30 s; las transferencias de artefactos, a las 6 h.",{"_6944":123870,"_42621":123590,"_30085":202300,"_5":21646,"_28538":201666,"_5847":93095},[],{"_6944":123871,"_42621":123590,"_30085":202302,"_5":21646,"_28538":201666,"_5847":155402},[],{"_6944":123872,"_42621":123590,"_30085":202304,"_5":21646,"_28538":201666,"_5847":202305},[],"Credenciales Basic Auth de la API de gestión.",{"_6944":123873,"_42621":123590,"_30085":202307,"_5":21646,"_28538":201666,"_5847":93103},[],{"_6944":123874,"_42621":123590,"_30085":202309,"_5":21646,"_28538":201666,"_5847":93106},[],{"_6944":123875,"_42621":123590,"_30085":202311,"_5":21646,"_28538":201666,"_5847":202312},[],"Segmento de ruta del tenant DDI.",{"_6944":123876,"_42621":123590,"_30085":202314,"_5":21646,"_28538":201666,"_5847":93112},[],{"_6944":123877,"_42621":123590,"_30085":202316,"_5":21646,"_28538":201666,"_5847":93087},[],{"_6944":123878,"_42621":123590,"_30085":202318,"_5":21646,"_28538":201666,"_5847":202319},[],"Raíz DDI de hawkBit **tal como la alcanzan los dispositivos** (por ejemplo `https://updates.example.com/api/hawkbit-ddi`). Se usa para construir las URLs de descarga que reciben los dispositivos, y su ruta pasa a ser el prefijo de la ruta de descarga DDI que sirve este servicio.",{"_6944":123879,"_42621":123590,"_30085":202321,"_5":21646,"_28538":201666,"_5847":86185},[],{"_6944":123880,"_42621":123590,"_30085":202323,"_5":21646,"_28538":201666,"_5847":155402},[],{"_6944":123881,"_42621":123590,"_30085":202325,"_5":21646,"_28538":201666,"_5847":202326},[],"Mismo formato que los bloques de almacenamiento de blobs: `storage` debe apuntar al bucket y al `s3_prefix` del plugin S3 de artefactos de hawkBit, y `presign` activa las descargas firmadas. Sin él, los artefactos se transmiten a través de hawkBit.",{"_6944":123882,"_42621":123590,"_30085":202328,"_5":21646,"_28538":201666,"_5847":202329},[],"El bloque `storage` (Postgres) también es obligatorio en modo `hawkbit`.",{"_6944":123883,"_42621":123590,"_30085":202331,"_5":21646,"_28538":201670,"_5847":202332},[],"Cualquier clave del fichero se puede sobrescribir con una variable de entorno: el nombre es la ruta de la clave en mayúsculas con los puntos sustituidos por guiones bajos. `KMS_ENDPOINT` sobrescribe `kms_endpoint`, `STORAGE_PASSWORD` sobrescribe `storage.password` y `BUILDS_PRESIGN_TTL` sobrescribe `builds.presign.ttl`. La clave debe existir en el fichero (basta con un valor vacío): el cargador solo considera las claves que ha leído de él.",{"_6944":123884,"_42621":123590,"_30085":202334,"_5":21646,"_28538":201670,"_5847":202335},[],"Variables que lee el código además de estas sobrescrituras:",{"_6944":123885,"_42621":123590,"_30085":202337,"_5":21646,"_28538":201670,"_5847":93136},[],{"_6944":123886,"_42621":123590,"_30085":202339,"_5":21646,"_28538":201670,"_5847":191820},[],{"_6944":123887,"_42621":123590,"_30085":202341,"_5":21646,"_28538":201670,"_5847":93141},[],{"_6944":123888,"_42621":123590,"_30085":202343,"_5":21646,"_28538":201670,"_5847":202344},[],"Ruta del fichero de configuración.",{"_6944":123889,"_42621":123590,"_30085":202346,"_5":21646,"_28538":201670,"_5847":93147},[],{"_6944":123890,"_42621":123590,"_30085":202348,"_5":21646,"_28538":201670,"_5847":202349},[],"Identidad y espacio de nombres para la elección de líder de Kubernetes. El chart de Helm las define. Si no están definidas, se usan el nombre de host y el fichero de espacio de nombres de la cuenta de servicio.",{"_6944":123891,"_42621":123590,"_30085":202351,"_5":21646,"_28538":201670,"_5847":93153},[],{"_6944":123892,"_42621":123590,"_30085":202353,"_5":21646,"_28538":201670,"_5847":202354},[],"Dónde escriben ficheros temporales las subidas y las construcciones (el directorio temporal de Go).",{"_6944":123893,"_42621":123590,"_30085":202356,"_5":21646,"_28538":201670,"_5847":93159},[],{"_6944":123894,"_42621":123590,"_30085":202358,"_5":21646,"_28538":201670,"_5847":202359},[],"Solo lo usa la comprobación de salud de la imagen Docker para encontrar el puerto. Por defecto `10090`.",{"_6944":123895,"_42621":123590,"_30085":202361,"_5":21646,"_28538":201670,"_5847":93165},[],{"_6944":123896,"_42621":123590,"_30085":202363,"_5":21646,"_28538":201670,"_5847":202364},[],"La cadena de credenciales por defecto de AWS, cuando un bloque S3 o AWS KMS no tiene credencial explícita.",{"_6944":123897,"_42621":123590,"_30085":202366,"_5":21646,"_28538":201670,"_5847":202367},[],"En Docker Compose, el fichero `.env` lo lee `docker-compose.yml`, no el servicio: `HOST_IP`, `HAWKBIT_ADMIN_PASSWORD`, `HAWKBIT_ARTIFACT_STORAGE` y las variables `HAWKBIT_ARTIFACT_S3_*` y `LOCAL_S3_*`. Consulta `.env.example` en el repositorio.",{"_6944":123898,"_42621":123590,"_30085":202369,"_5":21646,"_28538":201670,"_5847":202370},[],"Con `app.logs.level: debug`, el servicio escribe en el registro, al arrancar, toda la configuración cargada, incluidos `storage.password`, `encryption.local_key`, las claves de S3 y `hawkbit.password`. En modo `native`, el bloque `storage`, contraseña incluida, también se imprime en la salida estándar en cada arranque, sea cual sea el nivel de registro. Usa `info` o superior donde se almacenen o compartan los registros, y guarda los secretos en un gestor de secretos, no en el fichero (consulta las credenciales `*_file` más arriba).",{"_6944":123899,"_42621":123590,"_30085":202372,"_5":21646,"_28538":201674,"_5847":202373},[],"El modo `native` necesita la base de datos, los endpoints a los que llama y las rutas de almacenamiento. Parte de `config-docker.yml`:",{"_6944":123900,"_42621":123590,"_30085":202375,"_5":21646,"_28538":201674,"_5847":202376},[],"El modo `hawkbit` necesita `mode: hawkbit`, `hawkbit.base_url`, las credenciales de la API de gestión y el bloque `storage`. Añade los ajustes de construcción solo si quieres construir. Las claves siguientes son las que usa `config-hawkbit.yml`:",{"_6944":123901,"_42621":123590,"_30085":202378,"_5":21646,"_28538":201674,"_5847":202379},[],"En modo `hawkbit`, las rutas de SymKMS se registran solo cuando `symkms.storage.type` o `sym_keys_dir` están definidos. Con `symkms_endpoint` definido pero ninguno de los dos, el propio servicio respondería `404` a cada consulta de clave.",{"_6944":123902,"_42621":123590,"_30085":202381,"_5":21646,"_28538":201678,"_5847":202382},[],"El binario `cmd/symkms` ejecuta SymKMS en solitario. Su configuración solo tiene `app` (como arriba), `symkms` (un bloque de almacenamiento) y `sym_keys_dir`. Su directorio de claves es por defecto `/data/symmetric_keys` cuando no se define ni `symkms.storage.local_dir` ni `sym_keys_dir`. Sirve `/symkms/v1/*` pero no tiene ruta `/health`, y carece de autenticación igual que el monolito: consulta Seguridad.",{"_6944":123903,"_42621":123590,"_30085":202384,"_5":21646,"_28538":201682,"_5847":202385},[],"Operaciones para los valores de Helm, el escalado y las copias de seguridad.",{"_6944":123904,"_42621":123590,"_30085":202387,"_5":21646,"_28538":201682,"_5847":202388},[],"Modo hawkBit para lo que cambia en ese backend.",{"_6944":123905,"_42621":123590,"_30085":202390,"_5":21646,"_28538":201682,"_5847":202391},[],"Firma y cifrado para las claves que hay detrás de `kms_endpoint` y `symkms`.",{"_6944":123906,"_42621":123590,"_30085":202393,"_5":21646,"_28538":201682,"_5847":202394},[],"Resolución de problemas para los errores de arranque.",{"_6944":123907,"_42621":123907,"_5":22076,"_5847":197547,"_43101":202396,"_30085":202397,"_28538":123907},[78004,189200,195583,188960],[],{"_6944":123908,"_42621":123907,"_30085":202399,"_5":21646,"_28538":123907,"_5847":202400},[],"Qué protege y qué no protege Lamassu Updates, y qué poner a su alrededor antes de exponerlo.",{"_6944":123909,"_42621":123907,"_5":43098,"_30085":202402,"_28538":202403,"_5847":202404},[],"/docs/pr-preview/pr-56/es/platform/updates/security#resumen","Resumen",{"_6944":123910,"_42621":123907,"_5":43098,"_30085":202406,"_28538":202407,"_5847":202408},[],"/docs/pr-preview/pr-56/es/platform/updates/security#qué-poner-delante","Qué poner delante",{"_6944":123911,"_42621":123907,"_5":43098,"_30085":202410,"_28538":202411,"_5847":202412},[],"/docs/pr-preview/pr-56/es/platform/updates/security#cómo-se-identifica-el-servicio-ante-otros","Cómo se identifica el servicio ante otros",{"_6944":123912,"_42621":123907,"_5":43098,"_30085":202414,"_28538":202415,"_5847":202416},[],"/docs/pr-preview/pr-56/es/platform/updates/security#rutas-a-restringir","Rutas a restringir",{"_6944":123913,"_42621":123907,"_5":43098,"_30085":202418,"_28538":202419,"_5847":202420},[],"/docs/pr-preview/pr-56/es/platform/updates/security#qué-comprueba-el-servicio","Qué comprueba el servicio",{"_6944":123914,"_42621":123907,"_5":43098,"_30085":202422,"_28538":202423,"_5847":202424},[],"/docs/pr-preview/pr-56/es/platform/updates/security#urls-de-descarga-prefirmadas","URLs de descarga prefirmadas",{"_6944":123915,"_42621":123907,"_5":43098,"_30085":202426,"_28538":202427,"_5847":202428},[],"/docs/pr-preview/pr-56/es/platform/updates/security#conexiones-salientes","Conexiones salientes",{"_6944":123916,"_42621":123907,"_5":43098,"_30085":202430,"_28538":202431,"_5847":202432},[],"/docs/pr-preview/pr-56/es/platform/updates/security#secretos","Secretos",{"_6944":123917,"_42621":123907,"_5":43098,"_30085":202434,"_28538":202435,"_5847":195599},[],"/docs/pr-preview/pr-56/es/platform/updates/security#modo-hawkbit",{"_6944":123918,"_42621":123907,"_5":43098,"_30085":202437,"_28538":202438,"_5847":202439},[],"/docs/pr-preview/pr-56/es/platform/updates/security#límites-de-petición","Límites de petición",{"_6944":123919,"_42621":123907,"_30085":202441,"_5":21646,"_28538":123907,"_5847":202442},[],"Lamassu Updates delega la autenticación, la autorización y TLS en el gateway de la plataforma que tiene delante. Esta página lista lo que el servicio aplica por sí mismo, lo que no, y qué configurar a su alrededor. Léela antes de exponer el servicio más allá de una red de confianza.",{"_6944":123920,"_42621":123907,"_30085":202444,"_5":21646,"_28538":202403,"_5847":188834},[],{"_6944":123921,"_42621":123907,"_30085":202446,"_5":21646,"_28538":202403,"_5847":196005},[],{"_6944":123922,"_42621":123907,"_30085":202448,"_5":21646,"_28538":202403,"_5847":202449},[],"Autenticación de quien llama a la API",{"_6944":123923,"_42621":123907,"_30085":202451,"_5":21646,"_28538":202403,"_5847":202452},[],"**Ninguna en el servicio.** Todas las rutas están abiertas a cualquiera que alcance el puerto. El gateway debe autenticar.",{"_6944":123924,"_42621":123907,"_30085":202454,"_5":21646,"_28538":202403,"_5847":193778},[],{"_6944":123925,"_42621":123907,"_30085":202456,"_5":21646,"_28538":202403,"_5847":202457},[],"**Sin roles ni permisos por grupo.** El servicio solo hace comprobaciones estructurales (consulta Qué comprueba el servicio). El gateway debe autorizar.",{"_6944":123926,"_42621":123907,"_30085":202459,"_5":21646,"_28538":202403,"_5847":202460},[],"TLS y mTLS (entrada)",{"_6944":123927,"_42621":123907,"_30085":202462,"_5":21646,"_28538":202403,"_5847":202463},[],"**No implementado.** El servicio sirve siempre HTTP sin cifrar.",{"_6944":123928,"_42621":123907,"_30085":202465,"_5":21646,"_28538":202403,"_5847":202466},[],"TLS hacia otros sistemas",{"_6944":123929,"_42621":123907,"_30085":202468,"_5":21646,"_28538":202403,"_5847":202469},[],"Postgres: siempre `sslmode=disable`. KMS: no se verifica en modo `native`, y el script firmante de SWU usa `curl -k`. Consulta Conexiones salientes.",{"_6944":123930,"_42621":123907,"_30085":202471,"_5":21646,"_28538":202403,"_5847":90562},[],{"_6944":123931,"_42621":123907,"_30085":202473,"_5":21646,"_28538":202403,"_5847":202474},[],"Se permite cualquier origen y cualquier cabecera.",{"_6944":123932,"_42621":123907,"_30085":202476,"_5":21646,"_28538":202403,"_5847":202477},[],"Limitación de tasa, cabeceras de seguridad",{"_6944":123933,"_42621":123907,"_30085":202479,"_5":21646,"_28538":202403,"_5847":202480},[],"El servicio no añade ninguna.",{"_6944":123934,"_42621":123907,"_30085":202482,"_5":21646,"_28538":202403,"_5847":202483},[],"Firma de paquetes",{"_6944":123935,"_42621":123907,"_30085":202485,"_5":21646,"_28538":202403,"_5847":202486},[],"Disponible, mediante el KMS de Lamassu. Consulta Firma y cifrado.",{"_6944":123936,"_42621":123907,"_30085":202488,"_5":21646,"_28538":202403,"_5847":202489},[],"Cifrado de paquetes",{"_6944":123937,"_42621":123907,"_30085":202491,"_5":21646,"_28538":202403,"_5847":202492},[],"Disponible: clave compartida o clave por dispositivo.",{"_6944":123938,"_42621":123907,"_30085":202494,"_5":21646,"_28538":202403,"_5847":202495},[],"Cifrado en reposo",{"_6944":123939,"_42621":123907,"_30085":202497,"_5":21646,"_28538":202403,"_5847":202498},[],"Disponible para artefactos, compilaciones y claves, mediante el bloque `encryption` de cada bloque de almacenamiento.",{"_6944":123940,"_42621":123907,"_30085":202500,"_5":21646,"_28538":202403,"_5847":202501},[],"Las claves `cert_file`, `key_file` y `authentication.mutual_tls.*` existen en las estructuras de configuración pero no se leen, así que definirlas no tiene efecto.",{"_6944":123941,"_42621":123907,"_30085":202503,"_5":21646,"_28538":202407,"_5847":202504},[],"Ejecuta el servicio detrás de un gateway o proxy inverso que:",{"_6944":123942,"_42621":123907,"_30085":202506,"_5":21646,"_28538":202407,"_5847":202507},[],"**Termine TLS** entre los clientes y el servicio.",{"_6944":123943,"_42621":123907,"_30085":202509,"_5":21646,"_28538":202407,"_5847":202510},[],"**Autentique y autorice** a quien llama: operadores para la API y dispositivos para las rutas de descarga. Un dispositivo solo debe alcanzar sus propias rutas de descarga, así que haz coincidir el certificado del dispositivo con el `:deviceID` (o `:controllerId`) de la ruta.",{"_6944":123944,"_42621":123907,"_30085":202512,"_5":21646,"_28538":202407,"_5847":202513},[],"**Restrinja las rutas peligrosas** a quienes las necesitan (consulta más abajo).",{"_6944":123945,"_42621":123907,"_30085":202515,"_5":21646,"_28538":202407,"_5847":202516},[],"Mantén el servicio en una red privada. Los dispositivos solo necesitan alcanzar las rutas de descarga y, en modo `native`, el listener de **cliente** de WFX. En modo `hawkbit` hablan con hawkBit (y con el almacén de URLs firmadas) y no con este servicio, salvo por la ruta de descarga de artefactos descrita en Modo hawkBit.",{"_6944":123946,"_42621":123907,"_30085":202518,"_5":21646,"_28538":202407,"_5847":202519},[],"WFX tiene un listener de cliente (`8080` en Compose, publicado como `9080`) y un listener de gestión (`8081`, publicado como `9081`). Lamassu Updates no autentica ninguno de los dos. Los dispositivos solo necesitan el listener de cliente: no expongas el puerto de gestión a los dispositivos ni a redes no confiables.",{"_6944":123947,"_42621":123907,"_30085":202521,"_5":21646,"_28538":202411,"_5847":202522},[],"El servicio no reenvía la identidad de quien llama. Las llamadas al Device Manager y al KMS de Lamassu llevan la cabecera fija `X-Principal-ID: admin-mode`, que la capa de autorización de la plataforma acepta para llamadores internos y que el gateway de la plataforma elimina del tráfico externo. El valor no es configurable, así que apunta `dms_endpoint` y `kms_endpoint` a direcciones internas de servicio, no a una ruta pública de gateway que la rechazaría o la reenviaría. Las llamadas del servicio a SymKMS no llevan credencial.",{"_6944":123948,"_42621":123907,"_30085":202524,"_5":21646,"_28538":202415,"_5847":197196},[],{"_6944":123949,"_42621":123907,"_30085":202526,"_5":21646,"_28538":202415,"_5847":199538},[],{"_6944":123950,"_42621":123907,"_30085":202528,"_5":21646,"_28538":202415,"_5847":93333},[],{"_6944":123951,"_42621":123907,"_30085":202530,"_5":21646,"_28538":202415,"_5847":202531},[],"Devuelve material de clave sin protección.",{"_6944":123952,"_42621":123907,"_30085":202533,"_5":21646,"_28538":202415,"_5847":93339},[],{"_6944":123953,"_42621":123907,"_30085":202535,"_5":21646,"_28538":202415,"_5847":202536},[],"Devuelve el material de clave sin protección de un dispositivo. El servicio Updates lo usa durante una construcción por dispositivo.",{"_6944":123954,"_42621":123907,"_30085":202538,"_5":21646,"_28538":202415,"_5847":202539},[],"`POST /symkms/v1/`, `DELETE /symkms/v1/:keyID`, rutas de asignación de claves",{"_6944":123955,"_42621":123907,"_30085":202541,"_5":21646,"_28538":202415,"_5847":202542},[],"Crean, borran y asignan claves de cifrado.",{"_6944":123956,"_42621":123907,"_30085":202544,"_5":21646,"_28538":202415,"_5847":93351},[],{"_6944":123957,"_42621":123907,"_30085":202546,"_5":21646,"_28538":202415,"_5847":202547},[],"Usan las claves guardadas sobre datos arbitrarios.",{"_6944":123958,"_42621":123907,"_30085":202549,"_5":21646,"_28538":202415,"_5847":93357},[],{"_6944":123959,"_42621":123907,"_30085":202551,"_5":21646,"_28538":202415,"_5847":202552},[],"Falsifica un cambio de estado de un trabajo sin comprobar propiedad. Se registra solo cuando `enable_test_endpoints` es `true`: mantenlo en `false`.",{"_6944":123960,"_42621":123907,"_30085":202554,"_5":21646,"_28538":202415,"_5847":202555},[],"Todo `POST`, `PUT` y `DELETE` de `/updates/v1`",{"_6944":123961,"_42621":123907,"_30085":202557,"_5":21646,"_28538":202415,"_5847":202558},[],"Construir, lanzar, cancelar y borrar. Restríngelos a los operadores.",{"_6944":123962,"_42621":123907,"_30085":202560,"_5":21646,"_28538":202415,"_5847":202561},[],"`GET` de artefactos, descriptores y `artifacts-archive`",{"_6944":123963,"_42621":123907,"_30085":202563,"_5":21646,"_28538":202415,"_5847":202564},[],"Exponen fuentes de firmware y sw-descriptions.",{"_6944":123964,"_42621":123907,"_30085":202566,"_5":21646,"_28538":202415,"_5847":202567},[],"Rutas de descarga con `:deviceID`",{"_6944":123965,"_42621":123907,"_30085":202569,"_5":21646,"_28538":202415,"_5847":202570},[],"Las construcciones por dispositivo se cifran con la clave de ese dispositivo, pero la propia ruta no comprueba quién la pide.",{"_6944":123966,"_42621":123907,"_30085":202572,"_5":21646,"_28538":202419,"_5847":202573},[],"Son defensa en profundidad, no un sustituto del gateway:",{"_6944":123967,"_42621":123907,"_30085":202575,"_5":21646,"_28538":202419,"_5847":202576},[],"Un lanzamiento se direcciona bajo su grupo: una operación sobre un lanzamiento a través de la ruta de otro grupo responde `404`, exactamente igual que para un lanzamiento inexistente, y no cambia nada.",{"_6944":123968,"_42621":123907,"_30085":202578,"_5":21646,"_28538":202419,"_5847":202579},[],"Los umbrales de aprobación y de error deben estar entre 0 y 100.",{"_6944":123969,"_42621":123907,"_30085":202581,"_5":21646,"_28538":202419,"_5847":202582},[],"En modo `native`, los identificadores de paquete, grupo y dispositivo usados en las rutas se validan para que no puedan salir de los directorios de almacenamiento, y un paquete por dispositivo nunca recurre a la construcción compartida para un dispositivo.",{"_6944":123970,"_42621":123907,"_30085":202584,"_5":21646,"_28538":202419,"_5847":202585},[],"Una subida con nombre `.swu` debe ser realmente un SWU: cualquier otro contenido se rechaza con `400`.",{"_6944":123971,"_42621":123907,"_30085":202587,"_5":21646,"_28538":202419,"_5847":202588},[],"Un fichero subido mayor que `max_artifact_size_mb` se rechaza con `413`.",{"_6944":123972,"_42621":123907,"_30085":202590,"_5":21646,"_28538":202419,"_5847":202591},[],"En modo `hawkbit`, la ruta DDI de artefactos sirve un fichero solo si el módulo está asignado o instalado en ese dispositivo.",{"_6944":123973,"_42621":123907,"_30085":202593,"_5":21646,"_28538":202419,"_5847":202594},[],"Todo lo que modifica una versión construida se rechaza (`409`): las versiones son inmutables.",{"_6944":123974,"_42621":123907,"_30085":202596,"_5":21646,"_28538":202423,"_5847":202597},[],"Con `presign.enabled`, una descarga se responde con `302` a una URL de corta duración del almacén S3. El servicio autoriza antes a quien llama (el gateway para la ruta estática y, en modo `hawkbit`, la asignación del dispositivo); el almacén solo comprueba después la firma, así que **la URL es una capacidad al portador**: quien la posee puede obtener ese único objeto hasta que caduca. El diseño hace aceptable esto:",{"_6944":123975,"_42621":123907,"_30085":202599,"_5":21646,"_28538":202423,"_5847":202600},[],"El TTL es corto (por defecto 60 s). Acota cuándo puede **empezar** un GET: una transferencia en curso termina después de caducar, y un dispositivo que reintenta o reanuda vuelve al endpoint estático para obtener una URL nueva. Una URL ya firmada para el mismo objeto se reutiliza mientras le quede `min_remaining` de validez (por defecto `min(25s, ttl/2)`); no concede más que una nueva.",{"_6944":123976,"_42621":123907,"_30085":202602,"_5":21646,"_28538":202423,"_5847":202603},[],"La credencial de firma debe ser **de solo lectura** y distinta de la credencial del almacenamiento. Al arrancar, el servicio hace una prueba de escritura y se niega a ejecutarse si la credencial puede escribir, es la del propio almacenamiento o el almacén la rechaza. Una firma cubre el método y la clave, así que una URL no puede convertirse en un `PUT` ni apuntarse a otro objeto.",{"_6944":123977,"_42621":123907,"_30085":202605,"_5":21646,"_28538":202423,"_5847":202606},[],"El host firmado es el origen **público** del almacén (`presign.public_endpoint`), porque la firma cubre la cabecera `Host`.",{"_6944":123978,"_42621":123907,"_30085":202608,"_5":21646,"_28538":202423,"_5847":202609},[],"No se puede combinar con el cifrado en reposo del mismo almacén (los dispositivos recibirían texto cifrado).",{"_6944":123979,"_42621":123907,"_30085":202611,"_5":21646,"_28538":202423,"_5847":202612},[],"Las respuestas de redirección llevan `Cache-Control: no-store`. Las peticiones `HEAD` las responde el servicio, no se redirigen. Si falla la firma, el servicio transmite el fichero en lugar de hacer fallar la actualización.",{"_6944":123980,"_42621":123907,"_30085":202614,"_5":21646,"_28538":202423,"_5847":202615},[],"Rota la credencial de firma actualizando los ficheros indicados por `access_key_id_file` y `secret_access_key_file`: se releen cada minuto.",{"_6944":123981,"_42621":123907,"_30085":202617,"_5":21646,"_28538":202423,"_5847":202618},[],"El propio almacén debe ser alcanzable por los dispositivos en el endpoint público, y debería aceptar solo la credencial de solo lectura sobre el prefijo que sirve. No publiques la consola del almacén ni su API S3 con credenciales por defecto.",{"_6944":123982,"_42621":123907,"_30085":202620,"_5":21646,"_28538":202427,"_5847":202621},[],"Conexión",{"_6944":123983,"_42621":123907,"_30085":202623,"_5":21646,"_28538":202427,"_5847":202624},[],"Seguridad del transporte",{"_6944":123984,"_42621":123907,"_30085":202626,"_5":21646,"_28538":202427,"_5847":86197},[],{"_6944":123985,"_42621":123907,"_30085":202628,"_5":21646,"_28538":202427,"_5847":202629},[],"`sslmode=disable`, no configurable. Mantén la base de datos en una red privada.",{"_6944":123986,"_42621":123907,"_30085":202631,"_5":21646,"_28538":202427,"_5847":202632},[],"Device Manager de Lamassu",{"_6944":123987,"_42621":123907,"_30085":202634,"_5":21646,"_28538":202427,"_5847":202635},[],"El cliente del SDK de la plataforma Lamassu con sus ajustes por defecto.",{"_6944":123988,"_42621":123907,"_30085":202637,"_5":21646,"_28538":202427,"_5847":202638},[],"KMS de Lamassu",{"_6944":123989,"_42621":123907,"_30085":202640,"_5":21646,"_28538":202427,"_5847":202641},[],"Modo `native`: la verificación del certificado se **omite** en las llamadas propias del servicio, y el script firmante de SWU usa `curl -k`. Modo `hawkbit`: las llamadas del servicio verifican el certificado, el script sigue sin hacerlo. Usa una dirección interna de confianza.",{"_6944":123990,"_42621":123907,"_30085":202643,"_5":21646,"_28538":202427,"_5847":86101},[],{"_6944":123991,"_42621":123907,"_30085":202645,"_5":21646,"_28538":202427,"_5847":202646},[],"El esquema de `symkms_endpoint` (normalmente el propio servicio, por HTTP sin cifrar en los ejemplos), sin credencial. El material de clave sin protección cruza esta conexión: mantenla en `localhost` o en una red privada.",{"_6944":123992,"_42621":123907,"_30085":202648,"_5":21646,"_28538":202427,"_5847":202649},[],"API de gestión de hawkBit",{"_6944":123993,"_42621":123907,"_30085":202651,"_5":21646,"_28538":202427,"_5847":202652},[],"HTTP Basic con `hawkbit.username` y `hawkbit.password`. Usa HTTPS.",{"_6944":123994,"_42621":123907,"_30085":202654,"_5":21646,"_28538":202427,"_5847":86224},[],{"_6944":123995,"_42621":123907,"_30085":202656,"_5":21646,"_28538":202427,"_5847":202657},[],"El esquema de `wfx_endpoint` (HTTP sin cifrar en los ejemplos), hacia el listener de gestión.",{"_6944":123996,"_42621":123907,"_30085":202659,"_5":21646,"_28538":202431,"_5847":202660},[],"`encryption.local_key`, las credenciales de S3 y las contraseñas de base de datos deben venir de un gestor de secretos, no de un fichero del repositorio. Las configuraciones de ejemplo contienen solo valores de desarrollo. Prefiere la forma `*_file` de las credenciales de S3 y de presign, que el servicio relee cada minuto.",{"_6944":123997,"_42621":123907,"_30085":202662,"_5":21646,"_28538":202431,"_5847":202663},[],"El chart de Helm vuelca todo `config` en un ConfigMap. Consulta Operaciones. Sustituye su contraseña de base de datos de ejemplo.",{"_6944":123998,"_42621":123907,"_30085":202665,"_5":21646,"_28538":202431,"_5847":202666},[],"Con `app.logs.level: debug` el servicio registra toda la configuración, secretos incluidos, y en modo `native` imprime el bloque `storage` (con su contraseña) en la salida estándar en cada arranque. Usa `info` o superior en cualquier entorno cuyos registros se almacenen.",{"_6944":123999,"_42621":123907,"_30085":202668,"_5":21646,"_28538":202431,"_5847":202669},[],"Perder `encryption.local_key` deja ilegible todo lo guardado con ella. Consulta Copias de seguridad y restauración.",{"_6944":124000,"_42621":123907,"_30085":202671,"_5":21646,"_28538":202431,"_5847":202672},[],"Las claves de firma permanecen en el KMS de Lamassu: el servicio nunca tiene la clave privada. Las claves de cifrado de dispositivo sí viven en SymKMS (opcionalmente cifradas en reposo), porque los paquetes deben cifrarse con ellas.",{"_6944":124001,"_42621":123907,"_30085":202674,"_5":21646,"_28538":202431,"_5847":202675},[],"La imagen de contenedor no reduce privilegios. Define un `securityContext` adecuado para tu clúster.",{"_6944":124002,"_42621":123907,"_30085":202677,"_5":21646,"_28538":202435,"_5847":202678},[],"El usuario de la API de gestión es administrador completo de hawkBit. Cambia la credencial por defecto (`admin`), mantén la API fuera de la red de dispositivos y sírvela por HTTPS.",{"_6944":124003,"_42621":123907,"_30085":202680,"_5":21646,"_28538":202435,"_5847":202681},[],"Los dispositivos se autentican ante hawkBit, no ante este servicio. hawkBit 1.1.0 no tiene modo anónimo: habilita un token de seguridad de target, un token de gateway o el autenticador por cabecera de proxy inverso, y para este último restringe qué direcciones pueden fijar sus cabeceras. Dejar desactivada la autenticación de dispositivos, aceptable solo en una pila de pruebas desechable, permite que cualquiera que alcance hawkBit suplante a un dispositivo. Consulta Modo hawkBit.",{"_6944":124004,"_42621":123907,"_30085":202683,"_5":21646,"_28538":202435,"_5847":202684},[],"hawkBit no cifra los artefactos en reposo. Activa el cifrado por defecto en el bucket, o usa paquetes cifrados (clave compartida).",{"_6944":124005,"_42621":123907,"_30085":202686,"_5":21646,"_28538":202438,"_5847":202687},[],"Un cuerpo de petición puede llegar a `max_artifact_size_mb` más 1 MiB (10 GiB por defecto), y una petición puede durar hasta 6 horas, así que las subidas grandes funcionan. Las subidas en streaming usan disco temporal bajo `TMPDIR`. Aplica límites más estrictos en el gateway para quienes no sean de confianza: el servicio no limita la tasa de peticiones.",{"_6944":124006,"_42621":124006,"_5":22076,"_5847":199055,"_43101":202689,"_30085":202690,"_28538":124006},[78004,189200,195583,193958],[],{"_6944":124007,"_42621":124006,"_30085":202692,"_5":21646,"_28538":124006,"_5847":202693},[],"Firma los entregables con el KMS de Lamassu, cífralos con una clave compartida o por dispositivo y gestiona las claves de dispositivo en SymKMS.",{"_6944":124008,"_42621":124006,"_5":43098,"_30085":202695,"_28538":202696,"_5847":202697},[],"/docs/pr-preview/pr-56/es/platform/updates/signing-and-encryption#firma","Firma",{"_6944":124009,"_42621":124006,"_5":43098,"_30085":202699,"_28538":202700,"_5847":202701},[],"/docs/pr-preview/pr-56/es/platform/updates/signing-and-encryption#configura-la-firma","Configura la firma",{"_6944":124010,"_42621":124006,"_5":43098,"_30085":202703,"_28538":202704,"_5847":202705},[],"/docs/pr-preview/pr-56/es/platform/updates/signing-and-encryption#crea-la-clave-y-un-certificado","Crea la clave y un certificado",{"_6944":124011,"_42621":124006,"_5":43098,"_30085":202707,"_28538":202708,"_5847":202709},[],"/docs/pr-preview/pr-56/es/platform/updates/signing-and-encryption#configura-el-servicio","Configura el servicio",{"_6944":124012,"_42621":124006,"_5":43098,"_30085":202711,"_28538":202712,"_5847":202713},[],"/docs/pr-preview/pr-56/es/platform/updates/signing-and-encryption#envía-los-campos-de-firma-en-la-construcción","Envía los campos de firma en la construcción",{"_6944":124013,"_42621":124006,"_5":43098,"_30085":202715,"_28538":202716,"_5847":202717},[],"/docs/pr-preview/pr-56/es/platform/updates/signing-and-encryption#manifiestos-firmados","Manifiestos firmados",{"_6944":124014,"_42621":124006,"_5":43098,"_30085":202719,"_28538":202720,"_5847":202721},[],"/docs/pr-preview/pr-56/es/platform/updates/signing-and-encryption#modos-de-cifrado","Modos de cifrado",{"_6944":124015,"_42621":124006,"_5":43098,"_30085":202723,"_28538":202724,"_5847":202725},[],"/docs/pr-preview/pr-56/es/platform/updates/signing-and-encryption#algoritmos","Algoritmos",{"_6944":124016,"_42621":124006,"_5":43098,"_30085":202727,"_28538":202728,"_5847":202729},[],"/docs/pr-preview/pr-56/es/platform/updates/signing-and-encryption#configurar-el-cifrado-por-dispositivo","Configurar el cifrado por dispositivo",{"_6944":124017,"_42621":124006,"_5":43098,"_30085":202731,"_28538":202732,"_5847":202733},[],"/docs/pr-preview/pr-56/es/platform/updates/signing-and-encryption#crea-una-clave-por-dispositivo","Crea una clave por dispositivo",{"_6944":124018,"_42621":124006,"_5":43098,"_30085":202735,"_28538":202736,"_5847":202737},[],"/docs/pr-preview/pr-56/es/platform/updates/signing-and-encryption#asígnala-al-dispositivo","Asígnala al dispositivo",{"_6944":124019,"_42621":124006,"_5":43098,"_30085":202739,"_28538":202740,"_5847":202741},[],"/docs/pr-preview/pr-56/es/platform/updates/signing-and-encryption#pon-la-misma-clave-en-el-dispositivo","Pon la misma clave en el dispositivo",{"_6944":124020,"_42621":124006,"_5":43098,"_30085":202743,"_28538":202744,"_5847":202745},[],"/docs/pr-preview/pr-56/es/platform/updates/signing-and-encryption#construye","Construye",{"_6944":124021,"_42621":124006,"_5":43098,"_30085":202747,"_28538":202748,"_5847":86101},[],"/docs/pr-preview/pr-56/es/platform/updates/signing-and-encryption#symkms",{"_6944":124022,"_42621":124006,"_5":43098,"_30085":202750,"_28538":202751,"_5847":202752},[],"/docs/pr-preview/pr-56/es/platform/updates/signing-and-encryption#cuerpos-de-petición","Cuerpos de petición",{"_6944":124023,"_42621":124006,"_30085":202754,"_5":21646,"_28538":124006,"_5847":202755},[],"Esta página explica cómo protege Lamassu Updates lo que entrega: qué claves firman y cifran un paquete, cómo configurarlas y qué soporta cada backend. Hay tres capas independientes.",{"_6944":124024,"_42621":124006,"_30085":202757,"_5":21646,"_28538":124006,"_5847":202758},[],"Capa",{"_6944":124025,"_42621":124006,"_30085":202760,"_5":21646,"_28538":124006,"_5847":202761},[],"Protege",{"_6944":124026,"_42621":124006,"_30085":202763,"_5":21646,"_28538":124006,"_5847":202764},[],"Se configura en",{"_6944":124027,"_42621":124006,"_30085":202766,"_5":21646,"_28538":124006,"_5847":202767},[],"Firma del paquete",{"_6944":124028,"_42621":124006,"_30085":202769,"_5":21646,"_28538":124006,"_5847":202770},[],"Que el paquete viene de ti y no se ha modificado",{"_6944":124029,"_42621":124006,"_30085":202772,"_5":21646,"_28538":124006,"_5847":202773},[],"Una clave de firma y un certificado en el KMS de Lamassu, más `kms_endpoint` y `sign_script_path`",{"_6944":124030,"_42621":124006,"_30085":202775,"_5":21646,"_28538":124006,"_5847":202776},[],"Cifrado del paquete",{"_6944":124031,"_42621":124006,"_30085":202778,"_5":21646,"_28538":124006,"_5847":202779},[],"El contenido del paquete en tránsito y en la ruta de descarga del dispositivo",{"_6944":124032,"_42621":124006,"_30085":202781,"_5":21646,"_28538":124006,"_5847":202782},[],"La petición de construcción, más una clave en SymKMS",{"_6944":124033,"_42621":124006,"_30085":202784,"_5":21646,"_28538":124006,"_5847":202495},[],{"_6944":124034,"_42621":124006,"_30085":202786,"_5":21646,"_28538":124006,"_5847":202787},[],"Artefactos, compilaciones y claves que almacena el servicio",{"_6944":124035,"_42621":124006,"_30085":202789,"_5":21646,"_28538":124006,"_5847":202790},[],"El bloque `encryption` de cada bloque de almacenamiento de blobs",{"_6944":124036,"_42621":124006,"_30085":202792,"_5":21646,"_28538":202696,"_5847":202793},[],"La firma es opcional. Cuando la pides, `swugenerator` llama al script firmante configurado (`sign_script_path`, que es `sign_kms.sh`) y el script pide al KMS de Lamassu (`kms_endpoint`) que firme. La clave privada nunca llega a la máquina que construye el paquete.",{"_6944":124037,"_42621":124006,"_30085":202795,"_5":21646,"_28538":202696,"_5847":202796},[],"Para las construcciones de `.swu` deben estar definidos ambos ajustes: el servicio rechaza una petición de firma cuando falta alguno.",{"_6944":124038,"_42621":124006,"_30085":202798,"_5":21646,"_28538":202696,"_5847":202799},[],"Firmar un manifiesto, un paquete `non-swu` o un módulo `raw` de hawkBit llama al KMS directamente desde el servicio y solo necesita `kms_endpoint`.",{"_6944":124039,"_42621":124006,"_30085":202801,"_5":21646,"_28538":202696,"_5847":202802},[],"Selecciona la clave en la petición de construcción con `signature_key_id`, `signature_alg_name` (por defecto `RSASSA_PSS_SHA_256`; `-` y `_` son intercambiables) y `signature_certificate` (PEM). Los tres campos van juntos: una petición con clave pero sin algoritmo o certificado se rechaza, nunca se construye sin firmar.",{"_6944":124040,"_42621":124006,"_30085":202804,"_5":21646,"_28538":202704,"_5847":202805},[],"En el KMS de Lamassu, crea (o elige) la clave de firma y emite un certificado para ella desde una CA en la que confíen tus dispositivos. Consulta Claves y motores criptográficos. El ID de la clave es tu `signature_key_id`.",{"_6944":124041,"_42621":124006,"_30085":202807,"_5":21646,"_28538":202708,"_5847":202808},[],"Define `kms_endpoint` y `sign_script_path` (`/app/sign_kms.sh` en la imagen). `swugenerator` llama al script con el ID de la clave, la URL del KMS, el algoritmo y la ruta del fichero del certificado, que el script exige. El script escribe un registro de depuración en `/tmp/sign_kms_debug.log`.",{"_6944":124042,"_42621":124006,"_30085":202810,"_5":21646,"_28538":202712,"_5847":202811},[],"Incluye `signature_key_id`, `signature_alg_name` y `signature_certificate` en el cuerpo de la construcción. En modo `hawkbit` van en el cuerpo de la construcción del módulo.",{"_6944":124043,"_42621":124006,"_30085":202813,"_5":21646,"_28538":202712,"_5847":202814},[],"SWUpdate verifica un `.swu` con una firma CMS `SignedData`, y el servicio exige CMS para los manifiestos que firma él mismo. Un KMS de Lamassu que ignora la cabecera `Accept` y responde con una firma simple dentro de un sobre JSON produce una firma que ningún dispositivo puede verificar. Cuando firma el propio servicio (manifiestos de versión, manifiestos de conjunto, sumas de verificación de módulos raw) rechaza esa respuesta y la operación falla con `the KMS did not return a PKCS7/CMS signature`. El script firmante de SWU no comprueba el formato: desempaqueta la respuesta y la incrusta, así que con un KMS sin soporte CMS una construcción de `.swu` puede salir bien y aun así ser rechazada por un dispositivo que define `public-key-file`. Prueba una construcción firmada en un dispositivo real antes de fiarte de una versión del KMS.",{"_6944":124044,"_42621":124006,"_30085":202816,"_5":21646,"_28538":202712,"_5847":202817},[],"`sign_kms_nocms.sh` es una variante del script que no recibe certificado. La firma de manifiestos del propio servicio es independiente: envía siempre el certificado y se niega a firmar sin él.",{"_6944":124045,"_42621":124006,"_30085":202819,"_5":21646,"_28538":202712,"_5847":202820},[],"TLS hacia el KMS: en modo `native` el cliente KMS del servicio omite la verificación del certificado, y `sign_kms.sh` llama a `curl -k`. En modo `hawkbit` las llamadas del propio servicio al KMS verifican el certificado, pero el script firmante de SWU sigue usando `curl -k`. Alcanza el KMS por una dirección interna de confianza. Consulta Seguridad.",{"_6944":124046,"_42621":124006,"_30085":202822,"_5":21646,"_28538":202716,"_5847":202823},[],"Cada versión construida tiene además un **manifiesto**, un registro antirretroceso de lo que contiene la versión: nombre, grupo, versión, empaquetado, artefactos con su SHA-256, el entregable y, en modo `hawkbit`, los módulos y versiones exactos que componen el conjunto. Un manifiesto es válido durante 5 años (`expires_at`). Se firma con la clave del KMS cuando la construcción llevaba campos de firma, y se guarda sin firmar en caso contrario (el servicio registra una advertencia). Si hay una clave de firma configurada pero el manifiesto no se puede firmar, la construcción falla.",{"_6944":124047,"_42621":124006,"_30085":202825,"_5":21646,"_28538":202716,"_5847":202826},[],"Léelo con:",{"_6944":124048,"_42621":124006,"_30085":202828,"_5":21646,"_28538":202716,"_5847":202829},[],"La respuesta contiene `manifest` (los bytes exactos que cubre la firma), `signature` (CMS en base64), `algorithm`, `certificate` (PEM), `signed_at` y `expires_at`. En modo `hawkbit`, `stale: true` significa que existe un manifiesto firmado pero el contenido del conjunto ha cambiado desde entonces, así que el manifiesto devuelto describe el conjunto tal como está ahora. La capacidad `artifact_signatures` indica si el backend activo lo ofrece.",{"_6944":124049,"_42621":124006,"_30085":202831,"_5":21646,"_28538":202720,"_5847":201939},[],{"_6944":124050,"_42621":124006,"_30085":202833,"_5":21646,"_28538":202720,"_5847":202834},[],"Qué obtienes",{"_6944":124051,"_42621":124006,"_30085":202836,"_5":21646,"_28538":202720,"_5847":89992},[],{"_6944":124052,"_42621":124006,"_30085":202838,"_5":21646,"_28538":202720,"_5847":87265},[],{"_6944":124053,"_42621":124006,"_30085":202840,"_5":21646,"_28538":202720,"_5847":199415},[],{"_6944":124054,"_42621":124006,"_30085":202842,"_5":21646,"_28538":202720,"_5847":202843},[],"Un entregable sin cifrar",{"_6944":124055,"_42621":124006,"_30085":202845,"_5":21646,"_28538":202720,"_5847":191827},[],{"_6944":124056,"_42621":124006,"_30085":202847,"_5":21646,"_28538":202720,"_5847":191827},[],{"_6944":124057,"_42621":124006,"_30085":202849,"_5":21646,"_28538":202720,"_5847":202850},[],"Compartido",{"_6944":124058,"_42621":124006,"_30085":202852,"_5":21646,"_28538":202720,"_5847":202853},[],"Un entregable cifrado con una clave, servido a todos los dispositivos",{"_6944":124059,"_42621":124006,"_30085":202855,"_5":21646,"_28538":202720,"_5847":191827},[],{"_6944":124060,"_42621":124006,"_30085":202857,"_5":21646,"_28538":202720,"_5847":202858},[],"Sí, mediante los endpoints de construcción de módulos, cuando el pipeline de construcción está configurado",{"_6944":124061,"_42621":124006,"_30085":202860,"_5":21646,"_28538":202720,"_5847":202861},[],"Por dispositivo",{"_6944":124062,"_42621":124006,"_30085":202863,"_5":21646,"_28538":202720,"_5847":202864},[],"Un entregable por dispositivo, cada uno cifrado con la clave propia de ese dispositivo en SymKMS",{"_6944":124063,"_42621":124006,"_30085":202866,"_5":21646,"_28538":202720,"_5847":191827},[],{"_6944":124064,"_42621":124006,"_30085":202868,"_5":21646,"_28538":202720,"_5847":82222},[],{"_6944":124065,"_42621":124006,"_30085":202870,"_5":21646,"_28538":202720,"_5847":202871},[],"El cuerpo de la construcción decide el modo:",{"_6944":124066,"_42621":124006,"_30085":202873,"_5":21646,"_28538":202720,"_5847":202874},[],"**Compartido**: envía `user`, `encryption_key_name` y `encryption_alg_name`. Una construcción de `.swu` se rechaza sin el algoritmo. Una construcción `.../package` elige AES-GCM según la longitud de la clave y solo registra el nombre que envíes.",{"_6944":124067,"_42621":124006,"_30085":202876,"_5":21646,"_28538":202720,"_5847":202877},[],"**Por dispositivo**: envía `encryption_alg_name` **sin** `user` ni `encryption_key_name`. Esto vale también para `.../package`: enviar el algoritmo es lo que selecciona el modo por dispositivo, y omitirlo construye un paquete sin cifrar.",{"_6944":124068,"_42621":124006,"_30085":202879,"_5":21646,"_28538":202720,"_5847":202880},[],"**Ninguno**: no envíes ninguno de los dos.",{"_6944":124069,"_42621":124006,"_30085":202882,"_5":21646,"_28538":202720,"_5847":202883},[],"Otros campos de la construcción: `sw_desc_encrypted` cifra también la propia sw-description, y `selected_artifact_ids` lista los artefactos que incluye la construcción. En modo `native`, una construcción de `.swu` sin artefactos seleccionados falla.",{"_6944":124070,"_42621":124006,"_30085":202885,"_5":21646,"_28538":202720,"_5847":202886},[],"En modo `hawkbit`, `POST .../swu` devuelve `501`. Envía en su lugar los mismos campos de firma y cifrado a la construcción del módulo: `POST /updates/v1/softwaremodules/by-id/:moduleID/build` (para módulos `swu-build` y `raw`). Consulta Modo hawkBit.",{"_6944":124071,"_42621":124006,"_30085":202888,"_5":21646,"_28538":202720,"_5847":202889},[],"La sw-description debe marcar los artefactos a cifrar con `encrypted = true;`. Una construcción por dispositivo se rechaza cuando no hay ningún artefacto marcado, porque la clave por sí sola no hace nada.",{"_6944":124072,"_42621":124006,"_30085":202891,"_5":21646,"_28538":202724,"_5847":202892},[],"El `algorithm` de una clave de SymKMS y el `encryption_alg_name` de una construcción usan estos nombres.",{"_6944":124073,"_42621":124006,"_30085":202894,"_5":21646,"_28538":202724,"_5847":202895},[],"Algoritmo",{"_6944":124074,"_42621":124006,"_30085":202897,"_5":21646,"_28538":202724,"_5847":202898},[],"Longitud de clave",{"_6944":124075,"_42621":124006,"_30085":202900,"_5":21646,"_28538":202724,"_5847":93703},[],{"_6944":124076,"_42621":124006,"_30085":202902,"_5":21646,"_28538":202724,"_5847":93706},[],{"_6944":124077,"_42621":124006,"_30085":202904,"_5":21646,"_28538":202724,"_5847":93709},[],{"_6944":124078,"_42621":124006,"_30085":202906,"_5":21646,"_28538":202724,"_5847":93712},[],{"_6944":124079,"_42621":124006,"_30085":202908,"_5":21646,"_28538":202724,"_5847":93715},[],{"_6944":124080,"_42621":124006,"_30085":202910,"_5":21646,"_28538":202724,"_5847":93718},[],{"_6944":124081,"_42621":124006,"_30085":202912,"_5":21646,"_28538":202724,"_5847":93721},[],{"_6944":124082,"_42621":124006,"_30085":202914,"_5":21646,"_28538":202724,"_5847":93706},[],{"_6944":124083,"_42621":124006,"_30085":202916,"_5":21646,"_28538":202724,"_5847":93726},[],{"_6944":124084,"_42621":124006,"_30085":202918,"_5":21646,"_28538":202724,"_5847":93729},[],{"_6944":124085,"_42621":124006,"_30085":202920,"_5":21646,"_28538":202724,"_5847":202921},[],"**Nombres de clave en SymKMS**: la comparación ignora mayúsculas y minúsculas, y `_` y `-` son intercambiables (`aes_256_gcm` se guarda como `AES-256-GCM`). Los separadores del nombre deben seguir estando: `ascon128a` no es `ASCON-128A`. Una clave cuya longitud no coincide con su algoritmo se rechaza al crearla.",{"_6944":124086,"_42621":124006,"_30085":202923,"_5":21646,"_28538":202724,"_5847":202924},[],"**Nombres en construcciones**: `encryption_alg_name` se pasa tal cual a `swugenerator`. Se ignoran las mayúsculas, pero los guiones son obligatorios: `aes-256-gcm` funciona, `AES_256_GCM` se rechaza. Si el nombre difiere del algoritmo guardado con la clave, el servicio registra una advertencia y usa el nombre de la petición.",{"_6944":124087,"_42621":124006,"_30085":202926,"_5":21646,"_28538":202724,"_5847":202927},[],"**Los paquetes `non-swu`** (`.../package`, y los módulos `raw` de `hawkbit`) se cifran siempre con **AES-GCM**, elegido por la longitud de la clave (16, 24 o 32 bytes). El nombre solicitado solo se registra, y una clave Ascon-80pq de 20 bytes se rechaza. El resultado es `nonce || ciphertext`.",{"_6944":124088,"_42621":124006,"_30085":202929,"_5":21646,"_28538":202724,"_5847":202930},[],"El servicio genera el IV o nonce. En modo `native`, el algoritmo y, en los paquetes con clave compartida, el IV se pasan al dispositivo en el trabajo de WFX. Una construcción por dispositivo genera un IV nuevo para cada dispositivo y no lo registra en el trabajo, así que el trabajo lleva solo el algoritmo. Los campos del trabajo se listan en Conectar un dispositivo.",{"_6944":124089,"_42621":124006,"_30085":202932,"_5":21646,"_28538":202732,"_5847":202933},[],"En SymKMS, `POST /symkms/v1/` con `user_id`, un `algorithm` de la tabla y una `key` (hex o base64) de la longitud correcta.",{"_6944":124090,"_42621":124006,"_30085":202935,"_5":21646,"_28538":202736,"_5847":202936},[],"`POST /symkms/v1/inventory/:deviceID/keys/:keyID` con un cuerpo `{\"purpose\":\"firmware-encryption\"}` y un `expires_at` opcional (RFC 3339). Una construcción por dispositivo pide la clave `firmware-encryption` de cada dispositivo.",{"_6944":124091,"_42621":124006,"_30085":202938,"_5":21646,"_28538":202740,"_5847":202939},[],"En la forma que espera SWUpdate (su fichero de claves `-K`, con la clave, el IV y el algoritmo).",{"_6944":124092,"_42621":124006,"_30085":202941,"_5":21646,"_28538":202744,"_5847":202942},[],"Envía `encryption_alg_name` y no envíes `user` ni `encryption_key_name`. La sw-description debe marcar un artefacto con `encrypted = true;`.",{"_6944":124093,"_42621":124006,"_30085":202944,"_5":21646,"_28538":202744,"_5847":202945},[],"**Propósitos de clave.** Los propósitos convencionales son `firmware-encryption`, `config-encryption` y `mac-verification`. El propósito es un marcador de posición: se acepta cualquier valor, y una asignación con propósito vacío actúa como comodín que coincide con cualquier búsqueda. Es intencionado mientras se despliegan las claves por propósito. Una coincidencia exacta (sin distinguir mayúsculas) gana al comodín, y entre iguales gana la asignación más reciente. Las asignaciones caducadas o revocadas se omiten.",{"_6944":124094,"_42621":124006,"_30085":202947,"_5":21646,"_28538":202744,"_5847":202948},[],"**Cobertura.** Un dispositivo sin clave `firmware-encryption` se omite (el motivo dice `no firmware-encryption key assigned` en las construcciones de `.swu`). La construcción sigue teniendo éxito si se cubrió al menos un dispositivo, y el paquete registra la cobertura: lee `built_device_count`, `total_device_count` y `uncovered_devices` en él. Un lanzamiento sobre un paquete con dispositivos sin cubrir se rechaza con `400`, y no hay forma de forzarlo: asigna las claves que faltan y construye de nuevo. Si no se cubrió ningún dispositivo, falla la propia construcción.",{"_6944":124095,"_42621":124006,"_30085":202950,"_5":21646,"_28538":202744,"_5847":202951},[],"**Coste.** Una construcción por dispositivo ejecuta un proceso `swugenerator` por dispositivo, en paralelo hasta la CPU disponible para el contenedor. Con un artefacto de 100 MB, un dispositivo cuesta aproximadamente medio segundo de cifrado, más unos tres segundos adicionales si la sw-description pide compresión gzip. Dimensiona el contenedor en consecuencia: consulta Dimensionado de recursos. Las construcciones del mismo paquete se serializan: una segunda construcción o un cambio de versión mientras otra se ejecuta responde `409`.",{"_6944":124096,"_42621":124006,"_30085":202953,"_5":21646,"_28538":202748,"_5847":202954},[],"SymKMS es el servicio de claves simétricas integrado, servido por el mismo proceso bajo `/symkms/v1`. Almacena claves, las asigna a dispositivos y también puede cifrar, descifrar y calcular MAC. Las claves se guardan en el almacén de blobs `symkms`, opcionalmente con cifrado en reposo. Crea las claves con la longitud correcta para su algoritmo: bytes aleatorios, nunca una frase de contraseña.",{"_6944":124097,"_42621":124006,"_30085":202956,"_5":21646,"_28538":202748,"_5847":202957},[],"Tarea",{"_6944":124098,"_42621":124006,"_30085":202959,"_5":21646,"_28538":202748,"_5847":197196},[],{"_6944":124099,"_42621":124006,"_30085":202961,"_5":21646,"_28538":202748,"_5847":202962},[],"Guardar una clave",{"_6944":124100,"_42621":124006,"_30085":202964,"_5":21646,"_28538":202748,"_5847":93776},[],{"_6944":124101,"_42621":124006,"_30085":202966,"_5":21646,"_28538":202748,"_5847":202967},[],"Listar las claves de un usuario",{"_6944":124102,"_42621":124006,"_30085":202969,"_5":21646,"_28538":202748,"_5847":93782},[],{"_6944":124103,"_42621":124006,"_30085":202971,"_5":21646,"_28538":202748,"_5847":202972},[],"Borrar una clave",{"_6944":124104,"_42621":124006,"_30085":202974,"_5":21646,"_28538":202748,"_5847":93788},[],{"_6944":124105,"_42621":124006,"_30085":202976,"_5":21646,"_28538":202748,"_5847":202977},[],"Asignar o revocar una clave a un dispositivo",{"_6944":124106,"_42621":124006,"_30085":202979,"_5":21646,"_28538":202748,"_5847":202980},[],"`POST` o `DELETE /symkms/v1/inventory/:deviceID/keys/:keyID`",{"_6944":124107,"_42621":124006,"_30085":202982,"_5":21646,"_28538":202748,"_5847":202983},[],"La clave activa de un dispositivo (privilegiada, devuelve material de clave)",{"_6944":124108,"_42621":124006,"_30085":202985,"_5":21646,"_28538":202748,"_5847":93800},[],{"_6944":124109,"_42621":124006,"_30085":202987,"_5":21646,"_28538":202748,"_5847":202988},[],"Qué dispositivos usan una clave",{"_6944":124110,"_42621":124006,"_30085":202990,"_5":21646,"_28538":202748,"_5847":93806},[],{"_6944":124111,"_42621":124006,"_30085":202992,"_5":21646,"_28538":202748,"_5847":202993},[],"Las asignaciones de clave de un dispositivo",{"_6944":124112,"_42621":124006,"_30085":202995,"_5":21646,"_28538":202748,"_5847":93812},[],{"_6944":124113,"_42621":124006,"_30085":202997,"_5":21646,"_28538":202748,"_5847":202998},[],"Cifrar, descifrar",{"_6944":124114,"_42621":124006,"_30085":203000,"_5":21646,"_28538":202748,"_5847":93818},[],{"_6944":124115,"_42621":124006,"_30085":203002,"_5":21646,"_28538":202748,"_5847":203003},[],"Calcular y verificar MAC",{"_6944":124116,"_42621":124006,"_30085":203005,"_5":21646,"_28538":202748,"_5847":203006},[],"`POST /symkms/v1/mac`, `POST /symkms/v1/mac/verify` (y las variantes `/file`)",{"_6944":124117,"_42621":124006,"_30085":203008,"_5":21646,"_28538":202751,"_5847":197196},[],{"_6944":124118,"_42621":124006,"_30085":203010,"_5":21646,"_28538":202751,"_5847":203011},[],"Cuerpo (JSON)",{"_6944":124119,"_42621":124006,"_30085":203013,"_5":21646,"_28538":202751,"_5847":93776},[],{"_6944":124120,"_42621":124006,"_30085":203015,"_5":21646,"_28538":202751,"_5847":203016},[],"`user_id`, `algorithm`, `key` (hex o base64; se prueba hex primero), `id` opcional. `user_id`, `algorithm` y `key` son obligatorios.",{"_6944":124121,"_42621":124006,"_30085":203018,"_5":21646,"_28538":202751,"_5847":93837},[],{"_6944":124122,"_42621":124006,"_30085":203020,"_5":21646,"_28538":202751,"_5847":203021},[],"`user_id`, `key_name`, `algorithm`, `plaintext` (base64), `iv` opcional, `format` opcional.",{"_6944":124123,"_42621":124006,"_30085":203023,"_5":21646,"_28538":202751,"_5847":93843},[],{"_6944":124124,"_42621":124006,"_30085":203025,"_5":21646,"_28538":202751,"_5847":203026},[],"`user_id`, `key_name`, `algorithm`, `ciphertext`, `iv`, `format` opcional.",{"_6944":124125,"_42621":124006,"_30085":203028,"_5":21646,"_28538":202751,"_5847":93849},[],{"_6944":124126,"_42621":124006,"_30085":203030,"_5":21646,"_28538":202751,"_5847":203031},[],"`user_id`, `key_name`, `mac_algorithm`, `data` (base64). El MAC se devuelve en hex.",{"_6944":124127,"_42621":124006,"_30085":203033,"_5":21646,"_28538":202751,"_5847":93855},[],{"_6944":124128,"_42621":124006,"_30085":203035,"_5":21646,"_28538":202751,"_5847":203036},[],"Igual que `/mac`, más `mac` (hex).",{"_6944":124129,"_42621":124006,"_30085":203038,"_5":21646,"_28538":202751,"_5847":203039},[],"`format` es `ciphertext` (hex, el valor por defecto), `base64` o `cms` (`pkcs7` es un alias): una estructura CMS codificada en PEM que incluye el algoritmo y el IV. Con `cms`, `decrypt` puede omitir `algorithm` e `iv`.",{"_6944":124130,"_42621":124006,"_30085":203041,"_5":21646,"_28538":202751,"_5847":203042},[],"El servidor genera el nonce para GCM, CTR y Ascon: **se rechaza un `iv` aportado por quien llama** para esos algoritmos. Solo CBC acepta uno (16 bytes). La respuesta incluye el `iv` usado (hex).",{"_6944":124131,"_42621":124006,"_30085":203044,"_5":21646,"_28538":202751,"_5847":203045},[],"`mac_algorithm` es `HMAC-SHA3-256`, `AES-CMAC` o `ASCON-MAC`. Las variantes `/file` reciben los datos como `multipart/form-data`.",{"_6944":124132,"_42621":124006,"_30085":203047,"_5":21646,"_28538":202751,"_5847":203048},[],"`GET /symkms/v1/:keyID/raw?user_id=...` y `GET /symkms/v1/inventory/:deviceID/key` devuelven material de clave sin protección y son privilegiadas: el propio servicio Updates las llama durante una construcción. El servicio no tiene autenticación propia, así que restringe estas rutas en un gateway. Consulta Seguridad.",{"_6944":124133,"_42621":124006,"_30085":203050,"_5":21646,"_28538":202751,"_5847":203051},[],"Las mismas rutas de SymKMS pueden ejecutarse como proceso propio (`cmd/symkms`) en lugar de dentro del monolito. Consulta Configuración.",{"_6944":124134,"_42621":124134,"_5":22076,"_5847":195477,"_43101":203053,"_30085":203054,"_28538":124134},[78004,189200,195583,188960],[],{"_6944":124135,"_42621":124134,"_30085":203056,"_5":21646,"_28538":124134,"_5847":203057},[],"Síntomas, causas probables y soluciones para errores de arranque, llamadas a la API, construcciones, descargas y actualizaciones que no llegan a los dispositivos.",{"_6944":124136,"_42621":124134,"_5":43098,"_30085":203059,"_28538":203060,"_5847":203061},[],"/docs/pr-preview/pr-56/es/platform/updates/troubleshooting#códigos-de-estado-http","Códigos de estado HTTP",{"_6944":124137,"_42621":124134,"_5":43098,"_30085":203063,"_28538":203064,"_5847":203065},[],"/docs/pr-preview/pr-56/es/platform/updates/troubleshooting#arranque-del-servicio","Arranque del servicio",{"_6944":124138,"_42621":124134,"_5":43098,"_30085":203067,"_28538":203068,"_5847":203069},[],"/docs/pr-preview/pr-56/es/platform/updates/troubleshooting#llamadas-a-la-api","Llamadas a la API",{"_6944":124139,"_42621":124134,"_5":43098,"_30085":203071,"_28538":203072,"_5847":203073},[],"/docs/pr-preview/pr-56/es/platform/updates/troubleshooting#construcciones","Construcciones",{"_6944":124140,"_42621":124134,"_5":43098,"_30085":203075,"_28538":203076,"_5847":203077},[],"/docs/pr-preview/pr-56/es/platform/updates/troubleshooting#descargas-y-urls-prefirmadas","Descargas y URLs prefirmadas",{"_6944":124141,"_42621":124134,"_5":43098,"_30085":203079,"_28538":203080,"_5847":203081},[],"/docs/pr-preview/pr-56/es/platform/updates/troubleshooting#actualizaciones-que-no-llegan-a-los-dispositivos","Actualizaciones que no llegan a los dispositivos",{"_6944":124142,"_42621":124134,"_5":43098,"_30085":203083,"_28538":203084,"_5847":203085},[],"/docs/pr-preview/pr-56/es/platform/updates/troubleshooting#escalado-y-trabajo-en-segundo-plano","Escalado y trabajo en segundo plano",{"_6944":124143,"_42621":124134,"_5":43098,"_30085":203087,"_28538":203088,"_5847":203089},[],"/docs/pr-preview/pr-56/es/platform/updates/troubleshooting#obtener-más-información","Obtener más información",{"_6944":124144,"_42621":124134,"_30085":203091,"_5":21646,"_28538":124134,"_5847":203092},[],"Diagnostica una operación cada vez. Anota el backend (`GET /updates/v1/capabilities` lo muestra), el endpoint, el estado HTTP y el texto `err` del cuerpo de la respuesta: los errores se devuelven como `{\"err\": \"...\"}`. Si tu problema no está aquí, consulta primero Limitaciones.",{"_6944":124145,"_42621":124134,"_30085":203094,"_5":21646,"_28538":203060,"_5847":196005},[],{"_6944":124146,"_42621":124134,"_30085":203096,"_5":21646,"_28538":203060,"_5847":195948},[],{"_6944":124147,"_42621":124134,"_30085":203098,"_5":21646,"_28538":203060,"_5847":90618},[],{"_6944":124148,"_42621":124134,"_30085":203100,"_5":21646,"_28538":203060,"_5847":203101},[],"La petición o el estado actual del recurso no permite la operación. El mensaje indica qué cambiar.",{"_6944":124149,"_42621":124134,"_30085":203103,"_5":21646,"_28538":203060,"_5847":90624},[],{"_6944":124150,"_42621":124134,"_30085":203105,"_5":21646,"_28538":203060,"_5847":203106},[],"Una política rechaza la operación.",{"_6944":124151,"_42621":124134,"_30085":203108,"_5":21646,"_28538":203060,"_5847":90630},[],{"_6944":124152,"_42621":124134,"_30085":203110,"_5":21646,"_28538":203060,"_5847":203111},[],"El recurso no existe. El lanzamiento de otro grupo también responde `404`.",{"_6944":124153,"_42621":124134,"_30085":203113,"_5":21646,"_28538":203060,"_5847":90636},[],{"_6944":124154,"_42621":124134,"_30085":203115,"_5":21646,"_28538":203060,"_5847":203116},[],"Hay una operación en conflicto en curso, o la versión ya está construida.",{"_6944":124155,"_42621":124134,"_30085":203118,"_5":21646,"_28538":203060,"_5847":90642},[],{"_6944":124156,"_42621":124134,"_30085":203120,"_5":21646,"_28538":203060,"_5847":203121},[],"Un fichero supera `max_artifact_size_mb`.",{"_6944":124157,"_42621":124134,"_30085":203123,"_5":21646,"_28538":203060,"_5847":93946},[],{"_6944":124158,"_42621":124134,"_30085":203125,"_5":21646,"_28538":203060,"_5847":203126},[],"Un fallo inesperado. Algunos errores de validación siguen respondiendo `500` (consulta más abajo).",{"_6944":124159,"_42621":124134,"_30085":203128,"_5":21646,"_28538":203060,"_5847":90648},[],{"_6944":124160,"_42621":124134,"_30085":203130,"_5":21646,"_28538":203060,"_5847":203131},[],"El backend activo no soporta la operación. Lee las capacidades.",{"_6944":124161,"_42621":124134,"_30085":203133,"_5":21646,"_28538":203064,"_5847":191373},[],{"_6944":124162,"_42621":124134,"_30085":203135,"_5":21646,"_28538":203064,"_5847":196825},[],{"_6944":124163,"_42621":124134,"_30085":203137,"_5":21646,"_28538":203064,"_5847":203138},[],"Solución",{"_6944":124164,"_42621":124134,"_30085":203140,"_5":21646,"_28538":203064,"_5847":203141},[],"`docker compose up` falla con un error de red",{"_6944":124165,"_42621":124134,"_30085":203143,"_5":21646,"_28538":203064,"_5847":203144},[],"La red `ota-net` no existe",{"_6944":124166,"_42621":124134,"_30085":203146,"_5":21646,"_28538":203064,"_5847":93970},[],{"_6944":124167,"_42621":124134,"_30085":203148,"_5":21646,"_28538":203064,"_5847":203149},[],"La construcción de Docker no encuentra `lamassuiot/core`",{"_6944":124168,"_42621":124134,"_30085":203151,"_5":21646,"_28538":203064,"_5847":203152},[],"El contexto de construcción no es el padre del checkout",{"_6944":124169,"_42621":124134,"_30085":203154,"_5":21646,"_28538":203064,"_5847":203155},[],"Construye con el contexto que contiene `ota/`, `lamassuiot/core` y `lamassuiot/sdk`. `docker compose build updates` lo usa.",{"_6944":124170,"_42621":124134,"_30085":203157,"_5":21646,"_28538":203064,"_5847":203158},[],"El servicio ignora `OTA_CONFIG_FILE` y registra una advertencia",{"_6944":124171,"_42621":124134,"_30085":203160,"_5":21646,"_28538":203064,"_5847":203161},[],"No se pudo cargar el fichero, así que recurrió a `/etc/lamassuiot/config.yml`",{"_6944":124172,"_42621":124134,"_30085":203163,"_5":21646,"_28538":203064,"_5847":203164},[],"Revisa la ruta y el YAML. En la imagen, esa alternativa es la configuración de desarrollo del repositorio.",{"_6944":124173,"_42621":124134,"_30085":203166,"_5":21646,"_28538":203064,"_5847":93991},[],{"_6944":124174,"_42621":124134,"_30085":203168,"_5":21646,"_28538":203064,"_5847":203169},[],"`workflow_file` no nombra el workflow `direct`",{"_6944":124175,"_42621":124134,"_30085":203171,"_5":21646,"_28538":203064,"_5847":203172},[],"Apúntalo a `wfx.workflow.dau.direct.yml` o a una ruta que contenga `direct`.",{"_6944":124176,"_42621":124134,"_30085":203174,"_5":21646,"_28538":203064,"_5847":94000},[],{"_6944":124177,"_42621":124134,"_30085":203176,"_5":21646,"_28538":203064,"_5847":203177},[],"`wfx_endpoint` es incorrecto o WFX está caído",{"_6944":124178,"_42621":124134,"_30085":203179,"_5":21646,"_28538":203064,"_5847":203180},[],"Usa el puerto de **gestión** (`8081` dentro de la red de Compose, `9081` en el host) y comprueba que `custom-wfx` se ejecuta.",{"_6944":124179,"_42621":124134,"_30085":203182,"_5":21646,"_28538":203064,"_5847":203183},[],"Postgres informa de que la base de datos `updates` no existe",{"_6944":124180,"_42621":124134,"_30085":203185,"_5":21646,"_28538":203064,"_5847":203186},[],"El servicio no crea la base de datos",{"_6944":124181,"_42621":124134,"_30085":203188,"_5":21646,"_28538":203064,"_5847":203189},[],"Créala (Docker Compose lo hace con `init.sql`).",{"_6944":124182,"_42621":124134,"_30085":203191,"_5":21646,"_28538":203064,"_5847":94018},[],{"_6944":124183,"_42621":124134,"_30085":203193,"_5":21646,"_28538":203064,"_5847":203194},[],"Falta la clave",{"_6944":124184,"_42621":124134,"_30085":203196,"_5":21646,"_28538":203064,"_5847":203197},[],"Define `hawkbit.base_url`.",{"_6944":124185,"_42621":124134,"_30085":203199,"_5":21646,"_28538":203064,"_5847":94027},[],{"_6944":124186,"_42621":124134,"_30085":203201,"_5":21646,"_28538":203064,"_5847":203202},[],"`storage.hostname` está vacío",{"_6944":124187,"_42621":124134,"_30085":203204,"_5":21646,"_28538":203064,"_5847":203205},[],"Define el bloque `storage`.",{"_6944":124188,"_42621":124134,"_30085":203207,"_5":21646,"_28538":203064,"_5847":94036},[],{"_6944":124189,"_42621":124134,"_30085":203209,"_5":21646,"_28538":203064,"_5847":203210},[],"Bucket, endpoint o credenciales incorrectos, o el bucket no existe",{"_6944":124190,"_42621":124134,"_30085":203212,"_5":21646,"_28538":203064,"_5847":203213},[],"Corrige las claves `s3_*` del bloque que nombra el error. El bucket debe existir ya.",{"_6944":124191,"_42621":124134,"_30085":203215,"_5":21646,"_28538":203064,"_5847":94045},[],{"_6944":124192,"_42621":124134,"_30085":203217,"_5":21646,"_28538":203064,"_5847":203218},[],"`encryption.local_key` no son 32 bytes en hexadecimal",{"_6944":124193,"_42621":124134,"_30085":203220,"_5":21646,"_28538":203064,"_5847":203221},[],"Usa 64 caracteres hexadecimales (`openssl rand -hex 32`).",{"_6944":124194,"_42621":124134,"_30085":203223,"_5":21646,"_28538":203064,"_5847":94054},[],{"_6944":124195,"_42621":124134,"_30085":203225,"_5":21646,"_28538":203064,"_5847":203226},[],"El pod no puede usar Leases y `leaderElection.mode` es `kubernetes`",{"_6944":124196,"_42621":124134,"_30085":203228,"_5":21646,"_28538":203064,"_5847":203229},[],"Concede el Role que proporciona el chart (`serviceAccount.create: true`), o define `leaderElection.mode: database`.",{"_6944":124197,"_42621":124134,"_30085":203231,"_5":21646,"_28538":203064,"_5847":94063},[],{"_6944":124198,"_42621":124134,"_30085":203233,"_5":21646,"_28538":203064,"_5847":203234},[],"`leader_election.mode: kubernetes` fuera de un clúster",{"_6944":124199,"_42621":124134,"_30085":203236,"_5":21646,"_28538":203064,"_5847":203237},[],"Usa vacío (automático) o `database`.",{"_6944":124200,"_42621":124134,"_30085":203239,"_5":21646,"_28538":203064,"_5847":203240},[],"`builds.presign: ...` o `hawkbit.artifact_store.presign: ...`",{"_6944":124201,"_42621":124134,"_30085":203242,"_5":21646,"_28538":203064,"_5847":203243},[],"Los ajustes de descarga prefirmada de ese bloque no son válidos",{"_6944":124202,"_42621":124134,"_30085":203245,"_5":21646,"_28538":203064,"_5847":203246},[],"Consulta Descargas y URLs prefirmadas.",{"_6944":124203,"_42621":124134,"_30085":203248,"_5":21646,"_28538":203064,"_5847":203249},[],"El contenedor de hawkBit termina",{"_6944":124204,"_42621":124134,"_30085":203251,"_5":21646,"_28538":203064,"_5847":203252},[],"Se selecciona almacenamiento S3 para hawkBit y el bucket no es alcanzable",{"_6944":124205,"_42621":124134,"_30085":203254,"_5":21646,"_28538":203064,"_5847":203255},[],"Corrige los ajustes de S3, o usa `HAWKBIT_ARTIFACT_STORAGE=fs`. hawkBit nunca recurre en silencio al disco local.",{"_6944":124206,"_42621":124134,"_30085":203257,"_5":21646,"_28538":203064,"_5847":203258},[],"`/health` responde pero fallan las llamadas a WFX",{"_6944":124207,"_42621":124134,"_30085":203260,"_5":21646,"_28538":203064,"_5847":203261},[],"`/health` no comprueba las dependencias",{"_6944":124208,"_42621":124134,"_30085":203263,"_5":21646,"_28538":203064,"_5847":203264},[],"Revisa `wfx_endpoint` y que WFX se está ejecutando.",{"_6944":124209,"_42621":124134,"_30085":203266,"_5":21646,"_28538":203064,"_5847":203267},[],"La salida de depuración muestra secretos",{"_6944":124210,"_42621":124134,"_30085":203269,"_5":21646,"_28538":203064,"_5847":203270},[],"`app.logs.level: debug` imprime la configuración",{"_6944":124211,"_42621":124134,"_30085":203272,"_5":21646,"_28538":203064,"_5847":203273},[],"Usa `info`. Consulta Seguridad.",{"_6944":124212,"_42621":124134,"_30085":203275,"_5":21646,"_28538":203068,"_5847":191373},[],{"_6944":124213,"_42621":124134,"_30085":203277,"_5":21646,"_28538":203068,"_5847":196825},[],{"_6944":124214,"_42621":124134,"_30085":203279,"_5":21646,"_28538":203068,"_5847":203138},[],{"_6944":124215,"_42621":124134,"_30085":203281,"_5":21646,"_28538":203068,"_5847":94114},[],{"_6944":124216,"_42621":124134,"_30085":203283,"_5":21646,"_28538":203068,"_5847":203284},[],"El backend activo no soporta la operación",{"_6944":124217,"_42621":124134,"_30085":203286,"_5":21646,"_28538":203068,"_5847":203287},[],"Lee `GET /updates/v1/capabilities`. En modo `hawkbit`, `POST .../swu` y `.../package` responden siempre `501`: construye los módulos en el catálogo.",{"_6944":124218,"_42621":124134,"_30085":203289,"_5":21646,"_28538":203068,"_5847":94123},[],{"_6944":124219,"_42621":124134,"_30085":203291,"_5":21646,"_28538":203068,"_5847":203292},[],"Has cambiado una versión construida",{"_6944":124220,"_42621":124134,"_30085":203294,"_5":21646,"_28538":203068,"_5847":203295},[],"Modo native: `POST .../new` con `{\"version\":\"x.y.z\"}` mayor que la actual, vuelve a subir la sw-description (no se arrastra) y da una `version` mayor a cualquier artefacto que vuelvas a subir. Modo `hawkbit`: consulta la fila siguiente.",{"_6944":124221,"_42621":124134,"_30085":203297,"_5":21646,"_28538":203068,"_5847":94132},[],{"_6944":124222,"_42621":124134,"_30085":203299,"_5":21646,"_28538":203068,"_5847":203300},[],"En modo `hawkbit` se rechazan las ediciones con ámbito de paquete",{"_6944":124223,"_42621":124134,"_30085":203302,"_5":21646,"_28538":203068,"_5847":203303},[],"Desenlaza el módulo, cámbialo y constrúyelo en el catálogo, y enlázalo de nuevo. O publica una versión nueva del módulo y crea un paquete a partir de ella con otro nombre: los nombres de paquete son únicos por grupo, y un módulo `os` no se puede intercambiar en un paquete existente. Consulta Modo hawkBit.",{"_6944":124224,"_42621":124134,"_30085":203305,"_5":21646,"_28538":203068,"_5847":94141},[],{"_6944":124225,"_42621":124134,"_30085":203307,"_5":21646,"_28538":203068,"_5847":203308},[],"Dos construcciones, o una construcción y un cambio, sobre el mismo paquete o módulo",{"_6944":124226,"_42621":124134,"_30085":203310,"_5":21646,"_28538":203068,"_5847":203311},[],"Espera y reintenta. El bloqueo se libera cuando la operación termina o falla.",{"_6944":124227,"_42621":124134,"_30085":203313,"_5":21646,"_28538":203068,"_5847":203314},[],"`409` al crear",{"_6944":124228,"_42621":124134,"_30085":203316,"_5":21646,"_28538":203068,"_5847":203317},[],"Ya existe un paquete con ese nombre en el grupo",{"_6944":124229,"_42621":124134,"_30085":203319,"_5":21646,"_28538":203068,"_5847":203320},[],"Elige otro nombre.",{"_6944":124230,"_42621":124134,"_30085":203322,"_5":21646,"_28538":203068,"_5847":94159},[],{"_6944":124231,"_42621":124134,"_30085":203324,"_5":21646,"_28538":203068,"_5847":198622},[],{"_6944":124232,"_42621":124134,"_30085":203326,"_5":21646,"_28538":203068,"_5847":203327},[],"Auméntalo y aumenta también los límites de todos los proxies que haya delante. Consulta Operaciones. Un proxy que responde `413` con su propio cuerpo (por ejemplo el 1 MiB por defecto de nginx) es el proxy, no el servicio.",{"_6944":124233,"_42621":124134,"_30085":203329,"_5":21646,"_28538":203068,"_5847":203330},[],"Subida `400` que menciona un contenido que contradice el nombre del fichero",{"_6944":124234,"_42621":124134,"_30085":203332,"_5":21646,"_28538":203068,"_5847":203333},[],"Un fichero llamado `.swu` no es un SWU",{"_6944":124235,"_42621":124134,"_30085":203335,"_5":21646,"_28538":203068,"_5847":203336},[],"Sube un `.swu` real, o renombra el fichero.",{"_6944":124236,"_42621":124134,"_30085":203338,"_5":21646,"_28538":203068,"_5847":203339},[],"La subida de un artefacto falla con `500` y `version X must be greater than the current latest version`",{"_6944":124237,"_42621":124134,"_30085":203341,"_5":21646,"_28538":203068,"_5847":203342},[],"Los nombres de artefacto son globales, y un nombre solo se puede reutilizar con una `version` mayor",{"_6944":124238,"_42621":124134,"_30085":203344,"_5":21646,"_28538":203068,"_5847":203345},[],"Da al fichero nuevo una `version` mayor, o un nombre de artefacto nuevo.",{"_6944":124239,"_42621":124134,"_30085":203347,"_5":21646,"_28538":203068,"_5847":94186},[],{"_6944":124240,"_42621":124134,"_30085":203349,"_5":21646,"_28538":203068,"_5847":203350},[],"El paquete sigue siendo un borrador",{"_6944":124241,"_42621":124134,"_30085":203352,"_5":21646,"_28538":203068,"_5847":203353},[],"Constrúyelo primero.",{"_6944":124242,"_42621":124134,"_30085":203355,"_5":21646,"_28538":203068,"_5847":94195},[],{"_6944":124243,"_42621":124134,"_30085":203357,"_5":21646,"_28538":203068,"_5847":203358},[],"Algunos dispositivos no tienen clave",{"_6944":124244,"_42621":124134,"_30085":203360,"_5":21646,"_28538":203068,"_5847":203361},[],"Asigna las claves que faltan y construye de nuevo. No hay forma de forzarlo.",{"_6944":124245,"_42621":124134,"_30085":203363,"_5":21646,"_28538":203068,"_5847":94204},[],{"_6944":124246,"_42621":124134,"_30085":203365,"_5":21646,"_28538":203068,"_5847":203366},[],"Los umbrales son porcentajes",{"_6944":124247,"_42621":124134,"_30085":203368,"_5":21646,"_28538":203068,"_5847":203369},[],"Usa `0`-`100`.",{"_6944":124248,"_42621":124134,"_30085":203371,"_5":21646,"_28538":203068,"_5847":94213},[],{"_6944":124249,"_42621":124134,"_30085":203373,"_5":21646,"_28538":203068,"_5847":203374},[],"El lanzamiento estaba en pausa",{"_6944":124250,"_42621":124134,"_30085":203376,"_5":21646,"_28538":203068,"_5847":203377},[],"Llama a `resume`.",{"_6944":124251,"_42621":124134,"_30085":203379,"_5":21646,"_28538":203068,"_5847":203380},[],"`test device X cannot act as this group's canary: device X does not exist` (modo `hawkbit`)",{"_6944":124252,"_42621":124134,"_30085":203382,"_5":21646,"_28538":203068,"_5847":203383},[],"La comprobación del canario se ejecuta antes de que los dispositivos del grupo existan en hawkBit",{"_6944":124253,"_42621":124134,"_30085":203385,"_5":21646,"_28538":203068,"_5847":203386},[],"Ejecuta antes una simulación sin `test_device_id` (`POST .../launch?dry_run=true`), que registra los dispositivos como targets.",{"_6944":124254,"_42621":124134,"_30085":203388,"_5":21646,"_28538":203068,"_5847":203389},[],"El registro de dispositivos o el KMS responde `401`",{"_6944":124255,"_42621":124134,"_30085":203391,"_5":21646,"_28538":203068,"_5847":203392},[],"El servicio envía siempre `X-Principal-ID: admin-mode`, y el gateway intermedio lo rechaza",{"_6944":124256,"_42621":124134,"_30085":203394,"_5":21646,"_28538":203068,"_5847":203395},[],"Apunta `dms_endpoint` y `kms_endpoint` a las direcciones internas de los servicios, o permite esa cabecera.",{"_6944":124257,"_42621":124134,"_30085":203397,"_5":21646,"_28538":203072,"_5847":191373},[],{"_6944":124258,"_42621":124134,"_30085":203399,"_5":21646,"_28538":203072,"_5847":196825},[],{"_6944":124259,"_42621":124134,"_30085":203401,"_5":21646,"_28538":203072,"_5847":203138},[],{"_6944":124260,"_42621":124134,"_30085":203403,"_5":21646,"_28538":203072,"_5847":94246},[],{"_6944":124261,"_42621":124134,"_30085":203405,"_5":21646,"_28538":203072,"_5847":203406},[],"La versión no tiene sw-description (cada versión necesita la suya)",{"_6944":124262,"_42621":124134,"_30085":203408,"_5":21646,"_28538":203072,"_5847":203409},[],"Súbela.",{"_6944":124263,"_42621":124134,"_30085":203411,"_5":21646,"_28538":203072,"_5847":203412},[],"`failed to read binaries directory` o `binaries directory is empty`",{"_6944":124264,"_42621":124134,"_30085":203414,"_5":21646,"_28538":203072,"_5847":203415},[],"Modo `native`: no se preparó nada, porque el cuerpo de la construcción no tiene `selected_artifact_ids`",{"_6944":124265,"_42621":124134,"_30085":203417,"_5":21646,"_28538":203072,"_5847":203418},[],"Pasa los IDs de los artefactos. Consulta la guía de publicación.",{"_6944":124266,"_42621":124134,"_30085":203420,"_5":21646,"_28538":203072,"_5847":94264},[],{"_6944":124267,"_42621":124134,"_30085":203422,"_5":21646,"_28538":203072,"_5847":203423},[],"La herramienta rechazó su entrada. Su propio mensaje está en el registro del servicio",{"_6944":124268,"_42621":124134,"_30085":203425,"_5":21646,"_28538":203072,"_5847":203426},[],"Revisa la sw-description, los nombres de fichero que referencia, la grafía del algoritmo (`aes-256-gcm`, guiones obligatorios) y la longitud de la clave.",{"_6944":124269,"_42621":124134,"_30085":203428,"_5":21646,"_28538":203072,"_5847":94273},[],{"_6944":124270,"_42621":124134,"_30085":203430,"_5":21646,"_28538":203072,"_5847":203431},[],"Se pidió firmar un `.swu` sin ambos ajustes",{"_6944":124271,"_42621":124134,"_30085":203433,"_5":21646,"_28538":203072,"_5847":203434},[],"Define `sign_script_path` y `kms_endpoint`.",{"_6944":124272,"_42621":124134,"_30085":203436,"_5":21646,"_28538":203072,"_5847":94282},[],{"_6944":124273,"_42621":124134,"_30085":203438,"_5":21646,"_28538":203072,"_5847":203439},[],"Una petición de firma parcial",{"_6944":124274,"_42621":124134,"_30085":203441,"_5":21646,"_28538":203072,"_5847":203442},[],"Envía los tres campos `signature_*`.",{"_6944":124275,"_42621":124134,"_30085":203444,"_5":21646,"_28538":203072,"_5847":94291},[],{"_6944":124276,"_42621":124134,"_30085":203446,"_5":21646,"_28538":203072,"_5847":203447},[],"El KMS respondió con una firma simple",{"_6944":124277,"_42621":124134,"_30085":203449,"_5":21646,"_28538":203072,"_5847":203450},[],"Usa una versión del KMS que devuelva CMS. Consulta Firma y cifrado.",{"_6944":124278,"_42621":124134,"_30085":203452,"_5":21646,"_28538":203072,"_5847":94300},[],{"_6944":124279,"_42621":124134,"_30085":203454,"_5":21646,"_28538":203072,"_5847":203455},[],"`symkms_endpoint` está vacío",{"_6944":124280,"_42621":124134,"_30085":203457,"_5":21646,"_28538":203072,"_5847":203458},[],"Defínelo. En modo `hawkbit` define también el bloque `symkms` para que existan las rutas.",{"_6944":124281,"_42621":124134,"_30085":203460,"_5":21646,"_28538":203072,"_5847":94309},[],{"_6944":124282,"_42621":124134,"_30085":203462,"_5":21646,"_28538":203072,"_5847":203463},[],"ID de clave o `user` incorrectos, o el endpoint apunta a otra instancia",{"_6944":124283,"_42621":124134,"_30085":203465,"_5":21646,"_28538":203072,"_5847":203466},[],"La clave pertenece a su `user_id`; `symkms_endpoint` debe ser la dirección y el puerto propios de esta instancia.",{"_6944":124284,"_42621":124134,"_30085":203468,"_5":21646,"_28538":203072,"_5847":203469},[],"Una construcción por dispositivo falla mencionando `encrypted = true`",{"_6944":124285,"_42621":124134,"_30085":203471,"_5":21646,"_28538":203072,"_5847":203472},[],"Ningún artefacto de la sw-description está marcado con `encrypted = true;`",{"_6944":124286,"_42621":124134,"_30085":203474,"_5":21646,"_28538":203072,"_5847":203475},[],"Marca los artefactos a cifrar.",{"_6944":124287,"_42621":124134,"_30085":203477,"_5":21646,"_28538":203072,"_5847":203478},[],"`no devices found for DMS X` o `none of the N devices ... have a key assigned for firmware-encryption`",{"_6944":124288,"_42621":124134,"_30085":203480,"_5":21646,"_28538":203072,"_5847":203481},[],"El grupo no tiene dispositivos en el registro, o ninguno tiene clave",{"_6944":124289,"_42621":124134,"_30085":203483,"_5":21646,"_28538":203072,"_5847":203484},[],"Revisa el grupo en Lamassu IoT y `dms_endpoint`; asigna claves `firmware-encryption`.",{"_6944":124290,"_42621":124134,"_30085":203486,"_5":21646,"_28538":203072,"_5847":94336},[],{"_6944":124291,"_42621":124134,"_30085":203488,"_5":21646,"_28538":203072,"_5847":203489},[],"`swugenerator_path` está vacío",{"_6944":124292,"_42621":124134,"_30085":203491,"_5":21646,"_28538":203072,"_5847":203492},[],"Defínelo, o sube un módulo `.swu` precompilado.",{"_6944":124293,"_42621":124134,"_30085":203494,"_5":21646,"_28538":203072,"_5847":203495},[],"`hawkbit mode: this deployment has no SymKMS configured` o `... no KMS endpoint configured` (`501`)",{"_6944":124294,"_42621":124134,"_30085":203497,"_5":21646,"_28538":203072,"_5847":203498},[],"Se pidió cifrar o firmar sin `symkms_endpoint` o `kms_endpoint`",{"_6944":124295,"_42621":124134,"_30085":203500,"_5":21646,"_28538":203072,"_5847":203501},[],"Defínelos.",{"_6944":124296,"_42621":124134,"_30085":203503,"_5":21646,"_28538":203072,"_5847":94354},[],{"_6944":124297,"_42621":124134,"_30085":203505,"_5":21646,"_28538":203072,"_5847":203506},[],"`build_memory_limit_mb` rechaza la construcción",{"_6944":124298,"_42621":124134,"_30085":203508,"_5":21646,"_28538":203072,"_5847":203509},[],"Firma sin cifrar, divide el fichero, o sube el límite junto con la memoria del pod.",{"_6944":124299,"_42621":124134,"_30085":203511,"_5":21646,"_28538":203072,"_5847":94363},[],{"_6944":124300,"_42621":124134,"_30085":203513,"_5":21646,"_28538":203072,"_5847":203514},[],"Una construcción sustituye los ficheros de entrada del módulo",{"_6944":124301,"_42621":124134,"_30085":203516,"_5":21646,"_28538":203072,"_5847":203517},[],"Crea una versión nueva del módulo.",{"_6944":124302,"_42621":124134,"_30085":203519,"_5":21646,"_28538":203076,"_5847":191373},[],{"_6944":124303,"_42621":124134,"_30085":203521,"_5":21646,"_28538":203076,"_5847":196825},[],{"_6944":124304,"_42621":124134,"_30085":203523,"_5":21646,"_28538":203076,"_5847":203138},[],{"_6944":124305,"_42621":124134,"_30085":203525,"_5":21646,"_28538":203076,"_5847":94378},[],{"_6944":124306,"_42621":124134,"_30085":203527,"_5":21646,"_28538":203076,"_5847":203528},[],"El paquete está cifrado por dispositivo y no tiene paquete para ese dispositivo (faltaba su clave al construir, o el paquete heredó el modo por dispositivo de una versión anterior), o el fichero de la construcción ya no está en el almacén",{"_6944":124307,"_42621":124134,"_30085":203530,"_5":21646,"_28538":203076,"_5847":203531},[],"Asigna la clave del dispositivo y construye una versión nueva. Para evitar heredar, usa un paquete distinto para cada variante de cifrado (consulta Limitaciones).",{"_6944":124308,"_42621":124134,"_30085":203533,"_5":21646,"_28538":203076,"_5847":203534},[],"Arranque: `presign needs its own credential`",{"_6944":124309,"_42621":124134,"_30085":203536,"_5":21646,"_28538":203076,"_5847":203537},[],"`presign` está activado sin credencial de firma",{"_6944":124310,"_42621":124134,"_30085":203539,"_5":21646,"_28538":203076,"_5847":203540},[],"Define `presign.access_key_id[_file]` y `secret_access_key[_file]`, un par de solo lectura.",{"_6944":124311,"_42621":124134,"_30085":203542,"_5":21646,"_28538":203076,"_5847":203543},[],"Arranque: `the presign credential can WRITE`",{"_6944":124312,"_42621":124134,"_30085":203545,"_5":21646,"_28538":203076,"_5847":203546},[],"La credencial de firma tiene acceso de escritura",{"_6944":124313,"_42621":124134,"_30085":203548,"_5":21646,"_28538":203076,"_5847":203549},[],"Dale una política de solo lectura sobre los objetos que sirve.",{"_6944":124314,"_42621":124134,"_30085":203551,"_5":21646,"_28538":203076,"_5847":203552},[],"Arranque: `presign signs with the storage's own credential`",{"_6944":124315,"_42621":124134,"_30085":203554,"_5":21646,"_28538":203076,"_5847":203555},[],"Misma clave que el almacenamiento",{"_6944":124316,"_42621":124134,"_30085":203557,"_5":21646,"_28538":203076,"_5847":203558},[],"Crea una clave de solo lectura aparte.",{"_6944":124317,"_42621":124134,"_30085":203560,"_5":21646,"_28538":203076,"_5847":203561},[],"Arranque: `the store does not accept the presign credential`",{"_6944":124318,"_42621":124134,"_30085":203563,"_5":21646,"_28538":203076,"_5847":203564},[],"El almacén no conoce la clave, o la firma no coincide",{"_6944":124319,"_42621":124134,"_30085":203566,"_5":21646,"_28538":203076,"_5847":203567},[],"Crea el usuario en el almacén; revisa región y endpoint.",{"_6944":124320,"_42621":124134,"_30085":203569,"_5":21646,"_28538":203076,"_5847":203570},[],"Arranque: `presign cannot be combined with client-side encryption`",{"_6944":124321,"_42621":124134,"_30085":203572,"_5":21646,"_28538":203076,"_5847":203573},[],"`encryption.type` no es `none` en ese bloque",{"_6944":124322,"_42621":124134,"_30085":203575,"_5":21646,"_28538":203076,"_5847":203576},[],"Usa cifrado en el almacén, o desactiva `presign`.",{"_6944":124323,"_42621":124134,"_30085":203578,"_5":21646,"_28538":203076,"_5847":203579},[],"Arranque: `presign.public_endpoint must be an http(s) origin`",{"_6944":124324,"_42621":124134,"_30085":203581,"_5":21646,"_28538":203076,"_5847":203582},[],"El valor no tiene esquema, o tiene una ruta",{"_6944":124325,"_42621":124134,"_30085":203584,"_5":21646,"_28538":203076,"_5847":203585},[],"Usa un origen como `https://updates.example.com`.",{"_6944":124326,"_42621":124134,"_30085":203587,"_5":21646,"_28538":203076,"_5847":203588},[],"El dispositivo recibe `403` del almacén tras el `302`",{"_6944":124327,"_42621":124134,"_30085":203590,"_5":21646,"_28538":203076,"_5847":203591},[],"La URL caducó antes de que el dispositivo iniciara el GET, el `Host` firmado no es el que usó el dispositivo (`public_endpoint` incorrecto), la clave de firma no puede leer ese prefijo, o los relojes difieren",{"_6944":124328,"_42621":124134,"_30085":203593,"_5":21646,"_28538":203076,"_5847":203594},[],"Reintenta (se emite una URL nueva por petición); revisa `ttl`, `public_endpoint` y la política de la clave.",{"_6944":124329,"_42621":124134,"_30085":203596,"_5":21646,"_28538":203076,"_5847":203597},[],"Las descargas pasan por el servicio pese a `presign`",{"_6944":124330,"_42621":124134,"_30085":203599,"_5":21646,"_28538":203076,"_5847":203600},[],"Una petición `HEAD`, una descarga de artefacto por ID en modo `native`, un almacén sin `presign` en ese bloque, o falló la firma (queda registrado)",{"_6944":124331,"_42621":124134,"_30085":203602,"_5":21646,"_28538":203076,"_5847":203603},[],"Solo se redirigen las compilaciones en modo `native` y los objetos del plugin S3 en modo `hawkbit`.",{"_6944":124332,"_42621":124134,"_30085":203605,"_5":21646,"_28538":203080,"_5847":194415},[],{"_6944":124333,"_42621":124134,"_30085":203607,"_5":21646,"_28538":203080,"_5847":196825},[],{"_6944":124334,"_42621":124134,"_30085":203609,"_5":21646,"_28538":203080,"_5847":203138},[],{"_6944":124335,"_42621":124134,"_30085":203611,"_5":21646,"_28538":203080,"_5847":203612},[],"Los dispositivos no pueden descargar el `.swu` (modo `native`)",{"_6944":124336,"_42621":124134,"_30085":203614,"_5":21646,"_28538":203080,"_5847":203615},[],"`update_domain` no es alcanzable desde el dispositivo, o no es la base completa `.../updates/v1/` con barra final",{"_6944":124337,"_42621":124134,"_30085":203617,"_5":21646,"_28538":203080,"_5847":203618},[],"Usa una dirección que el dispositivo pueda resolver. El valor por defecto del chart de Helm carece de `/updates`.",{"_6944":124338,"_42621":124134,"_30085":203620,"_5":21646,"_28538":203080,"_5847":203621},[],"Modo `hawkbit`: un dispositivo recibe `401` del DDI",{"_6944":124339,"_42621":124134,"_30085":203623,"_5":21646,"_28538":203080,"_5847":203624},[],"hawkBit rechaza a los dispositivos que no se autentican",{"_6944":124340,"_42621":124134,"_30085":203626,"_5":21646,"_28538":203080,"_5847":203627},[],"Habilita y usa un autenticador de dispositivos de hawkBit. Consulta Modo hawkBit.",{"_6944":124341,"_42621":124134,"_30085":203629,"_5":21646,"_28538":203080,"_5847":203630},[],"Modo `hawkbit`: un dispositivo recibe `429`",{"_6944":124342,"_42621":124134,"_30085":203632,"_5":21646,"_28538":203080,"_5847":203633},[],"El filtro DoS propio de hawkBit, que limita la frecuencia con que un dispositivo puede llamarlo",{"_6944":124343,"_42621":124134,"_30085":203635,"_5":21646,"_28538":203080,"_5847":203636},[],"Reduce la frecuencia de consulta y de informes de estado del dispositivo.",{"_6944":124344,"_42621":124134,"_30085":203638,"_5":21646,"_28538":203080,"_5847":203639},[],"Modo `hawkbit`: el lanzamiento permanece `running` sin avanzar",{"_6944":124345,"_42621":124134,"_30085":203641,"_5":21646,"_28538":203080,"_5847":203642},[],"Los dispositivos nunca contactaron con hawkBit, o consultan otro hawkBit",{"_6944":124346,"_42621":124134,"_30085":203644,"_5":21646,"_28538":203080,"_5847":203645},[],"Comprueba qué hawkBit consultan los dispositivos y que los targets existen. Un grupo de rollout no puede avanzar hasta que sus dispositivos consultan.",{"_6944":124347,"_42621":124134,"_30085":203647,"_5":21646,"_28538":203080,"_5847":203648},[],"Modo `hawkbit`: no se encuentran dispositivos en el grupo",{"_6944":124348,"_42621":124134,"_30085":203650,"_5":21646,"_28538":203080,"_5847":203651},[],"`dms_endpoint` no está definido, así que los grupos son las etiquetas de target `group:<id>`",{"_6944":124349,"_42621":124134,"_30085":203653,"_5":21646,"_28538":203080,"_5847":203654},[],"Define `dms_endpoint`, o etiqueta los targets.",{"_6944":124350,"_42621":124134,"_30085":203656,"_5":21646,"_28538":203080,"_5847":203657},[],"Un lanzamiento `phased` se queda en `CREATED` (modo `native`)",{"_6944":124351,"_42621":124134,"_30085":203659,"_5":21646,"_28538":203080,"_5847":203660},[],"En el workflow `phased` algunos pasos los hace WFX o un operador",{"_6944":124352,"_42621":124134,"_30085":203662,"_5":21646,"_28538":203080,"_5847":203663},[],"Confírmalos mediante WFX, o usa `direct`.",{"_6944":124353,"_42621":124134,"_30085":203665,"_5":21646,"_28538":203080,"_5847":203666},[],"Un lanzamiento `non-swu` muestra estados de SWU (modo `native`)",{"_6944":124354,"_42621":124134,"_30085":203668,"_5":21646,"_28538":203080,"_5847":203669},[],"Se creó con `workflow_type: direct`",{"_6944":124355,"_42621":124134,"_30085":203671,"_5":21646,"_28538":203080,"_5847":203672},[],"Usa `download-install`.",{"_6944":124356,"_42621":124134,"_30085":203674,"_5":21646,"_28538":203080,"_5847":203675},[],"El dispositivo instala y muestra la versión antigua",{"_6944":124357,"_42621":124134,"_30085":203677,"_5":21646,"_28538":203080,"_5847":203678},[],"No se cambió la versión de la carga",{"_6944":124358,"_42621":124134,"_30085":203680,"_5":21646,"_28538":203080,"_5847":203681},[],"Sube la versión antes de construir.",{"_6944":124359,"_42621":124134,"_30085":203683,"_5":21646,"_28538":203080,"_5847":203684},[],"El dispositivo ignora los despliegues nuevos",{"_6944":124360,"_42621":124134,"_30085":203686,"_5":21646,"_28538":203080,"_5847":203687},[],"SWUpdate conserva como pendiente de prueba (`ustate=1`) el estado de actualización de una instalación anterior y rechaza una nueva",{"_6944":124361,"_42621":124134,"_30085":203689,"_5":21646,"_28538":203080,"_5847":203690},[],"Confirma o restablece el estado de actualización del dispositivo. Es un ajuste del dispositivo, no del servicio.",{"_6944":124362,"_42621":124134,"_30085":203692,"_5":21646,"_28538":203080,"_5847":203693},[],"El dispositivo rechaza el `.swu` y el error menciona descifrado o imagen no válida",{"_6944":124363,"_42621":124134,"_30085":203695,"_5":21646,"_28538":203080,"_5847":203696},[],"El `.swu` no está firmado y el dispositivo exige firma, o la firma no es CMS",{"_6944":124364,"_42621":124134,"_30085":203698,"_5":21646,"_28538":203080,"_5847":203699},[],"Fírmalo con un KMS que devuelva CMS. Un fallo de firma puede notificarse como error de cifrado.",{"_6944":124365,"_42621":124134,"_30085":203701,"_5":21646,"_28538":203080,"_5847":203702},[],"El dispositivo no logra descifrar",{"_6944":124366,"_42621":124134,"_30085":203704,"_5":21646,"_28538":203080,"_5847":203705},[],"La clave usada al construir difiere de la del dispositivo, o difiere la grafía del algoritmo",{"_6944":124367,"_42621":124134,"_30085":203707,"_5":21646,"_28538":203080,"_5847":203708},[],"Usa la misma clave y el mismo algoritmo. Revisa la asignación en SymKMS.",{"_6944":124368,"_42621":124134,"_30085":203710,"_5":21646,"_28538":203084,"_5847":194415},[],{"_6944":124369,"_42621":124134,"_30085":203712,"_5":21646,"_28538":203084,"_5847":196825},[],{"_6944":124370,"_42621":124134,"_30085":203714,"_5":21646,"_28538":203084,"_5847":203138},[],{"_6944":124371,"_42621":124134,"_30085":203716,"_5":21646,"_28538":203084,"_5847":203717},[],"Los pods no pueden arrancar en nodos distintos",{"_6944":124372,"_42621":124134,"_30085":203719,"_5":21646,"_28538":203084,"_5847":203720},[],"El volumen `ReadWriteOnce` (ambos modos mientras `persistence.enabled` es true)",{"_6944":124373,"_42621":124134,"_30085":203722,"_5":21646,"_28538":203084,"_5847":203723},[],"Define `persistence.enabled: false` y pasa `artifacts`, `builds` y `symkms` a S3. Consulta Operaciones.",{"_6944":124374,"_42621":124134,"_30085":203725,"_5":21646,"_28538":203084,"_5847":203726},[],"Los lotes de campaña nunca avanzan (modo `native`)",{"_6944":124375,"_42621":124134,"_30085":203728,"_5":21646,"_28538":203084,"_5847":203729},[],"Falla la elección de líder, o no llegan los eventos de WFX",{"_6944":124376,"_42621":124134,"_30085":203731,"_5":21646,"_28538":203084,"_5847":203732},[],"Revisa los Leases y el RBAC, o define `leaderElection.mode: database`. La línea de registro `leadership acquired` aparece en el líder.",{"_6944":124377,"_42621":124134,"_30085":203734,"_5":21646,"_28538":203084,"_5847":203735},[],"Los lanzamientos programados nunca empiezan (modo `native`)",{"_6944":124378,"_42621":124134,"_30085":203737,"_5":21646,"_28538":203084,"_5847":203738},[],"El mismo trabajo en segundo plano, que se ejecuta en el líder",{"_6944":124379,"_42621":124134,"_30085":203740,"_5":21646,"_28538":203084,"_5847":203741},[],"Igual que arriba.",{"_6944":124380,"_42621":124134,"_30085":203743,"_5":21646,"_28538":203084,"_5847":203744},[],"Las construcciones por dispositivo son lentas",{"_6944":124381,"_42621":124134,"_30085":203746,"_5":21646,"_28538":203084,"_5847":203747},[],"El límite de CPU",{"_6944":124382,"_42621":124134,"_30085":203749,"_5":21646,"_28538":203084,"_5847":203750},[],"Súbelo. Consulta Dimensionado de recursos.",{"_6944":124383,"_42621":124134,"_30085":203752,"_5":21646,"_28538":203084,"_5847":203753},[],"El pod muere durante una subida o una construcción cifrada",{"_6944":124384,"_42621":124134,"_30085":203755,"_5":21646,"_28538":203084,"_5847":203756},[],"Límite de memoria, o el disco temporal está lleno",{"_6944":124385,"_42621":124134,"_30085":203758,"_5":21646,"_28538":203084,"_5847":203759},[],"Dimensiona la memoria para el mayor fichero que cifres y da margen a `TMPDIR`.",{"_6944":124386,"_42621":124134,"_30085":203761,"_5":21646,"_28538":203088,"_5847":203762},[],"Sube `app.logs.level` a `debug`, pero recuerda que imprime secretos.",{"_6944":124387,"_42621":124134,"_30085":203764,"_5":21646,"_28538":203088,"_5847":203765},[],"`GET /updates/v1/capabilities` muestra el backend activo y lo que soporta.",{"_6944":124388,"_42621":124134,"_30085":203767,"_5":21646,"_28538":203088,"_5847":203768},[],"Cada réplica registra cuál lidera (`leadership acquired`, `is the leader, standing by`).",{"_6944":124389,"_42621":124134,"_30085":203770,"_5":21646,"_28538":203088,"_5847":203771},[],"En modo `hawkbit`, inspecciona lo que creó el servicio mediante la API de gestión de hawkBit (puerto `8090` en Compose, con las credenciales Basic Auth de la configuración). Cada instancia de hawkBit tiene sus propios datos: consulta la que indica `hawkbit.base_url`.",{"_6944":124390,"_42621":124390,"_5":22076,"_5847":197547,"_43101":203773,"_30085":203774,"_28538":124390},[78004],[],{"_6944":124391,"_42621":124390,"_30085":203776,"_5":21646,"_28538":124390,"_5847":203777},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_6944":124392,"_42621":124390,"_5":43098,"_30085":203779,"_28538":203780,"_5847":203781},[],"/docs/pr-preview/pr-56/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_6944":124393,"_42621":124390,"_5":43098,"_30085":203783,"_28538":203784,"_5847":203785},[],"/docs/pr-preview/pr-56/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_6944":124394,"_42621":124390,"_5":43098,"_30085":203787,"_28538":203788,"_5847":203789},[],"/docs/pr-preview/pr-56/es/security#versiones-soportadas","Versiones soportadas",{"_6944":124395,"_42621":124390,"_5":43098,"_30085":203791,"_28538":203792,"_5847":203793},[],"/docs/pr-preview/pr-56/es/security#divulgación-responsable","Divulgación responsable",{"_6944":124396,"_42621":124390,"_30085":203795,"_5":21646,"_28538":124390,"_5847":203796},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_6944":124397,"_42621":124390,"_30085":203798,"_5":21646,"_28538":203780,"_5847":203799},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_6944":124398,"_42621":124390,"_30085":203801,"_5":21646,"_28538":203780,"_5847":203802},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_6944":124399,"_42621":124390,"_30085":203804,"_5":21646,"_28538":203780,"_5847":22552},[],{"_6944":124400,"_42621":124390,"_30085":203806,"_5":21646,"_28538":203780,"_5847":22480},[],{"_6944":124401,"_42621":124390,"_30085":203808,"_5":21646,"_28538":203780,"_5847":22545},[],{"_6944":124402,"_42621":124390,"_30085":203810,"_5":21646,"_28538":203780,"_5847":203811},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_6944":124403,"_42621":124390,"_30085":203813,"_5":21646,"_28538":203780,"_5847":203814},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_6944":124404,"_42621":124390,"_30085":203816,"_5":21646,"_28538":203784,"_5847":203817},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_6944":124405,"_42621":124390,"_30085":203819,"_5":21646,"_28538":203784,"_5847":203820},[],"No incluyas en el reporte:",{"_6944":124406,"_42621":124390,"_30085":203822,"_5":21646,"_28538":203784,"_5847":203823},[],"Credenciales, tokens o claves privadas",{"_6944":124407,"_42621":124390,"_30085":203825,"_5":21646,"_28538":203784,"_5847":203826},[],"Datos de clientes o información identificable de clientes",{"_6944":124408,"_42621":124390,"_30085":203828,"_5":21646,"_28538":203784,"_5847":203829},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_6944":124409,"_42621":124390,"_30085":203831,"_5":21646,"_28538":203788,"_5847":203832},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_6944":124410,"_42621":124390,"_30085":203834,"_5":21646,"_28538":203788,"_5847":203835},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_6944":124411,"_42621":124390,"_30085":203837,"_5":21646,"_28538":203792,"_5847":203838},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_6944":124412,"_42621":124390,"_30085":203840,"_5":21646,"_28538":203792,"_5847":203841},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_6944":124413,"_42621":124390,"_30085":203843,"_5":21646,"_28538":203792,"_5847":203844},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_6944":124414,"_42621":124390,"_30085":203846,"_5":21646,"_28538":203792,"_5847":203847},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_6944":124415,"_42621":124390,"_30085":203849,"_5":21646,"_28538":203792,"_5847":203850},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_6944":124416,"_42621":124416,"_5":22076,"_5847":203852,"_43101":203853,"_30085":203854,"_28538":124416},"3.8.0 a 4.0.0",[78004,199224],[],{"_6944":124417,"_42621":124416,"_30085":203856,"_5":21646,"_28538":124416,"_5847":203857},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_6944":124418,"_42621":124416,"_5":43098,"_30085":203859,"_28538":203860,"_5847":203861},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_6944":124419,"_42621":124416,"_5":43098,"_30085":203863,"_28538":203864,"_5847":203865},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_6944":124420,"_42621":124416,"_5":43098,"_30085":203867,"_28538":203868,"_5847":203869},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_6944":124421,"_42621":124416,"_5":43098,"_30085":203871,"_28538":203872,"_5847":203873},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_6944":124422,"_42621":124416,"_5":43098,"_30085":203875,"_28538":203876,"_5847":203877},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_6944":124423,"_42621":124416,"_5":43098,"_30085":203879,"_28538":203880,"_5847":203881},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_6944":124424,"_42621":124416,"_5":43098,"_30085":203883,"_28538":203884,"_5847":94738},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_6944":124425,"_42621":124416,"_5":43098,"_30085":203886,"_28538":203887,"_5847":203888},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_6944":124426,"_42621":124416,"_5":43098,"_30085":203890,"_28538":203891,"_5847":203892},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_6944":124427,"_42621":124416,"_5":43098,"_30085":203894,"_28538":203895,"_5847":203896},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_6944":124428,"_42621":124416,"_5":43098,"_30085":203898,"_28538":203899,"_5847":203900},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_6944":124429,"_42621":124416,"_5":43098,"_30085":203902,"_28538":203903,"_5847":203904},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_6944":124430,"_42621":124416,"_5":43098,"_30085":203906,"_28538":203907,"_5847":203908},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_6944":124431,"_42621":124416,"_5":43098,"_30085":203910,"_28538":203911,"_5847":203912},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_6944":124432,"_42621":124416,"_5":43098,"_30085":203914,"_28538":203915,"_5847":203916},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_6944":124433,"_42621":124416,"_5":43098,"_30085":203918,"_28538":203919,"_5847":203920},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_6944":124434,"_42621":124416,"_5":43098,"_30085":203922,"_28538":203923,"_5847":203924},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_6944":124435,"_42621":124416,"_5":43098,"_30085":203926,"_28538":203927,"_5847":203928},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_6944":124436,"_42621":124416,"_5":43098,"_30085":203930,"_28538":203931,"_5847":203932},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_6944":124437,"_42621":124416,"_5":43098,"_30085":203934,"_28538":203935,"_5847":203936},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-roles-va","Referencias entre certificados, claves y roles VA",{"_6944":124438,"_42621":124416,"_5":43098,"_30085":203938,"_28538":203939,"_5847":203940},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_6944":124439,"_42621":124416,"_5":43098,"_30085":203942,"_28538":203943,"_5847":203944},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_6944":124440,"_42621":124416,"_5":43098,"_30085":203946,"_28538":203947,"_5847":203948},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_6944":124441,"_42621":124416,"_5":43098,"_30085":203950,"_28538":203951,"_5847":203952},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_6944":124442,"_42621":124416,"_5":43098,"_30085":203954,"_28538":203955,"_5847":203956},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_6944":124443,"_42621":124416,"_5":43098,"_30085":203958,"_28538":203959,"_5847":203960},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_6944":124444,"_42621":124416,"_5":43098,"_30085":203962,"_28538":203963,"_5847":203964},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_6944":124445,"_42621":124416,"_5":43098,"_30085":203966,"_28538":203967,"_5847":203968},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#campo-firmante-del-rol-va","Campo firmante del rol VA",{"_6944":124446,"_42621":124416,"_5":43098,"_30085":203970,"_28538":203971,"_5847":203972},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_6944":124447,"_42621":124416,"_5":43098,"_30085":203974,"_28538":203975,"_5847":203976},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_6944":124448,"_42621":124416,"_5":43098,"_30085":203978,"_28538":203979,"_5847":203980},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_6944":124449,"_42621":124416,"_5":43098,"_30085":203982,"_28538":203983,"_5847":203984},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_6944":124450,"_42621":124416,"_5":43098,"_30085":203986,"_28538":203987,"_5847":203988},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_6944":124451,"_42621":124416,"_5":43098,"_30085":203990,"_28538":203991,"_5847":203992},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_6944":124452,"_42621":124416,"_5":43098,"_30085":203994,"_28538":203995,"_5847":203996},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_6944":124453,"_42621":124416,"_5":43098,"_30085":203998,"_28538":203999,"_5847":191718},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_6944":124454,"_42621":124416,"_5":43098,"_30085":204001,"_28538":204002,"_5847":204003},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_6944":124455,"_42621":124416,"_5":43098,"_30085":204005,"_28538":204006,"_5847":204007},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_6944":124456,"_42621":124416,"_30085":204009,"_5":21646,"_28538":124416,"_5847":204010},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_6944":124457,"_42621":124416,"_30085":204012,"_5":21646,"_28538":124416,"_5847":204013},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_6944":124458,"_42621":124416,"_30085":204015,"_5":21646,"_28538":124416,"_5847":204016},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_6944":124459,"_42621":124416,"_30085":204018,"_5":21646,"_28538":124416,"_5847":204019},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_6944":124460,"_42621":124416,"_30085":204021,"_5":21646,"_28538":124416,"_5847":204022},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_6944":124461,"_42621":124416,"_30085":204024,"_5":21646,"_28538":124416,"_5847":204025},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_6944":124462,"_42621":124416,"_30085":204027,"_5":21646,"_28538":124416,"_5847":204028},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_6944":124463,"_42621":124416,"_30085":204030,"_5":21646,"_28538":203864,"_5847":204031},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_6944":124464,"_42621":124416,"_30085":204033,"_5":21646,"_28538":203864,"_5847":204034},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_6944":124465,"_42621":124416,"_30085":204036,"_5":21646,"_28538":203868,"_5847":204037},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_6944":124466,"_42621":124416,"_30085":204039,"_5":21646,"_28538":203868,"_5847":204040},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_6944":124467,"_42621":124416,"_30085":204042,"_5":21646,"_28538":203872,"_5847":204043},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_6944":124468,"_42621":124416,"_30085":204045,"_5":21646,"_28538":203876,"_5847":204046},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_6944":124469,"_42621":124416,"_30085":204048,"_5":21646,"_28538":203876,"_5847":204049},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_6944":124470,"_42621":124416,"_30085":204051,"_5":21646,"_28538":203876,"_5847":204052},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_6944":124471,"_42621":124416,"_30085":204054,"_5":21646,"_28538":203876,"_5847":204055},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_6944":124472,"_42621":124416,"_30085":204057,"_5":21646,"_28538":203876,"_5847":204058},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_6944":124473,"_42621":124416,"_30085":204060,"_5":21646,"_28538":203880,"_5847":204061},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_6944":124474,"_42621":124416,"_30085":204063,"_5":21646,"_28538":203880,"_5847":204064},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_6944":124475,"_42621":124416,"_30085":204066,"_5":21646,"_28538":203880,"_5847":204067},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_6944":124476,"_42621":124416,"_30085":204069,"_5":21646,"_28538":203880,"_5847":204070},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_6944":124477,"_42621":124416,"_30085":204072,"_5":21646,"_28538":203880,"_5847":204073},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_6944":124478,"_42621":124416,"_30085":204075,"_5":21646,"_28538":203884,"_5847":204076},[],"Cambio",{"_6944":124479,"_42621":124416,"_30085":204078,"_5":21646,"_28538":203884,"_5847":204079},[],"A quién afecta",{"_6944":124480,"_42621":124416,"_30085":204081,"_5":21646,"_28538":203884,"_5847":204082},[],"Gravedad",{"_6944":124481,"_42621":124416,"_30085":204084,"_5":21646,"_28538":203884,"_5847":194421},[],{"_6944":124482,"_42621":124416,"_30085":204086,"_5":21646,"_28538":203884,"_5847":203892},[],{"_6944":124483,"_42621":124416,"_30085":204088,"_5":21646,"_28538":203884,"_5847":204089},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_6944":124484,"_42621":124416,"_30085":204091,"_5":21646,"_28538":203884,"_5847":204092},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_6944":124485,"_42621":124416,"_30085":204094,"_5":21646,"_28538":203884,"_5847":204095},[],"Copiar los datos a los volúmenes nuevos",{"_6944":124486,"_42621":124416,"_30085":204097,"_5":21646,"_28538":203884,"_5847":203896},[],{"_6944":124487,"_42621":124416,"_30085":204099,"_5":21646,"_28538":203884,"_5847":204100},[],"Todas las releases de Helm",{"_6944":124488,"_42621":124416,"_30085":204102,"_5":21646,"_28538":203884,"_5847":204103},[],"Alta: `helm upgrade` falla",{"_6944":124489,"_42621":124416,"_30085":204105,"_5":21646,"_28538":203884,"_5847":204106},[],"Eliminar o renombrar las claves heredadas",{"_6944":124490,"_42621":124416,"_30085":204108,"_5":21646,"_28538":203884,"_5847":203900},[],{"_6944":124491,"_42621":124416,"_30085":204110,"_5":21646,"_28538":203884,"_5847":204111},[],"Todos los despliegues",{"_6944":124492,"_42621":124416,"_30085":204113,"_5":21646,"_28538":203884,"_5847":204114},[],"Alta: sin principal de bootstrap no hay administrador",{"_6944":124493,"_42621":124416,"_30085":204116,"_5":21646,"_28538":203884,"_5847":204117},[],"Configurar `services.authz`",{"_6944":124494,"_42621":124416,"_30085":204119,"_5":21646,"_28538":203884,"_5847":203904},[],{"_6944":124495,"_42621":124416,"_30085":204121,"_5":21646,"_28538":203884,"_5847":204100},[],{"_6944":124496,"_42621":124416,"_30085":204123,"_5":21646,"_28538":203884,"_5847":204124},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_6944":124497,"_42621":124416,"_30085":204126,"_5":21646,"_28538":203884,"_5847":204127},[],"Mover JWKS y roles a `services.authz`",{"_6944":124498,"_42621":124416,"_30085":204129,"_5":21646,"_28538":203884,"_5847":203924},[],{"_6944":124499,"_42621":124416,"_30085":204131,"_5":21646,"_28538":203884,"_5847":204132},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_6944":124500,"_42621":124416,"_30085":204134,"_5":21646,"_28538":203884,"_5847":204135},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_6944":124501,"_42621":124416,"_30085":204137,"_5":21646,"_28538":203884,"_5847":204138},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_6944":124502,"_42621":124416,"_30085":204140,"_5":21646,"_28538":203884,"_5847":203928},[],{"_6944":124503,"_42621":124416,"_30085":204142,"_5":21646,"_28538":203884,"_5847":204143},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_6944":124504,"_42621":124416,"_30085":204145,"_5":21646,"_28538":203884,"_5847":204146},[],"Alta: el backend ya no arranca con ellos",{"_6944":124505,"_42621":124416,"_30085":204148,"_5":21646,"_28538":203884,"_5847":204149},[],"Pasar a PostgreSQL antes de actualizar",{"_6944":124506,"_42621":124416,"_30085":204151,"_5":21646,"_28538":203884,"_5847":204152},[],"Webhooks con referencias a archivos",{"_6944":124507,"_42621":124416,"_30085":204154,"_5":21646,"_28538":203884,"_5847":204155},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_6944":124508,"_42621":124416,"_30085":204157,"_5":21646,"_28538":203884,"_5847":204158},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_6944":124509,"_42621":124416,"_30085":204160,"_5":21646,"_28538":203884,"_5847":204161},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_6944":124510,"_42621":124416,"_30085":204163,"_5":21646,"_28538":203884,"_5847":203908},[],{"_6944":124511,"_42621":124416,"_30085":204165,"_5":21646,"_28538":203884,"_5847":204166},[],"Releases con identidades por servicio o material de claves montado",{"_6944":124512,"_42621":124416,"_30085":204168,"_5":21646,"_28538":203884,"_5847":204169},[],"Media: los servicios no pueden leer sus archivos",{"_6944":124513,"_42621":124416,"_30085":204171,"_5":21646,"_28538":203884,"_5847":204172},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_6944":124514,"_42621":124416,"_30085":204174,"_5":21646,"_28538":203884,"_5847":203912},[],{"_6944":124515,"_42621":124416,"_30085":204176,"_5":21646,"_28538":203884,"_5847":204177},[],"Releases que definen `amqp.tls`",{"_6944":124516,"_42621":124416,"_30085":204179,"_5":21646,"_28538":203884,"_5847":204180},[],"Media: los clientes se conectan al puerto equivocado",{"_6944":124517,"_42621":124416,"_30085":204182,"_5":21646,"_28538":203884,"_5847":204183},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_6944":124518,"_42621":124416,"_30085":204185,"_5":21646,"_28538":203884,"_5847":203932},[],{"_6944":124519,"_42621":124416,"_30085":204187,"_5":21646,"_28538":203884,"_5847":204188},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_6944":124520,"_42621":124416,"_30085":204190,"_5":21646,"_28538":203884,"_5847":204191},[],"Media: las claves de CA quedan sin gestionar",{"_6944":124521,"_42621":124416,"_30085":204193,"_5":21646,"_28538":203884,"_5847":204194},[],"Ejecutar la migración de CA a KMS",{"_6944":124522,"_42621":124416,"_30085":204196,"_5":21646,"_28538":203884,"_5847":204197},[],"Verificación del certificado del receptor",{"_6944":124523,"_42621":124416,"_30085":204199,"_5":21646,"_28538":203884,"_5847":204200},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_6944":124524,"_42621":124416,"_30085":204202,"_5":21646,"_28538":203884,"_5847":204203},[],"Media: las credenciales viajan a un receptor sin verificar",{"_6944":124525,"_42621":124416,"_30085":204205,"_5":21646,"_28538":203884,"_5847":204206},[],"Poner `insecure_skip_verify` a `false`",{"_6944":124526,"_42621":124416,"_30085":204208,"_5":21646,"_28538":203884,"_5847":203948},[],{"_6944":124527,"_42621":124416,"_30085":204210,"_5":21646,"_28538":203884,"_5847":204211},[],"Scripts y consolas que editan DMS por API",{"_6944":124528,"_42621":124416,"_30085":204213,"_5":21646,"_28538":203884,"_5847":204214},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_6944":124529,"_42621":124416,"_30085":204216,"_5":21646,"_28538":203884,"_5847":204217},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_6944":124530,"_42621":124416,"_30085":204219,"_5":21646,"_28538":203884,"_5847":203968},[],{"_6944":124531,"_42621":124416,"_30085":204221,"_5":21646,"_28538":203884,"_5847":204222},[],"Clientes que crean o actualizan roles VA por API",{"_6944":124532,"_42621":124416,"_30085":204224,"_5":21646,"_28538":203884,"_5847":204225},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_6944":124533,"_42621":124416,"_30085":204227,"_5":21646,"_28538":203884,"_5847":204228},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_certificate_serial_number`",{"_6944":124534,"_42621":124416,"_30085":204230,"_5":21646,"_28538":203884,"_5847":203964},[],{"_6944":124535,"_42621":124416,"_30085":204232,"_5":21646,"_28538":203884,"_5847":204233},[],"Consumidores que leen el campo `events` del dispositivo",{"_6944":124536,"_42621":124416,"_30085":204235,"_5":21646,"_28538":203884,"_5847":204236},[],"Media: el campo desaparece",{"_6944":124537,"_42621":124416,"_30085":204238,"_5":21646,"_28538":203884,"_5847":204239},[],"Usar los nuevos endpoints de eventos",{"_6944":124538,"_42621":124416,"_30085":204241,"_5":21646,"_28538":203884,"_5847":203916},[],{"_6944":124539,"_42621":124416,"_30085":204243,"_5":21646,"_28538":203884,"_5847":204244},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_6944":124540,"_42621":124416,"_30085":204246,"_5":21646,"_28538":203884,"_5847":204247},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_6944":124541,"_42621":124416,"_30085":204249,"_5":21646,"_28538":203884,"_5847":204250},[],"Actualizar el archivo de values",{"_6944":124542,"_42621":124416,"_30085":204252,"_5":21646,"_28538":203884,"_5847":203956},[],{"_6944":124543,"_42621":124416,"_30085":204254,"_5":21646,"_28538":203884,"_5847":204255},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_6944":124544,"_42621":124416,"_30085":204257,"_5":21646,"_28538":203884,"_5847":204258},[],"Baja: prevalece el ID de la URL",{"_6944":124545,"_42621":124416,"_30085":204260,"_5":21646,"_28538":203884,"_5847":204261},[],"Enviar el ID en la URL",{"_6944":124546,"_42621":124416,"_30085":204263,"_5":21646,"_28538":203884,"_5847":203960},[],{"_6944":124547,"_42621":124416,"_30085":204265,"_5":21646,"_28538":203884,"_5847":204266},[],"Consumidores que comparan el `type` del certificado",{"_6944":124548,"_42621":124416,"_30085":204268,"_5":21646,"_28538":203884,"_5847":204269},[],"Baja: dos valores cambian de nombre",{"_6944":124549,"_42621":124416,"_30085":204271,"_5":21646,"_28538":203884,"_5847":204272},[],"Adaptar los consumidores",{"_6944":124550,"_42621":124416,"_30085":204274,"_5":21646,"_28538":203884,"_5847":203952},[],{"_6944":124551,"_42621":124416,"_30085":204276,"_5":21646,"_28538":203884,"_5847":204277},[],"Cualquier DMS",{"_6944":124552,"_42621":124416,"_30085":204279,"_5":21646,"_28538":203884,"_5847":204280},[],"Baja: solo informativo",{"_6944":124553,"_42621":124416,"_30085":204282,"_5":21646,"_28538":203884,"_5847":204283},[],"Revisar ambos bloques antes de editar",{"_6944":124554,"_42621":124416,"_30085":204285,"_5":21646,"_28538":203891,"_5847":204286},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_6944":124555,"_42621":124416,"_30085":204288,"_5":21646,"_28538":203891,"_5847":204289},[],"El paso 4 de la guía de migración copia los datos.",{"_6944":124556,"_42621":124416,"_30085":204291,"_5":21646,"_28538":203895,"_5847":204292},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_6944":124557,"_42621":124416,"_30085":204294,"_5":21646,"_28538":203899,"_5847":204295},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_6944":124558,"_42621":124416,"_30085":204297,"_5":21646,"_28538":203903,"_5847":204298},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_6944":124559,"_42621":124416,"_30085":204300,"_5":21646,"_28538":203907,"_5847":204301},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_6944":124560,"_42621":124416,"_30085":204303,"_5":21646,"_28538":203907,"_5847":204304},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_6944":124561,"_42621":124416,"_30085":204306,"_5":21646,"_28538":203911,"_5847":204307},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_6944":124562,"_42621":124416,"_30085":204309,"_5":21646,"_28538":203915,"_5847":204310},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_6944":124563,"_42621":124416,"_30085":204312,"_5":21646,"_28538":203915,"_5847":204313},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_6944":124564,"_42621":124416,"_30085":204315,"_5":21646,"_28538":203915,"_5847":204316},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_6944":124565,"_42621":124416,"_30085":204318,"_5":21646,"_28538":203915,"_5847":204319},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_6944":124566,"_42621":124416,"_30085":204321,"_5":21646,"_28538":203915,"_5847":204322},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_6944":124567,"_42621":124416,"_30085":204324,"_5":21646,"_28538":203915,"_5847":204325},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_6944":124568,"_42621":124416,"_30085":204327,"_5":21646,"_28538":203923,"_5847":204328},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_6944":124569,"_42621":124416,"_30085":204330,"_5":21646,"_28538":203923,"_5847":204331},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_6944":124570,"_42621":124416,"_30085":204333,"_5":21646,"_28538":203923,"_5847":204334},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_6944":124571,"_42621":124416,"_30085":204336,"_5":21646,"_28538":203923,"_5847":204337},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_6944":124572,"_42621":124416,"_30085":204339,"_5":21646,"_28538":203923,"_5847":204340},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_6944":124573,"_42621":124416,"_30085":204342,"_5":21646,"_28538":203927,"_5847":204343},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_6944":124574,"_42621":124416,"_30085":204345,"_5":21646,"_28538":203931,"_5847":204346},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_6944":124575,"_42621":124416,"_30085":204348,"_5":21646,"_28538":203931,"_5847":204349},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_6944":124576,"_42621":124416,"_30085":204351,"_5":21646,"_28538":203931,"_5847":204352},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_6944":124577,"_42621":124416,"_30085":204354,"_5":21646,"_28538":203931,"_5847":204355},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_6944":124578,"_42621":124416,"_30085":204357,"_5":21646,"_28538":203931,"_5847":204358},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_6944":124579,"_42621":124416,"_30085":204360,"_5":21646,"_28538":203931,"_5847":204361},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_6944":124580,"_42621":124416,"_30085":204363,"_5":21646,"_28538":203931,"_5847":204364},[],"Una vez registradas las claves heredadas, arrancar el KMS con la opción de configuración del backend `crypto_engines.migrate_keys_format` renombra las claves cuyo nombre no es el digest SHA-256 de la clave pública, conserva el nombre antiguo como alias y traslada consigo las referencias de certificados. Es seguro volver a ejecutarla y puede desactivarse después.",{"_6944":124581,"_42621":124416,"_30085":204366,"_5":21646,"_28538":203935,"_5847":204367},[],"Los certificados referencian ahora su clave del KMS, y los roles VA referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_6944":124582,"_42621":124416,"_30085":204369,"_5":21646,"_28538":203943,"_5847":204370},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_6944":124583,"_42621":124416,"_30085":204372,"_5":21646,"_28538":203943,"_5847":204373},[],"Campo en 3.8.0",{"_6944":124584,"_42621":124416,"_30085":204375,"_5":21646,"_28538":203943,"_5847":204376},[],"Campo en 4.0.0",{"_6944":124585,"_42621":124416,"_30085":204378,"_5":21646,"_28538":203943,"_5847":95233},[],{"_6944":124586,"_42621":124416,"_30085":204380,"_5":21646,"_28538":203943,"_5847":204381},[],"`insecure_skip_verify` (con el valor negado)",{"_6944":124587,"_42621":124416,"_30085":204383,"_5":21646,"_28538":203943,"_5847":95239},[],{"_6944":124588,"_42621":124416,"_30085":204385,"_5":21646,"_28538":203943,"_5847":95242},[],{"_6944":124589,"_42621":124416,"_30085":204387,"_5":21646,"_28538":203943,"_5847":95245},[],{"_6944":124590,"_42621":124416,"_30085":204389,"_5":21646,"_28538":203943,"_5847":95248},[],{"_6944":124591,"_42621":124416,"_30085":204391,"_5":21646,"_28538":203943,"_5847":95251},[],{"_6944":124592,"_42621":124416,"_30085":204393,"_5":21646,"_28538":203943,"_5847":95254},[],{"_6944":124593,"_42621":124416,"_30085":204395,"_5":21646,"_28538":203943,"_5847":204396},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_6944":124594,"_42621":124416,"_30085":204398,"_5":21646,"_28538":203943,"_5847":204399},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_6944":124595,"_42621":124416,"_30085":204401,"_5":21646,"_28538":203943,"_5847":204402},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_6944":124596,"_42621":124416,"_30085":204404,"_5":21646,"_28538":203947,"_5847":204405},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_6944":124597,"_42621":124416,"_30085":204407,"_5":21646,"_28538":203947,"_5847":204408},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_6944":124598,"_42621":124416,"_30085":204410,"_5":21646,"_28538":203947,"_5847":204411},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_6944":124599,"_42621":124416,"_30085":204413,"_5":21646,"_28538":203951,"_5847":204414},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_6944":124600,"_42621":124416,"_30085":204416,"_5":21646,"_28538":203955,"_5847":204417},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_6944":124601,"_42621":124416,"_30085":204419,"_5":21646,"_28538":203959,"_5847":204420},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_6944":124602,"_42621":124416,"_30085":204422,"_5":21646,"_28538":203963,"_5847":204423},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_6944":124603,"_42621":124416,"_30085":204425,"_5":21646,"_28538":203963,"_5847":204426},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_6944":124604,"_42621":124416,"_30085":204428,"_5":21646,"_28538":203963,"_5847":204429},[],"`POST /v1/devices/:id/events` crea un evento.",{"_6944":124605,"_42621":124416,"_30085":204431,"_5":21646,"_28538":203963,"_5847":204432},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_6944":124606,"_42621":124416,"_30085":204434,"_5":21646,"_28538":203967,"_5847":204435},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_certificate_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de un rol nuevo es el número de serie del certificado actual de la CA. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. Las políticas de autorización personalizadas que filtran por el campo antiguo deben actualizarse: el filtro `crl_subject_key_id_signer` se renombra a `crl_signer_certificate_serial_number` y toma valores de número de serie.",{"_6944":124607,"_42621":124416,"_30085":204437,"_5":21646,"_28538":203971,"_5847":204438},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_6944":124608,"_42621":124416,"_30085":204440,"_5":21646,"_28538":203975,"_5847":204441},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_6944":124609,"_42621":124416,"_30085":204443,"_5":21646,"_28538":203975,"_5847":204444},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_6944":124610,"_42621":124416,"_30085":204446,"_5":21646,"_28538":203975,"_5847":204447},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_6944":124611,"_42621":124416,"_30085":204449,"_5":21646,"_28538":203975,"_5847":204450},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_6944":124612,"_42621":124416,"_30085":204452,"_5":21646,"_28538":203975,"_5847":204453},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_6944":124613,"_42621":124416,"_30085":204455,"_5":21646,"_28538":203979,"_5847":204456},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_6944":124614,"_42621":124416,"_30085":204458,"_5":21646,"_28538":203979,"_5847":204459},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_6944":124615,"_42621":124416,"_30085":204461,"_5":21646,"_28538":203979,"_5847":204462},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_6944":124616,"_42621":124416,"_30085":204464,"_5":21646,"_28538":203979,"_5847":204465},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_6944":124617,"_42621":124416,"_30085":204467,"_5":21646,"_28538":203979,"_5847":204468},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_6944":124618,"_42621":124416,"_30085":204470,"_5":21646,"_28538":203979,"_5847":204471},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_6944":124619,"_42621":124416,"_30085":204473,"_5":21646,"_28538":203979,"_5847":204474},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_6944":124620,"_42621":124416,"_30085":204476,"_5":21646,"_28538":203979,"_5847":204477},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_6944":124621,"_42621":124416,"_30085":204479,"_5":21646,"_28538":203979,"_5847":204480},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_6944":124622,"_42621":124416,"_30085":204482,"_5":21646,"_28538":203979,"_5847":204483},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_6944":124623,"_42621":124416,"_30085":204485,"_5":21646,"_28538":203979,"_5847":204486},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_6944":124624,"_42621":124416,"_30085":204488,"_5":21646,"_28538":203979,"_5847":204489},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_6944":124625,"_42621":124416,"_30085":204491,"_5":21646,"_28538":203983,"_5847":204492},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_6944":124626,"_42621":124416,"_30085":204494,"_5":21646,"_28538":203983,"_5847":204495},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_6944":124627,"_42621":124416,"_30085":204497,"_5":21646,"_28538":203987,"_5847":204498},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_6944":124628,"_42621":124416,"_30085":204500,"_5":21646,"_28538":203987,"_5847":204501},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_6944":124629,"_42621":124416,"_30085":204503,"_5":21646,"_28538":203987,"_5847":204504},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_6944":124630,"_42621":124416,"_30085":204506,"_5":21646,"_28538":203987,"_5847":204507},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_6944":124631,"_42621":124416,"_30085":204509,"_5":21646,"_28538":203987,"_5847":204510},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_6944":124632,"_42621":124416,"_30085":204512,"_5":21646,"_28538":203987,"_5847":204513},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_6944":124633,"_42621":124416,"_30085":204515,"_5":21646,"_28538":203987,"_5847":204516},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_6944":124634,"_42621":124416,"_30085":204518,"_5":21646,"_28538":203987,"_5847":204519},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_6944":124635,"_42621":124416,"_30085":204521,"_5":21646,"_28538":203987,"_5847":204522},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_6944":124636,"_42621":124416,"_30085":204524,"_5":21646,"_28538":203987,"_5847":204525},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_6944":124637,"_42621":124416,"_30085":204527,"_5":21646,"_28538":203987,"_5847":204528},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_6944":124638,"_42621":124416,"_30085":204530,"_5":21646,"_28538":203991,"_5847":204531},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_6944":124639,"_42621":124416,"_30085":204533,"_5":21646,"_28538":203991,"_5847":204534},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_6944":124640,"_42621":124416,"_30085":204536,"_5":21646,"_28538":203995,"_5847":204537},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_6944":124641,"_42621":124416,"_30085":204539,"_5":21646,"_28538":203995,"_5847":204540},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_6944":124642,"_42621":124416,"_30085":204542,"_5":21646,"_28538":203995,"_5847":204543},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Si tus servicios se conectan con un usuario distinto del que ejecutó las migraciones, concédele tras las migraciones `SELECT` sobre `ca.certificates_view`.",{"_6944":124643,"_42621":124416,"_30085":204545,"_5":21646,"_28538":203995,"_5847":204546},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_6944":124644,"_42621":124416,"_30085":204548,"_5":21646,"_28538":203995,"_5847":204549},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_6944":124645,"_42621":124416,"_30085":204551,"_5":21646,"_28538":203995,"_5847":204552},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_6944":124646,"_42621":124416,"_30085":204554,"_5":21646,"_28538":203995,"_5847":204555},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_6944":124647,"_42621":124416,"_30085":204557,"_5":21646,"_28538":203999,"_5847":204558},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_6944":124648,"_42621":124416,"_30085":204560,"_5":21646,"_28538":203999,"_5847":204561},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_6944":124649,"_42621":124416,"_30085":204563,"_5":21646,"_28538":203999,"_5847":204564},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_6944":124650,"_42621":124416,"_30085":204566,"_5":21646,"_28538":203999,"_5847":204567},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_6944":124651,"_42621":124416,"_30085":204569,"_5":21646,"_28538":203999,"_5847":204570},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_6944":124652,"_42621":124416,"_30085":204572,"_5":21646,"_28538":203999,"_5847":204573},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_6944":124653,"_42621":124416,"_30085":204575,"_5":21646,"_28538":203999,"_5847":204576},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_6944":124654,"_42621":124416,"_30085":204578,"_5":21646,"_28538":203999,"_5847":204579},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_6944":124655,"_42621":124416,"_30085":204581,"_5":21646,"_28538":203999,"_5847":204582},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_6944":124656,"_42621":124416,"_30085":204584,"_5":21646,"_28538":203999,"_5847":204585},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_certificate_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_6944":124657,"_42621":124416,"_30085":204587,"_5":21646,"_28538":203999,"_5847":204588},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_6944":124658,"_42621":124416,"_30085":204590,"_5":21646,"_28538":204002,"_5847":204591},[],"Tras la actualización, comprueba en este orden:",{"_6944":124659,"_42621":124416,"_30085":204593,"_5":21646,"_28538":204002,"_5847":204594},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_6944":124660,"_42621":124416,"_30085":204596,"_5":21646,"_28538":204002,"_5847":204597},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_6944":124661,"_42621":124416,"_30085":204599,"_5":21646,"_28538":204002,"_5847":204600},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_6944":124662,"_42621":124416,"_30085":204602,"_5":21646,"_28538":204002,"_5847":204603},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_6944":124663,"_42621":124416,"_30085":204605,"_5":21646,"_28538":204002,"_5847":204606},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_6944":124664,"_42621":124416,"_30085":204608,"_5":21646,"_28538":204002,"_5847":204609},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_6944":124665,"_42621":124416,"_30085":204611,"_5":21646,"_28538":204002,"_5847":204612},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_6944":124666,"_42621":124416,"_30085":204614,"_5":21646,"_28538":204002,"_5847":204615},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_6944":124667,"_42621":124416,"_30085":204617,"_5":21646,"_28538":204002,"_5847":204618},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_6944":124668,"_42621":124416,"_30085":204620,"_5":21646,"_28538":204002,"_5847":204621},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_6944":124669,"_42621":124416,"_30085":204623,"_5":21646,"_28538":204002,"_5847":204624},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_6944":124670,"_42621":124416,"_30085":204626,"_5":21646,"_28538":204002,"_5847":204627},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_6944":124671,"_42621":124416,"_30085":204629,"_5":21646,"_28538":204002,"_5847":204630},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_6944":124672,"_42621":124416,"_30085":204632,"_5":21646,"_28538":204002,"_5847":204633},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_6944":124673,"_42621":124416,"_30085":204635,"_5":21646,"_28538":204006,"_5847":204636},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_6944":124674,"_42621":124416,"_30085":204638,"_5":21646,"_28538":204006,"_5847":204639},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_6944":124675,"_42621":124416,"_30085":204641,"_5":21646,"_28538":204006,"_5847":204642},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_6944":124676,"_42621":124416,"_30085":204644,"_5":21646,"_28538":204006,"_5847":204645},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_6944":124677,"_42621":124416,"_30085":204647,"_5":21646,"_28538":204006,"_5847":204648},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_95512":204650,"_95513":204651,"_95515":204652,"_95517":204653,"_26487":5864,"_118844":5864},"spanish",[5847,42621,5,28538],{"_5847":35152,"_42621":35152,"_5":35152,"_28538":35152},{"_5847":204654,"_42621":210484,"_5":216314,"_28538":222144},{"_8549":204655,"_95521":204656,"_5":35152},{"_7088":6347,"_7102":28320,"_7108":20250,"_7095":14526,"_16675":12238,"_28545":12738,"_21762":5898,"_14079":9907,"_15245":10671,"_41720":12961,"_41778":29013,"_41169":18354,"_48808":6596,"_41364":9054,"_41838":15401,"_41799":18522,"_48817":12576,"_48820":8065,"_48823":8779,"_42302":11353,"_48828":20767,"_42373":21709,"_42383":8570,"_22374":6395,"_42359":11943,"_42393":7183,"_48836":8532,"_42388":41219,"_41315":23177,"_42403":29041,"_41299":10651,"_42459":17516,"_48843":8262,"_41381":12183,"_48846":6491,"_48848":12870,"_48850":14667,"_48852":12184,"_48854":8177,"_41212":34146,"_41270":21943,"_48858":1110