2174":117743,"_29767":185839,"_5":21387,"_28235":117743,"_5797":185840},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_6892":117745,"_42174":117743,"_5":42651,"_29767":185842,"_28235":185843,"_5797":185844},[],"/docs/pr-preview/pr-56/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_6892":117746,"_42174":117743,"_5":42651,"_29767":185846,"_28235":185847,"_5797":185848},[],"/docs/pr-preview/pr-56/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_6892":117747,"_42174":117743,"_5":42651,"_29767":185850,"_28235":185851,"_5797":185852},[],"/docs/pr-preview/pr-56/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_6892":117748,"_42174":117743,"_5":42651,"_29767":185854,"_28235":185855,"_5797":185856},[],"/docs/pr-preview/pr-56/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_6892":117749,"_42174":117743,"_5":42651,"_29767":185858,"_28235":185859,"_5797":185860},[],"/docs/pr-preview/pr-56/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_6892":117750,"_42174":117743,"_5":42651,"_29767":185862,"_28235":185863,"_5797":185864},[],"/docs/pr-preview/pr-56/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_6892":117751,"_42174":117743,"_5":42651,"_29767":185866,"_28235":185867,"_5797":185868},[],"/docs/pr-preview/pr-56/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_6892":117752,"_42174":117743,"_29767":185870,"_5":21387,"_28235":117743,"_5797":185871},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_6892":117753,"_42174":117743,"_29767":185873,"_5":21387,"_28235":185843,"_5797":185874},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_6892":117754,"_42174":117743,"_29767":185876,"_5":21387,"_28235":185843,"_5797":185877},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_6892":117755,"_42174":117743,"_29767":185879,"_5":21387,"_28235":185843,"_5797":185880},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_6892":117756,"_42174":117743,"_29767":185882,"_5":21387,"_28235":185847,"_5797":185883},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_6892":117757,"_42174":117743,"_29767":185885,"_5":21387,"_28235":185847,"_5797":185886},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_6892":117758,"_42174":117743,"_29767":185888,"_5":21387,"_28235":185847,"_5797":185889},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_6892":117759,"_42174":117743,"_29767":185891,"_5":21387,"_28235":185851,"_5797":185892},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_6892":117760,"_42174":117743,"_29767":185894,"_5":21387,"_28235":185855,"_5797":185895},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_6892":117761,"_42174":117743,"_29767":185897,"_5":21387,"_28235":185859,"_5797":185898},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_6892":117762,"_42174":117743,"_29767":185900,"_5":21387,"_28235":185863,"_5797":185901},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_6892":117763,"_42174":117743,"_29767":185903,"_5":21387,"_28235":185867,"_5797":185904},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_6892":117764,"_42174":117764,"_5":21817,"_5797":185906,"_42654":185907,"_29767":185908,"_28235":117764},"Despliega Lamassu",[77248,185835],[],{"_6892":117765,"_42174":117764,"_29767":185910,"_5":21387,"_28235":117764,"_5797":185911},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_6892":117766,"_42174":117764,"_5":42651,"_29767":185913,"_28235":185914,"_5797":185915},[],"/docs/pr-preview/pr-56/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_6892":117767,"_42174":117764,"_5":42651,"_29767":185917,"_28235":185918,"_5797":185919},[],"/docs/pr-preview/pr-56/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_6892":117768,"_42174":117764,"_5":42651,"_29767":185921,"_28235":185922,"_5797":185923},[],"/docs/pr-preview/pr-56/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_6892":117769,"_42174":117764,"_29767":185925,"_5":21387,"_28235":117764,"_5797":185926},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_6892":117770,"_42174":117764,"_29767":185928,"_5":21387,"_28235":185914,"_5797":185929},[],"Modelo",{"_6892":117771,"_42174":117764,"_29767":185931,"_5":21387,"_28235":185914,"_5797":185932},[],"Recomendado para",{"_6892":117772,"_42174":117764,"_29767":185934,"_5":21387,"_28235":185914,"_5797":185935},[],"Quién opera la infraestructura",{"_6892":117773,"_42174":117764,"_29767":185937,"_5":21387,"_28235":185914,"_5797":185938},[],"Punto de partida",{"_6892":117774,"_42174":117764,"_29767":185940,"_5":21387,"_28235":185914,"_5797":77355},[],{"_6892":117775,"_42174":117764,"_29767":185942,"_5":21387,"_28235":185914,"_5797":185943},[],"Producción, entornos regulados y despliegues personalizados",{"_6892":117776,"_42174":117764,"_29767":185945,"_5":21387,"_28235":185914,"_5797":185946},[],"Tu equipo",{"_6892":117777,"_42174":117764,"_29767":185948,"_5":21387,"_28235":185914,"_5797":185949},[],"Helm o Fastlane",{"_6892":117778,"_42174":117764,"_29767":185951,"_5":21387,"_28235":185914,"_5797":77367},[],{"_6892":117779,"_42174":117764,"_29767":185953,"_5":21387,"_28235":185914,"_5797":185954},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_6892":117780,"_42174":117764,"_29767":185956,"_5":21387,"_28235":185914,"_5797":185946},[],{"_6892":117781,"_42174":117764,"_29767":185958,"_5":21387,"_28235":185914,"_5797":185959},[],"Imagen preconfigurada en EC2",{"_6892":117782,"_42174":117764,"_29767":185961,"_5":21387,"_28235":185914,"_5797":77378},[],{"_6892":117783,"_42174":117764,"_29767":185963,"_5":21387,"_28235":185914,"_5797":185964},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_6892":117784,"_42174":117764,"_29767":185966,"_5":21387,"_28235":185914,"_5797":77384},[],{"_6892":117785,"_42174":117764,"_29767":185968,"_5":21387,"_28235":185914,"_5797":185969},[],"Suscripción gestionada",{"_6892":117786,"_42174":117764,"_29767":185971,"_5":21387,"_28235":185914,"_5797":185972},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_6892":117787,"_42174":117764,"_29767":185974,"_5":21387,"_28235":185914,"_5797":185975},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_6892":117788,"_42174":117764,"_29767":185977,"_5":21387,"_28235":185914,"_5797":185978},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_6892":117789,"_42174":117764,"_29767":185980,"_5":21387,"_28235":185918,"_5797":185981},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_6892":117790,"_42174":117764,"_29767":185983,"_5":21387,"_28235":185922,"_5797":185984},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_6892":117791,"_42174":117791,"_5":21817,"_5797":185986,"_42654":185987,"_29767":185988,"_28235":117791},"Utiliza Lamassu como SaaS",[77248,185835,185836],[],{"_6892":117792,"_42174":117791,"_29767":185990,"_5":21387,"_28235":117791,"_5797":185991},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_6892":117793,"_42174":117791,"_5":42651,"_29767":185993,"_28235":185994,"_5797":185995},[],"/docs/pr-preview/pr-56/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_6892":117794,"_42174":117791,"_5":42651,"_29767":185997,"_28235":185998,"_5797":185999},[],"/docs/pr-preview/pr-56/es/deployment/saas#planes","Planes",{"_6892":117795,"_42174":117791,"_5":42651,"_29767":186001,"_28235":186002,"_5797":186003},[],"/docs/pr-preview/pr-56/es/deployment/saas#solicita-acceso","Solicita acceso",{"_6892":117796,"_42174":117791,"_29767":186005,"_5":21387,"_28235":117791,"_5797":186006},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_6892":117797,"_42174":117791,"_29767":186008,"_5":21387,"_28235":185994,"_5797":186009},[],"Disponibilidad y mantenimiento de la plataforma.",{"_6892":117798,"_42174":117791,"_29767":186011,"_5":21387,"_28235":185994,"_5797":186012},[],"Copias de seguridad automáticas.",{"_6892":117799,"_42174":117791,"_29767":186014,"_5":21387,"_28235":185994,"_5797":186015},[],"Actualizaciones de versión.",{"_6892":117800,"_42174":117791,"_29767":186017,"_5":21387,"_28235":185994,"_5797":186018},[],"Soporte técnico y SLA según el plan contratado.",{"_6892":117801,"_42174":117791,"_29767":186020,"_5":21387,"_28235":185998,"_5797":77439},[],{"_6892":117802,"_42174":117791,"_29767":186022,"_5":21387,"_28235":185998,"_5797":186023},[],"Dispositivos",{"_6892":117803,"_42174":117791,"_29767":186025,"_5":21387,"_28235":185998,"_5797":186026},[],"Soporte",{"_6892":117804,"_42174":117791,"_29767":186028,"_5":21387,"_28235":185998,"_5797":77448},[],{"_6892":117805,"_42174":117791,"_29767":186030,"_5":21387,"_28235":185998,"_5797":77451},[],{"_6892":117806,"_42174":117791,"_29767":186032,"_5":21387,"_28235":185998,"_5797":186033},[],"Hasta 1.000",{"_6892":117807,"_42174":117791,"_29767":186035,"_5":21387,"_28235":185998,"_5797":77457},[],{"_6892":117808,"_42174":117791,"_29767":186037,"_5":21387,"_28235":185998,"_5797":186038},[],"99,5 %",{"_6892":117809,"_42174":117791,"_29767":186040,"_5":21387,"_28235":185998,"_5797":77463},[],{"_6892":117810,"_42174":117791,"_29767":186042,"_5":21387,"_28235":185998,"_5797":186043},[],"Hasta 10.000",{"_6892":117811,"_42174":117791,"_29767":186045,"_5":21387,"_28235":185998,"_5797":186046},[],"Email y chat",{"_6892":117812,"_42174":117791,"_29767":186048,"_5":21387,"_28235":185998,"_5797":186049},[],"99,9 %",{"_6892":117813,"_42174":117791,"_29767":186051,"_5":21387,"_28235":185998,"_5797":77475},[],{"_6892":117814,"_42174":117791,"_29767":186053,"_5":21387,"_28235":185998,"_5797":186054},[],"Ilimitados",{"_6892":117815,"_42174":117791,"_29767":186056,"_5":21387,"_28235":185998,"_5797":186057},[],"Dedicado",{"_6892":117816,"_42174":117791,"_29767":186059,"_5":21387,"_28235":185998,"_5797":186060},[],"99,99 %",{"_6892":117817,"_42174":117791,"_29767":186062,"_5":21387,"_28235":186002,"_5797":186063},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_6892":117818,"_42174":117791,"_29767":186065,"_5":21387,"_28235":186002,"_5797":186066},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_6892":117819,"_42174":117819,"_5":21817,"_5797":77492,"_42654":186068,"_29767":186070,"_28235":117819},[77248,185835,186069],"Kubernetes autogestionado",[],{"_6892":117820,"_42174":117819,"_29767":186072,"_5":21387,"_28235":117819,"_5797":186073},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_6892":117821,"_42174":117819,"_5":42651,"_29767":186075,"_28235":186076,"_5797":186077},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_6892":117822,"_42174":117819,"_5":42651,"_29767":186079,"_28235":186080,"_5797":186081},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_6892":117823,"_42174":117819,"_5":42651,"_29767":186083,"_28235":186084,"_5797":186085},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_6892":117824,"_42174":117819,"_5":42651,"_29767":186087,"_28235":186088,"_5797":186089},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_6892":117825,"_42174":117819,"_5":42651,"_29767":186091,"_28235":186092,"_5797":186093},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_6892":117826,"_42174":117819,"_5":42651,"_29767":186095,"_28235":186096,"_5797":186097},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_6892":117827,"_42174":117819,"_5":42651,"_29767":186099,"_28235":186100,"_5797":186101},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_6892":117828,"_42174":117819,"_5":42651,"_29767":186103,"_28235":186104,"_5797":186105},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_6892":117829,"_42174":117819,"_5":42651,"_29767":186107,"_28235":186108,"_5797":186109},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_6892":117830,"_42174":117819,"_5":42651,"_29767":186111,"_28235":186112,"_5797":186113},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_6892":117831,"_42174":117819,"_5":42651,"_29767":186115,"_28235":186116,"_5797":186117},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_6892":117832,"_42174":117819,"_29767":186119,"_5":21387,"_28235":186076,"_5797":186120},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_6892":117833,"_42174":117819,"_29767":186122,"_5":21387,"_28235":186076,"_5797":186123},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_6892":117834,"_42174":117819,"_29767":186125,"_5":21387,"_28235":186080,"_5797":186126},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_6892":117835,"_42174":117819,"_29767":186128,"_5":21387,"_28235":186080,"_5797":186129},[],"Fastlane instala o configura",{"_6892":117836,"_42174":117819,"_29767":186131,"_5":21387,"_28235":186080,"_5797":186132},[],"Tú sigues proporcionando",{"_6892":117837,"_42174":117819,"_29767":186134,"_5":21387,"_28235":186080,"_5797":186135},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_6892":117838,"_42174":117819,"_29767":186137,"_5":21387,"_28235":186080,"_5797":186138},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_6892":117839,"_42174":117819,"_29767":186140,"_5":21387,"_28235":186080,"_5797":186141},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_6892":117840,"_42174":117819,"_29767":186143,"_5":21387,"_28235":186080,"_5797":186144},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_6892":117841,"_42174":117819,"_29767":186146,"_5":21387,"_28235":186080,"_5797":186147},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_6892":117842,"_42174":117819,"_29767":186149,"_5":21387,"_28235":186080,"_5797":186150},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_6892":117843,"_42174":117819,"_29767":186152,"_5":21387,"_28235":186080,"_5797":186153},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_6892":117844,"_42174":117819,"_29767":186155,"_5":21387,"_28235":186080,"_5797":186156},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_6892":117845,"_42174":117819,"_29767":186158,"_5":21387,"_28235":186080,"_5797":186159},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_6892":117846,"_42174":117819,"_29767":186161,"_5":21387,"_28235":186084,"_5797":186162},[],"Necesitas:",{"_6892":117847,"_42174":117819,"_29767":186164,"_5":21387,"_28235":186084,"_5797":186165},[],"un clúster Kubernetes existente",{"_6892":117848,"_42174":117819,"_29767":186167,"_5":21387,"_28235":186084,"_5797":186168},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_6892":117849,"_42174":117819,"_29767":186170,"_5":21387,"_28235":186084,"_5797":77594},[],{"_6892":117850,"_42174":117819,"_29767":186172,"_5":21387,"_28235":186084,"_5797":33016},[],{"_6892":117851,"_42174":117819,"_29767":186174,"_5":21387,"_28235":186084,"_5797":186175},[],"`jq` solo si usas `--sample-data` o `--development`",{"_6892":117852,"_42174":117819,"_29767":186177,"_5":21387,"_28235":186084,"_5797":186178},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_6892":117853,"_42174":117819,"_29767":186180,"_5":21387,"_28235":186084,"_5797":186181},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_6892":117854,"_42174":117819,"_29767":186183,"_5":21387,"_28235":186084,"_5797":186184},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_6892":117855,"_42174":117819,"_29767":186186,"_5":21387,"_28235":186084,"_5797":186187},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_6892":117856,"_42174":117819,"_29767":186189,"_5":21387,"_28235":186088,"_5797":186190},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_6892":117857,"_42174":117819,"_29767":186192,"_5":21387,"_28235":186088,"_5797":186193},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_6892":117858,"_42174":117819,"_29767":186195,"_5":21387,"_28235":186092,"_5797":186196},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_6892":117859,"_42174":117819,"_29767":186198,"_5":21387,"_28235":186092,"_5797":186199},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_6892":117860,"_42174":117819,"_29767":186201,"_5":21387,"_28235":186092,"_5797":186202},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_6892":117861,"_42174":117819,"_29767":186204,"_5":21387,"_28235":186092,"_5797":186205},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_6892":117862,"_42174":117819,"_29767":186207,"_5":21387,"_28235":186096,"_5797":186208},[],"Opción",{"_6892":117863,"_42174":117819,"_29767":186210,"_5":21387,"_28235":186096,"_5797":186211},[],"Valor predeterminado",{"_6892":117864,"_42174":117819,"_29767":186213,"_5":21387,"_28235":186096,"_5797":186214},[],"Propósito",{"_6892":117865,"_42174":117819,"_29767":186216,"_5":21387,"_28235":186096,"_5797":77641},[],{"_6892":117866,"_42174":117819,"_29767":186218,"_5":21387,"_28235":186096,"_5797":77644},[],{"_6892":117867,"_42174":117819,"_29767":186220,"_5":21387,"_28235":186096,"_5797":186221},[],"Muestra la ayuda",{"_6892":117868,"_42174":117819,"_29767":186223,"_5":21387,"_28235":186096,"_5797":77650},[],{"_6892":117869,"_42174":117819,"_29767":186225,"_5":21387,"_28235":186096,"_5797":186226},[],"contexto actual",{"_6892":117870,"_42174":117819,"_29767":186228,"_5":21387,"_28235":186096,"_5797":186229},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_6892":117871,"_42174":117819,"_29767":186231,"_5":21387,"_28235":186096,"_5797":77659},[],{"_6892":117872,"_42174":117819,"_29767":186233,"_5":21387,"_28235":186096,"_5797":11300},[],{"_6892":117873,"_42174":117819,"_29767":186235,"_5":21387,"_28235":186096,"_5797":186236},[],"Omite prompts y genera credenciales para las dependencias",{"_6892":117874,"_42174":117819,"_29767":186238,"_5":21387,"_28235":186096,"_5797":77667},[],{"_6892":117875,"_42174":117819,"_29767":186240,"_5":21387,"_28235":186096,"_5797":77670},[],{"_6892":117876,"_42174":117819,"_29767":186242,"_5":21387,"_28235":186096,"_5797":186243},[],"Namespace de la instalación",{"_6892":117877,"_42174":117819,"_29767":186245,"_5":21387,"_28235":186096,"_5797":77676},[],{"_6892":117878,"_42174":117819,"_29767":186247,"_5":21387,"_28235":186096,"_5797":77679},[],{"_6892":117879,"_42174":117819,"_29767":186249,"_5":21387,"_28235":186096,"_5797":186250},[],"Dominio usado por la UI, OIDC y el certificado",{"_6892":117880,"_42174":117819,"_29767":186252,"_5":21387,"_28235":186096,"_5797":77685},[],{"_6892":117881,"_42174":117819,"_29767":186254,"_5":21387,"_28235":186096,"_5797":22457},[],{"_6892":117882,"_42174":117819,"_29767":186256,"_5":21387,"_28235":186096,"_5797":186257},[],"Versión del chart de Lamassu",{"_6892":117883,"_42174":117819,"_29767":186259,"_5":21387,"_28235":186096,"_5797":77693},[],{"_6892":117884,"_42174":117819,"_29767":186261,"_5":21387,"_28235":186096,"_5797":77696},[],{"_6892":117885,"_42174":117819,"_29767":186263,"_5":21387,"_28235":186096,"_5797":186264},[],"Puerto del listener HTTPS",{"_6892":117886,"_42174":117819,"_29767":186266,"_5":21387,"_28235":186096,"_5797":77702},[],{"_6892":117887,"_42174":117819,"_29767":186268,"_5":21387,"_28235":186096,"_5797":77705},[],{"_6892":117888,"_42174":117819,"_29767":186270,"_5":21387,"_28235":186096,"_5797":186271},[],"Puerto del listener HTTP",{"_6892":117889,"_42174":117819,"_29767":186273,"_5":21387,"_28235":186096,"_5797":77711},[],{"_6892":117890,"_42174":117819,"_29767":186275,"_5":21387,"_28235":186096,"_5797":77644},[],{"_6892":117891,"_42174":117819,"_29767":186277,"_5":21387,"_28235":186096,"_5797":186278},[],"Certificado PEM para TLS downstream",{"_6892":117892,"_42174":117819,"_29767":186280,"_5":21387,"_28235":186096,"_5797":77719},[],{"_6892":117893,"_42174":117819,"_29767":186282,"_5":21387,"_28235":186096,"_5797":77644},[],{"_6892":117894,"_42174":117819,"_29767":186284,"_5":21387,"_28235":186096,"_5797":186285},[],"Clave privada PEM para TLS downstream",{"_6892":117895,"_42174":117819,"_29767":186287,"_5":21387,"_28235":186096,"_5797":77727},[],{"_6892":117896,"_42174":117819,"_29767":186289,"_5":21387,"_28235":186096,"_5797":186290},[],"chart del repositorio",{"_6892":117897,"_42174":117819,"_29767":186292,"_5":21387,"_28235":186096,"_5797":186293},[],"Usa un chart local de Lamassu sin empaquetar",{"_6892":117898,"_42174":117819,"_29767":186295,"_5":21387,"_28235":186096,"_5797":77736},[],{"_6892":117899,"_42174":117819,"_29767":186297,"_5":21387,"_28235":186096,"_5797":186298},[],"detección automática",{"_6892":117900,"_42174":117819,"_29767":186300,"_5":21387,"_28235":186096,"_5797":186301},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_6892":117901,"_42174":117819,"_29767":186303,"_5":21387,"_28235":186096,"_5797":77744},[],{"_6892":117902,"_42174":117819,"_29767":186305,"_5":21387,"_28235":186096,"_5797":11300},[],{"_6892":117903,"_42174":117819,"_29767":186307,"_5":21387,"_28235":186096,"_5797":186308},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_6892":117904,"_42174":117819,"_29767":186310,"_5":21387,"_28235":186096,"_5797":77752},[],{"_6892":117905,"_42174":117819,"_29767":186312,"_5":21387,"_28235":186096,"_5797":11300},[],{"_6892":117906,"_42174":117819,"_29767":186314,"_5":21387,"_28235":186096,"_5797":186315},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_6892":117907,"_42174":117819,"_29767":186317,"_5":21387,"_28235":186096,"_5797":77760},[],{"_6892":117908,"_42174":117819,"_29767":186319,"_5":21387,"_28235":186096,"_5797":11300},[],{"_6892":117909,"_42174":117819,"_29767":186321,"_5":21387,"_28235":186096,"_5797":186322},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_6892":117910,"_42174":117819,"_29767":186324,"_5":21387,"_28235":186096,"_5797":77768},[],{"_6892":117911,"_42174":117819,"_29767":186326,"_5":21387,"_28235":186096,"_5797":11300},[],{"_6892":117912,"_42174":117819,"_29767":186328,"_5":21387,"_28235":186096,"_5797":186329},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_6892":117913,"_42174":117819,"_29767":186331,"_5":21387,"_28235":186096,"_5797":77776},[],{"_6892":117914,"_42174":117819,"_29767":186333,"_5":21387,"_28235":186096,"_5797":77779},[],{"_6892":117915,"_42174":117819,"_29767":186335,"_5":21387,"_28235":186096,"_5797":186336},[],"Usa otro chart local de SoftHSM",{"_6892":117916,"_42174":117819,"_29767":186338,"_5":21387,"_28235":186096,"_5797":186339},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_6892":117917,"_42174":117819,"_29767":186341,"_5":21387,"_28235":186100,"_5797":186342},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_6892":117918,"_42174":117819,"_29767":186344,"_5":21387,"_28235":186100,"_5797":186345},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_6892":117919,"_42174":117819,"_29767":186347,"_5":21387,"_28235":186100,"_5797":186348},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_6892":117920,"_42174":117819,"_29767":186350,"_5":21387,"_28235":186100,"_5797":186351},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_6892":117921,"_42174":117819,"_29767":186353,"_5":21387,"_28235":186100,"_5797":186354},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_6892":117922,"_42174":117819,"_29767":186356,"_5":21387,"_28235":186100,"_5797":186357},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_6892":117923,"_42174":117819,"_29767":186359,"_5":21387,"_28235":186104,"_5797":77806},[],{"_6892":117924,"_42174":117819,"_29767":186361,"_5":21387,"_28235":186104,"_5797":186362},[],"valida las herramientas locales y el clúster seleccionado",{"_6892":117925,"_42174":117819,"_29767":186364,"_5":21387,"_28235":186104,"_5797":186365},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_6892":117926,"_42174":117819,"_29767":186367,"_5":21387,"_28235":186104,"_5797":186368},[],"crea el namespace",{"_6892":117927,"_42174":117819,"_29767":186370,"_5":21387,"_28235":186104,"_5797":186371},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_6892":117928,"_42174":117819,"_29767":186373,"_5":21387,"_28235":186104,"_5797":186374},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_6892":117929,"_42174":117819,"_29767":186376,"_5":21387,"_28235":186104,"_5797":186377},[],"instala RabbitMQ",{"_6892":117930,"_42174":117819,"_29767":186379,"_5":21387,"_28235":186104,"_5797":186380},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_6892":117931,"_42174":117819,"_29767":186382,"_5":21387,"_28235":186104,"_5797":186383},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_6892":117932,"_42174":117819,"_29767":186385,"_5":21387,"_28235":186104,"_5797":186386},[],"carga datos de ejemplo opcionalmente",{"_6892":117933,"_42174":117819,"_29767":186388,"_5":21387,"_28235":186104,"_5797":186389},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_6892":117934,"_42174":117819,"_29767":186391,"_5":21387,"_28235":186108,"_5797":186392},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_6892":117935,"_42174":117819,"_29767":186394,"_5":21387,"_28235":186108,"_5797":186395},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_6892":117936,"_42174":117819,"_29767":186397,"_5":21387,"_28235":186112,"_5797":186398},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_6892":117937,"_42174":117819,"_29767":186400,"_5":21387,"_28235":186112,"_5797":186401},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_6892":117938,"_42174":117819,"_29767":186403,"_5":21387,"_28235":186112,"_5797":186404},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_6892":117939,"_42174":117819,"_29767":186406,"_5":21387,"_28235":186116,"_5797":186407},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_6892":117940,"_42174":117940,"_5":21817,"_5797":186409,"_42654":186410,"_29767":186411,"_28235":117940},"Instala con Helm",[77248,185835,186069],[],{"_6892":117941,"_42174":117940,"_29767":186413,"_5":21387,"_28235":117940,"_5797":186414},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_6892":117942,"_42174":117940,"_5":42651,"_29767":186416,"_28235":186417,"_5797":186418},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_6892":117943,"_42174":117940,"_5":42651,"_29767":186420,"_28235":186421,"_5797":186085},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/helm#antes-de-comenzar",{"_6892":117944,"_42174":117940,"_5":42651,"_29767":186423,"_28235":186424,"_5797":186425},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_6892":117945,"_42174":117940,"_5":42651,"_29767":186427,"_28235":186428,"_5797":186429},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_6892":117946,"_42174":117940,"_5":42651,"_29767":186431,"_28235":186432,"_5797":186433},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_6892":117947,"_42174":117940,"_5":42651,"_29767":186435,"_28235":186436,"_5797":186437},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_6892":117948,"_42174":117940,"_5":42651,"_29767":186439,"_28235":186440,"_5797":186441},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_6892":117949,"_42174":117940,"_5":42651,"_29767":186443,"_28235":186444,"_5797":186445},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_6892":117950,"_42174":117940,"_5":42651,"_29767":186447,"_28235":186448,"_5797":186449},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_6892":117951,"_42174":117940,"_5":42651,"_29767":186451,"_28235":186452,"_5797":186453},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_6892":117952,"_42174":117940,"_29767":186455,"_5":21387,"_28235":186417,"_5797":186456},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_6892":117953,"_42174":117940,"_29767":186458,"_5":21387,"_28235":186421,"_5797":186459},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_6892":117954,"_42174":117940,"_29767":186461,"_5":21387,"_28235":186421,"_5797":186462},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_6892":117955,"_42174":117940,"_29767":186464,"_5":21387,"_28235":186421,"_5797":186465},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_6892":117956,"_42174":117940,"_29767":186467,"_5":21387,"_28235":186421,"_5797":186468},[],"un broker RabbitMQ accesible y sus credenciales",{"_6892":117957,"_42174":117940,"_29767":186470,"_5":21387,"_28235":186421,"_5797":186471},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_6892":117958,"_42174":117940,"_29767":186473,"_5":21387,"_28235":186421,"_5797":186474},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_6892":117959,"_42174":117940,"_29767":186476,"_5":21387,"_28235":186421,"_5797":186477},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_6892":117960,"_42174":117940,"_29767":186479,"_5":21387,"_28235":186421,"_5797":186480},[],"una StorageClass y un diseño de tráfico externo",{"_6892":117961,"_42174":117940,"_29767":186482,"_5":21387,"_28235":186421,"_5797":186483},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_6892":117962,"_42174":117940,"_29767":186485,"_5":21387,"_28235":186421,"_5797":186486},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_6892":117963,"_42174":117940,"_29767":186488,"_5":21387,"_28235":186421,"_5797":186489},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_6892":117964,"_42174":117940,"_29767":186491,"_5":21387,"_28235":186424,"_5797":186492},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_6892":117965,"_42174":117940,"_29767":186494,"_5":21387,"_28235":186424,"_5797":186495},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_6892":117966,"_42174":117940,"_29767":186497,"_5":21387,"_28235":186424,"_5797":186498},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_6892":117967,"_42174":117940,"_29767":186500,"_5":21387,"_28235":186428,"_5797":186501},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_6892":117968,"_42174":117940,"_29767":186503,"_5":21387,"_28235":186428,"_5797":186504},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_6892":117969,"_42174":117940,"_29767":186506,"_5":21387,"_28235":186428,"_5797":186507},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_6892":117970,"_42174":117940,"_29767":186509,"_5":21387,"_28235":186428,"_5797":186510},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_6892":117971,"_42174":117940,"_29767":186512,"_5":21387,"_28235":186432,"_5797":186513},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_6892":117972,"_42174":117940,"_29767":186515,"_5":21387,"_28235":186436,"_5797":186516},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_6892":117973,"_42174":117940,"_29767":186518,"_5":21387,"_28235":186436,"_5797":186519},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_6892":117974,"_42174":117940,"_29767":186521,"_5":21387,"_28235":186436,"_5797":186522},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_6892":117975,"_42174":117940,"_29767":186524,"_5":21387,"_28235":186436,"_5797":186525},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_6892":117976,"_42174":117940,"_29767":186527,"_5":21387,"_28235":186436,"_5797":186528},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_6892":117977,"_42174":117940,"_29767":186530,"_5":21387,"_28235":186436,"_5797":186531},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_6892":117978,"_42174":117940,"_29767":186533,"_5":21387,"_28235":186436,"_5797":186534},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_6892":117979,"_42174":117940,"_29767":186536,"_5":21387,"_28235":186440,"_5797":186537},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_6892":117980,"_42174":117940,"_29767":186539,"_5":21387,"_28235":186440,"_5797":186540},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_6892":117981,"_42174":117940,"_29767":186542,"_5":21387,"_28235":186440,"_5797":186543},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_6892":117982,"_42174":117940,"_29767":186545,"_5":21387,"_28235":186440,"_5797":186546},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_6892":117983,"_42174":117940,"_29767":186548,"_5":21387,"_28235":186444,"_5797":186549},[],"Para instalar un checkout local:",{"_6892":117984,"_42174":117940,"_29767":186551,"_5":21387,"_28235":186448,"_5797":186552},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_6892":117985,"_42174":117940,"_29767":186554,"_5":21387,"_28235":186448,"_5797":186555},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_6892":117986,"_42174":117940,"_29767":186557,"_5":21387,"_28235":186452,"_5797":186558},[],"Antes de pasar a producción, revisa:",{"_6892":117987,"_42174":117940,"_29767":186560,"_5":21387,"_28235":186452,"_5797":186561},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_6892":117988,"_42174":117940,"_29767":186563,"_5":21387,"_28235":186452,"_5797":186564},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_6892":117989,"_42174":117940,"_29767":186566,"_5":21387,"_28235":186452,"_5797":186567},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_6892":117990,"_42174":117940,"_29767":186569,"_5":21387,"_28235":186452,"_5797":186570},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_6892":117991,"_42174":117940,"_29767":186572,"_5":21387,"_28235":186452,"_5797":186573},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_6892":117992,"_42174":117940,"_29767":186575,"_5":21387,"_28235":186452,"_5797":186576},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_6892":117993,"_42174":117940,"_29767":186578,"_5":21387,"_28235":186452,"_5797":186579},[],"SMTP, observabilidad y entrega de alertas",{"_6892":117994,"_42174":117940,"_29767":186581,"_5":21387,"_28235":186452,"_5797":186582},[],"las guías de actualización entre versiones y las notas de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_6892":117995,"_42174":117940,"_29767":186584,"_5":21387,"_28235":186452,"_5797":186585},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_6892":117996,"_42174":117996,"_5":21817,"_5797":186587,"_42654":186588,"_29767":186589,"_28235":117996},"Expón el Gateway",[77248,185835,186069],[],{"_6892":117997,"_42174":117996,"_29767":186591,"_5":21387,"_28235":117996,"_5797":186592},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_6892":117998,"_42174":117996,"_5":42651,"_29767":186594,"_28235":186595,"_5797":186596},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_6892":117999,"_42174":117996,"_5":42651,"_29767":186598,"_28235":186599,"_5797":186600},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_6892":118000,"_42174":117996,"_5":42651,"_29767":186602,"_28235":186603,"_5797":186604},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_6892":118001,"_42174":117996,"_5":42651,"_29767":186606,"_28235":186607,"_5797":78055},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/networking#k3s",{"_6892":118002,"_42174":117996,"_5":42651,"_29767":186609,"_28235":186610,"_5797":186611},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_6892":118003,"_42174":117996,"_5":42651,"_29767":186613,"_28235":186614,"_5797":186615},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_6892":118004,"_42174":117996,"_5":42651,"_29767":186617,"_28235":186618,"_5797":186619},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_6892":118005,"_42174":117996,"_5":42651,"_29767":186621,"_28235":186622,"_5797":186623},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_6892":118006,"_42174":117996,"_5":42651,"_29767":186625,"_28235":186626,"_5797":186627},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_6892":118007,"_42174":117996,"_5":42651,"_29767":186629,"_28235":186630,"_5797":186631},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_6892":118008,"_42174":117996,"_29767":186633,"_5":21387,"_28235":186595,"_5797":186634},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_6892":118009,"_42174":117996,"_29767":186636,"_5":21387,"_28235":186595,"_5797":186637},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_6892":118010,"_42174":117996,"_29767":186639,"_5":21387,"_28235":186599,"_5797":186640},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_6892":118011,"_42174":117996,"_29767":186642,"_5":21387,"_28235":186599,"_5797":186643},[],"Defínelo únicamente cuando:",{"_6892":118012,"_42174":117996,"_29767":186645,"_5":21387,"_28235":186599,"_5797":186646},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_6892":118013,"_42174":117996,"_29767":186648,"_5":21387,"_28235":186599,"_5797":186649},[],"esa dirección está asignada a este Gateway",{"_6892":118014,"_42174":117996,"_29767":186651,"_5":21387,"_28235":186599,"_5797":186652},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_6892":118015,"_42174":117996,"_29767":186654,"_5":21387,"_28235":186599,"_5797":186655},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_6892":118016,"_42174":117996,"_29767":186657,"_5":21387,"_28235":186599,"_5797":186658},[],"No confundas estos valores:",{"_6892":118017,"_42174":117996,"_29767":186660,"_5":21387,"_28235":186599,"_5797":186661},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_6892":118018,"_42174":117996,"_29767":186663,"_5":21387,"_28235":186599,"_5797":186664},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_6892":118019,"_42174":117996,"_29767":186666,"_5":21387,"_28235":186599,"_5797":186667},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_6892":118020,"_42174":117996,"_29767":186669,"_5":21387,"_28235":186603,"_5797":186670},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_6892":118021,"_42174":117996,"_29767":186672,"_5":21387,"_28235":186603,"_5797":186673},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_6892":118022,"_42174":117996,"_29767":186675,"_5":21387,"_28235":186607,"_5797":186676},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_6892":118023,"_42174":117996,"_29767":186678,"_5":21387,"_28235":186607,"_5797":186679},[],"Para el diseño recomendado:",{"_6892":118024,"_42174":117996,"_29767":186681,"_5":21387,"_28235":186607,"_5797":186682},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_6892":118025,"_42174":117996,"_29767":186684,"_5":21387,"_28235":186607,"_5797":186685},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_6892":118026,"_42174":117996,"_29767":186687,"_5":21387,"_28235":186607,"_5797":186688},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_6892":118027,"_42174":117996,"_29767":186690,"_5":21387,"_28235":186607,"_5797":186691},[],"Apunta DNS a la dirección accesible de la VM.",{"_6892":118028,"_42174":117996,"_29767":186693,"_5":21387,"_28235":186607,"_5797":186694},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_6892":118029,"_42174":117996,"_29767":186696,"_5":21387,"_28235":186610,"_5797":186697},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_6892":118030,"_42174":117996,"_29767":186699,"_5":21387,"_28235":186614,"_5797":186700},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_6892":118031,"_42174":117996,"_29767":186702,"_5":21387,"_28235":186614,"_5797":186703},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_6892":118032,"_42174":117996,"_29767":186705,"_5":21387,"_28235":186618,"_5797":186706},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_6892":118033,"_42174":117996,"_29767":186708,"_5":21387,"_28235":186618,"_5797":186709},[],"Requisito",{"_6892":118034,"_42174":117996,"_29767":186711,"_5":21387,"_28235":186618,"_5797":186712},[],"Diseño recomendado",{"_6892":118035,"_42174":117996,"_29767":186714,"_5":21387,"_28235":186618,"_5797":186715},[],"Consecuencia",{"_6892":118036,"_42174":117996,"_29767":186717,"_5":21387,"_28235":186618,"_5797":186718},[],"Varias URL o servicios de Lamassu",{"_6892":118037,"_42174":117996,"_29767":186720,"_5":21387,"_28235":186618,"_5797":186721},[],"Un Gateway con varias rutas",{"_6892":118038,"_42174":117996,"_29767":186723,"_5":21387,"_28235":186618,"_5797":186724},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_6892":118039,"_42174":117996,"_29767":186726,"_5":21387,"_28235":186618,"_5797":186727},[],"Gateways independientes e IP externas distintas",{"_6892":118040,"_42174":117996,"_29767":186729,"_5":21387,"_28235":186618,"_5797":186730},[],"Una VIP por Gateway",{"_6892":118041,"_42174":117996,"_29767":186732,"_5":21387,"_28235":186618,"_5797":186733},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_6892":118042,"_42174":117996,"_29767":186735,"_5":21387,"_28235":186618,"_5797":186736},[],"Gateways independientes, un nodo y una IP",{"_6892":118043,"_42174":117996,"_29767":186738,"_5":21387,"_28235":186618,"_5797":186739},[],"Puertos externos diferentes",{"_6892":118044,"_42174":117996,"_29767":186741,"_5":21387,"_28235":186618,"_5797":186742},[],"Los clientes deben indicar puertos no estándar",{"_6892":118045,"_42174":117996,"_29767":186744,"_5":21387,"_28235":186618,"_5797":186745},[],"Terminación TLS/mTLS separada detrás de una IP",{"_6892":118046,"_42174":117996,"_29767":186747,"_5":21387,"_28235":186618,"_5797":186748},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_6892":118047,"_42174":117996,"_29767":186750,"_5":21387,"_28235":186618,"_5797":186751},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_6892":118048,"_42174":117996,"_29767":186753,"_5":21387,"_28235":186618,"_5797":186754},[],"Recursos Gateway separados pero proxy compartido",{"_6892":118049,"_42174":117996,"_29767":186756,"_5":21387,"_28235":186618,"_5797":186757},[],"Modo merged Gateway de Envoy",{"_6892":118050,"_42174":117996,"_29767":186759,"_5":21387,"_28235":186618,"_5797":186760},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_6892":118051,"_42174":117996,"_29767":186762,"_5":21387,"_28235":186618,"_5797":186763},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_6892":118052,"_42174":117996,"_29767":186765,"_5":21387,"_28235":186618,"_5797":186766},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_6892":118053,"_42174":117996,"_29767":186768,"_5":21387,"_28235":186618,"_5797":186769},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_6892":118054,"_42174":117996,"_29767":186771,"_5":21387,"_28235":186618,"_5797":186772},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_6892":118055,"_42174":117996,"_29767":186774,"_5":21387,"_28235":186622,"_5797":186775},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_6892":118056,"_42174":117996,"_29767":186777,"_5":21387,"_28235":186622,"_5797":186778},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_6892":118057,"_42174":117996,"_29767":186780,"_5":21387,"_28235":186622,"_5797":186781},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_6892":118058,"_42174":117996,"_29767":186783,"_5":21387,"_28235":186622,"_5797":186784},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_6892":118059,"_42174":117996,"_29767":186786,"_5":21387,"_28235":186622,"_5797":186787},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_6892":118060,"_42174":117996,"_29767":186789,"_5":21387,"_28235":186626,"_5797":186790},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_6892":118061,"_42174":117996,"_29767":186792,"_5":21387,"_28235":186626,"_5797":186793},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_6892":118062,"_42174":117996,"_29767":186795,"_5":21387,"_28235":186630,"_5797":186796},[],"Comprueba, en orden:",{"_6892":118063,"_42174":117996,"_29767":186798,"_5":21387,"_28235":186630,"_5797":186799},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_6892":118064,"_42174":117996,"_29767":186801,"_5":21387,"_28235":186630,"_5797":186802},[],"Su estado contiene la dirección esperada.",{"_6892":118065,"_42174":117996,"_29767":186804,"_5":21387,"_28235":186630,"_5797":186805},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_6892":118066,"_42174":117996,"_29767":186807,"_5":21387,"_28235":186630,"_5797":186808},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_6892":118067,"_42174":117996,"_29767":186810,"_5":21387,"_28235":186630,"_5797":186811},[],"DNS resuelve al endpoint accesible externamente.",{"_6892":118068,"_42174":117996,"_29767":186813,"_5":21387,"_28235":186630,"_5797":186814},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_6892":118069,"_42174":117996,"_29767":186816,"_5":21387,"_28235":186630,"_5797":186817},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_6892":118070,"_42174":118070,"_5":21817,"_5797":77355,"_42654":186819,"_29767":186820,"_28235":118070},[77248,185835,186069],[],{"_6892":118071,"_42174":118070,"_29767":186822,"_5":21387,"_28235":118070,"_5797":186823},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_6892":118072,"_42174":118070,"_5":42651,"_29767":186825,"_28235":186826,"_5797":186827},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_6892":118073,"_42174":118070,"_5":42651,"_29767":186829,"_28235":186830,"_5797":186831},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_6892":118074,"_42174":118070,"_5":42651,"_29767":186833,"_28235":186834,"_5797":186835},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_6892":118075,"_42174":118070,"_5":42651,"_29767":186837,"_28235":186838,"_5797":186839},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_6892":118076,"_42174":118070,"_5":42651,"_29767":186841,"_28235":186842,"_5797":186843},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_6892":118077,"_42174":118070,"_5":42651,"_29767":186845,"_28235":186846,"_5797":186847},[],"/docs/pr-preview/pr-56/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_6892":118078,"_42174":118070,"_29767":186849,"_5":21387,"_28235":186826,"_5797":186850},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_6892":118079,"_42174":118070,"_29767":186852,"_5":21387,"_28235":186830,"_5797":186853},[],"Flujo",{"_6892":118080,"_42174":118070,"_29767":186855,"_5":21387,"_28235":186830,"_5797":186856},[],"Úsalo para",{"_6892":118081,"_42174":118070,"_29767":186858,"_5":21387,"_28235":186830,"_5797":186859},[],"Qué instala",{"_6892":118082,"_42174":118070,"_29767":186861,"_5":21387,"_28235":186830,"_5797":78310},[],{"_6892":118083,"_42174":118070,"_29767":186863,"_5":21387,"_28235":186830,"_5797":186864},[],"Producción y entornos controlados",{"_6892":118084,"_42174":118070,"_29767":186866,"_5":21387,"_28235":186830,"_5797":186867},[],"Servicios de Lamassu y recursos de Gateway API",{"_6892":118085,"_42174":118070,"_29767":186869,"_5":21387,"_28235":186830,"_5797":77492},[],{"_6892":118086,"_42174":118070,"_29767":186871,"_5":21387,"_28235":186830,"_5797":186872},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_6892":118087,"_42174":118070,"_29767":186874,"_5":21387,"_28235":186830,"_5797":186875},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_6892":118088,"_42174":118070,"_29767":186877,"_5":21387,"_28235":186834,"_5797":186878},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_6892":118089,"_42174":118070,"_29767":186880,"_5":21387,"_28235":186834,"_5797":186881},[],"Área",{"_6892":118090,"_42174":118070,"_29767":186883,"_5":21387,"_28235":186834,"_5797":186884},[],"El chart de Lamassu proporciona",{"_6892":118091,"_42174":118070,"_29767":186886,"_5":21387,"_28235":186834,"_5797":186887},[],"Tú proporcionas",{"_6892":118092,"_42174":118070,"_29767":186889,"_5":21387,"_28235":186834,"_5797":186890},[],"Aplicaciones Lamassu",{"_6892":118093,"_42174":118070,"_29767":186892,"_5":21387,"_28235":186834,"_5797":186893},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_6892":118094,"_42174":118070,"_29767":186895,"_5":21387,"_28235":186834,"_5797":186896},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_6892":118095,"_42174":118070,"_29767":186898,"_5":21387,"_28235":186834,"_5797":186899},[],"Datos PostgreSQL",{"_6892":118096,"_42174":118070,"_29767":186901,"_5":21387,"_28235":186834,"_5797":186902},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_6892":118097,"_42174":118070,"_29767":186904,"_5":21387,"_28235":186834,"_5797":186905},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_6892":118098,"_42174":118070,"_29767":186907,"_5":21387,"_28235":186834,"_5797":186908},[],"Mensajería",{"_6892":118099,"_42174":118070,"_29767":186910,"_5":21387,"_28235":186834,"_5797":186911},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_6892":118100,"_42174":118070,"_29767":186913,"_5":21387,"_28235":186834,"_5797":186914},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_6892":118101,"_42174":118070,"_29767":186916,"_5":21387,"_28235":186834,"_5797":186917},[],"Identidad",{"_6892":118102,"_42174":118070,"_29767":186919,"_5":21387,"_28235":186834,"_5797":186920},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_6892":118103,"_42174":118070,"_29767":186922,"_5":21387,"_28235":186834,"_5797":186923},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_6892":118104,"_42174":118070,"_29767":186925,"_5":21387,"_28235":186834,"_5797":186926},[],"Enrutamiento externo",{"_6892":118105,"_42174":118070,"_29767":186928,"_5":21387,"_28235":186834,"_5797":186929},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_6892":118106,"_42174":118070,"_29767":186931,"_5":21387,"_28235":186834,"_5797":186932},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_6892":118107,"_42174":118070,"_29767":186934,"_5":21387,"_28235":186834,"_5797":78384},[],{"_6892":118108,"_42174":118070,"_29767":186936,"_5":21387,"_28235":186834,"_5797":186937},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_6892":118109,"_42174":118070,"_29767":186939,"_5":21387,"_28235":186834,"_5797":186940},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_6892":118110,"_42174":118070,"_29767":186942,"_5":21387,"_28235":186834,"_5797":186943},[],"Datos persistentes de la aplicación",{"_6892":118111,"_42174":118070,"_29767":186945,"_5":21387,"_28235":186834,"_5797":186946},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_6892":118112,"_42174":118070,"_29767":186948,"_5":21387,"_28235":186834,"_5797":186949},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_6892":118113,"_42174":118070,"_29767":186951,"_5":21387,"_28235":186834,"_5797":186952},[],"Integraciones opcionales",{"_6892":118114,"_42174":118070,"_29767":186954,"_5":21387,"_28235":186834,"_5797":186955},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_6892":118115,"_42174":118070,"_29767":186957,"_5":21387,"_28235":186834,"_5797":186958},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_6892":118116,"_42174":118070,"_29767":186960,"_5":21387,"_28235":186834,"_5797":186961},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_6892":118117,"_42174":118070,"_29767":186963,"_5":21387,"_28235":186834,"_5797":186964},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_6892":118118,"_42174":118070,"_29767":186966,"_5":21387,"_28235":186838,"_5797":186967},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_6892":118119,"_42174":118070,"_29767":186969,"_5":21387,"_28235":186838,"_5797":186970},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_6892":118120,"_42174":118070,"_29767":186972,"_5":21387,"_28235":186842,"_5797":186973},[],"Kubernetes 1.24 o posterior",{"_6892":118121,"_42174":118070,"_29767":186975,"_5":21387,"_28235":186842,"_5797":186976},[],"Helm 3.2 o posterior",{"_6892":118122,"_42174":118070,"_29767":186978,"_5":21387,"_28235":186842,"_5797":186979},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_6892":118123,"_42174":118070,"_29767":186981,"_5":21387,"_28235":186842,"_5797":186982},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_6892":118124,"_42174":118070,"_29767":186984,"_5":21387,"_28235":186842,"_5797":186985},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_6892":118125,"_42174":118070,"_29767":186987,"_5":21387,"_28235":186842,"_5797":186988},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_6892":118126,"_42174":118070,"_29767":186990,"_5":21387,"_28235":186842,"_5797":186991},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_6892":118127,"_42174":118070,"_29767":186993,"_5":21387,"_28235":186846,"_5797":186994},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_6892":118128,"_42174":118070,"_29767":186996,"_5":21387,"_28235":186846,"_5797":186997},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_6892":118129,"_42174":118070,"_29767":186999,"_5":21387,"_28235":186846,"_5797":187000},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_6892":118130,"_42174":118070,"_29767":187002,"_5":21387,"_28235":186846,"_5797":187003},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_6892":118131,"_42174":118131,"_5":21817,"_5797":187005,"_42654":187006,"_29767":187008,"_28235":118131},"Resolución de problemas de despliegue",[77248,185835,187007],"Operación",[],{"_6892":118132,"_42174":118131,"_29767":187010,"_5":21387,"_28235":118131,"_5797":187011},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_6892":118133,"_42174":118131,"_5":42651,"_29767":187013,"_28235":187014,"_5797":187015},[],"/docs/pr-preview/pr-56/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_6892":118134,"_42174":118131,"_5":42651,"_29767":187017,"_28235":187018,"_5797":187019},[],"/docs/pr-preview/pr-56/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_6892":118135,"_42174":118131,"_5":42651,"_29767":187021,"_28235":187022,"_5797":187023},[],"/docs/pr-preview/pr-56/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_6892":118136,"_42174":118131,"_5":42651,"_29767":187025,"_28235":187026,"_5797":187027},[],"/docs/pr-preview/pr-56/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_6892":118137,"_42174":118131,"_5":42651,"_29767":187029,"_28235":187030,"_5797":187031},[],"/docs/pr-preview/pr-56/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_6892":118138,"_42174":118131,"_5":42651,"_29767":187033,"_28235":187034,"_5797":187035},[],"/docs/pr-preview/pr-56/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_6892":118139,"_42174":118131,"_5":42651,"_29767":187037,"_28235":187038,"_5797":187039},[],"/docs/pr-preview/pr-56/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_6892":118140,"_42174":118131,"_5":42651,"_29767":187041,"_28235":187042,"_5797":187043},[],"/docs/pr-preview/pr-56/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_6892":118141,"_42174":118131,"_5":42651,"_29767":187045,"_28235":187046,"_5797":187047},[],"/docs/pr-preview/pr-56/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_6892":118142,"_42174":118131,"_5":42651,"_29767":187049,"_28235":187050,"_5797":187051},[],"/docs/pr-preview/pr-56/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_6892":118143,"_42174":118131,"_5":42651,"_29767":187053,"_28235":187054,"_5797":187055},[],"/docs/pr-preview/pr-56/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_6892":118144,"_42174":118131,"_5":42651,"_29767":187057,"_28235":187058,"_5797":187059},[],"/docs/pr-preview/pr-56/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_6892":118145,"_42174":118131,"_5":42651,"_29767":187061,"_28235":187062,"_5797":187063},[],"/docs/pr-preview/pr-56/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_6892":118146,"_42174":118131,"_29767":187065,"_5":21387,"_28235":118131,"_5797":187066},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_6892":118147,"_42174":118131,"_29767":187068,"_5":21387,"_28235":187018,"_5797":187069},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_6892":118148,"_42174":118131,"_29767":187071,"_5":21387,"_28235":187022,"_5797":187072},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_6892":118149,"_42174":118131,"_29767":187074,"_5":21387,"_28235":187026,"_5797":187075},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_6892":118150,"_42174":118131,"_29767":187077,"_5":21387,"_28235":187030,"_5797":187078},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_6892":118151,"_42174":118131,"_29767":187080,"_5":21387,"_28235":187034,"_5797":187081},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_6892":118152,"_42174":118131,"_29767":187083,"_5":21387,"_28235":187038,"_5797":187084},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_6892":118153,"_42174":118131,"_29767":187086,"_5":21387,"_28235":187038,"_5797":187087},[],"Ejecuta también la prueba de conectividad del chart:",{"_6892":118154,"_42174":118131,"_29767":187089,"_5":21387,"_28235":187038,"_5797":187090},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_6892":118155,"_42174":118131,"_29767":187092,"_5":21387,"_28235":187038,"_5797":187093},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_6892":118156,"_42174":118131,"_29767":187095,"_5":21387,"_28235":187042,"_5797":187096},[],"Si recibes un 401:",{"_6892":118157,"_42174":118131,"_29767":187098,"_5":21387,"_28235":187042,"_5797":187099},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_6892":118158,"_42174":118131,"_29767":187101,"_5":21387,"_28235":187042,"_5797":187102},[],"verifica emisor, audiencia y expiración del token;",{"_6892":118159,"_42174":118131,"_29767":187104,"_5":21387,"_28235":187042,"_5797":187105},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_6892":118160,"_42174":118131,"_29767":187107,"_5":21387,"_28235":187042,"_5797":187108},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_6892":118161,"_42174":118131,"_29767":187110,"_5":21387,"_28235":187042,"_5797":187111},[],"Si el login termina pero las APIs devuelven 403:",{"_6892":118162,"_42174":118131,"_29767":187113,"_5":21387,"_28235":187042,"_5797":187114},[],"inspecciona los claims reales del token;",{"_6892":118163,"_42174":118131,"_29767":187116,"_5":21387,"_28235":187042,"_5797":187117},[],"confirma que coinciden con un principal activo;",{"_6892":118164,"_42174":118131,"_29767":187119,"_5":21387,"_28235":187042,"_5797":187120},[],"revisa las políticas concedidas al principal;",{"_6892":118165,"_42174":118131,"_29767":187122,"_5":21387,"_28235":187042,"_5797":187123},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_6892":118166,"_42174":118131,"_29767":187125,"_5":21387,"_28235":187042,"_5797":187126},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_6892":118167,"_42174":118131,"_29767":187128,"_5":21387,"_28235":187046,"_5797":187129},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_6892":118168,"_42174":118131,"_29767":187131,"_5":21387,"_28235":187046,"_5797":187132},[],"Localiza el pod y Service de authz.",{"_6892":118169,"_42174":118131,"_29767":187134,"_5":21387,"_28235":187046,"_5797":187135},[],"Comprueba /health, logs y conexión a su base de datos.",{"_6892":118170,"_42174":118131,"_29767":187137,"_5":21387,"_28235":187046,"_5797":187138},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_6892":118171,"_42174":118131,"_29767":187140,"_5":21387,"_28235":187046,"_5797":187141},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_6892":118172,"_42174":118131,"_29767":187143,"_5":21387,"_28235":187046,"_5797":187144},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_6892":118173,"_42174":118131,"_29767":187146,"_5":21387,"_28235":187050,"_5797":187147},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_6892":118174,"_42174":118131,"_29767":187149,"_5":21387,"_28235":187054,"_5797":187150},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_6892":118175,"_42174":118131,"_29767":187152,"_5":21387,"_28235":187054,"_5797":187153},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_6892":118176,"_42174":118131,"_29767":187155,"_5":21387,"_28235":187054,"_5797":187156},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_6892":118177,"_42174":118131,"_29767":187158,"_5":21387,"_28235":187054,"_5797":187159},[],"volumen persistente sin enlazar;",{"_6892":118178,"_42174":118131,"_29767":187161,"_5":21387,"_28235":187054,"_5797":187162},[],"imagen inaccesible o política de pull incorrecta;",{"_6892":118179,"_42174":118131,"_29767":187164,"_5":21387,"_28235":187054,"_5797":187165},[],"configuración inválida del motor criptográfico;",{"_6892":118180,"_42174":118131,"_29767":187167,"_5":21387,"_28235":187054,"_5797":187168},[],"límites de CPU o memoria demasiado bajos;",{"_6892":118181,"_42174":118131,"_29767":187170,"_5":21387,"_28235":187054,"_5797":187171},[],"migración previa incompleta.",{"_6892":118182,"_42174":118131,"_29767":187173,"_5":21387,"_28235":187054,"_5797":187174},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_6892":118183,"_42174":118131,"_29767":187176,"_5":21387,"_28235":187054,"_5797":187177},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_6892":118184,"_42174":118131,"_29767":187179,"_5":21387,"_28235":187054,"_5797":187180},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_6892":118185,"_42174":118131,"_29767":187182,"_5":21387,"_28235":187058,"_5797":187183},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_6892":118186,"_42174":118131,"_29767":187185,"_5":21387,"_28235":187058,"_5797":187186},[],"verifica que esté habilitado en el servicio emisor;",{"_6892":118187,"_42174":118131,"_29767":187188,"_5":21387,"_28235":187058,"_5797":187189},[],"comprueba conectividad y credenciales AMQP;",{"_6892":118188,"_42174":118131,"_29767":187191,"_5":21387,"_28235":187058,"_5797":187192},[],"revisa exchange, routing key, colas y consumidores;",{"_6892":118189,"_42174":118131,"_29767":187194,"_5":21387,"_28235":187058,"_5797":187195},[],"inspecciona dead-letter queues;",{"_6892":118190,"_42174":118131,"_29767":187197,"_5":21387,"_28235":187058,"_5797":187198},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_6892":118191,"_42174":118131,"_29767":187200,"_5":21387,"_28235":187058,"_5797":187201},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_6892":118192,"_42174":118131,"_29767":187203,"_5":21387,"_28235":187058,"_5797":187204},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_6892":118193,"_42174":118131,"_29767":187206,"_5":21387,"_28235":187058,"_5797":187207},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_6892":118194,"_42174":118131,"_29767":187209,"_5":21387,"_28235":187058,"_5797":187210},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_6892":118195,"_42174":118131,"_29767":187212,"_5":21387,"_28235":187058,"_5797":187213},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_6892":118196,"_42174":118131,"_29767":187215,"_5":21387,"_28235":187058,"_5797":187216},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_6892":118197,"_42174":118131,"_29767":187218,"_5":21387,"_28235":187058,"_5797":187219},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_6892":118198,"_42174":118131,"_29767":187221,"_5":21387,"_28235":187062,"_5797":187222},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_6892":118199,"_42174":118131,"_29767":187224,"_5":21387,"_28235":187062,"_5797":187225},[],"Antes de cerrar una incidencia, guarda:",{"_6892":118200,"_42174":118131,"_29767":187227,"_5":21387,"_28235":187062,"_5797":187228},[],"causa confirmada;",{"_6892":118201,"_42174":118131,"_29767":187230,"_5":21387,"_28235":187062,"_5797":187231},[],"alcance temporal y recursos afectados;",{"_6892":118202,"_42174":118131,"_29767":187233,"_5":21387,"_28235":187062,"_5797":187234},[],"comandos o consultas utilizados;",{"_6892":118203,"_42174":118131,"_29767":187236,"_5":21387,"_28235":187062,"_5797":187237},[],"cambio aplicado y forma de revertirlo;",{"_6892":118204,"_42174":118131,"_29767":187239,"_5":21387,"_28235":187062,"_5797":187240},[],"validación desde un consumidor;",{"_6892":118205,"_42174":118131,"_29767":187242,"_5":21387,"_28235":187062,"_5797":187243},[],"acción preventiva y propietario.",{"_6892":118206,"_42174":118206,"_5":21817,"_5797":187245,"_42654":187246,"_29767":187249,"_28235":118206},"Control de acceso",[77248,187247,187248],"Plataforma","Administración",[],{"_6892":118207,"_42174":118206,"_29767":187251,"_5":21387,"_28235":118206,"_5797":187252},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_6892":118208,"_42174":118206,"_5":42651,"_29767":187254,"_28235":187255,"_5797":187256},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_6892":118209,"_42174":118206,"_5":42651,"_29767":187258,"_28235":187259,"_5797":187260},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_6892":118210,"_42174":118206,"_5":42651,"_29767":187262,"_28235":187263,"_5797":187264},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_6892":118211,"_42174":118206,"_5":42651,"_29767":187266,"_28235":187267,"_5797":187268},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_6892":118212,"_42174":118206,"_5":42651,"_29767":187270,"_28235":187271,"_5797":187272},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_6892":118213,"_42174":118206,"_5":42651,"_29767":187274,"_28235":187275,"_5797":187276},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_6892":118214,"_42174":118206,"_5":42651,"_29767":187278,"_28235":187279,"_5797":187280},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_6892":118215,"_42174":118206,"_5":42651,"_29767":187282,"_28235":187283,"_5797":187284},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#principales-x509","Principales X.509",{"_6892":118216,"_42174":118206,"_5":42651,"_29767":187286,"_28235":187287,"_5797":187288},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_6892":118217,"_42174":118206,"_5":42651,"_29767":187290,"_28235":187291,"_5797":187292},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_6892":118218,"_42174":118206,"_5":42651,"_29767":187294,"_28235":187295,"_5797":187296},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_6892":118219,"_42174":118206,"_5":42651,"_29767":187298,"_28235":187299,"_5797":187300},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_6892":118220,"_42174":118206,"_5":42651,"_29767":187302,"_28235":187303,"_5797":187304},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_6892":118221,"_42174":118206,"_5":42651,"_29767":187306,"_28235":187307,"_5797":187308},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_6892":118222,"_42174":118206,"_5":42651,"_29767":187310,"_28235":187311,"_5797":187312},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_6892":118223,"_42174":118206,"_5":42651,"_29767":187314,"_28235":187315,"_5797":186441},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_6892":118224,"_42174":118206,"_5":42651,"_29767":187317,"_28235":187318,"_5797":187319},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_6892":118225,"_42174":118206,"_5":42651,"_29767":187321,"_28235":187322,"_5797":187323},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_6892":118226,"_42174":118206,"_5":42651,"_29767":187325,"_28235":187326,"_5797":187327},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_6892":118227,"_42174":118206,"_5":42651,"_29767":187329,"_28235":187330,"_5797":187331},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_6892":118228,"_42174":118206,"_5":42651,"_29767":187333,"_28235":187334,"_5797":187335},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_6892":118229,"_42174":118206,"_5":42651,"_29767":187337,"_28235":187338,"_5797":187339},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_6892":118230,"_42174":118206,"_5":42651,"_29767":187341,"_28235":187342,"_5797":187343},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_6892":118231,"_42174":118206,"_5":42651,"_29767":187345,"_28235":187346,"_5797":187347},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_6892":118232,"_42174":118206,"_5":42651,"_29767":187349,"_28235":187350,"_5797":187351},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_6892":118233,"_42174":118206,"_5":42651,"_29767":187353,"_28235":187354,"_5797":187355},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_6892":118234,"_42174":118206,"_5":42651,"_29767":187357,"_28235":187358,"_5797":187359},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_6892":118235,"_42174":118206,"_5":42651,"_29767":187361,"_28235":187362,"_5797":187363},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_6892":118236,"_42174":118206,"_5":42651,"_29767":187365,"_28235":187366,"_5797":187367},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_6892":118237,"_42174":118206,"_5":42651,"_29767":187369,"_28235":187370,"_5797":187371},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_6892":118238,"_42174":118206,"_5":42651,"_29767":187373,"_28235":187374,"_5797":187375},[],"/docs/pr-preview/pr-56/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_6892":118239,"_42174":118206,"_29767":187377,"_5":21387,"_28235":118206,"_5797":187378},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_6892":118240,"_42174":118206,"_29767":187380,"_5":21387,"_28235":118206,"_5797":187381},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_6892":118241,"_42174":118206,"_29767":187383,"_5":21387,"_28235":118206,"_5797":187384},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_6892":118242,"_42174":118206,"_29767":187386,"_5":21387,"_28235":187255,"_5797":187387},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_6892":118243,"_42174":118206,"_29767":187389,"_5":21387,"_28235":187255,"_5797":187390},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_6892":118244,"_42174":118206,"_29767":187392,"_5":21387,"_28235":187255,"_5797":187393},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_6892":118245,"_42174":118206,"_29767":187395,"_5":21387,"_28235":187255,"_5797":187396},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_6892":118246,"_42174":118206,"_29767":187398,"_5":21387,"_28235":187255,"_5797":187399},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_6892":118247,"_42174":118206,"_29767":187401,"_5":21387,"_28235":187255,"_5797":187402},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_6892":118248,"_42174":118206,"_29767":187404,"_5":21387,"_28235":187259,"_5797":187405},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_6892":118249,"_42174":118206,"_29767":187407,"_5":21387,"_28235":187259,"_5797":187408},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_6892":118250,"_42174":118206,"_29767":187410,"_5":21387,"_28235":187263,"_5797":187411},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_6892":118251,"_42174":118206,"_29767":187413,"_5":21387,"_28235":187263,"_5797":187414},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_6892":118252,"_42174":118206,"_29767":187416,"_5":21387,"_28235":187263,"_5797":187417},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_6892":118253,"_42174":118206,"_29767":187419,"_5":21387,"_28235":187263,"_5797":187420},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_6892":118254,"_42174":118206,"_29767":187422,"_5":21387,"_28235":187263,"_5797":187423},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_6892":118255,"_42174":118206,"_29767":187425,"_5":21387,"_28235":187263,"_5797":187426},[],"Carga por separado las políticas concedidas a cada principal.",{"_6892":118256,"_42174":118206,"_29767":187428,"_5":21387,"_28235":187263,"_5797":187429},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_6892":118257,"_42174":118206,"_29767":187431,"_5":21387,"_28235":187263,"_5797":187432},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_6892":118258,"_42174":118206,"_29767":187434,"_5":21387,"_28235":187263,"_5797":187435},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_6892":118259,"_42174":118206,"_29767":187437,"_5":21387,"_28235":187263,"_5797":187438},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_6892":118260,"_42174":118206,"_29767":187440,"_5":21387,"_28235":187263,"_5797":187441},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_6892":118261,"_42174":118206,"_29767":187443,"_5":21387,"_28235":187263,"_5797":187444},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_6892":118262,"_42174":118206,"_29767":187446,"_5":21387,"_28235":187267,"_5797":187447},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_6892":118263,"_42174":118206,"_29767":187449,"_5":21387,"_28235":187267,"_5797":187450},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_6892":118264,"_42174":118206,"_29767":187452,"_5":21387,"_28235":187267,"_5797":187453},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_6892":118265,"_42174":118206,"_29767":187455,"_5":21387,"_28235":187267,"_5797":187456},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_6892":118266,"_42174":118206,"_29767":187458,"_5":21387,"_28235":187267,"_5797":187459},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_6892":118267,"_42174":118206,"_29767":187461,"_5":21387,"_28235":187267,"_5797":187462},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_6892":118268,"_42174":118206,"_29767":187464,"_5":21387,"_28235":187267,"_5797":187465},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_6892":118269,"_42174":118206,"_29767":187467,"_5":21387,"_28235":187267,"_5797":187468},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_6892":118270,"_42174":118206,"_29767":187470,"_5":21387,"_28235":187271,"_5797":187471},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_6892":118271,"_42174":118206,"_29767":187473,"_5":21387,"_28235":187271,"_5797":187474},[],"La decisión se toma con el contexto de la operación de dominio:",{"_6892":118272,"_42174":118206,"_29767":187476,"_5":21387,"_28235":187271,"_5797":187477},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_6892":118273,"_42174":118206,"_29767":187479,"_5":21387,"_28235":187271,"_5797":187480},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_6892":118274,"_42174":118206,"_29767":187482,"_5":21387,"_28235":187271,"_5797":187483},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_6892":118275,"_42174":118206,"_29767":187485,"_5":21387,"_28235":187271,"_5797":187486},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_6892":118276,"_42174":118206,"_29767":187488,"_5":21387,"_28235":187271,"_5797":187489},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_6892":118277,"_42174":118206,"_29767":187491,"_5":21387,"_28235":187271,"_5797":187492},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_6892":118278,"_42174":118206,"_29767":187494,"_5":21387,"_28235":187271,"_5797":187495},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_6892":118279,"_42174":118206,"_29767":187497,"_5":21387,"_28235":187271,"_5797":187498},[],"Las acciones se dividen en dos grupos:",{"_6892":118280,"_42174":118206,"_29767":187500,"_5":21387,"_28235":187271,"_5797":187501},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_6892":118281,"_42174":118206,"_29767":187503,"_5":21387,"_28235":187271,"_5797":187504},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_6892":118282,"_42174":118206,"_29767":187506,"_5":21387,"_28235":187271,"_5797":187507},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_6892":118283,"_42174":118206,"_29767":187509,"_5":21387,"_28235":187275,"_5797":187510},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_6892":118284,"_42174":118206,"_29767":187512,"_5":21387,"_28235":187275,"_5797":187513},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_6892":118285,"_42174":118206,"_29767":187515,"_5":21387,"_28235":187275,"_5797":187516},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_6892":118286,"_42174":118206,"_29767":187518,"_5":21387,"_28235":187279,"_5797":187519},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_6892":118287,"_42174":118206,"_29767":187521,"_5":21387,"_28235":187279,"_5797":187522},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_6892":118288,"_42174":118206,"_29767":187524,"_5":21387,"_28235":187279,"_5797":187525},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_6892":118289,"_42174":118206,"_29767":187527,"_5":21387,"_28235":187279,"_5797":187528},[],"Los operadores implementados son:",{"_6892":118290,"_42174":118206,"_29767":187530,"_5":21387,"_28235":187279,"_5797":187531},[],"`equals`, para igualdad exacta;",{"_6892":118291,"_42174":118206,"_29767":187533,"_5":21387,"_28235":187279,"_5797":187534},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_6892":118292,"_42174":118206,"_29767":187536,"_5":21387,"_28235":187279,"_5797":187537},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_6892":118293,"_42174":118206,"_29767":187539,"_5":21387,"_28235":187279,"_5797":187540},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_6892":118294,"_42174":118206,"_29767":187542,"_5":21387,"_28235":187283,"_5797":187543},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_6892":118295,"_42174":118206,"_29767":187545,"_5":21387,"_28235":187283,"_5797":187546},[],"Los modos disponibles son:",{"_6892":118296,"_42174":118206,"_29767":187548,"_5":21387,"_28235":187283,"_5797":187549},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_6892":118297,"_42174":118206,"_29767":187551,"_5":21387,"_28235":187283,"_5797":187552},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_6892":118298,"_42174":118206,"_29767":187554,"_5":21387,"_28235":187283,"_5797":187555},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_6892":118299,"_42174":118206,"_29767":187557,"_5":21387,"_28235":187283,"_5797":187558},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_6892":118300,"_42174":118206,"_29767":187560,"_5":21387,"_28235":187283,"_5797":187561},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_6892":118301,"_42174":118206,"_29767":187563,"_5":21387,"_28235":187283,"_5797":187564},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_6892":118302,"_42174":118206,"_29767":187566,"_5":21387,"_28235":187287,"_5797":187567},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_6892":118303,"_42174":118206,"_29767":187569,"_5":21387,"_28235":187287,"_5797":187570},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_6892":118304,"_42174":118206,"_29767":187572,"_5":21387,"_28235":187287,"_5797":187573},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_6892":118305,"_42174":118206,"_29767":187575,"_5":21387,"_28235":187287,"_5797":187576},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_6892":118306,"_42174":118206,"_29767":187578,"_5":21387,"_28235":187295,"_5797":187579},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_6892":118307,"_42174":118206,"_29767":187581,"_5":21387,"_28235":187295,"_5797":187582},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_6892":118308,"_42174":118206,"_29767":187584,"_5":21387,"_28235":187299,"_5797":187585},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_6892":118309,"_42174":118206,"_29767":187587,"_5":21387,"_28235":187299,"_5797":187588},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_6892":118310,"_42174":118206,"_29767":187590,"_5":21387,"_28235":187303,"_5797":187591},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_6892":118311,"_42174":118206,"_29767":187593,"_5":21387,"_28235":187303,"_5797":187594},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_6892":118312,"_42174":118206,"_29767":187596,"_5":21387,"_28235":187303,"_5797":187597},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_6892":118313,"_42174":118206,"_29767":187599,"_5":21387,"_28235":187307,"_5797":187600},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_6892":118314,"_42174":118206,"_29767":187602,"_5":21387,"_28235":187307,"_5797":187603},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_6892":118315,"_42174":118206,"_29767":187605,"_5":21387,"_28235":187307,"_5797":187606},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_6892":118316,"_42174":118206,"_29767":187608,"_5":21387,"_28235":187307,"_5797":187609},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_6892":118317,"_42174":118206,"_29767":187611,"_5":21387,"_28235":187307,"_5797":187612},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_6892":118318,"_42174":118206,"_29767":187614,"_5":21387,"_28235":187307,"_5797":187615},[],"Ten en cuenta que:",{"_6892":118319,"_42174":118206,"_29767":187617,"_5":21387,"_28235":187307,"_5797":187618},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_6892":118320,"_42174":118206,"_29767":187620,"_5":21387,"_28235":187307,"_5797":187621},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_6892":118321,"_42174":118206,"_29767":187623,"_5":21387,"_28235":187307,"_5797":187624},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_6892":118322,"_42174":118206,"_29767":187626,"_5":21387,"_28235":187311,"_5797":187627},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_6892":118323,"_42174":118206,"_29767":187629,"_5":21387,"_28235":187311,"_5797":187630},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_6892":118324,"_42174":118206,"_29767":187632,"_5":21387,"_28235":187311,"_5797":187633},[],"acceso completo y de solo lectura a KMS;",{"_6892":118325,"_42174":118206,"_29767":187635,"_5":21387,"_28235":187311,"_5797":187636},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_6892":118326,"_42174":118206,"_29767":187638,"_5":21387,"_28235":187311,"_5797":187639},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_6892":118327,"_42174":118206,"_29767":187641,"_5":21387,"_28235":187311,"_5797":187642},[],"acceso a la interfaz;",{"_6892":118328,"_42174":118206,"_29767":187644,"_5":21387,"_28235":187311,"_5797":187645},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_6892":118329,"_42174":118206,"_29767":187647,"_5":21387,"_28235":187311,"_5797":187648},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_6892":118330,"_42174":118206,"_29767":187650,"_5":21387,"_28235":187311,"_5797":187651},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_6892":118331,"_42174":118206,"_29767":187653,"_5":21387,"_28235":187315,"_5797":187654},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_6892":118332,"_42174":118206,"_29767":187656,"_5":21387,"_28235":187315,"_5797":187657},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_6892":118333,"_42174":118206,"_29767":187659,"_5":21387,"_28235":187315,"_5797":187660},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_6892":118334,"_42174":118206,"_29767":187662,"_5":21387,"_28235":187318,"_5797":187663},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_6892":118335,"_42174":118206,"_29767":187665,"_5":21387,"_28235":187322,"_5797":187666},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_6892":118336,"_42174":118206,"_29767":187668,"_5":21387,"_28235":187322,"_5797":187669},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_6892":118337,"_42174":118206,"_29767":187671,"_5":21387,"_28235":187326,"_5797":187672},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_6892":118338,"_42174":118206,"_29767":187674,"_5":21387,"_28235":187330,"_5797":187675},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_6892":118339,"_42174":118206,"_29767":187677,"_5":21387,"_28235":187334,"_5797":187678},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_6892":118340,"_42174":118206,"_29767":187680,"_5":21387,"_28235":187338,"_5797":187681},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_6892":118341,"_42174":118206,"_29767":187683,"_5":21387,"_28235":187338,"_5797":187684},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_6892":118342,"_42174":118206,"_29767":187686,"_5":21387,"_28235":187342,"_5797":187687},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_6892":118343,"_42174":118206,"_29767":187689,"_5":21387,"_28235":187342,"_5797":187690},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_6892":118344,"_42174":118206,"_29767":187692,"_5":21387,"_28235":187342,"_5797":187693},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_6892":118345,"_42174":118206,"_29767":187695,"_5":21387,"_28235":187342,"_5797":187696},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_6892":118346,"_42174":118206,"_29767":187698,"_5":21387,"_28235":187342,"_5797":187699},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_6892":118347,"_42174":118206,"_29767":187701,"_5":21387,"_28235":187342,"_5797":187702},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_6892":118348,"_42174":118206,"_29767":187704,"_5":21387,"_28235":187342,"_5797":187705},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_6892":118349,"_42174":118206,"_29767":187707,"_5":21387,"_28235":187342,"_5797":187708},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_6892":118350,"_42174":118206,"_29767":187710,"_5":21387,"_28235":187346,"_5797":187711},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_6892":118351,"_42174":118206,"_29767":187713,"_5":21387,"_28235":187346,"_5797":187714},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_6892":118352,"_42174":118206,"_29767":187716,"_5":21387,"_28235":187346,"_5797":187717},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_6892":118353,"_42174":118206,"_29767":187719,"_5":21387,"_28235":187350,"_5797":187720},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_6892":118354,"_42174":118206,"_29767":187722,"_5":21387,"_28235":187350,"_5797":187723},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_6892":118355,"_42174":118206,"_29767":187725,"_5":21387,"_28235":187350,"_5797":187726},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_6892":118356,"_42174":118206,"_29767":187728,"_5":21387,"_28235":187350,"_5797":187729},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_6892":118357,"_42174":118206,"_29767":187731,"_5":21387,"_28235":187350,"_5797":187732},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_6892":118358,"_42174":118206,"_29767":187734,"_5":21387,"_28235":187350,"_5797":187735},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_6892":118359,"_42174":118206,"_29767":187737,"_5":21387,"_28235":187350,"_5797":187738},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_6892":118360,"_42174":118206,"_29767":187740,"_5":21387,"_28235":187350,"_5797":187741},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_6892":118361,"_42174":118206,"_29767":187743,"_5":21387,"_28235":187358,"_5797":187744},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_6892":118362,"_42174":118206,"_29767":187746,"_5":21387,"_28235":187362,"_5797":187747},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_6892":118363,"_42174":118206,"_29767":187749,"_5":21387,"_28235":187362,"_5797":187750},[],"que exista un principal activo del tipo correcto;",{"_6892":118364,"_42174":118206,"_29767":187752,"_5":21387,"_28235":187362,"_5797":187753},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_6892":118365,"_42174":118206,"_29767":187755,"_5":21387,"_28235":187362,"_5797":187756},[],"que todas las condiciones del principal se cumplan;",{"_6892":118366,"_42174":118206,"_29767":187758,"_5":21387,"_28235":187362,"_5797":187759},[],"que el principal tenga concedida la política esperada;",{"_6892":118367,"_42174":118206,"_29767":187761,"_5":21387,"_28235":187362,"_5797":187762},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_6892":118368,"_42174":118206,"_29767":187764,"_5":21387,"_28235":187362,"_5797":187765},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_6892":118369,"_42174":118206,"_29767":187767,"_5":21387,"_28235":187362,"_5797":187768},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_6892":118370,"_42174":118206,"_29767":187770,"_5":21387,"_28235":187366,"_5797":187771},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_6892":118371,"_42174":118206,"_29767":187773,"_5":21387,"_28235":187370,"_5797":187774},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_6892":118372,"_42174":118206,"_29767":187776,"_5":21387,"_28235":187374,"_5797":187777},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_6892":118373,"_42174":118206,"_29767":187779,"_5":21387,"_28235":187374,"_5797":187780},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_6892":118374,"_42174":118374,"_5":21817,"_5797":187782,"_42654":187783,"_29767":187784,"_28235":118374},"Alertas y suscripciones",[77248,187247,187248],[],{"_6892":118375,"_42174":118374,"_29767":187786,"_5":21387,"_28235":118374,"_5797":187787},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_6892":118376,"_42174":118374,"_5":42651,"_29767":187789,"_28235":187790,"_5797":187791},[],"/docs/pr-preview/pr-56/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_6892":118377,"_42174":118374,"_5":42651,"_29767":187793,"_28235":187794,"_5797":187795},[],"/docs/pr-preview/pr-56/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_6892":118378,"_42174":118374,"_5":42651,"_29767":187797,"_28235":187798,"_5797":187799},[],"/docs/pr-preview/pr-56/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_6892":118379,"_42174":118374,"_5":42651,"_29767":187801,"_28235":187802,"_5797":187803},[],"/docs/pr-preview/pr-56/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_6892":118380,"_42174":118374,"_5":42651,"_29767":187805,"_28235":187806,"_5797":187807},[],"/docs/pr-preview/pr-56/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_6892":118381,"_42174":118374,"_5":42651,"_29767":187809,"_28235":187810,"_5797":187811},[],"/docs/pr-preview/pr-56/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_6892":118382,"_42174":118374,"_5":42651,"_29767":187813,"_28235":187814,"_5797":187815},[],"/docs/pr-preview/pr-56/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_6892":118383,"_42174":118374,"_5":42651,"_29767":187817,"_28235":187818,"_5797":187819},[],"/docs/pr-preview/pr-56/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_6892":118384,"_42174":118374,"_5":42651,"_29767":187821,"_28235":187822,"_5797":187823},[],"/docs/pr-preview/pr-56/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_6892":118385,"_42174":118374,"_5":42651,"_29767":187825,"_28235":187826,"_5797":187827},[],"/docs/pr-preview/pr-56/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_6892":118386,"_42174":118374,"_5":42651,"_29767":187829,"_28235":187830,"_5797":187831},[],"/docs/pr-preview/pr-56/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_6892":118387,"_42174":118374,"_29767":187833,"_5":21387,"_28235":118374,"_5797":187834},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_6892":118388,"_42174":118374,"_29767":187836,"_5":21387,"_28235":187790,"_5797":187837},[],"Un servicio publica un evento de dominio.",{"_6892":118389,"_42174":118374,"_29767":187839,"_5":21387,"_28235":187790,"_5797":187840},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_6892":118390,"_42174":118374,"_29767":187842,"_5":21387,"_28235":187790,"_5797":187843},[],"El filtro de cada suscripción decide si debe notificarse.",{"_6892":118391,"_42174":118374,"_29767":187845,"_5":21387,"_28235":187790,"_5797":187846},[],"Lamassu entrega el evento al canal configurado.",{"_6892":118392,"_42174":118374,"_29767":187848,"_5":21387,"_28235":187790,"_5797":187849},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_6892":118393,"_42174":118374,"_29767":187851,"_5":21387,"_28235":187794,"_5797":187852},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_6892":118394,"_42174":118374,"_29767":187854,"_5":21387,"_28235":187794,"_5797":187855},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_6892":118395,"_42174":118374,"_29767":187857,"_5":21387,"_28235":187794,"_5797":187858},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_6892":118396,"_42174":118374,"_29767":187860,"_5":21387,"_28235":187794,"_5797":187861},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_6892":118397,"_42174":118374,"_29767":187863,"_5":21387,"_28235":187794,"_5797":187864},[],"`apikey_options` necesita `header` y `key`.",{"_6892":118398,"_42174":118374,"_29767":187866,"_5":21387,"_28235":187794,"_5797":187867},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_6892":118399,"_42174":118374,"_29767":187869,"_5":21387,"_28235":187794,"_5797":187870},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_6892":118400,"_42174":118374,"_29767":187872,"_5":21387,"_28235":187794,"_5797":187873},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_6892":118401,"_42174":118374,"_29767":187875,"_5":21387,"_28235":187802,"_5797":187876},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_6892":118402,"_42174":118374,"_29767":187878,"_5":21387,"_28235":187806,"_5797":187879},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_6892":118403,"_42174":118374,"_29767":187881,"_5":21387,"_28235":187810,"_5797":187882},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_6892":118404,"_42174":118374,"_29767":187884,"_5":21387,"_28235":187810,"_5797":187885},[],"**None** notifica todas las instancias del evento.",{"_6892":118405,"_42174":118374,"_29767":187887,"_5":21387,"_28235":187810,"_5797":187888},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_6892":118406,"_42174":118374,"_29767":187890,"_5":21387,"_28235":187810,"_5797":187891},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_6892":118407,"_42174":118374,"_29767":187893,"_5":21387,"_28235":187810,"_5797":187894},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_6892":118408,"_42174":118374,"_29767":187896,"_5":21387,"_28235":187810,"_5797":187897},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_6892":118409,"_42174":118374,"_29767":187899,"_5":21387,"_28235":187814,"_5797":187900},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_6892":118410,"_42174":118374,"_29767":187902,"_5":21387,"_28235":187818,"_5797":187903},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_6892":118411,"_42174":118374,"_29767":187905,"_5":21387,"_28235":187818,"_5797":187906},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_6892":118412,"_42174":118374,"_29767":187908,"_5":21387,"_28235":187818,"_5797":187909},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_6892":118413,"_42174":118374,"_29767":187911,"_5":21387,"_28235":187818,"_5797":187912},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_6892":118414,"_42174":118374,"_29767":187914,"_5":21387,"_28235":187818,"_5797":187915},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_6892":118415,"_42174":118374,"_29767":187917,"_5":21387,"_28235":187818,"_5797":187918},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_6892":118416,"_42174":118374,"_29767":187920,"_5":21387,"_28235":187818,"_5797":187921},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_6892":118417,"_42174":118374,"_29767":187923,"_5":21387,"_28235":187818,"_5797":187924},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_6892":118418,"_42174":118374,"_29767":187926,"_5":21387,"_28235":187822,"_5797":187927},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_6892":118419,"_42174":118374,"_29767":187929,"_5":21387,"_28235":187822,"_5797":187930},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_6892":118420,"_42174":118374,"_29767":187932,"_5":21387,"_28235":187822,"_5797":187933},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_6892":118421,"_42174":118374,"_29767":187935,"_5":21387,"_28235":187822,"_5797":187936},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_6892":118422,"_42174":118374,"_29767":187938,"_5":21387,"_28235":187822,"_5797":187939},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_6892":118423,"_42174":118374,"_29767":187941,"_5":21387,"_28235":187822,"_5797":187942},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_6892":118424,"_42174":118374,"_29767":187944,"_5":21387,"_28235":187822,"_5797":187945},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_6892":118425,"_42174":118374,"_29767":187947,"_5":21387,"_28235":187822,"_5797":187948},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_6892":118426,"_42174":118374,"_29767":187950,"_5":21387,"_28235":187826,"_5797":187951},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_6892":118427,"_42174":118374,"_29767":187953,"_5":21387,"_28235":187826,"_5797":187954},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_6892":118428,"_42174":118374,"_29767":187956,"_5":21387,"_28235":187830,"_5797":187957},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_6892":118429,"_42174":118374,"_29767":187959,"_5":21387,"_28235":187830,"_5797":187960},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_6892":118430,"_42174":118374,"_29767":187962,"_5":21387,"_28235":187830,"_5797":187963},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_6892":118431,"_42174":118374,"_29767":187965,"_5":21387,"_28235":187830,"_5797":187966},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_6892":118432,"_42174":118374,"_29767":187968,"_5":21387,"_28235":187830,"_5797":187969},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_6892":118433,"_42174":118374,"_29767":187971,"_5":21387,"_28235":187830,"_5797":187972},[],"**Validación:** `va.role.crl.create`.",{"_6892":118434,"_42174":118374,"_29767":187974,"_5":21387,"_28235":187830,"_5797":187975},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_6892":118435,"_42174":118374,"_29767":187977,"_5":21387,"_28235":187830,"_5797":187978},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_6892":118436,"_42174":118436,"_5":21817,"_5797":187980,"_42654":187981,"_29767":187982,"_28235":118436},"Registros de auditoría",[77248,187247,187248],[],{"_6892":118437,"_42174":118436,"_29767":187984,"_5":21387,"_28235":118436,"_5797":187985},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_6892":118438,"_42174":118436,"_5":42651,"_29767":187987,"_28235":187988,"_5797":187989},[],"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_6892":118439,"_42174":118436,"_5":42651,"_29767":187991,"_28235":187992,"_5797":187993},[],"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#cobertura","Cobertura",{"_6892":118440,"_42174":118436,"_5":42651,"_29767":187995,"_28235":187996,"_5797":187997},[],"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_6892":118441,"_42174":118436,"_5":42651,"_29767":187999,"_28235":188000,"_5797":188001},[],"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_6892":118442,"_42174":118436,"_5":42651,"_29767":188003,"_28235":188004,"_5797":188005},[],"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_6892":118443,"_42174":118436,"_5":42651,"_29767":188007,"_28235":188008,"_5797":188009},[],"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_6892":118444,"_42174":118436,"_5":42651,"_29767":188011,"_28235":188012,"_5797":188013},[],"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_6892":118445,"_42174":118436,"_5":42651,"_29767":188015,"_28235":188016,"_5797":188017},[],"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_6892":118446,"_42174":118436,"_5":42651,"_29767":188019,"_28235":188020,"_5797":188021},[],"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_6892":118447,"_42174":118436,"_5":42651,"_29767":188023,"_28235":188024,"_5797":188025},[],"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_6892":118448,"_42174":118436,"_5":42651,"_29767":188027,"_28235":188028,"_5797":188029},[],"/docs/pr-preview/pr-56/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_6892":118449,"_42174":118436,"_29767":188031,"_5":21387,"_28235":118436,"_5797":188032},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_6892":118450,"_42174":118436,"_29767":188034,"_5":21387,"_28235":187988,"_5797":188035},[],"El cuerpo de auditoría incluye:",{"_6892":118451,"_42174":118436,"_29767":188037,"_5":21387,"_28235":187988,"_5797":188038},[],"input: datos recibidos por la operación;",{"_6892":118452,"_42174":118436,"_29767":188040,"_5":21387,"_28235":187988,"_5797":188041},[],"has\\_error: indica si el servicio devolvió un error;",{"_6892":118453,"_42174":118436,"_29767":188043,"_5":21387,"_28235":187988,"_5797":188044},[],"output: resultado producido o mensaje de error;",{"_6892":118454,"_42174":118436,"_29767":188046,"_5":21387,"_28235":187988,"_5797":188047},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_6892":118455,"_42174":118436,"_29767":188049,"_5":21387,"_28235":187988,"_5797":188050},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_6892":118456,"_42174":118436,"_29767":188052,"_5":21387,"_28235":187988,"_5797":188053},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_6892":118457,"_42174":118436,"_29767":188055,"_5":21387,"_28235":187992,"_5797":188056},[],"El backend aplica auditoría a mutaciones de:",{"_6892":118458,"_42174":118436,"_29767":188058,"_5":21387,"_28235":187992,"_5797":188059},[],"autoridades, certificados y perfiles de emisión;",{"_6892":118459,"_42174":118436,"_29767":188061,"_5":21387,"_28235":187992,"_5797":188062},[],"claves y motores KMS;",{"_6892":118460,"_42174":118436,"_29767":188064,"_5":21387,"_28235":187992,"_5797":188065},[],"dispositivos e identidades;",{"_6892":118461,"_42174":118436,"_29767":188067,"_5":21387,"_28235":187992,"_5797":188068},[],"DMS y operaciones de enrolamiento;",{"_6892":118462,"_42174":118436,"_29767":188070,"_5":21387,"_28235":187992,"_5797":188071},[],"funciones de validación y CRL;",{"_6892":118463,"_42174":118436,"_29767":188073,"_5":21387,"_28235":187992,"_5797":188074},[],"principales, políticas y concesiones de autorización.",{"_6892":118464,"_42174":118436,"_29767":188076,"_5":21387,"_28235":187992,"_5797":188077},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_6892":118465,"_42174":118436,"_29767":188079,"_5":21387,"_28235":187996,"_5797":188080},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_6892":118466,"_42174":118436,"_29767":188082,"_5":21387,"_28235":187996,"_5797":188083},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_6892":118467,"_42174":118436,"_29767":188085,"_5":21387,"_28235":187996,"_5797":188086},[],"Diseña el consumidor para:",{"_6892":118468,"_42174":118436,"_29767":188088,"_5":21387,"_28235":187996,"_5797":188089},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_6892":118469,"_42174":118436,"_29767":188091,"_5":21387,"_28235":187996,"_5797":188092},[],"conservar el CloudEvent completo sin modificar;",{"_6892":118470,"_42174":118436,"_29767":188094,"_5":21387,"_28235":187996,"_5797":188095},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_6892":118471,"_42174":118436,"_29767":188097,"_5":21387,"_28235":187996,"_5797":188098},[],"cifrar en tránsito y en reposo;",{"_6892":118472,"_42174":118436,"_29767":188100,"_5":21387,"_28235":187996,"_5797":188101},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_6892":118473,"_42174":118436,"_29767":188103,"_5":21387,"_28235":187996,"_5797":188104},[],"aplicar una política explícita de retención y legal hold;",{"_6892":118474,"_42174":118436,"_29767":188106,"_5":21387,"_28235":187996,"_5797":188107},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_6892":118475,"_42174":118436,"_29767":188109,"_5":21387,"_28235":188000,"_5797":188110},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_6892":118476,"_42174":118436,"_29767":188112,"_5":21387,"_28235":188000,"_5797":188113},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_6892":118477,"_42174":118436,"_29767":188115,"_5":21387,"_28235":188008,"_5797":188116},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_6892":118478,"_42174":118436,"_29767":188118,"_5":21387,"_28235":188012,"_5797":188119},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_6892":118479,"_42174":118436,"_29767":188121,"_5":21387,"_28235":188016,"_5797":188122},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_6892":118480,"_42174":118436,"_29767":188124,"_5":21387,"_28235":188020,"_5797":188125},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_6892":118481,"_42174":118436,"_29767":188127,"_5":21387,"_28235":188024,"_5797":188128},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_6892":118482,"_42174":118436,"_29767":188130,"_5":21387,"_28235":188028,"_5797":188131},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_6892":118483,"_42174":118436,"_29767":188133,"_5":21387,"_28235":188028,"_5797":188134},[],"aparece un evento de auditoría correcto;",{"_6892":118484,"_42174":118436,"_29767":188136,"_5":21387,"_28235":188028,"_5797":188137},[],"el principal coincide con la identidad utilizada;",{"_6892":118485,"_42174":118436,"_29767":188139,"_5":21387,"_28235":188028,"_5797":188140},[],"el consumidor lo persiste una sola vez;",{"_6892":118486,"_42174":118436,"_29767":188142,"_5":21387,"_28235":188028,"_5797":188143},[],"puede recuperarse por recurso, actor y periodo;",{"_6892":118487,"_42174":118436,"_29767":188145,"_5":21387,"_28235":188028,"_5797":188146},[],"una interrupción del consumidor produce una alerta.",{"_6892":118488,"_42174":118436,"_29767":188148,"_5":21387,"_28235":188028,"_5797":188149},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_6892":118489,"_42174":118489,"_5":21817,"_5797":188151,"_42654":188152,"_29767":188153,"_28235":118489},"Arquitectura de la plataforma",[77248,187247],[],{"_6892":118490,"_42174":118489,"_29767":188155,"_5":21387,"_28235":118489,"_5797":188156},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_6892":118491,"_42174":118489,"_5":42651,"_29767":188158,"_28235":188159,"_5797":188160},[],"/docs/pr-preview/pr-56/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_6892":118492,"_42174":118489,"_5":42651,"_29767":188162,"_28235":188163,"_5797":188164},[],"/docs/pr-preview/pr-56/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_6892":118493,"_42174":118489,"_5":42651,"_29767":188166,"_28235":188167,"_5797":188168},[],"/docs/pr-preview/pr-56/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_6892":118494,"_42174":118489,"_5":42651,"_29767":188170,"_28235":188171,"_5797":188172},[],"/docs/pr-preview/pr-56/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_6892":118495,"_42174":118489,"_5":42651,"_29767":188174,"_28235":188175,"_5797":188176},[],"/docs/pr-preview/pr-56/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_6892":118496,"_42174":118489,"_29767":188178,"_5":21387,"_28235":118489,"_5797":188179},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_6892":118497,"_42174":118489,"_29767":188181,"_5":21387,"_28235":118489,"_5797":188182},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_6892":118498,"_42174":118489,"_29767":188184,"_5":21387,"_28235":188159,"_5797":188185},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_6892":118499,"_42174":118489,"_29767":188187,"_5":21387,"_28235":188163,"_5797":188188},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_6892":118500,"_42174":118489,"_29767":188190,"_5":21387,"_28235":188167,"_5797":188191},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_6892":118501,"_42174":118489,"_29767":188193,"_5":21387,"_28235":188171,"_5797":188194},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_6892":118502,"_42174":118489,"_29767":188196,"_5":21387,"_28235":188175,"_5797":188197},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_6892":118503,"_42174":118503,"_5":21817,"_5797":188199,"_42654":188200,"_29767":188201,"_28235":118503},"Cómo funciona Lamassu",[77248,187247],[],{"_6892":118504,"_42174":118503,"_29767":188203,"_5":21387,"_28235":118503,"_5797":188204},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_6892":118505,"_42174":118503,"_5":42651,"_29767":188206,"_28235":188207,"_5797":188208},[],"/docs/pr-preview/pr-56/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_6892":118506,"_42174":118503,"_5":42651,"_29767":188210,"_28235":188211,"_5797":188212},[],"/docs/pr-preview/pr-56/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_6892":118507,"_42174":118503,"_29767":188214,"_5":21387,"_28235":118503,"_5797":188215},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_6892":118508,"_42174":118503,"_29767":188217,"_5":21387,"_28235":188207,"_5797":188218},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_6892":118509,"_42174":118503,"_29767":188220,"_5":21387,"_28235":188207,"_5797":188221},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_6892":118510,"_42174":118503,"_29767":188223,"_5":21387,"_28235":188207,"_5797":188224},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_6892":118511,"_42174":118503,"_29767":188226,"_5":21387,"_28235":188207,"_5797":188227},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_6892":118512,"_42174":118503,"_29767":188229,"_5":21387,"_28235":188207,"_5797":188230},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_6892":118513,"_42174":118503,"_29767":188232,"_5":21387,"_28235":188211,"_5797":188233},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_6892":118514,"_42174":118503,"_29767":188235,"_5":21387,"_28235":188211,"_5797":188236},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_6892":118515,"_42174":118503,"_29767":188238,"_5":21387,"_28235":188211,"_5797":188239},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_6892":118516,"_42174":118503,"_29767":188241,"_5":21387,"_28235":188211,"_5797":188242},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_6892":118517,"_42174":118503,"_29767":188244,"_5":21387,"_28235":188211,"_5797":188245},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_6892":118518,"_42174":118503,"_29767":188247,"_5":21387,"_28235":188211,"_5797":188248},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_6892":118519,"_42174":118503,"_29767":188250,"_5":21387,"_28235":188211,"_5797":188251},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_6892":118520,"_42174":118520,"_5":21817,"_5797":188253,"_42654":188254,"_29767":188255,"_28235":118520},"Dispositivos e identidades",[77248,187247,79705,188253],[],{"_6892":118521,"_42174":118520,"_29767":188257,"_5":21387,"_28235":118520,"_5797":188258},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_6892":118522,"_42174":118520,"_5":42651,"_29767":188260,"_28235":188261,"_5797":188262},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_6892":118523,"_42174":118520,"_5":42651,"_29767":188264,"_28235":188265,"_5797":188266},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_6892":118524,"_42174":118520,"_5":42651,"_29767":188268,"_28235":188269,"_5797":188270},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_6892":118525,"_42174":118520,"_5":42651,"_29767":188272,"_28235":188273,"_5797":188274},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_6892":118526,"_42174":118520,"_5":42651,"_29767":188276,"_28235":188277,"_5797":188278},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_6892":118527,"_42174":118520,"_5":42651,"_29767":188280,"_28235":188281,"_5797":188282},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_6892":118528,"_42174":118520,"_5":42651,"_29767":188284,"_28235":188285,"_5797":188286},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_6892":118529,"_42174":118520,"_5":42651,"_29767":188288,"_28235":188289,"_5797":188290},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_6892":118530,"_42174":118520,"_5":42651,"_29767":188292,"_28235":188293,"_5797":188294},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_6892":118531,"_42174":118520,"_5":42651,"_29767":188296,"_28235":188297,"_5797":188298},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_6892":118532,"_42174":118520,"_5":42651,"_29767":188300,"_28235":188301,"_5797":188302},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_6892":118533,"_42174":118520,"_29767":188304,"_5":21387,"_28235":118520,"_5797":188305},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_6892":118534,"_42174":118520,"_29767":188307,"_5":21387,"_28235":118520,"_5797":188308},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_6892":118535,"_42174":118520,"_29767":188310,"_5":21387,"_28235":188261,"_5797":188311},[],"Vista operativa",{"_6892":118536,"_42174":118520,"_29767":188313,"_5":21387,"_28235":188261,"_5797":188314},[],"Interpretación",{"_6892":118537,"_42174":118520,"_29767":188316,"_5":21387,"_28235":188261,"_5797":79768},[],{"_6892":118538,"_42174":118520,"_29767":188318,"_5":21387,"_28235":188261,"_5797":188319},[],"Hay registro, pero todavía no hay identidad asociada.",{"_6892":118539,"_42174":118520,"_29767":188321,"_5":21387,"_28235":188261,"_5797":79774},[],{"_6892":118540,"_42174":118520,"_29767":188323,"_5":21387,"_28235":188261,"_5797":188324},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_6892":118541,"_42174":118520,"_29767":188326,"_5":21387,"_28235":188261,"_5797":79780},[],{"_6892":118542,"_42174":118520,"_29767":188328,"_5":21387,"_28235":188261,"_5797":188329},[],"La identidad está en la ventana operativa de renovación.",{"_6892":118543,"_42174":118520,"_29767":188331,"_5":21387,"_28235":188261,"_5797":79786},[],{"_6892":118544,"_42174":118520,"_29767":188333,"_5":21387,"_28235":188261,"_5797":188334},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_6892":118545,"_42174":118520,"_29767":188336,"_5":21387,"_28235":188261,"_5797":79792},[],{"_6892":118546,"_42174":118520,"_29767":188338,"_5":21387,"_28235":188261,"_5797":188339},[],"La identidad ha vencido.",{"_6892":118547,"_42174":118520,"_29767":188341,"_5":21387,"_28235":188261,"_5797":79798},[],{"_6892":118548,"_42174":118520,"_29767":188343,"_5":21387,"_28235":188261,"_5797":188344},[],"La identidad está marcada como revocada.",{"_6892":118549,"_42174":118520,"_29767":188346,"_5":21387,"_28235":188261,"_5797":79804},[],{"_6892":118550,"_42174":118520,"_29767":188348,"_5":21387,"_28235":188261,"_5797":188349},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_6892":118551,"_42174":118520,"_29767":188351,"_5":21387,"_28235":188261,"_5797":188352},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_6892":118552,"_42174":118520,"_29767":188354,"_5":21387,"_28235":188265,"_5797":188355},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_6892":118553,"_42174":118520,"_29767":188357,"_5":21387,"_28235":188265,"_5797":188358},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_6892":118554,"_42174":118520,"_29767":188360,"_5":21387,"_28235":188265,"_5797":188361},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_6892":118555,"_42174":118520,"_29767":188363,"_5":21387,"_28235":188265,"_5797":188364},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_6892":118556,"_42174":118520,"_29767":188366,"_5":21387,"_28235":188269,"_5797":188367},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_6892":118557,"_42174":118520,"_29767":188369,"_5":21387,"_28235":188273,"_5797":188370},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_6892":118558,"_42174":118520,"_29767":188372,"_5":21387,"_28235":188277,"_5797":188373},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_6892":118559,"_42174":118520,"_29767":188375,"_5":21387,"_28235":188281,"_5797":188376},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_6892":118560,"_42174":118520,"_29767":188378,"_5":21387,"_28235":188285,"_5797":188379},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_6892":118561,"_42174":118520,"_29767":188381,"_5":21387,"_28235":188285,"_5797":188382},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_6892":118562,"_42174":118520,"_29767":188384,"_5":21387,"_28235":188289,"_5797":188385},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_6892":118563,"_42174":118520,"_29767":188387,"_5":21387,"_28235":188289,"_5797":188388},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_6892":118564,"_42174":118520,"_29767":188390,"_5":21387,"_28235":188289,"_5797":188391},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_6892":118565,"_42174":118520,"_29767":188393,"_5":21387,"_28235":188289,"_5797":188394},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_6892":118566,"_42174":118520,"_29767":188396,"_5":21387,"_28235":188289,"_5797":188397},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_6892":118567,"_42174":118520,"_29767":188399,"_5":21387,"_28235":188289,"_5797":188400},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_6892":118568,"_42174":118520,"_29767":188402,"_5":21387,"_28235":188293,"_5797":188403},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_6892":118569,"_42174":118520,"_29767":188405,"_5":21387,"_28235":188293,"_5797":188406},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_6892":118570,"_42174":118520,"_29767":188408,"_5":21387,"_28235":188297,"_5797":188409},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_6892":118571,"_42174":118520,"_29767":188411,"_5":21387,"_28235":188297,"_5797":188412},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_6892":118572,"_42174":118520,"_29767":188414,"_5":21387,"_28235":188297,"_5797":188415},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_6892":118573,"_42174":118520,"_29767":188417,"_5":21387,"_28235":188297,"_5797":188418},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_6892":118574,"_42174":118520,"_29767":188420,"_5":21387,"_28235":188301,"_5797":188421},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_6892":118575,"_42174":118520,"_29767":188423,"_5":21387,"_28235":188301,"_5797":188424},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_6892":118576,"_42174":118576,"_5":21817,"_5797":188426,"_42654":188427,"_29767":188429,"_28235":118576},"Identidad inicial y autenticación",[77248,187247,79705,188253,188428],"Enrolamiento con PKI",[],{"_6892":118577,"_42174":118576,"_29767":188431,"_5":21387,"_28235":118576,"_5797":188432},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_6892":118578,"_42174":118576,"_5":42651,"_29767":188434,"_28235":188435,"_5797":188436},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_6892":118579,"_42174":118576,"_5":42651,"_29767":188438,"_28235":188439,"_5797":188440},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_6892":118580,"_42174":118576,"_5":42651,"_29767":188442,"_28235":188443,"_5797":188444},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_6892":118581,"_42174":118576,"_5":42651,"_29767":188446,"_28235":188447,"_5797":188448},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_6892":118582,"_42174":118576,"_5":42651,"_29767":188450,"_28235":188451,"_5797":188452},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_6892":118583,"_42174":118576,"_29767":188454,"_5":21387,"_28235":118576,"_5797":188455},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_6892":118584,"_42174":118576,"_29767":188457,"_5":21387,"_28235":188435,"_5797":188458},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_6892":118585,"_42174":118576,"_29767":188460,"_5":21387,"_28235":188435,"_5797":188461},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_6892":118586,"_42174":118576,"_29767":188463,"_5":21387,"_28235":188439,"_5797":188464},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_6892":118587,"_42174":118576,"_29767":188466,"_5":21387,"_28235":188439,"_5797":188467},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_6892":118588,"_42174":118576,"_29767":188469,"_5":21387,"_28235":188439,"_5797":188470},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_6892":118589,"_42174":118576,"_29767":188472,"_5":21387,"_28235":188443,"_5797":188473},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_6892":118590,"_42174":118576,"_29767":188475,"_5":21387,"_28235":188443,"_5797":188476},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_6892":118591,"_42174":118576,"_29767":188478,"_5":21387,"_28235":188447,"_5797":188479},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_6892":118592,"_42174":118576,"_29767":188481,"_5":21387,"_28235":188447,"_5797":188482},[],"Ejemplo de cuerpo:",{"_6892":118593,"_42174":118576,"_29767":188484,"_5":21387,"_28235":188447,"_5797":188485},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_6892":118594,"_42174":118576,"_29767":188487,"_5":21387,"_28235":188447,"_5797":188488},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_6892":118595,"_42174":118576,"_29767":188490,"_5":21387,"_28235":188447,"_5797":188491},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_6892":118596,"_42174":118576,"_29767":188493,"_5":21387,"_28235":188447,"_5797":188494},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_6892":118597,"_42174":118576,"_29767":188496,"_5":21387,"_28235":188451,"_5797":188497},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_6892":118598,"_42174":118576,"_29767":188499,"_5":21387,"_28235":188451,"_5797":188500},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_6892":118599,"_42174":118599,"_5":21817,"_5797":188502,"_42654":188503,"_29767":188504,"_28235":118599},"Configura y opera el DMS",[77248,187247,79705,188253,188428],[],{"_6892":118600,"_42174":118599,"_29767":188506,"_5":21387,"_28235":118599,"_5797":188507},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_6892":118601,"_42174":118599,"_5":42651,"_29767":188509,"_28235":188510,"_5797":185844},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_6892":118602,"_42174":118599,"_5":42651,"_29767":188512,"_28235":188513,"_5797":188514},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_6892":118603,"_42174":118599,"_5":42651,"_29767":188516,"_28235":188517,"_5797":188518},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_6892":118604,"_42174":118599,"_5":42651,"_29767":188520,"_28235":188521,"_5797":188522},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_6892":118605,"_42174":118599,"_5":42651,"_29767":188524,"_28235":188525,"_5797":188526},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_6892":118606,"_42174":118599,"_5":42651,"_29767":188528,"_28235":188529,"_5797":188530},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_6892":118607,"_42174":118599,"_5":42651,"_29767":188532,"_28235":188533,"_5797":188534},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_6892":118608,"_42174":118599,"_5":42651,"_29767":188536,"_28235":188537,"_5797":188538},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_6892":118609,"_42174":118599,"_5":42651,"_29767":188540,"_28235":188541,"_5797":80000},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_6892":118610,"_42174":118599,"_5":42651,"_29767":188543,"_28235":188544,"_5797":80004},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_6892":118611,"_42174":118599,"_5":42651,"_29767":188546,"_28235":188547,"_5797":188548},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_6892":118612,"_42174":118599,"_5":42651,"_29767":188550,"_28235":188551,"_5797":188552},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_6892":118613,"_42174":118599,"_5":42651,"_29767":188554,"_28235":188555,"_5797":188556},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_6892":118614,"_42174":118599,"_5":42651,"_29767":188558,"_28235":188559,"_5797":188560},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_6892":118615,"_42174":118599,"_5":42651,"_29767":188562,"_28235":188563,"_5797":80024},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_6892":118616,"_42174":118599,"_5":42651,"_29767":188565,"_28235":188566,"_5797":188567},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_6892":118617,"_42174":118599,"_5":42651,"_29767":188569,"_28235":188570,"_5797":188571},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_6892":118618,"_42174":118599,"_5":42651,"_29767":188573,"_28235":188574,"_5797":188575},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_6892":118619,"_42174":118599,"_29767":188577,"_5":21387,"_28235":118599,"_5797":188578},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_6892":118620,"_42174":118599,"_29767":188580,"_5":21387,"_28235":188510,"_5797":188581},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_6892":118621,"_42174":118599,"_29767":188583,"_5":21387,"_28235":188510,"_5797":188584},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_6892":118622,"_42174":118599,"_29767":188586,"_5":21387,"_28235":188517,"_5797":188587},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_6892":118623,"_42174":118599,"_29767":188589,"_5":21387,"_28235":188521,"_5797":188590},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_6892":118624,"_42174":118599,"_29767":188592,"_5":21387,"_28235":188525,"_5797":188593},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_6892":118625,"_42174":118599,"_29767":188595,"_5":21387,"_28235":188529,"_5797":188596},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_6892":118626,"_42174":118599,"_29767":188598,"_5":21387,"_28235":188533,"_5797":188599},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_6892":118627,"_42174":118599,"_29767":188601,"_5":21387,"_28235":188541,"_5797":188602},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_6892":118628,"_42174":118599,"_29767":188604,"_5":21387,"_28235":188541,"_5797":188605},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_6892":118629,"_42174":118599,"_29767":188607,"_5":21387,"_28235":188544,"_5797":188608},[],"Campo de `settings.enrollment_settings`",{"_6892":118630,"_42174":118599,"_29767":188610,"_5":21387,"_28235":188544,"_5797":188611},[],"Decisión",{"_6892":118631,"_42174":118599,"_29767":188613,"_5":21387,"_28235":188544,"_5797":80075},[],{"_6892":118632,"_42174":118599,"_29767":188615,"_5":21387,"_28235":188544,"_5797":188616},[],"`EST_RFC7030` para estas operaciones.",{"_6892":118633,"_42174":118599,"_29767":188618,"_5":21387,"_28235":188544,"_5797":80081},[],{"_6892":118634,"_42174":118599,"_29767":188620,"_5":21387,"_28235":188544,"_5797":188621},[],"ID de la CA que firmará.",{"_6892":118635,"_42174":118599,"_29767":188623,"_5":21387,"_28235":188544,"_5797":80087},[],{"_6892":118636,"_42174":118599,"_29767":188625,"_5":21387,"_28235":188544,"_5797":188626},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_6892":118637,"_42174":118599,"_29767":188628,"_5":21387,"_28235":188544,"_5797":80093},[],{"_6892":118638,"_42174":118599,"_29767":188630,"_5":21387,"_28235":188544,"_5797":188631},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_6892":118639,"_42174":118599,"_29767":188633,"_5":21387,"_28235":188544,"_5797":80099},[],{"_6892":118640,"_42174":118599,"_29767":188635,"_5":21387,"_28235":188544,"_5797":188636},[],"Uno de los cuatro modos de autenticación.",{"_6892":118641,"_42174":118599,"_29767":188638,"_5":21387,"_28235":188544,"_5797":188639},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_6892":118642,"_42174":118599,"_29767":188641,"_5":21387,"_28235":188547,"_5797":188642},[],"Los bloques son independientes:",{"_6892":118643,"_42174":118599,"_29767":188644,"_5":21387,"_28235":188547,"_5797":188645},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_6892":118644,"_42174":118599,"_29767":188647,"_5":21387,"_28235":188547,"_5797":188648},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_6892":118645,"_42174":118599,"_29767":188650,"_5":21387,"_28235":188547,"_5797":80117},[],{"_6892":118646,"_42174":118599,"_29767":188652,"_5":21387,"_28235":188547,"_5797":188653},[],"Control aplicado en la operación configurada",{"_6892":118647,"_42174":118599,"_29767":188655,"_5":21387,"_28235":188547,"_5797":80123},[],{"_6892":118648,"_42174":118599,"_29767":188657,"_5":21387,"_28235":188547,"_5797":188658},[],"Validación del certificado presentado.",{"_6892":118649,"_42174":118599,"_29767":188660,"_5":21387,"_28235":188547,"_5797":80129},[],{"_6892":118650,"_42174":118599,"_29767":188662,"_5":21387,"_28235":188547,"_5797":188663},[],"Autorización del webhook configurado.",{"_6892":118651,"_42174":118599,"_29767":188665,"_5":21387,"_28235":188547,"_5797":80135},[],{"_6892":118652,"_42174":118599,"_29767":188667,"_5":21387,"_28235":188547,"_5797":188668},[],"Validación del certificado y, después, aprobación del webhook.",{"_6892":118653,"_42174":118599,"_29767":188670,"_5":21387,"_28235":188547,"_5797":80141},[],{"_6892":118654,"_42174":118599,"_29767":188672,"_5":21387,"_28235":188547,"_5797":188673},[],"Sin autenticación del solicitante por el DMS.",{"_6892":118655,"_42174":118599,"_29767":188675,"_5":21387,"_28235":188547,"_5797":188676},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_6892":118656,"_42174":118599,"_29767":188678,"_5":21387,"_28235":188547,"_5797":188679},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_6892":118657,"_42174":118599,"_29767":188681,"_5":21387,"_28235":188547,"_5797":188682},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_6892":118658,"_42174":118599,"_29767":188684,"_5":21387,"_28235":188547,"_5797":188685},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_6892":118659,"_42174":118599,"_29767":188687,"_5":21387,"_28235":188551,"_5797":188688},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_6892":118660,"_42174":118599,"_29767":188690,"_5":21387,"_28235":188551,"_5797":188691},[],"Campo de `external_webhook_settings`",{"_6892":118661,"_42174":118599,"_29767":188693,"_5":21387,"_28235":188551,"_5797":188611},[],{"_6892":118662,"_42174":118599,"_29767":188695,"_5":21387,"_28235":188551,"_5797":80167},[],{"_6892":118663,"_42174":118599,"_29767":188697,"_5":21387,"_28235":188551,"_5797":188698},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_6892":118664,"_42174":118599,"_29767":188700,"_5":21387,"_28235":188551,"_5797":80173},[],{"_6892":118665,"_42174":118599,"_29767":188702,"_5":21387,"_28235":188551,"_5797":188703},[],"`POST` o `PUT`; `POST` por defecto.",{"_6892":118666,"_42174":118599,"_29767":188705,"_5":21387,"_28235":188551,"_5797":80179},[],{"_6892":118667,"_42174":118599,"_29767":188707,"_5":21387,"_28235":188551,"_5797":188708},[],"Etiqueta usada en los logs del servicio.",{"_6892":118668,"_42174":118599,"_29767":188710,"_5":21387,"_28235":188551,"_5797":80185},[],{"_6892":118669,"_42174":118599,"_29767":188712,"_5":21387,"_28235":188551,"_5797":188713},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_6892":118670,"_42174":118599,"_29767":188715,"_5":21387,"_28235":188551,"_5797":80191},[],{"_6892":118671,"_42174":118599,"_29767":188717,"_5":21387,"_28235":188551,"_5797":188718},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_6892":118672,"_42174":118599,"_29767":188720,"_5":21387,"_28235":188551,"_5797":80197},[],{"_6892":118673,"_42174":118599,"_29767":188722,"_5":21387,"_28235":188551,"_5797":188723},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_6892":118674,"_42174":118599,"_29767":188725,"_5":21387,"_28235":188551,"_5797":80203},[],{"_6892":118675,"_42174":118599,"_29767":188727,"_5":21387,"_28235":188551,"_5797":188728},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_6892":118676,"_42174":118599,"_29767":188730,"_5":21387,"_28235":188551,"_5797":80209},[],{"_6892":118677,"_42174":118599,"_29767":188732,"_5":21387,"_28235":188551,"_5797":188733},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_6892":118678,"_42174":118599,"_29767":188735,"_5":21387,"_28235":188551,"_5797":80215},[],{"_6892":118679,"_42174":118599,"_29767":188737,"_5":21387,"_28235":188551,"_5797":188738},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_6892":118680,"_42174":118599,"_29767":188740,"_5":21387,"_28235":188551,"_5797":80221},[],{"_6892":118681,"_42174":118599,"_29767":188742,"_5":21387,"_28235":188551,"_5797":188743},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_6892":118682,"_42174":118599,"_29767":188745,"_5":21387,"_28235":188551,"_5797":188746},[],"Reglas de esa configuración:",{"_6892":118683,"_42174":118599,"_29767":188748,"_5":21387,"_28235":188551,"_5797":188749},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_6892":118684,"_42174":118599,"_29767":188751,"_5":21387,"_28235":188551,"_5797":188752},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_6892":118685,"_42174":118599,"_29767":188754,"_5":21387,"_28235":188551,"_5797":188755},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_6892":118686,"_42174":118599,"_29767":188757,"_5":21387,"_28235":188551,"_5797":188758},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_6892":118687,"_42174":118599,"_29767":188760,"_5":21387,"_28235":188551,"_5797":188761},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_6892":118688,"_42174":118599,"_29767":188763,"_5":21387,"_28235":188551,"_5797":188764},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_6892":118689,"_42174":118599,"_29767":188766,"_5":21387,"_28235":188551,"_5797":188767},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_6892":118690,"_42174":118599,"_29767":188769,"_5":21387,"_28235":188551,"_5797":188770},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_6892":118691,"_42174":118599,"_29767":188772,"_5":21387,"_28235":188551,"_5797":188773},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_6892":118692,"_42174":118599,"_29767":188775,"_5":21387,"_28235":188555,"_5797":188776},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_6892":118693,"_42174":118599,"_29767":188778,"_5":21387,"_28235":188559,"_5797":188779},[],"Campo de `settings.reenrollment_settings`",{"_6892":118694,"_42174":118599,"_29767":188781,"_5":21387,"_28235":188559,"_5797":188782},[],"Función",{"_6892":118695,"_42174":118599,"_29767":188784,"_5":21387,"_28235":188559,"_5797":80265},[],{"_6892":118696,"_42174":118599,"_29767":188786,"_5":21387,"_28235":188559,"_5797":188787},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_6892":118697,"_42174":118599,"_29767":188789,"_5":21387,"_28235":188559,"_5797":80271},[],{"_6892":118698,"_42174":118599,"_29767":188791,"_5":21387,"_28235":188559,"_5797":188792},[],"Umbral operativo preventivo de monitorización.",{"_6892":118699,"_42174":118599,"_29767":188794,"_5":21387,"_28235":188559,"_5797":80277},[],{"_6892":118700,"_42174":118599,"_29767":188796,"_5":21387,"_28235":188559,"_5797":188797},[],"Umbral operativo crítico de monitorización.",{"_6892":118701,"_42174":118599,"_29767":188799,"_5":21387,"_28235":188559,"_5797":80283},[],{"_6892":118702,"_42174":118599,"_29767":188801,"_5":21387,"_28235":188559,"_5797":188802},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_6892":118703,"_42174":118599,"_29767":188804,"_5":21387,"_28235":188559,"_5797":80289},[],{"_6892":118704,"_42174":118599,"_29767":188806,"_5":21387,"_28235":188559,"_5797":188807},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_6892":118705,"_42174":118599,"_29767":188809,"_5":21387,"_28235":188559,"_5797":80295},[],{"_6892":118706,"_42174":118599,"_29767":188811,"_5":21387,"_28235":188559,"_5797":188812},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_6892":118707,"_42174":118599,"_29767":188814,"_5":21387,"_28235":188559,"_5797":188815},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_6892":118708,"_42174":118599,"_29767":188817,"_5":21387,"_28235":188563,"_5797":188818},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_6892":118709,"_42174":118599,"_29767":188820,"_5":21387,"_28235":188566,"_5797":186208},[],{"_6892":118710,"_42174":118599,"_29767":188822,"_5":21387,"_28235":188566,"_5797":188823},[],"Qué publica",{"_6892":118711,"_42174":118599,"_29767":188825,"_5":21387,"_28235":188566,"_5797":80312},[],{"_6892":118712,"_42174":118599,"_29767":188827,"_5":21387,"_28235":188566,"_5797":188828},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_6892":118713,"_42174":118599,"_29767":188830,"_5":21387,"_28235":188566,"_5797":80318},[],{"_6892":118714,"_42174":118599,"_29767":188832,"_5":21387,"_28235":188566,"_5797":188833},[],"Certificado de la CA emisora seleccionada.",{"_6892":118715,"_42174":118599,"_29767":188835,"_5":21387,"_28235":188566,"_5797":80324},[],{"_6892":118716,"_42174":118599,"_29767":188837,"_5":21387,"_28235":188566,"_5797":188838},[],"Certificados de las CAs elegidas explícitamente.",{"_6892":118717,"_42174":118599,"_29767":188840,"_5":21387,"_28235":188566,"_5797":188841},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_6892":118718,"_42174":118599,"_29767":188843,"_5":21387,"_28235":188570,"_5797":188844},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_6892":118719,"_42174":118599,"_29767":188846,"_5":21387,"_28235":188570,"_5797":188847},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_6892":118720,"_42174":118599,"_29767":188849,"_5":21387,"_28235":188570,"_5797":188850},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_6892":118721,"_42174":118599,"_29767":188852,"_5":21387,"_28235":188574,"_5797":188853},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_6892":118722,"_42174":118722,"_5":21817,"_5797":188855,"_42654":188856,"_29767":188857,"_28235":118722},"Integra el cliente EST",[77248,187247,79705,188253,188428],[],{"_6892":118723,"_42174":118722,"_29767":188859,"_5":21387,"_28235":118722,"_5797":188860},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_6892":118724,"_42174":118722,"_5":42651,"_29767":188862,"_28235":188863,"_5797":185844},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_6892":118725,"_42174":118722,"_5":42651,"_29767":188865,"_28235":188866,"_5797":188867},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_6892":118726,"_42174":118722,"_5":42651,"_29767":188869,"_28235":188870,"_5797":188871},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_6892":118727,"_42174":118722,"_5":42651,"_29767":188873,"_28235":188874,"_5797":188875},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_6892":118728,"_42174":118722,"_5":42651,"_29767":188877,"_28235":188878,"_5797":188879},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_6892":118729,"_42174":118722,"_5":42651,"_29767":188881,"_28235":188882,"_5797":188883},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_6892":118730,"_42174":118722,"_29767":188885,"_5":21387,"_28235":118722,"_5797":188886},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_6892":118731,"_42174":118722,"_29767":188888,"_5":21387,"_28235":188863,"_5797":188889},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_6892":118732,"_42174":118722,"_29767":188891,"_5":21387,"_28235":188863,"_5797":188892},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_6892":118733,"_42174":118722,"_29767":188894,"_5":21387,"_28235":188863,"_5797":188895},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_6892":118734,"_42174":118722,"_29767":188897,"_5":21387,"_28235":188866,"_5797":188898},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_6892":118735,"_42174":118722,"_29767":188900,"_5":21387,"_28235":188866,"_5797":188901},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_6892":118736,"_42174":118722,"_29767":188903,"_5":21387,"_28235":188870,"_5797":188904},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_6892":118737,"_42174":118722,"_29767":188906,"_5":21387,"_28235":188870,"_5797":188907},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_6892":118738,"_42174":118722,"_29767":188909,"_5":21387,"_28235":188874,"_5797":188910},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_6892":118739,"_42174":118722,"_29767":188912,"_5":21387,"_28235":188874,"_5797":188913},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_6892":118740,"_42174":118722,"_29767":188915,"_5":21387,"_28235":188878,"_5797":188916},[],"Para el caso de una raíz que emite directamente:",{"_6892":118741,"_42174":118722,"_29767":188918,"_5":21387,"_28235":188878,"_5797":188919},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_6892":118742,"_42174":118722,"_29767":188921,"_5":21387,"_28235":188878,"_5797":188922},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_6892":118743,"_42174":118722,"_29767":188924,"_5":21387,"_28235":188882,"_5797":188925},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_6892":118744,"_42174":118744,"_5":21817,"_5797":188927,"_42654":188928,"_29767":188929,"_28235":118744},"Referencia EST",[77248,187247,79705,188253,188428],[],{"_6892":118745,"_42174":118744,"_29767":188931,"_5":21387,"_28235":118744,"_5797":188932},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_6892":118746,"_42174":118744,"_5":42651,"_29767":188934,"_28235":188935,"_5797":188936},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_6892":118747,"_42174":118744,"_5":42651,"_29767":188938,"_28235":188939,"_5797":31944},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_6892":118748,"_42174":118744,"_5":42651,"_29767":188941,"_28235":188942,"_5797":36148},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_6892":118749,"_42174":118744,"_5":42651,"_29767":188944,"_28235":188945,"_5797":36155},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_6892":118750,"_42174":118744,"_5":42651,"_29767":188947,"_28235":188948,"_5797":35249},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_6892":118751,"_42174":118744,"_5":42651,"_29767":188950,"_28235":188951,"_5797":188952},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_6892":118752,"_42174":118744,"_5":42651,"_29767":188954,"_28235":188955,"_5797":188956},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_6892":118753,"_42174":118744,"_5":42651,"_29767":188958,"_28235":188959,"_5797":188960},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_6892":118754,"_42174":118744,"_29767":188962,"_5":21387,"_28235":118744,"_5797":188963},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_6892":118755,"_42174":118744,"_29767":188965,"_5":21387,"_28235":188935,"_5797":188966},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_6892":118756,"_42174":118744,"_29767":188968,"_5":21387,"_28235":188935,"_5797":187007},[],{"_6892":118757,"_42174":118744,"_29767":188970,"_5":21387,"_28235":188935,"_5797":188971},[],"Método",{"_6892":118758,"_42174":118744,"_29767":188973,"_5":21387,"_28235":188935,"_5797":188974},[],"Autenticación y condición",{"_6892":118759,"_42174":118744,"_29767":188976,"_5":21387,"_28235":188935,"_5797":80467},[],{"_6892":118760,"_42174":118744,"_29767":188978,"_5":21387,"_28235":188935,"_5797":80470},[],{"_6892":118761,"_42174":118744,"_29767":188980,"_5":21387,"_28235":188935,"_5797":188981},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_6892":118762,"_42174":118744,"_29767":188983,"_5":21387,"_28235":188935,"_5797":80476},[],{"_6892":118763,"_42174":118744,"_29767":188985,"_5":21387,"_28235":188935,"_5797":80479},[],{"_6892":118764,"_42174":118744,"_29767":188987,"_5":21387,"_28235":188935,"_5797":188988},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_6892":118765,"_42174":118744,"_29767":188990,"_5":21387,"_28235":188935,"_5797":80485},[],{"_6892":118766,"_42174":118744,"_29767":188992,"_5":21387,"_28235":188935,"_5797":80479},[],{"_6892":118767,"_42174":118744,"_29767":188994,"_5":21387,"_28235":188935,"_5797":188995},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_6892":118768,"_42174":118744,"_29767":188997,"_5":21387,"_28235":188935,"_5797":80493},[],{"_6892":118769,"_42174":118744,"_29767":188999,"_5":21387,"_28235":188935,"_5797":80479},[],{"_6892":118770,"_42174":118744,"_29767":189001,"_5":21387,"_28235":188935,"_5797":189002},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_6892":118771,"_42174":118744,"_29767":189004,"_5":21387,"_28235":188935,"_5797":189005},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_6892":118772,"_42174":118744,"_29767":189007,"_5":21387,"_28235":188939,"_5797":189008},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_6892":118773,"_42174":118744,"_29767":189010,"_5":21387,"_28235":188939,"_5797":189011},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_6892":118774,"_42174":118744,"_29767":189013,"_5":21387,"_28235":188942,"_5797":189014},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_6892":118775,"_42174":118744,"_29767":189016,"_5":21387,"_28235":188942,"_5797":189017},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_6892":118776,"_42174":118744,"_29767":189019,"_5":21387,"_28235":188945,"_5797":189020},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_6892":118777,"_42174":118744,"_29767":189022,"_5":21387,"_28235":188945,"_5797":189023},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_6892":118778,"_42174":118744,"_29767":189025,"_5":21387,"_28235":188948,"_5797":189026},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_6892":118779,"_42174":118744,"_29767":189028,"_5":21387,"_28235":188948,"_5797":189029},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_6892":118780,"_42174":118744,"_29767":189031,"_5":21387,"_28235":188951,"_5797":189032},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_6892":118781,"_42174":118744,"_29767":189034,"_5":21387,"_28235":188951,"_5797":189035},[],"Parte",{"_6892":118782,"_42174":118744,"_29767":189037,"_5":21387,"_28235":188951,"_5797":189038},[],"Contenido tras decodificar su Base64",{"_6892":118783,"_42174":118744,"_29767":189040,"_5":21387,"_28235":188951,"_5797":80537},[],{"_6892":118784,"_42174":118744,"_29767":189042,"_5":21387,"_28235":188951,"_5797":189043},[],"Clave privada PKCS#8 DER sin cifrar.",{"_6892":118785,"_42174":118744,"_29767":189045,"_5":21387,"_28235":188951,"_5797":80543},[],{"_6892":118786,"_42174":118744,"_29767":189047,"_5":21387,"_28235":188951,"_5797":189048},[],"PKCS#7 DER con el certificado emitido.",{"_6892":118787,"_42174":118744,"_29767":189050,"_5":21387,"_28235":188951,"_5797":189051},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_6892":118788,"_42174":118744,"_29767":189053,"_5":21387,"_28235":188955,"_5797":189054},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_6892":118789,"_42174":118744,"_29767":189056,"_5":21387,"_28235":188955,"_5797":189057},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_6892":118790,"_42174":118744,"_29767":189059,"_5":21387,"_28235":188955,"_5797":189060},[],"Convierte y comprueba el resultado:",{"_6892":118791,"_42174":118744,"_29767":189062,"_5":21387,"_28235":188955,"_5797":189063},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_6892":118792,"_42174":118744,"_29767":189065,"_5":21387,"_28235":188959,"_5797":189066},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_6892":118793,"_42174":118744,"_29767":189068,"_5":21387,"_28235":188959,"_5797":189069},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_6892":118794,"_42174":118794,"_5":21817,"_5797":188428,"_42654":189071,"_29767":189072,"_28235":118794},[77248,187247,79705,188253,188428],[],{"_6892":118795,"_42174":118794,"_29767":189074,"_5":21387,"_28235":118794,"_5797":189075},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_6892":118796,"_42174":118794,"_5":42651,"_29767":189077,"_28235":189078,"_5797":189079},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_6892":118797,"_42174":118794,"_5":42651,"_29767":189081,"_28235":189082,"_5797":189083},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_6892":118798,"_42174":118794,"_5":42651,"_29767":189085,"_28235":189086,"_5797":189087},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_6892":118799,"_42174":118794,"_5":42651,"_29767":189089,"_28235":189090,"_5797":189091},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_6892":118800,"_42174":118794,"_29767":189093,"_5":21387,"_28235":118794,"_5797":189094},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_6892":118801,"_42174":118794,"_29767":189096,"_5":21387,"_28235":189078,"_5797":189097},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_6892":118802,"_42174":118794,"_29767":189099,"_5":21387,"_28235":189078,"_5797":189100},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_6892":118803,"_42174":118794,"_29767":189102,"_5":21387,"_28235":189078,"_5797":189103},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_6892":118804,"_42174":118794,"_29767":189105,"_5":21387,"_28235":189078,"_5797":189106},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_6892":118805,"_42174":118794,"_29767":189108,"_5":21387,"_28235":189078,"_5797":189109},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_6892":118806,"_42174":118794,"_29767":189111,"_5":21387,"_28235":189078,"_5797":189112},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_6892":118807,"_42174":118794,"_29767":189114,"_5":21387,"_28235":189082,"_5797":189115},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_6892":118808,"_42174":118794,"_29767":189117,"_5":21387,"_28235":189082,"_5797":189118},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_6892":118809,"_42174":118794,"_29767":189120,"_5":21387,"_28235":189082,"_5797":189121},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_6892":118810,"_42174":118794,"_29767":189123,"_5":21387,"_28235":189082,"_5797":189124},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_6892":118811,"_42174":118794,"_29767":189126,"_5":21387,"_28235":189086,"_5797":189127},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_6892":118812,"_42174":118794,"_29767":189129,"_5":21387,"_28235":189086,"_5797":189130},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_6892":118813,"_42174":118794,"_29767":189132,"_5":21387,"_28235":189086,"_5797":189133},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_6892":118814,"_42174":118794,"_29767":189135,"_5":21387,"_28235":189086,"_5797":189136},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_6892":118815,"_42174":118794,"_29767":189138,"_5":21387,"_28235":189090,"_5797":189139},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_6892":118816,"_42174":118794,"_29767":189141,"_5":21387,"_28235":189090,"_5797":189142},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_6892":118817,"_42174":118817,"_5":21817,"_5797":189144,"_42654":189145,"_29767":189146,"_28235":118817},"Estrategias de aprovisionamiento",[77248,187247,79705,188253,188428],[],{"_6892":118818,"_42174":118817,"_29767":189148,"_5":21387,"_28235":118817,"_5797":189149},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_6892":118819,"_42174":118817,"_5":42651,"_29767":189151,"_28235":189152,"_5797":189153},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_6892":118820,"_42174":118817,"_5":42651,"_29767":189155,"_28235":189156,"_5797":189157},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_6892":118821,"_42174":118817,"_5":42651,"_29767":189159,"_28235":189160,"_5797":189161},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_6892":118822,"_42174":118817,"_5":42651,"_29767":189163,"_28235":189164,"_5797":189165},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_6892":118823,"_42174":118817,"_5":42651,"_29767":189167,"_28235":189168,"_5797":189169},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_6892":118824,"_42174":118817,"_29767":189171,"_5":21387,"_28235":118817,"_5797":189172},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_6892":118825,"_42174":118817,"_29767":189174,"_5":21387,"_28235":189152,"_5797":189175},[],"Recorrido",{"_6892":118826,"_42174":118817,"_29767":189177,"_5":21387,"_28235":189152,"_5797":189178},[],"Cuándo existe el dispositivo",{"_6892":118827,"_42174":118817,"_29767":189180,"_5":21387,"_28235":189152,"_5797":189181},[],"Qué compruebas",{"_6892":118828,"_42174":118817,"_29767":189183,"_5":21387,"_28235":189152,"_5797":189184},[],"Asignación manual",{"_6892":118829,"_42174":118817,"_29767":189186,"_5":21387,"_28235":189152,"_5797":189187},[],"El operador lo crea antes de asociar un certificado.",{"_6892":118830,"_42174":118817,"_29767":189189,"_5":21387,"_28235":189152,"_5797":189190},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_6892":118831,"_42174":118817,"_29767":189192,"_5":21387,"_28235":189152,"_5797":189193},[],"EST con `JITP`",{"_6892":118832,"_42174":118817,"_29767":189195,"_5":21387,"_28235":189152,"_5797":189196},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_6892":118833,"_42174":118817,"_29767":189198,"_5":21387,"_28235":189152,"_5797":189199},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_6892":118834,"_42174":118817,"_29767":189201,"_5":21387,"_28235":189152,"_5797":189202},[],"EST con `PRE_REGISTRATION`",{"_6892":118835,"_42174":118817,"_29767":189204,"_5":21387,"_28235":189152,"_5797":189205},[],"Debe existir antes de `/simpleenroll`.",{"_6892":118836,"_42174":118817,"_29767":189207,"_5":21387,"_28235":189152,"_5797":189208},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_6892":118837,"_42174":118817,"_29767":189210,"_5":21387,"_28235":189152,"_5797":189211},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_6892":118838,"_42174":118817,"_29767":189213,"_5":21387,"_28235":189152,"_5797":189214},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_6892":118839,"_42174":118817,"_29767":189216,"_5":21387,"_28235":189156,"_5797":189217},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_6892":118840,"_42174":118817,"_29767":189219,"_5":21387,"_28235":189156,"_5797":189220},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_6892":118841,"_42174":118817,"_29767":189222,"_5":21387,"_28235":189156,"_5797":189223},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_6892":118842,"_42174":118817,"_29767":189225,"_5":21387,"_28235":189160,"_5797":189226},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_6892":118843,"_42174":118817,"_29767":189228,"_5":21387,"_28235":189160,"_5797":189229},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_6892":118844,"_42174":118817,"_29767":189231,"_5":21387,"_28235":189160,"_5797":189232},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_6892":118845,"_42174":118817,"_29767":189234,"_5":21387,"_28235":189160,"_5797":189235},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_6892":118846,"_42174":118817,"_29767":189237,"_5":21387,"_28235":189160,"_5797":189238},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_6892":118847,"_42174":118817,"_29767":189240,"_5":21387,"_28235":189160,"_5797":189241},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_6892":118848,"_42174":118817,"_29767":189243,"_5":21387,"_28235":189164,"_5797":186208},[],{"_6892":118849,"_42174":118817,"_29767":189245,"_5":21387,"_28235":189164,"_5797":189246},[],"Material que atraviesa EST",{"_6892":118850,"_42174":118817,"_29767":189248,"_5":21387,"_28235":189164,"_5797":189249},[],"Clave generada por el dispositivo",{"_6892":118851,"_42174":118817,"_29767":189251,"_5":21387,"_28235":189164,"_5797":189252},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_6892":118852,"_42174":118817,"_29767":189254,"_5":21387,"_28235":189164,"_5797":189255},[],"Clave ya disponible en el dispositivo",{"_6892":118853,"_42174":118817,"_29767":189257,"_5":21387,"_28235":189164,"_5797":189258},[],"CSR firmada con la clave existente y certificado nuevo.",{"_6892":118854,"_42174":118817,"_29767":189260,"_5":21387,"_28235":189164,"_5797":80024},[],{"_6892":118855,"_42174":118817,"_29767":189262,"_5":21387,"_28235":189164,"_5797":189263},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_6892":118856,"_42174":118817,"_29767":189265,"_5":21387,"_28235":189164,"_5797":189266},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_6892":118857,"_42174":118817,"_29767":189268,"_5":21387,"_28235":189168,"_5797":189269},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_6892":118858,"_42174":118858,"_5":21817,"_5797":189271,"_42654":189272,"_29767":189273,"_28235":118858},"Renovación y recuperación",[77248,187247,79705,188253,188428],[],{"_6892":118859,"_42174":118858,"_29767":189275,"_5":21387,"_28235":118858,"_5797":189276},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_6892":118860,"_42174":118858,"_5":42651,"_29767":189278,"_28235":189279,"_5797":189280},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_6892":118861,"_42174":118858,"_5":42651,"_29767":189282,"_28235":189283,"_5797":189284},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_6892":118862,"_42174":118858,"_5":42651,"_29767":189286,"_28235":189287,"_5797":189288},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_6892":118863,"_42174":118858,"_5":42651,"_29767":189290,"_28235":189291,"_5797":189292},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_6892":118864,"_42174":118858,"_5":42651,"_29767":189294,"_28235":189295,"_5797":189296},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_6892":118865,"_42174":118858,"_29767":189298,"_5":21387,"_28235":118858,"_5797":189299},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_6892":118866,"_42174":118858,"_29767":189301,"_5":21387,"_28235":189279,"_5797":189302},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_6892":118867,"_42174":118858,"_29767":189304,"_5":21387,"_28235":189279,"_5797":189305},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_6892":118868,"_42174":118858,"_29767":189307,"_5":21387,"_28235":189279,"_5797":189308},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_6892":118869,"_42174":118858,"_29767":189310,"_5":21387,"_28235":189279,"_5797":189311},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_6892":118870,"_42174":118858,"_29767":189313,"_5":21387,"_28235":189283,"_5797":189314},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_6892":118871,"_42174":118858,"_29767":189316,"_5":21387,"_28235":189283,"_5797":189317},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_6892":118872,"_42174":118858,"_29767":189319,"_5":21387,"_28235":189287,"_5797":189320},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_6892":118873,"_42174":118858,"_29767":189322,"_5":21387,"_28235":189287,"_5797":189323},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_6892":118874,"_42174":118858,"_29767":189325,"_5":21387,"_28235":189287,"_5797":189326},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_6892":118875,"_42174":118858,"_29767":189328,"_5":21387,"_28235":189291,"_5797":189329},[],"Situación",{"_6892":118876,"_42174":118858,"_29767":189331,"_5":21387,"_28235":189291,"_5797":189332},[],"Procedimiento",{"_6892":118877,"_42174":118858,"_29767":189334,"_5":21387,"_28235":189291,"_5797":189335},[],"Certificado vigente, fuera de ventana",{"_6892":118878,"_42174":118858,"_29767":189337,"_5":21387,"_28235":189291,"_5797":189338},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_6892":118879,"_42174":118858,"_29767":189340,"_5":21387,"_28235":189291,"_5797":189341},[],"Certificado vencido, clave disponible",{"_6892":118880,"_42174":118858,"_29767":189343,"_5":21387,"_28235":189291,"_5797":189344},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_6892":118881,"_42174":118858,"_29767":189346,"_5":21387,"_28235":189291,"_5797":189347},[],"Renovación por webhook o `NO_AUTH`",{"_6892":118882,"_42174":118858,"_29767":189349,"_5":21387,"_28235":189291,"_5797":189350},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_6892":118883,"_42174":118858,"_29767":189352,"_5":21387,"_28235":189291,"_5797":189353},[],"Clave perdida o inaccesible",{"_6892":118884,"_42174":118858,"_29767":189355,"_5":21387,"_28235":189291,"_5797":189356},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_6892":118885,"_42174":118858,"_29767":189358,"_5":21387,"_28235":189291,"_5797":189359},[],"Identidad actual revocada",{"_6892":118886,"_42174":118858,"_29767":189361,"_5":21387,"_28235":189291,"_5797":189362},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_6892":118887,"_42174":118858,"_29767":189364,"_5":21387,"_28235":189291,"_5797":189365},[],"Dispositivo sin identidad",{"_6892":118888,"_42174":118858,"_29767":189367,"_5":21387,"_28235":189291,"_5797":189368},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_6892":118889,"_42174":118858,"_29767":189370,"_5":21387,"_28235":189291,"_5797":189371},[],"Dispositivo retirado",{"_6892":118890,"_42174":118858,"_29767":189373,"_5":21387,"_28235":189291,"_5797":189374},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_6892":118891,"_42174":118858,"_29767":189376,"_5":21387,"_28235":189291,"_5797":189377},[],"Timeout, HTTP 500 o fallo de instalación",{"_6892":118892,"_42174":118858,"_29767":189379,"_5":21387,"_28235":189291,"_5797":189380},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_6892":118893,"_42174":118858,"_29767":189382,"_5":21387,"_28235":189295,"_5797":189383},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_6892":118894,"_42174":118858,"_29767":189385,"_5":21387,"_28235":189295,"_5797":189386},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_6892":118895,"_42174":118895,"_5":21817,"_5797":189388,"_42654":189389,"_29767":189390,"_28235":118895},"Diagnóstico de enrolamiento",[77248,187247,79705,188253,188428],[],{"_6892":118896,"_42174":118895,"_29767":189392,"_5":21387,"_28235":118895,"_5797":189393},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_6892":118897,"_42174":118895,"_5":42651,"_29767":189395,"_28235":189396,"_5797":189397},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_6892":118898,"_42174":118895,"_5":42651,"_29767":189399,"_28235":189400,"_5797":189401},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_6892":118899,"_42174":118895,"_5":42651,"_29767":189403,"_28235":189404,"_5797":188960},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_6892":118900,"_42174":118895,"_5":42651,"_29767":189406,"_28235":189407,"_5797":189408},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_6892":118901,"_42174":118895,"_29767":189410,"_5":21387,"_28235":118895,"_5797":189411},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_6892":118902,"_42174":118895,"_29767":189413,"_5":21387,"_28235":189400,"_5797":189414},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_6892":118903,"_42174":118895,"_29767":189416,"_5":21387,"_28235":189400,"_5797":189417},[],"Síntoma o mensaje",{"_6892":118904,"_42174":118895,"_29767":189419,"_5":21387,"_28235":189400,"_5797":189420},[],"Qué revisar",{"_6892":118905,"_42174":118895,"_29767":189422,"_5":21387,"_28235":189400,"_5797":189423},[],"curl rechaza TLS, nombre o emisor",{"_6892":118906,"_42174":118895,"_29767":189425,"_5":21387,"_28235":189400,"_5797":189426},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_6892":118907,"_42174":118895,"_29767":189428,"_5":21387,"_28235":189400,"_5797":189429},[],"404 o APS ausente",{"_6892":118908,"_42174":118895,"_29767":189431,"_5":21387,"_28235":189400,"_5797":189432},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_6892":118909,"_42174":118895,"_29767":189434,"_5":21387,"_28235":189400,"_5797":189435},[],"400, error de CSR o formato",{"_6892":118910,"_42174":118895,"_29767":189437,"_5":21387,"_28235":189400,"_5797":189438},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_6892":118911,"_42174":118895,"_29767":189440,"_5":21387,"_28235":189400,"_5797":189441},[],"Credencial ausente o certificado no válido",{"_6892":118912,"_42174":118895,"_29767":189443,"_5":21387,"_28235":189400,"_5797":189444},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_6892":118913,"_42174":118895,"_29767":189446,"_5":21387,"_28235":189400,"_5797":189447},[],"Webhook deniega, expira o responde sin autorización",{"_6892":118914,"_42174":118895,"_29767":189449,"_5":21387,"_28235":189400,"_5797":189450},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_6892":118915,"_42174":118895,"_29767":189452,"_5":21387,"_28235":189400,"_5797":80950},[],{"_6892":118916,"_42174":118895,"_29767":189454,"_5":21387,"_28235":189400,"_5797":189455},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_6892":118917,"_42174":118895,"_29767":189457,"_5":21387,"_28235":189400,"_5797":80956},[],{"_6892":118918,"_42174":118895,"_29767":189459,"_5":21387,"_28235":189400,"_5797":189460},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_6892":118919,"_42174":118895,"_29767":189462,"_5":21387,"_28235":189400,"_5797":80962},[],{"_6892":118920,"_42174":118895,"_29767":189464,"_5":21387,"_28235":189400,"_5797":189465},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_6892":118921,"_42174":118895,"_29767":189467,"_5":21387,"_28235":189400,"_5797":80968},[],{"_6892":118922,"_42174":118895,"_29767":189469,"_5":21387,"_28235":189400,"_5797":189470},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_6892":118923,"_42174":118895,"_29767":189472,"_5":21387,"_28235":189400,"_5797":80974},[],{"_6892":118924,"_42174":118895,"_29767":189474,"_5":21387,"_28235":189400,"_5797":189475},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_6892":118925,"_42174":118895,"_29767":189477,"_5":21387,"_28235":189400,"_5797":189478},[],"400 `struct validation error` al crear o actualizar un DMS",{"_6892":118926,"_42174":118895,"_29767":189480,"_5":21387,"_28235":189400,"_5797":189481},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_6892":118927,"_42174":118895,"_29767":189483,"_5":21387,"_28235":189400,"_5797":189484},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_6892":118928,"_42174":118895,"_29767":189486,"_5":21387,"_28235":189400,"_5797":189487},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_6892":118929,"_42174":118895,"_29767":189489,"_5":21387,"_28235":189400,"_5797":80992},[],{"_6892":118930,"_42174":118895,"_29767":189491,"_5":21387,"_28235":189400,"_5797":189492},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_6892":118931,"_42174":118895,"_29767":189494,"_5":21387,"_28235":189400,"_5797":80998},[],{"_6892":118932,"_42174":118895,"_29767":189496,"_5":21387,"_28235":189400,"_5797":189497},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_6892":118933,"_42174":118895,"_29767":189499,"_5":21387,"_28235":189400,"_5797":189500},[],"DMS propietario distinto",{"_6892":118934,"_42174":118895,"_29767":189502,"_5":21387,"_28235":189400,"_5797":189503},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_6892":118935,"_42174":118895,"_29767":189505,"_5":21387,"_28235":189400,"_5797":81010},[],{"_6892":118936,"_42174":118895,"_29767":189507,"_5":21387,"_28235":189400,"_5797":189508},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_6892":118937,"_42174":118895,"_29767":189510,"_5":21387,"_28235":189400,"_5797":81016},[],{"_6892":118938,"_42174":118895,"_29767":189512,"_5":21387,"_28235":189400,"_5797":189513},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_6892":118939,"_42174":118895,"_29767":189515,"_5":21387,"_28235":189400,"_5797":189516},[],"Certificado actual revocado",{"_6892":118940,"_42174":118895,"_29767":189518,"_5":21387,"_28235":189400,"_5797":189519},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_6892":118941,"_42174":118895,"_29767":189521,"_5":21387,"_28235":189400,"_5797":189522},[],"Error de CA, perfil o firma",{"_6892":118942,"_42174":118895,"_29767":189524,"_5":21387,"_28235":189400,"_5797":189525},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_6892":118943,"_42174":118895,"_29767":189527,"_5":21387,"_28235":189400,"_5797":189528},[],"HTTP 200 sin conexión del dispositivo",{"_6892":118944,"_42174":118895,"_29767":189530,"_5":21387,"_28235":189400,"_5797":189531},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_6892":118945,"_42174":118895,"_29767":189533,"_5":21387,"_28235":189400,"_5797":189534},[],"Timeout o error después de emitir",{"_6892":118946,"_42174":118895,"_29767":189536,"_5":21387,"_28235":189400,"_5797":189537},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_6892":118947,"_42174":118895,"_29767":189539,"_5":21387,"_28235":189404,"_5797":189540},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_6892":118948,"_42174":118895,"_29767":189542,"_5":21387,"_28235":189404,"_5797":189543},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_6892":118949,"_42174":118895,"_29767":189545,"_5":21387,"_28235":189407,"_5797":189546},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_6892":118950,"_42174":118895,"_29767":189548,"_5":21387,"_28235":189407,"_5797":189549},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_6892":118951,"_42174":118895,"_29767":189551,"_5":21387,"_28235":189407,"_5797":189552},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_6892":118952,"_42174":118895,"_29767":189554,"_5":21387,"_28235":189407,"_5797":189555},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_6892":118953,"_42174":118895,"_29767":189557,"_5":21387,"_28235":189407,"_5797":189558},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_6892":118954,"_42174":118895,"_29767":189560,"_5":21387,"_28235":189407,"_5797":189561},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_6892":118955,"_42174":118895,"_29767":189563,"_5":21387,"_28235":189407,"_5797":189564},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_6892":118956,"_42174":118956,"_5":21817,"_5797":189566,"_42654":189567,"_29767":189568,"_28235":118956},"Distribución y actualización de confianza",[77248,187247,79705,188253,188428],[],{"_6892":118957,"_42174":118956,"_29767":189570,"_5":21387,"_28235":118956,"_5797":189571},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_6892":118958,"_42174":118956,"_5":42651,"_29767":189573,"_28235":189574,"_5797":189575},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_6892":118959,"_42174":118956,"_5":42651,"_29767":189577,"_28235":189578,"_5797":189579},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_6892":118960,"_42174":118956,"_5":42651,"_29767":189581,"_28235":189582,"_5797":189583},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_6892":118961,"_42174":118956,"_5":42651,"_29767":189585,"_28235":189586,"_5797":189587},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_6892":118962,"_42174":118956,"_5":42651,"_29767":189589,"_28235":189590,"_5797":189591},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_6892":118963,"_42174":118956,"_29767":189593,"_5":21387,"_28235":118956,"_5797":189594},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_6892":118964,"_42174":118956,"_29767":189596,"_5":21387,"_28235":189574,"_5797":189597},[],"Relación",{"_6892":118965,"_42174":118956,"_29767":189599,"_5":21387,"_28235":189574,"_5797":189600},[],"Material que prepara el responsable",{"_6892":118966,"_42174":118956,"_29767":189602,"_5":21387,"_28235":189574,"_5797":189603},[],"Dispositivo → servidor EST",{"_6892":118967,"_42174":118956,"_29767":189605,"_5":21387,"_28235":189574,"_5797":189606},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_6892":118968,"_42174":118956,"_29767":189608,"_5":21387,"_28235":189574,"_5797":189609},[],"DMS → solicitante",{"_6892":118969,"_42174":118956,"_29767":189611,"_5":21387,"_28235":189574,"_5797":189612},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_6892":118970,"_42174":118956,"_29767":189614,"_5":21387,"_28235":189574,"_5797":189615},[],"Consumidor → dispositivo",{"_6892":118971,"_42174":118956,"_29767":189617,"_5":21387,"_28235":189574,"_5797":189618},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_6892":118972,"_42174":118956,"_29767":189620,"_5":21387,"_28235":189574,"_5797":189621},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_6892":118973,"_42174":118956,"_29767":189623,"_5":21387,"_28235":189578,"_5797":189624},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_6892":118974,"_42174":118956,"_29767":189626,"_5":21387,"_28235":189578,"_5797":189627},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_6892":118975,"_42174":118956,"_29767":189629,"_5":21387,"_28235":189582,"_5797":189630},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_6892":118976,"_42174":118956,"_29767":189632,"_5":21387,"_28235":189582,"_5797":189633},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_6892":118977,"_42174":118956,"_29767":189635,"_5":21387,"_28235":189582,"_5797":189636},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_6892":118978,"_42174":118956,"_29767":189638,"_5":21387,"_28235":189582,"_5797":189639},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_6892":118979,"_42174":118956,"_29767":189641,"_5":21387,"_28235":189582,"_5797":189642},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_6892":118980,"_42174":118956,"_29767":189644,"_5":21387,"_28235":189582,"_5797":189645},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_6892":118981,"_42174":118956,"_29767":189647,"_5":21387,"_28235":189586,"_5797":189648},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_6892":118982,"_42174":118956,"_29767":189650,"_5":21387,"_28235":189586,"_5797":189651},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_6892":118983,"_42174":118956,"_29767":189653,"_5":21387,"_28235":189586,"_5797":189654},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_6892":118984,"_42174":118956,"_29767":189656,"_5":21387,"_28235":189590,"_5797":189657},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_6892":118985,"_42174":118985,"_5":21817,"_5797":81165,"_42654":189659,"_29767":189661,"_28235":118985},[77248,187247,79705,188253,189660],"Integraciones",[],{"_6892":118986,"_42174":118985,"_29767":189663,"_5":21387,"_28235":118985,"_5797":189664},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_6892":118987,"_42174":118985,"_5":42651,"_29767":189666,"_28235":189667,"_5797":189668},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_6892":118988,"_42174":118985,"_5":42651,"_29767":189670,"_28235":189671,"_5797":189672},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_6892":118989,"_42174":118985,"_5":42651,"_29767":189674,"_28235":189675,"_5797":189676},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_6892":118990,"_42174":118985,"_5":42651,"_29767":189678,"_28235":189679,"_5797":189680},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_6892":118991,"_42174":118985,"_5":42651,"_29767":189682,"_28235":189683,"_5797":189684},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#máquina-de-estados-de-los-recursos","Máquina de estados de los recursos",{"_6892":118992,"_42174":118985,"_5":42651,"_29767":189686,"_28235":189687,"_5797":189688},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#eventos-que-gestiona-el-conector","Eventos que gestiona el conector",{"_6892":118993,"_42174":118985,"_5":42651,"_29767":189690,"_28235":189691,"_5797":189692},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_6892":118994,"_42174":118985,"_5":42651,"_29767":189694,"_28235":189695,"_5797":189696},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_6892":118995,"_42174":118985,"_5":42651,"_29767":189698,"_28235":189699,"_5797":189700},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_6892":118996,"_42174":118985,"_5":42651,"_29767":189702,"_28235":189703,"_5797":189704},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_6892":118997,"_42174":118985,"_5":42651,"_29767":189706,"_28235":189707,"_5797":189708},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_6892":118998,"_42174":118985,"_5":42651,"_29767":189710,"_28235":189711,"_5797":189712},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_6892":118999,"_42174":118985,"_5":42651,"_29767":189714,"_28235":189715,"_5797":81223},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_6892":119000,"_42174":118985,"_5":42651,"_29767":189717,"_28235":189718,"_5797":81227},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_6892":119001,"_42174":118985,"_5":42651,"_29767":189720,"_28235":189721,"_5797":189722},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_6892":119002,"_42174":118985,"_5":42651,"_29767":189724,"_28235":189725,"_5797":189726},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_6892":119003,"_42174":118985,"_5":42651,"_29767":189728,"_28235":189729,"_5797":189730},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_6892":119004,"_42174":118985,"_5":42651,"_29767":189732,"_28235":189733,"_5797":189734},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_6892":119005,"_42174":118985,"_5":42651,"_29767":189736,"_28235":189737,"_5797":189738},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_6892":119006,"_42174":118985,"_5":42651,"_29767":189740,"_28235":189741,"_5797":189742},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_6892":119007,"_42174":118985,"_5":42651,"_29767":189744,"_28235":189745,"_5797":189746},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_6892":119008,"_42174":118985,"_5":42651,"_29767":189748,"_28235":189749,"_5797":189750},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_6892":119009,"_42174":118985,"_5":42651,"_29767":189752,"_28235":189753,"_5797":189754},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_6892":119010,"_42174":118985,"_5":42651,"_29767":189756,"_28235":189757,"_5797":189758},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_6892":119011,"_42174":118985,"_5":42651,"_29767":189760,"_28235":189761,"_5797":189762},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_6892":119012,"_42174":118985,"_5":42651,"_29767":189764,"_28235":189765,"_5797":189766},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_6892":119013,"_42174":118985,"_29767":189768,"_5":21387,"_28235":118985,"_5797":189769},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_6892":119014,"_42174":118985,"_29767":189771,"_5":21387,"_28235":118985,"_5797":189772},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_6892":119015,"_42174":118985,"_29767":189774,"_5":21387,"_28235":118985,"_5797":189775},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_6892":119016,"_42174":118985,"_29767":189777,"_5":21387,"_28235":189667,"_5797":189778},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_6892":119017,"_42174":118985,"_29767":189780,"_5":21387,"_28235":189667,"_5797":189781},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_6892":119018,"_42174":118985,"_29767":189783,"_5":21387,"_28235":189667,"_5797":189784},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_6892":119019,"_42174":118985,"_29767":189786,"_5":21387,"_28235":189667,"_5797":189787},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_6892":119020,"_42174":118985,"_29767":189789,"_5":21387,"_28235":189671,"_5797":189790},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_6892":119021,"_42174":118985,"_29767":189792,"_5":21387,"_28235":189675,"_5797":189793},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_6892":119022,"_42174":118985,"_29767":189795,"_5":21387,"_28235":189675,"_5797":189796},[],"Acción IAM",{"_6892":119023,"_42174":118985,"_29767":189798,"_5":21387,"_28235":189675,"_5797":186214},[],{"_6892":119024,"_42174":118985,"_29767":189800,"_5":21387,"_28235":189675,"_5797":81310},[],{"_6892":119025,"_42174":118985,"_29767":189802,"_5":21387,"_28235":189675,"_5797":189803},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_6892":119026,"_42174":118985,"_29767":189805,"_5":21387,"_28235":189675,"_5797":81316},[],{"_6892":119027,"_42174":118985,"_29767":189807,"_5":21387,"_28235":189675,"_5797":189808},[],"Registrar la CA en AWS IoT",{"_6892":119028,"_42174":118985,"_29767":189810,"_5":21387,"_28235":189675,"_5797":81322},[],{"_6892":119029,"_42174":118985,"_29767":189812,"_5":21387,"_28235":189675,"_5797":189813},[],"Consultar el estado del registro de la CA",{"_6892":119030,"_42174":118985,"_29767":189815,"_5":21387,"_28235":189675,"_5797":81328},[],{"_6892":119031,"_42174":118985,"_29767":189817,"_5":21387,"_28235":189675,"_5797":189818},[],"Crear o actualizar Things en IoT Core",{"_6892":119032,"_42174":118985,"_29767":189820,"_5":21387,"_28235":189675,"_5797":81334},[],{"_6892":119033,"_42174":118985,"_29767":189822,"_5":21387,"_28235":189675,"_5797":189823},[],"Aprovisionar Things mediante plantilla",{"_6892":119034,"_42174":118985,"_29767":189825,"_5":21387,"_28235":189675,"_5797":81340},[],{"_6892":119035,"_42174":118985,"_29767":189827,"_5":21387,"_28235":189675,"_5797":189828},[],"Registrar certificados de dispositivo",{"_6892":119036,"_42174":118985,"_29767":189830,"_5":21387,"_28235":189675,"_5797":81346},[],{"_6892":119037,"_42174":118985,"_29767":189832,"_5":21387,"_28235":189675,"_5797":189833},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_6892":119038,"_42174":118985,"_29767":189835,"_5":21387,"_28235":189675,"_5797":81352},[],{"_6892":119039,"_42174":118985,"_29767":189837,"_5":21387,"_28235":189675,"_5797":189838},[],"Crear y adjuntar políticas IoT",{"_6892":119040,"_42174":118985,"_29767":189840,"_5":21387,"_28235":189675,"_5797":81358},[],{"_6892":119041,"_42174":118985,"_29767":189842,"_5":21387,"_28235":189675,"_5797":189843},[],"Gestionar grupos de Things",{"_6892":119042,"_42174":118985,"_29767":189845,"_5":21387,"_28235":189675,"_5797":81364},[],{"_6892":119043,"_42174":118985,"_29767":189847,"_5":21387,"_28235":189675,"_5797":189848},[],"Crear plantillas JITP",{"_6892":119044,"_42174":118985,"_29767":189850,"_5":21387,"_28235":189675,"_5797":81370},[],{"_6892":119045,"_42174":118985,"_29767":189852,"_5":21387,"_28235":189675,"_5797":189853},[],"Leer y escribir el Device Shadow",{"_6892":119046,"_42174":118985,"_29767":189855,"_5":21387,"_28235":189675,"_5797":189856},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_6892":119047,"_42174":118985,"_29767":189858,"_5":21387,"_28235":189679,"_5797":189859},[],"Parámetro",{"_6892":119048,"_42174":118985,"_29767":189861,"_5":21387,"_28235":189679,"_5797":189862},[],"Tipo",{"_6892":119049,"_42174":118985,"_29767":189864,"_5":21387,"_28235":189679,"_5797":189865},[],"Requerido",{"_6892":119050,"_42174":118985,"_29767":189867,"_5":21387,"_28235":189679,"_5797":189868},[],"Descripción",{"_6892":119051,"_42174":118985,"_29767":189870,"_5":21387,"_28235":189679,"_5797":81391},[],{"_6892":119052,"_42174":118985,"_29767":189872,"_5":21387,"_28235":189679,"_5797":34761},[],{"_6892":119053,"_42174":118985,"_29767":189874,"_5":21387,"_28235":189679,"_5797":189875},[],"Sí",{"_6892":119054,"_42174":118985,"_29767":189877,"_5":21387,"_28235":189679,"_5797":189878},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_6892":119055,"_42174":118985,"_29767":189880,"_5":21387,"_28235":189679,"_5797":81402},[],{"_6892":119056,"_42174":118985,"_29767":189882,"_5":21387,"_28235":189679,"_5797":34761},[],{"_6892":119057,"_42174":118985,"_29767":189884,"_5":21387,"_28235":189679,"_5797":189875},[],{"_6892":119058,"_42174":118985,"_29767":189886,"_5":21387,"_28235":189679,"_5797":189887},[],"Región AWS donde opera el conector.",{"_6892":119059,"_42174":118985,"_29767":189889,"_5":21387,"_28235":189679,"_5797":81412},[],{"_6892":119060,"_42174":118985,"_29767":189891,"_5":21387,"_28235":189679,"_5797":34761},[],{"_6892":119061,"_42174":118985,"_29767":189893,"_5":21387,"_28235":189679,"_5797":189875},[],{"_6892":119062,"_42174":118985,"_29767":189895,"_5":21387,"_28235":189679,"_5797":189896},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_6892":119063,"_42174":118985,"_29767":189898,"_5":21387,"_28235":189679,"_5797":81422},[],{"_6892":119064,"_42174":118985,"_29767":189900,"_5":21387,"_28235":189679,"_5797":34761},[],{"_6892":119065,"_42174":118985,"_29767":189902,"_5":21387,"_28235":189679,"_5797":189903},[],"Solo con `auth_method=static`",{"_6892":119066,"_42174":118985,"_29767":189905,"_5":21387,"_28235":189679,"_5797":189906},[],"Clave de acceso AWS.",{"_6892":119067,"_42174":118985,"_29767":189908,"_5":21387,"_28235":189679,"_5797":81433},[],{"_6892":119068,"_42174":118985,"_29767":189910,"_5":21387,"_28235":189679,"_5797":34761},[],{"_6892":119069,"_42174":118985,"_29767":189912,"_5":21387,"_28235":189679,"_5797":189903},[],{"_6892":119070,"_42174":118985,"_29767":189914,"_5":21387,"_28235":189679,"_5797":189915},[],"Clave secreta AWS.",{"_6892":119071,"_42174":118985,"_29767":189917,"_5":21387,"_28235":189679,"_5797":81443},[],{"_6892":119072,"_42174":118985,"_29767":189919,"_5":21387,"_28235":189679,"_5797":34761},[],{"_6892":119073,"_42174":118985,"_29767":189921,"_5":21387,"_28235":189679,"_5797":81448},[],{"_6892":119074,"_42174":118985,"_29767":189923,"_5":21387,"_28235":189679,"_5797":189924},[],"Token de sesión (con `auth_method=static`).",{"_6892":119075,"_42174":118985,"_29767":189926,"_5":21387,"_28235":189679,"_5797":81454},[],{"_6892":119076,"_42174":118985,"_29767":189928,"_5":21387,"_28235":189679,"_5797":34761},[],{"_6892":119077,"_42174":118985,"_29767":189930,"_5":21387,"_28235":189679,"_5797":189931},[],"Solo con `auth_method=role`",{"_6892":119078,"_42174":118985,"_29767":189933,"_5":21387,"_28235":189679,"_5797":189934},[],"ARN del rol a asumir.",{"_6892":119079,"_42174":118985,"_29767":189936,"_5":21387,"_28235":189679,"_5797":81465},[],{"_6892":119080,"_42174":118985,"_29767":189938,"_5":21387,"_28235":189679,"_5797":34761},[],{"_6892":119081,"_42174":118985,"_29767":189940,"_5":21387,"_28235":189679,"_5797":81448},[],{"_6892":119082,"_42174":118985,"_29767":189942,"_5":21387,"_28235":189679,"_5797":189943},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_6892":119083,"_42174":118985,"_29767":189945,"_5":21387,"_28235":189679,"_5797":81475},[],{"_6892":119084,"_42174":118985,"_29767":189947,"_5":21387,"_28235":189679,"_5797":25581},[],{"_6892":119085,"_42174":118985,"_29767":189949,"_5":21387,"_28235":189679,"_5797":189875},[],{"_6892":119086,"_42174":118985,"_29767":189951,"_5":21387,"_28235":189679,"_5797":189952},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_6892":119087,"_42174":118985,"_29767":189954,"_5":21387,"_28235":189679,"_5797":81485},[],{"_6892":119088,"_42174":118985,"_29767":189956,"_5":21387,"_28235":189679,"_5797":34761},[],{"_6892":119089,"_42174":118985,"_29767":189958,"_5":21387,"_28235":189679,"_5797":189875},[],{"_6892":119090,"_42174":118985,"_29767":189960,"_5":21387,"_28235":189679,"_5797":189961},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_6892":119091,"_42174":118985,"_29767":189963,"_5":21387,"_28235":189679,"_5797":81495},[],{"_6892":119092,"_42174":118985,"_29767":189965,"_5":21387,"_28235":189679,"_5797":34761},[],{"_6892":119093,"_42174":118985,"_29767":189967,"_5":21387,"_28235":189679,"_5797":189875},[],{"_6892":119094,"_42174":118985,"_29767":189969,"_5":21387,"_28235":189679,"_5797":189970},[],"URL HTTP del Device Manager de Lamassu.",{"_6892":119095,"_42174":118985,"_29767":189972,"_5":21387,"_28235":189679,"_5797":81505},[],{"_6892":119096,"_42174":118985,"_29767":189974,"_5":21387,"_28235":189679,"_5797":34761},[],{"_6892":119097,"_42174":118985,"_29767":189976,"_5":21387,"_28235":189679,"_5797":189875},[],{"_6892":119098,"_42174":118985,"_29767":189978,"_5":21387,"_28235":189679,"_5797":189979},[],"URL HTTP del servicio de CA de Lamassu.",{"_6892":119099,"_42174":118985,"_29767":189981,"_5":21387,"_28235":189683,"_5797":189982},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada transición. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_6892":119100,"_42174":118985,"_29767":189984,"_5":21387,"_28235":189687,"_5797":189985},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_6892":119101,"_42174":118985,"_29767":189987,"_5":21387,"_28235":189687,"_5797":189988},[],"Tipo de CloudEvent",{"_6892":119102,"_42174":118985,"_29767":189990,"_5":21387,"_28235":189687,"_5797":189991},[],"Recurso en Lamassu",{"_6892":119103,"_42174":118985,"_29767":189993,"_5":21387,"_28235":189687,"_5797":189994},[],"Recurso AWS",{"_6892":119104,"_42174":118985,"_29767":189996,"_5":21387,"_28235":189687,"_5797":189997},[],"Acciones IAM",{"_6892":119105,"_42174":118985,"_29767":189999,"_5":21387,"_28235":189687,"_5797":190000},[],"Llamadas AWS y efecto",{"_6892":119106,"_42174":118985,"_29767":190002,"_5":21387,"_28235":189687,"_5797":190003},[],"Dónde en esta página",{"_6892":119107,"_42174":118985,"_29767":190005,"_5":21387,"_28235":189687,"_5797":81539},[],{"_6892":119108,"_42174":118985,"_29767":190007,"_5":21387,"_28235":189687,"_5797":81542},[],{"_6892":119109,"_42174":118985,"_29767":190009,"_5":21387,"_28235":189687,"_5797":81545},[],{"_6892":119110,"_42174":118985,"_29767":190011,"_5":21387,"_28235":189687,"_5797":81548},[],{"_6892":119111,"_42174":118985,"_29767":190013,"_5":21387,"_28235":189687,"_5797":190014},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_6892":119112,"_42174":118985,"_29767":190016,"_5":21387,"_28235":189687,"_5797":189692},[],{"_6892":119113,"_42174":118985,"_29767":190018,"_5":21387,"_28235":189687,"_5797":81556},[],{"_6892":119114,"_42174":118985,"_29767":190020,"_5":21387,"_28235":189687,"_5797":81559},[],{"_6892":119115,"_42174":118985,"_29767":190022,"_5":21387,"_28235":189687,"_5797":81562},[],{"_6892":119116,"_42174":118985,"_29767":190024,"_5":21387,"_28235":189687,"_5797":81565},[],{"_6892":119117,"_42174":118985,"_29767":190026,"_5":21387,"_28235":189687,"_5797":190027},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_6892":119118,"_42174":118985,"_29767":190029,"_5":21387,"_28235":189687,"_5797":189696},[],{"_6892":119119,"_42174":118985,"_29767":190031,"_5":21387,"_28235":189687,"_5797":81573},[],{"_6892":119120,"_42174":118985,"_29767":190033,"_5":21387,"_28235":189687,"_5797":190034},[],"Dispositivo",{"_6892":119121,"_42174":118985,"_29767":190036,"_5":21387,"_28235":189687,"_5797":81579},[],{"_6892":119122,"_42174":118985,"_29767":190038,"_5":21387,"_28235":189687,"_5797":81582},[],{"_6892":119123,"_42174":118985,"_29767":190040,"_5":21387,"_28235":189687,"_5797":190041},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_6892":119124,"_42174":118985,"_29767":190043,"_5":21387,"_28235":189687,"_5797":189704},[],{"_6892":119125,"_42174":118985,"_29767":190045,"_5":21387,"_28235":189687,"_5797":81590},[],{"_6892":119126,"_42174":118985,"_29767":190047,"_5":21387,"_28235":189687,"_5797":190048},[],"Certificado",{"_6892":119127,"_42174":118985,"_29767":190050,"_5":21387,"_28235":189687,"_5797":81596},[],{"_6892":119128,"_42174":118985,"_29767":190052,"_5":21387,"_28235":189687,"_5797":190053},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_6892":119129,"_42174":118985,"_29767":190055,"_5":21387,"_28235":189687,"_5797":190056},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_6892":119130,"_42174":118985,"_29767":190058,"_5":21387,"_28235":189687,"_5797":189700},[],{"_6892":119131,"_42174":118985,"_29767":190060,"_5":21387,"_28235":189687,"_5797":81607},[],{"_6892":119132,"_42174":118985,"_29767":190062,"_5":21387,"_28235":189687,"_5797":190063},[],"Certificado / Dispositivo",{"_6892":119133,"_42174":118985,"_29767":190065,"_5":21387,"_28235":189687,"_5797":81613},[],{"_6892":119134,"_42174":118985,"_29767":190067,"_5":21387,"_28235":189687,"_5797":77644},[],{"_6892":119135,"_42174":118985,"_29767":190069,"_5":21387,"_28235":189687,"_5797":190070},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_6892":119136,"_42174":118985,"_29767":190072,"_5":21387,"_28235":189687,"_5797":189754},[],{"_6892":119137,"_42174":118985,"_29767":190074,"_5":21387,"_28235":189691,"_5797":190075},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_6892":119138,"_42174":118985,"_29767":190077,"_5":21387,"_28235":189691,"_5797":190078},[],"por el campo `registration.status` de los metadatos del conector en la CA:",{"_6892":119139,"_42174":118985,"_29767":190080,"_5":21387,"_28235":189691,"_5797":190081},[],"Transición",{"_6892":119140,"_42174":118985,"_29767":190083,"_5":21387,"_28235":189691,"_5797":190084},[],"Llamadas AWS",{"_6892":119141,"_42174":118985,"_29767":190086,"_5":21387,"_28235":189691,"_5797":190087},[],"`NoRegistrada` → `Solicitada`",{"_6892":119142,"_42174":118985,"_29767":190089,"_5":21387,"_28235":189691,"_5797":190090},[],"ninguna (solo escritura de metadatos)",{"_6892":119143,"_42174":118985,"_29767":190092,"_5":21387,"_28235":189691,"_5797":190093},[],"`Solicitada` → `Registrando`",{"_6892":119144,"_42174":118985,"_29767":190095,"_5":21387,"_28235":189691,"_5797":190096},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_6892":119145,"_42174":118985,"_29767":190098,"_5":21387,"_28235":189691,"_5797":190099},[],"`Registrando` → `Completada`",{"_6892":119146,"_42174":118985,"_29767":190101,"_5":21387,"_28235":189691,"_5797":190102},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_6892":119147,"_42174":118985,"_29767":190104,"_5":21387,"_28235":189691,"_5797":190105},[],"`Registrando` → `Fallida`",{"_6892":119148,"_42174":118985,"_29767":190107,"_5":21387,"_28235":189691,"_5797":190108},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_6892":119149,"_42174":118985,"_29767":190110,"_5":21387,"_28235":189691,"_5797":190111},[],"`Fallida` / `Completada` → `Solicitada`",{"_6892":119150,"_42174":118985,"_29767":190113,"_5":21387,"_28235":189691,"_5797":190114},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_6892":119151,"_42174":118985,"_29767":190116,"_5":21387,"_28235":189695,"_5797":190117},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_6892":119152,"_42174":118985,"_29767":190119,"_5":21387,"_28235":189695,"_5797":190081},[],{"_6892":119153,"_42174":118985,"_29767":190121,"_5":21387,"_28235":189695,"_5797":190084},[],{"_6892":119154,"_42174":118985,"_29767":190123,"_5":21387,"_28235":189695,"_5797":190124},[],"`SinConfigurar` → `None` / `Auto`",{"_6892":119155,"_42174":118985,"_29767":190126,"_5":21387,"_28235":189695,"_5797":190127},[],"ninguna (solo configuración)",{"_6892":119156,"_42174":118985,"_29767":190129,"_5":21387,"_28235":189695,"_5797":81678},[],{"_6892":119157,"_42174":118985,"_29767":190131,"_5":21387,"_28235":189695,"_5797":190127},[],{"_6892":119158,"_42174":118985,"_29767":190133,"_5":21387,"_28235":189695,"_5797":190134},[],"Cualquiera → `Jitp`",{"_6892":119159,"_42174":118985,"_29767":190136,"_5":21387,"_28235":189695,"_5797":190137},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_6892":119160,"_42174":118985,"_29767":190139,"_5":21387,"_28235":189695,"_5797":81689},[],{"_6892":119161,"_42174":118985,"_29767":190141,"_5":21387,"_28235":189695,"_5797":190142},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_6892":119162,"_42174":118985,"_29767":190144,"_5":21387,"_28235":189699,"_5797":190145},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_6892":119163,"_42174":118985,"_29767":190147,"_5":21387,"_28235":189699,"_5797":190081},[],{"_6892":119164,"_42174":118985,"_29767":190149,"_5":21387,"_28235":189699,"_5797":190084},[],{"_6892":119165,"_42174":118985,"_29767":190151,"_5":21387,"_28235":189699,"_5797":190152},[],"`NoSincronizado` → `Active`",{"_6892":119166,"_42174":118985,"_29767":190154,"_5":21387,"_28235":189699,"_5797":81346},[],{"_6892":119167,"_42174":118985,"_29767":190156,"_5":21387,"_28235":189699,"_5797":81707},[],{"_6892":119168,"_42174":118985,"_29767":190158,"_5":21387,"_28235":189699,"_5797":190159},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_6892":119169,"_42174":118985,"_29767":190161,"_5":21387,"_28235":189699,"_5797":81713},[],{"_6892":119170,"_42174":118985,"_29767":190163,"_5":21387,"_28235":189699,"_5797":190159},[],{"_6892":119171,"_42174":118985,"_29767":190165,"_5":21387,"_28235":189699,"_5797":81718},[],{"_6892":119172,"_42174":118985,"_29767":190167,"_5":21387,"_28235":189699,"_5797":81346},[],{"_6892":119173,"_42174":118985,"_29767":190169,"_5":21387,"_28235":189699,"_5797":81723},[],{"_6892":119174,"_42174":118985,"_29767":190171,"_5":21387,"_28235":189699,"_5797":190172},[],"ninguna (estos estados no se sincronizan con AWS)",{"_6892":119175,"_42174":118985,"_29767":190174,"_5":21387,"_28235":189703,"_5797":190175},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_6892":119176,"_42174":118985,"_29767":190177,"_5":21387,"_28235":189703,"_5797":190081},[],{"_6892":119177,"_42174":118985,"_29767":190179,"_5":21387,"_28235":189703,"_5797":190084},[],{"_6892":119178,"_42174":118985,"_29767":190181,"_5":21387,"_28235":189703,"_5797":190182},[],"`Ausente` → `Aprovisionado`",{"_6892":119179,"_42174":118985,"_29767":190184,"_5":21387,"_28235":189703,"_5797":190185},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_6892":119180,"_42174":118985,"_29767":190187,"_5":21387,"_28235":189703,"_5797":190188},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_6892":119181,"_42174":118985,"_29767":190190,"_5":21387,"_28235":189703,"_5797":190191},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_6892":119182,"_42174":118985,"_29767":190193,"_5":21387,"_28235":189703,"_5797":190194},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_6892":119183,"_42174":118985,"_29767":190196,"_5":21387,"_28235":189707,"_5797":190197},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_6892":119184,"_42174":118985,"_29767":190199,"_5":21387,"_28235":189711,"_5797":190200},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_6892":119185,"_42174":118985,"_29767":190202,"_5":21387,"_28235":189711,"_5797":190203},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_6892":119186,"_42174":118985,"_29767":190205,"_5":21387,"_28235":189715,"_5797":190206},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_6892":119187,"_42174":118985,"_29767":190208,"_5":21387,"_28235":189715,"_5797":190209},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_6892":119188,"_42174":118985,"_29767":190211,"_5":21387,"_28235":189715,"_5797":190212},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_6892":119189,"_42174":118985,"_29767":190214,"_5":21387,"_28235":189715,"_5797":190215},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_6892":119190,"_42174":118985,"_29767":190217,"_5":21387,"_28235":189715,"_5797":190218},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_6892":119191,"_42174":118985,"_29767":190220,"_5":21387,"_28235":189715,"_5797":190221},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_6892":119192,"_42174":118985,"_29767":190223,"_5":21387,"_28235":189718,"_5797":190224},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_6892":119193,"_42174":118985,"_29767":190226,"_5":21387,"_28235":189721,"_5797":190227},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_6892":119194,"_42174":118985,"_29767":190229,"_5":21387,"_28235":189721,"_5797":190230},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_6892":119195,"_42174":118985,"_29767":190232,"_5":21387,"_28235":189725,"_5797":190233},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_6892":119196,"_42174":118985,"_29767":190235,"_5":21387,"_28235":189729,"_5797":190236},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_6892":119197,"_42174":118985,"_29767":190238,"_5":21387,"_28235":189729,"_5797":190239},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_6892":119198,"_42174":118985,"_29767":190241,"_5":21387,"_28235":189729,"_5797":190242},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_6892":119199,"_42174":118985,"_29767":190244,"_5":21387,"_28235":189729,"_5797":190245},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_6892":119200,"_42174":118985,"_29767":190247,"_5":21387,"_28235":189729,"_5797":190248},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_6892":119201,"_42174":118985,"_29767":190250,"_5":21387,"_28235":189729,"_5797":190251},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_6892":119202,"_42174":118985,"_29767":190253,"_5":21387,"_28235":189733,"_5797":190254},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_6892":119203,"_42174":118985,"_29767":190256,"_5":21387,"_28235":189733,"_5797":190257},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_6892":119204,"_42174":118985,"_29767":190259,"_5":21387,"_28235":189733,"_5797":190260},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_6892":119205,"_42174":118985,"_29767":190262,"_5":21387,"_28235":189733,"_5797":190263},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_6892":119206,"_42174":118985,"_29767":190265,"_5":21387,"_28235":189733,"_5797":190266},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_6892":119207,"_42174":118985,"_29767":190268,"_5":21387,"_28235":189737,"_5797":190269},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_6892":119208,"_42174":118985,"_29767":190271,"_5":21387,"_28235":189737,"_5797":190272},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_6892":119209,"_42174":118985,"_29767":190274,"_5":21387,"_28235":189737,"_5797":190275},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_6892":119210,"_42174":118985,"_29767":190277,"_5":21387,"_28235":189741,"_5797":190278},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_6892":119211,"_42174":118985,"_29767":190280,"_5":21387,"_28235":189741,"_5797":190281},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_6892":119212,"_42174":118985,"_29767":190283,"_5":21387,"_28235":189741,"_5797":190284},[],"Para que el flujo JITP funcione correctamente:",{"_6892":119213,"_42174":118985,"_29767":190286,"_5":21387,"_28235":189741,"_5797":190287},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_6892":119214,"_42174":118985,"_29767":190289,"_5":21387,"_28235":189741,"_5797":190290},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_6892":119215,"_42174":118985,"_29767":190292,"_5":21387,"_28235":189741,"_5797":190293},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_6892":119216,"_42174":118985,"_29767":190295,"_5":21387,"_28235":189741,"_5797":190296},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_6892":119217,"_42174":118985,"_29767":190298,"_5":21387,"_28235":189745,"_5797":190299},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_6892":119218,"_42174":118985,"_29767":190301,"_5":21387,"_28235":189745,"_5797":190302},[],"Estado en Lamassu",{"_6892":119219,"_42174":118985,"_29767":190304,"_5":21387,"_28235":189745,"_5797":190305},[],"Razón de revocación",{"_6892":119220,"_42174":118985,"_29767":190307,"_5":21387,"_28235":189745,"_5797":190308},[],"Estado en AWS IoT Core",{"_6892":119221,"_42174":118985,"_29767":190310,"_5":21387,"_28235":189745,"_5797":81868},[],{"_6892":119222,"_42174":118985,"_29767":190312,"_5":21387,"_28235":189745,"_5797":190313},[],"Ninguna",{"_6892":119223,"_42174":118985,"_29767":190315,"_5":21387,"_28235":189745,"_5797":81874},[],{"_6892":119224,"_42174":118985,"_29767":190317,"_5":21387,"_28235":189745,"_5797":81877},[],{"_6892":119225,"_42174":118985,"_29767":190319,"_5":21387,"_28235":189745,"_5797":81880},[],{"_6892":119226,"_42174":118985,"_29767":190321,"_5":21387,"_28235":189745,"_5797":81883},[],{"_6892":119227,"_42174":118985,"_29767":190323,"_5":21387,"_28235":189745,"_5797":81877},[],{"_6892":119228,"_42174":118985,"_29767":190325,"_5":21387,"_28235":189745,"_5797":190326},[],"Cualquier otra razón",{"_6892":119229,"_42174":118985,"_29767":190328,"_5":21387,"_28235":189745,"_5797":81891},[],{"_6892":119230,"_42174":118985,"_29767":190330,"_5":21387,"_28235":189745,"_5797":190331},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_6892":119231,"_42174":118985,"_29767":190333,"_5":21387,"_28235":189749,"_5797":190334},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_6892":119232,"_42174":118985,"_29767":190336,"_5":21387,"_28235":189749,"_5797":190337},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_6892":119233,"_42174":118985,"_29767":190339,"_5":21387,"_28235":189749,"_5797":190340},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_6892":119234,"_42174":118985,"_29767":190342,"_5":21387,"_28235":189753,"_5797":190343},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_6892":119235,"_42174":118985,"_29767":190345,"_5":21387,"_28235":189753,"_5797":190346},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_6892":119236,"_42174":118985,"_29767":190348,"_5":21387,"_28235":189757,"_5797":190349},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_6892":119237,"_42174":118985,"_29767":190351,"_5":21387,"_28235":189757,"_5797":190352},[],"Existen dos tipos de acciones:",{"_6892":119238,"_42174":118985,"_29767":190354,"_5":21387,"_28235":189757,"_5797":190355},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_6892":119239,"_42174":118985,"_29767":190357,"_5":21387,"_28235":189757,"_5797":190358},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_6892":119240,"_42174":118985,"_29767":190360,"_5":21387,"_28235":189757,"_5797":190361},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_6892":119241,"_42174":118985,"_29767":190363,"_5":21387,"_28235":189761,"_5797":190364},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_6892":119242,"_42174":118985,"_29767":190366,"_5":21387,"_28235":189761,"_5797":190367},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_6892":119243,"_42174":118985,"_29767":190369,"_5":21387,"_28235":189761,"_5797":190370},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_6892":119244,"_42174":118985,"_29767":190372,"_5":21387,"_28235":189765,"_5797":190373},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_6892":119245,"_42174":118985,"_29767":190375,"_5":21387,"_28235":189765,"_5797":190376},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_6892":119246,"_42174":118985,"_29767":190378,"_5":21387,"_28235":189765,"_5797":190379},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_6892":119247,"_42174":118985,"_29767":190381,"_5":21387,"_28235":189765,"_5797":190382},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_6892":119248,"_42174":118985,"_29767":190384,"_5":21387,"_28235":189765,"_5797":190385},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_6892":119249,"_42174":118985,"_29767":190387,"_5":21387,"_28235":189765,"_5797":190388},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_6892":119250,"_42174":118985,"_29767":190390,"_5":21387,"_28235":189765,"_5797":190391},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_6892":119251,"_42174":118985,"_29767":190393,"_5":21387,"_28235":189765,"_5797":190394},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_6892":119252,"_42174":118985,"_29767":190396,"_5":21387,"_28235":189765,"_5797":190397},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_6892":119253,"_42174":118985,"_29767":190399,"_5":21387,"_28235":189765,"_5797":190400},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_6892":119254,"_42174":118985,"_29767":190402,"_5":21387,"_28235":189765,"_5797":190403},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_6892":119255,"_42174":118985,"_29767":190405,"_5":21387,"_28235":189765,"_5797":190406},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_6892":119256,"_42174":118985,"_29767":190408,"_5":21387,"_28235":189765,"_5797":190409},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_6892":119257,"_42174":118985,"_29767":190411,"_5":21387,"_28235":189765,"_5797":190412},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_6892":119258,"_42174":118985,"_29767":190414,"_5":21387,"_28235":189765,"_5797":190415},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_6892":119259,"_42174":118985,"_29767":190417,"_5":21387,"_28235":189765,"_5797":190418},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_6892":119260,"_42174":118985,"_29767":190420,"_5":21387,"_28235":189765,"_5797":190421},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_6892":119261,"_42174":118985,"_29767":190423,"_5":21387,"_28235":189765,"_5797":190424},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_6892":119262,"_42174":118985,"_29767":190426,"_5":21387,"_28235":189765,"_5797":190427},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_6892":119263,"_42174":118985,"_29767":190429,"_5":21387,"_28235":189765,"_5797":190430},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_6892":119264,"_42174":118985,"_29767":190432,"_5":21387,"_28235":189765,"_5797":190433},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_6892":119265,"_42174":118985,"_29767":190435,"_5":21387,"_28235":189765,"_5797":190436},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_6892":119266,"_42174":118985,"_29767":190438,"_5":21387,"_28235":189765,"_5797":190439},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_6892":119267,"_42174":118985,"_29767":190441,"_5":21387,"_28235":189765,"_5797":190442},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_6892":119268,"_42174":119268,"_5":21817,"_5797":79705,"_42654":190444,"_29767":190445,"_28235":119268},[77248,187247,79705],[],{"_6892":119269,"_42174":119268,"_29767":190447,"_5":21387,"_28235":119268,"_5797":190448},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_6892":119270,"_42174":119268,"_5":42651,"_29767":190450,"_28235":190451,"_5797":190452},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_6892":119271,"_42174":119268,"_5":42651,"_29767":190454,"_28235":190455,"_5797":188253},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_6892":119272,"_42174":119268,"_5":42651,"_29767":190457,"_28235":190458,"_5797":188428},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_6892":119273,"_42174":119268,"_5":42651,"_29767":190460,"_28235":190461,"_5797":189660},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/overview#integraciones",{"_6892":119274,"_42174":119268,"_5":42651,"_29767":190463,"_28235":190464,"_5797":190465},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/overview#actualizaciones-de-software","Actualizaciones de software",{"_6892":119275,"_42174":119268,"_5":42651,"_29767":190467,"_28235":190468,"_5797":190469},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_6892":119276,"_42174":119268,"_29767":190471,"_5":21387,"_28235":119268,"_5797":190472},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_6892":119277,"_42174":119268,"_29767":190474,"_5":21387,"_28235":190451,"_5797":190475},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_6892":119278,"_42174":119268,"_29767":190477,"_5":21387,"_28235":190451,"_5797":190478},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_6892":119279,"_42174":119268,"_29767":190480,"_5":21387,"_28235":190455,"_5797":190481},[],"Recurso",{"_6892":119280,"_42174":119268,"_29767":190483,"_5":21387,"_28235":190455,"_5797":190484},[],"Qué representa",{"_6892":119281,"_42174":119268,"_29767":190486,"_5":21387,"_28235":190455,"_5797":190487},[],"**Dispositivo**",{"_6892":119282,"_42174":119268,"_29767":190489,"_5":21387,"_28235":190455,"_5797":190490},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_6892":119283,"_42174":119268,"_29767":190492,"_5":21387,"_28235":190455,"_5797":190493},[],"**Identidad**",{"_6892":119284,"_42174":119268,"_29767":190495,"_5":21387,"_28235":190455,"_5797":190496},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_6892":119285,"_42174":119268,"_29767":190498,"_5":21387,"_28235":190455,"_5797":82062},[],{"_6892":119286,"_42174":119268,"_29767":190500,"_5":21387,"_28235":190455,"_5797":190501},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_6892":119287,"_42174":119268,"_29767":190503,"_5":21387,"_28235":190455,"_5797":190504},[],"**Flota**",{"_6892":119288,"_42174":119268,"_29767":190506,"_5":21387,"_28235":190455,"_5797":190507},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_6892":119289,"_42174":119268,"_29767":190509,"_5":21387,"_28235":190455,"_5797":190510},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_6892":119290,"_42174":119268,"_29767":190512,"_5":21387,"_28235":190455,"_5797":190513},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_6892":119291,"_42174":119268,"_29767":190515,"_5":21387,"_28235":190458,"_5797":190516},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_6892":119292,"_42174":119268,"_29767":190518,"_5":21387,"_28235":190458,"_5797":190519},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_6892":119293,"_42174":119268,"_29767":190521,"_5":21387,"_28235":190458,"_5797":190522},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_6892":119294,"_42174":119268,"_29767":190524,"_5":21387,"_28235":190458,"_5797":190525},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_6892":119295,"_42174":119268,"_29767":190527,"_5":21387,"_28235":190458,"_5797":190528},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_6892":119296,"_42174":119268,"_29767":190530,"_5":21387,"_28235":190458,"_5797":190531},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_6892":119297,"_42174":119268,"_29767":190533,"_5":21387,"_28235":190458,"_5797":190534},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_6892":119298,"_42174":119268,"_29767":190536,"_5":21387,"_28235":190458,"_5797":190537},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_6892":119299,"_42174":119268,"_29767":190539,"_5":21387,"_28235":190461,"_5797":190540},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_6892":119300,"_42174":119268,"_29767":190542,"_5":21387,"_28235":190461,"_5797":190543},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_6892":119301,"_42174":119268,"_29767":190545,"_5":21387,"_28235":190464,"_5797":190546},[],"Cuando los dispositivos ya tienen identidad, Lamassu Updates les entrega firmware y software por aire. Publicas un paquete, eliges los dispositivos o grupos que lo reciben y sigues el despliegue; los dispositivos lo instalan con SWUpdate y los paquetes pueden firmarse y cifrarse.",{"_6892":119302,"_42174":119268,"_29767":190548,"_5":21387,"_28235":190464,"_5797":190549},[],"<Card title=\"Lamassu Updates\" description=\"Entiende el servicio, sus dos backends y el ciclo de vida de una actualización.\" href=\"/docs/platform/updates/overview\" />",{"_6892":119303,"_42174":119268,"_29767":190551,"_5":21387,"_28235":190464,"_5797":190552},[],"<Card title=\"Publica y despliega una actualización\" description=\"Crea un pack, genera el paquete y lánzalo a un grupo de dispositivos.\" href=\"/docs/platform/updates/guides/publish-and-roll-out\" />",{"_6892":119304,"_42174":119268,"_29767":190554,"_5":21387,"_28235":190468,"_5797":190555},[],"Participante",{"_6892":119305,"_42174":119268,"_29767":190557,"_5":21387,"_28235":190468,"_5797":190558},[],"Responsabilidad",{"_6892":119306,"_42174":119268,"_29767":190560,"_5":21387,"_28235":190468,"_5797":190561},[],"Administrador PKI",{"_6892":119307,"_42174":119268,"_29767":190563,"_5":21387,"_28235":190468,"_5797":190564},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_6892":119308,"_42174":119268,"_29767":190566,"_5":21387,"_28235":190468,"_5797":190567},[],"Administrador del aprovisionamiento",{"_6892":119309,"_42174":119268,"_29767":190569,"_5":21387,"_28235":190468,"_5797":190570},[],"DMS, admisión, autenticación por operación e inventario.",{"_6892":119310,"_42174":119268,"_29767":190572,"_5":21387,"_28235":190468,"_5797":190573},[],"Integrador del dispositivo",{"_6892":119311,"_42174":119268,"_29767":190575,"_5":21387,"_28235":190468,"_5797":190576},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_6892":119312,"_42174":119268,"_29767":190578,"_5":21387,"_28235":190468,"_5797":190579},[],"Integrador del consumidor",{"_6892":119313,"_42174":119268,"_29767":190581,"_5":21387,"_28235":190468,"_5797":190582},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_6892":119314,"_42174":119268,"_29767":190584,"_5":21387,"_28235":190468,"_5797":190585},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_6892":119315,"_42174":119315,"_5":21817,"_5797":190587,"_42654":190588,"_29767":190590,"_28235":119315},"Enrola y conecta tu primer dispositivo",[77248,187247,79705,190589],"Primeros pasos",[],{"_6892":119316,"_42174":119315,"_29767":190592,"_5":21387,"_28235":119315,"_5797":190593},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_6892":119317,"_42174":119315,"_5":42651,"_29767":190595,"_28235":190596,"_5797":185844},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_6892":119318,"_42174":119315,"_5":42651,"_29767":190598,"_28235":190599,"_5797":190600},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_6892":119319,"_42174":119315,"_5":42651,"_29767":190602,"_28235":190603,"_5797":190604},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_6892":119320,"_42174":119315,"_5":42651,"_29767":190606,"_28235":190607,"_5797":190608},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_6892":119321,"_42174":119315,"_5":42651,"_29767":190610,"_28235":190611,"_5797":190612},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_6892":119322,"_42174":119315,"_5":42651,"_29767":190614,"_28235":190615,"_5797":190616},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_6892":119323,"_42174":119315,"_5":42651,"_29767":190618,"_28235":190619,"_5797":190620},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_6892":119324,"_42174":119315,"_5":42651,"_29767":190622,"_28235":190623,"_5797":190624},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_6892":119325,"_42174":119315,"_29767":190626,"_5":21387,"_28235":119315,"_5797":190627},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_6892":119326,"_42174":119315,"_29767":190629,"_5":21387,"_28235":190596,"_5797":190630},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_6892":119327,"_42174":119315,"_29767":190632,"_5":21387,"_28235":190596,"_5797":190633},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_6892":119328,"_42174":119315,"_29767":190635,"_5":21387,"_28235":190596,"_5797":190636},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_6892":119329,"_42174":119315,"_29767":190638,"_5":21387,"_28235":190596,"_5797":190639},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_6892":119330,"_42174":119315,"_29767":190641,"_5":21387,"_28235":190596,"_5797":190642},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_6892":119331,"_42174":119315,"_29767":190644,"_5":21387,"_28235":190599,"_5797":190645},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_6892":119332,"_42174":119315,"_29767":190647,"_5":21387,"_28235":190599,"_5797":190648},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_6892":119333,"_42174":119315,"_29767":190650,"_5":21387,"_28235":190603,"_5797":190651},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_6892":119334,"_42174":119315,"_29767":190653,"_5":21387,"_28235":190603,"_5797":190654},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_6892":119335,"_42174":119315,"_29767":190656,"_5":21387,"_28235":190603,"_5797":190657},[],"Ajuste",{"_6892":119336,"_42174":119315,"_29767":190659,"_5":21387,"_28235":190603,"_5797":190660},[],"Valor de evaluación",{"_6892":119337,"_42174":119315,"_29767":190662,"_5":21387,"_28235":190603,"_5797":82227},[],{"_6892":119338,"_42174":119315,"_29767":190664,"_5":21387,"_28235":190603,"_5797":190665},[],"Raíz emisora de `device-root.pem`.",{"_6892":119339,"_42174":119315,"_29767":190667,"_5":21387,"_28235":190603,"_5797":188556},[],{"_6892":119340,"_42174":119315,"_29767":190669,"_5":21387,"_28235":190603,"_5797":190670},[],"Perfil final de 1 hora que acabas de preparar.",{"_6892":119341,"_42174":119315,"_29767":190672,"_5":21387,"_28235":190603,"_5797":82238},[],{"_6892":119342,"_42174":119315,"_29767":190674,"_5":21387,"_28235":190603,"_5797":82241},[],{"_6892":119343,"_42174":119315,"_29767":190676,"_5":21387,"_28235":190603,"_5797":82244},[],{"_6892":119344,"_42174":119315,"_29767":190678,"_5":21387,"_28235":190603,"_5797":190679},[],"Habilitado.",{"_6892":119345,"_42174":119315,"_29767":190681,"_5":21387,"_28235":190603,"_5797":82250},[],{"_6892":119346,"_42174":119315,"_29767":190683,"_5":21387,"_28235":190603,"_5797":190684},[],"Deshabilitado; el ID debe ser nuevo.",{"_6892":119347,"_42174":119315,"_29767":190686,"_5":21387,"_28235":190603,"_5797":190687},[],"Autenticación inicial",{"_6892":119348,"_42174":119315,"_29767":190689,"_5":21387,"_28235":190603,"_5797":190690},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_6892":119349,"_42174":119315,"_29767":190692,"_5":21387,"_28235":190603,"_5797":190693},[],"Autenticación de renovación",{"_6892":119350,"_42174":119315,"_29767":190695,"_5":21387,"_28235":190603,"_5797":190696},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_6892":119351,"_42174":119315,"_29767":190698,"_5":21387,"_28235":190603,"_5797":82268},[],{"_6892":119352,"_42174":119315,"_29767":190700,"_5":21387,"_28235":190603,"_5797":190701},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_6892":119353,"_42174":119315,"_29767":190703,"_5":21387,"_28235":190603,"_5797":82274},[],{"_6892":119354,"_42174":119315,"_29767":190705,"_5":21387,"_28235":190603,"_5797":190706},[],"1 hora.",{"_6892":119355,"_42174":119315,"_29767":190708,"_5":21387,"_28235":190603,"_5797":82280},[],{"_6892":119356,"_42174":119315,"_29767":190710,"_5":21387,"_28235":190603,"_5797":190711},[],"30 minutos / 10 minutos.",{"_6892":119357,"_42174":119315,"_29767":190713,"_5":21387,"_28235":190603,"_5797":82286},[],{"_6892":119358,"_42174":119315,"_29767":190715,"_5":21387,"_28235":190603,"_5797":190716},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_6892":119359,"_42174":119315,"_29767":190718,"_5":21387,"_28235":190603,"_5797":80024},[],{"_6892":119360,"_42174":119315,"_29767":190720,"_5":21387,"_28235":190603,"_5797":190721},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_6892":119361,"_42174":119315,"_29767":190723,"_5":21387,"_28235":190603,"_5797":82297},[],{"_6892":119362,"_42174":119315,"_29767":190725,"_5":21387,"_28235":190603,"_5797":190726},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_6892":119363,"_42174":119315,"_29767":190728,"_5":21387,"_28235":190603,"_5797":190729},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_6892":119364,"_42174":119315,"_29767":190731,"_5":21387,"_28235":190607,"_5797":190732},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_6892":119365,"_42174":119315,"_29767":190734,"_5":21387,"_28235":190607,"_5797":190735},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_6892":119366,"_42174":119315,"_29767":190737,"_5":21387,"_28235":190611,"_5797":190738},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_6892":119367,"_42174":119315,"_29767":190740,"_5":21387,"_28235":190611,"_5797":190741},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_6892":119368,"_42174":119315,"_29767":190743,"_5":21387,"_28235":190611,"_5797":190744},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_6892":119369,"_42174":119315,"_29767":190746,"_5":21387,"_28235":190615,"_5797":190747},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_6892":119370,"_42174":119315,"_29767":190749,"_5":21387,"_28235":190615,"_5797":190750},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_6892":119371,"_42174":119315,"_29767":190752,"_5":21387,"_28235":190619,"_5797":190753},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_6892":119372,"_42174":119315,"_29767":190755,"_5":21387,"_28235":190619,"_5797":190756},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_6892":119373,"_42174":119315,"_29767":190758,"_5":21387,"_28235":190619,"_5797":190759},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_6892":119374,"_42174":119315,"_29767":190761,"_5":21387,"_28235":190619,"_5797":190762},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_6892":119375,"_42174":119315,"_29767":190764,"_5":21387,"_28235":190619,"_5797":190765},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_6892":119376,"_42174":119315,"_29767":190767,"_5":21387,"_28235":190623,"_5797":190768},[],"Comprobación",{"_6892":119377,"_42174":119315,"_29767":190770,"_5":21387,"_28235":190623,"_5797":190771},[],"Resultado esperado",{"_6892":119378,"_42174":119315,"_29767":190773,"_5":21387,"_28235":190623,"_5797":190774},[],"Registro",{"_6892":119379,"_42174":119315,"_29767":190776,"_5":21387,"_28235":190623,"_5797":190777},[],"ID creado automáticamente y DMS correcto.",{"_6892":119380,"_42174":119315,"_29767":190779,"_5":21387,"_28235":190623,"_5797":190048},[],{"_6892":119381,"_42174":119315,"_29767":190781,"_5":21387,"_28235":190623,"_5797":190782},[],"CN, perfil, serie y clave verificados.",{"_6892":119382,"_42174":119315,"_29767":190784,"_5":21387,"_28235":190623,"_5797":190785},[],"Inventario",{"_6892":119383,"_42174":119315,"_29767":190787,"_5":21387,"_28235":190623,"_5797":190788},[],"Serie recibida visible como identidad actual y en el historial.",{"_6892":119384,"_42174":119315,"_29767":190790,"_5":21387,"_28235":190623,"_5797":190791},[],"Consumidor",{"_6892":119385,"_42174":119315,"_29767":190793,"_5":21387,"_28235":190623,"_5797":190794},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_6892":119386,"_42174":119315,"_29767":190796,"_5":21387,"_28235":190623,"_5797":190797},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_6892":119387,"_42174":119315,"_29767":190799,"_5":21387,"_28235":190623,"_5797":190800},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_6892":119388,"_42174":119388,"_5":21817,"_5797":188270,"_42654":190802,"_29767":190803,"_28235":119388},[77248,187247,79705,190589],[],{"_6892":119389,"_42174":119388,"_29767":190805,"_5":21387,"_28235":119388,"_5797":190806},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_6892":119390,"_42174":119388,"_5":42651,"_29767":190808,"_28235":190809,"_5797":185844},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_6892":119391,"_42174":119388,"_5":42651,"_29767":190811,"_28235":190812,"_5797":190813},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_6892":119392,"_42174":119388,"_5":42651,"_29767":190815,"_28235":190816,"_5797":190817},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_6892":119393,"_42174":119388,"_5":42651,"_29767":190819,"_28235":190820,"_5797":190821},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_6892":119394,"_42174":119388,"_5":42651,"_29767":190823,"_28235":190824,"_5797":190825},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_6892":119395,"_42174":119388,"_5":42651,"_29767":190827,"_28235":190828,"_5797":190829},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_6892":119396,"_42174":119388,"_5":42651,"_29767":190831,"_28235":190832,"_5797":190771},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_6892":119397,"_42174":119388,"_5":42651,"_29767":190834,"_28235":190835,"_5797":190836},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_6892":119398,"_42174":119388,"_5":42651,"_29767":190838,"_28235":190839,"_5797":190840},[],"/docs/pr-preview/pr-56/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_6892":119399,"_42174":119388,"_29767":190842,"_5":21387,"_28235":119388,"_5797":190843},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_6892":119400,"_42174":119388,"_29767":190845,"_5":21387,"_28235":119388,"_5797":190846},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_6892":119401,"_42174":119388,"_29767":190848,"_5":21387,"_28235":190809,"_5797":190849},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_6892":119402,"_42174":119388,"_29767":190851,"_5":21387,"_28235":190809,"_5797":190852},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_6892":119403,"_42174":119388,"_29767":190854,"_5":21387,"_28235":190809,"_5797":190855},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_6892":119404,"_42174":119388,"_29767":190857,"_5":21387,"_28235":190809,"_5797":190858},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_6892":119405,"_42174":119388,"_29767":190860,"_5":21387,"_28235":190812,"_5797":190861},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_6892":119406,"_42174":119388,"_29767":190863,"_5":21387,"_28235":190812,"_5797":190864},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_6892":119407,"_42174":119388,"_29767":190866,"_5":21387,"_28235":190812,"_5797":190867},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_6892":119408,"_42174":119388,"_29767":190869,"_5":21387,"_28235":190812,"_5797":190870},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_6892":119409,"_42174":119388,"_29767":190872,"_5":21387,"_28235":190812,"_5797":190873},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_6892":119410,"_42174":119388,"_29767":190875,"_5":21387,"_28235":190812,"_5797":190876},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_6892":119411,"_42174":119388,"_29767":190878,"_5":21387,"_28235":190812,"_5797":190879},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_6892":119412,"_42174":119388,"_29767":190881,"_5":21387,"_28235":190812,"_5797":190882},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_6892":119413,"_42174":119388,"_29767":190884,"_5":21387,"_28235":190816,"_5797":190885},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_6892":119414,"_42174":119388,"_29767":190887,"_5":21387,"_28235":190816,"_5797":82462},[],{"_6892":119415,"_42174":119388,"_29767":190889,"_5":21387,"_28235":190816,"_5797":190890},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_6892":119416,"_42174":119388,"_29767":190892,"_5":21387,"_28235":190816,"_5797":190893},[],"**Icon** y **Tags**: clasificación opcional.",{"_6892":119417,"_42174":119388,"_29767":190895,"_5":21387,"_28235":190816,"_5797":190896},[],"Confirma el registro.",{"_6892":119418,"_42174":119388,"_29767":190898,"_5":21387,"_28235":190820,"_5797":190899},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_6892":119419,"_42174":119388,"_29767":190901,"_5":21387,"_28235":190820,"_5797":190902},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_6892":119420,"_42174":119388,"_29767":190904,"_5":21387,"_28235":190824,"_5797":190905},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_6892":119421,"_42174":119388,"_29767":190907,"_5":21387,"_28235":190824,"_5797":190908},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_6892":119422,"_42174":119388,"_29767":190910,"_5":21387,"_28235":190828,"_5797":190911},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_6892":119423,"_42174":119388,"_29767":190913,"_5":21387,"_28235":190828,"_5797":190914},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_6892":119424,"_42174":119388,"_29767":190916,"_5":21387,"_28235":190832,"_5797":190768},[],{"_6892":119425,"_42174":119388,"_29767":190918,"_5":21387,"_28235":190832,"_5797":190919},[],"Resultado",{"_6892":119426,"_42174":119388,"_29767":190921,"_5":21387,"_28235":190832,"_5797":190034},[],{"_6892":119427,"_42174":119388,"_29767":190923,"_5":21387,"_28235":190832,"_5797":190924},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_6892":119428,"_42174":119388,"_29767":190926,"_5":21387,"_28235":190832,"_5797":190927},[],"Identidad actual",{"_6892":119429,"_42174":119388,"_29767":190929,"_5":21387,"_28235":190832,"_5797":190930},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_6892":119430,"_42174":119388,"_29767":190932,"_5":21387,"_28235":190832,"_5797":190933},[],"Historial",{"_6892":119431,"_42174":119388,"_29767":190935,"_5":21387,"_28235":190832,"_5797":190936},[],"La emisión asociada aparece con su número de serie y fechas.",{"_6892":119432,"_42174":119388,"_29767":190938,"_5":21387,"_28235":190832,"_5797":190939},[],"Clave y certificado",{"_6892":119433,"_42174":119388,"_29767":190941,"_5":21387,"_28235":190832,"_5797":190942},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_6892":119434,"_42174":119388,"_29767":190944,"_5":21387,"_28235":190835,"_5797":190945},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_6892":119435,"_42174":119388,"_29767":190947,"_5":21387,"_28235":190835,"_5797":190948},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_6892":119436,"_42174":119388,"_29767":190950,"_5":21387,"_28235":190835,"_5797":190951},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_6892":119437,"_42174":119388,"_29767":190953,"_5":21387,"_28235":190835,"_5797":190954},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_6892":119438,"_42174":119388,"_29767":190956,"_5":21387,"_28235":190839,"_5797":190957},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_6892":119439,"_42174":119388,"_29767":190959,"_5":21387,"_28235":190839,"_5797":190960},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_6892":119440,"_42174":119388,"_29767":190962,"_5":21387,"_28235":190839,"_5797":190963},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_6892":119441,"_42174":119441,"_5":21817,"_5797":190965,"_42654":190966,"_29767":190967,"_28235":119441},"Plataforma Lamassu IoT",[77248,187247],[],{"_6892":119442,"_42174":119441,"_29767":190969,"_5":21387,"_28235":119441,"_5797":190970},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_6892":119443,"_42174":119441,"_5":42651,"_29767":190972,"_28235":190973,"_5797":190452},[],"/docs/pr-preview/pr-56/es/platform/overview#empieza-aquí",{"_6892":119444,"_42174":119441,"_5":42651,"_29767":190975,"_28235":190976,"_5797":190977},[],"/docs/pr-preview/pr-56/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_6892":119445,"_42174":119441,"_5":42651,"_29767":190979,"_28235":190980,"_5797":190981},[],"/docs/pr-preview/pr-56/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_6892":119446,"_42174":119441,"_5":42651,"_29767":190983,"_28235":190984,"_5797":190985},[],"/docs/pr-preview/pr-56/es/platform/overview#capacidades-principales","Capacidades principales",{"_6892":119447,"_42174":119441,"_5":42651,"_29767":190987,"_28235":190988,"_5797":190989},[],"/docs/pr-preview/pr-56/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_6892":119448,"_42174":119441,"_5":42651,"_29767":190991,"_28235":190992,"_5797":190993},[],"/docs/pr-preview/pr-56/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_6892":119449,"_42174":119441,"_5":42651,"_29767":190995,"_28235":190996,"_5797":190997},[],"/docs/pr-preview/pr-56/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_6892":119450,"_42174":119441,"_5":42651,"_29767":190999,"_28235":191000,"_5797":191001},[],"/docs/pr-preview/pr-56/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_6892":119451,"_42174":119441,"_5":42651,"_29767":191003,"_28235":191004,"_5797":191005},[],"/docs/pr-preview/pr-56/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_6892":119452,"_42174":119441,"_5":42651,"_29767":191007,"_28235":191008,"_5797":191009},[],"/docs/pr-preview/pr-56/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_6892":119453,"_42174":119441,"_5":42651,"_29767":191011,"_28235":191012,"_5797":191013},[],"/docs/pr-preview/pr-56/es/platform/overview#referencia-operativa","Referencia operativa",{"_6892":119454,"_42174":119441,"_29767":191015,"_5":21387,"_28235":119441,"_5797":191016},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_6892":119455,"_42174":119441,"_29767":191018,"_5":21387,"_28235":190973,"_5797":191019},[],"Elige el resultado que necesitas obtener:",{"_6892":119456,"_42174":119441,"_29767":191021,"_5":21387,"_28235":190973,"_5797":191022},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_6892":119457,"_42174":119441,"_29767":191024,"_5":21387,"_28235":190973,"_5797":191025},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_6892":119458,"_42174":119441,"_29767":191027,"_5":21387,"_28235":190973,"_5797":191028},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_6892":119459,"_42174":119441,"_29767":191030,"_5":21387,"_28235":190976,"_5797":191031},[],"Bloque",{"_6892":119460,"_42174":119441,"_29767":191033,"_5":21387,"_28235":190976,"_5797":191034},[],"Qué gestionas",{"_6892":119461,"_42174":119441,"_29767":191036,"_5":21387,"_28235":190976,"_5797":191037},[],"Punto de entrada",{"_6892":119462,"_42174":119441,"_29767":191039,"_5":21387,"_28235":190976,"_5797":82615},[],{"_6892":119463,"_42174":119441,"_29767":191041,"_5":21387,"_28235":190976,"_5797":191042},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_6892":119464,"_42174":119441,"_29767":191044,"_5":21387,"_28235":190976,"_5797":191045},[],"Visión general de PKI",{"_6892":119465,"_42174":119441,"_29767":191047,"_5":21387,"_28235":190976,"_5797":82624},[],{"_6892":119466,"_42174":119441,"_29767":191049,"_5":21387,"_28235":190976,"_5797":191050},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_6892":119467,"_42174":119441,"_29767":191052,"_5":21387,"_28235":190976,"_5797":191053},[],"Visión general de IoT Fleets",{"_6892":119468,"_42174":119441,"_29767":191055,"_5":21387,"_28235":190976,"_5797":191056},[],"**Administración**",{"_6892":119469,"_42174":119441,"_29767":191058,"_5":21387,"_28235":190976,"_5797":191059},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_6892":119470,"_42174":119441,"_29767":191061,"_5":21387,"_28235":190976,"_5797":187245},[],{"_6892":119471,"_42174":119441,"_29767":191063,"_5":21387,"_28235":190976,"_5797":191064},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_6892":119472,"_42174":119441,"_29767":191066,"_5":21387,"_28235":190980,"_5797":191067},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_6892":119473,"_42174":119441,"_29767":191069,"_5":21387,"_28235":190980,"_5797":191070},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_6892":119474,"_42174":119441,"_29767":191072,"_5":21387,"_28235":190980,"_5797":191073},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_6892":119475,"_42174":119441,"_29767":191075,"_5":21387,"_28235":190980,"_5797":191076},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_6892":119476,"_42174":119441,"_29767":191078,"_5":21387,"_28235":190980,"_5797":191079},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_6892":119477,"_42174":119441,"_29767":191081,"_5":21387,"_28235":190980,"_5797":191082},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_6892":119478,"_42174":119441,"_29767":191084,"_5":21387,"_28235":190988,"_5797":191085},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_6892":119479,"_42174":119441,"_29767":191087,"_5":21387,"_28235":190992,"_5797":191088},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_6892":119480,"_42174":119441,"_29767":191090,"_5":21387,"_28235":190996,"_5797":191091},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_6892":119481,"_42174":119441,"_29767":191093,"_5":21387,"_28235":191000,"_5797":191094},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_6892":119482,"_42174":119441,"_29767":191096,"_5":21387,"_28235":191004,"_5797":191097},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_6892":119483,"_42174":119441,"_29767":191099,"_5":21387,"_28235":191008,"_5797":191100},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_6892":119484,"_42174":119441,"_29767":191102,"_5":21387,"_28235":191012,"_5797":190558},[],{"_6892":119485,"_42174":119441,"_29767":191104,"_5":21387,"_28235":191012,"_5797":191105},[],"Qué prepara o comprueba",{"_6892":119486,"_42174":119441,"_29767":191107,"_5":21387,"_28235":191012,"_5797":190561},[],{"_6892":119487,"_42174":119441,"_29767":191109,"_5":21387,"_28235":191012,"_5797":191110},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_6892":119488,"_42174":119441,"_29767":191112,"_5":21387,"_28235":191012,"_5797":191113},[],"Administrador de la flota",{"_6892":119489,"_42174":119441,"_29767":191115,"_5":21387,"_28235":191012,"_5797":191116},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_6892":119490,"_42174":119441,"_29767":191118,"_5":21387,"_28235":191012,"_5797":190573},[],{"_6892":119491,"_42174":119441,"_29767":191120,"_5":21387,"_28235":191012,"_5797":191121},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_6892":119492,"_42174":119441,"_29767":191123,"_5":21387,"_28235":191012,"_5797":190579},[],{"_6892":119493,"_42174":119441,"_29767":191125,"_5":21387,"_28235":191012,"_5797":191126},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_6892":119494,"_42174":119441,"_29767":191128,"_5":21387,"_28235":191012,"_5797":191129},[],"Operador de infraestructura",{"_6892":119495,"_42174":119441,"_29767":191131,"_5":21387,"_28235":191012,"_5797":191132},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_6892":119496,"_42174":119441,"_29767":191134,"_5":21387,"_28235":191012,"_5797":191135},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_6892":119497,"_42174":119497,"_5":21817,"_5797":191137,"_42654":191138,"_29767":191140,"_28235":119497},"Jerarquía y rotación de CAs",[77248,187247,82716,191139],"Claves, autoridades y certificados",[],{"_6892":119498,"_42174":119497,"_29767":191142,"_5":21387,"_28235":119497,"_5797":191143},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_6892":119499,"_42174":119497,"_5":42651,"_29767":191145,"_28235":191146,"_5797":191147},[],"/docs/pr-preview/pr-56/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_6892":119500,"_42174":119497,"_5":42651,"_29767":191149,"_28235":191150,"_5797":191151},[],"/docs/pr-preview/pr-56/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_6892":119501,"_42174":119497,"_5":42651,"_29767":191153,"_28235":191154,"_5797":191155},[],"/docs/pr-preview/pr-56/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_6892":119502,"_42174":119497,"_5":42651,"_29767":191157,"_28235":191158,"_5797":191159},[],"/docs/pr-preview/pr-56/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_6892":119503,"_42174":119497,"_5":42651,"_29767":191161,"_28235":191162,"_5797":191163},[],"/docs/pr-preview/pr-56/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_6892":119504,"_42174":119497,"_5":42651,"_29767":191165,"_28235":191166,"_5797":191167},[],"/docs/pr-preview/pr-56/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_6892":119505,"_42174":119497,"_5":42651,"_29767":191169,"_28235":191170,"_5797":191171},[],"/docs/pr-preview/pr-56/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_6892":119506,"_42174":119497,"_5":42651,"_29767":191173,"_28235":191174,"_5797":191175},[],"/docs/pr-preview/pr-56/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_6892":119507,"_42174":119497,"_5":42651,"_29767":191177,"_28235":191178,"_5797":191179},[],"/docs/pr-preview/pr-56/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_6892":119508,"_42174":119497,"_5":42651,"_29767":191181,"_28235":191182,"_5797":191183},[],"/docs/pr-preview/pr-56/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_6892":119509,"_42174":119497,"_5":42651,"_29767":191185,"_28235":191186,"_5797":191187},[],"/docs/pr-preview/pr-56/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_6892":119510,"_42174":119497,"_5":42651,"_29767":191189,"_28235":191190,"_5797":191191},[],"/docs/pr-preview/pr-56/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_6892":119511,"_42174":119497,"_29767":191193,"_5":21387,"_28235":119497,"_5797":191194},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_6892":119512,"_42174":119497,"_29767":191196,"_5":21387,"_28235":119497,"_5797":191197},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_6892":119513,"_42174":119497,"_29767":191199,"_5":21387,"_28235":191146,"_5797":191200},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_6892":119514,"_42174":119497,"_29767":191202,"_5":21387,"_28235":191146,"_5797":191203},[],"entorno, como producción y preproducción;",{"_6892":119515,"_42174":119497,"_29767":191205,"_5":21387,"_28235":191146,"_5797":191206},[],"propietario o equipo operador;",{"_6892":119516,"_42174":119497,"_29767":191208,"_5":21387,"_28235":191146,"_5797":191209},[],"familia de dispositivos o proceso de fabricación;",{"_6892":119517,"_42174":119497,"_29767":191211,"_5":21387,"_28235":191146,"_5797":191212},[],"región o requisito regulatorio;",{"_6892":119518,"_42174":119497,"_29767":191214,"_5":21387,"_28235":191146,"_5797":191215},[],"motor criptográfico o política de clave;",{"_6892":119519,"_42174":119497,"_29767":191217,"_5":21387,"_28235":191146,"_5797":191218},[],"ventana de mantenimiento y ritmo de renovación.",{"_6892":119520,"_42174":119497,"_29767":191220,"_5":21387,"_28235":191146,"_5797":191221},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_6892":119521,"_42174":119497,"_29767":191223,"_5":21387,"_28235":191146,"_5797":191224},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_6892":119522,"_42174":119497,"_29767":191226,"_5":21387,"_28235":191150,"_5797":191227},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_6892":119523,"_42174":119497,"_29767":191229,"_5":21387,"_28235":191150,"_5797":191230},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_6892":119524,"_42174":119497,"_29767":191232,"_5":21387,"_28235":191150,"_5797":191233},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_6892":119525,"_42174":119497,"_29767":191235,"_5":21387,"_28235":191154,"_5797":191236},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_6892":119526,"_42174":119497,"_29767":191238,"_5":21387,"_28235":191154,"_5797":191239},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_6892":119527,"_42174":119497,"_29767":191241,"_5":21387,"_28235":191154,"_5797":191242},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_6892":119528,"_42174":119497,"_29767":191244,"_5":21387,"_28235":191154,"_5797":191245},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_6892":119529,"_42174":119497,"_29767":191247,"_5":21387,"_28235":191162,"_5797":191248},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_6892":119530,"_42174":119497,"_29767":191250,"_5":21387,"_28235":191166,"_5797":191251},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_6892":119531,"_42174":119497,"_29767":191253,"_5":21387,"_28235":191170,"_5797":191254},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_6892":119532,"_42174":119497,"_29767":191256,"_5":21387,"_28235":191174,"_5797":191257},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_6892":119533,"_42174":119497,"_29767":191259,"_5":21387,"_28235":191178,"_5797":191260},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_6892":119534,"_42174":119497,"_29767":191262,"_5":21387,"_28235":191182,"_5797":191263},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_6892":119535,"_42174":119497,"_29767":191265,"_5":21387,"_28235":191186,"_5797":191266},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_6892":119536,"_42174":119497,"_29767":191268,"_5":21387,"_28235":191186,"_5797":191269},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_6892":119537,"_42174":119497,"_29767":191271,"_5":21387,"_28235":191186,"_5797":191272},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_6892":119538,"_42174":119497,"_29767":191274,"_5":21387,"_28235":191186,"_5797":191275},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_6892":119539,"_42174":119497,"_29767":191277,"_5":21387,"_28235":191190,"_5797":191278},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_6892":119540,"_42174":119497,"_29767":191280,"_5":21387,"_28235":191190,"_5797":191281},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_6892":119541,"_42174":119497,"_29767":191283,"_5":21387,"_28235":191190,"_5797":191284},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_6892":119542,"_42174":119497,"_29767":191286,"_5":21387,"_28235":191190,"_5797":191287},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_6892":119543,"_42174":119497,"_29767":191289,"_5":21387,"_28235":191190,"_5797":191290},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_6892":119544,"_42174":119497,"_29767":191292,"_5":21387,"_28235":191190,"_5797":191293},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_6892":119545,"_42174":119497,"_29767":191295,"_5":21387,"_28235":191190,"_5797":191296},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_6892":119546,"_42174":119546,"_5":21817,"_5797":191298,"_42654":191299,"_29767":191300,"_28235":119546},"Autoridades de certificación",[77248,187247,82716,191139],[],{"_6892":119547,"_42174":119546,"_29767":191302,"_5":21387,"_28235":119546,"_5797":191303},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_6892":119548,"_42174":119546,"_5":42651,"_29767":191305,"_28235":191306,"_5797":191307},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_6892":119549,"_42174":119546,"_5":42651,"_29767":191309,"_28235":191310,"_5797":191311},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_6892":119550,"_42174":119546,"_5":42651,"_29767":191313,"_28235":191314,"_5797":185844},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#antes-de-empezar",{"_6892":119551,"_42174":119546,"_5":42651,"_29767":191316,"_28235":191317,"_5797":191318},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_6892":119552,"_42174":119546,"_5":42651,"_29767":191320,"_28235":191321,"_5797":191322},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_6892":119553,"_42174":119546,"_5":42651,"_29767":191324,"_28235":191325,"_5797":191326},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_6892":119554,"_42174":119546,"_5":42651,"_29767":191328,"_28235":191329,"_5797":191330},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_6892":119555,"_42174":119546,"_5":42651,"_29767":191332,"_28235":191333,"_5797":191334},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_6892":119556,"_42174":119546,"_5":42651,"_29767":191336,"_28235":191337,"_5797":191338},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_6892":119557,"_42174":119546,"_5":42651,"_29767":191340,"_28235":191341,"_5797":191342},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_6892":119558,"_42174":119546,"_5":42651,"_29767":191344,"_28235":191345,"_5797":191346},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_6892":119559,"_42174":119546,"_5":42651,"_29767":191348,"_28235":191349,"_5797":191350},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_6892":119560,"_42174":119546,"_5":42651,"_29767":191352,"_28235":191353,"_5797":191354},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_6892":119561,"_42174":119546,"_5":42651,"_29767":191356,"_28235":191357,"_5797":191358},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_6892":119562,"_42174":119546,"_5":42651,"_29767":191360,"_28235":191361,"_5797":191362},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_6892":119563,"_42174":119546,"_5":42651,"_29767":191364,"_28235":191365,"_5797":191366},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_6892":119564,"_42174":119546,"_5":42651,"_29767":191368,"_28235":191369,"_5797":191370},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_6892":119565,"_42174":119546,"_5":42651,"_29767":191372,"_28235":191373,"_5797":191374},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_6892":119566,"_42174":119546,"_5":42651,"_29767":191376,"_28235":191377,"_5797":191378},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_6892":119567,"_42174":119546,"_5":42651,"_29767":191380,"_28235":191381,"_5797":191382},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_6892":119568,"_42174":119546,"_5":42651,"_29767":191384,"_28235":191385,"_5797":191386},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_6892":119569,"_42174":119546,"_5":42651,"_29767":191388,"_28235":191389,"_5797":191390},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_6892":119570,"_42174":119546,"_5":42651,"_29767":191392,"_28235":191393,"_5797":191394},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_6892":119571,"_42174":119546,"_29767":191396,"_5":21387,"_28235":119546,"_5797":191397},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_6892":119572,"_42174":119546,"_29767":191399,"_5":21387,"_28235":119546,"_5797":191400},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_6892":119573,"_42174":119546,"_29767":191402,"_5":21387,"_28235":119546,"_5797":191403},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_6892":119574,"_42174":119546,"_29767":191405,"_5":21387,"_28235":191306,"_5797":191406},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_6892":119575,"_42174":119546,"_29767":191408,"_5":21387,"_28235":191306,"_5797":191409},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_6892":119576,"_42174":119546,"_29767":191411,"_5":21387,"_28235":191306,"_5797":191412},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_6892":119577,"_42174":119546,"_29767":191414,"_5":21387,"_28235":191306,"_5797":191415},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_6892":119578,"_42174":119546,"_29767":191417,"_5":21387,"_28235":191306,"_5797":191418},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_6892":119579,"_42174":119546,"_29767":191420,"_5":21387,"_28235":191314,"_5797":191421},[],"Decide si la CA será raíz o intermedia.",{"_6892":119580,"_42174":119546,"_29767":191423,"_5":21387,"_28235":191314,"_5797":191424},[],"Elige el motor que custodiará la clave.",{"_6892":119581,"_42174":119546,"_29767":191426,"_5":21387,"_28235":191314,"_5797":191427},[],"Define una validez superior a la de los certificados que emitirá.",{"_6892":119582,"_42174":119546,"_29767":191429,"_5":21387,"_28235":191314,"_5797":191430},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_6892":119583,"_42174":119546,"_29767":191432,"_5":21387,"_28235":191317,"_5797":191433},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_6892":119584,"_42174":119546,"_29767":191435,"_5":21387,"_28235":191321,"_5797":191436},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_6892":119585,"_42174":119546,"_29767":191438,"_5":21387,"_28235":191321,"_5797":191439},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_6892":119586,"_42174":119546,"_29767":191441,"_5":21387,"_28235":191325,"_5797":191442},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_6892":119587,"_42174":119546,"_29767":191444,"_5":21387,"_28235":191329,"_5797":191445},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_6892":119588,"_42174":119546,"_29767":191447,"_5":21387,"_28235":191329,"_5797":191448},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_6892":119589,"_42174":119546,"_29767":191450,"_5":21387,"_28235":191329,"_5797":191451},[],"`ST`: estado o provincia.",{"_6892":119590,"_42174":119546,"_29767":191453,"_5":21387,"_28235":191329,"_5797":191454},[],"`L`: localidad.",{"_6892":119591,"_42174":119546,"_29767":191456,"_5":21387,"_28235":191329,"_5797":191457},[],"`O`: organización.",{"_6892":119592,"_42174":119546,"_29767":191459,"_5":21387,"_28235":191329,"_5797":191460},[],"`OU`: unidad organizativa.",{"_6892":119593,"_42174":119546,"_29767":191462,"_5":21387,"_28235":191329,"_5797":191463},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_6892":119594,"_42174":119546,"_29767":191465,"_5":21387,"_28235":191333,"_5797":191466},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_6892":119595,"_42174":119546,"_29767":191468,"_5":21387,"_28235":191333,"_5797":191469},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_6892":119596,"_42174":119546,"_29767":191471,"_5":21387,"_28235":191337,"_5797":191472},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_6892":119597,"_42174":119546,"_29767":191474,"_5":21387,"_28235":191337,"_5797":191475},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_6892":119598,"_42174":119546,"_29767":191477,"_5":21387,"_28235":191341,"_5797":191478},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_6892":119599,"_42174":119546,"_29767":191480,"_5":21387,"_28235":191341,"_5797":191481},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_6892":119600,"_42174":119546,"_29767":191483,"_5":21387,"_28235":191345,"_5797":191484},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_6892":119601,"_42174":119546,"_29767":191486,"_5":21387,"_28235":191349,"_5797":191487},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_6892":119602,"_42174":119546,"_29767":191489,"_5":21387,"_28235":191353,"_5797":191490},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_6892":119603,"_42174":119546,"_29767":191492,"_5":21387,"_28235":191357,"_5797":191493},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_6892":119604,"_42174":119546,"_29767":191495,"_5":21387,"_28235":191361,"_5797":191496},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_6892":119605,"_42174":119546,"_29767":191498,"_5":21387,"_28235":191361,"_5797":191499},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_6892":119606,"_42174":119546,"_29767":191501,"_5":21387,"_28235":191365,"_5797":191502},[],"Abre una CA desde el inventario para consultar:",{"_6892":119607,"_42174":119546,"_29767":191504,"_5":21387,"_28235":191365,"_5797":191505},[],"Estado y periodo de validez.",{"_6892":119608,"_42174":119546,"_29767":191507,"_5":21387,"_28235":191365,"_5797":191508},[],"Certificado y cadena en formato PEM.",{"_6892":119609,"_42174":119546,"_29767":191510,"_5":21387,"_28235":191365,"_5797":191511},[],"Número de certificados activos, expirados y revocados.",{"_6892":119610,"_42174":119546,"_29767":191513,"_5":21387,"_28235":191365,"_5797":191514},[],"Certificados emitidos en **Issued Certificates**.",{"_6892":119611,"_42174":119546,"_29767":191516,"_5":21387,"_28235":191365,"_5797":191517},[],"CRL vinculada a la autoridad.",{"_6892":119612,"_42174":119546,"_29767":191519,"_5":21387,"_28235":191365,"_5797":191520},[],"Metadatos y motor criptográfico asociado.",{"_6892":119613,"_42174":119546,"_29767":191522,"_5":21387,"_28235":191365,"_5797":191523},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_6892":119614,"_42174":119546,"_29767":191525,"_5":21387,"_28235":191369,"_5797":191526},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_6892":119615,"_42174":119546,"_29767":191528,"_5":21387,"_28235":191369,"_5797":191529},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_6892":119616,"_42174":119546,"_29767":191531,"_5":21387,"_28235":191369,"_5797":191532},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_6892":119617,"_42174":119546,"_29767":191534,"_5":21387,"_28235":191369,"_5797":191535},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_6892":119618,"_42174":119546,"_29767":191537,"_5":21387,"_28235":191373,"_5797":191538},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_6892":119619,"_42174":119546,"_29767":191540,"_5":21387,"_28235":191377,"_5797":191541},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_6892":119620,"_42174":119546,"_29767":191543,"_5":21387,"_28235":191381,"_5797":191544},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_6892":119621,"_42174":119546,"_29767":191546,"_5":21387,"_28235":191385,"_5797":191547},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_6892":119622,"_42174":119546,"_29767":191549,"_5":21387,"_28235":191389,"_5797":191550},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_6892":119623,"_42174":119546,"_29767":191552,"_5":21387,"_28235":191393,"_5797":191553},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_6892":119624,"_42174":119546,"_29767":191555,"_5":21387,"_28235":191393,"_5797":191556},[],"El rol VA de la CA se conserva. Si no queda otra CA con el mismo SKI, deja de ser editable (consulta CRL), así que ajusta antes su validez y su firmante. La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_6892":119625,"_42174":119546,"_29767":191558,"_5":21387,"_28235":191393,"_5797":191559},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. Si el certificado nuevo usa la misma clave, comparte el SKI con el rol VA retenido de la CA eliminada, cuyo firmante es el certificado antiguo: comprueba que la CRL se genera y, si no es así, asigna con `PUT` un firmante de la CA nueva (consulta CRL).",{"_6892":119626,"_42174":119626,"_5":21817,"_5797":191561,"_42654":191562,"_29767":191563,"_28235":119626},"Perfiles de certificado",[77248,187247,82716,191139],[],{"_6892":119627,"_42174":119626,"_29767":191565,"_5":21387,"_28235":119626,"_5797":191566},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_6892":119628,"_42174":119626,"_5":42651,"_29767":191568,"_28235":191569,"_5797":191570},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_6892":119629,"_42174":119626,"_5":42651,"_29767":191572,"_28235":191573,"_5797":191574},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#validez","Validez",{"_6892":119630,"_42174":119626,"_5":42651,"_29767":191576,"_28235":191577,"_5797":191578},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_6892":119631,"_42174":119626,"_5":42651,"_29767":191580,"_28235":191581,"_5797":191582},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_6892":119632,"_42174":119626,"_5":42651,"_29767":191584,"_28235":191585,"_5797":191586},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_6892":119633,"_42174":119626,"_5":42651,"_29767":191588,"_28235":191589,"_5797":191590},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_6892":119634,"_42174":119626,"_5":42651,"_29767":191592,"_28235":191593,"_5797":191594},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_6892":119635,"_42174":119626,"_5":42651,"_29767":191596,"_28235":191597,"_5797":191598},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_6892":119636,"_42174":119626,"_5":42651,"_29767":191600,"_28235":191601,"_5797":191602},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_6892":119637,"_42174":119626,"_5":42651,"_29767":191604,"_28235":191605,"_5797":191606},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_6892":119638,"_42174":119626,"_5":42651,"_29767":191608,"_28235":191609,"_5797":191610},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_6892":119639,"_42174":119626,"_5":42651,"_29767":191612,"_28235":191613,"_5797":191614},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_6892":119640,"_42174":119626,"_5":42651,"_29767":191616,"_28235":191617,"_5797":191618},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_6892":119641,"_42174":119626,"_5":42651,"_29767":191620,"_28235":191621,"_5797":191622},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_6892":119642,"_42174":119626,"_5":42651,"_29767":191624,"_28235":191625,"_5797":191626},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_6892":119643,"_42174":119626,"_5":42651,"_29767":191628,"_28235":191629,"_5797":191630},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_6892":119644,"_42174":119626,"_29767":191632,"_5":21387,"_28235":119626,"_5797":191633},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_6892":119645,"_42174":119626,"_29767":191635,"_5":21387,"_28235":119626,"_5797":191636},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_6892":119646,"_42174":119626,"_29767":191638,"_5":21387,"_28235":191573,"_5797":191639},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_6892":119647,"_42174":119626,"_29767":191641,"_5":21387,"_28235":191573,"_5797":191642},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_6892":119648,"_42174":119626,"_29767":191644,"_5":21387,"_28235":191577,"_5797":191645},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_6892":119649,"_42174":119626,"_29767":191647,"_5":21387,"_28235":191581,"_5797":191648},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_6892":119650,"_42174":119626,"_29767":191650,"_5":21387,"_28235":191581,"_5797":191651},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_6892":119651,"_42174":119626,"_29767":191653,"_5":21387,"_28235":191581,"_5797":191654},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_6892":119652,"_42174":119626,"_29767":191656,"_5":21387,"_28235":191585,"_5797":191657},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_6892":119653,"_42174":119626,"_29767":191659,"_5":21387,"_28235":191589,"_5797":191660},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_6892":119654,"_42174":119626,"_29767":191662,"_5":21387,"_28235":191589,"_5797":191663},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_6892":119655,"_42174":119626,"_29767":191665,"_5":21387,"_28235":191593,"_5797":191666},[],"La aplicación criptográfica puede:",{"_6892":119656,"_42174":119626,"_29767":191668,"_5":21387,"_28235":191593,"_5797":191669},[],"permitir o bloquear claves RSA;",{"_6892":119657,"_42174":119626,"_29767":191671,"_5":21387,"_28235":191593,"_5797":191672},[],"limitar los tamaños RSA admitidos;",{"_6892":119658,"_42174":119626,"_29767":191674,"_5":21387,"_28235":191593,"_5797":191675},[],"permitir o bloquear claves ECDSA;",{"_6892":119659,"_42174":119626,"_29767":191677,"_5":21387,"_28235":191593,"_5797":191678},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_6892":119660,"_42174":119626,"_29767":191680,"_5":21387,"_28235":191593,"_5797":191681},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_6892":119661,"_42174":119626,"_29767":191683,"_5":21387,"_28235":191597,"_5797":191684},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_6892":119662,"_42174":119626,"_29767":191686,"_5":21387,"_28235":191597,"_5797":187007},[],{"_6892":119663,"_42174":119626,"_29767":191688,"_5":21387,"_28235":191597,"_5797":191689},[],"Primera opción",{"_6892":119664,"_42174":119626,"_29767":191691,"_5":21387,"_28235":191597,"_5797":191692},[],"Segunda opción",{"_6892":119665,"_42174":119626,"_29767":191694,"_5":21387,"_28235":191597,"_5797":191695},[],"Si no hay ninguna",{"_6892":119666,"_42174":119626,"_29767":191697,"_5":21387,"_28235":191597,"_5797":191698},[],"Firma directa con una CA",{"_6892":119667,"_42174":119626,"_29767":191700,"_5":21387,"_28235":191597,"_5797":191701},[],"`issuance_profile` incluido en la solicitud",{"_6892":119668,"_42174":119626,"_29767":191703,"_5":21387,"_28235":191597,"_5797":191704},[],"`issuance_profile_id` de la solicitud",{"_6892":119669,"_42174":119626,"_29767":191706,"_5":21387,"_28235":191597,"_5797":191707},[],"Perfil predeterminado de la CA (`profile_id`).",{"_6892":119670,"_42174":119626,"_29767":191709,"_5":21387,"_28235":191597,"_5797":191710},[],"Emisión mediante DMS",{"_6892":119671,"_42174":119626,"_29767":191712,"_5":21387,"_28235":191597,"_5797":83291},[],{"_6892":119672,"_42174":119626,"_29767":191714,"_5":21387,"_28235":191597,"_5797":191715},[],"`settings.issuance_profile` incluido en el DMS",{"_6892":119673,"_42174":119626,"_29767":191717,"_5":21387,"_28235":191597,"_5797":191718},[],"Perfil predeterminado de la CA de enrolamiento.",{"_6892":119674,"_42174":119626,"_29767":191720,"_5":21387,"_28235":191597,"_5797":191721},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_6892":119675,"_42174":119626,"_29767":191723,"_5":21387,"_28235":191597,"_5797":191724},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_6892":119676,"_42174":119626,"_29767":191726,"_5":21387,"_28235":191605,"_5797":191727},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_6892":119677,"_42174":119626,"_29767":191729,"_5":21387,"_28235":191609,"_5797":191730},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_6892":119678,"_42174":119626,"_29767":191732,"_5":21387,"_28235":191613,"_5797":191733},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_6892":119679,"_42174":119626,"_29767":191735,"_5":21387,"_28235":191617,"_5797":191736},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_6892":119680,"_42174":119626,"_29767":191738,"_5":21387,"_28235":191621,"_5797":191739},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_6892":119681,"_42174":119626,"_29767":191741,"_5":21387,"_28235":191621,"_5797":191742},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_6892":119682,"_42174":119626,"_29767":191744,"_5":21387,"_28235":191625,"_5797":191745},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_6892":119683,"_42174":119626,"_29767":191747,"_5":21387,"_28235":191625,"_5797":191748},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_6892":119684,"_42174":119626,"_29767":191750,"_5":21387,"_28235":191625,"_5797":191751},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_6892":119685,"_42174":119626,"_29767":191753,"_5":21387,"_28235":191625,"_5797":191754},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_6892":119686,"_42174":119626,"_29767":191756,"_5":21387,"_28235":191629,"_5797":191757},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_6892":119687,"_42174":119626,"_29767":191759,"_5":21387,"_28235":191629,"_5797":191760},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_6892":119688,"_42174":119688,"_5":21817,"_5797":191762,"_42654":191763,"_29767":191765,"_28235":119688},"Validación de certificados",[77248,187247,82716,191764],"Validación",[],{"_6892":119689,"_42174":119688,"_29767":191767,"_5":21387,"_28235":119688,"_5797":191768},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_6892":119690,"_42174":119688,"_5":42651,"_29767":191770,"_28235":191771,"_5797":191772},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_6892":119691,"_42174":119688,"_5":42651,"_29767":191774,"_28235":191775,"_5797":191776},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_6892":119692,"_42174":119688,"_5":42651,"_29767":191778,"_28235":191779,"_5797":191780},[],"/docs/pr-preview/pr-56/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_6892":119693,"_42174":119688,"_29767":191782,"_5":21387,"_28235":119688,"_5797":191783},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_6892":119694,"_42174":119688,"_29767":191785,"_5":21387,"_28235":191771,"_5797":191786},[],"Verifica estos criterios juntos:",{"_6892":119695,"_42174":119688,"_29767":191788,"_5":21387,"_28235":191771,"_5797":190768},[],{"_6892":119696,"_42174":119688,"_29767":191790,"_5":21387,"_28235":191771,"_5797":191791},[],"Resultado necesario",{"_6892":119697,"_42174":119688,"_29767":191793,"_5":21387,"_28235":191771,"_5797":191794},[],"Cadena y firma",{"_6892":119698,"_42174":119688,"_29767":191796,"_5":21387,"_28235":191771,"_5797":191797},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_6892":119699,"_42174":119688,"_29767":191799,"_5":21387,"_28235":191771,"_5797":191800},[],"Fechas",{"_6892":119700,"_42174":119688,"_29767":191802,"_5":21387,"_28235":191771,"_5797":191803},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_6892":119701,"_42174":119688,"_29767":191805,"_5":21387,"_28235":191771,"_5797":186917},[],{"_6892":119702,"_42174":119688,"_29767":191807,"_5":21387,"_28235":191771,"_5797":191808},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_6892":119703,"_42174":119688,"_29767":191810,"_5":21387,"_28235":191771,"_5797":191811},[],"Uso",{"_6892":119704,"_42174":119688,"_29767":191813,"_5":21387,"_28235":191771,"_5797":191814},[],"KU, EKU y restricciones permiten la operación concreta.",{"_6892":119705,"_42174":119688,"_29767":191816,"_5":21387,"_28235":191771,"_5797":191817},[],"Revocación",{"_6892":119706,"_42174":119688,"_29767":191819,"_5":21387,"_28235":191771,"_5797":191820},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_6892":119707,"_42174":119688,"_29767":191822,"_5":21387,"_28235":191771,"_5797":191823},[],"Autorización",{"_6892":119708,"_42174":119688,"_29767":191825,"_5":21387,"_28235":191771,"_5797":191826},[],"La aplicación permite la acción a esa identidad.",{"_6892":119709,"_42174":119688,"_29767":191828,"_5":21387,"_28235":191771,"_5797":191829},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_6892":119710,"_42174":119688,"_29767":191831,"_5":21387,"_28235":191775,"_5797":191832},[],"Mecanismo",{"_6892":119711,"_42174":119688,"_29767":191834,"_5":21387,"_28235":191775,"_5797":191835},[],"Cuándo utilizarlo",{"_6892":119712,"_42174":119688,"_29767":191837,"_5":21387,"_28235":191775,"_5797":191838},[],"Qué debes mantener",{"_6892":119713,"_42174":119688,"_29767":191840,"_5":21387,"_28235":191775,"_5797":83419},[],{"_6892":119714,"_42174":119688,"_29767":191842,"_5":21387,"_28235":191775,"_5797":191843},[],"Consulta del estado de un certificado concreto.",{"_6892":119715,"_42174":119688,"_29767":191845,"_5":21387,"_28235":191775,"_5797":191846},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_6892":119716,"_42174":119688,"_29767":191848,"_5":21387,"_28235":191775,"_5797":83428},[],{"_6892":119717,"_42174":119688,"_29767":191850,"_5":21387,"_28235":191775,"_5797":191851},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_6892":119718,"_42174":119688,"_29767":191853,"_5":21387,"_28235":191775,"_5797":191854},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_6892":119719,"_42174":119688,"_29767":191856,"_5":21387,"_28235":191775,"_5797":191857},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_6892":119720,"_42174":119688,"_29767":191859,"_5":21387,"_28235":191775,"_5797":191860},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_6892":119721,"_42174":119688,"_29767":191862,"_5":21387,"_28235":191779,"_5797":191863},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_6892":119722,"_42174":119688,"_29767":191865,"_5":21387,"_28235":191779,"_5797":191866},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_6892":119723,"_42174":119688,"_29767":191868,"_5":21387,"_28235":191779,"_5797":191869},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_6892":119724,"_42174":119688,"_29767":191871,"_5":21387,"_28235":191779,"_5797":191872},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_6892":119725,"_42174":119688,"_29767":191874,"_5":21387,"_28235":191779,"_5797":191875},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_6892":119726,"_42174":119688,"_29767":191877,"_5":21387,"_28235":191779,"_5797":191878},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_6892":119727,"_42174":119688,"_29767":191880,"_5":21387,"_28235":191779,"_5797":191881},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_6892":119728,"_42174":119688,"_29767":191883,"_5":21387,"_28235":191779,"_5797":191884},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_6892":119729,"_42174":119688,"_29767":191886,"_5":21387,"_28235":191779,"_5797":191887},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_6892":119730,"_42174":119730,"_5":21817,"_5797":191889,"_42654":191890,"_29767":191891,"_28235":119730},"Certificados",[77248,187247,82716,191139],[],{"_6892":119731,"_42174":119730,"_29767":191893,"_5":21387,"_28235":119730,"_5797":191894},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_6892":119732,"_42174":119730,"_5":42651,"_29767":191896,"_28235":191897,"_5797":191898},[],"/docs/pr-preview/pr-56/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_6892":119733,"_42174":119730,"_5":42651,"_29767":191900,"_28235":191901,"_5797":191902},[],"/docs/pr-preview/pr-56/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_6892":119734,"_42174":119730,"_5":42651,"_29767":191904,"_28235":191905,"_5797":191906},[],"/docs/pr-preview/pr-56/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_6892":119735,"_42174":119730,"_5":42651,"_29767":191908,"_28235":191909,"_5797":191910},[],"/docs/pr-preview/pr-56/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_6892":119736,"_42174":119730,"_5":42651,"_29767":191912,"_28235":191913,"_5797":191914},[],"/docs/pr-preview/pr-56/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_6892":119737,"_42174":119730,"_5":42651,"_29767":191916,"_28235":191917,"_5797":191918},[],"/docs/pr-preview/pr-56/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_6892":119738,"_42174":119730,"_5":42651,"_29767":191920,"_28235":191921,"_5797":191922},[],"/docs/pr-preview/pr-56/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_6892":119739,"_42174":119730,"_5":42651,"_29767":191924,"_28235":191925,"_5797":191926},[],"/docs/pr-preview/pr-56/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_6892":119740,"_42174":119730,"_5":42651,"_29767":191928,"_28235":191929,"_5797":191930},[],"/docs/pr-preview/pr-56/es/platform/pki/certificates#continúa","Continúa",{"_6892":119741,"_42174":119730,"_29767":191932,"_5":21387,"_28235":119730,"_5797":191933},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_6892":119742,"_42174":119730,"_29767":191935,"_5":21387,"_28235":191897,"_5797":191936},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_6892":119743,"_42174":119730,"_29767":191938,"_5":21387,"_28235":191897,"_5797":191939},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_6892":119744,"_42174":119730,"_29767":191941,"_5":21387,"_28235":191901,"_5797":191942},[],"Descarga el PEM e inspecciónalo:",{"_6892":119745,"_42174":119730,"_29767":191944,"_5":21387,"_28235":191901,"_5797":191945},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_6892":119746,"_42174":119730,"_29767":191947,"_5":21387,"_28235":191905,"_5797":191948},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_6892":119747,"_42174":119730,"_29767":191950,"_5":21387,"_28235":191905,"_5797":191951},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_6892":119748,"_42174":119730,"_29767":191953,"_5":21387,"_28235":191905,"_5797":191954},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_6892":119749,"_42174":119730,"_29767":191956,"_5":21387,"_28235":191905,"_5797":191957},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_6892":119750,"_42174":119730,"_29767":191959,"_5":21387,"_28235":191905,"_5797":191960},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_6892":119751,"_42174":119730,"_29767":191962,"_5":21387,"_28235":191905,"_5797":191963},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_6892":119752,"_42174":119730,"_29767":191965,"_5":21387,"_28235":191905,"_5797":191966},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_6892":119753,"_42174":119730,"_29767":191968,"_5":21387,"_28235":191909,"_5797":191969},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_6892":119754,"_42174":119730,"_29767":191971,"_5":21387,"_28235":191913,"_5797":191972},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_6892":119755,"_42174":119730,"_29767":191974,"_5":21387,"_28235":191917,"_5797":191975},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_6892":119756,"_42174":119730,"_29767":191977,"_5":21387,"_28235":191921,"_5797":191978},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_6892":119757,"_42174":119730,"_29767":191980,"_5":21387,"_28235":191921,"_5797":191981},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_6892":119758,"_42174":119730,"_29767":191983,"_5":21387,"_28235":191921,"_5797":191984},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_6892":119759,"_42174":119730,"_29767":191986,"_5":21387,"_28235":191925,"_5797":191987},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_6892":119760,"_42174":119730,"_29767":191989,"_5":21387,"_28235":191925,"_5797":191990},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_6892":119761,"_42174":119730,"_29767":191992,"_5":21387,"_28235":191925,"_5797":191993},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_6892":119762,"_42174":119730,"_29767":191995,"_5":21387,"_28235":191929,"_5797":191996},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_6892":119763,"_42174":119730,"_29767":191998,"_5":21387,"_28235":191929,"_5797":191999},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_6892":119764,"_42174":119764,"_5":21817,"_5797":192001,"_42654":192002,"_29767":192004,"_28235":119764},"Ciclo de vida de un certificado",[77248,187247,82716,192003],"Conceptos",[],{"_6892":119765,"_42174":119764,"_29767":192006,"_5":21387,"_28235":119764,"_5797":192007},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_6892":119766,"_42174":119764,"_5":42651,"_29767":192009,"_28235":192010,"_5797":192011},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_6892":119767,"_42174":119764,"_5":42651,"_29767":192013,"_28235":192014,"_5797":192015},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_6892":119768,"_42174":119764,"_5":42651,"_29767":192017,"_28235":192018,"_5797":192019},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_6892":119769,"_42174":119764,"_5":42651,"_29767":192021,"_28235":192022,"_5797":192023},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_6892":119770,"_42174":119764,"_5":42651,"_29767":192025,"_28235":192026,"_5797":192027},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_6892":119771,"_42174":119764,"_5":42651,"_29767":192029,"_28235":192030,"_5797":192031},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_6892":119772,"_42174":119764,"_5":42651,"_29767":192033,"_28235":192034,"_5797":189700},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_6892":119773,"_42174":119764,"_5":42651,"_29767":192036,"_28235":192037,"_5797":192038},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_6892":119774,"_42174":119764,"_5":42651,"_29767":192040,"_28235":192041,"_5797":192042},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_6892":119775,"_42174":119764,"_5":42651,"_29767":192044,"_28235":192045,"_5797":192046},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_6892":119776,"_42174":119764,"_29767":192048,"_5":21387,"_28235":119764,"_5797":192049},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_6892":119777,"_42174":119764,"_29767":192051,"_5":21387,"_28235":192014,"_5797":192052},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_6892":119778,"_42174":119764,"_29767":192054,"_5":21387,"_28235":192018,"_5797":192055},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_6892":119779,"_42174":119764,"_29767":192057,"_5":21387,"_28235":192022,"_5797":192058},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_6892":119780,"_42174":119764,"_29767":192060,"_5":21387,"_28235":192026,"_5797":192061},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_6892":119781,"_42174":119764,"_29767":192063,"_5":21387,"_28235":192030,"_5797":192064},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_6892":119782,"_42174":119764,"_29767":192066,"_5":21387,"_28235":192034,"_5797":192067},[],"Lamassu persiste cuatro estados X.509:",{"_6892":119783,"_42174":119764,"_29767":192069,"_5":21387,"_28235":192034,"_5797":192070},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_6892":119784,"_42174":119764,"_29767":192072,"_5":21387,"_28235":192034,"_5797":192073},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_6892":119785,"_42174":119764,"_29767":192075,"_5":21387,"_28235":192034,"_5797":192076},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_6892":119786,"_42174":119764,"_29767":192078,"_5":21387,"_28235":192034,"_5797":192079},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_6892":119787,"_42174":119764,"_29767":192081,"_5":21387,"_28235":192034,"_5797":192082},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_6892":119788,"_42174":119764,"_29767":192084,"_5":21387,"_28235":192037,"_5797":192085},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_6892":119789,"_42174":119764,"_29767":192087,"_5":21387,"_28235":192037,"_5797":192088},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_6892":119790,"_42174":119764,"_29767":192090,"_5":21387,"_28235":192037,"_5797":192091},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_6892":119791,"_42174":119764,"_29767":192093,"_5":21387,"_28235":192041,"_5797":192094},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_6892":119792,"_42174":119764,"_29767":192096,"_5":21387,"_28235":192041,"_5797":192097},[],"Antes de confirmar:",{"_6892":119793,"_42174":119764,"_29767":192099,"_5":21387,"_28235":192041,"_5797":192100},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_6892":119794,"_42174":119764,"_29767":192102,"_5":21387,"_28235":192041,"_5797":192103},[],"Distribuye la nueva cadena de confianza.",{"_6892":119795,"_42174":119764,"_29767":192105,"_5":21387,"_28235":192041,"_5797":192106},[],"Reemite las identidades necesarias.",{"_6892":119796,"_42174":119764,"_29767":192108,"_5":21387,"_28235":192041,"_5797":192109},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_6892":119797,"_42174":119764,"_29767":192111,"_5":21387,"_28235":192041,"_5797":192112},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_6892":119798,"_42174":119764,"_29767":192114,"_5":21387,"_28235":192041,"_5797":192115},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_6892":119799,"_42174":119764,"_29767":192117,"_5":21387,"_28235":192045,"_5797":192118},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_6892":119800,"_42174":119764,"_29767":192120,"_5":21387,"_28235":192045,"_5797":192121},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_6892":119801,"_42174":119764,"_29767":192123,"_5":21387,"_28235":192045,"_5797":192124},[],"Cambios de estado y razones de revocación.",{"_6892":119802,"_42174":119764,"_29767":192126,"_5":21387,"_28235":192045,"_5797":192127},[],"Publicación y vigencia de OCSP y CRLs.",{"_6892":119803,"_42174":119764,"_29767":192129,"_5":21387,"_28235":192045,"_5797":192130},[],"Dependencias que todavía presentan un certificado sustituido.",{"_6892":119804,"_42174":119764,"_29767":192132,"_5":21387,"_28235":192045,"_5797":192133},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_6892":119805,"_42174":119805,"_5":21817,"_5797":192135,"_42654":192136,"_29767":192137,"_28235":119805},"Modelo de confianza",[77248,187247,82716,192003],[],{"_6892":119806,"_42174":119805,"_29767":192139,"_5":21387,"_28235":119805,"_5797":192140},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_6892":119807,"_42174":119805,"_5":42651,"_29767":192142,"_28235":192143,"_5797":192144},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_6892":119808,"_42174":119805,"_5":42651,"_29767":192146,"_28235":192147,"_5797":192148},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_6892":119809,"_42174":119805,"_5":42651,"_29767":192150,"_28235":192151,"_5797":192152},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_6892":119810,"_42174":119805,"_5":42651,"_29767":192154,"_28235":192155,"_5797":192156},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_6892":119811,"_42174":119805,"_5":42651,"_29767":192158,"_28235":192159,"_5797":192160},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_6892":119812,"_42174":119805,"_5":42651,"_29767":192162,"_28235":192163,"_5797":192164},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_6892":119813,"_42174":119805,"_5":42651,"_29767":192166,"_28235":192167,"_5797":192168},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_6892":119814,"_42174":119805,"_5":42651,"_29767":192170,"_28235":192171,"_5797":192172},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_6892":119815,"_42174":119805,"_5":42651,"_29767":192174,"_28235":192175,"_5797":192176},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_6892":119816,"_42174":119805,"_5":42651,"_29767":192178,"_28235":192179,"_5797":192180},[],"/docs/pr-preview/pr-56/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_6892":119817,"_42174":119805,"_29767":192182,"_5":21387,"_28235":119805,"_5797":192183},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_6892":119818,"_42174":119805,"_29767":192185,"_5":21387,"_28235":192147,"_5797":192186},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_6892":119819,"_42174":119805,"_29767":192188,"_5":21387,"_28235":192151,"_5797":192189},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_6892":119820,"_42174":119805,"_29767":192191,"_5":21387,"_28235":192155,"_5797":192192},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_6892":119821,"_42174":119805,"_29767":192194,"_5":21387,"_28235":192159,"_5797":192195},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_6892":119822,"_42174":119805,"_29767":192197,"_5":21387,"_28235":192163,"_5797":192198},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_6892":119823,"_42174":119805,"_29767":192200,"_5":21387,"_28235":192163,"_5797":192201},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_6892":119824,"_42174":119805,"_29767":192203,"_5":21387,"_28235":192163,"_5797":192204},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_6892":119825,"_42174":119805,"_29767":192206,"_5":21387,"_28235":192163,"_5797":192207},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_6892":119826,"_42174":119805,"_29767":192209,"_5":21387,"_28235":192163,"_5797":192210},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_6892":119827,"_42174":119805,"_29767":192212,"_5":21387,"_28235":192163,"_5797":192213},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_6892":119828,"_42174":119805,"_29767":192215,"_5":21387,"_28235":192167,"_5797":192216},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_6892":119829,"_42174":119805,"_29767":192218,"_5":21387,"_28235":192167,"_5797":192219},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_6892":119830,"_42174":119805,"_29767":192221,"_5":21387,"_28235":192167,"_5797":192222},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_6892":119831,"_42174":119805,"_29767":192224,"_5":21387,"_28235":192167,"_5797":192225},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_6892":119832,"_42174":119805,"_29767":192227,"_5":21387,"_28235":192167,"_5797":192228},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_6892":119833,"_42174":119805,"_29767":192230,"_5":21387,"_28235":192171,"_5797":192231},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_6892":119834,"_42174":119805,"_29767":192233,"_5":21387,"_28235":192171,"_5797":192234},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_6892":119835,"_42174":119805,"_29767":192236,"_5":21387,"_28235":192171,"_5797":192237},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_6892":119836,"_42174":119805,"_29767":192239,"_5":21387,"_28235":192171,"_5797":192240},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_6892":119837,"_42174":119805,"_29767":192242,"_5":21387,"_28235":192171,"_5797":192243},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_6892":119838,"_42174":119805,"_29767":192245,"_5":21387,"_28235":192171,"_5797":192246},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_6892":119839,"_42174":119805,"_29767":192248,"_5":21387,"_28235":192171,"_5797":192249},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_6892":119840,"_42174":119805,"_29767":192251,"_5":21387,"_28235":192175,"_5797":192252},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_6892":119841,"_42174":119805,"_29767":192254,"_5":21387,"_28235":192179,"_5797":192255},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_6892":119842,"_42174":119805,"_29767":192257,"_5":21387,"_28235":192179,"_5797":192258},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_6892":119843,"_42174":119805,"_29767":192260,"_5":21387,"_28235":192179,"_5797":192261},[],"Asigna perfiles explícitos a cada caso de uso.",{"_6892":119844,"_42174":119805,"_29767":192263,"_5":21387,"_28235":192179,"_5797":192264},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_6892":119845,"_42174":119805,"_29767":192266,"_5":21387,"_28235":192179,"_5797":192267},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_6892":119846,"_42174":119805,"_29767":192269,"_5":21387,"_28235":192179,"_5797":192270},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_6892":119847,"_42174":119805,"_29767":192272,"_5":21387,"_28235":192179,"_5797":192273},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_6892":119848,"_42174":119848,"_5":21817,"_5797":192275,"_42654":192276,"_29767":192277,"_28235":119848},"Listas de revocación (CRL)",[77248,187247,82716,191764],[],{"_6892":119849,"_42174":119848,"_29767":192279,"_5":21387,"_28235":119848,"_5797":192280},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_6892":119850,"_42174":119848,"_5":42651,"_29767":192282,"_28235":192283,"_5797":192284},[],"/docs/pr-preview/pr-56/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_6892":119851,"_42174":119848,"_5":42651,"_29767":192286,"_28235":192287,"_5797":192288},[],"/docs/pr-preview/pr-56/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_6892":119852,"_42174":119848,"_5":42651,"_29767":192290,"_28235":192291,"_5797":192292},[],"/docs/pr-preview/pr-56/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_6892":119853,"_42174":119848,"_5":42651,"_29767":192294,"_28235":192295,"_5797":192296},[],"/docs/pr-preview/pr-56/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_6892":119854,"_42174":119848,"_5":42651,"_29767":192298,"_28235":192299,"_5797":192300},[],"/docs/pr-preview/pr-56/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_6892":119855,"_42174":119848,"_5":42651,"_29767":192302,"_28235":192303,"_5797":192304},[],"/docs/pr-preview/pr-56/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_6892":119856,"_42174":119848,"_5":42651,"_29767":192306,"_28235":192307,"_5797":192308},[],"/docs/pr-preview/pr-56/es/platform/pki/crl#errores-frecuentes-del-rol-va","Errores frecuentes del rol VA",{"_6892":119857,"_42174":119848,"_5":42651,"_29767":192310,"_28235":192311,"_5797":192312},[],"/docs/pr-preview/pr-56/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_6892":119858,"_42174":119848,"_5":42651,"_29767":192314,"_28235":192315,"_5797":192316},[],"/docs/pr-preview/pr-56/es/platform/pki/crl#referencias","Referencias",{"_6892":119859,"_42174":119848,"_29767":192318,"_5":21387,"_28235":119848,"_5797":192319},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_6892":119860,"_42174":119848,"_29767":192321,"_5":21387,"_28235":192283,"_5797":192322},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_6892":119861,"_42174":119848,"_29767":192324,"_5":21387,"_28235":192283,"_5797":192325},[],"Campo de `crl_options`",{"_6892":119862,"_42174":119848,"_29767":192327,"_5":21387,"_28235":192283,"_5797":188782},[],{"_6892":119863,"_42174":119848,"_29767":192329,"_5":21387,"_28235":192283,"_5797":192330},[],"Valor inicial del backend",{"_6892":119864,"_42174":119848,"_29767":192332,"_5":21387,"_28235":192283,"_5797":83914},[],{"_6892":119865,"_42174":119848,"_29767":192334,"_5":21387,"_28235":192283,"_5797":192335},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_6892":119866,"_42174":119848,"_29767":192337,"_5":21387,"_28235":192283,"_5797":192338},[],"7 días.",{"_6892":119867,"_42174":119848,"_29767":192340,"_5":21387,"_28235":192283,"_5797":83923},[],{"_6892":119868,"_42174":119848,"_29767":192342,"_5":21387,"_28235":192283,"_5797":192343},[],"Se guarda y se devuelve por la API, pero la VA no lo utiliza: la renovación programada no depende de él (consulta Regeneración periódica y automática).",{"_6892":119869,"_42174":119848,"_29767":192345,"_5":21387,"_28235":192283,"_5797":192346},[],"6 días y 23 horas.",{"_6892":119870,"_42174":119848,"_29767":192348,"_5":21387,"_28235":192283,"_5797":83932},[],{"_6892":119871,"_42174":119848,"_29767":192350,"_5":21387,"_28235":192283,"_5797":192351},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_6892":119872,"_42174":119848,"_29767":192353,"_5":21387,"_28235":192283,"_5797":83938},[],{"_6892":119873,"_42174":119848,"_29767":192355,"_5":21387,"_28235":192283,"_5797":83941},[],{"_6892":119874,"_42174":119848,"_29767":192357,"_5":21387,"_28235":192283,"_5797":192358},[],"Número de serie del certificado existente que firma la CRL.",{"_6892":119875,"_42174":119848,"_29767":192360,"_5":21387,"_28235":192283,"_5797":192361},[],"Número de serie del certificado actual de la CA.",{"_6892":119876,"_42174":119848,"_29767":192363,"_5":21387,"_28235":192283,"_5797":192364},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_6892":119877,"_42174":119848,"_29767":192366,"_5":21387,"_28235":192283,"_5797":192367},[],"Al reemitir una CA, el rol sigue apuntando al certificado anterior. Las CRL siguen siendo válidas porque ambos certificados comparten sujeto y clave, pero el certificado anterior no puede eliminarse mientras el rol lo use. Para retirarlo, actualiza el firmante del rol.",{"_6892":119878,"_42174":119848,"_29767":192369,"_5":21387,"_28235":192283,"_5797":192370},[],"Al eliminar una CA, su rol VA se conserva y no puede borrarse por API. Si no queda ninguna otra CA con el mismo SKI, el rol puede consultarse pero cualquier `PUT` devuelve 404, y el trabajo de renovación registra un aviso en cada ciclo porque ya no encuentra la CA. La API no ofrece salida; solo se corrige editando la base de datos. Si queda otra CA con ese SKI, el rol sigue siendo editable (consulta CAs que comparten clave). Ajusta validez y firmante antes de eliminar la CA.",{"_6892":119879,"_42174":119848,"_29767":192372,"_5":21387,"_28235":192283,"_5797":192373},[],"Una CA cuyo certificado no tiene `cRLSign` no puede generar su CRL ni editar su rol (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y asígnalo como firmante con `PUT`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original.",{"_6892":119880,"_42174":119848,"_29767":192375,"_5":21387,"_28235":192283,"_5797":192376},[],"El `PUT` valida siempre el firmante, aunque la petición no lo cambie. Si el firmante guardado ya no es válido, no se puede modificar ningún campo del rol, ni siquiera la validez, hasta asignar uno válido.",{"_6892":119881,"_42174":119848,"_29767":192378,"_5":21387,"_28235":192283,"_5797":192379},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_6892":119882,"_42174":119848,"_29767":192381,"_5":21387,"_28235":192287,"_5797":192382},[],"La VA identifica cada CRL por el SKI de la CA, y el SKI se deriva de su clave. Dos CAs con la misma clave tienen el mismo SKI y comparten un único rol VA y una única CRL. Ocurre al crear una CA sobre una clave ya existente del KMS, o al importar una CA cuyo certificado declara un SKI en uso. Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. El rol lo crea la primera CA y las demás lo conservan.",{"_6892":119883,"_42174":119848,"_29767":192384,"_5":21387,"_28235":192287,"_5797":192385},[],"Los certificados de todas ellas apuntan a `/crl/{ski}`, pero la lista publicada tiene como emisor a la primera CA y solo incluye sus revocaciones. Un verificador compara el emisor de la CRL con el del certificado que valida (RFC 5280, §6.3.2) y rechaza la lista si no coinciden. Según su política, el certificado queda bloqueado (*hard-fail*) o se acepta aunque esté revocado (*soft-fail*). Las revocaciones de las CAs secundarias no aparecen en ninguna lista.",{"_6892":119884,"_42174":119848,"_29767":192387,"_5":21387,"_28235":192287,"_5797":192388},[],"Si la primera CA se elimina, la generación de CRL de la restante falla porque el firmante configurado ya no corresponde a una CA con ese nombre. Hasta que se actualice el firmante del rol a un certificado de la CA restante, se sigue sirviendo la última lista publicada hasta que venza (7 días por defecto).",{"_6892":119885,"_42174":119848,"_29767":192390,"_5":21387,"_28235":192287,"_5797":192391},[],"Para detectar el problema, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos. Una CA importada con un SKI ya en uso no sustituye a la existente como emisora de la CRL, porque el emisor se resuelve a partir del firmante del rol. Sin embargo, sus propios certificados apuntan a esa misma URL y sus revocaciones no se publican. Hasta que Lamassu rechace estas importaciones, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión, así que tampoco reutilices claves entre CAs. Una CRL por CA y el rechazo de importaciones cuyo SKI colisiona con el de una CA existente están planteados en lamassuiot#834, y ninguno está implementado todavía.",{"_6892":119886,"_42174":119848,"_29767":192393,"_5":21387,"_28235":192291,"_5797":192394},[],"El trabajo programado de la VA revisa todos los roles en cada ejecución y solicita otra lista cuando a `latest_crl` le queda menos validez que el intervalo entre ejecuciones. La frecuencia se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. `refresh_interval` no interviene. Mantén `validity` claramente por encima del intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_6892":119887,"_42174":119848,"_29767":192396,"_5":21387,"_28235":192291,"_5797":192397},[],"Si la generación falla (por ejemplo, por un rol sin CA o un firmante inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ski>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_6892":119888,"_42174":119848,"_29767":192399,"_5":21387,"_28235":192291,"_5797":192400},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla (rol inexistente, firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_6892":119889,"_42174":119848,"_29767":192402,"_5":21387,"_28235":192291,"_5797":192403},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_6892":119890,"_42174":119848,"_29767":192405,"_5":21387,"_28235":192295,"_5797":192406},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_6892":119891,"_42174":119848,"_29767":192408,"_5":21387,"_28235":192295,"_5797":192409},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_6892":119892,"_42174":119848,"_29767":192411,"_5":21387,"_28235":192299,"_5797":192412},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_6892":119893,"_42174":119848,"_29767":192414,"_5":21387,"_28235":192299,"_5797":192415},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_6892":119894,"_42174":119848,"_29767":192417,"_5":21387,"_28235":192299,"_5797":192418},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_6892":119895,"_42174":119848,"_29767":192420,"_5":21387,"_28235":192299,"_5797":192421},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_6892":119896,"_42174":119848,"_29767":192423,"_5":21387,"_28235":192299,"_5797":192424},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_6892":119897,"_42174":119848,"_29767":192426,"_5":21387,"_28235":192303,"_5797":192427},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_6892":119898,"_42174":119848,"_29767":192429,"_5":21387,"_28235":192303,"_5797":188971},[],{"_6892":119899,"_42174":119848,"_29767":192431,"_5":21387,"_28235":192303,"_5797":192432},[],"Path relativo",{"_6892":119900,"_42174":119848,"_29767":192434,"_5":21387,"_28235":192303,"_5797":187007},[],{"_6892":119901,"_42174":119848,"_29767":192436,"_5":21387,"_28235":192303,"_5797":84023},[],{"_6892":119902,"_42174":119848,"_29767":192438,"_5":21387,"_28235":192303,"_5797":84026},[],{"_6892":119903,"_42174":119848,"_29767":192440,"_5":21387,"_28235":192303,"_5797":192441},[],"Consultar `crl_options` y `latest_crl`.",{"_6892":119904,"_42174":119848,"_29767":192443,"_5":21387,"_28235":192303,"_5797":84032},[],{"_6892":119905,"_42174":119848,"_29767":192445,"_5":21387,"_28235":192303,"_5797":84026},[],{"_6892":119906,"_42174":119848,"_29767":192447,"_5":21387,"_28235":192303,"_5797":192448},[],"Sustituir la configuración de CRL.",{"_6892":119907,"_42174":119848,"_29767":192450,"_5":21387,"_28235":192303,"_5797":192451},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_6892":119908,"_42174":119848,"_29767":192453,"_5":21387,"_28235":192303,"_5797":192454},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_6892":119909,"_42174":119848,"_29767":192456,"_5":21387,"_28235":192307,"_5797":192457},[],"Síntoma",{"_6892":119910,"_42174":119848,"_29767":192459,"_5":21387,"_28235":192307,"_5797":192460},[],"Causa",{"_6892":119911,"_42174":119848,"_29767":192462,"_5":21387,"_28235":192307,"_5797":192463},[],"Acción",{"_6892":119912,"_42174":119848,"_29767":192465,"_5":21387,"_28235":192307,"_5797":192466},[],"`PUT /v1/roles/{ca-ski}` devuelve 404 y `GET` devuelve 200.",{"_6892":119913,"_42174":119848,"_29767":192468,"_5":21387,"_28235":192307,"_5797":192469},[],"Se eliminó la CA del rol y no queda otra con el mismo SKI.",{"_6892":119914,"_42174":119848,"_29767":192471,"_5":21387,"_28235":192307,"_5797":192472},[],"No hay salida por API; requiere intervención en la base de datos. Evítalo ajustando el rol antes de eliminar la CA.",{"_6892":119915,"_42174":119848,"_29767":192474,"_5":21387,"_28235":192307,"_5797":192475},[],"`PUT` devuelve 400.",{"_6892":119916,"_42174":119848,"_29767":192477,"_5":21387,"_28235":192307,"_5797":192478},[],"El firmante no tiene `cRLSign`, o su sujeto y su clave no coinciden con ninguna CA de ese SKI (por ejemplo, tras eliminar la primera de dos CAs que comparten clave).",{"_6892":119917,"_42174":119848,"_29767":192480,"_5":21387,"_28235":192307,"_5797":192481},[],"Asigna con `PUT` el número de serie de un certificado válido de la CA restante.",{"_6892":119918,"_42174":119848,"_29767":192483,"_5":21387,"_28235":192307,"_5797":192484},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_6892":119919,"_42174":119848,"_29767":192486,"_5":21387,"_28235":192307,"_5797":192487},[],"`crl_options.subject_key_id_signer` se sustituyó por `signer_certificate_serial_number`, que es obligatorio.",{"_6892":119920,"_42174":119848,"_29767":192489,"_5":21387,"_28235":192307,"_5797":192490},[],"Actualiza el cliente para enviar el campo nuevo.",{"_6892":119921,"_42174":119848,"_29767":192492,"_5":21387,"_28235":192307,"_5797":192493},[],"La CRL no cambia tras revocar un certificado.",{"_6892":119922,"_42174":119848,"_29767":192495,"_5":21387,"_28235":192307,"_5797":192496},[],"`regenerate_on_revoke` es `false`, o el evento falló por falta de rol o por un firmante inválido.",{"_6892":119923,"_42174":119848,"_29767":192498,"_5":21387,"_28235":192307,"_5797":192499},[],"Revisa los logs de la VA y la cola de eventos fallidos; corrige el firmante.",{"_6892":119924,"_42174":119848,"_29767":192501,"_5":21387,"_28235":192307,"_5797":192502},[],"Un verificador rechaza la CRL por el emisor.",{"_6892":119925,"_42174":119848,"_29767":192504,"_5":21387,"_28235":192307,"_5797":192505},[],"Varias CAs comparten SKI.",{"_6892":119926,"_42174":119848,"_29767":192507,"_5":21387,"_28235":192307,"_5797":192508},[],"Consulta CAs que comparten clave.",{"_6892":119927,"_42174":119848,"_29767":192510,"_5":21387,"_28235":192311,"_5797":192511},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_6892":119928,"_42174":119848,"_29767":192513,"_5":21387,"_28235":192315,"_5797":192514},[],"RFC 5280: perfil X.509 y CRL.",{"_6892":119929,"_42174":119848,"_29767":192516,"_5":21387,"_28235":192315,"_5797":84106},[],{"_6892":119930,"_42174":119848,"_29767":192518,"_5":21387,"_28235":192315,"_5797":84109},[],{"_6892":119931,"_42174":119848,"_29767":192520,"_5":21387,"_28235":192315,"_5797":192521},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_6892":119932,"_42174":119848,"_29767":192523,"_5":21387,"_28235":192315,"_5797":192524},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_6892":119933,"_42174":119933,"_5":21817,"_5797":192526,"_42654":192527,"_29767":192528,"_28235":119933},"Claves y motores criptográficos",[77248,187247,82716,191139],[],{"_6892":119934,"_42174":119933,"_29767":192530,"_5":21387,"_28235":119933,"_5797":192531},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_6892":119935,"_42174":119933,"_5":42651,"_29767":192533,"_28235":192534,"_5797":192535},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_6892":119936,"_42174":119933,"_5":42651,"_29767":192537,"_28235":192538,"_5797":192539},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_6892":119937,"_42174":119933,"_5":42651,"_29767":192541,"_28235":192542,"_5797":84134},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#file-system",{"_6892":119938,"_42174":119933,"_5":42651,"_29767":192544,"_28235":192545,"_5797":84138},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#hashicorp-vault",{"_6892":119939,"_42174":119933,"_5":42651,"_29767":192547,"_28235":192548,"_5797":84142},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#aws-secrets-manager",{"_6892":119940,"_42174":119933,"_5":42651,"_29767":192550,"_28235":192551,"_5797":84146},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#aws-kms",{"_6892":119941,"_42174":119933,"_5":42651,"_29767":192553,"_28235":192554,"_5797":84150},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#pkcs11",{"_6892":119942,"_42174":119933,"_5":42651,"_29767":192556,"_28235":192557,"_5797":84154},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#azure-key-vault",{"_6892":119943,"_42174":119933,"_5":42651,"_29767":192559,"_28235":192560,"_5797":192561},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_6892":119944,"_42174":119933,"_5":42651,"_29767":192563,"_28235":192564,"_5797":192565},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_6892":119945,"_42174":119933,"_5":42651,"_29767":192567,"_28235":192568,"_5797":192569},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_6892":119946,"_42174":119933,"_5":42651,"_29767":192571,"_28235":192572,"_5797":192573},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_6892":119947,"_42174":119933,"_5":42651,"_29767":192575,"_28235":192576,"_5797":192577},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_6892":119948,"_42174":119933,"_5":42651,"_29767":192579,"_28235":192580,"_5797":192581},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_6892":119949,"_42174":119933,"_5":42651,"_29767":192583,"_28235":192584,"_5797":192585},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_6892":119950,"_42174":119933,"_5":42651,"_29767":192587,"_28235":192588,"_5797":84186},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#sign",{"_6892":119951,"_42174":119933,"_5":42651,"_29767":192590,"_28235":192591,"_5797":84190},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#verify",{"_6892":119952,"_42174":119933,"_5":42651,"_29767":192593,"_28235":192594,"_5797":192595},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_6892":119953,"_42174":119933,"_5":42651,"_29767":192597,"_28235":192598,"_5797":192599},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_6892":119954,"_42174":119933,"_5":42651,"_29767":192601,"_28235":192602,"_5797":192603},[],"/docs/pr-preview/pr-56/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_6892":119955,"_42174":119933,"_29767":192605,"_5":21387,"_28235":119933,"_5797":192606},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_6892":119956,"_42174":119933,"_29767":192608,"_5":21387,"_28235":119933,"_5797":192609},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_6892":119957,"_42174":119933,"_29767":192611,"_5":21387,"_28235":192534,"_5797":192612},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_6892":119958,"_42174":119933,"_29767":192614,"_5":21387,"_28235":192534,"_5797":192615},[],"En la práctica, permite:",{"_6892":119959,"_42174":119933,"_29767":192617,"_5":21387,"_28235":192534,"_5797":192618},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_6892":119960,"_42174":119933,"_29767":192620,"_5":21387,"_28235":192534,"_5797":192621},[],"Importar claves creadas externamente.",{"_6892":119961,"_42174":119933,"_29767":192623,"_5":21387,"_28235":192534,"_5797":192624},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_6892":119962,"_42174":119933,"_29767":192626,"_5":21387,"_28235":192534,"_5797":192627},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_6892":119963,"_42174":119933,"_29767":192629,"_5":21387,"_28235":192538,"_5797":192630},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_6892":119964,"_42174":119933,"_29767":192632,"_5":21387,"_28235":192538,"_5797":192633},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_6892":119965,"_42174":119933,"_29767":192635,"_5":21387,"_28235":192538,"_5797":192636},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_6892":119966,"_42174":119933,"_29767":192638,"_5":21387,"_28235":192542,"_5797":192639},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_6892":119967,"_42174":119933,"_29767":192641,"_5":21387,"_28235":192545,"_5797":192642},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_6892":119968,"_42174":119933,"_29767":192644,"_5":21387,"_28235":192545,"_5797":192645},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_6892":119969,"_42174":119933,"_29767":192647,"_5":21387,"_28235":192548,"_5797":192648},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_6892":119970,"_42174":119933,"_29767":192650,"_5":21387,"_28235":192551,"_5797":192651},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_6892":119971,"_42174":119933,"_29767":192653,"_5":21387,"_28235":192554,"_5797":192654},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_6892":119972,"_42174":119933,"_29767":192656,"_5":21387,"_28235":192557,"_5797":192657},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_6892":119973,"_42174":119933,"_29767":192659,"_5":21387,"_28235":192557,"_5797":192660},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_6892":119974,"_42174":119933,"_29767":192662,"_5":21387,"_28235":192557,"_5797":192663},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_6892":119975,"_42174":119933,"_29767":192665,"_5":21387,"_28235":192557,"_5797":192666},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_6892":119976,"_42174":119933,"_29767":192668,"_5":21387,"_28235":192560,"_5797":192669},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_6892":119977,"_42174":119933,"_29767":192671,"_5":21387,"_28235":192560,"_5797":192672},[],"La tabla incluye los siguientes campos:",{"_6892":119978,"_42174":119933,"_29767":192674,"_5":21387,"_28235":192560,"_5797":192675},[],"**Name**: nombre descriptivo de la clave.",{"_6892":119979,"_42174":119933,"_29767":192677,"_5":21387,"_28235":192560,"_5797":192678},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_6892":119980,"_42174":119933,"_29767":192680,"_5":21387,"_28235":192560,"_5797":192681},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_6892":119981,"_42174":119933,"_29767":192683,"_5":21387,"_28235":192560,"_5797":192684},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_6892":119982,"_42174":119933,"_29767":192686,"_5":21387,"_28235":192560,"_5797":192687},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_6892":119983,"_42174":119933,"_29767":192689,"_5":21387,"_28235":192560,"_5797":192690},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_6892":119984,"_42174":119933,"_29767":192692,"_5":21387,"_28235":192560,"_5797":192693},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_6892":119985,"_42174":119933,"_29767":192695,"_5":21387,"_28235":192560,"_5797":192696},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_6892":119986,"_42174":119933,"_29767":192698,"_5":21387,"_28235":192560,"_5797":192699},[],"Desde esta vista también se accede a las acciones más habituales:",{"_6892":119987,"_42174":119933,"_29767":192701,"_5":21387,"_28235":192560,"_5797":192702},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_6892":119988,"_42174":119933,"_29767":192704,"_5":21387,"_28235":192560,"_5797":192705},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_6892":119989,"_42174":119933,"_29767":192707,"_5":21387,"_28235":192560,"_5797":192708},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_6892":119990,"_42174":119933,"_29767":192710,"_5":21387,"_28235":192560,"_5797":192711},[],"**Delete Key** para eliminar la clave del sistema.",{"_6892":119991,"_42174":119933,"_29767":192713,"_5":21387,"_28235":192564,"_5797":192714},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_6892":119992,"_42174":119933,"_29767":192716,"_5":21387,"_28235":192568,"_5797":192717},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_6892":119993,"_42174":119933,"_29767":192719,"_5":21387,"_28235":192568,"_5797":192720},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_6892":119994,"_42174":119933,"_29767":192722,"_5":21387,"_28235":192568,"_5797":192723},[],"**Key Name**: nombre único y descriptivo.",{"_6892":119995,"_42174":119933,"_29767":192725,"_5":21387,"_28235":192568,"_5797":192726},[],"**Crypto Engine**: motor que custodiará la clave.",{"_6892":119996,"_42174":119933,"_29767":192728,"_5":21387,"_28235":192568,"_5797":192729},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_6892":119997,"_42174":119933,"_29767":192731,"_5":21387,"_28235":192568,"_5797":192732},[],"**Tags**: metadatos para clasificar la clave.",{"_6892":119998,"_42174":119933,"_29767":192734,"_5":21387,"_28235":192568,"_5797":192735},[],"**Metadata**: información adicional para usos avanzados.",{"_6892":119999,"_42174":119933,"_29767":192737,"_5":21387,"_28235":192572,"_5797":192738},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_6892":120000,"_42174":119933,"_29767":192740,"_5":21387,"_28235":192572,"_5797":192741},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_6892":120001,"_42174":119933,"_29767":192743,"_5":21387,"_28235":192572,"_5797":192744},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_6892":120002,"_42174":119933,"_29767":192746,"_5":21387,"_28235":192572,"_5797":192747},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_6892":120003,"_42174":119933,"_29767":192749,"_5":21387,"_28235":192572,"_5797":192750},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_6892":120004,"_42174":119933,"_29767":192752,"_5":21387,"_28235":192572,"_5797":192753},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_6892":120005,"_42174":119933,"_29767":192755,"_5":21387,"_28235":192572,"_5797":192756},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_6892":120006,"_42174":119933,"_29767":192758,"_5":21387,"_28235":192572,"_5797":192759},[],"**Tags**: etiquetas para organización y búsqueda.",{"_6892":120007,"_42174":119933,"_29767":192761,"_5":21387,"_28235":192572,"_5797":192762},[],"**Metadata**: información adicional opcional.",{"_6892":120008,"_42174":119933,"_29767":192764,"_5":21387,"_28235":192572,"_5797":192765},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_6892":120009,"_42174":119933,"_29767":192767,"_5":21387,"_28235":192572,"_5797":192768},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_6892":120010,"_42174":119933,"_29767":192770,"_5":21387,"_28235":192576,"_5797":192771},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_6892":120011,"_42174":119933,"_29767":192773,"_5":21387,"_28235":192580,"_5797":192774},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_6892":120012,"_42174":119933,"_29767":192776,"_5":21387,"_28235":192580,"_5797":192777},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_6892":120013,"_42174":119933,"_29767":192779,"_5":21387,"_28235":192580,"_5797":192780},[],"**Key Name**: nombre descriptivo.",{"_6892":120014,"_42174":119933,"_29767":192782,"_5":21387,"_28235":192580,"_5797":192783},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_6892":120015,"_42174":119933,"_29767":192785,"_5":21387,"_28235":192580,"_5797":192786},[],"**Tags**: etiquetas asociadas.",{"_6892":120016,"_42174":119933,"_29767":192788,"_5":21387,"_28235":192580,"_5797":192789},[],"**Aliases**: nombres alternativos.",{"_6892":120017,"_42174":119933,"_29767":192791,"_5":21387,"_28235":192580,"_5797":192792},[],"**Crypto Engine**: motor en el que reside la clave.",{"_6892":120018,"_42174":119933,"_29767":192794,"_5":21387,"_28235":192580,"_5797":192795},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_6892":120019,"_42174":119933,"_29767":192797,"_5":21387,"_28235":192580,"_5797":192798},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_6892":120020,"_42174":119933,"_29767":192800,"_5":21387,"_28235":192580,"_5797":192801},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_6892":120021,"_42174":119933,"_29767":192803,"_5":21387,"_28235":192584,"_5797":192804},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_6892":120022,"_42174":119933,"_29767":192806,"_5":21387,"_28235":192584,"_5797":192807},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_6892":120023,"_42174":119933,"_29767":192809,"_5":21387,"_28235":192584,"_5797":192810},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_6892":120024,"_42174":119933,"_29767":192812,"_5":21387,"_28235":192588,"_5797":192813},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_6892":120025,"_42174":119933,"_29767":192815,"_5":21387,"_28235":192588,"_5797":192816},[],"Campos principales:",{"_6892":120026,"_42174":119933,"_29767":192818,"_5":21387,"_28235":192588,"_5797":192819},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_6892":120027,"_42174":119933,"_29767":192821,"_5":21387,"_28235":192588,"_5797":192822},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_6892":120028,"_42174":119933,"_29767":192824,"_5":21387,"_28235":192588,"_5797":192825},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_6892":120029,"_42174":119933,"_29767":192827,"_5":21387,"_28235":192588,"_5797":192828},[],"**Message**: contenido que se va a firmar.",{"_6892":120030,"_42174":119933,"_29767":192830,"_5":21387,"_28235":192588,"_5797":192831},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_6892":120031,"_42174":119933,"_29767":192833,"_5":21387,"_28235":192591,"_5797":192834},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_6892":120032,"_42174":119933,"_29767":192836,"_5":21387,"_28235":192591,"_5797":192816},[],{"_6892":120033,"_42174":119933,"_29767":192838,"_5":21387,"_28235":192591,"_5797":192839},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_6892":120034,"_42174":119933,"_29767":192841,"_5":21387,"_28235":192591,"_5797":192842},[],"**Message Type**: `Raw` o `Digest`.",{"_6892":120035,"_42174":119933,"_29767":192844,"_5":21387,"_28235":192591,"_5797":192845},[],"**Payload Encoding**: codificación del mensaje.",{"_6892":120036,"_42174":119933,"_29767":192847,"_5":21387,"_28235":192591,"_5797":192848},[],"**Message**: mensaje original o hash.",{"_6892":120037,"_42174":119933,"_29767":192850,"_5":21387,"_28235":192591,"_5797":192851},[],"**Signature**: firma que se desea comprobar.",{"_6892":120038,"_42174":119933,"_29767":192853,"_5":21387,"_28235":192591,"_5797":192854},[],"**Result**: indicador del resultado de la validación.",{"_6892":120039,"_42174":119933,"_29767":192856,"_5":21387,"_28235":192594,"_5797":192857},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_6892":120040,"_42174":119933,"_29767":192859,"_5":21387,"_28235":192594,"_5797":192860},[],"Este flujo es útil para:",{"_6892":120041,"_42174":119933,"_29767":192862,"_5":21387,"_28235":192594,"_5797":192863},[],"Solicitar certificados a una CA externa.",{"_6892":120042,"_42174":119933,"_29767":192865,"_5":21387,"_28235":192594,"_5797":192866},[],"Renovar una identidad manteniendo la misma clave.",{"_6892":120043,"_42174":119933,"_29767":192868,"_5":21387,"_28235":192594,"_5797":192869},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_6892":120044,"_42174":119933,"_29767":192871,"_5":21387,"_28235":192594,"_5797":192872},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_6892":120045,"_42174":119933,"_29767":192874,"_5":21387,"_28235":192594,"_5797":192875},[],"**Organization (O)**: organización o empresa.",{"_6892":120046,"_42174":119933,"_29767":192877,"_5":21387,"_28235":192594,"_5797":192878},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_6892":120047,"_42174":119933,"_29767":192880,"_5":21387,"_28235":192594,"_5797":192881},[],"**Country (C)**: código de país de dos letras.",{"_6892":120048,"_42174":119933,"_29767":192883,"_5":21387,"_28235":192594,"_5797":192884},[],"**State / Province (ST)**: estado o provincia.",{"_6892":120049,"_42174":119933,"_29767":192886,"_5":21387,"_28235":192594,"_5797":192887},[],"**Locality (L)**: ciudad o localidad.",{"_6892":120050,"_42174":119933,"_29767":192889,"_5":21387,"_28235":192594,"_5797":192890},[],"**Email Address**: correo de contacto.",{"_6892":120051,"_42174":119933,"_29767":192892,"_5":21387,"_28235":192594,"_5797":192893},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_6892":120052,"_42174":119933,"_29767":192895,"_5":21387,"_28235":192594,"_5797":192896},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_6892":120053,"_42174":119933,"_29767":192898,"_5":21387,"_28235":192598,"_5797":192899},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_6892":120054,"_42174":119933,"_29767":192901,"_5":21387,"_28235":192598,"_5797":84501},[],{"_6892":120055,"_42174":119933,"_29767":192903,"_5":21387,"_28235":192602,"_5797":192904},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_6892":120056,"_42174":120056,"_5":21817,"_5797":192906,"_42654":192907,"_29767":192908,"_28235":120056},"Validación online con OCSP",[77248,187247,82716,191764],[],{"_6892":120057,"_42174":120056,"_29767":192910,"_5":21387,"_28235":120056,"_5797":192911},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_6892":120058,"_42174":120056,"_5":42651,"_29767":192913,"_28235":192914,"_5797":192915},[],"/docs/pr-preview/pr-56/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_6892":120059,"_42174":120056,"_5":42651,"_29767":192917,"_28235":192918,"_5797":192919},[],"/docs/pr-preview/pr-56/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_6892":120060,"_42174":120056,"_5":42651,"_29767":192921,"_28235":192922,"_5797":192923},[],"/docs/pr-preview/pr-56/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_6892":120061,"_42174":120056,"_5":42651,"_29767":192925,"_28235":192926,"_5797":192927},[],"/docs/pr-preview/pr-56/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_6892":120062,"_42174":120056,"_5":42651,"_29767":192929,"_28235":192930,"_5797":192931},[],"/docs/pr-preview/pr-56/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_6892":120063,"_42174":120056,"_5":42651,"_29767":192933,"_28235":192934,"_5797":192316},[],"/docs/pr-preview/pr-56/es/platform/pki/ocsp#referencias",{"_6892":120064,"_42174":120056,"_29767":192936,"_5":21387,"_28235":120056,"_5797":192937},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_6892":120065,"_42174":120056,"_29767":192939,"_5":21387,"_28235":192914,"_5797":192940},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_6892":120066,"_42174":120056,"_29767":192942,"_5":21387,"_28235":192914,"_5797":192943},[],"Estado del registro",{"_6892":120067,"_42174":120056,"_29767":192945,"_5":21387,"_28235":192914,"_5797":192946},[],"Respuesta firmada",{"_6892":120068,"_42174":120056,"_29767":192948,"_5":21387,"_28235":192914,"_5797":81874},[],{"_6892":120069,"_42174":120056,"_29767":192950,"_5":21387,"_28235":192914,"_5797":84551},[],{"_6892":120070,"_42174":120056,"_29767":192952,"_5":21387,"_28235":192914,"_5797":81891},[],{"_6892":120071,"_42174":120056,"_29767":192954,"_5":21387,"_28235":192914,"_5797":192955},[],"`Revoked`, con razón y fecha de revocación.",{"_6892":120072,"_42174":120056,"_29767":192957,"_5":21387,"_28235":192914,"_5797":192958},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_6892":120073,"_42174":120056,"_29767":192960,"_5":21387,"_28235":192914,"_5797":192961},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_6892":120074,"_42174":120056,"_29767":192963,"_5":21387,"_28235":192914,"_5797":192964},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_6892":120075,"_42174":120056,"_29767":192966,"_5":21387,"_28235":192914,"_5797":192967},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_6892":120076,"_42174":120056,"_29767":192969,"_5":21387,"_28235":192914,"_5797":192970},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_6892":120077,"_42174":120056,"_29767":192972,"_5":21387,"_28235":192918,"_5797":192973},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_6892":120078,"_42174":120056,"_29767":192975,"_5":21387,"_28235":192918,"_5797":192976},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_6892":120079,"_42174":120056,"_29767":192978,"_5":21387,"_28235":192922,"_5797":192979},[],"El servicio acepta:",{"_6892":120080,"_42174":120056,"_29767":192981,"_5":21387,"_28235":192922,"_5797":188971},[],{"_6892":120081,"_42174":120056,"_29767":192983,"_5":21387,"_28235":192922,"_5797":192984},[],"Ruta del servicio VA",{"_6892":120082,"_42174":120056,"_29767":192986,"_5":21387,"_28235":192922,"_5797":192987},[],"Formato",{"_6892":120083,"_42174":120056,"_29767":192989,"_5":21387,"_28235":192922,"_5797":84591},[],{"_6892":120084,"_42174":120056,"_29767":192991,"_5":21387,"_28235":192922,"_5797":84594},[],{"_6892":120085,"_42174":120056,"_29767":192993,"_5":21387,"_28235":192922,"_5797":192994},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_6892":120086,"_42174":120056,"_29767":192996,"_5":21387,"_28235":192922,"_5797":84023},[],{"_6892":120087,"_42174":120056,"_29767":192998,"_5":21387,"_28235":192922,"_5797":84602},[],{"_6892":120088,"_42174":120056,"_29767":193000,"_5":21387,"_28235":192922,"_5797":193001},[],"Solicitud DER codificada en Base64 URL con padding.",{"_6892":120089,"_42174":120056,"_29767":193003,"_5":21387,"_28235":192922,"_5797":193004},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_6892":120090,"_42174":120056,"_29767":193006,"_5":21387,"_28235":192926,"_5797":193007},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_6892":120091,"_42174":120056,"_29767":193009,"_5":21387,"_28235":192926,"_5797":193010},[],"Genera la solicitud:",{"_6892":120092,"_42174":120056,"_29767":193012,"_5":21387,"_28235":192926,"_5797":193013},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_6892":120093,"_42174":120056,"_29767":193015,"_5":21387,"_28235":192926,"_5797":193016},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_6892":120094,"_42174":120056,"_29767":193018,"_5":21387,"_28235":192926,"_5797":193019},[],"Verifica el DER recibido:",{"_6892":120095,"_42174":120056,"_29767":193021,"_5":21387,"_28235":192926,"_5797":193022},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_6892":120096,"_42174":120056,"_29767":193024,"_5":21387,"_28235":192930,"_5797":193025},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_6892":120097,"_42174":120056,"_29767":193027,"_5":21387,"_28235":192930,"_5797":193028},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_6892":120098,"_42174":120056,"_29767":193030,"_5":21387,"_28235":192934,"_5797":84635},[],{"_6892":120099,"_42174":120056,"_29767":193032,"_5":21387,"_28235":192934,"_5797":84638},[],{"_6892":120100,"_42174":120056,"_29767":193034,"_5":21387,"_28235":192934,"_5797":193035},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_6892":120101,"_42174":120056,"_29767":193037,"_5":21387,"_28235":192934,"_5797":192524},[],{"_6892":120102,"_42174":120102,"_5":21817,"_5797":82716,"_42654":193039,"_29767":193040,"_28235":120102},[77248,187247,82716],[],{"_6892":120103,"_42174":120102,"_29767":193042,"_5":21387,"_28235":120102,"_5797":193043},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_6892":120104,"_42174":120102,"_5":42651,"_29767":193045,"_28235":193046,"_5797":190452},[],"/docs/pr-preview/pr-56/es/platform/pki/overview#empieza-aquí",{"_6892":120105,"_42174":120102,"_5":42651,"_29767":193048,"_28235":193049,"_5797":193050},[],"/docs/pr-preview/pr-56/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_6892":120106,"_42174":120102,"_5":42651,"_29767":193052,"_28235":193053,"_5797":190985},[],"/docs/pr-preview/pr-56/es/platform/pki/overview#capacidades-principales",{"_6892":120107,"_42174":120102,"_5":42651,"_29767":193055,"_28235":193056,"_5797":190989},[],"/docs/pr-preview/pr-56/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_6892":120108,"_42174":120102,"_5":42651,"_29767":193058,"_28235":193059,"_5797":190993},[],"/docs/pr-preview/pr-56/es/platform/pki/overview#protege-las-claves-criptográficas",{"_6892":120109,"_42174":120102,"_5":42651,"_29767":193061,"_28235":193062,"_5797":190997},[],"/docs/pr-preview/pr-56/es/platform/pki/overview#emite-y-controla-certificados",{"_6892":120110,"_42174":120102,"_5":42651,"_29767":193064,"_28235":193065,"_5797":191005},[],"/docs/pr-preview/pr-56/es/platform/pki/overview#publica-el-estado-de-validación",{"_6892":120111,"_42174":120102,"_5":42651,"_29767":193067,"_28235":193068,"_5797":193069},[],"/docs/pr-preview/pr-56/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_6892":120112,"_42174":120102,"_5":42651,"_29767":193071,"_28235":193072,"_5797":191930},[],"/docs/pr-preview/pr-56/es/platform/pki/overview#continúa",{"_6892":120113,"_42174":120102,"_29767":193074,"_5":21387,"_28235":120102,"_5797":193075},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_6892":120114,"_42174":120102,"_29767":193077,"_5":21387,"_28235":193046,"_5797":193078},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_6892":120115,"_42174":120102,"_29767":193080,"_5":21387,"_28235":193046,"_5797":193081},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_6892":120116,"_42174":120102,"_29767":193083,"_5":21387,"_28235":193049,"_5797":193084},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_6892":120117,"_42174":120102,"_29767":193086,"_5":21387,"_28235":193049,"_5797":193087},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_6892":120118,"_42174":120102,"_29767":193089,"_5":21387,"_28235":193049,"_5797":193090},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_6892":120119,"_42174":120102,"_29767":193092,"_5":21387,"_28235":193049,"_5797":193093},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_6892":120120,"_42174":120102,"_29767":193095,"_5":21387,"_28235":193049,"_5797":193096},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_6892":120121,"_42174":120102,"_29767":193098,"_5":21387,"_28235":193056,"_5797":193099},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_6892":120122,"_42174":120102,"_29767":193101,"_5":21387,"_28235":193059,"_5797":193102},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_6892":120123,"_42174":120102,"_29767":193104,"_5":21387,"_28235":193062,"_5797":193105},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_6892":120124,"_42174":120102,"_29767":193107,"_5":21387,"_28235":193065,"_5797":193108},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_6892":120125,"_42174":120102,"_29767":193110,"_5":21387,"_28235":193068,"_5797":193111},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_6892":120126,"_42174":120102,"_29767":193113,"_5":21387,"_28235":193068,"_5797":193114},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_6892":120127,"_42174":120102,"_29767":193116,"_5":21387,"_28235":193068,"_5797":193117},[],"su clave pública corresponda a la clave privada del cliente;",{"_6892":120128,"_42174":120102,"_29767":193119,"_5":21387,"_28235":193068,"_5797":193120},[],"su cadena alcance una raíz confiable para el consumidor;",{"_6892":120129,"_42174":120102,"_29767":193122,"_5":21387,"_28235":193068,"_5797":193123},[],"sus fechas y usos permitan la operación;",{"_6892":120130,"_42174":120102,"_29767":193125,"_5":21387,"_28235":193068,"_5797":193126},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_6892":120131,"_42174":120102,"_29767":193128,"_5":21387,"_28235":193068,"_5797":193129},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_6892":120132,"_42174":120102,"_29767":193131,"_5":21387,"_28235":193072,"_5797":193132},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_6892":120133,"_42174":120102,"_29767":193134,"_5":21387,"_28235":193072,"_5797":193135},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_6892":120134,"_42174":120102,"_29767":193137,"_5":21387,"_28235":193072,"_5797":193138},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_6892":120135,"_42174":120135,"_5":21817,"_5797":193140,"_42654":193141,"_29767":193142,"_28235":120135},"Crea tu primera CA",[77248,187247,82716,190589],[],{"_6892":120136,"_42174":120135,"_29767":193144,"_5":21387,"_28235":120135,"_5797":193145},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_6892":120137,"_42174":120135,"_5":42651,"_29767":193147,"_28235":193148,"_5797":185844},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_6892":120138,"_42174":120135,"_5":42651,"_29767":193150,"_28235":193151,"_5797":193152},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_6892":120139,"_42174":120135,"_5":42651,"_29767":193154,"_28235":193155,"_5797":193156},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_6892":120140,"_42174":120135,"_5":42651,"_29767":193158,"_28235":193159,"_5797":193160},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_6892":120141,"_42174":120135,"_5":42651,"_29767":193162,"_28235":193163,"_5797":193164},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_6892":120142,"_42174":120135,"_5":42651,"_29767":193166,"_28235":193167,"_5797":193168},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_6892":120143,"_42174":120135,"_5":42651,"_29767":193170,"_28235":193171,"_5797":193172},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_6892":120144,"_42174":120135,"_5":42651,"_29767":193174,"_28235":193175,"_5797":190836},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_6892":120145,"_42174":120135,"_5":42651,"_29767":193177,"_28235":193178,"_5797":185868},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_6892":120146,"_42174":120135,"_29767":193180,"_5":21387,"_28235":120135,"_5797":193181},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_6892":120147,"_42174":120135,"_29767":193183,"_5":21387,"_28235":193148,"_5797":193184},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_6892":120148,"_42174":120135,"_29767":193186,"_5":21387,"_28235":193148,"_5797":193187},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_6892":120149,"_42174":120135,"_29767":193189,"_5":21387,"_28235":193148,"_5797":193190},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_6892":120150,"_42174":120135,"_29767":193192,"_5":21387,"_28235":193148,"_5797":193193},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_6892":120151,"_42174":120135,"_29767":193195,"_5":21387,"_28235":193151,"_5797":193196},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_6892":120152,"_42174":120135,"_29767":193198,"_5":21387,"_28235":193151,"_5797":193199},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_6892":120153,"_42174":120135,"_29767":193201,"_5":21387,"_28235":193155,"_5797":193202},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_6892":120154,"_42174":120135,"_29767":193204,"_5":21387,"_28235":193155,"_5797":193205},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_6892":120155,"_42174":120135,"_29767":193207,"_5":21387,"_28235":193159,"_5797":193208},[],"Selecciona **Root CA** y completa:",{"_6892":120156,"_42174":120135,"_29767":193210,"_5":21387,"_28235":193159,"_5797":84817},[],{"_6892":120157,"_42174":120135,"_29767":193212,"_5":21387,"_28235":193159,"_5797":193213},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_6892":120158,"_42174":120135,"_29767":193215,"_5":21387,"_28235":193159,"_5797":193216},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_6892":120159,"_42174":120135,"_29767":193218,"_5":21387,"_28235":193159,"_5797":193219},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_6892":120160,"_42174":120135,"_29767":193221,"_5":21387,"_28235":193159,"_5797":193222},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_6892":120161,"_42174":120135,"_29767":193224,"_5":21387,"_28235":193163,"_5797":193225},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_6892":120162,"_42174":120135,"_29767":193227,"_5":21387,"_28235":193167,"_5797":193228},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_6892":120163,"_42174":120135,"_29767":193230,"_5":21387,"_28235":193167,"_5797":193231},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_6892":120164,"_42174":120135,"_29767":193233,"_5":21387,"_28235":193171,"_5797":193234},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_6892":120165,"_42174":120135,"_29767":193236,"_5":21387,"_28235":193171,"_5797":193237},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_6892":120166,"_42174":120135,"_29767":193239,"_5":21387,"_28235":193171,"_5797":193240},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_6892":120167,"_42174":120135,"_29767":193242,"_5":21387,"_28235":193175,"_5797":193243},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_6892":120168,"_42174":120135,"_29767":193245,"_5":21387,"_28235":193175,"_5797":193246},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_6892":120169,"_42174":120135,"_29767":193248,"_5":21387,"_28235":193175,"_5797":193249},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_6892":120170,"_42174":120135,"_29767":193251,"_5":21387,"_28235":193175,"_5797":193252},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_6892":120171,"_42174":120135,"_29767":193254,"_5":21387,"_28235":193178,"_5797":193255},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_6892":120172,"_42174":120172,"_5":21817,"_5797":193257,"_42654":193258,"_29767":193259,"_28235":120172},"Emite y verifica un certificado",[77248,187247,82716,190589],[],{"_6892":120173,"_42174":120172,"_29767":193261,"_5":21387,"_28235":120172,"_5797":193262},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_6892":120174,"_42174":120172,"_5":42651,"_29767":193264,"_28235":193265,"_5797":185844},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_6892":120175,"_42174":120172,"_5":42651,"_29767":193267,"_28235":193268,"_5797":193269},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_6892":120176,"_42174":120172,"_5":42651,"_29767":193271,"_28235":193272,"_5797":193273},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_6892":120177,"_42174":120172,"_5":42651,"_29767":193275,"_28235":193276,"_5797":193277},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_6892":120178,"_42174":120172,"_5":42651,"_29767":193279,"_28235":193280,"_5797":193281},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_6892":120179,"_42174":120172,"_5":42651,"_29767":193283,"_28235":193284,"_5797":193285},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_6892":120180,"_42174":120172,"_5":42651,"_29767":193287,"_28235":193288,"_5797":193289},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_6892":120181,"_42174":120172,"_5":42651,"_29767":193291,"_28235":193292,"_5797":193293},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_6892":120182,"_42174":120172,"_5":42651,"_29767":193295,"_28235":193296,"_5797":193297},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_6892":120183,"_42174":120172,"_5":42651,"_29767":193299,"_28235":193300,"_5797":193301},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_6892":120184,"_42174":120172,"_5":42651,"_29767":193303,"_28235":193304,"_5797":190836},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_6892":120185,"_42174":120172,"_5":42651,"_29767":193306,"_28235":193307,"_5797":185868},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_6892":120186,"_42174":120172,"_29767":193309,"_5":21387,"_28235":120172,"_5797":193310},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_6892":120187,"_42174":120172,"_29767":193312,"_5":21387,"_28235":193265,"_5797":193313},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_6892":120188,"_42174":120172,"_29767":193315,"_5":21387,"_28235":193265,"_5797":193316},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_6892":120189,"_42174":120172,"_29767":193318,"_5":21387,"_28235":193265,"_5797":193319},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_6892":120190,"_42174":120172,"_29767":193321,"_5":21387,"_28235":193265,"_5797":193322},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_6892":120191,"_42174":120172,"_29767":193324,"_5":21387,"_28235":193265,"_5797":193325},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_6892":120192,"_42174":120172,"_29767":193327,"_5":21387,"_28235":193268,"_5797":193328},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_6892":120193,"_42174":120172,"_29767":193330,"_5":21387,"_28235":193272,"_5797":193331},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_6892":120194,"_42174":120172,"_29767":193333,"_5":21387,"_28235":193272,"_5797":193334},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_6892":120195,"_42174":120172,"_29767":193336,"_5":21387,"_28235":193276,"_5797":193337},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_6892":120196,"_42174":120172,"_29767":193339,"_5":21387,"_28235":193276,"_5797":193340},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_6892":120197,"_42174":120172,"_29767":193342,"_5":21387,"_28235":193280,"_5797":193343},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_6892":120198,"_42174":120172,"_29767":193345,"_5":21387,"_28235":193280,"_5797":193346},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_6892":120199,"_42174":120172,"_29767":193348,"_5":21387,"_28235":193284,"_5797":193349},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_6892":120200,"_42174":120172,"_29767":193351,"_5":21387,"_28235":193288,"_5797":193352},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_6892":120201,"_42174":120172,"_29767":193354,"_5":21387,"_28235":193292,"_5797":193355},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_6892":120202,"_42174":120172,"_29767":193357,"_5":21387,"_28235":193296,"_5797":193358},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_6892":120203,"_42174":120172,"_29767":193360,"_5":21387,"_28235":193296,"_5797":193361},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_6892":120204,"_42174":120172,"_29767":193363,"_5":21387,"_28235":193296,"_5797":193364},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_6892":120205,"_42174":120172,"_29767":193366,"_5":21387,"_28235":193300,"_5797":193367},[],"En Bash, compara los dos resúmenes de clave pública:",{"_6892":120206,"_42174":120172,"_29767":193369,"_5":21387,"_28235":193300,"_5797":193370},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_6892":120207,"_42174":120172,"_29767":193372,"_5":21387,"_28235":193300,"_5797":193373},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_6892":120208,"_42174":120172,"_29767":193375,"_5":21387,"_28235":193304,"_5797":190919},[],{"_6892":120209,"_42174":120172,"_29767":193377,"_5":21387,"_28235":193304,"_5797":189420},[],{"_6892":120210,"_42174":120172,"_29767":193379,"_5":21387,"_28235":193304,"_5797":193380},[],"La CA rechaza la emisión",{"_6892":120211,"_42174":120172,"_29767":193382,"_5":21387,"_28235":193304,"_5797":193383},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_6892":120212,"_42174":120172,"_29767":193385,"_5":21387,"_28235":193304,"_5797":193386},[],"Sujeto o usos diferentes",{"_6892":120213,"_42174":120172,"_29767":193388,"_5":21387,"_28235":193304,"_5797":193389},[],"Perfil aplicado y valores solicitados.",{"_6892":120214,"_42174":120172,"_29767":193391,"_5":21387,"_28235":193304,"_5797":193392},[],"No se encuentra el emisor",{"_6892":120215,"_42174":120172,"_29767":193394,"_5":21387,"_28235":193304,"_5797":193395},[],"CA descargada y cadena intermedia necesaria.",{"_6892":120216,"_42174":120172,"_29767":193397,"_5":21387,"_28235":193304,"_5797":193398},[],"Falla la vigencia",{"_6892":120217,"_42174":120172,"_29767":193400,"_5":21387,"_28235":193304,"_5797":193401},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_6892":120218,"_42174":120172,"_29767":193403,"_5":21387,"_28235":193304,"_5797":193404},[],"Los resúmenes de clave difieren",{"_6892":120219,"_42174":120172,"_29767":193406,"_5":21387,"_28235":193304,"_5797":193407},[],"Archivos de certificado y clave de la misma emisión.",{"_6892":120220,"_42174":120172,"_29767":193409,"_5":21387,"_28235":193304,"_5797":193410},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_6892":120221,"_42174":120172,"_29767":193412,"_5":21387,"_28235":193307,"_5797":193413},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_6892":120222,"_42174":120172,"_29767":193415,"_5":21387,"_28235":193307,"_5797":193416},[],"Gestionar certificados para inspección, estado y revocación.",{"_6892":120223,"_42174":120172,"_29767":193418,"_5":21387,"_28235":193307,"_5797":193419},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_6892":120224,"_42174":120172,"_29767":193421,"_5":21387,"_28235":193307,"_5797":193422},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_6892":120225,"_42174":120172,"_29767":193424,"_5":21387,"_28235":193307,"_5797":193425},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_6892":120226,"_42174":120226,"_5":21817,"_5797":193427,"_42654":193428,"_29767":193429,"_28235":120226},"Primeros pasos de PKI",[77248,187247,82716,190589],[],{"_6892":120227,"_42174":120226,"_29767":193431,"_5":21387,"_28235":120226,"_5797":193432},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_6892":120228,"_42174":120226,"_5":42651,"_29767":193434,"_28235":193435,"_5797":185844},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_6892":120229,"_42174":120226,"_5":42651,"_29767":193437,"_28235":193438,"_5797":193439},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_6892":120230,"_42174":120226,"_5":42651,"_29767":193441,"_28235":193442,"_5797":190771},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/overview#resultado-esperado",{"_6892":120231,"_42174":120226,"_5":42651,"_29767":193444,"_28235":193445,"_5797":193446},[],"/docs/pr-preview/pr-56/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_6892":120232,"_42174":120226,"_29767":193448,"_5":21387,"_28235":120226,"_5797":193449},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_6892":120233,"_42174":120226,"_29767":193451,"_5":21387,"_28235":193435,"_5797":193452},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_6892":120234,"_42174":120226,"_29767":193454,"_5":21387,"_28235":193435,"_5797":193455},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_6892":120235,"_42174":120226,"_29767":193457,"_5":21387,"_28235":193435,"_5797":193458},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_6892":120236,"_42174":120226,"_29767":193460,"_5":21387,"_28235":193435,"_5797":193461},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_6892":120237,"_42174":120226,"_29767":193463,"_5":21387,"_28235":193435,"_5797":193464},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_6892":120238,"_42174":120226,"_29767":193466,"_5":21387,"_28235":193438,"_5797":193467},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_6892":120239,"_42174":120226,"_29767":193469,"_5":21387,"_28235":193438,"_5797":193470},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_6892":120240,"_42174":120226,"_29767":193472,"_5":21387,"_28235":193438,"_5797":193473},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_6892":120241,"_42174":120226,"_29767":193475,"_5":21387,"_28235":193438,"_5797":193476},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_6892":120242,"_42174":120226,"_29767":193478,"_5":21387,"_28235":193442,"_5797":193479},[],"Archivo o recurso",{"_6892":120243,"_42174":120226,"_29767":193481,"_5":21387,"_28235":193442,"_5797":190768},[],{"_6892":120244,"_42174":120226,"_29767":193483,"_5":21387,"_28235":193442,"_5797":193484},[],"CA raíz activa y `ca.pem`",{"_6892":120245,"_42174":120226,"_29767":193486,"_5":21387,"_28235":193442,"_5797":193487},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_6892":120246,"_42174":120226,"_29767":193489,"_5":21387,"_28235":193442,"_5797":193490},[],"Certificado final y `device.crt`",{"_6892":120247,"_42174":120226,"_29767":193492,"_5":21387,"_28235":193442,"_5797":193493},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_6892":120248,"_42174":120226,"_29767":193495,"_5":21387,"_28235":193442,"_5797":193496},[],"Clave privada `device.key`",{"_6892":120249,"_42174":120226,"_29767":193498,"_5":21387,"_28235":193442,"_5797":193499},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_6892":120250,"_42174":120226,"_29767":193501,"_5":21387,"_28235":193442,"_5797":193502},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_6892":120251,"_42174":120226,"_29767":193504,"_5":21387,"_28235":193445,"_5797":193505},[],"Para operar certificados, continúa con Certificados y Validación.",{"_6892":120252,"_42174":120226,"_29767":193507,"_5":21387,"_28235":193445,"_5797":193508},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_6892":120253,"_42174":120226,"_29767":193510,"_5":21387,"_28235":193445,"_5797":193511},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_6892":120254,"_42174":120254,"_5":21817,"_5797":193513,"_42654":193514,"_29767":193516,"_28235":120254},"Resolución de problemas PKI",[77248,187247,82716,193515],"Resolución de problemas",[],{"_6892":120255,"_42174":120254,"_29767":193518,"_5":21387,"_28235":120254,"_5797":193519},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_6892":120256,"_42174":120254,"_5":42651,"_29767":193521,"_28235":193522,"_5797":193523},[],"/docs/pr-preview/pr-56/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_6892":120257,"_42174":120254,"_5":42651,"_29767":193525,"_28235":193526,"_5797":193527},[],"/docs/pr-preview/pr-56/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_6892":120258,"_42174":120254,"_5":42651,"_29767":193529,"_28235":193530,"_5797":193531},[],"/docs/pr-preview/pr-56/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_6892":120259,"_42174":120254,"_29767":193533,"_5":21387,"_28235":120254,"_5797":193534},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_6892":120260,"_42174":120254,"_29767":193536,"_5":21387,"_28235":120254,"_5797":193537},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_6892":120261,"_42174":120254,"_29767":193539,"_5":21387,"_28235":193522,"_5797":190768},[],{"_6892":120262,"_42174":120254,"_29767":193541,"_5":21387,"_28235":193522,"_5797":189420},[],{"_6892":120263,"_42174":120254,"_29767":193543,"_5":21387,"_28235":193522,"_5797":185868},[],{"_6892":120264,"_42174":120254,"_29767":193545,"_5":21387,"_28235":193522,"_5797":81542},[],{"_6892":120265,"_42174":120254,"_29767":193547,"_5":21387,"_28235":193522,"_5797":193548},[],"Existe, está activa y sus fechas son utilizables.",{"_6892":120266,"_42174":120254,"_29767":193550,"_5":21387,"_28235":193522,"_5797":193551},[],"Autoridades.",{"_6892":120267,"_42174":120254,"_29767":193553,"_5":21387,"_28235":193522,"_5797":193554},[],"Clave",{"_6892":120268,"_42174":120254,"_29767":193556,"_5":21387,"_28235":193522,"_5797":193557},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_6892":120269,"_42174":120254,"_29767":193559,"_5":21387,"_28235":193522,"_5797":193560},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_6892":120270,"_42174":120254,"_29767":193562,"_5":21387,"_28235":193522,"_5797":85171},[],{"_6892":120271,"_42174":120254,"_29767":193564,"_5":21387,"_28235":193522,"_5797":193565},[],"PEM correcto y firma verificable.",{"_6892":120272,"_42174":120254,"_29767":193567,"_5":21387,"_28235":193522,"_5797":85177},[],{"_6892":120273,"_42174":120254,"_29767":193569,"_5":21387,"_28235":193522,"_5797":193570},[],"Perfil",{"_6892":120274,"_42174":120254,"_29767":193572,"_5":21387,"_28235":193522,"_5797":193573},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_6892":120275,"_42174":120254,"_29767":193575,"_5":21387,"_28235":193522,"_5797":193576},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_6892":120276,"_42174":120254,"_29767":193578,"_5":21387,"_28235":193522,"_5797":190919},[],{"_6892":120277,"_42174":120254,"_29767":193580,"_5":21387,"_28235":193522,"_5797":193581},[],"Sujeto, SAN, usos y fechas adecuados.",{"_6892":120278,"_42174":120254,"_29767":193583,"_5":21387,"_28235":193522,"_5797":193584},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_6892":120279,"_42174":120254,"_29767":193586,"_5":21387,"_28235":193522,"_5797":193587},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_6892":120280,"_42174":120254,"_29767":193589,"_5":21387,"_28235":193522,"_5797":193590},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_6892":120281,"_42174":120254,"_29767":193592,"_5":21387,"_28235":193526,"_5797":193593},[],"Revisa cada frontera por separado:",{"_6892":120282,"_42174":120254,"_29767":193595,"_5":21387,"_28235":193526,"_5797":193596},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_6892":120283,"_42174":120254,"_29767":193598,"_5":21387,"_28235":193526,"_5797":193599},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_6892":120284,"_42174":120254,"_29767":193601,"_5":21387,"_28235":193526,"_5797":193602},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_6892":120285,"_42174":120254,"_29767":193604,"_5":21387,"_28235":193526,"_5797":193605},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_6892":120286,"_42174":120254,"_29767":193607,"_5":21387,"_28235":193526,"_5797":193608},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_6892":120287,"_42174":120254,"_29767":193610,"_5":21387,"_28235":193526,"_5797":193611},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_6892":120288,"_42174":120254,"_29767":193613,"_5":21387,"_28235":193530,"_5797":193614},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_6892":120289,"_42174":120254,"_29767":193616,"_5":21387,"_28235":193530,"_5797":193617},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_6892":120290,"_42174":120290,"_5":21817,"_5797":193619,"_42654":193620,"_29767":193622,"_28235":120290},"Arquitectura",[77248,187247,193621,192003],"Actualizaciones",[],{"_6892":120291,"_42174":120290,"_29767":193624,"_5":21387,"_28235":120290,"_5797":193625},[],"Los componentes de Lamassu Updates, cómo se conectan en cada backend y qué se ejecuta en segundo plano.",{"_6892":120292,"_42174":120290,"_5":42651,"_29767":193627,"_28235":193628,"_5797":193629},[],"/docs/pr-preview/pr-56/es/platform/updates/architecture#modo-nativo","Modo nativo",{"_6892":120293,"_42174":120290,"_5":42651,"_29767":193631,"_28235":193632,"_5797":193633},[],"/docs/pr-preview/pr-56/es/platform/updates/architecture#cómo-se-conectan-los-dispositivos","Cómo se conectan los dispositivos",{"_6892":120294,"_42174":120290,"_5":42651,"_29767":193635,"_28235":193636,"_5797":193637},[],"/docs/pr-preview/pr-56/es/platform/updates/architecture#modo-hawkbit","Modo hawkBit",{"_6892":120295,"_42174":120290,"_5":42651,"_29767":193639,"_28235":193640,"_5797":193633},[],"/docs/pr-preview/pr-56/es/platform/updates/architecture#cómo-se-conectan-los-dispositivos-1",{"_6892":120296,"_42174":120290,"_5":42651,"_29767":193642,"_28235":193643,"_5797":193644},[],"/docs/pr-preview/pr-56/es/platform/updates/architecture#qué-se-ejecuta-dentro-del-servicio","Qué se ejecuta dentro del servicio",{"_6892":120297,"_42174":120290,"_5":42651,"_29767":193646,"_28235":193647,"_5797":193648},[],"/docs/pr-preview/pr-56/es/platform/updates/architecture#dependencias","Dependencias",{"_6892":120298,"_42174":120290,"_5":42651,"_29767":193650,"_28235":193651,"_5797":193652},[],"/docs/pr-preview/pr-56/es/platform/updates/architecture#dónde-se-almacena-cada-cosa","Dónde se almacena cada cosa",{"_6892":120299,"_42174":120290,"_5":42651,"_29767":193654,"_28235":193655,"_5797":193656},[],"/docs/pr-preview/pr-56/es/platform/updates/architecture#ejecutar-más-de-una-réplica","Ejecutar más de una réplica",{"_6892":120300,"_42174":120290,"_5":42651,"_29767":193658,"_28235":193659,"_5797":188883},[],"/docs/pr-preview/pr-56/es/platform/updates/architecture#siguientes-pasos",{"_6892":120301,"_42174":120290,"_29767":193661,"_5":21387,"_28235":120290,"_5797":193662},[],"Lamassu Updates es un único proceso que sirve la API de Updates (`/updates/v1`) y, embebido en ella, SymKMS (`/symkms/v1`). También responde a `GET /health`. Detrás de la API hay dos backends intercambiables. El ajuste `mode` elige uno al arrancar el servicio. Los clientes, incluido el dashboard de Lamassu, no pueden distinguirlos salvo a través de las capacidades.",{"_6892":120302,"_42174":120290,"_29767":193664,"_5":21387,"_28235":193628,"_5797":193665},[],"En modo nativo el servicio es dueño de los datos. Postgres guarda paquetes, lanzamientos e historial de dispositivos, WFX guarda un job por dispositivo, y el servicio gobierna ambos.",{"_6892":120303,"_42174":120290,"_29767":193667,"_5":21387,"_28235":193628,"_5797":193668},[],"El servicio es un único proceso. Sus partes, y cuáles usan cada dependencia, están en Qué se ejecuta dentro del servicio.",{"_6892":120304,"_42174":120290,"_29767":193670,"_5":21387,"_28235":193632,"_5797":193671},[],"Un dispositivo nunca habla con el servicio salvo para descargar su paquete. Consulta a WFX los jobs y le notifica cada cambio de estado. El servicio se entera de los cambios por el flujo de eventos de WFX.",{"_6892":120305,"_42174":120290,"_29767":193673,"_5":21387,"_28235":193632,"_5797":193674},[],"La dirección de descarga de cada job es la ruta de descarga del paquete bajo `update_domain`, con el ID del dispositivo añadido para que funcionen los paquetes por dispositivo y la autorización en el gateway. Cuando el almacén de blobs `builds` está en S3 con las descargas prefirmadas activadas, una descarga se responde con un `302` a una URL firmada de corta duración del objeto, en lugar de transmitir los bytes a través del servicio. El almacenamiento local siempre transmite. Ambos admiten peticiones `Range`, así que una descarga interrumpida se reanuda.",{"_6892":120306,"_42174":120290,"_29767":193676,"_5":21387,"_28235":193636,"_5797":193677},[],"En modo hawkBit el servicio es un gateway. Los paquetes se convierten en distribution sets, los lanzamientos en rollouts, y hawkBit es dueño de esos datos y se lee en vivo en cada petición. El servicio guarda en Postgres solo lo que hawkBit no tiene dónde almacenar. Consulta el Modelo de datos.",{"_6892":120307,"_42174":120290,"_29767":193679,"_5":21387,"_28235":193640,"_5797":193680},[],"Los dispositivos hablan con hawkBit y nunca con este servicio para consultar. Consultan la API DDI de hawkBit y le envían su feedback. El servicio lee el progreso de hawkBit cada vez que se le pide, y no tiene ningún flujo de eventos que seguir.",{"_6892":120308,"_42174":120290,"_29767":193682,"_5":21387,"_28235":193640,"_5797":193683},[],"La descarga del artefacto también puede pasar por este servicio. Sirve la ruta de artefactos de dispositivo de hawkBit (`/{tenant}/controller/v1/{controllerId}/softwaremodules/{id}/artifacts/{filename}`, bajo la ruta de `hawkbit.ddi_url`) sin reescribirla, de modo que un gateway delante de ambos siga aplicando sus reglas de autorización. El servicio solo responde por un módulo asignado o instalado en ese dispositivo, y en caso contrario devuelve `404`. Con el prefirmado activado en `hawkbit.artifact_store`, redirige (`302`) a una URL firmada del bucket S3 de hawkBit. Consulta Conectar un dispositivo.",{"_6892":120309,"_42174":120290,"_29767":193685,"_5":21387,"_28235":193643,"_5797":189035},[],{"_6892":120310,"_42174":120290,"_29767":193687,"_5":21387,"_28235":193643,"_5797":193688},[],"Qué hace",{"_6892":120311,"_42174":120290,"_29767":193690,"_5":21387,"_28235":193643,"_5797":193691},[],"Nativo",{"_6892":120312,"_42174":120290,"_29767":193693,"_5":21387,"_28235":193643,"_5797":85304},[],{"_6892":120313,"_42174":120290,"_29767":193695,"_5":21387,"_28235":193643,"_5797":193696},[],"API de Updates",{"_6892":120314,"_42174":120290,"_29767":193698,"_5":21387,"_28235":193643,"_5797":193699},[],"Paquetes, módulos, artefactos, lanzamientos, inventario de dispositivos, cumplimiento de versiones",{"_6892":120315,"_42174":120290,"_29767":193701,"_5":21387,"_28235":193643,"_5797":189875},[],{"_6892":120316,"_42174":120290,"_29767":193703,"_5":21387,"_28235":193643,"_5797":193704},[],"Sí (traducida a llamadas a hawkBit)",{"_6892":120317,"_42174":120290,"_29767":193706,"_5":21387,"_28235":193643,"_5797":85318},[],{"_6892":120318,"_42174":120290,"_29767":193708,"_5":21387,"_28235":193643,"_5797":193709},[],"Almacena claves simétricas y las asigna a dispositivos. Se usa en el cifrado compartido y por dispositivo",{"_6892":120319,"_42174":120290,"_29767":193711,"_5":21387,"_28235":193643,"_5797":189875},[],{"_6892":120320,"_42174":120290,"_29767":193713,"_5":21387,"_28235":193643,"_5797":193714},[],"Sí, para cifrado con clave compartida, si hay un almacenamiento SymKMS o `sym_keys_dir` configurado",{"_6892":120321,"_42174":120290,"_29767":193716,"_5":21387,"_28235":193643,"_5797":193717},[],"Constructor SWU",{"_6892":120322,"_42174":120290,"_29767":193719,"_5":21387,"_28235":193643,"_5797":193720},[],"Ejecuta `swugenerator` para ensamblar, firmar y cifrar paquetes `.swu`",{"_6892":120323,"_42174":120290,"_29767":193722,"_5":21387,"_28235":193643,"_5797":189875},[],{"_6892":120324,"_42174":120290,"_29767":193724,"_5":21387,"_28235":193643,"_5797":193725},[],"Sí (por módulo), si `swugenerator_path` está definido",{"_6892":120325,"_42174":120290,"_29767":193727,"_5":21387,"_28235":193643,"_5797":193728},[],"Almacenes de blobs",{"_6892":120326,"_42174":120290,"_29767":193730,"_5":21387,"_28235":193643,"_5797":193731},[],"Artefactos, builds y claves, en disco local o S3, opcionalmente cifrados en reposo",{"_6892":120327,"_42174":120290,"_29767":193733,"_5":21387,"_28235":193643,"_5797":189875},[],{"_6892":120328,"_42174":120290,"_29767":193735,"_5":21387,"_28235":193643,"_5797":193736},[],"Solo claves (los bytes de los artefactos viven en el almacén de artefactos de hawkBit)",{"_6892":120329,"_42174":120290,"_29767":193738,"_5":21387,"_28235":193643,"_5797":193739},[],"Consumidor de eventos de WFX",{"_6892":120330,"_42174":120290,"_29767":193741,"_5":21387,"_28235":193643,"_5797":193742},[],"Lee el flujo de eventos server-sent de WFX, actualiza el estado de cada dispositivo en su lanzamiento y libera el siguiente lote",{"_6892":120331,"_42174":120290,"_29767":193744,"_5":21387,"_28235":193643,"_5797":189875},[],{"_6892":120332,"_42174":120290,"_29767":193746,"_5":21387,"_28235":193643,"_5797":81448},[],{"_6892":120333,"_42174":120290,"_29767":193748,"_5":21387,"_28235":193643,"_5797":193749},[],"Disparador de lanzamientos programados",{"_6892":120334,"_42174":120290,"_29767":193751,"_5":21387,"_28235":193643,"_5797":193752},[],"Inicia los lanzamientos cuyo `scheduled_at` ha pasado, consultando cada 30 segundos, y repara los lotes cuyo envío se interrumpió",{"_6892":120335,"_42174":120290,"_29767":193754,"_5":21387,"_28235":193643,"_5797":189875},[],{"_6892":120336,"_42174":120290,"_29767":193756,"_5":21387,"_28235":193643,"_5797":193757},[],"No (el planificador propio de hawkBit)",{"_6892":120337,"_42174":120290,"_29767":193759,"_5":21387,"_28235":193643,"_5797":193760},[],"Elección de líder",{"_6892":120338,"_42174":120290,"_29767":193762,"_5":21387,"_28235":193643,"_5797":193763},[],"Garantiza que una sola réplica ejecute el trabajo en segundo plano",{"_6892":120339,"_42174":120290,"_29767":193765,"_5":21387,"_28235":193643,"_5797":189875},[],{"_6892":120340,"_42174":120290,"_29767":193767,"_5":21387,"_28235":193643,"_5797":193768},[],"No es necesaria",{"_6892":120341,"_42174":120290,"_29767":193770,"_5":21387,"_28235":193643,"_5797":193771},[],"Reconciliación",{"_6892":120342,"_42174":120290,"_29767":193773,"_5":21387,"_28235":193643,"_5797":193774},[],"Cada vez que se conecta el flujo de eventos (al arrancar y tras una caída), reproduce las finalizaciones de dispositivos que se perdió, porque el flujo no tiene repetición",{"_6892":120343,"_42174":120290,"_29767":193776,"_5":21387,"_28235":193643,"_5797":189875},[],{"_6892":120344,"_42174":120290,"_29767":193778,"_5":21387,"_28235":193643,"_5797":81448},[],{"_6892":120345,"_42174":120290,"_29767":193780,"_5":21387,"_28235":193643,"_5797":193781},[],"Descargas prefirmadas",{"_6892":120346,"_42174":120290,"_29767":193783,"_5":21387,"_28235":193643,"_5797":193784},[],"Responden las descargas con una redirección a una URL firmada del almacén de objetos",{"_6892":120347,"_42174":120290,"_29767":193786,"_5":21387,"_28235":193643,"_5797":193787},[],"Almacén `builds`",{"_6892":120348,"_42174":120290,"_29767":193789,"_5":21387,"_28235":193643,"_5797":85402},[],{"_6892":120349,"_42174":120290,"_29767":193791,"_5":21387,"_28235":193647,"_5797":193792},[],"Sistema",{"_6892":120350,"_42174":120290,"_29767":193794,"_5":21387,"_28235":193647,"_5797":188782},[],{"_6892":120351,"_42174":120290,"_29767":193796,"_5":21387,"_28235":193647,"_5797":193797},[],"Necesario en",{"_6892":120352,"_42174":120290,"_29767":193799,"_5":21387,"_28235":193647,"_5797":85414},[],{"_6892":120353,"_42174":120290,"_29767":193801,"_5":21387,"_28235":193647,"_5797":193802},[],"Los datos propios del servicio",{"_6892":120354,"_42174":120290,"_29767":193804,"_5":21387,"_28235":193647,"_5797":193805},[],"Ambos",{"_6892":120355,"_42174":120290,"_29767":193807,"_5":21387,"_28235":193647,"_5797":85423},[],{"_6892":120356,"_42174":120290,"_29767":193809,"_5":21387,"_28235":193647,"_5797":193810},[],"Fuente de grupos de dispositivos y dispositivos",{"_6892":120357,"_42174":120290,"_29767":193812,"_5":21387,"_28235":193647,"_5797":193813},[],"Nativo. Opcional en modo hawkBit: sin él, el servicio lee las etiquetas `group:<id>` de los targets del propio hawkBit",{"_6892":120358,"_42174":120290,"_29767":193815,"_5":21387,"_28235":193647,"_5797":85432},[],{"_6892":120359,"_42174":120290,"_29767":193817,"_5":21387,"_28235":193647,"_5797":193818},[],"Claves de firma, para el paquete y para los manifiestos de versión",{"_6892":120360,"_42174":120290,"_29767":193820,"_5":21387,"_28235":193647,"_5797":193821},[],"Al firmar",{"_6892":120361,"_42174":120290,"_29767":193823,"_5":21387,"_28235":193647,"_5797":85441},[],{"_6892":120362,"_42174":120290,"_29767":193825,"_5":21387,"_28235":193647,"_5797":193826},[],"Orquestación de jobs",{"_6892":120363,"_42174":120290,"_29767":193828,"_5":21387,"_28235":193647,"_5797":193691},[],{"_6892":120364,"_42174":120290,"_29767":193830,"_5":21387,"_28235":193647,"_5797":85449},[],{"_6892":120365,"_42174":120290,"_29767":193832,"_5":21387,"_28235":193647,"_5797":193833},[],"El servidor de actualizaciones",{"_6892":120366,"_42174":120290,"_29767":193835,"_5":21387,"_28235":193647,"_5797":85304},[],{"_6892":120367,"_42174":120290,"_29767":193837,"_5":21387,"_28235":193647,"_5797":193838},[],"swugenerator (incluido)",{"_6892":120368,"_42174":120290,"_29767":193840,"_5":21387,"_28235":193647,"_5797":193841},[],"Construye ficheros `.swu`",{"_6892":120369,"_42174":120290,"_29767":193843,"_5":21387,"_28235":193647,"_5797":193844},[],"Al construir",{"_6892":120370,"_42174":120290,"_29767":193846,"_5":21387,"_28235":193651,"_5797":193847},[],"Dato",{"_6892":120371,"_42174":120290,"_29767":193849,"_5":21387,"_28235":193651,"_5797":193691},[],{"_6892":120372,"_42174":120290,"_29767":193851,"_5":21387,"_28235":193651,"_5797":85304},[],{"_6892":120373,"_42174":120290,"_29767":193853,"_5":21387,"_28235":193651,"_5797":193854},[],"Paquetes, versiones, módulos",{"_6892":120374,"_42174":120290,"_29767":193856,"_5":21387,"_28235":193651,"_5797":85476},[],{"_6892":120375,"_42174":120290,"_29767":193858,"_5":21387,"_28235":193651,"_5797":85304},[],{"_6892":120376,"_42174":120290,"_29767":193860,"_5":21387,"_28235":193651,"_5797":193861},[],"Bytes de los artefactos",{"_6892":120377,"_42174":120290,"_29767":193863,"_5":21387,"_28235":193651,"_5797":193864},[],"Almacén de blobs (`artifacts`)",{"_6892":120378,"_42174":120290,"_29767":193866,"_5":21387,"_28235":193651,"_5797":193867},[],"Almacén de artefactos de hawkBit",{"_6892":120379,"_42174":120290,"_29767":193869,"_5":21387,"_28235":193651,"_5797":193870},[],"`.swu` y paquetes construidos",{"_6892":120380,"_42174":120290,"_29767":193872,"_5":21387,"_28235":193651,"_5797":193873},[],"Almacén de blobs (`builds`)",{"_6892":120381,"_42174":120290,"_29767":193875,"_5":21387,"_28235":193651,"_5797":193876},[],"hawkBit (como artefactos de módulo)",{"_6892":120382,"_42174":120290,"_29767":193878,"_5":21387,"_28235":193651,"_5797":37350},[],{"_6892":120383,"_42174":120290,"_29767":193880,"_5":21387,"_28235":193651,"_5797":193881},[],"Postgres (una columna del paquete y del módulo)",{"_6892":120384,"_42174":120290,"_29767":193883,"_5":21387,"_28235":193651,"_5797":85414},[],{"_6892":120385,"_42174":120290,"_29767":193885,"_5":21387,"_28235":193651,"_5797":193886},[],"Lanzamientos y asignaciones de dispositivos",{"_6892":120386,"_42174":120290,"_29767":193888,"_5":21387,"_28235":193651,"_5797":85414},[],{"_6892":120387,"_42174":120290,"_29767":193890,"_5":21387,"_28235":193651,"_5797":193891},[],"Rollouts y actions de hawkBit",{"_6892":120388,"_42174":120290,"_29767":193893,"_5":21387,"_28235":193651,"_5797":193894},[],"Jobs de dispositivo",{"_6892":120389,"_42174":120290,"_29767":193896,"_5":21387,"_28235":193651,"_5797":85441},[],{"_6892":120390,"_42174":120290,"_29767":193898,"_5":21387,"_28235":193651,"_5797":193899},[],"Actions de hawkBit",{"_6892":120391,"_42174":120290,"_29767":193901,"_5":21387,"_28235":193651,"_5797":193902},[],"Historial de actualizaciones de dispositivo",{"_6892":120392,"_42174":120290,"_29767":193904,"_5":21387,"_28235":193651,"_5797":85414},[],{"_6892":120393,"_42174":120290,"_29767":193906,"_5":21387,"_28235":193651,"_5797":193907},[],"Se lee de hawkBit",{"_6892":120394,"_42174":120290,"_29767":193909,"_5":21387,"_28235":193651,"_5797":193910},[],"Claves de cifrado",{"_6892":120395,"_42174":120290,"_29767":193912,"_5":21387,"_28235":193651,"_5797":193913},[],"Almacén de blobs de SymKMS",{"_6892":120396,"_42174":120290,"_29767":193915,"_5":21387,"_28235":193651,"_5797":193913},[],{"_6892":120397,"_42174":120290,"_29767":193917,"_5":21387,"_28235":193651,"_5797":193918},[],"El modo nativo también usa `update_files_base_dir` como espacio temporal de construcción: ahí prepara las entradas de un build, y las salidas construidas se publican en el almacén `builds`.",{"_6892":120398,"_42174":120290,"_29767":193920,"_5":21387,"_28235":193655,"_5797":193921},[],"El trabajo en segundo plano (el consumidor de eventos de WFX y el disparador de lanzamientos programados) se ejecuta en exactamente una réplica a la vez. La elección de líder la decide: Leases de Kubernetes cuando se ejecuta dentro de un clúster, un advisory lock de Postgres en cualquier otro caso, configurable con `leader_election.mode` (`\"\"`, `kubernetes` o `database`). Sin elección, cada réplica contaría las mismas finalizaciones de jobs y liberaría lotes antes de tiempo, por lo que un fallo al configurarla detiene el servicio al arrancar. El envío de un lote también está protegido por un lock por lanzamiento, de modo que dos llamadas nunca envían el mismo lote dos veces.",{"_6892":120399,"_42174":120290,"_29767":193923,"_5":21387,"_28235":193655,"_5797":193924},[],"Si `builds` está en disco local, el servicio registra una advertencia y el despliegue queda limitado a una réplica, porque otras réplicas no podrían servir los builds. Pon `builds`, `artifacts` y el almacén de SymKMS en S3 para escalar horizontalmente. Consulta Operaciones.",{"_6892":120400,"_42174":120290,"_29767":193926,"_5":21387,"_28235":193659,"_5797":193927},[],"<Card title=\"Flujos\" description=\"La secuencia de cada operación importante.\" href=\"/docs/platform/updates/flows\" />",{"_6892":120401,"_42174":120290,"_29767":193929,"_5":21387,"_28235":193659,"_5797":193930},[],"<Card title=\"Modelo de datos\" description=\"Las tablas que guarda el servicio y cómo se relacionan.\" href=\"/docs/platform/updates/data-model\" />",{"_6892":120402,"_42174":120290,"_29767":193932,"_5":21387,"_28235":193659,"_5797":193933},[],"<Card title=\"Operaciones\" description=\"Despliega, escala, respalda y actualiza.\" href=\"/docs/platform/updates/operations\" />",{"_6892":120403,"_42174":120403,"_5":21817,"_5797":192003,"_42654":193935,"_29767":193936,"_28235":120403},[77248,187247,193621,192003],[],{"_6892":120404,"_42174":120403,"_29767":193938,"_5":21387,"_28235":120403,"_5797":193939},[],"Paquetes de actualización, módulos de software, campañas de lanzamiento, workflows y cómo llega una actualización a un dispositivo.",{"_6892":120405,"_42174":120403,"_5":42651,"_29767":193941,"_28235":193942,"_5797":193943},[],"/docs/pr-preview/pr-56/es/platform/updates/concepts#vocabulario","Vocabulario",{"_6892":120406,"_42174":120403,"_5":42651,"_29767":193945,"_28235":193946,"_5797":193947},[],"/docs/pr-preview/pr-56/es/platform/updates/concepts#paquetes-de-actualización","Paquetes de actualización",{"_6892":120407,"_42174":120403,"_5":42651,"_29767":193949,"_28235":193950,"_5797":193951},[],"/docs/pr-preview/pr-56/es/platform/updates/concepts#módulos-de-software","Módulos de software",{"_6892":120408,"_42174":120403,"_5":42651,"_29767":193953,"_28235":193954,"_5797":193955},[],"/docs/pr-preview/pr-56/es/platform/updates/concepts#campañas-de-lanzamiento","Campañas de lanzamiento",{"_6892":120409,"_42174":120403,"_5":42651,"_29767":193957,"_28235":193958,"_5797":193959},[],"/docs/pr-preview/pr-56/es/platform/updates/concepts#estrategia","Estrategia",{"_6892":120410,"_42174":120403,"_5":42651,"_29767":193961,"_28235":193962,"_5797":193963},[],"/docs/pr-preview/pr-56/es/platform/updates/concepts#ciclo-de-vida","Ciclo de vida",{"_6892":120411,"_42174":120403,"_5":42651,"_29767":193965,"_28235":193966,"_5797":193967},[],"/docs/pr-preview/pr-56/es/platform/updates/concepts#versiones-cumplimiento-e-inventario","Versiones, cumplimiento e inventario",{"_6892":120412,"_42174":120403,"_5":42651,"_29767":193969,"_28235":193970,"_5797":193971},[],"/docs/pr-preview/pr-56/es/platform/updates/concepts#cómo-llega-una-actualización-a-un-dispositivo-modo-nativo","Cómo llega una actualización a un dispositivo (modo nativo)",{"_6892":120413,"_42174":120403,"_5":42651,"_29767":193973,"_28235":193974,"_5797":188883},[],"/docs/pr-preview/pr-56/es/platform/updates/concepts#siguientes-pasos",{"_6892":120414,"_42174":120403,"_29767":193976,"_5":21387,"_28235":120403,"_5797":193977},[],"Los términos que usa Lamassu Updates y cómo encajan entre sí. Lee esta página antes de las guías si «paquete de actualización», «lanzamiento» o «módulo» son conceptos nuevos para ti.",{"_6892":120415,"_42174":120403,"_29767":193979,"_5":21387,"_28235":193942,"_5797":193980},[],"El dashboard y esta documentación hablan de **paquete de actualización** (update pack). La API REST y el código hablan de **distribution set** (`/distribution-sets/...`). Son lo mismo.",{"_6892":120416,"_42174":120403,"_29767":193982,"_5":21387,"_28235":193942,"_5797":193983},[],"Término",{"_6892":120417,"_42174":120403,"_29767":193985,"_5":21387,"_28235":193942,"_5797":193986},[],"Significado",{"_6892":120418,"_42174":120403,"_29767":193988,"_5":21387,"_28235":193942,"_5797":193989},[],"Nombre en API / código",{"_6892":120419,"_42174":120403,"_29767":193991,"_5":21387,"_28235":193942,"_5797":193992},[],"Paquete de actualización",{"_6892":120420,"_42174":120403,"_29767":193994,"_5":21387,"_28235":193942,"_5797":193995},[],"Un entregable con nombre y versión que envías a los dispositivos",{"_6892":120421,"_42174":120403,"_29767":193997,"_5":21387,"_28235":193942,"_5797":85617},[],{"_6892":120422,"_42174":120403,"_29767":193999,"_5":21387,"_28235":193942,"_5797":194000},[],"Módulo de software",{"_6892":120423,"_42174":120403,"_29767":194002,"_5":21387,"_28235":193942,"_5797":194003},[],"Un componente con tipo y nombre dentro de un paquete, como una aplicación. Se identifica con la clave `type:name`, donde `type` es `os` o `application`",{"_6892":120424,"_42174":120403,"_29767":194005,"_5":21387,"_28235":193942,"_5797":85626},[],{"_6892":120425,"_42174":120403,"_29767":194007,"_5":21387,"_28235":193942,"_5797":194008},[],"Artefacto",{"_6892":120426,"_42174":120403,"_29767":194010,"_5":21387,"_28235":193942,"_5797":194011},[],"Un fichero (binario) asociado a un módulo o a un paquete",{"_6892":120427,"_42174":120403,"_29767":194013,"_5":21387,"_28235":193942,"_5797":85635},[],{"_6892":120428,"_42174":120403,"_29767":194015,"_5":21387,"_28235":193942,"_5797":194016},[],"Grupo de dispositivos",{"_6892":120429,"_42174":120403,"_29767":194018,"_5":21387,"_28235":193942,"_5797":194019},[],"Un conjunto de dispositivos registrados en Lamassu IoT. Un paquete pertenece a un grupo",{"_6892":120430,"_42174":120403,"_29767":194021,"_5":21387,"_28235":193942,"_5797":85644},[],{"_6892":120431,"_42174":120403,"_29767":194023,"_5":21387,"_28235":193942,"_5797":194024},[],"Campaña de lanzamiento",{"_6892":120432,"_42174":120403,"_29767":194026,"_5":21387,"_28235":193942,"_5797":194027},[],"Un despliegue de una versión de un paquete sobre los dispositivos de un grupo",{"_6892":120433,"_42174":120403,"_29767":194029,"_5":21387,"_28235":193942,"_5797":85653},[],{"_6892":120434,"_42174":120403,"_29767":194031,"_5":21387,"_28235":193942,"_5797":194032},[],"Trabajo (job)",{"_6892":120435,"_42174":120403,"_29767":194034,"_5":21387,"_28235":193942,"_5797":194035},[],"La actualización de un dispositivo dentro de un lanzamiento",{"_6892":120436,"_42174":120403,"_29767":194037,"_5":21387,"_28235":193942,"_5797":85662},[],{"_6892":120437,"_42174":120403,"_29767":194039,"_5":21387,"_28235":193946,"_5797":194040},[],"Un paquete tiene una **versión** (semántica, `x.y.z`) y un **estado**:",{"_6892":120438,"_42174":120403,"_29767":194042,"_5":21387,"_28235":193946,"_5797":194043},[],"Estado",{"_6892":120439,"_42174":120403,"_29767":194045,"_5":21387,"_28235":193946,"_5797":193986},[],{"_6892":120440,"_42174":120403,"_29767":194047,"_5":21387,"_28235":193946,"_5797":85673},[],{"_6892":120441,"_42174":120403,"_29767":194049,"_5":21387,"_28235":193946,"_5797":194050},[],"Editable. Se pueden añadir o reemplazar artefactos. Aún no está construido.",{"_6892":120442,"_42174":120403,"_29767":194052,"_5":21387,"_28235":193946,"_5797":85679},[],{"_6892":120443,"_42174":120403,"_29767":194054,"_5":21387,"_28235":193946,"_5797":194055},[],"El entregable existe. La versión es inmutable. Crea una versión nueva para cambiarla.",{"_6892":120444,"_42174":120403,"_29767":194057,"_5":21387,"_28235":193946,"_5797":85685},[],{"_6892":120445,"_42174":120403,"_29767":194059,"_5":21387,"_28235":193946,"_5797":194060},[],"Se intentó construir y falló. Sigue siendo editable y se puede reintentar. El motivo está en `last_build_error`.",{"_6892":120446,"_42174":120403,"_29767":194062,"_5":21387,"_28235":193946,"_5797":194063},[],"Un paquete tiene un **empaquetado** (packaging):",{"_6892":120447,"_42174":120403,"_29767":194065,"_5":21387,"_28235":193946,"_5797":194066},[],"Empaquetado",{"_6892":120448,"_42174":120403,"_29767":194068,"_5":21387,"_28235":193946,"_5797":194069},[],"Se entrega como",{"_6892":120449,"_42174":120403,"_29767":194071,"_5":21387,"_28235":193946,"_5797":194072},[],"Estado terminal del workflow",{"_6892":120450,"_42174":120403,"_29767":194074,"_5":21387,"_28235":193946,"_5797":85703},[],{"_6892":120451,"_42174":120403,"_29767":194076,"_5":21387,"_28235":193946,"_5797":194077},[],"Un `.swu` construido con swugenerator, opcionalmente firmado y cifrado",{"_6892":120452,"_42174":120403,"_29767":194079,"_5":21387,"_28235":193946,"_5797":85709},[],{"_6892":120453,"_42174":120403,"_29767":194081,"_5":21387,"_28235":193946,"_5797":85712},[],{"_6892":120454,"_42174":120403,"_29767":194083,"_5":21387,"_28235":193946,"_5797":194084},[],"Los artefactos en bruto. El modo nativo construye un paquete `.tar.gz` (opcionalmente cifrado, `.tar.gz.enc`). El modo hawkBit entrega el único fichero de un módulo `raw` tal como se subió (opcionalmente cifrado) y archiva varios ficheros como `<name>.tar.gz`",{"_6892":120455,"_42174":120403,"_29767":194086,"_5":21387,"_28235":193946,"_5797":85718},[],{"_6892":120456,"_42174":120403,"_29767":194088,"_5":21387,"_28235":193946,"_5797":194089},[],"Un paquete también puede llevar **precondiciones**: reglas como «el dispositivo ya debe tener el paquete X en la versión 1.2.0 o superior», o «el módulo `os:gateway-fw` en la versión 2.1.0 o superior». Cada precondición nombra exactamente un paquete (`required_distribution_set_name`) o un módulo (`required_module_key`) y una `min_version` semántica. Un dispositivo que no cumple una precondición no es desplegable, salvo que un operador fuerce el lanzamiento. Cada lanzamiento registra qué dispositivos fallaron y por qué.",{"_6892":120457,"_42174":120403,"_29767":194091,"_5":21387,"_28235":193950,"_5797":194092},[],"Un paquete es una composición de módulos. Contiene un módulo `os` (el ancla obligatoria) y cualquier número de módulos `application`. En modo nativo, un paquete sin filas de módulo se muestra con un módulo implícito `os:<nombre del paquete>`, y los ficheros que subes al paquete le pertenecen. Un módulo guarda sus propios ficheros y, opcionalmente, notas de versión. Puedes:",{"_6892":120458,"_42174":120403,"_29767":194094,"_5":21387,"_28235":193950,"_5797":194095},[],"crear un módulo por separado en el **catálogo** (`POST /updates/v1/softwaremodules`) y componer paquetes con él más adelante,",{"_6892":120459,"_42174":120403,"_29767":194097,"_5":21387,"_28235":193950,"_5797":194098},[],"añadir un módulo directamente a un paquete, o",{"_6892":120460,"_42174":120403,"_29767":194100,"_5":21387,"_28235":193950,"_5797":194101},[],"importar un módulo que ya tiene otro paquete.",{"_6892":120461,"_42174":120403,"_29767":194103,"_5":21387,"_28235":193950,"_5797":194104},[],"La **intención de entrega** (delivery intent) de un módulo indica cómo se enviará: `undecided` (por defecto), `swu-build`, `swu-prebuilt` o `raw`.",{"_6892":120462,"_42174":120403,"_29767":194106,"_5":21387,"_28235":193950,"_5797":194107},[],"Cómo se relacionan los módulos con la construcción depende del backend:",{"_6892":120463,"_42174":120403,"_29767":194109,"_5":21387,"_28235":193950,"_5797":194110},[],"**native**: los módulos son *entradas de la construcción*. El paquete construye un único `.swu` con todos ellos, y un lanzamiento envía a cada dispositivo una única dirección de descarga.",{"_6892":120464,"_42174":120403,"_29767":194112,"_5":21387,"_28235":193950,"_5797":194113},[],"**hawkbit**: cada módulo tiene su *propio entregable*, construido en el catálogo de módulos antes de que exista el paquete. Solo los módulos ya construidos se pueden enlazar a un paquete, y un módulo enlazado queda congelado. hawkBit entrega al dispositivo los artefactos de cada módulo, de modo que un paquete con varios módulos se instala como varias transacciones SWUpdate independientes. SWUpdate no puede hacer rollback entre varios ficheros `.swu`.",{"_6892":120465,"_42174":120403,"_29767":194115,"_5":21387,"_28235":193950,"_5797":194116},[],"La importación de un módulo también difiere. En modo hawkBit la importación lo **enlaza**, así que ambos paquetes comparten el módulo y una reconstrucción se ve en los dos. En modo nativo lo **copia**, así que los dos divergen después. El listado de módulos reutilizables te indica cuál obtendrás (`shared`).",{"_6892":120466,"_42174":120403,"_29767":194118,"_5":21387,"_28235":193954,"_5797":194119},[],"Un lanzamiento despliega una versión de un paquete sobre los dispositivos de un grupo en **lotes**.",{"_6892":120467,"_42174":120403,"_29767":194121,"_5":21387,"_28235":193958,"_5797":194122},[],"Campo",{"_6892":120468,"_42174":120403,"_29767":194124,"_5":21387,"_28235":193958,"_5797":193986},[],{"_6892":120469,"_42174":120403,"_29767":194126,"_5":21387,"_28235":193958,"_5797":85759},[],{"_6892":120470,"_42174":120403,"_29767":194128,"_5":21387,"_28235":193958,"_5797":194129},[],"Cómo se dimensiona un lote. Solo `percentage` hace que `rollout_value` sea un porcentaje. Cualquier otro valor (`fixed`, o `numeric`, que es el que envía el dashboard) lo convierte en un número de dispositivos",{"_6892":120471,"_42174":120403,"_29767":194131,"_5":21387,"_28235":193958,"_5797":85765},[],{"_6892":120472,"_42174":120403,"_29767":194133,"_5":21387,"_28235":193958,"_5797":194134},[],"El porcentaje o el número de dispositivos. Debe ser mayor que 0",{"_6892":120473,"_42174":120403,"_29767":194136,"_5":21387,"_28235":193958,"_5797":85771},[],{"_6892":120474,"_42174":120403,"_29767":194138,"_5":21387,"_28235":193958,"_5797":194139},[],"El workflow de WFX: `direct` (sin confirmación), `phased` (con pasos de confirmación) o `download-install`. Usa `download-install` para paquetes `non-swu`. Cualquier otro valor se pasa a WFX como nombre completo de workflow, como `wfx.workflow.dau.simple`. En modo hawkBit no hay WFX: `phased` se convierte en una acción soft de hawkBit (el dispositivo confirma o pospone) y cualquier otro valor en una acción forced",{"_6892":120475,"_42174":120403,"_29767":194141,"_5":21387,"_28235":193958,"_5797":85777},[],{"_6892":120476,"_42174":120403,"_29767":194143,"_5":21387,"_28235":193958,"_5797":194144},[],"Un canario. El primer lote es este único dispositivo, y debe tener éxito antes de tocar a ningún otro",{"_6892":120477,"_42174":120403,"_29767":194146,"_5":21387,"_28235":193958,"_5797":85783},[],{"_6892":120478,"_42174":120403,"_29767":194148,"_5":21387,"_28235":193958,"_5797":194149},[],"Libera el siguiente lote automáticamente cuando se cumplen las condiciones",{"_6892":120479,"_42174":120403,"_29767":194151,"_5":21387,"_28235":193958,"_5797":85789},[],{"_6892":120480,"_42174":120403,"_29767":194153,"_5":21387,"_28235":193958,"_5797":194154},[],"% del lote actual que debe tener éxito antes de empezar el siguiente (0 a 100). Sin definir, 0 o 100 significa el lote completo",{"_6892":120481,"_42174":120403,"_29767":194156,"_5":21387,"_28235":193958,"_5797":85795},[],{"_6892":120482,"_42174":120403,"_29767":194158,"_5":21387,"_28235":193958,"_5797":194159},[],"El lanzamiento se cancela cuando este % de todos los dispositivos ha fallado (redondeado hacia arriba: con el 10 % de 100 dispositivos se cancela en el décimo fallo). `0` significa sin límite",{"_6892":120483,"_42174":120403,"_29767":194161,"_5":21387,"_28235":193958,"_5797":85801},[],{"_6892":120484,"_42174":120403,"_29767":194163,"_5":21387,"_28235":193958,"_5797":194164},[],"Hora de inicio prevista (RFC 3339). El modo nativo lanza el primer lote cuando pasa esa hora (consulta cada 30 segundos); el modo hawkBit se la entrega a hawkBit como hora de inicio del rollout",{"_6892":120485,"_42174":120403,"_29767":194166,"_5":21387,"_28235":193958,"_5797":85807},[],{"_6892":120486,"_42174":120403,"_29767":194168,"_5":21387,"_28235":193958,"_5797":194169},[],"Nombre para mostrar (por defecto, el nombre del paquete) y notas de texto libre",{"_6892":120487,"_42174":120403,"_29767":194171,"_5":21387,"_28235":193958,"_5797":85813},[],{"_6892":120488,"_42174":120403,"_29767":194173,"_5":21387,"_28235":193958,"_5797":194174},[],"Una pista de prioridad almacenada, de 0 a 1000. Nada la lee",{"_6892":120489,"_42174":120403,"_29767":194176,"_5":21387,"_28235":193962,"_5797":194177},[],"Un lanzamiento está `running`, `paused` (se puede reanudar), `cancelled` (terminal) o `completed` (terminal). Un dispositivo dentro de él pasa de `pending` → `active` → `completed` o `failed`. Puedes reintentar solo los dispositivos fallidos (`retry-failed`). En modo nativo esto también reabre un lanzamiento terminado o cancelado. Los controles del operador son `rollout`, `pause`, `resume`, `cancel`, `complete` y `retry-failed`, y la estrategia se puede editar mientras el lanzamiento exista. El modo nativo los soporta todos. El modo hawkBit no tiene `complete` ni edición de la estrategia, porque los grupos y umbrales de un rollout se fijan al crearlo (consulta Capacidades).",{"_6892":120490,"_42174":120403,"_29767":194179,"_5":21387,"_28235":193966,"_5797":194180},[],"Además de los lanzamientos puntuales, puedes declarar la **última versión** de un paquete para un grupo. El servicio informa entonces de la **desviación** (drift): los dispositivos que no están en la última versión. Puedes forzar un dispositivo a la última versión, o a una exacta. Consulta la referencia de la API.",{"_6892":120491,"_42174":120403,"_29767":194182,"_5":21387,"_28235":193966,"_5797":194183},[],"El servicio también mantiene un **inventario de dispositivos**: qué versión de paquete lleva ahora cada dispositivo, con los artefactos que declara el manifiesto de esa versión, y el historial de intentos de actualización. Ambos se rellenan a medida que se ejecutan los lanzamientos del servicio.",{"_6892":120492,"_42174":120403,"_29767":194185,"_5":21387,"_28235":193970,"_5797":194186},[],"La máquina de estados del lado del dispositivo es un workflow de WFX, en `wfx/workflow/dau/` del repositorio:",{"_6892":120493,"_42174":120403,"_29767":194188,"_5":21387,"_28235":193970,"_5797":194189},[],"Fichero de workflow",{"_6892":120494,"_42174":120403,"_29767":194191,"_5":21387,"_28235":193970,"_5797":194192},[],"Estados",{"_6892":120495,"_42174":120403,"_29767":194194,"_5":21387,"_28235":193970,"_5797":191811},[],{"_6892":120496,"_42174":120403,"_29767":194196,"_5":21387,"_28235":193970,"_5797":85840},[],{"_6892":120497,"_42174":120403,"_29767":194198,"_5":21387,"_28235":193970,"_5797":85843},[],{"_6892":120498,"_42174":120403,"_29767":194200,"_5":21387,"_28235":193970,"_5797":194201},[],"Paquetes SWU, sin confirmación",{"_6892":120499,"_42174":120403,"_29767":194203,"_5":21387,"_28235":193970,"_5797":85849},[],{"_6892":120500,"_42174":120403,"_29767":194205,"_5":21387,"_28235":193970,"_5797":85852},[],{"_6892":120501,"_42174":120403,"_29767":194207,"_5":21387,"_28235":193970,"_5797":194208},[],"Paquetes SWU, con pasos de confirmación",{"_6892":120502,"_42174":120403,"_29767":194210,"_5":21387,"_28235":193970,"_5797":85858},[],{"_6892":120503,"_42174":120403,"_29767":194212,"_5":21387,"_28235":193970,"_5797":85861},[],{"_6892":120504,"_42174":120403,"_29767":194214,"_5":21387,"_28235":193970,"_5797":194215},[],"Paquetes `non-swu`. Se selecciona con `workflow_type`: un lanzamiento no lo elige por ti",{"_6892":120505,"_42174":120403,"_29767":194217,"_5":21387,"_28235":193970,"_5797":85867},[],{"_6892":120506,"_42174":120403,"_29767":194219,"_5":21387,"_28235":193970,"_5797":194220},[],"DOWNLOAD → INSTALL → INSTALLED o TERMINATED",{"_6892":120507,"_42174":120403,"_29767":194222,"_5":21387,"_28235":193970,"_5797":194223},[],"Flujo mínimo",{"_6892":120508,"_42174":120403,"_29767":194225,"_5":21387,"_28235":193970,"_5797":194226},[],"Todos los workflows terminan en `TERMINATED` si hay un fallo. El servicio registra los cuatro ficheros al arrancar. `workflow_file` debe nombrar el fichero `direct`, y los otros tres se buscan a su lado sustituyendo `direct` en el nombre del fichero (consulta Configuración). En modo hawkBit no hay jobs de WFX: consulta Modo hawkBit.",{"_6892":120509,"_42174":120403,"_29767":194228,"_5":21387,"_28235":193974,"_5797":194229},[],"<Card title=\"Arquitectura\" description=\"Los componentes y lo que se ejecuta dentro del servicio.\" href=\"/docs/platform/updates/architecture\" />",{"_6892":120510,"_42174":120403,"_29767":194231,"_5":21387,"_28235":193974,"_5797":194232},[],"<Card title=\"Flujos\" description=\"Diagramas de secuencia de cada operación importante.\" href=\"/docs/platform/updates/flows\" />",{"_6892":120511,"_42174":120403,"_29767":194234,"_5":21387,"_28235":193974,"_5797":194235},[],"<Card title=\"Publicar y desplegar una actualización\" description=\"Hazlo de principio a fin.\" href=\"/docs/platform/updates/guides/publish-and-roll-out\" />",{"_6892":120512,"_42174":120512,"_5":21817,"_5797":194237,"_42654":194238,"_29767":194239,"_28235":120512},"Modelo de datos",[77248,187247,193621,192003],[],{"_6892":120513,"_42174":120512,"_29767":194241,"_5":21387,"_28235":120512,"_5797":194242},[],"Las tablas que guarda el servicio, cómo se relacionan y cómo se crea y migra el esquema.",{"_6892":120514,"_42174":120512,"_5":42651,"_29767":194244,"_28235":194245,"_5797":194246},[],"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-nativo","Tablas del modo nativo",{"_6892":120515,"_42174":120512,"_5":42651,"_29767":194248,"_28235":194249,"_5797":194250},[],"/docs/pr-preview/pr-56/es/platform/updates/data-model#tablas-del-modo-hawkbit","Tablas del modo hawkBit",{"_6892":120516,"_42174":120512,"_5":42651,"_29767":194252,"_28235":194253,"_5797":194254},[],"/docs/pr-preview/pr-56/es/platform/updates/data-model#diagramas-entidad-relación","Diagramas entidad-relación",{"_6892":120517,"_42174":120512,"_5":42651,"_29767":194256,"_28235":194257,"_5797":194258},[],"/docs/pr-preview/pr-56/es/platform/updates/data-model#paquetes-módulos-y-artefactos","Paquetes, módulos y artefactos",{"_6892":120518,"_42174":120512,"_5":42651,"_29767":194260,"_28235":194261,"_5797":194262},[],"/docs/pr-preview/pr-56/es/platform/updates/data-model#lanzamientos-y-dispositivos","Lanzamientos y dispositivos",{"_6892":120519,"_42174":120512,"_5":42651,"_29767":194264,"_28235":194265,"_5797":194266},[],"/docs/pr-preview/pr-56/es/platform/updates/data-model#cómo-leer-el-diagrama","Cómo leer el diagrama",{"_6892":120520,"_42174":120512,"_5":42651,"_29767":194268,"_28235":194269,"_5797":194270},[],"/docs/pr-preview/pr-56/es/platform/updates/data-model#creación-del-esquema-y-migraciones","Creación del esquema y migraciones",{"_6892":120521,"_42174":120512,"_5":42651,"_29767":194272,"_28235":194273,"_5797":188883},[],"/docs/pr-preview/pr-56/es/platform/updates/data-model#siguientes-pasos",{"_6892":120522,"_42174":120512,"_29767":194275,"_5":21387,"_28235":120512,"_5797":194276},[],"Las tablas que Lamassu Updates guarda en Postgres, cómo se relacionan y cómo se crea y migra el esquema. Es una referencia para operadores e integradores que consultan la base de datos, la dimensionan o planifican una actualización de versión.",{"_6892":120523,"_42174":120512,"_29767":194278,"_5":21387,"_28235":194245,"_5797":194279},[],"Se crean en Postgres al arrancar, en la base de datos `updates`. Los tipos de Go están en `pkg/models/updates.go` del repositorio ota.",{"_6892":120524,"_42174":120512,"_29767":194281,"_5":21387,"_28235":194245,"_5797":194282},[],"Tabla",{"_6892":120525,"_42174":120512,"_29767":194284,"_5":21387,"_28235":194245,"_5797":194285},[],"Contiene",{"_6892":120526,"_42174":120512,"_29767":194287,"_5":21387,"_28235":194245,"_5797":85938},[],{"_6892":120527,"_42174":120512,"_29767":194289,"_5":21387,"_28235":194245,"_5797":194290},[],"Un paquete de actualización: nombre, versión, grupo, tipo, empaquetado, estado, la sw-description (`sw_descriptor`), precondiciones, ajustes de cifrado y firma, y la cobertura del build por dispositivo",{"_6892":120528,"_42174":120512,"_29767":194292,"_5":21387,"_28235":194245,"_5797":85944},[],{"_6892":120529,"_42174":120512,"_29767":194294,"_5":21387,"_28235":194245,"_5797":194295},[],"Una instantánea de cada versión construida, con su manifiesto firmado",{"_6892":120530,"_42174":120512,"_29767":194297,"_5":21387,"_28235":194245,"_5797":85950},[],{"_6892":120531,"_42174":120512,"_29767":194299,"_5":21387,"_28235":194245,"_5797":194300},[],"Los módulos de una versión de paquete, con clave formada por paquete, versión, tipo de módulo y nombre. También contiene módulos de catálogo que no pertenecen a ningún paquete, con el ID de paquete vacío",{"_6892":120532,"_42174":120512,"_29767":194302,"_5":21387,"_28235":194245,"_5797":85635},[],{"_6892":120533,"_42174":120512,"_29767":194304,"_5":21387,"_28235":194245,"_5797":194305},[],"Un artefacto global: la entrada de catálogo de un fichero subido, único por nombre y versión",{"_6892":120534,"_42174":120512,"_29767":194307,"_5":21387,"_28235":194245,"_5797":85961},[],{"_6892":120535,"_42174":120512,"_29767":194309,"_5":21387,"_28235":194245,"_5797":194310},[],"El enlace entre una versión de paquete, un artefacto y, opcionalmente, un módulo",{"_6892":120536,"_42174":120512,"_29767":194312,"_5":21387,"_28235":194245,"_5797":85967},[],{"_6892":120537,"_42174":120512,"_29767":194314,"_5":21387,"_28235":194245,"_5797":194315},[],"Una campaña de lanzamiento: estrategia, estado, umbrales y contabilidad de lotes",{"_6892":120538,"_42174":120512,"_29767":194317,"_5":21387,"_28235":194245,"_5797":85973},[],{"_6892":120539,"_42174":120512,"_29767":194319,"_5":21387,"_28235":194245,"_5797":194320},[],"El estado de cada dispositivo dentro de un lanzamiento: `pending`, `active`, `completed` o `failed`",{"_6892":120540,"_42174":120512,"_29767":194322,"_5":21387,"_28235":194245,"_5797":85979},[],{"_6892":120541,"_42174":120512,"_29767":194324,"_5":21387,"_28235":194245,"_5797":194325},[],"Qué versión de paquete lleva ahora un dispositivo",{"_6892":120542,"_42174":120512,"_29767":194327,"_5":21387,"_28235":194245,"_5797":85985},[],{"_6892":120543,"_42174":120512,"_29767":194329,"_5":21387,"_28235":194245,"_5797":194330},[],"El historial de actualizaciones de un dispositivo",{"_6892":120544,"_42174":120512,"_29767":194332,"_5":21387,"_28235":194245,"_5797":85991},[],{"_6892":120545,"_42174":120512,"_29767":194334,"_5":21387,"_28235":194245,"_5797":194335},[],"La última versión declarada por grupo y paquete",{"_6892":120546,"_42174":120512,"_29767":194337,"_5":21387,"_28235":194245,"_5797":85997},[],{"_6892":120547,"_42174":120512,"_29767":194339,"_5":21387,"_28235":194245,"_5797":194340},[],"Una fila por cada migración de datos que debe ejecutarse una sola vez (la migración del umbral de aprobación)",{"_6892":120548,"_42174":120512,"_29767":194342,"_5":21387,"_28235":194245,"_5797":194343},[],"Los bytes de los ficheros (artefactos, builds, claves) no están en Postgres. Viven en los almacenes de blobs descritos en Configuración. La sw-description está en Postgres (una columna del paquete y de cada módulo).",{"_6892":120549,"_42174":120512,"_29767":194345,"_5":21387,"_28235":194249,"_5797":194346},[],"En modo hawkBit, los paquetes, rollouts y jobs viven en hawkBit. Este servicio guarda solo lo siguiente en el mismo Postgres (la base de datos `updates`), para aquello para lo que hawkBit no tiene equivalente:",{"_6892":120550,"_42174":120512,"_29767":194348,"_5":21387,"_28235":194249,"_5797":194282},[],{"_6892":120551,"_42174":120512,"_29767":194350,"_5":21387,"_28235":194249,"_5797":194285},[],{"_6892":120552,"_42174":120512,"_29767":194352,"_5":21387,"_28235":194249,"_5797":86013},[],{"_6892":120553,"_42174":120512,"_29767":194354,"_5":21387,"_28235":194249,"_5797":194355},[],"Bytes de `POST /artifacts`. Las subidas con más de 30 minutos se descartan la próxima vez que alguien sube un artefacto, y siguen siendo legibles hasta entonces. No se pueden enlazar a un paquete en este modo",{"_6892":120554,"_42174":120512,"_29767":194357,"_5":21387,"_28235":194249,"_5797":86019},[],{"_6892":120555,"_42174":120512,"_29767":194359,"_5":21387,"_28235":194249,"_5797":194360},[],"Se lee al resolver un ID de artefacto, pero ya nada la escribe",{"_6892":120556,"_42174":120512,"_29767":194362,"_5":21387,"_28235":194249,"_5797":86025},[],{"_6892":120557,"_42174":120512,"_29767":194364,"_5":21387,"_28235":194249,"_5797":194365},[],"sw-descriptions, precondiciones de lanzamiento y banderas de rollout (un almacén de texto clave-valor de uso general, con clave formada por instancia, tipo e ID)",{"_6892":120558,"_42174":120512,"_29767":194367,"_5":21387,"_28235":194249,"_5797":86031},[],{"_6892":120559,"_42174":120512,"_29767":194369,"_5":21387,"_28235":194249,"_5797":194370},[],"Manifiestos firmados de los sets construidos",{"_6892":120560,"_42174":120512,"_29767":194372,"_5":21387,"_28235":194249,"_5797":86037},[],{"_6892":120561,"_42174":120512,"_29767":194374,"_5":21387,"_28235":194249,"_5797":194375},[],"Rollouts cancelados a través de este servicio",{"_6892":120562,"_42174":120512,"_29767":194377,"_5":21387,"_28235":194249,"_5797":85991},[],{"_6892":120563,"_42174":120512,"_29767":194379,"_5":21387,"_28235":194249,"_5797":194380},[],"Últimas versiones declaradas (compartida con el modo nativo)",{"_6892":120564,"_42174":120512,"_29767":194382,"_5":21387,"_28235":194249,"_5797":194383},[],"Las filas con clave formada por un ID de hawkBit llevan un `instance_id`, un marcador de los datos de hawkBit que describen. Si hawkBit pierde sus datos y empieza de nuevo, los IDs se repiten, y el servicio deja de leer las filas escritas para la instancia anterior. El servicio vuelve a comprobar el marcador cada 30 segundos.",{"_6892":120565,"_42174":120512,"_29767":194385,"_5":21387,"_28235":194249,"_5797":194386},[],"hawkBit mantiene su propio esquema en su propia base de datos `hawkbit`. En el stack de Docker Compose, `init.sql` crea ambas bases de datos la primera vez que arranca el contenedor de Postgres.",{"_6892":120566,"_42174":120512,"_29767":194388,"_5":21387,"_28235":194253,"_5797":194389},[],"Las tablas del modo nativo, con sus columnas principales. Las columnas `*_id` que apuntan a otra tabla se dibujan como las líneas de relación. Son referencias lógicas: el servicio no crea restricciones de clave foránea en la base de datos, y `FK` solo marca qué columna contiene la referencia.",{"_6892":120567,"_42174":120512,"_29767":194391,"_5":21387,"_28235":194261,"_5797":194392},[],"Valores que conviene conocer:",{"_6892":120568,"_42174":120512,"_29767":194394,"_5":21387,"_28235":194261,"_5797":194395},[],"`distribution_set.status` es `draft`, `built` o `build_failed`. `packaging` es `swu` o `non-swu`. `encryption_mode` es vacío, `shared` o `per-device`.",{"_6892":120569,"_42174":120512,"_29767":194397,"_5":21387,"_28235":194261,"_5797":194398},[],"`launchtrack.status` es `running`, `paused`, `cancelled` o `completed`. Un lanzamiento nuevo se guarda con estado vacío, que significa running. `aborted` es verdadero en un lanzamiento cancelado (por el operador o por el umbral de error) y detiene todas las vías de despliegue. El resultado de las precondiciones del lanzamiento (`forced_preconditions`, `precondition_failures`) se guarda en la fila, pero no las precondiciones en sí: esas viven en el paquete.",{"_6892":120570,"_42174":120512,"_29767":194400,"_5":21387,"_28235":194261,"_5797":194401},[],"`rollout_type` no se valida: solo el valor `percentage` hace que `rollout_value` sea un porcentaje, y cualquier otro valor (el dashboard envía `numeric`, los ejemplos usan `fixed`) lo convierte en un número de dispositivos.",{"_6892":120571,"_42174":120512,"_29767":194403,"_5":21387,"_28235":194261,"_5797":194404},[],"`launch_device_assignments.status` es `pending`, `active`, `completed` o `failed`. (`cancelled` también existe como valor, pero solo lo informa el modo hawkBit, para un canario cuyo lanzamiento se canceló; nunca se almacena.)",{"_6892":120572,"_42174":120512,"_29767":194406,"_5":21387,"_28235":194261,"_5797":194407},[],"`device_distribution_set_update.status` es `pending`, `running`, `success` o `failed` (el modo hawkBit también puede informar `cancelled`), y su `source` es `service`.",{"_6892":120573,"_42174":120512,"_29767":194409,"_5":21387,"_28235":194261,"_5797":194410},[],"`distribution_set_module` es único por paquete, versión de paquete, tipo y nombre. Un módulo de catálogo independiente tiene `distribution_set_id` vacío, y su `distribution_set_version` es igual a su propia `version`.",{"_6892":120574,"_42174":120512,"_29767":194412,"_5":21387,"_28235":194261,"_5797":194413},[],"`distribution_set_version` es único por paquete y versión, y `distribution_set_artifact` por paquete, versión y artefacto.",{"_6892":120575,"_42174":120512,"_29767":194415,"_5":21387,"_28235":194261,"_5797":194416},[],"No dibujadas: `updates_schema_migrations`, una tabla de marcas que usan las migraciones de datos del arranque, y las tablas del modo hawkBit listadas arriba.",{"_6892":120576,"_42174":120512,"_29767":194418,"_5":21387,"_28235":194265,"_5797":194419},[],"Un **paquete** (`distribution_set`) es una fila que avanza por versiones. Cada versión construida se guarda como instantánea en `distribution_set_version`, con su manifiesto firmado.",{"_6892":120577,"_42174":120512,"_29767":194421,"_5":21387,"_28235":194265,"_5797":194422},[],"Los **módulos** y los **artefactos** son cosas distintas: un artefacto es un fichero del catálogo global, y `distribution_set_artifact` lo enlaza a una versión de paquete (y opcionalmente a un módulo). Un módulo cuyo `distribution_set_id` está vacío es un módulo de catálogo que ningún paquete contiene todavía.",{"_6892":120578,"_42174":120512,"_29767":194424,"_5":21387,"_28235":194265,"_5797":194425},[],"Un **lanzamiento** (`launchtrack`) se dirige a un grupo mediante una fila de asignación por dispositivo. La asignación pasa de `pending` → `active` → `completed` o `failed`, y `batch_index` registra qué lote la envió.",{"_6892":120579,"_42174":120512,"_29767":194427,"_5":21387,"_28235":194265,"_5797":194428},[],"Dos tablas de dispositivo responden a preguntas distintas. `device_distribution_set_version` es lo que un dispositivo lleva **ahora**. `device_distribution_set_update` es el **historial** de intentos, con `version_from` y `version_to`.",{"_6892":120580,"_42174":120512,"_29767":194430,"_5":21387,"_28235":194265,"_5797":194431},[],"`latest_distribution_set_version` es la versión en la que un operador declaró que deben estar los dispositivos de un grupo, y se usa para la desviación y el cumplimiento.",{"_6892":120581,"_42174":120512,"_29767":194433,"_5":21387,"_28235":194269,"_5797":194434},[],"No hay ficheros de migración. En modo nativo, el servicio crea y actualiza su propio esquema al arrancar, manteniendo un lock de Postgres para que las réplicas que arrancan a la vez no compitan. Ejecuta estos pasos en orden (el modo hawkBit solo crea sus seis tablas):",{"_6892":120582,"_42174":120512,"_29767":194436,"_5":21387,"_28235":194269,"_5797":194437},[],"**Paso de renombrado** (`MigrateDistributionSetNaming`). A las bases de datos creadas antes del cambio de nombre «update pack» → «distribution set» se les renombran tablas y columnas. Se ejecuta antes del paso 2 para que las tablas nuevas no se creen vacías junto a las antiguas.",{"_6892":120583,"_42174":120512,"_29767":194439,"_5":21387,"_28235":194269,"_5797":194440},[],"**Crear y añadir** (GORM `AutoMigrate`). Se crean las tablas y columnas que faltan. Nunca elimina ni renombra nada.",{"_6892":120584,"_42174":120512,"_29767":194442,"_5":21387,"_28235":194269,"_5797":194443},[],"**Migraciones de datos.** Módulos independientes (las filas de `software_module_definition` pasan a las tablas de módulos y artefactos, conservando IDs y ficheros, y se elimina la tabla antigua), asignaciones de dispositivos (reconstruidas a partir de las columnas heredadas del lanzamiento) y la semántica del umbral de aprobación.",{"_6892":120585,"_42174":120512,"_29767":194445,"_5":21387,"_28235":194269,"_5797":194446},[],"La mayoría de los pasos comprueban el esquema actual en lugar de un número de versión, y la migración del umbral de aprobación registra una fila en `updates_schema_migrations` para ejecutarse solo una vez. Arrancar varias veces es seguro, y una base de datos nueva no tiene nada que migrar. Tras los pasos de esquema, el servicio también copia al almacén de artefactos los binarios del esquema heredado, organizado por paquete en disco, omitiendo los que ya están allí.",{"_6892":120586,"_42174":120512,"_29767":194448,"_5":21387,"_28235":194269,"_5797":194449},[],"`init.sql` es una semilla de Docker Compose: crea las bases de datos `updates` y `hawkbit` y aún contiene definiciones de tablas antiguas, así que no lo uses para definir tú mismo el esquema.",{"_6892":120587,"_42174":120512,"_29767":194451,"_5":21387,"_28235":194269,"_5797":194452},[],"Consulta Operaciones para saber qué hacer antes de actualizar de versión.",{"_6892":120588,"_42174":120512,"_29767":194454,"_5":21387,"_28235":194273,"_5797":194455},[],"<Card title=\"Configuración\" description=\"Almacenes de blobs, storage y cada campo de configuración.\" href=\"/docs/platform/updates/reference/configuration\" />",{"_6892":120589,"_42174":120512,"_29767":194457,"_5":21387,"_28235":194273,"_5797":194458},[],"<Card title=\"Operaciones\" description=\"Respalda, escala y actualiza la base de datos.\" href=\"/docs/platform/updates/operations\" />",{"_6892":120590,"_42174":120590,"_5":21817,"_5797":194460,"_42654":194461,"_29767":194462,"_28235":120590},"Flujos",[77248,187247,193621,192003],[],{"_6892":120591,"_42174":120590,"_29767":194464,"_5":21387,"_28235":120590,"_5797":194465},[],"Diagramas de secuencia de las operaciones importantes, para los backends nativo y hawkBit.",{"_6892":120592,"_42174":120590,"_5":42651,"_29767":194467,"_28235":194468,"_5797":193629},[],"/docs/pr-preview/pr-56/es/platform/updates/flows#modo-nativo",{"_6892":120593,"_42174":120590,"_5":42651,"_29767":194470,"_28235":194471,"_5797":194472},[],"/docs/pr-preview/pr-56/es/platform/updates/flows#1-publicar-y-construir-un-paquete","1\\. Publicar y construir un paquete",{"_6892":120594,"_42174":120590,"_5":42651,"_29767":194474,"_28235":194475,"_5797":194476},[],"/docs/pr-preview/pr-56/es/platform/updates/flows#2-crear-un-lanzamiento","2\\. Crear un lanzamiento",{"_6892":120595,"_42174":120590,"_5":42651,"_29767":194478,"_28235":194479,"_5797":194480},[],"/docs/pr-preview/pr-56/es/platform/updates/flows#3-desplegar-un-lote-y-actualizar-un-dispositivo","3\\. Desplegar un lote y actualizar un dispositivo",{"_6892":120596,"_42174":120590,"_5":42651,"_29767":194482,"_28235":194483,"_5797":194484},[],"/docs/pr-preview/pr-56/es/platform/updates/flows#4-reaccionar-cuando-un-dispositivo-termina","4\\. Reaccionar cuando un dispositivo termina",{"_6892":120597,"_42174":120590,"_5":42651,"_29767":194486,"_28235":194487,"_5797":194488},[],"/docs/pr-preview/pr-56/es/platform/updates/flows#5-construir-un-paquete-cifrado-por-dispositivo","5\\. Construir un paquete cifrado por dispositivo",{"_6892":120598,"_42174":120590,"_5":42651,"_29767":194490,"_28235":194491,"_5797":193637},[],"/docs/pr-preview/pr-56/es/platform/updates/flows#modo-hawkbit",{"_6892":120599,"_42174":120590,"_5":42651,"_29767":194493,"_28235":194494,"_5797":194495},[],"/docs/pr-preview/pr-56/es/platform/updates/flows#6-construir-un-módulo-y-crear-un-paquete","6\\. Construir un módulo y crear un paquete",{"_6892":120600,"_42174":120590,"_5":42651,"_29767":194497,"_28235":194498,"_5797":194499},[],"/docs/pr-preview/pr-56/es/platform/updates/flows#7-lanzamiento-y-actualización-del-dispositivo","7\\. Lanzamiento y actualización del dispositivo",{"_6892":120601,"_42174":120590,"_5":42651,"_29767":194501,"_28235":194502,"_5797":188883},[],"/docs/pr-preview/pr-56/es/platform/updates/flows#siguientes-pasos",{"_6892":120602,"_42174":120590,"_29767":194504,"_5":21387,"_28235":120590,"_5797":194505},[],"Estos diagramas siguen lo que hace el servicio, paso a paso. Las rutas son relativas a `/updates/v1`. Para ver comandos ejecutables consulta las guías de curl nativa y hawkBit, y la referencia de la API para cada ruta y cuerpo.",{"_6892":120603,"_42174":120590,"_29767":194507,"_5":21387,"_28235":194471,"_5797":194508},[],"Construir convierte los artefactos subidos y la sw-description en un único `.swu`. Nada se firma ni se cifra salvo que la petición de build lo pida.",{"_6892":120604,"_42174":120590,"_29767":194510,"_5":21387,"_28235":194471,"_5797":194511},[],"Cosas que conviene saber sobre el build:",{"_6892":120605,"_42174":120590,"_29767":194513,"_5":21387,"_28235":194471,"_5797":194514},[],"El paquete se crea con un nombre, una `version` semántica, un `group_id`, un `type` y un `packaging` opcional. Un nombre duplicado en el grupo da un `409`.",{"_6892":120606,"_42174":120590,"_29767":194516,"_5":21387,"_28235":194471,"_5797":194517},[],"Subir un artefacto (o un entregable ya construido) a una versión que ya está construida se rechaza con `409`: crea primero una versión nueva. Un build o cambio que colisione con otro sobre el mismo paquete también responde `409`.",{"_6892":120607,"_42174":120590,"_29767":194519,"_5":21387,"_28235":194471,"_5797":194520},[],"Un fichero mayor que `max_artifact_size_mb` (10240 MiB por defecto) se rechaza con `413`.",{"_6892":120608,"_42174":120590,"_29767":194522,"_5":21387,"_28235":194471,"_5797":194523},[],"El cifrado lo decide el cuerpo del build: `user` más `encryption_key_name` es cifrado con clave compartida, y `encryption_alg_name` solo es cifrado por dispositivo (flujo 5).",{"_6892":120609,"_42174":120590,"_29767":194525,"_5":21387,"_28235":194471,"_5797":194526},[],"Si el build falla, el paquete pasa a `build_failed`, `last_build_error` dice por qué, y el paquete sigue siendo editable. Los artefactos seleccionados reemplazan los enlaces de artefactos anteriores de la versión del paquete.",{"_6892":120610,"_42174":120590,"_29767":194528,"_5":21387,"_28235":194471,"_5797":194529},[],"Sin campos de firma, el manifiesto se guarda sin firmar. Si se indica una clave de firma pero no un certificado, el build falla.",{"_6892":120611,"_42174":120590,"_29767":194531,"_5":21387,"_28235":194471,"_5797":194532},[],"Un paquete `non-swu` se construye con `POST .../package` en un `.tar.gz`, y un entregable construido fuera se adjunta con `POST .../swu/upload` o `.../package/upload`.",{"_6892":120612,"_42174":120590,"_29767":194534,"_5":21387,"_28235":194475,"_5797":194535},[],"Crear un lanzamiento decide a quién se dirige y comprueba que el paquete se puede entregar. Todavía no se envía nada a ningún dispositivo.",{"_6892":120613,"_42174":120590,"_29767":194537,"_5":21387,"_28235":194475,"_5797":194538},[],"`?dry_run=true` se detiene tras la comprobación de precondiciones y responde `200` con `qualifying_devices`, `precondition_failures`, `superseded_devices` y `never_seen_devices`. `force_preconditions` apunta a todos los dispositivos del grupo y aun así registra cuáles fallaron. `distribution_set_name`, `workflow_type` y `rollout_type` son obligatorios, y también un `rollout_value` mayor que cero. `approval_threshold` y `error_threshold` deben estar entre 0 y 100, y cada incumplimiento es un `400`. Un lanzamiento también puede llevar `auto`, `scheduled_at`, `name`, `description` y `weight` (consulta Conceptos).",{"_6892":120614,"_42174":120590,"_29767":194540,"_5":21387,"_28235":194479,"_5797":194541},[],"Una llamada `rollout` envía el siguiente lote. El canario va solo primero, y después lotes del tamaño configurado, elegidos al azar entre los dispositivos que siguen pendientes. El lado del dispositivo de abajo es el workflow `direct`, donde un job empieza en `INSTALL`.",{"_6892":120615,"_42174":120590,"_29767":194543,"_5":21387,"_28235":194479,"_5797":194544},[],"Con el workflow `phased`, un job empieza en `CREATED`, y algunas transiciones necesitan que una persona o un sistema las confirme en WFX. Este servicio no las avanza. El workflow `download-install`, que usan los paquetes `non-swu`, recorre `DOWNLOAD → DOWNLOADING → DOWNLOADED → INSTALL → INSTALLING → INSTALLED`.",{"_6892":120616,"_42174":120590,"_29767":194546,"_5":21387,"_28235":194479,"_5797":194547},[],"Con `auto` activado, una llamada `rollout` inicia el lanzamiento y los lotes siguientes los libera el flujo 4. Un lanzamiento con `scheduled_at` lo inicia el disparador de lanzamientos programados en la réplica líder cuando pasa esa hora.",{"_6892":120617,"_42174":120590,"_29767":194549,"_5":21387,"_28235":194479,"_5797":194550},[],"La llamada `rollout` no siempre es un `200` simple:",{"_6892":120618,"_42174":120590,"_29767":194552,"_5":21387,"_28235":194479,"_5797":194553},[],"Se rechaza con `400` cuando el lanzamiento está pausado, cancelado, completado o abortado, y en un lanzamiento `auto` una vez que ha salido algún lote.",{"_6892":120619,"_42174":120590,"_29767":194555,"_5":21387,"_28235":194479,"_5797":194556},[],"No hace nada y responde `200` mientras `scheduled_at` esté todavía en el futuro, y mientras el canario siga activo. Devuelve un error si el canario falló.",{"_6892":120620,"_42174":120590,"_29767":194558,"_5":21387,"_28235":194479,"_5797":194559},[],"Si no se pueden crear algunos jobs, esos dispositivos siguen `pending` y la llamada devuelve un error de «partial rollout» (`500`).",{"_6892":120621,"_42174":120590,"_29767":194561,"_5":21387,"_28235":194483,"_5797":194562},[],"Cada cambio de estado que notifica WFX ejecuta la misma lógica. Es lo que hace funcionar el lote automático, la compuerta del canario y el umbral de error.",{"_6892":120622,"_42174":120590,"_29767":194564,"_5":21387,"_28235":194483,"_5797":194565},[],"En **cada** evento, el servicio actualiza el historial de actualizaciones del dispositivo y escribe el evento en los metadatos del dispositivo en Lamassu. Después, solo si el estado es terminal en el workflow, ejecuta estas comprobaciones en orden, y la primera que se cumple decide lo que ocurre:",{"_6892":120623,"_42174":120590,"_29767":194567,"_5":21387,"_28235":194483,"_5797":86233},[],{"_6892":120624,"_42174":120590,"_29767":194569,"_5":21387,"_28235":194483,"_5797":190768},[],{"_6892":120625,"_42174":120590,"_29767":194571,"_5":21387,"_28235":194483,"_5797":194572},[],"Si se cumple",{"_6892":120626,"_42174":120590,"_29767":194574,"_5":21387,"_28235":194483,"_5797":7036},[],{"_6892":120627,"_42174":120590,"_29767":194576,"_5":21387,"_28235":194483,"_5797":194577},[],"¿Es el estado terminal en el workflow?",{"_6892":120628,"_42174":120590,"_29767":194579,"_5":21387,"_28235":194483,"_5797":194580},[],"Si no, no ocurre nada más",{"_6892":120629,"_42174":120590,"_29767":194582,"_5":21387,"_28235":194483,"_5797":7050},[],{"_6892":120630,"_42174":120590,"_29767":194584,"_5":21387,"_28235":194483,"_5797":194585},[],"(siempre)",{"_6892":120631,"_42174":120590,"_29767":194587,"_5":21387,"_28235":194483,"_5797":194588},[],"Marcar la asignación del dispositivo como `completed` o `failed`. Si tuvo éxito, registrar la versión instalada",{"_6892":120632,"_42174":120590,"_29767":194590,"_5":21387,"_28235":194483,"_5797":7056},[],{"_6892":120633,"_42174":120590,"_29767":194592,"_5":21387,"_28235":194483,"_5797":194593},[],"¿Falló el dispositivo canario?",{"_6892":120634,"_42174":120590,"_29767":194595,"_5":21387,"_28235":194483,"_5797":194596},[],"Pausar el lanzamiento. Reanuda para reintentar",{"_6892":120635,"_42174":120590,"_29767":194598,"_5":21387,"_28235":194483,"_5797":7043},[],{"_6892":120636,"_42174":120590,"_29767":194600,"_5":21387,"_28235":194483,"_5797":194601},[],"¿Está el lanzamiento pausado, cancelado o completado?",{"_6892":120637,"_42174":120590,"_29767":194603,"_5":21387,"_28235":194483,"_5797":194604},[],"Parar: no hay más lotes",{"_6892":120638,"_42174":120590,"_29767":194606,"_5":21387,"_28235":194483,"_5797":16513},[],{"_6892":120639,"_42174":120590,"_29767":194608,"_5":21387,"_28235":194483,"_5797":194609},[],"¿Está definido `error_threshold`, y los fallos han alcanzado esa proporción de todos los dispositivos (redondeada hacia arriba)?",{"_6892":120640,"_42174":120590,"_29767":194611,"_5":21387,"_28235":194483,"_5797":194612},[],"Cancelar el lanzamiento. Los dispositivos pendientes no se envían",{"_6892":120641,"_42174":120590,"_29767":194614,"_5":21387,"_28235":194483,"_5797":28242},[],{"_6892":120642,"_42174":120590,"_29767":194616,"_5":21387,"_28235":194483,"_5797":194617},[],"¿No hay nada pendiente ni nada activo?",{"_6892":120643,"_42174":120590,"_29767":194619,"_5":21387,"_28235":194483,"_5797":194620},[],"Marcar el lanzamiento como `completed`",{"_6892":120644,"_42174":120590,"_29767":194622,"_5":21387,"_28235":194483,"_5797":21503},[],{"_6892":120645,"_42174":120590,"_29767":194624,"_5":21387,"_28235":194483,"_5797":194625},[],"¿Está `auto` desactivado, o no queda nada por enviar?",{"_6892":120646,"_42174":120590,"_29767":194627,"_5":21387,"_28235":194483,"_5797":194628},[],"Esperar a la siguiente llamada `rollout` del operador, o a los dispositivos que siguen en curso",{"_6892":120647,"_42174":120590,"_29767":194630,"_5":21387,"_28235":194483,"_5797":13924},[],{"_6892":120648,"_42174":120590,"_29767":194632,"_5":21387,"_28235":194483,"_5797":194633},[],"¿Tuvo éxito al menos `approval_threshold` de este lote? (0, 100 o más significa todo el lote)",{"_6892":120649,"_42174":120590,"_29767":194635,"_5":21387,"_28235":194483,"_5797":194636},[],"Enviar el siguiente lote. Si no, esperar más resultados",{"_6892":120650,"_42174":120590,"_29767":194638,"_5":21387,"_28235":194483,"_5797":194639},[],"Solo los dispositivos enviados en el lote actual cuentan para su aprobación: un rezagado de un lote anterior nunca cuenta. Las comprobaciones mueven el lanzamiento entre estos estados:",{"_6892":120651,"_42174":120590,"_29767":194641,"_5":21387,"_28235":194483,"_5797":194642},[],"Un lanzamiento nuevo se guarda con estado vacío, que significa `running`. Reanudar tras un fallo del canario vuelve a encolar el canario para que se intente de nuevo. Cancelar detiene los lotes siguientes, pero no retira los jobs que ya se están ejecutando en los dispositivos.",{"_6892":120652,"_42174":120590,"_29767":194644,"_5":21387,"_28235":194487,"_5797":194645},[],"Cada dispositivo recibe su propio paquete, cifrado con su propia clave. El build resuelve primero la clave de cada dispositivo y después construye. Un dispositivo sin clave se omite, y se rechaza un lanzamiento sobre un paquete con dispositivos omitidos.",{"_6892":120653,"_42174":120590,"_29767":194647,"_5":21387,"_28235":194487,"_5797":194648},[],"`uncovered_devices` lista los dispositivos sin clave y también aquellos cuyo propio build falló. Un build en el que ningún dispositivo obtuvo paquete deja el paquete en `build_failed`.",{"_6892":120654,"_42174":120590,"_29767":194650,"_5":21387,"_28235":194494,"_5797":194651},[],"El propio hawkBit no tiene noción de módulo construido, y este servicio solo enlaza módulos construidos a un distribution set de hawkBit. Un set nunca se construye directamente: `POST .../swu` y `.../package` responden `501` en este modo. Primero se construye el módulo, en el catálogo, y el paquete se crea a partir de él. El diagrama muestra la intención `swu-build`.",{"_6892":120655,"_42174":120590,"_29767":194653,"_5":21387,"_28235":194494,"_5797":194654},[],"Las otras intenciones de entrega se saltan pasos: `swu-prebuilt` solo sube el `.swu` terminado, que es lo que construye el módulo, y `raw` solo cifra o firma los ficheros, sin swugenerator ni sw-description (firmar añade un documento de checksum `.sha256` y su firma desacoplada como artefactos extra). Un build puede firmar a través del KMS y cifrar con una clave compartida de SymKMS. El cifrado por dispositivo se rechaza en modo hawkBit. Un módulo enlazado queda congelado: para cambiarlo, edítalo y constrúyelo en el catálogo, y vuelve a enlazarlo.",{"_6892":120656,"_42174":120590,"_29767":194656,"_5":21387,"_28235":194498,"_5797":194657},[],"El dispositivo habla con hawkBit, no con este servicio. El servicio lee el progreso de hawkBit cada vez que se le pide.",{"_6892":120657,"_42174":120590,"_29767":194659,"_5":21387,"_28235":194498,"_5797":194660},[],"Un grupo canario existe solo cuando se indica `test_device_id`. hawkBit decide cuándo un grupo tiene éxito y empieza el siguiente, usando los umbrales de aprobación y de error que le dio el servicio. Con `auto` desactivado, hawkBit se pausa tras cada grupo y la siguiente llamada `rollout` libera el siguiente. La respuesta del lanzamiento también lista `superseded_devices` (dispositivos cuya actualización en curso reemplaza el nuevo rollout) y `never_seen_devices` (dispositivos que nunca han consultado, lo que puede bloquear un grupo que debe alcanzar su umbral de éxito).",{"_6892":120658,"_42174":120590,"_29767":194662,"_5":21387,"_28235":194498,"_5797":194663},[],"La llamada `rollout` depende del estado del rollout:",{"_6892":120659,"_42174":120590,"_29767":194665,"_5":21387,"_28235":194498,"_5797":194666},[],"Un rollout `ready` se inicia, y no ocurre nada mientras su hora de inicio esté en el futuro.",{"_6892":120660,"_42174":120590,"_29767":194668,"_5":21387,"_28235":194498,"_5797":194669},[],"Un rollout pausado solo se reanuda si está pausado entre lotes. Una pausa del operador necesita `resume`, y un rollout detenido por su umbral de error no se puede reanudar.",{"_6892":120661,"_42174":120590,"_29767":194671,"_5":21387,"_28235":194498,"_5797":194672},[],"Un rollout manual en ejecución libera su siguiente grupo.",{"_6892":120662,"_42174":120590,"_29767":194674,"_5":21387,"_28235":194498,"_5797":194675},[],"Un rollout `auto` que ya está en ejecución se rechaza con `400`.",{"_6892":120663,"_42174":120590,"_29767":194677,"_5":21387,"_28235":194498,"_5797":194678},[],"Un segundo `rollout` sobre el mismo lanzamiento mientras hay otro en curso responde `409`.",{"_6892":120664,"_42174":120590,"_29767":194680,"_5":21387,"_28235":194498,"_5797":194681},[],"La autenticación de dispositivos es un ajuste del tenant de hawkBit. Los tokens de seguridad de target vienen desactivados por defecto. Consulta Conectar un dispositivo.",{"_6892":120665,"_42174":120590,"_29767":194683,"_5":21387,"_28235":194502,"_5797":194684},[],"<Card title=\"Publicar y desplegar una actualización\" description=\"Recorre los flujos 1 a 4 de principio a fin.\" href=\"/docs/platform/updates/guides/publish-and-roll-out\" />",{"_6892":120666,"_42174":120590,"_29767":194686,"_5":21387,"_28235":194502,"_5797":194687},[],"<Card title=\"Modelo de datos\" description=\"Las tablas detrás de estos flujos.\" href=\"/docs/platform/updates/data-model\" />",{"_6892":120667,"_42174":120590,"_29767":194689,"_5":21387,"_28235":194502,"_5797":194690},[],"<Card title=\"Firma y cifrado\" description=\"Claves, firmas y el manifiesto.\" href=\"/docs/platform/updates/signing-and-encryption\" />",{"_6892":120668,"_42174":120668,"_5":21817,"_5797":194692,"_42654":194693,"_29767":194694,"_28235":120668},"Primeros pasos con Lamassu Updates",[77248,187247,193621,190589],[],{"_6892":120669,"_42174":120668,"_29767":194696,"_5":21387,"_28235":120668,"_5797":194697},[],"Ejecuta Lamassu Updates y sus dependencias en local con Docker Compose y comprueba que la API responde.",{"_6892":120670,"_42174":120668,"_5":42651,"_29767":194699,"_28235":194700,"_5797":185844},[],"/docs/pr-preview/pr-56/es/platform/updates/getting-started#antes-de-empezar",{"_6892":120671,"_42174":120668,"_5":42651,"_29767":194702,"_28235":194703,"_5797":194704},[],"/docs/pr-preview/pr-56/es/platform/updates/getting-started#arranca-el-stack","Arranca el stack",{"_6892":120672,"_42174":120668,"_5":42651,"_29767":194706,"_28235":194707,"_5797":194708},[],"/docs/pr-preview/pr-56/es/platform/updates/getting-started#clona-el-repositorio","Clona el repositorio",{"_6892":120673,"_42174":120668,"_5":42651,"_29767":194710,"_28235":194711,"_5797":194712},[],"/docs/pr-preview/pr-56/es/platform/updates/getting-started#indica-la-dirección-del-host","Indica la dirección del host",{"_6892":120674,"_42174":120668,"_5":42651,"_29767":194714,"_28235":194715,"_5797":194716},[],"/docs/pr-preview/pr-56/es/platform/updates/getting-started#crea-la-red-y-arranca","Crea la red y arranca",{"_6892":120675,"_42174":120668,"_5":42651,"_29767":194718,"_28235":194719,"_5797":194720},[],"/docs/pr-preview/pr-56/es/platform/updates/getting-started#servicios","Servicios",{"_6892":120676,"_42174":120668,"_5":42651,"_29767":194722,"_28235":194723,"_5797":194724},[],"/docs/pr-preview/pr-56/es/platform/updates/getting-started#verifica-la-api","Verifica la API",{"_6892":120677,"_42174":120668,"_5":42651,"_29767":194726,"_28235":194727,"_5797":194728},[],"/docs/pr-preview/pr-56/es/platform/updates/getting-started#ejecuta-sin-docker","Ejecuta sin Docker",{"_6892":120678,"_42174":120668,"_5":42651,"_29767":194730,"_28235":194731,"_5797":194732},[],"/docs/pr-preview/pr-56/es/platform/updates/getting-started#prueba-el-modo-hawkbit","Prueba el modo hawkBit",{"_6892":120679,"_42174":120668,"_5":42651,"_29767":194734,"_28235":194735,"_5797":189766},[],"/docs/pr-preview/pr-56/es/platform/updates/getting-started#solución-de-problemas",{"_6892":120680,"_42174":120668,"_5":42651,"_29767":194737,"_28235":194738,"_5797":188883},[],"/docs/pr-preview/pr-56/es/platform/updates/getting-started#siguientes-pasos",{"_6892":120681,"_42174":120668,"_29767":194740,"_5":21387,"_28235":120668,"_5797":194741},[],"Esta guía arranca Lamassu Updates (el OTA Update Service) con Docker Compose, en su modo nativo por defecto, y comprueba que la API responde. Lleva unos diez minutos más la construcción de las imágenes. Cuando funcione, continúa con Publica y lanza una actualización.",{"_6892":120682,"_42174":120668,"_29767":194743,"_5":21387,"_28235":194700,"_5797":194744},[],"Docker con el plugin Compose.",{"_6892":120683,"_42174":120668,"_29767":194746,"_5":21387,"_28235":194700,"_5797":194747},[],"Una instancia de Lamassu IoT en ejecución a la que lleguen los contenedores. El servicio lee los grupos de dispositivos y sus dispositivos desde su Device Manager (`dms_endpoint`) y firma con su KMS (`kms_endpoint`) solo cuando pides construcciones firmadas.",{"_6892":120684,"_42174":120668,"_29767":194749,"_5":21387,"_28235":194700,"_5797":194750},[],"Una copia del repositorio `ota` con los módulos `core` y `sdk` de Lamassu a su lado. `go.mod` sustituye `lamassuiot/core` y `lamassuiot/sdk` por rutas locales, y la construcción de Docker los copia desde el **directorio padre** de la copia (`context: ..` en `docker-compose.yml`), así que ese directorio debe contener `ota/` y `lamassuiot/`.",{"_6892":120685,"_42174":120668,"_29767":194752,"_5":21387,"_28235":194700,"_5797":194753},[],"Acceso a la imagen `ghcr.io/lamassuiot/wfx:otaq`, que usa el servicio `custom-wfx`.",{"_6892":120686,"_42174":120668,"_29767":194755,"_5":21387,"_28235":194700,"_5797":194756},[],"Opcional, para el modo hawkBit: un servidor hawkBit. Compose construye uno desde `docker/hawkbit`: hawkBit 1.1.0 más un plugin de artefactos S3, etiquetado en local como `lamassu/hawkbit-update-server:1.1.0-s3`. Esa imagen se construye en local y no está publicada.",{"_6892":120687,"_42174":120668,"_29767":194758,"_5":21387,"_28235":194700,"_5797":194759},[],"Opcional, para ejecutar el servicio fuera de Docker: Go 1.26.2 o superior y Python 3.8 o superior con los requisitos de `swugenerator` instalados. La imagen de Docker ya contiene el binario compilado y Python con `swugenerator`.",{"_6892":120688,"_42174":120668,"_29767":194761,"_5":21387,"_28235":194711,"_5797":194762},[],"El contenedor `updates` llega a Lamassu a través de `host.docker.internal`, que `docker-compose.yml` sustituye por `HOST_IP`. En WSL2, `host.docker.internal` apunta por defecto a la pasarela de Docker Desktop y no al host de WSL, así que indica tu propia dirección:",{"_6892":120689,"_42174":120668,"_29767":194764,"_5":21387,"_28235":194711,"_5797":194765},[],"Después comprueba que `dms_endpoint` y `kms_endpoint` de `config-docker.yml` apuntan a la API de tu Lamassu (por defecto son `http://host.docker.internal:8080/api/...`).",{"_6892":120690,"_42174":120668,"_29767":194767,"_5":21387,"_28235":194715,"_5797":194768},[],"`docker-compose.yml` se conecta a una red existente llamada `ota-net` y no arranca sin ella.",{"_6892":120691,"_42174":120668,"_29767":194770,"_5":21387,"_28235":194719,"_5797":194771},[],"Servicio",{"_6892":120692,"_42174":120668,"_29767":194773,"_5":21387,"_28235":194719,"_5797":194774},[],"Puerto del host",{"_6892":120693,"_42174":120668,"_29767":194776,"_5":21387,"_28235":194719,"_5797":194777},[],"Qué es",{"_6892":120694,"_42174":120668,"_29767":194779,"_5":21387,"_28235":194719,"_5797":86447},[],{"_6892":120695,"_42174":120668,"_29767":194781,"_5":21387,"_28235":194719,"_5797":86450},[],{"_6892":120696,"_42174":120668,"_29767":194783,"_5":21387,"_28235":194719,"_5797":194784},[],"La API de Updates, con SymKMS embebido",{"_6892":120697,"_42174":120668,"_29767":194786,"_5":21387,"_28235":194719,"_5797":86456},[],{"_6892":120698,"_42174":120668,"_29767":194788,"_5":21387,"_28235":194719,"_5797":194789},[],"`9080` (cliente), `9081` (gestión)",{"_6892":120699,"_42174":120668,"_29767":194791,"_5":21387,"_28235":194719,"_5797":194792},[],"WFX, el servidor de trabajos que los dispositivos consultan en modo nativo",{"_6892":120700,"_42174":120668,"_29767":194794,"_5":21387,"_28235":194719,"_5797":86465},[],{"_6892":120701,"_42174":120668,"_29767":194796,"_5":21387,"_28235":194719,"_5797":194797},[],"`5000` (contenedor `5432`)",{"_6892":120702,"_42174":120668,"_29767":194799,"_5":21387,"_28235":194719,"_5797":194800},[],"Base de datos. `init.sql` crea las bases `updates` y `hawkbit` en el primer arranque",{"_6892":120703,"_42174":120668,"_29767":194802,"_5":21387,"_28235":194719,"_5797":86474},[],{"_6892":120704,"_42174":120668,"_29767":194804,"_5":21387,"_28235":194719,"_5797":77705},[],{"_6892":120705,"_42174":120668,"_29767":194806,"_5":21387,"_28235":194719,"_5797":194807},[],"Un cliente de dispositivo SWUpdate de ejemplo",{"_6892":120706,"_42174":120668,"_29767":194809,"_5":21387,"_28235":194719,"_5797":86482},[],{"_6892":120707,"_42174":120668,"_29767":194811,"_5":21387,"_28235":194719,"_5797":86485},[],{"_6892":120708,"_42174":120668,"_29767":194813,"_5":21387,"_28235":194719,"_5797":194814},[],"Servidor hawkBit, solo para el modo hawkBit",{"_6892":120709,"_42174":120668,"_29767":194816,"_5":21387,"_28235":194719,"_5797":86491},[],{"_6892":120710,"_42174":120668,"_29767":194818,"_5":21387,"_28235":194719,"_5797":194819},[],"`9000` (S3), `9001` (consola)",{"_6892":120711,"_42174":120668,"_29767":194821,"_5":21387,"_28235":194719,"_5797":194822},[],"Almacén S3 local, solo con `--profile s3`",{"_6892":120712,"_42174":120668,"_29767":194824,"_5":21387,"_28235":194719,"_5797":194825},[],"`docker compose --profile s3 up -d` también arranca `rustfs` y `s3-init`, que crea el bucket cifrado `ota-updates` que pueden usar los artefactos, las construcciones y el almacenamiento de artefactos de hawkBit. Sin ese perfil, y con `config-docker.yml`, los artefactos y las construcciones se quedan en el volumen `update_files`.",{"_6892":120713,"_42174":120668,"_29767":194827,"_5":21387,"_28235":194723,"_5797":194828},[],"La segunda llamada informa del backend activo y de lo que admite. En modo nativo se parece a esto (abreviado):",{"_6892":120714,"_42174":120668,"_29767":194830,"_5":21387,"_28235":194723,"_5797":194831},[],"`supported` tiene una entrada por cada una de las 22 capacidades. Consulta Capacidades para saber qué significa cada una.",{"_6892":120715,"_42174":120668,"_29767":194833,"_5":21387,"_28235":194727,"_5797":194834},[],"Arranca el punto de entrada monolítico con un fichero de configuración. Ejecuta juntos la API de Updates y SymKMS.",{"_6892":120716,"_42174":120668,"_29767":194836,"_5":21387,"_28235":194727,"_5797":194837},[],"Si `OTA_CONFIG_FILE` no está definida, el servicio lee `/etc/lamassuiot/config.yml`.",{"_6892":120717,"_42174":120668,"_29767":194839,"_5":21387,"_28235":194727,"_5797":194840},[],"Para construir ficheros `.swu` fuera de Docker, instala `swugenerator` en el entorno de Python al que apunta la configuración (la imagen hace lo mismo desde `swugenerator/requirements.txt`):",{"_6892":120718,"_42174":120668,"_29767":194842,"_5":21387,"_28235":194727,"_5797":194843},[],"El `config.yml` de la raíz del repositorio es un punto de partida para desarrollo local, no un fichero listo para usar:",{"_6892":120719,"_42174":120668,"_29767":194845,"_5":21387,"_28235":194727,"_5797":194846},[],"Necesita Postgres (`localhost:5000`) y la API de gestión de WFX (`localhost:9081`), que proporciona `docker compose up -d postgres custom-wfx`.",{"_6892":120720,"_42174":120668,"_29767":194848,"_5":21387,"_28235":194727,"_5797":194849},[],"Contiene valores de una máquina de desarrollo concreta: rutas absolutas `/home/alvaro/...` para el almacenamiento de artefactos y de SymKMS, el script de firma y `swugenerator`, y una IP de la LAN para los endpoints de Lamassu. Edítalos con rutas que el usuario del servicio pueda crear; el servicio se detiene al arrancar si no puede crear sus directorios.",{"_6892":120721,"_42174":120668,"_29767":194851,"_5":21387,"_28235":194727,"_5797":194852},[],"Guarda artefactos y salidas de construcción en el bucket local de RustFS (`docker compose --profile s3 up -d`). Para usar disco local en su lugar, elimina los bloques `artifacts:` y `builds:`; cuando no están, los artefactos van por defecto a `{update_files_base_dir}/artifacts`.",{"_6892":120722,"_42174":120668,"_29767":194854,"_5":21387,"_28235":194731,"_5797":194855},[],"El modo hawkBit sirve la misma API sobre un servidor hawkBit real. Arranca hawkBit y Postgres, espera a que hawkBit responda y arranca el servicio con la configuración de hawkBit:",{"_6892":120723,"_42174":120668,"_29767":194857,"_5":21387,"_28235":194731,"_5797":194858},[],"`config-hawkbit.yml` también contiene rutas de una máquina de desarrollo, en los ajustes de construcción de SWU. Un servicio apuntado a un hawkBit sin dispositivos registrados construye y lanza con normalidad, pero nada descarga la actualización, porque en modo hawkBit los dispositivos consultan a hawkBit directamente. Lee el modo hawkBit antes de usarlo.",{"_6892":120724,"_42174":120668,"_29767":194860,"_5":21387,"_28235":194735,"_5797":192457},[],{"_6892":120725,"_42174":120668,"_29767":194862,"_5":21387,"_28235":194735,"_5797":194863},[],"Causa probable",{"_6892":120726,"_42174":120668,"_29767":194865,"_5":21387,"_28235":194735,"_5797":194866},[],"`docker compose up` falla por la red",{"_6892":120727,"_42174":120668,"_29767":194868,"_5":21387,"_28235":194735,"_5797":194869},[],"`ota-net` no existe. Ejecuta `docker network create ota-net`",{"_6892":120728,"_42174":120668,"_29767":194871,"_5":21387,"_28235":194735,"_5797":194872},[],"El contenedor `updates` no llega a Lamassu",{"_6892":120729,"_42174":120668,"_29767":194874,"_5":21387,"_28235":194735,"_5797":194875},[],"`HOST_IP` está vacío en `.env`, o `dms_endpoint` de `config-docker.yml` apunta a una dirección que el contenedor no alcanza",{"_6892":120730,"_42174":120668,"_29767":194877,"_5":21387,"_28235":194735,"_5797":194878},[],"`docker compose up --build` falla al copiar `lamassuiot/core`",{"_6892":120731,"_42174":120668,"_29767":194880,"_5":21387,"_28235":194735,"_5797":194881},[],"El contexto de construcción (el padre de `ota/`) no contiene `lamassuiot/`",{"_6892":120732,"_42174":120668,"_29767":194883,"_5":21387,"_28235":194735,"_5797":194884},[],"El servicio termina al arrancar cuando se ejecuta en el host",{"_6892":120733,"_42174":120668,"_29767":194886,"_5":21387,"_28235":194735,"_5797":194887},[],"Un directorio de la configuración (`update_files_base_dir`, `sym_keys_dir`) no se puede crear, o Postgres o WFX no son alcanzables en las direcciones del fichero",{"_6892":120734,"_42174":120668,"_29767":194889,"_5":21387,"_28235":194735,"_5797":194890},[],"`capabilities` responde pero los grupos de dispositivos fallan con un error del Device Manager",{"_6892":120735,"_42174":120668,"_29767":194892,"_5":21387,"_28235":194735,"_5797":194893},[],"`dms_endpoint` es incorrecto. La API de Updates lee de él los dispositivos de cada grupo",{"_6892":120736,"_42174":120668,"_29767":194895,"_5":21387,"_28235":194738,"_5797":194896},[],"<Card title=\"Publica y lanza una actualización\" href=\"/docs/platform/updates/guides/publish-and-roll-out\" description=\"Crea un paquete, constrúyelo y lánzalo a un grupo de dispositivos.\" />",{"_6892":120737,"_42174":120668,"_29767":194898,"_5":21387,"_28235":194738,"_5797":194899},[],"<Card title=\"Conecta un dispositivo\" href=\"/docs/platform/updates/guides/connect-a-device\" description=\"Qué debe hacer un dispositivo para recibir actualizaciones en cada backend.\" />",{"_6892":120738,"_42174":120668,"_29767":194901,"_5":21387,"_28235":194738,"_5797":194902},[],"<Card title=\"Referencia de configuración\" href=\"/docs/platform/updates/reference/configuration\" description=\"Cada campo de configuración y su valor por defecto.\" />",{"_6892":120739,"_42174":120739,"_5":21817,"_5797":194904,"_42654":194905,"_29767":194907,"_28235":120739},"Conecta un dispositivo",[77248,187247,193621,194906],"Guías",[],{"_6892":120740,"_42174":120739,"_29767":194909,"_5":21387,"_28235":120739,"_5797":194910},[],"Qué debe hacer un dispositivo para recibir actualizaciones de Lamassu Updates, en modo nativo y en modo hawkBit.",{"_6892":120741,"_42174":120739,"_5":42651,"_29767":194912,"_28235":194913,"_5797":185844},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#antes-de-empezar",{"_6892":120742,"_42174":120739,"_5":42651,"_29767":194915,"_28235":194916,"_5797":194917},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#modo-nativo-el-dispositivo-consulta-a-wfx","Modo nativo: el dispositivo consulta a WFX",{"_6892":120743,"_42174":120739,"_5":42651,"_29767":194919,"_28235":194920,"_5797":194921},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#el-trabajo-que-recibe-el-dispositivo","El trabajo que recibe el dispositivo",{"_6892":120744,"_42174":120739,"_5":42651,"_29767":194923,"_28235":194924,"_5797":194925},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#la-descarga","La descarga",{"_6892":120745,"_42174":120739,"_5":42651,"_29767":194927,"_28235":194928,"_5797":194929},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#los-estados-que-comunica-el-dispositivo","Los estados que comunica el dispositivo",{"_6892":120746,"_42174":120739,"_5":42651,"_29767":194931,"_28235":194932,"_5797":194933},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#modo-hawkbit-el-dispositivo-consulta-a-hawkbit","Modo hawkBit: el dispositivo consulta a hawkBit",{"_6892":120747,"_42174":120739,"_5":42651,"_29767":194935,"_28235":194936,"_5797":194937},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#haz-del-dispositivo-un-target-de-hawkbit","Haz del dispositivo un target de hawkBit",{"_6892":120748,"_42174":120739,"_5":42651,"_29767":194939,"_28235":194940,"_5797":194941},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#configura-swupdate","Configura SWUpdate",{"_6892":120749,"_42174":120739,"_5":42651,"_29767":194943,"_28235":194944,"_5797":194945},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#apunta-al-hawkbit-correcto","Apunta al hawkBit correcto",{"_6892":120750,"_42174":120739,"_5":42651,"_29767":194947,"_28235":194948,"_5797":194949},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#imágenes-firmadas-y-cifradas","Imágenes firmadas y cifradas",{"_6892":120751,"_42174":120739,"_5":42651,"_29767":194951,"_28235":194952,"_5797":193289},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#verifica-el-resultado",{"_6892":120752,"_42174":120739,"_5":42651,"_29767":194954,"_28235":194955,"_5797":189766},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#solución-de-problemas",{"_6892":120753,"_42174":120739,"_5":42651,"_29767":194957,"_28235":194958,"_5797":188883},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/connect-a-device#siguientes-pasos",{"_6892":120754,"_42174":120739,"_29767":194960,"_5":21387,"_28235":120739,"_5797":194961},[],"Esta guía describe el contrato entre un dispositivo y Lamassu Updates, para cada backend. El software del dispositivo es SWUpdate: esta página cubre lo que el dispositivo debe enviar y recibir, no la instalación ni la configuración de SWUpdate, que describe su documentación. Úsala cuando haya un lanzamiento en marcha y ningún dispositivo avance.",{"_6892":120755,"_42174":120739,"_29767":194963,"_5":21387,"_28235":194913,"_5797":194964},[],"Un dispositivo con SWUpdate instalado y una forma de ejecutar un cliente de actualización: un agente pequeño o el módulo `suricatta` de SWUpdate.",{"_6892":120756,"_42174":120739,"_29767":194966,"_5":21387,"_28235":194913,"_5797":194967},[],"Una identidad de dispositivo: un único ID igual en todas partes. Es el ID de cliente de WFX en modo nativo y el ID de controlador de hawkBit en modo hawkBit, y debe coincidir con el ID del dispositivo en el registro de dispositivos de Lamassu (consulta Dispositivos e identidades).",{"_6892":120757,"_42174":120739,"_29767":194969,"_5":21387,"_28235":194913,"_5797":194970},[],"El dispositivo debe ser miembro de un grupo de dispositivos de Lamassu IoT, porque un paquete pertenece a un grupo y un lanzamiento apunta a los dispositivos del grupo. En modo hawkBit, la pertenencia al grupo también se lee del registro cuando `dms_endpoint` está definido.",{"_6892":120758,"_42174":120739,"_29767":194972,"_5":21387,"_28235":194913,"_5797":194973},[],"Solo modo nativo: `update_domain` debe ser una dirección que el dispositivo alcance. Consulta Configuración. En modo hawkBit los dispositivos descargan desde hawkBit.",{"_6892":120759,"_42174":120739,"_29767":194975,"_5":21387,"_28235":194916,"_5797":194976},[],"En modo nativo, un lanzamiento crea un trabajo de WFX por dispositivo. El dispositivo consulta a WFX los trabajos dirigidos a su ID, descarga el entregable de la API de Updates, lo instala y comunica cada estado a WFX. Lamassu Updates lee esos estados de WFX para conducir el lanzamiento.",{"_6892":120760,"_42174":120739,"_29767":194978,"_5":21387,"_28235":194916,"_5797":194979},[],"El dispositivo de ejemplo de `docker-compose.yml` (`swupdate-device1`) muestra la configuración mínima. Usa tres variables: `DEVICE_NAME` (su ID), `WFX_URI` (la API **cliente** de WFX, `http://custom-wfx:8080/api/wfx/v1` dentro de la red de Compose, `localhost:9080` desde el host) y `PORT`. La API de gestión de WFX, en el `9081`, es para el servicio, no para los dispositivos.",{"_6892":120761,"_42174":120739,"_29767":194981,"_5":21387,"_28235":194920,"_5797":194982},[],"El trabajo está dirigido al dispositivo (el `clientId` de WFX es el ID del dispositivo), nombra un workflow y lleva etiquetas del lanzamiento (`lms://secure-updates/<launch id>`) y del grupo (`lms://dms/<group id>`). Su definición es así:",{"_6892":120762,"_42174":120739,"_29767":194984,"_5":21387,"_28235":194920,"_5797":194122},[],{"_6892":120763,"_42174":120739,"_29767":194986,"_5":21387,"_28235":194920,"_5797":193986},[],{"_6892":120764,"_42174":120739,"_29767":194988,"_5":21387,"_28235":194920,"_5797":86664},[],{"_6892":120765,"_42174":120739,"_29767":194990,"_5":21387,"_28235":194920,"_5797":194991},[],"El tipo del paquete: `rawfile`, `firmware`, o ambos (`[\"rawfile\",\"firmware\"]`)",{"_6892":120766,"_42174":120739,"_29767":194993,"_5":21387,"_28235":194920,"_5797":86670},[],{"_6892":120767,"_42174":120739,"_29767":194995,"_5":21387,"_28235":194920,"_5797":194996},[],"Dónde descargar el entregable. El servicio añade el ID del dispositivo, así que cada dispositivo descarga su propio fichero. Un `.swu` para paquetes SWU, un `.tar.gz` para paquetes `non-swu`",{"_6892":120768,"_42174":120739,"_29767":194998,"_5":21387,"_28235":194920,"_5797":86676},[],{"_6892":120769,"_42174":120739,"_29767":195000,"_5":21387,"_28235":194920,"_5797":195001},[],"Presentes solo en un paquete cifrado: el algoritmo y, en paquetes de clave compartida, el IV o nonce en hexadecimal. Un paquete por dispositivo lleva el algoritmo pero no `iv`",{"_6892":120770,"_42174":120739,"_29767":195003,"_5":21387,"_28235":194920,"_5797":86682},[],{"_6892":120771,"_42174":120739,"_29767":195005,"_5":21387,"_28235":194920,"_5797":195006},[],"Presentes solo en un paquete firmado",{"_6892":120772,"_42174":120739,"_29767":195008,"_5":21387,"_28235":194920,"_5797":195009},[],"El dispositivo necesita la clave para descifrar, y la tiene él mismo. En un paquete por dispositivo es la clave que SymKMS asignó a ese dispositivo, y cada dispositivo descarga un fichero distinto.",{"_6892":120773,"_42174":120739,"_29767":195011,"_5":21387,"_28235":194924,"_5797":195012},[],"La descarga responde con los bytes, o con `302` a una URL firmada de corta duración cuando las descargas prefirmadas están activadas para el almacén de construcciones. Asegúrate de que el cliente HTTP del dispositivo sigue redirecciones. La ruta también responde a `HEAD` y a peticiones de rango de bytes (`206`), de modo que una descarga interrumpida puede reanudarse. La URL se fija al construir el paquete, así que un dispositivo no ve un `update_domain` nuevo hasta que reconstruyes.",{"_6892":120774,"_42174":120739,"_29767":195014,"_5":21387,"_28235":194928,"_5797":195015},[],"El dispositivo mueve su trabajo por los estados del workflow, y el workflow decide quién puede hacer cada movimiento. Para el workflow `direct`:",{"_6892":120775,"_42174":120739,"_29767":195017,"_5":21387,"_28235":194928,"_5797":195018},[],"El dispositivo comunica `INSTALLING`, `INSTALLED`, `ACTIVATING` y `ACTIVATED`. El paso `INSTALLED → ACTIVATE` lo hace el propio WFX. Desde `INSTALL`, `INSTALLING`, `ACTIVATE` y `ACTIVATING` el dispositivo puede pasar a `TERMINATED` para comunicar un fallo; `INSTALLED` no tiene transición de fallo.",{"_6892":120776,"_42174":120739,"_29767":195020,"_5":21387,"_28235":194928,"_5797":78301},[],{"_6892":120777,"_42174":120739,"_29767":195022,"_5":21387,"_28235":194928,"_5797":195023},[],"Se usa para",{"_6892":120778,"_42174":120739,"_29767":195025,"_5":21387,"_28235":194928,"_5797":195026},[],"Estados terminales",{"_6892":120779,"_42174":120739,"_29767":195028,"_5":21387,"_28235":194928,"_5797":86708},[],{"_6892":120780,"_42174":120739,"_29767":195030,"_5":21387,"_28235":194928,"_5797":194201},[],{"_6892":120781,"_42174":120739,"_29767":195032,"_5":21387,"_28235":194928,"_5797":195033},[],"`ACTIVATED` (éxito), `TERMINATED` (fallo)",{"_6892":120782,"_42174":120739,"_29767":195035,"_5":21387,"_28235":194928,"_5797":86716},[],{"_6892":120783,"_42174":120739,"_29767":195037,"_5":21387,"_28235":194928,"_5797":195038},[],"Paquetes SWU con pasos de confirmación (`CREATED → DOWNLOAD → ... → ACTIVATED`)",{"_6892":120784,"_42174":120739,"_29767":195040,"_5":21387,"_28235":194928,"_5797":86722},[],{"_6892":120785,"_42174":120739,"_29767":195042,"_5":21387,"_28235":194928,"_5797":86725},[],{"_6892":120786,"_42174":120739,"_29767":195044,"_5":21387,"_28235":194928,"_5797":195045},[],"Paquetes `non-swu`: `DOWNLOAD → ... → INSTALLED`, cada movimiento lo hace el dispositivo",{"_6892":120787,"_42174":120739,"_29767":195047,"_5":21387,"_28235":194928,"_5797":86731},[],{"_6892":120788,"_42174":120739,"_29767":195049,"_5":21387,"_28235":194928,"_5797":86734},[],{"_6892":120789,"_42174":120739,"_29767":195051,"_5":21387,"_28235":194928,"_5797":195052},[],"Mínimo `DOWNLOAD → INSTALL → INSTALLED`",{"_6892":120790,"_42174":120739,"_29767":195054,"_5":21387,"_28235":194928,"_5797":86731},[],{"_6892":120791,"_42174":120739,"_29767":195056,"_5":21387,"_28235":194928,"_5797":195057},[],"Un trabajo `phased` tiene movimientos que hace WFX o un operador, y nada en Lamassu Updates los avanza: se queda en `CREATED` hasta que alguien lo confirma a través de WFX (el botón **Next** del dashboard lo hace). Los endpoints `force-version` y `sync-to-latest` usan `phased` para los paquetes SWU salvo que indiques un `workflow`. Los ficheros de workflow están en `wfx/workflow/dau/` del repositorio. La API HTTP de WFX (listar trabajos, actualizar estado) la documenta WFX.",{"_6892":120792,"_42174":120739,"_29767":195059,"_5":21387,"_28235":194932,"_5797":195060},[],"En modo hawkBit los dispositivos no consultan a Lamassu Updates. Consultan la API DDI de hawkBit, y Lamassu Updates lee de hawkBit el estado resultante de las acciones.",{"_6892":120793,"_42174":120739,"_29767":195062,"_5":21387,"_28235":194936,"_5797":195063},[],"El dispositivo necesita un ID de controlador y un target etiquetado `group:<id>` para su grupo. Con `dms_endpoint` definido, el servicio lo hace por sí mismo: cuando lee del registro los dispositivos de un grupo, crea los targets que faltan y los etiqueta. Sin `dms_endpoint`, creas tú los targets y las etiquetas. En ambos casos el dispositivo debe consultar a hawkBit con credenciales válidas.",{"_6892":120794,"_42174":120739,"_29767":195065,"_5":21387,"_28235":194940,"_5797":195066},[],"Apunta el SWUpdate del dispositivo (`suricatta`) a la URL de hawkBit (`hawkbit.ddi_url`, que por defecto es `hawkbit.base_url`), con el tenant, el ID de controlador y un método de autenticación que acepte tu tenant de hawkBit. hawkBit rechaza por defecto a los dispositivos sin autenticar. Con tokens de seguridad de target, actívalos para el tenant (`PUT /rest/v1/system/configs/authentication.targettoken.enabled` con `{\"value\":true}`) y entrega a cada dispositivo el `securityToken` de su target, que envía como `Authorization: TargetToken <token>`. La guía curl de hawkBit muestra cada petición.",{"_6892":120795,"_42174":120739,"_29767":195068,"_5":21387,"_28235":194944,"_5797":195069},[],"El dispositivo debe consultar el **mismo hawkBit** para el que está configurado el servicio. Un servicio apuntado a un hawkBit sin targets construye y lanza sin error, y nada lo descarga. Consulta Solución de problemas.",{"_6892":120796,"_42174":120739,"_29767":195071,"_5":21387,"_28235":194944,"_5797":195072},[],"hawkBit entrega entonces al dispositivo todos los artefactos de su conjunto de distribución. Un paquete con varios módulos ejecuta varias instalaciones independientes.",{"_6892":120797,"_42174":120739,"_29767":195074,"_5":21387,"_28235":194944,"_5797":195075},[],"Cuando tu pasarela enruta las URL de artefactos de dispositivo de hawkBit (la ruta de `hawkbit.ddi_url`, `.../<tenant>/controller/v1/<controller>/softwaremodules/<id>/artifacts/<file>`) hacia Lamassu Updates, el servicio las sirve solo para módulos asignados o instalados en ese controlador, y responde `404` en los demás casos. Con las descargas prefirmadas activadas, redirige a una URL firmada del bucket S3 de hawkBit en lugar de transmitir el fichero.",{"_6892":120798,"_42174":120739,"_29767":195077,"_5":21387,"_28235":194948,"_5797":195078},[],"Si el dispositivo verifica firmas, define su clave pública (`public-key-file` en la configuración de SWUpdate) y firma el paquete con la clave correspondiente. Si descifra, necesita la misma clave y el mismo algoritmo con que se construyó el paquete. Una discrepancia es la causa habitual de que una instalación falle en silencio tras una descarga correcta. Firma y cifrado explica qué clave, algoritmo e IV usa cada modo y qué recibe el dispositivo.",{"_6892":120799,"_42174":120739,"_29767":195080,"_5":21387,"_28235":194952,"_5797":195081},[],"Tras un lanzamiento, el trabajo del dispositivo llega a `ACTIVATED` (o a `INSTALLED` en un paquete `non-swu`), los contadores del lanzamiento se actualizan y el inventario del dispositivo lista el paquete:",{"_6892":120800,"_42174":120739,"_29767":195083,"_5":21387,"_28235":194952,"_5797":195084},[],"Consulta Publica y lanza una actualización para el resto de comprobaciones.",{"_6892":120801,"_42174":120739,"_29767":195086,"_5":21387,"_28235":194955,"_5797":192457},[],{"_6892":120802,"_42174":120739,"_29767":195088,"_5":21387,"_28235":194955,"_5797":194863},[],{"_6892":120803,"_42174":120739,"_29767":195090,"_5":21387,"_28235":194955,"_5797":195091},[],"El dispositivo nunca ve un trabajo (nativo)",{"_6892":120804,"_42174":120739,"_29767":195093,"_5":21387,"_28235":194955,"_5797":195094},[],"Consulta un endpoint de WFX equivocado o usa un ID distinto del miembro del grupo. El `clientId` de WFX debe coincidir con el ID del dispositivo",{"_6892":120805,"_42174":120739,"_29767":195096,"_5":21387,"_28235":194955,"_5797":195097},[],"El trabajo se queda en `CREATED`",{"_6892":120806,"_42174":120739,"_29767":195099,"_5":21387,"_28235":194955,"_5797":195100},[],"El lanzamiento usa `phased`. Confírmalo a través de WFX o del dashboard, o vuelve a lanzar con `direct`",{"_6892":120807,"_42174":120739,"_29767":195102,"_5":21387,"_28235":194955,"_5797":195103},[],"La descarga falla con `404`",{"_6892":120808,"_42174":120739,"_29767":195105,"_5":21387,"_28235":194955,"_5797":195106},[],"El paquete está cifrado por dispositivo y el dispositivo no tiene clave, o la URL nombra a otro dispositivo. Revisa la cobertura del paquete y que la URL termine con el ID de este dispositivo",{"_6892":120809,"_42174":120739,"_29767":195108,"_5":21387,"_28235":194955,"_5797":195109},[],"La descarga termina bien y la instalación falla",{"_6892":120810,"_42174":120739,"_29767":195111,"_5":21387,"_28235":194955,"_5797":195112},[],"La firma o la clave no coinciden con lo que tiene el dispositivo. Consulta Firma y cifrado",{"_6892":120811,"_42174":120739,"_29767":195114,"_5":21387,"_28235":194955,"_5797":195115},[],"Un lanzamiento `non-swu` parece atascado aunque el dispositivo terminó",{"_6892":120812,"_42174":120739,"_29767":195117,"_5":21387,"_28235":194955,"_5797":195118},[],"Se lanzó con `direct` o `phased`, que esperan `ACTIVATED`. Lanza los paquetes `non-swu` con `download-install`",{"_6892":120813,"_42174":120739,"_29767":195120,"_5":21387,"_28235":194955,"_5797":195121},[],"El lanzamiento nunca avanza (hawkBit)",{"_6892":120814,"_42174":120739,"_29767":195123,"_5":21387,"_28235":194955,"_5797":195124},[],"El dispositivo no consulta este hawkBit, no está etiquetado en el grupo o no puede autenticarse",{"_6892":120815,"_42174":120739,"_29767":195126,"_5":21387,"_28235":194958,"_5797":195127},[],"<Card title=\"Firma y cifrado\" href=\"/docs/platform/updates/signing-and-encryption\" description=\"Claves, algoritmos y qué debe tener el dispositivo.\" />",{"_6892":120816,"_42174":120739,"_29767":195129,"_5":21387,"_28235":194958,"_5797":195130},[],"<Card title=\"Modo hawkBit\" href=\"/docs/platform/updates/hawkbit-mode\" description=\"Cómo el adaptador traduce paquetes y campañas a hawkBit.\" />",{"_6892":120817,"_42174":120739,"_29767":195132,"_5":21387,"_28235":194958,"_5797":195133},[],"<Card title=\"Solución de problemas\" href=\"/docs/platform/updates/troubleshooting\" description=\"Actualizaciones que no llegan a los dispositivos y otros fallos.\" />",{"_6892":120818,"_42174":120818,"_5":21817,"_5797":195135,"_42654":195136,"_29767":195137,"_28235":120818},"Usa el dashboard",[77248,187247,193621,194906],[],{"_6892":120819,"_42174":120818,"_29767":195139,"_5":21387,"_28235":120818,"_5797":195140},[],"Publica, lanza y sigue una actualización desde el dashboard de Lamassu, pantalla a pantalla.",{"_6892":120820,"_42174":120818,"_5":42651,"_29767":195142,"_28235":195143,"_5797":185844},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#antes-de-empezar",{"_6892":120821,"_42174":120818,"_5":42651,"_29767":195145,"_28235":195146,"_5797":195147},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#conéctalo-al-servicio","Conéctalo al servicio",{"_6892":120822,"_42174":120818,"_5":42651,"_29767":195149,"_28235":195150,"_5797":195151},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#dónde-está-cada-cosa","Dónde está cada cosa",{"_6892":120823,"_42174":120818,"_5":42651,"_29767":195153,"_28235":195154,"_5797":195155},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#1-crea-un-distribution-set","1\\. Crea un distribution set",{"_6892":120824,"_42174":120818,"_5":42651,"_29767":195157,"_28235":195158,"_5797":195159},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#2-añade-ficheros-y-construye-nativo","2\\. Añade ficheros y construye (nativo)",{"_6892":120825,"_42174":120818,"_5":42651,"_29767":195161,"_28235":195162,"_5797":195163},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#hawkbit-construye-primero-un-módulo","hawkBit: construye primero un módulo",{"_6892":120826,"_42174":120818,"_5":42651,"_29767":195165,"_28235":195166,"_5797":195167},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#3-inicia-una-campaña","3\\. Inicia una campaña",{"_6892":120827,"_42174":120818,"_5":42651,"_29767":195169,"_28235":195170,"_5797":195171},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#4-ejecuta-y-vigila-la-campaña","4\\. Ejecuta y vigila la campaña",{"_6892":120828,"_42174":120818,"_5":42651,"_29767":195173,"_28235":195174,"_5797":195175},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#5-sigue-los-dispositivos","5\\. Sigue los dispositivos",{"_6892":120829,"_42174":120818,"_5":42651,"_29767":195177,"_28235":195178,"_5797":195179},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#qué-cambia-según-el-backend","Qué cambia según el backend",{"_6892":120830,"_42174":120818,"_5":42651,"_29767":195181,"_28235":195182,"_5797":195183},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#lo-que-no-está-en-el-dashboard","Lo que no está en el dashboard",{"_6892":120831,"_42174":120818,"_5":42651,"_29767":195185,"_28235":195186,"_5797":189766},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#solución-de-problemas",{"_6892":120832,"_42174":120818,"_5":42651,"_29767":195188,"_28235":195189,"_5797":188883},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/dashboard#siguientes-pasos",{"_6892":120833,"_42174":120818,"_29767":195191,"_5":21387,"_28235":120818,"_5797":195192},[],"El dashboard de Lamassu es la interfaz web de la API de Updates. Esta guía sigue la misma actualización que las guías curl (nativa y hawkBit) a través de las pantallas. Los nombres en negrita son las etiquetas que muestra el dashboard.",{"_6892":120834,"_42174":120818,"_29767":195194,"_5":21387,"_28235":120818,"_5797":195195},[],"El dashboard es un proyecto aparte (`lamassu-dashboard`). Esta guía lo describe a partir de su código fuente y no tiene capturas, así que una etiqueta puede diferir en una versión más reciente. El dashboard no tiene traducciones: sus etiquetas están en inglés, y aquí se mantienen tal cual.",{"_6892":120835,"_42174":120818,"_29767":195197,"_5":21387,"_28235":195143,"_5797":195198},[],"Lamassu Updates está en marcha y el dashboard puede alcanzarlo. Consulta Conéctalo al servicio.",{"_6892":120836,"_42174":120818,"_29767":195200,"_5":21387,"_28235":195143,"_5797":195201},[],"Un **grupo de dispositivos** de Lamassu IoT que contenga los dispositivos que vas a actualizar (**Device Groups** dentro de **IoT**). Los miembros de un grupo son los dispositivos que cumplen sus criterios.",{"_6892":120837,"_42174":120818,"_29767":195203,"_5":21387,"_28235":195143,"_5797":195204},[],"Para una construcción SWU con firma o cifrado: una clave de firma en **Asymmetric Keys** o una clave simétrica en **Symmetric Keys** (ambas en **KMS**) y, para el cifrado por dispositivo, claves asignadas a los dispositivos en **Device Key Inventory** (en **IoT**).",{"_6892":120838,"_42174":120818,"_29767":195206,"_5":21387,"_28235":195146,"_5797":195207},[],"El dashboard habla con la API de Updates en la dirección indicada en `LAMASSU_UPDATES_API`, en su `public/config.js`. En la imagen de contenedor procede de la variable de entorno del mismo nombre.",{"_6892":120839,"_42174":120818,"_29767":195209,"_5":21387,"_28235":195146,"_5797":195210},[],"El dashboard le añade `/updates/v1` y `/symkms/v1`. Se acepta y se elimina un `/updates/v1` final.",{"_6892":120840,"_42174":120818,"_29767":195212,"_5":21387,"_28235":195146,"_5797":195213},[],"Si está vacía, el dashboard usa `LAMASSU_API`.",{"_6892":120841,"_42174":120818,"_29767":195215,"_5":21387,"_28235":195146,"_5797":195216},[],"Cuando la autenticación está activada, cada llamada lleva el bearer token del usuario. El servicio lo ignora, así que pon delante una pasarela que lo compruebe. Consulta Seguridad.",{"_6892":120842,"_42174":120818,"_29767":195218,"_5":21387,"_28235":195146,"_5797":195219},[],"Debe apuntar a la instancia del servicio que ejecuta el backend que quieres usar. Un servicio ejecuta modo nativo o modo hawkBit, nunca los dos: para usar ambos a la vez ejecutas dos instancias, cada una en su puerto, y apuntas el dashboard a una de ellas.",{"_6892":120843,"_42174":120818,"_29767":195221,"_5":21387,"_28235":195146,"_5797":195222},[],"El dashboard lee `GET /updates/v1/capabilities` una vez, después de iniciar sesión, y oculta lo que el backend no puede hacer. Por eso las mismas pantallas se ven distintas en modo nativo y en modo hawkBit. Qué cambia según el backend enumera las diferencias. Si la petición de capacidades falla, el dashboard asume que todo está admitido y no oculta nada.",{"_6892":120844,"_42174":120818,"_29767":195224,"_5":21387,"_28235":195146,"_5797":195225},[],"Para comparar ambos backends, el menú de usuario tiene un selector **Updates backend** con las opciones **Auto**, **native** y **hawkbit**. Aparece solo en compilaciones de desarrollo, o cuando el contenedor del dashboard se ejecuta con `DEV_OPTIONS_ENABLED=true`. Elegir native o hawkbit sustituye `LAMASSU_UPDATES_API` en ese navegador, muestra un campo editable **Updates API base URL** y recarga la página. Los valores por defecto son `http://localhost:10090` (native) y `http://localhost:10091` (hawkbit) en localhost, y `<origin>/api` y `<origin>/api/hawkbit` en cualquier otro host.",{"_6892":120845,"_42174":120818,"_29767":195227,"_5":21387,"_28235":195150,"_5797":195228},[],"El grupo de la barra lateral **OTA UPDATES MANAGER** tiene:",{"_6892":120846,"_42174":120818,"_29767":195230,"_5":21387,"_28235":195150,"_5797":195231},[],"Elemento",{"_6892":120847,"_42174":120818,"_29767":195233,"_5":21387,"_28235":195150,"_5797":195234},[],"Ruta",{"_6892":120848,"_42174":120818,"_29767":195236,"_5":21387,"_28235":195150,"_5797":194777},[],{"_6892":120849,"_42174":120818,"_29767":195238,"_5":21387,"_28235":195150,"_5797":86924},[],{"_6892":120850,"_42174":120818,"_29767":195240,"_5":21387,"_28235":195150,"_5797":86927},[],{"_6892":120851,"_42174":120818,"_29767":195242,"_5":21387,"_28235":195150,"_5797":195243},[],"Título de página **OTA Dashboard**: salud de los lanzamientos, campañas que requieren atención, distribución de versiones y próxima planificación",{"_6892":120852,"_42174":120818,"_29767":195245,"_5":21387,"_28235":195150,"_5797":86933},[],{"_6892":120853,"_42174":120818,"_29767":195247,"_5":21387,"_28235":195150,"_5797":86936},[],{"_6892":120854,"_42174":120818,"_29767":195249,"_5":21387,"_28235":195150,"_5797":195250},[],"Todos los dispositivos con su versión instalada y su versión objetivo",{"_6892":120855,"_42174":120818,"_29767":195252,"_5":21387,"_28235":195150,"_5797":86942},[],{"_6892":120856,"_42174":120818,"_29767":195254,"_5":21387,"_28235":195150,"_5797":86945},[],{"_6892":120857,"_42174":120818,"_29767":195256,"_5":21387,"_28235":195150,"_5797":195257},[],"Grupos, con cuántos dispositivos van retrasados",{"_6892":120858,"_42174":120818,"_29767":195259,"_5":21387,"_28235":195150,"_5797":86951},[],{"_6892":120859,"_42174":120818,"_29767":195261,"_5":21387,"_28235":195150,"_5797":86954},[],{"_6892":120860,"_42174":120818,"_29767":195263,"_5":21387,"_28235":195150,"_5797":195264},[],"Los paquetes de actualización de todos los grupos",{"_6892":120861,"_42174":120818,"_29767":195266,"_5":21387,"_28235":195150,"_5797":86960},[],{"_6892":120862,"_42174":120818,"_29767":195268,"_5":21387,"_28235":195150,"_5797":86963},[],{"_6892":120863,"_42174":120818,"_29767":195270,"_5":21387,"_28235":195150,"_5797":195271},[],"El catálogo de módulos",{"_6892":120864,"_42174":120818,"_29767":195273,"_5":21387,"_28235":195150,"_5797":86969},[],{"_6892":120865,"_42174":120818,"_29767":195275,"_5":21387,"_28235":195150,"_5797":86972},[],{"_6892":120866,"_42174":120818,"_29767":195277,"_5":21387,"_28235":195150,"_5797":195278},[],"Lanzamientos: lista, creación, ejecución",{"_6892":120867,"_42174":120818,"_29767":195280,"_5":21387,"_28235":195150,"_5797":195281},[],"El grupo **IoT** tiene **Devices**, **Device Groups** (el registro de dispositivos de Lamassu y sus grupos), **Device Key Inventory** y **Platform Integrations**. El grupo **JOB MANAGER** (**Jobs**, **Workflows**) lista trabajos y workflows de WFX en bruto. No usa la API de Updates y no crea lanzamientos.",{"_6892":120868,"_42174":120818,"_29767":195283,"_5":21387,"_28235":195150,"_5797":195284},[],"En el dashboard, un paquete es un **distribution set** y un lanzamiento es una **campaign**.",{"_6892":120869,"_42174":120818,"_29767":195286,"_5":21387,"_28235":195154,"_5797":195287},[],"Abre **Distribution Set**. La lista muestra los paquetes de todos los grupos, con filtros de grupo de dispositivos y de estado, un cuadro de búsqueda y un botón **Refresh**. Pulsa **New Distribution Set**.",{"_6892":120870,"_42174":120818,"_29767":195289,"_5":21387,"_28235":195154,"_5797":194122},[],{"_6892":120871,"_42174":120818,"_29767":195291,"_5":21387,"_28235":195154,"_5797":195292},[],"Notas",{"_6892":120872,"_42174":120818,"_29767":195294,"_5":21387,"_28235":195154,"_5797":86992},[],{"_6892":120873,"_42174":120818,"_29767":195296,"_5":21387,"_28235":195154,"_5797":195297},[],"Al menos 3 caracteres, sin espacios. Usa guiones bajos. El modo nativo, además, solo acepta letras, dígitos, `.`, `_` y `-`",{"_6892":120874,"_42174":120818,"_29767":195299,"_5":21387,"_28235":195154,"_5797":86998},[],{"_6892":120875,"_42174":120818,"_29767":195301,"_5":21387,"_28235":195154,"_5797":195302},[],"Semver, por defecto `1.0.0`",{"_6892":120876,"_42174":120818,"_29767":195304,"_5":21387,"_28235":195154,"_5797":87004},[],{"_6892":120877,"_42174":120818,"_29767":195306,"_5":21387,"_28235":195154,"_5797":195307},[],"Obligatorio. Un paquete pertenece a un grupo y solo se puede lanzar a sus dispositivos",{"_6892":120878,"_42174":120818,"_29767":195309,"_5":21387,"_28235":195154,"_5797":87010},[],{"_6892":120879,"_42174":120818,"_29767":195311,"_5":21387,"_28235":195154,"_5797":195312},[],"**Raw File** (sin reinicio), **Firmware** (con reinicio), **Both** u **Other Type**",{"_6892":120880,"_42174":120818,"_29767":195314,"_5":21387,"_28235":195154,"_5797":87016},[],{"_6892":120881,"_42174":120818,"_29767":195316,"_5":21387,"_28235":195154,"_5797":195317},[],"Nativo: **SWU** construye una imagen firmada (la firma es opcional), **Generic** entrega los ficheros tal cual. hawkBit: **SWU** acepta solo módulos SWU, **Generic** acepta binarios y otros ficheros. No se puede cambiar tras crear el paquete",{"_6892":120882,"_42174":120818,"_29767":195319,"_5":21387,"_28235":195154,"_5797":87022},[],{"_6892":120883,"_42174":120818,"_29767":195321,"_5":21387,"_28235":195154,"_5797":195322},[],"Permite que los dispositivos descarguen versiones anteriores de este paquete",{"_6892":120884,"_42174":120818,"_29767":195324,"_5":21387,"_28235":195154,"_5797":87028},[],{"_6892":120885,"_42174":120818,"_29767":195326,"_5":21387,"_28235":195154,"_5797":195327},[],"Precondiciones de lanzamiento opcionales (plegado): los dispositivos ya deben tener otro distribution set, o un módulo de software, en una versión mínima",{"_6892":120886,"_42174":120818,"_29767":195329,"_5":21387,"_28235":195154,"_5797":195330},[],"Pulsa **Create Distribution Set**. Llegas a la página del paquete. Las precondiciones siguen siendo editables allí, en **Launch Preconditions** de la pestaña **Overview** (**Save preconditions**).",{"_6892":120887,"_42174":120818,"_29767":195332,"_5":21387,"_28235":195154,"_5797":195333},[],"En modo hawkBit el formulario tiene una sección más, **Software modules**. Un conjunto de hawkBit enlaza módulos construidos, así que marca al menos un módulo construido, y como mucho un módulo OS. La tabla lista solo los módulos que encajan con el **Driver**: un conjunto SWU oculta los módulos entregados como ficheros en bruto, y uno Generic oculta los módulos entregados como SWU prefabricado. Si no encaja ninguno, dice «No built module fits this driver», y primero construyes uno (consulta hawkBit: construye primero un módulo).",{"_6892":120888,"_42174":120818,"_29767":195335,"_5":21387,"_28235":195154,"_5797":195336},[],"En el backend nativo, el **Driver** decide además qué workflow puede instalar el paquete: los paquetes SWU necesitan **Direct** o **Phased** y los Generic necesitan **Download-Install**. Una discrepancia deja la actualización pareciendo atascada cuando el dispositivo ya terminó.",{"_6892":120889,"_42174":120818,"_29767":195338,"_5":21387,"_28235":195158,"_5797":195339},[],"En la página del paquete (`/updates/pack-details`) abre la pestaña **Software Modules**. Un paquete nativo empieza con un módulo OS con el nombre del paquete («Not composed»). Abre el menú de su fila y elige **Add files**, suelta tu fichero y súbelo. El nombre del artefacto es por defecto el del fichero sin su extensión, y la versión es opcional (semver). Para componer el paquete con más módulos, usa **Add module** (un módulo de aplicación nuevo) o **Import module** (copia uno existente); el paquete sigue construyendo un único SWU.",{"_6892":120890,"_42174":120818,"_29767":195341,"_5":21387,"_28235":195158,"_5797":195342},[],"Después pulsa **Generate SWU** en la cabecera. La hoja **SWU deliverable** tiene dos pestañas.",{"_6892":120891,"_42174":120818,"_29767":195344,"_5":21387,"_28235":195158,"_5797":195345},[],"**Build here** construye el paquete a partir de los artefactos del paquete:",{"_6892":120892,"_42174":120818,"_29767":195347,"_5":21387,"_28235":195158,"_5797":189035},[],{"_6892":120893,"_42174":120818,"_29767":195349,"_5":21387,"_28235":195158,"_5797":195350},[],"Qué hacer",{"_6892":120894,"_42174":120818,"_29767":195352,"_5":21387,"_28235":195158,"_5797":87057},[],{"_6892":120895,"_42174":120818,"_29767":195354,"_5":21387,"_28235":195158,"_5797":195355},[],"Casillas, todas marcadas por defecto",{"_6892":120896,"_42174":120818,"_29767":195357,"_5":21387,"_28235":195158,"_5797":87063},[],{"_6892":120897,"_42174":120818,"_29767":195359,"_5":21387,"_28235":195158,"_5797":195360},[],"Obligatorio. Carga el fichero o escríbelo en el editor. Una lista de comprobación muestra cada fichero que declara la descripción, y un fichero declarado pero no seleccionado bloquea la construcción",{"_6892":120898,"_42174":120818,"_29767":195362,"_5":21387,"_28235":195158,"_5797":87069},[],{"_6892":120899,"_42174":120818,"_29767":195364,"_5":21387,"_28235":195158,"_5797":195365},[],"**Signing key**: ninguna (sin firmar) o una clave del KMS. Con una clave, elige un **Method** y un **Certificate**",{"_6892":120900,"_42174":120818,"_29767":195367,"_5":21387,"_28235":195158,"_5797":87075},[],{"_6892":120901,"_42174":120818,"_29767":195369,"_5":21387,"_28235":195158,"_5797":195370},[],"Ninguno, &#x2A;*Shared (one key for all devices)** o &#x2A;*Per-device (key per device)**",{"_6892":120902,"_42174":120818,"_29767":195372,"_5":21387,"_28235":195158,"_5797":195373},[],"Para el cifrado compartido elige una **Symmetric key** y si cifrar el descriptor (**Encrypt the descriptor**) y todos los ficheros (**Encrypt all files**), o marca ficheros individuales. Para el cifrado por dispositivo elige un **Algorithm** (por defecto `Ascon-128a`). Cada dispositivo usa entonces su propia clave del inventario de claves de dispositivo. Si no eliges ninguna seguridad, la hoja dice «No security selected».",{"_6892":120903,"_42174":120818,"_29767":195375,"_5":21387,"_28235":195158,"_5797":195376},[],"Pulsa **Generate SWU**. La hoja sube el sw-description y después construye. La insignia pasa a **Built** y el botón de la cabecera pasa a decir **Regenerate SWU**. Junto a él aparece **Download SWU**, salvo en un paquete por dispositivo: no hay descarga del conjunto completo, y el paquete de cada dispositivo se descarga por dispositivo.",{"_6892":120904,"_42174":120818,"_29767":195378,"_5":21387,"_28235":195158,"_5797":195379},[],"**Upload pre-built** adjunta un `.swu` que construiste por tu cuenta, hasta el `max_artifact_size_mb` del servicio (10 GiB por defecto). Se guarda y se sirve sin cambios, no se firma ni se cifra nada por ti, y la versión pasa a estar construida e inmutable.",{"_6892":120905,"_42174":120818,"_29767":195381,"_5":21387,"_28235":195158,"_5797":195382},[],"Un paquete **non-swu** tiene **Generate Package** en su lugar. Construye un `.tar.gz` con los artefactos seleccionados, con firma opcional y cifrado compartido o por dispositivo opcional (el cifrado es AES-GCM), y también tiene una pestaña **Upload pre-built**. **Download Package** descarga el resultado.",{"_6892":120906,"_42174":120818,"_29767":195384,"_5":21387,"_28235":195158,"_5797":195385},[],"Para cambiar un paquete construido, crea una versión nueva: usa **New Version** en el menú de fila de la lista de paquetes (el diálogo tiene **Create Version**), o **New Version to Edit** en la pestaña **Artifacts** del paquete. La versión nueva debe ser mayor que la actual, y borra el paquete construido.",{"_6892":120907,"_42174":120818,"_29767":195387,"_5":21387,"_28235":195162,"_5797":195388},[],"En modo hawkBit, los ficheros de un paquete viven en módulos, construidos en el catálogo.",{"_6892":120908,"_42174":120818,"_29767":195390,"_5":21387,"_28235":195162,"_5797":195391},[],"Abre **Software Modules** y pulsa **New module**. Rellena **Module name** (no puede contener `/` ni `:`), **Type** (**Application** u **OS / base image**), **Version**, el **Distribution set** (deja **Catalog only — no set** para enlazarlo más tarde) y el **Delivery intent**:",{"_6892":120909,"_42174":120818,"_29767":195393,"_5":21387,"_28235":195162,"_5797":87102},[],{"_6892":120910,"_42174":120818,"_29767":195395,"_5":21387,"_28235":195162,"_5797":195396},[],"Significa",{"_6892":120911,"_42174":120818,"_29767":195398,"_5":21387,"_28235":195162,"_5797":87108},[],{"_6892":120912,"_42174":120818,"_29767":195400,"_5":21387,"_28235":195162,"_5797":195401},[],"Aportas ficheros y un sw-description, y el servicio construye un `.swu`",{"_6892":120913,"_42174":120818,"_29767":195403,"_5":21387,"_28235":195162,"_5797":87114},[],{"_6892":120914,"_42174":120818,"_29767":195405,"_5":21387,"_28235":195162,"_5797":195406},[],"Subes un `.swu` terminado",{"_6892":120915,"_42174":120818,"_29767":195408,"_5":21387,"_28235":195162,"_5797":87120},[],{"_6892":120916,"_42174":120818,"_29767":195410,"_5":21387,"_28235":195162,"_5797":195411},[],"Los ficheros se entregan tal cual, y el módulo cuenta como construido tras un paso de construcción que puede cifrarlos y firmarlos de forma opcional",{"_6892":120917,"_42174":120818,"_29767":195413,"_5":21387,"_28235":195162,"_5797":87126},[],{"_6892":120918,"_42174":120818,"_29767":195415,"_5":21387,"_28235":195162,"_5797":195416},[],"Aún no se puede usar",{"_6892":120919,"_42174":120818,"_29767":195418,"_5":21387,"_28235":195162,"_5797":195419},[],"Añade los ficheros y, para **Build SWU from inputs**, el sw-description. Las tarjetas de seguridad ofrecen firma y cifrado compartido. Para **Build SWU from inputs**, el interruptor **Build this module now** está activado por defecto: desactívalo para guardar solo los ficheros y construir más tarde desde el menú de fila **Files and build**. Para **Upload prebuilt SWU** no hay interruptor: el módulo queda construido en cuanto se guarda el `.swu`. Para **Deliver files unchanged** el interruptor es **Build now**.",{"_6892":120920,"_42174":120818,"_29767":195421,"_5":21387,"_28235":195162,"_5797":195422},[],"Pulsa **Create Module**.",{"_6892":120921,"_42174":120818,"_29767":195424,"_5":21387,"_28235":195162,"_5797":195425},[],"Crea el distribution set y marca el módulo construido.",{"_6892":120922,"_42174":120818,"_29767":195427,"_5":21387,"_28235":195162,"_5797":195428},[],"Un módulo enlazado a un conjunto queda congelado. Desenlázalo para cambiarlo, o añade una versión nueva desde **Upgrade to a new version** en el menú de su fila del catálogo. Consulta Modo hawkBit.",{"_6892":120923,"_42174":120818,"_29767":195430,"_5":21387,"_28235":195162,"_5797":195431},[],"El catálogo también funciona en el backend nativo: lista los módulos de todos los paquetes, y **New module** puede dejar un módulo en **Catalog only — no set** hasta que lo añadas a un paquete con **Import module**. La importación nativa copia el módulo, mientras que el enlace de hawkBit lo comparte.",{"_6892":120924,"_42174":120818,"_29767":195433,"_5":21387,"_28235":195166,"_5797":195434},[],"Pulsa **Start Campaign** en el menú de fila del paquete en **Distribution Set** (habilitado una vez construido el paquete), o **New Campaign** en la página **Campaigns**. El formulario, **Create campaign**, está en `/updates/new`.",{"_6892":120925,"_42174":120818,"_29767":195436,"_5":21387,"_28235":195166,"_5797":195437},[],"Sección",{"_6892":120926,"_42174":120818,"_29767":195439,"_5":21387,"_28235":195166,"_5797":195440},[],"Campos",{"_6892":120927,"_42174":120818,"_29767":195442,"_5":21387,"_28235":195166,"_5797":87155},[],{"_6892":120928,"_42174":120818,"_29767":195444,"_5":21387,"_28235":195166,"_5797":195445},[],"**Campaign name (optional)**, **Distribution set**. **Device group** y **Driver** se heredan y son de solo lectura. **Workflow**: en nativo, todos los workflows de WFX registrados (Direct, Phased, Download-Install...), con un aviso cuando no encaja con el driver. En hawkBit el campo es **Install mode**: **Forced** (el dispositivo instala en cuanto consulta) o **Soft** (el dispositivo puede confirmar o posponer)",{"_6892":120929,"_42174":120818,"_29767":195447,"_5":21387,"_28235":195166,"_5797":87161},[],{"_6892":120930,"_42174":120818,"_29767":195449,"_5":21387,"_28235":195166,"_5797":195450},[],"**Start as soon as it is executed** o **Start at a planned time** (fecha y hora, en la zona horaria de tu navegador)",{"_6892":120931,"_42174":120818,"_29767":195452,"_5":21387,"_28235":195166,"_5797":87167},[],{"_6892":120932,"_42174":120818,"_29767":195454,"_5":21387,"_28235":195166,"_5797":195455},[],"**Batch mode** (**Fixed count** o **Percentage**), el tamaño o porcentaje del lote y el interruptor **Auto rollout**",{"_6892":120933,"_42174":120818,"_29767":195457,"_5":21387,"_28235":195166,"_5797":87173},[],{"_6892":120934,"_42174":120818,"_29767":195459,"_5":21387,"_28235":195166,"_5797":195460},[],"Solo con Auto rollout activado: **Approval threshold** (%) y **Error threshold** (%)",{"_6892":120935,"_42174":120818,"_29767":195462,"_5":21387,"_28235":195166,"_5797":87179},[],{"_6892":120936,"_42174":120818,"_29767":195464,"_5":21387,"_28235":195166,"_5797":195465},[],"**Test device** (el canario, que se actualiza primero), las **Preconditions** del conjunto (solo lectura), **Notes**, **Weight**",{"_6892":120937,"_42174":120818,"_29767":195467,"_5":21387,"_28235":195166,"_5797":195468},[],"No hay selector de dispositivos. Una campaña apunta a todos los dispositivos del grupo del paquete, y el panel **Campaign summary** muestra cuántos coinciden y el número estimado de lotes.",{"_6892":120938,"_42174":120818,"_29767":195470,"_5":21387,"_28235":195166,"_5797":195471},[],"Si el paquete tiene precondiciones, el dashboard ejecuta primero una simulación (dry run) y muestra **Campaign preconditions**: cuántos dispositivos cumplen, cuáles no y por qué. Marca &#x2A;*Force deploy to non-qualifying devices (not recommended)** para enviar también a los que no cumplen y después **Confirm campaign**.",{"_6892":120939,"_42174":120818,"_29767":195473,"_5":21387,"_28235":195166,"_5797":195474},[],"Pulsa **Create campaign**. La campaña se crea pero todavía no se envía nada: vuelves a **Campaigns**.",{"_6892":120940,"_42174":120818,"_29767":195476,"_5":21387,"_28235":195170,"_5797":195477},[],"En **Campaigns** (`/updates`), cada fila tiene el progreso, el estado (como **Scheduled**, **Rolling Out**, **Paused**, **Completed**, **Cancelled**) y el progreso por lotes. Las tarjetas de la parte superior (**Active campaigns**, **Scheduled**, **Rolling out**, **Requires attention**, **Completed**) filtran la lista. La página se actualiza cada cuatro segundos mientras algo se mueve.",{"_6892":120941,"_42174":120818,"_29767":195479,"_5":21387,"_28235":195170,"_5797":195480},[],"El botón principal de la fila libera un lote:",{"_6892":120942,"_42174":120818,"_29767":195482,"_5":21387,"_28235":195170,"_5797":195483},[],"**Send to test device** envía primero el canario.",{"_6892":120943,"_42174":120818,"_29767":195485,"_5":21387,"_28235":195170,"_5797":195486},[],"**Execute next batch** envía el siguiente lote.",{"_6892":120944,"_42174":120818,"_29767":195488,"_5":21387,"_28235":195170,"_5797":195489},[],"Se oculta cuando la campaña está completada o cancelada, en pausa, programada para más tarde, sin nada pendiente, o es una campaña con **Auto rollout** que ya está en marcha. Mientras se prueba el canario o ha fallado, sigue visible pero deshabilitado. Un canario fallido pausa una campaña nativa: usa **Resume** para reintentarlo. Una campaña programada empieza sola a la hora planificada.",{"_6892":120945,"_42174":120818,"_29767":195491,"_5":21387,"_28235":195170,"_5797":195492},[],"El menú de fila tiene **Open details**, **Resume**, **Pause**, **Retry N failed** y **Cancel campaign** (pregunta «Cancel Campaign?»). **Pause** detiene los lotes siguientes mientras los dispositivos que ya están en curso terminan; **Resume** continúa. No hay botón para marcar una campaña como completada: una campaña nativa se completa sola cuando no queda ningún dispositivo pendiente ni en curso.",{"_6892":120946,"_42174":120818,"_29767":195494,"_5":21387,"_28235":195170,"_5797":195495},[],"Debajo de la tabla, un panel muestra los **Batches** de la campaña seleccionada y una tabla **Device progress**. Sigue la primera fila activa hasta que seleccionas otra. Abre **View** para `/updates/details`:",{"_6892":120947,"_42174":120818,"_29767":195497,"_5":21387,"_28235":195170,"_5797":195498},[],"**Overview**: identidad, precondiciones y la **Rollout Configuration** (workflow o install mode, tipo y valor del rollout, modo automático, dispositivo de prueba). **Edit** sobre el valor del rollout funciona solo donde el backend admite editar una estrategia en ejecución.",{"_6892":120948,"_42174":120818,"_29767":195500,"_5":21387,"_28235":195170,"_5797":195501},[],"**Device Jobs**: una fila por dispositivo con el estado de su trabajo, un botón **Refresh Jobs** y, en cada fila, un botón **Workflow** que abre la línea de tiempo del dispositivo. Para el workflow Phased, un botón **Next** y una tira de transiciones te permiten confirmar pasos, que es como avanza una campaña `phased`.",{"_6892":120949,"_42174":120818,"_29767":195503,"_5":21387,"_28235":195170,"_5797":195504},[],"La cabecera de la página repite el botón principal (**Execute Campaign**, o **Send to Test Device** antes del canario) y &#x2A;*Retry N failed device(s)**. No tiene pausar, reanudar ni cancelar: están en el menú de fila de la lista. En hawkBit, **Pause** está oculto hasta que la campaña ha empezado a despachar.",{"_6892":120950,"_42174":120818,"_29767":195506,"_5":21387,"_28235":195174,"_5797":195507},[],"Abre **Devices** (en **IoT**) y elige un dispositivo. La página tiene más pestañas que las relacionadas con actualizaciones que se listan aquí:",{"_6892":120951,"_42174":120818,"_29767":195509,"_5":21387,"_28235":195174,"_5797":195510},[],"Pestaña",{"_6892":120952,"_42174":120818,"_29767":195512,"_5":21387,"_28235":195174,"_5797":195513},[],"Muestra",{"_6892":120953,"_42174":120818,"_29767":195515,"_5":21387,"_28235":195174,"_5797":87233},[],{"_6892":120954,"_42174":120818,"_29767":195517,"_5":21387,"_28235":195174,"_5797":195518},[],"Los distribution sets que lleva, y **Up to date** u **Outdated** respecto al objetivo declarado",{"_6892":120955,"_42174":120818,"_29767":195520,"_5":21387,"_28235":195174,"_5797":87239},[],{"_6892":120956,"_42174":120818,"_29767":195522,"_5":21387,"_28235":195174,"_5797":195523},[],"Nativo: el workflow de eventos de WFX. hawkBit: la actualización en curso con los pasos Assigned, Installing e Installed",{"_6892":120957,"_42174":120818,"_29767":195525,"_5":21387,"_28235":195174,"_5797":87245},[],{"_6892":120958,"_42174":120818,"_29767":195527,"_5":21387,"_28235":195174,"_5797":195528},[],"**Installed Distribution Sets** con sus artefactos, y el **Pack Update History**",{"_6892":120959,"_42174":120818,"_29767":195530,"_5":21387,"_28235":195174,"_5797":87251},[],{"_6892":120960,"_42174":120818,"_29767":195532,"_5":21387,"_28235":195174,"_5797":195533},[],"Los trabajos de WFX del dispositivo",{"_6892":120961,"_42174":120818,"_29767":195535,"_5":21387,"_28235":195174,"_5797":195536},[],"Usa &#x2A;*Launch Update...** en el menú de acciones del dispositivo para enviar una versión a un dispositivo. El diálogo **Launch update for device** pide el grupo de dispositivos (cuando el dispositivo está en varios), el distribution set, la versión y el workflow (o el install mode), y crea un trabajo. El menú de acciones del propio paquete tiene **Targeted Update**, que hace lo mismo con los dispositivos que marques en una lista, siempre con el workflow `direct`, y se habilita cuando el paquete está construido. En **OTA Devices**, selecciona dispositivos de un mismo grupo y pulsa **Update** para hacerlo con muchos dispositivos; el botón está deshabilitado cuando la selección abarca varios grupos.",{"_6892":120962,"_42174":120818,"_29767":195538,"_5":21387,"_28235":195174,"_5797":195539},[],"**OTA Dashboard**, **OTA Devices** y **OTA Device Groups** muestran el cumplimiento de versiones: qué dispositivos están al día, por detrás de un objetivo declarado o sin objetivo. La página de un grupo también lista la versión que ejecuta cada dispositivo frente a la versión publicada del grupo, con un botón **Update to vX** para los desactualizados. Sin soporte de cumplimiento de versiones en el backend, siguen listando dispositivos y campañas, pero las versiones objetivo aparecen como **No target** o con un guion largo, con la alerta «Target versions unavailable on this backend».",{"_6892":120963,"_42174":120818,"_29767":195541,"_5":21387,"_28235":195178,"_5797":195542},[],"Pantalla",{"_6892":120964,"_42174":120818,"_29767":195544,"_5":21387,"_28235":195178,"_5797":193691},[],{"_6892":120965,"_42174":120818,"_29767":195546,"_5":21387,"_28235":195178,"_5797":85304},[],{"_6892":120966,"_42174":120818,"_29767":195548,"_5":21387,"_28235":195178,"_5797":195549},[],"Lista de paquetes",{"_6892":120967,"_42174":120818,"_29767":195551,"_5":21387,"_28235":195178,"_5797":195552},[],"Estado, empaquetado y tarjetas **Built / Not built / Build failed**",{"_6892":120968,"_42174":120818,"_29767":195554,"_5":21387,"_28235":195178,"_5797":195555},[],"Esas tarjetas, el filtro y la columna de estado se ocultan. Un conjunto no tiene estado de construcción propio: está listo cuando todos sus módulos están construidos, y **Start Campaign** sigue deshabilitado hasta entonces",{"_6892":120969,"_42174":120818,"_29767":195557,"_5":21387,"_28235":195178,"_5797":195558},[],"Paquete nuevo",{"_6892":120970,"_42174":120818,"_29767":195560,"_5":21387,"_28235":195178,"_5797":195561},[],"Sin sección de módulos",{"_6892":120971,"_42174":120818,"_29767":195563,"_5":21387,"_28235":195178,"_5797":195564},[],"Sección **Software modules** obligatoria",{"_6892":120972,"_42174":120818,"_29767":195566,"_5":21387,"_28235":195178,"_5797":195567},[],"Cabecera de la página del paquete",{"_6892":120973,"_42174":120818,"_29767":195569,"_5":21387,"_28235":195178,"_5797":195570},[],"**Generate SWU** y **Download SWU** (o **Generate Package** y **Download Package**)",{"_6892":120974,"_42174":120818,"_29767":195572,"_5":21387,"_28235":195178,"_5797":195573},[],"Un botón **Software modules** en su lugar: se construye en el catálogo",{"_6892":120975,"_42174":120818,"_29767":195575,"_5":21387,"_28235":195178,"_5797":195576},[],"Pestañas de la página del paquete",{"_6892":120976,"_42174":120818,"_29767":195578,"_5":21387,"_28235":195178,"_5797":195579},[],"**Overview**, **Software Modules**, **Contents**, **Manifest**, **Version History** (la composición está admitida, así que no hay pestaña **Artifacts** a nivel de paquete)",{"_6892":120977,"_42174":120818,"_29767":195581,"_5":21387,"_28235":195178,"_5797":195582},[],"Las mismas. La pestaña **Artifacts** aparece en su lugar solo si el servidor hawkBit no tiene los tipos de módulo",{"_6892":120978,"_42174":120818,"_29767":195584,"_5":21387,"_28235":195178,"_5797":195585},[],"Seguridad",{"_6892":120979,"_42174":120818,"_29767":195587,"_5":21387,"_28235":195178,"_5797":195588},[],"En la hoja **Generate SWU**",{"_6892":120980,"_42174":120818,"_29767":195590,"_5":21387,"_28235":195178,"_5797":195591},[],"Por módulo",{"_6892":120981,"_42174":120818,"_29767":195593,"_5":21387,"_28235":195178,"_5797":195594},[],"Formulario de campaña",{"_6892":120982,"_42174":120818,"_29767":195596,"_5":21387,"_28235":195178,"_5797":195597},[],"**Workflow**: Direct, Phased o cualquier workflow de WFX registrado",{"_6892":120983,"_42174":120818,"_29767":195599,"_5":21387,"_28235":195178,"_5797":195600},[],"**Install mode**: **Forced** o **Soft**",{"_6892":120984,"_42174":120818,"_29767":195602,"_5":21387,"_28235":195178,"_5797":195603},[],"Umbral de error",{"_6892":120985,"_42174":120818,"_29767":195605,"_5":21387,"_28235":195178,"_5797":195606},[],"La campaña se cancela cuando este % de todos sus dispositivos ha fallado",{"_6892":120986,"_42174":120818,"_29767":195608,"_5":21387,"_28235":195178,"_5797":195609},[],"La campaña se detiene cuando falla más de este % de un lote",{"_6892":120987,"_42174":120818,"_29767":195611,"_5":21387,"_28235":195178,"_5797":195612},[],"Pestaña **Update Status**",{"_6892":120988,"_42174":120818,"_29767":195614,"_5":21387,"_28235":195178,"_5797":195615},[],"Workflow de eventos de WFX",{"_6892":120989,"_42174":120818,"_29767":195617,"_5":21387,"_28235":195178,"_5797":195618},[],"Pasos de la acción de hawkBit",{"_6892":120990,"_42174":120818,"_29767":195620,"_5":21387,"_28235":195178,"_5797":195621},[],"Editar un rollout en ejecución",{"_6892":120991,"_42174":120818,"_29767":195623,"_5":21387,"_28235":195178,"_5797":195624},[],"Admitido",{"_6892":120992,"_42174":120818,"_29767":195626,"_5":21387,"_28235":195178,"_5797":195627},[],"No admitido",{"_6892":120993,"_42174":120818,"_29767":195629,"_5":21387,"_28235":195178,"_5797":195630},[],"Catálogo de módulos",{"_6892":120994,"_42174":120818,"_29767":195632,"_5":21387,"_28235":195178,"_5797":195633},[],"Los módulos se crean sin conjunto o se añaden a un paquete, y la importación los copia",{"_6892":120995,"_42174":120818,"_29767":195635,"_5":21387,"_28235":195178,"_5797":195636},[],"Los módulos se construyen en el catálogo y un paquete los enlaza",{"_6892":120996,"_42174":120818,"_29767":195638,"_5":21387,"_28235":195178,"_5797":195639},[],"La pestaña **Manifest** (el manifiesto de versión firmado) aparece solo cuando el backend admite firmas de artefactos.",{"_6892":120997,"_42174":120818,"_29767":195641,"_5":21387,"_28235":195182,"_5797":195642},[],"Estas funciones de la API no tienen pantalla: marcar una campaña como completada (`/complete`), sincronizar de una vez todos los conjuntos de un dispositivo con las últimas versiones del grupo (`/sync-to-latest`) y declarar la última versión de un grupo. Usa la API para ellas. Para enviar un conjunto a un dispositivo, lo hacen &#x2A;*Launch Update...** y el botón **Update to vX** por dispositivo en la página de un grupo.",{"_6892":120998,"_42174":120818,"_29767":195644,"_5":21387,"_28235":195186,"_5797":192457},[],{"_6892":120999,"_42174":120818,"_29767":195646,"_5":21387,"_28235":195186,"_5797":194863},[],{"_6892":121000,"_42174":120818,"_29767":195648,"_5":21387,"_28235":195186,"_5797":195649},[],"Faltan pantallas o botones que deberían existir",{"_6892":121001,"_42174":120818,"_29767":195651,"_5":21387,"_28235":195186,"_5797":195652},[],"La petición de capacidades tuvo éxito y el backend no los admite. Revisa **Updates backend** en el menú de usuario (compilaciones de desarrollo) o `GET /updates/v1/capabilities`",{"_6892":121002,"_42174":120818,"_29767":195654,"_5":21387,"_28235":195186,"_5797":195655},[],"Las pantallas de actualizaciones no cargan o muestran errores",{"_6892":121003,"_42174":120818,"_29767":195657,"_5":21387,"_28235":195186,"_5797":195658},[],"`LAMASSU_UPDATES_API` apunta al servicio o puerto equivocado, o tu pasarela no enruta `/updates/v1`",{"_6892":121004,"_42174":120818,"_29767":195660,"_5":21387,"_28235":195186,"_5797":195661},[],"**Start Campaign** está deshabilitado",{"_6892":121005,"_42174":120818,"_29767":195663,"_5":21387,"_28235":195186,"_5797":195664},[],"El paquete no está construido (nativo), o no todos los módulos están construidos (hawkBit)",{"_6892":121006,"_42174":120818,"_29767":195666,"_5":21387,"_28235":195186,"_5797":195667},[],"Al crear un paquete no se ofrece ningún grupo de dispositivos",{"_6892":121007,"_42174":120818,"_29767":195669,"_5":21387,"_28235":195186,"_5797":195670},[],"Aún no existe ningún grupo de dispositivos. Crea uno en **Device Groups**",{"_6892":121008,"_42174":120818,"_29767":195672,"_5":21387,"_28235":195186,"_5797":195673},[],"Una campaña parece atascada en **Rolling Out** cuando los dispositivos ya terminaron",{"_6892":121009,"_42174":120818,"_29767":195675,"_5":21387,"_28235":195186,"_5797":195676},[],"El workflow no encaja con el driver del paquete. Los paquetes SWU necesitan **Direct** o **Phased**; los Generic necesitan **Download-Install**",{"_6892":121010,"_42174":120818,"_29767":195678,"_5":21387,"_28235":195189,"_5797":195679},[],"<Card title=\"Publica y lanza una actualización\" href=\"/docs/platform/updates/guides/publish-and-roll-out\" description=\"El mismo flujo como peticiones a la API.\" />",{"_6892":121011,"_42174":120818,"_29767":195681,"_5":21387,"_28235":195189,"_5797":195682},[],"<Card title=\"Conceptos\" href=\"/docs/platform/updates/concepts\" description=\"Paquetes, módulos, campañas y workflows.\" />",{"_6892":121012,"_42174":120818,"_29767":195684,"_5":21387,"_28235":195189,"_5797":195685},[],"<Card title=\"Capacidades\" href=\"/docs/platform/updates/reference/capabilities\" description=\"Qué admite cada backend y qué oculta la interfaz.\" />",{"_6892":121013,"_42174":121013,"_5":21817,"_5797":195687,"_42654":195688,"_29767":195689,"_28235":121013},"Flujo de actualización con curl, backend hawkBit",[77248,187247,193621,194906],[],{"_6892":121014,"_42174":121013,"_29767":195691,"_5":21387,"_28235":121013,"_5797":195692},[],"Todas las peticiones de una actualización completa en modo hawkBit, incluido el lado del dispositivo por DDI, con respuestas reales.",{"_6892":121015,"_42174":121013,"_5":42651,"_29767":195694,"_28235":195695,"_5797":185844},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/hawkbit-curl#antes-de-empezar",{"_6892":121016,"_42174":121013,"_5":42651,"_29767":195697,"_28235":195698,"_5797":195699},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/hawkbit-curl#1-comprueba-el-backend","1\\. Comprueba el backend",{"_6892":121017,"_42174":121013,"_5":42651,"_29767":195701,"_28235":195702,"_5797":195703},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/hawkbit-curl#2-crea-un-módulo-en-el-catálogo","2\\. Crea un módulo en el catálogo",{"_6892":121018,"_42174":121013,"_5":42651,"_29767":195705,"_28235":195706,"_5797":195707},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/hawkbit-curl#3-sube-el-archivo-y-el-sw-description","3\\. Sube el archivo y el sw-description",{"_6892":121019,"_42174":121013,"_5":42651,"_29767":195709,"_28235":195710,"_5797":195711},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/hawkbit-curl#4-compila-el-módulo","4\\. Compila el módulo",{"_6892":121020,"_42174":121013,"_5":42651,"_29767":195713,"_28235":195714,"_5797":195715},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/hawkbit-curl#5-crea-el-pack-a-partir-del-módulo-compilado","5\\. Crea el pack a partir del módulo compilado",{"_6892":121021,"_42174":121013,"_5":42651,"_29767":195717,"_28235":195718,"_5797":195719},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/hawkbit-curl#6-simula-el-lanzamiento-y-créalo","6\\. Simula el lanzamiento y créalo",{"_6892":121022,"_42174":121013,"_5":42651,"_29767":195721,"_28235":195722,"_5797":195723},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/hawkbit-curl#7-inicia-el-rollout","7\\. Inicia el rollout",{"_6892":121023,"_42174":121013,"_5":42651,"_29767":195725,"_28235":195726,"_5797":195727},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/hawkbit-curl#8-haz-de-dispositivo-ddi","8\\. Haz de dispositivo (DDI)",{"_6892":121024,"_42174":121013,"_5":42651,"_29767":195729,"_28235":195730,"_5797":195731},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/hawkbit-curl#9-libera-los-siguientes-lotes","9\\. Libera los siguientes lotes",{"_6892":121025,"_42174":121013,"_5":42651,"_29767":195733,"_28235":195734,"_5797":195735},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/hawkbit-curl#10-comprueba-el-resultado","10\\. Comprueba el resultado",{"_6892":121026,"_42174":121013,"_5":42651,"_29767":195737,"_28235":195738,"_5797":195739},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/hawkbit-curl#lo-que-se-comporta-de-forma-distinta","Lo que se comporta de forma distinta",{"_6892":121027,"_42174":121013,"_5":42651,"_29767":195741,"_28235":195742,"_5797":189766},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/hawkbit-curl#solución-de-problemas",{"_6892":121028,"_42174":121013,"_5":42651,"_29767":195744,"_28235":195745,"_5797":188883},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/hawkbit-curl#siguientes-pasos",{"_6892":121029,"_42174":121013,"_29767":195747,"_5":21387,"_28235":121013,"_5797":195748},[],"La misma actualización que en la guía native, contra el servicio en modo hawkBit. Las peticiones de gestión van a Lamassu Updates. El lado del dispositivo es otro protocolo: los dispositivos consultan la API DDI de hawkBit, no este servicio ni WFX. Los comandos se ejecutaron contra un hawkBit 1.1.0 real, y las respuestas son reales, recortadas cuando son largas. Los ejemplos que indican que no se ejecutaron solo se comprobaron contra el código.",{"_6892":121030,"_42174":121013,"_29767":195750,"_5":21387,"_28235":121013,"_5797":195751},[],"Las diferencias respecto al modo native, en resumen:",{"_6892":121031,"_42174":121013,"_29767":195753,"_5":21387,"_28235":121013,"_5797":85301},[],{"_6892":121032,"_42174":121013,"_29767":195755,"_5":21387,"_28235":121013,"_5797":85304},[],{"_6892":121033,"_42174":121013,"_29767":195757,"_5":21387,"_28235":121013,"_5797":195758},[],"Compilación",{"_6892":121034,"_42174":121013,"_29767":195760,"_5":21387,"_28235":121013,"_5797":195761},[],"Sube artefactos y un sw-description al pack y luego compila el pack",{"_6892":121035,"_42174":121013,"_29767":195763,"_5":21387,"_28235":121013,"_5797":195764},[],"Compila primero un **módulo** en el catálogo y luego crea el pack a partir de él",{"_6892":121036,"_42174":121013,"_29767":195766,"_5":21387,"_28235":121013,"_5797":195767},[],"Pack tras crearlo",{"_6892":121037,"_42174":121013,"_29767":195769,"_5":21387,"_28235":121013,"_5797":85673},[],{"_6892":121038,"_42174":121013,"_29767":195771,"_5":21387,"_28235":121013,"_5797":195772},[],"Ya está `built`",{"_6892":121039,"_42174":121013,"_29767":195774,"_5":21387,"_28235":121013,"_5797":195775},[],"Quién avisa al dispositivo",{"_6892":121040,"_42174":121013,"_29767":195777,"_5":21387,"_28235":121013,"_5797":195778},[],"Un job de WFX",{"_6892":121041,"_42174":121013,"_29767":195780,"_5":21387,"_28235":121013,"_5797":195781},[],"Una acción de hawkBit, leída por DDI",{"_6892":121042,"_42174":121013,"_29767":195783,"_5":21387,"_28235":121013,"_5797":195784},[],"El dispositivo informa a",{"_6892":121043,"_42174":121013,"_29767":195786,"_5":21387,"_28235":121013,"_5797":85441},[],{"_6892":121044,"_42174":121013,"_29767":195788,"_5":21387,"_28235":121013,"_5797":195789},[],"hawkBit (feedback DDI)",{"_6892":121045,"_42174":121013,"_29767":195791,"_5":21387,"_28235":121013,"_5797":195792},[],"Siguiente lote, con `auto` activado",{"_6892":121046,"_42174":121013,"_29767":195794,"_5":21387,"_28235":121013,"_5797":195795},[],"El servicio, a partir de eventos de WFX",{"_6892":121047,"_42174":121013,"_29767":195797,"_5":21387,"_28235":121013,"_5797":195798},[],"hawkBit, a partir de sus grupos de rollout",{"_6892":121048,"_42174":121013,"_29767":195800,"_5":21387,"_28235":195695,"_5797":195801},[],"El stack está en marcha en modo hawkBit: este servicio, su Postgres, hawkBit y el device manager de Lamassu.",{"_6892":121049,"_42174":121013,"_29767":195803,"_5":21387,"_28235":195695,"_5797":195804},[],"Un grupo de dispositivos en Lamassu con dispositivos dentro. Esta guía usa `fleet-a` con `dev-001` a `dev-004`.",{"_6892":121050,"_42174":121013,"_29767":195806,"_5":21387,"_28235":195695,"_5797":195807},[],"`curl` y `jq`.",{"_6892":121051,"_42174":121013,"_29767":195809,"_5":21387,"_28235":195695,"_5797":195810},[],"Un compilador de SWU configurado (`swugenerator_path`), para compilar un módulo `swu-build`. Sin él, `POST .../build` sobre un módulo así responde `501`.",{"_6892":121052,"_42174":121013,"_29767":195812,"_5":21387,"_28235":195695,"_5797":195813},[],"`config-hawkbit.yml` del repositorio sirve la API en el puerto `10090`, igual que el stack native, así que ejecuta un solo backend a la vez en ese puerto. `config-hawkbit-demo.yml` la sirve en el `10091`, al que apunta el entorno de desarrollo del dashboard del repositorio para el backend hawkBit. Ajusta `API` a donde escuche tu instancia. A través de un gateway de Lamassu la API suele ser `https://lamassu.example.com/api/updates/v1` y cada llamada necesita la credencial de tu gateway, por ejemplo `-H \"Authorization: Bearer $TOKEN\"`.",{"_6892":121053,"_42174":121013,"_29767":195815,"_5":21387,"_28235":195698,"_5797":195816},[],"`artifact_encryption`, `software_module_composition`, `standalone_software_modules` y `software_module_replace` también aparecen en esa lista si faltan los ajustes de compilación o los tipos de módulo de hawkBit. Consulta Capabilities.",{"_6892":121054,"_42174":121013,"_29767":195818,"_5":21387,"_28235":195702,"_5797":195819},[],"Un conjunto de distribución de hawkBit solo puede enlazar módulos **compilados**, así que el módulo va primero. `delivery_intent` indica cómo se entrega: `swu-build` compila un `.swu` a partir de tus archivos y un sw-description. Consulta Modo hawkBit para las demás intenciones (`swu-prebuilt`, `raw`).",{"_6892":121055,"_42174":121013,"_29767":195821,"_5":21387,"_28235":195702,"_5797":195822},[],"`type` es `os` o `application`, y `type`, `name` y `version` son obligatorios. Sin `delivery_intent` el módulo queda `undecided`: acepta archivos, pero no se puede compilar ni enlazar hasta que elijas una con `PUT /softwaremodules/by-id/$MID`.",{"_6892":121056,"_42174":121013,"_29767":195824,"_5":21387,"_28235":195706,"_5797":195825},[],"Usa el mismo `index.html` y `sw-description` que en la guía native.",{"_6892":121057,"_42174":121013,"_29767":195827,"_5":21387,"_28235":195706,"_5797":195828},[],"Un módulo `swu-build` rechaza un `.swu` terminado como entrada, y un módulo `swu-prebuilt` admite exactamente un `.swu`.",{"_6892":121058,"_42174":121013,"_29767":195830,"_5":21387,"_28235":195710,"_5797":195831},[],"La compilación sustituyó los archivos de entrada del módulo por el `.swu` terminado. El cuerpo de la compilación es opcional. Para cifrar o firmar, envía `user`, `encryption_key_name`, `encryption_alg_name`, `signature_key_id`, `signature_alg_name` y `signature_certificate`, como en la página de firma y cifrado. Un módulo se compila una sola vez: para cambiarlo, publica una nueva versión del módulo.",{"_6892":121059,"_42174":121013,"_29767":195833,"_5":21387,"_28235":195714,"_5797":195834},[],"El pack está compilado desde el principio. Su `uri` es una dirección de descarga de hawkBit que los dispositivos resuelven por sí mismos. En modo hawkBit `modules` solo admite entradas `source_module_id`, y cada módulo debe estar compilado y ser compatible con el empaquetado del pack. Varias entradas forman un pack con varios módulos, y entonces `GET .../swu/download` responde `400`: descarga el entregable de cada módulo con `GET .../modules/:moduleKey/artifact/download`.",{"_6892":121060,"_42174":121013,"_29767":195836,"_5":21387,"_28235":195718,"_5797":195837},[],"Los dispositivos de un grupo solo existen en hawkBit cuando el servicio los ha registrado. El servicio lo hace cada vez que lista los dispositivos del grupo, algo que hacen un lanzamiento, una simulación, un listado de jobs o una lectura de conformidad. La comprobación del canario se ejecuta **antes**, así que en el primer lanzamiento de un grupo que aún no se ha listado, un `test_device_id` falla:",{"_6892":121061,"_42174":121013,"_29767":195839,"_5":21387,"_28235":195718,"_5797":195840},[],"Ejecuta primero la simulación sin canario. Registra los dispositivos del grupo en hawkBit como targets y los etiqueta `group:fleet-a`:",{"_6892":121062,"_42174":121013,"_29767":195842,"_5":21387,"_28235":195718,"_5797":195843},[],"`never_seen_devices` lista los targets que aún no han contactado con hawkBit. Un grupo de rollout no puede terminar mientras sus dispositivos nunca consulten, así que revisa esta lista. `superseded_devices` lista los dispositivos que ya tienen una actualización en curso: crear el lanzamiento **cancela** esas acciones, porque hawkBit sustituye las acciones sin terminar de un target por la nueva. Ahora crea el lanzamiento con el canario:",{"_6892":121063,"_42174":121013,"_29767":195845,"_5":21387,"_28235":195718,"_5797":195846},[],"`workflow_type` no tiene aquí significado de WFX: `phased` crea una acción `soft` de hawkBit (el dispositivo decide cuándo instalar) y cualquier otro valor una `forced`. Define una función auxiliar para seguir el lanzamiento:",{"_6892":121064,"_42174":121013,"_29767":195848,"_5":21387,"_28235":195718,"_5797":195849},[],"Para iniciar el rollout más tarde, añade `scheduled_at` (RFC 3339) al cuerpo de creación. El planificador propio de hawkBit lo inicia entonces, y una llamada a `rollout` antes de esa hora respeta la programación. No se ejecutó aquí.",{"_6892":121065,"_42174":121013,"_29767":195851,"_5":21387,"_28235":195722,"_5797":195852},[],"El servicio inició un rollout de hawkBit: el canario en el primer grupo y el resto después.",{"_6892":121066,"_42174":121013,"_29767":195854,"_5":21387,"_28235":195726,"_5797":195855},[],"Un dispositivo real ejecuta `suricatta` de SWUpdate, que hace esto por sí mismo. Estas son las peticiones que realiza.",{"_6892":121067,"_42174":121013,"_29767":195857,"_5":21387,"_28235":195726,"_5797":195858},[],"Primero, los dispositivos deben autenticarse. Por defecto hawkBit los rechaza. Activa una sola vez los tokens de seguridad del tenant y lee el token del target:",{"_6892":121068,"_42174":121013,"_29767":195860,"_5":21387,"_28235":195726,"_5797":195861},[],"Esta es la configuración local. En un despliegue donde los dispositivos llegan a hawkBit a través del gateway de Lamassu, `hawkbit.ddi_url` es la ruta del gateway (por ejemplo `https://lamassu.example.com/api/hawkbit-ddi`) y los dispositivos se autentican como exija el gateway, normalmente con su certificado de cliente. Consulta Conectar un dispositivo.",{"_6892":121069,"_42174":121013,"_29767":195863,"_5":21387,"_28235":195726,"_5797":195864},[],"Consulta. Cuando hay trabajo, la respuesta enlaza a un `deploymentBase`:",{"_6892":121070,"_42174":121013,"_29767":195866,"_5":21387,"_28235":195726,"_5797":195867},[],"Lee el despliegue y descarga su artefacto:",{"_6892":121071,"_42174":121013,"_29767":195869,"_5":21387,"_28235":195726,"_5797":195870},[],"Cuando el servicio publica la URL de artefactos del dispositivo (la ruta de `ddi_url`), sirve él mismo esa misma ruta, solo para los módulos del conjunto asignado o instalado del dispositivo, y con la firma previa de S3 activada responde `302` a una URL firmada de corta duración. Un dispositivo no necesita notar la diferencia: sigue la redirección.",{"_6892":121072,"_42174":121013,"_29767":195872,"_5":21387,"_28235":195726,"_5797":195873},[],"Informa del progreso y del resultado. `closed` con `finished: success` es el final:",{"_6892":121073,"_42174":121013,"_29767":195875,"_5":21387,"_28235":195726,"_5797":195876},[],"El servicio lee hawkBit cuando se lo pides, así que el lanzamiento está al día:",{"_6892":121074,"_42174":121013,"_29767":195878,"_5":21387,"_28235":195726,"_5797":195879},[],"Para informar de un fallo, envía `\"finished\":\"failure\"` en el feedback `closed`.",{"_6892":121075,"_42174":121013,"_29767":195881,"_5":21387,"_28235":195730,"_5797":195882},[],"Con `auto` desactivado, hawkBit se detiene tras cada grupo. Cada llamada a `rollout` libera el siguiente:",{"_6892":121076,"_42174":121013,"_29767":195884,"_5":21387,"_28235":195730,"_5797":195885},[],"Aquí una acción de hawkBit se muestra como un estado de workflow: una acción programada es `CREATED`, una en curso `DOWNLOADING` (hawkBit no informa de pasos más finos), una terminada (o terminada con una advertencia) `ACTIVATED`, y una fallida, cancelada o en cancelación `TERMINATED`. Repite el paso 8 para `dev-002` y `dev-003` (el token sale de cada target) y vuelve a llamar a `rollout` para `dev-004`. Cuando todas las acciones han terminado:",{"_6892":121077,"_42174":121013,"_29767":195887,"_5":21387,"_28235":195730,"_5797":195888},[],"hawkBit decide cuándo termina un lote. Cuando informa el último dispositivo de un lote, hawkBit pausa el rollout, y durante un momento su grupo sigue figurando como `running`. El servicio no distingue esa pausa de una hecha por un operador, así que una llamada a `rollout` en esa ventana responde `400` con `rollout 1 is paused; resume it first`. Llama a `resume` y hawkBit libera por sí mismo el siguiente lote:",{"_6892":121078,"_42174":121013,"_29767":195890,"_5":21387,"_28235":195738,"_5797":195891},[],"**Rollout automático.** Con `auto: true`, hawkBit avanza los grupos por sí mismo cuando se cumple `approval_threshold`. El servicio no ejecuta un consumidor de eventos en este modo. Los umbrales se establecen en cada grupo de rollout, y hawkBit evalúa ambos porcentajes **por grupo**, no sobre todos los dispositivos como hace native. Un umbral sin definir o `0` pasa a 100, así que un `error_threshold` sin definir nunca se activa. El grupo del canario siempre necesita el 100 %. Se aplican también con `auto` desactivado.",{"_6892":121079,"_42174":121013,"_29767":195893,"_5":21387,"_28235":195738,"_5797":195894},[],"**Un umbral de error activado.** hawkBit pausa entonces el rollout, y el servicio informa el lanzamiento como `cancelled`. `resume` y `rollout` responden ambos `400`.",{"_6892":121080,"_42174":121013,"_29767":195896,"_5":21387,"_28235":195738,"_5797":195897},[],"**Pausar y reanudar.** `pause` y `resume` se corresponden con la pausa y la reanudación de rollouts de hawkBit, pero solo se puede reanudar una pausa hecha por un operador. hawkBit ya retiene el rollout entre grupos cuando `auto` está desactivado, así que `pause` responde entonces `400` («Rollout can only be paused in state running but current state is paused») y `resume` responde `400` («not paused; use Execute to release the next batch»). Usa `rollout` para liberar el siguiente grupo.",{"_6892":121081,"_42174":121013,"_29767":195899,"_5":21387,"_28235":195738,"_5797":195900},[],"**Lectura de la estrategia.** La estrategia que se muestra de un lanzamiento se deriva de los grupos del rollout de hawkBit, no se almacena. Un lanzamiento creado con un lote fijo de 2 para 4 dispositivos se lee como `percentage` 50.",{"_6892":121082,"_42174":121013,"_29767":195902,"_5":21387,"_28235":195738,"_5797":195903},[],"**Pertenencia estática.** Un rollout se construye con los dispositivos del grupo en el momento de crear el lanzamiento. Los dispositivos añadidos después al grupo no se incorporan (`launch_device_assignment` no está admitido).",{"_6892":121083,"_42174":121013,"_29767":195905,"_5":21387,"_28235":195738,"_5797":195906},[],"**No disponible.** Cifrado por dispositivo, workflows personalizados (`GET /workflows` devuelve una lista vacía), editar una estrategia en curso, marcar un lanzamiento como completado, eventos de job enviados por el servidor (el progreso se sondea), subida de un precompilado a nivel de conjunto y compilar un pack directamente. `POST .../swu` responde `501`:",{"_6892":121084,"_42174":121013,"_29767":195908,"_5":21387,"_28235":195742,"_5797":192457},[],{"_6892":121085,"_42174":121013,"_29767":195910,"_5":21387,"_28235":195742,"_5797":195911},[],"Causa y solución",{"_6892":121086,"_42174":121013,"_29767":195913,"_5":21387,"_28235":195742,"_5797":195914},[],"`501` al compilar un módulo: no hay compilador de SWU",{"_6892":121087,"_42174":121013,"_29767":195916,"_5":21387,"_28235":195742,"_5797":195917},[],"`swugenerator_path` no está configurado. Configúralo, o sube un `.swu` precompilado con la intención `swu-prebuilt`",{"_6892":121088,"_42174":121013,"_29767":195919,"_5":21387,"_28235":195742,"_5797":195920},[],"`501` al compilar un módulo: no hay SymKMS o no hay endpoint de KMS",{"_6892":121089,"_42174":121013,"_29767":195922,"_5":21387,"_28235":195742,"_5797":195923},[],"El cifrado necesita `symkms_endpoint` y la firma necesita `kms_endpoint`. Compila sin esos campos, o configúralos",{"_6892":121090,"_42174":121013,"_29767":195925,"_5":21387,"_28235":195742,"_5797":195926},[],"`400 ... is not built` al crear un pack",{"_6892":121091,"_42174":121013,"_29767":195928,"_5":21387,"_28235":195742,"_5797":195929},[],"Un módulo enlazado a un pack debe estar compilado antes. Compílalo en el catálogo",{"_6892":121092,"_42174":121013,"_29767":195931,"_5":21387,"_28235":195742,"_5797":87653},[],{"_6892":121093,"_42174":121013,"_29767":195933,"_5":21387,"_28235":195742,"_5797":195934},[],"Un módulo `raw` no puede ir en un pack `swu`, y un módulo `swu-prebuilt` no puede ir en un pack `non-swu`",{"_6892":121094,"_42174":121013,"_29767":195936,"_5":21387,"_28235":195742,"_5797":195937},[],"`400 ... frozen` al cambiar un módulo",{"_6892":121095,"_42174":121013,"_29767":195939,"_5":21387,"_28235":195742,"_5797":195940},[],"Un módulo enlazado a un pack está congelado. Edítalo y compílalo en el catálogo y enlázalo de nuevo",{"_6892":121096,"_42174":121013,"_29767":195942,"_5":21387,"_28235":195742,"_5797":87665},[],{"_6892":121097,"_42174":121013,"_29767":195944,"_5":21387,"_28235":195742,"_5797":195945},[],"Un módulo se compila una sola vez. Publica una nueva versión del módulo",{"_6892":121098,"_42174":121013,"_29767":195947,"_5":21387,"_28235":195742,"_5797":87671},[],{"_6892":121099,"_42174":121013,"_29767":195949,"_5":21387,"_28235":195742,"_5797":195950},[],"Otra petición retiene el módulo. Reintenta cuando termine",{"_6892":121100,"_42174":121013,"_29767":195952,"_5":21387,"_28235":195742,"_5797":195953},[],"Crear un módulo responde `400` mencionando que hawkBit reserva el nombre y la versión",{"_6892":121101,"_42174":121013,"_29767":195955,"_5":21387,"_28235":195742,"_5797":195956},[],"hawkBit conserva el nombre y la versión de un módulo que se asignó a un dispositivo, incluso después de eliminarlo. Usa una versión nueva",{"_6892":121102,"_42174":121013,"_29767":195958,"_5":21387,"_28235":195742,"_5797":195959},[],"El canario falla con `device ... does not exist`",{"_6892":121103,"_42174":121013,"_29767":195961,"_5":21387,"_28235":195742,"_5797":195962},[],"Los dispositivos del grupo aún no están en hawkBit. Ejecuta antes una simulación sin `test_device_id`",{"_6892":121104,"_42174":121013,"_29767":195964,"_5":21387,"_28235":195742,"_5797":195965},[],"Un lanzamiento nunca avanza",{"_6892":121105,"_42174":121013,"_29767":195967,"_5":21387,"_28235":195742,"_5797":195968},[],"Revisa `never_seen_devices`: un dispositivo que nunca consulta bloquea su grupo de rollout",{"_6892":121106,"_42174":121013,"_29767":195970,"_5":21387,"_28235":195745,"_5797":195971},[],"Modo hawkBit, para módulos, intenciones de entrega y qué vive dónde",{"_6892":121107,"_42174":121013,"_29767":195973,"_5":21387,"_28235":195745,"_5797":195974},[],"Conectar un dispositivo, para la configuración del lado del dispositivo",{"_6892":121108,"_42174":121013,"_29767":195976,"_5":21387,"_28235":195745,"_5797":195977},[],"Referencia de la API",{"_6892":121109,"_42174":121013,"_29767":195979,"_5":21387,"_28235":195745,"_5797":189766},[],{"_6892":121110,"_42174":121110,"_5":21817,"_5797":195981,"_42654":195982,"_29767":195983,"_28235":121110},"Flujo de actualización con curl, backend native",[77248,187247,193621,194906],[],{"_6892":121111,"_42174":121110,"_29767":195985,"_5":21387,"_28235":121110,"_5797":195986},[],"Todas las peticiones de una actualización completa en modo native, desde crear un pack hasta el último dispositivo, con respuestas reales.",{"_6892":121112,"_42174":121110,"_5":42651,"_29767":195988,"_28235":195989,"_5797":185844},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#antes-de-empezar",{"_6892":121113,"_42174":121110,"_5":42651,"_29767":195991,"_28235":195992,"_5797":195699},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#1-comprueba-el-backend",{"_6892":121114,"_42174":121110,"_5":42651,"_29767":195994,"_28235":195995,"_5797":195996},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#2-crea-el-pack","2\\. Crea el pack",{"_6892":121115,"_42174":121110,"_5":42651,"_29767":195998,"_28235":195999,"_5797":196000},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#3-sube-el-sw-description-y-el-artefacto","3\\. Sube el sw-description y el artefacto",{"_6892":121116,"_42174":121110,"_5":42651,"_29767":196002,"_28235":196003,"_5797":196004},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#4-compila-el-swu","4\\. Compila el `.swu`",{"_6892":121117,"_42174":121110,"_5":42651,"_29767":196006,"_28235":196007,"_5797":196008},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#5-simula-y-crea-el-lanzamiento","5\\. Simula y crea el lanzamiento",{"_6892":121118,"_42174":121110,"_5":42651,"_29767":196010,"_28235":196011,"_5797":196012},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#6-despliega-el-canario","6\\. Despliega el canario",{"_6892":121119,"_42174":121110,"_5":42651,"_29767":196014,"_28235":196015,"_5797":196016},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#7-haz-de-dispositivo","7\\. Haz de dispositivo",{"_6892":121120,"_42174":121110,"_5":42651,"_29767":196018,"_28235":196019,"_5797":196020},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#8-despliega-el-resto","8\\. Despliega el resto",{"_6892":121121,"_42174":121110,"_5":42651,"_29767":196022,"_28235":196023,"_5797":196024},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#9-comprueba-el-resultado","9\\. Comprueba el resultado",{"_6892":121122,"_42174":121110,"_5":42651,"_29767":196026,"_28235":196027,"_5797":196028},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#variaciones","Variaciones",{"_6892":121123,"_42174":121110,"_5":42651,"_29767":196030,"_28235":196031,"_5797":196032},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#deja-que-el-servicio-libere-los-lotes","Deja que el servicio libere los lotes",{"_6892":121124,"_42174":121110,"_5":42651,"_29767":196034,"_28235":196035,"_5797":196036},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#pausar-reanudar-reintentar-y-cancelar","Pausar, reanudar, reintentar y cancelar",{"_6892":121125,"_42174":121110,"_5":42651,"_29767":196038,"_28235":196039,"_5797":196040},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#programar-un-lanzamiento","Programar un lanzamiento",{"_6892":121126,"_42174":121110,"_5":42651,"_29767":196042,"_28235":196043,"_5797":196044},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#exigir-una-versión-antes-de-actualizar","Exigir una versión antes de actualizar",{"_6892":121127,"_42174":121110,"_5":42651,"_29767":196046,"_28235":196047,"_5797":196048},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#actualizar-un-dispositivo-a-una-versión","Actualizar un dispositivo a una versión",{"_6892":121128,"_42174":121110,"_5":42651,"_29767":196050,"_28235":196051,"_5797":196052},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#una-nueva-versión","Una nueva versión",{"_6892":121129,"_42174":121110,"_5":42651,"_29767":196054,"_28235":196055,"_5797":196056},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#cifrar-con-una-clave-compartida","Cifrar con una clave compartida",{"_6892":121130,"_42174":121110,"_5":42651,"_29767":196058,"_28235":196059,"_5797":196060},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#cifrar-por-dispositivo","Cifrar por dispositivo",{"_6892":121131,"_42174":121110,"_5":42651,"_29767":196062,"_28235":196063,"_5797":196064},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#firmar-el-paquete","Firmar el paquete",{"_6892":121132,"_42174":121110,"_5":42651,"_29767":196066,"_28235":196067,"_5797":189766},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#solución-de-problemas",{"_6892":121133,"_42174":121110,"_5":42651,"_29767":196069,"_28235":196070,"_5797":188883},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/native-curl#siguientes-pasos",{"_6892":121134,"_42174":121110,"_29767":196072,"_5":21387,"_28235":121110,"_5797":196073},[],"Una actualización completa, petición a petición: crear un pack, compilarlo, enviarlo a un grupo por lotes, hacer de dispositivo y seguir el progreso. Todos los comandos se ejecutaron contra un stack en modo native, y las respuestas son reales, recortadas cuando son largas, salvo donde una sección indica que no se ejecutó: esos ejemplos solo se comprobaron contra el código.",{"_6892":121135,"_42174":121110,"_29767":196075,"_5":21387,"_28235":121110,"_5797":196076},[],"Si usas el backend hawkBit, el flujo cambia, sobre todo en cómo se compila un pack y en cómo informan los dispositivos. Para las pantallas que hacen lo mismo, consulta la guía del dashboard.",{"_6892":121136,"_42174":121110,"_29767":196078,"_5":21387,"_28235":195989,"_5797":196079},[],"El stack está en marcha en modo native: el servicio, Postgres, WFX y el device manager de Lamassu.",{"_6892":121137,"_42174":121110,"_29767":196081,"_5":21387,"_28235":195989,"_5797":196082},[],"Existe un grupo de dispositivos en Lamassu con dispositivos dentro. Esta guía usa el grupo `fleet-a` con los dispositivos `dev-001` a `dev-004`.",{"_6892":121138,"_42174":121110,"_29767":196084,"_5":21387,"_28235":195989,"_5797":196085},[],"Tienes `curl` y `jq` instalados. `jq` solo se usa para extraer valores de las respuestas.",{"_6892":121139,"_42174":121110,"_29767":196087,"_5":21387,"_28235":195989,"_5797":196088},[],"Estas son las direcciones del stack de Docker Compose del repositorio. A través de un gateway de Lamassu la API suele ser `https://lamassu.example.com/api/updates/v1`, y entonces cada llamada necesita la credencial que exija tu gateway, por ejemplo `-H \"Authorization: Bearer $TOKEN\"`. El servicio en sí no autentica. Consulta Seguridad.",{"_6892":121140,"_42174":121110,"_29767":196090,"_5":21387,"_28235":195995,"_5797":196091},[],"El pack está en `draft`. Sigue siendo editable hasta que se compila. `name`, `version` (semver) y `group_id` son obligatorios; el nombre debe ser único en el grupo, o la petición responde `409`.",{"_6892":121141,"_42174":121110,"_29767":196093,"_5":21387,"_28235":195999,"_5797":196094},[],"El sw-description le dice a SWUpdate qué instalar. Este, mínimo, instala una página web. Consulta las reglas del sw-description en Publicar y desplegar una actualización.",{"_6892":121142,"_42174":121110,"_29767":196096,"_5":21387,"_28235":195999,"_5797":196097},[],"El nombre del artefacto es global: todos los packs comparten un único catálogo, y un nombre solo se puede reutilizar con una `version` **mayor**. Volver a subir `index.html` como `1.0.0` falla con `version 1.0.0 must be greater than the current latest version`. Un archivo llamado `.swu` o `.tar.gz` debe serlo realmente, o la subida responde `400`.",{"_6892":121143,"_42174":121110,"_29767":196099,"_5":21387,"_28235":196003,"_5797":196100},[],"`selected_artifact_ids` es lo que incorpora artefactos a la compilación. Sin él, la compilación falla.",{"_6892":121144,"_42174":121110,"_29767":196102,"_5":21387,"_28235":196003,"_5797":196103},[],"La `uri` empieza por el `update_domain` del servicio. En el stack de Compose es `http://updates:10090/updates/v1/` (`config-docker.yml`), un nombre que solo se resuelve dentro de la red de Compose, porque es la dirección que usan los dispositivos. Desde tu host, llama a la misma ruta en `localhost:10090`, como hace el siguiente comando.",{"_6892":121145,"_42174":121110,"_29767":196105,"_5":21387,"_28235":196003,"_5797":196106},[],"El pack ya está `built`: ya no se pueden añadir ni enlazar artefactos. Puedes descargar el paquete compartido (este no está cifrado):",{"_6892":121146,"_42174":121110,"_29767":196108,"_5":21387,"_28235":196003,"_5797":196109},[],"Las descargas admiten `Range` y `HEAD`, así que un cliente puede conocer antes el tamaño y reanudar una transferencia interrumpida, por ejemplo con `curl -C - -o water.swu $P/swu/download`. Con almacenamiento S3 y la firma previa activada, la misma petición puede responder `302` a una URL firmada de corta duración, que `curl -L` sigue.",{"_6892":121147,"_42174":121110,"_29767":196111,"_5":21387,"_28235":196003,"_5797":196112},[],"Si la compilación falla, el pack pasa a `build_failed` y `last_build_error` contiene el motivo. Sigue siendo editable: corrige la causa y compila de nuevo.",{"_6892":121148,"_42174":121110,"_29767":196114,"_5":21387,"_28235":196007,"_5797":196115},[],"Una simulación (dry run) muestra quién recibiría la actualización, sin crear nada:",{"_6892":121149,"_42174":121110,"_29767":196117,"_5":21387,"_28235":196007,"_5797":196118},[],"Créalo. `test_device_id` es el canario: va solo primero y debe tener éxito antes de tocar a ningún otro. `rollout_value` 2 significa lotes de dos dispositivos.",{"_6892":121150,"_42174":121110,"_29767":196120,"_5":21387,"_28235":196007,"_5797":196121},[],"Una pequeña función auxiliar facilita seguir el lanzamiento en los pasos siguientes:",{"_6892":121151,"_42174":121110,"_29767":196123,"_5":21387,"_28235":196011,"_5797":196124},[],"Un `status` vacío significa en ejecución. Solo el canario está activo. El servicio creó un job de WFX para `dev-001`:",{"_6892":121152,"_42174":121110,"_29767":196126,"_5":21387,"_28235":196015,"_5797":196127},[],"Un dispositivo real hace esto por sí mismo. Estos comandos son lo que envía a WFX, de modo que puedes manejar a mano un dispositivo de prueba. Primero el dispositivo le pide su job a WFX:",{"_6892":121153,"_42174":121110,"_29767":196129,"_5":21387,"_28235":196015,"_5797":196130},[],"El dispositivo descarga la `uri`, la instala e informa de cada paso:",{"_6892":121154,"_42174":121110,"_29767":196132,"_5":21387,"_28235":196015,"_5797":196133},[],"El workflow `direct` es `INSTALL → INSTALLING → INSTALLED → ACTIVATE → ACTIVATING → ACTIVATED`. El propio WFX da el paso `INSTALLED → ACTIVATE`. Para informar de un fallo, mueve un job a `TERMINATED`.",{"_6892":121155,"_42174":121110,"_29767":196135,"_5":21387,"_28235":196015,"_5797":196136},[],"El servicio se entera de cada cambio por WFX a través de su flujo de eventos y actualiza el lanzamiento. Tarda un instante, así que si `status` aún muestra el dispositivo como activo, vuelve a ejecutarlo al cabo de un segundo:",{"_6892":121156,"_42174":121110,"_29767":196138,"_5":21387,"_28235":196019,"_5797":196139},[],"El canario ha pasado. Cada llamada a `rollout` envía ahora el siguiente lote de dos:",{"_6892":121157,"_42174":121110,"_29767":196141,"_5":21387,"_28235":196019,"_5797":196142},[],"Haz pasar a esos dispositivos por pasos como los del paso 7 y vuelve a llamar a `rollout` para el último dispositivo. Cuando no queda nada pendiente ni activo, el lanzamiento se completa solo:",{"_6892":121158,"_42174":121110,"_29767":196144,"_5":21387,"_28235":196019,"_5797":196145},[],"`completed_count` cuenta solo los éxitos: un dispositivo fallido se cuenta en `failed_count`. Un lanzamiento se marca como `completed` cuando no queda nada pendiente ni activo, aunque algunos dispositivos hayan fallado, así que comprueba `failed_count` antes de dar la actualización por buena.",{"_6892":121159,"_42174":121110,"_29767":196147,"_5":21387,"_28235":196023,"_5797":196148},[],"Para seguir la deriva, declara la versión en la que deben estar los dispositivos y lee después la conformidad:",{"_6892":121160,"_42174":121110,"_29767":196150,"_5":21387,"_28235":196023,"_5797":196151},[],"La vista de toda la flota con el último intento por dispositivo y pack, incluidos los intentos ajenos a cualquier lanzamiento, es una sola llamada. No se ejecutó aquí; los corchetes de un filtro necesitan `curl -g`:",{"_6892":121161,"_42174":121110,"_29767":196153,"_5":21387,"_28235":196031,"_5797":196154},[],"Con `auto` activado, el servicio envía por sí mismo el siguiente lote cuando ha tenido éxito una parte suficiente del actual. `approval_threshold` es el porcentaje del lote que debe tener éxito (0 o 100 significan todo el lote). `error_threshold` se aplica a todos los lanzamientos, con `auto` o sin él: el lanzamiento se cancela cuando el número de dispositivos fallidos alcanza ese porcentaje de **todos** los dispositivos, redondeado hacia arriba. Con 4 dispositivos al 75 %, el tercer fallo lo cancela.",{"_6892":121162,"_42174":121110,"_29767":196156,"_5":21387,"_28235":196031,"_5797":196157},[],"Este ejemplo usa un segundo pack, `valve-panel`, creado y compilado como `water-panel` (pasos 2 a 4). Los nombres de artefacto son globales y un nombre que ya existe debe recibir una versión mayor, así que dale a este su propio nombre de archivo:",{"_6892":121163,"_42174":121110,"_29767":196159,"_5":21387,"_28235":196031,"_5797":196160},[],"Llama a `rollout` una vez para empezar. Una segunda llamada se rechaza:",{"_6892":121164,"_42174":121110,"_29767":196162,"_5":21387,"_28235":196031,"_5797":196163},[],"Si un dispositivo del primer lote falla (`TERMINATED`) y el otro tiene éxito, el 50 % de éxitos cumple el umbral y el siguiente lote se despacha solo.",{"_6892":121165,"_42174":121110,"_29767":196165,"_5":21387,"_28235":196035,"_5797":196166},[],"Una pausa deja terminar el lote en curso y retiene el siguiente. `retry-failed` devuelve los dispositivos fallidos al conjunto de pendientes y libera el siguiente lote. Ese lote se saca al azar de todos los dispositivos pendientes, así que también puede incluir dispositivos a los que nunca se envió nada, y si han fallado más dispositivos de los que caben en un lote, solo sale un lote. Responde `400` cuando no ha fallado nada, y reabre un lanzamiento completado o cancelado (`\"status\":\"running\"`). Un canario fallido pausa el lanzamiento por sí mismo, y `resume` vuelve entonces a enviar el canario. Un lanzamiento cancelado no se puede reanudar, y los dispositivos en curso terminan su job actual.",{"_6892":121166,"_42174":121110,"_29767":196168,"_5":21387,"_28235":196039,"_5797":196169},[],"No se ejecutó aquí. `scheduled_at` (RFC 3339) retrasa el primer lote. El servicio busca lanzamientos pendientes aproximadamente cada 30 segundos, así que el inicio puede retrasarse hasta ese tiempo. Una llamada a `rollout` antes de la hora no hace nada.",{"_6892":121167,"_42174":121110,"_29767":196171,"_5":21387,"_28235":196039,"_5797":196172},[],"La programación sobrevive a un reinicio y la ejecuta la réplica que tenga en cada momento el rol de líder, de modo que un lanzamiento programado se despacha una sola vez aunque haya varias réplicas.",{"_6892":121168,"_42174":121110,"_29767":196174,"_5":21387,"_28235":196043,"_5797":196175},[],"No se ejecutó aquí. Un pack puede exigir que un dispositivo ya tenga otro pack, o un módulo, en una versión mínima. La regla vive en el pack que lanzas. Los dispositivos que no la cumplen se dejan fuera, y la simulación los lista:",{"_6892":121169,"_42174":121110,"_29767":196177,"_5":21387,"_28235":196043,"_5797":196178},[],"Cada fallo indica el `device_id`, el `distribution_set_name` (y `module_key` en una regla de módulo), la `current_version` que tiene el dispositivo (vacía si no tiene ninguna) y la restricción `required`, por ejemplo `>=1.0.0`. Usa `required_module_key` con un valor `type:name` para exigir un módulo en su lugar. `force_preconditions: true` en el cuerpo del lanzamiento despliega a todos los dispositivos de todos modos y registra los fallos.",{"_6892":121170,"_42174":121110,"_29767":196180,"_5":21387,"_28235":196047,"_5797":196181},[],"No se ejecutó aquí. `force-version` lanza un solo dispositivo a una versión exacta de un pack, fuera de cualquier campaña, y responde `202`. El dispositivo debe ser miembro del grupo del pack:",{"_6892":121171,"_42174":121110,"_29767":196183,"_5":21387,"_28235":196047,"_5797":196184},[],"Sin `workflow`, un pack `swu` usa `phased`. Solo se puede forzar la versión actual del pack, salvo que el pack se haya creado con `allow_previous_version_download`.",{"_6892":121172,"_42174":121110,"_29767":196186,"_5":21387,"_28235":196051,"_5797":196187},[],"La versión debe ser mayor que la actual, y el pack conserva su id. La nueva versión empieza como `draft`. Los enlaces de artefactos y la composición de módulos se heredan, pero el sw-description no: súbelo de nuevo. Después compila con `selected_artifact_ids` (una compilación sustituye los enlaces heredados por los que selecciones), tras subir una nueva versión del artefacto si el archivo cambió.",{"_6892":121173,"_42174":121110,"_29767":196189,"_5":21387,"_28235":196055,"_5797":196190},[],"Una sola clave cifra el `.swu` para todos los dispositivos. El sw-description debe marcar los archivos que se cifran con `encrypted = true;`. Usa un pack distinto para cada variante de cifrado: una nueva versión hereda los ajustes de cifrado de la anterior, y una compilación sin cifrado no los borra. Recompilar un pack ya compilado con otros ajustes también deja campos obsoletos. Consulta Limitaciones.",{"_6892":121174,"_42174":121110,"_29767":196192,"_5":21387,"_28235":196055,"_5797":196193},[],"Esta función auxiliar crea un pack, sube un sw-description que marca su archivo con `encrypted = true;` y sube el artefacto. Imprime el id del artefacto.",{"_6892":121175,"_42174":121110,"_29767":196195,"_5":21387,"_28235":196055,"_5797":196196},[],"El pack informa entonces `\"encryption_mode\":\"shared\"`. El dispositivo necesita la misma clave y el mismo algoritmo. Consulta Firma y cifrado.",{"_6892":121176,"_42174":121110,"_29767":196198,"_5":21387,"_28235":196059,"_5797":196199},[],"Cada dispositivo recibe su propio paquete y su propia clave. Es otro pack, compilado con la misma función auxiliar. El sw-description debe marcar un archivo con `encrypted = true;`, o la compilación se rechaza.",{"_6892":121177,"_42174":121110,"_29767":196201,"_5":21387,"_28235":196059,"_5797":196202},[],"Si un dispositivo no tiene clave en el momento de la compilación, la compilación termina bien y el pack registra el hueco. Si **ningún** dispositivo tiene clave, la compilación falla.",{"_6892":121178,"_42174":121110,"_29767":196204,"_5":21387,"_28235":196059,"_5797":196205},[],"Un lanzamiento sobre ese pack se rechaza, simulaciones incluidas, y `force_preconditions` no lo anula:",{"_6892":121179,"_42174":121110,"_29767":196207,"_5":21387,"_28235":196059,"_5797":196208},[],"La cobertura se registra cuando se compila el pack, así que asignar la clave que falta no basta. Compila el pack de nuevo (una nueva versión) con una clave para cada dispositivo.",{"_6892":121180,"_42174":121110,"_29767":196210,"_5":21387,"_28235":196063,"_5797":196211},[],"Añade los campos de firma con KMS al cuerpo de la compilación. Necesitan una clave de firma y un certificado en el KMS de Lamassu, con `kms_endpoint` y `sign_script_path` configurados. Esta petición no se ejecutó aquí, porque necesita un KMS. Consulta Firma y cifrado.",{"_6892":121181,"_42174":121110,"_29767":196213,"_5":21387,"_28235":196067,"_5797":192457},[],{"_6892":121182,"_42174":121110,"_29767":196215,"_5":21387,"_28235":196067,"_5797":195911},[],{"_6892":121183,"_42174":121110,"_29767":196217,"_5":21387,"_28235":196067,"_5797":196218},[],"`409` en `artifact/upload` o `artifact/link`",{"_6892":121184,"_42174":121110,"_29767":196220,"_5":21387,"_28235":196067,"_5797":196221},[],"La versión del pack ya está `built`. Crea una nueva versión con `POST .../new`",{"_6892":121185,"_42174":121110,"_29767":196223,"_5":21387,"_28235":196067,"_5797":196224},[],"`409` en `POST .../distribution-sets`",{"_6892":121186,"_42174":121110,"_29767":196226,"_5":21387,"_28235":196067,"_5797":196227},[],"Ya existe un pack con ese nombre en el grupo",{"_6892":121187,"_42174":121110,"_29767":196229,"_5":21387,"_28235":196067,"_5797":87954},[],{"_6892":121188,"_42174":121110,"_29767":196231,"_5":21387,"_28235":196067,"_5797":196232},[],"El nombre de un artefacto es global y su versión debe aumentar. Sube con una `version` mayor",{"_6892":121189,"_42174":121110,"_29767":196234,"_5":21387,"_28235":196067,"_5797":196235},[],"La compilación falla con un directorio de binarios vacío",{"_6892":121190,"_42174":121110,"_29767":196237,"_5":21387,"_28235":196067,"_5797":196238},[],"La compilación no recibió `selected_artifact_ids`",{"_6892":121191,"_42174":121110,"_29767":196240,"_5":21387,"_28235":196067,"_5797":196241},[],"`400` al crear un lanzamiento: el pack no se ha compilado",{"_6892":121192,"_42174":121110,"_29767":196243,"_5":21387,"_28235":196067,"_5797":196244},[],"Compílalo primero. Un pack en `build_failed` tampoco se puede lanzar",{"_6892":121193,"_42174":121110,"_29767":196246,"_5":21387,"_28235":196067,"_5797":87972},[],{"_6892":121194,"_42174":121110,"_29767":196248,"_5":21387,"_28235":196067,"_5797":196249},[],"Algunos dispositivos no tienen clave `firmware-encryption`. Asigna claves y compila una nueva versión",{"_6892":121195,"_42174":121110,"_29767":196251,"_5":21387,"_28235":196067,"_5797":196252},[],"`rollout` responde `400` con `rolls out automatically`",{"_6892":121196,"_42174":121110,"_29767":196254,"_5":21387,"_28235":196067,"_5797":196255},[],"El lanzamiento tiene `auto` activado y ya ha empezado. Espera al umbral de aprobación, o páusalo",{"_6892":121197,"_42174":121110,"_29767":196257,"_5":21387,"_28235":196067,"_5797":196258},[],"`rollout` responde `400` con `test device ... failed`",{"_6892":121198,"_42174":121110,"_29767":196260,"_5":21387,"_28235":196067,"_5797":196261},[],"El canario falló. Reanuda el lanzamiento para reintentarlo, o cancélalo",{"_6892":121199,"_42174":121110,"_29767":196263,"_5":21387,"_28235":196067,"_5797":196264},[],"`413` en una subida",{"_6892":121200,"_42174":121110,"_29767":196266,"_5":21387,"_28235":196067,"_5797":196267},[],"El archivo supera `max_artifact_size_mb` (10 GiB por defecto), o el límite del gateway o del ingress que hay delante del servicio es menor",{"_6892":121201,"_42174":121110,"_29767":196269,"_5":21387,"_28235":196067,"_5797":196270},[],"`501` en una ruta de módulo",{"_6892":121202,"_42174":121110,"_29767":196272,"_5":21387,"_28235":196067,"_5797":196273},[],"El modo native no tiene entregables por módulo. Compila el pack en su lugar",{"_6892":121203,"_42174":121110,"_29767":196275,"_5":21387,"_28235":196070,"_5797":195687},[],{"_6892":121204,"_42174":121110,"_29767":196277,"_5":21387,"_28235":196070,"_5797":196278},[],"Conectar un dispositivo, para saber qué debe implementar un dispositivo real",{"_6892":121205,"_42174":121110,"_29767":196280,"_5":21387,"_28235":196070,"_5797":195977},[],{"_6892":121206,"_42174":121110,"_29767":196282,"_5":21387,"_28235":196070,"_5797":189766},[],{"_6892":121207,"_42174":121207,"_5":21817,"_5797":196284,"_42654":196285,"_29767":196286,"_28235":121207},"Publica y lanza una actualización",[77248,187247,193621,194906],[],{"_6892":121208,"_42174":121207,"_29767":196288,"_5":21387,"_28235":121207,"_5797":196289},[],"Crea un paquete de actualización, adjunta un artefacto, construye el entregable y lánzalo por lotes a un grupo de dispositivos.",{"_6892":121209,"_42174":121207,"_5":42651,"_29767":196291,"_28235":196292,"_5797":185844},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/publish-and-roll-out#antes-de-empezar",{"_6892":121210,"_42174":121207,"_5":42651,"_29767":196294,"_28235":196295,"_5797":196296},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/publish-and-roll-out#1-crea-el-paquete","1\\. Crea el paquete",{"_6892":121211,"_42174":121207,"_5":42651,"_29767":196298,"_28235":196299,"_5797":196300},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/publish-and-roll-out#2-sube-el-sw-description-y-el-artefacto","2\\. Sube el sw-description y el artefacto",{"_6892":121212,"_42174":121207,"_5":42651,"_29767":196302,"_28235":196303,"_5797":196304},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/publish-and-roll-out#compón-un-paquete-con-varios-módulos-opcional","Compón un paquete con varios módulos (opcional)",{"_6892":121213,"_42174":121207,"_5":42651,"_29767":196306,"_28235":196307,"_5797":196308},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/publish-and-roll-out#3-construye-el-entregable","3\\. Construye el entregable",{"_6892":121214,"_42174":121207,"_5":42651,"_29767":196310,"_28235":196311,"_5797":196312},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/publish-and-roll-out#4-crea-el-lanzamiento","4\\. Crea el lanzamiento",{"_6892":121215,"_42174":121207,"_5":42651,"_29767":196314,"_28235":196315,"_5797":196316},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/publish-and-roll-out#5-lánzalo","5\\. Lánzalo",{"_6892":121216,"_42174":121207,"_5":42651,"_29767":196318,"_28235":196319,"_5797":193289},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/publish-and-roll-out#verifica-el-resultado",{"_6892":121217,"_42174":121207,"_5":42651,"_29767":196321,"_28235":196322,"_5797":196323},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/publish-and-roll-out#publica-la-siguiente-versión","Publica la siguiente versión",{"_6892":121218,"_42174":121207,"_5":42651,"_29767":196325,"_28235":196326,"_5797":193637},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/publish-and-roll-out#modo-hawkbit",{"_6892":121219,"_42174":121207,"_5":42651,"_29767":196328,"_28235":196329,"_5797":189766},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/publish-and-roll-out#solución-de-problemas",{"_6892":121220,"_42174":121207,"_5":42651,"_29767":196331,"_28235":196332,"_5797":188883},[],"/docs/pr-preview/pr-56/es/platform/updates/guides/publish-and-roll-out#siguientes-pasos",{"_6892":121221,"_42174":121207,"_29767":196334,"_5":21387,"_28235":121207,"_5797":196335},[],"Esta guía lleva una actualización desde cero hasta los dispositivos: crea un paquete de actualización, adjunta un artefacto y un `sw-description`, construye el entregable, crea un lanzamiento (una campaña en el dashboard) y libéralo lote a lote. Las peticiones usan el modo nativo. El modo hawkBit construye y crea los paquetes en otro orden, que se describe en Modo hawkBit. Para hacer lo mismo con pantallas, sigue Usa el dashboard.",{"_6892":121222,"_42174":121207,"_29767":196337,"_5":21387,"_28235":196292,"_5797":196338},[],"El stack está en marcha y `curl localhost:10090/health` responde.",{"_6892":121223,"_42174":121207,"_29767":196340,"_5":21387,"_28235":196292,"_5797":196341},[],"Un grupo de dispositivos de Lamassu IoT que contenga los dispositivos que quieres actualizar. Su ID es `$GROUP`. Un paquete pertenece a un grupo y solo se puede lanzar a los dispositivos de ese grupo.",{"_6892":121224,"_42174":121207,"_29767":196343,"_5":21387,"_28235":196292,"_5797":196344},[],"El binario que vas a entregar y, para un paquete SWU, un fichero `sw-description`.",{"_6892":121225,"_42174":121207,"_29767":196346,"_5":21387,"_28235":196292,"_5797":196347},[],"Dispositivos que puedan recibir la actualización. Consulta Conecta un dispositivo.",{"_6892":121226,"_42174":121207,"_29767":196349,"_5":21387,"_28235":196292,"_5797":196350},[],"El servicio no tiene autenticación propia, así que estos ejemplos no envían ninguna. Pon delante una pasarela que autentique a quien llama: consulta Seguridad.",{"_6892":121227,"_42174":121207,"_29767":196352,"_5":21387,"_28235":196295,"_5797":196353},[],"La respuesta es `201` con el paquete, incluido su `id`. Un paquete empieza como `draft`.",{"_6892":121228,"_42174":121207,"_29767":196355,"_5":21387,"_28235":196295,"_5797":194122},[],{"_6892":121229,"_42174":121207,"_29767":196357,"_5":21387,"_28235":196295,"_5797":195292},[],{"_6892":121230,"_42174":121207,"_29767":196359,"_5":21387,"_28235":196295,"_5797":80179},[],{"_6892":121231,"_42174":121207,"_29767":196361,"_5":21387,"_28235":196295,"_5797":196362},[],"Obligatorio. Único dentro del grupo; un duplicado responde `409`. El modo nativo lo usa como segmento de ruta, así que solo puede contener letras, dígitos, `.`, `_` y `-` (sin espacios)",{"_6892":121232,"_42174":121207,"_29767":196364,"_5":21387,"_28235":196295,"_5797":88091},[],{"_6892":121233,"_42174":121207,"_29767":196366,"_5":21387,"_28235":196295,"_5797":196367},[],"Obligatorio. Semver estricto `x.y.z`, la defines tú",{"_6892":121234,"_42174":121207,"_29767":196369,"_5":21387,"_28235":196295,"_5797":88097},[],{"_6892":121235,"_42174":121207,"_29767":196371,"_5":21387,"_28235":196295,"_5797":196372},[],"Obligatorio en el cuerpo. Usa el mismo valor que en la ruta",{"_6892":121236,"_42174":121207,"_29767":196374,"_5":21387,"_28235":196295,"_5797":86664},[],{"_6892":121237,"_42174":121207,"_29767":196376,"_5":21387,"_28235":196295,"_5797":196377},[],"`rawfile` o `firmware`. Se registra en el paquete y se envía al dispositivo en el trabajo; el dashboard también ofrece `both` y `other`. No se valida al crear",{"_6892":121238,"_42174":121207,"_29767":196379,"_5":21387,"_28235":196295,"_5797":88108},[],{"_6892":121239,"_42174":121207,"_29767":196381,"_5":21387,"_28235":196295,"_5797":196382},[],"`swu` (por defecto) o `non-swu`. Un paquete `non-swu` entrega sus ficheros como un `.tar.gz` y usa el workflow `download-install`",{"_6892":121240,"_42174":121207,"_29767":196384,"_5":21387,"_28235":196295,"_5797":88114},[],{"_6892":121241,"_42174":121207,"_29767":196386,"_5":21387,"_28235":196295,"_5797":196387},[],"Opcional. Permite que los dispositivos descarguen versiones anteriores del paquete",{"_6892":121242,"_42174":121207,"_29767":196389,"_5":21387,"_28235":196295,"_5797":88120},[],{"_6892":121243,"_42174":121207,"_29767":196391,"_5":21387,"_28235":196295,"_5797":196392},[],"Opcional. Reglas que un dispositivo debe cumplir para recibir el paquete. Consulta Conceptos",{"_6892":121244,"_42174":121207,"_29767":196394,"_5":21387,"_28235":196295,"_5797":88126},[],{"_6892":121245,"_42174":121207,"_29767":196396,"_5":21387,"_28235":196295,"_5797":196397},[],"**Solo modo hawkBit**: la composición del paquete, como módulos del catálogo ya construidos. El modo nativo lo ignora",{"_6892":121246,"_42174":121207,"_29767":196399,"_5":21387,"_28235":196299,"_5797":196400},[],"El `sw-description` es un fichero de SWUpdate que enumera lo que instala el dispositivo. Su formato es el de SWUpdate, y la documentación de SWUpdate es la referencia. Cuando el servicio construye el `.swu`, `swugenerator` lee este fichero y los binarios preparados, así que el `filename` de cada imagen debe ser el nombre de un fichero subido. Un ejemplo mínimo:",{"_6892":121247,"_42174":121207,"_29767":196402,"_5":21387,"_28235":196299,"_5797":196403},[],"`swugenerator` rellena el `filename` final (con `.zlib` añadido, y `.enc` en los ficheros cifrados), el `sha256` y, en los ficheros cifrados, la propiedad `ivt`. Para una construcción cifrada, añade `encrypted = true;` a cada imagen que deba cifrarse. Dos reglas causan la mayoría de los fallos:",{"_6892":121248,"_42174":121207,"_29767":196405,"_5":21387,"_28235":196299,"_5797":196406},[],"`encrypted = true` solo debe aparecer en una construcción que aporte una clave (la construcción falla sin ella), y una construcción por dispositivo rechaza una descripción en la que ninguna imagen lo tenga.",{"_6892":121249,"_42174":121207,"_29767":196408,"_5":21387,"_28235":196299,"_5797":196409},[],"Las imágenes comprimidas necesitan `decompressed-size`.",{"_6892":121250,"_42174":121207,"_29767":196411,"_5":21387,"_28235":196299,"_5797":196412},[],"Si construyes tú el `.swu` y lo subes como entregable prefabricado, rellenas tú mismo `sha256` e `ivt`, y el `sha256` es sobre los bytes que descarga el dispositivo, porque SWUpdate calcula el hash antes de descifrar.",{"_6892":121251,"_42174":121207,"_29767":196414,"_5":21387,"_28235":196299,"_5797":196415},[],"`artifact_name` es por defecto el nombre del fichero sin su extensión. `version` es opcional; cuando subes un fichero nuevo con un `artifact_name` existente, debe ser estrictamente mayor que la versión más alta ya guardada con ese nombre.",{"_6892":121252,"_42174":121207,"_29767":196417,"_5":21387,"_28235":196299,"_5797":196418},[],"El artefacto se guarda como artefacto global y se enlaza a este paquete. La respuesta contiene su `id`. Para reutilizar un artefacto ya subido, enlázalo con `POST .../artifact/link` y `{\"artifact_id\":\"<id>\"}`.",{"_6892":121253,"_42174":121207,"_29767":196420,"_5":21387,"_28235":196299,"_5797":196421},[],"El fichero más grande admitido es `max_artifact_size_mb` (10 GiB por defecto). Una subida mayor responde `413`.",{"_6892":121254,"_42174":121207,"_29767":196423,"_5":21387,"_28235":196299,"_5797":196424},[],"Una vez construido el paquete, las subidas y los enlaces responden `409`: crea antes una versión nueva.",{"_6892":121255,"_42174":121207,"_29767":196426,"_5":21387,"_28235":196303,"_5797":196427},[],"Un paquete nativo es una composición de módulos de software: un módulo `os` más cualquier número de módulos `application`. Un paquete sin módulos declarados se comporta como un único módulo `os` implícito que posee los artefactos que subiste antes. Para añadir un módulo de aplicación y darle sus propios ficheros:",{"_6892":121256,"_42174":121207,"_29767":196429,"_5":21387,"_28235":196303,"_5797":196430},[],"La clave del módulo es `<type>:<name>`. El modo nativo sigue construyendo un único `.swu` para todo el paquete, a partir de los artefactos de todos los módulos y del único `sw-description` del paquete. También puedes componer desde un módulo que ya existe con `POST .../modules/import`; en modo nativo eso copia el módulo, mientras que en modo hawkBit enlaza el mismo módulo. Consulta Conceptos para el modelo.",{"_6892":121257,"_42174":121207,"_29767":196432,"_5":21387,"_28235":196307,"_5797":196433},[],"`selected_artifact_ids` es lo que mete artefactos en la construcción: solo se preparan los listados. Con una lista vacía la construcción falla porque no se preparó ningún binario, y el paquete pasa a `build_failed`. Toma el ID de la respuesta de la subida del artefacto, o de `GET $API/artifacts`.",{"_6892":121258,"_42174":121207,"_29767":196435,"_5":21387,"_28235":196307,"_5797":196436},[],"El cuerpo anterior construye un `.swu` sin cifrar y sin firmar. Para firmar o cifrar, añade campos como se describe en Firma y cifrado.",{"_6892":121259,"_42174":121207,"_29767":196438,"_5":21387,"_28235":196307,"_5797":196439},[],"Para un paquete `non-swu`, llama a `POST .../package` en lugar de `.../swu`. Sin `selected_artifact_ids` empaqueta los artefactos enlazados al paquete.",{"_6892":121260,"_42174":121207,"_29767":196441,"_5":21387,"_28235":196307,"_5797":196442},[],"Para entregar un fichero que construiste por tu cuenta, súbelo a `POST .../swu/upload` (o `.../package/upload`) como un `file` multipart. Se guarda y se sirve sin cambios, así que ya debe estar firmado y cifrado como esperan tus dispositivos. Solo modo nativo.",{"_6892":121261,"_42174":121207,"_29767":196444,"_5":21387,"_28235":196307,"_5797":196445},[],"Cuando la construcción termina bien, el paquete pasa a `built` y sus artefactos y su composición son inmutables. Si falla, el paquete pasa a `build_failed` y `last_build_error` guarda el motivo: corrige la entrada y construye de nuevo. Una construcción que se ejecuta mientras otra tiene bloqueado el mismo paquete responde `409`.",{"_6892":121262,"_42174":121207,"_29767":196447,"_5":21387,"_28235":196311,"_5797":196448},[],"El lanzamiento apunta a todos los dispositivos del grupo en el momento de crearlo, y necesita un paquete construido. La respuesta es `201` con `launch_id`, `precondition_failures`, `forced` y, en modo hawkBit, `superseded_devices` y `never_seen_devices`.",{"_6892":121263,"_42174":121207,"_29767":196450,"_5":21387,"_28235":196311,"_5797":194122},[],{"_6892":121264,"_42174":121207,"_29767":196452,"_5":21387,"_28235":196311,"_5797":195292},[],{"_6892":121265,"_42174":121207,"_29767":196454,"_5":21387,"_28235":196311,"_5797":88187},[],{"_6892":121266,"_42174":121207,"_29767":196456,"_5":21387,"_28235":196311,"_5797":196457},[],"Obligatorios. `rollout_value` debe ser mayor que 0",{"_6892":121267,"_42174":121207,"_29767":196459,"_5":21387,"_28235":196311,"_5797":85759},[],{"_6892":121268,"_42174":121207,"_29767":196461,"_5":21387,"_28235":196311,"_5797":196462},[],"`percentage` del grupo por lote, o `fixed` (un número de dispositivos). Cualquier valor distinto de `percentage` se interpreta como un número",{"_6892":121269,"_42174":121207,"_29767":196464,"_5":21387,"_28235":196311,"_5797":85771},[],{"_6892":121270,"_42174":121207,"_29767":196466,"_5":21387,"_28235":196311,"_5797":196467},[],"Nativo: `direct`, `phased`, `download-install`, o el nombre completo de otro workflow registrado en WFX (`GET $API/workflows`). hawkBit: `phased` crea una acción soft, cualquier otro valor una forced",{"_6892":121271,"_42174":121207,"_29767":196469,"_5":21387,"_28235":196311,"_5797":85777},[],{"_6892":121272,"_42174":121207,"_29767":196471,"_5":21387,"_28235":196311,"_5797":196472},[],"Canario opcional: un miembro del grupo que se actualiza primero y debe tener éxito antes de tocar ningún otro dispositivo",{"_6892":121273,"_42174":121207,"_29767":196474,"_5":21387,"_28235":196311,"_5797":88208},[],{"_6892":121274,"_42174":121207,"_29767":196476,"_5":21387,"_28235":196311,"_5797":196477},[],"Opcionales. `auto` libera los lotes siguientes por sí solo. Ambos umbrales son porcentajes de 0 a 100",{"_6892":121275,"_42174":121207,"_29767":196479,"_5":21387,"_28235":196311,"_5797":85801},[],{"_6892":121276,"_42174":121207,"_29767":196481,"_5":21387,"_28235":196311,"_5797":196482},[],"Hora RFC 3339 opcional. El primer lote se retrasa hasta entonces",{"_6892":121277,"_42174":121207,"_29767":196484,"_5":21387,"_28235":196311,"_5797":88219},[],{"_6892":121278,"_42174":121207,"_29767":196486,"_5":21387,"_28235":196311,"_5797":196487},[],"Opcionales. `name` es por defecto el nombre del paquete. `weight` (de 0 a 1000) se guarda pero nada lo lee",{"_6892":121279,"_42174":121207,"_29767":196489,"_5":21387,"_28235":196311,"_5797":88225},[],{"_6892":121280,"_42174":121207,"_29767":196491,"_5":21387,"_28235":196311,"_5797":196492},[],"Despliega también en los dispositivos que no cumplen las precondiciones del paquete. Los fallos se registran igualmente",{"_6892":121281,"_42174":121207,"_29767":196494,"_5":21387,"_28235":196311,"_5797":196495},[],"Elige el workflow según el paquete:",{"_6892":121282,"_42174":121207,"_29767":196497,"_5":21387,"_28235":196311,"_5797":196498},[],"Usa `direct` para paquetes SWU salvo que gestiones WFX tú mismo. El workflow `phased` tiene pasos que WFX o un operador deben confirmar, y este servicio no los avanza. Un lanzamiento `phased` se queda en su primer estado hasta que alguien lo confirma a través de WFX.",{"_6892":121283,"_42174":121207,"_29767":196500,"_5":21387,"_28235":196311,"_5797":196501},[],"Para un paquete `non-swu`, pon `workflow_type` a `download-install`. El lanzamiento usa el valor que indicas tal cual, así que `direct` ejecutaría el workflow SWU y la actualización parecería atascada cuando el dispositivo ya terminó.",{"_6892":121284,"_42174":121207,"_29767":196503,"_5":21387,"_28235":196311,"_5797":196504},[],"En modo hawkBit no hay WFX. La elección es el modo de instalación de hawkBit.",{"_6892":121285,"_42174":121207,"_29767":196506,"_5":21387,"_28235":196311,"_5797":196507},[],"Si el paquete tiene precondiciones, previsualiza qué dispositivos cumplen antes de crear nada añadiendo `?dry_run=true` a la misma petición. Responde `200` con `qualifying_devices`, `precondition_failures`, `superseded_devices` y `never_seen_devices`, y no crea nada.",{"_6892":121286,"_42174":121207,"_29767":196509,"_5":21387,"_28235":196311,"_5797":196510},[],"**Umbrales de aprobación y de error.** Con `auto: true`, el siguiente lote se libera cuando al menos `approval_threshold` por ciento del lote actual ha tenido éxito (0 significa el lote completo). En modo nativo, la campaña se cancela cuando `error_threshold` por ciento de todos sus dispositivos ha fallado; en modo hawkBit se detiene cuando falla más de ese porcentaje de un lote. En cambio, un canario fallido pausa una campaña nativa: reanúdala para reintentar el canario.",{"_6892":121287,"_42174":121207,"_29767":196512,"_5":21387,"_28235":196311,"_5797":196513},[],"Toma el ID del lanzamiento de la respuesta. Es `$LAUNCH` más abajo.",{"_6892":121288,"_42174":121207,"_29767":196515,"_5":21387,"_28235":196315,"_5797":196516},[],"Sin `auto`, cada llamada despacha el siguiente lote (primero el canario, si lo definiste). Con `auto: true`, llama una vez para iniciar el primer lote: el servicio libera después los demás lotes por sí solo al cumplirse el umbral de aprobación, y las llamadas posteriores responden `400`. Si el lanzamiento tiene un `scheduled_at` futuro, la llamada se acepta pero no hace nada: el servicio lo inicia solo a esa hora (el modo nativo comprueba cada 30 segundos; en hawkBit inicia el rollout el propio planificador de hawkBit).",{"_6892":121289,"_42174":121207,"_29767":196518,"_5":21387,"_28235":196315,"_5797":196519},[],"Un lanzamiento nativo pasa por estos estados:",{"_6892":121290,"_42174":121207,"_29767":196521,"_5":21387,"_28235":196315,"_5797":196522},[],"Puedes dirigir un lanzamiento mientras se ejecuta:",{"_6892":121291,"_42174":121207,"_29767":196524,"_5":21387,"_28235":196315,"_5797":192463},[],{"_6892":121292,"_42174":121207,"_29767":196526,"_5":21387,"_28235":196315,"_5797":196527},[],"Petición",{"_6892":121293,"_42174":121207,"_29767":196529,"_5":21387,"_28235":196315,"_5797":196530},[],"Efecto",{"_6892":121294,"_42174":121207,"_29767":196532,"_5":21387,"_28235":196315,"_5797":196533},[],"Pausar",{"_6892":121295,"_42174":121207,"_29767":196535,"_5":21387,"_28235":196315,"_5797":88271},[],{"_6892":121296,"_42174":121207,"_29767":196537,"_5":21387,"_28235":196315,"_5797":196538},[],"No hay más lotes hasta reanudar. Los dispositivos que ya están en curso terminan",{"_6892":121297,"_42174":121207,"_29767":196540,"_5":21387,"_28235":196315,"_5797":196541},[],"Reanudar",{"_6892":121298,"_42174":121207,"_29767":196543,"_5":21387,"_28235":196315,"_5797":88280},[],{"_6892":121299,"_42174":121207,"_29767":196545,"_5":21387,"_28235":196315,"_5797":196546},[],"Nativo: una campaña automática libera su siguiente lote de inmediato si el actual ya cumplió el umbral, y reanudar tras un canario fallido lo reintenta",{"_6892":121300,"_42174":121207,"_29767":196548,"_5":21387,"_28235":196315,"_5797":196549},[],"Reintentar dispositivos fallidos",{"_6892":121301,"_42174":121207,"_29767":196551,"_5":21387,"_28235":196315,"_5797":88289},[],{"_6892":121302,"_42174":121207,"_29767":196553,"_5":21387,"_28235":196315,"_5797":196554},[],"Vuelve a poner en cola los dispositivos fallidos y los despacha. Responde `400` si no hay ninguno",{"_6892":121303,"_42174":121207,"_29767":196556,"_5":21387,"_28235":196315,"_5797":196557},[],"Cancelar (terminal)",{"_6892":121304,"_42174":121207,"_29767":196559,"_5":21387,"_28235":196315,"_5797":88298},[],{"_6892":121305,"_42174":121207,"_29767":196561,"_5":21387,"_28235":196315,"_5797":196562},[],"Los dispositivos pendientes no se actualizan",{"_6892":121306,"_42174":121207,"_29767":196564,"_5":21387,"_28235":196315,"_5797":196565},[],"Marcar como completado (terminal)",{"_6892":121307,"_42174":121207,"_29767":196567,"_5":21387,"_28235":196315,"_5797":88307},[],{"_6892":121308,"_42174":121207,"_29767":196569,"_5":21387,"_28235":196315,"_5797":196570},[],"No disponible en modo hawkBit",{"_6892":121309,"_42174":121207,"_29767":196572,"_5":21387,"_28235":196315,"_5797":196573},[],"Leer o cambiar la estrategia",{"_6892":121310,"_42174":121207,"_29767":196575,"_5":21387,"_28235":196315,"_5797":88316},[],{"_6892":121311,"_42174":121207,"_29767":196577,"_5":21387,"_28235":196315,"_5797":196578},[],"Cambiarla no está disponible en modo hawkBit",{"_6892":121312,"_42174":121207,"_29767":196580,"_5":21387,"_28235":196315,"_5797":196581},[],"En modo hawkBit, un rollout solo se puede pausar después de que haya empezado a despachar.",{"_6892":121313,"_42174":121207,"_29767":196583,"_5":21387,"_28235":196319,"_5797":196584},[],"El listado de lanzamientos responde `{\"list\":[...],\"next\":\"...\"}`. Un lanzamiento ha terminado cuando `pending_count` y `active_count` valen cero; un lanzamiento nativo pone entonces su `status` en `completed` por sí solo. Los dispositivos terminan como `completed` (estado del trabajo `ACTIVATED`, o `INSTALLED` para `non-swu`) o `failed` (`TERMINATED`).",{"_6892":121314,"_42174":121207,"_29767":196586,"_5":21387,"_28235":196322,"_5797":196587},[],"Una versión construida de un paquete es inmutable. Para cambiarla, crea la versión siguiente, sube lo que haya cambiado y construye de nuevo:",{"_6892":121315,"_42174":121207,"_29767":196589,"_5":21387,"_28235":196322,"_5797":196590},[],"La versión debe ser estrictamente mayor que la actual. La versión nueva empieza sin construir y arrastra los artefactos actuales.",{"_6892":121316,"_42174":121207,"_29767":196592,"_5":21387,"_28235":196322,"_5797":196593},[],"Para actualizar un dispositivo a una versión exacta sin campaña, usa `POST $API/devices/<device-id>/force-version` con `{\"distribution_set_id\":\"<pack id>\",\"version\":\"1.1.0\"}`; en modo nativo crea un lanzamiento de un solo dispositivo y usa por defecto el workflow `phased` para paquetes SWU (`download-install` para `non-swu`), salvo que indiques un `workflow`.",{"_6892":121317,"_42174":121207,"_29767":196595,"_5":21387,"_28235":196326,"_5797":196596},[],"Los paquetes de hawkBit se ensamblan a partir de módulos del catálogo ya construidos, así que los pasos 2 y 3 del lado del paquete pasan al catálogo:",{"_6892":121318,"_42174":121207,"_29767":196598,"_5":21387,"_28235":196326,"_5797":196599},[],"Crea el módulo: `POST $API/softwaremodules` con `type` (`os` o `application`), `name`, `version` y un `delivery_intent`: `swu-build`, `swu-prebuilt` o `raw`. `undecided` se acepta, pero un módulo no puede entrar en un paquete hasta que elijas.",{"_6892":121319,"_42174":121207,"_29767":196601,"_5":21387,"_28235":196326,"_5797":196602},[],"Sube el fichero con `POST $API/softwaremodules/by-id/<id>/artifacts`. Para `swu-build`, sube también el `sw-description` a `.../descriptor` y llama a `POST $API/softwaremodules/by-id/<id>/build`. Para `swu-prebuilt`, subir el `.swu` es la construcción. Para `raw`, llama a `.../build` para que los ficheros sean el entregable; firmar y cifrar es opcional.",{"_6892":121320,"_42174":121207,"_29767":196604,"_5":21387,"_28235":196326,"_5797":196605},[],"Crea el paquete con `\"modules\":[{\"source_module_id\":\"<id>\"}]`. Se crea ya construido.",{"_6892":121321,"_42174":121207,"_29767":196607,"_5":21387,"_28235":196326,"_5797":196608},[],"Después continúa en el paso 4. Los detalles, incluidas las intenciones de entrega, están en Modo hawkBit, y una secuencia completa de peticiones en la guía curl de hawkBit.",{"_6892":121322,"_42174":121207,"_29767":196610,"_5":21387,"_28235":196329,"_5797":192457},[],{"_6892":121323,"_42174":121207,"_29767":196612,"_5":21387,"_28235":196329,"_5797":194863},[],{"_6892":121324,"_42174":121207,"_29767":196614,"_5":21387,"_28235":196329,"_5797":196615},[],"Una llamada devuelve `501 Not Implemented`",{"_6892":121325,"_42174":121207,"_29767":196617,"_5":21387,"_28235":196329,"_5797":196618},[],"El backend activo no la admite. Consulta Capacidades",{"_6892":121326,"_42174":121207,"_29767":196620,"_5":21387,"_28235":196329,"_5797":196621},[],"`400` «has not been built yet» al crear un lanzamiento",{"_6892":121327,"_42174":121207,"_29767":196623,"_5":21387,"_28235":196329,"_5797":196624},[],"El paquete está en `draft` o `build_failed`. Constrúyelo primero",{"_6892":121328,"_42174":121207,"_29767":196626,"_5":21387,"_28235":196329,"_5797":196627},[],"`400` sobre dispositivos sin paquete",{"_6892":121329,"_42174":121207,"_29767":196629,"_5":21387,"_28235":196329,"_5797":196630},[],"Un paquete cifrado por dispositivo se construyó solo para algunos. El mensaje nombra los dispositivos sin clave; corrígelos y reconstruye",{"_6892":121330,"_42174":121207,"_29767":196632,"_5":21387,"_28235":196329,"_5797":196633},[],"`400` «group has no devices to launch to»",{"_6892":121331,"_42174":121207,"_29767":196635,"_5":21387,"_28235":196329,"_5797":196636},[],"El grupo no tiene miembros, o ninguno cumple. Revisa los criterios del grupo y las precondiciones del paquete",{"_6892":121332,"_42174":121207,"_29767":196638,"_5":21387,"_28235":196329,"_5797":196639},[],"La construcción devuelve un error sobre `encrypted = true`",{"_6892":121333,"_42174":121207,"_29767":196641,"_5":21387,"_28235":196329,"_5797":196642},[],"Una construcción por dispositivo necesita al menos una imagen marcada con `encrypted = true` en el `sw-description`",{"_6892":121334,"_42174":121207,"_29767":196644,"_5":21387,"_28235":196329,"_5797":196645},[],"La construcción SWU falla con «failed to read binaries directory» o «binaries directory is empty»",{"_6892":121335,"_42174":121207,"_29767":196647,"_5":21387,"_28235":196329,"_5797":196648},[],"No se preparó nada: falta `selected_artifact_ids` en el cuerpo de la construcción",{"_6892":121336,"_42174":121207,"_29767":196650,"_5":21387,"_28235":196329,"_5797":196651},[],"`409` al subir, enlazar o construir",{"_6892":121337,"_42174":121207,"_29767":196653,"_5":21387,"_28235":196329,"_5797":196654},[],"La versión ya está construida (crea una versión nueva), o otra petición está construyendo el mismo paquete",{"_6892":121338,"_42174":121207,"_29767":196656,"_5":21387,"_28235":196329,"_5797":196657},[],"`413` al subir",{"_6892":121339,"_42174":121207,"_29767":196659,"_5":21387,"_28235":196329,"_5797":196660},[],"El fichero supera `max_artifact_size_mb`",{"_6892":121340,"_42174":121207,"_29767":196662,"_5":21387,"_28235":196329,"_5797":196663},[],"El lanzamiento responde `400` «paused» o «rolls out automatically»",{"_6892":121341,"_42174":121207,"_29767":196665,"_5":21387,"_28235":196329,"_5797":196666},[],"Reanuda el lanzamiento, o deja que la campaña automática libere sus propios lotes",{"_6892":121342,"_42174":121207,"_29767":196668,"_5":21387,"_28235":196329,"_5797":196669},[],"El lanzamiento sigue en `running` sin progreso de dispositivos (hawkBit)",{"_6892":121343,"_42174":121207,"_29767":196671,"_5":21387,"_28235":196329,"_5797":196672},[],"Los dispositivos nunca contactaron con hawkBit. Un grupo de rollout no avanza hasta que sus dispositivos consultan",{"_6892":121344,"_42174":121207,"_29767":196674,"_5":21387,"_28235":196329,"_5797":196675},[],"Los dispositivos no pueden descargar el `.swu` (nativo)",{"_6892":121345,"_42174":121207,"_29767":196677,"_5":21387,"_28235":196329,"_5797":196678},[],"`update_domain` no es alcanzable desde el dispositivo, o no es la base completa `.../updates/v1/` con barra final. La URL de descarga se fija al construir el paquete, así que reconstruye tras cambiarla",{"_6892":121346,"_42174":121207,"_29767":196680,"_5":21387,"_28235":196329,"_5797":196681},[],"Falla la creación del paquete en modo hawkBit",{"_6892":121347,"_42174":121207,"_29767":196683,"_5":21387,"_28235":196329,"_5797":196684},[],"Ya existe un paquete con ese nombre en el grupo (`409`), un módulo no está construido o no se enlazó con `source_module_id`, o el nombre y la versión de un módulo anterior están reservados. Sube la versión",{"_6892":121348,"_42174":121207,"_29767":196686,"_5":21387,"_28235":196329,"_5797":196687},[],"Un lanzamiento `non-swu` ejecuta los estados SWU",{"_6892":121349,"_42174":121207,"_29767":196689,"_5":21387,"_28235":196329,"_5797":196690},[],"Se creó con `workflow_type: direct`. Usa `download-install`",{"_6892":121350,"_42174":121207,"_29767":196692,"_5":21387,"_28235":196332,"_5797":196693},[],"<Card title=\"Conceptos\" href=\"/docs/platform/updates/concepts\" description=\"Paquetes, módulos, lanzamientos, workflows y precondiciones.\" />",{"_6892":121351,"_42174":121207,"_29767":196695,"_5":21387,"_28235":196332,"_5797":196696},[],"<Card title=\"Guía curl nativa\" href=\"/docs/platform/updates/guides/native-curl\" description=\"Todas las peticiones del flujo nativo, en orden.\" />",{"_6892":121352,"_42174":121207,"_29767":196698,"_5":21387,"_28235":196332,"_5797":196699},[],"<Card title=\"Referencia de la API\" href=\"/docs/platform/updates/reference/api\" description=\"Todas las rutas, cuerpos y códigos de estado.\" />",{"_6892":121353,"_42174":121353,"_5":21817,"_5797":193637,"_42654":196701,"_29767":196702,"_28235":121353},[77248,187247,193621,192003],[],{"_6892":121354,"_42174":121353,"_29767":196704,"_5":21387,"_28235":121353,"_5797":196705},[],"Ejecuta la misma API de Lamassu Updates sobre un servidor Eclipse hawkBit, qué guarda el adaptador en Postgres y qué difiere del modo native.",{"_6892":121355,"_42174":121353,"_5":42651,"_29767":196707,"_28235":196708,"_5797":196709},[],"/docs/pr-preview/pr-56/es/platform/updates/hawkbit-mode#requisitos-previos","Requisitos previos",{"_6892":121356,"_42174":121353,"_5":42651,"_29767":196711,"_28235":196712,"_5797":196713},[],"/docs/pr-preview/pr-56/es/platform/updates/hawkbit-mode#actívalo","Actívalo",{"_6892":121357,"_42174":121353,"_5":42651,"_29767":196715,"_28235":196716,"_5797":196717},[],"/docs/pr-preview/pr-56/es/platform/updates/hawkbit-mode#ejecútalo-en-local","Ejecútalo en local",{"_6892":121358,"_42174":121353,"_5":42651,"_29767":196719,"_28235":196720,"_5797":196721},[],"/docs/pr-preview/pr-56/es/platform/updates/hawkbit-mode#crear-y-construir-un-paquete","Crear y construir un paquete",{"_6892":121359,"_42174":121353,"_5":42651,"_29767":196723,"_28235":196724,"_5797":196725},[],"/docs/pr-preview/pr-56/es/platform/updates/hawkbit-mode#crea-el-módulo-en-el-catálogo","Crea el módulo en el catálogo",{"_6892":121360,"_42174":121353,"_5":42651,"_29767":196727,"_28235":196728,"_5797":196729},[],"/docs/pr-preview/pr-56/es/platform/updates/hawkbit-mode#sube-sus-ficheros","Sube sus ficheros",{"_6892":121361,"_42174":121353,"_5":42651,"_29767":196731,"_28235":196732,"_5797":196733},[],"/docs/pr-preview/pr-56/es/platform/updates/hawkbit-mode#haz-que-quede-construido","Haz que quede construido",{"_6892":121362,"_42174":121353,"_5":42651,"_29767":196735,"_28235":196736,"_5797":196737},[],"/docs/pr-preview/pr-56/es/platform/updates/hawkbit-mode#crea-el-paquete-a-partir-de-los-módulos-construidos","Crea el paquete a partir de los módulos construidos",{"_6892":121363,"_42174":121353,"_5":42651,"_29767":196739,"_28235":196740,"_5797":196741},[],"/docs/pr-preview/pr-56/es/platform/updates/hawkbit-mode#correspondencia","Correspondencia",{"_6892":121364,"_42174":121353,"_5":42651,"_29767":196743,"_28235":196744,"_5797":196745},[],"/docs/pr-preview/pr-56/es/platform/updates/hawkbit-mode#qué-vive-dónde","Qué vive dónde",{"_6892":121365,"_42174":121353,"_5":42651,"_29767":196747,"_28235":196748,"_5797":196749},[],"/docs/pr-preview/pr-56/es/platform/updates/hawkbit-mode#dispositivos-y-targets","Dispositivos y targets",{"_6892":121366,"_42174":121353,"_5":42651,"_29767":196751,"_28235":196752,"_5797":196753},[],"/docs/pr-preview/pr-56/es/platform/updates/hawkbit-mode#autenticación-de-dispositivos-en-producción","Autenticación de dispositivos en producción",{"_6892":121367,"_42174":121353,"_5":42651,"_29767":196755,"_28235":196756,"_5797":196757},[],"/docs/pr-preview/pr-56/es/platform/updates/hawkbit-mode#almacenamiento-de-artefactos-y-descargas","Almacenamiento de artefactos y descargas",{"_6892":121368,"_42174":121353,"_5":42651,"_29767":196759,"_28235":196760,"_5797":196761},[],"/docs/pr-preview/pr-56/es/platform/updates/hawkbit-mode#qué-difiere-del-modo-native","Qué difiere del modo native",{"_6892":121369,"_42174":121353,"_5":42651,"_29767":196763,"_28235":196764,"_5797":196765},[],"/docs/pr-preview/pr-56/es/platform/updates/hawkbit-mode#escalado","Escalado",{"_6892":121370,"_42174":121353,"_29767":196767,"_5":21387,"_28235":121353,"_5797":196768},[],"En modo `hawkbit`, Lamassu Updates sirve la misma API `/updates/v1` sobre un servidor Eclipse hawkBit en lugar de su propio backend basado en Postgres, WFX y SymKMS. El servicio se convierte en un **adaptador**: hawkBit es el dueño de los paquetes, módulos, rollouts y trabajos, y se lee en vivo en cada petición, y los dispositivos hablan directamente con hawkBit.",{"_6892":121371,"_42174":121353,"_29767":196770,"_5":21387,"_28235":121353,"_5797":196771},[],"Úsalo cuando hawkBit ya sea el backend de actualizaciones de tu flota, o para comparar los dos backends. Para elegir entre ellos, consulta la descripción general.",{"_6892":121372,"_42174":121353,"_29767":196773,"_5":21387,"_28235":196708,"_5797":196774},[],"Un servidor hawkBit (1.x) accesible y sus credenciales de la API de gestión.",{"_6892":121373,"_42174":121353,"_29767":196776,"_5":21387,"_28235":196708,"_5797":196777},[],"Postgres para este servicio. Consulta Qué vive dónde.",{"_6892":121374,"_42174":121353,"_29767":196779,"_5":21387,"_28235":196708,"_5797":196780},[],"Dispositivos que consultan hawkBit mediante el módulo `suricatta` de SWUpdate. Con `dms_endpoint` definido, el propio servicio crea y etiqueta los targets de hawkBit de los dispositivos de un grupo (consulta Dispositivos y targets). Sin él, los registras y etiquetas tú en hawkBit.",{"_6892":121375,"_42174":121353,"_29767":196782,"_5":21387,"_28235":196712,"_5797":196783},[],"`mode` vale `native` cuando no está definido, así que las configuraciones existentes no se ven afectadas. El arranque falla si `hawkbit.base_url` o `storage.hostname` están vacíos. Un hawkBit inaccesible no detiene el arranque: se manifiesta como errores en las peticiones.",{"_6892":121376,"_42174":121353,"_29767":196785,"_5":21387,"_28235":196712,"_5797":196786},[],"Para construir entregables en este modo, añade encima lo que necesites. Todo se lee una sola vez al arrancar:",{"_6892":121377,"_42174":121353,"_29767":196788,"_5":21387,"_28235":196712,"_5797":196789},[],"Quieres",{"_6892":121378,"_42174":121353,"_29767":196791,"_5":21387,"_28235":196712,"_5797":196792},[],"Define",{"_6892":121379,"_42174":121353,"_29767":196794,"_5":21387,"_28235":196712,"_5797":196795},[],"Módulos `swu-build` (`.swu` ensamblado)",{"_6892":121380,"_42174":121353,"_29767":196797,"_5":21387,"_28235":196712,"_5797":88538},[],{"_6892":121381,"_42174":121353,"_29767":196799,"_5":21387,"_28235":196712,"_5797":196800},[],"Firma con el KMS de Lamassu",{"_6892":121382,"_42174":121353,"_29767":196802,"_5":21387,"_28235":196712,"_5797":196803},[],"además `sign_script_path` y `kms_endpoint` (los módulos raw solo necesitan `kms_endpoint`)",{"_6892":121383,"_42174":121353,"_29767":196805,"_5":21387,"_28235":196712,"_5797":196806},[],"Cifrado con clave compartida",{"_6892":121384,"_42174":121353,"_29767":196808,"_5":21387,"_28235":196712,"_5797":196809},[],"`symkms_endpoint`, más el bloque `symkms` o `sym_keys_dir` para que el proceso registre las rutas `/symkms/v1`",{"_6892":121385,"_42174":121353,"_29767":196811,"_5":21387,"_28235":196712,"_5797":196812},[],"Consulta la referencia de configuración y Firma y cifrado. Sin estas claves, `GET /updates/v1/capabilities` informa `artifact_encryption: false` y el dashboard oculta el selector de cifrado.",{"_6892":121386,"_42174":121353,"_29767":196814,"_5":21387,"_28235":196712,"_5797":196815},[],"La API escucha en `app.server.port`, y lo eliges tú. El dashboard lee la URL de su API de `LAMASSU_UPDATES_API`, así que apúntala a la instancia que ejecuta el modo que quieres. Si ejecutas a la vez una instancia native y una `hawkbit`, dales puertos distintos y define el `symkms_endpoint` de cada instancia con **su propio** puerto: apunta al mismo proceso.",{"_6892":121387,"_42174":121353,"_29767":196817,"_5":21387,"_28235":196716,"_5797":196818},[],"El `docker-compose.yml` del repositorio arranca un hawkBit (puerto `8090` del host, respaldado por la base de datos Postgres `hawkbit`) y el Postgres que usan ambos servicios:",{"_6892":121388,"_42174":121353,"_29767":196820,"_5":21387,"_28235":196716,"_5797":196821},[],"`config-hawkbit.yml` contiene valores de una máquina de desarrollo: rutas absolutas para `swugenerator_path`, `sign_script_path` y los directorios de SymKMS, y una dirección de red local para `kms_endpoint`. Edítalos primero y apúntalos a rutas que el usuario del servicio pueda crear. El fichero no tiene `dms_endpoint`: añade la URL de tu Device Manager de Lamassu, o el servicio no tendrá grupos de dispositivos a los que lanzar.",{"_6892":121389,"_42174":121353,"_29767":196823,"_5":21387,"_28235":196716,"_5797":196824},[],"Comprueba el backend:",{"_6892":121390,"_42174":121353,"_29767":196826,"_5":21387,"_28235":196720,"_5797":196827},[],"Un distribution set de hawkBit solo puede enlazar módulos de software **construidos**, así que el orden difiere del modo native. El flujo empieza por el catálogo:",{"_6892":121391,"_42174":121353,"_29767":196829,"_5":21387,"_28235":196724,"_5797":196830},[],"`POST /updates/v1/softwaremodules` con su `type`, `name`, `version` y `delivery_intent`.",{"_6892":121392,"_42174":121353,"_29767":196832,"_5":21387,"_28235":196728,"_5797":196833},[],"`POST /updates/v1/softwaremodules/by-id/:moduleID/artifacts`. Esta ruta transmite el fichero a hawkBit en streaming.",{"_6892":121393,"_42174":121353,"_29767":196835,"_5":21387,"_28235":196732,"_5797":196836},[],"Cómo depende del delivery intent (tabla siguiente).",{"_6892":121394,"_42174":121353,"_29767":196838,"_5":21387,"_28235":196736,"_5797":196839},[],"`POST /updates/v1/groups/:groupID/distribution-sets` con `modules: [{\"source_module_id\": \"<id>\"}]`. El paquete se crea ya construido.",{"_6892":121395,"_42174":121353,"_29767":196841,"_5":21387,"_28235":196736,"_5797":88583},[],{"_6892":121396,"_42174":121353,"_29767":196843,"_5":21387,"_28235":196736,"_5797":196844},[],"Cómo queda construido el módulo",{"_6892":121397,"_42174":121353,"_29767":196846,"_5":21387,"_28235":196736,"_5797":196847},[],"Se une a paquetes con",{"_6892":121398,"_42174":121353,"_29767":196849,"_5":21387,"_28235":196736,"_5797":88592},[],{"_6892":121399,"_42174":121353,"_29767":196851,"_5":21387,"_28235":196736,"_5797":196852},[],"Sube su sw-description con `POST /softwaremodules/by-id/:moduleID/descriptor` y después `POST /softwaremodules/by-id/:moduleID/build`. Necesita `swugenerator_path`: sin ella la construcción responde `501`. Los campos de firma y cifrado van en el cuerpo de la construcción.",{"_6892":121400,"_42174":121353,"_29767":196854,"_5":21387,"_28235":196736,"_5797":196855},[],"`swu` (por defecto) o `non-swu`",{"_6892":121401,"_42174":121353,"_29767":196857,"_5":21387,"_28235":196736,"_5797":88601},[],{"_6892":121402,"_42174":121353,"_29767":196859,"_5":21387,"_28235":196736,"_5797":196860},[],"Sube el `.swu` terminado: subirlo construye el módulo. Llamar a build responde `400`.",{"_6892":121403,"_42174":121353,"_29767":196862,"_5":21387,"_28235":196736,"_5797":85703},[],{"_6892":121404,"_42174":121353,"_29767":196864,"_5":21387,"_28235":196736,"_5797":88609},[],{"_6892":121405,"_42174":121353,"_29767":196866,"_5":21387,"_28235":196736,"_5797":196867},[],"`POST .../build` cifra (clave compartida) y/o firma los ficheros; con ninguna de las dos cosas, los ficheros se entregan sin cambios y el servicio registra una advertencia. Varios ficheros se archivan en `<name>.tar.gz`. Un entregable cifrado recibe el sufijo `.enc`; una firma añade `<file>.sha256` y `<file>.sha256.sig`.",{"_6892":121406,"_42174":121353,"_29767":196869,"_5":21387,"_28235":196736,"_5797":85712},[],{"_6892":121407,"_42174":121353,"_29767":196871,"_5":21387,"_28235":196736,"_5797":88617},[],{"_6892":121408,"_42174":121353,"_29767":196873,"_5":21387,"_28235":196736,"_5797":196874},[],"No se puede construir ni enlazar. Elige antes un intent con `PUT /softwaremodules/by-id/:moduleID`.",{"_6892":121409,"_42174":121353,"_29767":196876,"_5":21387,"_28235":196736,"_5797":153767},[],{"_6892":121410,"_42174":121353,"_29767":196878,"_5":21387,"_28235":196736,"_5797":196879},[],"Una construcción **sustituye** los ficheros de entrada del módulo por el entregable, así que un módulo construido no se puede construir otra vez: publica una versión nueva del módulo.",{"_6892":121411,"_42174":121353,"_29767":196881,"_5":21387,"_28235":196736,"_5797":196882},[],"Las operaciones que no tienen sentido para un paquete construido y congelado responden así:",{"_6892":121412,"_42174":121353,"_29767":196884,"_5":21387,"_28235":196736,"_5797":196527},[],{"_6892":121413,"_42174":121353,"_29767":196886,"_5":21387,"_28235":196736,"_5797":196887},[],"Respuesta",{"_6892":121414,"_42174":121353,"_29767":196889,"_5":21387,"_28235":196736,"_5797":196890},[],"`POST .../distribution-sets/:name/swu` y `.../package`",{"_6892":121415,"_42174":121353,"_29767":196892,"_5":21387,"_28235":196736,"_5797":196893},[],"`501`: construye los módulos en el catálogo.",{"_6892":121416,"_42174":121353,"_29767":196895,"_5":21387,"_28235":196736,"_5797":196896},[],"`.../swu/upload` y `.../package/upload`",{"_6892":121417,"_42174":121353,"_29767":196898,"_5":21387,"_28235":196736,"_5797":196899},[],"`409`: un paquete de hawkBit siempre está ya construido.",{"_6892":121418,"_42174":121353,"_29767":196901,"_5":21387,"_28235":196736,"_5797":196902},[],"Enlazar un artefacto a un paquete, subir sw-description, descriptor de módulo, construir módulo, borrar artefacto, todos con ámbito de paquete",{"_6892":121419,"_42174":121353,"_29767":196904,"_5":21387,"_28235":196736,"_5797":196905},[],"`400`: un módulo enlazado está congelado. Desenlázalo, cámbialo y constrúyelo en el catálogo, y enlázalo de nuevo.",{"_6892":121420,"_42174":121353,"_29767":196907,"_5":21387,"_28235":196736,"_5797":196908},[],"Crear un módulo dentro de un paquete",{"_6892":121421,"_42174":121353,"_29767":196910,"_5":21387,"_28235":196736,"_5797":196911},[],"No es posible. Créalo en el catálogo.",{"_6892":121422,"_42174":121353,"_29767":196913,"_5":21387,"_28235":196736,"_5797":196914},[],"Cambiar la composición de un paquete ya asignado a dispositivos",{"_6892":121423,"_42174":121353,"_29767":196916,"_5":21387,"_28235":196736,"_5797":196917},[],"`400`: crea una versión nueva.",{"_6892":121424,"_42174":121353,"_29767":196919,"_5":21387,"_28235":196736,"_5797":196920},[],"Consulta la guía de publicación y despliegue para el procedimiento completo.",{"_6892":121425,"_42174":121353,"_29767":196922,"_5":21387,"_28235":196740,"_5797":88669},[],{"_6892":121426,"_42174":121353,"_29767":196924,"_5":21387,"_28235":196740,"_5797":85304},[],{"_6892":121427,"_42174":121353,"_29767":196926,"_5":21387,"_28235":196740,"_5797":196927},[],"Versión de un paquete de actualización",{"_6892":121428,"_42174":121353,"_29767":196929,"_5":21387,"_28235":196740,"_5797":196930},[],"Distribution set. Cada versión es su propio distribution set.",{"_6892":121429,"_42174":121353,"_29767":196932,"_5":21387,"_28235":196740,"_5797":194000},[],{"_6892":121430,"_42174":121353,"_29767":196934,"_5":21387,"_28235":196740,"_5797":85620},[],{"_6892":121431,"_42174":121353,"_29767":196936,"_5":21387,"_28235":196740,"_5797":196937},[],"Artefacto de módulo",{"_6892":121432,"_42174":121353,"_29767":196939,"_5":21387,"_28235":196740,"_5797":196940},[],"Artefacto del software module",{"_6892":121433,"_42174":121353,"_29767":196942,"_5":21387,"_28235":196740,"_5797":190034},[],{"_6892":121434,"_42174":121353,"_29767":196944,"_5":21387,"_28235":196740,"_5797":196945},[],"Target. El controller ID es el ID del dispositivo.",{"_6892":121435,"_42174":121353,"_29767":196947,"_5":21387,"_28235":196740,"_5797":194016},[],{"_6892":121436,"_42174":121353,"_29767":196949,"_5":21387,"_28235":196740,"_5797":196950},[],"Etiqueta de target `group:<id>`",{"_6892":121437,"_42174":121353,"_29767":196952,"_5":21387,"_28235":196740,"_5797":196953},[],"Lanzamiento (campaña)",{"_6892":121438,"_42174":121353,"_29767":196955,"_5":21387,"_28235":196740,"_5797":196956},[],"Rollout (estático)",{"_6892":121439,"_42174":121353,"_29767":196958,"_5":21387,"_28235":196740,"_5797":196959},[],"Trabajo por dispositivo",{"_6892":121440,"_42174":121353,"_29767":196961,"_5":21387,"_28235":196740,"_5797":196962},[],"Acción del rollout",{"_6892":121441,"_42174":121353,"_29767":196964,"_5":21387,"_28235":196740,"_5797":196965},[],"Lanzamiento programado",{"_6892":121442,"_42174":121353,"_29767":196967,"_5":21387,"_28235":196740,"_5797":196968},[],"La hora de inicio del rollout (la arranca el planificador de hawkBit)",{"_6892":121443,"_42174":121353,"_29767":196970,"_5":21387,"_28235":196744,"_5797":196971},[],"hawkBit almacena los paquetes, los rollouts y los trabajos. El servicio sigue necesitando Postgres (la base de datos `updates`) para lo que hawkBit no tiene equivalente: subidas de artefactos en tránsito y alias, sw-descriptions, manifiestos de conjunto firmados, rollouts cancelados y fijaciones de última versión declaradas. Guardarlos en Postgres, y no en memoria, es lo que permite ejecutar varias réplicas con seguridad.",{"_6892":121444,"_42174":121353,"_29767":196973,"_5":21387,"_28235":196744,"_5797":196974},[],"**Las sw-descriptions** viven en Postgres, no en los metadatos de hawkBit, porque hawkBit limita el valor de un metadato a 4000 caracteres. Los descriptores escritos allí por versiones anteriores se siguen leyendo.",{"_6892":121445,"_42174":121353,"_29767":196976,"_5":21387,"_28235":196744,"_5797":196977},[],"**Las filas están acotadas a una instancia de hawkBit.** Los ids de hawkBit se repiten entre servidores y tras vaciar su base de datos, así que el servicio marca el hawkBit con el que habla con una etiqueta (una etiqueta de distribution set llamada `lamassu:instance`) e ignora las filas que pertenecen a otra instancia. No borres esa etiqueta.",{"_6892":121446,"_42174":121353,"_29767":196979,"_5":21387,"_28235":196744,"_5797":196980},[],"**Las subidas en tránsito son pesadas.** `POST /updates/v1/artifacts` (la subida global de artefactos) lee el fichero entero en memoria y lo guarda en Postgres durante 30 minutos salvo que un paquete lo enlace, y el modo hawkBit se niega a enlazar ficheros a paquetes. Para ficheros grandes, sube siempre por la ruta de catálogo de la sección anterior, que transmite a hawkBit en streaming.",{"_6892":121447,"_42174":121353,"_29767":196982,"_5":21387,"_28235":196748,"_5797":196983},[],"Los dispositivos consultan a hawkBit, no a este servicio. Un paquete lanzado contra un hawkBit sin targets registrados no lo descarga nada.",{"_6892":121448,"_42174":121353,"_29767":196985,"_5":21387,"_28235":196748,"_5797":196986},[],"Con `dms_endpoint` definido, cada lectura de los dispositivos de un grupo crea los targets que falten (controller ID = ID del dispositivo) y los etiqueta `group:<id>`. Un dispositivo que no se puede reconciliar queda excluido de esa lectura y se registra. Sin `dms_endpoint`, los grupos son las etiquetas `group:<id>` existentes.",{"_6892":121449,"_42174":121353,"_29767":196988,"_5":21387,"_28235":196748,"_5797":196989},[],"El primer lanzamiento con un `test_device_id` (canario) falla con `test device X cannot act as this group's canary` hasta que los dispositivos del grupo existen en hawkBit. Ejecuta antes una simulación (`POST .../launch?dry_run=true`), que los registra.",{"_6892":121450,"_42174":121353,"_29767":196991,"_5":21387,"_28235":196752,"_5797":196992},[],"Es hawkBit quien decide cómo se autentican los dispositivos, no este servicio. hawkBit 1.1.0 no tiene modo anónimo: un despliegue debe habilitar al menos uno entre el token de seguridad del target, el token de seguridad de gateway o el autenticador por cabecera de proxy inverso (`X-Controller-Id` más `X-Authority`). Elige uno y habilítalo como ajuste del tenant de hawkBit; una instalación con todos desactivados responde `401` a todos los dispositivos. Recomendado en producción:",{"_6892":121451,"_42174":121353,"_29767":196994,"_5":21387,"_28235":196752,"_5797":196995},[],"Termina el mTLS de los dispositivos en un gateway, haz que fije las cabeceras del autenticador por cabecera a partir del certificado del dispositivo, y deja que hawkBit confíe en esas cabeceras solo desde las direcciones del gateway (el ajuste de proxies de confianza de hawkBit). Cualquier cosa que alcance hawkBit directamente podría, si no, suplantar a cualquier dispositivo.",{"_6892":121452,"_42174":121353,"_29767":196997,"_5":21387,"_28235":196752,"_5797":196998},[],"O habilita los tokens de seguridad de target (`authentication.targettoken.enabled`) y configura cada dispositivo con su propio token; SWUpdate lo envía como `Authorization: TargetToken <token>`.",{"_6892":121453,"_42174":121353,"_29767":197000,"_5":21387,"_28235":196752,"_5797":197001},[],"No expongas nunca la API de gestión a los dispositivos. Usa una contraseña robusta para el usuario de la API de gestión (`HAWKBIT_SECURITY_USER_ADMIN_PASSWORD` en la imagen) y sírvela por HTTPS. Si el gateway publica el DDI bajo un prefijo de ruta, define `hawkbit.ddi_url` con la URL pública del DDI para que los enlaces de artefactos que reciben los dispositivos sean alcanzables.",{"_6892":121454,"_42174":121353,"_29767":197003,"_5":21387,"_28235":196756,"_5797":197004},[],"Por defecto hawkBit guarda los bytes de los artefactos en su propio sistema de ficheros. El directorio `docker/hawkbit` del repositorio construye una imagen de hawkBit con un **plugin de almacenamiento de artefactos en S3**, que se selecciona con `HAWKBIT_ARTIFACT_STORAGE=s3` (`fs` es el valor por defecto) y las variables `HAWKBIT_ARTIFACT_S3_*` (bucket, endpoint, región, acceso path-style, prefijo de claves; las credenciales vienen de la cadena de credenciales por defecto de AWS). hawkBit se niega a arrancar si se selecciona S3 pero el bucket no es alcanzable: nunca recurre en silencio al disco local. Los metadatos permanecen en Postgres en ambos casos. El plugin y sus instrucciones de construcción y pruebas están en `docker/hawkbit`; la imagen se construye en local y no se publica en ningún registro.",{"_6892":121455,"_42174":121353,"_29767":197006,"_5":21387,"_28235":196756,"_5797":197007},[],"Con el plugin y `hawkbit.artifact_store.presign` configurados, las descargas de artefactos de módulo se responden con `302` a una URL firmada de corta duración del bucket, en lugar de transmitirse a través de hawkBit o de este servicio. Los dispositivos conservan el enlace de artefacto que les dio hawkBit: el adaptador sirve esa ruta DDI (`<ddi path>/:tenant/controller/v1/:controllerId/softwaremodules/:id/artifacts/:filename`), comprueba que el módulo está asignado o instalado en ese dispositivo (si no, `404`) y redirige. Para que esto funcione, el gateway debe encaminar esa ruta a Lamassu Updates y el resto del DDI a hawkBit. Consulta Configuración y Seguridad.",{"_6892":121456,"_42174":121353,"_29767":197009,"_5":21387,"_28235":196756,"_5797":197010},[],"hawkBit tiene sus propios límites de artefactos. La imagen de este repositorio los sube a 11 GiB por fichero y 1 TiB en total, para coincidir con el `max_artifact_size_mb` por defecto de 10 GiB (`SPRING_SERVLET_MULTIPART_MAXFILESIZE`, `SPRING_SERVLET_MULTIPART_MAXREQUESTSIZE`, `HAWKBIT_SERVER_SECURITY_DOS_MAXARTIFACTSIZE` y `HAWKBIT_SERVER_SECURITY_DOS_MAXARTIFACTSTORAGE`). Con hawkBit estándar el límite es de 1 GiB por fichero y 20 GiB en total. hawkBit escribe primero la subida en un fichero temporal, así que dale ese espacio libre en disco.",{"_6892":121457,"_42174":121353,"_29767":197012,"_5":21387,"_28235":196756,"_5797":197013},[],"La imagen de hawkBit dimensiona su JVM con las variables de entorno `X_MS` y `X_MX` (por defecto `768m` cada una), además de `XX_MAX_METASPACE_SIZE`, `XSS` y `GC`. `JAVA_OPTS` no fija el heap. Reducir `X_MX` baja el techo, no el uso de memoria en régimen estable.",{"_6892":121458,"_42174":121353,"_29767":197015,"_5":21387,"_28235":196760,"_5797":186881},[],{"_6892":121459,"_42174":121353,"_29767":197017,"_5":21387,"_28235":196760,"_5797":197018},[],"Modo `hawkbit`",{"_6892":121460,"_42174":121353,"_29767":197020,"_5":21387,"_28235":196760,"_5797":197021},[],"A quién consultan los dispositivos",{"_6892":121461,"_42174":121353,"_29767":197023,"_5":21387,"_28235":196760,"_5797":197024},[],"A hawkBit (DDI), no a este servicio.",{"_6892":121462,"_42174":121353,"_29767":197026,"_5":21387,"_28235":196760,"_5797":197027},[],"Capacidades",{"_6892":121463,"_42174":121353,"_29767":197029,"_5":21387,"_28235":196760,"_5797":197030},[],"No existen todas las funciones del modo native. `GET /updates/v1/capabilities` lista lo que soporta el backend activo: en modo `hawkbit` no hay workflows personalizados, ni edición de la estrategia tras la creación, ni cierre anticipado de una campaña, ni añadir dispositivos a una campaña en curso, ni eventos push, ni cifrado por dispositivo. Consulta Capacidades.",{"_6892":121464,"_42174":121353,"_29767":197032,"_5":21387,"_28235":196760,"_5797":197033},[],"Cifrado",{"_6892":121465,"_42174":121353,"_29767":197035,"_5":21387,"_28235":196760,"_5797":197036},[],"**Solo clave compartida.** Un distribution set sirve artefactos idénticos a todos los targets, así que no hay dónde poner una carga distinta por dispositivo. Usa el modo `native` para cifrado por dispositivo.",{"_6892":121466,"_42174":121353,"_29767":197038,"_5":21387,"_28235":196760,"_5797":197039},[],"Paquetes con varios módulos",{"_6892":121467,"_42174":121353,"_29767":197041,"_5":21387,"_28235":196760,"_5797":197042},[],"Cada módulo tiene su propio entregable, así que un paquete con varios módulos se instala como **varias transacciones SWUpdate independientes**. SWUpdate no puede revertir entre varios ficheros `.swu`. Consulta Conceptos.",{"_6892":121468,"_42174":121353,"_29767":197044,"_5":21387,"_28235":196760,"_5797":197045},[],"Nombres",{"_6892":121469,"_42174":121353,"_29767":197047,"_5":21387,"_28235":196760,"_5797":197048},[],"hawkBit borra los módulos de software de forma lógica (soft-delete), así que el nombre y la versión de un módulo que alguna vez se asignó a un dispositivo quedan ocupados para siempre. Sube la versión.",{"_6892":121470,"_42174":121353,"_29767":197050,"_5":21387,"_28235":196760,"_5797":197051},[],"Estrategia de lanzamiento",{"_6892":121471,"_42174":121353,"_29767":197053,"_5":21387,"_28235":196760,"_5797":197054},[],"Se lee de vuelta de los grupos del rollout, así que un lote fijo puede leerse como un porcentaje. No se puede editar tras la creación.",{"_6892":121472,"_42174":121353,"_29767":197056,"_5":21387,"_28235":196760,"_5797":197057},[],"Cambios concurrentes",{"_6892":121473,"_42174":121353,"_29767":197059,"_5":21387,"_28235":196760,"_5797":197060},[],"Construir o cambiar el mismo módulo desde dos peticiones responde `409` (`software module N is being built or changed by another request`).",{"_6892":121474,"_42174":121353,"_29767":197062,"_5":21387,"_28235":196760,"_5797":196765},[],{"_6892":121475,"_42174":121353,"_29767":197064,"_5":21387,"_28235":196760,"_5797":197065},[],"hawkBit es su propio servicio con su propia base de datos. El chart de Helm de este repositorio no lo despliega ni lo gestiona.",{"_6892":121476,"_42174":121353,"_29767":197067,"_5":21387,"_28235":196764,"_5797":197068},[],"En modo `hawkbit` no se elige líder y no hay ficheros locales que compartir, así que puede ejecutarse cualquier número de réplicas: el estado está en Postgres y en hawkBit, y las operaciones de módulos y lanzamientos toman bloqueos de Postgres. Si usas cifrado con clave compartida, pon el almacén de claves de SymKMS (`symkms.storage`) en almacenamiento compartido o en S3. Consulta Operaciones.",{"_6892":121477,"_42174":121477,"_5":21817,"_5797":197070,"_42654":197071,"_29767":197072,"_28235":121477},"Limitaciones y problemas conocidos",[77248,187247,193621,187007],[],{"_6892":121478,"_42174":121477,"_29767":197074,"_5":21387,"_28235":121477,"_5797":197075},[],"Lo que Lamassu Updates no soporta o aún no hace, reunido en un solo lugar y con la página que explica cada punto.",{"_6892":121479,"_42174":121477,"_5":42651,"_29767":197077,"_28235":197078,"_5797":195585},[],"/docs/pr-preview/pr-56/es/platform/updates/limitations#seguridad",{"_6892":121480,"_42174":121477,"_5":42651,"_29767":197080,"_28235":197081,"_5797":88829},[],"/docs/pr-preview/pr-56/es/platform/updates/limitations#backends",{"_6892":121481,"_42174":121477,"_5":42651,"_29767":197083,"_28235":197084,"_5797":197085},[],"/docs/pr-preview/pr-56/es/platform/updates/limitations#paquetes-y-versiones","Paquetes y versiones",{"_6892":121482,"_42174":121477,"_5":42651,"_29767":197087,"_28235":197088,"_5797":197089},[],"/docs/pr-preview/pr-56/es/platform/updates/limitations#escalado-y-recursos","Escalado y recursos",{"_6892":121483,"_42174":121477,"_5":42651,"_29767":197091,"_28235":197092,"_5797":197093},[],"/docs/pr-preview/pr-56/es/platform/updates/limitations#firma-y-cifrado","Firma y cifrado",{"_6892":121484,"_42174":121477,"_5":42651,"_29767":197095,"_28235":197096,"_5797":197097},[],"/docs/pr-preview/pr-56/es/platform/updates/limitations#despliegue-y-configuración","Despliegue y configuración",{"_6892":121485,"_42174":121477,"_5":42651,"_29767":197099,"_28235":197100,"_5797":187063},[],"/docs/pr-preview/pr-56/es/platform/updates/limitations#observabilidad",{"_6892":121486,"_42174":121477,"_29767":197102,"_5":21387,"_28235":121477,"_5797":197103},[],"Esta página reúne lo que no está soportado, está soportado en parte o resulta sorprendente, para que lo compruebes antes de diseñar un despliegue. Cada punto indica la página que lo explica.",{"_6892":121487,"_42174":121477,"_29767":197105,"_5":21387,"_28235":197078,"_5797":197106},[],"El servicio no tiene autenticación, autorización, TLS ni mTLS. Usa un gateway. Consulta Seguridad.",{"_6892":121488,"_42174":121477,"_29767":197108,"_5":21387,"_28235":197078,"_5797":197109},[],"Las claves `app.server.cert_file`, `key_file` y `authentication.mutual_tls.*` no tienen efecto.",{"_6892":121489,"_42174":121477,"_29767":197111,"_5":21387,"_28235":197078,"_5797":197112},[],"La conexión a Postgres usa siempre `sslmode=disable`. En modo `native` el servicio no verifica el certificado TLS del KMS, y el script firmante de SWU llama a `curl -k`.",{"_6892":121490,"_42174":121477,"_29767":197114,"_5":21387,"_28235":197078,"_5797":197115},[],"El servicio envía la identidad fija `X-Principal-ID: admin-mode` al Device Manager y al KMS, y sus llamadas a SymKMS no llevan credencial.",{"_6892":121491,"_42174":121477,"_29767":197117,"_5":21387,"_28235":197078,"_5797":197118},[],"No hay limitación de tasa de peticiones.",{"_6892":121492,"_42174":121477,"_29767":197120,"_5":21387,"_28235":197081,"_5797":197121},[],"Los dos backends difieren en funciones. Consulta Capacidades. En particular, el modo `hawkbit` no tiene cifrado por dispositivo, ni workflows personalizados, ni edición de la estrategia de un lanzamiento tras su creación, ni cierre anticipado de una campaña, ni añadir dispositivos a una campaña en curso, ni eventos push, ni subida de un precompilado a nivel de conjunto. Un módulo de catálogo `swu-prebuilt` sí acepta un `.swu` terminado. El modo `native` construye un entregable por paquete y no tiene entregables por módulo.",{"_6892":121493,"_42174":121477,"_29767":197123,"_5":21387,"_28235":197081,"_5797":197124},[],"En modo `hawkbit`, un paquete con varios módulos se instala como varias transacciones SWUpdate independientes. SWUpdate no puede revertir entre varios ficheros `.swu`.",{"_6892":121494,"_42174":121477,"_29767":197126,"_5":21387,"_28235":197081,"_5797":197127},[],"hawkBit reserva el nombre y la versión de un módulo que alguna vez se asignó a un dispositivo. Sube la versión.",{"_6892":121495,"_42174":121477,"_29767":197129,"_5":21387,"_28235":197081,"_5797":197130},[],"En modo `hawkbit`, una construcción de módulo sustituye los ficheros de entrada del módulo por el entregable, así que un módulo no se puede construir dos veces: publica una versión nueva.",{"_6892":121496,"_42174":121477,"_29767":197132,"_5":21387,"_28235":197081,"_5797":197133},[],"Los rollouts de hawkBit se crean estáticos: los dispositivos añadidos a un grupo después de crear un lanzamiento no los recoge ese lanzamiento.",{"_6892":121497,"_42174":121477,"_29767":197135,"_5":21387,"_28235":197081,"_5797":197136},[],"El modo `hawkbit` lee la estrategia de un lanzamiento de los grupos del rollout, así que un lanzamiento creado con un lote fijo puede leerse como un porcentaje.",{"_6892":121498,"_42174":121477,"_29767":197138,"_5":21387,"_28235":197081,"_5797":197139},[],"Un primer lanzamiento en modo `hawkbit` con un `test_device_id` falla hasta que los dispositivos del grupo existen en hawkBit. Consulta Resolución de problemas.",{"_6892":121499,"_42174":121477,"_29767":197141,"_5":21387,"_28235":197081,"_5797":197142},[],"`POST /updates/v1/artifacts` en modo `hawkbit` mantiene el fichero entero en memoria y en Postgres durante 30 minutos y no se puede enlazar a un paquete. Sube por la ruta de catálogo en su lugar. Consulta Modo hawkBit.",{"_6892":121500,"_42174":121477,"_29767":197144,"_5":21387,"_28235":197081,"_5797":197145},[],"Los límites de artefactos propios de hawkBit (1 GiB por fichero, 20 GiB en total) se aplican salvo que uses la imagen de este repositorio o los subas. La imagen con el plugin S3 de artefactos se construye desde `docker/hawkbit` y no se publica en ningún registro.",{"_6892":121501,"_42174":121477,"_29767":197147,"_5":21387,"_28235":197084,"_5797":197148},[],"**Una versión nueva de un paquete `native` hereda los ajustes de cifrado de la versión anterior en las construcciones de `.swu`.** `POST .../new` los copia, y una construcción de `.swu` sin campos de cifrado no los borra. Tras una construcción por dispositivo, todas las versiones posteriores de ese paquete siguen informando `per-device`, conservan los `uncovered_devices` antiguos y las descargas de los dispositivos fallan con `404` (`SWU not available for device ...`). Usa un paquete distinto para cada variante de cifrado. (Las construcciones `.../package` restablecen estos campos.)",{"_6892":121502,"_42174":121477,"_29767":197150,"_5":21387,"_28235":197084,"_5797":197151},[],"`POST .../new` no arrastra la sw-description del paquete: cada versión necesita su propia subida.",{"_6892":121503,"_42174":121477,"_29767":197153,"_5":21387,"_28235":197084,"_5797":197154},[],"**Los nombres de artefacto son globales.** Un nombre solo se puede reutilizar con una `version` mayor, y la API responde una infracción con `500`, no con un `4xx`.",{"_6892":121504,"_42174":121477,"_29767":197156,"_5":21387,"_28235":197084,"_5797":197157},[],"Una versión construida es inmutable. Para cambiarla, crea una versión nueva.",{"_6892":121505,"_42174":121477,"_29767":197159,"_5":21387,"_28235":197088,"_5797":197160},[],"Con almacenamiento local en un único volumen `ReadWriteOnce`, solo puede ejecutarse una réplica `native`. Pasa `artifacts`, `builds` y `symkms` a S3 para escalar. Consulta Operaciones.",{"_6892":121506,"_42174":121477,"_29767":197162,"_5":21387,"_28235":197088,"_5797":197163},[],"Las claves de SymKMS también usan almacenamiento local por defecto: apunta `symkms.storage` a S3, o comparte un volumen, o se pierden.",{"_6892":121507,"_42174":121477,"_29767":197165,"_5":21387,"_28235":197088,"_5797":197166},[],"Las construcciones por dispositivo están limitadas por CPU y crecen con el número de dispositivos. Consulta Firma y cifrado.",{"_6892":121508,"_42174":121477,"_29767":197168,"_5":21387,"_28235":197088,"_5797":197169},[],"Cifrar necesita el fichero en memoria (`swugenerator`, los paquetes AES-GCM y los módulos raw, y cualquier almacén con cifrado en reposo), así que los ficheros cifrados muy grandes necesitan memoria proporcionalmente grande. Firmar un módulo raw transmite el fichero en streaming.",{"_6892":121509,"_42174":121477,"_29767":197171,"_5":21387,"_28235":197088,"_5797":197172},[],"Cada subida en curso necesita disco temporal libre del tamaño del fichero.",{"_6892":121510,"_42174":121477,"_29767":197174,"_5":21387,"_28235":197092,"_5797":197175},[],"La firma necesita un KMS que devuelva CMS (`PKCS7 SignedData`). El servicio rechaza una respuesta que no sea CMS cuando firma manifiestos y sumas de verificación de módulos raw, pero el script firmante de SWU no lo comprueba: con un KMS sin soporte CMS una construcción de `.swu` puede salir bien y aun así ser rechazada por un dispositivo que define `public-key-file`. Consulta Firma y cifrado.",{"_6892":121511,"_42174":121477,"_29767":197177,"_5":21387,"_28235":197092,"_5797":197178},[],"Los paquetes `non-swu` y los módulos raw son siempre AES-GCM, sea cual sea el nombre de algoritmo que envíes, y para ellos se rechaza una clave Ascon-80pq.",{"_6892":121512,"_42174":121477,"_29767":197180,"_5":21387,"_28235":197092,"_5797":197181},[],"SymKMS no aplica propósitos de clave: se acepta cualquier propósito y uno vacío es un comodín (un marcador de posición intencionado). Rechaza un IV aportado por quien llama para GCM, CTR y Ascon.",{"_6892":121513,"_42174":121477,"_29767":197183,"_5":21387,"_28235":197092,"_5797":197184},[],"Los nombres de algoritmo no se normalizan de extremo a extremo: SymKMS ignora mayúsculas y `_` frente a `-`, pero `swugenerator` necesita guiones (`aes-256-gcm`), y `ascon128a` no es `ASCON-128A`.",{"_6892":121514,"_42174":121477,"_29767":197186,"_5":21387,"_28235":197096,"_5797":197187},[],"`app.server.protocol`, `app.server.log_level`, `app.server.health_check` y el `health_check_logging` de los ejemplos se aceptan pero no se leen. El registro de peticiones está siempre activado.",{"_6892":121515,"_42174":121477,"_29767":197189,"_5":21387,"_28235":197096,"_5797":197190},[],"La base de datos se llama siempre `updates`, y el servicio no la crea.",{"_6892":121516,"_42174":121477,"_29767":197192,"_5":21387,"_28235":197096,"_5797":197193},[],"Los ficheros de configuración de ejemplo contienen valores de una máquina de desarrollo y secretos de desarrollo.",{"_6892":121517,"_42174":121477,"_29767":197195,"_5":21387,"_28235":197096,"_5797":197196},[],"El valor por defecto de `config.update_domain` en el chart de Helm (`http://updates:10090/v1/`) carece del prefijo `/updates`: el valor debe ser la base completa de la API terminada en `/updates/v1/`, o las URLs de descarga no resuelven.",{"_6892":121518,"_42174":121477,"_29767":197198,"_5":21387,"_28235":197096,"_5797":197199},[],"El chart de Helm declara valores `postgresql.*` e `ingress.*` pero no despliega PostgreSQL y no tiene plantilla de ingress. Usa siempre la estrategia `Recreate`, vuelca todo `config` (contraseñas incluidas) en un ConfigMap y no tiene valores para añadir variables de entorno, volúmenes ni un Secret existente.",{"_6892":121519,"_42174":121477,"_29767":197201,"_5":21387,"_28235":197096,"_5797":197202},[],"La imagen de contenedor no reduce privilegios, e incluye un `config.yml` de desarrollo: monta el tuyo.",{"_6892":121520,"_42174":121477,"_29767":197204,"_5":21387,"_28235":197096,"_5797":197205},[],"Para construir tú mismo la imagen Docker, el contexto de construcción debe contener los checkouts de `lamassuiot/core` y `lamassuiot/sdk` junto a `ota/`.",{"_6892":121521,"_42174":121477,"_29767":197207,"_5":21387,"_28235":197096,"_5797":197208},[],"`GET /health` no comprueba la base de datos, WFX ni hawkBit.",{"_6892":121522,"_42174":121477,"_29767":197210,"_5":21387,"_28235":197100,"_5797":197211},[],"El servicio no exporta trazas, métricas ni registros, y no tiene endpoint de métricas. Consulta Operaciones.",{"_6892":121523,"_42174":121523,"_5":21817,"_5797":197213,"_42654":197214,"_29767":197215,"_28235":121523},"Operaciones",[77248,187247,193621,187007],[],{"_6892":121524,"_42174":121523,"_29767":197217,"_5":21387,"_28235":121523,"_5797":197218},[],"Despliega Lamassu Updates con Docker Compose o Helm, escálalo, dimensiónalo, obsérvalo, haz copias de seguridad y actualízalo.",{"_6892":121525,"_42174":121523,"_5":42651,"_29767":197220,"_28235":197221,"_5797":185835},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#despliegue",{"_6892":121526,"_42174":121523,"_5":42651,"_29767":197223,"_28235":197224,"_5797":197225},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#la-imagen-de-contenedor","La imagen de contenedor",{"_6892":121527,"_42174":121523,"_5":42651,"_29767":197227,"_28235":197228,"_5797":88977},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#docker-compose",{"_6892":121528,"_42174":121523,"_5":42651,"_29767":197230,"_28235":197231,"_5797":78310},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#helm",{"_6892":121529,"_42174":121523,"_5":42651,"_29767":197233,"_28235":197234,"_5797":197235},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#secretos-con-helm","Secretos con Helm",{"_6892":121530,"_42174":121523,"_5":42651,"_29767":197237,"_28235":197238,"_5797":197239},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#escalar-horizontalmente","Escalar horizontalmente",{"_6892":121531,"_42174":121523,"_5":42651,"_29767":197241,"_28235":197242,"_5797":197243},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#dimensionado-de-recursos","Dimensionado de recursos",{"_6892":121532,"_42174":121523,"_5":42651,"_29767":197245,"_28235":197246,"_5797":197247},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#tamaño-de-subida-y-proxies","Tamaño de subida y proxies",{"_6892":121533,"_42174":121523,"_5":42651,"_29767":197249,"_28235":197250,"_5797":197251},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#salud-registro-y-apagado","Salud, registro y apagado",{"_6892":121534,"_42174":121523,"_5":42651,"_29767":197253,"_28235":197254,"_5797":187063},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#observabilidad",{"_6892":121535,"_42174":121523,"_5":42651,"_29767":197256,"_28235":197257,"_5797":197258},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#copias-de-seguridad-y-restauración","Copias de seguridad y restauración",{"_6892":121536,"_42174":121523,"_5":42651,"_29767":197260,"_28235":197261,"_5797":193621},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#actualizaciones",{"_6892":121537,"_42174":121523,"_5":42651,"_29767":197263,"_28235":197264,"_5797":197265},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#haz-una-copia-de-seguridad","Haz una copia de seguridad",{"_6892":121538,"_42174":121523,"_5":42651,"_29767":197267,"_28235":197268,"_5797":197269},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#despliega-la-imagen-nueva","Despliega la imagen nueva",{"_6892":121539,"_42174":121523,"_5":42651,"_29767":197271,"_28235":197272,"_5797":197273},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#verifica","Verifica",{"_6892":121540,"_42174":121523,"_5":42651,"_29767":197275,"_28235":197276,"_5797":197277},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#operaciones-de-hawkbit","Operaciones de hawkBit",{"_6892":121541,"_42174":121523,"_5":42651,"_29767":197279,"_28235":197280,"_5797":197281},[],"/docs/pr-preview/pr-56/es/platform/updates/operations#lista-de-comprobación-de-seguridad","Lista de comprobación de seguridad",{"_6892":121542,"_42174":121523,"_29767":197283,"_5":21387,"_28235":121523,"_5797":197284},[],"Esta página es para quien opera el servicio: cómo desplegarlo, qué poner a su alrededor, cómo se comporta con varias réplicas, qué respaldar y cómo actualizarlo. Las claves de configuración están en la referencia de configuración; el modelo de amenazas, en Seguridad.",{"_6892":121543,"_42174":121523,"_29767":197286,"_5":21387,"_28235":197224,"_5797":197287},[],"Las imágenes de release se publican en `ghcr.io/lamassuiot/ota`. La imagen ejecuta un único proceso, el monolito (la API de Updates y SymKMS), en el puerto `10090`. Contiene la herramienta `swugenerator`, los scripts firmantes (`/app/sign_kms.sh`) y los ficheros de workflow de WFX (`/app/wfx/workflow/dau/`). No define un usuario sin privilegios.",{"_6892":121544,"_42174":121523,"_29767":197289,"_5":21387,"_28235":197224,"_5797":197290},[],"La imagen incluye el `config.yml` de desarrollo del repositorio en `/etc/lamassuiot/config.yml`: monta siempre tu propio fichero encima, o apunta `OTA_CONFIG_FILE` al tuyo (consulta cómo se carga la configuración). Para construir tú mismo la imagen, el Dockerfile espera que su contexto sea el directorio padre del checkout de `ota`, que además debe contener `lamassuiot/core` y `lamassuiot/sdk`.",{"_6892":121545,"_42174":121523,"_29767":197292,"_5":21387,"_28235":197228,"_5797":197293},[],"`docker-compose.yml` es para uso local y de demostración. Necesita la red externa `ota-net` (`docker network create ota-net`) y un fichero `.env` (copia `.env.example`; `HOST_IP` permite a los contenedores alcanzar Lamassu en el host). Define estos volúmenes con nombre:",{"_6892":121546,"_42174":121523,"_29767":197295,"_5":21387,"_28235":197228,"_5797":197296},[],"Volumen",{"_6892":121547,"_42174":121523,"_29767":197298,"_5":21387,"_28235":197228,"_5797":194285},[],{"_6892":121548,"_42174":121523,"_29767":197300,"_5":21387,"_28235":197228,"_5797":89050},[],{"_6892":121549,"_42174":121523,"_29767":197302,"_5":21387,"_28235":197228,"_5797":197303},[],"Datos de Postgres: las bases de datos `updates` y `hawkbit`, y la base `wfx` que guarda los trabajos de los dispositivos en modo `native`",{"_6892":121550,"_42174":121523,"_29767":197305,"_5":21387,"_28235":197228,"_5797":89056},[],{"_6892":121551,"_42174":121523,"_29767":197307,"_5":21387,"_28235":197228,"_5797":197308},[],"Espacio temporal de construcción y ficheros de actualización locales del servicio `updates`",{"_6892":121552,"_42174":121523,"_29767":197310,"_5":21387,"_28235":197228,"_5797":89062},[],{"_6892":121553,"_42174":121523,"_29767":197312,"_5":21387,"_28235":197228,"_5797":197313},[],"Material de claves de SymKMS",{"_6892":121554,"_42174":121523,"_29767":197315,"_5":21387,"_28235":197228,"_5797":89068},[],{"_6892":121555,"_42174":121523,"_29767":197317,"_5":21387,"_28235":197228,"_5797":197318},[],"Ficheros de artefactos de hawkBit, con `HAWKBIT_ARTIFACT_STORAGE=fs`",{"_6892":121556,"_42174":121523,"_29767":197320,"_5":21387,"_28235":197228,"_5797":89074},[],{"_6892":121557,"_42174":121523,"_29767":197322,"_5":21387,"_28235":197228,"_5797":197323},[],"El almacén S3 local, con `--profile s3`",{"_6892":121558,"_42174":121523,"_29767":197325,"_5":21387,"_28235":197228,"_5797":197326},[],"`docker compose --profile s3 up -d` arranca además RustFS (API S3 en el puerto `9000`) y un trabajo `s3-init` que crea un único bucket, `ota-updates`, con el cifrado del lado del servidor activado por defecto. Por convención cada backend usa un prefijo: `hawkbit/` para los artefactos de hawkBit y `ota/artifacts/` y `ota/builds/` para el modo `native`. Para guardar artefactos y compilaciones en S3, añade los bloques `artifacts` y `builds` que muestra `config.yml`, y define `HAWKBIT_ARTIFACT_STORAGE=s3` para hawkBit.",{"_6892":121559,"_42174":121523,"_29767":197328,"_5":21387,"_28235":197231,"_5797":197329},[],"El chart es `helm/updates-monolithic` del repositorio. Despliega solo el servicio `updates`: Postgres, WFX, Lamassu y, en modo `hawkbit`, hawkBit son externos.",{"_6892":121560,"_42174":121523,"_29767":197331,"_5":21387,"_28235":197231,"_5797":197332},[],"Valor",{"_6892":121561,"_42174":121523,"_29767":197334,"_5":21387,"_28235":197231,"_5797":197335},[],"Por defecto",{"_6892":121562,"_42174":121523,"_29767":197337,"_5":21387,"_28235":197231,"_5797":193986},[],{"_6892":121563,"_42174":121523,"_29767":197339,"_5":21387,"_28235":197231,"_5797":89093},[],{"_6892":121564,"_42174":121523,"_29767":197341,"_5":21387,"_28235":197231,"_5797":89096},[],{"_6892":121565,"_42174":121523,"_29767":197343,"_5":21387,"_28235":197231,"_5797":197344},[],"La imagen a ejecutar. Define `ghcr.io/lamassuiot/ota` y una etiqueta de release.",{"_6892":121566,"_42174":121523,"_29767":197346,"_5":21387,"_28235":197231,"_5797":89102},[],{"_6892":121567,"_42174":121523,"_29767":197348,"_5":21387,"_28235":197231,"_5797":89105},[],{"_6892":121568,"_42174":121523,"_29767":197350,"_5":21387,"_28235":197231,"_5797":197351},[],"Réplicas. Consulta Escalar horizontalmente.",{"_6892":121569,"_42174":121523,"_29767":197353,"_5":21387,"_28235":197231,"_5797":89111},[],{"_6892":121570,"_42174":121523,"_29767":197355,"_5":21387,"_28235":197231,"_5797":89114},[],{"_6892":121571,"_42174":121523,"_29767":197357,"_5":21387,"_28235":197231,"_5797":197358},[],"El chart no tiene plantilla de ingress: `ingress.*` en `values.yaml` no tiene efecto. Expón el servicio con tu propio ingress o gateway.",{"_6892":121572,"_42174":121523,"_29767":197360,"_5":21387,"_28235":197231,"_5797":89120},[],{"_6892":121573,"_42174":121523,"_29767":197362,"_5":21387,"_28235":197231,"_5797":197363},[],"límites `2000m` de CPU, `4Gi`; peticiones `500m`, `1Gi`",{"_6892":121574,"_42174":121523,"_29767":197365,"_5":21387,"_28235":197231,"_5797":197366},[],"Consulta Dimensionado de recursos.",{"_6892":121575,"_42174":121523,"_29767":197368,"_5":21387,"_28235":197231,"_5797":89129},[],{"_6892":121576,"_42174":121523,"_29767":197370,"_5":21387,"_28235":197231,"_5797":197371},[],"activado, `ReadWriteOnce`, `10Gi`",{"_6892":121577,"_42174":121523,"_29767":197373,"_5":21387,"_28235":197231,"_5797":197374},[],"El volumen montado en `/data`: espacio temporal de construcción y, por defecto, ficheros de actualización locales.",{"_6892":121578,"_42174":121523,"_29767":197376,"_5":21387,"_28235":197231,"_5797":89138},[],{"_6892":121579,"_42174":121523,"_29767":197378,"_5":21387,"_28235":197231,"_5797":89141},[],{"_6892":121580,"_42174":121523,"_29767":197380,"_5":21387,"_28235":197231,"_5797":197381},[],"Consulta Escalar horizontalmente. El chart inyecta `leader_election.mode` en la configuración por ti.",{"_6892":121581,"_42174":121523,"_29767":197383,"_5":21387,"_28235":197231,"_5797":89147},[],{"_6892":121582,"_42174":121523,"_29767":197385,"_5":21387,"_28235":197231,"_5797":197386},[],"consulta `values.yaml`",{"_6892":121583,"_42174":121523,"_29767":197388,"_5":21387,"_28235":197231,"_5797":197389},[],"Toda la configuración del servicio, volcada en un ConfigMap.",{"_6892":121584,"_42174":121523,"_29767":197391,"_5":21387,"_28235":197231,"_5797":89156},[],{"_6892":121585,"_42174":121523,"_29767":197393,"_5":21387,"_28235":197231,"_5797":89159},[],{"_6892":121586,"_42174":121523,"_29767":197395,"_5":21387,"_28235":197231,"_5797":197396},[],"Crea la cuenta de servicio y, con la elección de líder activada, un Role sobre `leases` (`get`, `list`, `watch`, `create`, `update`, `patch`).",{"_6892":121587,"_42174":121523,"_29767":197398,"_5":21387,"_28235":197231,"_5797":89165},[],{"_6892":121588,"_42174":121523,"_29767":197400,"_5":21387,"_28235":197231,"_5797":197401},[],"vacíos",{"_6892":121589,"_42174":121523,"_29767":197403,"_5":21387,"_28235":197231,"_5797":197404},[],"No se definen por defecto.",{"_6892":121590,"_42174":121523,"_29767":197406,"_5":21387,"_28235":197231,"_5797":89173},[],{"_6892":121591,"_42174":121523,"_29767":197408,"_5":21387,"_28235":197231,"_5797":197409},[],"no se usa",{"_6892":121592,"_42174":121523,"_29767":197411,"_5":21387,"_28235":197231,"_5797":197412},[],"Declarado, pero nada despliega PostgreSQL: usa una base de datos externa.",{"_6892":121593,"_42174":121523,"_29767":197414,"_5":21387,"_28235":197231,"_5797":197415},[],"Fijado por las plantillas: la estrategia de despliegue es &#x2A;*`Recreate`** (un despliegue tiene una breve interrupción), el periodo de gracia de terminación del pod es de 120 s con una pausa `preStop` de 5 s, las sondas llaman a `GET /health`, y un cambio en `config` reinicia los pods (una anotación con una suma de verificación).",{"_6892":121594,"_42174":121523,"_29767":197417,"_5":21387,"_28235":197231,"_5797":197418},[],"Apunta `config.*` a las dependencias. En particular, crea antes la base de datos `updates` en tu Postgres. El servicio crea sus tablas, no la base de datos. El valor por defecto del chart para `config.update_domain` es `http://updates:10090/v1/`, que carece del prefijo `/updates`: defínelo con la base completa de la API, terminada en `/updates/v1/`, tal como la alcanzan los dispositivos, o las URLs de descarga guardadas en los paquetes no resolverán.",{"_6892":121595,"_42174":121523,"_29767":197420,"_5":21387,"_28235":197234,"_5797":197421},[],"El chart vuelca todo el valor `config`, incluidos `storage.password`, `encryption.local_key`, las claves de S3 y `hawkbit.password`, en un ConfigMap. No tiene opción `existingSecret`, ni un valor para añadir variables de entorno o volúmenes, así que las sobrescrituras por variables de entorno del servicio y sus credenciales `*_file` no se pueden alimentar desde un Secret de Kubernetes sin parchear o envolver el chart. Mientras tanto:",{"_6892":121596,"_42174":121523,"_29767":197423,"_5":21387,"_28235":197234,"_5797":197424},[],"Guarda los valores reales en un fichero de valores que no se versione (`-f secrets.values.yaml`), o genéralo desde tu gestor de secretos en el momento del despliegue.",{"_6892":121597,"_42174":121523,"_29767":197426,"_5":21387,"_28235":197234,"_5797":197427},[],"Restringe quién puede leer ConfigMaps y secretos de release de Helm en el espacio de nombres.",{"_6892":121598,"_42174":121523,"_29767":197429,"_5":21387,"_28235":197234,"_5797":197430},[],"Prefiere credenciales que eviten claves estáticas: omite las claves de acceso de S3 para usar la cadena de credenciales por defecto de AWS (IRSA o un perfil de instancia).",{"_6892":121599,"_42174":121523,"_29767":197432,"_5":21387,"_28235":197234,"_5797":197433},[],"Sustituye la contraseña de base de datos de ejemplo que incluye el chart en `config.storage`.",{"_6892":121600,"_42174":121523,"_29767":197435,"_5":21387,"_28235":197234,"_5797":197436},[],"`helm/updates.yaml` es una sobrescritura de valores para el chart paraguas de Lamassu, que se usa como `helm upgrade lamassu lamassu/lamassu -f lamassu.yaml -f updates.yaml`. Allí define la imagen, las réplicas, los recursos, la persistencia y el `config` del servicio `updates`. Su límite de recursos de ejemplo (`500m` de CPU) es menor que el del chart: consulta Dimensionado de recursos.",{"_6892":121601,"_42174":121523,"_29767":197438,"_5":21387,"_28235":197238,"_5797":197439},[],"Servir HTTP funciona con cualquier número de réplicas en ambos modos. Lo que cambia es el estado que necesita cada réplica.",{"_6892":121602,"_42174":121523,"_29767":197441,"_5":21387,"_28235":197238,"_5797":89209},[],{"_6892":121603,"_42174":121523,"_29767":197443,"_5":21387,"_28235":197238,"_5797":86482},[],{"_6892":121604,"_42174":121523,"_29767":197445,"_5":21387,"_28235":197238,"_5797":197446},[],"Trabajo en segundo plano",{"_6892":121605,"_42174":121523,"_29767":197448,"_5":21387,"_28235":197238,"_5797":197449},[],"Con líder elegido: el consumidor de eventos de WFX y el disparador de lanzamientos programados se ejecutan en una réplica",{"_6892":121606,"_42174":121523,"_29767":197451,"_5":21387,"_28235":197238,"_5797":197452},[],"Ninguno",{"_6892":121607,"_42174":121523,"_29767":197454,"_5":21387,"_28235":197238,"_5797":194043},[],{"_6892":121608,"_42174":121523,"_29767":197456,"_5":21387,"_28235":197238,"_5797":197457},[],"Postgres, WFX, los almacenes `artifacts`, `builds` y `symkms`",{"_6892":121609,"_42174":121523,"_29767":197459,"_5":21387,"_28235":197238,"_5797":197460},[],"Postgres y hawkBit",{"_6892":121610,"_42174":121523,"_29767":197462,"_5":21387,"_28235":197238,"_5797":197463},[],"Ficheros locales",{"_6892":121611,"_42174":121523,"_29767":197465,"_5":21387,"_28235":197238,"_5797":197466},[],"Solo espacio temporal de construcción (cada réplica lo recrea)",{"_6892":121612,"_42174":121523,"_29767":197468,"_5":21387,"_28235":197238,"_5797":197452},[],{"_6892":121613,"_42174":121523,"_29767":197470,"_5":21387,"_28235":197238,"_5797":197471},[],"Requisito adicional",{"_6892":121614,"_42174":121523,"_29767":197473,"_5":21387,"_28235":197238,"_5797":197474},[],"Almacenes S3 y elección de líder",{"_6892":121615,"_42174":121523,"_29767":197476,"_5":21387,"_28235":197238,"_5797":197477},[],"`symkms.storage` compartido o en S3 si usas cifrado con clave compartida",{"_6892":121616,"_42174":121523,"_29767":197479,"_5":21387,"_28235":197238,"_5797":197480},[],"Para ejecutar más de una réplica `native`:",{"_6892":121617,"_42174":121523,"_29767":197482,"_5":21387,"_28235":197238,"_5797":197483},[],"**Almacenamiento compartido.** El valor por defecto es un volumen `ReadWriteOnce`, que no pueden montar pods de nodos distintos, así que limita el despliegue a una réplica sea cual sea `replicaCount`. Apunta `config.artifacts`, `config.builds` y `config.symkms.storage` a S3 y define `persistence.enabled: false`. Las claves de SymKMS también usan por defecto almacenamiento local, y no se compartirían entre réplicas. El servicio registra una advertencia al arrancar cuando las salidas de compilación están en almacenamiento local. Las sw-descriptions se guardan en Postgres, así que ninguna réplica necesita nada local de otra.",{"_6892":121618,"_42174":121523,"_29767":197485,"_5":21387,"_28235":197238,"_5797":197486},[],"**Elección de líder.** Deja `leaderElection.enabled: true`. El consumidor de eventos de WFX avanza los lotes de una campaña con cada trabajo completado, y el disparador inicia los lanzamientos programados que vencen y repara los lotes interrumpidos. Con varias réplicas y sin elección, cada una cuenta las mismas finalizaciones y libera el siguiente lote antes de que el actual haya tenido éxito.",{"_6892":121619,"_42174":121523,"_29767":197488,"_5":21387,"_28235":197238,"_5797":197489},[],"`leaderElection.mode` (`leader_election.mode` en el fichero) es:",{"_6892":121620,"_42174":121523,"_29767":197491,"_5":21387,"_28235":197238,"_5797":197332},[],{"_6892":121621,"_42174":121523,"_29767":197493,"_5":21387,"_28235":197238,"_5797":197494},[],"Comportamiento",{"_6892":121622,"_42174":121523,"_29767":197496,"_5":21387,"_28235":197238,"_5797":197497},[],"vacío (automático)",{"_6892":121623,"_42174":121523,"_29767":197499,"_5":21387,"_28235":197238,"_5797":197500},[],"Leases de Kubernetes dentro de un clúster; en caso contrario, un bloqueo consultivo de Postgres. Es el valor por defecto del binario.",{"_6892":121624,"_42174":121523,"_29767":197502,"_5":21387,"_28235":197238,"_5797":89271},[],{"_6892":121625,"_42174":121523,"_29767":197504,"_5":21387,"_28235":197238,"_5797":197505},[],"Leases, obligatorio. El arranque falla si la cuenta de servicio no puede usarlos. Es el valor por defecto del chart.",{"_6892":121626,"_42174":121523,"_29767":197507,"_5":21387,"_28235":197238,"_5797":89277},[],{"_6892":121627,"_42174":121523,"_29767":197509,"_5":21387,"_28235":197238,"_5797":197510},[],"Un bloqueo consultivo de Postgres, para cuando conceder RBAC no es una opción.",{"_6892":121628,"_42174":121523,"_29767":197512,"_5":21387,"_28235":197238,"_5797":197513},[],"Con Leases, se crea un Lease por rol en el espacio de nombres del pod (`lamassu-updates-wfx-event-consumer` y `lamassu-updates-scheduled-launch-trigger`), y `kubectl get lease` muestra el pod que lidera (`POD_NAME` es el titular). El lease dura 15 s y se renueva en 10 s, así que una conmutación por fallo tarda aproximadamente eso. Con el bloqueo de base de datos, una réplica en espera reintenta cada 15 s y el líder verifica cada 5 s que su conexión sigue viva.",{"_6892":121629,"_42174":121523,"_29767":197515,"_5":21387,"_28235":197238,"_5797":197516},[],"Otras garantías con varias réplicas: las construcciones y cambios de versión del mismo paquete toman un bloqueo de Postgres (una petición concurrente responde `409`), las migraciones de esquema también, y un lote de campaña se reclama de forma atómica para que no se libere dos veces. Cada réplica mantiene hasta 25 conexiones de base de datos: calcula `25 x réplicas` frente al `max_connections` de Postgres.",{"_6892":121630,"_42174":121523,"_29767":197518,"_5":21387,"_28235":197238,"_5797":197519},[],"En modo `hawkbit` no hay nada que elegir ni ficheros locales que compartir. El chart sigue montando el volumen `ReadWriteOnce` mientras `persistence.enabled` es true, así que defínelo en `false` para ejecutar réplicas en nodos distintos.",{"_6892":121631,"_42174":121523,"_29767":197521,"_5":21387,"_28235":197238,"_5797":197522},[],"Como el chart usa la estrategia `Recreate`, un despliegue detiene todas las réplicas antes de arrancar las nuevas, incluso con `replicaCount` superior a 1.",{"_6892":121632,"_42174":121523,"_29767":197524,"_5":21387,"_28235":197242,"_5797":197525},[],"**La CPU** es la palanca del tiempo de construcción por dispositivo. Una construcción ejecuta un `swugenerator` por dispositivo, y el paralelismo se deriva del límite de CPU del contenedor, no de los núcleos del nodo: un límite de `500m` lo reduce a medio núcleo. El valor por defecto del chart, `2000m`, es un punto de partida para grupos de cientos.",{"_6892":121633,"_42174":121523,"_29767":197527,"_5":21387,"_28235":197242,"_5797":197528},[],"**Memoria.** Las subidas, las descargas y las construcciones sin cifrado se transmiten en streaming, así que la memoria no crece con el fichero (los mantenedores midieron un pico de unos 150 MiB residentes para una subida de 10 GiB y para una descarga de 10 GiB). Cifrar necesita el fichero en memoria: `swugenerator` lee un artefacto en memoria para cifrarlo, el AES-GCM de los paquetes `non-swu` y de los módulos `raw` trabaja sobre un único búfer, y un almacén con cifrado en reposo descifra objetos enteros en memoria. Dimensiona la memoria para el mayor fichero que cifres multiplicado por las construcciones concurrentes. En modo `hawkbit`, `build_memory_limit_mb` rechaza una construcción así antes de que el pod muera.",{"_6892":121634,"_42174":121523,"_29767":197530,"_5":21387,"_28235":197242,"_5797":197531},[],"**Disco.** Cada subida en curso se escribe en un fichero temporal bajo `TMPDIR` antes de almacenarse, así que las subidas simultáneas necesitan ese espacio libre. El espacio temporal de construcción usa además `update_files_base_dir` (`/data` en el chart). Da al volumen margen para varias subidas simultáneas (el ejemplo del chart paraguas usa `50Gi`). El chart no expone valores de entorno, así que fijar `TMPDIR` en el volumen exige un chart parcheado o envuelto.",{"_6892":121635,"_42174":121523,"_29767":197533,"_5":21387,"_28235":197246,"_5797":197534},[],"`max_artifact_size_mb` (por defecto 10 GiB) limita un fichero subido. Todo lo que haya delante del servicio debe permitir el mismo tamaño y mantener la conexión abierta tanto como dure la transferencia: el propio servicio usa tiempos de lectura y escritura de 6 horas y cierra las conexiones inactivas a los 5 minutos. Para ingress-nginx:",{"_6892":121636,"_42174":121523,"_29767":197536,"_5":21387,"_28235":197246,"_5797":197537},[],"El límite de cuerpo por defecto de nginx es de 1 MiB, que es lo que rechaza subidas de «unos pocos MB» antes de que lleguen al servicio. Un fichero por encima del límite propio del servicio recibe `413` con el límite indicado.",{"_6892":121637,"_42174":121523,"_29767":197539,"_5":21387,"_28235":197250,"_5797":197540},[],"Qué",{"_6892":121638,"_42174":121523,"_29767":197542,"_5":21387,"_28235":197250,"_5797":197543},[],"Cómo",{"_6892":121639,"_42174":121523,"_29767":197545,"_5":21387,"_28235":197250,"_5797":197546},[],"Liveness y readiness",{"_6892":121640,"_42174":121523,"_29767":197548,"_5":21387,"_28235":197250,"_5797":197549},[],"`GET /health` devuelve `{\"status\":\"ok\"}` sin comprobar Postgres, WFX ni hawkBit, así que solo demuestra que el proceso responde. El chart lo usa para ambas sondas, y la imagen Docker lo ejecuta cada 30 segundos.",{"_6892":121641,"_42174":121523,"_29767":197551,"_5":21387,"_28235":197250,"_5797":197027},[],{"_6892":121642,"_42174":121523,"_29767":197553,"_5":21387,"_28235":197250,"_5797":197554},[],"`GET /updates/v1/capabilities` muestra el backend activo y lo que soporta. No requiere autenticación y no tiene efectos secundarios, pero en modo `hawkbit` consulta a hawkBit, así que no lo uses como sonda.",{"_6892":121643,"_42174":121523,"_29767":197556,"_5":21387,"_28235":197250,"_5797":197557},[],"Registros",{"_6892":121644,"_42174":121523,"_29767":197559,"_5":21387,"_28235":197250,"_5797":197560},[],"Se escriben en la salida estándar: el registro de la aplicación (nivel `app.logs.level`) y un registro de acceso de cada petición. Con `debug`, el registro de arranque incluye toda la configuración, secretos también.",{"_6892":121645,"_42174":121523,"_29767":197562,"_5":21387,"_28235":197250,"_5797":197563},[],"Apagado",{"_6892":121646,"_42174":121523,"_29767":197565,"_5":21387,"_28235":197250,"_5797":197566},[],"Con `SIGTERM` o `SIGINT` el servicio deja de aceptar peticiones, drena las que están en curso hasta `app.server.shutdown_timeout` (60 s), cede el liderazgo y, en modo `native`, espera hasta 30 s más a que termine un envío de lote en marcha. El periodo de gracia del chart (120 s) lo cubre.",{"_6892":121647,"_42174":121523,"_29767":197568,"_5":21387,"_28235":197254,"_5797":197569},[],"El servicio no exporta trazas, métricas ni registros. Sus clientes HTTP salientes (el cliente de SymKMS) y su capa de base de datos están instrumentados con OpenTelemetry, pero no se configura ningún proveedor de trazas ni exportador, y no hay endpoint de métricas. El directorio `otel/` del repositorio contiene una pila local de desarrollo (Grafana Alloy con receptores OTLP en 4317 y 4318, Loki, Tempo, Prometheus, Grafana; Jaeger en `otel/jaeger/`) a la que hoy no envía nada. Mientras no haya exportadores, monitoriza el registro del proceso y `/health`, y vigila los eventos y los Leases de Kubernetes.",{"_6892":121648,"_42174":121523,"_29767":197571,"_5":21387,"_28235":197257,"_5797":197572},[],"Qué respaldar",{"_6892":121649,"_42174":121523,"_29767":197574,"_5":21387,"_28235":197257,"_5797":197575},[],"Por qué",{"_6892":121650,"_42174":121523,"_29767":197577,"_5":21387,"_28235":197257,"_5797":197578},[],"Postgres: la base de datos `updates`, más `wfx` en modo `native` (los trabajos de los dispositivos) y `hawkbit` en modo `hawkbit`",{"_6892":121651,"_42174":121523,"_29767":197580,"_5":21387,"_28235":197257,"_5797":197581},[],"Paquetes, lanzamientos, historial de dispositivos y, en modo `hawkbit`, sw-descriptions, manifiestos firmados y estado en tránsito",{"_6892":121652,"_42174":121523,"_29767":197583,"_5":21387,"_28235":197257,"_5797":197584},[],"Los buckets S3 `artifacts` y `builds` (o el volumen `update_files`)",{"_6892":121653,"_42174":121523,"_29767":197586,"_5":21387,"_28235":197257,"_5797":197587},[],"Binarios de artefactos y salidas de compilación. Las compilaciones se pueden reconstruir a partir de los artefactos y la sw-description (guardada en Postgres); los artefactos en sí no se pueden recrear.",{"_6892":121654,"_42174":121523,"_29767":197589,"_5":21387,"_28235":197257,"_5797":197590},[],"El almacén `symkms` (bucket S3 o el volumen `sym_keys`)",{"_6892":121655,"_42174":121523,"_29767":197592,"_5":21387,"_28235":197257,"_5797":197593},[],"Claves de cifrado de dispositivo y compartidas. Si se pierden, los paquetes ya entregados no se pueden reconstruir de forma idéntica y los dispositivos no pueden descifrar los nuevos.",{"_6892":121656,"_42174":121523,"_29767":197595,"_5":21387,"_28235":197257,"_5797":197596},[],"`encryption.local_key` (o la clave de AWS KMS)",{"_6892":121657,"_42174":121523,"_29767":197598,"_5":21387,"_28235":197257,"_5797":197599},[],"Todo blob guardado con cifrado en reposo es ilegible sin ella. Guárdala separada de los datos.",{"_6892":121658,"_42174":121523,"_29767":197601,"_5":21387,"_28235":197257,"_5797":197602},[],"El almacén de artefactos de hawkBit (volumen o bucket), modo `hawkbit`",{"_6892":121659,"_42174":121523,"_29767":197604,"_5":21387,"_28235":197257,"_5797":197605},[],"Los ficheros de artefactos",{"_6892":121660,"_42174":121523,"_29767":197607,"_5":21387,"_28235":197257,"_5797":197608},[],"Restaura la base de datos y los almacenes de blobs desde el mismo instante: una base de datos que referencia un artefacto ausente del almacenamiento devuelve errores al descargar y al reconstruir. En modo `hawkbit`, mantén además coherentes las bases de datos `updates` y `hawkbit`: las filas de la base `updates` están acotadas a la instancia de hawkBit que las escribió, y se ignoran si hawkBit vuelve con un conjunto de datos distinto.",{"_6892":121661,"_42174":121523,"_29767":197610,"_5":21387,"_28235":197264,"_5797":197611},[],"Haz las copias de arriba, sobre todo de la base de datos `updates`.",{"_6892":121662,"_42174":121523,"_29767":197613,"_5":21387,"_28235":197268,"_5797":197614},[],"No hay ficheros de migración. Al arrancar, el servicio renombra, crea y migra sus propias tablas bajo un bloqueo consultivo de Postgres, así que las réplicas que arrancan a la vez no compiten. Entre otras cosas, renombra las tablas y columnas del antiguo vocabulario de «update pack» al de «distribution set», integra la tabla de módulos independientes en las tablas de módulos, rellena las asignaciones de dispositivos y convierte los umbrales de aprobación. Consulta Modelo de datos.",{"_6892":121663,"_42174":121523,"_29767":197616,"_5":21387,"_28235":197272,"_5797":197617},[],"Comprueba `GET /health` y `GET /updates/v1/capabilities`, y lee el registro de arranque en busca de errores de migración.",{"_6892":121664,"_42174":121523,"_29767":197619,"_5":21387,"_28235":197272,"_5797":197620},[],"No hay reversión automática, y las migraciones son de un solo sentido: una imagen anterior no entiende las tablas renombradas. Para volver atrás, restaura la base de datos y los almacenes de blobs desde la copia de seguridad y ejecuta la imagen anterior.",{"_6892":121665,"_42174":121523,"_29767":197622,"_5":21387,"_28235":197276,"_5797":197623},[],"En modo `hawkbit`, hawkBit es un servicio aparte que operas tú. Su heap de JVM se fija con `X_MS` y `X_MX` (el valor por defecto de la imagen es `768m` cada una; `JAVA_OPTS` no lo fija), sus límites de artefactos con las variables `SPRING_SERVLET_MULTIPART_*` y `HAWKBIT_SERVER_SECURITY_DOS_*`, y su almacén de artefactos con `HAWKBIT_ARTIFACT_STORAGE`. Consulta Modo hawkBit.",{"_6892":121666,"_42174":121523,"_29767":197625,"_5":21387,"_28235":197280,"_5797":197626},[],"Consulta Seguridad. En resumen: pon delante del servicio un gateway con TLS y autenticación, mantén `enable_test_endpoints: false`, restringe las rutas de claves de SymKMS, mantén Postgres, la gestión de WFX, el KMS y hawkBit en redes privadas, y no dejes secretos en el repositorio ni en los registros.",{"_6892":121667,"_42174":121667,"_5":21817,"_5797":88669,"_42654":197628,"_29767":197629,"_28235":121667},[77248,187247,193621],[],{"_6892":121668,"_42174":121667,"_29767":197631,"_5":21387,"_28235":121667,"_5797":197632},[],"Qué hace el servicio, cómo encaja con Lamassu IoT, WFX y hawkBit, y por dónde empezar.",{"_6892":121669,"_42174":121667,"_5":42651,"_29767":197634,"_28235":197635,"_5797":197636},[],"/docs/pr-preview/pr-56/es/platform/updates/overview#con-qué-se-conecta","Con qué se conecta",{"_6892":121670,"_42174":121667,"_5":42651,"_29767":197638,"_28235":197639,"_5797":197640},[],"/docs/pr-preview/pr-56/es/platform/updates/overview#elige-tu-backend","Elige tu backend",{"_6892":121671,"_42174":121667,"_5":42651,"_29767":197642,"_28235":197643,"_5797":188883},[],"/docs/pr-preview/pr-56/es/platform/updates/overview#siguientes-pasos",{"_6892":121672,"_42174":121667,"_29767":197645,"_5":21387,"_28235":121667,"_5797":197646},[],"Lamassu Updates (también llamado OTA Update Service) orquesta las actualizaciones de software por aire (OTA) de flotas IoT. Publicas una actualización, eliges qué dispositivos la reciben y sigues el despliegue. El servicio construye el paquete que instalan los clientes SWUpdate y puede firmarlo y cifrarlo.",{"_6892":121673,"_42174":121667,"_29767":197648,"_5":21387,"_28235":121667,"_5797":197649},[],"Hay una única API HTTP y dos backends intercambiables detrás de ella, que se eligen con el ajuste `mode`. El backend decide con qué servidor de actualizaciones hablan los dispositivos, así que los sistemas que rodean al servicio dependen de él.",{"_6892":121674,"_42174":121667,"_29767":197651,"_5":21387,"_28235":197635,"_5797":193792},[],{"_6892":121675,"_42174":121667,"_29767":197653,"_5":21387,"_28235":197635,"_5797":193688},[],{"_6892":121676,"_42174":121667,"_29767":197655,"_5":21387,"_28235":197635,"_5797":89209},[],{"_6892":121677,"_42174":121667,"_29767":197657,"_5":21387,"_28235":197635,"_5797":86482},[],{"_6892":121678,"_42174":121667,"_29767":197659,"_5":21387,"_28235":197635,"_5797":89430},[],{"_6892":121679,"_42174":121667,"_29767":197661,"_5":21387,"_28235":197635,"_5797":197662},[],"Registro de dispositivos (grupos de dispositivos) y KMS. Las claves de firma viven en su KMS",{"_6892":121680,"_42174":121667,"_29767":197664,"_5":21387,"_28235":197635,"_5797":197665},[],"Obligatorio",{"_6892":121681,"_42174":121667,"_29767":197667,"_5":21387,"_28235":197635,"_5797":197668},[],"Opcional: sin él, los grupos se leen de las etiquetas `group:<id>` de los targets del propio hawkBit",{"_6892":121682,"_42174":121667,"_29767":197670,"_5":21387,"_28235":197635,"_5797":85441},[],{"_6892":121683,"_42174":121667,"_29767":197672,"_5":21387,"_28235":197635,"_5797":197673},[],"Orquestación de trabajos. Cada actualización de un dispositivo es un trabajo (job) de WFX que el dispositivo consulta",{"_6892":121684,"_42174":121667,"_29767":197675,"_5":21387,"_28235":197635,"_5797":197665},[],{"_6892":121685,"_42174":121667,"_29767":197677,"_5":21387,"_28235":197635,"_5797":197678},[],"No se usa",{"_6892":121686,"_42174":121667,"_29767":197680,"_5":21387,"_28235":197635,"_5797":85449},[],{"_6892":121687,"_42174":121667,"_29767":197682,"_5":21387,"_28235":197635,"_5797":197683},[],"Servidor de actualizaciones. Almacena paquetes, módulos y rollouts, y los dispositivos lo consultan",{"_6892":121688,"_42174":121667,"_29767":197685,"_5":21387,"_28235":197635,"_5797":197678},[],{"_6892":121689,"_42174":121667,"_29767":197687,"_5":21387,"_28235":197635,"_5797":197665},[],{"_6892":121690,"_42174":121667,"_29767":197689,"_5":21387,"_28235":197635,"_5797":85414},[],{"_6892":121691,"_42174":121667,"_29767":197691,"_5":21387,"_28235":197635,"_5797":193802},[],{"_6892":121692,"_42174":121667,"_29767":197693,"_5":21387,"_28235":197635,"_5797":197665},[],{"_6892":121693,"_42174":121667,"_29767":197695,"_5":21387,"_28235":197635,"_5797":197665},[],{"_6892":121694,"_42174":121667,"_29767":197697,"_5":21387,"_28235":197635,"_5797":37308},[],{"_6892":121695,"_42174":121667,"_29767":197699,"_5":21387,"_28235":197635,"_5797":197700},[],"Herramienta Python, incluida en el repositorio ota, que ensambla el fichero `.swu` firmado y, opcionalmente, cifrado",{"_6892":121696,"_42174":121667,"_29767":197702,"_5":21387,"_28235":197635,"_5797":193844},[],{"_6892":121697,"_42174":121667,"_29767":197704,"_5":21387,"_28235":197635,"_5797":193844},[],{"_6892":121698,"_42174":121667,"_29767":197706,"_5":21387,"_28235":197635,"_5797":197707},[],"El dashboard de Lamassu es la interfaz web de esta API. Lee su URL base de `LAMASSU_UPDATES_API` en `public/config.js` (si no está definida, usa la URL base de la API principal) y añade él mismo `/updates/v1` y `/symkms/v1`. También lee una vez `GET /updates/v1/capabilities` y oculta las funciones que el backend activo no soporta.",{"_6892":121699,"_42174":121667,"_29767":197709,"_5":21387,"_28235":197639,"_5797":197710},[],"La API HTTP es la misma en ambos casos. Lo que cambia es quién almacena los datos y con quién hablan los dispositivos.",{"_6892":121700,"_42174":121667,"_29767":197712,"_5":21387,"_28235":197639,"_5797":197713},[],"`native` (por defecto)",{"_6892":121701,"_42174":121667,"_29767":197715,"_5":21387,"_28235":197639,"_5797":86482},[],{"_6892":121702,"_42174":121667,"_29767":197717,"_5":21387,"_28235":197639,"_5797":197718},[],"Almacena paquetes, lanzamientos y trabajos",{"_6892":121703,"_42174":121667,"_29767":197720,"_5":21387,"_28235":197639,"_5797":197721},[],"El Postgres de este servicio, más WFX",{"_6892":121704,"_42174":121667,"_29767":197723,"_5":21387,"_28235":197639,"_5797":197724},[],"Un servidor Eclipse hawkBit",{"_6892":121705,"_42174":121667,"_29767":197726,"_5":21387,"_28235":197639,"_5797":197727},[],"Los dispositivos consultan",{"_6892":121706,"_42174":121667,"_29767":197729,"_5":21387,"_28235":197639,"_5797":85441},[],{"_6892":121707,"_42174":121667,"_29767":197731,"_5":21387,"_28235":197639,"_5797":197732},[],"hawkBit (API DDI)",{"_6892":121708,"_42174":121667,"_29767":197734,"_5":21387,"_28235":197639,"_5797":197735},[],"Un paquete se construye",{"_6892":121709,"_42174":121667,"_29767":197737,"_5":21387,"_28235":197639,"_5797":197738},[],"Entero, a partir de los ficheros de todos sus módulos, en un único `.swu`",{"_6892":121710,"_42174":121667,"_29767":197740,"_5":21387,"_28235":197639,"_5797":197741},[],"Un `.swu` (o entregable raw) por módulo, construido en el catálogo de módulos",{"_6892":121711,"_42174":121667,"_29767":197743,"_5":21387,"_28235":197639,"_5797":197744},[],"Cifrado por dispositivo",{"_6892":121712,"_42174":121667,"_29767":197746,"_5":21387,"_28235":197639,"_5797":197747},[],"Soportado",{"_6892":121713,"_42174":121667,"_29767":197749,"_5":21387,"_28235":197639,"_5797":197750},[],"No soportado",{"_6892":121714,"_42174":121667,"_29767":197752,"_5":21387,"_28235":197639,"_5797":197753},[],"Elígelo cuando",{"_6892":121715,"_42174":121667,"_29767":197755,"_5":21387,"_28235":197639,"_5797":197756},[],"Empiezas de cero, o necesitas cifrado por dispositivo",{"_6892":121716,"_42174":121667,"_29767":197758,"_5":21387,"_28235":197639,"_5797":197759},[],"hawkBit ya es el backend de actualizaciones de tu flota",{"_6892":121717,"_42174":121667,"_29767":197761,"_5":21387,"_28235":197639,"_5797":197762},[],"Se configura con el campo `mode` de la configuración. Los backends no son equivalentes en todas las funciones: consulta Capacidades y Modo hawkBit.",{"_6892":121718,"_42174":121667,"_29767":197764,"_5":21387,"_28235":197643,"_5797":197765},[],"Quiero...",{"_6892":121719,"_42174":121667,"_29767":197767,"_5":21387,"_28235":197643,"_5797":197768},[],"Lee",{"_6892":121720,"_42174":121667,"_29767":197770,"_5":21387,"_28235":197643,"_5797":197771},[],"Ejecutar toda la pila en local",{"_6892":121721,"_42174":121667,"_29767":197773,"_5":21387,"_28235":197643,"_5797":190589},[],{"_6892":121722,"_42174":121667,"_29767":197775,"_5":21387,"_28235":197643,"_5797":197776},[],"Entender los términos (paquete, módulo, lanzamiento)",{"_6892":121723,"_42174":121667,"_29767":197778,"_5":21387,"_28235":197643,"_5797":197779},[],"Conceptos y Modelo de datos",{"_6892":121724,"_42174":121667,"_29767":197781,"_5":21387,"_28235":197643,"_5797":197782},[],"Ver los componentes y cómo fluyen los datos",{"_6892":121725,"_42174":121667,"_29767":197784,"_5":21387,"_28235":197643,"_5797":197785},[],"Arquitectura y Flujos",{"_6892":121726,"_42174":121667,"_29767":197787,"_5":21387,"_28235":197643,"_5797":197788},[],"Publicar una actualización y desplegarla",{"_6892":121727,"_42174":121667,"_29767":197790,"_5":21387,"_28235":197643,"_5797":197791},[],"Publicar y desplegar una actualización",{"_6892":121728,"_42174":121667,"_29767":197793,"_5":21387,"_28235":197643,"_5797":197794},[],"Probar todo el flujo con curl",{"_6892":121729,"_42174":121667,"_29767":197796,"_5":21387,"_28235":197643,"_5797":197797},[],"Nativo o hawkBit",{"_6892":121730,"_42174":121667,"_29767":197799,"_5":21387,"_28235":197643,"_5797":197800},[],"Hacerlo desde la interfaz web",{"_6892":121731,"_42174":121667,"_29767":197802,"_5":21387,"_28235":197643,"_5797":197803},[],"Usar el dashboard",{"_6892":121732,"_42174":121667,"_29767":197805,"_5":21387,"_28235":197643,"_5797":197806},[],"Conectar un dispositivo",{"_6892":121733,"_42174":121667,"_29767":197808,"_5":21387,"_28235":197643,"_5797":197806},[],{"_6892":121734,"_42174":121667,"_29767":197810,"_5":21387,"_28235":197643,"_5797":197811},[],"Usar un hawkBit existente",{"_6892":121735,"_42174":121667,"_29767":197813,"_5":21387,"_28235":197643,"_5797":193637},[],{"_6892":121736,"_42174":121667,"_29767":197815,"_5":21387,"_28235":197643,"_5797":197816},[],"Firmar o cifrar actualizaciones",{"_6892":121737,"_42174":121667,"_29767":197818,"_5":21387,"_28235":197643,"_5797":197093},[],{"_6892":121738,"_42174":121667,"_29767":197820,"_5":21387,"_28235":197643,"_5797":197821},[],"Ajustar un campo de configuración",{"_6892":121739,"_42174":121667,"_29767":197823,"_5":21387,"_28235":197643,"_5797":197824},[],"Configuración",{"_6892":121740,"_42174":121667,"_29767":197826,"_5":21387,"_28235":197643,"_5797":197827},[],"Llamar a la API",{"_6892":121741,"_42174":121667,"_29767":197829,"_5":21387,"_28235":197643,"_5797":195977},[],{"_6892":121742,"_42174":121667,"_29767":197831,"_5":21387,"_28235":197643,"_5797":197832},[],"Desplegarlo, escalarlo, respaldarlo o actualizarlo",{"_6892":121743,"_42174":121667,"_29767":197834,"_5":21387,"_28235":197643,"_5797":197213},[],{"_6892":121744,"_42174":121667,"_29767":197836,"_5":21387,"_28235":197643,"_5797":197837},[],"Securizarlo",{"_6892":121745,"_42174":121667,"_29767":197839,"_5":21387,"_28235":197643,"_5797":195585},[],{"_6892":121746,"_42174":121667,"_29767":197841,"_5":21387,"_28235":197643,"_5797":197842},[],"Resolver un problema",{"_6892":121747,"_42174":121667,"_29767":197844,"_5":21387,"_28235":197643,"_5797":193515},[],{"_6892":121748,"_42174":121667,"_29767":197846,"_5":21387,"_28235":197643,"_5797":197847},[],"Ver qué no está soportado",{"_6892":121749,"_42174":121667,"_29767":197849,"_5":21387,"_28235":197643,"_5797":197850},[],"Limitaciones",{"_6892":121750,"_42174":121667,"_29767":197852,"_5":21387,"_28235":197643,"_5797":197853},[],"El código fuente, las configuraciones de ejemplo y el chart de Helm están en el repositorio ota.",{"_6892":121751,"_42174":121751,"_5":21817,"_5797":195977,"_42654":197855,"_29767":197857,"_28235":121751},[77248,187247,193621,197856],"Referencia",[],{"_6892":121752,"_42174":121751,"_29767":197859,"_5":21387,"_28235":121751,"_5797":197860},[],"Todas las rutas de las APIs HTTP de Lamassu Updates y SymKMS, con cuerpos de petición, códigos de estado y comportamiento por backend.",{"_6892":121753,"_42174":121751,"_5":42651,"_29767":197862,"_28235":197863,"_5797":197864},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#convenciones","Convenciones",{"_6892":121754,"_42174":121751,"_5":42651,"_29767":197866,"_28235":197867,"_5797":197868},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#códigos-de-estado","Códigos de estado",{"_6892":121755,"_42174":121751,"_5":42651,"_29767":197870,"_28235":197871,"_5797":197872},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#descargas","Descargas",{"_6892":121756,"_42174":121751,"_5":42651,"_29767":197874,"_28235":197875,"_5797":197876},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#endpoints-de-listado","Endpoints de listado",{"_6892":121757,"_42174":121751,"_5":42651,"_29767":197878,"_28235":197879,"_5797":197880},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#capabilities-y-workflows","Capabilities y workflows",{"_6892":121758,"_42174":121751,"_5":42651,"_29767":197882,"_28235":197883,"_5797":197884},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#packs-de-actualización","Packs de actualización",{"_6892":121759,"_42174":121751,"_5":42651,"_29767":197886,"_28235":197887,"_5797":197888},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#descriptor-artefactos-y-precondiciones","Descriptor, artefactos y precondiciones",{"_6892":121760,"_42174":121751,"_5":42651,"_29767":197890,"_28235":197891,"_5797":197892},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#compilación-y-descarga","Compilación y descarga",{"_6892":121761,"_42174":121751,"_5":42651,"_29767":197894,"_28235":197895,"_5797":197896},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#versiones","Versiones",{"_6892":121762,"_42174":121751,"_5":42651,"_29767":197898,"_28235":197899,"_5797":197900},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#cuerpos-de-las-peticiones","Cuerpos de las peticiones",{"_6892":121763,"_42174":121751,"_5":42651,"_29767":197902,"_28235":197903,"_5797":197904},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#respuestas","Respuestas",{"_6892":121764,"_42174":121751,"_5":42651,"_29767":197906,"_28235":197907,"_5797":197908},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#objetos","Objetos",{"_6892":121765,"_42174":121751,"_5":42651,"_29767":197910,"_28235":197911,"_5797":89676},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#pack",{"_6892":121766,"_42174":121751,"_5":42651,"_29767":197913,"_28235":197914,"_5797":197915},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#lanzamiento","Lanzamiento",{"_6892":121767,"_42174":121751,"_5":42651,"_29767":197917,"_28235":197918,"_5797":194000},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#módulo-de-software",{"_6892":121768,"_42174":121751,"_5":42651,"_29767":197920,"_28235":197921,"_5797":194008},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#artefacto",{"_6892":121769,"_42174":121751,"_5":42651,"_29767":197923,"_28235":197924,"_5797":197925},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#módulos-dentro-de-un-pack","Módulos dentro de un pack",{"_6892":121770,"_42174":121751,"_5":42651,"_29767":197927,"_28235":197928,"_5797":197929},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#catálogo-de-módulos-de-software","Catálogo de módulos de software",{"_6892":121771,"_42174":121751,"_5":42651,"_29767":197931,"_28235":197932,"_5797":197900},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#cuerpos-de-las-peticiones-1",{"_6892":121772,"_42174":121751,"_5":42651,"_29767":197934,"_28235":197935,"_5797":197936},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#artefactos-globales","Artefactos globales",{"_6892":121773,"_42174":121751,"_5":42651,"_29767":197938,"_28235":197939,"_5797":193955},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#campañas-de-lanzamiento",{"_6892":121774,"_42174":121751,"_5":42651,"_29767":197941,"_28235":197942,"_5797":89708},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#jobs",{"_6892":121775,"_42174":121751,"_5":42651,"_29767":197944,"_28235":197945,"_5797":197946},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#inventario-de-dispositivos","Inventario de dispositivos",{"_6892":121776,"_42174":121751,"_5":42651,"_29767":197948,"_28235":197949,"_5797":197950},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#conformidad-de-versiones-y-últimas-versiones","Conformidad de versiones y últimas versiones",{"_6892":121777,"_42174":121751,"_5":42651,"_29767":197952,"_28235":197953,"_5797":197954},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#descarga-de-artefactos-por-el-dispositivo-modo-hawkbit","Descarga de artefactos por el dispositivo, modo hawkBit",{"_6892":121778,"_42174":121751,"_5":42651,"_29767":197956,"_28235":197957,"_5797":85318},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#symkms",{"_6892":121779,"_42174":121751,"_5":42651,"_29767":197959,"_28235":197960,"_5797":188883},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/api#siguientes-pasos",{"_6892":121780,"_42174":121751,"_29767":197962,"_5":21387,"_28235":121751,"_5797":197963},[],"Referencia de la API HTTP de Lamassu Updates, tal como la implementa el servicio en `internal/updates/httpapi` (compartido por los backends native y hawkBit). Úsala para consultar una ruta, un campo de un cuerpo o un código de estado. Para ejemplos completos, sigue la guía de curl con el backend native o con hawkBit.",{"_6892":121781,"_42174":121751,"_29767":197965,"_5":21387,"_28235":197863,"_5797":197966},[],"La API de Updates se sirve bajo `/updates/v1` y SymKMS bajo `/symkms/v1`. Las rutas de esta página son relativas a `/updates/v1`, salvo las que empiezan por `/health` o `/symkms`. Detrás del gateway de Lamassu el prefijo suele ser `/api/updates/v1`, que es lo que llama el dashboard.",{"_6892":121782,"_42174":121751,"_29767":197968,"_5":21387,"_28235":197863,"_5797":197969},[],"`:groupID` es un grupo de dispositivos de Lamassu. `:name` es el nombre de un pack. `:moduleKey` es `type:name` (por ejemplo `os:water-panel`), literal o codificado en porcentaje. En las rutas un pack es un recurso `distribution-sets` (consulta Conceptos).",{"_6892":121783,"_42174":121751,"_29767":197971,"_5":21387,"_28235":197863,"_5797":197972},[],"Tema",{"_6892":121784,"_42174":121751,"_29767":197974,"_5":21387,"_28235":197863,"_5797":197494},[],{"_6892":121785,"_42174":121751,"_29767":197976,"_5":21387,"_28235":197863,"_5797":197977},[],"Cuerpos",{"_6892":121786,"_42174":121751,"_29767":197979,"_5":21387,"_28235":197863,"_5797":197980},[],"JSON, salvo las subidas, que son `multipart/form-data` con el archivo en el campo `file`",{"_6892":121787,"_42174":121751,"_29767":197982,"_5":21387,"_28235":197863,"_5797":197983},[],"Errores",{"_6892":121788,"_42174":121751,"_29767":197985,"_5":21387,"_28235":197863,"_5797":197986},[],"El cuerpo es `{\"err\":\"<mensaje>\"}`",{"_6892":121789,"_42174":121751,"_29767":197988,"_5":21387,"_28235":197863,"_5797":89755},[],{"_6892":121790,"_42174":121751,"_29767":197990,"_5":21387,"_28235":197863,"_5797":197991},[],"`GET /health` devuelve `{\"status\":\"ok\"}`, fuera de `/updates/v1`",{"_6892":121791,"_42174":121751,"_29767":197993,"_5":21387,"_28235":197863,"_5797":197994},[],"Autenticación",{"_6892":121792,"_42174":121751,"_29767":197996,"_5":21387,"_28235":197863,"_5797":197997},[],"Ninguna en el servicio: no autentica a quien llama. En un despliegue de Lamassu lo hace el gateway que tiene delante. Consulta Seguridad",{"_6892":121793,"_42174":121751,"_29767":197999,"_5":21387,"_28235":197863,"_5797":198000},[],"Límite de subida",{"_6892":121794,"_42174":121751,"_29767":198002,"_5":21387,"_28235":197863,"_5797":198003},[],"Un archivo puede tener hasta `max_artifact_size_mb` MiB, 10240 (10 GiB) por defecto. Uno mayor responde `413`",{"_6892":121795,"_42174":121751,"_29767":198005,"_5":21387,"_28235":197863,"_5797":89773},[],{"_6892":121796,"_42174":121751,"_29767":198007,"_5":21387,"_28235":197863,"_5797":198008},[],"Una petición puede leer o escribir hasta 6 horas; una conexión inactiva se cierra a los 5 minutos. Las subidas se escriben en disco en streaming, no se mantienen en memoria",{"_6892":121797,"_42174":121751,"_29767":198010,"_5":21387,"_28235":197863,"_5797":89779},[],{"_6892":121798,"_42174":121751,"_29767":198012,"_5":21387,"_28235":197863,"_5797":198013},[],"Se permite cualquier origen y cualquier cabecera de petición",{"_6892":121799,"_42174":121751,"_29767":198015,"_5":21387,"_28235":197863,"_5797":198016},[],"El ingress o el gateway que tiene delante el servicio necesita sus propios límites elevados en consonancia: consulta Configuración.",{"_6892":121800,"_42174":121751,"_29767":198018,"_5":21387,"_28235":197867,"_5797":198019},[],"Código",{"_6892":121801,"_42174":121751,"_29767":198021,"_5":21387,"_28235":197867,"_5797":193986},[],{"_6892":121802,"_42174":121751,"_29767":198023,"_5":21387,"_28235":197867,"_5797":89793},[],{"_6892":121803,"_42174":121751,"_29767":198025,"_5":21387,"_28235":197867,"_5797":198026},[],"Correcto",{"_6892":121804,"_42174":121751,"_29767":198028,"_5":21387,"_28235":197867,"_5797":89799},[],{"_6892":121805,"_42174":121751,"_29767":198030,"_5":21387,"_28235":197867,"_5797":198031},[],"Creado: packs, módulos, lanzamientos, subidas de artefactos independientes",{"_6892":121806,"_42174":121751,"_29767":198033,"_5":21387,"_28235":197867,"_5797":89805},[],{"_6892":121807,"_42174":121751,"_29767":198035,"_5":21387,"_28235":197867,"_5797":198036},[],"Aceptado: `sync-to-latest` y `force-version`",{"_6892":121808,"_42174":121751,"_29767":198038,"_5":21387,"_28235":197867,"_5797":89811},[],{"_6892":121809,"_42174":121751,"_29767":198040,"_5":21387,"_28235":197867,"_5797":198041},[],"Eliminado, sin cuerpo: artefactos, archivos preparados, registros de última versión, archivos de módulo",{"_6892":121810,"_42174":121751,"_29767":198043,"_5":21387,"_28235":197867,"_5797":89817},[],{"_6892":121811,"_42174":121751,"_29767":198045,"_5":21387,"_28235":197867,"_5797":198046},[],"Contenido parcial, o rango no satisfacible, en las descargas",{"_6892":121812,"_42174":121751,"_29767":198048,"_5":21387,"_28235":197867,"_5797":89823},[],{"_6892":121813,"_42174":121751,"_29767":198050,"_5":21387,"_28235":197867,"_5797":198051},[],"`sync-to-latest` despachó algunos dispositivos y falló en otros",{"_6892":121814,"_42174":121751,"_29767":198053,"_5":21387,"_28235":197867,"_5797":89829},[],{"_6892":121815,"_42174":121751,"_29767":198055,"_5":21387,"_28235":197867,"_5797":198056},[],"Una descarga redirigida a una URL firmada de corta duración",{"_6892":121816,"_42174":121751,"_29767":198058,"_5":21387,"_28235":197867,"_5797":89835},[],{"_6892":121817,"_42174":121751,"_29767":198060,"_5":21387,"_28235":197867,"_5797":198061},[],"Entrada no válida, u operación no válida en el estado actual (por ejemplo, cambiar la composición de módulos de un pack ya compilado)",{"_6892":121818,"_42174":121751,"_29767":198063,"_5":21387,"_28235":197867,"_5797":89841},[],{"_6892":121819,"_42174":121751,"_29767":198065,"_5":21387,"_28235":197867,"_5797":198066},[],"Prohibido por política (por ejemplo, descargar una versión anterior que el pack no permite)",{"_6892":121820,"_42174":121751,"_29767":198068,"_5":21387,"_28235":197867,"_5797":89847},[],{"_6892":121821,"_42174":121751,"_29767":198070,"_5":21387,"_28235":197867,"_5797":198071},[],"El recurso no existe",{"_6892":121822,"_42174":121751,"_29767":198073,"_5":21387,"_28235":197867,"_5797":89853},[],{"_6892":121823,"_42174":121751,"_29767":198075,"_5":21387,"_28235":197867,"_5797":198076},[],"Conflicto: la versión del pack ya está compilada (subida o enlace de artefacto, subida de un entregable precompilado), el nombre del pack ya existe, u otra petición está trabajando sobre el mismo recurso",{"_6892":121824,"_42174":121751,"_29767":198078,"_5":21387,"_28235":197867,"_5797":89859},[],{"_6892":121825,"_42174":121751,"_29767":198080,"_5":21387,"_28235":197867,"_5797":198081},[],"Un archivo subido supera el límite de tamaño",{"_6892":121826,"_42174":121751,"_29767":198083,"_5":21387,"_28235":197867,"_5797":89865},[],{"_6892":121827,"_42174":121751,"_29767":198085,"_5":21387,"_28235":197867,"_5797":198086},[],"El backend activo no admite la operación. Consulta Capabilities",{"_6892":121828,"_42174":121751,"_29767":198088,"_5":21387,"_28235":197871,"_5797":198089},[],"Las rutas de descarga transmiten el archivo y permiten reanudar:",{"_6892":121829,"_42174":121751,"_29767":198091,"_5":21387,"_28235":197871,"_5797":198092},[],"`HEAD` funciona en todas las rutas de descarga y devuelve el tamaño y `Accept-Ranges: bytes`.",{"_6892":121830,"_42174":121751,"_29767":198094,"_5":21387,"_28235":197871,"_5797":198095},[],"`Range: bytes=...` con un único rango responde `206` con `Content-Range`. Un rango que no se puede satisfacer responde `416`. Una petición con varios rangos recibe el archivo completo.",{"_6892":121831,"_42174":121751,"_29767":198097,"_5":21387,"_28235":197871,"_5797":198098},[],"Con almacenamiento S3 y la firma previa (presign) activada, un `GET` puede responder `302` a una URL firmada del almacén de objetos, con `Cache-Control: no-store`. Primero se autoriza al que llama; el almacén solo comprueba después la firma. Un `HEAD` nunca se redirige. El modo native firma las salidas de compilación (`.swu` y paquetes); el modo hawkBit firma los objetos del plugin S3 de artefactos de hawkBit. Si falla la firma, el servicio transmite el archivo directamente.",{"_6892":121832,"_42174":121751,"_29767":198100,"_5":21387,"_28235":197871,"_5797":198101},[],"`Content-Disposition: attachment` lleva el nombre del archivo.",{"_6892":121833,"_42174":121751,"_29767":198103,"_5":21387,"_28235":197875,"_5797":198104},[],"Las rutas que devuelven colecciones comparten estos parámetros de consulta:",{"_6892":121834,"_42174":121751,"_29767":198106,"_5":21387,"_28235":197875,"_5797":189859},[],{"_6892":121835,"_42174":121751,"_29767":198108,"_5":21387,"_28235":197875,"_5797":193986},[],{"_6892":121836,"_42174":121751,"_29767":198110,"_5":21387,"_28235":197875,"_5797":89893},[],{"_6892":121837,"_42174":121751,"_29767":198112,"_5":21387,"_28235":197875,"_5797":198113},[],"Elementos por página. Por defecto `25`, como máximo `500`",{"_6892":121838,"_42174":121751,"_29767":198115,"_5":21387,"_28235":197875,"_5797":89899},[],{"_6892":121839,"_42174":121751,"_29767":198117,"_5":21387,"_28235":197875,"_5797":198118},[],"Cursor opaco de la página anterior",{"_6892":121840,"_42174":121751,"_29767":198120,"_5":21387,"_28235":197875,"_5797":89905},[],{"_6892":121841,"_42174":121751,"_29767":198122,"_5":21387,"_28235":197875,"_5797":198123},[],"Un campo filtrable, y `asc` (por defecto) o `desc`. Un `sort_by` que no sea un campo filtrable se ignora",{"_6892":121842,"_42174":121751,"_29767":198125,"_5":21387,"_28235":197875,"_5797":89911},[],{"_6892":121843,"_42174":121751,"_29767":198127,"_5":21387,"_28235":197875,"_5797":198128},[],"`field[operand]value`, repetible",{"_6892":121844,"_42174":121751,"_29767":198130,"_5":21387,"_28235":197875,"_5797":198131},[],"Los operandos del filtro dependen del tipo de campo:",{"_6892":121845,"_42174":121751,"_29767":198133,"_5":21387,"_28235":197875,"_5797":198134},[],"Tipo de campo",{"_6892":121846,"_42174":121751,"_29767":198136,"_5":21387,"_28235":197875,"_5797":198137},[],"Operandos",{"_6892":121847,"_42174":121751,"_29767":198139,"_5":21387,"_28235":197875,"_5797":89926},[],{"_6892":121848,"_42174":121751,"_29767":198141,"_5":21387,"_28235":197875,"_5797":198142},[],"`eq`, `ne`, `ct` (contiene), `nc` (no contiene), cada uno con una variante `_ic` que no distingue mayúsculas",{"_6892":121849,"_42174":121751,"_29767":198144,"_5":21387,"_28235":197875,"_5797":198145},[],"Fecha",{"_6892":121850,"_42174":121751,"_29767":198147,"_5":21387,"_28235":197875,"_5797":198148},[],"`bf` (antes), `eq`, `af` (después)",{"_6892":121851,"_42174":121751,"_29767":198150,"_5":21387,"_28235":197875,"_5797":198151},[],"Número",{"_6892":121852,"_42174":121751,"_29767":198153,"_5":21387,"_28235":197875,"_5797":89941},[],{"_6892":121853,"_42174":121751,"_29767":198155,"_5":21387,"_28235":197875,"_5797":89944},[],{"_6892":121854,"_42174":121751,"_29767":198157,"_5":21387,"_28235":197875,"_5797":89947},[],{"_6892":121855,"_42174":121751,"_29767":198159,"_5":21387,"_28235":197875,"_5797":198160},[],"Por ejemplo `GET /groups/g1/distribution-sets?filter=name[ct]firmware&sort_by=name&sort_mode=desc`.",{"_6892":121856,"_42174":121751,"_29767":198162,"_5":21387,"_28235":197875,"_5797":198163},[],"Los listados paginados devuelven `{\"next\": \"<bookmark>\", \"list\": [...]}`. Pasa `next` como `bookmark` para obtener la página siguiente; `next` está vacío en la última. Campos filtrables por listado:",{"_6892":121857,"_42174":121751,"_29767":198165,"_5":21387,"_28235":197875,"_5797":198166},[],"Listado",{"_6892":121858,"_42174":121751,"_29767":198168,"_5":21387,"_28235":197875,"_5797":198169},[],"Campos filtrables",{"_6892":121859,"_42174":121751,"_29767":198171,"_5":21387,"_28235":197875,"_5797":89962},[],{"_6892":121860,"_42174":121751,"_29767":198173,"_5":21387,"_28235":197875,"_5797":89965},[],{"_6892":121861,"_42174":121751,"_29767":198175,"_5":21387,"_28235":197875,"_5797":198176},[],"Lanzamientos: `/groups/:groupID/launch`",{"_6892":121862,"_42174":121751,"_29767":198178,"_5":21387,"_28235":197875,"_5797":89971},[],{"_6892":121863,"_42174":121751,"_29767":198180,"_5":21387,"_28235":197875,"_5797":198181},[],"Instantáneas de versión: `.../versions`, `/distribution-sets/:id/versions`",{"_6892":121864,"_42174":121751,"_29767":198183,"_5":21387,"_28235":197875,"_5797":198184},[],"`version` (número), `created_at`",{"_6892":121865,"_42174":121751,"_29767":198186,"_5":21387,"_28235":197875,"_5797":198187},[],"Catálogo de artefactos de la flota: `GET /artifacts`",{"_6892":121866,"_42174":121751,"_29767":198189,"_5":21387,"_28235":197875,"_5797":89983},[],{"_6892":121867,"_42174":121751,"_29767":198191,"_5":21387,"_28235":197875,"_5797":198192},[],"Versiones de pack e inventario de dispositivos: `/devices/distribution-sets`, `/devices/:deviceID/distribution-sets`, `.../distribution-set-inventory`",{"_6892":121868,"_42174":121751,"_29767":198194,"_5":21387,"_28235":197875,"_5797":198195},[],"`device_id`, `distribution_set_id`, `distribution_set_name`, `group_id`, `version` (número), `packaging` (enum), `installed_at`",{"_6892":121869,"_42174":121751,"_29767":198197,"_5":21387,"_28235":197875,"_5797":198198},[],"Historial de actualizaciones de dispositivo: `/devices/:deviceID/distribution-set-updates`, `/devices/distribution-set-updates/latest`",{"_6892":121870,"_42174":121751,"_29767":198200,"_5":21387,"_28235":197875,"_5797":89995},[],{"_6892":121871,"_42174":121751,"_29767":198202,"_5":21387,"_28235":197875,"_5797":198203},[],"Últimas versiones: `.../latest-distribution-sets`",{"_6892":121872,"_42174":121751,"_29767":198205,"_5":21387,"_28235":197875,"_5797":90001},[],{"_6892":121873,"_42174":121751,"_29767":198207,"_5":21387,"_28235":197875,"_5797":198208},[],"Algunos listados no paginan ni filtran:",{"_6892":121874,"_42174":121751,"_29767":198210,"_5":21387,"_28235":197875,"_5797":198211},[],"Los listados de jobs (`/groups/:groupID/device/:deviceID/jobs`, `.../history`, `/launch/:launchID/jobs`) solo respetan `page_size` y `bookmark`. El bookmark es un desplazamiento numérico.",{"_6892":121875,"_42174":121751,"_29767":198213,"_5":21387,"_28235":197875,"_5797":198214},[],"Los listados de módulos, `/updatable-distribution-sets`, el `.../artifact-catalog` de un pack, `/version-compliance`, `/version-status` y `/workflows` devuelven todo.",{"_6892":121876,"_42174":121751,"_29767":198216,"_5":21387,"_28235":197875,"_5797":198217},[],"`GET /devices/distribution-set-updates/latest` devuelve todo, tras aplicar los filtros.",{"_6892":121877,"_42174":121751,"_29767":198219,"_5":21387,"_28235":197875,"_5797":198220},[],"En modo hawkBit ningún listado pagina (`next` siempre está vacío). Solo `/devices/distribution-sets` y `/devices/distribution-set-updates/latest`, de ámbito flota, aplican `filter`.",{"_6892":121878,"_42174":121751,"_29767":198222,"_5":21387,"_28235":197875,"_5797":198223},[],"Algunas rutas existen en un solo backend o se comportan de forma distinta. Consulta antes Capabilities.",{"_6892":121879,"_42174":121751,"_29767":198225,"_5":21387,"_28235":197879,"_5797":188971},[],{"_6892":121880,"_42174":121751,"_29767":198227,"_5":21387,"_28235":197879,"_5797":195234},[],{"_6892":121881,"_42174":121751,"_29767":198229,"_5":21387,"_28235":197879,"_5797":189868},[],{"_6892":121882,"_42174":121751,"_29767":198231,"_5":21387,"_28235":197879,"_5797":84023},[],{"_6892":121883,"_42174":121751,"_29767":198233,"_5":21387,"_28235":197879,"_5797":90030},[],{"_6892":121884,"_42174":121751,"_29767":198235,"_5":21387,"_28235":197879,"_5797":198236},[],"Backend activo y lo que admite. Consulta Capabilities",{"_6892":121885,"_42174":121751,"_29767":198238,"_5":21387,"_28235":197879,"_5797":84023},[],{"_6892":121886,"_42174":121751,"_29767":198240,"_5":21387,"_28235":197879,"_5797":90038},[],{"_6892":121887,"_42174":121751,"_29767":198242,"_5":21387,"_28235":197879,"_5797":198243},[],"Workflows registrados en WFX, como `{\"content\": [...]}`. Vacío en modo hawkBit",{"_6892":121888,"_42174":121751,"_29767":198245,"_5":21387,"_28235":197883,"_5797":188971},[],{"_6892":121889,"_42174":121751,"_29767":198247,"_5":21387,"_28235":197883,"_5797":195234},[],{"_6892":121890,"_42174":121751,"_29767":198249,"_5":21387,"_28235":197883,"_5797":189868},[],{"_6892":121891,"_42174":121751,"_29767":198251,"_5":21387,"_28235":197883,"_5797":84591},[],{"_6892":121892,"_42174":121751,"_29767":198253,"_5":21387,"_28235":197883,"_5797":90052},[],{"_6892":121893,"_42174":121751,"_29767":198255,"_5":21387,"_28235":197883,"_5797":198256},[],"Crea un pack",{"_6892":121894,"_42174":121751,"_29767":198258,"_5":21387,"_28235":197883,"_5797":84023},[],{"_6892":121895,"_42174":121751,"_29767":198260,"_5":21387,"_28235":197883,"_5797":90052},[],{"_6892":121896,"_42174":121751,"_29767":198262,"_5":21387,"_28235":197883,"_5797":198263},[],"Lista los packs de un grupo",{"_6892":121897,"_42174":121751,"_29767":198265,"_5":21387,"_28235":197883,"_5797":84023},[],{"_6892":121898,"_42174":121751,"_29767":198267,"_5":21387,"_28235":197883,"_5797":90067},[],{"_6892":121899,"_42174":121751,"_29767":198269,"_5":21387,"_28235":197883,"_5797":198270},[],"Los packs compilados del grupo, que se pueden lanzar",{"_6892":121900,"_42174":121751,"_29767":198272,"_5":21387,"_28235":197883,"_5797":90073},[],{"_6892":121901,"_42174":121751,"_29767":198274,"_5":21387,"_28235":197883,"_5797":90076},[],{"_6892":121902,"_42174":121751,"_29767":198276,"_5":21387,"_28235":197883,"_5797":198277},[],"Elimina un pack. Se rechaza con `400` una vez que un lanzamiento lo ha despachado (native), o mientras una campaña lo retiene (hawkBit)",{"_6892":121903,"_42174":121751,"_29767":198279,"_5":21387,"_28235":197883,"_5797":84591},[],{"_6892":121904,"_42174":121751,"_29767":198281,"_5":21387,"_28235":197883,"_5797":90084},[],{"_6892":121905,"_42174":121751,"_29767":198283,"_5":21387,"_28235":197883,"_5797":198284},[],"Crea una nueva versión de un pack",{"_6892":121906,"_42174":121751,"_29767":198286,"_5":21387,"_28235":197883,"_5797":84023},[],{"_6892":121907,"_42174":121751,"_29767":198288,"_5":21387,"_28235":197883,"_5797":90092},[],{"_6892":121908,"_42174":121751,"_29767":198290,"_5":21387,"_28235":197883,"_5797":198291},[],"Todos los packs de todos los grupos, incluidos los huérfanos",{"_6892":121909,"_42174":121751,"_29767":198293,"_5":21387,"_28235":197883,"_5797":84023},[],{"_6892":121910,"_42174":121751,"_29767":198295,"_5":21387,"_28235":197883,"_5797":90100},[],{"_6892":121911,"_42174":121751,"_29767":198297,"_5":21387,"_28235":197883,"_5797":198298},[],"Instantáneas de versión, por ID único",{"_6892":121912,"_42174":121751,"_29767":198300,"_5":21387,"_28235":197883,"_5797":90073},[],{"_6892":121913,"_42174":121751,"_29767":198302,"_5":21387,"_28235":197883,"_5797":90108},[],{"_6892":121914,"_42174":121751,"_29767":198304,"_5":21387,"_28235":197883,"_5797":198305},[],"Elimina un pack por ID único. Es la única forma de eliminar un pack huérfano",{"_6892":121915,"_42174":121751,"_29767":198307,"_5":21387,"_28235":197887,"_5797":188971},[],{"_6892":121916,"_42174":121751,"_29767":198309,"_5":21387,"_28235":197887,"_5797":198310},[],"Ruta (tras `/groups/:groupID/distribution-sets/:name`)",{"_6892":121917,"_42174":121751,"_29767":198312,"_5":21387,"_28235":197887,"_5797":189868},[],{"_6892":121918,"_42174":121751,"_29767":198314,"_5":21387,"_28235":197887,"_5797":84591},[],{"_6892":121919,"_42174":121751,"_29767":198316,"_5":21387,"_28235":197887,"_5797":90123},[],{"_6892":121920,"_42174":121751,"_29767":198318,"_5":21387,"_28235":197887,"_5797":198319},[],"Sube el sw-description (campo de archivo `file`, hasta 1 MiB en modo native). Modo hawkBit: `400`, usa la ruta del catálogo",{"_6892":121921,"_42174":121751,"_29767":198321,"_5":21387,"_28235":197887,"_5797":84023},[],{"_6892":121922,"_42174":121751,"_29767":198323,"_5":21387,"_28235":197887,"_5797":90131},[],{"_6892":121923,"_42174":121751,"_29767":198325,"_5":21387,"_28235":197887,"_5797":198326},[],"Lo lee, como `text/plain`",{"_6892":121924,"_42174":121751,"_29767":198328,"_5":21387,"_28235":197887,"_5797":84591},[],{"_6892":121925,"_42174":121751,"_29767":198330,"_5":21387,"_28235":197887,"_5797":90139},[],{"_6892":121926,"_42174":121751,"_29767":198332,"_5":21387,"_28235":197887,"_5797":198333},[],"Sube un artefacto global y lo enlaza al pack (campos `file`, `artifact_name`, `version`). `409` si el pack ya está compilado, lo cual ocurre siempre en modo hawkBit",{"_6892":121927,"_42174":121751,"_29767":198335,"_5":21387,"_28235":197887,"_5797":84591},[],{"_6892":121928,"_42174":121751,"_29767":198337,"_5":21387,"_28235":197887,"_5797":90147},[],{"_6892":121929,"_42174":121751,"_29767":198339,"_5":21387,"_28235":197887,"_5797":198340},[],"Enlaza un artefacto global ya subido (cuerpo `{\"artifact_id\":\"...\"}`). `409` si el pack está compilado",{"_6892":121930,"_42174":121751,"_29767":198342,"_5":21387,"_28235":197887,"_5797":90073},[],{"_6892":121931,"_42174":121751,"_29767":198344,"_5":21387,"_28235":197887,"_5797":198345},[],"`/artifact?artifact=<nombre de archivo>`",{"_6892":121932,"_42174":121751,"_29767":198347,"_5":21387,"_28235":197887,"_5797":198348},[],"Elimina un archivo preparado del directorio de compilación. No desenlaza un artefacto del catálogo. Responde `204`. Modo hawkBit: `400`",{"_6892":121933,"_42174":121751,"_29767":198350,"_5":21387,"_28235":197887,"_5797":84023},[],{"_6892":121934,"_42174":121751,"_29767":198352,"_5":21387,"_28235":197887,"_5797":90163},[],{"_6892":121935,"_42174":121751,"_29767":198354,"_5":21387,"_28235":197887,"_5797":198355},[],"Nombres de los archivos preparados en el directorio de compilación, como array simple",{"_6892":121936,"_42174":121751,"_29767":198357,"_5":21387,"_28235":197887,"_5797":84023},[],{"_6892":121937,"_42174":121751,"_29767":198359,"_5":21387,"_28235":197887,"_5797":90171},[],{"_6892":121938,"_42174":121751,"_29767":198361,"_5":21387,"_28235":197887,"_5797":198362},[],"Descarga un archivo preparado por nombre",{"_6892":121939,"_42174":121751,"_29767":198364,"_5":21387,"_28235":197887,"_5797":84023},[],{"_6892":121940,"_42174":121751,"_29767":198366,"_5":21387,"_28235":197887,"_5797":90179},[],{"_6892":121941,"_42174":121751,"_29767":198368,"_5":21387,"_28235":197887,"_5797":198369},[],"Artefactos a los que hace referencia el pack",{"_6892":121942,"_42174":121751,"_29767":198371,"_5":21387,"_28235":197887,"_5797":84023},[],{"_6892":121943,"_42174":121751,"_29767":198373,"_5":21387,"_28235":197887,"_5797":90187},[],{"_6892":121944,"_42174":121751,"_29767":198375,"_5":21387,"_28235":197887,"_5797":198376},[],"Lee las precondiciones de lanzamiento del pack. Responde con el pack completo, con `preconditions`",{"_6892":121945,"_42174":121751,"_29767":198378,"_5":21387,"_28235":197887,"_5797":84032},[],{"_6892":121946,"_42174":121751,"_29767":198380,"_5":21387,"_28235":197887,"_5797":90187},[],{"_6892":121947,"_42174":121751,"_29767":198382,"_5":21387,"_28235":197887,"_5797":198383},[],"Sustituye las precondiciones de lanzamiento del pack. Una lista vacía las borra. Responde con el pack",{"_6892":121948,"_42174":121751,"_29767":198385,"_5":21387,"_28235":197891,"_5797":188971},[],{"_6892":121949,"_42174":121751,"_29767":198387,"_5":21387,"_28235":197891,"_5797":198310},[],{"_6892":121950,"_42174":121751,"_29767":198389,"_5":21387,"_28235":197891,"_5797":189868},[],{"_6892":121951,"_42174":121751,"_29767":198391,"_5":21387,"_28235":197891,"_5797":84591},[],{"_6892":121952,"_42174":121751,"_29767":198393,"_5":21387,"_28235":197891,"_5797":90208},[],{"_6892":121953,"_42174":121751,"_29767":198395,"_5":21387,"_28235":197891,"_5797":198396},[],"Compila el `.swu` (cuerpo: consulta Cuerpos de las peticiones). Modo hawkBit: `501`, compila los módulos",{"_6892":121954,"_42174":121751,"_29767":198398,"_5":21387,"_28235":197891,"_5797":84591},[],{"_6892":121955,"_42174":121751,"_29767":198400,"_5":21387,"_28235":197891,"_5797":90216},[],{"_6892":121956,"_42174":121751,"_29767":198402,"_5":21387,"_28235":197891,"_5797":198403},[],"Compila el `.tar.gz` de un pack `non-swu`. Modo hawkBit: `501`",{"_6892":121957,"_42174":121751,"_29767":198405,"_5":21387,"_28235":197891,"_5797":84591},[],{"_6892":121958,"_42174":121751,"_29767":198407,"_5":21387,"_28235":197891,"_5797":90224},[],{"_6892":121959,"_42174":121751,"_29767":198409,"_5":21387,"_28235":197891,"_5797":198410},[],"Adjunta un entregable compilado externamente (campo de archivo `file`, `user` opcional). Ambas rutas son una sola operación: el empaquetado del pack decide qué archivo se espera. Solo native (`501` en modo hawkBit)",{"_6892":121960,"_42174":121751,"_29767":198412,"_5":21387,"_28235":197891,"_5797":84023},[],{"_6892":121961,"_42174":121751,"_29767":198414,"_5":21387,"_28235":197891,"_5797":90232},[],{"_6892":121962,"_42174":121751,"_29767":198416,"_5":21387,"_28235":197891,"_5797":198417},[],"Descarga el `.swu` compartido actual. Modo hawkBit: `400` para un pack con varios módulos, así que usa `/modules/:moduleKey/artifact/download`",{"_6892":121963,"_42174":121751,"_29767":198419,"_5":21387,"_28235":197891,"_5797":84023},[],{"_6892":121964,"_42174":121751,"_29767":198421,"_5":21387,"_28235":197891,"_5797":90240},[],{"_6892":121965,"_42174":121751,"_29767":198423,"_5":21387,"_28235":197891,"_5797":198424},[],"Descarga el `.swu` de un dispositivo. En un pack con cifrado por dispositivo es el archivo propio de ese dispositivo; en otro caso, el compartido",{"_6892":121966,"_42174":121751,"_29767":198426,"_5":21387,"_28235":197891,"_5797":84023},[],{"_6892":121967,"_42174":121751,"_29767":198428,"_5":21387,"_28235":197891,"_5797":90248},[],{"_6892":121968,"_42174":121751,"_29767":198430,"_5":21387,"_28235":197891,"_5797":198431},[],"Descarga una versión anterior. Modo native: `403` salvo que el pack tenga `allow_previous_version_download`, y `404` si no hay instantánea registrada. El modo hawkBit sirve cualquier versión",{"_6892":121969,"_42174":121751,"_29767":198433,"_5":21387,"_28235":197891,"_5797":84023},[],{"_6892":121970,"_42174":121751,"_29767":198435,"_5":21387,"_28235":197891,"_5797":90256},[],{"_6892":121971,"_42174":121751,"_29767":198437,"_5":21387,"_28235":197891,"_5797":198438},[],"Lo mismo, para packs `non-swu` (`application/gzip`)",{"_6892":121972,"_42174":121751,"_29767":198440,"_5":21387,"_28235":197891,"_5797":84023},[],{"_6892":121973,"_42174":121751,"_29767":198442,"_5":21387,"_28235":197891,"_5797":90264},[],{"_6892":121974,"_42174":121751,"_29767":198444,"_5":21387,"_28235":197891,"_5797":198445},[],"`.tar.gz` con los artefactos de la versión actual",{"_6892":121975,"_42174":121751,"_29767":198447,"_5":21387,"_28235":197891,"_5797":84023},[],{"_6892":121976,"_42174":121751,"_29767":198449,"_5":21387,"_28235":197891,"_5797":90272},[],{"_6892":121977,"_42174":121751,"_29767":198451,"_5":21387,"_28235":197891,"_5797":198452},[],"Manifiesto firmado de la versión actual",{"_6892":121978,"_42174":121751,"_29767":198454,"_5":21387,"_28235":197895,"_5797":188971},[],{"_6892":121979,"_42174":121751,"_29767":198456,"_5":21387,"_28235":197895,"_5797":198310},[],{"_6892":121980,"_42174":121751,"_29767":198458,"_5":21387,"_28235":197895,"_5797":189868},[],{"_6892":121981,"_42174":121751,"_29767":198460,"_5":21387,"_28235":197895,"_5797":84023},[],{"_6892":121982,"_42174":121751,"_29767":198462,"_5":21387,"_28235":197895,"_5797":90286},[],{"_6892":121983,"_42174":121751,"_29767":198464,"_5":21387,"_28235":197895,"_5797":198465},[],"Instantáneas de versión almacenadas",{"_6892":121984,"_42174":121751,"_29767":198467,"_5":21387,"_28235":197895,"_5797":84023},[],{"_6892":121985,"_42174":121751,"_29767":198469,"_5":21387,"_28235":197895,"_5797":90294},[],{"_6892":121986,"_42174":121751,"_29767":198471,"_5":21387,"_28235":197895,"_5797":198472},[],"Una instantánea, con los metadatos del manifiesto",{"_6892":121987,"_42174":121751,"_29767":198474,"_5":21387,"_28235":197895,"_5797":84023},[],{"_6892":121988,"_42174":121751,"_29767":198476,"_5":21387,"_28235":197895,"_5797":90302},[],{"_6892":121989,"_42174":121751,"_29767":198478,"_5":21387,"_28235":197895,"_5797":198479},[],"Manifiesto firmado, firma y certificado",{"_6892":121990,"_42174":121751,"_29767":198481,"_5":21387,"_28235":197895,"_5797":84023},[],{"_6892":121991,"_42174":121751,"_29767":198483,"_5":21387,"_28235":197895,"_5797":90310},[],{"_6892":121992,"_42174":121751,"_29767":198485,"_5":21387,"_28235":197895,"_5797":198486},[],"Módulos de esa versión",{"_6892":121993,"_42174":121751,"_29767":198488,"_5":21387,"_28235":197895,"_5797":84023},[],{"_6892":121994,"_42174":121751,"_29767":198490,"_5":21387,"_28235":197895,"_5797":90318},[],{"_6892":121995,"_42174":121751,"_29767":198492,"_5":21387,"_28235":197895,"_5797":198493},[],"El entregable de un módulo en esa versión. Native: `501`",{"_6892":121996,"_42174":121751,"_29767":198495,"_5":21387,"_28235":197895,"_5797":84023},[],{"_6892":121997,"_42174":121751,"_29767":198497,"_5":21387,"_28235":197895,"_5797":90326},[],{"_6892":121998,"_42174":121751,"_29767":198499,"_5":21387,"_28235":197895,"_5797":198500},[],"`.tar.gz` con los artefactos de esa versión",{"_6892":121999,"_42174":121751,"_29767":198502,"_5":21387,"_28235":197899,"_5797":195234},[],{"_6892":122000,"_42174":121751,"_29767":198504,"_5":21387,"_28235":197899,"_5797":198505},[],"Cuerpo",{"_6892":122001,"_42174":121751,"_29767":198507,"_5":21387,"_28235":197899,"_5797":198508},[],"Crear pack",{"_6892":122002,"_42174":121751,"_29767":198510,"_5":21387,"_28235":197899,"_5797":198511},[],"Obligatorios: `name`, `version` (semver `x.y.z`), `group_id`. Opcionales: `type` (`rawfile` o `firmware`), `packaging` (`swu`, el valor por defecto, o `non-swu`), `allow_previous_version_download`, `modules`, `preconditions`. Cada entrada de `modules` es un módulo nuevo (`type`, `name`, y opcionalmente `version` y `delivery_intent`) o uno existente (`source_module_id`). El modo hawkBit solo acepta entradas `source_module_id`, de módulos **compilados**",{"_6892":122003,"_42174":121751,"_29767":198513,"_5":21387,"_28235":197899,"_5797":90343},[],{"_6892":122004,"_42174":121751,"_29767":198515,"_5":21387,"_28235":197899,"_5797":198516},[],"`{\"version\":\"x.y.z\"}`: semver y mayor que la versión actual, o `400`",{"_6892":122005,"_42174":121751,"_29767":198518,"_5":21387,"_28235":197899,"_5797":90349},[],{"_6892":122006,"_42174":121751,"_29767":198520,"_5":21387,"_28235":197899,"_5797":198521},[],"`{\"preconditions\":[{\"required_distribution_set_name\":\"...\",\"min_version\":\"1.2.0\"}]}`. Usa `required_module_key` (`type:name`) en lugar del nombre del pack para apuntar a un módulo. Exactamente uno de los dos por entrada, y `min_version` debe ser `x.y.z`. Un dispositivo debe cumplir todas las entradas",{"_6892":122007,"_42174":121751,"_29767":198523,"_5":21387,"_28235":197899,"_5797":90355},[],{"_6892":122008,"_42174":121751,"_29767":198525,"_5":21387,"_28235":197899,"_5797":198526},[],"`user`, `encryption_key_name`, `encryption_alg_name`, `sw_desc_encrypted`, `signature_key_id`, `signature_alg_name`, `signature_certificate` (PEM), `selected_artifact_ids`. Todos opcionales, pero `user` es obligatorio junto con `encryption_key_name`. Un cuerpo solo con `encryption_alg_name` solicita cifrado por dispositivo. Un cuerpo vacío o no válido compila sin cifrado. Consulta Firma y cifrado",{"_6892":122009,"_42174":121751,"_29767":198528,"_5":21387,"_28235":197899,"_5797":198529},[],"Los artefactos llegan a una compilación solo mediante `selected_artifact_ids`; sin ellos normalmente no hay nada preparado y la compilación falla. Una compilación sustituye los enlaces de artefactos heredados del pack por los seleccionados.",{"_6892":122010,"_42174":121751,"_29767":198531,"_5":21387,"_28235":197903,"_5797":198532},[],"Las rutas de creación responden `201` con el objeto: un pack, un módulo o, en un lanzamiento, el ID del lanzamiento y el resultado de las precondiciones. `modules` es una entrada de la creación del pack y no se devuelve en las lecturas.",{"_6892":122011,"_42174":121751,"_29767":198534,"_5":21387,"_28235":197903,"_5797":198535},[],"`DELETE` de un pack responde `200` con `{\"message\": \"...\"}`. `POST .../new`, `.../swu` y `.../package` responden `200` con `{\"message\": \"...\"}`.",{"_6892":122012,"_42174":121751,"_29767":198537,"_5":21387,"_28235":197903,"_5797":198538},[],"Las subidas de artefactos responden `{\"msg\": \"...\", \"artifact\": {...}}`: `201` para `POST /artifacts`, `200` para las subidas de ámbito pack y de ámbito módulo.",{"_6892":122013,"_42174":121751,"_29767":198540,"_5":21387,"_28235":197903,"_5797":198541},[],"Las subidas de descriptor sobre un pack o sobre un módulo de un pack responden `{\"msg\": \"...\"}`.",{"_6892":122014,"_42174":121751,"_29767":198543,"_5":21387,"_28235":197903,"_5797":198544},[],"Los listados de módulos responden `{\"modules\": [...]}`. El listado `.../artifacts` de un pack responde un array simple.",{"_6892":122015,"_42174":121751,"_29767":198546,"_5":21387,"_28235":197903,"_5797":198547},[],"Una compilación fallida deja el pack en estado `build_failed`, con el motivo en `last_build_error`. Sigue siendo editable y se puede volver a compilar.",{"_6892":122016,"_42174":121751,"_29767":198549,"_5":21387,"_28235":197907,"_5797":198550},[],"Las definiciones de los campos están en `pkg/models/updates.go` del repositorio. Estos son los campos que más leen los clientes.",{"_6892":122017,"_42174":121751,"_29767":198552,"_5":21387,"_28235":197911,"_5797":194122},[],{"_6892":122018,"_42174":121751,"_29767":198554,"_5":21387,"_28235":197911,"_5797":193986},[],{"_6892":122019,"_42174":121751,"_29767":198556,"_5":21387,"_28235":197911,"_5797":90389},[],{"_6892":122020,"_42174":121751,"_29767":198558,"_5":21387,"_28235":197911,"_5797":198559},[],"Identidad. La versión es semver",{"_6892":122021,"_42174":121751,"_29767":198561,"_5":21387,"_28235":197911,"_5797":86664},[],{"_6892":122022,"_42174":121751,"_29767":198563,"_5":21387,"_28235":197911,"_5797":198564},[],"`rawfile` o `firmware`",{"_6892":122023,"_42174":121751,"_29767":198566,"_5":21387,"_28235":197911,"_5797":88108},[],{"_6892":122024,"_42174":121751,"_29767":198568,"_5":21387,"_28235":197911,"_5797":198569},[],"`swu` o `non-swu`",{"_6892":122025,"_42174":121751,"_29767":198571,"_5":21387,"_28235":197911,"_5797":90405},[],{"_6892":122026,"_42174":121751,"_29767":198573,"_5":21387,"_28235":197911,"_5797":198574},[],"`draft`, `built` o `build_failed`",{"_6892":122027,"_42174":121751,"_29767":198576,"_5":21387,"_28235":197911,"_5797":90411},[],{"_6892":122028,"_42174":121751,"_29767":198578,"_5":21387,"_28235":197911,"_5797":198579},[],"URI de descarga del entregable compilado. Vacía hasta que se compila",{"_6892":122029,"_42174":121751,"_29767":198581,"_5":21387,"_28235":197911,"_5797":90417},[],{"_6892":122030,"_42174":121751,"_29767":198583,"_5":21387,"_28235":197911,"_5797":198584},[],"El texto del sw-description (la clave lleva guion)",{"_6892":122031,"_42174":121751,"_29767":198586,"_5":21387,"_28235":197911,"_5797":90423},[],{"_6892":122032,"_42174":121751,"_29767":198588,"_5":21387,"_28235":197911,"_5797":198589},[],"Vacío, `shared` o `per-device`",{"_6892":122033,"_42174":121751,"_29767":198591,"_5":21387,"_28235":197911,"_5797":90429},[],{"_6892":122034,"_42174":121751,"_29767":198593,"_5":21387,"_28235":197911,"_5797":198594},[],"Ajustes de cifrado de la última compilación",{"_6892":122035,"_42174":121751,"_29767":198596,"_5":21387,"_28235":197911,"_5797":90435},[],{"_6892":122036,"_42174":121751,"_29767":198598,"_5":21387,"_28235":197911,"_5797":198599},[],"Ajustes de firma de la última compilación",{"_6892":122037,"_42174":121751,"_29767":198601,"_5":21387,"_28235":197911,"_5797":90441},[],{"_6892":122038,"_42174":121751,"_29767":198603,"_5":21387,"_28235":197911,"_5797":198604},[],"Solo en compilaciones por dispositivo: cobertura, y los dispositivos sin paquete con su `reason`",{"_6892":122039,"_42174":121751,"_29767":198606,"_5":21387,"_28235":197911,"_5797":88114},[],{"_6892":122040,"_42174":121751,"_29767":198608,"_5":21387,"_28235":197911,"_5797":198609},[],"Si se pueden descargar versiones anteriores",{"_6892":122041,"_42174":121751,"_29767":198611,"_5":21387,"_28235":197911,"_5797":88120},[],{"_6892":122042,"_42174":121751,"_29767":198613,"_5":21387,"_28235":197911,"_5797":198614},[],"Las precondiciones de lanzamiento del pack",{"_6892":122043,"_42174":121751,"_29767":198616,"_5":21387,"_28235":197911,"_5797":90457},[],{"_6892":122044,"_42174":121751,"_29767":198618,"_5":21387,"_28235":197911,"_5797":198619},[],"Por qué falló la última compilación",{"_6892":122045,"_42174":121751,"_29767":198621,"_5":21387,"_28235":197911,"_5797":90463},[],{"_6892":122046,"_42174":121751,"_29767":198623,"_5":21387,"_28235":197911,"_5797":198624},[],"Modo hawkBit: el backend congeló la composición porque el pack se envió a dispositivos",{"_6892":122047,"_42174":121751,"_29767":198626,"_5":21387,"_28235":197911,"_5797":90469},[],{"_6892":122048,"_42174":121751,"_29767":198628,"_5":21387,"_28235":197911,"_5797":198629},[],"Marcas de tiempo",{"_6892":122049,"_42174":121751,"_29767":198631,"_5":21387,"_28235":197914,"_5797":198632},[],"Un lanzamiento lleva `id`, `group_id`, `name`, `description`, `version`, `exec_date`, `scheduled_at`, `status`, los campos de la estrategia (`workflow_type`, `rollout_type`, `rollout_value`, `test_device_id`, `auto`, `approval_threshold`, `error_threshold`, `weight`), `distribution_set_id`, `distribution_set_name`, los contadores `pending_count`, `active_count`, `completed_count`, `failed_count`, `total_devices`, `completed_in_batch`, `test_device_status`, `aborted`, `forced_preconditions` y `precondition_failures`.",{"_6892":122050,"_42174":121751,"_29767":198634,"_5":21387,"_28235":197914,"_5797":198635},[],"`status` es `running` (vacío en un lanzamiento native que aún no ha cambiado de estado, lo que también significa en ejecución), `paused`, `cancelled` o `completed`. `test_device_status` es `pending`, `active`, `completed`, `failed` o `cancelled`.",{"_6892":122051,"_42174":121751,"_29767":198637,"_5":21387,"_28235":197918,"_5797":194122},[],{"_6892":122052,"_42174":121751,"_29767":198639,"_5":21387,"_28235":197918,"_5797":193986},[],{"_6892":122053,"_42174":121751,"_29767":198641,"_5":21387,"_28235":197918,"_5797":90485},[],{"_6892":122054,"_42174":121751,"_29767":198643,"_5":21387,"_28235":197918,"_5797":198644},[],"ID del catálogo y clave `type:name`",{"_6892":122055,"_42174":121751,"_29767":198646,"_5":21387,"_28235":197918,"_5797":90491},[],{"_6892":122056,"_42174":121751,"_29767":198648,"_5":21387,"_28235":197918,"_5797":198649},[],"`type` es `os` o `application`",{"_6892":122057,"_42174":121751,"_29767":198651,"_5":21387,"_28235":197918,"_5797":88583},[],{"_6892":122058,"_42174":121751,"_29767":198653,"_5":21387,"_28235":197918,"_5797":198654},[],"`undecided`, `swu-build`, `swu-prebuilt` o `raw`",{"_6892":122059,"_42174":121751,"_29767":198656,"_5":21387,"_28235":197918,"_5797":90502},[],{"_6892":122060,"_42174":121751,"_29767":198658,"_5":21387,"_28235":197918,"_5797":198659},[],"Si existe su entregable, y si está congelado porque una versión suya ya se ha entregado",{"_6892":122061,"_42174":121751,"_29767":198661,"_5":21387,"_28235":197918,"_5797":90508},[],{"_6892":122062,"_42174":121751,"_29767":198663,"_5":21387,"_28235":197918,"_5797":198664},[],"Los archivos del módulo",{"_6892":122063,"_42174":121751,"_29767":198666,"_5":21387,"_28235":197918,"_5797":90514},[],{"_6892":122064,"_42174":121751,"_29767":198668,"_5":21387,"_28235":197918,"_5797":198669},[],"Cómo se compiló",{"_6892":122065,"_42174":121751,"_29767":198671,"_5":21387,"_28235":197918,"_5797":90520},[],{"_6892":122066,"_42174":121751,"_29767":198673,"_5":21387,"_28235":197918,"_5797":198674},[],"El registro de cambios del operador",{"_6892":122067,"_42174":121751,"_29767":198676,"_5":21387,"_28235":197918,"_5797":90526},[],{"_6892":122068,"_42174":121751,"_29767":198678,"_5":21387,"_28235":197918,"_5797":198679},[],"URI de descarga, marcas de tiempo",{"_6892":122069,"_42174":121751,"_29767":198681,"_5":21387,"_28235":197921,"_5797":198682},[],"`id`, `name`, `version`, `filename`, `checksum` (SHA-256 del archivo), `size` en bytes y `uploaded_at`. El listado de toda la flota añade `distribution_sets`: los packs que lo referencian, cada uno con `distribution_set_id`, `distribution_set_name`, `distribution_set_version` y `group_id`. Un archivo cuyo nombre termina en `.swu` o `.tar.gz` debe serlo realmente, o la subida responde `400`.",{"_6892":122070,"_42174":121751,"_29767":198684,"_5":21387,"_28235":197924,"_5797":188971},[],{"_6892":122071,"_42174":121751,"_29767":198686,"_5":21387,"_28235":197924,"_5797":198310},[],{"_6892":122072,"_42174":121751,"_29767":198688,"_5":21387,"_28235":197924,"_5797":189868},[],{"_6892":122073,"_42174":121751,"_29767":198690,"_5":21387,"_28235":197924,"_5797":84023},[],{"_6892":122074,"_42174":121751,"_29767":198692,"_5":21387,"_28235":197924,"_5797":90543},[],{"_6892":122075,"_42174":121751,"_29767":198694,"_5":21387,"_28235":197924,"_5797":198695},[],"Lista los módulos del pack",{"_6892":122076,"_42174":121751,"_29767":198697,"_5":21387,"_28235":197924,"_5797":84591},[],{"_6892":122077,"_42174":121751,"_29767":198699,"_5":21387,"_28235":197924,"_5797":90543},[],{"_6892":122078,"_42174":121751,"_29767":198701,"_5":21387,"_28235":197924,"_5797":198702},[],"Añade un módulo (cuerpo: `type`, `name`, y opcionalmente `version`, `delivery_intent`). Responde `201`. Modo hawkBit: `400`, crea el módulo en el catálogo",{"_6892":122079,"_42174":121751,"_29767":198704,"_5":21387,"_28235":197924,"_5797":84023},[],{"_6892":122080,"_42174":121751,"_29767":198706,"_5":21387,"_28235":197924,"_5797":90558},[],{"_6892":122081,"_42174":121751,"_29767":198708,"_5":21387,"_28235":197924,"_5797":198709},[],"Módulos de otros packs, ofrecidos para importar. Cada uno informa `shared` y su pack de origen",{"_6892":122082,"_42174":121751,"_29767":198711,"_5":21387,"_28235":197924,"_5797":84591},[],{"_6892":122083,"_42174":121751,"_29767":198713,"_5":21387,"_28235":197924,"_5797":90566},[],{"_6892":122084,"_42174":121751,"_29767":198715,"_5":21387,"_28235":197924,"_5797":198716},[],"Compone a partir de un módulo existente. Responde `201`",{"_6892":122085,"_42174":121751,"_29767":198718,"_5":21387,"_28235":197924,"_5797":84032},[],{"_6892":122086,"_42174":121751,"_29767":198720,"_5":21387,"_28235":197924,"_5797":90574},[],{"_6892":122087,"_42174":121751,"_29767":198722,"_5":21387,"_28235":197924,"_5797":198723},[],"Sustituye el módulo por otra versión de sí mismo (cuerpo `{\"source_module_id\":\"<id del catálogo>\"}`). Native: `501`",{"_6892":122088,"_42174":121751,"_29767":198725,"_5":21387,"_28235":197924,"_5797":90073},[],{"_6892":122089,"_42174":121751,"_29767":198727,"_5":21387,"_28235":197924,"_5797":90574},[],{"_6892":122090,"_42174":121751,"_29767":198729,"_5":21387,"_28235":197924,"_5797":198730},[],"Quita un módulo del pack",{"_6892":122091,"_42174":121751,"_29767":198732,"_5":21387,"_28235":197924,"_5797":84032},[],{"_6892":122092,"_42174":121751,"_29767":198734,"_5":21387,"_28235":197924,"_5797":90589},[],{"_6892":122093,"_42174":121751,"_29767":198736,"_5":21387,"_28235":197924,"_5797":198737},[],"Establece el registro de cambios del operador (cuerpo `{\"notes\":\"...\"}`; vacío lo borra). Permitido en versiones compiladas",{"_6892":122094,"_42174":121751,"_29767":198739,"_5":21387,"_28235":197924,"_5797":84591},[],{"_6892":122095,"_42174":121751,"_29767":198741,"_5":21387,"_28235":197924,"_5797":90597},[],{"_6892":122096,"_42174":121751,"_29767":198743,"_5":21387,"_28235":197924,"_5797":198744},[],"Sube un binario a un módulo (campos `file`, `artifact_name`, `version`). Modo hawkBit: se rechaza, un módulo enlazado está congelado",{"_6892":122097,"_42174":121751,"_29767":198746,"_5":21387,"_28235":197924,"_5797":84591},[],{"_6892":122098,"_42174":121751,"_29767":198748,"_5":21387,"_28235":197924,"_5797":90605},[],{"_6892":122099,"_42174":121751,"_29767":198750,"_5":21387,"_28235":197924,"_5797":198751},[],"Enlaza un artefacto global al módulo (cuerpo `{\"artifact_id\":\"...\"}`). Modo hawkBit: se rechaza",{"_6892":122100,"_42174":121751,"_29767":198753,"_5":21387,"_28235":197924,"_5797":84591},[],{"_6892":122101,"_42174":121751,"_29767":198755,"_5":21387,"_28235":197924,"_5797":90613},[],{"_6892":122102,"_42174":121751,"_29767":198757,"_5":21387,"_28235":197924,"_5797":198758},[],"El sw-description propio de un módulo. Native: `501`. Modo hawkBit: `400`, usa `POST /softwaremodules/by-id/:moduleID/descriptor`",{"_6892":122103,"_42174":121751,"_29767":198760,"_5":21387,"_28235":197924,"_5797":84591},[],{"_6892":122104,"_42174":121751,"_29767":198762,"_5":21387,"_28235":197924,"_5797":90621},[],{"_6892":122105,"_42174":121751,"_29767":198764,"_5":21387,"_28235":197924,"_5797":198765},[],"Compilación de un módulo desde el pack. Siempre se rechaza: `501` en modo native y `400` en modo hawkBit. Usa `POST /softwaremodules/by-id/:moduleID/build`",{"_6892":122106,"_42174":121751,"_29767":198767,"_5":21387,"_28235":197924,"_5797":84023},[],{"_6892":122107,"_42174":121751,"_29767":198769,"_5":21387,"_28235":197924,"_5797":90629},[],{"_6892":122108,"_42174":121751,"_29767":198771,"_5":21387,"_28235":197924,"_5797":198772},[],"Descarga el entregable de un módulo. Native: `501`",{"_6892":122109,"_42174":121751,"_29767":198774,"_5":21387,"_28235":197924,"_5797":198775},[],"Cuerpo de importación: `source_module_id`, o `source_distribution_set_name` y `module_key` (con `source_group_id` y `source_distribution_set_version` opcionales). La intención de entrega de un módulo debe estar decidida y ser compatible con el empaquetado del pack antes de poder importarlo.",{"_6892":122110,"_42174":121751,"_29767":198777,"_5":21387,"_28235":197928,"_5797":198778},[],"Módulos que existen con independencia de cualquier pack. Crea uno con `POST /softwaremodules`, indicando `type`, `name`, `version` y, opcionalmente, `delivery_intent` (por defecto `undecided`). Usa el `id` devuelto en las rutas `by-id`.",{"_6892":122111,"_42174":121751,"_29767":198780,"_5":21387,"_28235":197928,"_5797":188971},[],{"_6892":122112,"_42174":121751,"_29767":198782,"_5":21387,"_28235":197928,"_5797":195234},[],{"_6892":122113,"_42174":121751,"_29767":198784,"_5":21387,"_28235":197928,"_5797":189868},[],{"_6892":122114,"_42174":121751,"_29767":198786,"_5":21387,"_28235":197928,"_5797":84023},[],{"_6892":122115,"_42174":121751,"_29767":198788,"_5":21387,"_28235":197928,"_5797":90649},[],{"_6892":122116,"_42174":121751,"_29767":198790,"_5":21387,"_28235":197928,"_5797":198791},[],"Catálogo de toda la flota, con el pack de origen",{"_6892":122117,"_42174":121751,"_29767":198793,"_5":21387,"_28235":197928,"_5797":84591},[],{"_6892":122118,"_42174":121751,"_29767":198795,"_5":21387,"_28235":197928,"_5797":90649},[],{"_6892":122119,"_42174":121751,"_29767":198797,"_5":21387,"_28235":197928,"_5797":198798},[],"Declara un módulo sin pack todavía. Responde `201`. `type`, `name` y `version` son obligatorios",{"_6892":122120,"_42174":121751,"_29767":198800,"_5":21387,"_28235":197928,"_5797":90073},[],{"_6892":122121,"_42174":121751,"_29767":198802,"_5":21387,"_28235":197928,"_5797":90664},[],{"_6892":122122,"_42174":121751,"_29767":198804,"_5":21387,"_28235":197928,"_5797":198805},[],"Elimina un módulo que ningún pack retiene. `400` si algún pack todavía lo retiene",{"_6892":122123,"_42174":121751,"_29767":198807,"_5":21387,"_28235":197928,"_5797":84023},[],{"_6892":122124,"_42174":121751,"_29767":198809,"_5":21387,"_28235":197928,"_5797":90672},[],{"_6892":122125,"_42174":121751,"_29767":198811,"_5":21387,"_28235":197928,"_5797":198812},[],"Lee un módulo",{"_6892":122126,"_42174":121751,"_29767":198814,"_5":21387,"_28235":197928,"_5797":84032},[],{"_6892":122127,"_42174":121751,"_29767":198816,"_5":21387,"_28235":197928,"_5797":90672},[],{"_6892":122128,"_42174":121751,"_29767":198818,"_5":21387,"_28235":197928,"_5797":198819},[],"Actualiza `delivery_intent` y `release_notes`. Envía al menos uno",{"_6892":122129,"_42174":121751,"_29767":198821,"_5":21387,"_28235":197928,"_5797":84591},[],{"_6892":122130,"_42174":121751,"_29767":198823,"_5":21387,"_28235":197928,"_5797":90687},[],{"_6892":122131,"_42174":121751,"_29767":198825,"_5":21387,"_28235":197928,"_5797":198826},[],"Sube un archivo (campo `file`). Responde `201` con el artefacto",{"_6892":122132,"_42174":121751,"_29767":198828,"_5":21387,"_28235":197928,"_5797":84023},[],{"_6892":122133,"_42174":121751,"_29767":198830,"_5":21387,"_28235":197928,"_5797":90695},[],{"_6892":122134,"_42174":121751,"_29767":198832,"_5":21387,"_28235":197928,"_5797":198833},[],"Descarga un archivo almacenado",{"_6892":122135,"_42174":121751,"_29767":198835,"_5":21387,"_28235":197928,"_5797":90073},[],{"_6892":122136,"_42174":121751,"_29767":198837,"_5":21387,"_28235":197928,"_5797":90703},[],{"_6892":122137,"_42174":121751,"_29767":198839,"_5":21387,"_28235":197928,"_5797":198840},[],"Quita un archivo. Responde `204`",{"_6892":122138,"_42174":121751,"_29767":198842,"_5":21387,"_28235":197928,"_5797":84591},[],{"_6892":122139,"_42174":121751,"_29767":198844,"_5":21387,"_28235":197928,"_5797":90711},[],{"_6892":122140,"_42174":121751,"_29767":198846,"_5":21387,"_28235":197928,"_5797":198847},[],"Sube el sw-description que lee la compilación (campo `file`). Responde con el módulo",{"_6892":122141,"_42174":121751,"_29767":198849,"_5":21387,"_28235":197928,"_5797":84591},[],{"_6892":122142,"_42174":121751,"_29767":198851,"_5":21387,"_28235":197928,"_5797":90719},[],{"_6892":122143,"_42174":121751,"_29767":198853,"_5":21387,"_28235":197928,"_5797":198854},[],"Compila el entregable de este módulo. Solo modo hawkBit (`501` en native). El comportamiento depende de `delivery_intent`. El cuerpo es opcional y admite `user`, `encryption_key_name`, `encryption_alg_name`, `sw_desc_encrypted`, `signature_key_id`, `signature_alg_name`, `signature_certificate`",{"_6892":122144,"_42174":121751,"_29767":198856,"_5":21387,"_28235":197928,"_5797":198857},[],"Se aceptan archivos mientras la entrega es `undecided`. Un módulo `swu-build` admite entradas de compilación y rechaza un `.swu`; un módulo `swu-prebuilt` admite exactamente un `.swu`. Elige una intención de entrega compatible antes de importar el módulo con `source_module_id`. Una vez que un módulo se ha entregado (lo retiene una versión de pack publicada, o hawkBit lo bloqueó) queda bloqueado: su contenido está protegido, mientras que las notas de versión siguen siendo editables. En modo native el pack compila un único `.swu` a partir de las entradas de todos sus módulos, y un SWU precompilado se sube al pack completo en lugar de importarse como entrada de un módulo.",{"_6892":122145,"_42174":121751,"_29767":198859,"_5":21387,"_28235":197932,"_5797":195234},[],{"_6892":122146,"_42174":121751,"_29767":198861,"_5":21387,"_28235":197932,"_5797":198505},[],{"_6892":122147,"_42174":121751,"_29767":198863,"_5":21387,"_28235":197932,"_5797":90732},[],{"_6892":122148,"_42174":121751,"_29767":198865,"_5":21387,"_28235":197932,"_5797":198866},[],"`type` (`os` o `application`), `name` (sin `/` ni `:`), `version`, `delivery_intent`",{"_6892":122149,"_42174":121751,"_29767":198868,"_5":21387,"_28235":197932,"_5797":90738},[],{"_6892":122150,"_42174":121751,"_29767":198870,"_5":21387,"_28235":197932,"_5797":198871},[],"`source_module_id`, o `source_distribution_set_name` y `module_key`",{"_6892":122151,"_42174":121751,"_29767":198873,"_5":21387,"_28235":197932,"_5797":90744},[],{"_6892":122152,"_42174":121751,"_29767":198875,"_5":21387,"_28235":197932,"_5797":198876},[],"`delivery_intent` y/o `release_notes`",{"_6892":122153,"_42174":121751,"_29767":198878,"_5":21387,"_28235":197932,"_5797":198879},[],"Subidas",{"_6892":122154,"_42174":121751,"_29767":198881,"_5":21387,"_28235":197932,"_5797":198882},[],"`multipart/form-data` con el archivo en `file`. Las subidas de artefactos de ámbito pack (`.../artifact/upload`, `.../modules/:moduleKey/artifact/upload`) admiten además `artifact_name` y `version`. `POST /artifacts` admite `name` y `version`. `POST /softwaremodules/by-id/:moduleID/artifacts` solo admite el archivo",{"_6892":122155,"_42174":121751,"_29767":198884,"_5":21387,"_28235":197935,"_5797":188971},[],{"_6892":122156,"_42174":121751,"_29767":198886,"_5":21387,"_28235":197935,"_5797":195234},[],{"_6892":122157,"_42174":121751,"_29767":198888,"_5":21387,"_28235":197935,"_5797":189868},[],{"_6892":122158,"_42174":121751,"_29767":198890,"_5":21387,"_28235":197935,"_5797":84591},[],{"_6892":122159,"_42174":121751,"_29767":198892,"_5":21387,"_28235":197935,"_5797":90163},[],{"_6892":122160,"_42174":121751,"_29767":198894,"_5":21387,"_28235":197935,"_5797":198895},[],"Sube un artefacto independiente (campos `file`, `name`, `version`). Modo hawkBit: solo queda preparado (se descarta a los 30 minutos, en la siguiente subida) y no se puede asociar a un módulo, así que usa `POST /softwaremodules/by-id/:moduleID/artifacts`",{"_6892":122161,"_42174":121751,"_29767":198897,"_5":21387,"_28235":197935,"_5797":84023},[],{"_6892":122162,"_42174":121751,"_29767":198899,"_5":21387,"_28235":197935,"_5797":90163},[],{"_6892":122163,"_42174":121751,"_29767":198901,"_5":21387,"_28235":197935,"_5797":198902},[],"Catálogo de toda la flota, con las referencias de los packs",{"_6892":122164,"_42174":121751,"_29767":198904,"_5":21387,"_28235":197935,"_5797":84023},[],{"_6892":122165,"_42174":121751,"_29767":198906,"_5":21387,"_28235":197935,"_5797":90778},[],{"_6892":122166,"_42174":121751,"_29767":198908,"_5":21387,"_28235":197935,"_5797":198909},[],"Un artefacto",{"_6892":122167,"_42174":121751,"_29767":198911,"_5":21387,"_28235":197935,"_5797":84023},[],{"_6892":122168,"_42174":121751,"_29767":198913,"_5":21387,"_28235":197935,"_5797":90786},[],{"_6892":122169,"_42174":121751,"_29767":198915,"_5":21387,"_28235":197935,"_5797":198916},[],"Descarga el binario",{"_6892":122170,"_42174":121751,"_29767":198918,"_5":21387,"_28235":197935,"_5797":90073},[],{"_6892":122171,"_42174":121751,"_29767":198920,"_5":21387,"_28235":197935,"_5797":90778},[],{"_6892":122172,"_42174":121751,"_29767":198922,"_5":21387,"_28235":197935,"_5797":198923},[],"Elimina. Responde `204`",{"_6892":122173,"_42174":121751,"_29767":198925,"_5":21387,"_28235":197935,"_5797":198926},[],"`name` y `version` son opcionales al subir. `name` toma por defecto el nombre del archivo sin su extensión. Una `version`, si se indica, debe ser `x.y.z` y mayor que cualquier versión existente de ese nombre, o la subida responde `400`.",{"_6892":122174,"_42174":121751,"_29767":198928,"_5":21387,"_28235":197939,"_5797":188971},[],{"_6892":122175,"_42174":121751,"_29767":198930,"_5":21387,"_28235":197939,"_5797":195234},[],{"_6892":122176,"_42174":121751,"_29767":198932,"_5":21387,"_28235":197939,"_5797":189868},[],{"_6892":122177,"_42174":121751,"_29767":198934,"_5":21387,"_28235":197939,"_5797":84591},[],{"_6892":122178,"_42174":121751,"_29767":198936,"_5":21387,"_28235":197939,"_5797":90810},[],{"_6892":122179,"_42174":121751,"_29767":198938,"_5":21387,"_28235":197939,"_5797":198939},[],"Crea un lanzamiento. Con `?dry_run=true`, solo evalúa",{"_6892":122180,"_42174":121751,"_29767":198941,"_5":21387,"_28235":197939,"_5797":84023},[],{"_6892":122181,"_42174":121751,"_29767":198943,"_5":21387,"_28235":197939,"_5797":90810},[],{"_6892":122182,"_42174":121751,"_29767":198945,"_5":21387,"_28235":197939,"_5797":198946},[],"Historial de lanzamientos",{"_6892":122183,"_42174":121751,"_29767":198948,"_5":21387,"_28235":197939,"_5797":84591},[],{"_6892":122184,"_42174":121751,"_29767":198950,"_5":21387,"_28235":197939,"_5797":90825},[],{"_6892":122185,"_42174":121751,"_29767":198952,"_5":21387,"_28235":197939,"_5797":198953},[],"Despacha el siguiente lote",{"_6892":122186,"_42174":121751,"_29767":198955,"_5":21387,"_28235":197939,"_5797":84591},[],{"_6892":122187,"_42174":121751,"_29767":198957,"_5":21387,"_28235":197939,"_5797":90833},[],{"_6892":122188,"_42174":121751,"_29767":198959,"_5":21387,"_28235":197939,"_5797":198960},[],"Pausa. El lote en curso termina",{"_6892":122189,"_42174":121751,"_29767":198962,"_5":21387,"_28235":197939,"_5797":84591},[],{"_6892":122190,"_42174":121751,"_29767":198964,"_5":21387,"_28235":197939,"_5797":90841},[],{"_6892":122191,"_42174":121751,"_29767":198966,"_5":21387,"_28235":197939,"_5797":198967},[],"Reanuda un lanzamiento en pausa",{"_6892":122192,"_42174":121751,"_29767":198969,"_5":21387,"_28235":197939,"_5797":84591},[],{"_6892":122193,"_42174":121751,"_29767":198971,"_5":21387,"_28235":197939,"_5797":90849},[],{"_6892":122194,"_42174":121751,"_29767":198973,"_5":21387,"_28235":197939,"_5797":198974},[],"Vuelve a encolar los dispositivos fallidos y los despliega. `400` si no hay ninguno fallido",{"_6892":122195,"_42174":121751,"_29767":198976,"_5":21387,"_28235":197939,"_5797":84591},[],{"_6892":122196,"_42174":121751,"_29767":198978,"_5":21387,"_28235":197939,"_5797":90857},[],{"_6892":122197,"_42174":121751,"_29767":198980,"_5":21387,"_28235":197939,"_5797":198981},[],"Cancela de forma permanente",{"_6892":122198,"_42174":121751,"_29767":198983,"_5":21387,"_28235":197939,"_5797":84591},[],{"_6892":122199,"_42174":121751,"_29767":198985,"_5":21387,"_28235":197939,"_5797":90865},[],{"_6892":122200,"_42174":121751,"_29767":198987,"_5":21387,"_28235":197939,"_5797":198988},[],"Marca como completado. Modo hawkBit: `501`",{"_6892":122201,"_42174":121751,"_29767":198990,"_5":21387,"_28235":197939,"_5797":84023},[],{"_6892":122202,"_42174":121751,"_29767":198992,"_5":21387,"_28235":197939,"_5797":90873},[],{"_6892":122203,"_42174":121751,"_29767":198994,"_5":21387,"_28235":197939,"_5797":198995},[],"Lee la estrategia",{"_6892":122204,"_42174":121751,"_29767":198997,"_5":21387,"_28235":197939,"_5797":90879},[],{"_6892":122205,"_42174":121751,"_29767":198999,"_5":21387,"_28235":197939,"_5797":90873},[],{"_6892":122206,"_42174":121751,"_29767":199001,"_5":21387,"_28235":197939,"_5797":199002},[],"Actualiza la estrategia. Modo hawkBit: `501`. El pack lanzado no se puede cambiar",{"_6892":122207,"_42174":121751,"_29767":199004,"_5":21387,"_28235":197939,"_5797":199005},[],"Un lanzamiento de otro grupo responde `404`, como si no existiera.",{"_6892":122208,"_42174":121751,"_29767":199007,"_5":21387,"_28235":197939,"_5797":199008},[],"Cuerpo de creación:",{"_6892":122209,"_42174":121751,"_29767":199010,"_5":21387,"_28235":197939,"_5797":194122},[],{"_6892":122210,"_42174":121751,"_29767":199012,"_5":21387,"_28235":197939,"_5797":197665},[],{"_6892":122211,"_42174":121751,"_29767":199014,"_5":21387,"_28235":197939,"_5797":193986},[],{"_6892":122212,"_42174":121751,"_29767":199016,"_5":21387,"_28235":197939,"_5797":90899},[],{"_6892":122213,"_42174":121751,"_29767":199018,"_5":21387,"_28235":197939,"_5797":189875},[],{"_6892":122214,"_42174":121751,"_29767":199020,"_5":21387,"_28235":197939,"_5797":199021},[],"El pack que se lanza. Debe estar compilado",{"_6892":122215,"_42174":121751,"_29767":199023,"_5":21387,"_28235":197939,"_5797":85771},[],{"_6892":122216,"_42174":121751,"_29767":199025,"_5":21387,"_28235":197939,"_5797":189875},[],{"_6892":122217,"_42174":121751,"_29767":199027,"_5":21387,"_28235":197939,"_5797":199028},[],"`direct` o `phased`. Se aceptan los nombres completos de WFX (`wfx.workflow.dau.direct`). Modo hawkBit: `phased` crea una acción soft, cualquier otro valor una forzada",{"_6892":122218,"_42174":121751,"_29767":199030,"_5":21387,"_28235":197939,"_5797":85759},[],{"_6892":122219,"_42174":121751,"_29767":199032,"_5":21387,"_28235":197939,"_5797":189875},[],{"_6892":122220,"_42174":121751,"_29767":199034,"_5":21387,"_28235":197939,"_5797":199035},[],"`fixed` (un número de dispositivos) o `percentage`",{"_6892":122221,"_42174":121751,"_29767":199037,"_5":21387,"_28235":197939,"_5797":85765},[],{"_6892":122222,"_42174":121751,"_29767":199039,"_5":21387,"_28235":197939,"_5797":189875},[],{"_6892":122223,"_42174":121751,"_29767":199041,"_5":21387,"_28235":197939,"_5797":199042},[],"Mayor que 0",{"_6892":122224,"_42174":121751,"_29767":199044,"_5":21387,"_28235":197939,"_5797":85777},[],{"_6892":122225,"_42174":121751,"_29767":199046,"_5":21387,"_28235":197939,"_5797":81448},[],{"_6892":122226,"_42174":121751,"_29767":199048,"_5":21387,"_28235":197939,"_5797":199049},[],"El canario: va solo primero y debe tener éxito antes que el resto",{"_6892":122227,"_42174":121751,"_29767":199051,"_5":21387,"_28235":197939,"_5797":85783},[],{"_6892":122228,"_42174":121751,"_29767":199053,"_5":21387,"_28235":197939,"_5797":81448},[],{"_6892":122229,"_42174":121751,"_29767":199055,"_5":21387,"_28235":197939,"_5797":199056},[],"Libera el siguiente lote automáticamente. Por defecto `false`",{"_6892":122230,"_42174":121751,"_29767":199058,"_5":21387,"_28235":197939,"_5797":85789},[],{"_6892":122231,"_42174":121751,"_29767":199060,"_5":21387,"_28235":197939,"_5797":81448},[],{"_6892":122232,"_42174":121751,"_29767":199062,"_5":21387,"_28235":197939,"_5797":199063},[],"Porcentaje de un lote que debe tener éxito antes del siguiente, de 0 a 100. 0 significa todo el lote",{"_6892":122233,"_42174":121751,"_29767":199065,"_5":21387,"_28235":197939,"_5797":85795},[],{"_6892":122234,"_42174":121751,"_29767":199067,"_5":21387,"_28235":197939,"_5797":81448},[],{"_6892":122235,"_42174":121751,"_29767":199069,"_5":21387,"_28235":197939,"_5797":199070},[],"Porcentaje de todos los dispositivos que pueden fallar antes de cancelar el lanzamiento, de 0 a 100. 0 significa sin límite",{"_6892":122236,"_42174":121751,"_29767":199072,"_5":21387,"_28235":197939,"_5797":88225},[],{"_6892":122237,"_42174":121751,"_29767":199074,"_5":21387,"_28235":197939,"_5797":81448},[],{"_6892":122238,"_42174":121751,"_29767":199076,"_5":21387,"_28235":197939,"_5797":199077},[],"Despliega a todos los dispositivos aunque fallen las precondiciones. Los fallos se registran igualmente",{"_6892":122239,"_42174":121751,"_29767":199079,"_5":21387,"_28235":197939,"_5797":85801},[],{"_6892":122240,"_42174":121751,"_29767":199081,"_5":21387,"_28235":197939,"_5797":81448},[],{"_6892":122241,"_42174":121751,"_29767":199083,"_5":21387,"_28235":197939,"_5797":199084},[],"Hora de inicio en RFC 3339. Native: el servicio inicia el lanzamiento unos 30 segundos después, como mucho. Modo hawkBit: lo inicia el planificador de hawkBit",{"_6892":122242,"_42174":121751,"_29767":199086,"_5":21387,"_28235":197939,"_5797":85807},[],{"_6892":122243,"_42174":121751,"_29767":199088,"_5":21387,"_28235":197939,"_5797":81448},[],{"_6892":122244,"_42174":121751,"_29767":199090,"_5":21387,"_28235":197939,"_5797":199091},[],"Nombre visible (por defecto, el nombre del pack) y notas del operador",{"_6892":122245,"_42174":121751,"_29767":199093,"_5":21387,"_28235":197939,"_5797":85813},[],{"_6892":122246,"_42174":121751,"_29767":199095,"_5":21387,"_28235":197939,"_5797":81448},[],{"_6892":122247,"_42174":121751,"_29767":199097,"_5":21387,"_28235":197939,"_5797":199098},[],"Una pista de prioridad almacenada, de 0 a 1000. Nada la aplica",{"_6892":122248,"_42174":121751,"_29767":199100,"_5":21387,"_28235":197939,"_5797":199101},[],"El cuerpo de actualización de la estrategia admite `workflow_type`, `rollout_type`, `rollout_value` (mayor que 0), `test_device_id`, `auto`, `approval_threshold` y `error_threshold`. Sustituye todos ellos: un campo omitido vuelve a su valor cero, así que envía la estrategia completa.",{"_6892":122249,"_42174":121751,"_29767":199103,"_5":21387,"_28235":197939,"_5797":199104},[],"Una creación responde `201` con `launch_id`, `precondition_failures`, `forced`, `superseded_devices` y `never_seen_devices`. Una simulación (dry run) responde `200` con `qualifying_devices`, `precondition_failures`, `superseded_devices` y `never_seen_devices`. Los dos últimos solo se rellenan en modo hawkBit: dispositivos con una actualización en curso, que la creación del lanzamiento cancela, y dispositivos que nunca han contactado con hawkBit.",{"_6892":122250,"_42174":121751,"_29767":199106,"_5":21387,"_28235":197939,"_5797":199107},[],"Un lanzamiento se rechaza con `400` cuando el pack no está compilado, o cuando un pack con cifrado por dispositivo tiene dispositivos sin paquete (simulaciones incluidas, y `force_preconditions` no lo anula).",{"_6892":122251,"_42174":121751,"_29767":199109,"_5":21387,"_28235":197942,"_5797":188971},[],{"_6892":122252,"_42174":121751,"_29767":199111,"_5":21387,"_28235":197942,"_5797":195234},[],{"_6892":122253,"_42174":121751,"_29767":199113,"_5":21387,"_28235":197942,"_5797":189868},[],{"_6892":122254,"_42174":121751,"_29767":199115,"_5":21387,"_28235":197942,"_5797":84023},[],{"_6892":122255,"_42174":121751,"_29767":199117,"_5":21387,"_28235":197942,"_5797":91001},[],{"_6892":122256,"_42174":121751,"_29767":199119,"_5":21387,"_28235":197942,"_5797":199120},[],"Los jobs de un dispositivo. `404` si el dispositivo no está en el grupo",{"_6892":122257,"_42174":121751,"_29767":199122,"_5":21387,"_28235":197942,"_5797":84023},[],{"_6892":122258,"_42174":121751,"_29767":199124,"_5":21387,"_28235":197942,"_5797":91009},[],{"_6892":122259,"_42174":121751,"_29767":199126,"_5":21387,"_28235":197942,"_5797":199127},[],"El historial de jobs de un dispositivo. `404` si no hay ninguno",{"_6892":122260,"_42174":121751,"_29767":199129,"_5":21387,"_28235":197942,"_5797":84023},[],{"_6892":122261,"_42174":121751,"_29767":199131,"_5":21387,"_28235":197942,"_5797":91017},[],{"_6892":122262,"_42174":121751,"_29767":199133,"_5":21387,"_28235":197942,"_5797":199134},[],"Todos los jobs de un lanzamiento",{"_6892":122263,"_42174":121751,"_29767":199136,"_5":21387,"_28235":197942,"_5797":84032},[],{"_6892":122264,"_42174":121751,"_29767":199138,"_5":21387,"_28235":197942,"_5797":91025},[],{"_6892":122265,"_42174":121751,"_29767":199140,"_5":21387,"_28235":197942,"_5797":199141},[],"Fuerza un job a un estado (cuerpo `state`, y opcionalmente `message`, `progress`, `context`). Solo se registra cuando `enable_test_endpoints` es true. Solo para pruebas: no comprueba la propiedad",{"_6892":122266,"_42174":121751,"_29767":199143,"_5":21387,"_28235":197945,"_5797":188971},[],{"_6892":122267,"_42174":121751,"_29767":199145,"_5":21387,"_28235":197945,"_5797":195234},[],{"_6892":122268,"_42174":121751,"_29767":199147,"_5":21387,"_28235":197945,"_5797":189868},[],{"_6892":122269,"_42174":121751,"_29767":199149,"_5":21387,"_28235":197945,"_5797":84023},[],{"_6892":122270,"_42174":121751,"_29767":199151,"_5":21387,"_28235":197945,"_5797":91039},[],{"_6892":122271,"_42174":121751,"_29767":199153,"_5":21387,"_28235":197945,"_5797":199154},[],"Versiones de pack en todos los dispositivos, filtrable",{"_6892":122272,"_42174":121751,"_29767":199156,"_5":21387,"_28235":197945,"_5797":84023},[],{"_6892":122273,"_42174":121751,"_29767":199158,"_5":21387,"_28235":197945,"_5797":91047},[],{"_6892":122274,"_42174":121751,"_29767":199160,"_5":21387,"_28235":197945,"_5797":199161},[],"Versiones de pack en un dispositivo",{"_6892":122275,"_42174":121751,"_29767":199163,"_5":21387,"_28235":197945,"_5797":84023},[],{"_6892":122276,"_42174":121751,"_29767":199165,"_5":21387,"_28235":197945,"_5797":91055},[],{"_6892":122277,"_42174":121751,"_29767":199167,"_5":21387,"_28235":197945,"_5797":199168},[],"Los packs del dispositivo, cada uno con sus artefactos",{"_6892":122278,"_42174":121751,"_29767":199170,"_5":21387,"_28235":197945,"_5797":84023},[],{"_6892":122279,"_42174":121751,"_29767":199172,"_5":21387,"_28235":197945,"_5797":91063},[],{"_6892":122280,"_42174":121751,"_29767":199174,"_5":21387,"_28235":197945,"_5797":199175},[],"Historial de actualizaciones del dispositivo, el más reciente primero",{"_6892":122281,"_42174":121751,"_29767":199177,"_5":21387,"_28235":197945,"_5797":84023},[],{"_6892":122282,"_42174":121751,"_29767":199179,"_5":21387,"_28235":197945,"_5797":91071},[],{"_6892":122283,"_42174":121751,"_29767":199181,"_5":21387,"_28235":197945,"_5797":199182},[],"El intento de actualización más reciente de cada dispositivo y pack, incluidos los intentos ajenos a cualquier lanzamiento. Los filtros se aplican a ese intento, así que `status[eq]failed` lista los dispositivos cuya última actualización falló",{"_6892":122284,"_42174":121751,"_29767":199184,"_5":21387,"_28235":197949,"_5797":199185},[],"Declara la versión en la que deben estar los dispositivos, y luego informa y corrige la deriva.",{"_6892":122285,"_42174":121751,"_29767":199187,"_5":21387,"_28235":197949,"_5797":188971},[],{"_6892":122286,"_42174":121751,"_29767":199189,"_5":21387,"_28235":197949,"_5797":195234},[],{"_6892":122287,"_42174":121751,"_29767":199191,"_5":21387,"_28235":197949,"_5797":189868},[],{"_6892":122288,"_42174":121751,"_29767":199193,"_5":21387,"_28235":197949,"_5797":84023},[],{"_6892":122289,"_42174":121751,"_29767":199195,"_5":21387,"_28235":197949,"_5797":91088},[],{"_6892":122290,"_42174":121751,"_29767":199197,"_5":21387,"_28235":197949,"_5797":199198},[],"Las últimas versiones declaradas de un grupo",{"_6892":122291,"_42174":121751,"_29767":199200,"_5":21387,"_28235":197949,"_5797":84032},[],{"_6892":122292,"_42174":121751,"_29767":199202,"_5":21387,"_28235":197949,"_5797":91096},[],{"_6892":122293,"_42174":121751,"_29767":199204,"_5":21387,"_28235":197949,"_5797":199205},[],"Declara la última versión de un pack (cuerpo `{\"version\":\"1.2.0\"}`)",{"_6892":122294,"_42174":121751,"_29767":199207,"_5":21387,"_28235":197949,"_5797":90073},[],{"_6892":122295,"_42174":121751,"_29767":199209,"_5":21387,"_28235":197949,"_5797":91096},[],{"_6892":122296,"_42174":121751,"_29767":199211,"_5":21387,"_28235":197949,"_5797":199212},[],"Quita la declaración. Responde `204`",{"_6892":122297,"_42174":121751,"_29767":199214,"_5":21387,"_28235":197949,"_5797":84023},[],{"_6892":122298,"_42174":121751,"_29767":199216,"_5":21387,"_28235":197949,"_5797":91111},[],{"_6892":122299,"_42174":121751,"_29767":199218,"_5":21387,"_28235":197949,"_5797":199219},[],"La deriva de un dispositivo respecto a las últimas versiones de su grupo. `?groupID=` opcional",{"_6892":122300,"_42174":121751,"_29767":199221,"_5":21387,"_28235":197949,"_5797":84591},[],{"_6892":122301,"_42174":121751,"_29767":199223,"_5":21387,"_28235":197949,"_5797":91119},[],{"_6892":122302,"_42174":121751,"_29767":199225,"_5":21387,"_28235":197949,"_5797":199226},[],"Fuerza al dispositivo a coincidir. Responde `202` con la deriva",{"_6892":122303,"_42174":121751,"_29767":199228,"_5":21387,"_28235":197949,"_5797":84591},[],{"_6892":122304,"_42174":121751,"_29767":199230,"_5":21387,"_28235":197949,"_5797":91127},[],{"_6892":122305,"_42174":121751,"_29767":199232,"_5":21387,"_28235":197949,"_5797":199233},[],"Lanza un solo dispositivo a una versión. Responde `202`",{"_6892":122306,"_42174":121751,"_29767":199235,"_5":21387,"_28235":197949,"_5797":84023},[],{"_6892":122307,"_42174":121751,"_29767":199237,"_5":21387,"_28235":197949,"_5797":91135},[],{"_6892":122308,"_42174":121751,"_29767":199239,"_5":21387,"_28235":197949,"_5797":199240},[],"Dispositivos que no están en la última versión, como `{\"group_id\", \"devices\": [...]}`",{"_6892":122309,"_42174":121751,"_29767":199242,"_5":21387,"_28235":197949,"_5797":84023},[],{"_6892":122310,"_42174":121751,"_29767":199244,"_5":21387,"_28235":197949,"_5797":91143},[],{"_6892":122311,"_42174":121751,"_29767":199246,"_5":21387,"_28235":197949,"_5797":199247},[],"La matriz completa por dispositivo, conformes y desactualizados, como `{\"group_id\", \"rows\": [...]}`",{"_6892":122312,"_42174":121751,"_29767":199249,"_5":21387,"_28235":197949,"_5797":199250},[],"`sync-to-latest` admite un cuerpo opcional con `groupID` (también aceptado como `?groupID=`), `distribution_set_ids` para limitar los packs y `workflow`. Si algunos dispositivos no se pudieron despachar responde `207`, o `400` si no se despachó ninguno, con `{\"err\": \"...\", \"drift\": {...}}`.",{"_6892":122313,"_42174":121751,"_29767":199252,"_5":21387,"_28235":197949,"_5797":199253},[],"`force-version` admite `distribution_set_id` y `version` (obligatorios), `group_id` y `workflow`. El dispositivo debe ser miembro del grupo del pack. En un pack `swu`, `workflow` toma por defecto `phased`, y en un pack `non-swu`, `download-install`. El modo native solo acepta la versión actual del pack salvo que el pack tenga `allow_previous_version_download`, y `sync-to-latest` tiene el mismo límite. El modo hawkBit ignora `workflow` en ambas rutas.",{"_6892":122314,"_42174":121751,"_29767":199255,"_5":21387,"_28235":197949,"_5797":199256},[],"Una entrada de deriva tiene `distribution_set_id`, `distribution_set_name`, `current_version`, `latest_version`, `in_sync` y `missing`. Una fila de `version-status` tiene `device_id`, `distribution_set_id`, `distribution_set_name`, `current_version`, `latest_version`, `in_sync` y, cuando es más reciente que la declarada, `newest_version`.",{"_6892":122315,"_42174":121751,"_29767":199258,"_5":21387,"_28235":197953,"_5797":199259},[],"En modo hawkBit el servicio también sirve la URL de artefactos de dispositivo de hawkBit, de modo que un gateway puede publicarla en el mismo host que el resto de la API:",{"_6892":122316,"_42174":121751,"_29767":199261,"_5":21387,"_28235":197953,"_5797":188971},[],{"_6892":122317,"_42174":121751,"_29767":199263,"_5":21387,"_28235":197953,"_5797":195234},[],{"_6892":122318,"_42174":121751,"_29767":199265,"_5":21387,"_28235":197953,"_5797":189868},[],{"_6892":122319,"_42174":121751,"_29767":199267,"_5":21387,"_28235":197953,"_5797":91167},[],{"_6892":122320,"_42174":121751,"_29767":199269,"_5":21387,"_28235":197953,"_5797":91170},[],{"_6892":122321,"_42174":121751,"_29767":199271,"_5":21387,"_28235":197953,"_5797":199272},[],"El artefacto de un módulo, o su archivo auxiliar `.MD5SUM` como `text/plain`",{"_6892":122322,"_42174":121751,"_29767":199274,"_5":21387,"_28235":197953,"_5797":199275},[],"`<prefix>` es la ruta de `hawkbit.ddi_url`, por ejemplo `/api/hawkbit-ddi`. La ruta solo se registra en modo hawkBit. Responde únicamente para módulos del conjunto asignado o instalado del dispositivo, y `404` en otro caso, y `:tenant` debe ser el tenant configurado. Con la firma previa activada responde `302` como las demás descargas.",{"_6892":122323,"_42174":121751,"_29767":199277,"_5":21387,"_28235":197957,"_5797":199278},[],"Se sirve en `/symkms/v1` desde el mismo proceso cuando SymKMS está configurado. Almacena claves simétricas y las asocia a dispositivos. Los cuerpos y formatos de cifrado, descifrado y MAC están en Firma y cifrado. Los errores usan el mismo cuerpo `{\"err\":\"...\"}`.",{"_6892":122324,"_42174":121751,"_29767":199280,"_5":21387,"_28235":197957,"_5797":188971},[],{"_6892":122325,"_42174":121751,"_29767":199282,"_5":21387,"_28235":197957,"_5797":195234},[],{"_6892":122326,"_42174":121751,"_29767":199284,"_5":21387,"_28235":197957,"_5797":189868},[],{"_6892":122327,"_42174":121751,"_29767":199286,"_5":21387,"_28235":197957,"_5797":84591},[],{"_6892":122328,"_42174":121751,"_29767":199288,"_5":21387,"_28235":197957,"_5797":91190},[],{"_6892":122329,"_42174":121751,"_29767":199290,"_5":21387,"_28235":197957,"_5797":199291},[],"Almacena una clave. Cuerpo `user_id`, `algorithm`, `key` (hex o Base64), `id` opcional. Responde `201` con `id`, `user_id`, `algorithm`, `created_at`",{"_6892":122330,"_42174":121751,"_29767":199293,"_5":21387,"_28235":197957,"_5797":84023},[],{"_6892":122331,"_42174":121751,"_29767":199295,"_5":21387,"_28235":197957,"_5797":91198},[],{"_6892":122332,"_42174":121751,"_29767":199297,"_5":21387,"_28235":197957,"_5797":199298},[],"Lista las claves de un usuario. `user_id` es obligatorio. Paginado, filtrable por `user_id`, `algorithm`, `created_at`",{"_6892":122333,"_42174":121751,"_29767":199300,"_5":21387,"_28235":197957,"_5797":90073},[],{"_6892":122334,"_42174":121751,"_29767":199302,"_5":21387,"_28235":197957,"_5797":91206},[],{"_6892":122335,"_42174":121751,"_29767":199304,"_5":21387,"_28235":197957,"_5797":199305},[],"Elimina una clave. `user_id` es obligatorio y debe ser su propietario",{"_6892":122336,"_42174":121751,"_29767":199307,"_5":21387,"_28235":197957,"_5797":84023},[],{"_6892":122337,"_42174":121751,"_29767":199309,"_5":21387,"_28235":197957,"_5797":91214},[],{"_6892":122338,"_42174":121751,"_29767":199311,"_5":21387,"_28235":197957,"_5797":199312},[],"Material de clave en bruto (`key_id`, `key_hex`, `algorithm`). Privilegiada",{"_6892":122339,"_42174":121751,"_29767":199314,"_5":21387,"_28235":197957,"_5797":84591},[],{"_6892":122340,"_42174":121751,"_29767":199316,"_5":21387,"_28235":197957,"_5797":91222},[],{"_6892":122341,"_42174":121751,"_29767":199318,"_5":21387,"_28235":197957,"_5797":199319},[],"Cifra o descifra con una clave almacenada",{"_6892":122342,"_42174":121751,"_29767":199321,"_5":21387,"_28235":197957,"_5797":84591},[],{"_6892":122343,"_42174":121751,"_29767":199323,"_5":21387,"_28235":197957,"_5797":91230},[],{"_6892":122344,"_42174":121751,"_29767":199325,"_5":21387,"_28235":197957,"_5797":199326},[],"Calcula o verifica un MAC (cuerpo JSON)",{"_6892":122345,"_42174":121751,"_29767":199328,"_5":21387,"_28235":197957,"_5797":84591},[],{"_6892":122346,"_42174":121751,"_29767":199330,"_5":21387,"_28235":197957,"_5797":91238},[],{"_6892":122347,"_42174":121751,"_29767":199332,"_5":21387,"_28235":197957,"_5797":199333},[],"Lo mismo, con los datos como `file` subido",{"_6892":122348,"_42174":121751,"_29767":199335,"_5":21387,"_28235":197957,"_5797":84591},[],{"_6892":122349,"_42174":121751,"_29767":199337,"_5":21387,"_28235":197957,"_5797":91246},[],{"_6892":122350,"_42174":121751,"_29767":199339,"_5":21387,"_28235":197957,"_5797":199340},[],"Asigna una clave a un dispositivo. Cuerpo opcional `purpose`, `expires_at` (RFC 3339). Responde `201` con la asociación",{"_6892":122351,"_42174":121751,"_29767":199342,"_5":21387,"_28235":197957,"_5797":90073},[],{"_6892":122352,"_42174":121751,"_29767":199344,"_5":21387,"_28235":197957,"_5797":91246},[],{"_6892":122353,"_42174":121751,"_29767":199346,"_5":21387,"_28235":197957,"_5797":199347},[],"Revoca una clave de un dispositivo",{"_6892":122354,"_42174":121751,"_29767":199349,"_5":21387,"_28235":197957,"_5797":84023},[],{"_6892":122355,"_42174":121751,"_29767":199351,"_5":21387,"_28235":197957,"_5797":91261},[],{"_6892":122356,"_42174":121751,"_29767":199353,"_5":21387,"_28235":197957,"_5797":199354},[],"Las asociaciones de claves de un dispositivo. Paginado, filtrable por `purpose`, `status`, `assigned_at`",{"_6892":122357,"_42174":121751,"_29767":199356,"_5":21387,"_28235":197957,"_5797":84023},[],{"_6892":122358,"_42174":121751,"_29767":199358,"_5":21387,"_28235":197957,"_5797":91269},[],{"_6892":122359,"_42174":121751,"_29767":199360,"_5":21387,"_28235":197957,"_5797":199361},[],"Los dispositivos a los que está asignada una clave, como `key_id` y `device_ids`",{"_6892":122360,"_42174":121751,"_29767":199363,"_5":21387,"_28235":197957,"_5797":84023},[],{"_6892":122361,"_42174":121751,"_29767":199365,"_5":21387,"_28235":197957,"_5797":91277},[],{"_6892":122362,"_42174":121751,"_29767":199367,"_5":21387,"_28235":197957,"_5797":199368},[],"La clave en bruto del dispositivo para un propósito, por defecto `firmware-encryption`. Privilegiada. `404` si no hay asociación",{"_6892":122363,"_42174":121751,"_29767":199370,"_5":21387,"_28235":197957,"_5797":199371},[],"Un `purpose` vacío es un comodín que coincide con cualquier consulta, y un propósito concreto se compara de forma exacta. Las rutas que devuelven material de clave en bruto confían en que el gateway autentique a quien llama: no las expongas sin mTLS o tokens con ámbito. Consulta Seguridad.",{"_6892":122364,"_42174":121751,"_29767":199373,"_5":21387,"_28235":197960,"_5797":199374},[],"Capabilities para saber qué admite cada backend",{"_6892":122365,"_42174":121751,"_29767":199376,"_5":21387,"_28235":197960,"_5797":195981},[],{"_6892":122366,"_42174":121751,"_29767":199378,"_5":21387,"_28235":197960,"_5797":195687},[],{"_6892":122367,"_42174":122367,"_5":21817,"_5797":88773,"_42654":199380,"_29767":199381,"_28235":122367},[77248,187247,193621,197856],[],{"_6892":122368,"_42174":122367,"_29767":199383,"_5":21387,"_28235":122367,"_5797":199384},[],"Las 22 capacidades de Lamassu Updates, qué admite cada backend y cómo las lee un cliente.",{"_6892":122369,"_42174":122367,"_5":42651,"_29767":199386,"_28235":199387,"_5797":199388},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/capabilities#lee-las-capacidades","Lee las capacidades",{"_6892":122370,"_42174":122367,"_5":42651,"_29767":199390,"_28235":199391,"_5797":199392},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/capabilities#soporte-por-backend","Soporte por backend",{"_6892":122371,"_42174":122367,"_5":42651,"_29767":199394,"_28235":199395,"_5797":199396},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/capabilities#capacidades-condicionales-en-modo-hawkbit","Capacidades condicionales en modo hawkBit",{"_6892":122372,"_42174":122367,"_5":42651,"_29767":199398,"_28235":199399,"_5797":199400},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/capabilities#capacidades-cuyo-significado-cambia","Capacidades cuyo significado cambia",{"_6892":122373,"_42174":122367,"_5":42651,"_29767":199402,"_28235":199403,"_5797":199404},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/capabilities#qué-debe-hacer-un-cliente","Qué debe hacer un cliente",{"_6892":122374,"_42174":122367,"_5":42651,"_29767":199406,"_28235":199407,"_5797":188883},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/capabilities#siguientes-pasos",{"_6892":122375,"_42174":122367,"_29767":199409,"_5":21387,"_28235":122367,"_5797":199410},[],"`GET /updates/v1/capabilities` indica a un cliente qué backend está activo (`native` o `hawkbit&#x60;) y cuáles de las 22 funciones admite. Léela una vez y oculta lo que no aplique. Una operación que el backend no implementa responde &#x2A;*`501 Not Implemented`**, nunca `500`; un `501` es una propiedad permanente del despliegue, así que reintentar no sirve de nada. La única excepción es `GET /workflows`, que en modo hawkBit responde una lista vacía.",{"_6892":122376,"_42174":122367,"_29767":199412,"_5":21387,"_28235":199387,"_5797":199413},[],"La ruta no recibe parámetros y no tiene efectos secundarios. El servicio la sirve sin autenticación, igual que `/health`; un gateway delante de él puede seguir exigiendo un token.",{"_6892":122377,"_42174":122367,"_29767":199415,"_5":21387,"_28235":199387,"_5797":199416},[],"La respuesta tiene tres campos:",{"_6892":122378,"_42174":122367,"_29767":199418,"_5":21387,"_28235":199387,"_5797":194122},[],{"_6892":122379,"_42174":122367,"_29767":199420,"_5":21387,"_28235":199387,"_5797":189862},[],{"_6892":122380,"_42174":122367,"_29767":199422,"_5":21387,"_28235":199387,"_5797":193986},[],{"_6892":122381,"_42174":122367,"_29767":199424,"_5":21387,"_28235":199387,"_5797":91337},[],{"_6892":122382,"_42174":122367,"_29767":199426,"_5":21387,"_28235":199387,"_5797":34761},[],{"_6892":122383,"_42174":122367,"_29767":199428,"_5":21387,"_28235":199387,"_5797":199429},[],"`native` o `hawkbit`",{"_6892":122384,"_42174":122367,"_29767":199431,"_5":21387,"_28235":199387,"_5797":91345},[],{"_6892":122385,"_42174":122367,"_29767":199433,"_5":21387,"_28235":199387,"_5797":25581},[],{"_6892":122386,"_42174":122367,"_29767":199435,"_5":21387,"_28235":199387,"_5797":199436},[],"Un booleano por capacidad. Siempre incluye las 22 claves, así que una clave ausente indica una diferencia de versión entre cliente y servidor, no que esté admitida",{"_6892":122387,"_42174":122367,"_29767":199438,"_5":21387,"_28235":199387,"_5797":91353},[],{"_6892":122388,"_42174":122367,"_29767":199440,"_5":21387,"_28235":199387,"_5797":199441},[],"array de strings",{"_6892":122389,"_42174":122367,"_29767":199443,"_5":21387,"_28235":199387,"_5797":199444},[],"Las capacidades en `false`, repetidas por comodidad, en el orden de la tabla siguiente",{"_6892":122390,"_42174":122367,"_29767":199446,"_5":21387,"_28235":199387,"_5797":199447},[],"Un ejemplo para un despliegue native:",{"_6892":122391,"_42174":122367,"_29767":199449,"_5":21387,"_28235":199391,"_5797":199450},[],"«Sí» significa admitido. «Condicional» significa que depende de la configuración o del servidor hawkBit; consulta las notas tras la tabla.",{"_6892":122392,"_42174":122367,"_29767":199452,"_5":21387,"_28235":199391,"_5797":199453},[],"Capacidad",{"_6892":122393,"_42174":122367,"_29767":199455,"_5":21387,"_28235":199391,"_5797":33773},[],{"_6892":122394,"_42174":122367,"_29767":199457,"_5":21387,"_28235":199391,"_5797":30159},[],{"_6892":122395,"_42174":122367,"_29767":199459,"_5":21387,"_28235":199391,"_5797":199460},[],"`latest_versions`: declarar la última versión por grupo, más la deriva por dispositivo y la sincronización forzada",{"_6892":122396,"_42174":122367,"_29767":199462,"_5":21387,"_28235":199391,"_5797":189875},[],{"_6892":122397,"_42174":122367,"_29767":199464,"_5":21387,"_28235":199391,"_5797":189875},[],{"_6892":122398,"_42174":122367,"_29767":199466,"_5":21387,"_28235":199391,"_5797":199467},[],"`version_compliance`: informes de conformidad y estado de versión de todo el grupo",{"_6892":122399,"_42174":122367,"_29767":199469,"_5":21387,"_28235":199391,"_5797":189875},[],{"_6892":122400,"_42174":122367,"_29767":199471,"_5":21387,"_28235":199391,"_5797":189875},[],{"_6892":122401,"_42174":122367,"_29767":199473,"_5":21387,"_28235":199391,"_5797":199474},[],"`artifact_signatures`: manifiestos de versión firmados y el archivo de artefactos",{"_6892":122402,"_42174":122367,"_29767":199476,"_5":21387,"_28235":199391,"_5797":189875},[],{"_6892":122403,"_42174":122367,"_29767":199478,"_5":21387,"_28235":199391,"_5797":189875},[],{"_6892":122404,"_42174":122367,"_29767":199480,"_5":21387,"_28235":199391,"_5797":199481},[],"`artifact_encryption`: cifrado con clave compartida y firma con KMS durante la compilación",{"_6892":122405,"_42174":122367,"_29767":199483,"_5":21387,"_28235":199391,"_5797":189875},[],{"_6892":122406,"_42174":122367,"_29767":199485,"_5":21387,"_28235":199391,"_5797":199486},[],"Condicional",{"_6892":122407,"_42174":122367,"_29767":199488,"_5":21387,"_28235":199391,"_5797":199489},[],"`per_device_encryption`: un entregable por dispositivo, cada uno con su propia clave",{"_6892":122408,"_42174":122367,"_29767":199491,"_5":21387,"_28235":199391,"_5797":189875},[],{"_6892":122409,"_42174":122367,"_29767":199493,"_5":21387,"_28235":199391,"_5797":91409},[],{"_6892":122410,"_42174":122367,"_29767":199495,"_5":21387,"_28235":199391,"_5797":199496},[],"`artifact_download_by_name`: descargar un archivo preparado de un pack por nombre",{"_6892":122411,"_42174":122367,"_29767":199498,"_5":21387,"_28235":199391,"_5797":189875},[],{"_6892":122412,"_42174":122367,"_29767":199500,"_5":21387,"_28235":199391,"_5797":189875},[],{"_6892":122413,"_42174":122367,"_29767":199502,"_5":21387,"_28235":199391,"_5797":199503},[],"`workflows`: elegir el workflow de WFX por lanzamiento",{"_6892":122414,"_42174":122367,"_29767":199505,"_5":21387,"_28235":199391,"_5797":189875},[],{"_6892":122415,"_42174":122367,"_29767":199507,"_5":21387,"_28235":199391,"_5797":91409},[],{"_6892":122416,"_42174":122367,"_29767":199509,"_5":21387,"_28235":199391,"_5797":199510},[],"`launch_strategy_update`: editar la estrategia tras crear el lanzamiento",{"_6892":122417,"_42174":122367,"_29767":199512,"_5":21387,"_28235":199391,"_5797":189875},[],{"_6892":122418,"_42174":122367,"_29767":199514,"_5":21387,"_28235":199391,"_5797":91409},[],{"_6892":122419,"_42174":122367,"_29767":199516,"_5":21387,"_28235":199391,"_5797":199517},[],"`launch_complete`: marcar un lanzamiento como completado antes de tiempo",{"_6892":122420,"_42174":122367,"_29767":199519,"_5":21387,"_28235":199391,"_5797":189875},[],{"_6892":122421,"_42174":122367,"_29767":199521,"_5":21387,"_28235":199391,"_5797":91409},[],{"_6892":122422,"_42174":122367,"_29767":199523,"_5":21387,"_28235":199391,"_5797":199524},[],"`launch_device_assignment`: añadir dispositivos a un lanzamiento tras crearlo (una operación del servicio sin ruta HTTP)",{"_6892":122423,"_42174":122367,"_29767":199526,"_5":21387,"_28235":199391,"_5797":189875},[],{"_6892":122424,"_42174":122367,"_29767":199528,"_5":21387,"_28235":199391,"_5797":91409},[],{"_6892":122425,"_42174":122367,"_29767":199530,"_5":21387,"_28235":199391,"_5797":199531},[],"`scheduled_launch`: iniciar un lanzamiento en un momento futuro",{"_6892":122426,"_42174":122367,"_29767":199533,"_5":21387,"_28235":199391,"_5797":199534},[],"Sí (el servicio sondea)",{"_6892":122427,"_42174":122367,"_29767":199536,"_5":21387,"_28235":199391,"_5797":199537},[],"Sí (el planificador propio de hawkBit)",{"_6892":122428,"_42174":122367,"_29767":199539,"_5":21387,"_28235":199391,"_5797":199540},[],"`push_events`: estado de los jobs enviado por el servidor",{"_6892":122429,"_42174":122367,"_29767":199542,"_5":21387,"_28235":199391,"_5797":189875},[],{"_6892":122430,"_42174":122367,"_29767":199544,"_5":21387,"_28235":199391,"_5797":199545},[],"**No** (sondeo)",{"_6892":122431,"_42174":122367,"_29767":199547,"_5":21387,"_28235":199391,"_5797":199548},[],"`launch_preconditions`: acotar los dispositivos desplegables según las versiones instaladas",{"_6892":122432,"_42174":122367,"_29767":199550,"_5":21387,"_28235":199391,"_5797":189875},[],{"_6892":122433,"_42174":122367,"_29767":199552,"_5":21387,"_28235":199391,"_5797":189875},[],{"_6892":122434,"_42174":122367,"_29767":199554,"_5":21387,"_28235":199391,"_5797":199555},[],"`campaigns`: planificar, iniciar, pausar, reanudar, cancelar y reintentar los fallidos",{"_6892":122435,"_42174":122367,"_29767":199557,"_5":21387,"_28235":199391,"_5797":189875},[],{"_6892":122436,"_42174":122367,"_29767":199559,"_5":21387,"_28235":199391,"_5797":189875},[],{"_6892":122437,"_42174":122367,"_29767":199561,"_5":21387,"_28235":199391,"_5797":199562},[],"`canary_device`: el primer lote es un dispositivo concreto",{"_6892":122438,"_42174":122367,"_29767":199564,"_5":21387,"_28235":199391,"_5797":189875},[],{"_6892":122439,"_42174":122367,"_29767":199566,"_5":21387,"_28235":199391,"_5797":189875},[],{"_6892":122440,"_42174":122367,"_29767":199568,"_5":21387,"_28235":199391,"_5797":199569},[],"`device_inventory`: qué versión de pack tiene un dispositivo y su historial de actualizaciones",{"_6892":122441,"_42174":122367,"_29767":199571,"_5":21387,"_28235":199391,"_5797":189875},[],{"_6892":122442,"_42174":122367,"_29767":199573,"_5":21387,"_28235":199391,"_5797":189875},[],{"_6892":122443,"_42174":122367,"_29767":199575,"_5":21387,"_28235":199391,"_5797":199576},[],"`artifact_catalog`: catálogo de artefactos de toda la flota y listado por pack",{"_6892":122444,"_42174":122367,"_29767":199578,"_5":21387,"_28235":199391,"_5797":189875},[],{"_6892":122445,"_42174":122367,"_29767":199580,"_5":21387,"_28235":199391,"_5797":189875},[],{"_6892":122446,"_42174":122367,"_29767":199582,"_5":21387,"_28235":199391,"_5797":199583},[],"`prebuilt_deliverable`: adjuntar a un pack un archivo compilado externamente",{"_6892":122447,"_42174":122367,"_29767":199585,"_5":21387,"_28235":199391,"_5797":189875},[],{"_6892":122448,"_42174":122367,"_29767":199587,"_5":21387,"_28235":199391,"_5797":91409},[],{"_6892":122449,"_42174":122367,"_29767":199589,"_5":21387,"_28235":199391,"_5797":199590},[],"`software_module_composition`: un pack es una composición de módulos tipados",{"_6892":122450,"_42174":122367,"_29767":199592,"_5":21387,"_28235":199391,"_5797":189875},[],{"_6892":122451,"_42174":122367,"_29767":199594,"_5":21387,"_28235":199391,"_5797":199486},[],{"_6892":122452,"_42174":122367,"_29767":199596,"_5":21387,"_28235":199391,"_5797":199597},[],"`software_module_deliverables`: cada módulo tiene su propio entregable",{"_6892":122453,"_42174":122367,"_29767":199599,"_5":21387,"_28235":199391,"_5797":91409},[],{"_6892":122454,"_42174":122367,"_29767":199601,"_5":21387,"_28235":199391,"_5797":189875},[],{"_6892":122455,"_42174":122367,"_29767":199603,"_5":21387,"_28235":199391,"_5797":199604},[],"`standalone_software_modules`: crear un módulo sin pack",{"_6892":122456,"_42174":122367,"_29767":199606,"_5":21387,"_28235":199391,"_5797":189875},[],{"_6892":122457,"_42174":122367,"_29767":199608,"_5":21387,"_28235":199391,"_5797":199486},[],{"_6892":122458,"_42174":122367,"_29767":199610,"_5":21387,"_28235":199391,"_5797":199611},[],"`software_module_replace`: sustituir un módulo por otra versión de sí mismo",{"_6892":122459,"_42174":122367,"_29767":199613,"_5":21387,"_28235":199391,"_5797":91409},[],{"_6892":122460,"_42174":122367,"_29767":199615,"_5":21387,"_28235":199391,"_5797":199486},[],{"_6892":122461,"_42174":122367,"_29767":199617,"_5":21387,"_28235":199395,"_5797":199618},[],"**`artifact_encryption`** se informa como no admitida solo cuando no está configurado ninguno de `swugenerator_path`, `symkms_endpoint` y `kms_endpoint`. Cada opción de compilación sigue necesitando su propia configuración: consulta Firma y cifrado.",{"_6892":122462,"_42174":122367,"_29767":199620,"_5":21387,"_28235":199395,"_5797":199621},[],"**`software_module_composition`, `standalone_software_modules` y `software_module_replace`** dependen de que el servidor hawkBit tenga los tipos de módulo preinstalados `os` y `application` y el tipo de conjunto `os_app` o `app`. El servicio lo sondea con un timeout de 5 segundos, guarda el resultado unos cinco minutos y asume que hay soporte cuando hawkBit no responde. Si el sondeo falla, las tres capacidades se informan juntas como no admitidas.",{"_6892":122463,"_42174":122367,"_29767":199623,"_5":21387,"_28235":199395,"_5797":199624},[],"**`software_module_deliverables`** siempre se informa como admitida en modo hawkBit. Compilar un módulo `swu-build` sigue necesitando un `swugenerator_path`; sin él, la compilación responde `501`.",{"_6892":122464,"_42174":122367,"_29767":199626,"_5":21387,"_28235":199395,"_5797":199627},[],"**`prebuilt_deliverable`**: un pack de hawkBit nunca se compila directamente. Un módulo `swu-prebuilt` del catálogo acepta en su lugar un `.swu` terminado.",{"_6892":122465,"_42174":122367,"_29767":199629,"_5":21387,"_28235":199399,"_5797":199630},[],"Ambos backends informan `software_module_composition`, pero importar un módulo lo **enlaza** en modo hawkBit (ambos packs comparten un único módulo) y lo **copia** en modo native. La lista de módulos reutilizables lo indica por candidato en su campo `shared`, de modo que un cliente puede decirle al operador cuál de los dos casos tiene. Consulta Conceptos.",{"_6892":122466,"_42174":122367,"_29767":199632,"_5":21387,"_28235":199399,"_5797":199633},[],"En modo native un lanzamiento despacha un job por dispositivo con una única URI de descarga, así que un módulo no tiene entregable propio: el pack compila un único `.swu` a partir de las entradas de todos sus módulos. Por eso `software_module_deliverables` y `software_module_replace` no están admitidas allí.",{"_6892":122467,"_42174":122367,"_29767":199635,"_5":21387,"_28235":199403,"_5797":199636},[],"Llama a `capabilities` una vez al arrancar y antes de mostrar una función que la tabla marque como dependiente del backend.",{"_6892":122468,"_42174":122367,"_29767":199638,"_5":21387,"_28235":199403,"_5797":199639},[],"Trata un `501` en una ruta como definitivo: oculta la acción en lugar de reintentar.",{"_6892":122469,"_42174":122367,"_29767":199641,"_5":21387,"_28235":199403,"_5797":199642},[],"No deduzcas el backend por la URL. Ambos sirven las mismas rutas `/updates/v1`; consulta la Referencia de la API para saber qué rutas responden `501` en cada backend.",{"_6892":122470,"_42174":122367,"_29767":199644,"_5":21387,"_28235":199403,"_5797":199645},[],"Vuelve a leer las capacidades tras cambiar los tipos de módulo de hawkBit o la configuración de compilación.",{"_6892":122471,"_42174":122367,"_29767":199647,"_5":21387,"_28235":199407,"_5797":195977},[],{"_6892":122472,"_42174":122367,"_29767":199649,"_5":21387,"_28235":199407,"_5797":193637},[],{"_6892":122473,"_42174":122473,"_5":21817,"_5797":199651,"_42654":199652,"_29767":199653,"_28235":122473},"Referencia de configuración",[77248,187247,193621,197856],[],{"_6892":122474,"_42174":122473,"_29767":199655,"_5":21387,"_28235":122473,"_5797":199656},[],"Todas las claves de configuración de Lamassu Updates, su valor por defecto, qué backend las lee y cómo sobrescribirlas con variables de entorno.",{"_6892":122475,"_42174":122473,"_5":42651,"_29767":199658,"_28235":199659,"_5797":199660},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#cómo-se-carga-la-configuración","Cómo se carga la configuración",{"_6892":122476,"_42174":122473,"_5":42651,"_29767":199662,"_28235":199663,"_5797":199664},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#qué-claves-lee-cada-modo","Qué claves lee cada modo",{"_6892":122477,"_42174":122473,"_5":42651,"_29767":199666,"_28235":199667,"_5797":199668},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#ajustes-generales-y-del-servidor","Ajustes generales y del servidor",{"_6892":122478,"_42174":122473,"_5":42651,"_29767":199670,"_28235":199671,"_5797":199672},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#base-de-datos","Base de datos",{"_6892":122479,"_42174":122473,"_5":42651,"_29767":199674,"_28235":199675,"_5797":199676},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#endpoints-de-otros-servicios","Endpoints de otros servicios",{"_6892":122480,"_42174":122473,"_5":42651,"_29767":199678,"_28235":199679,"_5797":199680},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#construcción-y-firma","Construcción y firma",{"_6892":122481,"_42174":122473,"_5":42651,"_29767":199682,"_28235":199683,"_5797":199684},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#límites-de-subida","Límites de subida",{"_6892":122482,"_42174":122473,"_5":42651,"_29767":199686,"_28235":199687,"_5797":199688},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#bloques-de-almacenamiento-de-blobs","Bloques de almacenamiento de blobs",{"_6892":122483,"_42174":122473,"_5":42651,"_29767":199690,"_28235":199691,"_5797":199692},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#almacenamiento-storage","Almacenamiento (`*.storage`)",{"_6892":122484,"_42174":122473,"_5":42651,"_29767":199694,"_28235":199695,"_5797":199696},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#cifrado-en-reposo-encryption","Cifrado en reposo (`*.encryption`)",{"_6892":122485,"_42174":122473,"_5":42651,"_29767":199698,"_28235":199699,"_5797":199700},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#descargas-prefirmadas-presign","Descargas prefirmadas (`*.presign`)",{"_6892":122486,"_42174":122473,"_5":42651,"_29767":199702,"_28235":199703,"_5797":199704},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#bloque-hawkbit","Bloque `hawkbit`",{"_6892":122487,"_42174":122473,"_5":42651,"_29767":199706,"_28235":199707,"_5797":199708},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#variables-de-entorno","Variables de entorno",{"_6892":122488,"_42174":122473,"_5":42651,"_29767":199710,"_28235":199711,"_5797":199712},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#configuraciones-mínimas","Configuraciones mínimas",{"_6892":122489,"_42174":122473,"_5":42651,"_29767":199714,"_28235":199715,"_5797":199716},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#symkms-como-proceso-independiente","SymKMS como proceso independiente",{"_6892":122490,"_42174":122473,"_5":42651,"_29767":199718,"_28235":199719,"_5797":199720},[],"/docs/pr-preview/pr-56/es/platform/updates/reference/configuration#páginas-relacionadas","Páginas relacionadas",{"_6892":122491,"_42174":122473,"_29767":199722,"_5":21387,"_28235":122473,"_5797":199723},[],"Lamassu Updates lee un único fichero YAML al arrancar. Esta página lista todas las claves que lee el código, su valor por defecto y qué backend (`native` o `hawkbit`) las usa. Las claves que aparecen en los ficheros de ejemplo pero no se leen se indican aparte para que no confíes en ellas.",{"_6892":122492,"_42174":122473,"_29767":199725,"_5":21387,"_28235":199659,"_5797":199726},[],"Indica la ubicación del fichero con la variable de entorno `OTA_CONFIG_FILE`. Si no está definida, el servicio lee `/etc/lamassuiot/config.yml`, que es donde la imagen Docker y el chart de Helm lo montan.",{"_6892":122493,"_42174":122473,"_29767":199728,"_5":21387,"_28235":199659,"_5797":199729},[],"Si `OTA_CONFIG_FILE` apunta a un fichero que no se puede cargar (no existe, o el YAML no es válido), el servicio registra una advertencia y &#x2A;*recurre a `/etc/lamassuiot/config.yml`**. En la imagen Docker esa ruta contiene el `config.yml` de desarrollo del repositorio, así que un error al escribir la ruta puede arrancar el servicio con una configuración equivocada. Si esa alternativa también falla, el servicio termina.",{"_6892":122494,"_42174":122473,"_29767":199731,"_5":21387,"_28235":199659,"_5797":199732},[],"El fichero se lee una sola vez. Reinicia el servicio tras cualquier cambio.",{"_6892":122495,"_42174":122473,"_29767":199734,"_5":21387,"_28235":199659,"_5797":199735},[],"`LAMASSU_CONFIG_FILE`, que definen el Dockerfile y el chart de Helm, no lo lee el código. Solo importa `OTA_CONFIG_FILE`.",{"_6892":122496,"_42174":122473,"_29767":199737,"_5":21387,"_28235":199659,"_5797":199738},[],"Cualquier clave se puede sobrescribir con una variable de entorno. Consulta Variables de entorno.",{"_6892":122497,"_42174":122473,"_29767":199740,"_5":21387,"_28235":199659,"_5797":199741},[],"El repositorio incluye tres ejemplos:",{"_6892":122498,"_42174":122473,"_29767":199743,"_5":21387,"_28235":199659,"_5797":199744},[],"Fichero",{"_6892":122499,"_42174":122473,"_29767":199746,"_5":21387,"_28235":199659,"_5797":199747},[],"Para",{"_6892":122500,"_42174":122473,"_29767":199749,"_5":21387,"_28235":199659,"_5797":91666},[],{"_6892":122501,"_42174":122473,"_29767":199751,"_5":21387,"_28235":199659,"_5797":199752},[],"Desarrollo local en modo `native`",{"_6892":122502,"_42174":122473,"_29767":199754,"_5":21387,"_28235":199659,"_5797":91672},[],{"_6892":122503,"_42174":122473,"_29767":199756,"_5":21387,"_28235":199659,"_5797":199757},[],"El contenedor `updates` de `docker-compose.yml`",{"_6892":122504,"_42174":122473,"_29767":199759,"_5":21387,"_28235":199659,"_5797":91678},[],{"_6892":122505,"_42174":122473,"_29767":199761,"_5":21387,"_28235":199659,"_5797":199762},[],"Desarrollo local en modo `hawkbit` contra el hawkBit del fichero compose (puerto 8090 del host)",{"_6892":122506,"_42174":122473,"_29767":199764,"_5":21387,"_28235":199659,"_5797":199765},[],"Los ejemplos contienen valores de una máquina de desarrollo (rutas absolutas y direcciones de red local) y secretos de desarrollo. Sustitúyelos todos y no reutilices nunca sus claves ni contraseñas.",{"_6892":122507,"_42174":122473,"_29767":199767,"_5":21387,"_28235":199663,"_5797":193554},[],{"_6892":122508,"_42174":122473,"_29767":199769,"_5":21387,"_28235":199663,"_5797":89209},[],{"_6892":122509,"_42174":122473,"_29767":199771,"_5":21387,"_28235":199663,"_5797":86482},[],{"_6892":122510,"_42174":122473,"_29767":199773,"_5":21387,"_28235":199663,"_5797":91693},[],{"_6892":122511,"_42174":122473,"_29767":199775,"_5":21387,"_28235":199663,"_5797":189875},[],{"_6892":122512,"_42174":122473,"_29767":199777,"_5":21387,"_28235":199663,"_5797":189875},[],{"_6892":122513,"_42174":122473,"_29767":199779,"_5":21387,"_28235":199663,"_5797":91700},[],{"_6892":122514,"_42174":122473,"_29767":199781,"_5":21387,"_28235":199663,"_5797":199782},[],"Sí (obligatoria)",{"_6892":122515,"_42174":122473,"_29767":199784,"_5":21387,"_28235":199663,"_5797":199785},[],"Opcional",{"_6892":122516,"_42174":122473,"_29767":199787,"_5":21387,"_28235":199663,"_5797":91709},[],{"_6892":122517,"_42174":122473,"_29767":199789,"_5":21387,"_28235":199663,"_5797":189875},[],{"_6892":122518,"_42174":122473,"_29767":199791,"_5":21387,"_28235":199663,"_5797":199792},[],"Sí, solo para construir o firmar",{"_6892":122519,"_42174":122473,"_29767":199794,"_5":21387,"_28235":199663,"_5797":91717},[],{"_6892":122520,"_42174":122473,"_29767":199796,"_5":21387,"_28235":199663,"_5797":189875},[],{"_6892":122521,"_42174":122473,"_29767":199798,"_5":21387,"_28235":199663,"_5797":199799},[],"Sí, solo para cifrar",{"_6892":122522,"_42174":122473,"_29767":199801,"_5":21387,"_28235":199663,"_5797":91725},[],{"_6892":122523,"_42174":122473,"_29767":199803,"_5":21387,"_28235":199663,"_5797":189875},[],{"_6892":122524,"_42174":122473,"_29767":199805,"_5":21387,"_28235":199663,"_5797":189875},[],{"_6892":122525,"_42174":122473,"_29767":199807,"_5":21387,"_28235":199663,"_5797":91732},[],{"_6892":122526,"_42174":122473,"_29767":199809,"_5":21387,"_28235":199663,"_5797":189875},[],{"_6892":122527,"_42174":122473,"_29767":199811,"_5":21387,"_28235":199663,"_5797":81448},[],{"_6892":122528,"_42174":122473,"_29767":199813,"_5":21387,"_28235":199663,"_5797":91739},[],{"_6892":122529,"_42174":122473,"_29767":199815,"_5":21387,"_28235":199663,"_5797":189875},[],{"_6892":122530,"_42174":122473,"_29767":199817,"_5":21387,"_28235":199663,"_5797":81448},[],{"_6892":122531,"_42174":122473,"_29767":199819,"_5":21387,"_28235":199663,"_5797":91746},[],{"_6892":122532,"_42174":122473,"_29767":199821,"_5":21387,"_28235":199663,"_5797":189875},[],{"_6892":122533,"_42174":122473,"_29767":199823,"_5":21387,"_28235":199663,"_5797":81448},[],{"_6892":122534,"_42174":122473,"_29767":199825,"_5":21387,"_28235":199663,"_5797":86482},[],{"_6892":122535,"_42174":122473,"_29767":199827,"_5":21387,"_28235":199663,"_5797":81448},[],{"_6892":122536,"_42174":122473,"_29767":199829,"_5":21387,"_28235":199663,"_5797":199782},[],{"_6892":122537,"_42174":122473,"_29767":199831,"_5":21387,"_28235":199663,"_5797":91759},[],{"_6892":122538,"_42174":122473,"_29767":199833,"_5":21387,"_28235":199663,"_5797":81448},[],{"_6892":122539,"_42174":122473,"_29767":199835,"_5":21387,"_28235":199663,"_5797":189875},[],{"_6892":122540,"_42174":122473,"_29767":199837,"_5":21387,"_28235":199663,"_5797":199838},[],"`mode` vale `native` cuando está vacío o contiene cualquier valor distinto de `hawkbit`.",{"_6892":122541,"_42174":122473,"_29767":199840,"_5":21387,"_28235":199667,"_5797":193554},[],{"_6892":122542,"_42174":122473,"_29767":199842,"_5":21387,"_28235":199667,"_5797":189862},[],{"_6892":122543,"_42174":122473,"_29767":199844,"_5":21387,"_28235":199667,"_5797":197335},[],{"_6892":122544,"_42174":122473,"_29767":199846,"_5":21387,"_28235":199667,"_5797":189868},[],{"_6892":122545,"_42174":122473,"_29767":199848,"_5":21387,"_28235":199667,"_5797":91777},[],{"_6892":122546,"_42174":122473,"_29767":199850,"_5":21387,"_28235":199667,"_5797":124182},[],{"_6892":122547,"_42174":122473,"_29767":199852,"_5":21387,"_28235":199667,"_5797":199853},[],"vacío (`native`)",{"_6892":122548,"_42174":122473,"_29767":199855,"_5":21387,"_28235":199667,"_5797":199856},[],"`native` o `hawkbit`. Consulta Modo hawkBit.",{"_6892":122549,"_42174":122473,"_29767":199858,"_5":21387,"_28235":199667,"_5797":91788},[],{"_6892":122550,"_42174":122473,"_29767":199860,"_5":21387,"_28235":199667,"_5797":124182},[],{"_6892":122551,"_42174":122473,"_29767":199862,"_5":21387,"_28235":199667,"_5797":91793},[],{"_6892":122552,"_42174":122473,"_29767":199864,"_5":21387,"_28235":199667,"_5797":199865},[],"`trace`, `debug`, `info`, `warn`, `error`, `fatal` o `none` (sin distinguir mayúsculas). Un valor no reconocido se convierte en `info`. Con `info`, el registro de arranque muestra una advertencia inofensiva de «unknown log level». `none` descarta toda la salida de registro.",{"_6892":122553,"_42174":122473,"_29767":199867,"_5":21387,"_28235":199667,"_5797":91799},[],{"_6892":122554,"_42174":122473,"_29767":199869,"_5":21387,"_28235":199667,"_5797":124182},[],{"_6892":122555,"_42174":122473,"_29767":199871,"_5":21387,"_28235":199667,"_5797":199872},[],"vacío (todas las interfaces)",{"_6892":122556,"_42174":122473,"_29767":199874,"_5":21387,"_28235":199667,"_5797":199875},[],"Dirección en la que escuchar. Los ejemplos usan `0.0.0.0`.",{"_6892":122557,"_42174":122473,"_29767":199877,"_5":21387,"_28235":199667,"_5797":91810},[],{"_6892":122558,"_42174":122473,"_29767":199879,"_5":21387,"_28235":199667,"_5797":131146},[],{"_6892":122559,"_42174":122473,"_29767":199881,"_5":21387,"_28235":199667,"_5797":199882},[],"ninguno (obligatorio)",{"_6892":122560,"_42174":122473,"_29767":199884,"_5":21387,"_28235":199667,"_5797":199885},[],"Puerto HTTP. `0` elige un puerto aleatorio. Los ejemplos y el chart usan `10090`.",{"_6892":122561,"_42174":122473,"_29767":199887,"_5":21387,"_28235":199667,"_5797":91821},[],{"_6892":122562,"_42174":122473,"_29767":199889,"_5":21387,"_28235":199667,"_5797":199890},[],"duración",{"_6892":122563,"_42174":122473,"_29767":199892,"_5":21387,"_28235":199667,"_5797":91826},[],{"_6892":122564,"_42174":122473,"_29767":199894,"_5":21387,"_28235":199667,"_5797":199895},[],"Cuánto esperar a las peticiones en curso tras `SIGTERM` o `SIGINT`. Mantenlo por debajo del periodo de gracia de terminación del pod (el chart fija 120 s).",{"_6892":122565,"_42174":122473,"_29767":199897,"_5":21387,"_28235":199667,"_5797":91832},[],{"_6892":122566,"_42174":122473,"_29767":199899,"_5":21387,"_28235":199667,"_5797":156010},[],{"_6892":122567,"_42174":122473,"_29767":199901,"_5":21387,"_28235":199667,"_5797":91837},[],{"_6892":122568,"_42174":122473,"_29767":199903,"_5":21387,"_28235":199667,"_5797":199904},[],"Registra `PUT /updates/v1/jobs/:jobID/transition`, que falsifica un cambio de estado de un trabajo sin comprobar propiedad. Úsalo solo en pruebas; mantenlo en `false` en cualquier otro sitio.",{"_6892":122569,"_42174":122473,"_29767":199906,"_5":21387,"_28235":199667,"_5797":199907},[],"El servicio sirve siempre HTTP sin cifrar. Estas claves existen en las estructuras de configuración y en los ficheros de ejemplo pero **no se leen**, así que definirlas no tiene efecto: `app.server.protocol`, `app.server.log_level`, `app.server.health_check` (y el `health_check_logging` de los ejemplos), `app.server.cert_file`, `app.server.key_file` y `app.server.authentication.mutual_tls.*`. Termina TLS delante del servicio. Consulta Seguridad.",{"_6892":122570,"_42174":122473,"_29767":199909,"_5":21387,"_28235":199671,"_5797":193554},[],{"_6892":122571,"_42174":122473,"_29767":199911,"_5":21387,"_28235":199671,"_5797":189862},[],{"_6892":122572,"_42174":122473,"_29767":199913,"_5":21387,"_28235":199671,"_5797":197335},[],{"_6892":122573,"_42174":122473,"_29767":199915,"_5":21387,"_28235":199671,"_5797":189868},[],{"_6892":122574,"_42174":122473,"_29767":199917,"_5":21387,"_28235":199671,"_5797":91854},[],{"_6892":122575,"_42174":122473,"_29767":199919,"_5":21387,"_28235":199671,"_5797":124182},[],{"_6892":122576,"_42174":122473,"_29767":199921,"_5":21387,"_28235":199671,"_5797":153767},[],{"_6892":122577,"_42174":122473,"_29767":199923,"_5":21387,"_28235":199671,"_5797":199924},[],"Solo existe `postgres`. El valor no se comprueba.",{"_6892":122578,"_42174":122473,"_29767":199926,"_5":21387,"_28235":199671,"_5797":91864},[],{"_6892":122579,"_42174":122473,"_29767":199928,"_5":21387,"_28235":199671,"_5797":124182},[],{"_6892":122580,"_42174":122473,"_29767":199930,"_5":21387,"_28235":199671,"_5797":199882},[],{"_6892":122581,"_42174":122473,"_29767":199932,"_5":21387,"_28235":199671,"_5797":199933},[],"Host de Postgres. En modo `hawkbit` el arranque falla si está vacío.",{"_6892":122582,"_42174":122473,"_29767":199935,"_5":21387,"_28235":199671,"_5797":91874},[],{"_6892":122583,"_42174":122473,"_29767":199937,"_5":21387,"_28235":199671,"_5797":131146},[],{"_6892":122584,"_42174":122473,"_29767":199939,"_5":21387,"_28235":199671,"_5797":199882},[],{"_6892":122585,"_42174":122473,"_29767":199941,"_5":21387,"_28235":199671,"_5797":199942},[],"Puerto de Postgres. No hay valor por defecto.",{"_6892":122586,"_42174":122473,"_29767":199944,"_5":21387,"_28235":199671,"_5797":91884},[],{"_6892":122587,"_42174":122473,"_29767":199946,"_5":21387,"_28235":199671,"_5797":124182},[],{"_6892":122588,"_42174":122473,"_29767":199948,"_5":21387,"_28235":199671,"_5797":153767},[],{"_6892":122589,"_42174":122473,"_29767":199950,"_5":21387,"_28235":199671,"_5797":199951},[],"Credenciales.",{"_6892":122590,"_42174":122473,"_29767":199953,"_5":21387,"_28235":199671,"_5797":91894},[],{"_6892":122591,"_42174":122473,"_29767":199955,"_5":21387,"_28235":199671,"_5797":124182},[],{"_6892":122592,"_42174":122473,"_29767":199957,"_5":21387,"_28235":199671,"_5797":91793},[],{"_6892":122593,"_42174":122473,"_29767":199959,"_5":21387,"_28235":199671,"_5797":199960},[],"Nivel de registro de la capa de base de datos. Las sentencias SQL se registran en `trace`.",{"_6892":122594,"_42174":122473,"_29767":199962,"_5":21387,"_28235":199671,"_5797":199963},[],"El nombre de la base de datos está fijado en &#x2A;*`updates`**. No hay clave para cambiarlo. El servicio crea sus tablas y las migra al arrancar, pero no crea la base de datos: crea `updates` antes. En Docker Compose, `init.sql` crea `updates` y `hawkbit`, y `POSTGRES_DB` crea `wfx`.",{"_6892":122595,"_42174":122473,"_29767":199965,"_5":21387,"_28235":199671,"_5797":199966},[],"La conexión usa `sslmode=disable`. No hay forma de activar TLS hacia Postgres desde la configuración. Mantén la base de datos en una red privada.",{"_6892":122596,"_42174":122473,"_29767":199968,"_5":21387,"_28235":199671,"_5797":199969},[],"Cada proceso mantiene como máximo 25 conexiones abiertas y 10 inactivas (las conexiones se reciclan a los 30 minutos, o a los 5 minutos de inactividad). Calcula `25 x réplicas` frente al `max_connections` de Postgres.",{"_6892":122597,"_42174":122473,"_29767":199971,"_5":21387,"_28235":199675,"_5797":193554},[],{"_6892":122598,"_42174":122473,"_29767":199973,"_5":21387,"_28235":199675,"_5797":197335},[],{"_6892":122599,"_42174":122473,"_29767":199975,"_5":21387,"_28235":199675,"_5797":199976},[],"Modo",{"_6892":122600,"_42174":122473,"_29767":199978,"_5":21387,"_28235":199675,"_5797":189868},[],{"_6892":122601,"_42174":122473,"_29767":199980,"_5":21387,"_28235":199675,"_5797":91700},[],{"_6892":122602,"_42174":122473,"_29767":199982,"_5":21387,"_28235":199675,"_5797":153767},[],{"_6892":122603,"_42174":122473,"_29767":199984,"_5":21387,"_28235":199675,"_5797":199985},[],"Obligatoria en `native`, opcional en `hawkbit`",{"_6892":122604,"_42174":122473,"_29767":199987,"_5":21387,"_28235":199675,"_5797":199988},[],"URL base de la API Device Manager de Lamassu, por ejemplo `http://host:8080/api/devmanager`. Es el origen de los grupos de dispositivos. Sin ella en modo `hawkbit`, los grupos se leen de las etiquetas `group:<id>` de los targets de hawkBit. El servicio envía `X-Principal-ID: admin-mode` en estas llamadas.",{"_6892":122605,"_42174":122473,"_29767":199990,"_5":21387,"_28235":199675,"_5797":91932},[],{"_6892":122606,"_42174":122473,"_29767":199992,"_5":21387,"_28235":199675,"_5797":153767},[],{"_6892":122607,"_42174":122473,"_29767":199994,"_5":21387,"_28235":199675,"_5797":193805},[],{"_6892":122608,"_42174":122473,"_29767":199996,"_5":21387,"_28235":199675,"_5797":199997},[],"URL base de la API KMS de Lamassu, por ejemplo `http://host:8080/api/kms/v1`. Necesaria para firmar. Consulta Firma y cifrado.",{"_6892":122609,"_42174":122473,"_29767":199999,"_5":21387,"_28235":199675,"_5797":91942},[],{"_6892":122610,"_42174":122473,"_29767":200001,"_5":21387,"_28235":199675,"_5797":153767},[],{"_6892":122611,"_42174":122473,"_29767":200003,"_5":21387,"_28235":199675,"_5797":193805},[],{"_6892":122612,"_42174":122473,"_29767":200005,"_5":21387,"_28235":199675,"_5797":200006},[],"URL base de SymKMS, **sin** la ruta `/symkms/v1`. En el monolito apunta al propio servicio (por ejemplo `http://localhost:10090`) y debe coincidir con `app.server.port`. Vacío significa que se rechaza el cifrado.",{"_6892":122613,"_42174":122473,"_29767":200008,"_5":21387,"_28235":199675,"_5797":91952},[],{"_6892":122614,"_42174":122473,"_29767":200010,"_5":21387,"_28235":199675,"_5797":153767},[],{"_6892":122615,"_42174":122473,"_29767":200012,"_5":21387,"_28235":199675,"_5797":89209},[],{"_6892":122616,"_42174":122473,"_29767":200014,"_5":21387,"_28235":199675,"_5797":200015},[],"URL base de la API de **gestión** de WFX (puerto `8081` dentro de la red de Compose, `9081` en el host). El servicio añade `/api/wfx/v1/`. El arranque falla si no se puede alcanzar WFX. Los dispositivos usan el puerto de cliente de WFX.",{"_6892":122617,"_42174":122473,"_29767":200017,"_5":21387,"_28235":199675,"_5797":91962},[],{"_6892":122618,"_42174":122473,"_29767":200019,"_5":21387,"_28235":199675,"_5797":153767},[],{"_6892":122619,"_42174":122473,"_29767":200021,"_5":21387,"_28235":199675,"_5797":89209},[],{"_6892":122620,"_42174":122473,"_29767":200023,"_5":21387,"_28235":199675,"_5797":200024},[],"URL base pública que usan los dispositivos para descargar compilaciones, por ejemplo `http://updates:10090/updates/v1/`. **Debe terminar en `/updates/v1/`, con la barra final**: el servicio añade `groups/...` directamente y guarda el resultado como URI del paquete. Debe ser alcanzable desde los dispositivos.",{"_6892":122621,"_42174":122473,"_29767":200026,"_5":21387,"_28235":199679,"_5797":193554},[],{"_6892":122622,"_42174":122473,"_29767":200028,"_5":21387,"_28235":199679,"_5797":197335},[],{"_6892":122623,"_42174":122473,"_29767":200030,"_5":21387,"_28235":199679,"_5797":199976},[],{"_6892":122624,"_42174":122473,"_29767":200032,"_5":21387,"_28235":199679,"_5797":189868},[],{"_6892":122625,"_42174":122473,"_29767":200034,"_5":21387,"_28235":199679,"_5797":88538},[],{"_6892":122626,"_42174":122473,"_29767":200036,"_5":21387,"_28235":199679,"_5797":200037},[],"`swugenerator` en el `PATH` en `native`; sin definir en `hawkbit`",{"_6892":122627,"_42174":122473,"_29767":200039,"_5":21387,"_28235":199679,"_5797":193805},[],{"_6892":122628,"_42174":122473,"_29767":200041,"_5":21387,"_28235":199679,"_5797":200042},[],"Ruta del binario `swugenerator`. En modo `hawkbit` el constructor de SWU existe solo si se define: sin ella, los módulos `swu-build` no se pueden construir (`501`). Las construcciones de módulos raw no la necesitan.",{"_6892":122629,"_42174":122473,"_29767":200044,"_5":21387,"_28235":199679,"_5797":91990},[],{"_6892":122630,"_42174":122473,"_29767":200046,"_5":21387,"_28235":199679,"_5797":153767},[],{"_6892":122631,"_42174":122473,"_29767":200048,"_5":21387,"_28235":199679,"_5797":193805},[],{"_6892":122632,"_42174":122473,"_29767":200050,"_5":21387,"_28235":199679,"_5797":200051},[],"El script firmante que llama swugenerator para firmar un `.swu`, `sign_kms.sh` (`/app/sign_kms.sh` en la imagen). Firmar un `.swu` necesita esta clave y `kms_endpoint`; el servicio rechaza una petición de firma cuando falta alguna de las dos.",{"_6892":122633,"_42174":122473,"_29767":200053,"_5":21387,"_28235":199679,"_5797":92000},[],{"_6892":122634,"_42174":122473,"_29767":200055,"_5":21387,"_28235":199679,"_5797":200056},[],"`wfx.workflow.dau.direct.yml` (relativo al directorio de trabajo)",{"_6892":122635,"_42174":122473,"_29767":200058,"_5":21387,"_28235":199679,"_5797":89209},[],{"_6892":122636,"_42174":122473,"_29767":200060,"_5":21387,"_28235":199679,"_5797":200061},[],"Ruta del workflow `direct` de WFX. El nombre &#x2A;*debe contener `direct`**: los ficheros `phased`, `download-install` y `simple` se localizan sustituyendo esa palabra en la ruta, y el arranque falla en caso contrario. El servicio sube al arrancar los workflows que falten en WFX.",{"_6892":122637,"_42174":122473,"_29767":200063,"_5":21387,"_28235":199679,"_5797":92011},[],{"_6892":122638,"_42174":122473,"_29767":200065,"_5":21387,"_28235":199679,"_5797":153767},[],{"_6892":122639,"_42174":122473,"_29767":200067,"_5":21387,"_28235":199679,"_5797":89209},[],{"_6892":122640,"_42174":122473,"_29767":200069,"_5":21387,"_28235":199679,"_5797":200070},[],"Directorio base para el espacio temporal de construcción (`in/`) y, hasta que las compilaciones se publican en el almacén `builds`, las salidas de compilación (`out/`). También proporciona el `local_dir` por defecto de `artifacts` y `builds`.",{"_6892":122641,"_42174":122473,"_29767":200072,"_5":21387,"_28235":199679,"_5797":92021},[],{"_6892":122642,"_42174":122473,"_29767":200074,"_5":21387,"_28235":199679,"_5797":153767},[],{"_6892":122643,"_42174":122473,"_29767":200076,"_5":21387,"_28235":199679,"_5797":193805},[],{"_6892":122644,"_42174":122473,"_29767":200078,"_5":21387,"_28235":199679,"_5797":200079},[],"Directorio alternativo para el almacén de claves de SymKMS cuando `symkms.storage.local_dir` está vacío.",{"_6892":122645,"_42174":122473,"_29767":200081,"_5":21387,"_28235":199679,"_5797":91759},[],{"_6892":122646,"_42174":122473,"_29767":200083,"_5":21387,"_28235":199679,"_5797":200084},[],"`0` (sin comprobación)",{"_6892":122647,"_42174":122473,"_29767":200086,"_5":21387,"_28235":199679,"_5797":86482},[],{"_6892":122648,"_42174":122473,"_29767":200088,"_5":21387,"_28235":199679,"_5797":200089},[],"Rechaza una construcción que cifraría un fichero en memoria (unas dos veces su tamaño) por encima de este límite, en MiB, antes de que el proceso muera por falta de memoria.",{"_6892":122649,"_42174":122473,"_29767":200091,"_5":21387,"_28235":199683,"_5797":193554},[],{"_6892":122650,"_42174":122473,"_29767":200093,"_5":21387,"_28235":199683,"_5797":189862},[],{"_6892":122651,"_42174":122473,"_29767":200095,"_5":21387,"_28235":199683,"_5797":197335},[],{"_6892":122652,"_42174":122473,"_29767":200097,"_5":21387,"_28235":199683,"_5797":189868},[],{"_6892":122653,"_42174":122473,"_29767":200099,"_5":21387,"_28235":199683,"_5797":92049},[],{"_6892":122654,"_42174":122473,"_29767":200101,"_5":21387,"_28235":199683,"_5797":131146},[],{"_6892":122655,"_42174":122473,"_29767":200103,"_5":21387,"_28235":199683,"_5797":92054},[],{"_6892":122656,"_42174":122473,"_29767":200105,"_5":21387,"_28235":199683,"_5797":200106},[],"Mayor fichero individual subido en MiB: artefacto o `.swu` precompilado. Un fichero multipart mayor recibe `413` con el mensaje `file \"<name>\" is <n> MiB; the maximum upload size is <m> MiB`. El límite del cuerpo HTTP es este valor más 1 MiB. Los valores `0` o menores equivalen al valor por defecto.",{"_6892":122657,"_42174":122473,"_29767":200108,"_5":21387,"_28235":199683,"_5797":200109},[],"Las subidas se transmiten en streaming: la memoria no crece con el fichero, pero cada subida en curso se escribe primero en un fichero temporal bajo `TMPDIR` (por defecto `/tmp`), así que necesita ese espacio libre en disco. Cualquier proxy delante del servicio debe aceptar el mismo tamaño y mantener la conexión abierta: los tiempos de lectura y escritura son de 6 horas y las conexiones inactivas se cierran a los 5 minutos. Consulta Operaciones.",{"_6892":122658,"_42174":122473,"_29767":200111,"_5":21387,"_28235":199687,"_5797":200112},[],"Cuatro bloques comparten un mismo formato, de modo que artefactos, salidas de compilación y material de claves pueden vivir cada uno en disco local o en S3:",{"_6892":122659,"_42174":122473,"_29767":200114,"_5":21387,"_28235":199687,"_5797":191031},[],{"_6892":122660,"_42174":122473,"_29767":200116,"_5":21387,"_28235":199687,"_5797":199976},[],{"_6892":122661,"_42174":122473,"_29767":200118,"_5":21387,"_28235":199687,"_5797":194285},[],{"_6892":122662,"_42174":122473,"_29767":200120,"_5":21387,"_28235":199687,"_5797":197335},[],{"_6892":122663,"_42174":122473,"_29767":200122,"_5":21387,"_28235":199687,"_5797":90508},[],{"_6892":122664,"_42174":122473,"_29767":200124,"_5":21387,"_28235":199687,"_5797":89209},[],{"_6892":122665,"_42174":122473,"_29767":200126,"_5":21387,"_28235":199687,"_5797":200127},[],"Binarios de artefactos subidos",{"_6892":122666,"_42174":122473,"_29767":200129,"_5":21387,"_28235":199687,"_5797":92082},[],{"_6892":122667,"_42174":122473,"_29767":200131,"_5":21387,"_28235":199687,"_5797":92085},[],{"_6892":122668,"_42174":122473,"_29767":200133,"_5":21387,"_28235":199687,"_5797":89209},[],{"_6892":122669,"_42174":122473,"_29767":200135,"_5":21387,"_28235":199687,"_5797":200136},[],"Salidas de compilación que descargan los dispositivos: `.swu` y `.tar.gz`",{"_6892":122670,"_42174":122473,"_29767":200138,"_5":21387,"_28235":199687,"_5797":92093},[],{"_6892":122671,"_42174":122473,"_29767":200140,"_5":21387,"_28235":199687,"_5797":92096},[],{"_6892":122672,"_42174":122473,"_29767":200142,"_5":21387,"_28235":199687,"_5797":193805},[],{"_6892":122673,"_42174":122473,"_29767":200144,"_5":21387,"_28235":199687,"_5797":200145},[],"Claves simétricas y asignaciones de claves a dispositivos",{"_6892":122674,"_42174":122473,"_29767":200147,"_5":21387,"_28235":199687,"_5797":200148},[],"Local, `sym_keys_dir`, o `data` relativo al directorio de trabajo si ambos están vacíos",{"_6892":122675,"_42174":122473,"_29767":200150,"_5":21387,"_28235":199687,"_5797":85402},[],{"_6892":122676,"_42174":122473,"_29767":200152,"_5":21387,"_28235":199687,"_5797":86482},[],{"_6892":122677,"_42174":122473,"_29767":200154,"_5":21387,"_28235":199687,"_5797":200155},[],"Solo lectura, para firmar URLs de descarga del bucket S3 de hawkBit (consulta el bloque `hawkbit`)",{"_6892":122678,"_42174":122473,"_29767":200157,"_5":21387,"_28235":199687,"_5797":197452},[],{"_6892":122679,"_42174":122473,"_29767":200159,"_5":21387,"_28235":199691,"_5797":193554},[],{"_6892":122680,"_42174":122473,"_29767":200161,"_5":21387,"_28235":199691,"_5797":197335},[],{"_6892":122681,"_42174":122473,"_29767":200163,"_5":21387,"_28235":199691,"_5797":189868},[],{"_6892":122682,"_42174":122473,"_29767":200165,"_5":21387,"_28235":199691,"_5797":86664},[],{"_6892":122683,"_42174":122473,"_29767":200167,"_5":21387,"_28235":199691,"_5797":92124},[],{"_6892":122684,"_42174":122473,"_29767":200169,"_5":21387,"_28235":199691,"_5797":200170},[],"`local` o `s3`.",{"_6892":122685,"_42174":122473,"_29767":200172,"_5":21387,"_28235":199691,"_5797":92130},[],{"_6892":122686,"_42174":122473,"_29767":200174,"_5":21387,"_28235":199691,"_5797":200175},[],"valor por defecto del bloque, arriba",{"_6892":122687,"_42174":122473,"_29767":200177,"_5":21387,"_28235":199691,"_5797":200178},[],"Directorio para `local`. Se crea con modo `0700`.",{"_6892":122688,"_42174":122473,"_29767":200180,"_5":21387,"_28235":199691,"_5797":92139},[],{"_6892":122689,"_42174":122473,"_29767":200182,"_5":21387,"_28235":199691,"_5797":153767},[],{"_6892":122690,"_42174":122473,"_29767":200184,"_5":21387,"_28235":199691,"_5797":200185},[],"Obligatorio para `s3`. El bucket debe existir: el servicio comprueba el acceso al arrancar y se detiene si falla (`S3 bucket \"x\" is not accessible at ...`).",{"_6892":122691,"_42174":122473,"_29767":200187,"_5":21387,"_28235":199691,"_5797":92147},[],{"_6892":122692,"_42174":122473,"_29767":200189,"_5":21387,"_28235":199691,"_5797":92150},[],{"_6892":122693,"_42174":122473,"_29767":200191,"_5":21387,"_28235":199691,"_5797":200192},[],"Región de AWS.",{"_6892":122694,"_42174":122473,"_29767":200194,"_5":21387,"_28235":199691,"_5797":92156},[],{"_6892":122695,"_42174":122473,"_29767":200196,"_5":21387,"_28235":199691,"_5797":200197},[],"vacío (AWS)",{"_6892":122696,"_42174":122473,"_29767":200199,"_5":21387,"_28235":199691,"_5797":200200},[],"URL de un almacén compatible con S3, como RustFS o MinIO.",{"_6892":122697,"_42174":122473,"_29767":200202,"_5":21387,"_28235":199691,"_5797":92165},[],{"_6892":122698,"_42174":122473,"_29767":200204,"_5":21387,"_28235":199691,"_5797":91837},[],{"_6892":122699,"_42174":122473,"_29767":200206,"_5":21387,"_28235":199691,"_5797":200207},[],"Direcciona los buckets como `<endpoint>/<bucket>`. La mayoría de los almacenes autoalojados necesitan `true`.",{"_6892":122700,"_42174":122473,"_29767":200209,"_5":21387,"_28235":199691,"_5797":92173},[],{"_6892":122701,"_42174":122473,"_29767":200211,"_5":21387,"_28235":199691,"_5797":200212},[],"vacío",{"_6892":122702,"_42174":122473,"_29767":200214,"_5":21387,"_28235":199691,"_5797":200215},[],"Mantiene todas las claves bajo una «carpeta» del bucket. Un mismo bucket puede contener varios almacenes, incluidos los artefactos de hawkBit. Se añade la `/` final si falta.",{"_6892":122703,"_42174":122473,"_29767":200217,"_5":21387,"_28235":199691,"_5797":92181},[],{"_6892":122704,"_42174":122473,"_29767":200219,"_5":21387,"_28235":199691,"_5797":153767},[],{"_6892":122705,"_42174":122473,"_29767":200221,"_5":21387,"_28235":199691,"_5797":200222},[],"Credenciales estáticas. Define ambas o ninguna.",{"_6892":122706,"_42174":122473,"_29767":200224,"_5":21387,"_28235":199691,"_5797":92189},[],{"_6892":122707,"_42174":122473,"_29767":200226,"_5":21387,"_28235":199691,"_5797":153767},[],{"_6892":122708,"_42174":122473,"_29767":200228,"_5":21387,"_28235":199691,"_5797":200229},[],"Las mismas credenciales leídas de ficheros, por ejemplo un Secret de Kubernetes montado. Se releen cada minuto, así que rotar el Secret no exige reiniciar. Define ambas o ninguna, y no junto con el par en línea.",{"_6892":122709,"_42174":122473,"_29767":200231,"_5":21387,"_28235":199691,"_5797":200232},[],"Sin credenciales definidas se aplica la cadena de credenciales por defecto de AWS (entorno, IRSA, perfil de instancia).",{"_6892":122710,"_42174":122473,"_29767":200234,"_5":21387,"_28235":199695,"_5797":193554},[],{"_6892":122711,"_42174":122473,"_29767":200236,"_5":21387,"_28235":199695,"_5797":197335},[],{"_6892":122712,"_42174":122473,"_29767":200238,"_5":21387,"_28235":199695,"_5797":189868},[],{"_6892":122713,"_42174":122473,"_29767":200240,"_5":21387,"_28235":199695,"_5797":86664},[],{"_6892":122714,"_42174":122473,"_29767":200242,"_5":21387,"_28235":199695,"_5797":92208},[],{"_6892":122715,"_42174":122473,"_29767":200244,"_5":21387,"_28235":199695,"_5797":200245},[],"`none`, `local` o `awskms`.",{"_6892":122716,"_42174":122473,"_29767":200247,"_5":21387,"_28235":199695,"_5797":92214},[],{"_6892":122717,"_42174":122473,"_29767":200249,"_5":21387,"_28235":199695,"_5797":153767},[],{"_6892":122718,"_42174":122473,"_29767":200251,"_5":21387,"_28235":199695,"_5797":200252},[],"Obligatoria para `local`: una clave de 32 bytes codificada en hexadecimal.",{"_6892":122719,"_42174":122473,"_29767":200254,"_5":21387,"_28235":199695,"_5797":92222},[],{"_6892":122720,"_42174":122473,"_29767":200256,"_5":21387,"_28235":199695,"_5797":153767},[],{"_6892":122721,"_42174":122473,"_29767":200258,"_5":21387,"_28235":199695,"_5797":200259},[],"Obligatoria para `awskms`: ARN o alias de la clave.",{"_6892":122722,"_42174":122473,"_29767":200261,"_5":21387,"_28235":199695,"_5797":92230},[],{"_6892":122723,"_42174":122473,"_29767":200263,"_5":21387,"_28235":199695,"_5797":92150},[],{"_6892":122724,"_42174":122473,"_29767":200265,"_5":21387,"_28235":199695,"_5797":200266},[],"Región de la clave de AWS KMS.",{"_6892":122725,"_42174":122473,"_29767":200268,"_5":21387,"_28235":199695,"_5797":200269},[],"Un objeto cifrado se cifra y descifra entero, en memoria: con cifrado en reposo, leer o escribir un artefacto de 10 GiB necesita esa misma memoria, y los rangos de bytes se cortan de la copia descifrada. Un almacén con el cifrado activado no puede usar descargas prefirmadas. Para ficheros grandes, es preferible cifrar en el propio almacén (por ejemplo, con cifrado del lado del servidor de S3).",{"_6892":122726,"_42174":122473,"_29767":200271,"_5":21387,"_28235":199699,"_5797":200272},[],"Con almacenamiento S3, una descarga puede responderse con `302` a una URL firmada de corta duración del almacén, en lugar de transmitir los bytes a través del servicio. Antes se autoriza al solicitante, como en cualquier descarga. El modo `native` firma las salidas de compilación (`builds.presign`); el modo `hawkbit` firma los objetos del plugin S3 de hawkBit (`hawkbit.artifact_store.presign`). Las descargas de artefactos por ID en modo `native` siempre se transmiten a través del servicio.",{"_6892":122727,"_42174":122473,"_29767":200274,"_5":21387,"_28235":199699,"_5797":193554},[],{"_6892":122728,"_42174":122473,"_29767":200276,"_5":21387,"_28235":199699,"_5797":197335},[],{"_6892":122729,"_42174":122473,"_29767":200278,"_5":21387,"_28235":199699,"_5797":189868},[],{"_6892":122730,"_42174":122473,"_29767":200280,"_5":21387,"_28235":199699,"_5797":92250},[],{"_6892":122731,"_42174":122473,"_29767":200282,"_5":21387,"_28235":199699,"_5797":91837},[],{"_6892":122732,"_42174":122473,"_29767":200284,"_5":21387,"_28235":199699,"_5797":200285},[],"Activa la función.",{"_6892":122733,"_42174":122473,"_29767":200287,"_5":21387,"_28235":199699,"_5797":92258},[],{"_6892":122734,"_42174":122473,"_29767":200289,"_5":21387,"_28235":199699,"_5797":200290},[],"el `s3_endpoint` del almacenamiento",{"_6892":122735,"_42174":122473,"_29767":200292,"_5":21387,"_28235":199699,"_5797":200293},[],"Origen del almacén **tal como lo alcanzan los dispositivos**, sin ruta (por ejemplo, el gateway que publica el bucket). Es lo que se firma: la firma cubre la cabecera `Host`, así que una URL firmada para una dirección interna del clúster se rechaza cuando un dispositivo la usa a través del gateway. Obligatoria salvo que los dispositivos alcancen el almacén en su propio endpoint (por ejemplo, AWS S3).",{"_6892":122736,"_42174":122473,"_29767":200295,"_5":21387,"_28235":199699,"_5797":92267},[],{"_6892":122737,"_42174":122473,"_29767":200297,"_5":21387,"_28235":199699,"_5797":91826},[],{"_6892":122738,"_42174":122473,"_29767":200299,"_5":21387,"_28235":199699,"_5797":200300},[],"Cuánto tiempo puede una URL **iniciar** una descarga. Entre `1s` y 7 días. Una transferencia ya en curso no se corta al caducar.",{"_6892":122739,"_42174":122473,"_29767":200302,"_5":21387,"_28235":199699,"_5797":92275},[],{"_6892":122740,"_42174":122473,"_29767":200304,"_5":21387,"_28235":199699,"_5797":92278},[],{"_6892":122741,"_42174":122473,"_29767":200306,"_5":21387,"_28235":199699,"_5797":200307},[],"Una URL ya firmada para el mismo objeto se entrega de nuevo mientras le quede al menos esta validez, de modo que un reintento o una reanudación nunca recibe una URL a punto de caducar. Un valor negativo firma una URL nueva en cada petición. Debe ser menor que `ttl`.",{"_6892":122742,"_42174":122473,"_29767":200309,"_5":21387,"_28235":199699,"_5797":200310},[],"`access_key_id`, `secret_access_key` (o las variantes `_file`)",{"_6892":122743,"_42174":122473,"_29767":200312,"_5":21387,"_28235":199699,"_5797":153767},[],{"_6892":122744,"_42174":122473,"_29767":200314,"_5":21387,"_28235":199699,"_5797":200315},[],"La credencial que firma. &#x2A;*Obligatoria, y debe ser una credencial de solo lectura distinta de la del almacenamiento.**",{"_6892":122745,"_42174":122473,"_29767":200317,"_5":21387,"_28235":199699,"_5797":200318},[],"Al arrancar, el servicio se niega a ejecutarse si la credencial de firma es la del almacenamiento, si puede escribir en el bucket (lo comprueba intentando una escritura), si el almacén la rechaza (espera hasta 2 minutos a que el almacén la acepte) o si `encryption.type` no es `none` (los dispositivos recibirían texto cifrado). Si no se puede consultar el almacén en absoluto, registra una advertencia y continúa. El dispositivo debe poder resolver y alcanzar `public_endpoint`. Consulta Seguridad.",{"_6892":122746,"_42174":122473,"_29767":200320,"_5":21387,"_28235":199703,"_5797":200321},[],"Se usa solo cuando `mode: hawkbit`.",{"_6892":122747,"_42174":122473,"_29767":200323,"_5":21387,"_28235":199703,"_5797":193554},[],{"_6892":122748,"_42174":122473,"_29767":200325,"_5":21387,"_28235":199703,"_5797":197335},[],{"_6892":122749,"_42174":122473,"_29767":200327,"_5":21387,"_28235":199703,"_5797":189868},[],{"_6892":122750,"_42174":122473,"_29767":200329,"_5":21387,"_28235":199703,"_5797":92304},[],{"_6892":122751,"_42174":122473,"_29767":200331,"_5":21387,"_28235":199703,"_5797":200332},[],"ninguno (obligatoria)",{"_6892":122752,"_42174":122473,"_29767":200334,"_5":21387,"_28235":199703,"_5797":200335},[],"Raíz de la API de gestión de hawkBit, por ejemplo `http://hawkbit:8080`. El arranque falla si está vacía. Las llamadas caducan a los 30 s; las transferencias de artefactos, a las 6 h.",{"_6892":122753,"_42174":122473,"_29767":200337,"_5":21387,"_28235":199703,"_5797":92312},[],{"_6892":122754,"_42174":122473,"_29767":200339,"_5":21387,"_28235":199703,"_5797":153767},[],{"_6892":122755,"_42174":122473,"_29767":200341,"_5":21387,"_28235":199703,"_5797":200342},[],"Credenciales Basic Auth de la API de gestión.",{"_6892":122756,"_42174":122473,"_29767":200344,"_5":21387,"_28235":199703,"_5797":92320},[],{"_6892":122757,"_42174":122473,"_29767":200346,"_5":21387,"_28235":199703,"_5797":92323},[],{"_6892":122758,"_42174":122473,"_29767":200348,"_5":21387,"_28235":199703,"_5797":200349},[],"Segmento de ruta del tenant DDI.",{"_6892":122759,"_42174":122473,"_29767":200351,"_5":21387,"_28235":199703,"_5797":92329},[],{"_6892":122760,"_42174":122473,"_29767":200353,"_5":21387,"_28235":199703,"_5797":92304},[],{"_6892":122761,"_42174":122473,"_29767":200355,"_5":21387,"_28235":199703,"_5797":200356},[],"Raíz DDI de hawkBit **tal como la alcanzan los dispositivos** (por ejemplo `https://updates.example.com/api/hawkbit-ddi`). Se usa para construir las URLs de descarga que reciben los dispositivos, y su ruta pasa a ser el prefijo de la ruta de descarga DDI que sirve este servicio.",{"_6892":122762,"_42174":122473,"_29767":200358,"_5":21387,"_28235":199703,"_5797":85402},[],{"_6892":122763,"_42174":122473,"_29767":200360,"_5":21387,"_28235":199703,"_5797":153767},[],{"_6892":122764,"_42174":122473,"_29767":200362,"_5":21387,"_28235":199703,"_5797":200363},[],"Mismo formato que los bloques de almacenamiento de blobs: `storage` debe apuntar al bucket y al `s3_prefix` del plugin S3 de artefactos de hawkBit, y `presign` activa las descargas firmadas. Sin él, los artefactos se transmiten a través de hawkBit.",{"_6892":122765,"_42174":122473,"_29767":200365,"_5":21387,"_28235":199703,"_5797":200366},[],"El bloque `storage` (Postgres) también es obligatorio en modo `hawkbit`.",{"_6892":122766,"_42174":122473,"_29767":200368,"_5":21387,"_28235":199707,"_5797":200369},[],"Cualquier clave del fichero se puede sobrescribir con una variable de entorno: el nombre es la ruta de la clave en mayúsculas con los puntos sustituidos por guiones bajos. `KMS_ENDPOINT` sobrescribe `kms_endpoint`, `STORAGE_PASSWORD` sobrescribe `storage.password` y `BUILDS_PRESIGN_TTL` sobrescribe `builds.presign.ttl`. La clave debe existir en el fichero (basta con un valor vacío): el cargador solo considera las claves que ha leído de él.",{"_6892":122767,"_42174":122473,"_29767":200371,"_5":21387,"_28235":199707,"_5797":200372},[],"Variables que lee el código además de estas sobrescrituras:",{"_6892":122768,"_42174":122473,"_29767":200374,"_5":21387,"_28235":199707,"_5797":92353},[],{"_6892":122769,"_42174":122473,"_29767":200376,"_5":21387,"_28235":199707,"_5797":189868},[],{"_6892":122770,"_42174":122473,"_29767":200378,"_5":21387,"_28235":199707,"_5797":92358},[],{"_6892":122771,"_42174":122473,"_29767":200380,"_5":21387,"_28235":199707,"_5797":200381},[],"Ruta del fichero de configuración.",{"_6892":122772,"_42174":122473,"_29767":200383,"_5":21387,"_28235":199707,"_5797":92364},[],{"_6892":122773,"_42174":122473,"_29767":200385,"_5":21387,"_28235":199707,"_5797":200386},[],"Identidad y espacio de nombres para la elección de líder de Kubernetes. El chart de Helm las define. Si no están definidas, se usan el nombre de host y el fichero de espacio de nombres de la cuenta de servicio.",{"_6892":122774,"_42174":122473,"_29767":200388,"_5":21387,"_28235":199707,"_5797":92370},[],{"_6892":122775,"_42174":122473,"_29767":200390,"_5":21387,"_28235":199707,"_5797":200391},[],"Dónde escriben ficheros temporales las subidas y las construcciones (el directorio temporal de Go).",{"_6892":122776,"_42174":122473,"_29767":200393,"_5":21387,"_28235":199707,"_5797":92376},[],{"_6892":122777,"_42174":122473,"_29767":200395,"_5":21387,"_28235":199707,"_5797":200396},[],"Solo lo usa la comprobación de salud de la imagen Docker para encontrar el puerto. Por defecto `10090`.",{"_6892":122778,"_42174":122473,"_29767":200398,"_5":21387,"_28235":199707,"_5797":92382},[],{"_6892":122779,"_42174":122473,"_29767":200400,"_5":21387,"_28235":199707,"_5797":200401},[],"La cadena de credenciales por defecto de AWS, cuando un bloque S3 o AWS KMS no tiene credencial explícita.",{"_6892":122780,"_42174":122473,"_29767":200403,"_5":21387,"_28235":199707,"_5797":200404},[],"En Docker Compose, el fichero `.env` lo lee `docker-compose.yml`, no el servicio: `HOST_IP`, `HAWKBIT_ADMIN_PASSWORD`, `HAWKBIT_ARTIFACT_STORAGE` y las variables `HAWKBIT_ARTIFACT_S3_*` y `LOCAL_S3_*`. Consulta `.env.example` en el repositorio.",{"_6892":122781,"_42174":122473,"_29767":200406,"_5":21387,"_28235":199707,"_5797":200407},[],"Con `app.logs.level: debug`, el servicio escribe en el registro, al arrancar, toda la configuración cargada, incluidos `storage.password`, `encryption.local_key`, las claves de S3 y `hawkbit.password`. En modo `native`, el bloque `storage`, contraseña incluida, también se imprime en la salida estándar en cada arranque, sea cual sea el nivel de registro. Usa `info` o superior donde se almacenen o compartan los registros, y guarda los secretos en un gestor de secretos, no en el fichero (consulta las credenciales `*_file` más arriba).",{"_6892":122782,"_42174":122473,"_29767":200409,"_5":21387,"_28235":199711,"_5797":200410},[],"El modo `native` necesita la base de datos, los endpoints a los que llama y las rutas de almacenamiento. Parte de `config-docker.yml`:",{"_6892":122783,"_42174":122473,"_29767":200412,"_5":21387,"_28235":199711,"_5797":200413},[],"El modo `hawkbit` necesita `mode: hawkbit`, `hawkbit.base_url`, las credenciales de la API de gestión y el bloque `storage`. Añade los ajustes de construcción solo si quieres construir. Las claves siguientes son las que usa `config-hawkbit.yml`:",{"_6892":122784,"_42174":122473,"_29767":200415,"_5":21387,"_28235":199711,"_5797":200416},[],"En modo `hawkbit`, las rutas de SymKMS se registran solo cuando `symkms.storage.type` o `sym_keys_dir` están definidos. Con `symkms_endpoint` definido pero ninguno de los dos, el propio servicio respondería `404` a cada consulta de clave.",{"_6892":122785,"_42174":122473,"_29767":200418,"_5":21387,"_28235":199715,"_5797":200419},[],"El binario `cmd/symkms` ejecuta SymKMS en solitario. Su configuración solo tiene `app` (como arriba), `symkms` (un bloque de almacenamiento) y `sym_keys_dir`. Su directorio de claves es por defecto `/data/symmetric_keys` cuando no se define ni `symkms.storage.local_dir` ni `sym_keys_dir`. Sirve `/symkms/v1/*` pero no tiene ruta `/health`, y carece de autenticación igual que el monolito: consulta Seguridad.",{"_6892":122786,"_42174":122473,"_29767":200421,"_5":21387,"_28235":199719,"_5797":200422},[],"Operaciones para los valores de Helm, el escalado y las copias de seguridad.",{"_6892":122787,"_42174":122473,"_29767":200424,"_5":21387,"_28235":199719,"_5797":200425},[],"Modo hawkBit para lo que cambia en ese backend.",{"_6892":122788,"_42174":122473,"_29767":200427,"_5":21387,"_28235":199719,"_5797":200428},[],"Firma y cifrado para las claves que hay detrás de `kms_endpoint` y `symkms`.",{"_6892":122789,"_42174":122473,"_29767":200430,"_5":21387,"_28235":199719,"_5797":200431},[],"Resolución de problemas para los errores de arranque.",{"_6892":122790,"_42174":122790,"_5":21817,"_5797":195585,"_42654":200433,"_29767":200434,"_28235":122790},[77248,187247,193621,187007],[],{"_6892":122791,"_42174":122790,"_29767":200436,"_5":21387,"_28235":122790,"_5797":200437},[],"Qué protege y qué no protege Lamassu Updates, y qué poner a su alrededor antes de exponerlo.",{"_6892":122792,"_42174":122790,"_5":42651,"_29767":200439,"_28235":200440,"_5797":200441},[],"/docs/pr-preview/pr-56/es/platform/updates/security#resumen","Resumen",{"_6892":122793,"_42174":122790,"_5":42651,"_29767":200443,"_28235":200444,"_5797":200445},[],"/docs/pr-preview/pr-56/es/platform/updates/security#qué-poner-delante","Qué poner delante",{"_6892":122794,"_42174":122790,"_5":42651,"_29767":200447,"_28235":200448,"_5797":200449},[],"/docs/pr-preview/pr-56/es/platform/updates/security#cómo-se-identifica-el-servicio-ante-otros","Cómo se identifica el servicio ante otros",{"_6892":122795,"_42174":122790,"_5":42651,"_29767":200451,"_28235":200452,"_5797":200453},[],"/docs/pr-preview/pr-56/es/platform/updates/security#rutas-a-restringir","Rutas a restringir",{"_6892":122796,"_42174":122790,"_5":42651,"_29767":200455,"_28235":200456,"_5797":200457},[],"/docs/pr-preview/pr-56/es/platform/updates/security#qué-comprueba-el-servicio","Qué comprueba el servicio",{"_6892":122797,"_42174":122790,"_5":42651,"_29767":200459,"_28235":200460,"_5797":200461},[],"/docs/pr-preview/pr-56/es/platform/updates/security#urls-de-descarga-prefirmadas","URLs de descarga prefirmadas",{"_6892":122798,"_42174":122790,"_5":42651,"_29767":200463,"_28235":200464,"_5797":200465},[],"/docs/pr-preview/pr-56/es/platform/updates/security#conexiones-salientes","Conexiones salientes",{"_6892":122799,"_42174":122790,"_5":42651,"_29767":200467,"_28235":200468,"_5797":200469},[],"/docs/pr-preview/pr-56/es/platform/updates/security#secretos","Secretos",{"_6892":122800,"_42174":122790,"_5":42651,"_29767":200471,"_28235":200472,"_5797":193637},[],"/docs/pr-preview/pr-56/es/platform/updates/security#modo-hawkbit",{"_6892":122801,"_42174":122790,"_5":42651,"_29767":200474,"_28235":200475,"_5797":200476},[],"/docs/pr-preview/pr-56/es/platform/updates/security#límites-de-petición","Límites de petición",{"_6892":122802,"_42174":122790,"_29767":200478,"_5":21387,"_28235":122790,"_5797":200479},[],"Lamassu Updates delega la autenticación, la autorización y TLS en el gateway de la plataforma que tiene delante. Esta página lista lo que el servicio aplica por sí mismo, lo que no, y qué configurar a su alrededor. Léela antes de exponer el servicio más allá de una red de confianza.",{"_6892":122803,"_42174":122790,"_29767":200481,"_5":21387,"_28235":200440,"_5797":186881},[],{"_6892":122804,"_42174":122790,"_29767":200483,"_5":21387,"_28235":200440,"_5797":194043},[],{"_6892":122805,"_42174":122790,"_29767":200485,"_5":21387,"_28235":200440,"_5797":200486},[],"Autenticación de quien llama a la API",{"_6892":122806,"_42174":122790,"_29767":200488,"_5":21387,"_28235":200440,"_5797":200489},[],"**Ninguna en el servicio.** Todas las rutas están abiertas a cualquiera que alcance el puerto. El gateway debe autenticar.",{"_6892":122807,"_42174":122790,"_29767":200491,"_5":21387,"_28235":200440,"_5797":191823},[],{"_6892":122808,"_42174":122790,"_29767":200493,"_5":21387,"_28235":200440,"_5797":200494},[],"**Sin roles ni permisos por grupo.** El servicio solo hace comprobaciones estructurales (consulta Qué comprueba el servicio). El gateway debe autorizar.",{"_6892":122809,"_42174":122790,"_29767":200496,"_5":21387,"_28235":200440,"_5797":200497},[],"TLS y mTLS (entrada)",{"_6892":122810,"_42174":122790,"_29767":200499,"_5":21387,"_28235":200440,"_5797":200500},[],"**No implementado.** El servicio sirve siempre HTTP sin cifrar.",{"_6892":122811,"_42174":122790,"_29767":200502,"_5":21387,"_28235":200440,"_5797":200503},[],"TLS hacia otros sistemas",{"_6892":122812,"_42174":122790,"_29767":200505,"_5":21387,"_28235":200440,"_5797":200506},[],"Postgres: siempre `sslmode=disable`. KMS: no se verifica en modo `native`, y el script firmante de SWU usa `curl -k`. Consulta Conexiones salientes.",{"_6892":122813,"_42174":122790,"_29767":200508,"_5":21387,"_28235":200440,"_5797":89779},[],{"_6892":122814,"_42174":122790,"_29767":200510,"_5":21387,"_28235":200440,"_5797":200511},[],"Se permite cualquier origen y cualquier cabecera.",{"_6892":122815,"_42174":122790,"_29767":200513,"_5":21387,"_28235":200440,"_5797":200514},[],"Limitación de tasa, cabeceras de seguridad",{"_6892":122816,"_42174":122790,"_29767":200516,"_5":21387,"_28235":200440,"_5797":200517},[],"El servicio no añade ninguna.",{"_6892":122817,"_42174":122790,"_29767":200519,"_5":21387,"_28235":200440,"_5797":200520},[],"Firma de paquetes",{"_6892":122818,"_42174":122790,"_29767":200522,"_5":21387,"_28235":200440,"_5797":200523},[],"Disponible, mediante el KMS de Lamassu. Consulta Firma y cifrado.",{"_6892":122819,"_42174":122790,"_29767":200525,"_5":21387,"_28235":200440,"_5797":200526},[],"Cifrado de paquetes",{"_6892":122820,"_42174":122790,"_29767":200528,"_5":21387,"_28235":200440,"_5797":200529},[],"Disponible: clave compartida o clave por dispositivo.",{"_6892":122821,"_42174":122790,"_29767":200531,"_5":21387,"_28235":200440,"_5797":200532},[],"Cifrado en reposo",{"_6892":122822,"_42174":122790,"_29767":200534,"_5":21387,"_28235":200440,"_5797":200535},[],"Disponible para artefactos, compilaciones y claves, mediante el bloque `encryption` de cada bloque de almacenamiento.",{"_6892":122823,"_42174":122790,"_29767":200537,"_5":21387,"_28235":200440,"_5797":200538},[],"Las claves `cert_file`, `key_file` y `authentication.mutual_tls.*` existen en las estructuras de configuración pero no se leen, así que definirlas no tiene efecto.",{"_6892":122824,"_42174":122790,"_29767":200540,"_5":21387,"_28235":200444,"_5797":200541},[],"Ejecuta el servicio detrás de un gateway o proxy inverso que:",{"_6892":122825,"_42174":122790,"_29767":200543,"_5":21387,"_28235":200444,"_5797":200544},[],"**Termine TLS** entre los clientes y el servicio.",{"_6892":122826,"_42174":122790,"_29767":200546,"_5":21387,"_28235":200444,"_5797":200547},[],"**Autentique y autorice** a quien llama: operadores para la API y dispositivos para las rutas de descarga. Un dispositivo solo debe alcanzar sus propias rutas de descarga, así que haz coincidir el certificado del dispositivo con el `:deviceID` (o `:controllerId`) de la ruta.",{"_6892":122827,"_42174":122790,"_29767":200549,"_5":21387,"_28235":200444,"_5797":200550},[],"**Restrinja las rutas peligrosas** a quienes las necesitan (consulta más abajo).",{"_6892":122828,"_42174":122790,"_29767":200552,"_5":21387,"_28235":200444,"_5797":200553},[],"Mantén el servicio en una red privada. Los dispositivos solo necesitan alcanzar las rutas de descarga y, en modo `native`, el listener de **cliente** de WFX. En modo `hawkbit` hablan con hawkBit (y con el almacén de URLs firmadas) y no con este servicio, salvo por la ruta de descarga de artefactos descrita en Modo hawkBit.",{"_6892":122829,"_42174":122790,"_29767":200555,"_5":21387,"_28235":200444,"_5797":200556},[],"WFX tiene un listener de cliente (`8080` en Compose, publicado como `9080`) y un listener de gestión (`8081`, publicado como `9081`). Lamassu Updates no autentica ninguno de los dos. Los dispositivos solo necesitan el listener de cliente: no expongas el puerto de gestión a los dispositivos ni a redes no confiables.",{"_6892":122830,"_42174":122790,"_29767":200558,"_5":21387,"_28235":200448,"_5797":200559},[],"El servicio no reenvía la identidad de quien llama. Las llamadas al Device Manager y al KMS de Lamassu llevan la cabecera fija `X-Principal-ID: admin-mode`, que la capa de autorización de la plataforma acepta para llamadores internos y que el gateway de la plataforma elimina del tráfico externo. El valor no es configurable, así que apunta `dms_endpoint` y `kms_endpoint` a direcciones internas de servicio, no a una ruta pública de gateway que la rechazaría o la reenviaría. Las llamadas del servicio a SymKMS no llevan credencial.",{"_6892":122831,"_42174":122790,"_29767":200561,"_5":21387,"_28235":200452,"_5797":195234},[],{"_6892":122832,"_42174":122790,"_29767":200563,"_5":21387,"_28235":200452,"_5797":197575},[],{"_6892":122833,"_42174":122790,"_29767":200565,"_5":21387,"_28235":200452,"_5797":92550},[],{"_6892":122834,"_42174":122790,"_29767":200567,"_5":21387,"_28235":200452,"_5797":200568},[],"Devuelve material de clave sin protección.",{"_6892":122835,"_42174":122790,"_29767":200570,"_5":21387,"_28235":200452,"_5797":92556},[],{"_6892":122836,"_42174":122790,"_29767":200572,"_5":21387,"_28235":200452,"_5797":200573},[],"Devuelve el material de clave sin protección de un dispositivo. El servicio Updates lo usa durante una construcción por dispositivo.",{"_6892":122837,"_42174":122790,"_29767":200575,"_5":21387,"_28235":200452,"_5797":200576},[],"`POST /symkms/v1/`, `DELETE /symkms/v1/:keyID`, rutas de asignación de claves",{"_6892":122838,"_42174":122790,"_29767":200578,"_5":21387,"_28235":200452,"_5797":200579},[],"Crean, borran y asignan claves de cifrado.",{"_6892":122839,"_42174":122790,"_29767":200581,"_5":21387,"_28235":200452,"_5797":92568},[],{"_6892":122840,"_42174":122790,"_29767":200583,"_5":21387,"_28235":200452,"_5797":200584},[],"Usan las claves guardadas sobre datos arbitrarios.",{"_6892":122841,"_42174":122790,"_29767":200586,"_5":21387,"_28235":200452,"_5797":92574},[],{"_6892":122842,"_42174":122790,"_29767":200588,"_5":21387,"_28235":200452,"_5797":200589},[],"Falsifica un cambio de estado de un trabajo sin comprobar propiedad. Se registra solo cuando `enable_test_endpoints` es `true`: mantenlo en `false`.",{"_6892":122843,"_42174":122790,"_29767":200591,"_5":21387,"_28235":200452,"_5797":200592},[],"Todo `POST`, `PUT` y `DELETE` de `/updates/v1`",{"_6892":122844,"_42174":122790,"_29767":200594,"_5":21387,"_28235":200452,"_5797":200595},[],"Construir, lanzar, cancelar y borrar. Restríngelos a los operadores.",{"_6892":122845,"_42174":122790,"_29767":200597,"_5":21387,"_28235":200452,"_5797":200598},[],"`GET` de artefactos, descriptores y `artifacts-archive`",{"_6892":122846,"_42174":122790,"_29767":200600,"_5":21387,"_28235":200452,"_5797":200601},[],"Exponen fuentes de firmware y sw-descriptions.",{"_6892":122847,"_42174":122790,"_29767":200603,"_5":21387,"_28235":200452,"_5797":200604},[],"Rutas de descarga con `:deviceID`",{"_6892":122848,"_42174":122790,"_29767":200606,"_5":21387,"_28235":200452,"_5797":200607},[],"Las construcciones por dispositivo se cifran con la clave de ese dispositivo, pero la propia ruta no comprueba quién la pide.",{"_6892":122849,"_42174":122790,"_29767":200609,"_5":21387,"_28235":200456,"_5797":200610},[],"Son defensa en profundidad, no un sustituto del gateway:",{"_6892":122850,"_42174":122790,"_29767":200612,"_5":21387,"_28235":200456,"_5797":200613},[],"Un lanzamiento se direcciona bajo su grupo: una operación sobre un lanzamiento a través de la ruta de otro grupo responde `404`, exactamente igual que para un lanzamiento inexistente, y no cambia nada.",{"_6892":122851,"_42174":122790,"_29767":200615,"_5":21387,"_28235":200456,"_5797":200616},[],"Los umbrales de aprobación y de error deben estar entre 0 y 100.",{"_6892":122852,"_42174":122790,"_29767":200618,"_5":21387,"_28235":200456,"_5797":200619},[],"En modo `native`, los identificadores de paquete, grupo y dispositivo usados en las rutas se validan para que no puedan salir de los directorios de almacenamiento, y un paquete por dispositivo nunca recurre a la construcción compartida para un dispositivo.",{"_6892":122853,"_42174":122790,"_29767":200621,"_5":21387,"_28235":200456,"_5797":200622},[],"Una subida con nombre `.swu` debe ser realmente un SWU: cualquier otro contenido se rechaza con `400`.",{"_6892":122854,"_42174":122790,"_29767":200624,"_5":21387,"_28235":200456,"_5797":200625},[],"Un fichero subido mayor que `max_artifact_size_mb` se rechaza con `413`.",{"_6892":122855,"_42174":122790,"_29767":200627,"_5":21387,"_28235":200456,"_5797":200628},[],"En modo `hawkbit`, la ruta DDI de artefactos sirve un fichero solo si el módulo está asignado o instalado en ese dispositivo.",{"_6892":122856,"_42174":122790,"_29767":200630,"_5":21387,"_28235":200456,"_5797":200631},[],"Todo lo que modifica una versión construida se rechaza (`409`): las versiones son inmutables.",{"_6892":122857,"_42174":122790,"_29767":200633,"_5":21387,"_28235":200460,"_5797":200634},[],"Con `presign.enabled`, una descarga se responde con `302` a una URL de corta duración del almacén S3. El servicio autoriza antes a quien llama (el gateway para la ruta estática y, en modo `hawkbit`, la asignación del dispositivo); el almacén solo comprueba después la firma, así que **la URL es una capacidad al portador**: quien la posee puede obtener ese único objeto hasta que caduca. El diseño hace aceptable esto:",{"_6892":122858,"_42174":122790,"_29767":200636,"_5":21387,"_28235":200460,"_5797":200637},[],"El TTL es corto (por defecto 60 s). Acota cuándo puede **empezar** un GET: una transferencia en curso termina después de caducar, y un dispositivo que reintenta o reanuda vuelve al endpoint estático para obtener una URL nueva. Una URL ya firmada para el mismo objeto se reutiliza mientras le quede `min_remaining` de validez (por defecto `min(25s, ttl/2)`); no concede más que una nueva.",{"_6892":122859,"_42174":122790,"_29767":200639,"_5":21387,"_28235":200460,"_5797":200640},[],"La credencial de firma debe ser **de solo lectura** y distinta de la credencial del almacenamiento. Al arrancar, el servicio hace una prueba de escritura y se niega a ejecutarse si la credencial puede escribir, es la del propio almacenamiento o el almacén la rechaza. Una firma cubre el método y la clave, así que una URL no puede convertirse en un `PUT` ni apuntarse a otro objeto.",{"_6892":122860,"_42174":122790,"_29767":200642,"_5":21387,"_28235":200460,"_5797":200643},[],"El host firmado es el origen **público** del almacén (`presign.public_endpoint`), porque la firma cubre la cabecera `Host`.",{"_6892":122861,"_42174":122790,"_29767":200645,"_5":21387,"_28235":200460,"_5797":200646},[],"No se puede combinar con el cifrado en reposo del mismo almacén (los dispositivos recibirían texto cifrado).",{"_6892":122862,"_42174":122790,"_29767":200648,"_5":21387,"_28235":200460,"_5797":200649},[],"Las respuestas de redirección llevan `Cache-Control: no-store`. Las peticiones `HEAD` las responde el servicio, no se redirigen. Si falla la firma, el servicio transmite el fichero en lugar de hacer fallar la actualización.",{"_6892":122863,"_42174":122790,"_29767":200651,"_5":21387,"_28235":200460,"_5797":200652},[],"Rota la credencial de firma actualizando los ficheros indicados por `access_key_id_file` y `secret_access_key_file`: se releen cada minuto.",{"_6892":122864,"_42174":122790,"_29767":200654,"_5":21387,"_28235":200460,"_5797":200655},[],"El propio almacén debe ser alcanzable por los dispositivos en el endpoint público, y debería aceptar solo la credencial de solo lectura sobre el prefijo que sirve. No publiques la consola del almacén ni su API S3 con credenciales por defecto.",{"_6892":122865,"_42174":122790,"_29767":200657,"_5":21387,"_28235":200464,"_5797":200658},[],"Conexión",{"_6892":122866,"_42174":122790,"_29767":200660,"_5":21387,"_28235":200464,"_5797":200661},[],"Seguridad del transporte",{"_6892":122867,"_42174":122790,"_29767":200663,"_5":21387,"_28235":200464,"_5797":85414},[],{"_6892":122868,"_42174":122790,"_29767":200665,"_5":21387,"_28235":200464,"_5797":200666},[],"`sslmode=disable`, no configurable. Mantén la base de datos en una red privada.",{"_6892":122869,"_42174":122790,"_29767":200668,"_5":21387,"_28235":200464,"_5797":200669},[],"Device Manager de Lamassu",{"_6892":122870,"_42174":122790,"_29767":200671,"_5":21387,"_28235":200464,"_5797":200672},[],"El cliente del SDK de la plataforma Lamassu con sus ajustes por defecto.",{"_6892":122871,"_42174":122790,"_29767":200674,"_5":21387,"_28235":200464,"_5797":200675},[],"KMS de Lamassu",{"_6892":122872,"_42174":122790,"_29767":200677,"_5":21387,"_28235":200464,"_5797":200678},[],"Modo `native`: la verificación del certificado se **omite** en las llamadas propias del servicio, y el script firmante de SWU usa `curl -k`. Modo `hawkbit`: las llamadas del servicio verifican el certificado, el script sigue sin hacerlo. Usa una dirección interna de confianza.",{"_6892":122873,"_42174":122790,"_29767":200680,"_5":21387,"_28235":200464,"_5797":85318},[],{"_6892":122874,"_42174":122790,"_29767":200682,"_5":21387,"_28235":200464,"_5797":200683},[],"El esquema de `symkms_endpoint` (normalmente el propio servicio, por HTTP sin cifrar en los ejemplos), sin credencial. El material de clave sin protección cruza esta conexión: mantenla en `localhost` o en una red privada.",{"_6892":122875,"_42174":122790,"_29767":200685,"_5":21387,"_28235":200464,"_5797":200686},[],"API de gestión de hawkBit",{"_6892":122876,"_42174":122790,"_29767":200688,"_5":21387,"_28235":200464,"_5797":200689},[],"HTTP Basic con `hawkbit.username` y `hawkbit.password`. Usa HTTPS.",{"_6892":122877,"_42174":122790,"_29767":200691,"_5":21387,"_28235":200464,"_5797":85441},[],{"_6892":122878,"_42174":122790,"_29767":200693,"_5":21387,"_28235":200464,"_5797":200694},[],"El esquema de `wfx_endpoint` (HTTP sin cifrar en los ejemplos), hacia el listener de gestión.",{"_6892":122879,"_42174":122790,"_29767":200696,"_5":21387,"_28235":200468,"_5797":200697},[],"`encryption.local_key`, las credenciales de S3 y las contraseñas de base de datos deben venir de un gestor de secretos, no de un fichero del repositorio. Las configuraciones de ejemplo contienen solo valores de desarrollo. Prefiere la forma `*_file` de las credenciales de S3 y de presign, que el servicio relee cada minuto.",{"_6892":122880,"_42174":122790,"_29767":200699,"_5":21387,"_28235":200468,"_5797":200700},[],"El chart de Helm vuelca todo `config` en un ConfigMap. Consulta Operaciones. Sustituye su contraseña de base de datos de ejemplo.",{"_6892":122881,"_42174":122790,"_29767":200702,"_5":21387,"_28235":200468,"_5797":200703},[],"Con `app.logs.level: debug` el servicio registra toda la configuración, secretos incluidos, y en modo `native` imprime el bloque `storage` (con su contraseña) en la salida estándar en cada arranque. Usa `info` o superior en cualquier entorno cuyos registros se almacenen.",{"_6892":122882,"_42174":122790,"_29767":200705,"_5":21387,"_28235":200468,"_5797":200706},[],"Perder `encryption.local_key` deja ilegible todo lo guardado con ella. Consulta Copias de seguridad y restauración.",{"_6892":122883,"_42174":122790,"_29767":200708,"_5":21387,"_28235":200468,"_5797":200709},[],"Las claves de firma permanecen en el KMS de Lamassu: el servicio nunca tiene la clave privada. Las claves de cifrado de dispositivo sí viven en SymKMS (opcionalmente cifradas en reposo), porque los paquetes deben cifrarse con ellas.",{"_6892":122884,"_42174":122790,"_29767":200711,"_5":21387,"_28235":200468,"_5797":200712},[],"La imagen de contenedor no reduce privilegios. Define un `securityContext` adecuado para tu clúster.",{"_6892":122885,"_42174":122790,"_29767":200714,"_5":21387,"_28235":200472,"_5797":200715},[],"El usuario de la API de gestión es administrador completo de hawkBit. Cambia la credencial por defecto (`admin`), mantén la API fuera de la red de dispositivos y sírvela por HTTPS.",{"_6892":122886,"_42174":122790,"_29767":200717,"_5":21387,"_28235":200472,"_5797":200718},[],"Los dispositivos se autentican ante hawkBit, no ante este servicio. hawkBit 1.1.0 no tiene modo anónimo: habilita un token de seguridad de target, un token de gateway o el autenticador por cabecera de proxy inverso, y para este último restringe qué direcciones pueden fijar sus cabeceras. Dejar desactivada la autenticación de dispositivos, aceptable solo en una pila de pruebas desechable, permite que cualquiera que alcance hawkBit suplante a un dispositivo. Consulta Modo hawkBit.",{"_6892":122887,"_42174":122790,"_29767":200720,"_5":21387,"_28235":200472,"_5797":200721},[],"hawkBit no cifra los artefactos en reposo. Activa el cifrado por defecto en el bucket, o usa paquetes cifrados (clave compartida).",{"_6892":122888,"_42174":122790,"_29767":200723,"_5":21387,"_28235":200475,"_5797":200724},[],"Un cuerpo de petición puede llegar a `max_artifact_size_mb` más 1 MiB (10 GiB por defecto), y una petición puede durar hasta 6 horas, así que las subidas grandes funcionan. Las subidas en streaming usan disco temporal bajo `TMPDIR`. Aplica límites más estrictos en el gateway para quienes no sean de confianza: el servicio no limita la tasa de peticiones.",{"_6892":122889,"_42174":122889,"_5":21817,"_5797":197093,"_42654":200726,"_29767":200727,"_28235":122889},[77248,187247,193621,192003],[],{"_6892":122890,"_42174":122889,"_29767":200729,"_5":21387,"_28235":122889,"_5797":200730},[],"Firma los entregables con el KMS de Lamassu, cífralos con una clave compartida o por dispositivo y gestiona las claves de dispositivo en SymKMS.",{"_6892":122891,"_42174":122889,"_5":42651,"_29767":200732,"_28235":200733,"_5797":200734},[],"/docs/pr-preview/pr-56/es/platform/updates/signing-and-encryption#firma","Firma",{"_6892":122892,"_42174":122889,"_5":42651,"_29767":200736,"_28235":200737,"_5797":200738},[],"/docs/pr-preview/pr-56/es/platform/updates/signing-and-encryption#configura-la-firma","Configura la firma",{"_6892":122893,"_42174":122889,"_5":42651,"_29767":200740,"_28235":200741,"_5797":200742},[],"/docs/pr-preview/pr-56/es/platform/updates/signing-and-encryption#crea-la-clave-y-un-certificado","Crea la clave y un certificado",{"_6892":122894,"_42174":122889,"_5":42651,"_29767":200744,"_28235":200745,"_5797":200746},[],"/docs/pr-preview/pr-56/es/platform/updates/signing-and-encryption#configura-el-servicio","Configura el servicio",{"_6892":122895,"_42174":122889,"_5":42651,"_29767":200748,"_28235":200749,"_5797":200750},[],"/docs/pr-preview/pr-56/es/platform/updates/signing-and-encryption#envía-los-campos-de-firma-en-la-construcción","Envía los campos de firma en la construcción",{"_6892":122896,"_42174":122889,"_5":42651,"_29767":200752,"_28235":200753,"_5797":200754},[],"/docs/pr-preview/pr-56/es/platform/updates/signing-and-encryption#manifiestos-firmados","Manifiestos firmados",{"_6892":122897,"_42174":122889,"_5":42651,"_29767":200756,"_28235":200757,"_5797":200758},[],"/docs/pr-preview/pr-56/es/platform/updates/signing-and-encryption#modos-de-cifrado","Modos de cifrado",{"_6892":122898,"_42174":122889,"_5":42651,"_29767":200760,"_28235":200761,"_5797":200762},[],"/docs/pr-preview/pr-56/es/platform/updates/signing-and-encryption#algoritmos","Algoritmos",{"_6892":122899,"_42174":122889,"_5":42651,"_29767":200764,"_28235":200765,"_5797":200766},[],"/docs/pr-preview/pr-56/es/platform/updates/signing-and-encryption#configurar-el-cifrado-por-dispositivo","Configurar el cifrado por dispositivo",{"_6892":122900,"_42174":122889,"_5":42651,"_29767":200768,"_28235":200769,"_5797":200770},[],"/docs/pr-preview/pr-56/es/platform/updates/signing-and-encryption#crea-una-clave-por-dispositivo","Crea una clave por dispositivo",{"_6892":122901,"_42174":122889,"_5":42651,"_29767":200772,"_28235":200773,"_5797":200774},[],"/docs/pr-preview/pr-56/es/platform/updates/signing-and-encryption#asígnala-al-dispositivo","Asígnala al dispositivo",{"_6892":122902,"_42174":122889,"_5":42651,"_29767":200776,"_28235":200777,"_5797":200778},[],"/docs/pr-preview/pr-56/es/platform/updates/signing-and-encryption#pon-la-misma-clave-en-el-dispositivo","Pon la misma clave en el dispositivo",{"_6892":122903,"_42174":122889,"_5":42651,"_29767":200780,"_28235":200781,"_5797":200782},[],"/docs/pr-preview/pr-56/es/platform/updates/signing-and-encryption#construye","Construye",{"_6892":122904,"_42174":122889,"_5":42651,"_29767":200784,"_28235":200785,"_5797":85318},[],"/docs/pr-preview/pr-56/es/platform/updates/signing-and-encryption#symkms",{"_6892":122905,"_42174":122889,"_5":42651,"_29767":200787,"_28235":200788,"_5797":200789},[],"/docs/pr-preview/pr-56/es/platform/updates/signing-and-encryption#cuerpos-de-petición","Cuerpos de petición",{"_6892":122906,"_42174":122889,"_29767":200791,"_5":21387,"_28235":122889,"_5797":200792},[],"Esta página explica cómo protege Lamassu Updates lo que entrega: qué claves firman y cifran un paquete, cómo configurarlas y qué soporta cada backend. Hay tres capas independientes.",{"_6892":122907,"_42174":122889,"_29767":200794,"_5":21387,"_28235":122889,"_5797":200795},[],"Capa",{"_6892":122908,"_42174":122889,"_29767":200797,"_5":21387,"_28235":122889,"_5797":200798},[],"Protege",{"_6892":122909,"_42174":122889,"_29767":200800,"_5":21387,"_28235":122889,"_5797":200801},[],"Se configura en",{"_6892":122910,"_42174":122889,"_29767":200803,"_5":21387,"_28235":122889,"_5797":200804},[],"Firma del paquete",{"_6892":122911,"_42174":122889,"_29767":200806,"_5":21387,"_28235":122889,"_5797":200807},[],"Que el paquete viene de ti y no se ha modificado",{"_6892":122912,"_42174":122889,"_29767":200809,"_5":21387,"_28235":122889,"_5797":200810},[],"Una clave de firma y un certificado en el KMS de Lamassu, más `kms_endpoint` y `sign_script_path`",{"_6892":122913,"_42174":122889,"_29767":200812,"_5":21387,"_28235":122889,"_5797":200813},[],"Cifrado del paquete",{"_6892":122914,"_42174":122889,"_29767":200815,"_5":21387,"_28235":122889,"_5797":200816},[],"El contenido del paquete en tránsito y en la ruta de descarga del dispositivo",{"_6892":122915,"_42174":122889,"_29767":200818,"_5":21387,"_28235":122889,"_5797":200819},[],"La petición de construcción, más una clave en SymKMS",{"_6892":122916,"_42174":122889,"_29767":200821,"_5":21387,"_28235":122889,"_5797":200532},[],{"_6892":122917,"_42174":122889,"_29767":200823,"_5":21387,"_28235":122889,"_5797":200824},[],"Artefactos, compilaciones y claves que almacena el servicio",{"_6892":122918,"_42174":122889,"_29767":200826,"_5":21387,"_28235":122889,"_5797":200827},[],"El bloque `encryption` de cada bloque de almacenamiento de blobs",{"_6892":122919,"_42174":122889,"_29767":200829,"_5":21387,"_28235":200733,"_5797":200830},[],"La firma es opcional. Cuando la pides, `swugenerator` llama al script firmante configurado (`sign_script_path`, que es `sign_kms.sh`) y el script pide al KMS de Lamassu (`kms_endpoint`) que firme. La clave privada nunca llega a la máquina que construye el paquete.",{"_6892":122920,"_42174":122889,"_29767":200832,"_5":21387,"_28235":200733,"_5797":200833},[],"Para las construcciones de `.swu` deben estar definidos ambos ajustes: el servicio rechaza una petición de firma cuando falta alguno.",{"_6892":122921,"_42174":122889,"_29767":200835,"_5":21387,"_28235":200733,"_5797":200836},[],"Firmar un manifiesto, un paquete `non-swu` o un módulo `raw` de hawkBit llama al KMS directamente desde el servicio y solo necesita `kms_endpoint`.",{"_6892":122922,"_42174":122889,"_29767":200838,"_5":21387,"_28235":200733,"_5797":200839},[],"Selecciona la clave en la petición de construcción con `signature_key_id`, `signature_alg_name` (por defecto `RSASSA_PSS_SHA_256`; `-` y `_` son intercambiables) y `signature_certificate` (PEM). Los tres campos van juntos: una petición con clave pero sin algoritmo o certificado se rechaza, nunca se construye sin firmar.",{"_6892":122923,"_42174":122889,"_29767":200841,"_5":21387,"_28235":200741,"_5797":200842},[],"En el KMS de Lamassu, crea (o elige) la clave de firma y emite un certificado para ella desde una CA en la que confíen tus dispositivos. Consulta Claves y motores criptográficos. El ID de la clave es tu `signature_key_id`.",{"_6892":122924,"_42174":122889,"_29767":200844,"_5":21387,"_28235":200745,"_5797":200845},[],"Define `kms_endpoint` y `sign_script_path` (`/app/sign_kms.sh` en la imagen). `swugenerator` llama al script con el ID de la clave, la URL del KMS, el algoritmo y la ruta del fichero del certificado, que el script exige. El script escribe un registro de depuración en `/tmp/sign_kms_debug.log`.",{"_6892":122925,"_42174":122889,"_29767":200847,"_5":21387,"_28235":200749,"_5797":200848},[],"Incluye `signature_key_id`, `signature_alg_name` y `signature_certificate` en el cuerpo de la construcción. En modo `hawkbit` van en el cuerpo de la construcción del módulo.",{"_6892":122926,"_42174":122889,"_29767":200850,"_5":21387,"_28235":200749,"_5797":200851},[],"SWUpdate verifica un `.swu` con una firma CMS `SignedData`, y el servicio exige CMS para los manifiestos que firma él mismo. Un KMS de Lamassu que ignora la cabecera `Accept` y responde con una firma simple dentro de un sobre JSON produce una firma que ningún dispositivo puede verificar. Cuando firma el propio servicio (manifiestos de versión, manifiestos de conjunto, sumas de verificación de módulos raw) rechaza esa respuesta y la operación falla con `the KMS did not return a PKCS7/CMS signature`. El script firmante de SWU no comprueba el formato: desempaqueta la respuesta y la incrusta, así que con un KMS sin soporte CMS una construcción de `.swu` puede salir bien y aun así ser rechazada por un dispositivo que define `public-key-file`. Prueba una construcción firmada en un dispositivo real antes de fiarte de una versión del KMS.",{"_6892":122927,"_42174":122889,"_29767":200853,"_5":21387,"_28235":200749,"_5797":200854},[],"`sign_kms_nocms.sh` es una variante del script que no recibe certificado. La firma de manifiestos del propio servicio es independiente: envía siempre el certificado y se niega a firmar sin él.",{"_6892":122928,"_42174":122889,"_29767":200856,"_5":21387,"_28235":200749,"_5797":200857},[],"TLS hacia el KMS: en modo `native` el cliente KMS del servicio omite la verificación del certificado, y `sign_kms.sh` llama a `curl -k`. En modo `hawkbit` las llamadas del propio servicio al KMS verifican el certificado, pero el script firmante de SWU sigue usando `curl -k`. Alcanza el KMS por una dirección interna de confianza. Consulta Seguridad.",{"_6892":122929,"_42174":122889,"_29767":200859,"_5":21387,"_28235":200753,"_5797":200860},[],"Cada versión construida tiene además un **manifiesto**, un registro antirretroceso de lo que contiene la versión: nombre, grupo, versión, empaquetado, artefactos con su SHA-256, el entregable y, en modo `hawkbit`, los módulos y versiones exactos que componen el conjunto. Un manifiesto es válido durante 5 años (`expires_at`). Se firma con la clave del KMS cuando la construcción llevaba campos de firma, y se guarda sin firmar en caso contrario (el servicio registra una advertencia). Si hay una clave de firma configurada pero el manifiesto no se puede firmar, la construcción falla.",{"_6892":122930,"_42174":122889,"_29767":200862,"_5":21387,"_28235":200753,"_5797":200863},[],"Léelo con:",{"_6892":122931,"_42174":122889,"_29767":200865,"_5":21387,"_28235":200753,"_5797":200866},[],"La respuesta contiene `manifest` (los bytes exactos que cubre la firma), `signature` (CMS en base64), `algorithm`, `certificate` (PEM), `signed_at` y `expires_at`. En modo `hawkbit`, `stale: true` significa que existe un manifiesto firmado pero el contenido del conjunto ha cambiado desde entonces, así que el manifiesto devuelto describe el conjunto tal como está ahora. La capacidad `artifact_signatures` indica si el backend activo lo ofrece.",{"_6892":122932,"_42174":122889,"_29767":200868,"_5":21387,"_28235":200757,"_5797":199976},[],{"_6892":122933,"_42174":122889,"_29767":200870,"_5":21387,"_28235":200757,"_5797":200871},[],"Qué obtienes",{"_6892":122934,"_42174":122889,"_29767":200873,"_5":21387,"_28235":200757,"_5797":89209},[],{"_6892":122935,"_42174":122889,"_29767":200875,"_5":21387,"_28235":200757,"_5797":86482},[],{"_6892":122936,"_42174":122889,"_29767":200877,"_5":21387,"_28235":200757,"_5797":197452},[],{"_6892":122937,"_42174":122889,"_29767":200879,"_5":21387,"_28235":200757,"_5797":200880},[],"Un entregable sin cifrar",{"_6892":122938,"_42174":122889,"_29767":200882,"_5":21387,"_28235":200757,"_5797":189875},[],{"_6892":122939,"_42174":122889,"_29767":200884,"_5":21387,"_28235":200757,"_5797":189875},[],{"_6892":122940,"_42174":122889,"_29767":200886,"_5":21387,"_28235":200757,"_5797":200887},[],"Compartido",{"_6892":122941,"_42174":122889,"_29767":200889,"_5":21387,"_28235":200757,"_5797":200890},[],"Un entregable cifrado con una clave, servido a todos los dispositivos",{"_6892":122942,"_42174":122889,"_29767":200892,"_5":21387,"_28235":200757,"_5797":189875},[],{"_6892":122943,"_42174":122889,"_29767":200894,"_5":21387,"_28235":200757,"_5797":200895},[],"Sí, mediante los endpoints de construcción de módulos, cuando el pipeline de construcción está configurado",{"_6892":122944,"_42174":122889,"_29767":200897,"_5":21387,"_28235":200757,"_5797":200898},[],"Por dispositivo",{"_6892":122945,"_42174":122889,"_29767":200900,"_5":21387,"_28235":200757,"_5797":200901},[],"Un entregable por dispositivo, cada uno cifrado con la clave propia de ese dispositivo en SymKMS",{"_6892":122946,"_42174":122889,"_29767":200903,"_5":21387,"_28235":200757,"_5797":189875},[],{"_6892":122947,"_42174":122889,"_29767":200905,"_5":21387,"_28235":200757,"_5797":81448},[],{"_6892":122948,"_42174":122889,"_29767":200907,"_5":21387,"_28235":200757,"_5797":200908},[],"El cuerpo de la construcción decide el modo:",{"_6892":122949,"_42174":122889,"_29767":200910,"_5":21387,"_28235":200757,"_5797":200911},[],"**Compartido**: envía `user`, `encryption_key_name` y `encryption_alg_name`. Una construcción de `.swu` se rechaza sin el algoritmo. Una construcción `.../package` elige AES-GCM según la longitud de la clave y solo registra el nombre que envíes.",{"_6892":122950,"_42174":122889,"_29767":200913,"_5":21387,"_28235":200757,"_5797":200914},[],"**Por dispositivo**: envía `encryption_alg_name` **sin** `user` ni `encryption_key_name`. Esto vale también para `.../package`: enviar el algoritmo es lo que selecciona el modo por dispositivo, y omitirlo construye un paquete sin cifrar.",{"_6892":122951,"_42174":122889,"_29767":200916,"_5":21387,"_28235":200757,"_5797":200917},[],"**Ninguno**: no envíes ninguno de los dos.",{"_6892":122952,"_42174":122889,"_29767":200919,"_5":21387,"_28235":200757,"_5797":200920},[],"Otros campos de la construcción: `sw_desc_encrypted` cifra también la propia sw-description, y `selected_artifact_ids` lista los artefactos que incluye la construcción. En modo `native`, una construcción de `.swu` sin artefactos seleccionados falla.",{"_6892":122953,"_42174":122889,"_29767":200922,"_5":21387,"_28235":200757,"_5797":200923},[],"En modo `hawkbit`, `POST .../swu` devuelve `501`. Envía en su lugar los mismos campos de firma y cifrado a la construcción del módulo: `POST /updates/v1/softwaremodules/by-id/:moduleID/build` (para módulos `swu-build` y `raw`). Consulta Modo hawkBit.",{"_6892":122954,"_42174":122889,"_29767":200925,"_5":21387,"_28235":200757,"_5797":200926},[],"La sw-description debe marcar los artefactos a cifrar con `encrypted = true;`. Una construcción por dispositivo se rechaza cuando no hay ningún artefacto marcado, porque la clave por sí sola no hace nada.",{"_6892":122955,"_42174":122889,"_29767":200928,"_5":21387,"_28235":200761,"_5797":200929},[],"El `algorithm` de una clave de SymKMS y el `encryption_alg_name` de una construcción usan estos nombres.",{"_6892":122956,"_42174":122889,"_29767":200931,"_5":21387,"_28235":200761,"_5797":200932},[],"Algoritmo",{"_6892":122957,"_42174":122889,"_29767":200934,"_5":21387,"_28235":200761,"_5797":200935},[],"Longitud de clave",{"_6892":122958,"_42174":122889,"_29767":200937,"_5":21387,"_28235":200761,"_5797":92920},[],{"_6892":122959,"_42174":122889,"_29767":200939,"_5":21387,"_28235":200761,"_5797":92923},[],{"_6892":122960,"_42174":122889,"_29767":200941,"_5":21387,"_28235":200761,"_5797":92926},[],{"_6892":122961,"_42174":122889,"_29767":200943,"_5":21387,"_28235":200761,"_5797":92929},[],{"_6892":122962,"_42174":122889,"_29767":200945,"_5":21387,"_28235":200761,"_5797":92932},[],{"_6892":122963,"_42174":122889,"_29767":200947,"_5":21387,"_28235":200761,"_5797":92935},[],{"_6892":122964,"_42174":122889,"_29767":200949,"_5":21387,"_28235":200761,"_5797":92938},[],{"_6892":122965,"_42174":122889,"_29767":200951,"_5":21387,"_28235":200761,"_5797":92923},[],{"_6892":122966,"_42174":122889,"_29767":200953,"_5":21387,"_28235":200761,"_5797":92943},[],{"_6892":122967,"_42174":122889,"_29767":200955,"_5":21387,"_28235":200761,"_5797":92946},[],{"_6892":122968,"_42174":122889,"_29767":200957,"_5":21387,"_28235":200761,"_5797":200958},[],"**Nombres de clave en SymKMS**: la comparación ignora mayúsculas y minúsculas, y `_` y `-` son intercambiables (`aes_256_gcm` se guarda como `AES-256-GCM`). Los separadores del nombre deben seguir estando: `ascon128a` no es `ASCON-128A`. Una clave cuya longitud no coincide con su algoritmo se rechaza al crearla.",{"_6892":122969,"_42174":122889,"_29767":200960,"_5":21387,"_28235":200761,"_5797":200961},[],"**Nombres en construcciones**: `encryption_alg_name` se pasa tal cual a `swugenerator`. Se ignoran las mayúsculas, pero los guiones son obligatorios: `aes-256-gcm` funciona, `AES_256_GCM` se rechaza. Si el nombre difiere del algoritmo guardado con la clave, el servicio registra una advertencia y usa el nombre de la petición.",{"_6892":122970,"_42174":122889,"_29767":200963,"_5":21387,"_28235":200761,"_5797":200964},[],"**Los paquetes `non-swu`** (`.../package`, y los módulos `raw` de `hawkbit`) se cifran siempre con **AES-GCM**, elegido por la longitud de la clave (16, 24 o 32 bytes). El nombre solicitado solo se registra, y una clave Ascon-80pq de 20 bytes se rechaza. El resultado es `nonce || ciphertext`.",{"_6892":122971,"_42174":122889,"_29767":200966,"_5":21387,"_28235":200761,"_5797":200967},[],"El servicio genera el IV o nonce. En modo `native`, el algoritmo y, en los paquetes con clave compartida, el IV se pasan al dispositivo en el trabajo de WFX. Una construcción por dispositivo genera un IV nuevo para cada dispositivo y no lo registra en el trabajo, así que el trabajo lleva solo el algoritmo. Los campos del trabajo se listan en Conectar un dispositivo.",{"_6892":122972,"_42174":122889,"_29767":200969,"_5":21387,"_28235":200769,"_5797":200970},[],"En SymKMS, `POST /symkms/v1/` con `user_id`, un `algorithm` de la tabla y una `key` (hex o base64) de la longitud correcta.",{"_6892":122973,"_42174":122889,"_29767":200972,"_5":21387,"_28235":200773,"_5797":200973},[],"`POST /symkms/v1/inventory/:deviceID/keys/:keyID` con un cuerpo `{\"purpose\":\"firmware-encryption\"}` y un `expires_at` opcional (RFC 3339). Una construcción por dispositivo pide la clave `firmware-encryption` de cada dispositivo.",{"_6892":122974,"_42174":122889,"_29767":200975,"_5":21387,"_28235":200777,"_5797":200976},[],"En la forma que espera SWUpdate (su fichero de claves `-K`, con la clave, el IV y el algoritmo).",{"_6892":122975,"_42174":122889,"_29767":200978,"_5":21387,"_28235":200781,"_5797":200979},[],"Envía `encryption_alg_name` y no envíes `user` ni `encryption_key_name`. La sw-description debe marcar un artefacto con `encrypted = true;`.",{"_6892":122976,"_42174":122889,"_29767":200981,"_5":21387,"_28235":200781,"_5797":200982},[],"**Propósitos de clave.** Los propósitos convencionales son `firmware-encryption`, `config-encryption` y `mac-verification`. El propósito es un marcador de posición: se acepta cualquier valor, y una asignación con propósito vacío actúa como comodín que coincide con cualquier búsqueda. Es intencionado mientras se despliegan las claves por propósito. Una coincidencia exacta (sin distinguir mayúsculas) gana al comodín, y entre iguales gana la asignación más reciente. Las asignaciones caducadas o revocadas se omiten.",{"_6892":122977,"_42174":122889,"_29767":200984,"_5":21387,"_28235":200781,"_5797":200985},[],"**Cobertura.** Un dispositivo sin clave `firmware-encryption` se omite (el motivo dice `no firmware-encryption key assigned` en las construcciones de `.swu`). La construcción sigue teniendo éxito si se cubrió al menos un dispositivo, y el paquete registra la cobertura: lee `built_device_count`, `total_device_count` y `uncovered_devices` en él. Un lanzamiento sobre un paquete con dispositivos sin cubrir se rechaza con `400`, y no hay forma de forzarlo: asigna las claves que faltan y construye de nuevo. Si no se cubrió ningún dispositivo, falla la propia construcción.",{"_6892":122978,"_42174":122889,"_29767":200987,"_5":21387,"_28235":200781,"_5797":200988},[],"**Coste.** Una construcción por dispositivo ejecuta un proceso `swugenerator` por dispositivo, en paralelo hasta la CPU disponible para el contenedor. Con un artefacto de 100 MB, un dispositivo cuesta aproximadamente medio segundo de cifrado, más unos tres segundos adicionales si la sw-description pide compresión gzip. Dimensiona el contenedor en consecuencia: consulta Dimensionado de recursos. Las construcciones del mismo paquete se serializan: una segunda construcción o un cambio de versión mientras otra se ejecuta responde `409`.",{"_6892":122979,"_42174":122889,"_29767":200990,"_5":21387,"_28235":200785,"_5797":200991},[],"SymKMS es el servicio de claves simétricas integrado, servido por el mismo proceso bajo `/symkms/v1`. Almacena claves, las asigna a dispositivos y también puede cifrar, descifrar y calcular MAC. Las claves se guardan en el almacén de blobs `symkms`, opcionalmente con cifrado en reposo. Crea las claves con la longitud correcta para su algoritmo: bytes aleatorios, nunca una frase de contraseña.",{"_6892":122980,"_42174":122889,"_29767":200993,"_5":21387,"_28235":200785,"_5797":200994},[],"Tarea",{"_6892":122981,"_42174":122889,"_29767":200996,"_5":21387,"_28235":200785,"_5797":195234},[],{"_6892":122982,"_42174":122889,"_29767":200998,"_5":21387,"_28235":200785,"_5797":200999},[],"Guardar una clave",{"_6892":122983,"_42174":122889,"_29767":201001,"_5":21387,"_28235":200785,"_5797":92993},[],{"_6892":122984,"_42174":122889,"_29767":201003,"_5":21387,"_28235":200785,"_5797":201004},[],"Listar las claves de un usuario",{"_6892":122985,"_42174":122889,"_29767":201006,"_5":21387,"_28235":200785,"_5797":92999},[],{"_6892":122986,"_42174":122889,"_29767":201008,"_5":21387,"_28235":200785,"_5797":201009},[],"Borrar una clave",{"_6892":122987,"_42174":122889,"_29767":201011,"_5":21387,"_28235":200785,"_5797":93005},[],{"_6892":122988,"_42174":122889,"_29767":201013,"_5":21387,"_28235":200785,"_5797":201014},[],"Asignar o revocar una clave a un dispositivo",{"_6892":122989,"_42174":122889,"_29767":201016,"_5":21387,"_28235":200785,"_5797":201017},[],"`POST` o `DELETE /symkms/v1/inventory/:deviceID/keys/:keyID`",{"_6892":122990,"_42174":122889,"_29767":201019,"_5":21387,"_28235":200785,"_5797":201020},[],"La clave activa de un dispositivo (privilegiada, devuelve material de clave)",{"_6892":122991,"_42174":122889,"_29767":201022,"_5":21387,"_28235":200785,"_5797":93017},[],{"_6892":122992,"_42174":122889,"_29767":201024,"_5":21387,"_28235":200785,"_5797":201025},[],"Qué dispositivos usan una clave",{"_6892":122993,"_42174":122889,"_29767":201027,"_5":21387,"_28235":200785,"_5797":93023},[],{"_6892":122994,"_42174":122889,"_29767":201029,"_5":21387,"_28235":200785,"_5797":201030},[],"Las asignaciones de clave de un dispositivo",{"_6892":122995,"_42174":122889,"_29767":201032,"_5":21387,"_28235":200785,"_5797":93029},[],{"_6892":122996,"_42174":122889,"_29767":201034,"_5":21387,"_28235":200785,"_5797":201035},[],"Cifrar, descifrar",{"_6892":122997,"_42174":122889,"_29767":201037,"_5":21387,"_28235":200785,"_5797":93035},[],{"_6892":122998,"_42174":122889,"_29767":201039,"_5":21387,"_28235":200785,"_5797":201040},[],"Calcular y verificar MAC",{"_6892":122999,"_42174":122889,"_29767":201042,"_5":21387,"_28235":200785,"_5797":201043},[],"`POST /symkms/v1/mac`, `POST /symkms/v1/mac/verify` (y las variantes `/file`)",{"_6892":123000,"_42174":122889,"_29767":201045,"_5":21387,"_28235":200788,"_5797":195234},[],{"_6892":123001,"_42174":122889,"_29767":201047,"_5":21387,"_28235":200788,"_5797":201048},[],"Cuerpo (JSON)",{"_6892":123002,"_42174":122889,"_29767":201050,"_5":21387,"_28235":200788,"_5797":92993},[],{"_6892":123003,"_42174":122889,"_29767":201052,"_5":21387,"_28235":200788,"_5797":201053},[],"`user_id`, `algorithm`, `key` (hex o base64; se prueba hex primero), `id` opcional. `user_id`, `algorithm` y `key` son obligatorios.",{"_6892":123004,"_42174":122889,"_29767":201055,"_5":21387,"_28235":200788,"_5797":93054},[],{"_6892":123005,"_42174":122889,"_29767":201057,"_5":21387,"_28235":200788,"_5797":201058},[],"`user_id`, `key_name`, `algorithm`, `plaintext` (base64), `iv` opcional, `format` opcional.",{"_6892":123006,"_42174":122889,"_29767":201060,"_5":21387,"_28235":200788,"_5797":93060},[],{"_6892":123007,"_42174":122889,"_29767":201062,"_5":21387,"_28235":200788,"_5797":201063},[],"`user_id`, `key_name`, `algorithm`, `ciphertext`, `iv`, `format` opcional.",{"_6892":123008,"_42174":122889,"_29767":201065,"_5":21387,"_28235":200788,"_5797":93066},[],{"_6892":123009,"_42174":122889,"_29767":201067,"_5":21387,"_28235":200788,"_5797":201068},[],"`user_id`, `key_name`, `mac_algorithm`, `data` (base64). El MAC se devuelve en hex.",{"_6892":123010,"_42174":122889,"_29767":201070,"_5":21387,"_28235":200788,"_5797":93072},[],{"_6892":123011,"_42174":122889,"_29767":201072,"_5":21387,"_28235":200788,"_5797":201073},[],"Igual que `/mac`, más `mac` (hex).",{"_6892":123012,"_42174":122889,"_29767":201075,"_5":21387,"_28235":200788,"_5797":201076},[],"`format` es `ciphertext` (hex, el valor por defecto), `base64` o `cms` (`pkcs7` es un alias): una estructura CMS codificada en PEM que incluye el algoritmo y el IV. Con `cms`, `decrypt` puede omitir `algorithm` e `iv`.",{"_6892":123013,"_42174":122889,"_29767":201078,"_5":21387,"_28235":200788,"_5797":201079},[],"El servidor genera el nonce para GCM, CTR y Ascon: **se rechaza un `iv` aportado por quien llama** para esos algoritmos. Solo CBC acepta uno (16 bytes). La respuesta incluye el `iv` usado (hex).",{"_6892":123014,"_42174":122889,"_29767":201081,"_5":21387,"_28235":200788,"_5797":201082},[],"`mac_algorithm` es `HMAC-SHA3-256`, `AES-CMAC` o `ASCON-MAC`. Las variantes `/file` reciben los datos como `multipart/form-data`.",{"_6892":123015,"_42174":122889,"_29767":201084,"_5":21387,"_28235":200788,"_5797":201085},[],"`GET /symkms/v1/:keyID/raw?user_id=...` y `GET /symkms/v1/inventory/:deviceID/key` devuelven material de clave sin protección y son privilegiadas: el propio servicio Updates las llama durante una construcción. El servicio no tiene autenticación propia, así que restringe estas rutas en un gateway. Consulta Seguridad.",{"_6892":123016,"_42174":122889,"_29767":201087,"_5":21387,"_28235":200788,"_5797":201088},[],"Las mismas rutas de SymKMS pueden ejecutarse como proceso propio (`cmd/symkms`) en lugar de dentro del monolito. Consulta Configuración.",{"_6892":123017,"_42174":123017,"_5":21817,"_5797":193515,"_42654":201090,"_29767":201091,"_28235":123017},[77248,187247,193621,187007],[],{"_6892":123018,"_42174":123017,"_29767":201093,"_5":21387,"_28235":123017,"_5797":201094},[],"Síntomas, causas probables y soluciones para errores de arranque, llamadas a la API, construcciones, descargas y actualizaciones que no llegan a los dispositivos.",{"_6892":123019,"_42174":123017,"_5":42651,"_29767":201096,"_28235":201097,"_5797":201098},[],"/docs/pr-preview/pr-56/es/platform/updates/troubleshooting#códigos-de-estado-http","Códigos de estado HTTP",{"_6892":123020,"_42174":123017,"_5":42651,"_29767":201100,"_28235":201101,"_5797":201102},[],"/docs/pr-preview/pr-56/es/platform/updates/troubleshooting#arranque-del-servicio","Arranque del servicio",{"_6892":123021,"_42174":123017,"_5":42651,"_29767":201104,"_28235":201105,"_5797":201106},[],"/docs/pr-preview/pr-56/es/platform/updates/troubleshooting#llamadas-a-la-api","Llamadas a la API",{"_6892":123022,"_42174":123017,"_5":42651,"_29767":201108,"_28235":201109,"_5797":201110},[],"/docs/pr-preview/pr-56/es/platform/updates/troubleshooting#construcciones","Construcciones",{"_6892":123023,"_42174":123017,"_5":42651,"_29767":201112,"_28235":201113,"_5797":201114},[],"/docs/pr-preview/pr-56/es/platform/updates/troubleshooting#descargas-y-urls-prefirmadas","Descargas y URLs prefirmadas",{"_6892":123024,"_42174":123017,"_5":42651,"_29767":201116,"_28235":201117,"_5797":201118},[],"/docs/pr-preview/pr-56/es/platform/updates/troubleshooting#actualizaciones-que-no-llegan-a-los-dispositivos","Actualizaciones que no llegan a los dispositivos",{"_6892":123025,"_42174":123017,"_5":42651,"_29767":201120,"_28235":201121,"_5797":201122},[],"/docs/pr-preview/pr-56/es/platform/updates/troubleshooting#escalado-y-trabajo-en-segundo-plano","Escalado y trabajo en segundo plano",{"_6892":123026,"_42174":123017,"_5":42651,"_29767":201124,"_28235":201125,"_5797":201126},[],"/docs/pr-preview/pr-56/es/platform/updates/troubleshooting#obtener-más-información","Obtener más información",{"_6892":123027,"_42174":123017,"_29767":201128,"_5":21387,"_28235":123017,"_5797":201129},[],"Diagnostica una operación cada vez. Anota el backend (`GET /updates/v1/capabilities` lo muestra), el endpoint, el estado HTTP y el texto `err` del cuerpo de la respuesta: los errores se devuelven como `{\"err\": \"...\"}`. Si tu problema no está aquí, consulta primero Limitaciones.",{"_6892":123028,"_42174":123017,"_29767":201131,"_5":21387,"_28235":201097,"_5797":194043},[],{"_6892":123029,"_42174":123017,"_29767":201133,"_5":21387,"_28235":201097,"_5797":193986},[],{"_6892":123030,"_42174":123017,"_29767":201135,"_5":21387,"_28235":201097,"_5797":89835},[],{"_6892":123031,"_42174":123017,"_29767":201137,"_5":21387,"_28235":201097,"_5797":201138},[],"La petición o el estado actual del recurso no permite la operación. El mensaje indica qué cambiar.",{"_6892":123032,"_42174":123017,"_29767":201140,"_5":21387,"_28235":201097,"_5797":89841},[],{"_6892":123033,"_42174":123017,"_29767":201142,"_5":21387,"_28235":201097,"_5797":201143},[],"Una política rechaza la operación.",{"_6892":123034,"_42174":123017,"_29767":201145,"_5":21387,"_28235":201097,"_5797":89847},[],{"_6892":123035,"_42174":123017,"_29767":201147,"_5":21387,"_28235":201097,"_5797":201148},[],"El recurso no existe. El lanzamiento de otro grupo también responde `404`.",{"_6892":123036,"_42174":123017,"_29767":201150,"_5":21387,"_28235":201097,"_5797":89853},[],{"_6892":123037,"_42174":123017,"_29767":201152,"_5":21387,"_28235":201097,"_5797":201153},[],"Hay una operación en conflicto en curso, o la versión ya está construida.",{"_6892":123038,"_42174":123017,"_29767":201155,"_5":21387,"_28235":201097,"_5797":89859},[],{"_6892":123039,"_42174":123017,"_29767":201157,"_5":21387,"_28235":201097,"_5797":201158},[],"Un fichero supera `max_artifact_size_mb`.",{"_6892":123040,"_42174":123017,"_29767":201160,"_5":21387,"_28235":201097,"_5797":93163},[],{"_6892":123041,"_42174":123017,"_29767":201162,"_5":21387,"_28235":201097,"_5797":201163},[],"Un fallo inesperado. Algunos errores de validación siguen respondiendo `500` (consulta más abajo).",{"_6892":123042,"_42174":123017,"_29767":201165,"_5":21387,"_28235":201097,"_5797":89865},[],{"_6892":123043,"_42174":123017,"_29767":201167,"_5":21387,"_28235":201097,"_5797":201168},[],"El backend activo no soporta la operación. Lee las capacidades.",{"_6892":123044,"_42174":123017,"_29767":201170,"_5":21387,"_28235":201101,"_5797":189417},[],{"_6892":123045,"_42174":123017,"_29767":201172,"_5":21387,"_28235":201101,"_5797":194863},[],{"_6892":123046,"_42174":123017,"_29767":201174,"_5":21387,"_28235":201101,"_5797":201175},[],"Solución",{"_6892":123047,"_42174":123017,"_29767":201177,"_5":21387,"_28235":201101,"_5797":201178},[],"`docker compose up` falla con un error de red",{"_6892":123048,"_42174":123017,"_29767":201180,"_5":21387,"_28235":201101,"_5797":201181},[],"La red `ota-net` no existe",{"_6892":123049,"_42174":123017,"_29767":201183,"_5":21387,"_28235":201101,"_5797":93187},[],{"_6892":123050,"_42174":123017,"_29767":201185,"_5":21387,"_28235":201101,"_5797":201186},[],"La construcción de Docker no encuentra `lamassuiot/core`",{"_6892":123051,"_42174":123017,"_29767":201188,"_5":21387,"_28235":201101,"_5797":201189},[],"El contexto de construcción no es el padre del checkout",{"_6892":123052,"_42174":123017,"_29767":201191,"_5":21387,"_28235":201101,"_5797":201192},[],"Construye con el contexto que contiene `ota/`, `lamassuiot/core` y `lamassuiot/sdk`. `docker compose build updates` lo usa.",{"_6892":123053,"_42174":123017,"_29767":201194,"_5":21387,"_28235":201101,"_5797":201195},[],"El servicio ignora `OTA_CONFIG_FILE` y registra una advertencia",{"_6892":123054,"_42174":123017,"_29767":201197,"_5":21387,"_28235":201101,"_5797":201198},[],"No se pudo cargar el fichero, así que recurrió a `/etc/lamassuiot/config.yml`",{"_6892":123055,"_42174":123017,"_29767":201200,"_5":21387,"_28235":201101,"_5797":201201},[],"Revisa la ruta y el YAML. En la imagen, esa alternativa es la configuración de desarrollo del repositorio.",{"_6892":123056,"_42174":123017,"_29767":201203,"_5":21387,"_28235":201101,"_5797":93208},[],{"_6892":123057,"_42174":123017,"_29767":201205,"_5":21387,"_28235":201101,"_5797":201206},[],"`workflow_file` no nombra el workflow `direct`",{"_6892":123058,"_42174":123017,"_29767":201208,"_5":21387,"_28235":201101,"_5797":201209},[],"Apúntalo a `wfx.workflow.dau.direct.yml` o a una ruta que contenga `direct`.",{"_6892":123059,"_42174":123017,"_29767":201211,"_5":21387,"_28235":201101,"_5797":93217},[],{"_6892":123060,"_42174":123017,"_29767":201213,"_5":21387,"_28235":201101,"_5797":201214},[],"`wfx_endpoint` es incorrecto o WFX está caído",{"_6892":123061,"_42174":123017,"_29767":201216,"_5":21387,"_28235":201101,"_5797":201217},[],"Usa el puerto de **gestión** (`8081` dentro de la red de Compose, `9081` en el host) y comprueba que `custom-wfx` se ejecuta.",{"_6892":123062,"_42174":123017,"_29767":201219,"_5":21387,"_28235":201101,"_5797":201220},[],"Postgres informa de que la base de datos `updates` no existe",{"_6892":123063,"_42174":123017,"_29767":201222,"_5":21387,"_28235":201101,"_5797":201223},[],"El servicio no crea la base de datos",{"_6892":123064,"_42174":123017,"_29767":201225,"_5":21387,"_28235":201101,"_5797":201226},[],"Créala (Docker Compose lo hace con `init.sql`).",{"_6892":123065,"_42174":123017,"_29767":201228,"_5":21387,"_28235":201101,"_5797":93235},[],{"_6892":123066,"_42174":123017,"_29767":201230,"_5":21387,"_28235":201101,"_5797":201231},[],"Falta la clave",{"_6892":123067,"_42174":123017,"_29767":201233,"_5":21387,"_28235":201101,"_5797":201234},[],"Define `hawkbit.base_url`.",{"_6892":123068,"_42174":123017,"_29767":201236,"_5":21387,"_28235":201101,"_5797":93244},[],{"_6892":123069,"_42174":123017,"_29767":201238,"_5":21387,"_28235":201101,"_5797":201239},[],"`storage.hostname` está vacío",{"_6892":123070,"_42174":123017,"_29767":201241,"_5":21387,"_28235":201101,"_5797":201242},[],"Define el bloque `storage`.",{"_6892":123071,"_42174":123017,"_29767":201244,"_5":21387,"_28235":201101,"_5797":93253},[],{"_6892":123072,"_42174":123017,"_29767":201246,"_5":21387,"_28235":201101,"_5797":201247},[],"Bucket, endpoint o credenciales incorrectos, o el bucket no existe",{"_6892":123073,"_42174":123017,"_29767":201249,"_5":21387,"_28235":201101,"_5797":201250},[],"Corrige las claves `s3_*` del bloque que nombra el error. El bucket debe existir ya.",{"_6892":123074,"_42174":123017,"_29767":201252,"_5":21387,"_28235":201101,"_5797":93262},[],{"_6892":123075,"_42174":123017,"_29767":201254,"_5":21387,"_28235":201101,"_5797":201255},[],"`encryption.local_key` no son 32 bytes en hexadecimal",{"_6892":123076,"_42174":123017,"_29767":201257,"_5":21387,"_28235":201101,"_5797":201258},[],"Usa 64 caracteres hexadecimales (`openssl rand -hex 32`).",{"_6892":123077,"_42174":123017,"_29767":201260,"_5":21387,"_28235":201101,"_5797":93271},[],{"_6892":123078,"_42174":123017,"_29767":201262,"_5":21387,"_28235":201101,"_5797":201263},[],"El pod no puede usar Leases y `leaderElection.mode` es `kubernetes`",{"_6892":123079,"_42174":123017,"_29767":201265,"_5":21387,"_28235":201101,"_5797":201266},[],"Concede el Role que proporciona el chart (`serviceAccount.create: true`), o define `leaderElection.mode: database`.",{"_6892":123080,"_42174":123017,"_29767":201268,"_5":21387,"_28235":201101,"_5797":93280},[],{"_6892":123081,"_42174":123017,"_29767":201270,"_5":21387,"_28235":201101,"_5797":201271},[],"`leader_election.mode: kubernetes` fuera de un clúster",{"_6892":123082,"_42174":123017,"_29767":201273,"_5":21387,"_28235":201101,"_5797":201274},[],"Usa vacío (automático) o `database`.",{"_6892":123083,"_42174":123017,"_29767":201276,"_5":21387,"_28235":201101,"_5797":201277},[],"`builds.presign: ...` o `hawkbit.artifact_store.presign: ...`",{"_6892":123084,"_42174":123017,"_29767":201279,"_5":21387,"_28235":201101,"_5797":201280},[],"Los ajustes de descarga prefirmada de ese bloque no son válidos",{"_6892":123085,"_42174":123017,"_29767":201282,"_5":21387,"_28235":201101,"_5797":201283},[],"Consulta Descargas y URLs prefirmadas.",{"_6892":123086,"_42174":123017,"_29767":201285,"_5":21387,"_28235":201101,"_5797":201286},[],"El contenedor de hawkBit termina",{"_6892":123087,"_42174":123017,"_29767":201288,"_5":21387,"_28235":201101,"_5797":201289},[],"Se selecciona almacenamiento S3 para hawkBit y el bucket no es alcanzable",{"_6892":123088,"_42174":123017,"_29767":201291,"_5":21387,"_28235":201101,"_5797":201292},[],"Corrige los ajustes de S3, o usa `HAWKBIT_ARTIFACT_STORAGE=fs`. hawkBit nunca recurre en silencio al disco local.",{"_6892":123089,"_42174":123017,"_29767":201294,"_5":21387,"_28235":201101,"_5797":201295},[],"`/health` responde pero fallan las llamadas a WFX",{"_6892":123090,"_42174":123017,"_29767":201297,"_5":21387,"_28235":201101,"_5797":201298},[],"`/health` no comprueba las dependencias",{"_6892":123091,"_42174":123017,"_29767":201300,"_5":21387,"_28235":201101,"_5797":201301},[],"Revisa `wfx_endpoint` y que WFX se está ejecutando.",{"_6892":123092,"_42174":123017,"_29767":201303,"_5":21387,"_28235":201101,"_5797":201304},[],"La salida de depuración muestra secretos",{"_6892":123093,"_42174":123017,"_29767":201306,"_5":21387,"_28235":201101,"_5797":201307},[],"`app.logs.level: debug` imprime la configuración",{"_6892":123094,"_42174":123017,"_29767":201309,"_5":21387,"_28235":201101,"_5797":201310},[],"Usa `info`. Consulta Seguridad.",{"_6892":123095,"_42174":123017,"_29767":201312,"_5":21387,"_28235":201105,"_5797":189417},[],{"_6892":123096,"_42174":123017,"_29767":201314,"_5":21387,"_28235":201105,"_5797":194863},[],{"_6892":123097,"_42174":123017,"_29767":201316,"_5":21387,"_28235":201105,"_5797":201175},[],{"_6892":123098,"_42174":123017,"_29767":201318,"_5":21387,"_28235":201105,"_5797":93331},[],{"_6892":123099,"_42174":123017,"_29767":201320,"_5":21387,"_28235":201105,"_5797":201321},[],"El backend activo no soporta la operación",{"_6892":123100,"_42174":123017,"_29767":201323,"_5":21387,"_28235":201105,"_5797":201324},[],"Lee `GET /updates/v1/capabilities`. En modo `hawkbit`, `POST .../swu` y `.../package` responden siempre `501`: construye los módulos en el catálogo.",{"_6892":123101,"_42174":123017,"_29767":201326,"_5":21387,"_28235":201105,"_5797":93340},[],{"_6892":123102,"_42174":123017,"_29767":201328,"_5":21387,"_28235":201105,"_5797":201329},[],"Has cambiado una versión construida",{"_6892":123103,"_42174":123017,"_29767":201331,"_5":21387,"_28235":201105,"_5797":201332},[],"Modo native: `POST .../new` con `{\"version\":\"x.y.z\"}` mayor que la actual, vuelve a subir la sw-description (no se arrastra) y da una `version` mayor a cualquier artefacto que vuelvas a subir. Modo `hawkbit`: consulta la fila siguiente.",{"_6892":123104,"_42174":123017,"_29767":201334,"_5":21387,"_28235":201105,"_5797":93349},[],{"_6892":123105,"_42174":123017,"_29767":201336,"_5":21387,"_28235":201105,"_5797":201337},[],"En modo `hawkbit` se rechazan las ediciones con ámbito de paquete",{"_6892":123106,"_42174":123017,"_29767":201339,"_5":21387,"_28235":201105,"_5797":201340},[],"Desenlaza el módulo, cámbialo y constrúyelo en el catálogo, y enlázalo de nuevo. O publica una versión nueva del módulo y crea un paquete a partir de ella con otro nombre: los nombres de paquete son únicos por grupo, y un módulo `os` no se puede intercambiar en un paquete existente. Consulta Modo hawkBit.",{"_6892":123107,"_42174":123017,"_29767":201342,"_5":21387,"_28235":201105,"_5797":93358},[],{"_6892":123108,"_42174":123017,"_29767":201344,"_5":21387,"_28235":201105,"_5797":201345},[],"Dos construcciones, o una construcción y un cambio, sobre el mismo paquete o módulo",{"_6892":123109,"_42174":123017,"_29767":201347,"_5":21387,"_28235":201105,"_5797":201348},[],"Espera y reintenta. El bloqueo se libera cuando la operación termina o falla.",{"_6892":123110,"_42174":123017,"_29767":201350,"_5":21387,"_28235":201105,"_5797":201351},[],"`409` al crear",{"_6892":123111,"_42174":123017,"_29767":201353,"_5":21387,"_28235":201105,"_5797":201354},[],"Ya existe un paquete con ese nombre en el grupo",{"_6892":123112,"_42174":123017,"_29767":201356,"_5":21387,"_28235":201105,"_5797":201357},[],"Elige otro nombre.",{"_6892":123113,"_42174":123017,"_29767":201359,"_5":21387,"_28235":201105,"_5797":93376},[],{"_6892":123114,"_42174":123017,"_29767":201361,"_5":21387,"_28235":201105,"_5797":196660},[],{"_6892":123115,"_42174":123017,"_29767":201363,"_5":21387,"_28235":201105,"_5797":201364},[],"Auméntalo y aumenta también los límites de todos los proxies que haya delante. Consulta Operaciones. Un proxy que responde `413` con su propio cuerpo (por ejemplo el 1 MiB por defecto de nginx) es el proxy, no el servicio.",{"_6892":123116,"_42174":123017,"_29767":201366,"_5":21387,"_28235":201105,"_5797":201367},[],"Subida `400` que menciona un contenido que contradice el nombre del fichero",{"_6892":123117,"_42174":123017,"_29767":201369,"_5":21387,"_28235":201105,"_5797":201370},[],"Un fichero llamado `.swu` no es un SWU",{"_6892":123118,"_42174":123017,"_29767":201372,"_5":21387,"_28235":201105,"_5797":201373},[],"Sube un `.swu` real, o renombra el fichero.",{"_6892":123119,"_42174":123017,"_29767":201375,"_5":21387,"_28235":201105,"_5797":201376},[],"La subida de un artefacto falla con `500` y `version X must be greater than the current latest version`",{"_6892":123120,"_42174":123017,"_29767":201378,"_5":21387,"_28235":201105,"_5797":201379},[],"Los nombres de artefacto son globales, y un nombre solo se puede reutilizar con una `version` mayor",{"_6892":123121,"_42174":123017,"_29767":201381,"_5":21387,"_28235":201105,"_5797":201382},[],"Da al fichero nuevo una `version` mayor, o un nombre de artefacto nuevo.",{"_6892":123122,"_42174":123017,"_29767":201384,"_5":21387,"_28235":201105,"_5797":93403},[],{"_6892":123123,"_42174":123017,"_29767":201386,"_5":21387,"_28235":201105,"_5797":201387},[],"El paquete sigue siendo un borrador",{"_6892":123124,"_42174":123017,"_29767":201389,"_5":21387,"_28235":201105,"_5797":201390},[],"Constrúyelo primero.",{"_6892":123125,"_42174":123017,"_29767":201392,"_5":21387,"_28235":201105,"_5797":93412},[],{"_6892":123126,"_42174":123017,"_29767":201394,"_5":21387,"_28235":201105,"_5797":201395},[],"Algunos dispositivos no tienen clave",{"_6892":123127,"_42174":123017,"_29767":201397,"_5":21387,"_28235":201105,"_5797":201398},[],"Asigna las claves que faltan y construye de nuevo. No hay forma de forzarlo.",{"_6892":123128,"_42174":123017,"_29767":201400,"_5":21387,"_28235":201105,"_5797":93421},[],{"_6892":123129,"_42174":123017,"_29767":201402,"_5":21387,"_28235":201105,"_5797":201403},[],"Los umbrales son porcentajes",{"_6892":123130,"_42174":123017,"_29767":201405,"_5":21387,"_28235":201105,"_5797":201406},[],"Usa `0`-`100`.",{"_6892":123131,"_42174":123017,"_29767":201408,"_5":21387,"_28235":201105,"_5797":93430},[],{"_6892":123132,"_42174":123017,"_29767":201410,"_5":21387,"_28235":201105,"_5797":201411},[],"El lanzamiento estaba en pausa",{"_6892":123133,"_42174":123017,"_29767":201413,"_5":21387,"_28235":201105,"_5797":201414},[],"Llama a `resume`.",{"_6892":123134,"_42174":123017,"_29767":201416,"_5":21387,"_28235":201105,"_5797":201417},[],"`test device X cannot act as this group's canary: device X does not exist` (modo `hawkbit`)",{"_6892":123135,"_42174":123017,"_29767":201419,"_5":21387,"_28235":201105,"_5797":201420},[],"La comprobación del canario se ejecuta antes de que los dispositivos del grupo existan en hawkBit",{"_6892":123136,"_42174":123017,"_29767":201422,"_5":21387,"_28235":201105,"_5797":201423},[],"Ejecuta antes una simulación sin `test_device_id` (`POST .../launch?dry_run=true`), que registra los dispositivos como targets.",{"_6892":123137,"_42174":123017,"_29767":201425,"_5":21387,"_28235":201105,"_5797":201426},[],"El registro de dispositivos o el KMS responde `401`",{"_6892":123138,"_42174":123017,"_29767":201428,"_5":21387,"_28235":201105,"_5797":201429},[],"El servicio envía siempre `X-Principal-ID: admin-mode`, y el gateway intermedio lo rechaza",{"_6892":123139,"_42174":123017,"_29767":201431,"_5":21387,"_28235":201105,"_5797":201432},[],"Apunta `dms_endpoint` y `kms_endpoint` a las direcciones internas de los servicios, o permite esa cabecera.",{"_6892":123140,"_42174":123017,"_29767":201434,"_5":21387,"_28235":201109,"_5797":189417},[],{"_6892":123141,"_42174":123017,"_29767":201436,"_5":21387,"_28235":201109,"_5797":194863},[],{"_6892":123142,"_42174":123017,"_29767":201438,"_5":21387,"_28235":201109,"_5797":201175},[],{"_6892":123143,"_42174":123017,"_29767":201440,"_5":21387,"_28235":201109,"_5797":93463},[],{"_6892":123144,"_42174":123017,"_29767":201442,"_5":21387,"_28235":201109,"_5797":201443},[],"La versión no tiene sw-description (cada versión necesita la suya)",{"_6892":123145,"_42174":123017,"_29767":201445,"_5":21387,"_28235":201109,"_5797":201446},[],"Súbela.",{"_6892":123146,"_42174":123017,"_29767":201448,"_5":21387,"_28235":201109,"_5797":201449},[],"`failed to read binaries directory` o `binaries directory is empty`",{"_6892":123147,"_42174":123017,"_29767":201451,"_5":21387,"_28235":201109,"_5797":201452},[],"Modo `native`: no se preparó nada, porque el cuerpo de la construcción no tiene `selected_artifact_ids`",{"_6892":123148,"_42174":123017,"_29767":201454,"_5":21387,"_28235":201109,"_5797":201455},[],"Pasa los IDs de los artefactos. Consulta la guía de publicación.",{"_6892":123149,"_42174":123017,"_29767":201457,"_5":21387,"_28235":201109,"_5797":93481},[],{"_6892":123150,"_42174":123017,"_29767":201459,"_5":21387,"_28235":201109,"_5797":201460},[],"La herramienta rechazó su entrada. Su propio mensaje está en el registro del servicio",{"_6892":123151,"_42174":123017,"_29767":201462,"_5":21387,"_28235":201109,"_5797":201463},[],"Revisa la sw-description, los nombres de fichero que referencia, la grafía del algoritmo (`aes-256-gcm`, guiones obligatorios) y la longitud de la clave.",{"_6892":123152,"_42174":123017,"_29767":201465,"_5":21387,"_28235":201109,"_5797":93490},[],{"_6892":123153,"_42174":123017,"_29767":201467,"_5":21387,"_28235":201109,"_5797":201468},[],"Se pidió firmar un `.swu` sin ambos ajustes",{"_6892":123154,"_42174":123017,"_29767":201470,"_5":21387,"_28235":201109,"_5797":201471},[],"Define `sign_script_path` y `kms_endpoint`.",{"_6892":123155,"_42174":123017,"_29767":201473,"_5":21387,"_28235":201109,"_5797":93499},[],{"_6892":123156,"_42174":123017,"_29767":201475,"_5":21387,"_28235":201109,"_5797":201476},[],"Una petición de firma parcial",{"_6892":123157,"_42174":123017,"_29767":201478,"_5":21387,"_28235":201109,"_5797":201479},[],"Envía los tres campos `signature_*`.",{"_6892":123158,"_42174":123017,"_29767":201481,"_5":21387,"_28235":201109,"_5797":93508},[],{"_6892":123159,"_42174":123017,"_29767":201483,"_5":21387,"_28235":201109,"_5797":201484},[],"El KMS respondió con una firma simple",{"_6892":123160,"_42174":123017,"_29767":201486,"_5":21387,"_28235":201109,"_5797":201487},[],"Usa una versión del KMS que devuelva CMS. Consulta Firma y cifrado.",{"_6892":123161,"_42174":123017,"_29767":201489,"_5":21387,"_28235":201109,"_5797":93517},[],{"_6892":123162,"_42174":123017,"_29767":201491,"_5":21387,"_28235":201109,"_5797":201492},[],"`symkms_endpoint` está vacío",{"_6892":123163,"_42174":123017,"_29767":201494,"_5":21387,"_28235":201109,"_5797":201495},[],"Defínelo. En modo `hawkbit` define también el bloque `symkms` para que existan las rutas.",{"_6892":123164,"_42174":123017,"_29767":201497,"_5":21387,"_28235":201109,"_5797":93526},[],{"_6892":123165,"_42174":123017,"_29767":201499,"_5":21387,"_28235":201109,"_5797":201500},[],"ID de clave o `user` incorrectos, o el endpoint apunta a otra instancia",{"_6892":123166,"_42174":123017,"_29767":201502,"_5":21387,"_28235":201109,"_5797":201503},[],"La clave pertenece a su `user_id`; `symkms_endpoint` debe ser la dirección y el puerto propios de esta instancia.",{"_6892":123167,"_42174":123017,"_29767":201505,"_5":21387,"_28235":201109,"_5797":201506},[],"Una construcción por dispositivo falla mencionando `encrypted = true`",{"_6892":123168,"_42174":123017,"_29767":201508,"_5":21387,"_28235":201109,"_5797":201509},[],"Ningún artefacto de la sw-description está marcado con `encrypted = true;`",{"_6892":123169,"_42174":123017,"_29767":201511,"_5":21387,"_28235":201109,"_5797":201512},[],"Marca los artefactos a cifrar.",{"_6892":123170,"_42174":123017,"_29767":201514,"_5":21387,"_28235":201109,"_5797":201515},[],"`no devices found for DMS X` o `none of the N devices ... have a key assigned for firmware-encryption`",{"_6892":123171,"_42174":123017,"_29767":201517,"_5":21387,"_28235":201109,"_5797":201518},[],"El grupo no tiene dispositivos en el registro, o ninguno tiene clave",{"_6892":123172,"_42174":123017,"_29767":201520,"_5":21387,"_28235":201109,"_5797":201521},[],"Revisa el grupo en Lamassu IoT y `dms_endpoint`; asigna claves `firmware-encryption`.",{"_6892":123173,"_42174":123017,"_29767":201523,"_5":21387,"_28235":201109,"_5797":93553},[],{"_6892":123174,"_42174":123017,"_29767":201525,"_5":21387,"_28235":201109,"_5797":201526},[],"`swugenerator_path` está vacío",{"_6892":123175,"_42174":123017,"_29767":201528,"_5":21387,"_28235":201109,"_5797":201529},[],"Defínelo, o sube un módulo `.swu` precompilado.",{"_6892":123176,"_42174":123017,"_29767":201531,"_5":21387,"_28235":201109,"_5797":201532},[],"`hawkbit mode: this deployment has no SymKMS configured` o `... no KMS endpoint configured` (`501`)",{"_6892":123177,"_42174":123017,"_29767":201534,"_5":21387,"_28235":201109,"_5797":201535},[],"Se pidió cifrar o firmar sin `symkms_endpoint` o `kms_endpoint`",{"_6892":123178,"_42174":123017,"_29767":201537,"_5":21387,"_28235":201109,"_5797":201538},[],"Defínelos.",{"_6892":123179,"_42174":123017,"_29767":201540,"_5":21387,"_28235":201109,"_5797":93571},[],{"_6892":123180,"_42174":123017,"_29767":201542,"_5":21387,"_28235":201109,"_5797":201543},[],"`build_memory_limit_mb` rechaza la construcción",{"_6892":123181,"_42174":123017,"_29767":201545,"_5":21387,"_28235":201109,"_5797":201546},[],"Firma sin cifrar, divide el fichero, o sube el límite junto con la memoria del pod.",{"_6892":123182,"_42174":123017,"_29767":201548,"_5":21387,"_28235":201109,"_5797":93580},[],{"_6892":123183,"_42174":123017,"_29767":201550,"_5":21387,"_28235":201109,"_5797":201551},[],"Una construcción sustituye los ficheros de entrada del módulo",{"_6892":123184,"_42174":123017,"_29767":201553,"_5":21387,"_28235":201109,"_5797":201554},[],"Crea una versión nueva del módulo.",{"_6892":123185,"_42174":123017,"_29767":201556,"_5":21387,"_28235":201113,"_5797":189417},[],{"_6892":123186,"_42174":123017,"_29767":201558,"_5":21387,"_28235":201113,"_5797":194863},[],{"_6892":123187,"_42174":123017,"_29767":201560,"_5":21387,"_28235":201113,"_5797":201175},[],{"_6892":123188,"_42174":123017,"_29767":201562,"_5":21387,"_28235":201113,"_5797":93595},[],{"_6892":123189,"_42174":123017,"_29767":201564,"_5":21387,"_28235":201113,"_5797":201565},[],"El paquete está cifrado por dispositivo y no tiene paquete para ese dispositivo (faltaba su clave al construir, o el paquete heredó el modo por dispositivo de una versión anterior), o el fichero de la construcción ya no está en el almacén",{"_6892":123190,"_42174":123017,"_29767":201567,"_5":21387,"_28235":201113,"_5797":201568},[],"Asigna la clave del dispositivo y construye una versión nueva. Para evitar heredar, usa un paquete distinto para cada variante de cifrado (consulta Limitaciones).",{"_6892":123191,"_42174":123017,"_29767":201570,"_5":21387,"_28235":201113,"_5797":201571},[],"Arranque: `presign needs its own credential`",{"_6892":123192,"_42174":123017,"_29767":201573,"_5":21387,"_28235":201113,"_5797":201574},[],"`presign` está activado sin credencial de firma",{"_6892":123193,"_42174":123017,"_29767":201576,"_5":21387,"_28235":201113,"_5797":201577},[],"Define `presign.access_key_id[_file]` y `secret_access_key[_file]`, un par de solo lectura.",{"_6892":123194,"_42174":123017,"_29767":201579,"_5":21387,"_28235":201113,"_5797":201580},[],"Arranque: `the presign credential can WRITE`",{"_6892":123195,"_42174":123017,"_29767":201582,"_5":21387,"_28235":201113,"_5797":201583},[],"La credencial de firma tiene acceso de escritura",{"_6892":123196,"_42174":123017,"_29767":201585,"_5":21387,"_28235":201113,"_5797":201586},[],"Dale una política de solo lectura sobre los objetos que sirve.",{"_6892":123197,"_42174":123017,"_29767":201588,"_5":21387,"_28235":201113,"_5797":201589},[],"Arranque: `presign signs with the storage's own credential`",{"_6892":123198,"_42174":123017,"_29767":201591,"_5":21387,"_28235":201113,"_5797":201592},[],"Misma clave que el almacenamiento",{"_6892":123199,"_42174":123017,"_29767":201594,"_5":21387,"_28235":201113,"_5797":201595},[],"Crea una clave de solo lectura aparte.",{"_6892":123200,"_42174":123017,"_29767":201597,"_5":21387,"_28235":201113,"_5797":201598},[],"Arranque: `the store does not accept the presign credential`",{"_6892":123201,"_42174":123017,"_29767":201600,"_5":21387,"_28235":201113,"_5797":201601},[],"El almacén no conoce la clave, o la firma no coincide",{"_6892":123202,"_42174":123017,"_29767":201603,"_5":21387,"_28235":201113,"_5797":201604},[],"Crea el usuario en el almacén; revisa región y endpoint.",{"_6892":123203,"_42174":123017,"_29767":201606,"_5":21387,"_28235":201113,"_5797":201607},[],"Arranque: `presign cannot be combined with client-side encryption`",{"_6892":123204,"_42174":123017,"_29767":201609,"_5":21387,"_28235":201113,"_5797":201610},[],"`encryption.type` no es `none` en ese bloque",{"_6892":123205,"_42174":123017,"_29767":201612,"_5":21387,"_28235":201113,"_5797":201613},[],"Usa cifrado en el almacén, o desactiva `presign`.",{"_6892":123206,"_42174":123017,"_29767":201615,"_5":21387,"_28235":201113,"_5797":201616},[],"Arranque: `presign.public_endpoint must be an http(s) origin`",{"_6892":123207,"_42174":123017,"_29767":201618,"_5":21387,"_28235":201113,"_5797":201619},[],"El valor no tiene esquema, o tiene una ruta",{"_6892":123208,"_42174":123017,"_29767":201621,"_5":21387,"_28235":201113,"_5797":201622},[],"Usa un origen como `https://updates.example.com`.",{"_6892":123209,"_42174":123017,"_29767":201624,"_5":21387,"_28235":201113,"_5797":201625},[],"El dispositivo recibe `403` del almacén tras el `302`",{"_6892":123210,"_42174":123017,"_29767":201627,"_5":21387,"_28235":201113,"_5797":201628},[],"La URL caducó antes de que el dispositivo iniciara el GET, el `Host` firmado no es el que usó el dispositivo (`public_endpoint` incorrecto), la clave de firma no puede leer ese prefijo, o los relojes difieren",{"_6892":123211,"_42174":123017,"_29767":201630,"_5":21387,"_28235":201113,"_5797":201631},[],"Reintenta (se emite una URL nueva por petición); revisa `ttl`, `public_endpoint` y la política de la clave.",{"_6892":123212,"_42174":123017,"_29767":201633,"_5":21387,"_28235":201113,"_5797":201634},[],"Las descargas pasan por el servicio pese a `presign`",{"_6892":123213,"_42174":123017,"_29767":201636,"_5":21387,"_28235":201113,"_5797":201637},[],"Una petición `HEAD`, una descarga de artefacto por ID en modo `native`, un almacén sin `presign` en ese bloque, o falló la firma (queda registrado)",{"_6892":123214,"_42174":123017,"_29767":201639,"_5":21387,"_28235":201113,"_5797":201640},[],"Solo se redirigen las compilaciones en modo `native` y los objetos del plugin S3 en modo `hawkbit`.",{"_6892":123215,"_42174":123017,"_29767":201642,"_5":21387,"_28235":201117,"_5797":192457},[],{"_6892":123216,"_42174":123017,"_29767":201644,"_5":21387,"_28235":201117,"_5797":194863},[],{"_6892":123217,"_42174":123017,"_29767":201646,"_5":21387,"_28235":201117,"_5797":201175},[],{"_6892":123218,"_42174":123017,"_29767":201648,"_5":21387,"_28235":201117,"_5797":201649},[],"Los dispositivos no pueden descargar el `.swu` (modo `native`)",{"_6892":123219,"_42174":123017,"_29767":201651,"_5":21387,"_28235":201117,"_5797":201652},[],"`update_domain` no es alcanzable desde el dispositivo, o no es la base completa `.../updates/v1/` con barra final",{"_6892":123220,"_42174":123017,"_29767":201654,"_5":21387,"_28235":201117,"_5797":201655},[],"Usa una dirección que el dispositivo pueda resolver. El valor por defecto del chart de Helm carece de `/updates`.",{"_6892":123221,"_42174":123017,"_29767":201657,"_5":21387,"_28235":201117,"_5797":201658},[],"Modo `hawkbit`: un dispositivo recibe `401` del DDI",{"_6892":123222,"_42174":123017,"_29767":201660,"_5":21387,"_28235":201117,"_5797":201661},[],"hawkBit rechaza a los dispositivos que no se autentican",{"_6892":123223,"_42174":123017,"_29767":201663,"_5":21387,"_28235":201117,"_5797":201664},[],"Habilita y usa un autenticador de dispositivos de hawkBit. Consulta Modo hawkBit.",{"_6892":123224,"_42174":123017,"_29767":201666,"_5":21387,"_28235":201117,"_5797":201667},[],"Modo `hawkbit`: un dispositivo recibe `429`",{"_6892":123225,"_42174":123017,"_29767":201669,"_5":21387,"_28235":201117,"_5797":201670},[],"El filtro DoS propio de hawkBit, que limita la frecuencia con que un dispositivo puede llamarlo",{"_6892":123226,"_42174":123017,"_29767":201672,"_5":21387,"_28235":201117,"_5797":201673},[],"Reduce la frecuencia de consulta y de informes de estado del dispositivo.",{"_6892":123227,"_42174":123017,"_29767":201675,"_5":21387,"_28235":201117,"_5797":201676},[],"Modo `hawkbit`: el lanzamiento permanece `running` sin avanzar",{"_6892":123228,"_42174":123017,"_29767":201678,"_5":21387,"_28235":201117,"_5797":201679},[],"Los dispositivos nunca contactaron con hawkBit, o consultan otro hawkBit",{"_6892":123229,"_42174":123017,"_29767":201681,"_5":21387,"_28235":201117,"_5797":201682},[],"Comprueba qué hawkBit consultan los dispositivos y que los targets existen. Un grupo de rollout no puede avanzar hasta que sus dispositivos consultan.",{"_6892":123230,"_42174":123017,"_29767":201684,"_5":21387,"_28235":201117,"_5797":201685},[],"Modo `hawkbit`: no se encuentran dispositivos en el grupo",{"_6892":123231,"_42174":123017,"_29767":201687,"_5":21387,"_28235":201117,"_5797":201688},[],"`dms_endpoint` no está definido, así que los grupos son las etiquetas de target `group:<id>`",{"_6892":123232,"_42174":123017,"_29767":201690,"_5":21387,"_28235":201117,"_5797":201691},[],"Define `dms_endpoint`, o etiqueta los targets.",{"_6892":123233,"_42174":123017,"_29767":201693,"_5":21387,"_28235":201117,"_5797":201694},[],"Un lanzamiento `phased` se queda en `CREATED` (modo `native`)",{"_6892":123234,"_42174":123017,"_29767":201696,"_5":21387,"_28235":201117,"_5797":201697},[],"En el workflow `phased` algunos pasos los hace WFX o un operador",{"_6892":123235,"_42174":123017,"_29767":201699,"_5":21387,"_28235":201117,"_5797":201700},[],"Confírmalos mediante WFX, o usa `direct`.",{"_6892":123236,"_42174":123017,"_29767":201702,"_5":21387,"_28235":201117,"_5797":201703},[],"Un lanzamiento `non-swu` muestra estados de SWU (modo `native`)",{"_6892":123237,"_42174":123017,"_29767":201705,"_5":21387,"_28235":201117,"_5797":201706},[],"Se creó con `workflow_type: direct`",{"_6892":123238,"_42174":123017,"_29767":201708,"_5":21387,"_28235":201117,"_5797":201709},[],"Usa `download-install`.",{"_6892":123239,"_42174":123017,"_29767":201711,"_5":21387,"_28235":201117,"_5797":201712},[],"El dispositivo instala y muestra la versión antigua",{"_6892":123240,"_42174":123017,"_29767":201714,"_5":21387,"_28235":201117,"_5797":201715},[],"No se cambió la versión de la carga",{"_6892":123241,"_42174":123017,"_29767":201717,"_5":21387,"_28235":201117,"_5797":201718},[],"Sube la versión antes de construir.",{"_6892":123242,"_42174":123017,"_29767":201720,"_5":21387,"_28235":201117,"_5797":201721},[],"El dispositivo ignora los despliegues nuevos",{"_6892":123243,"_42174":123017,"_29767":201723,"_5":21387,"_28235":201117,"_5797":201724},[],"SWUpdate conserva como pendiente de prueba (`ustate=1`) el estado de actualización de una instalación anterior y rechaza una nueva",{"_6892":123244,"_42174":123017,"_29767":201726,"_5":21387,"_28235":201117,"_5797":201727},[],"Confirma o restablece el estado de actualización del dispositivo. Es un ajuste del dispositivo, no del servicio.",{"_6892":123245,"_42174":123017,"_29767":201729,"_5":21387,"_28235":201117,"_5797":201730},[],"El dispositivo rechaza el `.swu` y el error menciona descifrado o imagen no válida",{"_6892":123246,"_42174":123017,"_29767":201732,"_5":21387,"_28235":201117,"_5797":201733},[],"El `.swu` no está firmado y el dispositivo exige firma, o la firma no es CMS",{"_6892":123247,"_42174":123017,"_29767":201735,"_5":21387,"_28235":201117,"_5797":201736},[],"Fírmalo con un KMS que devuelva CMS. Un fallo de firma puede notificarse como error de cifrado.",{"_6892":123248,"_42174":123017,"_29767":201738,"_5":21387,"_28235":201117,"_5797":201739},[],"El dispositivo no logra descifrar",{"_6892":123249,"_42174":123017,"_29767":201741,"_5":21387,"_28235":201117,"_5797":201742},[],"La clave usada al construir difiere de la del dispositivo, o difiere la grafía del algoritmo",{"_6892":123250,"_42174":123017,"_29767":201744,"_5":21387,"_28235":201117,"_5797":201745},[],"Usa la misma clave y el mismo algoritmo. Revisa la asignación en SymKMS.",{"_6892":123251,"_42174":123017,"_29767":201747,"_5":21387,"_28235":201121,"_5797":192457},[],{"_6892":123252,"_42174":123017,"_29767":201749,"_5":21387,"_28235":201121,"_5797":194863},[],{"_6892":123253,"_42174":123017,"_29767":201751,"_5":21387,"_28235":201121,"_5797":201175},[],{"_6892":123254,"_42174":123017,"_29767":201753,"_5":21387,"_28235":201121,"_5797":201754},[],"Los pods no pueden arrancar en nodos distintos",{"_6892":123255,"_42174":123017,"_29767":201756,"_5":21387,"_28235":201121,"_5797":201757},[],"El volumen `ReadWriteOnce` (ambos modos mientras `persistence.enabled` es true)",{"_6892":123256,"_42174":123017,"_29767":201759,"_5":21387,"_28235":201121,"_5797":201760},[],"Define `persistence.enabled: false` y pasa `artifacts`, `builds` y `symkms` a S3. Consulta Operaciones.",{"_6892":123257,"_42174":123017,"_29767":201762,"_5":21387,"_28235":201121,"_5797":201763},[],"Los lotes de campaña nunca avanzan (modo `native`)",{"_6892":123258,"_42174":123017,"_29767":201765,"_5":21387,"_28235":201121,"_5797":201766},[],"Falla la elección de líder, o no llegan los eventos de WFX",{"_6892":123259,"_42174":123017,"_29767":201768,"_5":21387,"_28235":201121,"_5797":201769},[],"Revisa los Leases y el RBAC, o define `leaderElection.mode: database`. La línea de registro `leadership acquired` aparece en el líder.",{"_6892":123260,"_42174":123017,"_29767":201771,"_5":21387,"_28235":201121,"_5797":201772},[],"Los lanzamientos programados nunca empiezan (modo `native`)",{"_6892":123261,"_42174":123017,"_29767":201774,"_5":21387,"_28235":201121,"_5797":201775},[],"El mismo trabajo en segundo plano, que se ejecuta en el líder",{"_6892":123262,"_42174":123017,"_29767":201777,"_5":21387,"_28235":201121,"_5797":201778},[],"Igual que arriba.",{"_6892":123263,"_42174":123017,"_29767":201780,"_5":21387,"_28235":201121,"_5797":201781},[],"Las construcciones por dispositivo son lentas",{"_6892":123264,"_42174":123017,"_29767":201783,"_5":21387,"_28235":201121,"_5797":201784},[],"El límite de CPU",{"_6892":123265,"_42174":123017,"_29767":201786,"_5":21387,"_28235":201121,"_5797":201787},[],"Súbelo. Consulta Dimensionado de recursos.",{"_6892":123266,"_42174":123017,"_29767":201789,"_5":21387,"_28235":201121,"_5797":201790},[],"El pod muere durante una subida o una construcción cifrada",{"_6892":123267,"_42174":123017,"_29767":201792,"_5":21387,"_28235":201121,"_5797":201793},[],"Límite de memoria, o el disco temporal está lleno",{"_6892":123268,"_42174":123017,"_29767":201795,"_5":21387,"_28235":201121,"_5797":201796},[],"Dimensiona la memoria para el mayor fichero que cifres y da margen a `TMPDIR`.",{"_6892":123269,"_42174":123017,"_29767":201798,"_5":21387,"_28235":201125,"_5797":201799},[],"Sube `app.logs.level` a `debug`, pero recuerda que imprime secretos.",{"_6892":123270,"_42174":123017,"_29767":201801,"_5":21387,"_28235":201125,"_5797":201802},[],"`GET /updates/v1/capabilities` muestra el backend activo y lo que soporta.",{"_6892":123271,"_42174":123017,"_29767":201804,"_5":21387,"_28235":201125,"_5797":201805},[],"Cada réplica registra cuál lidera (`leadership acquired`, `is the leader, standing by`).",{"_6892":123272,"_42174":123017,"_29767":201807,"_5":21387,"_28235":201125,"_5797":201808},[],"En modo `hawkbit`, inspecciona lo que creó el servicio mediante la API de gestión de hawkBit (puerto `8090` en Compose, con las credenciales Basic Auth de la configuración). Cada instancia de hawkBit tiene sus propios datos: consulta la que indica `hawkbit.base_url`.",{"_6892":123273,"_42174":123273,"_5":21817,"_5797":201810,"_42654":201811,"_29767":201812,"_28235":123273},"3.8.0 a 4.0.0",[77248,193621],[],{"_6892":123274,"_42174":123273,"_29767":201814,"_5":21387,"_28235":123273,"_5797":201815},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_6892":123275,"_42174":123273,"_5":42651,"_29767":201817,"_28235":201818,"_5797":201819},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_6892":123276,"_42174":123273,"_5":42651,"_29767":201821,"_28235":201822,"_5797":201823},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_6892":123277,"_42174":123273,"_5":42651,"_29767":201825,"_28235":201826,"_5797":201827},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_6892":123278,"_42174":123273,"_5":42651,"_29767":201829,"_28235":201830,"_5797":201831},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_6892":123279,"_42174":123273,"_5":42651,"_29767":201833,"_28235":201834,"_5797":201835},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_6892":123280,"_42174":123273,"_5":42651,"_29767":201837,"_28235":201838,"_5797":201839},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_6892":123281,"_42174":123273,"_5":42651,"_29767":201841,"_28235":201842,"_5797":93876},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_6892":123282,"_42174":123273,"_5":42651,"_29767":201844,"_28235":201845,"_5797":201846},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_6892":123283,"_42174":123273,"_5":42651,"_29767":201848,"_28235":201849,"_5797":201850},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_6892":123284,"_42174":123273,"_5":42651,"_29767":201852,"_28235":201853,"_5797":201854},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_6892":123285,"_42174":123273,"_5":42651,"_29767":201856,"_28235":201857,"_5797":201858},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_6892":123286,"_42174":123273,"_5":42651,"_29767":201860,"_28235":201861,"_5797":201862},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_6892":123287,"_42174":123273,"_5":42651,"_29767":201864,"_28235":201865,"_5797":201866},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_6892":123288,"_42174":123273,"_5":42651,"_29767":201868,"_28235":201869,"_5797":201870},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_6892":123289,"_42174":123273,"_5":42651,"_29767":201872,"_28235":201873,"_5797":201874},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_6892":123290,"_42174":123273,"_5":42651,"_29767":201876,"_28235":201877,"_5797":201878},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_6892":123291,"_42174":123273,"_5":42651,"_29767":201880,"_28235":201881,"_5797":201882},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_6892":123292,"_42174":123273,"_5":42651,"_29767":201884,"_28235":201885,"_5797":201886},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_6892":123293,"_42174":123273,"_5":42651,"_29767":201888,"_28235":201889,"_5797":201890},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_6892":123294,"_42174":123273,"_5":42651,"_29767":201892,"_28235":201893,"_5797":201894},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_6892":123295,"_42174":123273,"_5":42651,"_29767":201896,"_28235":201897,"_5797":201898},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_6892":123296,"_42174":123273,"_5":42651,"_29767":201900,"_28235":201901,"_5797":201902},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_6892":123297,"_42174":123273,"_5":42651,"_29767":201904,"_28235":201905,"_5797":201906},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_6892":123298,"_42174":123273,"_5":42651,"_29767":201908,"_28235":201909,"_5797":201910},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_6892":123299,"_42174":123273,"_5":42651,"_29767":201912,"_28235":201913,"_5797":201914},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_6892":123300,"_42174":123273,"_5":42651,"_29767":201916,"_28235":201917,"_5797":201918},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_6892":123301,"_42174":123273,"_5":42651,"_29767":201920,"_28235":201921,"_5797":201922},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_6892":123302,"_42174":123273,"_5":42651,"_29767":201924,"_28235":201925,"_5797":201926},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_6892":123303,"_42174":123273,"_5":42651,"_29767":201928,"_28235":201929,"_5797":201930},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_6892":123304,"_42174":123273,"_5":42651,"_29767":201932,"_28235":201933,"_5797":201934},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_6892":123305,"_42174":123273,"_5":42651,"_29767":201936,"_28235":201937,"_5797":201938},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_6892":123306,"_42174":123273,"_5":42651,"_29767":201940,"_28235":201941,"_5797":201942},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_6892":123307,"_42174":123273,"_5":42651,"_29767":201944,"_28235":201945,"_5797":201946},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_6892":123308,"_42174":123273,"_5":42651,"_29767":201948,"_28235":201949,"_5797":189766},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_6892":123309,"_42174":123273,"_5":42651,"_29767":201951,"_28235":201952,"_5797":201953},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_6892":123310,"_42174":123273,"_5":42651,"_29767":201955,"_28235":201956,"_5797":201957},[],"/docs/pr-preview/pr-56/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_6892":123311,"_42174":123273,"_29767":201959,"_5":21387,"_28235":123273,"_5797":201960},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_6892":123312,"_42174":123273,"_29767":201962,"_5":21387,"_28235":123273,"_5797":201963},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_6892":123313,"_42174":123273,"_29767":201965,"_5":21387,"_28235":123273,"_5797":201966},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_6892":123314,"_42174":123273,"_29767":201968,"_5":21387,"_28235":123273,"_5797":201969},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_6892":123315,"_42174":123273,"_29767":201971,"_5":21387,"_28235":123273,"_5797":201972},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_6892":123316,"_42174":123273,"_29767":201974,"_5":21387,"_28235":123273,"_5797":201975},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_6892":123317,"_42174":123273,"_29767":201977,"_5":21387,"_28235":123273,"_5797":201978},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_6892":123318,"_42174":123273,"_29767":201980,"_5":21387,"_28235":201822,"_5797":201981},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_6892":123319,"_42174":123273,"_29767":201983,"_5":21387,"_28235":201822,"_5797":201984},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_6892":123320,"_42174":123273,"_29767":201986,"_5":21387,"_28235":201826,"_5797":201987},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_6892":123321,"_42174":123273,"_29767":201989,"_5":21387,"_28235":201826,"_5797":201990},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_6892":123322,"_42174":123273,"_29767":201992,"_5":21387,"_28235":201830,"_5797":201993},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_6892":123323,"_42174":123273,"_29767":201995,"_5":21387,"_28235":201834,"_5797":201996},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_6892":123324,"_42174":123273,"_29767":201998,"_5":21387,"_28235":201834,"_5797":201999},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_6892":123325,"_42174":123273,"_29767":202001,"_5":21387,"_28235":201834,"_5797":202002},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_6892":123326,"_42174":123273,"_29767":202004,"_5":21387,"_28235":201834,"_5797":202005},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_6892":123327,"_42174":123273,"_29767":202007,"_5":21387,"_28235":201834,"_5797":202008},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_6892":123328,"_42174":123273,"_29767":202010,"_5":21387,"_28235":201838,"_5797":202011},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_6892":123329,"_42174":123273,"_29767":202013,"_5":21387,"_28235":201838,"_5797":202014},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_6892":123330,"_42174":123273,"_29767":202016,"_5":21387,"_28235":201838,"_5797":202017},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_6892":123331,"_42174":123273,"_29767":202019,"_5":21387,"_28235":201838,"_5797":202020},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_6892":123332,"_42174":123273,"_29767":202022,"_5":21387,"_28235":201838,"_5797":202023},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_6892":123333,"_42174":123273,"_29767":202025,"_5":21387,"_28235":201842,"_5797":202026},[],"Cambio",{"_6892":123334,"_42174":123273,"_29767":202028,"_5":21387,"_28235":201842,"_5797":202029},[],"A quién afecta",{"_6892":123335,"_42174":123273,"_29767":202031,"_5":21387,"_28235":201842,"_5797":202032},[],"Gravedad",{"_6892":123336,"_42174":123273,"_29767":202034,"_5":21387,"_28235":201842,"_5797":192463},[],{"_6892":123337,"_42174":123273,"_29767":202036,"_5":21387,"_28235":201842,"_5797":201850},[],{"_6892":123338,"_42174":123273,"_29767":202038,"_5":21387,"_28235":201842,"_5797":202039},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_6892":123339,"_42174":123273,"_29767":202041,"_5":21387,"_28235":201842,"_5797":202042},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_6892":123340,"_42174":123273,"_29767":202044,"_5":21387,"_28235":201842,"_5797":202045},[],"Copiar los datos a los volúmenes nuevos",{"_6892":123341,"_42174":123273,"_29767":202047,"_5":21387,"_28235":201842,"_5797":201854},[],{"_6892":123342,"_42174":123273,"_29767":202049,"_5":21387,"_28235":201842,"_5797":202050},[],"Todas las releases de Helm",{"_6892":123343,"_42174":123273,"_29767":202052,"_5":21387,"_28235":201842,"_5797":202053},[],"Alta: `helm upgrade` falla",{"_6892":123344,"_42174":123273,"_29767":202055,"_5":21387,"_28235":201842,"_5797":202056},[],"Eliminar o renombrar las claves heredadas",{"_6892":123345,"_42174":123273,"_29767":202058,"_5":21387,"_28235":201842,"_5797":201858},[],{"_6892":123346,"_42174":123273,"_29767":202060,"_5":21387,"_28235":201842,"_5797":202061},[],"Todos los despliegues",{"_6892":123347,"_42174":123273,"_29767":202063,"_5":21387,"_28235":201842,"_5797":202064},[],"Alta: sin principal de bootstrap no hay administrador",{"_6892":123348,"_42174":123273,"_29767":202066,"_5":21387,"_28235":201842,"_5797":202067},[],"Configurar `services.authz`",{"_6892":123349,"_42174":123273,"_29767":202069,"_5":21387,"_28235":201842,"_5797":201862},[],{"_6892":123350,"_42174":123273,"_29767":202071,"_5":21387,"_28235":201842,"_5797":202050},[],{"_6892":123351,"_42174":123273,"_29767":202073,"_5":21387,"_28235":201842,"_5797":202074},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_6892":123352,"_42174":123273,"_29767":202076,"_5":21387,"_28235":201842,"_5797":202077},[],"Mover JWKS y roles a `services.authz`",{"_6892":123353,"_42174":123273,"_29767":202079,"_5":21387,"_28235":201842,"_5797":201882},[],{"_6892":123354,"_42174":123273,"_29767":202081,"_5":21387,"_28235":201842,"_5797":202082},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_6892":123355,"_42174":123273,"_29767":202084,"_5":21387,"_28235":201842,"_5797":202085},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_6892":123356,"_42174":123273,"_29767":202087,"_5":21387,"_28235":201842,"_5797":202088},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_6892":123357,"_42174":123273,"_29767":202090,"_5":21387,"_28235":201842,"_5797":201886},[],{"_6892":123358,"_42174":123273,"_29767":202092,"_5":21387,"_28235":201842,"_5797":202093},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_6892":123359,"_42174":123273,"_29767":202095,"_5":21387,"_28235":201842,"_5797":202096},[],"Alta: el backend ya no arranca con ellos",{"_6892":123360,"_42174":123273,"_29767":202098,"_5":21387,"_28235":201842,"_5797":202099},[],"Pasar a PostgreSQL antes de actualizar",{"_6892":123361,"_42174":123273,"_29767":202101,"_5":21387,"_28235":201842,"_5797":202102},[],"Webhooks con referencias a archivos",{"_6892":123362,"_42174":123273,"_29767":202104,"_5":21387,"_28235":201842,"_5797":202105},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_6892":123363,"_42174":123273,"_29767":202107,"_5":21387,"_28235":201842,"_5797":202108},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_6892":123364,"_42174":123273,"_29767":202110,"_5":21387,"_28235":201842,"_5797":202111},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_6892":123365,"_42174":123273,"_29767":202113,"_5":21387,"_28235":201842,"_5797":201866},[],{"_6892":123366,"_42174":123273,"_29767":202115,"_5":21387,"_28235":201842,"_5797":202116},[],"Releases con identidades por servicio o material de claves montado",{"_6892":123367,"_42174":123273,"_29767":202118,"_5":21387,"_28235":201842,"_5797":202119},[],"Media: los servicios no pueden leer sus archivos",{"_6892":123368,"_42174":123273,"_29767":202121,"_5":21387,"_28235":201842,"_5797":202122},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_6892":123369,"_42174":123273,"_29767":202124,"_5":21387,"_28235":201842,"_5797":201870},[],{"_6892":123370,"_42174":123273,"_29767":202126,"_5":21387,"_28235":201842,"_5797":202127},[],"Releases que definen `amqp.tls`",{"_6892":123371,"_42174":123273,"_29767":202129,"_5":21387,"_28235":201842,"_5797":202130},[],"Media: los clientes se conectan al puerto equivocado",{"_6892":123372,"_42174":123273,"_29767":202132,"_5":21387,"_28235":201842,"_5797":202133},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_6892":123373,"_42174":123273,"_29767":202135,"_5":21387,"_28235":201842,"_5797":201890},[],{"_6892":123374,"_42174":123273,"_29767":202137,"_5":21387,"_28235":201842,"_5797":202138},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_6892":123375,"_42174":123273,"_29767":202140,"_5":21387,"_28235":201842,"_5797":202141},[],"Media: las claves de CA quedan sin gestionar",{"_6892":123376,"_42174":123273,"_29767":202143,"_5":21387,"_28235":201842,"_5797":202144},[],"Ejecutar la migración de CA a KMS",{"_6892":123377,"_42174":123273,"_29767":202146,"_5":21387,"_28235":201842,"_5797":202147},[],"Verificación del certificado del receptor",{"_6892":123378,"_42174":123273,"_29767":202149,"_5":21387,"_28235":201842,"_5797":202150},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_6892":123379,"_42174":123273,"_29767":202152,"_5":21387,"_28235":201842,"_5797":202153},[],"Media: las credenciales viajan a un receptor sin verificar",{"_6892":123380,"_42174":123273,"_29767":202155,"_5":21387,"_28235":201842,"_5797":202156},[],"Poner `insecure_skip_verify` a `false`",{"_6892":123381,"_42174":123273,"_29767":202158,"_5":21387,"_28235":201842,"_5797":201902},[],{"_6892":123382,"_42174":123273,"_29767":202160,"_5":21387,"_28235":201842,"_5797":202161},[],"Scripts y consolas que editan DMS por API",{"_6892":123383,"_42174":123273,"_29767":202163,"_5":21387,"_28235":201842,"_5797":202164},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_6892":123384,"_42174":123273,"_29767":202166,"_5":21387,"_28235":201842,"_5797":202167},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_6892":123385,"_42174":123273,"_29767":202169,"_5":21387,"_28235":201842,"_5797":201918},[],{"_6892":123386,"_42174":123273,"_29767":202171,"_5":21387,"_28235":201842,"_5797":202172},[],"Consumidores que leen el campo `events` del dispositivo",{"_6892":123387,"_42174":123273,"_29767":202174,"_5":21387,"_28235":201842,"_5797":202175},[],"Media: el campo desaparece",{"_6892":123388,"_42174":123273,"_29767":202177,"_5":21387,"_28235":201842,"_5797":202178},[],"Usar los nuevos endpoints de eventos",{"_6892":123389,"_42174":123273,"_29767":202180,"_5":21387,"_28235":201842,"_5797":201874},[],{"_6892":123390,"_42174":123273,"_29767":202182,"_5":21387,"_28235":201842,"_5797":202183},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_6892":123391,"_42174":123273,"_29767":202185,"_5":21387,"_28235":201842,"_5797":202186},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_6892":123392,"_42174":123273,"_29767":202188,"_5":21387,"_28235":201842,"_5797":202189},[],"Actualizar el archivo de values",{"_6892":123393,"_42174":123273,"_29767":202191,"_5":21387,"_28235":201842,"_5797":201910},[],{"_6892":123394,"_42174":123273,"_29767":202193,"_5":21387,"_28235":201842,"_5797":202194},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_6892":123395,"_42174":123273,"_29767":202196,"_5":21387,"_28235":201842,"_5797":202197},[],"Baja: prevalece el ID de la URL",{"_6892":123396,"_42174":123273,"_29767":202199,"_5":21387,"_28235":201842,"_5797":202200},[],"Enviar el ID en la URL",{"_6892":123397,"_42174":123273,"_29767":202202,"_5":21387,"_28235":201842,"_5797":201914},[],{"_6892":123398,"_42174":123273,"_29767":202204,"_5":21387,"_28235":201842,"_5797":202205},[],"Consumidores que comparan el `type` del certificado",{"_6892":123399,"_42174":123273,"_29767":202207,"_5":21387,"_28235":201842,"_5797":202208},[],"Baja: dos valores cambian de nombre",{"_6892":123400,"_42174":123273,"_29767":202210,"_5":21387,"_28235":201842,"_5797":202211},[],"Adaptar los consumidores",{"_6892":123401,"_42174":123273,"_29767":202213,"_5":21387,"_28235":201842,"_5797":201906},[],{"_6892":123402,"_42174":123273,"_29767":202215,"_5":21387,"_28235":201842,"_5797":202216},[],"Cualquier DMS",{"_6892":123403,"_42174":123273,"_29767":202218,"_5":21387,"_28235":201842,"_5797":202219},[],"Baja: solo informativo",{"_6892":123404,"_42174":123273,"_29767":202221,"_5":21387,"_28235":201842,"_5797":202222},[],"Revisar ambos bloques antes de editar",{"_6892":123405,"_42174":123273,"_29767":202224,"_5":21387,"_28235":201849,"_5797":202225},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_6892":123406,"_42174":123273,"_29767":202227,"_5":21387,"_28235":201849,"_5797":202228},[],"El paso 4 de la guía de migración copia los datos.",{"_6892":123407,"_42174":123273,"_29767":202230,"_5":21387,"_28235":201853,"_5797":202231},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_6892":123408,"_42174":123273,"_29767":202233,"_5":21387,"_28235":201857,"_5797":202234},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_6892":123409,"_42174":123273,"_29767":202236,"_5":21387,"_28235":201861,"_5797":202237},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_6892":123410,"_42174":123273,"_29767":202239,"_5":21387,"_28235":201865,"_5797":202240},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_6892":123411,"_42174":123273,"_29767":202242,"_5":21387,"_28235":201865,"_5797":202243},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_6892":123412,"_42174":123273,"_29767":202245,"_5":21387,"_28235":201869,"_5797":202246},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_6892":123413,"_42174":123273,"_29767":202248,"_5":21387,"_28235":201873,"_5797":202249},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_6892":123414,"_42174":123273,"_29767":202251,"_5":21387,"_28235":201873,"_5797":202252},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_6892":123415,"_42174":123273,"_29767":202254,"_5":21387,"_28235":201873,"_5797":202255},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_6892":123416,"_42174":123273,"_29767":202257,"_5":21387,"_28235":201873,"_5797":202258},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_6892":123417,"_42174":123273,"_29767":202260,"_5":21387,"_28235":201873,"_5797":202261},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_6892":123418,"_42174":123273,"_29767":202263,"_5":21387,"_28235":201873,"_5797":202264},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_6892":123419,"_42174":123273,"_29767":202266,"_5":21387,"_28235":201881,"_5797":202267},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_6892":123420,"_42174":123273,"_29767":202269,"_5":21387,"_28235":201881,"_5797":202270},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_6892":123421,"_42174":123273,"_29767":202272,"_5":21387,"_28235":201881,"_5797":202273},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_6892":123422,"_42174":123273,"_29767":202275,"_5":21387,"_28235":201881,"_5797":202276},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_6892":123423,"_42174":123273,"_29767":202278,"_5":21387,"_28235":201881,"_5797":202279},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_6892":123424,"_42174":123273,"_29767":202281,"_5":21387,"_28235":201885,"_5797":202282},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_6892":123425,"_42174":123273,"_29767":202284,"_5":21387,"_28235":201889,"_5797":202285},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_6892":123426,"_42174":123273,"_29767":202287,"_5":21387,"_28235":201889,"_5797":202288},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_6892":123427,"_42174":123273,"_29767":202290,"_5":21387,"_28235":201889,"_5797":202291},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_6892":123428,"_42174":123273,"_29767":202293,"_5":21387,"_28235":201889,"_5797":202294},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_6892":123429,"_42174":123273,"_29767":202296,"_5":21387,"_28235":201889,"_5797":202297},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_6892":123430,"_42174":123273,"_29767":202299,"_5":21387,"_28235":201889,"_5797":202300},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_6892":123431,"_42174":123273,"_29767":202302,"_5":21387,"_28235":201897,"_5797":202303},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_6892":123432,"_42174":123273,"_29767":202305,"_5":21387,"_28235":201897,"_5797":202306},[],"Campo en 3.8.0",{"_6892":123433,"_42174":123273,"_29767":202308,"_5":21387,"_28235":201897,"_5797":202309},[],"Campo en 4.0.0",{"_6892":123434,"_42174":123273,"_29767":202311,"_5":21387,"_28235":201897,"_5797":94346},[],{"_6892":123435,"_42174":123273,"_29767":202313,"_5":21387,"_28235":201897,"_5797":202314},[],"`insecure_skip_verify` (con el valor negado)",{"_6892":123436,"_42174":123273,"_29767":202316,"_5":21387,"_28235":201897,"_5797":94352},[],{"_6892":123437,"_42174":123273,"_29767":202318,"_5":21387,"_28235":201897,"_5797":94355},[],{"_6892":123438,"_42174":123273,"_29767":202320,"_5":21387,"_28235":201897,"_5797":94358},[],{"_6892":123439,"_42174":123273,"_29767":202322,"_5":21387,"_28235":201897,"_5797":94361},[],{"_6892":123440,"_42174":123273,"_29767":202324,"_5":21387,"_28235":201897,"_5797":94364},[],{"_6892":123441,"_42174":123273,"_29767":202326,"_5":21387,"_28235":201897,"_5797":94367},[],{"_6892":123442,"_42174":123273,"_29767":202328,"_5":21387,"_28235":201897,"_5797":202329},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_6892":123443,"_42174":123273,"_29767":202331,"_5":21387,"_28235":201897,"_5797":202332},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_6892":123444,"_42174":123273,"_29767":202334,"_5":21387,"_28235":201897,"_5797":202335},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_6892":123445,"_42174":123273,"_29767":202337,"_5":21387,"_28235":201901,"_5797":202338},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_6892":123446,"_42174":123273,"_29767":202340,"_5":21387,"_28235":201901,"_5797":202341},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_6892":123447,"_42174":123273,"_29767":202343,"_5":21387,"_28235":201901,"_5797":202344},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_6892":123448,"_42174":123273,"_29767":202346,"_5":21387,"_28235":201905,"_5797":202347},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_6892":123449,"_42174":123273,"_29767":202349,"_5":21387,"_28235":201909,"_5797":202350},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_6892":123450,"_42174":123273,"_29767":202352,"_5":21387,"_28235":201913,"_5797":202353},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_6892":123451,"_42174":123273,"_29767":202355,"_5":21387,"_28235":201917,"_5797":202356},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_6892":123452,"_42174":123273,"_29767":202358,"_5":21387,"_28235":201917,"_5797":202359},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_6892":123453,"_42174":123273,"_29767":202361,"_5":21387,"_28235":201917,"_5797":202362},[],"`POST /v1/devices/:id/events` crea un evento.",{"_6892":123454,"_42174":123273,"_29767":202364,"_5":21387,"_28235":201917,"_5797":202365},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_6892":123455,"_42174":123273,"_29767":202367,"_5":21387,"_28235":201921,"_5797":202368},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_6892":123456,"_42174":123273,"_29767":202370,"_5":21387,"_28235":201925,"_5797":202371},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_6892":123457,"_42174":123273,"_29767":202373,"_5":21387,"_28235":201925,"_5797":202374},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_6892":123458,"_42174":123273,"_29767":202376,"_5":21387,"_28235":201925,"_5797":202377},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_6892":123459,"_42174":123273,"_29767":202379,"_5":21387,"_28235":201925,"_5797":202380},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_6892":123460,"_42174":123273,"_29767":202382,"_5":21387,"_28235":201925,"_5797":202383},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_6892":123461,"_42174":123273,"_29767":202385,"_5":21387,"_28235":201929,"_5797":202386},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_6892":123462,"_42174":123273,"_29767":202388,"_5":21387,"_28235":201929,"_5797":202389},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_6892":123463,"_42174":123273,"_29767":202391,"_5":21387,"_28235":201929,"_5797":202392},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_6892":123464,"_42174":123273,"_29767":202394,"_5":21387,"_28235":201929,"_5797":202395},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_6892":123465,"_42174":123273,"_29767":202397,"_5":21387,"_28235":201929,"_5797":202398},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_6892":123466,"_42174":123273,"_29767":202400,"_5":21387,"_28235":201929,"_5797":202401},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_6892":123467,"_42174":123273,"_29767":202403,"_5":21387,"_28235":201929,"_5797":202404},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_6892":123468,"_42174":123273,"_29767":202406,"_5":21387,"_28235":201929,"_5797":202407},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_6892":123469,"_42174":123273,"_29767":202409,"_5":21387,"_28235":201929,"_5797":202410},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_6892":123470,"_42174":123273,"_29767":202412,"_5":21387,"_28235":201929,"_5797":202413},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_6892":123471,"_42174":123273,"_29767":202415,"_5":21387,"_28235":201929,"_5797":202416},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_6892":123472,"_42174":123273,"_29767":202418,"_5":21387,"_28235":201929,"_5797":202419},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_6892":123473,"_42174":123273,"_29767":202421,"_5":21387,"_28235":201933,"_5797":202422},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_6892":123474,"_42174":123273,"_29767":202424,"_5":21387,"_28235":201933,"_5797":202425},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_6892":123475,"_42174":123273,"_29767":202427,"_5":21387,"_28235":201937,"_5797":202428},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_6892":123476,"_42174":123273,"_29767":202430,"_5":21387,"_28235":201937,"_5797":202431},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_6892":123477,"_42174":123273,"_29767":202433,"_5":21387,"_28235":201937,"_5797":202434},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_6892":123478,"_42174":123273,"_29767":202436,"_5":21387,"_28235":201937,"_5797":202437},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_6892":123479,"_42174":123273,"_29767":202439,"_5":21387,"_28235":201937,"_5797":202440},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_6892":123480,"_42174":123273,"_29767":202442,"_5":21387,"_28235":201937,"_5797":202443},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_6892":123481,"_42174":123273,"_29767":202445,"_5":21387,"_28235":201937,"_5797":202446},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_6892":123482,"_42174":123273,"_29767":202448,"_5":21387,"_28235":201937,"_5797":202449},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_6892":123483,"_42174":123273,"_29767":202451,"_5":21387,"_28235":201937,"_5797":202452},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_6892":123484,"_42174":123273,"_29767":202454,"_5":21387,"_28235":201937,"_5797":202455},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_6892":123485,"_42174":123273,"_29767":202457,"_5":21387,"_28235":201937,"_5797":202458},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_6892":123486,"_42174":123273,"_29767":202460,"_5":21387,"_28235":201941,"_5797":202461},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_6892":123487,"_42174":123273,"_29767":202463,"_5":21387,"_28235":201941,"_5797":202464},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_6892":123488,"_42174":123273,"_29767":202466,"_5":21387,"_28235":201945,"_5797":202467},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_6892":123489,"_42174":123273,"_29767":202469,"_5":21387,"_28235":201945,"_5797":202470},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_6892":123490,"_42174":123273,"_29767":202472,"_5":21387,"_28235":201945,"_5797":202473},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_6892":123491,"_42174":123273,"_29767":202475,"_5":21387,"_28235":201945,"_5797":202476},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_6892":123492,"_42174":123273,"_29767":202478,"_5":21387,"_28235":201945,"_5797":202479},[],"El README de `goose-lamassu` aún muestra ejemplos por base de datos (`dbname=ca`, `dbname=kms`) y afirma que la herramienta valida el nombre de la base de datos, y el README de `ca-to-kms-migration` sigue describiendo el modelo de dos bases anterior a 4.0.0. Sigue la forma con `dbname=pki` de esta página en lugar de sus ejemplos.",{"_6892":123493,"_42174":123273,"_29767":202481,"_5":21387,"_28235":201949,"_5797":202482},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_6892":123494,"_42174":123273,"_29767":202484,"_5":21387,"_28235":201949,"_5797":202485},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_6892":123495,"_42174":123273,"_29767":202487,"_5":21387,"_28235":201949,"_5797":202488},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_6892":123496,"_42174":123273,"_29767":202490,"_5":21387,"_28235":201949,"_5797":202491},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_6892":123497,"_42174":123273,"_29767":202493,"_5":21387,"_28235":201949,"_5797":202494},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_6892":123498,"_42174":123273,"_29767":202496,"_5":21387,"_28235":201949,"_5797":202497},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_6892":123499,"_42174":123273,"_29767":202499,"_5":21387,"_28235":201949,"_5797":202500},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_6892":123500,"_42174":123273,"_29767":202502,"_5":21387,"_28235":201952,"_5797":202503},[],"Tras la actualización, comprueba en este orden:",{"_6892":123501,"_42174":123273,"_29767":202505,"_5":21387,"_28235":201952,"_5797":202506},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS.",{"_6892":123502,"_42174":123273,"_29767":202508,"_5":21387,"_28235":201952,"_5797":202509},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_6892":123503,"_42174":123273,"_29767":202511,"_5":21387,"_28235":201952,"_5797":202512},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_6892":123504,"_42174":123273,"_29767":202514,"_5":21387,"_28235":201952,"_5797":202515},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_6892":123505,"_42174":123273,"_29767":202517,"_5":21387,"_28235":201952,"_5797":202518},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_6892":123506,"_42174":123273,"_29767":202520,"_5":21387,"_28235":201952,"_5797":202521},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_6892":123507,"_42174":123273,"_29767":202523,"_5":21387,"_28235":201952,"_5797":202524},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_6892":123508,"_42174":123273,"_29767":202526,"_5":21387,"_28235":201952,"_5797":202527},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_6892":123509,"_42174":123273,"_29767":202529,"_5":21387,"_28235":201952,"_5797":202530},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_6892":123510,"_42174":123273,"_29767":202532,"_5":21387,"_28235":201952,"_5797":202533},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_6892":123511,"_42174":123273,"_29767":202535,"_5":21387,"_28235":201952,"_5797":202536},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_6892":123512,"_42174":123273,"_29767":202538,"_5":21387,"_28235":201952,"_5797":202539},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_6892":123513,"_42174":123273,"_29767":202541,"_5":21387,"_28235":201952,"_5797":202542},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_6892":123514,"_42174":123273,"_29767":202544,"_5":21387,"_28235":201952,"_5797":202545},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_6892":123515,"_42174":123273,"_29767":202547,"_5":21387,"_28235":201956,"_5797":202548},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_6892":123516,"_42174":123273,"_29767":202550,"_5":21387,"_28235":201956,"_5797":202551},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_6892":123517,"_42174":123273,"_29767":202553,"_5":21387,"_28235":201956,"_5797":202554},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_6892":123518,"_42174":123273,"_29767":202556,"_5":21387,"_28235":201956,"_5797":202557},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_6892":123519,"_42174":123273,"_29767":202559,"_5":21387,"_28235":201956,"_5797":202560},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_94604":202562,"_94605":202563,"_94607":202564,"_94609":202565,"_26199":5814,"_117736":5814},"spanish",[5797,42174,5,28235],{"_5797":34761,"_42174":34761,"_5":34761,"_28235":34761},{"_5797":202566,"_42174":208346,"_5":214126,"_28235":219906},{"_8483":202567,"_94613":202568,"_5":34761},{"_7036":10813,"_7050":17804,"_7056":26495,"_7043":16715,"_16513":7584,"_28242":7319,"_21503":23501,"_13924":5907,"_15089":12026,"_41303":9577,"_41361":9468,"_40752":14048,"_48303":8697,"_40947":7434,"_41421":22176,"_41382":8051,"_48312":6204,"_48315":33652,"_48318":9066,"_41855":6445,"_48323":33942,"_41926":11359,"_41936":14538,"_22115":6984,"_41912":11808,"_41946":27670,"_48331":7987,"_41941":10632,"_40898":28718,"_41956":14287,"_40882":6933,"_42012":8277,"_48338":20939,"_40964":12045,"_48341":6431,"_48343":35037,"_48345":14511,"_48347":10965,"_48349":6651,"_40795":38134,"_40853":33995,"_48353":7609,"_40789":40803,"_41457":31903,"_48357":7583,"_48359":34773,"_48362":16490,"_40848":17700,"_48366":9253,"_40692":24994,"_48369":35655,"_40757":16953,"_48372":40374,"_48374":30779,"_48377":14102,"_22109":5895,"_48380":6215,"_48382":34355,"_48385":22322,"_39914":17313,"_48388":20946,"_48390":7252,"_48392":8206,"_28245":21867,"_48395":9830,"_48397":12119,"_40730":6700,"_48400":12819,"_48402":6343,"_48404":10458,"_48406":6384,"_41973":11977,"_48409":12325,"_48411":12097,"_42165":26050,"_4