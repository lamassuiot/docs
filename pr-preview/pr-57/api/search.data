859,"_29729":68858,"_20626":114183,"_5":14148,"_27027":68858,"_2882":114184},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3396":68860,"_29729":68858,"_5":30079,"_20626":114186,"_27027":114187,"_2882":114188},[],"/docs/pr-preview/pr-57/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3396":68861,"_29729":68858,"_5":30079,"_20626":114190,"_27027":114191,"_2882":114192},[],"/docs/pr-preview/pr-57/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3396":68862,"_29729":68858,"_5":30079,"_20626":114194,"_27027":114195,"_2882":114196},[],"/docs/pr-preview/pr-57/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3396":68863,"_29729":68858,"_5":30079,"_20626":114198,"_27027":114199,"_2882":114200},[],"/docs/pr-preview/pr-57/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3396":68864,"_29729":68858,"_5":30079,"_20626":114202,"_27027":114203,"_2882":114204},[],"/docs/pr-preview/pr-57/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3396":68865,"_29729":68858,"_5":30079,"_20626":114206,"_27027":114207,"_2882":114208},[],"/docs/pr-preview/pr-57/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3396":68866,"_29729":68858,"_5":30079,"_20626":114210,"_27027":114211,"_2882":114212},[],"/docs/pr-preview/pr-57/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3396":68867,"_29729":68858,"_20626":114214,"_5":14148,"_27027":68858,"_2882":114215},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3396":68868,"_29729":68858,"_20626":114217,"_5":14148,"_27027":114187,"_2882":114218},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3396":68869,"_29729":68858,"_20626":114220,"_5":14148,"_27027":114187,"_2882":114221},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3396":68870,"_29729":68858,"_20626":114223,"_5":14148,"_27027":114187,"_2882":114224},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3396":68871,"_29729":68858,"_20626":114226,"_5":14148,"_27027":114191,"_2882":114227},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3396":68872,"_29729":68858,"_20626":114229,"_5":14148,"_27027":114191,"_2882":114230},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3396":68873,"_29729":68858,"_20626":114232,"_5":14148,"_27027":114191,"_2882":114233},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3396":68874,"_29729":68858,"_20626":114235,"_5":14148,"_27027":114195,"_2882":114236},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3396":68875,"_29729":68858,"_20626":114238,"_5":14148,"_27027":114199,"_2882":114239},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3396":68876,"_29729":68858,"_20626":114241,"_5":14148,"_27027":114203,"_2882":114242},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3396":68877,"_29729":68858,"_20626":114244,"_5":14148,"_27027":114207,"_2882":114245},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3396":68878,"_29729":68858,"_20626":114247,"_5":14148,"_27027":114211,"_2882":114248},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3396":68879,"_29729":68879,"_5":14500,"_2882":114250,"_30082":114251,"_20626":114252,"_27027":68879},"Despliega Lamassu",[48429,114179],[],{"_3396":68880,"_29729":68879,"_20626":114254,"_5":14148,"_27027":68879,"_2882":114255},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3396":68881,"_29729":68879,"_5":30079,"_20626":114257,"_27027":114258,"_2882":114259},[],"/docs/pr-preview/pr-57/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3396":68882,"_29729":68879,"_5":30079,"_20626":114261,"_27027":114262,"_2882":114263},[],"/docs/pr-preview/pr-57/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3396":68883,"_29729":68879,"_5":30079,"_20626":114265,"_27027":114266,"_2882":114267},[],"/docs/pr-preview/pr-57/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3396":68884,"_29729":68879,"_20626":114269,"_5":14148,"_27027":68879,"_2882":114270},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3396":68885,"_29729":68879,"_20626":114272,"_5":14148,"_27027":114258,"_2882":114273},[],"Modelo",{"_3396":68886,"_29729":68879,"_20626":114275,"_5":14148,"_27027":114258,"_2882":114276},[],"Recomendado para",{"_3396":68887,"_29729":68879,"_20626":114278,"_5":14148,"_27027":114258,"_2882":114279},[],"Quién opera la infraestructura",{"_3396":68888,"_29729":68879,"_20626":114281,"_5":14148,"_27027":114258,"_2882":114282},[],"Punto de partida",{"_3396":68889,"_29729":68879,"_20626":114284,"_5":14148,"_27027":114258,"_2882":48536},[],{"_3396":68890,"_29729":68879,"_20626":114286,"_5":14148,"_27027":114258,"_2882":114287},[],"Producción, entornos regulados y despliegues personalizados",{"_3396":68891,"_29729":68879,"_20626":114289,"_5":14148,"_27027":114258,"_2882":114290},[],"Tu equipo",{"_3396":68892,"_29729":68879,"_20626":114292,"_5":14148,"_27027":114258,"_2882":114293},[],"Helm o Fastlane",{"_3396":68893,"_29729":68879,"_20626":114295,"_5":14148,"_27027":114258,"_2882":48548},[],{"_3396":68894,"_29729":68879,"_20626":114297,"_5":14148,"_27027":114258,"_2882":114298},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3396":68895,"_29729":68879,"_20626":114300,"_5":14148,"_27027":114258,"_2882":114290},[],{"_3396":68896,"_29729":68879,"_20626":114302,"_5":14148,"_27027":114258,"_2882":114303},[],"Imagen preconfigurada en EC2",{"_3396":68897,"_29729":68879,"_20626":114305,"_5":14148,"_27027":114258,"_2882":48559},[],{"_3396":68898,"_29729":68879,"_20626":114307,"_5":14148,"_27027":114258,"_2882":114308},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3396":68899,"_29729":68879,"_20626":114310,"_5":14148,"_27027":114258,"_2882":48565},[],{"_3396":68900,"_29729":68879,"_20626":114312,"_5":14148,"_27027":114258,"_2882":114313},[],"Suscripción gestionada",{"_3396":68901,"_29729":68879,"_20626":114315,"_5":14148,"_27027":114258,"_2882":114316},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3396":68902,"_29729":68879,"_20626":114318,"_5":14148,"_27027":114258,"_2882":114319},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3396":68903,"_29729":68879,"_20626":114321,"_5":14148,"_27027":114258,"_2882":114322},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3396":68904,"_29729":68879,"_20626":114324,"_5":14148,"_27027":114262,"_2882":114325},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3396":68905,"_29729":68879,"_20626":114327,"_5":14148,"_27027":114266,"_2882":114328},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3396":68906,"_29729":68906,"_5":14500,"_2882":114330,"_30082":114331,"_20626":114332,"_27027":68906},"Utiliza Lamassu como SaaS",[48429,114179,114180],[],{"_3396":68907,"_29729":68906,"_20626":114334,"_5":14148,"_27027":68906,"_2882":114335},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3396":68908,"_29729":68906,"_5":30079,"_20626":114337,"_27027":114338,"_2882":114339},[],"/docs/pr-preview/pr-57/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3396":68909,"_29729":68906,"_5":30079,"_20626":114341,"_27027":114342,"_2882":114343},[],"/docs/pr-preview/pr-57/es/deployment/saas#planes","Planes",{"_3396":68910,"_29729":68906,"_5":30079,"_20626":114345,"_27027":114346,"_2882":114347},[],"/docs/pr-preview/pr-57/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3396":68911,"_29729":68906,"_20626":114349,"_5":14148,"_27027":68906,"_2882":114350},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3396":68912,"_29729":68906,"_20626":114352,"_5":14148,"_27027":114338,"_2882":114353},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3396":68913,"_29729":68906,"_20626":114355,"_5":14148,"_27027":114338,"_2882":114356},[],"Copias de seguridad automáticas.",{"_3396":68914,"_29729":68906,"_20626":114358,"_5":14148,"_27027":114338,"_2882":114359},[],"Actualizaciones de versión.",{"_3396":68915,"_29729":68906,"_20626":114361,"_5":14148,"_27027":114338,"_2882":114362},[],"Soporte técnico y SLA según el plan contratado.",{"_3396":68916,"_29729":68906,"_20626":114364,"_5":14148,"_27027":114342,"_2882":48620},[],{"_3396":68917,"_29729":68906,"_20626":114366,"_5":14148,"_27027":114342,"_2882":114367},[],"Dispositivos",{"_3396":68918,"_29729":68906,"_20626":114369,"_5":14148,"_27027":114342,"_2882":114370},[],"Soporte",{"_3396":68919,"_29729":68906,"_20626":114372,"_5":14148,"_27027":114342,"_2882":48629},[],{"_3396":68920,"_29729":68906,"_20626":114374,"_5":14148,"_27027":114342,"_2882":48632},[],{"_3396":68921,"_29729":68906,"_20626":114376,"_5":14148,"_27027":114342,"_2882":114377},[],"Hasta 1.000",{"_3396":68922,"_29729":68906,"_20626":114379,"_5":14148,"_27027":114342,"_2882":48638},[],{"_3396":68923,"_29729":68906,"_20626":114381,"_5":14148,"_27027":114342,"_2882":114382},[],"99,5 %",{"_3396":68924,"_29729":68906,"_20626":114384,"_5":14148,"_27027":114342,"_2882":48644},[],{"_3396":68925,"_29729":68906,"_20626":114386,"_5":14148,"_27027":114342,"_2882":114387},[],"Hasta 10.000",{"_3396":68926,"_29729":68906,"_20626":114389,"_5":14148,"_27027":114342,"_2882":114390},[],"Email y chat",{"_3396":68927,"_29729":68906,"_20626":114392,"_5":14148,"_27027":114342,"_2882":114393},[],"99,9 %",{"_3396":68928,"_29729":68906,"_20626":114395,"_5":14148,"_27027":114342,"_2882":48656},[],{"_3396":68929,"_29729":68906,"_20626":114397,"_5":14148,"_27027":114342,"_2882":114398},[],"Ilimitados",{"_3396":68930,"_29729":68906,"_20626":114400,"_5":14148,"_27027":114342,"_2882":114401},[],"Dedicado",{"_3396":68931,"_29729":68906,"_20626":114403,"_5":14148,"_27027":114342,"_2882":114404},[],"99,99 %",{"_3396":68932,"_29729":68906,"_20626":114406,"_5":14148,"_27027":114346,"_2882":114407},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3396":68933,"_29729":68906,"_20626":114409,"_5":14148,"_27027":114346,"_2882":114410},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3396":68934,"_29729":68934,"_5":14500,"_2882":48673,"_30082":114412,"_20626":114414,"_27027":68934},[48429,114179,114413],"Kubernetes autogestionado",[],{"_3396":68935,"_29729":68934,"_20626":114416,"_5":14148,"_27027":68934,"_2882":114417},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3396":68936,"_29729":68934,"_5":30079,"_20626":114419,"_27027":114420,"_2882":114421},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3396":68937,"_29729":68934,"_5":30079,"_20626":114423,"_27027":114424,"_2882":114425},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3396":68938,"_29729":68934,"_5":30079,"_20626":114427,"_27027":114428,"_2882":114429},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3396":68939,"_29729":68934,"_5":30079,"_20626":114431,"_27027":114432,"_2882":114433},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3396":68940,"_29729":68934,"_5":30079,"_20626":114435,"_27027":114436,"_2882":114437},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3396":68941,"_29729":68934,"_5":30079,"_20626":114439,"_27027":114440,"_2882":114441},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3396":68942,"_29729":68934,"_5":30079,"_20626":114443,"_27027":114444,"_2882":114445},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3396":68943,"_29729":68934,"_5":30079,"_20626":114447,"_27027":114448,"_2882":114449},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3396":68944,"_29729":68934,"_5":30079,"_20626":114451,"_27027":114452,"_2882":114453},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3396":68945,"_29729":68934,"_5":30079,"_20626":114455,"_27027":114456,"_2882":114457},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3396":68946,"_29729":68934,"_5":30079,"_20626":114459,"_27027":114460,"_2882":114461},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3396":68947,"_29729":68934,"_20626":114463,"_5":14148,"_27027":114420,"_2882":114464},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3396":68948,"_29729":68934,"_20626":114466,"_5":14148,"_27027":114420,"_2882":114467},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3396":68949,"_29729":68934,"_20626":114469,"_5":14148,"_27027":114424,"_2882":114470},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3396":68950,"_29729":68934,"_20626":114472,"_5":14148,"_27027":114424,"_2882":114473},[],"Fastlane instala o configura",{"_3396":68951,"_29729":68934,"_20626":114475,"_5":14148,"_27027":114424,"_2882":114476},[],"Tú sigues proporcionando",{"_3396":68952,"_29729":68934,"_20626":114478,"_5":14148,"_27027":114424,"_2882":114479},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3396":68953,"_29729":68934,"_20626":114481,"_5":14148,"_27027":114424,"_2882":114482},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3396":68954,"_29729":68934,"_20626":114484,"_5":14148,"_27027":114424,"_2882":114485},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3396":68955,"_29729":68934,"_20626":114487,"_5":14148,"_27027":114424,"_2882":114488},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3396":68956,"_29729":68934,"_20626":114490,"_5":14148,"_27027":114424,"_2882":114491},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3396":68957,"_29729":68934,"_20626":114493,"_5":14148,"_27027":114424,"_2882":114494},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3396":68958,"_29729":68934,"_20626":114496,"_5":14148,"_27027":114424,"_2882":114497},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3396":68959,"_29729":68934,"_20626":114499,"_5":14148,"_27027":114424,"_2882":114500},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3396":68960,"_29729":68934,"_20626":114502,"_5":14148,"_27027":114424,"_2882":114503},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3396":68961,"_29729":68934,"_20626":114505,"_5":14148,"_27027":114428,"_2882":114506},[],"Necesitas:",{"_3396":68962,"_29729":68934,"_20626":114508,"_5":14148,"_27027":114428,"_2882":114509},[],"un clúster Kubernetes existente",{"_3396":68963,"_29729":68934,"_20626":114511,"_5":14148,"_27027":114428,"_2882":114512},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3396":68964,"_29729":68934,"_20626":114514,"_5":14148,"_27027":114428,"_2882":48775},[],{"_3396":68965,"_29729":68934,"_20626":114516,"_5":14148,"_27027":114428,"_2882":23309},[],{"_3396":68966,"_29729":68934,"_20626":114518,"_5":14148,"_27027":114428,"_2882":114519},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3396":68967,"_29729":68934,"_20626":114521,"_5":14148,"_27027":114428,"_2882":114522},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3396":68968,"_29729":68934,"_20626":114524,"_5":14148,"_27027":114428,"_2882":114525},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3396":68969,"_29729":68934,"_20626":114527,"_5":14148,"_27027":114428,"_2882":114528},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3396":68970,"_29729":68934,"_20626":114530,"_5":14148,"_27027":114428,"_2882":114531},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3396":68971,"_29729":68934,"_20626":114533,"_5":14148,"_27027":114432,"_2882":114534},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3396":68972,"_29729":68934,"_20626":114536,"_5":14148,"_27027":114432,"_2882":114537},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3396":68973,"_29729":68934,"_20626":114539,"_5":14148,"_27027":114436,"_2882":114540},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3396":68974,"_29729":68934,"_20626":114542,"_5":14148,"_27027":114436,"_2882":114543},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3396":68975,"_29729":68934,"_20626":114545,"_5":14148,"_27027":114436,"_2882":114546},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3396":68976,"_29729":68934,"_20626":114548,"_5":14148,"_27027":114436,"_2882":114549},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3396":68977,"_29729":68934,"_20626":114551,"_5":14148,"_27027":114440,"_2882":114552},[],"Opción",{"_3396":68978,"_29729":68934,"_20626":114554,"_5":14148,"_27027":114440,"_2882":114555},[],"Valor predeterminado",{"_3396":68979,"_29729":68934,"_20626":114557,"_5":14148,"_27027":114440,"_2882":114558},[],"Propósito",{"_3396":68980,"_29729":68934,"_20626":114560,"_5":14148,"_27027":114440,"_2882":48822},[],{"_3396":68981,"_29729":68934,"_20626":114562,"_5":14148,"_27027":114440,"_2882":48825},[],{"_3396":68982,"_29729":68934,"_20626":114564,"_5":14148,"_27027":114440,"_2882":114565},[],"Muestra la ayuda",{"_3396":68983,"_29729":68934,"_20626":114567,"_5":14148,"_27027":114440,"_2882":48831},[],{"_3396":68984,"_29729":68934,"_20626":114569,"_5":14148,"_27027":114440,"_2882":114570},[],"contexto actual",{"_3396":68985,"_29729":68934,"_20626":114572,"_5":14148,"_27027":114440,"_2882":114573},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3396":68986,"_29729":68934,"_20626":114575,"_5":14148,"_27027":114440,"_2882":48840},[],{"_3396":68987,"_29729":68934,"_20626":114577,"_5":14148,"_27027":114440,"_2882":6433},[],{"_3396":68988,"_29729":68934,"_20626":114579,"_5":14148,"_27027":114440,"_2882":114580},[],"Omite prompts y genera credenciales para las dependencias",{"_3396":68989,"_29729":68934,"_20626":114582,"_5":14148,"_27027":114440,"_2882":48848},[],{"_3396":68990,"_29729":68934,"_20626":114584,"_5":14148,"_27027":114440,"_2882":48851},[],{"_3396":68991,"_29729":68934,"_20626":114586,"_5":14148,"_27027":114440,"_2882":114587},[],"Namespace de la instalación",{"_3396":68992,"_29729":68934,"_20626":114589,"_5":14148,"_27027":114440,"_2882":48857},[],{"_3396":68993,"_29729":68934,"_20626":114591,"_5":14148,"_27027":114440,"_2882":48860},[],{"_3396":68994,"_29729":68934,"_20626":114593,"_5":14148,"_27027":114440,"_2882":114594},[],"Dominio usado por la UI, OIDC y el certificado",{"_3396":68995,"_29729":68934,"_20626":114596,"_5":14148,"_27027":114440,"_2882":48866},[],{"_3396":68996,"_29729":68934,"_20626":114598,"_5":14148,"_27027":114440,"_2882":14834},[],{"_3396":68997,"_29729":68934,"_20626":114600,"_5":14148,"_27027":114440,"_2882":114601},[],"Versión del chart de Lamassu",{"_3396":68998,"_29729":68934,"_20626":114603,"_5":14148,"_27027":114440,"_2882":48874},[],{"_3396":68999,"_29729":68934,"_20626":114605,"_5":14148,"_27027":114440,"_2882":48877},[],{"_3396":69000,"_29729":68934,"_20626":114607,"_5":14148,"_27027":114440,"_2882":114608},[],"Puerto del listener HTTPS",{"_3396":69001,"_29729":68934,"_20626":114610,"_5":14148,"_27027":114440,"_2882":48883},[],{"_3396":69002,"_29729":68934,"_20626":114612,"_5":14148,"_27027":114440,"_2882":48886},[],{"_3396":69003,"_29729":68934,"_20626":114614,"_5":14148,"_27027":114440,"_2882":114615},[],"Puerto del listener HTTP",{"_3396":69004,"_29729":68934,"_20626":114617,"_5":14148,"_27027":114440,"_2882":48892},[],{"_3396":69005,"_29729":68934,"_20626":114619,"_5":14148,"_27027":114440,"_2882":48825},[],{"_3396":69006,"_29729":68934,"_20626":114621,"_5":14148,"_27027":114440,"_2882":114622},[],"Certificado PEM para TLS downstream",{"_3396":69007,"_29729":68934,"_20626":114624,"_5":14148,"_27027":114440,"_2882":48900},[],{"_3396":69008,"_29729":68934,"_20626":114626,"_5":14148,"_27027":114440,"_2882":48825},[],{"_3396":69009,"_29729":68934,"_20626":114628,"_5":14148,"_27027":114440,"_2882":114629},[],"Clave privada PEM para TLS downstream",{"_3396":69010,"_29729":68934,"_20626":114631,"_5":14148,"_27027":114440,"_2882":48908},[],{"_3396":69011,"_29729":68934,"_20626":114633,"_5":14148,"_27027":114440,"_2882":114634},[],"chart del repositorio",{"_3396":69012,"_29729":68934,"_20626":114636,"_5":14148,"_27027":114440,"_2882":114637},[],"Usa un chart local de Lamassu sin empaquetar",{"_3396":69013,"_29729":68934,"_20626":114639,"_5":14148,"_27027":114440,"_2882":48917},[],{"_3396":69014,"_29729":68934,"_20626":114641,"_5":14148,"_27027":114440,"_2882":114642},[],"detección automática",{"_3396":69015,"_29729":68934,"_20626":114644,"_5":14148,"_27027":114440,"_2882":114645},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3396":69016,"_29729":68934,"_20626":114647,"_5":14148,"_27027":114440,"_2882":48925},[],{"_3396":69017,"_29729":68934,"_20626":114649,"_5":14148,"_27027":114440,"_2882":6433},[],{"_3396":69018,"_29729":68934,"_20626":114651,"_5":14148,"_27027":114440,"_2882":114652},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3396":69019,"_29729":68934,"_20626":114654,"_5":14148,"_27027":114440,"_2882":48933},[],{"_3396":69020,"_29729":68934,"_20626":114656,"_5":14148,"_27027":114440,"_2882":6433},[],{"_3396":69021,"_29729":68934,"_20626":114658,"_5":14148,"_27027":114440,"_2882":114659},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3396":69022,"_29729":68934,"_20626":114661,"_5":14148,"_27027":114440,"_2882":48941},[],{"_3396":69023,"_29729":68934,"_20626":114663,"_5":14148,"_27027":114440,"_2882":6433},[],{"_3396":69024,"_29729":68934,"_20626":114665,"_5":14148,"_27027":114440,"_2882":114666},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3396":69025,"_29729":68934,"_20626":114668,"_5":14148,"_27027":114440,"_2882":48949},[],{"_3396":69026,"_29729":68934,"_20626":114670,"_5":14148,"_27027":114440,"_2882":6433},[],{"_3396":69027,"_29729":68934,"_20626":114672,"_5":14148,"_27027":114440,"_2882":114673},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3396":69028,"_29729":68934,"_20626":114675,"_5":14148,"_27027":114440,"_2882":48957},[],{"_3396":69029,"_29729":68934,"_20626":114677,"_5":14148,"_27027":114440,"_2882":48960},[],{"_3396":69030,"_29729":68934,"_20626":114679,"_5":14148,"_27027":114440,"_2882":114680},[],"Usa otro chart local de SoftHSM",{"_3396":69031,"_29729":68934,"_20626":114682,"_5":14148,"_27027":114440,"_2882":114683},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3396":69032,"_29729":68934,"_20626":114685,"_5":14148,"_27027":114444,"_2882":114686},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3396":69033,"_29729":68934,"_20626":114688,"_5":14148,"_27027":114444,"_2882":114689},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3396":69034,"_29729":68934,"_20626":114691,"_5":14148,"_27027":114444,"_2882":114692},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3396":69035,"_29729":68934,"_20626":114694,"_5":14148,"_27027":114444,"_2882":114695},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3396":69036,"_29729":68934,"_20626":114697,"_5":14148,"_27027":114444,"_2882":114698},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3396":69037,"_29729":68934,"_20626":114700,"_5":14148,"_27027":114444,"_2882":114701},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3396":69038,"_29729":68934,"_20626":114703,"_5":14148,"_27027":114448,"_2882":48987},[],{"_3396":69039,"_29729":68934,"_20626":114705,"_5":14148,"_27027":114448,"_2882":114706},[],"valida las herramientas locales y el clúster seleccionado",{"_3396":69040,"_29729":68934,"_20626":114708,"_5":14148,"_27027":114448,"_2882":114709},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3396":69041,"_29729":68934,"_20626":114711,"_5":14148,"_27027":114448,"_2882":114712},[],"crea el namespace",{"_3396":69042,"_29729":68934,"_20626":114714,"_5":14148,"_27027":114448,"_2882":114715},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3396":69043,"_29729":68934,"_20626":114717,"_5":14148,"_27027":114448,"_2882":114718},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3396":69044,"_29729":68934,"_20626":114720,"_5":14148,"_27027":114448,"_2882":114721},[],"instala RabbitMQ",{"_3396":69045,"_29729":68934,"_20626":114723,"_5":14148,"_27027":114448,"_2882":114724},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3396":69046,"_29729":68934,"_20626":114726,"_5":14148,"_27027":114448,"_2882":114727},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3396":69047,"_29729":68934,"_20626":114729,"_5":14148,"_27027":114448,"_2882":114730},[],"carga datos de ejemplo opcionalmente",{"_3396":69048,"_29729":68934,"_20626":114732,"_5":14148,"_27027":114448,"_2882":114733},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3396":69049,"_29729":68934,"_20626":114735,"_5":14148,"_27027":114452,"_2882":114736},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3396":69050,"_29729":68934,"_20626":114738,"_5":14148,"_27027":114452,"_2882":114739},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3396":69051,"_29729":68934,"_20626":114741,"_5":14148,"_27027":114456,"_2882":114742},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3396":69052,"_29729":68934,"_20626":114744,"_5":14148,"_27027":114456,"_2882":114745},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3396":69053,"_29729":68934,"_20626":114747,"_5":14148,"_27027":114456,"_2882":114748},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3396":69054,"_29729":68934,"_20626":114750,"_5":14148,"_27027":114460,"_2882":114751},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3396":69055,"_29729":69055,"_5":14500,"_2882":114753,"_30082":114754,"_20626":114755,"_27027":69055},"Instala con Helm",[48429,114179,114413],[],{"_3396":69056,"_29729":69055,"_20626":114757,"_5":14148,"_27027":69055,"_2882":114758},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3396":69057,"_29729":69055,"_5":30079,"_20626":114760,"_27027":114761,"_2882":114762},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3396":69058,"_29729":69055,"_5":30079,"_20626":114764,"_27027":114765,"_2882":114429},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3396":69059,"_29729":69055,"_5":30079,"_20626":114767,"_27027":114768,"_2882":114769},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3396":69060,"_29729":69055,"_5":30079,"_20626":114771,"_27027":114772,"_2882":114773},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3396":69061,"_29729":69055,"_5":30079,"_20626":114775,"_27027":114776,"_2882":114777},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3396":69062,"_29729":69055,"_5":30079,"_20626":114779,"_27027":114780,"_2882":114781},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3396":69063,"_29729":69055,"_5":30079,"_20626":114783,"_27027":114784,"_2882":114785},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3396":69064,"_29729":69055,"_5":30079,"_20626":114787,"_27027":114788,"_2882":114789},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3396":69065,"_29729":69055,"_5":30079,"_20626":114791,"_27027":114792,"_2882":114793},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3396":69066,"_29729":69055,"_5":30079,"_20626":114795,"_27027":114796,"_2882":114797},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3396":69067,"_29729":69055,"_5":30079,"_20626":114799,"_27027":114800,"_2882":114801},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3396":69068,"_29729":69055,"_20626":114803,"_5":14148,"_27027":114761,"_2882":114804},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3396":69069,"_29729":69055,"_20626":114806,"_5":14148,"_27027":114765,"_2882":114807},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3396":69070,"_29729":69055,"_20626":114809,"_5":14148,"_27027":114765,"_2882":114810},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3396":69071,"_29729":69055,"_20626":114812,"_5":14148,"_27027":114765,"_2882":114813},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3396":69072,"_29729":69055,"_20626":114815,"_5":14148,"_27027":114765,"_2882":114816},[],"un broker RabbitMQ accesible y sus credenciales",{"_3396":69073,"_29729":69055,"_20626":114818,"_5":14148,"_27027":114765,"_2882":114819},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3396":69074,"_29729":69055,"_20626":114821,"_5":14148,"_27027":114765,"_2882":114822},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3396":69075,"_29729":69055,"_20626":114824,"_5":14148,"_27027":114765,"_2882":114825},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3396":69076,"_29729":69055,"_20626":114827,"_5":14148,"_27027":114765,"_2882":114828},[],"una StorageClass y un diseño de tráfico externo",{"_3396":69077,"_29729":69055,"_20626":114830,"_5":14148,"_27027":114765,"_2882":114831},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3396":69078,"_29729":69055,"_20626":114833,"_5":14148,"_27027":114765,"_2882":114834},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3396":69079,"_29729":69055,"_20626":114836,"_5":14148,"_27027":114765,"_2882":114837},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3396":69080,"_29729":69055,"_20626":114839,"_5":14148,"_27027":114768,"_2882":114840},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3396":69081,"_29729":69055,"_20626":114842,"_5":14148,"_27027":114768,"_2882":114843},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3396":69082,"_29729":69055,"_20626":114845,"_5":14148,"_27027":114768,"_2882":114846},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3396":69083,"_29729":69055,"_20626":114848,"_5":14148,"_27027":114772,"_2882":114849},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3396":69084,"_29729":69055,"_20626":114851,"_5":14148,"_27027":114772,"_2882":114852},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3396":69085,"_29729":69055,"_20626":114854,"_5":14148,"_27027":114772,"_2882":114855},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3396":69086,"_29729":69055,"_20626":114857,"_5":14148,"_27027":114772,"_2882":114858},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3396":69087,"_29729":69055,"_20626":114860,"_5":14148,"_27027":114776,"_2882":114861},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3396":69088,"_29729":69055,"_20626":114863,"_5":14148,"_27027":114780,"_2882":114864},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3396":69089,"_29729":69055,"_20626":114866,"_5":14148,"_27027":114780,"_2882":114867},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3396":69090,"_29729":69055,"_20626":114869,"_5":14148,"_27027":114780,"_2882":114870},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3396":69091,"_29729":69055,"_20626":114872,"_5":14148,"_27027":114780,"_2882":114873},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3396":69092,"_29729":69055,"_20626":114875,"_5":14148,"_27027":114780,"_2882":114876},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3396":69093,"_29729":69055,"_20626":114878,"_5":14148,"_27027":114780,"_2882":114879},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3396":69094,"_29729":69055,"_20626":114881,"_5":14148,"_27027":114780,"_2882":114882},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3396":69095,"_29729":69055,"_20626":114884,"_5":14148,"_27027":114784,"_2882":114885},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3396":69096,"_29729":69055,"_20626":114887,"_5":14148,"_27027":114784,"_2882":114888},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3396":69097,"_29729":69055,"_20626":114890,"_5":14148,"_27027":114784,"_2882":114891},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3396":69098,"_29729":69055,"_20626":114893,"_5":14148,"_27027":114784,"_2882":114894},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3396":69099,"_29729":69055,"_20626":114896,"_5":14148,"_27027":114788,"_2882":114897},[],"Para instalar un checkout local:",{"_3396":69100,"_29729":69055,"_20626":114899,"_5":14148,"_27027":114792,"_2882":114900},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3396":69101,"_29729":69055,"_20626":114902,"_5":14148,"_27027":114792,"_2882":114903},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3396":69102,"_29729":69055,"_20626":114905,"_5":14148,"_27027":114796,"_2882":114906},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3396":69103,"_29729":69055,"_20626":114908,"_5":14148,"_27027":114796,"_2882":114909},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3396":69104,"_29729":69055,"_20626":114911,"_5":14148,"_27027":114796,"_2882":114912},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3396":69105,"_29729":69055,"_20626":114914,"_5":14148,"_27027":114796,"_2882":114915},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3396":69106,"_29729":69055,"_20626":114917,"_5":14148,"_27027":114796,"_2882":114918},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3396":69107,"_29729":69055,"_20626":114920,"_5":14148,"_27027":114800,"_2882":114921},[],"Antes de pasar a producción, revisa:",{"_3396":69108,"_29729":69055,"_20626":114923,"_5":14148,"_27027":114800,"_2882":114924},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3396":69109,"_29729":69055,"_20626":114926,"_5":14148,"_27027":114800,"_2882":114927},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3396":69110,"_29729":69055,"_20626":114929,"_5":14148,"_27027":114800,"_2882":114930},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3396":69111,"_29729":69055,"_20626":114932,"_5":14148,"_27027":114800,"_2882":114933},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3396":69112,"_29729":69055,"_20626":114935,"_5":14148,"_27027":114800,"_2882":114936},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3396":69113,"_29729":69055,"_20626":114938,"_5":14148,"_27027":114800,"_2882":114939},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3396":69114,"_29729":69055,"_20626":114941,"_5":14148,"_27027":114800,"_2882":114942},[],"SMTP, observabilidad y entrega de alertas",{"_3396":69115,"_29729":69055,"_20626":114944,"_5":14148,"_27027":114800,"_2882":114945},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3396":69116,"_29729":69055,"_20626":114947,"_5":14148,"_27027":114800,"_2882":114948},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3396":69117,"_29729":69117,"_5":14500,"_2882":114950,"_30082":114951,"_20626":114952,"_27027":69117},"Expón el Gateway",[48429,114179,114413],[],{"_3396":69118,"_29729":69117,"_20626":114954,"_5":14148,"_27027":69117,"_2882":114955},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3396":69119,"_29729":69117,"_5":30079,"_20626":114957,"_27027":114958,"_2882":114959},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3396":69120,"_29729":69117,"_5":30079,"_20626":114961,"_27027":114962,"_2882":114963},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3396":69121,"_29729":69117,"_5":30079,"_20626":114965,"_27027":114966,"_2882":114967},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3396":69122,"_29729":69117,"_5":30079,"_20626":114969,"_27027":114970,"_2882":49255},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/networking#k3s",{"_3396":69123,"_29729":69117,"_5":30079,"_20626":114972,"_27027":114973,"_2882":114974},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3396":69124,"_29729":69117,"_5":30079,"_20626":114976,"_27027":114977,"_2882":114978},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3396":69125,"_29729":69117,"_5":30079,"_20626":114980,"_27027":114981,"_2882":114982},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3396":69126,"_29729":69117,"_5":30079,"_20626":114984,"_27027":114985,"_2882":114986},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3396":69127,"_29729":69117,"_5":30079,"_20626":114988,"_27027":114989,"_2882":114990},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3396":69128,"_29729":69117,"_5":30079,"_20626":114992,"_27027":114993,"_2882":114994},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3396":69129,"_29729":69117,"_20626":114996,"_5":14148,"_27027":114958,"_2882":114997},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3396":69130,"_29729":69117,"_20626":114999,"_5":14148,"_27027":114958,"_2882":115000},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3396":69131,"_29729":69117,"_20626":115002,"_5":14148,"_27027":114962,"_2882":115003},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3396":69132,"_29729":69117,"_20626":115005,"_5":14148,"_27027":114962,"_2882":115006},[],"Defínelo únicamente cuando:",{"_3396":69133,"_29729":69117,"_20626":115008,"_5":14148,"_27027":114962,"_2882":115009},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3396":69134,"_29729":69117,"_20626":115011,"_5":14148,"_27027":114962,"_2882":115012},[],"esa dirección está asignada a este Gateway",{"_3396":69135,"_29729":69117,"_20626":115014,"_5":14148,"_27027":114962,"_2882":115015},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3396":69136,"_29729":69117,"_20626":115017,"_5":14148,"_27027":114962,"_2882":115018},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3396":69137,"_29729":69117,"_20626":115020,"_5":14148,"_27027":114962,"_2882":115021},[],"No confundas estos valores:",{"_3396":69138,"_29729":69117,"_20626":115023,"_5":14148,"_27027":114962,"_2882":115024},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3396":69139,"_29729":69117,"_20626":115026,"_5":14148,"_27027":114962,"_2882":115027},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3396":69140,"_29729":69117,"_20626":115029,"_5":14148,"_27027":114962,"_2882":115030},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3396":69141,"_29729":69117,"_20626":115032,"_5":14148,"_27027":114966,"_2882":115033},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3396":69142,"_29729":69117,"_20626":115035,"_5":14148,"_27027":114966,"_2882":115036},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3396":69143,"_29729":69117,"_20626":115038,"_5":14148,"_27027":114970,"_2882":115039},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3396":69144,"_29729":69117,"_20626":115041,"_5":14148,"_27027":114970,"_2882":115042},[],"Para el diseño recomendado:",{"_3396":69145,"_29729":69117,"_20626":115044,"_5":14148,"_27027":114970,"_2882":115045},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3396":69146,"_29729":69117,"_20626":115047,"_5":14148,"_27027":114970,"_2882":115048},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3396":69147,"_29729":69117,"_20626":115050,"_5":14148,"_27027":114970,"_2882":115051},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3396":69148,"_29729":69117,"_20626":115053,"_5":14148,"_27027":114970,"_2882":115054},[],"Apunta DNS a la dirección accesible de la VM.",{"_3396":69149,"_29729":69117,"_20626":115056,"_5":14148,"_27027":114970,"_2882":115057},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3396":69150,"_29729":69117,"_20626":115059,"_5":14148,"_27027":114973,"_2882":115060},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3396":69151,"_29729":69117,"_20626":115062,"_5":14148,"_27027":114977,"_2882":115063},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3396":69152,"_29729":69117,"_20626":115065,"_5":14148,"_27027":114977,"_2882":115066},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3396":69153,"_29729":69117,"_20626":115068,"_5":14148,"_27027":114981,"_2882":115069},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3396":69154,"_29729":69117,"_20626":115071,"_5":14148,"_27027":114981,"_2882":115072},[],"Requisito",{"_3396":69155,"_29729":69117,"_20626":115074,"_5":14148,"_27027":114981,"_2882":115075},[],"Diseño recomendado",{"_3396":69156,"_29729":69117,"_20626":115077,"_5":14148,"_27027":114981,"_2882":115078},[],"Consecuencia",{"_3396":69157,"_29729":69117,"_20626":115080,"_5":14148,"_27027":114981,"_2882":115081},[],"Varias URL o servicios de Lamassu",{"_3396":69158,"_29729":69117,"_20626":115083,"_5":14148,"_27027":114981,"_2882":115084},[],"Un Gateway con varias rutas",{"_3396":69159,"_29729":69117,"_20626":115086,"_5":14148,"_27027":114981,"_2882":115087},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3396":69160,"_29729":69117,"_20626":115089,"_5":14148,"_27027":114981,"_2882":115090},[],"Gateways independientes e IP externas distintas",{"_3396":69161,"_29729":69117,"_20626":115092,"_5":14148,"_27027":114981,"_2882":115093},[],"Una VIP por Gateway",{"_3396":69162,"_29729":69117,"_20626":115095,"_5":14148,"_27027":114981,"_2882":115096},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3396":69163,"_29729":69117,"_20626":115098,"_5":14148,"_27027":114981,"_2882":115099},[],"Gateways independientes, un nodo y una IP",{"_3396":69164,"_29729":69117,"_20626":115101,"_5":14148,"_27027":114981,"_2882":115102},[],"Puertos externos diferentes",{"_3396":69165,"_29729":69117,"_20626":115104,"_5":14148,"_27027":114981,"_2882":115105},[],"Los clientes deben indicar puertos no estándar",{"_3396":69166,"_29729":69117,"_20626":115107,"_5":14148,"_27027":114981,"_2882":115108},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3396":69167,"_29729":69117,"_20626":115110,"_5":14148,"_27027":114981,"_2882":115111},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3396":69168,"_29729":69117,"_20626":115113,"_5":14148,"_27027":114981,"_2882":115114},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3396":69169,"_29729":69117,"_20626":115116,"_5":14148,"_27027":114981,"_2882":115117},[],"Recursos Gateway separados pero proxy compartido",{"_3396":69170,"_29729":69117,"_20626":115119,"_5":14148,"_27027":114981,"_2882":115120},[],"Modo merged Gateway de Envoy",{"_3396":69171,"_29729":69117,"_20626":115122,"_5":14148,"_27027":114981,"_2882":115123},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3396":69172,"_29729":69117,"_20626":115125,"_5":14148,"_27027":114981,"_2882":115126},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3396":69173,"_29729":69117,"_20626":115128,"_5":14148,"_27027":114981,"_2882":115129},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3396":69174,"_29729":69117,"_20626":115131,"_5":14148,"_27027":114981,"_2882":115132},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3396":69175,"_29729":69117,"_20626":115134,"_5":14148,"_27027":114981,"_2882":115135},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3396":69176,"_29729":69117,"_20626":115137,"_5":14148,"_27027":114985,"_2882":115138},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3396":69177,"_29729":69117,"_20626":115140,"_5":14148,"_27027":114985,"_2882":115141},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3396":69178,"_29729":69117,"_20626":115143,"_5":14148,"_27027":114985,"_2882":115144},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3396":69179,"_29729":69117,"_20626":115146,"_5":14148,"_27027":114985,"_2882":115147},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3396":69180,"_29729":69117,"_20626":115149,"_5":14148,"_27027":114985,"_2882":115150},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3396":69181,"_29729":69117,"_20626":115152,"_5":14148,"_27027":114989,"_2882":115153},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3396":69182,"_29729":69117,"_20626":115155,"_5":14148,"_27027":114989,"_2882":115156},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3396":69183,"_29729":69117,"_20626":115158,"_5":14148,"_27027":114993,"_2882":115159},[],"Comprueba, en orden:",{"_3396":69184,"_29729":69117,"_20626":115161,"_5":14148,"_27027":114993,"_2882":115162},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3396":69185,"_29729":69117,"_20626":115164,"_5":14148,"_27027":114993,"_2882":115165},[],"Su estado contiene la dirección esperada.",{"_3396":69186,"_29729":69117,"_20626":115167,"_5":14148,"_27027":114993,"_2882":115168},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3396":69187,"_29729":69117,"_20626":115170,"_5":14148,"_27027":114993,"_2882":115171},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3396":69188,"_29729":69117,"_20626":115173,"_5":14148,"_27027":114993,"_2882":115174},[],"DNS resuelve al endpoint accesible externamente.",{"_3396":69189,"_29729":69117,"_20626":115176,"_5":14148,"_27027":114993,"_2882":115177},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3396":69190,"_29729":69117,"_20626":115179,"_5":14148,"_27027":114993,"_2882":115180},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3396":69191,"_29729":69191,"_5":14500,"_2882":48536,"_30082":115182,"_20626":115183,"_27027":69191},[48429,114179,114413],[],{"_3396":69192,"_29729":69191,"_20626":115185,"_5":14148,"_27027":69191,"_2882":115186},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3396":69193,"_29729":69191,"_5":30079,"_20626":115188,"_27027":115189,"_2882":115190},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3396":69194,"_29729":69191,"_5":30079,"_20626":115192,"_27027":115193,"_2882":115194},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3396":69195,"_29729":69191,"_5":30079,"_20626":115196,"_27027":115197,"_2882":115198},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3396":69196,"_29729":69191,"_5":30079,"_20626":115200,"_27027":115201,"_2882":115202},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3396":69197,"_29729":69191,"_5":30079,"_20626":115204,"_27027":115205,"_2882":115206},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3396":69198,"_29729":69191,"_5":30079,"_20626":115208,"_27027":115209,"_2882":115210},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3396":69199,"_29729":69191,"_20626":115212,"_5":14148,"_27027":115189,"_2882":115213},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3396":69200,"_29729":69191,"_20626":115215,"_5":14148,"_27027":115193,"_2882":115216},[],"Flujo",{"_3396":69201,"_29729":69191,"_20626":115218,"_5":14148,"_27027":115193,"_2882":115219},[],"Úsalo para",{"_3396":69202,"_29729":69191,"_20626":115221,"_5":14148,"_27027":115193,"_2882":115222},[],"Qué instala",{"_3396":69203,"_29729":69191,"_20626":115224,"_5":14148,"_27027":115193,"_2882":49510},[],{"_3396":69204,"_29729":69191,"_20626":115226,"_5":14148,"_27027":115193,"_2882":115227},[],"Producción y entornos controlados",{"_3396":69205,"_29729":69191,"_20626":115229,"_5":14148,"_27027":115193,"_2882":115230},[],"Servicios de Lamassu y recursos de Gateway API",{"_3396":69206,"_29729":69191,"_20626":115232,"_5":14148,"_27027":115193,"_2882":48673},[],{"_3396":69207,"_29729":69191,"_20626":115234,"_5":14148,"_27027":115193,"_2882":115235},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3396":69208,"_29729":69191,"_20626":115237,"_5":14148,"_27027":115193,"_2882":115238},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3396":69209,"_29729":69191,"_20626":115240,"_5":14148,"_27027":115197,"_2882":115241},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3396":69210,"_29729":69191,"_20626":115243,"_5":14148,"_27027":115197,"_2882":115244},[],"Área",{"_3396":69211,"_29729":69191,"_20626":115246,"_5":14148,"_27027":115197,"_2882":115247},[],"El chart de Lamassu proporciona",{"_3396":69212,"_29729":69191,"_20626":115249,"_5":14148,"_27027":115197,"_2882":115250},[],"Tú proporcionas",{"_3396":69213,"_29729":69191,"_20626":115252,"_5":14148,"_27027":115197,"_2882":115253},[],"Aplicaciones Lamassu",{"_3396":69214,"_29729":69191,"_20626":115255,"_5":14148,"_27027":115197,"_2882":115256},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3396":69215,"_29729":69191,"_20626":115258,"_5":14148,"_27027":115197,"_2882":115259},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3396":69216,"_29729":69191,"_20626":115261,"_5":14148,"_27027":115197,"_2882":115262},[],"Datos PostgreSQL",{"_3396":69217,"_29729":69191,"_20626":115264,"_5":14148,"_27027":115197,"_2882":115265},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3396":69218,"_29729":69191,"_20626":115267,"_5":14148,"_27027":115197,"_2882":115268},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3396":69219,"_29729":69191,"_20626":115270,"_5":14148,"_27027":115197,"_2882":115271},[],"Mensajería",{"_3396":69220,"_29729":69191,"_20626":115273,"_5":14148,"_27027":115197,"_2882":115274},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3396":69221,"_29729":69191,"_20626":115276,"_5":14148,"_27027":115197,"_2882":115277},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3396":69222,"_29729":69191,"_20626":115279,"_5":14148,"_27027":115197,"_2882":115280},[],"Identidad",{"_3396":69223,"_29729":69191,"_20626":115282,"_5":14148,"_27027":115197,"_2882":115283},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3396":69224,"_29729":69191,"_20626":115285,"_5":14148,"_27027":115197,"_2882":115286},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3396":69225,"_29729":69191,"_20626":115288,"_5":14148,"_27027":115197,"_2882":115289},[],"Enrutamiento externo",{"_3396":69226,"_29729":69191,"_20626":115291,"_5":14148,"_27027":115197,"_2882":115292},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3396":69227,"_29729":69191,"_20626":115294,"_5":14148,"_27027":115197,"_2882":115295},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3396":69228,"_29729":69191,"_20626":115297,"_5":14148,"_27027":115197,"_2882":49584},[],{"_3396":69229,"_29729":69191,"_20626":115299,"_5":14148,"_27027":115197,"_2882":115300},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3396":69230,"_29729":69191,"_20626":115302,"_5":14148,"_27027":115197,"_2882":115303},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3396":69231,"_29729":69191,"_20626":115305,"_5":14148,"_27027":115197,"_2882":115306},[],"Datos persistentes de la aplicación",{"_3396":69232,"_29729":69191,"_20626":115308,"_5":14148,"_27027":115197,"_2882":115309},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3396":69233,"_29729":69191,"_20626":115311,"_5":14148,"_27027":115197,"_2882":115312},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3396":69234,"_29729":69191,"_20626":115314,"_5":14148,"_27027":115197,"_2882":115315},[],"Integraciones opcionales",{"_3396":69235,"_29729":69191,"_20626":115317,"_5":14148,"_27027":115197,"_2882":115318},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3396":69236,"_29729":69191,"_20626":115320,"_5":14148,"_27027":115197,"_2882":115321},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3396":69237,"_29729":69191,"_20626":115323,"_5":14148,"_27027":115197,"_2882":115324},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3396":69238,"_29729":69191,"_20626":115326,"_5":14148,"_27027":115197,"_2882":115327},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3396":69239,"_29729":69191,"_20626":115329,"_5":14148,"_27027":115201,"_2882":115330},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3396":69240,"_29729":69191,"_20626":115332,"_5":14148,"_27027":115201,"_2882":115333},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3396":69241,"_29729":69191,"_20626":115335,"_5":14148,"_27027":115205,"_2882":115336},[],"Kubernetes 1.24 o posterior",{"_3396":69242,"_29729":69191,"_20626":115338,"_5":14148,"_27027":115205,"_2882":115339},[],"Helm 3.2 o posterior",{"_3396":69243,"_29729":69191,"_20626":115341,"_5":14148,"_27027":115205,"_2882":115342},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3396":69244,"_29729":69191,"_20626":115344,"_5":14148,"_27027":115205,"_2882":115345},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3396":69245,"_29729":69191,"_20626":115347,"_5":14148,"_27027":115205,"_2882":115348},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3396":69246,"_29729":69191,"_20626":115350,"_5":14148,"_27027":115205,"_2882":115351},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3396":69247,"_29729":69191,"_20626":115353,"_5":14148,"_27027":115205,"_2882":115354},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3396":69248,"_29729":69191,"_20626":115356,"_5":14148,"_27027":115209,"_2882":115357},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3396":69249,"_29729":69191,"_20626":115359,"_5":14148,"_27027":115209,"_2882":115360},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3396":69250,"_29729":69191,"_20626":115362,"_5":14148,"_27027":115209,"_2882":115363},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3396":69251,"_29729":69191,"_20626":115365,"_5":14148,"_27027":115209,"_2882":115366},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3396":69252,"_29729":69252,"_5":14500,"_2882":115368,"_30082":115369,"_20626":115371,"_27027":69252},"Resolución de problemas de despliegue",[48429,114179,115370],"Operación",[],{"_3396":69253,"_29729":69252,"_20626":115373,"_5":14148,"_27027":69252,"_2882":115374},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3396":69254,"_29729":69252,"_5":30079,"_20626":115376,"_27027":115377,"_2882":115378},[],"/docs/pr-preview/pr-57/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3396":69255,"_29729":69252,"_5":30079,"_20626":115380,"_27027":115381,"_2882":115382},[],"/docs/pr-preview/pr-57/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3396":69256,"_29729":69252,"_5":30079,"_20626":115384,"_27027":115385,"_2882":115386},[],"/docs/pr-preview/pr-57/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3396":69257,"_29729":69252,"_5":30079,"_20626":115388,"_27027":115389,"_2882":115390},[],"/docs/pr-preview/pr-57/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3396":69258,"_29729":69252,"_5":30079,"_20626":115392,"_27027":115393,"_2882":115394},[],"/docs/pr-preview/pr-57/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3396":69259,"_29729":69252,"_5":30079,"_20626":115396,"_27027":115397,"_2882":115398},[],"/docs/pr-preview/pr-57/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3396":69260,"_29729":69252,"_5":30079,"_20626":115400,"_27027":115401,"_2882":115402},[],"/docs/pr-preview/pr-57/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3396":69261,"_29729":69252,"_5":30079,"_20626":115404,"_27027":115405,"_2882":115406},[],"/docs/pr-preview/pr-57/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3396":69262,"_29729":69252,"_5":30079,"_20626":115408,"_27027":115409,"_2882":115410},[],"/docs/pr-preview/pr-57/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3396":69263,"_29729":69252,"_5":30079,"_20626":115412,"_27027":115413,"_2882":115414},[],"/docs/pr-preview/pr-57/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3396":69264,"_29729":69252,"_5":30079,"_20626":115416,"_27027":115417,"_2882":115418},[],"/docs/pr-preview/pr-57/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3396":69265,"_29729":69252,"_5":30079,"_20626":115420,"_27027":115421,"_2882":115422},[],"/docs/pr-preview/pr-57/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3396":69266,"_29729":69252,"_5":30079,"_20626":115424,"_27027":115425,"_2882":115426},[],"/docs/pr-preview/pr-57/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3396":69267,"_29729":69252,"_20626":115428,"_5":14148,"_27027":69252,"_2882":115429},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3396":69268,"_29729":69252,"_20626":115431,"_5":14148,"_27027":115381,"_2882":115432},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3396":69269,"_29729":69252,"_20626":115434,"_5":14148,"_27027":115385,"_2882":115435},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3396":69270,"_29729":69252,"_20626":115437,"_5":14148,"_27027":115389,"_2882":115438},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3396":69271,"_29729":69252,"_20626":115440,"_5":14148,"_27027":115393,"_2882":115441},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3396":69272,"_29729":69252,"_20626":115443,"_5":14148,"_27027":115397,"_2882":115444},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3396":69273,"_29729":69252,"_20626":115446,"_5":14148,"_27027":115401,"_2882":115447},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3396":69274,"_29729":69252,"_20626":115449,"_5":14148,"_27027":115401,"_2882":115450},[],"Ejecuta también la prueba de conectividad del chart:",{"_3396":69275,"_29729":69252,"_20626":115452,"_5":14148,"_27027":115401,"_2882":115453},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3396":69276,"_29729":69252,"_20626":115455,"_5":14148,"_27027":115401,"_2882":115456},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3396":69277,"_29729":69252,"_20626":115458,"_5":14148,"_27027":115405,"_2882":115459},[],"Si recibes un 401:",{"_3396":69278,"_29729":69252,"_20626":115461,"_5":14148,"_27027":115405,"_2882":115462},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3396":69279,"_29729":69252,"_20626":115464,"_5":14148,"_27027":115405,"_2882":115465},[],"verifica emisor, audiencia y expiración del token;",{"_3396":69280,"_29729":69252,"_20626":115467,"_5":14148,"_27027":115405,"_2882":115468},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3396":69281,"_29729":69252,"_20626":115470,"_5":14148,"_27027":115405,"_2882":115471},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3396":69282,"_29729":69252,"_20626":115473,"_5":14148,"_27027":115405,"_2882":115474},[],"Si el login termina pero las APIs devuelven 403:",{"_3396":69283,"_29729":69252,"_20626":115476,"_5":14148,"_27027":115405,"_2882":115477},[],"inspecciona los claims reales del token;",{"_3396":69284,"_29729":69252,"_20626":115479,"_5":14148,"_27027":115405,"_2882":115480},[],"confirma que coinciden con un principal activo;",{"_3396":69285,"_29729":69252,"_20626":115482,"_5":14148,"_27027":115405,"_2882":115483},[],"revisa las políticas concedidas al principal;",{"_3396":69286,"_29729":69252,"_20626":115485,"_5":14148,"_27027":115405,"_2882":115486},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3396":69287,"_29729":69252,"_20626":115488,"_5":14148,"_27027":115405,"_2882":115489},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3396":69288,"_29729":69252,"_20626":115491,"_5":14148,"_27027":115409,"_2882":115492},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3396":69289,"_29729":69252,"_20626":115494,"_5":14148,"_27027":115409,"_2882":115495},[],"Localiza el pod y Service de authz.",{"_3396":69290,"_29729":69252,"_20626":115497,"_5":14148,"_27027":115409,"_2882":115498},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3396":69291,"_29729":69252,"_20626":115500,"_5":14148,"_27027":115409,"_2882":115501},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3396":69292,"_29729":69252,"_20626":115503,"_5":14148,"_27027":115409,"_2882":115504},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3396":69293,"_29729":69252,"_20626":115506,"_5":14148,"_27027":115409,"_2882":115507},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3396":69294,"_29729":69252,"_20626":115509,"_5":14148,"_27027":115413,"_2882":115510},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3396":69295,"_29729":69252,"_20626":115512,"_5":14148,"_27027":115417,"_2882":115513},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3396":69296,"_29729":69252,"_20626":115515,"_5":14148,"_27027":115417,"_2882":115516},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3396":69297,"_29729":69252,"_20626":115518,"_5":14148,"_27027":115417,"_2882":115519},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3396":69298,"_29729":69252,"_20626":115521,"_5":14148,"_27027":115417,"_2882":115522},[],"volumen persistente sin enlazar;",{"_3396":69299,"_29729":69252,"_20626":115524,"_5":14148,"_27027":115417,"_2882":115525},[],"imagen inaccesible o política de pull incorrecta;",{"_3396":69300,"_29729":69252,"_20626":115527,"_5":14148,"_27027":115417,"_2882":115528},[],"configuración inválida del motor criptográfico;",{"_3396":69301,"_29729":69252,"_20626":115530,"_5":14148,"_27027":115417,"_2882":115531},[],"límites de CPU o memoria demasiado bajos;",{"_3396":69302,"_29729":69252,"_20626":115533,"_5":14148,"_27027":115417,"_2882":115534},[],"migración previa incompleta.",{"_3396":69303,"_29729":69252,"_20626":115536,"_5":14148,"_27027":115417,"_2882":115537},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3396":69304,"_29729":69252,"_20626":115539,"_5":14148,"_27027":115417,"_2882":115540},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3396":69305,"_29729":69252,"_20626":115542,"_5":14148,"_27027":115417,"_2882":115543},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3396":69306,"_29729":69252,"_20626":115545,"_5":14148,"_27027":115421,"_2882":115546},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3396":69307,"_29729":69252,"_20626":115548,"_5":14148,"_27027":115421,"_2882":115549},[],"verifica que esté habilitado en el servicio emisor;",{"_3396":69308,"_29729":69252,"_20626":115551,"_5":14148,"_27027":115421,"_2882":115552},[],"comprueba conectividad y credenciales AMQP;",{"_3396":69309,"_29729":69252,"_20626":115554,"_5":14148,"_27027":115421,"_2882":115555},[],"revisa exchange, routing key, colas y consumidores;",{"_3396":69310,"_29729":69252,"_20626":115557,"_5":14148,"_27027":115421,"_2882":115558},[],"inspecciona dead-letter queues;",{"_3396":69311,"_29729":69252,"_20626":115560,"_5":14148,"_27027":115421,"_2882":115561},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3396":69312,"_29729":69252,"_20626":115563,"_5":14148,"_27027":115421,"_2882":115564},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3396":69313,"_29729":69252,"_20626":115566,"_5":14148,"_27027":115421,"_2882":115567},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3396":69314,"_29729":69252,"_20626":115569,"_5":14148,"_27027":115421,"_2882":115570},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3396":69315,"_29729":69252,"_20626":115572,"_5":14148,"_27027":115421,"_2882":115573},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3396":69316,"_29729":69252,"_20626":115575,"_5":14148,"_27027":115421,"_2882":115576},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3396":69317,"_29729":69252,"_20626":115578,"_5":14148,"_27027":115421,"_2882":115579},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3396":69318,"_29729":69252,"_20626":115581,"_5":14148,"_27027":115421,"_2882":115582},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3396":69319,"_29729":69252,"_20626":115584,"_5":14148,"_27027":115425,"_2882":115585},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3396":69320,"_29729":69252,"_20626":115587,"_5":14148,"_27027":115425,"_2882":115588},[],"Antes de cerrar una incidencia, guarda:",{"_3396":69321,"_29729":69252,"_20626":115590,"_5":14148,"_27027":115425,"_2882":115591},[],"causa confirmada;",{"_3396":69322,"_29729":69252,"_20626":115593,"_5":14148,"_27027":115425,"_2882":115594},[],"alcance temporal y recursos afectados;",{"_3396":69323,"_29729":69252,"_20626":115596,"_5":14148,"_27027":115425,"_2882":115597},[],"comandos o consultas utilizados;",{"_3396":69324,"_29729":69252,"_20626":115599,"_5":14148,"_27027":115425,"_2882":115600},[],"cambio aplicado y forma de revertirlo;",{"_3396":69325,"_29729":69252,"_20626":115602,"_5":14148,"_27027":115425,"_2882":115603},[],"validación desde un consumidor;",{"_3396":69326,"_29729":69252,"_20626":115605,"_5":14148,"_27027":115425,"_2882":115606},[],"acción preventiva y propietario.",{"_3396":69327,"_29729":69327,"_5":14500,"_2882":115608,"_30082":115609,"_20626":115612,"_27027":69327},"Control de acceso",[48429,115610,115611],"Plataforma","Administración",[],{"_3396":69328,"_29729":69327,"_20626":115614,"_5":14148,"_27027":69327,"_2882":115615},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3396":69329,"_29729":69327,"_5":30079,"_20626":115617,"_27027":115618,"_2882":115619},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3396":69330,"_29729":69327,"_5":30079,"_20626":115621,"_27027":115622,"_2882":115623},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3396":69331,"_29729":69327,"_5":30079,"_20626":115625,"_27027":115626,"_2882":115627},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3396":69332,"_29729":69327,"_5":30079,"_20626":115629,"_27027":115630,"_2882":115631},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3396":69333,"_29729":69327,"_5":30079,"_20626":115633,"_27027":115634,"_2882":115635},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3396":69334,"_29729":69327,"_5":30079,"_20626":115637,"_27027":115638,"_2882":115639},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3396":69335,"_29729":69327,"_5":30079,"_20626":115641,"_27027":115642,"_2882":115643},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3396":69336,"_29729":69327,"_5":30079,"_20626":115645,"_27027":115646,"_2882":115647},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3396":69337,"_29729":69327,"_5":30079,"_20626":115649,"_27027":115650,"_2882":115651},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3396":69338,"_29729":69327,"_5":30079,"_20626":115653,"_27027":115654,"_2882":115655},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3396":69339,"_29729":69327,"_5":30079,"_20626":115657,"_27027":115658,"_2882":115659},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3396":69340,"_29729":69327,"_5":30079,"_20626":115661,"_27027":115662,"_2882":115663},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3396":69341,"_29729":69327,"_5":30079,"_20626":115665,"_27027":115666,"_2882":115667},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3396":69342,"_29729":69327,"_5":30079,"_20626":115669,"_27027":115670,"_2882":115671},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3396":69343,"_29729":69327,"_5":30079,"_20626":115673,"_27027":115674,"_2882":115675},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3396":69344,"_29729":69327,"_5":30079,"_20626":115677,"_27027":115678,"_2882":114785},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3396":69345,"_29729":69327,"_5":30079,"_20626":115680,"_27027":115681,"_2882":115682},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3396":69346,"_29729":69327,"_5":30079,"_20626":115684,"_27027":115685,"_2882":115686},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3396":69347,"_29729":69327,"_5":30079,"_20626":115688,"_27027":115689,"_2882":115690},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3396":69348,"_29729":69327,"_5":30079,"_20626":115692,"_27027":115693,"_2882":115694},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3396":69349,"_29729":69327,"_5":30079,"_20626":115696,"_27027":115697,"_2882":115698},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3396":69350,"_29729":69327,"_5":30079,"_20626":115700,"_27027":115701,"_2882":115702},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3396":69351,"_29729":69327,"_5":30079,"_20626":115704,"_27027":115705,"_2882":115706},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3396":69352,"_29729":69327,"_5":30079,"_20626":115708,"_27027":115709,"_2882":115710},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3396":69353,"_29729":69327,"_5":30079,"_20626":115712,"_27027":115713,"_2882":115714},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3396":69354,"_29729":69327,"_5":30079,"_20626":115716,"_27027":115717,"_2882":115718},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3396":69355,"_29729":69327,"_5":30079,"_20626":115720,"_27027":115721,"_2882":115722},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3396":69356,"_29729":69327,"_5":30079,"_20626":115724,"_27027":115725,"_2882":115726},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3396":69357,"_29729":69327,"_5":30079,"_20626":115728,"_27027":115729,"_2882":115730},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3396":69358,"_29729":69327,"_5":30079,"_20626":115732,"_27027":115733,"_2882":115734},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3396":69359,"_29729":69327,"_5":30079,"_20626":115736,"_27027":115737,"_2882":115738},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3396":69360,"_29729":69327,"_20626":115740,"_5":14148,"_27027":69327,"_2882":115741},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3396":69361,"_29729":69327,"_20626":115743,"_5":14148,"_27027":69327,"_2882":115744},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3396":69362,"_29729":69327,"_20626":115746,"_5":14148,"_27027":69327,"_2882":115747},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3396":69363,"_29729":69327,"_20626":115749,"_5":14148,"_27027":115618,"_2882":115750},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3396":69364,"_29729":69327,"_20626":115752,"_5":14148,"_27027":115618,"_2882":115753},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3396":69365,"_29729":69327,"_20626":115755,"_5":14148,"_27027":115618,"_2882":115756},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3396":69366,"_29729":69327,"_20626":115758,"_5":14148,"_27027":115618,"_2882":115759},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3396":69367,"_29729":69327,"_20626":115761,"_5":14148,"_27027":115618,"_2882":115762},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3396":69368,"_29729":69327,"_20626":115764,"_5":14148,"_27027":115618,"_2882":115765},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3396":69369,"_29729":69327,"_20626":115767,"_5":14148,"_27027":115622,"_2882":115768},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3396":69370,"_29729":69327,"_20626":115770,"_5":14148,"_27027":115622,"_2882":115771},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3396":69371,"_29729":69327,"_20626":115773,"_5":14148,"_27027":115626,"_2882":115774},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3396":69372,"_29729":69327,"_20626":115776,"_5":14148,"_27027":115626,"_2882":115777},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3396":69373,"_29729":69327,"_20626":115779,"_5":14148,"_27027":115626,"_2882":115780},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3396":69374,"_29729":69327,"_20626":115782,"_5":14148,"_27027":115626,"_2882":115783},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3396":69375,"_29729":69327,"_20626":115785,"_5":14148,"_27027":115626,"_2882":115786},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3396":69376,"_29729":69327,"_20626":115788,"_5":14148,"_27027":115626,"_2882":115789},[],"Carga por separado las políticas concedidas a cada principal.",{"_3396":69377,"_29729":69327,"_20626":115791,"_5":14148,"_27027":115626,"_2882":115792},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3396":69378,"_29729":69327,"_20626":115794,"_5":14148,"_27027":115626,"_2882":115795},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3396":69379,"_29729":69327,"_20626":115797,"_5":14148,"_27027":115626,"_2882":115798},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3396":69380,"_29729":69327,"_20626":115800,"_5":14148,"_27027":115626,"_2882":115801},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3396":69381,"_29729":69327,"_20626":115803,"_5":14148,"_27027":115626,"_2882":115804},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3396":69382,"_29729":69327,"_20626":115806,"_5":14148,"_27027":115626,"_2882":115807},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3396":69383,"_29729":69327,"_20626":115809,"_5":14148,"_27027":115630,"_2882":115810},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3396":69384,"_29729":69327,"_20626":115812,"_5":14148,"_27027":115630,"_2882":115813},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3396":69385,"_29729":69327,"_20626":115815,"_5":14148,"_27027":115630,"_2882":115816},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3396":69386,"_29729":69327,"_20626":115818,"_5":14148,"_27027":115630,"_2882":115819},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3396":69387,"_29729":69327,"_20626":115821,"_5":14148,"_27027":115630,"_2882":115822},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3396":69388,"_29729":69327,"_20626":115824,"_5":14148,"_27027":115630,"_2882":115825},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3396":69389,"_29729":69327,"_20626":115827,"_5":14148,"_27027":115630,"_2882":115828},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3396":69390,"_29729":69327,"_20626":115830,"_5":14148,"_27027":115630,"_2882":115831},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3396":69391,"_29729":69327,"_20626":115833,"_5":14148,"_27027":115634,"_2882":115834},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3396":69392,"_29729":69327,"_20626":115836,"_5":14148,"_27027":115634,"_2882":115837},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3396":69393,"_29729":69327,"_20626":115839,"_5":14148,"_27027":115634,"_2882":115840},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3396":69394,"_29729":69327,"_20626":115842,"_5":14148,"_27027":115634,"_2882":115843},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3396":69395,"_29729":69327,"_20626":115845,"_5":14148,"_27027":115634,"_2882":115846},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3396":69396,"_29729":69327,"_20626":115848,"_5":14148,"_27027":115634,"_2882":115849},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3396":69397,"_29729":69327,"_20626":115851,"_5":14148,"_27027":115634,"_2882":115852},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3396":69398,"_29729":69327,"_20626":115854,"_5":14148,"_27027":115634,"_2882":115855},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3396":69399,"_29729":69327,"_20626":115857,"_5":14148,"_27027":115634,"_2882":115858},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3396":69400,"_29729":69327,"_20626":115860,"_5":14148,"_27027":115634,"_2882":115861},[],"Las acciones se dividen en dos grupos:",{"_3396":69401,"_29729":69327,"_20626":115863,"_5":14148,"_27027":115634,"_2882":115864},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3396":69402,"_29729":69327,"_20626":115866,"_5":14148,"_27027":115634,"_2882":115867},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3396":69403,"_29729":69327,"_20626":115869,"_5":14148,"_27027":115634,"_2882":115870},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3396":69404,"_29729":69327,"_20626":115872,"_5":14148,"_27027":115638,"_2882":115873},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3396":69405,"_29729":69327,"_20626":115875,"_5":14148,"_27027":115638,"_2882":115876},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3396":69406,"_29729":69327,"_20626":115878,"_5":14148,"_27027":115638,"_2882":115879},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3396":69407,"_29729":69327,"_20626":115881,"_5":14148,"_27027":115642,"_2882":115882},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3396":69408,"_29729":69327,"_20626":115884,"_5":14148,"_27027":115642,"_2882":115885},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3396":69409,"_29729":69327,"_20626":115887,"_5":14148,"_27027":115642,"_2882":115888},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3396":69410,"_29729":69327,"_20626":115890,"_5":14148,"_27027":115642,"_2882":115891},[],"Los operadores implementados son:",{"_3396":69411,"_29729":69327,"_20626":115893,"_5":14148,"_27027":115642,"_2882":115894},[],"`equals`, para igualdad exacta;",{"_3396":69412,"_29729":69327,"_20626":115896,"_5":14148,"_27027":115642,"_2882":115897},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3396":69413,"_29729":69327,"_20626":115899,"_5":14148,"_27027":115642,"_2882":115900},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3396":69414,"_29729":69327,"_20626":115902,"_5":14148,"_27027":115642,"_2882":115903},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3396":69415,"_29729":69327,"_20626":115905,"_5":14148,"_27027":115646,"_2882":115906},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3396":69416,"_29729":69327,"_20626":115908,"_5":14148,"_27027":115646,"_2882":115909},[],"Los modos disponibles son:",{"_3396":69417,"_29729":69327,"_20626":115911,"_5":14148,"_27027":115646,"_2882":115912},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3396":69418,"_29729":69327,"_20626":115914,"_5":14148,"_27027":115646,"_2882":115915},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3396":69419,"_29729":69327,"_20626":115917,"_5":14148,"_27027":115646,"_2882":115918},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3396":69420,"_29729":69327,"_20626":115920,"_5":14148,"_27027":115646,"_2882":115921},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3396":69421,"_29729":69327,"_20626":115923,"_5":14148,"_27027":115646,"_2882":115924},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3396":69422,"_29729":69327,"_20626":115926,"_5":14148,"_27027":115646,"_2882":115927},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3396":69423,"_29729":69327,"_20626":115929,"_5":14148,"_27027":115650,"_2882":115930},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3396":69424,"_29729":69327,"_20626":115932,"_5":14148,"_27027":115650,"_2882":115933},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3396":69425,"_29729":69327,"_20626":115935,"_5":14148,"_27027":115650,"_2882":115936},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3396":69426,"_29729":69327,"_20626":115938,"_5":14148,"_27027":115650,"_2882":115939},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3396":69427,"_29729":69327,"_20626":115941,"_5":14148,"_27027":115658,"_2882":115942},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3396":69428,"_29729":69327,"_20626":115944,"_5":14148,"_27027":115658,"_2882":115945},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3396":69429,"_29729":69327,"_20626":115947,"_5":14148,"_27027":115662,"_2882":115948},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3396":69430,"_29729":69327,"_20626":115950,"_5":14148,"_27027":115662,"_2882":115951},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3396":69431,"_29729":69327,"_20626":115953,"_5":14148,"_27027":115666,"_2882":115954},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3396":69432,"_29729":69327,"_20626":115956,"_5":14148,"_27027":115666,"_2882":115957},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3396":69433,"_29729":69327,"_20626":115959,"_5":14148,"_27027":115666,"_2882":115960},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3396":69434,"_29729":69327,"_20626":115962,"_5":14148,"_27027":115670,"_2882":115963},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3396":69435,"_29729":69327,"_20626":115965,"_5":14148,"_27027":115670,"_2882":115966},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3396":69436,"_29729":69327,"_20626":115968,"_5":14148,"_27027":115670,"_2882":115969},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3396":69437,"_29729":69327,"_20626":115971,"_5":14148,"_27027":115670,"_2882":115972},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3396":69438,"_29729":69327,"_20626":115974,"_5":14148,"_27027":115670,"_2882":115975},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3396":69439,"_29729":69327,"_20626":115977,"_5":14148,"_27027":115670,"_2882":115978},[],"Ten en cuenta que:",{"_3396":69440,"_29729":69327,"_20626":115980,"_5":14148,"_27027":115670,"_2882":115981},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3396":69441,"_29729":69327,"_20626":115983,"_5":14148,"_27027":115670,"_2882":115984},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3396":69442,"_29729":69327,"_20626":115986,"_5":14148,"_27027":115670,"_2882":115987},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3396":69443,"_29729":69327,"_20626":115989,"_5":14148,"_27027":115674,"_2882":115990},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3396":69444,"_29729":69327,"_20626":115992,"_5":14148,"_27027":115674,"_2882":115993},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3396":69445,"_29729":69327,"_20626":115995,"_5":14148,"_27027":115674,"_2882":115996},[],"acceso completo y de solo lectura a KMS;",{"_3396":69446,"_29729":69327,"_20626":115998,"_5":14148,"_27027":115674,"_2882":115999},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3396":69447,"_29729":69327,"_20626":116001,"_5":14148,"_27027":115674,"_2882":116002},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3396":69448,"_29729":69327,"_20626":116004,"_5":14148,"_27027":115674,"_2882":116005},[],"acceso a la interfaz;",{"_3396":69449,"_29729":69327,"_20626":116007,"_5":14148,"_27027":115674,"_2882":116008},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3396":69450,"_29729":69327,"_20626":116010,"_5":14148,"_27027":115674,"_2882":116011},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3396":69451,"_29729":69327,"_20626":116013,"_5":14148,"_27027":115674,"_2882":116014},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3396":69452,"_29729":69327,"_20626":116016,"_5":14148,"_27027":115678,"_2882":116017},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3396":69453,"_29729":69327,"_20626":116019,"_5":14148,"_27027":115678,"_2882":116020},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3396":69454,"_29729":69327,"_20626":116022,"_5":14148,"_27027":115678,"_2882":116023},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3396":69455,"_29729":69327,"_20626":116025,"_5":14148,"_27027":115681,"_2882":116026},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3396":69456,"_29729":69327,"_20626":116028,"_5":14148,"_27027":115685,"_2882":116029},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3396":69457,"_29729":69327,"_20626":116031,"_5":14148,"_27027":115685,"_2882":116032},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3396":69458,"_29729":69327,"_20626":116034,"_5":14148,"_27027":115689,"_2882":116035},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3396":69459,"_29729":69327,"_20626":116037,"_5":14148,"_27027":115693,"_2882":116038},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3396":69460,"_29729":69327,"_20626":116040,"_5":14148,"_27027":115697,"_2882":116041},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3396":69461,"_29729":69327,"_20626":116043,"_5":14148,"_27027":115701,"_2882":116044},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3396":69462,"_29729":69327,"_20626":116046,"_5":14148,"_27027":115701,"_2882":116047},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3396":69463,"_29729":69327,"_20626":116049,"_5":14148,"_27027":115705,"_2882":116050},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3396":69464,"_29729":69327,"_20626":116052,"_5":14148,"_27027":115705,"_2882":116053},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3396":69465,"_29729":69327,"_20626":116055,"_5":14148,"_27027":115705,"_2882":116056},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3396":69466,"_29729":69327,"_20626":116058,"_5":14148,"_27027":115705,"_2882":116059},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3396":69467,"_29729":69327,"_20626":116061,"_5":14148,"_27027":115705,"_2882":116062},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3396":69468,"_29729":69327,"_20626":116064,"_5":14148,"_27027":115705,"_2882":116065},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3396":69469,"_29729":69327,"_20626":116067,"_5":14148,"_27027":115705,"_2882":116068},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3396":69470,"_29729":69327,"_20626":116070,"_5":14148,"_27027":115705,"_2882":116071},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3396":69471,"_29729":69327,"_20626":116073,"_5":14148,"_27027":115709,"_2882":116074},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3396":69472,"_29729":69327,"_20626":116076,"_5":14148,"_27027":115709,"_2882":116077},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3396":69473,"_29729":69327,"_20626":116079,"_5":14148,"_27027":115709,"_2882":116080},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3396":69474,"_29729":69327,"_20626":116082,"_5":14148,"_27027":115713,"_2882":116083},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3396":69475,"_29729":69327,"_20626":116085,"_5":14148,"_27027":115713,"_2882":116086},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3396":69476,"_29729":69327,"_20626":116088,"_5":14148,"_27027":115713,"_2882":116089},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3396":69477,"_29729":69327,"_20626":116091,"_5":14148,"_27027":115713,"_2882":116092},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3396":69478,"_29729":69327,"_20626":116094,"_5":14148,"_27027":115713,"_2882":116095},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3396":69479,"_29729":69327,"_20626":116097,"_5":14148,"_27027":115713,"_2882":116098},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3396":69480,"_29729":69327,"_20626":116100,"_5":14148,"_27027":115713,"_2882":116101},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3396":69481,"_29729":69327,"_20626":116103,"_5":14148,"_27027":115713,"_2882":116104},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3396":69482,"_29729":69327,"_20626":116106,"_5":14148,"_27027":115721,"_2882":116107},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3396":69483,"_29729":69327,"_20626":116109,"_5":14148,"_27027":115725,"_2882":116110},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3396":69484,"_29729":69327,"_20626":116112,"_5":14148,"_27027":115725,"_2882":116113},[],"que exista un principal activo del tipo correcto;",{"_3396":69485,"_29729":69327,"_20626":116115,"_5":14148,"_27027":115725,"_2882":116116},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3396":69486,"_29729":69327,"_20626":116118,"_5":14148,"_27027":115725,"_2882":116119},[],"que todas las condiciones del principal se cumplan;",{"_3396":69487,"_29729":69327,"_20626":116121,"_5":14148,"_27027":115725,"_2882":116122},[],"que el principal tenga concedida la política esperada;",{"_3396":69488,"_29729":69327,"_20626":116124,"_5":14148,"_27027":115725,"_2882":116125},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3396":69489,"_29729":69327,"_20626":116127,"_5":14148,"_27027":115725,"_2882":116128},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3396":69490,"_29729":69327,"_20626":116130,"_5":14148,"_27027":115725,"_2882":116131},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3396":69491,"_29729":69327,"_20626":116133,"_5":14148,"_27027":115729,"_2882":116134},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3396":69492,"_29729":69327,"_20626":116136,"_5":14148,"_27027":115733,"_2882":116137},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3396":69493,"_29729":69327,"_20626":116139,"_5":14148,"_27027":115737,"_2882":116140},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3396":69494,"_29729":69327,"_20626":116142,"_5":14148,"_27027":115737,"_2882":116143},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3396":69495,"_29729":69495,"_5":14500,"_2882":116145,"_30082":116146,"_20626":116147,"_27027":69495},"Alertas y suscripciones",[48429,115610,115611],[],{"_3396":69496,"_29729":69495,"_20626":116149,"_5":14148,"_27027":69495,"_2882":116150},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3396":69497,"_29729":69495,"_5":30079,"_20626":116152,"_27027":116153,"_2882":116154},[],"/docs/pr-preview/pr-57/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3396":69498,"_29729":69495,"_5":30079,"_20626":116156,"_27027":116157,"_2882":116158},[],"/docs/pr-preview/pr-57/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3396":69499,"_29729":69495,"_5":30079,"_20626":116160,"_27027":116161,"_2882":116162},[],"/docs/pr-preview/pr-57/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3396":69500,"_29729":69495,"_5":30079,"_20626":116164,"_27027":116165,"_2882":116166},[],"/docs/pr-preview/pr-57/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3396":69501,"_29729":69495,"_5":30079,"_20626":116168,"_27027":116169,"_2882":116170},[],"/docs/pr-preview/pr-57/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3396":69502,"_29729":69495,"_5":30079,"_20626":116172,"_27027":116173,"_2882":116174},[],"/docs/pr-preview/pr-57/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3396":69503,"_29729":69495,"_5":30079,"_20626":116176,"_27027":116177,"_2882":116178},[],"/docs/pr-preview/pr-57/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3396":69504,"_29729":69495,"_5":30079,"_20626":116180,"_27027":116181,"_2882":116182},[],"/docs/pr-preview/pr-57/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3396":69505,"_29729":69495,"_5":30079,"_20626":116184,"_27027":116185,"_2882":116186},[],"/docs/pr-preview/pr-57/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3396":69506,"_29729":69495,"_5":30079,"_20626":116188,"_27027":116189,"_2882":116190},[],"/docs/pr-preview/pr-57/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3396":69507,"_29729":69495,"_5":30079,"_20626":116192,"_27027":116193,"_2882":116194},[],"/docs/pr-preview/pr-57/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3396":69508,"_29729":69495,"_20626":116196,"_5":14148,"_27027":69495,"_2882":116197},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3396":69509,"_29729":69495,"_20626":116199,"_5":14148,"_27027":116153,"_2882":116200},[],"Un servicio publica un evento de dominio.",{"_3396":69510,"_29729":69495,"_20626":116202,"_5":14148,"_27027":116153,"_2882":116203},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3396":69511,"_29729":69495,"_20626":116205,"_5":14148,"_27027":116153,"_2882":116206},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3396":69512,"_29729":69495,"_20626":116208,"_5":14148,"_27027":116153,"_2882":116209},[],"Lamassu entrega el evento al canal configurado.",{"_3396":69513,"_29729":69495,"_20626":116211,"_5":14148,"_27027":116153,"_2882":116212},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3396":69514,"_29729":69495,"_20626":116214,"_5":14148,"_27027":116157,"_2882":116215},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3396":69515,"_29729":69495,"_20626":116217,"_5":14148,"_27027":116157,"_2882":116218},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3396":69516,"_29729":69495,"_20626":116220,"_5":14148,"_27027":116157,"_2882":116221},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3396":69517,"_29729":69495,"_20626":116223,"_5":14148,"_27027":116157,"_2882":116224},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3396":69518,"_29729":69495,"_20626":116226,"_5":14148,"_27027":116157,"_2882":116227},[],"`apikey_options` necesita `header` y `key`.",{"_3396":69519,"_29729":69495,"_20626":116229,"_5":14148,"_27027":116157,"_2882":116230},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3396":69520,"_29729":69495,"_20626":116232,"_5":14148,"_27027":116157,"_2882":116233},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3396":69521,"_29729":69495,"_20626":116235,"_5":14148,"_27027":116157,"_2882":116236},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3396":69522,"_29729":69495,"_20626":116238,"_5":14148,"_27027":116165,"_2882":116239},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3396":69523,"_29729":69495,"_20626":116241,"_5":14148,"_27027":116169,"_2882":116242},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3396":69524,"_29729":69495,"_20626":116244,"_5":14148,"_27027":116173,"_2882":116245},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3396":69525,"_29729":69495,"_20626":116247,"_5":14148,"_27027":116173,"_2882":116248},[],"**None** notifica todas las instancias del evento.",{"_3396":69526,"_29729":69495,"_20626":116250,"_5":14148,"_27027":116173,"_2882":116251},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3396":69527,"_29729":69495,"_20626":116253,"_5":14148,"_27027":116173,"_2882":116254},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3396":69528,"_29729":69495,"_20626":116256,"_5":14148,"_27027":116173,"_2882":116257},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3396":69529,"_29729":69495,"_20626":116259,"_5":14148,"_27027":116173,"_2882":116260},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3396":69530,"_29729":69495,"_20626":116262,"_5":14148,"_27027":116173,"_2882":116263},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3396":69531,"_29729":69495,"_20626":116265,"_5":14148,"_27027":116177,"_2882":116266},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3396":69532,"_29729":69495,"_20626":116268,"_5":14148,"_27027":116181,"_2882":116269},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3396":69533,"_29729":69495,"_20626":116271,"_5":14148,"_27027":116181,"_2882":116272},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3396":69534,"_29729":69495,"_20626":116274,"_5":14148,"_27027":116181,"_2882":116275},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3396":69535,"_29729":69495,"_20626":116277,"_5":14148,"_27027":116181,"_2882":116278},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3396":69536,"_29729":69495,"_20626":116280,"_5":14148,"_27027":116181,"_2882":116281},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3396":69537,"_29729":69495,"_20626":116283,"_5":14148,"_27027":116181,"_2882":116284},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3396":69538,"_29729":69495,"_20626":116286,"_5":14148,"_27027":116181,"_2882":116287},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3396":69539,"_29729":69495,"_20626":116289,"_5":14148,"_27027":116181,"_2882":116290},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3396":69540,"_29729":69495,"_20626":116292,"_5":14148,"_27027":116185,"_2882":116293},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3396":69541,"_29729":69495,"_20626":116295,"_5":14148,"_27027":116185,"_2882":116296},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3396":69542,"_29729":69495,"_20626":116298,"_5":14148,"_27027":116185,"_2882":116299},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3396":69543,"_29729":69495,"_20626":116301,"_5":14148,"_27027":116185,"_2882":116302},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3396":69544,"_29729":69495,"_20626":116304,"_5":14148,"_27027":116185,"_2882":116305},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3396":69545,"_29729":69495,"_20626":116307,"_5":14148,"_27027":116185,"_2882":116308},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3396":69546,"_29729":69495,"_20626":116310,"_5":14148,"_27027":116185,"_2882":116311},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3396":69547,"_29729":69495,"_20626":116313,"_5":14148,"_27027":116185,"_2882":116314},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3396":69548,"_29729":69495,"_20626":116316,"_5":14148,"_27027":116189,"_2882":116317},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3396":69549,"_29729":69495,"_20626":116319,"_5":14148,"_27027":116189,"_2882":116320},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3396":69550,"_29729":69495,"_20626":116322,"_5":14148,"_27027":116193,"_2882":116323},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3396":69551,"_29729":69495,"_20626":116325,"_5":14148,"_27027":116193,"_2882":116326},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3396":69552,"_29729":69495,"_20626":116328,"_5":14148,"_27027":116193,"_2882":116329},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3396":69553,"_29729":69495,"_20626":116331,"_5":14148,"_27027":116193,"_2882":116332},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3396":69554,"_29729":69495,"_20626":116334,"_5":14148,"_27027":116193,"_2882":116335},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3396":69555,"_29729":69495,"_20626":116337,"_5":14148,"_27027":116193,"_2882":116338},[],"**Validación:** `va.role.crl.create`.",{"_3396":69556,"_29729":69495,"_20626":116340,"_5":14148,"_27027":116193,"_2882":116341},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3396":69557,"_29729":69495,"_20626":116343,"_5":14148,"_27027":116193,"_2882":116344},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3396":69558,"_29729":69558,"_5":14500,"_2882":116346,"_30082":116347,"_20626":116348,"_27027":69558},"Registros de auditoría",[48429,115610,115611],[],{"_3396":69559,"_29729":69558,"_20626":116350,"_5":14148,"_27027":69558,"_2882":116351},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3396":69560,"_29729":69558,"_5":30079,"_20626":116353,"_27027":116354,"_2882":116355},[],"/docs/pr-preview/pr-57/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3396":69561,"_29729":69558,"_5":30079,"_20626":116357,"_27027":116358,"_2882":116359},[],"/docs/pr-preview/pr-57/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3396":69562,"_29729":69558,"_5":30079,"_20626":116361,"_27027":116362,"_2882":116363},[],"/docs/pr-preview/pr-57/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3396":69563,"_29729":69558,"_5":30079,"_20626":116365,"_27027":116366,"_2882":116367},[],"/docs/pr-preview/pr-57/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3396":69564,"_29729":69558,"_5":30079,"_20626":116369,"_27027":116370,"_2882":116371},[],"/docs/pr-preview/pr-57/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3396":69565,"_29729":69558,"_5":30079,"_20626":116373,"_27027":116374,"_2882":116375},[],"/docs/pr-preview/pr-57/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3396":69566,"_29729":69558,"_5":30079,"_20626":116377,"_27027":116378,"_2882":116379},[],"/docs/pr-preview/pr-57/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3396":69567,"_29729":69558,"_5":30079,"_20626":116381,"_27027":116382,"_2882":116383},[],"/docs/pr-preview/pr-57/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3396":69568,"_29729":69558,"_5":30079,"_20626":116385,"_27027":116386,"_2882":116387},[],"/docs/pr-preview/pr-57/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3396":69569,"_29729":69558,"_5":30079,"_20626":116389,"_27027":116390,"_2882":116391},[],"/docs/pr-preview/pr-57/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3396":69570,"_29729":69558,"_5":30079,"_20626":116393,"_27027":116394,"_2882":116395},[],"/docs/pr-preview/pr-57/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3396":69571,"_29729":69558,"_20626":116397,"_5":14148,"_27027":69558,"_2882":116398},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3396":69572,"_29729":69558,"_20626":116400,"_5":14148,"_27027":116354,"_2882":116401},[],"El cuerpo de auditoría incluye:",{"_3396":69573,"_29729":69558,"_20626":116403,"_5":14148,"_27027":116354,"_2882":116404},[],"input: datos recibidos por la operación;",{"_3396":69574,"_29729":69558,"_20626":116406,"_5":14148,"_27027":116354,"_2882":116407},[],"has\\_error: indica si el servicio devolvió un error;",{"_3396":69575,"_29729":69558,"_20626":116409,"_5":14148,"_27027":116354,"_2882":116410},[],"output: resultado producido o mensaje de error;",{"_3396":69576,"_29729":69558,"_20626":116412,"_5":14148,"_27027":116354,"_2882":116413},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3396":69577,"_29729":69558,"_20626":116415,"_5":14148,"_27027":116354,"_2882":116416},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3396":69578,"_29729":69558,"_20626":116418,"_5":14148,"_27027":116354,"_2882":116419},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3396":69579,"_29729":69558,"_20626":116421,"_5":14148,"_27027":116358,"_2882":116422},[],"El backend aplica auditoría a mutaciones de:",{"_3396":69580,"_29729":69558,"_20626":116424,"_5":14148,"_27027":116358,"_2882":116425},[],"autoridades, certificados y perfiles de emisión;",{"_3396":69581,"_29729":69558,"_20626":116427,"_5":14148,"_27027":116358,"_2882":116428},[],"claves y motores KMS;",{"_3396":69582,"_29729":69558,"_20626":116430,"_5":14148,"_27027":116358,"_2882":116431},[],"dispositivos e identidades;",{"_3396":69583,"_29729":69558,"_20626":116433,"_5":14148,"_27027":116358,"_2882":116434},[],"DMS y operaciones de enrolamiento;",{"_3396":69584,"_29729":69558,"_20626":116436,"_5":14148,"_27027":116358,"_2882":116437},[],"funciones de validación y CRL;",{"_3396":69585,"_29729":69558,"_20626":116439,"_5":14148,"_27027":116358,"_2882":116440},[],"principales, políticas y concesiones de autorización.",{"_3396":69586,"_29729":69558,"_20626":116442,"_5":14148,"_27027":116358,"_2882":116443},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3396":69587,"_29729":69558,"_20626":116445,"_5":14148,"_27027":116362,"_2882":116446},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3396":69588,"_29729":69558,"_20626":116448,"_5":14148,"_27027":116362,"_2882":116449},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3396":69589,"_29729":69558,"_20626":116451,"_5":14148,"_27027":116362,"_2882":116452},[],"Diseña el consumidor para:",{"_3396":69590,"_29729":69558,"_20626":116454,"_5":14148,"_27027":116362,"_2882":116455},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3396":69591,"_29729":69558,"_20626":116457,"_5":14148,"_27027":116362,"_2882":116458},[],"conservar el CloudEvent completo sin modificar;",{"_3396":69592,"_29729":69558,"_20626":116460,"_5":14148,"_27027":116362,"_2882":116461},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3396":69593,"_29729":69558,"_20626":116463,"_5":14148,"_27027":116362,"_2882":116464},[],"cifrar en tránsito y en reposo;",{"_3396":69594,"_29729":69558,"_20626":116466,"_5":14148,"_27027":116362,"_2882":116467},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3396":69595,"_29729":69558,"_20626":116469,"_5":14148,"_27027":116362,"_2882":116470},[],"aplicar una política explícita de retención y legal hold;",{"_3396":69596,"_29729":69558,"_20626":116472,"_5":14148,"_27027":116362,"_2882":116473},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3396":69597,"_29729":69558,"_20626":116475,"_5":14148,"_27027":116366,"_2882":116476},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3396":69598,"_29729":69558,"_20626":116478,"_5":14148,"_27027":116366,"_2882":116479},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3396":69599,"_29729":69558,"_20626":116481,"_5":14148,"_27027":116374,"_2882":116482},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3396":69600,"_29729":69558,"_20626":116484,"_5":14148,"_27027":116378,"_2882":116485},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3396":69601,"_29729":69558,"_20626":116487,"_5":14148,"_27027":116382,"_2882":116488},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3396":69602,"_29729":69558,"_20626":116490,"_5":14148,"_27027":116386,"_2882":116491},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3396":69603,"_29729":69558,"_20626":116493,"_5":14148,"_27027":116390,"_2882":116494},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3396":69604,"_29729":69558,"_20626":116496,"_5":14148,"_27027":116394,"_2882":116497},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3396":69605,"_29729":69558,"_20626":116499,"_5":14148,"_27027":116394,"_2882":116500},[],"aparece un evento de auditoría correcto;",{"_3396":69606,"_29729":69558,"_20626":116502,"_5":14148,"_27027":116394,"_2882":116503},[],"el principal coincide con la identidad utilizada;",{"_3396":69607,"_29729":69558,"_20626":116505,"_5":14148,"_27027":116394,"_2882":116506},[],"el consumidor lo persiste una sola vez;",{"_3396":69608,"_29729":69558,"_20626":116508,"_5":14148,"_27027":116394,"_2882":116509},[],"puede recuperarse por recurso, actor y periodo;",{"_3396":69609,"_29729":69558,"_20626":116511,"_5":14148,"_27027":116394,"_2882":116512},[],"una interrupción del consumidor produce una alerta.",{"_3396":69610,"_29729":69558,"_20626":116514,"_5":14148,"_27027":116394,"_2882":116515},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3396":69611,"_29729":69611,"_5":14500,"_2882":116517,"_30082":116518,"_20626":116519,"_27027":69611},"Arquitectura de la plataforma",[48429,115610],[],{"_3396":69612,"_29729":69611,"_20626":116521,"_5":14148,"_27027":69611,"_2882":116522},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3396":69613,"_29729":69611,"_5":30079,"_20626":116524,"_27027":116525,"_2882":116526},[],"/docs/pr-preview/pr-57/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3396":69614,"_29729":69611,"_5":30079,"_20626":116528,"_27027":116529,"_2882":116530},[],"/docs/pr-preview/pr-57/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3396":69615,"_29729":69611,"_5":30079,"_20626":116532,"_27027":116533,"_2882":116534},[],"/docs/pr-preview/pr-57/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3396":69616,"_29729":69611,"_5":30079,"_20626":116536,"_27027":116537,"_2882":116538},[],"/docs/pr-preview/pr-57/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3396":69617,"_29729":69611,"_5":30079,"_20626":116540,"_27027":116541,"_2882":116542},[],"/docs/pr-preview/pr-57/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3396":69618,"_29729":69611,"_20626":116544,"_5":14148,"_27027":69611,"_2882":116545},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3396":69619,"_29729":69611,"_20626":116547,"_5":14148,"_27027":69611,"_2882":116548},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3396":69620,"_29729":69611,"_20626":116550,"_5":14148,"_27027":116525,"_2882":116551},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3396":69621,"_29729":69611,"_20626":116553,"_5":14148,"_27027":116529,"_2882":116554},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3396":69622,"_29729":69611,"_20626":116556,"_5":14148,"_27027":116533,"_2882":116557},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3396":69623,"_29729":69611,"_20626":116559,"_5":14148,"_27027":116537,"_2882":116560},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3396":69624,"_29729":69611,"_20626":116562,"_5":14148,"_27027":116541,"_2882":116563},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3396":69625,"_29729":69625,"_5":14500,"_2882":116565,"_30082":116566,"_20626":116567,"_27027":69625},"Cómo funciona Lamassu",[48429,115610],[],{"_3396":69626,"_29729":69625,"_20626":116569,"_5":14148,"_27027":69625,"_2882":116570},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3396":69627,"_29729":69625,"_5":30079,"_20626":116572,"_27027":116573,"_2882":116574},[],"/docs/pr-preview/pr-57/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3396":69628,"_29729":69625,"_5":30079,"_20626":116576,"_27027":116577,"_2882":116578},[],"/docs/pr-preview/pr-57/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3396":69629,"_29729":69625,"_20626":116580,"_5":14148,"_27027":69625,"_2882":116581},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3396":69630,"_29729":69625,"_20626":116583,"_5":14148,"_27027":116573,"_2882":116584},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3396":69631,"_29729":69625,"_20626":116586,"_5":14148,"_27027":116573,"_2882":116587},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3396":69632,"_29729":69625,"_20626":116589,"_5":14148,"_27027":116573,"_2882":116590},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3396":69633,"_29729":69625,"_20626":116592,"_5":14148,"_27027":116573,"_2882":116593},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3396":69634,"_29729":69625,"_20626":116595,"_5":14148,"_27027":116573,"_2882":116596},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3396":69635,"_29729":69625,"_20626":116598,"_5":14148,"_27027":116577,"_2882":116599},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3396":69636,"_29729":69625,"_20626":116601,"_5":14148,"_27027":116577,"_2882":116602},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3396":69637,"_29729":69625,"_20626":116604,"_5":14148,"_27027":116577,"_2882":116605},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3396":69638,"_29729":69625,"_20626":116607,"_5":14148,"_27027":116577,"_2882":116608},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3396":69639,"_29729":69625,"_20626":116610,"_5":14148,"_27027":116577,"_2882":116611},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3396":69640,"_29729":69625,"_20626":116613,"_5":14148,"_27027":116577,"_2882":116614},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3396":69641,"_29729":69625,"_20626":116616,"_5":14148,"_27027":116577,"_2882":116617},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3396":69642,"_29729":69642,"_5":14500,"_2882":116619,"_30082":116620,"_20626":116621,"_27027":69642},"Dispositivos e identidades",[48429,115610,50908,116619],[],{"_3396":69643,"_29729":69642,"_20626":116623,"_5":14148,"_27027":69642,"_2882":116624},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3396":69644,"_29729":69642,"_5":30079,"_20626":116626,"_27027":116627,"_2882":116628},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3396":69645,"_29729":69642,"_5":30079,"_20626":116630,"_27027":116631,"_2882":116632},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3396":69646,"_29729":69642,"_5":30079,"_20626":116634,"_27027":116635,"_2882":116636},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3396":69647,"_29729":69642,"_5":30079,"_20626":116638,"_27027":116639,"_2882":116640},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3396":69648,"_29729":69642,"_5":30079,"_20626":116642,"_27027":116643,"_2882":116644},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3396":69649,"_29729":69642,"_5":30079,"_20626":116646,"_27027":116647,"_2882":116648},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3396":69650,"_29729":69642,"_5":30079,"_20626":116650,"_27027":116651,"_2882":116652},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3396":69651,"_29729":69642,"_5":30079,"_20626":116654,"_27027":116655,"_2882":116656},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3396":69652,"_29729":69642,"_5":30079,"_20626":116658,"_27027":116659,"_2882":116660},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3396":69653,"_29729":69642,"_5":30079,"_20626":116662,"_27027":116663,"_2882":116664},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3396":69654,"_29729":69642,"_5":30079,"_20626":116666,"_27027":116667,"_2882":116668},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3396":69655,"_29729":69642,"_20626":116670,"_5":14148,"_27027":69642,"_2882":116671},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3396":69656,"_29729":69642,"_20626":116673,"_5":14148,"_27027":69642,"_2882":116674},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3396":69657,"_29729":69642,"_20626":116676,"_5":14148,"_27027":116627,"_2882":116677},[],"Vista operativa",{"_3396":69658,"_29729":69642,"_20626":116679,"_5":14148,"_27027":116627,"_2882":116680},[],"Interpretación",{"_3396":69659,"_29729":69642,"_20626":116682,"_5":14148,"_27027":116627,"_2882":50971},[],{"_3396":69660,"_29729":69642,"_20626":116684,"_5":14148,"_27027":116627,"_2882":116685},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3396":69661,"_29729":69642,"_20626":116687,"_5":14148,"_27027":116627,"_2882":50977},[],{"_3396":69662,"_29729":69642,"_20626":116689,"_5":14148,"_27027":116627,"_2882":116690},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3396":69663,"_29729":69642,"_20626":116692,"_5":14148,"_27027":116627,"_2882":50983},[],{"_3396":69664,"_29729":69642,"_20626":116694,"_5":14148,"_27027":116627,"_2882":116695},[],"La identidad está en la ventana operativa de renovación.",{"_3396":69665,"_29729":69642,"_20626":116697,"_5":14148,"_27027":116627,"_2882":50989},[],{"_3396":69666,"_29729":69642,"_20626":116699,"_5":14148,"_27027":116627,"_2882":116700},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3396":69667,"_29729":69642,"_20626":116702,"_5":14148,"_27027":116627,"_2882":50995},[],{"_3396":69668,"_29729":69642,"_20626":116704,"_5":14148,"_27027":116627,"_2882":116705},[],"La identidad ha vencido.",{"_3396":69669,"_29729":69642,"_20626":116707,"_5":14148,"_27027":116627,"_2882":51001},[],{"_3396":69670,"_29729":69642,"_20626":116709,"_5":14148,"_27027":116627,"_2882":116710},[],"La identidad está marcada como revocada.",{"_3396":69671,"_29729":69642,"_20626":116712,"_5":14148,"_27027":116627,"_2882":51007},[],{"_3396":69672,"_29729":69642,"_20626":116714,"_5":14148,"_27027":116627,"_2882":116715},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3396":69673,"_29729":69642,"_20626":116717,"_5":14148,"_27027":116627,"_2882":116718},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3396":69674,"_29729":69642,"_20626":116720,"_5":14148,"_27027":116631,"_2882":116721},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3396":69675,"_29729":69642,"_20626":116723,"_5":14148,"_27027":116631,"_2882":116724},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3396":69676,"_29729":69642,"_20626":116726,"_5":14148,"_27027":116631,"_2882":116727},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3396":69677,"_29729":69642,"_20626":116729,"_5":14148,"_27027":116631,"_2882":116730},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3396":69678,"_29729":69642,"_20626":116732,"_5":14148,"_27027":116635,"_2882":116733},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3396":69679,"_29729":69642,"_20626":116735,"_5":14148,"_27027":116639,"_2882":116736},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3396":69680,"_29729":69642,"_20626":116738,"_5":14148,"_27027":116643,"_2882":116739},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3396":69681,"_29729":69642,"_20626":116741,"_5":14148,"_27027":116647,"_2882":116742},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3396":69682,"_29729":69642,"_20626":116744,"_5":14148,"_27027":116651,"_2882":116745},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3396":69683,"_29729":69642,"_20626":116747,"_5":14148,"_27027":116651,"_2882":116748},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3396":69684,"_29729":69642,"_20626":116750,"_5":14148,"_27027":116655,"_2882":116751},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3396":69685,"_29729":69642,"_20626":116753,"_5":14148,"_27027":116655,"_2882":116754},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3396":69686,"_29729":69642,"_20626":116756,"_5":14148,"_27027":116655,"_2882":116757},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3396":69687,"_29729":69642,"_20626":116759,"_5":14148,"_27027":116655,"_2882":116760},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3396":69688,"_29729":69642,"_20626":116762,"_5":14148,"_27027":116655,"_2882":116763},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3396":69689,"_29729":69642,"_20626":116765,"_5":14148,"_27027":116655,"_2882":116766},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3396":69690,"_29729":69642,"_20626":116768,"_5":14148,"_27027":116659,"_2882":116769},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3396":69691,"_29729":69642,"_20626":116771,"_5":14148,"_27027":116659,"_2882":116772},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3396":69692,"_29729":69642,"_20626":116774,"_5":14148,"_27027":116663,"_2882":116775},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3396":69693,"_29729":69642,"_20626":116777,"_5":14148,"_27027":116663,"_2882":116778},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3396":69694,"_29729":69642,"_20626":116780,"_5":14148,"_27027":116663,"_2882":116781},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3396":69695,"_29729":69642,"_20626":116783,"_5":14148,"_27027":116663,"_2882":116784},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3396":69696,"_29729":69642,"_20626":116786,"_5":14148,"_27027":116667,"_2882":116787},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3396":69697,"_29729":69642,"_20626":116789,"_5":14148,"_27027":116667,"_2882":116790},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3396":69698,"_29729":69698,"_5":14500,"_2882":116792,"_30082":116793,"_20626":116795,"_27027":69698},"Identidad inicial y autenticación",[48429,115610,50908,116619,116794],"Enrolamiento con PKI",[],{"_3396":69699,"_29729":69698,"_20626":116797,"_5":14148,"_27027":69698,"_2882":116798},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3396":69700,"_29729":69698,"_5":30079,"_20626":116800,"_27027":116801,"_2882":116802},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3396":69701,"_29729":69698,"_5":30079,"_20626":116804,"_27027":116805,"_2882":116806},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3396":69702,"_29729":69698,"_5":30079,"_20626":116808,"_27027":116809,"_2882":116810},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3396":69703,"_29729":69698,"_5":30079,"_20626":116812,"_27027":116813,"_2882":116814},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3396":69704,"_29729":69698,"_5":30079,"_20626":116816,"_27027":116817,"_2882":116818},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3396":69705,"_29729":69698,"_20626":116820,"_5":14148,"_27027":69698,"_2882":116821},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3396":69706,"_29729":69698,"_20626":116823,"_5":14148,"_27027":116801,"_2882":116824},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3396":69707,"_29729":69698,"_20626":116826,"_5":14148,"_27027":116801,"_2882":116827},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3396":69708,"_29729":69698,"_20626":116829,"_5":14148,"_27027":116805,"_2882":116830},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3396":69709,"_29729":69698,"_20626":116832,"_5":14148,"_27027":116805,"_2882":116833},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3396":69710,"_29729":69698,"_20626":116835,"_5":14148,"_27027":116805,"_2882":116836},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3396":69711,"_29729":69698,"_20626":116838,"_5":14148,"_27027":116809,"_2882":116839},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3396":69712,"_29729":69698,"_20626":116841,"_5":14148,"_27027":116809,"_2882":116842},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3396":69713,"_29729":69698,"_20626":116844,"_5":14148,"_27027":116813,"_2882":116845},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3396":69714,"_29729":69698,"_20626":116847,"_5":14148,"_27027":116813,"_2882":116848},[],"Ejemplo de cuerpo:",{"_3396":69715,"_29729":69698,"_20626":116850,"_5":14148,"_27027":116813,"_2882":116851},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3396":69716,"_29729":69698,"_20626":116853,"_5":14148,"_27027":116813,"_2882":116854},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3396":69717,"_29729":69698,"_20626":116856,"_5":14148,"_27027":116813,"_2882":116857},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3396":69718,"_29729":69698,"_20626":116859,"_5":14148,"_27027":116813,"_2882":116860},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3396":69719,"_29729":69698,"_20626":116862,"_5":14148,"_27027":116817,"_2882":116863},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3396":69720,"_29729":69698,"_20626":116865,"_5":14148,"_27027":116817,"_2882":116866},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3396":69721,"_29729":69721,"_5":14500,"_2882":116868,"_30082":116869,"_20626":116870,"_27027":69721},"Configura y opera el DMS",[48429,115610,50908,116619,116794],[],{"_3396":69722,"_29729":69721,"_20626":116872,"_5":14148,"_27027":69721,"_2882":116873},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3396":69723,"_29729":69721,"_5":30079,"_20626":116875,"_27027":116876,"_2882":114188},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3396":69724,"_29729":69721,"_5":30079,"_20626":116878,"_27027":116879,"_2882":116880},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3396":69725,"_29729":69721,"_5":30079,"_20626":116882,"_27027":116883,"_2882":116884},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3396":69726,"_29729":69721,"_5":30079,"_20626":116886,"_27027":116887,"_2882":116888},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3396":69727,"_29729":69721,"_5":30079,"_20626":116890,"_27027":116891,"_2882":116892},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3396":69728,"_29729":69721,"_5":30079,"_20626":116894,"_27027":116895,"_2882":116896},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3396":69729,"_29729":69721,"_5":30079,"_20626":116898,"_27027":116899,"_2882":116900},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3396":69730,"_29729":69721,"_5":30079,"_20626":116902,"_27027":116903,"_2882":116904},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3396":69731,"_29729":69721,"_5":30079,"_20626":116906,"_27027":116907,"_2882":51203},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3396":69732,"_29729":69721,"_5":30079,"_20626":116909,"_27027":116910,"_2882":51207},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3396":69733,"_29729":69721,"_5":30079,"_20626":116912,"_27027":116913,"_2882":116914},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3396":69734,"_29729":69721,"_5":30079,"_20626":116916,"_27027":116917,"_2882":116918},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3396":69735,"_29729":69721,"_5":30079,"_20626":116920,"_27027":116921,"_2882":116922},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3396":69736,"_29729":69721,"_5":30079,"_20626":116924,"_27027":116925,"_2882":116926},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3396":69737,"_29729":69721,"_5":30079,"_20626":116928,"_27027":116929,"_2882":51227},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3396":69738,"_29729":69721,"_5":30079,"_20626":116931,"_27027":116932,"_2882":116933},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3396":69739,"_29729":69721,"_5":30079,"_20626":116935,"_27027":116936,"_2882":116937},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3396":69740,"_29729":69721,"_5":30079,"_20626":116939,"_27027":116940,"_2882":116941},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3396":69741,"_29729":69721,"_20626":116943,"_5":14148,"_27027":69721,"_2882":116944},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3396":69742,"_29729":69721,"_20626":116946,"_5":14148,"_27027":116876,"_2882":116947},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3396":69743,"_29729":69721,"_20626":116949,"_5":14148,"_27027":116876,"_2882":116950},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3396":69744,"_29729":69721,"_20626":116952,"_5":14148,"_27027":116883,"_2882":116953},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3396":69745,"_29729":69721,"_20626":116955,"_5":14148,"_27027":116887,"_2882":116956},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3396":69746,"_29729":69721,"_20626":116958,"_5":14148,"_27027":116891,"_2882":116959},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3396":69747,"_29729":69721,"_20626":116961,"_5":14148,"_27027":116895,"_2882":116962},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3396":69748,"_29729":69721,"_20626":116964,"_5":14148,"_27027":116899,"_2882":116965},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3396":69749,"_29729":69721,"_20626":116967,"_5":14148,"_27027":116907,"_2882":116968},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3396":69750,"_29729":69721,"_20626":116970,"_5":14148,"_27027":116907,"_2882":116971},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3396":69751,"_29729":69721,"_20626":116973,"_5":14148,"_27027":116910,"_2882":116974},[],"Campo de `settings.enrollment_settings`",{"_3396":69752,"_29729":69721,"_20626":116976,"_5":14148,"_27027":116910,"_2882":116977},[],"Decisión",{"_3396":69753,"_29729":69721,"_20626":116979,"_5":14148,"_27027":116910,"_2882":51278},[],{"_3396":69754,"_29729":69721,"_20626":116981,"_5":14148,"_27027":116910,"_2882":116982},[],"`EST_RFC7030` para estas operaciones.",{"_3396":69755,"_29729":69721,"_20626":116984,"_5":14148,"_27027":116910,"_2882":51284},[],{"_3396":69756,"_29729":69721,"_20626":116986,"_5":14148,"_27027":116910,"_2882":116987},[],"ID de la CA que firmará.",{"_3396":69757,"_29729":69721,"_20626":116989,"_5":14148,"_27027":116910,"_2882":51290},[],{"_3396":69758,"_29729":69721,"_20626":116991,"_5":14148,"_27027":116910,"_2882":116992},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3396":69759,"_29729":69721,"_20626":116994,"_5":14148,"_27027":116910,"_2882":51296},[],{"_3396":69760,"_29729":69721,"_20626":116996,"_5":14148,"_27027":116910,"_2882":116997},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3396":69761,"_29729":69721,"_20626":116999,"_5":14148,"_27027":116910,"_2882":51302},[],{"_3396":69762,"_29729":69721,"_20626":117001,"_5":14148,"_27027":116910,"_2882":117002},[],"Uno de los cuatro modos de autenticación.",{"_3396":69763,"_29729":69721,"_20626":117004,"_5":14148,"_27027":116910,"_2882":117005},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3396":69764,"_29729":69721,"_20626":117007,"_5":14148,"_27027":116913,"_2882":117008},[],"Los bloques son independientes:",{"_3396":69765,"_29729":69721,"_20626":117010,"_5":14148,"_27027":116913,"_2882":117011},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3396":69766,"_29729":69721,"_20626":117013,"_5":14148,"_27027":116913,"_2882":117014},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3396":69767,"_29729":69721,"_20626":117016,"_5":14148,"_27027":116913,"_2882":51320},[],{"_3396":69768,"_29729":69721,"_20626":117018,"_5":14148,"_27027":116913,"_2882":117019},[],"Control aplicado en la operación configurada",{"_3396":69769,"_29729":69721,"_20626":117021,"_5":14148,"_27027":116913,"_2882":51326},[],{"_3396":69770,"_29729":69721,"_20626":117023,"_5":14148,"_27027":116913,"_2882":117024},[],"Validación del certificado presentado.",{"_3396":69771,"_29729":69721,"_20626":117026,"_5":14148,"_27027":116913,"_2882":51332},[],{"_3396":69772,"_29729":69721,"_20626":117028,"_5":14148,"_27027":116913,"_2882":117029},[],"Autorización del webhook configurado.",{"_3396":69773,"_29729":69721,"_20626":117031,"_5":14148,"_27027":116913,"_2882":51338},[],{"_3396":69774,"_29729":69721,"_20626":117033,"_5":14148,"_27027":116913,"_2882":117034},[],"Validación del certificado y, después, aprobación del webhook.",{"_3396":69775,"_29729":69721,"_20626":117036,"_5":14148,"_27027":116913,"_2882":51344},[],{"_3396":69776,"_29729":69721,"_20626":117038,"_5":14148,"_27027":116913,"_2882":117039},[],"Sin autenticación del solicitante por el DMS.",{"_3396":69777,"_29729":69721,"_20626":117041,"_5":14148,"_27027":116913,"_2882":117042},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3396":69778,"_29729":69721,"_20626":117044,"_5":14148,"_27027":116913,"_2882":117045},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3396":69779,"_29729":69721,"_20626":117047,"_5":14148,"_27027":116913,"_2882":117048},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3396":69780,"_29729":69721,"_20626":117050,"_5":14148,"_27027":116913,"_2882":117051},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3396":69781,"_29729":69721,"_20626":117053,"_5":14148,"_27027":116917,"_2882":117054},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3396":69782,"_29729":69721,"_20626":117056,"_5":14148,"_27027":116917,"_2882":117057},[],"Campo de `external_webhook_settings`",{"_3396":69783,"_29729":69721,"_20626":117059,"_5":14148,"_27027":116917,"_2882":116977},[],{"_3396":69784,"_29729":69721,"_20626":117061,"_5":14148,"_27027":116917,"_2882":51370},[],{"_3396":69785,"_29729":69721,"_20626":117063,"_5":14148,"_27027":116917,"_2882":117064},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3396":69786,"_29729":69721,"_20626":117066,"_5":14148,"_27027":116917,"_2882":51376},[],{"_3396":69787,"_29729":69721,"_20626":117068,"_5":14148,"_27027":116917,"_2882":117069},[],"`POST` o `PUT`; `POST` por defecto.",{"_3396":69788,"_29729":69721,"_20626":117071,"_5":14148,"_27027":116917,"_2882":51382},[],{"_3396":69789,"_29729":69721,"_20626":117073,"_5":14148,"_27027":116917,"_2882":117074},[],"Etiqueta usada en los logs del servicio.",{"_3396":69790,"_29729":69721,"_20626":117076,"_5":14148,"_27027":116917,"_2882":51388},[],{"_3396":69791,"_29729":69721,"_20626":117078,"_5":14148,"_27027":116917,"_2882":117079},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3396":69792,"_29729":69721,"_20626":117081,"_5":14148,"_27027":116917,"_2882":51394},[],{"_3396":69793,"_29729":69721,"_20626":117083,"_5":14148,"_27027":116917,"_2882":117084},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3396":69794,"_29729":69721,"_20626":117086,"_5":14148,"_27027":116917,"_2882":51400},[],{"_3396":69795,"_29729":69721,"_20626":117088,"_5":14148,"_27027":116917,"_2882":117089},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3396":69796,"_29729":69721,"_20626":117091,"_5":14148,"_27027":116917,"_2882":51406},[],{"_3396":69797,"_29729":69721,"_20626":117093,"_5":14148,"_27027":116917,"_2882":117094},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3396":69798,"_29729":69721,"_20626":117096,"_5":14148,"_27027":116917,"_2882":51412},[],{"_3396":69799,"_29729":69721,"_20626":117098,"_5":14148,"_27027":116917,"_2882":117099},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3396":69800,"_29729":69721,"_20626":117101,"_5":14148,"_27027":116917,"_2882":51418},[],{"_3396":69801,"_29729":69721,"_20626":117103,"_5":14148,"_27027":116917,"_2882":117104},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3396":69802,"_29729":69721,"_20626":117106,"_5":14148,"_27027":116917,"_2882":51424},[],{"_3396":69803,"_29729":69721,"_20626":117108,"_5":14148,"_27027":116917,"_2882":117109},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3396":69804,"_29729":69721,"_20626":117111,"_5":14148,"_27027":116917,"_2882":117112},[],"Reglas de esa configuración:",{"_3396":69805,"_29729":69721,"_20626":117114,"_5":14148,"_27027":116917,"_2882":117115},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3396":69806,"_29729":69721,"_20626":117117,"_5":14148,"_27027":116917,"_2882":117118},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3396":69807,"_29729":69721,"_20626":117120,"_5":14148,"_27027":116917,"_2882":117121},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3396":69808,"_29729":69721,"_20626":117123,"_5":14148,"_27027":116917,"_2882":117124},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3396":69809,"_29729":69721,"_20626":117126,"_5":14148,"_27027":116917,"_2882":117127},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3396":69810,"_29729":69721,"_20626":117129,"_5":14148,"_27027":116917,"_2882":117130},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3396":69811,"_29729":69721,"_20626":117132,"_5":14148,"_27027":116917,"_2882":117133},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3396":69812,"_29729":69721,"_20626":117135,"_5":14148,"_27027":116917,"_2882":117136},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3396":69813,"_29729":69721,"_20626":117138,"_5":14148,"_27027":116917,"_2882":117139},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3396":69814,"_29729":69721,"_20626":117141,"_5":14148,"_27027":116921,"_2882":117142},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3396":69815,"_29729":69721,"_20626":117144,"_5":14148,"_27027":116925,"_2882":117145},[],"Campo de `settings.reenrollment_settings`",{"_3396":69816,"_29729":69721,"_20626":117147,"_5":14148,"_27027":116925,"_2882":117148},[],"Función",{"_3396":69817,"_29729":69721,"_20626":117150,"_5":14148,"_27027":116925,"_2882":51468},[],{"_3396":69818,"_29729":69721,"_20626":117152,"_5":14148,"_27027":116925,"_2882":117153},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3396":69819,"_29729":69721,"_20626":117155,"_5":14148,"_27027":116925,"_2882":51474},[],{"_3396":69820,"_29729":69721,"_20626":117157,"_5":14148,"_27027":116925,"_2882":117158},[],"Umbral operativo preventivo de monitorización.",{"_3396":69821,"_29729":69721,"_20626":117160,"_5":14148,"_27027":116925,"_2882":51480},[],{"_3396":69822,"_29729":69721,"_20626":117162,"_5":14148,"_27027":116925,"_2882":117163},[],"Umbral operativo crítico de monitorización.",{"_3396":69823,"_29729":69721,"_20626":117165,"_5":14148,"_27027":116925,"_2882":51486},[],{"_3396":69824,"_29729":69721,"_20626":117167,"_5":14148,"_27027":116925,"_2882":117168},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3396":69825,"_29729":69721,"_20626":117170,"_5":14148,"_27027":116925,"_2882":51492},[],{"_3396":69826,"_29729":69721,"_20626":117172,"_5":14148,"_27027":116925,"_2882":117173},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3396":69827,"_29729":69721,"_20626":117175,"_5":14148,"_27027":116925,"_2882":51498},[],{"_3396":69828,"_29729":69721,"_20626":117177,"_5":14148,"_27027":116925,"_2882":117178},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3396":69829,"_29729":69721,"_20626":117180,"_5":14148,"_27027":116925,"_2882":117181},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3396":69830,"_29729":69721,"_20626":117183,"_5":14148,"_27027":116929,"_2882":117184},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3396":69831,"_29729":69721,"_20626":117186,"_5":14148,"_27027":116932,"_2882":114552},[],{"_3396":69832,"_29729":69721,"_20626":117188,"_5":14148,"_27027":116932,"_2882":117189},[],"Qué publica",{"_3396":69833,"_29729":69721,"_20626":117191,"_5":14148,"_27027":116932,"_2882":51515},[],{"_3396":69834,"_29729":69721,"_20626":117193,"_5":14148,"_27027":116932,"_2882":117194},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3396":69835,"_29729":69721,"_20626":117196,"_5":14148,"_27027":116932,"_2882":51521},[],{"_3396":69836,"_29729":69721,"_20626":117198,"_5":14148,"_27027":116932,"_2882":117199},[],"Certificado de la CA emisora seleccionada.",{"_3396":69837,"_29729":69721,"_20626":117201,"_5":14148,"_27027":116932,"_2882":51527},[],{"_3396":69838,"_29729":69721,"_20626":117203,"_5":14148,"_27027":116932,"_2882":117204},[],"Certificados de las CAs elegidas explícitamente.",{"_3396":69839,"_29729":69721,"_20626":117206,"_5":14148,"_27027":116932,"_2882":117207},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3396":69840,"_29729":69721,"_20626":117209,"_5":14148,"_27027":116936,"_2882":117210},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3396":69841,"_29729":69721,"_20626":117212,"_5":14148,"_27027":116936,"_2882":117213},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3396":69842,"_29729":69721,"_20626":117215,"_5":14148,"_27027":116936,"_2882":117216},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3396":69843,"_29729":69721,"_20626":117218,"_5":14148,"_27027":116940,"_2882":117219},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3396":69844,"_29729":69844,"_5":14500,"_2882":117221,"_30082":117222,"_20626":117223,"_27027":69844},"Integra el cliente EST",[48429,115610,50908,116619,116794],[],{"_3396":69845,"_29729":69844,"_20626":117225,"_5":14148,"_27027":69844,"_2882":117226},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3396":69846,"_29729":69844,"_5":30079,"_20626":117228,"_27027":117229,"_2882":114188},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3396":69847,"_29729":69844,"_5":30079,"_20626":117231,"_27027":117232,"_2882":117233},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3396":69848,"_29729":69844,"_5":30079,"_20626":117235,"_27027":117236,"_2882":117237},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3396":69849,"_29729":69844,"_5":30079,"_20626":117239,"_27027":117240,"_2882":117241},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3396":69850,"_29729":69844,"_5":30079,"_20626":117243,"_27027":117244,"_2882":117245},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3396":69851,"_29729":69844,"_5":30079,"_20626":117247,"_27027":117248,"_2882":117249},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3396":69852,"_29729":69844,"_20626":117251,"_5":14148,"_27027":69844,"_2882":117252},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3396":69853,"_29729":69844,"_20626":117254,"_5":14148,"_27027":117229,"_2882":117255},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3396":69854,"_29729":69844,"_20626":117257,"_5":14148,"_27027":117229,"_2882":117258},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3396":69855,"_29729":69844,"_20626":117260,"_5":14148,"_27027":117229,"_2882":117261},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3396":69856,"_29729":69844,"_20626":117263,"_5":14148,"_27027":117232,"_2882":117264},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3396":69857,"_29729":69844,"_20626":117266,"_5":14148,"_27027":117232,"_2882":117267},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3396":69858,"_29729":69844,"_20626":117269,"_5":14148,"_27027":117236,"_2882":117270},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3396":69859,"_29729":69844,"_20626":117272,"_5":14148,"_27027":117236,"_2882":117273},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3396":69860,"_29729":69844,"_20626":117275,"_5":14148,"_27027":117240,"_2882":117276},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3396":69861,"_29729":69844,"_20626":117278,"_5":14148,"_27027":117240,"_2882":117279},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3396":69862,"_29729":69844,"_20626":117281,"_5":14148,"_27027":117244,"_2882":117282},[],"Para el caso de una raíz que emite directamente:",{"_3396":69863,"_29729":69844,"_20626":117284,"_5":14148,"_27027":117244,"_2882":117285},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3396":69864,"_29729":69844,"_20626":117287,"_5":14148,"_27027":117244,"_2882":117288},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3396":69865,"_29729":69844,"_20626":117290,"_5":14148,"_27027":117248,"_2882":117291},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3396":69866,"_29729":69866,"_5":14500,"_2882":117293,"_30082":117294,"_20626":117295,"_27027":69866},"Referencia EST",[48429,115610,50908,116619,116794],[],{"_3396":69867,"_29729":69866,"_20626":117297,"_5":14148,"_27027":69866,"_2882":117298},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3396":69868,"_29729":69866,"_5":30079,"_20626":117300,"_27027":117301,"_2882":117302},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3396":69869,"_29729":69866,"_5":30079,"_20626":117304,"_27027":117305,"_2882":22354},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3396":69870,"_29729":69866,"_5":30079,"_20626":117307,"_27027":117308,"_2882":25657},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3396":69871,"_29729":69866,"_5":30079,"_20626":117310,"_27027":117311,"_2882":25664},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3396":69872,"_29729":69866,"_5":30079,"_20626":117313,"_27027":117314,"_2882":24982},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3396":69873,"_29729":69866,"_5":30079,"_20626":117316,"_27027":117317,"_2882":117318},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3396":69874,"_29729":69866,"_5":30079,"_20626":117320,"_27027":117321,"_2882":117322},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3396":69875,"_29729":69866,"_5":30079,"_20626":117324,"_27027":117325,"_2882":117326},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3396":69876,"_29729":69866,"_20626":117328,"_5":14148,"_27027":69866,"_2882":117329},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3396":69877,"_29729":69866,"_20626":117331,"_5":14148,"_27027":117301,"_2882":117332},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3396":69878,"_29729":69866,"_20626":117334,"_5":14148,"_27027":117301,"_2882":115370},[],{"_3396":69879,"_29729":69866,"_20626":117336,"_5":14148,"_27027":117301,"_2882":117337},[],"Método",{"_3396":69880,"_29729":69866,"_20626":117339,"_5":14148,"_27027":117301,"_2882":117340},[],"Autenticación y condición",{"_3396":69881,"_29729":69866,"_20626":117342,"_5":14148,"_27027":117301,"_2882":51670},[],{"_3396":69882,"_29729":69866,"_20626":117344,"_5":14148,"_27027":117301,"_2882":51673},[],{"_3396":69883,"_29729":69866,"_20626":117346,"_5":14148,"_27027":117301,"_2882":117347},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3396":69884,"_29729":69866,"_20626":117349,"_5":14148,"_27027":117301,"_2882":51679},[],{"_3396":69885,"_29729":69866,"_20626":117351,"_5":14148,"_27027":117301,"_2882":51682},[],{"_3396":69886,"_29729":69866,"_20626":117353,"_5":14148,"_27027":117301,"_2882":117354},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3396":69887,"_29729":69866,"_20626":117356,"_5":14148,"_27027":117301,"_2882":51688},[],{"_3396":69888,"_29729":69866,"_20626":117358,"_5":14148,"_27027":117301,"_2882":51682},[],{"_3396":69889,"_29729":69866,"_20626":117360,"_5":14148,"_27027":117301,"_2882":117361},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3396":69890,"_29729":69866,"_20626":117363,"_5":14148,"_27027":117301,"_2882":51696},[],{"_3396":69891,"_29729":69866,"_20626":117365,"_5":14148,"_27027":117301,"_2882":51682},[],{"_3396":69892,"_29729":69866,"_20626":117367,"_5":14148,"_27027":117301,"_2882":117368},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3396":69893,"_29729":69866,"_20626":117370,"_5":14148,"_27027":117301,"_2882":117371},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3396":69894,"_29729":69866,"_20626":117373,"_5":14148,"_27027":117305,"_2882":117374},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3396":69895,"_29729":69866,"_20626":117376,"_5":14148,"_27027":117305,"_2882":117377},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3396":69896,"_29729":69866,"_20626":117379,"_5":14148,"_27027":117308,"_2882":117380},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3396":69897,"_29729":69866,"_20626":117382,"_5":14148,"_27027":117308,"_2882":117383},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3396":69898,"_29729":69866,"_20626":117385,"_5":14148,"_27027":117311,"_2882":117386},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3396":69899,"_29729":69866,"_20626":117388,"_5":14148,"_27027":117311,"_2882":117389},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3396":69900,"_29729":69866,"_20626":117391,"_5":14148,"_27027":117314,"_2882":117392},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3396":69901,"_29729":69866,"_20626":117394,"_5":14148,"_27027":117314,"_2882":117395},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3396":69902,"_29729":69866,"_20626":117397,"_5":14148,"_27027":117317,"_2882":117398},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3396":69903,"_29729":69866,"_20626":117400,"_5":14148,"_27027":117317,"_2882":117401},[],"Parte",{"_3396":69904,"_29729":69866,"_20626":117403,"_5":14148,"_27027":117317,"_2882":117404},[],"Contenido tras decodificar su Base64",{"_3396":69905,"_29729":69866,"_20626":117406,"_5":14148,"_27027":117317,"_2882":51740},[],{"_3396":69906,"_29729":69866,"_20626":117408,"_5":14148,"_27027":117317,"_2882":117409},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3396":69907,"_29729":69866,"_20626":117411,"_5":14148,"_27027":117317,"_2882":51746},[],{"_3396":69908,"_29729":69866,"_20626":117413,"_5":14148,"_27027":117317,"_2882":117414},[],"PKCS#7 DER con el certificado emitido.",{"_3396":69909,"_29729":69866,"_20626":117416,"_5":14148,"_27027":117317,"_2882":117417},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3396":69910,"_29729":69866,"_20626":117419,"_5":14148,"_27027":117321,"_2882":117420},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3396":69911,"_29729":69866,"_20626":117422,"_5":14148,"_27027":117321,"_2882":117423},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3396":69912,"_29729":69866,"_20626":117425,"_5":14148,"_27027":117321,"_2882":117426},[],"Convierte y comprueba el resultado:",{"_3396":69913,"_29729":69866,"_20626":117428,"_5":14148,"_27027":117321,"_2882":117429},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3396":69914,"_29729":69866,"_20626":117431,"_5":14148,"_27027":117325,"_2882":117432},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3396":69915,"_29729":69866,"_20626":117434,"_5":14148,"_27027":117325,"_2882":117435},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3396":69916,"_29729":69916,"_5":14500,"_2882":116794,"_30082":117437,"_20626":117438,"_27027":69916},[48429,115610,50908,116619,116794],[],{"_3396":69917,"_29729":69916,"_20626":117440,"_5":14148,"_27027":69916,"_2882":117441},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3396":69918,"_29729":69916,"_5":30079,"_20626":117443,"_27027":117444,"_2882":117445},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3396":69919,"_29729":69916,"_5":30079,"_20626":117447,"_27027":117448,"_2882":117449},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3396":69920,"_29729":69916,"_5":30079,"_20626":117451,"_27027":117452,"_2882":117453},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3396":69921,"_29729":69916,"_5":30079,"_20626":117455,"_27027":117456,"_2882":117457},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3396":69922,"_29729":69916,"_20626":117459,"_5":14148,"_27027":69916,"_2882":117460},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3396":69923,"_29729":69916,"_20626":117462,"_5":14148,"_27027":117444,"_2882":117463},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3396":69924,"_29729":69916,"_20626":117465,"_5":14148,"_27027":117444,"_2882":117466},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3396":69925,"_29729":69916,"_20626":117468,"_5":14148,"_27027":117444,"_2882":117469},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3396":69926,"_29729":69916,"_20626":117471,"_5":14148,"_27027":117444,"_2882":117472},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3396":69927,"_29729":69916,"_20626":117474,"_5":14148,"_27027":117444,"_2882":117475},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3396":69928,"_29729":69916,"_20626":117477,"_5":14148,"_27027":117444,"_2882":117478},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3396":69929,"_29729":69916,"_20626":117480,"_5":14148,"_27027":117448,"_2882":117481},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3396":69930,"_29729":69916,"_20626":117483,"_5":14148,"_27027":117448,"_2882":117484},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3396":69931,"_29729":69916,"_20626":117486,"_5":14148,"_27027":117448,"_2882":117487},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3396":69932,"_29729":69916,"_20626":117489,"_5":14148,"_27027":117448,"_2882":117490},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3396":69933,"_29729":69916,"_20626":117492,"_5":14148,"_27027":117452,"_2882":117493},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3396":69934,"_29729":69916,"_20626":117495,"_5":14148,"_27027":117452,"_2882":117496},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3396":69935,"_29729":69916,"_20626":117498,"_5":14148,"_27027":117452,"_2882":117499},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3396":69936,"_29729":69916,"_20626":117501,"_5":14148,"_27027":117452,"_2882":117502},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3396":69937,"_29729":69916,"_20626":117504,"_5":14148,"_27027":117456,"_2882":117505},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3396":69938,"_29729":69916,"_20626":117507,"_5":14148,"_27027":117456,"_2882":117508},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3396":69939,"_29729":69939,"_5":14500,"_2882":117510,"_30082":117511,"_20626":117512,"_27027":69939},"Estrategias de aprovisionamiento",[48429,115610,50908,116619,116794],[],{"_3396":69940,"_29729":69939,"_20626":117514,"_5":14148,"_27027":69939,"_2882":117515},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3396":69941,"_29729":69939,"_5":30079,"_20626":117517,"_27027":117518,"_2882":117519},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3396":69942,"_29729":69939,"_5":30079,"_20626":117521,"_27027":117522,"_2882":117523},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3396":69943,"_29729":69939,"_5":30079,"_20626":117525,"_27027":117526,"_2882":117527},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3396":69944,"_29729":69939,"_5":30079,"_20626":117529,"_27027":117530,"_2882":117531},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3396":69945,"_29729":69939,"_5":30079,"_20626":117533,"_27027":117534,"_2882":117535},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3396":69946,"_29729":69939,"_20626":117537,"_5":14148,"_27027":69939,"_2882":117538},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3396":69947,"_29729":69939,"_20626":117540,"_5":14148,"_27027":117518,"_2882":117541},[],"Recorrido",{"_3396":69948,"_29729":69939,"_20626":117543,"_5":14148,"_27027":117518,"_2882":117544},[],"Cuándo existe el dispositivo",{"_3396":69949,"_29729":69939,"_20626":117546,"_5":14148,"_27027":117518,"_2882":117547},[],"Qué compruebas",{"_3396":69950,"_29729":69939,"_20626":117549,"_5":14148,"_27027":117518,"_2882":117550},[],"Asignación manual",{"_3396":69951,"_29729":69939,"_20626":117552,"_5":14148,"_27027":117518,"_2882":117553},[],"El operador lo crea antes de asociar un certificado.",{"_3396":69952,"_29729":69939,"_20626":117555,"_5":14148,"_27027":117518,"_2882":117556},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3396":69953,"_29729":69939,"_20626":117558,"_5":14148,"_27027":117518,"_2882":117559},[],"EST con `JITP`",{"_3396":69954,"_29729":69939,"_20626":117561,"_5":14148,"_27027":117518,"_2882":117562},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3396":69955,"_29729":69939,"_20626":117564,"_5":14148,"_27027":117518,"_2882":117565},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3396":69956,"_29729":69939,"_20626":117567,"_5":14148,"_27027":117518,"_2882":117568},[],"EST con `PRE_REGISTRATION`",{"_3396":69957,"_29729":69939,"_20626":117570,"_5":14148,"_27027":117518,"_2882":117571},[],"Debe existir antes de `/simpleenroll`.",{"_3396":69958,"_29729":69939,"_20626":117573,"_5":14148,"_27027":117518,"_2882":117574},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3396":69959,"_29729":69939,"_20626":117576,"_5":14148,"_27027":117518,"_2882":117577},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3396":69960,"_29729":69939,"_20626":117579,"_5":14148,"_27027":117518,"_2882":117580},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3396":69961,"_29729":69939,"_20626":117582,"_5":14148,"_27027":117522,"_2882":117583},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3396":69962,"_29729":69939,"_20626":117585,"_5":14148,"_27027":117522,"_2882":117586},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3396":69963,"_29729":69939,"_20626":117588,"_5":14148,"_27027":117522,"_2882":117589},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3396":69964,"_29729":69939,"_20626":117591,"_5":14148,"_27027":117526,"_2882":117592},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3396":69965,"_29729":69939,"_20626":117594,"_5":14148,"_27027":117526,"_2882":117595},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3396":69966,"_29729":69939,"_20626":117597,"_5":14148,"_27027":117526,"_2882":117598},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3396":69967,"_29729":69939,"_20626":117600,"_5":14148,"_27027":117526,"_2882":117601},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3396":69968,"_29729":69939,"_20626":117603,"_5":14148,"_27027":117526,"_2882":117604},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3396":69969,"_29729":69939,"_20626":117606,"_5":14148,"_27027":117526,"_2882":117607},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3396":69970,"_29729":69939,"_20626":117609,"_5":14148,"_27027":117530,"_2882":114552},[],{"_3396":69971,"_29729":69939,"_20626":117611,"_5":14148,"_27027":117530,"_2882":117612},[],"Material que atraviesa EST",{"_3396":69972,"_29729":69939,"_20626":117614,"_5":14148,"_27027":117530,"_2882":117615},[],"Clave generada por el dispositivo",{"_3396":69973,"_29729":69939,"_20626":117617,"_5":14148,"_27027":117530,"_2882":117618},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3396":69974,"_29729":69939,"_20626":117620,"_5":14148,"_27027":117530,"_2882":117621},[],"Clave ya disponible en el dispositivo",{"_3396":69975,"_29729":69939,"_20626":117623,"_5":14148,"_27027":117530,"_2882":117624},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3396":69976,"_29729":69939,"_20626":117626,"_5":14148,"_27027":117530,"_2882":51227},[],{"_3396":69977,"_29729":69939,"_20626":117628,"_5":14148,"_27027":117530,"_2882":117629},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3396":69978,"_29729":69939,"_20626":117631,"_5":14148,"_27027":117530,"_2882":117632},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3396":69979,"_29729":69939,"_20626":117634,"_5":14148,"_27027":117534,"_2882":117635},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3396":69980,"_29729":69980,"_5":14500,"_2882":117637,"_30082":117638,"_20626":117639,"_27027":69980},"Renovación y recuperación",[48429,115610,50908,116619,116794],[],{"_3396":69981,"_29729":69980,"_20626":117641,"_5":14148,"_27027":69980,"_2882":117642},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3396":69982,"_29729":69980,"_5":30079,"_20626":117644,"_27027":117645,"_2882":117646},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3396":69983,"_29729":69980,"_5":30079,"_20626":117648,"_27027":117649,"_2882":117650},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3396":69984,"_29729":69980,"_5":30079,"_20626":117652,"_27027":117653,"_2882":117654},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3396":69985,"_29729":69980,"_5":30079,"_20626":117656,"_27027":117657,"_2882":117658},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3396":69986,"_29729":69980,"_5":30079,"_20626":117660,"_27027":117661,"_2882":117662},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3396":69987,"_29729":69980,"_20626":117664,"_5":14148,"_27027":69980,"_2882":117665},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3396":69988,"_29729":69980,"_20626":117667,"_5":14148,"_27027":117645,"_2882":117668},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3396":69989,"_29729":69980,"_20626":117670,"_5":14148,"_27027":117645,"_2882":117671},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3396":69990,"_29729":69980,"_20626":117673,"_5":14148,"_27027":117645,"_2882":117674},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3396":69991,"_29729":69980,"_20626":117676,"_5":14148,"_27027":117645,"_2882":117677},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3396":69992,"_29729":69980,"_20626":117679,"_5":14148,"_27027":117649,"_2882":117680},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3396":69993,"_29729":69980,"_20626":117682,"_5":14148,"_27027":117649,"_2882":117683},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3396":69994,"_29729":69980,"_20626":117685,"_5":14148,"_27027":117653,"_2882":117686},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3396":69995,"_29729":69980,"_20626":117688,"_5":14148,"_27027":117653,"_2882":117689},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3396":69996,"_29729":69980,"_20626":117691,"_5":14148,"_27027":117653,"_2882":117692},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3396":69997,"_29729":69980,"_20626":117694,"_5":14148,"_27027":117657,"_2882":117695},[],"Situación",{"_3396":69998,"_29729":69980,"_20626":117697,"_5":14148,"_27027":117657,"_2882":117698},[],"Procedimiento",{"_3396":69999,"_29729":69980,"_20626":117700,"_5":14148,"_27027":117657,"_2882":117701},[],"Certificado vigente, fuera de ventana",{"_3396":70000,"_29729":69980,"_20626":117703,"_5":14148,"_27027":117657,"_2882":117704},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3396":70001,"_29729":69980,"_20626":117706,"_5":14148,"_27027":117657,"_2882":117707},[],"Certificado vencido, clave disponible",{"_3396":70002,"_29729":69980,"_20626":117709,"_5":14148,"_27027":117657,"_2882":117710},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3396":70003,"_29729":69980,"_20626":117712,"_5":14148,"_27027":117657,"_2882":117713},[],"Renovación por webhook o `NO_AUTH`",{"_3396":70004,"_29729":69980,"_20626":117715,"_5":14148,"_27027":117657,"_2882":117716},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3396":70005,"_29729":69980,"_20626":117718,"_5":14148,"_27027":117657,"_2882":117719},[],"Clave perdida o inaccesible",{"_3396":70006,"_29729":69980,"_20626":117721,"_5":14148,"_27027":117657,"_2882":117722},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3396":70007,"_29729":69980,"_20626":117724,"_5":14148,"_27027":117657,"_2882":117725},[],"Identidad actual revocada",{"_3396":70008,"_29729":69980,"_20626":117727,"_5":14148,"_27027":117657,"_2882":117728},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3396":70009,"_29729":69980,"_20626":117730,"_5":14148,"_27027":117657,"_2882":117731},[],"Dispositivo sin identidad",{"_3396":70010,"_29729":69980,"_20626":117733,"_5":14148,"_27027":117657,"_2882":117734},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3396":70011,"_29729":69980,"_20626":117736,"_5":14148,"_27027":117657,"_2882":117737},[],"Dispositivo retirado",{"_3396":70012,"_29729":69980,"_20626":117739,"_5":14148,"_27027":117657,"_2882":117740},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3396":70013,"_29729":69980,"_20626":117742,"_5":14148,"_27027":117657,"_2882":117743},[],"Timeout, HTTP 500 o fallo de instalación",{"_3396":70014,"_29729":69980,"_20626":117745,"_5":14148,"_27027":117657,"_2882":117746},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3396":70015,"_29729":69980,"_20626":117748,"_5":14148,"_27027":117661,"_2882":117749},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3396":70016,"_29729":69980,"_20626":117751,"_5":14148,"_27027":117661,"_2882":117752},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3396":70017,"_29729":70017,"_5":14500,"_2882":117754,"_30082":117755,"_20626":117756,"_27027":70017},"Diagnóstico de enrolamiento",[48429,115610,50908,116619,116794],[],{"_3396":70018,"_29729":70017,"_20626":117758,"_5":14148,"_27027":70017,"_2882":117759},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3396":70019,"_29729":70017,"_5":30079,"_20626":117761,"_27027":117762,"_2882":117763},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3396":70020,"_29729":70017,"_5":30079,"_20626":117765,"_27027":117766,"_2882":117767},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3396":70021,"_29729":70017,"_5":30079,"_20626":117769,"_27027":117770,"_2882":117326},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3396":70022,"_29729":70017,"_5":30079,"_20626":117772,"_27027":117773,"_2882":117774},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3396":70023,"_29729":70017,"_20626":117776,"_5":14148,"_27027":70017,"_2882":117777},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3396":70024,"_29729":70017,"_20626":117779,"_5":14148,"_27027":117766,"_2882":117780},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3396":70025,"_29729":70017,"_20626":117782,"_5":14148,"_27027":117766,"_2882":117783},[],"Síntoma o mensaje",{"_3396":70026,"_29729":70017,"_20626":117785,"_5":14148,"_27027":117766,"_2882":117786},[],"Qué revisar",{"_3396":70027,"_29729":70017,"_20626":117788,"_5":14148,"_27027":117766,"_2882":117789},[],"curl rechaza TLS, nombre o emisor",{"_3396":70028,"_29729":70017,"_20626":117791,"_5":14148,"_27027":117766,"_2882":117792},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3396":70029,"_29729":70017,"_20626":117794,"_5":14148,"_27027":117766,"_2882":117795},[],"404 o APS ausente",{"_3396":70030,"_29729":70017,"_20626":117797,"_5":14148,"_27027":117766,"_2882":117798},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3396":70031,"_29729":70017,"_20626":117800,"_5":14148,"_27027":117766,"_2882":117801},[],"400, error de CSR o formato",{"_3396":70032,"_29729":70017,"_20626":117803,"_5":14148,"_27027":117766,"_2882":117804},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3396":70033,"_29729":70017,"_20626":117806,"_5":14148,"_27027":117766,"_2882":117807},[],"Credencial ausente o certificado no válido",{"_3396":70034,"_29729":70017,"_20626":117809,"_5":14148,"_27027":117766,"_2882":117810},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3396":70035,"_29729":70017,"_20626":117812,"_5":14148,"_27027":117766,"_2882":117813},[],"Webhook deniega, expira o responde sin autorización",{"_3396":70036,"_29729":70017,"_20626":117815,"_5":14148,"_27027":117766,"_2882":117816},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3396":70037,"_29729":70017,"_20626":117818,"_5":14148,"_27027":117766,"_2882":52153},[],{"_3396":70038,"_29729":70017,"_20626":117820,"_5":14148,"_27027":117766,"_2882":117821},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3396":70039,"_29729":70017,"_20626":117823,"_5":14148,"_27027":117766,"_2882":52159},[],{"_3396":70040,"_29729":70017,"_20626":117825,"_5":14148,"_27027":117766,"_2882":117826},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3396":70041,"_29729":70017,"_20626":117828,"_5":14148,"_27027":117766,"_2882":52165},[],{"_3396":70042,"_29729":70017,"_20626":117830,"_5":14148,"_27027":117766,"_2882":117831},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3396":70043,"_29729":70017,"_20626":117833,"_5":14148,"_27027":117766,"_2882":52171},[],{"_3396":70044,"_29729":70017,"_20626":117835,"_5":14148,"_27027":117766,"_2882":117836},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3396":70045,"_29729":70017,"_20626":117838,"_5":14148,"_27027":117766,"_2882":52177},[],{"_3396":70046,"_29729":70017,"_20626":117840,"_5":14148,"_27027":117766,"_2882":117841},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3396":70047,"_29729":70017,"_20626":117843,"_5":14148,"_27027":117766,"_2882":117844},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3396":70048,"_29729":70017,"_20626":117846,"_5":14148,"_27027":117766,"_2882":117847},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3396":70049,"_29729":70017,"_20626":117849,"_5":14148,"_27027":117766,"_2882":117850},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3396":70050,"_29729":70017,"_20626":117852,"_5":14148,"_27027":117766,"_2882":117853},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3396":70051,"_29729":70017,"_20626":117855,"_5":14148,"_27027":117766,"_2882":52195},[],{"_3396":70052,"_29729":70017,"_20626":117857,"_5":14148,"_27027":117766,"_2882":117858},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3396":70053,"_29729":70017,"_20626":117860,"_5":14148,"_27027":117766,"_2882":52201},[],{"_3396":70054,"_29729":70017,"_20626":117862,"_5":14148,"_27027":117766,"_2882":117863},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3396":70055,"_29729":70017,"_20626":117865,"_5":14148,"_27027":117766,"_2882":117866},[],"DMS propietario distinto",{"_3396":70056,"_29729":70017,"_20626":117868,"_5":14148,"_27027":117766,"_2882":117869},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3396":70057,"_29729":70017,"_20626":117871,"_5":14148,"_27027":117766,"_2882":52213},[],{"_3396":70058,"_29729":70017,"_20626":117873,"_5":14148,"_27027":117766,"_2882":117874},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3396":70059,"_29729":70017,"_20626":117876,"_5":14148,"_27027":117766,"_2882":52219},[],{"_3396":70060,"_29729":70017,"_20626":117878,"_5":14148,"_27027":117766,"_2882":117879},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3396":70061,"_29729":70017,"_20626":117881,"_5":14148,"_27027":117766,"_2882":117882},[],"Certificado actual revocado",{"_3396":70062,"_29729":70017,"_20626":117884,"_5":14148,"_27027":117766,"_2882":117885},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3396":70063,"_29729":70017,"_20626":117887,"_5":14148,"_27027":117766,"_2882":117888},[],"Error de CA, perfil o firma",{"_3396":70064,"_29729":70017,"_20626":117890,"_5":14148,"_27027":117766,"_2882":117891},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3396":70065,"_29729":70017,"_20626":117893,"_5":14148,"_27027":117766,"_2882":117894},[],"HTTP 200 sin conexión del dispositivo",{"_3396":70066,"_29729":70017,"_20626":117896,"_5":14148,"_27027":117766,"_2882":117897},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3396":70067,"_29729":70017,"_20626":117899,"_5":14148,"_27027":117766,"_2882":117900},[],"Timeout o error después de emitir",{"_3396":70068,"_29729":70017,"_20626":117902,"_5":14148,"_27027":117766,"_2882":117903},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3396":70069,"_29729":70017,"_20626":117905,"_5":14148,"_27027":117770,"_2882":117906},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3396":70070,"_29729":70017,"_20626":117908,"_5":14148,"_27027":117770,"_2882":117909},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3396":70071,"_29729":70017,"_20626":117911,"_5":14148,"_27027":117773,"_2882":117912},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3396":70072,"_29729":70017,"_20626":117914,"_5":14148,"_27027":117773,"_2882":117915},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3396":70073,"_29729":70017,"_20626":117917,"_5":14148,"_27027":117773,"_2882":117918},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3396":70074,"_29729":70017,"_20626":117920,"_5":14148,"_27027":117773,"_2882":117921},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3396":70075,"_29729":70017,"_20626":117923,"_5":14148,"_27027":117773,"_2882":117924},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3396":70076,"_29729":70017,"_20626":117926,"_5":14148,"_27027":117773,"_2882":117927},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3396":70077,"_29729":70017,"_20626":117929,"_5":14148,"_27027":117773,"_2882":117930},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3396":70078,"_29729":70078,"_5":14500,"_2882":117932,"_30082":117933,"_20626":117934,"_27027":70078},"Distribución y actualización de confianza",[48429,115610,50908,116619,116794],[],{"_3396":70079,"_29729":70078,"_20626":117936,"_5":14148,"_27027":70078,"_2882":117937},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3396":70080,"_29729":70078,"_5":30079,"_20626":117939,"_27027":117940,"_2882":117941},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3396":70081,"_29729":70078,"_5":30079,"_20626":117943,"_27027":117944,"_2882":117945},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3396":70082,"_29729":70078,"_5":30079,"_20626":117947,"_27027":117948,"_2882":117949},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3396":70083,"_29729":70078,"_5":30079,"_20626":117951,"_27027":117952,"_2882":117953},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3396":70084,"_29729":70078,"_5":30079,"_20626":117955,"_27027":117956,"_2882":117957},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3396":70085,"_29729":70078,"_20626":117959,"_5":14148,"_27027":70078,"_2882":117960},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3396":70086,"_29729":70078,"_20626":117962,"_5":14148,"_27027":117940,"_2882":117963},[],"Relación",{"_3396":70087,"_29729":70078,"_20626":117965,"_5":14148,"_27027":117940,"_2882":117966},[],"Material que prepara el responsable",{"_3396":70088,"_29729":70078,"_20626":117968,"_5":14148,"_27027":117940,"_2882":117969},[],"Dispositivo → servidor EST",{"_3396":70089,"_29729":70078,"_20626":117971,"_5":14148,"_27027":117940,"_2882":117972},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3396":70090,"_29729":70078,"_20626":117974,"_5":14148,"_27027":117940,"_2882":117975},[],"DMS → solicitante",{"_3396":70091,"_29729":70078,"_20626":117977,"_5":14148,"_27027":117940,"_2882":117978},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3396":70092,"_29729":70078,"_20626":117980,"_5":14148,"_27027":117940,"_2882":117981},[],"Consumidor → dispositivo",{"_3396":70093,"_29729":70078,"_20626":117983,"_5":14148,"_27027":117940,"_2882":117984},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3396":70094,"_29729":70078,"_20626":117986,"_5":14148,"_27027":117940,"_2882":117987},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3396":70095,"_29729":70078,"_20626":117989,"_5":14148,"_27027":117944,"_2882":117990},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3396":70096,"_29729":70078,"_20626":117992,"_5":14148,"_27027":117944,"_2882":117993},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3396":70097,"_29729":70078,"_20626":117995,"_5":14148,"_27027":117948,"_2882":117996},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3396":70098,"_29729":70078,"_20626":117998,"_5":14148,"_27027":117948,"_2882":117999},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3396":70099,"_29729":70078,"_20626":118001,"_5":14148,"_27027":117948,"_2882":118002},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3396":70100,"_29729":70078,"_20626":118004,"_5":14148,"_27027":117948,"_2882":118005},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3396":70101,"_29729":70078,"_20626":118007,"_5":14148,"_27027":117948,"_2882":118008},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3396":70102,"_29729":70078,"_20626":118010,"_5":14148,"_27027":117948,"_2882":118011},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3396":70103,"_29729":70078,"_20626":118013,"_5":14148,"_27027":117952,"_2882":118014},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3396":70104,"_29729":70078,"_20626":118016,"_5":14148,"_27027":117952,"_2882":118017},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3396":70105,"_29729":70078,"_20626":118019,"_5":14148,"_27027":117952,"_2882":118020},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3396":70106,"_29729":70078,"_20626":118022,"_5":14148,"_27027":117956,"_2882":118023},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3396":70107,"_29729":70107,"_5":14500,"_2882":52368,"_30082":118025,"_20626":118027,"_27027":70107},[48429,115610,50908,116619,118026],"Integraciones",[],{"_3396":70108,"_29729":70107,"_20626":118029,"_5":14148,"_27027":70107,"_2882":118030},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3396":70109,"_29729":70107,"_5":30079,"_20626":118032,"_27027":118033,"_2882":118034},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3396":70110,"_29729":70107,"_5":30079,"_20626":118036,"_27027":118037,"_2882":118038},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3396":70111,"_29729":70107,"_5":30079,"_20626":118040,"_27027":118041,"_2882":118042},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3396":70112,"_29729":70107,"_5":30079,"_20626":118044,"_27027":118045,"_2882":118046},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3396":70113,"_29729":70107,"_5":30079,"_20626":118048,"_27027":118049,"_2882":118050},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3396":70114,"_29729":70107,"_5":30079,"_20626":118052,"_27027":118053,"_2882":118054},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3396":70115,"_29729":70107,"_5":30079,"_20626":118056,"_27027":118057,"_2882":118058},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3396":70116,"_29729":70107,"_5":30079,"_20626":118060,"_27027":118061,"_2882":118062},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3396":70117,"_29729":70107,"_5":30079,"_20626":118064,"_27027":118065,"_2882":52410},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3396":70118,"_29729":70107,"_5":30079,"_20626":118067,"_27027":118068,"_2882":52414},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3396":70119,"_29729":70107,"_5":30079,"_20626":118070,"_27027":118071,"_2882":118072},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3396":70120,"_29729":70107,"_5":30079,"_20626":118074,"_27027":118075,"_2882":118076},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3396":70121,"_29729":70107,"_5":30079,"_20626":118078,"_27027":118079,"_2882":118080},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3396":70122,"_29729":70107,"_5":30079,"_20626":118082,"_27027":118083,"_2882":118084},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3396":70123,"_29729":70107,"_5":30079,"_20626":118086,"_27027":118087,"_2882":118088},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3396":70124,"_29729":70107,"_5":30079,"_20626":118090,"_27027":118091,"_2882":118092},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3396":70125,"_29729":70107,"_5":30079,"_20626":118094,"_27027":118095,"_2882":118096},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3396":70126,"_29729":70107,"_5":30079,"_20626":118098,"_27027":118099,"_2882":118100},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3396":70127,"_29729":70107,"_5":30079,"_20626":118102,"_27027":118103,"_2882":118104},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3396":70128,"_29729":70107,"_5":30079,"_20626":118106,"_27027":118107,"_2882":118108},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3396":70129,"_29729":70107,"_5":30079,"_20626":118110,"_27027":118111,"_2882":118112},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3396":70130,"_29729":70107,"_5":30079,"_20626":118114,"_27027":118115,"_2882":118116},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3396":70131,"_29729":70107,"_5":30079,"_20626":118118,"_27027":118119,"_2882":118120},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3396":70132,"_29729":70107,"_5":30079,"_20626":118122,"_27027":118123,"_2882":118124},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3396":70133,"_29729":70107,"_5":30079,"_20626":118126,"_27027":118127,"_2882":118128},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3396":70134,"_29729":70107,"_20626":118130,"_5":14148,"_27027":70107,"_2882":118131},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3396":70135,"_29729":70107,"_20626":118133,"_5":14148,"_27027":70107,"_2882":118134},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3396":70136,"_29729":70107,"_20626":118136,"_5":14148,"_27027":70107,"_2882":118137},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3396":70137,"_29729":70107,"_20626":118139,"_5":14148,"_27027":118033,"_2882":118140},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3396":70138,"_29729":70107,"_20626":118142,"_5":14148,"_27027":118033,"_2882":118143},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3396":70139,"_29729":70107,"_20626":118145,"_5":14148,"_27027":118033,"_2882":118146},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3396":70140,"_29729":70107,"_20626":118148,"_5":14148,"_27027":118033,"_2882":118149},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3396":70141,"_29729":70107,"_20626":118151,"_5":14148,"_27027":118037,"_2882":118152},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3396":70142,"_29729":70107,"_20626":118154,"_5":14148,"_27027":118041,"_2882":118155},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3396":70143,"_29729":70107,"_20626":118157,"_5":14148,"_27027":118041,"_2882":118158},[],"Acción IAM",{"_3396":70144,"_29729":70107,"_20626":118160,"_5":14148,"_27027":118041,"_2882":114558},[],{"_3396":70145,"_29729":70107,"_20626":118162,"_5":14148,"_27027":118041,"_2882":52509},[],{"_3396":70146,"_29729":70107,"_20626":118164,"_5":14148,"_27027":118041,"_2882":118165},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3396":70147,"_29729":70107,"_20626":118167,"_5":14148,"_27027":118041,"_2882":52515},[],{"_3396":70148,"_29729":70107,"_20626":118169,"_5":14148,"_27027":118041,"_2882":118170},[],"Registrar la CA en AWS IoT",{"_3396":70149,"_29729":70107,"_20626":118172,"_5":14148,"_27027":118041,"_2882":52521},[],{"_3396":70150,"_29729":70107,"_20626":118174,"_5":14148,"_27027":118041,"_2882":118175},[],"Consultar el estado del registro de la CA",{"_3396":70151,"_29729":70107,"_20626":118177,"_5":14148,"_27027":118041,"_2882":52527},[],{"_3396":70152,"_29729":70107,"_20626":118179,"_5":14148,"_27027":118041,"_2882":118180},[],"Crear o actualizar Things en IoT Core",{"_3396":70153,"_29729":70107,"_20626":118182,"_5":14148,"_27027":118041,"_2882":52533},[],{"_3396":70154,"_29729":70107,"_20626":118184,"_5":14148,"_27027":118041,"_2882":118185},[],"Aprovisionar Things mediante plantilla",{"_3396":70155,"_29729":70107,"_20626":118187,"_5":14148,"_27027":118041,"_2882":52539},[],{"_3396":70156,"_29729":70107,"_20626":118189,"_5":14148,"_27027":118041,"_2882":118190},[],"Registrar certificados de dispositivo",{"_3396":70157,"_29729":70107,"_20626":118192,"_5":14148,"_27027":118041,"_2882":52545},[],{"_3396":70158,"_29729":70107,"_20626":118194,"_5":14148,"_27027":118041,"_2882":118195},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3396":70159,"_29729":70107,"_20626":118197,"_5":14148,"_27027":118041,"_2882":52551},[],{"_3396":70160,"_29729":70107,"_20626":118199,"_5":14148,"_27027":118041,"_2882":118200},[],"Crear y adjuntar políticas IoT",{"_3396":70161,"_29729":70107,"_20626":118202,"_5":14148,"_27027":118041,"_2882":52557},[],{"_3396":70162,"_29729":70107,"_20626":118204,"_5":14148,"_27027":118041,"_2882":118205},[],"Gestionar grupos de Things",{"_3396":70163,"_29729":70107,"_20626":118207,"_5":14148,"_27027":118041,"_2882":52563},[],{"_3396":70164,"_29729":70107,"_20626":118209,"_5":14148,"_27027":118041,"_2882":118210},[],"Crear plantillas JITP",{"_3396":70165,"_29729":70107,"_20626":118212,"_5":14148,"_27027":118041,"_2882":52569},[],{"_3396":70166,"_29729":70107,"_20626":118214,"_5":14148,"_27027":118041,"_2882":118215},[],"Leer y escribir el Device Shadow",{"_3396":70167,"_29729":70107,"_20626":118217,"_5":14148,"_27027":118041,"_2882":118218},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3396":70168,"_29729":70107,"_20626":118220,"_5":14148,"_27027":118045,"_2882":118221},[],"Parámetro",{"_3396":70169,"_29729":70107,"_20626":118223,"_5":14148,"_27027":118045,"_2882":118224},[],"Tipo",{"_3396":70170,"_29729":70107,"_20626":118226,"_5":14148,"_27027":118045,"_2882":118227},[],"Requerido",{"_3396":70171,"_29729":70107,"_20626":118229,"_5":14148,"_27027":118045,"_2882":118230},[],"Descripción",{"_3396":70172,"_29729":70107,"_20626":118232,"_5":14148,"_27027":118045,"_2882":52590},[],{"_3396":70173,"_29729":70107,"_20626":118234,"_5":14148,"_27027":118045,"_2882":24632},[],{"_3396":70174,"_29729":70107,"_20626":118236,"_5":14148,"_27027":118045,"_2882":118237},[],"Sí",{"_3396":70175,"_29729":70107,"_20626":118239,"_5":14148,"_27027":118045,"_2882":118240},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3396":70176,"_29729":70107,"_20626":118242,"_5":14148,"_27027":118045,"_2882":52601},[],{"_3396":70177,"_29729":70107,"_20626":118244,"_5":14148,"_27027":118045,"_2882":24632},[],{"_3396":70178,"_29729":70107,"_20626":118246,"_5":14148,"_27027":118045,"_2882":118237},[],{"_3396":70179,"_29729":70107,"_20626":118248,"_5":14148,"_27027":118045,"_2882":118249},[],"Región AWS donde opera el conector.",{"_3396":70180,"_29729":70107,"_20626":118251,"_5":14148,"_27027":118045,"_2882":52611},[],{"_3396":70181,"_29729":70107,"_20626":118253,"_5":14148,"_27027":118045,"_2882":24632},[],{"_3396":70182,"_29729":70107,"_20626":118255,"_5":14148,"_27027":118045,"_2882":118237},[],{"_3396":70183,"_29729":70107,"_20626":118257,"_5":14148,"_27027":118045,"_2882":118258},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3396":70184,"_29729":70107,"_20626":118260,"_5":14148,"_27027":118045,"_2882":52621},[],{"_3396":70185,"_29729":70107,"_20626":118262,"_5":14148,"_27027":118045,"_2882":24632},[],{"_3396":70186,"_29729":70107,"_20626":118264,"_5":14148,"_27027":118045,"_2882":118265},[],"Solo con `auth_method=static`",{"_3396":70187,"_29729":70107,"_20626":118267,"_5":14148,"_27027":118045,"_2882":118268},[],"Clave de acceso AWS.",{"_3396":70188,"_29729":70107,"_20626":118270,"_5":14148,"_27027":118045,"_2882":52632},[],{"_3396":70189,"_29729":70107,"_20626":118272,"_5":14148,"_27027":118045,"_2882":24632},[],{"_3396":70190,"_29729":70107,"_20626":118274,"_5":14148,"_27027":118045,"_2882":118265},[],{"_3396":70191,"_29729":70107,"_20626":118276,"_5":14148,"_27027":118045,"_2882":118277},[],"Clave secreta AWS.",{"_3396":70192,"_29729":70107,"_20626":118279,"_5":14148,"_27027":118045,"_2882":52642},[],{"_3396":70193,"_29729":70107,"_20626":118281,"_5":14148,"_27027":118045,"_2882":24632},[],{"_3396":70194,"_29729":70107,"_20626":118283,"_5":14148,"_27027":118045,"_2882":52647},[],{"_3396":70195,"_29729":70107,"_20626":118285,"_5":14148,"_27027":118045,"_2882":118286},[],"Token de sesión (con `auth_method=static`).",{"_3396":70196,"_29729":70107,"_20626":118288,"_5":14148,"_27027":118045,"_2882":52653},[],{"_3396":70197,"_29729":70107,"_20626":118290,"_5":14148,"_27027":118045,"_2882":24632},[],{"_3396":70198,"_29729":70107,"_20626":118292,"_5":14148,"_27027":118045,"_2882":118293},[],"Solo con `auth_method=role`",{"_3396":70199,"_29729":70107,"_20626":118295,"_5":14148,"_27027":118045,"_2882":118296},[],"ARN del rol a asumir.",{"_3396":70200,"_29729":70107,"_20626":118298,"_5":14148,"_27027":118045,"_2882":52664},[],{"_3396":70201,"_29729":70107,"_20626":118300,"_5":14148,"_27027":118045,"_2882":24632},[],{"_3396":70202,"_29729":70107,"_20626":118302,"_5":14148,"_27027":118045,"_2882":52647},[],{"_3396":70203,"_29729":70107,"_20626":118304,"_5":14148,"_27027":118045,"_2882":118305},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3396":70204,"_29729":70107,"_20626":118307,"_5":14148,"_27027":118045,"_2882":52674},[],{"_3396":70205,"_29729":70107,"_20626":118309,"_5":14148,"_27027":118045,"_2882":88118},[],{"_3396":70206,"_29729":70107,"_20626":118311,"_5":14148,"_27027":118045,"_2882":118237},[],{"_3396":70207,"_29729":70107,"_20626":118313,"_5":14148,"_27027":118045,"_2882":118314},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3396":70208,"_29729":70107,"_20626":118316,"_5":14148,"_27027":118045,"_2882":52684},[],{"_3396":70209,"_29729":70107,"_20626":118318,"_5":14148,"_27027":118045,"_2882":24632},[],{"_3396":70210,"_29729":70107,"_20626":118320,"_5":14148,"_27027":118045,"_2882":118237},[],{"_3396":70211,"_29729":70107,"_20626":118322,"_5":14148,"_27027":118045,"_2882":118323},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3396":70212,"_29729":70107,"_20626":118325,"_5":14148,"_27027":118045,"_2882":52694},[],{"_3396":70213,"_29729":70107,"_20626":118327,"_5":14148,"_27027":118045,"_2882":24632},[],{"_3396":70214,"_29729":70107,"_20626":118329,"_5":14148,"_27027":118045,"_2882":118237},[],{"_3396":70215,"_29729":70107,"_20626":118331,"_5":14148,"_27027":118045,"_2882":118332},[],"URL HTTP del Device Manager de Lamassu.",{"_3396":70216,"_29729":70107,"_20626":118334,"_5":14148,"_27027":118045,"_2882":52704},[],{"_3396":70217,"_29729":70107,"_20626":118336,"_5":14148,"_27027":118045,"_2882":24632},[],{"_3396":70218,"_29729":70107,"_20626":118338,"_5":14148,"_27027":118045,"_2882":118237},[],{"_3396":70219,"_29729":70107,"_20626":118340,"_5":14148,"_27027":118045,"_2882":118341},[],"URL HTTP del servicio de CA de Lamassu.",{"_3396":70220,"_29729":70107,"_20626":118343,"_5":14148,"_27027":118049,"_2882":118344},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3396":70221,"_29729":70107,"_20626":118346,"_5":14148,"_27027":118049,"_2882":118347},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3396":70222,"_29729":70107,"_20626":118349,"_5":14148,"_27027":118049,"_2882":118350},[],"Tipo de CloudEvent",{"_3396":70223,"_29729":70107,"_20626":118352,"_5":14148,"_27027":118049,"_2882":118353},[],"Recurso en Lamassu",{"_3396":70224,"_29729":70107,"_20626":118355,"_5":14148,"_27027":118049,"_2882":118356},[],"Recurso AWS",{"_3396":70225,"_29729":70107,"_20626":118358,"_5":14148,"_27027":118049,"_2882":118359},[],"Acciones IAM",{"_3396":70226,"_29729":70107,"_20626":118361,"_5":14148,"_27027":118049,"_2882":118362},[],"Llamadas AWS y efecto",{"_3396":70227,"_29729":70107,"_20626":118364,"_5":14148,"_27027":118049,"_2882":118365},[],"Dónde en esta página",{"_3396":70228,"_29729":70107,"_20626":118367,"_5":14148,"_27027":118049,"_2882":52738},[],{"_3396":70229,"_29729":70107,"_20626":118369,"_5":14148,"_27027":118049,"_2882":52741},[],{"_3396":70230,"_29729":70107,"_20626":118371,"_5":14148,"_27027":118049,"_2882":52744},[],{"_3396":70231,"_29729":70107,"_20626":118373,"_5":14148,"_27027":118049,"_2882":52747},[],{"_3396":70232,"_29729":70107,"_20626":118375,"_5":14148,"_27027":118049,"_2882":118376},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3396":70233,"_29729":70107,"_20626":118378,"_5":14148,"_27027":118049,"_2882":118062},[],{"_3396":70234,"_29729":70107,"_20626":118380,"_5":14148,"_27027":118049,"_2882":52755},[],{"_3396":70235,"_29729":70107,"_20626":118382,"_5":14148,"_27027":118049,"_2882":52758},[],{"_3396":70236,"_29729":70107,"_20626":118384,"_5":14148,"_27027":118049,"_2882":52761},[],{"_3396":70237,"_29729":70107,"_20626":118386,"_5":14148,"_27027":118049,"_2882":52764},[],{"_3396":70238,"_29729":70107,"_20626":118388,"_5":14148,"_27027":118049,"_2882":118389},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3396":70239,"_29729":70107,"_20626":118391,"_5":14148,"_27027":118049,"_2882":118088},[],{"_3396":70240,"_29729":70107,"_20626":118393,"_5":14148,"_27027":118049,"_2882":52772},[],{"_3396":70241,"_29729":70107,"_20626":118395,"_5":14148,"_27027":118049,"_2882":118396},[],"Dispositivo",{"_3396":70242,"_29729":70107,"_20626":118398,"_5":14148,"_27027":118049,"_2882":52778},[],{"_3396":70243,"_29729":70107,"_20626":118400,"_5":14148,"_27027":118049,"_2882":52781},[],{"_3396":70244,"_29729":70107,"_20626":118402,"_5":14148,"_27027":118049,"_2882":118403},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3396":70245,"_29729":70107,"_20626":118405,"_5":14148,"_27027":118049,"_2882":118096},[],{"_3396":70246,"_29729":70107,"_20626":118407,"_5":14148,"_27027":118049,"_2882":52789},[],{"_3396":70247,"_29729":70107,"_20626":118409,"_5":14148,"_27027":118049,"_2882":118410},[],"Certificado",{"_3396":70248,"_29729":70107,"_20626":118412,"_5":14148,"_27027":118049,"_2882":52795},[],{"_3396":70249,"_29729":70107,"_20626":118414,"_5":14148,"_27027":118049,"_2882":118415},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3396":70250,"_29729":70107,"_20626":118417,"_5":14148,"_27027":118049,"_2882":118418},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3396":70251,"_29729":70107,"_20626":118420,"_5":14148,"_27027":118049,"_2882":118108},[],{"_3396":70252,"_29729":70107,"_20626":118422,"_5":14148,"_27027":118049,"_2882":52806},[],{"_3396":70253,"_29729":70107,"_20626":118424,"_5":14148,"_27027":118049,"_2882":118425},[],"Certificado / Dispositivo",{"_3396":70254,"_29729":70107,"_20626":118427,"_5":14148,"_27027":118049,"_2882":52812},[],{"_3396":70255,"_29729":70107,"_20626":118429,"_5":14148,"_27027":118049,"_2882":48825},[],{"_3396":70256,"_29729":70107,"_20626":118431,"_5":14148,"_27027":118049,"_2882":118432},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3396":70257,"_29729":70107,"_20626":118434,"_5":14148,"_27027":118049,"_2882":118116},[],{"_3396":70258,"_29729":70107,"_20626":118436,"_5":14148,"_27027":118053,"_2882":118437},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3396":70259,"_29729":70107,"_20626":118439,"_5":14148,"_27027":118057,"_2882":118440},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3396":70260,"_29729":70107,"_20626":118442,"_5":14148,"_27027":118057,"_2882":118443},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3396":70261,"_29729":70107,"_20626":118445,"_5":14148,"_27027":118061,"_2882":118446},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3396":70262,"_29729":70107,"_20626":118448,"_5":14148,"_27027":118061,"_2882":118449},[],"Transición",{"_3396":70263,"_29729":70107,"_20626":118451,"_5":14148,"_27027":118061,"_2882":118452},[],"Llamadas AWS",{"_3396":70264,"_29729":70107,"_20626":118454,"_5":14148,"_27027":118061,"_2882":118455},[],"`NoRegistrada` → `Solicitada`",{"_3396":70265,"_29729":70107,"_20626":118457,"_5":14148,"_27027":118061,"_2882":118458},[],"ninguna (solo escritura de metadatos)",{"_3396":70266,"_29729":70107,"_20626":118460,"_5":14148,"_27027":118061,"_2882":118461},[],"`Solicitada` → `Registrando`",{"_3396":70267,"_29729":70107,"_20626":118463,"_5":14148,"_27027":118061,"_2882":118464},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3396":70268,"_29729":70107,"_20626":118466,"_5":14148,"_27027":118061,"_2882":118467},[],"`Registrando` → `Completada`",{"_3396":70269,"_29729":70107,"_20626":118469,"_5":14148,"_27027":118061,"_2882":118470},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3396":70270,"_29729":70107,"_20626":118472,"_5":14148,"_27027":118061,"_2882":118473},[],"`Registrando` → `Fallida`",{"_3396":70271,"_29729":70107,"_20626":118475,"_5":14148,"_27027":118061,"_2882":118476},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3396":70272,"_29729":70107,"_20626":118478,"_5":14148,"_27027":118061,"_2882":118479},[],"`Fallida` / `Completada` → `Solicitada`",{"_3396":70273,"_29729":70107,"_20626":118481,"_5":14148,"_27027":118061,"_2882":118482},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3396":70274,"_29729":70107,"_20626":118484,"_5":14148,"_27027":118065,"_2882":118485},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3396":70275,"_29729":70107,"_20626":118487,"_5":14148,"_27027":118065,"_2882":118488},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3396":70276,"_29729":70107,"_20626":118490,"_5":14148,"_27027":118065,"_2882":118491},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3396":70277,"_29729":70107,"_20626":118493,"_5":14148,"_27027":118065,"_2882":118494},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3396":70278,"_29729":70107,"_20626":118496,"_5":14148,"_27027":118065,"_2882":118497},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3396":70279,"_29729":70107,"_20626":118499,"_5":14148,"_27027":118065,"_2882":118500},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3396":70280,"_29729":70107,"_20626":118502,"_5":14148,"_27027":118068,"_2882":118503},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3396":70281,"_29729":70107,"_20626":118505,"_5":14148,"_27027":118071,"_2882":118506},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3396":70282,"_29729":70107,"_20626":118508,"_5":14148,"_27027":118071,"_2882":118509},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3396":70283,"_29729":70107,"_20626":118511,"_5":14148,"_27027":118075,"_2882":118512},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3396":70284,"_29729":70107,"_20626":118514,"_5":14148,"_27027":118079,"_2882":118515},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3396":70285,"_29729":70107,"_20626":118517,"_5":14148,"_27027":118079,"_2882":118518},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3396":70286,"_29729":70107,"_20626":118520,"_5":14148,"_27027":118079,"_2882":118521},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3396":70287,"_29729":70107,"_20626":118523,"_5":14148,"_27027":118079,"_2882":118524},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3396":70288,"_29729":70107,"_20626":118526,"_5":14148,"_27027":118079,"_2882":118527},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3396":70289,"_29729":70107,"_20626":118529,"_5":14148,"_27027":118079,"_2882":118530},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3396":70290,"_29729":70107,"_20626":118532,"_5":14148,"_27027":118083,"_2882":118533},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3396":70291,"_29729":70107,"_20626":118535,"_5":14148,"_27027":118083,"_2882":118536},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3396":70292,"_29729":70107,"_20626":118538,"_5":14148,"_27027":118083,"_2882":118539},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3396":70293,"_29729":70107,"_20626":118541,"_5":14148,"_27027":118083,"_2882":118542},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3396":70294,"_29729":70107,"_20626":118544,"_5":14148,"_27027":118083,"_2882":118545},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3396":70295,"_29729":70107,"_20626":118547,"_5":14148,"_27027":118087,"_2882":118548},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3396":70296,"_29729":70107,"_20626":118550,"_5":14148,"_27027":118087,"_2882":118449},[],{"_3396":70297,"_29729":70107,"_20626":118552,"_5":14148,"_27027":118087,"_2882":118452},[],{"_3396":70298,"_29729":70107,"_20626":118554,"_5":14148,"_27027":118087,"_2882":118555},[],"`SinConfigurar` → `None` / `Auto`",{"_3396":70299,"_29729":70107,"_20626":118557,"_5":14148,"_27027":118087,"_2882":118558},[],"ninguna (solo configuración)",{"_3396":70300,"_29729":70107,"_20626":118560,"_5":14148,"_27027":118087,"_2882":52949},[],{"_3396":70301,"_29729":70107,"_20626":118562,"_5":14148,"_27027":118087,"_2882":118558},[],{"_3396":70302,"_29729":70107,"_20626":118564,"_5":14148,"_27027":118087,"_2882":118565},[],"Cualquiera → `Jitp`",{"_3396":70303,"_29729":70107,"_20626":118567,"_5":14148,"_27027":118087,"_2882":118568},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3396":70304,"_29729":70107,"_20626":118570,"_5":14148,"_27027":118087,"_2882":52960},[],{"_3396":70305,"_29729":70107,"_20626":118572,"_5":14148,"_27027":118087,"_2882":118573},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3396":70306,"_29729":70107,"_20626":118575,"_5":14148,"_27027":118091,"_2882":118576},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3396":70307,"_29729":70107,"_20626":118578,"_5":14148,"_27027":118091,"_2882":118579},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3396":70308,"_29729":70107,"_20626":118581,"_5":14148,"_27027":118091,"_2882":118582},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3396":70309,"_29729":70107,"_20626":118584,"_5":14148,"_27027":118095,"_2882":118585},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3396":70310,"_29729":70107,"_20626":118587,"_5":14148,"_27027":118095,"_2882":118449},[],{"_3396":70311,"_29729":70107,"_20626":118589,"_5":14148,"_27027":118095,"_2882":118452},[],{"_3396":70312,"_29729":70107,"_20626":118591,"_5":14148,"_27027":118095,"_2882":118592},[],"`Ausente` → `Aprovisionado`",{"_3396":70313,"_29729":70107,"_20626":118594,"_5":14148,"_27027":118095,"_2882":118595},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3396":70314,"_29729":70107,"_20626":118597,"_5":14148,"_27027":118095,"_2882":118598},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3396":70315,"_29729":70107,"_20626":118600,"_5":14148,"_27027":118095,"_2882":118601},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3396":70316,"_29729":70107,"_20626":118603,"_5":14148,"_27027":118095,"_2882":118604},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3396":70317,"_29729":70107,"_20626":118606,"_5":14148,"_27027":118099,"_2882":118607},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3396":70318,"_29729":70107,"_20626":118609,"_5":14148,"_27027":118099,"_2882":118610},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3396":70319,"_29729":70107,"_20626":118612,"_5":14148,"_27027":118099,"_2882":118613},[],"Para que el flujo JITP funcione correctamente:",{"_3396":70320,"_29729":70107,"_20626":118615,"_5":14148,"_27027":118099,"_2882":118616},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3396":70321,"_29729":70107,"_20626":118618,"_5":14148,"_27027":118099,"_2882":118619},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3396":70322,"_29729":70107,"_20626":118621,"_5":14148,"_27027":118099,"_2882":118622},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3396":70323,"_29729":70107,"_20626":118624,"_5":14148,"_27027":118099,"_2882":118625},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3396":70324,"_29729":70107,"_20626":118627,"_5":14148,"_27027":118103,"_2882":118628},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3396":70325,"_29729":70107,"_20626":118630,"_5":14148,"_27027":118103,"_2882":118631},[],"Estado en Lamassu",{"_3396":70326,"_29729":70107,"_20626":118633,"_5":14148,"_27027":118103,"_2882":118634},[],"Razón de revocación",{"_3396":70327,"_29729":70107,"_20626":118636,"_5":14148,"_27027":118103,"_2882":118637},[],"Estado en AWS IoT Core",{"_3396":70328,"_29729":70107,"_20626":118639,"_5":14148,"_27027":118103,"_2882":53030},[],{"_3396":70329,"_29729":70107,"_20626":118641,"_5":14148,"_27027":118103,"_2882":118642},[],"Ninguna",{"_3396":70330,"_29729":70107,"_20626":118644,"_5":14148,"_27027":118103,"_2882":53036},[],{"_3396":70331,"_29729":70107,"_20626":118646,"_5":14148,"_27027":118103,"_2882":53039},[],{"_3396":70332,"_29729":70107,"_20626":118648,"_5":14148,"_27027":118103,"_2882":53042},[],{"_3396":70333,"_29729":70107,"_20626":118650,"_5":14148,"_27027":118103,"_2882":53045},[],{"_3396":70334,"_29729":70107,"_20626":118652,"_5":14148,"_27027":118103,"_2882":53039},[],{"_3396":70335,"_29729":70107,"_20626":118654,"_5":14148,"_27027":118103,"_2882":118655},[],"Cualquier otra razón",{"_3396":70336,"_29729":70107,"_20626":118657,"_5":14148,"_27027":118103,"_2882":53053},[],{"_3396":70337,"_29729":70107,"_20626":118659,"_5":14148,"_27027":118103,"_2882":118660},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3396":70338,"_29729":70107,"_20626":118662,"_5":14148,"_27027":118107,"_2882":118663},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3396":70339,"_29729":70107,"_20626":118665,"_5":14148,"_27027":118107,"_2882":118449},[],{"_3396":70340,"_29729":70107,"_20626":118667,"_5":14148,"_27027":118107,"_2882":118452},[],{"_3396":70341,"_29729":70107,"_20626":118669,"_5":14148,"_27027":118107,"_2882":118670},[],"`NoSincronizado` → `Active`",{"_3396":70342,"_29729":70107,"_20626":118672,"_5":14148,"_27027":118107,"_2882":52545},[],{"_3396":70343,"_29729":70107,"_20626":118674,"_5":14148,"_27027":118107,"_2882":53071},[],{"_3396":70344,"_29729":70107,"_20626":118676,"_5":14148,"_27027":118107,"_2882":118677},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3396":70345,"_29729":70107,"_20626":118679,"_5":14148,"_27027":118107,"_2882":53077},[],{"_3396":70346,"_29729":70107,"_20626":118681,"_5":14148,"_27027":118107,"_2882":118677},[],{"_3396":70347,"_29729":70107,"_20626":118683,"_5":14148,"_27027":118107,"_2882":53082},[],{"_3396":70348,"_29729":70107,"_20626":118685,"_5":14148,"_27027":118107,"_2882":52545},[],{"_3396":70349,"_29729":70107,"_20626":118687,"_5":14148,"_27027":118107,"_2882":53087},[],{"_3396":70350,"_29729":70107,"_20626":118689,"_5":14148,"_27027":118107,"_2882":118690},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3396":70351,"_29729":70107,"_20626":118692,"_5":14148,"_27027":118111,"_2882":118693},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3396":70352,"_29729":70107,"_20626":118695,"_5":14148,"_27027":118111,"_2882":118696},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3396":70353,"_29729":70107,"_20626":118698,"_5":14148,"_27027":118111,"_2882":118699},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3396":70354,"_29729":70107,"_20626":118701,"_5":14148,"_27027":118115,"_2882":118702},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3396":70355,"_29729":70107,"_20626":118704,"_5":14148,"_27027":118115,"_2882":118705},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3396":70356,"_29729":70107,"_20626":118707,"_5":14148,"_27027":118119,"_2882":118708},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3396":70357,"_29729":70107,"_20626":118710,"_5":14148,"_27027":118119,"_2882":118711},[],"Existen dos tipos de acciones:",{"_3396":70358,"_29729":70107,"_20626":118713,"_5":14148,"_27027":118119,"_2882":118714},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3396":70359,"_29729":70107,"_20626":118716,"_5":14148,"_27027":118119,"_2882":118717},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3396":70360,"_29729":70107,"_20626":118719,"_5":14148,"_27027":118119,"_2882":118720},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3396":70361,"_29729":70107,"_20626":118722,"_5":14148,"_27027":118123,"_2882":118723},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3396":70362,"_29729":70107,"_20626":118725,"_5":14148,"_27027":118123,"_2882":118726},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3396":70363,"_29729":70107,"_20626":118728,"_5":14148,"_27027":118123,"_2882":118729},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3396":70364,"_29729":70107,"_20626":118731,"_5":14148,"_27027":118127,"_2882":118732},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3396":70365,"_29729":70107,"_20626":118734,"_5":14148,"_27027":118127,"_2882":118735},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3396":70366,"_29729":70107,"_20626":118737,"_5":14148,"_27027":118127,"_2882":118738},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3396":70367,"_29729":70107,"_20626":118740,"_5":14148,"_27027":118127,"_2882":118741},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3396":70368,"_29729":70107,"_20626":118743,"_5":14148,"_27027":118127,"_2882":118744},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3396":70369,"_29729":70107,"_20626":118746,"_5":14148,"_27027":118127,"_2882":118747},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3396":70370,"_29729":70107,"_20626":118749,"_5":14148,"_27027":118127,"_2882":118750},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3396":70371,"_29729":70107,"_20626":118752,"_5":14148,"_27027":118127,"_2882":118753},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3396":70372,"_29729":70107,"_20626":118755,"_5":14148,"_27027":118127,"_2882":118756},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3396":70373,"_29729":70107,"_20626":118758,"_5":14148,"_27027":118127,"_2882":118759},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3396":70374,"_29729":70107,"_20626":118761,"_5":14148,"_27027":118127,"_2882":118762},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3396":70375,"_29729":70107,"_20626":118764,"_5":14148,"_27027":118127,"_2882":118765},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3396":70376,"_29729":70107,"_20626":118767,"_5":14148,"_27027":118127,"_2882":118768},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3396":70377,"_29729":70107,"_20626":118770,"_5":14148,"_27027":118127,"_2882":118771},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3396":70378,"_29729":70107,"_20626":118773,"_5":14148,"_27027":118127,"_2882":118774},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3396":70379,"_29729":70107,"_20626":118776,"_5":14148,"_27027":118127,"_2882":118777},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3396":70380,"_29729":70107,"_20626":118779,"_5":14148,"_27027":118127,"_2882":118780},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3396":70381,"_29729":70107,"_20626":118782,"_5":14148,"_27027":118127,"_2882":118783},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3396":70382,"_29729":70107,"_20626":118785,"_5":14148,"_27027":118127,"_2882":118786},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3396":70383,"_29729":70107,"_20626":118788,"_5":14148,"_27027":118127,"_2882":118789},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3396":70384,"_29729":70107,"_20626":118791,"_5":14148,"_27027":118127,"_2882":118792},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3396":70385,"_29729":70107,"_20626":118794,"_5":14148,"_27027":118127,"_2882":118795},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3396":70386,"_29729":70107,"_20626":118797,"_5":14148,"_27027":118127,"_2882":118798},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3396":70387,"_29729":70107,"_20626":118800,"_5":14148,"_27027":118127,"_2882":118801},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3396":70388,"_29729":70388,"_5":14500,"_2882":50908,"_30082":118803,"_20626":118804,"_27027":70388},[48429,115610,50908],[],{"_3396":70389,"_29729":70388,"_20626":118806,"_5":14148,"_27027":70388,"_2882":118807},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3396":70390,"_29729":70388,"_5":30079,"_20626":118809,"_27027":118810,"_2882":118811},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3396":70391,"_29729":70388,"_5":30079,"_20626":118813,"_27027":118814,"_2882":116619},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3396":70392,"_29729":70388,"_5":30079,"_20626":118816,"_27027":118817,"_2882":116794},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3396":70393,"_29729":70388,"_5":30079,"_20626":118819,"_27027":118820,"_2882":118026},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/overview#integraciones",{"_3396":70394,"_29729":70388,"_5":30079,"_20626":118822,"_27027":118823,"_2882":118824},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3396":70395,"_29729":70388,"_20626":118826,"_5":14148,"_27027":70388,"_2882":118827},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3396":70396,"_29729":70388,"_20626":118829,"_5":14148,"_27027":118810,"_2882":118830},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3396":70397,"_29729":70388,"_20626":118832,"_5":14148,"_27027":118810,"_2882":118833},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3396":70398,"_29729":70388,"_20626":118835,"_5":14148,"_27027":118814,"_2882":118836},[],"Recurso",{"_3396":70399,"_29729":70388,"_20626":118838,"_5":14148,"_27027":118814,"_2882":118839},[],"Qué representa",{"_3396":70400,"_29729":70388,"_20626":118841,"_5":14148,"_27027":118814,"_2882":118842},[],"**Dispositivo**",{"_3396":70401,"_29729":70388,"_20626":118844,"_5":14148,"_27027":118814,"_2882":118845},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3396":70402,"_29729":70388,"_20626":118847,"_5":14148,"_27027":118814,"_2882":118848},[],"**Identidad**",{"_3396":70403,"_29729":70388,"_20626":118850,"_5":14148,"_27027":118814,"_2882":118851},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3396":70404,"_29729":70388,"_20626":118853,"_5":14148,"_27027":118814,"_2882":53254},[],{"_3396":70405,"_29729":70388,"_20626":118855,"_5":14148,"_27027":118814,"_2882":118856},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3396":70406,"_29729":70388,"_20626":118858,"_5":14148,"_27027":118814,"_2882":118859},[],"**Flota**",{"_3396":70407,"_29729":70388,"_20626":118861,"_5":14148,"_27027":118814,"_2882":118862},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3396":70408,"_29729":70388,"_20626":118864,"_5":14148,"_27027":118814,"_2882":118865},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3396":70409,"_29729":70388,"_20626":118867,"_5":14148,"_27027":118814,"_2882":118868},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3396":70410,"_29729":70388,"_20626":118870,"_5":14148,"_27027":118817,"_2882":118871},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3396":70411,"_29729":70388,"_20626":118873,"_5":14148,"_27027":118817,"_2882":118874},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3396":70412,"_29729":70388,"_20626":118876,"_5":14148,"_27027":118817,"_2882":118877},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3396":70413,"_29729":70388,"_20626":118879,"_5":14148,"_27027":118817,"_2882":118880},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3396":70414,"_29729":70388,"_20626":118882,"_5":14148,"_27027":118817,"_2882":118883},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3396":70415,"_29729":70388,"_20626":118885,"_5":14148,"_27027":118817,"_2882":118886},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3396":70416,"_29729":70388,"_20626":118888,"_5":14148,"_27027":118817,"_2882":118889},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3396":70417,"_29729":70388,"_20626":118891,"_5":14148,"_27027":118817,"_2882":118892},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3396":70418,"_29729":70388,"_20626":118894,"_5":14148,"_27027":118820,"_2882":118895},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3396":70419,"_29729":70388,"_20626":118897,"_5":14148,"_27027":118820,"_2882":118898},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3396":70420,"_29729":70388,"_20626":118900,"_5":14148,"_27027":118823,"_2882":118901},[],"Participante",{"_3396":70421,"_29729":70388,"_20626":118903,"_5":14148,"_27027":118823,"_2882":118904},[],"Responsabilidad",{"_3396":70422,"_29729":70388,"_20626":118906,"_5":14148,"_27027":118823,"_2882":118907},[],"Administrador PKI",{"_3396":70423,"_29729":70388,"_20626":118909,"_5":14148,"_27027":118823,"_2882":118910},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3396":70424,"_29729":70388,"_20626":118912,"_5":14148,"_27027":118823,"_2882":118913},[],"Administrador del aprovisionamiento",{"_3396":70425,"_29729":70388,"_20626":118915,"_5":14148,"_27027":118823,"_2882":118916},[],"DMS, admisión, autenticación por operación e inventario.",{"_3396":70426,"_29729":70388,"_20626":118918,"_5":14148,"_27027":118823,"_2882":118919},[],"Integrador del dispositivo",{"_3396":70427,"_29729":70388,"_20626":118921,"_5":14148,"_27027":118823,"_2882":118922},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3396":70428,"_29729":70388,"_20626":118924,"_5":14148,"_27027":118823,"_2882":118925},[],"Integrador del consumidor",{"_3396":70429,"_29729":70388,"_20626":118927,"_5":14148,"_27027":118823,"_2882":118928},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3396":70430,"_29729":70388,"_20626":118930,"_5":14148,"_27027":118823,"_2882":118931},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3396":70431,"_29729":70431,"_5":14500,"_2882":118933,"_30082":118934,"_20626":118936,"_27027":70431},"Enrola y conecta tu primer dispositivo",[48429,115610,50908,118935],"Primeros pasos",[],{"_3396":70432,"_29729":70431,"_20626":118938,"_5":14148,"_27027":70431,"_2882":118939},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3396":70433,"_29729":70431,"_5":30079,"_20626":118941,"_27027":118942,"_2882":114188},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3396":70434,"_29729":70431,"_5":30079,"_20626":118944,"_27027":118945,"_2882":118946},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3396":70435,"_29729":70431,"_5":30079,"_20626":118948,"_27027":118949,"_2882":118950},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3396":70436,"_29729":70431,"_5":30079,"_20626":118952,"_27027":118953,"_2882":118954},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3396":70437,"_29729":70431,"_5":30079,"_20626":118956,"_27027":118957,"_2882":118958},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3396":70438,"_29729":70431,"_5":30079,"_20626":118960,"_27027":118961,"_2882":118962},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3396":70439,"_29729":70431,"_5":30079,"_20626":118964,"_27027":118965,"_2882":118966},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3396":70440,"_29729":70431,"_5":30079,"_20626":118968,"_27027":118969,"_2882":118970},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3396":70441,"_29729":70431,"_20626":118972,"_5":14148,"_27027":70431,"_2882":118973},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3396":70442,"_29729":70431,"_20626":118975,"_5":14148,"_27027":118942,"_2882":118976},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3396":70443,"_29729":70431,"_20626":118978,"_5":14148,"_27027":118942,"_2882":118979},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3396":70444,"_29729":70431,"_20626":118981,"_5":14148,"_27027":118942,"_2882":118982},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3396":70445,"_29729":70431,"_20626":118984,"_5":14148,"_27027":118942,"_2882":118985},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3396":70446,"_29729":70431,"_20626":118987,"_5":14148,"_27027":118942,"_2882":118988},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3396":70447,"_29729":70431,"_20626":118990,"_5":14148,"_27027":118945,"_2882":118991},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3396":70448,"_29729":70431,"_20626":118993,"_5":14148,"_27027":118945,"_2882":118994},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3396":70449,"_29729":70431,"_20626":118996,"_5":14148,"_27027":118949,"_2882":118997},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3396":70450,"_29729":70431,"_20626":118999,"_5":14148,"_27027":118949,"_2882":119000},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3396":70451,"_29729":70431,"_20626":119002,"_5":14148,"_27027":118949,"_2882":119003},[],"Ajuste",{"_3396":70452,"_29729":70431,"_20626":119005,"_5":14148,"_27027":118949,"_2882":119006},[],"Valor de evaluación",{"_3396":70453,"_29729":70431,"_20626":119008,"_5":14148,"_27027":118949,"_2882":53410},[],{"_3396":70454,"_29729":70431,"_20626":119010,"_5":14148,"_27027":118949,"_2882":119011},[],"Raíz emisora de `device-root.pem`.",{"_3396":70455,"_29729":70431,"_20626":119013,"_5":14148,"_27027":118949,"_2882":116922},[],{"_3396":70456,"_29729":70431,"_20626":119015,"_5":14148,"_27027":118949,"_2882":119016},[],"Perfil final de 1 hora que acabas de preparar.",{"_3396":70457,"_29729":70431,"_20626":119018,"_5":14148,"_27027":118949,"_2882":53421},[],{"_3396":70458,"_29729":70431,"_20626":119020,"_5":14148,"_27027":118949,"_2882":53424},[],{"_3396":70459,"_29729":70431,"_20626":119022,"_5":14148,"_27027":118949,"_2882":53427},[],{"_3396":70460,"_29729":70431,"_20626":119024,"_5":14148,"_27027":118949,"_2882":119025},[],"Habilitado.",{"_3396":70461,"_29729":70431,"_20626":119027,"_5":14148,"_27027":118949,"_2882":53433},[],{"_3396":70462,"_29729":70431,"_20626":119029,"_5":14148,"_27027":118949,"_2882":119030},[],"Deshabilitado; el ID debe ser nuevo.",{"_3396":70463,"_29729":70431,"_20626":119032,"_5":14148,"_27027":118949,"_2882":119033},[],"Autenticación inicial",{"_3396":70464,"_29729":70431,"_20626":119035,"_5":14148,"_27027":118949,"_2882":119036},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3396":70465,"_29729":70431,"_20626":119038,"_5":14148,"_27027":118949,"_2882":119039},[],"Autenticación de renovación",{"_3396":70466,"_29729":70431,"_20626":119041,"_5":14148,"_27027":118949,"_2882":119042},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3396":70467,"_29729":70431,"_20626":119044,"_5":14148,"_27027":118949,"_2882":53451},[],{"_3396":70468,"_29729":70431,"_20626":119046,"_5":14148,"_27027":118949,"_2882":119047},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3396":70469,"_29729":70431,"_20626":119049,"_5":14148,"_27027":118949,"_2882":53457},[],{"_3396":70470,"_29729":70431,"_20626":119051,"_5":14148,"_27027":118949,"_2882":119052},[],"1 hora.",{"_3396":70471,"_29729":70431,"_20626":119054,"_5":14148,"_27027":118949,"_2882":53463},[],{"_3396":70472,"_29729":70431,"_20626":119056,"_5":14148,"_27027":118949,"_2882":119057},[],"30 minutos / 10 minutos.",{"_3396":70473,"_29729":70431,"_20626":119059,"_5":14148,"_27027":118949,"_2882":53469},[],{"_3396":70474,"_29729":70431,"_20626":119061,"_5":14148,"_27027":118949,"_2882":119062},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3396":70475,"_29729":70431,"_20626":119064,"_5":14148,"_27027":118949,"_2882":51227},[],{"_3396":70476,"_29729":70431,"_20626":119066,"_5":14148,"_27027":118949,"_2882":119067},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3396":70477,"_29729":70431,"_20626":119069,"_5":14148,"_27027":118949,"_2882":53480},[],{"_3396":70478,"_29729":70431,"_20626":119071,"_5":14148,"_27027":118949,"_2882":119072},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3396":70479,"_29729":70431,"_20626":119074,"_5":14148,"_27027":118949,"_2882":119075},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3396":70480,"_29729":70431,"_20626":119077,"_5":14148,"_27027":118953,"_2882":119078},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3396":70481,"_29729":70431,"_20626":119080,"_5":14148,"_27027":118953,"_2882":119081},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3396":70482,"_29729":70431,"_20626":119083,"_5":14148,"_27027":118957,"_2882":119084},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3396":70483,"_29729":70431,"_20626":119086,"_5":14148,"_27027":118957,"_2882":119087},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3396":70484,"_29729":70431,"_20626":119089,"_5":14148,"_27027":118957,"_2882":119090},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3396":70485,"_29729":70431,"_20626":119092,"_5":14148,"_27027":118961,"_2882":119093},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3396":70486,"_29729":70431,"_20626":119095,"_5":14148,"_27027":118961,"_2882":119096},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3396":70487,"_29729":70431,"_20626":119098,"_5":14148,"_27027":118965,"_2882":119099},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3396":70488,"_29729":70431,"_20626":119101,"_5":14148,"_27027":118965,"_2882":119102},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3396":70489,"_29729":70431,"_20626":119104,"_5":14148,"_27027":118965,"_2882":119105},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3396":70490,"_29729":70431,"_20626":119107,"_5":14148,"_27027":118965,"_2882":119108},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3396":70491,"_29729":70431,"_20626":119110,"_5":14148,"_27027":118965,"_2882":119111},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3396":70492,"_29729":70431,"_20626":119113,"_5":14148,"_27027":118969,"_2882":119114},[],"Comprobación",{"_3396":70493,"_29729":70431,"_20626":119116,"_5":14148,"_27027":118969,"_2882":119117},[],"Resultado esperado",{"_3396":70494,"_29729":70431,"_20626":119119,"_5":14148,"_27027":118969,"_2882":119120},[],"Registro",{"_3396":70495,"_29729":70431,"_20626":119122,"_5":14148,"_27027":118969,"_2882":119123},[],"ID creado automáticamente y DMS correcto.",{"_3396":70496,"_29729":70431,"_20626":119125,"_5":14148,"_27027":118969,"_2882":118410},[],{"_3396":70497,"_29729":70431,"_20626":119127,"_5":14148,"_27027":118969,"_2882":119128},[],"CN, perfil, serie y clave verificados.",{"_3396":70498,"_29729":70431,"_20626":119130,"_5":14148,"_27027":118969,"_2882":119131},[],"Inventario",{"_3396":70499,"_29729":70431,"_20626":119133,"_5":14148,"_27027":118969,"_2882":119134},[],"Serie recibida visible como identidad actual y en el historial.",{"_3396":70500,"_29729":70431,"_20626":119136,"_5":14148,"_27027":118969,"_2882":119137},[],"Consumidor",{"_3396":70501,"_29729":70431,"_20626":119139,"_5":14148,"_27027":118969,"_2882":119140},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3396":70502,"_29729":70431,"_20626":119142,"_5":14148,"_27027":118969,"_2882":119143},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3396":70503,"_29729":70431,"_20626":119145,"_5":14148,"_27027":118969,"_2882":119146},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3396":70504,"_29729":70504,"_5":14500,"_2882":116636,"_30082":119148,"_20626":119149,"_27027":70504},[48429,115610,50908,118935],[],{"_3396":70505,"_29729":70504,"_20626":119151,"_5":14148,"_27027":70504,"_2882":119152},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3396":70506,"_29729":70504,"_5":30079,"_20626":119154,"_27027":119155,"_2882":114188},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3396":70507,"_29729":70504,"_5":30079,"_20626":119157,"_27027":119158,"_2882":119159},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3396":70508,"_29729":70504,"_5":30079,"_20626":119161,"_27027":119162,"_2882":119163},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3396":70509,"_29729":70504,"_5":30079,"_20626":119165,"_27027":119166,"_2882":119167},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3396":70510,"_29729":70504,"_5":30079,"_20626":119169,"_27027":119170,"_2882":119171},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3396":70511,"_29729":70504,"_5":30079,"_20626":119173,"_27027":119174,"_2882":119175},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3396":70512,"_29729":70504,"_5":30079,"_20626":119177,"_27027":119178,"_2882":119117},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3396":70513,"_29729":70504,"_5":30079,"_20626":119180,"_27027":119181,"_2882":119182},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3396":70514,"_29729":70504,"_5":30079,"_20626":119184,"_27027":119185,"_2882":119186},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3396":70515,"_29729":70504,"_20626":119188,"_5":14148,"_27027":70504,"_2882":119189},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3396":70516,"_29729":70504,"_20626":119191,"_5":14148,"_27027":70504,"_2882":119192},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3396":70517,"_29729":70504,"_20626":119194,"_5":14148,"_27027":119155,"_2882":119195},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3396":70518,"_29729":70504,"_20626":119197,"_5":14148,"_27027":119155,"_2882":119198},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3396":70519,"_29729":70504,"_20626":119200,"_5":14148,"_27027":119155,"_2882":119201},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3396":70520,"_29729":70504,"_20626":119203,"_5":14148,"_27027":119155,"_2882":119204},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3396":70521,"_29729":70504,"_20626":119206,"_5":14148,"_27027":119158,"_2882":119207},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3396":70522,"_29729":70504,"_20626":119209,"_5":14148,"_27027":119158,"_2882":119210},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3396":70523,"_29729":70504,"_20626":119212,"_5":14148,"_27027":119158,"_2882":119213},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3396":70524,"_29729":70504,"_20626":119215,"_5":14148,"_27027":119158,"_2882":119216},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3396":70525,"_29729":70504,"_20626":119218,"_5":14148,"_27027":119158,"_2882":119219},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3396":70526,"_29729":70504,"_20626":119221,"_5":14148,"_27027":119158,"_2882":119222},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3396":70527,"_29729":70504,"_20626":119224,"_5":14148,"_27027":119158,"_2882":119225},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3396":70528,"_29729":70504,"_20626":119227,"_5":14148,"_27027":119158,"_2882":119228},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3396":70529,"_29729":70504,"_20626":119230,"_5":14148,"_27027":119162,"_2882":119231},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3396":70530,"_29729":70504,"_20626":119233,"_5":14148,"_27027":119162,"_2882":53645},[],{"_3396":70531,"_29729":70504,"_20626":119235,"_5":14148,"_27027":119162,"_2882":119236},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3396":70532,"_29729":70504,"_20626":119238,"_5":14148,"_27027":119162,"_2882":119239},[],"**Icon** y **Tags**: clasificación opcional.",{"_3396":70533,"_29729":70504,"_20626":119241,"_5":14148,"_27027":119162,"_2882":119242},[],"Confirma el registro.",{"_3396":70534,"_29729":70504,"_20626":119244,"_5":14148,"_27027":119166,"_2882":119245},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3396":70535,"_29729":70504,"_20626":119247,"_5":14148,"_27027":119166,"_2882":119248},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3396":70536,"_29729":70504,"_20626":119250,"_5":14148,"_27027":119170,"_2882":119251},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3396":70537,"_29729":70504,"_20626":119253,"_5":14148,"_27027":119170,"_2882":119254},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3396":70538,"_29729":70504,"_20626":119256,"_5":14148,"_27027":119174,"_2882":119257},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3396":70539,"_29729":70504,"_20626":119259,"_5":14148,"_27027":119174,"_2882":119260},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3396":70540,"_29729":70504,"_20626":119262,"_5":14148,"_27027":119178,"_2882":119114},[],{"_3396":70541,"_29729":70504,"_20626":119264,"_5":14148,"_27027":119178,"_2882":119265},[],"Resultado",{"_3396":70542,"_29729":70504,"_20626":119267,"_5":14148,"_27027":119178,"_2882":118396},[],{"_3396":70543,"_29729":70504,"_20626":119269,"_5":14148,"_27027":119178,"_2882":119270},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3396":70544,"_29729":70504,"_20626":119272,"_5":14148,"_27027":119178,"_2882":119273},[],"Identidad actual",{"_3396":70545,"_29729":70504,"_20626":119275,"_5":14148,"_27027":119178,"_2882":119276},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3396":70546,"_29729":70504,"_20626":119278,"_5":14148,"_27027":119178,"_2882":119279},[],"Historial",{"_3396":70547,"_29729":70504,"_20626":119281,"_5":14148,"_27027":119178,"_2882":119282},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3396":70548,"_29729":70504,"_20626":119284,"_5":14148,"_27027":119178,"_2882":119285},[],"Clave y certificado",{"_3396":70549,"_29729":70504,"_20626":119287,"_5":14148,"_27027":119178,"_2882":119288},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3396":70550,"_29729":70504,"_20626":119290,"_5":14148,"_27027":119181,"_2882":119291},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3396":70551,"_29729":70504,"_20626":119293,"_5":14148,"_27027":119181,"_2882":119294},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3396":70552,"_29729":70504,"_20626":119296,"_5":14148,"_27027":119181,"_2882":119297},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3396":70553,"_29729":70504,"_20626":119299,"_5":14148,"_27027":119181,"_2882":119300},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3396":70554,"_29729":70504,"_20626":119302,"_5":14148,"_27027":119185,"_2882":119303},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3396":70555,"_29729":70504,"_20626":119305,"_5":14148,"_27027":119185,"_2882":119306},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3396":70556,"_29729":70504,"_20626":119308,"_5":14148,"_27027":119185,"_2882":119309},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3396":70557,"_29729":70557,"_5":14500,"_2882":119311,"_30082":119312,"_20626":119313,"_27027":70557},"Plataforma Lamassu IoT",[48429,115610],[],{"_3396":70558,"_29729":70557,"_20626":119315,"_5":14148,"_27027":70557,"_2882":119316},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3396":70559,"_29729":70557,"_5":30079,"_20626":119318,"_27027":119319,"_2882":118811},[],"/docs/pr-preview/pr-57/es/platform/overview#empieza-aquí",{"_3396":70560,"_29729":70557,"_5":30079,"_20626":119321,"_27027":119322,"_2882":119323},[],"/docs/pr-preview/pr-57/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3396":70561,"_29729":70557,"_5":30079,"_20626":119325,"_27027":119326,"_2882":119327},[],"/docs/pr-preview/pr-57/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3396":70562,"_29729":70557,"_5":30079,"_20626":119329,"_27027":119330,"_2882":119331},[],"/docs/pr-preview/pr-57/es/platform/overview#capacidades-principales","Capacidades principales",{"_3396":70563,"_29729":70557,"_5":30079,"_20626":119333,"_27027":119334,"_2882":119335},[],"/docs/pr-preview/pr-57/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3396":70564,"_29729":70557,"_5":30079,"_20626":119337,"_27027":119338,"_2882":119339},[],"/docs/pr-preview/pr-57/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3396":70565,"_29729":70557,"_5":30079,"_20626":119341,"_27027":119342,"_2882":119343},[],"/docs/pr-preview/pr-57/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3396":70566,"_29729":70557,"_5":30079,"_20626":119345,"_27027":119346,"_2882":119347},[],"/docs/pr-preview/pr-57/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3396":70567,"_29729":70557,"_5":30079,"_20626":119349,"_27027":119350,"_2882":119351},[],"/docs/pr-preview/pr-57/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3396":70568,"_29729":70557,"_5":30079,"_20626":119353,"_27027":119354,"_2882":119355},[],"/docs/pr-preview/pr-57/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3396":70569,"_29729":70557,"_5":30079,"_20626":119357,"_27027":119358,"_2882":119359},[],"/docs/pr-preview/pr-57/es/platform/overview#referencia-operativa","Referencia operativa",{"_3396":70570,"_29729":70557,"_20626":119361,"_5":14148,"_27027":70557,"_2882":119362},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3396":70571,"_29729":70557,"_20626":119364,"_5":14148,"_27027":119319,"_2882":119365},[],"Elige el resultado que necesitas obtener:",{"_3396":70572,"_29729":70557,"_20626":119367,"_5":14148,"_27027":119319,"_2882":119368},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3396":70573,"_29729":70557,"_20626":119370,"_5":14148,"_27027":119319,"_2882":119371},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3396":70574,"_29729":70557,"_20626":119373,"_5":14148,"_27027":119319,"_2882":119374},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3396":70575,"_29729":70557,"_20626":119376,"_5":14148,"_27027":119322,"_2882":119377},[],"Bloque",{"_3396":70576,"_29729":70557,"_20626":119379,"_5":14148,"_27027":119322,"_2882":119380},[],"Qué gestionas",{"_3396":70577,"_29729":70557,"_20626":119382,"_5":14148,"_27027":119322,"_2882":119383},[],"Punto de entrada",{"_3396":70578,"_29729":70557,"_20626":119385,"_5":14148,"_27027":119322,"_2882":53798},[],{"_3396":70579,"_29729":70557,"_20626":119387,"_5":14148,"_27027":119322,"_2882":119388},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3396":70580,"_29729":70557,"_20626":119390,"_5":14148,"_27027":119322,"_2882":119391},[],"Visión general de PKI",{"_3396":70581,"_29729":70557,"_20626":119393,"_5":14148,"_27027":119322,"_2882":53807},[],{"_3396":70582,"_29729":70557,"_20626":119395,"_5":14148,"_27027":119322,"_2882":119396},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3396":70583,"_29729":70557,"_20626":119398,"_5":14148,"_27027":119322,"_2882":119399},[],"Visión general de IoT Fleets",{"_3396":70584,"_29729":70557,"_20626":119401,"_5":14148,"_27027":119322,"_2882":119402},[],"**Administración**",{"_3396":70585,"_29729":70557,"_20626":119404,"_5":14148,"_27027":119322,"_2882":119405},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3396":70586,"_29729":70557,"_20626":119407,"_5":14148,"_27027":119322,"_2882":115608},[],{"_3396":70587,"_29729":70557,"_20626":119409,"_5":14148,"_27027":119322,"_2882":119410},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3396":70588,"_29729":70557,"_20626":119412,"_5":14148,"_27027":119326,"_2882":119413},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3396":70589,"_29729":70557,"_20626":119415,"_5":14148,"_27027":119326,"_2882":119416},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3396":70590,"_29729":70557,"_20626":119418,"_5":14148,"_27027":119326,"_2882":119419},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3396":70591,"_29729":70557,"_20626":119421,"_5":14148,"_27027":119326,"_2882":119422},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3396":70592,"_29729":70557,"_20626":119424,"_5":14148,"_27027":119326,"_2882":119425},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3396":70593,"_29729":70557,"_20626":119427,"_5":14148,"_27027":119326,"_2882":119428},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3396":70594,"_29729":70557,"_20626":119430,"_5":14148,"_27027":119334,"_2882":119431},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3396":70595,"_29729":70557,"_20626":119433,"_5":14148,"_27027":119338,"_2882":119434},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3396":70596,"_29729":70557,"_20626":119436,"_5":14148,"_27027":119342,"_2882":119437},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3396":70597,"_29729":70557,"_20626":119439,"_5":14148,"_27027":119346,"_2882":119440},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3396":70598,"_29729":70557,"_20626":119442,"_5":14148,"_27027":119350,"_2882":119443},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3396":70599,"_29729":70557,"_20626":119445,"_5":14148,"_27027":119354,"_2882":119446},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3396":70600,"_29729":70557,"_20626":119448,"_5":14148,"_27027":119358,"_2882":118904},[],{"_3396":70601,"_29729":70557,"_20626":119450,"_5":14148,"_27027":119358,"_2882":119451},[],"Qué prepara o comprueba",{"_3396":70602,"_29729":70557,"_20626":119453,"_5":14148,"_27027":119358,"_2882":118907},[],{"_3396":70603,"_29729":70557,"_20626":119455,"_5":14148,"_27027":119358,"_2882":119456},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3396":70604,"_29729":70557,"_20626":119458,"_5":14148,"_27027":119358,"_2882":119459},[],"Administrador de la flota",{"_3396":70605,"_29729":70557,"_20626":119461,"_5":14148,"_27027":119358,"_2882":119462},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3396":70606,"_29729":70557,"_20626":119464,"_5":14148,"_27027":119358,"_2882":118919},[],{"_3396":70607,"_29729":70557,"_20626":119466,"_5":14148,"_27027":119358,"_2882":119467},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3396":70608,"_29729":70557,"_20626":119469,"_5":14148,"_27027":119358,"_2882":118925},[],{"_3396":70609,"_29729":70557,"_20626":119471,"_5":14148,"_27027":119358,"_2882":119472},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3396":70610,"_29729":70557,"_20626":119474,"_5":14148,"_27027":119358,"_2882":119475},[],"Operador de infraestructura",{"_3396":70611,"_29729":70557,"_20626":119477,"_5":14148,"_27027":119358,"_2882":119478},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3396":70612,"_29729":70557,"_20626":119480,"_5":14148,"_27027":119358,"_2882":119481},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3396":70613,"_29729":70613,"_5":14500,"_2882":119483,"_30082":119484,"_20626":119486,"_27027":70613},"Jerarquía y rotación de CAs",[48429,115610,53899,119485],"Claves, autoridades y certificados",[],{"_3396":70614,"_29729":70613,"_20626":119488,"_5":14148,"_27027":70613,"_2882":119489},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3396":70615,"_29729":70613,"_5":30079,"_20626":119491,"_27027":119492,"_2882":119493},[],"/docs/pr-preview/pr-57/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3396":70616,"_29729":70613,"_5":30079,"_20626":119495,"_27027":119496,"_2882":119497},[],"/docs/pr-preview/pr-57/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3396":70617,"_29729":70613,"_5":30079,"_20626":119499,"_27027":119500,"_2882":119501},[],"/docs/pr-preview/pr-57/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3396":70618,"_29729":70613,"_5":30079,"_20626":119503,"_27027":119504,"_2882":119505},[],"/docs/pr-preview/pr-57/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3396":70619,"_29729":70613,"_5":30079,"_20626":119507,"_27027":119508,"_2882":119509},[],"/docs/pr-preview/pr-57/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3396":70620,"_29729":70613,"_5":30079,"_20626":119511,"_27027":119512,"_2882":119513},[],"/docs/pr-preview/pr-57/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3396":70621,"_29729":70613,"_5":30079,"_20626":119515,"_27027":119516,"_2882":119517},[],"/docs/pr-preview/pr-57/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3396":70622,"_29729":70613,"_5":30079,"_20626":119519,"_27027":119520,"_2882":119521},[],"/docs/pr-preview/pr-57/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3396":70623,"_29729":70613,"_5":30079,"_20626":119523,"_27027":119524,"_2882":119525},[],"/docs/pr-preview/pr-57/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3396":70624,"_29729":70613,"_5":30079,"_20626":119527,"_27027":119528,"_2882":119529},[],"/docs/pr-preview/pr-57/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3396":70625,"_29729":70613,"_5":30079,"_20626":119531,"_27027":119532,"_2882":119533},[],"/docs/pr-preview/pr-57/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3396":70626,"_29729":70613,"_5":30079,"_20626":119535,"_27027":119536,"_2882":119537},[],"/docs/pr-preview/pr-57/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3396":70627,"_29729":70613,"_20626":119539,"_5":14148,"_27027":70613,"_2882":119540},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3396":70628,"_29729":70613,"_20626":119542,"_5":14148,"_27027":70613,"_2882":119543},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3396":70629,"_29729":70613,"_20626":119545,"_5":14148,"_27027":119492,"_2882":119546},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3396":70630,"_29729":70613,"_20626":119548,"_5":14148,"_27027":119492,"_2882":119549},[],"entorno, como producción y preproducción;",{"_3396":70631,"_29729":70613,"_20626":119551,"_5":14148,"_27027":119492,"_2882":119552},[],"propietario o equipo operador;",{"_3396":70632,"_29729":70613,"_20626":119554,"_5":14148,"_27027":119492,"_2882":119555},[],"familia de dispositivos o proceso de fabricación;",{"_3396":70633,"_29729":70613,"_20626":119557,"_5":14148,"_27027":119492,"_2882":119558},[],"región o requisito regulatorio;",{"_3396":70634,"_29729":70613,"_20626":119560,"_5":14148,"_27027":119492,"_2882":119561},[],"motor criptográfico o política de clave;",{"_3396":70635,"_29729":70613,"_20626":119563,"_5":14148,"_27027":119492,"_2882":119564},[],"ventana de mantenimiento y ritmo de renovación.",{"_3396":70636,"_29729":70613,"_20626":119566,"_5":14148,"_27027":119492,"_2882":119567},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3396":70637,"_29729":70613,"_20626":119569,"_5":14148,"_27027":119492,"_2882":119570},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3396":70638,"_29729":70613,"_20626":119572,"_5":14148,"_27027":119496,"_2882":119573},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3396":70639,"_29729":70613,"_20626":119575,"_5":14148,"_27027":119496,"_2882":119576},[],"Si un rol VA de CRL de la CA está firmado por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para un rol firmado por otro certificado, el rol conserva su firmante, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_3396":70640,"_29729":70613,"_20626":119578,"_5":14148,"_27027":119496,"_2882":119579},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3396":70641,"_29729":70613,"_20626":119581,"_5":14148,"_27027":119496,"_2882":119582},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3396":70642,"_29729":70613,"_20626":119584,"_5":14148,"_27027":119500,"_2882":119585},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3396":70643,"_29729":70613,"_20626":119587,"_5":14148,"_27027":119500,"_2882":119588},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3396":70644,"_29729":70613,"_20626":119590,"_5":14148,"_27027":119500,"_2882":119591},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3396":70645,"_29729":70613,"_20626":119593,"_5":14148,"_27027":119500,"_2882":119594},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3396":70646,"_29729":70613,"_20626":119596,"_5":14148,"_27027":119508,"_2882":119597},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3396":70647,"_29729":70613,"_20626":119599,"_5":14148,"_27027":119512,"_2882":119600},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3396":70648,"_29729":70613,"_20626":119602,"_5":14148,"_27027":119516,"_2882":119603},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3396":70649,"_29729":70613,"_20626":119605,"_5":14148,"_27027":119520,"_2882":119606},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3396":70650,"_29729":70613,"_20626":119608,"_5":14148,"_27027":119524,"_2882":119609},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3396":70651,"_29729":70613,"_20626":119611,"_5":14148,"_27027":119528,"_2882":119612},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3396":70652,"_29729":70613,"_20626":119614,"_5":14148,"_27027":119532,"_2882":119615},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3396":70653,"_29729":70613,"_20626":119617,"_5":14148,"_27027":119532,"_2882":119618},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3396":70654,"_29729":70613,"_20626":119620,"_5":14148,"_27027":119532,"_2882":119621},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3396":70655,"_29729":70613,"_20626":119623,"_5":14148,"_27027":119532,"_2882":119624},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3396":70656,"_29729":70613,"_20626":119626,"_5":14148,"_27027":119536,"_2882":119627},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3396":70657,"_29729":70613,"_20626":119629,"_5":14148,"_27027":119536,"_2882":119630},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3396":70658,"_29729":70613,"_20626":119632,"_5":14148,"_27027":119536,"_2882":119633},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3396":70659,"_29729":70613,"_20626":119635,"_5":14148,"_27027":119536,"_2882":119636},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3396":70660,"_29729":70613,"_20626":119638,"_5":14148,"_27027":119536,"_2882":119639},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3396":70661,"_29729":70613,"_20626":119641,"_5":14148,"_27027":119536,"_2882":119642},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3396":70662,"_29729":70613,"_20626":119644,"_5":14148,"_27027":119536,"_2882":119645},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3396":70663,"_29729":70663,"_5":14500,"_2882":119647,"_30082":119648,"_20626":119649,"_27027":70663},"Autoridades de certificación",[48429,115610,53899,119485],[],{"_3396":70664,"_29729":70663,"_20626":119651,"_5":14148,"_27027":70663,"_2882":119652},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3396":70665,"_29729":70663,"_5":30079,"_20626":119654,"_27027":119655,"_2882":119656},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3396":70666,"_29729":70663,"_5":30079,"_20626":119658,"_27027":119659,"_2882":119660},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3396":70667,"_29729":70663,"_5":30079,"_20626":119662,"_27027":119663,"_2882":114188},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3396":70668,"_29729":70663,"_5":30079,"_20626":119665,"_27027":119666,"_2882":119667},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3396":70669,"_29729":70663,"_5":30079,"_20626":119669,"_27027":119670,"_2882":119671},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3396":70670,"_29729":70663,"_5":30079,"_20626":119673,"_27027":119674,"_2882":119675},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3396":70671,"_29729":70663,"_5":30079,"_20626":119677,"_27027":119678,"_2882":119679},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3396":70672,"_29729":70663,"_5":30079,"_20626":119681,"_27027":119682,"_2882":119683},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3396":70673,"_29729":70663,"_5":30079,"_20626":119685,"_27027":119686,"_2882":119687},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3396":70674,"_29729":70663,"_5":30079,"_20626":119689,"_27027":119690,"_2882":119691},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3396":70675,"_29729":70663,"_5":30079,"_20626":119693,"_27027":119694,"_2882":119695},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3396":70676,"_29729":70663,"_5":30079,"_20626":119697,"_27027":119698,"_2882":119699},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3396":70677,"_29729":70663,"_5":30079,"_20626":119701,"_27027":119702,"_2882":119703},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3396":70678,"_29729":70663,"_5":30079,"_20626":119705,"_27027":119706,"_2882":119707},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3396":70679,"_29729":70663,"_5":30079,"_20626":119709,"_27027":119710,"_2882":119711},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3396":70680,"_29729":70663,"_5":30079,"_20626":119713,"_27027":119714,"_2882":119715},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3396":70681,"_29729":70663,"_5":30079,"_20626":119717,"_27027":119718,"_2882":119719},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3396":70682,"_29729":70663,"_5":30079,"_20626":119721,"_27027":119722,"_2882":119723},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3396":70683,"_29729":70663,"_5":30079,"_20626":119725,"_27027":119726,"_2882":119727},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3396":70684,"_29729":70663,"_5":30079,"_20626":119729,"_27027":119730,"_2882":119731},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3396":70685,"_29729":70663,"_5":30079,"_20626":119733,"_27027":119734,"_2882":119735},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3396":70686,"_29729":70663,"_5":30079,"_20626":119737,"_27027":119738,"_2882":119739},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3396":70687,"_29729":70663,"_5":30079,"_20626":119741,"_27027":119742,"_2882":119743},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3396":70688,"_29729":70663,"_20626":119745,"_5":14148,"_27027":70663,"_2882":119746},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3396":70689,"_29729":70663,"_20626":119748,"_5":14148,"_27027":70663,"_2882":119749},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3396":70690,"_29729":70663,"_20626":119751,"_5":14148,"_27027":70663,"_2882":119752},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3396":70691,"_29729":70663,"_20626":119754,"_5":14148,"_27027":119655,"_2882":119755},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3396":70692,"_29729":70663,"_20626":119757,"_5":14148,"_27027":119655,"_2882":119758},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3396":70693,"_29729":70663,"_20626":119760,"_5":14148,"_27027":119655,"_2882":119761},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3396":70694,"_29729":70663,"_20626":119763,"_5":14148,"_27027":119655,"_2882":119764},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3396":70695,"_29729":70663,"_20626":119766,"_5":14148,"_27027":119655,"_2882":119767},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3396":70696,"_29729":70663,"_20626":119769,"_5":14148,"_27027":119663,"_2882":119770},[],"Decide si la CA será raíz o intermedia.",{"_3396":70697,"_29729":70663,"_20626":119772,"_5":14148,"_27027":119663,"_2882":119773},[],"Elige el motor que custodiará la clave.",{"_3396":70698,"_29729":70663,"_20626":119775,"_5":14148,"_27027":119663,"_2882":119776},[],"Define una validez superior a la de los certificados que emitirá.",{"_3396":70699,"_29729":70663,"_20626":119778,"_5":14148,"_27027":119663,"_2882":119779},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3396":70700,"_29729":70663,"_20626":119781,"_5":14148,"_27027":119666,"_2882":119782},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3396":70701,"_29729":70663,"_20626":119784,"_5":14148,"_27027":119670,"_2882":119785},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3396":70702,"_29729":70663,"_20626":119787,"_5":14148,"_27027":119670,"_2882":119788},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3396":70703,"_29729":70663,"_20626":119790,"_5":14148,"_27027":119674,"_2882":119791},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3396":70704,"_29729":70663,"_20626":119793,"_5":14148,"_27027":119678,"_2882":119794},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3396":70705,"_29729":70663,"_20626":119796,"_5":14148,"_27027":119678,"_2882":119797},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3396":70706,"_29729":70663,"_20626":119799,"_5":14148,"_27027":119678,"_2882":119800},[],"`ST`: estado o provincia.",{"_3396":70707,"_29729":70663,"_20626":119802,"_5":14148,"_27027":119678,"_2882":119803},[],"`L`: localidad.",{"_3396":70708,"_29729":70663,"_20626":119805,"_5":14148,"_27027":119678,"_2882":119806},[],"`O`: organización.",{"_3396":70709,"_29729":70663,"_20626":119808,"_5":14148,"_27027":119678,"_2882":119809},[],"`OU`: unidad organizativa.",{"_3396":70710,"_29729":70663,"_20626":119811,"_5":14148,"_27027":119678,"_2882":119812},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3396":70711,"_29729":70663,"_20626":119814,"_5":14148,"_27027":119682,"_2882":119815},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3396":70712,"_29729":70663,"_20626":119817,"_5":14148,"_27027":119682,"_2882":119818},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3396":70713,"_29729":70663,"_20626":119820,"_5":14148,"_27027":119686,"_2882":119821},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3396":70714,"_29729":70663,"_20626":119823,"_5":14148,"_27027":119686,"_2882":119824},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3396":70715,"_29729":70663,"_20626":119826,"_5":14148,"_27027":119690,"_2882":119827},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3396":70716,"_29729":70663,"_20626":119829,"_5":14148,"_27027":119690,"_2882":119830},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3396":70717,"_29729":70663,"_20626":119832,"_5":14148,"_27027":119694,"_2882":119833},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3396":70718,"_29729":70663,"_20626":119835,"_5":14148,"_27027":119694,"_2882":119836},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3396":70719,"_29729":70663,"_20626":119838,"_5":14148,"_27027":119694,"_2882":119839},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3396":70720,"_29729":70663,"_20626":119841,"_5":14148,"_27027":119698,"_2882":119842},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3396":70721,"_29729":70663,"_20626":119844,"_5":14148,"_27027":119702,"_2882":119845},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3396":70722,"_29729":70663,"_20626":119847,"_5":14148,"_27027":119702,"_2882":119848},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3396":70723,"_29729":70663,"_20626":119850,"_5":14148,"_27027":119706,"_2882":119851},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3396":70724,"_29729":70663,"_20626":119853,"_5":14148,"_27027":119710,"_2882":119854},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3396":70725,"_29729":70663,"_20626":119856,"_5":14148,"_27027":119710,"_2882":119857},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3396":70726,"_29729":70663,"_20626":119859,"_5":14148,"_27027":119714,"_2882":119860},[],"Abre una CA desde el inventario para consultar:",{"_3396":70727,"_29729":70663,"_20626":119862,"_5":14148,"_27027":119714,"_2882":119863},[],"Estado y periodo de validez.",{"_3396":70728,"_29729":70663,"_20626":119865,"_5":14148,"_27027":119714,"_2882":119866},[],"Certificado y cadena en formato PEM.",{"_3396":70729,"_29729":70663,"_20626":119868,"_5":14148,"_27027":119714,"_2882":119869},[],"Número de certificados activos, expirados y revocados.",{"_3396":70730,"_29729":70663,"_20626":119871,"_5":14148,"_27027":119714,"_2882":119872},[],"Certificados emitidos en **Issued Certificates**.",{"_3396":70731,"_29729":70663,"_20626":119874,"_5":14148,"_27027":119714,"_2882":119875},[],"CRL vinculada a la autoridad.",{"_3396":70732,"_29729":70663,"_20626":119877,"_5":14148,"_27027":119714,"_2882":119878},[],"Metadatos y motor criptográfico asociado.",{"_3396":70733,"_29729":70663,"_20626":119880,"_5":14148,"_27027":119714,"_2882":119881},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3396":70734,"_29729":70663,"_20626":119883,"_5":14148,"_27027":119718,"_2882":119884},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3396":70735,"_29729":70663,"_20626":119886,"_5":14148,"_27027":119718,"_2882":119887},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3396":70736,"_29729":70663,"_20626":119889,"_5":14148,"_27027":119718,"_2882":119890},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3396":70737,"_29729":70663,"_20626":119892,"_5":14148,"_27027":119718,"_2882":119893},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3396":70738,"_29729":70663,"_20626":119895,"_5":14148,"_27027":119722,"_2882":119896},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3396":70739,"_29729":70663,"_20626":119898,"_5":14148,"_27027":119726,"_2882":119899},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3396":70740,"_29729":70663,"_20626":119901,"_5":14148,"_27027":119730,"_2882":119902},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3396":70741,"_29729":70663,"_20626":119904,"_5":14148,"_27027":119734,"_2882":119905},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3396":70742,"_29729":70663,"_20626":119907,"_5":14148,"_27027":119738,"_2882":119908},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3396":70743,"_29729":70663,"_20626":119910,"_5":14148,"_27027":119742,"_2882":119911},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3396":70744,"_29729":70663,"_20626":119913,"_5":14148,"_27027":119742,"_2882":119914},[],"El rol VA de la CA se conserva. Si no queda otra CA con el mismo SKI, deja de ser editable (consulta CRL), así que ajusta antes su validez y su firmante. La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3396":70745,"_29729":70663,"_20626":119916,"_5":14148,"_27027":119742,"_2882":119917},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. Si el certificado nuevo usa la misma clave, comparte el SKI con el rol VA retenido de la CA eliminada, cuyo firmante es el certificado antiguo: comprueba que la CRL se genera y, si no es así, asigna con `PUT` un firmante de la CA nueva (consulta CRL).",{"_3396":70746,"_29729":70746,"_5":14500,"_2882":119919,"_30082":119920,"_20626":119921,"_27027":70746},"Perfiles de certificado",[48429,115610,53899,119485],[],{"_3396":70747,"_29729":70746,"_20626":119923,"_5":14148,"_27027":70746,"_2882":119924},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3396":70748,"_29729":70746,"_5":30079,"_20626":119926,"_27027":119927,"_2882":119928},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3396":70749,"_29729":70746,"_5":30079,"_20626":119930,"_27027":119931,"_2882":119932},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#validez","Validez",{"_3396":70750,"_29729":70746,"_5":30079,"_20626":119934,"_27027":119935,"_2882":119936},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3396":70751,"_29729":70746,"_5":30079,"_20626":119938,"_27027":119939,"_2882":119940},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3396":70752,"_29729":70746,"_5":30079,"_20626":119942,"_27027":119943,"_2882":119944},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3396":70753,"_29729":70746,"_5":30079,"_20626":119946,"_27027":119947,"_2882":119948},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3396":70754,"_29729":70746,"_5":30079,"_20626":119950,"_27027":119951,"_2882":119952},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3396":70755,"_29729":70746,"_5":30079,"_20626":119954,"_27027":119955,"_2882":119956},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3396":70756,"_29729":70746,"_5":30079,"_20626":119958,"_27027":119959,"_2882":119960},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3396":70757,"_29729":70746,"_5":30079,"_20626":119962,"_27027":119963,"_2882":119964},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3396":70758,"_29729":70746,"_5":30079,"_20626":119966,"_27027":119967,"_2882":119968},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3396":70759,"_29729":70746,"_5":30079,"_20626":119970,"_27027":119971,"_2882":119972},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3396":70760,"_29729":70746,"_5":30079,"_20626":119974,"_27027":119975,"_2882":119976},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3396":70761,"_29729":70746,"_5":30079,"_20626":119978,"_27027":119979,"_2882":119980},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3396":70762,"_29729":70746,"_5":30079,"_20626":119982,"_27027":119983,"_2882":119984},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3396":70763,"_29729":70746,"_5":30079,"_20626":119986,"_27027":119987,"_2882":119988},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3396":70764,"_29729":70746,"_20626":119990,"_5":14148,"_27027":70746,"_2882":119991},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3396":70765,"_29729":70746,"_20626":119993,"_5":14148,"_27027":70746,"_2882":119994},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3396":70766,"_29729":70746,"_20626":119996,"_5":14148,"_27027":119931,"_2882":119997},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3396":70767,"_29729":70746,"_20626":119999,"_5":14148,"_27027":119931,"_2882":120000},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3396":70768,"_29729":70746,"_20626":120002,"_5":14148,"_27027":119935,"_2882":120003},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3396":70769,"_29729":70746,"_20626":120005,"_5":14148,"_27027":119939,"_2882":120006},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3396":70770,"_29729":70746,"_20626":120008,"_5":14148,"_27027":119939,"_2882":120009},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3396":70771,"_29729":70746,"_20626":120011,"_5":14148,"_27027":119939,"_2882":120012},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3396":70772,"_29729":70746,"_20626":120014,"_5":14148,"_27027":119943,"_2882":120015},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3396":70773,"_29729":70746,"_20626":120017,"_5":14148,"_27027":119947,"_2882":120018},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3396":70774,"_29729":70746,"_20626":120020,"_5":14148,"_27027":119947,"_2882":120021},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3396":70775,"_29729":70746,"_20626":120023,"_5":14148,"_27027":119951,"_2882":120024},[],"La aplicación criptográfica puede:",{"_3396":70776,"_29729":70746,"_20626":120026,"_5":14148,"_27027":119951,"_2882":120027},[],"permitir o bloquear claves RSA;",{"_3396":70777,"_29729":70746,"_20626":120029,"_5":14148,"_27027":119951,"_2882":120030},[],"limitar los tamaños RSA admitidos;",{"_3396":70778,"_29729":70746,"_20626":120032,"_5":14148,"_27027":119951,"_2882":120033},[],"permitir o bloquear claves ECDSA;",{"_3396":70779,"_29729":70746,"_20626":120035,"_5":14148,"_27027":119951,"_2882":120036},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3396":70780,"_29729":70746,"_20626":120038,"_5":14148,"_27027":119951,"_2882":120039},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3396":70781,"_29729":70746,"_20626":120041,"_5":14148,"_27027":119955,"_2882":120042},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3396":70782,"_29729":70746,"_20626":120044,"_5":14148,"_27027":119955,"_2882":115370},[],{"_3396":70783,"_29729":70746,"_20626":120046,"_5":14148,"_27027":119955,"_2882":120047},[],"Primera opción",{"_3396":70784,"_29729":70746,"_20626":120049,"_5":14148,"_27027":119955,"_2882":120050},[],"Segunda opción",{"_3396":70785,"_29729":70746,"_20626":120052,"_5":14148,"_27027":119955,"_2882":120053},[],"Si no hay ninguna",{"_3396":70786,"_29729":70746,"_20626":120055,"_5":14148,"_27027":119955,"_2882":120056},[],"Firma directa con una CA",{"_3396":70787,"_29729":70746,"_20626":120058,"_5":14148,"_27027":119955,"_2882":120059},[],"`issuance_profile` incluido en la solicitud",{"_3396":70788,"_29729":70746,"_20626":120061,"_5":14148,"_27027":119955,"_2882":120062},[],"`issuance_profile_id` de la solicitud",{"_3396":70789,"_29729":70746,"_20626":120064,"_5":14148,"_27027":119955,"_2882":120065},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3396":70790,"_29729":70746,"_20626":120067,"_5":14148,"_27027":119955,"_2882":120068},[],"Emisión mediante DMS",{"_3396":70791,"_29729":70746,"_20626":120070,"_5":14148,"_27027":119955,"_2882":54486},[],{"_3396":70792,"_29729":70746,"_20626":120072,"_5":14148,"_27027":119955,"_2882":120073},[],"`settings.issuance_profile` incluido en el DMS",{"_3396":70793,"_29729":70746,"_20626":120075,"_5":14148,"_27027":119955,"_2882":120076},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3396":70794,"_29729":70746,"_20626":120078,"_5":14148,"_27027":119955,"_2882":120079},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3396":70795,"_29729":70746,"_20626":120081,"_5":14148,"_27027":119955,"_2882":120082},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3396":70796,"_29729":70746,"_20626":120084,"_5":14148,"_27027":119963,"_2882":120085},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3396":70797,"_29729":70746,"_20626":120087,"_5":14148,"_27027":119967,"_2882":120088},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3396":70798,"_29729":70746,"_20626":120090,"_5":14148,"_27027":119971,"_2882":120091},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3396":70799,"_29729":70746,"_20626":120093,"_5":14148,"_27027":119975,"_2882":120094},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3396":70800,"_29729":70746,"_20626":120096,"_5":14148,"_27027":119979,"_2882":120097},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3396":70801,"_29729":70746,"_20626":120099,"_5":14148,"_27027":119979,"_2882":120100},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3396":70802,"_29729":70746,"_20626":120102,"_5":14148,"_27027":119983,"_2882":120103},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3396":70803,"_29729":70746,"_20626":120105,"_5":14148,"_27027":119983,"_2882":120106},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3396":70804,"_29729":70746,"_20626":120108,"_5":14148,"_27027":119983,"_2882":120109},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3396":70805,"_29729":70746,"_20626":120111,"_5":14148,"_27027":119983,"_2882":120112},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3396":70806,"_29729":70746,"_20626":120114,"_5":14148,"_27027":119987,"_2882":120115},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3396":70807,"_29729":70746,"_20626":120117,"_5":14148,"_27027":119987,"_2882":120118},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3396":70808,"_29729":70808,"_5":14500,"_2882":120120,"_30082":120121,"_20626":120123,"_27027":70808},"Validación de certificados",[48429,115610,53899,120122],"Validación",[],{"_3396":70809,"_29729":70808,"_20626":120125,"_5":14148,"_27027":70808,"_2882":120126},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3396":70810,"_29729":70808,"_5":30079,"_20626":120128,"_27027":120129,"_2882":120130},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3396":70811,"_29729":70808,"_5":30079,"_20626":120132,"_27027":120133,"_2882":120134},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3396":70812,"_29729":70808,"_5":30079,"_20626":120136,"_27027":120137,"_2882":120138},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3396":70813,"_29729":70808,"_20626":120140,"_5":14148,"_27027":70808,"_2882":120141},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3396":70814,"_29729":70808,"_20626":120143,"_5":14148,"_27027":120129,"_2882":120144},[],"Verifica estos criterios juntos:",{"_3396":70815,"_29729":70808,"_20626":120146,"_5":14148,"_27027":120129,"_2882":119114},[],{"_3396":70816,"_29729":70808,"_20626":120148,"_5":14148,"_27027":120129,"_2882":120149},[],"Resultado necesario",{"_3396":70817,"_29729":70808,"_20626":120151,"_5":14148,"_27027":120129,"_2882":120152},[],"Cadena y firma",{"_3396":70818,"_29729":70808,"_20626":120154,"_5":14148,"_27027":120129,"_2882":120155},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3396":70819,"_29729":70808,"_20626":120157,"_5":14148,"_27027":120129,"_2882":120158},[],"Fechas",{"_3396":70820,"_29729":70808,"_20626":120160,"_5":14148,"_27027":120129,"_2882":120161},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3396":70821,"_29729":70808,"_20626":120163,"_5":14148,"_27027":120129,"_2882":115280},[],{"_3396":70822,"_29729":70808,"_20626":120165,"_5":14148,"_27027":120129,"_2882":120166},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3396":70823,"_29729":70808,"_20626":120168,"_5":14148,"_27027":120129,"_2882":120169},[],"Uso",{"_3396":70824,"_29729":70808,"_20626":120171,"_5":14148,"_27027":120129,"_2882":120172},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3396":70825,"_29729":70808,"_20626":120174,"_5":14148,"_27027":120129,"_2882":120175},[],"Revocación",{"_3396":70826,"_29729":70808,"_20626":120177,"_5":14148,"_27027":120129,"_2882":120178},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3396":70827,"_29729":70808,"_20626":120180,"_5":14148,"_27027":120129,"_2882":120181},[],"Autorización",{"_3396":70828,"_29729":70808,"_20626":120183,"_5":14148,"_27027":120129,"_2882":120184},[],"La aplicación permite la acción a esa identidad.",{"_3396":70829,"_29729":70808,"_20626":120186,"_5":14148,"_27027":120129,"_2882":120187},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3396":70830,"_29729":70808,"_20626":120189,"_5":14148,"_27027":120133,"_2882":120190},[],"Mecanismo",{"_3396":70831,"_29729":70808,"_20626":120192,"_5":14148,"_27027":120133,"_2882":120193},[],"Cuándo utilizarlo",{"_3396":70832,"_29729":70808,"_20626":120195,"_5":14148,"_27027":120133,"_2882":120196},[],"Qué debes mantener",{"_3396":70833,"_29729":70808,"_20626":120198,"_5":14148,"_27027":120133,"_2882":54614},[],{"_3396":70834,"_29729":70808,"_20626":120200,"_5":14148,"_27027":120133,"_2882":120201},[],"Consulta del estado de un certificado concreto.",{"_3396":70835,"_29729":70808,"_20626":120203,"_5":14148,"_27027":120133,"_2882":120204},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3396":70836,"_29729":70808,"_20626":120206,"_5":14148,"_27027":120133,"_2882":54623},[],{"_3396":70837,"_29729":70808,"_20626":120208,"_5":14148,"_27027":120133,"_2882":120209},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3396":70838,"_29729":70808,"_20626":120211,"_5":14148,"_27027":120133,"_2882":120212},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3396":70839,"_29729":70808,"_20626":120214,"_5":14148,"_27027":120133,"_2882":120215},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3396":70840,"_29729":70808,"_20626":120217,"_5":14148,"_27027":120133,"_2882":120218},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3396":70841,"_29729":70808,"_20626":120220,"_5":14148,"_27027":120137,"_2882":120221},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3396":70842,"_29729":70808,"_20626":120223,"_5":14148,"_27027":120137,"_2882":120224},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3396":70843,"_29729":70808,"_20626":120226,"_5":14148,"_27027":120137,"_2882":120227},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3396":70844,"_29729":70808,"_20626":120229,"_5":14148,"_27027":120137,"_2882":120230},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3396":70845,"_29729":70808,"_20626":120232,"_5":14148,"_27027":120137,"_2882":120233},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3396":70846,"_29729":70808,"_20626":120235,"_5":14148,"_27027":120137,"_2882":120236},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3396":70847,"_29729":70808,"_20626":120238,"_5":14148,"_27027":120137,"_2882":120239},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3396":70848,"_29729":70808,"_20626":120241,"_5":14148,"_27027":120137,"_2882":120242},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3396":70849,"_29729":70808,"_20626":120244,"_5":14148,"_27027":120137,"_2882":120245},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3396":70850,"_29729":70850,"_5":14500,"_2882":120247,"_30082":120248,"_20626":120249,"_27027":70850},"Certificados",[48429,115610,53899,119485],[],{"_3396":70851,"_29729":70850,"_20626":120251,"_5":14148,"_27027":70850,"_2882":120252},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3396":70852,"_29729":70850,"_5":30079,"_20626":120254,"_27027":120255,"_2882":120256},[],"/docs/pr-preview/pr-57/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3396":70853,"_29729":70850,"_5":30079,"_20626":120258,"_27027":120259,"_2882":120260},[],"/docs/pr-preview/pr-57/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3396":70854,"_29729":70850,"_5":30079,"_20626":120262,"_27027":120263,"_2882":120264},[],"/docs/pr-preview/pr-57/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3396":70855,"_29729":70850,"_5":30079,"_20626":120266,"_27027":120267,"_2882":120268},[],"/docs/pr-preview/pr-57/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3396":70856,"_29729":70850,"_5":30079,"_20626":120270,"_27027":120271,"_2882":120272},[],"/docs/pr-preview/pr-57/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3396":70857,"_29729":70850,"_5":30079,"_20626":120274,"_27027":120275,"_2882":120276},[],"/docs/pr-preview/pr-57/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3396":70858,"_29729":70850,"_5":30079,"_20626":120278,"_27027":120279,"_2882":120280},[],"/docs/pr-preview/pr-57/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3396":70859,"_29729":70850,"_5":30079,"_20626":120282,"_27027":120283,"_2882":120284},[],"/docs/pr-preview/pr-57/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3396":70860,"_29729":70850,"_5":30079,"_20626":120286,"_27027":120287,"_2882":120288},[],"/docs/pr-preview/pr-57/es/platform/pki/certificates#continúa","Continúa",{"_3396":70861,"_29729":70850,"_20626":120290,"_5":14148,"_27027":70850,"_2882":120291},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3396":70862,"_29729":70850,"_20626":120293,"_5":14148,"_27027":120255,"_2882":120294},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3396":70863,"_29729":70850,"_20626":120296,"_5":14148,"_27027":120255,"_2882":120297},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3396":70864,"_29729":70850,"_20626":120299,"_5":14148,"_27027":120255,"_2882":120300},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3396":70865,"_29729":70850,"_20626":120302,"_5":14148,"_27027":120255,"_2882":120303},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3396":70866,"_29729":70850,"_20626":120305,"_5":14148,"_27027":120255,"_2882":120306},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3396":70867,"_29729":70850,"_20626":120308,"_5":14148,"_27027":120255,"_2882":120309},[],"Los detalles del certificado incluyen la referencia a la clave (`key_id`) y si la clave privada está gestionada (`has_private_key`); las listas de certificados pueden filtrarse por `has_private_key`.",{"_3396":70868,"_29729":70850,"_20626":120311,"_5":14148,"_27027":120255,"_2882":120312},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3396":70869,"_29729":70850,"_20626":120314,"_5":14148,"_27027":120255,"_2882":120315},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3396":70870,"_29729":70850,"_20626":120317,"_5":14148,"_27027":120259,"_2882":120318},[],"Descarga el PEM e inspecciónalo:",{"_3396":70871,"_29729":70850,"_20626":120320,"_5":14148,"_27027":120259,"_2882":120321},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3396":70872,"_29729":70850,"_20626":120323,"_5":14148,"_27027":120263,"_2882":120324},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3396":70873,"_29729":70850,"_20626":120326,"_5":14148,"_27027":120263,"_2882":120327},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3396":70874,"_29729":70850,"_20626":120329,"_5":14148,"_27027":120263,"_2882":120330},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3396":70875,"_29729":70850,"_20626":120332,"_5":14148,"_27027":120263,"_2882":120333},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3396":70876,"_29729":70850,"_20626":120335,"_5":14148,"_27027":120263,"_2882":120336},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3396":70877,"_29729":70850,"_20626":120338,"_5":14148,"_27027":120263,"_2882":120339},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3396":70878,"_29729":70850,"_20626":120341,"_5":14148,"_27027":120263,"_2882":120342},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3396":70879,"_29729":70850,"_20626":120344,"_5":14148,"_27027":120267,"_2882":120345},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3396":70880,"_29729":70850,"_20626":120347,"_5":14148,"_27027":120271,"_2882":120348},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3396":70881,"_29729":70850,"_20626":120350,"_5":14148,"_27027":120275,"_2882":120351},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3396":70882,"_29729":70850,"_20626":120353,"_5":14148,"_27027":120279,"_2882":120354},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3396":70883,"_29729":70850,"_20626":120356,"_5":14148,"_27027":120279,"_2882":120357},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3396":70884,"_29729":70850,"_20626":120359,"_5":14148,"_27027":120279,"_2882":120360},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3396":70885,"_29729":70850,"_20626":120362,"_5":14148,"_27027":120283,"_2882":120363},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3396":70886,"_29729":70850,"_20626":120365,"_5":14148,"_27027":120283,"_2882":120366},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3396":70887,"_29729":70850,"_20626":120368,"_5":14148,"_27027":120283,"_2882":120369},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3396":70888,"_29729":70850,"_20626":120371,"_5":14148,"_27027":120287,"_2882":120372},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3396":70889,"_29729":70850,"_20626":120374,"_5":14148,"_27027":120287,"_2882":120375},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3396":70890,"_29729":70890,"_5":14500,"_2882":120377,"_30082":120378,"_20626":120380,"_27027":70890},"Ciclo de vida de un certificado",[48429,115610,53899,120379],"Conceptos",[],{"_3396":70891,"_29729":70890,"_20626":120382,"_5":14148,"_27027":70890,"_2882":120383},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3396":70892,"_29729":70890,"_5":30079,"_20626":120385,"_27027":120386,"_2882":120387},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3396":70893,"_29729":70890,"_5":30079,"_20626":120389,"_27027":120390,"_2882":120391},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3396":70894,"_29729":70890,"_5":30079,"_20626":120393,"_27027":120394,"_2882":120395},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3396":70895,"_29729":70890,"_5":30079,"_20626":120397,"_27027":120398,"_2882":120399},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3396":70896,"_29729":70890,"_5":30079,"_20626":120401,"_27027":120402,"_2882":120403},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3396":70897,"_29729":70890,"_5":30079,"_20626":120405,"_27027":120406,"_2882":120407},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3396":70898,"_29729":70890,"_5":30079,"_20626":120409,"_27027":120410,"_2882":118108},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3396":70899,"_29729":70890,"_5":30079,"_20626":120412,"_27027":120413,"_2882":120414},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3396":70900,"_29729":70890,"_5":30079,"_20626":120416,"_27027":120417,"_2882":120418},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3396":70901,"_29729":70890,"_5":30079,"_20626":120420,"_27027":120421,"_2882":120422},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3396":70902,"_29729":70890,"_20626":120424,"_5":14148,"_27027":70890,"_2882":120425},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3396":70903,"_29729":70890,"_20626":120427,"_5":14148,"_27027":120390,"_2882":120428},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3396":70904,"_29729":70890,"_20626":120430,"_5":14148,"_27027":120394,"_2882":120431},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3396":70905,"_29729":70890,"_20626":120433,"_5":14148,"_27027":120398,"_2882":120434},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3396":70906,"_29729":70890,"_20626":120436,"_5":14148,"_27027":120402,"_2882":120437},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3396":70907,"_29729":70890,"_20626":120439,"_5":14148,"_27027":120406,"_2882":120440},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3396":70908,"_29729":70890,"_20626":120442,"_5":14148,"_27027":120410,"_2882":120443},[],"Lamassu persiste cuatro estados X.509:",{"_3396":70909,"_29729":70890,"_20626":120445,"_5":14148,"_27027":120410,"_2882":120446},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3396":70910,"_29729":70890,"_20626":120448,"_5":14148,"_27027":120410,"_2882":120449},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3396":70911,"_29729":70890,"_20626":120451,"_5":14148,"_27027":120410,"_2882":120452},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3396":70912,"_29729":70890,"_20626":120454,"_5":14148,"_27027":120410,"_2882":120455},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3396":70913,"_29729":70890,"_20626":120457,"_5":14148,"_27027":120410,"_2882":120458},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3396":70914,"_29729":70890,"_20626":120460,"_5":14148,"_27027":120413,"_2882":120461},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3396":70915,"_29729":70890,"_20626":120463,"_5":14148,"_27027":120413,"_2882":120464},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3396":70916,"_29729":70890,"_20626":120466,"_5":14148,"_27027":120413,"_2882":120467},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3396":70917,"_29729":70890,"_20626":120469,"_5":14148,"_27027":120417,"_2882":120470},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3396":70918,"_29729":70890,"_20626":120472,"_5":14148,"_27027":120417,"_2882":120473},[],"Antes de confirmar:",{"_3396":70919,"_29729":70890,"_20626":120475,"_5":14148,"_27027":120417,"_2882":120476},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3396":70920,"_29729":70890,"_20626":120478,"_5":14148,"_27027":120417,"_2882":120479},[],"Distribuye la nueva cadena de confianza.",{"_3396":70921,"_29729":70890,"_20626":120481,"_5":14148,"_27027":120417,"_2882":120482},[],"Reemite las identidades necesarias.",{"_3396":70922,"_29729":70890,"_20626":120484,"_5":14148,"_27027":120417,"_2882":120485},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3396":70923,"_29729":70890,"_20626":120487,"_5":14148,"_27027":120417,"_2882":120488},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3396":70924,"_29729":70890,"_20626":120490,"_5":14148,"_27027":120417,"_2882":120491},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3396":70925,"_29729":70890,"_20626":120493,"_5":14148,"_27027":120421,"_2882":120494},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3396":70926,"_29729":70890,"_20626":120496,"_5":14148,"_27027":120421,"_2882":120497},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3396":70927,"_29729":70890,"_20626":120499,"_5":14148,"_27027":120421,"_2882":120500},[],"Cambios de estado y razones de revocación.",{"_3396":70928,"_29729":70890,"_20626":120502,"_5":14148,"_27027":120421,"_2882":120503},[],"Publicación y vigencia de OCSP y CRLs.",{"_3396":70929,"_29729":70890,"_20626":120505,"_5":14148,"_27027":120421,"_2882":120506},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3396":70930,"_29729":70890,"_20626":120508,"_5":14148,"_27027":120421,"_2882":120509},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3396":70931,"_29729":70931,"_5":14500,"_2882":120511,"_30082":120512,"_20626":120513,"_27027":70931},"Modelo de confianza",[48429,115610,53899,120379],[],{"_3396":70932,"_29729":70931,"_20626":120515,"_5":14148,"_27027":70931,"_2882":120516},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3396":70933,"_29729":70931,"_5":30079,"_20626":120518,"_27027":120519,"_2882":120520},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3396":70934,"_29729":70931,"_5":30079,"_20626":120522,"_27027":120523,"_2882":120524},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3396":70935,"_29729":70931,"_5":30079,"_20626":120526,"_27027":120527,"_2882":120528},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3396":70936,"_29729":70931,"_5":30079,"_20626":120530,"_27027":120531,"_2882":120532},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3396":70937,"_29729":70931,"_5":30079,"_20626":120534,"_27027":120535,"_2882":120536},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3396":70938,"_29729":70931,"_5":30079,"_20626":120538,"_27027":120539,"_2882":120540},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3396":70939,"_29729":70931,"_5":30079,"_20626":120542,"_27027":120543,"_2882":120544},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3396":70940,"_29729":70931,"_5":30079,"_20626":120546,"_27027":120547,"_2882":120548},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3396":70941,"_29729":70931,"_5":30079,"_20626":120550,"_27027":120551,"_2882":120552},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3396":70942,"_29729":70931,"_5":30079,"_20626":120554,"_27027":120555,"_2882":120556},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3396":70943,"_29729":70931,"_20626":120558,"_5":14148,"_27027":70931,"_2882":120559},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3396":70944,"_29729":70931,"_20626":120561,"_5":14148,"_27027":120523,"_2882":120562},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3396":70945,"_29729":70931,"_20626":120564,"_5":14148,"_27027":120527,"_2882":120565},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3396":70946,"_29729":70931,"_20626":120567,"_5":14148,"_27027":120531,"_2882":120568},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3396":70947,"_29729":70931,"_20626":120570,"_5":14148,"_27027":120535,"_2882":120571},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3396":70948,"_29729":70931,"_20626":120573,"_5":14148,"_27027":120539,"_2882":120574},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3396":70949,"_29729":70931,"_20626":120576,"_5":14148,"_27027":120539,"_2882":120577},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3396":70950,"_29729":70931,"_20626":120579,"_5":14148,"_27027":120539,"_2882":120580},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3396":70951,"_29729":70931,"_20626":120582,"_5":14148,"_27027":120539,"_2882":120583},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3396":70952,"_29729":70931,"_20626":120585,"_5":14148,"_27027":120539,"_2882":120586},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3396":70953,"_29729":70931,"_20626":120588,"_5":14148,"_27027":120539,"_2882":120589},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3396":70954,"_29729":70931,"_20626":120591,"_5":14148,"_27027":120543,"_2882":120592},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3396":70955,"_29729":70931,"_20626":120594,"_5":14148,"_27027":120543,"_2882":120595},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3396":70956,"_29729":70931,"_20626":120597,"_5":14148,"_27027":120543,"_2882":120598},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3396":70957,"_29729":70931,"_20626":120600,"_5":14148,"_27027":120543,"_2882":120601},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3396":70958,"_29729":70931,"_20626":120603,"_5":14148,"_27027":120543,"_2882":120604},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3396":70959,"_29729":70931,"_20626":120606,"_5":14148,"_27027":120547,"_2882":120607},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3396":70960,"_29729":70931,"_20626":120609,"_5":14148,"_27027":120547,"_2882":120610},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3396":70961,"_29729":70931,"_20626":120612,"_5":14148,"_27027":120547,"_2882":120613},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3396":70962,"_29729":70931,"_20626":120615,"_5":14148,"_27027":120547,"_2882":120616},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3396":70963,"_29729":70931,"_20626":120618,"_5":14148,"_27027":120547,"_2882":120619},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3396":70964,"_29729":70931,"_20626":120621,"_5":14148,"_27027":120547,"_2882":120622},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3396":70965,"_29729":70931,"_20626":120624,"_5":14148,"_27027":120547,"_2882":120625},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3396":70966,"_29729":70931,"_20626":120627,"_5":14148,"_27027":120551,"_2882":120628},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3396":70967,"_29729":70931,"_20626":120630,"_5":14148,"_27027":120555,"_2882":120631},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3396":70968,"_29729":70931,"_20626":120633,"_5":14148,"_27027":120555,"_2882":120634},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3396":70969,"_29729":70931,"_20626":120636,"_5":14148,"_27027":120555,"_2882":120637},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3396":70970,"_29729":70931,"_20626":120639,"_5":14148,"_27027":120555,"_2882":120640},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3396":70971,"_29729":70931,"_20626":120642,"_5":14148,"_27027":120555,"_2882":120643},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3396":70972,"_29729":70931,"_20626":120645,"_5":14148,"_27027":120555,"_2882":120646},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3396":70973,"_29729":70931,"_20626":120648,"_5":14148,"_27027":120555,"_2882":120649},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3396":70974,"_29729":70974,"_5":14500,"_2882":120651,"_30082":120652,"_20626":120653,"_27027":70974},"Listas de revocación (CRL)",[48429,115610,53899,120122],[],{"_3396":70975,"_29729":70974,"_20626":120655,"_5":14148,"_27027":70974,"_2882":120656},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3396":70976,"_29729":70974,"_5":30079,"_20626":120658,"_27027":120659,"_2882":120660},[],"/docs/pr-preview/pr-57/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3396":70977,"_29729":70974,"_5":30079,"_20626":120662,"_27027":120663,"_2882":120664},[],"/docs/pr-preview/pr-57/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3396":70978,"_29729":70974,"_5":30079,"_20626":120666,"_27027":120667,"_2882":120668},[],"/docs/pr-preview/pr-57/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3396":70979,"_29729":70974,"_5":30079,"_20626":120670,"_27027":120671,"_2882":120672},[],"/docs/pr-preview/pr-57/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3396":70980,"_29729":70974,"_5":30079,"_20626":120674,"_27027":120675,"_2882":120676},[],"/docs/pr-preview/pr-57/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3396":70981,"_29729":70974,"_5":30079,"_20626":120678,"_27027":120679,"_2882":120680},[],"/docs/pr-preview/pr-57/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3396":70982,"_29729":70974,"_5":30079,"_20626":120682,"_27027":120683,"_2882":120684},[],"/docs/pr-preview/pr-57/es/platform/pki/crl#errores-frecuentes-del-rol-va","Errores frecuentes del rol VA",{"_3396":70983,"_29729":70974,"_5":30079,"_20626":120686,"_27027":120687,"_2882":120688},[],"/docs/pr-preview/pr-57/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3396":70984,"_29729":70974,"_5":30079,"_20626":120690,"_27027":120691,"_2882":120692},[],"/docs/pr-preview/pr-57/es/platform/pki/crl#referencias","Referencias",{"_3396":70985,"_29729":70974,"_20626":120694,"_5":14148,"_27027":70974,"_2882":120695},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3396":70986,"_29729":70974,"_20626":120697,"_5":14148,"_27027":120659,"_2882":120698},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3396":70987,"_29729":70974,"_20626":120700,"_5":14148,"_27027":120659,"_2882":120701},[],"Campo de `crl_options`",{"_3396":70988,"_29729":70974,"_20626":120703,"_5":14148,"_27027":120659,"_2882":117148},[],{"_3396":70989,"_29729":70974,"_20626":120705,"_5":14148,"_27027":120659,"_2882":120706},[],"Valor inicial del backend",{"_3396":70990,"_29729":70974,"_20626":120708,"_5":14148,"_27027":120659,"_2882":55127},[],{"_3396":70991,"_29729":70974,"_20626":120710,"_5":14148,"_27027":120659,"_2882":120711},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3396":70992,"_29729":70974,"_20626":120713,"_5":14148,"_27027":120659,"_2882":120714},[],"7 días.",{"_3396":70993,"_29729":70974,"_20626":120716,"_5":14148,"_27027":120659,"_2882":55136},[],{"_3396":70994,"_29729":70974,"_20626":120718,"_5":14148,"_27027":120659,"_2882":120719},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3396":70995,"_29729":70974,"_20626":120721,"_5":14148,"_27027":120659,"_2882":120722},[],"6 días y 23 horas.",{"_3396":70996,"_29729":70974,"_20626":120724,"_5":14148,"_27027":120659,"_2882":55145},[],{"_3396":70997,"_29729":70974,"_20626":120726,"_5":14148,"_27027":120659,"_2882":120727},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3396":70998,"_29729":70974,"_20626":120729,"_5":14148,"_27027":120659,"_2882":55151},[],{"_3396":70999,"_29729":70974,"_20626":120731,"_5":14148,"_27027":120659,"_2882":55154},[],{"_3396":71000,"_29729":70974,"_20626":120733,"_5":14148,"_27027":120659,"_2882":120734},[],"Número de serie del certificado existente que firma la CRL.",{"_3396":71001,"_29729":70974,"_20626":120736,"_5":14148,"_27027":120659,"_2882":120737},[],"Número de serie del certificado actual de la CA.",{"_3396":71002,"_29729":70974,"_20626":120739,"_5":14148,"_27027":120659,"_2882":120740},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3396":71003,"_29729":70974,"_20626":120742,"_5":14148,"_27027":120659,"_2882":120743},[],"Al reemitir una CA, si el firmante del rol es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras el rol lo use (la API lo rechaza con `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3396":71004,"_29729":70974,"_20626":120745,"_5":14148,"_27027":120659,"_2882":120746},[],"Al eliminar una CA, su rol VA se conserva y no puede borrarse por API. Si no queda ninguna otra CA con el mismo SKI, el rol puede consultarse pero cualquier `PUT` devuelve 404, y el trabajo de renovación registra un aviso en cada ciclo porque ya no encuentra la CA. La API no ofrece salida; solo se corrige editando la base de datos. Si queda otra CA con ese SKI, el rol sigue siendo editable (consulta CAs que comparten clave). Ajusta validez y firmante antes de eliminar la CA.",{"_3396":71005,"_29729":70974,"_20626":120748,"_5":14148,"_27027":120659,"_2882":120749},[],"Una CA cuyo certificado no tiene `cRLSign` no puede generar su CRL ni editar su rol (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y asígnalo como firmante con `PUT`. Tras reemitir una CA, comprueba el uso de clave del certificado nuevo: si carece de `cRLSign`, la VA conserva el firmante anterior y registra un aviso, de modo que las listas siguen firmándose con el certificado sustituido hasta que corrijas el uso.",{"_3396":71006,"_29729":70974,"_20626":120751,"_5":14148,"_27027":120659,"_2882":120752},[],"El `PUT` valida siempre el firmante, aunque la petición no lo cambie. Si el firmante guardado ya no es válido, no se puede modificar ningún campo del rol, ni siquiera la validez, hasta asignar uno válido.",{"_3396":71007,"_29729":70974,"_20626":120754,"_5":14148,"_27027":120659,"_2882":120755},[],"Compartir una clave entre CA puede impedir la validación de las CRL. Consulta CAs que comparten clave.",{"_3396":71008,"_29729":70974,"_20626":120757,"_5":14148,"_27027":120659,"_2882":120758},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3396":71009,"_29729":70974,"_20626":120760,"_5":14148,"_27027":120663,"_2882":120761},[],"La VA identifica cada CRL por el SKI de la CA, y el SKI se deriva de su clave. Dos CAs con la misma clave tienen el mismo SKI y comparten un único rol VA y una única CRL. Ocurre al crear una CA sobre una clave ya existente del KMS, o al importar una CA cuyo certificado declara un SKI en uso. Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. El rol lo crea la primera CA y las demás lo conservan.",{"_3396":71010,"_29729":70974,"_20626":120763,"_5":14148,"_27027":120663,"_2882":120764},[],"Los certificados de todas ellas apuntan a `/crl/{ski}`, pero la lista publicada tiene como emisor a la primera CA y solo incluye sus revocaciones. Un verificador compara el emisor de la CRL con el del certificado que valida (RFC 5280, §6.3.2) y rechaza la lista si no coinciden. Según su política, el certificado queda bloqueado (*hard-fail*) o se acepta aunque esté revocado (*soft-fail*). Las revocaciones de las CAs secundarias no aparecen en ninguna lista.",{"_3396":71011,"_29729":70974,"_20626":120766,"_5":14148,"_27027":120663,"_2882":120767},[],"Si la primera CA se elimina, la generación de CRL de la restante falla porque el firmante configurado ya no corresponde a una CA con ese nombre. Hasta que se actualice el firmante del rol a un certificado de la CA restante, se sigue sirviendo la última lista publicada hasta que venza (7 días por defecto).",{"_3396":71012,"_29729":70974,"_20626":120769,"_5":14148,"_27027":120663,"_2882":120770},[],"Antes de actualizar, revisa las CAs que comparten clave. Para detectar el problema, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos. Una CA importada con un SKI ya en uso no sustituye a la existente como emisora de la CRL, porque el emisor se resuelve a partir del firmante del rol. Sin embargo, sus propios certificados apuntan a esa misma URL y sus revocaciones no se publican. Hasta que Lamassu rechace estas importaciones, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión, así que tampoco reutilices claves entre CAs. Una CRL por CA y el rechazo de importaciones cuyo SKI colisiona con el de una CA existente están planteados en lamassuiot#834, y ninguno está implementado todavía.",{"_3396":71013,"_29729":70974,"_20626":120772,"_5":14148,"_27027":120667,"_2882":120773},[],"El trabajo programado de la VA revisa todos los roles en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3396":71014,"_29729":70974,"_20626":120775,"_5":14148,"_27027":120667,"_2882":120776},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3396":71015,"_29729":70974,"_20626":120778,"_5":14148,"_27027":120667,"_2882":120779},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3396":71016,"_29729":70974,"_20626":120781,"_5":14148,"_27027":120667,"_2882":120782},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3396":71017,"_29729":70974,"_20626":120784,"_5":14148,"_27027":120667,"_2882":120785},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3396":71018,"_29729":70974,"_20626":120787,"_5":14148,"_27027":120667,"_2882":120788},[],"Si la generación falla (por ejemplo, por un rol sin CA o un firmante inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ski>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3396":71019,"_29729":70974,"_20626":120790,"_5":14148,"_27027":120667,"_2882":120791},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene rol VA, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3396":71020,"_29729":70974,"_20626":120793,"_5":14148,"_27027":120667,"_2882":120794},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3396":71021,"_29729":70974,"_20626":120796,"_5":14148,"_27027":120671,"_2882":120797},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3396":71022,"_29729":70974,"_20626":120799,"_5":14148,"_27027":120671,"_2882":120800},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3396":71023,"_29729":70974,"_20626":120802,"_5":14148,"_27027":120675,"_2882":120803},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3396":71024,"_29729":70974,"_20626":120805,"_5":14148,"_27027":120675,"_2882":120806},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3396":71025,"_29729":70974,"_20626":120808,"_5":14148,"_27027":120675,"_2882":120809},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando el rol apunta a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3396":71026,"_29729":70974,"_20626":120811,"_5":14148,"_27027":120675,"_2882":120812},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3396":71027,"_29729":70974,"_20626":120814,"_5":14148,"_27027":120675,"_2882":120815},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3396":71028,"_29729":70974,"_20626":120817,"_5":14148,"_27027":120679,"_2882":120818},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3396":71029,"_29729":70974,"_20626":120820,"_5":14148,"_27027":120679,"_2882":117337},[],{"_3396":71030,"_29729":70974,"_20626":120822,"_5":14148,"_27027":120679,"_2882":120823},[],"Path relativo",{"_3396":71031,"_29729":70974,"_20626":120825,"_5":14148,"_27027":120679,"_2882":115370},[],{"_3396":71032,"_29729":70974,"_20626":120827,"_5":14148,"_27027":120679,"_2882":55251},[],{"_3396":71033,"_29729":70974,"_20626":120829,"_5":14148,"_27027":120679,"_2882":55254},[],{"_3396":71034,"_29729":70974,"_20626":120831,"_5":14148,"_27027":120679,"_2882":120832},[],"Consultar `crl_options` y `latest_crl`.",{"_3396":71035,"_29729":70974,"_20626":120834,"_5":14148,"_27027":120679,"_2882":55260},[],{"_3396":71036,"_29729":70974,"_20626":120836,"_5":14148,"_27027":120679,"_2882":55254},[],{"_3396":71037,"_29729":70974,"_20626":120838,"_5":14148,"_27027":120679,"_2882":120839},[],"Sustituir la configuración de CRL.",{"_3396":71038,"_29729":70974,"_20626":120841,"_5":14148,"_27027":120679,"_2882":120842},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3396":71039,"_29729":70974,"_20626":120844,"_5":14148,"_27027":120679,"_2882":120845},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3396":71040,"_29729":70974,"_20626":120847,"_5":14148,"_27027":120683,"_2882":120848},[],"Síntoma",{"_3396":71041,"_29729":70974,"_20626":120850,"_5":14148,"_27027":120683,"_2882":120851},[],"Causa",{"_3396":71042,"_29729":70974,"_20626":120853,"_5":14148,"_27027":120683,"_2882":120854},[],"Acción",{"_3396":71043,"_29729":70974,"_20626":120856,"_5":14148,"_27027":120683,"_2882":120857},[],"`PUT /v1/roles/{ca-ski}` devuelve 404 y `GET` devuelve 200.",{"_3396":71044,"_29729":70974,"_20626":120859,"_5":14148,"_27027":120683,"_2882":120860},[],"Se eliminó la CA del rol y no queda otra con el mismo SKI.",{"_3396":71045,"_29729":70974,"_20626":120862,"_5":14148,"_27027":120683,"_2882":120863},[],"No hay salida por API; requiere intervención en la base de datos. Evítalo ajustando el rol antes de eliminar la CA.",{"_3396":71046,"_29729":70974,"_20626":120865,"_5":14148,"_27027":120683,"_2882":120866},[],"`PUT` devuelve 400.",{"_3396":71047,"_29729":70974,"_20626":120868,"_5":14148,"_27027":120683,"_2882":120869},[],"El firmante no tiene `cRLSign`, o su sujeto y su clave no coinciden con ninguna CA de ese SKI (por ejemplo, tras eliminar la primera de dos CAs que comparten clave).",{"_3396":71048,"_29729":70974,"_20626":120871,"_5":14148,"_27027":120683,"_2882":120872},[],"Asigna con `PUT` el número de serie de un certificado válido de la CA restante.",{"_3396":71049,"_29729":70974,"_20626":120874,"_5":14148,"_27027":120683,"_2882":120875},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3396":71050,"_29729":70974,"_20626":120877,"_5":14148,"_27027":120683,"_2882":120878},[],"`crl_options.subject_key_id_signer` se sustituyó por `signer_certificate_serial_number`, que es obligatorio.",{"_3396":71051,"_29729":70974,"_20626":120880,"_5":14148,"_27027":120683,"_2882":120881},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3396":71052,"_29729":70974,"_20626":120883,"_5":14148,"_27027":120683,"_2882":120884},[],"La CRL no cambia tras revocar un certificado.",{"_3396":71053,"_29729":70974,"_20626":120886,"_5":14148,"_27027":120683,"_2882":120887},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene rol VA, o la generación falló por un firmante inválido.",{"_3396":71054,"_29729":70974,"_20626":120889,"_5":14148,"_27027":120683,"_2882":120890},[],"Revisa los logs de la VA. La falta de rol solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3396":71055,"_29729":70974,"_20626":120892,"_5":14148,"_27027":120683,"_2882":120893},[],"Un verificador rechaza la CRL por el emisor.",{"_3396":71056,"_29729":70974,"_20626":120895,"_5":14148,"_27027":120683,"_2882":120896},[],"Varias CAs comparten SKI.",{"_3396":71057,"_29729":70974,"_20626":120898,"_5":14148,"_27027":120683,"_2882":120899},[],"Consulta CAs que comparten clave.",{"_3396":71058,"_29729":70974,"_20626":120901,"_5":14148,"_27027":120687,"_2882":120902},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Los ajustes VA de la CA también permiten seleccionar el firmante de la CRL: el selector de certificados solo ofrece certificados que tienen clave privada y el uso de clave `cRLSign`. Si el certificado de un firmante configurado no puede resolverse, la interfaz muestra `Unknown Certificate (Serial: X)` o `Certificate details unavailable (Serial: X)`. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3396":71059,"_29729":70974,"_20626":120904,"_5":14148,"_27027":120691,"_2882":120905},[],"RFC 5280: perfil X.509 y CRL.",{"_3396":71060,"_29729":70974,"_20626":120907,"_5":14148,"_27027":120691,"_2882":55334},[],{"_3396":71061,"_29729":70974,"_20626":120909,"_5":14148,"_27027":120691,"_2882":55337},[],{"_3396":71062,"_29729":70974,"_20626":120911,"_5":14148,"_27027":120691,"_2882":120912},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3396":71063,"_29729":70974,"_20626":120914,"_5":14148,"_27027":120691,"_2882":120915},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3396":71064,"_29729":71064,"_5":14500,"_2882":120917,"_30082":120918,"_20626":120919,"_27027":71064},"Claves y motores criptográficos",[48429,115610,53899,119485],[],{"_3396":71065,"_29729":71064,"_20626":120921,"_5":14148,"_27027":71064,"_2882":120922},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3396":71066,"_29729":71064,"_5":30079,"_20626":120924,"_27027":120925,"_2882":120926},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3396":71067,"_29729":71064,"_5":30079,"_20626":120928,"_27027":120929,"_2882":120930},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3396":71068,"_29729":71064,"_5":30079,"_20626":120932,"_27027":120933,"_2882":55362},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#file-system",{"_3396":71069,"_29729":71064,"_5":30079,"_20626":120935,"_27027":120936,"_2882":55366},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#hashicorp-vault",{"_3396":71070,"_29729":71064,"_5":30079,"_20626":120938,"_27027":120939,"_2882":55370},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#aws-secrets-manager",{"_3396":71071,"_29729":71064,"_5":30079,"_20626":120941,"_27027":120942,"_2882":55374},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#aws-kms",{"_3396":71072,"_29729":71064,"_5":30079,"_20626":120944,"_27027":120945,"_2882":55378},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#pkcs11",{"_3396":71073,"_29729":71064,"_5":30079,"_20626":120947,"_27027":120948,"_2882":55382},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#azure-key-vault",{"_3396":71074,"_29729":71064,"_5":30079,"_20626":120950,"_27027":120951,"_2882":120952},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3396":71075,"_29729":71064,"_5":30079,"_20626":120954,"_27027":120955,"_2882":120956},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3396":71076,"_29729":71064,"_5":30079,"_20626":120958,"_27027":120959,"_2882":120960},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3396":71077,"_29729":71064,"_5":30079,"_20626":120962,"_27027":120963,"_2882":120964},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3396":71078,"_29729":71064,"_5":30079,"_20626":120966,"_27027":120967,"_2882":120968},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3396":71079,"_29729":71064,"_5":30079,"_20626":120970,"_27027":120971,"_2882":120972},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3396":71080,"_29729":71064,"_5":30079,"_20626":120974,"_27027":120975,"_2882":120976},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3396":71081,"_29729":71064,"_5":30079,"_20626":120978,"_27027":120979,"_2882":55414},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#sign",{"_3396":71082,"_29729":71064,"_5":30079,"_20626":120981,"_27027":120982,"_2882":55418},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#verify",{"_3396":71083,"_29729":71064,"_5":30079,"_20626":120984,"_27027":120985,"_2882":120986},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3396":71084,"_29729":71064,"_5":30079,"_20626":120988,"_27027":120989,"_2882":120990},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3396":71085,"_29729":71064,"_5":30079,"_20626":120992,"_27027":120993,"_2882":120994},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3396":71086,"_29729":71064,"_20626":120996,"_5":14148,"_27027":71064,"_2882":120997},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3396":71087,"_29729":71064,"_20626":120999,"_5":14148,"_27027":71064,"_2882":121000},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3396":71088,"_29729":71064,"_20626":121002,"_5":14148,"_27027":120925,"_2882":121003},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3396":71089,"_29729":71064,"_20626":121005,"_5":14148,"_27027":120925,"_2882":121006},[],"En la práctica, permite:",{"_3396":71090,"_29729":71064,"_20626":121008,"_5":14148,"_27027":120925,"_2882":121009},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3396":71091,"_29729":71064,"_20626":121011,"_5":14148,"_27027":120925,"_2882":121012},[],"Importar claves creadas externamente.",{"_3396":71092,"_29729":71064,"_20626":121014,"_5":14148,"_27027":120925,"_2882":121015},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3396":71093,"_29729":71064,"_20626":121017,"_5":14148,"_27027":120925,"_2882":121018},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3396":71094,"_29729":71064,"_20626":121020,"_5":14148,"_27027":120929,"_2882":121021},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3396":71095,"_29729":71064,"_20626":121023,"_5":14148,"_27027":120929,"_2882":121024},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3396":71096,"_29729":71064,"_20626":121026,"_5":14148,"_27027":120929,"_2882":121027},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3396":71097,"_29729":71064,"_20626":121029,"_5":14148,"_27027":120933,"_2882":121030},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3396":71098,"_29729":71064,"_20626":121032,"_5":14148,"_27027":120936,"_2882":121033},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3396":71099,"_29729":71064,"_20626":121035,"_5":14148,"_27027":120936,"_2882":121036},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3396":71100,"_29729":71064,"_20626":121038,"_5":14148,"_27027":120939,"_2882":121039},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3396":71101,"_29729":71064,"_20626":121041,"_5":14148,"_27027":120942,"_2882":121042},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3396":71102,"_29729":71064,"_20626":121044,"_5":14148,"_27027":120945,"_2882":121045},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3396":71103,"_29729":71064,"_20626":121047,"_5":14148,"_27027":120948,"_2882":121048},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3396":71104,"_29729":71064,"_20626":121050,"_5":14148,"_27027":120948,"_2882":121051},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3396":71105,"_29729":71064,"_20626":121053,"_5":14148,"_27027":120948,"_2882":121054},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3396":71106,"_29729":71064,"_20626":121056,"_5":14148,"_27027":120948,"_2882":121057},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3396":71107,"_29729":71064,"_20626":121059,"_5":14148,"_27027":120951,"_2882":121060},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3396":71108,"_29729":71064,"_20626":121062,"_5":14148,"_27027":120951,"_2882":121063},[],"La tabla incluye los siguientes campos:",{"_3396":71109,"_29729":71064,"_20626":121065,"_5":14148,"_27027":120951,"_2882":121066},[],"**Name**: nombre descriptivo de la clave.",{"_3396":71110,"_29729":71064,"_20626":121068,"_5":14148,"_27027":120951,"_2882":121069},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3396":71111,"_29729":71064,"_20626":121071,"_5":14148,"_27027":120951,"_2882":121072},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3396":71112,"_29729":71064,"_20626":121074,"_5":14148,"_27027":120951,"_2882":121075},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3396":71113,"_29729":71064,"_20626":121077,"_5":14148,"_27027":120951,"_2882":121078},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3396":71114,"_29729":71064,"_20626":121080,"_5":14148,"_27027":120951,"_2882":121081},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3396":71115,"_29729":71064,"_20626":121083,"_5":14148,"_27027":120951,"_2882":121084},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3396":71116,"_29729":71064,"_20626":121086,"_5":14148,"_27027":120951,"_2882":121087},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3396":71117,"_29729":71064,"_20626":121089,"_5":14148,"_27027":120951,"_2882":121090},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3396":71118,"_29729":71064,"_20626":121092,"_5":14148,"_27027":120951,"_2882":121093},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3396":71119,"_29729":71064,"_20626":121095,"_5":14148,"_27027":120951,"_2882":121096},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3396":71120,"_29729":71064,"_20626":121098,"_5":14148,"_27027":120951,"_2882":121099},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3396":71121,"_29729":71064,"_20626":121101,"_5":14148,"_27027":120951,"_2882":121102},[],"**Delete Key** para eliminar la clave del sistema.",{"_3396":71122,"_29729":71064,"_20626":121104,"_5":14148,"_27027":120955,"_2882":121105},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3396":71123,"_29729":71064,"_20626":121107,"_5":14148,"_27027":120959,"_2882":121108},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3396":71124,"_29729":71064,"_20626":121110,"_5":14148,"_27027":120959,"_2882":121111},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3396":71125,"_29729":71064,"_20626":121113,"_5":14148,"_27027":120959,"_2882":121114},[],"**Key Name**: nombre único y descriptivo.",{"_3396":71126,"_29729":71064,"_20626":121116,"_5":14148,"_27027":120959,"_2882":121117},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3396":71127,"_29729":71064,"_20626":121119,"_5":14148,"_27027":120959,"_2882":121120},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3396":71128,"_29729":71064,"_20626":121122,"_5":14148,"_27027":120959,"_2882":121123},[],"**Tags**: metadatos para clasificar la clave.",{"_3396":71129,"_29729":71064,"_20626":121125,"_5":14148,"_27027":120959,"_2882":121126},[],"**Metadata**: información adicional para usos avanzados.",{"_3396":71130,"_29729":71064,"_20626":121128,"_5":14148,"_27027":120963,"_2882":121129},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3396":71131,"_29729":71064,"_20626":121131,"_5":14148,"_27027":120963,"_2882":121132},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3396":71132,"_29729":71064,"_20626":121134,"_5":14148,"_27027":120963,"_2882":121135},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3396":71133,"_29729":71064,"_20626":121137,"_5":14148,"_27027":120963,"_2882":121138},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3396":71134,"_29729":71064,"_20626":121140,"_5":14148,"_27027":120963,"_2882":121141},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3396":71135,"_29729":71064,"_20626":121143,"_5":14148,"_27027":120963,"_2882":121144},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3396":71136,"_29729":71064,"_20626":121146,"_5":14148,"_27027":120963,"_2882":121147},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3396":71137,"_29729":71064,"_20626":121149,"_5":14148,"_27027":120963,"_2882":121150},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3396":71138,"_29729":71064,"_20626":121152,"_5":14148,"_27027":120963,"_2882":121153},[],"**Metadata**: información adicional opcional.",{"_3396":71139,"_29729":71064,"_20626":121155,"_5":14148,"_27027":120963,"_2882":121156},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3396":71140,"_29729":71064,"_20626":121158,"_5":14148,"_27027":120963,"_2882":121159},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3396":71141,"_29729":71064,"_20626":121161,"_5":14148,"_27027":120967,"_2882":121162},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3396":71142,"_29729":71064,"_20626":121164,"_5":14148,"_27027":120971,"_2882":121165},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3396":71143,"_29729":71064,"_20626":121167,"_5":14148,"_27027":120971,"_2882":121168},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3396":71144,"_29729":71064,"_20626":121170,"_5":14148,"_27027":120971,"_2882":121171},[],"**Key Name**: nombre descriptivo.",{"_3396":71145,"_29729":71064,"_20626":121173,"_5":14148,"_27027":120971,"_2882":121174},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3396":71146,"_29729":71064,"_20626":121176,"_5":14148,"_27027":120971,"_2882":121177},[],"**Tags**: etiquetas asociadas.",{"_3396":71147,"_29729":71064,"_20626":121179,"_5":14148,"_27027":120971,"_2882":121180},[],"**Aliases**: nombres alternativos.",{"_3396":71148,"_29729":71064,"_20626":121182,"_5":14148,"_27027":120971,"_2882":121183},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3396":71149,"_29729":71064,"_20626":121185,"_5":14148,"_27027":120971,"_2882":121186},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3396":71150,"_29729":71064,"_20626":121188,"_5":14148,"_27027":120971,"_2882":121189},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3396":71151,"_29729":71064,"_20626":121191,"_5":14148,"_27027":120971,"_2882":121192},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3396":71152,"_29729":71064,"_20626":121194,"_5":14148,"_27027":120975,"_2882":121195},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3396":71153,"_29729":71064,"_20626":121197,"_5":14148,"_27027":120975,"_2882":121198},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3396":71154,"_29729":71064,"_20626":121200,"_5":14148,"_27027":120975,"_2882":121201},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3396":71155,"_29729":71064,"_20626":121203,"_5":14148,"_27027":120979,"_2882":121204},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3396":71156,"_29729":71064,"_20626":121206,"_5":14148,"_27027":120979,"_2882":121207},[],"Campos principales:",{"_3396":71157,"_29729":71064,"_20626":121209,"_5":14148,"_27027":120979,"_2882":121210},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3396":71158,"_29729":71064,"_20626":121212,"_5":14148,"_27027":120979,"_2882":121213},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3396":71159,"_29729":71064,"_20626":121215,"_5":14148,"_27027":120979,"_2882":121216},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3396":71160,"_29729":71064,"_20626":121218,"_5":14148,"_27027":120979,"_2882":121219},[],"**Message**: contenido que se va a firmar.",{"_3396":71161,"_29729":71064,"_20626":121221,"_5":14148,"_27027":120979,"_2882":121222},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3396":71162,"_29729":71064,"_20626":121224,"_5":14148,"_27027":120982,"_2882":121225},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3396":71163,"_29729":71064,"_20626":121227,"_5":14148,"_27027":120982,"_2882":121207},[],{"_3396":71164,"_29729":71064,"_20626":121229,"_5":14148,"_27027":120982,"_2882":121230},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3396":71165,"_29729":71064,"_20626":121232,"_5":14148,"_27027":120982,"_2882":121233},[],"**Message Type**: `Raw` o `Digest`.",{"_3396":71166,"_29729":71064,"_20626":121235,"_5":14148,"_27027":120982,"_2882":121236},[],"**Payload Encoding**: codificación del mensaje.",{"_3396":71167,"_29729":71064,"_20626":121238,"_5":14148,"_27027":120982,"_2882":121239},[],"**Message**: mensaje original o hash.",{"_3396":71168,"_29729":71064,"_20626":121241,"_5":14148,"_27027":120982,"_2882":121242},[],"**Signature**: firma que se desea comprobar.",{"_3396":71169,"_29729":71064,"_20626":121244,"_5":14148,"_27027":120982,"_2882":121245},[],"**Result**: indicador del resultado de la validación.",{"_3396":71170,"_29729":71064,"_20626":121247,"_5":14148,"_27027":120985,"_2882":121248},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3396":71171,"_29729":71064,"_20626":121250,"_5":14148,"_27027":120985,"_2882":121251},[],"Este flujo es útil para:",{"_3396":71172,"_29729":71064,"_20626":121253,"_5":14148,"_27027":120985,"_2882":121254},[],"Solicitar certificados a una CA externa.",{"_3396":71173,"_29729":71064,"_20626":121256,"_5":14148,"_27027":120985,"_2882":121257},[],"Renovar una identidad manteniendo la misma clave.",{"_3396":71174,"_29729":71064,"_20626":121259,"_5":14148,"_27027":120985,"_2882":121260},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3396":71175,"_29729":71064,"_20626":121262,"_5":14148,"_27027":120985,"_2882":121263},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3396":71176,"_29729":71064,"_20626":121265,"_5":14148,"_27027":120985,"_2882":121266},[],"**Organization (O)**: organización o empresa.",{"_3396":71177,"_29729":71064,"_20626":121268,"_5":14148,"_27027":120985,"_2882":121269},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3396":71178,"_29729":71064,"_20626":121271,"_5":14148,"_27027":120985,"_2882":121272},[],"**Country (C)**: código de país de dos letras.",{"_3396":71179,"_29729":71064,"_20626":121274,"_5":14148,"_27027":120985,"_2882":121275},[],"**State / Province (ST)**: estado o provincia.",{"_3396":71180,"_29729":71064,"_20626":121277,"_5":14148,"_27027":120985,"_2882":121278},[],"**Locality (L)**: ciudad o localidad.",{"_3396":71181,"_29729":71064,"_20626":121280,"_5":14148,"_27027":120985,"_2882":121281},[],"**Email Address**: correo de contacto.",{"_3396":71182,"_29729":71064,"_20626":121283,"_5":14148,"_27027":120985,"_2882":121284},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3396":71183,"_29729":71064,"_20626":121286,"_5":14148,"_27027":120985,"_2882":121287},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3396":71184,"_29729":71064,"_20626":121289,"_5":14148,"_27027":120989,"_2882":121290},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3396":71185,"_29729":71064,"_20626":121292,"_5":14148,"_27027":120989,"_2882":121293},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3396":71186,"_29729":71064,"_20626":121295,"_5":14148,"_27027":120993,"_2882":121296},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3396":71187,"_29729":71064,"_20626":121298,"_5":14148,"_27027":120993,"_2882":121299},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Ninguna operación libera una referencia por sí sola. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3396":71188,"_29729":71188,"_5":14500,"_2882":121301,"_30082":121302,"_20626":121303,"_27027":71188},"Validación online con OCSP",[48429,115610,53899,120122],[],{"_3396":71189,"_29729":71188,"_20626":121305,"_5":14148,"_27027":71188,"_2882":121306},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3396":71190,"_29729":71188,"_5":30079,"_20626":121308,"_27027":121309,"_2882":121310},[],"/docs/pr-preview/pr-57/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3396":71191,"_29729":71188,"_5":30079,"_20626":121312,"_27027":121313,"_2882":121314},[],"/docs/pr-preview/pr-57/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3396":71192,"_29729":71188,"_5":30079,"_20626":121316,"_27027":121317,"_2882":121318},[],"/docs/pr-preview/pr-57/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3396":71193,"_29729":71188,"_5":30079,"_20626":121320,"_27027":121321,"_2882":121322},[],"/docs/pr-preview/pr-57/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3396":71194,"_29729":71188,"_5":30079,"_20626":121324,"_27027":121325,"_2882":121326},[],"/docs/pr-preview/pr-57/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3396":71195,"_29729":71188,"_5":30079,"_20626":121328,"_27027":121329,"_2882":120692},[],"/docs/pr-preview/pr-57/es/platform/pki/ocsp#referencias",{"_3396":71196,"_29729":71188,"_20626":121331,"_5":14148,"_27027":71188,"_2882":121332},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3396":71197,"_29729":71188,"_20626":121334,"_5":14148,"_27027":121309,"_2882":121335},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3396":71198,"_29729":71188,"_20626":121337,"_5":14148,"_27027":121309,"_2882":121338},[],"Estado del registro",{"_3396":71199,"_29729":71188,"_20626":121340,"_5":14148,"_27027":121309,"_2882":121341},[],"Respuesta firmada",{"_3396":71200,"_29729":71188,"_20626":121343,"_5":14148,"_27027":121309,"_2882":53036},[],{"_3396":71201,"_29729":71188,"_20626":121345,"_5":14148,"_27027":121309,"_2882":55782},[],{"_3396":71202,"_29729":71188,"_20626":121347,"_5":14148,"_27027":121309,"_2882":53053},[],{"_3396":71203,"_29729":71188,"_20626":121349,"_5":14148,"_27027":121309,"_2882":121350},[],"`Revoked`, con razón y fecha de revocación.",{"_3396":71204,"_29729":71188,"_20626":121352,"_5":14148,"_27027":121309,"_2882":121353},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3396":71205,"_29729":71188,"_20626":121355,"_5":14148,"_27027":121309,"_2882":121356},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3396":71206,"_29729":71188,"_20626":121358,"_5":14148,"_27027":121309,"_2882":121359},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3396":71207,"_29729":71188,"_20626":121361,"_5":14148,"_27027":121309,"_2882":121362},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3396":71208,"_29729":71188,"_20626":121364,"_5":14148,"_27027":121309,"_2882":121365},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3396":71209,"_29729":71188,"_20626":121367,"_5":14148,"_27027":121313,"_2882":121368},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3396":71210,"_29729":71188,"_20626":121370,"_5":14148,"_27027":121313,"_2882":121371},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3396":71211,"_29729":71188,"_20626":121373,"_5":14148,"_27027":121317,"_2882":121374},[],"El servicio acepta:",{"_3396":71212,"_29729":71188,"_20626":121376,"_5":14148,"_27027":121317,"_2882":117337},[],{"_3396":71213,"_29729":71188,"_20626":121378,"_5":14148,"_27027":121317,"_2882":121379},[],"Ruta del servicio VA",{"_3396":71214,"_29729":71188,"_20626":121381,"_5":14148,"_27027":121317,"_2882":121382},[],"Formato",{"_3396":71215,"_29729":71188,"_20626":121384,"_5":14148,"_27027":121317,"_2882":55822},[],{"_3396":71216,"_29729":71188,"_20626":121386,"_5":14148,"_27027":121317,"_2882":55825},[],{"_3396":71217,"_29729":71188,"_20626":121388,"_5":14148,"_27027":121317,"_2882":121389},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3396":71218,"_29729":71188,"_20626":121391,"_5":14148,"_27027":121317,"_2882":55251},[],{"_3396":71219,"_29729":71188,"_20626":121393,"_5":14148,"_27027":121317,"_2882":55833},[],{"_3396":71220,"_29729":71188,"_20626":121395,"_5":14148,"_27027":121317,"_2882":121396},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3396":71221,"_29729":71188,"_20626":121398,"_5":14148,"_27027":121317,"_2882":121399},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3396":71222,"_29729":71188,"_20626":121401,"_5":14148,"_27027":121321,"_2882":121402},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3396":71223,"_29729":71188,"_20626":121404,"_5":14148,"_27027":121321,"_2882":121405},[],"Genera la solicitud:",{"_3396":71224,"_29729":71188,"_20626":121407,"_5":14148,"_27027":121321,"_2882":121408},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3396":71225,"_29729":71188,"_20626":121410,"_5":14148,"_27027":121321,"_2882":121411},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3396":71226,"_29729":71188,"_20626":121413,"_5":14148,"_27027":121321,"_2882":121414},[],"Verifica el DER recibido:",{"_3396":71227,"_29729":71188,"_20626":121416,"_5":14148,"_27027":121321,"_2882":121417},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3396":71228,"_29729":71188,"_20626":121419,"_5":14148,"_27027":121325,"_2882":121420},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3396":71229,"_29729":71188,"_20626":121422,"_5":14148,"_27027":121325,"_2882":121423},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3396":71230,"_29729":71188,"_20626":121425,"_5":14148,"_27027":121329,"_2882":55866},[],{"_3396":71231,"_29729":71188,"_20626":121427,"_5":14148,"_27027":121329,"_2882":55869},[],{"_3396":71232,"_29729":71188,"_20626":121429,"_5":14148,"_27027":121329,"_2882":121430},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3396":71233,"_29729":71188,"_20626":121432,"_5":14148,"_27027":121329,"_2882":120915},[],{"_3396":71234,"_29729":71234,"_5":14500,"_2882":53899,"_30082":121434,"_20626":121435,"_27027":71234},[48429,115610,53899],[],{"_3396":71235,"_29729":71234,"_20626":121437,"_5":14148,"_27027":71234,"_2882":121438},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3396":71236,"_29729":71234,"_5":30079,"_20626":121440,"_27027":121441,"_2882":118811},[],"/docs/pr-preview/pr-57/es/platform/pki/overview#empieza-aquí",{"_3396":71237,"_29729":71234,"_5":30079,"_20626":121443,"_27027":121444,"_2882":121445},[],"/docs/pr-preview/pr-57/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3396":71238,"_29729":71234,"_5":30079,"_20626":121447,"_27027":121448,"_2882":119331},[],"/docs/pr-preview/pr-57/es/platform/pki/overview#capacidades-principales",{"_3396":71239,"_29729":71234,"_5":30079,"_20626":121450,"_27027":121451,"_2882":119335},[],"/docs/pr-preview/pr-57/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3396":71240,"_29729":71234,"_5":30079,"_20626":121453,"_27027":121454,"_2882":119339},[],"/docs/pr-preview/pr-57/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3396":71241,"_29729":71234,"_5":30079,"_20626":121456,"_27027":121457,"_2882":119343},[],"/docs/pr-preview/pr-57/es/platform/pki/overview#emite-y-controla-certificados",{"_3396":71242,"_29729":71234,"_5":30079,"_20626":121459,"_27027":121460,"_2882":119351},[],"/docs/pr-preview/pr-57/es/platform/pki/overview#publica-el-estado-de-validación",{"_3396":71243,"_29729":71234,"_5":30079,"_20626":121462,"_27027":121463,"_2882":121464},[],"/docs/pr-preview/pr-57/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3396":71244,"_29729":71234,"_5":30079,"_20626":121466,"_27027":121467,"_2882":120288},[],"/docs/pr-preview/pr-57/es/platform/pki/overview#continúa",{"_3396":71245,"_29729":71234,"_20626":121469,"_5":14148,"_27027":71234,"_2882":121470},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3396":71246,"_29729":71234,"_20626":121472,"_5":14148,"_27027":121441,"_2882":121473},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3396":71247,"_29729":71234,"_20626":121475,"_5":14148,"_27027":121441,"_2882":121476},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3396":71248,"_29729":71234,"_20626":121478,"_5":14148,"_27027":121444,"_2882":121479},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3396":71249,"_29729":71234,"_20626":121481,"_5":14148,"_27027":121444,"_2882":121482},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3396":71250,"_29729":71234,"_20626":121484,"_5":14148,"_27027":121444,"_2882":121485},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3396":71251,"_29729":71234,"_20626":121487,"_5":14148,"_27027":121444,"_2882":121488},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3396":71252,"_29729":71234,"_20626":121490,"_5":14148,"_27027":121444,"_2882":121491},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3396":71253,"_29729":71234,"_20626":121493,"_5":14148,"_27027":121451,"_2882":121494},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3396":71254,"_29729":71234,"_20626":121496,"_5":14148,"_27027":121454,"_2882":121497},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3396":71255,"_29729":71234,"_20626":121499,"_5":14148,"_27027":121457,"_2882":121500},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3396":71256,"_29729":71234,"_20626":121502,"_5":14148,"_27027":121460,"_2882":121503},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3396":71257,"_29729":71234,"_20626":121505,"_5":14148,"_27027":121463,"_2882":121506},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3396":71258,"_29729":71234,"_20626":121508,"_5":14148,"_27027":121463,"_2882":121509},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3396":71259,"_29729":71234,"_20626":121511,"_5":14148,"_27027":121463,"_2882":121512},[],"su clave pública corresponda a la clave privada del cliente;",{"_3396":71260,"_29729":71234,"_20626":121514,"_5":14148,"_27027":121463,"_2882":121515},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3396":71261,"_29729":71234,"_20626":121517,"_5":14148,"_27027":121463,"_2882":121518},[],"sus fechas y usos permitan la operación;",{"_3396":71262,"_29729":71234,"_20626":121520,"_5":14148,"_27027":121463,"_2882":121521},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3396":71263,"_29729":71234,"_20626":121523,"_5":14148,"_27027":121463,"_2882":121524},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3396":71264,"_29729":71234,"_20626":121526,"_5":14148,"_27027":121467,"_2882":121527},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3396":71265,"_29729":71234,"_20626":121529,"_5":14148,"_27027":121467,"_2882":121530},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3396":71266,"_29729":71234,"_20626":121532,"_5":14148,"_27027":121467,"_2882":121533},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3396":71267,"_29729":71267,"_5":14500,"_2882":121535,"_30082":121536,"_20626":121537,"_27027":71267},"Crea tu primera CA",[48429,115610,53899,118935],[],{"_3396":71268,"_29729":71267,"_20626":121539,"_5":14148,"_27027":71267,"_2882":121540},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3396":71269,"_29729":71267,"_5":30079,"_20626":121542,"_27027":121543,"_2882":114188},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3396":71270,"_29729":71267,"_5":30079,"_20626":121545,"_27027":121546,"_2882":121547},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3396":71271,"_29729":71267,"_5":30079,"_20626":121549,"_27027":121550,"_2882":121551},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3396":71272,"_29729":71267,"_5":30079,"_20626":121553,"_27027":121554,"_2882":121555},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3396":71273,"_29729":71267,"_5":30079,"_20626":121557,"_27027":121558,"_2882":121559},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3396":71274,"_29729":71267,"_5":30079,"_20626":121561,"_27027":121562,"_2882":121563},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3396":71275,"_29729":71267,"_5":30079,"_20626":121565,"_27027":121566,"_2882":121567},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3396":71276,"_29729":71267,"_5":30079,"_20626":121569,"_27027":121570,"_2882":119182},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3396":71277,"_29729":71267,"_5":30079,"_20626":121572,"_27027":121573,"_2882":114212},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3396":71278,"_29729":71267,"_20626":121575,"_5":14148,"_27027":71267,"_2882":121576},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3396":71279,"_29729":71267,"_20626":121578,"_5":14148,"_27027":121543,"_2882":121579},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3396":71280,"_29729":71267,"_20626":121581,"_5":14148,"_27027":121543,"_2882":121582},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3396":71281,"_29729":71267,"_20626":121584,"_5":14148,"_27027":121543,"_2882":121585},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3396":71282,"_29729":71267,"_20626":121587,"_5":14148,"_27027":121543,"_2882":121588},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3396":71283,"_29729":71267,"_20626":121590,"_5":14148,"_27027":121546,"_2882":121591},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3396":71284,"_29729":71267,"_20626":121593,"_5":14148,"_27027":121546,"_2882":121594},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3396":71285,"_29729":71267,"_20626":121596,"_5":14148,"_27027":121550,"_2882":121597},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3396":71286,"_29729":71267,"_20626":121599,"_5":14148,"_27027":121550,"_2882":121600},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3396":71287,"_29729":71267,"_20626":121602,"_5":14148,"_27027":121554,"_2882":121603},[],"Selecciona **Root CA** y completa:",{"_3396":71288,"_29729":71267,"_20626":121605,"_5":14148,"_27027":121554,"_2882":56048},[],{"_3396":71289,"_29729":71267,"_20626":121607,"_5":14148,"_27027":121554,"_2882":121608},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3396":71290,"_29729":71267,"_20626":121610,"_5":14148,"_27027":121554,"_2882":121611},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3396":71291,"_29729":71267,"_20626":121613,"_5":14148,"_27027":121554,"_2882":121614},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3396":71292,"_29729":71267,"_20626":121616,"_5":14148,"_27027":121554,"_2882":121617},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3396":71293,"_29729":71267,"_20626":121619,"_5":14148,"_27027":121558,"_2882":121620},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3396":71294,"_29729":71267,"_20626":121622,"_5":14148,"_27027":121562,"_2882":121623},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3396":71295,"_29729":71267,"_20626":121625,"_5":14148,"_27027":121562,"_2882":121626},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3396":71296,"_29729":71267,"_20626":121628,"_5":14148,"_27027":121566,"_2882":121629},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3396":71297,"_29729":71267,"_20626":121631,"_5":14148,"_27027":121566,"_2882":121632},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3396":71298,"_29729":71267,"_20626":121634,"_5":14148,"_27027":121566,"_2882":121635},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3396":71299,"_29729":71267,"_20626":121637,"_5":14148,"_27027":121570,"_2882":121638},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3396":71300,"_29729":71267,"_20626":121640,"_5":14148,"_27027":121570,"_2882":121641},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3396":71301,"_29729":71267,"_20626":121643,"_5":14148,"_27027":121570,"_2882":121644},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3396":71302,"_29729":71267,"_20626":121646,"_5":14148,"_27027":121570,"_2882":121647},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3396":71303,"_29729":71267,"_20626":121649,"_5":14148,"_27027":121573,"_2882":121650},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3396":71304,"_29729":71304,"_5":14500,"_2882":121652,"_30082":121653,"_20626":121654,"_27027":71304},"Emite y verifica un certificado",[48429,115610,53899,118935],[],{"_3396":71305,"_29729":71304,"_20626":121656,"_5":14148,"_27027":71304,"_2882":121657},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3396":71306,"_29729":71304,"_5":30079,"_20626":121659,"_27027":121660,"_2882":114188},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3396":71307,"_29729":71304,"_5":30079,"_20626":121662,"_27027":121663,"_2882":121664},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3396":71308,"_29729":71304,"_5":30079,"_20626":121666,"_27027":121667,"_2882":121668},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3396":71309,"_29729":71304,"_5":30079,"_20626":121670,"_27027":121671,"_2882":121672},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3396":71310,"_29729":71304,"_5":30079,"_20626":121674,"_27027":121675,"_2882":121676},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3396":71311,"_29729":71304,"_5":30079,"_20626":121678,"_27027":121679,"_2882":121680},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3396":71312,"_29729":71304,"_5":30079,"_20626":121682,"_27027":121683,"_2882":121684},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3396":71313,"_29729":71304,"_5":30079,"_20626":121686,"_27027":121687,"_2882":121688},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3396":71314,"_29729":71304,"_5":30079,"_20626":121690,"_27027":121691,"_2882":121692},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3396":71315,"_29729":71304,"_5":30079,"_20626":121694,"_27027":121695,"_2882":121696},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3396":71316,"_29729":71304,"_5":30079,"_20626":121698,"_27027":121699,"_2882":119182},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3396":71317,"_29729":71304,"_5":30079,"_20626":121701,"_27027":121702,"_2882":114212},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3396":71318,"_29729":71304,"_20626":121704,"_5":14148,"_27027":71304,"_2882":121705},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3396":71319,"_29729":71304,"_20626":121707,"_5":14148,"_27027":121660,"_2882":121708},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3396":71320,"_29729":71304,"_20626":121710,"_5":14148,"_27027":121660,"_2882":121711},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3396":71321,"_29729":71304,"_20626":121713,"_5":14148,"_27027":121660,"_2882":121714},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3396":71322,"_29729":71304,"_20626":121716,"_5":14148,"_27027":121660,"_2882":121717},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3396":71323,"_29729":71304,"_20626":121719,"_5":14148,"_27027":121660,"_2882":121720},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3396":71324,"_29729":71304,"_20626":121722,"_5":14148,"_27027":121663,"_2882":121723},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3396":71325,"_29729":71304,"_20626":121725,"_5":14148,"_27027":121667,"_2882":121726},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3396":71326,"_29729":71304,"_20626":121728,"_5":14148,"_27027":121667,"_2882":121729},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3396":71327,"_29729":71304,"_20626":121731,"_5":14148,"_27027":121671,"_2882":121732},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3396":71328,"_29729":71304,"_20626":121734,"_5":14148,"_27027":121671,"_2882":121735},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3396":71329,"_29729":71304,"_20626":121737,"_5":14148,"_27027":121675,"_2882":121738},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3396":71330,"_29729":71304,"_20626":121740,"_5":14148,"_27027":121675,"_2882":121741},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3396":71331,"_29729":71304,"_20626":121743,"_5":14148,"_27027":121679,"_2882":121744},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3396":71332,"_29729":71304,"_20626":121746,"_5":14148,"_27027":121683,"_2882":121747},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3396":71333,"_29729":71304,"_20626":121749,"_5":14148,"_27027":121687,"_2882":121750},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3396":71334,"_29729":71304,"_20626":121752,"_5":14148,"_27027":121691,"_2882":121753},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3396":71335,"_29729":71304,"_20626":121755,"_5":14148,"_27027":121691,"_2882":121756},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3396":71336,"_29729":71304,"_20626":121758,"_5":14148,"_27027":121691,"_2882":121759},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3396":71337,"_29729":71304,"_20626":121761,"_5":14148,"_27027":121695,"_2882":121762},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3396":71338,"_29729":71304,"_20626":121764,"_5":14148,"_27027":121695,"_2882":121765},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3396":71339,"_29729":71304,"_20626":121767,"_5":14148,"_27027":121695,"_2882":121768},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3396":71340,"_29729":71304,"_20626":121770,"_5":14148,"_27027":121699,"_2882":119265},[],{"_3396":71341,"_29729":71304,"_20626":121772,"_5":14148,"_27027":121699,"_2882":117786},[],{"_3396":71342,"_29729":71304,"_20626":121774,"_5":14148,"_27027":121699,"_2882":121775},[],"La CA rechaza la emisión",{"_3396":71343,"_29729":71304,"_20626":121777,"_5":14148,"_27027":121699,"_2882":121778},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3396":71344,"_29729":71304,"_20626":121780,"_5":14148,"_27027":121699,"_2882":121781},[],"Sujeto o usos diferentes",{"_3396":71345,"_29729":71304,"_20626":121783,"_5":14148,"_27027":121699,"_2882":121784},[],"Perfil aplicado y valores solicitados.",{"_3396":71346,"_29729":71304,"_20626":121786,"_5":14148,"_27027":121699,"_2882":121787},[],"No se encuentra el emisor",{"_3396":71347,"_29729":71304,"_20626":121789,"_5":14148,"_27027":121699,"_2882":121790},[],"CA descargada y cadena intermedia necesaria.",{"_3396":71348,"_29729":71304,"_20626":121792,"_5":14148,"_27027":121699,"_2882":121793},[],"Falla la vigencia",{"_3396":71349,"_29729":71304,"_20626":121795,"_5":14148,"_27027":121699,"_2882":121796},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3396":71350,"_29729":71304,"_20626":121798,"_5":14148,"_27027":121699,"_2882":121799},[],"Los resúmenes de clave difieren",{"_3396":71351,"_29729":71304,"_20626":121801,"_5":14148,"_27027":121699,"_2882":121802},[],"Archivos de certificado y clave de la misma emisión.",{"_3396":71352,"_29729":71304,"_20626":121804,"_5":14148,"_27027":121699,"_2882":121805},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3396":71353,"_29729":71304,"_20626":121807,"_5":14148,"_27027":121702,"_2882":121808},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3396":71354,"_29729":71304,"_20626":121810,"_5":14148,"_27027":121702,"_2882":121811},[],"Gestionar certificados para inspección, estado y revocación.",{"_3396":71355,"_29729":71304,"_20626":121813,"_5":14148,"_27027":121702,"_2882":121814},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3396":71356,"_29729":71304,"_20626":121816,"_5":14148,"_27027":121702,"_2882":121817},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3396":71357,"_29729":71304,"_20626":121819,"_5":14148,"_27027":121702,"_2882":121820},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3396":71358,"_29729":71358,"_5":14500,"_2882":121822,"_30082":121823,"_20626":121824,"_27027":71358},"Primeros pasos de PKI",[48429,115610,53899,118935],[],{"_3396":71359,"_29729":71358,"_20626":121826,"_5":14148,"_27027":71358,"_2882":121827},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3396":71360,"_29729":71358,"_5":30079,"_20626":121829,"_27027":121830,"_2882":114188},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3396":71361,"_29729":71358,"_5":30079,"_20626":121832,"_27027":121833,"_2882":121834},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3396":71362,"_29729":71358,"_5":30079,"_20626":121836,"_27027":121837,"_2882":119117},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3396":71363,"_29729":71358,"_5":30079,"_20626":121839,"_27027":121840,"_2882":121841},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3396":71364,"_29729":71358,"_20626":121843,"_5":14148,"_27027":71358,"_2882":121844},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3396":71365,"_29729":71358,"_20626":121846,"_5":14148,"_27027":121830,"_2882":121847},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3396":71366,"_29729":71358,"_20626":121849,"_5":14148,"_27027":121830,"_2882":121850},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3396":71367,"_29729":71358,"_20626":121852,"_5":14148,"_27027":121830,"_2882":121853},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3396":71368,"_29729":71358,"_20626":121855,"_5":14148,"_27027":121830,"_2882":121856},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3396":71369,"_29729":71358,"_20626":121858,"_5":14148,"_27027":121830,"_2882":121859},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3396":71370,"_29729":71358,"_20626":121861,"_5":14148,"_27027":121833,"_2882":121862},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3396":71371,"_29729":71358,"_20626":121864,"_5":14148,"_27027":121833,"_2882":121865},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3396":71372,"_29729":71358,"_20626":121867,"_5":14148,"_27027":121833,"_2882":121868},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3396":71373,"_29729":71358,"_20626":121870,"_5":14148,"_27027":121833,"_2882":121871},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3396":71374,"_29729":71358,"_20626":121873,"_5":14148,"_27027":121837,"_2882":121874},[],"Archivo o recurso",{"_3396":71375,"_29729":71358,"_20626":121876,"_5":14148,"_27027":121837,"_2882":119114},[],{"_3396":71376,"_29729":71358,"_20626":121878,"_5":14148,"_27027":121837,"_2882":121879},[],"CA raíz activa y `ca.pem`",{"_3396":71377,"_29729":71358,"_20626":121881,"_5":14148,"_27027":121837,"_2882":121882},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3396":71378,"_29729":71358,"_20626":121884,"_5":14148,"_27027":121837,"_2882":121885},[],"Certificado final y `device.crt`",{"_3396":71379,"_29729":71358,"_20626":121887,"_5":14148,"_27027":121837,"_2882":121888},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3396":71380,"_29729":71358,"_20626":121890,"_5":14148,"_27027":121837,"_2882":121891},[],"Clave privada `device.key`",{"_3396":71381,"_29729":71358,"_20626":121893,"_5":14148,"_27027":121837,"_2882":121894},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3396":71382,"_29729":71358,"_20626":121896,"_5":14148,"_27027":121837,"_2882":121897},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3396":71383,"_29729":71358,"_20626":121899,"_5":14148,"_27027":121840,"_2882":121900},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3396":71384,"_29729":71358,"_20626":121902,"_5":14148,"_27027":121840,"_2882":121903},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3396":71385,"_29729":71358,"_20626":121905,"_5":14148,"_27027":121840,"_2882":121906},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3396":71386,"_29729":71386,"_5":14500,"_2882":121908,"_30082":121909,"_20626":121911,"_27027":71386},"Resolución de problemas PKI",[48429,115610,53899,121910],"Resolución de problemas",[],{"_3396":71387,"_29729":71386,"_20626":121913,"_5":14148,"_27027":71386,"_2882":121914},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3396":71388,"_29729":71386,"_5":30079,"_20626":121916,"_27027":121917,"_2882":121918},[],"/docs/pr-preview/pr-57/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3396":71389,"_29729":71386,"_5":30079,"_20626":121920,"_27027":121921,"_2882":121922},[],"/docs/pr-preview/pr-57/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3396":71390,"_29729":71386,"_5":30079,"_20626":121924,"_27027":121925,"_2882":121926},[],"/docs/pr-preview/pr-57/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3396":71391,"_29729":71386,"_20626":121928,"_5":14148,"_27027":71386,"_2882":121929},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3396":71392,"_29729":71386,"_20626":121931,"_5":14148,"_27027":71386,"_2882":121932},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3396":71393,"_29729":71386,"_20626":121934,"_5":14148,"_27027":121917,"_2882":119114},[],{"_3396":71394,"_29729":71386,"_20626":121936,"_5":14148,"_27027":121917,"_2882":117786},[],{"_3396":71395,"_29729":71386,"_20626":121938,"_5":14148,"_27027":121917,"_2882":114212},[],{"_3396":71396,"_29729":71386,"_20626":121940,"_5":14148,"_27027":121917,"_2882":52741},[],{"_3396":71397,"_29729":71386,"_20626":121942,"_5":14148,"_27027":121917,"_2882":121943},[],"Existe, está activa y sus fechas son utilizables.",{"_3396":71398,"_29729":71386,"_20626":121945,"_5":14148,"_27027":121917,"_2882":121946},[],"Autoridades.",{"_3396":71399,"_29729":71386,"_20626":121948,"_5":14148,"_27027":121917,"_2882":121949},[],"Clave",{"_3396":71400,"_29729":71386,"_20626":121951,"_5":14148,"_27027":121917,"_2882":121952},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3396":71401,"_29729":71386,"_20626":121954,"_5":14148,"_27027":121917,"_2882":121955},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3396":71402,"_29729":71386,"_20626":121957,"_5":14148,"_27027":121917,"_2882":56402},[],{"_3396":71403,"_29729":71386,"_20626":121959,"_5":14148,"_27027":121917,"_2882":121960},[],"PEM correcto y firma verificable.",{"_3396":71404,"_29729":71386,"_20626":121962,"_5":14148,"_27027":121917,"_2882":56408},[],{"_3396":71405,"_29729":71386,"_20626":121964,"_5":14148,"_27027":121917,"_2882":121965},[],"Perfil",{"_3396":71406,"_29729":71386,"_20626":121967,"_5":14148,"_27027":121917,"_2882":121968},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3396":71407,"_29729":71386,"_20626":121970,"_5":14148,"_27027":121917,"_2882":121971},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3396":71408,"_29729":71386,"_20626":121973,"_5":14148,"_27027":121917,"_2882":119265},[],{"_3396":71409,"_29729":71386,"_20626":121975,"_5":14148,"_27027":121917,"_2882":121976},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3396":71410,"_29729":71386,"_20626":121978,"_5":14148,"_27027":121917,"_2882":121979},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3396":71411,"_29729":71386,"_20626":121981,"_5":14148,"_27027":121917,"_2882":121982},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3396":71412,"_29729":71386,"_20626":121984,"_5":14148,"_27027":121917,"_2882":121985},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3396":71413,"_29729":71386,"_20626":121987,"_5":14148,"_27027":121921,"_2882":121988},[],"Revisa cada frontera por separado:",{"_3396":71414,"_29729":71386,"_20626":121990,"_5":14148,"_27027":121921,"_2882":121991},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3396":71415,"_29729":71386,"_20626":121993,"_5":14148,"_27027":121921,"_2882":121994},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3396":71416,"_29729":71386,"_20626":121996,"_5":14148,"_27027":121921,"_2882":121997},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3396":71417,"_29729":71386,"_20626":121999,"_5":14148,"_27027":121921,"_2882":122000},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3396":71418,"_29729":71386,"_20626":122002,"_5":14148,"_27027":121921,"_2882":122003},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3396":71419,"_29729":71386,"_20626":122005,"_5":14148,"_27027":121921,"_2882":122006},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3396":71420,"_29729":71386,"_20626":122008,"_5":14148,"_27027":121925,"_2882":122009},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3396":71421,"_29729":71386,"_20626":122011,"_5":14148,"_27027":121925,"_2882":122012},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3396":71422,"_29729":71422,"_5":14500,"_2882":122014,"_30082":122015,"_20626":122016,"_27027":71422},"Seguridad",[48429],[],{"_3396":71423,"_29729":71422,"_20626":122018,"_5":14148,"_27027":71422,"_2882":122019},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3396":71424,"_29729":71422,"_5":30079,"_20626":122021,"_27027":122022,"_2882":122023},[],"/docs/pr-preview/pr-57/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3396":71425,"_29729":71422,"_5":30079,"_20626":122025,"_27027":122026,"_2882":122027},[],"/docs/pr-preview/pr-57/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3396":71426,"_29729":71422,"_5":30079,"_20626":122029,"_27027":122030,"_2882":122031},[],"/docs/pr-preview/pr-57/es/security#versiones-soportadas","Versiones soportadas",{"_3396":71427,"_29729":71422,"_5":30079,"_20626":122033,"_27027":122034,"_2882":122035},[],"/docs/pr-preview/pr-57/es/security#divulgación-responsable","Divulgación responsable",{"_3396":71428,"_29729":71422,"_20626":122037,"_5":14148,"_27027":71422,"_2882":122038},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3396":71429,"_29729":71422,"_20626":122040,"_5":14148,"_27027":122022,"_2882":122041},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3396":71430,"_29729":71422,"_20626":122043,"_5":14148,"_27027":122022,"_2882":122044},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3396":71431,"_29729":71422,"_20626":122046,"_5":14148,"_27027":122022,"_2882":14767},[],{"_3396":71432,"_29729":71422,"_20626":122048,"_5":14148,"_27027":122022,"_2882":14713},[],{"_3396":71433,"_29729":71422,"_20626":122050,"_5":14148,"_27027":122022,"_2882":14760},[],{"_3396":71434,"_29729":71422,"_20626":122052,"_5":14148,"_27027":122022,"_2882":122053},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3396":71435,"_29729":71422,"_20626":122055,"_5":14148,"_27027":122022,"_2882":122056},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3396":71436,"_29729":71422,"_20626":122058,"_5":14148,"_27027":122026,"_2882":122059},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3396":71437,"_29729":71422,"_20626":122061,"_5":14148,"_27027":122026,"_2882":122062},[],"No incluyas en el reporte:",{"_3396":71438,"_29729":71422,"_20626":122064,"_5":14148,"_27027":122026,"_2882":122065},[],"Credenciales, tokens o claves privadas",{"_3396":71439,"_29729":71422,"_20626":122067,"_5":14148,"_27027":122026,"_2882":122068},[],"Datos de clientes o información identificable de clientes",{"_3396":71440,"_29729":71422,"_20626":122070,"_5":14148,"_27027":122026,"_2882":122071},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3396":71441,"_29729":71422,"_20626":122073,"_5":14148,"_27027":122030,"_2882":122074},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3396":71442,"_29729":71422,"_20626":122076,"_5":14148,"_27027":122030,"_2882":122077},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3396":71443,"_29729":71422,"_20626":122079,"_5":14148,"_27027":122034,"_2882":122080},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3396":71444,"_29729":71422,"_20626":122082,"_5":14148,"_27027":122034,"_2882":122083},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3396":71445,"_29729":71422,"_20626":122085,"_5":14148,"_27027":122034,"_2882":122086},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3396":71446,"_29729":71422,"_20626":122088,"_5":14148,"_27027":122034,"_2882":122089},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3396":71447,"_29729":71422,"_20626":122091,"_5":14148,"_27027":122034,"_2882":122092},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3396":71448,"_29729":71448,"_5":14500,"_2882":122094,"_30082":122095,"_20626":122097,"_27027":71448},"3.8.0 a 4.0.0",[48429,122096],"Actualizaciones",[],{"_3396":71449,"_29729":71448,"_20626":122099,"_5":14148,"_27027":71448,"_2882":122100},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3396":71450,"_29729":71448,"_5":30079,"_20626":122102,"_27027":122103,"_2882":122104},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3396":71451,"_29729":71448,"_5":30079,"_20626":122106,"_27027":122107,"_2882":122108},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3396":71452,"_29729":71448,"_5":30079,"_20626":122110,"_27027":122111,"_2882":122112},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3396":71453,"_29729":71448,"_5":30079,"_20626":122114,"_27027":122115,"_2882":122116},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3396":71454,"_29729":71448,"_5":30079,"_20626":122118,"_27027":122119,"_2882":122120},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3396":71455,"_29729":71448,"_5":30079,"_20626":122122,"_27027":122123,"_2882":122124},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3396":71456,"_29729":71448,"_5":30079,"_20626":122126,"_27027":122127,"_2882":56574},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3396":71457,"_29729":71448,"_5":30079,"_20626":122129,"_27027":122130,"_2882":122131},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3396":71458,"_29729":71448,"_5":30079,"_20626":122133,"_27027":122134,"_2882":122135},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3396":71459,"_29729":71448,"_5":30079,"_20626":122137,"_27027":122138,"_2882":122139},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3396":71460,"_29729":71448,"_5":30079,"_20626":122141,"_27027":122142,"_2882":122143},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3396":71461,"_29729":71448,"_5":30079,"_20626":122145,"_27027":122146,"_2882":122147},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3396":71462,"_29729":71448,"_5":30079,"_20626":122149,"_27027":122150,"_2882":122151},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3396":71463,"_29729":71448,"_5":30079,"_20626":122153,"_27027":122154,"_2882":122155},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3396":71464,"_29729":71448,"_5":30079,"_20626":122157,"_27027":122158,"_2882":122159},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3396":71465,"_29729":71448,"_5":30079,"_20626":122161,"_27027":122162,"_2882":122163},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3396":71466,"_29729":71448,"_5":30079,"_20626":122165,"_27027":122166,"_2882":122167},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3396":71467,"_29729":71448,"_5":30079,"_20626":122169,"_27027":122170,"_2882":122171},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3396":71468,"_29729":71448,"_5":30079,"_20626":122173,"_27027":122174,"_2882":122175},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3396":71469,"_29729":71448,"_5":30079,"_20626":122177,"_27027":122178,"_2882":122179},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-roles-va","Referencias entre certificados, claves y roles VA",{"_3396":71470,"_29729":71448,"_5":30079,"_20626":122181,"_27027":122182,"_2882":122183},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3396":71471,"_29729":71448,"_5":30079,"_20626":122185,"_27027":122186,"_2882":122187},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3396":71472,"_29729":71448,"_5":30079,"_20626":122189,"_27027":122190,"_2882":122191},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3396":71473,"_29729":71448,"_5":30079,"_20626":122193,"_27027":122194,"_2882":122195},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3396":71474,"_29729":71448,"_5":30079,"_20626":122197,"_27027":122198,"_2882":122199},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3396":71475,"_29729":71448,"_5":30079,"_20626":122201,"_27027":122202,"_2882":122203},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3396":71476,"_29729":71448,"_5":30079,"_20626":122205,"_27027":122206,"_2882":122207},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3396":71477,"_29729":71448,"_5":30079,"_20626":122209,"_27027":122210,"_2882":122211},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#campo-firmante-del-rol-va","Campo firmante del rol VA",{"_3396":71478,"_29729":71448,"_5":30079,"_20626":122213,"_27027":122214,"_2882":122215},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3396":71479,"_29729":71448,"_5":30079,"_20626":122217,"_27027":122218,"_2882":122219},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3396":71480,"_29729":71448,"_5":30079,"_20626":122221,"_27027":122222,"_2882":122223},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3396":71481,"_29729":71448,"_5":30079,"_20626":122225,"_27027":122226,"_2882":122227},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3396":71482,"_29729":71448,"_5":30079,"_20626":122229,"_27027":122230,"_2882":122231},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3396":71483,"_29729":71448,"_5":30079,"_20626":122233,"_27027":122234,"_2882":122235},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3396":71484,"_29729":71448,"_5":30079,"_20626":122237,"_27027":122238,"_2882":122239},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3396":71485,"_29729":71448,"_5":30079,"_20626":122241,"_27027":122242,"_2882":122243},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3396":71486,"_29729":71448,"_5":30079,"_20626":122245,"_27027":122246,"_2882":118128},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3396":71487,"_29729":71448,"_5":30079,"_20626":122248,"_27027":122249,"_2882":122250},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3396":71488,"_29729":71448,"_5":30079,"_20626":122252,"_27027":122253,"_2882":122254},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3396":71489,"_29729":71448,"_20626":122256,"_5":14148,"_27027":71448,"_2882":122257},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3396":71490,"_29729":71448,"_20626":122259,"_5":14148,"_27027":71448,"_2882":122260},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3396":71491,"_29729":71448,"_20626":122262,"_5":14148,"_27027":71448,"_2882":122263},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3396":71492,"_29729":71448,"_20626":122265,"_5":14148,"_27027":71448,"_2882":122266},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3396":71493,"_29729":71448,"_20626":122268,"_5":14148,"_27027":71448,"_2882":122269},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3396":71494,"_29729":71448,"_20626":122271,"_5":14148,"_27027":71448,"_2882":122272},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3396":71495,"_29729":71448,"_20626":122274,"_5":14148,"_27027":71448,"_2882":122275},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3396":71496,"_29729":71448,"_20626":122277,"_5":14148,"_27027":122107,"_2882":122278},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3396":71497,"_29729":71448,"_20626":122280,"_5":14148,"_27027":122107,"_2882":122281},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3396":71498,"_29729":71448,"_20626":122283,"_5":14148,"_27027":122111,"_2882":122284},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3396":71499,"_29729":71448,"_20626":122286,"_5":14148,"_27027":122111,"_2882":122287},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3396":71500,"_29729":71448,"_20626":122289,"_5":14148,"_27027":122115,"_2882":122290},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3396":71501,"_29729":71448,"_20626":122292,"_5":14148,"_27027":122119,"_2882":122293},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3396":71502,"_29729":71448,"_20626":122295,"_5":14148,"_27027":122119,"_2882":122296},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3396":71503,"_29729":71448,"_20626":122298,"_5":14148,"_27027":122119,"_2882":122299},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3396":71504,"_29729":71448,"_20626":122301,"_5":14148,"_27027":122119,"_2882":122302},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3396":71505,"_29729":71448,"_20626":122304,"_5":14148,"_27027":122119,"_2882":122305},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3396":71506,"_29729":71448,"_20626":122307,"_5":14148,"_27027":122123,"_2882":122308},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3396":71507,"_29729":71448,"_20626":122310,"_5":14148,"_27027":122123,"_2882":122311},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3396":71508,"_29729":71448,"_20626":122313,"_5":14148,"_27027":122123,"_2882":122314},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3396":71509,"_29729":71448,"_20626":122316,"_5":14148,"_27027":122123,"_2882":122317},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3396":71510,"_29729":71448,"_20626":122319,"_5":14148,"_27027":122123,"_2882":122320},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3396":71511,"_29729":71448,"_20626":122322,"_5":14148,"_27027":122123,"_2882":122323},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3396":71512,"_29729":71448,"_20626":122325,"_5":14148,"_27027":122127,"_2882":122326},[],"Cambio",{"_3396":71513,"_29729":71448,"_20626":122328,"_5":14148,"_27027":122127,"_2882":122329},[],"A quién afecta",{"_3396":71514,"_29729":71448,"_20626":122331,"_5":14148,"_27027":122127,"_2882":122332},[],"Gravedad",{"_3396":71515,"_29729":71448,"_20626":122334,"_5":14148,"_27027":122127,"_2882":120854},[],{"_3396":71516,"_29729":71448,"_20626":122336,"_5":14148,"_27027":122127,"_2882":122135},[],{"_3396":71517,"_29729":71448,"_20626":122338,"_5":14148,"_27027":122127,"_2882":122339},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3396":71518,"_29729":71448,"_20626":122341,"_5":14148,"_27027":122127,"_2882":122342},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3396":71519,"_29729":71448,"_20626":122344,"_5":14148,"_27027":122127,"_2882":122345},[],"Copiar los datos a los volúmenes nuevos",{"_3396":71520,"_29729":71448,"_20626":122347,"_5":14148,"_27027":122127,"_2882":122139},[],{"_3396":71521,"_29729":71448,"_20626":122349,"_5":14148,"_27027":122127,"_2882":122350},[],"Todas las releases de Helm",{"_3396":71522,"_29729":71448,"_20626":122352,"_5":14148,"_27027":122127,"_2882":122353},[],"Alta: `helm upgrade` falla",{"_3396":71523,"_29729":71448,"_20626":122355,"_5":14148,"_27027":122127,"_2882":122356},[],"Eliminar o renombrar las claves heredadas",{"_3396":71524,"_29729":71448,"_20626":122358,"_5":14148,"_27027":122127,"_2882":122143},[],{"_3396":71525,"_29729":71448,"_20626":122360,"_5":14148,"_27027":122127,"_2882":122361},[],"Todos los despliegues",{"_3396":71526,"_29729":71448,"_20626":122363,"_5":14148,"_27027":122127,"_2882":122364},[],"Alta: sin principal de bootstrap no hay administrador",{"_3396":71527,"_29729":71448,"_20626":122366,"_5":14148,"_27027":122127,"_2882":122367},[],"Configurar `services.authz`",{"_3396":71528,"_29729":71448,"_20626":122369,"_5":14148,"_27027":122127,"_2882":122147},[],{"_3396":71529,"_29729":71448,"_20626":122371,"_5":14148,"_27027":122127,"_2882":122350},[],{"_3396":71530,"_29729":71448,"_20626":122373,"_5":14148,"_27027":122127,"_2882":122374},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3396":71531,"_29729":71448,"_20626":122376,"_5":14148,"_27027":122127,"_2882":122377},[],"Mover JWKS y roles a `services.authz`",{"_3396":71532,"_29729":71448,"_20626":122379,"_5":14148,"_27027":122127,"_2882":122167},[],{"_3396":71533,"_29729":71448,"_20626":122381,"_5":14148,"_27027":122127,"_2882":122382},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3396":71534,"_29729":71448,"_20626":122384,"_5":14148,"_27027":122127,"_2882":122385},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3396":71535,"_29729":71448,"_20626":122387,"_5":14148,"_27027":122127,"_2882":122388},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3396":71536,"_29729":71448,"_20626":122390,"_5":14148,"_27027":122127,"_2882":122171},[],{"_3396":71537,"_29729":71448,"_20626":122392,"_5":14148,"_27027":122127,"_2882":122393},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3396":71538,"_29729":71448,"_20626":122395,"_5":14148,"_27027":122127,"_2882":122396},[],"Alta: el backend ya no arranca con ellos",{"_3396":71539,"_29729":71448,"_20626":122398,"_5":14148,"_27027":122127,"_2882":122399},[],"Pasar a PostgreSQL antes de actualizar",{"_3396":71540,"_29729":71448,"_20626":122401,"_5":14148,"_27027":122127,"_2882":122402},[],"Webhooks con referencias a archivos",{"_3396":71541,"_29729":71448,"_20626":122404,"_5":14148,"_27027":122127,"_2882":122405},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3396":71542,"_29729":71448,"_20626":122407,"_5":14148,"_27027":122127,"_2882":122408},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3396":71543,"_29729":71448,"_20626":122410,"_5":14148,"_27027":122127,"_2882":122411},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3396":71544,"_29729":71448,"_20626":122413,"_5":14148,"_27027":122127,"_2882":122151},[],{"_3396":71545,"_29729":71448,"_20626":122415,"_5":14148,"_27027":122127,"_2882":122416},[],"Releases con identidades por servicio o material de claves montado",{"_3396":71546,"_29729":71448,"_20626":122418,"_5":14148,"_27027":122127,"_2882":122419},[],"Media: los servicios no pueden leer sus archivos",{"_3396":71547,"_29729":71448,"_20626":122421,"_5":14148,"_27027":122127,"_2882":122422},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3396":71548,"_29729":71448,"_20626":122424,"_5":14148,"_27027":122127,"_2882":122155},[],{"_3396":71549,"_29729":71448,"_20626":122426,"_5":14148,"_27027":122127,"_2882":122427},[],"Releases que definen `amqp.tls`",{"_3396":71550,"_29729":71448,"_20626":122429,"_5":14148,"_27027":122127,"_2882":122430},[],"Media: los clientes se conectan al puerto equivocado",{"_3396":71551,"_29729":71448,"_20626":122432,"_5":14148,"_27027":122127,"_2882":122433},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3396":71552,"_29729":71448,"_20626":122435,"_5":14148,"_27027":122127,"_2882":122175},[],{"_3396":71553,"_29729":71448,"_20626":122437,"_5":14148,"_27027":122127,"_2882":122438},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3396":71554,"_29729":71448,"_20626":122440,"_5":14148,"_27027":122127,"_2882":122441},[],"Media: las claves de CA quedan sin gestionar",{"_3396":71555,"_29729":71448,"_20626":122443,"_5":14148,"_27027":122127,"_2882":122444},[],"Ejecutar la migración de CA a KMS",{"_3396":71556,"_29729":71448,"_20626":122446,"_5":14148,"_27027":122127,"_2882":122447},[],"Verificación del certificado del receptor",{"_3396":71557,"_29729":71448,"_20626":122449,"_5":14148,"_27027":122127,"_2882":122450},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3396":71558,"_29729":71448,"_20626":122452,"_5":14148,"_27027":122127,"_2882":122453},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3396":71559,"_29729":71448,"_20626":122455,"_5":14148,"_27027":122127,"_2882":122456},[],"Poner `insecure_skip_verify` a `false`",{"_3396":71560,"_29729":71448,"_20626":122458,"_5":14148,"_27027":122127,"_2882":122191},[],{"_3396":71561,"_29729":71448,"_20626":122460,"_5":14148,"_27027":122127,"_2882":122461},[],"Scripts y consolas que editan DMS por API",{"_3396":71562,"_29729":71448,"_20626":122463,"_5":14148,"_27027":122127,"_2882":122464},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3396":71563,"_29729":71448,"_20626":122466,"_5":14148,"_27027":122127,"_2882":122467},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3396":71564,"_29729":71448,"_20626":122469,"_5":14148,"_27027":122127,"_2882":122211},[],{"_3396":71565,"_29729":71448,"_20626":122471,"_5":14148,"_27027":122127,"_2882":122472},[],"Clientes que crean o actualizan roles VA por API",{"_3396":71566,"_29729":71448,"_20626":122474,"_5":14148,"_27027":122127,"_2882":122475},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3396":71567,"_29729":71448,"_20626":122477,"_5":14148,"_27027":122127,"_2882":122478},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_certificate_serial_number`",{"_3396":71568,"_29729":71448,"_20626":122480,"_5":14148,"_27027":122127,"_2882":122207},[],{"_3396":71569,"_29729":71448,"_20626":122482,"_5":14148,"_27027":122127,"_2882":122483},[],"Consumidores que leen el campo `events` del dispositivo",{"_3396":71570,"_29729":71448,"_20626":122485,"_5":14148,"_27027":122127,"_2882":122486},[],"Media: el campo desaparece",{"_3396":71571,"_29729":71448,"_20626":122488,"_5":14148,"_27027":122127,"_2882":122489},[],"Usar los nuevos endpoints de eventos",{"_3396":71572,"_29729":71448,"_20626":122491,"_5":14148,"_27027":122127,"_2882":122215},[],{"_3396":71573,"_29729":71448,"_20626":122493,"_5":14148,"_27027":122127,"_2882":122494},[],"Despliegues con roles VA cuyo firmante no está en el inventario de CAs",{"_3396":71574,"_29729":71448,"_20626":122496,"_5":14148,"_27027":122127,"_2882":122497},[],"Media: la migración de la VA aborta",{"_3396":71575,"_29729":71448,"_20626":122499,"_5":14148,"_27027":122127,"_2882":122500},[],"Corregir los roles afectados antes de actualizar",{"_3396":71576,"_29729":71448,"_20626":122502,"_5":14148,"_27027":122127,"_2882":122159},[],{"_3396":71577,"_29729":71448,"_20626":122504,"_5":14148,"_27027":122127,"_2882":122505},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3396":71578,"_29729":71448,"_20626":122507,"_5":14148,"_27027":122127,"_2882":122508},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3396":71579,"_29729":71448,"_20626":122510,"_5":14148,"_27027":122127,"_2882":122511},[],"Actualizar el archivo de values",{"_3396":71580,"_29729":71448,"_20626":122513,"_5":14148,"_27027":122127,"_2882":122199},[],{"_3396":71581,"_29729":71448,"_20626":122515,"_5":14148,"_27027":122127,"_2882":122516},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3396":71582,"_29729":71448,"_20626":122518,"_5":14148,"_27027":122127,"_2882":122519},[],"Baja: prevalece el ID de la URL",{"_3396":71583,"_29729":71448,"_20626":122521,"_5":14148,"_27027":122127,"_2882":122522},[],"Enviar el ID en la URL",{"_3396":71584,"_29729":71448,"_20626":122524,"_5":14148,"_27027":122127,"_2882":122203},[],{"_3396":71585,"_29729":71448,"_20626":122526,"_5":14148,"_27027":122127,"_2882":122527},[],"Consumidores que comparan el `type` del certificado",{"_3396":71586,"_29729":71448,"_20626":122529,"_5":14148,"_27027":122127,"_2882":122530},[],"Baja: dos valores cambian de nombre",{"_3396":71587,"_29729":71448,"_20626":122532,"_5":14148,"_27027":122127,"_2882":122533},[],"Adaptar los consumidores",{"_3396":71588,"_29729":71448,"_20626":122535,"_5":14148,"_27027":122127,"_2882":122195},[],{"_3396":71589,"_29729":71448,"_20626":122537,"_5":14148,"_27027":122127,"_2882":122538},[],"Cualquier DMS",{"_3396":71590,"_29729":71448,"_20626":122540,"_5":14148,"_27027":122127,"_2882":122541},[],"Baja: solo informativo",{"_3396":71591,"_29729":71448,"_20626":122543,"_5":14148,"_27027":122127,"_2882":122544},[],"Revisar ambos bloques antes de editar",{"_3396":71592,"_29729":71448,"_20626":122546,"_5":14148,"_27027":122134,"_2882":122547},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3396":71593,"_29729":71448,"_20626":122549,"_5":14148,"_27027":122134,"_2882":122550},[],"El paso 4 de la guía de migración copia los datos.",{"_3396":71594,"_29729":71448,"_20626":122552,"_5":14148,"_27027":122138,"_2882":122553},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3396":71595,"_29729":71448,"_20626":122555,"_5":14148,"_27027":122142,"_2882":122556},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3396":71596,"_29729":71448,"_20626":122558,"_5":14148,"_27027":122146,"_2882":122559},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3396":71597,"_29729":71448,"_20626":122561,"_5":14148,"_27027":122150,"_2882":122562},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3396":71598,"_29729":71448,"_20626":122564,"_5":14148,"_27027":122150,"_2882":122565},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3396":71599,"_29729":71448,"_20626":122567,"_5":14148,"_27027":122154,"_2882":122568},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3396":71600,"_29729":71448,"_20626":122570,"_5":14148,"_27027":122158,"_2882":122571},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3396":71601,"_29729":71448,"_20626":122573,"_5":14148,"_27027":122158,"_2882":122574},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3396":71602,"_29729":71448,"_20626":122576,"_5":14148,"_27027":122158,"_2882":122577},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3396":71603,"_29729":71448,"_20626":122579,"_5":14148,"_27027":122158,"_2882":122580},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3396":71604,"_29729":71448,"_20626":122582,"_5":14148,"_27027":122158,"_2882":122583},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3396":71605,"_29729":71448,"_20626":122585,"_5":14148,"_27027":122158,"_2882":122586},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3396":71606,"_29729":71448,"_20626":122588,"_5":14148,"_27027":122166,"_2882":122589},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3396":71607,"_29729":71448,"_20626":122591,"_5":14148,"_27027":122166,"_2882":122592},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3396":71608,"_29729":71448,"_20626":122594,"_5":14148,"_27027":122166,"_2882":122595},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3396":71609,"_29729":71448,"_20626":122597,"_5":14148,"_27027":122166,"_2882":122598},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3396":71610,"_29729":71448,"_20626":122600,"_5":14148,"_27027":122166,"_2882":122601},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3396":71611,"_29729":71448,"_20626":122603,"_5":14148,"_27027":122170,"_2882":122604},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3396":71612,"_29729":71448,"_20626":122606,"_5":14148,"_27027":122174,"_2882":122607},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3396":71613,"_29729":71448,"_20626":122609,"_5":14148,"_27027":122174,"_2882":122610},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3396":71614,"_29729":71448,"_20626":122612,"_5":14148,"_27027":122174,"_2882":122613},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3396":71615,"_29729":71448,"_20626":122615,"_5":14148,"_27027":122174,"_2882":122616},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3396":71616,"_29729":71448,"_20626":122618,"_5":14148,"_27027":122174,"_2882":122619},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3396":71617,"_29729":71448,"_20626":122621,"_5":14148,"_27027":122174,"_2882":122622},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3396":71618,"_29729":71448,"_20626":122624,"_5":14148,"_27027":122174,"_2882":122625},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3396":71619,"_29729":71448,"_20626":122627,"_5":14148,"_27027":122174,"_2882":122628},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3396":71620,"_29729":71448,"_20626":122630,"_5":14148,"_27027":122178,"_2882":122631},[],"Los certificados referencian ahora su clave del KMS, y los roles VA referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3396":71621,"_29729":71448,"_20626":122633,"_5":14148,"_27027":122186,"_2882":122634},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3396":71622,"_29729":71448,"_20626":122636,"_5":14148,"_27027":122186,"_2882":122637},[],"Campo en 3.8.0",{"_3396":71623,"_29729":71448,"_20626":122639,"_5":14148,"_27027":122186,"_2882":122640},[],"Campo en 4.0.0",{"_3396":71624,"_29729":71448,"_20626":122642,"_5":14148,"_27027":122186,"_2882":57090},[],{"_3396":71625,"_29729":71448,"_20626":122644,"_5":14148,"_27027":122186,"_2882":122645},[],"`insecure_skip_verify` (con el valor negado)",{"_3396":71626,"_29729":71448,"_20626":122647,"_5":14148,"_27027":122186,"_2882":57096},[],{"_3396":71627,"_29729":71448,"_20626":122649,"_5":14148,"_27027":122186,"_2882":57099},[],{"_3396":71628,"_29729":71448,"_20626":122651,"_5":14148,"_27027":122186,"_2882":57102},[],{"_3396":71629,"_29729":71448,"_20626":122653,"_5":14148,"_27027":122186,"_2882":57105},[],{"_3396":71630,"_29729":71448,"_20626":122655,"_5":14148,"_27027":122186,"_2882":57108},[],{"_3396":71631,"_29729":71448,"_20626":122657,"_5":14148,"_27027":122186,"_2882":57111},[],{"_3396":71632,"_29729":71448,"_20626":122659,"_5":14148,"_27027":122186,"_2882":122660},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3396":71633,"_29729":71448,"_20626":122662,"_5":14148,"_27027":122186,"_2882":122663},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3396":71634,"_29729":71448,"_20626":122665,"_5":14148,"_27027":122186,"_2882":122666},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3396":71635,"_29729":71448,"_20626":122668,"_5":14148,"_27027":122190,"_2882":122669},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3396":71636,"_29729":71448,"_20626":122671,"_5":14148,"_27027":122190,"_2882":122672},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3396":71637,"_29729":71448,"_20626":122674,"_5":14148,"_27027":122190,"_2882":122675},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3396":71638,"_29729":71448,"_20626":122677,"_5":14148,"_27027":122194,"_2882":122678},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3396":71639,"_29729":71448,"_20626":122680,"_5":14148,"_27027":122198,"_2882":122681},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3396":71640,"_29729":71448,"_20626":122683,"_5":14148,"_27027":122202,"_2882":122684},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3396":71641,"_29729":71448,"_20626":122686,"_5":14148,"_27027":122206,"_2882":122687},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3396":71642,"_29729":71448,"_20626":122689,"_5":14148,"_27027":122206,"_2882":122690},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3396":71643,"_29729":71448,"_20626":122692,"_5":14148,"_27027":122206,"_2882":122693},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3396":71644,"_29729":71448,"_20626":122695,"_5":14148,"_27027":122206,"_2882":122696},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3396":71645,"_29729":71448,"_20626":122698,"_5":14148,"_27027":122210,"_2882":122699},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_certificate_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de un rol nuevo es el número de serie del certificado actual de la CA. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. Las políticas de autorización personalizadas que filtran por el campo antiguo deben actualizarse: el filtro `crl_subject_key_id_signer` se renombra a `crl_signer_certificate_serial_number` y toma valores de número de serie.",{"_3396":71646,"_29729":71448,"_20626":122701,"_5":14148,"_27027":122214,"_2882":122702},[],"La migración de la VA resuelve automáticamente el firmante de cada rol: cuando varias CAs comparten la clave del firmante, usa la más antigua y registra un aviso, pero aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` cuando no existe ningún certificado con ese SKI. Corrige esos roles antes de actualizar.",{"_3396":71647,"_29729":71448,"_20626":122704,"_5":14148,"_27027":122218,"_2882":122705},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3396":71648,"_29729":71448,"_20626":122707,"_5":14148,"_27027":122222,"_2882":122708},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_3396":71649,"_29729":71448,"_20626":122710,"_5":14148,"_27027":122222,"_2882":122711},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3396":71650,"_29729":71448,"_20626":122713,"_5":14148,"_27027":122222,"_2882":122714},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3396":71651,"_29729":71448,"_20626":122716,"_5":14148,"_27027":122222,"_2882":122717},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3396":71652,"_29729":71448,"_20626":122719,"_5":14148,"_27027":122222,"_2882":122720},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3396":71653,"_29729":71448,"_20626":122722,"_5":14148,"_27027":122226,"_2882":122723},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3396":71654,"_29729":71448,"_20626":122725,"_5":14148,"_27027":122226,"_2882":122726},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3396":71655,"_29729":71448,"_20626":122728,"_5":14148,"_27027":122226,"_2882":122729},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3396":71656,"_29729":71448,"_20626":122731,"_5":14148,"_27027":122226,"_2882":122732},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3396":71657,"_29729":71448,"_20626":122734,"_5":14148,"_27027":122226,"_2882":122735},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3396":71658,"_29729":71448,"_20626":122737,"_5":14148,"_27027":122226,"_2882":122738},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3396":71659,"_29729":71448,"_20626":122740,"_5":14148,"_27027":122226,"_2882":122741},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3396":71660,"_29729":71448,"_20626":122743,"_5":14148,"_27027":122226,"_2882":122744},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3396":71661,"_29729":71448,"_20626":122746,"_5":14148,"_27027":122226,"_2882":122747},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3396":71662,"_29729":71448,"_20626":122749,"_5":14148,"_27027":122226,"_2882":122750},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3396":71663,"_29729":71448,"_20626":122752,"_5":14148,"_27027":122226,"_2882":122753},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3396":71664,"_29729":71448,"_20626":122755,"_5":14148,"_27027":122226,"_2882":122756},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3396":71665,"_29729":71448,"_20626":122758,"_5":14148,"_27027":122230,"_2882":122759},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3396":71666,"_29729":71448,"_20626":122761,"_5":14148,"_27027":122230,"_2882":122762},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3396":71667,"_29729":71448,"_20626":122764,"_5":14148,"_27027":122234,"_2882":122765},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3396":71668,"_29729":71448,"_20626":122767,"_5":14148,"_27027":122234,"_2882":122768},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3396":71669,"_29729":71448,"_20626":122770,"_5":14148,"_27027":122234,"_2882":122771},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3396":71670,"_29729":71448,"_20626":122773,"_5":14148,"_27027":122234,"_2882":122774},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3396":71671,"_29729":71448,"_20626":122776,"_5":14148,"_27027":122234,"_2882":122777},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3396":71672,"_29729":71448,"_20626":122779,"_5":14148,"_27027":122234,"_2882":122780},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3396":71673,"_29729":71448,"_20626":122782,"_5":14148,"_27027":122234,"_2882":122783},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3396":71674,"_29729":71448,"_20626":122785,"_5":14148,"_27027":122234,"_2882":122786},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3396":71675,"_29729":71448,"_20626":122788,"_5":14148,"_27027":122234,"_2882":122789},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3396":71676,"_29729":71448,"_20626":122791,"_5":14148,"_27027":122234,"_2882":122792},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3396":71677,"_29729":71448,"_20626":122794,"_5":14148,"_27027":122234,"_2882":122795},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3396":71678,"_29729":71448,"_20626":122797,"_5":14148,"_27027":122238,"_2882":122798},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3396":71679,"_29729":71448,"_20626":122800,"_5":14148,"_27027":122238,"_2882":122801},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3396":71680,"_29729":71448,"_20626":122803,"_5":14148,"_27027":122242,"_2882":122804},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3396":71681,"_29729":71448,"_20626":122806,"_5":14148,"_27027":122242,"_2882":122807},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3396":71682,"_29729":71448,"_20626":122809,"_5":14148,"_27027":122242,"_2882":122810},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Si tus servicios se conectan con un usuario distinto del que ejecutó las migraciones, concédele tras las migraciones `SELECT` sobre `ca.certificates_view`.",{"_3396":71683,"_29729":71448,"_20626":122812,"_5":14148,"_27027":122242,"_2882":122813},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3396":71684,"_29729":71448,"_20626":122815,"_5":14148,"_27027":122242,"_2882":122816},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3396":71685,"_29729":71448,"_20626":122818,"_5":14148,"_27027":122242,"_2882":122819},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3396":71686,"_29729":71448,"_20626":122821,"_5":14148,"_27027":122242,"_2882":122822},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3396":71687,"_29729":71448,"_20626":122824,"_5":14148,"_27027":122242,"_2882":122825},[],"Aplica las migraciones de esquema en el orden `kms` → `ca` → `va`; `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden ejecutarse en cualquier momento. La migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema` mientras `kms` no esté migrado, y `va` necesita `ca` migrado. Las migraciones de `ca` y `va` además leen tablas que pertenecen a otro esquema, así que el rol de PostgreSQL que las ejecuta necesita privilegios sobre él: `USAGE` sobre el esquema `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys` para la migración de `ca`, y `USAGE` sobre el esquema `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates` para la migración de `va`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido.",{"_3396":71688,"_29729":71448,"_20626":122827,"_5":14148,"_27027":122242,"_2882":122828},[],"Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédale `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`); el servicio de CA lee certificados y CAs a través de esa vista, y sin el permiso toda lectura de certificados y CAs falla con `permission denied for table certificates_view`.",{"_3396":71689,"_29729":71448,"_20626":122830,"_5":14148,"_27027":122246,"_2882":122831},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3396":71690,"_29729":71448,"_20626":122833,"_5":14148,"_27027":122246,"_2882":122834},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3396":71691,"_29729":71448,"_20626":122836,"_5":14148,"_27027":122246,"_2882":122837},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3396":71692,"_29729":71448,"_20626":122839,"_5":14148,"_27027":122246,"_2882":122840},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3396":71693,"_29729":71448,"_20626":122842,"_5":14148,"_27027":122246,"_2882":122843},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_3396":71694,"_29729":71448,"_20626":122845,"_5":14148,"_27027":122246,"_2882":122846},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3396":71695,"_29729":71448,"_20626":122848,"_5":14148,"_27027":122246,"_2882":122849},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3396":71696,"_29729":71448,"_20626":122851,"_5":14148,"_27027":122246,"_2882":122852},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_3396":71697,"_29729":71448,"_20626":122854,"_5":14148,"_27027":122246,"_2882":122855},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3396":71698,"_29729":71448,"_20626":122857,"_5":14148,"_27027":122246,"_2882":122858},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_certificate_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3396":71699,"_29729":71448,"_20626":122860,"_5":14148,"_27027":122246,"_2882":122861},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_3396":71700,"_29729":71448,"_20626":122863,"_5":14148,"_27027":122249,"_2882":122864},[],"Tras la actualización, comprueba en este orden:",{"_3396":71701,"_29729":71448,"_20626":122866,"_5":14148,"_27027":122249,"_2882":122867},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3396":71702,"_29729":71448,"_20626":122869,"_5":14148,"_27027":122249,"_2882":122870},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3396":71703,"_29729":71448,"_20626":122872,"_5":14148,"_27027":122249,"_2882":122873},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3396":71704,"_29729":71448,"_20626":122875,"_5":14148,"_27027":122249,"_2882":122876},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_3396":71705,"_29729":71448,"_20626":122878,"_5":14148,"_27027":122249,"_2882":122879},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que puedes usar para confirmar el registro.",{"_3396":71706,"_29729":71448,"_20626":122881,"_5":14148,"_27027":122249,"_2882":122882},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3396":71707,"_29729":71448,"_20626":122884,"_5":14148,"_27027":122249,"_2882":122885},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3396":71708,"_29729":71448,"_20626":122887,"_5":14148,"_27027":122249,"_2882":122888},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3396":71709,"_29729":71448,"_20626":122890,"_5":14148,"_27027":122249,"_2882":122891},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3396":71710,"_29729":71448,"_20626":122893,"_5":14148,"_27027":122249,"_2882":122894},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3396":71711,"_29729":71448,"_20626":122896,"_5":14148,"_27027":122249,"_2882":122897},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3396":71712,"_29729":71448,"_20626":122899,"_5":14148,"_27027":122249,"_2882":122900},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3396":71713,"_29729":71448,"_20626":122902,"_5":14148,"_27027":122249,"_2882":122903},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3396":71714,"_29729":71448,"_20626":122905,"_5":14148,"_27027":122249,"_2882":122906},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3396":71715,"_29729":71448,"_20626":122908,"_5":14148,"_27027":122253,"_2882":122909},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3396":71716,"_29729":71448,"_20626":122911,"_5":14148,"_27027":122253,"_2882":122912},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3396":71717,"_29729":71448,"_20626":122914,"_5":14148,"_27027":122253,"_2882":122915},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3396":71718,"_29729":71448,"_20626":122917,"_5":14148,"_27027":122253,"_2882":122918},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3396":71719,"_29729":71448,"_20626":122920,"_5":14148,"_27027":122253,"_2882":122921},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_57378":122923,"_57380":122924,"_57382":122925,"_57384":122926,"_17866":2917,"_68851":2917},"spanish",[2882,29729,5,27027],{"_2882":24632,"_29729":24632,"_5":24632,"_27027":24632},{"_2882":122927,"_29729":125792,"_5":128657,"_27027":131522},{"_4566":122928,"_57388":122929,"_5":24632},{"_14224":3183,"_14605":6067,"_14624":4811,"_28732":16872,"_14611":4120,"_19580":2949,"_14245":3023,"_14252":17171,"_28674":16148,"_29083":4595,"_29104":4682,"_28708":5939,"_34048":5428,"_28811":20038,"_29148":9707,"_34055":5839,"_34058":3342,"_34061":3461,"_34064":3351,"_29555":5897,"_34069":12895,"_34071":3184,"_29585":5045,"_14620":15555,"_34075":7384,"_34078":4223,"_34080":5920,"_29132":4669,"_29550":9313,"_29598":10825,"_34085":5498,"_34087":3367,"_34089":4305,"_28828":6211,"_34092":10821,"_34094":3964,"_34096":3244,"_34098":7553,"_34100":3267,"_28745":6902,"_34103":6952,"_34105":4317,"_28739":6191,"_29169":6120,"_34109":19854,"_34111":12690,"_34114":10172,"_28785":3175,"_34118":4797,"_28665":4172,"_34121":3053,"_28713":16952,"_34124":14716,"_34126":7494,"_34129":5733,"_14614":4734,"_29788":3694,"_34133":19380,"_34136":12150,"_34138":13382,"_34140":8574,"_34142":4552,"_34144":7548,"_19583":5062,"_34147":5047,"_34149":6817,"_28686":3024,"_29126":3441,"_34153":5048,"_34155":4862,"_34157":12261,"_29615":6483,"_34160":21025,"_3416