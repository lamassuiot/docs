010":56256,"_39012":56259,"_39014":56262,"_39016":56265,"_39018":56268,"_39020":56271,"_39022":56274,"_39024":56277,"_39026":56280,"_39028":56283,"_39031":56286,"_39033":56289,"_39035":56292,"_39037":56295},{"_3337":15,"_29196":15,"_5":14181,"_2824":47526,"_29540":47527,"_20242":47531,"_26574":15},"Deploy from AWS Marketplace",[47528,47529,47530],"Docs","Deployment","Other models",[],{"_3337":16,"_29196":15,"_20242":47533,"_5":13829,"_26574":15,"_2824":47534},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3337":17,"_29196":15,"_5":29537,"_20242":47536,"_26574":47537,"_2824":47538},[],"/docs/pr-preview/pr-57/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3337":18,"_29196":15,"_5":29537,"_20242":47540,"_26574":47541,"_2824":47542},[],"/docs/pr-preview/pr-57/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3337":19,"_29196":15,"_5":29537,"_20242":47544,"_26574":47545,"_2824":47546},[],"/docs/pr-preview/pr-57/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3337":20,"_29196":15,"_5":29537,"_20242":47548,"_26574":47549,"_2824":47550},[],"/docs/pr-preview/pr-57/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3337":21,"_29196":15,"_5":29537,"_20242":47552,"_26574":47553,"_2824":47554},[],"/docs/pr-preview/pr-57/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3337":22,"_29196":15,"_5":29537,"_20242":47556,"_26574":47557,"_2824":47558},[],"/docs/pr-preview/pr-57/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3337":23,"_29196":15,"_5":29537,"_20242":47560,"_26574":47561,"_2824":47562},[],"/docs/pr-preview/pr-57/deployment/aws-marketplace#next-step","Next step",{"_3337":24,"_29196":15,"_20242":47564,"_5":13829,"_26574":15,"_2824":47565},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3337":25,"_29196":15,"_20242":47567,"_5":13829,"_26574":47537,"_2824":47568},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3337":26,"_29196":15,"_20242":47570,"_5":13829,"_26574":47537,"_2824":47571},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3337":27,"_29196":15,"_20242":47573,"_5":13829,"_26574":47537,"_2824":47574},[],"A security group allowing the necessary endpoints.",{"_3337":28,"_29196":15,"_20242":47576,"_5":13829,"_26574":47541,"_2824":47577},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3337":29,"_29196":15,"_20242":47579,"_5":13829,"_26574":47541,"_2824":47580},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3337":30,"_29196":15,"_20242":47582,"_5":13829,"_26574":47541,"_2824":47583},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3337":31,"_29196":15,"_20242":47585,"_5":13829,"_26574":47545,"_2824":47586},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3337":32,"_29196":15,"_20242":47588,"_5":13829,"_26574":47549,"_2824":47589},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3337":33,"_29196":15,"_20242":47591,"_5":13829,"_26574":47553,"_2824":47592},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3337":34,"_29196":15,"_20242":47594,"_5":13829,"_26574":47557,"_2824":47595},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3337":35,"_29196":15,"_20242":47597,"_5":13829,"_26574":47561,"_2824":47598},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3337":36,"_29196":36,"_5":14181,"_2824":47600,"_29540":47601,"_20242":47602,"_26574":36},"Deploy Lamassu",[47528,47529],[],{"_3337":37,"_29196":36,"_20242":47604,"_5":13829,"_26574":36,"_2824":47605},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3337":38,"_29196":36,"_5":29537,"_20242":47607,"_26574":47608,"_2824":47609},[],"/docs/pr-preview/pr-57/deployment/overview#choose-a-model","Choose a model",{"_3337":39,"_29196":36,"_5":29537,"_20242":47611,"_26574":47612,"_2824":47613},[],"/docs/pr-preview/pr-57/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3337":40,"_29196":36,"_5":29537,"_20242":47615,"_26574":47616,"_2824":47617},[],"/docs/pr-preview/pr-57/deployment/overview#after-deployment","After deployment",{"_3337":41,"_29196":36,"_20242":47619,"_5":13829,"_26574":36,"_2824":47620},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3337":42,"_29196":36,"_20242":47622,"_5":13829,"_26574":47608,"_2824":47623},[],"Model",{"_3337":43,"_29196":36,"_20242":47625,"_5":13829,"_26574":47608,"_2824":47626},[],"Recommended for",{"_3337":44,"_29196":36,"_20242":47628,"_5":13829,"_26574":47608,"_2824":47629},[],"Who operates the infrastructure",{"_3337":45,"_29196":36,"_20242":47631,"_5":13829,"_26574":47608,"_2824":47632},[],"Starting point",{"_3337":46,"_29196":36,"_20242":47634,"_5":13829,"_26574":47608,"_2824":47635},[],"Kubernetes self-managed",{"_3337":47,"_29196":36,"_20242":47637,"_5":13829,"_26574":47608,"_2824":47638},[],"Production, regulated environments and custom deployments",{"_3337":48,"_29196":36,"_20242":47640,"_5":13829,"_26574":47608,"_2824":47641},[],"Your team",{"_3337":49,"_29196":36,"_20242":47643,"_5":13829,"_26574":47608,"_2824":47644},[],"Helm or Fastlane",{"_3337":50,"_29196":36,"_20242":47646,"_5":13829,"_26574":47608,"_2824":47647},[],"AWS Marketplace",{"_3337":51,"_29196":36,"_20242":47649,"_5":13829,"_26574":47608,"_2824":47650},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3337":52,"_29196":36,"_20242":47652,"_5":13829,"_26574":47608,"_2824":47641},[],{"_3337":53,"_29196":36,"_20242":47654,"_5":13829,"_26574":47608,"_2824":47655},[],"Preconfigured image on EC2",{"_3337":54,"_29196":36,"_20242":47657,"_5":13829,"_26574":47608,"_2824":47658},[],"SaaS",{"_3337":55,"_29196":36,"_20242":47660,"_5":13829,"_26574":47608,"_2824":47661},[],"Teams that want to use the platform without operating it",{"_3337":56,"_29196":36,"_20242":47663,"_5":13829,"_26574":47608,"_2824":47664},[],"Lamassu",{"_3337":57,"_29196":36,"_20242":47666,"_5":13829,"_26574":47608,"_2824":47667},[],"Managed subscription",{"_3337":58,"_29196":36,"_20242":47669,"_5":13829,"_26574":47608,"_2824":47670},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3337":59,"_29196":36,"_20242":47672,"_5":13829,"_26574":47608,"_2824":47673},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3337":60,"_29196":36,"_20242":47675,"_5":13829,"_26574":47608,"_2824":47676},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3337":61,"_29196":36,"_20242":47678,"_5":13829,"_26574":47612,"_2824":47679},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3337":62,"_29196":36,"_20242":47681,"_5":13829,"_26574":47616,"_2824":47682},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3337":63,"_29196":63,"_5":14181,"_2824":47684,"_29540":47685,"_20242":47686,"_26574":63},"Use Lamassu as SaaS",[47528,47529,47530],[],{"_3337":64,"_29196":63,"_20242":47688,"_5":13829,"_26574":63,"_2824":47689},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3337":65,"_29196":63,"_5":29537,"_20242":47691,"_26574":47692,"_2824":47693},[],"/docs/pr-preview/pr-57/deployment/saas#what-the-service-manages","What the service manages",{"_3337":66,"_29196":63,"_5":29537,"_20242":47695,"_26574":47696,"_2824":47697},[],"/docs/pr-preview/pr-57/deployment/saas#plans","Plans",{"_3337":67,"_29196":63,"_5":29537,"_20242":47699,"_26574":47700,"_2824":47701},[],"/docs/pr-preview/pr-57/deployment/saas#request-access","Request access",{"_3337":68,"_29196":63,"_20242":47703,"_5":13829,"_26574":63,"_2824":47704},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3337":69,"_29196":63,"_20242":47706,"_5":13829,"_26574":47692,"_2824":47707},[],"Platform availability and maintenance.",{"_3337":70,"_29196":63,"_20242":47709,"_5":13829,"_26574":47692,"_2824":47710},[],"Automatic backups.",{"_3337":71,"_29196":63,"_20242":47712,"_5":13829,"_26574":47692,"_2824":47713},[],"Version upgrades.",{"_3337":72,"_29196":63,"_20242":47715,"_5":13829,"_26574":47692,"_2824":47716},[],"Technical support and SLA according to your plan.",{"_3337":73,"_29196":63,"_20242":47718,"_5":13829,"_26574":47696,"_2824":47719},[],"Plan",{"_3337":74,"_29196":63,"_20242":47721,"_5":13829,"_26574":47696,"_2824":47722},[],"Devices",{"_3337":75,"_29196":63,"_20242":47724,"_5":13829,"_26574":47696,"_2824":47725},[],"Support",{"_3337":76,"_29196":63,"_20242":47727,"_5":13829,"_26574":47696,"_2824":47728},[],"SLA",{"_3337":77,"_29196":63,"_20242":47730,"_5":13829,"_26574":47696,"_2824":47731},[],"Starter",{"_3337":78,"_29196":63,"_20242":47733,"_5":13829,"_26574":47696,"_2824":47734},[],"Up to 1,000",{"_3337":79,"_29196":63,"_20242":47736,"_5":13829,"_26574":47696,"_2824":47737},[],"Email",{"_3337":80,"_29196":63,"_20242":47739,"_5":13829,"_26574":47696,"_2824":47740},[],"99.5 %",{"_3337":81,"_29196":63,"_20242":47742,"_5":13829,"_26574":47696,"_2824":47743},[],"Professional",{"_3337":82,"_29196":63,"_20242":47745,"_5":13829,"_26574":47696,"_2824":47746},[],"Up to 10,000",{"_3337":83,"_29196":63,"_20242":47748,"_5":13829,"_26574":47696,"_2824":47749},[],"Email and chat",{"_3337":84,"_29196":63,"_20242":47751,"_5":13829,"_26574":47696,"_2824":47752},[],"99.9 %",{"_3337":85,"_29196":63,"_20242":47754,"_5":13829,"_26574":47696,"_2824":47755},[],"Enterprise",{"_3337":86,"_29196":63,"_20242":47757,"_5":13829,"_26574":47696,"_2824":47758},[],"Unlimited",{"_3337":87,"_29196":63,"_20242":47760,"_5":13829,"_26574":47696,"_2824":47761},[],"Dedicated",{"_3337":88,"_29196":63,"_20242":47763,"_5":13829,"_26574":47696,"_2824":47764},[],"99.99 %",{"_3337":89,"_29196":63,"_20242":47766,"_5":13829,"_26574":47700,"_2824":47767},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3337":90,"_29196":63,"_20242":47769,"_5":13829,"_26574":47700,"_2824":47770},[],"When you receive your instance's credentials, continue with Get started.",{"_3337":91,"_29196":91,"_5":14181,"_2824":47772,"_29540":47773,"_20242":47774,"_26574":91},"Fastlane",[47528,47529,47635],[],{"_3337":92,"_29196":91,"_20242":47776,"_5":13829,"_26574":91,"_2824":47777},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3337":93,"_29196":91,"_5":29537,"_20242":47779,"_26574":47780,"_2824":47781},[],"/docs/pr-preview/pr-57/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3337":94,"_29196":91,"_5":29537,"_20242":47783,"_26574":47784,"_2824":47785},[],"/docs/pr-preview/pr-57/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3337":95,"_29196":91,"_5":29537,"_20242":47787,"_26574":47788,"_2824":47538},[],"/docs/pr-preview/pr-57/deployment/self-hosted/fastlane#before-you-begin",{"_3337":96,"_29196":91,"_5":29537,"_20242":47790,"_26574":47791,"_2824":47792},[],"/docs/pr-preview/pr-57/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3337":97,"_29196":91,"_5":29537,"_20242":47794,"_26574":47795,"_2824":47796},[],"/docs/pr-preview/pr-57/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3337":98,"_29196":91,"_5":29537,"_20242":47798,"_26574":47799,"_2824":47800},[],"/docs/pr-preview/pr-57/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3337":99,"_29196":91,"_5":29537,"_20242":47802,"_26574":47803,"_2824":47804},[],"/docs/pr-preview/pr-57/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3337":100,"_29196":91,"_5":29537,"_20242":47806,"_26574":47807,"_2824":47808},[],"/docs/pr-preview/pr-57/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3337":101,"_29196":91,"_5":29537,"_20242":47810,"_26574":47811,"_2824":47812},[],"/docs/pr-preview/pr-57/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3337":102,"_29196":91,"_5":29537,"_20242":47814,"_26574":47815,"_2824":47816},[],"/docs/pr-preview/pr-57/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3337":103,"_29196":91,"_5":29537,"_20242":47818,"_26574":47819,"_2824":47820},[],"/docs/pr-preview/pr-57/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3337":104,"_29196":91,"_20242":47822,"_5":13829,"_26574":47780,"_2824":47823},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3337":105,"_29196":91,"_20242":47825,"_5":13829,"_26574":47780,"_2824":47826},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3337":106,"_29196":91,"_20242":47828,"_5":13829,"_26574":47784,"_2824":47829},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3337":107,"_29196":91,"_20242":47831,"_5":13829,"_26574":47784,"_2824":47832},[],"Fastlane installs or configures",{"_3337":108,"_29196":91,"_20242":47834,"_5":13829,"_26574":47784,"_2824":47835},[],"You still provide",{"_3337":109,"_29196":91,"_20242":47837,"_5":13829,"_26574":47784,"_2824":47838},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3337":110,"_29196":91,"_20242":47840,"_5":13829,"_26574":47784,"_2824":47841},[],"The Kubernetes cluster, nodes and persistent storage",{"_3337":111,"_29196":91,"_20242":47843,"_5":13829,"_26574":47784,"_2824":47844},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3337":112,"_29196":91,"_20242":47846,"_5":13829,"_26574":47784,"_2824":47847},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3337":113,"_29196":91,"_20242":47849,"_5":13829,"_26574":47784,"_2824":47850},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3337":114,"_29196":91,"_20242":47852,"_5":13829,"_26574":47784,"_2824":47853},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3337":115,"_29196":91,"_20242":47855,"_5":13829,"_26574":47784,"_2824":47856},[],"Optional observability and lab HSM components",{"_3337":116,"_29196":91,"_20242":47858,"_5":13829,"_26574":47784,"_2824":47859},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3337":117,"_29196":91,"_20242":47861,"_5":13829,"_26574":47784,"_2824":47862},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3337":118,"_29196":91,"_20242":47864,"_5":13829,"_26574":47788,"_2824":47865},[],"You need:",{"_3337":119,"_29196":91,"_20242":47867,"_5":13829,"_26574":47788,"_2824":47868},[],"an existing Kubernetes cluster",{"_3337":120,"_29196":91,"_20242":47870,"_5":13829,"_26574":47788,"_2824":47871},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3337":121,"_29196":91,"_20242":47873,"_5":13829,"_26574":47788,"_2824":47874},[],"`yq`",{"_3337":122,"_29196":91,"_20242":47876,"_5":13829,"_26574":47788,"_2824":22926},[],{"_3337":123,"_29196":91,"_20242":47878,"_5":13829,"_26574":47788,"_2824":47879},[],"`jq` only when using `--sample-data` or `--development`",{"_3337":124,"_29196":91,"_20242":47881,"_5":13829,"_26574":47788,"_2824":47882},[],"`ssh-keygen` only when using `--with-hsm`",{"_3337":125,"_29196":91,"_20242":47884,"_5":13829,"_26574":47788,"_2824":47885},[],"free external ports 80 and 443 on a single-node K3s host",{"_3337":126,"_29196":91,"_20242":47887,"_5":13829,"_26574":47788,"_2824":47888},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3337":127,"_29196":91,"_20242":47890,"_5":13829,"_26574":47788,"_2824":47891},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3337":128,"_29196":91,"_20242":47893,"_5":13829,"_26574":47791,"_2824":47894},[],"Run the script from a clone of the Helm repository:",{"_3337":129,"_29196":91,"_20242":47896,"_5":13829,"_26574":47791,"_2824":47897},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3337":130,"_29196":91,"_20242":47899,"_5":13829,"_26574":47795,"_2824":47900},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3337":131,"_29196":91,"_20242":47902,"_5":13829,"_26574":47795,"_2824":47903},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3337":132,"_29196":91,"_20242":47905,"_5":13829,"_26574":47795,"_2824":47906},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3337":133,"_29196":91,"_20242":47908,"_5":13829,"_26574":47795,"_2824":47909},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3337":134,"_29196":91,"_20242":47911,"_5":13829,"_26574":47799,"_2824":47912},[],"Option",{"_3337":135,"_29196":91,"_20242":47914,"_5":13829,"_26574":47799,"_2824":47915},[],"Default",{"_3337":136,"_29196":91,"_20242":47917,"_5":13829,"_26574":47799,"_2824":47918},[],"Purpose",{"_3337":137,"_29196":91,"_20242":47920,"_5":13829,"_26574":47799,"_2824":47921},[],"`-h`, `--help`",{"_3337":138,"_29196":91,"_20242":47923,"_5":13829,"_26574":47799,"_2824":47924},[],"—",{"_3337":139,"_29196":91,"_20242":47926,"_5":13829,"_26574":47799,"_2824":47927},[],"Show help",{"_3337":140,"_29196":91,"_20242":47929,"_5":13829,"_26574":47799,"_2824":47930},[],"`-c`, `--context`",{"_3337":141,"_29196":91,"_20242":47932,"_5":13829,"_26574":47799,"_2824":47933},[],"current context",{"_3337":142,"_29196":91,"_20242":47935,"_5":13829,"_26574":47799,"_2824":47936},[],"Select the kubeconfig context for kubectl and Helm",{"_3337":143,"_29196":91,"_20242":47938,"_5":13829,"_26574":47799,"_2824":47939},[],"`-n`, `--non-interactive`",{"_3337":144,"_29196":91,"_20242":47941,"_5":13829,"_26574":47799,"_2824":6251},[],{"_3337":145,"_29196":91,"_20242":47943,"_5":13829,"_26574":47799,"_2824":47944},[],"Skip prompts and generate dependency credentials",{"_3337":146,"_29196":91,"_20242":47946,"_5":13829,"_26574":47799,"_2824":47947},[],"`-ns`, `--namespace`",{"_3337":147,"_29196":91,"_20242":47949,"_5":13829,"_26574":47799,"_2824":47950},[],"`lamassu-dev`",{"_3337":148,"_29196":91,"_20242":47952,"_5":13829,"_26574":47799,"_2824":47953},[],"Namespace for the installation",{"_3337":149,"_29196":91,"_20242":47955,"_5":13829,"_26574":47799,"_2824":47956},[],"`-d`, `--domain`",{"_3337":150,"_29196":91,"_20242":47958,"_5":13829,"_26574":47799,"_2824":47959},[],"`dev.lamassu.io`",{"_3337":151,"_29196":91,"_20242":47961,"_5":13829,"_26574":47799,"_2824":47962},[],"Domain used by the UI, OIDC and certificate",{"_3337":152,"_29196":91,"_20242":47964,"_5":13829,"_26574":47799,"_2824":47965},[],"`-v`, `--version`",{"_3337":153,"_29196":91,"_20242":47967,"_5":13829,"_26574":47799,"_2824":14482},[],{"_3337":154,"_29196":91,"_20242":47969,"_5":13829,"_26574":47799,"_2824":47970},[],"Lamassu chart version",{"_3337":155,"_29196":91,"_20242":47972,"_5":13829,"_26574":47799,"_2824":47973},[],"`--https-port`",{"_3337":156,"_29196":91,"_20242":47975,"_5":13829,"_26574":47799,"_2824":47976},[],"`443`",{"_3337":157,"_29196":91,"_20242":47978,"_5":13829,"_26574":47799,"_2824":47979},[],"Gateway HTTPS listener port",{"_3337":158,"_29196":91,"_20242":47981,"_5":13829,"_26574":47799,"_2824":47982},[],"`--http-port`",{"_3337":159,"_29196":91,"_20242":47984,"_5":13829,"_26574":47799,"_2824":47985},[],"`80`",{"_3337":160,"_29196":91,"_20242":47987,"_5":13829,"_26574":47799,"_2824":47988},[],"Gateway HTTP listener port",{"_3337":161,"_29196":91,"_20242":47990,"_5":13829,"_26574":47799,"_2824":47991},[],"`--tls-crt`",{"_3337":162,"_29196":91,"_20242":47993,"_5":13829,"_26574":47799,"_2824":47924},[],{"_3337":163,"_29196":91,"_20242":47995,"_5":13829,"_26574":47799,"_2824":47996},[],"PEM certificate for downstream TLS",{"_3337":164,"_29196":91,"_20242":47998,"_5":13829,"_26574":47799,"_2824":47999},[],"`--tls-key`",{"_3337":165,"_29196":91,"_20242":48001,"_5":13829,"_26574":47799,"_2824":47924},[],{"_3337":166,"_29196":91,"_20242":48003,"_5":13829,"_26574":47799,"_2824":48004},[],"PEM private key for downstream TLS",{"_3337":167,"_29196":91,"_20242":48006,"_5":13829,"_26574":47799,"_2824":48007},[],"`-l`, `--local-chart-path`",{"_3337":168,"_29196":91,"_20242":48009,"_5":13829,"_26574":47799,"_2824":48010},[],"repository chart",{"_3337":169,"_29196":91,"_20242":48012,"_5":13829,"_26574":47799,"_2824":48013},[],"Use an unpacked local Lamassu chart",{"_3337":170,"_29196":91,"_20242":48015,"_5":13829,"_26574":47799,"_2824":48016},[],"`-ip`, `--gateway-ip`",{"_3337":171,"_29196":91,"_20242":48018,"_5":13829,"_26574":47799,"_2824":8395},[],{"_3337":172,"_29196":91,"_20242":48020,"_5":13829,"_26574":47799,"_2824":48021},[],"Override the address written to `gateway.addresses`",{"_3337":173,"_29196":91,"_20242":48023,"_5":13829,"_26574":47799,"_2824":48024},[],"`--otel`",{"_3337":174,"_29196":91,"_20242":48026,"_5":13829,"_26574":47799,"_2824":6251},[],{"_3337":175,"_29196":91,"_20242":48028,"_5":13829,"_26574":47799,"_2824":48029},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3337":176,"_29196":91,"_20242":48031,"_5":13829,"_26574":47799,"_2824":48032},[],"`--development`",{"_3337":177,"_29196":91,"_20242":48034,"_5":13829,"_26574":47799,"_2824":6251},[],{"_3337":178,"_29196":91,"_20242":48036,"_5":13829,"_26574":47799,"_2824":48037},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3337":179,"_29196":91,"_20242":48039,"_5":13829,"_26574":47799,"_2824":48040},[],"`--sample-data`",{"_3337":180,"_29196":91,"_20242":48042,"_5":13829,"_26574":47799,"_2824":6251},[],{"_3337":181,"_29196":91,"_20242":48044,"_5":13829,"_26574":47799,"_2824":48045},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3337":182,"_29196":91,"_20242":48047,"_5":13829,"_26574":47799,"_2824":48048},[],"`--with-hsm`",{"_3337":183,"_29196":91,"_20242":48050,"_5":13829,"_26574":47799,"_2824":6251},[],{"_3337":184,"_29196":91,"_20242":48052,"_5":13829,"_26574":47799,"_2824":48053},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3337":185,"_29196":91,"_20242":48055,"_5":13829,"_26574":47799,"_2824":48056},[],"`--softhsm-chart-path`",{"_3337":186,"_29196":91,"_20242":48058,"_5":13829,"_26574":47799,"_2824":48059},[],"`./charts/softhsm`",{"_3337":187,"_29196":91,"_20242":48061,"_5":13829,"_26574":47799,"_2824":48062},[],"Use a different local SoftHSM chart",{"_3337":188,"_29196":91,"_20242":48064,"_5":13829,"_26574":47799,"_2824":48065},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3337":189,"_29196":91,"_20242":48067,"_5":13829,"_26574":47803,"_2824":48068},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3337":190,"_29196":91,"_20242":48070,"_5":13829,"_26574":47803,"_2824":48071},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3337":191,"_29196":91,"_20242":48073,"_5":13829,"_26574":47803,"_2824":48074},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3337":192,"_29196":91,"_20242":48076,"_5":13829,"_26574":47803,"_2824":48077},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3337":193,"_29196":91,"_20242":48079,"_5":13829,"_26574":47803,"_2824":48080},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3337":194,"_29196":91,"_20242":48082,"_5":13829,"_26574":47803,"_2824":48083},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3337":195,"_29196":91,"_20242":48085,"_5":13829,"_26574":47807,"_2824":48086},[],"Fastlane:",{"_3337":196,"_29196":91,"_20242":48088,"_5":13829,"_26574":47807,"_2824":48089},[],"validates local tools and the selected cluster",{"_3337":197,"_29196":91,"_20242":48091,"_5":13829,"_26574":47807,"_2824":48092},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3337":198,"_29196":91,"_20242":48094,"_5":13829,"_26574":47807,"_2824":48095},[],"creates the namespace",{"_3337":199,"_29196":91,"_20242":48097,"_5":13829,"_26574":47807,"_2824":48098},[],"installs PostgreSQL and creates the required databases",{"_3337":200,"_29196":91,"_20242":48100,"_5":13829,"_26574":47807,"_2824":48101},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3337":201,"_29196":91,"_20242":48103,"_5":13829,"_26574":47807,"_2824":48104},[],"installs RabbitMQ",{"_3337":202,"_29196":91,"_20242":48106,"_5":13829,"_26574":47807,"_2824":48107},[],"optionally installs observability and lab HSM components",{"_3337":203,"_29196":91,"_20242":48109,"_5":13829,"_26574":47807,"_2824":48110},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3337":204,"_29196":91,"_20242":48112,"_5":13829,"_26574":47807,"_2824":48113},[],"optionally loads sample data",{"_3337":205,"_29196":91,"_20242":48115,"_5":13829,"_26574":47807,"_2824":48116},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3337":206,"_29196":91,"_20242":48118,"_5":13829,"_26574":47811,"_2824":48119},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3337":207,"_29196":91,"_20242":48121,"_5":13829,"_26574":47811,"_2824":48122},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3337":208,"_29196":91,"_20242":48124,"_5":13829,"_26574":47815,"_2824":48125},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3337":209,"_29196":91,"_20242":48127,"_5":13829,"_26574":47815,"_2824":48128},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3337":210,"_29196":91,"_20242":48130,"_5":13829,"_26574":47815,"_2824":48131},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3337":211,"_29196":91,"_20242":48133,"_5":13829,"_26574":47819,"_2824":48134},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3337":212,"_29196":212,"_5":14181,"_2824":48136,"_29540":48137,"_20242":48138,"_26574":212},"Install with Helm",[47528,47529,47635],[],{"_3337":213,"_29196":212,"_20242":48140,"_5":13829,"_26574":212,"_2824":48141},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3337":214,"_29196":212,"_5":29537,"_20242":48143,"_26574":48144,"_2824":48145},[],"/docs/pr-preview/pr-57/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3337":215,"_29196":212,"_5":29537,"_20242":48147,"_26574":48148,"_2824":47538},[],"/docs/pr-preview/pr-57/deployment/self-hosted/helm#before-you-begin",{"_3337":216,"_29196":212,"_5":29537,"_20242":48150,"_26574":48151,"_2824":48152},[],"/docs/pr-preview/pr-57/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3337":217,"_29196":212,"_5":29537,"_20242":48154,"_26574":48155,"_2824":48156},[],"/docs/pr-preview/pr-57/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3337":218,"_29196":212,"_5":29537,"_20242":48158,"_26574":48159,"_2824":48160},[],"/docs/pr-preview/pr-57/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3337":219,"_29196":212,"_5":29537,"_20242":48162,"_26574":48163,"_2824":48164},[],"/docs/pr-preview/pr-57/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3337":220,"_29196":212,"_5":29537,"_20242":48166,"_26574":48167,"_2824":48168},[],"/docs/pr-preview/pr-57/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3337":221,"_29196":212,"_5":29537,"_20242":48170,"_26574":48171,"_2824":48172},[],"/docs/pr-preview/pr-57/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3337":222,"_29196":212,"_5":29537,"_20242":48174,"_26574":48175,"_2824":48176},[],"/docs/pr-preview/pr-57/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3337":223,"_29196":212,"_5":29537,"_20242":48178,"_26574":48179,"_2824":48180},[],"/docs/pr-preview/pr-57/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3337":224,"_29196":212,"_20242":48182,"_5":13829,"_26574":48144,"_2824":48183},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3337":225,"_29196":212,"_20242":48185,"_5":13829,"_26574":48148,"_2824":48186},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3337":226,"_29196":212,"_20242":48188,"_5":13829,"_26574":48148,"_2824":48189},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3337":227,"_29196":212,"_20242":48191,"_5":13829,"_26574":48148,"_2824":48192},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3337":228,"_29196":212,"_20242":48194,"_5":13829,"_26574":48148,"_2824":48195},[],"a reachable RabbitMQ broker and credentials",{"_3337":229,"_29196":212,"_20242":48197,"_5":13829,"_26574":48148,"_2824":48198},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3337":230,"_29196":212,"_20242":48200,"_5":13829,"_26574":48148,"_2824":48201},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3337":231,"_29196":212,"_20242":48203,"_5":13829,"_26574":48148,"_2824":48204},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3337":232,"_29196":212,"_20242":48206,"_5":13829,"_26574":48148,"_2824":48207},[],"a StorageClass and an external traffic design",{"_3337":233,"_29196":212,"_20242":48209,"_5":13829,"_26574":48148,"_2824":48210},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3337":234,"_29196":212,"_20242":48212,"_5":13829,"_26574":48148,"_2824":48213},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3337":235,"_29196":212,"_20242":48215,"_5":13829,"_26574":48148,"_2824":48216},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3337":236,"_29196":212,"_20242":48218,"_5":13829,"_26574":48151,"_2824":48219},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3337":237,"_29196":212,"_20242":48221,"_5":13829,"_26574":48151,"_2824":48222},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3337":238,"_29196":212,"_20242":48224,"_5":13829,"_26574":48151,"_2824":48225},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3337":239,"_29196":212,"_20242":48227,"_5":13829,"_26574":48155,"_2824":48228},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3337":240,"_29196":212,"_20242":48230,"_5":13829,"_26574":48155,"_2824":48231},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3337":241,"_29196":212,"_20242":48233,"_5":13829,"_26574":48155,"_2824":48234},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3337":242,"_29196":212,"_20242":48236,"_5":13829,"_26574":48155,"_2824":48237},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3337":243,"_29196":212,"_20242":48239,"_5":13829,"_26574":48159,"_2824":48240},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3337":244,"_29196":212,"_20242":48242,"_5":13829,"_26574":48163,"_2824":48243},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3337":245,"_29196":212,"_20242":48245,"_5":13829,"_26574":48163,"_2824":48246},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3337":246,"_29196":212,"_20242":48248,"_5":13829,"_26574":48163,"_2824":48249},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3337":247,"_29196":212,"_20242":48251,"_5":13829,"_26574":48163,"_2824":48252},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3337":248,"_29196":212,"_20242":48254,"_5":13829,"_26574":48163,"_2824":48255},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3337":249,"_29196":212,"_20242":48257,"_5":13829,"_26574":48163,"_2824":48258},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3337":250,"_29196":212,"_20242":48260,"_5":13829,"_26574":48163,"_2824":48261},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3337":251,"_29196":212,"_20242":48263,"_5":13829,"_26574":48167,"_2824":48264},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3337":252,"_29196":212,"_20242":48266,"_5":13829,"_26574":48167,"_2824":48267},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3337":253,"_29196":212,"_20242":48269,"_5":13829,"_26574":48167,"_2824":48270},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3337":254,"_29196":212,"_20242":48272,"_5":13829,"_26574":48167,"_2824":48273},[],"See Access control for the principal and policy model.",{"_3337":255,"_29196":212,"_20242":48275,"_5":13829,"_26574":48171,"_2824":48276},[],"To install a local checkout instead:",{"_3337":256,"_29196":212,"_20242":48278,"_5":13829,"_26574":48175,"_2824":48279},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3337":257,"_29196":212,"_20242":48281,"_5":13829,"_26574":48175,"_2824":48282},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3337":258,"_29196":212,"_20242":48284,"_5":13829,"_26574":48179,"_2824":48285},[],"Before going live, review:",{"_3337":259,"_29196":212,"_20242":48287,"_5":13829,"_26574":48179,"_2824":48288},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3337":260,"_29196":212,"_20242":48290,"_5":13829,"_26574":48179,"_2824":48291},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3337":261,"_29196":212,"_20242":48293,"_5":13829,"_26574":48179,"_2824":48294},[],"shared VA storage before increasing VA replicas",{"_3337":262,"_29196":212,"_20242":48296,"_5":13829,"_26574":48179,"_2824":48297},[],"managed OIDC roles and removal of evaluation credentials",{"_3337":263,"_29196":212,"_20242":48299,"_5":13829,"_26574":48179,"_2824":48300},[],"a trusted TLS issuer or externally managed certificate",{"_3337":264,"_29196":212,"_20242":48302,"_5":13829,"_26574":48179,"_2824":48303},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3337":265,"_29196":212,"_20242":48305,"_5":13829,"_26574":48179,"_2824":48306},[],"SMTP, observability and alert delivery",{"_3337":266,"_29196":212,"_20242":48308,"_5":13829,"_26574":48179,"_2824":48309},[],"the version upgrade guides and the notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_3337":267,"_29196":212,"_20242":48311,"_5":13829,"_26574":48179,"_2824":48312},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3337":268,"_29196":268,"_5":14181,"_2824":48314,"_29540":48315,"_20242":48316,"_26574":268},"Expose the Gateway",[47528,47529,47635],[],{"_3337":269,"_29196":268,"_20242":48318,"_5":13829,"_26574":268,"_2824":48319},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3337":270,"_29196":268,"_5":29537,"_20242":48321,"_26574":48322,"_2824":48323},[],"/docs/pr-preview/pr-57/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3337":271,"_29196":268,"_5":29537,"_20242":48325,"_26574":48326,"_2824":48327},[],"/docs/pr-preview/pr-57/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3337":272,"_29196":268,"_5":29537,"_20242":48329,"_26574":48330,"_2824":48331},[],"/docs/pr-preview/pr-57/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3337":273,"_29196":268,"_5":29537,"_20242":48333,"_26574":48334,"_2824":48335},[],"/docs/pr-preview/pr-57/deployment/self-hosted/networking#k3s","K3s",{"_3337":274,"_29196":268,"_5":29537,"_20242":48337,"_26574":48338,"_2824":48339},[],"/docs/pr-preview/pr-57/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3337":275,"_29196":268,"_5":29537,"_20242":48341,"_26574":48342,"_2824":48343},[],"/docs/pr-preview/pr-57/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3337":276,"_29196":268,"_5":29537,"_20242":48345,"_26574":48346,"_2824":48347},[],"/docs/pr-preview/pr-57/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3337":277,"_29196":268,"_5":29537,"_20242":48349,"_26574":48350,"_2824":48351},[],"/docs/pr-preview/pr-57/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3337":278,"_29196":268,"_5":29537,"_20242":48353,"_26574":48354,"_2824":48355},[],"/docs/pr-preview/pr-57/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3337":279,"_29196":268,"_5":29537,"_20242":48357,"_26574":48358,"_2824":48359},[],"/docs/pr-preview/pr-57/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3337":280,"_29196":268,"_20242":48361,"_5":13829,"_26574":48322,"_2824":48362},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3337":281,"_29196":268,"_20242":48364,"_5":13829,"_26574":48322,"_2824":48365},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3337":282,"_29196":268,"_20242":48367,"_5":13829,"_26574":48326,"_2824":48368},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3337":283,"_29196":268,"_20242":48370,"_5":13829,"_26574":48326,"_2824":48371},[],"Set it only when:",{"_3337":284,"_29196":268,"_20242":48373,"_5":13829,"_26574":48326,"_2824":48374},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3337":285,"_29196":268,"_20242":48376,"_5":13829,"_26574":48326,"_2824":48377},[],"that address is allocated to this Gateway",{"_3337":286,"_29196":268,"_20242":48379,"_5":13829,"_26574":48326,"_2824":48380},[],"the surrounding network already routes traffic for it to the cluster",{"_3337":287,"_29196":268,"_20242":48382,"_5":13829,"_26574":48326,"_2824":48383},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3337":288,"_29196":268,"_20242":48385,"_5":13829,"_26574":48326,"_2824":48386},[],"Keep these two settings separate:",{"_3337":289,"_29196":268,"_20242":48388,"_5":13829,"_26574":48326,"_2824":48389},[],"`gateway.addresses` requests an address for the Gateway.",{"_3337":290,"_29196":268,"_20242":48391,"_5":13829,"_26574":48326,"_2824":48392},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3337":291,"_29196":268,"_20242":48394,"_5":13829,"_26574":48326,"_2824":48395},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3337":292,"_29196":268,"_20242":48397,"_5":13829,"_26574":48330,"_2824":48398},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3337":293,"_29196":268,"_20242":48400,"_5":13829,"_26574":48330,"_2824":48401},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3337":294,"_29196":268,"_20242":48403,"_5":13829,"_26574":48334,"_2824":48404},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3337":295,"_29196":268,"_20242":48406,"_5":13829,"_26574":48334,"_2824":48407},[],"For the recommended design:",{"_3337":296,"_29196":268,"_20242":48409,"_5":13829,"_26574":48334,"_2824":48410},[],"Use only one externally exposed Lamassu Gateway.",{"_3337":297,"_29196":268,"_20242":48412,"_5":13829,"_26574":48334,"_2824":48413},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3337":298,"_29196":268,"_20242":48415,"_5":13829,"_26574":48334,"_2824":48416},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3337":299,"_29196":268,"_20242":48418,"_5":13829,"_26574":48334,"_2824":48419},[],"Point DNS at the VM's reachable address.",{"_3337":300,"_29196":268,"_20242":48421,"_5":13829,"_26574":48334,"_2824":48422},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3337":301,"_29196":268,"_20242":48424,"_5":13829,"_26574":48338,"_2824":48425},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3337":302,"_29196":268,"_20242":48427,"_5":13829,"_26574":48342,"_2824":48428},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3337":303,"_29196":268,"_20242":48430,"_5":13829,"_26574":48342,"_2824":48431},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3337":304,"_29196":268,"_20242":48433,"_5":13829,"_26574":48346,"_2824":48434},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3337":305,"_29196":268,"_20242":48436,"_5":13829,"_26574":48346,"_2824":48437},[],"Requirement",{"_3337":306,"_29196":268,"_20242":48439,"_5":13829,"_26574":48346,"_2824":48440},[],"Recommended design",{"_3337":307,"_29196":268,"_20242":48442,"_5":13829,"_26574":48346,"_2824":48443},[],"Consequence",{"_3337":308,"_29196":268,"_20242":48445,"_5":13829,"_26574":48346,"_2824":48446},[],"Several Lamassu URLs or services",{"_3337":309,"_29196":268,"_20242":48448,"_5":13829,"_26574":48346,"_2824":48449},[],"One Gateway with multiple routes",{"_3337":310,"_29196":268,"_20242":48451,"_5":13829,"_26574":48346,"_2824":48452},[],"One IP and one proxy fleet; this is the chart default",{"_3337":311,"_29196":268,"_20242":48454,"_5":13829,"_26574":48346,"_2824":48455},[],"Independent Gateways and separate external IPs",{"_3337":312,"_29196":268,"_20242":48457,"_5":13829,"_26574":48346,"_2824":48458},[],"One VIP per Gateway",{"_3337":313,"_29196":268,"_20242":48460,"_5":13829,"_26574":48346,"_2824":48461},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3337":314,"_29196":268,"_20242":48463,"_5":13829,"_26574":48346,"_2824":48464},[],"Independent Gateways on one node and one IP",{"_3337":315,"_29196":268,"_20242":48466,"_5":13829,"_26574":48346,"_2824":48467},[],"Use different external ports",{"_3337":316,"_29196":268,"_20242":48469,"_5":13829,"_26574":48346,"_2824":48470},[],"Clients must include non-standard ports",{"_3337":317,"_29196":268,"_20242":48472,"_5":13829,"_26574":48346,"_2824":48473},[],"Separate TLS/mTLS termination behind one IP",{"_3337":318,"_29196":268,"_20242":48475,"_5":13829,"_26574":48346,"_2824":48476},[],"Front-door SNI routing to internal Gateways",{"_3337":319,"_29196":268,"_20242":48478,"_5":13829,"_26574":48346,"_2824":48479},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3337":320,"_29196":268,"_20242":48481,"_5":13829,"_26574":48346,"_2824":48482},[],"Separate Gateway resources but shared proxy infrastructure",{"_3337":321,"_29196":268,"_20242":48484,"_5":13829,"_26574":48346,"_2824":48485},[],"Envoy merged-Gateway mode",{"_3337":322,"_29196":268,"_20242":48487,"_5":13829,"_26574":48346,"_2824":48488},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3337":323,"_29196":268,"_20242":48490,"_5":13829,"_26574":48346,"_2824":48491},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3337":324,"_29196":268,"_20242":48493,"_5":13829,"_26574":48346,"_2824":48494},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3337":325,"_29196":268,"_20242":48496,"_5":13829,"_26574":48346,"_2824":48497},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3337":326,"_29196":268,"_20242":48499,"_5":13829,"_26574":48346,"_2824":48500},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3337":327,"_29196":268,"_20242":48502,"_5":13829,"_26574":48350,"_2824":48503},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3337":328,"_29196":268,"_20242":48505,"_5":13829,"_26574":48350,"_2824":48506},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3337":329,"_29196":268,"_20242":48508,"_5":13829,"_26574":48350,"_2824":48509},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3337":330,"_29196":268,"_20242":48511,"_5":13829,"_26574":48350,"_2824":48512},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3337":331,"_29196":268,"_20242":48514,"_5":13829,"_26574":48350,"_2824":48515},[],"If none of those are possible, use different external ports or change the external network design.",{"_3337":332,"_29196":268,"_20242":48517,"_5":13829,"_26574":48354,"_2824":48518},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3337":333,"_29196":268,"_20242":48520,"_5":13829,"_26574":48354,"_2824":48521},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3337":334,"_29196":268,"_20242":48523,"_5":13829,"_26574":48358,"_2824":48524},[],"Check, in order:",{"_3337":335,"_29196":268,"_20242":48526,"_5":13829,"_26574":48358,"_2824":48527},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3337":336,"_29196":268,"_20242":48529,"_5":13829,"_26574":48358,"_2824":48530},[],"Its status contains the expected address.",{"_3337":337,"_29196":268,"_20242":48532,"_5":13829,"_26574":48358,"_2824":48533},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3337":338,"_29196":268,"_20242":48535,"_5":13829,"_26574":48358,"_2824":48536},[],"Port 443 reaches that address from the client network.",{"_3337":339,"_29196":268,"_20242":48538,"_5":13829,"_26574":48358,"_2824":48539},[],"DNS resolves to the externally reachable endpoint.",{"_3337":340,"_29196":268,"_20242":48541,"_5":13829,"_26574":48358,"_2824":48542},[],"The certificate contains the DNS name or IP used by the client.",{"_3337":341,"_29196":268,"_20242":48544,"_5":13829,"_26574":48358,"_2824":48545},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3337":342,"_29196":342,"_5":14181,"_2824":47635,"_29540":48547,"_20242":48548,"_26574":342},[47528,47529,47635],[],{"_3337":343,"_29196":342,"_20242":48550,"_5":13829,"_26574":342,"_2824":48551},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3337":344,"_29196":342,"_5":29537,"_20242":48553,"_26574":48554,"_2824":48555},[],"/docs/pr-preview/pr-57/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3337":345,"_29196":342,"_5":29537,"_20242":48557,"_26574":48558,"_2824":48559},[],"/docs/pr-preview/pr-57/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3337":346,"_29196":342,"_5":29537,"_20242":48561,"_26574":48562,"_2824":48563},[],"/docs/pr-preview/pr-57/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3337":347,"_29196":342,"_5":29537,"_20242":48565,"_26574":48566,"_2824":48567},[],"/docs/pr-preview/pr-57/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3337":348,"_29196":342,"_5":29537,"_20242":48569,"_26574":48570,"_2824":48571},[],"/docs/pr-preview/pr-57/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3337":349,"_29196":342,"_5":29537,"_20242":48573,"_26574":48574,"_2824":48575},[],"/docs/pr-preview/pr-57/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3337":350,"_29196":342,"_20242":48577,"_5":13829,"_26574":48554,"_2824":48578},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3337":351,"_29196":342,"_20242":48580,"_5":13829,"_26574":48558,"_2824":48581},[],"Workflow",{"_3337":352,"_29196":342,"_20242":48583,"_5":13829,"_26574":48558,"_2824":48584},[],"Use it for",{"_3337":353,"_29196":342,"_20242":48586,"_5":13829,"_26574":48558,"_2824":48587},[],"What it installs",{"_3337":354,"_29196":342,"_20242":48589,"_5":13829,"_26574":48558,"_2824":48590},[],"Helm",{"_3337":355,"_29196":342,"_20242":48592,"_5":13829,"_26574":48558,"_2824":48593},[],"Production and controlled environments",{"_3337":356,"_29196":342,"_20242":48595,"_5":13829,"_26574":48558,"_2824":48596},[],"Lamassu services and Gateway API resources",{"_3337":357,"_29196":342,"_20242":48598,"_5":13829,"_26574":48558,"_2824":47772},[],{"_3337":358,"_29196":342,"_20242":48600,"_5":13829,"_26574":48558,"_2824":48601},[],"Evaluation, demos, CI and small lab clusters",{"_3337":359,"_29196":342,"_20242":48603,"_5":13829,"_26574":48558,"_2824":48604},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3337":360,"_29196":342,"_20242":48606,"_5":13829,"_26574":48562,"_2824":48607},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3337":361,"_29196":342,"_20242":48609,"_5":13829,"_26574":48562,"_2824":48610},[],"Area",{"_3337":362,"_29196":342,"_20242":48612,"_5":13829,"_26574":48562,"_2824":48613},[],"The Lamassu chart provides",{"_3337":363,"_29196":342,"_20242":48615,"_5":13829,"_26574":48562,"_2824":48616},[],"You provide",{"_3337":364,"_29196":342,"_20242":48618,"_5":13829,"_26574":48562,"_2824":48619},[],"Lamassu applications",{"_3337":365,"_29196":342,"_20242":48621,"_5":13829,"_26574":48562,"_2824":48622},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3337":366,"_29196":342,"_20242":48624,"_5":13829,"_26574":48562,"_2824":48625},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3337":367,"_29196":342,"_20242":48627,"_5":13829,"_26574":48562,"_2824":48628},[],"PostgreSQL data",{"_3337":368,"_29196":342,"_20242":48630,"_5":13829,"_26574":48562,"_2824":48631},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3337":369,"_29196":342,"_20242":48633,"_5":13829,"_26574":48562,"_2824":48634},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3337":370,"_29196":342,"_20242":48636,"_5":13829,"_26574":48562,"_2824":48637},[],"Messaging",{"_3337":371,"_29196":342,"_20242":48639,"_5":13829,"_26574":48562,"_2824":48640},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3337":372,"_29196":342,"_20242":48642,"_5":13829,"_26574":48562,"_2824":48643},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3337":373,"_29196":342,"_20242":48645,"_5":13829,"_26574":48562,"_2824":48646},[],"Identity",{"_3337":374,"_29196":342,"_20242":48648,"_5":13829,"_26574":48562,"_2824":48649},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3337":375,"_29196":342,"_20242":48651,"_5":13829,"_26574":48562,"_2824":48652},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3337":376,"_29196":342,"_20242":48654,"_5":13829,"_26574":48562,"_2824":48655},[],"External routing",{"_3337":377,"_29196":342,"_20242":48657,"_5":13829,"_26574":48562,"_2824":48658},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3337":378,"_29196":342,"_20242":48660,"_5":13829,"_26574":48562,"_2824":48661},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3337":379,"_29196":342,"_20242":48663,"_5":13829,"_26574":48562,"_2824":48664},[],"TLS",{"_3337":380,"_29196":342,"_20242":48666,"_5":13829,"_26574":48562,"_2824":48667},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3337":381,"_29196":342,"_20242":48669,"_5":13829,"_26574":48562,"_2824":48670},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3337":382,"_29196":342,"_20242":48672,"_5":13829,"_26574":48562,"_2824":48673},[],"Persistent application data",{"_3337":383,"_29196":342,"_20242":48675,"_5":13829,"_26574":48562,"_2824":48676},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3337":384,"_29196":342,"_20242":48678,"_5":13829,"_26574":48562,"_2824":48679},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3337":385,"_29196":342,"_20242":48681,"_5":13829,"_26574":48562,"_2824":48682},[],"Optional integrations",{"_3337":386,"_29196":342,"_20242":48684,"_5":13829,"_26574":48562,"_2824":48685},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3337":387,"_29196":342,"_20242":48687,"_5":13829,"_26574":48562,"_2824":48688},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3337":388,"_29196":342,"_20242":48690,"_5":13829,"_26574":48562,"_2824":48691},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3337":389,"_29196":342,"_20242":48693,"_5":13829,"_26574":48562,"_2824":48694},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3337":390,"_29196":342,"_20242":48696,"_5":13829,"_26574":48566,"_2824":48697},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3337":391,"_29196":342,"_20242":48699,"_5":13829,"_26574":48566,"_2824":48700},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3337":392,"_29196":342,"_20242":48702,"_5":13829,"_26574":48570,"_2824":48703},[],"Kubernetes 1.24 or newer",{"_3337":393,"_29196":342,"_20242":48705,"_5":13829,"_26574":48570,"_2824":48706},[],"Helm 3.2 or newer",{"_3337":394,"_29196":342,"_20242":48708,"_5":13829,"_26574":48570,"_2824":48709},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3337":395,"_29196":342,"_20242":48711,"_5":13829,"_26574":48570,"_2824":48712},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3337":396,"_29196":342,"_20242":48714,"_5":13829,"_26574":48570,"_2824":48715},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3337":397,"_29196":342,"_20242":48717,"_5":13829,"_26574":48570,"_2824":48718},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3337":398,"_29196":342,"_20242":48720,"_5":13829,"_26574":48570,"_2824":48721},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3337":399,"_29196":342,"_20242":48723,"_5":13829,"_26574":48574,"_2824":48724},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3337":400,"_29196":342,"_20242":48726,"_5":13829,"_26574":48574,"_2824":48727},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3337":401,"_29196":342,"_20242":48729,"_5":13829,"_26574":48574,"_2824":48730},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3337":402,"_29196":342,"_20242":48732,"_5":13829,"_26574":48574,"_2824":48733},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3337":403,"_29196":403,"_5":14181,"_2824":48735,"_29540":48736,"_20242":48738,"_26574":403},"Deployment troubleshooting",[47528,47529,48737],"Operations",[],{"_3337":404,"_29196":403,"_20242":48740,"_5":13829,"_26574":403,"_2824":48741},[],"Diagnose access, service health and infrastructure dependencies.",{"_3337":405,"_29196":403,"_5":29537,"_20242":48743,"_26574":48744,"_2824":48745},[],"/docs/pr-preview/pr-57/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3337":406,"_29196":403,"_5":29537,"_20242":48747,"_26574":48748,"_2824":48749},[],"/docs/pr-preview/pr-57/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3337":407,"_29196":403,"_5":29537,"_20242":48751,"_26574":48752,"_2824":48753},[],"/docs/pr-preview/pr-57/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3337":408,"_29196":403,"_5":29537,"_20242":48755,"_26574":48756,"_2824":48757},[],"/docs/pr-preview/pr-57/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3337":409,"_29196":403,"_5":29537,"_20242":48759,"_26574":48760,"_2824":48761},[],"/docs/pr-preview/pr-57/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3337":410,"_29196":403,"_5":29537,"_20242":48763,"_26574":48764,"_2824":48765},[],"/docs/pr-preview/pr-57/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3337":411,"_29196":403,"_5":29537,"_20242":48767,"_26574":48768,"_2824":48769},[],"/docs/pr-preview/pr-57/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3337":412,"_29196":403,"_5":29537,"_20242":48771,"_26574":48772,"_2824":48773},[],"/docs/pr-preview/pr-57/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3337":413,"_29196":403,"_5":29537,"_20242":48775,"_26574":48776,"_2824":48777},[],"/docs/pr-preview/pr-57/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3337":414,"_29196":403,"_5":29537,"_20242":48779,"_26574":48780,"_2824":48781},[],"/docs/pr-preview/pr-57/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3337":415,"_29196":403,"_5":29537,"_20242":48783,"_26574":48784,"_2824":48785},[],"/docs/pr-preview/pr-57/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3337":416,"_29196":403,"_5":29537,"_20242":48787,"_26574":48788,"_2824":48789},[],"/docs/pr-preview/pr-57/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3337":417,"_29196":403,"_5":29537,"_20242":48791,"_26574":48792,"_2824":48793},[],"/docs/pr-preview/pr-57/deployment/troubleshooting#observability","Observability",{"_3337":418,"_29196":403,"_20242":48795,"_5":13829,"_26574":403,"_2824":48796},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3337":419,"_29196":403,"_20242":48798,"_5":13829,"_26574":48748,"_2824":48799},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3337":420,"_29196":403,"_20242":48801,"_5":13829,"_26574":48752,"_2824":48802},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3337":421,"_29196":403,"_20242":48804,"_5":13829,"_26574":48756,"_2824":48805},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3337":422,"_29196":403,"_20242":48807,"_5":13829,"_26574":48760,"_2824":48808},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3337":423,"_29196":403,"_20242":48810,"_5":13829,"_26574":48764,"_2824":48811},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3337":424,"_29196":403,"_20242":48813,"_5":13829,"_26574":48768,"_2824":48814},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3337":425,"_29196":403,"_20242":48816,"_5":13829,"_26574":48768,"_2824":48817},[],"Also run the chart's connectivity test:",{"_3337":426,"_29196":403,"_20242":48819,"_5":13829,"_26574":48768,"_2824":48820},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3337":427,"_29196":403,"_20242":48822,"_5":13829,"_26574":48768,"_2824":48823},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3337":428,"_29196":403,"_20242":48825,"_5":13829,"_26574":48772,"_2824":48826},[],"If you receive a 401:",{"_3337":429,"_29196":403,"_20242":48828,"_5":13829,"_26574":48772,"_2824":48829},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3337":430,"_29196":403,"_20242":48831,"_5":13829,"_26574":48772,"_2824":48832},[],"verify issuer, audience and expiration of the token;",{"_3337":431,"_29196":403,"_20242":48834,"_5":13829,"_26574":48772,"_2824":48835},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3337":432,"_29196":403,"_20242":48837,"_5":13829,"_26574":48772,"_2824":48838},[],"check that the provider's public and internal routes point to the same realm.",{"_3337":433,"_29196":403,"_20242":48840,"_5":13829,"_26574":48772,"_2824":48841},[],"If login succeeds but the APIs return 403:",{"_3337":434,"_29196":403,"_20242":48843,"_5":13829,"_26574":48772,"_2824":48844},[],"inspect the token's real claims;",{"_3337":435,"_29196":403,"_20242":48846,"_5":13829,"_26574":48772,"_2824":48847},[],"confirm they match an active principal;",{"_3337":436,"_29196":403,"_20242":48849,"_5":13829,"_26574":48772,"_2824":48850},[],"review the policies granted to that principal;",{"_3337":437,"_29196":403,"_20242":48852,"_5":13829,"_26574":48772,"_2824":48853},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3337":438,"_29196":403,"_20242":48855,"_5":13829,"_26574":48772,"_2824":48856},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3337":439,"_29196":403,"_20242":48858,"_5":13829,"_26574":48776,"_2824":48859},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3337":440,"_29196":403,"_20242":48861,"_5":13829,"_26574":48776,"_2824":48862},[],"Locate the authz pod and Service.",{"_3337":441,"_29196":403,"_20242":48864,"_5":13829,"_26574":48776,"_2824":48865},[],"Check /health, logs and its database connection.",{"_3337":442,"_29196":403,"_20242":48867,"_5":13829,"_26574":48776,"_2824":48868},[],"Verify the DNS and port configured in externalAuthorization.",{"_3337":443,"_29196":403,"_20242":48870,"_5":13829,"_26574":48776,"_2824":48871},[],"Check the check route is /v1/ext\\_authz/check.",{"_3337":444,"_29196":403,"_20242":48873,"_5":13829,"_26574":48776,"_2824":48874},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3337":445,"_29196":403,"_20242":48876,"_5":13829,"_26574":48780,"_2824":48877},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3337":446,"_29196":403,"_20242":48879,"_5":13829,"_26574":48784,"_2824":48880},[],"Review kubectl describe pod first. Common causes are:",{"_3337":447,"_29196":403,"_20242":48882,"_5":13829,"_26574":48784,"_2824":48883},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3337":448,"_29196":403,"_20242":48885,"_5":13829,"_26574":48784,"_2824":48886},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3337":449,"_29196":403,"_20242":48888,"_5":13829,"_26574":48784,"_2824":48889},[],"unbound persistent volume;",{"_3337":450,"_29196":403,"_20242":48891,"_5":13829,"_26574":48784,"_2824":48892},[],"inaccessible image or incorrect pull policy;",{"_3337":451,"_29196":403,"_20242":48894,"_5":13829,"_26574":48784,"_2824":48895},[],"invalid cryptographic engine configuration;",{"_3337":452,"_29196":403,"_20242":48897,"_5":13829,"_26574":48784,"_2824":48898},[],"CPU or memory limits set too low;",{"_3337":453,"_29196":403,"_20242":48900,"_5":13829,"_26574":48784,"_2824":48901},[],"an incomplete prior migration.",{"_3337":454,"_29196":403,"_20242":48903,"_5":13829,"_26574":48784,"_2824":48904},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3337":455,"_29196":403,"_20242":48906,"_5":13829,"_26574":48784,"_2824":48907},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3337":456,"_29196":403,"_20242":48909,"_5":13829,"_26574":48784,"_2824":48910},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3337":457,"_29196":403,"_20242":48912,"_5":13829,"_26574":48788,"_2824":48913},[],"Domain and audit events depend on the bus publisher:",{"_3337":458,"_29196":403,"_20242":48915,"_5":13829,"_26574":48788,"_2824":48916},[],"verify it is enabled in the emitting service;",{"_3337":459,"_29196":403,"_20242":48918,"_5":13829,"_26574":48788,"_2824":48919},[],"check AMQP connectivity and credentials;",{"_3337":460,"_29196":403,"_20242":48921,"_5":13829,"_26574":48788,"_2824":48922},[],"review exchange, routing key, queues and consumers;",{"_3337":461,"_29196":403,"_20242":48924,"_5":13829,"_26574":48788,"_2824":48925},[],"inspect dead-letter queues;",{"_3337":462,"_29196":403,"_20242":48927,"_5":13829,"_26574":48788,"_2824":48928},[],"alert on orphan durable queues and backlog growth.",{"_3337":463,"_29196":403,"_20242":48930,"_5":13829,"_26574":48788,"_2824":48931},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3337":464,"_29196":403,"_20242":48933,"_5":13829,"_26574":48788,"_2824":48934},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3337":465,"_29196":403,"_20242":48936,"_5":13829,"_26574":48788,"_2824":48937},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3337":466,"_29196":403,"_20242":48939,"_5":13829,"_26574":48788,"_2824":48940},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3337":467,"_29196":403,"_20242":48942,"_5":13829,"_26574":48788,"_2824":48943},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3337":468,"_29196":403,"_20242":48945,"_5":13829,"_26574":48788,"_2824":48946},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3337":469,"_29196":403,"_20242":48948,"_5":13829,"_26574":48788,"_2824":48949},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3337":470,"_29196":403,"_20242":48951,"_5":13829,"_26574":48792,"_2824":48952},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_3337":471,"_29196":403,"_20242":48954,"_5":13829,"_26574":48792,"_2824":48955},[],"Before closing an incident, record:",{"_3337":472,"_29196":403,"_20242":48957,"_5":13829,"_26574":48792,"_2824":48958},[],"the confirmed cause;",{"_3337":473,"_29196":403,"_20242":48960,"_5":13829,"_26574":48792,"_2824":48961},[],"the time scope and affected resources;",{"_3337":474,"_29196":403,"_20242":48963,"_5":13829,"_26574":48792,"_2824":48964},[],"the commands or queries used;",{"_3337":475,"_29196":403,"_20242":48966,"_5":13829,"_26574":48792,"_2824":48967},[],"the applied change and how to revert it;",{"_3337":476,"_29196":403,"_20242":48969,"_5":13829,"_26574":48792,"_2824":48970},[],"validation from a consumer;",{"_3337":477,"_29196":403,"_20242":48972,"_5":13829,"_26574":48792,"_2824":48973},[],"the preventive action and its owner.",{"_3337":478,"_29196":478,"_5":14181,"_2824":48975,"_29540":48976,"_20242":48979,"_26574":478},"Access control",[47528,48977,48978],"Platform","Administration",[],{"_3337":479,"_29196":478,"_20242":48981,"_5":13829,"_26574":478,"_2824":48982},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3337":480,"_29196":478,"_5":29537,"_20242":48984,"_26574":48985,"_2824":48986},[],"/docs/pr-preview/pr-57/platform/administration/access-control#essential-concepts","Essential concepts",{"_3337":481,"_29196":478,"_5":29537,"_20242":48988,"_26574":48989,"_2824":48990},[],"/docs/pr-preview/pr-57/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3337":482,"_29196":478,"_5":29537,"_20242":48992,"_26574":48993,"_2824":48994},[],"/docs/pr-preview/pr-57/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3337":483,"_29196":478,"_5":29537,"_20242":48996,"_26574":48997,"_2824":48998},[],"/docs/pr-preview/pr-57/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3337":484,"_29196":478,"_5":29537,"_20242":49000,"_26574":49001,"_2824":49002},[],"/docs/pr-preview/pr-57/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3337":485,"_29196":478,"_5":29537,"_20242":49004,"_26574":49005,"_2824":49006},[],"/docs/pr-preview/pr-57/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3337":486,"_29196":478,"_5":29537,"_20242":49008,"_26574":49009,"_2824":49010},[],"/docs/pr-preview/pr-57/platform/administration/access-control#oidc-principals","OIDC principals",{"_3337":487,"_29196":478,"_5":29537,"_20242":49012,"_26574":49013,"_2824":49014},[],"/docs/pr-preview/pr-57/platform/administration/access-control#x509-principals","X.509 principals",{"_3337":488,"_29196":478,"_5":29537,"_20242":49016,"_26574":49017,"_2824":49018},[],"/docs/pr-preview/pr-57/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3337":489,"_29196":478,"_5":29537,"_20242":49020,"_26574":49021,"_2824":49022},[],"/docs/pr-preview/pr-57/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3337":490,"_29196":478,"_5":29537,"_20242":49024,"_26574":49025,"_2824":49026},[],"/docs/pr-preview/pr-57/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3337":491,"_29196":478,"_5":29537,"_20242":49028,"_26574":49029,"_2824":49030},[],"/docs/pr-preview/pr-57/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3337":492,"_29196":478,"_5":29537,"_20242":49032,"_26574":49033,"_2824":49034},[],"/docs/pr-preview/pr-57/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3337":493,"_29196":478,"_5":29537,"_20242":49036,"_26574":49037,"_2824":49038},[],"/docs/pr-preview/pr-57/platform/administration/access-control#http-rules","HTTP rules",{"_3337":494,"_29196":478,"_5":29537,"_20242":49040,"_26574":49041,"_2824":49042},[],"/docs/pr-preview/pr-57/platform/administration/access-control#included-policies","Included policies",{"_3337":495,"_29196":478,"_5":29537,"_20242":49044,"_26574":49045,"_2824":48168},[],"/docs/pr-preview/pr-57/platform/administration/access-control#provision-the-first-administrator",{"_3337":496,"_29196":478,"_5":29537,"_20242":49047,"_26574":49048,"_2824":49049},[],"/docs/pr-preview/pr-57/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3337":497,"_29196":478,"_5":29537,"_20242":49051,"_26574":49052,"_2824":49053},[],"/docs/pr-preview/pr-57/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3337":498,"_29196":478,"_5":29537,"_20242":49055,"_26574":49056,"_2824":49057},[],"/docs/pr-preview/pr-57/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3337":499,"_29196":478,"_5":29537,"_20242":49059,"_26574":49060,"_2824":49061},[],"/docs/pr-preview/pr-57/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3337":500,"_29196":478,"_5":29537,"_20242":49063,"_26574":49064,"_2824":49065},[],"/docs/pr-preview/pr-57/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3337":501,"_29196":478,"_5":29537,"_20242":49067,"_26574":49068,"_2824":49069},[],"/docs/pr-preview/pr-57/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3337":502,"_29196":478,"_5":29537,"_20242":49071,"_26574":49072,"_2824":49073},[],"/docs/pr-preview/pr-57/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3337":503,"_29196":478,"_5":29537,"_20242":49075,"_26574":49076,"_2824":49077},[],"/docs/pr-preview/pr-57/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3337":504,"_29196":478,"_5":29537,"_20242":49079,"_26574":49080,"_2824":49081},[],"/docs/pr-preview/pr-57/platform/administration/access-control#operational-checklist","Operational checklist",{"_3337":505,"_29196":478,"_5":29537,"_20242":49083,"_26574":49084,"_2824":49085},[],"/docs/pr-preview/pr-57/platform/administration/access-control#diagnostics","Diagnostics",{"_3337":506,"_29196":478,"_5":29537,"_20242":49087,"_26574":49088,"_2824":49089},[],"/docs/pr-preview/pr-57/platform/administration/access-control#the-response-is-401","The response is 401",{"_3337":507,"_29196":478,"_5":29537,"_20242":49091,"_26574":49092,"_2824":49093},[],"/docs/pr-preview/pr-57/platform/administration/access-control#the-response-is-403","The response is 403",{"_3337":508,"_29196":478,"_5":29537,"_20242":49095,"_26574":49096,"_2824":49097},[],"/docs/pr-preview/pr-57/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3337":509,"_29196":478,"_5":29537,"_20242":49099,"_26574":49100,"_2824":49101},[],"/docs/pr-preview/pr-57/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3337":510,"_29196":478,"_5":29537,"_20242":49103,"_26574":49104,"_2824":49105},[],"/docs/pr-preview/pr-57/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3337":511,"_29196":478,"_20242":49107,"_5":13829,"_26574":478,"_2824":49108},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3337":512,"_29196":478,"_20242":49110,"_5":13829,"_26574":478,"_2824":49111},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3337":513,"_29196":478,"_20242":49113,"_5":13829,"_26574":478,"_2824":49114},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3337":514,"_29196":478,"_20242":49116,"_5":13829,"_26574":48985,"_2824":49117},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3337":515,"_29196":478,"_20242":49119,"_5":13829,"_26574":48985,"_2824":49120},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3337":516,"_29196":478,"_20242":49122,"_5":13829,"_26574":48985,"_2824":49123},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3337":517,"_29196":478,"_20242":49125,"_5":13829,"_26574":48985,"_2824":49126},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3337":518,"_29196":478,"_20242":49128,"_5":13829,"_26574":48985,"_2824":49129},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3337":519,"_29196":478,"_20242":49131,"_5":13829,"_26574":48985,"_2824":49132},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3337":520,"_29196":478,"_20242":49134,"_5":13829,"_26574":48989,"_2824":49135},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3337":521,"_29196":478,"_20242":49137,"_5":13829,"_26574":48989,"_2824":49138},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3337":522,"_29196":478,"_20242":49140,"_5":13829,"_26574":48993,"_2824":49141},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3337":523,"_29196":478,"_20242":49143,"_5":13829,"_26574":48993,"_2824":49144},[],"The decision is made **before forwarding the request to the service**:",{"_3337":524,"_29196":478,"_20242":49146,"_5":13829,"_26574":48993,"_2824":49147},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3337":525,"_29196":478,"_20242":49149,"_5":13829,"_26574":48993,"_2824":49150},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3337":526,"_29196":478,"_20242":49152,"_5":13829,"_26574":48993,"_2824":49153},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3337":527,"_29196":478,"_20242":49155,"_5":13829,"_26574":48993,"_2824":49156},[],"It separately loads the policies granted to each principal.",{"_3337":528,"_29196":478,"_20242":49158,"_5":13829,"_26574":48993,"_2824":49159},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3337":529,"_29196":478,"_20242":49161,"_5":13829,"_26574":48993,"_2824":49162},[],"`authz` looks for an HTTP rule granting that action.",{"_3337":530,"_29196":478,"_20242":49164,"_5":13829,"_26574":48993,"_2824":49165},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3337":531,"_29196":478,"_20242":49167,"_5":13829,"_26574":48993,"_2824":49168},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3337":532,"_29196":478,"_20242":49170,"_5":13829,"_26574":48993,"_2824":49171},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3337":533,"_29196":478,"_20242":49173,"_5":13829,"_26574":48993,"_2824":49174},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3337":534,"_29196":478,"_20242":49176,"_5":13829,"_26574":48997,"_2824":49177},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3337":535,"_29196":478,"_20242":49179,"_5":13829,"_26574":48997,"_2824":49180},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3337":536,"_29196":478,"_20242":49182,"_5":13829,"_26574":48997,"_2824":49183},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3337":537,"_29196":478,"_20242":49185,"_5":13829,"_26574":48997,"_2824":49186},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3337":538,"_29196":478,"_20242":49188,"_5":13829,"_26574":48997,"_2824":49189},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3337":539,"_29196":478,"_20242":49191,"_5":13829,"_26574":48997,"_2824":49192},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3337":540,"_29196":478,"_20242":49194,"_5":13829,"_26574":48997,"_2824":49195},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3337":541,"_29196":478,"_20242":49197,"_5":13829,"_26574":48997,"_2824":49198},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3337":542,"_29196":478,"_20242":49200,"_5":13829,"_26574":49001,"_2824":49201},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3337":543,"_29196":478,"_20242":49203,"_5":13829,"_26574":49001,"_2824":49204},[],"The decision is made with the domain operation context:",{"_3337":544,"_29196":478,"_20242":49206,"_5":13829,"_26574":49001,"_2824":49207},[],"The middleware extracts the credential and resolves the matching principals.",{"_3337":545,"_29196":478,"_20242":49209,"_5":13829,"_26574":49001,"_2824":49210},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3337":546,"_29196":478,"_20242":49212,"_5":13829,"_26574":49001,"_2824":49213},[],"`authz` gathers the entity rules of the granted policies.",{"_3337":547,"_29196":478,"_20242":49215,"_5":13829,"_26574":49001,"_2824":49216},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3337":548,"_29196":478,"_20242":49218,"_5":13829,"_26574":49001,"_2824":49219},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3337":549,"_29196":478,"_20242":49221,"_5":13829,"_26574":49001,"_2824":49222},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3337":550,"_29196":478,"_20242":49224,"_5":13829,"_26574":49001,"_2824":49225},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3337":551,"_29196":478,"_20242":49227,"_5":13829,"_26574":49001,"_2824":49228},[],"Actions fall into two groups:",{"_3337":552,"_29196":478,"_20242":49230,"_5":13829,"_26574":49001,"_2824":49231},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3337":553,"_29196":478,"_20242":49233,"_5":13829,"_26574":49001,"_2824":49234},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3337":554,"_29196":478,"_20242":49236,"_5":13829,"_26574":49001,"_2824":49237},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3337":555,"_29196":478,"_20242":49239,"_5":13829,"_26574":49005,"_2824":49240},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3337":556,"_29196":478,"_20242":49242,"_5":13829,"_26574":49005,"_2824":49243},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3337":557,"_29196":478,"_20242":49245,"_5":13829,"_26574":49005,"_2824":49246},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3337":558,"_29196":478,"_20242":49248,"_5":13829,"_26574":49009,"_2824":49249},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3337":559,"_29196":478,"_20242":49251,"_5":13829,"_26574":49009,"_2824":49252},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3337":560,"_29196":478,"_20242":49254,"_5":13829,"_26574":49009,"_2824":49255},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3337":561,"_29196":478,"_20242":49257,"_5":13829,"_26574":49009,"_2824":49258},[],"The implemented operators are:",{"_3337":562,"_29196":478,"_20242":49260,"_5":13829,"_26574":49009,"_2824":49261},[],"`equals`, for exact equality;",{"_3337":563,"_29196":478,"_20242":49263,"_5":13829,"_26574":49009,"_2824":49264},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3337":564,"_29196":478,"_20242":49266,"_5":13829,"_26574":49009,"_2824":49267},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3337":565,"_29196":478,"_20242":49269,"_5":13829,"_26574":49009,"_2824":49270},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3337":566,"_29196":478,"_20242":49272,"_5":13829,"_26574":49013,"_2824":49273},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3337":567,"_29196":478,"_20242":49275,"_5":13829,"_26574":49013,"_2824":49276},[],"The available modes are:",{"_3337":568,"_29196":478,"_20242":49278,"_5":13829,"_26574":49013,"_2824":49279},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3337":569,"_29196":478,"_20242":49281,"_5":13829,"_26574":49013,"_2824":49282},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3337":570,"_29196":478,"_20242":49284,"_5":13829,"_26574":49013,"_2824":49285},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3337":571,"_29196":478,"_20242":49287,"_5":13829,"_26574":49013,"_2824":49288},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3337":572,"_29196":478,"_20242":49290,"_5":13829,"_26574":49013,"_2824":49291},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3337":573,"_29196":478,"_20242":49293,"_5":13829,"_26574":49013,"_2824":49294},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3337":574,"_29196":478,"_20242":49296,"_5":13829,"_26574":49017,"_2824":49297},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3337":575,"_29196":478,"_20242":49299,"_5":13829,"_26574":49017,"_2824":49300},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3337":576,"_29196":478,"_20242":49302,"_5":13829,"_26574":49017,"_2824":49303},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3337":577,"_29196":478,"_20242":49305,"_5":13829,"_26574":49017,"_2824":49306},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3337":578,"_29196":478,"_20242":49308,"_5":13829,"_26574":49025,"_2824":49309},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3337":579,"_29196":478,"_20242":49311,"_5":13829,"_26574":49025,"_2824":49312},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3337":580,"_29196":478,"_20242":49314,"_5":13829,"_26574":49029,"_2824":49315},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3337":581,"_29196":478,"_20242":49317,"_5":13829,"_26574":49029,"_2824":49318},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3337":582,"_29196":478,"_20242":49320,"_5":13829,"_26574":49033,"_2824":49321},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3337":583,"_29196":478,"_20242":49323,"_5":13829,"_26574":49033,"_2824":49324},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3337":584,"_29196":478,"_20242":49326,"_5":13829,"_26574":49033,"_2824":49327},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3337":585,"_29196":478,"_20242":49329,"_5":13829,"_26574":49037,"_2824":49330},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3337":586,"_29196":478,"_20242":49332,"_5":13829,"_26574":49037,"_2824":49333},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3337":587,"_29196":478,"_20242":49335,"_5":13829,"_26574":49037,"_2824":49336},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3337":588,"_29196":478,"_20242":49338,"_5":13829,"_26574":49037,"_2824":49339},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3337":589,"_29196":478,"_20242":49341,"_5":13829,"_26574":49037,"_2824":49342},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3337":590,"_29196":478,"_20242":49344,"_5":13829,"_26574":49037,"_2824":49345},[],"Note that:",{"_3337":591,"_29196":478,"_20242":49347,"_5":13829,"_26574":49037,"_2824":49348},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3337":592,"_29196":478,"_20242":49350,"_5":13829,"_26574":49037,"_2824":49351},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3337":593,"_29196":478,"_20242":49353,"_5":13829,"_26574":49037,"_2824":49354},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3337":594,"_29196":478,"_20242":49356,"_5":13829,"_26574":49041,"_2824":49357},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3337":595,"_29196":478,"_20242":49359,"_5":13829,"_26574":49041,"_2824":49360},[],"full and read-only access to certificates and authorities;",{"_3337":596,"_29196":478,"_20242":49362,"_5":13829,"_26574":49041,"_2824":49363},[],"full and read-only access to the KMS;",{"_3337":597,"_29196":478,"_20242":49365,"_5":13829,"_26574":49041,"_2824":49366},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3337":598,"_29196":478,"_20242":49368,"_5":13829,"_26574":49041,"_2824":49369},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3337":599,"_29196":478,"_20242":49371,"_5":13829,"_26574":49041,"_2824":49372},[],"console access;",{"_3337":600,"_29196":478,"_20242":49374,"_5":13829,"_26574":49041,"_2824":49375},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3337":601,"_29196":478,"_20242":49377,"_5":13829,"_26574":49041,"_2824":49378},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3337":602,"_29196":478,"_20242":49380,"_5":13829,"_26574":49041,"_2824":49381},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3337":603,"_29196":478,"_20242":49383,"_5":13829,"_26574":49045,"_2824":49384},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3337":604,"_29196":478,"_20242":49386,"_5":13829,"_26574":49045,"_2824":49387},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3337":605,"_29196":478,"_20242":49389,"_5":13829,"_26574":49045,"_2824":49390},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3337":606,"_29196":478,"_20242":49392,"_5":13829,"_26574":49048,"_2824":49393},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3337":607,"_29196":478,"_20242":49395,"_5":13829,"_26574":49052,"_2824":49396},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3337":608,"_29196":478,"_20242":49398,"_5":13829,"_26574":49052,"_2824":49399},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3337":609,"_29196":478,"_20242":49401,"_5":13829,"_26574":49056,"_2824":49402},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3337":610,"_29196":478,"_20242":49404,"_5":13829,"_26574":49060,"_2824":49405},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3337":611,"_29196":478,"_20242":49407,"_5":13829,"_26574":49064,"_2824":49408},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3337":612,"_29196":478,"_20242":49410,"_5":13829,"_26574":49068,"_2824":49411},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3337":613,"_29196":478,"_20242":49413,"_5":13829,"_26574":49068,"_2824":49414},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3337":614,"_29196":478,"_20242":49416,"_5":13829,"_26574":49072,"_2824":49417},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3337":615,"_29196":478,"_20242":49419,"_5":13829,"_26574":49072,"_2824":49420},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3337":616,"_29196":478,"_20242":49422,"_5":13829,"_26574":49072,"_2824":49423},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3337":617,"_29196":478,"_20242":49425,"_5":13829,"_26574":49072,"_2824":49426},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3337":618,"_29196":478,"_20242":49428,"_5":13829,"_26574":49072,"_2824":49429},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3337":619,"_29196":478,"_20242":49431,"_5":13829,"_26574":49072,"_2824":49432},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3337":620,"_29196":478,"_20242":49434,"_5":13829,"_26574":49072,"_2824":49435},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3337":621,"_29196":478,"_20242":49437,"_5":13829,"_26574":49072,"_2824":49438},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3337":622,"_29196":478,"_20242":49440,"_5":13829,"_26574":49076,"_2824":49441},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3337":623,"_29196":478,"_20242":49443,"_5":13829,"_26574":49076,"_2824":49444},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3337":624,"_29196":478,"_20242":49446,"_5":13829,"_26574":49076,"_2824":49447},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3337":625,"_29196":478,"_20242":49449,"_5":13829,"_26574":49080,"_2824":49450},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3337":626,"_29196":478,"_20242":49452,"_5":13829,"_26574":49080,"_2824":49453},[],"Use groups or stable roles for people and independent identities for automations.",{"_3337":627,"_29196":478,"_20242":49455,"_5":13829,"_26574":49080,"_2824":49456},[],"Keep at least two recovery administrators and test their access periodically.",{"_3337":628,"_29196":478,"_20242":49458,"_5":13829,"_26574":49080,"_2824":49459},[],"Review active principals, their matches and their grants after IdP changes.",{"_3337":629,"_29196":478,"_20242":49461,"_5":13829,"_26574":49080,"_2824":49462},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3337":630,"_29196":478,"_20242":49464,"_5":13829,"_26574":49080,"_2824":49465},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3337":631,"_29196":478,"_20242":49467,"_5":13829,"_26574":49080,"_2824":49468},[],"Always test one allowed and one denied operation for each role.",{"_3337":632,"_29196":478,"_20242":49470,"_5":13829,"_26574":49080,"_2824":49471},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3337":633,"_29196":478,"_20242":49473,"_5":13829,"_26574":49088,"_2824":49474},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3337":634,"_29196":478,"_20242":49476,"_5":13829,"_26574":49092,"_2824":49477},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3337":635,"_29196":478,"_20242":49479,"_5":13829,"_26574":49092,"_2824":49480},[],"that an active principal of the correct type exists;",{"_3337":636,"_29196":478,"_20242":49482,"_5":13829,"_26574":49092,"_2824":49483},[],"that the claim paths and values match the real token exactly;",{"_3337":637,"_29196":478,"_20242":49485,"_5":13829,"_26574":49092,"_2824":49486},[],"that all of the principal's conditions hold;",{"_3337":638,"_29196":478,"_20242":49488,"_5":13829,"_26574":49092,"_2824":49489},[],"that the principal has the expected policy granted;",{"_3337":639,"_29196":478,"_20242":49491,"_5":13829,"_26574":49092,"_2824":49492},[],"that the policy includes the action and the requested resource type or route;",{"_3337":640,"_29196":478,"_20242":49494,"_5":13829,"_26574":49092,"_2824":49495},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3337":641,"_29196":478,"_20242":49497,"_5":13829,"_26574":49092,"_2824":49498},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_3337":642,"_29196":478,"_20242":49500,"_5":13829,"_26574":49096,"_2824":49501},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3337":643,"_29196":478,"_20242":49503,"_5":13829,"_26574":49100,"_2824":49504},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3337":644,"_29196":478,"_20242":49506,"_5":13829,"_26574":49104,"_2824":49507},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3337":645,"_29196":478,"_20242":49509,"_5":13829,"_26574":49104,"_2824":49510},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3337":646,"_29196":646,"_5":14181,"_2824":49512,"_29540":49513,"_20242":49514,"_26574":646},"Alerts and subscriptions",[47528,48977,48978],[],{"_3337":647,"_29196":646,"_20242":49516,"_5":13829,"_26574":646,"_2824":49517},[],"Send PKI events to people and external systems.",{"_3337":648,"_29196":646,"_5":29537,"_20242":49519,"_26574":49520,"_2824":49521},[],"/docs/pr-preview/pr-57/platform/administration/alerts#how-it-works","How it works",{"_3337":649,"_29196":646,"_5":29537,"_20242":49523,"_26574":49524,"_2824":49525},[],"/docs/pr-preview/pr-57/platform/administration/alerts#available-channels","Available channels",{"_3337":650,"_29196":646,"_5":29537,"_20242":49527,"_26574":49528,"_2824":49529},[],"/docs/pr-preview/pr-57/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3337":651,"_29196":646,"_5":29537,"_20242":49531,"_26574":49532,"_2824":49533},[],"/docs/pr-preview/pr-57/platform/administration/alerts#choose-the-event","Choose the event",{"_3337":652,"_29196":646,"_5":29537,"_20242":49535,"_26574":49536,"_2824":49537},[],"/docs/pr-preview/pr-57/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3337":653,"_29196":646,"_5":29537,"_20242":49539,"_26574":49540,"_2824":49541},[],"/docs/pr-preview/pr-57/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3337":654,"_29196":646,"_5":29537,"_20242":49543,"_26574":49544,"_2824":49545},[],"/docs/pr-preview/pr-57/platform/administration/alerts#review-and-activate","Review and activate",{"_3337":655,"_29196":646,"_5":29537,"_20242":49547,"_26574":49548,"_2824":49549},[],"/docs/pr-preview/pr-57/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3337":656,"_29196":646,"_5":29537,"_20242":49551,"_26574":49552,"_2824":49553},[],"/docs/pr-preview/pr-57/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3337":657,"_29196":646,"_5":29537,"_20242":49555,"_26574":49556,"_2824":49557},[],"/docs/pr-preview/pr-57/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3337":658,"_29196":646,"_5":29537,"_20242":49559,"_26574":49560,"_2824":49561},[],"/docs/pr-preview/pr-57/platform/administration/alerts#event-families","Event families",{"_3337":659,"_29196":646,"_20242":49563,"_5":13829,"_26574":646,"_2824":49564},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3337":660,"_29196":646,"_20242":49566,"_5":13829,"_26574":49520,"_2824":49567},[],"A service publishes a domain event.",{"_3337":661,"_29196":646,"_20242":49569,"_5":13829,"_26574":49520,"_2824":49570},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3337":662,"_29196":646,"_20242":49572,"_5":13829,"_26574":49520,"_2824":49573},[],"Each subscription's filter decides whether it should be notified.",{"_3337":663,"_29196":646,"_20242":49575,"_5":13829,"_26574":49520,"_2824":49576},[],"Lamassu delivers the event to the configured channel.",{"_3337":664,"_29196":646,"_20242":49578,"_5":13829,"_26574":49520,"_2824":49579},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3337":665,"_29196":646,"_20242":49581,"_5":13829,"_26574":49524,"_2824":49582},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3337":666,"_29196":646,"_20242":49584,"_5":13829,"_26574":49524,"_2824":49585},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3337":667,"_29196":646,"_20242":49587,"_5":13829,"_26574":49524,"_2824":49588},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3337":668,"_29196":646,"_20242":49590,"_5":13829,"_26574":49524,"_2824":49591},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3337":669,"_29196":646,"_20242":49593,"_5":13829,"_26574":49524,"_2824":49594},[],"`apikey_options` requires `header` and `key`.",{"_3337":670,"_29196":646,"_20242":49596,"_5":13829,"_26574":49524,"_2824":49597},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3337":671,"_29196":646,"_20242":49599,"_5":13829,"_26574":49524,"_2824":49600},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3337":672,"_29196":646,"_20242":49602,"_5":13829,"_26574":49524,"_2824":49603},[],"The alerts API reference documents the full `http_client` schema.",{"_3337":673,"_29196":646,"_20242":49605,"_5":13829,"_26574":49532,"_2824":49606},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3337":674,"_29196":646,"_20242":49608,"_5":13829,"_26574":49536,"_2824":49609},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3337":675,"_29196":646,"_20242":49611,"_5":13829,"_26574":49540,"_2824":49612},[],"Add a filter if you don't want to receive every instance of the event.",{"_3337":676,"_29196":646,"_20242":49614,"_5":13829,"_26574":49540,"_2824":49615},[],"**None** notifies all instances of the event.",{"_3337":677,"_29196":646,"_20242":49617,"_5":13829,"_26574":49540,"_2824":49618},[],"**JSON Path** evaluates one or more specific fields.",{"_3337":678,"_29196":646,"_20242":49620,"_5":13829,"_26574":49540,"_2824":49621},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3337":679,"_29196":646,"_20242":49623,"_5":13829,"_26574":49540,"_2824":49624},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3337":680,"_29196":646,"_20242":49626,"_5":13829,"_26574":49540,"_2824":49627},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3337":681,"_29196":646,"_20242":49629,"_5":13829,"_26574":49544,"_2824":49630},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3337":682,"_29196":646,"_20242":49632,"_5":13829,"_26574":49548,"_2824":49633},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3337":683,"_29196":646,"_20242":49635,"_5":13829,"_26574":49548,"_2824":49636},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3337":684,"_29196":646,"_20242":49638,"_5":13829,"_26574":49548,"_2824":49639},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3337":685,"_29196":646,"_20242":49641,"_5":13829,"_26574":49548,"_2824":49642},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3337":686,"_29196":646,"_20242":49644,"_5":13829,"_26574":49548,"_2824":49645},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3337":687,"_29196":646,"_20242":49647,"_5":13829,"_26574":49548,"_2824":49648},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3337":688,"_29196":646,"_20242":49650,"_5":13829,"_26574":49548,"_2824":49651},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3337":689,"_29196":646,"_20242":49653,"_5":13829,"_26574":49548,"_2824":49654},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3337":690,"_29196":646,"_20242":49656,"_5":13829,"_26574":49552,"_2824":49657},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3337":691,"_29196":646,"_20242":49659,"_5":13829,"_26574":49552,"_2824":49660},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3337":692,"_29196":646,"_20242":49662,"_5":13829,"_26574":49552,"_2824":49663},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3337":693,"_29196":646,"_20242":49665,"_5":13829,"_26574":49552,"_2824":49666},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3337":694,"_29196":646,"_20242":49668,"_5":13829,"_26574":49552,"_2824":49669},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3337":695,"_29196":646,"_20242":49671,"_5":13829,"_26574":49552,"_2824":49672},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3337":696,"_29196":646,"_20242":49674,"_5":13829,"_26574":49552,"_2824":49675},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3337":697,"_29196":646,"_20242":49677,"_5":13829,"_26574":49552,"_2824":49678},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3337":698,"_29196":646,"_20242":49680,"_5":13829,"_26574":49556,"_2824":49681},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3337":699,"_29196":646,"_20242":49683,"_5":13829,"_26574":49556,"_2824":49684},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3337":700,"_29196":646,"_20242":49686,"_5":13829,"_26574":49560,"_2824":49687},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3337":701,"_29196":646,"_20242":49689,"_5":13829,"_26574":49560,"_2824":49690},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3337":702,"_29196":646,"_20242":49692,"_5":13829,"_26574":49560,"_2824":49693},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3337":703,"_29196":646,"_20242":49695,"_5":13829,"_26574":49560,"_2824":49696},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3337":704,"_29196":646,"_20242":49698,"_5":13829,"_26574":49560,"_2824":49699},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3337":705,"_29196":646,"_20242":49701,"_5":13829,"_26574":49560,"_2824":49702},[],"**Validation:** `va.role.crl.create`.",{"_3337":706,"_29196":646,"_20242":49704,"_5":13829,"_26574":49560,"_2824":49705},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3337":707,"_29196":646,"_20242":49707,"_5":13829,"_26574":49560,"_2824":49708},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3337":708,"_29196":708,"_5":14181,"_2824":49710,"_29540":49711,"_20242":49712,"_26574":708},"Audit logs",[47528,48977,48978],[],{"_3337":709,"_29196":708,"_20242":49714,"_5":13829,"_26574":708,"_2824":49715},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3337":710,"_29196":708,"_5":29537,"_20242":49717,"_26574":49718,"_2824":49719},[],"/docs/pr-preview/pr-57/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3337":711,"_29196":708,"_5":29537,"_20242":49721,"_26574":49722,"_2824":49723},[],"/docs/pr-preview/pr-57/platform/administration/audit-logs#coverage","Coverage",{"_3337":712,"_29196":708,"_5":29537,"_20242":49725,"_26574":49726,"_2824":49727},[],"/docs/pr-preview/pr-57/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3337":713,"_29196":708,"_5":29537,"_20242":49729,"_26574":49730,"_2824":49731},[],"/docs/pr-preview/pr-57/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3337":714,"_29196":708,"_5":29537,"_20242":49733,"_26574":49734,"_2824":49735},[],"/docs/pr-preview/pr-57/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3337":715,"_29196":708,"_5":29537,"_20242":49737,"_26574":49738,"_2824":49739},[],"/docs/pr-preview/pr-57/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3337":716,"_29196":708,"_5":29537,"_20242":49741,"_26574":49742,"_2824":49743},[],"/docs/pr-preview/pr-57/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3337":717,"_29196":708,"_5":29537,"_20242":49745,"_26574":49746,"_2824":49747},[],"/docs/pr-preview/pr-57/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3337":718,"_29196":708,"_5":29537,"_20242":49749,"_26574":49750,"_2824":49751},[],"/docs/pr-preview/pr-57/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3337":719,"_29196":708,"_5":29537,"_20242":49753,"_26574":49754,"_2824":49755},[],"/docs/pr-preview/pr-57/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3337":720,"_29196":708,"_5":29537,"_20242":49757,"_26574":49758,"_2824":49759},[],"/docs/pr-preview/pr-57/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3337":721,"_29196":708,"_20242":49761,"_5":13829,"_26574":708,"_2824":49762},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3337":722,"_29196":708,"_20242":49764,"_5":13829,"_26574":49718,"_2824":49765},[],"The audit body includes:",{"_3337":723,"_29196":708,"_20242":49767,"_5":13829,"_26574":49718,"_2824":49768},[],"input: data received by the operation;",{"_3337":724,"_29196":708,"_20242":49770,"_5":13829,"_26574":49718,"_2824":49771},[],"has\\_error: whether the service returned an error;",{"_3337":725,"_29196":708,"_20242":49773,"_5":13829,"_26574":49718,"_2824":49774},[],"output: produced result or error message;",{"_3337":726,"_29196":708,"_20242":49776,"_5":13829,"_26574":49718,"_2824":49777},[],"principals: identifiers of the principals that matched the request.",{"_3337":727,"_29196":708,"_20242":49779,"_5":13829,"_26574":49718,"_2824":49780},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3337":728,"_29196":708,"_20242":49782,"_5":13829,"_26574":49718,"_2824":49783},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3337":729,"_29196":708,"_20242":49785,"_5":13829,"_26574":49722,"_2824":49786},[],"The backend applies auditing to mutations of:",{"_3337":730,"_29196":708,"_20242":49788,"_5":13829,"_26574":49722,"_2824":49789},[],"authorities, certificates and issuance profiles;",{"_3337":731,"_29196":708,"_20242":49791,"_5":13829,"_26574":49722,"_2824":49792},[],"keys and KMS engines;",{"_3337":732,"_29196":708,"_20242":49794,"_5":13829,"_26574":49722,"_2824":49795},[],"devices and identities;",{"_3337":733,"_29196":708,"_20242":49797,"_5":13829,"_26574":49722,"_2824":49798},[],"DMSs and enrollment operations;",{"_3337":734,"_29196":708,"_20242":49800,"_5":13829,"_26574":49722,"_2824":49801},[],"validation functions and CRL;",{"_3337":735,"_29196":708,"_20242":49803,"_5":13829,"_26574":49722,"_2824":49804},[],"principals, policies and authorization grants.",{"_3337":736,"_29196":708,"_20242":49806,"_5":13829,"_26574":49722,"_2824":49807},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3337":737,"_29196":708,"_20242":49809,"_5":13829,"_26574":49726,"_2824":49810},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3337":738,"_29196":708,"_20242":49812,"_5":13829,"_26574":49726,"_2824":49813},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3337":739,"_29196":708,"_20242":49815,"_5":13829,"_26574":49726,"_2824":49816},[],"Design the consumer to:",{"_3337":740,"_29196":708,"_20242":49818,"_5":13829,"_26574":49726,"_2824":49819},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3337":741,"_29196":708,"_20242":49821,"_5":13829,"_26574":49726,"_2824":49822},[],"keep the complete CloudEvent unmodified;",{"_3337":742,"_29196":708,"_20242":49824,"_5":13829,"_26574":49726,"_2824":49825},[],"record the ingestion time and detect duplicates by ID;",{"_3337":743,"_29196":708,"_20242":49827,"_5":13829,"_26574":49726,"_2824":49828},[],"encrypt in transit and at rest;",{"_3337":744,"_29196":708,"_20242":49830,"_5":13829,"_26574":49726,"_2824":49831},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3337":745,"_29196":708,"_20242":49833,"_5":13829,"_26574":49726,"_2824":49834},[],"apply an explicit retention and legal hold policy;",{"_3337":746,"_29196":708,"_20242":49836,"_5":13829,"_26574":49726,"_2824":49837},[],"alert if it stops consuming or the pending queue grows.",{"_3337":747,"_29196":708,"_20242":49839,"_5":13829,"_26574":49730,"_2824":49840},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3337":748,"_29196":708,"_20242":49842,"_5":13829,"_26574":49730,"_2824":49843},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3337":749,"_29196":708,"_20242":49845,"_5":13829,"_26574":49738,"_2824":49846},[],"Start from the reported time and normalize every source to UTC.",{"_3337":750,"_29196":708,"_20242":49848,"_5":13829,"_26574":49742,"_2824":49849},[],"Filter by event type, service source and resource identifier.",{"_3337":751,"_29196":708,"_20242":49851,"_5":13829,"_26574":49746,"_2824":49852},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3337":752,"_29196":708,"_20242":49854,"_5":13829,"_26574":49750,"_2824":49855},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3337":753,"_29196":708,"_20242":49857,"_5":13829,"_26574":49754,"_2824":49858},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3337":754,"_29196":708,"_20242":49860,"_5":13829,"_26574":49758,"_2824":49861},[],"Generate a controlled mutation in a test environment and check that:",{"_3337":755,"_29196":708,"_20242":49863,"_5":13829,"_26574":49758,"_2824":49864},[],"a successful audit event appears;",{"_3337":756,"_29196":708,"_20242":49866,"_5":13829,"_26574":49758,"_2824":49867},[],"the principal matches the identity used;",{"_3337":757,"_29196":708,"_20242":49869,"_5":13829,"_26574":49758,"_2824":49870},[],"the consumer persists it exactly once;",{"_3337":758,"_29196":708,"_20242":49872,"_5":13829,"_26574":49758,"_2824":49873},[],"it can be retrieved by resource, actor and period;",{"_3337":759,"_29196":708,"_20242":49875,"_5":13829,"_26574":49758,"_2824":49876},[],"a consumer outage raises an alert.",{"_3337":760,"_29196":708,"_20242":49878,"_5":13829,"_26574":49758,"_2824":49879},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3337":761,"_29196":761,"_5":14181,"_2824":49881,"_29540":49882,"_20242":49883,"_26574":761},"Platform architecture",[47528,48977],[],{"_3337":762,"_29196":761,"_20242":49885,"_5":13829,"_26574":761,"_2824":49886},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3337":763,"_29196":761,"_5":29537,"_20242":49888,"_26574":49889,"_2824":49890},[],"/docs/pr-preview/pr-57/platform/concepts/architecture#control-plane","Control plane",{"_3337":764,"_29196":761,"_5":29537,"_20242":49892,"_26574":49893,"_2824":49894},[],"/docs/pr-preview/pr-57/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3337":765,"_29196":761,"_5":29537,"_20242":49896,"_26574":49897,"_2824":49898},[],"/docs/pr-preview/pr-57/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3337":766,"_29196":761,"_5":29537,"_20242":49900,"_26574":49901,"_2824":49902},[],"/docs/pr-preview/pr-57/platform/concepts/architecture#status-and-validation","Status and validation",{"_3337":767,"_29196":761,"_5":29537,"_20242":49904,"_26574":49905,"_2824":49906},[],"/docs/pr-preview/pr-57/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3337":768,"_29196":761,"_20242":49908,"_5":13829,"_26574":761,"_2824":49909},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3337":769,"_29196":761,"_20242":49911,"_5":13829,"_26574":761,"_2824":49912},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3337":770,"_29196":761,"_20242":49914,"_5":13829,"_26574":49889,"_2824":49915},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3337":771,"_29196":761,"_20242":49917,"_5":13829,"_26574":49893,"_2824":49918},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3337":772,"_29196":761,"_20242":49920,"_5":13829,"_26574":49897,"_2824":49921},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3337":773,"_29196":761,"_20242":49923,"_5":13829,"_26574":49901,"_2824":49924},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3337":774,"_29196":761,"_20242":49926,"_5":13829,"_26574":49905,"_2824":49927},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3337":775,"_29196":775,"_5":14181,"_2824":49929,"_29540":49930,"_20242":49931,"_26574":775},"How Lamassu works",[47528,48977],[],{"_3337":776,"_29196":775,"_20242":49933,"_5":13829,"_26574":775,"_2824":49934},[],"The mental model of trust, keys, certificates and devices.",{"_3337":777,"_29196":775,"_5":29537,"_20242":49936,"_26574":49937,"_2824":49938},[],"/docs/pr-preview/pr-57/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3337":778,"_29196":775,"_5":29537,"_20242":49940,"_26574":49941,"_2824":49942},[],"/docs/pr-preview/pr-57/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3337":779,"_29196":775,"_20242":49944,"_5":13829,"_26574":775,"_2824":49945},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3337":780,"_29196":775,"_20242":49947,"_5":13829,"_26574":49937,"_2824":49948},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3337":781,"_29196":775,"_20242":49950,"_5":13829,"_26574":49937,"_2824":49951},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3337":782,"_29196":775,"_20242":49953,"_5":13829,"_26574":49937,"_2824":49954},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3337":783,"_29196":775,"_20242":49956,"_5":13829,"_26574":49937,"_2824":49957},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3337":784,"_29196":775,"_20242":49959,"_5":13829,"_26574":49937,"_2824":49960},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3337":785,"_29196":775,"_20242":49962,"_5":13829,"_26574":49941,"_2824":49963},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3337":786,"_29196":775,"_20242":49965,"_5":13829,"_26574":49941,"_2824":49966},[],"A DMS relates that CA to an enrollment policy.",{"_3337":787,"_29196":775,"_20242":49968,"_5":13829,"_26574":49941,"_2824":49969},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3337":788,"_29196":775,"_20242":49971,"_5":13829,"_26574":49941,"_2824":49972},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3337":789,"_29196":775,"_20242":49974,"_5":13829,"_26574":49941,"_2824":49975},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3337":790,"_29196":775,"_20242":49977,"_5":13829,"_26574":49941,"_2824":49978},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3337":791,"_29196":775,"_20242":49980,"_5":13829,"_26574":49941,"_2824":49981},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3337":792,"_29196":792,"_5":14181,"_2824":49983,"_29540":49984,"_20242":49986,"_26574":792},"Devices and identities",[47528,48977,49985,49983],"IoT Fleets",[],{"_3337":793,"_29196":792,"_20242":49988,"_5":13829,"_26574":792,"_2824":49989},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3337":794,"_29196":792,"_5":29537,"_20242":49991,"_26574":49992,"_2824":49993},[],"/docs/pr-preview/pr-57/platform/iot-fleets/device-management#device-states","Device states",{"_3337":795,"_29196":792,"_5":29537,"_20242":49995,"_26574":49996,"_2824":49997},[],"/docs/pr-preview/pr-57/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3337":796,"_29196":792,"_5":29537,"_20242":49999,"_26574":50000,"_2824":50001},[],"/docs/pr-preview/pr-57/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3337":797,"_29196":792,"_5":29537,"_20242":50003,"_26574":50004,"_2824":50005},[],"/docs/pr-preview/pr-57/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3337":798,"_29196":792,"_5":29537,"_20242":50007,"_26574":50008,"_2824":50009},[],"/docs/pr-preview/pr-57/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3337":799,"_29196":792,"_5":29537,"_20242":50011,"_26574":50012,"_2824":50013},[],"/docs/pr-preview/pr-57/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3337":800,"_29196":792,"_5":29537,"_20242":50015,"_26574":50016,"_2824":50017},[],"/docs/pr-preview/pr-57/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3337":801,"_29196":792,"_5":29537,"_20242":50019,"_26574":50020,"_2824":50021},[],"/docs/pr-preview/pr-57/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3337":802,"_29196":792,"_5":29537,"_20242":50023,"_26574":50024,"_2824":50025},[],"/docs/pr-preview/pr-57/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3337":803,"_29196":792,"_5":29537,"_20242":50027,"_26574":50028,"_2824":50029},[],"/docs/pr-preview/pr-57/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3337":804,"_29196":792,"_5":29537,"_20242":50031,"_26574":50032,"_2824":50033},[],"/docs/pr-preview/pr-57/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3337":805,"_29196":792,"_20242":50035,"_5":13829,"_26574":792,"_2824":50036},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3337":806,"_29196":792,"_20242":50038,"_5":13829,"_26574":792,"_2824":50039},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3337":807,"_29196":792,"_20242":50041,"_5":13829,"_26574":49992,"_2824":50042},[],"Operational view",{"_3337":808,"_29196":792,"_20242":50044,"_5":13829,"_26574":49992,"_2824":50045},[],"Meaning",{"_3337":809,"_29196":792,"_20242":50047,"_5":13829,"_26574":49992,"_2824":50048},[],"**No Identity**",{"_3337":810,"_29196":792,"_20242":50050,"_5":13829,"_26574":49992,"_2824":50051},[],"A record exists without an associated identity.",{"_3337":811,"_29196":792,"_20242":50053,"_5":13829,"_26574":49992,"_2824":50054},[],"**Active**",{"_3337":812,"_29196":792,"_20242":50056,"_5":13829,"_26574":49992,"_2824":50057},[],"The slot is active; also check certificate dates, status and usages.",{"_3337":813,"_29196":792,"_20242":50059,"_5":13829,"_26574":49992,"_2824":50060},[],"**Renewal Pending**",{"_3337":814,"_29196":792,"_20242":50062,"_5":13829,"_26574":49992,"_2824":50063},[],"The identity is in the operational renewal window.",{"_3337":815,"_29196":792,"_20242":50065,"_5":13829,"_26574":49992,"_2824":50066},[],"**Expiring Soon**",{"_3337":816,"_29196":792,"_20242":50068,"_5":13829,"_26574":49992,"_2824":50069},[],"Expiration is approaching according to configured thresholds.",{"_3337":817,"_29196":792,"_20242":50071,"_5":13829,"_26574":49992,"_2824":50072},[],"**Expired**",{"_3337":818,"_29196":792,"_20242":50074,"_5":13829,"_26574":49992,"_2824":50075},[],"The identity has expired.",{"_3337":819,"_29196":792,"_20242":50077,"_5":13829,"_26574":49992,"_2824":50078},[],"**Revoked**",{"_3337":820,"_29196":792,"_20242":50080,"_5":13829,"_26574":49992,"_2824":50081},[],"The identity is marked revoked.",{"_3337":821,"_29196":792,"_20242":50083,"_5":13829,"_26574":49992,"_2824":50084},[],"**Decommissioned**",{"_3337":822,"_29196":792,"_20242":50086,"_5":13829,"_26574":49992,"_2824":50087},[],"The record is retired and ordinary updates do not restore operation.",{"_3337":823,"_29196":792,"_20242":50089,"_5":13829,"_26574":49992,"_2824":50090},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3337":824,"_29196":792,"_20242":50092,"_5":13829,"_26574":49996,"_2824":50093},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3337":825,"_29196":792,"_20242":50095,"_5":13829,"_26574":49996,"_2824":50096},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3337":826,"_29196":792,"_20242":50098,"_5":13829,"_26574":49996,"_2824":50099},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3337":827,"_29196":792,"_20242":50101,"_5":13829,"_26574":49996,"_2824":50102},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3337":828,"_29196":792,"_20242":50104,"_5":13829,"_26574":50000,"_2824":50105},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3337":829,"_29196":792,"_20242":50107,"_5":13829,"_26574":50004,"_2824":50108},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3337":830,"_29196":792,"_20242":50110,"_5":13829,"_26574":50008,"_2824":50111},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3337":831,"_29196":792,"_20242":50113,"_5":13829,"_26574":50012,"_2824":50114},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3337":832,"_29196":792,"_20242":50116,"_5":13829,"_26574":50016,"_2824":50117},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3337":833,"_29196":792,"_20242":50119,"_5":13829,"_26574":50016,"_2824":50120},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3337":834,"_29196":792,"_20242":50122,"_5":13829,"_26574":50020,"_2824":50123},[],"From **No Identity**, use **Assign Identity**:",{"_3337":835,"_29196":792,"_20242":50125,"_5":13829,"_26574":50020,"_2824":50126},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3337":836,"_29196":792,"_20242":50128,"_5":13829,"_26574":50020,"_2824":50129},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3337":837,"_29196":792,"_20242":50131,"_5":13829,"_26574":50020,"_2824":50132},[],"Confirm and read the serial, active version and history again.",{"_3337":838,"_29196":792,"_20242":50134,"_5":13829,"_26574":50020,"_2824":50135},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3337":839,"_29196":792,"_20242":50137,"_5":13829,"_26574":50020,"_2824":50138},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3337":840,"_29196":792,"_20242":50140,"_5":13829,"_26574":50024,"_2824":50141},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3337":841,"_29196":792,"_20242":50143,"_5":13829,"_26574":50024,"_2824":50144},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3337":842,"_29196":792,"_20242":50146,"_5":13829,"_26574":50028,"_2824":50147},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3337":843,"_29196":792,"_20242":50149,"_5":13829,"_26574":50028,"_2824":50150},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3337":844,"_29196":792,"_20242":50152,"_5":13829,"_26574":50028,"_2824":50153},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3337":845,"_29196":792,"_20242":50155,"_5":13829,"_26574":50028,"_2824":50156},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3337":846,"_29196":792,"_20242":50158,"_5":13829,"_26574":50032,"_2824":50159},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3337":847,"_29196":792,"_20242":50161,"_5":13829,"_26574":50032,"_2824":50162},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3337":848,"_29196":848,"_5":14181,"_2824":50164,"_29540":50165,"_20242":50167,"_26574":848},"Bootstrap identity and authentication",[47528,48977,49985,49983,50166],"Enrollment with PKI",[],{"_3337":849,"_29196":848,"_20242":50169,"_5":13829,"_26574":848,"_2824":50170},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3337":850,"_29196":848,"_5":29537,"_20242":50172,"_26574":50173,"_2824":50174},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3337":851,"_29196":848,"_5":29537,"_20242":50176,"_26574":50177,"_2824":50178},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3337":852,"_29196":848,"_5":29537,"_20242":50180,"_26574":50181,"_2824":50182},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3337":853,"_29196":848,"_5":29537,"_20242":50184,"_26574":50185,"_2824":50186},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3337":854,"_29196":848,"_5":29537,"_20242":50188,"_26574":50189,"_2824":50190},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3337":855,"_29196":848,"_20242":50192,"_5":13829,"_26574":848,"_2824":50193},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3337":856,"_29196":848,"_20242":50195,"_5":13829,"_26574":50173,"_2824":50196},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3337":857,"_29196":848,"_20242":50198,"_5":13829,"_26574":50173,"_2824":50199},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3337":858,"_29196":848,"_20242":50201,"_5":13829,"_26574":50177,"_2824":50202},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3337":859,"_29196":848,"_20242":50204,"_5":13829,"_26574":50177,"_2824":50205},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3337":860,"_29196":848,"_20242":50207,"_5":13829,"_26574":50177,"_2824":50208},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3337":861,"_29196":848,"_20242":50210,"_5":13829,"_26574":50181,"_2824":50211},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3337":862,"_29196":848,"_20242":50213,"_5":13829,"_26574":50181,"_2824":50214},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3337":863,"_29196":848,"_20242":50216,"_5":13829,"_26574":50185,"_2824":50217},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3337":864,"_29196":848,"_20242":50219,"_5":13829,"_26574":50185,"_2824":50220},[],"Example body:",{"_3337":865,"_29196":848,"_20242":50222,"_5":13829,"_26574":50185,"_2824":50223},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3337":866,"_29196":848,"_20242":50225,"_5":13829,"_26574":50185,"_2824":50226},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3337":867,"_29196":848,"_20242":50228,"_5":13829,"_26574":50185,"_2824":50229},[],"Continuation requires a successful HTTP response and JSON:",{"_3337":868,"_29196":848,"_20242":50231,"_5":13829,"_26574":50185,"_2824":50232},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3337":869,"_29196":848,"_20242":50234,"_5":13829,"_26574":50189,"_2824":50235},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3337":870,"_29196":848,"_20242":50237,"_5":13829,"_26574":50189,"_2824":50238},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3337":871,"_29196":871,"_5":14181,"_2824":50240,"_29540":50241,"_20242":50242,"_26574":871},"Configure and operate the DMS",[47528,48977,49985,49983,50166],[],{"_3337":872,"_29196":871,"_20242":50244,"_5":13829,"_26574":871,"_2824":50245},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3337":873,"_29196":871,"_5":29537,"_20242":50247,"_26574":50248,"_2824":47538},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3337":874,"_29196":871,"_5":29537,"_20242":50250,"_26574":50251,"_2824":50252},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3337":875,"_29196":871,"_5":29537,"_20242":50254,"_26574":50255,"_2824":50256},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3337":876,"_29196":871,"_5":29537,"_20242":50258,"_26574":50259,"_2824":50260},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3337":877,"_29196":871,"_5":29537,"_20242":50262,"_26574":50263,"_2824":50264},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3337":878,"_29196":871,"_5":29537,"_20242":50266,"_26574":50267,"_2824":50268},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3337":879,"_29196":871,"_5":29537,"_20242":50270,"_26574":50271,"_2824":50272},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3337":880,"_29196":871,"_5":29537,"_20242":50274,"_26574":50275,"_2824":50276},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3337":881,"_29196":871,"_5":29537,"_20242":50278,"_26574":50279,"_2824":50280},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3337":882,"_29196":871,"_5":29537,"_20242":50282,"_26574":50283,"_2824":50284},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3337":883,"_29196":871,"_5":29537,"_20242":50286,"_26574":50287,"_2824":50288},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3337":884,"_29196":871,"_5":29537,"_20242":50290,"_26574":50291,"_2824":50292},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3337":885,"_29196":871,"_5":29537,"_20242":50294,"_26574":50295,"_2824":50296},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3337":886,"_29196":871,"_5":29537,"_20242":50298,"_26574":50299,"_2824":50300},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3337":887,"_29196":871,"_5":29537,"_20242":50302,"_26574":50303,"_2824":50304},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3337":888,"_29196":871,"_5":29537,"_20242":50306,"_26574":50307,"_2824":50308},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3337":889,"_29196":871,"_5":29537,"_20242":50310,"_26574":50311,"_2824":50312},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3337":890,"_29196":871,"_5":29537,"_20242":50314,"_26574":50315,"_2824":50316},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3337":891,"_29196":871,"_20242":50318,"_5":13829,"_26574":871,"_2824":50319},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3337":892,"_29196":871,"_20242":50321,"_5":13829,"_26574":50248,"_2824":50322},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3337":893,"_29196":871,"_20242":50324,"_5":13829,"_26574":50248,"_2824":50325},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3337":894,"_29196":871,"_20242":50327,"_5":13829,"_26574":50255,"_2824":50328},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3337":895,"_29196":871,"_20242":50330,"_5":13829,"_26574":50259,"_2824":50331},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3337":896,"_29196":871,"_20242":50333,"_5":13829,"_26574":50263,"_2824":50334},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3337":897,"_29196":871,"_20242":50336,"_5":13829,"_26574":50267,"_2824":50337},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3337":898,"_29196":871,"_20242":50339,"_5":13829,"_26574":50271,"_2824":50340},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3337":899,"_29196":871,"_20242":50342,"_5":13829,"_26574":50279,"_2824":50343},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3337":900,"_29196":871,"_20242":50345,"_5":13829,"_26574":50279,"_2824":50346},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3337":901,"_29196":871,"_20242":50348,"_5":13829,"_26574":50283,"_2824":50349},[],"`settings.enrollment_settings` field",{"_3337":902,"_29196":871,"_20242":50351,"_5":13829,"_26574":50283,"_2824":50352},[],"Decision",{"_3337":903,"_29196":871,"_20242":50354,"_5":13829,"_26574":50283,"_2824":50355},[],"`protocol`",{"_3337":904,"_29196":871,"_20242":50357,"_5":13829,"_26574":50283,"_2824":50358},[],"`EST_RFC7030` for these operations.",{"_3337":905,"_29196":871,"_20242":50360,"_5":13829,"_26574":50283,"_2824":50361},[],"`enrollment_ca`",{"_3337":906,"_29196":871,"_20242":50363,"_5":13829,"_26574":50283,"_2824":50364},[],"ID of the signing CA.",{"_3337":907,"_29196":871,"_20242":50366,"_5":13829,"_26574":50283,"_2824":50367},[],"`verify_csr_signature`",{"_3337":908,"_29196":871,"_20242":50369,"_5":13829,"_26574":50283,"_2824":50370},[],"Keep `true` to verify CSR key possession.",{"_3337":909,"_29196":871,"_20242":50372,"_5":13829,"_26574":50283,"_2824":50373},[],"`enable_replaceable_enrollment`",{"_3337":910,"_29196":871,"_20242":50375,"_5":13829,"_26574":50283,"_2824":50376},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3337":911,"_29196":871,"_20242":50378,"_5":13829,"_26574":50283,"_2824":50379},[],"`est_rfc7030_settings.auth_mode`",{"_3337":912,"_29196":871,"_20242":50381,"_5":13829,"_26574":50283,"_2824":50382},[],"One of the four authentication modes.",{"_3337":913,"_29196":871,"_20242":50384,"_5":13829,"_26574":50283,"_2824":50385},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3337":914,"_29196":871,"_20242":50387,"_5":13829,"_26574":50287,"_2824":50388},[],"The blocks are independent:",{"_3337":915,"_29196":871,"_20242":50390,"_5":13829,"_26574":50287,"_2824":50391},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3337":916,"_29196":871,"_20242":50393,"_5":13829,"_26574":50287,"_2824":50394},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3337":917,"_29196":871,"_20242":50396,"_5":13829,"_26574":50287,"_2824":50397},[],"`auth_mode`",{"_3337":918,"_29196":871,"_20242":50399,"_5":13829,"_26574":50287,"_2824":50400},[],"Control applied in the configured operation",{"_3337":919,"_29196":871,"_20242":50402,"_5":13829,"_26574":50287,"_2824":50403},[],"`CLIENT_CERTIFICATE`",{"_3337":920,"_29196":871,"_20242":50405,"_5":13829,"_26574":50287,"_2824":50406},[],"Presented certificate validation.",{"_3337":921,"_29196":871,"_20242":50408,"_5":13829,"_26574":50287,"_2824":50409},[],"`EXTERNAL_WEBHOOK`",{"_3337":922,"_29196":871,"_20242":50411,"_5":13829,"_26574":50287,"_2824":50412},[],"Configured webhook authorization.",{"_3337":923,"_29196":871,"_20242":50414,"_5":13829,"_26574":50287,"_2824":50415},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3337":924,"_29196":871,"_20242":50417,"_5":13829,"_26574":50287,"_2824":50418},[],"Certificate validation followed by webhook approval.",{"_3337":925,"_29196":871,"_20242":50420,"_5":13829,"_26574":50287,"_2824":50421},[],"`NO_AUTH`",{"_3337":926,"_29196":871,"_20242":50423,"_5":13829,"_26574":50287,"_2824":50424},[],"No DMS requester authentication.",{"_3337":927,"_29196":871,"_20242":50426,"_5":13829,"_26574":50287,"_2824":50427},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3337":928,"_29196":871,"_20242":50429,"_5":13829,"_26574":50287,"_2824":50430},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3337":929,"_29196":871,"_20242":50432,"_5":13829,"_26574":50287,"_2824":50433},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3337":930,"_29196":871,"_20242":50435,"_5":13829,"_26574":50287,"_2824":50436},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3337":931,"_29196":871,"_20242":50438,"_5":13829,"_26574":50291,"_2824":50439},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3337":932,"_29196":871,"_20242":50441,"_5":13829,"_26574":50291,"_2824":50442},[],"`external_webhook_settings` field",{"_3337":933,"_29196":871,"_20242":50444,"_5":13829,"_26574":50291,"_2824":50352},[],{"_3337":934,"_29196":871,"_20242":50446,"_5":13829,"_26574":50291,"_2824":50447},[],"`url`",{"_3337":935,"_29196":871,"_20242":50449,"_5":13829,"_26574":50291,"_2824":50450},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3337":936,"_29196":871,"_20242":50452,"_5":13829,"_26574":50291,"_2824":50453},[],"`method`",{"_3337":937,"_29196":871,"_20242":50455,"_5":13829,"_26574":50291,"_2824":50456},[],"`POST` or `PUT`; `POST` by default.",{"_3337":938,"_29196":871,"_20242":50458,"_5":13829,"_26574":50291,"_2824":50459},[],"`name`",{"_3337":939,"_29196":871,"_20242":50461,"_5":13829,"_26574":50291,"_2824":50462},[],"Label used in service logs.",{"_3337":940,"_29196":871,"_20242":50464,"_5":13829,"_26574":50291,"_2824":50465},[],"`config.auth_mode`",{"_3337":941,"_29196":871,"_20242":50467,"_5":13829,"_26574":50291,"_2824":50468},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3337":942,"_29196":871,"_20242":50470,"_5":13829,"_26574":50291,"_2824":50471},[],"`config.log_level`",{"_3337":943,"_29196":871,"_20242":50473,"_5":13829,"_26574":50291,"_2824":50474},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3337":944,"_29196":871,"_20242":50476,"_5":13829,"_26574":50291,"_2824":50477},[],"`config.apikey_options`",{"_3337":945,"_29196":871,"_20242":50479,"_5":13829,"_26574":50291,"_2824":50480},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3337":946,"_29196":871,"_20242":50482,"_5":13829,"_26574":50291,"_2824":50483},[],"`config.jwt_options`",{"_3337":947,"_29196":871,"_20242":50485,"_5":13829,"_26574":50291,"_2824":50486},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3337":948,"_29196":871,"_20242":50488,"_5":13829,"_26574":50291,"_2824":50489},[],"`config.mtls_options`",{"_3337":949,"_29196":871,"_20242":50491,"_5":13829,"_26574":50291,"_2824":50492},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3337":950,"_29196":871,"_20242":50494,"_5":13829,"_26574":50291,"_2824":50495},[],"`config.insecure_skip_verify`",{"_3337":951,"_29196":871,"_20242":50497,"_5":13829,"_26574":50291,"_2824":50498},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3337":952,"_29196":871,"_20242":50500,"_5":13829,"_26574":50291,"_2824":50501},[],"`config.call_timeout`",{"_3337":953,"_29196":871,"_20242":50503,"_5":13829,"_26574":50291,"_2824":50504},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3337":954,"_29196":871,"_20242":50506,"_5":13829,"_26574":50291,"_2824":50507},[],"Rules for that configuration:",{"_3337":955,"_29196":871,"_20242":50509,"_5":13829,"_26574":50291,"_2824":50510},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3337":956,"_29196":871,"_20242":50512,"_5":13829,"_26574":50291,"_2824":50513},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3337":957,"_29196":871,"_20242":50515,"_5":13829,"_26574":50291,"_2824":50516},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3337":958,"_29196":871,"_20242":50518,"_5":13829,"_26574":50291,"_2824":50519},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3337":959,"_29196":871,"_20242":50521,"_5":13829,"_26574":50291,"_2824":50522},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3337":960,"_29196":871,"_20242":50524,"_5":13829,"_26574":50291,"_2824":50525},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3337":961,"_29196":871,"_20242":50527,"_5":13829,"_26574":50291,"_2824":50528},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3337":962,"_29196":871,"_20242":50530,"_5":13829,"_26574":50291,"_2824":50531},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3337":963,"_29196":871,"_20242":50533,"_5":13829,"_26574":50291,"_2824":50534},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3337":964,"_29196":871,"_20242":50536,"_5":13829,"_26574":50295,"_2824":50537},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3337":965,"_29196":871,"_20242":50539,"_5":13829,"_26574":50299,"_2824":50540},[],"`settings.reenrollment_settings` field",{"_3337":966,"_29196":871,"_20242":50542,"_5":13829,"_26574":50299,"_2824":47918},[],{"_3337":967,"_29196":871,"_20242":50544,"_5":13829,"_26574":50299,"_2824":50545},[],"`reenrollment_delta`",{"_3337":968,"_29196":871,"_20242":50547,"_5":13829,"_26574":50299,"_2824":50548},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3337":969,"_29196":871,"_20242":50550,"_5":13829,"_26574":50299,"_2824":50551},[],"`preventive_delta`",{"_3337":970,"_29196":871,"_20242":50553,"_5":13829,"_26574":50299,"_2824":50554},[],"Preventive operational monitoring threshold.",{"_3337":971,"_29196":871,"_20242":50556,"_5":13829,"_26574":50299,"_2824":50557},[],"`critical_delta`",{"_3337":972,"_29196":871,"_20242":50559,"_5":13829,"_26574":50299,"_2824":50560},[],"Critical operational monitoring threshold.",{"_3337":973,"_29196":871,"_20242":50562,"_5":13829,"_26574":50299,"_2824":50563},[],"`enable_expired_renewal`",{"_3337":974,"_29196":871,"_20242":50565,"_5":13829,"_26574":50299,"_2824":50566},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3337":975,"_29196":871,"_20242":50568,"_5":13829,"_26574":50299,"_2824":50569},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3337":976,"_29196":871,"_20242":50571,"_5":13829,"_26574":50299,"_2824":50572},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3337":977,"_29196":871,"_20242":50574,"_5":13829,"_26574":50299,"_2824":50575},[],"`revoke_on_reenrollment`",{"_3337":978,"_29196":871,"_20242":50577,"_5":13829,"_26574":50299,"_2824":50578},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3337":979,"_29196":871,"_20242":50580,"_5":13829,"_26574":50299,"_2824":50581},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3337":980,"_29196":871,"_20242":50583,"_5":13829,"_26574":50303,"_2824":50584},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3337":981,"_29196":871,"_20242":50586,"_5":13829,"_26574":50307,"_2824":47912},[],{"_3337":982,"_29196":871,"_20242":50588,"_5":13829,"_26574":50307,"_2824":50589},[],"Published material",{"_3337":983,"_29196":871,"_20242":50591,"_5":13829,"_26574":50307,"_2824":50592},[],"**Include Lamassu System CA**",{"_3337":984,"_29196":871,"_20242":50594,"_5":13829,"_26574":50307,"_2824":50595},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3337":985,"_29196":871,"_20242":50597,"_5":13829,"_26574":50307,"_2824":50598},[],"**Include Enrollment CA**",{"_3337":986,"_29196":871,"_20242":50600,"_5":13829,"_26574":50307,"_2824":50601},[],"Selected issuing CA certificate.",{"_3337":987,"_29196":871,"_20242":50603,"_5":13829,"_26574":50307,"_2824":50604},[],"**Managed CAs**",{"_3337":988,"_29196":871,"_20242":50606,"_5":13829,"_26574":50307,"_2824":50607},[],"Explicitly selected CA certificates.",{"_3337":989,"_29196":871,"_20242":50609,"_5":13829,"_26574":50307,"_2824":50610},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3337":990,"_29196":871,"_20242":50612,"_5":13829,"_26574":50311,"_2824":50613},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3337":991,"_29196":871,"_20242":50615,"_5":13829,"_26574":50311,"_2824":50616},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3337":992,"_29196":871,"_20242":50618,"_5":13829,"_26574":50311,"_2824":50619},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3337":993,"_29196":871,"_20242":50621,"_5":13829,"_26574":50315,"_2824":50622},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3337":994,"_29196":994,"_5":14181,"_2824":50624,"_29540":50625,"_20242":50626,"_26574":994},"Integrate the EST client",[47528,48977,49985,49983,50166],[],{"_3337":995,"_29196":994,"_20242":50628,"_5":13829,"_26574":994,"_2824":50629},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3337":996,"_29196":994,"_5":29537,"_20242":50631,"_26574":50632,"_2824":47538},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3337":997,"_29196":994,"_5":29537,"_20242":50634,"_26574":50635,"_2824":50636},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3337":998,"_29196":994,"_5":29537,"_20242":50638,"_26574":50639,"_2824":50640},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3337":999,"_29196":994,"_5":29537,"_20242":50642,"_26574":50643,"_2824":50644},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3337":1000,"_29196":994,"_5":29537,"_20242":50646,"_26574":50647,"_2824":50648},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3337":1001,"_29196":994,"_5":29537,"_20242":50650,"_26574":50651,"_2824":50652},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3337":1002,"_29196":994,"_20242":50654,"_5":13829,"_26574":994,"_2824":50655},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3337":1003,"_29196":994,"_20242":50657,"_5":13829,"_26574":50632,"_2824":50658},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3337":1004,"_29196":994,"_20242":50660,"_5":13829,"_26574":50632,"_2824":50661},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3337":1005,"_29196":994,"_20242":50663,"_5":13829,"_26574":50632,"_2824":50664},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3337":1006,"_29196":994,"_20242":50666,"_5":13829,"_26574":50635,"_2824":50667},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3337":1007,"_29196":994,"_20242":50669,"_5":13829,"_26574":50635,"_2824":50670},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3337":1008,"_29196":994,"_20242":50672,"_5":13829,"_26574":50639,"_2824":50673},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3337":1009,"_29196":994,"_20242":50675,"_5":13829,"_26574":50639,"_2824":50676},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3337":1010,"_29196":994,"_20242":50678,"_5":13829,"_26574":50643,"_2824":50679},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3337":1011,"_29196":994,"_20242":50681,"_5":13829,"_26574":50643,"_2824":50682},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3337":1012,"_29196":994,"_20242":50684,"_5":13829,"_26574":50647,"_2824":50685},[],"For a root that issues directly:",{"_3337":1013,"_29196":994,"_20242":50687,"_5":13829,"_26574":50647,"_2824":50688},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3337":1014,"_29196":994,"_20242":50690,"_5":13829,"_26574":50647,"_2824":50691},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3337":1015,"_29196":994,"_20242":50693,"_5":13829,"_26574":50651,"_2824":50694},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3337":1016,"_29196":1016,"_5":14181,"_2824":50696,"_29540":50697,"_20242":50698,"_26574":1016},"EST reference",[47528,48977,49985,49983,50166],[],{"_3337":1017,"_29196":1016,"_20242":50700,"_5":13829,"_26574":1016,"_2824":50701},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3337":1018,"_29196":1016,"_5":29537,"_20242":50703,"_26574":50704,"_2824":50705},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3337":1019,"_29196":1016,"_5":29537,"_20242":50707,"_26574":50708,"_2824":21955},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3337":1020,"_29196":1016,"_5":29537,"_20242":50710,"_26574":50711,"_2824":25204},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3337":1021,"_29196":1016,"_5":29537,"_20242":50713,"_26574":50714,"_2824":25211},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3337":1022,"_29196":1016,"_5":29537,"_20242":50716,"_26574":50717,"_2824":24539},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3337":1023,"_29196":1016,"_5":29537,"_20242":50719,"_26574":50720,"_2824":50721},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3337":1024,"_29196":1016,"_5":29537,"_20242":50723,"_26574":50724,"_2824":50725},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3337":1025,"_29196":1016,"_5":29537,"_20242":50727,"_26574":50728,"_2824":50729},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3337":1026,"_29196":1016,"_20242":50731,"_5":13829,"_26574":1016,"_2824":50732},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3337":1027,"_29196":1016,"_20242":50734,"_5":13829,"_26574":50704,"_2824":50735},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3337":1028,"_29196":1016,"_20242":50737,"_5":13829,"_26574":50704,"_2824":50738},[],"Operation",{"_3337":1029,"_29196":1016,"_20242":50740,"_5":13829,"_26574":50704,"_2824":50741},[],"Method",{"_3337":1030,"_29196":1016,"_20242":50743,"_5":13829,"_26574":50704,"_2824":50744},[],"Authentication and condition",{"_3337":1031,"_29196":1016,"_20242":50746,"_5":13829,"_26574":50704,"_2824":50747},[],"`/cacerts`",{"_3337":1032,"_29196":1016,"_20242":50749,"_5":13829,"_26574":50704,"_2824":50750},[],"GET",{"_3337":1033,"_29196":1016,"_20242":50752,"_5":13829,"_26574":50704,"_2824":50753},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3337":1034,"_29196":1016,"_20242":50755,"_5":13829,"_26574":50704,"_2824":50756},[],"`/simpleenroll`",{"_3337":1035,"_29196":1016,"_20242":50758,"_5":13829,"_26574":50704,"_2824":50759},[],"POST",{"_3337":1036,"_29196":1016,"_20242":50761,"_5":13829,"_26574":50704,"_2824":50762},[],"Initial authentication and DMS registration/replacement policy.",{"_3337":1037,"_29196":1016,"_20242":50764,"_5":13829,"_26574":50704,"_2824":50765},[],"`/simplereenroll`",{"_3337":1038,"_29196":1016,"_20242":50767,"_5":13829,"_26574":50704,"_2824":50759},[],{"_3337":1039,"_29196":1016,"_20242":50769,"_5":13829,"_26574":50704,"_2824":50770},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3337":1040,"_29196":1016,"_20242":50772,"_5":13829,"_26574":50704,"_2824":50773},[],"`/serverkeygen`",{"_3337":1041,"_29196":1016,"_20242":50775,"_5":13829,"_26574":50704,"_2824":50759},[],{"_3337":1042,"_29196":1016,"_20242":50777,"_5":13829,"_26574":50704,"_2824":50778},[],"Initial authentication and admission; server generation enabled.",{"_3337":1043,"_29196":1016,"_20242":50780,"_5":13829,"_26574":50704,"_2824":50781},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3337":1044,"_29196":1016,"_20242":50783,"_5":13829,"_26574":50708,"_2824":50784},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3337":1045,"_29196":1016,"_20242":50786,"_5":13829,"_26574":50708,"_2824":50787},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3337":1046,"_29196":1016,"_20242":50789,"_5":13829,"_26574":50711,"_2824":50790},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3337":1047,"_29196":1016,"_20242":50792,"_5":13829,"_26574":50711,"_2824":50793},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3337":1048,"_29196":1016,"_20242":50795,"_5":13829,"_26574":50714,"_2824":50796},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3337":1049,"_29196":1016,"_20242":50798,"_5":13829,"_26574":50714,"_2824":50799},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3337":1050,"_29196":1016,"_20242":50801,"_5":13829,"_26574":50717,"_2824":50802},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3337":1051,"_29196":1016,"_20242":50804,"_5":13829,"_26574":50717,"_2824":50805},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3337":1052,"_29196":1016,"_20242":50807,"_5":13829,"_26574":50720,"_2824":50808},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3337":1053,"_29196":1016,"_20242":50810,"_5":13829,"_26574":50720,"_2824":50811},[],"Part",{"_3337":1054,"_29196":1016,"_20242":50813,"_5":13829,"_26574":50720,"_2824":50814},[],"Content after decoding its Base64",{"_3337":1055,"_29196":1016,"_20242":50816,"_5":13829,"_26574":50720,"_2824":50817},[],"`application/pkcs8`",{"_3337":1056,"_29196":1016,"_20242":50819,"_5":13829,"_26574":50720,"_2824":50820},[],"Unencrypted DER PKCS#8 private key.",{"_3337":1057,"_29196":1016,"_20242":50822,"_5":13829,"_26574":50720,"_2824":50823},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3337":1058,"_29196":1016,"_20242":50825,"_5":13829,"_26574":50720,"_2824":50826},[],"DER PKCS#7 containing the issued certificate.",{"_3337":1059,"_29196":1016,"_20242":50828,"_5":13829,"_26574":50720,"_2824":50829},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3337":1060,"_29196":1016,"_20242":50831,"_5":13829,"_26574":50724,"_2824":50832},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3337":1061,"_29196":1016,"_20242":50834,"_5":13829,"_26574":50724,"_2824":50835},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3337":1062,"_29196":1016,"_20242":50837,"_5":13829,"_26574":50724,"_2824":50838},[],"Convert and check the result:",{"_3337":1063,"_29196":1016,"_20242":50840,"_5":13829,"_26574":50724,"_2824":50841},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3337":1064,"_29196":1016,"_20242":50843,"_5":13829,"_26574":50728,"_2824":50844},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3337":1065,"_29196":1016,"_20242":50846,"_5":13829,"_26574":50728,"_2824":50847},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3337":1066,"_29196":1066,"_5":14181,"_2824":50166,"_29540":50849,"_20242":50850,"_26574":1066},[47528,48977,49985,49983,50166],[],{"_3337":1067,"_29196":1066,"_20242":50852,"_5":13829,"_26574":1066,"_2824":50853},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3337":1068,"_29196":1066,"_5":29537,"_20242":50855,"_26574":50856,"_2824":50857},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3337":1069,"_29196":1066,"_5":29537,"_20242":50859,"_26574":50860,"_2824":50861},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3337":1070,"_29196":1066,"_5":29537,"_20242":50863,"_26574":50864,"_2824":50865},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3337":1071,"_29196":1066,"_5":29537,"_20242":50867,"_26574":50868,"_2824":50869},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3337":1072,"_29196":1066,"_20242":50871,"_5":13829,"_26574":1066,"_2824":50872},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3337":1073,"_29196":1066,"_20242":50874,"_5":13829,"_26574":50856,"_2824":50875},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3337":1074,"_29196":1066,"_20242":50877,"_5":13829,"_26574":50856,"_2824":50878},[],"The integrator installs initial EST server trust and an admission credential.",{"_3337":1075,"_29196":1066,"_20242":50880,"_5":13829,"_26574":50856,"_2824":50881},[],"The client requests an identity for its `Device ID` through EST.",{"_3337":1076,"_29196":1066,"_20242":50883,"_5":13829,"_26574":50856,"_2824":50884},[],"Certificate, device binding and key/certificate installation are checked.",{"_3337":1077,"_29196":1066,"_20242":50886,"_5":13829,"_26574":50856,"_2824":50887},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3337":1078,"_29196":1066,"_20242":50889,"_5":13829,"_26574":50856,"_2824":50890},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3337":1079,"_29196":1066,"_20242":50892,"_5":13829,"_26574":50860,"_2824":50893},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3337":1080,"_29196":1066,"_20242":50895,"_5":13829,"_26574":50860,"_2824":50896},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3337":1081,"_29196":1066,"_20242":50898,"_5":13829,"_26574":50860,"_2824":50899},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3337":1082,"_29196":1066,"_20242":50901,"_5":13829,"_26574":50860,"_2824":50902},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3337":1083,"_29196":1066,"_20242":50904,"_5":13829,"_26574":50864,"_2824":50905},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3337":1084,"_29196":1066,"_20242":50907,"_5":13829,"_26574":50864,"_2824":50908},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3337":1085,"_29196":1066,"_20242":50910,"_5":13829,"_26574":50864,"_2824":50911},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3337":1086,"_29196":1066,"_20242":50913,"_5":13829,"_26574":50864,"_2824":50914},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3337":1087,"_29196":1066,"_20242":50916,"_5":13829,"_26574":50868,"_2824":50917},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3337":1088,"_29196":1066,"_20242":50919,"_5":13829,"_26574":50868,"_2824":50920},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3337":1089,"_29196":1089,"_5":14181,"_2824":50922,"_29540":50923,"_20242":50924,"_26574":1089},"Provisioning strategies",[47528,48977,49985,49983,50166],[],{"_3337":1090,"_29196":1089,"_20242":50926,"_5":13829,"_26574":1089,"_2824":50927},[],"Choose device registration, identity authorization and key generation.",{"_3337":1091,"_29196":1089,"_5":29537,"_20242":50929,"_26574":50930,"_2824":50931},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3337":1092,"_29196":1089,"_5":29537,"_20242":50933,"_26574":50934,"_2824":50935},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3337":1093,"_29196":1089,"_5":29537,"_20242":50937,"_26574":50938,"_2824":50939},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3337":1094,"_29196":1089,"_5":29537,"_20242":50941,"_26574":50942,"_2824":50943},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3337":1095,"_29196":1089,"_5":29537,"_20242":50945,"_26574":50946,"_2824":50947},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3337":1096,"_29196":1089,"_20242":50949,"_5":13829,"_26574":1089,"_2824":50950},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3337":1097,"_29196":1089,"_20242":50952,"_5":13829,"_26574":50930,"_2824":50953},[],"Path",{"_3337":1098,"_29196":1089,"_20242":50955,"_5":13829,"_26574":50930,"_2824":50956},[],"When the device exists",{"_3337":1099,"_29196":1089,"_20242":50958,"_5":13829,"_26574":50930,"_2824":50959},[],"What to check",{"_3337":1100,"_29196":1089,"_20242":50961,"_5":13829,"_26574":50930,"_2824":50962},[],"Manual assignment",{"_3337":1101,"_29196":1089,"_20242":50964,"_5":13829,"_26574":50930,"_2824":50965},[],"An operator creates it before associating a certificate.",{"_3337":1102,"_29196":1089,"_20242":50967,"_5":13829,"_26574":50930,"_2824":50968},[],"ID, owning DMS, certificate CN and bound serial.",{"_3337":1103,"_29196":1089,"_20242":50970,"_5":13829,"_26574":50930,"_2824":50971},[],"EST with `JITP`",{"_3337":1104,"_29196":1089,"_20242":50973,"_5":13829,"_26574":50930,"_2824":50974},[],"Created for an unknown CN during `/simpleenroll`.",{"_3337":1105,"_29196":1089,"_20242":50976,"_5":13829,"_26574":50930,"_2824":50977},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3337":1106,"_29196":1089,"_20242":50979,"_5":13829,"_26574":50930,"_2824":50980},[],"EST with `PRE_REGISTRATION`",{"_3337":1107,"_29196":1089,"_20242":50982,"_5":13829,"_26574":50930,"_2824":50983},[],"Must exist before `/simpleenroll`.",{"_3337":1108,"_29196":1089,"_20242":50985,"_5":13829,"_26574":50930,"_2824":50986},[],"Approved record, same DMS and replacement conditions for your version.",{"_3337":1109,"_29196":1089,"_20242":50988,"_5":13829,"_26574":50930,"_2824":50989},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3337":1110,"_29196":1089,"_20242":50991,"_5":13829,"_26574":50930,"_2824":50992},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3337":1111,"_29196":1089,"_20242":50994,"_5":13829,"_26574":50934,"_2824":50995},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3337":1112,"_29196":1089,"_20242":50997,"_5":13829,"_26574":50934,"_2824":50998},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3337":1113,"_29196":1089,"_20242":51000,"_5":13829,"_26574":50934,"_2824":51001},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3337":1114,"_29196":1089,"_20242":51003,"_5":13829,"_26574":50938,"_2824":51004},[],"Decide initial enrollment and re-enrollment separately:",{"_3337":1115,"_29196":1089,"_20242":51006,"_5":13829,"_26574":50938,"_2824":51007},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3337":1116,"_29196":1089,"_20242":51009,"_5":13829,"_26574":50938,"_2824":51010},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3337":1117,"_29196":1089,"_20242":51012,"_5":13829,"_26574":50938,"_2824":51013},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3337":1118,"_29196":1089,"_20242":51015,"_5":13829,"_26574":50938,"_2824":51016},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3337":1119,"_29196":1089,"_20242":51018,"_5":13829,"_26574":50938,"_2824":51019},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3337":1120,"_29196":1089,"_20242":51021,"_5":13829,"_26574":50942,"_2824":47912},[],{"_3337":1121,"_29196":1089,"_20242":51023,"_5":13829,"_26574":50942,"_2824":51024},[],"Material crossing EST",{"_3337":1122,"_29196":1089,"_20242":51026,"_5":13829,"_26574":50942,"_2824":51027},[],"Device-generated key",{"_3337":1123,"_29196":1089,"_20242":51029,"_5":13829,"_26574":50942,"_2824":51030},[],"Public CSR and certificate; the key stays on the client.",{"_3337":1124,"_29196":1089,"_20242":51032,"_5":13829,"_26574":50942,"_2824":51033},[],"Existing device key",{"_3337":1125,"_29196":1089,"_20242":51035,"_5":13829,"_26574":50942,"_2824":51036},[],"CSR signed with that key and a new certificate.",{"_3337":1126,"_29196":1089,"_20242":51038,"_5":13829,"_26574":50942,"_2824":50304},[],{"_3337":1127,"_29196":1089,"_20242":51040,"_5":13829,"_26574":50942,"_2824":51041},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3337":1128,"_29196":1089,"_20242":51043,"_5":13829,"_26574":50942,"_2824":51044},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3337":1129,"_29196":1089,"_20242":51046,"_5":13829,"_26574":50946,"_2824":51047},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3337":1130,"_29196":1130,"_5":14181,"_2824":51049,"_29540":51050,"_20242":51051,"_26574":1130},"Renewal and recovery",[47528,48977,49985,49983,50166],[],{"_3337":1131,"_29196":1130,"_20242":51053,"_5":13829,"_26574":1130,"_2824":51054},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3337":1132,"_29196":1130,"_5":29537,"_20242":51056,"_26574":51057,"_2824":51058},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3337":1133,"_29196":1130,"_5":29537,"_20242":51060,"_26574":51061,"_2824":51062},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3337":1134,"_29196":1130,"_5":29537,"_20242":51064,"_26574":51065,"_2824":51066},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3337":1135,"_29196":1130,"_5":29537,"_20242":51068,"_26574":51069,"_2824":51070},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3337":1136,"_29196":1130,"_5":29537,"_20242":51072,"_26574":51073,"_2824":51074},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3337":1137,"_29196":1130,"_20242":51076,"_5":13829,"_26574":1130,"_2824":51077},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3337":1138,"_29196":1130,"_20242":51079,"_5":13829,"_26574":51057,"_2824":51080},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3337":1139,"_29196":1130,"_20242":51082,"_5":13829,"_26574":51057,"_2824":51083},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3337":1140,"_29196":1130,"_20242":51085,"_5":13829,"_26574":51057,"_2824":51086},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3337":1141,"_29196":1130,"_20242":51088,"_5":13829,"_26574":51057,"_2824":51089},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3337":1142,"_29196":1130,"_20242":51091,"_5":13829,"_26574":51061,"_2824":51092},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3337":1143,"_29196":1130,"_20242":51094,"_5":13829,"_26574":51061,"_2824":51095},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3337":1144,"_29196":1130,"_20242":51097,"_5":13829,"_26574":51065,"_2824":51098},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3337":1145,"_29196":1130,"_20242":51100,"_5":13829,"_26574":51065,"_2824":51101},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3337":1146,"_29196":1130,"_20242":51103,"_5":13829,"_26574":51065,"_2824":51104},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3337":1147,"_29196":1130,"_20242":51106,"_5":13829,"_26574":51069,"_2824":51107},[],"Situation",{"_3337":1148,"_29196":1130,"_20242":51109,"_5":13829,"_26574":51069,"_2824":51110},[],"Procedure",{"_3337":1149,"_29196":1130,"_20242":51112,"_5":13829,"_26574":51069,"_2824":51113},[],"Valid certificate, outside the window",{"_3337":1150,"_29196":1130,"_20242":51115,"_5":13829,"_26574":51069,"_2824":51116},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3337":1151,"_29196":1130,"_20242":51118,"_5":13829,"_26574":51069,"_2824":51119},[],"Expired certificate, key available",{"_3337":1152,"_29196":1130,"_20242":51121,"_5":13829,"_26574":51069,"_2824":51122},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3337":1153,"_29196":1130,"_20242":51124,"_5":13829,"_26574":51069,"_2824":51125},[],"Renewal through webhook or `NO_AUTH`",{"_3337":1154,"_29196":1130,"_20242":51127,"_5":13829,"_26574":51069,"_2824":51128},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3337":1155,"_29196":1130,"_20242":51130,"_5":13829,"_26574":51069,"_2824":51131},[],"Lost or inaccessible key",{"_3337":1156,"_29196":1130,"_20242":51133,"_5":13829,"_26574":51069,"_2824":51134},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3337":1157,"_29196":1130,"_20242":51136,"_5":13829,"_26574":51069,"_2824":51137},[],"Current identity revoked",{"_3337":1158,"_29196":1130,"_20242":51139,"_5":13829,"_26574":51069,"_2824":51140},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3337":1159,"_29196":1130,"_20242":51142,"_5":13829,"_26574":51069,"_2824":51143},[],"Device without an identity",{"_3337":1160,"_29196":1130,"_20242":51145,"_5":13829,"_26574":51069,"_2824":51146},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3337":1161,"_29196":1130,"_20242":51148,"_5":13829,"_26574":51069,"_2824":51149},[],"Retired device",{"_3337":1162,"_29196":1130,"_20242":51151,"_5":13829,"_26574":51069,"_2824":51152},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3337":1163,"_29196":1130,"_20242":51154,"_5":13829,"_26574":51069,"_2824":51155},[],"Timeout, HTTP 500 or installation failure",{"_3337":1164,"_29196":1130,"_20242":51157,"_5":13829,"_26574":51069,"_2824":51158},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3337":1165,"_29196":1130,"_20242":51160,"_5":13829,"_26574":51073,"_2824":51161},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3337":1166,"_29196":1130,"_20242":51163,"_5":13829,"_26574":51073,"_2824":51164},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3337":1167,"_29196":1167,"_5":14181,"_2824":51166,"_29540":51167,"_20242":51168,"_26574":1167},"Enrollment troubleshooting",[47528,48977,49985,49983,50166],[],{"_3337":1168,"_29196":1167,"_20242":51170,"_5":13829,"_26574":1167,"_2824":51171},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3337":1169,"_29196":1167,"_5":29537,"_20242":51173,"_26574":51174,"_2824":51175},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3337":1170,"_29196":1167,"_5":29537,"_20242":51177,"_26574":51178,"_2824":51179},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3337":1171,"_29196":1167,"_5":29537,"_20242":51181,"_26574":51182,"_2824":50729},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3337":1172,"_29196":1167,"_5":29537,"_20242":51184,"_26574":51185,"_2824":51186},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3337":1173,"_29196":1167,"_20242":51188,"_5":13829,"_26574":1167,"_2824":51189},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3337":1174,"_29196":1167,"_20242":51191,"_5":13829,"_26574":51178,"_2824":51192},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3337":1175,"_29196":1167,"_20242":51194,"_5":13829,"_26574":51178,"_2824":51195},[],"Symptom or message",{"_3337":1176,"_29196":1167,"_20242":51197,"_5":13829,"_26574":51178,"_2824":50959},[],{"_3337":1177,"_29196":1167,"_20242":51199,"_5":13829,"_26574":51178,"_2824":51200},[],"curl rejects TLS, name or issuer",{"_3337":1178,"_29196":1167,"_20242":51202,"_5":13829,"_26574":51178,"_2824":51203},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3337":1179,"_29196":1167,"_20242":51205,"_5":13829,"_26574":51178,"_2824":51206},[],"404 or missing APS",{"_3337":1180,"_29196":1167,"_20242":51208,"_5":13829,"_26574":51178,"_2824":51209},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3337":1181,"_29196":1167,"_20242":51211,"_5":13829,"_26574":51178,"_2824":51212},[],"400, CSR or format error",{"_3337":1182,"_29196":1167,"_20242":51214,"_5":13829,"_26574":51178,"_2824":51215},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3337":1183,"_29196":1167,"_20242":51217,"_5":13829,"_26574":51178,"_2824":51218},[],"Missing credential or invalid certificate",{"_3337":1184,"_29196":1167,"_20242":51220,"_5":13829,"_26574":51178,"_2824":51221},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3337":1185,"_29196":1167,"_20242":51223,"_5":13829,"_26574":51178,"_2824":51224},[],"Webhook denies, times out or responds without authorization",{"_3337":1186,"_29196":1167,"_20242":51226,"_5":13829,"_26574":51178,"_2824":51227},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3337":1187,"_29196":1167,"_20242":51229,"_5":13829,"_26574":51178,"_2824":51230},[],"`unexpected status code: <n>: redirects are not followed`",{"_3337":1188,"_29196":1167,"_20242":51232,"_5":13829,"_26574":51178,"_2824":51233},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3337":1189,"_29196":1167,"_20242":51235,"_5":13829,"_26574":51178,"_2824":51236},[],"`webhook response exceeds 1048576 bytes`",{"_3337":1190,"_29196":1167,"_20242":51238,"_5":13829,"_26574":51178,"_2824":51239},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3337":1191,"_29196":1167,"_20242":51241,"_5":13829,"_26574":51178,"_2824":51242},[],"`webhook config must not reference files`",{"_3337":1192,"_29196":1167,"_20242":51244,"_5":13829,"_26574":51178,"_2824":51245},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3337":1193,"_29196":1167,"_20242":51247,"_5":13829,"_26574":51178,"_2824":51248},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3337":1194,"_29196":1167,"_20242":51250,"_5":13829,"_26574":51178,"_2824":51251},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3337":1195,"_29196":1167,"_20242":51253,"_5":13829,"_26574":51178,"_2824":51254},[],"`webhook mTLS certificate and key are invalid: …`",{"_3337":1196,"_29196":1167,"_20242":51256,"_5":13829,"_26574":51178,"_2824":51257},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3337":1197,"_29196":1167,"_20242":51259,"_5":13829,"_26574":51178,"_2824":51260},[],"400 `struct validation error` creating or updating a DMS",{"_3337":1198,"_29196":1167,"_20242":51262,"_5":13829,"_26574":51178,"_2824":51263},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3337":1199,"_29196":1167,"_20242":51265,"_5":13829,"_26574":51178,"_2824":51266},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3337":1200,"_29196":1167,"_20242":51268,"_5":13829,"_26574":51178,"_2824":51269},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3337":1201,"_29196":1167,"_20242":51271,"_5":13829,"_26574":51178,"_2824":51272},[],"`device not preregistered`",{"_3337":1202,"_29196":1167,"_20242":51274,"_5":13829,"_26574":51178,"_2824":51275},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3337":1203,"_29196":1167,"_20242":51277,"_5":13829,"_26574":51178,"_2824":51278},[],"`forbiddenNewEnrollment`",{"_3337":1204,"_29196":1167,"_20242":51280,"_5":13829,"_26574":51178,"_2824":51281},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3337":1205,"_29196":1167,"_20242":51283,"_5":13829,"_26574":51178,"_2824":51284},[],"Different owning DMS",{"_3337":1206,"_29196":1167,"_20242":51286,"_5":13829,"_26574":51178,"_2824":51287},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3337":1207,"_29196":1167,"_20242":51289,"_5":13829,"_26574":51178,"_2824":51290},[],"`invalid RawSubject bytes`",{"_3337":1208,"_29196":1167,"_20242":51292,"_5":13829,"_26574":51178,"_2824":51293},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3337":1209,"_29196":1167,"_20242":51295,"_5":13829,"_26574":51178,"_2824":51296},[],"`invalid reenroll window`",{"_3337":1210,"_29196":1167,"_20242":51298,"_5":13829,"_26574":51178,"_2824":51299},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3337":1211,"_29196":1167,"_20242":51301,"_5":13829,"_26574":51178,"_2824":51302},[],"Current certificate revoked",{"_3337":1212,"_29196":1167,"_20242":51304,"_5":13829,"_26574":51178,"_2824":51305},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3337":1213,"_29196":1167,"_20242":51307,"_5":13829,"_26574":51178,"_2824":51308},[],"CA, profile or signing error",{"_3337":1214,"_29196":1167,"_20242":51310,"_5":13829,"_26574":51178,"_2824":51311},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3337":1215,"_29196":1167,"_20242":51313,"_5":13829,"_26574":51178,"_2824":51314},[],"HTTP 200 without a device connection",{"_3337":1216,"_29196":1167,"_20242":51316,"_5":13829,"_26574":51178,"_2824":51317},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3337":1217,"_29196":1167,"_20242":51319,"_5":13829,"_26574":51178,"_2824":51320},[],"Timeout or error after issuance",{"_3337":1218,"_29196":1167,"_20242":51322,"_5":13829,"_26574":51178,"_2824":51323},[],"New certificates, current slot and previous identity's state before retrying.",{"_3337":1219,"_29196":1167,"_20242":51325,"_5":13829,"_26574":51182,"_2824":51326},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3337":1220,"_29196":1167,"_20242":51328,"_5":13829,"_26574":51182,"_2824":51329},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3337":1221,"_29196":1167,"_20242":51331,"_5":13829,"_26574":51185,"_2824":51332},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3337":1222,"_29196":1167,"_20242":51334,"_5":13829,"_26574":51185,"_2824":51335},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3337":1223,"_29196":1167,"_20242":51337,"_5":13829,"_26574":51185,"_2824":51338},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3337":1224,"_29196":1167,"_20242":51340,"_5":13829,"_26574":51185,"_2824":51341},[],"Make one request, save headers/body and query the device and certificates.",{"_3337":1225,"_29196":1167,"_20242":51343,"_5":13829,"_26574":51185,"_2824":51344},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3337":1226,"_29196":1167,"_20242":51346,"_5":13829,"_26574":51185,"_2824":51347},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3337":1227,"_29196":1167,"_20242":51349,"_5":13829,"_26574":51185,"_2824":51350},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3337":1228,"_29196":1228,"_5":14181,"_2824":51352,"_29540":51353,"_20242":51354,"_26574":1228},"Trust distribution and updates",[47528,48977,49985,49983,50166],[],{"_3337":1229,"_29196":1228,"_20242":51356,"_5":13829,"_26574":1228,"_2824":51357},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3337":1230,"_29196":1228,"_5":29537,"_20242":51359,"_26574":51360,"_2824":51361},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3337":1231,"_29196":1228,"_5":29537,"_20242":51363,"_26574":51364,"_2824":51365},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3337":1232,"_29196":1228,"_5":29537,"_20242":51367,"_26574":51368,"_2824":51369},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3337":1233,"_29196":1228,"_5":29537,"_20242":51371,"_26574":51372,"_2824":51373},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3337":1234,"_29196":1228,"_5":29537,"_20242":51375,"_26574":51376,"_2824":51377},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3337":1235,"_29196":1228,"_20242":51379,"_5":13829,"_26574":1228,"_2824":51380},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3337":1236,"_29196":1228,"_20242":51382,"_5":13829,"_26574":51360,"_2824":51383},[],"Relationship",{"_3337":1237,"_29196":1228,"_20242":51385,"_5":13829,"_26574":51360,"_2824":51386},[],"Material prepared by its owner",{"_3337":1238,"_29196":1228,"_20242":51388,"_5":13829,"_26574":51360,"_2824":51389},[],"Device → EST server",{"_3337":1239,"_29196":1228,"_20242":51391,"_5":13829,"_26574":51360,"_2824":51392},[],"Previously verified server root, chain or pin and TLS name.",{"_3337":1240,"_29196":1228,"_20242":51394,"_5":13829,"_26574":51360,"_2824":51395},[],"DMS → requester",{"_3337":1241,"_29196":1228,"_20242":51397,"_5":13829,"_26574":51360,"_2824":51398},[],"CAs and rules authorizing initial or renewal credentials.",{"_3337":1242,"_29196":1228,"_20242":51400,"_5":13829,"_26574":51360,"_2824":51401},[],"Consumer → device",{"_3337":1243,"_29196":1228,"_20242":51403,"_5":13829,"_26574":51360,"_2824":51404},[],"Operational identity roots, intermediates, validation and permissions.",{"_3337":1244,"_29196":1228,"_20242":51406,"_5":13829,"_26574":51360,"_2824":51407},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3337":1245,"_29196":1228,"_20242":51409,"_5":13829,"_26574":51364,"_2824":51410},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3337":1246,"_29196":1228,"_20242":51412,"_5":13829,"_26574":51364,"_2824":51413},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3337":1247,"_29196":1228,"_20242":51415,"_5":13829,"_26574":51368,"_2824":51416},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3337":1248,"_29196":1228,"_20242":51418,"_5":13829,"_26574":51368,"_2824":51419},[],"Select policy-approved roots as anchors.",{"_3337":1249,"_29196":1228,"_20242":51421,"_5":13829,"_26574":51368,"_2824":51422},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3337":1250,"_29196":1228,"_20242":51424,"_5":13829,"_26574":51368,"_2824":51425},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3337":1251,"_29196":1228,"_20242":51427,"_5":13829,"_26574":51368,"_2824":51428},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3337":1252,"_29196":1228,"_20242":51430,"_5":13829,"_26574":51368,"_2824":51431},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3337":1253,"_29196":1228,"_20242":51433,"_5":13829,"_26574":51372,"_2824":51434},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3337":1254,"_29196":1228,"_20242":51436,"_5":13829,"_26574":51372,"_2824":51437},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3337":1255,"_29196":1228,"_20242":51439,"_5":13829,"_26574":51372,"_2824":51440},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3337":1256,"_29196":1228,"_20242":51442,"_5":13829,"_26574":51376,"_2824":51443},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3337":1257,"_29196":1257,"_5":14181,"_2824":51445,"_29540":51446,"_20242":51448,"_26574":1257},"AWS IoT Core",[47528,48977,49985,49983,51447],"Integrations",[],{"_3337":1258,"_29196":1257,"_20242":51450,"_5":13829,"_26574":1257,"_2824":51451},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3337":1259,"_29196":1257,"_5":29537,"_20242":51453,"_26574":51454,"_2824":51455},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3337":1260,"_29196":1257,"_5":29537,"_20242":51457,"_26574":51458,"_2824":51459},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3337":1261,"_29196":1257,"_5":29537,"_20242":51461,"_26574":51462,"_2824":51463},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3337":1262,"_29196":1257,"_5":29537,"_20242":51465,"_26574":51466,"_2824":51467},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3337":1263,"_29196":1257,"_5":29537,"_20242":51469,"_26574":51470,"_2824":51471},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#resource-state-machine","Resource state machine",{"_3337":1264,"_29196":1257,"_5":29537,"_20242":51473,"_26574":51474,"_2824":51475},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#events-the-connector-handles","Events the connector handles",{"_3337":1265,"_29196":1257,"_5":29537,"_20242":51477,"_26574":51478,"_2824":51479},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3337":1266,"_29196":1257,"_5":29537,"_20242":51481,"_26574":51482,"_2824":51483},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3337":1267,"_29196":1257,"_5":29537,"_20242":51485,"_26574":51486,"_2824":51487},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3337":1268,"_29196":1257,"_5":29537,"_20242":51489,"_26574":51490,"_2824":51491},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3337":1269,"_29196":1257,"_5":29537,"_20242":51493,"_26574":51494,"_2824":51495},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3337":1270,"_29196":1257,"_5":29537,"_20242":51497,"_26574":51498,"_2824":51499},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3337":1271,"_29196":1257,"_5":29537,"_20242":51501,"_26574":51502,"_2824":51503},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3337":1272,"_29196":1257,"_5":29537,"_20242":51505,"_26574":51506,"_2824":51507},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3337":1273,"_29196":1257,"_5":29537,"_20242":51509,"_26574":51510,"_2824":51511},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3337":1274,"_29196":1257,"_5":29537,"_20242":51513,"_26574":51514,"_2824":51515},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3337":1275,"_29196":1257,"_5":29537,"_20242":51517,"_26574":51518,"_2824":51519},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3337":1276,"_29196":1257,"_5":29537,"_20242":51521,"_26574":51522,"_2824":51523},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3337":1277,"_29196":1257,"_5":29537,"_20242":51525,"_26574":51526,"_2824":51527},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3337":1278,"_29196":1257,"_5":29537,"_20242":51529,"_26574":51530,"_2824":51531},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3337":1279,"_29196":1257,"_5":29537,"_20242":51533,"_26574":51534,"_2824":51535},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3337":1280,"_29196":1257,"_5":29537,"_20242":51537,"_26574":51538,"_2824":51539},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3337":1281,"_29196":1257,"_5":29537,"_20242":51541,"_26574":51542,"_2824":51543},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3337":1282,"_29196":1257,"_5":29537,"_20242":51545,"_26574":51546,"_2824":51547},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3337":1283,"_29196":1257,"_5":29537,"_20242":51549,"_26574":51550,"_2824":51551},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3337":1284,"_29196":1257,"_5":29537,"_20242":51553,"_26574":51554,"_2824":51555},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3337":1285,"_29196":1257,"_20242":51557,"_5":13829,"_26574":1257,"_2824":51558},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3337":1286,"_29196":1257,"_20242":51560,"_5":13829,"_26574":1257,"_2824":51561},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3337":1287,"_29196":1257,"_20242":51563,"_5":13829,"_26574":1257,"_2824":51564},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3337":1288,"_29196":1257,"_20242":51566,"_5":13829,"_26574":51454,"_2824":51567},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3337":1289,"_29196":1257,"_20242":51569,"_5":13829,"_26574":51454,"_2824":51570},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3337":1290,"_29196":1257,"_20242":51572,"_5":13829,"_26574":51454,"_2824":51573},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3337":1291,"_29196":1257,"_20242":51575,"_5":13829,"_26574":51454,"_2824":51576},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3337":1292,"_29196":1257,"_20242":51578,"_5":13829,"_26574":51458,"_2824":51579},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3337":1293,"_29196":1257,"_20242":51581,"_5":13829,"_26574":51462,"_2824":51582},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3337":1294,"_29196":1257,"_20242":51584,"_5":13829,"_26574":51462,"_2824":51585},[],"IAM action",{"_3337":1295,"_29196":1257,"_20242":51587,"_5":13829,"_26574":51462,"_2824":47918},[],{"_3337":1296,"_29196":1257,"_20242":51589,"_5":13829,"_26574":51462,"_2824":51590},[],"`iot:GetRegistrationCode`",{"_3337":1297,"_29196":1257,"_20242":51592,"_5":13829,"_26574":51462,"_2824":51593},[],"Obtain the verification code for CA registration in the Primary Account",{"_3337":1298,"_29196":1257,"_20242":51595,"_5":13829,"_26574":51462,"_2824":51596},[],"`iot:RegisterCACertificate`",{"_3337":1299,"_29196":1257,"_20242":51598,"_5":13829,"_26574":51462,"_2824":51599},[],"Register the CA in AWS IoT",{"_3337":1300,"_29196":1257,"_20242":51601,"_5":13829,"_26574":51462,"_2824":51602},[],"`iot:DescribeCACertificate`",{"_3337":1301,"_29196":1257,"_20242":51604,"_5":13829,"_26574":51462,"_2824":51605},[],"Check the CA registration status",{"_3337":1302,"_29196":1257,"_20242":51607,"_5":13829,"_26574":51462,"_2824":51608},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3337":1303,"_29196":1257,"_20242":51610,"_5":13829,"_26574":51462,"_2824":51611},[],"Create or update Things in IoT Core",{"_3337":1304,"_29196":1257,"_20242":51613,"_5":13829,"_26574":51462,"_2824":51614},[],"`iot:RegisterThing`",{"_3337":1305,"_29196":1257,"_20242":51616,"_5":13829,"_26574":51462,"_2824":51617},[],"Provision Things through a template",{"_3337":1306,"_29196":1257,"_20242":51619,"_5":13829,"_26574":51462,"_2824":51620},[],"`iot:RegisterCertificate`",{"_3337":1307,"_29196":1257,"_20242":51622,"_5":13829,"_26574":51462,"_2824":51623},[],"Register device certificates",{"_3337":1308,"_29196":1257,"_20242":51625,"_5":13829,"_26574":51462,"_2824":51626},[],"`iot:UpdateCertificate`",{"_3337":1309,"_29196":1257,"_20242":51628,"_5":13829,"_26574":51462,"_2824":51629},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3337":1310,"_29196":1257,"_20242":51631,"_5":13829,"_26574":51462,"_2824":51632},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3337":1311,"_29196":1257,"_20242":51634,"_5":13829,"_26574":51462,"_2824":51635},[],"Create and attach IoT policies",{"_3337":1312,"_29196":1257,"_20242":51637,"_5":13829,"_26574":51462,"_2824":51638},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3337":1313,"_29196":1257,"_20242":51640,"_5":13829,"_26574":51462,"_2824":51641},[],"Manage Thing groups",{"_3337":1314,"_29196":1257,"_20242":51643,"_5":13829,"_26574":51462,"_2824":51644},[],"`iot:CreateProvisioningTemplate`",{"_3337":1315,"_29196":1257,"_20242":51646,"_5":13829,"_26574":51462,"_2824":51647},[],"Create JITP templates",{"_3337":1316,"_29196":1257,"_20242":51649,"_5":13829,"_26574":51462,"_2824":51650},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3337":1317,"_29196":1257,"_20242":51652,"_5":13829,"_26574":51462,"_2824":51653},[],"Read and write the Device Shadow",{"_3337":1318,"_29196":1257,"_20242":51655,"_5":13829,"_26574":51462,"_2824":51656},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3337":1319,"_29196":1257,"_20242":51658,"_5":13829,"_26574":51466,"_2824":51659},[],"Parameter",{"_3337":1320,"_29196":1257,"_20242":51661,"_5":13829,"_26574":51466,"_2824":51662},[],"Type",{"_3337":1321,"_29196":1257,"_20242":51664,"_5":13829,"_26574":51466,"_2824":51665},[],"Required",{"_3337":1322,"_29196":1257,"_20242":51667,"_5":13829,"_26574":51466,"_2824":51668},[],"Description",{"_3337":1323,"_29196":1257,"_20242":51670,"_5":13829,"_26574":51466,"_2824":51671},[],"`connector_id`",{"_3337":1324,"_29196":1257,"_20242":51673,"_5":13829,"_26574":51466,"_2824":24190},[],{"_3337":1325,"_29196":1257,"_20242":51675,"_5":13829,"_26574":51466,"_2824":51676},[],"Yes",{"_3337":1326,"_29196":1257,"_20242":51678,"_5":13829,"_26574":51466,"_2824":51679},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3337":1327,"_29196":1257,"_20242":51681,"_5":13829,"_26574":51466,"_2824":51682},[],"`aws_config.region`",{"_3337":1328,"_29196":1257,"_20242":51684,"_5":13829,"_26574":51466,"_2824":24190},[],{"_3337":1329,"_29196":1257,"_20242":51686,"_5":13829,"_26574":51466,"_2824":51676},[],{"_3337":1330,"_29196":1257,"_20242":51688,"_5":13829,"_26574":51466,"_2824":51689},[],"AWS region where the connector operates.",{"_3337":1331,"_29196":1257,"_20242":51691,"_5":13829,"_26574":51466,"_2824":51692},[],"`aws_config.auth_method`",{"_3337":1332,"_29196":1257,"_20242":51694,"_5":13829,"_26574":51466,"_2824":24190},[],{"_3337":1333,"_29196":1257,"_20242":51696,"_5":13829,"_26574":51466,"_2824":51676},[],{"_3337":1334,"_29196":1257,"_20242":51698,"_5":13829,"_26574":51466,"_2824":51699},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3337":1335,"_29196":1257,"_20242":51701,"_5":13829,"_26574":51466,"_2824":51702},[],"`aws_config.access_key_id`",{"_3337":1336,"_29196":1257,"_20242":51704,"_5":13829,"_26574":51466,"_2824":24190},[],{"_3337":1337,"_29196":1257,"_20242":51706,"_5":13829,"_26574":51466,"_2824":51707},[],"Only with `auth_method=static`",{"_3337":1338,"_29196":1257,"_20242":51709,"_5":13829,"_26574":51466,"_2824":51710},[],"AWS access key.",{"_3337":1339,"_29196":1257,"_20242":51712,"_5":13829,"_26574":51466,"_2824":51713},[],"`aws_config.secret_access_key`",{"_3337":1340,"_29196":1257,"_20242":51715,"_5":13829,"_26574":51466,"_2824":24190},[],{"_3337":1341,"_29196":1257,"_20242":51717,"_5":13829,"_26574":51466,"_2824":51707},[],{"_3337":1342,"_29196":1257,"_20242":51719,"_5":13829,"_26574":51466,"_2824":51720},[],"AWS secret key.",{"_3337":1343,"_29196":1257,"_20242":51722,"_5":13829,"_26574":51466,"_2824":51723},[],"`aws_config.session_token`",{"_3337":1344,"_29196":1257,"_20242":51725,"_5":13829,"_26574":51466,"_2824":24190},[],{"_3337":1345,"_29196":1257,"_20242":51727,"_5":13829,"_26574":51466,"_2824":51728},[],"No",{"_3337":1346,"_29196":1257,"_20242":51730,"_5":13829,"_26574":51466,"_2824":51731},[],"Session token (with `auth_method=static`).",{"_3337":1347,"_29196":1257,"_20242":51733,"_5":13829,"_26574":51466,"_2824":51734},[],"`aws_config.role_arn`",{"_3337":1348,"_29196":1257,"_20242":51736,"_5":13829,"_26574":51466,"_2824":24190},[],{"_3337":1349,"_29196":1257,"_20242":51738,"_5":13829,"_26574":51466,"_2824":51739},[],"Only with `auth_method=role`",{"_3337":1350,"_29196":1257,"_20242":51741,"_5":13829,"_26574":51466,"_2824":51742},[],"ARN of the role to assume.",{"_3337":1351,"_29196":1257,"_20242":51744,"_5":13829,"_26574":51466,"_2824":51745},[],"`aws_config.endpoint_url`",{"_3337":1352,"_29196":1257,"_20242":51747,"_5":13829,"_26574":51466,"_2824":24190},[],{"_3337":1353,"_29196":1257,"_20242":51749,"_5":13829,"_26574":51466,"_2824":51728},[],{"_3337":1354,"_29196":1257,"_20242":51751,"_5":13829,"_26574":51466,"_2824":51752},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3337":1355,"_29196":1257,"_20242":51754,"_5":13829,"_26574":51466,"_2824":51755},[],"`subscriber_event_bus`",{"_3337":1356,"_29196":1257,"_20242":51757,"_5":13829,"_26574":51466,"_2824":16977},[],{"_3337":1357,"_29196":1257,"_20242":51759,"_5":13829,"_26574":51466,"_2824":51676},[],{"_3337":1358,"_29196":1257,"_20242":51761,"_5":13829,"_26574":51466,"_2824":51762},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3337":1359,"_29196":1257,"_20242":51764,"_5":13829,"_26574":51466,"_2824":51765},[],"`dms_manager_client`",{"_3337":1360,"_29196":1257,"_20242":51767,"_5":13829,"_26574":51466,"_2824":24190},[],{"_3337":1361,"_29196":1257,"_20242":51769,"_5":13829,"_26574":51466,"_2824":51676},[],{"_3337":1362,"_29196":1257,"_20242":51771,"_5":13829,"_26574":51466,"_2824":51772},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3337":1363,"_29196":1257,"_20242":51774,"_5":13829,"_26574":51466,"_2824":51775},[],"`device_manager_client`",{"_3337":1364,"_29196":1257,"_20242":51777,"_5":13829,"_26574":51466,"_2824":24190},[],{"_3337":1365,"_29196":1257,"_20242":51779,"_5":13829,"_26574":51466,"_2824":51676},[],{"_3337":1366,"_29196":1257,"_20242":51781,"_5":13829,"_26574":51466,"_2824":51782},[],"HTTP URL of Lamassu's Device Manager.",{"_3337":1367,"_29196":1257,"_20242":51784,"_5":13829,"_26574":51466,"_2824":51785},[],"`ca_client`",{"_3337":1368,"_29196":1257,"_20242":51787,"_5":13829,"_26574":51466,"_2824":24190},[],{"_3337":1369,"_29196":1257,"_20242":51789,"_5":13829,"_26574":51466,"_2824":51676},[],{"_3337":1370,"_29196":1257,"_20242":51791,"_5":13829,"_26574":51466,"_2824":51792},[],"HTTP URL of Lamassu's CA service.",{"_3337":1371,"_29196":1257,"_20242":51794,"_5":13829,"_26574":51470,"_2824":51795},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each transition performs. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3337":1372,"_29196":1257,"_20242":51797,"_5":13829,"_26574":51474,"_2824":51798},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3337":1373,"_29196":1257,"_20242":51800,"_5":13829,"_26574":51474,"_2824":51801},[],"CloudEvent type",{"_3337":1374,"_29196":1257,"_20242":51803,"_5":13829,"_26574":51474,"_2824":51804},[],"Lamassu resource",{"_3337":1375,"_29196":1257,"_20242":51806,"_5":13829,"_26574":51474,"_2824":51807},[],"AWS Resource",{"_3337":1376,"_29196":1257,"_20242":51809,"_5":13829,"_26574":51474,"_2824":51810},[],"IAM actions",{"_3337":1377,"_29196":1257,"_20242":51812,"_5":13829,"_26574":51474,"_2824":51813},[],"AWS calls and effect",{"_3337":1378,"_29196":1257,"_20242":51815,"_5":13829,"_26574":51474,"_2824":51816},[],"Where in this page",{"_3337":1379,"_29196":1257,"_20242":51818,"_5":13829,"_26574":51474,"_2824":51819},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3337":1380,"_29196":1257,"_20242":51821,"_5":13829,"_26574":51474,"_2824":51822},[],"CA",{"_3337":1381,"_29196":1257,"_20242":51824,"_5":13829,"_26574":51474,"_2824":51825},[],"`IoTCore/CACertificate`",{"_3337":1382,"_29196":1257,"_20242":51827,"_5":13829,"_26574":51474,"_2824":51828},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3337":1383,"_29196":1257,"_20242":51830,"_5":13829,"_26574":51474,"_2824":51831},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3337":1384,"_29196":1257,"_20242":51833,"_5":13829,"_26574":51474,"_2824":51479},[],{"_3337":1385,"_29196":1257,"_20242":51835,"_5":13829,"_26574":51474,"_2824":51836},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3337":1386,"_29196":1257,"_20242":51838,"_5":13829,"_26574":51474,"_2824":51839},[],"DMS",{"_3337":1387,"_29196":1257,"_20242":51841,"_5":13829,"_26574":51474,"_2824":51842},[],"`IoTCore/ProvisioningTemplate`",{"_3337":1388,"_29196":1257,"_20242":51844,"_5":13829,"_26574":51474,"_2824":51845},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3337":1389,"_29196":1257,"_20242":51847,"_5":13829,"_26574":51474,"_2824":51848},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3337":1390,"_29196":1257,"_20242":51850,"_5":13829,"_26574":51474,"_2824":51483},[],{"_3337":1391,"_29196":1257,"_20242":51852,"_5":13829,"_26574":51474,"_2824":51853},[],"`EventBindDeviceIdentityKey`",{"_3337":1392,"_29196":1257,"_20242":51855,"_5":13829,"_26574":51474,"_2824":51856},[],"Device",{"_3337":1393,"_29196":1257,"_20242":51858,"_5":13829,"_26574":51474,"_2824":51859},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3337":1394,"_29196":1257,"_20242":51861,"_5":13829,"_26574":51474,"_2824":51862},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3337":1395,"_29196":1257,"_20242":51864,"_5":13829,"_26574":51474,"_2824":51865},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3337":1396,"_29196":1257,"_20242":51867,"_5":13829,"_26574":51474,"_2824":51491},[],{"_3337":1397,"_29196":1257,"_20242":51869,"_5":13829,"_26574":51474,"_2824":51870},[],"`EventUpdateCertificateStatusKey`",{"_3337":1398,"_29196":1257,"_20242":51872,"_5":13829,"_26574":51474,"_2824":51873},[],"Certificate",{"_3337":1399,"_29196":1257,"_20242":51875,"_5":13829,"_26574":51474,"_2824":51876},[],"`IoTCore/Certificate`",{"_3337":1400,"_29196":1257,"_20242":51878,"_5":13829,"_26574":51474,"_2824":51879},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3337":1401,"_29196":1257,"_20242":51881,"_5":13829,"_26574":51474,"_2824":51882},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3337":1402,"_29196":1257,"_20242":51884,"_5":13829,"_26574":51474,"_2824":51487},[],{"_3337":1403,"_29196":1257,"_20242":51886,"_5":13829,"_26574":51474,"_2824":51887},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3337":1404,"_29196":1257,"_20242":51889,"_5":13829,"_26574":51474,"_2824":51890},[],"Certificate / Device",{"_3337":1405,"_29196":1257,"_20242":51892,"_5":13829,"_26574":51474,"_2824":51893},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3337":1406,"_29196":1257,"_20242":51895,"_5":13829,"_26574":51474,"_2824":47924},[],{"_3337":1407,"_29196":1257,"_20242":51897,"_5":13829,"_26574":51474,"_2824":51898},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3337":1408,"_29196":1257,"_20242":51900,"_5":13829,"_26574":51474,"_2824":51543},[],{"_3337":1409,"_29196":1257,"_20242":51902,"_5":13829,"_26574":51478,"_2824":51903},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3337":1410,"_29196":1257,"_20242":51905,"_5":13829,"_26574":51478,"_2824":51906},[],"by the `registration.status` field of the CA's connector metadata:",{"_3337":1411,"_29196":1257,"_20242":51908,"_5":13829,"_26574":51478,"_2824":51909},[],"Transition",{"_3337":1412,"_29196":1257,"_20242":51911,"_5":13829,"_26574":51478,"_2824":51912},[],"AWS calls",{"_3337":1413,"_29196":1257,"_20242":51914,"_5":13829,"_26574":51478,"_2824":51915},[],"`NotRegistered` → `Requested`",{"_3337":1414,"_29196":1257,"_20242":51917,"_5":13829,"_26574":51478,"_2824":51918},[],"none (metadata write only)",{"_3337":1415,"_29196":1257,"_20242":51920,"_5":13829,"_26574":51478,"_2824":51921},[],"`Requested` → `Registering`",{"_3337":1416,"_29196":1257,"_20242":51923,"_5":13829,"_26574":51478,"_2824":51924},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3337":1417,"_29196":1257,"_20242":51926,"_5":13829,"_26574":51478,"_2824":51927},[],"`Registering` → `Succeeded`",{"_3337":1418,"_29196":1257,"_20242":51929,"_5":13829,"_26574":51478,"_2824":51930},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3337":1419,"_29196":1257,"_20242":51932,"_5":13829,"_26574":51478,"_2824":51933},[],"`Registering` → `Failed`",{"_3337":1420,"_29196":1257,"_20242":51935,"_5":13829,"_26574":51478,"_2824":51936},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3337":1421,"_29196":1257,"_20242":51938,"_5":13829,"_26574":51478,"_2824":51939},[],"`Failed` / `Succeeded` → `Requested`",{"_3337":1422,"_29196":1257,"_20242":51941,"_5":13829,"_26574":51478,"_2824":51942},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3337":1423,"_29196":1257,"_20242":51944,"_5":13829,"_26574":51482,"_2824":51945},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3337":1424,"_29196":1257,"_20242":51947,"_5":13829,"_26574":51482,"_2824":51909},[],{"_3337":1425,"_29196":1257,"_20242":51949,"_5":13829,"_26574":51482,"_2824":51912},[],{"_3337":1426,"_29196":1257,"_20242":51951,"_5":13829,"_26574":51482,"_2824":51952},[],"`Unconfigured` → `None` / `Auto`",{"_3337":1427,"_29196":1257,"_20242":51954,"_5":13829,"_26574":51482,"_2824":51955},[],"none (configuration only)",{"_3337":1428,"_29196":1257,"_20242":51957,"_5":13829,"_26574":51482,"_2824":51958},[],"`None` ↔ `Auto`",{"_3337":1429,"_29196":1257,"_20242":51960,"_5":13829,"_26574":51482,"_2824":51955},[],{"_3337":1430,"_29196":1257,"_20242":51962,"_5":13829,"_26574":51482,"_2824":51963},[],"Any → `Jitp`",{"_3337":1431,"_29196":1257,"_20242":51965,"_5":13829,"_26574":51482,"_2824":51966},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3337":1432,"_29196":1257,"_20242":51968,"_5":13829,"_26574":51482,"_2824":51969},[],"`Jitp` → `None` / `Auto`",{"_3337":1433,"_29196":1257,"_20242":51971,"_5":13829,"_26574":51482,"_2824":51972},[],"none (the template stays in the AWS account)",{"_3337":1434,"_29196":1257,"_20242":51974,"_5":13829,"_26574":51486,"_2824":51975},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3337":1435,"_29196":1257,"_20242":51977,"_5":13829,"_26574":51486,"_2824":51909},[],{"_3337":1436,"_29196":1257,"_20242":51979,"_5":13829,"_26574":51486,"_2824":51912},[],{"_3337":1437,"_29196":1257,"_20242":51981,"_5":13829,"_26574":51486,"_2824":51982},[],"`NotSynced` → `Active`",{"_3337":1438,"_29196":1257,"_20242":51984,"_5":13829,"_26574":51486,"_2824":51626},[],{"_3337":1439,"_29196":1257,"_20242":51986,"_5":13829,"_26574":51486,"_2824":51987},[],"`Active` → `Inactive`",{"_3337":1440,"_29196":1257,"_20242":51989,"_5":13829,"_26574":51486,"_2824":51990},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3337":1441,"_29196":1257,"_20242":51992,"_5":13829,"_26574":51486,"_2824":51993},[],"`Active` → `Revoked`",{"_3337":1442,"_29196":1257,"_20242":51995,"_5":13829,"_26574":51486,"_2824":51990},[],{"_3337":1443,"_29196":1257,"_20242":51997,"_5":13829,"_26574":51486,"_2824":51998},[],"`Inactive` / `Revoked` → `Active`",{"_3337":1444,"_29196":1257,"_20242":52000,"_5":13829,"_26574":51486,"_2824":51626},[],{"_3337":1445,"_29196":1257,"_20242":52002,"_5":13829,"_26574":51486,"_2824":52003},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3337":1446,"_29196":1257,"_20242":52005,"_5":13829,"_26574":51486,"_2824":52006},[],"none (these states are not synced to AWS)",{"_3337":1447,"_29196":1257,"_20242":52008,"_5":13829,"_26574":51490,"_2824":52009},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3337":1448,"_29196":1257,"_20242":52011,"_5":13829,"_26574":51490,"_2824":51909},[],{"_3337":1449,"_29196":1257,"_20242":52013,"_5":13829,"_26574":51490,"_2824":51912},[],{"_3337":1450,"_29196":1257,"_20242":52015,"_5":13829,"_26574":51490,"_2824":52016},[],"`Absent` → `Provisioned`",{"_3337":1451,"_29196":1257,"_20242":52018,"_5":13829,"_26574":51490,"_2824":52019},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3337":1452,"_29196":1257,"_20242":52021,"_5":13829,"_26574":51490,"_2824":52022},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3337":1453,"_29196":1257,"_20242":52024,"_5":13829,"_26574":51490,"_2824":52025},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3337":1454,"_29196":1257,"_20242":52027,"_5":13829,"_26574":51490,"_2824":52028},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3337":1455,"_29196":1257,"_20242":52030,"_5":13829,"_26574":51494,"_2824":52031},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3337":1456,"_29196":1257,"_20242":52033,"_5":13829,"_26574":51498,"_2824":52034},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3337":1457,"_29196":1257,"_20242":52036,"_5":13829,"_26574":51498,"_2824":52037},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3337":1458,"_29196":1257,"_20242":52039,"_5":13829,"_26574":51502,"_2824":52040},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3337":1459,"_29196":1257,"_20242":52042,"_5":13829,"_26574":51502,"_2824":52043},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3337":1460,"_29196":1257,"_20242":52045,"_5":13829,"_26574":51502,"_2824":52046},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3337":1461,"_29196":1257,"_20242":52048,"_5":13829,"_26574":51502,"_2824":52049},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3337":1462,"_29196":1257,"_20242":52051,"_5":13829,"_26574":51502,"_2824":52052},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3337":1463,"_29196":1257,"_20242":52054,"_5":13829,"_26574":51502,"_2824":52055},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3337":1464,"_29196":1257,"_20242":52057,"_5":13829,"_26574":51506,"_2824":52058},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3337":1465,"_29196":1257,"_20242":52060,"_5":13829,"_26574":51510,"_2824":52061},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3337":1466,"_29196":1257,"_20242":52063,"_5":13829,"_26574":51510,"_2824":52064},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3337":1467,"_29196":1257,"_20242":52066,"_5":13829,"_26574":51514,"_2824":52067},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3337":1468,"_29196":1257,"_20242":52069,"_5":13829,"_26574":51518,"_2824":52070},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3337":1469,"_29196":1257,"_20242":52072,"_5":13829,"_26574":51518,"_2824":52073},[],"Creates or updates the IoT policies configured in the DMS.",{"_3337":1470,"_29196":1257,"_20242":52075,"_5":13829,"_26574":51518,"_2824":52076},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3337":1471,"_29196":1257,"_20242":52078,"_5":13829,"_26574":51518,"_2824":52079},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3337":1472,"_29196":1257,"_20242":52081,"_5":13829,"_26574":51518,"_2824":52082},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3337":1473,"_29196":1257,"_20242":52084,"_5":13829,"_26574":51518,"_2824":52085},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3337":1474,"_29196":1257,"_20242":52087,"_5":13829,"_26574":51518,"_2824":52088},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3337":1475,"_29196":1257,"_20242":52090,"_5":13829,"_26574":51522,"_2824":52091},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3337":1476,"_29196":1257,"_20242":52093,"_5":13829,"_26574":51522,"_2824":52094},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3337":1477,"_29196":1257,"_20242":52096,"_5":13829,"_26574":51522,"_2824":52097},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3337":1478,"_29196":1257,"_20242":52099,"_5":13829,"_26574":51522,"_2824":52100},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3337":1479,"_29196":1257,"_20242":52102,"_5":13829,"_26574":51522,"_2824":52103},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3337":1480,"_29196":1257,"_20242":52105,"_5":13829,"_26574":51526,"_2824":52106},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3337":1481,"_29196":1257,"_20242":52108,"_5":13829,"_26574":51526,"_2824":52109},[],"The full flow from the device's perspective is:",{"_3337":1482,"_29196":1257,"_20242":52111,"_5":13829,"_26574":51526,"_2824":52112},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3337":1483,"_29196":1257,"_20242":52114,"_5":13829,"_26574":51530,"_2824":52115},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3337":1484,"_29196":1257,"_20242":52117,"_5":13829,"_26574":51530,"_2824":52118},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3337":1485,"_29196":1257,"_20242":52120,"_5":13829,"_26574":51530,"_2824":52121},[],"For the JITP flow to work correctly:",{"_3337":1486,"_29196":1257,"_20242":52123,"_5":13829,"_26574":51530,"_2824":52124},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3337":1487,"_29196":1257,"_20242":52126,"_5":13829,"_26574":51530,"_2824":52127},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3337":1488,"_29196":1257,"_20242":52129,"_5":13829,"_26574":51530,"_2824":52130},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3337":1489,"_29196":1257,"_20242":52132,"_5":13829,"_26574":51530,"_2824":52133},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3337":1490,"_29196":1257,"_20242":52135,"_5":13829,"_26574":51534,"_2824":52136},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3337":1491,"_29196":1257,"_20242":52138,"_5":13829,"_26574":51534,"_2824":52139},[],"Status in Lamassu",{"_3337":1492,"_29196":1257,"_20242":52141,"_5":13829,"_26574":51534,"_2824":52142},[],"Revocation reason",{"_3337":1493,"_29196":1257,"_20242":52144,"_5":13829,"_26574":51534,"_2824":52145},[],"Status in AWS IoT Core",{"_3337":1494,"_29196":1257,"_20242":52147,"_5":13829,"_26574":51534,"_2824":52148},[],"`Active`",{"_3337":1495,"_29196":1257,"_20242":52150,"_5":13829,"_26574":51534,"_2824":52151},[],"None",{"_3337":1496,"_29196":1257,"_20242":52153,"_5":13829,"_26574":51534,"_2824":52154},[],"`ACTIVE`",{"_3337":1497,"_29196":1257,"_20242":52156,"_5":13829,"_26574":51534,"_2824":52157},[],"`Revoked`",{"_3337":1498,"_29196":1257,"_20242":52159,"_5":13829,"_26574":51534,"_2824":52160},[],"`certificateHold`",{"_3337":1499,"_29196":1257,"_20242":52162,"_5":13829,"_26574":51534,"_2824":52163},[],"`INACTIVE`",{"_3337":1500,"_29196":1257,"_20242":52165,"_5":13829,"_26574":51534,"_2824":52157},[],{"_3337":1501,"_29196":1257,"_20242":52167,"_5":13829,"_26574":51534,"_2824":52168},[],"Any other reason",{"_3337":1502,"_29196":1257,"_20242":52170,"_5":13829,"_26574":51534,"_2824":52171},[],"`REVOKED`",{"_3337":1503,"_29196":1257,"_20242":52173,"_5":13829,"_26574":51534,"_2824":52174},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3337":1504,"_29196":1257,"_20242":52176,"_5":13829,"_26574":51538,"_2824":52177},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3337":1505,"_29196":1257,"_20242":52179,"_5":13829,"_26574":51538,"_2824":52180},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3337":1506,"_29196":1257,"_20242":52182,"_5":13829,"_26574":51538,"_2824":52183},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3337":1507,"_29196":1257,"_20242":52185,"_5":13829,"_26574":51542,"_2824":52186},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3337":1508,"_29196":1257,"_20242":52188,"_5":13829,"_26574":51542,"_2824":52189},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3337":1509,"_29196":1257,"_20242":52191,"_5":13829,"_26574":51546,"_2824":52192},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3337":1510,"_29196":1257,"_20242":52194,"_5":13829,"_26574":51546,"_2824":52195},[],"There are two action types:",{"_3337":1511,"_29196":1257,"_20242":52197,"_5":13829,"_26574":51546,"_2824":52198},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3337":1512,"_29196":1257,"_20242":52200,"_5":13829,"_26574":51546,"_2824":52201},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3337":1513,"_29196":1257,"_20242":52203,"_5":13829,"_26574":51546,"_2824":52204},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3337":1514,"_29196":1257,"_20242":52206,"_5":13829,"_26574":51550,"_2824":52207},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3337":1515,"_29196":1257,"_20242":52209,"_5":13829,"_26574":51550,"_2824":52210},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3337":1516,"_29196":1257,"_20242":52212,"_5":13829,"_26574":51550,"_2824":52213},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3337":1517,"_29196":1257,"_20242":52215,"_5":13829,"_26574":51554,"_2824":52216},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3337":1518,"_29196":1257,"_20242":52218,"_5":13829,"_26574":51554,"_2824":52219},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3337":1519,"_29196":1257,"_20242":52221,"_5":13829,"_26574":51554,"_2824":52222},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3337":1520,"_29196":1257,"_20242":52224,"_5":13829,"_26574":51554,"_2824":52225},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3337":1521,"_29196":1257,"_20242":52227,"_5":13829,"_26574":51554,"_2824":52228},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3337":1522,"_29196":1257,"_20242":52230,"_5":13829,"_26574":51554,"_2824":52231},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3337":1523,"_29196":1257,"_20242":52233,"_5":13829,"_26574":51554,"_2824":52234},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3337":1524,"_29196":1257,"_20242":52236,"_5":13829,"_26574":51554,"_2824":52237},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3337":1525,"_29196":1257,"_20242":52239,"_5":13829,"_26574":51554,"_2824":52240},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3337":1526,"_29196":1257,"_20242":52242,"_5":13829,"_26574":51554,"_2824":52243},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3337":1527,"_29196":1257,"_20242":52245,"_5":13829,"_26574":51554,"_2824":52246},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3337":1528,"_29196":1257,"_20242":52248,"_5":13829,"_26574":51554,"_2824":52249},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3337":1529,"_29196":1257,"_20242":52251,"_5":13829,"_26574":51554,"_2824":52252},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3337":1530,"_29196":1257,"_20242":52254,"_5":13829,"_26574":51554,"_2824":52255},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3337":1531,"_29196":1257,"_20242":52257,"_5":13829,"_26574":51554,"_2824":52258},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3337":1532,"_29196":1257,"_20242":52260,"_5":13829,"_26574":51554,"_2824":52261},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3337":1533,"_29196":1257,"_20242":52263,"_5":13829,"_26574":51554,"_2824":52264},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3337":1534,"_29196":1257,"_20242":52266,"_5":13829,"_26574":51554,"_2824":52267},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3337":1535,"_29196":1257,"_20242":52269,"_5":13829,"_26574":51554,"_2824":52270},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3337":1536,"_29196":1257,"_20242":52272,"_5":13829,"_26574":51554,"_2824":52273},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3337":1537,"_29196":1257,"_20242":52275,"_5":13829,"_26574":51554,"_2824":52276},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3337":1538,"_29196":1257,"_20242":52278,"_5":13829,"_26574":51554,"_2824":52279},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3337":1539,"_29196":1257,"_20242":52281,"_5":13829,"_26574":51554,"_2824":52282},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3337":1540,"_29196":1257,"_20242":52284,"_5":13829,"_26574":51554,"_2824":52285},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3337":1541,"_29196":1541,"_5":14181,"_2824":49985,"_29540":52287,"_20242":52288,"_26574":1541},[47528,48977,49985],[],{"_3337":1542,"_29196":1541,"_20242":52290,"_5":13829,"_26574":1541,"_2824":52291},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3337":1543,"_29196":1541,"_5":29537,"_20242":52293,"_26574":52294,"_2824":52295},[],"/docs/pr-preview/pr-57/platform/iot-fleets/overview#start-here","Start here",{"_3337":1544,"_29196":1541,"_5":29537,"_20242":52297,"_26574":52298,"_2824":49983},[],"/docs/pr-preview/pr-57/platform/iot-fleets/overview#devices-and-identities",{"_3337":1545,"_29196":1541,"_5":29537,"_20242":52300,"_26574":52301,"_2824":50166},[],"/docs/pr-preview/pr-57/platform/iot-fleets/overview#enrollment-with-pki",{"_3337":1546,"_29196":1541,"_5":29537,"_20242":52303,"_26574":52304,"_2824":51447},[],"/docs/pr-preview/pr-57/platform/iot-fleets/overview#integrations",{"_3337":1547,"_29196":1541,"_5":29537,"_20242":52306,"_26574":52307,"_2824":52308},[],"/docs/pr-preview/pr-57/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3337":1548,"_29196":1541,"_20242":52310,"_5":13829,"_26574":1541,"_2824":52311},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3337":1549,"_29196":1541,"_20242":52313,"_5":13829,"_26574":52294,"_2824":52314},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3337":1550,"_29196":1541,"_20242":52316,"_5":13829,"_26574":52294,"_2824":52317},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3337":1551,"_29196":1541,"_20242":52319,"_5":13829,"_26574":52298,"_2824":52320},[],"Resource",{"_3337":1552,"_29196":1541,"_20242":52322,"_5":13829,"_26574":52298,"_2824":52323},[],"What it represents",{"_3337":1553,"_29196":1541,"_20242":52325,"_5":13829,"_26574":52298,"_2824":52326},[],"**Device**",{"_3337":1554,"_29196":1541,"_20242":52328,"_5":13829,"_26574":52298,"_2824":52329},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3337":1555,"_29196":1541,"_20242":52331,"_5":13829,"_26574":52298,"_2824":52332},[],"**Identity**",{"_3337":1556,"_29196":1541,"_20242":52334,"_5":13829,"_26574":52298,"_2824":52335},[],"The device's association with its certificates: an active version and a history.",{"_3337":1557,"_29196":1541,"_20242":52337,"_5":13829,"_26574":52298,"_2824":52338},[],"**DMS**",{"_3337":1558,"_29196":1541,"_20242":52340,"_5":13829,"_26574":52298,"_2824":52341},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3337":1559,"_29196":1541,"_20242":52343,"_5":13829,"_26574":52298,"_2824":52344},[],"**Fleet**",{"_3337":1560,"_29196":1541,"_20242":52346,"_5":13829,"_26574":52298,"_2824":52347},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3337":1561,"_29196":1541,"_20242":52349,"_5":13829,"_26574":52298,"_2824":52350},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3337":1562,"_29196":1541,"_20242":52352,"_5":13829,"_26574":52298,"_2824":52353},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3337":1563,"_29196":1541,"_20242":52355,"_5":13829,"_26574":52301,"_2824":52356},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3337":1564,"_29196":1541,"_20242":52358,"_5":13829,"_26574":52301,"_2824":52359},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3337":1565,"_29196":1541,"_20242":52361,"_5":13829,"_26574":52301,"_2824":52362},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3337":1566,"_29196":1541,"_20242":52364,"_5":13829,"_26574":52301,"_2824":52365},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3337":1567,"_29196":1541,"_20242":52367,"_5":13829,"_26574":52301,"_2824":52368},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3337":1568,"_29196":1541,"_20242":52370,"_5":13829,"_26574":52301,"_2824":52371},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3337":1569,"_29196":1541,"_20242":52373,"_5":13829,"_26574":52301,"_2824":52374},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3337":1570,"_29196":1541,"_20242":52376,"_5":13829,"_26574":52301,"_2824":52377},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3337":1571,"_29196":1541,"_20242":52379,"_5":13829,"_26574":52304,"_2824":52380},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3337":1572,"_29196":1541,"_20242":52382,"_5":13829,"_26574":52304,"_2824":52383},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3337":1573,"_29196":1541,"_20242":52385,"_5":13829,"_26574":52307,"_2824":52386},[],"Participant",{"_3337":1574,"_29196":1541,"_20242":52388,"_5":13829,"_26574":52307,"_2824":52389},[],"Responsibility",{"_3337":1575,"_29196":1541,"_20242":52391,"_5":13829,"_26574":52307,"_2824":52392},[],"PKI administrator",{"_3337":1576,"_29196":1541,"_20242":52394,"_5":13829,"_26574":52307,"_2824":52395},[],"CA, issuance profile, chain and revocation publication.",{"_3337":1577,"_29196":1541,"_20242":52397,"_5":13829,"_26574":52307,"_2824":52398},[],"Provisioning administrator",{"_3337":1578,"_29196":1541,"_20242":52400,"_5":13829,"_26574":52307,"_2824":52401},[],"DMS, admission, authentication per operation and inventory.",{"_3337":1579,"_29196":1541,"_20242":52403,"_5":13829,"_26574":52307,"_2824":52404},[],"Device integrator",{"_3337":1580,"_29196":1541,"_20242":52406,"_5":13829,"_26574":52307,"_2824":52407},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3337":1581,"_29196":1541,"_20242":52409,"_5":13829,"_26574":52307,"_2824":52410},[],"Consumer integrator",{"_3337":1582,"_29196":1541,"_20242":52412,"_5":13829,"_26574":52307,"_2824":52413},[],"Trusted issuers, validation and device permissions in the destination.",{"_3337":1583,"_29196":1541,"_20242":52415,"_5":13829,"_26574":52307,"_2824":52416},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3337":1584,"_29196":1584,"_5":14181,"_2824":52418,"_29540":52419,"_20242":52421,"_26574":1584},"Enroll and connect your first device",[47528,48977,49985,52420],"Getting started",[],{"_3337":1585,"_29196":1584,"_20242":52423,"_5":13829,"_26574":1584,"_2824":52424},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3337":1586,"_29196":1584,"_5":29537,"_20242":52426,"_26574":52427,"_2824":47538},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3337":1587,"_29196":1584,"_5":29537,"_20242":52429,"_26574":52430,"_2824":52431},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3337":1588,"_29196":1584,"_5":29537,"_20242":52433,"_26574":52434,"_2824":52435},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3337":1589,"_29196":1584,"_5":29537,"_20242":52437,"_26574":52438,"_2824":52439},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3337":1590,"_29196":1584,"_5":29537,"_20242":52441,"_26574":52442,"_2824":52443},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3337":1591,"_29196":1584,"_5":29537,"_20242":52445,"_26574":52446,"_2824":52447},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3337":1592,"_29196":1584,"_5":29537,"_20242":52449,"_26574":52450,"_2824":52451},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3337":1593,"_29196":1584,"_5":29537,"_20242":52453,"_26574":52454,"_2824":52455},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3337":1594,"_29196":1584,"_20242":52457,"_5":13829,"_26574":1584,"_2824":52458},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3337":1595,"_29196":1584,"_20242":52460,"_5":13829,"_26574":52427,"_2824":52461},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3337":1596,"_29196":1584,"_20242":52463,"_5":13829,"_26574":52427,"_2824":52464},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3337":1597,"_29196":1584,"_20242":52466,"_5":13829,"_26574":52427,"_2824":52467},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3337":1598,"_29196":1584,"_20242":52469,"_5":13829,"_26574":52427,"_2824":52470},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3337":1599,"_29196":1584,"_20242":52472,"_5":13829,"_26574":52427,"_2824":52473},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3337":1600,"_29196":1584,"_20242":52475,"_5":13829,"_26574":52430,"_2824":52476},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3337":1601,"_29196":1584,"_20242":52478,"_5":13829,"_26574":52430,"_2824":52479},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3337":1602,"_29196":1584,"_20242":52481,"_5":13829,"_26574":52434,"_2824":52482},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3337":1603,"_29196":1584,"_20242":52484,"_5":13829,"_26574":52434,"_2824":52485},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3337":1604,"_29196":1584,"_20242":52487,"_5":13829,"_26574":52434,"_2824":52488},[],"Setting",{"_3337":1605,"_29196":1584,"_20242":52490,"_5":13829,"_26574":52434,"_2824":52491},[],"Evaluation value",{"_3337":1606,"_29196":1584,"_20242":52493,"_5":13829,"_26574":52434,"_2824":52494},[],"Enrollment CA",{"_3337":1607,"_29196":1584,"_20242":52496,"_5":13829,"_26574":52434,"_2824":52497},[],"Issuing root from `device-root.pem`.",{"_3337":1608,"_29196":1584,"_20242":52499,"_5":13829,"_26574":52434,"_2824":50296},[],{"_3337":1609,"_29196":1584,"_20242":52501,"_5":13829,"_26574":52434,"_2824":52502},[],"The 1-hour leaf profile you just prepared.",{"_3337":1610,"_29196":1584,"_20242":52504,"_5":13829,"_26574":52434,"_2824":52505},[],"Protocol / Registration Mode",{"_3337":1611,"_29196":1584,"_20242":52507,"_5":13829,"_26574":52434,"_2824":52508},[],"`EST_RFC7030` / `JITP`.",{"_3337":1612,"_29196":1584,"_20242":52510,"_5":13829,"_26574":52434,"_2824":52511},[],"Verify CSR Signature",{"_3337":1613,"_29196":1584,"_20242":52513,"_5":13829,"_26574":52434,"_2824":52514},[],"Enabled.",{"_3337":1614,"_29196":1584,"_20242":52516,"_5":13829,"_26574":52434,"_2824":52517},[],"Enable Replaceable Enrollment",{"_3337":1615,"_29196":1584,"_20242":52519,"_5":13829,"_26574":52434,"_2824":52520},[],"Disabled; the ID must be new.",{"_3337":1616,"_29196":1584,"_20242":52522,"_5":13829,"_26574":52434,"_2824":52523},[],"Initial authentication",{"_3337":1617,"_29196":1584,"_20242":52525,"_5":13829,"_26574":52434,"_2824":52526},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3337":1618,"_29196":1584,"_20242":52528,"_5":13829,"_26574":52434,"_2824":52529},[],"Renewal authentication",{"_3337":1619,"_29196":1584,"_20242":52531,"_5":13829,"_26574":52434,"_2824":52532},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3337":1620,"_29196":1584,"_20242":52534,"_5":13829,"_26574":52434,"_2824":52535},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3337":1621,"_29196":1584,"_20242":52537,"_5":13829,"_26574":52434,"_2824":52538},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3337":1622,"_29196":1584,"_20242":52540,"_5":13829,"_26574":52434,"_2824":52541},[],"Re-enrollment Delta",{"_3337":1623,"_29196":1584,"_20242":52543,"_5":13829,"_26574":52434,"_2824":52544},[],"1 hour.",{"_3337":1624,"_29196":1584,"_20242":52546,"_5":13829,"_26574":52434,"_2824":52547},[],"Preventive / Critical Delta",{"_3337":1625,"_29196":1584,"_20242":52549,"_5":13829,"_26574":52434,"_2824":52550},[],"30 minutes / 10 minutes.",{"_3337":1626,"_29196":1584,"_20242":52552,"_5":13829,"_26574":52434,"_2824":52553},[],"Revoke on Re-enrollment",{"_3337":1627,"_29196":1584,"_20242":52555,"_5":13829,"_26574":52434,"_2824":52556},[],"Disabled to test the successor before retiring the previous identity.",{"_3337":1628,"_29196":1584,"_20242":52558,"_5":13829,"_26574":52434,"_2824":50304},[],{"_3337":1629,"_29196":1584,"_20242":52560,"_5":13829,"_26574":52434,"_2824":52561},[],"Disabled; the operational key is generated in the client.",{"_3337":1630,"_29196":1584,"_20242":52563,"_5":13829,"_26574":52434,"_2824":52564},[],"CA Distribution",{"_3337":1631,"_29196":1584,"_20242":52566,"_5":13829,"_26574":52434,"_2824":52567},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3337":1632,"_29196":1584,"_20242":52569,"_5":13829,"_26574":52434,"_2824":52570},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3337":1633,"_29196":1584,"_20242":52572,"_5":13829,"_26574":52438,"_2824":52573},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3337":1634,"_29196":1584,"_20242":52575,"_5":13829,"_26574":52438,"_2824":52576},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3337":1635,"_29196":1584,"_20242":52578,"_5":13829,"_26574":52442,"_2824":52579},[],"Generate a new key and CSR with the selected identifier:",{"_3337":1636,"_29196":1584,"_20242":52581,"_5":13829,"_26574":52442,"_2824":52582},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3337":1637,"_29196":1584,"_20242":52584,"_5":13829,"_26574":52442,"_2824":52585},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3337":1638,"_29196":1584,"_20242":52587,"_5":13829,"_26574":52446,"_2824":52588},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3337":1639,"_29196":1584,"_20242":52590,"_5":13829,"_26574":52446,"_2824":52591},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3337":1640,"_29196":1584,"_20242":52593,"_5":13829,"_26574":52450,"_2824":52594},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3337":1641,"_29196":1584,"_20242":52596,"_5":13829,"_26574":52450,"_2824":52597},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3337":1642,"_29196":1584,"_20242":52599,"_5":13829,"_26574":52450,"_2824":52600},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3337":1643,"_29196":1584,"_20242":52602,"_5":13829,"_26574":52450,"_2824":52603},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3337":1644,"_29196":1584,"_20242":52605,"_5":13829,"_26574":52450,"_2824":52606},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3337":1645,"_29196":1584,"_20242":52608,"_5":13829,"_26574":52454,"_2824":52609},[],"Check",{"_3337":1646,"_29196":1584,"_20242":52611,"_5":13829,"_26574":52454,"_2824":52612},[],"Expected result",{"_3337":1647,"_29196":1584,"_20242":52614,"_5":13829,"_26574":52454,"_2824":52615},[],"Registration",{"_3337":1648,"_29196":1584,"_20242":52617,"_5":13829,"_26574":52454,"_2824":52618},[],"ID created automatically and correct DMS.",{"_3337":1649,"_29196":1584,"_20242":52620,"_5":13829,"_26574":52454,"_2824":51873},[],{"_3337":1650,"_29196":1584,"_20242":52622,"_5":13829,"_26574":52454,"_2824":52623},[],"CN, profile, serial and key verified.",{"_3337":1651,"_29196":1584,"_20242":52625,"_5":13829,"_26574":52454,"_2824":52626},[],"Inventory",{"_3337":1652,"_29196":1584,"_20242":52628,"_5":13829,"_26574":52454,"_2824":52629},[],"Received serial visible as the current identity and in history.",{"_3337":1653,"_29196":1584,"_20242":52631,"_5":13829,"_26574":52454,"_2824":52632},[],"Consumer",{"_3337":1654,"_29196":1584,"_20242":52634,"_5":13829,"_26574":52454,"_2824":52635},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3337":1655,"_29196":1584,"_20242":52637,"_5":13829,"_26574":52454,"_2824":52638},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3337":1656,"_29196":1584,"_20242":52640,"_5":13829,"_26574":52454,"_2824":52641},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3337":1657,"_29196":1657,"_5":14181,"_2824":50001,"_29540":52643,"_20242":52644,"_26574":1657},[47528,48977,49985,52420],[],{"_3337":1658,"_29196":1657,"_20242":52646,"_5":13829,"_26574":1657,"_2824":52647},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3337":1659,"_29196":1657,"_5":29537,"_20242":52649,"_26574":52650,"_2824":47538},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3337":1660,"_29196":1657,"_5":29537,"_20242":52652,"_26574":52653,"_2824":52654},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3337":1661,"_29196":1657,"_5":29537,"_20242":52656,"_26574":52657,"_2824":52658},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3337":1662,"_29196":1657,"_5":29537,"_20242":52660,"_26574":52661,"_2824":52662},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3337":1663,"_29196":1657,"_5":29537,"_20242":52664,"_26574":52665,"_2824":52666},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3337":1664,"_29196":1657,"_5":29537,"_20242":52668,"_26574":52669,"_2824":52670},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3337":1665,"_29196":1657,"_5":29537,"_20242":52672,"_26574":52673,"_2824":52612},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3337":1666,"_29196":1657,"_5":29537,"_20242":52675,"_26574":52676,"_2824":52677},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3337":1667,"_29196":1657,"_5":29537,"_20242":52679,"_26574":52680,"_2824":52681},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3337":1668,"_29196":1657,"_20242":52683,"_5":13829,"_26574":1657,"_2824":52684},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3337":1669,"_29196":1657,"_20242":52686,"_5":13829,"_26574":1657,"_2824":52687},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3337":1670,"_29196":1657,"_20242":52689,"_5":13829,"_26574":52650,"_2824":52690},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3337":1671,"_29196":1657,"_20242":52692,"_5":13829,"_26574":52650,"_2824":52693},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3337":1672,"_29196":1657,"_20242":52695,"_5":13829,"_26574":52650,"_2824":52696},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3337":1673,"_29196":1657,"_20242":52698,"_5":13829,"_26574":52650,"_2824":52699},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3337":1674,"_29196":1657,"_20242":52701,"_5":13829,"_26574":52653,"_2824":52702},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3337":1675,"_29196":1657,"_20242":52704,"_5":13829,"_26574":52653,"_2824":52705},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3337":1676,"_29196":1657,"_20242":52707,"_5":13829,"_26574":52653,"_2824":52708},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3337":1677,"_29196":1657,"_20242":52710,"_5":13829,"_26574":52653,"_2824":52711},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3337":1678,"_29196":1657,"_20242":52713,"_5":13829,"_26574":52653,"_2824":52714},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3337":1679,"_29196":1657,"_20242":52716,"_5":13829,"_26574":52653,"_2824":52717},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3337":1680,"_29196":1657,"_20242":52719,"_5":13829,"_26574":52653,"_2824":52720},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3337":1681,"_29196":1657,"_20242":52722,"_5":13829,"_26574":52653,"_2824":52723},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3337":1682,"_29196":1657,"_20242":52725,"_5":13829,"_26574":52657,"_2824":52726},[],"Open **Managed Devices** and the registration action. Complete:",{"_3337":1683,"_29196":1657,"_20242":52728,"_5":13829,"_26574":52657,"_2824":52729},[],"**Device ID**: `device-001`.",{"_3337":1684,"_29196":1657,"_20242":52731,"_5":13829,"_26574":52657,"_2824":52732},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3337":1685,"_29196":1657,"_20242":52734,"_5":13829,"_26574":52657,"_2824":52735},[],"**Icon** and **Tags**: optional classification.",{"_3337":1686,"_29196":1657,"_20242":52737,"_5":13829,"_26574":52657,"_2824":52738},[],"Confirm registration.",{"_3337":1687,"_29196":1657,"_20242":52740,"_5":13829,"_26574":52661,"_2824":52741},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3337":1688,"_29196":1657,"_20242":52743,"_5":13829,"_26574":52661,"_2824":52744},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3337":1689,"_29196":1657,"_20242":52746,"_5":13829,"_26574":52665,"_2824":52747},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3337":1690,"_29196":1657,"_20242":52749,"_5":13829,"_26574":52665,"_2824":52750},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3337":1691,"_29196":1657,"_20242":52752,"_5":13829,"_26574":52669,"_2824":52753},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3337":1692,"_29196":1657,"_20242":52755,"_5":13829,"_26574":52669,"_2824":52756},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3337":1693,"_29196":1657,"_20242":52758,"_5":13829,"_26574":52673,"_2824":52609},[],{"_3337":1694,"_29196":1657,"_20242":52760,"_5":13829,"_26574":52673,"_2824":52761},[],"Result",{"_3337":1695,"_29196":1657,"_20242":52763,"_5":13829,"_26574":52673,"_2824":51856},[],{"_3337":1696,"_29196":1657,"_20242":52765,"_5":13829,"_26574":52673,"_2824":52766},[],"`device-001` appears in inventory with the expected DMS.",{"_3337":1697,"_29196":1657,"_20242":52768,"_5":13829,"_26574":52673,"_2824":52769},[],"Current identity",{"_3337":1698,"_29196":1657,"_20242":52771,"_5":13829,"_26574":52673,"_2824":52772},[],"The associated certificate matches the one you verified in PKI.",{"_3337":1699,"_29196":1657,"_20242":52774,"_5":13829,"_26574":52673,"_2824":52775},[],"History",{"_3337":1700,"_29196":1657,"_20242":52777,"_5":13829,"_26574":52673,"_2824":52778},[],"The associated issuance appears with its serial number and dates.",{"_3337":1701,"_29196":1657,"_20242":52780,"_5":13829,"_26574":52673,"_2824":52781},[],"Key and certificate",{"_3337":1702,"_29196":1657,"_20242":52783,"_5":13829,"_26574":52673,"_2824":52784},[],"You have the verified pair ready to install on the device.",{"_3337":1703,"_29196":1657,"_20242":52786,"_5":13829,"_26574":52676,"_2824":52787},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3337":1704,"_29196":1657,"_20242":52789,"_5":13829,"_26574":52676,"_2824":52790},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3337":1705,"_29196":1657,"_20242":52792,"_5":13829,"_26574":52676,"_2824":52793},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3337":1706,"_29196":1657,"_20242":52795,"_5":13829,"_26574":52676,"_2824":52796},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3337":1707,"_29196":1657,"_20242":52798,"_5":13829,"_26574":52680,"_2824":52799},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3337":1708,"_29196":1657,"_20242":52801,"_5":13829,"_26574":52680,"_2824":52802},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3337":1709,"_29196":1657,"_20242":52804,"_5":13829,"_26574":52680,"_2824":52805},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3337":1710,"_29196":1710,"_5":14181,"_2824":52807,"_29540":52808,"_20242":52809,"_26574":1710},"Lamassu IoT Platform",[47528,48977],[],{"_3337":1711,"_29196":1710,"_20242":52811,"_5":13829,"_26574":1710,"_2824":52812},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3337":1712,"_29196":1710,"_5":29537,"_20242":52814,"_26574":52815,"_2824":52295},[],"/docs/pr-preview/pr-57/platform/overview#start-here",{"_3337":1713,"_29196":1710,"_5":29537,"_20242":52817,"_26574":52818,"_2824":52819},[],"/docs/pr-preview/pr-57/platform/overview#choose-your-path","Choose your path",{"_3337":1714,"_29196":1710,"_5":29537,"_20242":52821,"_26574":52822,"_2824":52823},[],"/docs/pr-preview/pr-57/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3337":1715,"_29196":1710,"_5":29537,"_20242":52825,"_26574":52826,"_2824":52827},[],"/docs/pr-preview/pr-57/platform/overview#core-capabilities","Core capabilities",{"_3337":1716,"_29196":1710,"_5":29537,"_20242":52829,"_26574":52830,"_2824":52831},[],"/docs/pr-preview/pr-57/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3337":1717,"_29196":1710,"_5":29537,"_20242":52833,"_26574":52834,"_2824":52835},[],"/docs/pr-preview/pr-57/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3337":1718,"_29196":1710,"_5":29537,"_20242":52837,"_26574":52838,"_2824":52839},[],"/docs/pr-preview/pr-57/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3337":1719,"_29196":1710,"_5":29537,"_20242":52841,"_26574":52842,"_2824":52843},[],"/docs/pr-preview/pr-57/platform/overview#automate-device-identities","Automate device identities",{"_3337":1720,"_29196":1710,"_5":29537,"_20242":52845,"_26574":52846,"_2824":52847},[],"/docs/pr-preview/pr-57/platform/overview#publish-validation-status","Publish validation status",{"_3337":1721,"_29196":1710,"_5":29537,"_20242":52849,"_26574":52850,"_2824":52851},[],"/docs/pr-preview/pr-57/platform/overview#react-to-events","React to events",{"_3337":1722,"_29196":1710,"_5":29537,"_20242":52853,"_26574":52854,"_2824":52855},[],"/docs/pr-preview/pr-57/platform/overview#operational-reference","Operational reference",{"_3337":1723,"_29196":1710,"_20242":52857,"_5":13829,"_26574":1710,"_2824":52858},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3337":1724,"_29196":1710,"_20242":52860,"_5":13829,"_26574":52815,"_2824":52861},[],"Choose the result you need:",{"_3337":1725,"_29196":1710,"_20242":52863,"_5":13829,"_26574":52815,"_2824":52864},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3337":1726,"_29196":1710,"_20242":52866,"_5":13829,"_26574":52815,"_2824":52867},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3337":1727,"_29196":1710,"_20242":52869,"_5":13829,"_26574":52815,"_2824":52870},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3337":1728,"_29196":1710,"_20242":52872,"_5":13829,"_26574":52818,"_2824":52873},[],"Section",{"_3337":1729,"_29196":1710,"_20242":52875,"_5":13829,"_26574":52818,"_2824":52876},[],"What you manage",{"_3337":1730,"_29196":1710,"_20242":52878,"_5":13829,"_26574":52818,"_2824":52879},[],"Entry point",{"_3337":1731,"_29196":1710,"_20242":52881,"_5":13829,"_26574":52818,"_2824":52882},[],"**PKI**",{"_3337":1732,"_29196":1710,"_20242":52884,"_5":13829,"_26574":52818,"_2824":52885},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3337":1733,"_29196":1710,"_20242":52887,"_5":13829,"_26574":52818,"_2824":52888},[],"PKI overview",{"_3337":1734,"_29196":1710,"_20242":52890,"_5":13829,"_26574":52818,"_2824":52891},[],"**IoT Fleets**",{"_3337":1735,"_29196":1710,"_20242":52893,"_5":13829,"_26574":52818,"_2824":52894},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3337":1736,"_29196":1710,"_20242":52896,"_5":13829,"_26574":52818,"_2824":52897},[],"IoT Fleets overview",{"_3337":1737,"_29196":1710,"_20242":52899,"_5":13829,"_26574":52818,"_2824":52900},[],"**Administration**",{"_3337":1738,"_29196":1710,"_20242":52902,"_5":13829,"_26574":52818,"_2824":52903},[],"Operator permissions, audit and event subscriptions.",{"_3337":1739,"_29196":1710,"_20242":52905,"_5":13829,"_26574":52818,"_2824":48975},[],{"_3337":1740,"_29196":1710,"_20242":52907,"_5":13829,"_26574":52818,"_2824":52908},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3337":1741,"_29196":1710,"_20242":52910,"_5":13829,"_26574":52822,"_2824":52911},[],"An identity's journey connects four responsibilities:",{"_3337":1742,"_29196":1710,"_20242":52913,"_5":13829,"_26574":52822,"_2824":52914},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3337":1743,"_29196":1710,"_20242":52916,"_5":13829,"_26574":52822,"_2824":52917},[],"The provisioning administrator configures the DMS and initial trust.",{"_3337":1744,"_29196":1710,"_20242":52919,"_5":13829,"_26574":52822,"_2824":52920},[],"The device client requests a certificate and installs it with the matching key.",{"_3337":1745,"_29196":1710,"_20242":52922,"_5":13829,"_26574":52822,"_2824":52923},[],"The consumer validates the identity and applies its access permissions.",{"_3337":1746,"_29196":1710,"_20242":52925,"_5":13829,"_26574":52822,"_2824":52926},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3337":1747,"_29196":1710,"_20242":52928,"_5":13829,"_26574":52830,"_2824":52929},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3337":1748,"_29196":1710,"_20242":52931,"_5":13829,"_26574":52834,"_2824":52932},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3337":1749,"_29196":1710,"_20242":52934,"_5":13829,"_26574":52838,"_2824":52935},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3337":1750,"_29196":1710,"_20242":52937,"_5":13829,"_26574":52842,"_2824":52938},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3337":1751,"_29196":1710,"_20242":52940,"_5":13829,"_26574":52846,"_2824":52941},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3337":1752,"_29196":1710,"_20242":52943,"_5":13829,"_26574":52850,"_2824":52944},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3337":1753,"_29196":1710,"_20242":52946,"_5":13829,"_26574":52854,"_2824":52389},[],{"_3337":1754,"_29196":1710,"_20242":52948,"_5":13829,"_26574":52854,"_2824":52949},[],"What it prepares or checks",{"_3337":1755,"_29196":1710,"_20242":52951,"_5":13829,"_26574":52854,"_2824":52392},[],{"_3337":1756,"_29196":1710,"_20242":52953,"_5":13829,"_26574":52854,"_2824":52954},[],"Key custody, CA hierarchy, profiles and validation.",{"_3337":1757,"_29196":1710,"_20242":52956,"_5":13829,"_26574":52854,"_2824":52957},[],"Fleet administrator",{"_3337":1758,"_29196":1710,"_20242":52959,"_5":13829,"_26574":52854,"_2824":52960},[],"DMS, device admission, renewal policy and inventory.",{"_3337":1759,"_29196":1710,"_20242":52962,"_5":13829,"_26574":52854,"_2824":52404},[],{"_3337":1760,"_29196":1710,"_20242":52964,"_5":13829,"_26574":52854,"_2824":52965},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3337":1761,"_29196":1710,"_20242":52967,"_5":13829,"_26574":52854,"_2824":52410},[],{"_3337":1762,"_29196":1710,"_20242":52969,"_5":13829,"_26574":52854,"_2824":52970},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3337":1763,"_29196":1710,"_20242":52972,"_5":13829,"_26574":52854,"_2824":52973},[],"Infrastructure operator",{"_3337":1764,"_29196":1710,"_20242":52975,"_5":13829,"_26574":52854,"_2824":52976},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3337":1765,"_29196":1710,"_20242":52978,"_5":13829,"_26574":52854,"_2824":52979},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3337":1766,"_29196":1766,"_5":14181,"_2824":52981,"_29540":52982,"_20242":52985,"_26574":1766},"CA hierarchy and rotation",[47528,48977,52983,52984],"PKI","Keys, authorities and certificates",[],{"_3337":1767,"_29196":1766,"_20242":52987,"_5":13829,"_26574":1766,"_2824":52988},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3337":1768,"_29196":1766,"_5":29537,"_20242":52990,"_26574":52991,"_2824":52992},[],"/docs/pr-preview/pr-57/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3337":1769,"_29196":1766,"_5":29537,"_20242":52994,"_26574":52995,"_2824":52996},[],"/docs/pr-preview/pr-57/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3337":1770,"_29196":1766,"_5":29537,"_20242":52998,"_26574":52999,"_2824":53000},[],"/docs/pr-preview/pr-57/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3337":1771,"_29196":1766,"_5":29537,"_20242":53002,"_26574":53003,"_2824":53004},[],"/docs/pr-preview/pr-57/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3337":1772,"_29196":1766,"_5":29537,"_20242":53006,"_26574":53007,"_2824":53008},[],"/docs/pr-preview/pr-57/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3337":1773,"_29196":1766,"_5":29537,"_20242":53010,"_26574":53011,"_2824":53012},[],"/docs/pr-preview/pr-57/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3337":1774,"_29196":1766,"_5":29537,"_20242":53014,"_26574":53015,"_2824":53016},[],"/docs/pr-preview/pr-57/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3337":1775,"_29196":1766,"_5":29537,"_20242":53018,"_26574":53019,"_2824":53020},[],"/docs/pr-preview/pr-57/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3337":1776,"_29196":1766,"_5":29537,"_20242":53022,"_26574":53023,"_2824":53024},[],"/docs/pr-preview/pr-57/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3337":1777,"_29196":1766,"_5":29537,"_20242":53026,"_26574":53027,"_2824":53028},[],"/docs/pr-preview/pr-57/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3337":1778,"_29196":1766,"_5":29537,"_20242":53030,"_26574":53031,"_2824":53032},[],"/docs/pr-preview/pr-57/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3337":1779,"_29196":1766,"_5":29537,"_20242":53034,"_26574":53035,"_2824":53036},[],"/docs/pr-preview/pr-57/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3337":1780,"_29196":1766,"_20242":53038,"_5":13829,"_26574":1766,"_2824":53039},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3337":1781,"_29196":1766,"_20242":53041,"_5":13829,"_26574":1766,"_2824":53042},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3337":1782,"_29196":1766,"_20242":53044,"_5":13829,"_26574":52991,"_2824":53045},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3337":1783,"_29196":1766,"_20242":53047,"_5":13829,"_26574":52991,"_2824":53048},[],"environment, such as production and preproduction;",{"_3337":1784,"_29196":1766,"_20242":53050,"_5":13829,"_26574":52991,"_2824":53051},[],"owner or operating team;",{"_3337":1785,"_29196":1766,"_20242":53053,"_5":13829,"_26574":52991,"_2824":53054},[],"device family or manufacturing process;",{"_3337":1786,"_29196":1766,"_20242":53056,"_5":13829,"_26574":52991,"_2824":53057},[],"region or regulatory requirement;",{"_3337":1787,"_29196":1766,"_20242":53059,"_5":13829,"_26574":52991,"_2824":53060},[],"cryptographic engine or key policy;",{"_3337":1788,"_29196":1766,"_20242":53062,"_5":13829,"_26574":52991,"_2824":53063},[],"maintenance window and renewal cadence.",{"_3337":1789,"_29196":1766,"_20242":53065,"_5":13829,"_26574":52991,"_2824":53066},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3337":1790,"_29196":1766,"_20242":53068,"_5":13829,"_26574":52991,"_2824":53069},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3337":1791,"_29196":1766,"_20242":53071,"_5":13829,"_26574":52995,"_2824":53072},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3337":1792,"_29196":1766,"_20242":53074,"_5":13829,"_26574":52995,"_2824":53075},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3337":1793,"_29196":1766,"_20242":53077,"_5":13829,"_26574":52995,"_2824":53078},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3337":1794,"_29196":1766,"_20242":53080,"_5":13829,"_26574":52999,"_2824":53081},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3337":1795,"_29196":1766,"_20242":53083,"_5":13829,"_26574":52999,"_2824":53084},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3337":1796,"_29196":1766,"_20242":53086,"_5":13829,"_26574":52999,"_2824":53087},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3337":1797,"_29196":1766,"_20242":53089,"_5":13829,"_26574":52999,"_2824":53090},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3337":1798,"_29196":1766,"_20242":53092,"_5":13829,"_26574":53007,"_2824":53093},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3337":1799,"_29196":1766,"_20242":53095,"_5":13829,"_26574":53011,"_2824":53096},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3337":1800,"_29196":1766,"_20242":53098,"_5":13829,"_26574":53015,"_2824":53099},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3337":1801,"_29196":1766,"_20242":53101,"_5":13829,"_26574":53019,"_2824":53102},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3337":1802,"_29196":1766,"_20242":53104,"_5":13829,"_26574":53023,"_2824":53105},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3337":1803,"_29196":1766,"_20242":53107,"_5":13829,"_26574":53027,"_2824":53108},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3337":1804,"_29196":1766,"_20242":53110,"_5":13829,"_26574":53031,"_2824":53111},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3337":1805,"_29196":1766,"_20242":53113,"_5":13829,"_26574":53031,"_2824":53114},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3337":1806,"_29196":1766,"_20242":53116,"_5":13829,"_26574":53031,"_2824":53117},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3337":1807,"_29196":1766,"_20242":53119,"_5":13829,"_26574":53031,"_2824":53120},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3337":1808,"_29196":1766,"_20242":53122,"_5":13829,"_26574":53035,"_2824":53123},[],"The new chain ends in an anchor installed by the consumer.",{"_3337":1809,"_29196":1766,"_20242":53125,"_5":13829,"_26574":53035,"_2824":53126},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3337":1810,"_29196":1766,"_20242":53128,"_5":13829,"_26574":53035,"_2824":53129},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3337":1811,"_29196":1766,"_20242":53131,"_5":13829,"_26574":53035,"_2824":53132},[],"Re-enrollment accepts the old identity during the planned period.",{"_3337":1812,"_29196":1766,"_20242":53134,"_5":13829,"_26574":53035,"_2824":53135},[],"OCSP and CRL respond for the authorities that remain active.",{"_3337":1813,"_29196":1766,"_20242":53137,"_5":13829,"_26574":53035,"_2824":53138},[],"No DMS is left accidentally issuing from the old CA.",{"_3337":1814,"_29196":1766,"_20242":53140,"_5":13829,"_26574":53035,"_2824":53141},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3337":1815,"_29196":1815,"_5":14181,"_2824":53143,"_29540":53144,"_20242":53145,"_26574":1815},"Certification authorities",[47528,48977,52983,52984],[],{"_3337":1816,"_29196":1815,"_20242":53147,"_5":13829,"_26574":1815,"_2824":53148},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3337":1817,"_29196":1815,"_5":29537,"_20242":53150,"_26574":53151,"_2824":53152},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3337":1818,"_29196":1815,"_5":29537,"_20242":53154,"_26574":53155,"_2824":53156},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3337":1819,"_29196":1815,"_5":29537,"_20242":53158,"_26574":53159,"_2824":47538},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#before-you-begin",{"_3337":1820,"_29196":1815,"_5":29537,"_20242":53161,"_26574":53162,"_2824":53163},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3337":1821,"_29196":1815,"_5":29537,"_20242":53165,"_26574":53166,"_2824":53167},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3337":1822,"_29196":1815,"_5":29537,"_20242":53169,"_26574":53170,"_2824":53171},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3337":1823,"_29196":1815,"_5":29537,"_20242":53173,"_26574":53174,"_2824":53175},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3337":1824,"_29196":1815,"_5":29537,"_20242":53177,"_26574":53178,"_2824":53179},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3337":1825,"_29196":1815,"_5":29537,"_20242":53181,"_26574":53182,"_2824":53183},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3337":1826,"_29196":1815,"_5":29537,"_20242":53185,"_26574":53186,"_2824":53187},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3337":1827,"_29196":1815,"_5":29537,"_20242":53189,"_26574":53190,"_2824":53191},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3337":1828,"_29196":1815,"_5":29537,"_20242":53193,"_26574":53194,"_2824":53195},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3337":1829,"_29196":1815,"_5":29537,"_20242":53197,"_26574":53198,"_2824":53199},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3337":1830,"_29196":1815,"_5":29537,"_20242":53201,"_26574":53202,"_2824":53203},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3337":1831,"_29196":1815,"_5":29537,"_20242":53205,"_26574":53206,"_2824":53207},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3337":1832,"_29196":1815,"_5":29537,"_20242":53209,"_26574":53210,"_2824":53211},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3337":1833,"_29196":1815,"_5":29537,"_20242":53213,"_26574":53214,"_2824":53215},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3337":1834,"_29196":1815,"_5":29537,"_20242":53217,"_26574":53218,"_2824":53219},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3337":1835,"_29196":1815,"_5":29537,"_20242":53221,"_26574":53222,"_2824":53223},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3337":1836,"_29196":1815,"_5":29537,"_20242":53225,"_26574":53226,"_2824":53227},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3337":1837,"_29196":1815,"_5":29537,"_20242":53229,"_26574":53230,"_2824":53231},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3337":1838,"_29196":1815,"_5":29537,"_20242":53233,"_26574":53234,"_2824":53235},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3337":1839,"_29196":1815,"_5":29537,"_20242":53237,"_26574":53238,"_2824":53239},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3337":1840,"_29196":1815,"_20242":53241,"_5":13829,"_26574":1815,"_2824":53242},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3337":1841,"_29196":1815,"_20242":53244,"_5":13829,"_26574":1815,"_2824":53245},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3337":1842,"_29196":1815,"_20242":53247,"_5":13829,"_26574":1815,"_2824":53248},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3337":1843,"_29196":1815,"_20242":53250,"_5":13829,"_26574":53151,"_2824":53251},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3337":1844,"_29196":1815,"_20242":53253,"_5":13829,"_26574":53151,"_2824":53254},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3337":1845,"_29196":1815,"_20242":53256,"_5":13829,"_26574":53151,"_2824":53257},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3337":1846,"_29196":1815,"_20242":53259,"_5":13829,"_26574":53151,"_2824":53260},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3337":1847,"_29196":1815,"_20242":53262,"_5":13829,"_26574":53151,"_2824":53263},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3337":1848,"_29196":1815,"_20242":53265,"_5":13829,"_26574":53159,"_2824":53266},[],"Decide whether the CA will be a root or an intermediate.",{"_3337":1849,"_29196":1815,"_20242":53268,"_5":13829,"_26574":53159,"_2824":53269},[],"Choose the engine that will keep the key.",{"_3337":1850,"_29196":1815,"_20242":53271,"_5":13829,"_26574":53159,"_2824":53272},[],"Define a validity longer than that of the certificates it will issue.",{"_3337":1851,"_29196":1815,"_20242":53274,"_5":13829,"_26574":53159,"_2824":53275},[],"For an intermediate CA, make sure the parent CA is active.",{"_3337":1852,"_29196":1815,"_20242":53277,"_5":13829,"_26574":53162,"_2824":53278},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3337":1853,"_29196":1815,"_20242":53280,"_5":13829,"_26574":53166,"_2824":53281},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3337":1854,"_29196":1815,"_20242":53283,"_5":13829,"_26574":53166,"_2824":53284},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3337":1855,"_29196":1815,"_20242":53286,"_5":13829,"_26574":53170,"_2824":53287},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3337":1856,"_29196":1815,"_20242":53289,"_5":13829,"_26574":53174,"_2824":53290},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3337":1857,"_29196":1815,"_20242":53292,"_5":13829,"_26574":53174,"_2824":53293},[],"`C`: two-letter ISO 3166-1 country code.",{"_3337":1858,"_29196":1815,"_20242":53295,"_5":13829,"_26574":53174,"_2824":53296},[],"`ST`: state or province.",{"_3337":1859,"_29196":1815,"_20242":53298,"_5":13829,"_26574":53174,"_2824":53299},[],"`L`: locality.",{"_3337":1860,"_29196":1815,"_20242":53301,"_5":13829,"_26574":53174,"_2824":53302},[],"`O`: organization.",{"_3337":1861,"_29196":1815,"_20242":53304,"_5":13829,"_26574":53174,"_2824":53305},[],"`OU`: organizational unit.",{"_3337":1862,"_29196":1815,"_20242":53307,"_5":13829,"_26574":53174,"_2824":53308},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3337":1863,"_29196":1815,"_20242":53310,"_5":13829,"_26574":53178,"_2824":53311},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3337":1864,"_29196":1815,"_20242":53313,"_5":13829,"_26574":53178,"_2824":53314},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3337":1865,"_29196":1815,"_20242":53316,"_5":13829,"_26574":53182,"_2824":53317},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3337":1866,"_29196":1815,"_20242":53319,"_5":13829,"_26574":53182,"_2824":53320},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3337":1867,"_29196":1815,"_20242":53322,"_5":13829,"_26574":53186,"_2824":53323},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3337":1868,"_29196":1815,"_20242":53325,"_5":13829,"_26574":53186,"_2824":53326},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3337":1869,"_29196":1815,"_20242":53328,"_5":13829,"_26574":53190,"_2824":53329},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3337":1870,"_29196":1815,"_20242":53331,"_5":13829,"_26574":53194,"_2824":53332},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3337":1871,"_29196":1815,"_20242":53334,"_5":13829,"_26574":53198,"_2824":53335},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3337":1872,"_29196":1815,"_20242":53337,"_5":13829,"_26574":53198,"_2824":53338},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3337":1873,"_29196":1815,"_20242":53340,"_5":13829,"_26574":53202,"_2824":53341},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3337":1874,"_29196":1815,"_20242":53343,"_5":13829,"_26574":53206,"_2824":53344},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3337":1875,"_29196":1815,"_20242":53346,"_5":13829,"_26574":53206,"_2824":53347},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3337":1876,"_29196":1815,"_20242":53349,"_5":13829,"_26574":53210,"_2824":53350},[],"Open a CA from the inventory to review:",{"_3337":1877,"_29196":1815,"_20242":53352,"_5":13829,"_26574":53210,"_2824":53353},[],"Status and validity period.",{"_3337":1878,"_29196":1815,"_20242":53355,"_5":13829,"_26574":53210,"_2824":53356},[],"Certificate and chain in PEM format.",{"_3337":1879,"_29196":1815,"_20242":53358,"_5":13829,"_26574":53210,"_2824":53359},[],"Number of active, expired and revoked certificates.",{"_3337":1880,"_29196":1815,"_20242":53361,"_5":13829,"_26574":53210,"_2824":53362},[],"Certificates issued in **Issued Certificates**.",{"_3337":1881,"_29196":1815,"_20242":53364,"_5":13829,"_26574":53210,"_2824":53365},[],"The CRL linked to the authority.",{"_3337":1882,"_29196":1815,"_20242":53367,"_5":13829,"_26574":53210,"_2824":53368},[],"Metadata and the associated cryptographic engine.",{"_3337":1883,"_29196":1815,"_20242":53370,"_5":13829,"_26574":53210,"_2824":53371},[],"You can filter the inventory by name, status and CA type.",{"_3337":1884,"_29196":1815,"_20242":53373,"_5":13829,"_26574":53214,"_2824":53374},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3337":1885,"_29196":1815,"_20242":53376,"_5":13829,"_26574":53214,"_2824":53377},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3337":1886,"_29196":1815,"_20242":53379,"_5":13829,"_26574":53214,"_2824":53380},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3337":1887,"_29196":1815,"_20242":53382,"_5":13829,"_26574":53214,"_2824":53383},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3337":1888,"_29196":1815,"_20242":53385,"_5":13829,"_26574":53218,"_2824":53386},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3337":1889,"_29196":1815,"_20242":53388,"_5":13829,"_26574":53222,"_2824":53389},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3337":1890,"_29196":1815,"_20242":53391,"_5":13829,"_26574":53226,"_2824":53392},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3337":1891,"_29196":1815,"_20242":53394,"_5":13829,"_26574":53230,"_2824":53395},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3337":1892,"_29196":1815,"_20242":53397,"_5":13829,"_26574":53234,"_2824":53398},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3337":1893,"_29196":1815,"_20242":53400,"_5":13829,"_26574":53238,"_2824":53401},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3337":1894,"_29196":1815,"_20242":53403,"_5":13829,"_26574":53238,"_2824":53404},[],"The CA’s VA role is kept. If no other CA with the same SKI remains, it can no longer be edited (see CRL), so adjust its validity and signer beforehand. The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3337":1895,"_29196":1815,"_20242":53406,"_5":13829,"_26574":53238,"_2824":53407},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. If the new certificate uses the same key, it shares the SKI with the retained VA role of the deleted CA, whose signer is the old certificate: check that the CRL is generated and, if it is not, use `PUT` to set a signer of the new CA (see CRL).",{"_3337":1896,"_29196":1896,"_5":14181,"_2824":53409,"_29540":53410,"_20242":53411,"_26574":1896},"Certificate profiles",[47528,48977,52983,52984],[],{"_3337":1897,"_29196":1896,"_20242":53413,"_5":13829,"_26574":1896,"_2824":53414},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3337":1898,"_29196":1896,"_5":29537,"_20242":53416,"_26574":53417,"_2824":53418},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3337":1899,"_29196":1896,"_5":29537,"_20242":53420,"_26574":53421,"_2824":53422},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#validity","Validity",{"_3337":1900,"_29196":1896,"_5":29537,"_20242":53424,"_26574":53425,"_2824":53426},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3337":1901,"_29196":1896,"_5":29537,"_20242":53428,"_26574":53429,"_2824":53430},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3337":1902,"_29196":1896,"_5":29537,"_20242":53432,"_26574":53433,"_2824":53434},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#subject","Subject",{"_3337":1903,"_29196":1896,"_5":29537,"_20242":53436,"_26574":53437,"_2824":53438},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3337":1904,"_29196":1896,"_5":29537,"_20242":53440,"_26574":53441,"_2824":53442},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3337":1905,"_29196":1896,"_5":29537,"_20242":53444,"_26574":53445,"_2824":53446},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3337":1906,"_29196":1896,"_5":29537,"_20242":53448,"_26574":53449,"_2824":53450},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3337":1907,"_29196":1896,"_5":29537,"_20242":53452,"_26574":53453,"_2824":53454},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3337":1908,"_29196":1896,"_5":29537,"_20242":53456,"_26574":53457,"_2824":53458},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3337":1909,"_29196":1896,"_5":29537,"_20242":53460,"_26574":53461,"_2824":53462},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3337":1910,"_29196":1896,"_5":29537,"_20242":53464,"_26574":53465,"_2824":53466},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3337":1911,"_29196":1896,"_5":29537,"_20242":53468,"_26574":53469,"_2824":53470},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3337":1912,"_29196":1896,"_5":29537,"_20242":53472,"_26574":53473,"_2824":53474},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#design-examples","Design examples",{"_3337":1913,"_29196":1896,"_5":29537,"_20242":53476,"_26574":53477,"_2824":53478},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3337":1914,"_29196":1896,"_20242":53480,"_5":13829,"_26574":1896,"_2824":53481},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3337":1915,"_29196":1896,"_20242":53483,"_5":13829,"_26574":1896,"_2824":53484},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3337":1916,"_29196":1896,"_20242":53486,"_5":13829,"_26574":53421,"_2824":53487},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3337":1917,"_29196":1896,"_20242":53489,"_5":13829,"_26574":53421,"_2824":53490},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3337":1918,"_29196":1896,"_20242":53492,"_5":13829,"_26574":53425,"_2824":53493},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3337":1919,"_29196":1896,"_20242":53495,"_5":13829,"_26574":53429,"_2824":53496},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3337":1920,"_29196":1896,"_20242":53498,"_5":13829,"_26574":53429,"_2824":53499},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3337":1921,"_29196":1896,"_20242":53501,"_5":13829,"_26574":53429,"_2824":53502},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3337":1922,"_29196":1896,"_20242":53504,"_5":13829,"_26574":53433,"_2824":53505},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3337":1923,"_29196":1896,"_20242":53507,"_5":13829,"_26574":53437,"_2824":53508},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3337":1924,"_29196":1896,"_20242":53510,"_5":13829,"_26574":53437,"_2824":53511},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3337":1925,"_29196":1896,"_20242":53513,"_5":13829,"_26574":53441,"_2824":53514},[],"The cryptographic enforcement can:",{"_3337":1926,"_29196":1896,"_20242":53516,"_5":13829,"_26574":53441,"_2824":53517},[],"allow or block RSA keys;",{"_3337":1927,"_29196":1896,"_20242":53519,"_5":13829,"_26574":53441,"_2824":53520},[],"limit the supported RSA sizes;",{"_3337":1928,"_29196":1896,"_20242":53522,"_5":13829,"_26574":53441,"_2824":53523},[],"allow or block ECDSA keys;",{"_3337":1929,"_29196":1896,"_20242":53525,"_5":13829,"_26574":53441,"_2824":53526},[],"limit the supported ECDSA sizes or curves.",{"_3337":1930,"_29196":1896,"_20242":53528,"_5":13829,"_26574":53441,"_2824":53529},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3337":1931,"_29196":1896,"_20242":53531,"_5":13829,"_26574":53445,"_2824":53532},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3337":1932,"_29196":1896,"_20242":53534,"_5":13829,"_26574":53445,"_2824":50738},[],{"_3337":1933,"_29196":1896,"_20242":53536,"_5":13829,"_26574":53445,"_2824":53537},[],"First choice",{"_3337":1934,"_29196":1896,"_20242":53539,"_5":13829,"_26574":53445,"_2824":53540},[],"Second choice",{"_3337":1935,"_29196":1896,"_20242":53542,"_5":13829,"_26574":53445,"_2824":53543},[],"If neither is supplied",{"_3337":1936,"_29196":1896,"_20242":53545,"_5":13829,"_26574":53445,"_2824":53546},[],"Direct signing with a CA",{"_3337":1937,"_29196":1896,"_20242":53548,"_5":13829,"_26574":53445,"_2824":53549},[],"`issuance_profile` embedded in the request",{"_3337":1938,"_29196":1896,"_20242":53551,"_5":13829,"_26574":53445,"_2824":53552},[],"Request `issuance_profile_id`",{"_3337":1939,"_29196":1896,"_20242":53554,"_5":13829,"_26574":53445,"_2824":53555},[],"CA default profile (`profile_id`).",{"_3337":1940,"_29196":1896,"_20242":53557,"_5":13829,"_26574":53445,"_2824":53558},[],"Issuance through a DMS",{"_3337":1941,"_29196":1896,"_20242":53560,"_5":13829,"_26574":53445,"_2824":53561},[],"`settings.issuance_profile_id`",{"_3337":1942,"_29196":1896,"_20242":53563,"_5":13829,"_26574":53445,"_2824":53564},[],"`settings.issuance_profile` embedded in the DMS",{"_3337":1943,"_29196":1896,"_20242":53566,"_5":13829,"_26574":53445,"_2824":53567},[],"Enrollment CA default profile.",{"_3337":1944,"_29196":1896,"_20242":53569,"_5":13829,"_26574":53445,"_2824":53570},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3337":1945,"_29196":1896,"_20242":53572,"_5":13829,"_26574":53445,"_2824":53573},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3337":1946,"_29196":1896,"_20242":53575,"_5":13829,"_26574":53453,"_2824":53576},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3337":1947,"_29196":1896,"_20242":53578,"_5":13829,"_26574":53457,"_2824":53579},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3337":1948,"_29196":1896,"_20242":53581,"_5":13829,"_26574":53461,"_2824":53582},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3337":1949,"_29196":1896,"_20242":53584,"_5":13829,"_26574":53465,"_2824":53585},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3337":1950,"_29196":1896,"_20242":53587,"_5":13829,"_26574":53469,"_2824":53588},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3337":1951,"_29196":1896,"_20242":53590,"_5":13829,"_26574":53469,"_2824":53591},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3337":1952,"_29196":1896,"_20242":53593,"_5":13829,"_26574":53473,"_2824":53594},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3337":1953,"_29196":1896,"_20242":53596,"_5":13829,"_26574":53473,"_2824":53597},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3337":1954,"_29196":1896,"_20242":53599,"_5":13829,"_26574":53473,"_2824":53600},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3337":1955,"_29196":1896,"_20242":53602,"_5":13829,"_26574":53473,"_2824":53603},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3337":1956,"_29196":1896,"_20242":53605,"_5":13829,"_26574":53477,"_2824":53606},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3337":1957,"_29196":1896,"_20242":53608,"_5":13829,"_26574":53477,"_2824":53609},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3337":1958,"_29196":1958,"_5":14181,"_2824":53611,"_29540":53612,"_20242":53614,"_26574":1958},"Certificate validation",[47528,48977,52983,53613],"Validation",[],{"_3337":1959,"_29196":1958,"_20242":53616,"_5":13829,"_26574":1958,"_2824":53617},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3337":1960,"_29196":1958,"_5":29537,"_20242":53619,"_26574":53620,"_2824":53621},[],"/docs/pr-preview/pr-57/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3337":1961,"_29196":1958,"_5":29537,"_20242":53623,"_26574":53624,"_2824":53625},[],"/docs/pr-preview/pr-57/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3337":1962,"_29196":1958,"_5":29537,"_20242":53627,"_26574":53628,"_2824":53629},[],"/docs/pr-preview/pr-57/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3337":1963,"_29196":1958,"_20242":53631,"_5":13829,"_26574":1958,"_2824":53632},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3337":1964,"_29196":1958,"_20242":53634,"_5":13829,"_26574":53620,"_2824":53635},[],"Verify these criteria together:",{"_3337":1965,"_29196":1958,"_20242":53637,"_5":13829,"_26574":53620,"_2824":52609},[],{"_3337":1966,"_29196":1958,"_20242":53639,"_5":13829,"_26574":53620,"_2824":53640},[],"Required result",{"_3337":1967,"_29196":1958,"_20242":53642,"_5":13829,"_26574":53620,"_2824":53643},[],"Chain and signature",{"_3337":1968,"_29196":1958,"_20242":53645,"_5":13829,"_26574":53620,"_2824":53646},[],"Valid chain to a root deliberately installed in the consumer.",{"_3337":1969,"_29196":1958,"_20242":53648,"_5":13829,"_26574":53620,"_2824":53649},[],"Dates",{"_3337":1970,"_29196":1958,"_20242":53651,"_5":13829,"_26574":53620,"_2824":53652},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3337":1971,"_29196":1958,"_20242":53654,"_5":13829,"_26574":53620,"_2824":48646},[],{"_3337":1972,"_29196":1958,"_20242":53656,"_5":13829,"_26574":53620,"_2824":53657},[],"Name, SAN or identifier matches the expected peer.",{"_3337":1973,"_29196":1958,"_20242":53659,"_5":13829,"_26574":53620,"_2824":47918},[],{"_3337":1974,"_29196":1958,"_20242":53661,"_5":13829,"_26574":53620,"_2824":53662},[],"KU, EKU and constraints permit the specific operation.",{"_3337":1975,"_29196":1958,"_20242":53664,"_5":13829,"_26574":53620,"_2824":53665},[],"Revocation",{"_3337":1976,"_29196":1958,"_20242":53667,"_5":13829,"_26574":53620,"_2824":53668},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3337":1977,"_29196":1958,"_20242":53670,"_5":13829,"_26574":53620,"_2824":53671},[],"Authorization",{"_3337":1978,"_29196":1958,"_20242":53673,"_5":13829,"_26574":53620,"_2824":53674},[],"The application permits that identity to perform the action.",{"_3337":1979,"_29196":1958,"_20242":53676,"_5":13829,"_26574":53620,"_2824":53677},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3337":1980,"_29196":1958,"_20242":53679,"_5":13829,"_26574":53624,"_2824":53680},[],"Mechanism",{"_3337":1981,"_29196":1958,"_20242":53682,"_5":13829,"_26574":53624,"_2824":53683},[],"When to use it",{"_3337":1982,"_29196":1958,"_20242":53685,"_5":13829,"_26574":53624,"_2824":53686},[],"What you must maintain",{"_3337":1983,"_29196":1958,"_20242":53688,"_5":13829,"_26574":53624,"_2824":53689},[],"OCSP",{"_3337":1984,"_29196":1958,"_20242":53691,"_5":13829,"_26574":53624,"_2824":53692},[],"Status query for a specific certificate.",{"_3337":1985,"_29196":1958,"_20242":53694,"_5":13829,"_26574":53624,"_2824":53695},[],"Responder access, signature verification and cache/freshness policy.",{"_3337":1986,"_29196":1958,"_20242":53697,"_5":13829,"_26574":53624,"_2824":53698},[],"CRL",{"_3337":1987,"_29196":1958,"_20242":53700,"_5":13829,"_26574":53624,"_2824":53701},[],"Local checks for many certificates or offline operation.",{"_3337":1988,"_29196":1958,"_20242":53703,"_5":13829,"_26574":53624,"_2824":53704},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3337":1989,"_29196":1958,"_20242":53706,"_5":13829,"_26574":53624,"_2824":53707},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3337":1990,"_29196":1958,"_20242":53709,"_5":13829,"_26574":53624,"_2824":53710},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3337":1991,"_29196":1958,"_20242":53712,"_5":13829,"_26574":53628,"_2824":53713},[],"Accept a current, authorized certificate with a known chain.",{"_3337":1992,"_29196":1958,"_20242":53715,"_5":13829,"_26574":53628,"_2824":53716},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3337":1993,"_29196":1958,"_20242":53718,"_5":13829,"_26574":53628,"_2824":53719},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3337":1994,"_29196":1958,"_20242":53721,"_5":13829,"_26574":53628,"_2824":53722},[],"Check that a new connection with that identity is rejected.",{"_3337":1995,"_29196":1958,"_20242":53724,"_5":13829,"_26574":53628,"_2824":53725},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3337":1996,"_29196":1958,"_20242":53727,"_5":13829,"_26574":53628,"_2824":53728},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3337":1997,"_29196":1958,"_20242":53730,"_5":13829,"_26574":53628,"_2824":53731},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3337":1998,"_29196":1958,"_20242":53733,"_5":13829,"_26574":53628,"_2824":53734},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3337":1999,"_29196":1958,"_20242":53736,"_5":13829,"_26574":53628,"_2824":53737},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3337":2000,"_29196":2000,"_5":14181,"_2824":53739,"_29540":53740,"_20242":53741,"_26574":2000},"Certificates",[47528,48977,52983,52984],[],{"_3337":2001,"_29196":2000,"_20242":53743,"_5":13829,"_26574":2000,"_2824":53744},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3337":2002,"_29196":2000,"_5":29537,"_20242":53746,"_26574":53747,"_2824":53748},[],"/docs/pr-preview/pr-57/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3337":2003,"_29196":2000,"_5":29537,"_20242":53750,"_26574":53751,"_2824":53752},[],"/docs/pr-preview/pr-57/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3337":2004,"_29196":2000,"_5":29537,"_20242":53754,"_26574":53755,"_2824":53756},[],"/docs/pr-preview/pr-57/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3337":2005,"_29196":2000,"_5":29537,"_20242":53758,"_26574":53759,"_2824":53760},[],"/docs/pr-preview/pr-57/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3337":2006,"_29196":2000,"_5":29537,"_20242":53762,"_26574":53763,"_2824":53764},[],"/docs/pr-preview/pr-57/platform/pki/certificates#open-the-action","Open the action",{"_3337":2007,"_29196":2000,"_5":29537,"_20242":53766,"_26574":53767,"_2824":53768},[],"/docs/pr-preview/pr-57/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3337":2008,"_29196":2000,"_5":29537,"_20242":53770,"_26574":53771,"_2824":53772},[],"/docs/pr-preview/pr-57/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3337":2009,"_29196":2000,"_5":29537,"_20242":53774,"_26574":53775,"_2824":53776},[],"/docs/pr-preview/pr-57/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3337":2010,"_29196":2000,"_5":29537,"_20242":53778,"_26574":53779,"_2824":53780},[],"/docs/pr-preview/pr-57/platform/pki/certificates#continue","Continue",{"_3337":2011,"_29196":2000,"_20242":53782,"_5":13829,"_26574":2000,"_2824":53783},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3337":2012,"_29196":2000,"_20242":53785,"_5":13829,"_26574":53747,"_2824":53786},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3337":2013,"_29196":2000,"_20242":53788,"_5":13829,"_26574":53747,"_2824":53789},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3337":2014,"_29196":2000,"_20242":53791,"_5":13829,"_26574":53747,"_2824":53792},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3337":2015,"_29196":2000,"_20242":53794,"_5":13829,"_26574":53751,"_2824":53795},[],"Download the PEM and inspect it:",{"_3337":2016,"_29196":2000,"_20242":53797,"_5":13829,"_26574":53751,"_2824":53798},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3337":2017,"_29196":2000,"_20242":53800,"_5":13829,"_26574":53755,"_2824":53801},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3337":2018,"_29196":2000,"_20242":53803,"_5":13829,"_26574":53755,"_2824":53804},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3337":2019,"_29196":2000,"_20242":53806,"_5":13829,"_26574":53755,"_2824":53807},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3337":2020,"_29196":2000,"_20242":53809,"_5":13829,"_26574":53755,"_2824":53810},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3337":2021,"_29196":2000,"_20242":53812,"_5":13829,"_26574":53755,"_2824":53813},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3337":2022,"_29196":2000,"_20242":53815,"_5":13829,"_26574":53755,"_2824":53816},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3337":2023,"_29196":2000,"_20242":53818,"_5":13829,"_26574":53755,"_2824":53819},[],"For browser key generation, follow Issue your first certificate.",{"_3337":2024,"_29196":2000,"_20242":53821,"_5":13829,"_26574":53759,"_2824":53822},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3337":2025,"_29196":2000,"_20242":53824,"_5":13829,"_26574":53763,"_2824":53825},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3337":2026,"_29196":2000,"_20242":53827,"_5":13829,"_26574":53767,"_2824":53828},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3337":2027,"_29196":2000,"_20242":53830,"_5":13829,"_26574":53771,"_2824":53831},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3337":2028,"_29196":2000,"_20242":53833,"_5":13829,"_26574":53771,"_2824":53834},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3337":2029,"_29196":2000,"_20242":53836,"_5":13829,"_26574":53771,"_2824":53837},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3337":2030,"_29196":2000,"_20242":53839,"_5":13829,"_26574":53775,"_2824":53840},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3337":2031,"_29196":2000,"_20242":53842,"_5":13829,"_26574":53775,"_2824":53843},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3337":2032,"_29196":2000,"_20242":53845,"_5":13829,"_26574":53775,"_2824":53846},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3337":2033,"_29196":2000,"_20242":53848,"_5":13829,"_26574":53779,"_2824":53849},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3337":2034,"_29196":2000,"_20242":53851,"_5":13829,"_26574":53779,"_2824":53852},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3337":2035,"_29196":2035,"_5":14181,"_2824":53854,"_29540":53855,"_20242":53857,"_26574":2035},"Certificate lifecycle",[47528,48977,52983,53856],"Concepts",[],{"_3337":2036,"_29196":2035,"_20242":53859,"_5":13829,"_26574":2035,"_2824":53860},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3337":2037,"_29196":2035,"_5":29537,"_20242":53862,"_26574":53863,"_2824":53864},[],"/docs/pr-preview/pr-57/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3337":2038,"_29196":2035,"_5":29537,"_20242":53866,"_26574":53867,"_2824":53868},[],"/docs/pr-preview/pr-57/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3337":2039,"_29196":2035,"_5":29537,"_20242":53870,"_26574":53871,"_2824":53872},[],"/docs/pr-preview/pr-57/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3337":2040,"_29196":2035,"_5":29537,"_20242":53874,"_26574":53875,"_2824":53876},[],"/docs/pr-preview/pr-57/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3337":2041,"_29196":2035,"_5":29537,"_20242":53878,"_26574":53879,"_2824":53880},[],"/docs/pr-preview/pr-57/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3337":2042,"_29196":2035,"_5":29537,"_20242":53882,"_26574":53883,"_2824":53884},[],"/docs/pr-preview/pr-57/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3337":2043,"_29196":2035,"_5":29537,"_20242":53886,"_26574":53887,"_2824":53888},[],"/docs/pr-preview/pr-57/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3337":2044,"_29196":2035,"_5":29537,"_20242":53890,"_26574":53891,"_2824":53892},[],"/docs/pr-preview/pr-57/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3337":2045,"_29196":2035,"_5":29537,"_20242":53894,"_26574":53895,"_2824":53896},[],"/docs/pr-preview/pr-57/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3337":2046,"_29196":2035,"_5":29537,"_20242":53898,"_26574":53899,"_2824":53900},[],"/docs/pr-preview/pr-57/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3337":2047,"_29196":2035,"_20242":53902,"_5":13829,"_26574":2035,"_2824":53903},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3337":2048,"_29196":2035,"_20242":53905,"_5":13829,"_26574":53867,"_2824":53906},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3337":2049,"_29196":2035,"_20242":53908,"_5":13829,"_26574":53871,"_2824":53909},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3337":2050,"_29196":2035,"_20242":53911,"_5":13829,"_26574":53875,"_2824":53912},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3337":2051,"_29196":2035,"_20242":53914,"_5":13829,"_26574":53879,"_2824":53915},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3337":2052,"_29196":2035,"_20242":53917,"_5":13829,"_26574":53883,"_2824":53918},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3337":2053,"_29196":2035,"_20242":53920,"_5":13829,"_26574":53887,"_2824":53921},[],"Lamassu persists four X.509 states:",{"_3337":2054,"_29196":2035,"_20242":53923,"_5":13829,"_26574":53887,"_2824":53924},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3337":2055,"_29196":2035,"_20242":53926,"_5":13829,"_26574":53887,"_2824":53927},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3337":2056,"_29196":2035,"_20242":53929,"_5":13829,"_26574":53887,"_2824":53930},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3337":2057,"_29196":2035,"_20242":53932,"_5":13829,"_26574":53887,"_2824":53933},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3337":2058,"_29196":2035,"_20242":53935,"_5":13829,"_26574":53887,"_2824":53936},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3337":2059,"_29196":2035,"_20242":53938,"_5":13829,"_26574":53891,"_2824":53939},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3337":2060,"_29196":2035,"_20242":53941,"_5":13829,"_26574":53891,"_2824":53942},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3337":2061,"_29196":2035,"_20242":53944,"_5":13829,"_26574":53891,"_2824":53945},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3337":2062,"_29196":2035,"_20242":53947,"_5":13829,"_26574":53895,"_2824":53948},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3337":2063,"_29196":2035,"_20242":53950,"_5":13829,"_26574":53895,"_2824":53951},[],"Before confirming:",{"_3337":2064,"_29196":2035,"_20242":53953,"_5":13829,"_26574":53895,"_2824":53954},[],"Identify DMSs, devices and services that trust that chain.",{"_3337":2065,"_29196":2035,"_20242":53956,"_5":13829,"_26574":53895,"_2824":53957},[],"Distribute the new chain of trust.",{"_3337":2066,"_29196":2035,"_20242":53959,"_5":13829,"_26574":53895,"_2824":53960},[],"Reissue the necessary identities.",{"_3337":2067,"_29196":2035,"_20242":53962,"_5":13829,"_26574":53895,"_2824":53963},[],"Check OCSP and CRL from a real consumer.",{"_3337":2068,"_29196":2035,"_20242":53965,"_5":13829,"_26574":53895,"_2824":53966},[],"Revoke the old CA once no legitimate traffic remains.",{"_3337":2069,"_29196":2035,"_20242":53968,"_5":13829,"_26574":53895,"_2824":53969},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3337":2070,"_29196":2035,"_20242":53971,"_5":13829,"_26574":53899,"_2824":53972},[],"Certificates entering the preventive or critical renewal window.",{"_3337":2071,"_29196":2035,"_20242":53974,"_5":13829,"_26574":53899,"_2824":53975},[],"Repeated enrollment or re-enrollment failures.",{"_3337":2072,"_29196":2035,"_20242":53977,"_5":13829,"_26574":53899,"_2824":53978},[],"Status changes and revocation reasons.",{"_3337":2073,"_29196":2035,"_20242":53980,"_5":13829,"_26574":53899,"_2824":53981},[],"OCSP and CRL publication and validity.",{"_3337":2074,"_29196":2035,"_20242":53983,"_5":13829,"_26574":53899,"_2824":53984},[],"Dependencies still presenting a replaced certificate.",{"_3337":2075,"_29196":2035,"_20242":53986,"_5":13829,"_26574":53899,"_2824":53987},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3337":2076,"_29196":2076,"_5":14181,"_2824":53989,"_29540":53990,"_20242":53991,"_26574":2076},"Trust model",[47528,48977,52983,53856],[],{"_3337":2077,"_29196":2076,"_20242":53993,"_5":13829,"_26574":2076,"_2824":53994},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3337":2078,"_29196":2076,"_5":29537,"_20242":53996,"_26574":53997,"_2824":53998},[],"/docs/pr-preview/pr-57/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3337":2079,"_29196":2076,"_5":29537,"_20242":54000,"_26574":54001,"_2824":54002},[],"/docs/pr-preview/pr-57/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3337":2080,"_29196":2076,"_5":29537,"_20242":54004,"_26574":54005,"_2824":54006},[],"/docs/pr-preview/pr-57/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3337":2081,"_29196":2076,"_5":29537,"_20242":54008,"_26574":54009,"_2824":54010},[],"/docs/pr-preview/pr-57/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3337":2082,"_29196":2076,"_5":29537,"_20242":54012,"_26574":54013,"_2824":54014},[],"/docs/pr-preview/pr-57/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3337":2083,"_29196":2076,"_5":29537,"_20242":54016,"_26574":54017,"_2824":54018},[],"/docs/pr-preview/pr-57/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3337":2084,"_29196":2076,"_5":29537,"_20242":54020,"_26574":54021,"_2824":54022},[],"/docs/pr-preview/pr-57/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3337":2085,"_29196":2076,"_5":29537,"_20242":54024,"_26574":54025,"_2824":54026},[],"/docs/pr-preview/pr-57/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3337":2086,"_29196":2076,"_5":29537,"_20242":54028,"_26574":54029,"_2824":54030},[],"/docs/pr-preview/pr-57/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3337":2087,"_29196":2076,"_5":29537,"_20242":54032,"_26574":54033,"_2824":54034},[],"/docs/pr-preview/pr-57/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3337":2088,"_29196":2076,"_20242":54036,"_5":13829,"_26574":2076,"_2824":54037},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3337":2089,"_29196":2076,"_20242":54039,"_5":13829,"_26574":54001,"_2824":54040},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3337":2090,"_29196":2076,"_20242":54042,"_5":13829,"_26574":54005,"_2824":54043},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3337":2091,"_29196":2076,"_20242":54045,"_5":13829,"_26574":54009,"_2824":54046},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3337":2092,"_29196":2076,"_20242":54048,"_5":13829,"_26574":54013,"_2824":54049},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3337":2093,"_29196":2076,"_20242":54051,"_5":13829,"_26574":54017,"_2824":54052},[],"The device proves it can enroll according to the DMS policy.",{"_3337":2094,"_29196":2076,"_20242":54054,"_5":13829,"_26574":54017,"_2824":54055},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3337":2095,"_29196":2076,"_20242":54057,"_5":13829,"_26574":54017,"_2824":54058},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3337":2096,"_29196":2076,"_20242":54060,"_5":13829,"_26574":54017,"_2824":54061},[],"The device installs the certificate and the chain it needs.",{"_3337":2097,"_29196":2076,"_20242":54063,"_5":13829,"_26574":54017,"_2824":54064},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3337":2098,"_29196":2076,"_20242":54066,"_5":13829,"_26574":54017,"_2824":54067},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3337":2099,"_29196":2076,"_20242":54069,"_5":13829,"_26574":54021,"_2824":54070},[],"A DMS relates three sets that are worth designing separately:",{"_3337":2100,"_29196":2076,"_20242":54072,"_5":13829,"_26574":54021,"_2824":54073},[],"**Enrollment CA:** signs the new identities.",{"_3337":2101,"_29196":2076,"_20242":54075,"_5":13829,"_26574":54021,"_2824":54076},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3337":2102,"_29196":2076,"_20242":54078,"_5":13829,"_26574":54021,"_2824":54079},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3337":2103,"_29196":2076,"_20242":54081,"_5":13829,"_26574":54021,"_2824":54082},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3337":2104,"_29196":2076,"_20242":54084,"_5":13829,"_26574":54025,"_2824":54085},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3337":2105,"_29196":2076,"_20242":54087,"_5":13829,"_26574":54025,"_2824":54088},[],"that the current date is between `Not Before` and `Not After`;",{"_3337":2106,"_29196":2076,"_20242":54090,"_5":13829,"_26574":54025,"_2824":54091},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3337":2107,"_29196":2076,"_20242":54093,"_5":13829,"_26574":54025,"_2824":54094},[],"that names, SANs and subject match the expected identity;",{"_3337":2108,"_29196":2076,"_20242":54096,"_5":13829,"_26574":54025,"_2824":54097},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3337":2109,"_29196":2076,"_20242":54099,"_5":13829,"_26574":54025,"_2824":54100},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3337":2110,"_29196":2076,"_20242":54102,"_5":13829,"_26574":54025,"_2824":54103},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3337":2111,"_29196":2076,"_20242":54105,"_5":13829,"_26574":54029,"_2824":54106},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3337":2112,"_29196":2076,"_20242":54108,"_5":13829,"_26574":54033,"_2824":54109},[],"Keep the root out of daily operations, or with very restricted access.",{"_3337":2113,"_29196":2076,"_20242":54111,"_5":13829,"_26574":54033,"_2824":54112},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3337":2114,"_29196":2076,"_20242":54114,"_5":13829,"_26574":54033,"_2824":54115},[],"Assign explicit profiles to every use case.",{"_3337":2115,"_29196":2076,"_20242":54117,"_5":13829,"_26574":54033,"_2824":54118},[],"Distribute the new trust before starting a rotation.",{"_3337":2116,"_29196":2076,"_20242":54120,"_5":13829,"_26574":54033,"_2824":54121},[],"Keep enough overlap to renew a disconnected fleet.",{"_3337":2117,"_29196":2076,"_20242":54123,"_5":13829,"_26574":54033,"_2824":54124},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3337":2118,"_29196":2076,"_20242":54126,"_5":13829,"_26574":54033,"_2824":54127},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3337":2119,"_29196":2119,"_5":14181,"_2824":54129,"_29540":54130,"_20242":54131,"_26574":2119},"Revocation lists (CRL)",[47528,48977,52983,53613],[],{"_3337":2120,"_29196":2119,"_20242":54133,"_5":13829,"_26574":2119,"_2824":54134},[],"Generate and distribute signed lists to validate certificates offline.",{"_3337":2121,"_29196":2119,"_5":29537,"_20242":54136,"_26574":54137,"_2824":54138},[],"/docs/pr-preview/pr-57/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3337":2122,"_29196":2119,"_5":29537,"_20242":54140,"_26574":54141,"_2824":54142},[],"/docs/pr-preview/pr-57/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3337":2123,"_29196":2119,"_5":29537,"_20242":54144,"_26574":54145,"_2824":54146},[],"/docs/pr-preview/pr-57/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3337":2124,"_29196":2119,"_5":29537,"_20242":54148,"_26574":54149,"_2824":54150},[],"/docs/pr-preview/pr-57/platform/pki/crl#crl-contents","CRL contents",{"_3337":2125,"_29196":2119,"_5":29537,"_20242":54152,"_26574":54153,"_2824":54154},[],"/docs/pr-preview/pr-57/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3337":2126,"_29196":2119,"_5":29537,"_20242":54156,"_26574":54157,"_2824":54158},[],"/docs/pr-preview/pr-57/platform/pki/crl#va-role-management-api","VA role management API",{"_3337":2127,"_29196":2119,"_5":29537,"_20242":54160,"_26574":54161,"_2824":54162},[],"/docs/pr-preview/pr-57/platform/pki/crl#common-va-role-errors","Common VA role errors",{"_3337":2128,"_29196":2119,"_5":29537,"_20242":54164,"_26574":54165,"_2824":54166},[],"/docs/pr-preview/pr-57/platform/pki/crl#from-the-interface","From the interface",{"_3337":2129,"_29196":2119,"_5":29537,"_20242":54168,"_26574":54169,"_2824":54170},[],"/docs/pr-preview/pr-57/platform/pki/crl#references","References",{"_3337":2130,"_29196":2119,"_20242":54172,"_5":13829,"_26574":2119,"_2824":54173},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3337":2131,"_29196":2119,"_20242":54175,"_5":13829,"_26574":54137,"_2824":54176},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3337":2132,"_29196":2119,"_20242":54178,"_5":13829,"_26574":54137,"_2824":54179},[],"`crl_options` field",{"_3337":2133,"_29196":2119,"_20242":54181,"_5":13829,"_26574":54137,"_2824":47918},[],{"_3337":2134,"_29196":2119,"_20242":54183,"_5":13829,"_26574":54137,"_2824":54184},[],"Backend initial value",{"_3337":2135,"_29196":2119,"_20242":54186,"_5":13829,"_26574":54137,"_2824":54187},[],"`validity`",{"_3337":2136,"_29196":2119,"_20242":54189,"_5":13829,"_26574":54137,"_2824":54190},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3337":2137,"_29196":2119,"_20242":54192,"_5":13829,"_26574":54137,"_2824":54193},[],"7 days.",{"_3337":2138,"_29196":2119,"_20242":54195,"_5":13829,"_26574":54137,"_2824":54196},[],"`refresh_interval`",{"_3337":2139,"_29196":2119,"_20242":54198,"_5":13829,"_26574":54137,"_2824":54199},[],"Regenerate the list when the interval elapses since the latest issuance, in addition to pre-expiry regeneration; `0` disables interval regeneration. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3337":2140,"_29196":2119,"_20242":54201,"_5":13829,"_26574":54137,"_2824":54202},[],"6 days and 23 hours.",{"_3337":2141,"_29196":2119,"_20242":54204,"_5":13829,"_26574":54137,"_2824":54205},[],"`regenerate_on_revoke`",{"_3337":2142,"_29196":2119,"_20242":54207,"_5":13829,"_26574":54137,"_2824":54208},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3337":2143,"_29196":2119,"_20242":54210,"_5":13829,"_26574":54137,"_2824":54211},[],"`true`.",{"_3337":2144,"_29196":2119,"_20242":54213,"_5":13829,"_26574":54137,"_2824":54214},[],"`signer_certificate_serial_number`",{"_3337":2145,"_29196":2119,"_20242":54216,"_5":13829,"_26574":54137,"_2824":54217},[],"Serial number of the existing certificate that signs the CRL.",{"_3337":2146,"_29196":2119,"_20242":54219,"_5":13829,"_26574":54137,"_2824":54220},[],"Serial number of the CA’s current certificate.",{"_3337":2147,"_29196":2119,"_20242":54222,"_5":13829,"_26574":54137,"_2824":54223},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3337":2148,"_29196":2119,"_20242":54225,"_5":13829,"_26574":54137,"_2824":54226},[],"When a CA is reissued, the VA moves the role's signer to the reissued certificate and regenerates the CRL immediately, provided the role was signed by the superseded certificate; a signer that was deliberately set to another certificate is kept. If the reissued certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. A certificate used as a role's signer cannot be deleted: the API rejects it with `409` `certificate is in use`.",{"_3337":2149,"_29196":2119,"_20242":54228,"_5":13829,"_26574":54137,"_2824":54229},[],"When a CA is deleted, its VA role is kept and cannot be removed through the API. If no other CA with the same SKI remains, the role can be read but any `PUT` returns 404, and the renewal job logs a warning on every cycle because it no longer finds the CA. The API offers no way out; it can only be fixed by editing the database. If another CA with that SKI remains, the role is still editable (see CAs that share a key). Adjust validity and signer before deleting the CA.",{"_3337":2150,"_29196":2119,"_20242":54231,"_5":13829,"_26574":54137,"_2824":54232},[],"A CA whose certificate lacks `cRLSign` cannot generate its CRL or edit its role (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and set it as the signer with `PUT`. After reissuing a CA, check the key usage of the new certificate: if it lacks `cRLSign`, the VA keeps the previous signer and logs a warning, so the lists keep being signed by the superseded certificate until you fix the usage.",{"_3337":2151,"_29196":2119,"_20242":54234,"_5":13829,"_26574":54137,"_2824":54235},[],"`PUT` always validates the signer, even when the request does not change it. If the stored signer is no longer valid, no field of the role can be modified, not even the validity, until a valid one is set.",{"_3337":2152,"_29196":2119,"_20242":54237,"_5":13829,"_26574":54137,"_2824":54238},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3337":2153,"_29196":2119,"_20242":54240,"_5":13829,"_26574":54141,"_2824":54241},[],"The VA identifies each CRL by the CA’s SKI, and the SKI is derived from its key. Two CAs with the same key have the same SKI and share a single VA role and a single CRL. This happens when a CA is created on an existing KMS key, or when a CA is imported whose certificate declares an SKI already in use. Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. The first CA creates the role and the others keep it.",{"_3337":2154,"_29196":2119,"_20242":54243,"_5":13829,"_26574":54141,"_2824":54244},[],"The certificates of all of them point to `/crl/{ski}`, but the published list has the first CA as issuer and only includes its revocations. A verifier compares the CRL issuer with the issuer of the certificate it validates (RFC 5280, §6.3.2) and rejects the list if they differ. Depending on its policy, the certificate is blocked (*hard-fail*) or accepted even though it is revoked (*soft-fail*). Revocations of the secondary CAs do not appear in any list.",{"_3337":2155,"_29196":2119,"_20242":54246,"_5":13829,"_26574":54141,"_2824":54247},[],"If the first CA is deleted, CRL generation for the remaining one fails because the configured signer no longer matches a CA with that name. Until the role’s signer is updated to a certificate of the remaining CA, the last published list keeps being served until it expires (7 days by default).",{"_3337":2156,"_29196":2119,"_20242":54249,"_5":13829,"_26574":54141,"_2824":54250},[],"To detect the problem, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued. A CA imported with an SKI already in use does not replace the existing one as CRL issuer, because the issuer is resolved from the role’s signer. However, its own certificates point to that same URL and its revocations are not published. Until Lamassu rejects these imports, restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same collision, so also avoid reusing keys across CAs. A per-CA CRL and the rejection of imports whose SKI collides with an existing CA are both proposed in lamassuiot#834, and neither is implemented yet.",{"_3337":2157,"_29196":2119,"_20242":54252,"_5":13829,"_26574":54145,"_2824":54253},[],"The VA scheduled job checks every role on each run and requests another list when the remaining validity of `latest_crl` is less than the interval between runs. The frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. The job also regenerates a list when the role's `refresh_interval` elapses since the latest issuance; setting `refresh_interval` to `0` disables that path. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows. Keep `validity` well above the interval: with a shorter validity, the list is regenerated on every cycle.",{"_3337":2158,"_29196":2119,"_20242":54255,"_5":13829,"_26574":54145,"_2824":54256},[],"If generation fails (for example, because of a role without a CA or an invalid signer), the job logs the warning `something went wrong while calculating CRL for CA <ski>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3337":2159,"_29196":2119,"_20242":54258,"_5":13829,"_26574":54145,"_2824":54259},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if it fails (missing role, invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3337":2160,"_29196":2119,"_20242":54261,"_5":13829,"_26574":54145,"_2824":54262},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3337":2161,"_29196":2119,"_20242":54264,"_5":13829,"_26574":54149,"_2824":54265},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3337":2162,"_29196":2119,"_20242":54267,"_5":13829,"_26574":54149,"_2824":54268},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3337":2163,"_29196":2119,"_20242":54270,"_5":13829,"_26574":54153,"_2824":54271},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3337":2164,"_29196":2119,"_20242":54273,"_5":13829,"_26574":54153,"_2824":54274},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3337":2165,"_29196":2119,"_20242":54276,"_5":13829,"_26574":54153,"_2824":54277},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3337":2166,"_29196":2119,"_20242":54279,"_5":13829,"_26574":54153,"_2824":54280},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3337":2167,"_29196":2119,"_20242":54282,"_5":13829,"_26574":54153,"_2824":54283},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3337":2168,"_29196":2119,"_20242":54285,"_5":13829,"_26574":54157,"_2824":54286},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3337":2169,"_29196":2119,"_20242":54288,"_5":13829,"_26574":54157,"_2824":50741},[],{"_3337":2170,"_29196":2119,"_20242":54290,"_5":13829,"_26574":54157,"_2824":54291},[],"Relative path",{"_3337":2171,"_29196":2119,"_20242":54293,"_5":13829,"_26574":54157,"_2824":50738},[],{"_3337":2172,"_29196":2119,"_20242":54295,"_5":13829,"_26574":54157,"_2824":54296},[],"`GET`",{"_3337":2173,"_29196":2119,"_20242":54298,"_5":13829,"_26574":54157,"_2824":54299},[],"`/v1/roles/{ca-ski}`",{"_3337":2174,"_29196":2119,"_20242":54301,"_5":13829,"_26574":54157,"_2824":54302},[],"Read `crl_options` and `latest_crl`.",{"_3337":2175,"_29196":2119,"_20242":54304,"_5":13829,"_26574":54157,"_2824":54305},[],"`PUT`",{"_3337":2176,"_29196":2119,"_20242":54307,"_5":13829,"_26574":54157,"_2824":54299},[],{"_3337":2177,"_29196":2119,"_20242":54309,"_5":13829,"_26574":54157,"_2824":54310},[],"Replace CRL configuration.",{"_3337":2178,"_29196":2119,"_20242":54312,"_5":13829,"_26574":54157,"_2824":54313},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3337":2179,"_29196":2119,"_20242":54315,"_5":13829,"_26574":54157,"_2824":54316},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3337":2180,"_29196":2119,"_20242":54318,"_5":13829,"_26574":54161,"_2824":54319},[],"Symptom",{"_3337":2181,"_29196":2119,"_20242":54321,"_5":13829,"_26574":54161,"_2824":54322},[],"Cause",{"_3337":2182,"_29196":2119,"_20242":54324,"_5":13829,"_26574":54161,"_2824":54325},[],"Action",{"_3337":2183,"_29196":2119,"_20242":54327,"_5":13829,"_26574":54161,"_2824":54328},[],"`PUT /v1/roles/{ca-ski}` returns 404 and `GET` returns 200.",{"_3337":2184,"_29196":2119,"_20242":54330,"_5":13829,"_26574":54161,"_2824":54331},[],"The role’s CA was deleted and no other CA with the same SKI remains.",{"_3337":2185,"_29196":2119,"_20242":54333,"_5":13829,"_26574":54161,"_2824":54334},[],"There is no API way out; it requires database intervention. Avoid it by adjusting the role before deleting the CA.",{"_3337":2186,"_29196":2119,"_20242":54336,"_5":13829,"_26574":54161,"_2824":54337},[],"`PUT` returns 400.",{"_3337":2187,"_29196":2119,"_20242":54339,"_5":13829,"_26574":54161,"_2824":54340},[],"The signer lacks `cRLSign`, or its subject and key match no CA with that SKI (for example, after deleting the first of two CAs that share a key).",{"_3337":2188,"_29196":2119,"_20242":54342,"_5":13829,"_26574":54161,"_2824":54343},[],"Use `PUT` to set the serial number of a valid certificate of the remaining CA.",{"_3337":2189,"_29196":2119,"_20242":54345,"_5":13829,"_26574":54161,"_2824":54346},[],"`PUT` returns 400 from a 3.x client.",{"_3337":2190,"_29196":2119,"_20242":54348,"_5":13829,"_26574":54161,"_2824":54349},[],"`crl_options.subject_key_id_signer` was replaced by `signer_certificate_serial_number`, which is required.",{"_3337":2191,"_29196":2119,"_20242":54351,"_5":13829,"_26574":54161,"_2824":54352},[],"Update the client to send the new field.",{"_3337":2192,"_29196":2119,"_20242":54354,"_5":13829,"_26574":54161,"_2824":54355},[],"The CRL does not change after revoking a certificate.",{"_3337":2193,"_29196":2119,"_20242":54357,"_5":13829,"_26574":54161,"_2824":54358},[],"`regenerate_on_revoke` is `false`, or the event failed because of a missing role or an invalid signer.",{"_3337":2194,"_29196":2119,"_20242":54360,"_5":13829,"_26574":54161,"_2824":54361},[],"Check the VA logs and the failed-events queue; fix the signer.",{"_3337":2195,"_29196":2119,"_20242":54363,"_5":13829,"_26574":54161,"_2824":54364},[],"A verifier rejects the CRL because of the issuer.",{"_3337":2196,"_29196":2119,"_20242":54366,"_5":13829,"_26574":54161,"_2824":54367},[],"Several CAs share an SKI.",{"_3337":2197,"_29196":2119,"_20242":54369,"_5":13829,"_26574":54161,"_2824":54370},[],"See CAs that share a key.",{"_3337":2198,"_29196":2119,"_20242":54372,"_5":13829,"_26574":54165,"_2824":54373},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_3337":2199,"_29196":2119,"_20242":54375,"_5":13829,"_26574":54169,"_2824":54376},[],"RFC 5280: X.509 and CRL profile.",{"_3337":2200,"_29196":2119,"_20242":54378,"_5":13829,"_26574":54169,"_2824":54379},[],"OpenSSL: openssl-crl.",{"_3337":2201,"_29196":2119,"_20242":54381,"_5":13829,"_26574":54169,"_2824":54382},[],"OpenSSL: openssl-verify.",{"_3337":2202,"_29196":2119,"_20242":54384,"_5":13829,"_26574":54169,"_2824":54385},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3337":2203,"_29196":2119,"_20242":54387,"_5":13829,"_26574":54169,"_2824":54388},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3337":2204,"_29196":2204,"_5":14181,"_2824":54390,"_29540":54391,"_20242":54392,"_26574":2204},"Keys and cryptographic engines",[47528,48977,52983,52984],[],{"_3337":2205,"_29196":2204,"_20242":54394,"_5":13829,"_26574":2204,"_2824":54395},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3337":2206,"_29196":2204,"_5":29537,"_20242":54397,"_26574":54398,"_2824":54399},[],"/docs/pr-preview/pr-57/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3337":2207,"_29196":2204,"_5":29537,"_20242":54401,"_26574":54402,"_2824":54403},[],"/docs/pr-preview/pr-57/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3337":2208,"_29196":2204,"_5":29537,"_20242":54405,"_26574":54406,"_2824":54407},[],"/docs/pr-preview/pr-57/platform/pki/key-management#file-system","File System",{"_3337":2209,"_29196":2204,"_5":29537,"_20242":54409,"_26574":54410,"_2824":54411},[],"/docs/pr-preview/pr-57/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3337":2210,"_29196":2204,"_5":29537,"_20242":54413,"_26574":54414,"_2824":54415},[],"/docs/pr-preview/pr-57/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3337":2211,"_29196":2204,"_5":29537,"_20242":54417,"_26574":54418,"_2824":54419},[],"/docs/pr-preview/pr-57/platform/pki/key-management#aws-kms","AWS KMS",{"_3337":2212,"_29196":2204,"_5":29537,"_20242":54421,"_26574":54422,"_2824":54423},[],"/docs/pr-preview/pr-57/platform/pki/key-management#pkcs11","PKCS#11",{"_3337":2213,"_29196":2204,"_5":29537,"_20242":54425,"_26574":54426,"_2824":54427},[],"/docs/pr-preview/pr-57/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3337":2214,"_29196":2204,"_5":29537,"_20242":54429,"_26574":54430,"_2824":54431},[],"/docs/pr-preview/pr-57/platform/pki/key-management#key-inventory","Key inventory",{"_3337":2215,"_29196":2204,"_5":29537,"_20242":54433,"_26574":54434,"_2824":54435},[],"/docs/pr-preview/pr-57/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3337":2216,"_29196":2204,"_5":29537,"_20242":54437,"_26574":54438,"_2824":54439},[],"/docs/pr-preview/pr-57/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3337":2217,"_29196":2204,"_5":29537,"_20242":54441,"_26574":54442,"_2824":54443},[],"/docs/pr-preview/pr-57/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3337":2218,"_29196":2204,"_5":29537,"_20242":54445,"_26574":54446,"_2824":54447},[],"/docs/pr-preview/pr-57/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3337":2219,"_29196":2204,"_5":29537,"_20242":54449,"_26574":54450,"_2824":54451},[],"/docs/pr-preview/pr-57/platform/pki/key-management#view-details","View details",{"_3337":2220,"_29196":2204,"_5":29537,"_20242":54453,"_26574":54454,"_2824":54455},[],"/docs/pr-preview/pr-57/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3337":2221,"_29196":2204,"_5":29537,"_20242":54457,"_26574":54458,"_2824":54459},[],"/docs/pr-preview/pr-57/platform/pki/key-management#sign","Sign",{"_3337":2222,"_29196":2204,"_5":29537,"_20242":54461,"_26574":54462,"_2824":54463},[],"/docs/pr-preview/pr-57/platform/pki/key-management#verify","Verify",{"_3337":2223,"_29196":2204,"_5":29537,"_20242":54465,"_26574":54466,"_2824":54467},[],"/docs/pr-preview/pr-57/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3337":2224,"_29196":2204,"_5":29537,"_20242":54469,"_26574":54470,"_2824":54471},[],"/docs/pr-preview/pr-57/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3337":2225,"_29196":2204,"_5":29537,"_20242":54473,"_26574":54474,"_2824":54475},[],"/docs/pr-preview/pr-57/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3337":2226,"_29196":2204,"_20242":54477,"_5":13829,"_26574":2204,"_2824":54478},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3337":2227,"_29196":2204,"_20242":54480,"_5":13829,"_26574":2204,"_2824":54481},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3337":2228,"_29196":2204,"_20242":54483,"_5":13829,"_26574":54398,"_2824":54484},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3337":2229,"_29196":2204,"_20242":54486,"_5":13829,"_26574":54398,"_2824":54487},[],"In practice, it lets you:",{"_3337":2230,"_29196":2204,"_20242":54489,"_5":13829,"_26574":54398,"_2824":54490},[],"Generate new key pairs from Lamassu IoT.",{"_3337":2231,"_29196":2204,"_20242":54492,"_5":13829,"_26574":54398,"_2824":54493},[],"Import keys created externally.",{"_3337":2232,"_29196":2204,"_20242":54495,"_5":13829,"_26574":54398,"_2824":54496},[],"Delegate custody and cryptographic operations to external engines.",{"_3337":2233,"_29196":2204,"_20242":54498,"_5":13829,"_26574":54398,"_2824":54499},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3337":2234,"_29196":2204,"_20242":54501,"_5":13829,"_26574":54402,"_2824":54502},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3337":2235,"_29196":2204,"_20242":54504,"_5":13829,"_26574":54402,"_2824":54505},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3337":2236,"_29196":2204,"_20242":54507,"_5":13829,"_26574":54402,"_2824":54508},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3337":2237,"_29196":2204,"_20242":54510,"_5":13829,"_26574":54406,"_2824":54511},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3337":2238,"_29196":2204,"_20242":54513,"_5":13829,"_26574":54410,"_2824":54514},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3337":2239,"_29196":2204,"_20242":54516,"_5":13829,"_26574":54410,"_2824":54517},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3337":2240,"_29196":2204,"_20242":54519,"_5":13829,"_26574":54414,"_2824":54520},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3337":2241,"_29196":2204,"_20242":54522,"_5":13829,"_26574":54418,"_2824":54523},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3337":2242,"_29196":2204,"_20242":54525,"_5":13829,"_26574":54422,"_2824":54526},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3337":2243,"_29196":2204,"_20242":54528,"_5":13829,"_26574":54426,"_2824":54529},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3337":2244,"_29196":2204,"_20242":54531,"_5":13829,"_26574":54426,"_2824":54532},[],"Lamassu shows the enabled engines in the console.",{"_3337":2245,"_29196":2204,"_20242":54534,"_5":13829,"_26574":54426,"_2824":54535},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3337":2246,"_29196":2204,"_20242":54537,"_5":13829,"_26574":54426,"_2824":54538},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3337":2247,"_29196":2204,"_20242":54540,"_5":13829,"_26574":54430,"_2824":54541},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3337":2248,"_29196":2204,"_20242":54543,"_5":13829,"_26574":54430,"_2824":54544},[],"The table includes the following fields:",{"_3337":2249,"_29196":2204,"_20242":54546,"_5":13829,"_26574":54430,"_2824":54547},[],"**Name**: descriptive name of the key.",{"_3337":2250,"_29196":2204,"_20242":54549,"_5":13829,"_26574":54430,"_2824":54550},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3337":2251,"_29196":2204,"_20242":54552,"_5":13829,"_26574":54430,"_2824":54553},[],"**Strength**: visual indicator of cryptographic strength.",{"_3337":2252,"_29196":2204,"_20242":54555,"_5":13829,"_26574":54430,"_2824":54556},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3337":2253,"_29196":2204,"_20242":54558,"_5":13829,"_26574":54430,"_2824":54559},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3337":2254,"_29196":2204,"_20242":54561,"_5":13829,"_26574":54430,"_2824":54562},[],"**Aliases**: alternative names associated with the key.",{"_3337":2255,"_29196":2204,"_20242":54564,"_5":13829,"_26574":54430,"_2824":54565},[],"**Tags**: labels for classification and search.",{"_3337":2256,"_29196":2204,"_20242":54567,"_5":13829,"_26574":54430,"_2824":54568},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3337":2257,"_29196":2204,"_20242":54570,"_5":13829,"_26574":54430,"_2824":54571},[],"From this view you also reach the most common actions:",{"_3337":2258,"_29196":2204,"_20242":54573,"_5":13829,"_26574":54430,"_2824":54574},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3337":2259,"_29196":2204,"_20242":54576,"_5":13829,"_26574":54430,"_2824":54577},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3337":2260,"_29196":2204,"_20242":54579,"_5":13829,"_26574":54430,"_2824":54580},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3337":2261,"_29196":2204,"_20242":54582,"_5":13829,"_26574":54430,"_2824":54583},[],"**Delete Key** to remove the key from the system.",{"_3337":2262,"_29196":2204,"_20242":54585,"_5":13829,"_26574":54434,"_2824":54586},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3337":2263,"_29196":2204,"_20242":54588,"_5":13829,"_26574":54438,"_2824":54589},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3337":2264,"_29196":2204,"_20242":54591,"_5":13829,"_26574":54438,"_2824":54592},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3337":2265,"_29196":2204,"_20242":54594,"_5":13829,"_26574":54438,"_2824":54595},[],"**Key Name**: unique and descriptive name.",{"_3337":2266,"_29196":2204,"_20242":54597,"_5":13829,"_26574":54438,"_2824":54598},[],"**Crypto Engine**: engine that will keep the key.",{"_3337":2267,"_29196":2204,"_20242":54600,"_5":13829,"_26574":54438,"_2824":54601},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3337":2268,"_29196":2204,"_20242":54603,"_5":13829,"_26574":54438,"_2824":54604},[],"**Tags**: metadata to classify the key.",{"_3337":2269,"_29196":2204,"_20242":54606,"_5":13829,"_26574":54438,"_2824":54607},[],"**Metadata**: additional information for advanced uses.",{"_3337":2270,"_29196":2204,"_20242":54609,"_5":13829,"_26574":54442,"_2824":54610},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3337":2271,"_29196":2204,"_20242":54612,"_5":13829,"_26574":54442,"_2824":54613},[],"When you have an exportable private key and the destination engine supports import.",{"_3337":2272,"_29196":2204,"_20242":54615,"_5":13829,"_26574":54442,"_2824":54616},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3337":2273,"_29196":2204,"_20242":54618,"_5":13829,"_26574":54442,"_2824":54619},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3337":2274,"_29196":2204,"_20242":54621,"_5":13829,"_26574":54442,"_2824":54622},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3337":2275,"_29196":2204,"_20242":54624,"_5":13829,"_26574":54442,"_2824":54625},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3337":2276,"_29196":2204,"_20242":54627,"_5":13829,"_26574":54442,"_2824":54628},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3337":2277,"_29196":2204,"_20242":54630,"_5":13829,"_26574":54442,"_2824":54631},[],"**Tags**: labels for organization and search.",{"_3337":2278,"_29196":2204,"_20242":54633,"_5":13829,"_26574":54442,"_2824":54634},[],"**Metadata**: additional optional information.",{"_3337":2279,"_29196":2204,"_20242":54636,"_5":13829,"_26574":54442,"_2824":54637},[],"**Private Key (PEM)**: private key in PEM format.",{"_3337":2280,"_29196":2204,"_20242":54639,"_5":13829,"_26574":54442,"_2824":54640},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3337":2281,"_29196":2204,"_20242":54642,"_5":13829,"_26574":54446,"_2824":54643},[],"Each registered key has a detail view and several operational actions.",{"_3337":2282,"_29196":2204,"_20242":54645,"_5":13829,"_26574":54450,"_2824":54646},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3337":2283,"_29196":2204,"_20242":54648,"_5":13829,"_26574":54450,"_2824":54649},[],"The **Overview** tab shows, among others, these fields:",{"_3337":2284,"_29196":2204,"_20242":54651,"_5":13829,"_26574":54450,"_2824":54652},[],"**Key Name**: descriptive name.",{"_3337":2285,"_29196":2204,"_20242":54654,"_5":13829,"_26574":54450,"_2824":54655},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3337":2286,"_29196":2204,"_20242":54657,"_5":13829,"_26574":54450,"_2824":54658},[],"**Tags**: associated labels.",{"_3337":2287,"_29196":2204,"_20242":54660,"_5":13829,"_26574":54450,"_2824":54661},[],"**Aliases**: alternative names.",{"_3337":2288,"_29196":2204,"_20242":54663,"_5":13829,"_26574":54450,"_2824":54664},[],"**Crypto Engine**: engine where the key resides.",{"_3337":2289,"_29196":2204,"_20242":54666,"_5":13829,"_26574":54450,"_2824":54667},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3337":2290,"_29196":2204,"_20242":54669,"_5":13829,"_26574":54450,"_2824":54670},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3337":2291,"_29196":2204,"_20242":54672,"_5":13829,"_26574":54450,"_2824":54673},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3337":2292,"_29196":2204,"_20242":54675,"_5":13829,"_26574":54454,"_2824":54676},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3337":2293,"_29196":2204,"_20242":54678,"_5":13829,"_26574":54454,"_2824":54679},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3337":2294,"_29196":2204,"_20242":54681,"_5":13829,"_26574":54454,"_2824":54682},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3337":2295,"_29196":2204,"_20242":54684,"_5":13829,"_26574":54458,"_2824":54685},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3337":2296,"_29196":2204,"_20242":54687,"_5":13829,"_26574":54458,"_2824":54688},[],"Main fields:",{"_3337":2297,"_29196":2204,"_20242":54690,"_5":13829,"_26574":54458,"_2824":54691},[],"**Algorithm**: signing algorithm available for the key type.",{"_3337":2298,"_29196":2204,"_20242":54693,"_5":13829,"_26574":54458,"_2824":54694},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3337":2299,"_29196":2204,"_20242":54696,"_5":13829,"_26574":54458,"_2824":54697},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3337":2300,"_29196":2204,"_20242":54699,"_5":13829,"_26574":54458,"_2824":54700},[],"**Message**: content to sign.",{"_3337":2301,"_29196":2204,"_20242":54702,"_5":13829,"_26574":54458,"_2824":54703},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3337":2302,"_29196":2204,"_20242":54705,"_5":13829,"_26574":54462,"_2824":54706},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3337":2303,"_29196":2204,"_20242":54708,"_5":13829,"_26574":54462,"_2824":54688},[],{"_3337":2304,"_29196":2204,"_20242":54710,"_5":13829,"_26574":54462,"_2824":54711},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3337":2305,"_29196":2204,"_20242":54713,"_5":13829,"_26574":54462,"_2824":54714},[],"**Message Type**: `Raw` or `Digest`.",{"_3337":2306,"_29196":2204,"_20242":54716,"_5":13829,"_26574":54462,"_2824":54717},[],"**Payload Encoding**: encoding of the message.",{"_3337":2307,"_29196":2204,"_20242":54719,"_5":13829,"_26574":54462,"_2824":54720},[],"**Message**: original message or hash.",{"_3337":2308,"_29196":2204,"_20242":54722,"_5":13829,"_26574":54462,"_2824":54723},[],"**Signature**: signature to check.",{"_3337":2309,"_29196":2204,"_20242":54725,"_5":13829,"_26574":54462,"_2824":54726},[],"**Result**: indicator of the validation result.",{"_3337":2310,"_29196":2204,"_20242":54728,"_5":13829,"_26574":54466,"_2824":54729},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3337":2311,"_29196":2204,"_20242":54731,"_5":13829,"_26574":54466,"_2824":54732},[],"This flow is useful for:",{"_3337":2312,"_29196":2204,"_20242":54734,"_5":13829,"_26574":54466,"_2824":54735},[],"Requesting certificates from an external CA.",{"_3337":2313,"_29196":2204,"_20242":54737,"_5":13829,"_26574":54466,"_2824":54738},[],"Renewing an identity while keeping the same key.",{"_3337":2314,"_29196":2204,"_20242":54740,"_5":13829,"_26574":54466,"_2824":54741},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3337":2315,"_29196":2204,"_20242":54743,"_5":13829,"_26574":54466,"_2824":54744},[],"**Common Name (CN)**: main name of the identity.",{"_3337":2316,"_29196":2204,"_20242":54746,"_5":13829,"_26574":54466,"_2824":54747},[],"**Organization (O)**: organization or company.",{"_3337":2317,"_29196":2204,"_20242":54749,"_5":13829,"_26574":54466,"_2824":54750},[],"**Organizational Unit (OU)**: department or unit.",{"_3337":2318,"_29196":2204,"_20242":54752,"_5":13829,"_26574":54466,"_2824":54753},[],"**Country (C)**: two-letter country code.",{"_3337":2319,"_29196":2204,"_20242":54755,"_5":13829,"_26574":54466,"_2824":54756},[],"**State / Province (ST)**: state or province.",{"_3337":2320,"_29196":2204,"_20242":54758,"_5":13829,"_26574":54466,"_2824":54759},[],"**Locality (L)**: city or locality.",{"_3337":2321,"_29196":2204,"_20242":54761,"_5":13829,"_26574":54466,"_2824":54762},[],"**Email Address**: contact email.",{"_3337":2322,"_29196":2204,"_20242":54764,"_5":13829,"_26574":54466,"_2824":54765},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3337":2323,"_29196":2204,"_20242":54767,"_5":13829,"_26574":54466,"_2824":54768},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3337":2324,"_29196":2204,"_20242":54770,"_5":13829,"_26574":54470,"_2824":54771},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3337":2325,"_29196":2204,"_20242":54773,"_5":13829,"_26574":54470,"_2824":54774},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3337":2326,"_29196":2204,"_20242":54776,"_5":13829,"_26574":54474,"_2824":54777},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Lamassu rejects deleting a key while a certificate still references it, with `409` `key is in use`; release or delete the dependent certificates first. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3337":2327,"_29196":2327,"_5":14181,"_2824":54779,"_29540":54780,"_20242":54781,"_26574":2327},"Online validation with OCSP",[47528,48977,52983,53613],[],{"_3337":2328,"_29196":2327,"_20242":54783,"_5":13829,"_26574":2327,"_2824":54784},[],"Query signed status and verify the responder’s response.",{"_3337":2329,"_29196":2327,"_5":29537,"_20242":54786,"_26574":54787,"_2824":54788},[],"/docs/pr-preview/pr-57/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3337":2330,"_29196":2327,"_5":29537,"_20242":54790,"_26574":54791,"_2824":54792},[],"/docs/pr-preview/pr-57/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3337":2331,"_29196":2327,"_5":29537,"_20242":54794,"_26574":54795,"_2824":54796},[],"/docs/pr-preview/pr-57/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3337":2332,"_29196":2327,"_5":29537,"_20242":54798,"_26574":54799,"_2824":54800},[],"/docs/pr-preview/pr-57/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3337":2333,"_29196":2327,"_5":29537,"_20242":54802,"_26574":54803,"_2824":54804},[],"/docs/pr-preview/pr-57/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3337":2334,"_29196":2327,"_5":29537,"_20242":54806,"_26574":54807,"_2824":54170},[],"/docs/pr-preview/pr-57/platform/pki/ocsp#references",{"_3337":2335,"_29196":2327,"_20242":54809,"_5":13829,"_26574":2327,"_2824":54810},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3337":2336,"_29196":2327,"_20242":54812,"_5":13829,"_26574":54787,"_2824":54813},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3337":2337,"_29196":2327,"_20242":54815,"_5":13829,"_26574":54787,"_2824":54816},[],"Record status",{"_3337":2338,"_29196":2327,"_20242":54818,"_5":13829,"_26574":54787,"_2824":54819},[],"Signed response",{"_3337":2339,"_29196":2327,"_20242":54821,"_5":13829,"_26574":54787,"_2824":52154},[],{"_3337":2340,"_29196":2327,"_20242":54823,"_5":13829,"_26574":54787,"_2824":54824},[],"`Good`.",{"_3337":2341,"_29196":2327,"_20242":54826,"_5":13829,"_26574":54787,"_2824":52171},[],{"_3337":2342,"_29196":2327,"_20242":54828,"_5":13829,"_26574":54787,"_2824":54829},[],"`Revoked`, with revocation reason and timestamp.",{"_3337":2343,"_29196":2327,"_20242":54831,"_5":13829,"_26574":54787,"_2824":54832},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3337":2344,"_29196":2327,"_20242":54834,"_5":13829,"_26574":54787,"_2824":54835},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3337":2345,"_29196":2327,"_20242":54837,"_5":13829,"_26574":54787,"_2824":54838},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3337":2346,"_29196":2327,"_20242":54840,"_5":13829,"_26574":54787,"_2824":54841},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3337":2347,"_29196":2327,"_20242":54843,"_5":13829,"_26574":54787,"_2824":54844},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3337":2348,"_29196":2327,"_20242":54846,"_5":13829,"_26574":54791,"_2824":54847},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3337":2349,"_29196":2327,"_20242":54849,"_5":13829,"_26574":54791,"_2824":54850},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3337":2350,"_29196":2327,"_20242":54852,"_5":13829,"_26574":54795,"_2824":54853},[],"The service accepts:",{"_3337":2351,"_29196":2327,"_20242":54855,"_5":13829,"_26574":54795,"_2824":50741},[],{"_3337":2352,"_29196":2327,"_20242":54857,"_5":13829,"_26574":54795,"_2824":54858},[],"VA service path",{"_3337":2353,"_29196":2327,"_20242":54860,"_5":13829,"_26574":54795,"_2824":54861},[],"Format",{"_3337":2354,"_29196":2327,"_20242":54863,"_5":13829,"_26574":54795,"_2824":54864},[],"`POST`",{"_3337":2355,"_29196":2327,"_20242":54866,"_5":13829,"_26574":54795,"_2824":54867},[],"`/ocsp`",{"_3337":2356,"_29196":2327,"_20242":54869,"_5":13829,"_26574":54795,"_2824":54870},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3337":2357,"_29196":2327,"_20242":54872,"_5":13829,"_26574":54795,"_2824":54296},[],{"_3337":2358,"_29196":2327,"_20242":54874,"_5":13829,"_26574":54795,"_2824":54875},[],"`/ocsp/{ocsp_request}`",{"_3337":2359,"_29196":2327,"_20242":54877,"_5":13829,"_26574":54795,"_2824":54878},[],"DER request encoded using padded URL Base64.",{"_3337":2360,"_29196":2327,"_20242":54880,"_5":13829,"_26574":54795,"_2824":54881},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3337":2361,"_29196":2327,"_20242":54883,"_5":13829,"_26574":54799,"_2824":54884},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3337":2362,"_29196":2327,"_20242":54886,"_5":13829,"_26574":54799,"_2824":54887},[],"Generate the request:",{"_3337":2363,"_29196":2327,"_20242":54889,"_5":13829,"_26574":54799,"_2824":54890},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3337":2364,"_29196":2327,"_20242":54892,"_5":13829,"_26574":54799,"_2824":54893},[],"Replace the example URL with the inspected endpoint:",{"_3337":2365,"_29196":2327,"_20242":54895,"_5":13829,"_26574":54799,"_2824":54896},[],"Verify the returned DER:",{"_3337":2366,"_29196":2327,"_20242":54898,"_5":13829,"_26574":54799,"_2824":54899},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3337":2367,"_29196":2327,"_20242":54901,"_5":13829,"_26574":54803,"_2824":54902},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3337":2368,"_29196":2327,"_20242":54904,"_5":13829,"_26574":54803,"_2824":54905},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3337":2369,"_29196":2327,"_20242":54907,"_5":13829,"_26574":54807,"_2824":54908},[],"RFC 6960: OCSP.",{"_3337":2370,"_29196":2327,"_20242":54910,"_5":13829,"_26574":54807,"_2824":54911},[],"OpenSSL: openssl-ocsp.",{"_3337":2371,"_29196":2327,"_20242":54913,"_5":13829,"_26574":54807,"_2824":54914},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3337":2372,"_29196":2327,"_20242":54916,"_5":13829,"_26574":54807,"_2824":54388},[],{"_3337":2373,"_29196":2373,"_5":14181,"_2824":52983,"_29540":54918,"_20242":54919,"_26574":2373},[47528,48977,52983],[],{"_3337":2374,"_29196":2373,"_20242":54921,"_5":13829,"_26574":2373,"_2824":54922},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3337":2375,"_29196":2373,"_5":29537,"_20242":54924,"_26574":54925,"_2824":52295},[],"/docs/pr-preview/pr-57/platform/pki/overview#start-here",{"_3337":2376,"_29196":2373,"_5":29537,"_20242":54927,"_26574":54928,"_2824":54929},[],"/docs/pr-preview/pr-57/platform/pki/overview#what-you-need","What you need",{"_3337":2377,"_29196":2373,"_5":29537,"_20242":54931,"_26574":54932,"_2824":52827},[],"/docs/pr-preview/pr-57/platform/pki/overview#core-capabilities",{"_3337":2378,"_29196":2373,"_5":29537,"_20242":54934,"_26574":54935,"_2824":52831},[],"/docs/pr-preview/pr-57/platform/pki/overview#build-your-trust-hierarchy",{"_3337":2379,"_29196":2373,"_5":29537,"_20242":54937,"_26574":54938,"_2824":52835},[],"/docs/pr-preview/pr-57/platform/pki/overview#protect-cryptographic-keys",{"_3337":2380,"_29196":2373,"_5":29537,"_20242":54940,"_26574":54941,"_2824":52839},[],"/docs/pr-preview/pr-57/platform/pki/overview#issue-and-control-certificates",{"_3337":2381,"_29196":2373,"_5":29537,"_20242":54943,"_26574":54944,"_2824":52847},[],"/docs/pr-preview/pr-57/platform/pki/overview#publish-validation-status",{"_3337":2382,"_29196":2373,"_5":29537,"_20242":54946,"_26574":54947,"_2824":54948},[],"/docs/pr-preview/pr-57/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3337":2383,"_29196":2373,"_5":29537,"_20242":54950,"_26574":54951,"_2824":53780},[],"/docs/pr-preview/pr-57/platform/pki/overview#continue",{"_3337":2384,"_29196":2373,"_20242":54953,"_5":13829,"_26574":2373,"_2824":54954},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3337":2385,"_29196":2373,"_20242":54956,"_5":13829,"_26574":54925,"_2824":54957},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3337":2386,"_29196":2373,"_20242":54959,"_5":13829,"_26574":54925,"_2824":54960},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3337":2387,"_29196":2373,"_20242":54962,"_5":13829,"_26574":54928,"_2824":54963},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3337":2388,"_29196":2373,"_20242":54965,"_5":13829,"_26574":54928,"_2824":54966},[],"An available cryptographic engine to keep the authority's key.",{"_3337":2389,"_29196":2373,"_20242":54968,"_5":13829,"_26574":54928,"_2824":54969},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3337":2390,"_29196":2373,"_20242":54971,"_5":13829,"_26574":54928,"_2824":54972},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3337":2391,"_29196":2373,"_20242":54974,"_5":13829,"_26574":54928,"_2824":54975},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3337":2392,"_29196":2373,"_20242":54977,"_5":13829,"_26574":54935,"_2824":54978},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3337":2393,"_29196":2373,"_20242":54980,"_5":13829,"_26574":54938,"_2824":54981},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3337":2394,"_29196":2373,"_20242":54983,"_5":13829,"_26574":54941,"_2824":54984},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3337":2395,"_29196":2373,"_20242":54986,"_5":13829,"_26574":54944,"_2824":54987},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3337":2396,"_29196":2373,"_20242":54989,"_5":13829,"_26574":54947,"_2824":54990},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3337":2397,"_29196":2373,"_20242":54992,"_5":13829,"_26574":54947,"_2824":54993},[],"its subject and extensions identify the expected client;",{"_3337":2398,"_29196":2373,"_20242":54995,"_5":13829,"_26574":54947,"_2824":54996},[],"its public key matches the client's private key;",{"_3337":2399,"_29196":2373,"_20242":54998,"_5":13829,"_26574":54947,"_2824":54999},[],"its chain reaches a root trusted by the consumer;",{"_3337":2400,"_29196":2373,"_20242":55001,"_5":13829,"_26574":54947,"_2824":55002},[],"its dates and usages allow the operation;",{"_3337":2401,"_29196":2373,"_20242":55004,"_5":13829,"_26574":54947,"_2824":55005},[],"the consumer applies revocation checks and authorization.",{"_3337":2402,"_29196":2373,"_20242":55007,"_5":13829,"_26574":54947,"_2824":55008},[],"The issuance path includes the first independent checks.",{"_3337":2403,"_29196":2373,"_20242":55010,"_5":13829,"_26574":54951,"_2824":55011},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3337":2404,"_29196":2373,"_20242":55013,"_5":13829,"_26574":54951,"_2824":55014},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3337":2405,"_29196":2373,"_20242":55016,"_5":13829,"_26574":54951,"_2824":55017},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3337":2406,"_29196":2406,"_5":14181,"_2824":55019,"_29540":55020,"_20242":55021,"_26574":2406},"Create your first CA",[47528,48977,52983,52420],[],{"_3337":2407,"_29196":2406,"_20242":55023,"_5":13829,"_26574":2406,"_2824":55024},[],"Create an evaluation root and check its certificate before issuing.",{"_3337":2408,"_29196":2406,"_5":29537,"_20242":55026,"_26574":55027,"_2824":47538},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3337":2409,"_29196":2406,"_5":29537,"_20242":55029,"_26574":55030,"_2824":55031},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3337":2410,"_29196":2406,"_5":29537,"_20242":55033,"_26574":55034,"_2824":55035},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3337":2411,"_29196":2406,"_5":29537,"_20242":55037,"_26574":55038,"_2824":55039},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3337":2412,"_29196":2406,"_5":29537,"_20242":55041,"_26574":55042,"_2824":55043},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3337":2413,"_29196":2406,"_5":29537,"_20242":55045,"_26574":55046,"_2824":55047},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3337":2414,"_29196":2406,"_5":29537,"_20242":55049,"_26574":55050,"_2824":55051},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3337":2415,"_29196":2406,"_5":29537,"_20242":55053,"_26574":55054,"_2824":52677},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3337":2416,"_29196":2406,"_5":29537,"_20242":55056,"_26574":55057,"_2824":47562},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3337":2417,"_29196":2406,"_20242":55059,"_5":13829,"_26574":2406,"_2824":55060},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3337":2418,"_29196":2406,"_20242":55062,"_5":13829,"_26574":55027,"_2824":55063},[],"Console access and permission to create keys and authorities.",{"_3337":2419,"_29196":2406,"_20242":55065,"_5":13829,"_26574":55027,"_2824":55066},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3337":2420,"_29196":2406,"_20242":55068,"_5":13829,"_26574":55027,"_2824":55069},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3337":2421,"_29196":2406,"_20242":55071,"_5":13829,"_26574":55027,"_2824":55072},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3337":2422,"_29196":2406,"_20242":55074,"_5":13829,"_26574":55030,"_2824":55075},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3337":2423,"_29196":2406,"_20242":55077,"_5":13829,"_26574":55030,"_2824":55078},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3337":2424,"_29196":2406,"_20242":55080,"_5":13829,"_26574":55034,"_2824":55081},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3337":2425,"_29196":2406,"_20242":55083,"_5":13829,"_26574":55034,"_2824":55084},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3337":2426,"_29196":2406,"_20242":55086,"_5":13829,"_26574":55038,"_2824":55087},[],"Select **Root CA** and complete:",{"_3337":2427,"_29196":2406,"_20242":55089,"_5":13829,"_26574":55038,"_2824":55090},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3337":2428,"_29196":2406,"_20242":55092,"_5":13829,"_26574":55038,"_2824":55093},[],"**Subject**: organization and country details for your evaluation.",{"_3337":2429,"_29196":2406,"_20242":55095,"_5":13829,"_26574":55038,"_2824":55096},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3337":2430,"_29196":2406,"_20242":55098,"_5":13829,"_26574":55038,"_2824":55099},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3337":2431,"_29196":2406,"_20242":55101,"_5":13829,"_26574":55038,"_2824":55102},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3337":2432,"_29196":2406,"_20242":55104,"_5":13829,"_26574":55042,"_2824":55105},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3337":2433,"_29196":2406,"_20242":55107,"_5":13829,"_26574":55046,"_2824":55108},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3337":2434,"_29196":2406,"_20242":55110,"_5":13829,"_26574":55046,"_2824":55111},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3337":2435,"_29196":2406,"_20242":55113,"_5":13829,"_26574":55050,"_2824":55114},[],"Run from the directory where you saved `ca.pem`:",{"_3337":2436,"_29196":2406,"_20242":55116,"_5":13829,"_26574":55050,"_2824":55117},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3337":2437,"_29196":2406,"_20242":55119,"_5":13829,"_26574":55050,"_2824":55120},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3337":2438,"_29196":2406,"_20242":55122,"_5":13829,"_26574":55054,"_2824":55123},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3337":2439,"_29196":2406,"_20242":55125,"_5":13829,"_26574":55054,"_2824":55126},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3337":2440,"_29196":2406,"_20242":55128,"_5":13829,"_26574":55054,"_2824":55129},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3337":2441,"_29196":2406,"_20242":55131,"_5":13829,"_26574":55054,"_2824":55132},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3337":2442,"_29196":2406,"_20242":55134,"_5":13829,"_26574":55057,"_2824":55135},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3337":2443,"_29196":2443,"_5":14181,"_2824":55137,"_29540":55138,"_20242":55139,"_26574":2443},"Issue and verify a certificate",[47528,48977,52983,52420],[],{"_3337":2444,"_29196":2443,"_20242":55141,"_5":13829,"_26574":2443,"_2824":55142},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3337":2445,"_29196":2443,"_5":29537,"_20242":55144,"_26574":55145,"_2824":47538},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3337":2446,"_29196":2443,"_5":29537,"_20242":55147,"_26574":55148,"_2824":55149},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3337":2447,"_29196":2443,"_5":29537,"_20242":55151,"_26574":55152,"_2824":55153},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3337":2448,"_29196":2443,"_5":29537,"_20242":55155,"_26574":55156,"_2824":55157},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3337":2449,"_29196":2443,"_5":29537,"_20242":55159,"_26574":55160,"_2824":55161},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3337":2450,"_29196":2443,"_5":29537,"_20242":55163,"_26574":55164,"_2824":55165},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3337":2451,"_29196":2443,"_5":29537,"_20242":55167,"_26574":55168,"_2824":55169},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3337":2452,"_29196":2443,"_5":29537,"_20242":55171,"_26574":55172,"_2824":55173},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3337":2453,"_29196":2443,"_5":29537,"_20242":55175,"_26574":55176,"_2824":55177},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3337":2454,"_29196":2443,"_5":29537,"_20242":55179,"_26574":55180,"_2824":55181},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3337":2455,"_29196":2443,"_5":29537,"_20242":55183,"_26574":55184,"_2824":52677},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3337":2456,"_29196":2443,"_5":29537,"_20242":55186,"_26574":55187,"_2824":47562},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/issue-certificate#next-step",{"_3337":2457,"_29196":2443,"_20242":55189,"_5":13829,"_26574":2443,"_2824":55190},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3337":2458,"_29196":2443,"_20242":55192,"_5":13829,"_26574":55145,"_2824":55193},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3337":2459,"_29196":2443,"_20242":55195,"_5":13829,"_26574":55145,"_2824":55196},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3337":2460,"_29196":2443,"_20242":55198,"_5":13829,"_26574":55145,"_2824":55199},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3337":2461,"_29196":2443,"_20242":55201,"_5":13829,"_26574":55145,"_2824":55202},[],"A client identifier: here we use `device-001`.",{"_3337":2462,"_29196":2443,"_20242":55204,"_5":13829,"_26574":55145,"_2824":55205},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3337":2463,"_29196":2443,"_20242":55207,"_5":13829,"_26574":55148,"_2824":55208},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3337":2464,"_29196":2443,"_20242":55210,"_5":13829,"_26574":55152,"_2824":55211},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3337":2465,"_29196":2443,"_20242":55213,"_5":13829,"_26574":55152,"_2824":55214},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3337":2466,"_29196":2443,"_20242":55216,"_5":13829,"_26574":55156,"_2824":55217},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3337":2467,"_29196":2443,"_20242":55219,"_5":13829,"_26574":55156,"_2824":55220},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3337":2468,"_29196":2443,"_20242":55222,"_5":13829,"_26574":55160,"_2824":55223},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3337":2469,"_29196":2443,"_20242":55225,"_5":13829,"_26574":55160,"_2824":55226},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3337":2470,"_29196":2443,"_20242":55228,"_5":13829,"_26574":55164,"_2824":55229},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3337":2471,"_29196":2443,"_20242":55231,"_5":13829,"_26574":55168,"_2824":55232},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3337":2472,"_29196":2443,"_20242":55234,"_5":13829,"_26574":55172,"_2824":55235},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3337":2473,"_29196":2443,"_20242":55237,"_5":13829,"_26574":55176,"_2824":55238},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3337":2474,"_29196":2443,"_20242":55240,"_5":13829,"_26574":55176,"_2824":55241},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3337":2475,"_29196":2443,"_20242":55243,"_5":13829,"_26574":55176,"_2824":55244},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3337":2476,"_29196":2443,"_20242":55246,"_5":13829,"_26574":55180,"_2824":55247},[],"In Bash, compare the two public-key digests:",{"_3337":2477,"_29196":2443,"_20242":55249,"_5":13829,"_26574":55180,"_2824":55250},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3337":2478,"_29196":2443,"_20242":55252,"_5":13829,"_26574":55180,"_2824":55253},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3337":2479,"_29196":2443,"_20242":55255,"_5":13829,"_26574":55184,"_2824":52761},[],{"_3337":2480,"_29196":2443,"_20242":55257,"_5":13829,"_26574":55184,"_2824":55258},[],"What to review",{"_3337":2481,"_29196":2443,"_20242":55260,"_5":13829,"_26574":55184,"_2824":55261},[],"The CA rejects issuance",{"_3337":2482,"_29196":2443,"_20242":55263,"_5":13829,"_26574":55184,"_2824":55264},[],"Permissions, CA state and key, algorithm and profile.",{"_3337":2483,"_29196":2443,"_20242":55266,"_5":13829,"_26574":55184,"_2824":55267},[],"Different subject or usages",{"_3337":2484,"_29196":2443,"_20242":55269,"_5":13829,"_26574":55184,"_2824":55270},[],"Applied profile and requested values.",{"_3337":2485,"_29196":2443,"_20242":55272,"_5":13829,"_26574":55184,"_2824":55273},[],"Issuer cannot be found",{"_3337":2486,"_29196":2443,"_20242":55275,"_5":13829,"_26574":55184,"_2824":55276},[],"Downloaded CA and required intermediate chain.",{"_3337":2487,"_29196":2443,"_20242":55278,"_5":13829,"_26574":55184,"_2824":55279},[],"Validity fails",{"_3337":2488,"_29196":2443,"_20242":55281,"_5":13829,"_26574":55184,"_2824":55282},[],"Certificate and CA dates, and the computer's clock.",{"_3337":2489,"_29196":2443,"_20242":55284,"_5":13829,"_26574":55184,"_2824":55285},[],"Public-key digests differ",{"_3337":2490,"_29196":2443,"_20242":55287,"_5":13829,"_26574":55184,"_2824":55288},[],"Certificate and key files from the same issuance.",{"_3337":2491,"_29196":2443,"_20242":55290,"_5":13829,"_26574":55184,"_2824":55291},[],"See PKI diagnostics to narrow an issuance failure.",{"_3337":2492,"_29196":2443,"_20242":55293,"_5":13829,"_26574":55187,"_2824":55294},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3337":2493,"_29196":2443,"_20242":55296,"_5":13829,"_26574":55187,"_2824":55297},[],"Manage certificates for inspection, status and revocation.",{"_3337":2494,"_29196":2443,"_20242":55299,"_5":13829,"_26574":55187,"_2824":55300},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3337":2495,"_29196":2443,"_20242":55302,"_5":13829,"_26574":55187,"_2824":55303},[],"Prepare EST for the device to request its next identities.",{"_3337":2496,"_29196":2443,"_20242":55305,"_5":13829,"_26574":55187,"_2824":55306},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3337":2497,"_29196":2497,"_5":14181,"_2824":55308,"_29540":55309,"_20242":55310,"_26574":2497},"PKI getting started",[47528,48977,52983,52420],[],{"_3337":2498,"_29196":2497,"_20242":55312,"_5":13829,"_26574":2497,"_2824":55313},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3337":2499,"_29196":2497,"_5":29537,"_20242":55315,"_26574":55316,"_2824":47538},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/overview#before-you-begin",{"_3337":2500,"_29196":2497,"_5":29537,"_20242":55318,"_26574":55319,"_2824":55320},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3337":2501,"_29196":2497,"_5":29537,"_20242":55322,"_26574":55323,"_2824":52612},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/overview#expected-result",{"_3337":2502,"_29196":2497,"_5":29537,"_20242":55325,"_26574":55326,"_2824":55327},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3337":2503,"_29196":2497,"_20242":55329,"_5":13829,"_26574":2497,"_2824":55330},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3337":2504,"_29196":2497,"_20242":55332,"_5":13829,"_26574":55316,"_2824":55333},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3337":2505,"_29196":2497,"_20242":55335,"_5":13829,"_26574":55316,"_2824":55336},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3337":2506,"_29196":2497,"_20242":55338,"_5":13829,"_26574":55316,"_2824":55339},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3337":2507,"_29196":2497,"_20242":55341,"_5":13829,"_26574":55316,"_2824":55342},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3337":2508,"_29196":2497,"_20242":55344,"_5":13829,"_26574":55316,"_2824":55345},[],"A working directory with restricted access for the downloaded key.",{"_3337":2509,"_29196":2497,"_20242":55347,"_5":13829,"_26574":55319,"_2824":55348},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3337":2510,"_29196":2497,"_20242":55350,"_5":13829,"_26574":55319,"_2824":55351},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3337":2511,"_29196":2497,"_20242":55353,"_5":13829,"_26574":55319,"_2824":55354},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3337":2512,"_29196":2497,"_20242":55356,"_5":13829,"_26574":55319,"_2824":55357},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3337":2513,"_29196":2497,"_20242":55359,"_5":13829,"_26574":55323,"_2824":55360},[],"File or resource",{"_3337":2514,"_29196":2497,"_20242":55362,"_5":13829,"_26574":55323,"_2824":52609},[],{"_3337":2515,"_29196":2497,"_20242":55364,"_5":13829,"_26574":55323,"_2824":55365},[],"Active root CA and `ca.pem`",{"_3337":2516,"_29196":2497,"_20242":55367,"_5":13829,"_26574":55323,"_2824":55368},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3337":2517,"_29196":2497,"_20242":55370,"_5":13829,"_26574":55323,"_2824":55371},[],"End-entity certificate and `device.crt`",{"_3337":2518,"_29196":2497,"_20242":55373,"_5":13829,"_26574":55323,"_2824":55374},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3337":2519,"_29196":2497,"_20242":55376,"_5":13829,"_26574":55323,"_2824":55377},[],"Private key `device.key`",{"_3337":2520,"_29196":2497,"_20242":55379,"_5":13829,"_26574":55323,"_2824":55380},[],"Its public key matches the one included in `device.crt`.",{"_3337":2521,"_29196":2497,"_20242":55382,"_5":13829,"_26574":55323,"_2824":55383},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3337":2522,"_29196":2497,"_20242":55385,"_5":13829,"_26574":55326,"_2824":55386},[],"To operate certificates, continue with Certificates and Validation.",{"_3337":2523,"_29196":2497,"_20242":55388,"_5":13829,"_26574":55326,"_2824":55389},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3337":2524,"_29196":2497,"_20242":55391,"_5":13829,"_26574":55326,"_2824":55392},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3337":2525,"_29196":2525,"_5":14181,"_2824":55394,"_29540":55395,"_20242":55396,"_26574":2525},"PKI troubleshooting",[47528,48977,52983,51555],[],{"_3337":2526,"_29196":2525,"_20242":55398,"_5":13829,"_26574":2525,"_2824":55399},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3337":2527,"_29196":2525,"_5":29537,"_20242":55401,"_26574":55402,"_2824":55403},[],"/docs/pr-preview/pr-57/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3337":2528,"_29196":2525,"_5":29537,"_20242":55405,"_26574":55406,"_2824":55407},[],"/docs/pr-preview/pr-57/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3337":2529,"_29196":2525,"_5":29537,"_20242":55409,"_26574":55410,"_2824":55411},[],"/docs/pr-preview/pr-57/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3337":2530,"_29196":2525,"_20242":55413,"_5":13829,"_26574":2525,"_2824":55414},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3337":2531,"_29196":2525,"_20242":55416,"_5":13829,"_26574":2525,"_2824":55417},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3337":2532,"_29196":2525,"_20242":55419,"_5":13829,"_26574":55402,"_2824":52609},[],{"_3337":2533,"_29196":2525,"_20242":55421,"_5":13829,"_26574":55402,"_2824":55422},[],"What to inspect",{"_3337":2534,"_29196":2525,"_20242":55424,"_5":13829,"_26574":55402,"_2824":47562},[],{"_3337":2535,"_29196":2525,"_20242":55426,"_5":13829,"_26574":55402,"_2824":51822},[],{"_3337":2536,"_29196":2525,"_20242":55428,"_5":13829,"_26574":55402,"_2824":55429},[],"Exists, is active and has usable dates.",{"_3337":2537,"_29196":2525,"_20242":55431,"_5":13829,"_26574":55402,"_2824":55432},[],"Authorities.",{"_3337":2538,"_29196":2525,"_20242":55434,"_5":13829,"_26574":55402,"_2824":55435},[],"Key",{"_3337":2539,"_29196":2525,"_20242":55437,"_5":13829,"_26574":55402,"_2824":55438},[],"The record has a usable private key and the engine can sign.",{"_3337":2540,"_29196":2525,"_20242":55440,"_5":13829,"_26574":55402,"_2824":55441},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3337":2541,"_29196":2525,"_20242":55443,"_5":13829,"_26574":55402,"_2824":55444},[],"CSR",{"_3337":2542,"_29196":2525,"_20242":55446,"_5":13829,"_26574":55402,"_2824":55447},[],"Correct PEM and verifiable signature.",{"_3337":2543,"_29196":2525,"_20242":55449,"_5":13829,"_26574":55402,"_2824":55450},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3337":2544,"_29196":2525,"_20242":55452,"_5":13829,"_26574":55402,"_2824":55453},[],"Profile",{"_3337":2545,"_29196":2525,"_20242":55455,"_5":13829,"_26574":55402,"_2824":55456},[],"Selected source, existing ID, allowed algorithm and size.",{"_3337":2546,"_29196":2525,"_20242":55458,"_5":13829,"_26574":55402,"_2824":55459},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3337":2547,"_29196":2525,"_20242":55461,"_5":13829,"_26574":55402,"_2824":52761},[],{"_3337":2548,"_29196":2525,"_20242":55463,"_5":13829,"_26574":55402,"_2824":55464},[],"Appropriate subject, SAN, usages and dates.",{"_3337":2549,"_29196":2525,"_20242":55466,"_5":13829,"_26574":55402,"_2824":55467},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3337":2550,"_29196":2525,"_20242":55469,"_5":13829,"_26574":55402,"_2824":55470},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3337":2551,"_29196":2525,"_20242":55472,"_5":13829,"_26574":55402,"_2824":55473},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3337":2552,"_29196":2525,"_20242":55475,"_5":13829,"_26574":55406,"_2824":55476},[],"Check each boundary independently:",{"_3337":2553,"_29196":2525,"_20242":55478,"_5":13829,"_26574":55406,"_2824":55479},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3337":2554,"_29196":2525,"_20242":55481,"_5":13829,"_26574":55406,"_2824":55482},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3337":2555,"_29196":2525,"_20242":55484,"_5":13829,"_26574":55406,"_2824":55485},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3337":2556,"_29196":2525,"_20242":55487,"_5":13829,"_26574":55406,"_2824":55488},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3337":2557,"_29196":2525,"_20242":55490,"_5":13829,"_26574":55406,"_2824":55491},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3337":2558,"_29196":2525,"_20242":55493,"_5":13829,"_26574":55406,"_2824":55494},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3337":2559,"_29196":2525,"_20242":55496,"_5":13829,"_26574":55410,"_2824":55497},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3337":2560,"_29196":2525,"_20242":55499,"_5":13829,"_26574":55410,"_2824":55500},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3337":2561,"_29196":2561,"_5":14181,"_2824":55502,"_29540":55503,"_20242":55505,"_26574":2561},"3.8.0 to 4.0.0",[47528,55504],"Upgrades",[],{"_3337":2562,"_29196":2561,"_20242":55507,"_5":13829,"_26574":2561,"_2824":55508},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3337":2563,"_29196":2561,"_5":29537,"_20242":55510,"_26574":55511,"_2824":55512},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3337":2564,"_29196":2561,"_5":29537,"_20242":55514,"_26574":55515,"_2824":55516},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3337":2565,"_29196":2561,"_5":29537,"_20242":55518,"_26574":55519,"_2824":55520},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3337":2566,"_29196":2561,"_5":29537,"_20242":55522,"_26574":55523,"_2824":55524},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3337":2567,"_29196":2561,"_5":29537,"_20242":55526,"_26574":55527,"_2824":55528},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3337":2568,"_29196":2561,"_5":29537,"_20242":55530,"_26574":55531,"_2824":55532},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3337":2569,"_29196":2561,"_5":29537,"_20242":55534,"_26574":55535,"_2824":55536},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3337":2570,"_29196":2561,"_5":29537,"_20242":55538,"_26574":55539,"_2824":55540},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3337":2571,"_29196":2561,"_5":29537,"_20242":55542,"_26574":55543,"_2824":55544},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3337":2572,"_29196":2561,"_5":29537,"_20242":55546,"_26574":55547,"_2824":55548},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3337":2573,"_29196":2561,"_5":29537,"_20242":55550,"_26574":55551,"_2824":55552},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3337":2574,"_29196":2561,"_5":29537,"_20242":55554,"_26574":55555,"_2824":55556},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3337":2575,"_29196":2561,"_5":29537,"_20242":55558,"_26574":55559,"_2824":55560},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3337":2576,"_29196":2561,"_5":29537,"_20242":55562,"_26574":55563,"_2824":55564},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3337":2577,"_29196":2561,"_5":29537,"_20242":55566,"_26574":55567,"_2824":55568},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3337":2578,"_29196":2561,"_5":29537,"_20242":55570,"_26574":55571,"_2824":55572},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3337":2579,"_29196":2561,"_5":29537,"_20242":55574,"_26574":55575,"_2824":55576},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3337":2580,"_29196":2561,"_5":29537,"_20242":55578,"_26574":55579,"_2824":55580},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3337":2581,"_29196":2561,"_5":29537,"_20242":55582,"_26574":55583,"_2824":55584},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3337":2582,"_29196":2561,"_5":29537,"_20242":55586,"_26574":55587,"_2824":55588},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3337":2583,"_29196":2561,"_5":29537,"_20242":55590,"_26574":55591,"_2824":55592},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3337":2584,"_29196":2561,"_5":29537,"_20242":55594,"_26574":55595,"_2824":55596},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3337":2585,"_29196":2561,"_5":29537,"_20242":55598,"_26574":55599,"_2824":55600},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3337":2586,"_29196":2561,"_5":29537,"_20242":55602,"_26574":55603,"_2824":55604},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3337":2587,"_29196":2561,"_5":29537,"_20242":55606,"_26574":55607,"_2824":55608},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3337":2588,"_29196":2561,"_5":29537,"_20242":55610,"_26574":55611,"_2824":55612},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3337":2589,"_29196":2561,"_5":29537,"_20242":55614,"_26574":55615,"_2824":55616},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3337":2590,"_29196":2561,"_5":29537,"_20242":55618,"_26574":55619,"_2824":55620},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3337":2591,"_29196":2561,"_5":29537,"_20242":55622,"_26574":55623,"_2824":55624},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3337":2592,"_29196":2561,"_5":29537,"_20242":55626,"_26574":55627,"_2824":55628},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3337":2593,"_29196":2561,"_5":29537,"_20242":55630,"_26574":55631,"_2824":55632},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3337":2594,"_29196":2561,"_5":29537,"_20242":55634,"_26574":55635,"_2824":55636},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3337":2595,"_29196":2561,"_5":29537,"_20242":55638,"_26574":55639,"_2824":55640},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3337":2596,"_29196":2561,"_5":29537,"_20242":55642,"_26574":55643,"_2824":55644},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3337":2597,"_29196":2561,"_5":29537,"_20242":55646,"_26574":55647,"_2824":51555},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3337":2598,"_29196":2561,"_5":29537,"_20242":55649,"_26574":55650,"_2824":55651},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3337":2599,"_29196":2561,"_5":29537,"_20242":55653,"_26574":55654,"_2824":55655},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3337":2600,"_29196":2561,"_20242":55657,"_5":13829,"_26574":2561,"_2824":55658},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3337":2601,"_29196":2561,"_20242":55660,"_5":13829,"_26574":2561,"_2824":55661},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3337":2602,"_29196":2561,"_20242":55663,"_5":13829,"_26574":2561,"_2824":55664},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3337":2603,"_29196":2561,"_20242":55666,"_5":13829,"_26574":2561,"_2824":55667},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3337":2604,"_29196":2561,"_20242":55669,"_5":13829,"_26574":2561,"_2824":55670},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3337":2605,"_29196":2561,"_20242":55672,"_5":13829,"_26574":2561,"_2824":55673},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3337":2606,"_29196":2561,"_20242":55675,"_5":13829,"_26574":2561,"_2824":55676},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3337":2607,"_29196":2561,"_20242":55678,"_5":13829,"_26574":55515,"_2824":55679},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3337":2608,"_29196":2561,"_20242":55681,"_5":13829,"_26574":55515,"_2824":55682},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3337":2609,"_29196":2561,"_20242":55684,"_5":13829,"_26574":55519,"_2824":55685},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3337":2610,"_29196":2561,"_20242":55687,"_5":13829,"_26574":55519,"_2824":55688},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3337":2611,"_29196":2561,"_20242":55690,"_5":13829,"_26574":55523,"_2824":55691},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3337":2612,"_29196":2561,"_20242":55693,"_5":13829,"_26574":55527,"_2824":55694},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3337":2613,"_29196":2561,"_20242":55696,"_5":13829,"_26574":55527,"_2824":55697},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3337":2614,"_29196":2561,"_20242":55699,"_5":13829,"_26574":55527,"_2824":55700},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3337":2615,"_29196":2561,"_20242":55702,"_5":13829,"_26574":55527,"_2824":55703},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3337":2616,"_29196":2561,"_20242":55705,"_5":13829,"_26574":55527,"_2824":55706},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3337":2617,"_29196":2561,"_20242":55708,"_5":13829,"_26574":55531,"_2824":55709},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3337":2618,"_29196":2561,"_20242":55711,"_5":13829,"_26574":55531,"_2824":55712},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3337":2619,"_29196":2561,"_20242":55714,"_5":13829,"_26574":55531,"_2824":55715},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3337":2620,"_29196":2561,"_20242":55717,"_5":13829,"_26574":55531,"_2824":55718},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3337":2621,"_29196":2561,"_20242":55720,"_5":13829,"_26574":55531,"_2824":55721},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3337":2622,"_29196":2561,"_20242":55723,"_5":13829,"_26574":55531,"_2824":55724},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3337":2623,"_29196":2561,"_20242":55726,"_5":13829,"_26574":55535,"_2824":55727},[],"Change",{"_3337":2624,"_29196":2561,"_20242":55729,"_5":13829,"_26574":55535,"_2824":55730},[],"Who is affected",{"_3337":2625,"_29196":2561,"_20242":55732,"_5":13829,"_26574":55535,"_2824":55733},[],"Severity",{"_3337":2626,"_29196":2561,"_20242":55735,"_5":13829,"_26574":55535,"_2824":54325},[],{"_3337":2627,"_29196":2561,"_20242":55737,"_5":13829,"_26574":55535,"_2824":55544},[],{"_3337":2628,"_29196":2561,"_20242":55739,"_5":13829,"_26574":55535,"_2824":55740},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3337":2629,"_29196":2561,"_20242":55742,"_5":13829,"_26574":55535,"_2824":55743},[],"High: KMS and VA start on empty volumes",{"_3337":2630,"_29196":2561,"_20242":55745,"_5":13829,"_26574":55535,"_2824":55746},[],"Copy the data into the new volumes",{"_3337":2631,"_29196":2561,"_20242":55748,"_5":13829,"_26574":55535,"_2824":55548},[],{"_3337":2632,"_29196":2561,"_20242":55750,"_5":13829,"_26574":55535,"_2824":55751},[],"Every Helm release",{"_3337":2633,"_29196":2561,"_20242":55753,"_5":13829,"_26574":55535,"_2824":55754},[],"High: `helm upgrade` fails",{"_3337":2634,"_29196":2561,"_20242":55756,"_5":13829,"_26574":55535,"_2824":55757},[],"Remove or rename legacy keys",{"_3337":2635,"_29196":2561,"_20242":55759,"_5":13829,"_26574":55535,"_2824":55552},[],{"_3337":2636,"_29196":2561,"_20242":55761,"_5":13829,"_26574":55535,"_2824":55762},[],"Every deployment",{"_3337":2637,"_29196":2561,"_20242":55764,"_5":13829,"_26574":55535,"_2824":55765},[],"High: without a bootstrap principal there is no administrator",{"_3337":2638,"_29196":2561,"_20242":55767,"_5":13829,"_26574":55535,"_2824":55768},[],"Configure `services.authz`",{"_3337":2639,"_29196":2561,"_20242":55770,"_5":13829,"_26574":55535,"_2824":55556},[],{"_3337":2640,"_29196":2561,"_20242":55772,"_5":13829,"_26574":55535,"_2824":55751},[],{"_3337":2641,"_29196":2561,"_20242":55774,"_5":13829,"_26574":55535,"_2824":55775},[],"High: `helm upgrade` fails on the old keys",{"_3337":2642,"_29196":2561,"_20242":55777,"_5":13829,"_26574":55535,"_2824":55778},[],"Move JWKS and roles into `services.authz`",{"_3337":2643,"_29196":2561,"_20242":55780,"_5":13829,"_26574":55535,"_2824":55576},[],{"_3337":2644,"_29196":2561,"_20242":55782,"_5":13829,"_26574":55535,"_2824":55783},[],"3.8.0 deployments with per-service databases",{"_3337":2645,"_29196":2561,"_20242":55785,"_5":13829,"_26574":55535,"_2824":55786},[],"High: services find no data, or a migration aborts",{"_3337":2646,"_29196":2561,"_20242":55788,"_5":13829,"_26574":55535,"_2824":55789},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3337":2647,"_29196":2561,"_20242":55791,"_5":13829,"_26574":55535,"_2824":55580},[],{"_3337":2648,"_29196":2561,"_20242":55793,"_5":13829,"_26574":55535,"_2824":55794},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3337":2649,"_29196":2561,"_20242":55796,"_5":13829,"_26574":55535,"_2824":55797},[],"High: the backend no longer starts with them",{"_3337":2650,"_29196":2561,"_20242":55799,"_5":13829,"_26574":55535,"_2824":55800},[],"Move to PostgreSQL before upgrading",{"_3337":2651,"_29196":2561,"_20242":55802,"_5":13829,"_26574":55535,"_2824":55803},[],"Webhooks with file references",{"_3337":2652,"_29196":2561,"_20242":55805,"_5":13829,"_26574":55535,"_2824":55806},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3337":2653,"_29196":2561,"_20242":55808,"_5":13829,"_26574":55535,"_2824":55809},[],"High: enrollments calling the webhook fail",{"_3337":2654,"_29196":2561,"_20242":55811,"_5":13829,"_26574":55535,"_2824":55812},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3337":2655,"_29196":2561,"_20242":55814,"_5":13829,"_26574":55535,"_2824":55560},[],{"_3337":2656,"_29196":2561,"_20242":55816,"_5":13829,"_26574":55535,"_2824":55817},[],"Releases with per-service identity overrides or mounted key material",{"_3337":2657,"_29196":2561,"_20242":55819,"_5":13829,"_26574":55535,"_2824":55820},[],"Medium: services cannot read their files",{"_3337":2658,"_29196":2561,"_20242":55822,"_5":13829,"_26574":55535,"_2824":55823},[],"Remove the overrides and fix volume ownership",{"_3337":2659,"_29196":2561,"_20242":55825,"_5":13829,"_26574":55535,"_2824":55564},[],{"_3337":2660,"_29196":2561,"_20242":55827,"_5":13829,"_26574":55535,"_2824":55828},[],"Releases that set `amqp.tls`",{"_3337":2661,"_29196":2561,"_20242":55830,"_5":13829,"_26574":55535,"_2824":55831},[],"Medium: clients connect to the wrong port",{"_3337":2662,"_29196":2561,"_20242":55833,"_5":13829,"_26574":55535,"_2824":55834},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3337":2663,"_29196":2561,"_20242":55836,"_5":13829,"_26574":55535,"_2824":55584},[],{"_3337":2664,"_29196":2561,"_20242":55838,"_5":13829,"_26574":55535,"_2824":55839},[],"Installations whose CA keys predate the KMS",{"_3337":2665,"_29196":2561,"_20242":55841,"_5":13829,"_26574":55535,"_2824":55842},[],"Medium: CA keys stay unmanaged",{"_3337":2666,"_29196":2561,"_20242":55844,"_5":13829,"_26574":55535,"_2824":55845},[],"Run the CA-to-KMS migration",{"_3337":2667,"_29196":2561,"_20242":55847,"_5":13829,"_26574":55535,"_2824":55848},[],"Receiver certificate verification",{"_3337":2668,"_29196":2561,"_20242":55850,"_5":13829,"_26574":55535,"_2824":55851},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3337":2669,"_29196":2561,"_20242":55853,"_5":13829,"_26574":55535,"_2824":55854},[],"Medium: credentials go to an unverified receiver",{"_3337":2670,"_29196":2561,"_20242":55856,"_5":13829,"_26574":55535,"_2824":55857},[],"Set `insecure_skip_verify` to `false`",{"_3337":2671,"_29196":2561,"_20242":55859,"_5":13829,"_26574":55535,"_2824":55596},[],{"_3337":2672,"_29196":2561,"_20242":55861,"_5":13829,"_26574":55535,"_2824":55862},[],"Scripts and consoles that edit DMSs through the API",{"_3337":2673,"_29196":2561,"_20242":55864,"_5":13829,"_26574":55535,"_2824":55865},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3337":2674,"_29196":2561,"_20242":55867,"_5":13829,"_26574":55535,"_2824":55868},[],"Read the DMS before editing and use the new field",{"_3337":2675,"_29196":2561,"_20242":55870,"_5":13829,"_26574":55535,"_2824":55612},[],{"_3337":2676,"_29196":2561,"_20242":55872,"_5":13829,"_26574":55535,"_2824":55873},[],"Consumers that read the device `events` field",{"_3337":2677,"_29196":2561,"_20242":55875,"_5":13829,"_26574":55535,"_2824":55876},[],"Medium: the field disappears",{"_3337":2678,"_29196":2561,"_20242":55878,"_5":13829,"_26574":55535,"_2824":55879},[],"Use the new event endpoints",{"_3337":2679,"_29196":2561,"_20242":55881,"_5":13829,"_26574":55535,"_2824":55616},[],{"_3337":2680,"_29196":2561,"_20242":55883,"_5":13829,"_26574":55535,"_2824":55884},[],"Deployments with VA roles whose signer is not in the CA inventory",{"_3337":2681,"_29196":2561,"_20242":55886,"_5":13829,"_26574":55535,"_2824":55887},[],"Medium: the VA migration aborts",{"_3337":2682,"_29196":2561,"_20242":55889,"_5":13829,"_26574":55535,"_2824":55890},[],"Fix the affected roles before upgrading",{"_3337":2683,"_29196":2561,"_20242":55892,"_5":13829,"_26574":55535,"_2824":55568},[],{"_3337":2684,"_29196":2561,"_20242":55894,"_5":13829,"_26574":55535,"_2824":55895},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3337":2685,"_29196":2561,"_20242":55897,"_5":13829,"_26574":55535,"_2824":55898},[],"Low to medium: validation errors or changed defaults",{"_3337":2686,"_29196":2561,"_20242":55900,"_5":13829,"_26574":55535,"_2824":55901},[],"Update the values file",{"_3337":2687,"_29196":2561,"_20242":55903,"_5":13829,"_26574":55535,"_2824":55604},[],{"_3337":2688,"_29196":2561,"_20242":55905,"_5":13829,"_26574":55535,"_2824":55906},[],"Clients that send the DMS ID in the update body",{"_3337":2689,"_29196":2561,"_20242":55908,"_5":13829,"_26574":55535,"_2824":55909},[],"Low: the ID in the URL wins",{"_3337":2690,"_29196":2561,"_20242":55911,"_5":13829,"_26574":55535,"_2824":55912},[],"Send the ID in the URL",{"_3337":2691,"_29196":2561,"_20242":55914,"_5":13829,"_26574":55535,"_2824":55608},[],{"_3337":2692,"_29196":2561,"_20242":55916,"_5":13829,"_26574":55535,"_2824":55917},[],"Consumers that match on certificate `type`",{"_3337":2693,"_29196":2561,"_20242":55919,"_5":13829,"_26574":55535,"_2824":55920},[],"Low: two values are renamed",{"_3337":2694,"_29196":2561,"_20242":55922,"_5":13829,"_26574":55535,"_2824":55923},[],"Adapt consumers",{"_3337":2695,"_29196":2561,"_20242":55925,"_5":13829,"_26574":55535,"_2824":55600},[],{"_3337":2696,"_29196":2561,"_20242":55927,"_5":13829,"_26574":55535,"_2824":55928},[],"Any DMS",{"_3337":2697,"_29196":2561,"_20242":55930,"_5":13829,"_26574":55535,"_2824":55931},[],"Low: informational",{"_3337":2698,"_29196":2561,"_20242":55933,"_5":13829,"_26574":55535,"_2824":55934},[],"Read both blocks before editing",{"_3337":2699,"_29196":2561,"_20242":55936,"_5":13829,"_26574":55543,"_2824":55937},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3337":2700,"_29196":2561,"_20242":55939,"_5":13829,"_26574":55543,"_2824":55940},[],"Step 4 of the migration guide copies the data.",{"_3337":2701,"_29196":2561,"_20242":55942,"_5":13829,"_26574":55547,"_2824":55943},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3337":2702,"_29196":2561,"_20242":55945,"_5":13829,"_26574":55551,"_2824":55946},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3337":2703,"_29196":2561,"_20242":55948,"_5":13829,"_26574":55555,"_2824":55949},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3337":2704,"_29196":2561,"_20242":55951,"_5":13829,"_26574":55559,"_2824":55952},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3337":2705,"_29196":2561,"_20242":55954,"_5":13829,"_26574":55559,"_2824":55955},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3337":2706,"_29196":2561,"_20242":55957,"_5":13829,"_26574":55563,"_2824":55958},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3337":2707,"_29196":2561,"_20242":55960,"_5":13829,"_26574":55567,"_2824":55961},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3337":2708,"_29196":2561,"_20242":55963,"_5":13829,"_26574":55567,"_2824":55964},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3337":2709,"_29196":2561,"_20242":55966,"_5":13829,"_26574":55567,"_2824":55967},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3337":2710,"_29196":2561,"_20242":55969,"_5":13829,"_26574":55567,"_2824":55970},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3337":2711,"_29196":2561,"_20242":55972,"_5":13829,"_26574":55567,"_2824":55973},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3337":2712,"_29196":2561,"_20242":55975,"_5":13829,"_26574":55567,"_2824":55976},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3337":2713,"_29196":2561,"_20242":55978,"_5":13829,"_26574":55575,"_2824":55979},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3337":2714,"_29196":2561,"_20242":55981,"_5":13829,"_26574":55575,"_2824":55982},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3337":2715,"_29196":2561,"_20242":55984,"_5":13829,"_26574":55575,"_2824":55985},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3337":2716,"_29196":2561,"_20242":55987,"_5":13829,"_26574":55575,"_2824":55988},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3337":2717,"_29196":2561,"_20242":55990,"_5":13829,"_26574":55575,"_2824":55991},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3337":2718,"_29196":2561,"_20242":55993,"_5":13829,"_26574":55579,"_2824":55994},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3337":2719,"_29196":2561,"_20242":55996,"_5":13829,"_26574":55583,"_2824":55997},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3337":2720,"_29196":2561,"_20242":55999,"_5":13829,"_26574":55583,"_2824":56000},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3337":2721,"_29196":2561,"_20242":56002,"_5":13829,"_26574":55583,"_2824":56003},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3337":2722,"_29196":2561,"_20242":56005,"_5":13829,"_26574":55583,"_2824":56006},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3337":2723,"_29196":2561,"_20242":56008,"_5":13829,"_26574":55583,"_2824":56009},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3337":2724,"_29196":2561,"_20242":56011,"_5":13829,"_26574":55583,"_2824":56012},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`); release or delete the dependent certificates first.",{"_3337":2725,"_29196":2561,"_20242":56014,"_5":13829,"_26574":55583,"_2824":56015},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3337":2726,"_29196":2561,"_20242":56017,"_5":13829,"_26574":55583,"_2824":56018},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3337":2727,"_29196":2561,"_20242":56020,"_5":13829,"_26574":55591,"_2824":56021},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3337":2728,"_29196":2561,"_20242":56023,"_5":13829,"_26574":55591,"_2824":56024},[],"Field in 3.8.0",{"_3337":2729,"_29196":2561,"_20242":56026,"_5":13829,"_26574":55591,"_2824":56027},[],"Field in 4.0.0",{"_3337":2730,"_29196":2561,"_20242":56029,"_5":13829,"_26574":55591,"_2824":56030},[],"`validate_server_cert`",{"_3337":2731,"_29196":2561,"_20242":56032,"_5":13829,"_26574":55591,"_2824":56033},[],"`insecure_skip_verify` (value negated)",{"_3337":2732,"_29196":2561,"_20242":56035,"_5":13829,"_26574":55591,"_2824":56036},[],"`oidc`",{"_3337":2733,"_29196":2561,"_20242":56038,"_5":13829,"_26574":55591,"_2824":56039},[],"`jwt_options`",{"_3337":2734,"_29196":2561,"_20242":56041,"_5":13829,"_26574":55591,"_2824":56042},[],"`apikey`",{"_3337":2735,"_29196":2561,"_20242":56044,"_5":13829,"_26574":55591,"_2824":56045},[],"`apikey_options`",{"_3337":2736,"_29196":2561,"_20242":56047,"_5":13829,"_26574":55591,"_2824":56048},[],"`mtls`",{"_3337":2737,"_29196":2561,"_20242":56050,"_5":13829,"_26574":55591,"_2824":56051},[],"`mtls_options`",{"_3337":2738,"_29196":2561,"_20242":56053,"_5":13829,"_26574":55591,"_2824":56054},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3337":2739,"_29196":2561,"_20242":56056,"_5":13829,"_26574":55591,"_2824":56057},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3337":2740,"_29196":2561,"_20242":56059,"_5":13829,"_26574":55591,"_2824":56060},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3337":2741,"_29196":2561,"_20242":56062,"_5":13829,"_26574":55595,"_2824":56063},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3337":2742,"_29196":2561,"_20242":56065,"_5":13829,"_26574":55595,"_2824":56066},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3337":2743,"_29196":2561,"_20242":56068,"_5":13829,"_26574":55595,"_2824":56069},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3337":2744,"_29196":2561,"_20242":56071,"_5":13829,"_26574":55599,"_2824":56072},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3337":2745,"_29196":2561,"_20242":56074,"_5":13829,"_26574":55603,"_2824":56075},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3337":2746,"_29196":2561,"_20242":56077,"_5":13829,"_26574":55607,"_2824":56078},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3337":2747,"_29196":2561,"_20242":56080,"_5":13829,"_26574":55611,"_2824":56081},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3337":2748,"_29196":2561,"_20242":56083,"_5":13829,"_26574":55611,"_2824":56084},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3337":2749,"_29196":2561,"_20242":56086,"_5":13829,"_26574":55611,"_2824":56087},[],"`POST /v1/devices/:id/events` creates an event.",{"_3337":2750,"_29196":2561,"_20242":56089,"_5":13829,"_26574":55611,"_2824":56090},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3337":2751,"_29196":2561,"_20242":56092,"_5":13829,"_26574":55615,"_2824":56093},[],"The `crl_options.subject_key_id_signer` field of VA roles is replaced by `signer_certificate_serial_number`; update clients that send the old field (CRL documents the new field). The VA migration resolves each role's signer automatically: when several CAs share the signer's key, it uses the oldest one and logs a warning, but it aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` when no certificate with that SKI exists. Fix such roles before upgrading.",{"_3337":2752,"_29196":2561,"_20242":56095,"_5":13829,"_26574":55615,"_2824":56096},[],"If you wrote custom `authz` policies that filter VA roles on the old `crl_subject_key_id_signer` column, rewrite them against the new `crl_signer_certificate_serial_number` column.",{"_3337":2753,"_29196":2561,"_20242":56098,"_5":13829,"_26574":55619,"_2824":56099},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3337":2754,"_29196":2561,"_20242":56101,"_5":13829,"_26574":55623,"_2824":56102},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3337":2755,"_29196":2561,"_20242":56104,"_5":13829,"_26574":55623,"_2824":56105},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3337":2756,"_29196":2561,"_20242":56107,"_5":13829,"_26574":55623,"_2824":56108},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3337":2757,"_29196":2561,"_20242":56110,"_5":13829,"_26574":55623,"_2824":56111},[],"Record the names of your local-storage PVCs:",{"_3337":2758,"_29196":2561,"_20242":56113,"_5":13829,"_26574":55623,"_2824":56114},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3337":2759,"_29196":2561,"_20242":56116,"_5":13829,"_26574":55627,"_2824":56117},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3337":2760,"_29196":2561,"_20242":56119,"_5":13829,"_26574":55627,"_2824":56120},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3337":2761,"_29196":2561,"_20242":56122,"_5":13829,"_26574":55627,"_2824":56123},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3337":2762,"_29196":2561,"_20242":56125,"_5":13829,"_26574":55627,"_2824":56126},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3337":2763,"_29196":2561,"_20242":56128,"_5":13829,"_26574":55627,"_2824":56129},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3337":2764,"_29196":2561,"_20242":56131,"_5":13829,"_26574":55627,"_2824":56132},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3337":2765,"_29196":2561,"_20242":56134,"_5":13829,"_26574":55627,"_2824":56135},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3337":2766,"_29196":2561,"_20242":56137,"_5":13829,"_26574":55627,"_2824":56138},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3337":2767,"_29196":2561,"_20242":56140,"_5":13829,"_26574":55627,"_2824":56141},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3337":2768,"_29196":2561,"_20242":56143,"_5":13829,"_26574":55627,"_2824":56144},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3337":2769,"_29196":2561,"_20242":56146,"_5":13829,"_26574":55627,"_2824":56147},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3337":2770,"_29196":2561,"_20242":56149,"_5":13829,"_26574":55627,"_2824":56150},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3337":2771,"_29196":2561,"_20242":56152,"_5":13829,"_26574":55631,"_2824":56153},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3337":2772,"_29196":2561,"_20242":56155,"_5":13829,"_26574":55631,"_2824":56156},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3337":2773,"_29196":2561,"_20242":56158,"_5":13829,"_26574":55635,"_2824":56159},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3337":2774,"_29196":2561,"_20242":56161,"_5":13829,"_26574":55635,"_2824":56162},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3337":2775,"_29196":2561,"_20242":56164,"_5":13829,"_26574":55635,"_2824":56165},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3337":2776,"_29196":2561,"_20242":56167,"_5":13829,"_26574":55635,"_2824":56168},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3337":2777,"_29196":2561,"_20242":56170,"_5":13829,"_26574":55635,"_2824":56171},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3337":2778,"_29196":2561,"_20242":56173,"_5":13829,"_26574":55635,"_2824":56174},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3337":2779,"_29196":2561,"_20242":56176,"_5":13829,"_26574":55635,"_2824":56177},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3337":2780,"_29196":2561,"_20242":56179,"_5":13829,"_26574":55635,"_2824":56180},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3337":2781,"_29196":2561,"_20242":56182,"_5":13829,"_26574":55635,"_2824":56183},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3337":2782,"_29196":2561,"_20242":56185,"_5":13829,"_26574":55635,"_2824":56186},[],"**Remove the helper and restore the recorded replica counts:**",{"_3337":2783,"_29196":2561,"_20242":56188,"_5":13829,"_26574":55635,"_2824":56189},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3337":2784,"_29196":2561,"_20242":56191,"_5":13829,"_26574":55639,"_2824":56192},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3337":2785,"_29196":2561,"_20242":56194,"_5":13829,"_26574":55639,"_2824":56195},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3337":2786,"_29196":2561,"_20242":56197,"_5":13829,"_26574":55643,"_2824":56198},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3337":2787,"_29196":2561,"_20242":56200,"_5":13829,"_26574":55643,"_2824":56201},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3337":2788,"_29196":2561,"_20242":56203,"_5":13829,"_26574":55643,"_2824":56204},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3337":2789,"_29196":2561,"_20242":56206,"_5":13829,"_26574":55643,"_2824":56207},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3337":2790,"_29196":2561,"_20242":56209,"_5":13829,"_26574":55643,"_2824":56210},[],"The `goose-lamassu` and `ca-to-kms-migration` READMEs in the `lamassuiot` repository document the 4.0.0 `pki` layout: migration order, cross-schema privileges and the tools' options. Follow the `dbname=pki` form shown above, and consult the READMEs before applying the migrations.",{"_3337":2791,"_29196":2561,"_20242":56212,"_5":13829,"_26574":55643,"_2824":56213},[],"Apply the schema migrations in the order `kms` → `ca` → `va`; `devicemanager`, `dmsmanager` and `alerts` are independent and can run at any point. The `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema` while `kms` is not migrated yet, and `va` needs `ca` migrated. The `ca` and `va` migrations also read tables that belong to another schema, so the PostgreSQL role that runs them needs privileges on it: `USAGE` on the `kms` schema plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys` for the `ca` migration, and `USAGE` on the `ca` schema plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates` for the `va` migration. Without them the migration aborts; grant the missing privileges and run the failed schema again.",{"_3337":2792,"_29196":2561,"_20242":56215,"_5":13829,"_26574":55643,"_2824":56216},[],"After migrating `ca`, if the CA service runs as a different user than the migration user, grant that user `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`); the CA service reads certificates and CAs through that view, and without the grant every certificate and CA read fails with `permission denied for table certificates_view`.",{"_3337":2793,"_29196":2561,"_20242":56218,"_5":13829,"_26574":55647,"_2824":56219},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3337":2794,"_29196":2561,"_20242":56221,"_5":13829,"_26574":55647,"_2824":56222},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3337":2795,"_29196":2561,"_20242":56224,"_5":13829,"_26574":55647,"_2824":56225},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3337":2796,"_29196":2561,"_20242":56227,"_5":13829,"_26574":55647,"_2824":56228},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3337":2797,"_29196":2561,"_20242":56230,"_5":13829,"_26574":55647,"_2824":56231},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3337":2798,"_29196":2561,"_20242":56233,"_5":13829,"_26574":55647,"_2824":56234},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3337":2799,"_29196":2561,"_20242":56236,"_5":13829,"_26574":55647,"_2824":56237},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3337":2800,"_29196":2561,"_20242":56239,"_5":13829,"_26574":55650,"_2824":56240},[],"After the upgrade, check in this order:",{"_3337":2801,"_29196":2561,"_20242":56242,"_5":13829,"_26574":55650,"_2824":56243},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations.",{"_3337":2802,"_29196":2561,"_20242":56245,"_5":13829,"_26574":55650,"_2824":56246},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3337":2803,"_29196":2561,"_20242":56248,"_5":13829,"_26574":55650,"_2824":56249},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3337":2804,"_29196":2561,"_20242":56251,"_5":13829,"_26574":55650,"_2824":56252},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3337":2805,"_29196":2561,"_20242":56254,"_5":13829,"_26574":55650,"_2824":56255},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3337":2806,"_29196":2561,"_20242":56257,"_5":13829,"_26574":55650,"_2824":56258},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3337":2807,"_29196":2561,"_20242":56260,"_5":13829,"_26574":55650,"_2824":56261},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3337":2808,"_29196":2561,"_20242":56263,"_5":13829,"_26574":55650,"_2824":56264},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3337":2809,"_29196":2561,"_20242":56266,"_5":13829,"_26574":55650,"_2824":56267},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3337":2810,"_29196":2561,"_20242":56269,"_5":13829,"_26574":55650,"_2824":56270},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3337":2811,"_29196":2561,"_20242":56272,"_5":13829,"_26574":55650,"_2824":56273},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3337":2812,"_29196":2561,"_20242":56275,"_5":13829,"_26574":55650,"_2824":56276},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3337":2813,"_29196":2561,"_20242":56278,"_5":13829,"_26574":55650,"_2824":56279},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3337":2814,"_29196":2561,"_20242":56281,"_5":13829,"_26574":55650,"_2824":56282},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3337":2815,"_29196":2561,"_20242":56284,"_5":13829,"_26574":55654,"_2824":56285},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3337":2816,"_29196":2561,"_20242":56287,"_5":13829,"_26574":55654,"_2824":56288},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3337":2817,"_29196":2561,"_20242":56290,"_5":13829,"_26574":55654,"_2824":56291},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3337":2818,"_29196":2561,"_20242":56293,"_5":13829,"_26574":55654,"_2824":56294},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3337":2819,"_29196":2561,"_20242":56296,"_5":13829,"_26574":55654,"_2824":56297},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_56300":56301,"_56302":56303,"_56304":56305,"_56306":56307,"_17510":2846,"_67541":2846},"language","english","sortableProperties",[2824,29196,5,26574],"sortablePropertiesWithTypes",{"_2824":24190,"_29196":24190,"_5":24190,"_26574":24190},"sorts",{"_2824":56308,"_29196":59117,"_5":61925,"_26574":64733},{"_4481":56309,"_56310":56311,"_5":24190},{"_13905":3119,"_14281":10885,"_14300":6647,"_28235":3175,"_14287":3311,"_19213":14458,"_13926":15406,"_13933":3204,"_28177":2900,"_28586":7334,"_28607":4034,"_28211":3033,"_33440":4545,"_28314":13803,"_28651":4820,"_33447":14378,"_33450":3154,"_33453":4147,"_33456":7157,"_29028":23608,"_33461":3887,"_33463":7256,"_29058":5727,"_14296":11995,"_33467":3302,"_33470":3632,"_33472":4613,"_28635":19306,"_29023":10884,"_29071":7363,"_33477":5364,"_33479":4293,"_33481":4461,"_28331":2923,"_33484":10634,"_33486":4998,"_33488":3139,"_33490":3528,"_33492":5756,"_28248":20768,"_33495":6420,"_33497":5308,"_28242":3215,"_28672":6890,"_33501":5585,"_33503":7149,"_33506":2934,"_28288":19487,"_33510":2935,"_28168":4440,"_33513":5298,"_28216":4676,"_33516":7315,"_33518":22860,"_33521":5755,"_14290":7234,"_29255":6310,"_33525":3700,"_33528":7301,"_33530":7259,"_33532":5365,"_33534":6762,"_33536":7330,"_19216":7097,"_33539":5825,"_33541":4061,"_28189":3930,"_28629":10637,"_33545":4385,"_33547":5796,"_33549":12126,"_29088":24599,"_33552":8546,"_33554":6892,"_33556":9555,"_29192":4811,"_28688":14160,"_33560":7243,"_33562":3120,"_28226":5965,"_33565":9175,"_33567":3235,"_33569":24197,"_29104":22610,"_28308":4012,"_27642":3017,"_33574":3265,"_33576":9793,"_33578":20372,"_28357":6970,"_33582":21020,"_28623":11185,"_33586":10106,"_33588":4170,"_33590":5602,"_33592":23112,"_33594":4451,"_33596":3087,"_28346":5713,"_28591":8314,"_33600":5598,"_33602":3942,"_33604":14676,"_33607":3272,"_33609":6640,"_33611":4777,"_33613":3006,"_33615":3086,"_33617":5700,"_33619":9850,"_33622":3860,"_33624":4950,"_33626":6969,"_33628":7324,"_33630":7250,"_33633":6217,"_33635":3635,"_33638":7349,"_33641":11772,"_33643":19489,"_33645":4384,"_33647":3869,"_33649":3833,"_33651":47518,"_33653":6695,"_33655":4772,"_33657":4443,"_28634":6337,"_33660":5578,"_33662":6741,"_33664":17376,"_33666":7202,"_33668":16709,"_33670":10598,"_33672":4773,"_33674":9472,"_33676":6328,"_33678":7203,"_33680":3203,"_33682":3381,"_33684":3831,"_3