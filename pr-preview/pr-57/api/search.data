"_38859":120181,"_38861":120183,"_38863":120185,"_38865":120187,"_38867":120189,"_38869":120191,"_38871":120194,"_38873":120197,"_38876":120200,"_38878":120203,"_38880":120206,"_38882":120209,"_38884":120212,"_38886":120215,"_38888":120218,"_38890":120221,"_38892":120224,"_38894":120227,"_38896":120230,"_38898":120233,"_38900":120236,"_38902":120239,"_38904":120242,"_38906":120245,"_38908":120248,"_38910":120251,"_38912":120254,"_38914":120257,"_38916":120260,"_38918":120263,"_38920":120266,"_38922":120269,"_38924":120272,"_38926":120275,"_38928":120278,"_38930":120281,"_38932":120284,"_38934":120287,"_38936":120290,"_38938":120293,"_38940":120296,"_38943":120299,"_38945":120302,"_38947":120305,"_38950":120308,"_38952":120311,"_38954":120314,"_38956":120317,"_38958":120320,"_38960":120323,"_38962":120326,"_38964":120329,"_38966":120332,"_38968":120335,"_38970":120338,"_38972":120341,"_38974":120344,"_38976":120347,"_38978":120350,"_38980":120353,"_38982":120356,"_38984":120359,"_38986":120362,"_38988":120365,"_38990":120368,"_38992":120371,"_38994":120374,"_38996":120377,"_38998":120380,"_39000":120383,"_39002":120386,"_39004":120389,"_39006":120392,"_39008":120395,"_39010":120398,"_39012":120401,"_39014":120404,"_39016":120407,"_39018":120410,"_39020":120413,"_39022":120416,"_39024":120419,"_39026":120422,"_39028":120425,"_39031":120428,"_39033":120431,"_39035":120434},{"_3337":67548,"_29196":67548,"_5":14181,"_2824":111870,"_29540":111871,"_20242":111874,"_26574":67548},"Despliega desde AWS Marketplace",[47528,111872,111873],"Despliegue","Otros modelos",[],{"_3337":67549,"_29196":67548,"_20242":111876,"_5":13829,"_26574":67548,"_2824":111877},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3337":67550,"_29196":67548,"_5":29537,"_20242":111879,"_26574":111880,"_2824":111881},[],"/docs/pr-preview/pr-57/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3337":67551,"_29196":67548,"_5":29537,"_20242":111883,"_26574":111884,"_2824":111885},[],"/docs/pr-preview/pr-57/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3337":67552,"_29196":67548,"_5":29537,"_20242":111887,"_26574":111888,"_2824":111889},[],"/docs/pr-preview/pr-57/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3337":67553,"_29196":67548,"_5":29537,"_20242":111891,"_26574":111892,"_2824":111893},[],"/docs/pr-preview/pr-57/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3337":67554,"_29196":67548,"_5":29537,"_20242":111895,"_26574":111896,"_2824":111897},[],"/docs/pr-preview/pr-57/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3337":67555,"_29196":67548,"_5":29537,"_20242":111899,"_26574":111900,"_2824":111901},[],"/docs/pr-preview/pr-57/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3337":67556,"_29196":67548,"_5":29537,"_20242":111903,"_26574":111904,"_2824":111905},[],"/docs/pr-preview/pr-57/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3337":67557,"_29196":67548,"_20242":111907,"_5":13829,"_26574":67548,"_2824":111908},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3337":67558,"_29196":67548,"_20242":111910,"_5":13829,"_26574":111880,"_2824":111911},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3337":67559,"_29196":67548,"_20242":111913,"_5":13829,"_26574":111880,"_2824":111914},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3337":67560,"_29196":67548,"_20242":111916,"_5":13829,"_26574":111880,"_2824":111917},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3337":67561,"_29196":67548,"_20242":111919,"_5":13829,"_26574":111884,"_2824":111920},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3337":67562,"_29196":67548,"_20242":111922,"_5":13829,"_26574":111884,"_2824":111923},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3337":67563,"_29196":67548,"_20242":111925,"_5":13829,"_26574":111884,"_2824":111926},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3337":67564,"_29196":67548,"_20242":111928,"_5":13829,"_26574":111888,"_2824":111929},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3337":67565,"_29196":67548,"_20242":111931,"_5":13829,"_26574":111892,"_2824":111932},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3337":67566,"_29196":67548,"_20242":111934,"_5":13829,"_26574":111896,"_2824":111935},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3337":67567,"_29196":67548,"_20242":111937,"_5":13829,"_26574":111900,"_2824":111938},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3337":67568,"_29196":67548,"_20242":111940,"_5":13829,"_26574":111904,"_2824":111941},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3337":67569,"_29196":67569,"_5":14181,"_2824":111943,"_29540":111944,"_20242":111945,"_26574":67569},"Despliega Lamassu",[47528,111872],[],{"_3337":67570,"_29196":67569,"_20242":111947,"_5":13829,"_26574":67569,"_2824":111948},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3337":67571,"_29196":67569,"_5":29537,"_20242":111950,"_26574":111951,"_2824":111952},[],"/docs/pr-preview/pr-57/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3337":67572,"_29196":67569,"_5":29537,"_20242":111954,"_26574":111955,"_2824":111956},[],"/docs/pr-preview/pr-57/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3337":67573,"_29196":67569,"_5":29537,"_20242":111958,"_26574":111959,"_2824":111960},[],"/docs/pr-preview/pr-57/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3337":67574,"_29196":67569,"_20242":111962,"_5":13829,"_26574":67569,"_2824":111963},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3337":67575,"_29196":67569,"_20242":111965,"_5":13829,"_26574":111951,"_2824":111966},[],"Modelo",{"_3337":67576,"_29196":67569,"_20242":111968,"_5":13829,"_26574":111951,"_2824":111969},[],"Recomendado para",{"_3337":67577,"_29196":67569,"_20242":111971,"_5":13829,"_26574":111951,"_2824":111972},[],"Quién opera la infraestructura",{"_3337":67578,"_29196":67569,"_20242":111974,"_5":13829,"_26574":111951,"_2824":111975},[],"Punto de partida",{"_3337":67579,"_29196":67569,"_20242":111977,"_5":13829,"_26574":111951,"_2824":47635},[],{"_3337":67580,"_29196":67569,"_20242":111979,"_5":13829,"_26574":111951,"_2824":111980},[],"Producción, entornos regulados y despliegues personalizados",{"_3337":67581,"_29196":67569,"_20242":111982,"_5":13829,"_26574":111951,"_2824":111983},[],"Tu equipo",{"_3337":67582,"_29196":67569,"_20242":111985,"_5":13829,"_26574":111951,"_2824":111986},[],"Helm o Fastlane",{"_3337":67583,"_29196":67569,"_20242":111988,"_5":13829,"_26574":111951,"_2824":47647},[],{"_3337":67584,"_29196":67569,"_20242":111990,"_5":13829,"_26574":111951,"_2824":111991},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3337":67585,"_29196":67569,"_20242":111993,"_5":13829,"_26574":111951,"_2824":111983},[],{"_3337":67586,"_29196":67569,"_20242":111995,"_5":13829,"_26574":111951,"_2824":111996},[],"Imagen preconfigurada en EC2",{"_3337":67587,"_29196":67569,"_20242":111998,"_5":13829,"_26574":111951,"_2824":47658},[],{"_3337":67588,"_29196":67569,"_20242":112000,"_5":13829,"_26574":111951,"_2824":112001},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3337":67589,"_29196":67569,"_20242":112003,"_5":13829,"_26574":111951,"_2824":47664},[],{"_3337":67590,"_29196":67569,"_20242":112005,"_5":13829,"_26574":111951,"_2824":112006},[],"Suscripción gestionada",{"_3337":67591,"_29196":67569,"_20242":112008,"_5":13829,"_26574":111951,"_2824":112009},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3337":67592,"_29196":67569,"_20242":112011,"_5":13829,"_26574":111951,"_2824":112012},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3337":67593,"_29196":67569,"_20242":112014,"_5":13829,"_26574":111951,"_2824":112015},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3337":67594,"_29196":67569,"_20242":112017,"_5":13829,"_26574":111955,"_2824":112018},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3337":67595,"_29196":67569,"_20242":112020,"_5":13829,"_26574":111959,"_2824":112021},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3337":67596,"_29196":67596,"_5":14181,"_2824":112023,"_29540":112024,"_20242":112025,"_26574":67596},"Utiliza Lamassu como SaaS",[47528,111872,111873],[],{"_3337":67597,"_29196":67596,"_20242":112027,"_5":13829,"_26574":67596,"_2824":112028},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3337":67598,"_29196":67596,"_5":29537,"_20242":112030,"_26574":112031,"_2824":112032},[],"/docs/pr-preview/pr-57/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3337":67599,"_29196":67596,"_5":29537,"_20242":112034,"_26574":112035,"_2824":112036},[],"/docs/pr-preview/pr-57/es/deployment/saas#planes","Planes",{"_3337":67600,"_29196":67596,"_5":29537,"_20242":112038,"_26574":112039,"_2824":112040},[],"/docs/pr-preview/pr-57/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3337":67601,"_29196":67596,"_20242":112042,"_5":13829,"_26574":67596,"_2824":112043},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3337":67602,"_29196":67596,"_20242":112045,"_5":13829,"_26574":112031,"_2824":112046},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3337":67603,"_29196":67596,"_20242":112048,"_5":13829,"_26574":112031,"_2824":112049},[],"Copias de seguridad automáticas.",{"_3337":67604,"_29196":67596,"_20242":112051,"_5":13829,"_26574":112031,"_2824":112052},[],"Actualizaciones de versión.",{"_3337":67605,"_29196":67596,"_20242":112054,"_5":13829,"_26574":112031,"_2824":112055},[],"Soporte técnico y SLA según el plan contratado.",{"_3337":67606,"_29196":67596,"_20242":112057,"_5":13829,"_26574":112035,"_2824":47719},[],{"_3337":67607,"_29196":67596,"_20242":112059,"_5":13829,"_26574":112035,"_2824":112060},[],"Dispositivos",{"_3337":67608,"_29196":67596,"_20242":112062,"_5":13829,"_26574":112035,"_2824":112063},[],"Soporte",{"_3337":67609,"_29196":67596,"_20242":112065,"_5":13829,"_26574":112035,"_2824":47728},[],{"_3337":67610,"_29196":67596,"_20242":112067,"_5":13829,"_26574":112035,"_2824":47731},[],{"_3337":67611,"_29196":67596,"_20242":112069,"_5":13829,"_26574":112035,"_2824":112070},[],"Hasta 1.000",{"_3337":67612,"_29196":67596,"_20242":112072,"_5":13829,"_26574":112035,"_2824":47737},[],{"_3337":67613,"_29196":67596,"_20242":112074,"_5":13829,"_26574":112035,"_2824":112075},[],"99,5 %",{"_3337":67614,"_29196":67596,"_20242":112077,"_5":13829,"_26574":112035,"_2824":47743},[],{"_3337":67615,"_29196":67596,"_20242":112079,"_5":13829,"_26574":112035,"_2824":112080},[],"Hasta 10.000",{"_3337":67616,"_29196":67596,"_20242":112082,"_5":13829,"_26574":112035,"_2824":112083},[],"Email y chat",{"_3337":67617,"_29196":67596,"_20242":112085,"_5":13829,"_26574":112035,"_2824":112086},[],"99,9 %",{"_3337":67618,"_29196":67596,"_20242":112088,"_5":13829,"_26574":112035,"_2824":47755},[],{"_3337":67619,"_29196":67596,"_20242":112090,"_5":13829,"_26574":112035,"_2824":112091},[],"Ilimitados",{"_3337":67620,"_29196":67596,"_20242":112093,"_5":13829,"_26574":112035,"_2824":112094},[],"Dedicado",{"_3337":67621,"_29196":67596,"_20242":112096,"_5":13829,"_26574":112035,"_2824":112097},[],"99,99 %",{"_3337":67622,"_29196":67596,"_20242":112099,"_5":13829,"_26574":112039,"_2824":112100},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3337":67623,"_29196":67596,"_20242":112102,"_5":13829,"_26574":112039,"_2824":112103},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3337":67624,"_29196":67624,"_5":14181,"_2824":47772,"_29540":112105,"_20242":112107,"_26574":67624},[47528,111872,112106],"Kubernetes autogestionado",[],{"_3337":67625,"_29196":67624,"_20242":112109,"_5":13829,"_26574":67624,"_2824":112110},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3337":67626,"_29196":67624,"_5":29537,"_20242":112112,"_26574":112113,"_2824":112114},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3337":67627,"_29196":67624,"_5":29537,"_20242":112116,"_26574":112117,"_2824":112118},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3337":67628,"_29196":67624,"_5":29537,"_20242":112120,"_26574":112121,"_2824":112122},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3337":67629,"_29196":67624,"_5":29537,"_20242":112124,"_26574":112125,"_2824":112126},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3337":67630,"_29196":67624,"_5":29537,"_20242":112128,"_26574":112129,"_2824":112130},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3337":67631,"_29196":67624,"_5":29537,"_20242":112132,"_26574":112133,"_2824":112134},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3337":67632,"_29196":67624,"_5":29537,"_20242":112136,"_26574":112137,"_2824":112138},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3337":67633,"_29196":67624,"_5":29537,"_20242":112140,"_26574":112141,"_2824":112142},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3337":67634,"_29196":67624,"_5":29537,"_20242":112144,"_26574":112145,"_2824":112146},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3337":67635,"_29196":67624,"_5":29537,"_20242":112148,"_26574":112149,"_2824":112150},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3337":67636,"_29196":67624,"_5":29537,"_20242":112152,"_26574":112153,"_2824":112154},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3337":67637,"_29196":67624,"_20242":112156,"_5":13829,"_26574":112113,"_2824":112157},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3337":67638,"_29196":67624,"_20242":112159,"_5":13829,"_26574":112113,"_2824":112160},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3337":67639,"_29196":67624,"_20242":112162,"_5":13829,"_26574":112117,"_2824":112163},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3337":67640,"_29196":67624,"_20242":112165,"_5":13829,"_26574":112117,"_2824":112166},[],"Fastlane instala o configura",{"_3337":67641,"_29196":67624,"_20242":112168,"_5":13829,"_26574":112117,"_2824":112169},[],"Tú sigues proporcionando",{"_3337":67642,"_29196":67624,"_20242":112171,"_5":13829,"_26574":112117,"_2824":112172},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3337":67643,"_29196":67624,"_20242":112174,"_5":13829,"_26574":112117,"_2824":112175},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3337":67644,"_29196":67624,"_20242":112177,"_5":13829,"_26574":112117,"_2824":112178},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3337":67645,"_29196":67624,"_20242":112180,"_5":13829,"_26574":112117,"_2824":112181},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3337":67646,"_29196":67624,"_20242":112183,"_5":13829,"_26574":112117,"_2824":112184},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3337":67647,"_29196":67624,"_20242":112186,"_5":13829,"_26574":112117,"_2824":112187},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3337":67648,"_29196":67624,"_20242":112189,"_5":13829,"_26574":112117,"_2824":112190},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3337":67649,"_29196":67624,"_20242":112192,"_5":13829,"_26574":112117,"_2824":112193},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3337":67650,"_29196":67624,"_20242":112195,"_5":13829,"_26574":112117,"_2824":112196},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3337":67651,"_29196":67624,"_20242":112198,"_5":13829,"_26574":112121,"_2824":112199},[],"Necesitas:",{"_3337":67652,"_29196":67624,"_20242":112201,"_5":13829,"_26574":112121,"_2824":112202},[],"un clúster Kubernetes existente",{"_3337":67653,"_29196":67624,"_20242":112204,"_5":13829,"_26574":112121,"_2824":112205},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3337":67654,"_29196":67624,"_20242":112207,"_5":13829,"_26574":112121,"_2824":47874},[],{"_3337":67655,"_29196":67624,"_20242":112209,"_5":13829,"_26574":112121,"_2824":22926},[],{"_3337":67656,"_29196":67624,"_20242":112211,"_5":13829,"_26574":112121,"_2824":112212},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3337":67657,"_29196":67624,"_20242":112214,"_5":13829,"_26574":112121,"_2824":112215},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3337":67658,"_29196":67624,"_20242":112217,"_5":13829,"_26574":112121,"_2824":112218},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3337":67659,"_29196":67624,"_20242":112220,"_5":13829,"_26574":112121,"_2824":112221},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3337":67660,"_29196":67624,"_20242":112223,"_5":13829,"_26574":112121,"_2824":112224},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3337":67661,"_29196":67624,"_20242":112226,"_5":13829,"_26574":112125,"_2824":112227},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3337":67662,"_29196":67624,"_20242":112229,"_5":13829,"_26574":112125,"_2824":112230},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3337":67663,"_29196":67624,"_20242":112232,"_5":13829,"_26574":112129,"_2824":112233},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3337":67664,"_29196":67624,"_20242":112235,"_5":13829,"_26574":112129,"_2824":112236},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3337":67665,"_29196":67624,"_20242":112238,"_5":13829,"_26574":112129,"_2824":112239},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3337":67666,"_29196":67624,"_20242":112241,"_5":13829,"_26574":112129,"_2824":112242},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3337":67667,"_29196":67624,"_20242":112244,"_5":13829,"_26574":112133,"_2824":112245},[],"Opción",{"_3337":67668,"_29196":67624,"_20242":112247,"_5":13829,"_26574":112133,"_2824":112248},[],"Valor predeterminado",{"_3337":67669,"_29196":67624,"_20242":112250,"_5":13829,"_26574":112133,"_2824":112251},[],"Propósito",{"_3337":67670,"_29196":67624,"_20242":112253,"_5":13829,"_26574":112133,"_2824":47921},[],{"_3337":67671,"_29196":67624,"_20242":112255,"_5":13829,"_26574":112133,"_2824":47924},[],{"_3337":67672,"_29196":67624,"_20242":112257,"_5":13829,"_26574":112133,"_2824":112258},[],"Muestra la ayuda",{"_3337":67673,"_29196":67624,"_20242":112260,"_5":13829,"_26574":112133,"_2824":47930},[],{"_3337":67674,"_29196":67624,"_20242":112262,"_5":13829,"_26574":112133,"_2824":112263},[],"contexto actual",{"_3337":67675,"_29196":67624,"_20242":112265,"_5":13829,"_26574":112133,"_2824":112266},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3337":67676,"_29196":67624,"_20242":112268,"_5":13829,"_26574":112133,"_2824":47939},[],{"_3337":67677,"_29196":67624,"_20242":112270,"_5":13829,"_26574":112133,"_2824":6251},[],{"_3337":67678,"_29196":67624,"_20242":112272,"_5":13829,"_26574":112133,"_2824":112273},[],"Omite prompts y genera credenciales para las dependencias",{"_3337":67679,"_29196":67624,"_20242":112275,"_5":13829,"_26574":112133,"_2824":47947},[],{"_3337":67680,"_29196":67624,"_20242":112277,"_5":13829,"_26574":112133,"_2824":47950},[],{"_3337":67681,"_29196":67624,"_20242":112279,"_5":13829,"_26574":112133,"_2824":112280},[],"Namespace de la instalación",{"_3337":67682,"_29196":67624,"_20242":112282,"_5":13829,"_26574":112133,"_2824":47956},[],{"_3337":67683,"_29196":67624,"_20242":112284,"_5":13829,"_26574":112133,"_2824":47959},[],{"_3337":67684,"_29196":67624,"_20242":112286,"_5":13829,"_26574":112133,"_2824":112287},[],"Dominio usado por la UI, OIDC y el certificado",{"_3337":67685,"_29196":67624,"_20242":112289,"_5":13829,"_26574":112133,"_2824":47965},[],{"_3337":67686,"_29196":67624,"_20242":112291,"_5":13829,"_26574":112133,"_2824":14482},[],{"_3337":67687,"_29196":67624,"_20242":112293,"_5":13829,"_26574":112133,"_2824":112294},[],"Versión del chart de Lamassu",{"_3337":67688,"_29196":67624,"_20242":112296,"_5":13829,"_26574":112133,"_2824":47973},[],{"_3337":67689,"_29196":67624,"_20242":112298,"_5":13829,"_26574":112133,"_2824":47976},[],{"_3337":67690,"_29196":67624,"_20242":112300,"_5":13829,"_26574":112133,"_2824":112301},[],"Puerto del listener HTTPS",{"_3337":67691,"_29196":67624,"_20242":112303,"_5":13829,"_26574":112133,"_2824":47982},[],{"_3337":67692,"_29196":67624,"_20242":112305,"_5":13829,"_26574":112133,"_2824":47985},[],{"_3337":67693,"_29196":67624,"_20242":112307,"_5":13829,"_26574":112133,"_2824":112308},[],"Puerto del listener HTTP",{"_3337":67694,"_29196":67624,"_20242":112310,"_5":13829,"_26574":112133,"_2824":47991},[],{"_3337":67695,"_29196":67624,"_20242":112312,"_5":13829,"_26574":112133,"_2824":47924},[],{"_3337":67696,"_29196":67624,"_20242":112314,"_5":13829,"_26574":112133,"_2824":112315},[],"Certificado PEM para TLS downstream",{"_3337":67697,"_29196":67624,"_20242":112317,"_5":13829,"_26574":112133,"_2824":47999},[],{"_3337":67698,"_29196":67624,"_20242":112319,"_5":13829,"_26574":112133,"_2824":47924},[],{"_3337":67699,"_29196":67624,"_20242":112321,"_5":13829,"_26574":112133,"_2824":112322},[],"Clave privada PEM para TLS downstream",{"_3337":67700,"_29196":67624,"_20242":112324,"_5":13829,"_26574":112133,"_2824":48007},[],{"_3337":67701,"_29196":67624,"_20242":112326,"_5":13829,"_26574":112133,"_2824":112327},[],"chart del repositorio",{"_3337":67702,"_29196":67624,"_20242":112329,"_5":13829,"_26574":112133,"_2824":112330},[],"Usa un chart local de Lamassu sin empaquetar",{"_3337":67703,"_29196":67624,"_20242":112332,"_5":13829,"_26574":112133,"_2824":48016},[],{"_3337":67704,"_29196":67624,"_20242":112334,"_5":13829,"_26574":112133,"_2824":112335},[],"detección automática",{"_3337":67705,"_29196":67624,"_20242":112337,"_5":13829,"_26574":112133,"_2824":112338},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3337":67706,"_29196":67624,"_20242":112340,"_5":13829,"_26574":112133,"_2824":48024},[],{"_3337":67707,"_29196":67624,"_20242":112342,"_5":13829,"_26574":112133,"_2824":6251},[],{"_3337":67708,"_29196":67624,"_20242":112344,"_5":13829,"_26574":112133,"_2824":112345},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3337":67709,"_29196":67624,"_20242":112347,"_5":13829,"_26574":112133,"_2824":48032},[],{"_3337":67710,"_29196":67624,"_20242":112349,"_5":13829,"_26574":112133,"_2824":6251},[],{"_3337":67711,"_29196":67624,"_20242":112351,"_5":13829,"_26574":112133,"_2824":112352},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3337":67712,"_29196":67624,"_20242":112354,"_5":13829,"_26574":112133,"_2824":48040},[],{"_3337":67713,"_29196":67624,"_20242":112356,"_5":13829,"_26574":112133,"_2824":6251},[],{"_3337":67714,"_29196":67624,"_20242":112358,"_5":13829,"_26574":112133,"_2824":112359},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3337":67715,"_29196":67624,"_20242":112361,"_5":13829,"_26574":112133,"_2824":48048},[],{"_3337":67716,"_29196":67624,"_20242":112363,"_5":13829,"_26574":112133,"_2824":6251},[],{"_3337":67717,"_29196":67624,"_20242":112365,"_5":13829,"_26574":112133,"_2824":112366},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3337":67718,"_29196":67624,"_20242":112368,"_5":13829,"_26574":112133,"_2824":48056},[],{"_3337":67719,"_29196":67624,"_20242":112370,"_5":13829,"_26574":112133,"_2824":48059},[],{"_3337":67720,"_29196":67624,"_20242":112372,"_5":13829,"_26574":112133,"_2824":112373},[],"Usa otro chart local de SoftHSM",{"_3337":67721,"_29196":67624,"_20242":112375,"_5":13829,"_26574":112133,"_2824":112376},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3337":67722,"_29196":67624,"_20242":112378,"_5":13829,"_26574":112137,"_2824":112379},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3337":67723,"_29196":67624,"_20242":112381,"_5":13829,"_26574":112137,"_2824":112382},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3337":67724,"_29196":67624,"_20242":112384,"_5":13829,"_26574":112137,"_2824":112385},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3337":67725,"_29196":67624,"_20242":112387,"_5":13829,"_26574":112137,"_2824":112388},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3337":67726,"_29196":67624,"_20242":112390,"_5":13829,"_26574":112137,"_2824":112391},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3337":67727,"_29196":67624,"_20242":112393,"_5":13829,"_26574":112137,"_2824":112394},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3337":67728,"_29196":67624,"_20242":112396,"_5":13829,"_26574":112141,"_2824":48086},[],{"_3337":67729,"_29196":67624,"_20242":112398,"_5":13829,"_26574":112141,"_2824":112399},[],"valida las herramientas locales y el clúster seleccionado",{"_3337":67730,"_29196":67624,"_20242":112401,"_5":13829,"_26574":112141,"_2824":112402},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3337":67731,"_29196":67624,"_20242":112404,"_5":13829,"_26574":112141,"_2824":112405},[],"crea el namespace",{"_3337":67732,"_29196":67624,"_20242":112407,"_5":13829,"_26574":112141,"_2824":112408},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3337":67733,"_29196":67624,"_20242":112410,"_5":13829,"_26574":112141,"_2824":112411},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3337":67734,"_29196":67624,"_20242":112413,"_5":13829,"_26574":112141,"_2824":112414},[],"instala RabbitMQ",{"_3337":67735,"_29196":67624,"_20242":112416,"_5":13829,"_26574":112141,"_2824":112417},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3337":67736,"_29196":67624,"_20242":112419,"_5":13829,"_26574":112141,"_2824":112420},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3337":67737,"_29196":67624,"_20242":112422,"_5":13829,"_26574":112141,"_2824":112423},[],"carga datos de ejemplo opcionalmente",{"_3337":67738,"_29196":67624,"_20242":112425,"_5":13829,"_26574":112141,"_2824":112426},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3337":67739,"_29196":67624,"_20242":112428,"_5":13829,"_26574":112145,"_2824":112429},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3337":67740,"_29196":67624,"_20242":112431,"_5":13829,"_26574":112145,"_2824":112432},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3337":67741,"_29196":67624,"_20242":112434,"_5":13829,"_26574":112149,"_2824":112435},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3337":67742,"_29196":67624,"_20242":112437,"_5":13829,"_26574":112149,"_2824":112438},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3337":67743,"_29196":67624,"_20242":112440,"_5":13829,"_26574":112149,"_2824":112441},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3337":67744,"_29196":67624,"_20242":112443,"_5":13829,"_26574":112153,"_2824":112444},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3337":67745,"_29196":67745,"_5":14181,"_2824":112446,"_29540":112447,"_20242":112448,"_26574":67745},"Instala con Helm",[47528,111872,112106],[],{"_3337":67746,"_29196":67745,"_20242":112450,"_5":13829,"_26574":67745,"_2824":112451},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3337":67747,"_29196":67745,"_5":29537,"_20242":112453,"_26574":112454,"_2824":112455},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3337":67748,"_29196":67745,"_5":29537,"_20242":112457,"_26574":112458,"_2824":112122},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3337":67749,"_29196":67745,"_5":29537,"_20242":112460,"_26574":112461,"_2824":112462},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3337":67750,"_29196":67745,"_5":29537,"_20242":112464,"_26574":112465,"_2824":112466},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3337":67751,"_29196":67745,"_5":29537,"_20242":112468,"_26574":112469,"_2824":112470},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3337":67752,"_29196":67745,"_5":29537,"_20242":112472,"_26574":112473,"_2824":112474},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3337":67753,"_29196":67745,"_5":29537,"_20242":112476,"_26574":112477,"_2824":112478},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3337":67754,"_29196":67745,"_5":29537,"_20242":112480,"_26574":112481,"_2824":112482},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3337":67755,"_29196":67745,"_5":29537,"_20242":112484,"_26574":112485,"_2824":112486},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3337":67756,"_29196":67745,"_5":29537,"_20242":112488,"_26574":112489,"_2824":112490},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3337":67757,"_29196":67745,"_20242":112492,"_5":13829,"_26574":112454,"_2824":112493},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3337":67758,"_29196":67745,"_20242":112495,"_5":13829,"_26574":112458,"_2824":112496},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3337":67759,"_29196":67745,"_20242":112498,"_5":13829,"_26574":112458,"_2824":112499},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3337":67760,"_29196":67745,"_20242":112501,"_5":13829,"_26574":112458,"_2824":112502},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3337":67761,"_29196":67745,"_20242":112504,"_5":13829,"_26574":112458,"_2824":112505},[],"un broker RabbitMQ accesible y sus credenciales",{"_3337":67762,"_29196":67745,"_20242":112507,"_5":13829,"_26574":112458,"_2824":112508},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3337":67763,"_29196":67745,"_20242":112510,"_5":13829,"_26574":112458,"_2824":112511},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3337":67764,"_29196":67745,"_20242":112513,"_5":13829,"_26574":112458,"_2824":112514},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3337":67765,"_29196":67745,"_20242":112516,"_5":13829,"_26574":112458,"_2824":112517},[],"una StorageClass y un diseño de tráfico externo",{"_3337":67766,"_29196":67745,"_20242":112519,"_5":13829,"_26574":112458,"_2824":112520},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3337":67767,"_29196":67745,"_20242":112522,"_5":13829,"_26574":112458,"_2824":112523},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3337":67768,"_29196":67745,"_20242":112525,"_5":13829,"_26574":112458,"_2824":112526},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3337":67769,"_29196":67745,"_20242":112528,"_5":13829,"_26574":112461,"_2824":112529},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3337":67770,"_29196":67745,"_20242":112531,"_5":13829,"_26574":112461,"_2824":112532},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3337":67771,"_29196":67745,"_20242":112534,"_5":13829,"_26574":112461,"_2824":112535},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3337":67772,"_29196":67745,"_20242":112537,"_5":13829,"_26574":112465,"_2824":112538},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3337":67773,"_29196":67745,"_20242":112540,"_5":13829,"_26574":112465,"_2824":112541},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3337":67774,"_29196":67745,"_20242":112543,"_5":13829,"_26574":112465,"_2824":112544},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3337":67775,"_29196":67745,"_20242":112546,"_5":13829,"_26574":112465,"_2824":112547},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3337":67776,"_29196":67745,"_20242":112549,"_5":13829,"_26574":112469,"_2824":112550},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3337":67777,"_29196":67745,"_20242":112552,"_5":13829,"_26574":112473,"_2824":112553},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3337":67778,"_29196":67745,"_20242":112555,"_5":13829,"_26574":112473,"_2824":112556},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3337":67779,"_29196":67745,"_20242":112558,"_5":13829,"_26574":112473,"_2824":112559},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3337":67780,"_29196":67745,"_20242":112561,"_5":13829,"_26574":112473,"_2824":112562},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3337":67781,"_29196":67745,"_20242":112564,"_5":13829,"_26574":112473,"_2824":112565},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3337":67782,"_29196":67745,"_20242":112567,"_5":13829,"_26574":112473,"_2824":112568},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3337":67783,"_29196":67745,"_20242":112570,"_5":13829,"_26574":112473,"_2824":112571},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3337":67784,"_29196":67745,"_20242":112573,"_5":13829,"_26574":112477,"_2824":112574},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3337":67785,"_29196":67745,"_20242":112576,"_5":13829,"_26574":112477,"_2824":112577},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3337":67786,"_29196":67745,"_20242":112579,"_5":13829,"_26574":112477,"_2824":112580},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3337":67787,"_29196":67745,"_20242":112582,"_5":13829,"_26574":112477,"_2824":112583},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3337":67788,"_29196":67745,"_20242":112585,"_5":13829,"_26574":112481,"_2824":112586},[],"Para instalar un checkout local:",{"_3337":67789,"_29196":67745,"_20242":112588,"_5":13829,"_26574":112485,"_2824":112589},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3337":67790,"_29196":67745,"_20242":112591,"_5":13829,"_26574":112485,"_2824":112592},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3337":67791,"_29196":67745,"_20242":112594,"_5":13829,"_26574":112489,"_2824":112595},[],"Antes de pasar a producción, revisa:",{"_3337":67792,"_29196":67745,"_20242":112597,"_5":13829,"_26574":112489,"_2824":112598},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3337":67793,"_29196":67745,"_20242":112600,"_5":13829,"_26574":112489,"_2824":112601},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3337":67794,"_29196":67745,"_20242":112603,"_5":13829,"_26574":112489,"_2824":112604},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3337":67795,"_29196":67745,"_20242":112606,"_5":13829,"_26574":112489,"_2824":112607},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3337":67796,"_29196":67745,"_20242":112609,"_5":13829,"_26574":112489,"_2824":112610},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3337":67797,"_29196":67745,"_20242":112612,"_5":13829,"_26574":112489,"_2824":112613},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3337":67798,"_29196":67745,"_20242":112615,"_5":13829,"_26574":112489,"_2824":112616},[],"SMTP, observabilidad y entrega de alertas",{"_3337":67799,"_29196":67745,"_20242":112618,"_5":13829,"_26574":112489,"_2824":112619},[],"las guías de actualización entre versiones y las notas de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_3337":67800,"_29196":67745,"_20242":112621,"_5":13829,"_26574":112489,"_2824":112622},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3337":67801,"_29196":67801,"_5":14181,"_2824":112624,"_29540":112625,"_20242":112626,"_26574":67801},"Expón el Gateway",[47528,111872,112106],[],{"_3337":67802,"_29196":67801,"_20242":112628,"_5":13829,"_26574":67801,"_2824":112629},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3337":67803,"_29196":67801,"_5":29537,"_20242":112631,"_26574":112632,"_2824":112633},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3337":67804,"_29196":67801,"_5":29537,"_20242":112635,"_26574":112636,"_2824":112637},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3337":67805,"_29196":67801,"_5":29537,"_20242":112639,"_26574":112640,"_2824":112641},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3337":67806,"_29196":67801,"_5":29537,"_20242":112643,"_26574":112644,"_2824":48335},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/networking#k3s",{"_3337":67807,"_29196":67801,"_5":29537,"_20242":112646,"_26574":112647,"_2824":112648},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3337":67808,"_29196":67801,"_5":29537,"_20242":112650,"_26574":112651,"_2824":112652},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3337":67809,"_29196":67801,"_5":29537,"_20242":112654,"_26574":112655,"_2824":112656},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3337":67810,"_29196":67801,"_5":29537,"_20242":112658,"_26574":112659,"_2824":112660},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3337":67811,"_29196":67801,"_5":29537,"_20242":112662,"_26574":112663,"_2824":112664},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3337":67812,"_29196":67801,"_5":29537,"_20242":112666,"_26574":112667,"_2824":112668},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3337":67813,"_29196":67801,"_20242":112670,"_5":13829,"_26574":112632,"_2824":112671},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3337":67814,"_29196":67801,"_20242":112673,"_5":13829,"_26574":112632,"_2824":112674},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3337":67815,"_29196":67801,"_20242":112676,"_5":13829,"_26574":112636,"_2824":112677},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3337":67816,"_29196":67801,"_20242":112679,"_5":13829,"_26574":112636,"_2824":112680},[],"Defínelo únicamente cuando:",{"_3337":67817,"_29196":67801,"_20242":112682,"_5":13829,"_26574":112636,"_2824":112683},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3337":67818,"_29196":67801,"_20242":112685,"_5":13829,"_26574":112636,"_2824":112686},[],"esa dirección está asignada a este Gateway",{"_3337":67819,"_29196":67801,"_20242":112688,"_5":13829,"_26574":112636,"_2824":112689},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3337":67820,"_29196":67801,"_20242":112691,"_5":13829,"_26574":112636,"_2824":112692},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3337":67821,"_29196":67801,"_20242":112694,"_5":13829,"_26574":112636,"_2824":112695},[],"No confundas estos valores:",{"_3337":67822,"_29196":67801,"_20242":112697,"_5":13829,"_26574":112636,"_2824":112698},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3337":67823,"_29196":67801,"_20242":112700,"_5":13829,"_26574":112636,"_2824":112701},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3337":67824,"_29196":67801,"_20242":112703,"_5":13829,"_26574":112636,"_2824":112704},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3337":67825,"_29196":67801,"_20242":112706,"_5":13829,"_26574":112640,"_2824":112707},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3337":67826,"_29196":67801,"_20242":112709,"_5":13829,"_26574":112640,"_2824":112710},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3337":67827,"_29196":67801,"_20242":112712,"_5":13829,"_26574":112644,"_2824":112713},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3337":67828,"_29196":67801,"_20242":112715,"_5":13829,"_26574":112644,"_2824":112716},[],"Para el diseño recomendado:",{"_3337":67829,"_29196":67801,"_20242":112718,"_5":13829,"_26574":112644,"_2824":112719},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3337":67830,"_29196":67801,"_20242":112721,"_5":13829,"_26574":112644,"_2824":112722},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3337":67831,"_29196":67801,"_20242":112724,"_5":13829,"_26574":112644,"_2824":112725},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3337":67832,"_29196":67801,"_20242":112727,"_5":13829,"_26574":112644,"_2824":112728},[],"Apunta DNS a la dirección accesible de la VM.",{"_3337":67833,"_29196":67801,"_20242":112730,"_5":13829,"_26574":112644,"_2824":112731},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3337":67834,"_29196":67801,"_20242":112733,"_5":13829,"_26574":112647,"_2824":112734},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3337":67835,"_29196":67801,"_20242":112736,"_5":13829,"_26574":112651,"_2824":112737},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3337":67836,"_29196":67801,"_20242":112739,"_5":13829,"_26574":112651,"_2824":112740},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3337":67837,"_29196":67801,"_20242":112742,"_5":13829,"_26574":112655,"_2824":112743},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3337":67838,"_29196":67801,"_20242":112745,"_5":13829,"_26574":112655,"_2824":112746},[],"Requisito",{"_3337":67839,"_29196":67801,"_20242":112748,"_5":13829,"_26574":112655,"_2824":112749},[],"Diseño recomendado",{"_3337":67840,"_29196":67801,"_20242":112751,"_5":13829,"_26574":112655,"_2824":112752},[],"Consecuencia",{"_3337":67841,"_29196":67801,"_20242":112754,"_5":13829,"_26574":112655,"_2824":112755},[],"Varias URL o servicios de Lamassu",{"_3337":67842,"_29196":67801,"_20242":112757,"_5":13829,"_26574":112655,"_2824":112758},[],"Un Gateway con varias rutas",{"_3337":67843,"_29196":67801,"_20242":112760,"_5":13829,"_26574":112655,"_2824":112761},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3337":67844,"_29196":67801,"_20242":112763,"_5":13829,"_26574":112655,"_2824":112764},[],"Gateways independientes e IP externas distintas",{"_3337":67845,"_29196":67801,"_20242":112766,"_5":13829,"_26574":112655,"_2824":112767},[],"Una VIP por Gateway",{"_3337":67846,"_29196":67801,"_20242":112769,"_5":13829,"_26574":112655,"_2824":112770},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3337":67847,"_29196":67801,"_20242":112772,"_5":13829,"_26574":112655,"_2824":112773},[],"Gateways independientes, un nodo y una IP",{"_3337":67848,"_29196":67801,"_20242":112775,"_5":13829,"_26574":112655,"_2824":112776},[],"Puertos externos diferentes",{"_3337":67849,"_29196":67801,"_20242":112778,"_5":13829,"_26574":112655,"_2824":112779},[],"Los clientes deben indicar puertos no estándar",{"_3337":67850,"_29196":67801,"_20242":112781,"_5":13829,"_26574":112655,"_2824":112782},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3337":67851,"_29196":67801,"_20242":112784,"_5":13829,"_26574":112655,"_2824":112785},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3337":67852,"_29196":67801,"_20242":112787,"_5":13829,"_26574":112655,"_2824":112788},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3337":67853,"_29196":67801,"_20242":112790,"_5":13829,"_26574":112655,"_2824":112791},[],"Recursos Gateway separados pero proxy compartido",{"_3337":67854,"_29196":67801,"_20242":112793,"_5":13829,"_26574":112655,"_2824":112794},[],"Modo merged Gateway de Envoy",{"_3337":67855,"_29196":67801,"_20242":112796,"_5":13829,"_26574":112655,"_2824":112797},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3337":67856,"_29196":67801,"_20242":112799,"_5":13829,"_26574":112655,"_2824":112800},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3337":67857,"_29196":67801,"_20242":112802,"_5":13829,"_26574":112655,"_2824":112803},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3337":67858,"_29196":67801,"_20242":112805,"_5":13829,"_26574":112655,"_2824":112806},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3337":67859,"_29196":67801,"_20242":112808,"_5":13829,"_26574":112655,"_2824":112809},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3337":67860,"_29196":67801,"_20242":112811,"_5":13829,"_26574":112659,"_2824":112812},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3337":67861,"_29196":67801,"_20242":112814,"_5":13829,"_26574":112659,"_2824":112815},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3337":67862,"_29196":67801,"_20242":112817,"_5":13829,"_26574":112659,"_2824":112818},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3337":67863,"_29196":67801,"_20242":112820,"_5":13829,"_26574":112659,"_2824":112821},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3337":67864,"_29196":67801,"_20242":112823,"_5":13829,"_26574":112659,"_2824":112824},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3337":67865,"_29196":67801,"_20242":112826,"_5":13829,"_26574":112663,"_2824":112827},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3337":67866,"_29196":67801,"_20242":112829,"_5":13829,"_26574":112663,"_2824":112830},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3337":67867,"_29196":67801,"_20242":112832,"_5":13829,"_26574":112667,"_2824":112833},[],"Comprueba, en orden:",{"_3337":67868,"_29196":67801,"_20242":112835,"_5":13829,"_26574":112667,"_2824":112836},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3337":67869,"_29196":67801,"_20242":112838,"_5":13829,"_26574":112667,"_2824":112839},[],"Su estado contiene la dirección esperada.",{"_3337":67870,"_29196":67801,"_20242":112841,"_5":13829,"_26574":112667,"_2824":112842},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3337":67871,"_29196":67801,"_20242":112844,"_5":13829,"_26574":112667,"_2824":112845},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3337":67872,"_29196":67801,"_20242":112847,"_5":13829,"_26574":112667,"_2824":112848},[],"DNS resuelve al endpoint accesible externamente.",{"_3337":67873,"_29196":67801,"_20242":112850,"_5":13829,"_26574":112667,"_2824":112851},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3337":67874,"_29196":67801,"_20242":112853,"_5":13829,"_26574":112667,"_2824":112854},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3337":67875,"_29196":67875,"_5":14181,"_2824":47635,"_29540":112856,"_20242":112857,"_26574":67875},[47528,111872,112106],[],{"_3337":67876,"_29196":67875,"_20242":112859,"_5":13829,"_26574":67875,"_2824":112860},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3337":67877,"_29196":67875,"_5":29537,"_20242":112862,"_26574":112863,"_2824":112864},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3337":67878,"_29196":67875,"_5":29537,"_20242":112866,"_26574":112867,"_2824":112868},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3337":67879,"_29196":67875,"_5":29537,"_20242":112870,"_26574":112871,"_2824":112872},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3337":67880,"_29196":67875,"_5":29537,"_20242":112874,"_26574":112875,"_2824":112876},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3337":67881,"_29196":67875,"_5":29537,"_20242":112878,"_26574":112879,"_2824":112880},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3337":67882,"_29196":67875,"_5":29537,"_20242":112882,"_26574":112883,"_2824":112884},[],"/docs/pr-preview/pr-57/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3337":67883,"_29196":67875,"_20242":112886,"_5":13829,"_26574":112863,"_2824":112887},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3337":67884,"_29196":67875,"_20242":112889,"_5":13829,"_26574":112867,"_2824":112890},[],"Flujo",{"_3337":67885,"_29196":67875,"_20242":112892,"_5":13829,"_26574":112867,"_2824":112893},[],"Úsalo para",{"_3337":67886,"_29196":67875,"_20242":112895,"_5":13829,"_26574":112867,"_2824":112896},[],"Qué instala",{"_3337":67887,"_29196":67875,"_20242":112898,"_5":13829,"_26574":112867,"_2824":48590},[],{"_3337":67888,"_29196":67875,"_20242":112900,"_5":13829,"_26574":112867,"_2824":112901},[],"Producción y entornos controlados",{"_3337":67889,"_29196":67875,"_20242":112903,"_5":13829,"_26574":112867,"_2824":112904},[],"Servicios de Lamassu y recursos de Gateway API",{"_3337":67890,"_29196":67875,"_20242":112906,"_5":13829,"_26574":112867,"_2824":47772},[],{"_3337":67891,"_29196":67875,"_20242":112908,"_5":13829,"_26574":112867,"_2824":112909},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3337":67892,"_29196":67875,"_20242":112911,"_5":13829,"_26574":112867,"_2824":112912},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3337":67893,"_29196":67875,"_20242":112914,"_5":13829,"_26574":112871,"_2824":112915},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3337":67894,"_29196":67875,"_20242":112917,"_5":13829,"_26574":112871,"_2824":112918},[],"Área",{"_3337":67895,"_29196":67875,"_20242":112920,"_5":13829,"_26574":112871,"_2824":112921},[],"El chart de Lamassu proporciona",{"_3337":67896,"_29196":67875,"_20242":112923,"_5":13829,"_26574":112871,"_2824":112924},[],"Tú proporcionas",{"_3337":67897,"_29196":67875,"_20242":112926,"_5":13829,"_26574":112871,"_2824":112927},[],"Aplicaciones Lamassu",{"_3337":67898,"_29196":67875,"_20242":112929,"_5":13829,"_26574":112871,"_2824":112930},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3337":67899,"_29196":67875,"_20242":112932,"_5":13829,"_26574":112871,"_2824":112933},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3337":67900,"_29196":67875,"_20242":112935,"_5":13829,"_26574":112871,"_2824":112936},[],"Datos PostgreSQL",{"_3337":67901,"_29196":67875,"_20242":112938,"_5":13829,"_26574":112871,"_2824":112939},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3337":67902,"_29196":67875,"_20242":112941,"_5":13829,"_26574":112871,"_2824":112942},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3337":67903,"_29196":67875,"_20242":112944,"_5":13829,"_26574":112871,"_2824":112945},[],"Mensajería",{"_3337":67904,"_29196":67875,"_20242":112947,"_5":13829,"_26574":112871,"_2824":112948},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3337":67905,"_29196":67875,"_20242":112950,"_5":13829,"_26574":112871,"_2824":112951},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3337":67906,"_29196":67875,"_20242":112953,"_5":13829,"_26574":112871,"_2824":112954},[],"Identidad",{"_3337":67907,"_29196":67875,"_20242":112956,"_5":13829,"_26574":112871,"_2824":112957},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3337":67908,"_29196":67875,"_20242":112959,"_5":13829,"_26574":112871,"_2824":112960},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3337":67909,"_29196":67875,"_20242":112962,"_5":13829,"_26574":112871,"_2824":112963},[],"Enrutamiento externo",{"_3337":67910,"_29196":67875,"_20242":112965,"_5":13829,"_26574":112871,"_2824":112966},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3337":67911,"_29196":67875,"_20242":112968,"_5":13829,"_26574":112871,"_2824":112969},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3337":67912,"_29196":67875,"_20242":112971,"_5":13829,"_26574":112871,"_2824":48664},[],{"_3337":67913,"_29196":67875,"_20242":112973,"_5":13829,"_26574":112871,"_2824":112974},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3337":67914,"_29196":67875,"_20242":112976,"_5":13829,"_26574":112871,"_2824":112977},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3337":67915,"_29196":67875,"_20242":112979,"_5":13829,"_26574":112871,"_2824":112980},[],"Datos persistentes de la aplicación",{"_3337":67916,"_29196":67875,"_20242":112982,"_5":13829,"_26574":112871,"_2824":112983},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3337":67917,"_29196":67875,"_20242":112985,"_5":13829,"_26574":112871,"_2824":112986},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3337":67918,"_29196":67875,"_20242":112988,"_5":13829,"_26574":112871,"_2824":112989},[],"Integraciones opcionales",{"_3337":67919,"_29196":67875,"_20242":112991,"_5":13829,"_26574":112871,"_2824":112992},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3337":67920,"_29196":67875,"_20242":112994,"_5":13829,"_26574":112871,"_2824":112995},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3337":67921,"_29196":67875,"_20242":112997,"_5":13829,"_26574":112871,"_2824":112998},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3337":67922,"_29196":67875,"_20242":113000,"_5":13829,"_26574":112871,"_2824":113001},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3337":67923,"_29196":67875,"_20242":113003,"_5":13829,"_26574":112875,"_2824":113004},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3337":67924,"_29196":67875,"_20242":113006,"_5":13829,"_26574":112875,"_2824":113007},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3337":67925,"_29196":67875,"_20242":113009,"_5":13829,"_26574":112879,"_2824":113010},[],"Kubernetes 1.24 o posterior",{"_3337":67926,"_29196":67875,"_20242":113012,"_5":13829,"_26574":112879,"_2824":113013},[],"Helm 3.2 o posterior",{"_3337":67927,"_29196":67875,"_20242":113015,"_5":13829,"_26574":112879,"_2824":113016},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3337":67928,"_29196":67875,"_20242":113018,"_5":13829,"_26574":112879,"_2824":113019},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3337":67929,"_29196":67875,"_20242":113021,"_5":13829,"_26574":112879,"_2824":113022},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3337":67930,"_29196":67875,"_20242":113024,"_5":13829,"_26574":112879,"_2824":113025},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3337":67931,"_29196":67875,"_20242":113027,"_5":13829,"_26574":112879,"_2824":113028},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3337":67932,"_29196":67875,"_20242":113030,"_5":13829,"_26574":112883,"_2824":113031},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3337":67933,"_29196":67875,"_20242":113033,"_5":13829,"_26574":112883,"_2824":113034},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3337":67934,"_29196":67875,"_20242":113036,"_5":13829,"_26574":112883,"_2824":113037},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3337":67935,"_29196":67875,"_20242":113039,"_5":13829,"_26574":112883,"_2824":113040},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3337":67936,"_29196":67936,"_5":14181,"_2824":113042,"_29540":113043,"_20242":113045,"_26574":67936},"Resolución de problemas de despliegue",[47528,111872,113044],"Operación",[],{"_3337":67937,"_29196":67936,"_20242":113047,"_5":13829,"_26574":67936,"_2824":113048},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3337":67938,"_29196":67936,"_5":29537,"_20242":113050,"_26574":113051,"_2824":113052},[],"/docs/pr-preview/pr-57/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3337":67939,"_29196":67936,"_5":29537,"_20242":113054,"_26574":113055,"_2824":113056},[],"/docs/pr-preview/pr-57/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3337":67940,"_29196":67936,"_5":29537,"_20242":113058,"_26574":113059,"_2824":113060},[],"/docs/pr-preview/pr-57/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3337":67941,"_29196":67936,"_5":29537,"_20242":113062,"_26574":113063,"_2824":113064},[],"/docs/pr-preview/pr-57/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3337":67942,"_29196":67936,"_5":29537,"_20242":113066,"_26574":113067,"_2824":113068},[],"/docs/pr-preview/pr-57/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3337":67943,"_29196":67936,"_5":29537,"_20242":113070,"_26574":113071,"_2824":113072},[],"/docs/pr-preview/pr-57/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3337":67944,"_29196":67936,"_5":29537,"_20242":113074,"_26574":113075,"_2824":113076},[],"/docs/pr-preview/pr-57/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3337":67945,"_29196":67936,"_5":29537,"_20242":113078,"_26574":113079,"_2824":113080},[],"/docs/pr-preview/pr-57/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3337":67946,"_29196":67936,"_5":29537,"_20242":113082,"_26574":113083,"_2824":113084},[],"/docs/pr-preview/pr-57/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3337":67947,"_29196":67936,"_5":29537,"_20242":113086,"_26574":113087,"_2824":113088},[],"/docs/pr-preview/pr-57/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3337":67948,"_29196":67936,"_5":29537,"_20242":113090,"_26574":113091,"_2824":113092},[],"/docs/pr-preview/pr-57/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3337":67949,"_29196":67936,"_5":29537,"_20242":113094,"_26574":113095,"_2824":113096},[],"/docs/pr-preview/pr-57/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3337":67950,"_29196":67936,"_5":29537,"_20242":113098,"_26574":113099,"_2824":113100},[],"/docs/pr-preview/pr-57/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3337":67951,"_29196":67936,"_20242":113102,"_5":13829,"_26574":67936,"_2824":113103},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3337":67952,"_29196":67936,"_20242":113105,"_5":13829,"_26574":113055,"_2824":113106},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3337":67953,"_29196":67936,"_20242":113108,"_5":13829,"_26574":113059,"_2824":113109},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3337":67954,"_29196":67936,"_20242":113111,"_5":13829,"_26574":113063,"_2824":113112},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3337":67955,"_29196":67936,"_20242":113114,"_5":13829,"_26574":113067,"_2824":113115},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3337":67956,"_29196":67936,"_20242":113117,"_5":13829,"_26574":113071,"_2824":113118},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3337":67957,"_29196":67936,"_20242":113120,"_5":13829,"_26574":113075,"_2824":113121},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3337":67958,"_29196":67936,"_20242":113123,"_5":13829,"_26574":113075,"_2824":113124},[],"Ejecuta también la prueba de conectividad del chart:",{"_3337":67959,"_29196":67936,"_20242":113126,"_5":13829,"_26574":113075,"_2824":113127},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3337":67960,"_29196":67936,"_20242":113129,"_5":13829,"_26574":113075,"_2824":113130},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3337":67961,"_29196":67936,"_20242":113132,"_5":13829,"_26574":113079,"_2824":113133},[],"Si recibes un 401:",{"_3337":67962,"_29196":67936,"_20242":113135,"_5":13829,"_26574":113079,"_2824":113136},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3337":67963,"_29196":67936,"_20242":113138,"_5":13829,"_26574":113079,"_2824":113139},[],"verifica emisor, audiencia y expiración del token;",{"_3337":67964,"_29196":67936,"_20242":113141,"_5":13829,"_26574":113079,"_2824":113142},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3337":67965,"_29196":67936,"_20242":113144,"_5":13829,"_26574":113079,"_2824":113145},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3337":67966,"_29196":67936,"_20242":113147,"_5":13829,"_26574":113079,"_2824":113148},[],"Si el login termina pero las APIs devuelven 403:",{"_3337":67967,"_29196":67936,"_20242":113150,"_5":13829,"_26574":113079,"_2824":113151},[],"inspecciona los claims reales del token;",{"_3337":67968,"_29196":67936,"_20242":113153,"_5":13829,"_26574":113079,"_2824":113154},[],"confirma que coinciden con un principal activo;",{"_3337":67969,"_29196":67936,"_20242":113156,"_5":13829,"_26574":113079,"_2824":113157},[],"revisa las políticas concedidas al principal;",{"_3337":67970,"_29196":67936,"_20242":113159,"_5":13829,"_26574":113079,"_2824":113160},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3337":67971,"_29196":67936,"_20242":113162,"_5":13829,"_26574":113079,"_2824":113163},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3337":67972,"_29196":67936,"_20242":113165,"_5":13829,"_26574":113083,"_2824":113166},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3337":67973,"_29196":67936,"_20242":113168,"_5":13829,"_26574":113083,"_2824":113169},[],"Localiza el pod y Service de authz.",{"_3337":67974,"_29196":67936,"_20242":113171,"_5":13829,"_26574":113083,"_2824":113172},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3337":67975,"_29196":67936,"_20242":113174,"_5":13829,"_26574":113083,"_2824":113175},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3337":67976,"_29196":67936,"_20242":113177,"_5":13829,"_26574":113083,"_2824":113178},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3337":67977,"_29196":67936,"_20242":113180,"_5":13829,"_26574":113083,"_2824":113181},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3337":67978,"_29196":67936,"_20242":113183,"_5":13829,"_26574":113087,"_2824":113184},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3337":67979,"_29196":67936,"_20242":113186,"_5":13829,"_26574":113091,"_2824":113187},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3337":67980,"_29196":67936,"_20242":113189,"_5":13829,"_26574":113091,"_2824":113190},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3337":67981,"_29196":67936,"_20242":113192,"_5":13829,"_26574":113091,"_2824":113193},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3337":67982,"_29196":67936,"_20242":113195,"_5":13829,"_26574":113091,"_2824":113196},[],"volumen persistente sin enlazar;",{"_3337":67983,"_29196":67936,"_20242":113198,"_5":13829,"_26574":113091,"_2824":113199},[],"imagen inaccesible o política de pull incorrecta;",{"_3337":67984,"_29196":67936,"_20242":113201,"_5":13829,"_26574":113091,"_2824":113202},[],"configuración inválida del motor criptográfico;",{"_3337":67985,"_29196":67936,"_20242":113204,"_5":13829,"_26574":113091,"_2824":113205},[],"límites de CPU o memoria demasiado bajos;",{"_3337":67986,"_29196":67936,"_20242":113207,"_5":13829,"_26574":113091,"_2824":113208},[],"migración previa incompleta.",{"_3337":67987,"_29196":67936,"_20242":113210,"_5":13829,"_26574":113091,"_2824":113211},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3337":67988,"_29196":67936,"_20242":113213,"_5":13829,"_26574":113091,"_2824":113214},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3337":67989,"_29196":67936,"_20242":113216,"_5":13829,"_26574":113091,"_2824":113217},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3337":67990,"_29196":67936,"_20242":113219,"_5":13829,"_26574":113095,"_2824":113220},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3337":67991,"_29196":67936,"_20242":113222,"_5":13829,"_26574":113095,"_2824":113223},[],"verifica que esté habilitado en el servicio emisor;",{"_3337":67992,"_29196":67936,"_20242":113225,"_5":13829,"_26574":113095,"_2824":113226},[],"comprueba conectividad y credenciales AMQP;",{"_3337":67993,"_29196":67936,"_20242":113228,"_5":13829,"_26574":113095,"_2824":113229},[],"revisa exchange, routing key, colas y consumidores;",{"_3337":67994,"_29196":67936,"_20242":113231,"_5":13829,"_26574":113095,"_2824":113232},[],"inspecciona dead-letter queues;",{"_3337":67995,"_29196":67936,"_20242":113234,"_5":13829,"_26574":113095,"_2824":113235},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3337":67996,"_29196":67936,"_20242":113237,"_5":13829,"_26574":113095,"_2824":113238},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3337":67997,"_29196":67936,"_20242":113240,"_5":13829,"_26574":113095,"_2824":113241},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3337":67998,"_29196":67936,"_20242":113243,"_5":13829,"_26574":113095,"_2824":113244},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3337":67999,"_29196":67936,"_20242":113246,"_5":13829,"_26574":113095,"_2824":113247},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3337":68000,"_29196":67936,"_20242":113249,"_5":13829,"_26574":113095,"_2824":113250},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3337":68001,"_29196":67936,"_20242":113252,"_5":13829,"_26574":113095,"_2824":113253},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3337":68002,"_29196":67936,"_20242":113255,"_5":13829,"_26574":113095,"_2824":113256},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3337":68003,"_29196":67936,"_20242":113258,"_5":13829,"_26574":113099,"_2824":113259},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_3337":68004,"_29196":67936,"_20242":113261,"_5":13829,"_26574":113099,"_2824":113262},[],"Antes de cerrar una incidencia, guarda:",{"_3337":68005,"_29196":67936,"_20242":113264,"_5":13829,"_26574":113099,"_2824":113265},[],"causa confirmada;",{"_3337":68006,"_29196":67936,"_20242":113267,"_5":13829,"_26574":113099,"_2824":113268},[],"alcance temporal y recursos afectados;",{"_3337":68007,"_29196":67936,"_20242":113270,"_5":13829,"_26574":113099,"_2824":113271},[],"comandos o consultas utilizados;",{"_3337":68008,"_29196":67936,"_20242":113273,"_5":13829,"_26574":113099,"_2824":113274},[],"cambio aplicado y forma de revertirlo;",{"_3337":68009,"_29196":67936,"_20242":113276,"_5":13829,"_26574":113099,"_2824":113277},[],"validación desde un consumidor;",{"_3337":68010,"_29196":67936,"_20242":113279,"_5":13829,"_26574":113099,"_2824":113280},[],"acción preventiva y propietario.",{"_3337":68011,"_29196":68011,"_5":14181,"_2824":113282,"_29540":113283,"_20242":113286,"_26574":68011},"Control de acceso",[47528,113284,113285],"Plataforma","Administración",[],{"_3337":68012,"_29196":68011,"_20242":113288,"_5":13829,"_26574":68011,"_2824":113289},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3337":68013,"_29196":68011,"_5":29537,"_20242":113291,"_26574":113292,"_2824":113293},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3337":68014,"_29196":68011,"_5":29537,"_20242":113295,"_26574":113296,"_2824":113297},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3337":68015,"_29196":68011,"_5":29537,"_20242":113299,"_26574":113300,"_2824":113301},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3337":68016,"_29196":68011,"_5":29537,"_20242":113303,"_26574":113304,"_2824":113305},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3337":68017,"_29196":68011,"_5":29537,"_20242":113307,"_26574":113308,"_2824":113309},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3337":68018,"_29196":68011,"_5":29537,"_20242":113311,"_26574":113312,"_2824":113313},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3337":68019,"_29196":68011,"_5":29537,"_20242":113315,"_26574":113316,"_2824":113317},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3337":68020,"_29196":68011,"_5":29537,"_20242":113319,"_26574":113320,"_2824":113321},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3337":68021,"_29196":68011,"_5":29537,"_20242":113323,"_26574":113324,"_2824":113325},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3337":68022,"_29196":68011,"_5":29537,"_20242":113327,"_26574":113328,"_2824":113329},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3337":68023,"_29196":68011,"_5":29537,"_20242":113331,"_26574":113332,"_2824":113333},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3337":68024,"_29196":68011,"_5":29537,"_20242":113335,"_26574":113336,"_2824":113337},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3337":68025,"_29196":68011,"_5":29537,"_20242":113339,"_26574":113340,"_2824":113341},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3337":68026,"_29196":68011,"_5":29537,"_20242":113343,"_26574":113344,"_2824":113345},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3337":68027,"_29196":68011,"_5":29537,"_20242":113347,"_26574":113348,"_2824":113349},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3337":68028,"_29196":68011,"_5":29537,"_20242":113351,"_26574":113352,"_2824":112478},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3337":68029,"_29196":68011,"_5":29537,"_20242":113354,"_26574":113355,"_2824":113356},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3337":68030,"_29196":68011,"_5":29537,"_20242":113358,"_26574":113359,"_2824":113360},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3337":68031,"_29196":68011,"_5":29537,"_20242":113362,"_26574":113363,"_2824":113364},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3337":68032,"_29196":68011,"_5":29537,"_20242":113366,"_26574":113367,"_2824":113368},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3337":68033,"_29196":68011,"_5":29537,"_20242":113370,"_26574":113371,"_2824":113372},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3337":68034,"_29196":68011,"_5":29537,"_20242":113374,"_26574":113375,"_2824":113376},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3337":68035,"_29196":68011,"_5":29537,"_20242":113378,"_26574":113379,"_2824":113380},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3337":68036,"_29196":68011,"_5":29537,"_20242":113382,"_26574":113383,"_2824":113384},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3337":68037,"_29196":68011,"_5":29537,"_20242":113386,"_26574":113387,"_2824":113388},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3337":68038,"_29196":68011,"_5":29537,"_20242":113390,"_26574":113391,"_2824":113392},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3337":68039,"_29196":68011,"_5":29537,"_20242":113394,"_26574":113395,"_2824":113396},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3337":68040,"_29196":68011,"_5":29537,"_20242":113398,"_26574":113399,"_2824":113400},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3337":68041,"_29196":68011,"_5":29537,"_20242":113402,"_26574":113403,"_2824":113404},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3337":68042,"_29196":68011,"_5":29537,"_20242":113406,"_26574":113407,"_2824":113408},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3337":68043,"_29196":68011,"_5":29537,"_20242":113410,"_26574":113411,"_2824":113412},[],"/docs/pr-preview/pr-57/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3337":68044,"_29196":68011,"_20242":113414,"_5":13829,"_26574":68011,"_2824":113415},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3337":68045,"_29196":68011,"_20242":113417,"_5":13829,"_26574":68011,"_2824":113418},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3337":68046,"_29196":68011,"_20242":113420,"_5":13829,"_26574":68011,"_2824":113421},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3337":68047,"_29196":68011,"_20242":113423,"_5":13829,"_26574":113292,"_2824":113424},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3337":68048,"_29196":68011,"_20242":113426,"_5":13829,"_26574":113292,"_2824":113427},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3337":68049,"_29196":68011,"_20242":113429,"_5":13829,"_26574":113292,"_2824":113430},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3337":68050,"_29196":68011,"_20242":113432,"_5":13829,"_26574":113292,"_2824":113433},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3337":68051,"_29196":68011,"_20242":113435,"_5":13829,"_26574":113292,"_2824":113436},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3337":68052,"_29196":68011,"_20242":113438,"_5":13829,"_26574":113292,"_2824":113439},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3337":68053,"_29196":68011,"_20242":113441,"_5":13829,"_26574":113296,"_2824":113442},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3337":68054,"_29196":68011,"_20242":113444,"_5":13829,"_26574":113296,"_2824":113445},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3337":68055,"_29196":68011,"_20242":113447,"_5":13829,"_26574":113300,"_2824":113448},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3337":68056,"_29196":68011,"_20242":113450,"_5":13829,"_26574":113300,"_2824":113451},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3337":68057,"_29196":68011,"_20242":113453,"_5":13829,"_26574":113300,"_2824":113454},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3337":68058,"_29196":68011,"_20242":113456,"_5":13829,"_26574":113300,"_2824":113457},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3337":68059,"_29196":68011,"_20242":113459,"_5":13829,"_26574":113300,"_2824":113460},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3337":68060,"_29196":68011,"_20242":113462,"_5":13829,"_26574":113300,"_2824":113463},[],"Carga por separado las políticas concedidas a cada principal.",{"_3337":68061,"_29196":68011,"_20242":113465,"_5":13829,"_26574":113300,"_2824":113466},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3337":68062,"_29196":68011,"_20242":113468,"_5":13829,"_26574":113300,"_2824":113469},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3337":68063,"_29196":68011,"_20242":113471,"_5":13829,"_26574":113300,"_2824":113472},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3337":68064,"_29196":68011,"_20242":113474,"_5":13829,"_26574":113300,"_2824":113475},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3337":68065,"_29196":68011,"_20242":113477,"_5":13829,"_26574":113300,"_2824":113478},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3337":68066,"_29196":68011,"_20242":113480,"_5":13829,"_26574":113300,"_2824":113481},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3337":68067,"_29196":68011,"_20242":113483,"_5":13829,"_26574":113304,"_2824":113484},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3337":68068,"_29196":68011,"_20242":113486,"_5":13829,"_26574":113304,"_2824":113487},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3337":68069,"_29196":68011,"_20242":113489,"_5":13829,"_26574":113304,"_2824":113490},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3337":68070,"_29196":68011,"_20242":113492,"_5":13829,"_26574":113304,"_2824":113493},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3337":68071,"_29196":68011,"_20242":113495,"_5":13829,"_26574":113304,"_2824":113496},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3337":68072,"_29196":68011,"_20242":113498,"_5":13829,"_26574":113304,"_2824":113499},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3337":68073,"_29196":68011,"_20242":113501,"_5":13829,"_26574":113304,"_2824":113502},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3337":68074,"_29196":68011,"_20242":113504,"_5":13829,"_26574":113304,"_2824":113505},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3337":68075,"_29196":68011,"_20242":113507,"_5":13829,"_26574":113308,"_2824":113508},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3337":68076,"_29196":68011,"_20242":113510,"_5":13829,"_26574":113308,"_2824":113511},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3337":68077,"_29196":68011,"_20242":113513,"_5":13829,"_26574":113308,"_2824":113514},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3337":68078,"_29196":68011,"_20242":113516,"_5":13829,"_26574":113308,"_2824":113517},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3337":68079,"_29196":68011,"_20242":113519,"_5":13829,"_26574":113308,"_2824":113520},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3337":68080,"_29196":68011,"_20242":113522,"_5":13829,"_26574":113308,"_2824":113523},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3337":68081,"_29196":68011,"_20242":113525,"_5":13829,"_26574":113308,"_2824":113526},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3337":68082,"_29196":68011,"_20242":113528,"_5":13829,"_26574":113308,"_2824":113529},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3337":68083,"_29196":68011,"_20242":113531,"_5":13829,"_26574":113308,"_2824":113532},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3337":68084,"_29196":68011,"_20242":113534,"_5":13829,"_26574":113308,"_2824":113535},[],"Las acciones se dividen en dos grupos:",{"_3337":68085,"_29196":68011,"_20242":113537,"_5":13829,"_26574":113308,"_2824":113538},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3337":68086,"_29196":68011,"_20242":113540,"_5":13829,"_26574":113308,"_2824":113541},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3337":68087,"_29196":68011,"_20242":113543,"_5":13829,"_26574":113308,"_2824":113544},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3337":68088,"_29196":68011,"_20242":113546,"_5":13829,"_26574":113312,"_2824":113547},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3337":68089,"_29196":68011,"_20242":113549,"_5":13829,"_26574":113312,"_2824":113550},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3337":68090,"_29196":68011,"_20242":113552,"_5":13829,"_26574":113312,"_2824":113553},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3337":68091,"_29196":68011,"_20242":113555,"_5":13829,"_26574":113316,"_2824":113556},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3337":68092,"_29196":68011,"_20242":113558,"_5":13829,"_26574":113316,"_2824":113559},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3337":68093,"_29196":68011,"_20242":113561,"_5":13829,"_26574":113316,"_2824":113562},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3337":68094,"_29196":68011,"_20242":113564,"_5":13829,"_26574":113316,"_2824":113565},[],"Los operadores implementados son:",{"_3337":68095,"_29196":68011,"_20242":113567,"_5":13829,"_26574":113316,"_2824":113568},[],"`equals`, para igualdad exacta;",{"_3337":68096,"_29196":68011,"_20242":113570,"_5":13829,"_26574":113316,"_2824":113571},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3337":68097,"_29196":68011,"_20242":113573,"_5":13829,"_26574":113316,"_2824":113574},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3337":68098,"_29196":68011,"_20242":113576,"_5":13829,"_26574":113316,"_2824":113577},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3337":68099,"_29196":68011,"_20242":113579,"_5":13829,"_26574":113320,"_2824":113580},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3337":68100,"_29196":68011,"_20242":113582,"_5":13829,"_26574":113320,"_2824":113583},[],"Los modos disponibles son:",{"_3337":68101,"_29196":68011,"_20242":113585,"_5":13829,"_26574":113320,"_2824":113586},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3337":68102,"_29196":68011,"_20242":113588,"_5":13829,"_26574":113320,"_2824":113589},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3337":68103,"_29196":68011,"_20242":113591,"_5":13829,"_26574":113320,"_2824":113592},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3337":68104,"_29196":68011,"_20242":113594,"_5":13829,"_26574":113320,"_2824":113595},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3337":68105,"_29196":68011,"_20242":113597,"_5":13829,"_26574":113320,"_2824":113598},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3337":68106,"_29196":68011,"_20242":113600,"_5":13829,"_26574":113320,"_2824":113601},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3337":68107,"_29196":68011,"_20242":113603,"_5":13829,"_26574":113324,"_2824":113604},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3337":68108,"_29196":68011,"_20242":113606,"_5":13829,"_26574":113324,"_2824":113607},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3337":68109,"_29196":68011,"_20242":113609,"_5":13829,"_26574":113324,"_2824":113610},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3337":68110,"_29196":68011,"_20242":113612,"_5":13829,"_26574":113324,"_2824":113613},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3337":68111,"_29196":68011,"_20242":113615,"_5":13829,"_26574":113332,"_2824":113616},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3337":68112,"_29196":68011,"_20242":113618,"_5":13829,"_26574":113332,"_2824":113619},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3337":68113,"_29196":68011,"_20242":113621,"_5":13829,"_26574":113336,"_2824":113622},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3337":68114,"_29196":68011,"_20242":113624,"_5":13829,"_26574":113336,"_2824":113625},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3337":68115,"_29196":68011,"_20242":113627,"_5":13829,"_26574":113340,"_2824":113628},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3337":68116,"_29196":68011,"_20242":113630,"_5":13829,"_26574":113340,"_2824":113631},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3337":68117,"_29196":68011,"_20242":113633,"_5":13829,"_26574":113340,"_2824":113634},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3337":68118,"_29196":68011,"_20242":113636,"_5":13829,"_26574":113344,"_2824":113637},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3337":68119,"_29196":68011,"_20242":113639,"_5":13829,"_26574":113344,"_2824":113640},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3337":68120,"_29196":68011,"_20242":113642,"_5":13829,"_26574":113344,"_2824":113643},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3337":68121,"_29196":68011,"_20242":113645,"_5":13829,"_26574":113344,"_2824":113646},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3337":68122,"_29196":68011,"_20242":113648,"_5":13829,"_26574":113344,"_2824":113649},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3337":68123,"_29196":68011,"_20242":113651,"_5":13829,"_26574":113344,"_2824":113652},[],"Ten en cuenta que:",{"_3337":68124,"_29196":68011,"_20242":113654,"_5":13829,"_26574":113344,"_2824":113655},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3337":68125,"_29196":68011,"_20242":113657,"_5":13829,"_26574":113344,"_2824":113658},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3337":68126,"_29196":68011,"_20242":113660,"_5":13829,"_26574":113344,"_2824":113661},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3337":68127,"_29196":68011,"_20242":113663,"_5":13829,"_26574":113348,"_2824":113664},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3337":68128,"_29196":68011,"_20242":113666,"_5":13829,"_26574":113348,"_2824":113667},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3337":68129,"_29196":68011,"_20242":113669,"_5":13829,"_26574":113348,"_2824":113670},[],"acceso completo y de solo lectura a KMS;",{"_3337":68130,"_29196":68011,"_20242":113672,"_5":13829,"_26574":113348,"_2824":113673},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3337":68131,"_29196":68011,"_20242":113675,"_5":13829,"_26574":113348,"_2824":113676},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3337":68132,"_29196":68011,"_20242":113678,"_5":13829,"_26574":113348,"_2824":113679},[],"acceso a la interfaz;",{"_3337":68133,"_29196":68011,"_20242":113681,"_5":13829,"_26574":113348,"_2824":113682},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3337":68134,"_29196":68011,"_20242":113684,"_5":13829,"_26574":113348,"_2824":113685},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3337":68135,"_29196":68011,"_20242":113687,"_5":13829,"_26574":113348,"_2824":113688},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3337":68136,"_29196":68011,"_20242":113690,"_5":13829,"_26574":113352,"_2824":113691},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3337":68137,"_29196":68011,"_20242":113693,"_5":13829,"_26574":113352,"_2824":113694},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3337":68138,"_29196":68011,"_20242":113696,"_5":13829,"_26574":113352,"_2824":113697},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3337":68139,"_29196":68011,"_20242":113699,"_5":13829,"_26574":113355,"_2824":113700},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3337":68140,"_29196":68011,"_20242":113702,"_5":13829,"_26574":113359,"_2824":113703},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3337":68141,"_29196":68011,"_20242":113705,"_5":13829,"_26574":113359,"_2824":113706},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3337":68142,"_29196":68011,"_20242":113708,"_5":13829,"_26574":113363,"_2824":113709},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3337":68143,"_29196":68011,"_20242":113711,"_5":13829,"_26574":113367,"_2824":113712},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3337":68144,"_29196":68011,"_20242":113714,"_5":13829,"_26574":113371,"_2824":113715},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3337":68145,"_29196":68011,"_20242":113717,"_5":13829,"_26574":113375,"_2824":113718},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3337":68146,"_29196":68011,"_20242":113720,"_5":13829,"_26574":113375,"_2824":113721},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3337":68147,"_29196":68011,"_20242":113723,"_5":13829,"_26574":113379,"_2824":113724},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3337":68148,"_29196":68011,"_20242":113726,"_5":13829,"_26574":113379,"_2824":113727},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3337":68149,"_29196":68011,"_20242":113729,"_5":13829,"_26574":113379,"_2824":113730},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3337":68150,"_29196":68011,"_20242":113732,"_5":13829,"_26574":113379,"_2824":113733},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3337":68151,"_29196":68011,"_20242":113735,"_5":13829,"_26574":113379,"_2824":113736},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3337":68152,"_29196":68011,"_20242":113738,"_5":13829,"_26574":113379,"_2824":113739},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3337":68153,"_29196":68011,"_20242":113741,"_5":13829,"_26574":113379,"_2824":113742},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3337":68154,"_29196":68011,"_20242":113744,"_5":13829,"_26574":113379,"_2824":113745},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3337":68155,"_29196":68011,"_20242":113747,"_5":13829,"_26574":113383,"_2824":113748},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3337":68156,"_29196":68011,"_20242":113750,"_5":13829,"_26574":113383,"_2824":113751},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3337":68157,"_29196":68011,"_20242":113753,"_5":13829,"_26574":113383,"_2824":113754},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3337":68158,"_29196":68011,"_20242":113756,"_5":13829,"_26574":113387,"_2824":113757},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3337":68159,"_29196":68011,"_20242":113759,"_5":13829,"_26574":113387,"_2824":113760},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3337":68160,"_29196":68011,"_20242":113762,"_5":13829,"_26574":113387,"_2824":113763},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3337":68161,"_29196":68011,"_20242":113765,"_5":13829,"_26574":113387,"_2824":113766},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3337":68162,"_29196":68011,"_20242":113768,"_5":13829,"_26574":113387,"_2824":113769},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3337":68163,"_29196":68011,"_20242":113771,"_5":13829,"_26574":113387,"_2824":113772},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3337":68164,"_29196":68011,"_20242":113774,"_5":13829,"_26574":113387,"_2824":113775},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3337":68165,"_29196":68011,"_20242":113777,"_5":13829,"_26574":113387,"_2824":113778},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3337":68166,"_29196":68011,"_20242":113780,"_5":13829,"_26574":113395,"_2824":113781},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3337":68167,"_29196":68011,"_20242":113783,"_5":13829,"_26574":113399,"_2824":113784},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3337":68168,"_29196":68011,"_20242":113786,"_5":13829,"_26574":113399,"_2824":113787},[],"que exista un principal activo del tipo correcto;",{"_3337":68169,"_29196":68011,"_20242":113789,"_5":13829,"_26574":113399,"_2824":113790},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3337":68170,"_29196":68011,"_20242":113792,"_5":13829,"_26574":113399,"_2824":113793},[],"que todas las condiciones del principal se cumplan;",{"_3337":68171,"_29196":68011,"_20242":113795,"_5":13829,"_26574":113399,"_2824":113796},[],"que el principal tenga concedida la política esperada;",{"_3337":68172,"_29196":68011,"_20242":113798,"_5":13829,"_26574":113399,"_2824":113799},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3337":68173,"_29196":68011,"_20242":113801,"_5":13829,"_26574":113399,"_2824":113802},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3337":68174,"_29196":68011,"_20242":113804,"_5":13829,"_26574":113399,"_2824":113805},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_3337":68175,"_29196":68011,"_20242":113807,"_5":13829,"_26574":113403,"_2824":113808},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3337":68176,"_29196":68011,"_20242":113810,"_5":13829,"_26574":113407,"_2824":113811},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3337":68177,"_29196":68011,"_20242":113813,"_5":13829,"_26574":113411,"_2824":113814},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3337":68178,"_29196":68011,"_20242":113816,"_5":13829,"_26574":113411,"_2824":113817},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3337":68179,"_29196":68179,"_5":14181,"_2824":113819,"_29540":113820,"_20242":113821,"_26574":68179},"Alertas y suscripciones",[47528,113284,113285],[],{"_3337":68180,"_29196":68179,"_20242":113823,"_5":13829,"_26574":68179,"_2824":113824},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3337":68181,"_29196":68179,"_5":29537,"_20242":113826,"_26574":113827,"_2824":113828},[],"/docs/pr-preview/pr-57/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3337":68182,"_29196":68179,"_5":29537,"_20242":113830,"_26574":113831,"_2824":113832},[],"/docs/pr-preview/pr-57/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3337":68183,"_29196":68179,"_5":29537,"_20242":113834,"_26574":113835,"_2824":113836},[],"/docs/pr-preview/pr-57/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3337":68184,"_29196":68179,"_5":29537,"_20242":113838,"_26574":113839,"_2824":113840},[],"/docs/pr-preview/pr-57/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3337":68185,"_29196":68179,"_5":29537,"_20242":113842,"_26574":113843,"_2824":113844},[],"/docs/pr-preview/pr-57/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3337":68186,"_29196":68179,"_5":29537,"_20242":113846,"_26574":113847,"_2824":113848},[],"/docs/pr-preview/pr-57/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3337":68187,"_29196":68179,"_5":29537,"_20242":113850,"_26574":113851,"_2824":113852},[],"/docs/pr-preview/pr-57/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3337":68188,"_29196":68179,"_5":29537,"_20242":113854,"_26574":113855,"_2824":113856},[],"/docs/pr-preview/pr-57/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3337":68189,"_29196":68179,"_5":29537,"_20242":113858,"_26574":113859,"_2824":113860},[],"/docs/pr-preview/pr-57/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3337":68190,"_29196":68179,"_5":29537,"_20242":113862,"_26574":113863,"_2824":113864},[],"/docs/pr-preview/pr-57/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3337":68191,"_29196":68179,"_5":29537,"_20242":113866,"_26574":113867,"_2824":113868},[],"/docs/pr-preview/pr-57/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3337":68192,"_29196":68179,"_20242":113870,"_5":13829,"_26574":68179,"_2824":113871},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3337":68193,"_29196":68179,"_20242":113873,"_5":13829,"_26574":113827,"_2824":113874},[],"Un servicio publica un evento de dominio.",{"_3337":68194,"_29196":68179,"_20242":113876,"_5":13829,"_26574":113827,"_2824":113877},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3337":68195,"_29196":68179,"_20242":113879,"_5":13829,"_26574":113827,"_2824":113880},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3337":68196,"_29196":68179,"_20242":113882,"_5":13829,"_26574":113827,"_2824":113883},[],"Lamassu entrega el evento al canal configurado.",{"_3337":68197,"_29196":68179,"_20242":113885,"_5":13829,"_26574":113827,"_2824":113886},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3337":68198,"_29196":68179,"_20242":113888,"_5":13829,"_26574":113831,"_2824":113889},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3337":68199,"_29196":68179,"_20242":113891,"_5":13829,"_26574":113831,"_2824":113892},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3337":68200,"_29196":68179,"_20242":113894,"_5":13829,"_26574":113831,"_2824":113895},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3337":68201,"_29196":68179,"_20242":113897,"_5":13829,"_26574":113831,"_2824":113898},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3337":68202,"_29196":68179,"_20242":113900,"_5":13829,"_26574":113831,"_2824":113901},[],"`apikey_options` necesita `header` y `key`.",{"_3337":68203,"_29196":68179,"_20242":113903,"_5":13829,"_26574":113831,"_2824":113904},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3337":68204,"_29196":68179,"_20242":113906,"_5":13829,"_26574":113831,"_2824":113907},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3337":68205,"_29196":68179,"_20242":113909,"_5":13829,"_26574":113831,"_2824":113910},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3337":68206,"_29196":68179,"_20242":113912,"_5":13829,"_26574":113839,"_2824":113913},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3337":68207,"_29196":68179,"_20242":113915,"_5":13829,"_26574":113843,"_2824":113916},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3337":68208,"_29196":68179,"_20242":113918,"_5":13829,"_26574":113847,"_2824":113919},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3337":68209,"_29196":68179,"_20242":113921,"_5":13829,"_26574":113847,"_2824":113922},[],"**None** notifica todas las instancias del evento.",{"_3337":68210,"_29196":68179,"_20242":113924,"_5":13829,"_26574":113847,"_2824":113925},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3337":68211,"_29196":68179,"_20242":113927,"_5":13829,"_26574":113847,"_2824":113928},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3337":68212,"_29196":68179,"_20242":113930,"_5":13829,"_26574":113847,"_2824":113931},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3337":68213,"_29196":68179,"_20242":113933,"_5":13829,"_26574":113847,"_2824":113934},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3337":68214,"_29196":68179,"_20242":113936,"_5":13829,"_26574":113851,"_2824":113937},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3337":68215,"_29196":68179,"_20242":113939,"_5":13829,"_26574":113855,"_2824":113940},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3337":68216,"_29196":68179,"_20242":113942,"_5":13829,"_26574":113855,"_2824":113943},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3337":68217,"_29196":68179,"_20242":113945,"_5":13829,"_26574":113855,"_2824":113946},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3337":68218,"_29196":68179,"_20242":113948,"_5":13829,"_26574":113855,"_2824":113949},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3337":68219,"_29196":68179,"_20242":113951,"_5":13829,"_26574":113855,"_2824":113952},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3337":68220,"_29196":68179,"_20242":113954,"_5":13829,"_26574":113855,"_2824":113955},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3337":68221,"_29196":68179,"_20242":113957,"_5":13829,"_26574":113855,"_2824":113958},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3337":68222,"_29196":68179,"_20242":113960,"_5":13829,"_26574":113855,"_2824":113961},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3337":68223,"_29196":68179,"_20242":113963,"_5":13829,"_26574":113859,"_2824":113964},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3337":68224,"_29196":68179,"_20242":113966,"_5":13829,"_26574":113859,"_2824":113967},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3337":68225,"_29196":68179,"_20242":113969,"_5":13829,"_26574":113859,"_2824":113970},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3337":68226,"_29196":68179,"_20242":113972,"_5":13829,"_26574":113859,"_2824":113973},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3337":68227,"_29196":68179,"_20242":113975,"_5":13829,"_26574":113859,"_2824":113976},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3337":68228,"_29196":68179,"_20242":113978,"_5":13829,"_26574":113859,"_2824":113979},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3337":68229,"_29196":68179,"_20242":113981,"_5":13829,"_26574":113859,"_2824":113982},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3337":68230,"_29196":68179,"_20242":113984,"_5":13829,"_26574":113859,"_2824":113985},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3337":68231,"_29196":68179,"_20242":113987,"_5":13829,"_26574":113863,"_2824":113988},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3337":68232,"_29196":68179,"_20242":113990,"_5":13829,"_26574":113863,"_2824":113991},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3337":68233,"_29196":68179,"_20242":113993,"_5":13829,"_26574":113867,"_2824":113994},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3337":68234,"_29196":68179,"_20242":113996,"_5":13829,"_26574":113867,"_2824":113997},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3337":68235,"_29196":68179,"_20242":113999,"_5":13829,"_26574":113867,"_2824":114000},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3337":68236,"_29196":68179,"_20242":114002,"_5":13829,"_26574":113867,"_2824":114003},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3337":68237,"_29196":68179,"_20242":114005,"_5":13829,"_26574":113867,"_2824":114006},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3337":68238,"_29196":68179,"_20242":114008,"_5":13829,"_26574":113867,"_2824":114009},[],"**Validación:** `va.role.crl.create`.",{"_3337":68239,"_29196":68179,"_20242":114011,"_5":13829,"_26574":113867,"_2824":114012},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3337":68240,"_29196":68179,"_20242":114014,"_5":13829,"_26574":113867,"_2824":114015},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3337":68241,"_29196":68241,"_5":14181,"_2824":114017,"_29540":114018,"_20242":114019,"_26574":68241},"Registros de auditoría",[47528,113284,113285],[],{"_3337":68242,"_29196":68241,"_20242":114021,"_5":13829,"_26574":68241,"_2824":114022},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3337":68243,"_29196":68241,"_5":29537,"_20242":114024,"_26574":114025,"_2824":114026},[],"/docs/pr-preview/pr-57/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3337":68244,"_29196":68241,"_5":29537,"_20242":114028,"_26574":114029,"_2824":114030},[],"/docs/pr-preview/pr-57/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3337":68245,"_29196":68241,"_5":29537,"_20242":114032,"_26574":114033,"_2824":114034},[],"/docs/pr-preview/pr-57/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3337":68246,"_29196":68241,"_5":29537,"_20242":114036,"_26574":114037,"_2824":114038},[],"/docs/pr-preview/pr-57/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3337":68247,"_29196":68241,"_5":29537,"_20242":114040,"_26574":114041,"_2824":114042},[],"/docs/pr-preview/pr-57/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3337":68248,"_29196":68241,"_5":29537,"_20242":114044,"_26574":114045,"_2824":114046},[],"/docs/pr-preview/pr-57/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3337":68249,"_29196":68241,"_5":29537,"_20242":114048,"_26574":114049,"_2824":114050},[],"/docs/pr-preview/pr-57/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3337":68250,"_29196":68241,"_5":29537,"_20242":114052,"_26574":114053,"_2824":114054},[],"/docs/pr-preview/pr-57/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3337":68251,"_29196":68241,"_5":29537,"_20242":114056,"_26574":114057,"_2824":114058},[],"/docs/pr-preview/pr-57/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3337":68252,"_29196":68241,"_5":29537,"_20242":114060,"_26574":114061,"_2824":114062},[],"/docs/pr-preview/pr-57/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3337":68253,"_29196":68241,"_5":29537,"_20242":114064,"_26574":114065,"_2824":114066},[],"/docs/pr-preview/pr-57/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3337":68254,"_29196":68241,"_20242":114068,"_5":13829,"_26574":68241,"_2824":114069},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3337":68255,"_29196":68241,"_20242":114071,"_5":13829,"_26574":114025,"_2824":114072},[],"El cuerpo de auditoría incluye:",{"_3337":68256,"_29196":68241,"_20242":114074,"_5":13829,"_26574":114025,"_2824":114075},[],"input: datos recibidos por la operación;",{"_3337":68257,"_29196":68241,"_20242":114077,"_5":13829,"_26574":114025,"_2824":114078},[],"has\\_error: indica si el servicio devolvió un error;",{"_3337":68258,"_29196":68241,"_20242":114080,"_5":13829,"_26574":114025,"_2824":114081},[],"output: resultado producido o mensaje de error;",{"_3337":68259,"_29196":68241,"_20242":114083,"_5":13829,"_26574":114025,"_2824":114084},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3337":68260,"_29196":68241,"_20242":114086,"_5":13829,"_26574":114025,"_2824":114087},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3337":68261,"_29196":68241,"_20242":114089,"_5":13829,"_26574":114025,"_2824":114090},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3337":68262,"_29196":68241,"_20242":114092,"_5":13829,"_26574":114029,"_2824":114093},[],"El backend aplica auditoría a mutaciones de:",{"_3337":68263,"_29196":68241,"_20242":114095,"_5":13829,"_26574":114029,"_2824":114096},[],"autoridades, certificados y perfiles de emisión;",{"_3337":68264,"_29196":68241,"_20242":114098,"_5":13829,"_26574":114029,"_2824":114099},[],"claves y motores KMS;",{"_3337":68265,"_29196":68241,"_20242":114101,"_5":13829,"_26574":114029,"_2824":114102},[],"dispositivos e identidades;",{"_3337":68266,"_29196":68241,"_20242":114104,"_5":13829,"_26574":114029,"_2824":114105},[],"DMS y operaciones de enrolamiento;",{"_3337":68267,"_29196":68241,"_20242":114107,"_5":13829,"_26574":114029,"_2824":114108},[],"funciones de validación y CRL;",{"_3337":68268,"_29196":68241,"_20242":114110,"_5":13829,"_26574":114029,"_2824":114111},[],"principales, políticas y concesiones de autorización.",{"_3337":68269,"_29196":68241,"_20242":114113,"_5":13829,"_26574":114029,"_2824":114114},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3337":68270,"_29196":68241,"_20242":114116,"_5":13829,"_26574":114033,"_2824":114117},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3337":68271,"_29196":68241,"_20242":114119,"_5":13829,"_26574":114033,"_2824":114120},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3337":68272,"_29196":68241,"_20242":114122,"_5":13829,"_26574":114033,"_2824":114123},[],"Diseña el consumidor para:",{"_3337":68273,"_29196":68241,"_20242":114125,"_5":13829,"_26574":114033,"_2824":114126},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3337":68274,"_29196":68241,"_20242":114128,"_5":13829,"_26574":114033,"_2824":114129},[],"conservar el CloudEvent completo sin modificar;",{"_3337":68275,"_29196":68241,"_20242":114131,"_5":13829,"_26574":114033,"_2824":114132},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3337":68276,"_29196":68241,"_20242":114134,"_5":13829,"_26574":114033,"_2824":114135},[],"cifrar en tránsito y en reposo;",{"_3337":68277,"_29196":68241,"_20242":114137,"_5":13829,"_26574":114033,"_2824":114138},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3337":68278,"_29196":68241,"_20242":114140,"_5":13829,"_26574":114033,"_2824":114141},[],"aplicar una política explícita de retención y legal hold;",{"_3337":68279,"_29196":68241,"_20242":114143,"_5":13829,"_26574":114033,"_2824":114144},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3337":68280,"_29196":68241,"_20242":114146,"_5":13829,"_26574":114037,"_2824":114147},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3337":68281,"_29196":68241,"_20242":114149,"_5":13829,"_26574":114037,"_2824":114150},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3337":68282,"_29196":68241,"_20242":114152,"_5":13829,"_26574":114045,"_2824":114153},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3337":68283,"_29196":68241,"_20242":114155,"_5":13829,"_26574":114049,"_2824":114156},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3337":68284,"_29196":68241,"_20242":114158,"_5":13829,"_26574":114053,"_2824":114159},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3337":68285,"_29196":68241,"_20242":114161,"_5":13829,"_26574":114057,"_2824":114162},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3337":68286,"_29196":68241,"_20242":114164,"_5":13829,"_26574":114061,"_2824":114165},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3337":68287,"_29196":68241,"_20242":114167,"_5":13829,"_26574":114065,"_2824":114168},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3337":68288,"_29196":68241,"_20242":114170,"_5":13829,"_26574":114065,"_2824":114171},[],"aparece un evento de auditoría correcto;",{"_3337":68289,"_29196":68241,"_20242":114173,"_5":13829,"_26574":114065,"_2824":114174},[],"el principal coincide con la identidad utilizada;",{"_3337":68290,"_29196":68241,"_20242":114176,"_5":13829,"_26574":114065,"_2824":114177},[],"el consumidor lo persiste una sola vez;",{"_3337":68291,"_29196":68241,"_20242":114179,"_5":13829,"_26574":114065,"_2824":114180},[],"puede recuperarse por recurso, actor y periodo;",{"_3337":68292,"_29196":68241,"_20242":114182,"_5":13829,"_26574":114065,"_2824":114183},[],"una interrupción del consumidor produce una alerta.",{"_3337":68293,"_29196":68241,"_20242":114185,"_5":13829,"_26574":114065,"_2824":114186},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3337":68294,"_29196":68294,"_5":14181,"_2824":114188,"_29540":114189,"_20242":114190,"_26574":68294},"Arquitectura de la plataforma",[47528,113284],[],{"_3337":68295,"_29196":68294,"_20242":114192,"_5":13829,"_26574":68294,"_2824":114193},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3337":68296,"_29196":68294,"_5":29537,"_20242":114195,"_26574":114196,"_2824":114197},[],"/docs/pr-preview/pr-57/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3337":68297,"_29196":68294,"_5":29537,"_20242":114199,"_26574":114200,"_2824":114201},[],"/docs/pr-preview/pr-57/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3337":68298,"_29196":68294,"_5":29537,"_20242":114203,"_26574":114204,"_2824":114205},[],"/docs/pr-preview/pr-57/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3337":68299,"_29196":68294,"_5":29537,"_20242":114207,"_26574":114208,"_2824":114209},[],"/docs/pr-preview/pr-57/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3337":68300,"_29196":68294,"_5":29537,"_20242":114211,"_26574":114212,"_2824":114213},[],"/docs/pr-preview/pr-57/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3337":68301,"_29196":68294,"_20242":114215,"_5":13829,"_26574":68294,"_2824":114216},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3337":68302,"_29196":68294,"_20242":114218,"_5":13829,"_26574":68294,"_2824":114219},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3337":68303,"_29196":68294,"_20242":114221,"_5":13829,"_26574":114196,"_2824":114222},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3337":68304,"_29196":68294,"_20242":114224,"_5":13829,"_26574":114200,"_2824":114225},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3337":68305,"_29196":68294,"_20242":114227,"_5":13829,"_26574":114204,"_2824":114228},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3337":68306,"_29196":68294,"_20242":114230,"_5":13829,"_26574":114208,"_2824":114231},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3337":68307,"_29196":68294,"_20242":114233,"_5":13829,"_26574":114212,"_2824":114234},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3337":68308,"_29196":68308,"_5":14181,"_2824":114236,"_29540":114237,"_20242":114238,"_26574":68308},"Cómo funciona Lamassu",[47528,113284],[],{"_3337":68309,"_29196":68308,"_20242":114240,"_5":13829,"_26574":68308,"_2824":114241},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3337":68310,"_29196":68308,"_5":29537,"_20242":114243,"_26574":114244,"_2824":114245},[],"/docs/pr-preview/pr-57/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3337":68311,"_29196":68308,"_5":29537,"_20242":114247,"_26574":114248,"_2824":114249},[],"/docs/pr-preview/pr-57/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3337":68312,"_29196":68308,"_20242":114251,"_5":13829,"_26574":68308,"_2824":114252},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3337":68313,"_29196":68308,"_20242":114254,"_5":13829,"_26574":114244,"_2824":114255},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3337":68314,"_29196":68308,"_20242":114257,"_5":13829,"_26574":114244,"_2824":114258},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3337":68315,"_29196":68308,"_20242":114260,"_5":13829,"_26574":114244,"_2824":114261},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3337":68316,"_29196":68308,"_20242":114263,"_5":13829,"_26574":114244,"_2824":114264},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3337":68317,"_29196":68308,"_20242":114266,"_5":13829,"_26574":114244,"_2824":114267},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3337":68318,"_29196":68308,"_20242":114269,"_5":13829,"_26574":114248,"_2824":114270},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3337":68319,"_29196":68308,"_20242":114272,"_5":13829,"_26574":114248,"_2824":114273},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3337":68320,"_29196":68308,"_20242":114275,"_5":13829,"_26574":114248,"_2824":114276},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3337":68321,"_29196":68308,"_20242":114278,"_5":13829,"_26574":114248,"_2824":114279},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3337":68322,"_29196":68308,"_20242":114281,"_5":13829,"_26574":114248,"_2824":114282},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3337":68323,"_29196":68308,"_20242":114284,"_5":13829,"_26574":114248,"_2824":114285},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3337":68324,"_29196":68308,"_20242":114287,"_5":13829,"_26574":114248,"_2824":114288},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3337":68325,"_29196":68325,"_5":14181,"_2824":114290,"_29540":114291,"_20242":114292,"_26574":68325},"Dispositivos e identidades",[47528,113284,49985,114290],[],{"_3337":68326,"_29196":68325,"_20242":114294,"_5":13829,"_26574":68325,"_2824":114295},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3337":68327,"_29196":68325,"_5":29537,"_20242":114297,"_26574":114298,"_2824":114299},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3337":68328,"_29196":68325,"_5":29537,"_20242":114301,"_26574":114302,"_2824":114303},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3337":68329,"_29196":68325,"_5":29537,"_20242":114305,"_26574":114306,"_2824":114307},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3337":68330,"_29196":68325,"_5":29537,"_20242":114309,"_26574":114310,"_2824":114311},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3337":68331,"_29196":68325,"_5":29537,"_20242":114313,"_26574":114314,"_2824":114315},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3337":68332,"_29196":68325,"_5":29537,"_20242":114317,"_26574":114318,"_2824":114319},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3337":68333,"_29196":68325,"_5":29537,"_20242":114321,"_26574":114322,"_2824":114323},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3337":68334,"_29196":68325,"_5":29537,"_20242":114325,"_26574":114326,"_2824":114327},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3337":68335,"_29196":68325,"_5":29537,"_20242":114329,"_26574":114330,"_2824":114331},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3337":68336,"_29196":68325,"_5":29537,"_20242":114333,"_26574":114334,"_2824":114335},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3337":68337,"_29196":68325,"_5":29537,"_20242":114337,"_26574":114338,"_2824":114339},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3337":68338,"_29196":68325,"_20242":114341,"_5":13829,"_26574":68325,"_2824":114342},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3337":68339,"_29196":68325,"_20242":114344,"_5":13829,"_26574":68325,"_2824":114345},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3337":68340,"_29196":68325,"_20242":114347,"_5":13829,"_26574":114298,"_2824":114348},[],"Vista operativa",{"_3337":68341,"_29196":68325,"_20242":114350,"_5":13829,"_26574":114298,"_2824":114351},[],"Interpretación",{"_3337":68342,"_29196":68325,"_20242":114353,"_5":13829,"_26574":114298,"_2824":50048},[],{"_3337":68343,"_29196":68325,"_20242":114355,"_5":13829,"_26574":114298,"_2824":114356},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3337":68344,"_29196":68325,"_20242":114358,"_5":13829,"_26574":114298,"_2824":50054},[],{"_3337":68345,"_29196":68325,"_20242":114360,"_5":13829,"_26574":114298,"_2824":114361},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3337":68346,"_29196":68325,"_20242":114363,"_5":13829,"_26574":114298,"_2824":50060},[],{"_3337":68347,"_29196":68325,"_20242":114365,"_5":13829,"_26574":114298,"_2824":114366},[],"La identidad está en la ventana operativa de renovación.",{"_3337":68348,"_29196":68325,"_20242":114368,"_5":13829,"_26574":114298,"_2824":50066},[],{"_3337":68349,"_29196":68325,"_20242":114370,"_5":13829,"_26574":114298,"_2824":114371},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3337":68350,"_29196":68325,"_20242":114373,"_5":13829,"_26574":114298,"_2824":50072},[],{"_3337":68351,"_29196":68325,"_20242":114375,"_5":13829,"_26574":114298,"_2824":114376},[],"La identidad ha vencido.",{"_3337":68352,"_29196":68325,"_20242":114378,"_5":13829,"_26574":114298,"_2824":50078},[],{"_3337":68353,"_29196":68325,"_20242":114380,"_5":13829,"_26574":114298,"_2824":114381},[],"La identidad está marcada como revocada.",{"_3337":68354,"_29196":68325,"_20242":114383,"_5":13829,"_26574":114298,"_2824":50084},[],{"_3337":68355,"_29196":68325,"_20242":114385,"_5":13829,"_26574":114298,"_2824":114386},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3337":68356,"_29196":68325,"_20242":114388,"_5":13829,"_26574":114298,"_2824":114389},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3337":68357,"_29196":68325,"_20242":114391,"_5":13829,"_26574":114302,"_2824":114392},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3337":68358,"_29196":68325,"_20242":114394,"_5":13829,"_26574":114302,"_2824":114395},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3337":68359,"_29196":68325,"_20242":114397,"_5":13829,"_26574":114302,"_2824":114398},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3337":68360,"_29196":68325,"_20242":114400,"_5":13829,"_26574":114302,"_2824":114401},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3337":68361,"_29196":68325,"_20242":114403,"_5":13829,"_26574":114306,"_2824":114404},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3337":68362,"_29196":68325,"_20242":114406,"_5":13829,"_26574":114310,"_2824":114407},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3337":68363,"_29196":68325,"_20242":114409,"_5":13829,"_26574":114314,"_2824":114410},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3337":68364,"_29196":68325,"_20242":114412,"_5":13829,"_26574":114318,"_2824":114413},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3337":68365,"_29196":68325,"_20242":114415,"_5":13829,"_26574":114322,"_2824":114416},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3337":68366,"_29196":68325,"_20242":114418,"_5":13829,"_26574":114322,"_2824":114419},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3337":68367,"_29196":68325,"_20242":114421,"_5":13829,"_26574":114326,"_2824":114422},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3337":68368,"_29196":68325,"_20242":114424,"_5":13829,"_26574":114326,"_2824":114425},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3337":68369,"_29196":68325,"_20242":114427,"_5":13829,"_26574":114326,"_2824":114428},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3337":68370,"_29196":68325,"_20242":114430,"_5":13829,"_26574":114326,"_2824":114431},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3337":68371,"_29196":68325,"_20242":114433,"_5":13829,"_26574":114326,"_2824":114434},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3337":68372,"_29196":68325,"_20242":114436,"_5":13829,"_26574":114326,"_2824":114437},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3337":68373,"_29196":68325,"_20242":114439,"_5":13829,"_26574":114330,"_2824":114440},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3337":68374,"_29196":68325,"_20242":114442,"_5":13829,"_26574":114330,"_2824":114443},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3337":68375,"_29196":68325,"_20242":114445,"_5":13829,"_26574":114334,"_2824":114446},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3337":68376,"_29196":68325,"_20242":114448,"_5":13829,"_26574":114334,"_2824":114449},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3337":68377,"_29196":68325,"_20242":114451,"_5":13829,"_26574":114334,"_2824":114452},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3337":68378,"_29196":68325,"_20242":114454,"_5":13829,"_26574":114334,"_2824":114455},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3337":68379,"_29196":68325,"_20242":114457,"_5":13829,"_26574":114338,"_2824":114458},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3337":68380,"_29196":68325,"_20242":114460,"_5":13829,"_26574":114338,"_2824":114461},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3337":68381,"_29196":68381,"_5":14181,"_2824":114463,"_29540":114464,"_20242":114466,"_26574":68381},"Identidad inicial y autenticación",[47528,113284,49985,114290,114465],"Enrolamiento con PKI",[],{"_3337":68382,"_29196":68381,"_20242":114468,"_5":13829,"_26574":68381,"_2824":114469},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3337":68383,"_29196":68381,"_5":29537,"_20242":114471,"_26574":114472,"_2824":114473},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3337":68384,"_29196":68381,"_5":29537,"_20242":114475,"_26574":114476,"_2824":114477},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3337":68385,"_29196":68381,"_5":29537,"_20242":114479,"_26574":114480,"_2824":114481},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3337":68386,"_29196":68381,"_5":29537,"_20242":114483,"_26574":114484,"_2824":114485},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3337":68387,"_29196":68381,"_5":29537,"_20242":114487,"_26574":114488,"_2824":114489},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3337":68388,"_29196":68381,"_20242":114491,"_5":13829,"_26574":68381,"_2824":114492},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3337":68389,"_29196":68381,"_20242":114494,"_5":13829,"_26574":114472,"_2824":114495},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3337":68390,"_29196":68381,"_20242":114497,"_5":13829,"_26574":114472,"_2824":114498},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3337":68391,"_29196":68381,"_20242":114500,"_5":13829,"_26574":114476,"_2824":114501},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3337":68392,"_29196":68381,"_20242":114503,"_5":13829,"_26574":114476,"_2824":114504},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3337":68393,"_29196":68381,"_20242":114506,"_5":13829,"_26574":114476,"_2824":114507},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3337":68394,"_29196":68381,"_20242":114509,"_5":13829,"_26574":114480,"_2824":114510},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3337":68395,"_29196":68381,"_20242":114512,"_5":13829,"_26574":114480,"_2824":114513},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3337":68396,"_29196":68381,"_20242":114515,"_5":13829,"_26574":114484,"_2824":114516},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3337":68397,"_29196":68381,"_20242":114518,"_5":13829,"_26574":114484,"_2824":114519},[],"Ejemplo de cuerpo:",{"_3337":68398,"_29196":68381,"_20242":114521,"_5":13829,"_26574":114484,"_2824":114522},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3337":68399,"_29196":68381,"_20242":114524,"_5":13829,"_26574":114484,"_2824":114525},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3337":68400,"_29196":68381,"_20242":114527,"_5":13829,"_26574":114484,"_2824":114528},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3337":68401,"_29196":68381,"_20242":114530,"_5":13829,"_26574":114484,"_2824":114531},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3337":68402,"_29196":68381,"_20242":114533,"_5":13829,"_26574":114488,"_2824":114534},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3337":68403,"_29196":68381,"_20242":114536,"_5":13829,"_26574":114488,"_2824":114537},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3337":68404,"_29196":68404,"_5":14181,"_2824":114539,"_29540":114540,"_20242":114541,"_26574":68404},"Configura y opera el DMS",[47528,113284,49985,114290,114465],[],{"_3337":68405,"_29196":68404,"_20242":114543,"_5":13829,"_26574":68404,"_2824":114544},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3337":68406,"_29196":68404,"_5":29537,"_20242":114546,"_26574":114547,"_2824":111881},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3337":68407,"_29196":68404,"_5":29537,"_20242":114549,"_26574":114550,"_2824":114551},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3337":68408,"_29196":68404,"_5":29537,"_20242":114553,"_26574":114554,"_2824":114555},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3337":68409,"_29196":68404,"_5":29537,"_20242":114557,"_26574":114558,"_2824":114559},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3337":68410,"_29196":68404,"_5":29537,"_20242":114561,"_26574":114562,"_2824":114563},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3337":68411,"_29196":68404,"_5":29537,"_20242":114565,"_26574":114566,"_2824":114567},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3337":68412,"_29196":68404,"_5":29537,"_20242":114569,"_26574":114570,"_2824":114571},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3337":68413,"_29196":68404,"_5":29537,"_20242":114573,"_26574":114574,"_2824":114575},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3337":68414,"_29196":68404,"_5":29537,"_20242":114577,"_26574":114578,"_2824":50280},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3337":68415,"_29196":68404,"_5":29537,"_20242":114580,"_26574":114581,"_2824":50284},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3337":68416,"_29196":68404,"_5":29537,"_20242":114583,"_26574":114584,"_2824":114585},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3337":68417,"_29196":68404,"_5":29537,"_20242":114587,"_26574":114588,"_2824":114589},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3337":68418,"_29196":68404,"_5":29537,"_20242":114591,"_26574":114592,"_2824":114593},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3337":68419,"_29196":68404,"_5":29537,"_20242":114595,"_26574":114596,"_2824":114597},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3337":68420,"_29196":68404,"_5":29537,"_20242":114599,"_26574":114600,"_2824":50304},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3337":68421,"_29196":68404,"_5":29537,"_20242":114602,"_26574":114603,"_2824":114604},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3337":68422,"_29196":68404,"_5":29537,"_20242":114606,"_26574":114607,"_2824":114608},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3337":68423,"_29196":68404,"_5":29537,"_20242":114610,"_26574":114611,"_2824":114612},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3337":68424,"_29196":68404,"_20242":114614,"_5":13829,"_26574":68404,"_2824":114615},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3337":68425,"_29196":68404,"_20242":114617,"_5":13829,"_26574":114547,"_2824":114618},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3337":68426,"_29196":68404,"_20242":114620,"_5":13829,"_26574":114547,"_2824":114621},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3337":68427,"_29196":68404,"_20242":114623,"_5":13829,"_26574":114554,"_2824":114624},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3337":68428,"_29196":68404,"_20242":114626,"_5":13829,"_26574":114558,"_2824":114627},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3337":68429,"_29196":68404,"_20242":114629,"_5":13829,"_26574":114562,"_2824":114630},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3337":68430,"_29196":68404,"_20242":114632,"_5":13829,"_26574":114566,"_2824":114633},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3337":68431,"_29196":68404,"_20242":114635,"_5":13829,"_26574":114570,"_2824":114636},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3337":68432,"_29196":68404,"_20242":114638,"_5":13829,"_26574":114578,"_2824":114639},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3337":68433,"_29196":68404,"_20242":114641,"_5":13829,"_26574":114578,"_2824":114642},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3337":68434,"_29196":68404,"_20242":114644,"_5":13829,"_26574":114581,"_2824":114645},[],"Campo de `settings.enrollment_settings`",{"_3337":68435,"_29196":68404,"_20242":114647,"_5":13829,"_26574":114581,"_2824":114648},[],"Decisión",{"_3337":68436,"_29196":68404,"_20242":114650,"_5":13829,"_26574":114581,"_2824":50355},[],{"_3337":68437,"_29196":68404,"_20242":114652,"_5":13829,"_26574":114581,"_2824":114653},[],"`EST_RFC7030` para estas operaciones.",{"_3337":68438,"_29196":68404,"_20242":114655,"_5":13829,"_26574":114581,"_2824":50361},[],{"_3337":68439,"_29196":68404,"_20242":114657,"_5":13829,"_26574":114581,"_2824":114658},[],"ID de la CA que firmará.",{"_3337":68440,"_29196":68404,"_20242":114660,"_5":13829,"_26574":114581,"_2824":50367},[],{"_3337":68441,"_29196":68404,"_20242":114662,"_5":13829,"_26574":114581,"_2824":114663},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3337":68442,"_29196":68404,"_20242":114665,"_5":13829,"_26574":114581,"_2824":50373},[],{"_3337":68443,"_29196":68404,"_20242":114667,"_5":13829,"_26574":114581,"_2824":114668},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3337":68444,"_29196":68404,"_20242":114670,"_5":13829,"_26574":114581,"_2824":50379},[],{"_3337":68445,"_29196":68404,"_20242":114672,"_5":13829,"_26574":114581,"_2824":114673},[],"Uno de los cuatro modos de autenticación.",{"_3337":68446,"_29196":68404,"_20242":114675,"_5":13829,"_26574":114581,"_2824":114676},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3337":68447,"_29196":68404,"_20242":114678,"_5":13829,"_26574":114584,"_2824":114679},[],"Los bloques son independientes:",{"_3337":68448,"_29196":68404,"_20242":114681,"_5":13829,"_26574":114584,"_2824":114682},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3337":68449,"_29196":68404,"_20242":114684,"_5":13829,"_26574":114584,"_2824":114685},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3337":68450,"_29196":68404,"_20242":114687,"_5":13829,"_26574":114584,"_2824":50397},[],{"_3337":68451,"_29196":68404,"_20242":114689,"_5":13829,"_26574":114584,"_2824":114690},[],"Control aplicado en la operación configurada",{"_3337":68452,"_29196":68404,"_20242":114692,"_5":13829,"_26574":114584,"_2824":50403},[],{"_3337":68453,"_29196":68404,"_20242":114694,"_5":13829,"_26574":114584,"_2824":114695},[],"Validación del certificado presentado.",{"_3337":68454,"_29196":68404,"_20242":114697,"_5":13829,"_26574":114584,"_2824":50409},[],{"_3337":68455,"_29196":68404,"_20242":114699,"_5":13829,"_26574":114584,"_2824":114700},[],"Autorización del webhook configurado.",{"_3337":68456,"_29196":68404,"_20242":114702,"_5":13829,"_26574":114584,"_2824":50415},[],{"_3337":68457,"_29196":68404,"_20242":114704,"_5":13829,"_26574":114584,"_2824":114705},[],"Validación del certificado y, después, aprobación del webhook.",{"_3337":68458,"_29196":68404,"_20242":114707,"_5":13829,"_26574":114584,"_2824":50421},[],{"_3337":68459,"_29196":68404,"_20242":114709,"_5":13829,"_26574":114584,"_2824":114710},[],"Sin autenticación del solicitante por el DMS.",{"_3337":68460,"_29196":68404,"_20242":114712,"_5":13829,"_26574":114584,"_2824":114713},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3337":68461,"_29196":68404,"_20242":114715,"_5":13829,"_26574":114584,"_2824":114716},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3337":68462,"_29196":68404,"_20242":114718,"_5":13829,"_26574":114584,"_2824":114719},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3337":68463,"_29196":68404,"_20242":114721,"_5":13829,"_26574":114584,"_2824":114722},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3337":68464,"_29196":68404,"_20242":114724,"_5":13829,"_26574":114588,"_2824":114725},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3337":68465,"_29196":68404,"_20242":114727,"_5":13829,"_26574":114588,"_2824":114728},[],"Campo de `external_webhook_settings`",{"_3337":68466,"_29196":68404,"_20242":114730,"_5":13829,"_26574":114588,"_2824":114648},[],{"_3337":68467,"_29196":68404,"_20242":114732,"_5":13829,"_26574":114588,"_2824":50447},[],{"_3337":68468,"_29196":68404,"_20242":114734,"_5":13829,"_26574":114588,"_2824":114735},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3337":68469,"_29196":68404,"_20242":114737,"_5":13829,"_26574":114588,"_2824":50453},[],{"_3337":68470,"_29196":68404,"_20242":114739,"_5":13829,"_26574":114588,"_2824":114740},[],"`POST` o `PUT`; `POST` por defecto.",{"_3337":68471,"_29196":68404,"_20242":114742,"_5":13829,"_26574":114588,"_2824":50459},[],{"_3337":68472,"_29196":68404,"_20242":114744,"_5":13829,"_26574":114588,"_2824":114745},[],"Etiqueta usada en los logs del servicio.",{"_3337":68473,"_29196":68404,"_20242":114747,"_5":13829,"_26574":114588,"_2824":50465},[],{"_3337":68474,"_29196":68404,"_20242":114749,"_5":13829,"_26574":114588,"_2824":114750},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3337":68475,"_29196":68404,"_20242":114752,"_5":13829,"_26574":114588,"_2824":50471},[],{"_3337":68476,"_29196":68404,"_20242":114754,"_5":13829,"_26574":114588,"_2824":114755},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3337":68477,"_29196":68404,"_20242":114757,"_5":13829,"_26574":114588,"_2824":50477},[],{"_3337":68478,"_29196":68404,"_20242":114759,"_5":13829,"_26574":114588,"_2824":114760},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3337":68479,"_29196":68404,"_20242":114762,"_5":13829,"_26574":114588,"_2824":50483},[],{"_3337":68480,"_29196":68404,"_20242":114764,"_5":13829,"_26574":114588,"_2824":114765},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3337":68481,"_29196":68404,"_20242":114767,"_5":13829,"_26574":114588,"_2824":50489},[],{"_3337":68482,"_29196":68404,"_20242":114769,"_5":13829,"_26574":114588,"_2824":114770},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3337":68483,"_29196":68404,"_20242":114772,"_5":13829,"_26574":114588,"_2824":50495},[],{"_3337":68484,"_29196":68404,"_20242":114774,"_5":13829,"_26574":114588,"_2824":114775},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3337":68485,"_29196":68404,"_20242":114777,"_5":13829,"_26574":114588,"_2824":50501},[],{"_3337":68486,"_29196":68404,"_20242":114779,"_5":13829,"_26574":114588,"_2824":114780},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3337":68487,"_29196":68404,"_20242":114782,"_5":13829,"_26574":114588,"_2824":114783},[],"Reglas de esa configuración:",{"_3337":68488,"_29196":68404,"_20242":114785,"_5":13829,"_26574":114588,"_2824":114786},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3337":68489,"_29196":68404,"_20242":114788,"_5":13829,"_26574":114588,"_2824":114789},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3337":68490,"_29196":68404,"_20242":114791,"_5":13829,"_26574":114588,"_2824":114792},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3337":68491,"_29196":68404,"_20242":114794,"_5":13829,"_26574":114588,"_2824":114795},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3337":68492,"_29196":68404,"_20242":114797,"_5":13829,"_26574":114588,"_2824":114798},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3337":68493,"_29196":68404,"_20242":114800,"_5":13829,"_26574":114588,"_2824":114801},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3337":68494,"_29196":68404,"_20242":114803,"_5":13829,"_26574":114588,"_2824":114804},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3337":68495,"_29196":68404,"_20242":114806,"_5":13829,"_26574":114588,"_2824":114807},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3337":68496,"_29196":68404,"_20242":114809,"_5":13829,"_26574":114588,"_2824":114810},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3337":68497,"_29196":68404,"_20242":114812,"_5":13829,"_26574":114592,"_2824":114813},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3337":68498,"_29196":68404,"_20242":114815,"_5":13829,"_26574":114596,"_2824":114816},[],"Campo de `settings.reenrollment_settings`",{"_3337":68499,"_29196":68404,"_20242":114818,"_5":13829,"_26574":114596,"_2824":114819},[],"Función",{"_3337":68500,"_29196":68404,"_20242":114821,"_5":13829,"_26574":114596,"_2824":50545},[],{"_3337":68501,"_29196":68404,"_20242":114823,"_5":13829,"_26574":114596,"_2824":114824},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3337":68502,"_29196":68404,"_20242":114826,"_5":13829,"_26574":114596,"_2824":50551},[],{"_3337":68503,"_29196":68404,"_20242":114828,"_5":13829,"_26574":114596,"_2824":114829},[],"Umbral operativo preventivo de monitorización.",{"_3337":68504,"_29196":68404,"_20242":114831,"_5":13829,"_26574":114596,"_2824":50557},[],{"_3337":68505,"_29196":68404,"_20242":114833,"_5":13829,"_26574":114596,"_2824":114834},[],"Umbral operativo crítico de monitorización.",{"_3337":68506,"_29196":68404,"_20242":114836,"_5":13829,"_26574":114596,"_2824":50563},[],{"_3337":68507,"_29196":68404,"_20242":114838,"_5":13829,"_26574":114596,"_2824":114839},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3337":68508,"_29196":68404,"_20242":114841,"_5":13829,"_26574":114596,"_2824":50569},[],{"_3337":68509,"_29196":68404,"_20242":114843,"_5":13829,"_26574":114596,"_2824":114844},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3337":68510,"_29196":68404,"_20242":114846,"_5":13829,"_26574":114596,"_2824":50575},[],{"_3337":68511,"_29196":68404,"_20242":114848,"_5":13829,"_26574":114596,"_2824":114849},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3337":68512,"_29196":68404,"_20242":114851,"_5":13829,"_26574":114596,"_2824":114852},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3337":68513,"_29196":68404,"_20242":114854,"_5":13829,"_26574":114600,"_2824":114855},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3337":68514,"_29196":68404,"_20242":114857,"_5":13829,"_26574":114603,"_2824":112245},[],{"_3337":68515,"_29196":68404,"_20242":114859,"_5":13829,"_26574":114603,"_2824":114860},[],"Qué publica",{"_3337":68516,"_29196":68404,"_20242":114862,"_5":13829,"_26574":114603,"_2824":50592},[],{"_3337":68517,"_29196":68404,"_20242":114864,"_5":13829,"_26574":114603,"_2824":114865},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3337":68518,"_29196":68404,"_20242":114867,"_5":13829,"_26574":114603,"_2824":50598},[],{"_3337":68519,"_29196":68404,"_20242":114869,"_5":13829,"_26574":114603,"_2824":114870},[],"Certificado de la CA emisora seleccionada.",{"_3337":68520,"_29196":68404,"_20242":114872,"_5":13829,"_26574":114603,"_2824":50604},[],{"_3337":68521,"_29196":68404,"_20242":114874,"_5":13829,"_26574":114603,"_2824":114875},[],"Certificados de las CAs elegidas explícitamente.",{"_3337":68522,"_29196":68404,"_20242":114877,"_5":13829,"_26574":114603,"_2824":114878},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3337":68523,"_29196":68404,"_20242":114880,"_5":13829,"_26574":114607,"_2824":114881},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3337":68524,"_29196":68404,"_20242":114883,"_5":13829,"_26574":114607,"_2824":114884},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3337":68525,"_29196":68404,"_20242":114886,"_5":13829,"_26574":114607,"_2824":114887},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3337":68526,"_29196":68404,"_20242":114889,"_5":13829,"_26574":114611,"_2824":114890},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3337":68527,"_29196":68527,"_5":14181,"_2824":114892,"_29540":114893,"_20242":114894,"_26574":68527},"Integra el cliente EST",[47528,113284,49985,114290,114465],[],{"_3337":68528,"_29196":68527,"_20242":114896,"_5":13829,"_26574":68527,"_2824":114897},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3337":68529,"_29196":68527,"_5":29537,"_20242":114899,"_26574":114900,"_2824":111881},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3337":68530,"_29196":68527,"_5":29537,"_20242":114902,"_26574":114903,"_2824":114904},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3337":68531,"_29196":68527,"_5":29537,"_20242":114906,"_26574":114907,"_2824":114908},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3337":68532,"_29196":68527,"_5":29537,"_20242":114910,"_26574":114911,"_2824":114912},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3337":68533,"_29196":68527,"_5":29537,"_20242":114914,"_26574":114915,"_2824":114916},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3337":68534,"_29196":68527,"_5":29537,"_20242":114918,"_26574":114919,"_2824":114920},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3337":68535,"_29196":68527,"_20242":114922,"_5":13829,"_26574":68527,"_2824":114923},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3337":68536,"_29196":68527,"_20242":114925,"_5":13829,"_26574":114900,"_2824":114926},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3337":68537,"_29196":68527,"_20242":114928,"_5":13829,"_26574":114900,"_2824":114929},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3337":68538,"_29196":68527,"_20242":114931,"_5":13829,"_26574":114900,"_2824":114932},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3337":68539,"_29196":68527,"_20242":114934,"_5":13829,"_26574":114903,"_2824":114935},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3337":68540,"_29196":68527,"_20242":114937,"_5":13829,"_26574":114903,"_2824":114938},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3337":68541,"_29196":68527,"_20242":114940,"_5":13829,"_26574":114907,"_2824":114941},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3337":68542,"_29196":68527,"_20242":114943,"_5":13829,"_26574":114907,"_2824":114944},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3337":68543,"_29196":68527,"_20242":114946,"_5":13829,"_26574":114911,"_2824":114947},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3337":68544,"_29196":68527,"_20242":114949,"_5":13829,"_26574":114911,"_2824":114950},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3337":68545,"_29196":68527,"_20242":114952,"_5":13829,"_26574":114915,"_2824":114953},[],"Para el caso de una raíz que emite directamente:",{"_3337":68546,"_29196":68527,"_20242":114955,"_5":13829,"_26574":114915,"_2824":114956},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3337":68547,"_29196":68527,"_20242":114958,"_5":13829,"_26574":114915,"_2824":114959},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3337":68548,"_29196":68527,"_20242":114961,"_5":13829,"_26574":114919,"_2824":114962},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3337":68549,"_29196":68549,"_5":14181,"_2824":114964,"_29540":114965,"_20242":114966,"_26574":68549},"Referencia EST",[47528,113284,49985,114290,114465],[],{"_3337":68550,"_29196":68549,"_20242":114968,"_5":13829,"_26574":68549,"_2824":114969},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3337":68551,"_29196":68549,"_5":29537,"_20242":114971,"_26574":114972,"_2824":114973},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3337":68552,"_29196":68549,"_5":29537,"_20242":114975,"_26574":114976,"_2824":21955},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3337":68553,"_29196":68549,"_5":29537,"_20242":114978,"_26574":114979,"_2824":25204},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3337":68554,"_29196":68549,"_5":29537,"_20242":114981,"_26574":114982,"_2824":25211},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3337":68555,"_29196":68549,"_5":29537,"_20242":114984,"_26574":114985,"_2824":24539},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3337":68556,"_29196":68549,"_5":29537,"_20242":114987,"_26574":114988,"_2824":114989},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3337":68557,"_29196":68549,"_5":29537,"_20242":114991,"_26574":114992,"_2824":114993},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3337":68558,"_29196":68549,"_5":29537,"_20242":114995,"_26574":114996,"_2824":114997},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3337":68559,"_29196":68549,"_20242":114999,"_5":13829,"_26574":68549,"_2824":115000},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3337":68560,"_29196":68549,"_20242":115002,"_5":13829,"_26574":114972,"_2824":115003},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3337":68561,"_29196":68549,"_20242":115005,"_5":13829,"_26574":114972,"_2824":113044},[],{"_3337":68562,"_29196":68549,"_20242":115007,"_5":13829,"_26574":114972,"_2824":115008},[],"Método",{"_3337":68563,"_29196":68549,"_20242":115010,"_5":13829,"_26574":114972,"_2824":115011},[],"Autenticación y condición",{"_3337":68564,"_29196":68549,"_20242":115013,"_5":13829,"_26574":114972,"_2824":50747},[],{"_3337":68565,"_29196":68549,"_20242":115015,"_5":13829,"_26574":114972,"_2824":50750},[],{"_3337":68566,"_29196":68549,"_20242":115017,"_5":13829,"_26574":114972,"_2824":115018},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3337":68567,"_29196":68549,"_20242":115020,"_5":13829,"_26574":114972,"_2824":50756},[],{"_3337":68568,"_29196":68549,"_20242":115022,"_5":13829,"_26574":114972,"_2824":50759},[],{"_3337":68569,"_29196":68549,"_20242":115024,"_5":13829,"_26574":114972,"_2824":115025},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3337":68570,"_29196":68549,"_20242":115027,"_5":13829,"_26574":114972,"_2824":50765},[],{"_3337":68571,"_29196":68549,"_20242":115029,"_5":13829,"_26574":114972,"_2824":50759},[],{"_3337":68572,"_29196":68549,"_20242":115031,"_5":13829,"_26574":114972,"_2824":115032},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3337":68573,"_29196":68549,"_20242":115034,"_5":13829,"_26574":114972,"_2824":50773},[],{"_3337":68574,"_29196":68549,"_20242":115036,"_5":13829,"_26574":114972,"_2824":50759},[],{"_3337":68575,"_29196":68549,"_20242":115038,"_5":13829,"_26574":114972,"_2824":115039},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3337":68576,"_29196":68549,"_20242":115041,"_5":13829,"_26574":114972,"_2824":115042},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3337":68577,"_29196":68549,"_20242":115044,"_5":13829,"_26574":114976,"_2824":115045},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3337":68578,"_29196":68549,"_20242":115047,"_5":13829,"_26574":114976,"_2824":115048},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3337":68579,"_29196":68549,"_20242":115050,"_5":13829,"_26574":114979,"_2824":115051},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3337":68580,"_29196":68549,"_20242":115053,"_5":13829,"_26574":114979,"_2824":115054},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3337":68581,"_29196":68549,"_20242":115056,"_5":13829,"_26574":114982,"_2824":115057},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3337":68582,"_29196":68549,"_20242":115059,"_5":13829,"_26574":114982,"_2824":115060},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3337":68583,"_29196":68549,"_20242":115062,"_5":13829,"_26574":114985,"_2824":115063},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3337":68584,"_29196":68549,"_20242":115065,"_5":13829,"_26574":114985,"_2824":115066},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3337":68585,"_29196":68549,"_20242":115068,"_5":13829,"_26574":114988,"_2824":115069},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3337":68586,"_29196":68549,"_20242":115071,"_5":13829,"_26574":114988,"_2824":115072},[],"Parte",{"_3337":68587,"_29196":68549,"_20242":115074,"_5":13829,"_26574":114988,"_2824":115075},[],"Contenido tras decodificar su Base64",{"_3337":68588,"_29196":68549,"_20242":115077,"_5":13829,"_26574":114988,"_2824":50817},[],{"_3337":68589,"_29196":68549,"_20242":115079,"_5":13829,"_26574":114988,"_2824":115080},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3337":68590,"_29196":68549,"_20242":115082,"_5":13829,"_26574":114988,"_2824":50823},[],{"_3337":68591,"_29196":68549,"_20242":115084,"_5":13829,"_26574":114988,"_2824":115085},[],"PKCS#7 DER con el certificado emitido.",{"_3337":68592,"_29196":68549,"_20242":115087,"_5":13829,"_26574":114988,"_2824":115088},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3337":68593,"_29196":68549,"_20242":115090,"_5":13829,"_26574":114992,"_2824":115091},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3337":68594,"_29196":68549,"_20242":115093,"_5":13829,"_26574":114992,"_2824":115094},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3337":68595,"_29196":68549,"_20242":115096,"_5":13829,"_26574":114992,"_2824":115097},[],"Convierte y comprueba el resultado:",{"_3337":68596,"_29196":68549,"_20242":115099,"_5":13829,"_26574":114992,"_2824":115100},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3337":68597,"_29196":68549,"_20242":115102,"_5":13829,"_26574":114996,"_2824":115103},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3337":68598,"_29196":68549,"_20242":115105,"_5":13829,"_26574":114996,"_2824":115106},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3337":68599,"_29196":68599,"_5":14181,"_2824":114465,"_29540":115108,"_20242":115109,"_26574":68599},[47528,113284,49985,114290,114465],[],{"_3337":68600,"_29196":68599,"_20242":115111,"_5":13829,"_26574":68599,"_2824":115112},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3337":68601,"_29196":68599,"_5":29537,"_20242":115114,"_26574":115115,"_2824":115116},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3337":68602,"_29196":68599,"_5":29537,"_20242":115118,"_26574":115119,"_2824":115120},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3337":68603,"_29196":68599,"_5":29537,"_20242":115122,"_26574":115123,"_2824":115124},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3337":68604,"_29196":68599,"_5":29537,"_20242":115126,"_26574":115127,"_2824":115128},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3337":68605,"_29196":68599,"_20242":115130,"_5":13829,"_26574":68599,"_2824":115131},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3337":68606,"_29196":68599,"_20242":115133,"_5":13829,"_26574":115115,"_2824":115134},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3337":68607,"_29196":68599,"_20242":115136,"_5":13829,"_26574":115115,"_2824":115137},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3337":68608,"_29196":68599,"_20242":115139,"_5":13829,"_26574":115115,"_2824":115140},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3337":68609,"_29196":68599,"_20242":115142,"_5":13829,"_26574":115115,"_2824":115143},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3337":68610,"_29196":68599,"_20242":115145,"_5":13829,"_26574":115115,"_2824":115146},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3337":68611,"_29196":68599,"_20242":115148,"_5":13829,"_26574":115115,"_2824":115149},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3337":68612,"_29196":68599,"_20242":115151,"_5":13829,"_26574":115119,"_2824":115152},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3337":68613,"_29196":68599,"_20242":115154,"_5":13829,"_26574":115119,"_2824":115155},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3337":68614,"_29196":68599,"_20242":115157,"_5":13829,"_26574":115119,"_2824":115158},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3337":68615,"_29196":68599,"_20242":115160,"_5":13829,"_26574":115119,"_2824":115161},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3337":68616,"_29196":68599,"_20242":115163,"_5":13829,"_26574":115123,"_2824":115164},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3337":68617,"_29196":68599,"_20242":115166,"_5":13829,"_26574":115123,"_2824":115167},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3337":68618,"_29196":68599,"_20242":115169,"_5":13829,"_26574":115123,"_2824":115170},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3337":68619,"_29196":68599,"_20242":115172,"_5":13829,"_26574":115123,"_2824":115173},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3337":68620,"_29196":68599,"_20242":115175,"_5":13829,"_26574":115127,"_2824":115176},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3337":68621,"_29196":68599,"_20242":115178,"_5":13829,"_26574":115127,"_2824":115179},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3337":68622,"_29196":68622,"_5":14181,"_2824":115181,"_29540":115182,"_20242":115183,"_26574":68622},"Estrategias de aprovisionamiento",[47528,113284,49985,114290,114465],[],{"_3337":68623,"_29196":68622,"_20242":115185,"_5":13829,"_26574":68622,"_2824":115186},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3337":68624,"_29196":68622,"_5":29537,"_20242":115188,"_26574":115189,"_2824":115190},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3337":68625,"_29196":68622,"_5":29537,"_20242":115192,"_26574":115193,"_2824":115194},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3337":68626,"_29196":68622,"_5":29537,"_20242":115196,"_26574":115197,"_2824":115198},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3337":68627,"_29196":68622,"_5":29537,"_20242":115200,"_26574":115201,"_2824":115202},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3337":68628,"_29196":68622,"_5":29537,"_20242":115204,"_26574":115205,"_2824":115206},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3337":68629,"_29196":68622,"_20242":115208,"_5":13829,"_26574":68622,"_2824":115209},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3337":68630,"_29196":68622,"_20242":115211,"_5":13829,"_26574":115189,"_2824":115212},[],"Recorrido",{"_3337":68631,"_29196":68622,"_20242":115214,"_5":13829,"_26574":115189,"_2824":115215},[],"Cuándo existe el dispositivo",{"_3337":68632,"_29196":68622,"_20242":115217,"_5":13829,"_26574":115189,"_2824":115218},[],"Qué compruebas",{"_3337":68633,"_29196":68622,"_20242":115220,"_5":13829,"_26574":115189,"_2824":115221},[],"Asignación manual",{"_3337":68634,"_29196":68622,"_20242":115223,"_5":13829,"_26574":115189,"_2824":115224},[],"El operador lo crea antes de asociar un certificado.",{"_3337":68635,"_29196":68622,"_20242":115226,"_5":13829,"_26574":115189,"_2824":115227},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3337":68636,"_29196":68622,"_20242":115229,"_5":13829,"_26574":115189,"_2824":115230},[],"EST con `JITP`",{"_3337":68637,"_29196":68622,"_20242":115232,"_5":13829,"_26574":115189,"_2824":115233},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3337":68638,"_29196":68622,"_20242":115235,"_5":13829,"_26574":115189,"_2824":115236},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3337":68639,"_29196":68622,"_20242":115238,"_5":13829,"_26574":115189,"_2824":115239},[],"EST con `PRE_REGISTRATION`",{"_3337":68640,"_29196":68622,"_20242":115241,"_5":13829,"_26574":115189,"_2824":115242},[],"Debe existir antes de `/simpleenroll`.",{"_3337":68641,"_29196":68622,"_20242":115244,"_5":13829,"_26574":115189,"_2824":115245},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3337":68642,"_29196":68622,"_20242":115247,"_5":13829,"_26574":115189,"_2824":115248},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3337":68643,"_29196":68622,"_20242":115250,"_5":13829,"_26574":115189,"_2824":115251},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3337":68644,"_29196":68622,"_20242":115253,"_5":13829,"_26574":115193,"_2824":115254},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3337":68645,"_29196":68622,"_20242":115256,"_5":13829,"_26574":115193,"_2824":115257},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3337":68646,"_29196":68622,"_20242":115259,"_5":13829,"_26574":115193,"_2824":115260},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3337":68647,"_29196":68622,"_20242":115262,"_5":13829,"_26574":115197,"_2824":115263},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3337":68648,"_29196":68622,"_20242":115265,"_5":13829,"_26574":115197,"_2824":115266},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3337":68649,"_29196":68622,"_20242":115268,"_5":13829,"_26574":115197,"_2824":115269},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3337":68650,"_29196":68622,"_20242":115271,"_5":13829,"_26574":115197,"_2824":115272},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3337":68651,"_29196":68622,"_20242":115274,"_5":13829,"_26574":115197,"_2824":115275},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3337":68652,"_29196":68622,"_20242":115277,"_5":13829,"_26574":115197,"_2824":115278},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3337":68653,"_29196":68622,"_20242":115280,"_5":13829,"_26574":115201,"_2824":112245},[],{"_3337":68654,"_29196":68622,"_20242":115282,"_5":13829,"_26574":115201,"_2824":115283},[],"Material que atraviesa EST",{"_3337":68655,"_29196":68622,"_20242":115285,"_5":13829,"_26574":115201,"_2824":115286},[],"Clave generada por el dispositivo",{"_3337":68656,"_29196":68622,"_20242":115288,"_5":13829,"_26574":115201,"_2824":115289},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3337":68657,"_29196":68622,"_20242":115291,"_5":13829,"_26574":115201,"_2824":115292},[],"Clave ya disponible en el dispositivo",{"_3337":68658,"_29196":68622,"_20242":115294,"_5":13829,"_26574":115201,"_2824":115295},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3337":68659,"_29196":68622,"_20242":115297,"_5":13829,"_26574":115201,"_2824":50304},[],{"_3337":68660,"_29196":68622,"_20242":115299,"_5":13829,"_26574":115201,"_2824":115300},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3337":68661,"_29196":68622,"_20242":115302,"_5":13829,"_26574":115201,"_2824":115303},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3337":68662,"_29196":68622,"_20242":115305,"_5":13829,"_26574":115205,"_2824":115306},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3337":68663,"_29196":68663,"_5":14181,"_2824":115308,"_29540":115309,"_20242":115310,"_26574":68663},"Renovación y recuperación",[47528,113284,49985,114290,114465],[],{"_3337":68664,"_29196":68663,"_20242":115312,"_5":13829,"_26574":68663,"_2824":115313},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3337":68665,"_29196":68663,"_5":29537,"_20242":115315,"_26574":115316,"_2824":115317},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3337":68666,"_29196":68663,"_5":29537,"_20242":115319,"_26574":115320,"_2824":115321},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3337":68667,"_29196":68663,"_5":29537,"_20242":115323,"_26574":115324,"_2824":115325},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3337":68668,"_29196":68663,"_5":29537,"_20242":115327,"_26574":115328,"_2824":115329},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3337":68669,"_29196":68663,"_5":29537,"_20242":115331,"_26574":115332,"_2824":115333},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3337":68670,"_29196":68663,"_20242":115335,"_5":13829,"_26574":68663,"_2824":115336},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3337":68671,"_29196":68663,"_20242":115338,"_5":13829,"_26574":115316,"_2824":115339},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3337":68672,"_29196":68663,"_20242":115341,"_5":13829,"_26574":115316,"_2824":115342},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3337":68673,"_29196":68663,"_20242":115344,"_5":13829,"_26574":115316,"_2824":115345},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3337":68674,"_29196":68663,"_20242":115347,"_5":13829,"_26574":115316,"_2824":115348},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3337":68675,"_29196":68663,"_20242":115350,"_5":13829,"_26574":115320,"_2824":115351},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3337":68676,"_29196":68663,"_20242":115353,"_5":13829,"_26574":115320,"_2824":115354},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3337":68677,"_29196":68663,"_20242":115356,"_5":13829,"_26574":115324,"_2824":115357},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3337":68678,"_29196":68663,"_20242":115359,"_5":13829,"_26574":115324,"_2824":115360},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3337":68679,"_29196":68663,"_20242":115362,"_5":13829,"_26574":115324,"_2824":115363},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3337":68680,"_29196":68663,"_20242":115365,"_5":13829,"_26574":115328,"_2824":115366},[],"Situación",{"_3337":68681,"_29196":68663,"_20242":115368,"_5":13829,"_26574":115328,"_2824":115369},[],"Procedimiento",{"_3337":68682,"_29196":68663,"_20242":115371,"_5":13829,"_26574":115328,"_2824":115372},[],"Certificado vigente, fuera de ventana",{"_3337":68683,"_29196":68663,"_20242":115374,"_5":13829,"_26574":115328,"_2824":115375},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3337":68684,"_29196":68663,"_20242":115377,"_5":13829,"_26574":115328,"_2824":115378},[],"Certificado vencido, clave disponible",{"_3337":68685,"_29196":68663,"_20242":115380,"_5":13829,"_26574":115328,"_2824":115381},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3337":68686,"_29196":68663,"_20242":115383,"_5":13829,"_26574":115328,"_2824":115384},[],"Renovación por webhook o `NO_AUTH`",{"_3337":68687,"_29196":68663,"_20242":115386,"_5":13829,"_26574":115328,"_2824":115387},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3337":68688,"_29196":68663,"_20242":115389,"_5":13829,"_26574":115328,"_2824":115390},[],"Clave perdida o inaccesible",{"_3337":68689,"_29196":68663,"_20242":115392,"_5":13829,"_26574":115328,"_2824":115393},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3337":68690,"_29196":68663,"_20242":115395,"_5":13829,"_26574":115328,"_2824":115396},[],"Identidad actual revocada",{"_3337":68691,"_29196":68663,"_20242":115398,"_5":13829,"_26574":115328,"_2824":115399},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3337":68692,"_29196":68663,"_20242":115401,"_5":13829,"_26574":115328,"_2824":115402},[],"Dispositivo sin identidad",{"_3337":68693,"_29196":68663,"_20242":115404,"_5":13829,"_26574":115328,"_2824":115405},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3337":68694,"_29196":68663,"_20242":115407,"_5":13829,"_26574":115328,"_2824":115408},[],"Dispositivo retirado",{"_3337":68695,"_29196":68663,"_20242":115410,"_5":13829,"_26574":115328,"_2824":115411},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3337":68696,"_29196":68663,"_20242":115413,"_5":13829,"_26574":115328,"_2824":115414},[],"Timeout, HTTP 500 o fallo de instalación",{"_3337":68697,"_29196":68663,"_20242":115416,"_5":13829,"_26574":115328,"_2824":115417},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3337":68698,"_29196":68663,"_20242":115419,"_5":13829,"_26574":115332,"_2824":115420},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3337":68699,"_29196":68663,"_20242":115422,"_5":13829,"_26574":115332,"_2824":115423},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3337":68700,"_29196":68700,"_5":14181,"_2824":115425,"_29540":115426,"_20242":115427,"_26574":68700},"Diagnóstico de enrolamiento",[47528,113284,49985,114290,114465],[],{"_3337":68701,"_29196":68700,"_20242":115429,"_5":13829,"_26574":68700,"_2824":115430},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3337":68702,"_29196":68700,"_5":29537,"_20242":115432,"_26574":115433,"_2824":115434},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3337":68703,"_29196":68700,"_5":29537,"_20242":115436,"_26574":115437,"_2824":115438},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3337":68704,"_29196":68700,"_5":29537,"_20242":115440,"_26574":115441,"_2824":114997},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3337":68705,"_29196":68700,"_5":29537,"_20242":115443,"_26574":115444,"_2824":115445},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3337":68706,"_29196":68700,"_20242":115447,"_5":13829,"_26574":68700,"_2824":115448},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3337":68707,"_29196":68700,"_20242":115450,"_5":13829,"_26574":115437,"_2824":115451},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3337":68708,"_29196":68700,"_20242":115453,"_5":13829,"_26574":115437,"_2824":115454},[],"Síntoma o mensaje",{"_3337":68709,"_29196":68700,"_20242":115456,"_5":13829,"_26574":115437,"_2824":115457},[],"Qué revisar",{"_3337":68710,"_29196":68700,"_20242":115459,"_5":13829,"_26574":115437,"_2824":115460},[],"curl rechaza TLS, nombre o emisor",{"_3337":68711,"_29196":68700,"_20242":115462,"_5":13829,"_26574":115437,"_2824":115463},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3337":68712,"_29196":68700,"_20242":115465,"_5":13829,"_26574":115437,"_2824":115466},[],"404 o APS ausente",{"_3337":68713,"_29196":68700,"_20242":115468,"_5":13829,"_26574":115437,"_2824":115469},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3337":68714,"_29196":68700,"_20242":115471,"_5":13829,"_26574":115437,"_2824":115472},[],"400, error de CSR o formato",{"_3337":68715,"_29196":68700,"_20242":115474,"_5":13829,"_26574":115437,"_2824":115475},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3337":68716,"_29196":68700,"_20242":115477,"_5":13829,"_26574":115437,"_2824":115478},[],"Credencial ausente o certificado no válido",{"_3337":68717,"_29196":68700,"_20242":115480,"_5":13829,"_26574":115437,"_2824":115481},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3337":68718,"_29196":68700,"_20242":115483,"_5":13829,"_26574":115437,"_2824":115484},[],"Webhook deniega, expira o responde sin autorización",{"_3337":68719,"_29196":68700,"_20242":115486,"_5":13829,"_26574":115437,"_2824":115487},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3337":68720,"_29196":68700,"_20242":115489,"_5":13829,"_26574":115437,"_2824":51230},[],{"_3337":68721,"_29196":68700,"_20242":115491,"_5":13829,"_26574":115437,"_2824":115492},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3337":68722,"_29196":68700,"_20242":115494,"_5":13829,"_26574":115437,"_2824":51236},[],{"_3337":68723,"_29196":68700,"_20242":115496,"_5":13829,"_26574":115437,"_2824":115497},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3337":68724,"_29196":68700,"_20242":115499,"_5":13829,"_26574":115437,"_2824":51242},[],{"_3337":68725,"_29196":68700,"_20242":115501,"_5":13829,"_26574":115437,"_2824":115502},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3337":68726,"_29196":68700,"_20242":115504,"_5":13829,"_26574":115437,"_2824":51248},[],{"_3337":68727,"_29196":68700,"_20242":115506,"_5":13829,"_26574":115437,"_2824":115507},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3337":68728,"_29196":68700,"_20242":115509,"_5":13829,"_26574":115437,"_2824":51254},[],{"_3337":68729,"_29196":68700,"_20242":115511,"_5":13829,"_26574":115437,"_2824":115512},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3337":68730,"_29196":68700,"_20242":115514,"_5":13829,"_26574":115437,"_2824":115515},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3337":68731,"_29196":68700,"_20242":115517,"_5":13829,"_26574":115437,"_2824":115518},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3337":68732,"_29196":68700,"_20242":115520,"_5":13829,"_26574":115437,"_2824":115521},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3337":68733,"_29196":68700,"_20242":115523,"_5":13829,"_26574":115437,"_2824":115524},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3337":68734,"_29196":68700,"_20242":115526,"_5":13829,"_26574":115437,"_2824":51272},[],{"_3337":68735,"_29196":68700,"_20242":115528,"_5":13829,"_26574":115437,"_2824":115529},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3337":68736,"_29196":68700,"_20242":115531,"_5":13829,"_26574":115437,"_2824":51278},[],{"_3337":68737,"_29196":68700,"_20242":115533,"_5":13829,"_26574":115437,"_2824":115534},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3337":68738,"_29196":68700,"_20242":115536,"_5":13829,"_26574":115437,"_2824":115537},[],"DMS propietario distinto",{"_3337":68739,"_29196":68700,"_20242":115539,"_5":13829,"_26574":115437,"_2824":115540},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3337":68740,"_29196":68700,"_20242":115542,"_5":13829,"_26574":115437,"_2824":51290},[],{"_3337":68741,"_29196":68700,"_20242":115544,"_5":13829,"_26574":115437,"_2824":115545},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3337":68742,"_29196":68700,"_20242":115547,"_5":13829,"_26574":115437,"_2824":51296},[],{"_3337":68743,"_29196":68700,"_20242":115549,"_5":13829,"_26574":115437,"_2824":115550},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3337":68744,"_29196":68700,"_20242":115552,"_5":13829,"_26574":115437,"_2824":115553},[],"Certificado actual revocado",{"_3337":68745,"_29196":68700,"_20242":115555,"_5":13829,"_26574":115437,"_2824":115556},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3337":68746,"_29196":68700,"_20242":115558,"_5":13829,"_26574":115437,"_2824":115559},[],"Error de CA, perfil o firma",{"_3337":68747,"_29196":68700,"_20242":115561,"_5":13829,"_26574":115437,"_2824":115562},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3337":68748,"_29196":68700,"_20242":115564,"_5":13829,"_26574":115437,"_2824":115565},[],"HTTP 200 sin conexión del dispositivo",{"_3337":68749,"_29196":68700,"_20242":115567,"_5":13829,"_26574":115437,"_2824":115568},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3337":68750,"_29196":68700,"_20242":115570,"_5":13829,"_26574":115437,"_2824":115571},[],"Timeout o error después de emitir",{"_3337":68751,"_29196":68700,"_20242":115573,"_5":13829,"_26574":115437,"_2824":115574},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3337":68752,"_29196":68700,"_20242":115576,"_5":13829,"_26574":115441,"_2824":115577},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3337":68753,"_29196":68700,"_20242":115579,"_5":13829,"_26574":115441,"_2824":115580},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3337":68754,"_29196":68700,"_20242":115582,"_5":13829,"_26574":115444,"_2824":115583},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3337":68755,"_29196":68700,"_20242":115585,"_5":13829,"_26574":115444,"_2824":115586},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3337":68756,"_29196":68700,"_20242":115588,"_5":13829,"_26574":115444,"_2824":115589},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3337":68757,"_29196":68700,"_20242":115591,"_5":13829,"_26574":115444,"_2824":115592},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3337":68758,"_29196":68700,"_20242":115594,"_5":13829,"_26574":115444,"_2824":115595},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3337":68759,"_29196":68700,"_20242":115597,"_5":13829,"_26574":115444,"_2824":115598},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3337":68760,"_29196":68700,"_20242":115600,"_5":13829,"_26574":115444,"_2824":115601},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3337":68761,"_29196":68761,"_5":14181,"_2824":115603,"_29540":115604,"_20242":115605,"_26574":68761},"Distribución y actualización de confianza",[47528,113284,49985,114290,114465],[],{"_3337":68762,"_29196":68761,"_20242":115607,"_5":13829,"_26574":68761,"_2824":115608},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3337":68763,"_29196":68761,"_5":29537,"_20242":115610,"_26574":115611,"_2824":115612},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3337":68764,"_29196":68761,"_5":29537,"_20242":115614,"_26574":115615,"_2824":115616},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3337":68765,"_29196":68761,"_5":29537,"_20242":115618,"_26574":115619,"_2824":115620},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3337":68766,"_29196":68761,"_5":29537,"_20242":115622,"_26574":115623,"_2824":115624},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3337":68767,"_29196":68761,"_5":29537,"_20242":115626,"_26574":115627,"_2824":115628},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3337":68768,"_29196":68761,"_20242":115630,"_5":13829,"_26574":68761,"_2824":115631},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3337":68769,"_29196":68761,"_20242":115633,"_5":13829,"_26574":115611,"_2824":115634},[],"Relación",{"_3337":68770,"_29196":68761,"_20242":115636,"_5":13829,"_26574":115611,"_2824":115637},[],"Material que prepara el responsable",{"_3337":68771,"_29196":68761,"_20242":115639,"_5":13829,"_26574":115611,"_2824":115640},[],"Dispositivo → servidor EST",{"_3337":68772,"_29196":68761,"_20242":115642,"_5":13829,"_26574":115611,"_2824":115643},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3337":68773,"_29196":68761,"_20242":115645,"_5":13829,"_26574":115611,"_2824":115646},[],"DMS → solicitante",{"_3337":68774,"_29196":68761,"_20242":115648,"_5":13829,"_26574":115611,"_2824":115649},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3337":68775,"_29196":68761,"_20242":115651,"_5":13829,"_26574":115611,"_2824":115652},[],"Consumidor → dispositivo",{"_3337":68776,"_29196":68761,"_20242":115654,"_5":13829,"_26574":115611,"_2824":115655},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3337":68777,"_29196":68761,"_20242":115657,"_5":13829,"_26574":115611,"_2824":115658},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3337":68778,"_29196":68761,"_20242":115660,"_5":13829,"_26574":115615,"_2824":115661},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3337":68779,"_29196":68761,"_20242":115663,"_5":13829,"_26574":115615,"_2824":115664},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3337":68780,"_29196":68761,"_20242":115666,"_5":13829,"_26574":115619,"_2824":115667},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3337":68781,"_29196":68761,"_20242":115669,"_5":13829,"_26574":115619,"_2824":115670},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3337":68782,"_29196":68761,"_20242":115672,"_5":13829,"_26574":115619,"_2824":115673},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3337":68783,"_29196":68761,"_20242":115675,"_5":13829,"_26574":115619,"_2824":115676},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3337":68784,"_29196":68761,"_20242":115678,"_5":13829,"_26574":115619,"_2824":115679},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3337":68785,"_29196":68761,"_20242":115681,"_5":13829,"_26574":115619,"_2824":115682},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3337":68786,"_29196":68761,"_20242":115684,"_5":13829,"_26574":115623,"_2824":115685},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3337":68787,"_29196":68761,"_20242":115687,"_5":13829,"_26574":115623,"_2824":115688},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3337":68788,"_29196":68761,"_20242":115690,"_5":13829,"_26574":115623,"_2824":115691},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3337":68789,"_29196":68761,"_20242":115693,"_5":13829,"_26574":115627,"_2824":115694},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3337":68790,"_29196":68790,"_5":14181,"_2824":51445,"_29540":115696,"_20242":115698,"_26574":68790},[47528,113284,49985,114290,115697],"Integraciones",[],{"_3337":68791,"_29196":68790,"_20242":115700,"_5":13829,"_26574":68790,"_2824":115701},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3337":68792,"_29196":68790,"_5":29537,"_20242":115703,"_26574":115704,"_2824":115705},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3337":68793,"_29196":68790,"_5":29537,"_20242":115707,"_26574":115708,"_2824":115709},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3337":68794,"_29196":68790,"_5":29537,"_20242":115711,"_26574":115712,"_2824":115713},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3337":68795,"_29196":68790,"_5":29537,"_20242":115715,"_26574":115716,"_2824":115717},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3337":68796,"_29196":68790,"_5":29537,"_20242":115719,"_26574":115720,"_2824":115721},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#máquina-de-estados-de-los-recursos","Máquina de estados de los recursos",{"_3337":68797,"_29196":68790,"_5":29537,"_20242":115723,"_26574":115724,"_2824":115725},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#eventos-que-gestiona-el-conector","Eventos que gestiona el conector",{"_3337":68798,"_29196":68790,"_5":29537,"_20242":115727,"_26574":115728,"_2824":115729},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3337":68799,"_29196":68790,"_5":29537,"_20242":115731,"_26574":115732,"_2824":115733},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3337":68800,"_29196":68790,"_5":29537,"_20242":115735,"_26574":115736,"_2824":115737},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3337":68801,"_29196":68790,"_5":29537,"_20242":115739,"_26574":115740,"_2824":115741},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3337":68802,"_29196":68790,"_5":29537,"_20242":115743,"_26574":115744,"_2824":115745},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3337":68803,"_29196":68790,"_5":29537,"_20242":115747,"_26574":115748,"_2824":115749},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3337":68804,"_29196":68790,"_5":29537,"_20242":115751,"_26574":115752,"_2824":51503},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3337":68805,"_29196":68790,"_5":29537,"_20242":115754,"_26574":115755,"_2824":51507},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3337":68806,"_29196":68790,"_5":29537,"_20242":115757,"_26574":115758,"_2824":115759},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3337":68807,"_29196":68790,"_5":29537,"_20242":115761,"_26574":115762,"_2824":115763},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3337":68808,"_29196":68790,"_5":29537,"_20242":115765,"_26574":115766,"_2824":115767},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3337":68809,"_29196":68790,"_5":29537,"_20242":115769,"_26574":115770,"_2824":115771},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3337":68810,"_29196":68790,"_5":29537,"_20242":115773,"_26574":115774,"_2824":115775},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3337":68811,"_29196":68790,"_5":29537,"_20242":115777,"_26574":115778,"_2824":115779},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3337":68812,"_29196":68790,"_5":29537,"_20242":115781,"_26574":115782,"_2824":115783},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3337":68813,"_29196":68790,"_5":29537,"_20242":115785,"_26574":115786,"_2824":115787},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3337":68814,"_29196":68790,"_5":29537,"_20242":115789,"_26574":115790,"_2824":115791},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3337":68815,"_29196":68790,"_5":29537,"_20242":115793,"_26574":115794,"_2824":115795},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3337":68816,"_29196":68790,"_5":29537,"_20242":115797,"_26574":115798,"_2824":115799},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3337":68817,"_29196":68790,"_5":29537,"_20242":115801,"_26574":115802,"_2824":115803},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3337":68818,"_29196":68790,"_20242":115805,"_5":13829,"_26574":68790,"_2824":115806},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3337":68819,"_29196":68790,"_20242":115808,"_5":13829,"_26574":68790,"_2824":115809},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3337":68820,"_29196":68790,"_20242":115811,"_5":13829,"_26574":68790,"_2824":115812},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3337":68821,"_29196":68790,"_20242":115814,"_5":13829,"_26574":115704,"_2824":115815},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3337":68822,"_29196":68790,"_20242":115817,"_5":13829,"_26574":115704,"_2824":115818},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3337":68823,"_29196":68790,"_20242":115820,"_5":13829,"_26574":115704,"_2824":115821},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3337":68824,"_29196":68790,"_20242":115823,"_5":13829,"_26574":115704,"_2824":115824},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3337":68825,"_29196":68790,"_20242":115826,"_5":13829,"_26574":115708,"_2824":115827},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3337":68826,"_29196":68790,"_20242":115829,"_5":13829,"_26574":115712,"_2824":115830},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3337":68827,"_29196":68790,"_20242":115832,"_5":13829,"_26574":115712,"_2824":115833},[],"Acción IAM",{"_3337":68828,"_29196":68790,"_20242":115835,"_5":13829,"_26574":115712,"_2824":112251},[],{"_3337":68829,"_29196":68790,"_20242":115837,"_5":13829,"_26574":115712,"_2824":51590},[],{"_3337":68830,"_29196":68790,"_20242":115839,"_5":13829,"_26574":115712,"_2824":115840},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3337":68831,"_29196":68790,"_20242":115842,"_5":13829,"_26574":115712,"_2824":51596},[],{"_3337":68832,"_29196":68790,"_20242":115844,"_5":13829,"_26574":115712,"_2824":115845},[],"Registrar la CA en AWS IoT",{"_3337":68833,"_29196":68790,"_20242":115847,"_5":13829,"_26574":115712,"_2824":51602},[],{"_3337":68834,"_29196":68790,"_20242":115849,"_5":13829,"_26574":115712,"_2824":115850},[],"Consultar el estado del registro de la CA",{"_3337":68835,"_29196":68790,"_20242":115852,"_5":13829,"_26574":115712,"_2824":51608},[],{"_3337":68836,"_29196":68790,"_20242":115854,"_5":13829,"_26574":115712,"_2824":115855},[],"Crear o actualizar Things en IoT Core",{"_3337":68837,"_29196":68790,"_20242":115857,"_5":13829,"_26574":115712,"_2824":51614},[],{"_3337":68838,"_29196":68790,"_20242":115859,"_5":13829,"_26574":115712,"_2824":115860},[],"Aprovisionar Things mediante plantilla",{"_3337":68839,"_29196":68790,"_20242":115862,"_5":13829,"_26574":115712,"_2824":51620},[],{"_3337":68840,"_29196":68790,"_20242":115864,"_5":13829,"_26574":115712,"_2824":115865},[],"Registrar certificados de dispositivo",{"_3337":68841,"_29196":68790,"_20242":115867,"_5":13829,"_26574":115712,"_2824":51626},[],{"_3337":68842,"_29196":68790,"_20242":115869,"_5":13829,"_26574":115712,"_2824":115870},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3337":68843,"_29196":68790,"_20242":115872,"_5":13829,"_26574":115712,"_2824":51632},[],{"_3337":68844,"_29196":68790,"_20242":115874,"_5":13829,"_26574":115712,"_2824":115875},[],"Crear y adjuntar políticas IoT",{"_3337":68845,"_29196":68790,"_20242":115877,"_5":13829,"_26574":115712,"_2824":51638},[],{"_3337":68846,"_29196":68790,"_20242":115879,"_5":13829,"_26574":115712,"_2824":115880},[],"Gestionar grupos de Things",{"_3337":68847,"_29196":68790,"_20242":115882,"_5":13829,"_26574":115712,"_2824":51644},[],{"_3337":68848,"_29196":68790,"_20242":115884,"_5":13829,"_26574":115712,"_2824":115885},[],"Crear plantillas JITP",{"_3337":68849,"_29196":68790,"_20242":115887,"_5":13829,"_26574":115712,"_2824":51650},[],{"_3337":68850,"_29196":68790,"_20242":115889,"_5":13829,"_26574":115712,"_2824":115890},[],"Leer y escribir el Device Shadow",{"_3337":68851,"_29196":68790,"_20242":115892,"_5":13829,"_26574":115712,"_2824":115893},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3337":68852,"_29196":68790,"_20242":115895,"_5":13829,"_26574":115716,"_2824":115896},[],"Parámetro",{"_3337":68853,"_29196":68790,"_20242":115898,"_5":13829,"_26574":115716,"_2824":115899},[],"Tipo",{"_3337":68854,"_29196":68790,"_20242":115901,"_5":13829,"_26574":115716,"_2824":115902},[],"Requerido",{"_3337":68855,"_29196":68790,"_20242":115904,"_5":13829,"_26574":115716,"_2824":115905},[],"Descripción",{"_3337":68856,"_29196":68790,"_20242":115907,"_5":13829,"_26574":115716,"_2824":51671},[],{"_3337":68857,"_29196":68790,"_20242":115909,"_5":13829,"_26574":115716,"_2824":24190},[],{"_3337":68858,"_29196":68790,"_20242":115911,"_5":13829,"_26574":115716,"_2824":115912},[],"Sí",{"_3337":68859,"_29196":68790,"_20242":115914,"_5":13829,"_26574":115716,"_2824":115915},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3337":68860,"_29196":68790,"_20242":115917,"_5":13829,"_26574":115716,"_2824":51682},[],{"_3337":68861,"_29196":68790,"_20242":115919,"_5":13829,"_26574":115716,"_2824":24190},[],{"_3337":68862,"_29196":68790,"_20242":115921,"_5":13829,"_26574":115716,"_2824":115912},[],{"_3337":68863,"_29196":68790,"_20242":115923,"_5":13829,"_26574":115716,"_2824":115924},[],"Región AWS donde opera el conector.",{"_3337":68864,"_29196":68790,"_20242":115926,"_5":13829,"_26574":115716,"_2824":51692},[],{"_3337":68865,"_29196":68790,"_20242":115928,"_5":13829,"_26574":115716,"_2824":24190},[],{"_3337":68866,"_29196":68790,"_20242":115930,"_5":13829,"_26574":115716,"_2824":115912},[],{"_3337":68867,"_29196":68790,"_20242":115932,"_5":13829,"_26574":115716,"_2824":115933},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3337":68868,"_29196":68790,"_20242":115935,"_5":13829,"_26574":115716,"_2824":51702},[],{"_3337":68869,"_29196":68790,"_20242":115937,"_5":13829,"_26574":115716,"_2824":24190},[],{"_3337":68870,"_29196":68790,"_20242":115939,"_5":13829,"_26574":115716,"_2824":115940},[],"Solo con `auth_method=static`",{"_3337":68871,"_29196":68790,"_20242":115942,"_5":13829,"_26574":115716,"_2824":115943},[],"Clave de acceso AWS.",{"_3337":68872,"_29196":68790,"_20242":115945,"_5":13829,"_26574":115716,"_2824":51713},[],{"_3337":68873,"_29196":68790,"_20242":115947,"_5":13829,"_26574":115716,"_2824":24190},[],{"_3337":68874,"_29196":68790,"_20242":115949,"_5":13829,"_26574":115716,"_2824":115940},[],{"_3337":68875,"_29196":68790,"_20242":115951,"_5":13829,"_26574":115716,"_2824":115952},[],"Clave secreta AWS.",{"_3337":68876,"_29196":68790,"_20242":115954,"_5":13829,"_26574":115716,"_2824":51723},[],{"_3337":68877,"_29196":68790,"_20242":115956,"_5":13829,"_26574":115716,"_2824":24190},[],{"_3337":68878,"_29196":68790,"_20242":115958,"_5":13829,"_26574":115716,"_2824":51728},[],{"_3337":68879,"_29196":68790,"_20242":115960,"_5":13829,"_26574":115716,"_2824":115961},[],"Token de sesión (con `auth_method=static`).",{"_3337":68880,"_29196":68790,"_20242":115963,"_5":13829,"_26574":115716,"_2824":51734},[],{"_3337":68881,"_29196":68790,"_20242":115965,"_5":13829,"_26574":115716,"_2824":24190},[],{"_3337":68882,"_29196":68790,"_20242":115967,"_5":13829,"_26574":115716,"_2824":115968},[],"Solo con `auth_method=role`",{"_3337":68883,"_29196":68790,"_20242":115970,"_5":13829,"_26574":115716,"_2824":115971},[],"ARN del rol a asumir.",{"_3337":68884,"_29196":68790,"_20242":115973,"_5":13829,"_26574":115716,"_2824":51745},[],{"_3337":68885,"_29196":68790,"_20242":115975,"_5":13829,"_26574":115716,"_2824":24190},[],{"_3337":68886,"_29196":68790,"_20242":115977,"_5":13829,"_26574":115716,"_2824":51728},[],{"_3337":68887,"_29196":68790,"_20242":115979,"_5":13829,"_26574":115716,"_2824":115980},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3337":68888,"_29196":68790,"_20242":115982,"_5":13829,"_26574":115716,"_2824":51755},[],{"_3337":68889,"_29196":68790,"_20242":115984,"_5":13829,"_26574":115716,"_2824":16988},[],{"_3337":68890,"_29196":68790,"_20242":115986,"_5":13829,"_26574":115716,"_2824":115912},[],{"_3337":68891,"_29196":68790,"_20242":115988,"_5":13829,"_26574":115716,"_2824":115989},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3337":68892,"_29196":68790,"_20242":115991,"_5":13829,"_26574":115716,"_2824":51765},[],{"_3337":68893,"_29196":68790,"_20242":115993,"_5":13829,"_26574":115716,"_2824":24190},[],{"_3337":68894,"_29196":68790,"_20242":115995,"_5":13829,"_26574":115716,"_2824":115912},[],{"_3337":68895,"_29196":68790,"_20242":115997,"_5":13829,"_26574":115716,"_2824":115998},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3337":68896,"_29196":68790,"_20242":116000,"_5":13829,"_26574":115716,"_2824":51775},[],{"_3337":68897,"_29196":68790,"_20242":116002,"_5":13829,"_26574":115716,"_2824":24190},[],{"_3337":68898,"_29196":68790,"_20242":116004,"_5":13829,"_26574":115716,"_2824":115912},[],{"_3337":68899,"_29196":68790,"_20242":116006,"_5":13829,"_26574":115716,"_2824":116007},[],"URL HTTP del Device Manager de Lamassu.",{"_3337":68900,"_29196":68790,"_20242":116009,"_5":13829,"_26574":115716,"_2824":51785},[],{"_3337":68901,"_29196":68790,"_20242":116011,"_5":13829,"_26574":115716,"_2824":24190},[],{"_3337":68902,"_29196":68790,"_20242":116013,"_5":13829,"_26574":115716,"_2824":115912},[],{"_3337":68903,"_29196":68790,"_20242":116015,"_5":13829,"_26574":115716,"_2824":116016},[],"URL HTTP del servicio de CA de Lamassu.",{"_3337":68904,"_29196":68790,"_20242":116018,"_5":13829,"_26574":115720,"_2824":116019},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada transición. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3337":68905,"_29196":68790,"_20242":116021,"_5":13829,"_26574":115724,"_2824":116022},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3337":68906,"_29196":68790,"_20242":116024,"_5":13829,"_26574":115724,"_2824":116025},[],"Tipo de CloudEvent",{"_3337":68907,"_29196":68790,"_20242":116027,"_5":13829,"_26574":115724,"_2824":116028},[],"Recurso en Lamassu",{"_3337":68908,"_29196":68790,"_20242":116030,"_5":13829,"_26574":115724,"_2824":116031},[],"Recurso AWS",{"_3337":68909,"_29196":68790,"_20242":116033,"_5":13829,"_26574":115724,"_2824":116034},[],"Acciones IAM",{"_3337":68910,"_29196":68790,"_20242":116036,"_5":13829,"_26574":115724,"_2824":116037},[],"Llamadas AWS y efecto",{"_3337":68911,"_29196":68790,"_20242":116039,"_5":13829,"_26574":115724,"_2824":116040},[],"Dónde en esta página",{"_3337":68912,"_29196":68790,"_20242":116042,"_5":13829,"_26574":115724,"_2824":51819},[],{"_3337":68913,"_29196":68790,"_20242":116044,"_5":13829,"_26574":115724,"_2824":51822},[],{"_3337":68914,"_29196":68790,"_20242":116046,"_5":13829,"_26574":115724,"_2824":51825},[],{"_3337":68915,"_29196":68790,"_20242":116048,"_5":13829,"_26574":115724,"_2824":51828},[],{"_3337":68916,"_29196":68790,"_20242":116050,"_5":13829,"_26574":115724,"_2824":116051},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3337":68917,"_29196":68790,"_20242":116053,"_5":13829,"_26574":115724,"_2824":115729},[],{"_3337":68918,"_29196":68790,"_20242":116055,"_5":13829,"_26574":115724,"_2824":51836},[],{"_3337":68919,"_29196":68790,"_20242":116057,"_5":13829,"_26574":115724,"_2824":51839},[],{"_3337":68920,"_29196":68790,"_20242":116059,"_5":13829,"_26574":115724,"_2824":51842},[],{"_3337":68921,"_29196":68790,"_20242":116061,"_5":13829,"_26574":115724,"_2824":51845},[],{"_3337":68922,"_29196":68790,"_20242":116063,"_5":13829,"_26574":115724,"_2824":116064},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3337":68923,"_29196":68790,"_20242":116066,"_5":13829,"_26574":115724,"_2824":115733},[],{"_3337":68924,"_29196":68790,"_20242":116068,"_5":13829,"_26574":115724,"_2824":51853},[],{"_3337":68925,"_29196":68790,"_20242":116070,"_5":13829,"_26574":115724,"_2824":116071},[],"Dispositivo",{"_3337":68926,"_29196":68790,"_20242":116073,"_5":13829,"_26574":115724,"_2824":51859},[],{"_3337":68927,"_29196":68790,"_20242":116075,"_5":13829,"_26574":115724,"_2824":51862},[],{"_3337":68928,"_29196":68790,"_20242":116077,"_5":13829,"_26574":115724,"_2824":116078},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3337":68929,"_29196":68790,"_20242":116080,"_5":13829,"_26574":115724,"_2824":115741},[],{"_3337":68930,"_29196":68790,"_20242":116082,"_5":13829,"_26574":115724,"_2824":51870},[],{"_3337":68931,"_29196":68790,"_20242":116084,"_5":13829,"_26574":115724,"_2824":116085},[],"Certificado",{"_3337":68932,"_29196":68790,"_20242":116087,"_5":13829,"_26574":115724,"_2824":51876},[],{"_3337":68933,"_29196":68790,"_20242":116089,"_5":13829,"_26574":115724,"_2824":116090},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3337":68934,"_29196":68790,"_20242":116092,"_5":13829,"_26574":115724,"_2824":116093},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3337":68935,"_29196":68790,"_20242":116095,"_5":13829,"_26574":115724,"_2824":115737},[],{"_3337":68936,"_29196":68790,"_20242":116097,"_5":13829,"_26574":115724,"_2824":51887},[],{"_3337":68937,"_29196":68790,"_20242":116099,"_5":13829,"_26574":115724,"_2824":116100},[],"Certificado / Dispositivo",{"_3337":68938,"_29196":68790,"_20242":116102,"_5":13829,"_26574":115724,"_2824":51893},[],{"_3337":68939,"_29196":68790,"_20242":116104,"_5":13829,"_26574":115724,"_2824":47924},[],{"_3337":68940,"_29196":68790,"_20242":116106,"_5":13829,"_26574":115724,"_2824":116107},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3337":68941,"_29196":68790,"_20242":116109,"_5":13829,"_26574":115724,"_2824":115791},[],{"_3337":68942,"_29196":68790,"_20242":116111,"_5":13829,"_26574":115728,"_2824":116112},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3337":68943,"_29196":68790,"_20242":116114,"_5":13829,"_26574":115728,"_2824":116115},[],"por el campo `registration.status` de los metadatos del conector en la CA:",{"_3337":68944,"_29196":68790,"_20242":116117,"_5":13829,"_26574":115728,"_2824":116118},[],"Transición",{"_3337":68945,"_29196":68790,"_20242":116120,"_5":13829,"_26574":115728,"_2824":116121},[],"Llamadas AWS",{"_3337":68946,"_29196":68790,"_20242":116123,"_5":13829,"_26574":115728,"_2824":116124},[],"`NoRegistrada` → `Solicitada`",{"_3337":68947,"_29196":68790,"_20242":116126,"_5":13829,"_26574":115728,"_2824":116127},[],"ninguna (solo escritura de metadatos)",{"_3337":68948,"_29196":68790,"_20242":116129,"_5":13829,"_26574":115728,"_2824":116130},[],"`Solicitada` → `Registrando`",{"_3337":68949,"_29196":68790,"_20242":116132,"_5":13829,"_26574":115728,"_2824":116133},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3337":68950,"_29196":68790,"_20242":116135,"_5":13829,"_26574":115728,"_2824":116136},[],"`Registrando` → `Completada`",{"_3337":68951,"_29196":68790,"_20242":116138,"_5":13829,"_26574":115728,"_2824":116139},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3337":68952,"_29196":68790,"_20242":116141,"_5":13829,"_26574":115728,"_2824":116142},[],"`Registrando` → `Fallida`",{"_3337":68953,"_29196":68790,"_20242":116144,"_5":13829,"_26574":115728,"_2824":116145},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3337":68954,"_29196":68790,"_20242":116147,"_5":13829,"_26574":115728,"_2824":116148},[],"`Fallida` / `Completada` → `Solicitada`",{"_3337":68955,"_29196":68790,"_20242":116150,"_5":13829,"_26574":115728,"_2824":116151},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3337":68956,"_29196":68790,"_20242":116153,"_5":13829,"_26574":115732,"_2824":116154},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3337":68957,"_29196":68790,"_20242":116156,"_5":13829,"_26574":115732,"_2824":116118},[],{"_3337":68958,"_29196":68790,"_20242":116158,"_5":13829,"_26574":115732,"_2824":116121},[],{"_3337":68959,"_29196":68790,"_20242":116160,"_5":13829,"_26574":115732,"_2824":116161},[],"`SinConfigurar` → `None` / `Auto`",{"_3337":68960,"_29196":68790,"_20242":116163,"_5":13829,"_26574":115732,"_2824":116164},[],"ninguna (solo configuración)",{"_3337":68961,"_29196":68790,"_20242":116166,"_5":13829,"_26574":115732,"_2824":51958},[],{"_3337":68962,"_29196":68790,"_20242":116168,"_5":13829,"_26574":115732,"_2824":116164},[],{"_3337":68963,"_29196":68790,"_20242":116170,"_5":13829,"_26574":115732,"_2824":116171},[],"Cualquiera → `Jitp`",{"_3337":68964,"_29196":68790,"_20242":116173,"_5":13829,"_26574":115732,"_2824":116174},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3337":68965,"_29196":68790,"_20242":116176,"_5":13829,"_26574":115732,"_2824":51969},[],{"_3337":68966,"_29196":68790,"_20242":116178,"_5":13829,"_26574":115732,"_2824":116179},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3337":68967,"_29196":68790,"_20242":116181,"_5":13829,"_26574":115736,"_2824":116182},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3337":68968,"_29196":68790,"_20242":116184,"_5":13829,"_26574":115736,"_2824":116118},[],{"_3337":68969,"_29196":68790,"_20242":116186,"_5":13829,"_26574":115736,"_2824":116121},[],{"_3337":68970,"_29196":68790,"_20242":116188,"_5":13829,"_26574":115736,"_2824":116189},[],"`NoSincronizado` → `Active`",{"_3337":68971,"_29196":68790,"_20242":116191,"_5":13829,"_26574":115736,"_2824":51626},[],{"_3337":68972,"_29196":68790,"_20242":116193,"_5":13829,"_26574":115736,"_2824":51987},[],{"_3337":68973,"_29196":68790,"_20242":116195,"_5":13829,"_26574":115736,"_2824":116196},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3337":68974,"_29196":68790,"_20242":116198,"_5":13829,"_26574":115736,"_2824":51993},[],{"_3337":68975,"_29196":68790,"_20242":116200,"_5":13829,"_26574":115736,"_2824":116196},[],{"_3337":68976,"_29196":68790,"_20242":116202,"_5":13829,"_26574":115736,"_2824":51998},[],{"_3337":68977,"_29196":68790,"_20242":116204,"_5":13829,"_26574":115736,"_2824":51626},[],{"_3337":68978,"_29196":68790,"_20242":116206,"_5":13829,"_26574":115736,"_2824":52003},[],{"_3337":68979,"_29196":68790,"_20242":116208,"_5":13829,"_26574":115736,"_2824":116209},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3337":68980,"_29196":68790,"_20242":116211,"_5":13829,"_26574":115740,"_2824":116212},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3337":68981,"_29196":68790,"_20242":116214,"_5":13829,"_26574":115740,"_2824":116118},[],{"_3337":68982,"_29196":68790,"_20242":116216,"_5":13829,"_26574":115740,"_2824":116121},[],{"_3337":68983,"_29196":68790,"_20242":116218,"_5":13829,"_26574":115740,"_2824":116219},[],"`Ausente` → `Aprovisionado`",{"_3337":68984,"_29196":68790,"_20242":116221,"_5":13829,"_26574":115740,"_2824":116222},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3337":68985,"_29196":68790,"_20242":116224,"_5":13829,"_26574":115740,"_2824":116225},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3337":68986,"_29196":68790,"_20242":116227,"_5":13829,"_26574":115740,"_2824":116228},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3337":68987,"_29196":68790,"_20242":116230,"_5":13829,"_26574":115740,"_2824":116231},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3337":68988,"_29196":68790,"_20242":116233,"_5":13829,"_26574":115744,"_2824":116234},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3337":68989,"_29196":68790,"_20242":116236,"_5":13829,"_26574":115748,"_2824":116237},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3337":68990,"_29196":68790,"_20242":116239,"_5":13829,"_26574":115748,"_2824":116240},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3337":68991,"_29196":68790,"_20242":116242,"_5":13829,"_26574":115752,"_2824":116243},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3337":68992,"_29196":68790,"_20242":116245,"_5":13829,"_26574":115752,"_2824":116246},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3337":68993,"_29196":68790,"_20242":116248,"_5":13829,"_26574":115752,"_2824":116249},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3337":68994,"_29196":68790,"_20242":116251,"_5":13829,"_26574":115752,"_2824":116252},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3337":68995,"_29196":68790,"_20242":116254,"_5":13829,"_26574":115752,"_2824":116255},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3337":68996,"_29196":68790,"_20242":116257,"_5":13829,"_26574":115752,"_2824":116258},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3337":68997,"_29196":68790,"_20242":116260,"_5":13829,"_26574":115755,"_2824":116261},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3337":68998,"_29196":68790,"_20242":116263,"_5":13829,"_26574":115758,"_2824":116264},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3337":68999,"_29196":68790,"_20242":116266,"_5":13829,"_26574":115758,"_2824":116267},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3337":69000,"_29196":68790,"_20242":116269,"_5":13829,"_26574":115762,"_2824":116270},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3337":69001,"_29196":68790,"_20242":116272,"_5":13829,"_26574":115766,"_2824":116273},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3337":69002,"_29196":68790,"_20242":116275,"_5":13829,"_26574":115766,"_2824":116276},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3337":69003,"_29196":68790,"_20242":116278,"_5":13829,"_26574":115766,"_2824":116279},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3337":69004,"_29196":68790,"_20242":116281,"_5":13829,"_26574":115766,"_2824":116282},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3337":69005,"_29196":68790,"_20242":116284,"_5":13829,"_26574":115766,"_2824":116285},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3337":69006,"_29196":68790,"_20242":116287,"_5":13829,"_26574":115766,"_2824":116288},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3337":69007,"_29196":68790,"_20242":116290,"_5":13829,"_26574":115770,"_2824":116291},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3337":69008,"_29196":68790,"_20242":116293,"_5":13829,"_26574":115770,"_2824":116294},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3337":69009,"_29196":68790,"_20242":116296,"_5":13829,"_26574":115770,"_2824":116297},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3337":69010,"_29196":68790,"_20242":116299,"_5":13829,"_26574":115770,"_2824":116300},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3337":69011,"_29196":68790,"_20242":116302,"_5":13829,"_26574":115770,"_2824":116303},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3337":69012,"_29196":68790,"_20242":116305,"_5":13829,"_26574":115774,"_2824":116306},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3337":69013,"_29196":68790,"_20242":116308,"_5":13829,"_26574":115774,"_2824":116309},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3337":69014,"_29196":68790,"_20242":116311,"_5":13829,"_26574":115774,"_2824":116312},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3337":69015,"_29196":68790,"_20242":116314,"_5":13829,"_26574":115778,"_2824":116315},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3337":69016,"_29196":68790,"_20242":116317,"_5":13829,"_26574":115778,"_2824":116318},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3337":69017,"_29196":68790,"_20242":116320,"_5":13829,"_26574":115778,"_2824":116321},[],"Para que el flujo JITP funcione correctamente:",{"_3337":69018,"_29196":68790,"_20242":116323,"_5":13829,"_26574":115778,"_2824":116324},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3337":69019,"_29196":68790,"_20242":116326,"_5":13829,"_26574":115778,"_2824":116327},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3337":69020,"_29196":68790,"_20242":116329,"_5":13829,"_26574":115778,"_2824":116330},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3337":69021,"_29196":68790,"_20242":116332,"_5":13829,"_26574":115778,"_2824":116333},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3337":69022,"_29196":68790,"_20242":116335,"_5":13829,"_26574":115782,"_2824":116336},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3337":69023,"_29196":68790,"_20242":116338,"_5":13829,"_26574":115782,"_2824":116339},[],"Estado en Lamassu",{"_3337":69024,"_29196":68790,"_20242":116341,"_5":13829,"_26574":115782,"_2824":116342},[],"Razón de revocación",{"_3337":69025,"_29196":68790,"_20242":116344,"_5":13829,"_26574":115782,"_2824":116345},[],"Estado en AWS IoT Core",{"_3337":69026,"_29196":68790,"_20242":116347,"_5":13829,"_26574":115782,"_2824":52148},[],{"_3337":69027,"_29196":68790,"_20242":116349,"_5":13829,"_26574":115782,"_2824":116350},[],"Ninguna",{"_3337":69028,"_29196":68790,"_20242":116352,"_5":13829,"_26574":115782,"_2824":52154},[],{"_3337":69029,"_29196":68790,"_20242":116354,"_5":13829,"_26574":115782,"_2824":52157},[],{"_3337":69030,"_29196":68790,"_20242":116356,"_5":13829,"_26574":115782,"_2824":52160},[],{"_3337":69031,"_29196":68790,"_20242":116358,"_5":13829,"_26574":115782,"_2824":52163},[],{"_3337":69032,"_29196":68790,"_20242":116360,"_5":13829,"_26574":115782,"_2824":52157},[],{"_3337":69033,"_29196":68790,"_20242":116362,"_5":13829,"_26574":115782,"_2824":116363},[],"Cualquier otra razón",{"_3337":69034,"_29196":68790,"_20242":116365,"_5":13829,"_26574":115782,"_2824":52171},[],{"_3337":69035,"_29196":68790,"_20242":116367,"_5":13829,"_26574":115782,"_2824":116368},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3337":69036,"_29196":68790,"_20242":116370,"_5":13829,"_26574":115786,"_2824":116371},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3337":69037,"_29196":68790,"_20242":116373,"_5":13829,"_26574":115786,"_2824":116374},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3337":69038,"_29196":68790,"_20242":116376,"_5":13829,"_26574":115786,"_2824":116377},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3337":69039,"_29196":68790,"_20242":116379,"_5":13829,"_26574":115790,"_2824":116380},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3337":69040,"_29196":68790,"_20242":116382,"_5":13829,"_26574":115790,"_2824":116383},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3337":69041,"_29196":68790,"_20242":116385,"_5":13829,"_26574":115794,"_2824":116386},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3337":69042,"_29196":68790,"_20242":116388,"_5":13829,"_26574":115794,"_2824":116389},[],"Existen dos tipos de acciones:",{"_3337":69043,"_29196":68790,"_20242":116391,"_5":13829,"_26574":115794,"_2824":116392},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3337":69044,"_29196":68790,"_20242":116394,"_5":13829,"_26574":115794,"_2824":116395},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3337":69045,"_29196":68790,"_20242":116397,"_5":13829,"_26574":115794,"_2824":116398},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3337":69046,"_29196":68790,"_20242":116400,"_5":13829,"_26574":115798,"_2824":116401},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3337":69047,"_29196":68790,"_20242":116403,"_5":13829,"_26574":115798,"_2824":116404},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3337":69048,"_29196":68790,"_20242":116406,"_5":13829,"_26574":115798,"_2824":116407},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3337":69049,"_29196":68790,"_20242":116409,"_5":13829,"_26574":115802,"_2824":116410},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3337":69050,"_29196":68790,"_20242":116412,"_5":13829,"_26574":115802,"_2824":116413},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3337":69051,"_29196":68790,"_20242":116415,"_5":13829,"_26574":115802,"_2824":116416},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3337":69052,"_29196":68790,"_20242":116418,"_5":13829,"_26574":115802,"_2824":116419},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3337":69053,"_29196":68790,"_20242":116421,"_5":13829,"_26574":115802,"_2824":116422},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3337":69054,"_29196":68790,"_20242":116424,"_5":13829,"_26574":115802,"_2824":116425},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3337":69055,"_29196":68790,"_20242":116427,"_5":13829,"_26574":115802,"_2824":116428},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3337":69056,"_29196":68790,"_20242":116430,"_5":13829,"_26574":115802,"_2824":116431},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3337":69057,"_29196":68790,"_20242":116433,"_5":13829,"_26574":115802,"_2824":116434},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3337":69058,"_29196":68790,"_20242":116436,"_5":13829,"_26574":115802,"_2824":116437},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3337":69059,"_29196":68790,"_20242":116439,"_5":13829,"_26574":115802,"_2824":116440},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3337":69060,"_29196":68790,"_20242":116442,"_5":13829,"_26574":115802,"_2824":116443},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3337":69061,"_29196":68790,"_20242":116445,"_5":13829,"_26574":115802,"_2824":116446},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3337":69062,"_29196":68790,"_20242":116448,"_5":13829,"_26574":115802,"_2824":116449},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3337":69063,"_29196":68790,"_20242":116451,"_5":13829,"_26574":115802,"_2824":116452},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3337":69064,"_29196":68790,"_20242":116454,"_5":13829,"_26574":115802,"_2824":116455},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3337":69065,"_29196":68790,"_20242":116457,"_5":13829,"_26574":115802,"_2824":116458},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3337":69066,"_29196":68790,"_20242":116460,"_5":13829,"_26574":115802,"_2824":116461},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3337":69067,"_29196":68790,"_20242":116463,"_5":13829,"_26574":115802,"_2824":116464},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3337":69068,"_29196":68790,"_20242":116466,"_5":13829,"_26574":115802,"_2824":116467},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3337":69069,"_29196":68790,"_20242":116469,"_5":13829,"_26574":115802,"_2824":116470},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3337":69070,"_29196":68790,"_20242":116472,"_5":13829,"_26574":115802,"_2824":116473},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3337":69071,"_29196":68790,"_20242":116475,"_5":13829,"_26574":115802,"_2824":116476},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3337":69072,"_29196":68790,"_20242":116478,"_5":13829,"_26574":115802,"_2824":116479},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3337":69073,"_29196":69073,"_5":14181,"_2824":49985,"_29540":116481,"_20242":116482,"_26574":69073},[47528,113284,49985],[],{"_3337":69074,"_29196":69073,"_20242":116484,"_5":13829,"_26574":69073,"_2824":116485},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3337":69075,"_29196":69073,"_5":29537,"_20242":116487,"_26574":116488,"_2824":116489},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3337":69076,"_29196":69073,"_5":29537,"_20242":116491,"_26574":116492,"_2824":114290},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3337":69077,"_29196":69073,"_5":29537,"_20242":116494,"_26574":116495,"_2824":114465},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3337":69078,"_29196":69073,"_5":29537,"_20242":116497,"_26574":116498,"_2824":115697},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/overview#integraciones",{"_3337":69079,"_29196":69073,"_5":29537,"_20242":116500,"_26574":116501,"_2824":116502},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3337":69080,"_29196":69073,"_20242":116504,"_5":13829,"_26574":69073,"_2824":116505},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3337":69081,"_29196":69073,"_20242":116507,"_5":13829,"_26574":116488,"_2824":116508},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3337":69082,"_29196":69073,"_20242":116510,"_5":13829,"_26574":116488,"_2824":116511},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3337":69083,"_29196":69073,"_20242":116513,"_5":13829,"_26574":116492,"_2824":116514},[],"Recurso",{"_3337":69084,"_29196":69073,"_20242":116516,"_5":13829,"_26574":116492,"_2824":116517},[],"Qué representa",{"_3337":69085,"_29196":69073,"_20242":116519,"_5":13829,"_26574":116492,"_2824":116520},[],"**Dispositivo**",{"_3337":69086,"_29196":69073,"_20242":116522,"_5":13829,"_26574":116492,"_2824":116523},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3337":69087,"_29196":69073,"_20242":116525,"_5":13829,"_26574":116492,"_2824":116526},[],"**Identidad**",{"_3337":69088,"_29196":69073,"_20242":116528,"_5":13829,"_26574":116492,"_2824":116529},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3337":69089,"_29196":69073,"_20242":116531,"_5":13829,"_26574":116492,"_2824":52338},[],{"_3337":69090,"_29196":69073,"_20242":116533,"_5":13829,"_26574":116492,"_2824":116534},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3337":69091,"_29196":69073,"_20242":116536,"_5":13829,"_26574":116492,"_2824":116537},[],"**Flota**",{"_3337":69092,"_29196":69073,"_20242":116539,"_5":13829,"_26574":116492,"_2824":116540},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3337":69093,"_29196":69073,"_20242":116542,"_5":13829,"_26574":116492,"_2824":116543},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3337":69094,"_29196":69073,"_20242":116545,"_5":13829,"_26574":116492,"_2824":116546},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3337":69095,"_29196":69073,"_20242":116548,"_5":13829,"_26574":116495,"_2824":116549},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3337":69096,"_29196":69073,"_20242":116551,"_5":13829,"_26574":116495,"_2824":116552},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3337":69097,"_29196":69073,"_20242":116554,"_5":13829,"_26574":116495,"_2824":116555},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3337":69098,"_29196":69073,"_20242":116557,"_5":13829,"_26574":116495,"_2824":116558},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3337":69099,"_29196":69073,"_20242":116560,"_5":13829,"_26574":116495,"_2824":116561},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3337":69100,"_29196":69073,"_20242":116563,"_5":13829,"_26574":116495,"_2824":116564},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3337":69101,"_29196":69073,"_20242":116566,"_5":13829,"_26574":116495,"_2824":116567},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3337":69102,"_29196":69073,"_20242":116569,"_5":13829,"_26574":116495,"_2824":116570},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3337":69103,"_29196":69073,"_20242":116572,"_5":13829,"_26574":116498,"_2824":116573},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3337":69104,"_29196":69073,"_20242":116575,"_5":13829,"_26574":116498,"_2824":116576},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3337":69105,"_29196":69073,"_20242":116578,"_5":13829,"_26574":116501,"_2824":116579},[],"Participante",{"_3337":69106,"_29196":69073,"_20242":116581,"_5":13829,"_26574":116501,"_2824":116582},[],"Responsabilidad",{"_3337":69107,"_29196":69073,"_20242":116584,"_5":13829,"_26574":116501,"_2824":116585},[],"Administrador PKI",{"_3337":69108,"_29196":69073,"_20242":116587,"_5":13829,"_26574":116501,"_2824":116588},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3337":69109,"_29196":69073,"_20242":116590,"_5":13829,"_26574":116501,"_2824":116591},[],"Administrador del aprovisionamiento",{"_3337":69110,"_29196":69073,"_20242":116593,"_5":13829,"_26574":116501,"_2824":116594},[],"DMS, admisión, autenticación por operación e inventario.",{"_3337":69111,"_29196":69073,"_20242":116596,"_5":13829,"_26574":116501,"_2824":116597},[],"Integrador del dispositivo",{"_3337":69112,"_29196":69073,"_20242":116599,"_5":13829,"_26574":116501,"_2824":116600},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3337":69113,"_29196":69073,"_20242":116602,"_5":13829,"_26574":116501,"_2824":116603},[],"Integrador del consumidor",{"_3337":69114,"_29196":69073,"_20242":116605,"_5":13829,"_26574":116501,"_2824":116606},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3337":69115,"_29196":69073,"_20242":116608,"_5":13829,"_26574":116501,"_2824":116609},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3337":69116,"_29196":69116,"_5":14181,"_2824":116611,"_29540":116612,"_20242":116614,"_26574":69116},"Enrola y conecta tu primer dispositivo",[47528,113284,49985,116613],"Primeros pasos",[],{"_3337":69117,"_29196":69116,"_20242":116616,"_5":13829,"_26574":69116,"_2824":116617},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3337":69118,"_29196":69116,"_5":29537,"_20242":116619,"_26574":116620,"_2824":111881},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3337":69119,"_29196":69116,"_5":29537,"_20242":116622,"_26574":116623,"_2824":116624},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3337":69120,"_29196":69116,"_5":29537,"_20242":116626,"_26574":116627,"_2824":116628},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3337":69121,"_29196":69116,"_5":29537,"_20242":116630,"_26574":116631,"_2824":116632},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3337":69122,"_29196":69116,"_5":29537,"_20242":116634,"_26574":116635,"_2824":116636},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3337":69123,"_29196":69116,"_5":29537,"_20242":116638,"_26574":116639,"_2824":116640},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3337":69124,"_29196":69116,"_5":29537,"_20242":116642,"_26574":116643,"_2824":116644},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3337":69125,"_29196":69116,"_5":29537,"_20242":116646,"_26574":116647,"_2824":116648},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3337":69126,"_29196":69116,"_20242":116650,"_5":13829,"_26574":69116,"_2824":116651},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3337":69127,"_29196":69116,"_20242":116653,"_5":13829,"_26574":116620,"_2824":116654},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3337":69128,"_29196":69116,"_20242":116656,"_5":13829,"_26574":116620,"_2824":116657},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3337":69129,"_29196":69116,"_20242":116659,"_5":13829,"_26574":116620,"_2824":116660},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3337":69130,"_29196":69116,"_20242":116662,"_5":13829,"_26574":116620,"_2824":116663},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3337":69131,"_29196":69116,"_20242":116665,"_5":13829,"_26574":116620,"_2824":116666},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3337":69132,"_29196":69116,"_20242":116668,"_5":13829,"_26574":116623,"_2824":116669},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3337":69133,"_29196":69116,"_20242":116671,"_5":13829,"_26574":116623,"_2824":116672},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3337":69134,"_29196":69116,"_20242":116674,"_5":13829,"_26574":116627,"_2824":116675},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3337":69135,"_29196":69116,"_20242":116677,"_5":13829,"_26574":116627,"_2824":116678},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3337":69136,"_29196":69116,"_20242":116680,"_5":13829,"_26574":116627,"_2824":116681},[],"Ajuste",{"_3337":69137,"_29196":69116,"_20242":116683,"_5":13829,"_26574":116627,"_2824":116684},[],"Valor de evaluación",{"_3337":69138,"_29196":69116,"_20242":116686,"_5":13829,"_26574":116627,"_2824":52494},[],{"_3337":69139,"_29196":69116,"_20242":116688,"_5":13829,"_26574":116627,"_2824":116689},[],"Raíz emisora de `device-root.pem`.",{"_3337":69140,"_29196":69116,"_20242":116691,"_5":13829,"_26574":116627,"_2824":114593},[],{"_3337":69141,"_29196":69116,"_20242":116693,"_5":13829,"_26574":116627,"_2824":116694},[],"Perfil final de 1 hora que acabas de preparar.",{"_3337":69142,"_29196":69116,"_20242":116696,"_5":13829,"_26574":116627,"_2824":52505},[],{"_3337":69143,"_29196":69116,"_20242":116698,"_5":13829,"_26574":116627,"_2824":52508},[],{"_3337":69144,"_29196":69116,"_20242":116700,"_5":13829,"_26574":116627,"_2824":52511},[],{"_3337":69145,"_29196":69116,"_20242":116702,"_5":13829,"_26574":116627,"_2824":116703},[],"Habilitado.",{"_3337":69146,"_29196":69116,"_20242":116705,"_5":13829,"_26574":116627,"_2824":52517},[],{"_3337":69147,"_29196":69116,"_20242":116707,"_5":13829,"_26574":116627,"_2824":116708},[],"Deshabilitado; el ID debe ser nuevo.",{"_3337":69148,"_29196":69116,"_20242":116710,"_5":13829,"_26574":116627,"_2824":116711},[],"Autenticación inicial",{"_3337":69149,"_29196":69116,"_20242":116713,"_5":13829,"_26574":116627,"_2824":116714},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3337":69150,"_29196":69116,"_20242":116716,"_5":13829,"_26574":116627,"_2824":116717},[],"Autenticación de renovación",{"_3337":69151,"_29196":69116,"_20242":116719,"_5":13829,"_26574":116627,"_2824":116720},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3337":69152,"_29196":69116,"_20242":116722,"_5":13829,"_26574":116627,"_2824":52535},[],{"_3337":69153,"_29196":69116,"_20242":116724,"_5":13829,"_26574":116627,"_2824":116725},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3337":69154,"_29196":69116,"_20242":116727,"_5":13829,"_26574":116627,"_2824":52541},[],{"_3337":69155,"_29196":69116,"_20242":116729,"_5":13829,"_26574":116627,"_2824":116730},[],"1 hora.",{"_3337":69156,"_29196":69116,"_20242":116732,"_5":13829,"_26574":116627,"_2824":52547},[],{"_3337":69157,"_29196":69116,"_20242":116734,"_5":13829,"_26574":116627,"_2824":116735},[],"30 minutos / 10 minutos.",{"_3337":69158,"_29196":69116,"_20242":116737,"_5":13829,"_26574":116627,"_2824":52553},[],{"_3337":69159,"_29196":69116,"_20242":116739,"_5":13829,"_26574":116627,"_2824":116740},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3337":69160,"_29196":69116,"_20242":116742,"_5":13829,"_26574":116627,"_2824":50304},[],{"_3337":69161,"_29196":69116,"_20242":116744,"_5":13829,"_26574":116627,"_2824":116745},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3337":69162,"_29196":69116,"_20242":116747,"_5":13829,"_26574":116627,"_2824":52564},[],{"_3337":69163,"_29196":69116,"_20242":116749,"_5":13829,"_26574":116627,"_2824":116750},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3337":69164,"_29196":69116,"_20242":116752,"_5":13829,"_26574":116627,"_2824":116753},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3337":69165,"_29196":69116,"_20242":116755,"_5":13829,"_26574":116631,"_2824":116756},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3337":69166,"_29196":69116,"_20242":116758,"_5":13829,"_26574":116631,"_2824":116759},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3337":69167,"_29196":69116,"_20242":116761,"_5":13829,"_26574":116635,"_2824":116762},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3337":69168,"_29196":69116,"_20242":116764,"_5":13829,"_26574":116635,"_2824":116765},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3337":69169,"_29196":69116,"_20242":116767,"_5":13829,"_26574":116635,"_2824":116768},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3337":69170,"_29196":69116,"_20242":116770,"_5":13829,"_26574":116639,"_2824":116771},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3337":69171,"_29196":69116,"_20242":116773,"_5":13829,"_26574":116639,"_2824":116774},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3337":69172,"_29196":69116,"_20242":116776,"_5":13829,"_26574":116643,"_2824":116777},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3337":69173,"_29196":69116,"_20242":116779,"_5":13829,"_26574":116643,"_2824":116780},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3337":69174,"_29196":69116,"_20242":116782,"_5":13829,"_26574":116643,"_2824":116783},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3337":69175,"_29196":69116,"_20242":116785,"_5":13829,"_26574":116643,"_2824":116786},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3337":69176,"_29196":69116,"_20242":116788,"_5":13829,"_26574":116643,"_2824":116789},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3337":69177,"_29196":69116,"_20242":116791,"_5":13829,"_26574":116647,"_2824":116792},[],"Comprobación",{"_3337":69178,"_29196":69116,"_20242":116794,"_5":13829,"_26574":116647,"_2824":116795},[],"Resultado esperado",{"_3337":69179,"_29196":69116,"_20242":116797,"_5":13829,"_26574":116647,"_2824":116798},[],"Registro",{"_3337":69180,"_29196":69116,"_20242":116800,"_5":13829,"_26574":116647,"_2824":116801},[],"ID creado automáticamente y DMS correcto.",{"_3337":69181,"_29196":69116,"_20242":116803,"_5":13829,"_26574":116647,"_2824":116085},[],{"_3337":69182,"_29196":69116,"_20242":116805,"_5":13829,"_26574":116647,"_2824":116806},[],"CN, perfil, serie y clave verificados.",{"_3337":69183,"_29196":69116,"_20242":116808,"_5":13829,"_26574":116647,"_2824":116809},[],"Inventario",{"_3337":69184,"_29196":69116,"_20242":116811,"_5":13829,"_26574":116647,"_2824":116812},[],"Serie recibida visible como identidad actual y en el historial.",{"_3337":69185,"_29196":69116,"_20242":116814,"_5":13829,"_26574":116647,"_2824":116815},[],"Consumidor",{"_3337":69186,"_29196":69116,"_20242":116817,"_5":13829,"_26574":116647,"_2824":116818},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3337":69187,"_29196":69116,"_20242":116820,"_5":13829,"_26574":116647,"_2824":116821},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3337":69188,"_29196":69116,"_20242":116823,"_5":13829,"_26574":116647,"_2824":116824},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3337":69189,"_29196":69189,"_5":14181,"_2824":114307,"_29540":116826,"_20242":116827,"_26574":69189},[47528,113284,49985,116613],[],{"_3337":69190,"_29196":69189,"_20242":116829,"_5":13829,"_26574":69189,"_2824":116830},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3337":69191,"_29196":69189,"_5":29537,"_20242":116832,"_26574":116833,"_2824":111881},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3337":69192,"_29196":69189,"_5":29537,"_20242":116835,"_26574":116836,"_2824":116837},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3337":69193,"_29196":69189,"_5":29537,"_20242":116839,"_26574":116840,"_2824":116841},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3337":69194,"_29196":69189,"_5":29537,"_20242":116843,"_26574":116844,"_2824":116845},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3337":69195,"_29196":69189,"_5":29537,"_20242":116847,"_26574":116848,"_2824":116849},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3337":69196,"_29196":69189,"_5":29537,"_20242":116851,"_26574":116852,"_2824":116853},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3337":69197,"_29196":69189,"_5":29537,"_20242":116855,"_26574":116856,"_2824":116795},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3337":69198,"_29196":69189,"_5":29537,"_20242":116858,"_26574":116859,"_2824":116860},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3337":69199,"_29196":69189,"_5":29537,"_20242":116862,"_26574":116863,"_2824":116864},[],"/docs/pr-preview/pr-57/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3337":69200,"_29196":69189,"_20242":116866,"_5":13829,"_26574":69189,"_2824":116867},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3337":69201,"_29196":69189,"_20242":116869,"_5":13829,"_26574":69189,"_2824":116870},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3337":69202,"_29196":69189,"_20242":116872,"_5":13829,"_26574":116833,"_2824":116873},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3337":69203,"_29196":69189,"_20242":116875,"_5":13829,"_26574":116833,"_2824":116876},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3337":69204,"_29196":69189,"_20242":116878,"_5":13829,"_26574":116833,"_2824":116879},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3337":69205,"_29196":69189,"_20242":116881,"_5":13829,"_26574":116833,"_2824":116882},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3337":69206,"_29196":69189,"_20242":116884,"_5":13829,"_26574":116836,"_2824":116885},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3337":69207,"_29196":69189,"_20242":116887,"_5":13829,"_26574":116836,"_2824":116888},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3337":69208,"_29196":69189,"_20242":116890,"_5":13829,"_26574":116836,"_2824":116891},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3337":69209,"_29196":69189,"_20242":116893,"_5":13829,"_26574":116836,"_2824":116894},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3337":69210,"_29196":69189,"_20242":116896,"_5":13829,"_26574":116836,"_2824":116897},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3337":69211,"_29196":69189,"_20242":116899,"_5":13829,"_26574":116836,"_2824":116900},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3337":69212,"_29196":69189,"_20242":116902,"_5":13829,"_26574":116836,"_2824":116903},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3337":69213,"_29196":69189,"_20242":116905,"_5":13829,"_26574":116836,"_2824":116906},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3337":69214,"_29196":69189,"_20242":116908,"_5":13829,"_26574":116840,"_2824":116909},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3337":69215,"_29196":69189,"_20242":116911,"_5":13829,"_26574":116840,"_2824":52729},[],{"_3337":69216,"_29196":69189,"_20242":116913,"_5":13829,"_26574":116840,"_2824":116914},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3337":69217,"_29196":69189,"_20242":116916,"_5":13829,"_26574":116840,"_2824":116917},[],"**Icon** y **Tags**: clasificación opcional.",{"_3337":69218,"_29196":69189,"_20242":116919,"_5":13829,"_26574":116840,"_2824":116920},[],"Confirma el registro.",{"_3337":69219,"_29196":69189,"_20242":116922,"_5":13829,"_26574":116844,"_2824":116923},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3337":69220,"_29196":69189,"_20242":116925,"_5":13829,"_26574":116844,"_2824":116926},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3337":69221,"_29196":69189,"_20242":116928,"_5":13829,"_26574":116848,"_2824":116929},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3337":69222,"_29196":69189,"_20242":116931,"_5":13829,"_26574":116848,"_2824":116932},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3337":69223,"_29196":69189,"_20242":116934,"_5":13829,"_26574":116852,"_2824":116935},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3337":69224,"_29196":69189,"_20242":116937,"_5":13829,"_26574":116852,"_2824":116938},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3337":69225,"_29196":69189,"_20242":116940,"_5":13829,"_26574":116856,"_2824":116792},[],{"_3337":69226,"_29196":69189,"_20242":116942,"_5":13829,"_26574":116856,"_2824":116943},[],"Resultado",{"_3337":69227,"_29196":69189,"_20242":116945,"_5":13829,"_26574":116856,"_2824":116071},[],{"_3337":69228,"_29196":69189,"_20242":116947,"_5":13829,"_26574":116856,"_2824":116948},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3337":69229,"_29196":69189,"_20242":116950,"_5":13829,"_26574":116856,"_2824":116951},[],"Identidad actual",{"_3337":69230,"_29196":69189,"_20242":116953,"_5":13829,"_26574":116856,"_2824":116954},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3337":69231,"_29196":69189,"_20242":116956,"_5":13829,"_26574":116856,"_2824":116957},[],"Historial",{"_3337":69232,"_29196":69189,"_20242":116959,"_5":13829,"_26574":116856,"_2824":116960},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3337":69233,"_29196":69189,"_20242":116962,"_5":13829,"_26574":116856,"_2824":116963},[],"Clave y certificado",{"_3337":69234,"_29196":69189,"_20242":116965,"_5":13829,"_26574":116856,"_2824":116966},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3337":69235,"_29196":69189,"_20242":116968,"_5":13829,"_26574":116859,"_2824":116969},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3337":69236,"_29196":69189,"_20242":116971,"_5":13829,"_26574":116859,"_2824":116972},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3337":69237,"_29196":69189,"_20242":116974,"_5":13829,"_26574":116859,"_2824":116975},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3337":69238,"_29196":69189,"_20242":116977,"_5":13829,"_26574":116859,"_2824":116978},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3337":69239,"_29196":69189,"_20242":116980,"_5":13829,"_26574":116863,"_2824":116981},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3337":69240,"_29196":69189,"_20242":116983,"_5":13829,"_26574":116863,"_2824":116984},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3337":69241,"_29196":69189,"_20242":116986,"_5":13829,"_26574":116863,"_2824":116987},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3337":69242,"_29196":69242,"_5":14181,"_2824":116989,"_29540":116990,"_20242":116991,"_26574":69242},"Plataforma Lamassu IoT",[47528,113284],[],{"_3337":69243,"_29196":69242,"_20242":116993,"_5":13829,"_26574":69242,"_2824":116994},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3337":69244,"_29196":69242,"_5":29537,"_20242":116996,"_26574":116997,"_2824":116489},[],"/docs/pr-preview/pr-57/es/platform/overview#empieza-aquí",{"_3337":69245,"_29196":69242,"_5":29537,"_20242":116999,"_26574":117000,"_2824":117001},[],"/docs/pr-preview/pr-57/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3337":69246,"_29196":69242,"_5":29537,"_20242":117003,"_26574":117004,"_2824":117005},[],"/docs/pr-preview/pr-57/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3337":69247,"_29196":69242,"_5":29537,"_20242":117007,"_26574":117008,"_2824":117009},[],"/docs/pr-preview/pr-57/es/platform/overview#capacidades-principales","Capacidades principales",{"_3337":69248,"_29196":69242,"_5":29537,"_20242":117011,"_26574":117012,"_2824":117013},[],"/docs/pr-preview/pr-57/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3337":69249,"_29196":69242,"_5":29537,"_20242":117015,"_26574":117016,"_2824":117017},[],"/docs/pr-preview/pr-57/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3337":69250,"_29196":69242,"_5":29537,"_20242":117019,"_26574":117020,"_2824":117021},[],"/docs/pr-preview/pr-57/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3337":69251,"_29196":69242,"_5":29537,"_20242":117023,"_26574":117024,"_2824":117025},[],"/docs/pr-preview/pr-57/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3337":69252,"_29196":69242,"_5":29537,"_20242":117027,"_26574":117028,"_2824":117029},[],"/docs/pr-preview/pr-57/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3337":69253,"_29196":69242,"_5":29537,"_20242":117031,"_26574":117032,"_2824":117033},[],"/docs/pr-preview/pr-57/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3337":69254,"_29196":69242,"_5":29537,"_20242":117035,"_26574":117036,"_2824":117037},[],"/docs/pr-preview/pr-57/es/platform/overview#referencia-operativa","Referencia operativa",{"_3337":69255,"_29196":69242,"_20242":117039,"_5":13829,"_26574":69242,"_2824":117040},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3337":69256,"_29196":69242,"_20242":117042,"_5":13829,"_26574":116997,"_2824":117043},[],"Elige el resultado que necesitas obtener:",{"_3337":69257,"_29196":69242,"_20242":117045,"_5":13829,"_26574":116997,"_2824":117046},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3337":69258,"_29196":69242,"_20242":117048,"_5":13829,"_26574":116997,"_2824":117049},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3337":69259,"_29196":69242,"_20242":117051,"_5":13829,"_26574":116997,"_2824":117052},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3337":69260,"_29196":69242,"_20242":117054,"_5":13829,"_26574":117000,"_2824":117055},[],"Bloque",{"_3337":69261,"_29196":69242,"_20242":117057,"_5":13829,"_26574":117000,"_2824":117058},[],"Qué gestionas",{"_3337":69262,"_29196":69242,"_20242":117060,"_5":13829,"_26574":117000,"_2824":117061},[],"Punto de entrada",{"_3337":69263,"_29196":69242,"_20242":117063,"_5":13829,"_26574":117000,"_2824":52882},[],{"_3337":69264,"_29196":69242,"_20242":117065,"_5":13829,"_26574":117000,"_2824":117066},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3337":69265,"_29196":69242,"_20242":117068,"_5":13829,"_26574":117000,"_2824":117069},[],"Visión general de PKI",{"_3337":69266,"_29196":69242,"_20242":117071,"_5":13829,"_26574":117000,"_2824":52891},[],{"_3337":69267,"_29196":69242,"_20242":117073,"_5":13829,"_26574":117000,"_2824":117074},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3337":69268,"_29196":69242,"_20242":117076,"_5":13829,"_26574":117000,"_2824":117077},[],"Visión general de IoT Fleets",{"_3337":69269,"_29196":69242,"_20242":117079,"_5":13829,"_26574":117000,"_2824":117080},[],"**Administración**",{"_3337":69270,"_29196":69242,"_20242":117082,"_5":13829,"_26574":117000,"_2824":117083},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3337":69271,"_29196":69242,"_20242":117085,"_5":13829,"_26574":117000,"_2824":113282},[],{"_3337":69272,"_29196":69242,"_20242":117087,"_5":13829,"_26574":117000,"_2824":117088},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3337":69273,"_29196":69242,"_20242":117090,"_5":13829,"_26574":117004,"_2824":117091},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3337":69274,"_29196":69242,"_20242":117093,"_5":13829,"_26574":117004,"_2824":117094},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3337":69275,"_29196":69242,"_20242":117096,"_5":13829,"_26574":117004,"_2824":117097},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3337":69276,"_29196":69242,"_20242":117099,"_5":13829,"_26574":117004,"_2824":117100},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3337":69277,"_29196":69242,"_20242":117102,"_5":13829,"_26574":117004,"_2824":117103},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3337":69278,"_29196":69242,"_20242":117105,"_5":13829,"_26574":117004,"_2824":117106},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3337":69279,"_29196":69242,"_20242":117108,"_5":13829,"_26574":117012,"_2824":117109},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3337":69280,"_29196":69242,"_20242":117111,"_5":13829,"_26574":117016,"_2824":117112},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3337":69281,"_29196":69242,"_20242":117114,"_5":13829,"_26574":117020,"_2824":117115},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3337":69282,"_29196":69242,"_20242":117117,"_5":13829,"_26574":117024,"_2824":117118},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3337":69283,"_29196":69242,"_20242":117120,"_5":13829,"_26574":117028,"_2824":117121},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3337":69284,"_29196":69242,"_20242":117123,"_5":13829,"_26574":117032,"_2824":117124},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3337":69285,"_29196":69242,"_20242":117126,"_5":13829,"_26574":117036,"_2824":116582},[],{"_3337":69286,"_29196":69242,"_20242":117128,"_5":13829,"_26574":117036,"_2824":117129},[],"Qué prepara o comprueba",{"_3337":69287,"_29196":69242,"_20242":117131,"_5":13829,"_26574":117036,"_2824":116585},[],{"_3337":69288,"_29196":69242,"_20242":117133,"_5":13829,"_26574":117036,"_2824":117134},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3337":69289,"_29196":69242,"_20242":117136,"_5":13829,"_26574":117036,"_2824":117137},[],"Administrador de la flota",{"_3337":69290,"_29196":69242,"_20242":117139,"_5":13829,"_26574":117036,"_2824":117140},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3337":69291,"_29196":69242,"_20242":117142,"_5":13829,"_26574":117036,"_2824":116597},[],{"_3337":69292,"_29196":69242,"_20242":117144,"_5":13829,"_26574":117036,"_2824":117145},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3337":69293,"_29196":69242,"_20242":117147,"_5":13829,"_26574":117036,"_2824":116603},[],{"_3337":69294,"_29196":69242,"_20242":117149,"_5":13829,"_26574":117036,"_2824":117150},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3337":69295,"_29196":69242,"_20242":117152,"_5":13829,"_26574":117036,"_2824":117153},[],"Operador de infraestructura",{"_3337":69296,"_29196":69242,"_20242":117155,"_5":13829,"_26574":117036,"_2824":117156},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3337":69297,"_29196":69242,"_20242":117158,"_5":13829,"_26574":117036,"_2824":117159},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3337":69298,"_29196":69298,"_5":14181,"_2824":117161,"_29540":117162,"_20242":117164,"_26574":69298},"Jerarquía y rotación de CAs",[47528,113284,52983,117163],"Claves, autoridades y certificados",[],{"_3337":69299,"_29196":69298,"_20242":117166,"_5":13829,"_26574":69298,"_2824":117167},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3337":69300,"_29196":69298,"_5":29537,"_20242":117169,"_26574":117170,"_2824":117171},[],"/docs/pr-preview/pr-57/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3337":69301,"_29196":69298,"_5":29537,"_20242":117173,"_26574":117174,"_2824":117175},[],"/docs/pr-preview/pr-57/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3337":69302,"_29196":69298,"_5":29537,"_20242":117177,"_26574":117178,"_2824":117179},[],"/docs/pr-preview/pr-57/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3337":69303,"_29196":69298,"_5":29537,"_20242":117181,"_26574":117182,"_2824":117183},[],"/docs/pr-preview/pr-57/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3337":69304,"_29196":69298,"_5":29537,"_20242":117185,"_26574":117186,"_2824":117187},[],"/docs/pr-preview/pr-57/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3337":69305,"_29196":69298,"_5":29537,"_20242":117189,"_26574":117190,"_2824":117191},[],"/docs/pr-preview/pr-57/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3337":69306,"_29196":69298,"_5":29537,"_20242":117193,"_26574":117194,"_2824":117195},[],"/docs/pr-preview/pr-57/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3337":69307,"_29196":69298,"_5":29537,"_20242":117197,"_26574":117198,"_2824":117199},[],"/docs/pr-preview/pr-57/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3337":69308,"_29196":69298,"_5":29537,"_20242":117201,"_26574":117202,"_2824":117203},[],"/docs/pr-preview/pr-57/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3337":69309,"_29196":69298,"_5":29537,"_20242":117205,"_26574":117206,"_2824":117207},[],"/docs/pr-preview/pr-57/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3337":69310,"_29196":69298,"_5":29537,"_20242":117209,"_26574":117210,"_2824":117211},[],"/docs/pr-preview/pr-57/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3337":69311,"_29196":69298,"_5":29537,"_20242":117213,"_26574":117214,"_2824":117215},[],"/docs/pr-preview/pr-57/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3337":69312,"_29196":69298,"_20242":117217,"_5":13829,"_26574":69298,"_2824":117218},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3337":69313,"_29196":69298,"_20242":117220,"_5":13829,"_26574":69298,"_2824":117221},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3337":69314,"_29196":69298,"_20242":117223,"_5":13829,"_26574":117170,"_2824":117224},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3337":69315,"_29196":69298,"_20242":117226,"_5":13829,"_26574":117170,"_2824":117227},[],"entorno, como producción y preproducción;",{"_3337":69316,"_29196":69298,"_20242":117229,"_5":13829,"_26574":117170,"_2824":117230},[],"propietario o equipo operador;",{"_3337":69317,"_29196":69298,"_20242":117232,"_5":13829,"_26574":117170,"_2824":117233},[],"familia de dispositivos o proceso de fabricación;",{"_3337":69318,"_29196":69298,"_20242":117235,"_5":13829,"_26574":117170,"_2824":117236},[],"región o requisito regulatorio;",{"_3337":69319,"_29196":69298,"_20242":117238,"_5":13829,"_26574":117170,"_2824":117239},[],"motor criptográfico o política de clave;",{"_3337":69320,"_29196":69298,"_20242":117241,"_5":13829,"_26574":117170,"_2824":117242},[],"ventana de mantenimiento y ritmo de renovación.",{"_3337":69321,"_29196":69298,"_20242":117244,"_5":13829,"_26574":117170,"_2824":117245},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3337":69322,"_29196":69298,"_20242":117247,"_5":13829,"_26574":117170,"_2824":117248},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3337":69323,"_29196":69298,"_20242":117250,"_5":13829,"_26574":117174,"_2824":117251},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3337":69324,"_29196":69298,"_20242":117253,"_5":13829,"_26574":117174,"_2824":117254},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3337":69325,"_29196":69298,"_20242":117256,"_5":13829,"_26574":117174,"_2824":117257},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3337":69326,"_29196":69298,"_20242":117259,"_5":13829,"_26574":117178,"_2824":117260},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3337":69327,"_29196":69298,"_20242":117262,"_5":13829,"_26574":117178,"_2824":117263},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3337":69328,"_29196":69298,"_20242":117265,"_5":13829,"_26574":117178,"_2824":117266},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3337":69329,"_29196":69298,"_20242":117268,"_5":13829,"_26574":117178,"_2824":117269},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3337":69330,"_29196":69298,"_20242":117271,"_5":13829,"_26574":117186,"_2824":117272},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3337":69331,"_29196":69298,"_20242":117274,"_5":13829,"_26574":117190,"_2824":117275},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3337":69332,"_29196":69298,"_20242":117277,"_5":13829,"_26574":117194,"_2824":117278},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3337":69333,"_29196":69298,"_20242":117280,"_5":13829,"_26574":117198,"_2824":117281},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3337":69334,"_29196":69298,"_20242":117283,"_5":13829,"_26574":117202,"_2824":117284},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3337":69335,"_29196":69298,"_20242":117286,"_5":13829,"_26574":117206,"_2824":117287},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3337":69336,"_29196":69298,"_20242":117289,"_5":13829,"_26574":117210,"_2824":117290},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3337":69337,"_29196":69298,"_20242":117292,"_5":13829,"_26574":117210,"_2824":117293},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3337":69338,"_29196":69298,"_20242":117295,"_5":13829,"_26574":117210,"_2824":117296},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3337":69339,"_29196":69298,"_20242":117298,"_5":13829,"_26574":117210,"_2824":117299},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3337":69340,"_29196":69298,"_20242":117301,"_5":13829,"_26574":117214,"_2824":117302},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3337":69341,"_29196":69298,"_20242":117304,"_5":13829,"_26574":117214,"_2824":117305},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3337":69342,"_29196":69298,"_20242":117307,"_5":13829,"_26574":117214,"_2824":117308},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3337":69343,"_29196":69298,"_20242":117310,"_5":13829,"_26574":117214,"_2824":117311},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3337":69344,"_29196":69298,"_20242":117313,"_5":13829,"_26574":117214,"_2824":117314},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3337":69345,"_29196":69298,"_20242":117316,"_5":13829,"_26574":117214,"_2824":117317},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3337":69346,"_29196":69298,"_20242":117319,"_5":13829,"_26574":117214,"_2824":117320},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3337":69347,"_29196":69347,"_5":14181,"_2824":117322,"_29540":117323,"_20242":117324,"_26574":69347},"Autoridades de certificación",[47528,113284,52983,117163],[],{"_3337":69348,"_29196":69347,"_20242":117326,"_5":13829,"_26574":69347,"_2824":117327},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3337":69349,"_29196":69347,"_5":29537,"_20242":117329,"_26574":117330,"_2824":117331},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3337":69350,"_29196":69347,"_5":29537,"_20242":117333,"_26574":117334,"_2824":117335},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3337":69351,"_29196":69347,"_5":29537,"_20242":117337,"_26574":117338,"_2824":111881},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3337":69352,"_29196":69347,"_5":29537,"_20242":117340,"_26574":117341,"_2824":117342},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3337":69353,"_29196":69347,"_5":29537,"_20242":117344,"_26574":117345,"_2824":117346},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3337":69354,"_29196":69347,"_5":29537,"_20242":117348,"_26574":117349,"_2824":117350},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3337":69355,"_29196":69347,"_5":29537,"_20242":117352,"_26574":117353,"_2824":117354},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3337":69356,"_29196":69347,"_5":29537,"_20242":117356,"_26574":117357,"_2824":117358},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3337":69357,"_29196":69347,"_5":29537,"_20242":117360,"_26574":117361,"_2824":117362},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3337":69358,"_29196":69347,"_5":29537,"_20242":117364,"_26574":117365,"_2824":117366},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3337":69359,"_29196":69347,"_5":29537,"_20242":117368,"_26574":117369,"_2824":117370},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3337":69360,"_29196":69347,"_5":29537,"_20242":117372,"_26574":117373,"_2824":117374},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3337":69361,"_29196":69347,"_5":29537,"_20242":117376,"_26574":117377,"_2824":117378},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3337":69362,"_29196":69347,"_5":29537,"_20242":117380,"_26574":117381,"_2824":117382},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3337":69363,"_29196":69347,"_5":29537,"_20242":117384,"_26574":117385,"_2824":117386},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3337":69364,"_29196":69347,"_5":29537,"_20242":117388,"_26574":117389,"_2824":117390},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3337":69365,"_29196":69347,"_5":29537,"_20242":117392,"_26574":117393,"_2824":117394},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3337":69366,"_29196":69347,"_5":29537,"_20242":117396,"_26574":117397,"_2824":117398},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3337":69367,"_29196":69347,"_5":29537,"_20242":117400,"_26574":117401,"_2824":117402},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3337":69368,"_29196":69347,"_5":29537,"_20242":117404,"_26574":117405,"_2824":117406},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3337":69369,"_29196":69347,"_5":29537,"_20242":117408,"_26574":117409,"_2824":117410},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3337":69370,"_29196":69347,"_5":29537,"_20242":117412,"_26574":117413,"_2824":117414},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3337":69371,"_29196":69347,"_5":29537,"_20242":117416,"_26574":117417,"_2824":117418},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3337":69372,"_29196":69347,"_20242":117420,"_5":13829,"_26574":69347,"_2824":117421},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3337":69373,"_29196":69347,"_20242":117423,"_5":13829,"_26574":69347,"_2824":117424},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3337":69374,"_29196":69347,"_20242":117426,"_5":13829,"_26574":69347,"_2824":117427},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3337":69375,"_29196":69347,"_20242":117429,"_5":13829,"_26574":117330,"_2824":117430},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3337":69376,"_29196":69347,"_20242":117432,"_5":13829,"_26574":117330,"_2824":117433},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3337":69377,"_29196":69347,"_20242":117435,"_5":13829,"_26574":117330,"_2824":117436},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3337":69378,"_29196":69347,"_20242":117438,"_5":13829,"_26574":117330,"_2824":117439},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3337":69379,"_29196":69347,"_20242":117441,"_5":13829,"_26574":117330,"_2824":117442},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3337":69380,"_29196":69347,"_20242":117444,"_5":13829,"_26574":117338,"_2824":117445},[],"Decide si la CA será raíz o intermedia.",{"_3337":69381,"_29196":69347,"_20242":117447,"_5":13829,"_26574":117338,"_2824":117448},[],"Elige el motor que custodiará la clave.",{"_3337":69382,"_29196":69347,"_20242":117450,"_5":13829,"_26574":117338,"_2824":117451},[],"Define una validez superior a la de los certificados que emitirá.",{"_3337":69383,"_29196":69347,"_20242":117453,"_5":13829,"_26574":117338,"_2824":117454},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3337":69384,"_29196":69347,"_20242":117456,"_5":13829,"_26574":117341,"_2824":117457},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3337":69385,"_29196":69347,"_20242":117459,"_5":13829,"_26574":117345,"_2824":117460},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3337":69386,"_29196":69347,"_20242":117462,"_5":13829,"_26574":117345,"_2824":117463},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3337":69387,"_29196":69347,"_20242":117465,"_5":13829,"_26574":117349,"_2824":117466},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3337":69388,"_29196":69347,"_20242":117468,"_5":13829,"_26574":117353,"_2824":117469},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3337":69389,"_29196":69347,"_20242":117471,"_5":13829,"_26574":117353,"_2824":117472},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3337":69390,"_29196":69347,"_20242":117474,"_5":13829,"_26574":117353,"_2824":117475},[],"`ST`: estado o provincia.",{"_3337":69391,"_29196":69347,"_20242":117477,"_5":13829,"_26574":117353,"_2824":117478},[],"`L`: localidad.",{"_3337":69392,"_29196":69347,"_20242":117480,"_5":13829,"_26574":117353,"_2824":117481},[],"`O`: organización.",{"_3337":69393,"_29196":69347,"_20242":117483,"_5":13829,"_26574":117353,"_2824":117484},[],"`OU`: unidad organizativa.",{"_3337":69394,"_29196":69347,"_20242":117486,"_5":13829,"_26574":117353,"_2824":117487},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3337":69395,"_29196":69347,"_20242":117489,"_5":13829,"_26574":117357,"_2824":117490},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3337":69396,"_29196":69347,"_20242":117492,"_5":13829,"_26574":117357,"_2824":117493},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3337":69397,"_29196":69347,"_20242":117495,"_5":13829,"_26574":117361,"_2824":117496},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3337":69398,"_29196":69347,"_20242":117498,"_5":13829,"_26574":117361,"_2824":117499},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3337":69399,"_29196":69347,"_20242":117501,"_5":13829,"_26574":117365,"_2824":117502},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3337":69400,"_29196":69347,"_20242":117504,"_5":13829,"_26574":117365,"_2824":117505},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3337":69401,"_29196":69347,"_20242":117507,"_5":13829,"_26574":117369,"_2824":117508},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3337":69402,"_29196":69347,"_20242":117510,"_5":13829,"_26574":117373,"_2824":117511},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3337":69403,"_29196":69347,"_20242":117513,"_5":13829,"_26574":117377,"_2824":117514},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3337":69404,"_29196":69347,"_20242":117516,"_5":13829,"_26574":117377,"_2824":117517},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3337":69405,"_29196":69347,"_20242":117519,"_5":13829,"_26574":117381,"_2824":117520},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3337":69406,"_29196":69347,"_20242":117522,"_5":13829,"_26574":117385,"_2824":117523},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3337":69407,"_29196":69347,"_20242":117525,"_5":13829,"_26574":117385,"_2824":117526},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3337":69408,"_29196":69347,"_20242":117528,"_5":13829,"_26574":117389,"_2824":117529},[],"Abre una CA desde el inventario para consultar:",{"_3337":69409,"_29196":69347,"_20242":117531,"_5":13829,"_26574":117389,"_2824":117532},[],"Estado y periodo de validez.",{"_3337":69410,"_29196":69347,"_20242":117534,"_5":13829,"_26574":117389,"_2824":117535},[],"Certificado y cadena en formato PEM.",{"_3337":69411,"_29196":69347,"_20242":117537,"_5":13829,"_26574":117389,"_2824":117538},[],"Número de certificados activos, expirados y revocados.",{"_3337":69412,"_29196":69347,"_20242":117540,"_5":13829,"_26574":117389,"_2824":117541},[],"Certificados emitidos en **Issued Certificates**.",{"_3337":69413,"_29196":69347,"_20242":117543,"_5":13829,"_26574":117389,"_2824":117544},[],"CRL vinculada a la autoridad.",{"_3337":69414,"_29196":69347,"_20242":117546,"_5":13829,"_26574":117389,"_2824":117547},[],"Metadatos y motor criptográfico asociado.",{"_3337":69415,"_29196":69347,"_20242":117549,"_5":13829,"_26574":117389,"_2824":117550},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3337":69416,"_29196":69347,"_20242":117552,"_5":13829,"_26574":117393,"_2824":117553},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3337":69417,"_29196":69347,"_20242":117555,"_5":13829,"_26574":117393,"_2824":117556},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3337":69418,"_29196":69347,"_20242":117558,"_5":13829,"_26574":117393,"_2824":117559},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3337":69419,"_29196":69347,"_20242":117561,"_5":13829,"_26574":117393,"_2824":117562},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3337":69420,"_29196":69347,"_20242":117564,"_5":13829,"_26574":117397,"_2824":117565},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3337":69421,"_29196":69347,"_20242":117567,"_5":13829,"_26574":117401,"_2824":117568},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3337":69422,"_29196":69347,"_20242":117570,"_5":13829,"_26574":117405,"_2824":117571},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3337":69423,"_29196":69347,"_20242":117573,"_5":13829,"_26574":117409,"_2824":117574},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3337":69424,"_29196":69347,"_20242":117576,"_5":13829,"_26574":117413,"_2824":117577},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3337":69425,"_29196":69347,"_20242":117579,"_5":13829,"_26574":117417,"_2824":117580},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3337":69426,"_29196":69347,"_20242":117582,"_5":13829,"_26574":117417,"_2824":117583},[],"El rol VA de la CA se conserva. Si no queda otra CA con el mismo SKI, deja de ser editable (consulta CRL), así que ajusta antes su validez y su firmante. La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3337":69427,"_29196":69347,"_20242":117585,"_5":13829,"_26574":117417,"_2824":117586},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. Si el certificado nuevo usa la misma clave, comparte el SKI con el rol VA retenido de la CA eliminada, cuyo firmante es el certificado antiguo: comprueba que la CRL se genera y, si no es así, asigna con `PUT` un firmante de la CA nueva (consulta CRL).",{"_3337":69428,"_29196":69428,"_5":14181,"_2824":117588,"_29540":117589,"_20242":117590,"_26574":69428},"Perfiles de certificado",[47528,113284,52983,117163],[],{"_3337":69429,"_29196":69428,"_20242":117592,"_5":13829,"_26574":69428,"_2824":117593},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3337":69430,"_29196":69428,"_5":29537,"_20242":117595,"_26574":117596,"_2824":117597},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3337":69431,"_29196":69428,"_5":29537,"_20242":117599,"_26574":117600,"_2824":117601},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#validez","Validez",{"_3337":69432,"_29196":69428,"_5":29537,"_20242":117603,"_26574":117604,"_2824":117605},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3337":69433,"_29196":69428,"_5":29537,"_20242":117607,"_26574":117608,"_2824":117609},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3337":69434,"_29196":69428,"_5":29537,"_20242":117611,"_26574":117612,"_2824":117613},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3337":69435,"_29196":69428,"_5":29537,"_20242":117615,"_26574":117616,"_2824":117617},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3337":69436,"_29196":69428,"_5":29537,"_20242":117619,"_26574":117620,"_2824":117621},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3337":69437,"_29196":69428,"_5":29537,"_20242":117623,"_26574":117624,"_2824":117625},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3337":69438,"_29196":69428,"_5":29537,"_20242":117627,"_26574":117628,"_2824":117629},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3337":69439,"_29196":69428,"_5":29537,"_20242":117631,"_26574":117632,"_2824":117633},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3337":69440,"_29196":69428,"_5":29537,"_20242":117635,"_26574":117636,"_2824":117637},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3337":69441,"_29196":69428,"_5":29537,"_20242":117639,"_26574":117640,"_2824":117641},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3337":69442,"_29196":69428,"_5":29537,"_20242":117643,"_26574":117644,"_2824":117645},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3337":69443,"_29196":69428,"_5":29537,"_20242":117647,"_26574":117648,"_2824":117649},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3337":69444,"_29196":69428,"_5":29537,"_20242":117651,"_26574":117652,"_2824":117653},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3337":69445,"_29196":69428,"_5":29537,"_20242":117655,"_26574":117656,"_2824":117657},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3337":69446,"_29196":69428,"_20242":117659,"_5":13829,"_26574":69428,"_2824":117660},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3337":69447,"_29196":69428,"_20242":117662,"_5":13829,"_26574":69428,"_2824":117663},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3337":69448,"_29196":69428,"_20242":117665,"_5":13829,"_26574":117600,"_2824":117666},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3337":69449,"_29196":69428,"_20242":117668,"_5":13829,"_26574":117600,"_2824":117669},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3337":69450,"_29196":69428,"_20242":117671,"_5":13829,"_26574":117604,"_2824":117672},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3337":69451,"_29196":69428,"_20242":117674,"_5":13829,"_26574":117608,"_2824":117675},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3337":69452,"_29196":69428,"_20242":117677,"_5":13829,"_26574":117608,"_2824":117678},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3337":69453,"_29196":69428,"_20242":117680,"_5":13829,"_26574":117608,"_2824":117681},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3337":69454,"_29196":69428,"_20242":117683,"_5":13829,"_26574":117612,"_2824":117684},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3337":69455,"_29196":69428,"_20242":117686,"_5":13829,"_26574":117616,"_2824":117687},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3337":69456,"_29196":69428,"_20242":117689,"_5":13829,"_26574":117616,"_2824":117690},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3337":69457,"_29196":69428,"_20242":117692,"_5":13829,"_26574":117620,"_2824":117693},[],"La aplicación criptográfica puede:",{"_3337":69458,"_29196":69428,"_20242":117695,"_5":13829,"_26574":117620,"_2824":117696},[],"permitir o bloquear claves RSA;",{"_3337":69459,"_29196":69428,"_20242":117698,"_5":13829,"_26574":117620,"_2824":117699},[],"limitar los tamaños RSA admitidos;",{"_3337":69460,"_29196":69428,"_20242":117701,"_5":13829,"_26574":117620,"_2824":117702},[],"permitir o bloquear claves ECDSA;",{"_3337":69461,"_29196":69428,"_20242":117704,"_5":13829,"_26574":117620,"_2824":117705},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3337":69462,"_29196":69428,"_20242":117707,"_5":13829,"_26574":117620,"_2824":117708},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3337":69463,"_29196":69428,"_20242":117710,"_5":13829,"_26574":117624,"_2824":117711},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3337":69464,"_29196":69428,"_20242":117713,"_5":13829,"_26574":117624,"_2824":113044},[],{"_3337":69465,"_29196":69428,"_20242":117715,"_5":13829,"_26574":117624,"_2824":117716},[],"Primera opción",{"_3337":69466,"_29196":69428,"_20242":117718,"_5":13829,"_26574":117624,"_2824":117719},[],"Segunda opción",{"_3337":69467,"_29196":69428,"_20242":117721,"_5":13829,"_26574":117624,"_2824":117722},[],"Si no hay ninguna",{"_3337":69468,"_29196":69428,"_20242":117724,"_5":13829,"_26574":117624,"_2824":117725},[],"Firma directa con una CA",{"_3337":69469,"_29196":69428,"_20242":117727,"_5":13829,"_26574":117624,"_2824":117728},[],"`issuance_profile` incluido en la solicitud",{"_3337":69470,"_29196":69428,"_20242":117730,"_5":13829,"_26574":117624,"_2824":117731},[],"`issuance_profile_id` de la solicitud",{"_3337":69471,"_29196":69428,"_20242":117733,"_5":13829,"_26574":117624,"_2824":117734},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3337":69472,"_29196":69428,"_20242":117736,"_5":13829,"_26574":117624,"_2824":117737},[],"Emisión mediante DMS",{"_3337":69473,"_29196":69428,"_20242":117739,"_5":13829,"_26574":117624,"_2824":53561},[],{"_3337":69474,"_29196":69428,"_20242":117741,"_5":13829,"_26574":117624,"_2824":117742},[],"`settings.issuance_profile` incluido en el DMS",{"_3337":69475,"_29196":69428,"_20242":117744,"_5":13829,"_26574":117624,"_2824":117745},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3337":69476,"_29196":69428,"_20242":117747,"_5":13829,"_26574":117624,"_2824":117748},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3337":69477,"_29196":69428,"_20242":117750,"_5":13829,"_26574":117624,"_2824":117751},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3337":69478,"_29196":69428,"_20242":117753,"_5":13829,"_26574":117632,"_2824":117754},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3337":69479,"_29196":69428,"_20242":117756,"_5":13829,"_26574":117636,"_2824":117757},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3337":69480,"_29196":69428,"_20242":117759,"_5":13829,"_26574":117640,"_2824":117760},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3337":69481,"_29196":69428,"_20242":117762,"_5":13829,"_26574":117644,"_2824":117763},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3337":69482,"_29196":69428,"_20242":117765,"_5":13829,"_26574":117648,"_2824":117766},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3337":69483,"_29196":69428,"_20242":117768,"_5":13829,"_26574":117648,"_2824":117769},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3337":69484,"_29196":69428,"_20242":117771,"_5":13829,"_26574":117652,"_2824":117772},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3337":69485,"_29196":69428,"_20242":117774,"_5":13829,"_26574":117652,"_2824":117775},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3337":69486,"_29196":69428,"_20242":117777,"_5":13829,"_26574":117652,"_2824":117778},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3337":69487,"_29196":69428,"_20242":117780,"_5":13829,"_26574":117652,"_2824":117781},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3337":69488,"_29196":69428,"_20242":117783,"_5":13829,"_26574":117656,"_2824":117784},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3337":69489,"_29196":69428,"_20242":117786,"_5":13829,"_26574":117656,"_2824":117787},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3337":69490,"_29196":69490,"_5":14181,"_2824":117789,"_29540":117790,"_20242":117792,"_26574":69490},"Validación de certificados",[47528,113284,52983,117791],"Validación",[],{"_3337":69491,"_29196":69490,"_20242":117794,"_5":13829,"_26574":69490,"_2824":117795},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3337":69492,"_29196":69490,"_5":29537,"_20242":117797,"_26574":117798,"_2824":117799},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3337":69493,"_29196":69490,"_5":29537,"_20242":117801,"_26574":117802,"_2824":117803},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3337":69494,"_29196":69490,"_5":29537,"_20242":117805,"_26574":117806,"_2824":117807},[],"/docs/pr-preview/pr-57/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3337":69495,"_29196":69490,"_20242":117809,"_5":13829,"_26574":69490,"_2824":117810},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3337":69496,"_29196":69490,"_20242":117812,"_5":13829,"_26574":117798,"_2824":117813},[],"Verifica estos criterios juntos:",{"_3337":69497,"_29196":69490,"_20242":117815,"_5":13829,"_26574":117798,"_2824":116792},[],{"_3337":69498,"_29196":69490,"_20242":117817,"_5":13829,"_26574":117798,"_2824":117818},[],"Resultado necesario",{"_3337":69499,"_29196":69490,"_20242":117820,"_5":13829,"_26574":117798,"_2824":117821},[],"Cadena y firma",{"_3337":69500,"_29196":69490,"_20242":117823,"_5":13829,"_26574":117798,"_2824":117824},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3337":69501,"_29196":69490,"_20242":117826,"_5":13829,"_26574":117798,"_2824":117827},[],"Fechas",{"_3337":69502,"_29196":69490,"_20242":117829,"_5":13829,"_26574":117798,"_2824":117830},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3337":69503,"_29196":69490,"_20242":117832,"_5":13829,"_26574":117798,"_2824":112954},[],{"_3337":69504,"_29196":69490,"_20242":117834,"_5":13829,"_26574":117798,"_2824":117835},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3337":69505,"_29196":69490,"_20242":117837,"_5":13829,"_26574":117798,"_2824":117838},[],"Uso",{"_3337":69506,"_29196":69490,"_20242":117840,"_5":13829,"_26574":117798,"_2824":117841},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3337":69507,"_29196":69490,"_20242":117843,"_5":13829,"_26574":117798,"_2824":117844},[],"Revocación",{"_3337":69508,"_29196":69490,"_20242":117846,"_5":13829,"_26574":117798,"_2824":117847},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3337":69509,"_29196":69490,"_20242":117849,"_5":13829,"_26574":117798,"_2824":117850},[],"Autorización",{"_3337":69510,"_29196":69490,"_20242":117852,"_5":13829,"_26574":117798,"_2824":117853},[],"La aplicación permite la acción a esa identidad.",{"_3337":69511,"_29196":69490,"_20242":117855,"_5":13829,"_26574":117798,"_2824":117856},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3337":69512,"_29196":69490,"_20242":117858,"_5":13829,"_26574":117802,"_2824":117859},[],"Mecanismo",{"_3337":69513,"_29196":69490,"_20242":117861,"_5":13829,"_26574":117802,"_2824":117862},[],"Cuándo utilizarlo",{"_3337":69514,"_29196":69490,"_20242":117864,"_5":13829,"_26574":117802,"_2824":117865},[],"Qué debes mantener",{"_3337":69515,"_29196":69490,"_20242":117867,"_5":13829,"_26574":117802,"_2824":53689},[],{"_3337":69516,"_29196":69490,"_20242":117869,"_5":13829,"_26574":117802,"_2824":117870},[],"Consulta del estado de un certificado concreto.",{"_3337":69517,"_29196":69490,"_20242":117872,"_5":13829,"_26574":117802,"_2824":117873},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3337":69518,"_29196":69490,"_20242":117875,"_5":13829,"_26574":117802,"_2824":53698},[],{"_3337":69519,"_29196":69490,"_20242":117877,"_5":13829,"_26574":117802,"_2824":117878},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3337":69520,"_29196":69490,"_20242":117880,"_5":13829,"_26574":117802,"_2824":117881},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3337":69521,"_29196":69490,"_20242":117883,"_5":13829,"_26574":117802,"_2824":117884},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3337":69522,"_29196":69490,"_20242":117886,"_5":13829,"_26574":117802,"_2824":117887},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3337":69523,"_29196":69490,"_20242":117889,"_5":13829,"_26574":117806,"_2824":117890},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3337":69524,"_29196":69490,"_20242":117892,"_5":13829,"_26574":117806,"_2824":117893},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3337":69525,"_29196":69490,"_20242":117895,"_5":13829,"_26574":117806,"_2824":117896},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3337":69526,"_29196":69490,"_20242":117898,"_5":13829,"_26574":117806,"_2824":117899},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3337":69527,"_29196":69490,"_20242":117901,"_5":13829,"_26574":117806,"_2824":117902},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3337":69528,"_29196":69490,"_20242":117904,"_5":13829,"_26574":117806,"_2824":117905},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3337":69529,"_29196":69490,"_20242":117907,"_5":13829,"_26574":117806,"_2824":117908},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3337":69530,"_29196":69490,"_20242":117910,"_5":13829,"_26574":117806,"_2824":117911},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3337":69531,"_29196":69490,"_20242":117913,"_5":13829,"_26574":117806,"_2824":117914},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3337":69532,"_29196":69532,"_5":14181,"_2824":117916,"_29540":117917,"_20242":117918,"_26574":69532},"Certificados",[47528,113284,52983,117163],[],{"_3337":69533,"_29196":69532,"_20242":117920,"_5":13829,"_26574":69532,"_2824":117921},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3337":69534,"_29196":69532,"_5":29537,"_20242":117923,"_26574":117924,"_2824":117925},[],"/docs/pr-preview/pr-57/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3337":69535,"_29196":69532,"_5":29537,"_20242":117927,"_26574":117928,"_2824":117929},[],"/docs/pr-preview/pr-57/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3337":69536,"_29196":69532,"_5":29537,"_20242":117931,"_26574":117932,"_2824":117933},[],"/docs/pr-preview/pr-57/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3337":69537,"_29196":69532,"_5":29537,"_20242":117935,"_26574":117936,"_2824":117937},[],"/docs/pr-preview/pr-57/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3337":69538,"_29196":69532,"_5":29537,"_20242":117939,"_26574":117940,"_2824":117941},[],"/docs/pr-preview/pr-57/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3337":69539,"_29196":69532,"_5":29537,"_20242":117943,"_26574":117944,"_2824":117945},[],"/docs/pr-preview/pr-57/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3337":69540,"_29196":69532,"_5":29537,"_20242":117947,"_26574":117948,"_2824":117949},[],"/docs/pr-preview/pr-57/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3337":69541,"_29196":69532,"_5":29537,"_20242":117951,"_26574":117952,"_2824":117953},[],"/docs/pr-preview/pr-57/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3337":69542,"_29196":69532,"_5":29537,"_20242":117955,"_26574":117956,"_2824":117957},[],"/docs/pr-preview/pr-57/es/platform/pki/certificates#continúa","Continúa",{"_3337":69543,"_29196":69532,"_20242":117959,"_5":13829,"_26574":69532,"_2824":117960},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3337":69544,"_29196":69532,"_20242":117962,"_5":13829,"_26574":117924,"_2824":117963},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3337":69545,"_29196":69532,"_20242":117965,"_5":13829,"_26574":117924,"_2824":117966},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3337":69546,"_29196":69532,"_20242":117968,"_5":13829,"_26574":117924,"_2824":117969},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3337":69547,"_29196":69532,"_20242":117971,"_5":13829,"_26574":117928,"_2824":117972},[],"Descarga el PEM e inspecciónalo:",{"_3337":69548,"_29196":69532,"_20242":117974,"_5":13829,"_26574":117928,"_2824":117975},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3337":69549,"_29196":69532,"_20242":117977,"_5":13829,"_26574":117932,"_2824":117978},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3337":69550,"_29196":69532,"_20242":117980,"_5":13829,"_26574":117932,"_2824":117981},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3337":69551,"_29196":69532,"_20242":117983,"_5":13829,"_26574":117932,"_2824":117984},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3337":69552,"_29196":69532,"_20242":117986,"_5":13829,"_26574":117932,"_2824":117987},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3337":69553,"_29196":69532,"_20242":117989,"_5":13829,"_26574":117932,"_2824":117990},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3337":69554,"_29196":69532,"_20242":117992,"_5":13829,"_26574":117932,"_2824":117993},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3337":69555,"_29196":69532,"_20242":117995,"_5":13829,"_26574":117932,"_2824":117996},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3337":69556,"_29196":69532,"_20242":117998,"_5":13829,"_26574":117936,"_2824":117999},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3337":69557,"_29196":69532,"_20242":118001,"_5":13829,"_26574":117940,"_2824":118002},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3337":69558,"_29196":69532,"_20242":118004,"_5":13829,"_26574":117944,"_2824":118005},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3337":69559,"_29196":69532,"_20242":118007,"_5":13829,"_26574":117948,"_2824":118008},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3337":69560,"_29196":69532,"_20242":118010,"_5":13829,"_26574":117948,"_2824":118011},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3337":69561,"_29196":69532,"_20242":118013,"_5":13829,"_26574":117948,"_2824":118014},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3337":69562,"_29196":69532,"_20242":118016,"_5":13829,"_26574":117952,"_2824":118017},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3337":69563,"_29196":69532,"_20242":118019,"_5":13829,"_26574":117952,"_2824":118020},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3337":69564,"_29196":69532,"_20242":118022,"_5":13829,"_26574":117952,"_2824":118023},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3337":69565,"_29196":69532,"_20242":118025,"_5":13829,"_26574":117956,"_2824":118026},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3337":69566,"_29196":69532,"_20242":118028,"_5":13829,"_26574":117956,"_2824":118029},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3337":69567,"_29196":69567,"_5":14181,"_2824":118031,"_29540":118032,"_20242":118034,"_26574":69567},"Ciclo de vida de un certificado",[47528,113284,52983,118033],"Conceptos",[],{"_3337":69568,"_29196":69567,"_20242":118036,"_5":13829,"_26574":69567,"_2824":118037},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3337":69569,"_29196":69567,"_5":29537,"_20242":118039,"_26574":118040,"_2824":118041},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3337":69570,"_29196":69567,"_5":29537,"_20242":118043,"_26574":118044,"_2824":118045},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3337":69571,"_29196":69567,"_5":29537,"_20242":118047,"_26574":118048,"_2824":118049},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3337":69572,"_29196":69567,"_5":29537,"_20242":118051,"_26574":118052,"_2824":118053},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3337":69573,"_29196":69567,"_5":29537,"_20242":118055,"_26574":118056,"_2824":118057},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3337":69574,"_29196":69567,"_5":29537,"_20242":118059,"_26574":118060,"_2824":118061},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3337":69575,"_29196":69567,"_5":29537,"_20242":118063,"_26574":118064,"_2824":115737},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3337":69576,"_29196":69567,"_5":29537,"_20242":118066,"_26574":118067,"_2824":118068},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3337":69577,"_29196":69567,"_5":29537,"_20242":118070,"_26574":118071,"_2824":118072},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3337":69578,"_29196":69567,"_5":29537,"_20242":118074,"_26574":118075,"_2824":118076},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3337":69579,"_29196":69567,"_20242":118078,"_5":13829,"_26574":69567,"_2824":118079},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3337":69580,"_29196":69567,"_20242":118081,"_5":13829,"_26574":118044,"_2824":118082},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3337":69581,"_29196":69567,"_20242":118084,"_5":13829,"_26574":118048,"_2824":118085},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3337":69582,"_29196":69567,"_20242":118087,"_5":13829,"_26574":118052,"_2824":118088},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3337":69583,"_29196":69567,"_20242":118090,"_5":13829,"_26574":118056,"_2824":118091},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3337":69584,"_29196":69567,"_20242":118093,"_5":13829,"_26574":118060,"_2824":118094},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3337":69585,"_29196":69567,"_20242":118096,"_5":13829,"_26574":118064,"_2824":118097},[],"Lamassu persiste cuatro estados X.509:",{"_3337":69586,"_29196":69567,"_20242":118099,"_5":13829,"_26574":118064,"_2824":118100},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3337":69587,"_29196":69567,"_20242":118102,"_5":13829,"_26574":118064,"_2824":118103},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3337":69588,"_29196":69567,"_20242":118105,"_5":13829,"_26574":118064,"_2824":118106},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3337":69589,"_29196":69567,"_20242":118108,"_5":13829,"_26574":118064,"_2824":118109},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3337":69590,"_29196":69567,"_20242":118111,"_5":13829,"_26574":118064,"_2824":118112},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3337":69591,"_29196":69567,"_20242":118114,"_5":13829,"_26574":118067,"_2824":118115},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3337":69592,"_29196":69567,"_20242":118117,"_5":13829,"_26574":118067,"_2824":118118},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3337":69593,"_29196":69567,"_20242":118120,"_5":13829,"_26574":118067,"_2824":118121},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3337":69594,"_29196":69567,"_20242":118123,"_5":13829,"_26574":118071,"_2824":118124},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3337":69595,"_29196":69567,"_20242":118126,"_5":13829,"_26574":118071,"_2824":118127},[],"Antes de confirmar:",{"_3337":69596,"_29196":69567,"_20242":118129,"_5":13829,"_26574":118071,"_2824":118130},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3337":69597,"_29196":69567,"_20242":118132,"_5":13829,"_26574":118071,"_2824":118133},[],"Distribuye la nueva cadena de confianza.",{"_3337":69598,"_29196":69567,"_20242":118135,"_5":13829,"_26574":118071,"_2824":118136},[],"Reemite las identidades necesarias.",{"_3337":69599,"_29196":69567,"_20242":118138,"_5":13829,"_26574":118071,"_2824":118139},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3337":69600,"_29196":69567,"_20242":118141,"_5":13829,"_26574":118071,"_2824":118142},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3337":69601,"_29196":69567,"_20242":118144,"_5":13829,"_26574":118071,"_2824":118145},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3337":69602,"_29196":69567,"_20242":118147,"_5":13829,"_26574":118075,"_2824":118148},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3337":69603,"_29196":69567,"_20242":118150,"_5":13829,"_26574":118075,"_2824":118151},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3337":69604,"_29196":69567,"_20242":118153,"_5":13829,"_26574":118075,"_2824":118154},[],"Cambios de estado y razones de revocación.",{"_3337":69605,"_29196":69567,"_20242":118156,"_5":13829,"_26574":118075,"_2824":118157},[],"Publicación y vigencia de OCSP y CRLs.",{"_3337":69606,"_29196":69567,"_20242":118159,"_5":13829,"_26574":118075,"_2824":118160},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3337":69607,"_29196":69567,"_20242":118162,"_5":13829,"_26574":118075,"_2824":118163},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3337":69608,"_29196":69608,"_5":14181,"_2824":118165,"_29540":118166,"_20242":118167,"_26574":69608},"Modelo de confianza",[47528,113284,52983,118033],[],{"_3337":69609,"_29196":69608,"_20242":118169,"_5":13829,"_26574":69608,"_2824":118170},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3337":69610,"_29196":69608,"_5":29537,"_20242":118172,"_26574":118173,"_2824":118174},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3337":69611,"_29196":69608,"_5":29537,"_20242":118176,"_26574":118177,"_2824":118178},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3337":69612,"_29196":69608,"_5":29537,"_20242":118180,"_26574":118181,"_2824":118182},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3337":69613,"_29196":69608,"_5":29537,"_20242":118184,"_26574":118185,"_2824":118186},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3337":69614,"_29196":69608,"_5":29537,"_20242":118188,"_26574":118189,"_2824":118190},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3337":69615,"_29196":69608,"_5":29537,"_20242":118192,"_26574":118193,"_2824":118194},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3337":69616,"_29196":69608,"_5":29537,"_20242":118196,"_26574":118197,"_2824":118198},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3337":69617,"_29196":69608,"_5":29537,"_20242":118200,"_26574":118201,"_2824":118202},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3337":69618,"_29196":69608,"_5":29537,"_20242":118204,"_26574":118205,"_2824":118206},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3337":69619,"_29196":69608,"_5":29537,"_20242":118208,"_26574":118209,"_2824":118210},[],"/docs/pr-preview/pr-57/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3337":69620,"_29196":69608,"_20242":118212,"_5":13829,"_26574":69608,"_2824":118213},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3337":69621,"_29196":69608,"_20242":118215,"_5":13829,"_26574":118177,"_2824":118216},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3337":69622,"_29196":69608,"_20242":118218,"_5":13829,"_26574":118181,"_2824":118219},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3337":69623,"_29196":69608,"_20242":118221,"_5":13829,"_26574":118185,"_2824":118222},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3337":69624,"_29196":69608,"_20242":118224,"_5":13829,"_26574":118189,"_2824":118225},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3337":69625,"_29196":69608,"_20242":118227,"_5":13829,"_26574":118193,"_2824":118228},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3337":69626,"_29196":69608,"_20242":118230,"_5":13829,"_26574":118193,"_2824":118231},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3337":69627,"_29196":69608,"_20242":118233,"_5":13829,"_26574":118193,"_2824":118234},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3337":69628,"_29196":69608,"_20242":118236,"_5":13829,"_26574":118193,"_2824":118237},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3337":69629,"_29196":69608,"_20242":118239,"_5":13829,"_26574":118193,"_2824":118240},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3337":69630,"_29196":69608,"_20242":118242,"_5":13829,"_26574":118193,"_2824":118243},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3337":69631,"_29196":69608,"_20242":118245,"_5":13829,"_26574":118197,"_2824":118246},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3337":69632,"_29196":69608,"_20242":118248,"_5":13829,"_26574":118197,"_2824":118249},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3337":69633,"_29196":69608,"_20242":118251,"_5":13829,"_26574":118197,"_2824":118252},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3337":69634,"_29196":69608,"_20242":118254,"_5":13829,"_26574":118197,"_2824":118255},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3337":69635,"_29196":69608,"_20242":118257,"_5":13829,"_26574":118197,"_2824":118258},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3337":69636,"_29196":69608,"_20242":118260,"_5":13829,"_26574":118201,"_2824":118261},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3337":69637,"_29196":69608,"_20242":118263,"_5":13829,"_26574":118201,"_2824":118264},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3337":69638,"_29196":69608,"_20242":118266,"_5":13829,"_26574":118201,"_2824":118267},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3337":69639,"_29196":69608,"_20242":118269,"_5":13829,"_26574":118201,"_2824":118270},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3337":69640,"_29196":69608,"_20242":118272,"_5":13829,"_26574":118201,"_2824":118273},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3337":69641,"_29196":69608,"_20242":118275,"_5":13829,"_26574":118201,"_2824":118276},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3337":69642,"_29196":69608,"_20242":118278,"_5":13829,"_26574":118201,"_2824":118279},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3337":69643,"_29196":69608,"_20242":118281,"_5":13829,"_26574":118205,"_2824":118282},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3337":69644,"_29196":69608,"_20242":118284,"_5":13829,"_26574":118209,"_2824":118285},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3337":69645,"_29196":69608,"_20242":118287,"_5":13829,"_26574":118209,"_2824":118288},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3337":69646,"_29196":69608,"_20242":118290,"_5":13829,"_26574":118209,"_2824":118291},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3337":69647,"_29196":69608,"_20242":118293,"_5":13829,"_26574":118209,"_2824":118294},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3337":69648,"_29196":69608,"_20242":118296,"_5":13829,"_26574":118209,"_2824":118297},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3337":69649,"_29196":69608,"_20242":118299,"_5":13829,"_26574":118209,"_2824":118300},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3337":69650,"_29196":69608,"_20242":118302,"_5":13829,"_26574":118209,"_2824":118303},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3337":69651,"_29196":69651,"_5":14181,"_2824":118305,"_29540":118306,"_20242":118307,"_26574":69651},"Listas de revocación (CRL)",[47528,113284,52983,117791],[],{"_3337":69652,"_29196":69651,"_20242":118309,"_5":13829,"_26574":69651,"_2824":118310},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3337":69653,"_29196":69651,"_5":29537,"_20242":118312,"_26574":118313,"_2824":118314},[],"/docs/pr-preview/pr-57/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3337":69654,"_29196":69651,"_5":29537,"_20242":118316,"_26574":118317,"_2824":118318},[],"/docs/pr-preview/pr-57/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3337":69655,"_29196":69651,"_5":29537,"_20242":118320,"_26574":118321,"_2824":118322},[],"/docs/pr-preview/pr-57/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3337":69656,"_29196":69651,"_5":29537,"_20242":118324,"_26574":118325,"_2824":118326},[],"/docs/pr-preview/pr-57/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3337":69657,"_29196":69651,"_5":29537,"_20242":118328,"_26574":118329,"_2824":118330},[],"/docs/pr-preview/pr-57/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3337":69658,"_29196":69651,"_5":29537,"_20242":118332,"_26574":118333,"_2824":118334},[],"/docs/pr-preview/pr-57/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3337":69659,"_29196":69651,"_5":29537,"_20242":118336,"_26574":118337,"_2824":118338},[],"/docs/pr-preview/pr-57/es/platform/pki/crl#errores-frecuentes-del-rol-va","Errores frecuentes del rol VA",{"_3337":69660,"_29196":69651,"_5":29537,"_20242":118340,"_26574":118341,"_2824":118342},[],"/docs/pr-preview/pr-57/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3337":69661,"_29196":69651,"_5":29537,"_20242":118344,"_26574":118345,"_2824":118346},[],"/docs/pr-preview/pr-57/es/platform/pki/crl#referencias","Referencias",{"_3337":69662,"_29196":69651,"_20242":118348,"_5":13829,"_26574":69651,"_2824":118349},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3337":69663,"_29196":69651,"_20242":118351,"_5":13829,"_26574":118313,"_2824":118352},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3337":69664,"_29196":69651,"_20242":118354,"_5":13829,"_26574":118313,"_2824":118355},[],"Campo de `crl_options`",{"_3337":69665,"_29196":69651,"_20242":118357,"_5":13829,"_26574":118313,"_2824":114819},[],{"_3337":69666,"_29196":69651,"_20242":118359,"_5":13829,"_26574":118313,"_2824":118360},[],"Valor inicial del backend",{"_3337":69667,"_29196":69651,"_20242":118362,"_5":13829,"_26574":118313,"_2824":54187},[],{"_3337":69668,"_29196":69651,"_20242":118364,"_5":13829,"_26574":118313,"_2824":118365},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3337":69669,"_29196":69651,"_20242":118367,"_5":13829,"_26574":118313,"_2824":118368},[],"7 días.",{"_3337":69670,"_29196":69651,"_20242":118370,"_5":13829,"_26574":118313,"_2824":54196},[],{"_3337":69671,"_29196":69651,"_20242":118372,"_5":13829,"_26574":118313,"_2824":118373},[],"Regenerar la lista cuando el intervalo transcurra desde la última emisión, además de la regeneración previa al vencimiento; `0` deshabilita la regeneración por intervalo. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3337":69672,"_29196":69651,"_20242":118375,"_5":13829,"_26574":118313,"_2824":118376},[],"6 días y 23 horas.",{"_3337":69673,"_29196":69651,"_20242":118378,"_5":13829,"_26574":118313,"_2824":54205},[],{"_3337":69674,"_29196":69651,"_20242":118380,"_5":13829,"_26574":118313,"_2824":118381},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3337":69675,"_29196":69651,"_20242":118383,"_5":13829,"_26574":118313,"_2824":54211},[],{"_3337":69676,"_29196":69651,"_20242":118385,"_5":13829,"_26574":118313,"_2824":54214},[],{"_3337":69677,"_29196":69651,"_20242":118387,"_5":13829,"_26574":118313,"_2824":118388},[],"Número de serie del certificado existente que firma la CRL.",{"_3337":69678,"_29196":69651,"_20242":118390,"_5":13829,"_26574":118313,"_2824":118391},[],"Número de serie del certificado actual de la CA.",{"_3337":69679,"_29196":69651,"_20242":118393,"_5":13829,"_26574":118313,"_2824":118394},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3337":69680,"_29196":69651,"_20242":118396,"_5":13829,"_26574":118313,"_2824":118397},[],"Al reemitir una CA, la VA mueve el firmante del rol al certificado reemitido y regenera la CRL inmediatamente, siempre que el rol estuviera firmado por el certificado sustituido; un firmante asignado deliberadamente a otro certificado se conserva. Si el certificado reemitido carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Un certificado usado como firmante de un rol no puede eliminarse: la API lo rechaza con `409` `certificate is in use`.",{"_3337":69681,"_29196":69651,"_20242":118399,"_5":13829,"_26574":118313,"_2824":118400},[],"Al eliminar una CA, su rol VA se conserva y no puede borrarse por API. Si no queda ninguna otra CA con el mismo SKI, el rol puede consultarse pero cualquier `PUT` devuelve 404, y el trabajo de renovación registra un aviso en cada ciclo porque ya no encuentra la CA. La API no ofrece salida; solo se corrige editando la base de datos. Si queda otra CA con ese SKI, el rol sigue siendo editable (consulta CAs que comparten clave). Ajusta validez y firmante antes de eliminar la CA.",{"_3337":69682,"_29196":69651,"_20242":118402,"_5":13829,"_26574":118313,"_2824":118403},[],"Una CA cuyo certificado no tiene `cRLSign` no puede generar su CRL ni editar su rol (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y asígnalo como firmante con `PUT`. Tras reemitir una CA, comprueba el uso de clave del certificado nuevo: si carece de `cRLSign`, la VA conserva el firmante anterior y registra un aviso, de modo que las listas siguen firmándose con el certificado sustituido hasta que corrijas el uso.",{"_3337":69683,"_29196":69651,"_20242":118405,"_5":13829,"_26574":118313,"_2824":118406},[],"El `PUT` valida siempre el firmante, aunque la petición no lo cambie. Si el firmante guardado ya no es válido, no se puede modificar ningún campo del rol, ni siquiera la validez, hasta asignar uno válido.",{"_3337":69684,"_29196":69651,"_20242":118408,"_5":13829,"_26574":118313,"_2824":118409},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3337":69685,"_29196":69651,"_20242":118411,"_5":13829,"_26574":118317,"_2824":118412},[],"La VA identifica cada CRL por el SKI de la CA, y el SKI se deriva de su clave. Dos CAs con la misma clave tienen el mismo SKI y comparten un único rol VA y una única CRL. Ocurre al crear una CA sobre una clave ya existente del KMS, o al importar una CA cuyo certificado declara un SKI en uso. Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. El rol lo crea la primera CA y las demás lo conservan.",{"_3337":69686,"_29196":69651,"_20242":118414,"_5":13829,"_26574":118317,"_2824":118415},[],"Los certificados de todas ellas apuntan a `/crl/{ski}`, pero la lista publicada tiene como emisor a la primera CA y solo incluye sus revocaciones. Un verificador compara el emisor de la CRL con el del certificado que valida (RFC 5280, §6.3.2) y rechaza la lista si no coinciden. Según su política, el certificado queda bloqueado (*hard-fail*) o se acepta aunque esté revocado (*soft-fail*). Las revocaciones de las CAs secundarias no aparecen en ninguna lista.",{"_3337":69687,"_29196":69651,"_20242":118417,"_5":13829,"_26574":118317,"_2824":118418},[],"Si la primera CA se elimina, la generación de CRL de la restante falla porque el firmante configurado ya no corresponde a una CA con ese nombre. Hasta que se actualice el firmante del rol a un certificado de la CA restante, se sigue sirviendo la última lista publicada hasta que venza (7 días por defecto).",{"_3337":69688,"_29196":69651,"_20242":118420,"_5":13829,"_26574":118317,"_2824":118421},[],"Para detectar el problema, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos. Una CA importada con un SKI ya en uso no sustituye a la existente como emisora de la CRL, porque el emisor se resuelve a partir del firmante del rol. Sin embargo, sus propios certificados apuntan a esa misma URL y sus revocaciones no se publican. Hasta que Lamassu rechace estas importaciones, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión, así que tampoco reutilices claves entre CAs. Una CRL por CA y el rechazo de importaciones cuyo SKI colisiona con el de una CA existente están planteados en lamassuiot#834, y ninguno está implementado todavía.",{"_3337":69689,"_29196":69651,"_20242":118423,"_5":13829,"_26574":118321,"_2824":118424},[],"El trabajo programado de la VA revisa todos los roles en cada ejecución y solicita otra lista cuando a `latest_crl` le queda menos validez que el intervalo entre ejecuciones. La frecuencia se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. El trabajo también regenera una lista cuando el `refresh_interval` del rol transcurra desde la última emisión; poner `refresh_interval` a `0` deshabilita esa vía. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job. Mantén `validity` claramente por encima del intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3337":69690,"_29196":69651,"_20242":118426,"_5":13829,"_26574":118321,"_2824":118427},[],"Si la generación falla (por ejemplo, por un rol sin CA o un firmante inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ski>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3337":69691,"_29196":69651,"_20242":118429,"_5":13829,"_26574":118321,"_2824":118430},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla (rol inexistente, firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3337":69692,"_29196":69651,"_20242":118432,"_5":13829,"_26574":118321,"_2824":118433},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3337":69693,"_29196":69651,"_20242":118435,"_5":13829,"_26574":118325,"_2824":118436},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3337":69694,"_29196":69651,"_20242":118438,"_5":13829,"_26574":118325,"_2824":118439},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3337":69695,"_29196":69651,"_20242":118441,"_5":13829,"_26574":118329,"_2824":118442},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3337":69696,"_29196":69651,"_20242":118444,"_5":13829,"_26574":118329,"_2824":118445},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3337":69697,"_29196":69651,"_20242":118447,"_5":13829,"_26574":118329,"_2824":118448},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3337":69698,"_29196":69651,"_20242":118450,"_5":13829,"_26574":118329,"_2824":118451},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3337":69699,"_29196":69651,"_20242":118453,"_5":13829,"_26574":118329,"_2824":118454},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3337":69700,"_29196":69651,"_20242":118456,"_5":13829,"_26574":118333,"_2824":118457},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3337":69701,"_29196":69651,"_20242":118459,"_5":13829,"_26574":118333,"_2824":115008},[],{"_3337":69702,"_29196":69651,"_20242":118461,"_5":13829,"_26574":118333,"_2824":118462},[],"Path relativo",{"_3337":69703,"_29196":69651,"_20242":118464,"_5":13829,"_26574":118333,"_2824":113044},[],{"_3337":69704,"_29196":69651,"_20242":118466,"_5":13829,"_26574":118333,"_2824":54296},[],{"_3337":69705,"_29196":69651,"_20242":118468,"_5":13829,"_26574":118333,"_2824":54299},[],{"_3337":69706,"_29196":69651,"_20242":118470,"_5":13829,"_26574":118333,"_2824":118471},[],"Consultar `crl_options` y `latest_crl`.",{"_3337":69707,"_29196":69651,"_20242":118473,"_5":13829,"_26574":118333,"_2824":54305},[],{"_3337":69708,"_29196":69651,"_20242":118475,"_5":13829,"_26574":118333,"_2824":54299},[],{"_3337":69709,"_29196":69651,"_20242":118477,"_5":13829,"_26574":118333,"_2824":118478},[],"Sustituir la configuración de CRL.",{"_3337":69710,"_29196":69651,"_20242":118480,"_5":13829,"_26574":118333,"_2824":118481},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3337":69711,"_29196":69651,"_20242":118483,"_5":13829,"_26574":118333,"_2824":118484},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3337":69712,"_29196":69651,"_20242":118486,"_5":13829,"_26574":118337,"_2824":118487},[],"Síntoma",{"_3337":69713,"_29196":69651,"_20242":118489,"_5":13829,"_26574":118337,"_2824":118490},[],"Causa",{"_3337":69714,"_29196":69651,"_20242":118492,"_5":13829,"_26574":118337,"_2824":118493},[],"Acción",{"_3337":69715,"_29196":69651,"_20242":118495,"_5":13829,"_26574":118337,"_2824":118496},[],"`PUT /v1/roles/{ca-ski}` devuelve 404 y `GET` devuelve 200.",{"_3337":69716,"_29196":69651,"_20242":118498,"_5":13829,"_26574":118337,"_2824":118499},[],"Se eliminó la CA del rol y no queda otra con el mismo SKI.",{"_3337":69717,"_29196":69651,"_20242":118501,"_5":13829,"_26574":118337,"_2824":118502},[],"No hay salida por API; requiere intervención en la base de datos. Evítalo ajustando el rol antes de eliminar la CA.",{"_3337":69718,"_29196":69651,"_20242":118504,"_5":13829,"_26574":118337,"_2824":118505},[],"`PUT` devuelve 400.",{"_3337":69719,"_29196":69651,"_20242":118507,"_5":13829,"_26574":118337,"_2824":118508},[],"El firmante no tiene `cRLSign`, o su sujeto y su clave no coinciden con ninguna CA de ese SKI (por ejemplo, tras eliminar la primera de dos CAs que comparten clave).",{"_3337":69720,"_29196":69651,"_20242":118510,"_5":13829,"_26574":118337,"_2824":118511},[],"Asigna con `PUT` el número de serie de un certificado válido de la CA restante.",{"_3337":69721,"_29196":69651,"_20242":118513,"_5":13829,"_26574":118337,"_2824":118514},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3337":69722,"_29196":69651,"_20242":118516,"_5":13829,"_26574":118337,"_2824":118517},[],"`crl_options.subject_key_id_signer` se sustituyó por `signer_certificate_serial_number`, que es obligatorio.",{"_3337":69723,"_29196":69651,"_20242":118519,"_5":13829,"_26574":118337,"_2824":118520},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3337":69724,"_29196":69651,"_20242":118522,"_5":13829,"_26574":118337,"_2824":118523},[],"La CRL no cambia tras revocar un certificado.",{"_3337":69725,"_29196":69651,"_20242":118525,"_5":13829,"_26574":118337,"_2824":118526},[],"`regenerate_on_revoke` es `false`, o el evento falló por falta de rol o por un firmante inválido.",{"_3337":69726,"_29196":69651,"_20242":118528,"_5":13829,"_26574":118337,"_2824":118529},[],"Revisa los logs de la VA y la cola de eventos fallidos; corrige el firmante.",{"_3337":69727,"_29196":69651,"_20242":118531,"_5":13829,"_26574":118337,"_2824":118532},[],"Un verificador rechaza la CRL por el emisor.",{"_3337":69728,"_29196":69651,"_20242":118534,"_5":13829,"_26574":118337,"_2824":118535},[],"Varias CAs comparten SKI.",{"_3337":69729,"_29196":69651,"_20242":118537,"_5":13829,"_26574":118337,"_2824":118538},[],"Consulta CAs que comparten clave.",{"_3337":69730,"_29196":69651,"_20242":118540,"_5":13829,"_26574":118341,"_2824":118541},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3337":69731,"_29196":69651,"_20242":118543,"_5":13829,"_26574":118345,"_2824":118544},[],"RFC 5280: perfil X.509 y CRL.",{"_3337":69732,"_29196":69651,"_20242":118546,"_5":13829,"_26574":118345,"_2824":54379},[],{"_3337":69733,"_29196":69651,"_20242":118548,"_5":13829,"_26574":118345,"_2824":54382},[],{"_3337":69734,"_29196":69651,"_20242":118550,"_5":13829,"_26574":118345,"_2824":118551},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3337":69735,"_29196":69651,"_20242":118553,"_5":13829,"_26574":118345,"_2824":118554},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3337":69736,"_29196":69736,"_5":14181,"_2824":118556,"_29540":118557,"_20242":118558,"_26574":69736},"Claves y motores criptográficos",[47528,113284,52983,117163],[],{"_3337":69737,"_29196":69736,"_20242":118560,"_5":13829,"_26574":69736,"_2824":118561},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3337":69738,"_29196":69736,"_5":29537,"_20242":118563,"_26574":118564,"_2824":118565},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3337":69739,"_29196":69736,"_5":29537,"_20242":118567,"_26574":118568,"_2824":118569},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3337":69740,"_29196":69736,"_5":29537,"_20242":118571,"_26574":118572,"_2824":54407},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#file-system",{"_3337":69741,"_29196":69736,"_5":29537,"_20242":118574,"_26574":118575,"_2824":54411},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#hashicorp-vault",{"_3337":69742,"_29196":69736,"_5":29537,"_20242":118577,"_26574":118578,"_2824":54415},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#aws-secrets-manager",{"_3337":69743,"_29196":69736,"_5":29537,"_20242":118580,"_26574":118581,"_2824":54419},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#aws-kms",{"_3337":69744,"_29196":69736,"_5":29537,"_20242":118583,"_26574":118584,"_2824":54423},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#pkcs11",{"_3337":69745,"_29196":69736,"_5":29537,"_20242":118586,"_26574":118587,"_2824":54427},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#azure-key-vault",{"_3337":69746,"_29196":69736,"_5":29537,"_20242":118589,"_26574":118590,"_2824":118591},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3337":69747,"_29196":69736,"_5":29537,"_20242":118593,"_26574":118594,"_2824":118595},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3337":69748,"_29196":69736,"_5":29537,"_20242":118597,"_26574":118598,"_2824":118599},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3337":69749,"_29196":69736,"_5":29537,"_20242":118601,"_26574":118602,"_2824":118603},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3337":69750,"_29196":69736,"_5":29537,"_20242":118605,"_26574":118606,"_2824":118607},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3337":69751,"_29196":69736,"_5":29537,"_20242":118609,"_26574":118610,"_2824":118611},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3337":69752,"_29196":69736,"_5":29537,"_20242":118613,"_26574":118614,"_2824":118615},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3337":69753,"_29196":69736,"_5":29537,"_20242":118617,"_26574":118618,"_2824":54459},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#sign",{"_3337":69754,"_29196":69736,"_5":29537,"_20242":118620,"_26574":118621,"_2824":54463},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#verify",{"_3337":69755,"_29196":69736,"_5":29537,"_20242":118623,"_26574":118624,"_2824":118625},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3337":69756,"_29196":69736,"_5":29537,"_20242":118627,"_26574":118628,"_2824":118629},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3337":69757,"_29196":69736,"_5":29537,"_20242":118631,"_26574":118632,"_2824":118633},[],"/docs/pr-preview/pr-57/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3337":69758,"_29196":69736,"_20242":118635,"_5":13829,"_26574":69736,"_2824":118636},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3337":69759,"_29196":69736,"_20242":118638,"_5":13829,"_26574":69736,"_2824":118639},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3337":69760,"_29196":69736,"_20242":118641,"_5":13829,"_26574":118564,"_2824":118642},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3337":69761,"_29196":69736,"_20242":118644,"_5":13829,"_26574":118564,"_2824":118645},[],"En la práctica, permite:",{"_3337":69762,"_29196":69736,"_20242":118647,"_5":13829,"_26574":118564,"_2824":118648},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3337":69763,"_29196":69736,"_20242":118650,"_5":13829,"_26574":118564,"_2824":118651},[],"Importar claves creadas externamente.",{"_3337":69764,"_29196":69736,"_20242":118653,"_5":13829,"_26574":118564,"_2824":118654},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3337":69765,"_29196":69736,"_20242":118656,"_5":13829,"_26574":118564,"_2824":118657},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3337":69766,"_29196":69736,"_20242":118659,"_5":13829,"_26574":118568,"_2824":118660},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3337":69767,"_29196":69736,"_20242":118662,"_5":13829,"_26574":118568,"_2824":118663},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3337":69768,"_29196":69736,"_20242":118665,"_5":13829,"_26574":118568,"_2824":118666},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3337":69769,"_29196":69736,"_20242":118668,"_5":13829,"_26574":118572,"_2824":118669},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3337":69770,"_29196":69736,"_20242":118671,"_5":13829,"_26574":118575,"_2824":118672},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3337":69771,"_29196":69736,"_20242":118674,"_5":13829,"_26574":118575,"_2824":118675},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3337":69772,"_29196":69736,"_20242":118677,"_5":13829,"_26574":118578,"_2824":118678},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3337":69773,"_29196":69736,"_20242":118680,"_5":13829,"_26574":118581,"_2824":118681},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3337":69774,"_29196":69736,"_20242":118683,"_5":13829,"_26574":118584,"_2824":118684},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3337":69775,"_29196":69736,"_20242":118686,"_5":13829,"_26574":118587,"_2824":118687},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3337":69776,"_29196":69736,"_20242":118689,"_5":13829,"_26574":118587,"_2824":118690},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3337":69777,"_29196":69736,"_20242":118692,"_5":13829,"_26574":118587,"_2824":118693},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3337":69778,"_29196":69736,"_20242":118695,"_5":13829,"_26574":118587,"_2824":118696},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3337":69779,"_29196":69736,"_20242":118698,"_5":13829,"_26574":118590,"_2824":118699},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3337":69780,"_29196":69736,"_20242":118701,"_5":13829,"_26574":118590,"_2824":118702},[],"La tabla incluye los siguientes campos:",{"_3337":69781,"_29196":69736,"_20242":118704,"_5":13829,"_26574":118590,"_2824":118705},[],"**Name**: nombre descriptivo de la clave.",{"_3337":69782,"_29196":69736,"_20242":118707,"_5":13829,"_26574":118590,"_2824":118708},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3337":69783,"_29196":69736,"_20242":118710,"_5":13829,"_26574":118590,"_2824":118711},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3337":69784,"_29196":69736,"_20242":118713,"_5":13829,"_26574":118590,"_2824":118714},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3337":69785,"_29196":69736,"_20242":118716,"_5":13829,"_26574":118590,"_2824":118717},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3337":69786,"_29196":69736,"_20242":118719,"_5":13829,"_26574":118590,"_2824":118720},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3337":69787,"_29196":69736,"_20242":118722,"_5":13829,"_26574":118590,"_2824":118723},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3337":69788,"_29196":69736,"_20242":118725,"_5":13829,"_26574":118590,"_2824":118726},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3337":69789,"_29196":69736,"_20242":118728,"_5":13829,"_26574":118590,"_2824":118729},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3337":69790,"_29196":69736,"_20242":118731,"_5":13829,"_26574":118590,"_2824":118732},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3337":69791,"_29196":69736,"_20242":118734,"_5":13829,"_26574":118590,"_2824":118735},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3337":69792,"_29196":69736,"_20242":118737,"_5":13829,"_26574":118590,"_2824":118738},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3337":69793,"_29196":69736,"_20242":118740,"_5":13829,"_26574":118590,"_2824":118741},[],"**Delete Key** para eliminar la clave del sistema.",{"_3337":69794,"_29196":69736,"_20242":118743,"_5":13829,"_26574":118594,"_2824":118744},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3337":69795,"_29196":69736,"_20242":118746,"_5":13829,"_26574":118598,"_2824":118747},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3337":69796,"_29196":69736,"_20242":118749,"_5":13829,"_26574":118598,"_2824":118750},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3337":69797,"_29196":69736,"_20242":118752,"_5":13829,"_26574":118598,"_2824":118753},[],"**Key Name**: nombre único y descriptivo.",{"_3337":69798,"_29196":69736,"_20242":118755,"_5":13829,"_26574":118598,"_2824":118756},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3337":69799,"_29196":69736,"_20242":118758,"_5":13829,"_26574":118598,"_2824":118759},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3337":69800,"_29196":69736,"_20242":118761,"_5":13829,"_26574":118598,"_2824":118762},[],"**Tags**: metadatos para clasificar la clave.",{"_3337":69801,"_29196":69736,"_20242":118764,"_5":13829,"_26574":118598,"_2824":118765},[],"**Metadata**: información adicional para usos avanzados.",{"_3337":69802,"_29196":69736,"_20242":118767,"_5":13829,"_26574":118602,"_2824":118768},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3337":69803,"_29196":69736,"_20242":118770,"_5":13829,"_26574":118602,"_2824":118771},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3337":69804,"_29196":69736,"_20242":118773,"_5":13829,"_26574":118602,"_2824":118774},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3337":69805,"_29196":69736,"_20242":118776,"_5":13829,"_26574":118602,"_2824":118777},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3337":69806,"_29196":69736,"_20242":118779,"_5":13829,"_26574":118602,"_2824":118780},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3337":69807,"_29196":69736,"_20242":118782,"_5":13829,"_26574":118602,"_2824":118783},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3337":69808,"_29196":69736,"_20242":118785,"_5":13829,"_26574":118602,"_2824":118786},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3337":69809,"_29196":69736,"_20242":118788,"_5":13829,"_26574":118602,"_2824":118789},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3337":69810,"_29196":69736,"_20242":118791,"_5":13829,"_26574":118602,"_2824":118792},[],"**Metadata**: información adicional opcional.",{"_3337":69811,"_29196":69736,"_20242":118794,"_5":13829,"_26574":118602,"_2824":118795},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3337":69812,"_29196":69736,"_20242":118797,"_5":13829,"_26574":118602,"_2824":118798},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3337":69813,"_29196":69736,"_20242":118800,"_5":13829,"_26574":118606,"_2824":118801},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3337":69814,"_29196":69736,"_20242":118803,"_5":13829,"_26574":118610,"_2824":118804},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3337":69815,"_29196":69736,"_20242":118806,"_5":13829,"_26574":118610,"_2824":118807},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3337":69816,"_29196":69736,"_20242":118809,"_5":13829,"_26574":118610,"_2824":118810},[],"**Key Name**: nombre descriptivo.",{"_3337":69817,"_29196":69736,"_20242":118812,"_5":13829,"_26574":118610,"_2824":118813},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3337":69818,"_29196":69736,"_20242":118815,"_5":13829,"_26574":118610,"_2824":118816},[],"**Tags**: etiquetas asociadas.",{"_3337":69819,"_29196":69736,"_20242":118818,"_5":13829,"_26574":118610,"_2824":118819},[],"**Aliases**: nombres alternativos.",{"_3337":69820,"_29196":69736,"_20242":118821,"_5":13829,"_26574":118610,"_2824":118822},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3337":69821,"_29196":69736,"_20242":118824,"_5":13829,"_26574":118610,"_2824":118825},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3337":69822,"_29196":69736,"_20242":118827,"_5":13829,"_26574":118610,"_2824":118828},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3337":69823,"_29196":69736,"_20242":118830,"_5":13829,"_26574":118610,"_2824":118831},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3337":69824,"_29196":69736,"_20242":118833,"_5":13829,"_26574":118614,"_2824":118834},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3337":69825,"_29196":69736,"_20242":118836,"_5":13829,"_26574":118614,"_2824":118837},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3337":69826,"_29196":69736,"_20242":118839,"_5":13829,"_26574":118614,"_2824":118840},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3337":69827,"_29196":69736,"_20242":118842,"_5":13829,"_26574":118618,"_2824":118843},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3337":69828,"_29196":69736,"_20242":118845,"_5":13829,"_26574":118618,"_2824":118846},[],"Campos principales:",{"_3337":69829,"_29196":69736,"_20242":118848,"_5":13829,"_26574":118618,"_2824":118849},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3337":69830,"_29196":69736,"_20242":118851,"_5":13829,"_26574":118618,"_2824":118852},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3337":69831,"_29196":69736,"_20242":118854,"_5":13829,"_26574":118618,"_2824":118855},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3337":69832,"_29196":69736,"_20242":118857,"_5":13829,"_26574":118618,"_2824":118858},[],"**Message**: contenido que se va a firmar.",{"_3337":69833,"_29196":69736,"_20242":118860,"_5":13829,"_26574":118618,"_2824":118861},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3337":69834,"_29196":69736,"_20242":118863,"_5":13829,"_26574":118621,"_2824":118864},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3337":69835,"_29196":69736,"_20242":118866,"_5":13829,"_26574":118621,"_2824":118846},[],{"_3337":69836,"_29196":69736,"_20242":118868,"_5":13829,"_26574":118621,"_2824":118869},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3337":69837,"_29196":69736,"_20242":118871,"_5":13829,"_26574":118621,"_2824":118872},[],"**Message Type**: `Raw` o `Digest`.",{"_3337":69838,"_29196":69736,"_20242":118874,"_5":13829,"_26574":118621,"_2824":118875},[],"**Payload Encoding**: codificación del mensaje.",{"_3337":69839,"_29196":69736,"_20242":118877,"_5":13829,"_26574":118621,"_2824":118878},[],"**Message**: mensaje original o hash.",{"_3337":69840,"_29196":69736,"_20242":118880,"_5":13829,"_26574":118621,"_2824":118881},[],"**Signature**: firma que se desea comprobar.",{"_3337":69841,"_29196":69736,"_20242":118883,"_5":13829,"_26574":118621,"_2824":118884},[],"**Result**: indicador del resultado de la validación.",{"_3337":69842,"_29196":69736,"_20242":118886,"_5":13829,"_26574":118624,"_2824":118887},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3337":69843,"_29196":69736,"_20242":118889,"_5":13829,"_26574":118624,"_2824":118890},[],"Este flujo es útil para:",{"_3337":69844,"_29196":69736,"_20242":118892,"_5":13829,"_26574":118624,"_2824":118893},[],"Solicitar certificados a una CA externa.",{"_3337":69845,"_29196":69736,"_20242":118895,"_5":13829,"_26574":118624,"_2824":118896},[],"Renovar una identidad manteniendo la misma clave.",{"_3337":69846,"_29196":69736,"_20242":118898,"_5":13829,"_26574":118624,"_2824":118899},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3337":69847,"_29196":69736,"_20242":118901,"_5":13829,"_26574":118624,"_2824":118902},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3337":69848,"_29196":69736,"_20242":118904,"_5":13829,"_26574":118624,"_2824":118905},[],"**Organization (O)**: organización o empresa.",{"_3337":69849,"_29196":69736,"_20242":118907,"_5":13829,"_26574":118624,"_2824":118908},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3337":69850,"_29196":69736,"_20242":118910,"_5":13829,"_26574":118624,"_2824":118911},[],"**Country (C)**: código de país de dos letras.",{"_3337":69851,"_29196":69736,"_20242":118913,"_5":13829,"_26574":118624,"_2824":118914},[],"**State / Province (ST)**: estado o provincia.",{"_3337":69852,"_29196":69736,"_20242":118916,"_5":13829,"_26574":118624,"_2824":118917},[],"**Locality (L)**: ciudad o localidad.",{"_3337":69853,"_29196":69736,"_20242":118919,"_5":13829,"_26574":118624,"_2824":118920},[],"**Email Address**: correo de contacto.",{"_3337":69854,"_29196":69736,"_20242":118922,"_5":13829,"_26574":118624,"_2824":118923},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3337":69855,"_29196":69736,"_20242":118925,"_5":13829,"_26574":118624,"_2824":118926},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3337":69856,"_29196":69736,"_20242":118928,"_5":13829,"_26574":118628,"_2824":118929},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3337":69857,"_29196":69736,"_20242":118931,"_5":13829,"_26574":118628,"_2824":54774},[],{"_3337":69858,"_29196":69736,"_20242":118933,"_5":13829,"_26574":118632,"_2824":118934},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Lamassu rechaza eliminar una clave mientras un certificado siga referenciándola, con `409` `key is in use`; libera o elimina antes los certificados dependientes. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3337":69859,"_29196":69859,"_5":14181,"_2824":118936,"_29540":118937,"_20242":118938,"_26574":69859},"Validación online con OCSP",[47528,113284,52983,117791],[],{"_3337":69860,"_29196":69859,"_20242":118940,"_5":13829,"_26574":69859,"_2824":118941},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3337":69861,"_29196":69859,"_5":29537,"_20242":118943,"_26574":118944,"_2824":118945},[],"/docs/pr-preview/pr-57/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3337":69862,"_29196":69859,"_5":29537,"_20242":118947,"_26574":118948,"_2824":118949},[],"/docs/pr-preview/pr-57/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3337":69863,"_29196":69859,"_5":29537,"_20242":118951,"_26574":118952,"_2824":118953},[],"/docs/pr-preview/pr-57/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3337":69864,"_29196":69859,"_5":29537,"_20242":118955,"_26574":118956,"_2824":118957},[],"/docs/pr-preview/pr-57/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3337":69865,"_29196":69859,"_5":29537,"_20242":118959,"_26574":118960,"_2824":118961},[],"/docs/pr-preview/pr-57/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3337":69866,"_29196":69859,"_5":29537,"_20242":118963,"_26574":118964,"_2824":118346},[],"/docs/pr-preview/pr-57/es/platform/pki/ocsp#referencias",{"_3337":69867,"_29196":69859,"_20242":118966,"_5":13829,"_26574":69859,"_2824":118967},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3337":69868,"_29196":69859,"_20242":118969,"_5":13829,"_26574":118944,"_2824":118970},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3337":69869,"_29196":69859,"_20242":118972,"_5":13829,"_26574":118944,"_2824":118973},[],"Estado del registro",{"_3337":69870,"_29196":69859,"_20242":118975,"_5":13829,"_26574":118944,"_2824":118976},[],"Respuesta firmada",{"_3337":69871,"_29196":69859,"_20242":118978,"_5":13829,"_26574":118944,"_2824":52154},[],{"_3337":69872,"_29196":69859,"_20242":118980,"_5":13829,"_26574":118944,"_2824":54824},[],{"_3337":69873,"_29196":69859,"_20242":118982,"_5":13829,"_26574":118944,"_2824":52171},[],{"_3337":69874,"_29196":69859,"_20242":118984,"_5":13829,"_26574":118944,"_2824":118985},[],"`Revoked`, con razón y fecha de revocación.",{"_3337":69875,"_29196":69859,"_20242":118987,"_5":13829,"_26574":118944,"_2824":118988},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3337":69876,"_29196":69859,"_20242":118990,"_5":13829,"_26574":118944,"_2824":118991},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3337":69877,"_29196":69859,"_20242":118993,"_5":13829,"_26574":118944,"_2824":118994},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3337":69878,"_29196":69859,"_20242":118996,"_5":13829,"_26574":118944,"_2824":118997},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3337":69879,"_29196":69859,"_20242":118999,"_5":13829,"_26574":118944,"_2824":119000},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3337":69880,"_29196":69859,"_20242":119002,"_5":13829,"_26574":118948,"_2824":119003},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3337":69881,"_29196":69859,"_20242":119005,"_5":13829,"_26574":118948,"_2824":119006},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3337":69882,"_29196":69859,"_20242":119008,"_5":13829,"_26574":118952,"_2824":119009},[],"El servicio acepta:",{"_3337":69883,"_29196":69859,"_20242":119011,"_5":13829,"_26574":118952,"_2824":115008},[],{"_3337":69884,"_29196":69859,"_20242":119013,"_5":13829,"_26574":118952,"_2824":119014},[],"Ruta del servicio VA",{"_3337":69885,"_29196":69859,"_20242":119016,"_5":13829,"_26574":118952,"_2824":119017},[],"Formato",{"_3337":69886,"_29196":69859,"_20242":119019,"_5":13829,"_26574":118952,"_2824":54864},[],{"_3337":69887,"_29196":69859,"_20242":119021,"_5":13829,"_26574":118952,"_2824":54867},[],{"_3337":69888,"_29196":69859,"_20242":119023,"_5":13829,"_26574":118952,"_2824":119024},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3337":69889,"_29196":69859,"_20242":119026,"_5":13829,"_26574":118952,"_2824":54296},[],{"_3337":69890,"_29196":69859,"_20242":119028,"_5":13829,"_26574":118952,"_2824":54875},[],{"_3337":69891,"_29196":69859,"_20242":119030,"_5":13829,"_26574":118952,"_2824":119031},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3337":69892,"_29196":69859,"_20242":119033,"_5":13829,"_26574":118952,"_2824":119034},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3337":69893,"_29196":69859,"_20242":119036,"_5":13829,"_26574":118956,"_2824":119037},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3337":69894,"_29196":69859,"_20242":119039,"_5":13829,"_26574":118956,"_2824":119040},[],"Genera la solicitud:",{"_3337":69895,"_29196":69859,"_20242":119042,"_5":13829,"_26574":118956,"_2824":119043},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3337":69896,"_29196":69859,"_20242":119045,"_5":13829,"_26574":118956,"_2824":119046},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3337":69897,"_29196":69859,"_20242":119048,"_5":13829,"_26574":118956,"_2824":119049},[],"Verifica el DER recibido:",{"_3337":69898,"_29196":69859,"_20242":119051,"_5":13829,"_26574":118956,"_2824":119052},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3337":69899,"_29196":69859,"_20242":119054,"_5":13829,"_26574":118960,"_2824":119055},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3337":69900,"_29196":69859,"_20242":119057,"_5":13829,"_26574":118960,"_2824":119058},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3337":69901,"_29196":69859,"_20242":119060,"_5":13829,"_26574":118964,"_2824":54908},[],{"_3337":69902,"_29196":69859,"_20242":119062,"_5":13829,"_26574":118964,"_2824":54911},[],{"_3337":69903,"_29196":69859,"_20242":119064,"_5":13829,"_26574":118964,"_2824":119065},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3337":69904,"_29196":69859,"_20242":119067,"_5":13829,"_26574":118964,"_2824":118554},[],{"_3337":69905,"_29196":69905,"_5":14181,"_2824":52983,"_29540":119069,"_20242":119070,"_26574":69905},[47528,113284,52983],[],{"_3337":69906,"_29196":69905,"_20242":119072,"_5":13829,"_26574":69905,"_2824":119073},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3337":69907,"_29196":69905,"_5":29537,"_20242":119075,"_26574":119076,"_2824":116489},[],"/docs/pr-preview/pr-57/es/platform/pki/overview#empieza-aquí",{"_3337":69908,"_29196":69905,"_5":29537,"_20242":119078,"_26574":119079,"_2824":119080},[],"/docs/pr-preview/pr-57/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3337":69909,"_29196":69905,"_5":29537,"_20242":119082,"_26574":119083,"_2824":117009},[],"/docs/pr-preview/pr-57/es/platform/pki/overview#capacidades-principales",{"_3337":69910,"_29196":69905,"_5":29537,"_20242":119085,"_26574":119086,"_2824":117013},[],"/docs/pr-preview/pr-57/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3337":69911,"_29196":69905,"_5":29537,"_20242":119088,"_26574":119089,"_2824":117017},[],"/docs/pr-preview/pr-57/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3337":69912,"_29196":69905,"_5":29537,"_20242":119091,"_26574":119092,"_2824":117021},[],"/docs/pr-preview/pr-57/es/platform/pki/overview#emite-y-controla-certificados",{"_3337":69913,"_29196":69905,"_5":29537,"_20242":119094,"_26574":119095,"_2824":117029},[],"/docs/pr-preview/pr-57/es/platform/pki/overview#publica-el-estado-de-validación",{"_3337":69914,"_29196":69905,"_5":29537,"_20242":119097,"_26574":119098,"_2824":119099},[],"/docs/pr-preview/pr-57/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3337":69915,"_29196":69905,"_5":29537,"_20242":119101,"_26574":119102,"_2824":117957},[],"/docs/pr-preview/pr-57/es/platform/pki/overview#continúa",{"_3337":69916,"_29196":69905,"_20242":119104,"_5":13829,"_26574":69905,"_2824":119105},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3337":69917,"_29196":69905,"_20242":119107,"_5":13829,"_26574":119076,"_2824":119108},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3337":69918,"_29196":69905,"_20242":119110,"_5":13829,"_26574":119076,"_2824":119111},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3337":69919,"_29196":69905,"_20242":119113,"_5":13829,"_26574":119079,"_2824":119114},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3337":69920,"_29196":69905,"_20242":119116,"_5":13829,"_26574":119079,"_2824":119117},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3337":69921,"_29196":69905,"_20242":119119,"_5":13829,"_26574":119079,"_2824":119120},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3337":69922,"_29196":69905,"_20242":119122,"_5":13829,"_26574":119079,"_2824":119123},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3337":69923,"_29196":69905,"_20242":119125,"_5":13829,"_26574":119079,"_2824":119126},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3337":69924,"_29196":69905,"_20242":119128,"_5":13829,"_26574":119086,"_2824":119129},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3337":69925,"_29196":69905,"_20242":119131,"_5":13829,"_26574":119089,"_2824":119132},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3337":69926,"_29196":69905,"_20242":119134,"_5":13829,"_26574":119092,"_2824":119135},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3337":69927,"_29196":69905,"_20242":119137,"_5":13829,"_26574":119095,"_2824":119138},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3337":69928,"_29196":69905,"_20242":119140,"_5":13829,"_26574":119098,"_2824":119141},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3337":69929,"_29196":69905,"_20242":119143,"_5":13829,"_26574":119098,"_2824":119144},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3337":69930,"_29196":69905,"_20242":119146,"_5":13829,"_26574":119098,"_2824":119147},[],"su clave pública corresponda a la clave privada del cliente;",{"_3337":69931,"_29196":69905,"_20242":119149,"_5":13829,"_26574":119098,"_2824":119150},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3337":69932,"_29196":69905,"_20242":119152,"_5":13829,"_26574":119098,"_2824":119153},[],"sus fechas y usos permitan la operación;",{"_3337":69933,"_29196":69905,"_20242":119155,"_5":13829,"_26574":119098,"_2824":119156},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3337":69934,"_29196":69905,"_20242":119158,"_5":13829,"_26574":119098,"_2824":119159},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3337":69935,"_29196":69905,"_20242":119161,"_5":13829,"_26574":119102,"_2824":119162},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3337":69936,"_29196":69905,"_20242":119164,"_5":13829,"_26574":119102,"_2824":119165},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3337":69937,"_29196":69905,"_20242":119167,"_5":13829,"_26574":119102,"_2824":119168},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3337":69938,"_29196":69938,"_5":14181,"_2824":119170,"_29540":119171,"_20242":119172,"_26574":69938},"Crea tu primera CA",[47528,113284,52983,116613],[],{"_3337":69939,"_29196":69938,"_20242":119174,"_5":13829,"_26574":69938,"_2824":119175},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3337":69940,"_29196":69938,"_5":29537,"_20242":119177,"_26574":119178,"_2824":111881},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3337":69941,"_29196":69938,"_5":29537,"_20242":119180,"_26574":119181,"_2824":119182},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3337":69942,"_29196":69938,"_5":29537,"_20242":119184,"_26574":119185,"_2824":119186},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3337":69943,"_29196":69938,"_5":29537,"_20242":119188,"_26574":119189,"_2824":119190},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3337":69944,"_29196":69938,"_5":29537,"_20242":119192,"_26574":119193,"_2824":119194},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3337":69945,"_29196":69938,"_5":29537,"_20242":119196,"_26574":119197,"_2824":119198},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3337":69946,"_29196":69938,"_5":29537,"_20242":119200,"_26574":119201,"_2824":119202},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3337":69947,"_29196":69938,"_5":29537,"_20242":119204,"_26574":119205,"_2824":116860},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3337":69948,"_29196":69938,"_5":29537,"_20242":119207,"_26574":119208,"_2824":111905},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3337":69949,"_29196":69938,"_20242":119210,"_5":13829,"_26574":69938,"_2824":119211},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3337":69950,"_29196":69938,"_20242":119213,"_5":13829,"_26574":119178,"_2824":119214},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3337":69951,"_29196":69938,"_20242":119216,"_5":13829,"_26574":119178,"_2824":119217},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3337":69952,"_29196":69938,"_20242":119219,"_5":13829,"_26574":119178,"_2824":119220},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3337":69953,"_29196":69938,"_20242":119222,"_5":13829,"_26574":119178,"_2824":119223},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3337":69954,"_29196":69938,"_20242":119225,"_5":13829,"_26574":119181,"_2824":119226},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3337":69955,"_29196":69938,"_20242":119228,"_5":13829,"_26574":119181,"_2824":119229},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3337":69956,"_29196":69938,"_20242":119231,"_5":13829,"_26574":119185,"_2824":119232},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3337":69957,"_29196":69938,"_20242":119234,"_5":13829,"_26574":119185,"_2824":119235},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3337":69958,"_29196":69938,"_20242":119237,"_5":13829,"_26574":119189,"_2824":119238},[],"Selecciona **Root CA** y completa:",{"_3337":69959,"_29196":69938,"_20242":119240,"_5":13829,"_26574":119189,"_2824":55090},[],{"_3337":69960,"_29196":69938,"_20242":119242,"_5":13829,"_26574":119189,"_2824":119243},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3337":69961,"_29196":69938,"_20242":119245,"_5":13829,"_26574":119189,"_2824":119246},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3337":69962,"_29196":69938,"_20242":119248,"_5":13829,"_26574":119189,"_2824":119249},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3337":69963,"_29196":69938,"_20242":119251,"_5":13829,"_26574":119189,"_2824":119252},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3337":69964,"_29196":69938,"_20242":119254,"_5":13829,"_26574":119193,"_2824":119255},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3337":69965,"_29196":69938,"_20242":119257,"_5":13829,"_26574":119197,"_2824":119258},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3337":69966,"_29196":69938,"_20242":119260,"_5":13829,"_26574":119197,"_2824":119261},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3337":69967,"_29196":69938,"_20242":119263,"_5":13829,"_26574":119201,"_2824":119264},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3337":69968,"_29196":69938,"_20242":119266,"_5":13829,"_26574":119201,"_2824":119267},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3337":69969,"_29196":69938,"_20242":119269,"_5":13829,"_26574":119201,"_2824":119270},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3337":69970,"_29196":69938,"_20242":119272,"_5":13829,"_26574":119205,"_2824":119273},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3337":69971,"_29196":69938,"_20242":119275,"_5":13829,"_26574":119205,"_2824":119276},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3337":69972,"_29196":69938,"_20242":119278,"_5":13829,"_26574":119205,"_2824":119279},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3337":69973,"_29196":69938,"_20242":119281,"_5":13829,"_26574":119205,"_2824":119282},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3337":69974,"_29196":69938,"_20242":119284,"_5":13829,"_26574":119208,"_2824":119285},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3337":69975,"_29196":69975,"_5":14181,"_2824":119287,"_29540":119288,"_20242":119289,"_26574":69975},"Emite y verifica un certificado",[47528,113284,52983,116613],[],{"_3337":69976,"_29196":69975,"_20242":119291,"_5":13829,"_26574":69975,"_2824":119292},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3337":69977,"_29196":69975,"_5":29537,"_20242":119294,"_26574":119295,"_2824":111881},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3337":69978,"_29196":69975,"_5":29537,"_20242":119297,"_26574":119298,"_2824":119299},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3337":69979,"_29196":69975,"_5":29537,"_20242":119301,"_26574":119302,"_2824":119303},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3337":69980,"_29196":69975,"_5":29537,"_20242":119305,"_26574":119306,"_2824":119307},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3337":69981,"_29196":69975,"_5":29537,"_20242":119309,"_26574":119310,"_2824":119311},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3337":69982,"_29196":69975,"_5":29537,"_20242":119313,"_26574":119314,"_2824":119315},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3337":69983,"_29196":69975,"_5":29537,"_20242":119317,"_26574":119318,"_2824":119319},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3337":69984,"_29196":69975,"_5":29537,"_20242":119321,"_26574":119322,"_2824":119323},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3337":69985,"_29196":69975,"_5":29537,"_20242":119325,"_26574":119326,"_2824":119327},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3337":69986,"_29196":69975,"_5":29537,"_20242":119329,"_26574":119330,"_2824":119331},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3337":69987,"_29196":69975,"_5":29537,"_20242":119333,"_26574":119334,"_2824":116860},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3337":69988,"_29196":69975,"_5":29537,"_20242":119336,"_26574":119337,"_2824":111905},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3337":69989,"_29196":69975,"_20242":119339,"_5":13829,"_26574":69975,"_2824":119340},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3337":69990,"_29196":69975,"_20242":119342,"_5":13829,"_26574":119295,"_2824":119343},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3337":69991,"_29196":69975,"_20242":119345,"_5":13829,"_26574":119295,"_2824":119346},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3337":69992,"_29196":69975,"_20242":119348,"_5":13829,"_26574":119295,"_2824":119349},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3337":69993,"_29196":69975,"_20242":119351,"_5":13829,"_26574":119295,"_2824":119352},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3337":69994,"_29196":69975,"_20242":119354,"_5":13829,"_26574":119295,"_2824":119355},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3337":69995,"_29196":69975,"_20242":119357,"_5":13829,"_26574":119298,"_2824":119358},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3337":69996,"_29196":69975,"_20242":119360,"_5":13829,"_26574":119302,"_2824":119361},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3337":69997,"_29196":69975,"_20242":119363,"_5":13829,"_26574":119302,"_2824":119364},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3337":69998,"_29196":69975,"_20242":119366,"_5":13829,"_26574":119306,"_2824":119367},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3337":69999,"_29196":69975,"_20242":119369,"_5":13829,"_26574":119306,"_2824":119370},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3337":70000,"_29196":69975,"_20242":119372,"_5":13829,"_26574":119310,"_2824":119373},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3337":70001,"_29196":69975,"_20242":119375,"_5":13829,"_26574":119310,"_2824":119376},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3337":70002,"_29196":69975,"_20242":119378,"_5":13829,"_26574":119314,"_2824":119379},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3337":70003,"_29196":69975,"_20242":119381,"_5":13829,"_26574":119318,"_2824":119382},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3337":70004,"_29196":69975,"_20242":119384,"_5":13829,"_26574":119322,"_2824":119385},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3337":70005,"_29196":69975,"_20242":119387,"_5":13829,"_26574":119326,"_2824":119388},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3337":70006,"_29196":69975,"_20242":119390,"_5":13829,"_26574":119326,"_2824":119391},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3337":70007,"_29196":69975,"_20242":119393,"_5":13829,"_26574":119326,"_2824":119394},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3337":70008,"_29196":69975,"_20242":119396,"_5":13829,"_26574":119330,"_2824":119397},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3337":70009,"_29196":69975,"_20242":119399,"_5":13829,"_26574":119330,"_2824":119400},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3337":70010,"_29196":69975,"_20242":119402,"_5":13829,"_26574":119330,"_2824":119403},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3337":70011,"_29196":69975,"_20242":119405,"_5":13829,"_26574":119334,"_2824":116943},[],{"_3337":70012,"_29196":69975,"_20242":119407,"_5":13829,"_26574":119334,"_2824":115457},[],{"_3337":70013,"_29196":69975,"_20242":119409,"_5":13829,"_26574":119334,"_2824":119410},[],"La CA rechaza la emisión",{"_3337":70014,"_29196":69975,"_20242":119412,"_5":13829,"_26574":119334,"_2824":119413},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3337":70015,"_29196":69975,"_20242":119415,"_5":13829,"_26574":119334,"_2824":119416},[],"Sujeto o usos diferentes",{"_3337":70016,"_29196":69975,"_20242":119418,"_5":13829,"_26574":119334,"_2824":119419},[],"Perfil aplicado y valores solicitados.",{"_3337":70017,"_29196":69975,"_20242":119421,"_5":13829,"_26574":119334,"_2824":119422},[],"No se encuentra el emisor",{"_3337":70018,"_29196":69975,"_20242":119424,"_5":13829,"_26574":119334,"_2824":119425},[],"CA descargada y cadena intermedia necesaria.",{"_3337":70019,"_29196":69975,"_20242":119427,"_5":13829,"_26574":119334,"_2824":119428},[],"Falla la vigencia",{"_3337":70020,"_29196":69975,"_20242":119430,"_5":13829,"_26574":119334,"_2824":119431},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3337":70021,"_29196":69975,"_20242":119433,"_5":13829,"_26574":119334,"_2824":119434},[],"Los resúmenes de clave difieren",{"_3337":70022,"_29196":69975,"_20242":119436,"_5":13829,"_26574":119334,"_2824":119437},[],"Archivos de certificado y clave de la misma emisión.",{"_3337":70023,"_29196":69975,"_20242":119439,"_5":13829,"_26574":119334,"_2824":119440},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3337":70024,"_29196":69975,"_20242":119442,"_5":13829,"_26574":119337,"_2824":119443},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3337":70025,"_29196":69975,"_20242":119445,"_5":13829,"_26574":119337,"_2824":119446},[],"Gestionar certificados para inspección, estado y revocación.",{"_3337":70026,"_29196":69975,"_20242":119448,"_5":13829,"_26574":119337,"_2824":119449},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3337":70027,"_29196":69975,"_20242":119451,"_5":13829,"_26574":119337,"_2824":119452},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3337":70028,"_29196":69975,"_20242":119454,"_5":13829,"_26574":119337,"_2824":119455},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3337":70029,"_29196":70029,"_5":14181,"_2824":119457,"_29540":119458,"_20242":119459,"_26574":70029},"Primeros pasos de PKI",[47528,113284,52983,116613],[],{"_3337":70030,"_29196":70029,"_20242":119461,"_5":13829,"_26574":70029,"_2824":119462},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3337":70031,"_29196":70029,"_5":29537,"_20242":119464,"_26574":119465,"_2824":111881},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3337":70032,"_29196":70029,"_5":29537,"_20242":119467,"_26574":119468,"_2824":119469},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3337":70033,"_29196":70029,"_5":29537,"_20242":119471,"_26574":119472,"_2824":116795},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3337":70034,"_29196":70029,"_5":29537,"_20242":119474,"_26574":119475,"_2824":119476},[],"/docs/pr-preview/pr-57/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3337":70035,"_29196":70029,"_20242":119478,"_5":13829,"_26574":70029,"_2824":119479},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3337":70036,"_29196":70029,"_20242":119481,"_5":13829,"_26574":119465,"_2824":119482},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3337":70037,"_29196":70029,"_20242":119484,"_5":13829,"_26574":119465,"_2824":119485},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3337":70038,"_29196":70029,"_20242":119487,"_5":13829,"_26574":119465,"_2824":119488},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3337":70039,"_29196":70029,"_20242":119490,"_5":13829,"_26574":119465,"_2824":119491},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3337":70040,"_29196":70029,"_20242":119493,"_5":13829,"_26574":119465,"_2824":119494},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3337":70041,"_29196":70029,"_20242":119496,"_5":13829,"_26574":119468,"_2824":119497},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3337":70042,"_29196":70029,"_20242":119499,"_5":13829,"_26574":119468,"_2824":119500},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3337":70043,"_29196":70029,"_20242":119502,"_5":13829,"_26574":119468,"_2824":119503},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3337":70044,"_29196":70029,"_20242":119505,"_5":13829,"_26574":119468,"_2824":119506},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3337":70045,"_29196":70029,"_20242":119508,"_5":13829,"_26574":119472,"_2824":119509},[],"Archivo o recurso",{"_3337":70046,"_29196":70029,"_20242":119511,"_5":13829,"_26574":119472,"_2824":116792},[],{"_3337":70047,"_29196":70029,"_20242":119513,"_5":13829,"_26574":119472,"_2824":119514},[],"CA raíz activa y `ca.pem`",{"_3337":70048,"_29196":70029,"_20242":119516,"_5":13829,"_26574":119472,"_2824":119517},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3337":70049,"_29196":70029,"_20242":119519,"_5":13829,"_26574":119472,"_2824":119520},[],"Certificado final y `device.crt`",{"_3337":70050,"_29196":70029,"_20242":119522,"_5":13829,"_26574":119472,"_2824":119523},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3337":70051,"_29196":70029,"_20242":119525,"_5":13829,"_26574":119472,"_2824":119526},[],"Clave privada `device.key`",{"_3337":70052,"_29196":70029,"_20242":119528,"_5":13829,"_26574":119472,"_2824":119529},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3337":70053,"_29196":70029,"_20242":119531,"_5":13829,"_26574":119472,"_2824":119532},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3337":70054,"_29196":70029,"_20242":119534,"_5":13829,"_26574":119475,"_2824":119535},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3337":70055,"_29196":70029,"_20242":119537,"_5":13829,"_26574":119475,"_2824":119538},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3337":70056,"_29196":70029,"_20242":119540,"_5":13829,"_26574":119475,"_2824":119541},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3337":70057,"_29196":70057,"_5":14181,"_2824":119543,"_29540":119544,"_20242":119546,"_26574":70057},"Resolución de problemas PKI",[47528,113284,52983,119545],"Resolución de problemas",[],{"_3337":70058,"_29196":70057,"_20242":119548,"_5":13829,"_26574":70057,"_2824":119549},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3337":70059,"_29196":70057,"_5":29537,"_20242":119551,"_26574":119552,"_2824":119553},[],"/docs/pr-preview/pr-57/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3337":70060,"_29196":70057,"_5":29537,"_20242":119555,"_26574":119556,"_2824":119557},[],"/docs/pr-preview/pr-57/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3337":70061,"_29196":70057,"_5":29537,"_20242":119559,"_26574":119560,"_2824":119561},[],"/docs/pr-preview/pr-57/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3337":70062,"_29196":70057,"_20242":119563,"_5":13829,"_26574":70057,"_2824":119564},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3337":70063,"_29196":70057,"_20242":119566,"_5":13829,"_26574":70057,"_2824":119567},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3337":70064,"_29196":70057,"_20242":119569,"_5":13829,"_26574":119552,"_2824":116792},[],{"_3337":70065,"_29196":70057,"_20242":119571,"_5":13829,"_26574":119552,"_2824":115457},[],{"_3337":70066,"_29196":70057,"_20242":119573,"_5":13829,"_26574":119552,"_2824":111905},[],{"_3337":70067,"_29196":70057,"_20242":119575,"_5":13829,"_26574":119552,"_2824":51822},[],{"_3337":70068,"_29196":70057,"_20242":119577,"_5":13829,"_26574":119552,"_2824":119578},[],"Existe, está activa y sus fechas son utilizables.",{"_3337":70069,"_29196":70057,"_20242":119580,"_5":13829,"_26574":119552,"_2824":119581},[],"Autoridades.",{"_3337":70070,"_29196":70057,"_20242":119583,"_5":13829,"_26574":119552,"_2824":119584},[],"Clave",{"_3337":70071,"_29196":70057,"_20242":119586,"_5":13829,"_26574":119552,"_2824":119587},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3337":70072,"_29196":70057,"_20242":119589,"_5":13829,"_26574":119552,"_2824":119590},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3337":70073,"_29196":70057,"_20242":119592,"_5":13829,"_26574":119552,"_2824":55444},[],{"_3337":70074,"_29196":70057,"_20242":119594,"_5":13829,"_26574":119552,"_2824":119595},[],"PEM correcto y firma verificable.",{"_3337":70075,"_29196":70057,"_20242":119597,"_5":13829,"_26574":119552,"_2824":55450},[],{"_3337":70076,"_29196":70057,"_20242":119599,"_5":13829,"_26574":119552,"_2824":119600},[],"Perfil",{"_3337":70077,"_29196":70057,"_20242":119602,"_5":13829,"_26574":119552,"_2824":119603},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3337":70078,"_29196":70057,"_20242":119605,"_5":13829,"_26574":119552,"_2824":119606},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3337":70079,"_29196":70057,"_20242":119608,"_5":13829,"_26574":119552,"_2824":116943},[],{"_3337":70080,"_29196":70057,"_20242":119610,"_5":13829,"_26574":119552,"_2824":119611},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3337":70081,"_29196":70057,"_20242":119613,"_5":13829,"_26574":119552,"_2824":119614},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3337":70082,"_29196":70057,"_20242":119616,"_5":13829,"_26574":119552,"_2824":119617},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3337":70083,"_29196":70057,"_20242":119619,"_5":13829,"_26574":119552,"_2824":119620},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3337":70084,"_29196":70057,"_20242":119622,"_5":13829,"_26574":119556,"_2824":119623},[],"Revisa cada frontera por separado:",{"_3337":70085,"_29196":70057,"_20242":119625,"_5":13829,"_26574":119556,"_2824":119626},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3337":70086,"_29196":70057,"_20242":119628,"_5":13829,"_26574":119556,"_2824":119629},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3337":70087,"_29196":70057,"_20242":119631,"_5":13829,"_26574":119556,"_2824":119632},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3337":70088,"_29196":70057,"_20242":119634,"_5":13829,"_26574":119556,"_2824":119635},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3337":70089,"_29196":70057,"_20242":119637,"_5":13829,"_26574":119556,"_2824":119638},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3337":70090,"_29196":70057,"_20242":119640,"_5":13829,"_26574":119556,"_2824":119641},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3337":70091,"_29196":70057,"_20242":119643,"_5":13829,"_26574":119560,"_2824":119644},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3337":70092,"_29196":70057,"_20242":119646,"_5":13829,"_26574":119560,"_2824":119647},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3337":70093,"_29196":70093,"_5":14181,"_2824":119649,"_29540":119650,"_20242":119652,"_26574":70093},"3.8.0 a 4.0.0",[47528,119651],"Actualizaciones",[],{"_3337":70094,"_29196":70093,"_20242":119654,"_5":13829,"_26574":70093,"_2824":119655},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3337":70095,"_29196":70093,"_5":29537,"_20242":119657,"_26574":119658,"_2824":119659},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3337":70096,"_29196":70093,"_5":29537,"_20242":119661,"_26574":119662,"_2824":119663},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3337":70097,"_29196":70093,"_5":29537,"_20242":119665,"_26574":119666,"_2824":119667},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3337":70098,"_29196":70093,"_5":29537,"_20242":119669,"_26574":119670,"_2824":119671},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3337":70099,"_29196":70093,"_5":29537,"_20242":119673,"_26574":119674,"_2824":119675},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3337":70100,"_29196":70093,"_5":29537,"_20242":119677,"_26574":119678,"_2824":119679},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3337":70101,"_29196":70093,"_5":29537,"_20242":119681,"_26574":119682,"_2824":55536},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3337":70102,"_29196":70093,"_5":29537,"_20242":119684,"_26574":119685,"_2824":119686},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3337":70103,"_29196":70093,"_5":29537,"_20242":119688,"_26574":119689,"_2824":119690},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3337":70104,"_29196":70093,"_5":29537,"_20242":119692,"_26574":119693,"_2824":119694},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3337":70105,"_29196":70093,"_5":29537,"_20242":119696,"_26574":119697,"_2824":119698},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3337":70106,"_29196":70093,"_5":29537,"_20242":119700,"_26574":119701,"_2824":119702},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3337":70107,"_29196":70093,"_5":29537,"_20242":119704,"_26574":119705,"_2824":119706},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3337":70108,"_29196":70093,"_5":29537,"_20242":119708,"_26574":119709,"_2824":119710},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3337":70109,"_29196":70093,"_5":29537,"_20242":119712,"_26574":119713,"_2824":119714},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3337":70110,"_29196":70093,"_5":29537,"_20242":119716,"_26574":119717,"_2824":119718},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3337":70111,"_29196":70093,"_5":29537,"_20242":119720,"_26574":119721,"_2824":119722},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3337":70112,"_29196":70093,"_5":29537,"_20242":119724,"_26574":119725,"_2824":119726},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3337":70113,"_29196":70093,"_5":29537,"_20242":119728,"_26574":119729,"_2824":119730},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3337":70114,"_29196":70093,"_5":29537,"_20242":119732,"_26574":119733,"_2824":119734},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3337":70115,"_29196":70093,"_5":29537,"_20242":119736,"_26574":119737,"_2824":119738},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3337":70116,"_29196":70093,"_5":29537,"_20242":119740,"_26574":119741,"_2824":119742},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3337":70117,"_29196":70093,"_5":29537,"_20242":119744,"_26574":119745,"_2824":119746},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3337":70118,"_29196":70093,"_5":29537,"_20242":119748,"_26574":119749,"_2824":119750},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3337":70119,"_29196":70093,"_5":29537,"_20242":119752,"_26574":119753,"_2824":119754},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3337":70120,"_29196":70093,"_5":29537,"_20242":119756,"_26574":119757,"_2824":119758},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3337":70121,"_29196":70093,"_5":29537,"_20242":119760,"_26574":119761,"_2824":119762},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3337":70122,"_29196":70093,"_5":29537,"_20242":119764,"_26574":119765,"_2824":119766},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3337":70123,"_29196":70093,"_5":29537,"_20242":119768,"_26574":119769,"_2824":119770},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3337":70124,"_29196":70093,"_5":29537,"_20242":119772,"_26574":119773,"_2824":119774},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3337":70125,"_29196":70093,"_5":29537,"_20242":119776,"_26574":119777,"_2824":119778},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3337":70126,"_29196":70093,"_5":29537,"_20242":119780,"_26574":119781,"_2824":119782},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3337":70127,"_29196":70093,"_5":29537,"_20242":119784,"_26574":119785,"_2824":119786},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3337":70128,"_29196":70093,"_5":29537,"_20242":119788,"_26574":119789,"_2824":119790},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3337":70129,"_29196":70093,"_5":29537,"_20242":119792,"_26574":119793,"_2824":115803},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3337":70130,"_29196":70093,"_5":29537,"_20242":119795,"_26574":119796,"_2824":119797},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3337":70131,"_29196":70093,"_5":29537,"_20242":119799,"_26574":119800,"_2824":119801},[],"/docs/pr-preview/pr-57/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3337":70132,"_29196":70093,"_20242":119803,"_5":13829,"_26574":70093,"_2824":119804},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3337":70133,"_29196":70093,"_20242":119806,"_5":13829,"_26574":70093,"_2824":119807},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3337":70134,"_29196":70093,"_20242":119809,"_5":13829,"_26574":70093,"_2824":119810},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3337":70135,"_29196":70093,"_20242":119812,"_5":13829,"_26574":70093,"_2824":119813},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3337":70136,"_29196":70093,"_20242":119815,"_5":13829,"_26574":70093,"_2824":119816},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3337":70137,"_29196":70093,"_20242":119818,"_5":13829,"_26574":70093,"_2824":119819},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3337":70138,"_29196":70093,"_20242":119821,"_5":13829,"_26574":70093,"_2824":119822},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3337":70139,"_29196":70093,"_20242":119824,"_5":13829,"_26574":119662,"_2824":119825},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3337":70140,"_29196":70093,"_20242":119827,"_5":13829,"_26574":119662,"_2824":119828},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3337":70141,"_29196":70093,"_20242":119830,"_5":13829,"_26574":119666,"_2824":119831},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3337":70142,"_29196":70093,"_20242":119833,"_5":13829,"_26574":119666,"_2824":119834},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3337":70143,"_29196":70093,"_20242":119836,"_5":13829,"_26574":119670,"_2824":119837},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3337":70144,"_29196":70093,"_20242":119839,"_5":13829,"_26574":119674,"_2824":119840},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3337":70145,"_29196":70093,"_20242":119842,"_5":13829,"_26574":119674,"_2824":119843},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3337":70146,"_29196":70093,"_20242":119845,"_5":13829,"_26574":119674,"_2824":119846},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3337":70147,"_29196":70093,"_20242":119848,"_5":13829,"_26574":119674,"_2824":119849},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3337":70148,"_29196":70093,"_20242":119851,"_5":13829,"_26574":119674,"_2824":119852},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3337":70149,"_29196":70093,"_20242":119854,"_5":13829,"_26574":119678,"_2824":119855},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3337":70150,"_29196":70093,"_20242":119857,"_5":13829,"_26574":119678,"_2824":119858},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3337":70151,"_29196":70093,"_20242":119860,"_5":13829,"_26574":119678,"_2824":119861},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3337":70152,"_29196":70093,"_20242":119863,"_5":13829,"_26574":119678,"_2824":119864},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3337":70153,"_29196":70093,"_20242":119866,"_5":13829,"_26574":119678,"_2824":119867},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3337":70154,"_29196":70093,"_20242":119869,"_5":13829,"_26574":119678,"_2824":119870},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3337":70155,"_29196":70093,"_20242":119872,"_5":13829,"_26574":119682,"_2824":119873},[],"Cambio",{"_3337":70156,"_29196":70093,"_20242":119875,"_5":13829,"_26574":119682,"_2824":119876},[],"A quién afecta",{"_3337":70157,"_29196":70093,"_20242":119878,"_5":13829,"_26574":119682,"_2824":119879},[],"Gravedad",{"_3337":70158,"_29196":70093,"_20242":119881,"_5":13829,"_26574":119682,"_2824":118493},[],{"_3337":70159,"_29196":70093,"_20242":119883,"_5":13829,"_26574":119682,"_2824":119690},[],{"_3337":70160,"_29196":70093,"_20242":119885,"_5":13829,"_26574":119682,"_2824":119886},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3337":70161,"_29196":70093,"_20242":119888,"_5":13829,"_26574":119682,"_2824":119889},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3337":70162,"_29196":70093,"_20242":119891,"_5":13829,"_26574":119682,"_2824":119892},[],"Copiar los datos a los volúmenes nuevos",{"_3337":70163,"_29196":70093,"_20242":119894,"_5":13829,"_26574":119682,"_2824":119694},[],{"_3337":70164,"_29196":70093,"_20242":119896,"_5":13829,"_26574":119682,"_2824":119897},[],"Todas las releases de Helm",{"_3337":70165,"_29196":70093,"_20242":119899,"_5":13829,"_26574":119682,"_2824":119900},[],"Alta: `helm upgrade` falla",{"_3337":70166,"_29196":70093,"_20242":119902,"_5":13829,"_26574":119682,"_2824":119903},[],"Eliminar o renombrar las claves heredadas",{"_3337":70167,"_29196":70093,"_20242":119905,"_5":13829,"_26574":119682,"_2824":119698},[],{"_3337":70168,"_29196":70093,"_20242":119907,"_5":13829,"_26574":119682,"_2824":119908},[],"Todos los despliegues",{"_3337":70169,"_29196":70093,"_20242":119910,"_5":13829,"_26574":119682,"_2824":119911},[],"Alta: sin principal de bootstrap no hay administrador",{"_3337":70170,"_29196":70093,"_20242":119913,"_5":13829,"_26574":119682,"_2824":119914},[],"Configurar `services.authz`",{"_3337":70171,"_29196":70093,"_20242":119916,"_5":13829,"_26574":119682,"_2824":119702},[],{"_3337":70172,"_29196":70093,"_20242":119918,"_5":13829,"_26574":119682,"_2824":119897},[],{"_3337":70173,"_29196":70093,"_20242":119920,"_5":13829,"_26574":119682,"_2824":119921},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3337":70174,"_29196":70093,"_20242":119923,"_5":13829,"_26574":119682,"_2824":119924},[],"Mover JWKS y roles a `services.authz`",{"_3337":70175,"_29196":70093,"_20242":119926,"_5":13829,"_26574":119682,"_2824":119722},[],{"_3337":70176,"_29196":70093,"_20242":119928,"_5":13829,"_26574":119682,"_2824":119929},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3337":70177,"_29196":70093,"_20242":119931,"_5":13829,"_26574":119682,"_2824":119932},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3337":70178,"_29196":70093,"_20242":119934,"_5":13829,"_26574":119682,"_2824":119935},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3337":70179,"_29196":70093,"_20242":119937,"_5":13829,"_26574":119682,"_2824":119726},[],{"_3337":70180,"_29196":70093,"_20242":119939,"_5":13829,"_26574":119682,"_2824":119940},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3337":70181,"_29196":70093,"_20242":119942,"_5":13829,"_26574":119682,"_2824":119943},[],"Alta: el backend ya no arranca con ellos",{"_3337":70182,"_29196":70093,"_20242":119945,"_5":13829,"_26574":119682,"_2824":119946},[],"Pasar a PostgreSQL antes de actualizar",{"_3337":70183,"_29196":70093,"_20242":119948,"_5":13829,"_26574":119682,"_2824":119949},[],"Webhooks con referencias a archivos",{"_3337":70184,"_29196":70093,"_20242":119951,"_5":13829,"_26574":119682,"_2824":119952},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3337":70185,"_29196":70093,"_20242":119954,"_5":13829,"_26574":119682,"_2824":119955},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3337":70186,"_29196":70093,"_20242":119957,"_5":13829,"_26574":119682,"_2824":119958},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3337":70187,"_29196":70093,"_20242":119960,"_5":13829,"_26574":119682,"_2824":119706},[],{"_3337":70188,"_29196":70093,"_20242":119962,"_5":13829,"_26574":119682,"_2824":119963},[],"Releases con identidades por servicio o material de claves montado",{"_3337":70189,"_29196":70093,"_20242":119965,"_5":13829,"_26574":119682,"_2824":119966},[],"Media: los servicios no pueden leer sus archivos",{"_3337":70190,"_29196":70093,"_20242":119968,"_5":13829,"_26574":119682,"_2824":119969},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3337":70191,"_29196":70093,"_20242":119971,"_5":13829,"_26574":119682,"_2824":119710},[],{"_3337":70192,"_29196":70093,"_20242":119973,"_5":13829,"_26574":119682,"_2824":119974},[],"Releases que definen `amqp.tls`",{"_3337":70193,"_29196":70093,"_20242":119976,"_5":13829,"_26574":119682,"_2824":119977},[],"Media: los clientes se conectan al puerto equivocado",{"_3337":70194,"_29196":70093,"_20242":119979,"_5":13829,"_26574":119682,"_2824":119980},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3337":70195,"_29196":70093,"_20242":119982,"_5":13829,"_26574":119682,"_2824":119730},[],{"_3337":70196,"_29196":70093,"_20242":119984,"_5":13829,"_26574":119682,"_2824":119985},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3337":70197,"_29196":70093,"_20242":119987,"_5":13829,"_26574":119682,"_2824":119988},[],"Media: las claves de CA quedan sin gestionar",{"_3337":70198,"_29196":70093,"_20242":119990,"_5":13829,"_26574":119682,"_2824":119991},[],"Ejecutar la migración de CA a KMS",{"_3337":70199,"_29196":70093,"_20242":119993,"_5":13829,"_26574":119682,"_2824":119994},[],"Verificación del certificado del receptor",{"_3337":70200,"_29196":70093,"_20242":119996,"_5":13829,"_26574":119682,"_2824":119997},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3337":70201,"_29196":70093,"_20242":119999,"_5":13829,"_26574":119682,"_2824":120000},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3337":70202,"_29196":70093,"_20242":120002,"_5":13829,"_26574":119682,"_2824":120003},[],"Poner `insecure_skip_verify` a `false`",{"_3337":70203,"_29196":70093,"_20242":120005,"_5":13829,"_26574":119682,"_2824":119742},[],{"_3337":70204,"_29196":70093,"_20242":120007,"_5":13829,"_26574":119682,"_2824":120008},[],"Scripts y consolas que editan DMS por API",{"_3337":70205,"_29196":70093,"_20242":120010,"_5":13829,"_26574":119682,"_2824":120011},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3337":70206,"_29196":70093,"_20242":120013,"_5":13829,"_26574":119682,"_2824":120014},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3337":70207,"_29196":70093,"_20242":120016,"_5":13829,"_26574":119682,"_2824":119758},[],{"_3337":70208,"_29196":70093,"_20242":120018,"_5":13829,"_26574":119682,"_2824":120019},[],"Consumidores que leen el campo `events` del dispositivo",{"_3337":70209,"_29196":70093,"_20242":120021,"_5":13829,"_26574":119682,"_2824":120022},[],"Media: el campo desaparece",{"_3337":70210,"_29196":70093,"_20242":120024,"_5":13829,"_26574":119682,"_2824":120025},[],"Usar los nuevos endpoints de eventos",{"_3337":70211,"_29196":70093,"_20242":120027,"_5":13829,"_26574":119682,"_2824":119762},[],{"_3337":70212,"_29196":70093,"_20242":120029,"_5":13829,"_26574":119682,"_2824":120030},[],"Despliegues con roles VA cuyo firmante no está en el inventario de CAs",{"_3337":70213,"_29196":70093,"_20242":120032,"_5":13829,"_26574":119682,"_2824":120033},[],"Media: la migración de la VA aborta",{"_3337":70214,"_29196":70093,"_20242":120035,"_5":13829,"_26574":119682,"_2824":120036},[],"Corregir los roles afectados antes de actualizar",{"_3337":70215,"_29196":70093,"_20242":120038,"_5":13829,"_26574":119682,"_2824":119714},[],{"_3337":70216,"_29196":70093,"_20242":120040,"_5":13829,"_26574":119682,"_2824":120041},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3337":70217,"_29196":70093,"_20242":120043,"_5":13829,"_26574":119682,"_2824":120044},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3337":70218,"_29196":70093,"_20242":120046,"_5":13829,"_26574":119682,"_2824":120047},[],"Actualizar el archivo de values",{"_3337":70219,"_29196":70093,"_20242":120049,"_5":13829,"_26574":119682,"_2824":119750},[],{"_3337":70220,"_29196":70093,"_20242":120051,"_5":13829,"_26574":119682,"_2824":120052},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3337":70221,"_29196":70093,"_20242":120054,"_5":13829,"_26574":119682,"_2824":120055},[],"Baja: prevalece el ID de la URL",{"_3337":70222,"_29196":70093,"_20242":120057,"_5":13829,"_26574":119682,"_2824":120058},[],"Enviar el ID en la URL",{"_3337":70223,"_29196":70093,"_20242":120060,"_5":13829,"_26574":119682,"_2824":119754},[],{"_3337":70224,"_29196":70093,"_20242":120062,"_5":13829,"_26574":119682,"_2824":120063},[],"Consumidores que comparan el `type` del certificado",{"_3337":70225,"_29196":70093,"_20242":120065,"_5":13829,"_26574":119682,"_2824":120066},[],"Baja: dos valores cambian de nombre",{"_3337":70226,"_29196":70093,"_20242":120068,"_5":13829,"_26574":119682,"_2824":120069},[],"Adaptar los consumidores",{"_3337":70227,"_29196":70093,"_20242":120071,"_5":13829,"_26574":119682,"_2824":119746},[],{"_3337":70228,"_29196":70093,"_20242":120073,"_5":13829,"_26574":119682,"_2824":120074},[],"Cualquier DMS",{"_3337":70229,"_29196":70093,"_20242":120076,"_5":13829,"_26574":119682,"_2824":120077},[],"Baja: solo informativo",{"_3337":70230,"_29196":70093,"_20242":120079,"_5":13829,"_26574":119682,"_2824":120080},[],"Revisar ambos bloques antes de editar",{"_3337":70231,"_29196":70093,"_20242":120082,"_5":13829,"_26574":119689,"_2824":120083},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3337":70232,"_29196":70093,"_20242":120085,"_5":13829,"_26574":119689,"_2824":120086},[],"El paso 4 de la guía de migración copia los datos.",{"_3337":70233,"_29196":70093,"_20242":120088,"_5":13829,"_26574":119693,"_2824":120089},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3337":70234,"_29196":70093,"_20242":120091,"_5":13829,"_26574":119697,"_2824":120092},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3337":70235,"_29196":70093,"_20242":120094,"_5":13829,"_26574":119701,"_2824":120095},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3337":70236,"_29196":70093,"_20242":120097,"_5":13829,"_26574":119705,"_2824":120098},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3337":70237,"_29196":70093,"_20242":120100,"_5":13829,"_26574":119705,"_2824":120101},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3337":70238,"_29196":70093,"_20242":120103,"_5":13829,"_26574":119709,"_2824":120104},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3337":70239,"_29196":70093,"_20242":120106,"_5":13829,"_26574":119713,"_2824":120107},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3337":70240,"_29196":70093,"_20242":120109,"_5":13829,"_26574":119713,"_2824":120110},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3337":70241,"_29196":70093,"_20242":120112,"_5":13829,"_26574":119713,"_2824":120113},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3337":70242,"_29196":70093,"_20242":120115,"_5":13829,"_26574":119713,"_2824":120116},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3337":70243,"_29196":70093,"_20242":120118,"_5":13829,"_26574":119713,"_2824":120119},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3337":70244,"_29196":70093,"_20242":120121,"_5":13829,"_26574":119713,"_2824":120122},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3337":70245,"_29196":70093,"_20242":120124,"_5":13829,"_26574":119721,"_2824":120125},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3337":70246,"_29196":70093,"_20242":120127,"_5":13829,"_26574":119721,"_2824":120128},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3337":70247,"_29196":70093,"_20242":120130,"_5":13829,"_26574":119721,"_2824":120131},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3337":70248,"_29196":70093,"_20242":120133,"_5":13829,"_26574":119721,"_2824":120134},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3337":70249,"_29196":70093,"_20242":120136,"_5":13829,"_26574":119721,"_2824":120137},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3337":70250,"_29196":70093,"_20242":120139,"_5":13829,"_26574":119725,"_2824":120140},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3337":70251,"_29196":70093,"_20242":120142,"_5":13829,"_26574":119729,"_2824":120143},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3337":70252,"_29196":70093,"_20242":120145,"_5":13829,"_26574":119729,"_2824":120146},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3337":70253,"_29196":70093,"_20242":120148,"_5":13829,"_26574":119729,"_2824":120149},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3337":70254,"_29196":70093,"_20242":120151,"_5":13829,"_26574":119729,"_2824":120152},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3337":70255,"_29196":70093,"_20242":120154,"_5":13829,"_26574":119729,"_2824":120155},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3337":70256,"_29196":70093,"_20242":120157,"_5":13829,"_26574":119729,"_2824":120158},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`); libera o elimina primero los certificados dependientes.",{"_3337":70257,"_29196":70093,"_20242":120160,"_5":13829,"_26574":119729,"_2824":120161},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3337":70258,"_29196":70093,"_20242":120163,"_5":13829,"_26574":119729,"_2824":120164},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3337":70259,"_29196":70093,"_20242":120166,"_5":13829,"_26574":119737,"_2824":120167},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3337":70260,"_29196":70093,"_20242":120169,"_5":13829,"_26574":119737,"_2824":120170},[],"Campo en 3.8.0",{"_3337":70261,"_29196":70093,"_20242":120172,"_5":13829,"_26574":119737,"_2824":120173},[],"Campo en 4.0.0",{"_3337":70262,"_29196":70093,"_20242":120175,"_5":13829,"_26574":119737,"_2824":56030},[],{"_3337":70263,"_29196":70093,"_20242":120177,"_5":13829,"_26574":119737,"_2824":120178},[],"`insecure_skip_verify` (con el valor negado)",{"_3337":70264,"_29196":70093,"_20242":120180,"_5":13829,"_26574":119737,"_2824":56036},[],{"_3337":70265,"_29196":70093,"_20242":120182,"_5":13829,"_26574":119737,"_2824":56039},[],{"_3337":70266,"_29196":70093,"_20242":120184,"_5":13829,"_26574":119737,"_2824":56042},[],{"_3337":70267,"_29196":70093,"_20242":120186,"_5":13829,"_26574":119737,"_2824":56045},[],{"_3337":70268,"_29196":70093,"_20242":120188,"_5":13829,"_26574":119737,"_2824":56048},[],{"_3337":70269,"_29196":70093,"_20242":120190,"_5":13829,"_26574":119737,"_2824":56051},[],{"_3337":70270,"_29196":70093,"_20242":120192,"_5":13829,"_26574":119737,"_2824":120193},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3337":70271,"_29196":70093,"_20242":120195,"_5":13829,"_26574":119737,"_2824":120196},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3337":70272,"_29196":70093,"_20242":120198,"_5":13829,"_26574":119737,"_2824":120199},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3337":70273,"_29196":70093,"_20242":120201,"_5":13829,"_26574":119741,"_2824":120202},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3337":70274,"_29196":70093,"_20242":120204,"_5":13829,"_26574":119741,"_2824":120205},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3337":70275,"_29196":70093,"_20242":120207,"_5":13829,"_26574":119741,"_2824":120208},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3337":70276,"_29196":70093,"_20242":120210,"_5":13829,"_26574":119745,"_2824":120211},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3337":70277,"_29196":70093,"_20242":120213,"_5":13829,"_26574":119749,"_2824":120214},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3337":70278,"_29196":70093,"_20242":120216,"_5":13829,"_26574":119753,"_2824":120217},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3337":70279,"_29196":70093,"_20242":120219,"_5":13829,"_26574":119757,"_2824":120220},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3337":70280,"_29196":70093,"_20242":120222,"_5":13829,"_26574":119757,"_2824":120223},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3337":70281,"_29196":70093,"_20242":120225,"_5":13829,"_26574":119757,"_2824":120226},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3337":70282,"_29196":70093,"_20242":120228,"_5":13829,"_26574":119757,"_2824":120229},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3337":70283,"_29196":70093,"_20242":120231,"_5":13829,"_26574":119761,"_2824":120232},[],"El campo `crl_options.subject_key_id_signer` de los roles VA se sustituye por `signer_certificate_serial_number`; actualiza los clientes que envían el campo antiguo (la página de CRL documenta el campo nuevo). La migración de la VA resuelve automáticamente el firmante de cada rol: cuando varias CAs comparten la clave del firmante, usa la más antigua y registra un aviso, pero aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` cuando no existe ningún certificado con ese SKI. Corrige esos roles antes de actualizar.",{"_3337":70284,"_29196":70093,"_20242":120234,"_5":13829,"_26574":119761,"_2824":120235},[],"Si escribiste políticas `authz` propias que filtran roles VA por la columna antigua `crl_subject_key_id_signer`, reescríbelas contra la columna nueva `crl_signer_certificate_serial_number`.",{"_3337":70285,"_29196":70093,"_20242":120237,"_5":13829,"_26574":119765,"_2824":120238},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3337":70286,"_29196":70093,"_20242":120240,"_5":13829,"_26574":119769,"_2824":120241},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_3337":70287,"_29196":70093,"_20242":120243,"_5":13829,"_26574":119769,"_2824":120244},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3337":70288,"_29196":70093,"_20242":120246,"_5":13829,"_26574":119769,"_2824":120247},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3337":70289,"_29196":70093,"_20242":120249,"_5":13829,"_26574":119769,"_2824":120250},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3337":70290,"_29196":70093,"_20242":120252,"_5":13829,"_26574":119769,"_2824":120253},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3337":70291,"_29196":70093,"_20242":120255,"_5":13829,"_26574":119773,"_2824":120256},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3337":70292,"_29196":70093,"_20242":120258,"_5":13829,"_26574":119773,"_2824":120259},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3337":70293,"_29196":70093,"_20242":120261,"_5":13829,"_26574":119773,"_2824":120262},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3337":70294,"_29196":70093,"_20242":120264,"_5":13829,"_26574":119773,"_2824":120265},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3337":70295,"_29196":70093,"_20242":120267,"_5":13829,"_26574":119773,"_2824":120268},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3337":70296,"_29196":70093,"_20242":120270,"_5":13829,"_26574":119773,"_2824":120271},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3337":70297,"_29196":70093,"_20242":120273,"_5":13829,"_26574":119773,"_2824":120274},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3337":70298,"_29196":70093,"_20242":120276,"_5":13829,"_26574":119773,"_2824":120277},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3337":70299,"_29196":70093,"_20242":120279,"_5":13829,"_26574":119773,"_2824":120280},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3337":70300,"_29196":70093,"_20242":120282,"_5":13829,"_26574":119773,"_2824":120283},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3337":70301,"_29196":70093,"_20242":120285,"_5":13829,"_26574":119773,"_2824":120286},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3337":70302,"_29196":70093,"_20242":120288,"_5":13829,"_26574":119773,"_2824":120289},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3337":70303,"_29196":70093,"_20242":120291,"_5":13829,"_26574":119777,"_2824":120292},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3337":70304,"_29196":70093,"_20242":120294,"_5":13829,"_26574":119777,"_2824":120295},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3337":70305,"_29196":70093,"_20242":120297,"_5":13829,"_26574":119781,"_2824":120298},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3337":70306,"_29196":70093,"_20242":120300,"_5":13829,"_26574":119781,"_2824":120301},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3337":70307,"_29196":70093,"_20242":120303,"_5":13829,"_26574":119781,"_2824":120304},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3337":70308,"_29196":70093,"_20242":120306,"_5":13829,"_26574":119781,"_2824":120307},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3337":70309,"_29196":70093,"_20242":120309,"_5":13829,"_26574":119781,"_2824":120310},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3337":70310,"_29196":70093,"_20242":120312,"_5":13829,"_26574":119781,"_2824":120313},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3337":70311,"_29196":70093,"_20242":120315,"_5":13829,"_26574":119781,"_2824":120316},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3337":70312,"_29196":70093,"_20242":120318,"_5":13829,"_26574":119781,"_2824":120319},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3337":70313,"_29196":70093,"_20242":120321,"_5":13829,"_26574":119781,"_2824":120322},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3337":70314,"_29196":70093,"_20242":120324,"_5":13829,"_26574":119781,"_2824":120325},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3337":70315,"_29196":70093,"_20242":120327,"_5":13829,"_26574":119781,"_2824":120328},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3337":70316,"_29196":70093,"_20242":120330,"_5":13829,"_26574":119785,"_2824":120331},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3337":70317,"_29196":70093,"_20242":120333,"_5":13829,"_26574":119785,"_2824":120334},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3337":70318,"_29196":70093,"_20242":120336,"_5":13829,"_26574":119789,"_2824":120337},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3337":70319,"_29196":70093,"_20242":120339,"_5":13829,"_26574":119789,"_2824":120340},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3337":70320,"_29196":70093,"_20242":120342,"_5":13829,"_26574":119789,"_2824":120343},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3337":70321,"_29196":70093,"_20242":120345,"_5":13829,"_26574":119789,"_2824":120346},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3337":70322,"_29196":70093,"_20242":120348,"_5":13829,"_26574":119789,"_2824":120349},[],"Los README de `goose-lamassu` y `ca-to-kms-migration` en el repositorio `lamassuiot` documentan el formato de `pki` de 4.0.0: orden de migración, privilegios entre esquemas y opciones de las herramientas. Sigue la forma con `dbname=pki` mostrada arriba y consulta los README antes de aplicar las migraciones.",{"_3337":70323,"_29196":70093,"_20242":120351,"_5":13829,"_26574":119789,"_2824":120352},[],"Aplica las migraciones de esquema en el orden `kms` → `ca` → `va`; `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden ejecutarse en cualquier momento. La migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema` mientras `kms` no esté migrado, y `va` necesita `ca` migrado. Las migraciones de `ca` y `va` además leen tablas que pertenecen a otro esquema, así que el rol de PostgreSQL que las ejecuta necesita privilegios sobre él: `USAGE` sobre el esquema `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys` para la migración de `ca`, y `USAGE` sobre el esquema `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates` para la migración de `va`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido.",{"_3337":70324,"_29196":70093,"_20242":120354,"_5":13829,"_26574":119789,"_2824":120355},[],"Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédale `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`); el servicio de CA lee certificados y CAs a través de esa vista, y sin el permiso toda lectura de certificados y CAs falla con `permission denied for table certificates_view`.",{"_3337":70325,"_29196":70093,"_20242":120357,"_5":13829,"_26574":119793,"_2824":120358},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3337":70326,"_29196":70093,"_20242":120360,"_5":13829,"_26574":119793,"_2824":120361},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3337":70327,"_29196":70093,"_20242":120363,"_5":13829,"_26574":119793,"_2824":120364},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3337":70328,"_29196":70093,"_20242":120366,"_5":13829,"_26574":119793,"_2824":120367},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3337":70329,"_29196":70093,"_20242":120369,"_5":13829,"_26574":119793,"_2824":120370},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_3337":70330,"_29196":70093,"_20242":120372,"_5":13829,"_26574":119793,"_2824":120373},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3337":70331,"_29196":70093,"_20242":120375,"_5":13829,"_26574":119793,"_2824":120376},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3337":70332,"_29196":70093,"_20242":120378,"_5":13829,"_26574":119796,"_2824":120379},[],"Tras la actualización, comprueba en este orden:",{"_3337":70333,"_29196":70093,"_20242":120381,"_5":13829,"_26574":119796,"_2824":120382},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS.",{"_3337":70334,"_29196":70093,"_20242":120384,"_5":13829,"_26574":119796,"_2824":120385},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3337":70335,"_29196":70093,"_20242":120387,"_5":13829,"_26574":119796,"_2824":120388},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3337":70336,"_29196":70093,"_20242":120390,"_5":13829,"_26574":119796,"_2824":120391},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_3337":70337,"_29196":70093,"_20242":120393,"_5":13829,"_26574":119796,"_2824":120394},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que puedes usar para confirmar el registro.",{"_3337":70338,"_29196":70093,"_20242":120396,"_5":13829,"_26574":119796,"_2824":120397},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3337":70339,"_29196":70093,"_20242":120399,"_5":13829,"_26574":119796,"_2824":120400},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3337":70340,"_29196":70093,"_20242":120402,"_5":13829,"_26574":119796,"_2824":120403},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3337":70341,"_29196":70093,"_20242":120405,"_5":13829,"_26574":119796,"_2824":120406},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3337":70342,"_29196":70093,"_20242":120408,"_5":13829,"_26574":119796,"_2824":120409},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3337":70343,"_29196":70093,"_20242":120411,"_5":13829,"_26574":119796,"_2824":120412},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3337":70344,"_29196":70093,"_20242":120414,"_5":13829,"_26574":119796,"_2824":120415},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3337":70345,"_29196":70093,"_20242":120417,"_5":13829,"_26574":119796,"_2824":120418},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3337":70346,"_29196":70093,"_20242":120420,"_5":13829,"_26574":119796,"_2824":120421},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3337":70347,"_29196":70093,"_20242":120423,"_5":13829,"_26574":119800,"_2824":120424},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3337":70348,"_29196":70093,"_20242":120426,"_5":13829,"_26574":119800,"_2824":120427},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3337":70349,"_29196":70093,"_20242":120429,"_5":13829,"_26574":119800,"_2824":120430},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3337":70350,"_29196":70093,"_20242":120432,"_5":13829,"_26574":119800,"_2824":120433},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3337":70351,"_29196":70093,"_20242":120435,"_5":13829,"_26574":119800,"_2824":120436},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_56300":120438,"_56302":120439,"_56304":120440,"_56306":120441,"_17510":2846,"_67541":2846},"spanish",[2824,29196,5,26574],{"_2824":24190,"_29196":24190,"_5":24190,"_26574":24190},{"_2824":120442,"_29196":123249,"_5":126056,"_26574":128863},{"_4481":120443,"_56310":120444,"_5":24190},{"_13905":3122,"_14281":5410,"_14300":4322,"_28235":10700,"_14287":3903,"_19213":8192,"_13926":5271,"_13933":5598,"_28177":3407,"_28586":7293,"_28607":12202,"_28211":7780,"_33440":6288,"_28314":24024,"_28651":2864,"_33447":6257,"_33450":3845,"_33453":3814,"_33456":17583,"_29028":22860,"_33461":6297,"_33463":13953,"_29058":24196,"_14296":5023,"_33467":6884,"_33470":5507,"_33472":6700,"_28635":4583,"_29023":3813,"_29071":9768,"_33477":15964,"_33479":3307,"_33481":6259,"_28331":3267,"_33484":8196,"_33486":3284,"_33488":3298,"_33490":7356,"_33492":3382,"_28248":19493,"_33495":3421,"_33497":3008,"_28242":8197,"_28672":10029,"_33501":3006,"_33503":13630,"_33506":16999,"_28288":13500,"_33510":3319,"_28168":5730,"_33513":5898,"_28216":5316,"_33516":8292,"_33518":19489,"_33521":6661,"_14290":4555,"_29255":8705,"_33525":5265,"_33528":11772,"_33530":10105,"_33532":5254,"_33534":23113,"_33536":19670,"_19216":18546,"_33539":3154,"_33541":3555,"_28189":6104,"_28629":23019,"_33545":21919,"_33547":4006,"_33549":7051,"_29088":3201,"_33552":4384,"_33554":6630,"_33556":15334,"_29192":24544,"_28688":3300,"_33560":15907,"_33562":4012,"_28226":2906,"_33565":5717,"_33567":7281,"_33569":6712,"_2