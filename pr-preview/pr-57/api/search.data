57313,"_39725":57316,"_39727":57319,"_39729":57322,"_39731":57325,"_39733":57328,"_39735":57331,"_39737":57334,"_39739":57337,"_39741":57340,"_39743":57343,"_39745":57346,"_39747":57349,"_39749":57352,"_39751":57355,"_39753":57358,"_39755":57361,"_39757":57364,"_39759":57367,"_39761":57370,"_39763":57373},{"_3396":15,"_29729":15,"_5":14500,"_2882":48427,"_30082":48428,"_20626":48432,"_27027":15},"Deploy from AWS Marketplace",[48429,48430,48431],"Docs","Deployment","Other models",[],{"_3396":16,"_29729":15,"_20626":48434,"_5":14148,"_27027":15,"_2882":48435},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3396":17,"_29729":15,"_5":30079,"_20626":48437,"_27027":48438,"_2882":48439},[],"/docs/pr-preview/pr-57/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3396":18,"_29729":15,"_5":30079,"_20626":48441,"_27027":48442,"_2882":48443},[],"/docs/pr-preview/pr-57/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3396":19,"_29729":15,"_5":30079,"_20626":48445,"_27027":48446,"_2882":48447},[],"/docs/pr-preview/pr-57/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3396":20,"_29729":15,"_5":30079,"_20626":48449,"_27027":48450,"_2882":48451},[],"/docs/pr-preview/pr-57/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3396":21,"_29729":15,"_5":30079,"_20626":48453,"_27027":48454,"_2882":48455},[],"/docs/pr-preview/pr-57/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3396":22,"_29729":15,"_5":30079,"_20626":48457,"_27027":48458,"_2882":48459},[],"/docs/pr-preview/pr-57/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3396":23,"_29729":15,"_5":30079,"_20626":48461,"_27027":48462,"_2882":48463},[],"/docs/pr-preview/pr-57/deployment/aws-marketplace#next-step","Next step",{"_3396":24,"_29729":15,"_20626":48465,"_5":14148,"_27027":15,"_2882":48466},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3396":25,"_29729":15,"_20626":48468,"_5":14148,"_27027":48438,"_2882":48469},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3396":26,"_29729":15,"_20626":48471,"_5":14148,"_27027":48438,"_2882":48472},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3396":27,"_29729":15,"_20626":48474,"_5":14148,"_27027":48438,"_2882":48475},[],"A security group allowing the necessary endpoints.",{"_3396":28,"_29729":15,"_20626":48477,"_5":14148,"_27027":48442,"_2882":48478},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3396":29,"_29729":15,"_20626":48480,"_5":14148,"_27027":48442,"_2882":48481},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3396":30,"_29729":15,"_20626":48483,"_5":14148,"_27027":48442,"_2882":48484},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3396":31,"_29729":15,"_20626":48486,"_5":14148,"_27027":48446,"_2882":48487},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3396":32,"_29729":15,"_20626":48489,"_5":14148,"_27027":48450,"_2882":48490},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3396":33,"_29729":15,"_20626":48492,"_5":14148,"_27027":48454,"_2882":48493},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3396":34,"_29729":15,"_20626":48495,"_5":14148,"_27027":48458,"_2882":48496},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3396":35,"_29729":15,"_20626":48498,"_5":14148,"_27027":48462,"_2882":48499},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3396":36,"_29729":36,"_5":14500,"_2882":48501,"_30082":48502,"_20626":48503,"_27027":36},"Deploy Lamassu",[48429,48430],[],{"_3396":37,"_29729":36,"_20626":48505,"_5":14148,"_27027":36,"_2882":48506},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3396":38,"_29729":36,"_5":30079,"_20626":48508,"_27027":48509,"_2882":48510},[],"/docs/pr-preview/pr-57/deployment/overview#choose-a-model","Choose a model",{"_3396":39,"_29729":36,"_5":30079,"_20626":48512,"_27027":48513,"_2882":48514},[],"/docs/pr-preview/pr-57/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3396":40,"_29729":36,"_5":30079,"_20626":48516,"_27027":48517,"_2882":48518},[],"/docs/pr-preview/pr-57/deployment/overview#after-deployment","After deployment",{"_3396":41,"_29729":36,"_20626":48520,"_5":14148,"_27027":36,"_2882":48521},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3396":42,"_29729":36,"_20626":48523,"_5":14148,"_27027":48509,"_2882":48524},[],"Model",{"_3396":43,"_29729":36,"_20626":48526,"_5":14148,"_27027":48509,"_2882":48527},[],"Recommended for",{"_3396":44,"_29729":36,"_20626":48529,"_5":14148,"_27027":48509,"_2882":48530},[],"Who operates the infrastructure",{"_3396":45,"_29729":36,"_20626":48532,"_5":14148,"_27027":48509,"_2882":48533},[],"Starting point",{"_3396":46,"_29729":36,"_20626":48535,"_5":14148,"_27027":48509,"_2882":48536},[],"Kubernetes self-managed",{"_3396":47,"_29729":36,"_20626":48538,"_5":14148,"_27027":48509,"_2882":48539},[],"Production, regulated environments and custom deployments",{"_3396":48,"_29729":36,"_20626":48541,"_5":14148,"_27027":48509,"_2882":48542},[],"Your team",{"_3396":49,"_29729":36,"_20626":48544,"_5":14148,"_27027":48509,"_2882":48545},[],"Helm or Fastlane",{"_3396":50,"_29729":36,"_20626":48547,"_5":14148,"_27027":48509,"_2882":48548},[],"AWS Marketplace",{"_3396":51,"_29729":36,"_20626":48550,"_5":14148,"_27027":48509,"_2882":48551},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3396":52,"_29729":36,"_20626":48553,"_5":14148,"_27027":48509,"_2882":48542},[],{"_3396":53,"_29729":36,"_20626":48555,"_5":14148,"_27027":48509,"_2882":48556},[],"Preconfigured image on EC2",{"_3396":54,"_29729":36,"_20626":48558,"_5":14148,"_27027":48509,"_2882":48559},[],"SaaS",{"_3396":55,"_29729":36,"_20626":48561,"_5":14148,"_27027":48509,"_2882":48562},[],"Teams that want to use the platform without operating it",{"_3396":56,"_29729":36,"_20626":48564,"_5":14148,"_27027":48509,"_2882":48565},[],"Lamassu",{"_3396":57,"_29729":36,"_20626":48567,"_5":14148,"_27027":48509,"_2882":48568},[],"Managed subscription",{"_3396":58,"_29729":36,"_20626":48570,"_5":14148,"_27027":48509,"_2882":48571},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3396":59,"_29729":36,"_20626":48573,"_5":14148,"_27027":48509,"_2882":48574},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3396":60,"_29729":36,"_20626":48576,"_5":14148,"_27027":48509,"_2882":48577},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3396":61,"_29729":36,"_20626":48579,"_5":14148,"_27027":48513,"_2882":48580},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3396":62,"_29729":36,"_20626":48582,"_5":14148,"_27027":48517,"_2882":48583},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3396":63,"_29729":63,"_5":14500,"_2882":48585,"_30082":48586,"_20626":48587,"_27027":63},"Use Lamassu as SaaS",[48429,48430,48431],[],{"_3396":64,"_29729":63,"_20626":48589,"_5":14148,"_27027":63,"_2882":48590},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3396":65,"_29729":63,"_5":30079,"_20626":48592,"_27027":48593,"_2882":48594},[],"/docs/pr-preview/pr-57/deployment/saas#what-the-service-manages","What the service manages",{"_3396":66,"_29729":63,"_5":30079,"_20626":48596,"_27027":48597,"_2882":48598},[],"/docs/pr-preview/pr-57/deployment/saas#plans","Plans",{"_3396":67,"_29729":63,"_5":30079,"_20626":48600,"_27027":48601,"_2882":48602},[],"/docs/pr-preview/pr-57/deployment/saas#request-access","Request access",{"_3396":68,"_29729":63,"_20626":48604,"_5":14148,"_27027":63,"_2882":48605},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3396":69,"_29729":63,"_20626":48607,"_5":14148,"_27027":48593,"_2882":48608},[],"Platform availability and maintenance.",{"_3396":70,"_29729":63,"_20626":48610,"_5":14148,"_27027":48593,"_2882":48611},[],"Automatic backups.",{"_3396":71,"_29729":63,"_20626":48613,"_5":14148,"_27027":48593,"_2882":48614},[],"Version upgrades.",{"_3396":72,"_29729":63,"_20626":48616,"_5":14148,"_27027":48593,"_2882":48617},[],"Technical support and SLA according to your plan.",{"_3396":73,"_29729":63,"_20626":48619,"_5":14148,"_27027":48597,"_2882":48620},[],"Plan",{"_3396":74,"_29729":63,"_20626":48622,"_5":14148,"_27027":48597,"_2882":48623},[],"Devices",{"_3396":75,"_29729":63,"_20626":48625,"_5":14148,"_27027":48597,"_2882":48626},[],"Support",{"_3396":76,"_29729":63,"_20626":48628,"_5":14148,"_27027":48597,"_2882":48629},[],"SLA",{"_3396":77,"_29729":63,"_20626":48631,"_5":14148,"_27027":48597,"_2882":48632},[],"Starter",{"_3396":78,"_29729":63,"_20626":48634,"_5":14148,"_27027":48597,"_2882":48635},[],"Up to 1,000",{"_3396":79,"_29729":63,"_20626":48637,"_5":14148,"_27027":48597,"_2882":48638},[],"Email",{"_3396":80,"_29729":63,"_20626":48640,"_5":14148,"_27027":48597,"_2882":48641},[],"99.5 %",{"_3396":81,"_29729":63,"_20626":48643,"_5":14148,"_27027":48597,"_2882":48644},[],"Professional",{"_3396":82,"_29729":63,"_20626":48646,"_5":14148,"_27027":48597,"_2882":48647},[],"Up to 10,000",{"_3396":83,"_29729":63,"_20626":48649,"_5":14148,"_27027":48597,"_2882":48650},[],"Email and chat",{"_3396":84,"_29729":63,"_20626":48652,"_5":14148,"_27027":48597,"_2882":48653},[],"99.9 %",{"_3396":85,"_29729":63,"_20626":48655,"_5":14148,"_27027":48597,"_2882":48656},[],"Enterprise",{"_3396":86,"_29729":63,"_20626":48658,"_5":14148,"_27027":48597,"_2882":48659},[],"Unlimited",{"_3396":87,"_29729":63,"_20626":48661,"_5":14148,"_27027":48597,"_2882":48662},[],"Dedicated",{"_3396":88,"_29729":63,"_20626":48664,"_5":14148,"_27027":48597,"_2882":48665},[],"99.99 %",{"_3396":89,"_29729":63,"_20626":48667,"_5":14148,"_27027":48601,"_2882":48668},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3396":90,"_29729":63,"_20626":48670,"_5":14148,"_27027":48601,"_2882":48671},[],"When you receive your instance's credentials, continue with Get started.",{"_3396":91,"_29729":91,"_5":14500,"_2882":48673,"_30082":48674,"_20626":48675,"_27027":91},"Fastlane",[48429,48430,48536],[],{"_3396":92,"_29729":91,"_20626":48677,"_5":14148,"_27027":91,"_2882":48678},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3396":93,"_29729":91,"_5":30079,"_20626":48680,"_27027":48681,"_2882":48682},[],"/docs/pr-preview/pr-57/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3396":94,"_29729":91,"_5":30079,"_20626":48684,"_27027":48685,"_2882":48686},[],"/docs/pr-preview/pr-57/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3396":95,"_29729":91,"_5":30079,"_20626":48688,"_27027":48689,"_2882":48439},[],"/docs/pr-preview/pr-57/deployment/self-hosted/fastlane#before-you-begin",{"_3396":96,"_29729":91,"_5":30079,"_20626":48691,"_27027":48692,"_2882":48693},[],"/docs/pr-preview/pr-57/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3396":97,"_29729":91,"_5":30079,"_20626":48695,"_27027":48696,"_2882":48697},[],"/docs/pr-preview/pr-57/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3396":98,"_29729":91,"_5":30079,"_20626":48699,"_27027":48700,"_2882":48701},[],"/docs/pr-preview/pr-57/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3396":99,"_29729":91,"_5":30079,"_20626":48703,"_27027":48704,"_2882":48705},[],"/docs/pr-preview/pr-57/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3396":100,"_29729":91,"_5":30079,"_20626":48707,"_27027":48708,"_2882":48709},[],"/docs/pr-preview/pr-57/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3396":101,"_29729":91,"_5":30079,"_20626":48711,"_27027":48712,"_2882":48713},[],"/docs/pr-preview/pr-57/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3396":102,"_29729":91,"_5":30079,"_20626":48715,"_27027":48716,"_2882":48717},[],"/docs/pr-preview/pr-57/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3396":103,"_29729":91,"_5":30079,"_20626":48719,"_27027":48720,"_2882":48721},[],"/docs/pr-preview/pr-57/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3396":104,"_29729":91,"_20626":48723,"_5":14148,"_27027":48681,"_2882":48724},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3396":105,"_29729":91,"_20626":48726,"_5":14148,"_27027":48681,"_2882":48727},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3396":106,"_29729":91,"_20626":48729,"_5":14148,"_27027":48685,"_2882":48730},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3396":107,"_29729":91,"_20626":48732,"_5":14148,"_27027":48685,"_2882":48733},[],"Fastlane installs or configures",{"_3396":108,"_29729":91,"_20626":48735,"_5":14148,"_27027":48685,"_2882":48736},[],"You still provide",{"_3396":109,"_29729":91,"_20626":48738,"_5":14148,"_27027":48685,"_2882":48739},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3396":110,"_29729":91,"_20626":48741,"_5":14148,"_27027":48685,"_2882":48742},[],"The Kubernetes cluster, nodes and persistent storage",{"_3396":111,"_29729":91,"_20626":48744,"_5":14148,"_27027":48685,"_2882":48745},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3396":112,"_29729":91,"_20626":48747,"_5":14148,"_27027":48685,"_2882":48748},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3396":113,"_29729":91,"_20626":48750,"_5":14148,"_27027":48685,"_2882":48751},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3396":114,"_29729":91,"_20626":48753,"_5":14148,"_27027":48685,"_2882":48754},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3396":115,"_29729":91,"_20626":48756,"_5":14148,"_27027":48685,"_2882":48757},[],"Optional observability and lab HSM components",{"_3396":116,"_29729":91,"_20626":48759,"_5":14148,"_27027":48685,"_2882":48760},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3396":117,"_29729":91,"_20626":48762,"_5":14148,"_27027":48685,"_2882":48763},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3396":118,"_29729":91,"_20626":48765,"_5":14148,"_27027":48689,"_2882":48766},[],"You need:",{"_3396":119,"_29729":91,"_20626":48768,"_5":14148,"_27027":48689,"_2882":48769},[],"an existing Kubernetes cluster",{"_3396":120,"_29729":91,"_20626":48771,"_5":14148,"_27027":48689,"_2882":48772},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3396":121,"_29729":91,"_20626":48774,"_5":14148,"_27027":48689,"_2882":48775},[],"`yq`",{"_3396":122,"_29729":91,"_20626":48777,"_5":14148,"_27027":48689,"_2882":23309},[],{"_3396":123,"_29729":91,"_20626":48779,"_5":14148,"_27027":48689,"_2882":48780},[],"`jq` only when using `--sample-data` or `--development`",{"_3396":124,"_29729":91,"_20626":48782,"_5":14148,"_27027":48689,"_2882":48783},[],"`ssh-keygen` only when using `--with-hsm`",{"_3396":125,"_29729":91,"_20626":48785,"_5":14148,"_27027":48689,"_2882":48786},[],"free external ports 80 and 443 on a single-node K3s host",{"_3396":126,"_29729":91,"_20626":48788,"_5":14148,"_27027":48689,"_2882":48789},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3396":127,"_29729":91,"_20626":48791,"_5":14148,"_27027":48689,"_2882":48792},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3396":128,"_29729":91,"_20626":48794,"_5":14148,"_27027":48692,"_2882":48795},[],"Run the script from a clone of the Helm repository:",{"_3396":129,"_29729":91,"_20626":48797,"_5":14148,"_27027":48692,"_2882":48798},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3396":130,"_29729":91,"_20626":48800,"_5":14148,"_27027":48696,"_2882":48801},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3396":131,"_29729":91,"_20626":48803,"_5":14148,"_27027":48696,"_2882":48804},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3396":132,"_29729":91,"_20626":48806,"_5":14148,"_27027":48696,"_2882":48807},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3396":133,"_29729":91,"_20626":48809,"_5":14148,"_27027":48696,"_2882":48810},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3396":134,"_29729":91,"_20626":48812,"_5":14148,"_27027":48700,"_2882":48813},[],"Option",{"_3396":135,"_29729":91,"_20626":48815,"_5":14148,"_27027":48700,"_2882":48816},[],"Default",{"_3396":136,"_29729":91,"_20626":48818,"_5":14148,"_27027":48700,"_2882":48819},[],"Purpose",{"_3396":137,"_29729":91,"_20626":48821,"_5":14148,"_27027":48700,"_2882":48822},[],"`-h`, `--help`",{"_3396":138,"_29729":91,"_20626":48824,"_5":14148,"_27027":48700,"_2882":48825},[],"—",{"_3396":139,"_29729":91,"_20626":48827,"_5":14148,"_27027":48700,"_2882":48828},[],"Show help",{"_3396":140,"_29729":91,"_20626":48830,"_5":14148,"_27027":48700,"_2882":48831},[],"`-c`, `--context`",{"_3396":141,"_29729":91,"_20626":48833,"_5":14148,"_27027":48700,"_2882":48834},[],"current context",{"_3396":142,"_29729":91,"_20626":48836,"_5":14148,"_27027":48700,"_2882":48837},[],"Select the kubeconfig context for kubectl and Helm",{"_3396":143,"_29729":91,"_20626":48839,"_5":14148,"_27027":48700,"_2882":48840},[],"`-n`, `--non-interactive`",{"_3396":144,"_29729":91,"_20626":48842,"_5":14148,"_27027":48700,"_2882":6433},[],{"_3396":145,"_29729":91,"_20626":48844,"_5":14148,"_27027":48700,"_2882":48845},[],"Skip prompts and generate dependency credentials",{"_3396":146,"_29729":91,"_20626":48847,"_5":14148,"_27027":48700,"_2882":48848},[],"`-ns`, `--namespace`",{"_3396":147,"_29729":91,"_20626":48850,"_5":14148,"_27027":48700,"_2882":48851},[],"`lamassu-dev`",{"_3396":148,"_29729":91,"_20626":48853,"_5":14148,"_27027":48700,"_2882":48854},[],"Namespace for the installation",{"_3396":149,"_29729":91,"_20626":48856,"_5":14148,"_27027":48700,"_2882":48857},[],"`-d`, `--domain`",{"_3396":150,"_29729":91,"_20626":48859,"_5":14148,"_27027":48700,"_2882":48860},[],"`dev.lamassu.io`",{"_3396":151,"_29729":91,"_20626":48862,"_5":14148,"_27027":48700,"_2882":48863},[],"Domain used by the UI, OIDC and certificate",{"_3396":152,"_29729":91,"_20626":48865,"_5":14148,"_27027":48700,"_2882":48866},[],"`-v`, `--version`",{"_3396":153,"_29729":91,"_20626":48868,"_5":14148,"_27027":48700,"_2882":14834},[],{"_3396":154,"_29729":91,"_20626":48870,"_5":14148,"_27027":48700,"_2882":48871},[],"Lamassu chart version",{"_3396":155,"_29729":91,"_20626":48873,"_5":14148,"_27027":48700,"_2882":48874},[],"`--https-port`",{"_3396":156,"_29729":91,"_20626":48876,"_5":14148,"_27027":48700,"_2882":48877},[],"`443`",{"_3396":157,"_29729":91,"_20626":48879,"_5":14148,"_27027":48700,"_2882":48880},[],"Gateway HTTPS listener port",{"_3396":158,"_29729":91,"_20626":48882,"_5":14148,"_27027":48700,"_2882":48883},[],"`--http-port`",{"_3396":159,"_29729":91,"_20626":48885,"_5":14148,"_27027":48700,"_2882":48886},[],"`80`",{"_3396":160,"_29729":91,"_20626":48888,"_5":14148,"_27027":48700,"_2882":48889},[],"Gateway HTTP listener port",{"_3396":161,"_29729":91,"_20626":48891,"_5":14148,"_27027":48700,"_2882":48892},[],"`--tls-crt`",{"_3396":162,"_29729":91,"_20626":48894,"_5":14148,"_27027":48700,"_2882":48825},[],{"_3396":163,"_29729":91,"_20626":48896,"_5":14148,"_27027":48700,"_2882":48897},[],"PEM certificate for downstream TLS",{"_3396":164,"_29729":91,"_20626":48899,"_5":14148,"_27027":48700,"_2882":48900},[],"`--tls-key`",{"_3396":165,"_29729":91,"_20626":48902,"_5":14148,"_27027":48700,"_2882":48825},[],{"_3396":166,"_29729":91,"_20626":48904,"_5":14148,"_27027":48700,"_2882":48905},[],"PEM private key for downstream TLS",{"_3396":167,"_29729":91,"_20626":48907,"_5":14148,"_27027":48700,"_2882":48908},[],"`-l`, `--local-chart-path`",{"_3396":168,"_29729":91,"_20626":48910,"_5":14148,"_27027":48700,"_2882":48911},[],"repository chart",{"_3396":169,"_29729":91,"_20626":48913,"_5":14148,"_27027":48700,"_2882":48914},[],"Use an unpacked local Lamassu chart",{"_3396":170,"_29729":91,"_20626":48916,"_5":14148,"_27027":48700,"_2882":48917},[],"`-ip`, `--gateway-ip`",{"_3396":171,"_29729":91,"_20626":48919,"_5":14148,"_27027":48700,"_2882":8604},[],{"_3396":172,"_29729":91,"_20626":48921,"_5":14148,"_27027":48700,"_2882":48922},[],"Override the address written to `gateway.addresses`",{"_3396":173,"_29729":91,"_20626":48924,"_5":14148,"_27027":48700,"_2882":48925},[],"`--otel`",{"_3396":174,"_29729":91,"_20626":48927,"_5":14148,"_27027":48700,"_2882":6433},[],{"_3396":175,"_29729":91,"_20626":48929,"_5":14148,"_27027":48700,"_2882":48930},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3396":176,"_29729":91,"_20626":48932,"_5":14148,"_27027":48700,"_2882":48933},[],"`--development`",{"_3396":177,"_29729":91,"_20626":48935,"_5":14148,"_27027":48700,"_2882":6433},[],{"_3396":178,"_29729":91,"_20626":48937,"_5":14148,"_27027":48700,"_2882":48938},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3396":179,"_29729":91,"_20626":48940,"_5":14148,"_27027":48700,"_2882":48941},[],"`--sample-data`",{"_3396":180,"_29729":91,"_20626":48943,"_5":14148,"_27027":48700,"_2882":6433},[],{"_3396":181,"_29729":91,"_20626":48945,"_5":14148,"_27027":48700,"_2882":48946},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3396":182,"_29729":91,"_20626":48948,"_5":14148,"_27027":48700,"_2882":48949},[],"`--with-hsm`",{"_3396":183,"_29729":91,"_20626":48951,"_5":14148,"_27027":48700,"_2882":6433},[],{"_3396":184,"_29729":91,"_20626":48953,"_5":14148,"_27027":48700,"_2882":48954},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3396":185,"_29729":91,"_20626":48956,"_5":14148,"_27027":48700,"_2882":48957},[],"`--softhsm-chart-path`",{"_3396":186,"_29729":91,"_20626":48959,"_5":14148,"_27027":48700,"_2882":48960},[],"`./charts/softhsm`",{"_3396":187,"_29729":91,"_20626":48962,"_5":14148,"_27027":48700,"_2882":48963},[],"Use a different local SoftHSM chart",{"_3396":188,"_29729":91,"_20626":48965,"_5":14148,"_27027":48700,"_2882":48966},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3396":189,"_29729":91,"_20626":48968,"_5":14148,"_27027":48704,"_2882":48969},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3396":190,"_29729":91,"_20626":48971,"_5":14148,"_27027":48704,"_2882":48972},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3396":191,"_29729":91,"_20626":48974,"_5":14148,"_27027":48704,"_2882":48975},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3396":192,"_29729":91,"_20626":48977,"_5":14148,"_27027":48704,"_2882":48978},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3396":193,"_29729":91,"_20626":48980,"_5":14148,"_27027":48704,"_2882":48981},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3396":194,"_29729":91,"_20626":48983,"_5":14148,"_27027":48704,"_2882":48984},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3396":195,"_29729":91,"_20626":48986,"_5":14148,"_27027":48708,"_2882":48987},[],"Fastlane:",{"_3396":196,"_29729":91,"_20626":48989,"_5":14148,"_27027":48708,"_2882":48990},[],"validates local tools and the selected cluster",{"_3396":197,"_29729":91,"_20626":48992,"_5":14148,"_27027":48708,"_2882":48993},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3396":198,"_29729":91,"_20626":48995,"_5":14148,"_27027":48708,"_2882":48996},[],"creates the namespace",{"_3396":199,"_29729":91,"_20626":48998,"_5":14148,"_27027":48708,"_2882":48999},[],"installs PostgreSQL and creates the required databases",{"_3396":200,"_29729":91,"_20626":49001,"_5":14148,"_27027":48708,"_2882":49002},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3396":201,"_29729":91,"_20626":49004,"_5":14148,"_27027":48708,"_2882":49005},[],"installs RabbitMQ",{"_3396":202,"_29729":91,"_20626":49007,"_5":14148,"_27027":48708,"_2882":49008},[],"optionally installs observability and lab HSM components",{"_3396":203,"_29729":91,"_20626":49010,"_5":14148,"_27027":48708,"_2882":49011},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3396":204,"_29729":91,"_20626":49013,"_5":14148,"_27027":48708,"_2882":49014},[],"optionally loads sample data",{"_3396":205,"_29729":91,"_20626":49016,"_5":14148,"_27027":48708,"_2882":49017},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3396":206,"_29729":91,"_20626":49019,"_5":14148,"_27027":48712,"_2882":49020},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3396":207,"_29729":91,"_20626":49022,"_5":14148,"_27027":48712,"_2882":49023},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3396":208,"_29729":91,"_20626":49025,"_5":14148,"_27027":48716,"_2882":49026},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3396":209,"_29729":91,"_20626":49028,"_5":14148,"_27027":48716,"_2882":49029},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3396":210,"_29729":91,"_20626":49031,"_5":14148,"_27027":48716,"_2882":49032},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3396":211,"_29729":91,"_20626":49034,"_5":14148,"_27027":48720,"_2882":49035},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3396":212,"_29729":212,"_5":14500,"_2882":49037,"_30082":49038,"_20626":49039,"_27027":212},"Install with Helm",[48429,48430,48536],[],{"_3396":213,"_29729":212,"_20626":49041,"_5":14148,"_27027":212,"_2882":49042},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3396":214,"_29729":212,"_5":30079,"_20626":49044,"_27027":49045,"_2882":49046},[],"/docs/pr-preview/pr-57/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3396":215,"_29729":212,"_5":30079,"_20626":49048,"_27027":49049,"_2882":48439},[],"/docs/pr-preview/pr-57/deployment/self-hosted/helm#before-you-begin",{"_3396":216,"_29729":212,"_5":30079,"_20626":49051,"_27027":49052,"_2882":49053},[],"/docs/pr-preview/pr-57/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3396":217,"_29729":212,"_5":30079,"_20626":49055,"_27027":49056,"_2882":49057},[],"/docs/pr-preview/pr-57/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3396":218,"_29729":212,"_5":30079,"_20626":49059,"_27027":49060,"_2882":49061},[],"/docs/pr-preview/pr-57/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3396":219,"_29729":212,"_5":30079,"_20626":49063,"_27027":49064,"_2882":49065},[],"/docs/pr-preview/pr-57/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3396":220,"_29729":212,"_5":30079,"_20626":49067,"_27027":49068,"_2882":49069},[],"/docs/pr-preview/pr-57/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3396":221,"_29729":212,"_5":30079,"_20626":49071,"_27027":49072,"_2882":49073},[],"/docs/pr-preview/pr-57/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3396":222,"_29729":212,"_5":30079,"_20626":49075,"_27027":49076,"_2882":49077},[],"/docs/pr-preview/pr-57/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3396":223,"_29729":212,"_5":30079,"_20626":49079,"_27027":49080,"_2882":49081},[],"/docs/pr-preview/pr-57/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3396":224,"_29729":212,"_5":30079,"_20626":49083,"_27027":49084,"_2882":49085},[],"/docs/pr-preview/pr-57/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3396":225,"_29729":212,"_20626":49087,"_5":14148,"_27027":49045,"_2882":49088},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3396":226,"_29729":212,"_20626":49090,"_5":14148,"_27027":49049,"_2882":49091},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3396":227,"_29729":212,"_20626":49093,"_5":14148,"_27027":49049,"_2882":49094},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3396":228,"_29729":212,"_20626":49096,"_5":14148,"_27027":49049,"_2882":49097},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3396":229,"_29729":212,"_20626":49099,"_5":14148,"_27027":49049,"_2882":49100},[],"a reachable RabbitMQ broker and credentials",{"_3396":230,"_29729":212,"_20626":49102,"_5":14148,"_27027":49049,"_2882":49103},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3396":231,"_29729":212,"_20626":49105,"_5":14148,"_27027":49049,"_2882":49106},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3396":232,"_29729":212,"_20626":49108,"_5":14148,"_27027":49049,"_2882":49109},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3396":233,"_29729":212,"_20626":49111,"_5":14148,"_27027":49049,"_2882":49112},[],"a StorageClass and an external traffic design",{"_3396":234,"_29729":212,"_20626":49114,"_5":14148,"_27027":49049,"_2882":49115},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3396":235,"_29729":212,"_20626":49117,"_5":14148,"_27027":49049,"_2882":49118},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3396":236,"_29729":212,"_20626":49120,"_5":14148,"_27027":49049,"_2882":49121},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3396":237,"_29729":212,"_20626":49123,"_5":14148,"_27027":49052,"_2882":49124},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3396":238,"_29729":212,"_20626":49126,"_5":14148,"_27027":49052,"_2882":49127},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3396":239,"_29729":212,"_20626":49129,"_5":14148,"_27027":49052,"_2882":49130},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3396":240,"_29729":212,"_20626":49132,"_5":14148,"_27027":49056,"_2882":49133},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3396":241,"_29729":212,"_20626":49135,"_5":14148,"_27027":49056,"_2882":49136},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3396":242,"_29729":212,"_20626":49138,"_5":14148,"_27027":49056,"_2882":49139},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3396":243,"_29729":212,"_20626":49141,"_5":14148,"_27027":49056,"_2882":49142},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3396":244,"_29729":212,"_20626":49144,"_5":14148,"_27027":49060,"_2882":49145},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3396":245,"_29729":212,"_20626":49147,"_5":14148,"_27027":49064,"_2882":49148},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3396":246,"_29729":212,"_20626":49150,"_5":14148,"_27027":49064,"_2882":49151},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3396":247,"_29729":212,"_20626":49153,"_5":14148,"_27027":49064,"_2882":49154},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3396":248,"_29729":212,"_20626":49156,"_5":14148,"_27027":49064,"_2882":49157},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3396":249,"_29729":212,"_20626":49159,"_5":14148,"_27027":49064,"_2882":49160},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3396":250,"_29729":212,"_20626":49162,"_5":14148,"_27027":49064,"_2882":49163},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3396":251,"_29729":212,"_20626":49165,"_5":14148,"_27027":49064,"_2882":49166},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3396":252,"_29729":212,"_20626":49168,"_5":14148,"_27027":49068,"_2882":49169},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3396":253,"_29729":212,"_20626":49171,"_5":14148,"_27027":49068,"_2882":49172},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3396":254,"_29729":212,"_20626":49174,"_5":14148,"_27027":49068,"_2882":49175},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3396":255,"_29729":212,"_20626":49177,"_5":14148,"_27027":49068,"_2882":49178},[],"See Access control for the principal and policy model.",{"_3396":256,"_29729":212,"_20626":49180,"_5":14148,"_27027":49072,"_2882":49181},[],"To install a local checkout instead:",{"_3396":257,"_29729":212,"_20626":49183,"_5":14148,"_27027":49076,"_2882":49184},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3396":258,"_29729":212,"_20626":49186,"_5":14148,"_27027":49076,"_2882":49187},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3396":259,"_29729":212,"_20626":49189,"_5":14148,"_27027":49080,"_2882":49190},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3396":260,"_29729":212,"_20626":49192,"_5":14148,"_27027":49080,"_2882":49193},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3396":261,"_29729":212,"_20626":49195,"_5":14148,"_27027":49080,"_2882":49196},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3396":262,"_29729":212,"_20626":49198,"_5":14148,"_27027":49080,"_2882":49199},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3396":263,"_29729":212,"_20626":49201,"_5":14148,"_27027":49080,"_2882":49202},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3396":264,"_29729":212,"_20626":49204,"_5":14148,"_27027":49084,"_2882":49205},[],"Before going live, review:",{"_3396":265,"_29729":212,"_20626":49207,"_5":14148,"_27027":49084,"_2882":49208},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3396":266,"_29729":212,"_20626":49210,"_5":14148,"_27027":49084,"_2882":49211},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3396":267,"_29729":212,"_20626":49213,"_5":14148,"_27027":49084,"_2882":49214},[],"shared VA storage before increasing VA replicas",{"_3396":268,"_29729":212,"_20626":49216,"_5":14148,"_27027":49084,"_2882":49217},[],"managed OIDC roles and removal of evaluation credentials",{"_3396":269,"_29729":212,"_20626":49219,"_5":14148,"_27027":49084,"_2882":49220},[],"a trusted TLS issuer or externally managed certificate",{"_3396":270,"_29729":212,"_20626":49222,"_5":14148,"_27027":49084,"_2882":49223},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3396":271,"_29729":212,"_20626":49225,"_5":14148,"_27027":49084,"_2882":49226},[],"SMTP, observability and alert delivery",{"_3396":272,"_29729":212,"_20626":49228,"_5":14148,"_27027":49084,"_2882":49229},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3396":273,"_29729":212,"_20626":49231,"_5":14148,"_27027":49084,"_2882":49232},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3396":274,"_29729":274,"_5":14500,"_2882":49234,"_30082":49235,"_20626":49236,"_27027":274},"Expose the Gateway",[48429,48430,48536],[],{"_3396":275,"_29729":274,"_20626":49238,"_5":14148,"_27027":274,"_2882":49239},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3396":276,"_29729":274,"_5":30079,"_20626":49241,"_27027":49242,"_2882":49243},[],"/docs/pr-preview/pr-57/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3396":277,"_29729":274,"_5":30079,"_20626":49245,"_27027":49246,"_2882":49247},[],"/docs/pr-preview/pr-57/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3396":278,"_29729":274,"_5":30079,"_20626":49249,"_27027":49250,"_2882":49251},[],"/docs/pr-preview/pr-57/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3396":279,"_29729":274,"_5":30079,"_20626":49253,"_27027":49254,"_2882":49255},[],"/docs/pr-preview/pr-57/deployment/self-hosted/networking#k3s","K3s",{"_3396":280,"_29729":274,"_5":30079,"_20626":49257,"_27027":49258,"_2882":49259},[],"/docs/pr-preview/pr-57/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3396":281,"_29729":274,"_5":30079,"_20626":49261,"_27027":49262,"_2882":49263},[],"/docs/pr-preview/pr-57/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3396":282,"_29729":274,"_5":30079,"_20626":49265,"_27027":49266,"_2882":49267},[],"/docs/pr-preview/pr-57/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3396":283,"_29729":274,"_5":30079,"_20626":49269,"_27027":49270,"_2882":49271},[],"/docs/pr-preview/pr-57/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3396":284,"_29729":274,"_5":30079,"_20626":49273,"_27027":49274,"_2882":49275},[],"/docs/pr-preview/pr-57/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3396":285,"_29729":274,"_5":30079,"_20626":49277,"_27027":49278,"_2882":49279},[],"/docs/pr-preview/pr-57/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3396":286,"_29729":274,"_20626":49281,"_5":14148,"_27027":49242,"_2882":49282},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3396":287,"_29729":274,"_20626":49284,"_5":14148,"_27027":49242,"_2882":49285},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3396":288,"_29729":274,"_20626":49287,"_5":14148,"_27027":49246,"_2882":49288},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3396":289,"_29729":274,"_20626":49290,"_5":14148,"_27027":49246,"_2882":49291},[],"Set it only when:",{"_3396":290,"_29729":274,"_20626":49293,"_5":14148,"_27027":49246,"_2882":49294},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3396":291,"_29729":274,"_20626":49296,"_5":14148,"_27027":49246,"_2882":49297},[],"that address is allocated to this Gateway",{"_3396":292,"_29729":274,"_20626":49299,"_5":14148,"_27027":49246,"_2882":49300},[],"the surrounding network already routes traffic for it to the cluster",{"_3396":293,"_29729":274,"_20626":49302,"_5":14148,"_27027":49246,"_2882":49303},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3396":294,"_29729":274,"_20626":49305,"_5":14148,"_27027":49246,"_2882":49306},[],"Keep these two settings separate:",{"_3396":295,"_29729":274,"_20626":49308,"_5":14148,"_27027":49246,"_2882":49309},[],"`gateway.addresses` requests an address for the Gateway.",{"_3396":296,"_29729":274,"_20626":49311,"_5":14148,"_27027":49246,"_2882":49312},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3396":297,"_29729":274,"_20626":49314,"_5":14148,"_27027":49246,"_2882":49315},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3396":298,"_29729":274,"_20626":49317,"_5":14148,"_27027":49250,"_2882":49318},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3396":299,"_29729":274,"_20626":49320,"_5":14148,"_27027":49250,"_2882":49321},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3396":300,"_29729":274,"_20626":49323,"_5":14148,"_27027":49254,"_2882":49324},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3396":301,"_29729":274,"_20626":49326,"_5":14148,"_27027":49254,"_2882":49327},[],"For the recommended design:",{"_3396":302,"_29729":274,"_20626":49329,"_5":14148,"_27027":49254,"_2882":49330},[],"Use only one externally exposed Lamassu Gateway.",{"_3396":303,"_29729":274,"_20626":49332,"_5":14148,"_27027":49254,"_2882":49333},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3396":304,"_29729":274,"_20626":49335,"_5":14148,"_27027":49254,"_2882":49336},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3396":305,"_29729":274,"_20626":49338,"_5":14148,"_27027":49254,"_2882":49339},[],"Point DNS at the VM's reachable address.",{"_3396":306,"_29729":274,"_20626":49341,"_5":14148,"_27027":49254,"_2882":49342},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3396":307,"_29729":274,"_20626":49344,"_5":14148,"_27027":49258,"_2882":49345},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3396":308,"_29729":274,"_20626":49347,"_5":14148,"_27027":49262,"_2882":49348},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3396":309,"_29729":274,"_20626":49350,"_5":14148,"_27027":49262,"_2882":49351},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3396":310,"_29729":274,"_20626":49353,"_5":14148,"_27027":49266,"_2882":49354},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3396":311,"_29729":274,"_20626":49356,"_5":14148,"_27027":49266,"_2882":49357},[],"Requirement",{"_3396":312,"_29729":274,"_20626":49359,"_5":14148,"_27027":49266,"_2882":49360},[],"Recommended design",{"_3396":313,"_29729":274,"_20626":49362,"_5":14148,"_27027":49266,"_2882":49363},[],"Consequence",{"_3396":314,"_29729":274,"_20626":49365,"_5":14148,"_27027":49266,"_2882":49366},[],"Several Lamassu URLs or services",{"_3396":315,"_29729":274,"_20626":49368,"_5":14148,"_27027":49266,"_2882":49369},[],"One Gateway with multiple routes",{"_3396":316,"_29729":274,"_20626":49371,"_5":14148,"_27027":49266,"_2882":49372},[],"One IP and one proxy fleet; this is the chart default",{"_3396":317,"_29729":274,"_20626":49374,"_5":14148,"_27027":49266,"_2882":49375},[],"Independent Gateways and separate external IPs",{"_3396":318,"_29729":274,"_20626":49377,"_5":14148,"_27027":49266,"_2882":49378},[],"One VIP per Gateway",{"_3396":319,"_29729":274,"_20626":49380,"_5":14148,"_27027":49266,"_2882":49381},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3396":320,"_29729":274,"_20626":49383,"_5":14148,"_27027":49266,"_2882":49384},[],"Independent Gateways on one node and one IP",{"_3396":321,"_29729":274,"_20626":49386,"_5":14148,"_27027":49266,"_2882":49387},[],"Use different external ports",{"_3396":322,"_29729":274,"_20626":49389,"_5":14148,"_27027":49266,"_2882":49390},[],"Clients must include non-standard ports",{"_3396":323,"_29729":274,"_20626":49392,"_5":14148,"_27027":49266,"_2882":49393},[],"Separate TLS/mTLS termination behind one IP",{"_3396":324,"_29729":274,"_20626":49395,"_5":14148,"_27027":49266,"_2882":49396},[],"Front-door SNI routing to internal Gateways",{"_3396":325,"_29729":274,"_20626":49398,"_5":14148,"_27027":49266,"_2882":49399},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3396":326,"_29729":274,"_20626":49401,"_5":14148,"_27027":49266,"_2882":49402},[],"Separate Gateway resources but shared proxy infrastructure",{"_3396":327,"_29729":274,"_20626":49404,"_5":14148,"_27027":49266,"_2882":49405},[],"Envoy merged-Gateway mode",{"_3396":328,"_29729":274,"_20626":49407,"_5":14148,"_27027":49266,"_2882":49408},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3396":329,"_29729":274,"_20626":49410,"_5":14148,"_27027":49266,"_2882":49411},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3396":330,"_29729":274,"_20626":49413,"_5":14148,"_27027":49266,"_2882":49414},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3396":331,"_29729":274,"_20626":49416,"_5":14148,"_27027":49266,"_2882":49417},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3396":332,"_29729":274,"_20626":49419,"_5":14148,"_27027":49266,"_2882":49420},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3396":333,"_29729":274,"_20626":49422,"_5":14148,"_27027":49270,"_2882":49423},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3396":334,"_29729":274,"_20626":49425,"_5":14148,"_27027":49270,"_2882":49426},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3396":335,"_29729":274,"_20626":49428,"_5":14148,"_27027":49270,"_2882":49429},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3396":336,"_29729":274,"_20626":49431,"_5":14148,"_27027":49270,"_2882":49432},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3396":337,"_29729":274,"_20626":49434,"_5":14148,"_27027":49270,"_2882":49435},[],"If none of those are possible, use different external ports or change the external network design.",{"_3396":338,"_29729":274,"_20626":49437,"_5":14148,"_27027":49274,"_2882":49438},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3396":339,"_29729":274,"_20626":49440,"_5":14148,"_27027":49274,"_2882":49441},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3396":340,"_29729":274,"_20626":49443,"_5":14148,"_27027":49278,"_2882":49444},[],"Check, in order:",{"_3396":341,"_29729":274,"_20626":49446,"_5":14148,"_27027":49278,"_2882":49447},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3396":342,"_29729":274,"_20626":49449,"_5":14148,"_27027":49278,"_2882":49450},[],"Its status contains the expected address.",{"_3396":343,"_29729":274,"_20626":49452,"_5":14148,"_27027":49278,"_2882":49453},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3396":344,"_29729":274,"_20626":49455,"_5":14148,"_27027":49278,"_2882":49456},[],"Port 443 reaches that address from the client network.",{"_3396":345,"_29729":274,"_20626":49458,"_5":14148,"_27027":49278,"_2882":49459},[],"DNS resolves to the externally reachable endpoint.",{"_3396":346,"_29729":274,"_20626":49461,"_5":14148,"_27027":49278,"_2882":49462},[],"The certificate contains the DNS name or IP used by the client.",{"_3396":347,"_29729":274,"_20626":49464,"_5":14148,"_27027":49278,"_2882":49465},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3396":348,"_29729":348,"_5":14500,"_2882":48536,"_30082":49467,"_20626":49468,"_27027":348},[48429,48430,48536],[],{"_3396":349,"_29729":348,"_20626":49470,"_5":14148,"_27027":348,"_2882":49471},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3396":350,"_29729":348,"_5":30079,"_20626":49473,"_27027":49474,"_2882":49475},[],"/docs/pr-preview/pr-57/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3396":351,"_29729":348,"_5":30079,"_20626":49477,"_27027":49478,"_2882":49479},[],"/docs/pr-preview/pr-57/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3396":352,"_29729":348,"_5":30079,"_20626":49481,"_27027":49482,"_2882":49483},[],"/docs/pr-preview/pr-57/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3396":353,"_29729":348,"_5":30079,"_20626":49485,"_27027":49486,"_2882":49487},[],"/docs/pr-preview/pr-57/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3396":354,"_29729":348,"_5":30079,"_20626":49489,"_27027":49490,"_2882":49491},[],"/docs/pr-preview/pr-57/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3396":355,"_29729":348,"_5":30079,"_20626":49493,"_27027":49494,"_2882":49495},[],"/docs/pr-preview/pr-57/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3396":356,"_29729":348,"_20626":49497,"_5":14148,"_27027":49474,"_2882":49498},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3396":357,"_29729":348,"_20626":49500,"_5":14148,"_27027":49478,"_2882":49501},[],"Workflow",{"_3396":358,"_29729":348,"_20626":49503,"_5":14148,"_27027":49478,"_2882":49504},[],"Use it for",{"_3396":359,"_29729":348,"_20626":49506,"_5":14148,"_27027":49478,"_2882":49507},[],"What it installs",{"_3396":360,"_29729":348,"_20626":49509,"_5":14148,"_27027":49478,"_2882":49510},[],"Helm",{"_3396":361,"_29729":348,"_20626":49512,"_5":14148,"_27027":49478,"_2882":49513},[],"Production and controlled environments",{"_3396":362,"_29729":348,"_20626":49515,"_5":14148,"_27027":49478,"_2882":49516},[],"Lamassu services and Gateway API resources",{"_3396":363,"_29729":348,"_20626":49518,"_5":14148,"_27027":49478,"_2882":48673},[],{"_3396":364,"_29729":348,"_20626":49520,"_5":14148,"_27027":49478,"_2882":49521},[],"Evaluation, demos, CI and small lab clusters",{"_3396":365,"_29729":348,"_20626":49523,"_5":14148,"_27027":49478,"_2882":49524},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3396":366,"_29729":348,"_20626":49526,"_5":14148,"_27027":49482,"_2882":49527},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3396":367,"_29729":348,"_20626":49529,"_5":14148,"_27027":49482,"_2882":49530},[],"Area",{"_3396":368,"_29729":348,"_20626":49532,"_5":14148,"_27027":49482,"_2882":49533},[],"The Lamassu chart provides",{"_3396":369,"_29729":348,"_20626":49535,"_5":14148,"_27027":49482,"_2882":49536},[],"You provide",{"_3396":370,"_29729":348,"_20626":49538,"_5":14148,"_27027":49482,"_2882":49539},[],"Lamassu applications",{"_3396":371,"_29729":348,"_20626":49541,"_5":14148,"_27027":49482,"_2882":49542},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3396":372,"_29729":348,"_20626":49544,"_5":14148,"_27027":49482,"_2882":49545},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3396":373,"_29729":348,"_20626":49547,"_5":14148,"_27027":49482,"_2882":49548},[],"PostgreSQL data",{"_3396":374,"_29729":348,"_20626":49550,"_5":14148,"_27027":49482,"_2882":49551},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3396":375,"_29729":348,"_20626":49553,"_5":14148,"_27027":49482,"_2882":49554},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3396":376,"_29729":348,"_20626":49556,"_5":14148,"_27027":49482,"_2882":49557},[],"Messaging",{"_3396":377,"_29729":348,"_20626":49559,"_5":14148,"_27027":49482,"_2882":49560},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3396":378,"_29729":348,"_20626":49562,"_5":14148,"_27027":49482,"_2882":49563},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3396":379,"_29729":348,"_20626":49565,"_5":14148,"_27027":49482,"_2882":49566},[],"Identity",{"_3396":380,"_29729":348,"_20626":49568,"_5":14148,"_27027":49482,"_2882":49569},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3396":381,"_29729":348,"_20626":49571,"_5":14148,"_27027":49482,"_2882":49572},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3396":382,"_29729":348,"_20626":49574,"_5":14148,"_27027":49482,"_2882":49575},[],"External routing",{"_3396":383,"_29729":348,"_20626":49577,"_5":14148,"_27027":49482,"_2882":49578},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3396":384,"_29729":348,"_20626":49580,"_5":14148,"_27027":49482,"_2882":49581},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3396":385,"_29729":348,"_20626":49583,"_5":14148,"_27027":49482,"_2882":49584},[],"TLS",{"_3396":386,"_29729":348,"_20626":49586,"_5":14148,"_27027":49482,"_2882":49587},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3396":387,"_29729":348,"_20626":49589,"_5":14148,"_27027":49482,"_2882":49590},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3396":388,"_29729":348,"_20626":49592,"_5":14148,"_27027":49482,"_2882":49593},[],"Persistent application data",{"_3396":389,"_29729":348,"_20626":49595,"_5":14148,"_27027":49482,"_2882":49596},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3396":390,"_29729":348,"_20626":49598,"_5":14148,"_27027":49482,"_2882":49599},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3396":391,"_29729":348,"_20626":49601,"_5":14148,"_27027":49482,"_2882":49602},[],"Optional integrations",{"_3396":392,"_29729":348,"_20626":49604,"_5":14148,"_27027":49482,"_2882":49605},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3396":393,"_29729":348,"_20626":49607,"_5":14148,"_27027":49482,"_2882":49608},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3396":394,"_29729":348,"_20626":49610,"_5":14148,"_27027":49482,"_2882":49611},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3396":395,"_29729":348,"_20626":49613,"_5":14148,"_27027":49482,"_2882":49614},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3396":396,"_29729":348,"_20626":49616,"_5":14148,"_27027":49486,"_2882":49617},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3396":397,"_29729":348,"_20626":49619,"_5":14148,"_27027":49486,"_2882":49620},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3396":398,"_29729":348,"_20626":49622,"_5":14148,"_27027":49490,"_2882":49623},[],"Kubernetes 1.24 or newer",{"_3396":399,"_29729":348,"_20626":49625,"_5":14148,"_27027":49490,"_2882":49626},[],"Helm 3.2 or newer",{"_3396":400,"_29729":348,"_20626":49628,"_5":14148,"_27027":49490,"_2882":49629},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3396":401,"_29729":348,"_20626":49631,"_5":14148,"_27027":49490,"_2882":49632},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3396":402,"_29729":348,"_20626":49634,"_5":14148,"_27027":49490,"_2882":49635},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3396":403,"_29729":348,"_20626":49637,"_5":14148,"_27027":49490,"_2882":49638},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3396":404,"_29729":348,"_20626":49640,"_5":14148,"_27027":49490,"_2882":49641},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3396":405,"_29729":348,"_20626":49643,"_5":14148,"_27027":49494,"_2882":49644},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3396":406,"_29729":348,"_20626":49646,"_5":14148,"_27027":49494,"_2882":49647},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3396":407,"_29729":348,"_20626":49649,"_5":14148,"_27027":49494,"_2882":49650},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3396":408,"_29729":348,"_20626":49652,"_5":14148,"_27027":49494,"_2882":49653},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3396":409,"_29729":409,"_5":14500,"_2882":49655,"_30082":49656,"_20626":49658,"_27027":409},"Deployment troubleshooting",[48429,48430,49657],"Operations",[],{"_3396":410,"_29729":409,"_20626":49660,"_5":14148,"_27027":409,"_2882":49661},[],"Diagnose access, service health and infrastructure dependencies.",{"_3396":411,"_29729":409,"_5":30079,"_20626":49663,"_27027":49664,"_2882":49665},[],"/docs/pr-preview/pr-57/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3396":412,"_29729":409,"_5":30079,"_20626":49667,"_27027":49668,"_2882":49669},[],"/docs/pr-preview/pr-57/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3396":413,"_29729":409,"_5":30079,"_20626":49671,"_27027":49672,"_2882":49673},[],"/docs/pr-preview/pr-57/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3396":414,"_29729":409,"_5":30079,"_20626":49675,"_27027":49676,"_2882":49677},[],"/docs/pr-preview/pr-57/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3396":415,"_29729":409,"_5":30079,"_20626":49679,"_27027":49680,"_2882":49681},[],"/docs/pr-preview/pr-57/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3396":416,"_29729":409,"_5":30079,"_20626":49683,"_27027":49684,"_2882":49685},[],"/docs/pr-preview/pr-57/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3396":417,"_29729":409,"_5":30079,"_20626":49687,"_27027":49688,"_2882":49689},[],"/docs/pr-preview/pr-57/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3396":418,"_29729":409,"_5":30079,"_20626":49691,"_27027":49692,"_2882":49693},[],"/docs/pr-preview/pr-57/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3396":419,"_29729":409,"_5":30079,"_20626":49695,"_27027":49696,"_2882":49697},[],"/docs/pr-preview/pr-57/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3396":420,"_29729":409,"_5":30079,"_20626":49699,"_27027":49700,"_2882":49701},[],"/docs/pr-preview/pr-57/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3396":421,"_29729":409,"_5":30079,"_20626":49703,"_27027":49704,"_2882":49705},[],"/docs/pr-preview/pr-57/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3396":422,"_29729":409,"_5":30079,"_20626":49707,"_27027":49708,"_2882":49709},[],"/docs/pr-preview/pr-57/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3396":423,"_29729":409,"_5":30079,"_20626":49711,"_27027":49712,"_2882":49713},[],"/docs/pr-preview/pr-57/deployment/troubleshooting#observability","Observability",{"_3396":424,"_29729":409,"_20626":49715,"_5":14148,"_27027":409,"_2882":49716},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3396":425,"_29729":409,"_20626":49718,"_5":14148,"_27027":49668,"_2882":49719},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3396":426,"_29729":409,"_20626":49721,"_5":14148,"_27027":49672,"_2882":49722},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3396":427,"_29729":409,"_20626":49724,"_5":14148,"_27027":49676,"_2882":49725},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3396":428,"_29729":409,"_20626":49727,"_5":14148,"_27027":49680,"_2882":49728},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3396":429,"_29729":409,"_20626":49730,"_5":14148,"_27027":49684,"_2882":49731},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3396":430,"_29729":409,"_20626":49733,"_5":14148,"_27027":49688,"_2882":49734},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3396":431,"_29729":409,"_20626":49736,"_5":14148,"_27027":49688,"_2882":49737},[],"Also run the chart's connectivity test:",{"_3396":432,"_29729":409,"_20626":49739,"_5":14148,"_27027":49688,"_2882":49740},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3396":433,"_29729":409,"_20626":49742,"_5":14148,"_27027":49688,"_2882":49743},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3396":434,"_29729":409,"_20626":49745,"_5":14148,"_27027":49692,"_2882":49746},[],"If you receive a 401:",{"_3396":435,"_29729":409,"_20626":49748,"_5":14148,"_27027":49692,"_2882":49749},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3396":436,"_29729":409,"_20626":49751,"_5":14148,"_27027":49692,"_2882":49752},[],"verify issuer, audience and expiration of the token;",{"_3396":437,"_29729":409,"_20626":49754,"_5":14148,"_27027":49692,"_2882":49755},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3396":438,"_29729":409,"_20626":49757,"_5":14148,"_27027":49692,"_2882":49758},[],"check that the provider's public and internal routes point to the same realm.",{"_3396":439,"_29729":409,"_20626":49760,"_5":14148,"_27027":49692,"_2882":49761},[],"If login succeeds but the APIs return 403:",{"_3396":440,"_29729":409,"_20626":49763,"_5":14148,"_27027":49692,"_2882":49764},[],"inspect the token's real claims;",{"_3396":441,"_29729":409,"_20626":49766,"_5":14148,"_27027":49692,"_2882":49767},[],"confirm they match an active principal;",{"_3396":442,"_29729":409,"_20626":49769,"_5":14148,"_27027":49692,"_2882":49770},[],"review the policies granted to that principal;",{"_3396":443,"_29729":409,"_20626":49772,"_5":14148,"_27027":49692,"_2882":49773},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3396":444,"_29729":409,"_20626":49775,"_5":14148,"_27027":49692,"_2882":49776},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3396":445,"_29729":409,"_20626":49778,"_5":14148,"_27027":49696,"_2882":49779},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3396":446,"_29729":409,"_20626":49781,"_5":14148,"_27027":49696,"_2882":49782},[],"Locate the authz pod and Service.",{"_3396":447,"_29729":409,"_20626":49784,"_5":14148,"_27027":49696,"_2882":49785},[],"Check /health, logs and its database connection.",{"_3396":448,"_29729":409,"_20626":49787,"_5":14148,"_27027":49696,"_2882":49788},[],"Verify the DNS and port configured in externalAuthorization.",{"_3396":449,"_29729":409,"_20626":49790,"_5":14148,"_27027":49696,"_2882":49791},[],"Check the check route is /v1/ext\\_authz/check.",{"_3396":450,"_29729":409,"_20626":49793,"_5":14148,"_27027":49696,"_2882":49794},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3396":451,"_29729":409,"_20626":49796,"_5":14148,"_27027":49700,"_2882":49797},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3396":452,"_29729":409,"_20626":49799,"_5":14148,"_27027":49704,"_2882":49800},[],"Review kubectl describe pod first. Common causes are:",{"_3396":453,"_29729":409,"_20626":49802,"_5":14148,"_27027":49704,"_2882":49803},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3396":454,"_29729":409,"_20626":49805,"_5":14148,"_27027":49704,"_2882":49806},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3396":455,"_29729":409,"_20626":49808,"_5":14148,"_27027":49704,"_2882":49809},[],"unbound persistent volume;",{"_3396":456,"_29729":409,"_20626":49811,"_5":14148,"_27027":49704,"_2882":49812},[],"inaccessible image or incorrect pull policy;",{"_3396":457,"_29729":409,"_20626":49814,"_5":14148,"_27027":49704,"_2882":49815},[],"invalid cryptographic engine configuration;",{"_3396":458,"_29729":409,"_20626":49817,"_5":14148,"_27027":49704,"_2882":49818},[],"CPU or memory limits set too low;",{"_3396":459,"_29729":409,"_20626":49820,"_5":14148,"_27027":49704,"_2882":49821},[],"an incomplete prior migration.",{"_3396":460,"_29729":409,"_20626":49823,"_5":14148,"_27027":49704,"_2882":49824},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3396":461,"_29729":409,"_20626":49826,"_5":14148,"_27027":49704,"_2882":49827},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3396":462,"_29729":409,"_20626":49829,"_5":14148,"_27027":49704,"_2882":49830},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3396":463,"_29729":409,"_20626":49832,"_5":14148,"_27027":49708,"_2882":49833},[],"Domain and audit events depend on the bus publisher:",{"_3396":464,"_29729":409,"_20626":49835,"_5":14148,"_27027":49708,"_2882":49836},[],"verify it is enabled in the emitting service;",{"_3396":465,"_29729":409,"_20626":49838,"_5":14148,"_27027":49708,"_2882":49839},[],"check AMQP connectivity and credentials;",{"_3396":466,"_29729":409,"_20626":49841,"_5":14148,"_27027":49708,"_2882":49842},[],"review exchange, routing key, queues and consumers;",{"_3396":467,"_29729":409,"_20626":49844,"_5":14148,"_27027":49708,"_2882":49845},[],"inspect dead-letter queues;",{"_3396":468,"_29729":409,"_20626":49847,"_5":14148,"_27027":49708,"_2882":49848},[],"alert on orphan durable queues and backlog growth.",{"_3396":469,"_29729":409,"_20626":49850,"_5":14148,"_27027":49708,"_2882":49851},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3396":470,"_29729":409,"_20626":49853,"_5":14148,"_27027":49708,"_2882":49854},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3396":471,"_29729":409,"_20626":49856,"_5":14148,"_27027":49708,"_2882":49857},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3396":472,"_29729":409,"_20626":49859,"_5":14148,"_27027":49708,"_2882":49860},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3396":473,"_29729":409,"_20626":49862,"_5":14148,"_27027":49708,"_2882":49863},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3396":474,"_29729":409,"_20626":49865,"_5":14148,"_27027":49708,"_2882":49866},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3396":475,"_29729":409,"_20626":49868,"_5":14148,"_27027":49708,"_2882":49869},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3396":476,"_29729":409,"_20626":49871,"_5":14148,"_27027":49712,"_2882":49872},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3396":477,"_29729":409,"_20626":49874,"_5":14148,"_27027":49712,"_2882":49875},[],"Before closing an incident, record:",{"_3396":478,"_29729":409,"_20626":49877,"_5":14148,"_27027":49712,"_2882":49878},[],"the confirmed cause;",{"_3396":479,"_29729":409,"_20626":49880,"_5":14148,"_27027":49712,"_2882":49881},[],"the time scope and affected resources;",{"_3396":480,"_29729":409,"_20626":49883,"_5":14148,"_27027":49712,"_2882":49884},[],"the commands or queries used;",{"_3396":481,"_29729":409,"_20626":49886,"_5":14148,"_27027":49712,"_2882":49887},[],"the applied change and how to revert it;",{"_3396":482,"_29729":409,"_20626":49889,"_5":14148,"_27027":49712,"_2882":49890},[],"validation from a consumer;",{"_3396":483,"_29729":409,"_20626":49892,"_5":14148,"_27027":49712,"_2882":49893},[],"the preventive action and its owner.",{"_3396":484,"_29729":484,"_5":14500,"_2882":49895,"_30082":49896,"_20626":49899,"_27027":484},"Access control",[48429,49897,49898],"Platform","Administration",[],{"_3396":485,"_29729":484,"_20626":49901,"_5":14148,"_27027":484,"_2882":49902},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3396":486,"_29729":484,"_5":30079,"_20626":49904,"_27027":49905,"_2882":49906},[],"/docs/pr-preview/pr-57/platform/administration/access-control#essential-concepts","Essential concepts",{"_3396":487,"_29729":484,"_5":30079,"_20626":49908,"_27027":49909,"_2882":49910},[],"/docs/pr-preview/pr-57/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3396":488,"_29729":484,"_5":30079,"_20626":49912,"_27027":49913,"_2882":49914},[],"/docs/pr-preview/pr-57/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3396":489,"_29729":484,"_5":30079,"_20626":49916,"_27027":49917,"_2882":49918},[],"/docs/pr-preview/pr-57/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3396":490,"_29729":484,"_5":30079,"_20626":49920,"_27027":49921,"_2882":49922},[],"/docs/pr-preview/pr-57/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3396":491,"_29729":484,"_5":30079,"_20626":49924,"_27027":49925,"_2882":49926},[],"/docs/pr-preview/pr-57/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3396":492,"_29729":484,"_5":30079,"_20626":49928,"_27027":49929,"_2882":49930},[],"/docs/pr-preview/pr-57/platform/administration/access-control#oidc-principals","OIDC principals",{"_3396":493,"_29729":484,"_5":30079,"_20626":49932,"_27027":49933,"_2882":49934},[],"/docs/pr-preview/pr-57/platform/administration/access-control#x509-principals","X.509 principals",{"_3396":494,"_29729":484,"_5":30079,"_20626":49936,"_27027":49937,"_2882":49938},[],"/docs/pr-preview/pr-57/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3396":495,"_29729":484,"_5":30079,"_20626":49940,"_27027":49941,"_2882":49942},[],"/docs/pr-preview/pr-57/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3396":496,"_29729":484,"_5":30079,"_20626":49944,"_27027":49945,"_2882":49946},[],"/docs/pr-preview/pr-57/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3396":497,"_29729":484,"_5":30079,"_20626":49948,"_27027":49949,"_2882":49950},[],"/docs/pr-preview/pr-57/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3396":498,"_29729":484,"_5":30079,"_20626":49952,"_27027":49953,"_2882":49954},[],"/docs/pr-preview/pr-57/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3396":499,"_29729":484,"_5":30079,"_20626":49956,"_27027":49957,"_2882":49958},[],"/docs/pr-preview/pr-57/platform/administration/access-control#http-rules","HTTP rules",{"_3396":500,"_29729":484,"_5":30079,"_20626":49960,"_27027":49961,"_2882":49962},[],"/docs/pr-preview/pr-57/platform/administration/access-control#included-policies","Included policies",{"_3396":501,"_29729":484,"_5":30079,"_20626":49964,"_27027":49965,"_2882":49069},[],"/docs/pr-preview/pr-57/platform/administration/access-control#provision-the-first-administrator",{"_3396":502,"_29729":484,"_5":30079,"_20626":49967,"_27027":49968,"_2882":49969},[],"/docs/pr-preview/pr-57/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3396":503,"_29729":484,"_5":30079,"_20626":49971,"_27027":49972,"_2882":49973},[],"/docs/pr-preview/pr-57/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3396":504,"_29729":484,"_5":30079,"_20626":49975,"_27027":49976,"_2882":49977},[],"/docs/pr-preview/pr-57/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3396":505,"_29729":484,"_5":30079,"_20626":49979,"_27027":49980,"_2882":49981},[],"/docs/pr-preview/pr-57/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3396":506,"_29729":484,"_5":30079,"_20626":49983,"_27027":49984,"_2882":49985},[],"/docs/pr-preview/pr-57/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3396":507,"_29729":484,"_5":30079,"_20626":49987,"_27027":49988,"_2882":49989},[],"/docs/pr-preview/pr-57/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3396":508,"_29729":484,"_5":30079,"_20626":49991,"_27027":49992,"_2882":49993},[],"/docs/pr-preview/pr-57/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3396":509,"_29729":484,"_5":30079,"_20626":49995,"_27027":49996,"_2882":49997},[],"/docs/pr-preview/pr-57/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3396":510,"_29729":484,"_5":30079,"_20626":49999,"_27027":50000,"_2882":50001},[],"/docs/pr-preview/pr-57/platform/administration/access-control#operational-checklist","Operational checklist",{"_3396":511,"_29729":484,"_5":30079,"_20626":50003,"_27027":50004,"_2882":50005},[],"/docs/pr-preview/pr-57/platform/administration/access-control#diagnostics","Diagnostics",{"_3396":512,"_29729":484,"_5":30079,"_20626":50007,"_27027":50008,"_2882":50009},[],"/docs/pr-preview/pr-57/platform/administration/access-control#the-response-is-401","The response is 401",{"_3396":513,"_29729":484,"_5":30079,"_20626":50011,"_27027":50012,"_2882":50013},[],"/docs/pr-preview/pr-57/platform/administration/access-control#the-response-is-403","The response is 403",{"_3396":514,"_29729":484,"_5":30079,"_20626":50015,"_27027":50016,"_2882":50017},[],"/docs/pr-preview/pr-57/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3396":515,"_29729":484,"_5":30079,"_20626":50019,"_27027":50020,"_2882":50021},[],"/docs/pr-preview/pr-57/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3396":516,"_29729":484,"_5":30079,"_20626":50023,"_27027":50024,"_2882":50025},[],"/docs/pr-preview/pr-57/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3396":517,"_29729":484,"_20626":50027,"_5":14148,"_27027":484,"_2882":50028},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3396":518,"_29729":484,"_20626":50030,"_5":14148,"_27027":484,"_2882":50031},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3396":519,"_29729":484,"_20626":50033,"_5":14148,"_27027":484,"_2882":50034},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3396":520,"_29729":484,"_20626":50036,"_5":14148,"_27027":49905,"_2882":50037},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3396":521,"_29729":484,"_20626":50039,"_5":14148,"_27027":49905,"_2882":50040},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3396":522,"_29729":484,"_20626":50042,"_5":14148,"_27027":49905,"_2882":50043},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3396":523,"_29729":484,"_20626":50045,"_5":14148,"_27027":49905,"_2882":50046},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3396":524,"_29729":484,"_20626":50048,"_5":14148,"_27027":49905,"_2882":50049},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3396":525,"_29729":484,"_20626":50051,"_5":14148,"_27027":49905,"_2882":50052},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3396":526,"_29729":484,"_20626":50054,"_5":14148,"_27027":49909,"_2882":50055},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3396":527,"_29729":484,"_20626":50057,"_5":14148,"_27027":49909,"_2882":50058},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3396":528,"_29729":484,"_20626":50060,"_5":14148,"_27027":49913,"_2882":50061},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3396":529,"_29729":484,"_20626":50063,"_5":14148,"_27027":49913,"_2882":50064},[],"The decision is made **before forwarding the request to the service**:",{"_3396":530,"_29729":484,"_20626":50066,"_5":14148,"_27027":49913,"_2882":50067},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3396":531,"_29729":484,"_20626":50069,"_5":14148,"_27027":49913,"_2882":50070},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3396":532,"_29729":484,"_20626":50072,"_5":14148,"_27027":49913,"_2882":50073},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3396":533,"_29729":484,"_20626":50075,"_5":14148,"_27027":49913,"_2882":50076},[],"It separately loads the policies granted to each principal.",{"_3396":534,"_29729":484,"_20626":50078,"_5":14148,"_27027":49913,"_2882":50079},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3396":535,"_29729":484,"_20626":50081,"_5":14148,"_27027":49913,"_2882":50082},[],"`authz` looks for an HTTP rule granting that action.",{"_3396":536,"_29729":484,"_20626":50084,"_5":14148,"_27027":49913,"_2882":50085},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3396":537,"_29729":484,"_20626":50087,"_5":14148,"_27027":49913,"_2882":50088},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3396":538,"_29729":484,"_20626":50090,"_5":14148,"_27027":49913,"_2882":50091},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3396":539,"_29729":484,"_20626":50093,"_5":14148,"_27027":49913,"_2882":50094},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3396":540,"_29729":484,"_20626":50096,"_5":14148,"_27027":49917,"_2882":50097},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3396":541,"_29729":484,"_20626":50099,"_5":14148,"_27027":49917,"_2882":50100},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3396":542,"_29729":484,"_20626":50102,"_5":14148,"_27027":49917,"_2882":50103},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3396":543,"_29729":484,"_20626":50105,"_5":14148,"_27027":49917,"_2882":50106},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3396":544,"_29729":484,"_20626":50108,"_5":14148,"_27027":49917,"_2882":50109},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3396":545,"_29729":484,"_20626":50111,"_5":14148,"_27027":49917,"_2882":50112},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3396":546,"_29729":484,"_20626":50114,"_5":14148,"_27027":49917,"_2882":50115},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3396":547,"_29729":484,"_20626":50117,"_5":14148,"_27027":49917,"_2882":50118},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3396":548,"_29729":484,"_20626":50120,"_5":14148,"_27027":49921,"_2882":50121},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3396":549,"_29729":484,"_20626":50123,"_5":14148,"_27027":49921,"_2882":50124},[],"The decision is made with the domain operation context:",{"_3396":550,"_29729":484,"_20626":50126,"_5":14148,"_27027":49921,"_2882":50127},[],"The middleware extracts the credential and resolves the matching principals.",{"_3396":551,"_29729":484,"_20626":50129,"_5":14148,"_27027":49921,"_2882":50130},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3396":552,"_29729":484,"_20626":50132,"_5":14148,"_27027":49921,"_2882":50133},[],"`authz` gathers the entity rules of the granted policies.",{"_3396":553,"_29729":484,"_20626":50135,"_5":14148,"_27027":49921,"_2882":50136},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3396":554,"_29729":484,"_20626":50138,"_5":14148,"_27027":49921,"_2882":50139},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3396":555,"_29729":484,"_20626":50141,"_5":14148,"_27027":49921,"_2882":50142},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3396":556,"_29729":484,"_20626":50144,"_5":14148,"_27027":49921,"_2882":50145},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3396":557,"_29729":484,"_20626":50147,"_5":14148,"_27027":49921,"_2882":50148},[],"Actions fall into two groups:",{"_3396":558,"_29729":484,"_20626":50150,"_5":14148,"_27027":49921,"_2882":50151},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3396":559,"_29729":484,"_20626":50153,"_5":14148,"_27027":49921,"_2882":50154},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3396":560,"_29729":484,"_20626":50156,"_5":14148,"_27027":49921,"_2882":50157},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3396":561,"_29729":484,"_20626":50159,"_5":14148,"_27027":49925,"_2882":50160},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3396":562,"_29729":484,"_20626":50162,"_5":14148,"_27027":49925,"_2882":50163},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3396":563,"_29729":484,"_20626":50165,"_5":14148,"_27027":49925,"_2882":50166},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3396":564,"_29729":484,"_20626":50168,"_5":14148,"_27027":49929,"_2882":50169},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3396":565,"_29729":484,"_20626":50171,"_5":14148,"_27027":49929,"_2882":50172},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3396":566,"_29729":484,"_20626":50174,"_5":14148,"_27027":49929,"_2882":50175},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3396":567,"_29729":484,"_20626":50177,"_5":14148,"_27027":49929,"_2882":50178},[],"The implemented operators are:",{"_3396":568,"_29729":484,"_20626":50180,"_5":14148,"_27027":49929,"_2882":50181},[],"`equals`, for exact equality;",{"_3396":569,"_29729":484,"_20626":50183,"_5":14148,"_27027":49929,"_2882":50184},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3396":570,"_29729":484,"_20626":50186,"_5":14148,"_27027":49929,"_2882":50187},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3396":571,"_29729":484,"_20626":50189,"_5":14148,"_27027":49929,"_2882":50190},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3396":572,"_29729":484,"_20626":50192,"_5":14148,"_27027":49933,"_2882":50193},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3396":573,"_29729":484,"_20626":50195,"_5":14148,"_27027":49933,"_2882":50196},[],"The available modes are:",{"_3396":574,"_29729":484,"_20626":50198,"_5":14148,"_27027":49933,"_2882":50199},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3396":575,"_29729":484,"_20626":50201,"_5":14148,"_27027":49933,"_2882":50202},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3396":576,"_29729":484,"_20626":50204,"_5":14148,"_27027":49933,"_2882":50205},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3396":577,"_29729":484,"_20626":50207,"_5":14148,"_27027":49933,"_2882":50208},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3396":578,"_29729":484,"_20626":50210,"_5":14148,"_27027":49933,"_2882":50211},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3396":579,"_29729":484,"_20626":50213,"_5":14148,"_27027":49933,"_2882":50214},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3396":580,"_29729":484,"_20626":50216,"_5":14148,"_27027":49937,"_2882":50217},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3396":581,"_29729":484,"_20626":50219,"_5":14148,"_27027":49937,"_2882":50220},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3396":582,"_29729":484,"_20626":50222,"_5":14148,"_27027":49937,"_2882":50223},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3396":583,"_29729":484,"_20626":50225,"_5":14148,"_27027":49937,"_2882":50226},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3396":584,"_29729":484,"_20626":50228,"_5":14148,"_27027":49945,"_2882":50229},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3396":585,"_29729":484,"_20626":50231,"_5":14148,"_27027":49945,"_2882":50232},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3396":586,"_29729":484,"_20626":50234,"_5":14148,"_27027":49949,"_2882":50235},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3396":587,"_29729":484,"_20626":50237,"_5":14148,"_27027":49949,"_2882":50238},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3396":588,"_29729":484,"_20626":50240,"_5":14148,"_27027":49953,"_2882":50241},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3396":589,"_29729":484,"_20626":50243,"_5":14148,"_27027":49953,"_2882":50244},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3396":590,"_29729":484,"_20626":50246,"_5":14148,"_27027":49953,"_2882":50247},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3396":591,"_29729":484,"_20626":50249,"_5":14148,"_27027":49957,"_2882":50250},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3396":592,"_29729":484,"_20626":50252,"_5":14148,"_27027":49957,"_2882":50253},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3396":593,"_29729":484,"_20626":50255,"_5":14148,"_27027":49957,"_2882":50256},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3396":594,"_29729":484,"_20626":50258,"_5":14148,"_27027":49957,"_2882":50259},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3396":595,"_29729":484,"_20626":50261,"_5":14148,"_27027":49957,"_2882":50262},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3396":596,"_29729":484,"_20626":50264,"_5":14148,"_27027":49957,"_2882":50265},[],"Note that:",{"_3396":597,"_29729":484,"_20626":50267,"_5":14148,"_27027":49957,"_2882":50268},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3396":598,"_29729":484,"_20626":50270,"_5":14148,"_27027":49957,"_2882":50271},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3396":599,"_29729":484,"_20626":50273,"_5":14148,"_27027":49957,"_2882":50274},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3396":600,"_29729":484,"_20626":50276,"_5":14148,"_27027":49961,"_2882":50277},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3396":601,"_29729":484,"_20626":50279,"_5":14148,"_27027":49961,"_2882":50280},[],"full and read-only access to certificates and authorities;",{"_3396":602,"_29729":484,"_20626":50282,"_5":14148,"_27027":49961,"_2882":50283},[],"full and read-only access to the KMS;",{"_3396":603,"_29729":484,"_20626":50285,"_5":14148,"_27027":49961,"_2882":50286},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3396":604,"_29729":484,"_20626":50288,"_5":14148,"_27027":49961,"_2882":50289},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3396":605,"_29729":484,"_20626":50291,"_5":14148,"_27027":49961,"_2882":50292},[],"console access;",{"_3396":606,"_29729":484,"_20626":50294,"_5":14148,"_27027":49961,"_2882":50295},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3396":607,"_29729":484,"_20626":50297,"_5":14148,"_27027":49961,"_2882":50298},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3396":608,"_29729":484,"_20626":50300,"_5":14148,"_27027":49961,"_2882":50301},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3396":609,"_29729":484,"_20626":50303,"_5":14148,"_27027":49965,"_2882":50304},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3396":610,"_29729":484,"_20626":50306,"_5":14148,"_27027":49965,"_2882":50307},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3396":611,"_29729":484,"_20626":50309,"_5":14148,"_27027":49965,"_2882":50310},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3396":612,"_29729":484,"_20626":50312,"_5":14148,"_27027":49968,"_2882":50313},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3396":613,"_29729":484,"_20626":50315,"_5":14148,"_27027":49972,"_2882":50316},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3396":614,"_29729":484,"_20626":50318,"_5":14148,"_27027":49972,"_2882":50319},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3396":615,"_29729":484,"_20626":50321,"_5":14148,"_27027":49976,"_2882":50322},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3396":616,"_29729":484,"_20626":50324,"_5":14148,"_27027":49980,"_2882":50325},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3396":617,"_29729":484,"_20626":50327,"_5":14148,"_27027":49984,"_2882":50328},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3396":618,"_29729":484,"_20626":50330,"_5":14148,"_27027":49988,"_2882":50331},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3396":619,"_29729":484,"_20626":50333,"_5":14148,"_27027":49988,"_2882":50334},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3396":620,"_29729":484,"_20626":50336,"_5":14148,"_27027":49992,"_2882":50337},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3396":621,"_29729":484,"_20626":50339,"_5":14148,"_27027":49992,"_2882":50340},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3396":622,"_29729":484,"_20626":50342,"_5":14148,"_27027":49992,"_2882":50343},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3396":623,"_29729":484,"_20626":50345,"_5":14148,"_27027":49992,"_2882":50346},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3396":624,"_29729":484,"_20626":50348,"_5":14148,"_27027":49992,"_2882":50349},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3396":625,"_29729":484,"_20626":50351,"_5":14148,"_27027":49992,"_2882":50352},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3396":626,"_29729":484,"_20626":50354,"_5":14148,"_27027":49992,"_2882":50355},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3396":627,"_29729":484,"_20626":50357,"_5":14148,"_27027":49992,"_2882":50358},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3396":628,"_29729":484,"_20626":50360,"_5":14148,"_27027":49996,"_2882":50361},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3396":629,"_29729":484,"_20626":50363,"_5":14148,"_27027":49996,"_2882":50364},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3396":630,"_29729":484,"_20626":50366,"_5":14148,"_27027":49996,"_2882":50367},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3396":631,"_29729":484,"_20626":50369,"_5":14148,"_27027":50000,"_2882":50370},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3396":632,"_29729":484,"_20626":50372,"_5":14148,"_27027":50000,"_2882":50373},[],"Use groups or stable roles for people and independent identities for automations.",{"_3396":633,"_29729":484,"_20626":50375,"_5":14148,"_27027":50000,"_2882":50376},[],"Keep at least two recovery administrators and test their access periodically.",{"_3396":634,"_29729":484,"_20626":50378,"_5":14148,"_27027":50000,"_2882":50379},[],"Review active principals, their matches and their grants after IdP changes.",{"_3396":635,"_29729":484,"_20626":50381,"_5":14148,"_27027":50000,"_2882":50382},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3396":636,"_29729":484,"_20626":50384,"_5":14148,"_27027":50000,"_2882":50385},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3396":637,"_29729":484,"_20626":50387,"_5":14148,"_27027":50000,"_2882":50388},[],"Always test one allowed and one denied operation for each role.",{"_3396":638,"_29729":484,"_20626":50390,"_5":14148,"_27027":50000,"_2882":50391},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3396":639,"_29729":484,"_20626":50393,"_5":14148,"_27027":50008,"_2882":50394},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3396":640,"_29729":484,"_20626":50396,"_5":14148,"_27027":50012,"_2882":50397},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3396":641,"_29729":484,"_20626":50399,"_5":14148,"_27027":50012,"_2882":50400},[],"that an active principal of the correct type exists;",{"_3396":642,"_29729":484,"_20626":50402,"_5":14148,"_27027":50012,"_2882":50403},[],"that the claim paths and values match the real token exactly;",{"_3396":643,"_29729":484,"_20626":50405,"_5":14148,"_27027":50012,"_2882":50406},[],"that all of the principal's conditions hold;",{"_3396":644,"_29729":484,"_20626":50408,"_5":14148,"_27027":50012,"_2882":50409},[],"that the principal has the expected policy granted;",{"_3396":645,"_29729":484,"_20626":50411,"_5":14148,"_27027":50012,"_2882":50412},[],"that the policy includes the action and the requested resource type or route;",{"_3396":646,"_29729":484,"_20626":50414,"_5":14148,"_27027":50012,"_2882":50415},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3396":647,"_29729":484,"_20626":50417,"_5":14148,"_27027":50012,"_2882":50418},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3396":648,"_29729":484,"_20626":50420,"_5":14148,"_27027":50016,"_2882":50421},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3396":649,"_29729":484,"_20626":50423,"_5":14148,"_27027":50020,"_2882":50424},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3396":650,"_29729":484,"_20626":50426,"_5":14148,"_27027":50024,"_2882":50427},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3396":651,"_29729":484,"_20626":50429,"_5":14148,"_27027":50024,"_2882":50430},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3396":652,"_29729":652,"_5":14500,"_2882":50432,"_30082":50433,"_20626":50434,"_27027":652},"Alerts and subscriptions",[48429,49897,49898],[],{"_3396":653,"_29729":652,"_20626":50436,"_5":14148,"_27027":652,"_2882":50437},[],"Send PKI events to people and external systems.",{"_3396":654,"_29729":652,"_5":30079,"_20626":50439,"_27027":50440,"_2882":50441},[],"/docs/pr-preview/pr-57/platform/administration/alerts#how-it-works","How it works",{"_3396":655,"_29729":652,"_5":30079,"_20626":50443,"_27027":50444,"_2882":50445},[],"/docs/pr-preview/pr-57/platform/administration/alerts#available-channels","Available channels",{"_3396":656,"_29729":652,"_5":30079,"_20626":50447,"_27027":50448,"_2882":50449},[],"/docs/pr-preview/pr-57/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3396":657,"_29729":652,"_5":30079,"_20626":50451,"_27027":50452,"_2882":50453},[],"/docs/pr-preview/pr-57/platform/administration/alerts#choose-the-event","Choose the event",{"_3396":658,"_29729":652,"_5":30079,"_20626":50455,"_27027":50456,"_2882":50457},[],"/docs/pr-preview/pr-57/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3396":659,"_29729":652,"_5":30079,"_20626":50459,"_27027":50460,"_2882":50461},[],"/docs/pr-preview/pr-57/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3396":660,"_29729":652,"_5":30079,"_20626":50463,"_27027":50464,"_2882":50465},[],"/docs/pr-preview/pr-57/platform/administration/alerts#review-and-activate","Review and activate",{"_3396":661,"_29729":652,"_5":30079,"_20626":50467,"_27027":50468,"_2882":50469},[],"/docs/pr-preview/pr-57/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3396":662,"_29729":652,"_5":30079,"_20626":50471,"_27027":50472,"_2882":50473},[],"/docs/pr-preview/pr-57/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3396":663,"_29729":652,"_5":30079,"_20626":50475,"_27027":50476,"_2882":50477},[],"/docs/pr-preview/pr-57/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3396":664,"_29729":652,"_5":30079,"_20626":50479,"_27027":50480,"_2882":50481},[],"/docs/pr-preview/pr-57/platform/administration/alerts#event-families","Event families",{"_3396":665,"_29729":652,"_20626":50483,"_5":14148,"_27027":652,"_2882":50484},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3396":666,"_29729":652,"_20626":50486,"_5":14148,"_27027":50440,"_2882":50487},[],"A service publishes a domain event.",{"_3396":667,"_29729":652,"_20626":50489,"_5":14148,"_27027":50440,"_2882":50490},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3396":668,"_29729":652,"_20626":50492,"_5":14148,"_27027":50440,"_2882":50493},[],"Each subscription's filter decides whether it should be notified.",{"_3396":669,"_29729":652,"_20626":50495,"_5":14148,"_27027":50440,"_2882":50496},[],"Lamassu delivers the event to the configured channel.",{"_3396":670,"_29729":652,"_20626":50498,"_5":14148,"_27027":50440,"_2882":50499},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3396":671,"_29729":652,"_20626":50501,"_5":14148,"_27027":50444,"_2882":50502},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3396":672,"_29729":652,"_20626":50504,"_5":14148,"_27027":50444,"_2882":50505},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3396":673,"_29729":652,"_20626":50507,"_5":14148,"_27027":50444,"_2882":50508},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3396":674,"_29729":652,"_20626":50510,"_5":14148,"_27027":50444,"_2882":50511},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3396":675,"_29729":652,"_20626":50513,"_5":14148,"_27027":50444,"_2882":50514},[],"`apikey_options` requires `header` and `key`.",{"_3396":676,"_29729":652,"_20626":50516,"_5":14148,"_27027":50444,"_2882":50517},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3396":677,"_29729":652,"_20626":50519,"_5":14148,"_27027":50444,"_2882":50520},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3396":678,"_29729":652,"_20626":50522,"_5":14148,"_27027":50444,"_2882":50523},[],"The alerts API reference documents the full `http_client` schema.",{"_3396":679,"_29729":652,"_20626":50525,"_5":14148,"_27027":50452,"_2882":50526},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3396":680,"_29729":652,"_20626":50528,"_5":14148,"_27027":50456,"_2882":50529},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3396":681,"_29729":652,"_20626":50531,"_5":14148,"_27027":50460,"_2882":50532},[],"Add a filter if you don't want to receive every instance of the event.",{"_3396":682,"_29729":652,"_20626":50534,"_5":14148,"_27027":50460,"_2882":50535},[],"**None** notifies all instances of the event.",{"_3396":683,"_29729":652,"_20626":50537,"_5":14148,"_27027":50460,"_2882":50538},[],"**JSON Path** evaluates one or more specific fields.",{"_3396":684,"_29729":652,"_20626":50540,"_5":14148,"_27027":50460,"_2882":50541},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3396":685,"_29729":652,"_20626":50543,"_5":14148,"_27027":50460,"_2882":50544},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3396":686,"_29729":652,"_20626":50546,"_5":14148,"_27027":50460,"_2882":50547},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3396":687,"_29729":652,"_20626":50549,"_5":14148,"_27027":50460,"_2882":50550},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3396":688,"_29729":652,"_20626":50552,"_5":14148,"_27027":50464,"_2882":50553},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3396":689,"_29729":652,"_20626":50555,"_5":14148,"_27027":50468,"_2882":50556},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3396":690,"_29729":652,"_20626":50558,"_5":14148,"_27027":50468,"_2882":50559},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3396":691,"_29729":652,"_20626":50561,"_5":14148,"_27027":50468,"_2882":50562},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3396":692,"_29729":652,"_20626":50564,"_5":14148,"_27027":50468,"_2882":50565},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3396":693,"_29729":652,"_20626":50567,"_5":14148,"_27027":50468,"_2882":50568},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3396":694,"_29729":652,"_20626":50570,"_5":14148,"_27027":50468,"_2882":50571},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3396":695,"_29729":652,"_20626":50573,"_5":14148,"_27027":50468,"_2882":50574},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3396":696,"_29729":652,"_20626":50576,"_5":14148,"_27027":50468,"_2882":50577},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3396":697,"_29729":652,"_20626":50579,"_5":14148,"_27027":50472,"_2882":50580},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3396":698,"_29729":652,"_20626":50582,"_5":14148,"_27027":50472,"_2882":50583},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3396":699,"_29729":652,"_20626":50585,"_5":14148,"_27027":50472,"_2882":50586},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3396":700,"_29729":652,"_20626":50588,"_5":14148,"_27027":50472,"_2882":50589},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3396":701,"_29729":652,"_20626":50591,"_5":14148,"_27027":50472,"_2882":50592},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3396":702,"_29729":652,"_20626":50594,"_5":14148,"_27027":50472,"_2882":50595},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3396":703,"_29729":652,"_20626":50597,"_5":14148,"_27027":50472,"_2882":50598},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3396":704,"_29729":652,"_20626":50600,"_5":14148,"_27027":50472,"_2882":50601},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3396":705,"_29729":652,"_20626":50603,"_5":14148,"_27027":50476,"_2882":50604},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3396":706,"_29729":652,"_20626":50606,"_5":14148,"_27027":50476,"_2882":50607},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3396":707,"_29729":652,"_20626":50609,"_5":14148,"_27027":50480,"_2882":50610},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3396":708,"_29729":652,"_20626":50612,"_5":14148,"_27027":50480,"_2882":50613},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3396":709,"_29729":652,"_20626":50615,"_5":14148,"_27027":50480,"_2882":50616},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3396":710,"_29729":652,"_20626":50618,"_5":14148,"_27027":50480,"_2882":50619},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3396":711,"_29729":652,"_20626":50621,"_5":14148,"_27027":50480,"_2882":50622},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3396":712,"_29729":652,"_20626":50624,"_5":14148,"_27027":50480,"_2882":50625},[],"**Validation:** `va.role.crl.create`.",{"_3396":713,"_29729":652,"_20626":50627,"_5":14148,"_27027":50480,"_2882":50628},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3396":714,"_29729":652,"_20626":50630,"_5":14148,"_27027":50480,"_2882":50631},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3396":715,"_29729":715,"_5":14500,"_2882":50633,"_30082":50634,"_20626":50635,"_27027":715},"Audit logs",[48429,49897,49898],[],{"_3396":716,"_29729":715,"_20626":50637,"_5":14148,"_27027":715,"_2882":50638},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3396":717,"_29729":715,"_5":30079,"_20626":50640,"_27027":50641,"_2882":50642},[],"/docs/pr-preview/pr-57/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3396":718,"_29729":715,"_5":30079,"_20626":50644,"_27027":50645,"_2882":50646},[],"/docs/pr-preview/pr-57/platform/administration/audit-logs#coverage","Coverage",{"_3396":719,"_29729":715,"_5":30079,"_20626":50648,"_27027":50649,"_2882":50650},[],"/docs/pr-preview/pr-57/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3396":720,"_29729":715,"_5":30079,"_20626":50652,"_27027":50653,"_2882":50654},[],"/docs/pr-preview/pr-57/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3396":721,"_29729":715,"_5":30079,"_20626":50656,"_27027":50657,"_2882":50658},[],"/docs/pr-preview/pr-57/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3396":722,"_29729":715,"_5":30079,"_20626":50660,"_27027":50661,"_2882":50662},[],"/docs/pr-preview/pr-57/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3396":723,"_29729":715,"_5":30079,"_20626":50664,"_27027":50665,"_2882":50666},[],"/docs/pr-preview/pr-57/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3396":724,"_29729":715,"_5":30079,"_20626":50668,"_27027":50669,"_2882":50670},[],"/docs/pr-preview/pr-57/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3396":725,"_29729":715,"_5":30079,"_20626":50672,"_27027":50673,"_2882":50674},[],"/docs/pr-preview/pr-57/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3396":726,"_29729":715,"_5":30079,"_20626":50676,"_27027":50677,"_2882":50678},[],"/docs/pr-preview/pr-57/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3396":727,"_29729":715,"_5":30079,"_20626":50680,"_27027":50681,"_2882":50682},[],"/docs/pr-preview/pr-57/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3396":728,"_29729":715,"_20626":50684,"_5":14148,"_27027":715,"_2882":50685},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3396":729,"_29729":715,"_20626":50687,"_5":14148,"_27027":50641,"_2882":50688},[],"The audit body includes:",{"_3396":730,"_29729":715,"_20626":50690,"_5":14148,"_27027":50641,"_2882":50691},[],"input: data received by the operation;",{"_3396":731,"_29729":715,"_20626":50693,"_5":14148,"_27027":50641,"_2882":50694},[],"has\\_error: whether the service returned an error;",{"_3396":732,"_29729":715,"_20626":50696,"_5":14148,"_27027":50641,"_2882":50697},[],"output: produced result or error message;",{"_3396":733,"_29729":715,"_20626":50699,"_5":14148,"_27027":50641,"_2882":50700},[],"principals: identifiers of the principals that matched the request.",{"_3396":734,"_29729":715,"_20626":50702,"_5":14148,"_27027":50641,"_2882":50703},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3396":735,"_29729":715,"_20626":50705,"_5":14148,"_27027":50641,"_2882":50706},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3396":736,"_29729":715,"_20626":50708,"_5":14148,"_27027":50645,"_2882":50709},[],"The backend applies auditing to mutations of:",{"_3396":737,"_29729":715,"_20626":50711,"_5":14148,"_27027":50645,"_2882":50712},[],"authorities, certificates and issuance profiles;",{"_3396":738,"_29729":715,"_20626":50714,"_5":14148,"_27027":50645,"_2882":50715},[],"keys and KMS engines;",{"_3396":739,"_29729":715,"_20626":50717,"_5":14148,"_27027":50645,"_2882":50718},[],"devices and identities;",{"_3396":740,"_29729":715,"_20626":50720,"_5":14148,"_27027":50645,"_2882":50721},[],"DMSs and enrollment operations;",{"_3396":741,"_29729":715,"_20626":50723,"_5":14148,"_27027":50645,"_2882":50724},[],"validation functions and CRL;",{"_3396":742,"_29729":715,"_20626":50726,"_5":14148,"_27027":50645,"_2882":50727},[],"principals, policies and authorization grants.",{"_3396":743,"_29729":715,"_20626":50729,"_5":14148,"_27027":50645,"_2882":50730},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3396":744,"_29729":715,"_20626":50732,"_5":14148,"_27027":50649,"_2882":50733},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3396":745,"_29729":715,"_20626":50735,"_5":14148,"_27027":50649,"_2882":50736},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3396":746,"_29729":715,"_20626":50738,"_5":14148,"_27027":50649,"_2882":50739},[],"Design the consumer to:",{"_3396":747,"_29729":715,"_20626":50741,"_5":14148,"_27027":50649,"_2882":50742},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3396":748,"_29729":715,"_20626":50744,"_5":14148,"_27027":50649,"_2882":50745},[],"keep the complete CloudEvent unmodified;",{"_3396":749,"_29729":715,"_20626":50747,"_5":14148,"_27027":50649,"_2882":50748},[],"record the ingestion time and detect duplicates by ID;",{"_3396":750,"_29729":715,"_20626":50750,"_5":14148,"_27027":50649,"_2882":50751},[],"encrypt in transit and at rest;",{"_3396":751,"_29729":715,"_20626":50753,"_5":14148,"_27027":50649,"_2882":50754},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3396":752,"_29729":715,"_20626":50756,"_5":14148,"_27027":50649,"_2882":50757},[],"apply an explicit retention and legal hold policy;",{"_3396":753,"_29729":715,"_20626":50759,"_5":14148,"_27027":50649,"_2882":50760},[],"alert if it stops consuming or the pending queue grows.",{"_3396":754,"_29729":715,"_20626":50762,"_5":14148,"_27027":50653,"_2882":50763},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3396":755,"_29729":715,"_20626":50765,"_5":14148,"_27027":50653,"_2882":50766},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3396":756,"_29729":715,"_20626":50768,"_5":14148,"_27027":50661,"_2882":50769},[],"Start from the reported time and normalize every source to UTC.",{"_3396":757,"_29729":715,"_20626":50771,"_5":14148,"_27027":50665,"_2882":50772},[],"Filter by event type, service source and resource identifier.",{"_3396":758,"_29729":715,"_20626":50774,"_5":14148,"_27027":50669,"_2882":50775},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3396":759,"_29729":715,"_20626":50777,"_5":14148,"_27027":50673,"_2882":50778},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3396":760,"_29729":715,"_20626":50780,"_5":14148,"_27027":50677,"_2882":50781},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3396":761,"_29729":715,"_20626":50783,"_5":14148,"_27027":50681,"_2882":50784},[],"Generate a controlled mutation in a test environment and check that:",{"_3396":762,"_29729":715,"_20626":50786,"_5":14148,"_27027":50681,"_2882":50787},[],"a successful audit event appears;",{"_3396":763,"_29729":715,"_20626":50789,"_5":14148,"_27027":50681,"_2882":50790},[],"the principal matches the identity used;",{"_3396":764,"_29729":715,"_20626":50792,"_5":14148,"_27027":50681,"_2882":50793},[],"the consumer persists it exactly once;",{"_3396":765,"_29729":715,"_20626":50795,"_5":14148,"_27027":50681,"_2882":50796},[],"it can be retrieved by resource, actor and period;",{"_3396":766,"_29729":715,"_20626":50798,"_5":14148,"_27027":50681,"_2882":50799},[],"a consumer outage raises an alert.",{"_3396":767,"_29729":715,"_20626":50801,"_5":14148,"_27027":50681,"_2882":50802},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3396":768,"_29729":768,"_5":14500,"_2882":50804,"_30082":50805,"_20626":50806,"_27027":768},"Platform architecture",[48429,49897],[],{"_3396":769,"_29729":768,"_20626":50808,"_5":14148,"_27027":768,"_2882":50809},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3396":770,"_29729":768,"_5":30079,"_20626":50811,"_27027":50812,"_2882":50813},[],"/docs/pr-preview/pr-57/platform/concepts/architecture#control-plane","Control plane",{"_3396":771,"_29729":768,"_5":30079,"_20626":50815,"_27027":50816,"_2882":50817},[],"/docs/pr-preview/pr-57/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3396":772,"_29729":768,"_5":30079,"_20626":50819,"_27027":50820,"_2882":50821},[],"/docs/pr-preview/pr-57/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3396":773,"_29729":768,"_5":30079,"_20626":50823,"_27027":50824,"_2882":50825},[],"/docs/pr-preview/pr-57/platform/concepts/architecture#status-and-validation","Status and validation",{"_3396":774,"_29729":768,"_5":30079,"_20626":50827,"_27027":50828,"_2882":50829},[],"/docs/pr-preview/pr-57/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3396":775,"_29729":768,"_20626":50831,"_5":14148,"_27027":768,"_2882":50832},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3396":776,"_29729":768,"_20626":50834,"_5":14148,"_27027":768,"_2882":50835},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3396":777,"_29729":768,"_20626":50837,"_5":14148,"_27027":50812,"_2882":50838},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3396":778,"_29729":768,"_20626":50840,"_5":14148,"_27027":50816,"_2882":50841},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3396":779,"_29729":768,"_20626":50843,"_5":14148,"_27027":50820,"_2882":50844},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3396":780,"_29729":768,"_20626":50846,"_5":14148,"_27027":50824,"_2882":50847},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3396":781,"_29729":768,"_20626":50849,"_5":14148,"_27027":50828,"_2882":50850},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3396":782,"_29729":782,"_5":14500,"_2882":50852,"_30082":50853,"_20626":50854,"_27027":782},"How Lamassu works",[48429,49897],[],{"_3396":783,"_29729":782,"_20626":50856,"_5":14148,"_27027":782,"_2882":50857},[],"The mental model of trust, keys, certificates and devices.",{"_3396":784,"_29729":782,"_5":30079,"_20626":50859,"_27027":50860,"_2882":50861},[],"/docs/pr-preview/pr-57/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3396":785,"_29729":782,"_5":30079,"_20626":50863,"_27027":50864,"_2882":50865},[],"/docs/pr-preview/pr-57/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3396":786,"_29729":782,"_20626":50867,"_5":14148,"_27027":782,"_2882":50868},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3396":787,"_29729":782,"_20626":50870,"_5":14148,"_27027":50860,"_2882":50871},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3396":788,"_29729":782,"_20626":50873,"_5":14148,"_27027":50860,"_2882":50874},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3396":789,"_29729":782,"_20626":50876,"_5":14148,"_27027":50860,"_2882":50877},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3396":790,"_29729":782,"_20626":50879,"_5":14148,"_27027":50860,"_2882":50880},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3396":791,"_29729":782,"_20626":50882,"_5":14148,"_27027":50860,"_2882":50883},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3396":792,"_29729":782,"_20626":50885,"_5":14148,"_27027":50864,"_2882":50886},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3396":793,"_29729":782,"_20626":50888,"_5":14148,"_27027":50864,"_2882":50889},[],"A DMS relates that CA to an enrollment policy.",{"_3396":794,"_29729":782,"_20626":50891,"_5":14148,"_27027":50864,"_2882":50892},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3396":795,"_29729":782,"_20626":50894,"_5":14148,"_27027":50864,"_2882":50895},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3396":796,"_29729":782,"_20626":50897,"_5":14148,"_27027":50864,"_2882":50898},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3396":797,"_29729":782,"_20626":50900,"_5":14148,"_27027":50864,"_2882":50901},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3396":798,"_29729":782,"_20626":50903,"_5":14148,"_27027":50864,"_2882":50904},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3396":799,"_29729":799,"_5":14500,"_2882":50906,"_30082":50907,"_20626":50909,"_27027":799},"Devices and identities",[48429,49897,50908,50906],"IoT Fleets",[],{"_3396":800,"_29729":799,"_20626":50911,"_5":14148,"_27027":799,"_2882":50912},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3396":801,"_29729":799,"_5":30079,"_20626":50914,"_27027":50915,"_2882":50916},[],"/docs/pr-preview/pr-57/platform/iot-fleets/device-management#device-states","Device states",{"_3396":802,"_29729":799,"_5":30079,"_20626":50918,"_27027":50919,"_2882":50920},[],"/docs/pr-preview/pr-57/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3396":803,"_29729":799,"_5":30079,"_20626":50922,"_27027":50923,"_2882":50924},[],"/docs/pr-preview/pr-57/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3396":804,"_29729":799,"_5":30079,"_20626":50926,"_27027":50927,"_2882":50928},[],"/docs/pr-preview/pr-57/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3396":805,"_29729":799,"_5":30079,"_20626":50930,"_27027":50931,"_2882":50932},[],"/docs/pr-preview/pr-57/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3396":806,"_29729":799,"_5":30079,"_20626":50934,"_27027":50935,"_2882":50936},[],"/docs/pr-preview/pr-57/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3396":807,"_29729":799,"_5":30079,"_20626":50938,"_27027":50939,"_2882":50940},[],"/docs/pr-preview/pr-57/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3396":808,"_29729":799,"_5":30079,"_20626":50942,"_27027":50943,"_2882":50944},[],"/docs/pr-preview/pr-57/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3396":809,"_29729":799,"_5":30079,"_20626":50946,"_27027":50947,"_2882":50948},[],"/docs/pr-preview/pr-57/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3396":810,"_29729":799,"_5":30079,"_20626":50950,"_27027":50951,"_2882":50952},[],"/docs/pr-preview/pr-57/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3396":811,"_29729":799,"_5":30079,"_20626":50954,"_27027":50955,"_2882":50956},[],"/docs/pr-preview/pr-57/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3396":812,"_29729":799,"_20626":50958,"_5":14148,"_27027":799,"_2882":50959},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3396":813,"_29729":799,"_20626":50961,"_5":14148,"_27027":799,"_2882":50962},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3396":814,"_29729":799,"_20626":50964,"_5":14148,"_27027":50915,"_2882":50965},[],"Operational view",{"_3396":815,"_29729":799,"_20626":50967,"_5":14148,"_27027":50915,"_2882":50968},[],"Meaning",{"_3396":816,"_29729":799,"_20626":50970,"_5":14148,"_27027":50915,"_2882":50971},[],"**No Identity**",{"_3396":817,"_29729":799,"_20626":50973,"_5":14148,"_27027":50915,"_2882":50974},[],"A record exists without an associated identity.",{"_3396":818,"_29729":799,"_20626":50976,"_5":14148,"_27027":50915,"_2882":50977},[],"**Active**",{"_3396":819,"_29729":799,"_20626":50979,"_5":14148,"_27027":50915,"_2882":50980},[],"The slot is active; also check certificate dates, status and usages.",{"_3396":820,"_29729":799,"_20626":50982,"_5":14148,"_27027":50915,"_2882":50983},[],"**Renewal Pending**",{"_3396":821,"_29729":799,"_20626":50985,"_5":14148,"_27027":50915,"_2882":50986},[],"The identity is in the operational renewal window.",{"_3396":822,"_29729":799,"_20626":50988,"_5":14148,"_27027":50915,"_2882":50989},[],"**Expiring Soon**",{"_3396":823,"_29729":799,"_20626":50991,"_5":14148,"_27027":50915,"_2882":50992},[],"Expiration is approaching according to configured thresholds.",{"_3396":824,"_29729":799,"_20626":50994,"_5":14148,"_27027":50915,"_2882":50995},[],"**Expired**",{"_3396":825,"_29729":799,"_20626":50997,"_5":14148,"_27027":50915,"_2882":50998},[],"The identity has expired.",{"_3396":826,"_29729":799,"_20626":51000,"_5":14148,"_27027":50915,"_2882":51001},[],"**Revoked**",{"_3396":827,"_29729":799,"_20626":51003,"_5":14148,"_27027":50915,"_2882":51004},[],"The identity is marked revoked.",{"_3396":828,"_29729":799,"_20626":51006,"_5":14148,"_27027":50915,"_2882":51007},[],"**Decommissioned**",{"_3396":829,"_29729":799,"_20626":51009,"_5":14148,"_27027":50915,"_2882":51010},[],"The record is retired and ordinary updates do not restore operation.",{"_3396":830,"_29729":799,"_20626":51012,"_5":14148,"_27027":50915,"_2882":51013},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3396":831,"_29729":799,"_20626":51015,"_5":14148,"_27027":50919,"_2882":51016},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3396":832,"_29729":799,"_20626":51018,"_5":14148,"_27027":50919,"_2882":51019},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3396":833,"_29729":799,"_20626":51021,"_5":14148,"_27027":50919,"_2882":51022},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3396":834,"_29729":799,"_20626":51024,"_5":14148,"_27027":50919,"_2882":51025},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3396":835,"_29729":799,"_20626":51027,"_5":14148,"_27027":50923,"_2882":51028},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3396":836,"_29729":799,"_20626":51030,"_5":14148,"_27027":50927,"_2882":51031},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3396":837,"_29729":799,"_20626":51033,"_5":14148,"_27027":50931,"_2882":51034},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3396":838,"_29729":799,"_20626":51036,"_5":14148,"_27027":50935,"_2882":51037},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3396":839,"_29729":799,"_20626":51039,"_5":14148,"_27027":50939,"_2882":51040},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3396":840,"_29729":799,"_20626":51042,"_5":14148,"_27027":50939,"_2882":51043},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3396":841,"_29729":799,"_20626":51045,"_5":14148,"_27027":50943,"_2882":51046},[],"From **No Identity**, use **Assign Identity**:",{"_3396":842,"_29729":799,"_20626":51048,"_5":14148,"_27027":50943,"_2882":51049},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3396":843,"_29729":799,"_20626":51051,"_5":14148,"_27027":50943,"_2882":51052},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3396":844,"_29729":799,"_20626":51054,"_5":14148,"_27027":50943,"_2882":51055},[],"Confirm and read the serial, active version and history again.",{"_3396":845,"_29729":799,"_20626":51057,"_5":14148,"_27027":50943,"_2882":51058},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3396":846,"_29729":799,"_20626":51060,"_5":14148,"_27027":50943,"_2882":51061},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3396":847,"_29729":799,"_20626":51063,"_5":14148,"_27027":50947,"_2882":51064},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3396":848,"_29729":799,"_20626":51066,"_5":14148,"_27027":50947,"_2882":51067},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3396":849,"_29729":799,"_20626":51069,"_5":14148,"_27027":50951,"_2882":51070},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3396":850,"_29729":799,"_20626":51072,"_5":14148,"_27027":50951,"_2882":51073},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3396":851,"_29729":799,"_20626":51075,"_5":14148,"_27027":50951,"_2882":51076},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3396":852,"_29729":799,"_20626":51078,"_5":14148,"_27027":50951,"_2882":51079},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3396":853,"_29729":799,"_20626":51081,"_5":14148,"_27027":50955,"_2882":51082},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3396":854,"_29729":799,"_20626":51084,"_5":14148,"_27027":50955,"_2882":51085},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3396":855,"_29729":855,"_5":14500,"_2882":51087,"_30082":51088,"_20626":51090,"_27027":855},"Bootstrap identity and authentication",[48429,49897,50908,50906,51089],"Enrollment with PKI",[],{"_3396":856,"_29729":855,"_20626":51092,"_5":14148,"_27027":855,"_2882":51093},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3396":857,"_29729":855,"_5":30079,"_20626":51095,"_27027":51096,"_2882":51097},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3396":858,"_29729":855,"_5":30079,"_20626":51099,"_27027":51100,"_2882":51101},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3396":859,"_29729":855,"_5":30079,"_20626":51103,"_27027":51104,"_2882":51105},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3396":860,"_29729":855,"_5":30079,"_20626":51107,"_27027":51108,"_2882":51109},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3396":861,"_29729":855,"_5":30079,"_20626":51111,"_27027":51112,"_2882":51113},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3396":862,"_29729":855,"_20626":51115,"_5":14148,"_27027":855,"_2882":51116},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3396":863,"_29729":855,"_20626":51118,"_5":14148,"_27027":51096,"_2882":51119},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3396":864,"_29729":855,"_20626":51121,"_5":14148,"_27027":51096,"_2882":51122},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3396":865,"_29729":855,"_20626":51124,"_5":14148,"_27027":51100,"_2882":51125},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3396":866,"_29729":855,"_20626":51127,"_5":14148,"_27027":51100,"_2882":51128},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3396":867,"_29729":855,"_20626":51130,"_5":14148,"_27027":51100,"_2882":51131},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3396":868,"_29729":855,"_20626":51133,"_5":14148,"_27027":51104,"_2882":51134},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3396":869,"_29729":855,"_20626":51136,"_5":14148,"_27027":51104,"_2882":51137},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3396":870,"_29729":855,"_20626":51139,"_5":14148,"_27027":51108,"_2882":51140},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3396":871,"_29729":855,"_20626":51142,"_5":14148,"_27027":51108,"_2882":51143},[],"Example body:",{"_3396":872,"_29729":855,"_20626":51145,"_5":14148,"_27027":51108,"_2882":51146},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3396":873,"_29729":855,"_20626":51148,"_5":14148,"_27027":51108,"_2882":51149},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3396":874,"_29729":855,"_20626":51151,"_5":14148,"_27027":51108,"_2882":51152},[],"Continuation requires a successful HTTP response and JSON:",{"_3396":875,"_29729":855,"_20626":51154,"_5":14148,"_27027":51108,"_2882":51155},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3396":876,"_29729":855,"_20626":51157,"_5":14148,"_27027":51112,"_2882":51158},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3396":877,"_29729":855,"_20626":51160,"_5":14148,"_27027":51112,"_2882":51161},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3396":878,"_29729":878,"_5":14500,"_2882":51163,"_30082":51164,"_20626":51165,"_27027":878},"Configure and operate the DMS",[48429,49897,50908,50906,51089],[],{"_3396":879,"_29729":878,"_20626":51167,"_5":14148,"_27027":878,"_2882":51168},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3396":880,"_29729":878,"_5":30079,"_20626":51170,"_27027":51171,"_2882":48439},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3396":881,"_29729":878,"_5":30079,"_20626":51173,"_27027":51174,"_2882":51175},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3396":882,"_29729":878,"_5":30079,"_20626":51177,"_27027":51178,"_2882":51179},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3396":883,"_29729":878,"_5":30079,"_20626":51181,"_27027":51182,"_2882":51183},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3396":884,"_29729":878,"_5":30079,"_20626":51185,"_27027":51186,"_2882":51187},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3396":885,"_29729":878,"_5":30079,"_20626":51189,"_27027":51190,"_2882":51191},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3396":886,"_29729":878,"_5":30079,"_20626":51193,"_27027":51194,"_2882":51195},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3396":887,"_29729":878,"_5":30079,"_20626":51197,"_27027":51198,"_2882":51199},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3396":888,"_29729":878,"_5":30079,"_20626":51201,"_27027":51202,"_2882":51203},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3396":889,"_29729":878,"_5":30079,"_20626":51205,"_27027":51206,"_2882":51207},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3396":890,"_29729":878,"_5":30079,"_20626":51209,"_27027":51210,"_2882":51211},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3396":891,"_29729":878,"_5":30079,"_20626":51213,"_27027":51214,"_2882":51215},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3396":892,"_29729":878,"_5":30079,"_20626":51217,"_27027":51218,"_2882":51219},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3396":893,"_29729":878,"_5":30079,"_20626":51221,"_27027":51222,"_2882":51223},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3396":894,"_29729":878,"_5":30079,"_20626":51225,"_27027":51226,"_2882":51227},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3396":895,"_29729":878,"_5":30079,"_20626":51229,"_27027":51230,"_2882":51231},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3396":896,"_29729":878,"_5":30079,"_20626":51233,"_27027":51234,"_2882":51235},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3396":897,"_29729":878,"_5":30079,"_20626":51237,"_27027":51238,"_2882":51239},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3396":898,"_29729":878,"_20626":51241,"_5":14148,"_27027":878,"_2882":51242},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3396":899,"_29729":878,"_20626":51244,"_5":14148,"_27027":51171,"_2882":51245},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3396":900,"_29729":878,"_20626":51247,"_5":14148,"_27027":51171,"_2882":51248},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3396":901,"_29729":878,"_20626":51250,"_5":14148,"_27027":51178,"_2882":51251},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3396":902,"_29729":878,"_20626":51253,"_5":14148,"_27027":51182,"_2882":51254},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3396":903,"_29729":878,"_20626":51256,"_5":14148,"_27027":51186,"_2882":51257},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3396":904,"_29729":878,"_20626":51259,"_5":14148,"_27027":51190,"_2882":51260},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3396":905,"_29729":878,"_20626":51262,"_5":14148,"_27027":51194,"_2882":51263},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3396":906,"_29729":878,"_20626":51265,"_5":14148,"_27027":51202,"_2882":51266},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3396":907,"_29729":878,"_20626":51268,"_5":14148,"_27027":51202,"_2882":51269},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3396":908,"_29729":878,"_20626":51271,"_5":14148,"_27027":51206,"_2882":51272},[],"`settings.enrollment_settings` field",{"_3396":909,"_29729":878,"_20626":51274,"_5":14148,"_27027":51206,"_2882":51275},[],"Decision",{"_3396":910,"_29729":878,"_20626":51277,"_5":14148,"_27027":51206,"_2882":51278},[],"`protocol`",{"_3396":911,"_29729":878,"_20626":51280,"_5":14148,"_27027":51206,"_2882":51281},[],"`EST_RFC7030` for these operations.",{"_3396":912,"_29729":878,"_20626":51283,"_5":14148,"_27027":51206,"_2882":51284},[],"`enrollment_ca`",{"_3396":913,"_29729":878,"_20626":51286,"_5":14148,"_27027":51206,"_2882":51287},[],"ID of the signing CA.",{"_3396":914,"_29729":878,"_20626":51289,"_5":14148,"_27027":51206,"_2882":51290},[],"`verify_csr_signature`",{"_3396":915,"_29729":878,"_20626":51292,"_5":14148,"_27027":51206,"_2882":51293},[],"Keep `true` to verify CSR key possession.",{"_3396":916,"_29729":878,"_20626":51295,"_5":14148,"_27027":51206,"_2882":51296},[],"`enable_replaceable_enrollment`",{"_3396":917,"_29729":878,"_20626":51298,"_5":14148,"_27027":51206,"_2882":51299},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3396":918,"_29729":878,"_20626":51301,"_5":14148,"_27027":51206,"_2882":51302},[],"`est_rfc7030_settings.auth_mode`",{"_3396":919,"_29729":878,"_20626":51304,"_5":14148,"_27027":51206,"_2882":51305},[],"One of the four authentication modes.",{"_3396":920,"_29729":878,"_20626":51307,"_5":14148,"_27027":51206,"_2882":51308},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3396":921,"_29729":878,"_20626":51310,"_5":14148,"_27027":51210,"_2882":51311},[],"The blocks are independent:",{"_3396":922,"_29729":878,"_20626":51313,"_5":14148,"_27027":51210,"_2882":51314},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3396":923,"_29729":878,"_20626":51316,"_5":14148,"_27027":51210,"_2882":51317},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3396":924,"_29729":878,"_20626":51319,"_5":14148,"_27027":51210,"_2882":51320},[],"`auth_mode`",{"_3396":925,"_29729":878,"_20626":51322,"_5":14148,"_27027":51210,"_2882":51323},[],"Control applied in the configured operation",{"_3396":926,"_29729":878,"_20626":51325,"_5":14148,"_27027":51210,"_2882":51326},[],"`CLIENT_CERTIFICATE`",{"_3396":927,"_29729":878,"_20626":51328,"_5":14148,"_27027":51210,"_2882":51329},[],"Presented certificate validation.",{"_3396":928,"_29729":878,"_20626":51331,"_5":14148,"_27027":51210,"_2882":51332},[],"`EXTERNAL_WEBHOOK`",{"_3396":929,"_29729":878,"_20626":51334,"_5":14148,"_27027":51210,"_2882":51335},[],"Configured webhook authorization.",{"_3396":930,"_29729":878,"_20626":51337,"_5":14148,"_27027":51210,"_2882":51338},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3396":931,"_29729":878,"_20626":51340,"_5":14148,"_27027":51210,"_2882":51341},[],"Certificate validation followed by webhook approval.",{"_3396":932,"_29729":878,"_20626":51343,"_5":14148,"_27027":51210,"_2882":51344},[],"`NO_AUTH`",{"_3396":933,"_29729":878,"_20626":51346,"_5":14148,"_27027":51210,"_2882":51347},[],"No DMS requester authentication.",{"_3396":934,"_29729":878,"_20626":51349,"_5":14148,"_27027":51210,"_2882":51350},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3396":935,"_29729":878,"_20626":51352,"_5":14148,"_27027":51210,"_2882":51353},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3396":936,"_29729":878,"_20626":51355,"_5":14148,"_27027":51210,"_2882":51356},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3396":937,"_29729":878,"_20626":51358,"_5":14148,"_27027":51210,"_2882":51359},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3396":938,"_29729":878,"_20626":51361,"_5":14148,"_27027":51214,"_2882":51362},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3396":939,"_29729":878,"_20626":51364,"_5":14148,"_27027":51214,"_2882":51365},[],"`external_webhook_settings` field",{"_3396":940,"_29729":878,"_20626":51367,"_5":14148,"_27027":51214,"_2882":51275},[],{"_3396":941,"_29729":878,"_20626":51369,"_5":14148,"_27027":51214,"_2882":51370},[],"`url`",{"_3396":942,"_29729":878,"_20626":51372,"_5":14148,"_27027":51214,"_2882":51373},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3396":943,"_29729":878,"_20626":51375,"_5":14148,"_27027":51214,"_2882":51376},[],"`method`",{"_3396":944,"_29729":878,"_20626":51378,"_5":14148,"_27027":51214,"_2882":51379},[],"`POST` or `PUT`; `POST` by default.",{"_3396":945,"_29729":878,"_20626":51381,"_5":14148,"_27027":51214,"_2882":51382},[],"`name`",{"_3396":946,"_29729":878,"_20626":51384,"_5":14148,"_27027":51214,"_2882":51385},[],"Label used in service logs.",{"_3396":947,"_29729":878,"_20626":51387,"_5":14148,"_27027":51214,"_2882":51388},[],"`config.auth_mode`",{"_3396":948,"_29729":878,"_20626":51390,"_5":14148,"_27027":51214,"_2882":51391},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3396":949,"_29729":878,"_20626":51393,"_5":14148,"_27027":51214,"_2882":51394},[],"`config.log_level`",{"_3396":950,"_29729":878,"_20626":51396,"_5":14148,"_27027":51214,"_2882":51397},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3396":951,"_29729":878,"_20626":51399,"_5":14148,"_27027":51214,"_2882":51400},[],"`config.apikey_options`",{"_3396":952,"_29729":878,"_20626":51402,"_5":14148,"_27027":51214,"_2882":51403},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3396":953,"_29729":878,"_20626":51405,"_5":14148,"_27027":51214,"_2882":51406},[],"`config.jwt_options`",{"_3396":954,"_29729":878,"_20626":51408,"_5":14148,"_27027":51214,"_2882":51409},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3396":955,"_29729":878,"_20626":51411,"_5":14148,"_27027":51214,"_2882":51412},[],"`config.mtls_options`",{"_3396":956,"_29729":878,"_20626":51414,"_5":14148,"_27027":51214,"_2882":51415},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3396":957,"_29729":878,"_20626":51417,"_5":14148,"_27027":51214,"_2882":51418},[],"`config.insecure_skip_verify`",{"_3396":958,"_29729":878,"_20626":51420,"_5":14148,"_27027":51214,"_2882":51421},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3396":959,"_29729":878,"_20626":51423,"_5":14148,"_27027":51214,"_2882":51424},[],"`config.call_timeout`",{"_3396":960,"_29729":878,"_20626":51426,"_5":14148,"_27027":51214,"_2882":51427},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3396":961,"_29729":878,"_20626":51429,"_5":14148,"_27027":51214,"_2882":51430},[],"Rules for that configuration:",{"_3396":962,"_29729":878,"_20626":51432,"_5":14148,"_27027":51214,"_2882":51433},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3396":963,"_29729":878,"_20626":51435,"_5":14148,"_27027":51214,"_2882":51436},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3396":964,"_29729":878,"_20626":51438,"_5":14148,"_27027":51214,"_2882":51439},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3396":965,"_29729":878,"_20626":51441,"_5":14148,"_27027":51214,"_2882":51442},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3396":966,"_29729":878,"_20626":51444,"_5":14148,"_27027":51214,"_2882":51445},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3396":967,"_29729":878,"_20626":51447,"_5":14148,"_27027":51214,"_2882":51448},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3396":968,"_29729":878,"_20626":51450,"_5":14148,"_27027":51214,"_2882":51451},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3396":969,"_29729":878,"_20626":51453,"_5":14148,"_27027":51214,"_2882":51454},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3396":970,"_29729":878,"_20626":51456,"_5":14148,"_27027":51214,"_2882":51457},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3396":971,"_29729":878,"_20626":51459,"_5":14148,"_27027":51218,"_2882":51460},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3396":972,"_29729":878,"_20626":51462,"_5":14148,"_27027":51222,"_2882":51463},[],"`settings.reenrollment_settings` field",{"_3396":973,"_29729":878,"_20626":51465,"_5":14148,"_27027":51222,"_2882":48819},[],{"_3396":974,"_29729":878,"_20626":51467,"_5":14148,"_27027":51222,"_2882":51468},[],"`reenrollment_delta`",{"_3396":975,"_29729":878,"_20626":51470,"_5":14148,"_27027":51222,"_2882":51471},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3396":976,"_29729":878,"_20626":51473,"_5":14148,"_27027":51222,"_2882":51474},[],"`preventive_delta`",{"_3396":977,"_29729":878,"_20626":51476,"_5":14148,"_27027":51222,"_2882":51477},[],"Preventive operational monitoring threshold.",{"_3396":978,"_29729":878,"_20626":51479,"_5":14148,"_27027":51222,"_2882":51480},[],"`critical_delta`",{"_3396":979,"_29729":878,"_20626":51482,"_5":14148,"_27027":51222,"_2882":51483},[],"Critical operational monitoring threshold.",{"_3396":980,"_29729":878,"_20626":51485,"_5":14148,"_27027":51222,"_2882":51486},[],"`enable_expired_renewal`",{"_3396":981,"_29729":878,"_20626":51488,"_5":14148,"_27027":51222,"_2882":51489},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3396":982,"_29729":878,"_20626":51491,"_5":14148,"_27027":51222,"_2882":51492},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3396":983,"_29729":878,"_20626":51494,"_5":14148,"_27027":51222,"_2882":51495},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3396":984,"_29729":878,"_20626":51497,"_5":14148,"_27027":51222,"_2882":51498},[],"`revoke_on_reenrollment`",{"_3396":985,"_29729":878,"_20626":51500,"_5":14148,"_27027":51222,"_2882":51501},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3396":986,"_29729":878,"_20626":51503,"_5":14148,"_27027":51222,"_2882":51504},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3396":987,"_29729":878,"_20626":51506,"_5":14148,"_27027":51226,"_2882":51507},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3396":988,"_29729":878,"_20626":51509,"_5":14148,"_27027":51230,"_2882":48813},[],{"_3396":989,"_29729":878,"_20626":51511,"_5":14148,"_27027":51230,"_2882":51512},[],"Published material",{"_3396":990,"_29729":878,"_20626":51514,"_5":14148,"_27027":51230,"_2882":51515},[],"**Include Lamassu System CA**",{"_3396":991,"_29729":878,"_20626":51517,"_5":14148,"_27027":51230,"_2882":51518},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3396":992,"_29729":878,"_20626":51520,"_5":14148,"_27027":51230,"_2882":51521},[],"**Include Enrollment CA**",{"_3396":993,"_29729":878,"_20626":51523,"_5":14148,"_27027":51230,"_2882":51524},[],"Selected issuing CA certificate.",{"_3396":994,"_29729":878,"_20626":51526,"_5":14148,"_27027":51230,"_2882":51527},[],"**Managed CAs**",{"_3396":995,"_29729":878,"_20626":51529,"_5":14148,"_27027":51230,"_2882":51530},[],"Explicitly selected CA certificates.",{"_3396":996,"_29729":878,"_20626":51532,"_5":14148,"_27027":51230,"_2882":51533},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3396":997,"_29729":878,"_20626":51535,"_5":14148,"_27027":51234,"_2882":51536},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3396":998,"_29729":878,"_20626":51538,"_5":14148,"_27027":51234,"_2882":51539},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3396":999,"_29729":878,"_20626":51541,"_5":14148,"_27027":51234,"_2882":51542},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3396":1000,"_29729":878,"_20626":51544,"_5":14148,"_27027":51238,"_2882":51545},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3396":1001,"_29729":1001,"_5":14500,"_2882":51547,"_30082":51548,"_20626":51549,"_27027":1001},"Integrate the EST client",[48429,49897,50908,50906,51089],[],{"_3396":1002,"_29729":1001,"_20626":51551,"_5":14148,"_27027":1001,"_2882":51552},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3396":1003,"_29729":1001,"_5":30079,"_20626":51554,"_27027":51555,"_2882":48439},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3396":1004,"_29729":1001,"_5":30079,"_20626":51557,"_27027":51558,"_2882":51559},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3396":1005,"_29729":1001,"_5":30079,"_20626":51561,"_27027":51562,"_2882":51563},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3396":1006,"_29729":1001,"_5":30079,"_20626":51565,"_27027":51566,"_2882":51567},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3396":1007,"_29729":1001,"_5":30079,"_20626":51569,"_27027":51570,"_2882":51571},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3396":1008,"_29729":1001,"_5":30079,"_20626":51573,"_27027":51574,"_2882":51575},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3396":1009,"_29729":1001,"_20626":51577,"_5":14148,"_27027":1001,"_2882":51578},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3396":1010,"_29729":1001,"_20626":51580,"_5":14148,"_27027":51555,"_2882":51581},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3396":1011,"_29729":1001,"_20626":51583,"_5":14148,"_27027":51555,"_2882":51584},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3396":1012,"_29729":1001,"_20626":51586,"_5":14148,"_27027":51555,"_2882":51587},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3396":1013,"_29729":1001,"_20626":51589,"_5":14148,"_27027":51558,"_2882":51590},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3396":1014,"_29729":1001,"_20626":51592,"_5":14148,"_27027":51558,"_2882":51593},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3396":1015,"_29729":1001,"_20626":51595,"_5":14148,"_27027":51562,"_2882":51596},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3396":1016,"_29729":1001,"_20626":51598,"_5":14148,"_27027":51562,"_2882":51599},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3396":1017,"_29729":1001,"_20626":51601,"_5":14148,"_27027":51566,"_2882":51602},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3396":1018,"_29729":1001,"_20626":51604,"_5":14148,"_27027":51566,"_2882":51605},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3396":1019,"_29729":1001,"_20626":51607,"_5":14148,"_27027":51570,"_2882":51608},[],"For a root that issues directly:",{"_3396":1020,"_29729":1001,"_20626":51610,"_5":14148,"_27027":51570,"_2882":51611},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3396":1021,"_29729":1001,"_20626":51613,"_5":14148,"_27027":51570,"_2882":51614},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3396":1022,"_29729":1001,"_20626":51616,"_5":14148,"_27027":51574,"_2882":51617},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3396":1023,"_29729":1023,"_5":14500,"_2882":51619,"_30082":51620,"_20626":51621,"_27027":1023},"EST reference",[48429,49897,50908,50906,51089],[],{"_3396":1024,"_29729":1023,"_20626":51623,"_5":14148,"_27027":1023,"_2882":51624},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3396":1025,"_29729":1023,"_5":30079,"_20626":51626,"_27027":51627,"_2882":51628},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3396":1026,"_29729":1023,"_5":30079,"_20626":51630,"_27027":51631,"_2882":22354},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3396":1027,"_29729":1023,"_5":30079,"_20626":51633,"_27027":51634,"_2882":25657},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3396":1028,"_29729":1023,"_5":30079,"_20626":51636,"_27027":51637,"_2882":25664},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3396":1029,"_29729":1023,"_5":30079,"_20626":51639,"_27027":51640,"_2882":24982},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3396":1030,"_29729":1023,"_5":30079,"_20626":51642,"_27027":51643,"_2882":51644},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3396":1031,"_29729":1023,"_5":30079,"_20626":51646,"_27027":51647,"_2882":51648},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3396":1032,"_29729":1023,"_5":30079,"_20626":51650,"_27027":51651,"_2882":51652},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3396":1033,"_29729":1023,"_20626":51654,"_5":14148,"_27027":1023,"_2882":51655},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3396":1034,"_29729":1023,"_20626":51657,"_5":14148,"_27027":51627,"_2882":51658},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3396":1035,"_29729":1023,"_20626":51660,"_5":14148,"_27027":51627,"_2882":51661},[],"Operation",{"_3396":1036,"_29729":1023,"_20626":51663,"_5":14148,"_27027":51627,"_2882":51664},[],"Method",{"_3396":1037,"_29729":1023,"_20626":51666,"_5":14148,"_27027":51627,"_2882":51667},[],"Authentication and condition",{"_3396":1038,"_29729":1023,"_20626":51669,"_5":14148,"_27027":51627,"_2882":51670},[],"`/cacerts`",{"_3396":1039,"_29729":1023,"_20626":51672,"_5":14148,"_27027":51627,"_2882":51673},[],"GET",{"_3396":1040,"_29729":1023,"_20626":51675,"_5":14148,"_27027":51627,"_2882":51676},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3396":1041,"_29729":1023,"_20626":51678,"_5":14148,"_27027":51627,"_2882":51679},[],"`/simpleenroll`",{"_3396":1042,"_29729":1023,"_20626":51681,"_5":14148,"_27027":51627,"_2882":51682},[],"POST",{"_3396":1043,"_29729":1023,"_20626":51684,"_5":14148,"_27027":51627,"_2882":51685},[],"Initial authentication and DMS registration/replacement policy.",{"_3396":1044,"_29729":1023,"_20626":51687,"_5":14148,"_27027":51627,"_2882":51688},[],"`/simplereenroll`",{"_3396":1045,"_29729":1023,"_20626":51690,"_5":14148,"_27027":51627,"_2882":51682},[],{"_3396":1046,"_29729":1023,"_20626":51692,"_5":14148,"_27027":51627,"_2882":51693},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3396":1047,"_29729":1023,"_20626":51695,"_5":14148,"_27027":51627,"_2882":51696},[],"`/serverkeygen`",{"_3396":1048,"_29729":1023,"_20626":51698,"_5":14148,"_27027":51627,"_2882":51682},[],{"_3396":1049,"_29729":1023,"_20626":51700,"_5":14148,"_27027":51627,"_2882":51701},[],"Initial authentication and admission; server generation enabled.",{"_3396":1050,"_29729":1023,"_20626":51703,"_5":14148,"_27027":51627,"_2882":51704},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3396":1051,"_29729":1023,"_20626":51706,"_5":14148,"_27027":51631,"_2882":51707},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3396":1052,"_29729":1023,"_20626":51709,"_5":14148,"_27027":51631,"_2882":51710},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3396":1053,"_29729":1023,"_20626":51712,"_5":14148,"_27027":51634,"_2882":51713},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3396":1054,"_29729":1023,"_20626":51715,"_5":14148,"_27027":51634,"_2882":51716},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3396":1055,"_29729":1023,"_20626":51718,"_5":14148,"_27027":51637,"_2882":51719},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3396":1056,"_29729":1023,"_20626":51721,"_5":14148,"_27027":51637,"_2882":51722},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3396":1057,"_29729":1023,"_20626":51724,"_5":14148,"_27027":51640,"_2882":51725},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3396":1058,"_29729":1023,"_20626":51727,"_5":14148,"_27027":51640,"_2882":51728},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3396":1059,"_29729":1023,"_20626":51730,"_5":14148,"_27027":51643,"_2882":51731},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3396":1060,"_29729":1023,"_20626":51733,"_5":14148,"_27027":51643,"_2882":51734},[],"Part",{"_3396":1061,"_29729":1023,"_20626":51736,"_5":14148,"_27027":51643,"_2882":51737},[],"Content after decoding its Base64",{"_3396":1062,"_29729":1023,"_20626":51739,"_5":14148,"_27027":51643,"_2882":51740},[],"`application/pkcs8`",{"_3396":1063,"_29729":1023,"_20626":51742,"_5":14148,"_27027":51643,"_2882":51743},[],"Unencrypted DER PKCS#8 private key.",{"_3396":1064,"_29729":1023,"_20626":51745,"_5":14148,"_27027":51643,"_2882":51746},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3396":1065,"_29729":1023,"_20626":51748,"_5":14148,"_27027":51643,"_2882":51749},[],"DER PKCS#7 containing the issued certificate.",{"_3396":1066,"_29729":1023,"_20626":51751,"_5":14148,"_27027":51643,"_2882":51752},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3396":1067,"_29729":1023,"_20626":51754,"_5":14148,"_27027":51647,"_2882":51755},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3396":1068,"_29729":1023,"_20626":51757,"_5":14148,"_27027":51647,"_2882":51758},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3396":1069,"_29729":1023,"_20626":51760,"_5":14148,"_27027":51647,"_2882":51761},[],"Convert and check the result:",{"_3396":1070,"_29729":1023,"_20626":51763,"_5":14148,"_27027":51647,"_2882":51764},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3396":1071,"_29729":1023,"_20626":51766,"_5":14148,"_27027":51651,"_2882":51767},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3396":1072,"_29729":1023,"_20626":51769,"_5":14148,"_27027":51651,"_2882":51770},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3396":1073,"_29729":1073,"_5":14500,"_2882":51089,"_30082":51772,"_20626":51773,"_27027":1073},[48429,49897,50908,50906,51089],[],{"_3396":1074,"_29729":1073,"_20626":51775,"_5":14148,"_27027":1073,"_2882":51776},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3396":1075,"_29729":1073,"_5":30079,"_20626":51778,"_27027":51779,"_2882":51780},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3396":1076,"_29729":1073,"_5":30079,"_20626":51782,"_27027":51783,"_2882":51784},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3396":1077,"_29729":1073,"_5":30079,"_20626":51786,"_27027":51787,"_2882":51788},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3396":1078,"_29729":1073,"_5":30079,"_20626":51790,"_27027":51791,"_2882":51792},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3396":1079,"_29729":1073,"_20626":51794,"_5":14148,"_27027":1073,"_2882":51795},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3396":1080,"_29729":1073,"_20626":51797,"_5":14148,"_27027":51779,"_2882":51798},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3396":1081,"_29729":1073,"_20626":51800,"_5":14148,"_27027":51779,"_2882":51801},[],"The integrator installs initial EST server trust and an admission credential.",{"_3396":1082,"_29729":1073,"_20626":51803,"_5":14148,"_27027":51779,"_2882":51804},[],"The client requests an identity for its `Device ID` through EST.",{"_3396":1083,"_29729":1073,"_20626":51806,"_5":14148,"_27027":51779,"_2882":51807},[],"Certificate, device binding and key/certificate installation are checked.",{"_3396":1084,"_29729":1073,"_20626":51809,"_5":14148,"_27027":51779,"_2882":51810},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3396":1085,"_29729":1073,"_20626":51812,"_5":14148,"_27027":51779,"_2882":51813},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3396":1086,"_29729":1073,"_20626":51815,"_5":14148,"_27027":51783,"_2882":51816},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3396":1087,"_29729":1073,"_20626":51818,"_5":14148,"_27027":51783,"_2882":51819},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3396":1088,"_29729":1073,"_20626":51821,"_5":14148,"_27027":51783,"_2882":51822},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3396":1089,"_29729":1073,"_20626":51824,"_5":14148,"_27027":51783,"_2882":51825},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3396":1090,"_29729":1073,"_20626":51827,"_5":14148,"_27027":51787,"_2882":51828},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3396":1091,"_29729":1073,"_20626":51830,"_5":14148,"_27027":51787,"_2882":51831},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3396":1092,"_29729":1073,"_20626":51833,"_5":14148,"_27027":51787,"_2882":51834},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3396":1093,"_29729":1073,"_20626":51836,"_5":14148,"_27027":51787,"_2882":51837},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3396":1094,"_29729":1073,"_20626":51839,"_5":14148,"_27027":51791,"_2882":51840},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3396":1095,"_29729":1073,"_20626":51842,"_5":14148,"_27027":51791,"_2882":51843},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3396":1096,"_29729":1096,"_5":14500,"_2882":51845,"_30082":51846,"_20626":51847,"_27027":1096},"Provisioning strategies",[48429,49897,50908,50906,51089],[],{"_3396":1097,"_29729":1096,"_20626":51849,"_5":14148,"_27027":1096,"_2882":51850},[],"Choose device registration, identity authorization and key generation.",{"_3396":1098,"_29729":1096,"_5":30079,"_20626":51852,"_27027":51853,"_2882":51854},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3396":1099,"_29729":1096,"_5":30079,"_20626":51856,"_27027":51857,"_2882":51858},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3396":1100,"_29729":1096,"_5":30079,"_20626":51860,"_27027":51861,"_2882":51862},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3396":1101,"_29729":1096,"_5":30079,"_20626":51864,"_27027":51865,"_2882":51866},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3396":1102,"_29729":1096,"_5":30079,"_20626":51868,"_27027":51869,"_2882":51870},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3396":1103,"_29729":1096,"_20626":51872,"_5":14148,"_27027":1096,"_2882":51873},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3396":1104,"_29729":1096,"_20626":51875,"_5":14148,"_27027":51853,"_2882":51876},[],"Path",{"_3396":1105,"_29729":1096,"_20626":51878,"_5":14148,"_27027":51853,"_2882":51879},[],"When the device exists",{"_3396":1106,"_29729":1096,"_20626":51881,"_5":14148,"_27027":51853,"_2882":51882},[],"What to check",{"_3396":1107,"_29729":1096,"_20626":51884,"_5":14148,"_27027":51853,"_2882":51885},[],"Manual assignment",{"_3396":1108,"_29729":1096,"_20626":51887,"_5":14148,"_27027":51853,"_2882":51888},[],"An operator creates it before associating a certificate.",{"_3396":1109,"_29729":1096,"_20626":51890,"_5":14148,"_27027":51853,"_2882":51891},[],"ID, owning DMS, certificate CN and bound serial.",{"_3396":1110,"_29729":1096,"_20626":51893,"_5":14148,"_27027":51853,"_2882":51894},[],"EST with `JITP`",{"_3396":1111,"_29729":1096,"_20626":51896,"_5":14148,"_27027":51853,"_2882":51897},[],"Created for an unknown CN during `/simpleenroll`.",{"_3396":1112,"_29729":1096,"_20626":51899,"_5":14148,"_27027":51853,"_2882":51900},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3396":1113,"_29729":1096,"_20626":51902,"_5":14148,"_27027":51853,"_2882":51903},[],"EST with `PRE_REGISTRATION`",{"_3396":1114,"_29729":1096,"_20626":51905,"_5":14148,"_27027":51853,"_2882":51906},[],"Must exist before `/simpleenroll`.",{"_3396":1115,"_29729":1096,"_20626":51908,"_5":14148,"_27027":51853,"_2882":51909},[],"Approved record, same DMS and replacement conditions for your version.",{"_3396":1116,"_29729":1096,"_20626":51911,"_5":14148,"_27027":51853,"_2882":51912},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3396":1117,"_29729":1096,"_20626":51914,"_5":14148,"_27027":51853,"_2882":51915},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3396":1118,"_29729":1096,"_20626":51917,"_5":14148,"_27027":51857,"_2882":51918},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3396":1119,"_29729":1096,"_20626":51920,"_5":14148,"_27027":51857,"_2882":51921},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3396":1120,"_29729":1096,"_20626":51923,"_5":14148,"_27027":51857,"_2882":51924},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3396":1121,"_29729":1096,"_20626":51926,"_5":14148,"_27027":51861,"_2882":51927},[],"Decide initial enrollment and re-enrollment separately:",{"_3396":1122,"_29729":1096,"_20626":51929,"_5":14148,"_27027":51861,"_2882":51930},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3396":1123,"_29729":1096,"_20626":51932,"_5":14148,"_27027":51861,"_2882":51933},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3396":1124,"_29729":1096,"_20626":51935,"_5":14148,"_27027":51861,"_2882":51936},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3396":1125,"_29729":1096,"_20626":51938,"_5":14148,"_27027":51861,"_2882":51939},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3396":1126,"_29729":1096,"_20626":51941,"_5":14148,"_27027":51861,"_2882":51942},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3396":1127,"_29729":1096,"_20626":51944,"_5":14148,"_27027":51865,"_2882":48813},[],{"_3396":1128,"_29729":1096,"_20626":51946,"_5":14148,"_27027":51865,"_2882":51947},[],"Material crossing EST",{"_3396":1129,"_29729":1096,"_20626":51949,"_5":14148,"_27027":51865,"_2882":51950},[],"Device-generated key",{"_3396":1130,"_29729":1096,"_20626":51952,"_5":14148,"_27027":51865,"_2882":51953},[],"Public CSR and certificate; the key stays on the client.",{"_3396":1131,"_29729":1096,"_20626":51955,"_5":14148,"_27027":51865,"_2882":51956},[],"Existing device key",{"_3396":1132,"_29729":1096,"_20626":51958,"_5":14148,"_27027":51865,"_2882":51959},[],"CSR signed with that key and a new certificate.",{"_3396":1133,"_29729":1096,"_20626":51961,"_5":14148,"_27027":51865,"_2882":51227},[],{"_3396":1134,"_29729":1096,"_20626":51963,"_5":14148,"_27027":51865,"_2882":51964},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3396":1135,"_29729":1096,"_20626":51966,"_5":14148,"_27027":51865,"_2882":51967},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3396":1136,"_29729":1096,"_20626":51969,"_5":14148,"_27027":51869,"_2882":51970},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3396":1137,"_29729":1137,"_5":14500,"_2882":51972,"_30082":51973,"_20626":51974,"_27027":1137},"Renewal and recovery",[48429,49897,50908,50906,51089],[],{"_3396":1138,"_29729":1137,"_20626":51976,"_5":14148,"_27027":1137,"_2882":51977},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3396":1139,"_29729":1137,"_5":30079,"_20626":51979,"_27027":51980,"_2882":51981},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3396":1140,"_29729":1137,"_5":30079,"_20626":51983,"_27027":51984,"_2882":51985},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3396":1141,"_29729":1137,"_5":30079,"_20626":51987,"_27027":51988,"_2882":51989},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3396":1142,"_29729":1137,"_5":30079,"_20626":51991,"_27027":51992,"_2882":51993},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3396":1143,"_29729":1137,"_5":30079,"_20626":51995,"_27027":51996,"_2882":51997},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3396":1144,"_29729":1137,"_20626":51999,"_5":14148,"_27027":1137,"_2882":52000},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3396":1145,"_29729":1137,"_20626":52002,"_5":14148,"_27027":51980,"_2882":52003},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3396":1146,"_29729":1137,"_20626":52005,"_5":14148,"_27027":51980,"_2882":52006},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3396":1147,"_29729":1137,"_20626":52008,"_5":14148,"_27027":51980,"_2882":52009},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3396":1148,"_29729":1137,"_20626":52011,"_5":14148,"_27027":51980,"_2882":52012},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3396":1149,"_29729":1137,"_20626":52014,"_5":14148,"_27027":51984,"_2882":52015},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3396":1150,"_29729":1137,"_20626":52017,"_5":14148,"_27027":51984,"_2882":52018},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3396":1151,"_29729":1137,"_20626":52020,"_5":14148,"_27027":51988,"_2882":52021},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3396":1152,"_29729":1137,"_20626":52023,"_5":14148,"_27027":51988,"_2882":52024},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3396":1153,"_29729":1137,"_20626":52026,"_5":14148,"_27027":51988,"_2882":52027},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3396":1154,"_29729":1137,"_20626":52029,"_5":14148,"_27027":51992,"_2882":52030},[],"Situation",{"_3396":1155,"_29729":1137,"_20626":52032,"_5":14148,"_27027":51992,"_2882":52033},[],"Procedure",{"_3396":1156,"_29729":1137,"_20626":52035,"_5":14148,"_27027":51992,"_2882":52036},[],"Valid certificate, outside the window",{"_3396":1157,"_29729":1137,"_20626":52038,"_5":14148,"_27027":51992,"_2882":52039},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3396":1158,"_29729":1137,"_20626":52041,"_5":14148,"_27027":51992,"_2882":52042},[],"Expired certificate, key available",{"_3396":1159,"_29729":1137,"_20626":52044,"_5":14148,"_27027":51992,"_2882":52045},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3396":1160,"_29729":1137,"_20626":52047,"_5":14148,"_27027":51992,"_2882":52048},[],"Renewal through webhook or `NO_AUTH`",{"_3396":1161,"_29729":1137,"_20626":52050,"_5":14148,"_27027":51992,"_2882":52051},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3396":1162,"_29729":1137,"_20626":52053,"_5":14148,"_27027":51992,"_2882":52054},[],"Lost or inaccessible key",{"_3396":1163,"_29729":1137,"_20626":52056,"_5":14148,"_27027":51992,"_2882":52057},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3396":1164,"_29729":1137,"_20626":52059,"_5":14148,"_27027":51992,"_2882":52060},[],"Current identity revoked",{"_3396":1165,"_29729":1137,"_20626":52062,"_5":14148,"_27027":51992,"_2882":52063},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3396":1166,"_29729":1137,"_20626":52065,"_5":14148,"_27027":51992,"_2882":52066},[],"Device without an identity",{"_3396":1167,"_29729":1137,"_20626":52068,"_5":14148,"_27027":51992,"_2882":52069},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3396":1168,"_29729":1137,"_20626":52071,"_5":14148,"_27027":51992,"_2882":52072},[],"Retired device",{"_3396":1169,"_29729":1137,"_20626":52074,"_5":14148,"_27027":51992,"_2882":52075},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3396":1170,"_29729":1137,"_20626":52077,"_5":14148,"_27027":51992,"_2882":52078},[],"Timeout, HTTP 500 or installation failure",{"_3396":1171,"_29729":1137,"_20626":52080,"_5":14148,"_27027":51992,"_2882":52081},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3396":1172,"_29729":1137,"_20626":52083,"_5":14148,"_27027":51996,"_2882":52084},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3396":1173,"_29729":1137,"_20626":52086,"_5":14148,"_27027":51996,"_2882":52087},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3396":1174,"_29729":1174,"_5":14500,"_2882":52089,"_30082":52090,"_20626":52091,"_27027":1174},"Enrollment troubleshooting",[48429,49897,50908,50906,51089],[],{"_3396":1175,"_29729":1174,"_20626":52093,"_5":14148,"_27027":1174,"_2882":52094},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3396":1176,"_29729":1174,"_5":30079,"_20626":52096,"_27027":52097,"_2882":52098},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3396":1177,"_29729":1174,"_5":30079,"_20626":52100,"_27027":52101,"_2882":52102},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3396":1178,"_29729":1174,"_5":30079,"_20626":52104,"_27027":52105,"_2882":51652},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3396":1179,"_29729":1174,"_5":30079,"_20626":52107,"_27027":52108,"_2882":52109},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3396":1180,"_29729":1174,"_20626":52111,"_5":14148,"_27027":1174,"_2882":52112},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3396":1181,"_29729":1174,"_20626":52114,"_5":14148,"_27027":52101,"_2882":52115},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3396":1182,"_29729":1174,"_20626":52117,"_5":14148,"_27027":52101,"_2882":52118},[],"Symptom or message",{"_3396":1183,"_29729":1174,"_20626":52120,"_5":14148,"_27027":52101,"_2882":51882},[],{"_3396":1184,"_29729":1174,"_20626":52122,"_5":14148,"_27027":52101,"_2882":52123},[],"curl rejects TLS, name or issuer",{"_3396":1185,"_29729":1174,"_20626":52125,"_5":14148,"_27027":52101,"_2882":52126},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3396":1186,"_29729":1174,"_20626":52128,"_5":14148,"_27027":52101,"_2882":52129},[],"404 or missing APS",{"_3396":1187,"_29729":1174,"_20626":52131,"_5":14148,"_27027":52101,"_2882":52132},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3396":1188,"_29729":1174,"_20626":52134,"_5":14148,"_27027":52101,"_2882":52135},[],"400, CSR or format error",{"_3396":1189,"_29729":1174,"_20626":52137,"_5":14148,"_27027":52101,"_2882":52138},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3396":1190,"_29729":1174,"_20626":52140,"_5":14148,"_27027":52101,"_2882":52141},[],"Missing credential or invalid certificate",{"_3396":1191,"_29729":1174,"_20626":52143,"_5":14148,"_27027":52101,"_2882":52144},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3396":1192,"_29729":1174,"_20626":52146,"_5":14148,"_27027":52101,"_2882":52147},[],"Webhook denies, times out or responds without authorization",{"_3396":1193,"_29729":1174,"_20626":52149,"_5":14148,"_27027":52101,"_2882":52150},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3396":1194,"_29729":1174,"_20626":52152,"_5":14148,"_27027":52101,"_2882":52153},[],"`unexpected status code: <n>: redirects are not followed`",{"_3396":1195,"_29729":1174,"_20626":52155,"_5":14148,"_27027":52101,"_2882":52156},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3396":1196,"_29729":1174,"_20626":52158,"_5":14148,"_27027":52101,"_2882":52159},[],"`webhook response exceeds 1048576 bytes`",{"_3396":1197,"_29729":1174,"_20626":52161,"_5":14148,"_27027":52101,"_2882":52162},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3396":1198,"_29729":1174,"_20626":52164,"_5":14148,"_27027":52101,"_2882":52165},[],"`webhook config must not reference files`",{"_3396":1199,"_29729":1174,"_20626":52167,"_5":14148,"_27027":52101,"_2882":52168},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3396":1200,"_29729":1174,"_20626":52170,"_5":14148,"_27027":52101,"_2882":52171},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3396":1201,"_29729":1174,"_20626":52173,"_5":14148,"_27027":52101,"_2882":52174},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3396":1202,"_29729":1174,"_20626":52176,"_5":14148,"_27027":52101,"_2882":52177},[],"`webhook mTLS certificate and key are invalid: …`",{"_3396":1203,"_29729":1174,"_20626":52179,"_5":14148,"_27027":52101,"_2882":52180},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3396":1204,"_29729":1174,"_20626":52182,"_5":14148,"_27027":52101,"_2882":52183},[],"400 `struct validation error` creating or updating a DMS",{"_3396":1205,"_29729":1174,"_20626":52185,"_5":14148,"_27027":52101,"_2882":52186},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3396":1206,"_29729":1174,"_20626":52188,"_5":14148,"_27027":52101,"_2882":52189},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3396":1207,"_29729":1174,"_20626":52191,"_5":14148,"_27027":52101,"_2882":52192},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3396":1208,"_29729":1174,"_20626":52194,"_5":14148,"_27027":52101,"_2882":52195},[],"`device not preregistered`",{"_3396":1209,"_29729":1174,"_20626":52197,"_5":14148,"_27027":52101,"_2882":52198},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3396":1210,"_29729":1174,"_20626":52200,"_5":14148,"_27027":52101,"_2882":52201},[],"`forbiddenNewEnrollment`",{"_3396":1211,"_29729":1174,"_20626":52203,"_5":14148,"_27027":52101,"_2882":52204},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3396":1212,"_29729":1174,"_20626":52206,"_5":14148,"_27027":52101,"_2882":52207},[],"Different owning DMS",{"_3396":1213,"_29729":1174,"_20626":52209,"_5":14148,"_27027":52101,"_2882":52210},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3396":1214,"_29729":1174,"_20626":52212,"_5":14148,"_27027":52101,"_2882":52213},[],"`invalid RawSubject bytes`",{"_3396":1215,"_29729":1174,"_20626":52215,"_5":14148,"_27027":52101,"_2882":52216},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3396":1216,"_29729":1174,"_20626":52218,"_5":14148,"_27027":52101,"_2882":52219},[],"`invalid reenroll window`",{"_3396":1217,"_29729":1174,"_20626":52221,"_5":14148,"_27027":52101,"_2882":52222},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3396":1218,"_29729":1174,"_20626":52224,"_5":14148,"_27027":52101,"_2882":52225},[],"Current certificate revoked",{"_3396":1219,"_29729":1174,"_20626":52227,"_5":14148,"_27027":52101,"_2882":52228},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3396":1220,"_29729":1174,"_20626":52230,"_5":14148,"_27027":52101,"_2882":52231},[],"CA, profile or signing error",{"_3396":1221,"_29729":1174,"_20626":52233,"_5":14148,"_27027":52101,"_2882":52234},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3396":1222,"_29729":1174,"_20626":52236,"_5":14148,"_27027":52101,"_2882":52237},[],"HTTP 200 without a device connection",{"_3396":1223,"_29729":1174,"_20626":52239,"_5":14148,"_27027":52101,"_2882":52240},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3396":1224,"_29729":1174,"_20626":52242,"_5":14148,"_27027":52101,"_2882":52243},[],"Timeout or error after issuance",{"_3396":1225,"_29729":1174,"_20626":52245,"_5":14148,"_27027":52101,"_2882":52246},[],"New certificates, current slot and previous identity's state before retrying.",{"_3396":1226,"_29729":1174,"_20626":52248,"_5":14148,"_27027":52105,"_2882":52249},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3396":1227,"_29729":1174,"_20626":52251,"_5":14148,"_27027":52105,"_2882":52252},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3396":1228,"_29729":1174,"_20626":52254,"_5":14148,"_27027":52108,"_2882":52255},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3396":1229,"_29729":1174,"_20626":52257,"_5":14148,"_27027":52108,"_2882":52258},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3396":1230,"_29729":1174,"_20626":52260,"_5":14148,"_27027":52108,"_2882":52261},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3396":1231,"_29729":1174,"_20626":52263,"_5":14148,"_27027":52108,"_2882":52264},[],"Make one request, save headers/body and query the device and certificates.",{"_3396":1232,"_29729":1174,"_20626":52266,"_5":14148,"_27027":52108,"_2882":52267},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3396":1233,"_29729":1174,"_20626":52269,"_5":14148,"_27027":52108,"_2882":52270},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3396":1234,"_29729":1174,"_20626":52272,"_5":14148,"_27027":52108,"_2882":52273},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3396":1235,"_29729":1235,"_5":14500,"_2882":52275,"_30082":52276,"_20626":52277,"_27027":1235},"Trust distribution and updates",[48429,49897,50908,50906,51089],[],{"_3396":1236,"_29729":1235,"_20626":52279,"_5":14148,"_27027":1235,"_2882":52280},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3396":1237,"_29729":1235,"_5":30079,"_20626":52282,"_27027":52283,"_2882":52284},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3396":1238,"_29729":1235,"_5":30079,"_20626":52286,"_27027":52287,"_2882":52288},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3396":1239,"_29729":1235,"_5":30079,"_20626":52290,"_27027":52291,"_2882":52292},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3396":1240,"_29729":1235,"_5":30079,"_20626":52294,"_27027":52295,"_2882":52296},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3396":1241,"_29729":1235,"_5":30079,"_20626":52298,"_27027":52299,"_2882":52300},[],"/docs/pr-preview/pr-57/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3396":1242,"_29729":1235,"_20626":52302,"_5":14148,"_27027":1235,"_2882":52303},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3396":1243,"_29729":1235,"_20626":52305,"_5":14148,"_27027":52283,"_2882":52306},[],"Relationship",{"_3396":1244,"_29729":1235,"_20626":52308,"_5":14148,"_27027":52283,"_2882":52309},[],"Material prepared by its owner",{"_3396":1245,"_29729":1235,"_20626":52311,"_5":14148,"_27027":52283,"_2882":52312},[],"Device → EST server",{"_3396":1246,"_29729":1235,"_20626":52314,"_5":14148,"_27027":52283,"_2882":52315},[],"Previously verified server root, chain or pin and TLS name.",{"_3396":1247,"_29729":1235,"_20626":52317,"_5":14148,"_27027":52283,"_2882":52318},[],"DMS → requester",{"_3396":1248,"_29729":1235,"_20626":52320,"_5":14148,"_27027":52283,"_2882":52321},[],"CAs and rules authorizing initial or renewal credentials.",{"_3396":1249,"_29729":1235,"_20626":52323,"_5":14148,"_27027":52283,"_2882":52324},[],"Consumer → device",{"_3396":1250,"_29729":1235,"_20626":52326,"_5":14148,"_27027":52283,"_2882":52327},[],"Operational identity roots, intermediates, validation and permissions.",{"_3396":1251,"_29729":1235,"_20626":52329,"_5":14148,"_27027":52283,"_2882":52330},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3396":1252,"_29729":1235,"_20626":52332,"_5":14148,"_27027":52287,"_2882":52333},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3396":1253,"_29729":1235,"_20626":52335,"_5":14148,"_27027":52287,"_2882":52336},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3396":1254,"_29729":1235,"_20626":52338,"_5":14148,"_27027":52291,"_2882":52339},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3396":1255,"_29729":1235,"_20626":52341,"_5":14148,"_27027":52291,"_2882":52342},[],"Select policy-approved roots as anchors.",{"_3396":1256,"_29729":1235,"_20626":52344,"_5":14148,"_27027":52291,"_2882":52345},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3396":1257,"_29729":1235,"_20626":52347,"_5":14148,"_27027":52291,"_2882":52348},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3396":1258,"_29729":1235,"_20626":52350,"_5":14148,"_27027":52291,"_2882":52351},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3396":1259,"_29729":1235,"_20626":52353,"_5":14148,"_27027":52291,"_2882":52354},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3396":1260,"_29729":1235,"_20626":52356,"_5":14148,"_27027":52295,"_2882":52357},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3396":1261,"_29729":1235,"_20626":52359,"_5":14148,"_27027":52295,"_2882":52360},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3396":1262,"_29729":1235,"_20626":52362,"_5":14148,"_27027":52295,"_2882":52363},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3396":1263,"_29729":1235,"_20626":52365,"_5":14148,"_27027":52299,"_2882":52366},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3396":1264,"_29729":1264,"_5":14500,"_2882":52368,"_30082":52369,"_20626":52371,"_27027":1264},"AWS IoT Core",[48429,49897,50908,50906,52370],"Integrations",[],{"_3396":1265,"_29729":1264,"_20626":52373,"_5":14148,"_27027":1264,"_2882":52374},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3396":1266,"_29729":1264,"_5":30079,"_20626":52376,"_27027":52377,"_2882":52378},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3396":1267,"_29729":1264,"_5":30079,"_20626":52380,"_27027":52381,"_2882":52382},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3396":1268,"_29729":1264,"_5":30079,"_20626":52384,"_27027":52385,"_2882":52386},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3396":1269,"_29729":1264,"_5":30079,"_20626":52388,"_27027":52389,"_2882":52390},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3396":1270,"_29729":1264,"_5":30079,"_20626":52392,"_27027":52393,"_2882":52394},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3396":1271,"_29729":1264,"_5":30079,"_20626":52396,"_27027":52397,"_2882":52398},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3396":1272,"_29729":1264,"_5":30079,"_20626":52400,"_27027":52401,"_2882":52402},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3396":1273,"_29729":1264,"_5":30079,"_20626":52404,"_27027":52405,"_2882":52406},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3396":1274,"_29729":1264,"_5":30079,"_20626":52408,"_27027":52409,"_2882":52410},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3396":1275,"_29729":1264,"_5":30079,"_20626":52412,"_27027":52413,"_2882":52414},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3396":1276,"_29729":1264,"_5":30079,"_20626":52416,"_27027":52417,"_2882":52418},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3396":1277,"_29729":1264,"_5":30079,"_20626":52420,"_27027":52421,"_2882":52422},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3396":1278,"_29729":1264,"_5":30079,"_20626":52424,"_27027":52425,"_2882":52426},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3396":1279,"_29729":1264,"_5":30079,"_20626":52428,"_27027":52429,"_2882":52430},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3396":1280,"_29729":1264,"_5":30079,"_20626":52432,"_27027":52433,"_2882":52434},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3396":1281,"_29729":1264,"_5":30079,"_20626":52436,"_27027":52437,"_2882":52438},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3396":1282,"_29729":1264,"_5":30079,"_20626":52440,"_27027":52441,"_2882":52442},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3396":1283,"_29729":1264,"_5":30079,"_20626":52444,"_27027":52445,"_2882":52446},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3396":1284,"_29729":1264,"_5":30079,"_20626":52448,"_27027":52449,"_2882":52450},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3396":1285,"_29729":1264,"_5":30079,"_20626":52452,"_27027":52453,"_2882":52454},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3396":1286,"_29729":1264,"_5":30079,"_20626":52456,"_27027":52457,"_2882":52458},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3396":1287,"_29729":1264,"_5":30079,"_20626":52460,"_27027":52461,"_2882":52462},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3396":1288,"_29729":1264,"_5":30079,"_20626":52464,"_27027":52465,"_2882":52466},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3396":1289,"_29729":1264,"_5":30079,"_20626":52468,"_27027":52469,"_2882":52470},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3396":1290,"_29729":1264,"_5":30079,"_20626":52472,"_27027":52473,"_2882":52474},[],"/docs/pr-preview/pr-57/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3396":1291,"_29729":1264,"_20626":52476,"_5":14148,"_27027":1264,"_2882":52477},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3396":1292,"_29729":1264,"_20626":52479,"_5":14148,"_27027":1264,"_2882":52480},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3396":1293,"_29729":1264,"_20626":52482,"_5":14148,"_27027":1264,"_2882":52483},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3396":1294,"_29729":1264,"_20626":52485,"_5":14148,"_27027":52377,"_2882":52486},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3396":1295,"_29729":1264,"_20626":52488,"_5":14148,"_27027":52377,"_2882":52489},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3396":1296,"_29729":1264,"_20626":52491,"_5":14148,"_27027":52377,"_2882":52492},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3396":1297,"_29729":1264,"_20626":52494,"_5":14148,"_27027":52377,"_2882":52495},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3396":1298,"_29729":1264,"_20626":52497,"_5":14148,"_27027":52381,"_2882":52498},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3396":1299,"_29729":1264,"_20626":52500,"_5":14148,"_27027":52385,"_2882":52501},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3396":1300,"_29729":1264,"_20626":52503,"_5":14148,"_27027":52385,"_2882":52504},[],"IAM action",{"_3396":1301,"_29729":1264,"_20626":52506,"_5":14148,"_27027":52385,"_2882":48819},[],{"_3396":1302,"_29729":1264,"_20626":52508,"_5":14148,"_27027":52385,"_2882":52509},[],"`iot:GetRegistrationCode`",{"_3396":1303,"_29729":1264,"_20626":52511,"_5":14148,"_27027":52385,"_2882":52512},[],"Obtain the verification code for CA registration in the Primary Account",{"_3396":1304,"_29729":1264,"_20626":52514,"_5":14148,"_27027":52385,"_2882":52515},[],"`iot:RegisterCACertificate`",{"_3396":1305,"_29729":1264,"_20626":52517,"_5":14148,"_27027":52385,"_2882":52518},[],"Register the CA in AWS IoT",{"_3396":1306,"_29729":1264,"_20626":52520,"_5":14148,"_27027":52385,"_2882":52521},[],"`iot:DescribeCACertificate`",{"_3396":1307,"_29729":1264,"_20626":52523,"_5":14148,"_27027":52385,"_2882":52524},[],"Check the CA registration status",{"_3396":1308,"_29729":1264,"_20626":52526,"_5":14148,"_27027":52385,"_2882":52527},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3396":1309,"_29729":1264,"_20626":52529,"_5":14148,"_27027":52385,"_2882":52530},[],"Create or update Things in IoT Core",{"_3396":1310,"_29729":1264,"_20626":52532,"_5":14148,"_27027":52385,"_2882":52533},[],"`iot:RegisterThing`",{"_3396":1311,"_29729":1264,"_20626":52535,"_5":14148,"_27027":52385,"_2882":52536},[],"Provision Things through a template",{"_3396":1312,"_29729":1264,"_20626":52538,"_5":14148,"_27027":52385,"_2882":52539},[],"`iot:RegisterCertificate`",{"_3396":1313,"_29729":1264,"_20626":52541,"_5":14148,"_27027":52385,"_2882":52542},[],"Register device certificates",{"_3396":1314,"_29729":1264,"_20626":52544,"_5":14148,"_27027":52385,"_2882":52545},[],"`iot:UpdateCertificate`",{"_3396":1315,"_29729":1264,"_20626":52547,"_5":14148,"_27027":52385,"_2882":52548},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3396":1316,"_29729":1264,"_20626":52550,"_5":14148,"_27027":52385,"_2882":52551},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3396":1317,"_29729":1264,"_20626":52553,"_5":14148,"_27027":52385,"_2882":52554},[],"Create and attach IoT policies",{"_3396":1318,"_29729":1264,"_20626":52556,"_5":14148,"_27027":52385,"_2882":52557},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3396":1319,"_29729":1264,"_20626":52559,"_5":14148,"_27027":52385,"_2882":52560},[],"Manage Thing groups",{"_3396":1320,"_29729":1264,"_20626":52562,"_5":14148,"_27027":52385,"_2882":52563},[],"`iot:CreateProvisioningTemplate`",{"_3396":1321,"_29729":1264,"_20626":52565,"_5":14148,"_27027":52385,"_2882":52566},[],"Create JITP templates",{"_3396":1322,"_29729":1264,"_20626":52568,"_5":14148,"_27027":52385,"_2882":52569},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3396":1323,"_29729":1264,"_20626":52571,"_5":14148,"_27027":52385,"_2882":52572},[],"Read and write the Device Shadow",{"_3396":1324,"_29729":1264,"_20626":52574,"_5":14148,"_27027":52385,"_2882":52575},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3396":1325,"_29729":1264,"_20626":52577,"_5":14148,"_27027":52389,"_2882":52578},[],"Parameter",{"_3396":1326,"_29729":1264,"_20626":52580,"_5":14148,"_27027":52389,"_2882":52581},[],"Type",{"_3396":1327,"_29729":1264,"_20626":52583,"_5":14148,"_27027":52389,"_2882":52584},[],"Required",{"_3396":1328,"_29729":1264,"_20626":52586,"_5":14148,"_27027":52389,"_2882":52587},[],"Description",{"_3396":1329,"_29729":1264,"_20626":52589,"_5":14148,"_27027":52389,"_2882":52590},[],"`connector_id`",{"_3396":1330,"_29729":1264,"_20626":52592,"_5":14148,"_27027":52389,"_2882":24632},[],{"_3396":1331,"_29729":1264,"_20626":52594,"_5":14148,"_27027":52389,"_2882":52595},[],"Yes",{"_3396":1332,"_29729":1264,"_20626":52597,"_5":14148,"_27027":52389,"_2882":52598},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3396":1333,"_29729":1264,"_20626":52600,"_5":14148,"_27027":52389,"_2882":52601},[],"`aws_config.region`",{"_3396":1334,"_29729":1264,"_20626":52603,"_5":14148,"_27027":52389,"_2882":24632},[],{"_3396":1335,"_29729":1264,"_20626":52605,"_5":14148,"_27027":52389,"_2882":52595},[],{"_3396":1336,"_29729":1264,"_20626":52607,"_5":14148,"_27027":52389,"_2882":52608},[],"AWS region where the connector operates.",{"_3396":1337,"_29729":1264,"_20626":52610,"_5":14148,"_27027":52389,"_2882":52611},[],"`aws_config.auth_method`",{"_3396":1338,"_29729":1264,"_20626":52613,"_5":14148,"_27027":52389,"_2882":24632},[],{"_3396":1339,"_29729":1264,"_20626":52615,"_5":14148,"_27027":52389,"_2882":52595},[],{"_3396":1340,"_29729":1264,"_20626":52617,"_5":14148,"_27027":52389,"_2882":52618},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3396":1341,"_29729":1264,"_20626":52620,"_5":14148,"_27027":52389,"_2882":52621},[],"`aws_config.access_key_id`",{"_3396":1342,"_29729":1264,"_20626":52623,"_5":14148,"_27027":52389,"_2882":24632},[],{"_3396":1343,"_29729":1264,"_20626":52625,"_5":14148,"_27027":52389,"_2882":52626},[],"Only with `auth_method=static`",{"_3396":1344,"_29729":1264,"_20626":52628,"_5":14148,"_27027":52389,"_2882":52629},[],"AWS access key.",{"_3396":1345,"_29729":1264,"_20626":52631,"_5":14148,"_27027":52389,"_2882":52632},[],"`aws_config.secret_access_key`",{"_3396":1346,"_29729":1264,"_20626":52634,"_5":14148,"_27027":52389,"_2882":24632},[],{"_3396":1347,"_29729":1264,"_20626":52636,"_5":14148,"_27027":52389,"_2882":52626},[],{"_3396":1348,"_29729":1264,"_20626":52638,"_5":14148,"_27027":52389,"_2882":52639},[],"AWS secret key.",{"_3396":1349,"_29729":1264,"_20626":52641,"_5":14148,"_27027":52389,"_2882":52642},[],"`aws_config.session_token`",{"_3396":1350,"_29729":1264,"_20626":52644,"_5":14148,"_27027":52389,"_2882":24632},[],{"_3396":1351,"_29729":1264,"_20626":52646,"_5":14148,"_27027":52389,"_2882":52647},[],"No",{"_3396":1352,"_29729":1264,"_20626":52649,"_5":14148,"_27027":52389,"_2882":52650},[],"Session token (with `auth_method=static`).",{"_3396":1353,"_29729":1264,"_20626":52652,"_5":14148,"_27027":52389,"_2882":52653},[],"`aws_config.role_arn`",{"_3396":1354,"_29729":1264,"_20626":52655,"_5":14148,"_27027":52389,"_2882":24632},[],{"_3396":1355,"_29729":1264,"_20626":52657,"_5":14148,"_27027":52389,"_2882":52658},[],"Only with `auth_method=role`",{"_3396":1356,"_29729":1264,"_20626":52660,"_5":14148,"_27027":52389,"_2882":52661},[],"ARN of the role to assume.",{"_3396":1357,"_29729":1264,"_20626":52663,"_5":14148,"_27027":52389,"_2882":52664},[],"`aws_config.endpoint_url`",{"_3396":1358,"_29729":1264,"_20626":52666,"_5":14148,"_27027":52389,"_2882":24632},[],{"_3396":1359,"_29729":1264,"_20626":52668,"_5":14148,"_27027":52389,"_2882":52647},[],{"_3396":1360,"_29729":1264,"_20626":52670,"_5":14148,"_27027":52389,"_2882":52671},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3396":1361,"_29729":1264,"_20626":52673,"_5":14148,"_27027":52389,"_2882":52674},[],"`subscriber_event_bus`",{"_3396":1362,"_29729":1264,"_20626":52676,"_5":14148,"_27027":52389,"_2882":17344},[],{"_3396":1363,"_29729":1264,"_20626":52678,"_5":14148,"_27027":52389,"_2882":52595},[],{"_3396":1364,"_29729":1264,"_20626":52680,"_5":14148,"_27027":52389,"_2882":52681},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3396":1365,"_29729":1264,"_20626":52683,"_5":14148,"_27027":52389,"_2882":52684},[],"`dms_manager_client`",{"_3396":1366,"_29729":1264,"_20626":52686,"_5":14148,"_27027":52389,"_2882":24632},[],{"_3396":1367,"_29729":1264,"_20626":52688,"_5":14148,"_27027":52389,"_2882":52595},[],{"_3396":1368,"_29729":1264,"_20626":52690,"_5":14148,"_27027":52389,"_2882":52691},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3396":1369,"_29729":1264,"_20626":52693,"_5":14148,"_27027":52389,"_2882":52694},[],"`device_manager_client`",{"_3396":1370,"_29729":1264,"_20626":52696,"_5":14148,"_27027":52389,"_2882":24632},[],{"_3396":1371,"_29729":1264,"_20626":52698,"_5":14148,"_27027":52389,"_2882":52595},[],{"_3396":1372,"_29729":1264,"_20626":52700,"_5":14148,"_27027":52389,"_2882":52701},[],"HTTP URL of Lamassu's Device Manager.",{"_3396":1373,"_29729":1264,"_20626":52703,"_5":14148,"_27027":52389,"_2882":52704},[],"`ca_client`",{"_3396":1374,"_29729":1264,"_20626":52706,"_5":14148,"_27027":52389,"_2882":24632},[],{"_3396":1375,"_29729":1264,"_20626":52708,"_5":14148,"_27027":52389,"_2882":52595},[],{"_3396":1376,"_29729":1264,"_20626":52710,"_5":14148,"_27027":52389,"_2882":52711},[],"HTTP URL of Lamassu's CA service.",{"_3396":1377,"_29729":1264,"_20626":52713,"_5":14148,"_27027":52393,"_2882":52714},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3396":1378,"_29729":1264,"_20626":52716,"_5":14148,"_27027":52393,"_2882":52717},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3396":1379,"_29729":1264,"_20626":52719,"_5":14148,"_27027":52393,"_2882":52720},[],"CloudEvent type",{"_3396":1380,"_29729":1264,"_20626":52722,"_5":14148,"_27027":52393,"_2882":52723},[],"Lamassu resource",{"_3396":1381,"_29729":1264,"_20626":52725,"_5":14148,"_27027":52393,"_2882":52726},[],"AWS Resource",{"_3396":1382,"_29729":1264,"_20626":52728,"_5":14148,"_27027":52393,"_2882":52729},[],"IAM actions",{"_3396":1383,"_29729":1264,"_20626":52731,"_5":14148,"_27027":52393,"_2882":52732},[],"AWS calls and effect",{"_3396":1384,"_29729":1264,"_20626":52734,"_5":14148,"_27027":52393,"_2882":52735},[],"Where in this page",{"_3396":1385,"_29729":1264,"_20626":52737,"_5":14148,"_27027":52393,"_2882":52738},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3396":1386,"_29729":1264,"_20626":52740,"_5":14148,"_27027":52393,"_2882":52741},[],"CA",{"_3396":1387,"_29729":1264,"_20626":52743,"_5":14148,"_27027":52393,"_2882":52744},[],"`IoTCore/CACertificate`",{"_3396":1388,"_29729":1264,"_20626":52746,"_5":14148,"_27027":52393,"_2882":52747},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3396":1389,"_29729":1264,"_20626":52749,"_5":14148,"_27027":52393,"_2882":52750},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3396":1390,"_29729":1264,"_20626":52752,"_5":14148,"_27027":52393,"_2882":52406},[],{"_3396":1391,"_29729":1264,"_20626":52754,"_5":14148,"_27027":52393,"_2882":52755},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3396":1392,"_29729":1264,"_20626":52757,"_5":14148,"_27027":52393,"_2882":52758},[],"DMS",{"_3396":1393,"_29729":1264,"_20626":52760,"_5":14148,"_27027":52393,"_2882":52761},[],"`IoTCore/ProvisioningTemplate`",{"_3396":1394,"_29729":1264,"_20626":52763,"_5":14148,"_27027":52393,"_2882":52764},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3396":1395,"_29729":1264,"_20626":52766,"_5":14148,"_27027":52393,"_2882":52767},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3396":1396,"_29729":1264,"_20626":52769,"_5":14148,"_27027":52393,"_2882":52434},[],{"_3396":1397,"_29729":1264,"_20626":52771,"_5":14148,"_27027":52393,"_2882":52772},[],"`EventBindDeviceIdentityKey`",{"_3396":1398,"_29729":1264,"_20626":52774,"_5":14148,"_27027":52393,"_2882":52775},[],"Device",{"_3396":1399,"_29729":1264,"_20626":52777,"_5":14148,"_27027":52393,"_2882":52778},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3396":1400,"_29729":1264,"_20626":52780,"_5":14148,"_27027":52393,"_2882":52781},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3396":1401,"_29729":1264,"_20626":52783,"_5":14148,"_27027":52393,"_2882":52784},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3396":1402,"_29729":1264,"_20626":52786,"_5":14148,"_27027":52393,"_2882":52442},[],{"_3396":1403,"_29729":1264,"_20626":52788,"_5":14148,"_27027":52393,"_2882":52789},[],"`EventUpdateCertificateStatusKey`",{"_3396":1404,"_29729":1264,"_20626":52791,"_5":14148,"_27027":52393,"_2882":52792},[],"Certificate",{"_3396":1405,"_29729":1264,"_20626":52794,"_5":14148,"_27027":52393,"_2882":52795},[],"`IoTCore/Certificate`",{"_3396":1406,"_29729":1264,"_20626":52797,"_5":14148,"_27027":52393,"_2882":52798},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3396":1407,"_29729":1264,"_20626":52800,"_5":14148,"_27027":52393,"_2882":52801},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3396":1408,"_29729":1264,"_20626":52803,"_5":14148,"_27027":52393,"_2882":52454},[],{"_3396":1409,"_29729":1264,"_20626":52805,"_5":14148,"_27027":52393,"_2882":52806},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3396":1410,"_29729":1264,"_20626":52808,"_5":14148,"_27027":52393,"_2882":52809},[],"Certificate / Device",{"_3396":1411,"_29729":1264,"_20626":52811,"_5":14148,"_27027":52393,"_2882":52812},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3396":1412,"_29729":1264,"_20626":52814,"_5":14148,"_27027":52393,"_2882":48825},[],{"_3396":1413,"_29729":1264,"_20626":52816,"_5":14148,"_27027":52393,"_2882":52817},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3396":1414,"_29729":1264,"_20626":52819,"_5":14148,"_27027":52393,"_2882":52462},[],{"_3396":1415,"_29729":1264,"_20626":52821,"_5":14148,"_27027":52397,"_2882":52822},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3396":1416,"_29729":1264,"_20626":52824,"_5":14148,"_27027":52401,"_2882":52825},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3396":1417,"_29729":1264,"_20626":52827,"_5":14148,"_27027":52401,"_2882":52828},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3396":1418,"_29729":1264,"_20626":52830,"_5":14148,"_27027":52405,"_2882":52831},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3396":1419,"_29729":1264,"_20626":52833,"_5":14148,"_27027":52405,"_2882":52834},[],"Transition",{"_3396":1420,"_29729":1264,"_20626":52836,"_5":14148,"_27027":52405,"_2882":52837},[],"AWS calls",{"_3396":1421,"_29729":1264,"_20626":52839,"_5":14148,"_27027":52405,"_2882":52840},[],"`NotRegistered` → `Requested`",{"_3396":1422,"_29729":1264,"_20626":52842,"_5":14148,"_27027":52405,"_2882":52843},[],"none (metadata write only)",{"_3396":1423,"_29729":1264,"_20626":52845,"_5":14148,"_27027":52405,"_2882":52846},[],"`Requested` → `Registering`",{"_3396":1424,"_29729":1264,"_20626":52848,"_5":14148,"_27027":52405,"_2882":52849},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3396":1425,"_29729":1264,"_20626":52851,"_5":14148,"_27027":52405,"_2882":52852},[],"`Registering` → `Succeeded`",{"_3396":1426,"_29729":1264,"_20626":52854,"_5":14148,"_27027":52405,"_2882":52855},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3396":1427,"_29729":1264,"_20626":52857,"_5":14148,"_27027":52405,"_2882":52858},[],"`Registering` → `Failed`",{"_3396":1428,"_29729":1264,"_20626":52860,"_5":14148,"_27027":52405,"_2882":52861},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3396":1429,"_29729":1264,"_20626":52863,"_5":14148,"_27027":52405,"_2882":52864},[],"`Failed` / `Succeeded` → `Requested`",{"_3396":1430,"_29729":1264,"_20626":52866,"_5":14148,"_27027":52405,"_2882":52867},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3396":1431,"_29729":1264,"_20626":52869,"_5":14148,"_27027":52409,"_2882":52870},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3396":1432,"_29729":1264,"_20626":52872,"_5":14148,"_27027":52409,"_2882":52873},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3396":1433,"_29729":1264,"_20626":52875,"_5":14148,"_27027":52409,"_2882":52876},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3396":1434,"_29729":1264,"_20626":52878,"_5":14148,"_27027":52409,"_2882":52879},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3396":1435,"_29729":1264,"_20626":52881,"_5":14148,"_27027":52409,"_2882":52882},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3396":1436,"_29729":1264,"_20626":52884,"_5":14148,"_27027":52409,"_2882":52885},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3396":1437,"_29729":1264,"_20626":52887,"_5":14148,"_27027":52413,"_2882":52888},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3396":1438,"_29729":1264,"_20626":52890,"_5":14148,"_27027":52417,"_2882":52891},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3396":1439,"_29729":1264,"_20626":52893,"_5":14148,"_27027":52417,"_2882":52894},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3396":1440,"_29729":1264,"_20626":52896,"_5":14148,"_27027":52421,"_2882":52897},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3396":1441,"_29729":1264,"_20626":52899,"_5":14148,"_27027":52425,"_2882":52900},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3396":1442,"_29729":1264,"_20626":52902,"_5":14148,"_27027":52425,"_2882":52903},[],"Creates or updates the IoT policies configured in the DMS.",{"_3396":1443,"_29729":1264,"_20626":52905,"_5":14148,"_27027":52425,"_2882":52906},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3396":1444,"_29729":1264,"_20626":52908,"_5":14148,"_27027":52425,"_2882":52909},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3396":1445,"_29729":1264,"_20626":52911,"_5":14148,"_27027":52425,"_2882":52912},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3396":1446,"_29729":1264,"_20626":52914,"_5":14148,"_27027":52425,"_2882":52915},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3396":1447,"_29729":1264,"_20626":52917,"_5":14148,"_27027":52425,"_2882":52918},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3396":1448,"_29729":1264,"_20626":52920,"_5":14148,"_27027":52429,"_2882":52921},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3396":1449,"_29729":1264,"_20626":52923,"_5":14148,"_27027":52429,"_2882":52924},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3396":1450,"_29729":1264,"_20626":52926,"_5":14148,"_27027":52429,"_2882":52927},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3396":1451,"_29729":1264,"_20626":52929,"_5":14148,"_27027":52429,"_2882":52930},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3396":1452,"_29729":1264,"_20626":52932,"_5":14148,"_27027":52429,"_2882":52933},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3396":1453,"_29729":1264,"_20626":52935,"_5":14148,"_27027":52433,"_2882":52936},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3396":1454,"_29729":1264,"_20626":52938,"_5":14148,"_27027":52433,"_2882":52834},[],{"_3396":1455,"_29729":1264,"_20626":52940,"_5":14148,"_27027":52433,"_2882":52837},[],{"_3396":1456,"_29729":1264,"_20626":52942,"_5":14148,"_27027":52433,"_2882":52943},[],"`Unconfigured` → `None` / `Auto`",{"_3396":1457,"_29729":1264,"_20626":52945,"_5":14148,"_27027":52433,"_2882":52946},[],"none (configuration only)",{"_3396":1458,"_29729":1264,"_20626":52948,"_5":14148,"_27027":52433,"_2882":52949},[],"`None` ↔ `Auto`",{"_3396":1459,"_29729":1264,"_20626":52951,"_5":14148,"_27027":52433,"_2882":52946},[],{"_3396":1460,"_29729":1264,"_20626":52953,"_5":14148,"_27027":52433,"_2882":52954},[],"Any → `Jitp`",{"_3396":1461,"_29729":1264,"_20626":52956,"_5":14148,"_27027":52433,"_2882":52957},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3396":1462,"_29729":1264,"_20626":52959,"_5":14148,"_27027":52433,"_2882":52960},[],"`Jitp` → `None` / `Auto`",{"_3396":1463,"_29729":1264,"_20626":52962,"_5":14148,"_27027":52433,"_2882":52963},[],"none (the template stays in the AWS account)",{"_3396":1464,"_29729":1264,"_20626":52965,"_5":14148,"_27027":52437,"_2882":52966},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3396":1465,"_29729":1264,"_20626":52968,"_5":14148,"_27027":52437,"_2882":52969},[],"The full flow from the device's perspective is:",{"_3396":1466,"_29729":1264,"_20626":52971,"_5":14148,"_27027":52437,"_2882":52972},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3396":1467,"_29729":1264,"_20626":52974,"_5":14148,"_27027":52441,"_2882":52975},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3396":1468,"_29729":1264,"_20626":52977,"_5":14148,"_27027":52441,"_2882":52834},[],{"_3396":1469,"_29729":1264,"_20626":52979,"_5":14148,"_27027":52441,"_2882":52837},[],{"_3396":1470,"_29729":1264,"_20626":52981,"_5":14148,"_27027":52441,"_2882":52982},[],"`Absent` → `Provisioned`",{"_3396":1471,"_29729":1264,"_20626":52984,"_5":14148,"_27027":52441,"_2882":52985},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3396":1472,"_29729":1264,"_20626":52987,"_5":14148,"_27027":52441,"_2882":52988},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3396":1473,"_29729":1264,"_20626":52990,"_5":14148,"_27027":52441,"_2882":52991},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3396":1474,"_29729":1264,"_20626":52993,"_5":14148,"_27027":52441,"_2882":52994},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3396":1475,"_29729":1264,"_20626":52996,"_5":14148,"_27027":52445,"_2882":52997},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3396":1476,"_29729":1264,"_20626":52999,"_5":14148,"_27027":52445,"_2882":53000},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3396":1477,"_29729":1264,"_20626":53002,"_5":14148,"_27027":52445,"_2882":53003},[],"For the JITP flow to work correctly:",{"_3396":1478,"_29729":1264,"_20626":53005,"_5":14148,"_27027":52445,"_2882":53006},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3396":1479,"_29729":1264,"_20626":53008,"_5":14148,"_27027":52445,"_2882":53009},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3396":1480,"_29729":1264,"_20626":53011,"_5":14148,"_27027":52445,"_2882":53012},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3396":1481,"_29729":1264,"_20626":53014,"_5":14148,"_27027":52445,"_2882":53015},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3396":1482,"_29729":1264,"_20626":53017,"_5":14148,"_27027":52449,"_2882":53018},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3396":1483,"_29729":1264,"_20626":53020,"_5":14148,"_27027":52449,"_2882":53021},[],"Status in Lamassu",{"_3396":1484,"_29729":1264,"_20626":53023,"_5":14148,"_27027":52449,"_2882":53024},[],"Revocation reason",{"_3396":1485,"_29729":1264,"_20626":53026,"_5":14148,"_27027":52449,"_2882":53027},[],"Status in AWS IoT Core",{"_3396":1486,"_29729":1264,"_20626":53029,"_5":14148,"_27027":52449,"_2882":53030},[],"`Active`",{"_3396":1487,"_29729":1264,"_20626":53032,"_5":14148,"_27027":52449,"_2882":53033},[],"None",{"_3396":1488,"_29729":1264,"_20626":53035,"_5":14148,"_27027":52449,"_2882":53036},[],"`ACTIVE`",{"_3396":1489,"_29729":1264,"_20626":53038,"_5":14148,"_27027":52449,"_2882":53039},[],"`Revoked`",{"_3396":1490,"_29729":1264,"_20626":53041,"_5":14148,"_27027":52449,"_2882":53042},[],"`certificateHold`",{"_3396":1491,"_29729":1264,"_20626":53044,"_5":14148,"_27027":52449,"_2882":53045},[],"`INACTIVE`",{"_3396":1492,"_29729":1264,"_20626":53047,"_5":14148,"_27027":52449,"_2882":53039},[],{"_3396":1493,"_29729":1264,"_20626":53049,"_5":14148,"_27027":52449,"_2882":53050},[],"Any other reason",{"_3396":1494,"_29729":1264,"_20626":53052,"_5":14148,"_27027":52449,"_2882":53053},[],"`REVOKED`",{"_3396":1495,"_29729":1264,"_20626":53055,"_5":14148,"_27027":52449,"_2882":53056},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3396":1496,"_29729":1264,"_20626":53058,"_5":14148,"_27027":52453,"_2882":53059},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3396":1497,"_29729":1264,"_20626":53061,"_5":14148,"_27027":52453,"_2882":52834},[],{"_3396":1498,"_29729":1264,"_20626":53063,"_5":14148,"_27027":52453,"_2882":52837},[],{"_3396":1499,"_29729":1264,"_20626":53065,"_5":14148,"_27027":52453,"_2882":53066},[],"`NotSynced` → `Active`",{"_3396":1500,"_29729":1264,"_20626":53068,"_5":14148,"_27027":52453,"_2882":52545},[],{"_3396":1501,"_29729":1264,"_20626":53070,"_5":14148,"_27027":52453,"_2882":53071},[],"`Active` → `Inactive`",{"_3396":1502,"_29729":1264,"_20626":53073,"_5":14148,"_27027":52453,"_2882":53074},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3396":1503,"_29729":1264,"_20626":53076,"_5":14148,"_27027":52453,"_2882":53077},[],"`Active` → `Revoked`",{"_3396":1504,"_29729":1264,"_20626":53079,"_5":14148,"_27027":52453,"_2882":53074},[],{"_3396":1505,"_29729":1264,"_20626":53081,"_5":14148,"_27027":52453,"_2882":53082},[],"`Inactive` / `Revoked` → `Active`",{"_3396":1506,"_29729":1264,"_20626":53084,"_5":14148,"_27027":52453,"_2882":52545},[],{"_3396":1507,"_29729":1264,"_20626":53086,"_5":14148,"_27027":52453,"_2882":53087},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3396":1508,"_29729":1264,"_20626":53089,"_5":14148,"_27027":52453,"_2882":53090},[],"none (these states are not synced to AWS)",{"_3396":1509,"_29729":1264,"_20626":53092,"_5":14148,"_27027":52457,"_2882":53093},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3396":1510,"_29729":1264,"_20626":53095,"_5":14148,"_27027":52457,"_2882":53096},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3396":1511,"_29729":1264,"_20626":53098,"_5":14148,"_27027":52457,"_2882":53099},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3396":1512,"_29729":1264,"_20626":53101,"_5":14148,"_27027":52461,"_2882":53102},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3396":1513,"_29729":1264,"_20626":53104,"_5":14148,"_27027":52461,"_2882":53105},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3396":1514,"_29729":1264,"_20626":53107,"_5":14148,"_27027":52465,"_2882":53108},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3396":1515,"_29729":1264,"_20626":53110,"_5":14148,"_27027":52465,"_2882":53111},[],"There are two action types:",{"_3396":1516,"_29729":1264,"_20626":53113,"_5":14148,"_27027":52465,"_2882":53114},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3396":1517,"_29729":1264,"_20626":53116,"_5":14148,"_27027":52465,"_2882":53117},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3396":1518,"_29729":1264,"_20626":53119,"_5":14148,"_27027":52465,"_2882":53120},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3396":1519,"_29729":1264,"_20626":53122,"_5":14148,"_27027":52469,"_2882":53123},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3396":1520,"_29729":1264,"_20626":53125,"_5":14148,"_27027":52469,"_2882":53126},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3396":1521,"_29729":1264,"_20626":53128,"_5":14148,"_27027":52469,"_2882":53129},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3396":1522,"_29729":1264,"_20626":53131,"_5":14148,"_27027":52473,"_2882":53132},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3396":1523,"_29729":1264,"_20626":53134,"_5":14148,"_27027":52473,"_2882":53135},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3396":1524,"_29729":1264,"_20626":53137,"_5":14148,"_27027":52473,"_2882":53138},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3396":1525,"_29729":1264,"_20626":53140,"_5":14148,"_27027":52473,"_2882":53141},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3396":1526,"_29729":1264,"_20626":53143,"_5":14148,"_27027":52473,"_2882":53144},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3396":1527,"_29729":1264,"_20626":53146,"_5":14148,"_27027":52473,"_2882":53147},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3396":1528,"_29729":1264,"_20626":53149,"_5":14148,"_27027":52473,"_2882":53150},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3396":1529,"_29729":1264,"_20626":53152,"_5":14148,"_27027":52473,"_2882":53153},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3396":1530,"_29729":1264,"_20626":53155,"_5":14148,"_27027":52473,"_2882":53156},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3396":1531,"_29729":1264,"_20626":53158,"_5":14148,"_27027":52473,"_2882":53159},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3396":1532,"_29729":1264,"_20626":53161,"_5":14148,"_27027":52473,"_2882":53162},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3396":1533,"_29729":1264,"_20626":53164,"_5":14148,"_27027":52473,"_2882":53165},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3396":1534,"_29729":1264,"_20626":53167,"_5":14148,"_27027":52473,"_2882":53168},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3396":1535,"_29729":1264,"_20626":53170,"_5":14148,"_27027":52473,"_2882":53171},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3396":1536,"_29729":1264,"_20626":53173,"_5":14148,"_27027":52473,"_2882":53174},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3396":1537,"_29729":1264,"_20626":53176,"_5":14148,"_27027":52473,"_2882":53177},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3396":1538,"_29729":1264,"_20626":53179,"_5":14148,"_27027":52473,"_2882":53180},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3396":1539,"_29729":1264,"_20626":53182,"_5":14148,"_27027":52473,"_2882":53183},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3396":1540,"_29729":1264,"_20626":53185,"_5":14148,"_27027":52473,"_2882":53186},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3396":1541,"_29729":1264,"_20626":53188,"_5":14148,"_27027":52473,"_2882":53189},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3396":1542,"_29729":1264,"_20626":53191,"_5":14148,"_27027":52473,"_2882":53192},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3396":1543,"_29729":1264,"_20626":53194,"_5":14148,"_27027":52473,"_2882":53195},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3396":1544,"_29729":1264,"_20626":53197,"_5":14148,"_27027":52473,"_2882":53198},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3396":1545,"_29729":1264,"_20626":53200,"_5":14148,"_27027":52473,"_2882":53201},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3396":1546,"_29729":1546,"_5":14500,"_2882":50908,"_30082":53203,"_20626":53204,"_27027":1546},[48429,49897,50908],[],{"_3396":1547,"_29729":1546,"_20626":53206,"_5":14148,"_27027":1546,"_2882":53207},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3396":1548,"_29729":1546,"_5":30079,"_20626":53209,"_27027":53210,"_2882":53211},[],"/docs/pr-preview/pr-57/platform/iot-fleets/overview#start-here","Start here",{"_3396":1549,"_29729":1546,"_5":30079,"_20626":53213,"_27027":53214,"_2882":50906},[],"/docs/pr-preview/pr-57/platform/iot-fleets/overview#devices-and-identities",{"_3396":1550,"_29729":1546,"_5":30079,"_20626":53216,"_27027":53217,"_2882":51089},[],"/docs/pr-preview/pr-57/platform/iot-fleets/overview#enrollment-with-pki",{"_3396":1551,"_29729":1546,"_5":30079,"_20626":53219,"_27027":53220,"_2882":52370},[],"/docs/pr-preview/pr-57/platform/iot-fleets/overview#integrations",{"_3396":1552,"_29729":1546,"_5":30079,"_20626":53222,"_27027":53223,"_2882":53224},[],"/docs/pr-preview/pr-57/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3396":1553,"_29729":1546,"_20626":53226,"_5":14148,"_27027":1546,"_2882":53227},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3396":1554,"_29729":1546,"_20626":53229,"_5":14148,"_27027":53210,"_2882":53230},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3396":1555,"_29729":1546,"_20626":53232,"_5":14148,"_27027":53210,"_2882":53233},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3396":1556,"_29729":1546,"_20626":53235,"_5":14148,"_27027":53214,"_2882":53236},[],"Resource",{"_3396":1557,"_29729":1546,"_20626":53238,"_5":14148,"_27027":53214,"_2882":53239},[],"What it represents",{"_3396":1558,"_29729":1546,"_20626":53241,"_5":14148,"_27027":53214,"_2882":53242},[],"**Device**",{"_3396":1559,"_29729":1546,"_20626":53244,"_5":14148,"_27027":53214,"_2882":53245},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3396":1560,"_29729":1546,"_20626":53247,"_5":14148,"_27027":53214,"_2882":53248},[],"**Identity**",{"_3396":1561,"_29729":1546,"_20626":53250,"_5":14148,"_27027":53214,"_2882":53251},[],"The device's association with its certificates: an active version and a history.",{"_3396":1562,"_29729":1546,"_20626":53253,"_5":14148,"_27027":53214,"_2882":53254},[],"**DMS**",{"_3396":1563,"_29729":1546,"_20626":53256,"_5":14148,"_27027":53214,"_2882":53257},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3396":1564,"_29729":1546,"_20626":53259,"_5":14148,"_27027":53214,"_2882":53260},[],"**Fleet**",{"_3396":1565,"_29729":1546,"_20626":53262,"_5":14148,"_27027":53214,"_2882":53263},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3396":1566,"_29729":1546,"_20626":53265,"_5":14148,"_27027":53214,"_2882":53266},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3396":1567,"_29729":1546,"_20626":53268,"_5":14148,"_27027":53214,"_2882":53269},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3396":1568,"_29729":1546,"_20626":53271,"_5":14148,"_27027":53217,"_2882":53272},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3396":1569,"_29729":1546,"_20626":53274,"_5":14148,"_27027":53217,"_2882":53275},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3396":1570,"_29729":1546,"_20626":53277,"_5":14148,"_27027":53217,"_2882":53278},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3396":1571,"_29729":1546,"_20626":53280,"_5":14148,"_27027":53217,"_2882":53281},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3396":1572,"_29729":1546,"_20626":53283,"_5":14148,"_27027":53217,"_2882":53284},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3396":1573,"_29729":1546,"_20626":53286,"_5":14148,"_27027":53217,"_2882":53287},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3396":1574,"_29729":1546,"_20626":53289,"_5":14148,"_27027":53217,"_2882":53290},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3396":1575,"_29729":1546,"_20626":53292,"_5":14148,"_27027":53217,"_2882":53293},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3396":1576,"_29729":1546,"_20626":53295,"_5":14148,"_27027":53220,"_2882":53296},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3396":1577,"_29729":1546,"_20626":53298,"_5":14148,"_27027":53220,"_2882":53299},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3396":1578,"_29729":1546,"_20626":53301,"_5":14148,"_27027":53223,"_2882":53302},[],"Participant",{"_3396":1579,"_29729":1546,"_20626":53304,"_5":14148,"_27027":53223,"_2882":53305},[],"Responsibility",{"_3396":1580,"_29729":1546,"_20626":53307,"_5":14148,"_27027":53223,"_2882":53308},[],"PKI administrator",{"_3396":1581,"_29729":1546,"_20626":53310,"_5":14148,"_27027":53223,"_2882":53311},[],"CA, issuance profile, chain and revocation publication.",{"_3396":1582,"_29729":1546,"_20626":53313,"_5":14148,"_27027":53223,"_2882":53314},[],"Provisioning administrator",{"_3396":1583,"_29729":1546,"_20626":53316,"_5":14148,"_27027":53223,"_2882":53317},[],"DMS, admission, authentication per operation and inventory.",{"_3396":1584,"_29729":1546,"_20626":53319,"_5":14148,"_27027":53223,"_2882":53320},[],"Device integrator",{"_3396":1585,"_29729":1546,"_20626":53322,"_5":14148,"_27027":53223,"_2882":53323},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3396":1586,"_29729":1546,"_20626":53325,"_5":14148,"_27027":53223,"_2882":53326},[],"Consumer integrator",{"_3396":1587,"_29729":1546,"_20626":53328,"_5":14148,"_27027":53223,"_2882":53329},[],"Trusted issuers, validation and device permissions in the destination.",{"_3396":1588,"_29729":1546,"_20626":53331,"_5":14148,"_27027":53223,"_2882":53332},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3396":1589,"_29729":1589,"_5":14500,"_2882":53334,"_30082":53335,"_20626":53337,"_27027":1589},"Enroll and connect your first device",[48429,49897,50908,53336],"Getting started",[],{"_3396":1590,"_29729":1589,"_20626":53339,"_5":14148,"_27027":1589,"_2882":53340},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3396":1591,"_29729":1589,"_5":30079,"_20626":53342,"_27027":53343,"_2882":48439},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3396":1592,"_29729":1589,"_5":30079,"_20626":53345,"_27027":53346,"_2882":53347},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3396":1593,"_29729":1589,"_5":30079,"_20626":53349,"_27027":53350,"_2882":53351},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3396":1594,"_29729":1589,"_5":30079,"_20626":53353,"_27027":53354,"_2882":53355},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3396":1595,"_29729":1589,"_5":30079,"_20626":53357,"_27027":53358,"_2882":53359},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3396":1596,"_29729":1589,"_5":30079,"_20626":53361,"_27027":53362,"_2882":53363},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3396":1597,"_29729":1589,"_5":30079,"_20626":53365,"_27027":53366,"_2882":53367},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3396":1598,"_29729":1589,"_5":30079,"_20626":53369,"_27027":53370,"_2882":53371},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3396":1599,"_29729":1589,"_20626":53373,"_5":14148,"_27027":1589,"_2882":53374},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3396":1600,"_29729":1589,"_20626":53376,"_5":14148,"_27027":53343,"_2882":53377},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3396":1601,"_29729":1589,"_20626":53379,"_5":14148,"_27027":53343,"_2882":53380},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3396":1602,"_29729":1589,"_20626":53382,"_5":14148,"_27027":53343,"_2882":53383},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3396":1603,"_29729":1589,"_20626":53385,"_5":14148,"_27027":53343,"_2882":53386},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3396":1604,"_29729":1589,"_20626":53388,"_5":14148,"_27027":53343,"_2882":53389},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3396":1605,"_29729":1589,"_20626":53391,"_5":14148,"_27027":53346,"_2882":53392},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3396":1606,"_29729":1589,"_20626":53394,"_5":14148,"_27027":53346,"_2882":53395},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3396":1607,"_29729":1589,"_20626":53397,"_5":14148,"_27027":53350,"_2882":53398},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3396":1608,"_29729":1589,"_20626":53400,"_5":14148,"_27027":53350,"_2882":53401},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3396":1609,"_29729":1589,"_20626":53403,"_5":14148,"_27027":53350,"_2882":53404},[],"Setting",{"_3396":1610,"_29729":1589,"_20626":53406,"_5":14148,"_27027":53350,"_2882":53407},[],"Evaluation value",{"_3396":1611,"_29729":1589,"_20626":53409,"_5":14148,"_27027":53350,"_2882":53410},[],"Enrollment CA",{"_3396":1612,"_29729":1589,"_20626":53412,"_5":14148,"_27027":53350,"_2882":53413},[],"Issuing root from `device-root.pem`.",{"_3396":1613,"_29729":1589,"_20626":53415,"_5":14148,"_27027":53350,"_2882":51219},[],{"_3396":1614,"_29729":1589,"_20626":53417,"_5":14148,"_27027":53350,"_2882":53418},[],"The 1-hour leaf profile you just prepared.",{"_3396":1615,"_29729":1589,"_20626":53420,"_5":14148,"_27027":53350,"_2882":53421},[],"Protocol / Registration Mode",{"_3396":1616,"_29729":1589,"_20626":53423,"_5":14148,"_27027":53350,"_2882":53424},[],"`EST_RFC7030` / `JITP`.",{"_3396":1617,"_29729":1589,"_20626":53426,"_5":14148,"_27027":53350,"_2882":53427},[],"Verify CSR Signature",{"_3396":1618,"_29729":1589,"_20626":53429,"_5":14148,"_27027":53350,"_2882":53430},[],"Enabled.",{"_3396":1619,"_29729":1589,"_20626":53432,"_5":14148,"_27027":53350,"_2882":53433},[],"Enable Replaceable Enrollment",{"_3396":1620,"_29729":1589,"_20626":53435,"_5":14148,"_27027":53350,"_2882":53436},[],"Disabled; the ID must be new.",{"_3396":1621,"_29729":1589,"_20626":53438,"_5":14148,"_27027":53350,"_2882":53439},[],"Initial authentication",{"_3396":1622,"_29729":1589,"_20626":53441,"_5":14148,"_27027":53350,"_2882":53442},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3396":1623,"_29729":1589,"_20626":53444,"_5":14148,"_27027":53350,"_2882":53445},[],"Renewal authentication",{"_3396":1624,"_29729":1589,"_20626":53447,"_5":14148,"_27027":53350,"_2882":53448},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3396":1625,"_29729":1589,"_20626":53450,"_5":14148,"_27027":53350,"_2882":53451},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3396":1626,"_29729":1589,"_20626":53453,"_5":14148,"_27027":53350,"_2882":53454},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3396":1627,"_29729":1589,"_20626":53456,"_5":14148,"_27027":53350,"_2882":53457},[],"Re-enrollment Delta",{"_3396":1628,"_29729":1589,"_20626":53459,"_5":14148,"_27027":53350,"_2882":53460},[],"1 hour.",{"_3396":1629,"_29729":1589,"_20626":53462,"_5":14148,"_27027":53350,"_2882":53463},[],"Preventive / Critical Delta",{"_3396":1630,"_29729":1589,"_20626":53465,"_5":14148,"_27027":53350,"_2882":53466},[],"30 minutes / 10 minutes.",{"_3396":1631,"_29729":1589,"_20626":53468,"_5":14148,"_27027":53350,"_2882":53469},[],"Revoke on Re-enrollment",{"_3396":1632,"_29729":1589,"_20626":53471,"_5":14148,"_27027":53350,"_2882":53472},[],"Disabled to test the successor before retiring the previous identity.",{"_3396":1633,"_29729":1589,"_20626":53474,"_5":14148,"_27027":53350,"_2882":51227},[],{"_3396":1634,"_29729":1589,"_20626":53476,"_5":14148,"_27027":53350,"_2882":53477},[],"Disabled; the operational key is generated in the client.",{"_3396":1635,"_29729":1589,"_20626":53479,"_5":14148,"_27027":53350,"_2882":53480},[],"CA Distribution",{"_3396":1636,"_29729":1589,"_20626":53482,"_5":14148,"_27027":53350,"_2882":53483},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3396":1637,"_29729":1589,"_20626":53485,"_5":14148,"_27027":53350,"_2882":53486},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3396":1638,"_29729":1589,"_20626":53488,"_5":14148,"_27027":53354,"_2882":53489},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3396":1639,"_29729":1589,"_20626":53491,"_5":14148,"_27027":53354,"_2882":53492},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3396":1640,"_29729":1589,"_20626":53494,"_5":14148,"_27027":53358,"_2882":53495},[],"Generate a new key and CSR with the selected identifier:",{"_3396":1641,"_29729":1589,"_20626":53497,"_5":14148,"_27027":53358,"_2882":53498},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3396":1642,"_29729":1589,"_20626":53500,"_5":14148,"_27027":53358,"_2882":53501},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3396":1643,"_29729":1589,"_20626":53503,"_5":14148,"_27027":53362,"_2882":53504},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3396":1644,"_29729":1589,"_20626":53506,"_5":14148,"_27027":53362,"_2882":53507},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3396":1645,"_29729":1589,"_20626":53509,"_5":14148,"_27027":53366,"_2882":53510},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3396":1646,"_29729":1589,"_20626":53512,"_5":14148,"_27027":53366,"_2882":53513},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3396":1647,"_29729":1589,"_20626":53515,"_5":14148,"_27027":53366,"_2882":53516},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3396":1648,"_29729":1589,"_20626":53518,"_5":14148,"_27027":53366,"_2882":53519},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3396":1649,"_29729":1589,"_20626":53521,"_5":14148,"_27027":53366,"_2882":53522},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3396":1650,"_29729":1589,"_20626":53524,"_5":14148,"_27027":53370,"_2882":53525},[],"Check",{"_3396":1651,"_29729":1589,"_20626":53527,"_5":14148,"_27027":53370,"_2882":53528},[],"Expected result",{"_3396":1652,"_29729":1589,"_20626":53530,"_5":14148,"_27027":53370,"_2882":53531},[],"Registration",{"_3396":1653,"_29729":1589,"_20626":53533,"_5":14148,"_27027":53370,"_2882":53534},[],"ID created automatically and correct DMS.",{"_3396":1654,"_29729":1589,"_20626":53536,"_5":14148,"_27027":53370,"_2882":52792},[],{"_3396":1655,"_29729":1589,"_20626":53538,"_5":14148,"_27027":53370,"_2882":53539},[],"CN, profile, serial and key verified.",{"_3396":1656,"_29729":1589,"_20626":53541,"_5":14148,"_27027":53370,"_2882":53542},[],"Inventory",{"_3396":1657,"_29729":1589,"_20626":53544,"_5":14148,"_27027":53370,"_2882":53545},[],"Received serial visible as the current identity and in history.",{"_3396":1658,"_29729":1589,"_20626":53547,"_5":14148,"_27027":53370,"_2882":53548},[],"Consumer",{"_3396":1659,"_29729":1589,"_20626":53550,"_5":14148,"_27027":53370,"_2882":53551},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3396":1660,"_29729":1589,"_20626":53553,"_5":14148,"_27027":53370,"_2882":53554},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3396":1661,"_29729":1589,"_20626":53556,"_5":14148,"_27027":53370,"_2882":53557},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3396":1662,"_29729":1662,"_5":14500,"_2882":50924,"_30082":53559,"_20626":53560,"_27027":1662},[48429,49897,50908,53336],[],{"_3396":1663,"_29729":1662,"_20626":53562,"_5":14148,"_27027":1662,"_2882":53563},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3396":1664,"_29729":1662,"_5":30079,"_20626":53565,"_27027":53566,"_2882":48439},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3396":1665,"_29729":1662,"_5":30079,"_20626":53568,"_27027":53569,"_2882":53570},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3396":1666,"_29729":1662,"_5":30079,"_20626":53572,"_27027":53573,"_2882":53574},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3396":1667,"_29729":1662,"_5":30079,"_20626":53576,"_27027":53577,"_2882":53578},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3396":1668,"_29729":1662,"_5":30079,"_20626":53580,"_27027":53581,"_2882":53582},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3396":1669,"_29729":1662,"_5":30079,"_20626":53584,"_27027":53585,"_2882":53586},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3396":1670,"_29729":1662,"_5":30079,"_20626":53588,"_27027":53589,"_2882":53528},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3396":1671,"_29729":1662,"_5":30079,"_20626":53591,"_27027":53592,"_2882":53593},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3396":1672,"_29729":1662,"_5":30079,"_20626":53595,"_27027":53596,"_2882":53597},[],"/docs/pr-preview/pr-57/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3396":1673,"_29729":1662,"_20626":53599,"_5":14148,"_27027":1662,"_2882":53600},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3396":1674,"_29729":1662,"_20626":53602,"_5":14148,"_27027":1662,"_2882":53603},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3396":1675,"_29729":1662,"_20626":53605,"_5":14148,"_27027":53566,"_2882":53606},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3396":1676,"_29729":1662,"_20626":53608,"_5":14148,"_27027":53566,"_2882":53609},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3396":1677,"_29729":1662,"_20626":53611,"_5":14148,"_27027":53566,"_2882":53612},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3396":1678,"_29729":1662,"_20626":53614,"_5":14148,"_27027":53566,"_2882":53615},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3396":1679,"_29729":1662,"_20626":53617,"_5":14148,"_27027":53569,"_2882":53618},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3396":1680,"_29729":1662,"_20626":53620,"_5":14148,"_27027":53569,"_2882":53621},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3396":1681,"_29729":1662,"_20626":53623,"_5":14148,"_27027":53569,"_2882":53624},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3396":1682,"_29729":1662,"_20626":53626,"_5":14148,"_27027":53569,"_2882":53627},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3396":1683,"_29729":1662,"_20626":53629,"_5":14148,"_27027":53569,"_2882":53630},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3396":1684,"_29729":1662,"_20626":53632,"_5":14148,"_27027":53569,"_2882":53633},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3396":1685,"_29729":1662,"_20626":53635,"_5":14148,"_27027":53569,"_2882":53636},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3396":1686,"_29729":1662,"_20626":53638,"_5":14148,"_27027":53569,"_2882":53639},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3396":1687,"_29729":1662,"_20626":53641,"_5":14148,"_27027":53573,"_2882":53642},[],"Open **Managed Devices** and the registration action. Complete:",{"_3396":1688,"_29729":1662,"_20626":53644,"_5":14148,"_27027":53573,"_2882":53645},[],"**Device ID**: `device-001`.",{"_3396":1689,"_29729":1662,"_20626":53647,"_5":14148,"_27027":53573,"_2882":53648},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3396":1690,"_29729":1662,"_20626":53650,"_5":14148,"_27027":53573,"_2882":53651},[],"**Icon** and **Tags**: optional classification.",{"_3396":1691,"_29729":1662,"_20626":53653,"_5":14148,"_27027":53573,"_2882":53654},[],"Confirm registration.",{"_3396":1692,"_29729":1662,"_20626":53656,"_5":14148,"_27027":53577,"_2882":53657},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3396":1693,"_29729":1662,"_20626":53659,"_5":14148,"_27027":53577,"_2882":53660},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3396":1694,"_29729":1662,"_20626":53662,"_5":14148,"_27027":53581,"_2882":53663},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3396":1695,"_29729":1662,"_20626":53665,"_5":14148,"_27027":53581,"_2882":53666},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3396":1696,"_29729":1662,"_20626":53668,"_5":14148,"_27027":53585,"_2882":53669},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3396":1697,"_29729":1662,"_20626":53671,"_5":14148,"_27027":53585,"_2882":53672},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3396":1698,"_29729":1662,"_20626":53674,"_5":14148,"_27027":53589,"_2882":53525},[],{"_3396":1699,"_29729":1662,"_20626":53676,"_5":14148,"_27027":53589,"_2882":53677},[],"Result",{"_3396":1700,"_29729":1662,"_20626":53679,"_5":14148,"_27027":53589,"_2882":52775},[],{"_3396":1701,"_29729":1662,"_20626":53681,"_5":14148,"_27027":53589,"_2882":53682},[],"`device-001` appears in inventory with the expected DMS.",{"_3396":1702,"_29729":1662,"_20626":53684,"_5":14148,"_27027":53589,"_2882":53685},[],"Current identity",{"_3396":1703,"_29729":1662,"_20626":53687,"_5":14148,"_27027":53589,"_2882":53688},[],"The associated certificate matches the one you verified in PKI.",{"_3396":1704,"_29729":1662,"_20626":53690,"_5":14148,"_27027":53589,"_2882":53691},[],"History",{"_3396":1705,"_29729":1662,"_20626":53693,"_5":14148,"_27027":53589,"_2882":53694},[],"The associated issuance appears with its serial number and dates.",{"_3396":1706,"_29729":1662,"_20626":53696,"_5":14148,"_27027":53589,"_2882":53697},[],"Key and certificate",{"_3396":1707,"_29729":1662,"_20626":53699,"_5":14148,"_27027":53589,"_2882":53700},[],"You have the verified pair ready to install on the device.",{"_3396":1708,"_29729":1662,"_20626":53702,"_5":14148,"_27027":53592,"_2882":53703},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3396":1709,"_29729":1662,"_20626":53705,"_5":14148,"_27027":53592,"_2882":53706},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3396":1710,"_29729":1662,"_20626":53708,"_5":14148,"_27027":53592,"_2882":53709},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3396":1711,"_29729":1662,"_20626":53711,"_5":14148,"_27027":53592,"_2882":53712},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3396":1712,"_29729":1662,"_20626":53714,"_5":14148,"_27027":53596,"_2882":53715},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3396":1713,"_29729":1662,"_20626":53717,"_5":14148,"_27027":53596,"_2882":53718},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3396":1714,"_29729":1662,"_20626":53720,"_5":14148,"_27027":53596,"_2882":53721},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3396":1715,"_29729":1715,"_5":14500,"_2882":53723,"_30082":53724,"_20626":53725,"_27027":1715},"Lamassu IoT Platform",[48429,49897],[],{"_3396":1716,"_29729":1715,"_20626":53727,"_5":14148,"_27027":1715,"_2882":53728},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3396":1717,"_29729":1715,"_5":30079,"_20626":53730,"_27027":53731,"_2882":53211},[],"/docs/pr-preview/pr-57/platform/overview#start-here",{"_3396":1718,"_29729":1715,"_5":30079,"_20626":53733,"_27027":53734,"_2882":53735},[],"/docs/pr-preview/pr-57/platform/overview#choose-your-path","Choose your path",{"_3396":1719,"_29729":1715,"_5":30079,"_20626":53737,"_27027":53738,"_2882":53739},[],"/docs/pr-preview/pr-57/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3396":1720,"_29729":1715,"_5":30079,"_20626":53741,"_27027":53742,"_2882":53743},[],"/docs/pr-preview/pr-57/platform/overview#core-capabilities","Core capabilities",{"_3396":1721,"_29729":1715,"_5":30079,"_20626":53745,"_27027":53746,"_2882":53747},[],"/docs/pr-preview/pr-57/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3396":1722,"_29729":1715,"_5":30079,"_20626":53749,"_27027":53750,"_2882":53751},[],"/docs/pr-preview/pr-57/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3396":1723,"_29729":1715,"_5":30079,"_20626":53753,"_27027":53754,"_2882":53755},[],"/docs/pr-preview/pr-57/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3396":1724,"_29729":1715,"_5":30079,"_20626":53757,"_27027":53758,"_2882":53759},[],"/docs/pr-preview/pr-57/platform/overview#automate-device-identities","Automate device identities",{"_3396":1725,"_29729":1715,"_5":30079,"_20626":53761,"_27027":53762,"_2882":53763},[],"/docs/pr-preview/pr-57/platform/overview#publish-validation-status","Publish validation status",{"_3396":1726,"_29729":1715,"_5":30079,"_20626":53765,"_27027":53766,"_2882":53767},[],"/docs/pr-preview/pr-57/platform/overview#react-to-events","React to events",{"_3396":1727,"_29729":1715,"_5":30079,"_20626":53769,"_27027":53770,"_2882":53771},[],"/docs/pr-preview/pr-57/platform/overview#operational-reference","Operational reference",{"_3396":1728,"_29729":1715,"_20626":53773,"_5":14148,"_27027":1715,"_2882":53774},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3396":1729,"_29729":1715,"_20626":53776,"_5":14148,"_27027":53731,"_2882":53777},[],"Choose the result you need:",{"_3396":1730,"_29729":1715,"_20626":53779,"_5":14148,"_27027":53731,"_2882":53780},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3396":1731,"_29729":1715,"_20626":53782,"_5":14148,"_27027":53731,"_2882":53783},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3396":1732,"_29729":1715,"_20626":53785,"_5":14148,"_27027":53731,"_2882":53786},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3396":1733,"_29729":1715,"_20626":53788,"_5":14148,"_27027":53734,"_2882":53789},[],"Section",{"_3396":1734,"_29729":1715,"_20626":53791,"_5":14148,"_27027":53734,"_2882":53792},[],"What you manage",{"_3396":1735,"_29729":1715,"_20626":53794,"_5":14148,"_27027":53734,"_2882":53795},[],"Entry point",{"_3396":1736,"_29729":1715,"_20626":53797,"_5":14148,"_27027":53734,"_2882":53798},[],"**PKI**",{"_3396":1737,"_29729":1715,"_20626":53800,"_5":14148,"_27027":53734,"_2882":53801},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3396":1738,"_29729":1715,"_20626":53803,"_5":14148,"_27027":53734,"_2882":53804},[],"PKI overview",{"_3396":1739,"_29729":1715,"_20626":53806,"_5":14148,"_27027":53734,"_2882":53807},[],"**IoT Fleets**",{"_3396":1740,"_29729":1715,"_20626":53809,"_5":14148,"_27027":53734,"_2882":53810},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3396":1741,"_29729":1715,"_20626":53812,"_5":14148,"_27027":53734,"_2882":53813},[],"IoT Fleets overview",{"_3396":1742,"_29729":1715,"_20626":53815,"_5":14148,"_27027":53734,"_2882":53816},[],"**Administration**",{"_3396":1743,"_29729":1715,"_20626":53818,"_5":14148,"_27027":53734,"_2882":53819},[],"Operator permissions, audit and event subscriptions.",{"_3396":1744,"_29729":1715,"_20626":53821,"_5":14148,"_27027":53734,"_2882":49895},[],{"_3396":1745,"_29729":1715,"_20626":53823,"_5":14148,"_27027":53734,"_2882":53824},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3396":1746,"_29729":1715,"_20626":53826,"_5":14148,"_27027":53738,"_2882":53827},[],"An identity's journey connects four responsibilities:",{"_3396":1747,"_29729":1715,"_20626":53829,"_5":14148,"_27027":53738,"_2882":53830},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3396":1748,"_29729":1715,"_20626":53832,"_5":14148,"_27027":53738,"_2882":53833},[],"The provisioning administrator configures the DMS and initial trust.",{"_3396":1749,"_29729":1715,"_20626":53835,"_5":14148,"_27027":53738,"_2882":53836},[],"The device client requests a certificate and installs it with the matching key.",{"_3396":1750,"_29729":1715,"_20626":53838,"_5":14148,"_27027":53738,"_2882":53839},[],"The consumer validates the identity and applies its access permissions.",{"_3396":1751,"_29729":1715,"_20626":53841,"_5":14148,"_27027":53738,"_2882":53842},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3396":1752,"_29729":1715,"_20626":53844,"_5":14148,"_27027":53746,"_2882":53845},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3396":1753,"_29729":1715,"_20626":53847,"_5":14148,"_27027":53750,"_2882":53848},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3396":1754,"_29729":1715,"_20626":53850,"_5":14148,"_27027":53754,"_2882":53851},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3396":1755,"_29729":1715,"_20626":53853,"_5":14148,"_27027":53758,"_2882":53854},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3396":1756,"_29729":1715,"_20626":53856,"_5":14148,"_27027":53762,"_2882":53857},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3396":1757,"_29729":1715,"_20626":53859,"_5":14148,"_27027":53766,"_2882":53860},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3396":1758,"_29729":1715,"_20626":53862,"_5":14148,"_27027":53770,"_2882":53305},[],{"_3396":1759,"_29729":1715,"_20626":53864,"_5":14148,"_27027":53770,"_2882":53865},[],"What it prepares or checks",{"_3396":1760,"_29729":1715,"_20626":53867,"_5":14148,"_27027":53770,"_2882":53308},[],{"_3396":1761,"_29729":1715,"_20626":53869,"_5":14148,"_27027":53770,"_2882":53870},[],"Key custody, CA hierarchy, profiles and validation.",{"_3396":1762,"_29729":1715,"_20626":53872,"_5":14148,"_27027":53770,"_2882":53873},[],"Fleet administrator",{"_3396":1763,"_29729":1715,"_20626":53875,"_5":14148,"_27027":53770,"_2882":53876},[],"DMS, device admission, renewal policy and inventory.",{"_3396":1764,"_29729":1715,"_20626":53878,"_5":14148,"_27027":53770,"_2882":53320},[],{"_3396":1765,"_29729":1715,"_20626":53880,"_5":14148,"_27027":53770,"_2882":53881},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3396":1766,"_29729":1715,"_20626":53883,"_5":14148,"_27027":53770,"_2882":53326},[],{"_3396":1767,"_29729":1715,"_20626":53885,"_5":14148,"_27027":53770,"_2882":53886},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3396":1768,"_29729":1715,"_20626":53888,"_5":14148,"_27027":53770,"_2882":53889},[],"Infrastructure operator",{"_3396":1769,"_29729":1715,"_20626":53891,"_5":14148,"_27027":53770,"_2882":53892},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3396":1770,"_29729":1715,"_20626":53894,"_5":14148,"_27027":53770,"_2882":53895},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3396":1771,"_29729":1771,"_5":14500,"_2882":53897,"_30082":53898,"_20626":53901,"_27027":1771},"CA hierarchy and rotation",[48429,49897,53899,53900],"PKI","Keys, authorities and certificates",[],{"_3396":1772,"_29729":1771,"_20626":53903,"_5":14148,"_27027":1771,"_2882":53904},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3396":1773,"_29729":1771,"_5":30079,"_20626":53906,"_27027":53907,"_2882":53908},[],"/docs/pr-preview/pr-57/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3396":1774,"_29729":1771,"_5":30079,"_20626":53910,"_27027":53911,"_2882":53912},[],"/docs/pr-preview/pr-57/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3396":1775,"_29729":1771,"_5":30079,"_20626":53914,"_27027":53915,"_2882":53916},[],"/docs/pr-preview/pr-57/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3396":1776,"_29729":1771,"_5":30079,"_20626":53918,"_27027":53919,"_2882":53920},[],"/docs/pr-preview/pr-57/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3396":1777,"_29729":1771,"_5":30079,"_20626":53922,"_27027":53923,"_2882":53924},[],"/docs/pr-preview/pr-57/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3396":1778,"_29729":1771,"_5":30079,"_20626":53926,"_27027":53927,"_2882":53928},[],"/docs/pr-preview/pr-57/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3396":1779,"_29729":1771,"_5":30079,"_20626":53930,"_27027":53931,"_2882":53932},[],"/docs/pr-preview/pr-57/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3396":1780,"_29729":1771,"_5":30079,"_20626":53934,"_27027":53935,"_2882":53936},[],"/docs/pr-preview/pr-57/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3396":1781,"_29729":1771,"_5":30079,"_20626":53938,"_27027":53939,"_2882":53940},[],"/docs/pr-preview/pr-57/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3396":1782,"_29729":1771,"_5":30079,"_20626":53942,"_27027":53943,"_2882":53944},[],"/docs/pr-preview/pr-57/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3396":1783,"_29729":1771,"_5":30079,"_20626":53946,"_27027":53947,"_2882":53948},[],"/docs/pr-preview/pr-57/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3396":1784,"_29729":1771,"_5":30079,"_20626":53950,"_27027":53951,"_2882":53952},[],"/docs/pr-preview/pr-57/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3396":1785,"_29729":1771,"_20626":53954,"_5":14148,"_27027":1771,"_2882":53955},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3396":1786,"_29729":1771,"_20626":53957,"_5":14148,"_27027":1771,"_2882":53958},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3396":1787,"_29729":1771,"_20626":53960,"_5":14148,"_27027":53907,"_2882":53961},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3396":1788,"_29729":1771,"_20626":53963,"_5":14148,"_27027":53907,"_2882":53964},[],"environment, such as production and preproduction;",{"_3396":1789,"_29729":1771,"_20626":53966,"_5":14148,"_27027":53907,"_2882":53967},[],"owner or operating team;",{"_3396":1790,"_29729":1771,"_20626":53969,"_5":14148,"_27027":53907,"_2882":53970},[],"device family or manufacturing process;",{"_3396":1791,"_29729":1771,"_20626":53972,"_5":14148,"_27027":53907,"_2882":53973},[],"region or regulatory requirement;",{"_3396":1792,"_29729":1771,"_20626":53975,"_5":14148,"_27027":53907,"_2882":53976},[],"cryptographic engine or key policy;",{"_3396":1793,"_29729":1771,"_20626":53978,"_5":14148,"_27027":53907,"_2882":53979},[],"maintenance window and renewal cadence.",{"_3396":1794,"_29729":1771,"_20626":53981,"_5":14148,"_27027":53907,"_2882":53982},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3396":1795,"_29729":1771,"_20626":53984,"_5":14148,"_27027":53907,"_2882":53985},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3396":1796,"_29729":1771,"_20626":53987,"_5":14148,"_27027":53911,"_2882":53988},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3396":1797,"_29729":1771,"_20626":53990,"_5":14148,"_27027":53911,"_2882":53991},[],"If a VA CRL role for the CA is signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for a role signed by a different certificate, the role keeps its signer, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_3396":1798,"_29729":1771,"_20626":53993,"_5":14148,"_27027":53911,"_2882":53994},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3396":1799,"_29729":1771,"_20626":53996,"_5":14148,"_27027":53911,"_2882":53997},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3396":1800,"_29729":1771,"_20626":53999,"_5":14148,"_27027":53915,"_2882":54000},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3396":1801,"_29729":1771,"_20626":54002,"_5":14148,"_27027":53915,"_2882":54003},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3396":1802,"_29729":1771,"_20626":54005,"_5":14148,"_27027":53915,"_2882":54006},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3396":1803,"_29729":1771,"_20626":54008,"_5":14148,"_27027":53915,"_2882":54009},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3396":1804,"_29729":1771,"_20626":54011,"_5":14148,"_27027":53923,"_2882":54012},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3396":1805,"_29729":1771,"_20626":54014,"_5":14148,"_27027":53927,"_2882":54015},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3396":1806,"_29729":1771,"_20626":54017,"_5":14148,"_27027":53931,"_2882":54018},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3396":1807,"_29729":1771,"_20626":54020,"_5":14148,"_27027":53935,"_2882":54021},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3396":1808,"_29729":1771,"_20626":54023,"_5":14148,"_27027":53939,"_2882":54024},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3396":1809,"_29729":1771,"_20626":54026,"_5":14148,"_27027":53943,"_2882":54027},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3396":1810,"_29729":1771,"_20626":54029,"_5":14148,"_27027":53947,"_2882":54030},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3396":1811,"_29729":1771,"_20626":54032,"_5":14148,"_27027":53947,"_2882":54033},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3396":1812,"_29729":1771,"_20626":54035,"_5":14148,"_27027":53947,"_2882":54036},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3396":1813,"_29729":1771,"_20626":54038,"_5":14148,"_27027":53947,"_2882":54039},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3396":1814,"_29729":1771,"_20626":54041,"_5":14148,"_27027":53951,"_2882":54042},[],"The new chain ends in an anchor installed by the consumer.",{"_3396":1815,"_29729":1771,"_20626":54044,"_5":14148,"_27027":53951,"_2882":54045},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3396":1816,"_29729":1771,"_20626":54047,"_5":14148,"_27027":53951,"_2882":54048},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3396":1817,"_29729":1771,"_20626":54050,"_5":14148,"_27027":53951,"_2882":54051},[],"Re-enrollment accepts the old identity during the planned period.",{"_3396":1818,"_29729":1771,"_20626":54053,"_5":14148,"_27027":53951,"_2882":54054},[],"OCSP and CRL respond for the authorities that remain active.",{"_3396":1819,"_29729":1771,"_20626":54056,"_5":14148,"_27027":53951,"_2882":54057},[],"No DMS is left accidentally issuing from the old CA.",{"_3396":1820,"_29729":1771,"_20626":54059,"_5":14148,"_27027":53951,"_2882":54060},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3396":1821,"_29729":1821,"_5":14500,"_2882":54062,"_30082":54063,"_20626":54064,"_27027":1821},"Certification authorities",[48429,49897,53899,53900],[],{"_3396":1822,"_29729":1821,"_20626":54066,"_5":14148,"_27027":1821,"_2882":54067},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3396":1823,"_29729":1821,"_5":30079,"_20626":54069,"_27027":54070,"_2882":54071},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3396":1824,"_29729":1821,"_5":30079,"_20626":54073,"_27027":54074,"_2882":54075},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3396":1825,"_29729":1821,"_5":30079,"_20626":54077,"_27027":54078,"_2882":48439},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#before-you-begin",{"_3396":1826,"_29729":1821,"_5":30079,"_20626":54080,"_27027":54081,"_2882":54082},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3396":1827,"_29729":1821,"_5":30079,"_20626":54084,"_27027":54085,"_2882":54086},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3396":1828,"_29729":1821,"_5":30079,"_20626":54088,"_27027":54089,"_2882":54090},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3396":1829,"_29729":1821,"_5":30079,"_20626":54092,"_27027":54093,"_2882":54094},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3396":1830,"_29729":1821,"_5":30079,"_20626":54096,"_27027":54097,"_2882":54098},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3396":1831,"_29729":1821,"_5":30079,"_20626":54100,"_27027":54101,"_2882":54102},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3396":1832,"_29729":1821,"_5":30079,"_20626":54104,"_27027":54105,"_2882":54106},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3396":1833,"_29729":1821,"_5":30079,"_20626":54108,"_27027":54109,"_2882":54110},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3396":1834,"_29729":1821,"_5":30079,"_20626":54112,"_27027":54113,"_2882":54114},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3396":1835,"_29729":1821,"_5":30079,"_20626":54116,"_27027":54117,"_2882":54118},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3396":1836,"_29729":1821,"_5":30079,"_20626":54120,"_27027":54121,"_2882":54122},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3396":1837,"_29729":1821,"_5":30079,"_20626":54124,"_27027":54125,"_2882":54126},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3396":1838,"_29729":1821,"_5":30079,"_20626":54128,"_27027":54129,"_2882":54130},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3396":1839,"_29729":1821,"_5":30079,"_20626":54132,"_27027":54133,"_2882":54134},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3396":1840,"_29729":1821,"_5":30079,"_20626":54136,"_27027":54137,"_2882":54138},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3396":1841,"_29729":1821,"_5":30079,"_20626":54140,"_27027":54141,"_2882":54142},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3396":1842,"_29729":1821,"_5":30079,"_20626":54144,"_27027":54145,"_2882":54146},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3396":1843,"_29729":1821,"_5":30079,"_20626":54148,"_27027":54149,"_2882":54150},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3396":1844,"_29729":1821,"_5":30079,"_20626":54152,"_27027":54153,"_2882":54154},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3396":1845,"_29729":1821,"_5":30079,"_20626":54156,"_27027":54157,"_2882":54158},[],"/docs/pr-preview/pr-57/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3396":1846,"_29729":1821,"_20626":54160,"_5":14148,"_27027":1821,"_2882":54161},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3396":1847,"_29729":1821,"_20626":54163,"_5":14148,"_27027":1821,"_2882":54164},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3396":1848,"_29729":1821,"_20626":54166,"_5":14148,"_27027":1821,"_2882":54167},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3396":1849,"_29729":1821,"_20626":54169,"_5":14148,"_27027":54070,"_2882":54170},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3396":1850,"_29729":1821,"_20626":54172,"_5":14148,"_27027":54070,"_2882":54173},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3396":1851,"_29729":1821,"_20626":54175,"_5":14148,"_27027":54070,"_2882":54176},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3396":1852,"_29729":1821,"_20626":54178,"_5":14148,"_27027":54070,"_2882":54179},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3396":1853,"_29729":1821,"_20626":54181,"_5":14148,"_27027":54070,"_2882":54182},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3396":1854,"_29729":1821,"_20626":54184,"_5":14148,"_27027":54078,"_2882":54185},[],"Decide whether the CA will be a root or an intermediate.",{"_3396":1855,"_29729":1821,"_20626":54187,"_5":14148,"_27027":54078,"_2882":54188},[],"Choose the engine that will keep the key.",{"_3396":1856,"_29729":1821,"_20626":54190,"_5":14148,"_27027":54078,"_2882":54191},[],"Define a validity longer than that of the certificates it will issue.",{"_3396":1857,"_29729":1821,"_20626":54193,"_5":14148,"_27027":54078,"_2882":54194},[],"For an intermediate CA, make sure the parent CA is active.",{"_3396":1858,"_29729":1821,"_20626":54196,"_5":14148,"_27027":54081,"_2882":54197},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3396":1859,"_29729":1821,"_20626":54199,"_5":14148,"_27027":54085,"_2882":54200},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3396":1860,"_29729":1821,"_20626":54202,"_5":14148,"_27027":54085,"_2882":54203},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3396":1861,"_29729":1821,"_20626":54205,"_5":14148,"_27027":54089,"_2882":54206},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3396":1862,"_29729":1821,"_20626":54208,"_5":14148,"_27027":54093,"_2882":54209},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3396":1863,"_29729":1821,"_20626":54211,"_5":14148,"_27027":54093,"_2882":54212},[],"`C`: two-letter ISO 3166-1 country code.",{"_3396":1864,"_29729":1821,"_20626":54214,"_5":14148,"_27027":54093,"_2882":54215},[],"`ST`: state or province.",{"_3396":1865,"_29729":1821,"_20626":54217,"_5":14148,"_27027":54093,"_2882":54218},[],"`L`: locality.",{"_3396":1866,"_29729":1821,"_20626":54220,"_5":14148,"_27027":54093,"_2882":54221},[],"`O`: organization.",{"_3396":1867,"_29729":1821,"_20626":54223,"_5":14148,"_27027":54093,"_2882":54224},[],"`OU`: organizational unit.",{"_3396":1868,"_29729":1821,"_20626":54226,"_5":14148,"_27027":54093,"_2882":54227},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3396":1869,"_29729":1821,"_20626":54229,"_5":14148,"_27027":54097,"_2882":54230},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3396":1870,"_29729":1821,"_20626":54232,"_5":14148,"_27027":54097,"_2882":54233},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3396":1871,"_29729":1821,"_20626":54235,"_5":14148,"_27027":54101,"_2882":54236},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3396":1872,"_29729":1821,"_20626":54238,"_5":14148,"_27027":54101,"_2882":54239},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3396":1873,"_29729":1821,"_20626":54241,"_5":14148,"_27027":54105,"_2882":54242},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3396":1874,"_29729":1821,"_20626":54244,"_5":14148,"_27027":54105,"_2882":54245},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3396":1875,"_29729":1821,"_20626":54247,"_5":14148,"_27027":54109,"_2882":54248},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3396":1876,"_29729":1821,"_20626":54250,"_5":14148,"_27027":54109,"_2882":54251},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3396":1877,"_29729":1821,"_20626":54253,"_5":14148,"_27027":54109,"_2882":54254},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3396":1878,"_29729":1821,"_20626":54256,"_5":14148,"_27027":54113,"_2882":54257},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3396":1879,"_29729":1821,"_20626":54259,"_5":14148,"_27027":54117,"_2882":54260},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3396":1880,"_29729":1821,"_20626":54262,"_5":14148,"_27027":54117,"_2882":54263},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3396":1881,"_29729":1821,"_20626":54265,"_5":14148,"_27027":54121,"_2882":54266},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3396":1882,"_29729":1821,"_20626":54268,"_5":14148,"_27027":54125,"_2882":54269},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3396":1883,"_29729":1821,"_20626":54271,"_5":14148,"_27027":54125,"_2882":54272},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3396":1884,"_29729":1821,"_20626":54274,"_5":14148,"_27027":54129,"_2882":54275},[],"Open a CA from the inventory to review:",{"_3396":1885,"_29729":1821,"_20626":54277,"_5":14148,"_27027":54129,"_2882":54278},[],"Status and validity period.",{"_3396":1886,"_29729":1821,"_20626":54280,"_5":14148,"_27027":54129,"_2882":54281},[],"Certificate and chain in PEM format.",{"_3396":1887,"_29729":1821,"_20626":54283,"_5":14148,"_27027":54129,"_2882":54284},[],"Number of active, expired and revoked certificates.",{"_3396":1888,"_29729":1821,"_20626":54286,"_5":14148,"_27027":54129,"_2882":54287},[],"Certificates issued in **Issued Certificates**.",{"_3396":1889,"_29729":1821,"_20626":54289,"_5":14148,"_27027":54129,"_2882":54290},[],"The CRL linked to the authority.",{"_3396":1890,"_29729":1821,"_20626":54292,"_5":14148,"_27027":54129,"_2882":54293},[],"Metadata and the associated cryptographic engine.",{"_3396":1891,"_29729":1821,"_20626":54295,"_5":14148,"_27027":54129,"_2882":54296},[],"You can filter the inventory by name, status and CA type.",{"_3396":1892,"_29729":1821,"_20626":54298,"_5":14148,"_27027":54133,"_2882":54299},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3396":1893,"_29729":1821,"_20626":54301,"_5":14148,"_27027":54133,"_2882":54302},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3396":1894,"_29729":1821,"_20626":54304,"_5":14148,"_27027":54133,"_2882":54305},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3396":1895,"_29729":1821,"_20626":54307,"_5":14148,"_27027":54133,"_2882":54308},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3396":1896,"_29729":1821,"_20626":54310,"_5":14148,"_27027":54137,"_2882":54311},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3396":1897,"_29729":1821,"_20626":54313,"_5":14148,"_27027":54141,"_2882":54314},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3396":1898,"_29729":1821,"_20626":54316,"_5":14148,"_27027":54145,"_2882":54317},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3396":1899,"_29729":1821,"_20626":54319,"_5":14148,"_27027":54149,"_2882":54320},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3396":1900,"_29729":1821,"_20626":54322,"_5":14148,"_27027":54153,"_2882":54323},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3396":1901,"_29729":1821,"_20626":54325,"_5":14148,"_27027":54157,"_2882":54326},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3396":1902,"_29729":1821,"_20626":54328,"_5":14148,"_27027":54157,"_2882":54329},[],"The CA’s VA role is kept. If no other CA with the same SKI remains, it can no longer be edited (see CRL), so adjust its validity and signer beforehand. The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3396":1903,"_29729":1821,"_20626":54331,"_5":14148,"_27027":54157,"_2882":54332},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. If the new certificate uses the same key, it shares the SKI with the retained VA role of the deleted CA, whose signer is the old certificate: check that the CRL is generated and, if it is not, use `PUT` to set a signer of the new CA (see CRL).",{"_3396":1904,"_29729":1904,"_5":14500,"_2882":54334,"_30082":54335,"_20626":54336,"_27027":1904},"Certificate profiles",[48429,49897,53899,53900],[],{"_3396":1905,"_29729":1904,"_20626":54338,"_5":14148,"_27027":1904,"_2882":54339},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3396":1906,"_29729":1904,"_5":30079,"_20626":54341,"_27027":54342,"_2882":54343},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3396":1907,"_29729":1904,"_5":30079,"_20626":54345,"_27027":54346,"_2882":54347},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#validity","Validity",{"_3396":1908,"_29729":1904,"_5":30079,"_20626":54349,"_27027":54350,"_2882":54351},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3396":1909,"_29729":1904,"_5":30079,"_20626":54353,"_27027":54354,"_2882":54355},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3396":1910,"_29729":1904,"_5":30079,"_20626":54357,"_27027":54358,"_2882":54359},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#subject","Subject",{"_3396":1911,"_29729":1904,"_5":30079,"_20626":54361,"_27027":54362,"_2882":54363},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3396":1912,"_29729":1904,"_5":30079,"_20626":54365,"_27027":54366,"_2882":54367},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3396":1913,"_29729":1904,"_5":30079,"_20626":54369,"_27027":54370,"_2882":54371},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3396":1914,"_29729":1904,"_5":30079,"_20626":54373,"_27027":54374,"_2882":54375},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3396":1915,"_29729":1904,"_5":30079,"_20626":54377,"_27027":54378,"_2882":54379},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3396":1916,"_29729":1904,"_5":30079,"_20626":54381,"_27027":54382,"_2882":54383},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3396":1917,"_29729":1904,"_5":30079,"_20626":54385,"_27027":54386,"_2882":54387},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3396":1918,"_29729":1904,"_5":30079,"_20626":54389,"_27027":54390,"_2882":54391},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3396":1919,"_29729":1904,"_5":30079,"_20626":54393,"_27027":54394,"_2882":54395},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3396":1920,"_29729":1904,"_5":30079,"_20626":54397,"_27027":54398,"_2882":54399},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#design-examples","Design examples",{"_3396":1921,"_29729":1904,"_5":30079,"_20626":54401,"_27027":54402,"_2882":54403},[],"/docs/pr-preview/pr-57/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3396":1922,"_29729":1904,"_20626":54405,"_5":14148,"_27027":1904,"_2882":54406},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3396":1923,"_29729":1904,"_20626":54408,"_5":14148,"_27027":1904,"_2882":54409},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3396":1924,"_29729":1904,"_20626":54411,"_5":14148,"_27027":54346,"_2882":54412},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3396":1925,"_29729":1904,"_20626":54414,"_5":14148,"_27027":54346,"_2882":54415},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3396":1926,"_29729":1904,"_20626":54417,"_5":14148,"_27027":54350,"_2882":54418},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3396":1927,"_29729":1904,"_20626":54420,"_5":14148,"_27027":54354,"_2882":54421},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3396":1928,"_29729":1904,"_20626":54423,"_5":14148,"_27027":54354,"_2882":54424},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3396":1929,"_29729":1904,"_20626":54426,"_5":14148,"_27027":54354,"_2882":54427},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3396":1930,"_29729":1904,"_20626":54429,"_5":14148,"_27027":54358,"_2882":54430},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3396":1931,"_29729":1904,"_20626":54432,"_5":14148,"_27027":54362,"_2882":54433},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3396":1932,"_29729":1904,"_20626":54435,"_5":14148,"_27027":54362,"_2882":54436},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3396":1933,"_29729":1904,"_20626":54438,"_5":14148,"_27027":54366,"_2882":54439},[],"The cryptographic enforcement can:",{"_3396":1934,"_29729":1904,"_20626":54441,"_5":14148,"_27027":54366,"_2882":54442},[],"allow or block RSA keys;",{"_3396":1935,"_29729":1904,"_20626":54444,"_5":14148,"_27027":54366,"_2882":54445},[],"limit the supported RSA sizes;",{"_3396":1936,"_29729":1904,"_20626":54447,"_5":14148,"_27027":54366,"_2882":54448},[],"allow or block ECDSA keys;",{"_3396":1937,"_29729":1904,"_20626":54450,"_5":14148,"_27027":54366,"_2882":54451},[],"limit the supported ECDSA sizes or curves.",{"_3396":1938,"_29729":1904,"_20626":54453,"_5":14148,"_27027":54366,"_2882":54454},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3396":1939,"_29729":1904,"_20626":54456,"_5":14148,"_27027":54370,"_2882":54457},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3396":1940,"_29729":1904,"_20626":54459,"_5":14148,"_27027":54370,"_2882":51661},[],{"_3396":1941,"_29729":1904,"_20626":54461,"_5":14148,"_27027":54370,"_2882":54462},[],"First choice",{"_3396":1942,"_29729":1904,"_20626":54464,"_5":14148,"_27027":54370,"_2882":54465},[],"Second choice",{"_3396":1943,"_29729":1904,"_20626":54467,"_5":14148,"_27027":54370,"_2882":54468},[],"If neither is supplied",{"_3396":1944,"_29729":1904,"_20626":54470,"_5":14148,"_27027":54370,"_2882":54471},[],"Direct signing with a CA",{"_3396":1945,"_29729":1904,"_20626":54473,"_5":14148,"_27027":54370,"_2882":54474},[],"`issuance_profile` embedded in the request",{"_3396":1946,"_29729":1904,"_20626":54476,"_5":14148,"_27027":54370,"_2882":54477},[],"Request `issuance_profile_id`",{"_3396":1947,"_29729":1904,"_20626":54479,"_5":14148,"_27027":54370,"_2882":54480},[],"CA default profile (`profile_id`).",{"_3396":1948,"_29729":1904,"_20626":54482,"_5":14148,"_27027":54370,"_2882":54483},[],"Issuance through a DMS",{"_3396":1949,"_29729":1904,"_20626":54485,"_5":14148,"_27027":54370,"_2882":54486},[],"`settings.issuance_profile_id`",{"_3396":1950,"_29729":1904,"_20626":54488,"_5":14148,"_27027":54370,"_2882":54489},[],"`settings.issuance_profile` embedded in the DMS",{"_3396":1951,"_29729":1904,"_20626":54491,"_5":14148,"_27027":54370,"_2882":54492},[],"Enrollment CA default profile.",{"_3396":1952,"_29729":1904,"_20626":54494,"_5":14148,"_27027":54370,"_2882":54495},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3396":1953,"_29729":1904,"_20626":54497,"_5":14148,"_27027":54370,"_2882":54498},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3396":1954,"_29729":1904,"_20626":54500,"_5":14148,"_27027":54378,"_2882":54501},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3396":1955,"_29729":1904,"_20626":54503,"_5":14148,"_27027":54382,"_2882":54504},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3396":1956,"_29729":1904,"_20626":54506,"_5":14148,"_27027":54386,"_2882":54507},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3396":1957,"_29729":1904,"_20626":54509,"_5":14148,"_27027":54390,"_2882":54510},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3396":1958,"_29729":1904,"_20626":54512,"_5":14148,"_27027":54394,"_2882":54513},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3396":1959,"_29729":1904,"_20626":54515,"_5":14148,"_27027":54394,"_2882":54516},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3396":1960,"_29729":1904,"_20626":54518,"_5":14148,"_27027":54398,"_2882":54519},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3396":1961,"_29729":1904,"_20626":54521,"_5":14148,"_27027":54398,"_2882":54522},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3396":1962,"_29729":1904,"_20626":54524,"_5":14148,"_27027":54398,"_2882":54525},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3396":1963,"_29729":1904,"_20626":54527,"_5":14148,"_27027":54398,"_2882":54528},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3396":1964,"_29729":1904,"_20626":54530,"_5":14148,"_27027":54402,"_2882":54531},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3396":1965,"_29729":1904,"_20626":54533,"_5":14148,"_27027":54402,"_2882":54534},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3396":1966,"_29729":1966,"_5":14500,"_2882":54536,"_30082":54537,"_20626":54539,"_27027":1966},"Certificate validation",[48429,49897,53899,54538],"Validation",[],{"_3396":1967,"_29729":1966,"_20626":54541,"_5":14148,"_27027":1966,"_2882":54542},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3396":1968,"_29729":1966,"_5":30079,"_20626":54544,"_27027":54545,"_2882":54546},[],"/docs/pr-preview/pr-57/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3396":1969,"_29729":1966,"_5":30079,"_20626":54548,"_27027":54549,"_2882":54550},[],"/docs/pr-preview/pr-57/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3396":1970,"_29729":1966,"_5":30079,"_20626":54552,"_27027":54553,"_2882":54554},[],"/docs/pr-preview/pr-57/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3396":1971,"_29729":1966,"_20626":54556,"_5":14148,"_27027":1966,"_2882":54557},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3396":1972,"_29729":1966,"_20626":54559,"_5":14148,"_27027":54545,"_2882":54560},[],"Verify these criteria together:",{"_3396":1973,"_29729":1966,"_20626":54562,"_5":14148,"_27027":54545,"_2882":53525},[],{"_3396":1974,"_29729":1966,"_20626":54564,"_5":14148,"_27027":54545,"_2882":54565},[],"Required result",{"_3396":1975,"_29729":1966,"_20626":54567,"_5":14148,"_27027":54545,"_2882":54568},[],"Chain and signature",{"_3396":1976,"_29729":1966,"_20626":54570,"_5":14148,"_27027":54545,"_2882":54571},[],"Valid chain to a root deliberately installed in the consumer.",{"_3396":1977,"_29729":1966,"_20626":54573,"_5":14148,"_27027":54545,"_2882":54574},[],"Dates",{"_3396":1978,"_29729":1966,"_20626":54576,"_5":14148,"_27027":54545,"_2882":54577},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3396":1979,"_29729":1966,"_20626":54579,"_5":14148,"_27027":54545,"_2882":49566},[],{"_3396":1980,"_29729":1966,"_20626":54581,"_5":14148,"_27027":54545,"_2882":54582},[],"Name, SAN or identifier matches the expected peer.",{"_3396":1981,"_29729":1966,"_20626":54584,"_5":14148,"_27027":54545,"_2882":48819},[],{"_3396":1982,"_29729":1966,"_20626":54586,"_5":14148,"_27027":54545,"_2882":54587},[],"KU, EKU and constraints permit the specific operation.",{"_3396":1983,"_29729":1966,"_20626":54589,"_5":14148,"_27027":54545,"_2882":54590},[],"Revocation",{"_3396":1984,"_29729":1966,"_20626":54592,"_5":14148,"_27027":54545,"_2882":54593},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3396":1985,"_29729":1966,"_20626":54595,"_5":14148,"_27027":54545,"_2882":54596},[],"Authorization",{"_3396":1986,"_29729":1966,"_20626":54598,"_5":14148,"_27027":54545,"_2882":54599},[],"The application permits that identity to perform the action.",{"_3396":1987,"_29729":1966,"_20626":54601,"_5":14148,"_27027":54545,"_2882":54602},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3396":1988,"_29729":1966,"_20626":54604,"_5":14148,"_27027":54549,"_2882":54605},[],"Mechanism",{"_3396":1989,"_29729":1966,"_20626":54607,"_5":14148,"_27027":54549,"_2882":54608},[],"When to use it",{"_3396":1990,"_29729":1966,"_20626":54610,"_5":14148,"_27027":54549,"_2882":54611},[],"What you must maintain",{"_3396":1991,"_29729":1966,"_20626":54613,"_5":14148,"_27027":54549,"_2882":54614},[],"OCSP",{"_3396":1992,"_29729":1966,"_20626":54616,"_5":14148,"_27027":54549,"_2882":54617},[],"Status query for a specific certificate.",{"_3396":1993,"_29729":1966,"_20626":54619,"_5":14148,"_27027":54549,"_2882":54620},[],"Responder access, signature verification and cache/freshness policy.",{"_3396":1994,"_29729":1966,"_20626":54622,"_5":14148,"_27027":54549,"_2882":54623},[],"CRL",{"_3396":1995,"_29729":1966,"_20626":54625,"_5":14148,"_27027":54549,"_2882":54626},[],"Local checks for many certificates or offline operation.",{"_3396":1996,"_29729":1966,"_20626":54628,"_5":14148,"_27027":54549,"_2882":54629},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3396":1997,"_29729":1966,"_20626":54631,"_5":14148,"_27027":54549,"_2882":54632},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3396":1998,"_29729":1966,"_20626":54634,"_5":14148,"_27027":54549,"_2882":54635},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3396":1999,"_29729":1966,"_20626":54637,"_5":14148,"_27027":54553,"_2882":54638},[],"Accept a current, authorized certificate with a known chain.",{"_3396":2000,"_29729":1966,"_20626":54640,"_5":14148,"_27027":54553,"_2882":54641},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3396":2001,"_29729":1966,"_20626":54643,"_5":14148,"_27027":54553,"_2882":54644},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3396":2002,"_29729":1966,"_20626":54646,"_5":14148,"_27027":54553,"_2882":54647},[],"Check that a new connection with that identity is rejected.",{"_3396":2003,"_29729":1966,"_20626":54649,"_5":14148,"_27027":54553,"_2882":54650},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3396":2004,"_29729":1966,"_20626":54652,"_5":14148,"_27027":54553,"_2882":54653},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3396":2005,"_29729":1966,"_20626":54655,"_5":14148,"_27027":54553,"_2882":54656},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3396":2006,"_29729":1966,"_20626":54658,"_5":14148,"_27027":54553,"_2882":54659},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3396":2007,"_29729":1966,"_20626":54661,"_5":14148,"_27027":54553,"_2882":54662},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3396":2008,"_29729":2008,"_5":14500,"_2882":54664,"_30082":54665,"_20626":54666,"_27027":2008},"Certificates",[48429,49897,53899,53900],[],{"_3396":2009,"_29729":2008,"_20626":54668,"_5":14148,"_27027":2008,"_2882":54669},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3396":2010,"_29729":2008,"_5":30079,"_20626":54671,"_27027":54672,"_2882":54673},[],"/docs/pr-preview/pr-57/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3396":2011,"_29729":2008,"_5":30079,"_20626":54675,"_27027":54676,"_2882":54677},[],"/docs/pr-preview/pr-57/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3396":2012,"_29729":2008,"_5":30079,"_20626":54679,"_27027":54680,"_2882":54681},[],"/docs/pr-preview/pr-57/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3396":2013,"_29729":2008,"_5":30079,"_20626":54683,"_27027":54684,"_2882":54685},[],"/docs/pr-preview/pr-57/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3396":2014,"_29729":2008,"_5":30079,"_20626":54687,"_27027":54688,"_2882":54689},[],"/docs/pr-preview/pr-57/platform/pki/certificates#open-the-action","Open the action",{"_3396":2015,"_29729":2008,"_5":30079,"_20626":54691,"_27027":54692,"_2882":54693},[],"/docs/pr-preview/pr-57/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3396":2016,"_29729":2008,"_5":30079,"_20626":54695,"_27027":54696,"_2882":54697},[],"/docs/pr-preview/pr-57/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3396":2017,"_29729":2008,"_5":30079,"_20626":54699,"_27027":54700,"_2882":54701},[],"/docs/pr-preview/pr-57/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3396":2018,"_29729":2008,"_5":30079,"_20626":54703,"_27027":54704,"_2882":54705},[],"/docs/pr-preview/pr-57/platform/pki/certificates#continue","Continue",{"_3396":2019,"_29729":2008,"_20626":54707,"_5":14148,"_27027":2008,"_2882":54708},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3396":2020,"_29729":2008,"_20626":54710,"_5":14148,"_27027":54672,"_2882":54711},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3396":2021,"_29729":2008,"_20626":54713,"_5":14148,"_27027":54672,"_2882":54714},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3396":2022,"_29729":2008,"_20626":54716,"_5":14148,"_27027":54672,"_2882":54717},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3396":2023,"_29729":2008,"_20626":54719,"_5":14148,"_27027":54672,"_2882":54720},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3396":2024,"_29729":2008,"_20626":54722,"_5":14148,"_27027":54672,"_2882":54723},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3396":2025,"_29729":2008,"_20626":54725,"_5":14148,"_27027":54672,"_2882":54726},[],"Certificate details include the key reference (`key_id`) and whether the private key is managed (`has_private_key`); certificate lists can be filtered on `has_private_key`.",{"_3396":2026,"_29729":2008,"_20626":54728,"_5":14148,"_27027":54672,"_2882":54729},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3396":2027,"_29729":2008,"_20626":54731,"_5":14148,"_27027":54672,"_2882":54732},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3396":2028,"_29729":2008,"_20626":54734,"_5":14148,"_27027":54676,"_2882":54735},[],"Download the PEM and inspect it:",{"_3396":2029,"_29729":2008,"_20626":54737,"_5":14148,"_27027":54676,"_2882":54738},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3396":2030,"_29729":2008,"_20626":54740,"_5":14148,"_27027":54680,"_2882":54741},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3396":2031,"_29729":2008,"_20626":54743,"_5":14148,"_27027":54680,"_2882":54744},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3396":2032,"_29729":2008,"_20626":54746,"_5":14148,"_27027":54680,"_2882":54747},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3396":2033,"_29729":2008,"_20626":54749,"_5":14148,"_27027":54680,"_2882":54750},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3396":2034,"_29729":2008,"_20626":54752,"_5":14148,"_27027":54680,"_2882":54753},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3396":2035,"_29729":2008,"_20626":54755,"_5":14148,"_27027":54680,"_2882":54756},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3396":2036,"_29729":2008,"_20626":54758,"_5":14148,"_27027":54680,"_2882":54759},[],"For browser key generation, follow Issue your first certificate.",{"_3396":2037,"_29729":2008,"_20626":54761,"_5":14148,"_27027":54684,"_2882":54762},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3396":2038,"_29729":2008,"_20626":54764,"_5":14148,"_27027":54688,"_2882":54765},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3396":2039,"_29729":2008,"_20626":54767,"_5":14148,"_27027":54692,"_2882":54768},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3396":2040,"_29729":2008,"_20626":54770,"_5":14148,"_27027":54696,"_2882":54771},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3396":2041,"_29729":2008,"_20626":54773,"_5":14148,"_27027":54696,"_2882":54774},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3396":2042,"_29729":2008,"_20626":54776,"_5":14148,"_27027":54696,"_2882":54777},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3396":2043,"_29729":2008,"_20626":54779,"_5":14148,"_27027":54700,"_2882":54780},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3396":2044,"_29729":2008,"_20626":54782,"_5":14148,"_27027":54700,"_2882":54783},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3396":2045,"_29729":2008,"_20626":54785,"_5":14148,"_27027":54700,"_2882":54786},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3396":2046,"_29729":2008,"_20626":54788,"_5":14148,"_27027":54704,"_2882":54789},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3396":2047,"_29729":2008,"_20626":54791,"_5":14148,"_27027":54704,"_2882":54792},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3396":2048,"_29729":2048,"_5":14500,"_2882":54794,"_30082":54795,"_20626":54797,"_27027":2048},"Certificate lifecycle",[48429,49897,53899,54796],"Concepts",[],{"_3396":2049,"_29729":2048,"_20626":54799,"_5":14148,"_27027":2048,"_2882":54800},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3396":2050,"_29729":2048,"_5":30079,"_20626":54802,"_27027":54803,"_2882":54804},[],"/docs/pr-preview/pr-57/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3396":2051,"_29729":2048,"_5":30079,"_20626":54806,"_27027":54807,"_2882":54808},[],"/docs/pr-preview/pr-57/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3396":2052,"_29729":2048,"_5":30079,"_20626":54810,"_27027":54811,"_2882":54812},[],"/docs/pr-preview/pr-57/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3396":2053,"_29729":2048,"_5":30079,"_20626":54814,"_27027":54815,"_2882":54816},[],"/docs/pr-preview/pr-57/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3396":2054,"_29729":2048,"_5":30079,"_20626":54818,"_27027":54819,"_2882":54820},[],"/docs/pr-preview/pr-57/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3396":2055,"_29729":2048,"_5":30079,"_20626":54822,"_27027":54823,"_2882":54824},[],"/docs/pr-preview/pr-57/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3396":2056,"_29729":2048,"_5":30079,"_20626":54826,"_27027":54827,"_2882":54828},[],"/docs/pr-preview/pr-57/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3396":2057,"_29729":2048,"_5":30079,"_20626":54830,"_27027":54831,"_2882":54832},[],"/docs/pr-preview/pr-57/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3396":2058,"_29729":2048,"_5":30079,"_20626":54834,"_27027":54835,"_2882":54836},[],"/docs/pr-preview/pr-57/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3396":2059,"_29729":2048,"_5":30079,"_20626":54838,"_27027":54839,"_2882":54840},[],"/docs/pr-preview/pr-57/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3396":2060,"_29729":2048,"_20626":54842,"_5":14148,"_27027":2048,"_2882":54843},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3396":2061,"_29729":2048,"_20626":54845,"_5":14148,"_27027":54807,"_2882":54846},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3396":2062,"_29729":2048,"_20626":54848,"_5":14148,"_27027":54811,"_2882":54849},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3396":2063,"_29729":2048,"_20626":54851,"_5":14148,"_27027":54815,"_2882":54852},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3396":2064,"_29729":2048,"_20626":54854,"_5":14148,"_27027":54819,"_2882":54855},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3396":2065,"_29729":2048,"_20626":54857,"_5":14148,"_27027":54823,"_2882":54858},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3396":2066,"_29729":2048,"_20626":54860,"_5":14148,"_27027":54827,"_2882":54861},[],"Lamassu persists four X.509 states:",{"_3396":2067,"_29729":2048,"_20626":54863,"_5":14148,"_27027":54827,"_2882":54864},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3396":2068,"_29729":2048,"_20626":54866,"_5":14148,"_27027":54827,"_2882":54867},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3396":2069,"_29729":2048,"_20626":54869,"_5":14148,"_27027":54827,"_2882":54870},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3396":2070,"_29729":2048,"_20626":54872,"_5":14148,"_27027":54827,"_2882":54873},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3396":2071,"_29729":2048,"_20626":54875,"_5":14148,"_27027":54827,"_2882":54876},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3396":2072,"_29729":2048,"_20626":54878,"_5":14148,"_27027":54831,"_2882":54879},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3396":2073,"_29729":2048,"_20626":54881,"_5":14148,"_27027":54831,"_2882":54882},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3396":2074,"_29729":2048,"_20626":54884,"_5":14148,"_27027":54831,"_2882":54885},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3396":2075,"_29729":2048,"_20626":54887,"_5":14148,"_27027":54835,"_2882":54888},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3396":2076,"_29729":2048,"_20626":54890,"_5":14148,"_27027":54835,"_2882":54891},[],"Before confirming:",{"_3396":2077,"_29729":2048,"_20626":54893,"_5":14148,"_27027":54835,"_2882":54894},[],"Identify DMSs, devices and services that trust that chain.",{"_3396":2078,"_29729":2048,"_20626":54896,"_5":14148,"_27027":54835,"_2882":54897},[],"Distribute the new chain of trust.",{"_3396":2079,"_29729":2048,"_20626":54899,"_5":14148,"_27027":54835,"_2882":54900},[],"Reissue the necessary identities.",{"_3396":2080,"_29729":2048,"_20626":54902,"_5":14148,"_27027":54835,"_2882":54903},[],"Check OCSP and CRL from a real consumer.",{"_3396":2081,"_29729":2048,"_20626":54905,"_5":14148,"_27027":54835,"_2882":54906},[],"Revoke the old CA once no legitimate traffic remains.",{"_3396":2082,"_29729":2048,"_20626":54908,"_5":14148,"_27027":54835,"_2882":54909},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3396":2083,"_29729":2048,"_20626":54911,"_5":14148,"_27027":54839,"_2882":54912},[],"Certificates entering the preventive or critical renewal window.",{"_3396":2084,"_29729":2048,"_20626":54914,"_5":14148,"_27027":54839,"_2882":54915},[],"Repeated enrollment or re-enrollment failures.",{"_3396":2085,"_29729":2048,"_20626":54917,"_5":14148,"_27027":54839,"_2882":54918},[],"Status changes and revocation reasons.",{"_3396":2086,"_29729":2048,"_20626":54920,"_5":14148,"_27027":54839,"_2882":54921},[],"OCSP and CRL publication and validity.",{"_3396":2087,"_29729":2048,"_20626":54923,"_5":14148,"_27027":54839,"_2882":54924},[],"Dependencies still presenting a replaced certificate.",{"_3396":2088,"_29729":2048,"_20626":54926,"_5":14148,"_27027":54839,"_2882":54927},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3396":2089,"_29729":2089,"_5":14500,"_2882":54929,"_30082":54930,"_20626":54931,"_27027":2089},"Trust model",[48429,49897,53899,54796],[],{"_3396":2090,"_29729":2089,"_20626":54933,"_5":14148,"_27027":2089,"_2882":54934},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3396":2091,"_29729":2089,"_5":30079,"_20626":54936,"_27027":54937,"_2882":54938},[],"/docs/pr-preview/pr-57/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3396":2092,"_29729":2089,"_5":30079,"_20626":54940,"_27027":54941,"_2882":54942},[],"/docs/pr-preview/pr-57/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3396":2093,"_29729":2089,"_5":30079,"_20626":54944,"_27027":54945,"_2882":54946},[],"/docs/pr-preview/pr-57/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3396":2094,"_29729":2089,"_5":30079,"_20626":54948,"_27027":54949,"_2882":54950},[],"/docs/pr-preview/pr-57/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3396":2095,"_29729":2089,"_5":30079,"_20626":54952,"_27027":54953,"_2882":54954},[],"/docs/pr-preview/pr-57/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3396":2096,"_29729":2089,"_5":30079,"_20626":54956,"_27027":54957,"_2882":54958},[],"/docs/pr-preview/pr-57/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3396":2097,"_29729":2089,"_5":30079,"_20626":54960,"_27027":54961,"_2882":54962},[],"/docs/pr-preview/pr-57/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3396":2098,"_29729":2089,"_5":30079,"_20626":54964,"_27027":54965,"_2882":54966},[],"/docs/pr-preview/pr-57/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3396":2099,"_29729":2089,"_5":30079,"_20626":54968,"_27027":54969,"_2882":54970},[],"/docs/pr-preview/pr-57/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3396":2100,"_29729":2089,"_5":30079,"_20626":54972,"_27027":54973,"_2882":54974},[],"/docs/pr-preview/pr-57/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3396":2101,"_29729":2089,"_20626":54976,"_5":14148,"_27027":2089,"_2882":54977},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3396":2102,"_29729":2089,"_20626":54979,"_5":14148,"_27027":54941,"_2882":54980},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3396":2103,"_29729":2089,"_20626":54982,"_5":14148,"_27027":54945,"_2882":54983},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3396":2104,"_29729":2089,"_20626":54985,"_5":14148,"_27027":54949,"_2882":54986},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3396":2105,"_29729":2089,"_20626":54988,"_5":14148,"_27027":54953,"_2882":54989},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3396":2106,"_29729":2089,"_20626":54991,"_5":14148,"_27027":54957,"_2882":54992},[],"The device proves it can enroll according to the DMS policy.",{"_3396":2107,"_29729":2089,"_20626":54994,"_5":14148,"_27027":54957,"_2882":54995},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3396":2108,"_29729":2089,"_20626":54997,"_5":14148,"_27027":54957,"_2882":54998},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3396":2109,"_29729":2089,"_20626":55000,"_5":14148,"_27027":54957,"_2882":55001},[],"The device installs the certificate and the chain it needs.",{"_3396":2110,"_29729":2089,"_20626":55003,"_5":14148,"_27027":54957,"_2882":55004},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3396":2111,"_29729":2089,"_20626":55006,"_5":14148,"_27027":54957,"_2882":55007},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3396":2112,"_29729":2089,"_20626":55009,"_5":14148,"_27027":54961,"_2882":55010},[],"A DMS relates three sets that are worth designing separately:",{"_3396":2113,"_29729":2089,"_20626":55012,"_5":14148,"_27027":54961,"_2882":55013},[],"**Enrollment CA:** signs the new identities.",{"_3396":2114,"_29729":2089,"_20626":55015,"_5":14148,"_27027":54961,"_2882":55016},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3396":2115,"_29729":2089,"_20626":55018,"_5":14148,"_27027":54961,"_2882":55019},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3396":2116,"_29729":2089,"_20626":55021,"_5":14148,"_27027":54961,"_2882":55022},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3396":2117,"_29729":2089,"_20626":55024,"_5":14148,"_27027":54965,"_2882":55025},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3396":2118,"_29729":2089,"_20626":55027,"_5":14148,"_27027":54965,"_2882":55028},[],"that the current date is between `Not Before` and `Not After`;",{"_3396":2119,"_29729":2089,"_20626":55030,"_5":14148,"_27027":54965,"_2882":55031},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3396":2120,"_29729":2089,"_20626":55033,"_5":14148,"_27027":54965,"_2882":55034},[],"that names, SANs and subject match the expected identity;",{"_3396":2121,"_29729":2089,"_20626":55036,"_5":14148,"_27027":54965,"_2882":55037},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3396":2122,"_29729":2089,"_20626":55039,"_5":14148,"_27027":54965,"_2882":55040},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3396":2123,"_29729":2089,"_20626":55042,"_5":14148,"_27027":54965,"_2882":55043},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3396":2124,"_29729":2089,"_20626":55045,"_5":14148,"_27027":54969,"_2882":55046},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3396":2125,"_29729":2089,"_20626":55048,"_5":14148,"_27027":54973,"_2882":55049},[],"Keep the root out of daily operations, or with very restricted access.",{"_3396":2126,"_29729":2089,"_20626":55051,"_5":14148,"_27027":54973,"_2882":55052},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3396":2127,"_29729":2089,"_20626":55054,"_5":14148,"_27027":54973,"_2882":55055},[],"Assign explicit profiles to every use case.",{"_3396":2128,"_29729":2089,"_20626":55057,"_5":14148,"_27027":54973,"_2882":55058},[],"Distribute the new trust before starting a rotation.",{"_3396":2129,"_29729":2089,"_20626":55060,"_5":14148,"_27027":54973,"_2882":55061},[],"Keep enough overlap to renew a disconnected fleet.",{"_3396":2130,"_29729":2089,"_20626":55063,"_5":14148,"_27027":54973,"_2882":55064},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3396":2131,"_29729":2089,"_20626":55066,"_5":14148,"_27027":54973,"_2882":55067},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3396":2132,"_29729":2132,"_5":14500,"_2882":55069,"_30082":55070,"_20626":55071,"_27027":2132},"Revocation lists (CRL)",[48429,49897,53899,54538],[],{"_3396":2133,"_29729":2132,"_20626":55073,"_5":14148,"_27027":2132,"_2882":55074},[],"Generate and distribute signed lists to validate certificates offline.",{"_3396":2134,"_29729":2132,"_5":30079,"_20626":55076,"_27027":55077,"_2882":55078},[],"/docs/pr-preview/pr-57/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3396":2135,"_29729":2132,"_5":30079,"_20626":55080,"_27027":55081,"_2882":55082},[],"/docs/pr-preview/pr-57/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3396":2136,"_29729":2132,"_5":30079,"_20626":55084,"_27027":55085,"_2882":55086},[],"/docs/pr-preview/pr-57/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3396":2137,"_29729":2132,"_5":30079,"_20626":55088,"_27027":55089,"_2882":55090},[],"/docs/pr-preview/pr-57/platform/pki/crl#crl-contents","CRL contents",{"_3396":2138,"_29729":2132,"_5":30079,"_20626":55092,"_27027":55093,"_2882":55094},[],"/docs/pr-preview/pr-57/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3396":2139,"_29729":2132,"_5":30079,"_20626":55096,"_27027":55097,"_2882":55098},[],"/docs/pr-preview/pr-57/platform/pki/crl#va-role-management-api","VA role management API",{"_3396":2140,"_29729":2132,"_5":30079,"_20626":55100,"_27027":55101,"_2882":55102},[],"/docs/pr-preview/pr-57/platform/pki/crl#common-va-role-errors","Common VA role errors",{"_3396":2141,"_29729":2132,"_5":30079,"_20626":55104,"_27027":55105,"_2882":55106},[],"/docs/pr-preview/pr-57/platform/pki/crl#from-the-interface","From the interface",{"_3396":2142,"_29729":2132,"_5":30079,"_20626":55108,"_27027":55109,"_2882":55110},[],"/docs/pr-preview/pr-57/platform/pki/crl#references","References",{"_3396":2143,"_29729":2132,"_20626":55112,"_5":14148,"_27027":2132,"_2882":55113},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3396":2144,"_29729":2132,"_20626":55115,"_5":14148,"_27027":55077,"_2882":55116},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3396":2145,"_29729":2132,"_20626":55118,"_5":14148,"_27027":55077,"_2882":55119},[],"`crl_options` field",{"_3396":2146,"_29729":2132,"_20626":55121,"_5":14148,"_27027":55077,"_2882":48819},[],{"_3396":2147,"_29729":2132,"_20626":55123,"_5":14148,"_27027":55077,"_2882":55124},[],"Backend initial value",{"_3396":2148,"_29729":2132,"_20626":55126,"_5":14148,"_27027":55077,"_2882":55127},[],"`validity`",{"_3396":2149,"_29729":2132,"_20626":55129,"_5":14148,"_27027":55077,"_2882":55130},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3396":2150,"_29729":2132,"_20626":55132,"_5":14148,"_27027":55077,"_2882":55133},[],"7 days.",{"_3396":2151,"_29729":2132,"_20626":55135,"_5":14148,"_27027":55077,"_2882":55136},[],"`refresh_interval`",{"_3396":2152,"_29729":2132,"_20626":55138,"_5":14148,"_27027":55077,"_2882":55139},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3396":2153,"_29729":2132,"_20626":55141,"_5":14148,"_27027":55077,"_2882":55142},[],"6 days and 23 hours.",{"_3396":2154,"_29729":2132,"_20626":55144,"_5":14148,"_27027":55077,"_2882":55145},[],"`regenerate_on_revoke`",{"_3396":2155,"_29729":2132,"_20626":55147,"_5":14148,"_27027":55077,"_2882":55148},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3396":2156,"_29729":2132,"_20626":55150,"_5":14148,"_27027":55077,"_2882":55151},[],"`true`.",{"_3396":2157,"_29729":2132,"_20626":55153,"_5":14148,"_27027":55077,"_2882":55154},[],"`signer_certificate_serial_number`",{"_3396":2158,"_29729":2132,"_20626":55156,"_5":14148,"_27027":55077,"_2882":55157},[],"Serial number of the existing certificate that signs the CRL.",{"_3396":2159,"_29729":2132,"_20626":55159,"_5":14148,"_27027":55077,"_2882":55160},[],"Serial number of the CA’s current certificate.",{"_3396":2160,"_29729":2132,"_20626":55162,"_5":14148,"_27027":55077,"_2882":55163},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3396":2161,"_29729":2132,"_20626":55165,"_5":14148,"_27027":55077,"_2882":55166},[],"When a CA is reissued and the role’s signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the role uses it (the API rejects it with `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3396":2162,"_29729":2132,"_20626":55168,"_5":14148,"_27027":55077,"_2882":55169},[],"When a CA is deleted, its VA role is kept and cannot be removed through the API. If no other CA with the same SKI remains, the role can be read but any `PUT` returns 404, and the renewal job logs a warning on every cycle because it no longer finds the CA. The API offers no way out; it can only be fixed by editing the database. If another CA with that SKI remains, the role is still editable (see CAs that share a key). Adjust validity and signer before deleting the CA.",{"_3396":2163,"_29729":2132,"_20626":55171,"_5":14148,"_27027":55077,"_2882":55172},[],"A CA whose certificate lacks `cRLSign` cannot generate its CRL or edit its role (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and set it as the signer with `PUT`. After reissuing a CA, check the key usage of the new certificate: if it lacks `cRLSign`, the VA keeps the previous signer and logs a warning, so the lists keep being signed by the superseded certificate until you fix the usage.",{"_3396":2164,"_29729":2132,"_20626":55174,"_5":14148,"_27027":55077,"_2882":55175},[],"`PUT` always validates the signer, even when the request does not change it. If the stored signer is no longer valid, no field of the role can be modified, not even the validity, until a valid one is set.",{"_3396":2165,"_29729":2132,"_20626":55177,"_5":14148,"_27027":55077,"_2882":55178},[],"Sharing a key between CAs can prevent CRL validation. See CAs that share a key.",{"_3396":2166,"_29729":2132,"_20626":55180,"_5":14148,"_27027":55077,"_2882":55181},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3396":2167,"_29729":2132,"_20626":55183,"_5":14148,"_27027":55081,"_2882":55184},[],"The VA identifies each CRL by the CA’s SKI, and the SKI is derived from its key. Two CAs with the same key have the same SKI and share a single VA role and a single CRL. This happens when a CA is created on an existing KMS key, or when a CA is imported whose certificate declares an SKI already in use. Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. The first CA creates the role and the others keep it.",{"_3396":2168,"_29729":2132,"_20626":55186,"_5":14148,"_27027":55081,"_2882":55187},[],"The certificates of all of them point to `/crl/{ski}`, but the published list has the first CA as issuer and only includes its revocations. A verifier compares the CRL issuer with the issuer of the certificate it validates (RFC 5280, §6.3.2) and rejects the list if they differ. Depending on its policy, the certificate is blocked (*hard-fail*) or accepted even though it is revoked (*soft-fail*). Revocations of the secondary CAs do not appear in any list.",{"_3396":2169,"_29729":2132,"_20626":55189,"_5":14148,"_27027":55081,"_2882":55190},[],"If the first CA is deleted, CRL generation for the remaining one fails because the configured signer no longer matches a CA with that name. Until the role’s signer is updated to a certificate of the remaining CA, the last published list keeps being served until it expires (7 days by default).",{"_3396":2170,"_29729":2132,"_20626":55192,"_5":14148,"_27027":55081,"_2882":55193},[],"Before upgrading, review CAs that share a key. To detect the problem, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued. A CA imported with an SKI already in use does not replace the existing one as CRL issuer, because the issuer is resolved from the role’s signer. However, its own certificates point to that same URL and its revocations are not published. Until Lamassu rejects these imports, restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same collision, so also avoid reusing keys across CAs. A per-CA CRL and the rejection of imports whose SKI collides with an existing CA are both proposed in lamassuiot#834, and neither is implemented yet.",{"_3396":2171,"_29729":2132,"_20626":55195,"_5":14148,"_27027":55085,"_2882":55196},[],"The VA scheduled job checks every role on each run and requests a new list when either of these conditions is met:",{"_3396":2172,"_29729":2132,"_20626":55198,"_5":14148,"_27027":55085,"_2882":55199},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3396":2173,"_29729":2132,"_20626":55201,"_5":14148,"_27027":55085,"_2882":55202},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3396":2174,"_29729":2132,"_20626":55204,"_5":14148,"_27027":55085,"_2882":55205},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3396":2175,"_29729":2132,"_20626":55207,"_5":14148,"_27027":55085,"_2882":55208},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3396":2176,"_29729":2132,"_20626":55210,"_5":14148,"_27027":55085,"_2882":55211},[],"If generation fails (for example, because of a role without a CA or an invalid signer), the job logs the warning `something went wrong while calculating CRL for CA <ski>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3396":2177,"_29729":2132,"_20626":55213,"_5":14148,"_27027":55085,"_2882":55214},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no VA role, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3396":2178,"_29729":2132,"_20626":55216,"_5":14148,"_27027":55085,"_2882":55217},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3396":2179,"_29729":2132,"_20626":55219,"_5":14148,"_27027":55089,"_2882":55220},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3396":2180,"_29729":2132,"_20626":55222,"_5":14148,"_27027":55089,"_2882":55223},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3396":2181,"_29729":2132,"_20626":55225,"_5":14148,"_27027":55093,"_2882":55226},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3396":2182,"_29729":2132,"_20626":55228,"_5":14148,"_27027":55093,"_2882":55229},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3396":2183,"_29729":2132,"_20626":55231,"_5":14148,"_27027":55093,"_2882":55232},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the role points to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3396":2184,"_29729":2132,"_20626":55234,"_5":14148,"_27027":55093,"_2882":55235},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3396":2185,"_29729":2132,"_20626":55237,"_5":14148,"_27027":55093,"_2882":55238},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3396":2186,"_29729":2132,"_20626":55240,"_5":14148,"_27027":55097,"_2882":55241},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3396":2187,"_29729":2132,"_20626":55243,"_5":14148,"_27027":55097,"_2882":51664},[],{"_3396":2188,"_29729":2132,"_20626":55245,"_5":14148,"_27027":55097,"_2882":55246},[],"Relative path",{"_3396":2189,"_29729":2132,"_20626":55248,"_5":14148,"_27027":55097,"_2882":51661},[],{"_3396":2190,"_29729":2132,"_20626":55250,"_5":14148,"_27027":55097,"_2882":55251},[],"`GET`",{"_3396":2191,"_29729":2132,"_20626":55253,"_5":14148,"_27027":55097,"_2882":55254},[],"`/v1/roles/{ca-ski}`",{"_3396":2192,"_29729":2132,"_20626":55256,"_5":14148,"_27027":55097,"_2882":55257},[],"Read `crl_options` and `latest_crl`.",{"_3396":2193,"_29729":2132,"_20626":55259,"_5":14148,"_27027":55097,"_2882":55260},[],"`PUT`",{"_3396":2194,"_29729":2132,"_20626":55262,"_5":14148,"_27027":55097,"_2882":55254},[],{"_3396":2195,"_29729":2132,"_20626":55264,"_5":14148,"_27027":55097,"_2882":55265},[],"Replace CRL configuration.",{"_3396":2196,"_29729":2132,"_20626":55267,"_5":14148,"_27027":55097,"_2882":55268},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3396":2197,"_29729":2132,"_20626":55270,"_5":14148,"_27027":55097,"_2882":55271},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3396":2198,"_29729":2132,"_20626":55273,"_5":14148,"_27027":55101,"_2882":55274},[],"Symptom",{"_3396":2199,"_29729":2132,"_20626":55276,"_5":14148,"_27027":55101,"_2882":55277},[],"Cause",{"_3396":2200,"_29729":2132,"_20626":55279,"_5":14148,"_27027":55101,"_2882":55280},[],"Action",{"_3396":2201,"_29729":2132,"_20626":55282,"_5":14148,"_27027":55101,"_2882":55283},[],"`PUT /v1/roles/{ca-ski}` returns 404 and `GET` returns 200.",{"_3396":2202,"_29729":2132,"_20626":55285,"_5":14148,"_27027":55101,"_2882":55286},[],"The role’s CA was deleted and no other CA with the same SKI remains.",{"_3396":2203,"_29729":2132,"_20626":55288,"_5":14148,"_27027":55101,"_2882":55289},[],"There is no API way out; it requires database intervention. Avoid it by adjusting the role before deleting the CA.",{"_3396":2204,"_29729":2132,"_20626":55291,"_5":14148,"_27027":55101,"_2882":55292},[],"`PUT` returns 400.",{"_3396":2205,"_29729":2132,"_20626":55294,"_5":14148,"_27027":55101,"_2882":55295},[],"The signer lacks `cRLSign`, or its subject and key match no CA with that SKI (for example, after deleting the first of two CAs that share a key).",{"_3396":2206,"_29729":2132,"_20626":55297,"_5":14148,"_27027":55101,"_2882":55298},[],"Use `PUT` to set the serial number of a valid certificate of the remaining CA.",{"_3396":2207,"_29729":2132,"_20626":55300,"_5":14148,"_27027":55101,"_2882":55301},[],"`PUT` returns 400 from a 3.x client.",{"_3396":2208,"_29729":2132,"_20626":55303,"_5":14148,"_27027":55101,"_2882":55304},[],"`crl_options.subject_key_id_signer` was replaced by `signer_certificate_serial_number`, which is required.",{"_3396":2209,"_29729":2132,"_20626":55306,"_5":14148,"_27027":55101,"_2882":55307},[],"Update the client to send the new field.",{"_3396":2210,"_29729":2132,"_20626":55309,"_5":14148,"_27027":55101,"_2882":55310},[],"The CRL does not change after revoking a certificate.",{"_3396":2211,"_29729":2132,"_20626":55312,"_5":14148,"_27027":55101,"_2882":55313},[],"`regenerate_on_revoke` is `false`, the issuing CA has no VA role, or generation failed because of an invalid signer.",{"_3396":2212,"_29729":2132,"_20626":55315,"_5":14148,"_27027":55101,"_2882":55316},[],"Check the VA logs. A missing role only produces a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3396":2213,"_29729":2132,"_20626":55318,"_5":14148,"_27027":55101,"_2882":55319},[],"A verifier rejects the CRL because of the issuer.",{"_3396":2214,"_29729":2132,"_20626":55321,"_5":14148,"_27027":55101,"_2882":55322},[],"Several CAs share an SKI.",{"_3396":2215,"_29729":2132,"_20626":55324,"_5":14148,"_27027":55101,"_2882":55325},[],"See CAs that share a key.",{"_3396":2216,"_29729":2132,"_20626":55327,"_5":14148,"_27027":55105,"_2882":55328},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. The CA’s VA settings also let you select the CRL signer: the certificate picker only offers certificates that have a private key and carry the `cRLSign` key usage. If a configured signer’s certificate cannot be resolved, the interface shows `Unknown Certificate (Serial: X)` or `Certificate details unavailable (Serial: X)`. Diagnose differences using PKI troubleshooting.",{"_3396":2217,"_29729":2132,"_20626":55330,"_5":14148,"_27027":55109,"_2882":55331},[],"RFC 5280: X.509 and CRL profile.",{"_3396":2218,"_29729":2132,"_20626":55333,"_5":14148,"_27027":55109,"_2882":55334},[],"OpenSSL: openssl-crl.",{"_3396":2219,"_29729":2132,"_20626":55336,"_5":14148,"_27027":55109,"_2882":55337},[],"OpenSSL: openssl-verify.",{"_3396":2220,"_29729":2132,"_20626":55339,"_5":14148,"_27027":55109,"_2882":55340},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3396":2221,"_29729":2132,"_20626":55342,"_5":14148,"_27027":55109,"_2882":55343},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3396":2222,"_29729":2222,"_5":14500,"_2882":55345,"_30082":55346,"_20626":55347,"_27027":2222},"Keys and cryptographic engines",[48429,49897,53899,53900],[],{"_3396":2223,"_29729":2222,"_20626":55349,"_5":14148,"_27027":2222,"_2882":55350},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3396":2224,"_29729":2222,"_5":30079,"_20626":55352,"_27027":55353,"_2882":55354},[],"/docs/pr-preview/pr-57/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3396":2225,"_29729":2222,"_5":30079,"_20626":55356,"_27027":55357,"_2882":55358},[],"/docs/pr-preview/pr-57/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3396":2226,"_29729":2222,"_5":30079,"_20626":55360,"_27027":55361,"_2882":55362},[],"/docs/pr-preview/pr-57/platform/pki/key-management#file-system","File System",{"_3396":2227,"_29729":2222,"_5":30079,"_20626":55364,"_27027":55365,"_2882":55366},[],"/docs/pr-preview/pr-57/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3396":2228,"_29729":2222,"_5":30079,"_20626":55368,"_27027":55369,"_2882":55370},[],"/docs/pr-preview/pr-57/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3396":2229,"_29729":2222,"_5":30079,"_20626":55372,"_27027":55373,"_2882":55374},[],"/docs/pr-preview/pr-57/platform/pki/key-management#aws-kms","AWS KMS",{"_3396":2230,"_29729":2222,"_5":30079,"_20626":55376,"_27027":55377,"_2882":55378},[],"/docs/pr-preview/pr-57/platform/pki/key-management#pkcs11","PKCS#11",{"_3396":2231,"_29729":2222,"_5":30079,"_20626":55380,"_27027":55381,"_2882":55382},[],"/docs/pr-preview/pr-57/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3396":2232,"_29729":2222,"_5":30079,"_20626":55384,"_27027":55385,"_2882":55386},[],"/docs/pr-preview/pr-57/platform/pki/key-management#key-inventory","Key inventory",{"_3396":2233,"_29729":2222,"_5":30079,"_20626":55388,"_27027":55389,"_2882":55390},[],"/docs/pr-preview/pr-57/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3396":2234,"_29729":2222,"_5":30079,"_20626":55392,"_27027":55393,"_2882":55394},[],"/docs/pr-preview/pr-57/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3396":2235,"_29729":2222,"_5":30079,"_20626":55396,"_27027":55397,"_2882":55398},[],"/docs/pr-preview/pr-57/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3396":2236,"_29729":2222,"_5":30079,"_20626":55400,"_27027":55401,"_2882":55402},[],"/docs/pr-preview/pr-57/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3396":2237,"_29729":2222,"_5":30079,"_20626":55404,"_27027":55405,"_2882":55406},[],"/docs/pr-preview/pr-57/platform/pki/key-management#view-details","View details",{"_3396":2238,"_29729":2222,"_5":30079,"_20626":55408,"_27027":55409,"_2882":55410},[],"/docs/pr-preview/pr-57/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3396":2239,"_29729":2222,"_5":30079,"_20626":55412,"_27027":55413,"_2882":55414},[],"/docs/pr-preview/pr-57/platform/pki/key-management#sign","Sign",{"_3396":2240,"_29729":2222,"_5":30079,"_20626":55416,"_27027":55417,"_2882":55418},[],"/docs/pr-preview/pr-57/platform/pki/key-management#verify","Verify",{"_3396":2241,"_29729":2222,"_5":30079,"_20626":55420,"_27027":55421,"_2882":55422},[],"/docs/pr-preview/pr-57/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3396":2242,"_29729":2222,"_5":30079,"_20626":55424,"_27027":55425,"_2882":55426},[],"/docs/pr-preview/pr-57/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3396":2243,"_29729":2222,"_5":30079,"_20626":55428,"_27027":55429,"_2882":55430},[],"/docs/pr-preview/pr-57/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3396":2244,"_29729":2222,"_20626":55432,"_5":14148,"_27027":2222,"_2882":55433},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3396":2245,"_29729":2222,"_20626":55435,"_5":14148,"_27027":2222,"_2882":55436},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3396":2246,"_29729":2222,"_20626":55438,"_5":14148,"_27027":55353,"_2882":55439},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3396":2247,"_29729":2222,"_20626":55441,"_5":14148,"_27027":55353,"_2882":55442},[],"In practice, it lets you:",{"_3396":2248,"_29729":2222,"_20626":55444,"_5":14148,"_27027":55353,"_2882":55445},[],"Generate new key pairs from Lamassu IoT.",{"_3396":2249,"_29729":2222,"_20626":55447,"_5":14148,"_27027":55353,"_2882":55448},[],"Import keys created externally.",{"_3396":2250,"_29729":2222,"_20626":55450,"_5":14148,"_27027":55353,"_2882":55451},[],"Delegate custody and cryptographic operations to external engines.",{"_3396":2251,"_29729":2222,"_20626":55453,"_5":14148,"_27027":55353,"_2882":55454},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3396":2252,"_29729":2222,"_20626":55456,"_5":14148,"_27027":55357,"_2882":55457},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3396":2253,"_29729":2222,"_20626":55459,"_5":14148,"_27027":55357,"_2882":55460},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3396":2254,"_29729":2222,"_20626":55462,"_5":14148,"_27027":55357,"_2882":55463},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3396":2255,"_29729":2222,"_20626":55465,"_5":14148,"_27027":55361,"_2882":55466},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3396":2256,"_29729":2222,"_20626":55468,"_5":14148,"_27027":55365,"_2882":55469},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3396":2257,"_29729":2222,"_20626":55471,"_5":14148,"_27027":55365,"_2882":55472},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3396":2258,"_29729":2222,"_20626":55474,"_5":14148,"_27027":55369,"_2882":55475},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3396":2259,"_29729":2222,"_20626":55477,"_5":14148,"_27027":55373,"_2882":55478},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3396":2260,"_29729":2222,"_20626":55480,"_5":14148,"_27027":55377,"_2882":55481},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3396":2261,"_29729":2222,"_20626":55483,"_5":14148,"_27027":55381,"_2882":55484},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3396":2262,"_29729":2222,"_20626":55486,"_5":14148,"_27027":55381,"_2882":55487},[],"Lamassu shows the enabled engines in the console.",{"_3396":2263,"_29729":2222,"_20626":55489,"_5":14148,"_27027":55381,"_2882":55490},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3396":2264,"_29729":2222,"_20626":55492,"_5":14148,"_27027":55381,"_2882":55493},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3396":2265,"_29729":2222,"_20626":55495,"_5":14148,"_27027":55385,"_2882":55496},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3396":2266,"_29729":2222,"_20626":55498,"_5":14148,"_27027":55385,"_2882":55499},[],"The table includes the following fields:",{"_3396":2267,"_29729":2222,"_20626":55501,"_5":14148,"_27027":55385,"_2882":55502},[],"**Name**: descriptive name of the key.",{"_3396":2268,"_29729":2222,"_20626":55504,"_5":14148,"_27027":55385,"_2882":55505},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3396":2269,"_29729":2222,"_20626":55507,"_5":14148,"_27027":55385,"_2882":55508},[],"**Strength**: visual indicator of cryptographic strength.",{"_3396":2270,"_29729":2222,"_20626":55510,"_5":14148,"_27027":55385,"_2882":55511},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3396":2271,"_29729":2222,"_20626":55513,"_5":14148,"_27027":55385,"_2882":55514},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3396":2272,"_29729":2222,"_20626":55516,"_5":14148,"_27027":55385,"_2882":55517},[],"**Aliases**: alternative names associated with the key.",{"_3396":2273,"_29729":2222,"_20626":55519,"_5":14148,"_27027":55385,"_2882":55520},[],"**Tags**: labels for classification and search.",{"_3396":2274,"_29729":2222,"_20626":55522,"_5":14148,"_27027":55385,"_2882":55523},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3396":2275,"_29729":2222,"_20626":55525,"_5":14148,"_27027":55385,"_2882":55526},[],"From this view you also reach the most common actions:",{"_3396":2276,"_29729":2222,"_20626":55528,"_5":14148,"_27027":55385,"_2882":55529},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3396":2277,"_29729":2222,"_20626":55531,"_5":14148,"_27027":55385,"_2882":55532},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3396":2278,"_29729":2222,"_20626":55534,"_5":14148,"_27027":55385,"_2882":55535},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3396":2279,"_29729":2222,"_20626":55537,"_5":14148,"_27027":55385,"_2882":55538},[],"**Delete Key** to remove the key from the system.",{"_3396":2280,"_29729":2222,"_20626":55540,"_5":14148,"_27027":55389,"_2882":55541},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3396":2281,"_29729":2222,"_20626":55543,"_5":14148,"_27027":55393,"_2882":55544},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3396":2282,"_29729":2222,"_20626":55546,"_5":14148,"_27027":55393,"_2882":55547},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3396":2283,"_29729":2222,"_20626":55549,"_5":14148,"_27027":55393,"_2882":55550},[],"**Key Name**: unique and descriptive name.",{"_3396":2284,"_29729":2222,"_20626":55552,"_5":14148,"_27027":55393,"_2882":55553},[],"**Crypto Engine**: engine that will keep the key.",{"_3396":2285,"_29729":2222,"_20626":55555,"_5":14148,"_27027":55393,"_2882":55556},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3396":2286,"_29729":2222,"_20626":55558,"_5":14148,"_27027":55393,"_2882":55559},[],"**Tags**: metadata to classify the key.",{"_3396":2287,"_29729":2222,"_20626":55561,"_5":14148,"_27027":55393,"_2882":55562},[],"**Metadata**: additional information for advanced uses.",{"_3396":2288,"_29729":2222,"_20626":55564,"_5":14148,"_27027":55397,"_2882":55565},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3396":2289,"_29729":2222,"_20626":55567,"_5":14148,"_27027":55397,"_2882":55568},[],"When you have an exportable private key and the destination engine supports import.",{"_3396":2290,"_29729":2222,"_20626":55570,"_5":14148,"_27027":55397,"_2882":55571},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3396":2291,"_29729":2222,"_20626":55573,"_5":14148,"_27027":55397,"_2882":55574},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3396":2292,"_29729":2222,"_20626":55576,"_5":14148,"_27027":55397,"_2882":55577},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3396":2293,"_29729":2222,"_20626":55579,"_5":14148,"_27027":55397,"_2882":55580},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3396":2294,"_29729":2222,"_20626":55582,"_5":14148,"_27027":55397,"_2882":55583},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3396":2295,"_29729":2222,"_20626":55585,"_5":14148,"_27027":55397,"_2882":55586},[],"**Tags**: labels for organization and search.",{"_3396":2296,"_29729":2222,"_20626":55588,"_5":14148,"_27027":55397,"_2882":55589},[],"**Metadata**: additional optional information.",{"_3396":2297,"_29729":2222,"_20626":55591,"_5":14148,"_27027":55397,"_2882":55592},[],"**Private Key (PEM)**: private key in PEM format.",{"_3396":2298,"_29729":2222,"_20626":55594,"_5":14148,"_27027":55397,"_2882":55595},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3396":2299,"_29729":2222,"_20626":55597,"_5":14148,"_27027":55401,"_2882":55598},[],"Each registered key has a detail view and several operational actions.",{"_3396":2300,"_29729":2222,"_20626":55600,"_5":14148,"_27027":55405,"_2882":55601},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3396":2301,"_29729":2222,"_20626":55603,"_5":14148,"_27027":55405,"_2882":55604},[],"The **Overview** tab shows, among others, these fields:",{"_3396":2302,"_29729":2222,"_20626":55606,"_5":14148,"_27027":55405,"_2882":55607},[],"**Key Name**: descriptive name.",{"_3396":2303,"_29729":2222,"_20626":55609,"_5":14148,"_27027":55405,"_2882":55610},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3396":2304,"_29729":2222,"_20626":55612,"_5":14148,"_27027":55405,"_2882":55613},[],"**Tags**: associated labels.",{"_3396":2305,"_29729":2222,"_20626":55615,"_5":14148,"_27027":55405,"_2882":55616},[],"**Aliases**: alternative names.",{"_3396":2306,"_29729":2222,"_20626":55618,"_5":14148,"_27027":55405,"_2882":55619},[],"**Crypto Engine**: engine where the key resides.",{"_3396":2307,"_29729":2222,"_20626":55621,"_5":14148,"_27027":55405,"_2882":55622},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3396":2308,"_29729":2222,"_20626":55624,"_5":14148,"_27027":55405,"_2882":55625},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3396":2309,"_29729":2222,"_20626":55627,"_5":14148,"_27027":55405,"_2882":55628},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3396":2310,"_29729":2222,"_20626":55630,"_5":14148,"_27027":55409,"_2882":55631},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3396":2311,"_29729":2222,"_20626":55633,"_5":14148,"_27027":55409,"_2882":55634},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3396":2312,"_29729":2222,"_20626":55636,"_5":14148,"_27027":55409,"_2882":55637},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3396":2313,"_29729":2222,"_20626":55639,"_5":14148,"_27027":55413,"_2882":55640},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3396":2314,"_29729":2222,"_20626":55642,"_5":14148,"_27027":55413,"_2882":55643},[],"Main fields:",{"_3396":2315,"_29729":2222,"_20626":55645,"_5":14148,"_27027":55413,"_2882":55646},[],"**Algorithm**: signing algorithm available for the key type.",{"_3396":2316,"_29729":2222,"_20626":55648,"_5":14148,"_27027":55413,"_2882":55649},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3396":2317,"_29729":2222,"_20626":55651,"_5":14148,"_27027":55413,"_2882":55652},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3396":2318,"_29729":2222,"_20626":55654,"_5":14148,"_27027":55413,"_2882":55655},[],"**Message**: content to sign.",{"_3396":2319,"_29729":2222,"_20626":55657,"_5":14148,"_27027":55413,"_2882":55658},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3396":2320,"_29729":2222,"_20626":55660,"_5":14148,"_27027":55417,"_2882":55661},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3396":2321,"_29729":2222,"_20626":55663,"_5":14148,"_27027":55417,"_2882":55643},[],{"_3396":2322,"_29729":2222,"_20626":55665,"_5":14148,"_27027":55417,"_2882":55666},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3396":2323,"_29729":2222,"_20626":55668,"_5":14148,"_27027":55417,"_2882":55669},[],"**Message Type**: `Raw` or `Digest`.",{"_3396":2324,"_29729":2222,"_20626":55671,"_5":14148,"_27027":55417,"_2882":55672},[],"**Payload Encoding**: encoding of the message.",{"_3396":2325,"_29729":2222,"_20626":55674,"_5":14148,"_27027":55417,"_2882":55675},[],"**Message**: original message or hash.",{"_3396":2326,"_29729":2222,"_20626":55677,"_5":14148,"_27027":55417,"_2882":55678},[],"**Signature**: signature to check.",{"_3396":2327,"_29729":2222,"_20626":55680,"_5":14148,"_27027":55417,"_2882":55681},[],"**Result**: indicator of the validation result.",{"_3396":2328,"_29729":2222,"_20626":55683,"_5":14148,"_27027":55421,"_2882":55684},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3396":2329,"_29729":2222,"_20626":55686,"_5":14148,"_27027":55421,"_2882":55687},[],"This flow is useful for:",{"_3396":2330,"_29729":2222,"_20626":55689,"_5":14148,"_27027":55421,"_2882":55690},[],"Requesting certificates from an external CA.",{"_3396":2331,"_29729":2222,"_20626":55692,"_5":14148,"_27027":55421,"_2882":55693},[],"Renewing an identity while keeping the same key.",{"_3396":2332,"_29729":2222,"_20626":55695,"_5":14148,"_27027":55421,"_2882":55696},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3396":2333,"_29729":2222,"_20626":55698,"_5":14148,"_27027":55421,"_2882":55699},[],"**Common Name (CN)**: main name of the identity.",{"_3396":2334,"_29729":2222,"_20626":55701,"_5":14148,"_27027":55421,"_2882":55702},[],"**Organization (O)**: organization or company.",{"_3396":2335,"_29729":2222,"_20626":55704,"_5":14148,"_27027":55421,"_2882":55705},[],"**Organizational Unit (OU)**: department or unit.",{"_3396":2336,"_29729":2222,"_20626":55707,"_5":14148,"_27027":55421,"_2882":55708},[],"**Country (C)**: two-letter country code.",{"_3396":2337,"_29729":2222,"_20626":55710,"_5":14148,"_27027":55421,"_2882":55711},[],"**State / Province (ST)**: state or province.",{"_3396":2338,"_29729":2222,"_20626":55713,"_5":14148,"_27027":55421,"_2882":55714},[],"**Locality (L)**: city or locality.",{"_3396":2339,"_29729":2222,"_20626":55716,"_5":14148,"_27027":55421,"_2882":55717},[],"**Email Address**: contact email.",{"_3396":2340,"_29729":2222,"_20626":55719,"_5":14148,"_27027":55421,"_2882":55720},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3396":2341,"_29729":2222,"_20626":55722,"_5":14148,"_27027":55421,"_2882":55723},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3396":2342,"_29729":2222,"_20626":55725,"_5":14148,"_27027":55425,"_2882":55726},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3396":2343,"_29729":2222,"_20626":55728,"_5":14148,"_27027":55425,"_2882":55729},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3396":2344,"_29729":2222,"_20626":55731,"_5":14148,"_27027":55429,"_2882":55732},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3396":2345,"_29729":2222,"_20626":55734,"_5":14148,"_27027":55429,"_2882":55735},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. No operation releases a reference on its own. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3396":2346,"_29729":2346,"_5":14500,"_2882":55737,"_30082":55738,"_20626":55739,"_27027":2346},"Online validation with OCSP",[48429,49897,53899,54538],[],{"_3396":2347,"_29729":2346,"_20626":55741,"_5":14148,"_27027":2346,"_2882":55742},[],"Query signed status and verify the responder’s response.",{"_3396":2348,"_29729":2346,"_5":30079,"_20626":55744,"_27027":55745,"_2882":55746},[],"/docs/pr-preview/pr-57/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3396":2349,"_29729":2346,"_5":30079,"_20626":55748,"_27027":55749,"_2882":55750},[],"/docs/pr-preview/pr-57/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3396":2350,"_29729":2346,"_5":30079,"_20626":55752,"_27027":55753,"_2882":55754},[],"/docs/pr-preview/pr-57/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3396":2351,"_29729":2346,"_5":30079,"_20626":55756,"_27027":55757,"_2882":55758},[],"/docs/pr-preview/pr-57/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3396":2352,"_29729":2346,"_5":30079,"_20626":55760,"_27027":55761,"_2882":55762},[],"/docs/pr-preview/pr-57/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3396":2353,"_29729":2346,"_5":30079,"_20626":55764,"_27027":55765,"_2882":55110},[],"/docs/pr-preview/pr-57/platform/pki/ocsp#references",{"_3396":2354,"_29729":2346,"_20626":55767,"_5":14148,"_27027":2346,"_2882":55768},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3396":2355,"_29729":2346,"_20626":55770,"_5":14148,"_27027":55745,"_2882":55771},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3396":2356,"_29729":2346,"_20626":55773,"_5":14148,"_27027":55745,"_2882":55774},[],"Record status",{"_3396":2357,"_29729":2346,"_20626":55776,"_5":14148,"_27027":55745,"_2882":55777},[],"Signed response",{"_3396":2358,"_29729":2346,"_20626":55779,"_5":14148,"_27027":55745,"_2882":53036},[],{"_3396":2359,"_29729":2346,"_20626":55781,"_5":14148,"_27027":55745,"_2882":55782},[],"`Good`.",{"_3396":2360,"_29729":2346,"_20626":55784,"_5":14148,"_27027":55745,"_2882":53053},[],{"_3396":2361,"_29729":2346,"_20626":55786,"_5":14148,"_27027":55745,"_2882":55787},[],"`Revoked`, with revocation reason and timestamp.",{"_3396":2362,"_29729":2346,"_20626":55789,"_5":14148,"_27027":55745,"_2882":55790},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3396":2363,"_29729":2346,"_20626":55792,"_5":14148,"_27027":55745,"_2882":55793},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3396":2364,"_29729":2346,"_20626":55795,"_5":14148,"_27027":55745,"_2882":55796},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3396":2365,"_29729":2346,"_20626":55798,"_5":14148,"_27027":55745,"_2882":55799},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3396":2366,"_29729":2346,"_20626":55801,"_5":14148,"_27027":55745,"_2882":55802},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3396":2367,"_29729":2346,"_20626":55804,"_5":14148,"_27027":55749,"_2882":55805},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3396":2368,"_29729":2346,"_20626":55807,"_5":14148,"_27027":55749,"_2882":55808},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3396":2369,"_29729":2346,"_20626":55810,"_5":14148,"_27027":55753,"_2882":55811},[],"The service accepts:",{"_3396":2370,"_29729":2346,"_20626":55813,"_5":14148,"_27027":55753,"_2882":51664},[],{"_3396":2371,"_29729":2346,"_20626":55815,"_5":14148,"_27027":55753,"_2882":55816},[],"VA service path",{"_3396":2372,"_29729":2346,"_20626":55818,"_5":14148,"_27027":55753,"_2882":55819},[],"Format",{"_3396":2373,"_29729":2346,"_20626":55821,"_5":14148,"_27027":55753,"_2882":55822},[],"`POST`",{"_3396":2374,"_29729":2346,"_20626":55824,"_5":14148,"_27027":55753,"_2882":55825},[],"`/ocsp`",{"_3396":2375,"_29729":2346,"_20626":55827,"_5":14148,"_27027":55753,"_2882":55828},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3396":2376,"_29729":2346,"_20626":55830,"_5":14148,"_27027":55753,"_2882":55251},[],{"_3396":2377,"_29729":2346,"_20626":55832,"_5":14148,"_27027":55753,"_2882":55833},[],"`/ocsp/{ocsp_request}`",{"_3396":2378,"_29729":2346,"_20626":55835,"_5":14148,"_27027":55753,"_2882":55836},[],"DER request encoded using padded URL Base64.",{"_3396":2379,"_29729":2346,"_20626":55838,"_5":14148,"_27027":55753,"_2882":55839},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3396":2380,"_29729":2346,"_20626":55841,"_5":14148,"_27027":55757,"_2882":55842},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3396":2381,"_29729":2346,"_20626":55844,"_5":14148,"_27027":55757,"_2882":55845},[],"Generate the request:",{"_3396":2382,"_29729":2346,"_20626":55847,"_5":14148,"_27027":55757,"_2882":55848},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3396":2383,"_29729":2346,"_20626":55850,"_5":14148,"_27027":55757,"_2882":55851},[],"Replace the example URL with the inspected endpoint:",{"_3396":2384,"_29729":2346,"_20626":55853,"_5":14148,"_27027":55757,"_2882":55854},[],"Verify the returned DER:",{"_3396":2385,"_29729":2346,"_20626":55856,"_5":14148,"_27027":55757,"_2882":55857},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3396":2386,"_29729":2346,"_20626":55859,"_5":14148,"_27027":55761,"_2882":55860},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3396":2387,"_29729":2346,"_20626":55862,"_5":14148,"_27027":55761,"_2882":55863},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3396":2388,"_29729":2346,"_20626":55865,"_5":14148,"_27027":55765,"_2882":55866},[],"RFC 6960: OCSP.",{"_3396":2389,"_29729":2346,"_20626":55868,"_5":14148,"_27027":55765,"_2882":55869},[],"OpenSSL: openssl-ocsp.",{"_3396":2390,"_29729":2346,"_20626":55871,"_5":14148,"_27027":55765,"_2882":55872},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3396":2391,"_29729":2346,"_20626":55874,"_5":14148,"_27027":55765,"_2882":55343},[],{"_3396":2392,"_29729":2392,"_5":14500,"_2882":53899,"_30082":55876,"_20626":55877,"_27027":2392},[48429,49897,53899],[],{"_3396":2393,"_29729":2392,"_20626":55879,"_5":14148,"_27027":2392,"_2882":55880},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3396":2394,"_29729":2392,"_5":30079,"_20626":55882,"_27027":55883,"_2882":53211},[],"/docs/pr-preview/pr-57/platform/pki/overview#start-here",{"_3396":2395,"_29729":2392,"_5":30079,"_20626":55885,"_27027":55886,"_2882":55887},[],"/docs/pr-preview/pr-57/platform/pki/overview#what-you-need","What you need",{"_3396":2396,"_29729":2392,"_5":30079,"_20626":55889,"_27027":55890,"_2882":53743},[],"/docs/pr-preview/pr-57/platform/pki/overview#core-capabilities",{"_3396":2397,"_29729":2392,"_5":30079,"_20626":55892,"_27027":55893,"_2882":53747},[],"/docs/pr-preview/pr-57/platform/pki/overview#build-your-trust-hierarchy",{"_3396":2398,"_29729":2392,"_5":30079,"_20626":55895,"_27027":55896,"_2882":53751},[],"/docs/pr-preview/pr-57/platform/pki/overview#protect-cryptographic-keys",{"_3396":2399,"_29729":2392,"_5":30079,"_20626":55898,"_27027":55899,"_2882":53755},[],"/docs/pr-preview/pr-57/platform/pki/overview#issue-and-control-certificates",{"_3396":2400,"_29729":2392,"_5":30079,"_20626":55901,"_27027":55902,"_2882":53763},[],"/docs/pr-preview/pr-57/platform/pki/overview#publish-validation-status",{"_3396":2401,"_29729":2392,"_5":30079,"_20626":55904,"_27027":55905,"_2882":55906},[],"/docs/pr-preview/pr-57/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3396":2402,"_29729":2392,"_5":30079,"_20626":55908,"_27027":55909,"_2882":54705},[],"/docs/pr-preview/pr-57/platform/pki/overview#continue",{"_3396":2403,"_29729":2392,"_20626":55911,"_5":14148,"_27027":2392,"_2882":55912},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3396":2404,"_29729":2392,"_20626":55914,"_5":14148,"_27027":55883,"_2882":55915},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3396":2405,"_29729":2392,"_20626":55917,"_5":14148,"_27027":55883,"_2882":55918},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3396":2406,"_29729":2392,"_20626":55920,"_5":14148,"_27027":55886,"_2882":55921},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3396":2407,"_29729":2392,"_20626":55923,"_5":14148,"_27027":55886,"_2882":55924},[],"An available cryptographic engine to keep the authority's key.",{"_3396":2408,"_29729":2392,"_20626":55926,"_5":14148,"_27027":55886,"_2882":55927},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3396":2409,"_29729":2392,"_20626":55929,"_5":14148,"_27027":55886,"_2882":55930},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3396":2410,"_29729":2392,"_20626":55932,"_5":14148,"_27027":55886,"_2882":55933},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3396":2411,"_29729":2392,"_20626":55935,"_5":14148,"_27027":55893,"_2882":55936},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3396":2412,"_29729":2392,"_20626":55938,"_5":14148,"_27027":55896,"_2882":55939},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3396":2413,"_29729":2392,"_20626":55941,"_5":14148,"_27027":55899,"_2882":55942},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3396":2414,"_29729":2392,"_20626":55944,"_5":14148,"_27027":55902,"_2882":55945},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3396":2415,"_29729":2392,"_20626":55947,"_5":14148,"_27027":55905,"_2882":55948},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3396":2416,"_29729":2392,"_20626":55950,"_5":14148,"_27027":55905,"_2882":55951},[],"its subject and extensions identify the expected client;",{"_3396":2417,"_29729":2392,"_20626":55953,"_5":14148,"_27027":55905,"_2882":55954},[],"its public key matches the client's private key;",{"_3396":2418,"_29729":2392,"_20626":55956,"_5":14148,"_27027":55905,"_2882":55957},[],"its chain reaches a root trusted by the consumer;",{"_3396":2419,"_29729":2392,"_20626":55959,"_5":14148,"_27027":55905,"_2882":55960},[],"its dates and usages allow the operation;",{"_3396":2420,"_29729":2392,"_20626":55962,"_5":14148,"_27027":55905,"_2882":55963},[],"the consumer applies revocation checks and authorization.",{"_3396":2421,"_29729":2392,"_20626":55965,"_5":14148,"_27027":55905,"_2882":55966},[],"The issuance path includes the first independent checks.",{"_3396":2422,"_29729":2392,"_20626":55968,"_5":14148,"_27027":55909,"_2882":55969},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3396":2423,"_29729":2392,"_20626":55971,"_5":14148,"_27027":55909,"_2882":55972},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3396":2424,"_29729":2392,"_20626":55974,"_5":14148,"_27027":55909,"_2882":55975},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3396":2425,"_29729":2425,"_5":14500,"_2882":55977,"_30082":55978,"_20626":55979,"_27027":2425},"Create your first CA",[48429,49897,53899,53336],[],{"_3396":2426,"_29729":2425,"_20626":55981,"_5":14148,"_27027":2425,"_2882":55982},[],"Create an evaluation root and check its certificate before issuing.",{"_3396":2427,"_29729":2425,"_5":30079,"_20626":55984,"_27027":55985,"_2882":48439},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3396":2428,"_29729":2425,"_5":30079,"_20626":55987,"_27027":55988,"_2882":55989},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3396":2429,"_29729":2425,"_5":30079,"_20626":55991,"_27027":55992,"_2882":55993},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3396":2430,"_29729":2425,"_5":30079,"_20626":55995,"_27027":55996,"_2882":55997},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3396":2431,"_29729":2425,"_5":30079,"_20626":55999,"_27027":56000,"_2882":56001},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3396":2432,"_29729":2425,"_5":30079,"_20626":56003,"_27027":56004,"_2882":56005},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3396":2433,"_29729":2425,"_5":30079,"_20626":56007,"_27027":56008,"_2882":56009},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3396":2434,"_29729":2425,"_5":30079,"_20626":56011,"_27027":56012,"_2882":53593},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3396":2435,"_29729":2425,"_5":30079,"_20626":56014,"_27027":56015,"_2882":48463},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3396":2436,"_29729":2425,"_20626":56017,"_5":14148,"_27027":2425,"_2882":56018},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3396":2437,"_29729":2425,"_20626":56020,"_5":14148,"_27027":55985,"_2882":56021},[],"Console access and permission to create keys and authorities.",{"_3396":2438,"_29729":2425,"_20626":56023,"_5":14148,"_27027":55985,"_2882":56024},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3396":2439,"_29729":2425,"_20626":56026,"_5":14148,"_27027":55985,"_2882":56027},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3396":2440,"_29729":2425,"_20626":56029,"_5":14148,"_27027":55985,"_2882":56030},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3396":2441,"_29729":2425,"_20626":56032,"_5":14148,"_27027":55988,"_2882":56033},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3396":2442,"_29729":2425,"_20626":56035,"_5":14148,"_27027":55988,"_2882":56036},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3396":2443,"_29729":2425,"_20626":56038,"_5":14148,"_27027":55992,"_2882":56039},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3396":2444,"_29729":2425,"_20626":56041,"_5":14148,"_27027":55992,"_2882":56042},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3396":2445,"_29729":2425,"_20626":56044,"_5":14148,"_27027":55996,"_2882":56045},[],"Select **Root CA** and complete:",{"_3396":2446,"_29729":2425,"_20626":56047,"_5":14148,"_27027":55996,"_2882":56048},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3396":2447,"_29729":2425,"_20626":56050,"_5":14148,"_27027":55996,"_2882":56051},[],"**Subject**: organization and country details for your evaluation.",{"_3396":2448,"_29729":2425,"_20626":56053,"_5":14148,"_27027":55996,"_2882":56054},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3396":2449,"_29729":2425,"_20626":56056,"_5":14148,"_27027":55996,"_2882":56057},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3396":2450,"_29729":2425,"_20626":56059,"_5":14148,"_27027":55996,"_2882":56060},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3396":2451,"_29729":2425,"_20626":56062,"_5":14148,"_27027":56000,"_2882":56063},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3396":2452,"_29729":2425,"_20626":56065,"_5":14148,"_27027":56004,"_2882":56066},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3396":2453,"_29729":2425,"_20626":56068,"_5":14148,"_27027":56004,"_2882":56069},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3396":2454,"_29729":2425,"_20626":56071,"_5":14148,"_27027":56008,"_2882":56072},[],"Run from the directory where you saved `ca.pem`:",{"_3396":2455,"_29729":2425,"_20626":56074,"_5":14148,"_27027":56008,"_2882":56075},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3396":2456,"_29729":2425,"_20626":56077,"_5":14148,"_27027":56008,"_2882":56078},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3396":2457,"_29729":2425,"_20626":56080,"_5":14148,"_27027":56012,"_2882":56081},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3396":2458,"_29729":2425,"_20626":56083,"_5":14148,"_27027":56012,"_2882":56084},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3396":2459,"_29729":2425,"_20626":56086,"_5":14148,"_27027":56012,"_2882":56087},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3396":2460,"_29729":2425,"_20626":56089,"_5":14148,"_27027":56012,"_2882":56090},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3396":2461,"_29729":2425,"_20626":56092,"_5":14148,"_27027":56015,"_2882":56093},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3396":2462,"_29729":2462,"_5":14500,"_2882":56095,"_30082":56096,"_20626":56097,"_27027":2462},"Issue and verify a certificate",[48429,49897,53899,53336],[],{"_3396":2463,"_29729":2462,"_20626":56099,"_5":14148,"_27027":2462,"_2882":56100},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3396":2464,"_29729":2462,"_5":30079,"_20626":56102,"_27027":56103,"_2882":48439},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3396":2465,"_29729":2462,"_5":30079,"_20626":56105,"_27027":56106,"_2882":56107},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3396":2466,"_29729":2462,"_5":30079,"_20626":56109,"_27027":56110,"_2882":56111},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3396":2467,"_29729":2462,"_5":30079,"_20626":56113,"_27027":56114,"_2882":56115},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3396":2468,"_29729":2462,"_5":30079,"_20626":56117,"_27027":56118,"_2882":56119},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3396":2469,"_29729":2462,"_5":30079,"_20626":56121,"_27027":56122,"_2882":56123},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3396":2470,"_29729":2462,"_5":30079,"_20626":56125,"_27027":56126,"_2882":56127},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3396":2471,"_29729":2462,"_5":30079,"_20626":56129,"_27027":56130,"_2882":56131},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3396":2472,"_29729":2462,"_5":30079,"_20626":56133,"_27027":56134,"_2882":56135},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3396":2473,"_29729":2462,"_5":30079,"_20626":56137,"_27027":56138,"_2882":56139},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3396":2474,"_29729":2462,"_5":30079,"_20626":56141,"_27027":56142,"_2882":53593},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3396":2475,"_29729":2462,"_5":30079,"_20626":56144,"_27027":56145,"_2882":48463},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/issue-certificate#next-step",{"_3396":2476,"_29729":2462,"_20626":56147,"_5":14148,"_27027":2462,"_2882":56148},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3396":2477,"_29729":2462,"_20626":56150,"_5":14148,"_27027":56103,"_2882":56151},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3396":2478,"_29729":2462,"_20626":56153,"_5":14148,"_27027":56103,"_2882":56154},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3396":2479,"_29729":2462,"_20626":56156,"_5":14148,"_27027":56103,"_2882":56157},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3396":2480,"_29729":2462,"_20626":56159,"_5":14148,"_27027":56103,"_2882":56160},[],"A client identifier: here we use `device-001`.",{"_3396":2481,"_29729":2462,"_20626":56162,"_5":14148,"_27027":56103,"_2882":56163},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3396":2482,"_29729":2462,"_20626":56165,"_5":14148,"_27027":56106,"_2882":56166},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3396":2483,"_29729":2462,"_20626":56168,"_5":14148,"_27027":56110,"_2882":56169},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3396":2484,"_29729":2462,"_20626":56171,"_5":14148,"_27027":56110,"_2882":56172},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3396":2485,"_29729":2462,"_20626":56174,"_5":14148,"_27027":56114,"_2882":56175},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3396":2486,"_29729":2462,"_20626":56177,"_5":14148,"_27027":56114,"_2882":56178},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3396":2487,"_29729":2462,"_20626":56180,"_5":14148,"_27027":56118,"_2882":56181},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3396":2488,"_29729":2462,"_20626":56183,"_5":14148,"_27027":56118,"_2882":56184},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3396":2489,"_29729":2462,"_20626":56186,"_5":14148,"_27027":56122,"_2882":56187},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3396":2490,"_29729":2462,"_20626":56189,"_5":14148,"_27027":56126,"_2882":56190},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3396":2491,"_29729":2462,"_20626":56192,"_5":14148,"_27027":56130,"_2882":56193},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3396":2492,"_29729":2462,"_20626":56195,"_5":14148,"_27027":56134,"_2882":56196},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3396":2493,"_29729":2462,"_20626":56198,"_5":14148,"_27027":56134,"_2882":56199},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3396":2494,"_29729":2462,"_20626":56201,"_5":14148,"_27027":56134,"_2882":56202},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3396":2495,"_29729":2462,"_20626":56204,"_5":14148,"_27027":56138,"_2882":56205},[],"In Bash, compare the two public-key digests:",{"_3396":2496,"_29729":2462,"_20626":56207,"_5":14148,"_27027":56138,"_2882":56208},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3396":2497,"_29729":2462,"_20626":56210,"_5":14148,"_27027":56138,"_2882":56211},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3396":2498,"_29729":2462,"_20626":56213,"_5":14148,"_27027":56142,"_2882":53677},[],{"_3396":2499,"_29729":2462,"_20626":56215,"_5":14148,"_27027":56142,"_2882":56216},[],"What to review",{"_3396":2500,"_29729":2462,"_20626":56218,"_5":14148,"_27027":56142,"_2882":56219},[],"The CA rejects issuance",{"_3396":2501,"_29729":2462,"_20626":56221,"_5":14148,"_27027":56142,"_2882":56222},[],"Permissions, CA state and key, algorithm and profile.",{"_3396":2502,"_29729":2462,"_20626":56224,"_5":14148,"_27027":56142,"_2882":56225},[],"Different subject or usages",{"_3396":2503,"_29729":2462,"_20626":56227,"_5":14148,"_27027":56142,"_2882":56228},[],"Applied profile and requested values.",{"_3396":2504,"_29729":2462,"_20626":56230,"_5":14148,"_27027":56142,"_2882":56231},[],"Issuer cannot be found",{"_3396":2505,"_29729":2462,"_20626":56233,"_5":14148,"_27027":56142,"_2882":56234},[],"Downloaded CA and required intermediate chain.",{"_3396":2506,"_29729":2462,"_20626":56236,"_5":14148,"_27027":56142,"_2882":56237},[],"Validity fails",{"_3396":2507,"_29729":2462,"_20626":56239,"_5":14148,"_27027":56142,"_2882":56240},[],"Certificate and CA dates, and the computer's clock.",{"_3396":2508,"_29729":2462,"_20626":56242,"_5":14148,"_27027":56142,"_2882":56243},[],"Public-key digests differ",{"_3396":2509,"_29729":2462,"_20626":56245,"_5":14148,"_27027":56142,"_2882":56246},[],"Certificate and key files from the same issuance.",{"_3396":2510,"_29729":2462,"_20626":56248,"_5":14148,"_27027":56142,"_2882":56249},[],"See PKI diagnostics to narrow an issuance failure.",{"_3396":2511,"_29729":2462,"_20626":56251,"_5":14148,"_27027":56145,"_2882":56252},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3396":2512,"_29729":2462,"_20626":56254,"_5":14148,"_27027":56145,"_2882":56255},[],"Manage certificates for inspection, status and revocation.",{"_3396":2513,"_29729":2462,"_20626":56257,"_5":14148,"_27027":56145,"_2882":56258},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3396":2514,"_29729":2462,"_20626":56260,"_5":14148,"_27027":56145,"_2882":56261},[],"Prepare EST for the device to request its next identities.",{"_3396":2515,"_29729":2462,"_20626":56263,"_5":14148,"_27027":56145,"_2882":56264},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3396":2516,"_29729":2516,"_5":14500,"_2882":56266,"_30082":56267,"_20626":56268,"_27027":2516},"PKI getting started",[48429,49897,53899,53336],[],{"_3396":2517,"_29729":2516,"_20626":56270,"_5":14148,"_27027":2516,"_2882":56271},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3396":2518,"_29729":2516,"_5":30079,"_20626":56273,"_27027":56274,"_2882":48439},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/overview#before-you-begin",{"_3396":2519,"_29729":2516,"_5":30079,"_20626":56276,"_27027":56277,"_2882":56278},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3396":2520,"_29729":2516,"_5":30079,"_20626":56280,"_27027":56281,"_2882":53528},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/overview#expected-result",{"_3396":2521,"_29729":2516,"_5":30079,"_20626":56283,"_27027":56284,"_2882":56285},[],"/docs/pr-preview/pr-57/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3396":2522,"_29729":2516,"_20626":56287,"_5":14148,"_27027":2516,"_2882":56288},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3396":2523,"_29729":2516,"_20626":56290,"_5":14148,"_27027":56274,"_2882":56291},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3396":2524,"_29729":2516,"_20626":56293,"_5":14148,"_27027":56274,"_2882":56294},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3396":2525,"_29729":2516,"_20626":56296,"_5":14148,"_27027":56274,"_2882":56297},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3396":2526,"_29729":2516,"_20626":56299,"_5":14148,"_27027":56274,"_2882":56300},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3396":2527,"_29729":2516,"_20626":56302,"_5":14148,"_27027":56274,"_2882":56303},[],"A working directory with restricted access for the downloaded key.",{"_3396":2528,"_29729":2516,"_20626":56305,"_5":14148,"_27027":56277,"_2882":56306},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3396":2529,"_29729":2516,"_20626":56308,"_5":14148,"_27027":56277,"_2882":56309},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3396":2530,"_29729":2516,"_20626":56311,"_5":14148,"_27027":56277,"_2882":56312},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3396":2531,"_29729":2516,"_20626":56314,"_5":14148,"_27027":56277,"_2882":56315},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3396":2532,"_29729":2516,"_20626":56317,"_5":14148,"_27027":56281,"_2882":56318},[],"File or resource",{"_3396":2533,"_29729":2516,"_20626":56320,"_5":14148,"_27027":56281,"_2882":53525},[],{"_3396":2534,"_29729":2516,"_20626":56322,"_5":14148,"_27027":56281,"_2882":56323},[],"Active root CA and `ca.pem`",{"_3396":2535,"_29729":2516,"_20626":56325,"_5":14148,"_27027":56281,"_2882":56326},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3396":2536,"_29729":2516,"_20626":56328,"_5":14148,"_27027":56281,"_2882":56329},[],"End-entity certificate and `device.crt`",{"_3396":2537,"_29729":2516,"_20626":56331,"_5":14148,"_27027":56281,"_2882":56332},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3396":2538,"_29729":2516,"_20626":56334,"_5":14148,"_27027":56281,"_2882":56335},[],"Private key `device.key`",{"_3396":2539,"_29729":2516,"_20626":56337,"_5":14148,"_27027":56281,"_2882":56338},[],"Its public key matches the one included in `device.crt`.",{"_3396":2540,"_29729":2516,"_20626":56340,"_5":14148,"_27027":56281,"_2882":56341},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3396":2541,"_29729":2516,"_20626":56343,"_5":14148,"_27027":56284,"_2882":56344},[],"To operate certificates, continue with Certificates and Validation.",{"_3396":2542,"_29729":2516,"_20626":56346,"_5":14148,"_27027":56284,"_2882":56347},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3396":2543,"_29729":2516,"_20626":56349,"_5":14148,"_27027":56284,"_2882":56350},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3396":2544,"_29729":2544,"_5":14500,"_2882":56352,"_30082":56353,"_20626":56354,"_27027":2544},"PKI troubleshooting",[48429,49897,53899,52474],[],{"_3396":2545,"_29729":2544,"_20626":56356,"_5":14148,"_27027":2544,"_2882":56357},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3396":2546,"_29729":2544,"_5":30079,"_20626":56359,"_27027":56360,"_2882":56361},[],"/docs/pr-preview/pr-57/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3396":2547,"_29729":2544,"_5":30079,"_20626":56363,"_27027":56364,"_2882":56365},[],"/docs/pr-preview/pr-57/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3396":2548,"_29729":2544,"_5":30079,"_20626":56367,"_27027":56368,"_2882":56369},[],"/docs/pr-preview/pr-57/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3396":2549,"_29729":2544,"_20626":56371,"_5":14148,"_27027":2544,"_2882":56372},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3396":2550,"_29729":2544,"_20626":56374,"_5":14148,"_27027":2544,"_2882":56375},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3396":2551,"_29729":2544,"_20626":56377,"_5":14148,"_27027":56360,"_2882":53525},[],{"_3396":2552,"_29729":2544,"_20626":56379,"_5":14148,"_27027":56360,"_2882":56380},[],"What to inspect",{"_3396":2553,"_29729":2544,"_20626":56382,"_5":14148,"_27027":56360,"_2882":48463},[],{"_3396":2554,"_29729":2544,"_20626":56384,"_5":14148,"_27027":56360,"_2882":52741},[],{"_3396":2555,"_29729":2544,"_20626":56386,"_5":14148,"_27027":56360,"_2882":56387},[],"Exists, is active and has usable dates.",{"_3396":2556,"_29729":2544,"_20626":56389,"_5":14148,"_27027":56360,"_2882":56390},[],"Authorities.",{"_3396":2557,"_29729":2544,"_20626":56392,"_5":14148,"_27027":56360,"_2882":56393},[],"Key",{"_3396":2558,"_29729":2544,"_20626":56395,"_5":14148,"_27027":56360,"_2882":56396},[],"The record has a usable private key and the engine can sign.",{"_3396":2559,"_29729":2544,"_20626":56398,"_5":14148,"_27027":56360,"_2882":56399},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3396":2560,"_29729":2544,"_20626":56401,"_5":14148,"_27027":56360,"_2882":56402},[],"CSR",{"_3396":2561,"_29729":2544,"_20626":56404,"_5":14148,"_27027":56360,"_2882":56405},[],"Correct PEM and verifiable signature.",{"_3396":2562,"_29729":2544,"_20626":56407,"_5":14148,"_27027":56360,"_2882":56408},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3396":2563,"_29729":2544,"_20626":56410,"_5":14148,"_27027":56360,"_2882":56411},[],"Profile",{"_3396":2564,"_29729":2544,"_20626":56413,"_5":14148,"_27027":56360,"_2882":56414},[],"Selected source, existing ID, allowed algorithm and size.",{"_3396":2565,"_29729":2544,"_20626":56416,"_5":14148,"_27027":56360,"_2882":56417},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3396":2566,"_29729":2544,"_20626":56419,"_5":14148,"_27027":56360,"_2882":53677},[],{"_3396":2567,"_29729":2544,"_20626":56421,"_5":14148,"_27027":56360,"_2882":56422},[],"Appropriate subject, SAN, usages and dates.",{"_3396":2568,"_29729":2544,"_20626":56424,"_5":14148,"_27027":56360,"_2882":56425},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3396":2569,"_29729":2544,"_20626":56427,"_5":14148,"_27027":56360,"_2882":56428},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3396":2570,"_29729":2544,"_20626":56430,"_5":14148,"_27027":56360,"_2882":56431},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3396":2571,"_29729":2544,"_20626":56433,"_5":14148,"_27027":56364,"_2882":56434},[],"Check each boundary independently:",{"_3396":2572,"_29729":2544,"_20626":56436,"_5":14148,"_27027":56364,"_2882":56437},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3396":2573,"_29729":2544,"_20626":56439,"_5":14148,"_27027":56364,"_2882":56440},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3396":2574,"_29729":2544,"_20626":56442,"_5":14148,"_27027":56364,"_2882":56443},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3396":2575,"_29729":2544,"_20626":56445,"_5":14148,"_27027":56364,"_2882":56446},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3396":2576,"_29729":2544,"_20626":56448,"_5":14148,"_27027":56364,"_2882":56449},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3396":2577,"_29729":2544,"_20626":56451,"_5":14148,"_27027":56364,"_2882":56452},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3396":2578,"_29729":2544,"_20626":56454,"_5":14148,"_27027":56368,"_2882":56455},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3396":2579,"_29729":2544,"_20626":56457,"_5":14148,"_27027":56368,"_2882":56458},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3396":2580,"_29729":2580,"_5":14500,"_2882":56460,"_30082":56461,"_20626":56462,"_27027":2580},"Security",[48429],[],{"_3396":2581,"_29729":2580,"_20626":56464,"_5":14148,"_27027":2580,"_2882":56465},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3396":2582,"_29729":2580,"_5":30079,"_20626":56467,"_27027":56468,"_2882":56469},[],"/docs/pr-preview/pr-57/security#report-a-vulnerability","Report a vulnerability",{"_3396":2583,"_29729":2580,"_5":30079,"_20626":56471,"_27027":56472,"_2882":56473},[],"/docs/pr-preview/pr-57/security#what-to-include-in-a-report","What to include in a report",{"_3396":2584,"_29729":2580,"_5":30079,"_20626":56475,"_27027":56476,"_2882":56477},[],"/docs/pr-preview/pr-57/security#supported-versions","Supported versions",{"_3396":2585,"_29729":2580,"_5":30079,"_20626":56479,"_27027":56480,"_2882":56481},[],"/docs/pr-preview/pr-57/security#responsible-disclosure","Responsible disclosure",{"_3396":2586,"_29729":2580,"_20626":56483,"_5":14148,"_27027":2580,"_2882":56484},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3396":2587,"_29729":2580,"_20626":56486,"_5":14148,"_27027":56468,"_2882":56487},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3396":2588,"_29729":2580,"_20626":56489,"_5":14148,"_27027":56468,"_2882":56490},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3396":2589,"_29729":2580,"_20626":56492,"_5":14148,"_27027":56468,"_2882":14767},[],{"_3396":2590,"_29729":2580,"_20626":56494,"_5":14148,"_27027":56468,"_2882":14713},[],{"_3396":2591,"_29729":2580,"_20626":56496,"_5":14148,"_27027":56468,"_2882":14760},[],{"_3396":2592,"_29729":2580,"_20626":56498,"_5":14148,"_27027":56468,"_2882":56499},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3396":2593,"_29729":2580,"_20626":56501,"_5":14148,"_27027":56468,"_2882":56502},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3396":2594,"_29729":2580,"_20626":56504,"_5":14148,"_27027":56472,"_2882":56505},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3396":2595,"_29729":2580,"_20626":56507,"_5":14148,"_27027":56472,"_2882":56508},[],"Do not include in the report:",{"_3396":2596,"_29729":2580,"_20626":56510,"_5":14148,"_27027":56472,"_2882":56511},[],"Credentials, tokens, or private keys",{"_3396":2597,"_29729":2580,"_20626":56513,"_5":14148,"_27027":56472,"_2882":56514},[],"Customer data or customer-identifiable information",{"_3396":2598,"_29729":2580,"_20626":56516,"_5":14148,"_27027":56472,"_2882":56517},[],"Confidential architecture or internal infrastructure details",{"_3396":2599,"_29729":2580,"_20626":56519,"_5":14148,"_27027":56476,"_2882":56520},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3396":2600,"_29729":2580,"_20626":56522,"_5":14148,"_27027":56476,"_2882":56523},[],"For upgrade guidance, see Upgrades.",{"_3396":2601,"_29729":2580,"_20626":56525,"_5":14148,"_27027":56480,"_2882":56526},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3396":2602,"_29729":2580,"_20626":56528,"_5":14148,"_27027":56480,"_2882":56529},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3396":2603,"_29729":2580,"_20626":56531,"_5":14148,"_27027":56480,"_2882":56532},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3396":2604,"_29729":2580,"_20626":56534,"_5":14148,"_27027":56480,"_2882":56535},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3396":2605,"_29729":2580,"_20626":56537,"_5":14148,"_27027":56480,"_2882":56538},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3396":2606,"_29729":2606,"_5":14500,"_2882":56540,"_30082":56541,"_20626":56543,"_27027":2606},"3.8.0 to 4.0.0",[48429,56542],"Upgrades",[],{"_3396":2607,"_29729":2606,"_20626":56545,"_5":14148,"_27027":2606,"_2882":56546},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3396":2608,"_29729":2606,"_5":30079,"_20626":56548,"_27027":56549,"_2882":56550},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3396":2609,"_29729":2606,"_5":30079,"_20626":56552,"_27027":56553,"_2882":56554},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3396":2610,"_29729":2606,"_5":30079,"_20626":56556,"_27027":56557,"_2882":56558},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3396":2611,"_29729":2606,"_5":30079,"_20626":56560,"_27027":56561,"_2882":56562},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3396":2612,"_29729":2606,"_5":30079,"_20626":56564,"_27027":56565,"_2882":56566},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3396":2613,"_29729":2606,"_5":30079,"_20626":56568,"_27027":56569,"_2882":56570},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3396":2614,"_29729":2606,"_5":30079,"_20626":56572,"_27027":56573,"_2882":56574},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3396":2615,"_29729":2606,"_5":30079,"_20626":56576,"_27027":56577,"_2882":56578},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3396":2616,"_29729":2606,"_5":30079,"_20626":56580,"_27027":56581,"_2882":56582},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3396":2617,"_29729":2606,"_5":30079,"_20626":56584,"_27027":56585,"_2882":56586},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3396":2618,"_29729":2606,"_5":30079,"_20626":56588,"_27027":56589,"_2882":56590},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3396":2619,"_29729":2606,"_5":30079,"_20626":56592,"_27027":56593,"_2882":56594},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3396":2620,"_29729":2606,"_5":30079,"_20626":56596,"_27027":56597,"_2882":56598},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3396":2621,"_29729":2606,"_5":30079,"_20626":56600,"_27027":56601,"_2882":56602},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3396":2622,"_29729":2606,"_5":30079,"_20626":56604,"_27027":56605,"_2882":56606},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3396":2623,"_29729":2606,"_5":30079,"_20626":56608,"_27027":56609,"_2882":56610},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3396":2624,"_29729":2606,"_5":30079,"_20626":56612,"_27027":56613,"_2882":56614},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3396":2625,"_29729":2606,"_5":30079,"_20626":56616,"_27027":56617,"_2882":56618},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3396":2626,"_29729":2606,"_5":30079,"_20626":56620,"_27027":56621,"_2882":56622},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3396":2627,"_29729":2606,"_5":30079,"_20626":56624,"_27027":56625,"_2882":56626},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-va-roles","References between certificates, keys and VA roles",{"_3396":2628,"_29729":2606,"_5":30079,"_20626":56628,"_27027":56629,"_2882":56630},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3396":2629,"_29729":2606,"_5":30079,"_20626":56632,"_27027":56633,"_2882":56634},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3396":2630,"_29729":2606,"_5":30079,"_20626":56636,"_27027":56637,"_2882":56638},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3396":2631,"_29729":2606,"_5":30079,"_20626":56640,"_27027":56641,"_2882":56642},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3396":2632,"_29729":2606,"_5":30079,"_20626":56644,"_27027":56645,"_2882":56646},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3396":2633,"_29729":2606,"_5":30079,"_20626":56648,"_27027":56649,"_2882":56650},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3396":2634,"_29729":2606,"_5":30079,"_20626":56652,"_27027":56653,"_2882":56654},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3396":2635,"_29729":2606,"_5":30079,"_20626":56656,"_27027":56657,"_2882":56658},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#va-role-signer-field","VA role signer field",{"_3396":2636,"_29729":2606,"_5":30079,"_20626":56660,"_27027":56661,"_2882":56662},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3396":2637,"_29729":2606,"_5":30079,"_20626":56664,"_27027":56665,"_2882":56666},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3396":2638,"_29729":2606,"_5":30079,"_20626":56668,"_27027":56669,"_2882":56670},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3396":2639,"_29729":2606,"_5":30079,"_20626":56672,"_27027":56673,"_2882":56674},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3396":2640,"_29729":2606,"_5":30079,"_20626":56676,"_27027":56677,"_2882":56678},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3396":2641,"_29729":2606,"_5":30079,"_20626":56680,"_27027":56681,"_2882":56682},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3396":2642,"_29729":2606,"_5":30079,"_20626":56684,"_27027":56685,"_2882":56686},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3396":2643,"_29729":2606,"_5":30079,"_20626":56688,"_27027":56689,"_2882":56690},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3396":2644,"_29729":2606,"_5":30079,"_20626":56692,"_27027":56693,"_2882":52474},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3396":2645,"_29729":2606,"_5":30079,"_20626":56695,"_27027":56696,"_2882":56697},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3396":2646,"_29729":2606,"_5":30079,"_20626":56699,"_27027":56700,"_2882":56701},[],"/docs/pr-preview/pr-57/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3396":2647,"_29729":2606,"_20626":56703,"_5":14148,"_27027":2606,"_2882":56704},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3396":2648,"_29729":2606,"_20626":56706,"_5":14148,"_27027":2606,"_2882":56707},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3396":2649,"_29729":2606,"_20626":56709,"_5":14148,"_27027":2606,"_2882":56710},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3396":2650,"_29729":2606,"_20626":56712,"_5":14148,"_27027":2606,"_2882":56713},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3396":2651,"_29729":2606,"_20626":56715,"_5":14148,"_27027":2606,"_2882":56716},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3396":2652,"_29729":2606,"_20626":56718,"_5":14148,"_27027":2606,"_2882":56719},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3396":2653,"_29729":2606,"_20626":56721,"_5":14148,"_27027":2606,"_2882":56722},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3396":2654,"_29729":2606,"_20626":56724,"_5":14148,"_27027":56553,"_2882":56725},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3396":2655,"_29729":2606,"_20626":56727,"_5":14148,"_27027":56553,"_2882":56728},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3396":2656,"_29729":2606,"_20626":56730,"_5":14148,"_27027":56557,"_2882":56731},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3396":2657,"_29729":2606,"_20626":56733,"_5":14148,"_27027":56557,"_2882":56734},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3396":2658,"_29729":2606,"_20626":56736,"_5":14148,"_27027":56561,"_2882":56737},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3396":2659,"_29729":2606,"_20626":56739,"_5":14148,"_27027":56565,"_2882":56740},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3396":2660,"_29729":2606,"_20626":56742,"_5":14148,"_27027":56565,"_2882":56743},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3396":2661,"_29729":2606,"_20626":56745,"_5":14148,"_27027":56565,"_2882":56746},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3396":2662,"_29729":2606,"_20626":56748,"_5":14148,"_27027":56565,"_2882":56749},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3396":2663,"_29729":2606,"_20626":56751,"_5":14148,"_27027":56565,"_2882":56752},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3396":2664,"_29729":2606,"_20626":56754,"_5":14148,"_27027":56569,"_2882":56755},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3396":2665,"_29729":2606,"_20626":56757,"_5":14148,"_27027":56569,"_2882":56758},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3396":2666,"_29729":2606,"_20626":56760,"_5":14148,"_27027":56569,"_2882":56761},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3396":2667,"_29729":2606,"_20626":56763,"_5":14148,"_27027":56569,"_2882":56764},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3396":2668,"_29729":2606,"_20626":56766,"_5":14148,"_27027":56569,"_2882":56767},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3396":2669,"_29729":2606,"_20626":56769,"_5":14148,"_27027":56569,"_2882":56770},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3396":2670,"_29729":2606,"_20626":56772,"_5":14148,"_27027":56573,"_2882":56773},[],"Change",{"_3396":2671,"_29729":2606,"_20626":56775,"_5":14148,"_27027":56573,"_2882":56776},[],"Who is affected",{"_3396":2672,"_29729":2606,"_20626":56778,"_5":14148,"_27027":56573,"_2882":56779},[],"Severity",{"_3396":2673,"_29729":2606,"_20626":56781,"_5":14148,"_27027":56573,"_2882":55280},[],{"_3396":2674,"_29729":2606,"_20626":56783,"_5":14148,"_27027":56573,"_2882":56582},[],{"_3396":2675,"_29729":2606,"_20626":56785,"_5":14148,"_27027":56573,"_2882":56786},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3396":2676,"_29729":2606,"_20626":56788,"_5":14148,"_27027":56573,"_2882":56789},[],"High: KMS and VA start on empty volumes",{"_3396":2677,"_29729":2606,"_20626":56791,"_5":14148,"_27027":56573,"_2882":56792},[],"Copy the data into the new volumes",{"_3396":2678,"_29729":2606,"_20626":56794,"_5":14148,"_27027":56573,"_2882":56586},[],{"_3396":2679,"_29729":2606,"_20626":56796,"_5":14148,"_27027":56573,"_2882":56797},[],"Every Helm release",{"_3396":2680,"_29729":2606,"_20626":56799,"_5":14148,"_27027":56573,"_2882":56800},[],"High: `helm upgrade` fails",{"_3396":2681,"_29729":2606,"_20626":56802,"_5":14148,"_27027":56573,"_2882":56803},[],"Remove or rename legacy keys",{"_3396":2682,"_29729":2606,"_20626":56805,"_5":14148,"_27027":56573,"_2882":56590},[],{"_3396":2683,"_29729":2606,"_20626":56807,"_5":14148,"_27027":56573,"_2882":56808},[],"Every deployment",{"_3396":2684,"_29729":2606,"_20626":56810,"_5":14148,"_27027":56573,"_2882":56811},[],"High: without a bootstrap principal there is no administrator",{"_3396":2685,"_29729":2606,"_20626":56813,"_5":14148,"_27027":56573,"_2882":56814},[],"Configure `services.authz`",{"_3396":2686,"_29729":2606,"_20626":56816,"_5":14148,"_27027":56573,"_2882":56594},[],{"_3396":2687,"_29729":2606,"_20626":56818,"_5":14148,"_27027":56573,"_2882":56797},[],{"_3396":2688,"_29729":2606,"_20626":56820,"_5":14148,"_27027":56573,"_2882":56821},[],"High: `helm upgrade` fails on the old keys",{"_3396":2689,"_29729":2606,"_20626":56823,"_5":14148,"_27027":56573,"_2882":56824},[],"Move JWKS and roles into `services.authz`",{"_3396":2690,"_29729":2606,"_20626":56826,"_5":14148,"_27027":56573,"_2882":56614},[],{"_3396":2691,"_29729":2606,"_20626":56828,"_5":14148,"_27027":56573,"_2882":56829},[],"3.8.0 deployments with per-service databases",{"_3396":2692,"_29729":2606,"_20626":56831,"_5":14148,"_27027":56573,"_2882":56832},[],"High: services find no data, or a migration aborts",{"_3396":2693,"_29729":2606,"_20626":56834,"_5":14148,"_27027":56573,"_2882":56835},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3396":2694,"_29729":2606,"_20626":56837,"_5":14148,"_27027":56573,"_2882":56618},[],{"_3396":2695,"_29729":2606,"_20626":56839,"_5":14148,"_27027":56573,"_2882":56840},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3396":2696,"_29729":2606,"_20626":56842,"_5":14148,"_27027":56573,"_2882":56843},[],"High: the backend no longer starts with them",{"_3396":2697,"_29729":2606,"_20626":56845,"_5":14148,"_27027":56573,"_2882":56846},[],"Move to PostgreSQL before upgrading",{"_3396":2698,"_29729":2606,"_20626":56848,"_5":14148,"_27027":56573,"_2882":56849},[],"Webhooks with file references",{"_3396":2699,"_29729":2606,"_20626":56851,"_5":14148,"_27027":56573,"_2882":56852},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3396":2700,"_29729":2606,"_20626":56854,"_5":14148,"_27027":56573,"_2882":56855},[],"High: enrollments calling the webhook fail",{"_3396":2701,"_29729":2606,"_20626":56857,"_5":14148,"_27027":56573,"_2882":56858},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3396":2702,"_29729":2606,"_20626":56860,"_5":14148,"_27027":56573,"_2882":56598},[],{"_3396":2703,"_29729":2606,"_20626":56862,"_5":14148,"_27027":56573,"_2882":56863},[],"Releases with per-service identity overrides or mounted key material",{"_3396":2704,"_29729":2606,"_20626":56865,"_5":14148,"_27027":56573,"_2882":56866},[],"Medium: services cannot read their files",{"_3396":2705,"_29729":2606,"_20626":56868,"_5":14148,"_27027":56573,"_2882":56869},[],"Remove the overrides and fix volume ownership",{"_3396":2706,"_29729":2606,"_20626":56871,"_5":14148,"_27027":56573,"_2882":56602},[],{"_3396":2707,"_29729":2606,"_20626":56873,"_5":14148,"_27027":56573,"_2882":56874},[],"Releases that set `amqp.tls`",{"_3396":2708,"_29729":2606,"_20626":56876,"_5":14148,"_27027":56573,"_2882":56877},[],"Medium: clients connect to the wrong port",{"_3396":2709,"_29729":2606,"_20626":56879,"_5":14148,"_27027":56573,"_2882":56880},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3396":2710,"_29729":2606,"_20626":56882,"_5":14148,"_27027":56573,"_2882":56622},[],{"_3396":2711,"_29729":2606,"_20626":56884,"_5":14148,"_27027":56573,"_2882":56885},[],"Installations whose CA keys predate the KMS",{"_3396":2712,"_29729":2606,"_20626":56887,"_5":14148,"_27027":56573,"_2882":56888},[],"Medium: CA keys stay unmanaged",{"_3396":2713,"_29729":2606,"_20626":56890,"_5":14148,"_27027":56573,"_2882":56891},[],"Run the CA-to-KMS migration",{"_3396":2714,"_29729":2606,"_20626":56893,"_5":14148,"_27027":56573,"_2882":56894},[],"Receiver certificate verification",{"_3396":2715,"_29729":2606,"_20626":56896,"_5":14148,"_27027":56573,"_2882":56897},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3396":2716,"_29729":2606,"_20626":56899,"_5":14148,"_27027":56573,"_2882":56900},[],"Medium: credentials go to an unverified receiver",{"_3396":2717,"_29729":2606,"_20626":56902,"_5":14148,"_27027":56573,"_2882":56903},[],"Set `insecure_skip_verify` to `false`",{"_3396":2718,"_29729":2606,"_20626":56905,"_5":14148,"_27027":56573,"_2882":56638},[],{"_3396":2719,"_29729":2606,"_20626":56907,"_5":14148,"_27027":56573,"_2882":56908},[],"Scripts and consoles that edit DMSs through the API",{"_3396":2720,"_29729":2606,"_20626":56910,"_5":14148,"_27027":56573,"_2882":56911},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3396":2721,"_29729":2606,"_20626":56913,"_5":14148,"_27027":56573,"_2882":56914},[],"Read the DMS before editing and use the new field",{"_3396":2722,"_29729":2606,"_20626":56916,"_5":14148,"_27027":56573,"_2882":56658},[],{"_3396":2723,"_29729":2606,"_20626":56918,"_5":14148,"_27027":56573,"_2882":56919},[],"Clients that create or update VA roles through the API",{"_3396":2724,"_29729":2606,"_20626":56921,"_5":14148,"_27027":56573,"_2882":56922},[],"Medium: requests with the old field return an error",{"_3396":2725,"_29729":2606,"_20626":56924,"_5":14148,"_27027":56573,"_2882":56925},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_certificate_serial_number`",{"_3396":2726,"_29729":2606,"_20626":56927,"_5":14148,"_27027":56573,"_2882":56654},[],{"_3396":2727,"_29729":2606,"_20626":56929,"_5":14148,"_27027":56573,"_2882":56930},[],"Consumers that read the device `events` field",{"_3396":2728,"_29729":2606,"_20626":56932,"_5":14148,"_27027":56573,"_2882":56933},[],"Medium: the field disappears",{"_3396":2729,"_29729":2606,"_20626":56935,"_5":14148,"_27027":56573,"_2882":56936},[],"Use the new event endpoints",{"_3396":2730,"_29729":2606,"_20626":56938,"_5":14148,"_27027":56573,"_2882":56662},[],{"_3396":2731,"_29729":2606,"_20626":56940,"_5":14148,"_27027":56573,"_2882":56941},[],"Deployments with VA roles whose signer is not in the CA inventory",{"_3396":2732,"_29729":2606,"_20626":56943,"_5":14148,"_27027":56573,"_2882":56944},[],"Medium: the VA migration aborts",{"_3396":2733,"_29729":2606,"_20626":56946,"_5":14148,"_27027":56573,"_2882":56947},[],"Fix the affected roles before upgrading",{"_3396":2734,"_29729":2606,"_20626":56949,"_5":14148,"_27027":56573,"_2882":56606},[],{"_3396":2735,"_29729":2606,"_20626":56951,"_5":14148,"_27027":56573,"_2882":56952},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3396":2736,"_29729":2606,"_20626":56954,"_5":14148,"_27027":56573,"_2882":56955},[],"Low to medium: validation errors or changed defaults",{"_3396":2737,"_29729":2606,"_20626":56957,"_5":14148,"_27027":56573,"_2882":56958},[],"Update the values file",{"_3396":2738,"_29729":2606,"_20626":56960,"_5":14148,"_27027":56573,"_2882":56646},[],{"_3396":2739,"_29729":2606,"_20626":56962,"_5":14148,"_27027":56573,"_2882":56963},[],"Clients that send the DMS ID in the update body",{"_3396":2740,"_29729":2606,"_20626":56965,"_5":14148,"_27027":56573,"_2882":56966},[],"Low: the ID in the URL wins",{"_3396":2741,"_29729":2606,"_20626":56968,"_5":14148,"_27027":56573,"_2882":56969},[],"Send the ID in the URL",{"_3396":2742,"_29729":2606,"_20626":56971,"_5":14148,"_27027":56573,"_2882":56650},[],{"_3396":2743,"_29729":2606,"_20626":56973,"_5":14148,"_27027":56573,"_2882":56974},[],"Consumers that match on certificate `type`",{"_3396":2744,"_29729":2606,"_20626":56976,"_5":14148,"_27027":56573,"_2882":56977},[],"Low: two values are renamed",{"_3396":2745,"_29729":2606,"_20626":56979,"_5":14148,"_27027":56573,"_2882":56980},[],"Adapt consumers",{"_3396":2746,"_29729":2606,"_20626":56982,"_5":14148,"_27027":56573,"_2882":56642},[],{"_3396":2747,"_29729":2606,"_20626":56984,"_5":14148,"_27027":56573,"_2882":56985},[],"Any DMS",{"_3396":2748,"_29729":2606,"_20626":56987,"_5":14148,"_27027":56573,"_2882":56988},[],"Low: informational",{"_3396":2749,"_29729":2606,"_20626":56990,"_5":14148,"_27027":56573,"_2882":56991},[],"Read both blocks before editing",{"_3396":2750,"_29729":2606,"_20626":56993,"_5":14148,"_27027":56581,"_2882":56994},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3396":2751,"_29729":2606,"_20626":56996,"_5":14148,"_27027":56581,"_2882":56997},[],"Step 4 of the migration guide copies the data.",{"_3396":2752,"_29729":2606,"_20626":56999,"_5":14148,"_27027":56585,"_2882":57000},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3396":2753,"_29729":2606,"_20626":57002,"_5":14148,"_27027":56589,"_2882":57003},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3396":2754,"_29729":2606,"_20626":57005,"_5":14148,"_27027":56593,"_2882":57006},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3396":2755,"_29729":2606,"_20626":57008,"_5":14148,"_27027":56597,"_2882":57009},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3396":2756,"_29729":2606,"_20626":57011,"_5":14148,"_27027":56597,"_2882":57012},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3396":2757,"_29729":2606,"_20626":57014,"_5":14148,"_27027":56601,"_2882":57015},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3396":2758,"_29729":2606,"_20626":57017,"_5":14148,"_27027":56605,"_2882":57018},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3396":2759,"_29729":2606,"_20626":57020,"_5":14148,"_27027":56605,"_2882":57021},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3396":2760,"_29729":2606,"_20626":57023,"_5":14148,"_27027":56605,"_2882":57024},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3396":2761,"_29729":2606,"_20626":57026,"_5":14148,"_27027":56605,"_2882":57027},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3396":2762,"_29729":2606,"_20626":57029,"_5":14148,"_27027":56605,"_2882":57030},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3396":2763,"_29729":2606,"_20626":57032,"_5":14148,"_27027":56605,"_2882":57033},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3396":2764,"_29729":2606,"_20626":57035,"_5":14148,"_27027":56613,"_2882":57036},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3396":2765,"_29729":2606,"_20626":57038,"_5":14148,"_27027":56613,"_2882":57039},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3396":2766,"_29729":2606,"_20626":57041,"_5":14148,"_27027":56613,"_2882":57042},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3396":2767,"_29729":2606,"_20626":57044,"_5":14148,"_27027":56613,"_2882":57045},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3396":2768,"_29729":2606,"_20626":57047,"_5":14148,"_27027":56613,"_2882":57048},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3396":2769,"_29729":2606,"_20626":57050,"_5":14148,"_27027":56617,"_2882":57051},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3396":2770,"_29729":2606,"_20626":57053,"_5":14148,"_27027":56621,"_2882":57054},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3396":2771,"_29729":2606,"_20626":57056,"_5":14148,"_27027":56621,"_2882":57057},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3396":2772,"_29729":2606,"_20626":57059,"_5":14148,"_27027":56621,"_2882":57060},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3396":2773,"_29729":2606,"_20626":57062,"_5":14148,"_27027":56621,"_2882":57063},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3396":2774,"_29729":2606,"_20626":57065,"_5":14148,"_27027":56621,"_2882":57066},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3396":2775,"_29729":2606,"_20626":57068,"_5":14148,"_27027":56621,"_2882":57069},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3396":2776,"_29729":2606,"_20626":57071,"_5":14148,"_27027":56621,"_2882":57072},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3396":2777,"_29729":2606,"_20626":57074,"_5":14148,"_27027":56621,"_2882":57075},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3396":2778,"_29729":2606,"_20626":57077,"_5":14148,"_27027":56625,"_2882":57078},[],"Certificates now reference their KMS key, and VA roles reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3396":2779,"_29729":2606,"_20626":57080,"_5":14148,"_27027":56633,"_2882":57081},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3396":2780,"_29729":2606,"_20626":57083,"_5":14148,"_27027":56633,"_2882":57084},[],"Field in 3.8.0",{"_3396":2781,"_29729":2606,"_20626":57086,"_5":14148,"_27027":56633,"_2882":57087},[],"Field in 4.0.0",{"_3396":2782,"_29729":2606,"_20626":57089,"_5":14148,"_27027":56633,"_2882":57090},[],"`validate_server_cert`",{"_3396":2783,"_29729":2606,"_20626":57092,"_5":14148,"_27027":56633,"_2882":57093},[],"`insecure_skip_verify` (value negated)",{"_3396":2784,"_29729":2606,"_20626":57095,"_5":14148,"_27027":56633,"_2882":57096},[],"`oidc`",{"_3396":2785,"_29729":2606,"_20626":57098,"_5":14148,"_27027":56633,"_2882":57099},[],"`jwt_options`",{"_3396":2786,"_29729":2606,"_20626":57101,"_5":14148,"_27027":56633,"_2882":57102},[],"`apikey`",{"_3396":2787,"_29729":2606,"_20626":57104,"_5":14148,"_27027":56633,"_2882":57105},[],"`apikey_options`",{"_3396":2788,"_29729":2606,"_20626":57107,"_5":14148,"_27027":56633,"_2882":57108},[],"`mtls`",{"_3396":2789,"_29729":2606,"_20626":57110,"_5":14148,"_27027":56633,"_2882":57111},[],"`mtls_options`",{"_3396":2790,"_29729":2606,"_20626":57113,"_5":14148,"_27027":56633,"_2882":57114},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3396":2791,"_29729":2606,"_20626":57116,"_5":14148,"_27027":56633,"_2882":57117},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3396":2792,"_29729":2606,"_20626":57119,"_5":14148,"_27027":56633,"_2882":57120},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3396":2793,"_29729":2606,"_20626":57122,"_5":14148,"_27027":56637,"_2882":57123},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3396":2794,"_29729":2606,"_20626":57125,"_5":14148,"_27027":56637,"_2882":57126},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3396":2795,"_29729":2606,"_20626":57128,"_5":14148,"_27027":56637,"_2882":57129},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3396":2796,"_29729":2606,"_20626":57131,"_5":14148,"_27027":56641,"_2882":57132},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3396":2797,"_29729":2606,"_20626":57134,"_5":14148,"_27027":56645,"_2882":57135},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3396":2798,"_29729":2606,"_20626":57137,"_5":14148,"_27027":56649,"_2882":57138},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3396":2799,"_29729":2606,"_20626":57140,"_5":14148,"_27027":56653,"_2882":57141},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3396":2800,"_29729":2606,"_20626":57143,"_5":14148,"_27027":56653,"_2882":57144},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3396":2801,"_29729":2606,"_20626":57146,"_5":14148,"_27027":56653,"_2882":57147},[],"`POST /v1/devices/:id/events` creates an event.",{"_3396":2802,"_29729":2606,"_20626":57149,"_5":14148,"_27027":56653,"_2882":57150},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3396":2803,"_29729":2606,"_20626":57152,"_5":14148,"_27027":56657,"_2882":57153},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_certificate_serial_number`, the serial number of the existing certificate that signs the CRL. A new role's initial value is the CA's current certificate serial number. Requests that still carry `subject_key_id_signer` return an error. Custom authorization policies that filter on the old field must be updated: the filter `crl_subject_key_id_signer` is renamed to `crl_signer_certificate_serial_number` and takes serial-number values.",{"_3396":2804,"_29729":2606,"_20626":57155,"_5":14148,"_27027":56661,"_2882":57156},[],"The VA migration resolves each role's signer automatically: when several CAs share the signer's key, it uses the oldest one and logs a warning, but it aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` when no certificate with that SKI exists. Fix such roles before upgrading.",{"_3396":2805,"_29729":2606,"_20626":57158,"_5":14148,"_27027":56665,"_2882":57159},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3396":2806,"_29729":2606,"_20626":57161,"_5":14148,"_27027":56669,"_2882":57162},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3396":2807,"_29729":2606,"_20626":57164,"_5":14148,"_27027":56669,"_2882":57165},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3396":2808,"_29729":2606,"_20626":57167,"_5":14148,"_27027":56669,"_2882":57168},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3396":2809,"_29729":2606,"_20626":57170,"_5":14148,"_27027":56669,"_2882":57171},[],"Record the names of your local-storage PVCs:",{"_3396":2810,"_29729":2606,"_20626":57173,"_5":14148,"_27027":56669,"_2882":57174},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3396":2811,"_29729":2606,"_20626":57176,"_5":14148,"_27027":56673,"_2882":57177},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3396":2812,"_29729":2606,"_20626":57179,"_5":14148,"_27027":56673,"_2882":57180},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3396":2813,"_29729":2606,"_20626":57182,"_5":14148,"_27027":56673,"_2882":57183},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3396":2814,"_29729":2606,"_20626":57185,"_5":14148,"_27027":56673,"_2882":57186},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3396":2815,"_29729":2606,"_20626":57188,"_5":14148,"_27027":56673,"_2882":57189},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3396":2816,"_29729":2606,"_20626":57191,"_5":14148,"_27027":56673,"_2882":57192},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3396":2817,"_29729":2606,"_20626":57194,"_5":14148,"_27027":56673,"_2882":57195},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3396":2818,"_29729":2606,"_20626":57197,"_5":14148,"_27027":56673,"_2882":57198},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3396":2819,"_29729":2606,"_20626":57200,"_5":14148,"_27027":56673,"_2882":57201},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3396":2820,"_29729":2606,"_20626":57203,"_5":14148,"_27027":56673,"_2882":57204},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3396":2821,"_29729":2606,"_20626":57206,"_5":14148,"_27027":56673,"_2882":57207},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3396":2822,"_29729":2606,"_20626":57209,"_5":14148,"_27027":56673,"_2882":57210},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3396":2823,"_29729":2606,"_20626":57212,"_5":14148,"_27027":56677,"_2882":57213},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3396":2824,"_29729":2606,"_20626":57215,"_5":14148,"_27027":56677,"_2882":57216},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3396":2825,"_29729":2606,"_20626":57218,"_5":14148,"_27027":56681,"_2882":57219},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3396":2826,"_29729":2606,"_20626":57221,"_5":14148,"_27027":56681,"_2882":57222},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3396":2827,"_29729":2606,"_20626":57224,"_5":14148,"_27027":56681,"_2882":57225},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3396":2828,"_29729":2606,"_20626":57227,"_5":14148,"_27027":56681,"_2882":57228},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3396":2829,"_29729":2606,"_20626":57230,"_5":14148,"_27027":56681,"_2882":57231},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3396":2830,"_29729":2606,"_20626":57233,"_5":14148,"_27027":56681,"_2882":57234},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3396":2831,"_29729":2606,"_20626":57236,"_5":14148,"_27027":56681,"_2882":57237},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3396":2832,"_29729":2606,"_20626":57239,"_5":14148,"_27027":56681,"_2882":57240},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3396":2833,"_29729":2606,"_20626":57242,"_5":14148,"_27027":56681,"_2882":57243},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3396":2834,"_29729":2606,"_20626":57245,"_5":14148,"_27027":56681,"_2882":57246},[],"**Remove the helper and restore the recorded replica counts:**",{"_3396":2835,"_29729":2606,"_20626":57248,"_5":14148,"_27027":56681,"_2882":57249},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3396":2836,"_29729":2606,"_20626":57251,"_5":14148,"_27027":56685,"_2882":57252},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3396":2837,"_29729":2606,"_20626":57254,"_5":14148,"_27027":56685,"_2882":57255},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3396":2838,"_29729":2606,"_20626":57257,"_5":14148,"_27027":56689,"_2882":57258},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3396":2839,"_29729":2606,"_20626":57260,"_5":14148,"_27027":56689,"_2882":57261},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3396":2840,"_29729":2606,"_20626":57263,"_5":14148,"_27027":56689,"_2882":57264},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates`. If your services connect with a different user than the one that ran the migrations, grant that user `SELECT` on `ca.certificates_view` after the migrations.",{"_3396":2841,"_29729":2606,"_20626":57266,"_5":14148,"_27027":56689,"_2882":57267},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3396":2842,"_29729":2606,"_20626":57269,"_5":14148,"_27027":56689,"_2882":57270},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3396":2843,"_29729":2606,"_20626":57272,"_5":14148,"_27027":56689,"_2882":57273},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3396":2844,"_29729":2606,"_20626":57275,"_5":14148,"_27027":56689,"_2882":57276},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3396":2845,"_29729":2606,"_20626":57278,"_5":14148,"_27027":56689,"_2882":57279},[],"Apply the schema migrations in the order `kms` → `ca` → `va`; `devicemanager`, `dmsmanager` and `alerts` are independent and can run at any point. The `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema` while `kms` is not migrated yet, and `va` needs `ca` migrated. The `ca` and `va` migrations also read tables that belong to another schema, so the PostgreSQL role that runs them needs privileges on it: `USAGE` on the `kms` schema plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys` for the `ca` migration, and `USAGE` on the `ca` schema plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates` for the `va` migration. Without them the migration aborts; grant the missing privileges and run the failed schema again.",{"_3396":2846,"_29729":2606,"_20626":57281,"_5":14148,"_27027":56689,"_2882":57282},[],"After migrating `ca`, if the CA service runs as a different user than the migration user, grant that user `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`); the CA service reads certificates and CAs through that view, and without the grant every certificate and CA read fails with `permission denied for table certificates_view`.",{"_3396":2847,"_29729":2606,"_20626":57284,"_5":14148,"_27027":56693,"_2882":57285},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3396":2848,"_29729":2606,"_20626":57287,"_5":14148,"_27027":56693,"_2882":57288},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3396":2849,"_29729":2606,"_20626":57290,"_5":14148,"_27027":56693,"_2882":57291},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3396":2850,"_29729":2606,"_20626":57293,"_5":14148,"_27027":56693,"_2882":57294},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3396":2851,"_29729":2606,"_20626":57296,"_5":14148,"_27027":56693,"_2882":57297},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3396":2852,"_29729":2606,"_20626":57299,"_5":14148,"_27027":56693,"_2882":57300},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3396":2853,"_29729":2606,"_20626":57302,"_5":14148,"_27027":56693,"_2882":57303},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3396":2854,"_29729":2606,"_20626":57305,"_5":14148,"_27027":56693,"_2882":57306},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` schema migration.",{"_3396":2855,"_29729":2606,"_20626":57308,"_5":14148,"_27027":56693,"_2882":57309},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3396":2856,"_29729":2606,"_20626":57311,"_5":14148,"_27027":56693,"_2882":57312},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_certificate_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3396":2857,"_29729":2606,"_20626":57314,"_5":14148,"_27027":56693,"_2882":57315},[],"**A migration or service fails with `permission denied for table ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped. Grant the missing privileges and re-run.",{"_3396":2858,"_29729":2606,"_20626":57317,"_5":14148,"_27027":56696,"_2882":57318},[],"After the upgrade, check in this order:",{"_3396":2859,"_29729":2606,"_20626":57320,"_5":14148,"_27027":56696,"_2882":57321},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3396":2860,"_29729":2606,"_20626":57323,"_5":14148,"_27027":56696,"_2882":57324},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3396":2861,"_29729":2606,"_20626":57326,"_5":14148,"_27027":56696,"_2882":57327},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3396":2862,"_29729":2606,"_20626":57329,"_5":14148,"_27027":56696,"_2882":57330},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3396":2863,"_29729":2606,"_20626":57332,"_5":14148,"_27027":56696,"_2882":57333},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3396":2864,"_29729":2606,"_20626":57335,"_5":14148,"_27027":56696,"_2882":57336},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3396":2865,"_29729":2606,"_20626":57338,"_5":14148,"_27027":56696,"_2882":57339},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3396":2866,"_29729":2606,"_20626":57341,"_5":14148,"_27027":56696,"_2882":57342},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3396":2867,"_29729":2606,"_20626":57344,"_5":14148,"_27027":56696,"_2882":57345},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3396":2868,"_29729":2606,"_20626":57347,"_5":14148,"_27027":56696,"_2882":57348},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3396":2869,"_29729":2606,"_20626":57350,"_5":14148,"_27027":56696,"_2882":57351},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3396":2870,"_29729":2606,"_20626":57353,"_5":14148,"_27027":56696,"_2882":57354},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3396":2871,"_29729":2606,"_20626":57356,"_5":14148,"_27027":56696,"_2882":57357},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3396":2872,"_29729":2606,"_20626":57359,"_5":14148,"_27027":56696,"_2882":57360},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3396":2873,"_29729":2606,"_20626":57362,"_5":14148,"_27027":56700,"_2882":57363},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3396":2874,"_29729":2606,"_20626":57365,"_5":14148,"_27027":56700,"_2882":57366},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3396":2875,"_29729":2606,"_20626":57368,"_5":14148,"_27027":56700,"_2882":57369},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3396":2876,"_29729":2606,"_20626":57371,"_5":14148,"_27027":56700,"_2882":57372},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3396":2877,"_29729":2606,"_20626":57374,"_5":14148,"_27027":56700,"_2882":57375},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_57378":57379,"_57380":57381,"_57382":57383,"_57384":57385,"_17866":2917,"_68851":2917},"language","english","sortableProperties",[2882,29729,5,27027],"sortablePropertiesWithTypes",{"_2882":24632,"_29729":24632,"_5":24632,"_27027":24632},"sorts",{"_2882":57386,"_29729":60253,"_5":63119,"_27027":65