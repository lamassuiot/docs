44331":137239,"_44333":137242,"_44335":137245,"_44337":137248,"_44339":137251,"_44341":137254,"_44343":137257,"_44345":137260,"_44347":137263,"_44349":137266,"_44351":137269,"_44353":137272,"_44355":137275,"_44357":137278,"_44359":137281,"_44361":137284,"_44363":137287,"_44365":137290,"_44367":137293,"_44369":137296,"_44371":137299,"_44373":137302,"_44375":137305,"_44377":137308,"_44379":137311,"_44381":137314,"_44383":137317,"_44385":137320,"_44387":137323,"_44389":137326,"_44391":137329,"_44393":137332,"_44395":137335,"_44397":137338,"_44399":137341,"_44401":137344,"_44403":137347,"_44405":137350,"_44407":137353,"_44409":137356,"_44411":137359,"_44413":137362,"_44415":137365,"_44417":137368},{"_3839":77584,"_33145":77584,"_5":15996,"_3292":127526,"_33551":127527,"_22633":127530,"_29869":77584},"Despliega desde AWS Marketplace",[54324,127528,127529],"Despliegue","Otros modelos",[],{"_3839":77585,"_33145":77584,"_22633":127532,"_5":15597,"_29869":77584,"_3292":127533},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3839":77586,"_33145":77584,"_5":33548,"_22633":127535,"_29869":127536,"_3292":127537},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3839":77587,"_33145":77584,"_5":33548,"_22633":127539,"_29869":127540,"_3292":127541},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3839":77588,"_33145":77584,"_5":33548,"_22633":127543,"_29869":127544,"_3292":127545},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3839":77589,"_33145":77584,"_5":33548,"_22633":127547,"_29869":127548,"_3292":127549},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3839":77590,"_33145":77584,"_5":33548,"_22633":127551,"_29869":127552,"_3292":127553},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3839":77591,"_33145":77584,"_5":33548,"_22633":127555,"_29869":127556,"_3292":127557},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3839":77592,"_33145":77584,"_5":33548,"_22633":127559,"_29869":127560,"_3292":127561},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3839":77593,"_33145":77584,"_22633":127563,"_5":15597,"_29869":77584,"_3292":127564},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3839":77594,"_33145":77584,"_22633":127566,"_5":15597,"_29869":127536,"_3292":127567},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3839":77595,"_33145":77584,"_22633":127569,"_5":15597,"_29869":127536,"_3292":127570},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3839":77596,"_33145":77584,"_22633":127572,"_5":15597,"_29869":127536,"_3292":127573},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3839":77597,"_33145":77584,"_22633":127575,"_5":15597,"_29869":127540,"_3292":127576},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3839":77598,"_33145":77584,"_22633":127578,"_5":15597,"_29869":127540,"_3292":127579},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3839":77599,"_33145":77584,"_22633":127581,"_5":15597,"_29869":127540,"_3292":127582},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3839":77600,"_33145":77584,"_22633":127584,"_5":15597,"_29869":127544,"_3292":127585},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3839":77601,"_33145":77584,"_22633":127587,"_5":15597,"_29869":127548,"_3292":127588},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3839":77602,"_33145":77584,"_22633":127590,"_5":15597,"_29869":127552,"_3292":127591},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3839":77603,"_33145":77584,"_22633":127593,"_5":15597,"_29869":127556,"_3292":127594},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3839":77604,"_33145":77584,"_22633":127596,"_5":15597,"_29869":127560,"_3292":127597},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3839":77605,"_33145":77605,"_5":15996,"_3292":127599,"_33551":127600,"_22633":127601,"_29869":77605},"Despliega Lamassu",[54324,127528],[],{"_3839":77606,"_33145":77605,"_22633":127603,"_5":15597,"_29869":77605,"_3292":127604},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3839":77607,"_33145":77605,"_5":33548,"_22633":127606,"_29869":127607,"_3292":127608},[],"/docs/pr-preview/pr-58/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3839":77608,"_33145":77605,"_5":33548,"_22633":127610,"_29869":127611,"_3292":127612},[],"/docs/pr-preview/pr-58/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3839":77609,"_33145":77605,"_5":33548,"_22633":127614,"_29869":127615,"_3292":127616},[],"/docs/pr-preview/pr-58/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3839":77610,"_33145":77605,"_22633":127618,"_5":15597,"_29869":77605,"_3292":127619},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3839":77611,"_33145":77605,"_22633":127621,"_5":15597,"_29869":127607,"_3292":127622},[],"Modelo",{"_3839":77612,"_33145":77605,"_22633":127624,"_5":15597,"_29869":127607,"_3292":127625},[],"Recomendado para",{"_3839":77613,"_33145":77605,"_22633":127627,"_5":15597,"_29869":127607,"_3292":127628},[],"Quién opera la infraestructura",{"_3839":77614,"_33145":77605,"_22633":127630,"_5":15597,"_29869":127607,"_3292":127631},[],"Punto de partida",{"_3839":77615,"_33145":77605,"_22633":127633,"_5":15597,"_29869":127607,"_3292":54431},[],{"_3839":77616,"_33145":77605,"_22633":127635,"_5":15597,"_29869":127607,"_3292":127636},[],"Producción, entornos regulados y despliegues personalizados",{"_3839":77617,"_33145":77605,"_22633":127638,"_5":15597,"_29869":127607,"_3292":127639},[],"Tu equipo",{"_3839":77618,"_33145":77605,"_22633":127641,"_5":15597,"_29869":127607,"_3292":127642},[],"Helm o Fastlane",{"_3839":77619,"_33145":77605,"_22633":127644,"_5":15597,"_29869":127607,"_3292":54443},[],{"_3839":77620,"_33145":77605,"_22633":127646,"_5":15597,"_29869":127607,"_3292":127647},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3839":77621,"_33145":77605,"_22633":127649,"_5":15597,"_29869":127607,"_3292":127639},[],{"_3839":77622,"_33145":77605,"_22633":127651,"_5":15597,"_29869":127607,"_3292":127652},[],"Imagen preconfigurada en EC2",{"_3839":77623,"_33145":77605,"_22633":127654,"_5":15597,"_29869":127607,"_3292":54454},[],{"_3839":77624,"_33145":77605,"_22633":127656,"_5":15597,"_29869":127607,"_3292":127657},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3839":77625,"_33145":77605,"_22633":127659,"_5":15597,"_29869":127607,"_3292":54460},[],{"_3839":77626,"_33145":77605,"_22633":127661,"_5":15597,"_29869":127607,"_3292":127662},[],"Suscripción gestionada",{"_3839":77627,"_33145":77605,"_22633":127664,"_5":15597,"_29869":127607,"_3292":127665},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3839":77628,"_33145":77605,"_22633":127667,"_5":15597,"_29869":127607,"_3292":127668},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3839":77629,"_33145":77605,"_22633":127670,"_5":15597,"_29869":127607,"_3292":127671},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3839":77630,"_33145":77605,"_22633":127673,"_5":15597,"_29869":127611,"_3292":127674},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3839":77631,"_33145":77605,"_22633":127676,"_5":15597,"_29869":127615,"_3292":127677},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3839":77632,"_33145":77632,"_5":15996,"_3292":127679,"_33551":127680,"_22633":127681,"_29869":77632},"Utiliza Lamassu como SaaS",[54324,127528,127529],[],{"_3839":77633,"_33145":77632,"_22633":127683,"_5":15597,"_29869":77632,"_3292":127684},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3839":77634,"_33145":77632,"_5":33548,"_22633":127686,"_29869":127687,"_3292":127688},[],"/docs/pr-preview/pr-58/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3839":77635,"_33145":77632,"_5":33548,"_22633":127690,"_29869":127691,"_3292":127692},[],"/docs/pr-preview/pr-58/es/deployment/saas#planes","Planes",{"_3839":77636,"_33145":77632,"_5":33548,"_22633":127694,"_29869":127695,"_3292":127696},[],"/docs/pr-preview/pr-58/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3839":77637,"_33145":77632,"_22633":127698,"_5":15597,"_29869":77632,"_3292":127699},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3839":77638,"_33145":77632,"_22633":127701,"_5":15597,"_29869":127687,"_3292":127702},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3839":77639,"_33145":77632,"_22633":127704,"_5":15597,"_29869":127687,"_3292":127705},[],"Copias de seguridad automáticas.",{"_3839":77640,"_33145":77632,"_22633":127707,"_5":15597,"_29869":127687,"_3292":127708},[],"Actualizaciones de versión.",{"_3839":77641,"_33145":77632,"_22633":127710,"_5":15597,"_29869":127687,"_3292":127711},[],"Soporte técnico y SLA según el plan contratado.",{"_3839":77642,"_33145":77632,"_22633":127713,"_5":15597,"_29869":127691,"_3292":54515},[],{"_3839":77643,"_33145":77632,"_22633":127715,"_5":15597,"_29869":127691,"_3292":127716},[],"Dispositivos",{"_3839":77644,"_33145":77632,"_22633":127718,"_5":15597,"_29869":127691,"_3292":127719},[],"Soporte",{"_3839":77645,"_33145":77632,"_22633":127721,"_5":15597,"_29869":127691,"_3292":54524},[],{"_3839":77646,"_33145":77632,"_22633":127723,"_5":15597,"_29869":127691,"_3292":54527},[],{"_3839":77647,"_33145":77632,"_22633":127725,"_5":15597,"_29869":127691,"_3292":127726},[],"Hasta 1.000",{"_3839":77648,"_33145":77632,"_22633":127728,"_5":15597,"_29869":127691,"_3292":54533},[],{"_3839":77649,"_33145":77632,"_22633":127730,"_5":15597,"_29869":127691,"_3292":127731},[],"99,5 %",{"_3839":77650,"_33145":77632,"_22633":127733,"_5":15597,"_29869":127691,"_3292":54539},[],{"_3839":77651,"_33145":77632,"_22633":127735,"_5":15597,"_29869":127691,"_3292":127736},[],"Hasta 10.000",{"_3839":77652,"_33145":77632,"_22633":127738,"_5":15597,"_29869":127691,"_3292":127739},[],"Email y chat",{"_3839":77653,"_33145":77632,"_22633":127741,"_5":15597,"_29869":127691,"_3292":127742},[],"99,9 %",{"_3839":77654,"_33145":77632,"_22633":127744,"_5":15597,"_29869":127691,"_3292":54551},[],{"_3839":77655,"_33145":77632,"_22633":127746,"_5":15597,"_29869":127691,"_3292":127747},[],"Ilimitados",{"_3839":77656,"_33145":77632,"_22633":127749,"_5":15597,"_29869":127691,"_3292":127750},[],"Dedicado",{"_3839":77657,"_33145":77632,"_22633":127752,"_5":15597,"_29869":127691,"_3292":127753},[],"99,99 %",{"_3839":77658,"_33145":77632,"_22633":127755,"_5":15597,"_29869":127695,"_3292":127756},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3839":77659,"_33145":77632,"_22633":127758,"_5":15597,"_29869":127695,"_3292":127759},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3839":77660,"_33145":77660,"_5":15996,"_3292":54568,"_33551":127761,"_22633":127763,"_29869":77660},[54324,127528,127762],"Kubernetes autogestionado",[],{"_3839":77661,"_33145":77660,"_22633":127765,"_5":15597,"_29869":77660,"_3292":127766},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3839":77662,"_33145":77660,"_5":33548,"_22633":127768,"_29869":127769,"_3292":127770},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3839":77663,"_33145":77660,"_5":33548,"_22633":127772,"_29869":127773,"_3292":127774},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3839":77664,"_33145":77660,"_5":33548,"_22633":127776,"_29869":127777,"_3292":127778},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3839":77665,"_33145":77660,"_5":33548,"_22633":127780,"_29869":127781,"_3292":127782},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3839":77666,"_33145":77660,"_5":33548,"_22633":127784,"_29869":127785,"_3292":127786},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3839":77667,"_33145":77660,"_5":33548,"_22633":127788,"_29869":127789,"_3292":127790},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3839":77668,"_33145":77660,"_5":33548,"_22633":127792,"_29869":127793,"_3292":127794},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3839":77669,"_33145":77660,"_5":33548,"_22633":127796,"_29869":127797,"_3292":127798},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3839":77670,"_33145":77660,"_5":33548,"_22633":127800,"_29869":127801,"_3292":127802},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3839":77671,"_33145":77660,"_5":33548,"_22633":127804,"_29869":127805,"_3292":127806},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3839":77672,"_33145":77660,"_5":33548,"_22633":127808,"_29869":127809,"_3292":127810},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3839":77673,"_33145":77660,"_22633":127812,"_5":15597,"_29869":127769,"_3292":127813},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3839":77674,"_33145":77660,"_22633":127815,"_5":15597,"_29869":127769,"_3292":127816},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3839":77675,"_33145":77660,"_22633":127818,"_5":15597,"_29869":127773,"_3292":127819},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3839":77676,"_33145":77660,"_22633":127821,"_5":15597,"_29869":127773,"_3292":127822},[],"Fastlane instala o configura",{"_3839":77677,"_33145":77660,"_22633":127824,"_5":15597,"_29869":127773,"_3292":127825},[],"Tú sigues proporcionando",{"_3839":77678,"_33145":77660,"_22633":127827,"_5":15597,"_29869":127773,"_3292":127828},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3839":77679,"_33145":77660,"_22633":127830,"_5":15597,"_29869":127773,"_3292":127831},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3839":77680,"_33145":77660,"_22633":127833,"_5":15597,"_29869":127773,"_3292":127834},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3839":77681,"_33145":77660,"_22633":127836,"_5":15597,"_29869":127773,"_3292":127837},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3839":77682,"_33145":77660,"_22633":127839,"_5":15597,"_29869":127773,"_3292":127840},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3839":77683,"_33145":77660,"_22633":127842,"_5":15597,"_29869":127773,"_3292":127843},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3839":77684,"_33145":77660,"_22633":127845,"_5":15597,"_29869":127773,"_3292":127846},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3839":77685,"_33145":77660,"_22633":127848,"_5":15597,"_29869":127773,"_3292":127849},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3839":77686,"_33145":77660,"_22633":127851,"_5":15597,"_29869":127773,"_3292":127852},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3839":77687,"_33145":77660,"_22633":127854,"_5":15597,"_29869":127777,"_3292":127855},[],"Necesitas:",{"_3839":77688,"_33145":77660,"_22633":127857,"_5":15597,"_29869":127777,"_3292":127858},[],"un clúster Kubernetes existente",{"_3839":77689,"_33145":77660,"_22633":127860,"_5":15597,"_29869":127777,"_3292":127861},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3839":77690,"_33145":77660,"_22633":127863,"_5":15597,"_29869":127777,"_3292":54670},[],{"_3839":77691,"_33145":77660,"_22633":127865,"_5":15597,"_29869":127777,"_3292":25674},[],{"_3839":77692,"_33145":77660,"_22633":127867,"_5":15597,"_29869":127777,"_3292":127868},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3839":77693,"_33145":77660,"_22633":127870,"_5":15597,"_29869":127777,"_3292":127871},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3839":77694,"_33145":77660,"_22633":127873,"_5":15597,"_29869":127777,"_3292":127874},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3839":77695,"_33145":77660,"_22633":127876,"_5":15597,"_29869":127777,"_3292":127877},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3839":77696,"_33145":77660,"_22633":127879,"_5":15597,"_29869":127777,"_3292":127880},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3839":77697,"_33145":77660,"_22633":127882,"_5":15597,"_29869":127781,"_3292":127883},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3839":77698,"_33145":77660,"_22633":127885,"_5":15597,"_29869":127781,"_3292":127886},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3839":77699,"_33145":77660,"_22633":127888,"_5":15597,"_29869":127785,"_3292":127889},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3839":77700,"_33145":77660,"_22633":127891,"_5":15597,"_29869":127785,"_3292":127892},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3839":77701,"_33145":77660,"_22633":127894,"_5":15597,"_29869":127785,"_3292":127895},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3839":77702,"_33145":77660,"_22633":127897,"_5":15597,"_29869":127785,"_3292":127898},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3839":77703,"_33145":77660,"_22633":127900,"_5":15597,"_29869":127789,"_3292":127901},[],"Opción",{"_3839":77704,"_33145":77660,"_22633":127903,"_5":15597,"_29869":127789,"_3292":127904},[],"Valor predeterminado",{"_3839":77705,"_33145":77660,"_22633":127906,"_5":15597,"_29869":127789,"_3292":127907},[],"Propósito",{"_3839":77706,"_33145":77660,"_22633":127909,"_5":15597,"_29869":127789,"_3292":54717},[],{"_3839":77707,"_33145":77660,"_22633":127911,"_5":15597,"_29869":127789,"_3292":54720},[],{"_3839":77708,"_33145":77660,"_22633":127913,"_5":15597,"_29869":127789,"_3292":127914},[],"Muestra la ayuda",{"_3839":77709,"_33145":77660,"_22633":127916,"_5":15597,"_29869":127789,"_3292":54726},[],{"_3839":77710,"_33145":77660,"_22633":127918,"_5":15597,"_29869":127789,"_3292":127919},[],"contexto actual",{"_3839":77711,"_33145":77660,"_22633":127921,"_5":15597,"_29869":127789,"_3292":127922},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3839":77712,"_33145":77660,"_22633":127924,"_5":15597,"_29869":127789,"_3292":54735},[],{"_3839":77713,"_33145":77660,"_22633":127926,"_5":15597,"_29869":127789,"_3292":7105},[],{"_3839":77714,"_33145":77660,"_22633":127928,"_5":15597,"_29869":127789,"_3292":127929},[],"Omite prompts y genera credenciales para las dependencias",{"_3839":77715,"_33145":77660,"_22633":127931,"_5":15597,"_29869":127789,"_3292":54743},[],{"_3839":77716,"_33145":77660,"_22633":127933,"_5":15597,"_29869":127789,"_3292":54746},[],{"_3839":77717,"_33145":77660,"_22633":127935,"_5":15597,"_29869":127789,"_3292":127936},[],"Namespace de la instalación",{"_3839":77718,"_33145":77660,"_22633":127938,"_5":15597,"_29869":127789,"_3292":54752},[],{"_3839":77719,"_33145":77660,"_22633":127940,"_5":15597,"_29869":127789,"_3292":54755},[],{"_3839":77720,"_33145":77660,"_22633":127942,"_5":15597,"_29869":127789,"_3292":127943},[],"Dominio usado por la UI, OIDC y el certificado",{"_3839":77721,"_33145":77660,"_22633":127945,"_5":15597,"_29869":127789,"_3292":54761},[],{"_3839":77722,"_33145":77660,"_22633":127947,"_5":15597,"_29869":127789,"_3292":16393},[],{"_3839":77723,"_33145":77660,"_22633":127949,"_5":15597,"_29869":127789,"_3292":127950},[],"Versión del chart de Lamassu",{"_3839":77724,"_33145":77660,"_22633":127952,"_5":15597,"_29869":127789,"_3292":54769},[],{"_3839":77725,"_33145":77660,"_22633":127954,"_5":15597,"_29869":127789,"_3292":54772},[],{"_3839":77726,"_33145":77660,"_22633":127956,"_5":15597,"_29869":127789,"_3292":127957},[],"Puerto del listener HTTPS",{"_3839":77727,"_33145":77660,"_22633":127959,"_5":15597,"_29869":127789,"_3292":54778},[],{"_3839":77728,"_33145":77660,"_22633":127961,"_5":15597,"_29869":127789,"_3292":54781},[],{"_3839":77729,"_33145":77660,"_22633":127963,"_5":15597,"_29869":127789,"_3292":127964},[],"Puerto del listener HTTP",{"_3839":77730,"_33145":77660,"_22633":127966,"_5":15597,"_29869":127789,"_3292":54787},[],{"_3839":77731,"_33145":77660,"_22633":127968,"_5":15597,"_29869":127789,"_3292":54720},[],{"_3839":77732,"_33145":77660,"_22633":127970,"_5":15597,"_29869":127789,"_3292":127971},[],"Certificado PEM para TLS downstream",{"_3839":77733,"_33145":77660,"_22633":127973,"_5":15597,"_29869":127789,"_3292":54795},[],{"_3839":77734,"_33145":77660,"_22633":127975,"_5":15597,"_29869":127789,"_3292":54720},[],{"_3839":77735,"_33145":77660,"_22633":127977,"_5":15597,"_29869":127789,"_3292":127978},[],"Clave privada PEM para TLS downstream",{"_3839":77736,"_33145":77660,"_22633":127980,"_5":15597,"_29869":127789,"_3292":54803},[],{"_3839":77737,"_33145":77660,"_22633":127982,"_5":15597,"_29869":127789,"_3292":127983},[],"chart del repositorio",{"_3839":77738,"_33145":77660,"_22633":127985,"_5":15597,"_29869":127789,"_3292":127986},[],"Usa un chart local de Lamassu sin empaquetar",{"_3839":77739,"_33145":77660,"_22633":127988,"_5":15597,"_29869":127789,"_3292":54812},[],{"_3839":77740,"_33145":77660,"_22633":127990,"_5":15597,"_29869":127789,"_3292":127991},[],"detección automática",{"_3839":77741,"_33145":77660,"_22633":127993,"_5":15597,"_29869":127789,"_3292":127994},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3839":77742,"_33145":77660,"_22633":127996,"_5":15597,"_29869":127789,"_3292":54820},[],{"_3839":77743,"_33145":77660,"_22633":127998,"_5":15597,"_29869":127789,"_3292":7105},[],{"_3839":77744,"_33145":77660,"_22633":128000,"_5":15597,"_29869":127789,"_3292":128001},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3839":77745,"_33145":77660,"_22633":128003,"_5":15597,"_29869":127789,"_3292":54828},[],{"_3839":77746,"_33145":77660,"_22633":128005,"_5":15597,"_29869":127789,"_3292":7105},[],{"_3839":77747,"_33145":77660,"_22633":128007,"_5":15597,"_29869":127789,"_3292":128008},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3839":77748,"_33145":77660,"_22633":128010,"_5":15597,"_29869":127789,"_3292":54836},[],{"_3839":77749,"_33145":77660,"_22633":128012,"_5":15597,"_29869":127789,"_3292":7105},[],{"_3839":77750,"_33145":77660,"_22633":128014,"_5":15597,"_29869":127789,"_3292":128015},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3839":77751,"_33145":77660,"_22633":128017,"_5":15597,"_29869":127789,"_3292":54844},[],{"_3839":77752,"_33145":77660,"_22633":128019,"_5":15597,"_29869":127789,"_3292":7105},[],{"_3839":77753,"_33145":77660,"_22633":128021,"_5":15597,"_29869":127789,"_3292":128022},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3839":77754,"_33145":77660,"_22633":128024,"_5":15597,"_29869":127789,"_3292":54852},[],{"_3839":77755,"_33145":77660,"_22633":128026,"_5":15597,"_29869":127789,"_3292":54855},[],{"_3839":77756,"_33145":77660,"_22633":128028,"_5":15597,"_29869":127789,"_3292":128029},[],"Usa otro chart local de SoftHSM",{"_3839":77757,"_33145":77660,"_22633":128031,"_5":15597,"_29869":127789,"_3292":128032},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3839":77758,"_33145":77660,"_22633":128034,"_5":15597,"_29869":127793,"_3292":128035},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3839":77759,"_33145":77660,"_22633":128037,"_5":15597,"_29869":127793,"_3292":128038},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3839":77760,"_33145":77660,"_22633":128040,"_5":15597,"_29869":127793,"_3292":128041},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3839":77761,"_33145":77660,"_22633":128043,"_5":15597,"_29869":127793,"_3292":128044},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3839":77762,"_33145":77660,"_22633":128046,"_5":15597,"_29869":127793,"_3292":128047},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3839":77763,"_33145":77660,"_22633":128049,"_5":15597,"_29869":127793,"_3292":128050},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3839":77764,"_33145":77660,"_22633":128052,"_5":15597,"_29869":127797,"_3292":54882},[],{"_3839":77765,"_33145":77660,"_22633":128054,"_5":15597,"_29869":127797,"_3292":128055},[],"valida las herramientas locales y el clúster seleccionado",{"_3839":77766,"_33145":77660,"_22633":128057,"_5":15597,"_29869":127797,"_3292":128058},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3839":77767,"_33145":77660,"_22633":128060,"_5":15597,"_29869":127797,"_3292":128061},[],"crea el namespace",{"_3839":77768,"_33145":77660,"_22633":128063,"_5":15597,"_29869":127797,"_3292":128064},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3839":77769,"_33145":77660,"_22633":128066,"_5":15597,"_29869":127797,"_3292":128067},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3839":77770,"_33145":77660,"_22633":128069,"_5":15597,"_29869":127797,"_3292":128070},[],"instala RabbitMQ",{"_3839":77771,"_33145":77660,"_22633":128072,"_5":15597,"_29869":127797,"_3292":128073},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3839":77772,"_33145":77660,"_22633":128075,"_5":15597,"_29869":127797,"_3292":128076},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3839":77773,"_33145":77660,"_22633":128078,"_5":15597,"_29869":127797,"_3292":128079},[],"carga datos de ejemplo opcionalmente",{"_3839":77774,"_33145":77660,"_22633":128081,"_5":15597,"_29869":127797,"_3292":128082},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3839":77775,"_33145":77660,"_22633":128084,"_5":15597,"_29869":127801,"_3292":128085},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3839":77776,"_33145":77660,"_22633":128087,"_5":15597,"_29869":127801,"_3292":128088},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3839":77777,"_33145":77660,"_22633":128090,"_5":15597,"_29869":127805,"_3292":128091},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3839":77778,"_33145":77660,"_22633":128093,"_5":15597,"_29869":127805,"_3292":128094},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3839":77779,"_33145":77660,"_22633":128096,"_5":15597,"_29869":127805,"_3292":128097},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3839":77780,"_33145":77660,"_22633":128099,"_5":15597,"_29869":127809,"_3292":128100},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3839":77781,"_33145":77781,"_5":15996,"_3292":128102,"_33551":128103,"_22633":128104,"_29869":77781},"Instala con Helm",[54324,127528,127762],[],{"_3839":77782,"_33145":77781,"_22633":128106,"_5":15597,"_29869":77781,"_3292":128107},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3839":77783,"_33145":77781,"_5":33548,"_22633":128109,"_29869":128110,"_3292":128111},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3839":77784,"_33145":77781,"_5":33548,"_22633":128113,"_29869":128114,"_3292":127778},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3839":77785,"_33145":77781,"_5":33548,"_22633":128116,"_29869":128117,"_3292":128118},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3839":77786,"_33145":77781,"_5":33548,"_22633":128120,"_29869":128121,"_3292":128122},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3839":77787,"_33145":77781,"_5":33548,"_22633":128124,"_29869":128125,"_3292":128126},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3839":77788,"_33145":77781,"_5":33548,"_22633":128128,"_29869":128129,"_3292":128130},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3839":77789,"_33145":77781,"_5":33548,"_22633":128132,"_29869":128133,"_3292":128134},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3839":77790,"_33145":77781,"_5":33548,"_22633":128136,"_29869":128137,"_3292":128138},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3839":77791,"_33145":77781,"_5":33548,"_22633":128140,"_29869":128141,"_3292":128142},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3839":77792,"_33145":77781,"_5":33548,"_22633":128144,"_29869":128145,"_3292":128146},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3839":77793,"_33145":77781,"_5":33548,"_22633":128148,"_29869":128149,"_3292":128150},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3839":77794,"_33145":77781,"_22633":128152,"_5":15597,"_29869":128110,"_3292":128153},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3839":77795,"_33145":77781,"_22633":128155,"_5":15597,"_29869":128114,"_3292":128156},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3839":77796,"_33145":77781,"_22633":128158,"_5":15597,"_29869":128114,"_3292":128159},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3839":77797,"_33145":77781,"_22633":128161,"_5":15597,"_29869":128114,"_3292":128162},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3839":77798,"_33145":77781,"_22633":128164,"_5":15597,"_29869":128114,"_3292":128165},[],"un broker RabbitMQ accesible y sus credenciales",{"_3839":77799,"_33145":77781,"_22633":128167,"_5":15597,"_29869":128114,"_3292":128168},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3839":77800,"_33145":77781,"_22633":128170,"_5":15597,"_29869":128114,"_3292":128171},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3839":77801,"_33145":77781,"_22633":128173,"_5":15597,"_29869":128114,"_3292":128174},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3839":77802,"_33145":77781,"_22633":128176,"_5":15597,"_29869":128114,"_3292":128177},[],"una StorageClass y un diseño de tráfico externo",{"_3839":77803,"_33145":77781,"_22633":128179,"_5":15597,"_29869":128114,"_3292":128180},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3839":77804,"_33145":77781,"_22633":128182,"_5":15597,"_29869":128114,"_3292":128183},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3839":77805,"_33145":77781,"_22633":128185,"_5":15597,"_29869":128114,"_3292":128186},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3839":77806,"_33145":77781,"_22633":128188,"_5":15597,"_29869":128117,"_3292":128189},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3839":77807,"_33145":77781,"_22633":128191,"_5":15597,"_29869":128117,"_3292":128192},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3839":77808,"_33145":77781,"_22633":128194,"_5":15597,"_29869":128117,"_3292":128195},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3839":77809,"_33145":77781,"_22633":128197,"_5":15597,"_29869":128121,"_3292":128198},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3839":77810,"_33145":77781,"_22633":128200,"_5":15597,"_29869":128121,"_3292":128201},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3839":77811,"_33145":77781,"_22633":128203,"_5":15597,"_29869":128121,"_3292":128204},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3839":77812,"_33145":77781,"_22633":128206,"_5":15597,"_29869":128121,"_3292":128207},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3839":77813,"_33145":77781,"_22633":128209,"_5":15597,"_29869":128125,"_3292":128210},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3839":77814,"_33145":77781,"_22633":128212,"_5":15597,"_29869":128129,"_3292":128213},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3839":77815,"_33145":77781,"_22633":128215,"_5":15597,"_29869":128129,"_3292":128216},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3839":77816,"_33145":77781,"_22633":128218,"_5":15597,"_29869":128129,"_3292":128219},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3839":77817,"_33145":77781,"_22633":128221,"_5":15597,"_29869":128129,"_3292":128222},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3839":77818,"_33145":77781,"_22633":128224,"_5":15597,"_29869":128129,"_3292":128225},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3839":77819,"_33145":77781,"_22633":128227,"_5":15597,"_29869":128129,"_3292":128228},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3839":77820,"_33145":77781,"_22633":128230,"_5":15597,"_29869":128129,"_3292":128231},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3839":77821,"_33145":77781,"_22633":128233,"_5":15597,"_29869":128133,"_3292":128234},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3839":77822,"_33145":77781,"_22633":128236,"_5":15597,"_29869":128133,"_3292":128237},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3839":77823,"_33145":77781,"_22633":128239,"_5":15597,"_29869":128133,"_3292":128240},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3839":77824,"_33145":77781,"_22633":128242,"_5":15597,"_29869":128133,"_3292":128243},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3839":77825,"_33145":77781,"_22633":128245,"_5":15597,"_29869":128137,"_3292":128246},[],"Para instalar un checkout local:",{"_3839":77826,"_33145":77781,"_22633":128248,"_5":15597,"_29869":128141,"_3292":128249},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3839":77827,"_33145":77781,"_22633":128251,"_5":15597,"_29869":128141,"_3292":128252},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3839":77828,"_33145":77781,"_22633":128254,"_5":15597,"_29869":128145,"_3292":128255},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3839":77829,"_33145":77781,"_22633":128257,"_5":15597,"_29869":128145,"_3292":128258},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3839":77830,"_33145":77781,"_22633":128260,"_5":15597,"_29869":128145,"_3292":128261},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3839":77831,"_33145":77781,"_22633":128263,"_5":15597,"_29869":128145,"_3292":128264},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3839":77832,"_33145":77781,"_22633":128266,"_5":15597,"_29869":128145,"_3292":128267},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3839":77833,"_33145":77781,"_22633":128269,"_5":15597,"_29869":128149,"_3292":128270},[],"Antes de pasar a producción, revisa:",{"_3839":77834,"_33145":77781,"_22633":128272,"_5":15597,"_29869":128149,"_3292":128273},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3839":77835,"_33145":77781,"_22633":128275,"_5":15597,"_29869":128149,"_3292":128276},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3839":77836,"_33145":77781,"_22633":128278,"_5":15597,"_29869":128149,"_3292":128279},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3839":77837,"_33145":77781,"_22633":128281,"_5":15597,"_29869":128149,"_3292":128282},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3839":77838,"_33145":77781,"_22633":128284,"_5":15597,"_29869":128149,"_3292":128285},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3839":77839,"_33145":77781,"_22633":128287,"_5":15597,"_29869":128149,"_3292":128288},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3839":77840,"_33145":77781,"_22633":128290,"_5":15597,"_29869":128149,"_3292":128291},[],"SMTP, observabilidad y entrega de alertas",{"_3839":77841,"_33145":77781,"_22633":128293,"_5":15597,"_29869":128149,"_3292":128294},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3839":77842,"_33145":77781,"_22633":128296,"_5":15597,"_29869":128149,"_3292":128297},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3839":77843,"_33145":77843,"_5":15996,"_3292":128299,"_33551":128300,"_22633":128301,"_29869":77843},"Expón el Gateway",[54324,127528,127762],[],{"_3839":77844,"_33145":77843,"_22633":128303,"_5":15597,"_29869":77843,"_3292":128304},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3839":77845,"_33145":77843,"_5":33548,"_22633":128306,"_29869":128307,"_3292":128308},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3839":77846,"_33145":77843,"_5":33548,"_22633":128310,"_29869":128311,"_3292":128312},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3839":77847,"_33145":77843,"_5":33548,"_22633":128314,"_29869":128315,"_3292":128316},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3839":77848,"_33145":77843,"_5":33548,"_22633":128318,"_29869":128319,"_3292":55150},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#k3s",{"_3839":77849,"_33145":77843,"_5":33548,"_22633":128321,"_29869":128322,"_3292":128323},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3839":77850,"_33145":77843,"_5":33548,"_22633":128325,"_29869":128326,"_3292":128327},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3839":77851,"_33145":77843,"_5":33548,"_22633":128329,"_29869":128330,"_3292":128331},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3839":77852,"_33145":77843,"_5":33548,"_22633":128333,"_29869":128334,"_3292":128335},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3839":77853,"_33145":77843,"_5":33548,"_22633":128337,"_29869":128338,"_3292":128339},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3839":77854,"_33145":77843,"_5":33548,"_22633":128341,"_29869":128342,"_3292":128343},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3839":77855,"_33145":77843,"_22633":128345,"_5":15597,"_29869":128307,"_3292":128346},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3839":77856,"_33145":77843,"_22633":128348,"_5":15597,"_29869":128307,"_3292":128349},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3839":77857,"_33145":77843,"_22633":128351,"_5":15597,"_29869":128311,"_3292":128352},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3839":77858,"_33145":77843,"_22633":128354,"_5":15597,"_29869":128311,"_3292":128355},[],"Defínelo únicamente cuando:",{"_3839":77859,"_33145":77843,"_22633":128357,"_5":15597,"_29869":128311,"_3292":128358},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3839":77860,"_33145":77843,"_22633":128360,"_5":15597,"_29869":128311,"_3292":128361},[],"esa dirección está asignada a este Gateway",{"_3839":77861,"_33145":77843,"_22633":128363,"_5":15597,"_29869":128311,"_3292":128364},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3839":77862,"_33145":77843,"_22633":128366,"_5":15597,"_29869":128311,"_3292":128367},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3839":77863,"_33145":77843,"_22633":128369,"_5":15597,"_29869":128311,"_3292":128370},[],"No confundas estos valores:",{"_3839":77864,"_33145":77843,"_22633":128372,"_5":15597,"_29869":128311,"_3292":128373},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3839":77865,"_33145":77843,"_22633":128375,"_5":15597,"_29869":128311,"_3292":128376},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3839":77866,"_33145":77843,"_22633":128378,"_5":15597,"_29869":128311,"_3292":128379},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3839":77867,"_33145":77843,"_22633":128381,"_5":15597,"_29869":128315,"_3292":128382},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3839":77868,"_33145":77843,"_22633":128384,"_5":15597,"_29869":128315,"_3292":128385},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3839":77869,"_33145":77843,"_22633":128387,"_5":15597,"_29869":128319,"_3292":128388},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3839":77870,"_33145":77843,"_22633":128390,"_5":15597,"_29869":128319,"_3292":128391},[],"Para el diseño recomendado:",{"_3839":77871,"_33145":77843,"_22633":128393,"_5":15597,"_29869":128319,"_3292":128394},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3839":77872,"_33145":77843,"_22633":128396,"_5":15597,"_29869":128319,"_3292":128397},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3839":77873,"_33145":77843,"_22633":128399,"_5":15597,"_29869":128319,"_3292":128400},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3839":77874,"_33145":77843,"_22633":128402,"_5":15597,"_29869":128319,"_3292":128403},[],"Apunta DNS a la dirección accesible de la VM.",{"_3839":77875,"_33145":77843,"_22633":128405,"_5":15597,"_29869":128319,"_3292":128406},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3839":77876,"_33145":77843,"_22633":128408,"_5":15597,"_29869":128322,"_3292":128409},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3839":77877,"_33145":77843,"_22633":128411,"_5":15597,"_29869":128326,"_3292":128412},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3839":77878,"_33145":77843,"_22633":128414,"_5":15597,"_29869":128326,"_3292":128415},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3839":77879,"_33145":77843,"_22633":128417,"_5":15597,"_29869":128330,"_3292":128418},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3839":77880,"_33145":77843,"_22633":128420,"_5":15597,"_29869":128330,"_3292":128421},[],"Requisito",{"_3839":77881,"_33145":77843,"_22633":128423,"_5":15597,"_29869":128330,"_3292":128424},[],"Diseño recomendado",{"_3839":77882,"_33145":77843,"_22633":128426,"_5":15597,"_29869":128330,"_3292":128427},[],"Consecuencia",{"_3839":77883,"_33145":77843,"_22633":128429,"_5":15597,"_29869":128330,"_3292":128430},[],"Varias URL o servicios de Lamassu",{"_3839":77884,"_33145":77843,"_22633":128432,"_5":15597,"_29869":128330,"_3292":128433},[],"Un Gateway con varias rutas",{"_3839":77885,"_33145":77843,"_22633":128435,"_5":15597,"_29869":128330,"_3292":128436},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3839":77886,"_33145":77843,"_22633":128438,"_5":15597,"_29869":128330,"_3292":128439},[],"Gateways independientes e IP externas distintas",{"_3839":77887,"_33145":77843,"_22633":128441,"_5":15597,"_29869":128330,"_3292":128442},[],"Una VIP por Gateway",{"_3839":77888,"_33145":77843,"_22633":128444,"_5":15597,"_29869":128330,"_3292":128445},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3839":77889,"_33145":77843,"_22633":128447,"_5":15597,"_29869":128330,"_3292":128448},[],"Gateways independientes, un nodo y una IP",{"_3839":77890,"_33145":77843,"_22633":128450,"_5":15597,"_29869":128330,"_3292":128451},[],"Puertos externos diferentes",{"_3839":77891,"_33145":77843,"_22633":128453,"_5":15597,"_29869":128330,"_3292":128454},[],"Los clientes deben indicar puertos no estándar",{"_3839":77892,"_33145":77843,"_22633":128456,"_5":15597,"_29869":128330,"_3292":128457},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3839":77893,"_33145":77843,"_22633":128459,"_5":15597,"_29869":128330,"_3292":128460},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3839":77894,"_33145":77843,"_22633":128462,"_5":15597,"_29869":128330,"_3292":128463},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3839":77895,"_33145":77843,"_22633":128465,"_5":15597,"_29869":128330,"_3292":128466},[],"Recursos Gateway separados pero proxy compartido",{"_3839":77896,"_33145":77843,"_22633":128468,"_5":15597,"_29869":128330,"_3292":128469},[],"Modo merged Gateway de Envoy",{"_3839":77897,"_33145":77843,"_22633":128471,"_5":15597,"_29869":128330,"_3292":128472},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3839":77898,"_33145":77843,"_22633":128474,"_5":15597,"_29869":128330,"_3292":128475},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3839":77899,"_33145":77843,"_22633":128477,"_5":15597,"_29869":128330,"_3292":128478},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3839":77900,"_33145":77843,"_22633":128480,"_5":15597,"_29869":128330,"_3292":128481},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3839":77901,"_33145":77843,"_22633":128483,"_5":15597,"_29869":128330,"_3292":128484},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3839":77902,"_33145":77843,"_22633":128486,"_5":15597,"_29869":128334,"_3292":128487},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3839":77903,"_33145":77843,"_22633":128489,"_5":15597,"_29869":128334,"_3292":128490},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3839":77904,"_33145":77843,"_22633":128492,"_5":15597,"_29869":128334,"_3292":128493},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3839":77905,"_33145":77843,"_22633":128495,"_5":15597,"_29869":128334,"_3292":128496},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3839":77906,"_33145":77843,"_22633":128498,"_5":15597,"_29869":128334,"_3292":128499},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3839":77907,"_33145":77843,"_22633":128501,"_5":15597,"_29869":128338,"_3292":128502},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3839":77908,"_33145":77843,"_22633":128504,"_5":15597,"_29869":128338,"_3292":128505},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3839":77909,"_33145":77843,"_22633":128507,"_5":15597,"_29869":128342,"_3292":128508},[],"Comprueba, en orden:",{"_3839":77910,"_33145":77843,"_22633":128510,"_5":15597,"_29869":128342,"_3292":128511},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3839":77911,"_33145":77843,"_22633":128513,"_5":15597,"_29869":128342,"_3292":128514},[],"Su estado contiene la dirección esperada.",{"_3839":77912,"_33145":77843,"_22633":128516,"_5":15597,"_29869":128342,"_3292":128517},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3839":77913,"_33145":77843,"_22633":128519,"_5":15597,"_29869":128342,"_3292":128520},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3839":77914,"_33145":77843,"_22633":128522,"_5":15597,"_29869":128342,"_3292":128523},[],"DNS resuelve al endpoint accesible externamente.",{"_3839":77915,"_33145":77843,"_22633":128525,"_5":15597,"_29869":128342,"_3292":128526},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3839":77916,"_33145":77843,"_22633":128528,"_5":15597,"_29869":128342,"_3292":128529},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3839":77917,"_33145":77917,"_5":15996,"_3292":54431,"_33551":128531,"_22633":128532,"_29869":77917},[54324,127528,127762],[],{"_3839":77918,"_33145":77917,"_22633":128534,"_5":15597,"_29869":77917,"_3292":128535},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3839":77919,"_33145":77917,"_5":33548,"_22633":128537,"_29869":128538,"_3292":128539},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3839":77920,"_33145":77917,"_5":33548,"_22633":128541,"_29869":128542,"_3292":128543},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3839":77921,"_33145":77917,"_5":33548,"_22633":128545,"_29869":128546,"_3292":128547},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3839":77922,"_33145":77917,"_5":33548,"_22633":128549,"_29869":128550,"_3292":128551},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3839":77923,"_33145":77917,"_5":33548,"_22633":128553,"_29869":128554,"_3292":128555},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3839":77924,"_33145":77917,"_5":33548,"_22633":128557,"_29869":128558,"_3292":128559},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3839":77925,"_33145":77917,"_22633":128561,"_5":15597,"_29869":128538,"_3292":128562},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3839":77926,"_33145":77917,"_22633":128564,"_5":15597,"_29869":128542,"_3292":128565},[],"Flujo",{"_3839":77927,"_33145":77917,"_22633":128567,"_5":15597,"_29869":128542,"_3292":128568},[],"Úsalo para",{"_3839":77928,"_33145":77917,"_22633":128570,"_5":15597,"_29869":128542,"_3292":128571},[],"Qué instala",{"_3839":77929,"_33145":77917,"_22633":128573,"_5":15597,"_29869":128542,"_3292":55405},[],{"_3839":77930,"_33145":77917,"_22633":128575,"_5":15597,"_29869":128542,"_3292":128576},[],"Producción y entornos controlados",{"_3839":77931,"_33145":77917,"_22633":128578,"_5":15597,"_29869":128542,"_3292":128579},[],"Servicios de Lamassu y recursos de Gateway API",{"_3839":77932,"_33145":77917,"_22633":128581,"_5":15597,"_29869":128542,"_3292":54568},[],{"_3839":77933,"_33145":77917,"_22633":128583,"_5":15597,"_29869":128542,"_3292":128584},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3839":77934,"_33145":77917,"_22633":128586,"_5":15597,"_29869":128542,"_3292":128587},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3839":77935,"_33145":77917,"_22633":128589,"_5":15597,"_29869":128546,"_3292":128590},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3839":77936,"_33145":77917,"_22633":128592,"_5":15597,"_29869":128546,"_3292":128593},[],"Área",{"_3839":77937,"_33145":77917,"_22633":128595,"_5":15597,"_29869":128546,"_3292":128596},[],"El chart de Lamassu proporciona",{"_3839":77938,"_33145":77917,"_22633":128598,"_5":15597,"_29869":128546,"_3292":128599},[],"Tú proporcionas",{"_3839":77939,"_33145":77917,"_22633":128601,"_5":15597,"_29869":128546,"_3292":128602},[],"Aplicaciones Lamassu",{"_3839":77940,"_33145":77917,"_22633":128604,"_5":15597,"_29869":128546,"_3292":128605},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3839":77941,"_33145":77917,"_22633":128607,"_5":15597,"_29869":128546,"_3292":128608},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3839":77942,"_33145":77917,"_22633":128610,"_5":15597,"_29869":128546,"_3292":128611},[],"Datos PostgreSQL",{"_3839":77943,"_33145":77917,"_22633":128613,"_5":15597,"_29869":128546,"_3292":128614},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3839":77944,"_33145":77917,"_22633":128616,"_5":15597,"_29869":128546,"_3292":128617},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3839":77945,"_33145":77917,"_22633":128619,"_5":15597,"_29869":128546,"_3292":128620},[],"Mensajería",{"_3839":77946,"_33145":77917,"_22633":128622,"_5":15597,"_29869":128546,"_3292":128623},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3839":77947,"_33145":77917,"_22633":128625,"_5":15597,"_29869":128546,"_3292":128626},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3839":77948,"_33145":77917,"_22633":128628,"_5":15597,"_29869":128546,"_3292":128629},[],"Identidad",{"_3839":77949,"_33145":77917,"_22633":128631,"_5":15597,"_29869":128546,"_3292":128632},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3839":77950,"_33145":77917,"_22633":128634,"_5":15597,"_29869":128546,"_3292":128635},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3839":77951,"_33145":77917,"_22633":128637,"_5":15597,"_29869":128546,"_3292":128638},[],"Enrutamiento externo",{"_3839":77952,"_33145":77917,"_22633":128640,"_5":15597,"_29869":128546,"_3292":128641},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3839":77953,"_33145":77917,"_22633":128643,"_5":15597,"_29869":128546,"_3292":128644},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3839":77954,"_33145":77917,"_22633":128646,"_5":15597,"_29869":128546,"_3292":55479},[],{"_3839":77955,"_33145":77917,"_22633":128648,"_5":15597,"_29869":128546,"_3292":128649},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3839":77956,"_33145":77917,"_22633":128651,"_5":15597,"_29869":128546,"_3292":128652},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3839":77957,"_33145":77917,"_22633":128654,"_5":15597,"_29869":128546,"_3292":128655},[],"Datos persistentes de la aplicación",{"_3839":77958,"_33145":77917,"_22633":128657,"_5":15597,"_29869":128546,"_3292":128658},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3839":77959,"_33145":77917,"_22633":128660,"_5":15597,"_29869":128546,"_3292":128661},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3839":77960,"_33145":77917,"_22633":128663,"_5":15597,"_29869":128546,"_3292":128664},[],"Integraciones opcionales",{"_3839":77961,"_33145":77917,"_22633":128666,"_5":15597,"_29869":128546,"_3292":128667},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3839":77962,"_33145":77917,"_22633":128669,"_5":15597,"_29869":128546,"_3292":128670},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3839":77963,"_33145":77917,"_22633":128672,"_5":15597,"_29869":128546,"_3292":128673},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3839":77964,"_33145":77917,"_22633":128675,"_5":15597,"_29869":128546,"_3292":128676},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3839":77965,"_33145":77917,"_22633":128678,"_5":15597,"_29869":128550,"_3292":128679},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3839":77966,"_33145":77917,"_22633":128681,"_5":15597,"_29869":128550,"_3292":128682},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3839":77967,"_33145":77917,"_22633":128684,"_5":15597,"_29869":128554,"_3292":128685},[],"Kubernetes 1.24 o posterior",{"_3839":77968,"_33145":77917,"_22633":128687,"_5":15597,"_29869":128554,"_3292":128688},[],"Helm 3.2 o posterior",{"_3839":77969,"_33145":77917,"_22633":128690,"_5":15597,"_29869":128554,"_3292":128691},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3839":77970,"_33145":77917,"_22633":128693,"_5":15597,"_29869":128554,"_3292":128694},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3839":77971,"_33145":77917,"_22633":128696,"_5":15597,"_29869":128554,"_3292":128697},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3839":77972,"_33145":77917,"_22633":128699,"_5":15597,"_29869":128554,"_3292":128700},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3839":77973,"_33145":77917,"_22633":128702,"_5":15597,"_29869":128554,"_3292":128703},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3839":77974,"_33145":77917,"_22633":128705,"_5":15597,"_29869":128558,"_3292":128706},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3839":77975,"_33145":77917,"_22633":128708,"_5":15597,"_29869":128558,"_3292":128709},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3839":77976,"_33145":77917,"_22633":128711,"_5":15597,"_29869":128558,"_3292":128712},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3839":77977,"_33145":77917,"_22633":128714,"_5":15597,"_29869":128558,"_3292":128715},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3839":77978,"_33145":77978,"_5":15996,"_3292":128717,"_33551":128718,"_22633":128720,"_29869":77978},"Resolución de problemas de despliegue",[54324,127528,128719],"Operación",[],{"_3839":77979,"_33145":77978,"_22633":128722,"_5":15597,"_29869":77978,"_3292":128723},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3839":77980,"_33145":77978,"_5":33548,"_22633":128725,"_29869":128726,"_3292":128727},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3839":77981,"_33145":77978,"_5":33548,"_22633":128729,"_29869":128730,"_3292":128731},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3839":77982,"_33145":77978,"_5":33548,"_22633":128733,"_29869":128734,"_3292":128735},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3839":77983,"_33145":77978,"_5":33548,"_22633":128737,"_29869":128738,"_3292":128739},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3839":77984,"_33145":77978,"_5":33548,"_22633":128741,"_29869":128742,"_3292":128743},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3839":77985,"_33145":77978,"_5":33548,"_22633":128745,"_29869":128746,"_3292":128747},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3839":77986,"_33145":77978,"_5":33548,"_22633":128749,"_29869":128750,"_3292":128751},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3839":77987,"_33145":77978,"_5":33548,"_22633":128753,"_29869":128754,"_3292":128755},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3839":77988,"_33145":77978,"_5":33548,"_22633":128757,"_29869":128758,"_3292":128759},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3839":77989,"_33145":77978,"_5":33548,"_22633":128761,"_29869":128762,"_3292":128763},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3839":77990,"_33145":77978,"_5":33548,"_22633":128765,"_29869":128766,"_3292":128767},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3839":77991,"_33145":77978,"_5":33548,"_22633":128769,"_29869":128770,"_3292":128771},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3839":77992,"_33145":77978,"_5":33548,"_22633":128773,"_29869":128774,"_3292":128775},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3839":77993,"_33145":77978,"_22633":128777,"_5":15597,"_29869":77978,"_3292":128778},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3839":77994,"_33145":77978,"_22633":128780,"_5":15597,"_29869":128730,"_3292":128781},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3839":77995,"_33145":77978,"_22633":128783,"_5":15597,"_29869":128734,"_3292":128784},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3839":77996,"_33145":77978,"_22633":128786,"_5":15597,"_29869":128738,"_3292":128787},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3839":77997,"_33145":77978,"_22633":128789,"_5":15597,"_29869":128742,"_3292":128790},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3839":77998,"_33145":77978,"_22633":128792,"_5":15597,"_29869":128746,"_3292":128793},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3839":77999,"_33145":77978,"_22633":128795,"_5":15597,"_29869":128750,"_3292":128796},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3839":78000,"_33145":77978,"_22633":128798,"_5":15597,"_29869":128750,"_3292":128799},[],"Ejecuta también la prueba de conectividad del chart:",{"_3839":78001,"_33145":77978,"_22633":128801,"_5":15597,"_29869":128750,"_3292":128802},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3839":78002,"_33145":77978,"_22633":128804,"_5":15597,"_29869":128750,"_3292":128805},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3839":78003,"_33145":77978,"_22633":128807,"_5":15597,"_29869":128754,"_3292":128808},[],"Si recibes un 401:",{"_3839":78004,"_33145":77978,"_22633":128810,"_5":15597,"_29869":128754,"_3292":128811},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3839":78005,"_33145":77978,"_22633":128813,"_5":15597,"_29869":128754,"_3292":128814},[],"verifica emisor, audiencia y expiración del token;",{"_3839":78006,"_33145":77978,"_22633":128816,"_5":15597,"_29869":128754,"_3292":128817},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3839":78007,"_33145":77978,"_22633":128819,"_5":15597,"_29869":128754,"_3292":128820},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3839":78008,"_33145":77978,"_22633":128822,"_5":15597,"_29869":128754,"_3292":128823},[],"Si el login termina pero las APIs devuelven 403:",{"_3839":78009,"_33145":77978,"_22633":128825,"_5":15597,"_29869":128754,"_3292":128826},[],"inspecciona los claims reales del token;",{"_3839":78010,"_33145":77978,"_22633":128828,"_5":15597,"_29869":128754,"_3292":128829},[],"confirma que coinciden con un principal activo;",{"_3839":78011,"_33145":77978,"_22633":128831,"_5":15597,"_29869":128754,"_3292":128832},[],"revisa las políticas concedidas al principal;",{"_3839":78012,"_33145":77978,"_22633":128834,"_5":15597,"_29869":128754,"_3292":128835},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3839":78013,"_33145":77978,"_22633":128837,"_5":15597,"_29869":128754,"_3292":128838},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3839":78014,"_33145":77978,"_22633":128840,"_5":15597,"_29869":128758,"_3292":128841},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3839":78015,"_33145":77978,"_22633":128843,"_5":15597,"_29869":128758,"_3292":128844},[],"Localiza el pod y Service de authz.",{"_3839":78016,"_33145":77978,"_22633":128846,"_5":15597,"_29869":128758,"_3292":128847},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3839":78017,"_33145":77978,"_22633":128849,"_5":15597,"_29869":128758,"_3292":128850},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3839":78018,"_33145":77978,"_22633":128852,"_5":15597,"_29869":128758,"_3292":128853},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3839":78019,"_33145":77978,"_22633":128855,"_5":15597,"_29869":128758,"_3292":128856},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3839":78020,"_33145":77978,"_22633":128858,"_5":15597,"_29869":128762,"_3292":128859},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3839":78021,"_33145":77978,"_22633":128861,"_5":15597,"_29869":128766,"_3292":128862},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3839":78022,"_33145":77978,"_22633":128864,"_5":15597,"_29869":128766,"_3292":128865},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3839":78023,"_33145":77978,"_22633":128867,"_5":15597,"_29869":128766,"_3292":128868},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3839":78024,"_33145":77978,"_22633":128870,"_5":15597,"_29869":128766,"_3292":128871},[],"volumen persistente sin enlazar;",{"_3839":78025,"_33145":77978,"_22633":128873,"_5":15597,"_29869":128766,"_3292":128874},[],"imagen inaccesible o política de pull incorrecta;",{"_3839":78026,"_33145":77978,"_22633":128876,"_5":15597,"_29869":128766,"_3292":128877},[],"configuración inválida del motor criptográfico;",{"_3839":78027,"_33145":77978,"_22633":128879,"_5":15597,"_29869":128766,"_3292":128880},[],"límites de CPU o memoria demasiado bajos;",{"_3839":78028,"_33145":77978,"_22633":128882,"_5":15597,"_29869":128766,"_3292":128883},[],"migración previa incompleta.",{"_3839":78029,"_33145":77978,"_22633":128885,"_5":15597,"_29869":128766,"_3292":128886},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3839":78030,"_33145":77978,"_22633":128888,"_5":15597,"_29869":128766,"_3292":128889},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3839":78031,"_33145":77978,"_22633":128891,"_5":15597,"_29869":128766,"_3292":128892},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3839":78032,"_33145":77978,"_22633":128894,"_5":15597,"_29869":128770,"_3292":128895},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3839":78033,"_33145":77978,"_22633":128897,"_5":15597,"_29869":128770,"_3292":128898},[],"verifica que esté habilitado en el servicio emisor;",{"_3839":78034,"_33145":77978,"_22633":128900,"_5":15597,"_29869":128770,"_3292":128901},[],"comprueba conectividad y credenciales AMQP;",{"_3839":78035,"_33145":77978,"_22633":128903,"_5":15597,"_29869":128770,"_3292":128904},[],"revisa exchange, routing key, colas y consumidores;",{"_3839":78036,"_33145":77978,"_22633":128906,"_5":15597,"_29869":128770,"_3292":128907},[],"inspecciona dead-letter queues;",{"_3839":78037,"_33145":77978,"_22633":128909,"_5":15597,"_29869":128770,"_3292":128910},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3839":78038,"_33145":77978,"_22633":128912,"_5":15597,"_29869":128770,"_3292":128913},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3839":78039,"_33145":77978,"_22633":128915,"_5":15597,"_29869":128770,"_3292":128916},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3839":78040,"_33145":77978,"_22633":128918,"_5":15597,"_29869":128770,"_3292":128919},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3839":78041,"_33145":77978,"_22633":128921,"_5":15597,"_29869":128770,"_3292":128922},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3839":78042,"_33145":77978,"_22633":128924,"_5":15597,"_29869":128770,"_3292":128925},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3839":78043,"_33145":77978,"_22633":128927,"_5":15597,"_29869":128770,"_3292":128928},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3839":78044,"_33145":77978,"_22633":128930,"_5":15597,"_29869":128770,"_3292":128931},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3839":78045,"_33145":77978,"_22633":128933,"_5":15597,"_29869":128774,"_3292":128934},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3839":78046,"_33145":77978,"_22633":128936,"_5":15597,"_29869":128774,"_3292":128937},[],"Antes de cerrar una incidencia, guarda:",{"_3839":78047,"_33145":77978,"_22633":128939,"_5":15597,"_29869":128774,"_3292":128940},[],"causa confirmada;",{"_3839":78048,"_33145":77978,"_22633":128942,"_5":15597,"_29869":128774,"_3292":128943},[],"alcance temporal y recursos afectados;",{"_3839":78049,"_33145":77978,"_22633":128945,"_5":15597,"_29869":128774,"_3292":128946},[],"comandos o consultas utilizados;",{"_3839":78050,"_33145":77978,"_22633":128948,"_5":15597,"_29869":128774,"_3292":128949},[],"cambio aplicado y forma de revertirlo;",{"_3839":78051,"_33145":77978,"_22633":128951,"_5":15597,"_29869":128774,"_3292":128952},[],"validación desde un consumidor;",{"_3839":78052,"_33145":77978,"_22633":128954,"_5":15597,"_29869":128774,"_3292":128955},[],"acción preventiva y propietario.",{"_3839":78053,"_33145":78053,"_5":15996,"_3292":128957,"_33551":128958,"_22633":128961,"_29869":78053},"Control de acceso",[54324,128959,128960],"Plataforma","Administración",[],{"_3839":78054,"_33145":78053,"_22633":128963,"_5":15597,"_29869":78053,"_3292":128964},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3839":78055,"_33145":78053,"_5":33548,"_22633":128966,"_29869":128967,"_3292":128968},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3839":78056,"_33145":78053,"_5":33548,"_22633":128970,"_29869":128971,"_3292":128972},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3839":78057,"_33145":78053,"_5":33548,"_22633":128974,"_29869":128975,"_3292":128976},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3839":78058,"_33145":78053,"_5":33548,"_22633":128978,"_29869":128979,"_3292":128980},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3839":78059,"_33145":78053,"_5":33548,"_22633":128982,"_29869":128983,"_3292":128984},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3839":78060,"_33145":78053,"_5":33548,"_22633":128986,"_29869":128987,"_3292":128988},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3839":78061,"_33145":78053,"_5":33548,"_22633":128990,"_29869":128991,"_3292":128992},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3839":78062,"_33145":78053,"_5":33548,"_22633":128994,"_29869":128995,"_3292":128996},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3839":78063,"_33145":78053,"_5":33548,"_22633":128998,"_29869":128999,"_3292":129000},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3839":78064,"_33145":78053,"_5":33548,"_22633":129002,"_29869":129003,"_3292":129004},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3839":78065,"_33145":78053,"_5":33548,"_22633":129006,"_29869":129007,"_3292":129008},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3839":78066,"_33145":78053,"_5":33548,"_22633":129010,"_29869":129011,"_3292":129012},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3839":78067,"_33145":78053,"_5":33548,"_22633":129014,"_29869":129015,"_3292":129016},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3839":78068,"_33145":78053,"_5":33548,"_22633":129018,"_29869":129019,"_3292":129020},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3839":78069,"_33145":78053,"_5":33548,"_22633":129022,"_29869":129023,"_3292":129024},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3839":78070,"_33145":78053,"_5":33548,"_22633":129026,"_29869":129027,"_3292":128134},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3839":78071,"_33145":78053,"_5":33548,"_22633":129029,"_29869":129030,"_3292":129031},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3839":78072,"_33145":78053,"_5":33548,"_22633":129033,"_29869":129034,"_3292":129035},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3839":78073,"_33145":78053,"_5":33548,"_22633":129037,"_29869":129038,"_3292":129039},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3839":78074,"_33145":78053,"_5":33548,"_22633":129041,"_29869":129042,"_3292":129043},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3839":78075,"_33145":78053,"_5":33548,"_22633":129045,"_29869":129046,"_3292":129047},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3839":78076,"_33145":78053,"_5":33548,"_22633":129049,"_29869":129050,"_3292":129051},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3839":78077,"_33145":78053,"_5":33548,"_22633":129053,"_29869":129054,"_3292":129055},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3839":78078,"_33145":78053,"_5":33548,"_22633":129057,"_29869":129058,"_3292":129059},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3839":78079,"_33145":78053,"_5":33548,"_22633":129061,"_29869":129062,"_3292":129063},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3839":78080,"_33145":78053,"_5":33548,"_22633":129065,"_29869":129066,"_3292":129067},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3839":78081,"_33145":78053,"_5":33548,"_22633":129069,"_29869":129070,"_3292":129071},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3839":78082,"_33145":78053,"_5":33548,"_22633":129073,"_29869":129074,"_3292":129075},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3839":78083,"_33145":78053,"_5":33548,"_22633":129077,"_29869":129078,"_3292":129079},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3839":78084,"_33145":78053,"_5":33548,"_22633":129081,"_29869":129082,"_3292":129083},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3839":78085,"_33145":78053,"_5":33548,"_22633":129085,"_29869":129086,"_3292":129087},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3839":78086,"_33145":78053,"_22633":129089,"_5":15597,"_29869":78053,"_3292":129090},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3839":78087,"_33145":78053,"_22633":129092,"_5":15597,"_29869":78053,"_3292":129093},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3839":78088,"_33145":78053,"_22633":129095,"_5":15597,"_29869":78053,"_3292":129096},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3839":78089,"_33145":78053,"_22633":129098,"_5":15597,"_29869":128967,"_3292":129099},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3839":78090,"_33145":78053,"_22633":129101,"_5":15597,"_29869":128967,"_3292":129102},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3839":78091,"_33145":78053,"_22633":129104,"_5":15597,"_29869":128967,"_3292":129105},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3839":78092,"_33145":78053,"_22633":129107,"_5":15597,"_29869":128967,"_3292":129108},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3839":78093,"_33145":78053,"_22633":129110,"_5":15597,"_29869":128967,"_3292":129111},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3839":78094,"_33145":78053,"_22633":129113,"_5":15597,"_29869":128967,"_3292":129114},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3839":78095,"_33145":78053,"_22633":129116,"_5":15597,"_29869":128971,"_3292":129117},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3839":78096,"_33145":78053,"_22633":129119,"_5":15597,"_29869":128971,"_3292":129120},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3839":78097,"_33145":78053,"_22633":129122,"_5":15597,"_29869":128975,"_3292":129123},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3839":78098,"_33145":78053,"_22633":129125,"_5":15597,"_29869":128975,"_3292":129126},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3839":78099,"_33145":78053,"_22633":129128,"_5":15597,"_29869":128975,"_3292":129129},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3839":78100,"_33145":78053,"_22633":129131,"_5":15597,"_29869":128975,"_3292":129132},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3839":78101,"_33145":78053,"_22633":129134,"_5":15597,"_29869":128975,"_3292":129135},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3839":78102,"_33145":78053,"_22633":129137,"_5":15597,"_29869":128975,"_3292":129138},[],"Carga por separado las políticas concedidas a cada principal.",{"_3839":78103,"_33145":78053,"_22633":129140,"_5":15597,"_29869":128975,"_3292":129141},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3839":78104,"_33145":78053,"_22633":129143,"_5":15597,"_29869":128975,"_3292":129144},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3839":78105,"_33145":78053,"_22633":129146,"_5":15597,"_29869":128975,"_3292":129147},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3839":78106,"_33145":78053,"_22633":129149,"_5":15597,"_29869":128975,"_3292":129150},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3839":78107,"_33145":78053,"_22633":129152,"_5":15597,"_29869":128975,"_3292":129153},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3839":78108,"_33145":78053,"_22633":129155,"_5":15597,"_29869":128975,"_3292":129156},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3839":78109,"_33145":78053,"_22633":129158,"_5":15597,"_29869":128979,"_3292":129159},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3839":78110,"_33145":78053,"_22633":129161,"_5":15597,"_29869":128979,"_3292":129162},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3839":78111,"_33145":78053,"_22633":129164,"_5":15597,"_29869":128979,"_3292":129165},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3839":78112,"_33145":78053,"_22633":129167,"_5":15597,"_29869":128979,"_3292":129168},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3839":78113,"_33145":78053,"_22633":129170,"_5":15597,"_29869":128979,"_3292":129171},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3839":78114,"_33145":78053,"_22633":129173,"_5":15597,"_29869":128979,"_3292":129174},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3839":78115,"_33145":78053,"_22633":129176,"_5":15597,"_29869":128979,"_3292":129177},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3839":78116,"_33145":78053,"_22633":129179,"_5":15597,"_29869":128979,"_3292":129180},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3839":78117,"_33145":78053,"_22633":129182,"_5":15597,"_29869":128983,"_3292":129183},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3839":78118,"_33145":78053,"_22633":129185,"_5":15597,"_29869":128983,"_3292":129186},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3839":78119,"_33145":78053,"_22633":129188,"_5":15597,"_29869":128983,"_3292":129189},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3839":78120,"_33145":78053,"_22633":129191,"_5":15597,"_29869":128983,"_3292":129192},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3839":78121,"_33145":78053,"_22633":129194,"_5":15597,"_29869":128983,"_3292":129195},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3839":78122,"_33145":78053,"_22633":129197,"_5":15597,"_29869":128983,"_3292":129198},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3839":78123,"_33145":78053,"_22633":129200,"_5":15597,"_29869":128983,"_3292":129201},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3839":78124,"_33145":78053,"_22633":129203,"_5":15597,"_29869":128983,"_3292":129204},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3839":78125,"_33145":78053,"_22633":129206,"_5":15597,"_29869":128983,"_3292":129207},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3839":78126,"_33145":78053,"_22633":129209,"_5":15597,"_29869":128983,"_3292":129210},[],"Las acciones se dividen en dos grupos:",{"_3839":78127,"_33145":78053,"_22633":129212,"_5":15597,"_29869":128983,"_3292":129213},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3839":78128,"_33145":78053,"_22633":129215,"_5":15597,"_29869":128983,"_3292":129216},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3839":78129,"_33145":78053,"_22633":129218,"_5":15597,"_29869":128983,"_3292":129219},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3839":78130,"_33145":78053,"_22633":129221,"_5":15597,"_29869":128987,"_3292":129222},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3839":78131,"_33145":78053,"_22633":129224,"_5":15597,"_29869":128987,"_3292":129225},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3839":78132,"_33145":78053,"_22633":129227,"_5":15597,"_29869":128987,"_3292":129228},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3839":78133,"_33145":78053,"_22633":129230,"_5":15597,"_29869":128991,"_3292":129231},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3839":78134,"_33145":78053,"_22633":129233,"_5":15597,"_29869":128991,"_3292":129234},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3839":78135,"_33145":78053,"_22633":129236,"_5":15597,"_29869":128991,"_3292":129237},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3839":78136,"_33145":78053,"_22633":129239,"_5":15597,"_29869":128991,"_3292":129240},[],"Los operadores implementados son:",{"_3839":78137,"_33145":78053,"_22633":129242,"_5":15597,"_29869":128991,"_3292":129243},[],"`equals`, para igualdad exacta;",{"_3839":78138,"_33145":78053,"_22633":129245,"_5":15597,"_29869":128991,"_3292":129246},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3839":78139,"_33145":78053,"_22633":129248,"_5":15597,"_29869":128991,"_3292":129249},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3839":78140,"_33145":78053,"_22633":129251,"_5":15597,"_29869":128991,"_3292":129252},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3839":78141,"_33145":78053,"_22633":129254,"_5":15597,"_29869":128995,"_3292":129255},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3839":78142,"_33145":78053,"_22633":129257,"_5":15597,"_29869":128995,"_3292":129258},[],"Los modos disponibles son:",{"_3839":78143,"_33145":78053,"_22633":129260,"_5":15597,"_29869":128995,"_3292":129261},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3839":78144,"_33145":78053,"_22633":129263,"_5":15597,"_29869":128995,"_3292":129264},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3839":78145,"_33145":78053,"_22633":129266,"_5":15597,"_29869":128995,"_3292":129267},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3839":78146,"_33145":78053,"_22633":129269,"_5":15597,"_29869":128995,"_3292":129270},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3839":78147,"_33145":78053,"_22633":129272,"_5":15597,"_29869":128995,"_3292":129273},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3839":78148,"_33145":78053,"_22633":129275,"_5":15597,"_29869":128995,"_3292":129276},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3839":78149,"_33145":78053,"_22633":129278,"_5":15597,"_29869":128999,"_3292":129279},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3839":78150,"_33145":78053,"_22633":129281,"_5":15597,"_29869":128999,"_3292":129282},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3839":78151,"_33145":78053,"_22633":129284,"_5":15597,"_29869":128999,"_3292":129285},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3839":78152,"_33145":78053,"_22633":129287,"_5":15597,"_29869":128999,"_3292":129288},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3839":78153,"_33145":78053,"_22633":129290,"_5":15597,"_29869":129007,"_3292":129291},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3839":78154,"_33145":78053,"_22633":129293,"_5":15597,"_29869":129007,"_3292":129294},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3839":78155,"_33145":78053,"_22633":129296,"_5":15597,"_29869":129011,"_3292":129297},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3839":78156,"_33145":78053,"_22633":129299,"_5":15597,"_29869":129011,"_3292":129300},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3839":78157,"_33145":78053,"_22633":129302,"_5":15597,"_29869":129015,"_3292":129303},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3839":78158,"_33145":78053,"_22633":129305,"_5":15597,"_29869":129015,"_3292":129306},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3839":78159,"_33145":78053,"_22633":129308,"_5":15597,"_29869":129015,"_3292":129309},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3839":78160,"_33145":78053,"_22633":129311,"_5":15597,"_29869":129019,"_3292":129312},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3839":78161,"_33145":78053,"_22633":129314,"_5":15597,"_29869":129019,"_3292":129315},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3839":78162,"_33145":78053,"_22633":129317,"_5":15597,"_29869":129019,"_3292":129318},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3839":78163,"_33145":78053,"_22633":129320,"_5":15597,"_29869":129019,"_3292":129321},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3839":78164,"_33145":78053,"_22633":129323,"_5":15597,"_29869":129019,"_3292":129324},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3839":78165,"_33145":78053,"_22633":129326,"_5":15597,"_29869":129019,"_3292":129327},[],"Ten en cuenta que:",{"_3839":78166,"_33145":78053,"_22633":129329,"_5":15597,"_29869":129019,"_3292":129330},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3839":78167,"_33145":78053,"_22633":129332,"_5":15597,"_29869":129019,"_3292":129333},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3839":78168,"_33145":78053,"_22633":129335,"_5":15597,"_29869":129019,"_3292":129336},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3839":78169,"_33145":78053,"_22633":129338,"_5":15597,"_29869":129023,"_3292":129339},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3839":78170,"_33145":78053,"_22633":129341,"_5":15597,"_29869":129023,"_3292":129342},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3839":78171,"_33145":78053,"_22633":129344,"_5":15597,"_29869":129023,"_3292":129345},[],"acceso completo y de solo lectura a KMS;",{"_3839":78172,"_33145":78053,"_22633":129347,"_5":15597,"_29869":129023,"_3292":129348},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3839":78173,"_33145":78053,"_22633":129350,"_5":15597,"_29869":129023,"_3292":129351},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3839":78174,"_33145":78053,"_22633":129353,"_5":15597,"_29869":129023,"_3292":129354},[],"acceso a la interfaz;",{"_3839":78175,"_33145":78053,"_22633":129356,"_5":15597,"_29869":129023,"_3292":129357},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3839":78176,"_33145":78053,"_22633":129359,"_5":15597,"_29869":129023,"_3292":129360},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3839":78177,"_33145":78053,"_22633":129362,"_5":15597,"_29869":129023,"_3292":129363},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3839":78178,"_33145":78053,"_22633":129365,"_5":15597,"_29869":129027,"_3292":129366},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3839":78179,"_33145":78053,"_22633":129368,"_5":15597,"_29869":129027,"_3292":129369},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3839":78180,"_33145":78053,"_22633":129371,"_5":15597,"_29869":129027,"_3292":129372},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3839":78181,"_33145":78053,"_22633":129374,"_5":15597,"_29869":129030,"_3292":129375},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3839":78182,"_33145":78053,"_22633":129377,"_5":15597,"_29869":129034,"_3292":129378},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3839":78183,"_33145":78053,"_22633":129380,"_5":15597,"_29869":129034,"_3292":129381},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3839":78184,"_33145":78053,"_22633":129383,"_5":15597,"_29869":129038,"_3292":129384},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3839":78185,"_33145":78053,"_22633":129386,"_5":15597,"_29869":129042,"_3292":129387},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3839":78186,"_33145":78053,"_22633":129389,"_5":15597,"_29869":129046,"_3292":129390},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3839":78187,"_33145":78053,"_22633":129392,"_5":15597,"_29869":129050,"_3292":129393},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3839":78188,"_33145":78053,"_22633":129395,"_5":15597,"_29869":129050,"_3292":129396},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3839":78189,"_33145":78053,"_22633":129398,"_5":15597,"_29869":129054,"_3292":129399},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3839":78190,"_33145":78053,"_22633":129401,"_5":15597,"_29869":129054,"_3292":129402},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3839":78191,"_33145":78053,"_22633":129404,"_5":15597,"_29869":129054,"_3292":129405},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3839":78192,"_33145":78053,"_22633":129407,"_5":15597,"_29869":129054,"_3292":129408},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3839":78193,"_33145":78053,"_22633":129410,"_5":15597,"_29869":129054,"_3292":129411},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3839":78194,"_33145":78053,"_22633":129413,"_5":15597,"_29869":129054,"_3292":129414},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3839":78195,"_33145":78053,"_22633":129416,"_5":15597,"_29869":129054,"_3292":129417},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3839":78196,"_33145":78053,"_22633":129419,"_5":15597,"_29869":129054,"_3292":129420},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3839":78197,"_33145":78053,"_22633":129422,"_5":15597,"_29869":129058,"_3292":129423},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3839":78198,"_33145":78053,"_22633":129425,"_5":15597,"_29869":129058,"_3292":129426},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3839":78199,"_33145":78053,"_22633":129428,"_5":15597,"_29869":129058,"_3292":129429},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3839":78200,"_33145":78053,"_22633":129431,"_5":15597,"_29869":129062,"_3292":129432},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3839":78201,"_33145":78053,"_22633":129434,"_5":15597,"_29869":129062,"_3292":129435},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3839":78202,"_33145":78053,"_22633":129437,"_5":15597,"_29869":129062,"_3292":129438},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3839":78203,"_33145":78053,"_22633":129440,"_5":15597,"_29869":129062,"_3292":129441},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3839":78204,"_33145":78053,"_22633":129443,"_5":15597,"_29869":129062,"_3292":129444},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3839":78205,"_33145":78053,"_22633":129446,"_5":15597,"_29869":129062,"_3292":129447},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3839":78206,"_33145":78053,"_22633":129449,"_5":15597,"_29869":129062,"_3292":129450},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3839":78207,"_33145":78053,"_22633":129452,"_5":15597,"_29869":129062,"_3292":129453},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3839":78208,"_33145":78053,"_22633":129455,"_5":15597,"_29869":129070,"_3292":129456},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3839":78209,"_33145":78053,"_22633":129458,"_5":15597,"_29869":129074,"_3292":129459},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3839":78210,"_33145":78053,"_22633":129461,"_5":15597,"_29869":129074,"_3292":129462},[],"que exista un principal activo del tipo correcto;",{"_3839":78211,"_33145":78053,"_22633":129464,"_5":15597,"_29869":129074,"_3292":129465},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3839":78212,"_33145":78053,"_22633":129467,"_5":15597,"_29869":129074,"_3292":129468},[],"que todas las condiciones del principal se cumplan;",{"_3839":78213,"_33145":78053,"_22633":129470,"_5":15597,"_29869":129074,"_3292":129471},[],"que el principal tenga concedida la política esperada;",{"_3839":78214,"_33145":78053,"_22633":129473,"_5":15597,"_29869":129074,"_3292":129474},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3839":78215,"_33145":78053,"_22633":129476,"_5":15597,"_29869":129074,"_3292":129477},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3839":78216,"_33145":78053,"_22633":129479,"_5":15597,"_29869":129074,"_3292":129480},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3839":78217,"_33145":78053,"_22633":129482,"_5":15597,"_29869":129078,"_3292":129483},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3839":78218,"_33145":78053,"_22633":129485,"_5":15597,"_29869":129082,"_3292":129486},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3839":78219,"_33145":78053,"_22633":129488,"_5":15597,"_29869":129086,"_3292":129489},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3839":78220,"_33145":78053,"_22633":129491,"_5":15597,"_29869":129086,"_3292":129492},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3839":78221,"_33145":78221,"_5":15996,"_3292":129494,"_33551":129495,"_22633":129496,"_29869":78221},"Alertas y suscripciones",[54324,128959,128960],[],{"_3839":78222,"_33145":78221,"_22633":129498,"_5":15597,"_29869":78221,"_3292":129499},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3839":78223,"_33145":78221,"_5":33548,"_22633":129501,"_29869":129502,"_3292":129503},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3839":78224,"_33145":78221,"_5":33548,"_22633":129505,"_29869":129506,"_3292":129507},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3839":78225,"_33145":78221,"_5":33548,"_22633":129509,"_29869":129510,"_3292":129511},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3839":78226,"_33145":78221,"_5":33548,"_22633":129513,"_29869":129514,"_3292":129515},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3839":78227,"_33145":78221,"_5":33548,"_22633":129517,"_29869":129518,"_3292":129519},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3839":78228,"_33145":78221,"_5":33548,"_22633":129521,"_29869":129522,"_3292":129523},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3839":78229,"_33145":78221,"_5":33548,"_22633":129525,"_29869":129526,"_3292":129527},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3839":78230,"_33145":78221,"_5":33548,"_22633":129529,"_29869":129530,"_3292":129531},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3839":78231,"_33145":78221,"_5":33548,"_22633":129533,"_29869":129534,"_3292":129535},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3839":78232,"_33145":78221,"_5":33548,"_22633":129537,"_29869":129538,"_3292":129539},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3839":78233,"_33145":78221,"_5":33548,"_22633":129541,"_29869":129542,"_3292":129543},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3839":78234,"_33145":78221,"_22633":129545,"_5":15597,"_29869":78221,"_3292":129546},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3839":78235,"_33145":78221,"_22633":129548,"_5":15597,"_29869":129502,"_3292":129549},[],"Un servicio publica un evento de dominio.",{"_3839":78236,"_33145":78221,"_22633":129551,"_5":15597,"_29869":129502,"_3292":129552},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3839":78237,"_33145":78221,"_22633":129554,"_5":15597,"_29869":129502,"_3292":129555},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3839":78238,"_33145":78221,"_22633":129557,"_5":15597,"_29869":129502,"_3292":129558},[],"Lamassu entrega el evento al canal configurado.",{"_3839":78239,"_33145":78221,"_22633":129560,"_5":15597,"_29869":129502,"_3292":129561},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3839":78240,"_33145":78221,"_22633":129563,"_5":15597,"_29869":129506,"_3292":129564},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3839":78241,"_33145":78221,"_22633":129566,"_5":15597,"_29869":129506,"_3292":129567},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3839":78242,"_33145":78221,"_22633":129569,"_5":15597,"_29869":129506,"_3292":129570},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3839":78243,"_33145":78221,"_22633":129572,"_5":15597,"_29869":129506,"_3292":129573},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3839":78244,"_33145":78221,"_22633":129575,"_5":15597,"_29869":129506,"_3292":129576},[],"`apikey_options` necesita `header` y `key`.",{"_3839":78245,"_33145":78221,"_22633":129578,"_5":15597,"_29869":129506,"_3292":129579},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3839":78246,"_33145":78221,"_22633":129581,"_5":15597,"_29869":129506,"_3292":129582},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3839":78247,"_33145":78221,"_22633":129584,"_5":15597,"_29869":129506,"_3292":129585},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3839":78248,"_33145":78221,"_22633":129587,"_5":15597,"_29869":129514,"_3292":129588},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3839":78249,"_33145":78221,"_22633":129590,"_5":15597,"_29869":129518,"_3292":129591},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3839":78250,"_33145":78221,"_22633":129593,"_5":15597,"_29869":129522,"_3292":129594},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3839":78251,"_33145":78221,"_22633":129596,"_5":15597,"_29869":129522,"_3292":129597},[],"**None** notifica todas las instancias del evento.",{"_3839":78252,"_33145":78221,"_22633":129599,"_5":15597,"_29869":129522,"_3292":129600},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3839":78253,"_33145":78221,"_22633":129602,"_5":15597,"_29869":129522,"_3292":129603},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3839":78254,"_33145":78221,"_22633":129605,"_5":15597,"_29869":129522,"_3292":129606},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3839":78255,"_33145":78221,"_22633":129608,"_5":15597,"_29869":129522,"_3292":129609},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3839":78256,"_33145":78221,"_22633":129611,"_5":15597,"_29869":129522,"_3292":129612},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3839":78257,"_33145":78221,"_22633":129614,"_5":15597,"_29869":129526,"_3292":129615},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3839":78258,"_33145":78221,"_22633":129617,"_5":15597,"_29869":129530,"_3292":129618},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3839":78259,"_33145":78221,"_22633":129620,"_5":15597,"_29869":129530,"_3292":129621},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3839":78260,"_33145":78221,"_22633":129623,"_5":15597,"_29869":129530,"_3292":129624},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3839":78261,"_33145":78221,"_22633":129626,"_5":15597,"_29869":129530,"_3292":129627},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3839":78262,"_33145":78221,"_22633":129629,"_5":15597,"_29869":129530,"_3292":129630},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3839":78263,"_33145":78221,"_22633":129632,"_5":15597,"_29869":129530,"_3292":129633},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3839":78264,"_33145":78221,"_22633":129635,"_5":15597,"_29869":129530,"_3292":129636},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3839":78265,"_33145":78221,"_22633":129638,"_5":15597,"_29869":129530,"_3292":129639},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3839":78266,"_33145":78221,"_22633":129641,"_5":15597,"_29869":129534,"_3292":129642},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3839":78267,"_33145":78221,"_22633":129644,"_5":15597,"_29869":129534,"_3292":129645},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3839":78268,"_33145":78221,"_22633":129647,"_5":15597,"_29869":129534,"_3292":129648},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3839":78269,"_33145":78221,"_22633":129650,"_5":15597,"_29869":129534,"_3292":129651},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3839":78270,"_33145":78221,"_22633":129653,"_5":15597,"_29869":129534,"_3292":129654},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3839":78271,"_33145":78221,"_22633":129656,"_5":15597,"_29869":129534,"_3292":129657},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3839":78272,"_33145":78221,"_22633":129659,"_5":15597,"_29869":129534,"_3292":129660},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3839":78273,"_33145":78221,"_22633":129662,"_5":15597,"_29869":129534,"_3292":129663},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3839":78274,"_33145":78221,"_22633":129665,"_5":15597,"_29869":129538,"_3292":129666},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3839":78275,"_33145":78221,"_22633":129668,"_5":15597,"_29869":129538,"_3292":129669},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3839":78276,"_33145":78221,"_22633":129671,"_5":15597,"_29869":129542,"_3292":129672},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3839":78277,"_33145":78221,"_22633":129674,"_5":15597,"_29869":129542,"_3292":129675},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3839":78278,"_33145":78221,"_22633":129677,"_5":15597,"_29869":129542,"_3292":129678},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3839":78279,"_33145":78221,"_22633":129680,"_5":15597,"_29869":129542,"_3292":129681},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3839":78280,"_33145":78221,"_22633":129683,"_5":15597,"_29869":129542,"_3292":129684},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3839":78281,"_33145":78221,"_22633":129686,"_5":15597,"_29869":129542,"_3292":129687},[],"**Validación:** `va.role.crl.create`.",{"_3839":78282,"_33145":78221,"_22633":129689,"_5":15597,"_29869":129542,"_3292":129690},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3839":78283,"_33145":78221,"_22633":129692,"_5":15597,"_29869":129542,"_3292":129693},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3839":78284,"_33145":78284,"_5":15996,"_3292":129695,"_33551":129696,"_22633":129697,"_29869":78284},"Registros de auditoría",[54324,128959,128960],[],{"_3839":78285,"_33145":78284,"_22633":129699,"_5":15597,"_29869":78284,"_3292":129700},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3839":78286,"_33145":78284,"_5":33548,"_22633":129702,"_29869":129703,"_3292":129704},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3839":78287,"_33145":78284,"_5":33548,"_22633":129706,"_29869":129707,"_3292":129708},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3839":78288,"_33145":78284,"_5":33548,"_22633":129710,"_29869":129711,"_3292":129712},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3839":78289,"_33145":78284,"_5":33548,"_22633":129714,"_29869":129715,"_3292":129716},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3839":78290,"_33145":78284,"_5":33548,"_22633":129718,"_29869":129719,"_3292":129720},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3839":78291,"_33145":78284,"_5":33548,"_22633":129722,"_29869":129723,"_3292":129724},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3839":78292,"_33145":78284,"_5":33548,"_22633":129726,"_29869":129727,"_3292":129728},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3839":78293,"_33145":78284,"_5":33548,"_22633":129730,"_29869":129731,"_3292":129732},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3839":78294,"_33145":78284,"_5":33548,"_22633":129734,"_29869":129735,"_3292":129736},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3839":78295,"_33145":78284,"_5":33548,"_22633":129738,"_29869":129739,"_3292":129740},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3839":78296,"_33145":78284,"_5":33548,"_22633":129742,"_29869":129743,"_3292":129744},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3839":78297,"_33145":78284,"_22633":129746,"_5":15597,"_29869":78284,"_3292":129747},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3839":78298,"_33145":78284,"_22633":129749,"_5":15597,"_29869":129703,"_3292":129750},[],"El cuerpo de auditoría incluye:",{"_3839":78299,"_33145":78284,"_22633":129752,"_5":15597,"_29869":129703,"_3292":129753},[],"input: datos recibidos por la operación;",{"_3839":78300,"_33145":78284,"_22633":129755,"_5":15597,"_29869":129703,"_3292":129756},[],"has\\_error: indica si el servicio devolvió un error;",{"_3839":78301,"_33145":78284,"_22633":129758,"_5":15597,"_29869":129703,"_3292":129759},[],"output: resultado producido o mensaje de error;",{"_3839":78302,"_33145":78284,"_22633":129761,"_5":15597,"_29869":129703,"_3292":129762},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3839":78303,"_33145":78284,"_22633":129764,"_5":15597,"_29869":129703,"_3292":129765},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3839":78304,"_33145":78284,"_22633":129767,"_5":15597,"_29869":129703,"_3292":129768},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3839":78305,"_33145":78284,"_22633":129770,"_5":15597,"_29869":129707,"_3292":129771},[],"El backend aplica auditoría a mutaciones de:",{"_3839":78306,"_33145":78284,"_22633":129773,"_5":15597,"_29869":129707,"_3292":129774},[],"autoridades, certificados y perfiles de emisión;",{"_3839":78307,"_33145":78284,"_22633":129776,"_5":15597,"_29869":129707,"_3292":129777},[],"claves y motores KMS;",{"_3839":78308,"_33145":78284,"_22633":129779,"_5":15597,"_29869":129707,"_3292":129780},[],"dispositivos e identidades;",{"_3839":78309,"_33145":78284,"_22633":129782,"_5":15597,"_29869":129707,"_3292":129783},[],"DMS y operaciones de enrolamiento;",{"_3839":78310,"_33145":78284,"_22633":129785,"_5":15597,"_29869":129707,"_3292":129786},[],"funciones de validación y CRL;",{"_3839":78311,"_33145":78284,"_22633":129788,"_5":15597,"_29869":129707,"_3292":129789},[],"principales, políticas y concesiones de autorización.",{"_3839":78312,"_33145":78284,"_22633":129791,"_5":15597,"_29869":129707,"_3292":129792},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3839":78313,"_33145":78284,"_22633":129794,"_5":15597,"_29869":129711,"_3292":129795},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3839":78314,"_33145":78284,"_22633":129797,"_5":15597,"_29869":129711,"_3292":129798},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3839":78315,"_33145":78284,"_22633":129800,"_5":15597,"_29869":129711,"_3292":129801},[],"Diseña el consumidor para:",{"_3839":78316,"_33145":78284,"_22633":129803,"_5":15597,"_29869":129711,"_3292":129804},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3839":78317,"_33145":78284,"_22633":129806,"_5":15597,"_29869":129711,"_3292":129807},[],"conservar el CloudEvent completo sin modificar;",{"_3839":78318,"_33145":78284,"_22633":129809,"_5":15597,"_29869":129711,"_3292":129810},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3839":78319,"_33145":78284,"_22633":129812,"_5":15597,"_29869":129711,"_3292":129813},[],"cifrar en tránsito y en reposo;",{"_3839":78320,"_33145":78284,"_22633":129815,"_5":15597,"_29869":129711,"_3292":129816},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3839":78321,"_33145":78284,"_22633":129818,"_5":15597,"_29869":129711,"_3292":129819},[],"aplicar una política explícita de retención y legal hold;",{"_3839":78322,"_33145":78284,"_22633":129821,"_5":15597,"_29869":129711,"_3292":129822},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3839":78323,"_33145":78284,"_22633":129824,"_5":15597,"_29869":129715,"_3292":129825},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3839":78324,"_33145":78284,"_22633":129827,"_5":15597,"_29869":129715,"_3292":129828},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3839":78325,"_33145":78284,"_22633":129830,"_5":15597,"_29869":129723,"_3292":129831},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3839":78326,"_33145":78284,"_22633":129833,"_5":15597,"_29869":129727,"_3292":129834},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3839":78327,"_33145":78284,"_22633":129836,"_5":15597,"_29869":129731,"_3292":129837},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3839":78328,"_33145":78284,"_22633":129839,"_5":15597,"_29869":129735,"_3292":129840},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3839":78329,"_33145":78284,"_22633":129842,"_5":15597,"_29869":129739,"_3292":129843},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3839":78330,"_33145":78284,"_22633":129845,"_5":15597,"_29869":129743,"_3292":129846},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3839":78331,"_33145":78284,"_22633":129848,"_5":15597,"_29869":129743,"_3292":129849},[],"aparece un evento de auditoría correcto;",{"_3839":78332,"_33145":78284,"_22633":129851,"_5":15597,"_29869":129743,"_3292":129852},[],"el principal coincide con la identidad utilizada;",{"_3839":78333,"_33145":78284,"_22633":129854,"_5":15597,"_29869":129743,"_3292":129855},[],"el consumidor lo persiste una sola vez;",{"_3839":78334,"_33145":78284,"_22633":129857,"_5":15597,"_29869":129743,"_3292":129858},[],"puede recuperarse por recurso, actor y periodo;",{"_3839":78335,"_33145":78284,"_22633":129860,"_5":15597,"_29869":129743,"_3292":129861},[],"una interrupción del consumidor produce una alerta.",{"_3839":78336,"_33145":78284,"_22633":129863,"_5":15597,"_29869":129743,"_3292":129864},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3839":78337,"_33145":78337,"_5":15996,"_3292":129866,"_33551":129867,"_22633":129868,"_29869":78337},"Arquitectura de la plataforma",[54324,128959],[],{"_3839":78338,"_33145":78337,"_22633":129870,"_5":15597,"_29869":78337,"_3292":129871},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3839":78339,"_33145":78337,"_5":33548,"_22633":129873,"_29869":129874,"_3292":129875},[],"/docs/pr-preview/pr-58/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3839":78340,"_33145":78337,"_5":33548,"_22633":129877,"_29869":129878,"_3292":129879},[],"/docs/pr-preview/pr-58/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3839":78341,"_33145":78337,"_5":33548,"_22633":129881,"_29869":129882,"_3292":129883},[],"/docs/pr-preview/pr-58/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3839":78342,"_33145":78337,"_5":33548,"_22633":129885,"_29869":129886,"_3292":129887},[],"/docs/pr-preview/pr-58/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3839":78343,"_33145":78337,"_5":33548,"_22633":129889,"_29869":129890,"_3292":129891},[],"/docs/pr-preview/pr-58/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3839":78344,"_33145":78337,"_22633":129893,"_5":15597,"_29869":78337,"_3292":129894},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3839":78345,"_33145":78337,"_22633":129896,"_5":15597,"_29869":78337,"_3292":129897},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3839":78346,"_33145":78337,"_22633":129899,"_5":15597,"_29869":129874,"_3292":129900},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3839":78347,"_33145":78337,"_22633":129902,"_5":15597,"_29869":129878,"_3292":129903},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3839":78348,"_33145":78337,"_22633":129905,"_5":15597,"_29869":129882,"_3292":129906},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3839":78349,"_33145":78337,"_22633":129908,"_5":15597,"_29869":129886,"_3292":129909},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3839":78350,"_33145":78337,"_22633":129911,"_5":15597,"_29869":129890,"_3292":129912},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3839":78351,"_33145":78351,"_5":15996,"_3292":129914,"_33551":129915,"_22633":129916,"_29869":78351},"Cómo funciona Lamassu",[54324,128959],[],{"_3839":78352,"_33145":78351,"_22633":129918,"_5":15597,"_29869":78351,"_3292":129919},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3839":78353,"_33145":78351,"_5":33548,"_22633":129921,"_29869":129922,"_3292":129923},[],"/docs/pr-preview/pr-58/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3839":78354,"_33145":78351,"_5":33548,"_22633":129925,"_29869":129926,"_3292":129927},[],"/docs/pr-preview/pr-58/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3839":78355,"_33145":78351,"_22633":129929,"_5":15597,"_29869":78351,"_3292":129930},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3839":78356,"_33145":78351,"_22633":129932,"_5":15597,"_29869":129922,"_3292":129933},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3839":78357,"_33145":78351,"_22633":129935,"_5":15597,"_29869":129922,"_3292":129936},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3839":78358,"_33145":78351,"_22633":129938,"_5":15597,"_29869":129922,"_3292":129939},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3839":78359,"_33145":78351,"_22633":129941,"_5":15597,"_29869":129922,"_3292":129942},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3839":78360,"_33145":78351,"_22633":129944,"_5":15597,"_29869":129922,"_3292":129945},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3839":78361,"_33145":78351,"_22633":129947,"_5":15597,"_29869":129926,"_3292":129948},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3839":78362,"_33145":78351,"_22633":129950,"_5":15597,"_29869":129926,"_3292":129951},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3839":78363,"_33145":78351,"_22633":129953,"_5":15597,"_29869":129926,"_3292":129954},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3839":78364,"_33145":78351,"_22633":129956,"_5":15597,"_29869":129926,"_3292":129957},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3839":78365,"_33145":78351,"_22633":129959,"_5":15597,"_29869":129926,"_3292":129960},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3839":78366,"_33145":78351,"_22633":129962,"_5":15597,"_29869":129926,"_3292":129963},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3839":78367,"_33145":78351,"_22633":129965,"_5":15597,"_29869":129926,"_3292":129966},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3839":78368,"_33145":78368,"_5":15996,"_3292":129968,"_33551":129969,"_22633":129970,"_29869":78368},"Dispositivos e identidades",[54324,128959,56803,129968],[],{"_3839":78369,"_33145":78368,"_22633":129972,"_5":15597,"_29869":78368,"_3292":129973},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3839":78370,"_33145":78368,"_5":33548,"_22633":129975,"_29869":129976,"_3292":129977},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3839":78371,"_33145":78368,"_5":33548,"_22633":129979,"_29869":129980,"_3292":129981},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3839":78372,"_33145":78368,"_5":33548,"_22633":129983,"_29869":129984,"_3292":129985},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3839":78373,"_33145":78368,"_5":33548,"_22633":129987,"_29869":129988,"_3292":129989},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3839":78374,"_33145":78368,"_5":33548,"_22633":129991,"_29869":129992,"_3292":129993},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3839":78375,"_33145":78368,"_5":33548,"_22633":129995,"_29869":129996,"_3292":129997},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3839":78376,"_33145":78368,"_5":33548,"_22633":129999,"_29869":130000,"_3292":130001},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3839":78377,"_33145":78368,"_5":33548,"_22633":130003,"_29869":130004,"_3292":130005},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3839":78378,"_33145":78368,"_5":33548,"_22633":130007,"_29869":130008,"_3292":130009},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3839":78379,"_33145":78368,"_5":33548,"_22633":130011,"_29869":130012,"_3292":130013},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3839":78380,"_33145":78368,"_5":33548,"_22633":130015,"_29869":130016,"_3292":130017},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3839":78381,"_33145":78368,"_22633":130019,"_5":15597,"_29869":78368,"_3292":130020},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3839":78382,"_33145":78368,"_22633":130022,"_5":15597,"_29869":78368,"_3292":130023},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3839":78383,"_33145":78368,"_22633":130025,"_5":15597,"_29869":129976,"_3292":130026},[],"Vista operativa",{"_3839":78384,"_33145":78368,"_22633":130028,"_5":15597,"_29869":129976,"_3292":130029},[],"Interpretación",{"_3839":78385,"_33145":78368,"_22633":130031,"_5":15597,"_29869":129976,"_3292":56866},[],{"_3839":78386,"_33145":78368,"_22633":130033,"_5":15597,"_29869":129976,"_3292":130034},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3839":78387,"_33145":78368,"_22633":130036,"_5":15597,"_29869":129976,"_3292":56872},[],{"_3839":78388,"_33145":78368,"_22633":130038,"_5":15597,"_29869":129976,"_3292":130039},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3839":78389,"_33145":78368,"_22633":130041,"_5":15597,"_29869":129976,"_3292":56878},[],{"_3839":78390,"_33145":78368,"_22633":130043,"_5":15597,"_29869":129976,"_3292":130044},[],"La identidad está en la ventana operativa de renovación.",{"_3839":78391,"_33145":78368,"_22633":130046,"_5":15597,"_29869":129976,"_3292":56884},[],{"_3839":78392,"_33145":78368,"_22633":130048,"_5":15597,"_29869":129976,"_3292":130049},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3839":78393,"_33145":78368,"_22633":130051,"_5":15597,"_29869":129976,"_3292":56890},[],{"_3839":78394,"_33145":78368,"_22633":130053,"_5":15597,"_29869":129976,"_3292":130054},[],"La identidad ha vencido.",{"_3839":78395,"_33145":78368,"_22633":130056,"_5":15597,"_29869":129976,"_3292":56896},[],{"_3839":78396,"_33145":78368,"_22633":130058,"_5":15597,"_29869":129976,"_3292":130059},[],"La identidad está marcada como revocada.",{"_3839":78397,"_33145":78368,"_22633":130061,"_5":15597,"_29869":129976,"_3292":56902},[],{"_3839":78398,"_33145":78368,"_22633":130063,"_5":15597,"_29869":129976,"_3292":130064},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3839":78399,"_33145":78368,"_22633":130066,"_5":15597,"_29869":129976,"_3292":130067},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3839":78400,"_33145":78368,"_22633":130069,"_5":15597,"_29869":129980,"_3292":130070},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3839":78401,"_33145":78368,"_22633":130072,"_5":15597,"_29869":129980,"_3292":130073},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3839":78402,"_33145":78368,"_22633":130075,"_5":15597,"_29869":129980,"_3292":130076},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3839":78403,"_33145":78368,"_22633":130078,"_5":15597,"_29869":129980,"_3292":130079},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3839":78404,"_33145":78368,"_22633":130081,"_5":15597,"_29869":129984,"_3292":130082},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3839":78405,"_33145":78368,"_22633":130084,"_5":15597,"_29869":129988,"_3292":130085},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3839":78406,"_33145":78368,"_22633":130087,"_5":15597,"_29869":129992,"_3292":130088},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3839":78407,"_33145":78368,"_22633":130090,"_5":15597,"_29869":129996,"_3292":130091},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3839":78408,"_33145":78368,"_22633":130093,"_5":15597,"_29869":130000,"_3292":130094},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3839":78409,"_33145":78368,"_22633":130096,"_5":15597,"_29869":130000,"_3292":130097},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3839":78410,"_33145":78368,"_22633":130099,"_5":15597,"_29869":130004,"_3292":130100},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3839":78411,"_33145":78368,"_22633":130102,"_5":15597,"_29869":130004,"_3292":130103},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3839":78412,"_33145":78368,"_22633":130105,"_5":15597,"_29869":130004,"_3292":130106},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3839":78413,"_33145":78368,"_22633":130108,"_5":15597,"_29869":130004,"_3292":130109},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3839":78414,"_33145":78368,"_22633":130111,"_5":15597,"_29869":130004,"_3292":130112},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3839":78415,"_33145":78368,"_22633":130114,"_5":15597,"_29869":130004,"_3292":130115},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3839":78416,"_33145":78368,"_22633":130117,"_5":15597,"_29869":130008,"_3292":130118},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3839":78417,"_33145":78368,"_22633":130120,"_5":15597,"_29869":130008,"_3292":130121},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3839":78418,"_33145":78368,"_22633":130123,"_5":15597,"_29869":130012,"_3292":130124},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3839":78419,"_33145":78368,"_22633":130126,"_5":15597,"_29869":130012,"_3292":130127},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3839":78420,"_33145":78368,"_22633":130129,"_5":15597,"_29869":130012,"_3292":130130},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3839":78421,"_33145":78368,"_22633":130132,"_5":15597,"_29869":130012,"_3292":130133},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3839":78422,"_33145":78368,"_22633":130135,"_5":15597,"_29869":130016,"_3292":130136},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3839":78423,"_33145":78368,"_22633":130138,"_5":15597,"_29869":130016,"_3292":130139},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3839":78424,"_33145":78424,"_5":15996,"_3292":130141,"_33551":130142,"_22633":130144,"_29869":78424},"Identidad inicial y autenticación",[54324,128959,56803,129968,130143],"Enrolamiento con PKI",[],{"_3839":78425,"_33145":78424,"_22633":130146,"_5":15597,"_29869":78424,"_3292":130147},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3839":78426,"_33145":78424,"_5":33548,"_22633":130149,"_29869":130150,"_3292":130151},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3839":78427,"_33145":78424,"_5":33548,"_22633":130153,"_29869":130154,"_3292":130155},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3839":78428,"_33145":78424,"_5":33548,"_22633":130157,"_29869":130158,"_3292":130159},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3839":78429,"_33145":78424,"_5":33548,"_22633":130161,"_29869":130162,"_3292":130163},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3839":78430,"_33145":78424,"_5":33548,"_22633":130165,"_29869":130166,"_3292":130167},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3839":78431,"_33145":78424,"_22633":130169,"_5":15597,"_29869":78424,"_3292":130170},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3839":78432,"_33145":78424,"_22633":130172,"_5":15597,"_29869":130150,"_3292":130173},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3839":78433,"_33145":78424,"_22633":130175,"_5":15597,"_29869":130150,"_3292":130176},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3839":78434,"_33145":78424,"_22633":130178,"_5":15597,"_29869":130154,"_3292":130179},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3839":78435,"_33145":78424,"_22633":130181,"_5":15597,"_29869":130154,"_3292":130182},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3839":78436,"_33145":78424,"_22633":130184,"_5":15597,"_29869":130154,"_3292":130185},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3839":78437,"_33145":78424,"_22633":130187,"_5":15597,"_29869":130158,"_3292":130188},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3839":78438,"_33145":78424,"_22633":130190,"_5":15597,"_29869":130158,"_3292":130191},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3839":78439,"_33145":78424,"_22633":130193,"_5":15597,"_29869":130162,"_3292":130194},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3839":78440,"_33145":78424,"_22633":130196,"_5":15597,"_29869":130162,"_3292":130197},[],"Ejemplo de cuerpo:",{"_3839":78441,"_33145":78424,"_22633":130199,"_5":15597,"_29869":130162,"_3292":130200},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3839":78442,"_33145":78424,"_22633":130202,"_5":15597,"_29869":130162,"_3292":130203},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3839":78443,"_33145":78424,"_22633":130205,"_5":15597,"_29869":130162,"_3292":130206},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3839":78444,"_33145":78424,"_22633":130208,"_5":15597,"_29869":130162,"_3292":130209},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3839":78445,"_33145":78424,"_22633":130211,"_5":15597,"_29869":130166,"_3292":130212},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3839":78446,"_33145":78424,"_22633":130214,"_5":15597,"_29869":130166,"_3292":130215},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3839":78447,"_33145":78447,"_5":15996,"_3292":130217,"_33551":130218,"_22633":130219,"_29869":78447},"Configura y opera el DMS",[54324,128959,56803,129968,130143],[],{"_3839":78448,"_33145":78447,"_22633":130221,"_5":15597,"_29869":78447,"_3292":130222},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3839":78449,"_33145":78447,"_5":33548,"_22633":130224,"_29869":130225,"_3292":127537},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3839":78450,"_33145":78447,"_5":33548,"_22633":130227,"_29869":130228,"_3292":130229},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3839":78451,"_33145":78447,"_5":33548,"_22633":130231,"_29869":130232,"_3292":130233},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3839":78452,"_33145":78447,"_5":33548,"_22633":130235,"_29869":130236,"_3292":130237},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3839":78453,"_33145":78447,"_5":33548,"_22633":130239,"_29869":130240,"_3292":130241},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3839":78454,"_33145":78447,"_5":33548,"_22633":130243,"_29869":130244,"_3292":130245},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3839":78455,"_33145":78447,"_5":33548,"_22633":130247,"_29869":130248,"_3292":130249},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3839":78456,"_33145":78447,"_5":33548,"_22633":130251,"_29869":130252,"_3292":130253},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3839":78457,"_33145":78447,"_5":33548,"_22633":130255,"_29869":130256,"_3292":57098},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3839":78458,"_33145":78447,"_5":33548,"_22633":130258,"_29869":130259,"_3292":57102},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3839":78459,"_33145":78447,"_5":33548,"_22633":130261,"_29869":130262,"_3292":130263},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3839":78460,"_33145":78447,"_5":33548,"_22633":130265,"_29869":130266,"_3292":130267},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3839":78461,"_33145":78447,"_5":33548,"_22633":130269,"_29869":130270,"_3292":130271},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3839":78462,"_33145":78447,"_5":33548,"_22633":130273,"_29869":130274,"_3292":130275},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3839":78463,"_33145":78447,"_5":33548,"_22633":130277,"_29869":130278,"_3292":57122},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3839":78464,"_33145":78447,"_5":33548,"_22633":130280,"_29869":130281,"_3292":130282},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3839":78465,"_33145":78447,"_5":33548,"_22633":130284,"_29869":130285,"_3292":130286},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3839":78466,"_33145":78447,"_5":33548,"_22633":130288,"_29869":130289,"_3292":130290},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3839":78467,"_33145":78447,"_22633":130292,"_5":15597,"_29869":78447,"_3292":130293},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3839":78468,"_33145":78447,"_22633":130295,"_5":15597,"_29869":130225,"_3292":130296},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3839":78469,"_33145":78447,"_22633":130298,"_5":15597,"_29869":130225,"_3292":130299},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3839":78470,"_33145":78447,"_22633":130301,"_5":15597,"_29869":130232,"_3292":130302},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3839":78471,"_33145":78447,"_22633":130304,"_5":15597,"_29869":130236,"_3292":130305},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3839":78472,"_33145":78447,"_22633":130307,"_5":15597,"_29869":130240,"_3292":130308},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3839":78473,"_33145":78447,"_22633":130310,"_5":15597,"_29869":130244,"_3292":130311},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3839":78474,"_33145":78447,"_22633":130313,"_5":15597,"_29869":130248,"_3292":130314},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3839":78475,"_33145":78447,"_22633":130316,"_5":15597,"_29869":130256,"_3292":130317},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3839":78476,"_33145":78447,"_22633":130319,"_5":15597,"_29869":130256,"_3292":130320},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3839":78477,"_33145":78447,"_22633":130322,"_5":15597,"_29869":130259,"_3292":130323},[],"Campo de `settings.enrollment_settings`",{"_3839":78478,"_33145":78447,"_22633":130325,"_5":15597,"_29869":130259,"_3292":130326},[],"Decisión",{"_3839":78479,"_33145":78447,"_22633":130328,"_5":15597,"_29869":130259,"_3292":57173},[],{"_3839":78480,"_33145":78447,"_22633":130330,"_5":15597,"_29869":130259,"_3292":130331},[],"`EST_RFC7030` para estas operaciones.",{"_3839":78481,"_33145":78447,"_22633":130333,"_5":15597,"_29869":130259,"_3292":57179},[],{"_3839":78482,"_33145":78447,"_22633":130335,"_5":15597,"_29869":130259,"_3292":130336},[],"ID de la CA que firmará.",{"_3839":78483,"_33145":78447,"_22633":130338,"_5":15597,"_29869":130259,"_3292":57185},[],{"_3839":78484,"_33145":78447,"_22633":130340,"_5":15597,"_29869":130259,"_3292":130341},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3839":78485,"_33145":78447,"_22633":130343,"_5":15597,"_29869":130259,"_3292":57191},[],{"_3839":78486,"_33145":78447,"_22633":130345,"_5":15597,"_29869":130259,"_3292":130346},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3839":78487,"_33145":78447,"_22633":130348,"_5":15597,"_29869":130259,"_3292":57197},[],{"_3839":78488,"_33145":78447,"_22633":130350,"_5":15597,"_29869":130259,"_3292":130351},[],"Uno de los cuatro modos de autenticación.",{"_3839":78489,"_33145":78447,"_22633":130353,"_5":15597,"_29869":130259,"_3292":130354},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3839":78490,"_33145":78447,"_22633":130356,"_5":15597,"_29869":130262,"_3292":130357},[],"Los bloques son independientes:",{"_3839":78491,"_33145":78447,"_22633":130359,"_5":15597,"_29869":130262,"_3292":130360},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3839":78492,"_33145":78447,"_22633":130362,"_5":15597,"_29869":130262,"_3292":130363},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3839":78493,"_33145":78447,"_22633":130365,"_5":15597,"_29869":130262,"_3292":57215},[],{"_3839":78494,"_33145":78447,"_22633":130367,"_5":15597,"_29869":130262,"_3292":130368},[],"Control aplicado en la operación configurada",{"_3839":78495,"_33145":78447,"_22633":130370,"_5":15597,"_29869":130262,"_3292":57221},[],{"_3839":78496,"_33145":78447,"_22633":130372,"_5":15597,"_29869":130262,"_3292":130373},[],"Validación del certificado presentado.",{"_3839":78497,"_33145":78447,"_22633":130375,"_5":15597,"_29869":130262,"_3292":57227},[],{"_3839":78498,"_33145":78447,"_22633":130377,"_5":15597,"_29869":130262,"_3292":130378},[],"Autorización del webhook configurado.",{"_3839":78499,"_33145":78447,"_22633":130380,"_5":15597,"_29869":130262,"_3292":57233},[],{"_3839":78500,"_33145":78447,"_22633":130382,"_5":15597,"_29869":130262,"_3292":130383},[],"Validación del certificado y, después, aprobación del webhook.",{"_3839":78501,"_33145":78447,"_22633":130385,"_5":15597,"_29869":130262,"_3292":57239},[],{"_3839":78502,"_33145":78447,"_22633":130387,"_5":15597,"_29869":130262,"_3292":130388},[],"Sin autenticación del solicitante por el DMS.",{"_3839":78503,"_33145":78447,"_22633":130390,"_5":15597,"_29869":130262,"_3292":130391},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3839":78504,"_33145":78447,"_22633":130393,"_5":15597,"_29869":130262,"_3292":130394},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3839":78505,"_33145":78447,"_22633":130396,"_5":15597,"_29869":130262,"_3292":130397},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3839":78506,"_33145":78447,"_22633":130399,"_5":15597,"_29869":130262,"_3292":130400},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3839":78507,"_33145":78447,"_22633":130402,"_5":15597,"_29869":130266,"_3292":130403},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3839":78508,"_33145":78447,"_22633":130405,"_5":15597,"_29869":130266,"_3292":130406},[],"Campo de `external_webhook_settings`",{"_3839":78509,"_33145":78447,"_22633":130408,"_5":15597,"_29869":130266,"_3292":130326},[],{"_3839":78510,"_33145":78447,"_22633":130410,"_5":15597,"_29869":130266,"_3292":57265},[],{"_3839":78511,"_33145":78447,"_22633":130412,"_5":15597,"_29869":130266,"_3292":130413},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3839":78512,"_33145":78447,"_22633":130415,"_5":15597,"_29869":130266,"_3292":57271},[],{"_3839":78513,"_33145":78447,"_22633":130417,"_5":15597,"_29869":130266,"_3292":130418},[],"`POST` o `PUT`; `POST` por defecto.",{"_3839":78514,"_33145":78447,"_22633":130420,"_5":15597,"_29869":130266,"_3292":57277},[],{"_3839":78515,"_33145":78447,"_22633":130422,"_5":15597,"_29869":130266,"_3292":130423},[],"Etiqueta usada en los logs del servicio.",{"_3839":78516,"_33145":78447,"_22633":130425,"_5":15597,"_29869":130266,"_3292":57283},[],{"_3839":78517,"_33145":78447,"_22633":130427,"_5":15597,"_29869":130266,"_3292":130428},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3839":78518,"_33145":78447,"_22633":130430,"_5":15597,"_29869":130266,"_3292":57289},[],{"_3839":78519,"_33145":78447,"_22633":130432,"_5":15597,"_29869":130266,"_3292":130433},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3839":78520,"_33145":78447,"_22633":130435,"_5":15597,"_29869":130266,"_3292":57295},[],{"_3839":78521,"_33145":78447,"_22633":130437,"_5":15597,"_29869":130266,"_3292":130438},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3839":78522,"_33145":78447,"_22633":130440,"_5":15597,"_29869":130266,"_3292":57301},[],{"_3839":78523,"_33145":78447,"_22633":130442,"_5":15597,"_29869":130266,"_3292":130443},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3839":78524,"_33145":78447,"_22633":130445,"_5":15597,"_29869":130266,"_3292":57307},[],{"_3839":78525,"_33145":78447,"_22633":130447,"_5":15597,"_29869":130266,"_3292":130448},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3839":78526,"_33145":78447,"_22633":130450,"_5":15597,"_29869":130266,"_3292":57313},[],{"_3839":78527,"_33145":78447,"_22633":130452,"_5":15597,"_29869":130266,"_3292":130453},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3839":78528,"_33145":78447,"_22633":130455,"_5":15597,"_29869":130266,"_3292":57319},[],{"_3839":78529,"_33145":78447,"_22633":130457,"_5":15597,"_29869":130266,"_3292":130458},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3839":78530,"_33145":78447,"_22633":130460,"_5":15597,"_29869":130266,"_3292":130461},[],"Reglas de esa configuración:",{"_3839":78531,"_33145":78447,"_22633":130463,"_5":15597,"_29869":130266,"_3292":130464},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3839":78532,"_33145":78447,"_22633":130466,"_5":15597,"_29869":130266,"_3292":130467},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3839":78533,"_33145":78447,"_22633":130469,"_5":15597,"_29869":130266,"_3292":130470},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3839":78534,"_33145":78447,"_22633":130472,"_5":15597,"_29869":130266,"_3292":130473},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3839":78535,"_33145":78447,"_22633":130475,"_5":15597,"_29869":130266,"_3292":130476},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3839":78536,"_33145":78447,"_22633":130478,"_5":15597,"_29869":130266,"_3292":130479},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3839":78537,"_33145":78447,"_22633":130481,"_5":15597,"_29869":130266,"_3292":130482},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3839":78538,"_33145":78447,"_22633":130484,"_5":15597,"_29869":130266,"_3292":130485},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3839":78539,"_33145":78447,"_22633":130487,"_5":15597,"_29869":130266,"_3292":130488},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3839":78540,"_33145":78447,"_22633":130490,"_5":15597,"_29869":130270,"_3292":130491},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3839":78541,"_33145":78447,"_22633":130493,"_5":15597,"_29869":130274,"_3292":130494},[],"Campo de `settings.reenrollment_settings`",{"_3839":78542,"_33145":78447,"_22633":130496,"_5":15597,"_29869":130274,"_3292":130497},[],"Función",{"_3839":78543,"_33145":78447,"_22633":130499,"_5":15597,"_29869":130274,"_3292":57363},[],{"_3839":78544,"_33145":78447,"_22633":130501,"_5":15597,"_29869":130274,"_3292":130502},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3839":78545,"_33145":78447,"_22633":130504,"_5":15597,"_29869":130274,"_3292":57369},[],{"_3839":78546,"_33145":78447,"_22633":130506,"_5":15597,"_29869":130274,"_3292":130507},[],"Umbral operativo preventivo de monitorización.",{"_3839":78547,"_33145":78447,"_22633":130509,"_5":15597,"_29869":130274,"_3292":57375},[],{"_3839":78548,"_33145":78447,"_22633":130511,"_5":15597,"_29869":130274,"_3292":130512},[],"Umbral operativo crítico de monitorización.",{"_3839":78549,"_33145":78447,"_22633":130514,"_5":15597,"_29869":130274,"_3292":57381},[],{"_3839":78550,"_33145":78447,"_22633":130516,"_5":15597,"_29869":130274,"_3292":130517},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3839":78551,"_33145":78447,"_22633":130519,"_5":15597,"_29869":130274,"_3292":57387},[],{"_3839":78552,"_33145":78447,"_22633":130521,"_5":15597,"_29869":130274,"_3292":130522},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3839":78553,"_33145":78447,"_22633":130524,"_5":15597,"_29869":130274,"_3292":57393},[],{"_3839":78554,"_33145":78447,"_22633":130526,"_5":15597,"_29869":130274,"_3292":130527},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3839":78555,"_33145":78447,"_22633":130529,"_5":15597,"_29869":130274,"_3292":130530},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3839":78556,"_33145":78447,"_22633":130532,"_5":15597,"_29869":130278,"_3292":130533},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3839":78557,"_33145":78447,"_22633":130535,"_5":15597,"_29869":130281,"_3292":127901},[],{"_3839":78558,"_33145":78447,"_22633":130537,"_5":15597,"_29869":130281,"_3292":130538},[],"Qué publica",{"_3839":78559,"_33145":78447,"_22633":130540,"_5":15597,"_29869":130281,"_3292":57410},[],{"_3839":78560,"_33145":78447,"_22633":130542,"_5":15597,"_29869":130281,"_3292":130543},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3839":78561,"_33145":78447,"_22633":130545,"_5":15597,"_29869":130281,"_3292":57416},[],{"_3839":78562,"_33145":78447,"_22633":130547,"_5":15597,"_29869":130281,"_3292":130548},[],"Certificado de la CA emisora seleccionada.",{"_3839":78563,"_33145":78447,"_22633":130550,"_5":15597,"_29869":130281,"_3292":57422},[],{"_3839":78564,"_33145":78447,"_22633":130552,"_5":15597,"_29869":130281,"_3292":130553},[],"Certificados de las CAs elegidas explícitamente.",{"_3839":78565,"_33145":78447,"_22633":130555,"_5":15597,"_29869":130281,"_3292":130556},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3839":78566,"_33145":78447,"_22633":130558,"_5":15597,"_29869":130285,"_3292":130559},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3839":78567,"_33145":78447,"_22633":130561,"_5":15597,"_29869":130285,"_3292":130562},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3839":78568,"_33145":78447,"_22633":130564,"_5":15597,"_29869":130285,"_3292":130565},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3839":78569,"_33145":78447,"_22633":130567,"_5":15597,"_29869":130289,"_3292":130568},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3839":78570,"_33145":78570,"_5":15996,"_3292":130570,"_33551":130571,"_22633":130572,"_29869":78570},"Integra el cliente EST",[54324,128959,56803,129968,130143],[],{"_3839":78571,"_33145":78570,"_22633":130574,"_5":15597,"_29869":78570,"_3292":130575},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3839":78572,"_33145":78570,"_5":33548,"_22633":130577,"_29869":130578,"_3292":127537},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3839":78573,"_33145":78570,"_5":33548,"_22633":130580,"_29869":130581,"_3292":130582},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3839":78574,"_33145":78570,"_5":33548,"_22633":130584,"_29869":130585,"_3292":130586},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3839":78575,"_33145":78570,"_5":33548,"_22633":130588,"_29869":130589,"_3292":130590},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3839":78576,"_33145":78570,"_5":33548,"_22633":130592,"_29869":130593,"_3292":130594},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3839":78577,"_33145":78570,"_5":33548,"_22633":130596,"_29869":130597,"_3292":130598},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3839":78578,"_33145":78570,"_22633":130600,"_5":15597,"_29869":78570,"_3292":130601},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3839":78579,"_33145":78570,"_22633":130603,"_5":15597,"_29869":130578,"_3292":130604},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3839":78580,"_33145":78570,"_22633":130606,"_5":15597,"_29869":130578,"_3292":130607},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3839":78581,"_33145":78570,"_22633":130609,"_5":15597,"_29869":130578,"_3292":130610},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3839":78582,"_33145":78570,"_22633":130612,"_5":15597,"_29869":130581,"_3292":130613},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3839":78583,"_33145":78570,"_22633":130615,"_5":15597,"_29869":130581,"_3292":130616},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3839":78584,"_33145":78570,"_22633":130618,"_5":15597,"_29869":130585,"_3292":130619},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3839":78585,"_33145":78570,"_22633":130621,"_5":15597,"_29869":130585,"_3292":130622},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3839":78586,"_33145":78570,"_22633":130624,"_5":15597,"_29869":130589,"_3292":130625},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3839":78587,"_33145":78570,"_22633":130627,"_5":15597,"_29869":130589,"_3292":130628},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3839":78588,"_33145":78570,"_22633":130630,"_5":15597,"_29869":130593,"_3292":130631},[],"Para el caso de una raíz que emite directamente:",{"_3839":78589,"_33145":78570,"_22633":130633,"_5":15597,"_29869":130593,"_3292":130634},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3839":78590,"_33145":78570,"_22633":130636,"_5":15597,"_29869":130593,"_3292":130637},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3839":78591,"_33145":78570,"_22633":130639,"_5":15597,"_29869":130597,"_3292":130640},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3839":78592,"_33145":78592,"_5":15996,"_3292":130642,"_33551":130643,"_22633":130644,"_29869":78592},"Referencia EST",[54324,128959,56803,129968,130143],[],{"_3839":78593,"_33145":78592,"_22633":130646,"_5":15597,"_29869":78592,"_3292":130647},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3839":78594,"_33145":78592,"_5":33548,"_22633":130649,"_29869":130650,"_3292":130651},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3839":78595,"_33145":78592,"_5":33548,"_22633":130653,"_29869":130654,"_3292":24604},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3839":78596,"_33145":78592,"_5":33548,"_22633":130656,"_29869":130657,"_3292":28246},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3839":78597,"_33145":78592,"_5":33548,"_22633":130659,"_29869":130660,"_3292":28253},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3839":78598,"_33145":78592,"_5":33548,"_22633":130662,"_29869":130663,"_3292":27493},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3839":78599,"_33145":78592,"_5":33548,"_22633":130665,"_29869":130666,"_3292":130667},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3839":78600,"_33145":78592,"_5":33548,"_22633":130669,"_29869":130670,"_3292":130671},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3839":78601,"_33145":78592,"_5":33548,"_22633":130673,"_29869":130674,"_3292":130675},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3839":78602,"_33145":78592,"_22633":130677,"_5":15597,"_29869":78592,"_3292":130678},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3839":78603,"_33145":78592,"_22633":130680,"_5":15597,"_29869":130650,"_3292":130681},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3839":78604,"_33145":78592,"_22633":130683,"_5":15597,"_29869":130650,"_3292":128719},[],{"_3839":78605,"_33145":78592,"_22633":130685,"_5":15597,"_29869":130650,"_3292":130686},[],"Método",{"_3839":78606,"_33145":78592,"_22633":130688,"_5":15597,"_29869":130650,"_3292":130689},[],"Autenticación y condición",{"_3839":78607,"_33145":78592,"_22633":130691,"_5":15597,"_29869":130650,"_3292":57565},[],{"_3839":78608,"_33145":78592,"_22633":130693,"_5":15597,"_29869":130650,"_3292":57568},[],{"_3839":78609,"_33145":78592,"_22633":130695,"_5":15597,"_29869":130650,"_3292":130696},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3839":78610,"_33145":78592,"_22633":130698,"_5":15597,"_29869":130650,"_3292":57574},[],{"_3839":78611,"_33145":78592,"_22633":130700,"_5":15597,"_29869":130650,"_3292":57577},[],{"_3839":78612,"_33145":78592,"_22633":130702,"_5":15597,"_29869":130650,"_3292":130703},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3839":78613,"_33145":78592,"_22633":130705,"_5":15597,"_29869":130650,"_3292":57583},[],{"_3839":78614,"_33145":78592,"_22633":130707,"_5":15597,"_29869":130650,"_3292":57577},[],{"_3839":78615,"_33145":78592,"_22633":130709,"_5":15597,"_29869":130650,"_3292":130710},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3839":78616,"_33145":78592,"_22633":130712,"_5":15597,"_29869":130650,"_3292":57591},[],{"_3839":78617,"_33145":78592,"_22633":130714,"_5":15597,"_29869":130650,"_3292":57577},[],{"_3839":78618,"_33145":78592,"_22633":130716,"_5":15597,"_29869":130650,"_3292":130717},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3839":78619,"_33145":78592,"_22633":130719,"_5":15597,"_29869":130650,"_3292":130720},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3839":78620,"_33145":78592,"_22633":130722,"_5":15597,"_29869":130654,"_3292":130723},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3839":78621,"_33145":78592,"_22633":130725,"_5":15597,"_29869":130654,"_3292":130726},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3839":78622,"_33145":78592,"_22633":130728,"_5":15597,"_29869":130657,"_3292":130729},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3839":78623,"_33145":78592,"_22633":130731,"_5":15597,"_29869":130657,"_3292":130732},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3839":78624,"_33145":78592,"_22633":130734,"_5":15597,"_29869":130660,"_3292":130735},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3839":78625,"_33145":78592,"_22633":130737,"_5":15597,"_29869":130660,"_3292":130738},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3839":78626,"_33145":78592,"_22633":130740,"_5":15597,"_29869":130663,"_3292":130741},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3839":78627,"_33145":78592,"_22633":130743,"_5":15597,"_29869":130663,"_3292":130744},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3839":78628,"_33145":78592,"_22633":130746,"_5":15597,"_29869":130666,"_3292":130747},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3839":78629,"_33145":78592,"_22633":130749,"_5":15597,"_29869":130666,"_3292":130750},[],"Parte",{"_3839":78630,"_33145":78592,"_22633":130752,"_5":15597,"_29869":130666,"_3292":130753},[],"Contenido tras decodificar su Base64",{"_3839":78631,"_33145":78592,"_22633":130755,"_5":15597,"_29869":130666,"_3292":57635},[],{"_3839":78632,"_33145":78592,"_22633":130757,"_5":15597,"_29869":130666,"_3292":130758},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3839":78633,"_33145":78592,"_22633":130760,"_5":15597,"_29869":130666,"_3292":57641},[],{"_3839":78634,"_33145":78592,"_22633":130762,"_5":15597,"_29869":130666,"_3292":130763},[],"PKCS#7 DER con el certificado emitido.",{"_3839":78635,"_33145":78592,"_22633":130765,"_5":15597,"_29869":130666,"_3292":130766},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3839":78636,"_33145":78592,"_22633":130768,"_5":15597,"_29869":130670,"_3292":130769},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3839":78637,"_33145":78592,"_22633":130771,"_5":15597,"_29869":130670,"_3292":130772},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3839":78638,"_33145":78592,"_22633":130774,"_5":15597,"_29869":130670,"_3292":130775},[],"Convierte y comprueba el resultado:",{"_3839":78639,"_33145":78592,"_22633":130777,"_5":15597,"_29869":130670,"_3292":130778},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3839":78640,"_33145":78592,"_22633":130780,"_5":15597,"_29869":130674,"_3292":130781},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3839":78641,"_33145":78592,"_22633":130783,"_5":15597,"_29869":130674,"_3292":130784},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3839":78642,"_33145":78642,"_5":15996,"_3292":130143,"_33551":130786,"_22633":130787,"_29869":78642},[54324,128959,56803,129968,130143],[],{"_3839":78643,"_33145":78642,"_22633":130789,"_5":15597,"_29869":78642,"_3292":130790},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3839":78644,"_33145":78642,"_5":33548,"_22633":130792,"_29869":130793,"_3292":130794},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3839":78645,"_33145":78642,"_5":33548,"_22633":130796,"_29869":130797,"_3292":130798},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3839":78646,"_33145":78642,"_5":33548,"_22633":130800,"_29869":130801,"_3292":130802},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3839":78647,"_33145":78642,"_5":33548,"_22633":130804,"_29869":130805,"_3292":130806},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3839":78648,"_33145":78642,"_22633":130808,"_5":15597,"_29869":78642,"_3292":130809},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3839":78649,"_33145":78642,"_22633":130811,"_5":15597,"_29869":130793,"_3292":130812},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3839":78650,"_33145":78642,"_22633":130814,"_5":15597,"_29869":130793,"_3292":130815},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3839":78651,"_33145":78642,"_22633":130817,"_5":15597,"_29869":130793,"_3292":130818},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3839":78652,"_33145":78642,"_22633":130820,"_5":15597,"_29869":130793,"_3292":130821},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3839":78653,"_33145":78642,"_22633":130823,"_5":15597,"_29869":130793,"_3292":130824},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3839":78654,"_33145":78642,"_22633":130826,"_5":15597,"_29869":130793,"_3292":130827},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3839":78655,"_33145":78642,"_22633":130829,"_5":15597,"_29869":130797,"_3292":130830},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3839":78656,"_33145":78642,"_22633":130832,"_5":15597,"_29869":130797,"_3292":130833},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3839":78657,"_33145":78642,"_22633":130835,"_5":15597,"_29869":130797,"_3292":130836},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3839":78658,"_33145":78642,"_22633":130838,"_5":15597,"_29869":130797,"_3292":130839},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3839":78659,"_33145":78642,"_22633":130841,"_5":15597,"_29869":130801,"_3292":130842},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3839":78660,"_33145":78642,"_22633":130844,"_5":15597,"_29869":130801,"_3292":130845},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3839":78661,"_33145":78642,"_22633":130847,"_5":15597,"_29869":130801,"_3292":130848},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3839":78662,"_33145":78642,"_22633":130850,"_5":15597,"_29869":130801,"_3292":130851},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3839":78663,"_33145":78642,"_22633":130853,"_5":15597,"_29869":130805,"_3292":130854},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3839":78664,"_33145":78642,"_22633":130856,"_5":15597,"_29869":130805,"_3292":130857},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3839":78665,"_33145":78665,"_5":15996,"_3292":130859,"_33551":130860,"_22633":130861,"_29869":78665},"Estrategias de aprovisionamiento",[54324,128959,56803,129968,130143],[],{"_3839":78666,"_33145":78665,"_22633":130863,"_5":15597,"_29869":78665,"_3292":130864},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3839":78667,"_33145":78665,"_5":33548,"_22633":130866,"_29869":130867,"_3292":130868},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3839":78668,"_33145":78665,"_5":33548,"_22633":130870,"_29869":130871,"_3292":130872},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3839":78669,"_33145":78665,"_5":33548,"_22633":130874,"_29869":130875,"_3292":130876},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3839":78670,"_33145":78665,"_5":33548,"_22633":130878,"_29869":130879,"_3292":130880},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3839":78671,"_33145":78665,"_5":33548,"_22633":130882,"_29869":130883,"_3292":130884},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3839":78672,"_33145":78665,"_22633":130886,"_5":15597,"_29869":78665,"_3292":130887},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3839":78673,"_33145":78665,"_22633":130889,"_5":15597,"_29869":130867,"_3292":130890},[],"Recorrido",{"_3839":78674,"_33145":78665,"_22633":130892,"_5":15597,"_29869":130867,"_3292":130893},[],"Cuándo existe el dispositivo",{"_3839":78675,"_33145":78665,"_22633":130895,"_5":15597,"_29869":130867,"_3292":130896},[],"Qué compruebas",{"_3839":78676,"_33145":78665,"_22633":130898,"_5":15597,"_29869":130867,"_3292":130899},[],"Asignación manual",{"_3839":78677,"_33145":78665,"_22633":130901,"_5":15597,"_29869":130867,"_3292":130902},[],"El operador lo crea antes de asociar un certificado.",{"_3839":78678,"_33145":78665,"_22633":130904,"_5":15597,"_29869":130867,"_3292":130905},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3839":78679,"_33145":78665,"_22633":130907,"_5":15597,"_29869":130867,"_3292":130908},[],"EST con `JITP`",{"_3839":78680,"_33145":78665,"_22633":130910,"_5":15597,"_29869":130867,"_3292":130911},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3839":78681,"_33145":78665,"_22633":130913,"_5":15597,"_29869":130867,"_3292":130914},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3839":78682,"_33145":78665,"_22633":130916,"_5":15597,"_29869":130867,"_3292":130917},[],"EST con `PRE_REGISTRATION`",{"_3839":78683,"_33145":78665,"_22633":130919,"_5":15597,"_29869":130867,"_3292":130920},[],"Debe existir antes de `/simpleenroll`.",{"_3839":78684,"_33145":78665,"_22633":130922,"_5":15597,"_29869":130867,"_3292":130923},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3839":78685,"_33145":78665,"_22633":130925,"_5":15597,"_29869":130867,"_3292":130926},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3839":78686,"_33145":78665,"_22633":130928,"_5":15597,"_29869":130867,"_3292":130929},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3839":78687,"_33145":78665,"_22633":130931,"_5":15597,"_29869":130871,"_3292":130932},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3839":78688,"_33145":78665,"_22633":130934,"_5":15597,"_29869":130871,"_3292":130935},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3839":78689,"_33145":78665,"_22633":130937,"_5":15597,"_29869":130871,"_3292":130938},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3839":78690,"_33145":78665,"_22633":130940,"_5":15597,"_29869":130875,"_3292":130941},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3839":78691,"_33145":78665,"_22633":130943,"_5":15597,"_29869":130875,"_3292":130944},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3839":78692,"_33145":78665,"_22633":130946,"_5":15597,"_29869":130875,"_3292":130947},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3839":78693,"_33145":78665,"_22633":130949,"_5":15597,"_29869":130875,"_3292":130950},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3839":78694,"_33145":78665,"_22633":130952,"_5":15597,"_29869":130875,"_3292":130953},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3839":78695,"_33145":78665,"_22633":130955,"_5":15597,"_29869":130875,"_3292":130956},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3839":78696,"_33145":78665,"_22633":130958,"_5":15597,"_29869":130879,"_3292":127901},[],{"_3839":78697,"_33145":78665,"_22633":130960,"_5":15597,"_29869":130879,"_3292":130961},[],"Material que atraviesa EST",{"_3839":78698,"_33145":78665,"_22633":130963,"_5":15597,"_29869":130879,"_3292":130964},[],"Clave generada por el dispositivo",{"_3839":78699,"_33145":78665,"_22633":130966,"_5":15597,"_29869":130879,"_3292":130967},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3839":78700,"_33145":78665,"_22633":130969,"_5":15597,"_29869":130879,"_3292":130970},[],"Clave ya disponible en el dispositivo",{"_3839":78701,"_33145":78665,"_22633":130972,"_5":15597,"_29869":130879,"_3292":130973},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3839":78702,"_33145":78665,"_22633":130975,"_5":15597,"_29869":130879,"_3292":57122},[],{"_3839":78703,"_33145":78665,"_22633":130977,"_5":15597,"_29869":130879,"_3292":130978},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3839":78704,"_33145":78665,"_22633":130980,"_5":15597,"_29869":130879,"_3292":130981},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3839":78705,"_33145":78665,"_22633":130983,"_5":15597,"_29869":130883,"_3292":130984},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3839":78706,"_33145":78706,"_5":15996,"_3292":130986,"_33551":130987,"_22633":130988,"_29869":78706},"Renovación y recuperación",[54324,128959,56803,129968,130143],[],{"_3839":78707,"_33145":78706,"_22633":130990,"_5":15597,"_29869":78706,"_3292":130991},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3839":78708,"_33145":78706,"_5":33548,"_22633":130993,"_29869":130994,"_3292":130995},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3839":78709,"_33145":78706,"_5":33548,"_22633":130997,"_29869":130998,"_3292":130999},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3839":78710,"_33145":78706,"_5":33548,"_22633":131001,"_29869":131002,"_3292":131003},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3839":78711,"_33145":78706,"_5":33548,"_22633":131005,"_29869":131006,"_3292":131007},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3839":78712,"_33145":78706,"_5":33548,"_22633":131009,"_29869":131010,"_3292":131011},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3839":78713,"_33145":78706,"_22633":131013,"_5":15597,"_29869":78706,"_3292":131014},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3839":78714,"_33145":78706,"_22633":131016,"_5":15597,"_29869":130994,"_3292":131017},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3839":78715,"_33145":78706,"_22633":131019,"_5":15597,"_29869":130994,"_3292":131020},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3839":78716,"_33145":78706,"_22633":131022,"_5":15597,"_29869":130994,"_3292":131023},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3839":78717,"_33145":78706,"_22633":131025,"_5":15597,"_29869":130994,"_3292":131026},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3839":78718,"_33145":78706,"_22633":131028,"_5":15597,"_29869":130998,"_3292":131029},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3839":78719,"_33145":78706,"_22633":131031,"_5":15597,"_29869":130998,"_3292":131032},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3839":78720,"_33145":78706,"_22633":131034,"_5":15597,"_29869":131002,"_3292":131035},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3839":78721,"_33145":78706,"_22633":131037,"_5":15597,"_29869":131002,"_3292":131038},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3839":78722,"_33145":78706,"_22633":131040,"_5":15597,"_29869":131002,"_3292":131041},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3839":78723,"_33145":78706,"_22633":131043,"_5":15597,"_29869":131006,"_3292":131044},[],"Situación",{"_3839":78724,"_33145":78706,"_22633":131046,"_5":15597,"_29869":131006,"_3292":131047},[],"Procedimiento",{"_3839":78725,"_33145":78706,"_22633":131049,"_5":15597,"_29869":131006,"_3292":131050},[],"Certificado vigente, fuera de ventana",{"_3839":78726,"_33145":78706,"_22633":131052,"_5":15597,"_29869":131006,"_3292":131053},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3839":78727,"_33145":78706,"_22633":131055,"_5":15597,"_29869":131006,"_3292":131056},[],"Certificado vencido, clave disponible",{"_3839":78728,"_33145":78706,"_22633":131058,"_5":15597,"_29869":131006,"_3292":131059},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3839":78729,"_33145":78706,"_22633":131061,"_5":15597,"_29869":131006,"_3292":131062},[],"Renovación por webhook o `NO_AUTH`",{"_3839":78730,"_33145":78706,"_22633":131064,"_5":15597,"_29869":131006,"_3292":131065},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3839":78731,"_33145":78706,"_22633":131067,"_5":15597,"_29869":131006,"_3292":131068},[],"Clave perdida o inaccesible",{"_3839":78732,"_33145":78706,"_22633":131070,"_5":15597,"_29869":131006,"_3292":131071},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3839":78733,"_33145":78706,"_22633":131073,"_5":15597,"_29869":131006,"_3292":131074},[],"Identidad actual revocada",{"_3839":78734,"_33145":78706,"_22633":131076,"_5":15597,"_29869":131006,"_3292":131077},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3839":78735,"_33145":78706,"_22633":131079,"_5":15597,"_29869":131006,"_3292":131080},[],"Dispositivo sin identidad",{"_3839":78736,"_33145":78706,"_22633":131082,"_5":15597,"_29869":131006,"_3292":131083},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3839":78737,"_33145":78706,"_22633":131085,"_5":15597,"_29869":131006,"_3292":131086},[],"Dispositivo retirado",{"_3839":78738,"_33145":78706,"_22633":131088,"_5":15597,"_29869":131006,"_3292":131089},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3839":78739,"_33145":78706,"_22633":131091,"_5":15597,"_29869":131006,"_3292":131092},[],"Timeout, HTTP 500 o fallo de instalación",{"_3839":78740,"_33145":78706,"_22633":131094,"_5":15597,"_29869":131006,"_3292":131095},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3839":78741,"_33145":78706,"_22633":131097,"_5":15597,"_29869":131010,"_3292":131098},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3839":78742,"_33145":78706,"_22633":131100,"_5":15597,"_29869":131010,"_3292":131101},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3839":78743,"_33145":78743,"_5":15996,"_3292":131103,"_33551":131104,"_22633":131105,"_29869":78743},"Diagnóstico de enrolamiento",[54324,128959,56803,129968,130143],[],{"_3839":78744,"_33145":78743,"_22633":131107,"_5":15597,"_29869":78743,"_3292":131108},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3839":78745,"_33145":78743,"_5":33548,"_22633":131110,"_29869":131111,"_3292":131112},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3839":78746,"_33145":78743,"_5":33548,"_22633":131114,"_29869":131115,"_3292":131116},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3839":78747,"_33145":78743,"_5":33548,"_22633":131118,"_29869":131119,"_3292":130675},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3839":78748,"_33145":78743,"_5":33548,"_22633":131121,"_29869":131122,"_3292":131123},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3839":78749,"_33145":78743,"_22633":131125,"_5":15597,"_29869":78743,"_3292":131126},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3839":78750,"_33145":78743,"_22633":131128,"_5":15597,"_29869":131115,"_3292":131129},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3839":78751,"_33145":78743,"_22633":131131,"_5":15597,"_29869":131115,"_3292":131132},[],"Síntoma o mensaje",{"_3839":78752,"_33145":78743,"_22633":131134,"_5":15597,"_29869":131115,"_3292":131135},[],"Qué revisar",{"_3839":78753,"_33145":78743,"_22633":131137,"_5":15597,"_29869":131115,"_3292":131138},[],"curl rechaza TLS, nombre o emisor",{"_3839":78754,"_33145":78743,"_22633":131140,"_5":15597,"_29869":131115,"_3292":131141},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3839":78755,"_33145":78743,"_22633":131143,"_5":15597,"_29869":131115,"_3292":131144},[],"404 o APS ausente",{"_3839":78756,"_33145":78743,"_22633":131146,"_5":15597,"_29869":131115,"_3292":131147},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3839":78757,"_33145":78743,"_22633":131149,"_5":15597,"_29869":131115,"_3292":131150},[],"400, error de CSR o formato",{"_3839":78758,"_33145":78743,"_22633":131152,"_5":15597,"_29869":131115,"_3292":131153},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3839":78759,"_33145":78743,"_22633":131155,"_5":15597,"_29869":131115,"_3292":131156},[],"Credencial ausente o certificado no válido",{"_3839":78760,"_33145":78743,"_22633":131158,"_5":15597,"_29869":131115,"_3292":131159},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3839":78761,"_33145":78743,"_22633":131161,"_5":15597,"_29869":131115,"_3292":131162},[],"Webhook deniega, expira o responde sin autorización",{"_3839":78762,"_33145":78743,"_22633":131164,"_5":15597,"_29869":131115,"_3292":131165},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3839":78763,"_33145":78743,"_22633":131167,"_5":15597,"_29869":131115,"_3292":58048},[],{"_3839":78764,"_33145":78743,"_22633":131169,"_5":15597,"_29869":131115,"_3292":131170},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3839":78765,"_33145":78743,"_22633":131172,"_5":15597,"_29869":131115,"_3292":58054},[],{"_3839":78766,"_33145":78743,"_22633":131174,"_5":15597,"_29869":131115,"_3292":131175},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3839":78767,"_33145":78743,"_22633":131177,"_5":15597,"_29869":131115,"_3292":58060},[],{"_3839":78768,"_33145":78743,"_22633":131179,"_5":15597,"_29869":131115,"_3292":131180},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3839":78769,"_33145":78743,"_22633":131182,"_5":15597,"_29869":131115,"_3292":58066},[],{"_3839":78770,"_33145":78743,"_22633":131184,"_5":15597,"_29869":131115,"_3292":131185},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3839":78771,"_33145":78743,"_22633":131187,"_5":15597,"_29869":131115,"_3292":58072},[],{"_3839":78772,"_33145":78743,"_22633":131189,"_5":15597,"_29869":131115,"_3292":131190},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3839":78773,"_33145":78743,"_22633":131192,"_5":15597,"_29869":131115,"_3292":131193},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3839":78774,"_33145":78743,"_22633":131195,"_5":15597,"_29869":131115,"_3292":131196},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3839":78775,"_33145":78743,"_22633":131198,"_5":15597,"_29869":131115,"_3292":131199},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3839":78776,"_33145":78743,"_22633":131201,"_5":15597,"_29869":131115,"_3292":131202},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3839":78777,"_33145":78743,"_22633":131204,"_5":15597,"_29869":131115,"_3292":58090},[],{"_3839":78778,"_33145":78743,"_22633":131206,"_5":15597,"_29869":131115,"_3292":131207},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3839":78779,"_33145":78743,"_22633":131209,"_5":15597,"_29869":131115,"_3292":58096},[],{"_3839":78780,"_33145":78743,"_22633":131211,"_5":15597,"_29869":131115,"_3292":131212},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3839":78781,"_33145":78743,"_22633":131214,"_5":15597,"_29869":131115,"_3292":131215},[],"DMS propietario distinto",{"_3839":78782,"_33145":78743,"_22633":131217,"_5":15597,"_29869":131115,"_3292":131218},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3839":78783,"_33145":78743,"_22633":131220,"_5":15597,"_29869":131115,"_3292":58108},[],{"_3839":78784,"_33145":78743,"_22633":131222,"_5":15597,"_29869":131115,"_3292":131223},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3839":78785,"_33145":78743,"_22633":131225,"_5":15597,"_29869":131115,"_3292":58114},[],{"_3839":78786,"_33145":78743,"_22633":131227,"_5":15597,"_29869":131115,"_3292":131228},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3839":78787,"_33145":78743,"_22633":131230,"_5":15597,"_29869":131115,"_3292":131231},[],"Certificado actual revocado",{"_3839":78788,"_33145":78743,"_22633":131233,"_5":15597,"_29869":131115,"_3292":131234},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3839":78789,"_33145":78743,"_22633":131236,"_5":15597,"_29869":131115,"_3292":131237},[],"Error de CA, perfil o firma",{"_3839":78790,"_33145":78743,"_22633":131239,"_5":15597,"_29869":131115,"_3292":131240},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3839":78791,"_33145":78743,"_22633":131242,"_5":15597,"_29869":131115,"_3292":131243},[],"HTTP 200 sin conexión del dispositivo",{"_3839":78792,"_33145":78743,"_22633":131245,"_5":15597,"_29869":131115,"_3292":131246},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3839":78793,"_33145":78743,"_22633":131248,"_5":15597,"_29869":131115,"_3292":131249},[],"Timeout o error después de emitir",{"_3839":78794,"_33145":78743,"_22633":131251,"_5":15597,"_29869":131115,"_3292":131252},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3839":78795,"_33145":78743,"_22633":131254,"_5":15597,"_29869":131119,"_3292":131255},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3839":78796,"_33145":78743,"_22633":131257,"_5":15597,"_29869":131119,"_3292":131258},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3839":78797,"_33145":78743,"_22633":131260,"_5":15597,"_29869":131122,"_3292":131261},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3839":78798,"_33145":78743,"_22633":131263,"_5":15597,"_29869":131122,"_3292":131264},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3839":78799,"_33145":78743,"_22633":131266,"_5":15597,"_29869":131122,"_3292":131267},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3839":78800,"_33145":78743,"_22633":131269,"_5":15597,"_29869":131122,"_3292":131270},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3839":78801,"_33145":78743,"_22633":131272,"_5":15597,"_29869":131122,"_3292":131273},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3839":78802,"_33145":78743,"_22633":131275,"_5":15597,"_29869":131122,"_3292":131276},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3839":78803,"_33145":78743,"_22633":131278,"_5":15597,"_29869":131122,"_3292":131279},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3839":78804,"_33145":78804,"_5":15996,"_3292":131281,"_33551":131282,"_22633":131283,"_29869":78804},"Distribución y actualización de confianza",[54324,128959,56803,129968,130143],[],{"_3839":78805,"_33145":78804,"_22633":131285,"_5":15597,"_29869":78804,"_3292":131286},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3839":78806,"_33145":78804,"_5":33548,"_22633":131288,"_29869":131289,"_3292":131290},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3839":78807,"_33145":78804,"_5":33548,"_22633":131292,"_29869":131293,"_3292":131294},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3839":78808,"_33145":78804,"_5":33548,"_22633":131296,"_29869":131297,"_3292":131298},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3839":78809,"_33145":78804,"_5":33548,"_22633":131300,"_29869":131301,"_3292":131302},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3839":78810,"_33145":78804,"_5":33548,"_22633":131304,"_29869":131305,"_3292":131306},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3839":78811,"_33145":78804,"_22633":131308,"_5":15597,"_29869":78804,"_3292":131309},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3839":78812,"_33145":78804,"_22633":131311,"_5":15597,"_29869":131289,"_3292":131312},[],"Relación",{"_3839":78813,"_33145":78804,"_22633":131314,"_5":15597,"_29869":131289,"_3292":131315},[],"Material que prepara el responsable",{"_3839":78814,"_33145":78804,"_22633":131317,"_5":15597,"_29869":131289,"_3292":131318},[],"Dispositivo → servidor EST",{"_3839":78815,"_33145":78804,"_22633":131320,"_5":15597,"_29869":131289,"_3292":131321},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3839":78816,"_33145":78804,"_22633":131323,"_5":15597,"_29869":131289,"_3292":131324},[],"DMS → solicitante",{"_3839":78817,"_33145":78804,"_22633":131326,"_5":15597,"_29869":131289,"_3292":131327},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3839":78818,"_33145":78804,"_22633":131329,"_5":15597,"_29869":131289,"_3292":131330},[],"Consumidor → dispositivo",{"_3839":78819,"_33145":78804,"_22633":131332,"_5":15597,"_29869":131289,"_3292":131333},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3839":78820,"_33145":78804,"_22633":131335,"_5":15597,"_29869":131289,"_3292":131336},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3839":78821,"_33145":78804,"_22633":131338,"_5":15597,"_29869":131293,"_3292":131339},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3839":78822,"_33145":78804,"_22633":131341,"_5":15597,"_29869":131293,"_3292":131342},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3839":78823,"_33145":78804,"_22633":131344,"_5":15597,"_29869":131297,"_3292":131345},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3839":78824,"_33145":78804,"_22633":131347,"_5":15597,"_29869":131297,"_3292":131348},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3839":78825,"_33145":78804,"_22633":131350,"_5":15597,"_29869":131297,"_3292":131351},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3839":78826,"_33145":78804,"_22633":131353,"_5":15597,"_29869":131297,"_3292":131354},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3839":78827,"_33145":78804,"_22633":131356,"_5":15597,"_29869":131297,"_3292":131357},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3839":78828,"_33145":78804,"_22633":131359,"_5":15597,"_29869":131297,"_3292":131360},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3839":78829,"_33145":78804,"_22633":131362,"_5":15597,"_29869":131301,"_3292":131363},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3839":78830,"_33145":78804,"_22633":131365,"_5":15597,"_29869":131301,"_3292":131366},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3839":78831,"_33145":78804,"_22633":131368,"_5":15597,"_29869":131301,"_3292":131369},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3839":78832,"_33145":78804,"_22633":131371,"_5":15597,"_29869":131305,"_3292":131372},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3839":78833,"_33145":78833,"_5":15996,"_3292":58263,"_33551":131374,"_22633":131376,"_29869":78833},[54324,128959,56803,129968,131375],"Integraciones",[],{"_3839":78834,"_33145":78833,"_22633":131378,"_5":15597,"_29869":78833,"_3292":131379},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3839":78835,"_33145":78833,"_5":33548,"_22633":131381,"_29869":131382,"_3292":131383},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3839":78836,"_33145":78833,"_5":33548,"_22633":131385,"_29869":131386,"_3292":131387},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3839":78837,"_33145":78833,"_5":33548,"_22633":131389,"_29869":131390,"_3292":131391},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3839":78838,"_33145":78833,"_5":33548,"_22633":131393,"_29869":131394,"_3292":131395},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3839":78839,"_33145":78833,"_5":33548,"_22633":131397,"_29869":131398,"_3292":131399},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3839":78840,"_33145":78833,"_5":33548,"_22633":131401,"_29869":131402,"_3292":131403},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3839":78841,"_33145":78833,"_5":33548,"_22633":131405,"_29869":131406,"_3292":131407},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3839":78842,"_33145":78833,"_5":33548,"_22633":131409,"_29869":131410,"_3292":131411},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3839":78843,"_33145":78833,"_5":33548,"_22633":131413,"_29869":131414,"_3292":58305},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3839":78844,"_33145":78833,"_5":33548,"_22633":131416,"_29869":131417,"_3292":58309},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3839":78845,"_33145":78833,"_5":33548,"_22633":131419,"_29869":131420,"_3292":131421},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3839":78846,"_33145":78833,"_5":33548,"_22633":131423,"_29869":131424,"_3292":131425},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3839":78847,"_33145":78833,"_5":33548,"_22633":131427,"_29869":131428,"_3292":131429},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3839":78848,"_33145":78833,"_5":33548,"_22633":131431,"_29869":131432,"_3292":131433},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3839":78849,"_33145":78833,"_5":33548,"_22633":131435,"_29869":131436,"_3292":131437},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3839":78850,"_33145":78833,"_5":33548,"_22633":131439,"_29869":131440,"_3292":131441},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3839":78851,"_33145":78833,"_5":33548,"_22633":131443,"_29869":131444,"_3292":131445},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3839":78852,"_33145":78833,"_5":33548,"_22633":131447,"_29869":131448,"_3292":131449},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3839":78853,"_33145":78833,"_5":33548,"_22633":131451,"_29869":131452,"_3292":131453},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3839":78854,"_33145":78833,"_5":33548,"_22633":131455,"_29869":131456,"_3292":131457},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3839":78855,"_33145":78833,"_5":33548,"_22633":131459,"_29869":131460,"_3292":131461},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3839":78856,"_33145":78833,"_5":33548,"_22633":131463,"_29869":131464,"_3292":131465},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3839":78857,"_33145":78833,"_5":33548,"_22633":131467,"_29869":131468,"_3292":131469},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3839":78858,"_33145":78833,"_5":33548,"_22633":131471,"_29869":131472,"_3292":131473},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3839":78859,"_33145":78833,"_5":33548,"_22633":131475,"_29869":131476,"_3292":131477},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3839":78860,"_33145":78833,"_22633":131479,"_5":15597,"_29869":78833,"_3292":131480},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3839":78861,"_33145":78833,"_22633":131482,"_5":15597,"_29869":78833,"_3292":131483},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3839":78862,"_33145":78833,"_22633":131485,"_5":15597,"_29869":78833,"_3292":131486},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3839":78863,"_33145":78833,"_22633":131488,"_5":15597,"_29869":131382,"_3292":131489},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3839":78864,"_33145":78833,"_22633":131491,"_5":15597,"_29869":131382,"_3292":131492},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3839":78865,"_33145":78833,"_22633":131494,"_5":15597,"_29869":131382,"_3292":131495},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3839":78866,"_33145":78833,"_22633":131497,"_5":15597,"_29869":131382,"_3292":131498},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3839":78867,"_33145":78833,"_22633":131500,"_5":15597,"_29869":131386,"_3292":131501},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3839":78868,"_33145":78833,"_22633":131503,"_5":15597,"_29869":131390,"_3292":131504},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3839":78869,"_33145":78833,"_22633":131506,"_5":15597,"_29869":131390,"_3292":131507},[],"Acción IAM",{"_3839":78870,"_33145":78833,"_22633":131509,"_5":15597,"_29869":131390,"_3292":127907},[],{"_3839":78871,"_33145":78833,"_22633":131511,"_5":15597,"_29869":131390,"_3292":58404},[],{"_3839":78872,"_33145":78833,"_22633":131513,"_5":15597,"_29869":131390,"_3292":131514},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3839":78873,"_33145":78833,"_22633":131516,"_5":15597,"_29869":131390,"_3292":58410},[],{"_3839":78874,"_33145":78833,"_22633":131518,"_5":15597,"_29869":131390,"_3292":131519},[],"Registrar la CA en AWS IoT",{"_3839":78875,"_33145":78833,"_22633":131521,"_5":15597,"_29869":131390,"_3292":58416},[],{"_3839":78876,"_33145":78833,"_22633":131523,"_5":15597,"_29869":131390,"_3292":131524},[],"Consultar el estado del registro de la CA",{"_3839":78877,"_33145":78833,"_22633":131526,"_5":15597,"_29869":131390,"_3292":58422},[],{"_3839":78878,"_33145":78833,"_22633":131528,"_5":15597,"_29869":131390,"_3292":131529},[],"Crear o actualizar Things en IoT Core",{"_3839":78879,"_33145":78833,"_22633":131531,"_5":15597,"_29869":131390,"_3292":58428},[],{"_3839":78880,"_33145":78833,"_22633":131533,"_5":15597,"_29869":131390,"_3292":131534},[],"Aprovisionar Things mediante plantilla",{"_3839":78881,"_33145":78833,"_22633":131536,"_5":15597,"_29869":131390,"_3292":58434},[],{"_3839":78882,"_33145":78833,"_22633":131538,"_5":15597,"_29869":131390,"_3292":131539},[],"Registrar certificados de dispositivo",{"_3839":78883,"_33145":78833,"_22633":131541,"_5":15597,"_29869":131390,"_3292":58440},[],{"_3839":78884,"_33145":78833,"_22633":131543,"_5":15597,"_29869":131390,"_3292":131544},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3839":78885,"_33145":78833,"_22633":131546,"_5":15597,"_29869":131390,"_3292":58446},[],{"_3839":78886,"_33145":78833,"_22633":131548,"_5":15597,"_29869":131390,"_3292":131549},[],"Crear y adjuntar políticas IoT",{"_3839":78887,"_33145":78833,"_22633":131551,"_5":15597,"_29869":131390,"_3292":58452},[],{"_3839":78888,"_33145":78833,"_22633":131553,"_5":15597,"_29869":131390,"_3292":131554},[],"Gestionar grupos de Things",{"_3839":78889,"_33145":78833,"_22633":131556,"_5":15597,"_29869":131390,"_3292":58458},[],{"_3839":78890,"_33145":78833,"_22633":131558,"_5":15597,"_29869":131390,"_3292":131559},[],"Crear plantillas JITP",{"_3839":78891,"_33145":78833,"_22633":131561,"_5":15597,"_29869":131390,"_3292":58464},[],{"_3839":78892,"_33145":78833,"_22633":131563,"_5":15597,"_29869":131390,"_3292":131564},[],"Leer y escribir el Device Shadow",{"_3839":78893,"_33145":78833,"_22633":131566,"_5":15597,"_29869":131390,"_3292":131567},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3839":78894,"_33145":78833,"_22633":131569,"_5":15597,"_29869":131394,"_3292":131570},[],"Parámetro",{"_3839":78895,"_33145":78833,"_22633":131572,"_5":15597,"_29869":131394,"_3292":131573},[],"Tipo",{"_3839":78896,"_33145":78833,"_22633":131575,"_5":15597,"_29869":131394,"_3292":131576},[],"Requerido",{"_3839":78897,"_33145":78833,"_22633":131578,"_5":15597,"_29869":131394,"_3292":131579},[],"Descripción",{"_3839":78898,"_33145":78833,"_22633":131581,"_5":15597,"_29869":131394,"_3292":58485},[],{"_3839":78899,"_33145":78833,"_22633":131583,"_5":15597,"_29869":131394,"_3292":27097},[],{"_3839":78900,"_33145":78833,"_22633":131585,"_5":15597,"_29869":131394,"_3292":131586},[],"Sí",{"_3839":78901,"_33145":78833,"_22633":131588,"_5":15597,"_29869":131394,"_3292":131589},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3839":78902,"_33145":78833,"_22633":131591,"_5":15597,"_29869":131394,"_3292":58496},[],{"_3839":78903,"_33145":78833,"_22633":131593,"_5":15597,"_29869":131394,"_3292":27097},[],{"_3839":78904,"_33145":78833,"_22633":131595,"_5":15597,"_29869":131394,"_3292":131586},[],{"_3839":78905,"_33145":78833,"_22633":131597,"_5":15597,"_29869":131394,"_3292":131598},[],"Región AWS donde opera el conector.",{"_3839":78906,"_33145":78833,"_22633":131600,"_5":15597,"_29869":131394,"_3292":58506},[],{"_3839":78907,"_33145":78833,"_22633":131602,"_5":15597,"_29869":131394,"_3292":27097},[],{"_3839":78908,"_33145":78833,"_22633":131604,"_5":15597,"_29869":131394,"_3292":131586},[],{"_3839":78909,"_33145":78833,"_22633":131606,"_5":15597,"_29869":131394,"_3292":131607},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3839":78910,"_33145":78833,"_22633":131609,"_5":15597,"_29869":131394,"_3292":58516},[],{"_3839":78911,"_33145":78833,"_22633":131611,"_5":15597,"_29869":131394,"_3292":27097},[],{"_3839":78912,"_33145":78833,"_22633":131613,"_5":15597,"_29869":131394,"_3292":131614},[],"Solo con `auth_method=static`",{"_3839":78913,"_33145":78833,"_22633":131616,"_5":15597,"_29869":131394,"_3292":131617},[],"Clave de acceso AWS.",{"_3839":78914,"_33145":78833,"_22633":131619,"_5":15597,"_29869":131394,"_3292":58527},[],{"_3839":78915,"_33145":78833,"_22633":131621,"_5":15597,"_29869":131394,"_3292":27097},[],{"_3839":78916,"_33145":78833,"_22633":131623,"_5":15597,"_29869":131394,"_3292":131614},[],{"_3839":78917,"_33145":78833,"_22633":131625,"_5":15597,"_29869":131394,"_3292":131626},[],"Clave secreta AWS.",{"_3839":78918,"_33145":78833,"_22633":131628,"_5":15597,"_29869":131394,"_3292":58537},[],{"_3839":78919,"_33145":78833,"_22633":131630,"_5":15597,"_29869":131394,"_3292":27097},[],{"_3839":78920,"_33145":78833,"_22633":131632,"_5":15597,"_29869":131394,"_3292":58542},[],{"_3839":78921,"_33145":78833,"_22633":131634,"_5":15597,"_29869":131394,"_3292":131635},[],"Token de sesión (con `auth_method=static`).",{"_3839":78922,"_33145":78833,"_22633":131637,"_5":15597,"_29869":131394,"_3292":58548},[],{"_3839":78923,"_33145":78833,"_22633":131639,"_5":15597,"_29869":131394,"_3292":27097},[],{"_3839":78924,"_33145":78833,"_22633":131641,"_5":15597,"_29869":131394,"_3292":131642},[],"Solo con `auth_method=role`",{"_3839":78925,"_33145":78833,"_22633":131644,"_5":15597,"_29869":131394,"_3292":131645},[],"ARN del rol a asumir.",{"_3839":78926,"_33145":78833,"_22633":131647,"_5":15597,"_29869":131394,"_3292":58559},[],{"_3839":78927,"_33145":78833,"_22633":131649,"_5":15597,"_29869":131394,"_3292":27097},[],{"_3839":78928,"_33145":78833,"_22633":131651,"_5":15597,"_29869":131394,"_3292":58542},[],{"_3839":78929,"_33145":78833,"_22633":131653,"_5":15597,"_29869":131394,"_3292":131654},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3839":78930,"_33145":78833,"_22633":131656,"_5":15597,"_29869":131394,"_3292":58569},[],{"_3839":78931,"_33145":78833,"_22633":131658,"_5":15597,"_29869":131394,"_3292":98327},[],{"_3839":78932,"_33145":78833,"_22633":131660,"_5":15597,"_29869":131394,"_3292":131586},[],{"_3839":78933,"_33145":78833,"_22633":131662,"_5":15597,"_29869":131394,"_3292":131663},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3839":78934,"_33145":78833,"_22633":131665,"_5":15597,"_29869":131394,"_3292":58579},[],{"_3839":78935,"_33145":78833,"_22633":131667,"_5":15597,"_29869":131394,"_3292":27097},[],{"_3839":78936,"_33145":78833,"_22633":131669,"_5":15597,"_29869":131394,"_3292":131586},[],{"_3839":78937,"_33145":78833,"_22633":131671,"_5":15597,"_29869":131394,"_3292":131672},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3839":78938,"_33145":78833,"_22633":131674,"_5":15597,"_29869":131394,"_3292":58589},[],{"_3839":78939,"_33145":78833,"_22633":131676,"_5":15597,"_29869":131394,"_3292":27097},[],{"_3839":78940,"_33145":78833,"_22633":131678,"_5":15597,"_29869":131394,"_3292":131586},[],{"_3839":78941,"_33145":78833,"_22633":131680,"_5":15597,"_29869":131394,"_3292":131681},[],"URL HTTP del Device Manager de Lamassu.",{"_3839":78942,"_33145":78833,"_22633":131683,"_5":15597,"_29869":131394,"_3292":58599},[],{"_3839":78943,"_33145":78833,"_22633":131685,"_5":15597,"_29869":131394,"_3292":27097},[],{"_3839":78944,"_33145":78833,"_22633":131687,"_5":15597,"_29869":131394,"_3292":131586},[],{"_3839":78945,"_33145":78833,"_22633":131689,"_5":15597,"_29869":131394,"_3292":131690},[],"URL HTTP del servicio de CA de Lamassu.",{"_3839":78946,"_33145":78833,"_22633":131692,"_5":15597,"_29869":131398,"_3292":131693},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3839":78947,"_33145":78833,"_22633":131695,"_5":15597,"_29869":131398,"_3292":131696},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3839":78948,"_33145":78833,"_22633":131698,"_5":15597,"_29869":131398,"_3292":131699},[],"Tipo de CloudEvent",{"_3839":78949,"_33145":78833,"_22633":131701,"_5":15597,"_29869":131398,"_3292":131702},[],"Recurso en Lamassu",{"_3839":78950,"_33145":78833,"_22633":131704,"_5":15597,"_29869":131398,"_3292":131705},[],"Recurso AWS",{"_3839":78951,"_33145":78833,"_22633":131707,"_5":15597,"_29869":131398,"_3292":131708},[],"Acciones IAM",{"_3839":78952,"_33145":78833,"_22633":131710,"_5":15597,"_29869":131398,"_3292":131711},[],"Llamadas AWS y efecto",{"_3839":78953,"_33145":78833,"_22633":131713,"_5":15597,"_29869":131398,"_3292":131714},[],"Dónde en esta página",{"_3839":78954,"_33145":78833,"_22633":131716,"_5":15597,"_29869":131398,"_3292":58633},[],{"_3839":78955,"_33145":78833,"_22633":131718,"_5":15597,"_29869":131398,"_3292":58636},[],{"_3839":78956,"_33145":78833,"_22633":131720,"_5":15597,"_29869":131398,"_3292":58639},[],{"_3839":78957,"_33145":78833,"_22633":131722,"_5":15597,"_29869":131398,"_3292":58642},[],{"_3839":78958,"_33145":78833,"_22633":131724,"_5":15597,"_29869":131398,"_3292":131725},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3839":78959,"_33145":78833,"_22633":131727,"_5":15597,"_29869":131398,"_3292":131411},[],{"_3839":78960,"_33145":78833,"_22633":131729,"_5":15597,"_29869":131398,"_3292":58650},[],{"_3839":78961,"_33145":78833,"_22633":131731,"_5":15597,"_29869":131398,"_3292":58653},[],{"_3839":78962,"_33145":78833,"_22633":131733,"_5":15597,"_29869":131398,"_3292":58656},[],{"_3839":78963,"_33145":78833,"_22633":131735,"_5":15597,"_29869":131398,"_3292":58659},[],{"_3839":78964,"_33145":78833,"_22633":131737,"_5":15597,"_29869":131398,"_3292":131738},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3839":78965,"_33145":78833,"_22633":131740,"_5":15597,"_29869":131398,"_3292":131437},[],{"_3839":78966,"_33145":78833,"_22633":131742,"_5":15597,"_29869":131398,"_3292":58667},[],{"_3839":78967,"_33145":78833,"_22633":131744,"_5":15597,"_29869":131398,"_3292":131745},[],"Dispositivo",{"_3839":78968,"_33145":78833,"_22633":131747,"_5":15597,"_29869":131398,"_3292":58673},[],{"_3839":78969,"_33145":78833,"_22633":131749,"_5":15597,"_29869":131398,"_3292":58676},[],{"_3839":78970,"_33145":78833,"_22633":131751,"_5":15597,"_29869":131398,"_3292":131752},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3839":78971,"_33145":78833,"_22633":131754,"_5":15597,"_29869":131398,"_3292":131445},[],{"_3839":78972,"_33145":78833,"_22633":131756,"_5":15597,"_29869":131398,"_3292":58684},[],{"_3839":78973,"_33145":78833,"_22633":131758,"_5":15597,"_29869":131398,"_3292":131759},[],"Certificado",{"_3839":78974,"_33145":78833,"_22633":131761,"_5":15597,"_29869":131398,"_3292":58690},[],{"_3839":78975,"_33145":78833,"_22633":131763,"_5":15597,"_29869":131398,"_3292":131764},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3839":78976,"_33145":78833,"_22633":131766,"_5":15597,"_29869":131398,"_3292":131767},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3839":78977,"_33145":78833,"_22633":131769,"_5":15597,"_29869":131398,"_3292":131457},[],{"_3839":78978,"_33145":78833,"_22633":131771,"_5":15597,"_29869":131398,"_3292":58701},[],{"_3839":78979,"_33145":78833,"_22633":131773,"_5":15597,"_29869":131398,"_3292":131774},[],"Certificado / Dispositivo",{"_3839":78980,"_33145":78833,"_22633":131776,"_5":15597,"_29869":131398,"_3292":58707},[],{"_3839":78981,"_33145":78833,"_22633":131778,"_5":15597,"_29869":131398,"_3292":54720},[],{"_3839":78982,"_33145":78833,"_22633":131780,"_5":15597,"_29869":131398,"_3292":131781},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3839":78983,"_33145":78833,"_22633":131783,"_5":15597,"_29869":131398,"_3292":131465},[],{"_3839":78984,"_33145":78833,"_22633":131785,"_5":15597,"_29869":131402,"_3292":131786},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3839":78985,"_33145":78833,"_22633":131788,"_5":15597,"_29869":131406,"_3292":131789},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3839":78986,"_33145":78833,"_22633":131791,"_5":15597,"_29869":131406,"_3292":131792},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3839":78987,"_33145":78833,"_22633":131794,"_5":15597,"_29869":131410,"_3292":131795},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3839":78988,"_33145":78833,"_22633":131797,"_5":15597,"_29869":131410,"_3292":131798},[],"Transición",{"_3839":78989,"_33145":78833,"_22633":131800,"_5":15597,"_29869":131410,"_3292":131801},[],"Llamadas AWS",{"_3839":78990,"_33145":78833,"_22633":131803,"_5":15597,"_29869":131410,"_3292":131804},[],"`NoRegistrada` → `Solicitada`",{"_3839":78991,"_33145":78833,"_22633":131806,"_5":15597,"_29869":131410,"_3292":131807},[],"ninguna (solo escritura de metadatos)",{"_3839":78992,"_33145":78833,"_22633":131809,"_5":15597,"_29869":131410,"_3292":131810},[],"`Solicitada` → `Registrando`",{"_3839":78993,"_33145":78833,"_22633":131812,"_5":15597,"_29869":131410,"_3292":131813},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3839":78994,"_33145":78833,"_22633":131815,"_5":15597,"_29869":131410,"_3292":131816},[],"`Registrando` → `Completada`",{"_3839":78995,"_33145":78833,"_22633":131818,"_5":15597,"_29869":131410,"_3292":131819},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3839":78996,"_33145":78833,"_22633":131821,"_5":15597,"_29869":131410,"_3292":131822},[],"`Registrando` → `Fallida`",{"_3839":78997,"_33145":78833,"_22633":131824,"_5":15597,"_29869":131410,"_3292":131825},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3839":78998,"_33145":78833,"_22633":131827,"_5":15597,"_29869":131410,"_3292":131828},[],"`Fallida` / `Completada` → `Solicitada`",{"_3839":78999,"_33145":78833,"_22633":131830,"_5":15597,"_29869":131410,"_3292":131831},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3839":79000,"_33145":78833,"_22633":131833,"_5":15597,"_29869":131414,"_3292":131834},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3839":79001,"_33145":78833,"_22633":131836,"_5":15597,"_29869":131414,"_3292":131837},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3839":79002,"_33145":78833,"_22633":131839,"_5":15597,"_29869":131414,"_3292":131840},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3839":79003,"_33145":78833,"_22633":131842,"_5":15597,"_29869":131414,"_3292":131843},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3839":79004,"_33145":78833,"_22633":131845,"_5":15597,"_29869":131414,"_3292":131846},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3839":79005,"_33145":78833,"_22633":131848,"_5":15597,"_29869":131414,"_3292":131849},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3839":79006,"_33145":78833,"_22633":131851,"_5":15597,"_29869":131417,"_3292":131852},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3839":79007,"_33145":78833,"_22633":131854,"_5":15597,"_29869":131420,"_3292":131855},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3839":79008,"_33145":78833,"_22633":131857,"_5":15597,"_29869":131420,"_3292":131858},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3839":79009,"_33145":78833,"_22633":131860,"_5":15597,"_29869":131424,"_3292":131861},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3839":79010,"_33145":78833,"_22633":131863,"_5":15597,"_29869":131428,"_3292":131864},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3839":79011,"_33145":78833,"_22633":131866,"_5":15597,"_29869":131428,"_3292":131867},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3839":79012,"_33145":78833,"_22633":131869,"_5":15597,"_29869":131428,"_3292":131870},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3839":79013,"_33145":78833,"_22633":131872,"_5":15597,"_29869":131428,"_3292":131873},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3839":79014,"_33145":78833,"_22633":131875,"_5":15597,"_29869":131428,"_3292":131876},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3839":79015,"_33145":78833,"_22633":131878,"_5":15597,"_29869":131428,"_3292":131879},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3839":79016,"_33145":78833,"_22633":131881,"_5":15597,"_29869":131432,"_3292":131882},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3839":79017,"_33145":78833,"_22633":131884,"_5":15597,"_29869":131432,"_3292":131885},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3839":79018,"_33145":78833,"_22633":131887,"_5":15597,"_29869":131432,"_3292":131888},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3839":79019,"_33145":78833,"_22633":131890,"_5":15597,"_29869":131432,"_3292":131891},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3839":79020,"_33145":78833,"_22633":131893,"_5":15597,"_29869":131432,"_3292":131894},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3839":79021,"_33145":78833,"_22633":131896,"_5":15597,"_29869":131436,"_3292":131897},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3839":79022,"_33145":78833,"_22633":131899,"_5":15597,"_29869":131436,"_3292":131798},[],{"_3839":79023,"_33145":78833,"_22633":131901,"_5":15597,"_29869":131436,"_3292":131801},[],{"_3839":79024,"_33145":78833,"_22633":131903,"_5":15597,"_29869":131436,"_3292":131904},[],"`SinConfigurar` → `None` / `Auto`",{"_3839":79025,"_33145":78833,"_22633":131906,"_5":15597,"_29869":131436,"_3292":131907},[],"ninguna (solo configuración)",{"_3839":79026,"_33145":78833,"_22633":131909,"_5":15597,"_29869":131436,"_3292":58844},[],{"_3839":79027,"_33145":78833,"_22633":131911,"_5":15597,"_29869":131436,"_3292":131907},[],{"_3839":79028,"_33145":78833,"_22633":131913,"_5":15597,"_29869":131436,"_3292":131914},[],"Cualquiera → `Jitp`",{"_3839":79029,"_33145":78833,"_22633":131916,"_5":15597,"_29869":131436,"_3292":131917},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3839":79030,"_33145":78833,"_22633":131919,"_5":15597,"_29869":131436,"_3292":58855},[],{"_3839":79031,"_33145":78833,"_22633":131921,"_5":15597,"_29869":131436,"_3292":131922},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3839":79032,"_33145":78833,"_22633":131924,"_5":15597,"_29869":131440,"_3292":131925},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3839":79033,"_33145":78833,"_22633":131927,"_5":15597,"_29869":131440,"_3292":131928},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3839":79034,"_33145":78833,"_22633":131930,"_5":15597,"_29869":131440,"_3292":131931},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3839":79035,"_33145":78833,"_22633":131933,"_5":15597,"_29869":131444,"_3292":131934},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3839":79036,"_33145":78833,"_22633":131936,"_5":15597,"_29869":131444,"_3292":131798},[],{"_3839":79037,"_33145":78833,"_22633":131938,"_5":15597,"_29869":131444,"_3292":131801},[],{"_3839":79038,"_33145":78833,"_22633":131940,"_5":15597,"_29869":131444,"_3292":131941},[],"`Ausente` → `Aprovisionado`",{"_3839":79039,"_33145":78833,"_22633":131943,"_5":15597,"_29869":131444,"_3292":131944},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3839":79040,"_33145":78833,"_22633":131946,"_5":15597,"_29869":131444,"_3292":131947},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3839":79041,"_33145":78833,"_22633":131949,"_5":15597,"_29869":131444,"_3292":131950},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3839":79042,"_33145":78833,"_22633":131952,"_5":15597,"_29869":131444,"_3292":131953},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3839":79043,"_33145":78833,"_22633":131955,"_5":15597,"_29869":131448,"_3292":131956},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3839":79044,"_33145":78833,"_22633":131958,"_5":15597,"_29869":131448,"_3292":131959},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3839":79045,"_33145":78833,"_22633":131961,"_5":15597,"_29869":131448,"_3292":131962},[],"Para que el flujo JITP funcione correctamente:",{"_3839":79046,"_33145":78833,"_22633":131964,"_5":15597,"_29869":131448,"_3292":131965},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3839":79047,"_33145":78833,"_22633":131967,"_5":15597,"_29869":131448,"_3292":131968},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3839":79048,"_33145":78833,"_22633":131970,"_5":15597,"_29869":131448,"_3292":131971},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3839":79049,"_33145":78833,"_22633":131973,"_5":15597,"_29869":131448,"_3292":131974},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3839":79050,"_33145":78833,"_22633":131976,"_5":15597,"_29869":131452,"_3292":131977},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3839":79051,"_33145":78833,"_22633":131979,"_5":15597,"_29869":131452,"_3292":131980},[],"Estado en Lamassu",{"_3839":79052,"_33145":78833,"_22633":131982,"_5":15597,"_29869":131452,"_3292":131983},[],"Razón de revocación",{"_3839":79053,"_33145":78833,"_22633":131985,"_5":15597,"_29869":131452,"_3292":131986},[],"Estado en AWS IoT Core",{"_3839":79054,"_33145":78833,"_22633":131988,"_5":15597,"_29869":131452,"_3292":58925},[],{"_3839":79055,"_33145":78833,"_22633":131990,"_5":15597,"_29869":131452,"_3292":131991},[],"Ninguna",{"_3839":79056,"_33145":78833,"_22633":131993,"_5":15597,"_29869":131452,"_3292":58931},[],{"_3839":79057,"_33145":78833,"_22633":131995,"_5":15597,"_29869":131452,"_3292":58934},[],{"_3839":79058,"_33145":78833,"_22633":131997,"_5":15597,"_29869":131452,"_3292":58937},[],{"_3839":79059,"_33145":78833,"_22633":131999,"_5":15597,"_29869":131452,"_3292":58940},[],{"_3839":79060,"_33145":78833,"_22633":132001,"_5":15597,"_29869":131452,"_3292":58934},[],{"_3839":79061,"_33145":78833,"_22633":132003,"_5":15597,"_29869":131452,"_3292":132004},[],"Cualquier otra razón",{"_3839":79062,"_33145":78833,"_22633":132006,"_5":15597,"_29869":131452,"_3292":58948},[],{"_3839":79063,"_33145":78833,"_22633":132008,"_5":15597,"_29869":131452,"_3292":132009},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3839":79064,"_33145":78833,"_22633":132011,"_5":15597,"_29869":131456,"_3292":132012},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3839":79065,"_33145":78833,"_22633":132014,"_5":15597,"_29869":131456,"_3292":131798},[],{"_3839":79066,"_33145":78833,"_22633":132016,"_5":15597,"_29869":131456,"_3292":131801},[],{"_3839":79067,"_33145":78833,"_22633":132018,"_5":15597,"_29869":131456,"_3292":132019},[],"`NoSincronizado` → `Active`",{"_3839":79068,"_33145":78833,"_22633":132021,"_5":15597,"_29869":131456,"_3292":58440},[],{"_3839":79069,"_33145":78833,"_22633":132023,"_5":15597,"_29869":131456,"_3292":58966},[],{"_3839":79070,"_33145":78833,"_22633":132025,"_5":15597,"_29869":131456,"_3292":132026},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3839":79071,"_33145":78833,"_22633":132028,"_5":15597,"_29869":131456,"_3292":58972},[],{"_3839":79072,"_33145":78833,"_22633":132030,"_5":15597,"_29869":131456,"_3292":132026},[],{"_3839":79073,"_33145":78833,"_22633":132032,"_5":15597,"_29869":131456,"_3292":58977},[],{"_3839":79074,"_33145":78833,"_22633":132034,"_5":15597,"_29869":131456,"_3292":58440},[],{"_3839":79075,"_33145":78833,"_22633":132036,"_5":15597,"_29869":131456,"_3292":58982},[],{"_3839":79076,"_33145":78833,"_22633":132038,"_5":15597,"_29869":131456,"_3292":132039},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3839":79077,"_33145":78833,"_22633":132041,"_5":15597,"_29869":131460,"_3292":132042},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3839":79078,"_33145":78833,"_22633":132044,"_5":15597,"_29869":131460,"_3292":132045},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3839":79079,"_33145":78833,"_22633":132047,"_5":15597,"_29869":131460,"_3292":132048},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3839":79080,"_33145":78833,"_22633":132050,"_5":15597,"_29869":131464,"_3292":132051},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3839":79081,"_33145":78833,"_22633":132053,"_5":15597,"_29869":131464,"_3292":132054},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3839":79082,"_33145":78833,"_22633":132056,"_5":15597,"_29869":131468,"_3292":132057},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3839":79083,"_33145":78833,"_22633":132059,"_5":15597,"_29869":131468,"_3292":132060},[],"Existen dos tipos de acciones:",{"_3839":79084,"_33145":78833,"_22633":132062,"_5":15597,"_29869":131468,"_3292":132063},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3839":79085,"_33145":78833,"_22633":132065,"_5":15597,"_29869":131468,"_3292":132066},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3839":79086,"_33145":78833,"_22633":132068,"_5":15597,"_29869":131468,"_3292":132069},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3839":79087,"_33145":78833,"_22633":132071,"_5":15597,"_29869":131472,"_3292":132072},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3839":79088,"_33145":78833,"_22633":132074,"_5":15597,"_29869":131472,"_3292":132075},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3839":79089,"_33145":78833,"_22633":132077,"_5":15597,"_29869":131472,"_3292":132078},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3839":79090,"_33145":78833,"_22633":132080,"_5":15597,"_29869":131476,"_3292":132081},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3839":79091,"_33145":78833,"_22633":132083,"_5":15597,"_29869":131476,"_3292":132084},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3839":79092,"_33145":78833,"_22633":132086,"_5":15597,"_29869":131476,"_3292":132087},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3839":79093,"_33145":78833,"_22633":132089,"_5":15597,"_29869":131476,"_3292":132090},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3839":79094,"_33145":78833,"_22633":132092,"_5":15597,"_29869":131476,"_3292":132093},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3839":79095,"_33145":78833,"_22633":132095,"_5":15597,"_29869":131476,"_3292":132096},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3839":79096,"_33145":78833,"_22633":132098,"_5":15597,"_29869":131476,"_3292":132099},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3839":79097,"_33145":78833,"_22633":132101,"_5":15597,"_29869":131476,"_3292":132102},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3839":79098,"_33145":78833,"_22633":132104,"_5":15597,"_29869":131476,"_3292":132105},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3839":79099,"_33145":78833,"_22633":132107,"_5":15597,"_29869":131476,"_3292":132108},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3839":79100,"_33145":78833,"_22633":132110,"_5":15597,"_29869":131476,"_3292":132111},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3839":79101,"_33145":78833,"_22633":132113,"_5":15597,"_29869":131476,"_3292":132114},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3839":79102,"_33145":78833,"_22633":132116,"_5":15597,"_29869":131476,"_3292":132117},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3839":79103,"_33145":78833,"_22633":132119,"_5":15597,"_29869":131476,"_3292":132120},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3839":79104,"_33145":78833,"_22633":132122,"_5":15597,"_29869":131476,"_3292":132123},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3839":79105,"_33145":78833,"_22633":132125,"_5":15597,"_29869":131476,"_3292":132126},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3839":79106,"_33145":78833,"_22633":132128,"_5":15597,"_29869":131476,"_3292":132129},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3839":79107,"_33145":78833,"_22633":132131,"_5":15597,"_29869":131476,"_3292":132132},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3839":79108,"_33145":78833,"_22633":132134,"_5":15597,"_29869":131476,"_3292":132135},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3839":79109,"_33145":78833,"_22633":132137,"_5":15597,"_29869":131476,"_3292":132138},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3839":79110,"_33145":78833,"_22633":132140,"_5":15597,"_29869":131476,"_3292":132141},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3839":79111,"_33145":78833,"_22633":132143,"_5":15597,"_29869":131476,"_3292":132144},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3839":79112,"_33145":78833,"_22633":132146,"_5":15597,"_29869":131476,"_3292":132147},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3839":79113,"_33145":78833,"_22633":132149,"_5":15597,"_29869":131476,"_3292":132150},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3839":79114,"_33145":79114,"_5":15996,"_3292":56803,"_33551":132152,"_22633":132153,"_29869":79114},[54324,128959,56803],[],{"_3839":79115,"_33145":79114,"_22633":132155,"_5":15597,"_29869":79114,"_3292":132156},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3839":79116,"_33145":79114,"_5":33548,"_22633":132158,"_29869":132159,"_3292":132160},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3839":79117,"_33145":79114,"_5":33548,"_22633":132162,"_29869":132163,"_3292":129968},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3839":79118,"_33145":79114,"_5":33548,"_22633":132165,"_29869":132166,"_3292":130143},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3839":79119,"_33145":79114,"_5":33548,"_22633":132168,"_29869":132169,"_3292":131375},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/overview#integraciones",{"_3839":79120,"_33145":79114,"_5":33548,"_22633":132171,"_29869":132172,"_3292":132173},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3839":79121,"_33145":79114,"_22633":132175,"_5":15597,"_29869":79114,"_3292":132176},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3839":79122,"_33145":79114,"_22633":132178,"_5":15597,"_29869":132159,"_3292":132179},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3839":79123,"_33145":79114,"_22633":132181,"_5":15597,"_29869":132159,"_3292":132182},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3839":79124,"_33145":79114,"_22633":132184,"_5":15597,"_29869":132163,"_3292":132185},[],"Recurso",{"_3839":79125,"_33145":79114,"_22633":132187,"_5":15597,"_29869":132163,"_3292":132188},[],"Qué representa",{"_3839":79126,"_33145":79114,"_22633":132190,"_5":15597,"_29869":132163,"_3292":132191},[],"**Dispositivo**",{"_3839":79127,"_33145":79114,"_22633":132193,"_5":15597,"_29869":132163,"_3292":132194},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3839":79128,"_33145":79114,"_22633":132196,"_5":15597,"_29869":132163,"_3292":132197},[],"**Identidad**",{"_3839":79129,"_33145":79114,"_22633":132199,"_5":15597,"_29869":132163,"_3292":132200},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3839":79130,"_33145":79114,"_22633":132202,"_5":15597,"_29869":132163,"_3292":59149},[],{"_3839":79131,"_33145":79114,"_22633":132204,"_5":15597,"_29869":132163,"_3292":132205},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3839":79132,"_33145":79114,"_22633":132207,"_5":15597,"_29869":132163,"_3292":132208},[],"**Flota**",{"_3839":79133,"_33145":79114,"_22633":132210,"_5":15597,"_29869":132163,"_3292":132211},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3839":79134,"_33145":79114,"_22633":132213,"_5":15597,"_29869":132163,"_3292":132214},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3839":79135,"_33145":79114,"_22633":132216,"_5":15597,"_29869":132163,"_3292":132217},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3839":79136,"_33145":79114,"_22633":132219,"_5":15597,"_29869":132166,"_3292":132220},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3839":79137,"_33145":79114,"_22633":132222,"_5":15597,"_29869":132166,"_3292":132223},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3839":79138,"_33145":79114,"_22633":132225,"_5":15597,"_29869":132166,"_3292":132226},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3839":79139,"_33145":79114,"_22633":132228,"_5":15597,"_29869":132166,"_3292":132229},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3839":79140,"_33145":79114,"_22633":132231,"_5":15597,"_29869":132166,"_3292":132232},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3839":79141,"_33145":79114,"_22633":132234,"_5":15597,"_29869":132166,"_3292":132235},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3839":79142,"_33145":79114,"_22633":132237,"_5":15597,"_29869":132166,"_3292":132238},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3839":79143,"_33145":79114,"_22633":132240,"_5":15597,"_29869":132166,"_3292":132241},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3839":79144,"_33145":79114,"_22633":132243,"_5":15597,"_29869":132169,"_3292":132244},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3839":79145,"_33145":79114,"_22633":132246,"_5":15597,"_29869":132169,"_3292":132247},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3839":79146,"_33145":79114,"_22633":132249,"_5":15597,"_29869":132172,"_3292":132250},[],"Participante",{"_3839":79147,"_33145":79114,"_22633":132252,"_5":15597,"_29869":132172,"_3292":132253},[],"Responsabilidad",{"_3839":79148,"_33145":79114,"_22633":132255,"_5":15597,"_29869":132172,"_3292":132256},[],"Administrador PKI",{"_3839":79149,"_33145":79114,"_22633":132258,"_5":15597,"_29869":132172,"_3292":132259},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3839":79150,"_33145":79114,"_22633":132261,"_5":15597,"_29869":132172,"_3292":132262},[],"Administrador del aprovisionamiento",{"_3839":79151,"_33145":79114,"_22633":132264,"_5":15597,"_29869":132172,"_3292":132265},[],"DMS, admisión, autenticación por operación e inventario.",{"_3839":79152,"_33145":79114,"_22633":132267,"_5":15597,"_29869":132172,"_3292":132268},[],"Integrador del dispositivo",{"_3839":79153,"_33145":79114,"_22633":132270,"_5":15597,"_29869":132172,"_3292":132271},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3839":79154,"_33145":79114,"_22633":132273,"_5":15597,"_29869":132172,"_3292":132274},[],"Integrador del consumidor",{"_3839":79155,"_33145":79114,"_22633":132276,"_5":15597,"_29869":132172,"_3292":132277},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3839":79156,"_33145":79114,"_22633":132279,"_5":15597,"_29869":132172,"_3292":132280},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3839":79157,"_33145":79157,"_5":15996,"_3292":132282,"_33551":132283,"_22633":132285,"_29869":79157},"Enrola y conecta tu primer dispositivo",[54324,128959,56803,132284],"Primeros pasos",[],{"_3839":79158,"_33145":79157,"_22633":132287,"_5":15597,"_29869":79157,"_3292":132288},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3839":79159,"_33145":79157,"_5":33548,"_22633":132290,"_29869":132291,"_3292":127537},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3839":79160,"_33145":79157,"_5":33548,"_22633":132293,"_29869":132294,"_3292":132295},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3839":79161,"_33145":79157,"_5":33548,"_22633":132297,"_29869":132298,"_3292":132299},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3839":79162,"_33145":79157,"_5":33548,"_22633":132301,"_29869":132302,"_3292":132303},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3839":79163,"_33145":79157,"_5":33548,"_22633":132305,"_29869":132306,"_3292":132307},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3839":79164,"_33145":79157,"_5":33548,"_22633":132309,"_29869":132310,"_3292":132311},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3839":79165,"_33145":79157,"_5":33548,"_22633":132313,"_29869":132314,"_3292":132315},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3839":79166,"_33145":79157,"_5":33548,"_22633":132317,"_29869":132318,"_3292":132319},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3839":79167,"_33145":79157,"_22633":132321,"_5":15597,"_29869":79157,"_3292":132322},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3839":79168,"_33145":79157,"_22633":132324,"_5":15597,"_29869":132291,"_3292":132325},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3839":79169,"_33145":79157,"_22633":132327,"_5":15597,"_29869":132291,"_3292":132328},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3839":79170,"_33145":79157,"_22633":132330,"_5":15597,"_29869":132291,"_3292":132331},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3839":79171,"_33145":79157,"_22633":132333,"_5":15597,"_29869":132291,"_3292":132334},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3839":79172,"_33145":79157,"_22633":132336,"_5":15597,"_29869":132291,"_3292":132337},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3839":79173,"_33145":79157,"_22633":132339,"_5":15597,"_29869":132294,"_3292":132340},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3839":79174,"_33145":79157,"_22633":132342,"_5":15597,"_29869":132294,"_3292":132343},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3839":79175,"_33145":79157,"_22633":132345,"_5":15597,"_29869":132298,"_3292":132346},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3839":79176,"_33145":79157,"_22633":132348,"_5":15597,"_29869":132298,"_3292":132349},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3839":79177,"_33145":79157,"_22633":132351,"_5":15597,"_29869":132298,"_3292":132352},[],"Ajuste",{"_3839":79178,"_33145":79157,"_22633":132354,"_5":15597,"_29869":132298,"_3292":132355},[],"Valor de evaluación",{"_3839":79179,"_33145":79157,"_22633":132357,"_5":15597,"_29869":132298,"_3292":59305},[],{"_3839":79180,"_33145":79157,"_22633":132359,"_5":15597,"_29869":132298,"_3292":132360},[],"Raíz emisora de `device-root.pem`.",{"_3839":79181,"_33145":79157,"_22633":132362,"_5":15597,"_29869":132298,"_3292":130271},[],{"_3839":79182,"_33145":79157,"_22633":132364,"_5":15597,"_29869":132298,"_3292":132365},[],"Perfil final de 1 hora que acabas de preparar.",{"_3839":79183,"_33145":79157,"_22633":132367,"_5":15597,"_29869":132298,"_3292":59316},[],{"_3839":79184,"_33145":79157,"_22633":132369,"_5":15597,"_29869":132298,"_3292":59319},[],{"_3839":79185,"_33145":79157,"_22633":132371,"_5":15597,"_29869":132298,"_3292":59322},[],{"_3839":79186,"_33145":79157,"_22633":132373,"_5":15597,"_29869":132298,"_3292":132374},[],"Habilitado.",{"_3839":79187,"_33145":79157,"_22633":132376,"_5":15597,"_29869":132298,"_3292":59328},[],{"_3839":79188,"_33145":79157,"_22633":132378,"_5":15597,"_29869":132298,"_3292":132379},[],"Deshabilitado; el ID debe ser nuevo.",{"_3839":79189,"_33145":79157,"_22633":132381,"_5":15597,"_29869":132298,"_3292":132382},[],"Autenticación inicial",{"_3839":79190,"_33145":79157,"_22633":132384,"_5":15597,"_29869":132298,"_3292":132385},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3839":79191,"_33145":79157,"_22633":132387,"_5":15597,"_29869":132298,"_3292":132388},[],"Autenticación de renovación",{"_3839":79192,"_33145":79157,"_22633":132390,"_5":15597,"_29869":132298,"_3292":132391},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3839":79193,"_33145":79157,"_22633":132393,"_5":15597,"_29869":132298,"_3292":59346},[],{"_3839":79194,"_33145":79157,"_22633":132395,"_5":15597,"_29869":132298,"_3292":132396},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3839":79195,"_33145":79157,"_22633":132398,"_5":15597,"_29869":132298,"_3292":59352},[],{"_3839":79196,"_33145":79157,"_22633":132400,"_5":15597,"_29869":132298,"_3292":132401},[],"1 hora.",{"_3839":79197,"_33145":79157,"_22633":132403,"_5":15597,"_29869":132298,"_3292":59358},[],{"_3839":79198,"_33145":79157,"_22633":132405,"_5":15597,"_29869":132298,"_3292":132406},[],"30 minutos / 10 minutos.",{"_3839":79199,"_33145":79157,"_22633":132408,"_5":15597,"_29869":132298,"_3292":59364},[],{"_3839":79200,"_33145":79157,"_22633":132410,"_5":15597,"_29869":132298,"_3292":132411},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3839":79201,"_33145":79157,"_22633":132413,"_5":15597,"_29869":132298,"_3292":57122},[],{"_3839":79202,"_33145":79157,"_22633":132415,"_5":15597,"_29869":132298,"_3292":132416},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3839":79203,"_33145":79157,"_22633":132418,"_5":15597,"_29869":132298,"_3292":59375},[],{"_3839":79204,"_33145":79157,"_22633":132420,"_5":15597,"_29869":132298,"_3292":132421},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3839":79205,"_33145":79157,"_22633":132423,"_5":15597,"_29869":132298,"_3292":132424},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3839":79206,"_33145":79157,"_22633":132426,"_5":15597,"_29869":132302,"_3292":132427},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3839":79207,"_33145":79157,"_22633":132429,"_5":15597,"_29869":132302,"_3292":132430},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3839":79208,"_33145":79157,"_22633":132432,"_5":15597,"_29869":132306,"_3292":132433},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3839":79209,"_33145":79157,"_22633":132435,"_5":15597,"_29869":132306,"_3292":132436},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3839":79210,"_33145":79157,"_22633":132438,"_5":15597,"_29869":132306,"_3292":132439},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3839":79211,"_33145":79157,"_22633":132441,"_5":15597,"_29869":132310,"_3292":132442},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3839":79212,"_33145":79157,"_22633":132444,"_5":15597,"_29869":132310,"_3292":132445},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3839":79213,"_33145":79157,"_22633":132447,"_5":15597,"_29869":132314,"_3292":132448},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3839":79214,"_33145":79157,"_22633":132450,"_5":15597,"_29869":132314,"_3292":132451},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3839":79215,"_33145":79157,"_22633":132453,"_5":15597,"_29869":132314,"_3292":132454},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3839":79216,"_33145":79157,"_22633":132456,"_5":15597,"_29869":132314,"_3292":132457},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3839":79217,"_33145":79157,"_22633":132459,"_5":15597,"_29869":132314,"_3292":132460},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3839":79218,"_33145":79157,"_22633":132462,"_5":15597,"_29869":132318,"_3292":132463},[],"Comprobación",{"_3839":79219,"_33145":79157,"_22633":132465,"_5":15597,"_29869":132318,"_3292":132466},[],"Resultado esperado",{"_3839":79220,"_33145":79157,"_22633":132468,"_5":15597,"_29869":132318,"_3292":132469},[],"Registro",{"_3839":79221,"_33145":79157,"_22633":132471,"_5":15597,"_29869":132318,"_3292":132472},[],"ID creado automáticamente y DMS correcto.",{"_3839":79222,"_33145":79157,"_22633":132474,"_5":15597,"_29869":132318,"_3292":131759},[],{"_3839":79223,"_33145":79157,"_22633":132476,"_5":15597,"_29869":132318,"_3292":132477},[],"CN, perfil, serie y clave verificados.",{"_3839":79224,"_33145":79157,"_22633":132479,"_5":15597,"_29869":132318,"_3292":132480},[],"Inventario",{"_3839":79225,"_33145":79157,"_22633":132482,"_5":15597,"_29869":132318,"_3292":132483},[],"Serie recibida visible como identidad actual y en el historial.",{"_3839":79226,"_33145":79157,"_22633":132485,"_5":15597,"_29869":132318,"_3292":132486},[],"Consumidor",{"_3839":79227,"_33145":79157,"_22633":132488,"_5":15597,"_29869":132318,"_3292":132489},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3839":79228,"_33145":79157,"_22633":132491,"_5":15597,"_29869":132318,"_3292":132492},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3839":79229,"_33145":79157,"_22633":132494,"_5":15597,"_29869":132318,"_3292":132495},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3839":79230,"_33145":79230,"_5":15996,"_3292":129985,"_33551":132497,"_22633":132498,"_29869":79230},[54324,128959,56803,132284],[],{"_3839":79231,"_33145":79230,"_22633":132500,"_5":15597,"_29869":79230,"_3292":132501},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3839":79232,"_33145":79230,"_5":33548,"_22633":132503,"_29869":132504,"_3292":127537},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3839":79233,"_33145":79230,"_5":33548,"_22633":132506,"_29869":132507,"_3292":132508},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3839":79234,"_33145":79230,"_5":33548,"_22633":132510,"_29869":132511,"_3292":132512},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3839":79235,"_33145":79230,"_5":33548,"_22633":132514,"_29869":132515,"_3292":132516},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3839":79236,"_33145":79230,"_5":33548,"_22633":132518,"_29869":132519,"_3292":132520},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3839":79237,"_33145":79230,"_5":33548,"_22633":132522,"_29869":132523,"_3292":132524},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3839":79238,"_33145":79230,"_5":33548,"_22633":132526,"_29869":132527,"_3292":132466},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3839":79239,"_33145":79230,"_5":33548,"_22633":132529,"_29869":132530,"_3292":132531},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3839":79240,"_33145":79230,"_5":33548,"_22633":132533,"_29869":132534,"_3292":132535},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3839":79241,"_33145":79230,"_22633":132537,"_5":15597,"_29869":79230,"_3292":132538},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3839":79242,"_33145":79230,"_22633":132540,"_5":15597,"_29869":79230,"_3292":132541},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3839":79243,"_33145":79230,"_22633":132543,"_5":15597,"_29869":132504,"_3292":132544},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3839":79244,"_33145":79230,"_22633":132546,"_5":15597,"_29869":132504,"_3292":132547},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3839":79245,"_33145":79230,"_22633":132549,"_5":15597,"_29869":132504,"_3292":132550},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3839":79246,"_33145":79230,"_22633":132552,"_5":15597,"_29869":132504,"_3292":132553},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3839":79247,"_33145":79230,"_22633":132555,"_5":15597,"_29869":132507,"_3292":132556},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3839":79248,"_33145":79230,"_22633":132558,"_5":15597,"_29869":132507,"_3292":132559},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3839":79249,"_33145":79230,"_22633":132561,"_5":15597,"_29869":132507,"_3292":132562},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3839":79250,"_33145":79230,"_22633":132564,"_5":15597,"_29869":132507,"_3292":132565},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3839":79251,"_33145":79230,"_22633":132567,"_5":15597,"_29869":132507,"_3292":132568},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3839":79252,"_33145":79230,"_22633":132570,"_5":15597,"_29869":132507,"_3292":132571},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3839":79253,"_33145":79230,"_22633":132573,"_5":15597,"_29869":132507,"_3292":132574},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3839":79254,"_33145":79230,"_22633":132576,"_5":15597,"_29869":132507,"_3292":132577},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3839":79255,"_33145":79230,"_22633":132579,"_5":15597,"_29869":132511,"_3292":132580},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3839":79256,"_33145":79230,"_22633":132582,"_5":15597,"_29869":132511,"_3292":59540},[],{"_3839":79257,"_33145":79230,"_22633":132584,"_5":15597,"_29869":132511,"_3292":132585},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3839":79258,"_33145":79230,"_22633":132587,"_5":15597,"_29869":132511,"_3292":132588},[],"**Icon** y **Tags**: clasificación opcional.",{"_3839":79259,"_33145":79230,"_22633":132590,"_5":15597,"_29869":132511,"_3292":132591},[],"Confirma el registro.",{"_3839":79260,"_33145":79230,"_22633":132593,"_5":15597,"_29869":132515,"_3292":132594},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3839":79261,"_33145":79230,"_22633":132596,"_5":15597,"_29869":132515,"_3292":132597},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3839":79262,"_33145":79230,"_22633":132599,"_5":15597,"_29869":132519,"_3292":132600},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3839":79263,"_33145":79230,"_22633":132602,"_5":15597,"_29869":132519,"_3292":132603},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3839":79264,"_33145":79230,"_22633":132605,"_5":15597,"_29869":132523,"_3292":132606},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3839":79265,"_33145":79230,"_22633":132608,"_5":15597,"_29869":132523,"_3292":132609},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3839":79266,"_33145":79230,"_22633":132611,"_5":15597,"_29869":132527,"_3292":132463},[],{"_3839":79267,"_33145":79230,"_22633":132613,"_5":15597,"_29869":132527,"_3292":132614},[],"Resultado",{"_3839":79268,"_33145":79230,"_22633":132616,"_5":15597,"_29869":132527,"_3292":131745},[],{"_3839":79269,"_33145":79230,"_22633":132618,"_5":15597,"_29869":132527,"_3292":132619},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3839":79270,"_33145":79230,"_22633":132621,"_5":15597,"_29869":132527,"_3292":132622},[],"Identidad actual",{"_3839":79271,"_33145":79230,"_22633":132624,"_5":15597,"_29869":132527,"_3292":132625},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3839":79272,"_33145":79230,"_22633":132627,"_5":15597,"_29869":132527,"_3292":132628},[],"Historial",{"_3839":79273,"_33145":79230,"_22633":132630,"_5":15597,"_29869":132527,"_3292":132631},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3839":79274,"_33145":79230,"_22633":132633,"_5":15597,"_29869":132527,"_3292":132634},[],"Clave y certificado",{"_3839":79275,"_33145":79230,"_22633":132636,"_5":15597,"_29869":132527,"_3292":132637},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3839":79276,"_33145":79230,"_22633":132639,"_5":15597,"_29869":132530,"_3292":132640},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3839":79277,"_33145":79230,"_22633":132642,"_5":15597,"_29869":132530,"_3292":132643},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3839":79278,"_33145":79230,"_22633":132645,"_5":15597,"_29869":132530,"_3292":132646},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3839":79279,"_33145":79230,"_22633":132648,"_5":15597,"_29869":132530,"_3292":132649},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3839":79280,"_33145":79230,"_22633":132651,"_5":15597,"_29869":132534,"_3292":132652},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3839":79281,"_33145":79230,"_22633":132654,"_5":15597,"_29869":132534,"_3292":132655},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3839":79282,"_33145":79230,"_22633":132657,"_5":15597,"_29869":132534,"_3292":132658},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3839":79283,"_33145":79283,"_5":15996,"_3292":132660,"_33551":132661,"_22633":132662,"_29869":79283},"Plataforma Lamassu IoT",[54324,128959],[],{"_3839":79284,"_33145":79283,"_22633":132664,"_5":15597,"_29869":79283,"_3292":132665},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3839":79285,"_33145":79283,"_5":33548,"_22633":132667,"_29869":132668,"_3292":132160},[],"/docs/pr-preview/pr-58/es/platform/overview#empieza-aquí",{"_3839":79286,"_33145":79283,"_5":33548,"_22633":132670,"_29869":132671,"_3292":132672},[],"/docs/pr-preview/pr-58/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3839":79287,"_33145":79283,"_5":33548,"_22633":132674,"_29869":132675,"_3292":132676},[],"/docs/pr-preview/pr-58/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3839":79288,"_33145":79283,"_5":33548,"_22633":132678,"_29869":132679,"_3292":132680},[],"/docs/pr-preview/pr-58/es/platform/overview#capacidades-principales","Capacidades principales",{"_3839":79289,"_33145":79283,"_5":33548,"_22633":132682,"_29869":132683,"_3292":132684},[],"/docs/pr-preview/pr-58/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3839":79290,"_33145":79283,"_5":33548,"_22633":132686,"_29869":132687,"_3292":132688},[],"/docs/pr-preview/pr-58/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3839":79291,"_33145":79283,"_5":33548,"_22633":132690,"_29869":132691,"_3292":132692},[],"/docs/pr-preview/pr-58/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3839":79292,"_33145":79283,"_5":33548,"_22633":132694,"_29869":132695,"_3292":132696},[],"/docs/pr-preview/pr-58/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3839":79293,"_33145":79283,"_5":33548,"_22633":132698,"_29869":132699,"_3292":132700},[],"/docs/pr-preview/pr-58/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3839":79294,"_33145":79283,"_5":33548,"_22633":132702,"_29869":132703,"_3292":132704},[],"/docs/pr-preview/pr-58/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3839":79295,"_33145":79283,"_5":33548,"_22633":132706,"_29869":132707,"_3292":132708},[],"/docs/pr-preview/pr-58/es/platform/overview#referencia-operativa","Referencia operativa",{"_3839":79296,"_33145":79283,"_22633":132710,"_5":15597,"_29869":79283,"_3292":132711},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3839":79297,"_33145":79283,"_22633":132713,"_5":15597,"_29869":132668,"_3292":132714},[],"Elige el resultado que necesitas obtener:",{"_3839":79298,"_33145":79283,"_22633":132716,"_5":15597,"_29869":132668,"_3292":132717},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3839":79299,"_33145":79283,"_22633":132719,"_5":15597,"_29869":132668,"_3292":132720},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3839":79300,"_33145":79283,"_22633":132722,"_5":15597,"_29869":132668,"_3292":132723},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3839":79301,"_33145":79283,"_22633":132725,"_5":15597,"_29869":132671,"_3292":132726},[],"Bloque",{"_3839":79302,"_33145":79283,"_22633":132728,"_5":15597,"_29869":132671,"_3292":132729},[],"Qué gestionas",{"_3839":79303,"_33145":79283,"_22633":132731,"_5":15597,"_29869":132671,"_3292":132732},[],"Punto de entrada",{"_3839":79304,"_33145":79283,"_22633":132734,"_5":15597,"_29869":132671,"_3292":59693},[],{"_3839":79305,"_33145":79283,"_22633":132736,"_5":15597,"_29869":132671,"_3292":132737},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3839":79306,"_33145":79283,"_22633":132739,"_5":15597,"_29869":132671,"_3292":132740},[],"Visión general de PKI",{"_3839":79307,"_33145":79283,"_22633":132742,"_5":15597,"_29869":132671,"_3292":59702},[],{"_3839":79308,"_33145":79283,"_22633":132744,"_5":15597,"_29869":132671,"_3292":132745},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3839":79309,"_33145":79283,"_22633":132747,"_5":15597,"_29869":132671,"_3292":132748},[],"Visión general de IoT Fleets",{"_3839":79310,"_33145":79283,"_22633":132750,"_5":15597,"_29869":132671,"_3292":132751},[],"**Administración**",{"_3839":79311,"_33145":79283,"_22633":132753,"_5":15597,"_29869":132671,"_3292":132754},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3839":79312,"_33145":79283,"_22633":132756,"_5":15597,"_29869":132671,"_3292":128957},[],{"_3839":79313,"_33145":79283,"_22633":132758,"_5":15597,"_29869":132671,"_3292":132759},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3839":79314,"_33145":79283,"_22633":132761,"_5":15597,"_29869":132675,"_3292":132762},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3839":79315,"_33145":79283,"_22633":132764,"_5":15597,"_29869":132675,"_3292":132765},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3839":79316,"_33145":79283,"_22633":132767,"_5":15597,"_29869":132675,"_3292":132768},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3839":79317,"_33145":79283,"_22633":132770,"_5":15597,"_29869":132675,"_3292":132771},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3839":79318,"_33145":79283,"_22633":132773,"_5":15597,"_29869":132675,"_3292":132774},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3839":79319,"_33145":79283,"_22633":132776,"_5":15597,"_29869":132675,"_3292":132777},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3839":79320,"_33145":79283,"_22633":132779,"_5":15597,"_29869":132683,"_3292":132780},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3839":79321,"_33145":79283,"_22633":132782,"_5":15597,"_29869":132687,"_3292":132783},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3839":79322,"_33145":79283,"_22633":132785,"_5":15597,"_29869":132691,"_3292":132786},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3839":79323,"_33145":79283,"_22633":132788,"_5":15597,"_29869":132695,"_3292":132789},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3839":79324,"_33145":79283,"_22633":132791,"_5":15597,"_29869":132699,"_3292":132792},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3839":79325,"_33145":79283,"_22633":132794,"_5":15597,"_29869":132703,"_3292":132795},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3839":79326,"_33145":79283,"_22633":132797,"_5":15597,"_29869":132707,"_3292":132253},[],{"_3839":79327,"_33145":79283,"_22633":132799,"_5":15597,"_29869":132707,"_3292":132800},[],"Qué prepara o comprueba",{"_3839":79328,"_33145":79283,"_22633":132802,"_5":15597,"_29869":132707,"_3292":132256},[],{"_3839":79329,"_33145":79283,"_22633":132804,"_5":15597,"_29869":132707,"_3292":132805},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3839":79330,"_33145":79283,"_22633":132807,"_5":15597,"_29869":132707,"_3292":132808},[],"Administrador de la flota",{"_3839":79331,"_33145":79283,"_22633":132810,"_5":15597,"_29869":132707,"_3292":132811},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3839":79332,"_33145":79283,"_22633":132813,"_5":15597,"_29869":132707,"_3292":132268},[],{"_3839":79333,"_33145":79283,"_22633":132815,"_5":15597,"_29869":132707,"_3292":132816},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3839":79334,"_33145":79283,"_22633":132818,"_5":15597,"_29869":132707,"_3292":132274},[],{"_3839":79335,"_33145":79283,"_22633":132820,"_5":15597,"_29869":132707,"_3292":132821},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3839":79336,"_33145":79283,"_22633":132823,"_5":15597,"_29869":132707,"_3292":132824},[],"Operador de infraestructura",{"_3839":79337,"_33145":79283,"_22633":132826,"_5":15597,"_29869":132707,"_3292":132827},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3839":79338,"_33145":79283,"_22633":132829,"_5":15597,"_29869":132707,"_3292":132830},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3839":79339,"_33145":79339,"_5":15996,"_3292":132832,"_33551":132833,"_22633":132835,"_29869":79339},"Jerarquía y rotación de CAs",[54324,128959,59794,132834],"Claves, autoridades y certificados",[],{"_3839":79340,"_33145":79339,"_22633":132837,"_5":15597,"_29869":79339,"_3292":132838},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3839":79341,"_33145":79339,"_5":33548,"_22633":132840,"_29869":132841,"_3292":132842},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3839":79342,"_33145":79339,"_5":33548,"_22633":132844,"_29869":132845,"_3292":132846},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3839":79343,"_33145":79339,"_5":33548,"_22633":132848,"_29869":132849,"_3292":132850},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3839":79344,"_33145":79339,"_5":33548,"_22633":132852,"_29869":132853,"_3292":132854},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3839":79345,"_33145":79339,"_5":33548,"_22633":132856,"_29869":132857,"_3292":132858},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3839":79346,"_33145":79339,"_5":33548,"_22633":132860,"_29869":132861,"_3292":132862},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3839":79347,"_33145":79339,"_5":33548,"_22633":132864,"_29869":132865,"_3292":132866},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3839":79348,"_33145":79339,"_5":33548,"_22633":132868,"_29869":132869,"_3292":132870},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3839":79349,"_33145":79339,"_5":33548,"_22633":132872,"_29869":132873,"_3292":132874},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3839":79350,"_33145":79339,"_5":33548,"_22633":132876,"_29869":132877,"_3292":132878},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3839":79351,"_33145":79339,"_5":33548,"_22633":132880,"_29869":132881,"_3292":132882},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3839":79352,"_33145":79339,"_5":33548,"_22633":132884,"_29869":132885,"_3292":132886},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3839":79353,"_33145":79339,"_22633":132888,"_5":15597,"_29869":79339,"_3292":132889},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3839":79354,"_33145":79339,"_22633":132891,"_5":15597,"_29869":79339,"_3292":132892},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3839":79355,"_33145":79339,"_22633":132894,"_5":15597,"_29869":132841,"_3292":132895},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3839":79356,"_33145":79339,"_22633":132897,"_5":15597,"_29869":132841,"_3292":132898},[],"entorno, como producción y preproducción;",{"_3839":79357,"_33145":79339,"_22633":132900,"_5":15597,"_29869":132841,"_3292":132901},[],"propietario o equipo operador;",{"_3839":79358,"_33145":79339,"_22633":132903,"_5":15597,"_29869":132841,"_3292":132904},[],"familia de dispositivos o proceso de fabricación;",{"_3839":79359,"_33145":79339,"_22633":132906,"_5":15597,"_29869":132841,"_3292":132907},[],"región o requisito regulatorio;",{"_3839":79360,"_33145":79339,"_22633":132909,"_5":15597,"_29869":132841,"_3292":132910},[],"motor criptográfico o política de clave;",{"_3839":79361,"_33145":79339,"_22633":132912,"_5":15597,"_29869":132841,"_3292":132913},[],"ventana de mantenimiento y ritmo de renovación.",{"_3839":79362,"_33145":79339,"_22633":132915,"_5":15597,"_29869":132841,"_3292":132916},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3839":79363,"_33145":79339,"_22633":132918,"_5":15597,"_29869":132841,"_3292":132919},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3839":79364,"_33145":79339,"_22633":132921,"_5":15597,"_29869":132845,"_3292":132922},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3839":79365,"_33145":79339,"_22633":132924,"_5":15597,"_29869":132845,"_3292":132925},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3839":79366,"_33145":79339,"_22633":132927,"_5":15597,"_29869":132845,"_3292":132928},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3839":79367,"_33145":79339,"_22633":132930,"_5":15597,"_29869":132849,"_3292":132931},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3839":79368,"_33145":79339,"_22633":132933,"_5":15597,"_29869":132849,"_3292":132934},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3839":79369,"_33145":79339,"_22633":132936,"_5":15597,"_29869":132849,"_3292":132937},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3839":79370,"_33145":79339,"_22633":132939,"_5":15597,"_29869":132849,"_3292":132940},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3839":79371,"_33145":79339,"_22633":132942,"_5":15597,"_29869":132857,"_3292":132943},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3839":79372,"_33145":79339,"_22633":132945,"_5":15597,"_29869":132861,"_3292":132946},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3839":79373,"_33145":79339,"_22633":132948,"_5":15597,"_29869":132865,"_3292":132949},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3839":79374,"_33145":79339,"_22633":132951,"_5":15597,"_29869":132869,"_3292":132952},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3839":79375,"_33145":79339,"_22633":132954,"_5":15597,"_29869":132873,"_3292":132955},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3839":79376,"_33145":79339,"_22633":132957,"_5":15597,"_29869":132877,"_3292":132958},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3839":79377,"_33145":79339,"_22633":132960,"_5":15597,"_29869":132881,"_3292":132961},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3839":79378,"_33145":79339,"_22633":132963,"_5":15597,"_29869":132881,"_3292":132964},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3839":79379,"_33145":79339,"_22633":132966,"_5":15597,"_29869":132881,"_3292":132967},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3839":79380,"_33145":79339,"_22633":132969,"_5":15597,"_29869":132881,"_3292":132970},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3839":79381,"_33145":79339,"_22633":132972,"_5":15597,"_29869":132885,"_3292":132973},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3839":79382,"_33145":79339,"_22633":132975,"_5":15597,"_29869":132885,"_3292":132976},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3839":79383,"_33145":79339,"_22633":132978,"_5":15597,"_29869":132885,"_3292":132979},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3839":79384,"_33145":79339,"_22633":132981,"_5":15597,"_29869":132885,"_3292":132982},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3839":79385,"_33145":79339,"_22633":132984,"_5":15597,"_29869":132885,"_3292":132985},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3839":79386,"_33145":79339,"_22633":132987,"_5":15597,"_29869":132885,"_3292":132988},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3839":79387,"_33145":79339,"_22633":132990,"_5":15597,"_29869":132885,"_3292":132991},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3839":79388,"_33145":79388,"_5":15996,"_3292":132993,"_33551":132994,"_22633":132995,"_29869":79388},"Autoridades de certificación",[54324,128959,59794,132834],[],{"_3839":79389,"_33145":79388,"_22633":132997,"_5":15597,"_29869":79388,"_3292":132998},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3839":79390,"_33145":79388,"_5":33548,"_22633":133000,"_29869":133001,"_3292":133002},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3839":79391,"_33145":79388,"_5":33548,"_22633":133004,"_29869":133005,"_3292":133006},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3839":79392,"_33145":79388,"_5":33548,"_22633":133008,"_29869":133009,"_3292":127537},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3839":79393,"_33145":79388,"_5":33548,"_22633":133011,"_29869":133012,"_3292":133013},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3839":79394,"_33145":79388,"_5":33548,"_22633":133015,"_29869":133016,"_3292":133017},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3839":79395,"_33145":79388,"_5":33548,"_22633":133019,"_29869":133020,"_3292":133021},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3839":79396,"_33145":79388,"_5":33548,"_22633":133023,"_29869":133024,"_3292":133025},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3839":79397,"_33145":79388,"_5":33548,"_22633":133027,"_29869":133028,"_3292":133029},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3839":79398,"_33145":79388,"_5":33548,"_22633":133031,"_29869":133032,"_3292":133033},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3839":79399,"_33145":79388,"_5":33548,"_22633":133035,"_29869":133036,"_3292":133037},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3839":79400,"_33145":79388,"_5":33548,"_22633":133039,"_29869":133040,"_3292":133041},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3839":79401,"_33145":79388,"_5":33548,"_22633":133043,"_29869":133044,"_3292":133045},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3839":79402,"_33145":79388,"_5":33548,"_22633":133047,"_29869":133048,"_3292":133049},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3839":79403,"_33145":79388,"_5":33548,"_22633":133051,"_29869":133052,"_3292":133053},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3839":79404,"_33145":79388,"_5":33548,"_22633":133055,"_29869":133056,"_3292":133057},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3839":79405,"_33145":79388,"_5":33548,"_22633":133059,"_29869":133060,"_3292":133061},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3839":79406,"_33145":79388,"_5":33548,"_22633":133063,"_29869":133064,"_3292":133065},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3839":79407,"_33145":79388,"_5":33548,"_22633":133067,"_29869":133068,"_3292":133069},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3839":79408,"_33145":79388,"_5":33548,"_22633":133071,"_29869":133072,"_3292":133073},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3839":79409,"_33145":79388,"_5":33548,"_22633":133075,"_29869":133076,"_3292":133077},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3839":79410,"_33145":79388,"_5":33548,"_22633":133079,"_29869":133080,"_3292":133081},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3839":79411,"_33145":79388,"_5":33548,"_22633":133083,"_29869":133084,"_3292":133085},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3839":79412,"_33145":79388,"_5":33548,"_22633":133087,"_29869":133088,"_3292":133089},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3839":79413,"_33145":79388,"_22633":133091,"_5":15597,"_29869":79388,"_3292":133092},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3839":79414,"_33145":79388,"_22633":133094,"_5":15597,"_29869":79388,"_3292":133095},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3839":79415,"_33145":79388,"_22633":133097,"_5":15597,"_29869":79388,"_3292":133098},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3839":79416,"_33145":79388,"_22633":133100,"_5":15597,"_29869":133001,"_3292":133101},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3839":79417,"_33145":79388,"_22633":133103,"_5":15597,"_29869":133001,"_3292":133104},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3839":79418,"_33145":79388,"_22633":133106,"_5":15597,"_29869":133001,"_3292":133107},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3839":79419,"_33145":79388,"_22633":133109,"_5":15597,"_29869":133001,"_3292":133110},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3839":79420,"_33145":79388,"_22633":133112,"_5":15597,"_29869":133001,"_3292":133113},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3839":79421,"_33145":79388,"_22633":133115,"_5":15597,"_29869":133009,"_3292":133116},[],"Decide si la CA será raíz o intermedia.",{"_3839":79422,"_33145":79388,"_22633":133118,"_5":15597,"_29869":133009,"_3292":133119},[],"Elige el motor que custodiará la clave.",{"_3839":79423,"_33145":79388,"_22633":133121,"_5":15597,"_29869":133009,"_3292":133122},[],"Define una validez superior a la de los certificados que emitirá.",{"_3839":79424,"_33145":79388,"_22633":133124,"_5":15597,"_29869":133009,"_3292":133125},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3839":79425,"_33145":79388,"_22633":133127,"_5":15597,"_29869":133012,"_3292":133128},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3839":79426,"_33145":79388,"_22633":133130,"_5":15597,"_29869":133016,"_3292":133131},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3839":79427,"_33145":79388,"_22633":133133,"_5":15597,"_29869":133016,"_3292":133134},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3839":79428,"_33145":79388,"_22633":133136,"_5":15597,"_29869":133020,"_3292":133137},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3839":79429,"_33145":79388,"_22633":133139,"_5":15597,"_29869":133024,"_3292":133140},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3839":79430,"_33145":79388,"_22633":133142,"_5":15597,"_29869":133024,"_3292":133143},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3839":79431,"_33145":79388,"_22633":133145,"_5":15597,"_29869":133024,"_3292":133146},[],"`ST`: estado o provincia.",{"_3839":79432,"_33145":79388,"_22633":133148,"_5":15597,"_29869":133024,"_3292":133149},[],"`L`: localidad.",{"_3839":79433,"_33145":79388,"_22633":133151,"_5":15597,"_29869":133024,"_3292":133152},[],"`O`: organización.",{"_3839":79434,"_33145":79388,"_22633":133154,"_5":15597,"_29869":133024,"_3292":133155},[],"`OU`: unidad organizativa.",{"_3839":79435,"_33145":79388,"_22633":133157,"_5":15597,"_29869":133024,"_3292":133158},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3839":79436,"_33145":79388,"_22633":133160,"_5":15597,"_29869":133028,"_3292":133161},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3839":79437,"_33145":79388,"_22633":133163,"_5":15597,"_29869":133028,"_3292":133164},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3839":79438,"_33145":79388,"_22633":133166,"_5":15597,"_29869":133032,"_3292":133167},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3839":79439,"_33145":79388,"_22633":133169,"_5":15597,"_29869":133032,"_3292":133170},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3839":79440,"_33145":79388,"_22633":133172,"_5":15597,"_29869":133036,"_3292":133173},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3839":79441,"_33145":79388,"_22633":133175,"_5":15597,"_29869":133036,"_3292":133176},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3839":79442,"_33145":79388,"_22633":133178,"_5":15597,"_29869":133040,"_3292":133179},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3839":79443,"_33145":79388,"_22633":133181,"_5":15597,"_29869":133040,"_3292":133182},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3839":79444,"_33145":79388,"_22633":133184,"_5":15597,"_29869":133040,"_3292":133185},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3839":79445,"_33145":79388,"_22633":133187,"_5":15597,"_29869":133044,"_3292":133188},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3839":79446,"_33145":79388,"_22633":133190,"_5":15597,"_29869":133048,"_3292":133191},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3839":79447,"_33145":79388,"_22633":133193,"_5":15597,"_29869":133052,"_3292":133194},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3839":79448,"_33145":79388,"_22633":133196,"_5":15597,"_29869":133056,"_3292":133197},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3839":79449,"_33145":79388,"_22633":133199,"_5":15597,"_29869":133056,"_3292":133200},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3839":79450,"_33145":79388,"_22633":133202,"_5":15597,"_29869":133060,"_3292":133203},[],"Abre una CA desde el inventario para consultar:",{"_3839":79451,"_33145":79388,"_22633":133205,"_5":15597,"_29869":133060,"_3292":133206},[],"Estado y periodo de validez.",{"_3839":79452,"_33145":79388,"_22633":133208,"_5":15597,"_29869":133060,"_3292":133209},[],"Certificado y cadena en formato PEM.",{"_3839":79453,"_33145":79388,"_22633":133211,"_5":15597,"_29869":133060,"_3292":133212},[],"Número de certificados activos, expirados y revocados.",{"_3839":79454,"_33145":79388,"_22633":133214,"_5":15597,"_29869":133060,"_3292":133215},[],"Certificados emitidos en **Issued Certificates**.",{"_3839":79455,"_33145":79388,"_22633":133217,"_5":15597,"_29869":133060,"_3292":133218},[],"CRL vinculada a la autoridad.",{"_3839":79456,"_33145":79388,"_22633":133220,"_5":15597,"_29869":133060,"_3292":133221},[],"Metadatos y motor criptográfico asociado.",{"_3839":79457,"_33145":79388,"_22633":133223,"_5":15597,"_29869":133060,"_3292":133224},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3839":79458,"_33145":79388,"_22633":133226,"_5":15597,"_29869":133064,"_3292":133227},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3839":79459,"_33145":79388,"_22633":133229,"_5":15597,"_29869":133064,"_3292":133230},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3839":79460,"_33145":79388,"_22633":133232,"_5":15597,"_29869":133064,"_3292":133233},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3839":79461,"_33145":79388,"_22633":133235,"_5":15597,"_29869":133064,"_3292":133236},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3839":79462,"_33145":79388,"_22633":133238,"_5":15597,"_29869":133068,"_3292":133239},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3839":79463,"_33145":79388,"_22633":133241,"_5":15597,"_29869":133072,"_3292":133242},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3839":79464,"_33145":79388,"_22633":133244,"_5":15597,"_29869":133076,"_3292":133245},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3839":79465,"_33145":79388,"_22633":133247,"_5":15597,"_29869":133080,"_3292":133248},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3839":79466,"_33145":79388,"_22633":133250,"_5":15597,"_29869":133084,"_3292":133251},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3839":79467,"_33145":79388,"_22633":133253,"_5":15597,"_29869":133088,"_3292":133254},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3839":79468,"_33145":79388,"_22633":133256,"_5":15597,"_29869":133088,"_3292":133257},[],"El rol VA de la CA se conserva. Si no queda otra CA con el mismo SKI, deja de ser editable (consulta CRL), así que ajusta antes su validez y su firmante. La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3839":79469,"_33145":79388,"_22633":133259,"_5":15597,"_29869":133088,"_3292":133260},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. Si el certificado nuevo usa la misma clave, comparte el SKI con el rol VA retenido de la CA eliminada, cuyo firmante es el certificado antiguo: comprueba que la CRL se genera y, si no es así, asigna con `PUT` un firmante de la CA nueva (consulta CRL).",{"_3839":79470,"_33145":79470,"_5":15996,"_3292":133262,"_33551":133263,"_22633":133264,"_29869":79470},"Perfiles de certificado",[54324,128959,59794,132834],[],{"_3839":79471,"_33145":79470,"_22633":133266,"_5":15597,"_29869":79470,"_3292":133267},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3839":79472,"_33145":79470,"_5":33548,"_22633":133269,"_29869":133270,"_3292":133271},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3839":79473,"_33145":79470,"_5":33548,"_22633":133273,"_29869":133274,"_3292":133275},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#validez","Validez",{"_3839":79474,"_33145":79470,"_5":33548,"_22633":133277,"_29869":133278,"_3292":133279},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3839":79475,"_33145":79470,"_5":33548,"_22633":133281,"_29869":133282,"_3292":133283},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3839":79476,"_33145":79470,"_5":33548,"_22633":133285,"_29869":133286,"_3292":133287},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3839":79477,"_33145":79470,"_5":33548,"_22633":133289,"_29869":133290,"_3292":133291},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3839":79478,"_33145":79470,"_5":33548,"_22633":133293,"_29869":133294,"_3292":133295},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3839":79479,"_33145":79470,"_5":33548,"_22633":133297,"_29869":133298,"_3292":133299},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3839":79480,"_33145":79470,"_5":33548,"_22633":133301,"_29869":133302,"_3292":133303},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3839":79481,"_33145":79470,"_5":33548,"_22633":133305,"_29869":133306,"_3292":133307},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3839":79482,"_33145":79470,"_5":33548,"_22633":133309,"_29869":133310,"_3292":133311},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3839":79483,"_33145":79470,"_5":33548,"_22633":133313,"_29869":133314,"_3292":133315},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3839":79484,"_33145":79470,"_5":33548,"_22633":133317,"_29869":133318,"_3292":133319},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3839":79485,"_33145":79470,"_5":33548,"_22633":133321,"_29869":133322,"_3292":133323},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3839":79486,"_33145":79470,"_5":33548,"_22633":133325,"_29869":133326,"_3292":133327},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3839":79487,"_33145":79470,"_5":33548,"_22633":133329,"_29869":133330,"_3292":133331},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3839":79488,"_33145":79470,"_22633":133333,"_5":15597,"_29869":79470,"_3292":133334},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3839":79489,"_33145":79470,"_22633":133336,"_5":15597,"_29869":79470,"_3292":133337},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3839":79490,"_33145":79470,"_22633":133339,"_5":15597,"_29869":133274,"_3292":133340},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3839":79491,"_33145":79470,"_22633":133342,"_5":15597,"_29869":133274,"_3292":133343},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3839":79492,"_33145":79470,"_22633":133345,"_5":15597,"_29869":133278,"_3292":133346},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3839":79493,"_33145":79470,"_22633":133348,"_5":15597,"_29869":133282,"_3292":133349},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3839":79494,"_33145":79470,"_22633":133351,"_5":15597,"_29869":133282,"_3292":133352},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3839":79495,"_33145":79470,"_22633":133354,"_5":15597,"_29869":133282,"_3292":133355},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3839":79496,"_33145":79470,"_22633":133357,"_5":15597,"_29869":133286,"_3292":133358},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3839":79497,"_33145":79470,"_22633":133360,"_5":15597,"_29869":133290,"_3292":133361},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3839":79498,"_33145":79470,"_22633":133363,"_5":15597,"_29869":133290,"_3292":133364},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3839":79499,"_33145":79470,"_22633":133366,"_5":15597,"_29869":133294,"_3292":133367},[],"La aplicación criptográfica puede:",{"_3839":79500,"_33145":79470,"_22633":133369,"_5":15597,"_29869":133294,"_3292":133370},[],"permitir o bloquear claves RSA;",{"_3839":79501,"_33145":79470,"_22633":133372,"_5":15597,"_29869":133294,"_3292":133373},[],"limitar los tamaños RSA admitidos;",{"_3839":79502,"_33145":79470,"_22633":133375,"_5":15597,"_29869":133294,"_3292":133376},[],"permitir o bloquear claves ECDSA;",{"_3839":79503,"_33145":79470,"_22633":133378,"_5":15597,"_29869":133294,"_3292":133379},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3839":79504,"_33145":79470,"_22633":133381,"_5":15597,"_29869":133294,"_3292":133382},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3839":79505,"_33145":79470,"_22633":133384,"_5":15597,"_29869":133298,"_3292":133385},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3839":79506,"_33145":79470,"_22633":133387,"_5":15597,"_29869":133298,"_3292":128719},[],{"_3839":79507,"_33145":79470,"_22633":133389,"_5":15597,"_29869":133298,"_3292":133390},[],"Primera opción",{"_3839":79508,"_33145":79470,"_22633":133392,"_5":15597,"_29869":133298,"_3292":133393},[],"Segunda opción",{"_3839":79509,"_33145":79470,"_22633":133395,"_5":15597,"_29869":133298,"_3292":133396},[],"Si no hay ninguna",{"_3839":79510,"_33145":79470,"_22633":133398,"_5":15597,"_29869":133298,"_3292":133399},[],"Firma directa con una CA",{"_3839":79511,"_33145":79470,"_22633":133401,"_5":15597,"_29869":133298,"_3292":133402},[],"`issuance_profile` incluido en la solicitud",{"_3839":79512,"_33145":79470,"_22633":133404,"_5":15597,"_29869":133298,"_3292":133405},[],"`issuance_profile_id` de la solicitud",{"_3839":79513,"_33145":79470,"_22633":133407,"_5":15597,"_29869":133298,"_3292":133408},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3839":79514,"_33145":79470,"_22633":133410,"_5":15597,"_29869":133298,"_3292":133411},[],"Emisión mediante DMS",{"_3839":79515,"_33145":79470,"_22633":133413,"_5":15597,"_29869":133298,"_3292":60375},[],{"_3839":79516,"_33145":79470,"_22633":133415,"_5":15597,"_29869":133298,"_3292":133416},[],"`settings.issuance_profile` incluido en el DMS",{"_3839":79517,"_33145":79470,"_22633":133418,"_5":15597,"_29869":133298,"_3292":133419},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3839":79518,"_33145":79470,"_22633":133421,"_5":15597,"_29869":133298,"_3292":133422},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3839":79519,"_33145":79470,"_22633":133424,"_5":15597,"_29869":133298,"_3292":133425},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3839":79520,"_33145":79470,"_22633":133427,"_5":15597,"_29869":133306,"_3292":133428},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3839":79521,"_33145":79470,"_22633":133430,"_5":15597,"_29869":133310,"_3292":133431},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3839":79522,"_33145":79470,"_22633":133433,"_5":15597,"_29869":133314,"_3292":133434},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3839":79523,"_33145":79470,"_22633":133436,"_5":15597,"_29869":133318,"_3292":133437},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3839":79524,"_33145":79470,"_22633":133439,"_5":15597,"_29869":133322,"_3292":133440},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3839":79525,"_33145":79470,"_22633":133442,"_5":15597,"_29869":133322,"_3292":133443},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3839":79526,"_33145":79470,"_22633":133445,"_5":15597,"_29869":133326,"_3292":133446},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3839":79527,"_33145":79470,"_22633":133448,"_5":15597,"_29869":133326,"_3292":133449},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3839":79528,"_33145":79470,"_22633":133451,"_5":15597,"_29869":133326,"_3292":133452},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3839":79529,"_33145":79470,"_22633":133454,"_5":15597,"_29869":133326,"_3292":133455},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3839":79530,"_33145":79470,"_22633":133457,"_5":15597,"_29869":133330,"_3292":133458},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3839":79531,"_33145":79470,"_22633":133460,"_5":15597,"_29869":133330,"_3292":133461},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3839":79532,"_33145":79532,"_5":15996,"_3292":133463,"_33551":133464,"_22633":133466,"_29869":79532},"Validación de certificados",[54324,128959,59794,133465],"Validación",[],{"_3839":79533,"_33145":79532,"_22633":133468,"_5":15597,"_29869":79532,"_3292":133469},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3839":79534,"_33145":79532,"_5":33548,"_22633":133471,"_29869":133472,"_3292":133473},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3839":79535,"_33145":79532,"_5":33548,"_22633":133475,"_29869":133476,"_3292":133477},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3839":79536,"_33145":79532,"_5":33548,"_22633":133479,"_29869":133480,"_3292":133481},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3839":79537,"_33145":79532,"_22633":133483,"_5":15597,"_29869":79532,"_3292":133484},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3839":79538,"_33145":79532,"_22633":133486,"_5":15597,"_29869":133472,"_3292":133487},[],"Verifica estos criterios juntos:",{"_3839":79539,"_33145":79532,"_22633":133489,"_5":15597,"_29869":133472,"_3292":132463},[],{"_3839":79540,"_33145":79532,"_22633":133491,"_5":15597,"_29869":133472,"_3292":133492},[],"Resultado necesario",{"_3839":79541,"_33145":79532,"_22633":133494,"_5":15597,"_29869":133472,"_3292":133495},[],"Cadena y firma",{"_3839":79542,"_33145":79532,"_22633":133497,"_5":15597,"_29869":133472,"_3292":133498},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3839":79543,"_33145":79532,"_22633":133500,"_5":15597,"_29869":133472,"_3292":133501},[],"Fechas",{"_3839":79544,"_33145":79532,"_22633":133503,"_5":15597,"_29869":133472,"_3292":133504},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3839":79545,"_33145":79532,"_22633":133506,"_5":15597,"_29869":133472,"_3292":128629},[],{"_3839":79546,"_33145":79532,"_22633":133508,"_5":15597,"_29869":133472,"_3292":133509},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3839":79547,"_33145":79532,"_22633":133511,"_5":15597,"_29869":133472,"_3292":133512},[],"Uso",{"_3839":79548,"_33145":79532,"_22633":133514,"_5":15597,"_29869":133472,"_3292":133515},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3839":79549,"_33145":79532,"_22633":133517,"_5":15597,"_29869":133472,"_3292":133518},[],"Revocación",{"_3839":79550,"_33145":79532,"_22633":133520,"_5":15597,"_29869":133472,"_3292":133521},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3839":79551,"_33145":79532,"_22633":133523,"_5":15597,"_29869":133472,"_3292":133524},[],"Autorización",{"_3839":79552,"_33145":79532,"_22633":133526,"_5":15597,"_29869":133472,"_3292":133527},[],"La aplicación permite la acción a esa identidad.",{"_3839":79553,"_33145":79532,"_22633":133529,"_5":15597,"_29869":133472,"_3292":133530},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3839":79554,"_33145":79532,"_22633":133532,"_5":15597,"_29869":133476,"_3292":133533},[],"Mecanismo",{"_3839":79555,"_33145":79532,"_22633":133535,"_5":15597,"_29869":133476,"_3292":133536},[],"Cuándo utilizarlo",{"_3839":79556,"_33145":79532,"_22633":133538,"_5":15597,"_29869":133476,"_3292":133539},[],"Qué debes mantener",{"_3839":79557,"_33145":79532,"_22633":133541,"_5":15597,"_29869":133476,"_3292":60503},[],{"_3839":79558,"_33145":79532,"_22633":133543,"_5":15597,"_29869":133476,"_3292":133544},[],"Consulta del estado de un certificado concreto.",{"_3839":79559,"_33145":79532,"_22633":133546,"_5":15597,"_29869":133476,"_3292":133547},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3839":79560,"_33145":79532,"_22633":133549,"_5":15597,"_29869":133476,"_3292":60512},[],{"_3839":79561,"_33145":79532,"_22633":133551,"_5":15597,"_29869":133476,"_3292":133552},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3839":79562,"_33145":79532,"_22633":133554,"_5":15597,"_29869":133476,"_3292":133555},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3839":79563,"_33145":79532,"_22633":133557,"_5":15597,"_29869":133476,"_3292":133558},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3839":79564,"_33145":79532,"_22633":133560,"_5":15597,"_29869":133476,"_3292":133561},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3839":79565,"_33145":79532,"_22633":133563,"_5":15597,"_29869":133480,"_3292":133564},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3839":79566,"_33145":79532,"_22633":133566,"_5":15597,"_29869":133480,"_3292":133567},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3839":79567,"_33145":79532,"_22633":133569,"_5":15597,"_29869":133480,"_3292":133570},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3839":79568,"_33145":79532,"_22633":133572,"_5":15597,"_29869":133480,"_3292":133573},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3839":79569,"_33145":79532,"_22633":133575,"_5":15597,"_29869":133480,"_3292":133576},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3839":79570,"_33145":79532,"_22633":133578,"_5":15597,"_29869":133480,"_3292":133579},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3839":79571,"_33145":79532,"_22633":133581,"_5":15597,"_29869":133480,"_3292":133582},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3839":79572,"_33145":79532,"_22633":133584,"_5":15597,"_29869":133480,"_3292":133585},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3839":79573,"_33145":79532,"_22633":133587,"_5":15597,"_29869":133480,"_3292":133588},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3839":79574,"_33145":79574,"_5":15996,"_3292":133590,"_33551":133591,"_22633":133592,"_29869":79574},"Certificados",[54324,128959,59794,132834],[],{"_3839":79575,"_33145":79574,"_22633":133594,"_5":15597,"_29869":79574,"_3292":133595},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3839":79576,"_33145":79574,"_5":33548,"_22633":133597,"_29869":133598,"_3292":133599},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3839":79577,"_33145":79574,"_5":33548,"_22633":133601,"_29869":133602,"_3292":133603},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3839":79578,"_33145":79574,"_5":33548,"_22633":133605,"_29869":133606,"_3292":133607},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3839":79579,"_33145":79574,"_5":33548,"_22633":133609,"_29869":133610,"_3292":133611},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3839":79580,"_33145":79574,"_5":33548,"_22633":133613,"_29869":133614,"_3292":133615},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3839":79581,"_33145":79574,"_5":33548,"_22633":133617,"_29869":133618,"_3292":133619},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3839":79582,"_33145":79574,"_5":33548,"_22633":133621,"_29869":133622,"_3292":133623},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3839":79583,"_33145":79574,"_5":33548,"_22633":133625,"_29869":133626,"_3292":133627},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3839":79584,"_33145":79574,"_5":33548,"_22633":133629,"_29869":133630,"_3292":133631},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#continúa","Continúa",{"_3839":79585,"_33145":79574,"_22633":133633,"_5":15597,"_29869":79574,"_3292":133634},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3839":79586,"_33145":79574,"_22633":133636,"_5":15597,"_29869":133598,"_3292":133637},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos. Los detalles del certificado incluyen la referencia a la clave (`key_id`) y si la clave privada está gestionada (`has_private_key`), y las listas de certificados pueden filtrarse por `has_private_key`.",{"_3839":79587,"_33145":79574,"_22633":133639,"_5":15597,"_29869":133598,"_3292":133640},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3839":79588,"_33145":79574,"_22633":133642,"_5":15597,"_29869":133602,"_3292":133643},[],"Descarga el PEM e inspecciónalo:",{"_3839":79589,"_33145":79574,"_22633":133645,"_5":15597,"_29869":133602,"_3292":133646},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3839":79590,"_33145":79574,"_22633":133648,"_5":15597,"_29869":133606,"_3292":133649},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3839":79591,"_33145":79574,"_22633":133651,"_5":15597,"_29869":133606,"_3292":133652},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3839":79592,"_33145":79574,"_22633":133654,"_5":15597,"_29869":133606,"_3292":133655},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3839":79593,"_33145":79574,"_22633":133657,"_5":15597,"_29869":133606,"_3292":133658},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3839":79594,"_33145":79574,"_22633":133660,"_5":15597,"_29869":133606,"_3292":133661},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3839":79595,"_33145":79574,"_22633":133663,"_5":15597,"_29869":133606,"_3292":133664},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3839":79596,"_33145":79574,"_22633":133666,"_5":15597,"_29869":133606,"_3292":133667},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3839":79597,"_33145":79574,"_22633":133669,"_5":15597,"_29869":133610,"_3292":133670},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3839":79598,"_33145":79574,"_22633":133672,"_5":15597,"_29869":133614,"_3292":133673},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3839":79599,"_33145":79574,"_22633":133675,"_5":15597,"_29869":133618,"_3292":133676},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3839":79600,"_33145":79574,"_22633":133678,"_5":15597,"_29869":133622,"_3292":133679},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3839":79601,"_33145":79574,"_22633":133681,"_5":15597,"_29869":133622,"_3292":133682},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3839":79602,"_33145":79574,"_22633":133684,"_5":15597,"_29869":133622,"_3292":133685},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3839":79603,"_33145":79574,"_22633":133687,"_5":15597,"_29869":133626,"_3292":133688},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3839":79604,"_33145":79574,"_22633":133690,"_5":15597,"_29869":133626,"_3292":133691},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3839":79605,"_33145":79574,"_22633":133693,"_5":15597,"_29869":133626,"_3292":133694},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3839":79606,"_33145":79574,"_22633":133696,"_5":15597,"_29869":133630,"_3292":133697},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3839":79607,"_33145":79574,"_22633":133699,"_5":15597,"_29869":133630,"_3292":133700},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3839":79608,"_33145":79608,"_5":15996,"_3292":133702,"_33551":133703,"_22633":133705,"_29869":79608},"Ciclo de vida de un certificado",[54324,128959,59794,133704],"Conceptos",[],{"_3839":79609,"_33145":79608,"_22633":133707,"_5":15597,"_29869":79608,"_3292":133708},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3839":79610,"_33145":79608,"_5":33548,"_22633":133710,"_29869":133711,"_3292":133712},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3839":79611,"_33145":79608,"_5":33548,"_22633":133714,"_29869":133715,"_3292":133716},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3839":79612,"_33145":79608,"_5":33548,"_22633":133718,"_29869":133719,"_3292":133720},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3839":79613,"_33145":79608,"_5":33548,"_22633":133722,"_29869":133723,"_3292":133724},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3839":79614,"_33145":79608,"_5":33548,"_22633":133726,"_29869":133727,"_3292":133728},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3839":79615,"_33145":79608,"_5":33548,"_22633":133730,"_29869":133731,"_3292":133732},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3839":79616,"_33145":79608,"_5":33548,"_22633":133734,"_29869":133735,"_3292":131457},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3839":79617,"_33145":79608,"_5":33548,"_22633":133737,"_29869":133738,"_3292":133739},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3839":79618,"_33145":79608,"_5":33548,"_22633":133741,"_29869":133742,"_3292":133743},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3839":79619,"_33145":79608,"_5":33548,"_22633":133745,"_29869":133746,"_3292":133747},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3839":79620,"_33145":79608,"_22633":133749,"_5":15597,"_29869":79608,"_3292":133750},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3839":79621,"_33145":79608,"_22633":133752,"_5":15597,"_29869":133715,"_3292":133753},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3839":79622,"_33145":79608,"_22633":133755,"_5":15597,"_29869":133719,"_3292":133756},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3839":79623,"_33145":79608,"_22633":133758,"_5":15597,"_29869":133723,"_3292":133759},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3839":79624,"_33145":79608,"_22633":133761,"_5":15597,"_29869":133727,"_3292":133762},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3839":79625,"_33145":79608,"_22633":133764,"_5":15597,"_29869":133731,"_3292":133765},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3839":79626,"_33145":79608,"_22633":133767,"_5":15597,"_29869":133735,"_3292":133768},[],"Lamassu persiste cuatro estados X.509:",{"_3839":79627,"_33145":79608,"_22633":133770,"_5":15597,"_29869":133735,"_3292":133771},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3839":79628,"_33145":79608,"_22633":133773,"_5":15597,"_29869":133735,"_3292":133774},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3839":79629,"_33145":79608,"_22633":133776,"_5":15597,"_29869":133735,"_3292":133777},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3839":79630,"_33145":79608,"_22633":133779,"_5":15597,"_29869":133735,"_3292":133780},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3839":79631,"_33145":79608,"_22633":133782,"_5":15597,"_29869":133735,"_3292":133783},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3839":79632,"_33145":79608,"_22633":133785,"_5":15597,"_29869":133738,"_3292":133786},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3839":79633,"_33145":79608,"_22633":133788,"_5":15597,"_29869":133738,"_3292":133789},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3839":79634,"_33145":79608,"_22633":133791,"_5":15597,"_29869":133738,"_3292":133792},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3839":79635,"_33145":79608,"_22633":133794,"_5":15597,"_29869":133742,"_3292":133795},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3839":79636,"_33145":79608,"_22633":133797,"_5":15597,"_29869":133742,"_3292":133798},[],"Antes de confirmar:",{"_3839":79637,"_33145":79608,"_22633":133800,"_5":15597,"_29869":133742,"_3292":133801},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3839":79638,"_33145":79608,"_22633":133803,"_5":15597,"_29869":133742,"_3292":133804},[],"Distribuye la nueva cadena de confianza.",{"_3839":79639,"_33145":79608,"_22633":133806,"_5":15597,"_29869":133742,"_3292":133807},[],"Reemite las identidades necesarias.",{"_3839":79640,"_33145":79608,"_22633":133809,"_5":15597,"_29869":133742,"_3292":133810},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3839":79641,"_33145":79608,"_22633":133812,"_5":15597,"_29869":133742,"_3292":133813},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3839":79642,"_33145":79608,"_22633":133815,"_5":15597,"_29869":133742,"_3292":133816},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3839":79643,"_33145":79608,"_22633":133818,"_5":15597,"_29869":133746,"_3292":133819},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3839":79644,"_33145":79608,"_22633":133821,"_5":15597,"_29869":133746,"_3292":133822},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3839":79645,"_33145":79608,"_22633":133824,"_5":15597,"_29869":133746,"_3292":133825},[],"Cambios de estado y razones de revocación.",{"_3839":79646,"_33145":79608,"_22633":133827,"_5":15597,"_29869":133746,"_3292":133828},[],"Publicación y vigencia de OCSP y CRLs.",{"_3839":79647,"_33145":79608,"_22633":133830,"_5":15597,"_29869":133746,"_3292":133831},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3839":79648,"_33145":79608,"_22633":133833,"_5":15597,"_29869":133746,"_3292":133834},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3839":79649,"_33145":79649,"_5":15996,"_3292":133836,"_33551":133837,"_22633":133838,"_29869":79649},"Modelo de confianza",[54324,128959,59794,133704],[],{"_3839":79650,"_33145":79649,"_22633":133840,"_5":15597,"_29869":79649,"_3292":133841},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3839":79651,"_33145":79649,"_5":33548,"_22633":133843,"_29869":133844,"_3292":133845},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3839":79652,"_33145":79649,"_5":33548,"_22633":133847,"_29869":133848,"_3292":133849},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3839":79653,"_33145":79649,"_5":33548,"_22633":133851,"_29869":133852,"_3292":133853},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3839":79654,"_33145":79649,"_5":33548,"_22633":133855,"_29869":133856,"_3292":133857},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3839":79655,"_33145":79649,"_5":33548,"_22633":133859,"_29869":133860,"_3292":133861},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3839":79656,"_33145":79649,"_5":33548,"_22633":133863,"_29869":133864,"_3292":133865},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3839":79657,"_33145":79649,"_5":33548,"_22633":133867,"_29869":133868,"_3292":133869},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3839":79658,"_33145":79649,"_5":33548,"_22633":133871,"_29869":133872,"_3292":133873},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3839":79659,"_33145":79649,"_5":33548,"_22633":133875,"_29869":133876,"_3292":133877},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3839":79660,"_33145":79649,"_5":33548,"_22633":133879,"_29869":133880,"_3292":133881},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3839":79661,"_33145":79649,"_22633":133883,"_5":15597,"_29869":79649,"_3292":133884},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3839":79662,"_33145":79649,"_22633":133886,"_5":15597,"_29869":133848,"_3292":133887},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3839":79663,"_33145":79649,"_22633":133889,"_5":15597,"_29869":133852,"_3292":133890},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3839":79664,"_33145":79649,"_22633":133892,"_5":15597,"_29869":133856,"_3292":133893},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3839":79665,"_33145":79649,"_22633":133895,"_5":15597,"_29869":133860,"_3292":133896},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3839":79666,"_33145":79649,"_22633":133898,"_5":15597,"_29869":133864,"_3292":133899},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3839":79667,"_33145":79649,"_22633":133901,"_5":15597,"_29869":133864,"_3292":133902},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3839":79668,"_33145":79649,"_22633":133904,"_5":15597,"_29869":133864,"_3292":133905},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3839":79669,"_33145":79649,"_22633":133907,"_5":15597,"_29869":133864,"_3292":133908},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3839":79670,"_33145":79649,"_22633":133910,"_5":15597,"_29869":133864,"_3292":133911},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3839":79671,"_33145":79649,"_22633":133913,"_5":15597,"_29869":133864,"_3292":133914},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3839":79672,"_33145":79649,"_22633":133916,"_5":15597,"_29869":133868,"_3292":133917},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3839":79673,"_33145":79649,"_22633":133919,"_5":15597,"_29869":133868,"_3292":133920},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3839":79674,"_33145":79649,"_22633":133922,"_5":15597,"_29869":133868,"_3292":133923},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3839":79675,"_33145":79649,"_22633":133925,"_5":15597,"_29869":133868,"_3292":133926},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3839":79676,"_33145":79649,"_22633":133928,"_5":15597,"_29869":133868,"_3292":133929},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3839":79677,"_33145":79649,"_22633":133931,"_5":15597,"_29869":133872,"_3292":133932},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3839":79678,"_33145":79649,"_22633":133934,"_5":15597,"_29869":133872,"_3292":133935},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3839":79679,"_33145":79649,"_22633":133937,"_5":15597,"_29869":133872,"_3292":133938},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3839":79680,"_33145":79649,"_22633":133940,"_5":15597,"_29869":133872,"_3292":133941},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3839":79681,"_33145":79649,"_22633":133943,"_5":15597,"_29869":133872,"_3292":133944},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3839":79682,"_33145":79649,"_22633":133946,"_5":15597,"_29869":133872,"_3292":133947},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3839":79683,"_33145":79649,"_22633":133949,"_5":15597,"_29869":133872,"_3292":133950},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3839":79684,"_33145":79649,"_22633":133952,"_5":15597,"_29869":133876,"_3292":133953},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3839":79685,"_33145":79649,"_22633":133955,"_5":15597,"_29869":133880,"_3292":133956},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3839":79686,"_33145":79649,"_22633":133958,"_5":15597,"_29869":133880,"_3292":133959},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3839":79687,"_33145":79649,"_22633":133961,"_5":15597,"_29869":133880,"_3292":133962},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3839":79688,"_33145":79649,"_22633":133964,"_5":15597,"_29869":133880,"_3292":133965},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3839":79689,"_33145":79649,"_22633":133967,"_5":15597,"_29869":133880,"_3292":133968},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3839":79690,"_33145":79649,"_22633":133970,"_5":15597,"_29869":133880,"_3292":133971},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3839":79691,"_33145":79649,"_22633":133973,"_5":15597,"_29869":133880,"_3292":133974},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3839":79692,"_33145":79692,"_5":15996,"_3292":133976,"_33551":133977,"_22633":133978,"_29869":79692},"Listas de revocación (CRL)",[54324,128959,59794,133465],[],{"_3839":79693,"_33145":79692,"_22633":133980,"_5":15597,"_29869":79692,"_3292":133981},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3839":79694,"_33145":79692,"_5":33548,"_22633":133983,"_29869":133984,"_3292":133985},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3839":79695,"_33145":79692,"_5":33548,"_22633":133987,"_29869":133988,"_3292":133989},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3839":79696,"_33145":79692,"_5":33548,"_22633":133991,"_29869":133992,"_3292":133993},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3839":79697,"_33145":79692,"_5":33548,"_22633":133995,"_29869":133996,"_3292":133997},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3839":79698,"_33145":79692,"_5":33548,"_22633":133999,"_29869":134000,"_3292":134001},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3839":79699,"_33145":79692,"_5":33548,"_22633":134003,"_29869":134004,"_3292":134005},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3839":79700,"_33145":79692,"_5":33548,"_22633":134007,"_29869":134008,"_3292":134009},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#errores-frecuentes-del-rol-va","Errores frecuentes del rol VA",{"_3839":79701,"_33145":79692,"_5":33548,"_22633":134011,"_29869":134012,"_3292":134013},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3839":79702,"_33145":79692,"_5":33548,"_22633":134015,"_29869":134016,"_3292":134017},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#referencias","Referencias",{"_3839":79703,"_33145":79692,"_22633":134019,"_5":15597,"_29869":79692,"_3292":134020},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3839":79704,"_33145":79692,"_22633":134022,"_5":15597,"_29869":133984,"_3292":134023},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3839":79705,"_33145":79692,"_22633":134025,"_5":15597,"_29869":133984,"_3292":134026},[],"Campo de `crl_options`",{"_3839":79706,"_33145":79692,"_22633":134028,"_5":15597,"_29869":133984,"_3292":130497},[],{"_3839":79707,"_33145":79692,"_22633":134030,"_5":15597,"_29869":133984,"_3292":134031},[],"Valor inicial del backend",{"_3839":79708,"_33145":79692,"_22633":134033,"_5":15597,"_29869":133984,"_3292":60998},[],{"_3839":79709,"_33145":79692,"_22633":134035,"_5":15597,"_29869":133984,"_3292":134036},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3839":79710,"_33145":79692,"_22633":134038,"_5":15597,"_29869":133984,"_3292":134039},[],"7 días.",{"_3839":79711,"_33145":79692,"_22633":134041,"_5":15597,"_29869":133984,"_3292":61007},[],{"_3839":79712,"_33145":79692,"_22633":134043,"_5":15597,"_29869":133984,"_3292":134044},[],"Se guarda y se devuelve por la API, pero la VA no lo utiliza: la renovación programada no depende de él (consulta Regeneración periódica y automática).",{"_3839":79713,"_33145":79692,"_22633":134046,"_5":15597,"_29869":133984,"_3292":134047},[],"6 días y 23 horas.",{"_3839":79714,"_33145":79692,"_22633":134049,"_5":15597,"_29869":133984,"_3292":61016},[],{"_3839":79715,"_33145":79692,"_22633":134051,"_5":15597,"_29869":133984,"_3292":134052},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3839":79716,"_33145":79692,"_22633":134054,"_5":15597,"_29869":133984,"_3292":61022},[],{"_3839":79717,"_33145":79692,"_22633":134056,"_5":15597,"_29869":133984,"_3292":61025},[],{"_3839":79718,"_33145":79692,"_22633":134058,"_5":15597,"_29869":133984,"_3292":134059},[],"Número de serie del certificado existente que firma la CRL.",{"_3839":79719,"_33145":79692,"_22633":134061,"_5":15597,"_29869":133984,"_3292":134062},[],"Número de serie del certificado actual de la CA.",{"_3839":79720,"_33145":79692,"_22633":134064,"_5":15597,"_29869":133984,"_3292":134065},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3839":79721,"_33145":79692,"_22633":134067,"_5":15597,"_29869":133984,"_3292":134068},[],"Al reemitir una CA, el rol sigue apuntando al certificado anterior. Las CRL siguen siendo válidas porque ambos certificados comparten sujeto y clave, pero el certificado anterior no puede eliminarse mientras el rol lo use. Para retirarlo, actualiza el firmante del rol.",{"_3839":79722,"_33145":79692,"_22633":134070,"_5":15597,"_29869":133984,"_3292":134071},[],"Al eliminar una CA, su rol VA se conserva y no puede borrarse por API. Si no queda ninguna otra CA con el mismo SKI, el rol puede consultarse pero cualquier `PUT` devuelve 404, y el trabajo de renovación registra un aviso en cada ciclo porque ya no encuentra la CA. La API no ofrece salida; solo se corrige editando la base de datos. Si queda otra CA con ese SKI, el rol sigue siendo editable (consulta CAs que comparten clave). Ajusta validez y firmante antes de eliminar la CA.",{"_3839":79723,"_33145":79692,"_22633":134073,"_5":15597,"_29869":133984,"_3292":134074},[],"Una CA cuyo certificado no tiene `cRLSign` no puede generar su CRL ni editar su rol (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y asígnalo como firmante con `PUT`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original.",{"_3839":79724,"_33145":79692,"_22633":134076,"_5":15597,"_29869":133984,"_3292":134077},[],"El `PUT` valida siempre el firmante, aunque la petición no lo cambie. Si el firmante guardado ya no es válido, no se puede modificar ningún campo del rol, ni siquiera la validez, hasta asignar uno válido.",{"_3839":79725,"_33145":79692,"_22633":134079,"_5":15597,"_29869":133984,"_3292":134080},[],"Compartir una clave entre CA puede impedir la validación de las CRL. Consulta CAs que comparten clave.",{"_3839":79726,"_33145":79692,"_22633":134082,"_5":15597,"_29869":133984,"_3292":134083},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3839":79727,"_33145":79692,"_22633":134085,"_5":15597,"_29869":133988,"_3292":134086},[],"La VA identifica cada CRL por el SKI de la CA, y el SKI se deriva de su clave. Dos CAs con la misma clave tienen el mismo SKI y comparten un único rol VA y una única CRL. Ocurre al crear una CA sobre una clave ya existente del KMS, o al importar una CA cuyo certificado declara un SKI en uso. Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. El rol lo crea la primera CA y las demás lo conservan.",{"_3839":79728,"_33145":79692,"_22633":134088,"_5":15597,"_29869":133988,"_3292":134089},[],"Los certificados de todas ellas apuntan a `/crl/{ski}`, pero la lista publicada tiene como emisor a la primera CA y solo incluye sus revocaciones. Un verificador compara el emisor de la CRL con el del certificado que valida (RFC 5280, §6.3.2) y rechaza la lista si no coinciden. Según su política, el certificado queda bloqueado (*hard-fail*) o se acepta aunque esté revocado (*soft-fail*). Las revocaciones de las CAs secundarias no aparecen en ninguna lista.",{"_3839":79729,"_33145":79692,"_22633":134091,"_5":15597,"_29869":133988,"_3292":134092},[],"Si la primera CA se elimina, la generación de CRL de la restante falla porque el firmante configurado ya no corresponde a una CA con ese nombre. Hasta que se actualice el firmante del rol a un certificado de la CA restante, se sigue sirviendo la última lista publicada hasta que venza (7 días por defecto).",{"_3839":79730,"_33145":79692,"_22633":134094,"_5":15597,"_29869":133988,"_3292":134095},[],"Antes de actualizar, revisa las CAs que comparten clave. Para detectar el problema, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos. Una CA importada con un SKI ya en uso no sustituye a la existente como emisora de la CRL, porque el emisor se resuelve a partir del firmante del rol. Sin embargo, sus propios certificados apuntan a esa misma URL y sus revocaciones no se publican. Hasta que Lamassu rechace estas importaciones, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión, así que tampoco reutilices claves entre CAs. Una CRL por CA y el rechazo de importaciones cuyo SKI colisiona con el de una CA existente están planteados en lamassuiot#834, y ninguno está implementado todavía.",{"_3839":79731,"_33145":79692,"_22633":134097,"_5":15597,"_29869":133992,"_3292":134098},[],"El trabajo programado de la VA revisa todos los roles en cada ejecución y solicita otra lista cuando a `latest_crl` le queda menos validez que el intervalo entre ejecuciones. La frecuencia se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. `refresh_interval` no interviene. Mantén `validity` claramente por encima del intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3839":79732,"_33145":79692,"_22633":134100,"_5":15597,"_29869":133992,"_3292":134101},[],"Si la generación falla (por ejemplo, por un rol sin CA o un firmante inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ski>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3839":79733,"_33145":79692,"_22633":134103,"_5":15597,"_29869":133992,"_3292":134104},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla (rol inexistente, firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3839":79734,"_33145":79692,"_22633":134106,"_5":15597,"_29869":133992,"_3292":134107},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3839":79735,"_33145":79692,"_22633":134109,"_5":15597,"_29869":133996,"_3292":134110},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3839":79736,"_33145":79692,"_22633":134112,"_5":15597,"_29869":133996,"_3292":134113},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3839":79737,"_33145":79692,"_22633":134115,"_5":15597,"_29869":134000,"_3292":134116},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3839":79738,"_33145":79692,"_22633":134118,"_5":15597,"_29869":134000,"_3292":134119},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3839":79739,"_33145":79692,"_22633":134121,"_5":15597,"_29869":134000,"_3292":134122},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3839":79740,"_33145":79692,"_22633":134124,"_5":15597,"_29869":134000,"_3292":134125},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3839":79741,"_33145":79692,"_22633":134127,"_5":15597,"_29869":134000,"_3292":134128},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3839":79742,"_33145":79692,"_22633":134130,"_5":15597,"_29869":134004,"_3292":134131},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3839":79743,"_33145":79692,"_22633":134133,"_5":15597,"_29869":134004,"_3292":130686},[],{"_3839":79744,"_33145":79692,"_22633":134135,"_5":15597,"_29869":134004,"_3292":134136},[],"Path relativo",{"_3839":79745,"_33145":79692,"_22633":134138,"_5":15597,"_29869":134004,"_3292":128719},[],{"_3839":79746,"_33145":79692,"_22633":134140,"_5":15597,"_29869":134004,"_3292":61110},[],{"_3839":79747,"_33145":79692,"_22633":134142,"_5":15597,"_29869":134004,"_3292":61113},[],{"_3839":79748,"_33145":79692,"_22633":134144,"_5":15597,"_29869":134004,"_3292":134145},[],"Consultar `crl_options` y `latest_crl`.",{"_3839":79749,"_33145":79692,"_22633":134147,"_5":15597,"_29869":134004,"_3292":61119},[],{"_3839":79750,"_33145":79692,"_22633":134149,"_5":15597,"_29869":134004,"_3292":61113},[],{"_3839":79751,"_33145":79692,"_22633":134151,"_5":15597,"_29869":134004,"_3292":134152},[],"Sustituir la configuración de CRL.",{"_3839":79752,"_33145":79692,"_22633":134154,"_5":15597,"_29869":134004,"_3292":134155},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3839":79753,"_33145":79692,"_22633":134157,"_5":15597,"_29869":134004,"_3292":134158},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3839":79754,"_33145":79692,"_22633":134160,"_5":15597,"_29869":134008,"_3292":134161},[],"Síntoma",{"_3839":79755,"_33145":79692,"_22633":134163,"_5":15597,"_29869":134008,"_3292":134164},[],"Causa",{"_3839":79756,"_33145":79692,"_22633":134166,"_5":15597,"_29869":134008,"_3292":134167},[],"Acción",{"_3839":79757,"_33145":79692,"_22633":134169,"_5":15597,"_29869":134008,"_3292":134170},[],"`PUT /v1/roles/{ca-ski}` devuelve 404 y `GET` devuelve 200.",{"_3839":79758,"_33145":79692,"_22633":134172,"_5":15597,"_29869":134008,"_3292":134173},[],"Se eliminó la CA del rol y no queda otra con el mismo SKI.",{"_3839":79759,"_33145":79692,"_22633":134175,"_5":15597,"_29869":134008,"_3292":134176},[],"No hay salida por API; requiere intervención en la base de datos. Evítalo ajustando el rol antes de eliminar la CA.",{"_3839":79760,"_33145":79692,"_22633":134178,"_5":15597,"_29869":134008,"_3292":134179},[],"`PUT` devuelve 400.",{"_3839":79761,"_33145":79692,"_22633":134181,"_5":15597,"_29869":134008,"_3292":134182},[],"El firmante no tiene `cRLSign`, o su sujeto y su clave no coinciden con ninguna CA de ese SKI (por ejemplo, tras eliminar la primera de dos CAs que comparten clave).",{"_3839":79762,"_33145":79692,"_22633":134184,"_5":15597,"_29869":134008,"_3292":134185},[],"Asigna con `PUT` el número de serie de un certificado válido de la CA restante.",{"_3839":79763,"_33145":79692,"_22633":134187,"_5":15597,"_29869":134008,"_3292":134188},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3839":79764,"_33145":79692,"_22633":134190,"_5":15597,"_29869":134008,"_3292":134191},[],"`crl_options.subject_key_id_signer` se sustituyó por `signer_certificate_serial_number`, que es obligatorio.",{"_3839":79765,"_33145":79692,"_22633":134193,"_5":15597,"_29869":134008,"_3292":134194},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3839":79766,"_33145":79692,"_22633":134196,"_5":15597,"_29869":134008,"_3292":134197},[],"La CRL no cambia tras revocar un certificado.",{"_3839":79767,"_33145":79692,"_22633":134199,"_5":15597,"_29869":134008,"_3292":134200},[],"`regenerate_on_revoke` es `false`, o el evento falló por falta de rol o por un firmante inválido.",{"_3839":79768,"_33145":79692,"_22633":134202,"_5":15597,"_29869":134008,"_3292":134203},[],"Revisa los logs de la VA y la cola de eventos fallidos; corrige el firmante.",{"_3839":79769,"_33145":79692,"_22633":134205,"_5":15597,"_29869":134008,"_3292":134206},[],"Un verificador rechaza la CRL por el emisor.",{"_3839":79770,"_33145":79692,"_22633":134208,"_5":15597,"_29869":134008,"_3292":134209},[],"Varias CAs comparten SKI.",{"_3839":79771,"_33145":79692,"_22633":134211,"_5":15597,"_29869":134008,"_3292":134212},[],"Consulta CAs que comparten clave.",{"_3839":79772,"_33145":79692,"_22633":134214,"_5":15597,"_29869":134012,"_3292":134215},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3839":79773,"_33145":79692,"_22633":134217,"_5":15597,"_29869":134016,"_3292":134218},[],"RFC 5280: perfil X.509 y CRL.",{"_3839":79774,"_33145":79692,"_22633":134220,"_5":15597,"_29869":134016,"_3292":61193},[],{"_3839":79775,"_33145":79692,"_22633":134222,"_5":15597,"_29869":134016,"_3292":61196},[],{"_3839":79776,"_33145":79692,"_22633":134224,"_5":15597,"_29869":134016,"_3292":134225},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3839":79777,"_33145":79692,"_22633":134227,"_5":15597,"_29869":134016,"_3292":134228},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3839":79778,"_33145":79778,"_5":15996,"_3292":134230,"_33551":134231,"_22633":134232,"_29869":79778},"Claves y motores criptográficos",[54324,128959,59794,132834],[],{"_3839":79779,"_33145":79778,"_22633":134234,"_5":15597,"_29869":79778,"_3292":134235},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3839":79780,"_33145":79778,"_5":33548,"_22633":134237,"_29869":134238,"_3292":134239},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3839":79781,"_33145":79778,"_5":33548,"_22633":134241,"_29869":134242,"_3292":134243},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3839":79782,"_33145":79778,"_5":33548,"_22633":134245,"_29869":134246,"_3292":61221},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#file-system",{"_3839":79783,"_33145":79778,"_5":33548,"_22633":134248,"_29869":134249,"_3292":61225},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#hashicorp-vault",{"_3839":79784,"_33145":79778,"_5":33548,"_22633":134251,"_29869":134252,"_3292":61229},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#aws-secrets-manager",{"_3839":79785,"_33145":79778,"_5":33548,"_22633":134254,"_29869":134255,"_3292":61233},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#aws-kms",{"_3839":79786,"_33145":79778,"_5":33548,"_22633":134257,"_29869":134258,"_3292":61237},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#pkcs11",{"_3839":79787,"_33145":79778,"_5":33548,"_22633":134260,"_29869":134261,"_3292":61241},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#azure-key-vault",{"_3839":79788,"_33145":79778,"_5":33548,"_22633":134263,"_29869":134264,"_3292":134265},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3839":79789,"_33145":79778,"_5":33548,"_22633":134267,"_29869":134268,"_3292":134269},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3839":79790,"_33145":79778,"_5":33548,"_22633":134271,"_29869":134272,"_3292":134273},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3839":79791,"_33145":79778,"_5":33548,"_22633":134275,"_29869":134276,"_3292":134277},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3839":79792,"_33145":79778,"_5":33548,"_22633":134279,"_29869":134280,"_3292":134281},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3839":79793,"_33145":79778,"_5":33548,"_22633":134283,"_29869":134284,"_3292":134285},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3839":79794,"_33145":79778,"_5":33548,"_22633":134287,"_29869":134288,"_3292":134289},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3839":79795,"_33145":79778,"_5":33548,"_22633":134291,"_29869":134292,"_3292":61273},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#sign",{"_3839":79796,"_33145":79778,"_5":33548,"_22633":134294,"_29869":134295,"_3292":61277},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#verify",{"_3839":79797,"_33145":79778,"_5":33548,"_22633":134297,"_29869":134298,"_3292":134299},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3839":79798,"_33145":79778,"_5":33548,"_22633":134301,"_29869":134302,"_3292":134303},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3839":79799,"_33145":79778,"_5":33548,"_22633":134305,"_29869":134306,"_3292":134307},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3839":79800,"_33145":79778,"_22633":134309,"_5":15597,"_29869":79778,"_3292":134310},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3839":79801,"_33145":79778,"_22633":134312,"_5":15597,"_29869":79778,"_3292":134313},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3839":79802,"_33145":79778,"_22633":134315,"_5":15597,"_29869":134238,"_3292":134316},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3839":79803,"_33145":79778,"_22633":134318,"_5":15597,"_29869":134238,"_3292":134319},[],"En la práctica, permite:",{"_3839":79804,"_33145":79778,"_22633":134321,"_5":15597,"_29869":134238,"_3292":134322},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3839":79805,"_33145":79778,"_22633":134324,"_5":15597,"_29869":134238,"_3292":134325},[],"Importar claves creadas externamente.",{"_3839":79806,"_33145":79778,"_22633":134327,"_5":15597,"_29869":134238,"_3292":134328},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3839":79807,"_33145":79778,"_22633":134330,"_5":15597,"_29869":134238,"_3292":134331},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3839":79808,"_33145":79778,"_22633":134333,"_5":15597,"_29869":134242,"_3292":134334},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3839":79809,"_33145":79778,"_22633":134336,"_5":15597,"_29869":134242,"_3292":134337},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3839":79810,"_33145":79778,"_22633":134339,"_5":15597,"_29869":134242,"_3292":134340},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3839":79811,"_33145":79778,"_22633":134342,"_5":15597,"_29869":134246,"_3292":134343},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3839":79812,"_33145":79778,"_22633":134345,"_5":15597,"_29869":134249,"_3292":134346},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3839":79813,"_33145":79778,"_22633":134348,"_5":15597,"_29869":134249,"_3292":134349},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3839":79814,"_33145":79778,"_22633":134351,"_5":15597,"_29869":134252,"_3292":134352},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3839":79815,"_33145":79778,"_22633":134354,"_5":15597,"_29869":134255,"_3292":134355},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3839":79816,"_33145":79778,"_22633":134357,"_5":15597,"_29869":134258,"_3292":134358},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3839":79817,"_33145":79778,"_22633":134360,"_5":15597,"_29869":134261,"_3292":134361},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3839":79818,"_33145":79778,"_22633":134363,"_5":15597,"_29869":134261,"_3292":134364},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3839":79819,"_33145":79778,"_22633":134366,"_5":15597,"_29869":134261,"_3292":134367},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3839":79820,"_33145":79778,"_22633":134369,"_5":15597,"_29869":134261,"_3292":134370},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3839":79821,"_33145":79778,"_22633":134372,"_5":15597,"_29869":134264,"_3292":134373},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3839":79822,"_33145":79778,"_22633":134375,"_5":15597,"_29869":134264,"_3292":134376},[],"La tabla incluye los siguientes campos:",{"_3839":79823,"_33145":79778,"_22633":134378,"_5":15597,"_29869":134264,"_3292":134379},[],"**Name**: nombre descriptivo de la clave.",{"_3839":79824,"_33145":79778,"_22633":134381,"_5":15597,"_29869":134264,"_3292":134382},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3839":79825,"_33145":79778,"_22633":134384,"_5":15597,"_29869":134264,"_3292":134385},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3839":79826,"_33145":79778,"_22633":134387,"_5":15597,"_29869":134264,"_3292":134388},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3839":79827,"_33145":79778,"_22633":134390,"_5":15597,"_29869":134264,"_3292":134391},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3839":79828,"_33145":79778,"_22633":134393,"_5":15597,"_29869":134264,"_3292":134394},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3839":79829,"_33145":79778,"_22633":134396,"_5":15597,"_29869":134264,"_3292":134397},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3839":79830,"_33145":79778,"_22633":134399,"_5":15597,"_29869":134264,"_3292":134400},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3839":79831,"_33145":79778,"_22633":134402,"_5":15597,"_29869":134264,"_3292":134403},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3839":79832,"_33145":79778,"_22633":134405,"_5":15597,"_29869":134264,"_3292":134406},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3839":79833,"_33145":79778,"_22633":134408,"_5":15597,"_29869":134264,"_3292":134409},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3839":79834,"_33145":79778,"_22633":134411,"_5":15597,"_29869":134264,"_3292":134412},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3839":79835,"_33145":79778,"_22633":134414,"_5":15597,"_29869":134264,"_3292":134415},[],"**Delete Key** para eliminar la clave del sistema.",{"_3839":79836,"_33145":79778,"_22633":134417,"_5":15597,"_29869":134268,"_3292":134418},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3839":79837,"_33145":79778,"_22633":134420,"_5":15597,"_29869":134272,"_3292":134421},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3839":79838,"_33145":79778,"_22633":134423,"_5":15597,"_29869":134272,"_3292":134424},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3839":79839,"_33145":79778,"_22633":134426,"_5":15597,"_29869":134272,"_3292":134427},[],"**Key Name**: nombre único y descriptivo.",{"_3839":79840,"_33145":79778,"_22633":134429,"_5":15597,"_29869":134272,"_3292":134430},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3839":79841,"_33145":79778,"_22633":134432,"_5":15597,"_29869":134272,"_3292":134433},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3839":79842,"_33145":79778,"_22633":134435,"_5":15597,"_29869":134272,"_3292":134436},[],"**Tags**: metadatos para clasificar la clave.",{"_3839":79843,"_33145":79778,"_22633":134438,"_5":15597,"_29869":134272,"_3292":134439},[],"**Metadata**: información adicional para usos avanzados.",{"_3839":79844,"_33145":79778,"_22633":134441,"_5":15597,"_29869":134276,"_3292":134442},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3839":79845,"_33145":79778,"_22633":134444,"_5":15597,"_29869":134276,"_3292":134445},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3839":79846,"_33145":79778,"_22633":134447,"_5":15597,"_29869":134276,"_3292":134448},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3839":79847,"_33145":79778,"_22633":134450,"_5":15597,"_29869":134276,"_3292":134451},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3839":79848,"_33145":79778,"_22633":134453,"_5":15597,"_29869":134276,"_3292":134454},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3839":79849,"_33145":79778,"_22633":134456,"_5":15597,"_29869":134276,"_3292":134457},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3839":79850,"_33145":79778,"_22633":134459,"_5":15597,"_29869":134276,"_3292":134460},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3839":79851,"_33145":79778,"_22633":134462,"_5":15597,"_29869":134276,"_3292":134463},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3839":79852,"_33145":79778,"_22633":134465,"_5":15597,"_29869":134276,"_3292":134466},[],"**Metadata**: información adicional opcional.",{"_3839":79853,"_33145":79778,"_22633":134468,"_5":15597,"_29869":134276,"_3292":134469},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3839":79854,"_33145":79778,"_22633":134471,"_5":15597,"_29869":134276,"_3292":134472},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3839":79855,"_33145":79778,"_22633":134474,"_5":15597,"_29869":134280,"_3292":134475},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3839":79856,"_33145":79778,"_22633":134477,"_5":15597,"_29869":134284,"_3292":134478},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3839":79857,"_33145":79778,"_22633":134480,"_5":15597,"_29869":134284,"_3292":134481},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3839":79858,"_33145":79778,"_22633":134483,"_5":15597,"_29869":134284,"_3292":134484},[],"**Key Name**: nombre descriptivo.",{"_3839":79859,"_33145":79778,"_22633":134486,"_5":15597,"_29869":134284,"_3292":134487},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3839":79860,"_33145":79778,"_22633":134489,"_5":15597,"_29869":134284,"_3292":134490},[],"**Tags**: etiquetas asociadas.",{"_3839":79861,"_33145":79778,"_22633":134492,"_5":15597,"_29869":134284,"_3292":134493},[],"**Aliases**: nombres alternativos.",{"_3839":79862,"_33145":79778,"_22633":134495,"_5":15597,"_29869":134284,"_3292":134496},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3839":79863,"_33145":79778,"_22633":134498,"_5":15597,"_29869":134284,"_3292":134499},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3839":79864,"_33145":79778,"_22633":134501,"_5":15597,"_29869":134284,"_3292":134502},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3839":79865,"_33145":79778,"_22633":134504,"_5":15597,"_29869":134284,"_3292":134505},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3839":79866,"_33145":79778,"_22633":134507,"_5":15597,"_29869":134288,"_3292":134508},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3839":79867,"_33145":79778,"_22633":134510,"_5":15597,"_29869":134288,"_3292":134511},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3839":79868,"_33145":79778,"_22633":134513,"_5":15597,"_29869":134288,"_3292":134514},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3839":79869,"_33145":79778,"_22633":134516,"_5":15597,"_29869":134292,"_3292":134517},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3839":79870,"_33145":79778,"_22633":134519,"_5":15597,"_29869":134292,"_3292":134520},[],"Campos principales:",{"_3839":79871,"_33145":79778,"_22633":134522,"_5":15597,"_29869":134292,"_3292":134523},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3839":79872,"_33145":79778,"_22633":134525,"_5":15597,"_29869":134292,"_3292":134526},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3839":79873,"_33145":79778,"_22633":134528,"_5":15597,"_29869":134292,"_3292":134529},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3839":79874,"_33145":79778,"_22633":134531,"_5":15597,"_29869":134292,"_3292":134532},[],"**Message**: contenido que se va a firmar.",{"_3839":79875,"_33145":79778,"_22633":134534,"_5":15597,"_29869":134292,"_3292":134535},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3839":79876,"_33145":79778,"_22633":134537,"_5":15597,"_29869":134295,"_3292":134538},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3839":79877,"_33145":79778,"_22633":134540,"_5":15597,"_29869":134295,"_3292":134520},[],{"_3839":79878,"_33145":79778,"_22633":134542,"_5":15597,"_29869":134295,"_3292":134543},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3839":79879,"_33145":79778,"_22633":134545,"_5":15597,"_29869":134295,"_3292":134546},[],"**Message Type**: `Raw` o `Digest`.",{"_3839":79880,"_33145":79778,"_22633":134548,"_5":15597,"_29869":134295,"_3292":134549},[],"**Payload Encoding**: codificación del mensaje.",{"_3839":79881,"_33145":79778,"_22633":134551,"_5":15597,"_29869":134295,"_3292":134552},[],"**Message**: mensaje original o hash.",{"_3839":79882,"_33145":79778,"_22633":134554,"_5":15597,"_29869":134295,"_3292":134555},[],"**Signature**: firma que se desea comprobar.",{"_3839":79883,"_33145":79778,"_22633":134557,"_5":15597,"_29869":134295,"_3292":134558},[],"**Result**: indicador del resultado de la validación.",{"_3839":79884,"_33145":79778,"_22633":134560,"_5":15597,"_29869":134298,"_3292":134561},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3839":79885,"_33145":79778,"_22633":134563,"_5":15597,"_29869":134298,"_3292":134564},[],"Este flujo es útil para:",{"_3839":79886,"_33145":79778,"_22633":134566,"_5":15597,"_29869":134298,"_3292":134567},[],"Solicitar certificados a una CA externa.",{"_3839":79887,"_33145":79778,"_22633":134569,"_5":15597,"_29869":134298,"_3292":134570},[],"Renovar una identidad manteniendo la misma clave.",{"_3839":79888,"_33145":79778,"_22633":134572,"_5":15597,"_29869":134298,"_3292":134573},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3839":79889,"_33145":79778,"_22633":134575,"_5":15597,"_29869":134298,"_3292":134576},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3839":79890,"_33145":79778,"_22633":134578,"_5":15597,"_29869":134298,"_3292":134579},[],"**Organization (O)**: organización o empresa.",{"_3839":79891,"_33145":79778,"_22633":134581,"_5":15597,"_29869":134298,"_3292":134582},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3839":79892,"_33145":79778,"_22633":134584,"_5":15597,"_29869":134298,"_3292":134585},[],"**Country (C)**: código de país de dos letras.",{"_3839":79893,"_33145":79778,"_22633":134587,"_5":15597,"_29869":134298,"_3292":134588},[],"**State / Province (ST)**: estado o provincia.",{"_3839":79894,"_33145":79778,"_22633":134590,"_5":15597,"_29869":134298,"_3292":134591},[],"**Locality (L)**: ciudad o localidad.",{"_3839":79895,"_33145":79778,"_22633":134593,"_5":15597,"_29869":134298,"_3292":134594},[],"**Email Address**: correo de contacto.",{"_3839":79896,"_33145":79778,"_22633":134596,"_5":15597,"_29869":134298,"_3292":134597},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3839":79897,"_33145":79778,"_22633":134599,"_5":15597,"_29869":134298,"_3292":134600},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3839":79898,"_33145":79778,"_22633":134602,"_5":15597,"_29869":134302,"_3292":134603},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3839":79899,"_33145":79778,"_22633":134605,"_5":15597,"_29869":134302,"_3292":134606},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3839":79900,"_33145":79778,"_22633":134608,"_5":15597,"_29869":134306,"_3292":134609},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3839":79901,"_33145":79778,"_22633":134611,"_5":15597,"_29869":134306,"_3292":134612},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves. La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3839":79902,"_33145":79902,"_5":15996,"_3292":134614,"_33551":134615,"_22633":134616,"_29869":79902},"Validación online con OCSP",[54324,128959,59794,133465],[],{"_3839":79903,"_33145":79902,"_22633":134618,"_5":15597,"_29869":79902,"_3292":134619},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3839":79904,"_33145":79902,"_5":33548,"_22633":134621,"_29869":134622,"_3292":134623},[],"/docs/pr-preview/pr-58/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3839":79905,"_33145":79902,"_5":33548,"_22633":134625,"_29869":134626,"_3292":134627},[],"/docs/pr-preview/pr-58/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3839":79906,"_33145":79902,"_5":33548,"_22633":134629,"_29869":134630,"_3292":134631},[],"/docs/pr-preview/pr-58/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3839":79907,"_33145":79902,"_5":33548,"_22633":134633,"_29869":134634,"_3292":134635},[],"/docs/pr-preview/pr-58/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3839":79908,"_33145":79902,"_5":33548,"_22633":134637,"_29869":134638,"_3292":134639},[],"/docs/pr-preview/pr-58/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3839":79909,"_33145":79902,"_5":33548,"_22633":134641,"_29869":134642,"_3292":134017},[],"/docs/pr-preview/pr-58/es/platform/pki/ocsp#referencias",{"_3839":79910,"_33145":79902,"_22633":134644,"_5":15597,"_29869":79902,"_3292":134645},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3839":79911,"_33145":79902,"_22633":134647,"_5":15597,"_29869":134622,"_3292":134648},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3839":79912,"_33145":79902,"_22633":134650,"_5":15597,"_29869":134622,"_3292":134651},[],"Estado del registro",{"_3839":79913,"_33145":79902,"_22633":134653,"_5":15597,"_29869":134622,"_3292":134654},[],"Respuesta firmada",{"_3839":79914,"_33145":79902,"_22633":134656,"_5":15597,"_29869":134622,"_3292":58931},[],{"_3839":79915,"_33145":79902,"_22633":134658,"_5":15597,"_29869":134622,"_3292":61641},[],{"_3839":79916,"_33145":79902,"_22633":134660,"_5":15597,"_29869":134622,"_3292":58948},[],{"_3839":79917,"_33145":79902,"_22633":134662,"_5":15597,"_29869":134622,"_3292":134663},[],"`Revoked`, con razón y fecha de revocación.",{"_3839":79918,"_33145":79902,"_22633":134665,"_5":15597,"_29869":134622,"_3292":134666},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3839":79919,"_33145":79902,"_22633":134668,"_5":15597,"_29869":134622,"_3292":134669},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3839":79920,"_33145":79902,"_22633":134671,"_5":15597,"_29869":134622,"_3292":134672},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3839":79921,"_33145":79902,"_22633":134674,"_5":15597,"_29869":134622,"_3292":134675},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3839":79922,"_33145":79902,"_22633":134677,"_5":15597,"_29869":134622,"_3292":134678},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3839":79923,"_33145":79902,"_22633":134680,"_5":15597,"_29869":134626,"_3292":134681},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3839":79924,"_33145":79902,"_22633":134683,"_5":15597,"_29869":134626,"_3292":134684},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3839":79925,"_33145":79902,"_22633":134686,"_5":15597,"_29869":134630,"_3292":134687},[],"El servicio acepta:",{"_3839":79926,"_33145":79902,"_22633":134689,"_5":15597,"_29869":134630,"_3292":130686},[],{"_3839":79927,"_33145":79902,"_22633":134691,"_5":15597,"_29869":134630,"_3292":134692},[],"Ruta del servicio VA",{"_3839":79928,"_33145":79902,"_22633":134694,"_5":15597,"_29869":134630,"_3292":134695},[],"Formato",{"_3839":79929,"_33145":79902,"_22633":134697,"_5":15597,"_29869":134630,"_3292":61681},[],{"_3839":79930,"_33145":79902,"_22633":134699,"_5":15597,"_29869":134630,"_3292":61684},[],{"_3839":79931,"_33145":79902,"_22633":134701,"_5":15597,"_29869":134630,"_3292":134702},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3839":79932,"_33145":79902,"_22633":134704,"_5":15597,"_29869":134630,"_3292":61110},[],{"_3839":79933,"_33145":79902,"_22633":134706,"_5":15597,"_29869":134630,"_3292":61692},[],{"_3839":79934,"_33145":79902,"_22633":134708,"_5":15597,"_29869":134630,"_3292":134709},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3839":79935,"_33145":79902,"_22633":134711,"_5":15597,"_29869":134630,"_3292":134712},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3839":79936,"_33145":79902,"_22633":134714,"_5":15597,"_29869":134634,"_3292":134715},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3839":79937,"_33145":79902,"_22633":134717,"_5":15597,"_29869":134634,"_3292":134718},[],"Genera la solicitud:",{"_3839":79938,"_33145":79902,"_22633":134720,"_5":15597,"_29869":134634,"_3292":134721},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3839":79939,"_33145":79902,"_22633":134723,"_5":15597,"_29869":134634,"_3292":134724},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3839":79940,"_33145":79902,"_22633":134726,"_5":15597,"_29869":134634,"_3292":134727},[],"Verifica el DER recibido:",{"_3839":79941,"_33145":79902,"_22633":134729,"_5":15597,"_29869":134634,"_3292":134730},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3839":79942,"_33145":79902,"_22633":134732,"_5":15597,"_29869":134638,"_3292":134733},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3839":79943,"_33145":79902,"_22633":134735,"_5":15597,"_29869":134638,"_3292":134736},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3839":79944,"_33145":79902,"_22633":134738,"_5":15597,"_29869":134642,"_3292":61725},[],{"_3839":79945,"_33145":79902,"_22633":134740,"_5":15597,"_29869":134642,"_3292":61728},[],{"_3839":79946,"_33145":79902,"_22633":134742,"_5":15597,"_29869":134642,"_3292":134743},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3839":79947,"_33145":79902,"_22633":134745,"_5":15597,"_29869":134642,"_3292":134228},[],{"_3839":79948,"_33145":79948,"_5":15996,"_3292":59794,"_33551":134747,"_22633":134748,"_29869":79948},[54324,128959,59794],[],{"_3839":79949,"_33145":79948,"_22633":134750,"_5":15597,"_29869":79948,"_3292":134751},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3839":79950,"_33145":79948,"_5":33548,"_22633":134753,"_29869":134754,"_3292":132160},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#empieza-aquí",{"_3839":79951,"_33145":79948,"_5":33548,"_22633":134756,"_29869":134757,"_3292":134758},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3839":79952,"_33145":79948,"_5":33548,"_22633":134760,"_29869":134761,"_3292":132680},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#capacidades-principales",{"_3839":79953,"_33145":79948,"_5":33548,"_22633":134763,"_29869":134764,"_3292":132684},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3839":79954,"_33145":79948,"_5":33548,"_22633":134766,"_29869":134767,"_3292":132688},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3839":79955,"_33145":79948,"_5":33548,"_22633":134769,"_29869":134770,"_3292":132692},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#emite-y-controla-certificados",{"_3839":79956,"_33145":79948,"_5":33548,"_22633":134772,"_29869":134773,"_3292":132700},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#publica-el-estado-de-validación",{"_3839":79957,"_33145":79948,"_5":33548,"_22633":134775,"_29869":134776,"_3292":134777},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3839":79958,"_33145":79948,"_5":33548,"_22633":134779,"_29869":134780,"_3292":133631},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#continúa",{"_3839":79959,"_33145":79948,"_22633":134782,"_5":15597,"_29869":79948,"_3292":134783},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3839":79960,"_33145":79948,"_22633":134785,"_5":15597,"_29869":134754,"_3292":134786},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3839":79961,"_33145":79948,"_22633":134788,"_5":15597,"_29869":134754,"_3292":134789},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3839":79962,"_33145":79948,"_22633":134791,"_5":15597,"_29869":134757,"_3292":134792},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3839":79963,"_33145":79948,"_22633":134794,"_5":15597,"_29869":134757,"_3292":134795},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3839":79964,"_33145":79948,"_22633":134797,"_5":15597,"_29869":134757,"_3292":134798},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3839":79965,"_33145":79948,"_22633":134800,"_5":15597,"_29869":134757,"_3292":134801},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3839":79966,"_33145":79948,"_22633":134803,"_5":15597,"_29869":134757,"_3292":134804},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3839":79967,"_33145":79948,"_22633":134806,"_5":15597,"_29869":134764,"_3292":134807},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3839":79968,"_33145":79948,"_22633":134809,"_5":15597,"_29869":134767,"_3292":134810},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3839":79969,"_33145":79948,"_22633":134812,"_5":15597,"_29869":134770,"_3292":134813},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3839":79970,"_33145":79948,"_22633":134815,"_5":15597,"_29869":134773,"_3292":134816},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3839":79971,"_33145":79948,"_22633":134818,"_5":15597,"_29869":134776,"_3292":134819},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3839":79972,"_33145":79948,"_22633":134821,"_5":15597,"_29869":134776,"_3292":134822},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3839":79973,"_33145":79948,"_22633":134824,"_5":15597,"_29869":134776,"_3292":134825},[],"su clave pública corresponda a la clave privada del cliente;",{"_3839":79974,"_33145":79948,"_22633":134827,"_5":15597,"_29869":134776,"_3292":134828},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3839":79975,"_33145":79948,"_22633":134830,"_5":15597,"_29869":134776,"_3292":134831},[],"sus fechas y usos permitan la operación;",{"_3839":79976,"_33145":79948,"_22633":134833,"_5":15597,"_29869":134776,"_3292":134834},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3839":79977,"_33145":79948,"_22633":134836,"_5":15597,"_29869":134776,"_3292":134837},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3839":79978,"_33145":79948,"_22633":134839,"_5":15597,"_29869":134780,"_3292":134840},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3839":79979,"_33145":79948,"_22633":134842,"_5":15597,"_29869":134780,"_3292":134843},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3839":79980,"_33145":79948,"_22633":134845,"_5":15597,"_29869":134780,"_3292":134846},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3839":79981,"_33145":79981,"_5":15996,"_3292":134848,"_33551":134849,"_22633":134850,"_29869":79981},"Crea tu primera CA",[54324,128959,59794,132284],[],{"_3839":79982,"_33145":79981,"_22633":134852,"_5":15597,"_29869":79981,"_3292":134853},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3839":79983,"_33145":79981,"_5":33548,"_22633":134855,"_29869":134856,"_3292":127537},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3839":79984,"_33145":79981,"_5":33548,"_22633":134858,"_29869":134859,"_3292":134860},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3839":79985,"_33145":79981,"_5":33548,"_22633":134862,"_29869":134863,"_3292":134864},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3839":79986,"_33145":79981,"_5":33548,"_22633":134866,"_29869":134867,"_3292":134868},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3839":79987,"_33145":79981,"_5":33548,"_22633":134870,"_29869":134871,"_3292":134872},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3839":79988,"_33145":79981,"_5":33548,"_22633":134874,"_29869":134875,"_3292":134876},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3839":79989,"_33145":79981,"_5":33548,"_22633":134878,"_29869":134879,"_3292":134880},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3839":79990,"_33145":79981,"_5":33548,"_22633":134882,"_29869":134883,"_3292":132531},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3839":79991,"_33145":79981,"_5":33548,"_22633":134885,"_29869":134886,"_3292":127561},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3839":79992,"_33145":79981,"_22633":134888,"_5":15597,"_29869":79981,"_3292":134889},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3839":79993,"_33145":79981,"_22633":134891,"_5":15597,"_29869":134856,"_3292":134892},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3839":79994,"_33145":79981,"_22633":134894,"_5":15597,"_29869":134856,"_3292":134895},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3839":79995,"_33145":79981,"_22633":134897,"_5":15597,"_29869":134856,"_3292":134898},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3839":79996,"_33145":79981,"_22633":134900,"_5":15597,"_29869":134856,"_3292":134901},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3839":79997,"_33145":79981,"_22633":134903,"_5":15597,"_29869":134859,"_3292":134904},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3839":79998,"_33145":79981,"_22633":134906,"_5":15597,"_29869":134859,"_3292":134907},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3839":79999,"_33145":79981,"_22633":134909,"_5":15597,"_29869":134863,"_3292":134910},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3839":80000,"_33145":79981,"_22633":134912,"_5":15597,"_29869":134863,"_3292":134913},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3839":80001,"_33145":79981,"_22633":134915,"_5":15597,"_29869":134867,"_3292":134916},[],"Selecciona **Root CA** y completa:",{"_3839":80002,"_33145":79981,"_22633":134918,"_5":15597,"_29869":134867,"_3292":61907},[],{"_3839":80003,"_33145":79981,"_22633":134920,"_5":15597,"_29869":134867,"_3292":134921},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3839":80004,"_33145":79981,"_22633":134923,"_5":15597,"_29869":134867,"_3292":134924},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3839":80005,"_33145":79981,"_22633":134926,"_5":15597,"_29869":134867,"_3292":134927},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3839":80006,"_33145":79981,"_22633":134929,"_5":15597,"_29869":134867,"_3292":134930},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3839":80007,"_33145":79981,"_22633":134932,"_5":15597,"_29869":134871,"_3292":134933},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3839":80008,"_33145":79981,"_22633":134935,"_5":15597,"_29869":134875,"_3292":134936},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3839":80009,"_33145":79981,"_22633":134938,"_5":15597,"_29869":134875,"_3292":134939},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3839":80010,"_33145":79981,"_22633":134941,"_5":15597,"_29869":134879,"_3292":134942},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3839":80011,"_33145":79981,"_22633":134944,"_5":15597,"_29869":134879,"_3292":134945},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3839":80012,"_33145":79981,"_22633":134947,"_5":15597,"_29869":134879,"_3292":134948},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3839":80013,"_33145":79981,"_22633":134950,"_5":15597,"_29869":134883,"_3292":134951},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3839":80014,"_33145":79981,"_22633":134953,"_5":15597,"_29869":134883,"_3292":134954},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3839":80015,"_33145":79981,"_22633":134956,"_5":15597,"_29869":134883,"_3292":134957},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3839":80016,"_33145":79981,"_22633":134959,"_5":15597,"_29869":134883,"_3292":134960},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3839":80017,"_33145":79981,"_22633":134962,"_5":15597,"_29869":134886,"_3292":134963},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3839":80018,"_33145":80018,"_5":15996,"_3292":134965,"_33551":134966,"_22633":134967,"_29869":80018},"Emite y verifica un certificado",[54324,128959,59794,132284],[],{"_3839":80019,"_33145":80018,"_22633":134969,"_5":15597,"_29869":80018,"_3292":134970},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3839":80020,"_33145":80018,"_5":33548,"_22633":134972,"_29869":134973,"_3292":127537},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3839":80021,"_33145":80018,"_5":33548,"_22633":134975,"_29869":134976,"_3292":134977},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3839":80022,"_33145":80018,"_5":33548,"_22633":134979,"_29869":134980,"_3292":134981},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3839":80023,"_33145":80018,"_5":33548,"_22633":134983,"_29869":134984,"_3292":134985},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3839":80024,"_33145":80018,"_5":33548,"_22633":134987,"_29869":134988,"_3292":134989},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3839":80025,"_33145":80018,"_5":33548,"_22633":134991,"_29869":134992,"_3292":134993},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3839":80026,"_33145":80018,"_5":33548,"_22633":134995,"_29869":134996,"_3292":134997},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3839":80027,"_33145":80018,"_5":33548,"_22633":134999,"_29869":135000,"_3292":135001},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3839":80028,"_33145":80018,"_5":33548,"_22633":135003,"_29869":135004,"_3292":135005},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3839":80029,"_33145":80018,"_5":33548,"_22633":135007,"_29869":135008,"_3292":135009},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3839":80030,"_33145":80018,"_5":33548,"_22633":135011,"_29869":135012,"_3292":132531},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3839":80031,"_33145":80018,"_5":33548,"_22633":135014,"_29869":135015,"_3292":127561},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3839":80032,"_33145":80018,"_22633":135017,"_5":15597,"_29869":80018,"_3292":135018},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3839":80033,"_33145":80018,"_22633":135020,"_5":15597,"_29869":134973,"_3292":135021},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3839":80034,"_33145":80018,"_22633":135023,"_5":15597,"_29869":134973,"_3292":135024},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3839":80035,"_33145":80018,"_22633":135026,"_5":15597,"_29869":134973,"_3292":135027},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3839":80036,"_33145":80018,"_22633":135029,"_5":15597,"_29869":134973,"_3292":135030},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3839":80037,"_33145":80018,"_22633":135032,"_5":15597,"_29869":134973,"_3292":135033},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3839":80038,"_33145":80018,"_22633":135035,"_5":15597,"_29869":134976,"_3292":135036},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3839":80039,"_33145":80018,"_22633":135038,"_5":15597,"_29869":134980,"_3292":135039},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3839":80040,"_33145":80018,"_22633":135041,"_5":15597,"_29869":134980,"_3292":135042},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3839":80041,"_33145":80018,"_22633":135044,"_5":15597,"_29869":134984,"_3292":135045},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3839":80042,"_33145":80018,"_22633":135047,"_5":15597,"_29869":134984,"_3292":135048},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3839":80043,"_33145":80018,"_22633":135050,"_5":15597,"_29869":134988,"_3292":135051},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3839":80044,"_33145":80018,"_22633":135053,"_5":15597,"_29869":134988,"_3292":135054},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3839":80045,"_33145":80018,"_22633":135056,"_5":15597,"_29869":134992,"_3292":135057},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3839":80046,"_33145":80018,"_22633":135059,"_5":15597,"_29869":134996,"_3292":135060},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3839":80047,"_33145":80018,"_22633":135062,"_5":15597,"_29869":135000,"_3292":135063},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3839":80048,"_33145":80018,"_22633":135065,"_5":15597,"_29869":135004,"_3292":135066},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3839":80049,"_33145":80018,"_22633":135068,"_5":15597,"_29869":135004,"_3292":135069},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3839":80050,"_33145":80018,"_22633":135071,"_5":15597,"_29869":135004,"_3292":135072},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3839":80051,"_33145":80018,"_22633":135074,"_5":15597,"_29869":135008,"_3292":135075},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3839":80052,"_33145":80018,"_22633":135077,"_5":15597,"_29869":135008,"_3292":135078},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3839":80053,"_33145":80018,"_22633":135080,"_5":15597,"_29869":135008,"_3292":135081},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3839":80054,"_33145":80018,"_22633":135083,"_5":15597,"_29869":135012,"_3292":132614},[],{"_3839":80055,"_33145":80018,"_22633":135085,"_5":15597,"_29869":135012,"_3292":131135},[],{"_3839":80056,"_33145":80018,"_22633":135087,"_5":15597,"_29869":135012,"_3292":135088},[],"La CA rechaza la emisión",{"_3839":80057,"_33145":80018,"_22633":135090,"_5":15597,"_29869":135012,"_3292":135091},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3839":80058,"_33145":80018,"_22633":135093,"_5":15597,"_29869":135012,"_3292":135094},[],"Sujeto o usos diferentes",{"_3839":80059,"_33145":80018,"_22633":135096,"_5":15597,"_29869":135012,"_3292":135097},[],"Perfil aplicado y valores solicitados.",{"_3839":80060,"_33145":80018,"_22633":135099,"_5":15597,"_29869":135012,"_3292":135100},[],"No se encuentra el emisor",{"_3839":80061,"_33145":80018,"_22633":135102,"_5":15597,"_29869":135012,"_3292":135103},[],"CA descargada y cadena intermedia necesaria.",{"_3839":80062,"_33145":80018,"_22633":135105,"_5":15597,"_29869":135012,"_3292":135106},[],"Falla la vigencia",{"_3839":80063,"_33145":80018,"_22633":135108,"_5":15597,"_29869":135012,"_3292":135109},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3839":80064,"_33145":80018,"_22633":135111,"_5":15597,"_29869":135012,"_3292":135112},[],"Los resúmenes de clave difieren",{"_3839":80065,"_33145":80018,"_22633":135114,"_5":15597,"_29869":135012,"_3292":135115},[],"Archivos de certificado y clave de la misma emisión.",{"_3839":80066,"_33145":80018,"_22633":135117,"_5":15597,"_29869":135012,"_3292":135118},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3839":80067,"_33145":80018,"_22633":135120,"_5":15597,"_29869":135015,"_3292":135121},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3839":80068,"_33145":80018,"_22633":135123,"_5":15597,"_29869":135015,"_3292":135124},[],"Gestionar certificados para inspección, estado y revocación.",{"_3839":80069,"_33145":80018,"_22633":135126,"_5":15597,"_29869":135015,"_3292":135127},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3839":80070,"_33145":80018,"_22633":135129,"_5":15597,"_29869":135015,"_3292":135130},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3839":80071,"_33145":80018,"_22633":135132,"_5":15597,"_29869":135015,"_3292":135133},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3839":80072,"_33145":80072,"_5":15996,"_3292":135135,"_33551":135136,"_22633":135137,"_29869":80072},"Primeros pasos de PKI",[54324,128959,59794,132284],[],{"_3839":80073,"_33145":80072,"_22633":135139,"_5":15597,"_29869":80072,"_3292":135140},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3839":80074,"_33145":80072,"_5":33548,"_22633":135142,"_29869":135143,"_3292":127537},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3839":80075,"_33145":80072,"_5":33548,"_22633":135145,"_29869":135146,"_3292":135147},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3839":80076,"_33145":80072,"_5":33548,"_22633":135149,"_29869":135150,"_3292":132466},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3839":80077,"_33145":80072,"_5":33548,"_22633":135152,"_29869":135153,"_3292":135154},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3839":80078,"_33145":80072,"_22633":135156,"_5":15597,"_29869":80072,"_3292":135157},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3839":80079,"_33145":80072,"_22633":135159,"_5":15597,"_29869":135143,"_3292":135160},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3839":80080,"_33145":80072,"_22633":135162,"_5":15597,"_29869":135143,"_3292":135163},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3839":80081,"_33145":80072,"_22633":135165,"_5":15597,"_29869":135143,"_3292":135166},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3839":80082,"_33145":80072,"_22633":135168,"_5":15597,"_29869":135143,"_3292":135169},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3839":80083,"_33145":80072,"_22633":135171,"_5":15597,"_29869":135143,"_3292":135172},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3839":80084,"_33145":80072,"_22633":135174,"_5":15597,"_29869":135146,"_3292":135175},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3839":80085,"_33145":80072,"_22633":135177,"_5":15597,"_29869":135146,"_3292":135178},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3839":80086,"_33145":80072,"_22633":135180,"_5":15597,"_29869":135146,"_3292":135181},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3839":80087,"_33145":80072,"_22633":135183,"_5":15597,"_29869":135146,"_3292":135184},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3839":80088,"_33145":80072,"_22633":135186,"_5":15597,"_29869":135150,"_3292":135187},[],"Archivo o recurso",{"_3839":80089,"_33145":80072,"_22633":135189,"_5":15597,"_29869":135150,"_3292":132463},[],{"_3839":80090,"_33145":80072,"_22633":135191,"_5":15597,"_29869":135150,"_3292":135192},[],"CA raíz activa y `ca.pem`",{"_3839":80091,"_33145":80072,"_22633":135194,"_5":15597,"_29869":135150,"_3292":135195},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3839":80092,"_33145":80072,"_22633":135197,"_5":15597,"_29869":135150,"_3292":135198},[],"Certificado final y `device.crt`",{"_3839":80093,"_33145":80072,"_22633":135200,"_5":15597,"_29869":135150,"_3292":135201},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3839":80094,"_33145":80072,"_22633":135203,"_5":15597,"_29869":135150,"_3292":135204},[],"Clave privada `device.key`",{"_3839":80095,"_33145":80072,"_22633":135206,"_5":15597,"_29869":135150,"_3292":135207},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3839":80096,"_33145":80072,"_22633":135209,"_5":15597,"_29869":135150,"_3292":135210},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3839":80097,"_33145":80072,"_22633":135212,"_5":15597,"_29869":135153,"_3292":135213},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3839":80098,"_33145":80072,"_22633":135215,"_5":15597,"_29869":135153,"_3292":135216},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3839":80099,"_33145":80072,"_22633":135218,"_5":15597,"_29869":135153,"_3292":135219},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3839":80100,"_33145":80100,"_5":15996,"_3292":135221,"_33551":135222,"_22633":135224,"_29869":80100},"Resolución de problemas PKI",[54324,128959,59794,135223],"Resolución de problemas",[],{"_3839":80101,"_33145":80100,"_22633":135226,"_5":15597,"_29869":80100,"_3292":135227},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3839":80102,"_33145":80100,"_5":33548,"_22633":135229,"_29869":135230,"_3292":135231},[],"/docs/pr-preview/pr-58/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3839":80103,"_33145":80100,"_5":33548,"_22633":135233,"_29869":135234,"_3292":135235},[],"/docs/pr-preview/pr-58/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3839":80104,"_33145":80100,"_5":33548,"_22633":135237,"_29869":135238,"_3292":135239},[],"/docs/pr-preview/pr-58/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3839":80105,"_33145":80100,"_22633":135241,"_5":15597,"_29869":80100,"_3292":135242},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3839":80106,"_33145":80100,"_22633":135244,"_5":15597,"_29869":80100,"_3292":135245},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3839":80107,"_33145":80100,"_22633":135247,"_5":15597,"_29869":135230,"_3292":132463},[],{"_3839":80108,"_33145":80100,"_22633":135249,"_5":15597,"_29869":135230,"_3292":131135},[],{"_3839":80109,"_33145":80100,"_22633":135251,"_5":15597,"_29869":135230,"_3292":127561},[],{"_3839":80110,"_33145":80100,"_22633":135253,"_5":15597,"_29869":135230,"_3292":58636},[],{"_3839":80111,"_33145":80100,"_22633":135255,"_5":15597,"_29869":135230,"_3292":135256},[],"Existe, está activa y sus fechas son utilizables.",{"_3839":80112,"_33145":80100,"_22633":135258,"_5":15597,"_29869":135230,"_3292":135259},[],"Autoridades.",{"_3839":80113,"_33145":80100,"_22633":135261,"_5":15597,"_29869":135230,"_3292":135262},[],"Clave",{"_3839":80114,"_33145":80100,"_22633":135264,"_5":15597,"_29869":135230,"_3292":135265},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3839":80115,"_33145":80100,"_22633":135267,"_5":15597,"_29869":135230,"_3292":135268},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3839":80116,"_33145":80100,"_22633":135270,"_5":15597,"_29869":135230,"_3292":62261},[],{"_3839":80117,"_33145":80100,"_22633":135272,"_5":15597,"_29869":135230,"_3292":135273},[],"PEM correcto y firma verificable.",{"_3839":80118,"_33145":80100,"_22633":135275,"_5":15597,"_29869":135230,"_3292":62267},[],{"_3839":80119,"_33145":80100,"_22633":135277,"_5":15597,"_29869":135230,"_3292":135278},[],"Perfil",{"_3839":80120,"_33145":80100,"_22633":135280,"_5":15597,"_29869":135230,"_3292":135281},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3839":80121,"_33145":80100,"_22633":135283,"_5":15597,"_29869":135230,"_3292":135284},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3839":80122,"_33145":80100,"_22633":135286,"_5":15597,"_29869":135230,"_3292":132614},[],{"_3839":80123,"_33145":80100,"_22633":135288,"_5":15597,"_29869":135230,"_3292":135289},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3839":80124,"_33145":80100,"_22633":135291,"_5":15597,"_29869":135230,"_3292":135292},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3839":80125,"_33145":80100,"_22633":135294,"_5":15597,"_29869":135230,"_3292":135295},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3839":80126,"_33145":80100,"_22633":135297,"_5":15597,"_29869":135230,"_3292":135298},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3839":80127,"_33145":80100,"_22633":135300,"_5":15597,"_29869":135234,"_3292":135301},[],"Revisa cada frontera por separado:",{"_3839":80128,"_33145":80100,"_22633":135303,"_5":15597,"_29869":135234,"_3292":135304},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3839":80129,"_33145":80100,"_22633":135306,"_5":15597,"_29869":135234,"_3292":135307},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3839":80130,"_33145":80100,"_22633":135309,"_5":15597,"_29869":135234,"_3292":135310},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3839":80131,"_33145":80100,"_22633":135312,"_5":15597,"_29869":135234,"_3292":135313},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3839":80132,"_33145":80100,"_22633":135315,"_5":15597,"_29869":135234,"_3292":135316},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3839":80133,"_33145":80100,"_22633":135318,"_5":15597,"_29869":135234,"_3292":135319},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3839":80134,"_33145":80100,"_22633":135321,"_5":15597,"_29869":135238,"_3292":135322},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3839":80135,"_33145":80100,"_22633":135324,"_5":15597,"_29869":135238,"_3292":135325},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3839":80136,"_33145":80136,"_5":15996,"_3292":135327,"_33551":135328,"_22633":135331,"_29869":80136},"Algoritmos",[54324,128959,135329,135330],"[Beta] Poscuántica (PQC)","Algoritmos y toolchain",[],{"_3839":80137,"_33145":80136,"_22633":135333,"_5":15597,"_29869":80136,"_3292":135334},[],"Los algoritmos de firma poscuánticos y composite que soporta Lamassu, cómo se identifica cada uno en las peticiones a la API y los estándares que siguen.",{"_3839":80138,"_33145":80136,"_5":33548,"_22633":135336,"_29869":135337,"_3292":135338},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#cómo-se-selecciona-un-algoritmo","Cómo se selecciona un algoritmo",{"_3839":80139,"_33145":80136,"_5":33548,"_22633":135340,"_29869":135341,"_3292":62334},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#ml-dsa",{"_3839":80140,"_33145":80136,"_5":33548,"_22633":135343,"_29869":135344,"_3292":62338},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#slh-dsa",{"_3839":80141,"_33145":80136,"_5":33548,"_22633":135346,"_29869":135347,"_3292":135348},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#ml-dsa-composite","ML-DSA composite",{"_3839":80142,"_33145":80136,"_5":33548,"_22633":135350,"_29869":135351,"_3292":62346},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#ed25519",{"_3839":80143,"_33145":80136,"_5":33548,"_22633":135353,"_29869":135354,"_3292":135355},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#qué-no-se-cubre","Qué no se cubre",{"_3839":80144,"_33145":80136,"_22633":135357,"_5":15597,"_29869":80136,"_3292":135358},[],"Lamassu soporta cuatro grupos de algoritmos de firma además de RSA y ECDSA: ML-DSA, SLH-DSA, ML-DSA composite y Ed25519. Todos proceden del toolchain de Go PQC; el backend solo selecciona el algoritmo y delega la criptografía.",{"_3839":80145,"_33145":80136,"_22633":135360,"_5":15597,"_29869":135337,"_3292":135361},[],"Una clave o una CA se crea con un tipo de clave y un tamaño. En RSA y ECDSA el tamaño es una longitud en bits o una curva. En los algoritmos poscuánticos el mismo campo transporta un **identificador de conjunto de parámetros**, no un número de bits:",{"_3839":80146,"_33145":80136,"_22633":135363,"_5":15597,"_29869":135337,"_3292":135364},[],"Tipo de clave (`algorithm` / `type`)",{"_3839":80147,"_33145":80136,"_22633":135366,"_5":15597,"_29869":135337,"_3292":135367},[],"Valor de `size` / `bits`",{"_3839":80148,"_33145":80136,"_22633":135369,"_5":15597,"_29869":135337,"_3292":135370},[],"Significado",{"_3839":80149,"_33145":80136,"_22633":135372,"_5":15597,"_29869":135337,"_3292":62367},[],{"_3839":80150,"_33145":80136,"_22633":135374,"_5":15597,"_29869":135337,"_3292":62370},[],{"_3839":80151,"_33145":80136,"_22633":135376,"_5":15597,"_29869":135337,"_3292":135377},[],"Longitud del módulo en bits.",{"_3839":80152,"_33145":80136,"_22633":135379,"_5":15597,"_29869":135337,"_3292":62376},[],{"_3839":80153,"_33145":80136,"_22633":135381,"_5":15597,"_29869":135337,"_3292":62379},[],{"_3839":80154,"_33145":80136,"_22633":135383,"_5":15597,"_29869":135337,"_3292":135384},[],"Tamaño de la curva en bits (P-256, P-384, P-521).",{"_3839":80155,"_33145":80136,"_22633":135386,"_5":15597,"_29869":135337,"_3292":62385},[],{"_3839":80156,"_33145":80136,"_22633":135388,"_5":15597,"_29869":135337,"_3292":25551},[],{"_3839":80157,"_33145":80136,"_22633":135390,"_5":15597,"_29869":135337,"_3292":135391},[],"Fijo. Cualquier otro valor se sustituye por 256.",{"_3839":80158,"_33145":80136,"_22633":135393,"_5":15597,"_29869":135337,"_3292":62393},[],{"_3839":80159,"_33145":80136,"_22633":135395,"_5":15597,"_29869":135337,"_3292":62396},[],{"_3839":80160,"_33145":80136,"_22633":135397,"_5":15597,"_29869":135337,"_3292":135398},[],"Conjunto de parámetros de ML-DSA.",{"_3839":80161,"_33145":80136,"_22633":135400,"_5":15597,"_29869":135337,"_3292":62402},[],{"_3839":80162,"_33145":80136,"_22633":135402,"_5":15597,"_29869":135337,"_3292":135403},[],"1 a 12",{"_3839":80163,"_33145":80136,"_22633":135405,"_5":15597,"_29869":135337,"_3292":135406},[],"Conjunto de parámetros de SLH-DSA, en el orden de la tabla siguiente.",{"_3839":80164,"_33145":80136,"_22633":135408,"_5":15597,"_29869":135337,"_3292":62411},[],{"_3839":80165,"_33145":80136,"_22633":135410,"_5":15597,"_29869":135337,"_3292":135411},[],"1 a 8",{"_3839":80166,"_33145":80136,"_22633":135413,"_5":15597,"_29869":135337,"_3292":135414},[],"Variante composite con componente RSA.",{"_3839":80167,"_33145":80136,"_22633":135416,"_5":15597,"_29869":135337,"_3292":62420},[],{"_3839":80168,"_33145":80136,"_22633":135418,"_5":15597,"_29869":135337,"_3292":135419},[],"9 a 13",{"_3839":80169,"_33145":80136,"_22633":135421,"_5":15597,"_29869":135337,"_3292":135422},[],"Variante composite con componente ECDSA.",{"_3839":80170,"_33145":80136,"_22633":135424,"_5":15597,"_29869":135337,"_3292":62429},[],{"_3839":80171,"_33145":80136,"_22633":135426,"_5":15597,"_29869":135337,"_3292":135427},[],"14 y 15",{"_3839":80172,"_33145":80136,"_22633":135429,"_5":15597,"_29869":135337,"_3292":135430},[],"Variante composite con componente Ed25519.",{"_3839":80173,"_33145":80136,"_22633":135432,"_5":15597,"_29869":135337,"_3292":135433},[],"Una cadena de tipo de clave desconocida no se rechaza al interpretarla: se convierte en un tipo desconocido y falla más tarde. Deben usarse exactamente las cadenas anteriores.",{"_3839":80174,"_33145":80136,"_22633":135435,"_5":15597,"_29869":135341,"_3292":135436},[],"ML-DSA es el esquema de firma basado en retículos estandarizado en FIPS 204. Lamassu acepta los tres conjuntos de parámetros ML-DSA-44, ML-DSA-65 y ML-DSA-87, que se seleccionan con `size` 44, 65 o 87. La implementación es el paquete `crypto/mldsa` de Go 1.27, es decir, el código de la propia biblioteca estándar y no del fork. En los certificados, los identificadores de algoritmo son `2.16.840.1.101.3.4.3.17`, `.18` y `.19` para ML-DSA-44, -65 y -87.",{"_3839":80175,"_33145":80136,"_22633":135438,"_5":15597,"_29869":135341,"_3292":135439},[],"Go solo lee claves privadas ML-DSA en PKCS#8 cuando contienen únicamente la semilla de 32 bytes. Las claves que OpenSSL escribe por defecto en la forma semilla más clave expandida se rechazan, por lo que deben exportarse en la forma de solo semilla antes de importarlas.",{"_3839":80176,"_33145":80136,"_22633":135441,"_5":15597,"_29869":135344,"_3292":135442},[],"SLH-DSA es el esquema basado en funciones hash de FIPS 205. Ofrece doce conjuntos de parámetros que combinan una familia de hash (SHA-2 o SHAKE), el parámetro n de 128, 192 o 256 bits, que corresponde a las categorías de seguridad 1, 3 y 5 del NIST y un compromiso entre tamaño de firma y velocidad de firma (`s` para firmas pequeñas, `f` para firma rápida). El identificador que se escribe en `size` sigue el orden de la biblioteca subyacente:",{"_3839":80177,"_33145":80136,"_22633":135444,"_5":15597,"_29869":135344,"_3292":62450},[],{"_3839":80178,"_33145":80136,"_22633":135446,"_5":15597,"_29869":135344,"_3292":135447},[],"Conjunto de parámetros",{"_3839":80179,"_33145":80136,"_22633":135449,"_5":15597,"_29869":135344,"_3292":62450},[],{"_3839":80180,"_33145":80136,"_22633":135451,"_5":15597,"_29869":135344,"_3292":135447},[],{"_3839":80181,"_33145":80136,"_22633":135453,"_5":15597,"_29869":135344,"_3292":15684},[],{"_3839":80182,"_33145":80136,"_22633":135455,"_5":15597,"_29869":135344,"_3292":62462},[],{"_3839":80183,"_33145":80136,"_22633":135457,"_5":15597,"_29869":135344,"_3292":15705},[],{"_3839":80184,"_33145":80136,"_22633":135459,"_5":15597,"_29869":135344,"_3292":62467},[],{"_3839":80185,"_33145":80136,"_22633":135461,"_5":15597,"_29869":135344,"_3292":11291},[],{"_3839":80186,"_33145":80136,"_22633":135463,"_5":15597,"_29869":135344,"_3292":62472},[],{"_3839":80187,"_33145":80136,"_22633":135465,"_5":15597,"_29869":135344,"_3292":11156},[],{"_3839":80188,"_33145":80136,"_22633":135467,"_5":15597,"_29869":135344,"_3292":62477},[],{"_3839":80189,"_33145":80136,"_22633":135469,"_5":15597,"_29869":135344,"_3292":11235},[],{"_3839":80190,"_33145":80136,"_22633":135471,"_5":15597,"_29869":135344,"_3292":62482},[],{"_3839":80191,"_33145":80136,"_22633":135473,"_5":15597,"_29869":135344,"_3292":28495},[],{"_3839":80192,"_33145":80136,"_22633":135475,"_5":15597,"_29869":135344,"_3292":62487},[],{"_3839":80193,"_33145":80136,"_22633":135477,"_5":15597,"_29869":135344,"_3292":11140},[],{"_3839":80194,"_33145":80136,"_22633":135479,"_5":15597,"_29869":135344,"_3292":62492},[],{"_3839":80195,"_33145":80136,"_22633":135481,"_5":15597,"_29869":135344,"_3292":32288},[],{"_3839":80196,"_33145":80136,"_22633":135483,"_5":15597,"_29869":135344,"_3292":62497},[],{"_3839":80197,"_33145":80136,"_22633":135485,"_5":15597,"_29869":135344,"_3292":11366},[],{"_3839":80198,"_33145":80136,"_22633":135487,"_5":15597,"_29869":135344,"_3292":62502},[],{"_3839":80199,"_33145":80136,"_22633":135489,"_5":15597,"_29869":135344,"_3292":32322},[],{"_3839":80200,"_33145":80136,"_22633":135491,"_5":15597,"_29869":135344,"_3292":62507},[],{"_3839":80201,"_33145":80136,"_22633":135493,"_5":15597,"_29869":135344,"_3292":11148},[],{"_3839":80202,"_33145":80136,"_22633":135495,"_5":15597,"_29869":135344,"_3292":62512},[],{"_3839":80203,"_33145":80136,"_22633":135497,"_5":15597,"_29869":135344,"_3292":31796},[],{"_3839":80204,"_33145":80136,"_22633":135499,"_5":15597,"_29869":135344,"_3292":62517},[],{"_3839":80205,"_33145":80136,"_22633":135501,"_5":15597,"_29869":135344,"_3292":135502},[],"Los identificadores de objeto van de `2.16.840.1.101.3.4.3.20` a `.31`. Las firmas SLH-DSA son grandes, de entre unos 8 y 50 KB según el conjunto de parámetros, lo que importa en las cadenas de certificados y en cualquier transporte con un límite de tamaño. SLH-DSA está disponible para claves, CA y certificados, pero el fork no tiene esquema de firma TLS para él, por lo que un certificado SLH-DSA no puede autenticar una conexión TLS.",{"_3839":80206,"_33145":80136,"_22633":135504,"_5":15597,"_29869":135347,"_3292":135505},[],"Una clave composite empareja una clave ML-DSA con una clave tradicional. Una firma composite es la concatenación de la firma ML-DSA y la firma tradicional, ambas calculadas sobre un mensaje representativo que contiene un prefijo fijo, una etiqueta de algoritmo, un contexto opcional y un hash del mensaje; la verificación falla si falla cualquiera de los componentes. El componente ML-DSA es ML-DSA puro, con la etiqueta como contexto. Lamassu implementa los 15 algoritmos del borrador 19 de la especificación del IETF que dependen solo de algoritmos disponibles en Go. Los identificadores cuelgan del arco `1.3.6.1.5.5.7.6`.",{"_3839":80207,"_33145":80136,"_22633":135507,"_5":15597,"_29869":135347,"_3292":62526},[],{"_3839":80208,"_33145":80136,"_22633":135509,"_5":15597,"_29869":135347,"_3292":135510},[],"Algoritmo",{"_3839":80209,"_33145":80136,"_22633":135512,"_5":15597,"_29869":135347,"_3292":135513},[],"Último dígito del OID",{"_3839":80210,"_33145":80136,"_22633":135515,"_5":15597,"_29869":135347,"_3292":135516},[],"Familia",{"_3839":80211,"_33145":80136,"_22633":135518,"_5":15597,"_29869":135347,"_3292":15684},[],{"_3839":80212,"_33145":80136,"_22633":135520,"_5":15597,"_29869":135347,"_3292":62540},[],{"_3839":80213,"_33145":80136,"_22633":135522,"_5":15597,"_29869":135347,"_3292":33019},[],{"_3839":80214,"_33145":80136,"_22633":135524,"_5":15597,"_29869":135347,"_3292":62545},[],{"_3839":80215,"_33145":80136,"_22633":135526,"_5":15597,"_29869":135347,"_3292":11291},[],{"_3839":80216,"_33145":80136,"_22633":135528,"_5":15597,"_29869":135347,"_3292":62550},[],{"_3839":80217,"_33145":80136,"_22633":135530,"_5":15597,"_29869":135347,"_3292":32992},[],{"_3839":80218,"_33145":80136,"_22633":135532,"_5":15597,"_29869":135347,"_3292":62545},[],{"_3839":80219,"_33145":80136,"_22633":135534,"_5":15597,"_29869":135347,"_3292":11235},[],{"_3839":80220,"_33145":80136,"_22633":135536,"_5":15597,"_29869":135347,"_3292":62559},[],{"_3839":80221,"_33145":80136,"_22633":135538,"_5":15597,"_29869":135347,"_3292":31907},[],{"_3839":80222,"_33145":80136,"_22633":135540,"_5":15597,"_29869":135347,"_3292":62545},[],{"_3839":80223,"_33145":80136,"_22633":135542,"_5":15597,"_29869":135347,"_3292":11140},[],{"_3839":80224,"_33145":80136,"_22633":135544,"_5":15597,"_29869":135347,"_3292":62568},[],{"_3839":80225,"_33145":80136,"_22633":135546,"_5":15597,"_29869":135347,"_3292":31913},[],{"_3839":80226,"_33145":80136,"_22633":135548,"_5":15597,"_29869":135347,"_3292":62545},[],{"_3839":80227,"_33145":80136,"_22633":135550,"_5":15597,"_29869":135347,"_3292":11366},[],{"_3839":80228,"_33145":80136,"_22633":135552,"_5":15597,"_29869":135347,"_3292":62577},[],{"_3839":80229,"_33145":80136,"_22633":135554,"_5":15597,"_29869":135347,"_3292":31919},[],{"_3839":80230,"_33145":80136,"_22633":135556,"_5":15597,"_29869":135347,"_3292":62545},[],{"_3839":80231,"_33145":80136,"_22633":135558,"_5":15597,"_29869":135347,"_3292":11148},[],{"_3839":80232,"_33145":80136,"_22633":135560,"_5":15597,"_29869":135347,"_3292":62586},[],{"_3839":80233,"_33145":80136,"_22633":135562,"_5":15597,"_29869":135347,"_3292":11143},[],{"_3839":80234,"_33145":80136,"_22633":135564,"_5":15597,"_29869":135347,"_3292":62545},[],{"_3839":80235,"_33145":80136,"_22633":135566,"_5":15597,"_29869":135347,"_3292":15705},[],{"_3839":80236,"_33145":80136,"_22633":135568,"_5":15597,"_29869":135347,"_3292":62595},[],{"_3839":80237,"_33145":80136,"_22633":135570,"_5":15597,"_29869":135347,"_3292":31801},[],{"_3839":80238,"_33145":80136,"_22633":135572,"_5":15597,"_29869":135347,"_3292":62545},[],{"_3839":80239,"_33145":80136,"_22633":135574,"_5":15597,"_29869":135347,"_3292":11156},[],{"_3839":80240,"_33145":80136,"_22633":135576,"_5":15597,"_29869":135347,"_3292":62604},[],{"_3839":80241,"_33145":80136,"_22633":135578,"_5":15597,"_29869":135347,"_3292":31823},[],{"_3839":80242,"_33145":80136,"_22633":135580,"_5":15597,"_29869":135347,"_3292":62545},[],{"_3839":80243,"_33145":80136,"_22633":135582,"_5":15597,"_29869":135347,"_3292":28495},[],{"_3839":80244,"_33145":80136,"_22633":135584,"_5":15597,"_29869":135347,"_3292":62613},[],{"_3839":80245,"_33145":80136,"_22633":135586,"_5":15597,"_29869":135347,"_3292":31859},[],{"_3839":80246,"_33145":80136,"_22633":135588,"_5":15597,"_29869":135347,"_3292":62618},[],{"_3839":80247,"_33145":80136,"_22633":135590,"_5":15597,"_29869":135347,"_3292":32288},[],{"_3839":80248,"_33145":80136,"_22633":135592,"_5":15597,"_29869":135347,"_3292":62623},[],{"_3839":80249,"_33145":80136,"_22633":135594,"_5":15597,"_29869":135347,"_3292":31925},[],{"_3839":80250,"_33145":80136,"_22633":135596,"_5":15597,"_29869":135347,"_3292":62618},[],{"_3839":80251,"_33145":80136,"_22633":135598,"_5":15597,"_29869":135347,"_3292":32322},[],{"_3839":80252,"_33145":80136,"_22633":135600,"_5":15597,"_29869":135347,"_3292":62632},[],{"_3839":80253,"_33145":80136,"_22633":135602,"_5":15597,"_29869":135347,"_3292":31931},[],{"_3839":80254,"_33145":80136,"_22633":135604,"_5":15597,"_29869":135347,"_3292":62618},[],{"_3839":80255,"_33145":80136,"_22633":135606,"_5":15597,"_29869":135347,"_3292":31796},[],{"_3839":80256,"_33145":80136,"_22633":135608,"_5":15597,"_29869":135347,"_3292":62641},[],{"_3839":80257,"_33145":80136,"_22633":135610,"_5":15597,"_29869":135347,"_3292":31937},[],{"_3839":80258,"_33145":80136,"_22633":135612,"_5":15597,"_29869":135347,"_3292":62618},[],{"_3839":80259,"_33145":80136,"_22633":135614,"_5":15597,"_29869":135347,"_3292":32388},[],{"_3839":80260,"_33145":80136,"_22633":135616,"_5":15597,"_29869":135347,"_3292":62650},[],{"_3839":80261,"_33145":80136,"_22633":135618,"_5":15597,"_29869":135347,"_3292":31829},[],{"_3839":80262,"_33145":80136,"_22633":135620,"_5":15597,"_29869":135347,"_3292":62618},[],{"_3839":80263,"_33145":80136,"_22633":135622,"_5":15597,"_29869":135347,"_3292":31977},[],{"_3839":80264,"_33145":80136,"_22633":135624,"_5":15597,"_29869":135347,"_3292":62659},[],{"_3839":80265,"_33145":80136,"_22633":135626,"_5":15597,"_29869":135347,"_3292":33025},[],{"_3839":80266,"_33145":80136,"_22633":135628,"_5":15597,"_29869":135347,"_3292":62346},[],{"_3839":80267,"_33145":80136,"_22633":135630,"_5":15597,"_29869":135347,"_3292":32394},[],{"_3839":80268,"_33145":80136,"_22633":135632,"_5":15597,"_29869":135347,"_3292":62668},[],{"_3839":80269,"_33145":80136,"_22633":135634,"_5":15597,"_29869":135347,"_3292":31901},[],{"_3839":80270,"_33145":80136,"_22633":135636,"_5":15597,"_29869":135347,"_3292":62346},[],{"_3839":80271,"_33145":80136,"_22633":135638,"_5":15597,"_29869":135347,"_3292":135639},[],"El tipo de clave debe coincidir con la familia de la variante: crear una clave `Composite-ML-DSA-ECDSA` con `size` 3 falla con un error que indica que la variante no es válida para ese tipo de clave.",{"_3839":80272,"_33145":80136,"_22633":135641,"_5":15597,"_29869":135347,"_3292":135642},[],"El borrador 19 se ha publicado desde entonces como RFC 10073. Los identificadores de objeto y el prefijo de separación de dominio comprobados frente al RFC coinciden con esta página, pero la implementación se escribió y se probó contra el borrador y no se ha comparado con el texto final. Tres algoritmos de la especificación no están implementados porque Go no dispone de curvas Brainpool ni de Ed448: las dos variantes Brainpool (`MLDSA65-ECDSA-brainpoolP256r1` y `MLDSA87-ECDSA-brainpoolP384r1`, con su sufijo de hash) y la variante Ed448. El fork supera los vectores de prueba oficiales del borrador 19 para los 15 algoritmos que sí implementa.",{"_3839":80273,"_33145":80136,"_22633":135644,"_5":15597,"_29869":135347,"_3292":135645},[],"Los parámetros de las claves y de las firmas composite deben estar ausentes en el `AlgorithmIdentifier`; los certificados que los incluyen se rechazan. Los componentes ECDSA deben usar un escalar privado con la longitud exacta de la curva.",{"_3839":80274,"_33145":80136,"_22633":135647,"_5":15597,"_29869":135351,"_3292":135648},[],"Ed25519 no es poscuántico, pero el soporte como tipo de clave de CA y de certificado se añadió en el mismo trabajo y se selecciona con el tipo de clave `Ed25519`. Se clasifica en la familia tradicional.",{"_3839":80275,"_33145":80136,"_22633":135650,"_5":15597,"_29869":135354,"_3292":135651},[],"Lamassu no implementa intercambio de claves poscuántico propio. Los intercambios de claves híbridos que ofrece el endpoint TLS, como `X25519MLKEM768`, son los de la biblioteca estándar de Go 1.27. Los diseños de certificados Chameleon y delta que se exploraron en iteraciones anteriores se eliminaron y no forman parte de la implementación.",{"_3839":80276,"_33145":80136,"_22633":135653,"_5":15597,"_29869":135354,"_3292":135654},[],"<Card title=\"Toolchain de Go PQC\" description=\"El fork que implementa estos algoritmos y la API que añade.\" href=\"/docs/platform/pqc/go-toolchain\" />",{"_3839":80277,"_33145":80136,"_22633":135656,"_5":15597,"_29869":135354,"_3292":135657},[],"<Card title=\"Claves y autoridades de certificación\" description=\"Usar estos parámetros en las peticiones al KMS y a la CA.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_3839":80278,"_33145":80278,"_5":15996,"_3292":62695,"_33551":135659,"_22633":135661,"_29869":80278},[54324,128959,135329,135660],"Soporte en la plataforma",[],{"_3839":80279,"_33145":80278,"_22633":135663,"_5":15597,"_29869":80278,"_3292":135664},[],"Cómo expone la interfaz web los algoritmos poscuánticos al crear claves, CA y certificados, y cómo los muestra.",{"_3839":80280,"_33145":80278,"_5":33548,"_22633":135666,"_29869":135667,"_3292":135668},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#elegir-tipo-de-clave-y-especificación","Elegir tipo de clave y especificación",{"_3839":80281,"_33145":80278,"_5":33548,"_22633":135670,"_29869":135671,"_3292":135672},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#emitir-un-certificado-con-una-clave-generada-en-el-navegador","Emitir un certificado con una clave generada en el navegador",{"_3839":80282,"_33145":80278,"_5":33548,"_22633":135674,"_29869":135675,"_3292":135676},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#cómo-se-muestran-los-objetos","Cómo se muestran los objetos",{"_3839":80283,"_33145":80278,"_5":33548,"_22633":135678,"_29869":135679,"_3292":135680},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#certificados-relacionados","Certificados relacionados",{"_3839":80284,"_33145":80278,"_5":33548,"_22633":135682,"_29869":135683,"_3292":135684},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#aspectos-a-tener-en-cuenta","Aspectos a tener en cuenta",{"_3839":80285,"_33145":80278,"_22633":135686,"_5":15597,"_29869":80278,"_3292":135687},[],"El dashboard (rama `feat/lamassu-q`) permite a un administrador crear e inspeccionar claves, autoridades de certificación y certificados poscuánticos sin escribir peticiones a la API. Añade las opciones de algoritmo, muestra la familia de algoritmo de cada objeto e interpreta los nuevos identificadores en los certificados. Todo lo que envía se describe en Claves y autoridades de certificación; esta página cubre lo que muestra la interfaz y dónde difiere su comportamiento entre pantallas.",{"_3839":80286,"_33145":80278,"_22633":135689,"_5":15597,"_29869":135667,"_3292":135690},[],"Crear una clave del KMS, una CA con una clave nueva y un certificado con clave generada en el servidor usan el mismo par de selectores. *Key type* está agrupado por familia y *Key specification* depende del tipo.",{"_3839":80287,"_33145":80278,"_22633":135692,"_5":15597,"_29869":135667,"_3292":135693},[],"Grupo",{"_3839":80288,"_33145":80278,"_22633":135695,"_5":15597,"_29869":135667,"_3292":135696},[],"Tipos de clave",{"_3839":80289,"_33145":80278,"_22633":135698,"_5":15597,"_29869":135667,"_3292":62736},[],{"_3839":80290,"_33145":80278,"_22633":135700,"_5":15597,"_29869":135667,"_3292":62739},[],{"_3839":80291,"_33145":80278,"_22633":135702,"_5":15597,"_29869":135667,"_3292":62742},[],{"_3839":80292,"_33145":80278,"_22633":135704,"_5":15597,"_29869":135667,"_3292":62745},[],{"_3839":80293,"_33145":80278,"_22633":135706,"_5":15597,"_29869":135667,"_3292":62748},[],{"_3839":80294,"_33145":80278,"_22633":135708,"_5":15597,"_29869":135667,"_3292":62751},[],{"_3839":80295,"_33145":80278,"_22633":135710,"_5":15597,"_29869":135667,"_3292":135711},[],"La lista de especificaciones muestra ML-DSA-44, -65 o -87, los doce conjuntos de parámetros de SLH-DSA (por ejemplo *4 - SHAKE\\_128f*) o las variantes composite por nombre. La interfaz envía como `size` el identificador del conjunto de parámetros, según se explica en Algoritmos, y muestra un indicador de fortaleza junto a cada opción. En las claves composite el indicador muestra dos barras, una para el componente clásico y otra para el poscuántico.",{"_3839":80296,"_33145":80278,"_22633":135713,"_5":15597,"_29869":135667,"_3292":135714},[],"Las opciones habilitadas dependen del motor criptográfico. Al crear una clave o una CA, la interfaz lista todos los algoritmos pero deshabilita los que el motor seleccionado no soporta, y pide seleccionar antes un motor. Al crear un certificado en el servidor, los tipos no soportados se ocultan en su lugar.",{"_3839":80297,"_33145":80278,"_22633":135716,"_5":15597,"_29869":135671,"_3292":135717},[],"Emitir un certificado desde una CA genera el par de claves en el navegador, construye la solicitud de certificado y la envía a la CA para su firma. Los tipos de clave que se ofrecen aquí son `RSA`, `ECDSA`, `Ed25519`, `ML-DSA`, `SLH-DSA` y una única entrada `Composite ML-DSA`, y se generan con las bibliotecas `@noble` para los algoritmos poscuánticos y composite y con WebCrypto para los clásicos. La clave privada generada se muestra una sola vez al final del procedimiento.",{"_3839":80298,"_33145":80278,"_22633":135719,"_5":15597,"_29869":135671,"_3292":135720},[],"El navegador no verifica las firmas de las solicitudes ML-DSA, SLH-DSA, composite ni Ed25519; confía en el KMS.",{"_3839":80299,"_33145":80278,"_22633":135722,"_5":15597,"_29869":135675,"_3292":135723},[],"Las listas y las vistas de detalle muestran la familia del algoritmo. La tabla de CA tiene una columna *PQC* con T, PQ o PQ/T, las tarjetas de CA y el grafo de CA muestran una insignia *PQC*, las listas de claves muestran un icono cuántico, y el detalle de una CA o un certificado muestra el algoritmo, su fortaleza y la insignia de familia. La familia se calcula a partir del identificador de algoritmo del certificado interpretado.",{"_3839":80300,"_33145":80278,"_22633":135725,"_5":15597,"_29869":135675,"_3292":135726},[],"Los nombres de algoritmo se resuelven a partir de los identificadores de objeto. Los identificadores de ML-DSA, SLH-DSA, composite y Ed25519 se muestran como nombres con su conjunto de parámetros, por ejemplo *ML-DSA-65* o *Composite-Signature MLDSA65-ECDSA-P384-SHA512*, y para ellos no se muestra longitud en bits. Los algoritmos de firma RSA y ECDSA se muestran con etiquetas propias del dashboard, como *RSA PKCS#1 v1.5 SHA-256* y *ECDSA SHA-256*, en lugar de los nombres de OpenSSL `sha256WithRSAEncryption` y `ecdsa-with-SHA256`.",{"_3839":80301,"_33145":80278,"_22633":135728,"_5":15597,"_29869":135675,"_3292":135729},[],"La página de detalle de una clave puede firmar y verificar con una clave poscuántica y habilita únicamente el algoritmo de firma que le corresponde.",{"_3839":80302,"_33145":80278,"_22633":135731,"_5":15597,"_29869":135679,"_3292":135732},[],"El formulario del perfil de emisión, el formulario de emisión de certificados y las páginas de detalle incluyen los controles de certificados relacionados descritos en Certificados relacionados.",{"_3839":80303,"_33145":80278,"_22633":135734,"_5":15597,"_29869":135683,"_3292":135735},[],"Los nombres de los tipos de clave no son idénticos en todas las pantallas. La creación de claves y de CA usa `Composite-ML-DSA-RSA`, `-ECDSA` y `-Ed25519`; el formulario de emisión de certificados usa un único `Composite-ML-DSA`; y el formulario de certificado en el servidor compara nombres en mayúsculas. Los nombres que el backend informa para una clave pueden diferir, por tanto, en mayúsculas y minúsculas de lo que envía la interfaz.",{"_3839":80304,"_33145":80278,"_22633":135737,"_5":15597,"_29869":135683,"_3292":135738},[],"La interfaz no incluye ningún aviso de carácter experimental para estos algoritmos y no está traducida: todos los textos están en inglés.",{"_3839":80305,"_33145":80278,"_22633":135740,"_5":15597,"_29869":135683,"_3292":135741},[],"La correspondencia entre el identificador del conjunto de parámetros de SLH-DSA y el algoritmo que usa el generador de claves del navegador no sigue el mismo orden que los identificadores que muestra el selector y que usa el backend, salvo en el identificador 1. Un certificado emitido por el flujo del navegador con un identificador SLH-DSA del 2 al 12 puede usar, por tanto, un conjunto de parámetros distinto del que nombra el selector. Hasta que se corrija, conviene crear las claves SLH-DSA con el KMS.",{"_3839":80306,"_33145":80278,"_22633":135743,"_5":15597,"_29869":135683,"_3292":135744},[],"<Card title=\"Claves y autoridades de certificación\" description=\"La API que hay detrás de estas pantallas.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_3839":80307,"_33145":80278,"_22633":135746,"_5":15597,"_29869":135683,"_3292":135747},[],"<Card title=\"Limitaciones conocidas\" description=\"Carencias de la interfaz y de la plataforma.\" href=\"/docs/platform/pqc/limitations\" />",{"_3839":80308,"_33145":80308,"_5":15996,"_3292":135749,"_33551":135750,"_22633":135751,"_29869":80308},"Despliegue con el Helm chart",[54324,128959,135329,127528],[],{"_3839":80309,"_33145":80308,"_22633":135753,"_5":15597,"_29869":80308,"_3292":135754},[],"Desplegar Lamassu con un proxy frontal Traefik que sirve certificados clásicos, poscuánticos y composite, mediante los valores del chart o el instalador fast-lane.",{"_3839":80310,"_33145":80308,"_5":33548,"_22633":135756,"_29869":135757,"_3292":135758},[],"/docs/pr-preview/pr-58/es/platform/pqc/deployment#topología","Topología",{"_3839":80311,"_33145":80308,"_5":33548,"_22633":135760,"_29869":135761,"_3292":135762},[],"/docs/pr-preview/pr-58/es/platform/pqc/deployment#valores-del-chart","Valores del chart",{"_3839":80312,"_33145":80308,"_5":33548,"_22633":135764,"_29869":135765,"_3292":135766},[],"/docs/pr-preview/pr-58/es/platform/pqc/deployment#el-instalador-fast-lane","El instalador fast-lane",{"_3839":80313,"_33145":80308,"_22633":135768,"_5":15597,"_29869":80308,"_3292":135769},[],"La rama `pqc` del Helm chart de Lamassu añade un proxy frontal: una instancia de Traefik compilada con el toolchain de Go PQC que termina el TLS de los dispositivos, los autentica y reenvía el tráfico a Envoy Gateway. Esta página describe la topología resultante, los valores que la controlan y el instalador que automatiza un despliegue de laboratorio.",{"_3839":80314,"_33145":80308,"_22633":135771,"_5":15597,"_29869":80308,"_3292":135772},[],"El chart y el instalador asumen un clúster de desarrollo. La imagen del proxy usa una etiqueta mutable, los certificados PQC no se renuevan automáticamente y el salto entre Traefik y Envoy no verifica certificados. Esta configuración no debe usarse tal cual en producción.",{"_3839":80315,"_33145":80308,"_22633":135774,"_5":15597,"_29869":135757,"_3292":135775},[],"Traefik es el borde público. Negocia el intercambio de claves, sirve el certificado y, si se solicita, recibe el certificado del cliente. Después abre una segunda conexión TLS hacia el servicio `envoy-gateway-proxy` de Envoy Gateway, que presenta el certificado clásico autofirmado del chart; Traefik está configurado para aceptarlo sin verificarlo. Envoy no llega a ver, por tanto, un handshake poscuántico, y la protección poscuántica cubre solo la conexión entre el cliente y Traefik. Traefik y Envoy Gateway se instalan una sola vez por clúster y se comparten entre espacios de nombres, mientras que los recursos del proxy frontal (el Gateway, la ruta, el middleware, el certificado y el reference grant) pertenecen a la release de Lamassu.",{"_3839":80316,"_33145":80308,"_22633":135777,"_5":15597,"_29869":135757,"_3292":135778},[],"Cuando el cliente ha enviado un certificado, el middleware `inject-client-cert` del chart lo añade, en formato PEM, a la cabecera `X-Forwarded-Tls-Client-Cert`, y se establece la cabecera `X-Forwarded-Proto: https` en la petición.",{"_3839":80317,"_33145":80308,"_22633":135780,"_5":15597,"_29869":135761,"_3292":135781},[],"Todos los valores nuevos están bajo `traefikFrontProxy` y los valida el esquema del chart, que rechaza claves desconocidas.",{"_3839":80318,"_33145":80308,"_22633":135783,"_5":15597,"_29869":135761,"_3292":135784},[],"Nombre",{"_3839":80319,"_33145":80308,"_22633":135786,"_5":15597,"_29869":135761,"_3292":131573},[],{"_3839":80320,"_33145":80308,"_22633":135788,"_5":15597,"_29869":135761,"_3292":135789},[],"Valor por defecto",{"_3839":80321,"_33145":80308,"_22633":135791,"_5":15597,"_29869":135761,"_3292":131579},[],{"_3839":80322,"_33145":80308,"_22633":135793,"_5":15597,"_29869":135761,"_3292":62836},[],{"_3839":80323,"_33145":80308,"_22633":135795,"_5":15597,"_29869":135761,"_3292":108734},[],{"_3839":80324,"_33145":80308,"_22633":135797,"_5":15597,"_29869":135761,"_3292":62841},[],{"_3839":80325,"_33145":80308,"_22633":135799,"_5":15597,"_29869":135761,"_3292":135800},[],"Despliega los recursos del proxy frontal.",{"_3839":80326,"_33145":80308,"_22633":135802,"_5":15597,"_29869":135761,"_3292":62847},[],{"_3839":80327,"_33145":80308,"_22633":135804,"_5":15597,"_29869":135761,"_3292":101307},[],{"_3839":80328,"_33145":80308,"_22633":135806,"_5":15597,"_29869":135761,"_3292":62852},[],{"_3839":80329,"_33145":80308,"_22633":135808,"_5":15597,"_29869":135761,"_3292":135809},[],"Nombre del certificado de borde y nombre de host de la ruta. Debe indicarse cuando el proxy está habilitado.",{"_3839":80330,"_33145":80308,"_22633":135811,"_5":15597,"_29869":135761,"_3292":62858},[],{"_3839":80331,"_33145":80308,"_22633":135813,"_5":15597,"_29869":135761,"_3292":87238},[],{"_3839":80332,"_33145":80308,"_22633":135815,"_5":15597,"_29869":135761,"_3292":62863},[],{"_3839":80333,"_33145":80308,"_22633":135817,"_5":15597,"_29869":135761,"_3292":135818},[],"Puerto del listener HTTPS; debe coincidir con el entry point `websecure` de Traefik.",{"_3839":80334,"_33145":80308,"_22633":135820,"_5":15597,"_29869":135761,"_3292":62869},[],{"_3839":80335,"_33145":80308,"_22633":135822,"_5":15597,"_29869":135761,"_3292":101307},[],{"_3839":80336,"_33145":80308,"_22633":135824,"_5":15597,"_29869":135761,"_3292":62874},[],{"_3839":80337,"_33145":80308,"_22633":135826,"_5":15597,"_29869":135761,"_3292":135827},[],"Origen del certificado clásico: `certManager`, `external` o `none`.",{"_3839":80338,"_33145":80308,"_22633":135829,"_5":15597,"_29869":135761,"_3292":62880},[],{"_3839":80339,"_33145":80308,"_22633":135831,"_5":15597,"_29869":135761,"_3292":94733},[],{"_3839":80340,"_33145":80308,"_22633":135833,"_5":15597,"_29869":135761,"_3292":62885},[],{"_3839":80341,"_33145":80308,"_22633":135835,"_5":15597,"_29869":135761,"_3292":135836},[],"Direcciones IP añadidas al certificado autofirmado.",{"_3839":80342,"_33145":80308,"_22633":135838,"_5":15597,"_29869":135761,"_3292":62891},[],{"_3839":80343,"_33145":80308,"_22633":135840,"_5":15597,"_29869":135761,"_3292":101307},[],{"_3839":80344,"_33145":80308,"_22633":135842,"_5":15597,"_29869":135761,"_3292":62852},[],{"_3839":80345,"_33145":80308,"_22633":135844,"_5":15597,"_29869":135761,"_3292":135845},[],"Secret con `tls.crt` y `tls.key` cuando el tipo es `external`.",{"_3839":80346,"_33145":80308,"_22633":135847,"_5":15597,"_29869":135761,"_3292":62901},[],{"_3839":80347,"_33145":80308,"_22633":135849,"_5":15597,"_29869":135761,"_3292":94733},[],{"_3839":80348,"_33145":80308,"_22633":135851,"_5":15597,"_29869":135761,"_3292":62885},[],{"_3839":80349,"_33145":80308,"_22633":135853,"_5":15597,"_29869":135761,"_3292":135854},[],"Secrets TLS adicionales, por ejemplo certificados ML-DSA o composite, que se sirven en el mismo listener.",{"_3839":80350,"_33145":80308,"_22633":135856,"_5":15597,"_29869":135761,"_3292":135857},[],"Con `certManager`, el chart solicita un certificado ECDSA P-256 válido durante 2160 horas a su propio emisor autofirmado y lo guarda en el secret `edge-cert`. Con `none`, solo se sirven los secrets adicionales, y el chart se detiene con un error si no hay ninguno. El proxy elige entre todos los certificados según el cliente, tal como describe Proxy TLS con Traefik. Los nombres de los recursos que crea el chart son fijos, por lo que solo se admite una release por espacio de nombres.",{"_3839":80351,"_33145":80308,"_22633":135859,"_5":15597,"_29869":135761,"_3292":135860},[],"El chart modifica además el servicio de Envoy Gateway para que su puerto HTTPS declare `appProtocol: https`, algo que las versiones recientes de Traefik necesitan para hablar TLS con él. Cuando `gateway.addresses` está vacío, el servicio de Envoy es de tipo `ClusterIP` en lugar de un balanceador de carga.",{"_3839":80352,"_33145":80308,"_22633":135862,"_5":15597,"_29869":135761,"_3292":135863},[],"El chart no despliega Traefik, ni la GatewayClass `traefik`, ni la opción TLS `default` en el espacio de nombres `traefik-system`; los crea el instalador. Sin ellos, el borde no tiene intercambio de claves poscuántico ni solicitud de certificado de cliente. Tampoco fija las imágenes de los servicios de Lamassu: los valores por defecto son las imágenes de desarrollo, y el instalador sustituye las de la interfaz, CA, KMS, VA, device manager, DMS manager, alertas y autorización por las etiquetas `:pqc` de `ghcr.io/lamassuiot`.",{"_3839":80353,"_33145":80308,"_22633":135865,"_5":15597,"_29869":135765,"_3292":135866},[],"`scripts/lamassu-fast-lane.sh` instala todo en un clúster: las definiciones de recursos personalizados de Gateway API (versión 1.6.3, canal experimental), Envoy Gateway 1.8.0, el chart de Traefik 41.0.2 con la imagen PQC, la opción TLS, PostgreSQL, Keycloak, RabbitMQ, opcionalmente observabilidad y SoftHSM, y por último la release de Lamassu. Los dos parámetros relevantes aquí seleccionan qué algoritmos se ofrecen.",{"_3839":80354,"_33145":80308,"_22633":135868,"_5":15597,"_29869":135765,"_3292":135869},[],"Ambos parámetros aceptan una lista separada por comas de `T`, `PQ` y `PQ/T`, y ambos toman por defecto los tres valores. En el intercambio de claves, `PQ/T` es un grupo híbrido que combina un intercambio clásico y uno ML-KEM (`X25519MLKEM768`, `SecP256r1MLKEM768` y `SecP384r1MLKEM1024`) y `PQ` es ML-KEM puro (`MLKEM1024`); en la autenticación, `PQ/T` es un certificado composite. `--tls-kex` rellena los `curvePreferences` de la opción TLS, y `--tls-auth` selecciona qué certificados se sirven:",{"_3839":80355,"_33145":80308,"_22633":135871,"_5":15597,"_29869":135765,"_3292":135872},[],"Valor",{"_3839":80356,"_33145":80308,"_22633":135874,"_5":15597,"_29869":135765,"_3292":135875},[],"Grupos de intercambio de claves",{"_3839":80357,"_33145":80308,"_22633":135877,"_5":15597,"_29869":135765,"_3292":131759},[],{"_3839":80358,"_33145":80308,"_22633":135879,"_5":15597,"_29869":135765,"_3292":62934},[],{"_3839":80359,"_33145":80308,"_22633":135881,"_5":15597,"_29869":135765,"_3292":62937},[],{"_3839":80360,"_33145":80308,"_22633":135883,"_5":15597,"_29869":135765,"_3292":135884},[],"ECDSA P-256 de cert-manager, o los ficheros indicados con `--tls-crt` y `--tls-key`, en el secret `edge-cert`.",{"_3839":80361,"_33145":80308,"_22633":135886,"_5":15597,"_29869":135765,"_3292":62943},[],{"_3839":80362,"_33145":80308,"_22633":135888,"_5":15597,"_29869":135765,"_3292":62946},[],{"_3839":80363,"_33145":80308,"_22633":135890,"_5":15597,"_29869":135765,"_3292":135891},[],"ML-DSA-65, en el secret `edge-cert-pq`.",{"_3839":80364,"_33145":80308,"_22633":135893,"_5":15597,"_29869":135765,"_3292":62952},[],{"_3839":80365,"_33145":80308,"_22633":135895,"_5":15597,"_29869":135765,"_3292":62955},[],{"_3839":80366,"_33145":80308,"_22633":135897,"_5":15597,"_29869":135765,"_3292":135898},[],"Composite `MLDSA65-RSA3072-PSS-SHA512`, en el secret `edge-cert-pqt`.",{"_3839":80367,"_33145":80308,"_22633":135900,"_5":15597,"_29869":135765,"_3292":135901},[],"La versión mínima de TLS es 1.3, salvo que ambos parámetros sean solo `T`, en cuyo caso es 1.2. cert-manager no puede emitir certificados poscuánticos, por lo que el instalador crea los certificados PQ y PQ/T localmente con OpenSSL 3.5 o posterior; el certificado composite necesita además el módulo `hybrid-provider`, que el script compila bajo demanda con `git`, `cmake` y un compilador de C. Las claves privadas ML-DSA se escriben en la forma de solo semilla que Go acepta, y los secrets se crean a partir de un manifiesto porque `kubectl create secret tls` rechaza claves ML-DSA. Los certificados duran 365 días y se conservan si el secret ya existe.",{"_3839":80368,"_33145":80308,"_22633":135903,"_5":15597,"_29869":135765,"_3292":135904},[],"El script requiere `yq`, `kubectl` y `helm`, y `jq` con `--sample-data`. Al terminar imprime cómo extraer la CA en la que deben confiar los dispositivos, por ejemplo `kubectl get secret edge-cert-pq -o jsonpath='{.data.ca\\.crt}'`.",{"_3839":80369,"_33145":80308,"_22633":135906,"_5":15597,"_29869":135765,"_3292":135907},[],"Los scripts complementarios para un broker MQTT detrás de Traefik (`scripts/emqx`), para exportar claves del KMS y para restaurar una copia de seguridad están presentes en el árbol de trabajo del chart, pero sin confirmar en el repositorio. Son solo para uso en laboratorio y no se describen más aquí.",{"_3839":80370,"_33145":80308,"_22633":135909,"_5":15597,"_29869":135765,"_3292":135910},[],"<Card title=\"Proxy TLS con Traefik\" description=\"Cómo elige certificado el proxy y cómo se compila.\" href=\"/docs/platform/pqc/tls-front-proxy\" />",{"_3839":80371,"_33145":80308,"_22633":135912,"_5":15597,"_29869":135765,"_3292":135913},[],"<Card title=\"Limitaciones conocidas\" description=\"Advertencias del despliegue de laboratorio.\" href=\"/docs/platform/pqc/limitations\" />",{"_3839":80372,"_33145":80372,"_5":15996,"_3292":135915,"_33551":135916,"_22633":135917,"_29869":80372},"Toolchain de Go PQC",[54324,128959,135329,135330],[],{"_3839":80373,"_33145":80372,"_22633":135919,"_5":15597,"_29869":80372,"_3292":135920},[],"El fork de Go que añade ML-DSA composite, SLH-DSA, certificados relacionados y esquemas de firma TLS composite, la API que expone y cómo se compila.",{"_3839":80374,"_33145":80372,"_5":33548,"_22633":135922,"_29869":135923,"_3292":135924},[],"/docs/pr-preview/pr-58/es/platform/pqc/go-toolchain#qué-añade-el-fork","Qué añade el fork",{"_3839":80375,"_33145":80372,"_5":33548,"_22633":135926,"_29869":135927,"_3292":135928},[],"/docs/pr-preview/pr-58/es/platform/pqc/go-toolchain#puntos-de-código-tls","Puntos de código TLS",{"_3839":80376,"_33145":80372,"_5":33548,"_22633":135930,"_29869":135931,"_3292":135932},[],"/docs/pr-preview/pr-58/es/platform/pqc/go-toolchain#un-ejemplo-mínimo","Un ejemplo mínimo",{"_3839":80377,"_33145":80372,"_5":33548,"_22633":135934,"_29869":135935,"_3292":135936},[],"/docs/pr-preview/pr-58/es/platform/pqc/go-toolchain#qué-se-eliminó","Qué se eliminó",{"_3839":80378,"_33145":80372,"_5":33548,"_22633":135938,"_29869":135939,"_3292":135940},[],"/docs/pr-preview/pr-58/es/platform/pqc/go-toolchain#compilación-del-toolchain-y-de-las-imágenes","Compilación del toolchain y de las imágenes",{"_3839":80379,"_33145":80372,"_22633":135942,"_5":15597,"_29869":80372,"_3292":135943},[],"Go 1.27 incluye ML-DSA en `crypto/mldsa` y en X.509 y TLS, pero no tiene certificados composite ni SLH-DSA, ni certificados relacionados, ni esquemas de firma TLS composite. Por ello Lamassu compila su backend y su proxy TLS con un fork de Go, mantenido en la rama `release-branch.go1.27`. Esta página describe lo que añade el fork, para quienes compilan Lamassu o escriben un cliente que debe comunicarse con él.",{"_3839":80380,"_33145":80372,"_22633":135945,"_5":15597,"_29869":80372,"_3292":135946},[],"El fork expone APIs que no existen en la distribución oficial de Go. El código que las usa solo compila con este toolchain, y no debe suponerse que un binario construido con él cumple la promesa de compatibilidad de Go para esas APIs.",{"_3839":80381,"_33145":80372,"_22633":135948,"_5":15597,"_29869":135923,"_3292":135949},[],"**ML-DSA composite en X.509.** El paquete `x509` incorpora `CompositePublicKey` y `CompositePrivateKey`, que implementan `crypto.Signer`, y 15 valores `CompositeAlgorithm` (por ejemplo `x509.MLDSA65_ECDSA_P384_SHA512`) que permiten generar claves, firmar y verificar. Los certificados, las solicitudes de certificado y las listas de revocación firmados con estas claves se interpretan, se serializan y se verifican como cualquier otro. Se admite la codificación PKCS#8 de claves privadas composite. La página de algoritmos enumera los identificadores.",{"_3839":80382,"_33145":80372,"_22633":135951,"_5":15597,"_29869":135923,"_3292":135952},[],"**SLH-DSA en X.509.** El algoritmo de clave pública `x509.SLHDSA` y doce algoritmos de firma `PureSLHDSA...` están disponibles para interpretar y verificar certificados y claves. La implementación es la biblioteca `circl` de Cloudflare incorporada al fork. Es la parte menos probada: no tiene pruebas propias en x509 ni soporte TLS.",{"_3839":80383,"_33145":80372,"_22633":135954,"_5":15597,"_29869":135923,"_3292":135955},[],"**Certificados relacionados (RFC 9763).** El fork ofrece `x509.CreateBoundCertificate`, que añade a un certificado la extensión `id-pe-relatedCert` (`1.3.6.1.5.5.7.1.36`), `x509.VerifyRelatedCertificate` y las funciones para construir y comprobar el atributo `relatedCertRequest` de una solicitud de certificado (`1.2.840.113549.1.9.16.2.60`). `x509.CertificateRequest` incorpora el campo `ExtraAttributes` para transportarlo. Certificados relacionados explica cómo los usa Lamassu.",{"_3839":80384,"_33145":80372,"_22633":135957,"_5":15597,"_29869":135923,"_3292":135958},[],"**Esquemas de firma composite en TLS.** El paquete `tls` añade 15 constantes `SignatureScheme`, una por algoritmo composite, que se anuncian por defecto después de los esquemas ML-DSA nativos. Solo funcionan con TLS 1.3 y están probadas con autenticación mutua. Sus puntos de código se describen a continuación.",{"_3839":80385,"_33145":80372,"_22633":135960,"_5":15597,"_29869":135927,"_3292":135961},[],"IANA no ha asignado puntos de código a los esquemas de firma TLS composite, por lo que el fork usa el rango de uso privado `0xFE00` a `0xFE0E`, en el orden de la tabla composite: `0xFE00` es `MLDSA44-RSA2048-PSS-SHA256` y `0xFE0E` es `MLDSA65-Ed25519-SHA512`. Un cliente o un servidor construido con una biblioteca TLS estándar no los reconoce y recurrirá a otro esquema o fallará en el handshake. La interoperabilidad queda así limitada a pares construidos con este fork, o a los esquemas ML-DSA nativos (`0x0904` a `0x0906`) que implementa Go 1.27 estándar.",{"_3839":80386,"_33145":80372,"_22633":135963,"_5":15597,"_29869":135927,"_3292":135964},[],"Las tres variantes que usan RSA PKCS#1 v1.5 (`MLDSA44-RSA2048-PKCS15-SHA256`, `MLDSA65-RSA3072-PKCS15-SHA512` y `MLDSA65-RSA4096-PKCS15-SHA512`) se anuncian únicamente en la extensión `signature_algorithms_cert`, por lo que pueden aparecer en una cadena de certificados, pero un certificado hoja con una clave de ese tipo no puede firmar el handshake.",{"_3839":80387,"_33145":80372,"_22633":135966,"_5":15597,"_29869":135927,"_3292":135967},[],"El intercambio de claves no cambia respecto a Go original. Los grupos híbridos como `X25519MLKEM768`, `SecP256r1MLKEM768`, `SecP384r1MLKEM1024` y el `MLKEM1024` puro son los de la biblioteca estándar de Go 1.27.",{"_3839":80388,"_33145":80372,"_22633":135969,"_5":15597,"_29869":135931,"_3292":135970},[],"El siguiente programa crea un certificado composite autofirmado y lo usa como certificado de servidor en una configuración TLS 1.3. Se omite la gestión de errores.",{"_3839":80389,"_33145":80372,"_22633":135972,"_5":15597,"_29869":135931,"_3292":135973},[],"Una clave composite también puede firmar directamente un mensaje, con un contexto opcional de como máximo 255 bytes:",{"_3839":80390,"_33145":80372,"_22633":135975,"_5":15597,"_29869":135935,"_3292":135976},[],"Las primeras iteraciones del fork exploraron certificados Chameleon (`draft-bonnell-lamps-chameleon-certs`) y una construcción de certificados delta. Se eliminaron porque ya no se persiguen. El mecanismo de certificados relacionados se recuperó después por separado, siguiendo el RFC 9763.",{"_3839":80391,"_33145":80372,"_22633":135978,"_5":15597,"_29869":135939,"_3292":135979},[],"El fork se compila en CI mediante un workflow que ejecuta la batería de pruebas de Go y después publica una imagen multiarquitectura, `ghcr.io/lamassuiot/golang-pqc`, con la etiqueta `go1.27` y, para la rama `release-branch.go1.27`, `latest`. La imagen contiene el toolchain en `/usr/local/go-pqc`, con `GOROOT` apuntando a esa ruta.",{"_3839":80392,"_33145":80372,"_22633":135981,"_5":15597,"_29869":135939,"_3292":135982},[],"Lamassu consume el toolchain de dos maneras. Las imágenes del backend (CA, KMS, VA, alertas, device manager, DMS manager y la compilación monolítica) usan `ghcr.io/lamassuiot/golang-pqc:latest` como imagen de compilación. El workflow de CI del backend instala el mismo toolchain mediante una acción de configuración propia, en lugar de `actions/setup-go`, y el backend exige `go 1.27.3` en su fichero de módulo. Traefik no se compila desde la imagen: su script `build.sh` espera una copia ya compilada del fork en un directorio vecino y genera el binario fuera de un contenedor. Véase Proxy TLS con Traefik.",{"_3839":80393,"_33145":80372,"_22633":135984,"_5":15597,"_29869":135939,"_3292":135985},[],"<Card title=\"Algoritmos\" description=\"Los identificadores y conjuntos de parámetros que hay detrás de estas constantes.\" href=\"/docs/platform/pqc/algorithms\" />",{"_3839":80394,"_33145":80372,"_22633":135987,"_5":15597,"_29869":135939,"_3292":135988},[],"<Card title=\"Proxy TLS con Traefik\" description=\"Cómo se usa el fork para terminar el TLS de los dispositivos.\" href=\"/docs/platform/pqc/tls-front-proxy\" />",{"_3839":80395,"_33145":80395,"_5":15996,"_3292":135990,"_33551":135991,"_22633":135992,"_29869":80395},"Claves y autoridades de certificación",[54324,128959,135329,135660],[],{"_3839":80396,"_33145":80395,"_22633":135994,"_5":15597,"_29869":80395,"_3292":135995},[],"Crear claves y CA poscuánticas, firmar con ellas y emitir certificados, con el soporte de motores, los valores de la API y las restricciones aplicables.",{"_3839":80397,"_33145":80395,"_5":33548,"_22633":135997,"_29869":135998,"_3292":135999},[],"/docs/pr-preview/pr-58/es/platform/pqc/keys-and-cas#elegir-un-motor-criptográfico-compatible","Elegir un motor criptográfico compatible",{"_3839":80398,"_33145":80395,"_5":33548,"_22633":136001,"_29869":136002,"_3292":136003},[],"/docs/pr-preview/pr-58/es/platform/pqc/keys-and-cas#crear-una-clave","Crear una clave",{"_3839":80399,"_33145":80395,"_5":33548,"_22633":136005,"_29869":136006,"_3292":136007},[],"/docs/pr-preview/pr-58/es/platform/pqc/keys-and-cas#crear-una-autoridad-de-certificación","Crear una autoridad de certificación",{"_3839":80400,"_33145":80395,"_5":33548,"_22633":136009,"_29869":136010,"_3292":136011},[],"/docs/pr-preview/pr-58/es/platform/pqc/keys-and-cas#combinar-algoritmos-en-una-jerarquía","Combinar algoritmos en una jerarquía",{"_3839":80401,"_33145":80395,"_5":33548,"_22633":136013,"_29869":136014,"_3292":136015},[],"/docs/pr-preview/pr-58/es/platform/pqc/keys-and-cas#firmar-y-verificar-con-una-clave","Firmar y verificar con una clave",{"_3839":80402,"_33145":80395,"_5":33548,"_22633":136017,"_29869":136018,"_3292":136019},[],"/docs/pr-preview/pr-58/es/platform/pqc/keys-and-cas#restricciones-a-tener-en-cuenta","Restricciones a tener en cuenta",{"_3839":80403,"_33145":80395,"_22633":136021,"_5":15597,"_29869":80395,"_3292":136022},[],"El backend de Lamassu trata las claves poscuánticas como un tipo más de clave del servicio de gestión de claves (KMS). Una autoridad de certificación creada con una clave así firma certificados y listas de revocación por las mismas rutas que una CA RSA o ECDSA, porque la firma la realiza el fork de Go. Esta página explica qué enviar a la API, qué motores criptográficos pueden custodiar las claves y dónde difiere el comportamiento respecto a las claves clásicas. El backend debe compilarse con el toolchain de Go PQC.",{"_3839":80404,"_33145":80395,"_22633":136024,"_5":15597,"_29869":135998,"_3292":136025},[],"No todos los motores criptográficos pueden crear o custodiar claves poscuánticas. Solo pueden los motores que ejecutan la criptografía dentro del proceso de Lamassu.",{"_3839":80405,"_33145":80395,"_22633":136027,"_5":15597,"_29869":135998,"_3292":136028},[],"Motor",{"_3839":80406,"_33145":80395,"_22633":136030,"_5":15597,"_29869":135998,"_3292":63091},[],{"_3839":80407,"_33145":80395,"_22633":136032,"_5":15597,"_29869":135998,"_3292":63094},[],{"_3839":80408,"_33145":80395,"_22633":136034,"_5":15597,"_29869":135998,"_3292":136035},[],"Soportado",{"_3839":80409,"_33145":80395,"_22633":136037,"_5":15597,"_29869":135998,"_3292":63100},[],{"_3839":80410,"_33145":80395,"_22633":136039,"_5":15597,"_29869":135998,"_3292":136035},[],{"_3839":80411,"_33145":80395,"_22633":136041,"_5":15597,"_29869":135998,"_3292":63105},[],{"_3839":80412,"_33145":80395,"_22633":136043,"_5":15597,"_29869":135998,"_3292":136044},[],"No soportado",{"_3839":80413,"_33145":80395,"_22633":136046,"_5":15597,"_29869":135998,"_3292":61229},[],{"_3839":80414,"_33145":80395,"_22633":136048,"_5":15597,"_29869":135998,"_3292":136044},[],{"_3839":80415,"_33145":80395,"_22633":136050,"_5":15597,"_29869":135998,"_3292":61233},[],{"_3839":80416,"_33145":80395,"_22633":136052,"_5":15597,"_29869":135998,"_3292":136044},[],{"_3839":80417,"_33145":80395,"_22633":136054,"_5":15597,"_29869":135998,"_3292":136055},[],"Azure Key Vault y Azure Secrets",{"_3839":80418,"_33145":80395,"_22633":136057,"_5":15597,"_29869":135998,"_3292":136044},[],{"_3839":80419,"_33145":80395,"_22633":136059,"_5":15597,"_29869":135998,"_3292":63124},[],{"_3839":80420,"_33145":80395,"_22633":136061,"_5":15597,"_29869":135998,"_3292":136044},[],{"_3839":80421,"_33145":80395,"_22633":136063,"_5":15597,"_29869":135998,"_3292":136064},[],"En la práctica, las claves poscuánticas requieren por ahora el motor filesystem, que tiene nivel de seguridad 1. No hay claves con un nivel de garantía superior, en un módulo de seguridad hardware o en un KMS en la nube, para estos algoritmos.",{"_3839":80422,"_33145":80395,"_22633":136066,"_5":15597,"_29869":135998,"_3292":136067},[],"Los motores Vault KV2 y AWS Secrets Manager incluyen los tipos de clave poscuánticos entre los que dicen soportar, por lo que una petición supera la comprobación de compatibilidad. La creación falla después con un error `unsupported key type` del motor. Debe seleccionarse explícitamente un motor filesystem o software con `engine_id`.",{"_3839":80423,"_33145":80395,"_22633":136069,"_5":15597,"_29869":136002,"_3292":136070},[],"Una clave del KMS se crea con el algoritmo y el tamaño descritos en Algoritmos:",{"_3839":80424,"_33145":80395,"_22633":136072,"_5":15597,"_29869":136002,"_3292":136073},[],"Los parámetros inválidos se rechazan con un mensaje explícito: un tamaño de ML-DSA distinto de 44, 65 o 87, un identificador de SLH-DSA fuera del rango 1 a 12, una variante composite fuera del rango 1 a 15, o una variante composite que no pertenece a la familia solicitada. La importación de una clave privada en formato PKCS#8 detecta automáticamente el algoritmo y el conjunto de parámetros; admite claves ML-DSA, SLH-DSA, composite y Ed25519.",{"_3839":80425,"_33145":80395,"_22633":136075,"_5":15597,"_29869":136006,"_3292":136076},[],"Una CA con clave poscuántica usa la misma petición que cualquier otra CA, enviada a `POST /api/ca/v1/cas`. Solo cambia `key_metadata`, donde `bits` transporta el conjunto de parámetros. Una CA raíz con ML-DSA-65:",{"_3839":80426,"_33145":80395,"_22633":136078,"_5":15597,"_29869":136006,"_3292":136079},[],"Una CA raíz con clave composite de ML-DSA-44 y ECDSA P-256 usa `\"key_metadata\": { \"type\": \"Composite-ML-DSA-ECDSA\", \"bits\": 9 }`. Ed25519 usa `\"type\": \"Ed25519\", \"bits\": 256` y SLH-DSA usa `\"type\": \"SLH-DSA\", \"bits\": 1` para seleccionar SLH-DSA-SHA2-128s. Las CA subordinadas se crean del mismo modo: la subordinada firma su propia solicitud de certificado con la clave del KMS y la CA padre emite el certificado.",{"_3839":80427,"_33145":80395,"_22633":136081,"_5":15597,"_29869":136006,"_3292":136082},[],"Es posible importar CA existentes con una clave privada poscuántica en el caso de ML-DSA y Ed25519. La importación de una CA con clave SLH-DSA o composite no está soportada.",{"_3839":80428,"_33145":80395,"_22633":136084,"_5":15597,"_29869":136010,"_3292":136085},[],"El backend no impone restricciones sobre qué algoritmo emite a cuál. Una CA con clave ML-DSA puede emitir certificados a sujetos RSA, ECDSA, Ed25519 y ML-DSA, y una CA RSA o ECDSA puede emitir certificados a sujetos poscuánticos. La batería de pruebas cubre a través de la API la matriz completa de ML-DSA y Ed25519, y cubre CA y hojas SLH-DSA y composite a nivel del motor de certificados. Esto permite introducir una CA poscuántica bajo una raíz clásica, o a la inversa, pero la parte que confía debe poder verificar todos los algoritmos de la cadena. En TLS, las firmas de la cadena de certificados se comprueban frente a la extensión `signature_algorithms_cert` del cliente, por lo que una cadena firmada con ML-DSA o con un algoritmo composite necesita un cliente que lo anuncie ahí.",{"_3839":80429,"_33145":80395,"_22633":136087,"_5":15597,"_29869":136014,"_3292":136088},[],"El endpoint de firma del KMS acepta nuevos valores de `signature_algorithm`. El campo `message_type` se ignora en todos ellos. Los valores de ML-DSA, SLH-DSA y Ed25519 son «pure»: el mensaje se firma directamente, sin prehash (no son HashML-DSA, HashSLH-DSA ni Ed25519ph). Los valores composite calculan el hash del mensaje con el hash de la variante y firman un mensaje representativo que incluye una etiqueta fija y el contexto opcional.",{"_3839":80430,"_33145":80395,"_22633":136090,"_5":15597,"_29869":136014,"_3292":135262},[],{"_3839":80431,"_33145":80395,"_22633":136092,"_5":15597,"_29869":136014,"_3292":63158},[],{"_3839":80432,"_33145":80395,"_22633":136094,"_5":15597,"_29869":136014,"_3292":63161},[],{"_3839":80433,"_33145":80395,"_22633":136096,"_5":15597,"_29869":136014,"_3292":63164},[],{"_3839":80434,"_33145":80395,"_22633":136098,"_5":15597,"_29869":136014,"_3292":62338},[],{"_3839":80435,"_33145":80395,"_22633":136100,"_5":15597,"_29869":136014,"_3292":63169},[],{"_3839":80436,"_33145":80395,"_22633":136102,"_5":15597,"_29869":136014,"_3292":63172},[],{"_3839":80437,"_33145":80395,"_22633":136104,"_5":15597,"_29869":136014,"_3292":63175},[],{"_3839":80438,"_33145":80395,"_22633":136106,"_5":15597,"_29869":136014,"_3292":62346},[],{"_3839":80439,"_33145":80395,"_22633":136108,"_5":15597,"_29869":136014,"_3292":63180},[],{"_3839":80440,"_33145":80395,"_22633":136110,"_5":15597,"_29869":136014,"_3292":136111},[],"El backend no comprueba que el algoritmo coincida con la clave; debe elegirse el valor que corresponde al tipo de clave. Cuando una CA firma un certificado o una lista de revocación, el algoritmo se selecciona automáticamente.",{"_3839":80441,"_33145":80395,"_22633":136113,"_5":15597,"_29869":136018,"_3292":136114},[],"Varias partes de la plataforma aún no gestionan claves poscuánticas. Se reúnen en Limitaciones conocidas; las que afectan a la operación diaria son las siguientes.",{"_3839":80442,"_33145":80395,"_22633":136116,"_5":15597,"_29869":136018,"_3292":136117},[],"Los perfiles de emisión aplican restricciones de clave solo a RSA y ECDSA, mediante `allow_rsa_keys` y `allow_ecdsa_keys`. Un perfil con la aplicación de restricciones activada no bloquea las claves poscuánticas, y no dispone de un interruptor para permitirlas o denegarlas.",{"_3839":80443,"_33145":80395,"_22633":136119,"_5":15597,"_29869":136018,"_3292":136120},[],"La fortaleza de clave registrada para un certificado cuya clave es poscuántica o Ed25519 solo se calcula para RSA y ECDSA, por lo que esos certificados se almacenan con tipo y tamaño de clave desconocidos y fortaleza baja.",{"_3839":80444,"_33145":80395,"_22633":136122,"_5":15597,"_29869":136018,"_3292":136123},[],"Las respuestas OCSP se firman con la biblioteca `golang.org/x/crypto/ocsp`, que solo admite claves de firma RSA y ECDSA. No cabe esperar, por tanto, que una CA con clave poscuántica, Ed25519 o composite pueda firmar respuestas OCSP; las CRL se generan con el fork y no se ven afectadas por este límite, aunque no tienen pruebas.",{"_3839":80445,"_33145":80395,"_22633":136125,"_5":15597,"_29869":136018,"_3292":136126},[],"La generación de claves en el servidor del DMS (la operación `serverkeygen` de EST) genera únicamente claves RSA y ECDSA.",{"_3839":80446,"_33145":80395,"_22633":136128,"_5":15597,"_29869":136018,"_3292":136129},[],"<Card title=\"Certificados relacionados\" description=\"Vincular un certificado poscuántico a uno clásico existente.\" href=\"/docs/platform/pqc/related-certificates\" />",{"_3839":80447,"_33145":80395,"_22633":136131,"_5":15597,"_29869":136018,"_3292":136132},[],"<Card title=\"Dashboard\" description=\"Crear los mismos objetos desde la interfaz web.\" href=\"/docs/platform/pqc/dashboard\" />",{"_3839":80448,"_33145":80448,"_5":15996,"_3292":136134,"_33551":136135,"_22633":136137,"_29869":80448},"Limitaciones conocidas",[54324,128959,135329,136136],"Referencia",[],{"_3839":80449,"_33145":80448,"_22633":136139,"_5":15597,"_29869":80448,"_3292":136140},[],"Qué está incompleto, es no estándar o no está verificado en el soporte poscuántico de Lamassu, agrupado por componente.",{"_3839":80450,"_33145":80448,"_5":33548,"_22633":136142,"_29869":136143,"_3292":136144},[],"/docs/pr-preview/pr-58/es/platform/pqc/limitations#estándares-e-interoperabilidad","Estándares e interoperabilidad",{"_3839":80451,"_33145":80448,"_5":33548,"_22633":136146,"_29869":136147,"_3292":136148},[],"/docs/pr-preview/pr-58/es/platform/pqc/limitations#claves-y-motores","Claves y motores",{"_3839":80452,"_33145":80448,"_5":33548,"_22633":136150,"_29869":136151,"_3292":136152},[],"/docs/pr-preview/pr-58/es/platform/pqc/limitations#autoridad-de-certificación-y-validación","Autoridad de certificación y validación",{"_3839":80453,"_33145":80448,"_5":33548,"_22633":136154,"_29869":136155,"_3292":62695},[],"/docs/pr-preview/pr-58/es/platform/pqc/limitations#dashboard",{"_3839":80454,"_33145":80448,"_5":33548,"_22633":136157,"_29869":136158,"_3292":136159},[],"/docs/pr-preview/pr-58/es/platform/pqc/limitations#compilación-y-despliegue","Compilación y despliegue",{"_3839":80455,"_33145":80448,"_22633":136161,"_5":15597,"_29869":80448,"_3292":136162},[],"Esta página reúne los límites de la implementación actual para valorarlos antes de planificar un despliegue. Cada uno se ha observado en el código o en las pruebas de las ramas descritas en esta sección.",{"_3839":80456,"_33145":80448,"_22633":136164,"_5":15597,"_29869":136143,"_3292":136165},[],"Los certificados composite se implementaron y se probaron contra el borrador 19 de la especificación de firmas composite del IETF, que desde entonces se ha publicado como RFC 10073; la implementación no se ha comparado con el texto final. Tres de sus algoritmos (las dos variantes Brainpool y Ed448) no están implementados. Los esquemas de firma composite en TLS usan puntos de código de uso privado de `0xFE00` a `0xFE0E` y en el código no se identifica ningún borrador ni versión publicados, por lo que solo interoperan con pares construidos con el mismo fork de Go. Las variantes composite con RSA PKCS#1 v1.5 no pueden autenticar un handshake TLS. SLH-DSA no tiene esquema de firma TLS. El atributo de solicitud de certificado relacionado no se ha contrastado con otras implementaciones del RFC 9763.",{"_3839":80457,"_33145":80448,"_22633":136167,"_5":15597,"_29869":136147,"_3292":136168},[],"Las claves poscuánticas, composite y Ed25519 funcionan solo con los motores filesystem y software. Los motores Vault KV2 y AWS Secrets Manager anuncian soporte y después fallan en la creación, y AWS KMS, Azure y PKCS#11 no las soportan. No existe, por tanto, ninguna clave poscuántica respaldada por hardware o por un KMS en la nube. Algunos mensajes de error de los motores están copiados de otros motores y nombran el motor equivocado.",{"_3839":80458,"_33145":80448,"_22633":136170,"_5":15597,"_29869":136147,"_3292":136171},[],"La interfaz `CryptoEngine` ha incorporado métodos para crear e importar cada nuevo tipo de clave. Los motores desarrollados fuera del repositorio de Lamassu deben implementarlos.",{"_3839":80459,"_33145":80448,"_22633":136173,"_5":15597,"_29869":136151,"_3292":136174},[],"Una CA con clave poscuántica, Ed25519 o composite no puede firmar respuestas OCSP, porque la biblioteca de firma solo admite RSA y ECDSA. Se espera que la generación de CRL funcione, ya que usa la firma del fork, pero ni CRL ni OCSP tienen pruebas con estas claves.",{"_3839":80460,"_33145":80448,"_22633":136176,"_5":15597,"_29869":136151,"_3292":136177},[],"Los perfiles de emisión no pueden permitir ni denegar algoritmos poscuánticos; su aplicación de restricciones afecta solo a RSA y ECDSA. La fortaleza de clave de un certificado emitido solo se calcula para RSA y ECDSA, por lo que los demás certificados se almacenan con tipo y tamaño desconocidos y fortaleza baja. No está soportada la importación de una CA existente con clave SLH-DSA o composite.",{"_3839":80461,"_33145":80448,"_22633":136179,"_5":15597,"_29869":136151,"_3292":136180},[],"El DMS solo puede generar claves en el servidor para RSA y ECDSA, de modo que `serverkeygen` no puede devolver una clave poscuántica. Los flujos de enrolamiento por EST y por el device manager no tienen pruebas con claves poscuánticas.",{"_3839":80462,"_33145":80448,"_22633":136182,"_5":15597,"_29869":136151,"_3292":136183},[],"El backend no evalúa la extensión de certificado relacionado. Solo la emite.",{"_3839":80463,"_33145":80448,"_22633":136185,"_5":15597,"_29869":136155,"_3292":136186},[],"El generador de claves SLH-DSA del navegador asigna los identificadores de conjunto de parámetros de forma distinta al resto de la interfaz, según se describe en Dashboard. Los nombres de los tipos de clave no son uniformes entre pantallas, y la interfaz no incluye aviso de carácter experimental ni traducción.",{"_3839":80464,"_33145":80448,"_22633":136188,"_5":15597,"_29869":136158,"_3292":136189},[],"Todo depende de forks de Go y de Traefik que no son los proyectos originales, y la imagen del proxy tiene una etiqueta mutable. La especificación OpenAPI del KMS del backend sigue listando solo RSA, ECDSA y Ed25519 y no refleja los nuevos tipos de clave.",{"_3839":80465,"_33145":80448,"_22633":136191,"_5":15597,"_29869":136158,"_3292":136192},[],"El Helm chart usa nombres de recurso fijos, admite una sola release por espacio de nombres y envía el tráfico de Traefik a Envoy sin verificar certificados. Los certificados poscuánticos que crea el instalador son válidos durante 365 días y no se renuevan. El instalador necesita un host Linux y ejecuta una instalación de Helm, no una actualización.",{"_3839":80466,"_33145":80448,"_22633":136194,"_5":15597,"_29869":136158,"_3292":136195},[],"<Card title=\"Visión general de la criptografía poscuántica\" description=\"Volver al resumen de la sección.\" href=\"/docs/platform/pqc/overview\" />",{"_3839":80467,"_33145":80467,"_5":15996,"_3292":136197,"_33551":136198,"_22633":136199,"_29869":80467},"Visión general de la criptografía poscuántica",[54324,128959,135329],[],{"_3839":80468,"_33145":80467,"_22633":136201,"_5":15597,"_29869":80467,"_3292":136202},[],"Qué soporte poscuántico (PQC) añade Lamassu a las claves, las autoridades de certificación, el TLS de los dispositivos y el despliegue, y cómo encajan sus piezas.",{"_3839":80469,"_33145":80467,"_5":33548,"_22633":136204,"_29869":136205,"_3292":136206},[],"/docs/pr-preview/pr-58/es/platform/pqc/overview#por-qué-importa-en-flotas-de-dispositivos","Por qué importa en flotas de dispositivos",{"_3839":80470,"_33145":80467,"_5":33548,"_22633":136208,"_29869":136209,"_3292":136210},[],"/docs/pr-preview/pr-58/es/platform/pqc/overview#tres-familias-de-algoritmos","Tres familias de algoritmos",{"_3839":80471,"_33145":80467,"_5":33548,"_22633":136212,"_29869":136213,"_3292":136214},[],"/docs/pr-preview/pr-58/es/platform/pqc/overview#cómo-encajan-las-piezas","Cómo encajan las piezas",{"_3839":80472,"_33145":80467,"_5":33548,"_22633":136216,"_29869":136217,"_3292":136218},[],"/docs/pr-preview/pr-58/es/platform/pqc/overview#por-dónde-continuar","Por dónde continuar",{"_3839":80473,"_33145":80467,"_22633":136220,"_5":15597,"_29869":80467,"_3292":136221},[],"Lamassu puede crear claves, autoridades de certificación (CA) y certificados que usan algoritmos de firma poscuánticos, y puede servirlos y verificarlos por TLS. El trabajo abarca cinco bases de código que dependen unas de otras: un fork del toolchain de Go que implementa los algoritmos, el backend de Lamassu, el dashboard web, un fork del proxy Traefik que termina el TLS de los dispositivos y el Helm chart que despliega todo junto.",{"_3839":80474,"_33145":80467,"_22633":136223,"_5":15597,"_29869":80467,"_3292":136224},[],"El soporte PQC reside en ramas de desarrollo y en forks de Go y Traefik, no en los proyectos originales ni en las imágenes estándar de Lamassu. Los esquemas de firma TLS composite usan puntos de código de uso privado que ninguna otra pila TLS reconoce, y el formato de certificado composite sigue un borrador del IETF que todavía puede cambiar. Conviene planificar pilotos y despliegues de laboratorio, no flotas en producción. Limitaciones conocidas recoge lo que está incompleto.",{"_3839":80475,"_33145":80467,"_22633":136226,"_5":15597,"_29869":136205,"_3292":136227},[],"Los certificados emitidos a dispositivos suelen durar años, y los dispositivos que los almacenan son difíciles de sustituir. Un algoritmo de firma que un futuro ordenador cuántico llegase a romper obligaría a re-enrolar toda la flota. Emitir hoy certificados firmados con un algoritmo poscuántico o composite, y ofrecer un endpoint TLS que los acepte, permite validar la flota frente a ese riesgo antes de que sea urgente. Las firmas no están expuestas a ataques de tipo «almacenar ahora, descifrar después» como lo está un intercambio de claves, por lo que la urgencia depende de la vida útil de los certificados y de los dispositivos, no del tráfico registrado.",{"_3839":80476,"_33145":80467,"_22633":136229,"_5":15597,"_29869":136209,"_3292":136230},[],"Lamassu agrupa los algoritmos de firma en tres familias, con las mismas etiquetas que muestra el dashboard.",{"_3839":80477,"_33145":80467,"_22633":136232,"_5":15597,"_29869":136209,"_3292":136233},[],"Etiqueta",{"_3839":80478,"_33145":80467,"_22633":136235,"_5":15597,"_29869":136209,"_3292":135516},[],{"_3839":80479,"_33145":80467,"_22633":136237,"_5":15597,"_29869":136209,"_3292":135327},[],{"_3839":80480,"_33145":80467,"_22633":136239,"_5":15597,"_29869":136209,"_3292":63312},[],{"_3839":80481,"_33145":80467,"_22633":136241,"_5":15597,"_29869":136209,"_3292":136242},[],"Tradicional",{"_3839":80482,"_33145":80467,"_22633":136244,"_5":15597,"_29869":136209,"_3292":63318},[],{"_3839":80483,"_33145":80467,"_22633":136246,"_5":15597,"_29869":136209,"_3292":63321},[],{"_3839":80484,"_33145":80467,"_22633":136248,"_5":15597,"_29869":136209,"_3292":136249},[],"Poscuántica pura",{"_3839":80485,"_33145":80467,"_22633":136251,"_5":15597,"_29869":136209,"_3292":63327},[],{"_3839":80486,"_33145":80467,"_22633":136253,"_5":15597,"_29869":136209,"_3292":63330},[],{"_3839":80487,"_33145":80467,"_22633":136255,"_5":15597,"_29869":136209,"_3292":136256},[],"Híbrida (composite)",{"_3839":80488,"_33145":80467,"_22633":136258,"_5":15597,"_29869":136209,"_3292":136259},[],"ML-DSA combinado con RSA, ECDSA o Ed25519 en una única clave y una única firma",{"_3839":80489,"_33145":80467,"_22633":136261,"_5":15597,"_29869":136209,"_3292":136262},[],"Una firma composite solo es válida si se verifican sus dos componentes. Está pensada para que no sea falsificable mientras al menos uno de los dos algoritmos siga sin romperse, siempre que la parte que confía exija el composite y no recurra a un certificado clásico. En el intercambio de claves, `PQ/T` significa un grupo híbrido que combina un intercambio clásico y uno ML-KEM, y `PQ` significa ML-KEM puro. Algoritmos describe cada uno y los conjuntos de parámetros que Lamassu acepta.",{"_3839":80490,"_33145":80467,"_22633":136264,"_5":15597,"_29869":136213,"_3292":136265},[],"El fork de Go es la base: el backend y Traefik se compilan con él, porque el toolchain estándar de Go no incluye el soporte de certificados composite y SLH-DSA. El backend crea y custodia las claves, emite certificados y firma los datos de revocación. El dashboard usa la misma API REST. Los dispositivos llegan a la plataforma a través de Traefik, que negocia con ellos la autenticación y el intercambio de claves poscuánticos y después reenvía la petición a Envoy Gateway mediante TLS ordinario. La protección poscuántica se aplica, por tanto, solo al salto entre el dispositivo y Traefik.",{"_3839":80491,"_33145":80467,"_22633":136267,"_5":15597,"_29869":136217,"_3292":136268},[],"Conviene leer primero Algoritmos para conocer qué se soporta y cómo se escriben los conjuntos de parámetros en las peticiones a la API. Quien desarrolle un cliente de dispositivo debe seguir con Toolchain de Go PQC. Para crear una CA poscuántica, el camino es Claves y autoridades de certificación, y quien despliegue la plataforma consultará Despliegue con el Helm chart.",{"_3839":80492,"_33145":80467,"_22633":136270,"_5":15597,"_29869":136217,"_3292":136271},[],"<Card title=\"Algoritmos\" description=\"ML-DSA, SLH-DSA y los 15 algoritmos composite, con sus conjuntos de parámetros.\" href=\"/docs/platform/pqc/algorithms\" />",{"_3839":80493,"_33145":80467,"_22633":136273,"_5":15597,"_29869":136217,"_3292":136274},[],"<Card title=\"Claves y autoridades de certificación\" description=\"Crear claves y CA poscuánticas y emitir certificados mediante la API.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_3839":80494,"_33145":80467,"_22633":136276,"_5":15597,"_29869":136217,"_3292":136277},[],"<Card title=\"Despliegue con el Helm chart\" description=\"Instalar la plataforma con un proxy Traefik que sirve certificados PQC.\" href=\"/docs/platform/pqc/deployment\" />",{"_3839":80495,"_33145":80495,"_5":15996,"_3292":135680,"_33551":136279,"_22633":136280,"_29869":80495},[54324,128959,135329,135660],[],{"_3839":80496,"_33145":80495,"_22633":136282,"_5":15597,"_29869":80495,"_3292":136283},[],"Vincular un certificado con clave poscuántica a un certificado clásico existente del mismo dispositivo, según el RFC 9763, y cómo los emite y comprueba Lamassu.",{"_3839":80497,"_33145":80495,"_5":33548,"_22633":136285,"_29869":136286,"_3292":136287},[],"/docs/pr-preview/pr-58/es/platform/pqc/related-certificates#cómo-funciona-la-solicitud","Cómo funciona la solicitud",{"_3839":80498,"_33145":80495,"_5":33548,"_22633":136289,"_29869":136290,"_3292":136291},[],"/docs/pr-preview/pr-58/es/platform/pqc/related-certificates#ubicaciones-desde-las-que-la-ca-puede-descargar","Ubicaciones desde las que la CA puede descargar",{"_3839":80499,"_33145":80495,"_5":33548,"_22633":136293,"_29869":136294,"_3292":136295},[],"/docs/pr-preview/pr-58/es/platform/pqc/related-certificates#configurar-un-perfil-de-emisión","Configurar un perfil de emisión",{"_3839":80500,"_33145":80495,"_5":33548,"_22633":136297,"_29869":136298,"_3292":136299},[],"/docs/pr-preview/pr-58/es/platform/pqc/related-certificates#qué-debe-cumplir-el-certificado-emitido","Qué debe cumplir el certificado emitido",{"_3839":80501,"_33145":80495,"_5":33548,"_22633":136301,"_29869":136302,"_3292":136303},[],"/docs/pr-preview/pr-58/es/platform/pqc/related-certificates#desde-el-dashboard","Desde el dashboard",{"_3839":80502,"_33145":80495,"_22633":136305,"_5":15597,"_29869":80495,"_3292":136306},[],"Una flota que migra a algoritmos poscuánticos suele mantener durante un tiempo dos certificados por dispositivo: el clásico que ya se usa y uno nuevo con clave poscuántica. El RFC 9763 define una forma de enlazarlos. El certificado nuevo lleva la extensión `id-pe-relatedCert` (`1.3.6.1.5.5.7.1.36`), que contiene un hash del certificado clásico, de modo que una parte que confía puede comprobar que ambos identifican a la misma entidad. Lamassu implementa el lado emisor de este mecanismo.",{"_3839":80503,"_33145":80495,"_22633":136308,"_5":15597,"_29869":136286,"_3292":136309},[],"El dispositivo solicita el certificado vinculado con una solicitud PKCS#10 ordinaria que incluye un atributo adicional, `relatedCertRequest` (`1.2.840.113549.1.9.16.2.60`). El atributo identifica el certificado existente por emisor y número de serie, indica la hora de la solicitud, indica la ubicación desde la que puede descargarse el certificado y lleva una firma realizada con la clave privada de ese certificado existente. La firma cubre el emisor, el número de serie y la hora de la solicitud, no la ubicación, y demuestra que quien solicita controla la clave existente; la clave del nuevo certificado se prueba con la firma de la propia solicitud de certificado. Lamassu acepta una lista de ubicaciones, como en el módulo ASN.1 del RFC, y las prueba en orden.",{"_3839":80504,"_33145":80495,"_22633":136311,"_5":15597,"_29869":136286,"_3292":136312},[],"Cuando el servicio de CA recibe una solicitud así, sigue estos pasos:",{"_3839":80505,"_33145":80495,"_22633":136314,"_5":15597,"_29869":136286,"_3292":136315},[],"Comprueba que el perfil de emisión en uso habilita los certificados relacionados y, en caso contrario, rechaza la solicitud.",{"_3839":80506,"_33145":80495,"_22633":136317,"_5":15597,"_29869":136286,"_3292":136318},[],"Recorre en orden las ubicaciones del atributo y descarga el primer certificado que logra obtener.",{"_3839":80507,"_33145":80495,"_22633":136320,"_5":15597,"_29869":136286,"_3292":136321},[],"Verifica que el emisor y el número de serie coinciden, que la hora de la solicitud está dentro de la antigüedad permitida y que la firma es válida con la clave del certificado descargado.",{"_3839":80508,"_33145":80495,"_22633":136323,"_5":15597,"_29869":136286,"_3292":136324},[],"Emite el nuevo certificado con la extensión de certificado relacionado añadida.",{"_3839":80509,"_33145":80495,"_22633":136326,"_5":15597,"_29869":136286,"_3292":136327},[],"Una solicitud sin el atributo se procesa con normalidad, tanto si el perfil habilita la función como si no.",{"_3839":80510,"_33145":80495,"_22633":136329,"_5":15597,"_29869":136290,"_3292":136330},[],"Una ubicación es un URI `data:` o una URL `http` o `https`. Un URI `data:` debe estar codificado en base64 y contiene una estructura PKCS#7 cuyo primer certificado es el relacionado; no requiere acceso a la red y siempre se acepta cuando la función está habilitada. Una URL solo se descarga si su host figura en la lista de hosts permitidos del perfil. La CA no sigue redirecciones, aplica un tiempo de espera de diez segundos y rechaza respuestas de más de 1 MiB.",{"_3839":80511,"_33145":80495,"_22633":136332,"_5":15597,"_29869":136290,"_3292":136333},[],"Como la descarga la realiza el servidor, quien puede definir un perfil de emisión decide a qué hosts puede conectarse la CA. Conviene restringir ese permiso en consecuencia e incluir solo repositorios internos de certificados.",{"_3839":80512,"_33145":80495,"_22633":136335,"_5":15597,"_29869":136294,"_3292":136336},[],"La función se configura en el objeto `related_certificate` del perfil de emisión, que se almacena en columnas propias de la base de datos:",{"_3839":80513,"_33145":80495,"_22633":136338,"_5":15597,"_29869":136294,"_3292":135784},[],{"_3839":80514,"_33145":80495,"_22633":136340,"_5":15597,"_29869":136294,"_3292":131573},[],{"_3839":80515,"_33145":80495,"_22633":136342,"_5":15597,"_29869":136294,"_3292":135789},[],{"_3839":80516,"_33145":80495,"_22633":136344,"_5":15597,"_29869":136294,"_3292":131579},[],{"_3839":80517,"_33145":80495,"_22633":136346,"_5":15597,"_29869":136294,"_3292":63425},[],{"_3839":80518,"_33145":80495,"_22633":136348,"_5":15597,"_29869":136294,"_3292":108734},[],{"_3839":80519,"_33145":80495,"_22633":136350,"_5":15597,"_29869":136294,"_3292":62841},[],{"_3839":80520,"_33145":80495,"_22633":136352,"_5":15597,"_29869":136294,"_3292":136353},[],"Con `false`, se rechaza una solicitud que lleve el atributo.",{"_3839":80521,"_33145":80495,"_22633":136355,"_5":15597,"_29869":136294,"_3292":63435},[],{"_3839":80522,"_33145":80495,"_22633":136357,"_5":15597,"_29869":136294,"_3292":136358},[],"lista de cadenas",{"_3839":80523,"_33145":80495,"_22633":136360,"_5":15597,"_29869":136294,"_3292":136361},[],"vacía",{"_3839":80524,"_33145":80495,"_22633":136363,"_5":15597,"_29869":136294,"_3292":136364},[],"Hosts desde los que se pueden descargar ubicaciones `http` y `https`.",{"_3839":80525,"_33145":80495,"_22633":136366,"_5":15597,"_29869":136294,"_3292":63446},[],{"_3839":80526,"_33145":80495,"_22633":136368,"_5":15597,"_29869":136294,"_3292":136369},[],"duración",{"_3839":80527,"_33145":80495,"_22633":136371,"_5":15597,"_29869":136294,"_3292":63451},[],{"_3839":80528,"_33145":80495,"_22633":136373,"_5":15597,"_29869":136294,"_3292":136374},[],"Diferencia máxima entre la hora de la solicitud del atributo y el momento de la emisión.",{"_3839":80529,"_33145":80495,"_22633":136376,"_5":15597,"_29869":136298,"_3292":136377},[],"El fork se niega a vincular un certificado salvo que el nuevo sea compatible con el relacionado. Ninguno de los dos puede ser una CA. El certificado relacionado debe estar vigente en el momento de la emisión. Los usos de clave y los usos extendidos de clave solicitados para el nuevo certificado deben ser un subconjunto de los del certificado relacionado. La verificación posterior compara únicamente el hash, de modo que una parte que confía y comprueba el enlace averigua que la CA emisora vinculó el nuevo certificado a ese certificado concreto, no que el certificado relacionado siga siendo válido.",{"_3839":80530,"_33145":80495,"_22633":136379,"_5":15597,"_29869":136302,"_3292":136380},[],"El dashboard expone la función en dos lugares. El formulario del perfil de emisión tiene una sección *Related Certificates* con un interruptor, los hosts permitidos y la antigüedad máxima. Al emitir un certificado desde una CA con una clave generada en el navegador y un perfil que habilita la función, el formulario ofrece *Bind to a related certificate*: quien emite aporta el certificado existente, o su emisor y número de serie, firma los datos mostrados con la clave existente fuera del navegador y pega la firma. Los detalles de certificados y CA muestran una fila *Related Certificate* con el algoritmo de hash y el valor. Véase Dashboard.",{"_3839":80531,"_33145":80495,"_22633":136382,"_5":15597,"_29869":136302,"_3292":136383},[],"El certificado vinculado se crea con `CreateBoundCertificate` del fork, cuyas pruebas cubren una clave ML-DSA vinculada a certificados RSA, ECDSA y Ed25519. Las pruebas no usan claves composite. Solo el lado emisor está implementado en Lamassu: la plataforma no evalúa la extensión cuando valida certificados.",{"_3839":80532,"_33145":80495,"_22633":136385,"_5":15597,"_29869":136302,"_3292":136386},[],"<Card title=\"Claves y autoridades de certificación\" description=\"Crear la CA poscuántica que emite el certificado vinculado.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_3839":80533,"_33145":80495,"_22633":136388,"_5":15597,"_29869":136302,"_3292":136389},[],"<Card title=\"Limitaciones conocidas\" description=\"Lo que todavía no está cubierto.\" href=\"/docs/platform/pqc/limitations\" />",{"_3839":80534,"_33145":80534,"_5":15996,"_3292":136391,"_33551":136392,"_22633":136393,"_29869":80534},"Proxy TLS con Traefik",[54324,128959,135329,127528],[],{"_3839":80535,"_33145":80534,"_22633":136395,"_5":15597,"_29869":80534,"_3292":136396},[],"El fork de Traefik que termina el TLS de los dispositivos con certificados clásicos y poscuánticos para el mismo host, cómo elige certificado y cómo se compila.",{"_3839":80536,"_33145":80534,"_5":33548,"_22633":136398,"_29869":136399,"_3292":136400},[],"/docs/pr-preview/pr-58/es/platform/pqc/tls-front-proxy#varios-certificados-para-el-mismo-host","Varios certificados para el mismo host",{"_3839":80537,"_33145":80534,"_5":33548,"_22633":136402,"_29869":136403,"_3292":136404},[],"/docs/pr-preview/pr-58/es/platform/pqc/tls-front-proxy#opciones-tls-en-listeners-de-gateway-api","Opciones TLS en listeners de Gateway API",{"_3839":80538,"_33145":80534,"_5":33548,"_22633":136406,"_29869":136407,"_3292":136408},[],"/docs/pr-preview/pr-58/es/platform/pqc/tls-front-proxy#tls-mutuo","TLS mutuo",{"_3839":80539,"_33145":80534,"_5":33548,"_22633":136410,"_29869":136411,"_3292":136412},[],"/docs/pr-preview/pr-58/es/platform/pqc/tls-front-proxy#compilación-del-proxy","Compilación del proxy",{"_3839":80540,"_33145":80534,"_22633":136414,"_5":15597,"_29869":80534,"_3292":136415},[],"Los dispositivos se conectan a Lamassu por TLS, y el enrolamiento EST se apoya en TLS mutuo. Para aceptar un certificado poscuántico o composite en esa conexión, el endpoint TLS debe compilarse con el toolchain de Go PQC. Lamassu lo hace con un fork de Traefik, basado en Traefik 3.7.15, situado delante de Envoy Gateway. El fork añade dos comportamientos: puede servir varios certificados para el mismo host y elegir entre ellos según el cliente, y permite que un listener de Gateway API haga referencia a una opción TLS de Traefik.",{"_3839":80541,"_33145":80534,"_22633":136417,"_5":15597,"_29869":136399,"_3292":136418},[],"Traefik original conserva un certificado por conjunto de nombres. Si existen un certificado ECDSA clásico y un certificado ML-DSA para `lab.example.com`, solo se conserva el primero. El fork almacena cada certificado distinto (los duplicados se detectan comparando el certificado hoja) y elige uno en cada handshake.",{"_3839":80542,"_33145":80534,"_22633":136420,"_5":15597,"_29869":136399,"_3292":136421},[],"La elección sigue los algoritmos de firma que anuncia el cliente:",{"_3839":80543,"_33145":80534,"_22633":136423,"_5":15597,"_29869":136399,"_3292":136424},[],"Se normaliza el nombre de servidor del cliente y se reúnen los certificados cuyos nombres coinciden, con los nombres exactos por delante de los comodines. Un certificado con solo Common Name sigue coincidiendo.",{"_3839":80544,"_33145":80534,"_22633":136426,"_5":15597,"_29869":136399,"_3292":136427},[],"Si ningún certificado coincide, la conexión se cierra en modo SNI estricto, o se sirve el certificado por defecto.",{"_3839":80545,"_33145":80534,"_22633":136429,"_5":15597,"_29869":136399,"_3292":136430},[],"Si coincide exactamente un certificado, se sirve sin más comprobaciones.",{"_3839":80546,"_33145":80534,"_22633":136432,"_5":15597,"_29869":136399,"_3292":136433},[],"En otro caso, el proxy toma los esquemas de firma del cliente en el orden en que los envió y, para cada esquema, devuelve el primer certificado cuya clave permiten el esquema, la versión de TLS y el tipo de clave. Así se contrasta la clave hoja con `signature_algorithms`, los esquemas que el cliente acepta para la firma del handshake; las firmas del resto de la cadena son una comprobación distinta, frente a `signature_algorithms_cert`.",{"_3839":80547,"_33145":80534,"_22633":136435,"_5":15597,"_29869":136399,"_3292":136436},[],"Si el cliente no anuncia ningún esquema, se devuelve el primer certificado compatible. Si ninguno es compatible, se devuelve el primer candidato y el handshake falla con el error subyacente.",{"_3839":80548,"_33145":80534,"_22633":136438,"_5":15597,"_29869":136399,"_3292":136439},[],"Prevalece el orden de preferencia del cliente: un cliente que lista ML-DSA primero recibe el certificado poscuántico y uno que lista ECDSA primero recibe el clásico, aunque también soporte ML-DSA. Un cliente sin soporte poscuántico nunca anuncia esos esquemas y recibe el certificado clásico. TLS 1.2 nunca selecciona certificados ML-DSA ni composite. El servidor no puede configurarse con un orden de preferencia propio.",{"_3839":80549,"_33145":80534,"_22633":136441,"_5":15597,"_29869":136403,"_3292":136442},[],"Traefik lee su configuración de Gateway API desde Kubernetes. El fork lee la opción de listener `traefik.io/tls-options`, cuyo valor nombra la opción TLS que se aplica a ese listener: `default`, o un nombre cualificado como `traefik-system-pqc@kubernetescrd`. Funciona en listeners HTTPS y en listeners TLS en modo `Terminate` que sirven un `TLSRoute`. Se ignora en modo passthrough.",{"_3839":80550,"_33145":80534,"_22633":136444,"_5":15597,"_29869":136403,"_3292":136445},[],"En una opción TLS se establecen los grupos de intercambio de claves soportados y el modo de autenticación de cliente. Cuando varios listeners comparten un router padre y nombran opciones distintas, el proxy registra una advertencia y usa valores por defecto aislados para cada uno. Sin el fork, Traefik ignora la anotación, aplica sus propios valores por defecto y los ajustes no se pueden controlar; los dispositivos que necesitan TLS mutuo fallan entonces.",{"_3839":80551,"_33145":80534,"_22633":136447,"_5":15597,"_29869":136403,"_3292":136448},[],"El fork añade además `mlkem1024` a los nombres de grupo aceptados en `curvePreferences`, junto a los grupos híbridos que Traefik ya reconoce.",{"_3839":80552,"_33145":80534,"_22633":136450,"_5":15597,"_29869":136407,"_3292":136451},[],"La autenticación de cliente es el mecanismo estándar de Traefik, configurado en la opción TLS. Con `RequireAndVerifyClientCert` y un fichero de CA de cliente, el proxy valida la cadena, y la verificación de la firma del cliente la realiza la pila TLS del fork de Go, que se ha probado con certificados de cliente composite en un handshake TLS 1.3. Con `RequestClientCert`, que es lo que establece el chart de Lamassu en su opción por defecto, el proxy comprueba que el cliente posee la clave del certificado que presenta, pero no valida la cadena; la decisión se delega en el backend, que recibe el certificado en una cabecera (véase Despliegue con el Helm chart). Ninguna prueba de Traefik cubre el TLS mutuo poscuántico, y una cadena de cliente firmada por una CA composite o poscuántica depende del código x509 del fork.",{"_3839":80553,"_33145":80534,"_22633":136453,"_5":15597,"_29869":136411,"_3292":136454},[],"El fork no se compila desde la imagen de Go. El script `build.sh` exige una copia ya compilada del fork de Go, por defecto en `../go`, y comprueba que es el fork antes de forzar `GOROOT` y `GOTOOLCHAIN=local`. Compila el binario con `CGO_ENABLED=0`, genera la interfaz web salvo que se indique `SKIP_WEBUI=1` y empaqueta el binario en una imagen Alpine con `docker buildx`. La imagen por defecto es `ghcr.io/lamassuiot/traefik:pqc-3.7.15`.",{"_3839":80554,"_33145":80534,"_22633":136456,"_5":15597,"_29869":136411,"_3292":63537},[],{"_3839":80555,"_33145":80534,"_22633":136458,"_5":15597,"_29869":136411,"_3292":136459},[],"Finalidad",{"_3839":80556,"_33145":80534,"_22633":136461,"_5":15597,"_29869":136411,"_3292":63542},[],{"_3839":80557,"_33145":80534,"_22633":136463,"_5":15597,"_29869":136411,"_3292":136464},[],"Ubicación del fork de Go compilado.",{"_3839":80558,"_33145":80534,"_22633":136466,"_5":15597,"_29869":136411,"_3292":63548},[],{"_3839":80559,"_33145":80534,"_22633":136468,"_5":15597,"_29869":136411,"_3292":136469},[],"Plataformas de destino; por defecto `linux/amd64`.",{"_3839":80560,"_33145":80534,"_22633":136471,"_5":15597,"_29869":136411,"_3292":63554},[],{"_3839":80561,"_33145":80534,"_22633":136473,"_5":15597,"_29869":136411,"_3292":136474},[],"Omite la generación de la interfaz web con el valor `1`.",{"_3839":80562,"_33145":80534,"_22633":136476,"_5":15597,"_29869":136411,"_3292":63560},[],{"_3839":80563,"_33145":80534,"_22633":136478,"_5":15597,"_29869":136411,"_3292":136479},[],"Nombre de la imagen y si se publica. Las compilaciones multiplataforma requieren `PUSH=1`.",{"_3839":80564,"_33145":80534,"_22633":136481,"_5":15597,"_29869":136411,"_3292":136482},[],"Las etiquetas `pqc-*` son mutables y se han reconstruido sobre sí mismas, por lo que en entornos próximos a producción conviene fijar el digest.",{"_3839":80565,"_33145":80534,"_22633":136484,"_5":15597,"_29869":136411,"_3292":136485},[],"Las pruebas de selección del fork usan ML-DSA-65 puro junto con ECDSA P-256. La selección de un certificado composite depende de que la pila TLS del fork conozca la clave composite, algo que ocurre, pero el proxy no tiene ninguna prueba para ello.",{"_3839":80566,"_33145":80534,"_22633":136487,"_5":15597,"_29869":136411,"_3292":136488},[],"<Card title=\"Despliegue con el Helm chart\" description=\"Instalar el proxy delante de Envoy Gateway con el chart.\" href=\"/docs/platform/pqc/deployment\" />",{"_3839":80567,"_33145":80534,"_22633":136490,"_5":15597,"_29869":136411,"_3292":136491},[],"<Card title=\"Limitaciones conocidas\" description=\"Interoperabilidad y advertencias operativas.\" href=\"/docs/platform/pqc/limitations\" />",{"_3839":80568,"_33145":80568,"_5":15996,"_3292":136493,"_33551":136494,"_22633":136495,"_29869":80568},"Seguridad",[54324],[],{"_3839":80569,"_33145":80568,"_22633":136497,"_5":15597,"_29869":80568,"_3292":136498},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3839":80570,"_33145":80568,"_5":33548,"_22633":136500,"_29869":136501,"_3292":136502},[],"/docs/pr-preview/pr-58/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3839":80571,"_33145":80568,"_5":33548,"_22633":136504,"_29869":136505,"_3292":136506},[],"/docs/pr-preview/pr-58/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3839":80572,"_33145":80568,"_5":33548,"_22633":136508,"_29869":136509,"_3292":136510},[],"/docs/pr-preview/pr-58/es/security#versiones-soportadas","Versiones soportadas",{"_3839":80573,"_33145":80568,"_5":33548,"_22633":136512,"_29869":136513,"_3292":136514},[],"/docs/pr-preview/pr-58/es/security#divulgación-responsable","Divulgación responsable",{"_3839":80574,"_33145":80568,"_22633":136516,"_5":15597,"_29869":80568,"_3292":136517},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3839":80575,"_33145":80568,"_22633":136519,"_5":15597,"_29869":136501,"_3292":136520},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3839":80576,"_33145":80568,"_22633":136522,"_5":15597,"_29869":136501,"_3292":136523},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3839":80577,"_33145":80568,"_22633":136525,"_5":15597,"_29869":136501,"_3292":16319},[],{"_3839":80578,"_33145":80568,"_22633":136527,"_5":15597,"_29869":136501,"_3292":16255},[],{"_3839":80579,"_33145":80568,"_22633":136529,"_5":15597,"_29869":136501,"_3292":16312},[],{"_3839":80580,"_33145":80568,"_22633":136531,"_5":15597,"_29869":136501,"_3292":136532},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3839":80581,"_33145":80568,"_22633":136534,"_5":15597,"_29869":136501,"_3292":136535},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3839":80582,"_33145":80568,"_22633":136537,"_5":15597,"_29869":136505,"_3292":136538},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3839":80583,"_33145":80568,"_22633":136540,"_5":15597,"_29869":136505,"_3292":136541},[],"No incluyas en el reporte:",{"_3839":80584,"_33145":80568,"_22633":136543,"_5":15597,"_29869":136505,"_3292":136544},[],"Credenciales, tokens o claves privadas",{"_3839":80585,"_33145":80568,"_22633":136546,"_5":15597,"_29869":136505,"_3292":136547},[],"Datos de clientes o información identificable de clientes",{"_3839":80586,"_33145":80568,"_22633":136549,"_5":15597,"_29869":136505,"_3292":136550},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3839":80587,"_33145":80568,"_22633":136552,"_5":15597,"_29869":136509,"_3292":136553},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3839":80588,"_33145":80568,"_22633":136555,"_5":15597,"_29869":136509,"_3292":136556},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3839":80589,"_33145":80568,"_22633":136558,"_5":15597,"_29869":136513,"_3292":136559},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3839":80590,"_33145":80568,"_22633":136561,"_5":15597,"_29869":136513,"_3292":136562},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3839":80591,"_33145":80568,"_22633":136564,"_5":15597,"_29869":136513,"_3292":136565},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3839":80592,"_33145":80568,"_22633":136567,"_5":15597,"_29869":136513,"_3292":136568},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3839":80593,"_33145":80568,"_22633":136570,"_5":15597,"_29869":136513,"_3292":136571},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3839":80594,"_33145":80594,"_5":15996,"_3292":136573,"_33551":136574,"_22633":136576,"_29869":80594},"3.8.0 a 4.0.0",[54324,136575],"Actualizaciones",[],{"_3839":80595,"_33145":80594,"_22633":136578,"_5":15597,"_29869":80594,"_3292":136579},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3839":80596,"_33145":80594,"_5":33548,"_22633":136581,"_29869":136582,"_3292":136583},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3839":80597,"_33145":80594,"_5":33548,"_22633":136585,"_29869":136586,"_3292":136587},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3839":80598,"_33145":80594,"_5":33548,"_22633":136589,"_29869":136590,"_3292":136591},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3839":80599,"_33145":80594,"_5":33548,"_22633":136593,"_29869":136594,"_3292":136595},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3839":80600,"_33145":80594,"_5":33548,"_22633":136597,"_29869":136598,"_3292":136599},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3839":80601,"_33145":80594,"_5":33548,"_22633":136601,"_29869":136602,"_3292":136603},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3839":80602,"_33145":80594,"_5":33548,"_22633":136605,"_29869":136606,"_3292":63691},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3839":80603,"_33145":80594,"_5":33548,"_22633":136608,"_29869":136609,"_3292":136610},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3839":80604,"_33145":80594,"_5":33548,"_22633":136612,"_29869":136613,"_3292":136614},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3839":80605,"_33145":80594,"_5":33548,"_22633":136616,"_29869":136617,"_3292":136618},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3839":80606,"_33145":80594,"_5":33548,"_22633":136620,"_29869":136621,"_3292":136622},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3839":80607,"_33145":80594,"_5":33548,"_22633":136624,"_29869":136625,"_3292":136626},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3839":80608,"_33145":80594,"_5":33548,"_22633":136628,"_29869":136629,"_3292":136630},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3839":80609,"_33145":80594,"_5":33548,"_22633":136632,"_29869":136633,"_3292":136634},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3839":80610,"_33145":80594,"_5":33548,"_22633":136636,"_29869":136637,"_3292":136638},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3839":80611,"_33145":80594,"_5":33548,"_22633":136640,"_29869":136641,"_3292":136642},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3839":80612,"_33145":80594,"_5":33548,"_22633":136644,"_29869":136645,"_3292":136646},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3839":80613,"_33145":80594,"_5":33548,"_22633":136648,"_29869":136649,"_3292":136650},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3839":80614,"_33145":80594,"_5":33548,"_22633":136652,"_29869":136653,"_3292":136654},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3839":80615,"_33145":80594,"_5":33548,"_22633":136656,"_29869":136657,"_3292":136658},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-roles-va","Referencias entre certificados, claves y roles VA",{"_3839":80616,"_33145":80594,"_5":33548,"_22633":136660,"_29869":136661,"_3292":136662},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3839":80617,"_33145":80594,"_5":33548,"_22633":136664,"_29869":136665,"_3292":136666},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3839":80618,"_33145":80594,"_5":33548,"_22633":136668,"_29869":136669,"_3292":136670},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3839":80619,"_33145":80594,"_5":33548,"_22633":136672,"_29869":136673,"_3292":136674},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3839":80620,"_33145":80594,"_5":33548,"_22633":136676,"_29869":136677,"_3292":136678},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3839":80621,"_33145":80594,"_5":33548,"_22633":136680,"_29869":136681,"_3292":136682},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3839":80622,"_33145":80594,"_5":33548,"_22633":136684,"_29869":136685,"_3292":136686},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3839":80623,"_33145":80594,"_5":33548,"_22633":136688,"_29869":136689,"_3292":136690},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#campo-firmante-del-rol-va","Campo firmante del rol VA",{"_3839":80624,"_33145":80594,"_5":33548,"_22633":136692,"_29869":136693,"_3292":136694},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3839":80625,"_33145":80594,"_5":33548,"_22633":136696,"_29869":136697,"_3292":136698},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3839":80626,"_33145":80594,"_5":33548,"_22633":136700,"_29869":136701,"_3292":136702},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3839":80627,"_33145":80594,"_5":33548,"_22633":136704,"_29869":136705,"_3292":136706},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3839":80628,"_33145":80594,"_5":33548,"_22633":136708,"_29869":136709,"_3292":136710},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3839":80629,"_33145":80594,"_5":33548,"_22633":136712,"_29869":136713,"_3292":136714},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3839":80630,"_33145":80594,"_5":33548,"_22633":136716,"_29869":136717,"_3292":136718},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3839":80631,"_33145":80594,"_5":33548,"_22633":136720,"_29869":136721,"_3292":131477},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3839":80632,"_33145":80594,"_5":33548,"_22633":136723,"_29869":136724,"_3292":136725},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3839":80633,"_33145":80594,"_5":33548,"_22633":136727,"_29869":136728,"_3292":136729},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3839":80634,"_33145":80594,"_22633":136731,"_5":15597,"_29869":80594,"_3292":136732},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3839":80635,"_33145":80594,"_22633":136734,"_5":15597,"_29869":80594,"_3292":136735},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3839":80636,"_33145":80594,"_22633":136737,"_5":15597,"_29869":80594,"_3292":136738},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3839":80637,"_33145":80594,"_22633":136740,"_5":15597,"_29869":80594,"_3292":136741},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3839":80638,"_33145":80594,"_22633":136743,"_5":15597,"_29869":80594,"_3292":136744},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3839":80639,"_33145":80594,"_22633":136746,"_5":15597,"_29869":80594,"_3292":136747},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3839":80640,"_33145":80594,"_22633":136749,"_5":15597,"_29869":80594,"_3292":136750},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3839":80641,"_33145":80594,"_22633":136752,"_5":15597,"_29869":136586,"_3292":136753},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3839":80642,"_33145":80594,"_22633":136755,"_5":15597,"_29869":136586,"_3292":136756},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3839":80643,"_33145":80594,"_22633":136758,"_5":15597,"_29869":136590,"_3292":136759},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3839":80644,"_33145":80594,"_22633":136761,"_5":15597,"_29869":136590,"_3292":136762},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3839":80645,"_33145":80594,"_22633":136764,"_5":15597,"_29869":136594,"_3292":136765},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3839":80646,"_33145":80594,"_22633":136767,"_5":15597,"_29869":136598,"_3292":136768},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3839":80647,"_33145":80594,"_22633":136770,"_5":15597,"_29869":136598,"_3292":136771},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3839":80648,"_33145":80594,"_22633":136773,"_5":15597,"_29869":136598,"_3292":136774},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3839":80649,"_33145":80594,"_22633":136776,"_5":15597,"_29869":136598,"_3292":136777},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3839":80650,"_33145":80594,"_22633":136779,"_5":15597,"_29869":136598,"_3292":136780},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3839":80651,"_33145":80594,"_22633":136782,"_5":15597,"_29869":136602,"_3292":136783},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3839":80652,"_33145":80594,"_22633":136785,"_5":15597,"_29869":136602,"_3292":136786},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3839":80653,"_33145":80594,"_22633":136788,"_5":15597,"_29869":136602,"_3292":136789},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3839":80654,"_33145":80594,"_22633":136791,"_5":15597,"_29869":136602,"_3292":136792},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3839":80655,"_33145":80594,"_22633":136794,"_5":15597,"_29869":136602,"_3292":136795},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3839":80656,"_33145":80594,"_22633":136797,"_5":15597,"_29869":136606,"_3292":136798},[],"Cambio",{"_3839":80657,"_33145":80594,"_22633":136800,"_5":15597,"_29869":136606,"_3292":136801},[],"A quién afecta",{"_3839":80658,"_33145":80594,"_22633":136803,"_5":15597,"_29869":136606,"_3292":136804},[],"Gravedad",{"_3839":80659,"_33145":80594,"_22633":136806,"_5":15597,"_29869":136606,"_3292":134167},[],{"_3839":80660,"_33145":80594,"_22633":136808,"_5":15597,"_29869":136606,"_3292":136614},[],{"_3839":80661,"_33145":80594,"_22633":136810,"_5":15597,"_29869":136606,"_3292":136811},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3839":80662,"_33145":80594,"_22633":136813,"_5":15597,"_29869":136606,"_3292":136814},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3839":80663,"_33145":80594,"_22633":136816,"_5":15597,"_29869":136606,"_3292":136817},[],"Copiar los datos a los volúmenes nuevos",{"_3839":80664,"_33145":80594,"_22633":136819,"_5":15597,"_29869":136606,"_3292":136618},[],{"_3839":80665,"_33145":80594,"_22633":136821,"_5":15597,"_29869":136606,"_3292":136822},[],"Todas las releases de Helm",{"_3839":80666,"_33145":80594,"_22633":136824,"_5":15597,"_29869":136606,"_3292":136825},[],"Alta: `helm upgrade` falla",{"_3839":80667,"_33145":80594,"_22633":136827,"_5":15597,"_29869":136606,"_3292":136828},[],"Eliminar o renombrar las claves heredadas",{"_3839":80668,"_33145":80594,"_22633":136830,"_5":15597,"_29869":136606,"_3292":136622},[],{"_3839":80669,"_33145":80594,"_22633":136832,"_5":15597,"_29869":136606,"_3292":136833},[],"Todos los despliegues",{"_3839":80670,"_33145":80594,"_22633":136835,"_5":15597,"_29869":136606,"_3292":136836},[],"Alta: sin principal de bootstrap no hay administrador",{"_3839":80671,"_33145":80594,"_22633":136838,"_5":15597,"_29869":136606,"_3292":136839},[],"Configurar `services.authz`",{"_3839":80672,"_33145":80594,"_22633":136841,"_5":15597,"_29869":136606,"_3292":136626},[],{"_3839":80673,"_33145":80594,"_22633":136843,"_5":15597,"_29869":136606,"_3292":136822},[],{"_3839":80674,"_33145":80594,"_22633":136845,"_5":15597,"_29869":136606,"_3292":136846},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3839":80675,"_33145":80594,"_22633":136848,"_5":15597,"_29869":136606,"_3292":136849},[],"Mover JWKS y roles a `services.authz`",{"_3839":80676,"_33145":80594,"_22633":136851,"_5":15597,"_29869":136606,"_3292":136646},[],{"_3839":80677,"_33145":80594,"_22633":136853,"_5":15597,"_29869":136606,"_3292":136854},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3839":80678,"_33145":80594,"_22633":136856,"_5":15597,"_29869":136606,"_3292":136857},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3839":80679,"_33145":80594,"_22633":136859,"_5":15597,"_29869":136606,"_3292":136860},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3839":80680,"_33145":80594,"_22633":136862,"_5":15597,"_29869":136606,"_3292":136650},[],{"_3839":80681,"_33145":80594,"_22633":136864,"_5":15597,"_29869":136606,"_3292":136865},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3839":80682,"_33145":80594,"_22633":136867,"_5":15597,"_29869":136606,"_3292":136868},[],"Alta: el backend ya no arranca con ellos",{"_3839":80683,"_33145":80594,"_22633":136870,"_5":15597,"_29869":136606,"_3292":136871},[],"Pasar a PostgreSQL antes de actualizar",{"_3839":80684,"_33145":80594,"_22633":136873,"_5":15597,"_29869":136606,"_3292":136874},[],"Webhooks con referencias a archivos",{"_3839":80685,"_33145":80594,"_22633":136876,"_5":15597,"_29869":136606,"_3292":136877},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3839":80686,"_33145":80594,"_22633":136879,"_5":15597,"_29869":136606,"_3292":136880},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3839":80687,"_33145":80594,"_22633":136882,"_5":15597,"_29869":136606,"_3292":136883},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3839":80688,"_33145":80594,"_22633":136885,"_5":15597,"_29869":136606,"_3292":136630},[],{"_3839":80689,"_33145":80594,"_22633":136887,"_5":15597,"_29869":136606,"_3292":136888},[],"Releases con identidades por servicio o material de claves montado",{"_3839":80690,"_33145":80594,"_22633":136890,"_5":15597,"_29869":136606,"_3292":136891},[],"Media: los servicios no pueden leer sus archivos",{"_3839":80691,"_33145":80594,"_22633":136893,"_5":15597,"_29869":136606,"_3292":136894},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3839":80692,"_33145":80594,"_22633":136896,"_5":15597,"_29869":136606,"_3292":136634},[],{"_3839":80693,"_33145":80594,"_22633":136898,"_5":15597,"_29869":136606,"_3292":136899},[],"Releases que definen `amqp.tls`",{"_3839":80694,"_33145":80594,"_22633":136901,"_5":15597,"_29869":136606,"_3292":136902},[],"Media: los clientes se conectan al puerto equivocado",{"_3839":80695,"_33145":80594,"_22633":136904,"_5":15597,"_29869":136606,"_3292":136905},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3839":80696,"_33145":80594,"_22633":136907,"_5":15597,"_29869":136606,"_3292":136654},[],{"_3839":80697,"_33145":80594,"_22633":136909,"_5":15597,"_29869":136606,"_3292":136910},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3839":80698,"_33145":80594,"_22633":136912,"_5":15597,"_29869":136606,"_3292":136913},[],"Media: las claves de CA quedan sin gestionar",{"_3839":80699,"_33145":80594,"_22633":136915,"_5":15597,"_29869":136606,"_3292":136916},[],"Ejecutar la migración de CA a KMS",{"_3839":80700,"_33145":80594,"_22633":136918,"_5":15597,"_29869":136606,"_3292":136919},[],"Verificación del certificado del receptor",{"_3839":80701,"_33145":80594,"_22633":136921,"_5":15597,"_29869":136606,"_3292":136922},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3839":80702,"_33145":80594,"_22633":136924,"_5":15597,"_29869":136606,"_3292":136925},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3839":80703,"_33145":80594,"_22633":136927,"_5":15597,"_29869":136606,"_3292":136928},[],"Poner `insecure_skip_verify` a `false`",{"_3839":80704,"_33145":80594,"_22633":136930,"_5":15597,"_29869":136606,"_3292":136670},[],{"_3839":80705,"_33145":80594,"_22633":136932,"_5":15597,"_29869":136606,"_3292":136933},[],"Scripts y consolas que editan DMS por API",{"_3839":80706,"_33145":80594,"_22633":136935,"_5":15597,"_29869":136606,"_3292":136936},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3839":80707,"_33145":80594,"_22633":136938,"_5":15597,"_29869":136606,"_3292":136939},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3839":80708,"_33145":80594,"_22633":136941,"_5":15597,"_29869":136606,"_3292":136690},[],{"_3839":80709,"_33145":80594,"_22633":136943,"_5":15597,"_29869":136606,"_3292":136944},[],"Clientes que crean o actualizan roles VA por API",{"_3839":80710,"_33145":80594,"_22633":136946,"_5":15597,"_29869":136606,"_3292":136947},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3839":80711,"_33145":80594,"_22633":136949,"_5":15597,"_29869":136606,"_3292":136950},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_certificate_serial_number`",{"_3839":80712,"_33145":80594,"_22633":136952,"_5":15597,"_29869":136606,"_3292":136686},[],{"_3839":80713,"_33145":80594,"_22633":136954,"_5":15597,"_29869":136606,"_3292":136955},[],"Consumidores que leen el campo `events` del dispositivo",{"_3839":80714,"_33145":80594,"_22633":136957,"_5":15597,"_29869":136606,"_3292":136958},[],"Media: el campo desaparece",{"_3839":80715,"_33145":80594,"_22633":136960,"_5":15597,"_29869":136606,"_3292":136961},[],"Usar los nuevos endpoints de eventos",{"_3839":80716,"_33145":80594,"_22633":136963,"_5":15597,"_29869":136606,"_3292":136638},[],{"_3839":80717,"_33145":80594,"_22633":136965,"_5":15597,"_29869":136606,"_3292":136966},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3839":80718,"_33145":80594,"_22633":136968,"_5":15597,"_29869":136606,"_3292":136969},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3839":80719,"_33145":80594,"_22633":136971,"_5":15597,"_29869":136606,"_3292":136972},[],"Actualizar el archivo de values",{"_3839":80720,"_33145":80594,"_22633":136974,"_5":15597,"_29869":136606,"_3292":136678},[],{"_3839":80721,"_33145":80594,"_22633":136976,"_5":15597,"_29869":136606,"_3292":136977},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3839":80722,"_33145":80594,"_22633":136979,"_5":15597,"_29869":136606,"_3292":136980},[],"Baja: prevalece el ID de la URL",{"_3839":80723,"_33145":80594,"_22633":136982,"_5":15597,"_29869":136606,"_3292":136983},[],"Enviar el ID en la URL",{"_3839":80724,"_33145":80594,"_22633":136985,"_5":15597,"_29869":136606,"_3292":136682},[],{"_3839":80725,"_33145":80594,"_22633":136987,"_5":15597,"_29869":136606,"_3292":136988},[],"Consumidores que comparan el `type` del certificado",{"_3839":80726,"_33145":80594,"_22633":136990,"_5":15597,"_29869":136606,"_3292":136991},[],"Baja: dos valores cambian de nombre",{"_3839":80727,"_33145":80594,"_22633":136993,"_5":15597,"_29869":136606,"_3292":136994},[],"Adaptar los consumidores",{"_3839":80728,"_33145":80594,"_22633":136996,"_5":15597,"_29869":136606,"_3292":136674},[],{"_3839":80729,"_33145":80594,"_22633":136998,"_5":15597,"_29869":136606,"_3292":136999},[],"Cualquier DMS",{"_3839":80730,"_33145":80594,"_22633":137001,"_5":15597,"_29869":136606,"_3292":137002},[],"Baja: solo informativo",{"_3839":80731,"_33145":80594,"_22633":137004,"_5":15597,"_29869":136606,"_3292":137005},[],"Revisar ambos bloques antes de editar",{"_3839":80732,"_33145":80594,"_22633":137007,"_5":15597,"_29869":136613,"_3292":137008},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3839":80733,"_33145":80594,"_22633":137010,"_5":15597,"_29869":136613,"_3292":137011},[],"El paso 4 de la guía de migración copia los datos.",{"_3839":80734,"_33145":80594,"_22633":137013,"_5":15597,"_29869":136617,"_3292":137014},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3839":80735,"_33145":80594,"_22633":137016,"_5":15597,"_29869":136621,"_3292":137017},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3839":80736,"_33145":80594,"_22633":137019,"_5":15597,"_29869":136625,"_3292":137020},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3839":80737,"_33145":80594,"_22633":137022,"_5":15597,"_29869":136629,"_3292":137023},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3839":80738,"_33145":80594,"_22633":137025,"_5":15597,"_29869":136629,"_3292":137026},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3839":80739,"_33145":80594,"_22633":137028,"_5":15597,"_29869":136633,"_3292":137029},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3839":80740,"_33145":80594,"_22633":137031,"_5":15597,"_29869":136637,"_3292":137032},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3839":80741,"_33145":80594,"_22633":137034,"_5":15597,"_29869":136637,"_3292":137035},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3839":80742,"_33145":80594,"_22633":137037,"_5":15597,"_29869":136637,"_3292":137038},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3839":80743,"_33145":80594,"_22633":137040,"_5":15597,"_29869":136637,"_3292":137041},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3839":80744,"_33145":80594,"_22633":137043,"_5":15597,"_29869":136637,"_3292":137044},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3839":80745,"_33145":80594,"_22633":137046,"_5":15597,"_29869":136637,"_3292":137047},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3839":80746,"_33145":80594,"_22633":137049,"_5":15597,"_29869":136645,"_3292":137050},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3839":80747,"_33145":80594,"_22633":137052,"_5":15597,"_29869":136645,"_3292":137053},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3839":80748,"_33145":80594,"_22633":137055,"_5":15597,"_29869":136645,"_3292":137056},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3839":80749,"_33145":80594,"_22633":137058,"_5":15597,"_29869":136645,"_3292":137059},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3839":80750,"_33145":80594,"_22633":137061,"_5":15597,"_29869":136645,"_3292":137062},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3839":80751,"_33145":80594,"_22633":137064,"_5":15597,"_29869":136649,"_3292":137065},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3839":80752,"_33145":80594,"_22633":137067,"_5":15597,"_29869":136653,"_3292":137068},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3839":80753,"_33145":80594,"_22633":137070,"_5":15597,"_29869":136653,"_3292":137071},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3839":80754,"_33145":80594,"_22633":137073,"_5":15597,"_29869":136653,"_3292":137074},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3839":80755,"_33145":80594,"_22633":137076,"_5":15597,"_29869":136653,"_3292":137077},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3839":80756,"_33145":80594,"_22633":137079,"_5":15597,"_29869":136653,"_3292":137080},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3839":80757,"_33145":80594,"_22633":137082,"_5":15597,"_29869":136653,"_3292":137083},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3839":80758,"_33145":80594,"_22633":137085,"_5":15597,"_29869":136653,"_3292":137086},[],"Una vez registradas las claves heredadas, arrancar el KMS con la opción de configuración del backend `crypto_engines.migrate_keys_format` renombra las claves cuyo nombre no es el digest SHA-256 de la clave pública, conserva el nombre antiguo como alias y traslada consigo las referencias de certificados. Es seguro volver a ejecutarla y puede desactivarse después.",{"_3839":80759,"_33145":80594,"_22633":137088,"_5":15597,"_29869":136657,"_3292":137089},[],"Los certificados referencian ahora su clave del KMS, y los roles VA referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3839":80760,"_33145":80594,"_22633":137091,"_5":15597,"_29869":136665,"_3292":137092},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3839":80761,"_33145":80594,"_22633":137094,"_5":15597,"_29869":136665,"_3292":137095},[],"Campo en 3.8.0",{"_3839":80762,"_33145":80594,"_22633":137097,"_5":15597,"_29869":136665,"_3292":137098},[],"Campo en 4.0.0",{"_3839":80763,"_33145":80594,"_22633":137100,"_5":15597,"_29869":136665,"_3292":64186},[],{"_3839":80764,"_33145":80594,"_22633":137102,"_5":15597,"_29869":136665,"_3292":137103},[],"`insecure_skip_verify` (con el valor negado)",{"_3839":80765,"_33145":80594,"_22633":137105,"_5":15597,"_29869":136665,"_3292":64192},[],{"_3839":80766,"_33145":80594,"_22633":137107,"_5":15597,"_29869":136665,"_3292":64195},[],{"_3839":80767,"_33145":80594,"_22633":137109,"_5":15597,"_29869":136665,"_3292":64198},[],{"_3839":80768,"_33145":80594,"_22633":137111,"_5":15597,"_29869":136665,"_3292":64201},[],{"_3839":80769,"_33145":80594,"_22633":137113,"_5":15597,"_29869":136665,"_3292":64204},[],{"_3839":80770,"_33145":80594,"_22633":137115,"_5":15597,"_29869":136665,"_3292":64207},[],{"_3839":80771,"_33145":80594,"_22633":137117,"_5":15597,"_29869":136665,"_3292":137118},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3839":80772,"_33145":80594,"_22633":137120,"_5":15597,"_29869":136665,"_3292":137121},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3839":80773,"_33145":80594,"_22633":137123,"_5":15597,"_29869":136665,"_3292":137124},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3839":80774,"_33145":80594,"_22633":137126,"_5":15597,"_29869":136669,"_3292":137127},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3839":80775,"_33145":80594,"_22633":137129,"_5":15597,"_29869":136669,"_3292":137130},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3839":80776,"_33145":80594,"_22633":137132,"_5":15597,"_29869":136669,"_3292":137133},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3839":80777,"_33145":80594,"_22633":137135,"_5":15597,"_29869":136673,"_3292":137136},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3839":80778,"_33145":80594,"_22633":137138,"_5":15597,"_29869":136677,"_3292":137139},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3839":80779,"_33145":80594,"_22633":137141,"_5":15597,"_29869":136681,"_3292":137142},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3839":80780,"_33145":80594,"_22633":137144,"_5":15597,"_29869":136685,"_3292":137145},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3839":80781,"_33145":80594,"_22633":137147,"_5":15597,"_29869":136685,"_3292":137148},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3839":80782,"_33145":80594,"_22633":137150,"_5":15597,"_29869":136685,"_3292":137151},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3839":80783,"_33145":80594,"_22633":137153,"_5":15597,"_29869":136685,"_3292":137154},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3839":80784,"_33145":80594,"_22633":137156,"_5":15597,"_29869":136689,"_3292":137157},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_certificate_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de un rol nuevo es el número de serie del certificado actual de la CA. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. Las políticas de autorización personalizadas que filtran por el campo antiguo deben actualizarse: el filtro `crl_subject_key_id_signer` se renombra a `crl_signer_certificate_serial_number` y toma valores de número de serie.",{"_3839":80785,"_33145":80594,"_22633":137159,"_5":15597,"_29869":136693,"_3292":137160},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3839":80786,"_33145":80594,"_22633":137162,"_5":15597,"_29869":136697,"_3292":137163},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_3839":80787,"_33145":80594,"_22633":137165,"_5":15597,"_29869":136697,"_3292":137166},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3839":80788,"_33145":80594,"_22633":137168,"_5":15597,"_29869":136697,"_3292":137169},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3839":80789,"_33145":80594,"_22633":137171,"_5":15597,"_29869":136697,"_3292":137172},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3839":80790,"_33145":80594,"_22633":137174,"_5":15597,"_29869":136697,"_3292":137175},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3839":80791,"_33145":80594,"_22633":137177,"_5":15597,"_29869":136701,"_3292":137178},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3839":80792,"_33145":80594,"_22633":137180,"_5":15597,"_29869":136701,"_3292":137181},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3839":80793,"_33145":80594,"_22633":137183,"_5":15597,"_29869":136701,"_3292":137184},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3839":80794,"_33145":80594,"_22633":137186,"_5":15597,"_29869":136701,"_3292":137187},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3839":80795,"_33145":80594,"_22633":137189,"_5":15597,"_29869":136701,"_3292":137190},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3839":80796,"_33145":80594,"_22633":137192,"_5":15597,"_29869":136701,"_3292":137193},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3839":80797,"_33145":80594,"_22633":137195,"_5":15597,"_29869":136701,"_3292":137196},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3839":80798,"_33145":80594,"_22633":137198,"_5":15597,"_29869":136701,"_3292":137199},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3839":80799,"_33145":80594,"_22633":137201,"_5":15597,"_29869":136701,"_3292":137202},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3839":80800,"_33145":80594,"_22633":137204,"_5":15597,"_29869":136701,"_3292":137205},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3839":80801,"_33145":80594,"_22633":137207,"_5":15597,"_29869":136701,"_3292":137208},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3839":80802,"_33145":80594,"_22633":137210,"_5":15597,"_29869":136701,"_3292":137211},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3839":80803,"_33145":80594,"_22633":137213,"_5":15597,"_29869":136705,"_3292":137214},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3839":80804,"_33145":80594,"_22633":137216,"_5":15597,"_29869":136705,"_3292":137217},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3839":80805,"_33145":80594,"_22633":137219,"_5":15597,"_29869":136709,"_3292":137220},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3839":80806,"_33145":80594,"_22633":137222,"_5":15597,"_29869":136709,"_3292":137223},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3839":80807,"_33145":80594,"_22633":137225,"_5":15597,"_29869":136709,"_3292":137226},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3839":80808,"_33145":80594,"_22633":137228,"_5":15597,"_29869":136709,"_3292":137229},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3839":80809,"_33145":80594,"_22633":137231,"_5":15597,"_29869":136709,"_3292":137232},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3839":80810,"_33145":80594,"_22633":137234,"_5":15597,"_29869":136709,"_3292":137235},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3839":80811,"_33145":80594,"_22633":137237,"_5":15597,"_29869":136709,"_3292":137238},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3839":80812,"_33145":80594,"_22633":137240,"_5":15597,"_29869":136709,"_3292":137241},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3839":80813,"_33145":80594,"_22633":137243,"_5":15597,"_29869":136709,"_3292":137244},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3839":80814,"_33145":80594,"_22633":137246,"_5":15597,"_29869":136709,"_3292":137247},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3839":80815,"_33145":80594,"_22633":137249,"_5":15597,"_29869":136709,"_3292":137250},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3839":80816,"_33145":80594,"_22633":137252,"_5":15597,"_29869":136713,"_3292":137253},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3839":80817,"_33145":80594,"_22633":137255,"_5":15597,"_29869":136713,"_3292":137256},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3839":80818,"_33145":80594,"_22633":137258,"_5":15597,"_29869":136717,"_3292":137259},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3839":80819,"_33145":80594,"_22633":137261,"_5":15597,"_29869":136717,"_3292":137262},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3839":80820,"_33145":80594,"_22633":137264,"_5":15597,"_29869":136717,"_3292":137265},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Si tus servicios se conectan con un usuario distinto del que ejecutó las migraciones, concédele tras las migraciones `SELECT` sobre `ca.certificates_view`.",{"_3839":80821,"_33145":80594,"_22633":137267,"_5":15597,"_29869":136717,"_3292":137268},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3839":80822,"_33145":80594,"_22633":137270,"_5":15597,"_29869":136717,"_3292":137271},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3839":80823,"_33145":80594,"_22633":137273,"_5":15597,"_29869":136717,"_3292":137274},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3839":80824,"_33145":80594,"_22633":137276,"_5":15597,"_29869":136717,"_3292":137277},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3839":80825,"_33145":80594,"_22633":137279,"_5":15597,"_29869":136721,"_3292":137280},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3839":80826,"_33145":80594,"_22633":137282,"_5":15597,"_29869":136721,"_3292":137283},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3839":80827,"_33145":80594,"_22633":137285,"_5":15597,"_29869":136721,"_3292":137286},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3839":80828,"_33145":80594,"_22633":137288,"_5":15597,"_29869":136721,"_3292":137289},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3839":80829,"_33145":80594,"_22633":137291,"_5":15597,"_29869":136721,"_3292":137292},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_3839":80830,"_33145":80594,"_22633":137294,"_5":15597,"_29869":136721,"_3292":137295},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3839":80831,"_33145":80594,"_22633":137297,"_5":15597,"_29869":136721,"_3292":137298},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3839":80832,"_33145":80594,"_22633":137300,"_5":15597,"_29869":136721,"_3292":137301},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_3839":80833,"_33145":80594,"_22633":137303,"_5":15597,"_29869":136721,"_3292":137304},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3839":80834,"_33145":80594,"_22633":137306,"_5":15597,"_29869":136721,"_3292":137307},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_certificate_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3839":80835,"_33145":80594,"_22633":137309,"_5":15597,"_29869":136721,"_3292":137310},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_3839":80836,"_33145":80594,"_22633":137312,"_5":15597,"_29869":136724,"_3292":137313},[],"Tras la actualización, comprueba en este orden:",{"_3839":80837,"_33145":80594,"_22633":137315,"_5":15597,"_29869":136724,"_3292":137316},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3839":80838,"_33145":80594,"_22633":137318,"_5":15597,"_29869":136724,"_3292":137319},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3839":80839,"_33145":80594,"_22633":137321,"_5":15597,"_29869":136724,"_3292":137322},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3839":80840,"_33145":80594,"_22633":137324,"_5":15597,"_29869":136724,"_3292":137325},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_3839":80841,"_33145":80594,"_22633":137327,"_5":15597,"_29869":136724,"_3292":137328},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_3839":80842,"_33145":80594,"_22633":137330,"_5":15597,"_29869":136724,"_3292":137331},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3839":80843,"_33145":80594,"_22633":137333,"_5":15597,"_29869":136724,"_3292":137334},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3839":80844,"_33145":80594,"_22633":137336,"_5":15597,"_29869":136724,"_3292":137337},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3839":80845,"_33145":80594,"_22633":137339,"_5":15597,"_29869":136724,"_3292":137340},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3839":80846,"_33145":80594,"_22633":137342,"_5":15597,"_29869":136724,"_3292":137343},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3839":80847,"_33145":80594,"_22633":137345,"_5":15597,"_29869":136724,"_3292":137346},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3839":80848,"_33145":80594,"_22633":137348,"_5":15597,"_29869":136724,"_3292":137349},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3839":80849,"_33145":80594,"_22633":137351,"_5":15597,"_29869":136724,"_3292":137352},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3839":80850,"_33145":80594,"_22633":137354,"_5":15597,"_29869":136724,"_3292":137355},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3839":80851,"_33145":80594,"_22633":137357,"_5":15597,"_29869":136728,"_3292":137358},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3839":80852,"_33145":80594,"_22633":137360,"_5":15597,"_29869":136728,"_3292":137361},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3839":80853,"_33145":80594,"_22633":137363,"_5":15597,"_29869":136728,"_3292":137364},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3839":80854,"_33145":80594,"_22633":137366,"_5":15597,"_29869":136728,"_3292":137367},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3839":80855,"_33145":80594,"_22633":137369,"_5":15597,"_29869":136728,"_3292":137370},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_64465":137372,"_64466":137373,"_64468":137374,"_64470":137375,"_19588":3327,"_77577":3327},"spanish",[3292,33145,5,29869],{"_3292":27097,"_33145":27097,"_5":27097,"_29869":27097},{"_3292":137376,"_33145":140651,"_5":143926,"_29869":147201},{"_5095":137377,"_64474":137378,"_5":27097},{"_15684":21781,"_11291":12103,"_11235":5162,"_11140":22807,"_11366":3564,"_11148":4085,"_15705":3510,"_11156":6349,"_28495":23651,"_32288":4347,"_32322":8250,"_31796":7627,"_32388":6864,"_31977":20523,"_32394":10593,"_32356":5721,"_32400":4633,"_32405":4043,"_32346":4426,"_32890":6508,"_37928":3617,"_37930":7644,"_32934":17649,"_16137":6683,"_32914":8093,"_37936":5727,"_32943":15943,"_28479":9018,"_32885":33043,"_32960":32994,"_33002":8084,"_37943":8214,"_37945":6535,"_31994":7035,"_37948":8206,"_33031":7536,"_33019":18978,"_32992":10462,"_33025":6930,"_31859":4042,"_31907":3707,"_31913":5205,"_31919":5815,"_11143":4413,"_31925":7937,"_31931":6459,"_37962":10082,"_31901":12401,"_31937":11084,"_31754":4624,"_37968":31842,"_31801":15651,"_31823":16501,"_31829":5208,"_37974":3642,"_16130":3620,"_37977":4416,"_33212":6777,"_37981":7601,"_33063":23467,"_37984":6776,"_37986":3760,"_37988":4447,"_21481":5192,"_11151":14413,"_37992":4600,"_31774":4134,"_37995":6343,"_37997":14022,"_37999":3359,"_38001":3703,"_32976":4506,"_32301":3630,"_38005":8133,"_38007":4499,"_33127":8169,"_32441":3809,"_38011":3361,"_38013":3636,"_31813":18232,"_38016":8139,"_38018":5069,"_38020":6364,"_31949":8242,"_31971":6525,"_31147":15945,"_11159":20697,"_38026":7137,"_38028":5429,"_32026":5188,"_38032":6840,"_28498":7202,"_38036":8066,"_38038":11424,"_38040":3723,"_38042":7274,"_38044":5511,"_38046":3593,"_32015":7991,"_32295":28256,"_32317":5168,"_38051":4040,"_38053":6248,"_38056":6527,"_38058":3985,"_38060":19020,"_38062":6455,"_38064":27496,"_38066":11861,"_38068":7787,"_38071":3377,"_38073":6501,"_38075":4780,"_38077":16328,"_38079":3622,"_38082":5327,"_38084":3700,"_38087":5621,"