:137504,"_44436":137507,"_44438":137510,"_44440":137513,"_44442":137516,"_44444":137519,"_44446":137522,"_44448":137525,"_44450":137528,"_44452":137531,"_44454":137534,"_44456":137537,"_44458":137540,"_44460":137543,"_44462":137546,"_44464":137549,"_44466":137552,"_44468":137555,"_44470":137558,"_44472":137561,"_44474":137564,"_44476":137567,"_44478":137570,"_44480":137573},{"_3844":77697,"_33198":77697,"_5":16006,"_3297":127716,"_33604":127717,"_22654":127720,"_29907":77697},"Despliega desde AWS Marketplace",[54402,127718,127719],"Despliegue","Otros modelos",[],{"_3844":77698,"_33198":77697,"_22654":127722,"_5":15607,"_29907":77697,"_3297":127723},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3844":77699,"_33198":77697,"_5":33601,"_22654":127725,"_29907":127726,"_3297":127727},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3844":77700,"_33198":77697,"_5":33601,"_22654":127729,"_29907":127730,"_3297":127731},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3844":77701,"_33198":77697,"_5":33601,"_22654":127733,"_29907":127734,"_3297":127735},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3844":77702,"_33198":77697,"_5":33601,"_22654":127737,"_29907":127738,"_3297":127739},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3844":77703,"_33198":77697,"_5":33601,"_22654":127741,"_29907":127742,"_3297":127743},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3844":77704,"_33198":77697,"_5":33601,"_22654":127745,"_29907":127746,"_3297":127747},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3844":77705,"_33198":77697,"_5":33601,"_22654":127749,"_29907":127750,"_3297":127751},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3844":77706,"_33198":77697,"_22654":127753,"_5":15607,"_29907":77697,"_3297":127754},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3844":77707,"_33198":77697,"_22654":127756,"_5":15607,"_29907":127726,"_3297":127757},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3844":77708,"_33198":77697,"_22654":127759,"_5":15607,"_29907":127726,"_3297":127760},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3844":77709,"_33198":77697,"_22654":127762,"_5":15607,"_29907":127726,"_3297":127763},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3844":77710,"_33198":77697,"_22654":127765,"_5":15607,"_29907":127730,"_3297":127766},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3844":77711,"_33198":77697,"_22654":127768,"_5":15607,"_29907":127730,"_3297":127769},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3844":77712,"_33198":77697,"_22654":127771,"_5":15607,"_29907":127730,"_3297":127772},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3844":77713,"_33198":77697,"_22654":127774,"_5":15607,"_29907":127734,"_3297":127775},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3844":77714,"_33198":77697,"_22654":127777,"_5":15607,"_29907":127738,"_3297":127778},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3844":77715,"_33198":77697,"_22654":127780,"_5":15607,"_29907":127742,"_3297":127781},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3844":77716,"_33198":77697,"_22654":127783,"_5":15607,"_29907":127746,"_3297":127784},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3844":77717,"_33198":77697,"_22654":127786,"_5":15607,"_29907":127750,"_3297":127787},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3844":77718,"_33198":77718,"_5":16006,"_3297":127789,"_33604":127790,"_22654":127791,"_29907":77718},"Despliega Lamassu",[54402,127718],[],{"_3844":77719,"_33198":77718,"_22654":127793,"_5":15607,"_29907":77718,"_3297":127794},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3844":77720,"_33198":77718,"_5":33601,"_22654":127796,"_29907":127797,"_3297":127798},[],"/docs/pr-preview/pr-58/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3844":77721,"_33198":77718,"_5":33601,"_22654":127800,"_29907":127801,"_3297":127802},[],"/docs/pr-preview/pr-58/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3844":77722,"_33198":77718,"_5":33601,"_22654":127804,"_29907":127805,"_3297":127806},[],"/docs/pr-preview/pr-58/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3844":77723,"_33198":77718,"_22654":127808,"_5":15607,"_29907":77718,"_3297":127809},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3844":77724,"_33198":77718,"_22654":127811,"_5":15607,"_29907":127797,"_3297":127812},[],"Modelo",{"_3844":77725,"_33198":77718,"_22654":127814,"_5":15607,"_29907":127797,"_3297":127815},[],"Recomendado para",{"_3844":77726,"_33198":77718,"_22654":127817,"_5":15607,"_29907":127797,"_3297":127818},[],"Quién opera la infraestructura",{"_3844":77727,"_33198":77718,"_22654":127820,"_5":15607,"_29907":127797,"_3297":127821},[],"Punto de partida",{"_3844":77728,"_33198":77718,"_22654":127823,"_5":15607,"_29907":127797,"_3297":54509},[],{"_3844":77729,"_33198":77718,"_22654":127825,"_5":15607,"_29907":127797,"_3297":127826},[],"Producción, entornos regulados y despliegues personalizados",{"_3844":77730,"_33198":77718,"_22654":127828,"_5":15607,"_29907":127797,"_3297":127829},[],"Tu equipo",{"_3844":77731,"_33198":77718,"_22654":127831,"_5":15607,"_29907":127797,"_3297":127832},[],"Helm o Fastlane",{"_3844":77732,"_33198":77718,"_22654":127834,"_5":15607,"_29907":127797,"_3297":54521},[],{"_3844":77733,"_33198":77718,"_22654":127836,"_5":15607,"_29907":127797,"_3297":127837},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3844":77734,"_33198":77718,"_22654":127839,"_5":15607,"_29907":127797,"_3297":127829},[],{"_3844":77735,"_33198":77718,"_22654":127841,"_5":15607,"_29907":127797,"_3297":127842},[],"Imagen preconfigurada en EC2",{"_3844":77736,"_33198":77718,"_22654":127844,"_5":15607,"_29907":127797,"_3297":54532},[],{"_3844":77737,"_33198":77718,"_22654":127846,"_5":15607,"_29907":127797,"_3297":127847},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3844":77738,"_33198":77718,"_22654":127849,"_5":15607,"_29907":127797,"_3297":54538},[],{"_3844":77739,"_33198":77718,"_22654":127851,"_5":15607,"_29907":127797,"_3297":127852},[],"Suscripción gestionada",{"_3844":77740,"_33198":77718,"_22654":127854,"_5":15607,"_29907":127797,"_3297":127855},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3844":77741,"_33198":77718,"_22654":127857,"_5":15607,"_29907":127797,"_3297":127858},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3844":77742,"_33198":77718,"_22654":127860,"_5":15607,"_29907":127797,"_3297":127861},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3844":77743,"_33198":77718,"_22654":127863,"_5":15607,"_29907":127801,"_3297":127864},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3844":77744,"_33198":77718,"_22654":127866,"_5":15607,"_29907":127805,"_3297":127867},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3844":77745,"_33198":77745,"_5":16006,"_3297":127869,"_33604":127870,"_22654":127871,"_29907":77745},"Utiliza Lamassu como SaaS",[54402,127718,127719],[],{"_3844":77746,"_33198":77745,"_22654":127873,"_5":15607,"_29907":77745,"_3297":127874},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3844":77747,"_33198":77745,"_5":33601,"_22654":127876,"_29907":127877,"_3297":127878},[],"/docs/pr-preview/pr-58/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3844":77748,"_33198":77745,"_5":33601,"_22654":127880,"_29907":127881,"_3297":127882},[],"/docs/pr-preview/pr-58/es/deployment/saas#planes","Planes",{"_3844":77749,"_33198":77745,"_5":33601,"_22654":127884,"_29907":127885,"_3297":127886},[],"/docs/pr-preview/pr-58/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3844":77750,"_33198":77745,"_22654":127888,"_5":15607,"_29907":77745,"_3297":127889},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3844":77751,"_33198":77745,"_22654":127891,"_5":15607,"_29907":127877,"_3297":127892},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3844":77752,"_33198":77745,"_22654":127894,"_5":15607,"_29907":127877,"_3297":127895},[],"Copias de seguridad automáticas.",{"_3844":77753,"_33198":77745,"_22654":127897,"_5":15607,"_29907":127877,"_3297":127898},[],"Actualizaciones de versión.",{"_3844":77754,"_33198":77745,"_22654":127900,"_5":15607,"_29907":127877,"_3297":127901},[],"Soporte técnico y SLA según el plan contratado.",{"_3844":77755,"_33198":77745,"_22654":127903,"_5":15607,"_29907":127881,"_3297":54593},[],{"_3844":77756,"_33198":77745,"_22654":127905,"_5":15607,"_29907":127881,"_3297":127906},[],"Dispositivos",{"_3844":77757,"_33198":77745,"_22654":127908,"_5":15607,"_29907":127881,"_3297":127909},[],"Soporte",{"_3844":77758,"_33198":77745,"_22654":127911,"_5":15607,"_29907":127881,"_3297":54602},[],{"_3844":77759,"_33198":77745,"_22654":127913,"_5":15607,"_29907":127881,"_3297":54605},[],{"_3844":77760,"_33198":77745,"_22654":127915,"_5":15607,"_29907":127881,"_3297":127916},[],"Hasta 1.000",{"_3844":77761,"_33198":77745,"_22654":127918,"_5":15607,"_29907":127881,"_3297":54611},[],{"_3844":77762,"_33198":77745,"_22654":127920,"_5":15607,"_29907":127881,"_3297":127921},[],"99,5 %",{"_3844":77763,"_33198":77745,"_22654":127923,"_5":15607,"_29907":127881,"_3297":54617},[],{"_3844":77764,"_33198":77745,"_22654":127925,"_5":15607,"_29907":127881,"_3297":127926},[],"Hasta 10.000",{"_3844":77765,"_33198":77745,"_22654":127928,"_5":15607,"_29907":127881,"_3297":127929},[],"Email y chat",{"_3844":77766,"_33198":77745,"_22654":127931,"_5":15607,"_29907":127881,"_3297":127932},[],"99,9 %",{"_3844":77767,"_33198":77745,"_22654":127934,"_5":15607,"_29907":127881,"_3297":54629},[],{"_3844":77768,"_33198":77745,"_22654":127936,"_5":15607,"_29907":127881,"_3297":127937},[],"Ilimitados",{"_3844":77769,"_33198":77745,"_22654":127939,"_5":15607,"_29907":127881,"_3297":127940},[],"Dedicado",{"_3844":77770,"_33198":77745,"_22654":127942,"_5":15607,"_29907":127881,"_3297":127943},[],"99,99 %",{"_3844":77771,"_33198":77745,"_22654":127945,"_5":15607,"_29907":127885,"_3297":127946},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3844":77772,"_33198":77745,"_22654":127948,"_5":15607,"_29907":127885,"_3297":127949},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3844":77773,"_33198":77773,"_5":16006,"_3297":54646,"_33604":127951,"_22654":127953,"_29907":77773},[54402,127718,127952],"Kubernetes autogestionado",[],{"_3844":77774,"_33198":77773,"_22654":127955,"_5":15607,"_29907":77773,"_3297":127956},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3844":77775,"_33198":77773,"_5":33601,"_22654":127958,"_29907":127959,"_3297":127960},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3844":77776,"_33198":77773,"_5":33601,"_22654":127962,"_29907":127963,"_3297":127964},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3844":77777,"_33198":77773,"_5":33601,"_22654":127966,"_29907":127967,"_3297":127968},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3844":77778,"_33198":77773,"_5":33601,"_22654":127970,"_29907":127971,"_3297":127972},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3844":77779,"_33198":77773,"_5":33601,"_22654":127974,"_29907":127975,"_3297":127976},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3844":77780,"_33198":77773,"_5":33601,"_22654":127978,"_29907":127979,"_3297":127980},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3844":77781,"_33198":77773,"_5":33601,"_22654":127982,"_29907":127983,"_3297":127984},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3844":77782,"_33198":77773,"_5":33601,"_22654":127986,"_29907":127987,"_3297":127988},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3844":77783,"_33198":77773,"_5":33601,"_22654":127990,"_29907":127991,"_3297":127992},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3844":77784,"_33198":77773,"_5":33601,"_22654":127994,"_29907":127995,"_3297":127996},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3844":77785,"_33198":77773,"_5":33601,"_22654":127998,"_29907":127999,"_3297":128000},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3844":77786,"_33198":77773,"_22654":128002,"_5":15607,"_29907":127959,"_3297":128003},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3844":77787,"_33198":77773,"_22654":128005,"_5":15607,"_29907":127959,"_3297":128006},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3844":77788,"_33198":77773,"_22654":128008,"_5":15607,"_29907":127963,"_3297":128009},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3844":77789,"_33198":77773,"_22654":128011,"_5":15607,"_29907":127963,"_3297":128012},[],"Fastlane instala o configura",{"_3844":77790,"_33198":77773,"_22654":128014,"_5":15607,"_29907":127963,"_3297":128015},[],"Tú sigues proporcionando",{"_3844":77791,"_33198":77773,"_22654":128017,"_5":15607,"_29907":127963,"_3297":128018},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3844":77792,"_33198":77773,"_22654":128020,"_5":15607,"_29907":127963,"_3297":128021},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3844":77793,"_33198":77773,"_22654":128023,"_5":15607,"_29907":127963,"_3297":128024},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3844":77794,"_33198":77773,"_22654":128026,"_5":15607,"_29907":127963,"_3297":128027},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3844":77795,"_33198":77773,"_22654":128029,"_5":15607,"_29907":127963,"_3297":128030},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3844":77796,"_33198":77773,"_22654":128032,"_5":15607,"_29907":127963,"_3297":128033},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3844":77797,"_33198":77773,"_22654":128035,"_5":15607,"_29907":127963,"_3297":128036},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3844":77798,"_33198":77773,"_22654":128038,"_5":15607,"_29907":127963,"_3297":128039},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3844":77799,"_33198":77773,"_22654":128041,"_5":15607,"_29907":127963,"_3297":128042},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3844":77800,"_33198":77773,"_22654":128044,"_5":15607,"_29907":127967,"_3297":128045},[],"Necesitas:",{"_3844":77801,"_33198":77773,"_22654":128047,"_5":15607,"_29907":127967,"_3297":128048},[],"un clúster Kubernetes existente",{"_3844":77802,"_33198":77773,"_22654":128050,"_5":15607,"_29907":127967,"_3297":128051},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3844":77803,"_33198":77773,"_22654":128053,"_5":15607,"_29907":127967,"_3297":54748},[],{"_3844":77804,"_33198":77773,"_22654":128055,"_5":15607,"_29907":127967,"_3297":25695},[],{"_3844":77805,"_33198":77773,"_22654":128057,"_5":15607,"_29907":127967,"_3297":128058},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3844":77806,"_33198":77773,"_22654":128060,"_5":15607,"_29907":127967,"_3297":128061},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3844":77807,"_33198":77773,"_22654":128063,"_5":15607,"_29907":127967,"_3297":128064},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3844":77808,"_33198":77773,"_22654":128066,"_5":15607,"_29907":127967,"_3297":128067},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3844":77809,"_33198":77773,"_22654":128069,"_5":15607,"_29907":127967,"_3297":128070},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3844":77810,"_33198":77773,"_22654":128072,"_5":15607,"_29907":127971,"_3297":128073},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3844":77811,"_33198":77773,"_22654":128075,"_5":15607,"_29907":127971,"_3297":128076},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3844":77812,"_33198":77773,"_22654":128078,"_5":15607,"_29907":127975,"_3297":128079},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3844":77813,"_33198":77773,"_22654":128081,"_5":15607,"_29907":127975,"_3297":128082},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3844":77814,"_33198":77773,"_22654":128084,"_5":15607,"_29907":127975,"_3297":128085},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3844":77815,"_33198":77773,"_22654":128087,"_5":15607,"_29907":127975,"_3297":128088},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3844":77816,"_33198":77773,"_22654":128090,"_5":15607,"_29907":127979,"_3297":128091},[],"Opción",{"_3844":77817,"_33198":77773,"_22654":128093,"_5":15607,"_29907":127979,"_3297":128094},[],"Valor predeterminado",{"_3844":77818,"_33198":77773,"_22654":128096,"_5":15607,"_29907":127979,"_3297":128097},[],"Propósito",{"_3844":77819,"_33198":77773,"_22654":128099,"_5":15607,"_29907":127979,"_3297":54795},[],{"_3844":77820,"_33198":77773,"_22654":128101,"_5":15607,"_29907":127979,"_3297":54798},[],{"_3844":77821,"_33198":77773,"_22654":128103,"_5":15607,"_29907":127979,"_3297":128104},[],"Muestra la ayuda",{"_3844":77822,"_33198":77773,"_22654":128106,"_5":15607,"_29907":127979,"_3297":54804},[],{"_3844":77823,"_33198":77773,"_22654":128108,"_5":15607,"_29907":127979,"_3297":128109},[],"contexto actual",{"_3844":77824,"_33198":77773,"_22654":128111,"_5":15607,"_29907":127979,"_3297":128112},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3844":77825,"_33198":77773,"_22654":128114,"_5":15607,"_29907":127979,"_3297":54813},[],{"_3844":77826,"_33198":77773,"_22654":128116,"_5":15607,"_29907":127979,"_3297":7115},[],{"_3844":77827,"_33198":77773,"_22654":128118,"_5":15607,"_29907":127979,"_3297":128119},[],"Omite prompts y genera credenciales para las dependencias",{"_3844":77828,"_33198":77773,"_22654":128121,"_5":15607,"_29907":127979,"_3297":54821},[],{"_3844":77829,"_33198":77773,"_22654":128123,"_5":15607,"_29907":127979,"_3297":54824},[],{"_3844":77830,"_33198":77773,"_22654":128125,"_5":15607,"_29907":127979,"_3297":128126},[],"Namespace de la instalación",{"_3844":77831,"_33198":77773,"_22654":128128,"_5":15607,"_29907":127979,"_3297":54830},[],{"_3844":77832,"_33198":77773,"_22654":128130,"_5":15607,"_29907":127979,"_3297":54833},[],{"_3844":77833,"_33198":77773,"_22654":128132,"_5":15607,"_29907":127979,"_3297":128133},[],"Dominio usado por la UI, OIDC y el certificado",{"_3844":77834,"_33198":77773,"_22654":128135,"_5":15607,"_29907":127979,"_3297":54839},[],{"_3844":77835,"_33198":77773,"_22654":128137,"_5":15607,"_29907":127979,"_3297":16408},[],{"_3844":77836,"_33198":77773,"_22654":128139,"_5":15607,"_29907":127979,"_3297":128140},[],"Versión del chart de Lamassu",{"_3844":77837,"_33198":77773,"_22654":128142,"_5":15607,"_29907":127979,"_3297":54847},[],{"_3844":77838,"_33198":77773,"_22654":128144,"_5":15607,"_29907":127979,"_3297":54850},[],{"_3844":77839,"_33198":77773,"_22654":128146,"_5":15607,"_29907":127979,"_3297":128147},[],"Puerto del listener HTTPS",{"_3844":77840,"_33198":77773,"_22654":128149,"_5":15607,"_29907":127979,"_3297":54856},[],{"_3844":77841,"_33198":77773,"_22654":128151,"_5":15607,"_29907":127979,"_3297":54859},[],{"_3844":77842,"_33198":77773,"_22654":128153,"_5":15607,"_29907":127979,"_3297":128154},[],"Puerto del listener HTTP",{"_3844":77843,"_33198":77773,"_22654":128156,"_5":15607,"_29907":127979,"_3297":54865},[],{"_3844":77844,"_33198":77773,"_22654":128158,"_5":15607,"_29907":127979,"_3297":54798},[],{"_3844":77845,"_33198":77773,"_22654":128160,"_5":15607,"_29907":127979,"_3297":128161},[],"Certificado PEM para TLS downstream",{"_3844":77846,"_33198":77773,"_22654":128163,"_5":15607,"_29907":127979,"_3297":54873},[],{"_3844":77847,"_33198":77773,"_22654":128165,"_5":15607,"_29907":127979,"_3297":54798},[],{"_3844":77848,"_33198":77773,"_22654":128167,"_5":15607,"_29907":127979,"_3297":128168},[],"Clave privada PEM para TLS downstream",{"_3844":77849,"_33198":77773,"_22654":128170,"_5":15607,"_29907":127979,"_3297":54881},[],{"_3844":77850,"_33198":77773,"_22654":128172,"_5":15607,"_29907":127979,"_3297":128173},[],"chart del repositorio",{"_3844":77851,"_33198":77773,"_22654":128175,"_5":15607,"_29907":127979,"_3297":128176},[],"Usa un chart local de Lamassu sin empaquetar",{"_3844":77852,"_33198":77773,"_22654":128178,"_5":15607,"_29907":127979,"_3297":54890},[],{"_3844":77853,"_33198":77773,"_22654":128180,"_5":15607,"_29907":127979,"_3297":128181},[],"detección automática",{"_3844":77854,"_33198":77773,"_22654":128183,"_5":15607,"_29907":127979,"_3297":128184},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3844":77855,"_33198":77773,"_22654":128186,"_5":15607,"_29907":127979,"_3297":54898},[],{"_3844":77856,"_33198":77773,"_22654":128188,"_5":15607,"_29907":127979,"_3297":7115},[],{"_3844":77857,"_33198":77773,"_22654":128190,"_5":15607,"_29907":127979,"_3297":128191},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3844":77858,"_33198":77773,"_22654":128193,"_5":15607,"_29907":127979,"_3297":54906},[],{"_3844":77859,"_33198":77773,"_22654":128195,"_5":15607,"_29907":127979,"_3297":7115},[],{"_3844":77860,"_33198":77773,"_22654":128197,"_5":15607,"_29907":127979,"_3297":128198},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3844":77861,"_33198":77773,"_22654":128200,"_5":15607,"_29907":127979,"_3297":54914},[],{"_3844":77862,"_33198":77773,"_22654":128202,"_5":15607,"_29907":127979,"_3297":7115},[],{"_3844":77863,"_33198":77773,"_22654":128204,"_5":15607,"_29907":127979,"_3297":128205},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3844":77864,"_33198":77773,"_22654":128207,"_5":15607,"_29907":127979,"_3297":54922},[],{"_3844":77865,"_33198":77773,"_22654":128209,"_5":15607,"_29907":127979,"_3297":7115},[],{"_3844":77866,"_33198":77773,"_22654":128211,"_5":15607,"_29907":127979,"_3297":128212},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3844":77867,"_33198":77773,"_22654":128214,"_5":15607,"_29907":127979,"_3297":54930},[],{"_3844":77868,"_33198":77773,"_22654":128216,"_5":15607,"_29907":127979,"_3297":54933},[],{"_3844":77869,"_33198":77773,"_22654":128218,"_5":15607,"_29907":127979,"_3297":128219},[],"Usa otro chart local de SoftHSM",{"_3844":77870,"_33198":77773,"_22654":128221,"_5":15607,"_29907":127979,"_3297":128222},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3844":77871,"_33198":77773,"_22654":128224,"_5":15607,"_29907":127983,"_3297":128225},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3844":77872,"_33198":77773,"_22654":128227,"_5":15607,"_29907":127983,"_3297":128228},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3844":77873,"_33198":77773,"_22654":128230,"_5":15607,"_29907":127983,"_3297":128231},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3844":77874,"_33198":77773,"_22654":128233,"_5":15607,"_29907":127983,"_3297":128234},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3844":77875,"_33198":77773,"_22654":128236,"_5":15607,"_29907":127983,"_3297":128237},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3844":77876,"_33198":77773,"_22654":128239,"_5":15607,"_29907":127983,"_3297":128240},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3844":77877,"_33198":77773,"_22654":128242,"_5":15607,"_29907":127987,"_3297":54960},[],{"_3844":77878,"_33198":77773,"_22654":128244,"_5":15607,"_29907":127987,"_3297":128245},[],"valida las herramientas locales y el clúster seleccionado",{"_3844":77879,"_33198":77773,"_22654":128247,"_5":15607,"_29907":127987,"_3297":128248},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3844":77880,"_33198":77773,"_22654":128250,"_5":15607,"_29907":127987,"_3297":128251},[],"crea el namespace",{"_3844":77881,"_33198":77773,"_22654":128253,"_5":15607,"_29907":127987,"_3297":128254},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3844":77882,"_33198":77773,"_22654":128256,"_5":15607,"_29907":127987,"_3297":128257},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3844":77883,"_33198":77773,"_22654":128259,"_5":15607,"_29907":127987,"_3297":128260},[],"instala RabbitMQ",{"_3844":77884,"_33198":77773,"_22654":128262,"_5":15607,"_29907":127987,"_3297":128263},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3844":77885,"_33198":77773,"_22654":128265,"_5":15607,"_29907":127987,"_3297":128266},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3844":77886,"_33198":77773,"_22654":128268,"_5":15607,"_29907":127987,"_3297":128269},[],"carga datos de ejemplo opcionalmente",{"_3844":77887,"_33198":77773,"_22654":128271,"_5":15607,"_29907":127987,"_3297":128272},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3844":77888,"_33198":77773,"_22654":128274,"_5":15607,"_29907":127991,"_3297":128275},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3844":77889,"_33198":77773,"_22654":128277,"_5":15607,"_29907":127991,"_3297":128278},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3844":77890,"_33198":77773,"_22654":128280,"_5":15607,"_29907":127995,"_3297":128281},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3844":77891,"_33198":77773,"_22654":128283,"_5":15607,"_29907":127995,"_3297":128284},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3844":77892,"_33198":77773,"_22654":128286,"_5":15607,"_29907":127995,"_3297":128287},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3844":77893,"_33198":77773,"_22654":128289,"_5":15607,"_29907":127999,"_3297":128290},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3844":77894,"_33198":77894,"_5":16006,"_3297":128292,"_33604":128293,"_22654":128294,"_29907":77894},"Instala con Helm",[54402,127718,127952],[],{"_3844":77895,"_33198":77894,"_22654":128296,"_5":15607,"_29907":77894,"_3297":128297},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3844":77896,"_33198":77894,"_5":33601,"_22654":128299,"_29907":128300,"_3297":128301},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3844":77897,"_33198":77894,"_5":33601,"_22654":128303,"_29907":128304,"_3297":127968},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3844":77898,"_33198":77894,"_5":33601,"_22654":128306,"_29907":128307,"_3297":128308},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3844":77899,"_33198":77894,"_5":33601,"_22654":128310,"_29907":128311,"_3297":128312},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3844":77900,"_33198":77894,"_5":33601,"_22654":128314,"_29907":128315,"_3297":128316},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3844":77901,"_33198":77894,"_5":33601,"_22654":128318,"_29907":128319,"_3297":128320},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3844":77902,"_33198":77894,"_5":33601,"_22654":128322,"_29907":128323,"_3297":128324},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3844":77903,"_33198":77894,"_5":33601,"_22654":128326,"_29907":128327,"_3297":128328},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3844":77904,"_33198":77894,"_5":33601,"_22654":128330,"_29907":128331,"_3297":128332},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3844":77905,"_33198":77894,"_5":33601,"_22654":128334,"_29907":128335,"_3297":128336},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3844":77906,"_33198":77894,"_5":33601,"_22654":128338,"_29907":128339,"_3297":128340},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3844":77907,"_33198":77894,"_22654":128342,"_5":15607,"_29907":128300,"_3297":128343},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3844":77908,"_33198":77894,"_22654":128345,"_5":15607,"_29907":128304,"_3297":128346},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3844":77909,"_33198":77894,"_22654":128348,"_5":15607,"_29907":128304,"_3297":128349},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3844":77910,"_33198":77894,"_22654":128351,"_5":15607,"_29907":128304,"_3297":128352},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3844":77911,"_33198":77894,"_22654":128354,"_5":15607,"_29907":128304,"_3297":128355},[],"un broker RabbitMQ accesible y sus credenciales",{"_3844":77912,"_33198":77894,"_22654":128357,"_5":15607,"_29907":128304,"_3297":128358},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3844":77913,"_33198":77894,"_22654":128360,"_5":15607,"_29907":128304,"_3297":128361},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3844":77914,"_33198":77894,"_22654":128363,"_5":15607,"_29907":128304,"_3297":128364},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3844":77915,"_33198":77894,"_22654":128366,"_5":15607,"_29907":128304,"_3297":128367},[],"una StorageClass y un diseño de tráfico externo",{"_3844":77916,"_33198":77894,"_22654":128369,"_5":15607,"_29907":128304,"_3297":128370},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3844":77917,"_33198":77894,"_22654":128372,"_5":15607,"_29907":128304,"_3297":128373},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3844":77918,"_33198":77894,"_22654":128375,"_5":15607,"_29907":128304,"_3297":128376},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3844":77919,"_33198":77894,"_22654":128378,"_5":15607,"_29907":128307,"_3297":128379},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3844":77920,"_33198":77894,"_22654":128381,"_5":15607,"_29907":128307,"_3297":128382},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3844":77921,"_33198":77894,"_22654":128384,"_5":15607,"_29907":128307,"_3297":128385},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3844":77922,"_33198":77894,"_22654":128387,"_5":15607,"_29907":128311,"_3297":128388},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3844":77923,"_33198":77894,"_22654":128390,"_5":15607,"_29907":128311,"_3297":128391},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3844":77924,"_33198":77894,"_22654":128393,"_5":15607,"_29907":128311,"_3297":128394},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3844":77925,"_33198":77894,"_22654":128396,"_5":15607,"_29907":128311,"_3297":128397},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3844":77926,"_33198":77894,"_22654":128399,"_5":15607,"_29907":128315,"_3297":128400},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3844":77927,"_33198":77894,"_22654":128402,"_5":15607,"_29907":128319,"_3297":128403},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3844":77928,"_33198":77894,"_22654":128405,"_5":15607,"_29907":128319,"_3297":128406},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3844":77929,"_33198":77894,"_22654":128408,"_5":15607,"_29907":128319,"_3297":128409},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3844":77930,"_33198":77894,"_22654":128411,"_5":15607,"_29907":128319,"_3297":128412},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3844":77931,"_33198":77894,"_22654":128414,"_5":15607,"_29907":128319,"_3297":128415},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3844":77932,"_33198":77894,"_22654":128417,"_5":15607,"_29907":128319,"_3297":128418},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3844":77933,"_33198":77894,"_22654":128420,"_5":15607,"_29907":128319,"_3297":128421},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3844":77934,"_33198":77894,"_22654":128423,"_5":15607,"_29907":128323,"_3297":128424},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3844":77935,"_33198":77894,"_22654":128426,"_5":15607,"_29907":128323,"_3297":128427},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3844":77936,"_33198":77894,"_22654":128429,"_5":15607,"_29907":128323,"_3297":128430},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3844":77937,"_33198":77894,"_22654":128432,"_5":15607,"_29907":128323,"_3297":128433},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3844":77938,"_33198":77894,"_22654":128435,"_5":15607,"_29907":128327,"_3297":128436},[],"Para instalar un checkout local:",{"_3844":77939,"_33198":77894,"_22654":128438,"_5":15607,"_29907":128331,"_3297":128439},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3844":77940,"_33198":77894,"_22654":128441,"_5":15607,"_29907":128331,"_3297":128442},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3844":77941,"_33198":77894,"_22654":128444,"_5":15607,"_29907":128335,"_3297":128445},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3844":77942,"_33198":77894,"_22654":128447,"_5":15607,"_29907":128335,"_3297":128448},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3844":77943,"_33198":77894,"_22654":128450,"_5":15607,"_29907":128335,"_3297":128451},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3844":77944,"_33198":77894,"_22654":128453,"_5":15607,"_29907":128335,"_3297":128454},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3844":77945,"_33198":77894,"_22654":128456,"_5":15607,"_29907":128335,"_3297":128457},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3844":77946,"_33198":77894,"_22654":128459,"_5":15607,"_29907":128339,"_3297":128460},[],"Antes de pasar a producción, revisa:",{"_3844":77947,"_33198":77894,"_22654":128462,"_5":15607,"_29907":128339,"_3297":128463},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3844":77948,"_33198":77894,"_22654":128465,"_5":15607,"_29907":128339,"_3297":128466},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3844":77949,"_33198":77894,"_22654":128468,"_5":15607,"_29907":128339,"_3297":128469},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3844":77950,"_33198":77894,"_22654":128471,"_5":15607,"_29907":128339,"_3297":128472},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3844":77951,"_33198":77894,"_22654":128474,"_5":15607,"_29907":128339,"_3297":128475},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3844":77952,"_33198":77894,"_22654":128477,"_5":15607,"_29907":128339,"_3297":128478},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3844":77953,"_33198":77894,"_22654":128480,"_5":15607,"_29907":128339,"_3297":128481},[],"SMTP, observabilidad y entrega de alertas",{"_3844":77954,"_33198":77894,"_22654":128483,"_5":15607,"_29907":128339,"_3297":128484},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3844":77955,"_33198":77894,"_22654":128486,"_5":15607,"_29907":128339,"_3297":128487},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3844":77956,"_33198":77956,"_5":16006,"_3297":128489,"_33604":128490,"_22654":128491,"_29907":77956},"Expón el Gateway",[54402,127718,127952],[],{"_3844":77957,"_33198":77956,"_22654":128493,"_5":15607,"_29907":77956,"_3297":128494},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3844":77958,"_33198":77956,"_5":33601,"_22654":128496,"_29907":128497,"_3297":128498},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3844":77959,"_33198":77956,"_5":33601,"_22654":128500,"_29907":128501,"_3297":128502},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3844":77960,"_33198":77956,"_5":33601,"_22654":128504,"_29907":128505,"_3297":128506},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3844":77961,"_33198":77956,"_5":33601,"_22654":128508,"_29907":128509,"_3297":55228},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#k3s",{"_3844":77962,"_33198":77956,"_5":33601,"_22654":128511,"_29907":128512,"_3297":128513},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3844":77963,"_33198":77956,"_5":33601,"_22654":128515,"_29907":128516,"_3297":128517},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3844":77964,"_33198":77956,"_5":33601,"_22654":128519,"_29907":128520,"_3297":128521},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3844":77965,"_33198":77956,"_5":33601,"_22654":128523,"_29907":128524,"_3297":128525},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3844":77966,"_33198":77956,"_5":33601,"_22654":128527,"_29907":128528,"_3297":128529},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3844":77967,"_33198":77956,"_5":33601,"_22654":128531,"_29907":128532,"_3297":128533},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3844":77968,"_33198":77956,"_22654":128535,"_5":15607,"_29907":128497,"_3297":128536},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3844":77969,"_33198":77956,"_22654":128538,"_5":15607,"_29907":128497,"_3297":128539},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3844":77970,"_33198":77956,"_22654":128541,"_5":15607,"_29907":128501,"_3297":128542},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3844":77971,"_33198":77956,"_22654":128544,"_5":15607,"_29907":128501,"_3297":128545},[],"Defínelo únicamente cuando:",{"_3844":77972,"_33198":77956,"_22654":128547,"_5":15607,"_29907":128501,"_3297":128548},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3844":77973,"_33198":77956,"_22654":128550,"_5":15607,"_29907":128501,"_3297":128551},[],"esa dirección está asignada a este Gateway",{"_3844":77974,"_33198":77956,"_22654":128553,"_5":15607,"_29907":128501,"_3297":128554},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3844":77975,"_33198":77956,"_22654":128556,"_5":15607,"_29907":128501,"_3297":128557},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3844":77976,"_33198":77956,"_22654":128559,"_5":15607,"_29907":128501,"_3297":128560},[],"No confundas estos valores:",{"_3844":77977,"_33198":77956,"_22654":128562,"_5":15607,"_29907":128501,"_3297":128563},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3844":77978,"_33198":77956,"_22654":128565,"_5":15607,"_29907":128501,"_3297":128566},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3844":77979,"_33198":77956,"_22654":128568,"_5":15607,"_29907":128501,"_3297":128569},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3844":77980,"_33198":77956,"_22654":128571,"_5":15607,"_29907":128505,"_3297":128572},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3844":77981,"_33198":77956,"_22654":128574,"_5":15607,"_29907":128505,"_3297":128575},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3844":77982,"_33198":77956,"_22654":128577,"_5":15607,"_29907":128509,"_3297":128578},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3844":77983,"_33198":77956,"_22654":128580,"_5":15607,"_29907":128509,"_3297":128581},[],"Para el diseño recomendado:",{"_3844":77984,"_33198":77956,"_22654":128583,"_5":15607,"_29907":128509,"_3297":128584},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3844":77985,"_33198":77956,"_22654":128586,"_5":15607,"_29907":128509,"_3297":128587},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3844":77986,"_33198":77956,"_22654":128589,"_5":15607,"_29907":128509,"_3297":128590},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3844":77987,"_33198":77956,"_22654":128592,"_5":15607,"_29907":128509,"_3297":128593},[],"Apunta DNS a la dirección accesible de la VM.",{"_3844":77988,"_33198":77956,"_22654":128595,"_5":15607,"_29907":128509,"_3297":128596},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3844":77989,"_33198":77956,"_22654":128598,"_5":15607,"_29907":128512,"_3297":128599},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3844":77990,"_33198":77956,"_22654":128601,"_5":15607,"_29907":128516,"_3297":128602},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3844":77991,"_33198":77956,"_22654":128604,"_5":15607,"_29907":128516,"_3297":128605},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3844":77992,"_33198":77956,"_22654":128607,"_5":15607,"_29907":128520,"_3297":128608},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3844":77993,"_33198":77956,"_22654":128610,"_5":15607,"_29907":128520,"_3297":128611},[],"Requisito",{"_3844":77994,"_33198":77956,"_22654":128613,"_5":15607,"_29907":128520,"_3297":128614},[],"Diseño recomendado",{"_3844":77995,"_33198":77956,"_22654":128616,"_5":15607,"_29907":128520,"_3297":128617},[],"Consecuencia",{"_3844":77996,"_33198":77956,"_22654":128619,"_5":15607,"_29907":128520,"_3297":128620},[],"Varias URL o servicios de Lamassu",{"_3844":77997,"_33198":77956,"_22654":128622,"_5":15607,"_29907":128520,"_3297":128623},[],"Un Gateway con varias rutas",{"_3844":77998,"_33198":77956,"_22654":128625,"_5":15607,"_29907":128520,"_3297":128626},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3844":77999,"_33198":77956,"_22654":128628,"_5":15607,"_29907":128520,"_3297":128629},[],"Gateways independientes e IP externas distintas",{"_3844":78000,"_33198":77956,"_22654":128631,"_5":15607,"_29907":128520,"_3297":128632},[],"Una VIP por Gateway",{"_3844":78001,"_33198":77956,"_22654":128634,"_5":15607,"_29907":128520,"_3297":128635},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3844":78002,"_33198":77956,"_22654":128637,"_5":15607,"_29907":128520,"_3297":128638},[],"Gateways independientes, un nodo y una IP",{"_3844":78003,"_33198":77956,"_22654":128640,"_5":15607,"_29907":128520,"_3297":128641},[],"Puertos externos diferentes",{"_3844":78004,"_33198":77956,"_22654":128643,"_5":15607,"_29907":128520,"_3297":128644},[],"Los clientes deben indicar puertos no estándar",{"_3844":78005,"_33198":77956,"_22654":128646,"_5":15607,"_29907":128520,"_3297":128647},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3844":78006,"_33198":77956,"_22654":128649,"_5":15607,"_29907":128520,"_3297":128650},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3844":78007,"_33198":77956,"_22654":128652,"_5":15607,"_29907":128520,"_3297":128653},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3844":78008,"_33198":77956,"_22654":128655,"_5":15607,"_29907":128520,"_3297":128656},[],"Recursos Gateway separados pero proxy compartido",{"_3844":78009,"_33198":77956,"_22654":128658,"_5":15607,"_29907":128520,"_3297":128659},[],"Modo merged Gateway de Envoy",{"_3844":78010,"_33198":77956,"_22654":128661,"_5":15607,"_29907":128520,"_3297":128662},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3844":78011,"_33198":77956,"_22654":128664,"_5":15607,"_29907":128520,"_3297":128665},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3844":78012,"_33198":77956,"_22654":128667,"_5":15607,"_29907":128520,"_3297":128668},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3844":78013,"_33198":77956,"_22654":128670,"_5":15607,"_29907":128520,"_3297":128671},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3844":78014,"_33198":77956,"_22654":128673,"_5":15607,"_29907":128520,"_3297":128674},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3844":78015,"_33198":77956,"_22654":128676,"_5":15607,"_29907":128524,"_3297":128677},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3844":78016,"_33198":77956,"_22654":128679,"_5":15607,"_29907":128524,"_3297":128680},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3844":78017,"_33198":77956,"_22654":128682,"_5":15607,"_29907":128524,"_3297":128683},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3844":78018,"_33198":77956,"_22654":128685,"_5":15607,"_29907":128524,"_3297":128686},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3844":78019,"_33198":77956,"_22654":128688,"_5":15607,"_29907":128524,"_3297":128689},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3844":78020,"_33198":77956,"_22654":128691,"_5":15607,"_29907":128528,"_3297":128692},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3844":78021,"_33198":77956,"_22654":128694,"_5":15607,"_29907":128528,"_3297":128695},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3844":78022,"_33198":77956,"_22654":128697,"_5":15607,"_29907":128532,"_3297":128698},[],"Comprueba, en orden:",{"_3844":78023,"_33198":77956,"_22654":128700,"_5":15607,"_29907":128532,"_3297":128701},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3844":78024,"_33198":77956,"_22654":128703,"_5":15607,"_29907":128532,"_3297":128704},[],"Su estado contiene la dirección esperada.",{"_3844":78025,"_33198":77956,"_22654":128706,"_5":15607,"_29907":128532,"_3297":128707},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3844":78026,"_33198":77956,"_22654":128709,"_5":15607,"_29907":128532,"_3297":128710},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3844":78027,"_33198":77956,"_22654":128712,"_5":15607,"_29907":128532,"_3297":128713},[],"DNS resuelve al endpoint accesible externamente.",{"_3844":78028,"_33198":77956,"_22654":128715,"_5":15607,"_29907":128532,"_3297":128716},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3844":78029,"_33198":77956,"_22654":128718,"_5":15607,"_29907":128532,"_3297":128719},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3844":78030,"_33198":78030,"_5":16006,"_3297":54509,"_33604":128721,"_22654":128722,"_29907":78030},[54402,127718,127952],[],{"_3844":78031,"_33198":78030,"_22654":128724,"_5":15607,"_29907":78030,"_3297":128725},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3844":78032,"_33198":78030,"_5":33601,"_22654":128727,"_29907":128728,"_3297":128729},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3844":78033,"_33198":78030,"_5":33601,"_22654":128731,"_29907":128732,"_3297":128733},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3844":78034,"_33198":78030,"_5":33601,"_22654":128735,"_29907":128736,"_3297":128737},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3844":78035,"_33198":78030,"_5":33601,"_22654":128739,"_29907":128740,"_3297":128741},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3844":78036,"_33198":78030,"_5":33601,"_22654":128743,"_29907":128744,"_3297":128745},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3844":78037,"_33198":78030,"_5":33601,"_22654":128747,"_29907":128748,"_3297":128749},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3844":78038,"_33198":78030,"_22654":128751,"_5":15607,"_29907":128728,"_3297":128752},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3844":78039,"_33198":78030,"_22654":128754,"_5":15607,"_29907":128732,"_3297":128755},[],"Flujo",{"_3844":78040,"_33198":78030,"_22654":128757,"_5":15607,"_29907":128732,"_3297":128758},[],"Úsalo para",{"_3844":78041,"_33198":78030,"_22654":128760,"_5":15607,"_29907":128732,"_3297":128761},[],"Qué instala",{"_3844":78042,"_33198":78030,"_22654":128763,"_5":15607,"_29907":128732,"_3297":55483},[],{"_3844":78043,"_33198":78030,"_22654":128765,"_5":15607,"_29907":128732,"_3297":128766},[],"Producción y entornos controlados",{"_3844":78044,"_33198":78030,"_22654":128768,"_5":15607,"_29907":128732,"_3297":128769},[],"Servicios de Lamassu y recursos de Gateway API",{"_3844":78045,"_33198":78030,"_22654":128771,"_5":15607,"_29907":128732,"_3297":54646},[],{"_3844":78046,"_33198":78030,"_22654":128773,"_5":15607,"_29907":128732,"_3297":128774},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3844":78047,"_33198":78030,"_22654":128776,"_5":15607,"_29907":128732,"_3297":128777},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3844":78048,"_33198":78030,"_22654":128779,"_5":15607,"_29907":128736,"_3297":128780},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3844":78049,"_33198":78030,"_22654":128782,"_5":15607,"_29907":128736,"_3297":128783},[],"Área",{"_3844":78050,"_33198":78030,"_22654":128785,"_5":15607,"_29907":128736,"_3297":128786},[],"El chart de Lamassu proporciona",{"_3844":78051,"_33198":78030,"_22654":128788,"_5":15607,"_29907":128736,"_3297":128789},[],"Tú proporcionas",{"_3844":78052,"_33198":78030,"_22654":128791,"_5":15607,"_29907":128736,"_3297":128792},[],"Aplicaciones Lamassu",{"_3844":78053,"_33198":78030,"_22654":128794,"_5":15607,"_29907":128736,"_3297":128795},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3844":78054,"_33198":78030,"_22654":128797,"_5":15607,"_29907":128736,"_3297":128798},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3844":78055,"_33198":78030,"_22654":128800,"_5":15607,"_29907":128736,"_3297":128801},[],"Datos PostgreSQL",{"_3844":78056,"_33198":78030,"_22654":128803,"_5":15607,"_29907":128736,"_3297":128804},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3844":78057,"_33198":78030,"_22654":128806,"_5":15607,"_29907":128736,"_3297":128807},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3844":78058,"_33198":78030,"_22654":128809,"_5":15607,"_29907":128736,"_3297":128810},[],"Mensajería",{"_3844":78059,"_33198":78030,"_22654":128812,"_5":15607,"_29907":128736,"_3297":128813},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3844":78060,"_33198":78030,"_22654":128815,"_5":15607,"_29907":128736,"_3297":128816},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3844":78061,"_33198":78030,"_22654":128818,"_5":15607,"_29907":128736,"_3297":128819},[],"Identidad",{"_3844":78062,"_33198":78030,"_22654":128821,"_5":15607,"_29907":128736,"_3297":128822},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3844":78063,"_33198":78030,"_22654":128824,"_5":15607,"_29907":128736,"_3297":128825},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3844":78064,"_33198":78030,"_22654":128827,"_5":15607,"_29907":128736,"_3297":128828},[],"Enrutamiento externo",{"_3844":78065,"_33198":78030,"_22654":128830,"_5":15607,"_29907":128736,"_3297":128831},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3844":78066,"_33198":78030,"_22654":128833,"_5":15607,"_29907":128736,"_3297":128834},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3844":78067,"_33198":78030,"_22654":128836,"_5":15607,"_29907":128736,"_3297":55557},[],{"_3844":78068,"_33198":78030,"_22654":128838,"_5":15607,"_29907":128736,"_3297":128839},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3844":78069,"_33198":78030,"_22654":128841,"_5":15607,"_29907":128736,"_3297":128842},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3844":78070,"_33198":78030,"_22654":128844,"_5":15607,"_29907":128736,"_3297":128845},[],"Datos persistentes de la aplicación",{"_3844":78071,"_33198":78030,"_22654":128847,"_5":15607,"_29907":128736,"_3297":128848},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3844":78072,"_33198":78030,"_22654":128850,"_5":15607,"_29907":128736,"_3297":128851},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3844":78073,"_33198":78030,"_22654":128853,"_5":15607,"_29907":128736,"_3297":128854},[],"Integraciones opcionales",{"_3844":78074,"_33198":78030,"_22654":128856,"_5":15607,"_29907":128736,"_3297":128857},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3844":78075,"_33198":78030,"_22654":128859,"_5":15607,"_29907":128736,"_3297":128860},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3844":78076,"_33198":78030,"_22654":128862,"_5":15607,"_29907":128736,"_3297":128863},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3844":78077,"_33198":78030,"_22654":128865,"_5":15607,"_29907":128736,"_3297":128866},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3844":78078,"_33198":78030,"_22654":128868,"_5":15607,"_29907":128740,"_3297":128869},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3844":78079,"_33198":78030,"_22654":128871,"_5":15607,"_29907":128740,"_3297":128872},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3844":78080,"_33198":78030,"_22654":128874,"_5":15607,"_29907":128744,"_3297":128875},[],"Kubernetes 1.24 o posterior",{"_3844":78081,"_33198":78030,"_22654":128877,"_5":15607,"_29907":128744,"_3297":128878},[],"Helm 3.2 o posterior",{"_3844":78082,"_33198":78030,"_22654":128880,"_5":15607,"_29907":128744,"_3297":128881},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3844":78083,"_33198":78030,"_22654":128883,"_5":15607,"_29907":128744,"_3297":128884},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3844":78084,"_33198":78030,"_22654":128886,"_5":15607,"_29907":128744,"_3297":128887},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3844":78085,"_33198":78030,"_22654":128889,"_5":15607,"_29907":128744,"_3297":128890},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3844":78086,"_33198":78030,"_22654":128892,"_5":15607,"_29907":128744,"_3297":128893},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3844":78087,"_33198":78030,"_22654":128895,"_5":15607,"_29907":128748,"_3297":128896},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3844":78088,"_33198":78030,"_22654":128898,"_5":15607,"_29907":128748,"_3297":128899},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3844":78089,"_33198":78030,"_22654":128901,"_5":15607,"_29907":128748,"_3297":128902},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3844":78090,"_33198":78030,"_22654":128904,"_5":15607,"_29907":128748,"_3297":128905},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3844":78091,"_33198":78091,"_5":16006,"_3297":128907,"_33604":128908,"_22654":128910,"_29907":78091},"Resolución de problemas de despliegue",[54402,127718,128909],"Operación",[],{"_3844":78092,"_33198":78091,"_22654":128912,"_5":15607,"_29907":78091,"_3297":128913},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3844":78093,"_33198":78091,"_5":33601,"_22654":128915,"_29907":128916,"_3297":128917},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3844":78094,"_33198":78091,"_5":33601,"_22654":128919,"_29907":128920,"_3297":128921},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3844":78095,"_33198":78091,"_5":33601,"_22654":128923,"_29907":128924,"_3297":128925},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3844":78096,"_33198":78091,"_5":33601,"_22654":128927,"_29907":128928,"_3297":128929},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3844":78097,"_33198":78091,"_5":33601,"_22654":128931,"_29907":128932,"_3297":128933},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3844":78098,"_33198":78091,"_5":33601,"_22654":128935,"_29907":128936,"_3297":128937},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3844":78099,"_33198":78091,"_5":33601,"_22654":128939,"_29907":128940,"_3297":128941},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3844":78100,"_33198":78091,"_5":33601,"_22654":128943,"_29907":128944,"_3297":128945},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3844":78101,"_33198":78091,"_5":33601,"_22654":128947,"_29907":128948,"_3297":128949},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3844":78102,"_33198":78091,"_5":33601,"_22654":128951,"_29907":128952,"_3297":128953},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3844":78103,"_33198":78091,"_5":33601,"_22654":128955,"_29907":128956,"_3297":128957},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3844":78104,"_33198":78091,"_5":33601,"_22654":128959,"_29907":128960,"_3297":128961},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3844":78105,"_33198":78091,"_5":33601,"_22654":128963,"_29907":128964,"_3297":128965},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3844":78106,"_33198":78091,"_22654":128967,"_5":15607,"_29907":78091,"_3297":128968},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3844":78107,"_33198":78091,"_22654":128970,"_5":15607,"_29907":128920,"_3297":128971},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3844":78108,"_33198":78091,"_22654":128973,"_5":15607,"_29907":128924,"_3297":128974},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3844":78109,"_33198":78091,"_22654":128976,"_5":15607,"_29907":128928,"_3297":128977},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3844":78110,"_33198":78091,"_22654":128979,"_5":15607,"_29907":128932,"_3297":128980},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3844":78111,"_33198":78091,"_22654":128982,"_5":15607,"_29907":128936,"_3297":128983},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3844":78112,"_33198":78091,"_22654":128985,"_5":15607,"_29907":128940,"_3297":128986},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3844":78113,"_33198":78091,"_22654":128988,"_5":15607,"_29907":128940,"_3297":128989},[],"Ejecuta también la prueba de conectividad del chart:",{"_3844":78114,"_33198":78091,"_22654":128991,"_5":15607,"_29907":128940,"_3297":128992},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3844":78115,"_33198":78091,"_22654":128994,"_5":15607,"_29907":128940,"_3297":128995},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3844":78116,"_33198":78091,"_22654":128997,"_5":15607,"_29907":128944,"_3297":128998},[],"Si recibes un 401:",{"_3844":78117,"_33198":78091,"_22654":129000,"_5":15607,"_29907":128944,"_3297":129001},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3844":78118,"_33198":78091,"_22654":129003,"_5":15607,"_29907":128944,"_3297":129004},[],"verifica emisor, audiencia y expiración del token;",{"_3844":78119,"_33198":78091,"_22654":129006,"_5":15607,"_29907":128944,"_3297":129007},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3844":78120,"_33198":78091,"_22654":129009,"_5":15607,"_29907":128944,"_3297":129010},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3844":78121,"_33198":78091,"_22654":129012,"_5":15607,"_29907":128944,"_3297":129013},[],"Si el login termina pero las APIs devuelven 403:",{"_3844":78122,"_33198":78091,"_22654":129015,"_5":15607,"_29907":128944,"_3297":129016},[],"inspecciona los claims reales del token;",{"_3844":78123,"_33198":78091,"_22654":129018,"_5":15607,"_29907":128944,"_3297":129019},[],"confirma que coinciden con un principal activo;",{"_3844":78124,"_33198":78091,"_22654":129021,"_5":15607,"_29907":128944,"_3297":129022},[],"revisa las políticas concedidas al principal;",{"_3844":78125,"_33198":78091,"_22654":129024,"_5":15607,"_29907":128944,"_3297":129025},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3844":78126,"_33198":78091,"_22654":129027,"_5":15607,"_29907":128944,"_3297":129028},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3844":78127,"_33198":78091,"_22654":129030,"_5":15607,"_29907":128948,"_3297":129031},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3844":78128,"_33198":78091,"_22654":129033,"_5":15607,"_29907":128948,"_3297":129034},[],"Localiza el pod y Service de authz.",{"_3844":78129,"_33198":78091,"_22654":129036,"_5":15607,"_29907":128948,"_3297":129037},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3844":78130,"_33198":78091,"_22654":129039,"_5":15607,"_29907":128948,"_3297":129040},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3844":78131,"_33198":78091,"_22654":129042,"_5":15607,"_29907":128948,"_3297":129043},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3844":78132,"_33198":78091,"_22654":129045,"_5":15607,"_29907":128948,"_3297":129046},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3844":78133,"_33198":78091,"_22654":129048,"_5":15607,"_29907":128952,"_3297":129049},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3844":78134,"_33198":78091,"_22654":129051,"_5":15607,"_29907":128956,"_3297":129052},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3844":78135,"_33198":78091,"_22654":129054,"_5":15607,"_29907":128956,"_3297":129055},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3844":78136,"_33198":78091,"_22654":129057,"_5":15607,"_29907":128956,"_3297":129058},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3844":78137,"_33198":78091,"_22654":129060,"_5":15607,"_29907":128956,"_3297":129061},[],"volumen persistente sin enlazar;",{"_3844":78138,"_33198":78091,"_22654":129063,"_5":15607,"_29907":128956,"_3297":129064},[],"imagen inaccesible o política de pull incorrecta;",{"_3844":78139,"_33198":78091,"_22654":129066,"_5":15607,"_29907":128956,"_3297":129067},[],"configuración inválida del motor criptográfico;",{"_3844":78140,"_33198":78091,"_22654":129069,"_5":15607,"_29907":128956,"_3297":129070},[],"límites de CPU o memoria demasiado bajos;",{"_3844":78141,"_33198":78091,"_22654":129072,"_5":15607,"_29907":128956,"_3297":129073},[],"migración previa incompleta.",{"_3844":78142,"_33198":78091,"_22654":129075,"_5":15607,"_29907":128956,"_3297":129076},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3844":78143,"_33198":78091,"_22654":129078,"_5":15607,"_29907":128956,"_3297":129079},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3844":78144,"_33198":78091,"_22654":129081,"_5":15607,"_29907":128956,"_3297":129082},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3844":78145,"_33198":78091,"_22654":129084,"_5":15607,"_29907":128960,"_3297":129085},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3844":78146,"_33198":78091,"_22654":129087,"_5":15607,"_29907":128960,"_3297":129088},[],"verifica que esté habilitado en el servicio emisor;",{"_3844":78147,"_33198":78091,"_22654":129090,"_5":15607,"_29907":128960,"_3297":129091},[],"comprueba conectividad y credenciales AMQP;",{"_3844":78148,"_33198":78091,"_22654":129093,"_5":15607,"_29907":128960,"_3297":129094},[],"revisa exchange, routing key, colas y consumidores;",{"_3844":78149,"_33198":78091,"_22654":129096,"_5":15607,"_29907":128960,"_3297":129097},[],"inspecciona dead-letter queues;",{"_3844":78150,"_33198":78091,"_22654":129099,"_5":15607,"_29907":128960,"_3297":129100},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3844":78151,"_33198":78091,"_22654":129102,"_5":15607,"_29907":128960,"_3297":129103},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3844":78152,"_33198":78091,"_22654":129105,"_5":15607,"_29907":128960,"_3297":129106},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3844":78153,"_33198":78091,"_22654":129108,"_5":15607,"_29907":128960,"_3297":129109},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3844":78154,"_33198":78091,"_22654":129111,"_5":15607,"_29907":128960,"_3297":129112},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3844":78155,"_33198":78091,"_22654":129114,"_5":15607,"_29907":128960,"_3297":129115},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3844":78156,"_33198":78091,"_22654":129117,"_5":15607,"_29907":128960,"_3297":129118},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3844":78157,"_33198":78091,"_22654":129120,"_5":15607,"_29907":128960,"_3297":129121},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3844":78158,"_33198":78091,"_22654":129123,"_5":15607,"_29907":128964,"_3297":129124},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3844":78159,"_33198":78091,"_22654":129126,"_5":15607,"_29907":128964,"_3297":129127},[],"Antes de cerrar una incidencia, guarda:",{"_3844":78160,"_33198":78091,"_22654":129129,"_5":15607,"_29907":128964,"_3297":129130},[],"causa confirmada;",{"_3844":78161,"_33198":78091,"_22654":129132,"_5":15607,"_29907":128964,"_3297":129133},[],"alcance temporal y recursos afectados;",{"_3844":78162,"_33198":78091,"_22654":129135,"_5":15607,"_29907":128964,"_3297":129136},[],"comandos o consultas utilizados;",{"_3844":78163,"_33198":78091,"_22654":129138,"_5":15607,"_29907":128964,"_3297":129139},[],"cambio aplicado y forma de revertirlo;",{"_3844":78164,"_33198":78091,"_22654":129141,"_5":15607,"_29907":128964,"_3297":129142},[],"validación desde un consumidor;",{"_3844":78165,"_33198":78091,"_22654":129144,"_5":15607,"_29907":128964,"_3297":129145},[],"acción preventiva y propietario.",{"_3844":78166,"_33198":78166,"_5":16006,"_3297":129147,"_33604":129148,"_22654":129151,"_29907":78166},"Control de acceso",[54402,129149,129150],"Plataforma","Administración",[],{"_3844":78167,"_33198":78166,"_22654":129153,"_5":15607,"_29907":78166,"_3297":129154},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3844":78168,"_33198":78166,"_5":33601,"_22654":129156,"_29907":129157,"_3297":129158},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3844":78169,"_33198":78166,"_5":33601,"_22654":129160,"_29907":129161,"_3297":129162},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3844":78170,"_33198":78166,"_5":33601,"_22654":129164,"_29907":129165,"_3297":129166},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3844":78171,"_33198":78166,"_5":33601,"_22654":129168,"_29907":129169,"_3297":129170},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3844":78172,"_33198":78166,"_5":33601,"_22654":129172,"_29907":129173,"_3297":129174},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3844":78173,"_33198":78166,"_5":33601,"_22654":129176,"_29907":129177,"_3297":129178},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3844":78174,"_33198":78166,"_5":33601,"_22654":129180,"_29907":129181,"_3297":129182},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3844":78175,"_33198":78166,"_5":33601,"_22654":129184,"_29907":129185,"_3297":129186},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3844":78176,"_33198":78166,"_5":33601,"_22654":129188,"_29907":129189,"_3297":129190},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3844":78177,"_33198":78166,"_5":33601,"_22654":129192,"_29907":129193,"_3297":129194},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3844":78178,"_33198":78166,"_5":33601,"_22654":129196,"_29907":129197,"_3297":129198},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3844":78179,"_33198":78166,"_5":33601,"_22654":129200,"_29907":129201,"_3297":129202},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3844":78180,"_33198":78166,"_5":33601,"_22654":129204,"_29907":129205,"_3297":129206},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3844":78181,"_33198":78166,"_5":33601,"_22654":129208,"_29907":129209,"_3297":129210},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3844":78182,"_33198":78166,"_5":33601,"_22654":129212,"_29907":129213,"_3297":129214},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3844":78183,"_33198":78166,"_5":33601,"_22654":129216,"_29907":129217,"_3297":128324},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3844":78184,"_33198":78166,"_5":33601,"_22654":129219,"_29907":129220,"_3297":129221},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3844":78185,"_33198":78166,"_5":33601,"_22654":129223,"_29907":129224,"_3297":129225},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3844":78186,"_33198":78166,"_5":33601,"_22654":129227,"_29907":129228,"_3297":129229},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3844":78187,"_33198":78166,"_5":33601,"_22654":129231,"_29907":129232,"_3297":129233},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3844":78188,"_33198":78166,"_5":33601,"_22654":129235,"_29907":129236,"_3297":129237},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3844":78189,"_33198":78166,"_5":33601,"_22654":129239,"_29907":129240,"_3297":129241},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3844":78190,"_33198":78166,"_5":33601,"_22654":129243,"_29907":129244,"_3297":129245},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3844":78191,"_33198":78166,"_5":33601,"_22654":129247,"_29907":129248,"_3297":129249},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3844":78192,"_33198":78166,"_5":33601,"_22654":129251,"_29907":129252,"_3297":129253},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3844":78193,"_33198":78166,"_5":33601,"_22654":129255,"_29907":129256,"_3297":129257},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3844":78194,"_33198":78166,"_5":33601,"_22654":129259,"_29907":129260,"_3297":129261},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3844":78195,"_33198":78166,"_5":33601,"_22654":129263,"_29907":129264,"_3297":129265},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3844":78196,"_33198":78166,"_5":33601,"_22654":129267,"_29907":129268,"_3297":129269},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3844":78197,"_33198":78166,"_5":33601,"_22654":129271,"_29907":129272,"_3297":129273},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3844":78198,"_33198":78166,"_5":33601,"_22654":129275,"_29907":129276,"_3297":129277},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3844":78199,"_33198":78166,"_22654":129279,"_5":15607,"_29907":78166,"_3297":129280},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3844":78200,"_33198":78166,"_22654":129282,"_5":15607,"_29907":78166,"_3297":129283},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3844":78201,"_33198":78166,"_22654":129285,"_5":15607,"_29907":78166,"_3297":129286},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3844":78202,"_33198":78166,"_22654":129288,"_5":15607,"_29907":129157,"_3297":129289},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3844":78203,"_33198":78166,"_22654":129291,"_5":15607,"_29907":129157,"_3297":129292},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3844":78204,"_33198":78166,"_22654":129294,"_5":15607,"_29907":129157,"_3297":129295},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3844":78205,"_33198":78166,"_22654":129297,"_5":15607,"_29907":129157,"_3297":129298},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3844":78206,"_33198":78166,"_22654":129300,"_5":15607,"_29907":129157,"_3297":129301},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3844":78207,"_33198":78166,"_22654":129303,"_5":15607,"_29907":129157,"_3297":129304},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3844":78208,"_33198":78166,"_22654":129306,"_5":15607,"_29907":129161,"_3297":129307},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3844":78209,"_33198":78166,"_22654":129309,"_5":15607,"_29907":129161,"_3297":129310},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3844":78210,"_33198":78166,"_22654":129312,"_5":15607,"_29907":129165,"_3297":129313},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3844":78211,"_33198":78166,"_22654":129315,"_5":15607,"_29907":129165,"_3297":129316},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3844":78212,"_33198":78166,"_22654":129318,"_5":15607,"_29907":129165,"_3297":129319},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3844":78213,"_33198":78166,"_22654":129321,"_5":15607,"_29907":129165,"_3297":129322},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3844":78214,"_33198":78166,"_22654":129324,"_5":15607,"_29907":129165,"_3297":129325},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3844":78215,"_33198":78166,"_22654":129327,"_5":15607,"_29907":129165,"_3297":129328},[],"Carga por separado las políticas concedidas a cada principal.",{"_3844":78216,"_33198":78166,"_22654":129330,"_5":15607,"_29907":129165,"_3297":129331},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3844":78217,"_33198":78166,"_22654":129333,"_5":15607,"_29907":129165,"_3297":129334},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3844":78218,"_33198":78166,"_22654":129336,"_5":15607,"_29907":129165,"_3297":129337},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3844":78219,"_33198":78166,"_22654":129339,"_5":15607,"_29907":129165,"_3297":129340},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3844":78220,"_33198":78166,"_22654":129342,"_5":15607,"_29907":129165,"_3297":129343},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3844":78221,"_33198":78166,"_22654":129345,"_5":15607,"_29907":129165,"_3297":129346},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3844":78222,"_33198":78166,"_22654":129348,"_5":15607,"_29907":129169,"_3297":129349},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3844":78223,"_33198":78166,"_22654":129351,"_5":15607,"_29907":129169,"_3297":129352},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3844":78224,"_33198":78166,"_22654":129354,"_5":15607,"_29907":129169,"_3297":129355},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3844":78225,"_33198":78166,"_22654":129357,"_5":15607,"_29907":129169,"_3297":129358},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3844":78226,"_33198":78166,"_22654":129360,"_5":15607,"_29907":129169,"_3297":129361},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3844":78227,"_33198":78166,"_22654":129363,"_5":15607,"_29907":129169,"_3297":129364},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3844":78228,"_33198":78166,"_22654":129366,"_5":15607,"_29907":129169,"_3297":129367},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3844":78229,"_33198":78166,"_22654":129369,"_5":15607,"_29907":129169,"_3297":129370},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3844":78230,"_33198":78166,"_22654":129372,"_5":15607,"_29907":129173,"_3297":129373},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3844":78231,"_33198":78166,"_22654":129375,"_5":15607,"_29907":129173,"_3297":129376},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3844":78232,"_33198":78166,"_22654":129378,"_5":15607,"_29907":129173,"_3297":129379},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3844":78233,"_33198":78166,"_22654":129381,"_5":15607,"_29907":129173,"_3297":129382},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3844":78234,"_33198":78166,"_22654":129384,"_5":15607,"_29907":129173,"_3297":129385},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3844":78235,"_33198":78166,"_22654":129387,"_5":15607,"_29907":129173,"_3297":129388},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3844":78236,"_33198":78166,"_22654":129390,"_5":15607,"_29907":129173,"_3297":129391},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3844":78237,"_33198":78166,"_22654":129393,"_5":15607,"_29907":129173,"_3297":129394},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3844":78238,"_33198":78166,"_22654":129396,"_5":15607,"_29907":129173,"_3297":129397},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3844":78239,"_33198":78166,"_22654":129399,"_5":15607,"_29907":129173,"_3297":129400},[],"Las acciones se dividen en dos grupos:",{"_3844":78240,"_33198":78166,"_22654":129402,"_5":15607,"_29907":129173,"_3297":129403},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3844":78241,"_33198":78166,"_22654":129405,"_5":15607,"_29907":129173,"_3297":129406},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3844":78242,"_33198":78166,"_22654":129408,"_5":15607,"_29907":129173,"_3297":129409},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3844":78243,"_33198":78166,"_22654":129411,"_5":15607,"_29907":129177,"_3297":129412},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3844":78244,"_33198":78166,"_22654":129414,"_5":15607,"_29907":129177,"_3297":129415},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3844":78245,"_33198":78166,"_22654":129417,"_5":15607,"_29907":129177,"_3297":129418},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3844":78246,"_33198":78166,"_22654":129420,"_5":15607,"_29907":129181,"_3297":129421},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3844":78247,"_33198":78166,"_22654":129423,"_5":15607,"_29907":129181,"_3297":129424},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3844":78248,"_33198":78166,"_22654":129426,"_5":15607,"_29907":129181,"_3297":129427},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3844":78249,"_33198":78166,"_22654":129429,"_5":15607,"_29907":129181,"_3297":129430},[],"Los operadores implementados son:",{"_3844":78250,"_33198":78166,"_22654":129432,"_5":15607,"_29907":129181,"_3297":129433},[],"`equals`, para igualdad exacta;",{"_3844":78251,"_33198":78166,"_22654":129435,"_5":15607,"_29907":129181,"_3297":129436},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3844":78252,"_33198":78166,"_22654":129438,"_5":15607,"_29907":129181,"_3297":129439},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3844":78253,"_33198":78166,"_22654":129441,"_5":15607,"_29907":129181,"_3297":129442},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3844":78254,"_33198":78166,"_22654":129444,"_5":15607,"_29907":129185,"_3297":129445},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3844":78255,"_33198":78166,"_22654":129447,"_5":15607,"_29907":129185,"_3297":129448},[],"Los modos disponibles son:",{"_3844":78256,"_33198":78166,"_22654":129450,"_5":15607,"_29907":129185,"_3297":129451},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3844":78257,"_33198":78166,"_22654":129453,"_5":15607,"_29907":129185,"_3297":129454},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3844":78258,"_33198":78166,"_22654":129456,"_5":15607,"_29907":129185,"_3297":129457},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3844":78259,"_33198":78166,"_22654":129459,"_5":15607,"_29907":129185,"_3297":129460},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3844":78260,"_33198":78166,"_22654":129462,"_5":15607,"_29907":129185,"_3297":129463},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3844":78261,"_33198":78166,"_22654":129465,"_5":15607,"_29907":129185,"_3297":129466},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3844":78262,"_33198":78166,"_22654":129468,"_5":15607,"_29907":129189,"_3297":129469},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3844":78263,"_33198":78166,"_22654":129471,"_5":15607,"_29907":129189,"_3297":129472},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3844":78264,"_33198":78166,"_22654":129474,"_5":15607,"_29907":129189,"_3297":129475},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3844":78265,"_33198":78166,"_22654":129477,"_5":15607,"_29907":129189,"_3297":129478},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3844":78266,"_33198":78166,"_22654":129480,"_5":15607,"_29907":129197,"_3297":129481},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3844":78267,"_33198":78166,"_22654":129483,"_5":15607,"_29907":129197,"_3297":129484},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3844":78268,"_33198":78166,"_22654":129486,"_5":15607,"_29907":129201,"_3297":129487},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3844":78269,"_33198":78166,"_22654":129489,"_5":15607,"_29907":129201,"_3297":129490},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3844":78270,"_33198":78166,"_22654":129492,"_5":15607,"_29907":129205,"_3297":129493},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3844":78271,"_33198":78166,"_22654":129495,"_5":15607,"_29907":129205,"_3297":129496},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3844":78272,"_33198":78166,"_22654":129498,"_5":15607,"_29907":129205,"_3297":129499},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3844":78273,"_33198":78166,"_22654":129501,"_5":15607,"_29907":129209,"_3297":129502},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3844":78274,"_33198":78166,"_22654":129504,"_5":15607,"_29907":129209,"_3297":129505},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3844":78275,"_33198":78166,"_22654":129507,"_5":15607,"_29907":129209,"_3297":129508},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3844":78276,"_33198":78166,"_22654":129510,"_5":15607,"_29907":129209,"_3297":129511},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3844":78277,"_33198":78166,"_22654":129513,"_5":15607,"_29907":129209,"_3297":129514},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3844":78278,"_33198":78166,"_22654":129516,"_5":15607,"_29907":129209,"_3297":129517},[],"Ten en cuenta que:",{"_3844":78279,"_33198":78166,"_22654":129519,"_5":15607,"_29907":129209,"_3297":129520},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3844":78280,"_33198":78166,"_22654":129522,"_5":15607,"_29907":129209,"_3297":129523},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3844":78281,"_33198":78166,"_22654":129525,"_5":15607,"_29907":129209,"_3297":129526},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3844":78282,"_33198":78166,"_22654":129528,"_5":15607,"_29907":129213,"_3297":129529},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3844":78283,"_33198":78166,"_22654":129531,"_5":15607,"_29907":129213,"_3297":129532},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3844":78284,"_33198":78166,"_22654":129534,"_5":15607,"_29907":129213,"_3297":129535},[],"acceso completo y de solo lectura a KMS;",{"_3844":78285,"_33198":78166,"_22654":129537,"_5":15607,"_29907":129213,"_3297":129538},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3844":78286,"_33198":78166,"_22654":129540,"_5":15607,"_29907":129213,"_3297":129541},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3844":78287,"_33198":78166,"_22654":129543,"_5":15607,"_29907":129213,"_3297":129544},[],"acceso a la interfaz;",{"_3844":78288,"_33198":78166,"_22654":129546,"_5":15607,"_29907":129213,"_3297":129547},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3844":78289,"_33198":78166,"_22654":129549,"_5":15607,"_29907":129213,"_3297":129550},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3844":78290,"_33198":78166,"_22654":129552,"_5":15607,"_29907":129213,"_3297":129553},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3844":78291,"_33198":78166,"_22654":129555,"_5":15607,"_29907":129217,"_3297":129556},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3844":78292,"_33198":78166,"_22654":129558,"_5":15607,"_29907":129217,"_3297":129559},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3844":78293,"_33198":78166,"_22654":129561,"_5":15607,"_29907":129217,"_3297":129562},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3844":78294,"_33198":78166,"_22654":129564,"_5":15607,"_29907":129220,"_3297":129565},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3844":78295,"_33198":78166,"_22654":129567,"_5":15607,"_29907":129224,"_3297":129568},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3844":78296,"_33198":78166,"_22654":129570,"_5":15607,"_29907":129224,"_3297":129571},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3844":78297,"_33198":78166,"_22654":129573,"_5":15607,"_29907":129228,"_3297":129574},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3844":78298,"_33198":78166,"_22654":129576,"_5":15607,"_29907":129232,"_3297":129577},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3844":78299,"_33198":78166,"_22654":129579,"_5":15607,"_29907":129236,"_3297":129580},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3844":78300,"_33198":78166,"_22654":129582,"_5":15607,"_29907":129240,"_3297":129583},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3844":78301,"_33198":78166,"_22654":129585,"_5":15607,"_29907":129240,"_3297":129586},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3844":78302,"_33198":78166,"_22654":129588,"_5":15607,"_29907":129244,"_3297":129589},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3844":78303,"_33198":78166,"_22654":129591,"_5":15607,"_29907":129244,"_3297":129592},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3844":78304,"_33198":78166,"_22654":129594,"_5":15607,"_29907":129244,"_3297":129595},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3844":78305,"_33198":78166,"_22654":129597,"_5":15607,"_29907":129244,"_3297":129598},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3844":78306,"_33198":78166,"_22654":129600,"_5":15607,"_29907":129244,"_3297":129601},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3844":78307,"_33198":78166,"_22654":129603,"_5":15607,"_29907":129244,"_3297":129604},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3844":78308,"_33198":78166,"_22654":129606,"_5":15607,"_29907":129244,"_3297":129607},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3844":78309,"_33198":78166,"_22654":129609,"_5":15607,"_29907":129244,"_3297":129610},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3844":78310,"_33198":78166,"_22654":129612,"_5":15607,"_29907":129248,"_3297":129613},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3844":78311,"_33198":78166,"_22654":129615,"_5":15607,"_29907":129248,"_3297":129616},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3844":78312,"_33198":78166,"_22654":129618,"_5":15607,"_29907":129248,"_3297":129619},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3844":78313,"_33198":78166,"_22654":129621,"_5":15607,"_29907":129252,"_3297":129622},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3844":78314,"_33198":78166,"_22654":129624,"_5":15607,"_29907":129252,"_3297":129625},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3844":78315,"_33198":78166,"_22654":129627,"_5":15607,"_29907":129252,"_3297":129628},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3844":78316,"_33198":78166,"_22654":129630,"_5":15607,"_29907":129252,"_3297":129631},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3844":78317,"_33198":78166,"_22654":129633,"_5":15607,"_29907":129252,"_3297":129634},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3844":78318,"_33198":78166,"_22654":129636,"_5":15607,"_29907":129252,"_3297":129637},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3844":78319,"_33198":78166,"_22654":129639,"_5":15607,"_29907":129252,"_3297":129640},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3844":78320,"_33198":78166,"_22654":129642,"_5":15607,"_29907":129252,"_3297":129643},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3844":78321,"_33198":78166,"_22654":129645,"_5":15607,"_29907":129260,"_3297":129646},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3844":78322,"_33198":78166,"_22654":129648,"_5":15607,"_29907":129264,"_3297":129649},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3844":78323,"_33198":78166,"_22654":129651,"_5":15607,"_29907":129264,"_3297":129652},[],"que exista un principal activo del tipo correcto;",{"_3844":78324,"_33198":78166,"_22654":129654,"_5":15607,"_29907":129264,"_3297":129655},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3844":78325,"_33198":78166,"_22654":129657,"_5":15607,"_29907":129264,"_3297":129658},[],"que todas las condiciones del principal se cumplan;",{"_3844":78326,"_33198":78166,"_22654":129660,"_5":15607,"_29907":129264,"_3297":129661},[],"que el principal tenga concedida la política esperada;",{"_3844":78327,"_33198":78166,"_22654":129663,"_5":15607,"_29907":129264,"_3297":129664},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3844":78328,"_33198":78166,"_22654":129666,"_5":15607,"_29907":129264,"_3297":129667},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3844":78329,"_33198":78166,"_22654":129669,"_5":15607,"_29907":129264,"_3297":129670},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3844":78330,"_33198":78166,"_22654":129672,"_5":15607,"_29907":129268,"_3297":129673},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3844":78331,"_33198":78166,"_22654":129675,"_5":15607,"_29907":129272,"_3297":129676},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3844":78332,"_33198":78166,"_22654":129678,"_5":15607,"_29907":129276,"_3297":129679},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3844":78333,"_33198":78166,"_22654":129681,"_5":15607,"_29907":129276,"_3297":129682},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3844":78334,"_33198":78334,"_5":16006,"_3297":129684,"_33604":129685,"_22654":129686,"_29907":78334},"Alertas y suscripciones",[54402,129149,129150],[],{"_3844":78335,"_33198":78334,"_22654":129688,"_5":15607,"_29907":78334,"_3297":129689},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3844":78336,"_33198":78334,"_5":33601,"_22654":129691,"_29907":129692,"_3297":129693},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3844":78337,"_33198":78334,"_5":33601,"_22654":129695,"_29907":129696,"_3297":129697},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3844":78338,"_33198":78334,"_5":33601,"_22654":129699,"_29907":129700,"_3297":129701},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3844":78339,"_33198":78334,"_5":33601,"_22654":129703,"_29907":129704,"_3297":129705},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3844":78340,"_33198":78334,"_5":33601,"_22654":129707,"_29907":129708,"_3297":129709},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3844":78341,"_33198":78334,"_5":33601,"_22654":129711,"_29907":129712,"_3297":129713},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3844":78342,"_33198":78334,"_5":33601,"_22654":129715,"_29907":129716,"_3297":129717},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3844":78343,"_33198":78334,"_5":33601,"_22654":129719,"_29907":129720,"_3297":129721},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3844":78344,"_33198":78334,"_5":33601,"_22654":129723,"_29907":129724,"_3297":129725},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3844":78345,"_33198":78334,"_5":33601,"_22654":129727,"_29907":129728,"_3297":129729},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3844":78346,"_33198":78334,"_5":33601,"_22654":129731,"_29907":129732,"_3297":129733},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3844":78347,"_33198":78334,"_22654":129735,"_5":15607,"_29907":78334,"_3297":129736},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3844":78348,"_33198":78334,"_22654":129738,"_5":15607,"_29907":129692,"_3297":129739},[],"Un servicio publica un evento de dominio.",{"_3844":78349,"_33198":78334,"_22654":129741,"_5":15607,"_29907":129692,"_3297":129742},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3844":78350,"_33198":78334,"_22654":129744,"_5":15607,"_29907":129692,"_3297":129745},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3844":78351,"_33198":78334,"_22654":129747,"_5":15607,"_29907":129692,"_3297":129748},[],"Lamassu entrega el evento al canal configurado.",{"_3844":78352,"_33198":78334,"_22654":129750,"_5":15607,"_29907":129692,"_3297":129751},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3844":78353,"_33198":78334,"_22654":129753,"_5":15607,"_29907":129696,"_3297":129754},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3844":78354,"_33198":78334,"_22654":129756,"_5":15607,"_29907":129696,"_3297":129757},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3844":78355,"_33198":78334,"_22654":129759,"_5":15607,"_29907":129696,"_3297":129760},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3844":78356,"_33198":78334,"_22654":129762,"_5":15607,"_29907":129696,"_3297":129763},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3844":78357,"_33198":78334,"_22654":129765,"_5":15607,"_29907":129696,"_3297":129766},[],"`apikey_options` necesita `header` y `key`.",{"_3844":78358,"_33198":78334,"_22654":129768,"_5":15607,"_29907":129696,"_3297":129769},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3844":78359,"_33198":78334,"_22654":129771,"_5":15607,"_29907":129696,"_3297":129772},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3844":78360,"_33198":78334,"_22654":129774,"_5":15607,"_29907":129696,"_3297":129775},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3844":78361,"_33198":78334,"_22654":129777,"_5":15607,"_29907":129704,"_3297":129778},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3844":78362,"_33198":78334,"_22654":129780,"_5":15607,"_29907":129708,"_3297":129781},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3844":78363,"_33198":78334,"_22654":129783,"_5":15607,"_29907":129712,"_3297":129784},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3844":78364,"_33198":78334,"_22654":129786,"_5":15607,"_29907":129712,"_3297":129787},[],"**None** notifica todas las instancias del evento.",{"_3844":78365,"_33198":78334,"_22654":129789,"_5":15607,"_29907":129712,"_3297":129790},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3844":78366,"_33198":78334,"_22654":129792,"_5":15607,"_29907":129712,"_3297":129793},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3844":78367,"_33198":78334,"_22654":129795,"_5":15607,"_29907":129712,"_3297":129796},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3844":78368,"_33198":78334,"_22654":129798,"_5":15607,"_29907":129712,"_3297":129799},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3844":78369,"_33198":78334,"_22654":129801,"_5":15607,"_29907":129712,"_3297":129802},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3844":78370,"_33198":78334,"_22654":129804,"_5":15607,"_29907":129716,"_3297":129805},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3844":78371,"_33198":78334,"_22654":129807,"_5":15607,"_29907":129720,"_3297":129808},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3844":78372,"_33198":78334,"_22654":129810,"_5":15607,"_29907":129720,"_3297":129811},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3844":78373,"_33198":78334,"_22654":129813,"_5":15607,"_29907":129720,"_3297":129814},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3844":78374,"_33198":78334,"_22654":129816,"_5":15607,"_29907":129720,"_3297":129817},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3844":78375,"_33198":78334,"_22654":129819,"_5":15607,"_29907":129720,"_3297":129820},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3844":78376,"_33198":78334,"_22654":129822,"_5":15607,"_29907":129720,"_3297":129823},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3844":78377,"_33198":78334,"_22654":129825,"_5":15607,"_29907":129720,"_3297":129826},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3844":78378,"_33198":78334,"_22654":129828,"_5":15607,"_29907":129720,"_3297":129829},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3844":78379,"_33198":78334,"_22654":129831,"_5":15607,"_29907":129724,"_3297":129832},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3844":78380,"_33198":78334,"_22654":129834,"_5":15607,"_29907":129724,"_3297":129835},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3844":78381,"_33198":78334,"_22654":129837,"_5":15607,"_29907":129724,"_3297":129838},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3844":78382,"_33198":78334,"_22654":129840,"_5":15607,"_29907":129724,"_3297":129841},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3844":78383,"_33198":78334,"_22654":129843,"_5":15607,"_29907":129724,"_3297":129844},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3844":78384,"_33198":78334,"_22654":129846,"_5":15607,"_29907":129724,"_3297":129847},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3844":78385,"_33198":78334,"_22654":129849,"_5":15607,"_29907":129724,"_3297":129850},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3844":78386,"_33198":78334,"_22654":129852,"_5":15607,"_29907":129724,"_3297":129853},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3844":78387,"_33198":78334,"_22654":129855,"_5":15607,"_29907":129728,"_3297":129856},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3844":78388,"_33198":78334,"_22654":129858,"_5":15607,"_29907":129728,"_3297":129859},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3844":78389,"_33198":78334,"_22654":129861,"_5":15607,"_29907":129732,"_3297":129862},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3844":78390,"_33198":78334,"_22654":129864,"_5":15607,"_29907":129732,"_3297":129865},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3844":78391,"_33198":78334,"_22654":129867,"_5":15607,"_29907":129732,"_3297":129868},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3844":78392,"_33198":78334,"_22654":129870,"_5":15607,"_29907":129732,"_3297":129871},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3844":78393,"_33198":78334,"_22654":129873,"_5":15607,"_29907":129732,"_3297":129874},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3844":78394,"_33198":78334,"_22654":129876,"_5":15607,"_29907":129732,"_3297":129877},[],"**Validación:** `va.role.crl.create`.",{"_3844":78395,"_33198":78334,"_22654":129879,"_5":15607,"_29907":129732,"_3297":129880},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3844":78396,"_33198":78334,"_22654":129882,"_5":15607,"_29907":129732,"_3297":129883},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3844":78397,"_33198":78397,"_5":16006,"_3297":129885,"_33604":129886,"_22654":129887,"_29907":78397},"Registros de auditoría",[54402,129149,129150],[],{"_3844":78398,"_33198":78397,"_22654":129889,"_5":15607,"_29907":78397,"_3297":129890},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3844":78399,"_33198":78397,"_5":33601,"_22654":129892,"_29907":129893,"_3297":129894},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3844":78400,"_33198":78397,"_5":33601,"_22654":129896,"_29907":129897,"_3297":129898},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3844":78401,"_33198":78397,"_5":33601,"_22654":129900,"_29907":129901,"_3297":129902},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3844":78402,"_33198":78397,"_5":33601,"_22654":129904,"_29907":129905,"_3297":129906},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3844":78403,"_33198":78397,"_5":33601,"_22654":129908,"_29907":129909,"_3297":129910},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3844":78404,"_33198":78397,"_5":33601,"_22654":129912,"_29907":129913,"_3297":129914},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3844":78405,"_33198":78397,"_5":33601,"_22654":129916,"_29907":129917,"_3297":129918},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3844":78406,"_33198":78397,"_5":33601,"_22654":129920,"_29907":129921,"_3297":129922},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3844":78407,"_33198":78397,"_5":33601,"_22654":129924,"_29907":129925,"_3297":129926},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3844":78408,"_33198":78397,"_5":33601,"_22654":129928,"_29907":129929,"_3297":129930},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3844":78409,"_33198":78397,"_5":33601,"_22654":129932,"_29907":129933,"_3297":129934},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3844":78410,"_33198":78397,"_22654":129936,"_5":15607,"_29907":78397,"_3297":129937},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3844":78411,"_33198":78397,"_22654":129939,"_5":15607,"_29907":129893,"_3297":129940},[],"El cuerpo de auditoría incluye:",{"_3844":78412,"_33198":78397,"_22654":129942,"_5":15607,"_29907":129893,"_3297":129943},[],"input: datos recibidos por la operación;",{"_3844":78413,"_33198":78397,"_22654":129945,"_5":15607,"_29907":129893,"_3297":129946},[],"has\\_error: indica si el servicio devolvió un error;",{"_3844":78414,"_33198":78397,"_22654":129948,"_5":15607,"_29907":129893,"_3297":129949},[],"output: resultado producido o mensaje de error;",{"_3844":78415,"_33198":78397,"_22654":129951,"_5":15607,"_29907":129893,"_3297":129952},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3844":78416,"_33198":78397,"_22654":129954,"_5":15607,"_29907":129893,"_3297":129955},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3844":78417,"_33198":78397,"_22654":129957,"_5":15607,"_29907":129893,"_3297":129958},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3844":78418,"_33198":78397,"_22654":129960,"_5":15607,"_29907":129897,"_3297":129961},[],"El backend aplica auditoría a mutaciones de:",{"_3844":78419,"_33198":78397,"_22654":129963,"_5":15607,"_29907":129897,"_3297":129964},[],"autoridades, certificados y perfiles de emisión;",{"_3844":78420,"_33198":78397,"_22654":129966,"_5":15607,"_29907":129897,"_3297":129967},[],"claves y motores KMS;",{"_3844":78421,"_33198":78397,"_22654":129969,"_5":15607,"_29907":129897,"_3297":129970},[],"dispositivos e identidades;",{"_3844":78422,"_33198":78397,"_22654":129972,"_5":15607,"_29907":129897,"_3297":129973},[],"DMS y operaciones de enrolamiento;",{"_3844":78423,"_33198":78397,"_22654":129975,"_5":15607,"_29907":129897,"_3297":129976},[],"funciones de validación y CRL;",{"_3844":78424,"_33198":78397,"_22654":129978,"_5":15607,"_29907":129897,"_3297":129979},[],"principales, políticas y concesiones de autorización.",{"_3844":78425,"_33198":78397,"_22654":129981,"_5":15607,"_29907":129897,"_3297":129982},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3844":78426,"_33198":78397,"_22654":129984,"_5":15607,"_29907":129901,"_3297":129985},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3844":78427,"_33198":78397,"_22654":129987,"_5":15607,"_29907":129901,"_3297":129988},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3844":78428,"_33198":78397,"_22654":129990,"_5":15607,"_29907":129901,"_3297":129991},[],"Diseña el consumidor para:",{"_3844":78429,"_33198":78397,"_22654":129993,"_5":15607,"_29907":129901,"_3297":129994},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3844":78430,"_33198":78397,"_22654":129996,"_5":15607,"_29907":129901,"_3297":129997},[],"conservar el CloudEvent completo sin modificar;",{"_3844":78431,"_33198":78397,"_22654":129999,"_5":15607,"_29907":129901,"_3297":130000},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3844":78432,"_33198":78397,"_22654":130002,"_5":15607,"_29907":129901,"_3297":130003},[],"cifrar en tránsito y en reposo;",{"_3844":78433,"_33198":78397,"_22654":130005,"_5":15607,"_29907":129901,"_3297":130006},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3844":78434,"_33198":78397,"_22654":130008,"_5":15607,"_29907":129901,"_3297":130009},[],"aplicar una política explícita de retención y legal hold;",{"_3844":78435,"_33198":78397,"_22654":130011,"_5":15607,"_29907":129901,"_3297":130012},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3844":78436,"_33198":78397,"_22654":130014,"_5":15607,"_29907":129905,"_3297":130015},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3844":78437,"_33198":78397,"_22654":130017,"_5":15607,"_29907":129905,"_3297":130018},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3844":78438,"_33198":78397,"_22654":130020,"_5":15607,"_29907":129913,"_3297":130021},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3844":78439,"_33198":78397,"_22654":130023,"_5":15607,"_29907":129917,"_3297":130024},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3844":78440,"_33198":78397,"_22654":130026,"_5":15607,"_29907":129921,"_3297":130027},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3844":78441,"_33198":78397,"_22654":130029,"_5":15607,"_29907":129925,"_3297":130030},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3844":78442,"_33198":78397,"_22654":130032,"_5":15607,"_29907":129929,"_3297":130033},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3844":78443,"_33198":78397,"_22654":130035,"_5":15607,"_29907":129933,"_3297":130036},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3844":78444,"_33198":78397,"_22654":130038,"_5":15607,"_29907":129933,"_3297":130039},[],"aparece un evento de auditoría correcto;",{"_3844":78445,"_33198":78397,"_22654":130041,"_5":15607,"_29907":129933,"_3297":130042},[],"el principal coincide con la identidad utilizada;",{"_3844":78446,"_33198":78397,"_22654":130044,"_5":15607,"_29907":129933,"_3297":130045},[],"el consumidor lo persiste una sola vez;",{"_3844":78447,"_33198":78397,"_22654":130047,"_5":15607,"_29907":129933,"_3297":130048},[],"puede recuperarse por recurso, actor y periodo;",{"_3844":78448,"_33198":78397,"_22654":130050,"_5":15607,"_29907":129933,"_3297":130051},[],"una interrupción del consumidor produce una alerta.",{"_3844":78449,"_33198":78397,"_22654":130053,"_5":15607,"_29907":129933,"_3297":130054},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3844":78450,"_33198":78450,"_5":16006,"_3297":130056,"_33604":130057,"_22654":130058,"_29907":78450},"Arquitectura de la plataforma",[54402,129149],[],{"_3844":78451,"_33198":78450,"_22654":130060,"_5":15607,"_29907":78450,"_3297":130061},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3844":78452,"_33198":78450,"_5":33601,"_22654":130063,"_29907":130064,"_3297":130065},[],"/docs/pr-preview/pr-58/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3844":78453,"_33198":78450,"_5":33601,"_22654":130067,"_29907":130068,"_3297":130069},[],"/docs/pr-preview/pr-58/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3844":78454,"_33198":78450,"_5":33601,"_22654":130071,"_29907":130072,"_3297":130073},[],"/docs/pr-preview/pr-58/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3844":78455,"_33198":78450,"_5":33601,"_22654":130075,"_29907":130076,"_3297":130077},[],"/docs/pr-preview/pr-58/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3844":78456,"_33198":78450,"_5":33601,"_22654":130079,"_29907":130080,"_3297":130081},[],"/docs/pr-preview/pr-58/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3844":78457,"_33198":78450,"_22654":130083,"_5":15607,"_29907":78450,"_3297":130084},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3844":78458,"_33198":78450,"_22654":130086,"_5":15607,"_29907":78450,"_3297":130087},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3844":78459,"_33198":78450,"_22654":130089,"_5":15607,"_29907":130064,"_3297":130090},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3844":78460,"_33198":78450,"_22654":130092,"_5":15607,"_29907":130068,"_3297":130093},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3844":78461,"_33198":78450,"_22654":130095,"_5":15607,"_29907":130072,"_3297":130096},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3844":78462,"_33198":78450,"_22654":130098,"_5":15607,"_29907":130076,"_3297":130099},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3844":78463,"_33198":78450,"_22654":130101,"_5":15607,"_29907":130080,"_3297":130102},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3844":78464,"_33198":78464,"_5":16006,"_3297":130104,"_33604":130105,"_22654":130106,"_29907":78464},"Cómo funciona Lamassu",[54402,129149],[],{"_3844":78465,"_33198":78464,"_22654":130108,"_5":15607,"_29907":78464,"_3297":130109},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3844":78466,"_33198":78464,"_5":33601,"_22654":130111,"_29907":130112,"_3297":130113},[],"/docs/pr-preview/pr-58/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3844":78467,"_33198":78464,"_5":33601,"_22654":130115,"_29907":130116,"_3297":130117},[],"/docs/pr-preview/pr-58/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3844":78468,"_33198":78464,"_22654":130119,"_5":15607,"_29907":78464,"_3297":130120},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3844":78469,"_33198":78464,"_22654":130122,"_5":15607,"_29907":130112,"_3297":130123},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3844":78470,"_33198":78464,"_22654":130125,"_5":15607,"_29907":130112,"_3297":130126},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3844":78471,"_33198":78464,"_22654":130128,"_5":15607,"_29907":130112,"_3297":130129},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3844":78472,"_33198":78464,"_22654":130131,"_5":15607,"_29907":130112,"_3297":130132},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3844":78473,"_33198":78464,"_22654":130134,"_5":15607,"_29907":130112,"_3297":130135},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3844":78474,"_33198":78464,"_22654":130137,"_5":15607,"_29907":130116,"_3297":130138},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3844":78475,"_33198":78464,"_22654":130140,"_5":15607,"_29907":130116,"_3297":130141},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3844":78476,"_33198":78464,"_22654":130143,"_5":15607,"_29907":130116,"_3297":130144},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3844":78477,"_33198":78464,"_22654":130146,"_5":15607,"_29907":130116,"_3297":130147},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3844":78478,"_33198":78464,"_22654":130149,"_5":15607,"_29907":130116,"_3297":130150},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3844":78479,"_33198":78464,"_22654":130152,"_5":15607,"_29907":130116,"_3297":130153},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3844":78480,"_33198":78464,"_22654":130155,"_5":15607,"_29907":130116,"_3297":130156},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3844":78481,"_33198":78481,"_5":16006,"_3297":130158,"_33604":130159,"_22654":130160,"_29907":78481},"Dispositivos e identidades",[54402,129149,56881,130158],[],{"_3844":78482,"_33198":78481,"_22654":130162,"_5":15607,"_29907":78481,"_3297":130163},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3844":78483,"_33198":78481,"_5":33601,"_22654":130165,"_29907":130166,"_3297":130167},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3844":78484,"_33198":78481,"_5":33601,"_22654":130169,"_29907":130170,"_3297":130171},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3844":78485,"_33198":78481,"_5":33601,"_22654":130173,"_29907":130174,"_3297":130175},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3844":78486,"_33198":78481,"_5":33601,"_22654":130177,"_29907":130178,"_3297":130179},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3844":78487,"_33198":78481,"_5":33601,"_22654":130181,"_29907":130182,"_3297":130183},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3844":78488,"_33198":78481,"_5":33601,"_22654":130185,"_29907":130186,"_3297":130187},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3844":78489,"_33198":78481,"_5":33601,"_22654":130189,"_29907":130190,"_3297":130191},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3844":78490,"_33198":78481,"_5":33601,"_22654":130193,"_29907":130194,"_3297":130195},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3844":78491,"_33198":78481,"_5":33601,"_22654":130197,"_29907":130198,"_3297":130199},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3844":78492,"_33198":78481,"_5":33601,"_22654":130201,"_29907":130202,"_3297":130203},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3844":78493,"_33198":78481,"_5":33601,"_22654":130205,"_29907":130206,"_3297":130207},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3844":78494,"_33198":78481,"_22654":130209,"_5":15607,"_29907":78481,"_3297":130210},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3844":78495,"_33198":78481,"_22654":130212,"_5":15607,"_29907":78481,"_3297":130213},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3844":78496,"_33198":78481,"_22654":130215,"_5":15607,"_29907":130166,"_3297":130216},[],"Vista operativa",{"_3844":78497,"_33198":78481,"_22654":130218,"_5":15607,"_29907":130166,"_3297":130219},[],"Interpretación",{"_3844":78498,"_33198":78481,"_22654":130221,"_5":15607,"_29907":130166,"_3297":56944},[],{"_3844":78499,"_33198":78481,"_22654":130223,"_5":15607,"_29907":130166,"_3297":130224},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3844":78500,"_33198":78481,"_22654":130226,"_5":15607,"_29907":130166,"_3297":56950},[],{"_3844":78501,"_33198":78481,"_22654":130228,"_5":15607,"_29907":130166,"_3297":130229},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3844":78502,"_33198":78481,"_22654":130231,"_5":15607,"_29907":130166,"_3297":56956},[],{"_3844":78503,"_33198":78481,"_22654":130233,"_5":15607,"_29907":130166,"_3297":130234},[],"La identidad está en la ventana operativa de renovación.",{"_3844":78504,"_33198":78481,"_22654":130236,"_5":15607,"_29907":130166,"_3297":56962},[],{"_3844":78505,"_33198":78481,"_22654":130238,"_5":15607,"_29907":130166,"_3297":130239},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3844":78506,"_33198":78481,"_22654":130241,"_5":15607,"_29907":130166,"_3297":56968},[],{"_3844":78507,"_33198":78481,"_22654":130243,"_5":15607,"_29907":130166,"_3297":130244},[],"La identidad ha vencido.",{"_3844":78508,"_33198":78481,"_22654":130246,"_5":15607,"_29907":130166,"_3297":56974},[],{"_3844":78509,"_33198":78481,"_22654":130248,"_5":15607,"_29907":130166,"_3297":130249},[],"La identidad está marcada como revocada.",{"_3844":78510,"_33198":78481,"_22654":130251,"_5":15607,"_29907":130166,"_3297":56980},[],{"_3844":78511,"_33198":78481,"_22654":130253,"_5":15607,"_29907":130166,"_3297":130254},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3844":78512,"_33198":78481,"_22654":130256,"_5":15607,"_29907":130166,"_3297":130257},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3844":78513,"_33198":78481,"_22654":130259,"_5":15607,"_29907":130170,"_3297":130260},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3844":78514,"_33198":78481,"_22654":130262,"_5":15607,"_29907":130170,"_3297":130263},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3844":78515,"_33198":78481,"_22654":130265,"_5":15607,"_29907":130170,"_3297":130266},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3844":78516,"_33198":78481,"_22654":130268,"_5":15607,"_29907":130170,"_3297":130269},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3844":78517,"_33198":78481,"_22654":130271,"_5":15607,"_29907":130174,"_3297":130272},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3844":78518,"_33198":78481,"_22654":130274,"_5":15607,"_29907":130178,"_3297":130275},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3844":78519,"_33198":78481,"_22654":130277,"_5":15607,"_29907":130182,"_3297":130278},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3844":78520,"_33198":78481,"_22654":130280,"_5":15607,"_29907":130186,"_3297":130281},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3844":78521,"_33198":78481,"_22654":130283,"_5":15607,"_29907":130190,"_3297":130284},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3844":78522,"_33198":78481,"_22654":130286,"_5":15607,"_29907":130190,"_3297":130287},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3844":78523,"_33198":78481,"_22654":130289,"_5":15607,"_29907":130194,"_3297":130290},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3844":78524,"_33198":78481,"_22654":130292,"_5":15607,"_29907":130194,"_3297":130293},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3844":78525,"_33198":78481,"_22654":130295,"_5":15607,"_29907":130194,"_3297":130296},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3844":78526,"_33198":78481,"_22654":130298,"_5":15607,"_29907":130194,"_3297":130299},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3844":78527,"_33198":78481,"_22654":130301,"_5":15607,"_29907":130194,"_3297":130302},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3844":78528,"_33198":78481,"_22654":130304,"_5":15607,"_29907":130194,"_3297":130305},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3844":78529,"_33198":78481,"_22654":130307,"_5":15607,"_29907":130198,"_3297":130308},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3844":78530,"_33198":78481,"_22654":130310,"_5":15607,"_29907":130198,"_3297":130311},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3844":78531,"_33198":78481,"_22654":130313,"_5":15607,"_29907":130202,"_3297":130314},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3844":78532,"_33198":78481,"_22654":130316,"_5":15607,"_29907":130202,"_3297":130317},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3844":78533,"_33198":78481,"_22654":130319,"_5":15607,"_29907":130202,"_3297":130320},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3844":78534,"_33198":78481,"_22654":130322,"_5":15607,"_29907":130202,"_3297":130323},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3844":78535,"_33198":78481,"_22654":130325,"_5":15607,"_29907":130206,"_3297":130326},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3844":78536,"_33198":78481,"_22654":130328,"_5":15607,"_29907":130206,"_3297":130329},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3844":78537,"_33198":78537,"_5":16006,"_3297":130331,"_33604":130332,"_22654":130334,"_29907":78537},"Identidad inicial y autenticación",[54402,129149,56881,130158,130333],"Enrolamiento con PKI",[],{"_3844":78538,"_33198":78537,"_22654":130336,"_5":15607,"_29907":78537,"_3297":130337},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3844":78539,"_33198":78537,"_5":33601,"_22654":130339,"_29907":130340,"_3297":130341},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3844":78540,"_33198":78537,"_5":33601,"_22654":130343,"_29907":130344,"_3297":130345},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3844":78541,"_33198":78537,"_5":33601,"_22654":130347,"_29907":130348,"_3297":130349},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3844":78542,"_33198":78537,"_5":33601,"_22654":130351,"_29907":130352,"_3297":130353},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3844":78543,"_33198":78537,"_5":33601,"_22654":130355,"_29907":130356,"_3297":130357},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3844":78544,"_33198":78537,"_22654":130359,"_5":15607,"_29907":78537,"_3297":130360},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3844":78545,"_33198":78537,"_22654":130362,"_5":15607,"_29907":130340,"_3297":130363},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3844":78546,"_33198":78537,"_22654":130365,"_5":15607,"_29907":130340,"_3297":130366},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3844":78547,"_33198":78537,"_22654":130368,"_5":15607,"_29907":130344,"_3297":130369},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3844":78548,"_33198":78537,"_22654":130371,"_5":15607,"_29907":130344,"_3297":130372},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3844":78549,"_33198":78537,"_22654":130374,"_5":15607,"_29907":130344,"_3297":130375},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3844":78550,"_33198":78537,"_22654":130377,"_5":15607,"_29907":130348,"_3297":130378},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3844":78551,"_33198":78537,"_22654":130380,"_5":15607,"_29907":130348,"_3297":130381},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3844":78552,"_33198":78537,"_22654":130383,"_5":15607,"_29907":130352,"_3297":130384},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3844":78553,"_33198":78537,"_22654":130386,"_5":15607,"_29907":130352,"_3297":130387},[],"Ejemplo de cuerpo:",{"_3844":78554,"_33198":78537,"_22654":130389,"_5":15607,"_29907":130352,"_3297":130390},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3844":78555,"_33198":78537,"_22654":130392,"_5":15607,"_29907":130352,"_3297":130393},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3844":78556,"_33198":78537,"_22654":130395,"_5":15607,"_29907":130352,"_3297":130396},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3844":78557,"_33198":78537,"_22654":130398,"_5":15607,"_29907":130352,"_3297":130399},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3844":78558,"_33198":78537,"_22654":130401,"_5":15607,"_29907":130356,"_3297":130402},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3844":78559,"_33198":78537,"_22654":130404,"_5":15607,"_29907":130356,"_3297":130405},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3844":78560,"_33198":78560,"_5":16006,"_3297":130407,"_33604":130408,"_22654":130409,"_29907":78560},"Configura y opera el DMS",[54402,129149,56881,130158,130333],[],{"_3844":78561,"_33198":78560,"_22654":130411,"_5":15607,"_29907":78560,"_3297":130412},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3844":78562,"_33198":78560,"_5":33601,"_22654":130414,"_29907":130415,"_3297":127727},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3844":78563,"_33198":78560,"_5":33601,"_22654":130417,"_29907":130418,"_3297":130419},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3844":78564,"_33198":78560,"_5":33601,"_22654":130421,"_29907":130422,"_3297":130423},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3844":78565,"_33198":78560,"_5":33601,"_22654":130425,"_29907":130426,"_3297":130427},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3844":78566,"_33198":78560,"_5":33601,"_22654":130429,"_29907":130430,"_3297":130431},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3844":78567,"_33198":78560,"_5":33601,"_22654":130433,"_29907":130434,"_3297":130435},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3844":78568,"_33198":78560,"_5":33601,"_22654":130437,"_29907":130438,"_3297":130439},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3844":78569,"_33198":78560,"_5":33601,"_22654":130441,"_29907":130442,"_3297":130443},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3844":78570,"_33198":78560,"_5":33601,"_22654":130445,"_29907":130446,"_3297":57176},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3844":78571,"_33198":78560,"_5":33601,"_22654":130448,"_29907":130449,"_3297":57180},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3844":78572,"_33198":78560,"_5":33601,"_22654":130451,"_29907":130452,"_3297":130453},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3844":78573,"_33198":78560,"_5":33601,"_22654":130455,"_29907":130456,"_3297":130457},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3844":78574,"_33198":78560,"_5":33601,"_22654":130459,"_29907":130460,"_3297":130461},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3844":78575,"_33198":78560,"_5":33601,"_22654":130463,"_29907":130464,"_3297":130465},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3844":78576,"_33198":78560,"_5":33601,"_22654":130467,"_29907":130468,"_3297":57200},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3844":78577,"_33198":78560,"_5":33601,"_22654":130470,"_29907":130471,"_3297":130472},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3844":78578,"_33198":78560,"_5":33601,"_22654":130474,"_29907":130475,"_3297":130476},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3844":78579,"_33198":78560,"_5":33601,"_22654":130478,"_29907":130479,"_3297":130480},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3844":78580,"_33198":78560,"_22654":130482,"_5":15607,"_29907":78560,"_3297":130483},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3844":78581,"_33198":78560,"_22654":130485,"_5":15607,"_29907":130415,"_3297":130486},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3844":78582,"_33198":78560,"_22654":130488,"_5":15607,"_29907":130415,"_3297":130489},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3844":78583,"_33198":78560,"_22654":130491,"_5":15607,"_29907":130422,"_3297":130492},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3844":78584,"_33198":78560,"_22654":130494,"_5":15607,"_29907":130426,"_3297":130495},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3844":78585,"_33198":78560,"_22654":130497,"_5":15607,"_29907":130430,"_3297":130498},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3844":78586,"_33198":78560,"_22654":130500,"_5":15607,"_29907":130434,"_3297":130501},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3844":78587,"_33198":78560,"_22654":130503,"_5":15607,"_29907":130438,"_3297":130504},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3844":78588,"_33198":78560,"_22654":130506,"_5":15607,"_29907":130446,"_3297":130507},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3844":78589,"_33198":78560,"_22654":130509,"_5":15607,"_29907":130446,"_3297":130510},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3844":78590,"_33198":78560,"_22654":130512,"_5":15607,"_29907":130449,"_3297":130513},[],"Campo de `settings.enrollment_settings`",{"_3844":78591,"_33198":78560,"_22654":130515,"_5":15607,"_29907":130449,"_3297":130516},[],"Decisión",{"_3844":78592,"_33198":78560,"_22654":130518,"_5":15607,"_29907":130449,"_3297":57251},[],{"_3844":78593,"_33198":78560,"_22654":130520,"_5":15607,"_29907":130449,"_3297":130521},[],"`EST_RFC7030` para estas operaciones.",{"_3844":78594,"_33198":78560,"_22654":130523,"_5":15607,"_29907":130449,"_3297":57257},[],{"_3844":78595,"_33198":78560,"_22654":130525,"_5":15607,"_29907":130449,"_3297":130526},[],"ID de la CA que firmará.",{"_3844":78596,"_33198":78560,"_22654":130528,"_5":15607,"_29907":130449,"_3297":57263},[],{"_3844":78597,"_33198":78560,"_22654":130530,"_5":15607,"_29907":130449,"_3297":130531},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3844":78598,"_33198":78560,"_22654":130533,"_5":15607,"_29907":130449,"_3297":57269},[],{"_3844":78599,"_33198":78560,"_22654":130535,"_5":15607,"_29907":130449,"_3297":130536},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3844":78600,"_33198":78560,"_22654":130538,"_5":15607,"_29907":130449,"_3297":57275},[],{"_3844":78601,"_33198":78560,"_22654":130540,"_5":15607,"_29907":130449,"_3297":130541},[],"Uno de los cuatro modos de autenticación.",{"_3844":78602,"_33198":78560,"_22654":130543,"_5":15607,"_29907":130449,"_3297":130544},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3844":78603,"_33198":78560,"_22654":130546,"_5":15607,"_29907":130452,"_3297":130547},[],"Los bloques son independientes:",{"_3844":78604,"_33198":78560,"_22654":130549,"_5":15607,"_29907":130452,"_3297":130550},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3844":78605,"_33198":78560,"_22654":130552,"_5":15607,"_29907":130452,"_3297":130553},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3844":78606,"_33198":78560,"_22654":130555,"_5":15607,"_29907":130452,"_3297":57293},[],{"_3844":78607,"_33198":78560,"_22654":130557,"_5":15607,"_29907":130452,"_3297":130558},[],"Control aplicado en la operación configurada",{"_3844":78608,"_33198":78560,"_22654":130560,"_5":15607,"_29907":130452,"_3297":57299},[],{"_3844":78609,"_33198":78560,"_22654":130562,"_5":15607,"_29907":130452,"_3297":130563},[],"Validación del certificado presentado.",{"_3844":78610,"_33198":78560,"_22654":130565,"_5":15607,"_29907":130452,"_3297":57305},[],{"_3844":78611,"_33198":78560,"_22654":130567,"_5":15607,"_29907":130452,"_3297":130568},[],"Autorización del webhook configurado.",{"_3844":78612,"_33198":78560,"_22654":130570,"_5":15607,"_29907":130452,"_3297":57311},[],{"_3844":78613,"_33198":78560,"_22654":130572,"_5":15607,"_29907":130452,"_3297":130573},[],"Validación del certificado y, después, aprobación del webhook.",{"_3844":78614,"_33198":78560,"_22654":130575,"_5":15607,"_29907":130452,"_3297":57317},[],{"_3844":78615,"_33198":78560,"_22654":130577,"_5":15607,"_29907":130452,"_3297":130578},[],"Sin autenticación del solicitante por el DMS.",{"_3844":78616,"_33198":78560,"_22654":130580,"_5":15607,"_29907":130452,"_3297":130581},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3844":78617,"_33198":78560,"_22654":130583,"_5":15607,"_29907":130452,"_3297":130584},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3844":78618,"_33198":78560,"_22654":130586,"_5":15607,"_29907":130452,"_3297":130587},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3844":78619,"_33198":78560,"_22654":130589,"_5":15607,"_29907":130452,"_3297":130590},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3844":78620,"_33198":78560,"_22654":130592,"_5":15607,"_29907":130456,"_3297":130593},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3844":78621,"_33198":78560,"_22654":130595,"_5":15607,"_29907":130456,"_3297":130596},[],"Campo de `external_webhook_settings`",{"_3844":78622,"_33198":78560,"_22654":130598,"_5":15607,"_29907":130456,"_3297":130516},[],{"_3844":78623,"_33198":78560,"_22654":130600,"_5":15607,"_29907":130456,"_3297":57343},[],{"_3844":78624,"_33198":78560,"_22654":130602,"_5":15607,"_29907":130456,"_3297":130603},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3844":78625,"_33198":78560,"_22654":130605,"_5":15607,"_29907":130456,"_3297":57349},[],{"_3844":78626,"_33198":78560,"_22654":130607,"_5":15607,"_29907":130456,"_3297":130608},[],"`POST` o `PUT`; `POST` por defecto.",{"_3844":78627,"_33198":78560,"_22654":130610,"_5":15607,"_29907":130456,"_3297":57355},[],{"_3844":78628,"_33198":78560,"_22654":130612,"_5":15607,"_29907":130456,"_3297":130613},[],"Etiqueta usada en los logs del servicio.",{"_3844":78629,"_33198":78560,"_22654":130615,"_5":15607,"_29907":130456,"_3297":57361},[],{"_3844":78630,"_33198":78560,"_22654":130617,"_5":15607,"_29907":130456,"_3297":130618},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3844":78631,"_33198":78560,"_22654":130620,"_5":15607,"_29907":130456,"_3297":57367},[],{"_3844":78632,"_33198":78560,"_22654":130622,"_5":15607,"_29907":130456,"_3297":130623},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3844":78633,"_33198":78560,"_22654":130625,"_5":15607,"_29907":130456,"_3297":57373},[],{"_3844":78634,"_33198":78560,"_22654":130627,"_5":15607,"_29907":130456,"_3297":130628},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3844":78635,"_33198":78560,"_22654":130630,"_5":15607,"_29907":130456,"_3297":57379},[],{"_3844":78636,"_33198":78560,"_22654":130632,"_5":15607,"_29907":130456,"_3297":130633},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3844":78637,"_33198":78560,"_22654":130635,"_5":15607,"_29907":130456,"_3297":57385},[],{"_3844":78638,"_33198":78560,"_22654":130637,"_5":15607,"_29907":130456,"_3297":130638},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3844":78639,"_33198":78560,"_22654":130640,"_5":15607,"_29907":130456,"_3297":57391},[],{"_3844":78640,"_33198":78560,"_22654":130642,"_5":15607,"_29907":130456,"_3297":130643},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3844":78641,"_33198":78560,"_22654":130645,"_5":15607,"_29907":130456,"_3297":57397},[],{"_3844":78642,"_33198":78560,"_22654":130647,"_5":15607,"_29907":130456,"_3297":130648},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3844":78643,"_33198":78560,"_22654":130650,"_5":15607,"_29907":130456,"_3297":130651},[],"Reglas de esa configuración:",{"_3844":78644,"_33198":78560,"_22654":130653,"_5":15607,"_29907":130456,"_3297":130654},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3844":78645,"_33198":78560,"_22654":130656,"_5":15607,"_29907":130456,"_3297":130657},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3844":78646,"_33198":78560,"_22654":130659,"_5":15607,"_29907":130456,"_3297":130660},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3844":78647,"_33198":78560,"_22654":130662,"_5":15607,"_29907":130456,"_3297":130663},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3844":78648,"_33198":78560,"_22654":130665,"_5":15607,"_29907":130456,"_3297":130666},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3844":78649,"_33198":78560,"_22654":130668,"_5":15607,"_29907":130456,"_3297":130669},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3844":78650,"_33198":78560,"_22654":130671,"_5":15607,"_29907":130456,"_3297":130672},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3844":78651,"_33198":78560,"_22654":130674,"_5":15607,"_29907":130456,"_3297":130675},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3844":78652,"_33198":78560,"_22654":130677,"_5":15607,"_29907":130456,"_3297":130678},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3844":78653,"_33198":78560,"_22654":130680,"_5":15607,"_29907":130460,"_3297":130681},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3844":78654,"_33198":78560,"_22654":130683,"_5":15607,"_29907":130464,"_3297":130684},[],"Campo de `settings.reenrollment_settings`",{"_3844":78655,"_33198":78560,"_22654":130686,"_5":15607,"_29907":130464,"_3297":130687},[],"Función",{"_3844":78656,"_33198":78560,"_22654":130689,"_5":15607,"_29907":130464,"_3297":57441},[],{"_3844":78657,"_33198":78560,"_22654":130691,"_5":15607,"_29907":130464,"_3297":130692},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3844":78658,"_33198":78560,"_22654":130694,"_5":15607,"_29907":130464,"_3297":57447},[],{"_3844":78659,"_33198":78560,"_22654":130696,"_5":15607,"_29907":130464,"_3297":130697},[],"Umbral operativo preventivo de monitorización.",{"_3844":78660,"_33198":78560,"_22654":130699,"_5":15607,"_29907":130464,"_3297":57453},[],{"_3844":78661,"_33198":78560,"_22654":130701,"_5":15607,"_29907":130464,"_3297":130702},[],"Umbral operativo crítico de monitorización.",{"_3844":78662,"_33198":78560,"_22654":130704,"_5":15607,"_29907":130464,"_3297":57459},[],{"_3844":78663,"_33198":78560,"_22654":130706,"_5":15607,"_29907":130464,"_3297":130707},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3844":78664,"_33198":78560,"_22654":130709,"_5":15607,"_29907":130464,"_3297":57465},[],{"_3844":78665,"_33198":78560,"_22654":130711,"_5":15607,"_29907":130464,"_3297":130712},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3844":78666,"_33198":78560,"_22654":130714,"_5":15607,"_29907":130464,"_3297":57471},[],{"_3844":78667,"_33198":78560,"_22654":130716,"_5":15607,"_29907":130464,"_3297":130717},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3844":78668,"_33198":78560,"_22654":130719,"_5":15607,"_29907":130464,"_3297":130720},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3844":78669,"_33198":78560,"_22654":130722,"_5":15607,"_29907":130468,"_3297":130723},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3844":78670,"_33198":78560,"_22654":130725,"_5":15607,"_29907":130471,"_3297":128091},[],{"_3844":78671,"_33198":78560,"_22654":130727,"_5":15607,"_29907":130471,"_3297":130728},[],"Qué publica",{"_3844":78672,"_33198":78560,"_22654":130730,"_5":15607,"_29907":130471,"_3297":57488},[],{"_3844":78673,"_33198":78560,"_22654":130732,"_5":15607,"_29907":130471,"_3297":130733},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3844":78674,"_33198":78560,"_22654":130735,"_5":15607,"_29907":130471,"_3297":57494},[],{"_3844":78675,"_33198":78560,"_22654":130737,"_5":15607,"_29907":130471,"_3297":130738},[],"Certificado de la CA emisora seleccionada.",{"_3844":78676,"_33198":78560,"_22654":130740,"_5":15607,"_29907":130471,"_3297":57500},[],{"_3844":78677,"_33198":78560,"_22654":130742,"_5":15607,"_29907":130471,"_3297":130743},[],"Certificados de las CAs elegidas explícitamente.",{"_3844":78678,"_33198":78560,"_22654":130745,"_5":15607,"_29907":130471,"_3297":130746},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3844":78679,"_33198":78560,"_22654":130748,"_5":15607,"_29907":130475,"_3297":130749},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3844":78680,"_33198":78560,"_22654":130751,"_5":15607,"_29907":130475,"_3297":130752},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3844":78681,"_33198":78560,"_22654":130754,"_5":15607,"_29907":130475,"_3297":130755},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3844":78682,"_33198":78560,"_22654":130757,"_5":15607,"_29907":130479,"_3297":130758},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3844":78683,"_33198":78683,"_5":16006,"_3297":130760,"_33604":130761,"_22654":130762,"_29907":78683},"Integra el cliente EST",[54402,129149,56881,130158,130333],[],{"_3844":78684,"_33198":78683,"_22654":130764,"_5":15607,"_29907":78683,"_3297":130765},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3844":78685,"_33198":78683,"_5":33601,"_22654":130767,"_29907":130768,"_3297":127727},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3844":78686,"_33198":78683,"_5":33601,"_22654":130770,"_29907":130771,"_3297":130772},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3844":78687,"_33198":78683,"_5":33601,"_22654":130774,"_29907":130775,"_3297":130776},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3844":78688,"_33198":78683,"_5":33601,"_22654":130778,"_29907":130779,"_3297":130780},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3844":78689,"_33198":78683,"_5":33601,"_22654":130782,"_29907":130783,"_3297":130784},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3844":78690,"_33198":78683,"_5":33601,"_22654":130786,"_29907":130787,"_3297":130788},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3844":78691,"_33198":78683,"_22654":130790,"_5":15607,"_29907":78683,"_3297":130791},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3844":78692,"_33198":78683,"_22654":130793,"_5":15607,"_29907":130768,"_3297":130794},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3844":78693,"_33198":78683,"_22654":130796,"_5":15607,"_29907":130768,"_3297":130797},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3844":78694,"_33198":78683,"_22654":130799,"_5":15607,"_29907":130768,"_3297":130800},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3844":78695,"_33198":78683,"_22654":130802,"_5":15607,"_29907":130771,"_3297":130803},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3844":78696,"_33198":78683,"_22654":130805,"_5":15607,"_29907":130771,"_3297":130806},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3844":78697,"_33198":78683,"_22654":130808,"_5":15607,"_29907":130775,"_3297":130809},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3844":78698,"_33198":78683,"_22654":130811,"_5":15607,"_29907":130775,"_3297":130812},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3844":78699,"_33198":78683,"_22654":130814,"_5":15607,"_29907":130779,"_3297":130815},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3844":78700,"_33198":78683,"_22654":130817,"_5":15607,"_29907":130779,"_3297":130818},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3844":78701,"_33198":78683,"_22654":130820,"_5":15607,"_29907":130783,"_3297":130821},[],"Para el caso de una raíz que emite directamente:",{"_3844":78702,"_33198":78683,"_22654":130823,"_5":15607,"_29907":130783,"_3297":130824},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3844":78703,"_33198":78683,"_22654":130826,"_5":15607,"_29907":130783,"_3297":130827},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3844":78704,"_33198":78683,"_22654":130829,"_5":15607,"_29907":130787,"_3297":130830},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3844":78705,"_33198":78705,"_5":16006,"_3297":130832,"_33604":130833,"_22654":130834,"_29907":78705},"Referencia EST",[54402,129149,56881,130158,130333],[],{"_3844":78706,"_33198":78705,"_22654":130836,"_5":15607,"_29907":78705,"_3297":130837},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3844":78707,"_33198":78705,"_5":33601,"_22654":130839,"_29907":130840,"_3297":130841},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3844":78708,"_33198":78705,"_5":33601,"_22654":130843,"_29907":130844,"_3297":24625},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3844":78709,"_33198":78705,"_5":33601,"_22654":130846,"_29907":130847,"_3297":28278},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3844":78710,"_33198":78705,"_5":33601,"_22654":130849,"_29907":130850,"_3297":28285},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3844":78711,"_33198":78705,"_5":33601,"_22654":130852,"_29907":130853,"_3297":27519},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3844":78712,"_33198":78705,"_5":33601,"_22654":130855,"_29907":130856,"_3297":130857},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3844":78713,"_33198":78705,"_5":33601,"_22654":130859,"_29907":130860,"_3297":130861},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3844":78714,"_33198":78705,"_5":33601,"_22654":130863,"_29907":130864,"_3297":130865},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3844":78715,"_33198":78705,"_22654":130867,"_5":15607,"_29907":78705,"_3297":130868},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3844":78716,"_33198":78705,"_22654":130870,"_5":15607,"_29907":130840,"_3297":130871},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3844":78717,"_33198":78705,"_22654":130873,"_5":15607,"_29907":130840,"_3297":128909},[],{"_3844":78718,"_33198":78705,"_22654":130875,"_5":15607,"_29907":130840,"_3297":130876},[],"Método",{"_3844":78719,"_33198":78705,"_22654":130878,"_5":15607,"_29907":130840,"_3297":130879},[],"Autenticación y condición",{"_3844":78720,"_33198":78705,"_22654":130881,"_5":15607,"_29907":130840,"_3297":57643},[],{"_3844":78721,"_33198":78705,"_22654":130883,"_5":15607,"_29907":130840,"_3297":57646},[],{"_3844":78722,"_33198":78705,"_22654":130885,"_5":15607,"_29907":130840,"_3297":130886},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3844":78723,"_33198":78705,"_22654":130888,"_5":15607,"_29907":130840,"_3297":57652},[],{"_3844":78724,"_33198":78705,"_22654":130890,"_5":15607,"_29907":130840,"_3297":57655},[],{"_3844":78725,"_33198":78705,"_22654":130892,"_5":15607,"_29907":130840,"_3297":130893},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3844":78726,"_33198":78705,"_22654":130895,"_5":15607,"_29907":130840,"_3297":57661},[],{"_3844":78727,"_33198":78705,"_22654":130897,"_5":15607,"_29907":130840,"_3297":57655},[],{"_3844":78728,"_33198":78705,"_22654":130899,"_5":15607,"_29907":130840,"_3297":130900},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3844":78729,"_33198":78705,"_22654":130902,"_5":15607,"_29907":130840,"_3297":57669},[],{"_3844":78730,"_33198":78705,"_22654":130904,"_5":15607,"_29907":130840,"_3297":57655},[],{"_3844":78731,"_33198":78705,"_22654":130906,"_5":15607,"_29907":130840,"_3297":130907},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3844":78732,"_33198":78705,"_22654":130909,"_5":15607,"_29907":130840,"_3297":130910},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3844":78733,"_33198":78705,"_22654":130912,"_5":15607,"_29907":130844,"_3297":130913},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3844":78734,"_33198":78705,"_22654":130915,"_5":15607,"_29907":130844,"_3297":130916},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3844":78735,"_33198":78705,"_22654":130918,"_5":15607,"_29907":130847,"_3297":130919},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3844":78736,"_33198":78705,"_22654":130921,"_5":15607,"_29907":130847,"_3297":130922},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3844":78737,"_33198":78705,"_22654":130924,"_5":15607,"_29907":130850,"_3297":130925},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3844":78738,"_33198":78705,"_22654":130927,"_5":15607,"_29907":130850,"_3297":130928},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3844":78739,"_33198":78705,"_22654":130930,"_5":15607,"_29907":130853,"_3297":130931},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3844":78740,"_33198":78705,"_22654":130933,"_5":15607,"_29907":130853,"_3297":130934},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3844":78741,"_33198":78705,"_22654":130936,"_5":15607,"_29907":130856,"_3297":130937},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3844":78742,"_33198":78705,"_22654":130939,"_5":15607,"_29907":130856,"_3297":130940},[],"Parte",{"_3844":78743,"_33198":78705,"_22654":130942,"_5":15607,"_29907":130856,"_3297":130943},[],"Contenido tras decodificar su Base64",{"_3844":78744,"_33198":78705,"_22654":130945,"_5":15607,"_29907":130856,"_3297":57713},[],{"_3844":78745,"_33198":78705,"_22654":130947,"_5":15607,"_29907":130856,"_3297":130948},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3844":78746,"_33198":78705,"_22654":130950,"_5":15607,"_29907":130856,"_3297":57719},[],{"_3844":78747,"_33198":78705,"_22654":130952,"_5":15607,"_29907":130856,"_3297":130953},[],"PKCS#7 DER con el certificado emitido.",{"_3844":78748,"_33198":78705,"_22654":130955,"_5":15607,"_29907":130856,"_3297":130956},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3844":78749,"_33198":78705,"_22654":130958,"_5":15607,"_29907":130860,"_3297":130959},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3844":78750,"_33198":78705,"_22654":130961,"_5":15607,"_29907":130860,"_3297":130962},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3844":78751,"_33198":78705,"_22654":130964,"_5":15607,"_29907":130860,"_3297":130965},[],"Convierte y comprueba el resultado:",{"_3844":78752,"_33198":78705,"_22654":130967,"_5":15607,"_29907":130860,"_3297":130968},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3844":78753,"_33198":78705,"_22654":130970,"_5":15607,"_29907":130864,"_3297":130971},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3844":78754,"_33198":78705,"_22654":130973,"_5":15607,"_29907":130864,"_3297":130974},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3844":78755,"_33198":78755,"_5":16006,"_3297":130333,"_33604":130976,"_22654":130977,"_29907":78755},[54402,129149,56881,130158,130333],[],{"_3844":78756,"_33198":78755,"_22654":130979,"_5":15607,"_29907":78755,"_3297":130980},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3844":78757,"_33198":78755,"_5":33601,"_22654":130982,"_29907":130983,"_3297":130984},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3844":78758,"_33198":78755,"_5":33601,"_22654":130986,"_29907":130987,"_3297":130988},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3844":78759,"_33198":78755,"_5":33601,"_22654":130990,"_29907":130991,"_3297":130992},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3844":78760,"_33198":78755,"_5":33601,"_22654":130994,"_29907":130995,"_3297":130996},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3844":78761,"_33198":78755,"_22654":130998,"_5":15607,"_29907":78755,"_3297":130999},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3844":78762,"_33198":78755,"_22654":131001,"_5":15607,"_29907":130983,"_3297":131002},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3844":78763,"_33198":78755,"_22654":131004,"_5":15607,"_29907":130983,"_3297":131005},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3844":78764,"_33198":78755,"_22654":131007,"_5":15607,"_29907":130983,"_3297":131008},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3844":78765,"_33198":78755,"_22654":131010,"_5":15607,"_29907":130983,"_3297":131011},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3844":78766,"_33198":78755,"_22654":131013,"_5":15607,"_29907":130983,"_3297":131014},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3844":78767,"_33198":78755,"_22654":131016,"_5":15607,"_29907":130983,"_3297":131017},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3844":78768,"_33198":78755,"_22654":131019,"_5":15607,"_29907":130987,"_3297":131020},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3844":78769,"_33198":78755,"_22654":131022,"_5":15607,"_29907":130987,"_3297":131023},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3844":78770,"_33198":78755,"_22654":131025,"_5":15607,"_29907":130987,"_3297":131026},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3844":78771,"_33198":78755,"_22654":131028,"_5":15607,"_29907":130987,"_3297":131029},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3844":78772,"_33198":78755,"_22654":131031,"_5":15607,"_29907":130991,"_3297":131032},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3844":78773,"_33198":78755,"_22654":131034,"_5":15607,"_29907":130991,"_3297":131035},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3844":78774,"_33198":78755,"_22654":131037,"_5":15607,"_29907":130991,"_3297":131038},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3844":78775,"_33198":78755,"_22654":131040,"_5":15607,"_29907":130991,"_3297":131041},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3844":78776,"_33198":78755,"_22654":131043,"_5":15607,"_29907":130995,"_3297":131044},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3844":78777,"_33198":78755,"_22654":131046,"_5":15607,"_29907":130995,"_3297":131047},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3844":78778,"_33198":78778,"_5":16006,"_3297":131049,"_33604":131050,"_22654":131051,"_29907":78778},"Estrategias de aprovisionamiento",[54402,129149,56881,130158,130333],[],{"_3844":78779,"_33198":78778,"_22654":131053,"_5":15607,"_29907":78778,"_3297":131054},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3844":78780,"_33198":78778,"_5":33601,"_22654":131056,"_29907":131057,"_3297":131058},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3844":78781,"_33198":78778,"_5":33601,"_22654":131060,"_29907":131061,"_3297":131062},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3844":78782,"_33198":78778,"_5":33601,"_22654":131064,"_29907":131065,"_3297":131066},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3844":78783,"_33198":78778,"_5":33601,"_22654":131068,"_29907":131069,"_3297":131070},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3844":78784,"_33198":78778,"_5":33601,"_22654":131072,"_29907":131073,"_3297":131074},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3844":78785,"_33198":78778,"_22654":131076,"_5":15607,"_29907":78778,"_3297":131077},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3844":78786,"_33198":78778,"_22654":131079,"_5":15607,"_29907":131057,"_3297":131080},[],"Recorrido",{"_3844":78787,"_33198":78778,"_22654":131082,"_5":15607,"_29907":131057,"_3297":131083},[],"Cuándo existe el dispositivo",{"_3844":78788,"_33198":78778,"_22654":131085,"_5":15607,"_29907":131057,"_3297":131086},[],"Qué compruebas",{"_3844":78789,"_33198":78778,"_22654":131088,"_5":15607,"_29907":131057,"_3297":131089},[],"Asignación manual",{"_3844":78790,"_33198":78778,"_22654":131091,"_5":15607,"_29907":131057,"_3297":131092},[],"El operador lo crea antes de asociar un certificado.",{"_3844":78791,"_33198":78778,"_22654":131094,"_5":15607,"_29907":131057,"_3297":131095},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3844":78792,"_33198":78778,"_22654":131097,"_5":15607,"_29907":131057,"_3297":131098},[],"EST con `JITP`",{"_3844":78793,"_33198":78778,"_22654":131100,"_5":15607,"_29907":131057,"_3297":131101},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3844":78794,"_33198":78778,"_22654":131103,"_5":15607,"_29907":131057,"_3297":131104},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3844":78795,"_33198":78778,"_22654":131106,"_5":15607,"_29907":131057,"_3297":131107},[],"EST con `PRE_REGISTRATION`",{"_3844":78796,"_33198":78778,"_22654":131109,"_5":15607,"_29907":131057,"_3297":131110},[],"Debe existir antes de `/simpleenroll`.",{"_3844":78797,"_33198":78778,"_22654":131112,"_5":15607,"_29907":131057,"_3297":131113},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3844":78798,"_33198":78778,"_22654":131115,"_5":15607,"_29907":131057,"_3297":131116},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3844":78799,"_33198":78778,"_22654":131118,"_5":15607,"_29907":131057,"_3297":131119},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3844":78800,"_33198":78778,"_22654":131121,"_5":15607,"_29907":131061,"_3297":131122},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3844":78801,"_33198":78778,"_22654":131124,"_5":15607,"_29907":131061,"_3297":131125},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3844":78802,"_33198":78778,"_22654":131127,"_5":15607,"_29907":131061,"_3297":131128},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3844":78803,"_33198":78778,"_22654":131130,"_5":15607,"_29907":131065,"_3297":131131},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3844":78804,"_33198":78778,"_22654":131133,"_5":15607,"_29907":131065,"_3297":131134},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3844":78805,"_33198":78778,"_22654":131136,"_5":15607,"_29907":131065,"_3297":131137},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3844":78806,"_33198":78778,"_22654":131139,"_5":15607,"_29907":131065,"_3297":131140},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3844":78807,"_33198":78778,"_22654":131142,"_5":15607,"_29907":131065,"_3297":131143},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3844":78808,"_33198":78778,"_22654":131145,"_5":15607,"_29907":131065,"_3297":131146},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3844":78809,"_33198":78778,"_22654":131148,"_5":15607,"_29907":131069,"_3297":128091},[],{"_3844":78810,"_33198":78778,"_22654":131150,"_5":15607,"_29907":131069,"_3297":131151},[],"Material que atraviesa EST",{"_3844":78811,"_33198":78778,"_22654":131153,"_5":15607,"_29907":131069,"_3297":131154},[],"Clave generada por el dispositivo",{"_3844":78812,"_33198":78778,"_22654":131156,"_5":15607,"_29907":131069,"_3297":131157},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3844":78813,"_33198":78778,"_22654":131159,"_5":15607,"_29907":131069,"_3297":131160},[],"Clave ya disponible en el dispositivo",{"_3844":78814,"_33198":78778,"_22654":131162,"_5":15607,"_29907":131069,"_3297":131163},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3844":78815,"_33198":78778,"_22654":131165,"_5":15607,"_29907":131069,"_3297":57200},[],{"_3844":78816,"_33198":78778,"_22654":131167,"_5":15607,"_29907":131069,"_3297":131168},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3844":78817,"_33198":78778,"_22654":131170,"_5":15607,"_29907":131069,"_3297":131171},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3844":78818,"_33198":78778,"_22654":131173,"_5":15607,"_29907":131073,"_3297":131174},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3844":78819,"_33198":78819,"_5":16006,"_3297":131176,"_33604":131177,"_22654":131178,"_29907":78819},"Renovación y recuperación",[54402,129149,56881,130158,130333],[],{"_3844":78820,"_33198":78819,"_22654":131180,"_5":15607,"_29907":78819,"_3297":131181},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3844":78821,"_33198":78819,"_5":33601,"_22654":131183,"_29907":131184,"_3297":131185},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3844":78822,"_33198":78819,"_5":33601,"_22654":131187,"_29907":131188,"_3297":131189},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3844":78823,"_33198":78819,"_5":33601,"_22654":131191,"_29907":131192,"_3297":131193},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3844":78824,"_33198":78819,"_5":33601,"_22654":131195,"_29907":131196,"_3297":131197},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3844":78825,"_33198":78819,"_5":33601,"_22654":131199,"_29907":131200,"_3297":131201},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3844":78826,"_33198":78819,"_22654":131203,"_5":15607,"_29907":78819,"_3297":131204},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3844":78827,"_33198":78819,"_22654":131206,"_5":15607,"_29907":131184,"_3297":131207},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3844":78828,"_33198":78819,"_22654":131209,"_5":15607,"_29907":131184,"_3297":131210},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3844":78829,"_33198":78819,"_22654":131212,"_5":15607,"_29907":131184,"_3297":131213},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3844":78830,"_33198":78819,"_22654":131215,"_5":15607,"_29907":131184,"_3297":131216},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3844":78831,"_33198":78819,"_22654":131218,"_5":15607,"_29907":131188,"_3297":131219},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3844":78832,"_33198":78819,"_22654":131221,"_5":15607,"_29907":131188,"_3297":131222},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3844":78833,"_33198":78819,"_22654":131224,"_5":15607,"_29907":131192,"_3297":131225},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3844":78834,"_33198":78819,"_22654":131227,"_5":15607,"_29907":131192,"_3297":131228},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3844":78835,"_33198":78819,"_22654":131230,"_5":15607,"_29907":131192,"_3297":131231},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3844":78836,"_33198":78819,"_22654":131233,"_5":15607,"_29907":131196,"_3297":131234},[],"Situación",{"_3844":78837,"_33198":78819,"_22654":131236,"_5":15607,"_29907":131196,"_3297":131237},[],"Procedimiento",{"_3844":78838,"_33198":78819,"_22654":131239,"_5":15607,"_29907":131196,"_3297":131240},[],"Certificado vigente, fuera de ventana",{"_3844":78839,"_33198":78819,"_22654":131242,"_5":15607,"_29907":131196,"_3297":131243},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3844":78840,"_33198":78819,"_22654":131245,"_5":15607,"_29907":131196,"_3297":131246},[],"Certificado vencido, clave disponible",{"_3844":78841,"_33198":78819,"_22654":131248,"_5":15607,"_29907":131196,"_3297":131249},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3844":78842,"_33198":78819,"_22654":131251,"_5":15607,"_29907":131196,"_3297":131252},[],"Renovación por webhook o `NO_AUTH`",{"_3844":78843,"_33198":78819,"_22654":131254,"_5":15607,"_29907":131196,"_3297":131255},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3844":78844,"_33198":78819,"_22654":131257,"_5":15607,"_29907":131196,"_3297":131258},[],"Clave perdida o inaccesible",{"_3844":78845,"_33198":78819,"_22654":131260,"_5":15607,"_29907":131196,"_3297":131261},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3844":78846,"_33198":78819,"_22654":131263,"_5":15607,"_29907":131196,"_3297":131264},[],"Identidad actual revocada",{"_3844":78847,"_33198":78819,"_22654":131266,"_5":15607,"_29907":131196,"_3297":131267},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3844":78848,"_33198":78819,"_22654":131269,"_5":15607,"_29907":131196,"_3297":131270},[],"Dispositivo sin identidad",{"_3844":78849,"_33198":78819,"_22654":131272,"_5":15607,"_29907":131196,"_3297":131273},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3844":78850,"_33198":78819,"_22654":131275,"_5":15607,"_29907":131196,"_3297":131276},[],"Dispositivo retirado",{"_3844":78851,"_33198":78819,"_22654":131278,"_5":15607,"_29907":131196,"_3297":131279},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3844":78852,"_33198":78819,"_22654":131281,"_5":15607,"_29907":131196,"_3297":131282},[],"Timeout, HTTP 500 o fallo de instalación",{"_3844":78853,"_33198":78819,"_22654":131284,"_5":15607,"_29907":131196,"_3297":131285},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3844":78854,"_33198":78819,"_22654":131287,"_5":15607,"_29907":131200,"_3297":131288},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3844":78855,"_33198":78819,"_22654":131290,"_5":15607,"_29907":131200,"_3297":131291},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3844":78856,"_33198":78856,"_5":16006,"_3297":131293,"_33604":131294,"_22654":131295,"_29907":78856},"Diagnóstico de enrolamiento",[54402,129149,56881,130158,130333],[],{"_3844":78857,"_33198":78856,"_22654":131297,"_5":15607,"_29907":78856,"_3297":131298},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3844":78858,"_33198":78856,"_5":33601,"_22654":131300,"_29907":131301,"_3297":131302},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3844":78859,"_33198":78856,"_5":33601,"_22654":131304,"_29907":131305,"_3297":131306},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3844":78860,"_33198":78856,"_5":33601,"_22654":131308,"_29907":131309,"_3297":130865},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3844":78861,"_33198":78856,"_5":33601,"_22654":131311,"_29907":131312,"_3297":131313},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3844":78862,"_33198":78856,"_22654":131315,"_5":15607,"_29907":78856,"_3297":131316},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3844":78863,"_33198":78856,"_22654":131318,"_5":15607,"_29907":131305,"_3297":131319},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3844":78864,"_33198":78856,"_22654":131321,"_5":15607,"_29907":131305,"_3297":131322},[],"Síntoma o mensaje",{"_3844":78865,"_33198":78856,"_22654":131324,"_5":15607,"_29907":131305,"_3297":131325},[],"Qué revisar",{"_3844":78866,"_33198":78856,"_22654":131327,"_5":15607,"_29907":131305,"_3297":131328},[],"curl rechaza TLS, nombre o emisor",{"_3844":78867,"_33198":78856,"_22654":131330,"_5":15607,"_29907":131305,"_3297":131331},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3844":78868,"_33198":78856,"_22654":131333,"_5":15607,"_29907":131305,"_3297":131334},[],"404 o APS ausente",{"_3844":78869,"_33198":78856,"_22654":131336,"_5":15607,"_29907":131305,"_3297":131337},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3844":78870,"_33198":78856,"_22654":131339,"_5":15607,"_29907":131305,"_3297":131340},[],"400, error de CSR o formato",{"_3844":78871,"_33198":78856,"_22654":131342,"_5":15607,"_29907":131305,"_3297":131343},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3844":78872,"_33198":78856,"_22654":131345,"_5":15607,"_29907":131305,"_3297":131346},[],"Credencial ausente o certificado no válido",{"_3844":78873,"_33198":78856,"_22654":131348,"_5":15607,"_29907":131305,"_3297":131349},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3844":78874,"_33198":78856,"_22654":131351,"_5":15607,"_29907":131305,"_3297":131352},[],"Webhook deniega, expira o responde sin autorización",{"_3844":78875,"_33198":78856,"_22654":131354,"_5":15607,"_29907":131305,"_3297":131355},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3844":78876,"_33198":78856,"_22654":131357,"_5":15607,"_29907":131305,"_3297":58126},[],{"_3844":78877,"_33198":78856,"_22654":131359,"_5":15607,"_29907":131305,"_3297":131360},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3844":78878,"_33198":78856,"_22654":131362,"_5":15607,"_29907":131305,"_3297":58132},[],{"_3844":78879,"_33198":78856,"_22654":131364,"_5":15607,"_29907":131305,"_3297":131365},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3844":78880,"_33198":78856,"_22654":131367,"_5":15607,"_29907":131305,"_3297":58138},[],{"_3844":78881,"_33198":78856,"_22654":131369,"_5":15607,"_29907":131305,"_3297":131370},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3844":78882,"_33198":78856,"_22654":131372,"_5":15607,"_29907":131305,"_3297":58144},[],{"_3844":78883,"_33198":78856,"_22654":131374,"_5":15607,"_29907":131305,"_3297":131375},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3844":78884,"_33198":78856,"_22654":131377,"_5":15607,"_29907":131305,"_3297":58150},[],{"_3844":78885,"_33198":78856,"_22654":131379,"_5":15607,"_29907":131305,"_3297":131380},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3844":78886,"_33198":78856,"_22654":131382,"_5":15607,"_29907":131305,"_3297":131383},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3844":78887,"_33198":78856,"_22654":131385,"_5":15607,"_29907":131305,"_3297":131386},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3844":78888,"_33198":78856,"_22654":131388,"_5":15607,"_29907":131305,"_3297":131389},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3844":78889,"_33198":78856,"_22654":131391,"_5":15607,"_29907":131305,"_3297":131392},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3844":78890,"_33198":78856,"_22654":131394,"_5":15607,"_29907":131305,"_3297":58168},[],{"_3844":78891,"_33198":78856,"_22654":131396,"_5":15607,"_29907":131305,"_3297":131397},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3844":78892,"_33198":78856,"_22654":131399,"_5":15607,"_29907":131305,"_3297":58174},[],{"_3844":78893,"_33198":78856,"_22654":131401,"_5":15607,"_29907":131305,"_3297":131402},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3844":78894,"_33198":78856,"_22654":131404,"_5":15607,"_29907":131305,"_3297":131405},[],"DMS propietario distinto",{"_3844":78895,"_33198":78856,"_22654":131407,"_5":15607,"_29907":131305,"_3297":131408},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3844":78896,"_33198":78856,"_22654":131410,"_5":15607,"_29907":131305,"_3297":58186},[],{"_3844":78897,"_33198":78856,"_22654":131412,"_5":15607,"_29907":131305,"_3297":131413},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3844":78898,"_33198":78856,"_22654":131415,"_5":15607,"_29907":131305,"_3297":58192},[],{"_3844":78899,"_33198":78856,"_22654":131417,"_5":15607,"_29907":131305,"_3297":131418},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3844":78900,"_33198":78856,"_22654":131420,"_5":15607,"_29907":131305,"_3297":131421},[],"Certificado actual revocado",{"_3844":78901,"_33198":78856,"_22654":131423,"_5":15607,"_29907":131305,"_3297":131424},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3844":78902,"_33198":78856,"_22654":131426,"_5":15607,"_29907":131305,"_3297":131427},[],"Error de CA, perfil o firma",{"_3844":78903,"_33198":78856,"_22654":131429,"_5":15607,"_29907":131305,"_3297":131430},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3844":78904,"_33198":78856,"_22654":131432,"_5":15607,"_29907":131305,"_3297":131433},[],"HTTP 200 sin conexión del dispositivo",{"_3844":78905,"_33198":78856,"_22654":131435,"_5":15607,"_29907":131305,"_3297":131436},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3844":78906,"_33198":78856,"_22654":131438,"_5":15607,"_29907":131305,"_3297":131439},[],"Timeout o error después de emitir",{"_3844":78907,"_33198":78856,"_22654":131441,"_5":15607,"_29907":131305,"_3297":131442},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3844":78908,"_33198":78856,"_22654":131444,"_5":15607,"_29907":131309,"_3297":131445},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3844":78909,"_33198":78856,"_22654":131447,"_5":15607,"_29907":131309,"_3297":131448},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3844":78910,"_33198":78856,"_22654":131450,"_5":15607,"_29907":131312,"_3297":131451},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3844":78911,"_33198":78856,"_22654":131453,"_5":15607,"_29907":131312,"_3297":131454},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3844":78912,"_33198":78856,"_22654":131456,"_5":15607,"_29907":131312,"_3297":131457},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3844":78913,"_33198":78856,"_22654":131459,"_5":15607,"_29907":131312,"_3297":131460},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3844":78914,"_33198":78856,"_22654":131462,"_5":15607,"_29907":131312,"_3297":131463},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3844":78915,"_33198":78856,"_22654":131465,"_5":15607,"_29907":131312,"_3297":131466},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3844":78916,"_33198":78856,"_22654":131468,"_5":15607,"_29907":131312,"_3297":131469},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3844":78917,"_33198":78917,"_5":16006,"_3297":131471,"_33604":131472,"_22654":131473,"_29907":78917},"Distribución y actualización de confianza",[54402,129149,56881,130158,130333],[],{"_3844":78918,"_33198":78917,"_22654":131475,"_5":15607,"_29907":78917,"_3297":131476},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3844":78919,"_33198":78917,"_5":33601,"_22654":131478,"_29907":131479,"_3297":131480},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3844":78920,"_33198":78917,"_5":33601,"_22654":131482,"_29907":131483,"_3297":131484},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3844":78921,"_33198":78917,"_5":33601,"_22654":131486,"_29907":131487,"_3297":131488},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3844":78922,"_33198":78917,"_5":33601,"_22654":131490,"_29907":131491,"_3297":131492},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3844":78923,"_33198":78917,"_5":33601,"_22654":131494,"_29907":131495,"_3297":131496},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3844":78924,"_33198":78917,"_22654":131498,"_5":15607,"_29907":78917,"_3297":131499},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3844":78925,"_33198":78917,"_22654":131501,"_5":15607,"_29907":131479,"_3297":131502},[],"Relación",{"_3844":78926,"_33198":78917,"_22654":131504,"_5":15607,"_29907":131479,"_3297":131505},[],"Material que prepara el responsable",{"_3844":78927,"_33198":78917,"_22654":131507,"_5":15607,"_29907":131479,"_3297":131508},[],"Dispositivo → servidor EST",{"_3844":78928,"_33198":78917,"_22654":131510,"_5":15607,"_29907":131479,"_3297":131511},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3844":78929,"_33198":78917,"_22654":131513,"_5":15607,"_29907":131479,"_3297":131514},[],"DMS → solicitante",{"_3844":78930,"_33198":78917,"_22654":131516,"_5":15607,"_29907":131479,"_3297":131517},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3844":78931,"_33198":78917,"_22654":131519,"_5":15607,"_29907":131479,"_3297":131520},[],"Consumidor → dispositivo",{"_3844":78932,"_33198":78917,"_22654":131522,"_5":15607,"_29907":131479,"_3297":131523},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3844":78933,"_33198":78917,"_22654":131525,"_5":15607,"_29907":131479,"_3297":131526},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3844":78934,"_33198":78917,"_22654":131528,"_5":15607,"_29907":131483,"_3297":131529},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3844":78935,"_33198":78917,"_22654":131531,"_5":15607,"_29907":131483,"_3297":131532},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3844":78936,"_33198":78917,"_22654":131534,"_5":15607,"_29907":131487,"_3297":131535},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3844":78937,"_33198":78917,"_22654":131537,"_5":15607,"_29907":131487,"_3297":131538},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3844":78938,"_33198":78917,"_22654":131540,"_5":15607,"_29907":131487,"_3297":131541},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3844":78939,"_33198":78917,"_22654":131543,"_5":15607,"_29907":131487,"_3297":131544},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3844":78940,"_33198":78917,"_22654":131546,"_5":15607,"_29907":131487,"_3297":131547},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3844":78941,"_33198":78917,"_22654":131549,"_5":15607,"_29907":131487,"_3297":131550},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3844":78942,"_33198":78917,"_22654":131552,"_5":15607,"_29907":131491,"_3297":131553},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3844":78943,"_33198":78917,"_22654":131555,"_5":15607,"_29907":131491,"_3297":131556},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3844":78944,"_33198":78917,"_22654":131558,"_5":15607,"_29907":131491,"_3297":131559},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3844":78945,"_33198":78917,"_22654":131561,"_5":15607,"_29907":131495,"_3297":131562},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3844":78946,"_33198":78946,"_5":16006,"_3297":58341,"_33604":131564,"_22654":131566,"_29907":78946},[54402,129149,56881,130158,131565],"Integraciones",[],{"_3844":78947,"_33198":78946,"_22654":131568,"_5":15607,"_29907":78946,"_3297":131569},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3844":78948,"_33198":78946,"_5":33601,"_22654":131571,"_29907":131572,"_3297":131573},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3844":78949,"_33198":78946,"_5":33601,"_22654":131575,"_29907":131576,"_3297":131577},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3844":78950,"_33198":78946,"_5":33601,"_22654":131579,"_29907":131580,"_3297":131581},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3844":78951,"_33198":78946,"_5":33601,"_22654":131583,"_29907":131584,"_3297":131585},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3844":78952,"_33198":78946,"_5":33601,"_22654":131587,"_29907":131588,"_3297":131589},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3844":78953,"_33198":78946,"_5":33601,"_22654":131591,"_29907":131592,"_3297":131593},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3844":78954,"_33198":78946,"_5":33601,"_22654":131595,"_29907":131596,"_3297":131597},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3844":78955,"_33198":78946,"_5":33601,"_22654":131599,"_29907":131600,"_3297":131601},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3844":78956,"_33198":78946,"_5":33601,"_22654":131603,"_29907":131604,"_3297":58383},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3844":78957,"_33198":78946,"_5":33601,"_22654":131606,"_29907":131607,"_3297":58387},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3844":78958,"_33198":78946,"_5":33601,"_22654":131609,"_29907":131610,"_3297":131611},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3844":78959,"_33198":78946,"_5":33601,"_22654":131613,"_29907":131614,"_3297":131615},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3844":78960,"_33198":78946,"_5":33601,"_22654":131617,"_29907":131618,"_3297":131619},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3844":78961,"_33198":78946,"_5":33601,"_22654":131621,"_29907":131622,"_3297":131623},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3844":78962,"_33198":78946,"_5":33601,"_22654":131625,"_29907":131626,"_3297":131627},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3844":78963,"_33198":78946,"_5":33601,"_22654":131629,"_29907":131630,"_3297":131631},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3844":78964,"_33198":78946,"_5":33601,"_22654":131633,"_29907":131634,"_3297":131635},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3844":78965,"_33198":78946,"_5":33601,"_22654":131637,"_29907":131638,"_3297":131639},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3844":78966,"_33198":78946,"_5":33601,"_22654":131641,"_29907":131642,"_3297":131643},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3844":78967,"_33198":78946,"_5":33601,"_22654":131645,"_29907":131646,"_3297":131647},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3844":78968,"_33198":78946,"_5":33601,"_22654":131649,"_29907":131650,"_3297":131651},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3844":78969,"_33198":78946,"_5":33601,"_22654":131653,"_29907":131654,"_3297":131655},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3844":78970,"_33198":78946,"_5":33601,"_22654":131657,"_29907":131658,"_3297":131659},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3844":78971,"_33198":78946,"_5":33601,"_22654":131661,"_29907":131662,"_3297":131663},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3844":78972,"_33198":78946,"_5":33601,"_22654":131665,"_29907":131666,"_3297":131667},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3844":78973,"_33198":78946,"_22654":131669,"_5":15607,"_29907":78946,"_3297":131670},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3844":78974,"_33198":78946,"_22654":131672,"_5":15607,"_29907":78946,"_3297":131673},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3844":78975,"_33198":78946,"_22654":131675,"_5":15607,"_29907":78946,"_3297":131676},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3844":78976,"_33198":78946,"_22654":131678,"_5":15607,"_29907":131572,"_3297":131679},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3844":78977,"_33198":78946,"_22654":131681,"_5":15607,"_29907":131572,"_3297":131682},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3844":78978,"_33198":78946,"_22654":131684,"_5":15607,"_29907":131572,"_3297":131685},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3844":78979,"_33198":78946,"_22654":131687,"_5":15607,"_29907":131572,"_3297":131688},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3844":78980,"_33198":78946,"_22654":131690,"_5":15607,"_29907":131576,"_3297":131691},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3844":78981,"_33198":78946,"_22654":131693,"_5":15607,"_29907":131580,"_3297":131694},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3844":78982,"_33198":78946,"_22654":131696,"_5":15607,"_29907":131580,"_3297":131697},[],"Acción IAM",{"_3844":78983,"_33198":78946,"_22654":131699,"_5":15607,"_29907":131580,"_3297":128097},[],{"_3844":78984,"_33198":78946,"_22654":131701,"_5":15607,"_29907":131580,"_3297":58482},[],{"_3844":78985,"_33198":78946,"_22654":131703,"_5":15607,"_29907":131580,"_3297":131704},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3844":78986,"_33198":78946,"_22654":131706,"_5":15607,"_29907":131580,"_3297":58488},[],{"_3844":78987,"_33198":78946,"_22654":131708,"_5":15607,"_29907":131580,"_3297":131709},[],"Registrar la CA en AWS IoT",{"_3844":78988,"_33198":78946,"_22654":131711,"_5":15607,"_29907":131580,"_3297":58494},[],{"_3844":78989,"_33198":78946,"_22654":131713,"_5":15607,"_29907":131580,"_3297":131714},[],"Consultar el estado del registro de la CA",{"_3844":78990,"_33198":78946,"_22654":131716,"_5":15607,"_29907":131580,"_3297":58500},[],{"_3844":78991,"_33198":78946,"_22654":131718,"_5":15607,"_29907":131580,"_3297":131719},[],"Crear o actualizar Things en IoT Core",{"_3844":78992,"_33198":78946,"_22654":131721,"_5":15607,"_29907":131580,"_3297":58506},[],{"_3844":78993,"_33198":78946,"_22654":131723,"_5":15607,"_29907":131580,"_3297":131724},[],"Aprovisionar Things mediante plantilla",{"_3844":78994,"_33198":78946,"_22654":131726,"_5":15607,"_29907":131580,"_3297":58512},[],{"_3844":78995,"_33198":78946,"_22654":131728,"_5":15607,"_29907":131580,"_3297":131729},[],"Registrar certificados de dispositivo",{"_3844":78996,"_33198":78946,"_22654":131731,"_5":15607,"_29907":131580,"_3297":58518},[],{"_3844":78997,"_33198":78946,"_22654":131733,"_5":15607,"_29907":131580,"_3297":131734},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3844":78998,"_33198":78946,"_22654":131736,"_5":15607,"_29907":131580,"_3297":58524},[],{"_3844":78999,"_33198":78946,"_22654":131738,"_5":15607,"_29907":131580,"_3297":131739},[],"Crear y adjuntar políticas IoT",{"_3844":79000,"_33198":78946,"_22654":131741,"_5":15607,"_29907":131580,"_3297":58530},[],{"_3844":79001,"_33198":78946,"_22654":131743,"_5":15607,"_29907":131580,"_3297":131744},[],"Gestionar grupos de Things",{"_3844":79002,"_33198":78946,"_22654":131746,"_5":15607,"_29907":131580,"_3297":58536},[],{"_3844":79003,"_33198":78946,"_22654":131748,"_5":15607,"_29907":131580,"_3297":131749},[],"Crear plantillas JITP",{"_3844":79004,"_33198":78946,"_22654":131751,"_5":15607,"_29907":131580,"_3297":58542},[],{"_3844":79005,"_33198":78946,"_22654":131753,"_5":15607,"_29907":131580,"_3297":131754},[],"Leer y escribir el Device Shadow",{"_3844":79006,"_33198":78946,"_22654":131756,"_5":15607,"_29907":131580,"_3297":131757},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3844":79007,"_33198":78946,"_22654":131759,"_5":15607,"_29907":131584,"_3297":131760},[],"Parámetro",{"_3844":79008,"_33198":78946,"_22654":131762,"_5":15607,"_29907":131584,"_3297":131763},[],"Tipo",{"_3844":79009,"_33198":78946,"_22654":131765,"_5":15607,"_29907":131584,"_3297":131766},[],"Requerido",{"_3844":79010,"_33198":78946,"_22654":131768,"_5":15607,"_29907":131584,"_3297":131769},[],"Descripción",{"_3844":79011,"_33198":78946,"_22654":131771,"_5":15607,"_29907":131584,"_3297":58563},[],{"_3844":79012,"_33198":78946,"_22654":131773,"_5":15607,"_29907":131584,"_3297":27123},[],{"_3844":79013,"_33198":78946,"_22654":131775,"_5":15607,"_29907":131584,"_3297":131776},[],"Sí",{"_3844":79014,"_33198":78946,"_22654":131778,"_5":15607,"_29907":131584,"_3297":131779},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3844":79015,"_33198":78946,"_22654":131781,"_5":15607,"_29907":131584,"_3297":58574},[],{"_3844":79016,"_33198":78946,"_22654":131783,"_5":15607,"_29907":131584,"_3297":27123},[],{"_3844":79017,"_33198":78946,"_22654":131785,"_5":15607,"_29907":131584,"_3297":131776},[],{"_3844":79018,"_33198":78946,"_22654":131787,"_5":15607,"_29907":131584,"_3297":131788},[],"Región AWS donde opera el conector.",{"_3844":79019,"_33198":78946,"_22654":131790,"_5":15607,"_29907":131584,"_3297":58584},[],{"_3844":79020,"_33198":78946,"_22654":131792,"_5":15607,"_29907":131584,"_3297":27123},[],{"_3844":79021,"_33198":78946,"_22654":131794,"_5":15607,"_29907":131584,"_3297":131776},[],{"_3844":79022,"_33198":78946,"_22654":131796,"_5":15607,"_29907":131584,"_3297":131797},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3844":79023,"_33198":78946,"_22654":131799,"_5":15607,"_29907":131584,"_3297":58594},[],{"_3844":79024,"_33198":78946,"_22654":131801,"_5":15607,"_29907":131584,"_3297":27123},[],{"_3844":79025,"_33198":78946,"_22654":131803,"_5":15607,"_29907":131584,"_3297":131804},[],"Solo con `auth_method=static`",{"_3844":79026,"_33198":78946,"_22654":131806,"_5":15607,"_29907":131584,"_3297":131807},[],"Clave de acceso AWS.",{"_3844":79027,"_33198":78946,"_22654":131809,"_5":15607,"_29907":131584,"_3297":58605},[],{"_3844":79028,"_33198":78946,"_22654":131811,"_5":15607,"_29907":131584,"_3297":27123},[],{"_3844":79029,"_33198":78946,"_22654":131813,"_5":15607,"_29907":131584,"_3297":131804},[],{"_3844":79030,"_33198":78946,"_22654":131815,"_5":15607,"_29907":131584,"_3297":131816},[],"Clave secreta AWS.",{"_3844":79031,"_33198":78946,"_22654":131818,"_5":15607,"_29907":131584,"_3297":58615},[],{"_3844":79032,"_33198":78946,"_22654":131820,"_5":15607,"_29907":131584,"_3297":27123},[],{"_3844":79033,"_33198":78946,"_22654":131822,"_5":15607,"_29907":131584,"_3297":58620},[],{"_3844":79034,"_33198":78946,"_22654":131824,"_5":15607,"_29907":131584,"_3297":131825},[],"Token de sesión (con `auth_method=static`).",{"_3844":79035,"_33198":78946,"_22654":131827,"_5":15607,"_29907":131584,"_3297":58626},[],{"_3844":79036,"_33198":78946,"_22654":131829,"_5":15607,"_29907":131584,"_3297":27123},[],{"_3844":79037,"_33198":78946,"_22654":131831,"_5":15607,"_29907":131584,"_3297":131832},[],"Solo con `auth_method=role`",{"_3844":79038,"_33198":78946,"_22654":131834,"_5":15607,"_29907":131584,"_3297":131835},[],"ARN del rol a asumir.",{"_3844":79039,"_33198":78946,"_22654":131837,"_5":15607,"_29907":131584,"_3297":58637},[],{"_3844":79040,"_33198":78946,"_22654":131839,"_5":15607,"_29907":131584,"_3297":27123},[],{"_3844":79041,"_33198":78946,"_22654":131841,"_5":15607,"_29907":131584,"_3297":58620},[],{"_3844":79042,"_33198":78946,"_22654":131843,"_5":15607,"_29907":131584,"_3297":131844},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3844":79043,"_33198":78946,"_22654":131846,"_5":15607,"_29907":131584,"_3297":58647},[],{"_3844":79044,"_33198":78946,"_22654":131848,"_5":15607,"_29907":131584,"_3297":98484},[],{"_3844":79045,"_33198":78946,"_22654":131850,"_5":15607,"_29907":131584,"_3297":131776},[],{"_3844":79046,"_33198":78946,"_22654":131852,"_5":15607,"_29907":131584,"_3297":131853},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3844":79047,"_33198":78946,"_22654":131855,"_5":15607,"_29907":131584,"_3297":58657},[],{"_3844":79048,"_33198":78946,"_22654":131857,"_5":15607,"_29907":131584,"_3297":27123},[],{"_3844":79049,"_33198":78946,"_22654":131859,"_5":15607,"_29907":131584,"_3297":131776},[],{"_3844":79050,"_33198":78946,"_22654":131861,"_5":15607,"_29907":131584,"_3297":131862},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3844":79051,"_33198":78946,"_22654":131864,"_5":15607,"_29907":131584,"_3297":58667},[],{"_3844":79052,"_33198":78946,"_22654":131866,"_5":15607,"_29907":131584,"_3297":27123},[],{"_3844":79053,"_33198":78946,"_22654":131868,"_5":15607,"_29907":131584,"_3297":131776},[],{"_3844":79054,"_33198":78946,"_22654":131870,"_5":15607,"_29907":131584,"_3297":131871},[],"URL HTTP del Device Manager de Lamassu.",{"_3844":79055,"_33198":78946,"_22654":131873,"_5":15607,"_29907":131584,"_3297":58677},[],{"_3844":79056,"_33198":78946,"_22654":131875,"_5":15607,"_29907":131584,"_3297":27123},[],{"_3844":79057,"_33198":78946,"_22654":131877,"_5":15607,"_29907":131584,"_3297":131776},[],{"_3844":79058,"_33198":78946,"_22654":131879,"_5":15607,"_29907":131584,"_3297":131880},[],"URL HTTP del servicio de CA de Lamassu.",{"_3844":79059,"_33198":78946,"_22654":131882,"_5":15607,"_29907":131588,"_3297":131883},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3844":79060,"_33198":78946,"_22654":131885,"_5":15607,"_29907":131588,"_3297":131886},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3844":79061,"_33198":78946,"_22654":131888,"_5":15607,"_29907":131588,"_3297":131889},[],"Tipo de CloudEvent",{"_3844":79062,"_33198":78946,"_22654":131891,"_5":15607,"_29907":131588,"_3297":131892},[],"Recurso en Lamassu",{"_3844":79063,"_33198":78946,"_22654":131894,"_5":15607,"_29907":131588,"_3297":131895},[],"Recurso AWS",{"_3844":79064,"_33198":78946,"_22654":131897,"_5":15607,"_29907":131588,"_3297":131898},[],"Acciones IAM",{"_3844":79065,"_33198":78946,"_22654":131900,"_5":15607,"_29907":131588,"_3297":131901},[],"Llamadas AWS y efecto",{"_3844":79066,"_33198":78946,"_22654":131903,"_5":15607,"_29907":131588,"_3297":131904},[],"Dónde en esta página",{"_3844":79067,"_33198":78946,"_22654":131906,"_5":15607,"_29907":131588,"_3297":58711},[],{"_3844":79068,"_33198":78946,"_22654":131908,"_5":15607,"_29907":131588,"_3297":58714},[],{"_3844":79069,"_33198":78946,"_22654":131910,"_5":15607,"_29907":131588,"_3297":58717},[],{"_3844":79070,"_33198":78946,"_22654":131912,"_5":15607,"_29907":131588,"_3297":58720},[],{"_3844":79071,"_33198":78946,"_22654":131914,"_5":15607,"_29907":131588,"_3297":131915},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3844":79072,"_33198":78946,"_22654":131917,"_5":15607,"_29907":131588,"_3297":131601},[],{"_3844":79073,"_33198":78946,"_22654":131919,"_5":15607,"_29907":131588,"_3297":58728},[],{"_3844":79074,"_33198":78946,"_22654":131921,"_5":15607,"_29907":131588,"_3297":58731},[],{"_3844":79075,"_33198":78946,"_22654":131923,"_5":15607,"_29907":131588,"_3297":58734},[],{"_3844":79076,"_33198":78946,"_22654":131925,"_5":15607,"_29907":131588,"_3297":58737},[],{"_3844":79077,"_33198":78946,"_22654":131927,"_5":15607,"_29907":131588,"_3297":131928},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3844":79078,"_33198":78946,"_22654":131930,"_5":15607,"_29907":131588,"_3297":131627},[],{"_3844":79079,"_33198":78946,"_22654":131932,"_5":15607,"_29907":131588,"_3297":58745},[],{"_3844":79080,"_33198":78946,"_22654":131934,"_5":15607,"_29907":131588,"_3297":131935},[],"Dispositivo",{"_3844":79081,"_33198":78946,"_22654":131937,"_5":15607,"_29907":131588,"_3297":58751},[],{"_3844":79082,"_33198":78946,"_22654":131939,"_5":15607,"_29907":131588,"_3297":58754},[],{"_3844":79083,"_33198":78946,"_22654":131941,"_5":15607,"_29907":131588,"_3297":131942},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3844":79084,"_33198":78946,"_22654":131944,"_5":15607,"_29907":131588,"_3297":131635},[],{"_3844":79085,"_33198":78946,"_22654":131946,"_5":15607,"_29907":131588,"_3297":58762},[],{"_3844":79086,"_33198":78946,"_22654":131948,"_5":15607,"_29907":131588,"_3297":131949},[],"Certificado",{"_3844":79087,"_33198":78946,"_22654":131951,"_5":15607,"_29907":131588,"_3297":58768},[],{"_3844":79088,"_33198":78946,"_22654":131953,"_5":15607,"_29907":131588,"_3297":131954},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3844":79089,"_33198":78946,"_22654":131956,"_5":15607,"_29907":131588,"_3297":131957},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3844":79090,"_33198":78946,"_22654":131959,"_5":15607,"_29907":131588,"_3297":131647},[],{"_3844":79091,"_33198":78946,"_22654":131961,"_5":15607,"_29907":131588,"_3297":58779},[],{"_3844":79092,"_33198":78946,"_22654":131963,"_5":15607,"_29907":131588,"_3297":131964},[],"Certificado / Dispositivo",{"_3844":79093,"_33198":78946,"_22654":131966,"_5":15607,"_29907":131588,"_3297":58785},[],{"_3844":79094,"_33198":78946,"_22654":131968,"_5":15607,"_29907":131588,"_3297":54798},[],{"_3844":79095,"_33198":78946,"_22654":131970,"_5":15607,"_29907":131588,"_3297":131971},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3844":79096,"_33198":78946,"_22654":131973,"_5":15607,"_29907":131588,"_3297":131655},[],{"_3844":79097,"_33198":78946,"_22654":131975,"_5":15607,"_29907":131592,"_3297":131976},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3844":79098,"_33198":78946,"_22654":131978,"_5":15607,"_29907":131596,"_3297":131979},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3844":79099,"_33198":78946,"_22654":131981,"_5":15607,"_29907":131596,"_3297":131982},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3844":79100,"_33198":78946,"_22654":131984,"_5":15607,"_29907":131600,"_3297":131985},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3844":79101,"_33198":78946,"_22654":131987,"_5":15607,"_29907":131600,"_3297":131988},[],"Transición",{"_3844":79102,"_33198":78946,"_22654":131990,"_5":15607,"_29907":131600,"_3297":131991},[],"Llamadas AWS",{"_3844":79103,"_33198":78946,"_22654":131993,"_5":15607,"_29907":131600,"_3297":131994},[],"`NoRegistrada` → `Solicitada`",{"_3844":79104,"_33198":78946,"_22654":131996,"_5":15607,"_29907":131600,"_3297":131997},[],"ninguna (solo escritura de metadatos)",{"_3844":79105,"_33198":78946,"_22654":131999,"_5":15607,"_29907":131600,"_3297":132000},[],"`Solicitada` → `Registrando`",{"_3844":79106,"_33198":78946,"_22654":132002,"_5":15607,"_29907":131600,"_3297":132003},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3844":79107,"_33198":78946,"_22654":132005,"_5":15607,"_29907":131600,"_3297":132006},[],"`Registrando` → `Completada`",{"_3844":79108,"_33198":78946,"_22654":132008,"_5":15607,"_29907":131600,"_3297":132009},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3844":79109,"_33198":78946,"_22654":132011,"_5":15607,"_29907":131600,"_3297":132012},[],"`Registrando` → `Fallida`",{"_3844":79110,"_33198":78946,"_22654":132014,"_5":15607,"_29907":131600,"_3297":132015},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3844":79111,"_33198":78946,"_22654":132017,"_5":15607,"_29907":131600,"_3297":132018},[],"`Fallida` / `Completada` → `Solicitada`",{"_3844":79112,"_33198":78946,"_22654":132020,"_5":15607,"_29907":131600,"_3297":132021},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3844":79113,"_33198":78946,"_22654":132023,"_5":15607,"_29907":131604,"_3297":132024},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3844":79114,"_33198":78946,"_22654":132026,"_5":15607,"_29907":131604,"_3297":132027},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3844":79115,"_33198":78946,"_22654":132029,"_5":15607,"_29907":131604,"_3297":132030},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3844":79116,"_33198":78946,"_22654":132032,"_5":15607,"_29907":131604,"_3297":132033},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3844":79117,"_33198":78946,"_22654":132035,"_5":15607,"_29907":131604,"_3297":132036},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3844":79118,"_33198":78946,"_22654":132038,"_5":15607,"_29907":131604,"_3297":132039},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3844":79119,"_33198":78946,"_22654":132041,"_5":15607,"_29907":131607,"_3297":132042},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3844":79120,"_33198":78946,"_22654":132044,"_5":15607,"_29907":131610,"_3297":132045},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3844":79121,"_33198":78946,"_22654":132047,"_5":15607,"_29907":131610,"_3297":132048},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3844":79122,"_33198":78946,"_22654":132050,"_5":15607,"_29907":131614,"_3297":132051},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3844":79123,"_33198":78946,"_22654":132053,"_5":15607,"_29907":131618,"_3297":132054},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3844":79124,"_33198":78946,"_22654":132056,"_5":15607,"_29907":131618,"_3297":132057},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3844":79125,"_33198":78946,"_22654":132059,"_5":15607,"_29907":131618,"_3297":132060},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3844":79126,"_33198":78946,"_22654":132062,"_5":15607,"_29907":131618,"_3297":132063},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3844":79127,"_33198":78946,"_22654":132065,"_5":15607,"_29907":131618,"_3297":132066},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3844":79128,"_33198":78946,"_22654":132068,"_5":15607,"_29907":131618,"_3297":132069},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3844":79129,"_33198":78946,"_22654":132071,"_5":15607,"_29907":131622,"_3297":132072},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3844":79130,"_33198":78946,"_22654":132074,"_5":15607,"_29907":131622,"_3297":132075},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3844":79131,"_33198":78946,"_22654":132077,"_5":15607,"_29907":131622,"_3297":132078},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3844":79132,"_33198":78946,"_22654":132080,"_5":15607,"_29907":131622,"_3297":132081},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3844":79133,"_33198":78946,"_22654":132083,"_5":15607,"_29907":131622,"_3297":132084},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3844":79134,"_33198":78946,"_22654":132086,"_5":15607,"_29907":131626,"_3297":132087},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3844":79135,"_33198":78946,"_22654":132089,"_5":15607,"_29907":131626,"_3297":131988},[],{"_3844":79136,"_33198":78946,"_22654":132091,"_5":15607,"_29907":131626,"_3297":131991},[],{"_3844":79137,"_33198":78946,"_22654":132093,"_5":15607,"_29907":131626,"_3297":132094},[],"`SinConfigurar` → `None` / `Auto`",{"_3844":79138,"_33198":78946,"_22654":132096,"_5":15607,"_29907":131626,"_3297":132097},[],"ninguna (solo configuración)",{"_3844":79139,"_33198":78946,"_22654":132099,"_5":15607,"_29907":131626,"_3297":58922},[],{"_3844":79140,"_33198":78946,"_22654":132101,"_5":15607,"_29907":131626,"_3297":132097},[],{"_3844":79141,"_33198":78946,"_22654":132103,"_5":15607,"_29907":131626,"_3297":132104},[],"Cualquiera → `Jitp`",{"_3844":79142,"_33198":78946,"_22654":132106,"_5":15607,"_29907":131626,"_3297":132107},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3844":79143,"_33198":78946,"_22654":132109,"_5":15607,"_29907":131626,"_3297":58933},[],{"_3844":79144,"_33198":78946,"_22654":132111,"_5":15607,"_29907":131626,"_3297":132112},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3844":79145,"_33198":78946,"_22654":132114,"_5":15607,"_29907":131630,"_3297":132115},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3844":79146,"_33198":78946,"_22654":132117,"_5":15607,"_29907":131630,"_3297":132118},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3844":79147,"_33198":78946,"_22654":132120,"_5":15607,"_29907":131630,"_3297":132121},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3844":79148,"_33198":78946,"_22654":132123,"_5":15607,"_29907":131634,"_3297":132124},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3844":79149,"_33198":78946,"_22654":132126,"_5":15607,"_29907":131634,"_3297":131988},[],{"_3844":79150,"_33198":78946,"_22654":132128,"_5":15607,"_29907":131634,"_3297":131991},[],{"_3844":79151,"_33198":78946,"_22654":132130,"_5":15607,"_29907":131634,"_3297":132131},[],"`Ausente` → `Aprovisionado`",{"_3844":79152,"_33198":78946,"_22654":132133,"_5":15607,"_29907":131634,"_3297":132134},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3844":79153,"_33198":78946,"_22654":132136,"_5":15607,"_29907":131634,"_3297":132137},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3844":79154,"_33198":78946,"_22654":132139,"_5":15607,"_29907":131634,"_3297":132140},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3844":79155,"_33198":78946,"_22654":132142,"_5":15607,"_29907":131634,"_3297":132143},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3844":79156,"_33198":78946,"_22654":132145,"_5":15607,"_29907":131638,"_3297":132146},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3844":79157,"_33198":78946,"_22654":132148,"_5":15607,"_29907":131638,"_3297":132149},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3844":79158,"_33198":78946,"_22654":132151,"_5":15607,"_29907":131638,"_3297":132152},[],"Para que el flujo JITP funcione correctamente:",{"_3844":79159,"_33198":78946,"_22654":132154,"_5":15607,"_29907":131638,"_3297":132155},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3844":79160,"_33198":78946,"_22654":132157,"_5":15607,"_29907":131638,"_3297":132158},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3844":79161,"_33198":78946,"_22654":132160,"_5":15607,"_29907":131638,"_3297":132161},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3844":79162,"_33198":78946,"_22654":132163,"_5":15607,"_29907":131638,"_3297":132164},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3844":79163,"_33198":78946,"_22654":132166,"_5":15607,"_29907":131642,"_3297":132167},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3844":79164,"_33198":78946,"_22654":132169,"_5":15607,"_29907":131642,"_3297":132170},[],"Estado en Lamassu",{"_3844":79165,"_33198":78946,"_22654":132172,"_5":15607,"_29907":131642,"_3297":132173},[],"Razón de revocación",{"_3844":79166,"_33198":78946,"_22654":132175,"_5":15607,"_29907":131642,"_3297":132176},[],"Estado en AWS IoT Core",{"_3844":79167,"_33198":78946,"_22654":132178,"_5":15607,"_29907":131642,"_3297":59003},[],{"_3844":79168,"_33198":78946,"_22654":132180,"_5":15607,"_29907":131642,"_3297":132181},[],"Ninguna",{"_3844":79169,"_33198":78946,"_22654":132183,"_5":15607,"_29907":131642,"_3297":59009},[],{"_3844":79170,"_33198":78946,"_22654":132185,"_5":15607,"_29907":131642,"_3297":59012},[],{"_3844":79171,"_33198":78946,"_22654":132187,"_5":15607,"_29907":131642,"_3297":59015},[],{"_3844":79172,"_33198":78946,"_22654":132189,"_5":15607,"_29907":131642,"_3297":59018},[],{"_3844":79173,"_33198":78946,"_22654":132191,"_5":15607,"_29907":131642,"_3297":59012},[],{"_3844":79174,"_33198":78946,"_22654":132193,"_5":15607,"_29907":131642,"_3297":132194},[],"Cualquier otra razón",{"_3844":79175,"_33198":78946,"_22654":132196,"_5":15607,"_29907":131642,"_3297":59026},[],{"_3844":79176,"_33198":78946,"_22654":132198,"_5":15607,"_29907":131642,"_3297":132199},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3844":79177,"_33198":78946,"_22654":132201,"_5":15607,"_29907":131646,"_3297":132202},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3844":79178,"_33198":78946,"_22654":132204,"_5":15607,"_29907":131646,"_3297":131988},[],{"_3844":79179,"_33198":78946,"_22654":132206,"_5":15607,"_29907":131646,"_3297":131991},[],{"_3844":79180,"_33198":78946,"_22654":132208,"_5":15607,"_29907":131646,"_3297":132209},[],"`NoSincronizado` → `Active`",{"_3844":79181,"_33198":78946,"_22654":132211,"_5":15607,"_29907":131646,"_3297":58518},[],{"_3844":79182,"_33198":78946,"_22654":132213,"_5":15607,"_29907":131646,"_3297":59044},[],{"_3844":79183,"_33198":78946,"_22654":132215,"_5":15607,"_29907":131646,"_3297":132216},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3844":79184,"_33198":78946,"_22654":132218,"_5":15607,"_29907":131646,"_3297":59050},[],{"_3844":79185,"_33198":78946,"_22654":132220,"_5":15607,"_29907":131646,"_3297":132216},[],{"_3844":79186,"_33198":78946,"_22654":132222,"_5":15607,"_29907":131646,"_3297":59055},[],{"_3844":79187,"_33198":78946,"_22654":132224,"_5":15607,"_29907":131646,"_3297":58518},[],{"_3844":79188,"_33198":78946,"_22654":132226,"_5":15607,"_29907":131646,"_3297":59060},[],{"_3844":79189,"_33198":78946,"_22654":132228,"_5":15607,"_29907":131646,"_3297":132229},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3844":79190,"_33198":78946,"_22654":132231,"_5":15607,"_29907":131650,"_3297":132232},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3844":79191,"_33198":78946,"_22654":132234,"_5":15607,"_29907":131650,"_3297":132235},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3844":79192,"_33198":78946,"_22654":132237,"_5":15607,"_29907":131650,"_3297":132238},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3844":79193,"_33198":78946,"_22654":132240,"_5":15607,"_29907":131654,"_3297":132241},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3844":79194,"_33198":78946,"_22654":132243,"_5":15607,"_29907":131654,"_3297":132244},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3844":79195,"_33198":78946,"_22654":132246,"_5":15607,"_29907":131658,"_3297":132247},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3844":79196,"_33198":78946,"_22654":132249,"_5":15607,"_29907":131658,"_3297":132250},[],"Existen dos tipos de acciones:",{"_3844":79197,"_33198":78946,"_22654":132252,"_5":15607,"_29907":131658,"_3297":132253},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3844":79198,"_33198":78946,"_22654":132255,"_5":15607,"_29907":131658,"_3297":132256},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3844":79199,"_33198":78946,"_22654":132258,"_5":15607,"_29907":131658,"_3297":132259},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3844":79200,"_33198":78946,"_22654":132261,"_5":15607,"_29907":131662,"_3297":132262},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3844":79201,"_33198":78946,"_22654":132264,"_5":15607,"_29907":131662,"_3297":132265},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3844":79202,"_33198":78946,"_22654":132267,"_5":15607,"_29907":131662,"_3297":132268},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3844":79203,"_33198":78946,"_22654":132270,"_5":15607,"_29907":131666,"_3297":132271},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3844":79204,"_33198":78946,"_22654":132273,"_5":15607,"_29907":131666,"_3297":132274},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3844":79205,"_33198":78946,"_22654":132276,"_5":15607,"_29907":131666,"_3297":132277},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3844":79206,"_33198":78946,"_22654":132279,"_5":15607,"_29907":131666,"_3297":132280},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3844":79207,"_33198":78946,"_22654":132282,"_5":15607,"_29907":131666,"_3297":132283},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3844":79208,"_33198":78946,"_22654":132285,"_5":15607,"_29907":131666,"_3297":132286},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3844":79209,"_33198":78946,"_22654":132288,"_5":15607,"_29907":131666,"_3297":132289},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3844":79210,"_33198":78946,"_22654":132291,"_5":15607,"_29907":131666,"_3297":132292},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3844":79211,"_33198":78946,"_22654":132294,"_5":15607,"_29907":131666,"_3297":132295},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3844":79212,"_33198":78946,"_22654":132297,"_5":15607,"_29907":131666,"_3297":132298},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3844":79213,"_33198":78946,"_22654":132300,"_5":15607,"_29907":131666,"_3297":132301},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3844":79214,"_33198":78946,"_22654":132303,"_5":15607,"_29907":131666,"_3297":132304},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3844":79215,"_33198":78946,"_22654":132306,"_5":15607,"_29907":131666,"_3297":132307},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3844":79216,"_33198":78946,"_22654":132309,"_5":15607,"_29907":131666,"_3297":132310},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3844":79217,"_33198":78946,"_22654":132312,"_5":15607,"_29907":131666,"_3297":132313},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3844":79218,"_33198":78946,"_22654":132315,"_5":15607,"_29907":131666,"_3297":132316},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3844":79219,"_33198":78946,"_22654":132318,"_5":15607,"_29907":131666,"_3297":132319},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3844":79220,"_33198":78946,"_22654":132321,"_5":15607,"_29907":131666,"_3297":132322},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3844":79221,"_33198":78946,"_22654":132324,"_5":15607,"_29907":131666,"_3297":132325},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3844":79222,"_33198":78946,"_22654":132327,"_5":15607,"_29907":131666,"_3297":132328},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3844":79223,"_33198":78946,"_22654":132330,"_5":15607,"_29907":131666,"_3297":132331},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3844":79224,"_33198":78946,"_22654":132333,"_5":15607,"_29907":131666,"_3297":132334},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3844":79225,"_33198":78946,"_22654":132336,"_5":15607,"_29907":131666,"_3297":132337},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3844":79226,"_33198":78946,"_22654":132339,"_5":15607,"_29907":131666,"_3297":132340},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3844":79227,"_33198":79227,"_5":16006,"_3297":56881,"_33604":132342,"_22654":132343,"_29907":79227},[54402,129149,56881],[],{"_3844":79228,"_33198":79227,"_22654":132345,"_5":15607,"_29907":79227,"_3297":132346},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3844":79229,"_33198":79227,"_5":33601,"_22654":132348,"_29907":132349,"_3297":132350},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3844":79230,"_33198":79227,"_5":33601,"_22654":132352,"_29907":132353,"_3297":130158},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3844":79231,"_33198":79227,"_5":33601,"_22654":132355,"_29907":132356,"_3297":130333},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3844":79232,"_33198":79227,"_5":33601,"_22654":132358,"_29907":132359,"_3297":131565},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/overview#integraciones",{"_3844":79233,"_33198":79227,"_5":33601,"_22654":132361,"_29907":132362,"_3297":132363},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3844":79234,"_33198":79227,"_22654":132365,"_5":15607,"_29907":79227,"_3297":132366},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3844":79235,"_33198":79227,"_22654":132368,"_5":15607,"_29907":132349,"_3297":132369},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3844":79236,"_33198":79227,"_22654":132371,"_5":15607,"_29907":132349,"_3297":132372},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3844":79237,"_33198":79227,"_22654":132374,"_5":15607,"_29907":132353,"_3297":132375},[],"Recurso",{"_3844":79238,"_33198":79227,"_22654":132377,"_5":15607,"_29907":132353,"_3297":132378},[],"Qué representa",{"_3844":79239,"_33198":79227,"_22654":132380,"_5":15607,"_29907":132353,"_3297":132381},[],"**Dispositivo**",{"_3844":79240,"_33198":79227,"_22654":132383,"_5":15607,"_29907":132353,"_3297":132384},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3844":79241,"_33198":79227,"_22654":132386,"_5":15607,"_29907":132353,"_3297":132387},[],"**Identidad**",{"_3844":79242,"_33198":79227,"_22654":132389,"_5":15607,"_29907":132353,"_3297":132390},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3844":79243,"_33198":79227,"_22654":132392,"_5":15607,"_29907":132353,"_3297":59227},[],{"_3844":79244,"_33198":79227,"_22654":132394,"_5":15607,"_29907":132353,"_3297":132395},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3844":79245,"_33198":79227,"_22654":132397,"_5":15607,"_29907":132353,"_3297":132398},[],"**Flota**",{"_3844":79246,"_33198":79227,"_22654":132400,"_5":15607,"_29907":132353,"_3297":132401},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3844":79247,"_33198":79227,"_22654":132403,"_5":15607,"_29907":132353,"_3297":132404},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3844":79248,"_33198":79227,"_22654":132406,"_5":15607,"_29907":132353,"_3297":132407},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3844":79249,"_33198":79227,"_22654":132409,"_5":15607,"_29907":132356,"_3297":132410},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3844":79250,"_33198":79227,"_22654":132412,"_5":15607,"_29907":132356,"_3297":132413},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3844":79251,"_33198":79227,"_22654":132415,"_5":15607,"_29907":132356,"_3297":132416},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3844":79252,"_33198":79227,"_22654":132418,"_5":15607,"_29907":132356,"_3297":132419},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3844":79253,"_33198":79227,"_22654":132421,"_5":15607,"_29907":132356,"_3297":132422},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3844":79254,"_33198":79227,"_22654":132424,"_5":15607,"_29907":132356,"_3297":132425},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3844":79255,"_33198":79227,"_22654":132427,"_5":15607,"_29907":132356,"_3297":132428},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3844":79256,"_33198":79227,"_22654":132430,"_5":15607,"_29907":132356,"_3297":132431},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3844":79257,"_33198":79227,"_22654":132433,"_5":15607,"_29907":132359,"_3297":132434},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3844":79258,"_33198":79227,"_22654":132436,"_5":15607,"_29907":132359,"_3297":132437},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3844":79259,"_33198":79227,"_22654":132439,"_5":15607,"_29907":132362,"_3297":132440},[],"Participante",{"_3844":79260,"_33198":79227,"_22654":132442,"_5":15607,"_29907":132362,"_3297":132443},[],"Responsabilidad",{"_3844":79261,"_33198":79227,"_22654":132445,"_5":15607,"_29907":132362,"_3297":132446},[],"Administrador PKI",{"_3844":79262,"_33198":79227,"_22654":132448,"_5":15607,"_29907":132362,"_3297":132449},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3844":79263,"_33198":79227,"_22654":132451,"_5":15607,"_29907":132362,"_3297":132452},[],"Administrador del aprovisionamiento",{"_3844":79264,"_33198":79227,"_22654":132454,"_5":15607,"_29907":132362,"_3297":132455},[],"DMS, admisión, autenticación por operación e inventario.",{"_3844":79265,"_33198":79227,"_22654":132457,"_5":15607,"_29907":132362,"_3297":132458},[],"Integrador del dispositivo",{"_3844":79266,"_33198":79227,"_22654":132460,"_5":15607,"_29907":132362,"_3297":132461},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3844":79267,"_33198":79227,"_22654":132463,"_5":15607,"_29907":132362,"_3297":132464},[],"Integrador del consumidor",{"_3844":79268,"_33198":79227,"_22654":132466,"_5":15607,"_29907":132362,"_3297":132467},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3844":79269,"_33198":79227,"_22654":132469,"_5":15607,"_29907":132362,"_3297":132470},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3844":79270,"_33198":79270,"_5":16006,"_3297":132472,"_33604":132473,"_22654":132475,"_29907":79270},"Enrola y conecta tu primer dispositivo",[54402,129149,56881,132474],"Primeros pasos",[],{"_3844":79271,"_33198":79270,"_22654":132477,"_5":15607,"_29907":79270,"_3297":132478},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3844":79272,"_33198":79270,"_5":33601,"_22654":132480,"_29907":132481,"_3297":127727},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3844":79273,"_33198":79270,"_5":33601,"_22654":132483,"_29907":132484,"_3297":132485},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3844":79274,"_33198":79270,"_5":33601,"_22654":132487,"_29907":132488,"_3297":132489},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3844":79275,"_33198":79270,"_5":33601,"_22654":132491,"_29907":132492,"_3297":132493},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3844":79276,"_33198":79270,"_5":33601,"_22654":132495,"_29907":132496,"_3297":132497},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3844":79277,"_33198":79270,"_5":33601,"_22654":132499,"_29907":132500,"_3297":132501},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3844":79278,"_33198":79270,"_5":33601,"_22654":132503,"_29907":132504,"_3297":132505},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3844":79279,"_33198":79270,"_5":33601,"_22654":132507,"_29907":132508,"_3297":132509},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3844":79280,"_33198":79270,"_22654":132511,"_5":15607,"_29907":79270,"_3297":132512},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3844":79281,"_33198":79270,"_22654":132514,"_5":15607,"_29907":132481,"_3297":132515},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3844":79282,"_33198":79270,"_22654":132517,"_5":15607,"_29907":132481,"_3297":132518},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3844":79283,"_33198":79270,"_22654":132520,"_5":15607,"_29907":132481,"_3297":132521},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3844":79284,"_33198":79270,"_22654":132523,"_5":15607,"_29907":132481,"_3297":132524},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3844":79285,"_33198":79270,"_22654":132526,"_5":15607,"_29907":132481,"_3297":132527},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3844":79286,"_33198":79270,"_22654":132529,"_5":15607,"_29907":132484,"_3297":132530},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3844":79287,"_33198":79270,"_22654":132532,"_5":15607,"_29907":132484,"_3297":132533},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3844":79288,"_33198":79270,"_22654":132535,"_5":15607,"_29907":132488,"_3297":132536},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3844":79289,"_33198":79270,"_22654":132538,"_5":15607,"_29907":132488,"_3297":132539},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3844":79290,"_33198":79270,"_22654":132541,"_5":15607,"_29907":132488,"_3297":132542},[],"Ajuste",{"_3844":79291,"_33198":79270,"_22654":132544,"_5":15607,"_29907":132488,"_3297":132545},[],"Valor de evaluación",{"_3844":79292,"_33198":79270,"_22654":132547,"_5":15607,"_29907":132488,"_3297":59383},[],{"_3844":79293,"_33198":79270,"_22654":132549,"_5":15607,"_29907":132488,"_3297":132550},[],"Raíz emisora de `device-root.pem`.",{"_3844":79294,"_33198":79270,"_22654":132552,"_5":15607,"_29907":132488,"_3297":130461},[],{"_3844":79295,"_33198":79270,"_22654":132554,"_5":15607,"_29907":132488,"_3297":132555},[],"Perfil final de 1 hora que acabas de preparar.",{"_3844":79296,"_33198":79270,"_22654":132557,"_5":15607,"_29907":132488,"_3297":59394},[],{"_3844":79297,"_33198":79270,"_22654":132559,"_5":15607,"_29907":132488,"_3297":59397},[],{"_3844":79298,"_33198":79270,"_22654":132561,"_5":15607,"_29907":132488,"_3297":59400},[],{"_3844":79299,"_33198":79270,"_22654":132563,"_5":15607,"_29907":132488,"_3297":132564},[],"Habilitado.",{"_3844":79300,"_33198":79270,"_22654":132566,"_5":15607,"_29907":132488,"_3297":59406},[],{"_3844":79301,"_33198":79270,"_22654":132568,"_5":15607,"_29907":132488,"_3297":132569},[],"Deshabilitado; el ID debe ser nuevo.",{"_3844":79302,"_33198":79270,"_22654":132571,"_5":15607,"_29907":132488,"_3297":132572},[],"Autenticación inicial",{"_3844":79303,"_33198":79270,"_22654":132574,"_5":15607,"_29907":132488,"_3297":132575},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3844":79304,"_33198":79270,"_22654":132577,"_5":15607,"_29907":132488,"_3297":132578},[],"Autenticación de renovación",{"_3844":79305,"_33198":79270,"_22654":132580,"_5":15607,"_29907":132488,"_3297":132581},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3844":79306,"_33198":79270,"_22654":132583,"_5":15607,"_29907":132488,"_3297":59424},[],{"_3844":79307,"_33198":79270,"_22654":132585,"_5":15607,"_29907":132488,"_3297":132586},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3844":79308,"_33198":79270,"_22654":132588,"_5":15607,"_29907":132488,"_3297":59430},[],{"_3844":79309,"_33198":79270,"_22654":132590,"_5":15607,"_29907":132488,"_3297":132591},[],"1 hora.",{"_3844":79310,"_33198":79270,"_22654":132593,"_5":15607,"_29907":132488,"_3297":59436},[],{"_3844":79311,"_33198":79270,"_22654":132595,"_5":15607,"_29907":132488,"_3297":132596},[],"30 minutos / 10 minutos.",{"_3844":79312,"_33198":79270,"_22654":132598,"_5":15607,"_29907":132488,"_3297":59442},[],{"_3844":79313,"_33198":79270,"_22654":132600,"_5":15607,"_29907":132488,"_3297":132601},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3844":79314,"_33198":79270,"_22654":132603,"_5":15607,"_29907":132488,"_3297":57200},[],{"_3844":79315,"_33198":79270,"_22654":132605,"_5":15607,"_29907":132488,"_3297":132606},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3844":79316,"_33198":79270,"_22654":132608,"_5":15607,"_29907":132488,"_3297":59453},[],{"_3844":79317,"_33198":79270,"_22654":132610,"_5":15607,"_29907":132488,"_3297":132611},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3844":79318,"_33198":79270,"_22654":132613,"_5":15607,"_29907":132488,"_3297":132614},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3844":79319,"_33198":79270,"_22654":132616,"_5":15607,"_29907":132492,"_3297":132617},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3844":79320,"_33198":79270,"_22654":132619,"_5":15607,"_29907":132492,"_3297":132620},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3844":79321,"_33198":79270,"_22654":132622,"_5":15607,"_29907":132496,"_3297":132623},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3844":79322,"_33198":79270,"_22654":132625,"_5":15607,"_29907":132496,"_3297":132626},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3844":79323,"_33198":79270,"_22654":132628,"_5":15607,"_29907":132496,"_3297":132629},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3844":79324,"_33198":79270,"_22654":132631,"_5":15607,"_29907":132500,"_3297":132632},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3844":79325,"_33198":79270,"_22654":132634,"_5":15607,"_29907":132500,"_3297":132635},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3844":79326,"_33198":79270,"_22654":132637,"_5":15607,"_29907":132504,"_3297":132638},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3844":79327,"_33198":79270,"_22654":132640,"_5":15607,"_29907":132504,"_3297":132641},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3844":79328,"_33198":79270,"_22654":132643,"_5":15607,"_29907":132504,"_3297":132644},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3844":79329,"_33198":79270,"_22654":132646,"_5":15607,"_29907":132504,"_3297":132647},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3844":79330,"_33198":79270,"_22654":132649,"_5":15607,"_29907":132504,"_3297":132650},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3844":79331,"_33198":79270,"_22654":132652,"_5":15607,"_29907":132508,"_3297":132653},[],"Comprobación",{"_3844":79332,"_33198":79270,"_22654":132655,"_5":15607,"_29907":132508,"_3297":132656},[],"Resultado esperado",{"_3844":79333,"_33198":79270,"_22654":132658,"_5":15607,"_29907":132508,"_3297":132659},[],"Registro",{"_3844":79334,"_33198":79270,"_22654":132661,"_5":15607,"_29907":132508,"_3297":132662},[],"ID creado automáticamente y DMS correcto.",{"_3844":79335,"_33198":79270,"_22654":132664,"_5":15607,"_29907":132508,"_3297":131949},[],{"_3844":79336,"_33198":79270,"_22654":132666,"_5":15607,"_29907":132508,"_3297":132667},[],"CN, perfil, serie y clave verificados.",{"_3844":79337,"_33198":79270,"_22654":132669,"_5":15607,"_29907":132508,"_3297":132670},[],"Inventario",{"_3844":79338,"_33198":79270,"_22654":132672,"_5":15607,"_29907":132508,"_3297":132673},[],"Serie recibida visible como identidad actual y en el historial.",{"_3844":79339,"_33198":79270,"_22654":132675,"_5":15607,"_29907":132508,"_3297":132676},[],"Consumidor",{"_3844":79340,"_33198":79270,"_22654":132678,"_5":15607,"_29907":132508,"_3297":132679},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3844":79341,"_33198":79270,"_22654":132681,"_5":15607,"_29907":132508,"_3297":132682},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3844":79342,"_33198":79270,"_22654":132684,"_5":15607,"_29907":132508,"_3297":132685},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3844":79343,"_33198":79343,"_5":16006,"_3297":130175,"_33604":132687,"_22654":132688,"_29907":79343},[54402,129149,56881,132474],[],{"_3844":79344,"_33198":79343,"_22654":132690,"_5":15607,"_29907":79343,"_3297":132691},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3844":79345,"_33198":79343,"_5":33601,"_22654":132693,"_29907":132694,"_3297":127727},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3844":79346,"_33198":79343,"_5":33601,"_22654":132696,"_29907":132697,"_3297":132698},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3844":79347,"_33198":79343,"_5":33601,"_22654":132700,"_29907":132701,"_3297":132702},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3844":79348,"_33198":79343,"_5":33601,"_22654":132704,"_29907":132705,"_3297":132706},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3844":79349,"_33198":79343,"_5":33601,"_22654":132708,"_29907":132709,"_3297":132710},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3844":79350,"_33198":79343,"_5":33601,"_22654":132712,"_29907":132713,"_3297":132714},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3844":79351,"_33198":79343,"_5":33601,"_22654":132716,"_29907":132717,"_3297":132656},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3844":79352,"_33198":79343,"_5":33601,"_22654":132719,"_29907":132720,"_3297":132721},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3844":79353,"_33198":79343,"_5":33601,"_22654":132723,"_29907":132724,"_3297":132725},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3844":79354,"_33198":79343,"_22654":132727,"_5":15607,"_29907":79343,"_3297":132728},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3844":79355,"_33198":79343,"_22654":132730,"_5":15607,"_29907":79343,"_3297":132731},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3844":79356,"_33198":79343,"_22654":132733,"_5":15607,"_29907":132694,"_3297":132734},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3844":79357,"_33198":79343,"_22654":132736,"_5":15607,"_29907":132694,"_3297":132737},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3844":79358,"_33198":79343,"_22654":132739,"_5":15607,"_29907":132694,"_3297":132740},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3844":79359,"_33198":79343,"_22654":132742,"_5":15607,"_29907":132694,"_3297":132743},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3844":79360,"_33198":79343,"_22654":132745,"_5":15607,"_29907":132697,"_3297":132746},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3844":79361,"_33198":79343,"_22654":132748,"_5":15607,"_29907":132697,"_3297":132749},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3844":79362,"_33198":79343,"_22654":132751,"_5":15607,"_29907":132697,"_3297":132752},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3844":79363,"_33198":79343,"_22654":132754,"_5":15607,"_29907":132697,"_3297":132755},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3844":79364,"_33198":79343,"_22654":132757,"_5":15607,"_29907":132697,"_3297":132758},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3844":79365,"_33198":79343,"_22654":132760,"_5":15607,"_29907":132697,"_3297":132761},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3844":79366,"_33198":79343,"_22654":132763,"_5":15607,"_29907":132697,"_3297":132764},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3844":79367,"_33198":79343,"_22654":132766,"_5":15607,"_29907":132697,"_3297":132767},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3844":79368,"_33198":79343,"_22654":132769,"_5":15607,"_29907":132701,"_3297":132770},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3844":79369,"_33198":79343,"_22654":132772,"_5":15607,"_29907":132701,"_3297":59618},[],{"_3844":79370,"_33198":79343,"_22654":132774,"_5":15607,"_29907":132701,"_3297":132775},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3844":79371,"_33198":79343,"_22654":132777,"_5":15607,"_29907":132701,"_3297":132778},[],"**Icon** y **Tags**: clasificación opcional.",{"_3844":79372,"_33198":79343,"_22654":132780,"_5":15607,"_29907":132701,"_3297":132781},[],"Confirma el registro.",{"_3844":79373,"_33198":79343,"_22654":132783,"_5":15607,"_29907":132705,"_3297":132784},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3844":79374,"_33198":79343,"_22654":132786,"_5":15607,"_29907":132705,"_3297":132787},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3844":79375,"_33198":79343,"_22654":132789,"_5":15607,"_29907":132709,"_3297":132790},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3844":79376,"_33198":79343,"_22654":132792,"_5":15607,"_29907":132709,"_3297":132793},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3844":79377,"_33198":79343,"_22654":132795,"_5":15607,"_29907":132713,"_3297":132796},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3844":79378,"_33198":79343,"_22654":132798,"_5":15607,"_29907":132713,"_3297":132799},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3844":79379,"_33198":79343,"_22654":132801,"_5":15607,"_29907":132717,"_3297":132653},[],{"_3844":79380,"_33198":79343,"_22654":132803,"_5":15607,"_29907":132717,"_3297":132804},[],"Resultado",{"_3844":79381,"_33198":79343,"_22654":132806,"_5":15607,"_29907":132717,"_3297":131935},[],{"_3844":79382,"_33198":79343,"_22654":132808,"_5":15607,"_29907":132717,"_3297":132809},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3844":79383,"_33198":79343,"_22654":132811,"_5":15607,"_29907":132717,"_3297":132812},[],"Identidad actual",{"_3844":79384,"_33198":79343,"_22654":132814,"_5":15607,"_29907":132717,"_3297":132815},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3844":79385,"_33198":79343,"_22654":132817,"_5":15607,"_29907":132717,"_3297":132818},[],"Historial",{"_3844":79386,"_33198":79343,"_22654":132820,"_5":15607,"_29907":132717,"_3297":132821},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3844":79387,"_33198":79343,"_22654":132823,"_5":15607,"_29907":132717,"_3297":132824},[],"Clave y certificado",{"_3844":79388,"_33198":79343,"_22654":132826,"_5":15607,"_29907":132717,"_3297":132827},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3844":79389,"_33198":79343,"_22654":132829,"_5":15607,"_29907":132720,"_3297":132830},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3844":79390,"_33198":79343,"_22654":132832,"_5":15607,"_29907":132720,"_3297":132833},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3844":79391,"_33198":79343,"_22654":132835,"_5":15607,"_29907":132720,"_3297":132836},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3844":79392,"_33198":79343,"_22654":132838,"_5":15607,"_29907":132720,"_3297":132839},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3844":79393,"_33198":79343,"_22654":132841,"_5":15607,"_29907":132724,"_3297":132842},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3844":79394,"_33198":79343,"_22654":132844,"_5":15607,"_29907":132724,"_3297":132845},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3844":79395,"_33198":79343,"_22654":132847,"_5":15607,"_29907":132724,"_3297":132848},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3844":79396,"_33198":79396,"_5":16006,"_3297":132850,"_33604":132851,"_22654":132852,"_29907":79396},"Plataforma Lamassu IoT",[54402,129149],[],{"_3844":79397,"_33198":79396,"_22654":132854,"_5":15607,"_29907":79396,"_3297":132855},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3844":79398,"_33198":79396,"_5":33601,"_22654":132857,"_29907":132858,"_3297":132350},[],"/docs/pr-preview/pr-58/es/platform/overview#empieza-aquí",{"_3844":79399,"_33198":79396,"_5":33601,"_22654":132860,"_29907":132861,"_3297":132862},[],"/docs/pr-preview/pr-58/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3844":79400,"_33198":79396,"_5":33601,"_22654":132864,"_29907":132865,"_3297":132866},[],"/docs/pr-preview/pr-58/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3844":79401,"_33198":79396,"_5":33601,"_22654":132868,"_29907":132869,"_3297":132870},[],"/docs/pr-preview/pr-58/es/platform/overview#capacidades-principales","Capacidades principales",{"_3844":79402,"_33198":79396,"_5":33601,"_22654":132872,"_29907":132873,"_3297":132874},[],"/docs/pr-preview/pr-58/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3844":79403,"_33198":79396,"_5":33601,"_22654":132876,"_29907":132877,"_3297":132878},[],"/docs/pr-preview/pr-58/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3844":79404,"_33198":79396,"_5":33601,"_22654":132880,"_29907":132881,"_3297":132882},[],"/docs/pr-preview/pr-58/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3844":79405,"_33198":79396,"_5":33601,"_22654":132884,"_29907":132885,"_3297":132886},[],"/docs/pr-preview/pr-58/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3844":79406,"_33198":79396,"_5":33601,"_22654":132888,"_29907":132889,"_3297":132890},[],"/docs/pr-preview/pr-58/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3844":79407,"_33198":79396,"_5":33601,"_22654":132892,"_29907":132893,"_3297":132894},[],"/docs/pr-preview/pr-58/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3844":79408,"_33198":79396,"_5":33601,"_22654":132896,"_29907":132897,"_3297":132898},[],"/docs/pr-preview/pr-58/es/platform/overview#referencia-operativa","Referencia operativa",{"_3844":79409,"_33198":79396,"_22654":132900,"_5":15607,"_29907":79396,"_3297":132901},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3844":79410,"_33198":79396,"_22654":132903,"_5":15607,"_29907":132858,"_3297":132904},[],"Elige el resultado que necesitas obtener:",{"_3844":79411,"_33198":79396,"_22654":132906,"_5":15607,"_29907":132858,"_3297":132907},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3844":79412,"_33198":79396,"_22654":132909,"_5":15607,"_29907":132858,"_3297":132910},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3844":79413,"_33198":79396,"_22654":132912,"_5":15607,"_29907":132858,"_3297":132913},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3844":79414,"_33198":79396,"_22654":132915,"_5":15607,"_29907":132861,"_3297":132916},[],"Bloque",{"_3844":79415,"_33198":79396,"_22654":132918,"_5":15607,"_29907":132861,"_3297":132919},[],"Qué gestionas",{"_3844":79416,"_33198":79396,"_22654":132921,"_5":15607,"_29907":132861,"_3297":132922},[],"Punto de entrada",{"_3844":79417,"_33198":79396,"_22654":132924,"_5":15607,"_29907":132861,"_3297":59771},[],{"_3844":79418,"_33198":79396,"_22654":132926,"_5":15607,"_29907":132861,"_3297":132927},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3844":79419,"_33198":79396,"_22654":132929,"_5":15607,"_29907":132861,"_3297":132930},[],"Visión general de PKI",{"_3844":79420,"_33198":79396,"_22654":132932,"_5":15607,"_29907":132861,"_3297":59780},[],{"_3844":79421,"_33198":79396,"_22654":132934,"_5":15607,"_29907":132861,"_3297":132935},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3844":79422,"_33198":79396,"_22654":132937,"_5":15607,"_29907":132861,"_3297":132938},[],"Visión general de IoT Fleets",{"_3844":79423,"_33198":79396,"_22654":132940,"_5":15607,"_29907":132861,"_3297":132941},[],"**Administración**",{"_3844":79424,"_33198":79396,"_22654":132943,"_5":15607,"_29907":132861,"_3297":132944},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3844":79425,"_33198":79396,"_22654":132946,"_5":15607,"_29907":132861,"_3297":129147},[],{"_3844":79426,"_33198":79396,"_22654":132948,"_5":15607,"_29907":132861,"_3297":132949},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3844":79427,"_33198":79396,"_22654":132951,"_5":15607,"_29907":132865,"_3297":132952},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3844":79428,"_33198":79396,"_22654":132954,"_5":15607,"_29907":132865,"_3297":132955},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3844":79429,"_33198":79396,"_22654":132957,"_5":15607,"_29907":132865,"_3297":132958},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3844":79430,"_33198":79396,"_22654":132960,"_5":15607,"_29907":132865,"_3297":132961},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3844":79431,"_33198":79396,"_22654":132963,"_5":15607,"_29907":132865,"_3297":132964},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3844":79432,"_33198":79396,"_22654":132966,"_5":15607,"_29907":132865,"_3297":132967},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3844":79433,"_33198":79396,"_22654":132969,"_5":15607,"_29907":132873,"_3297":132970},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3844":79434,"_33198":79396,"_22654":132972,"_5":15607,"_29907":132877,"_3297":132973},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3844":79435,"_33198":79396,"_22654":132975,"_5":15607,"_29907":132881,"_3297":132976},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3844":79436,"_33198":79396,"_22654":132978,"_5":15607,"_29907":132885,"_3297":132979},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3844":79437,"_33198":79396,"_22654":132981,"_5":15607,"_29907":132889,"_3297":132982},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3844":79438,"_33198":79396,"_22654":132984,"_5":15607,"_29907":132893,"_3297":132985},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3844":79439,"_33198":79396,"_22654":132987,"_5":15607,"_29907":132897,"_3297":132443},[],{"_3844":79440,"_33198":79396,"_22654":132989,"_5":15607,"_29907":132897,"_3297":132990},[],"Qué prepara o comprueba",{"_3844":79441,"_33198":79396,"_22654":132992,"_5":15607,"_29907":132897,"_3297":132446},[],{"_3844":79442,"_33198":79396,"_22654":132994,"_5":15607,"_29907":132897,"_3297":132995},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3844":79443,"_33198":79396,"_22654":132997,"_5":15607,"_29907":132897,"_3297":132998},[],"Administrador de la flota",{"_3844":79444,"_33198":79396,"_22654":133000,"_5":15607,"_29907":132897,"_3297":133001},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3844":79445,"_33198":79396,"_22654":133003,"_5":15607,"_29907":132897,"_3297":132458},[],{"_3844":79446,"_33198":79396,"_22654":133005,"_5":15607,"_29907":132897,"_3297":133006},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3844":79447,"_33198":79396,"_22654":133008,"_5":15607,"_29907":132897,"_3297":132464},[],{"_3844":79448,"_33198":79396,"_22654":133010,"_5":15607,"_29907":132897,"_3297":133011},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3844":79449,"_33198":79396,"_22654":133013,"_5":15607,"_29907":132897,"_3297":133014},[],"Operador de infraestructura",{"_3844":79450,"_33198":79396,"_22654":133016,"_5":15607,"_29907":132897,"_3297":133017},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3844":79451,"_33198":79396,"_22654":133019,"_5":15607,"_29907":132897,"_3297":133020},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3844":79452,"_33198":79452,"_5":16006,"_3297":133022,"_33604":133023,"_22654":133025,"_29907":79452},"Jerarquía y rotación de CAs",[54402,129149,59872,133024],"Claves, autoridades y certificados",[],{"_3844":79453,"_33198":79452,"_22654":133027,"_5":15607,"_29907":79452,"_3297":133028},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3844":79454,"_33198":79452,"_5":33601,"_22654":133030,"_29907":133031,"_3297":133032},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3844":79455,"_33198":79452,"_5":33601,"_22654":133034,"_29907":133035,"_3297":133036},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3844":79456,"_33198":79452,"_5":33601,"_22654":133038,"_29907":133039,"_3297":133040},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3844":79457,"_33198":79452,"_5":33601,"_22654":133042,"_29907":133043,"_3297":133044},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3844":79458,"_33198":79452,"_5":33601,"_22654":133046,"_29907":133047,"_3297":133048},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3844":79459,"_33198":79452,"_5":33601,"_22654":133050,"_29907":133051,"_3297":133052},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3844":79460,"_33198":79452,"_5":33601,"_22654":133054,"_29907":133055,"_3297":133056},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3844":79461,"_33198":79452,"_5":33601,"_22654":133058,"_29907":133059,"_3297":133060},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3844":79462,"_33198":79452,"_5":33601,"_22654":133062,"_29907":133063,"_3297":133064},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3844":79463,"_33198":79452,"_5":33601,"_22654":133066,"_29907":133067,"_3297":133068},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3844":79464,"_33198":79452,"_5":33601,"_22654":133070,"_29907":133071,"_3297":133072},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3844":79465,"_33198":79452,"_5":33601,"_22654":133074,"_29907":133075,"_3297":133076},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3844":79466,"_33198":79452,"_22654":133078,"_5":15607,"_29907":79452,"_3297":133079},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3844":79467,"_33198":79452,"_22654":133081,"_5":15607,"_29907":79452,"_3297":133082},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3844":79468,"_33198":79452,"_22654":133084,"_5":15607,"_29907":133031,"_3297":133085},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3844":79469,"_33198":79452,"_22654":133087,"_5":15607,"_29907":133031,"_3297":133088},[],"entorno, como producción y preproducción;",{"_3844":79470,"_33198":79452,"_22654":133090,"_5":15607,"_29907":133031,"_3297":133091},[],"propietario o equipo operador;",{"_3844":79471,"_33198":79452,"_22654":133093,"_5":15607,"_29907":133031,"_3297":133094},[],"familia de dispositivos o proceso de fabricación;",{"_3844":79472,"_33198":79452,"_22654":133096,"_5":15607,"_29907":133031,"_3297":133097},[],"región o requisito regulatorio;",{"_3844":79473,"_33198":79452,"_22654":133099,"_5":15607,"_29907":133031,"_3297":133100},[],"motor criptográfico o política de clave;",{"_3844":79474,"_33198":79452,"_22654":133102,"_5":15607,"_29907":133031,"_3297":133103},[],"ventana de mantenimiento y ritmo de renovación.",{"_3844":79475,"_33198":79452,"_22654":133105,"_5":15607,"_29907":133031,"_3297":133106},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3844":79476,"_33198":79452,"_22654":133108,"_5":15607,"_29907":133031,"_3297":133109},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3844":79477,"_33198":79452,"_22654":133111,"_5":15607,"_29907":133035,"_3297":133112},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3844":79478,"_33198":79452,"_22654":133114,"_5":15607,"_29907":133035,"_3297":133115},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3844":79479,"_33198":79452,"_22654":133117,"_5":15607,"_29907":133035,"_3297":133118},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3844":79480,"_33198":79452,"_22654":133120,"_5":15607,"_29907":133039,"_3297":133121},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3844":79481,"_33198":79452,"_22654":133123,"_5":15607,"_29907":133039,"_3297":133124},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3844":79482,"_33198":79452,"_22654":133126,"_5":15607,"_29907":133039,"_3297":133127},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3844":79483,"_33198":79452,"_22654":133129,"_5":15607,"_29907":133039,"_3297":133130},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3844":79484,"_33198":79452,"_22654":133132,"_5":15607,"_29907":133047,"_3297":133133},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3844":79485,"_33198":79452,"_22654":133135,"_5":15607,"_29907":133051,"_3297":133136},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3844":79486,"_33198":79452,"_22654":133138,"_5":15607,"_29907":133055,"_3297":133139},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3844":79487,"_33198":79452,"_22654":133141,"_5":15607,"_29907":133059,"_3297":133142},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3844":79488,"_33198":79452,"_22654":133144,"_5":15607,"_29907":133063,"_3297":133145},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3844":79489,"_33198":79452,"_22654":133147,"_5":15607,"_29907":133067,"_3297":133148},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3844":79490,"_33198":79452,"_22654":133150,"_5":15607,"_29907":133071,"_3297":133151},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3844":79491,"_33198":79452,"_22654":133153,"_5":15607,"_29907":133071,"_3297":133154},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3844":79492,"_33198":79452,"_22654":133156,"_5":15607,"_29907":133071,"_3297":133157},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3844":79493,"_33198":79452,"_22654":133159,"_5":15607,"_29907":133071,"_3297":133160},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3844":79494,"_33198":79452,"_22654":133162,"_5":15607,"_29907":133075,"_3297":133163},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3844":79495,"_33198":79452,"_22654":133165,"_5":15607,"_29907":133075,"_3297":133166},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3844":79496,"_33198":79452,"_22654":133168,"_5":15607,"_29907":133075,"_3297":133169},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3844":79497,"_33198":79452,"_22654":133171,"_5":15607,"_29907":133075,"_3297":133172},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3844":79498,"_33198":79452,"_22654":133174,"_5":15607,"_29907":133075,"_3297":133175},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3844":79499,"_33198":79452,"_22654":133177,"_5":15607,"_29907":133075,"_3297":133178},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3844":79500,"_33198":79452,"_22654":133180,"_5":15607,"_29907":133075,"_3297":133181},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3844":79501,"_33198":79501,"_5":16006,"_3297":133183,"_33604":133184,"_22654":133185,"_29907":79501},"Autoridades de certificación",[54402,129149,59872,133024],[],{"_3844":79502,"_33198":79501,"_22654":133187,"_5":15607,"_29907":79501,"_3297":133188},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3844":79503,"_33198":79501,"_5":33601,"_22654":133190,"_29907":133191,"_3297":133192},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3844":79504,"_33198":79501,"_5":33601,"_22654":133194,"_29907":133195,"_3297":133196},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3844":79505,"_33198":79501,"_5":33601,"_22654":133198,"_29907":133199,"_3297":127727},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3844":79506,"_33198":79501,"_5":33601,"_22654":133201,"_29907":133202,"_3297":133203},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3844":79507,"_33198":79501,"_5":33601,"_22654":133205,"_29907":133206,"_3297":133207},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3844":79508,"_33198":79501,"_5":33601,"_22654":133209,"_29907":133210,"_3297":133211},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3844":79509,"_33198":79501,"_5":33601,"_22654":133213,"_29907":133214,"_3297":133215},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3844":79510,"_33198":79501,"_5":33601,"_22654":133217,"_29907":133218,"_3297":133219},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3844":79511,"_33198":79501,"_5":33601,"_22654":133221,"_29907":133222,"_3297":133223},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3844":79512,"_33198":79501,"_5":33601,"_22654":133225,"_29907":133226,"_3297":133227},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3844":79513,"_33198":79501,"_5":33601,"_22654":133229,"_29907":133230,"_3297":133231},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3844":79514,"_33198":79501,"_5":33601,"_22654":133233,"_29907":133234,"_3297":133235},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3844":79515,"_33198":79501,"_5":33601,"_22654":133237,"_29907":133238,"_3297":133239},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3844":79516,"_33198":79501,"_5":33601,"_22654":133241,"_29907":133242,"_3297":133243},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3844":79517,"_33198":79501,"_5":33601,"_22654":133245,"_29907":133246,"_3297":133247},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3844":79518,"_33198":79501,"_5":33601,"_22654":133249,"_29907":133250,"_3297":133251},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3844":79519,"_33198":79501,"_5":33601,"_22654":133253,"_29907":133254,"_3297":133255},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3844":79520,"_33198":79501,"_5":33601,"_22654":133257,"_29907":133258,"_3297":133259},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3844":79521,"_33198":79501,"_5":33601,"_22654":133261,"_29907":133262,"_3297":133263},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3844":79522,"_33198":79501,"_5":33601,"_22654":133265,"_29907":133266,"_3297":133267},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3844":79523,"_33198":79501,"_5":33601,"_22654":133269,"_29907":133270,"_3297":133271},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3844":79524,"_33198":79501,"_5":33601,"_22654":133273,"_29907":133274,"_3297":133275},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3844":79525,"_33198":79501,"_5":33601,"_22654":133277,"_29907":133278,"_3297":133279},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3844":79526,"_33198":79501,"_22654":133281,"_5":15607,"_29907":79501,"_3297":133282},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3844":79527,"_33198":79501,"_22654":133284,"_5":15607,"_29907":79501,"_3297":133285},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3844":79528,"_33198":79501,"_22654":133287,"_5":15607,"_29907":79501,"_3297":133288},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3844":79529,"_33198":79501,"_22654":133290,"_5":15607,"_29907":133191,"_3297":133291},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3844":79530,"_33198":79501,"_22654":133293,"_5":15607,"_29907":133191,"_3297":133294},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3844":79531,"_33198":79501,"_22654":133296,"_5":15607,"_29907":133191,"_3297":133297},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3844":79532,"_33198":79501,"_22654":133299,"_5":15607,"_29907":133191,"_3297":133300},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3844":79533,"_33198":79501,"_22654":133302,"_5":15607,"_29907":133191,"_3297":133303},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3844":79534,"_33198":79501,"_22654":133305,"_5":15607,"_29907":133199,"_3297":133306},[],"Decide si la CA será raíz o intermedia.",{"_3844":79535,"_33198":79501,"_22654":133308,"_5":15607,"_29907":133199,"_3297":133309},[],"Elige el motor que custodiará la clave.",{"_3844":79536,"_33198":79501,"_22654":133311,"_5":15607,"_29907":133199,"_3297":133312},[],"Define una validez superior a la de los certificados que emitirá.",{"_3844":79537,"_33198":79501,"_22654":133314,"_5":15607,"_29907":133199,"_3297":133315},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3844":79538,"_33198":79501,"_22654":133317,"_5":15607,"_29907":133202,"_3297":133318},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3844":79539,"_33198":79501,"_22654":133320,"_5":15607,"_29907":133206,"_3297":133321},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3844":79540,"_33198":79501,"_22654":133323,"_5":15607,"_29907":133206,"_3297":133324},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3844":79541,"_33198":79501,"_22654":133326,"_5":15607,"_29907":133210,"_3297":133327},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3844":79542,"_33198":79501,"_22654":133329,"_5":15607,"_29907":133214,"_3297":133330},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3844":79543,"_33198":79501,"_22654":133332,"_5":15607,"_29907":133214,"_3297":133333},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3844":79544,"_33198":79501,"_22654":133335,"_5":15607,"_29907":133214,"_3297":133336},[],"`ST`: estado o provincia.",{"_3844":79545,"_33198":79501,"_22654":133338,"_5":15607,"_29907":133214,"_3297":133339},[],"`L`: localidad.",{"_3844":79546,"_33198":79501,"_22654":133341,"_5":15607,"_29907":133214,"_3297":133342},[],"`O`: organización.",{"_3844":79547,"_33198":79501,"_22654":133344,"_5":15607,"_29907":133214,"_3297":133345},[],"`OU`: unidad organizativa.",{"_3844":79548,"_33198":79501,"_22654":133347,"_5":15607,"_29907":133214,"_3297":133348},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3844":79549,"_33198":79501,"_22654":133350,"_5":15607,"_29907":133218,"_3297":133351},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3844":79550,"_33198":79501,"_22654":133353,"_5":15607,"_29907":133218,"_3297":133354},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3844":79551,"_33198":79501,"_22654":133356,"_5":15607,"_29907":133222,"_3297":133357},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3844":79552,"_33198":79501,"_22654":133359,"_5":15607,"_29907":133222,"_3297":133360},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3844":79553,"_33198":79501,"_22654":133362,"_5":15607,"_29907":133226,"_3297":133363},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3844":79554,"_33198":79501,"_22654":133365,"_5":15607,"_29907":133226,"_3297":133366},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3844":79555,"_33198":79501,"_22654":133368,"_5":15607,"_29907":133230,"_3297":133369},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3844":79556,"_33198":79501,"_22654":133371,"_5":15607,"_29907":133230,"_3297":133372},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3844":79557,"_33198":79501,"_22654":133374,"_5":15607,"_29907":133230,"_3297":133375},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3844":79558,"_33198":79501,"_22654":133377,"_5":15607,"_29907":133234,"_3297":133378},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3844":79559,"_33198":79501,"_22654":133380,"_5":15607,"_29907":133238,"_3297":133381},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3844":79560,"_33198":79501,"_22654":133383,"_5":15607,"_29907":133242,"_3297":133384},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3844":79561,"_33198":79501,"_22654":133386,"_5":15607,"_29907":133246,"_3297":133387},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3844":79562,"_33198":79501,"_22654":133389,"_5":15607,"_29907":133246,"_3297":133390},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3844":79563,"_33198":79501,"_22654":133392,"_5":15607,"_29907":133250,"_3297":133393},[],"Abre una CA desde el inventario para consultar:",{"_3844":79564,"_33198":79501,"_22654":133395,"_5":15607,"_29907":133250,"_3297":133396},[],"Estado y periodo de validez.",{"_3844":79565,"_33198":79501,"_22654":133398,"_5":15607,"_29907":133250,"_3297":133399},[],"Certificado y cadena en formato PEM.",{"_3844":79566,"_33198":79501,"_22654":133401,"_5":15607,"_29907":133250,"_3297":133402},[],"Número de certificados activos, expirados y revocados.",{"_3844":79567,"_33198":79501,"_22654":133404,"_5":15607,"_29907":133250,"_3297":133405},[],"Certificados emitidos en **Issued Certificates**.",{"_3844":79568,"_33198":79501,"_22654":133407,"_5":15607,"_29907":133250,"_3297":133408},[],"CRL vinculada a la autoridad.",{"_3844":79569,"_33198":79501,"_22654":133410,"_5":15607,"_29907":133250,"_3297":133411},[],"Metadatos y motor criptográfico asociado.",{"_3844":79570,"_33198":79501,"_22654":133413,"_5":15607,"_29907":133250,"_3297":133414},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3844":79571,"_33198":79501,"_22654":133416,"_5":15607,"_29907":133254,"_3297":133417},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3844":79572,"_33198":79501,"_22654":133419,"_5":15607,"_29907":133254,"_3297":133420},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3844":79573,"_33198":79501,"_22654":133422,"_5":15607,"_29907":133254,"_3297":133423},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3844":79574,"_33198":79501,"_22654":133425,"_5":15607,"_29907":133254,"_3297":133426},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3844":79575,"_33198":79501,"_22654":133428,"_5":15607,"_29907":133258,"_3297":133429},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3844":79576,"_33198":79501,"_22654":133431,"_5":15607,"_29907":133262,"_3297":133432},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3844":79577,"_33198":79501,"_22654":133434,"_5":15607,"_29907":133266,"_3297":133435},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3844":79578,"_33198":79501,"_22654":133437,"_5":15607,"_29907":133270,"_3297":133438},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3844":79579,"_33198":79501,"_22654":133440,"_5":15607,"_29907":133274,"_3297":133441},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3844":79580,"_33198":79501,"_22654":133443,"_5":15607,"_29907":133278,"_3297":133444},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3844":79581,"_33198":79501,"_22654":133446,"_5":15607,"_29907":133278,"_3297":133447},[],"El rol VA de la CA se conserva. Si no queda otra CA con el mismo SKI, deja de ser editable (consulta CRL), así que ajusta antes su validez y su firmante. La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3844":79582,"_33198":79501,"_22654":133449,"_5":15607,"_29907":133278,"_3297":133450},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. Si el certificado nuevo usa la misma clave, comparte el SKI con el rol VA retenido de la CA eliminada, cuyo firmante es el certificado antiguo: comprueba que la CRL se genera y, si no es así, asigna con `PUT` un firmante de la CA nueva (consulta CRL).",{"_3844":79583,"_33198":79583,"_5":16006,"_3297":133452,"_33604":133453,"_22654":133454,"_29907":79583},"Perfiles de certificado",[54402,129149,59872,133024],[],{"_3844":79584,"_33198":79583,"_22654":133456,"_5":15607,"_29907":79583,"_3297":133457},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3844":79585,"_33198":79583,"_5":33601,"_22654":133459,"_29907":133460,"_3297":133461},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3844":79586,"_33198":79583,"_5":33601,"_22654":133463,"_29907":133464,"_3297":133465},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#validez","Validez",{"_3844":79587,"_33198":79583,"_5":33601,"_22654":133467,"_29907":133468,"_3297":133469},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3844":79588,"_33198":79583,"_5":33601,"_22654":133471,"_29907":133472,"_3297":133473},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3844":79589,"_33198":79583,"_5":33601,"_22654":133475,"_29907":133476,"_3297":133477},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3844":79590,"_33198":79583,"_5":33601,"_22654":133479,"_29907":133480,"_3297":133481},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3844":79591,"_33198":79583,"_5":33601,"_22654":133483,"_29907":133484,"_3297":133485},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3844":79592,"_33198":79583,"_5":33601,"_22654":133487,"_29907":133488,"_3297":133489},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3844":79593,"_33198":79583,"_5":33601,"_22654":133491,"_29907":133492,"_3297":133493},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3844":79594,"_33198":79583,"_5":33601,"_22654":133495,"_29907":133496,"_3297":133497},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3844":79595,"_33198":79583,"_5":33601,"_22654":133499,"_29907":133500,"_3297":133501},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3844":79596,"_33198":79583,"_5":33601,"_22654":133503,"_29907":133504,"_3297":133505},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3844":79597,"_33198":79583,"_5":33601,"_22654":133507,"_29907":133508,"_3297":133509},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3844":79598,"_33198":79583,"_5":33601,"_22654":133511,"_29907":133512,"_3297":133513},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3844":79599,"_33198":79583,"_5":33601,"_22654":133515,"_29907":133516,"_3297":133517},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3844":79600,"_33198":79583,"_5":33601,"_22654":133519,"_29907":133520,"_3297":133521},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3844":79601,"_33198":79583,"_22654":133523,"_5":15607,"_29907":79583,"_3297":133524},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3844":79602,"_33198":79583,"_22654":133526,"_5":15607,"_29907":79583,"_3297":133527},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3844":79603,"_33198":79583,"_22654":133529,"_5":15607,"_29907":133464,"_3297":133530},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3844":79604,"_33198":79583,"_22654":133532,"_5":15607,"_29907":133464,"_3297":133533},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3844":79605,"_33198":79583,"_22654":133535,"_5":15607,"_29907":133468,"_3297":133536},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3844":79606,"_33198":79583,"_22654":133538,"_5":15607,"_29907":133472,"_3297":133539},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3844":79607,"_33198":79583,"_22654":133541,"_5":15607,"_29907":133472,"_3297":133542},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3844":79608,"_33198":79583,"_22654":133544,"_5":15607,"_29907":133472,"_3297":133545},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3844":79609,"_33198":79583,"_22654":133547,"_5":15607,"_29907":133476,"_3297":133548},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3844":79610,"_33198":79583,"_22654":133550,"_5":15607,"_29907":133480,"_3297":133551},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3844":79611,"_33198":79583,"_22654":133553,"_5":15607,"_29907":133480,"_3297":133554},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3844":79612,"_33198":79583,"_22654":133556,"_5":15607,"_29907":133484,"_3297":133557},[],"La aplicación criptográfica puede:",{"_3844":79613,"_33198":79583,"_22654":133559,"_5":15607,"_29907":133484,"_3297":133560},[],"permitir o bloquear claves RSA;",{"_3844":79614,"_33198":79583,"_22654":133562,"_5":15607,"_29907":133484,"_3297":133563},[],"limitar los tamaños RSA admitidos;",{"_3844":79615,"_33198":79583,"_22654":133565,"_5":15607,"_29907":133484,"_3297":133566},[],"permitir o bloquear claves ECDSA;",{"_3844":79616,"_33198":79583,"_22654":133568,"_5":15607,"_29907":133484,"_3297":133569},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3844":79617,"_33198":79583,"_22654":133571,"_5":15607,"_29907":133484,"_3297":133572},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3844":79618,"_33198":79583,"_22654":133574,"_5":15607,"_29907":133488,"_3297":133575},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3844":79619,"_33198":79583,"_22654":133577,"_5":15607,"_29907":133488,"_3297":128909},[],{"_3844":79620,"_33198":79583,"_22654":133579,"_5":15607,"_29907":133488,"_3297":133580},[],"Primera opción",{"_3844":79621,"_33198":79583,"_22654":133582,"_5":15607,"_29907":133488,"_3297":133583},[],"Segunda opción",{"_3844":79622,"_33198":79583,"_22654":133585,"_5":15607,"_29907":133488,"_3297":133586},[],"Si no hay ninguna",{"_3844":79623,"_33198":79583,"_22654":133588,"_5":15607,"_29907":133488,"_3297":133589},[],"Firma directa con una CA",{"_3844":79624,"_33198":79583,"_22654":133591,"_5":15607,"_29907":133488,"_3297":133592},[],"`issuance_profile` incluido en la solicitud",{"_3844":79625,"_33198":79583,"_22654":133594,"_5":15607,"_29907":133488,"_3297":133595},[],"`issuance_profile_id` de la solicitud",{"_3844":79626,"_33198":79583,"_22654":133597,"_5":15607,"_29907":133488,"_3297":133598},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3844":79627,"_33198":79583,"_22654":133600,"_5":15607,"_29907":133488,"_3297":133601},[],"Emisión mediante DMS",{"_3844":79628,"_33198":79583,"_22654":133603,"_5":15607,"_29907":133488,"_3297":60453},[],{"_3844":79629,"_33198":79583,"_22654":133605,"_5":15607,"_29907":133488,"_3297":133606},[],"`settings.issuance_profile` incluido en el DMS",{"_3844":79630,"_33198":79583,"_22654":133608,"_5":15607,"_29907":133488,"_3297":133609},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3844":79631,"_33198":79583,"_22654":133611,"_5":15607,"_29907":133488,"_3297":133612},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3844":79632,"_33198":79583,"_22654":133614,"_5":15607,"_29907":133488,"_3297":133615},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3844":79633,"_33198":79583,"_22654":133617,"_5":15607,"_29907":133496,"_3297":133618},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3844":79634,"_33198":79583,"_22654":133620,"_5":15607,"_29907":133500,"_3297":133621},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3844":79635,"_33198":79583,"_22654":133623,"_5":15607,"_29907":133504,"_3297":133624},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3844":79636,"_33198":79583,"_22654":133626,"_5":15607,"_29907":133508,"_3297":133627},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3844":79637,"_33198":79583,"_22654":133629,"_5":15607,"_29907":133512,"_3297":133630},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3844":79638,"_33198":79583,"_22654":133632,"_5":15607,"_29907":133512,"_3297":133633},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3844":79639,"_33198":79583,"_22654":133635,"_5":15607,"_29907":133516,"_3297":133636},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3844":79640,"_33198":79583,"_22654":133638,"_5":15607,"_29907":133516,"_3297":133639},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3844":79641,"_33198":79583,"_22654":133641,"_5":15607,"_29907":133516,"_3297":133642},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3844":79642,"_33198":79583,"_22654":133644,"_5":15607,"_29907":133516,"_3297":133645},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3844":79643,"_33198":79583,"_22654":133647,"_5":15607,"_29907":133520,"_3297":133648},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3844":79644,"_33198":79583,"_22654":133650,"_5":15607,"_29907":133520,"_3297":133651},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3844":79645,"_33198":79645,"_5":16006,"_3297":133653,"_33604":133654,"_22654":133656,"_29907":79645},"Validación de certificados",[54402,129149,59872,133655],"Validación",[],{"_3844":79646,"_33198":79645,"_22654":133658,"_5":15607,"_29907":79645,"_3297":133659},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3844":79647,"_33198":79645,"_5":33601,"_22654":133661,"_29907":133662,"_3297":133663},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3844":79648,"_33198":79645,"_5":33601,"_22654":133665,"_29907":133666,"_3297":133667},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3844":79649,"_33198":79645,"_5":33601,"_22654":133669,"_29907":133670,"_3297":133671},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3844":79650,"_33198":79645,"_22654":133673,"_5":15607,"_29907":79645,"_3297":133674},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3844":79651,"_33198":79645,"_22654":133676,"_5":15607,"_29907":133662,"_3297":133677},[],"Verifica estos criterios juntos:",{"_3844":79652,"_33198":79645,"_22654":133679,"_5":15607,"_29907":133662,"_3297":132653},[],{"_3844":79653,"_33198":79645,"_22654":133681,"_5":15607,"_29907":133662,"_3297":133682},[],"Resultado necesario",{"_3844":79654,"_33198":79645,"_22654":133684,"_5":15607,"_29907":133662,"_3297":133685},[],"Cadena y firma",{"_3844":79655,"_33198":79645,"_22654":133687,"_5":15607,"_29907":133662,"_3297":133688},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3844":79656,"_33198":79645,"_22654":133690,"_5":15607,"_29907":133662,"_3297":133691},[],"Fechas",{"_3844":79657,"_33198":79645,"_22654":133693,"_5":15607,"_29907":133662,"_3297":133694},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3844":79658,"_33198":79645,"_22654":133696,"_5":15607,"_29907":133662,"_3297":128819},[],{"_3844":79659,"_33198":79645,"_22654":133698,"_5":15607,"_29907":133662,"_3297":133699},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3844":79660,"_33198":79645,"_22654":133701,"_5":15607,"_29907":133662,"_3297":133702},[],"Uso",{"_3844":79661,"_33198":79645,"_22654":133704,"_5":15607,"_29907":133662,"_3297":133705},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3844":79662,"_33198":79645,"_22654":133707,"_5":15607,"_29907":133662,"_3297":133708},[],"Revocación",{"_3844":79663,"_33198":79645,"_22654":133710,"_5":15607,"_29907":133662,"_3297":133711},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3844":79664,"_33198":79645,"_22654":133713,"_5":15607,"_29907":133662,"_3297":133714},[],"Autorización",{"_3844":79665,"_33198":79645,"_22654":133716,"_5":15607,"_29907":133662,"_3297":133717},[],"La aplicación permite la acción a esa identidad.",{"_3844":79666,"_33198":79645,"_22654":133719,"_5":15607,"_29907":133662,"_3297":133720},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3844":79667,"_33198":79645,"_22654":133722,"_5":15607,"_29907":133666,"_3297":133723},[],"Mecanismo",{"_3844":79668,"_33198":79645,"_22654":133725,"_5":15607,"_29907":133666,"_3297":133726},[],"Cuándo utilizarlo",{"_3844":79669,"_33198":79645,"_22654":133728,"_5":15607,"_29907":133666,"_3297":133729},[],"Qué debes mantener",{"_3844":79670,"_33198":79645,"_22654":133731,"_5":15607,"_29907":133666,"_3297":60581},[],{"_3844":79671,"_33198":79645,"_22654":133733,"_5":15607,"_29907":133666,"_3297":133734},[],"Consulta del estado de un certificado concreto.",{"_3844":79672,"_33198":79645,"_22654":133736,"_5":15607,"_29907":133666,"_3297":133737},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3844":79673,"_33198":79645,"_22654":133739,"_5":15607,"_29907":133666,"_3297":60590},[],{"_3844":79674,"_33198":79645,"_22654":133741,"_5":15607,"_29907":133666,"_3297":133742},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3844":79675,"_33198":79645,"_22654":133744,"_5":15607,"_29907":133666,"_3297":133745},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3844":79676,"_33198":79645,"_22654":133747,"_5":15607,"_29907":133666,"_3297":133748},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3844":79677,"_33198":79645,"_22654":133750,"_5":15607,"_29907":133666,"_3297":133751},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3844":79678,"_33198":79645,"_22654":133753,"_5":15607,"_29907":133670,"_3297":133754},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3844":79679,"_33198":79645,"_22654":133756,"_5":15607,"_29907":133670,"_3297":133757},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3844":79680,"_33198":79645,"_22654":133759,"_5":15607,"_29907":133670,"_3297":133760},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3844":79681,"_33198":79645,"_22654":133762,"_5":15607,"_29907":133670,"_3297":133763},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3844":79682,"_33198":79645,"_22654":133765,"_5":15607,"_29907":133670,"_3297":133766},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3844":79683,"_33198":79645,"_22654":133768,"_5":15607,"_29907":133670,"_3297":133769},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3844":79684,"_33198":79645,"_22654":133771,"_5":15607,"_29907":133670,"_3297":133772},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3844":79685,"_33198":79645,"_22654":133774,"_5":15607,"_29907":133670,"_3297":133775},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3844":79686,"_33198":79645,"_22654":133777,"_5":15607,"_29907":133670,"_3297":133778},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3844":79687,"_33198":79687,"_5":16006,"_3297":133780,"_33604":133781,"_22654":133782,"_29907":79687},"Certificados",[54402,129149,59872,133024],[],{"_3844":79688,"_33198":79687,"_22654":133784,"_5":15607,"_29907":79687,"_3297":133785},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3844":79689,"_33198":79687,"_5":33601,"_22654":133787,"_29907":133788,"_3297":133789},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3844":79690,"_33198":79687,"_5":33601,"_22654":133791,"_29907":133792,"_3297":133793},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3844":79691,"_33198":79687,"_5":33601,"_22654":133795,"_29907":133796,"_3297":133797},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3844":79692,"_33198":79687,"_5":33601,"_22654":133799,"_29907":133800,"_3297":133801},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3844":79693,"_33198":79687,"_5":33601,"_22654":133803,"_29907":133804,"_3297":133805},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3844":79694,"_33198":79687,"_5":33601,"_22654":133807,"_29907":133808,"_3297":133809},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3844":79695,"_33198":79687,"_5":33601,"_22654":133811,"_29907":133812,"_3297":133813},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3844":79696,"_33198":79687,"_5":33601,"_22654":133815,"_29907":133816,"_3297":133817},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3844":79697,"_33198":79687,"_5":33601,"_22654":133819,"_29907":133820,"_3297":133821},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#continúa","Continúa",{"_3844":79698,"_33198":79687,"_22654":133823,"_5":15607,"_29907":79687,"_3297":133824},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3844":79699,"_33198":79687,"_22654":133826,"_5":15607,"_29907":133788,"_3297":133827},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3844":79700,"_33198":79687,"_22654":133829,"_5":15607,"_29907":133788,"_3297":133830},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3844":79701,"_33198":79687,"_22654":133832,"_5":15607,"_29907":133788,"_3297":133833},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3844":79702,"_33198":79687,"_22654":133835,"_5":15607,"_29907":133788,"_3297":133836},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3844":79703,"_33198":79687,"_22654":133838,"_5":15607,"_29907":133788,"_3297":133839},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3844":79704,"_33198":79687,"_22654":133841,"_5":15607,"_29907":133788,"_3297":133842},[],"Los detalles del certificado incluyen la referencia a la clave (`key_id`) y si la clave privada está gestionada (`has_private_key`); las listas de certificados pueden filtrarse por `has_private_key`.",{"_3844":79705,"_33198":79687,"_22654":133844,"_5":15607,"_29907":133788,"_3297":133845},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3844":79706,"_33198":79687,"_22654":133847,"_5":15607,"_29907":133792,"_3297":133848},[],"Descarga el PEM e inspecciónalo:",{"_3844":79707,"_33198":79687,"_22654":133850,"_5":15607,"_29907":133792,"_3297":133851},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3844":79708,"_33198":79687,"_22654":133853,"_5":15607,"_29907":133796,"_3297":133854},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3844":79709,"_33198":79687,"_22654":133856,"_5":15607,"_29907":133796,"_3297":133857},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3844":79710,"_33198":79687,"_22654":133859,"_5":15607,"_29907":133796,"_3297":133860},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3844":79711,"_33198":79687,"_22654":133862,"_5":15607,"_29907":133796,"_3297":133863},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3844":79712,"_33198":79687,"_22654":133865,"_5":15607,"_29907":133796,"_3297":133866},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3844":79713,"_33198":79687,"_22654":133868,"_5":15607,"_29907":133796,"_3297":133869},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3844":79714,"_33198":79687,"_22654":133871,"_5":15607,"_29907":133796,"_3297":133872},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3844":79715,"_33198":79687,"_22654":133874,"_5":15607,"_29907":133800,"_3297":133875},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3844":79716,"_33198":79687,"_22654":133877,"_5":15607,"_29907":133804,"_3297":133878},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3844":79717,"_33198":79687,"_22654":133880,"_5":15607,"_29907":133808,"_3297":133881},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3844":79718,"_33198":79687,"_22654":133883,"_5":15607,"_29907":133812,"_3297":133884},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3844":79719,"_33198":79687,"_22654":133886,"_5":15607,"_29907":133812,"_3297":133887},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3844":79720,"_33198":79687,"_22654":133889,"_5":15607,"_29907":133812,"_3297":133890},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3844":79721,"_33198":79687,"_22654":133892,"_5":15607,"_29907":133816,"_3297":133893},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3844":79722,"_33198":79687,"_22654":133895,"_5":15607,"_29907":133816,"_3297":133896},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3844":79723,"_33198":79687,"_22654":133898,"_5":15607,"_29907":133816,"_3297":133899},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3844":79724,"_33198":79687,"_22654":133901,"_5":15607,"_29907":133820,"_3297":133902},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3844":79725,"_33198":79687,"_22654":133904,"_5":15607,"_29907":133820,"_3297":133905},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3844":79726,"_33198":79726,"_5":16006,"_3297":133907,"_33604":133908,"_22654":133910,"_29907":79726},"Ciclo de vida de un certificado",[54402,129149,59872,133909],"Conceptos",[],{"_3844":79727,"_33198":79726,"_22654":133912,"_5":15607,"_29907":79726,"_3297":133913},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3844":79728,"_33198":79726,"_5":33601,"_22654":133915,"_29907":133916,"_3297":133917},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3844":79729,"_33198":79726,"_5":33601,"_22654":133919,"_29907":133920,"_3297":133921},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3844":79730,"_33198":79726,"_5":33601,"_22654":133923,"_29907":133924,"_3297":133925},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3844":79731,"_33198":79726,"_5":33601,"_22654":133927,"_29907":133928,"_3297":133929},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3844":79732,"_33198":79726,"_5":33601,"_22654":133931,"_29907":133932,"_3297":133933},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3844":79733,"_33198":79726,"_5":33601,"_22654":133935,"_29907":133936,"_3297":133937},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3844":79734,"_33198":79726,"_5":33601,"_22654":133939,"_29907":133940,"_3297":131647},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3844":79735,"_33198":79726,"_5":33601,"_22654":133942,"_29907":133943,"_3297":133944},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3844":79736,"_33198":79726,"_5":33601,"_22654":133946,"_29907":133947,"_3297":133948},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3844":79737,"_33198":79726,"_5":33601,"_22654":133950,"_29907":133951,"_3297":133952},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3844":79738,"_33198":79726,"_22654":133954,"_5":15607,"_29907":79726,"_3297":133955},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3844":79739,"_33198":79726,"_22654":133957,"_5":15607,"_29907":133920,"_3297":133958},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3844":79740,"_33198":79726,"_22654":133960,"_5":15607,"_29907":133924,"_3297":133961},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3844":79741,"_33198":79726,"_22654":133963,"_5":15607,"_29907":133928,"_3297":133964},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3844":79742,"_33198":79726,"_22654":133966,"_5":15607,"_29907":133932,"_3297":133967},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3844":79743,"_33198":79726,"_22654":133969,"_5":15607,"_29907":133936,"_3297":133970},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3844":79744,"_33198":79726,"_22654":133972,"_5":15607,"_29907":133940,"_3297":133973},[],"Lamassu persiste cuatro estados X.509:",{"_3844":79745,"_33198":79726,"_22654":133975,"_5":15607,"_29907":133940,"_3297":133976},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3844":79746,"_33198":79726,"_22654":133978,"_5":15607,"_29907":133940,"_3297":133979},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3844":79747,"_33198":79726,"_22654":133981,"_5":15607,"_29907":133940,"_3297":133982},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3844":79748,"_33198":79726,"_22654":133984,"_5":15607,"_29907":133940,"_3297":133985},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3844":79749,"_33198":79726,"_22654":133987,"_5":15607,"_29907":133940,"_3297":133988},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3844":79750,"_33198":79726,"_22654":133990,"_5":15607,"_29907":133943,"_3297":133991},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3844":79751,"_33198":79726,"_22654":133993,"_5":15607,"_29907":133943,"_3297":133994},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3844":79752,"_33198":79726,"_22654":133996,"_5":15607,"_29907":133943,"_3297":133997},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3844":79753,"_33198":79726,"_22654":133999,"_5":15607,"_29907":133947,"_3297":134000},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3844":79754,"_33198":79726,"_22654":134002,"_5":15607,"_29907":133947,"_3297":134003},[],"Antes de confirmar:",{"_3844":79755,"_33198":79726,"_22654":134005,"_5":15607,"_29907":133947,"_3297":134006},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3844":79756,"_33198":79726,"_22654":134008,"_5":15607,"_29907":133947,"_3297":134009},[],"Distribuye la nueva cadena de confianza.",{"_3844":79757,"_33198":79726,"_22654":134011,"_5":15607,"_29907":133947,"_3297":134012},[],"Reemite las identidades necesarias.",{"_3844":79758,"_33198":79726,"_22654":134014,"_5":15607,"_29907":133947,"_3297":134015},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3844":79759,"_33198":79726,"_22654":134017,"_5":15607,"_29907":133947,"_3297":134018},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3844":79760,"_33198":79726,"_22654":134020,"_5":15607,"_29907":133947,"_3297":134021},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3844":79761,"_33198":79726,"_22654":134023,"_5":15607,"_29907":133951,"_3297":134024},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3844":79762,"_33198":79726,"_22654":134026,"_5":15607,"_29907":133951,"_3297":134027},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3844":79763,"_33198":79726,"_22654":134029,"_5":15607,"_29907":133951,"_3297":134030},[],"Cambios de estado y razones de revocación.",{"_3844":79764,"_33198":79726,"_22654":134032,"_5":15607,"_29907":133951,"_3297":134033},[],"Publicación y vigencia de OCSP y CRLs.",{"_3844":79765,"_33198":79726,"_22654":134035,"_5":15607,"_29907":133951,"_3297":134036},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3844":79766,"_33198":79726,"_22654":134038,"_5":15607,"_29907":133951,"_3297":134039},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3844":79767,"_33198":79767,"_5":16006,"_3297":134041,"_33604":134042,"_22654":134043,"_29907":79767},"Modelo de confianza",[54402,129149,59872,133909],[],{"_3844":79768,"_33198":79767,"_22654":134045,"_5":15607,"_29907":79767,"_3297":134046},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3844":79769,"_33198":79767,"_5":33601,"_22654":134048,"_29907":134049,"_3297":134050},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3844":79770,"_33198":79767,"_5":33601,"_22654":134052,"_29907":134053,"_3297":134054},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3844":79771,"_33198":79767,"_5":33601,"_22654":134056,"_29907":134057,"_3297":134058},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3844":79772,"_33198":79767,"_5":33601,"_22654":134060,"_29907":134061,"_3297":134062},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3844":79773,"_33198":79767,"_5":33601,"_22654":134064,"_29907":134065,"_3297":134066},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3844":79774,"_33198":79767,"_5":33601,"_22654":134068,"_29907":134069,"_3297":134070},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3844":79775,"_33198":79767,"_5":33601,"_22654":134072,"_29907":134073,"_3297":134074},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3844":79776,"_33198":79767,"_5":33601,"_22654":134076,"_29907":134077,"_3297":134078},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3844":79777,"_33198":79767,"_5":33601,"_22654":134080,"_29907":134081,"_3297":134082},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3844":79778,"_33198":79767,"_5":33601,"_22654":134084,"_29907":134085,"_3297":134086},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3844":79779,"_33198":79767,"_22654":134088,"_5":15607,"_29907":79767,"_3297":134089},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3844":79780,"_33198":79767,"_22654":134091,"_5":15607,"_29907":134053,"_3297":134092},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3844":79781,"_33198":79767,"_22654":134094,"_5":15607,"_29907":134057,"_3297":134095},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3844":79782,"_33198":79767,"_22654":134097,"_5":15607,"_29907":134061,"_3297":134098},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3844":79783,"_33198":79767,"_22654":134100,"_5":15607,"_29907":134065,"_3297":134101},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3844":79784,"_33198":79767,"_22654":134103,"_5":15607,"_29907":134069,"_3297":134104},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3844":79785,"_33198":79767,"_22654":134106,"_5":15607,"_29907":134069,"_3297":134107},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3844":79786,"_33198":79767,"_22654":134109,"_5":15607,"_29907":134069,"_3297":134110},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3844":79787,"_33198":79767,"_22654":134112,"_5":15607,"_29907":134069,"_3297":134113},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3844":79788,"_33198":79767,"_22654":134115,"_5":15607,"_29907":134069,"_3297":134116},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3844":79789,"_33198":79767,"_22654":134118,"_5":15607,"_29907":134069,"_3297":134119},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3844":79790,"_33198":79767,"_22654":134121,"_5":15607,"_29907":134073,"_3297":134122},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3844":79791,"_33198":79767,"_22654":134124,"_5":15607,"_29907":134073,"_3297":134125},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3844":79792,"_33198":79767,"_22654":134127,"_5":15607,"_29907":134073,"_3297":134128},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3844":79793,"_33198":79767,"_22654":134130,"_5":15607,"_29907":134073,"_3297":134131},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3844":79794,"_33198":79767,"_22654":134133,"_5":15607,"_29907":134073,"_3297":134134},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3844":79795,"_33198":79767,"_22654":134136,"_5":15607,"_29907":134077,"_3297":134137},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3844":79796,"_33198":79767,"_22654":134139,"_5":15607,"_29907":134077,"_3297":134140},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3844":79797,"_33198":79767,"_22654":134142,"_5":15607,"_29907":134077,"_3297":134143},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3844":79798,"_33198":79767,"_22654":134145,"_5":15607,"_29907":134077,"_3297":134146},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3844":79799,"_33198":79767,"_22654":134148,"_5":15607,"_29907":134077,"_3297":134149},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3844":79800,"_33198":79767,"_22654":134151,"_5":15607,"_29907":134077,"_3297":134152},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3844":79801,"_33198":79767,"_22654":134154,"_5":15607,"_29907":134077,"_3297":134155},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3844":79802,"_33198":79767,"_22654":134157,"_5":15607,"_29907":134081,"_3297":134158},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3844":79803,"_33198":79767,"_22654":134160,"_5":15607,"_29907":134085,"_3297":134161},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3844":79804,"_33198":79767,"_22654":134163,"_5":15607,"_29907":134085,"_3297":134164},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3844":79805,"_33198":79767,"_22654":134166,"_5":15607,"_29907":134085,"_3297":134167},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3844":79806,"_33198":79767,"_22654":134169,"_5":15607,"_29907":134085,"_3297":134170},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3844":79807,"_33198":79767,"_22654":134172,"_5":15607,"_29907":134085,"_3297":134173},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3844":79808,"_33198":79767,"_22654":134175,"_5":15607,"_29907":134085,"_3297":134176},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3844":79809,"_33198":79767,"_22654":134178,"_5":15607,"_29907":134085,"_3297":134179},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3844":79810,"_33198":79810,"_5":16006,"_3297":134181,"_33604":134182,"_22654":134183,"_29907":79810},"Listas de revocación (CRL)",[54402,129149,59872,133655],[],{"_3844":79811,"_33198":79810,"_22654":134185,"_5":15607,"_29907":79810,"_3297":134186},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3844":79812,"_33198":79810,"_5":33601,"_22654":134188,"_29907":134189,"_3297":134190},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3844":79813,"_33198":79810,"_5":33601,"_22654":134192,"_29907":134193,"_3297":134194},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3844":79814,"_33198":79810,"_5":33601,"_22654":134196,"_29907":134197,"_3297":134198},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3844":79815,"_33198":79810,"_5":33601,"_22654":134200,"_29907":134201,"_3297":134202},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3844":79816,"_33198":79810,"_5":33601,"_22654":134204,"_29907":134205,"_3297":134206},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3844":79817,"_33198":79810,"_5":33601,"_22654":134208,"_29907":134209,"_3297":134210},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3844":79818,"_33198":79810,"_5":33601,"_22654":134212,"_29907":134213,"_3297":134214},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#errores-frecuentes-del-rol-va","Errores frecuentes del rol VA",{"_3844":79819,"_33198":79810,"_5":33601,"_22654":134216,"_29907":134217,"_3297":134218},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3844":79820,"_33198":79810,"_5":33601,"_22654":134220,"_29907":134221,"_3297":134222},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#referencias","Referencias",{"_3844":79821,"_33198":79810,"_22654":134224,"_5":15607,"_29907":79810,"_3297":134225},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3844":79822,"_33198":79810,"_22654":134227,"_5":15607,"_29907":134189,"_3297":134228},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3844":79823,"_33198":79810,"_22654":134230,"_5":15607,"_29907":134189,"_3297":134231},[],"Campo de `crl_options`",{"_3844":79824,"_33198":79810,"_22654":134233,"_5":15607,"_29907":134189,"_3297":130687},[],{"_3844":79825,"_33198":79810,"_22654":134235,"_5":15607,"_29907":134189,"_3297":134236},[],"Valor inicial del backend",{"_3844":79826,"_33198":79810,"_22654":134238,"_5":15607,"_29907":134189,"_3297":61091},[],{"_3844":79827,"_33198":79810,"_22654":134240,"_5":15607,"_29907":134189,"_3297":134241},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3844":79828,"_33198":79810,"_22654":134243,"_5":15607,"_29907":134189,"_3297":134244},[],"7 días.",{"_3844":79829,"_33198":79810,"_22654":134246,"_5":15607,"_29907":134189,"_3297":61100},[],{"_3844":79830,"_33198":79810,"_22654":134248,"_5":15607,"_29907":134189,"_3297":134249},[],"Se guarda y se devuelve por la API, pero la VA no lo utiliza: la renovación programada no depende de él (consulta Regeneración periódica y automática).",{"_3844":79831,"_33198":79810,"_22654":134251,"_5":15607,"_29907":134189,"_3297":134252},[],"6 días y 23 horas.",{"_3844":79832,"_33198":79810,"_22654":134254,"_5":15607,"_29907":134189,"_3297":61109},[],{"_3844":79833,"_33198":79810,"_22654":134256,"_5":15607,"_29907":134189,"_3297":134257},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3844":79834,"_33198":79810,"_22654":134259,"_5":15607,"_29907":134189,"_3297":61115},[],{"_3844":79835,"_33198":79810,"_22654":134261,"_5":15607,"_29907":134189,"_3297":61118},[],{"_3844":79836,"_33198":79810,"_22654":134263,"_5":15607,"_29907":134189,"_3297":134264},[],"Número de serie del certificado existente que firma la CRL.",{"_3844":79837,"_33198":79810,"_22654":134266,"_5":15607,"_29907":134189,"_3297":134267},[],"Número de serie del certificado actual de la CA.",{"_3844":79838,"_33198":79810,"_22654":134269,"_5":15607,"_29907":134189,"_3297":134270},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3844":79839,"_33198":79810,"_22654":134272,"_5":15607,"_29907":134189,"_3297":134273},[],"Al reemitir una CA, el rol sigue apuntando al certificado anterior. Las CRL siguen siendo válidas porque ambos certificados comparten sujeto y clave, pero el certificado anterior no puede eliminarse mientras el rol lo use. Para retirarlo, actualiza el firmante del rol.",{"_3844":79840,"_33198":79810,"_22654":134275,"_5":15607,"_29907":134189,"_3297":134276},[],"Al eliminar una CA, su rol VA se conserva y no puede borrarse por API. Si no queda ninguna otra CA con el mismo SKI, el rol puede consultarse pero cualquier `PUT` devuelve 404, y el trabajo de renovación registra un aviso en cada ciclo porque ya no encuentra la CA. La API no ofrece salida; solo se corrige editando la base de datos. Si queda otra CA con ese SKI, el rol sigue siendo editable (consulta CAs que comparten clave). Ajusta validez y firmante antes de eliminar la CA.",{"_3844":79841,"_33198":79810,"_22654":134278,"_5":15607,"_29907":134189,"_3297":134279},[],"Una CA cuyo certificado no tiene `cRLSign` no puede generar su CRL ni editar su rol (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y asígnalo como firmante con `PUT`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original.",{"_3844":79842,"_33198":79810,"_22654":134281,"_5":15607,"_29907":134189,"_3297":134282},[],"El `PUT` valida siempre el firmante, aunque la petición no lo cambie. Si el firmante guardado ya no es válido, no se puede modificar ningún campo del rol, ni siquiera la validez, hasta asignar uno válido.",{"_3844":79843,"_33198":79810,"_22654":134284,"_5":15607,"_29907":134189,"_3297":134285},[],"Compartir una clave entre CA puede impedir la validación de las CRL. Consulta CAs que comparten clave.",{"_3844":79844,"_33198":79810,"_22654":134287,"_5":15607,"_29907":134189,"_3297":134288},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3844":79845,"_33198":79810,"_22654":134290,"_5":15607,"_29907":134193,"_3297":134291},[],"La VA identifica cada CRL por el SKI de la CA, y el SKI se deriva de su clave. Dos CAs con la misma clave tienen el mismo SKI y comparten un único rol VA y una única CRL. Ocurre al crear una CA sobre una clave ya existente del KMS, o al importar una CA cuyo certificado declara un SKI en uso. Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. El rol lo crea la primera CA y las demás lo conservan.",{"_3844":79846,"_33198":79810,"_22654":134293,"_5":15607,"_29907":134193,"_3297":134294},[],"Los certificados de todas ellas apuntan a `/crl/{ski}`, pero la lista publicada tiene como emisor a la primera CA y solo incluye sus revocaciones. Un verificador compara el emisor de la CRL con el del certificado que valida (RFC 5280, §6.3.2) y rechaza la lista si no coinciden. Según su política, el certificado queda bloqueado (*hard-fail*) o se acepta aunque esté revocado (*soft-fail*). Las revocaciones de las CAs secundarias no aparecen en ninguna lista.",{"_3844":79847,"_33198":79810,"_22654":134296,"_5":15607,"_29907":134193,"_3297":134297},[],"Si la primera CA se elimina, la generación de CRL de la restante falla porque el firmante configurado ya no corresponde a una CA con ese nombre. Hasta que se actualice el firmante del rol a un certificado de la CA restante, se sigue sirviendo la última lista publicada hasta que venza (7 días por defecto).",{"_3844":79848,"_33198":79810,"_22654":134299,"_5":15607,"_29907":134193,"_3297":134300},[],"Antes de actualizar, revisa las CAs que comparten clave. Para detectar el problema, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos. Una CA importada con un SKI ya en uso no sustituye a la existente como emisora de la CRL, porque el emisor se resuelve a partir del firmante del rol. Sin embargo, sus propios certificados apuntan a esa misma URL y sus revocaciones no se publican. Hasta que Lamassu rechace estas importaciones, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión, así que tampoco reutilices claves entre CAs. Una CRL por CA y el rechazo de importaciones cuyo SKI colisiona con el de una CA existente están planteados en lamassuiot#834, y ninguno está implementado todavía.",{"_3844":79849,"_33198":79810,"_22654":134302,"_5":15607,"_29907":134197,"_3297":134303},[],"El trabajo programado de la VA revisa todos los roles en cada ejecución y solicita otra lista cuando a `latest_crl` le queda menos validez que el intervalo entre ejecuciones. La frecuencia se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. `refresh_interval` no interviene. Mantén `validity` claramente por encima del intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3844":79850,"_33198":79810,"_22654":134305,"_5":15607,"_29907":134197,"_3297":134306},[],"Si la generación falla (por ejemplo, por un rol sin CA o un firmante inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ski>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3844":79851,"_33198":79810,"_22654":134308,"_5":15607,"_29907":134197,"_3297":134309},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla (rol inexistente, firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3844":79852,"_33198":79810,"_22654":134311,"_5":15607,"_29907":134197,"_3297":134312},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3844":79853,"_33198":79810,"_22654":134314,"_5":15607,"_29907":134201,"_3297":134315},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3844":79854,"_33198":79810,"_22654":134317,"_5":15607,"_29907":134201,"_3297":134318},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3844":79855,"_33198":79810,"_22654":134320,"_5":15607,"_29907":134205,"_3297":134321},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3844":79856,"_33198":79810,"_22654":134323,"_5":15607,"_29907":134205,"_3297":134324},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3844":79857,"_33198":79810,"_22654":134326,"_5":15607,"_29907":134205,"_3297":134327},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando el rol apunta a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3844":79858,"_33198":79810,"_22654":134329,"_5":15607,"_29907":134205,"_3297":134330},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3844":79859,"_33198":79810,"_22654":134332,"_5":15607,"_29907":134205,"_3297":134333},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3844":79860,"_33198":79810,"_22654":134335,"_5":15607,"_29907":134209,"_3297":134336},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3844":79861,"_33198":79810,"_22654":134338,"_5":15607,"_29907":134209,"_3297":130876},[],{"_3844":79862,"_33198":79810,"_22654":134340,"_5":15607,"_29907":134209,"_3297":134341},[],"Path relativo",{"_3844":79863,"_33198":79810,"_22654":134343,"_5":15607,"_29907":134209,"_3297":128909},[],{"_3844":79864,"_33198":79810,"_22654":134345,"_5":15607,"_29907":134209,"_3297":61203},[],{"_3844":79865,"_33198":79810,"_22654":134347,"_5":15607,"_29907":134209,"_3297":61206},[],{"_3844":79866,"_33198":79810,"_22654":134349,"_5":15607,"_29907":134209,"_3297":134350},[],"Consultar `crl_options` y `latest_crl`.",{"_3844":79867,"_33198":79810,"_22654":134352,"_5":15607,"_29907":134209,"_3297":61212},[],{"_3844":79868,"_33198":79810,"_22654":134354,"_5":15607,"_29907":134209,"_3297":61206},[],{"_3844":79869,"_33198":79810,"_22654":134356,"_5":15607,"_29907":134209,"_3297":134357},[],"Sustituir la configuración de CRL.",{"_3844":79870,"_33198":79810,"_22654":134359,"_5":15607,"_29907":134209,"_3297":134360},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3844":79871,"_33198":79810,"_22654":134362,"_5":15607,"_29907":134209,"_3297":134363},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3844":79872,"_33198":79810,"_22654":134365,"_5":15607,"_29907":134213,"_3297":134366},[],"Síntoma",{"_3844":79873,"_33198":79810,"_22654":134368,"_5":15607,"_29907":134213,"_3297":134369},[],"Causa",{"_3844":79874,"_33198":79810,"_22654":134371,"_5":15607,"_29907":134213,"_3297":134372},[],"Acción",{"_3844":79875,"_33198":79810,"_22654":134374,"_5":15607,"_29907":134213,"_3297":134375},[],"`PUT /v1/roles/{ca-ski}` devuelve 404 y `GET` devuelve 200.",{"_3844":79876,"_33198":79810,"_22654":134377,"_5":15607,"_29907":134213,"_3297":134378},[],"Se eliminó la CA del rol y no queda otra con el mismo SKI.",{"_3844":79877,"_33198":79810,"_22654":134380,"_5":15607,"_29907":134213,"_3297":134381},[],"No hay salida por API; requiere intervención en la base de datos. Evítalo ajustando el rol antes de eliminar la CA.",{"_3844":79878,"_33198":79810,"_22654":134383,"_5":15607,"_29907":134213,"_3297":134384},[],"`PUT` devuelve 400.",{"_3844":79879,"_33198":79810,"_22654":134386,"_5":15607,"_29907":134213,"_3297":134387},[],"El firmante no tiene `cRLSign`, o su sujeto y su clave no coinciden con ninguna CA de ese SKI (por ejemplo, tras eliminar la primera de dos CAs que comparten clave).",{"_3844":79880,"_33198":79810,"_22654":134389,"_5":15607,"_29907":134213,"_3297":134390},[],"Asigna con `PUT` el número de serie de un certificado válido de la CA restante.",{"_3844":79881,"_33198":79810,"_22654":134392,"_5":15607,"_29907":134213,"_3297":134393},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3844":79882,"_33198":79810,"_22654":134395,"_5":15607,"_29907":134213,"_3297":134396},[],"`crl_options.subject_key_id_signer` se sustituyó por `signer_certificate_serial_number`, que es obligatorio.",{"_3844":79883,"_33198":79810,"_22654":134398,"_5":15607,"_29907":134213,"_3297":134399},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3844":79884,"_33198":79810,"_22654":134401,"_5":15607,"_29907":134213,"_3297":134402},[],"La CRL no cambia tras revocar un certificado.",{"_3844":79885,"_33198":79810,"_22654":134404,"_5":15607,"_29907":134213,"_3297":134405},[],"`regenerate_on_revoke` es `false`, o el evento falló por falta de rol o por un firmante inválido.",{"_3844":79886,"_33198":79810,"_22654":134407,"_5":15607,"_29907":134213,"_3297":134408},[],"Revisa los logs de la VA y la cola de eventos fallidos; corrige el firmante.",{"_3844":79887,"_33198":79810,"_22654":134410,"_5":15607,"_29907":134213,"_3297":134411},[],"Un verificador rechaza la CRL por el emisor.",{"_3844":79888,"_33198":79810,"_22654":134413,"_5":15607,"_29907":134213,"_3297":134414},[],"Varias CAs comparten SKI.",{"_3844":79889,"_33198":79810,"_22654":134416,"_5":15607,"_29907":134213,"_3297":134417},[],"Consulta CAs que comparten clave.",{"_3844":79890,"_33198":79810,"_22654":134419,"_5":15607,"_29907":134217,"_3297":134420},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Los ajustes VA de la CA también permiten seleccionar el firmante de la CRL: el selector de certificados solo ofrece certificados que tienen clave privada y el uso de clave `cRLSign`. Si el certificado de un firmante configurado no puede resolverse, la interfaz muestra `Unknown Certificate (Serial: X)` o `Certificate details unavailable (Serial: X)`. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3844":79891,"_33198":79810,"_22654":134422,"_5":15607,"_29907":134221,"_3297":134423},[],"RFC 5280: perfil X.509 y CRL.",{"_3844":79892,"_33198":79810,"_22654":134425,"_5":15607,"_29907":134221,"_3297":61286},[],{"_3844":79893,"_33198":79810,"_22654":134427,"_5":15607,"_29907":134221,"_3297":61289},[],{"_3844":79894,"_33198":79810,"_22654":134429,"_5":15607,"_29907":134221,"_3297":134430},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3844":79895,"_33198":79810,"_22654":134432,"_5":15607,"_29907":134221,"_3297":134433},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3844":79896,"_33198":79896,"_5":16006,"_3297":134435,"_33604":134436,"_22654":134437,"_29907":79896},"Claves y motores criptográficos",[54402,129149,59872,133024],[],{"_3844":79897,"_33198":79896,"_22654":134439,"_5":15607,"_29907":79896,"_3297":134440},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3844":79898,"_33198":79896,"_5":33601,"_22654":134442,"_29907":134443,"_3297":134444},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3844":79899,"_33198":79896,"_5":33601,"_22654":134446,"_29907":134447,"_3297":134448},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3844":79900,"_33198":79896,"_5":33601,"_22654":134450,"_29907":134451,"_3297":61314},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#file-system",{"_3844":79901,"_33198":79896,"_5":33601,"_22654":134453,"_29907":134454,"_3297":61318},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#hashicorp-vault",{"_3844":79902,"_33198":79896,"_5":33601,"_22654":134456,"_29907":134457,"_3297":61322},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#aws-secrets-manager",{"_3844":79903,"_33198":79896,"_5":33601,"_22654":134459,"_29907":134460,"_3297":61326},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#aws-kms",{"_3844":79904,"_33198":79896,"_5":33601,"_22654":134462,"_29907":134463,"_3297":61330},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#pkcs11",{"_3844":79905,"_33198":79896,"_5":33601,"_22654":134465,"_29907":134466,"_3297":61334},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#azure-key-vault",{"_3844":79906,"_33198":79896,"_5":33601,"_22654":134468,"_29907":134469,"_3297":134470},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3844":79907,"_33198":79896,"_5":33601,"_22654":134472,"_29907":134473,"_3297":134474},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3844":79908,"_33198":79896,"_5":33601,"_22654":134476,"_29907":134477,"_3297":134478},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3844":79909,"_33198":79896,"_5":33601,"_22654":134480,"_29907":134481,"_3297":134482},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3844":79910,"_33198":79896,"_5":33601,"_22654":134484,"_29907":134485,"_3297":134486},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3844":79911,"_33198":79896,"_5":33601,"_22654":134488,"_29907":134489,"_3297":134490},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3844":79912,"_33198":79896,"_5":33601,"_22654":134492,"_29907":134493,"_3297":134494},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3844":79913,"_33198":79896,"_5":33601,"_22654":134496,"_29907":134497,"_3297":61366},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#sign",{"_3844":79914,"_33198":79896,"_5":33601,"_22654":134499,"_29907":134500,"_3297":61370},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#verify",{"_3844":79915,"_33198":79896,"_5":33601,"_22654":134502,"_29907":134503,"_3297":134504},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3844":79916,"_33198":79896,"_5":33601,"_22654":134506,"_29907":134507,"_3297":134508},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3844":79917,"_33198":79896,"_5":33601,"_22654":134510,"_29907":134511,"_3297":134512},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3844":79918,"_33198":79896,"_22654":134514,"_5":15607,"_29907":79896,"_3297":134515},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3844":79919,"_33198":79896,"_22654":134517,"_5":15607,"_29907":79896,"_3297":134518},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3844":79920,"_33198":79896,"_22654":134520,"_5":15607,"_29907":134443,"_3297":134521},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3844":79921,"_33198":79896,"_22654":134523,"_5":15607,"_29907":134443,"_3297":134524},[],"En la práctica, permite:",{"_3844":79922,"_33198":79896,"_22654":134526,"_5":15607,"_29907":134443,"_3297":134527},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3844":79923,"_33198":79896,"_22654":134529,"_5":15607,"_29907":134443,"_3297":134530},[],"Importar claves creadas externamente.",{"_3844":79924,"_33198":79896,"_22654":134532,"_5":15607,"_29907":134443,"_3297":134533},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3844":79925,"_33198":79896,"_22654":134535,"_5":15607,"_29907":134443,"_3297":134536},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3844":79926,"_33198":79896,"_22654":134538,"_5":15607,"_29907":134447,"_3297":134539},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3844":79927,"_33198":79896,"_22654":134541,"_5":15607,"_29907":134447,"_3297":134542},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3844":79928,"_33198":79896,"_22654":134544,"_5":15607,"_29907":134447,"_3297":134545},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3844":79929,"_33198":79896,"_22654":134547,"_5":15607,"_29907":134451,"_3297":134548},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3844":79930,"_33198":79896,"_22654":134550,"_5":15607,"_29907":134454,"_3297":134551},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3844":79931,"_33198":79896,"_22654":134553,"_5":15607,"_29907":134454,"_3297":134554},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3844":79932,"_33198":79896,"_22654":134556,"_5":15607,"_29907":134457,"_3297":134557},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3844":79933,"_33198":79896,"_22654":134559,"_5":15607,"_29907":134460,"_3297":134560},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3844":79934,"_33198":79896,"_22654":134562,"_5":15607,"_29907":134463,"_3297":134563},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3844":79935,"_33198":79896,"_22654":134565,"_5":15607,"_29907":134466,"_3297":134566},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3844":79936,"_33198":79896,"_22654":134568,"_5":15607,"_29907":134466,"_3297":134569},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3844":79937,"_33198":79896,"_22654":134571,"_5":15607,"_29907":134466,"_3297":134572},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3844":79938,"_33198":79896,"_22654":134574,"_5":15607,"_29907":134466,"_3297":134575},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3844":79939,"_33198":79896,"_22654":134577,"_5":15607,"_29907":134469,"_3297":134578},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3844":79940,"_33198":79896,"_22654":134580,"_5":15607,"_29907":134469,"_3297":134581},[],"La tabla incluye los siguientes campos:",{"_3844":79941,"_33198":79896,"_22654":134583,"_5":15607,"_29907":134469,"_3297":134584},[],"**Name**: nombre descriptivo de la clave.",{"_3844":79942,"_33198":79896,"_22654":134586,"_5":15607,"_29907":134469,"_3297":134587},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3844":79943,"_33198":79896,"_22654":134589,"_5":15607,"_29907":134469,"_3297":134590},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3844":79944,"_33198":79896,"_22654":134592,"_5":15607,"_29907":134469,"_3297":134593},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3844":79945,"_33198":79896,"_22654":134595,"_5":15607,"_29907":134469,"_3297":134596},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3844":79946,"_33198":79896,"_22654":134598,"_5":15607,"_29907":134469,"_3297":134599},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3844":79947,"_33198":79896,"_22654":134601,"_5":15607,"_29907":134469,"_3297":134602},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3844":79948,"_33198":79896,"_22654":134604,"_5":15607,"_29907":134469,"_3297":134605},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3844":79949,"_33198":79896,"_22654":134607,"_5":15607,"_29907":134469,"_3297":134608},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3844":79950,"_33198":79896,"_22654":134610,"_5":15607,"_29907":134469,"_3297":134611},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3844":79951,"_33198":79896,"_22654":134613,"_5":15607,"_29907":134469,"_3297":134614},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3844":79952,"_33198":79896,"_22654":134616,"_5":15607,"_29907":134469,"_3297":134617},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3844":79953,"_33198":79896,"_22654":134619,"_5":15607,"_29907":134469,"_3297":134620},[],"**Delete Key** para eliminar la clave del sistema.",{"_3844":79954,"_33198":79896,"_22654":134622,"_5":15607,"_29907":134473,"_3297":134623},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3844":79955,"_33198":79896,"_22654":134625,"_5":15607,"_29907":134477,"_3297":134626},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3844":79956,"_33198":79896,"_22654":134628,"_5":15607,"_29907":134477,"_3297":134629},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3844":79957,"_33198":79896,"_22654":134631,"_5":15607,"_29907":134477,"_3297":134632},[],"**Key Name**: nombre único y descriptivo.",{"_3844":79958,"_33198":79896,"_22654":134634,"_5":15607,"_29907":134477,"_3297":134635},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3844":79959,"_33198":79896,"_22654":134637,"_5":15607,"_29907":134477,"_3297":134638},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3844":79960,"_33198":79896,"_22654":134640,"_5":15607,"_29907":134477,"_3297":134641},[],"**Tags**: metadatos para clasificar la clave.",{"_3844":79961,"_33198":79896,"_22654":134643,"_5":15607,"_29907":134477,"_3297":134644},[],"**Metadata**: información adicional para usos avanzados.",{"_3844":79962,"_33198":79896,"_22654":134646,"_5":15607,"_29907":134481,"_3297":134647},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3844":79963,"_33198":79896,"_22654":134649,"_5":15607,"_29907":134481,"_3297":134650},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3844":79964,"_33198":79896,"_22654":134652,"_5":15607,"_29907":134481,"_3297":134653},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3844":79965,"_33198":79896,"_22654":134655,"_5":15607,"_29907":134481,"_3297":134656},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3844":79966,"_33198":79896,"_22654":134658,"_5":15607,"_29907":134481,"_3297":134659},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3844":79967,"_33198":79896,"_22654":134661,"_5":15607,"_29907":134481,"_3297":134662},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3844":79968,"_33198":79896,"_22654":134664,"_5":15607,"_29907":134481,"_3297":134665},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3844":79969,"_33198":79896,"_22654":134667,"_5":15607,"_29907":134481,"_3297":134668},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3844":79970,"_33198":79896,"_22654":134670,"_5":15607,"_29907":134481,"_3297":134671},[],"**Metadata**: información adicional opcional.",{"_3844":79971,"_33198":79896,"_22654":134673,"_5":15607,"_29907":134481,"_3297":134674},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3844":79972,"_33198":79896,"_22654":134676,"_5":15607,"_29907":134481,"_3297":134677},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3844":79973,"_33198":79896,"_22654":134679,"_5":15607,"_29907":134485,"_3297":134680},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3844":79974,"_33198":79896,"_22654":134682,"_5":15607,"_29907":134489,"_3297":134683},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3844":79975,"_33198":79896,"_22654":134685,"_5":15607,"_29907":134489,"_3297":134686},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3844":79976,"_33198":79896,"_22654":134688,"_5":15607,"_29907":134489,"_3297":134689},[],"**Key Name**: nombre descriptivo.",{"_3844":79977,"_33198":79896,"_22654":134691,"_5":15607,"_29907":134489,"_3297":134692},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3844":79978,"_33198":79896,"_22654":134694,"_5":15607,"_29907":134489,"_3297":134695},[],"**Tags**: etiquetas asociadas.",{"_3844":79979,"_33198":79896,"_22654":134697,"_5":15607,"_29907":134489,"_3297":134698},[],"**Aliases**: nombres alternativos.",{"_3844":79980,"_33198":79896,"_22654":134700,"_5":15607,"_29907":134489,"_3297":134701},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3844":79981,"_33198":79896,"_22654":134703,"_5":15607,"_29907":134489,"_3297":134704},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3844":79982,"_33198":79896,"_22654":134706,"_5":15607,"_29907":134489,"_3297":134707},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3844":79983,"_33198":79896,"_22654":134709,"_5":15607,"_29907":134489,"_3297":134710},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3844":79984,"_33198":79896,"_22654":134712,"_5":15607,"_29907":134493,"_3297":134713},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3844":79985,"_33198":79896,"_22654":134715,"_5":15607,"_29907":134493,"_3297":134716},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3844":79986,"_33198":79896,"_22654":134718,"_5":15607,"_29907":134493,"_3297":134719},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3844":79987,"_33198":79896,"_22654":134721,"_5":15607,"_29907":134497,"_3297":134722},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3844":79988,"_33198":79896,"_22654":134724,"_5":15607,"_29907":134497,"_3297":134725},[],"Campos principales:",{"_3844":79989,"_33198":79896,"_22654":134727,"_5":15607,"_29907":134497,"_3297":134728},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3844":79990,"_33198":79896,"_22654":134730,"_5":15607,"_29907":134497,"_3297":134731},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3844":79991,"_33198":79896,"_22654":134733,"_5":15607,"_29907":134497,"_3297":134734},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3844":79992,"_33198":79896,"_22654":134736,"_5":15607,"_29907":134497,"_3297":134737},[],"**Message**: contenido que se va a firmar.",{"_3844":79993,"_33198":79896,"_22654":134739,"_5":15607,"_29907":134497,"_3297":134740},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3844":79994,"_33198":79896,"_22654":134742,"_5":15607,"_29907":134500,"_3297":134743},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3844":79995,"_33198":79896,"_22654":134745,"_5":15607,"_29907":134500,"_3297":134725},[],{"_3844":79996,"_33198":79896,"_22654":134747,"_5":15607,"_29907":134500,"_3297":134748},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3844":79997,"_33198":79896,"_22654":134750,"_5":15607,"_29907":134500,"_3297":134751},[],"**Message Type**: `Raw` o `Digest`.",{"_3844":79998,"_33198":79896,"_22654":134753,"_5":15607,"_29907":134500,"_3297":134754},[],"**Payload Encoding**: codificación del mensaje.",{"_3844":79999,"_33198":79896,"_22654":134756,"_5":15607,"_29907":134500,"_3297":134757},[],"**Message**: mensaje original o hash.",{"_3844":80000,"_33198":79896,"_22654":134759,"_5":15607,"_29907":134500,"_3297":134760},[],"**Signature**: firma que se desea comprobar.",{"_3844":80001,"_33198":79896,"_22654":134762,"_5":15607,"_29907":134500,"_3297":134763},[],"**Result**: indicador del resultado de la validación.",{"_3844":80002,"_33198":79896,"_22654":134765,"_5":15607,"_29907":134503,"_3297":134766},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3844":80003,"_33198":79896,"_22654":134768,"_5":15607,"_29907":134503,"_3297":134769},[],"Este flujo es útil para:",{"_3844":80004,"_33198":79896,"_22654":134771,"_5":15607,"_29907":134503,"_3297":134772},[],"Solicitar certificados a una CA externa.",{"_3844":80005,"_33198":79896,"_22654":134774,"_5":15607,"_29907":134503,"_3297":134775},[],"Renovar una identidad manteniendo la misma clave.",{"_3844":80006,"_33198":79896,"_22654":134777,"_5":15607,"_29907":134503,"_3297":134778},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3844":80007,"_33198":79896,"_22654":134780,"_5":15607,"_29907":134503,"_3297":134781},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3844":80008,"_33198":79896,"_22654":134783,"_5":15607,"_29907":134503,"_3297":134784},[],"**Organization (O)**: organización o empresa.",{"_3844":80009,"_33198":79896,"_22654":134786,"_5":15607,"_29907":134503,"_3297":134787},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3844":80010,"_33198":79896,"_22654":134789,"_5":15607,"_29907":134503,"_3297":134790},[],"**Country (C)**: código de país de dos letras.",{"_3844":80011,"_33198":79896,"_22654":134792,"_5":15607,"_29907":134503,"_3297":134793},[],"**State / Province (ST)**: estado o provincia.",{"_3844":80012,"_33198":79896,"_22654":134795,"_5":15607,"_29907":134503,"_3297":134796},[],"**Locality (L)**: ciudad o localidad.",{"_3844":80013,"_33198":79896,"_22654":134798,"_5":15607,"_29907":134503,"_3297":134799},[],"**Email Address**: correo de contacto.",{"_3844":80014,"_33198":79896,"_22654":134801,"_5":15607,"_29907":134503,"_3297":134802},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3844":80015,"_33198":79896,"_22654":134804,"_5":15607,"_29907":134503,"_3297":134805},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3844":80016,"_33198":79896,"_22654":134807,"_5":15607,"_29907":134507,"_3297":134808},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3844":80017,"_33198":79896,"_22654":134810,"_5":15607,"_29907":134507,"_3297":134811},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3844":80018,"_33198":79896,"_22654":134813,"_5":15607,"_29907":134511,"_3297":134814},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3844":80019,"_33198":79896,"_22654":134816,"_5":15607,"_29907":134511,"_3297":134817},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves. La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3844":80020,"_33198":80020,"_5":16006,"_3297":134819,"_33604":134820,"_22654":134821,"_29907":80020},"Validación online con OCSP",[54402,129149,59872,133655],[],{"_3844":80021,"_33198":80020,"_22654":134823,"_5":15607,"_29907":80020,"_3297":134824},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3844":80022,"_33198":80020,"_5":33601,"_22654":134826,"_29907":134827,"_3297":134828},[],"/docs/pr-preview/pr-58/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3844":80023,"_33198":80020,"_5":33601,"_22654":134830,"_29907":134831,"_3297":134832},[],"/docs/pr-preview/pr-58/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3844":80024,"_33198":80020,"_5":33601,"_22654":134834,"_29907":134835,"_3297":134836},[],"/docs/pr-preview/pr-58/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3844":80025,"_33198":80020,"_5":33601,"_22654":134838,"_29907":134839,"_3297":134840},[],"/docs/pr-preview/pr-58/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3844":80026,"_33198":80020,"_5":33601,"_22654":134842,"_29907":134843,"_3297":134844},[],"/docs/pr-preview/pr-58/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3844":80027,"_33198":80020,"_5":33601,"_22654":134846,"_29907":134847,"_3297":134222},[],"/docs/pr-preview/pr-58/es/platform/pki/ocsp#referencias",{"_3844":80028,"_33198":80020,"_22654":134849,"_5":15607,"_29907":80020,"_3297":134850},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3844":80029,"_33198":80020,"_22654":134852,"_5":15607,"_29907":134827,"_3297":134853},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3844":80030,"_33198":80020,"_22654":134855,"_5":15607,"_29907":134827,"_3297":134856},[],"Estado del registro",{"_3844":80031,"_33198":80020,"_22654":134858,"_5":15607,"_29907":134827,"_3297":134859},[],"Respuesta firmada",{"_3844":80032,"_33198":80020,"_22654":134861,"_5":15607,"_29907":134827,"_3297":59009},[],{"_3844":80033,"_33198":80020,"_22654":134863,"_5":15607,"_29907":134827,"_3297":61734},[],{"_3844":80034,"_33198":80020,"_22654":134865,"_5":15607,"_29907":134827,"_3297":59026},[],{"_3844":80035,"_33198":80020,"_22654":134867,"_5":15607,"_29907":134827,"_3297":134868},[],"`Revoked`, con razón y fecha de revocación.",{"_3844":80036,"_33198":80020,"_22654":134870,"_5":15607,"_29907":134827,"_3297":134871},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3844":80037,"_33198":80020,"_22654":134873,"_5":15607,"_29907":134827,"_3297":134874},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3844":80038,"_33198":80020,"_22654":134876,"_5":15607,"_29907":134827,"_3297":134877},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3844":80039,"_33198":80020,"_22654":134879,"_5":15607,"_29907":134827,"_3297":134880},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3844":80040,"_33198":80020,"_22654":134882,"_5":15607,"_29907":134827,"_3297":134883},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3844":80041,"_33198":80020,"_22654":134885,"_5":15607,"_29907":134831,"_3297":134886},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3844":80042,"_33198":80020,"_22654":134888,"_5":15607,"_29907":134831,"_3297":134889},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3844":80043,"_33198":80020,"_22654":134891,"_5":15607,"_29907":134835,"_3297":134892},[],"El servicio acepta:",{"_3844":80044,"_33198":80020,"_22654":134894,"_5":15607,"_29907":134835,"_3297":130876},[],{"_3844":80045,"_33198":80020,"_22654":134896,"_5":15607,"_29907":134835,"_3297":134897},[],"Ruta del servicio VA",{"_3844":80046,"_33198":80020,"_22654":134899,"_5":15607,"_29907":134835,"_3297":134900},[],"Formato",{"_3844":80047,"_33198":80020,"_22654":134902,"_5":15607,"_29907":134835,"_3297":61774},[],{"_3844":80048,"_33198":80020,"_22654":134904,"_5":15607,"_29907":134835,"_3297":61777},[],{"_3844":80049,"_33198":80020,"_22654":134906,"_5":15607,"_29907":134835,"_3297":134907},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3844":80050,"_33198":80020,"_22654":134909,"_5":15607,"_29907":134835,"_3297":61203},[],{"_3844":80051,"_33198":80020,"_22654":134911,"_5":15607,"_29907":134835,"_3297":61785},[],{"_3844":80052,"_33198":80020,"_22654":134913,"_5":15607,"_29907":134835,"_3297":134914},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3844":80053,"_33198":80020,"_22654":134916,"_5":15607,"_29907":134835,"_3297":134917},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3844":80054,"_33198":80020,"_22654":134919,"_5":15607,"_29907":134839,"_3297":134920},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3844":80055,"_33198":80020,"_22654":134922,"_5":15607,"_29907":134839,"_3297":134923},[],"Genera la solicitud:",{"_3844":80056,"_33198":80020,"_22654":134925,"_5":15607,"_29907":134839,"_3297":134926},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3844":80057,"_33198":80020,"_22654":134928,"_5":15607,"_29907":134839,"_3297":134929},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3844":80058,"_33198":80020,"_22654":134931,"_5":15607,"_29907":134839,"_3297":134932},[],"Verifica el DER recibido:",{"_3844":80059,"_33198":80020,"_22654":134934,"_5":15607,"_29907":134839,"_3297":134935},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3844":80060,"_33198":80020,"_22654":134937,"_5":15607,"_29907":134843,"_3297":134938},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3844":80061,"_33198":80020,"_22654":134940,"_5":15607,"_29907":134843,"_3297":134941},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3844":80062,"_33198":80020,"_22654":134943,"_5":15607,"_29907":134847,"_3297":61818},[],{"_3844":80063,"_33198":80020,"_22654":134945,"_5":15607,"_29907":134847,"_3297":61821},[],{"_3844":80064,"_33198":80020,"_22654":134947,"_5":15607,"_29907":134847,"_3297":134948},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3844":80065,"_33198":80020,"_22654":134950,"_5":15607,"_29907":134847,"_3297":134433},[],{"_3844":80066,"_33198":80066,"_5":16006,"_3297":59872,"_33604":134952,"_22654":134953,"_29907":80066},[54402,129149,59872],[],{"_3844":80067,"_33198":80066,"_22654":134955,"_5":15607,"_29907":80066,"_3297":134956},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3844":80068,"_33198":80066,"_5":33601,"_22654":134958,"_29907":134959,"_3297":132350},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#empieza-aquí",{"_3844":80069,"_33198":80066,"_5":33601,"_22654":134961,"_29907":134962,"_3297":134963},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3844":80070,"_33198":80066,"_5":33601,"_22654":134965,"_29907":134966,"_3297":132870},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#capacidades-principales",{"_3844":80071,"_33198":80066,"_5":33601,"_22654":134968,"_29907":134969,"_3297":132874},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3844":80072,"_33198":80066,"_5":33601,"_22654":134971,"_29907":134972,"_3297":132878},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3844":80073,"_33198":80066,"_5":33601,"_22654":134974,"_29907":134975,"_3297":132882},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#emite-y-controla-certificados",{"_3844":80074,"_33198":80066,"_5":33601,"_22654":134977,"_29907":134978,"_3297":132890},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#publica-el-estado-de-validación",{"_3844":80075,"_33198":80066,"_5":33601,"_22654":134980,"_29907":134981,"_3297":134982},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3844":80076,"_33198":80066,"_5":33601,"_22654":134984,"_29907":134985,"_3297":133821},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#continúa",{"_3844":80077,"_33198":80066,"_22654":134987,"_5":15607,"_29907":80066,"_3297":134988},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3844":80078,"_33198":80066,"_22654":134990,"_5":15607,"_29907":134959,"_3297":134991},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3844":80079,"_33198":80066,"_22654":134993,"_5":15607,"_29907":134959,"_3297":134994},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3844":80080,"_33198":80066,"_22654":134996,"_5":15607,"_29907":134962,"_3297":134997},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3844":80081,"_33198":80066,"_22654":134999,"_5":15607,"_29907":134962,"_3297":135000},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3844":80082,"_33198":80066,"_22654":135002,"_5":15607,"_29907":134962,"_3297":135003},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3844":80083,"_33198":80066,"_22654":135005,"_5":15607,"_29907":134962,"_3297":135006},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3844":80084,"_33198":80066,"_22654":135008,"_5":15607,"_29907":134962,"_3297":135009},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3844":80085,"_33198":80066,"_22654":135011,"_5":15607,"_29907":134969,"_3297":135012},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3844":80086,"_33198":80066,"_22654":135014,"_5":15607,"_29907":134972,"_3297":135015},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3844":80087,"_33198":80066,"_22654":135017,"_5":15607,"_29907":134975,"_3297":135018},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3844":80088,"_33198":80066,"_22654":135020,"_5":15607,"_29907":134978,"_3297":135021},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3844":80089,"_33198":80066,"_22654":135023,"_5":15607,"_29907":134981,"_3297":135024},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3844":80090,"_33198":80066,"_22654":135026,"_5":15607,"_29907":134981,"_3297":135027},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3844":80091,"_33198":80066,"_22654":135029,"_5":15607,"_29907":134981,"_3297":135030},[],"su clave pública corresponda a la clave privada del cliente;",{"_3844":80092,"_33198":80066,"_22654":135032,"_5":15607,"_29907":134981,"_3297":135033},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3844":80093,"_33198":80066,"_22654":135035,"_5":15607,"_29907":134981,"_3297":135036},[],"sus fechas y usos permitan la operación;",{"_3844":80094,"_33198":80066,"_22654":135038,"_5":15607,"_29907":134981,"_3297":135039},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3844":80095,"_33198":80066,"_22654":135041,"_5":15607,"_29907":134981,"_3297":135042},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3844":80096,"_33198":80066,"_22654":135044,"_5":15607,"_29907":134985,"_3297":135045},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3844":80097,"_33198":80066,"_22654":135047,"_5":15607,"_29907":134985,"_3297":135048},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3844":80098,"_33198":80066,"_22654":135050,"_5":15607,"_29907":134985,"_3297":135051},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3844":80099,"_33198":80099,"_5":16006,"_3297":135053,"_33604":135054,"_22654":135055,"_29907":80099},"Crea tu primera CA",[54402,129149,59872,132474],[],{"_3844":80100,"_33198":80099,"_22654":135057,"_5":15607,"_29907":80099,"_3297":135058},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3844":80101,"_33198":80099,"_5":33601,"_22654":135060,"_29907":135061,"_3297":127727},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3844":80102,"_33198":80099,"_5":33601,"_22654":135063,"_29907":135064,"_3297":135065},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3844":80103,"_33198":80099,"_5":33601,"_22654":135067,"_29907":135068,"_3297":135069},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3844":80104,"_33198":80099,"_5":33601,"_22654":135071,"_29907":135072,"_3297":135073},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3844":80105,"_33198":80099,"_5":33601,"_22654":135075,"_29907":135076,"_3297":135077},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3844":80106,"_33198":80099,"_5":33601,"_22654":135079,"_29907":135080,"_3297":135081},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3844":80107,"_33198":80099,"_5":33601,"_22654":135083,"_29907":135084,"_3297":135085},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3844":80108,"_33198":80099,"_5":33601,"_22654":135087,"_29907":135088,"_3297":132721},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3844":80109,"_33198":80099,"_5":33601,"_22654":135090,"_29907":135091,"_3297":127751},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3844":80110,"_33198":80099,"_22654":135093,"_5":15607,"_29907":80099,"_3297":135094},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3844":80111,"_33198":80099,"_22654":135096,"_5":15607,"_29907":135061,"_3297":135097},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3844":80112,"_33198":80099,"_22654":135099,"_5":15607,"_29907":135061,"_3297":135100},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3844":80113,"_33198":80099,"_22654":135102,"_5":15607,"_29907":135061,"_3297":135103},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3844":80114,"_33198":80099,"_22654":135105,"_5":15607,"_29907":135061,"_3297":135106},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3844":80115,"_33198":80099,"_22654":135108,"_5":15607,"_29907":135064,"_3297":135109},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3844":80116,"_33198":80099,"_22654":135111,"_5":15607,"_29907":135064,"_3297":135112},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3844":80117,"_33198":80099,"_22654":135114,"_5":15607,"_29907":135068,"_3297":135115},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3844":80118,"_33198":80099,"_22654":135117,"_5":15607,"_29907":135068,"_3297":135118},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3844":80119,"_33198":80099,"_22654":135120,"_5":15607,"_29907":135072,"_3297":135121},[],"Selecciona **Root CA** y completa:",{"_3844":80120,"_33198":80099,"_22654":135123,"_5":15607,"_29907":135072,"_3297":62000},[],{"_3844":80121,"_33198":80099,"_22654":135125,"_5":15607,"_29907":135072,"_3297":135126},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3844":80122,"_33198":80099,"_22654":135128,"_5":15607,"_29907":135072,"_3297":135129},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3844":80123,"_33198":80099,"_22654":135131,"_5":15607,"_29907":135072,"_3297":135132},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3844":80124,"_33198":80099,"_22654":135134,"_5":15607,"_29907":135072,"_3297":135135},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3844":80125,"_33198":80099,"_22654":135137,"_5":15607,"_29907":135076,"_3297":135138},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3844":80126,"_33198":80099,"_22654":135140,"_5":15607,"_29907":135080,"_3297":135141},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3844":80127,"_33198":80099,"_22654":135143,"_5":15607,"_29907":135080,"_3297":135144},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3844":80128,"_33198":80099,"_22654":135146,"_5":15607,"_29907":135084,"_3297":135147},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3844":80129,"_33198":80099,"_22654":135149,"_5":15607,"_29907":135084,"_3297":135150},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3844":80130,"_33198":80099,"_22654":135152,"_5":15607,"_29907":135084,"_3297":135153},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3844":80131,"_33198":80099,"_22654":135155,"_5":15607,"_29907":135088,"_3297":135156},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3844":80132,"_33198":80099,"_22654":135158,"_5":15607,"_29907":135088,"_3297":135159},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3844":80133,"_33198":80099,"_22654":135161,"_5":15607,"_29907":135088,"_3297":135162},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3844":80134,"_33198":80099,"_22654":135164,"_5":15607,"_29907":135088,"_3297":135165},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3844":80135,"_33198":80099,"_22654":135167,"_5":15607,"_29907":135091,"_3297":135168},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3844":80136,"_33198":80136,"_5":16006,"_3297":135170,"_33604":135171,"_22654":135172,"_29907":80136},"Emite y verifica un certificado",[54402,129149,59872,132474],[],{"_3844":80137,"_33198":80136,"_22654":135174,"_5":15607,"_29907":80136,"_3297":135175},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3844":80138,"_33198":80136,"_5":33601,"_22654":135177,"_29907":135178,"_3297":127727},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3844":80139,"_33198":80136,"_5":33601,"_22654":135180,"_29907":135181,"_3297":135182},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3844":80140,"_33198":80136,"_5":33601,"_22654":135184,"_29907":135185,"_3297":135186},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3844":80141,"_33198":80136,"_5":33601,"_22654":135188,"_29907":135189,"_3297":135190},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3844":80142,"_33198":80136,"_5":33601,"_22654":135192,"_29907":135193,"_3297":135194},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3844":80143,"_33198":80136,"_5":33601,"_22654":135196,"_29907":135197,"_3297":135198},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3844":80144,"_33198":80136,"_5":33601,"_22654":135200,"_29907":135201,"_3297":135202},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3844":80145,"_33198":80136,"_5":33601,"_22654":135204,"_29907":135205,"_3297":135206},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3844":80146,"_33198":80136,"_5":33601,"_22654":135208,"_29907":135209,"_3297":135210},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3844":80147,"_33198":80136,"_5":33601,"_22654":135212,"_29907":135213,"_3297":135214},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3844":80148,"_33198":80136,"_5":33601,"_22654":135216,"_29907":135217,"_3297":132721},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3844":80149,"_33198":80136,"_5":33601,"_22654":135219,"_29907":135220,"_3297":127751},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3844":80150,"_33198":80136,"_22654":135222,"_5":15607,"_29907":80136,"_3297":135223},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3844":80151,"_33198":80136,"_22654":135225,"_5":15607,"_29907":135178,"_3297":135226},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3844":80152,"_33198":80136,"_22654":135228,"_5":15607,"_29907":135178,"_3297":135229},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3844":80153,"_33198":80136,"_22654":135231,"_5":15607,"_29907":135178,"_3297":135232},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3844":80154,"_33198":80136,"_22654":135234,"_5":15607,"_29907":135178,"_3297":135235},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3844":80155,"_33198":80136,"_22654":135237,"_5":15607,"_29907":135178,"_3297":135238},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3844":80156,"_33198":80136,"_22654":135240,"_5":15607,"_29907":135181,"_3297":135241},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3844":80157,"_33198":80136,"_22654":135243,"_5":15607,"_29907":135185,"_3297":135244},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3844":80158,"_33198":80136,"_22654":135246,"_5":15607,"_29907":135185,"_3297":135247},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3844":80159,"_33198":80136,"_22654":135249,"_5":15607,"_29907":135189,"_3297":135250},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3844":80160,"_33198":80136,"_22654":135252,"_5":15607,"_29907":135189,"_3297":135253},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3844":80161,"_33198":80136,"_22654":135255,"_5":15607,"_29907":135193,"_3297":135256},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3844":80162,"_33198":80136,"_22654":135258,"_5":15607,"_29907":135193,"_3297":135259},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3844":80163,"_33198":80136,"_22654":135261,"_5":15607,"_29907":135197,"_3297":135262},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3844":80164,"_33198":80136,"_22654":135264,"_5":15607,"_29907":135201,"_3297":135265},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3844":80165,"_33198":80136,"_22654":135267,"_5":15607,"_29907":135205,"_3297":135268},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3844":80166,"_33198":80136,"_22654":135270,"_5":15607,"_29907":135209,"_3297":135271},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3844":80167,"_33198":80136,"_22654":135273,"_5":15607,"_29907":135209,"_3297":135274},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3844":80168,"_33198":80136,"_22654":135276,"_5":15607,"_29907":135209,"_3297":135277},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3844":80169,"_33198":80136,"_22654":135279,"_5":15607,"_29907":135213,"_3297":135280},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3844":80170,"_33198":80136,"_22654":135282,"_5":15607,"_29907":135213,"_3297":135283},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3844":80171,"_33198":80136,"_22654":135285,"_5":15607,"_29907":135213,"_3297":135286},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3844":80172,"_33198":80136,"_22654":135288,"_5":15607,"_29907":135217,"_3297":132804},[],{"_3844":80173,"_33198":80136,"_22654":135290,"_5":15607,"_29907":135217,"_3297":131325},[],{"_3844":80174,"_33198":80136,"_22654":135292,"_5":15607,"_29907":135217,"_3297":135293},[],"La CA rechaza la emisión",{"_3844":80175,"_33198":80136,"_22654":135295,"_5":15607,"_29907":135217,"_3297":135296},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3844":80176,"_33198":80136,"_22654":135298,"_5":15607,"_29907":135217,"_3297":135299},[],"Sujeto o usos diferentes",{"_3844":80177,"_33198":80136,"_22654":135301,"_5":15607,"_29907":135217,"_3297":135302},[],"Perfil aplicado y valores solicitados.",{"_3844":80178,"_33198":80136,"_22654":135304,"_5":15607,"_29907":135217,"_3297":135305},[],"No se encuentra el emisor",{"_3844":80179,"_33198":80136,"_22654":135307,"_5":15607,"_29907":135217,"_3297":135308},[],"CA descargada y cadena intermedia necesaria.",{"_3844":80180,"_33198":80136,"_22654":135310,"_5":15607,"_29907":135217,"_3297":135311},[],"Falla la vigencia",{"_3844":80181,"_33198":80136,"_22654":135313,"_5":15607,"_29907":135217,"_3297":135314},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3844":80182,"_33198":80136,"_22654":135316,"_5":15607,"_29907":135217,"_3297":135317},[],"Los resúmenes de clave difieren",{"_3844":80183,"_33198":80136,"_22654":135319,"_5":15607,"_29907":135217,"_3297":135320},[],"Archivos de certificado y clave de la misma emisión.",{"_3844":80184,"_33198":80136,"_22654":135322,"_5":15607,"_29907":135217,"_3297":135323},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3844":80185,"_33198":80136,"_22654":135325,"_5":15607,"_29907":135220,"_3297":135326},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3844":80186,"_33198":80136,"_22654":135328,"_5":15607,"_29907":135220,"_3297":135329},[],"Gestionar certificados para inspección, estado y revocación.",{"_3844":80187,"_33198":80136,"_22654":135331,"_5":15607,"_29907":135220,"_3297":135332},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3844":80188,"_33198":80136,"_22654":135334,"_5":15607,"_29907":135220,"_3297":135335},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3844":80189,"_33198":80136,"_22654":135337,"_5":15607,"_29907":135220,"_3297":135338},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3844":80190,"_33198":80190,"_5":16006,"_3297":135340,"_33604":135341,"_22654":135342,"_29907":80190},"Primeros pasos de PKI",[54402,129149,59872,132474],[],{"_3844":80191,"_33198":80190,"_22654":135344,"_5":15607,"_29907":80190,"_3297":135345},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3844":80192,"_33198":80190,"_5":33601,"_22654":135347,"_29907":135348,"_3297":127727},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3844":80193,"_33198":80190,"_5":33601,"_22654":135350,"_29907":135351,"_3297":135352},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3844":80194,"_33198":80190,"_5":33601,"_22654":135354,"_29907":135355,"_3297":132656},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3844":80195,"_33198":80190,"_5":33601,"_22654":135357,"_29907":135358,"_3297":135359},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3844":80196,"_33198":80190,"_22654":135361,"_5":15607,"_29907":80190,"_3297":135362},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3844":80197,"_33198":80190,"_22654":135364,"_5":15607,"_29907":135348,"_3297":135365},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3844":80198,"_33198":80190,"_22654":135367,"_5":15607,"_29907":135348,"_3297":135368},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3844":80199,"_33198":80190,"_22654":135370,"_5":15607,"_29907":135348,"_3297":135371},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3844":80200,"_33198":80190,"_22654":135373,"_5":15607,"_29907":135348,"_3297":135374},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3844":80201,"_33198":80190,"_22654":135376,"_5":15607,"_29907":135348,"_3297":135377},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3844":80202,"_33198":80190,"_22654":135379,"_5":15607,"_29907":135351,"_3297":135380},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3844":80203,"_33198":80190,"_22654":135382,"_5":15607,"_29907":135351,"_3297":135383},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3844":80204,"_33198":80190,"_22654":135385,"_5":15607,"_29907":135351,"_3297":135386},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3844":80205,"_33198":80190,"_22654":135388,"_5":15607,"_29907":135351,"_3297":135389},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3844":80206,"_33198":80190,"_22654":135391,"_5":15607,"_29907":135355,"_3297":135392},[],"Archivo o recurso",{"_3844":80207,"_33198":80190,"_22654":135394,"_5":15607,"_29907":135355,"_3297":132653},[],{"_3844":80208,"_33198":80190,"_22654":135396,"_5":15607,"_29907":135355,"_3297":135397},[],"CA raíz activa y `ca.pem`",{"_3844":80209,"_33198":80190,"_22654":135399,"_5":15607,"_29907":135355,"_3297":135400},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3844":80210,"_33198":80190,"_22654":135402,"_5":15607,"_29907":135355,"_3297":135403},[],"Certificado final y `device.crt`",{"_3844":80211,"_33198":80190,"_22654":135405,"_5":15607,"_29907":135355,"_3297":135406},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3844":80212,"_33198":80190,"_22654":135408,"_5":15607,"_29907":135355,"_3297":135409},[],"Clave privada `device.key`",{"_3844":80213,"_33198":80190,"_22654":135411,"_5":15607,"_29907":135355,"_3297":135412},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3844":80214,"_33198":80190,"_22654":135414,"_5":15607,"_29907":135355,"_3297":135415},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3844":80215,"_33198":80190,"_22654":135417,"_5":15607,"_29907":135358,"_3297":135418},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3844":80216,"_33198":80190,"_22654":135420,"_5":15607,"_29907":135358,"_3297":135421},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3844":80217,"_33198":80190,"_22654":135423,"_5":15607,"_29907":135358,"_3297":135424},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3844":80218,"_33198":80218,"_5":16006,"_3297":135426,"_33604":135427,"_22654":135429,"_29907":80218},"Resolución de problemas PKI",[54402,129149,59872,135428],"Resolución de problemas",[],{"_3844":80219,"_33198":80218,"_22654":135431,"_5":15607,"_29907":80218,"_3297":135432},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3844":80220,"_33198":80218,"_5":33601,"_22654":135434,"_29907":135435,"_3297":135436},[],"/docs/pr-preview/pr-58/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3844":80221,"_33198":80218,"_5":33601,"_22654":135438,"_29907":135439,"_3297":135440},[],"/docs/pr-preview/pr-58/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3844":80222,"_33198":80218,"_5":33601,"_22654":135442,"_29907":135443,"_3297":135444},[],"/docs/pr-preview/pr-58/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3844":80223,"_33198":80218,"_22654":135446,"_5":15607,"_29907":80218,"_3297":135447},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3844":80224,"_33198":80218,"_22654":135449,"_5":15607,"_29907":80218,"_3297":135450},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3844":80225,"_33198":80218,"_22654":135452,"_5":15607,"_29907":135435,"_3297":132653},[],{"_3844":80226,"_33198":80218,"_22654":135454,"_5":15607,"_29907":135435,"_3297":131325},[],{"_3844":80227,"_33198":80218,"_22654":135456,"_5":15607,"_29907":135435,"_3297":127751},[],{"_3844":80228,"_33198":80218,"_22654":135458,"_5":15607,"_29907":135435,"_3297":58714},[],{"_3844":80229,"_33198":80218,"_22654":135460,"_5":15607,"_29907":135435,"_3297":135461},[],"Existe, está activa y sus fechas son utilizables.",{"_3844":80230,"_33198":80218,"_22654":135463,"_5":15607,"_29907":135435,"_3297":135464},[],"Autoridades.",{"_3844":80231,"_33198":80218,"_22654":135466,"_5":15607,"_29907":135435,"_3297":135467},[],"Clave",{"_3844":80232,"_33198":80218,"_22654":135469,"_5":15607,"_29907":135435,"_3297":135470},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3844":80233,"_33198":80218,"_22654":135472,"_5":15607,"_29907":135435,"_3297":135473},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3844":80234,"_33198":80218,"_22654":135475,"_5":15607,"_29907":135435,"_3297":62354},[],{"_3844":80235,"_33198":80218,"_22654":135477,"_5":15607,"_29907":135435,"_3297":135478},[],"PEM correcto y firma verificable.",{"_3844":80236,"_33198":80218,"_22654":135480,"_5":15607,"_29907":135435,"_3297":62360},[],{"_3844":80237,"_33198":80218,"_22654":135482,"_5":15607,"_29907":135435,"_3297":135483},[],"Perfil",{"_3844":80238,"_33198":80218,"_22654":135485,"_5":15607,"_29907":135435,"_3297":135486},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3844":80239,"_33198":80218,"_22654":135488,"_5":15607,"_29907":135435,"_3297":135489},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3844":80240,"_33198":80218,"_22654":135491,"_5":15607,"_29907":135435,"_3297":132804},[],{"_3844":80241,"_33198":80218,"_22654":135493,"_5":15607,"_29907":135435,"_3297":135494},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3844":80242,"_33198":80218,"_22654":135496,"_5":15607,"_29907":135435,"_3297":135497},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3844":80243,"_33198":80218,"_22654":135499,"_5":15607,"_29907":135435,"_3297":135500},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3844":80244,"_33198":80218,"_22654":135502,"_5":15607,"_29907":135435,"_3297":135503},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3844":80245,"_33198":80218,"_22654":135505,"_5":15607,"_29907":135439,"_3297":135506},[],"Revisa cada frontera por separado:",{"_3844":80246,"_33198":80218,"_22654":135508,"_5":15607,"_29907":135439,"_3297":135509},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3844":80247,"_33198":80218,"_22654":135511,"_5":15607,"_29907":135439,"_3297":135512},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3844":80248,"_33198":80218,"_22654":135514,"_5":15607,"_29907":135439,"_3297":135515},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3844":80249,"_33198":80218,"_22654":135517,"_5":15607,"_29907":135439,"_3297":135518},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3844":80250,"_33198":80218,"_22654":135520,"_5":15607,"_29907":135439,"_3297":135521},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3844":80251,"_33198":80218,"_22654":135523,"_5":15607,"_29907":135439,"_3297":135524},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3844":80252,"_33198":80218,"_22654":135526,"_5":15607,"_29907":135443,"_3297":135527},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3844":80253,"_33198":80218,"_22654":135529,"_5":15607,"_29907":135443,"_3297":135530},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3844":80254,"_33198":80254,"_5":16006,"_3297":135532,"_33604":135533,"_22654":135536,"_29907":80254},"Algoritmos",[54402,129149,135534,135535],"[Beta] Poscuántica (PQC)","Algoritmos y toolchain",[],{"_3844":80255,"_33198":80254,"_22654":135538,"_5":15607,"_29907":80254,"_3297":135539},[],"Los algoritmos de firma poscuánticos y composite que soporta Lamassu, cómo se identifica cada uno en las peticiones a la API y los estándares que siguen.",{"_3844":80256,"_33198":80254,"_5":33601,"_22654":135541,"_29907":135542,"_3297":135543},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#cómo-se-selecciona-un-algoritmo","Cómo se selecciona un algoritmo",{"_3844":80257,"_33198":80254,"_5":33601,"_22654":135545,"_29907":135546,"_3297":62427},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#ml-dsa",{"_3844":80258,"_33198":80254,"_5":33601,"_22654":135548,"_29907":135549,"_3297":62431},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#slh-dsa",{"_3844":80259,"_33198":80254,"_5":33601,"_22654":135551,"_29907":135552,"_3297":135553},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#ml-dsa-composite","ML-DSA composite",{"_3844":80260,"_33198":80254,"_5":33601,"_22654":135555,"_29907":135556,"_3297":62439},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#ed25519",{"_3844":80261,"_33198":80254,"_5":33601,"_22654":135558,"_29907":135559,"_3297":135560},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#qué-no-se-cubre","Qué no se cubre",{"_3844":80262,"_33198":80254,"_22654":135562,"_5":15607,"_29907":80254,"_3297":135563},[],"Lamassu soporta cuatro grupos de algoritmos de firma además de RSA y ECDSA: ML-DSA, SLH-DSA, ML-DSA composite y Ed25519. Todos proceden del toolchain de Go PQC; el backend solo selecciona el algoritmo y delega la criptografía.",{"_3844":80263,"_33198":80254,"_22654":135565,"_5":15607,"_29907":135542,"_3297":135566},[],"Una clave o una CA se crea con un tipo de clave y un tamaño. En RSA y ECDSA el tamaño es una longitud en bits o una curva. En los algoritmos poscuánticos el mismo campo transporta un **identificador de conjunto de parámetros**, no un número de bits:",{"_3844":80264,"_33198":80254,"_22654":135568,"_5":15607,"_29907":135542,"_3297":135569},[],"Tipo de clave (`algorithm` / `type`)",{"_3844":80265,"_33198":80254,"_22654":135571,"_5":15607,"_29907":135542,"_3297":135572},[],"Valor de `size` / `bits`",{"_3844":80266,"_33198":80254,"_22654":135574,"_5":15607,"_29907":135542,"_3297":135575},[],"Significado",{"_3844":80267,"_33198":80254,"_22654":135577,"_5":15607,"_29907":135542,"_3297":62460},[],{"_3844":80268,"_33198":80254,"_22654":135579,"_5":15607,"_29907":135542,"_3297":62463},[],{"_3844":80269,"_33198":80254,"_22654":135581,"_5":15607,"_29907":135542,"_3297":135582},[],"Longitud del módulo en bits.",{"_3844":80270,"_33198":80254,"_22654":135584,"_5":15607,"_29907":135542,"_3297":62469},[],{"_3844":80271,"_33198":80254,"_22654":135586,"_5":15607,"_29907":135542,"_3297":62472},[],{"_3844":80272,"_33198":80254,"_22654":135588,"_5":15607,"_29907":135542,"_3297":135589},[],"Tamaño de la curva en bits (P-256, P-384, P-521).",{"_3844":80273,"_33198":80254,"_22654":135591,"_5":15607,"_29907":135542,"_3297":62478},[],{"_3844":80274,"_33198":80254,"_22654":135593,"_5":15607,"_29907":135542,"_3297":25572},[],{"_3844":80275,"_33198":80254,"_22654":135595,"_5":15607,"_29907":135542,"_3297":135596},[],"Fijo. Cualquier otro valor se sustituye por 256.",{"_3844":80276,"_33198":80254,"_22654":135598,"_5":15607,"_29907":135542,"_3297":62486},[],{"_3844":80277,"_33198":80254,"_22654":135600,"_5":15607,"_29907":135542,"_3297":62489},[],{"_3844":80278,"_33198":80254,"_22654":135602,"_5":15607,"_29907":135542,"_3297":135603},[],"Conjunto de parámetros de ML-DSA.",{"_3844":80279,"_33198":80254,"_22654":135605,"_5":15607,"_29907":135542,"_3297":62495},[],{"_3844":80280,"_33198":80254,"_22654":135607,"_5":15607,"_29907":135542,"_3297":135608},[],"1 a 12",{"_3844":80281,"_33198":80254,"_22654":135610,"_5":15607,"_29907":135542,"_3297":135611},[],"Conjunto de parámetros de SLH-DSA, en el orden de la tabla siguiente.",{"_3844":80282,"_33198":80254,"_22654":135613,"_5":15607,"_29907":135542,"_3297":62504},[],{"_3844":80283,"_33198":80254,"_22654":135615,"_5":15607,"_29907":135542,"_3297":135616},[],"1 a 8",{"_3844":80284,"_33198":80254,"_22654":135618,"_5":15607,"_29907":135542,"_3297":135619},[],"Variante composite con componente RSA.",{"_3844":80285,"_33198":80254,"_22654":135621,"_5":15607,"_29907":135542,"_3297":62513},[],{"_3844":80286,"_33198":80254,"_22654":135623,"_5":15607,"_29907":135542,"_3297":135624},[],"9 a 13",{"_3844":80287,"_33198":80254,"_22654":135626,"_5":15607,"_29907":135542,"_3297":135627},[],"Variante composite con componente ECDSA.",{"_3844":80288,"_33198":80254,"_22654":135629,"_5":15607,"_29907":135542,"_3297":62522},[],{"_3844":80289,"_33198":80254,"_22654":135631,"_5":15607,"_29907":135542,"_3297":135632},[],"14 y 15",{"_3844":80290,"_33198":80254,"_22654":135634,"_5":15607,"_29907":135542,"_3297":135635},[],"Variante composite con componente Ed25519.",{"_3844":80291,"_33198":80254,"_22654":135637,"_5":15607,"_29907":135542,"_3297":135638},[],"Una cadena de tipo de clave desconocida no se rechaza al interpretarla: se convierte en un tipo desconocido y falla más tarde. Deben usarse exactamente las cadenas anteriores.",{"_3844":80292,"_33198":80254,"_22654":135640,"_5":15607,"_29907":135546,"_3297":135641},[],"ML-DSA es el esquema de firma basado en retículos estandarizado en FIPS 204. Lamassu acepta los tres conjuntos de parámetros ML-DSA-44, ML-DSA-65 y ML-DSA-87, que se seleccionan con `size` 44, 65 o 87. La implementación es el paquete `crypto/mldsa` de Go 1.27, es decir, el código de la propia biblioteca estándar y no del fork. En los certificados, los identificadores de algoritmo son `2.16.840.1.101.3.4.3.17`, `.18` y `.19` para ML-DSA-44, -65 y -87.",{"_3844":80293,"_33198":80254,"_22654":135643,"_5":15607,"_29907":135546,"_3297":135644},[],"Go solo lee claves privadas ML-DSA en PKCS#8 cuando contienen únicamente la semilla de 32 bytes. Las claves que OpenSSL escribe por defecto en la forma semilla más clave expandida se rechazan, por lo que deben exportarse en la forma de solo semilla antes de importarlas.",{"_3844":80294,"_33198":80254,"_22654":135646,"_5":15607,"_29907":135549,"_3297":135647},[],"SLH-DSA es el esquema basado en funciones hash de FIPS 205. Ofrece doce conjuntos de parámetros que combinan una familia de hash (SHA-2 o SHAKE), el parámetro n de 128, 192 o 256 bits, que corresponde a las categorías de seguridad 1, 3 y 5 del NIST y un compromiso entre tamaño de firma y velocidad de firma (`s` para firmas pequeñas, `f` para firma rápida). El identificador que se escribe en `size` sigue el orden de la biblioteca subyacente:",{"_3844":80295,"_33198":80254,"_22654":135649,"_5":15607,"_29907":135549,"_3297":62543},[],{"_3844":80296,"_33198":80254,"_22654":135651,"_5":15607,"_29907":135549,"_3297":135652},[],"Conjunto de parámetros",{"_3844":80297,"_33198":80254,"_22654":135654,"_5":15607,"_29907":135549,"_3297":62543},[],{"_3844":80298,"_33198":80254,"_22654":135656,"_5":15607,"_29907":135549,"_3297":135652},[],{"_3844":80299,"_33198":80254,"_22654":135658,"_5":15607,"_29907":135549,"_3297":15694},[],{"_3844":80300,"_33198":80254,"_22654":135660,"_5":15607,"_29907":135549,"_3297":62555},[],{"_3844":80301,"_33198":80254,"_22654":135662,"_5":15607,"_29907":135549,"_3297":15715},[],{"_3844":80302,"_33198":80254,"_22654":135664,"_5":15607,"_29907":135549,"_3297":62560},[],{"_3844":80303,"_33198":80254,"_22654":135666,"_5":15607,"_29907":135549,"_3297":11301},[],{"_3844":80304,"_33198":80254,"_22654":135668,"_5":15607,"_29907":135549,"_3297":62565},[],{"_3844":80305,"_33198":80254,"_22654":135670,"_5":15607,"_29907":135549,"_3297":11166},[],{"_3844":80306,"_33198":80254,"_22654":135672,"_5":15607,"_29907":135549,"_3297":62570},[],{"_3844":80307,"_33198":80254,"_22654":135674,"_5":15607,"_29907":135549,"_3297":11245},[],{"_3844":80308,"_33198":80254,"_22654":135676,"_5":15607,"_29907":135549,"_3297":62575},[],{"_3844":80309,"_33198":80254,"_22654":135678,"_5":15607,"_29907":135549,"_3297":28527},[],{"_3844":80310,"_33198":80254,"_22654":135680,"_5":15607,"_29907":135549,"_3297":62580},[],{"_3844":80311,"_33198":80254,"_22654":135682,"_5":15607,"_29907":135549,"_3297":11150},[],{"_3844":80312,"_33198":80254,"_22654":135684,"_5":15607,"_29907":135549,"_3297":62585},[],{"_3844":80313,"_33198":80254,"_22654":135686,"_5":15607,"_29907":135549,"_3297":32341},[],{"_3844":80314,"_33198":80254,"_22654":135688,"_5":15607,"_29907":135549,"_3297":62590},[],{"_3844":80315,"_33198":80254,"_22654":135690,"_5":15607,"_29907":135549,"_3297":11376},[],{"_3844":80316,"_33198":80254,"_22654":135692,"_5":15607,"_29907":135549,"_3297":62595},[],{"_3844":80317,"_33198":80254,"_22654":135694,"_5":15607,"_29907":135549,"_3297":32375},[],{"_3844":80318,"_33198":80254,"_22654":135696,"_5":15607,"_29907":135549,"_3297":62600},[],{"_3844":80319,"_33198":80254,"_22654":135698,"_5":15607,"_29907":135549,"_3297":11158},[],{"_3844":80320,"_33198":80254,"_22654":135700,"_5":15607,"_29907":135549,"_3297":62605},[],{"_3844":80321,"_33198":80254,"_22654":135702,"_5":15607,"_29907":135549,"_3297":31849},[],{"_3844":80322,"_33198":80254,"_22654":135704,"_5":15607,"_29907":135549,"_3297":62610},[],{"_3844":80323,"_33198":80254,"_22654":135706,"_5":15607,"_29907":135549,"_3297":135707},[],"Los identificadores de objeto van de `2.16.840.1.101.3.4.3.20` a `.31`. Las firmas SLH-DSA son grandes, de entre unos 8 y 50 KB según el conjunto de parámetros, lo que importa en las cadenas de certificados y en cualquier transporte con un límite de tamaño. SLH-DSA está disponible para claves, CA y certificados, pero el fork no tiene esquema de firma TLS para él, por lo que un certificado SLH-DSA no puede autenticar una conexión TLS.",{"_3844":80324,"_33198":80254,"_22654":135709,"_5":15607,"_29907":135552,"_3297":135710},[],"Una clave composite empareja una clave ML-DSA con una clave tradicional. Una firma composite es la concatenación de la firma ML-DSA y la firma tradicional, ambas calculadas sobre un mensaje representativo que contiene un prefijo fijo, una etiqueta de algoritmo, un contexto opcional y un hash del mensaje; la verificación falla si falla cualquiera de los componentes. El componente ML-DSA es ML-DSA puro, con la etiqueta como contexto. Lamassu implementa los 15 algoritmos del borrador 19 de la especificación del IETF que dependen solo de algoritmos disponibles en Go. Los identificadores cuelgan del arco `1.3.6.1.5.5.7.6`.",{"_3844":80325,"_33198":80254,"_22654":135712,"_5":15607,"_29907":135552,"_3297":62619},[],{"_3844":80326,"_33198":80254,"_22654":135714,"_5":15607,"_29907":135552,"_3297":135715},[],"Algoritmo",{"_3844":80327,"_33198":80254,"_22654":135717,"_5":15607,"_29907":135552,"_3297":135718},[],"Último dígito del OID",{"_3844":80328,"_33198":80254,"_22654":135720,"_5":15607,"_29907":135552,"_3297":135721},[],"Familia",{"_3844":80329,"_33198":80254,"_22654":135723,"_5":15607,"_29907":135552,"_3297":15694},[],{"_3844":80330,"_33198":80254,"_22654":135725,"_5":15607,"_29907":135552,"_3297":62633},[],{"_3844":80331,"_33198":80254,"_22654":135727,"_5":15607,"_29907":135552,"_3297":33072},[],{"_3844":80332,"_33198":80254,"_22654":135729,"_5":15607,"_29907":135552,"_3297":62638},[],{"_3844":80333,"_33198":80254,"_22654":135731,"_5":15607,"_29907":135552,"_3297":11301},[],{"_3844":80334,"_33198":80254,"_22654":135733,"_5":15607,"_29907":135552,"_3297":62643},[],{"_3844":80335,"_33198":80254,"_22654":135735,"_5":15607,"_29907":135552,"_3297":33045},[],{"_3844":80336,"_33198":80254,"_22654":135737,"_5":15607,"_29907":135552,"_3297":62638},[],{"_3844":80337,"_33198":80254,"_22654":135739,"_5":15607,"_29907":135552,"_3297":11245},[],{"_3844":80338,"_33198":80254,"_22654":135741,"_5":15607,"_29907":135552,"_3297":62652},[],{"_3844":80339,"_33198":80254,"_22654":135743,"_5":15607,"_29907":135552,"_3297":31960},[],{"_3844":80340,"_33198":80254,"_22654":135745,"_5":15607,"_29907":135552,"_3297":62638},[],{"_3844":80341,"_33198":80254,"_22654":135747,"_5":15607,"_29907":135552,"_3297":11150},[],{"_3844":80342,"_33198":80254,"_22654":135749,"_5":15607,"_29907":135552,"_3297":62661},[],{"_3844":80343,"_33198":80254,"_22654":135751,"_5":15607,"_29907":135552,"_3297":31966},[],{"_3844":80344,"_33198":80254,"_22654":135753,"_5":15607,"_29907":135552,"_3297":62638},[],{"_3844":80345,"_33198":80254,"_22654":135755,"_5":15607,"_29907":135552,"_3297":11376},[],{"_3844":80346,"_33198":80254,"_22654":135757,"_5":15607,"_29907":135552,"_3297":62670},[],{"_3844":80347,"_33198":80254,"_22654":135759,"_5":15607,"_29907":135552,"_3297":31972},[],{"_3844":80348,"_33198":80254,"_22654":135761,"_5":15607,"_29907":135552,"_3297":62638},[],{"_3844":80349,"_33198":80254,"_22654":135763,"_5":15607,"_29907":135552,"_3297":11158},[],{"_3844":80350,"_33198":80254,"_22654":135765,"_5":15607,"_29907":135552,"_3297":62679},[],{"_3844":80351,"_33198":80254,"_22654":135767,"_5":15607,"_29907":135552,"_3297":11153},[],{"_3844":80352,"_33198":80254,"_22654":135769,"_5":15607,"_29907":135552,"_3297":62638},[],{"_3844":80353,"_33198":80254,"_22654":135771,"_5":15607,"_29907":135552,"_3297":15715},[],{"_3844":80354,"_33198":80254,"_22654":135773,"_5":15607,"_29907":135552,"_3297":62688},[],{"_3844":80355,"_33198":80254,"_22654":135775,"_5":15607,"_29907":135552,"_3297":31854},[],{"_3844":80356,"_33198":80254,"_22654":135777,"_5":15607,"_29907":135552,"_3297":62638},[],{"_3844":80357,"_33198":80254,"_22654":135779,"_5":15607,"_29907":135552,"_3297":11166},[],{"_3844":80358,"_33198":80254,"_22654":135781,"_5":15607,"_29907":135552,"_3297":62697},[],{"_3844":80359,"_33198":80254,"_22654":135783,"_5":15607,"_29907":135552,"_3297":31876},[],{"_3844":80360,"_33198":80254,"_22654":135785,"_5":15607,"_29907":135552,"_3297":62638},[],{"_3844":80361,"_33198":80254,"_22654":135787,"_5":15607,"_29907":135552,"_3297":28527},[],{"_3844":80362,"_33198":80254,"_22654":135789,"_5":15607,"_29907":135552,"_3297":62706},[],{"_3844":80363,"_33198":80254,"_22654":135791,"_5":15607,"_29907":135552,"_3297":31912},[],{"_3844":80364,"_33198":80254,"_22654":135793,"_5":15607,"_29907":135552,"_3297":62711},[],{"_3844":80365,"_33198":80254,"_22654":135795,"_5":15607,"_29907":135552,"_3297":32341},[],{"_3844":80366,"_33198":80254,"_22654":135797,"_5":15607,"_29907":135552,"_3297":62716},[],{"_3844":80367,"_33198":80254,"_22654":135799,"_5":15607,"_29907":135552,"_3297":31978},[],{"_3844":80368,"_33198":80254,"_22654":135801,"_5":15607,"_29907":135552,"_3297":62711},[],{"_3844":80369,"_33198":80254,"_22654":135803,"_5":15607,"_29907":135552,"_3297":32375},[],{"_3844":80370,"_33198":80254,"_22654":135805,"_5":15607,"_29907":135552,"_3297":62725},[],{"_3844":80371,"_33198":80254,"_22654":135807,"_5":15607,"_29907":135552,"_3297":31984},[],{"_3844":80372,"_33198":80254,"_22654":135809,"_5":15607,"_29907":135552,"_3297":62711},[],{"_3844":80373,"_33198":80254,"_22654":135811,"_5":15607,"_29907":135552,"_3297":31849},[],{"_3844":80374,"_33198":80254,"_22654":135813,"_5":15607,"_29907":135552,"_3297":62734},[],{"_3844":80375,"_33198":80254,"_22654":135815,"_5":15607,"_29907":135552,"_3297":31990},[],{"_3844":80376,"_33198":80254,"_22654":135817,"_5":15607,"_29907":135552,"_3297":62711},[],{"_3844":80377,"_33198":80254,"_22654":135819,"_5":15607,"_29907":135552,"_3297":32441},[],{"_3844":80378,"_33198":80254,"_22654":135821,"_5":15607,"_29907":135552,"_3297":62743},[],{"_3844":80379,"_33198":80254,"_22654":135823,"_5":15607,"_29907":135552,"_3297":31882},[],{"_3844":80380,"_33198":80254,"_22654":135825,"_5":15607,"_29907":135552,"_3297":62711},[],{"_3844":80381,"_33198":80254,"_22654":135827,"_5":15607,"_29907":135552,"_3297":32030},[],{"_3844":80382,"_33198":80254,"_22654":135829,"_5":15607,"_29907":135552,"_3297":62752},[],{"_3844":80383,"_33198":80254,"_22654":135831,"_5":15607,"_29907":135552,"_3297":33078},[],{"_3844":80384,"_33198":80254,"_22654":135833,"_5":15607,"_29907":135552,"_3297":62439},[],{"_3844":80385,"_33198":80254,"_22654":135835,"_5":15607,"_29907":135552,"_3297":32447},[],{"_3844":80386,"_33198":80254,"_22654":135837,"_5":15607,"_29907":135552,"_3297":62761},[],{"_3844":80387,"_33198":80254,"_22654":135839,"_5":15607,"_29907":135552,"_3297":31954},[],{"_3844":80388,"_33198":80254,"_22654":135841,"_5":15607,"_29907":135552,"_3297":62439},[],{"_3844":80389,"_33198":80254,"_22654":135843,"_5":15607,"_29907":135552,"_3297":135844},[],"El tipo de clave debe coincidir con la familia de la variante: crear una clave `Composite-ML-DSA-ECDSA` con `size` 3 falla con un error que indica que la variante no es válida para ese tipo de clave.",{"_3844":80390,"_33198":80254,"_22654":135846,"_5":15607,"_29907":135552,"_3297":135847},[],"El borrador 19 se ha publicado desde entonces como RFC 10073. Los identificadores de objeto y el prefijo de separación de dominio comprobados frente al RFC coinciden con esta página, pero la implementación se escribió y se probó contra el borrador y no se ha comparado con el texto final. Tres algoritmos de la especificación no están implementados porque Go no dispone de curvas Brainpool ni de Ed448: las dos variantes Brainpool (`MLDSA65-ECDSA-brainpoolP256r1` y `MLDSA87-ECDSA-brainpoolP384r1`, con su sufijo de hash) y la variante Ed448. El fork supera los vectores de prueba oficiales del borrador 19 para los 15 algoritmos que sí implementa.",{"_3844":80391,"_33198":80254,"_22654":135849,"_5":15607,"_29907":135552,"_3297":135850},[],"Los parámetros de las claves y de las firmas composite deben estar ausentes en el `AlgorithmIdentifier`; los certificados que los incluyen se rechazan. Los componentes ECDSA deben usar un escalar privado con la longitud exacta de la curva.",{"_3844":80392,"_33198":80254,"_22654":135852,"_5":15607,"_29907":135556,"_3297":135853},[],"Ed25519 no es poscuántico, pero el soporte como tipo de clave de CA y de certificado se añadió en el mismo trabajo y se selecciona con el tipo de clave `Ed25519`. Se clasifica en la familia tradicional.",{"_3844":80393,"_33198":80254,"_22654":135855,"_5":15607,"_29907":135559,"_3297":135856},[],"Lamassu no implementa intercambio de claves poscuántico propio. Los intercambios de claves híbridos que ofrece el endpoint TLS, como `X25519MLKEM768`, son los de la biblioteca estándar de Go 1.27. Los diseños de certificados Chameleon y delta que se exploraron en iteraciones anteriores se eliminaron y no forman parte de la implementación.",{"_3844":80394,"_33198":80254,"_22654":135858,"_5":15607,"_29907":135559,"_3297":135859},[],"<Card title=\"Toolchain de Go PQC\" description=\"El fork que implementa estos algoritmos y la API que añade.\" href=\"/docs/platform/pqc/go-toolchain\" />",{"_3844":80395,"_33198":80254,"_22654":135861,"_5":15607,"_29907":135559,"_3297":135862},[],"<Card title=\"Claves y autoridades de certificación\" description=\"Usar estos parámetros en las peticiones al KMS y a la CA.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_3844":80396,"_33198":80396,"_5":16006,"_3297":62788,"_33604":135864,"_22654":135866,"_29907":80396},[54402,129149,135534,135865],"Soporte en la plataforma",[],{"_3844":80397,"_33198":80396,"_22654":135868,"_5":15607,"_29907":80396,"_3297":135869},[],"Cómo expone la interfaz web los algoritmos poscuánticos al crear claves, CA y certificados, y cómo los muestra.",{"_3844":80398,"_33198":80396,"_5":33601,"_22654":135871,"_29907":135872,"_3297":135873},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#elegir-tipo-de-clave-y-especificación","Elegir tipo de clave y especificación",{"_3844":80399,"_33198":80396,"_5":33601,"_22654":135875,"_29907":135876,"_3297":135877},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#emitir-un-certificado-con-una-clave-generada-en-el-navegador","Emitir un certificado con una clave generada en el navegador",{"_3844":80400,"_33198":80396,"_5":33601,"_22654":135879,"_29907":135880,"_3297":135881},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#cómo-se-muestran-los-objetos","Cómo se muestran los objetos",{"_3844":80401,"_33198":80396,"_5":33601,"_22654":135883,"_29907":135884,"_3297":135885},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#certificados-relacionados","Certificados relacionados",{"_3844":80402,"_33198":80396,"_5":33601,"_22654":135887,"_29907":135888,"_3297":135889},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#aspectos-a-tener-en-cuenta","Aspectos a tener en cuenta",{"_3844":80403,"_33198":80396,"_22654":135891,"_5":15607,"_29907":80396,"_3297":135892},[],"El dashboard (rama `feat/lamassu-q`) permite a un administrador crear e inspeccionar claves, autoridades de certificación y certificados poscuánticos sin escribir peticiones a la API. Añade las opciones de algoritmo, muestra la familia de algoritmo de cada objeto e interpreta los nuevos identificadores en los certificados. Todo lo que envía se describe en Claves y autoridades de certificación; esta página cubre lo que muestra la interfaz y dónde difiere su comportamiento entre pantallas.",{"_3844":80404,"_33198":80396,"_22654":135894,"_5":15607,"_29907":135872,"_3297":135895},[],"Crear una clave del KMS, una CA con una clave nueva y un certificado con clave generada en el servidor usan el mismo par de selectores. *Key type* está agrupado por familia y *Key specification* depende del tipo.",{"_3844":80405,"_33198":80396,"_22654":135897,"_5":15607,"_29907":135872,"_3297":135898},[],"Grupo",{"_3844":80406,"_33198":80396,"_22654":135900,"_5":15607,"_29907":135872,"_3297":135901},[],"Tipos de clave",{"_3844":80407,"_33198":80396,"_22654":135903,"_5":15607,"_29907":135872,"_3297":62829},[],{"_3844":80408,"_33198":80396,"_22654":135905,"_5":15607,"_29907":135872,"_3297":62832},[],{"_3844":80409,"_33198":80396,"_22654":135907,"_5":15607,"_29907":135872,"_3297":62835},[],{"_3844":80410,"_33198":80396,"_22654":135909,"_5":15607,"_29907":135872,"_3297":62838},[],{"_3844":80411,"_33198":80396,"_22654":135911,"_5":15607,"_29907":135872,"_3297":62841},[],{"_3844":80412,"_33198":80396,"_22654":135913,"_5":15607,"_29907":135872,"_3297":62844},[],{"_3844":80413,"_33198":80396,"_22654":135915,"_5":15607,"_29907":135872,"_3297":135916},[],"La lista de especificaciones muestra ML-DSA-44, -65 o -87, los doce conjuntos de parámetros de SLH-DSA (por ejemplo *4 - SHAKE\\_128f*) o las variantes composite por nombre. La interfaz envía como `size` el identificador del conjunto de parámetros, según se explica en Algoritmos, y muestra un indicador de fortaleza junto a cada opción. En las claves composite el indicador muestra dos barras, una para el componente clásico y otra para el poscuántico.",{"_3844":80414,"_33198":80396,"_22654":135918,"_5":15607,"_29907":135872,"_3297":135919},[],"Las opciones habilitadas dependen del motor criptográfico. Al crear una clave o una CA, la interfaz lista todos los algoritmos pero deshabilita los que el motor seleccionado no soporta, y pide seleccionar antes un motor. Al crear un certificado en el servidor, los tipos no soportados se ocultan en su lugar.",{"_3844":80415,"_33198":80396,"_22654":135921,"_5":15607,"_29907":135876,"_3297":135922},[],"Emitir un certificado desde una CA genera el par de claves en el navegador, construye la solicitud de certificado y la envía a la CA para su firma. Los tipos de clave que se ofrecen aquí son `RSA`, `ECDSA`, `Ed25519`, `ML-DSA`, `SLH-DSA` y una única entrada `Composite ML-DSA`, y se generan con las bibliotecas `@noble` para los algoritmos poscuánticos y composite y con WebCrypto para los clásicos. La clave privada generada se muestra una sola vez al final del procedimiento.",{"_3844":80416,"_33198":80396,"_22654":135924,"_5":15607,"_29907":135876,"_3297":135925},[],"El navegador no verifica las firmas de las solicitudes ML-DSA, SLH-DSA, composite ni Ed25519; confía en el KMS.",{"_3844":80417,"_33198":80396,"_22654":135927,"_5":15607,"_29907":135880,"_3297":135928},[],"Las listas y las vistas de detalle muestran la familia del algoritmo. La tabla de CA tiene una columna *PQC* con T, PQ o PQ/T, las tarjetas de CA y el grafo de CA muestran una insignia *PQC*, las listas de claves muestran un icono cuántico, y el detalle de una CA o un certificado muestra el algoritmo, su fortaleza y la insignia de familia. La familia se calcula a partir del identificador de algoritmo del certificado interpretado.",{"_3844":80418,"_33198":80396,"_22654":135930,"_5":15607,"_29907":135880,"_3297":135931},[],"Los nombres de algoritmo se resuelven a partir de los identificadores de objeto. Los identificadores de ML-DSA, SLH-DSA, composite y Ed25519 se muestran como nombres con su conjunto de parámetros, por ejemplo *ML-DSA-65* o *Composite-Signature MLDSA65-ECDSA-P384-SHA512*, y para ellos no se muestra longitud en bits. Los algoritmos de firma RSA y ECDSA se muestran con etiquetas propias del dashboard, como *RSA PKCS#1 v1.5 SHA-256* y *ECDSA SHA-256*, en lugar de los nombres de OpenSSL `sha256WithRSAEncryption` y `ecdsa-with-SHA256`.",{"_3844":80419,"_33198":80396,"_22654":135933,"_5":15607,"_29907":135880,"_3297":135934},[],"La página de detalle de una clave puede firmar y verificar con una clave poscuántica y habilita únicamente el algoritmo de firma que le corresponde.",{"_3844":80420,"_33198":80396,"_22654":135936,"_5":15607,"_29907":135884,"_3297":135937},[],"El formulario del perfil de emisión, el formulario de emisión de certificados y las páginas de detalle incluyen los controles de certificados relacionados descritos en Certificados relacionados.",{"_3844":80421,"_33198":80396,"_22654":135939,"_5":15607,"_29907":135888,"_3297":135940},[],"Los nombres de los tipos de clave no son idénticos en todas las pantallas. La creación de claves y de CA usa `Composite-ML-DSA-RSA`, `-ECDSA` y `-Ed25519`; el formulario de emisión de certificados usa un único `Composite-ML-DSA`; y el formulario de certificado en el servidor compara nombres en mayúsculas. Los nombres que el backend informa para una clave pueden diferir, por tanto, en mayúsculas y minúsculas de lo que envía la interfaz.",{"_3844":80422,"_33198":80396,"_22654":135942,"_5":15607,"_29907":135888,"_3297":135943},[],"La interfaz no incluye ningún aviso de carácter experimental para estos algoritmos y no está traducida: todos los textos están en inglés.",{"_3844":80423,"_33198":80396,"_22654":135945,"_5":15607,"_29907":135888,"_3297":135946},[],"La correspondencia entre el identificador del conjunto de parámetros de SLH-DSA y el algoritmo que usa el generador de claves del navegador no sigue el mismo orden que los identificadores que muestra el selector y que usa el backend, salvo en el identificador 1. Un certificado emitido por el flujo del navegador con un identificador SLH-DSA del 2 al 12 puede usar, por tanto, un conjunto de parámetros distinto del que nombra el selector. Hasta que se corrija, conviene crear las claves SLH-DSA con el KMS.",{"_3844":80424,"_33198":80396,"_22654":135948,"_5":15607,"_29907":135888,"_3297":135949},[],"<Card title=\"Claves y autoridades de certificación\" description=\"La API que hay detrás de estas pantallas.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_3844":80425,"_33198":80396,"_22654":135951,"_5":15607,"_29907":135888,"_3297":135952},[],"<Card title=\"Limitaciones conocidas\" description=\"Carencias de la interfaz y de la plataforma.\" href=\"/docs/platform/pqc/limitations\" />",{"_3844":80426,"_33198":80426,"_5":16006,"_3297":135954,"_33604":135955,"_22654":135956,"_29907":80426},"Despliegue con el Helm chart",[54402,129149,135534,127718],[],{"_3844":80427,"_33198":80426,"_22654":135958,"_5":15607,"_29907":80426,"_3297":135959},[],"Desplegar Lamassu con un proxy frontal Traefik que sirve certificados clásicos, poscuánticos y composite, mediante los valores del chart o el instalador fast-lane.",{"_3844":80428,"_33198":80426,"_5":33601,"_22654":135961,"_29907":135962,"_3297":135963},[],"/docs/pr-preview/pr-58/es/platform/pqc/deployment#topología","Topología",{"_3844":80429,"_33198":80426,"_5":33601,"_22654":135965,"_29907":135966,"_3297":135967},[],"/docs/pr-preview/pr-58/es/platform/pqc/deployment#valores-del-chart","Valores del chart",{"_3844":80430,"_33198":80426,"_5":33601,"_22654":135969,"_29907":135970,"_3297":135971},[],"/docs/pr-preview/pr-58/es/platform/pqc/deployment#el-instalador-fast-lane","El instalador fast-lane",{"_3844":80431,"_33198":80426,"_22654":135973,"_5":15607,"_29907":80426,"_3297":135974},[],"La rama `pqc` del Helm chart de Lamassu añade un proxy frontal: una instancia de Traefik compilada con el toolchain de Go PQC que termina el TLS de los dispositivos, los autentica y reenvía el tráfico a Envoy Gateway. Esta página describe la topología resultante, los valores que la controlan y el instalador que automatiza un despliegue de laboratorio.",{"_3844":80432,"_33198":80426,"_22654":135976,"_5":15607,"_29907":80426,"_3297":135977},[],"El chart y el instalador asumen un clúster de desarrollo. La imagen del proxy usa una etiqueta mutable, los certificados PQC no se renuevan automáticamente y el salto entre Traefik y Envoy no verifica certificados. Esta configuración no debe usarse tal cual en producción.",{"_3844":80433,"_33198":80426,"_22654":135979,"_5":15607,"_29907":135962,"_3297":135980},[],"Traefik es el borde público. Negocia el intercambio de claves, sirve el certificado y, si se solicita, recibe el certificado del cliente. Después abre una segunda conexión TLS hacia el servicio `envoy-gateway-proxy` de Envoy Gateway, que presenta el certificado clásico autofirmado del chart; Traefik está configurado para aceptarlo sin verificarlo. Envoy no llega a ver, por tanto, un handshake poscuántico, y la protección poscuántica cubre solo la conexión entre el cliente y Traefik. Traefik y Envoy Gateway se instalan una sola vez por clúster y se comparten entre espacios de nombres, mientras que los recursos del proxy frontal (el Gateway, la ruta, el middleware, el certificado y el reference grant) pertenecen a la release de Lamassu.",{"_3844":80434,"_33198":80426,"_22654":135982,"_5":15607,"_29907":135962,"_3297":135983},[],"Cuando el cliente ha enviado un certificado, el middleware `inject-client-cert` del chart lo añade, en formato PEM, a la cabecera `X-Forwarded-Tls-Client-Cert`, y se establece la cabecera `X-Forwarded-Proto: https` en la petición.",{"_3844":80435,"_33198":80426,"_22654":135985,"_5":15607,"_29907":135966,"_3297":135986},[],"Todos los valores nuevos están bajo `traefikFrontProxy` y los valida el esquema del chart, que rechaza claves desconocidas.",{"_3844":80436,"_33198":80426,"_22654":135988,"_5":15607,"_29907":135966,"_3297":135989},[],"Nombre",{"_3844":80437,"_33198":80426,"_22654":135991,"_5":15607,"_29907":135966,"_3297":131763},[],{"_3844":80438,"_33198":80426,"_22654":135993,"_5":15607,"_29907":135966,"_3297":135994},[],"Valor por defecto",{"_3844":80439,"_33198":80426,"_22654":135996,"_5":15607,"_29907":135966,"_3297":131769},[],{"_3844":80440,"_33198":80426,"_22654":135998,"_5":15607,"_29907":135966,"_3297":62929},[],{"_3844":80441,"_33198":80426,"_22654":136000,"_5":15607,"_29907":135966,"_3297":108905},[],{"_3844":80442,"_33198":80426,"_22654":136002,"_5":15607,"_29907":135966,"_3297":62934},[],{"_3844":80443,"_33198":80426,"_22654":136004,"_5":15607,"_29907":135966,"_3297":136005},[],"Despliega los recursos del proxy frontal.",{"_3844":80444,"_33198":80426,"_22654":136007,"_5":15607,"_29907":135966,"_3297":62940},[],{"_3844":80445,"_33198":80426,"_22654":136009,"_5":15607,"_29907":135966,"_3297":101464},[],{"_3844":80446,"_33198":80426,"_22654":136011,"_5":15607,"_29907":135966,"_3297":62945},[],{"_3844":80447,"_33198":80426,"_22654":136013,"_5":15607,"_29907":135966,"_3297":136014},[],"Nombre del certificado de borde y nombre de host de la ruta. Debe indicarse cuando el proxy está habilitado.",{"_3844":80448,"_33198":80426,"_22654":136016,"_5":15607,"_29907":135966,"_3297":62951},[],{"_3844":80449,"_33198":80426,"_22654":136018,"_5":15607,"_29907":135966,"_3297":87371},[],{"_3844":80450,"_33198":80426,"_22654":136020,"_5":15607,"_29907":135966,"_3297":62956},[],{"_3844":80451,"_33198":80426,"_22654":136022,"_5":15607,"_29907":135966,"_3297":136023},[],"Puerto del listener HTTPS; debe coincidir con el entry point `websecure` de Traefik.",{"_3844":80452,"_33198":80426,"_22654":136025,"_5":15607,"_29907":135966,"_3297":62962},[],{"_3844":80453,"_33198":80426,"_22654":136027,"_5":15607,"_29907":135966,"_3297":101464},[],{"_3844":80454,"_33198":80426,"_22654":136029,"_5":15607,"_29907":135966,"_3297":62967},[],{"_3844":80455,"_33198":80426,"_22654":136031,"_5":15607,"_29907":135966,"_3297":136032},[],"Origen del certificado clásico: `certManager`, `external` o `none`.",{"_3844":80456,"_33198":80426,"_22654":136034,"_5":15607,"_29907":135966,"_3297":62973},[],{"_3844":80457,"_33198":80426,"_22654":136036,"_5":15607,"_29907":135966,"_3297":94884},[],{"_3844":80458,"_33198":80426,"_22654":136038,"_5":15607,"_29907":135966,"_3297":62978},[],{"_3844":80459,"_33198":80426,"_22654":136040,"_5":15607,"_29907":135966,"_3297":136041},[],"Direcciones IP añadidas al certificado autofirmado.",{"_3844":80460,"_33198":80426,"_22654":136043,"_5":15607,"_29907":135966,"_3297":62984},[],{"_3844":80461,"_33198":80426,"_22654":136045,"_5":15607,"_29907":135966,"_3297":101464},[],{"_3844":80462,"_33198":80426,"_22654":136047,"_5":15607,"_29907":135966,"_3297":62945},[],{"_3844":80463,"_33198":80426,"_22654":136049,"_5":15607,"_29907":135966,"_3297":136050},[],"Secret con `tls.crt` y `tls.key` cuando el tipo es `external`.",{"_3844":80464,"_33198":80426,"_22654":136052,"_5":15607,"_29907":135966,"_3297":62994},[],{"_3844":80465,"_33198":80426,"_22654":136054,"_5":15607,"_29907":135966,"_3297":94884},[],{"_3844":80466,"_33198":80426,"_22654":136056,"_5":15607,"_29907":135966,"_3297":62978},[],{"_3844":80467,"_33198":80426,"_22654":136058,"_5":15607,"_29907":135966,"_3297":136059},[],"Secrets TLS adicionales, por ejemplo certificados ML-DSA o composite, que se sirven en el mismo listener.",{"_3844":80468,"_33198":80426,"_22654":136061,"_5":15607,"_29907":135966,"_3297":136062},[],"Con `certManager`, el chart solicita un certificado ECDSA P-256 válido durante 2160 horas a su propio emisor autofirmado y lo guarda en el secret `edge-cert`. Con `none`, solo se sirven los secrets adicionales, y el chart se detiene con un error si no hay ninguno. El proxy elige entre todos los certificados según el cliente, tal como describe Proxy TLS con Traefik. Los nombres de los recursos que crea el chart son fijos, por lo que solo se admite una release por espacio de nombres.",{"_3844":80469,"_33198":80426,"_22654":136064,"_5":15607,"_29907":135966,"_3297":136065},[],"El chart modifica además el servicio de Envoy Gateway para que su puerto HTTPS declare `appProtocol: https`, algo que las versiones recientes de Traefik necesitan para hablar TLS con él. Cuando `gateway.addresses` está vacío, el servicio de Envoy es de tipo `ClusterIP` en lugar de un balanceador de carga.",{"_3844":80470,"_33198":80426,"_22654":136067,"_5":15607,"_29907":135966,"_3297":136068},[],"El chart no despliega Traefik, ni la GatewayClass `traefik`, ni la opción TLS `default` en el espacio de nombres `traefik-system`; los crea el instalador. Sin ellos, el borde no tiene intercambio de claves poscuántico ni solicitud de certificado de cliente. Tampoco fija las imágenes de los servicios de Lamassu: los valores por defecto son las imágenes de desarrollo, y el instalador sustituye las de la interfaz, CA, KMS, VA, device manager, DMS manager, alertas y autorización por las etiquetas `:pqc` de `ghcr.io/lamassuiot`.",{"_3844":80471,"_33198":80426,"_22654":136070,"_5":15607,"_29907":135970,"_3297":136071},[],"`scripts/lamassu-fast-lane.sh` instala todo en un clúster: las definiciones de recursos personalizados de Gateway API (versión 1.6.3, canal experimental), Envoy Gateway 1.8.0, el chart de Traefik 41.0.2 con la imagen PQC, la opción TLS, PostgreSQL, Keycloak, RabbitMQ, opcionalmente observabilidad y SoftHSM, y por último la release de Lamassu. Los dos parámetros relevantes aquí seleccionan qué algoritmos se ofrecen.",{"_3844":80472,"_33198":80426,"_22654":136073,"_5":15607,"_29907":135970,"_3297":136074},[],"Ambos parámetros aceptan una lista separada por comas de `T`, `PQ` y `PQ/T`, y ambos toman por defecto los tres valores. En el intercambio de claves, `PQ/T` es un grupo híbrido que combina un intercambio clásico y uno ML-KEM (`X25519MLKEM768`, `SecP256r1MLKEM768` y `SecP384r1MLKEM1024`) y `PQ` es ML-KEM puro (`MLKEM1024`); en la autenticación, `PQ/T` es un certificado composite. `--tls-kex` rellena los `curvePreferences` de la opción TLS, y `--tls-auth` selecciona qué certificados se sirven:",{"_3844":80473,"_33198":80426,"_22654":136076,"_5":15607,"_29907":135970,"_3297":136077},[],"Valor",{"_3844":80474,"_33198":80426,"_22654":136079,"_5":15607,"_29907":135970,"_3297":136080},[],"Grupos de intercambio de claves",{"_3844":80475,"_33198":80426,"_22654":136082,"_5":15607,"_29907":135970,"_3297":131949},[],{"_3844":80476,"_33198":80426,"_22654":136084,"_5":15607,"_29907":135970,"_3297":63027},[],{"_3844":80477,"_33198":80426,"_22654":136086,"_5":15607,"_29907":135970,"_3297":63030},[],{"_3844":80478,"_33198":80426,"_22654":136088,"_5":15607,"_29907":135970,"_3297":136089},[],"ECDSA P-256 de cert-manager, o los ficheros indicados con `--tls-crt` y `--tls-key`, en el secret `edge-cert`.",{"_3844":80479,"_33198":80426,"_22654":136091,"_5":15607,"_29907":135970,"_3297":63036},[],{"_3844":80480,"_33198":80426,"_22654":136093,"_5":15607,"_29907":135970,"_3297":63039},[],{"_3844":80481,"_33198":80426,"_22654":136095,"_5":15607,"_29907":135970,"_3297":136096},[],"ML-DSA-65, en el secret `edge-cert-pq`.",{"_3844":80482,"_33198":80426,"_22654":136098,"_5":15607,"_29907":135970,"_3297":63045},[],{"_3844":80483,"_33198":80426,"_22654":136100,"_5":15607,"_29907":135970,"_3297":63048},[],{"_3844":80484,"_33198":80426,"_22654":136102,"_5":15607,"_29907":135970,"_3297":136103},[],"Composite `MLDSA65-RSA3072-PSS-SHA512`, en el secret `edge-cert-pqt`.",{"_3844":80485,"_33198":80426,"_22654":136105,"_5":15607,"_29907":135970,"_3297":136106},[],"La versión mínima de TLS es 1.3, salvo que ambos parámetros sean solo `T`, en cuyo caso es 1.2. cert-manager no puede emitir certificados poscuánticos, por lo que el instalador crea los certificados PQ y PQ/T localmente con OpenSSL 3.5 o posterior; el certificado composite necesita además el módulo `hybrid-provider`, que el script compila bajo demanda con `git`, `cmake` y un compilador de C. Las claves privadas ML-DSA se escriben en la forma de solo semilla que Go acepta, y los secrets se crean a partir de un manifiesto porque `kubectl create secret tls` rechaza claves ML-DSA. Los certificados duran 365 días y se conservan si el secret ya existe.",{"_3844":80486,"_33198":80426,"_22654":136108,"_5":15607,"_29907":135970,"_3297":136109},[],"El script requiere `yq`, `kubectl` y `helm`, y `jq` con `--sample-data`. Al terminar imprime cómo extraer la CA en la que deben confiar los dispositivos, por ejemplo `kubectl get secret edge-cert-pq -o jsonpath='{.data.ca\\.crt}'`.",{"_3844":80487,"_33198":80426,"_22654":136111,"_5":15607,"_29907":135970,"_3297":136112},[],"Los scripts complementarios para un broker MQTT detrás de Traefik (`scripts/emqx`), para exportar claves del KMS y para restaurar una copia de seguridad están presentes en el árbol de trabajo del chart, pero sin confirmar en el repositorio. Son solo para uso en laboratorio y no se describen más aquí.",{"_3844":80488,"_33198":80426,"_22654":136114,"_5":15607,"_29907":135970,"_3297":136115},[],"<Card title=\"Proxy TLS con Traefik\" description=\"Cómo elige certificado el proxy y cómo se compila.\" href=\"/docs/platform/pqc/tls-front-proxy\" />",{"_3844":80489,"_33198":80426,"_22654":136117,"_5":15607,"_29907":135970,"_3297":136118},[],"<Card title=\"Limitaciones conocidas\" description=\"Advertencias del despliegue de laboratorio.\" href=\"/docs/platform/pqc/limitations\" />",{"_3844":80490,"_33198":80490,"_5":16006,"_3297":136120,"_33604":136121,"_22654":136122,"_29907":80490},"Toolchain de Go PQC",[54402,129149,135534,135535],[],{"_3844":80491,"_33198":80490,"_22654":136124,"_5":15607,"_29907":80490,"_3297":136125},[],"El fork de Go que añade ML-DSA composite, SLH-DSA, certificados relacionados y esquemas de firma TLS composite, la API que expone y cómo se compila.",{"_3844":80492,"_33198":80490,"_5":33601,"_22654":136127,"_29907":136128,"_3297":136129},[],"/docs/pr-preview/pr-58/es/platform/pqc/go-toolchain#qué-añade-el-fork","Qué añade el fork",{"_3844":80493,"_33198":80490,"_5":33601,"_22654":136131,"_29907":136132,"_3297":136133},[],"/docs/pr-preview/pr-58/es/platform/pqc/go-toolchain#puntos-de-código-tls","Puntos de código TLS",{"_3844":80494,"_33198":80490,"_5":33601,"_22654":136135,"_29907":136136,"_3297":136137},[],"/docs/pr-preview/pr-58/es/platform/pqc/go-toolchain#un-ejemplo-mínimo","Un ejemplo mínimo",{"_3844":80495,"_33198":80490,"_5":33601,"_22654":136139,"_29907":136140,"_3297":136141},[],"/docs/pr-preview/pr-58/es/platform/pqc/go-toolchain#qué-se-eliminó","Qué se eliminó",{"_3844":80496,"_33198":80490,"_5":33601,"_22654":136143,"_29907":136144,"_3297":136145},[],"/docs/pr-preview/pr-58/es/platform/pqc/go-toolchain#compilación-del-toolchain-y-de-las-imágenes","Compilación del toolchain y de las imágenes",{"_3844":80497,"_33198":80490,"_22654":136147,"_5":15607,"_29907":80490,"_3297":136148},[],"Go 1.27 incluye ML-DSA en `crypto/mldsa` y en X.509 y TLS, pero no tiene certificados composite ni SLH-DSA, ni certificados relacionados, ni esquemas de firma TLS composite. Por ello Lamassu compila su backend y su proxy TLS con un fork de Go, mantenido en la rama `release-branch.go1.27`. Esta página describe lo que añade el fork, para quienes compilan Lamassu o escriben un cliente que debe comunicarse con él.",{"_3844":80498,"_33198":80490,"_22654":136150,"_5":15607,"_29907":80490,"_3297":136151},[],"El fork expone APIs que no existen en la distribución oficial de Go. El código que las usa solo compila con este toolchain, y no debe suponerse que un binario construido con él cumple la promesa de compatibilidad de Go para esas APIs.",{"_3844":80499,"_33198":80490,"_22654":136153,"_5":15607,"_29907":136128,"_3297":136154},[],"**ML-DSA composite en X.509.** El paquete `x509` incorpora `CompositePublicKey` y `CompositePrivateKey`, que implementan `crypto.Signer`, y 15 valores `CompositeAlgorithm` (por ejemplo `x509.MLDSA65_ECDSA_P384_SHA512`) que permiten generar claves, firmar y verificar. Los certificados, las solicitudes de certificado y las listas de revocación firmados con estas claves se interpretan, se serializan y se verifican como cualquier otro. Se admite la codificación PKCS#8 de claves privadas composite. La página de algoritmos enumera los identificadores.",{"_3844":80500,"_33198":80490,"_22654":136156,"_5":15607,"_29907":136128,"_3297":136157},[],"**SLH-DSA en X.509.** El algoritmo de clave pública `x509.SLHDSA` y doce algoritmos de firma `PureSLHDSA...` están disponibles para interpretar y verificar certificados y claves. La implementación es la biblioteca `circl` de Cloudflare incorporada al fork. Es la parte menos probada: no tiene pruebas propias en x509 ni soporte TLS.",{"_3844":80501,"_33198":80490,"_22654":136159,"_5":15607,"_29907":136128,"_3297":136160},[],"**Certificados relacionados (RFC 9763).** El fork ofrece `x509.CreateBoundCertificate`, que añade a un certificado la extensión `id-pe-relatedCert` (`1.3.6.1.5.5.7.1.36`), `x509.VerifyRelatedCertificate` y las funciones para construir y comprobar el atributo `relatedCertRequest` de una solicitud de certificado (`1.2.840.113549.1.9.16.2.60`). `x509.CertificateRequest` incorpora el campo `ExtraAttributes` para transportarlo. Certificados relacionados explica cómo los usa Lamassu.",{"_3844":80502,"_33198":80490,"_22654":136162,"_5":15607,"_29907":136128,"_3297":136163},[],"**Esquemas de firma composite en TLS.** El paquete `tls` añade 15 constantes `SignatureScheme`, una por algoritmo composite, que se anuncian por defecto después de los esquemas ML-DSA nativos. Solo funcionan con TLS 1.3 y están probadas con autenticación mutua. Sus puntos de código se describen a continuación.",{"_3844":80503,"_33198":80490,"_22654":136165,"_5":15607,"_29907":136132,"_3297":136166},[],"IANA no ha asignado puntos de código a los esquemas de firma TLS composite, por lo que el fork usa el rango de uso privado `0xFE00` a `0xFE0E`, en el orden de la tabla composite: `0xFE00` es `MLDSA44-RSA2048-PSS-SHA256` y `0xFE0E` es `MLDSA65-Ed25519-SHA512`. Un cliente o un servidor construido con una biblioteca TLS estándar no los reconoce y recurrirá a otro esquema o fallará en el handshake. La interoperabilidad queda así limitada a pares construidos con este fork, o a los esquemas ML-DSA nativos (`0x0904` a `0x0906`) que implementa Go 1.27 estándar.",{"_3844":80504,"_33198":80490,"_22654":136168,"_5":15607,"_29907":136132,"_3297":136169},[],"Las tres variantes que usan RSA PKCS#1 v1.5 (`MLDSA44-RSA2048-PKCS15-SHA256`, `MLDSA65-RSA3072-PKCS15-SHA512` y `MLDSA65-RSA4096-PKCS15-SHA512`) se anuncian únicamente en la extensión `signature_algorithms_cert`, por lo que pueden aparecer en una cadena de certificados, pero un certificado hoja con una clave de ese tipo no puede firmar el handshake.",{"_3844":80505,"_33198":80490,"_22654":136171,"_5":15607,"_29907":136132,"_3297":136172},[],"El intercambio de claves no cambia respecto a Go original. Los grupos híbridos como `X25519MLKEM768`, `SecP256r1MLKEM768`, `SecP384r1MLKEM1024` y el `MLKEM1024` puro son los de la biblioteca estándar de Go 1.27.",{"_3844":80506,"_33198":80490,"_22654":136174,"_5":15607,"_29907":136136,"_3297":136175},[],"El siguiente programa crea un certificado composite autofirmado y lo usa como certificado de servidor en una configuración TLS 1.3. Se omite la gestión de errores.",{"_3844":80507,"_33198":80490,"_22654":136177,"_5":15607,"_29907":136136,"_3297":136178},[],"Una clave composite también puede firmar directamente un mensaje, con un contexto opcional de como máximo 255 bytes:",{"_3844":80508,"_33198":80490,"_22654":136180,"_5":15607,"_29907":136140,"_3297":136181},[],"Las primeras iteraciones del fork exploraron certificados Chameleon (`draft-bonnell-lamps-chameleon-certs`) y una construcción de certificados delta. Se eliminaron porque ya no se persiguen. El mecanismo de certificados relacionados se recuperó después por separado, siguiendo el RFC 9763.",{"_3844":80509,"_33198":80490,"_22654":136183,"_5":15607,"_29907":136144,"_3297":136184},[],"El fork se compila en CI mediante un workflow que ejecuta la batería de pruebas de Go y después publica una imagen multiarquitectura, `ghcr.io/lamassuiot/golang-pqc`, con la etiqueta `go1.27` y, para la rama `release-branch.go1.27`, `latest`. La imagen contiene el toolchain en `/usr/local/go-pqc`, con `GOROOT` apuntando a esa ruta.",{"_3844":80510,"_33198":80490,"_22654":136186,"_5":15607,"_29907":136144,"_3297":136187},[],"Lamassu consume el toolchain de dos maneras. Las imágenes del backend (CA, KMS, VA, alertas, device manager, DMS manager y la compilación monolítica) usan `ghcr.io/lamassuiot/golang-pqc:latest` como imagen de compilación. El workflow de CI del backend instala el mismo toolchain mediante una acción de configuración propia, en lugar de `actions/setup-go`, y el backend exige `go 1.27.3` en su fichero de módulo. Traefik no se compila desde la imagen: su script `build.sh` espera una copia ya compilada del fork en un directorio vecino y genera el binario fuera de un contenedor. Véase Proxy TLS con Traefik.",{"_3844":80511,"_33198":80490,"_22654":136189,"_5":15607,"_29907":136144,"_3297":136190},[],"<Card title=\"Algoritmos\" description=\"Los identificadores y conjuntos de parámetros que hay detrás de estas constantes.\" href=\"/docs/platform/pqc/algorithms\" />",{"_3844":80512,"_33198":80490,"_22654":136192,"_5":15607,"_29907":136144,"_3297":136193},[],"<Card title=\"Proxy TLS con Traefik\" description=\"Cómo se usa el fork para terminar el TLS de los dispositivos.\" href=\"/docs/platform/pqc/tls-front-proxy\" />",{"_3844":80513,"_33198":80513,"_5":16006,"_3297":136195,"_33604":136196,"_22654":136197,"_29907":80513},"Claves y autoridades de certificación",[54402,129149,135534,135865],[],{"_3844":80514,"_33198":80513,"_22654":136199,"_5":15607,"_29907":80513,"_3297":136200},[],"Crear claves y CA poscuánticas, firmar con ellas y emitir certificados, con el soporte de motores, los valores de la API y las restricciones aplicables.",{"_3844":80515,"_33198":80513,"_5":33601,"_22654":136202,"_29907":136203,"_3297":136204},[],"/docs/pr-preview/pr-58/es/platform/pqc/keys-and-cas#elegir-un-motor-criptográfico-compatible","Elegir un motor criptográfico compatible",{"_3844":80516,"_33198":80513,"_5":33601,"_22654":136206,"_29907":136207,"_3297":136208},[],"/docs/pr-preview/pr-58/es/platform/pqc/keys-and-cas#crear-una-clave","Crear una clave",{"_3844":80517,"_33198":80513,"_5":33601,"_22654":136210,"_29907":136211,"_3297":136212},[],"/docs/pr-preview/pr-58/es/platform/pqc/keys-and-cas#crear-una-autoridad-de-certificación","Crear una autoridad de certificación",{"_3844":80518,"_33198":80513,"_5":33601,"_22654":136214,"_29907":136215,"_3297":136216},[],"/docs/pr-preview/pr-58/es/platform/pqc/keys-and-cas#combinar-algoritmos-en-una-jerarquía","Combinar algoritmos en una jerarquía",{"_3844":80519,"_33198":80513,"_5":33601,"_22654":136218,"_29907":136219,"_3297":136220},[],"/docs/pr-preview/pr-58/es/platform/pqc/keys-and-cas#firmar-y-verificar-con-una-clave","Firmar y verificar con una clave",{"_3844":80520,"_33198":80513,"_5":33601,"_22654":136222,"_29907":136223,"_3297":136224},[],"/docs/pr-preview/pr-58/es/platform/pqc/keys-and-cas#restricciones-a-tener-en-cuenta","Restricciones a tener en cuenta",{"_3844":80521,"_33198":80513,"_22654":136226,"_5":15607,"_29907":80513,"_3297":136227},[],"El backend de Lamassu trata las claves poscuánticas como un tipo más de clave del servicio de gestión de claves (KMS). Una autoridad de certificación creada con una clave así firma certificados y listas de revocación por las mismas rutas que una CA RSA o ECDSA, porque la firma la realiza el fork de Go. Esta página explica qué enviar a la API, qué motores criptográficos pueden custodiar las claves y dónde difiere el comportamiento respecto a las claves clásicas. El backend debe compilarse con el toolchain de Go PQC.",{"_3844":80522,"_33198":80513,"_22654":136229,"_5":15607,"_29907":136203,"_3297":136230},[],"No todos los motores criptográficos pueden crear o custodiar claves poscuánticas. Solo pueden los motores que ejecutan la criptografía dentro del proceso de Lamassu.",{"_3844":80523,"_33198":80513,"_22654":136232,"_5":15607,"_29907":136203,"_3297":136233},[],"Motor",{"_3844":80524,"_33198":80513,"_22654":136235,"_5":15607,"_29907":136203,"_3297":63184},[],{"_3844":80525,"_33198":80513,"_22654":136237,"_5":15607,"_29907":136203,"_3297":63187},[],{"_3844":80526,"_33198":80513,"_22654":136239,"_5":15607,"_29907":136203,"_3297":136240},[],"Soportado",{"_3844":80527,"_33198":80513,"_22654":136242,"_5":15607,"_29907":136203,"_3297":63193},[],{"_3844":80528,"_33198":80513,"_22654":136244,"_5":15607,"_29907":136203,"_3297":136240},[],{"_3844":80529,"_33198":80513,"_22654":136246,"_5":15607,"_29907":136203,"_3297":63198},[],{"_3844":80530,"_33198":80513,"_22654":136248,"_5":15607,"_29907":136203,"_3297":136249},[],"No soportado",{"_3844":80531,"_33198":80513,"_22654":136251,"_5":15607,"_29907":136203,"_3297":61322},[],{"_3844":80532,"_33198":80513,"_22654":136253,"_5":15607,"_29907":136203,"_3297":136249},[],{"_3844":80533,"_33198":80513,"_22654":136255,"_5":15607,"_29907":136203,"_3297":61326},[],{"_3844":80534,"_33198":80513,"_22654":136257,"_5":15607,"_29907":136203,"_3297":136249},[],{"_3844":80535,"_33198":80513,"_22654":136259,"_5":15607,"_29907":136203,"_3297":136260},[],"Azure Key Vault y Azure Secrets",{"_3844":80536,"_33198":80513,"_22654":136262,"_5":15607,"_29907":136203,"_3297":136249},[],{"_3844":80537,"_33198":80513,"_22654":136264,"_5":15607,"_29907":136203,"_3297":63217},[],{"_3844":80538,"_33198":80513,"_22654":136266,"_5":15607,"_29907":136203,"_3297":136249},[],{"_3844":80539,"_33198":80513,"_22654":136268,"_5":15607,"_29907":136203,"_3297":136269},[],"En la práctica, las claves poscuánticas requieren por ahora el motor filesystem, que tiene nivel de seguridad 1. No hay claves con un nivel de garantía superior, en un módulo de seguridad hardware o en un KMS en la nube, para estos algoritmos.",{"_3844":80540,"_33198":80513,"_22654":136271,"_5":15607,"_29907":136203,"_3297":136272},[],"Los motores Vault KV2 y AWS Secrets Manager incluyen los tipos de clave poscuánticos entre los que dicen soportar, por lo que una petición supera la comprobación de compatibilidad. La creación falla después con un error `unsupported key type` del motor. Debe seleccionarse explícitamente un motor filesystem o software con `engine_id`.",{"_3844":80541,"_33198":80513,"_22654":136274,"_5":15607,"_29907":136207,"_3297":136275},[],"Una clave del KMS se crea con el algoritmo y el tamaño descritos en Algoritmos:",{"_3844":80542,"_33198":80513,"_22654":136277,"_5":15607,"_29907":136207,"_3297":136278},[],"Los parámetros inválidos se rechazan con un mensaje explícito: un tamaño de ML-DSA distinto de 44, 65 o 87, un identificador de SLH-DSA fuera del rango 1 a 12, una variante composite fuera del rango 1 a 15, o una variante composite que no pertenece a la familia solicitada. La importación de una clave privada en formato PKCS#8 detecta automáticamente el algoritmo y el conjunto de parámetros; admite claves ML-DSA, SLH-DSA, composite y Ed25519.",{"_3844":80543,"_33198":80513,"_22654":136280,"_5":15607,"_29907":136211,"_3297":136281},[],"Una CA con clave poscuántica usa la misma petición que cualquier otra CA, enviada a `POST /api/ca/v1/cas`. Solo cambia `key_metadata`, donde `bits` transporta el conjunto de parámetros. Una CA raíz con ML-DSA-65:",{"_3844":80544,"_33198":80513,"_22654":136283,"_5":15607,"_29907":136211,"_3297":136284},[],"Una CA raíz con clave composite de ML-DSA-44 y ECDSA P-256 usa `\"key_metadata\": { \"type\": \"Composite-ML-DSA-ECDSA\", \"bits\": 9 }`. Ed25519 usa `\"type\": \"Ed25519\", \"bits\": 256` y SLH-DSA usa `\"type\": \"SLH-DSA\", \"bits\": 1` para seleccionar SLH-DSA-SHA2-128s. Las CA subordinadas se crean del mismo modo: la subordinada firma su propia solicitud de certificado con la clave del KMS y la CA padre emite el certificado.",{"_3844":80545,"_33198":80513,"_22654":136286,"_5":15607,"_29907":136211,"_3297":136287},[],"Es posible importar CA existentes con una clave privada poscuántica en el caso de ML-DSA y Ed25519. La importación de una CA con clave SLH-DSA o composite no está soportada.",{"_3844":80546,"_33198":80513,"_22654":136289,"_5":15607,"_29907":136215,"_3297":136290},[],"El backend no impone restricciones sobre qué algoritmo emite a cuál. Una CA con clave ML-DSA puede emitir certificados a sujetos RSA, ECDSA, Ed25519 y ML-DSA, y una CA RSA o ECDSA puede emitir certificados a sujetos poscuánticos. La batería de pruebas cubre a través de la API la matriz completa de ML-DSA y Ed25519, y cubre CA y hojas SLH-DSA y composite a nivel del motor de certificados. Esto permite introducir una CA poscuántica bajo una raíz clásica, o a la inversa, pero la parte que confía debe poder verificar todos los algoritmos de la cadena. En TLS, las firmas de la cadena de certificados se comprueban frente a la extensión `signature_algorithms_cert` del cliente, por lo que una cadena firmada con ML-DSA o con un algoritmo composite necesita un cliente que lo anuncie ahí.",{"_3844":80547,"_33198":80513,"_22654":136292,"_5":15607,"_29907":136219,"_3297":136293},[],"El endpoint de firma del KMS acepta nuevos valores de `signature_algorithm`. El campo `message_type` se ignora en todos ellos. Los valores de ML-DSA, SLH-DSA y Ed25519 son «pure»: el mensaje se firma directamente, sin prehash (no son HashML-DSA, HashSLH-DSA ni Ed25519ph). Los valores composite calculan el hash del mensaje con el hash de la variante y firman un mensaje representativo que incluye una etiqueta fija y el contexto opcional.",{"_3844":80548,"_33198":80513,"_22654":136295,"_5":15607,"_29907":136219,"_3297":135467},[],{"_3844":80549,"_33198":80513,"_22654":136297,"_5":15607,"_29907":136219,"_3297":63251},[],{"_3844":80550,"_33198":80513,"_22654":136299,"_5":15607,"_29907":136219,"_3297":63254},[],{"_3844":80551,"_33198":80513,"_22654":136301,"_5":15607,"_29907":136219,"_3297":63257},[],{"_3844":80552,"_33198":80513,"_22654":136303,"_5":15607,"_29907":136219,"_3297":62431},[],{"_3844":80553,"_33198":80513,"_22654":136305,"_5":15607,"_29907":136219,"_3297":63262},[],{"_3844":80554,"_33198":80513,"_22654":136307,"_5":15607,"_29907":136219,"_3297":63265},[],{"_3844":80555,"_33198":80513,"_22654":136309,"_5":15607,"_29907":136219,"_3297":63268},[],{"_3844":80556,"_33198":80513,"_22654":136311,"_5":15607,"_29907":136219,"_3297":62439},[],{"_3844":80557,"_33198":80513,"_22654":136313,"_5":15607,"_29907":136219,"_3297":63273},[],{"_3844":80558,"_33198":80513,"_22654":136315,"_5":15607,"_29907":136219,"_3297":136316},[],"El backend no comprueba que el algoritmo coincida con la clave; debe elegirse el valor que corresponde al tipo de clave. Cuando una CA firma un certificado o una lista de revocación, el algoritmo se selecciona automáticamente.",{"_3844":80559,"_33198":80513,"_22654":136318,"_5":15607,"_29907":136223,"_3297":136319},[],"Varias partes de la plataforma aún no gestionan claves poscuánticas. Se reúnen en Limitaciones conocidas; las que afectan a la operación diaria son las siguientes.",{"_3844":80560,"_33198":80513,"_22654":136321,"_5":15607,"_29907":136223,"_3297":136322},[],"Los perfiles de emisión aplican restricciones de clave solo a RSA y ECDSA, mediante `allow_rsa_keys` y `allow_ecdsa_keys`. Un perfil con la aplicación de restricciones activada no bloquea las claves poscuánticas, y no dispone de un interruptor para permitirlas o denegarlas.",{"_3844":80561,"_33198":80513,"_22654":136324,"_5":15607,"_29907":136223,"_3297":136325},[],"La fortaleza de clave registrada para un certificado cuya clave es poscuántica o Ed25519 solo se calcula para RSA y ECDSA, por lo que esos certificados se almacenan con tipo y tamaño de clave desconocidos y fortaleza baja.",{"_3844":80562,"_33198":80513,"_22654":136327,"_5":15607,"_29907":136223,"_3297":136328},[],"Las respuestas OCSP se firman con la biblioteca `golang.org/x/crypto/ocsp`, que solo admite claves de firma RSA y ECDSA. No cabe esperar, por tanto, que una CA con clave poscuántica, Ed25519 o composite pueda firmar respuestas OCSP; las CRL se generan con el fork y no se ven afectadas por este límite, aunque no tienen pruebas.",{"_3844":80563,"_33198":80513,"_22654":136330,"_5":15607,"_29907":136223,"_3297":136331},[],"La generación de claves en el servidor del DMS (la operación `serverkeygen` de EST) genera únicamente claves RSA y ECDSA.",{"_3844":80564,"_33198":80513,"_22654":136333,"_5":15607,"_29907":136223,"_3297":136334},[],"<Card title=\"Certificados relacionados\" description=\"Vincular un certificado poscuántico a uno clásico existente.\" href=\"/docs/platform/pqc/related-certificates\" />",{"_3844":80565,"_33198":80513,"_22654":136336,"_5":15607,"_29907":136223,"_3297":136337},[],"<Card title=\"Dashboard\" description=\"Crear los mismos objetos desde la interfaz web.\" href=\"/docs/platform/pqc/dashboard\" />",{"_3844":80566,"_33198":80566,"_5":16006,"_3297":136339,"_33604":136340,"_22654":136342,"_29907":80566},"Limitaciones conocidas",[54402,129149,135534,136341],"Referencia",[],{"_3844":80567,"_33198":80566,"_22654":136344,"_5":15607,"_29907":80566,"_3297":136345},[],"Qué está incompleto, es no estándar o no está verificado en el soporte poscuántico de Lamassu, agrupado por componente.",{"_3844":80568,"_33198":80566,"_5":33601,"_22654":136347,"_29907":136348,"_3297":136349},[],"/docs/pr-preview/pr-58/es/platform/pqc/limitations#estándares-e-interoperabilidad","Estándares e interoperabilidad",{"_3844":80569,"_33198":80566,"_5":33601,"_22654":136351,"_29907":136352,"_3297":136353},[],"/docs/pr-preview/pr-58/es/platform/pqc/limitations#claves-y-motores","Claves y motores",{"_3844":80570,"_33198":80566,"_5":33601,"_22654":136355,"_29907":136356,"_3297":136357},[],"/docs/pr-preview/pr-58/es/platform/pqc/limitations#autoridad-de-certificación-y-validación","Autoridad de certificación y validación",{"_3844":80571,"_33198":80566,"_5":33601,"_22654":136359,"_29907":136360,"_3297":62788},[],"/docs/pr-preview/pr-58/es/platform/pqc/limitations#dashboard",{"_3844":80572,"_33198":80566,"_5":33601,"_22654":136362,"_29907":136363,"_3297":136364},[],"/docs/pr-preview/pr-58/es/platform/pqc/limitations#compilación-y-despliegue","Compilación y despliegue",{"_3844":80573,"_33198":80566,"_22654":136366,"_5":15607,"_29907":80566,"_3297":136367},[],"Esta página reúne los límites de la implementación actual para valorarlos antes de planificar un despliegue. Cada uno se ha observado en el código o en las pruebas de las ramas descritas en esta sección.",{"_3844":80574,"_33198":80566,"_22654":136369,"_5":15607,"_29907":136348,"_3297":136370},[],"Los certificados composite se implementaron y se probaron contra el borrador 19 de la especificación de firmas composite del IETF, que desde entonces se ha publicado como RFC 10073; la implementación no se ha comparado con el texto final. Tres de sus algoritmos (las dos variantes Brainpool y Ed448) no están implementados. Los esquemas de firma composite en TLS usan puntos de código de uso privado de `0xFE00` a `0xFE0E` y en el código no se identifica ningún borrador ni versión publicados, por lo que solo interoperan con pares construidos con el mismo fork de Go. Las variantes composite con RSA PKCS#1 v1.5 no pueden autenticar un handshake TLS. SLH-DSA no tiene esquema de firma TLS. El atributo de solicitud de certificado relacionado no se ha contrastado con otras implementaciones del RFC 9763.",{"_3844":80575,"_33198":80566,"_22654":136372,"_5":15607,"_29907":136352,"_3297":136373},[],"Las claves poscuánticas, composite y Ed25519 funcionan solo con los motores filesystem y software. Los motores Vault KV2 y AWS Secrets Manager anuncian soporte y después fallan en la creación, y AWS KMS, Azure y PKCS#11 no las soportan. No existe, por tanto, ninguna clave poscuántica respaldada por hardware o por un KMS en la nube. Algunos mensajes de error de los motores están copiados de otros motores y nombran el motor equivocado.",{"_3844":80576,"_33198":80566,"_22654":136375,"_5":15607,"_29907":136352,"_3297":136376},[],"La interfaz `CryptoEngine` ha incorporado métodos para crear e importar cada nuevo tipo de clave. Los motores desarrollados fuera del repositorio de Lamassu deben implementarlos.",{"_3844":80577,"_33198":80566,"_22654":136378,"_5":15607,"_29907":136356,"_3297":136379},[],"Una CA con clave poscuántica, Ed25519 o composite no puede firmar respuestas OCSP, porque la biblioteca de firma solo admite RSA y ECDSA. Se espera que la generación de CRL funcione, ya que usa la firma del fork, pero ni CRL ni OCSP tienen pruebas con estas claves.",{"_3844":80578,"_33198":80566,"_22654":136381,"_5":15607,"_29907":136356,"_3297":136382},[],"Los perfiles de emisión no pueden permitir ni denegar algoritmos poscuánticos; su aplicación de restricciones afecta solo a RSA y ECDSA. La fortaleza de clave de un certificado emitido solo se calcula para RSA y ECDSA, por lo que los demás certificados se almacenan con tipo y tamaño desconocidos y fortaleza baja. No está soportada la importación de una CA existente con clave SLH-DSA o composite.",{"_3844":80579,"_33198":80566,"_22654":136384,"_5":15607,"_29907":136356,"_3297":136385},[],"El DMS solo puede generar claves en el servidor para RSA y ECDSA, de modo que `serverkeygen` no puede devolver una clave poscuántica. Los flujos de enrolamiento por EST y por el device manager no tienen pruebas con claves poscuánticas.",{"_3844":80580,"_33198":80566,"_22654":136387,"_5":15607,"_29907":136356,"_3297":136388},[],"El backend no evalúa la extensión de certificado relacionado. Solo la emite.",{"_3844":80581,"_33198":80566,"_22654":136390,"_5":15607,"_29907":136360,"_3297":136391},[],"El generador de claves SLH-DSA del navegador asigna los identificadores de conjunto de parámetros de forma distinta al resto de la interfaz, según se describe en Dashboard. Los nombres de los tipos de clave no son uniformes entre pantallas, y la interfaz no incluye aviso de carácter experimental ni traducción.",{"_3844":80582,"_33198":80566,"_22654":136393,"_5":15607,"_29907":136363,"_3297":136394},[],"Todo depende de forks de Go y de Traefik que no son los proyectos originales, y la imagen del proxy tiene una etiqueta mutable. La especificación OpenAPI del KMS del backend sigue listando solo RSA, ECDSA y Ed25519 y no refleja los nuevos tipos de clave.",{"_3844":80583,"_33198":80566,"_22654":136396,"_5":15607,"_29907":136363,"_3297":136397},[],"El Helm chart usa nombres de recurso fijos, admite una sola release por espacio de nombres y envía el tráfico de Traefik a Envoy sin verificar certificados. Los certificados poscuánticos que crea el instalador son válidos durante 365 días y no se renuevan. El instalador necesita un host Linux y ejecuta una instalación de Helm, no una actualización.",{"_3844":80584,"_33198":80566,"_22654":136399,"_5":15607,"_29907":136363,"_3297":136400},[],"<Card title=\"Visión general de la criptografía poscuántica\" description=\"Volver al resumen de la sección.\" href=\"/docs/platform/pqc/overview\" />",{"_3844":80585,"_33198":80585,"_5":16006,"_3297":136402,"_33604":136403,"_22654":136404,"_29907":80585},"Visión general de la criptografía poscuántica",[54402,129149,135534],[],{"_3844":80586,"_33198":80585,"_22654":136406,"_5":15607,"_29907":80585,"_3297":136407},[],"Qué soporte poscuántico (PQC) añade Lamassu a las claves, las autoridades de certificación, el TLS de los dispositivos y el despliegue, y cómo encajan sus piezas.",{"_3844":80587,"_33198":80585,"_5":33601,"_22654":136409,"_29907":136410,"_3297":136411},[],"/docs/pr-preview/pr-58/es/platform/pqc/overview#por-qué-importa-en-flotas-de-dispositivos","Por qué importa en flotas de dispositivos",{"_3844":80588,"_33198":80585,"_5":33601,"_22654":136413,"_29907":136414,"_3297":136415},[],"/docs/pr-preview/pr-58/es/platform/pqc/overview#tres-familias-de-algoritmos","Tres familias de algoritmos",{"_3844":80589,"_33198":80585,"_5":33601,"_22654":136417,"_29907":136418,"_3297":136419},[],"/docs/pr-preview/pr-58/es/platform/pqc/overview#cómo-encajan-las-piezas","Cómo encajan las piezas",{"_3844":80590,"_33198":80585,"_5":33601,"_22654":136421,"_29907":136422,"_3297":136423},[],"/docs/pr-preview/pr-58/es/platform/pqc/overview#por-dónde-continuar","Por dónde continuar",{"_3844":80591,"_33198":80585,"_22654":136425,"_5":15607,"_29907":80585,"_3297":136426},[],"Lamassu puede crear claves, autoridades de certificación (CA) y certificados que usan algoritmos de firma poscuánticos, y puede servirlos y verificarlos por TLS. El trabajo abarca cinco bases de código que dependen unas de otras: un fork del toolchain de Go que implementa los algoritmos, el backend de Lamassu, el dashboard web, un fork del proxy Traefik que termina el TLS de los dispositivos y el Helm chart que despliega todo junto.",{"_3844":80592,"_33198":80585,"_22654":136428,"_5":15607,"_29907":80585,"_3297":136429},[],"El soporte PQC reside en ramas de desarrollo y en forks de Go y Traefik, no en los proyectos originales ni en las imágenes estándar de Lamassu. Los esquemas de firma TLS composite usan puntos de código de uso privado que ninguna otra pila TLS reconoce, y el formato de certificado composite sigue un borrador del IETF que todavía puede cambiar. Conviene planificar pilotos y despliegues de laboratorio, no flotas en producción. Limitaciones conocidas recoge lo que está incompleto.",{"_3844":80593,"_33198":80585,"_22654":136431,"_5":15607,"_29907":136410,"_3297":136432},[],"Los certificados emitidos a dispositivos suelen durar años, y los dispositivos que los almacenan son difíciles de sustituir. Un algoritmo de firma que un futuro ordenador cuántico llegase a romper obligaría a re-enrolar toda la flota. Emitir hoy certificados firmados con un algoritmo poscuántico o composite, y ofrecer un endpoint TLS que los acepte, permite validar la flota frente a ese riesgo antes de que sea urgente. Las firmas no están expuestas a ataques de tipo «almacenar ahora, descifrar después» como lo está un intercambio de claves, por lo que la urgencia depende de la vida útil de los certificados y de los dispositivos, no del tráfico registrado.",{"_3844":80594,"_33198":80585,"_22654":136434,"_5":15607,"_29907":136414,"_3297":136435},[],"Lamassu agrupa los algoritmos de firma en tres familias, con las mismas etiquetas que muestra el dashboard.",{"_3844":80595,"_33198":80585,"_22654":136437,"_5":15607,"_29907":136414,"_3297":136438},[],"Etiqueta",{"_3844":80596,"_33198":80585,"_22654":136440,"_5":15607,"_29907":136414,"_3297":135721},[],{"_3844":80597,"_33198":80585,"_22654":136442,"_5":15607,"_29907":136414,"_3297":135532},[],{"_3844":80598,"_33198":80585,"_22654":136444,"_5":15607,"_29907":136414,"_3297":63405},[],{"_3844":80599,"_33198":80585,"_22654":136446,"_5":15607,"_29907":136414,"_3297":136447},[],"Tradicional",{"_3844":80600,"_33198":80585,"_22654":136449,"_5":15607,"_29907":136414,"_3297":63411},[],{"_3844":80601,"_33198":80585,"_22654":136451,"_5":15607,"_29907":136414,"_3297":63414},[],{"_3844":80602,"_33198":80585,"_22654":136453,"_5":15607,"_29907":136414,"_3297":136454},[],"Poscuántica pura",{"_3844":80603,"_33198":80585,"_22654":136456,"_5":15607,"_29907":136414,"_3297":63420},[],{"_3844":80604,"_33198":80585,"_22654":136458,"_5":15607,"_29907":136414,"_3297":63423},[],{"_3844":80605,"_33198":80585,"_22654":136460,"_5":15607,"_29907":136414,"_3297":136461},[],"Híbrida (composite)",{"_3844":80606,"_33198":80585,"_22654":136463,"_5":15607,"_29907":136414,"_3297":136464},[],"ML-DSA combinado con RSA, ECDSA o Ed25519 en una única clave y una única firma",{"_3844":80607,"_33198":80585,"_22654":136466,"_5":15607,"_29907":136414,"_3297":136467},[],"Una firma composite solo es válida si se verifican sus dos componentes. Está pensada para que no sea falsificable mientras al menos uno de los dos algoritmos siga sin romperse, siempre que la parte que confía exija el composite y no recurra a un certificado clásico. En el intercambio de claves, `PQ/T` significa un grupo híbrido que combina un intercambio clásico y uno ML-KEM, y `PQ` significa ML-KEM puro. Algoritmos describe cada uno y los conjuntos de parámetros que Lamassu acepta.",{"_3844":80608,"_33198":80585,"_22654":136469,"_5":15607,"_29907":136418,"_3297":136470},[],"El fork de Go es la base: el backend y Traefik se compilan con él, porque el toolchain estándar de Go no incluye el soporte de certificados composite y SLH-DSA. El backend crea y custodia las claves, emite certificados y firma los datos de revocación. El dashboard usa la misma API REST. Los dispositivos llegan a la plataforma a través de Traefik, que negocia con ellos la autenticación y el intercambio de claves poscuánticos y después reenvía la petición a Envoy Gateway mediante TLS ordinario. La protección poscuántica se aplica, por tanto, solo al salto entre el dispositivo y Traefik.",{"_3844":80609,"_33198":80585,"_22654":136472,"_5":15607,"_29907":136422,"_3297":136473},[],"Conviene leer primero Algoritmos para conocer qué se soporta y cómo se escriben los conjuntos de parámetros en las peticiones a la API. Quien desarrolle un cliente de dispositivo debe seguir con Toolchain de Go PQC. Para crear una CA poscuántica, el camino es Claves y autoridades de certificación, y quien despliegue la plataforma consultará Despliegue con el Helm chart.",{"_3844":80610,"_33198":80585,"_22654":136475,"_5":15607,"_29907":136422,"_3297":136476},[],"<Card title=\"Algoritmos\" description=\"ML-DSA, SLH-DSA y los 15 algoritmos composite, con sus conjuntos de parámetros.\" href=\"/docs/platform/pqc/algorithms\" />",{"_3844":80611,"_33198":80585,"_22654":136478,"_5":15607,"_29907":136422,"_3297":136479},[],"<Card title=\"Claves y autoridades de certificación\" description=\"Crear claves y CA poscuánticas y emitir certificados mediante la API.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_3844":80612,"_33198":80585,"_22654":136481,"_5":15607,"_29907":136422,"_3297":136482},[],"<Card title=\"Despliegue con el Helm chart\" description=\"Instalar la plataforma con un proxy Traefik que sirve certificados PQC.\" href=\"/docs/platform/pqc/deployment\" />",{"_3844":80613,"_33198":80613,"_5":16006,"_3297":135885,"_33604":136484,"_22654":136485,"_29907":80613},[54402,129149,135534,135865],[],{"_3844":80614,"_33198":80613,"_22654":136487,"_5":15607,"_29907":80613,"_3297":136488},[],"Vincular un certificado con clave poscuántica a un certificado clásico existente del mismo dispositivo, según el RFC 9763, y cómo los emite y comprueba Lamassu.",{"_3844":80615,"_33198":80613,"_5":33601,"_22654":136490,"_29907":136491,"_3297":136492},[],"/docs/pr-preview/pr-58/es/platform/pqc/related-certificates#cómo-funciona-la-solicitud","Cómo funciona la solicitud",{"_3844":80616,"_33198":80613,"_5":33601,"_22654":136494,"_29907":136495,"_3297":136496},[],"/docs/pr-preview/pr-58/es/platform/pqc/related-certificates#ubicaciones-desde-las-que-la-ca-puede-descargar","Ubicaciones desde las que la CA puede descargar",{"_3844":80617,"_33198":80613,"_5":33601,"_22654":136498,"_29907":136499,"_3297":136500},[],"/docs/pr-preview/pr-58/es/platform/pqc/related-certificates#configurar-un-perfil-de-emisión","Configurar un perfil de emisión",{"_3844":80618,"_33198":80613,"_5":33601,"_22654":136502,"_29907":136503,"_3297":136504},[],"/docs/pr-preview/pr-58/es/platform/pqc/related-certificates#qué-debe-cumplir-el-certificado-emitido","Qué debe cumplir el certificado emitido",{"_3844":80619,"_33198":80613,"_5":33601,"_22654":136506,"_29907":136507,"_3297":136508},[],"/docs/pr-preview/pr-58/es/platform/pqc/related-certificates#desde-el-dashboard","Desde el dashboard",{"_3844":80620,"_33198":80613,"_22654":136510,"_5":15607,"_29907":80613,"_3297":136511},[],"Una flota que migra a algoritmos poscuánticos suele mantener durante un tiempo dos certificados por dispositivo: el clásico que ya se usa y uno nuevo con clave poscuántica. El RFC 9763 define una forma de enlazarlos. El certificado nuevo lleva la extensión `id-pe-relatedCert` (`1.3.6.1.5.5.7.1.36`), que contiene un hash del certificado clásico, de modo que una parte que confía puede comprobar que ambos identifican a la misma entidad. Lamassu implementa el lado emisor de este mecanismo.",{"_3844":80621,"_33198":80613,"_22654":136513,"_5":15607,"_29907":136491,"_3297":136514},[],"El dispositivo solicita el certificado vinculado con una solicitud PKCS#10 ordinaria que incluye un atributo adicional, `relatedCertRequest` (`1.2.840.113549.1.9.16.2.60`). El atributo identifica el certificado existente por emisor y número de serie, indica la hora de la solicitud, indica la ubicación desde la que puede descargarse el certificado y lleva una firma realizada con la clave privada de ese certificado existente. La firma cubre el emisor, el número de serie y la hora de la solicitud, no la ubicación, y demuestra que quien solicita controla la clave existente; la clave del nuevo certificado se prueba con la firma de la propia solicitud de certificado. Lamassu acepta una lista de ubicaciones, como en el módulo ASN.1 del RFC, y las prueba en orden.",{"_3844":80622,"_33198":80613,"_22654":136516,"_5":15607,"_29907":136491,"_3297":136517},[],"Cuando el servicio de CA recibe una solicitud así, sigue estos pasos:",{"_3844":80623,"_33198":80613,"_22654":136519,"_5":15607,"_29907":136491,"_3297":136520},[],"Comprueba que el perfil de emisión en uso habilita los certificados relacionados y, en caso contrario, rechaza la solicitud.",{"_3844":80624,"_33198":80613,"_22654":136522,"_5":15607,"_29907":136491,"_3297":136523},[],"Recorre en orden las ubicaciones del atributo y descarga el primer certificado que logra obtener.",{"_3844":80625,"_33198":80613,"_22654":136525,"_5":15607,"_29907":136491,"_3297":136526},[],"Verifica que el emisor y el número de serie coinciden, que la hora de la solicitud está dentro de la antigüedad permitida y que la firma es válida con la clave del certificado descargado.",{"_3844":80626,"_33198":80613,"_22654":136528,"_5":15607,"_29907":136491,"_3297":136529},[],"Emite el nuevo certificado con la extensión de certificado relacionado añadida.",{"_3844":80627,"_33198":80613,"_22654":136531,"_5":15607,"_29907":136491,"_3297":136532},[],"Una solicitud sin el atributo se procesa con normalidad, tanto si el perfil habilita la función como si no.",{"_3844":80628,"_33198":80613,"_22654":136534,"_5":15607,"_29907":136495,"_3297":136535},[],"Una ubicación es un URI `data:` o una URL `http` o `https`. Un URI `data:` debe estar codificado en base64 y contiene una estructura PKCS#7 cuyo primer certificado es el relacionado; no requiere acceso a la red y siempre se acepta cuando la función está habilitada. Una URL solo se descarga si su host figura en la lista de hosts permitidos del perfil. La CA no sigue redirecciones, aplica un tiempo de espera de diez segundos y rechaza respuestas de más de 1 MiB.",{"_3844":80629,"_33198":80613,"_22654":136537,"_5":15607,"_29907":136495,"_3297":136538},[],"Como la descarga la realiza el servidor, quien puede definir un perfil de emisión decide a qué hosts puede conectarse la CA. Conviene restringir ese permiso en consecuencia e incluir solo repositorios internos de certificados.",{"_3844":80630,"_33198":80613,"_22654":136540,"_5":15607,"_29907":136499,"_3297":136541},[],"La función se configura en el objeto `related_certificate` del perfil de emisión, que se almacena en columnas propias de la base de datos:",{"_3844":80631,"_33198":80613,"_22654":136543,"_5":15607,"_29907":136499,"_3297":135989},[],{"_3844":80632,"_33198":80613,"_22654":136545,"_5":15607,"_29907":136499,"_3297":131763},[],{"_3844":80633,"_33198":80613,"_22654":136547,"_5":15607,"_29907":136499,"_3297":135994},[],{"_3844":80634,"_33198":80613,"_22654":136549,"_5":15607,"_29907":136499,"_3297":131769},[],{"_3844":80635,"_33198":80613,"_22654":136551,"_5":15607,"_29907":136499,"_3297":63518},[],{"_3844":80636,"_33198":80613,"_22654":136553,"_5":15607,"_29907":136499,"_3297":108905},[],{"_3844":80637,"_33198":80613,"_22654":136555,"_5":15607,"_29907":136499,"_3297":62934},[],{"_3844":80638,"_33198":80613,"_22654":136557,"_5":15607,"_29907":136499,"_3297":136558},[],"Con `false`, se rechaza una solicitud que lleve el atributo.",{"_3844":80639,"_33198":80613,"_22654":136560,"_5":15607,"_29907":136499,"_3297":63528},[],{"_3844":80640,"_33198":80613,"_22654":136562,"_5":15607,"_29907":136499,"_3297":136563},[],"lista de cadenas",{"_3844":80641,"_33198":80613,"_22654":136565,"_5":15607,"_29907":136499,"_3297":136566},[],"vacía",{"_3844":80642,"_33198":80613,"_22654":136568,"_5":15607,"_29907":136499,"_3297":136569},[],"Hosts desde los que se pueden descargar ubicaciones `http` y `https`.",{"_3844":80643,"_33198":80613,"_22654":136571,"_5":15607,"_29907":136499,"_3297":63539},[],{"_3844":80644,"_33198":80613,"_22654":136573,"_5":15607,"_29907":136499,"_3297":136574},[],"duración",{"_3844":80645,"_33198":80613,"_22654":136576,"_5":15607,"_29907":136499,"_3297":63544},[],{"_3844":80646,"_33198":80613,"_22654":136578,"_5":15607,"_29907":136499,"_3297":136579},[],"Diferencia máxima entre la hora de la solicitud del atributo y el momento de la emisión.",{"_3844":80647,"_33198":80613,"_22654":136581,"_5":15607,"_29907":136503,"_3297":136582},[],"El fork se niega a vincular un certificado salvo que el nuevo sea compatible con el relacionado. Ninguno de los dos puede ser una CA. El certificado relacionado debe estar vigente en el momento de la emisión. Los usos de clave y los usos extendidos de clave solicitados para el nuevo certificado deben ser un subconjunto de los del certificado relacionado. La verificación posterior compara únicamente el hash, de modo que una parte que confía y comprueba el enlace averigua que la CA emisora vinculó el nuevo certificado a ese certificado concreto, no que el certificado relacionado siga siendo válido.",{"_3844":80648,"_33198":80613,"_22654":136584,"_5":15607,"_29907":136507,"_3297":136585},[],"El dashboard expone la función en dos lugares. El formulario del perfil de emisión tiene una sección *Related Certificates* con un interruptor, los hosts permitidos y la antigüedad máxima. Al emitir un certificado desde una CA con una clave generada en el navegador y un perfil que habilita la función, el formulario ofrece *Bind to a related certificate*: quien emite aporta el certificado existente, o su emisor y número de serie, firma los datos mostrados con la clave existente fuera del navegador y pega la firma. Los detalles de certificados y CA muestran una fila *Related Certificate* con el algoritmo de hash y el valor. Véase Dashboard.",{"_3844":80649,"_33198":80613,"_22654":136587,"_5":15607,"_29907":136507,"_3297":136588},[],"El certificado vinculado se crea con `CreateBoundCertificate` del fork, cuyas pruebas cubren una clave ML-DSA vinculada a certificados RSA, ECDSA y Ed25519. Las pruebas no usan claves composite. Solo el lado emisor está implementado en Lamassu: la plataforma no evalúa la extensión cuando valida certificados.",{"_3844":80650,"_33198":80613,"_22654":136590,"_5":15607,"_29907":136507,"_3297":136591},[],"<Card title=\"Claves y autoridades de certificación\" description=\"Crear la CA poscuántica que emite el certificado vinculado.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_3844":80651,"_33198":80613,"_22654":136593,"_5":15607,"_29907":136507,"_3297":136594},[],"<Card title=\"Limitaciones conocidas\" description=\"Lo que todavía no está cubierto.\" href=\"/docs/platform/pqc/limitations\" />",{"_3844":80652,"_33198":80652,"_5":16006,"_3297":136596,"_33604":136597,"_22654":136598,"_29907":80652},"Proxy TLS con Traefik",[54402,129149,135534,127718],[],{"_3844":80653,"_33198":80652,"_22654":136600,"_5":15607,"_29907":80652,"_3297":136601},[],"El fork de Traefik que termina el TLS de los dispositivos con certificados clásicos y poscuánticos para el mismo host, cómo elige certificado y cómo se compila.",{"_3844":80654,"_33198":80652,"_5":33601,"_22654":136603,"_29907":136604,"_3297":136605},[],"/docs/pr-preview/pr-58/es/platform/pqc/tls-front-proxy#varios-certificados-para-el-mismo-host","Varios certificados para el mismo host",{"_3844":80655,"_33198":80652,"_5":33601,"_22654":136607,"_29907":136608,"_3297":136609},[],"/docs/pr-preview/pr-58/es/platform/pqc/tls-front-proxy#opciones-tls-en-listeners-de-gateway-api","Opciones TLS en listeners de Gateway API",{"_3844":80656,"_33198":80652,"_5":33601,"_22654":136611,"_29907":136612,"_3297":136613},[],"/docs/pr-preview/pr-58/es/platform/pqc/tls-front-proxy#tls-mutuo","TLS mutuo",{"_3844":80657,"_33198":80652,"_5":33601,"_22654":136615,"_29907":136616,"_3297":136617},[],"/docs/pr-preview/pr-58/es/platform/pqc/tls-front-proxy#compilación-del-proxy","Compilación del proxy",{"_3844":80658,"_33198":80652,"_22654":136619,"_5":15607,"_29907":80652,"_3297":136620},[],"Los dispositivos se conectan a Lamassu por TLS, y el enrolamiento EST se apoya en TLS mutuo. Para aceptar un certificado poscuántico o composite en esa conexión, el endpoint TLS debe compilarse con el toolchain de Go PQC. Lamassu lo hace con un fork de Traefik, basado en Traefik 3.7.15, situado delante de Envoy Gateway. El fork añade dos comportamientos: puede servir varios certificados para el mismo host y elegir entre ellos según el cliente, y permite que un listener de Gateway API haga referencia a una opción TLS de Traefik.",{"_3844":80659,"_33198":80652,"_22654":136622,"_5":15607,"_29907":136604,"_3297":136623},[],"Traefik original conserva un certificado por conjunto de nombres. Si existen un certificado ECDSA clásico y un certificado ML-DSA para `lab.example.com`, solo se conserva el primero. El fork almacena cada certificado distinto (los duplicados se detectan comparando el certificado hoja) y elige uno en cada handshake.",{"_3844":80660,"_33198":80652,"_22654":136625,"_5":15607,"_29907":136604,"_3297":136626},[],"La elección sigue los algoritmos de firma que anuncia el cliente:",{"_3844":80661,"_33198":80652,"_22654":136628,"_5":15607,"_29907":136604,"_3297":136629},[],"Se normaliza el nombre de servidor del cliente y se reúnen los certificados cuyos nombres coinciden, con los nombres exactos por delante de los comodines. Un certificado con solo Common Name sigue coincidiendo.",{"_3844":80662,"_33198":80652,"_22654":136631,"_5":15607,"_29907":136604,"_3297":136632},[],"Si ningún certificado coincide, la conexión se cierra en modo SNI estricto, o se sirve el certificado por defecto.",{"_3844":80663,"_33198":80652,"_22654":136634,"_5":15607,"_29907":136604,"_3297":136635},[],"Si coincide exactamente un certificado, se sirve sin más comprobaciones.",{"_3844":80664,"_33198":80652,"_22654":136637,"_5":15607,"_29907":136604,"_3297":136638},[],"En otro caso, el proxy toma los esquemas de firma del cliente en el orden en que los envió y, para cada esquema, devuelve el primer certificado cuya clave permiten el esquema, la versión de TLS y el tipo de clave. Así se contrasta la clave hoja con `signature_algorithms`, los esquemas que el cliente acepta para la firma del handshake; las firmas del resto de la cadena son una comprobación distinta, frente a `signature_algorithms_cert`.",{"_3844":80665,"_33198":80652,"_22654":136640,"_5":15607,"_29907":136604,"_3297":136641},[],"Si el cliente no anuncia ningún esquema, se devuelve el primer certificado compatible. Si ninguno es compatible, se devuelve el primer candidato y el handshake falla con el error subyacente.",{"_3844":80666,"_33198":80652,"_22654":136643,"_5":15607,"_29907":136604,"_3297":136644},[],"Prevalece el orden de preferencia del cliente: un cliente que lista ML-DSA primero recibe el certificado poscuántico y uno que lista ECDSA primero recibe el clásico, aunque también soporte ML-DSA. Un cliente sin soporte poscuántico nunca anuncia esos esquemas y recibe el certificado clásico. TLS 1.2 nunca selecciona certificados ML-DSA ni composite. El servidor no puede configurarse con un orden de preferencia propio.",{"_3844":80667,"_33198":80652,"_22654":136646,"_5":15607,"_29907":136608,"_3297":136647},[],"Traefik lee su configuración de Gateway API desde Kubernetes. El fork lee la opción de listener `traefik.io/tls-options`, cuyo valor nombra la opción TLS que se aplica a ese listener: `default`, o un nombre cualificado como `traefik-system-pqc@kubernetescrd`. Funciona en listeners HTTPS y en listeners TLS en modo `Terminate` que sirven un `TLSRoute`. Se ignora en modo passthrough.",{"_3844":80668,"_33198":80652,"_22654":136649,"_5":15607,"_29907":136608,"_3297":136650},[],"En una opción TLS se establecen los grupos de intercambio de claves soportados y el modo de autenticación de cliente. Cuando varios listeners comparten un router padre y nombran opciones distintas, el proxy registra una advertencia y usa valores por defecto aislados para cada uno. Sin el fork, Traefik ignora la anotación, aplica sus propios valores por defecto y los ajustes no se pueden controlar; los dispositivos que necesitan TLS mutuo fallan entonces.",{"_3844":80669,"_33198":80652,"_22654":136652,"_5":15607,"_29907":136608,"_3297":136653},[],"El fork añade además `mlkem1024` a los nombres de grupo aceptados en `curvePreferences`, junto a los grupos híbridos que Traefik ya reconoce.",{"_3844":80670,"_33198":80652,"_22654":136655,"_5":15607,"_29907":136612,"_3297":136656},[],"La autenticación de cliente es el mecanismo estándar de Traefik, configurado en la opción TLS. Con `RequireAndVerifyClientCert` y un fichero de CA de cliente, el proxy valida la cadena, y la verificación de la firma del cliente la realiza la pila TLS del fork de Go, que se ha probado con certificados de cliente composite en un handshake TLS 1.3. Con `RequestClientCert`, que es lo que establece el chart de Lamassu en su opción por defecto, el proxy comprueba que el cliente posee la clave del certificado que presenta, pero no valida la cadena; la decisión se delega en el backend, que recibe el certificado en una cabecera (véase Despliegue con el Helm chart). Ninguna prueba de Traefik cubre el TLS mutuo poscuántico, y una cadena de cliente firmada por una CA composite o poscuántica depende del código x509 del fork.",{"_3844":80671,"_33198":80652,"_22654":136658,"_5":15607,"_29907":136616,"_3297":136659},[],"El fork no se compila desde la imagen de Go. El script `build.sh` exige una copia ya compilada del fork de Go, por defecto en `../go`, y comprueba que es el fork antes de forzar `GOROOT` y `GOTOOLCHAIN=local`. Compila el binario con `CGO_ENABLED=0`, genera la interfaz web salvo que se indique `SKIP_WEBUI=1` y empaqueta el binario en una imagen Alpine con `docker buildx`. La imagen por defecto es `ghcr.io/lamassuiot/traefik:pqc-3.7.15`.",{"_3844":80672,"_33198":80652,"_22654":136661,"_5":15607,"_29907":136616,"_3297":63630},[],{"_3844":80673,"_33198":80652,"_22654":136663,"_5":15607,"_29907":136616,"_3297":136664},[],"Finalidad",{"_3844":80674,"_33198":80652,"_22654":136666,"_5":15607,"_29907":136616,"_3297":63635},[],{"_3844":80675,"_33198":80652,"_22654":136668,"_5":15607,"_29907":136616,"_3297":136669},[],"Ubicación del fork de Go compilado.",{"_3844":80676,"_33198":80652,"_22654":136671,"_5":15607,"_29907":136616,"_3297":63641},[],{"_3844":80677,"_33198":80652,"_22654":136673,"_5":15607,"_29907":136616,"_3297":136674},[],"Plataformas de destino; por defecto `linux/amd64`.",{"_3844":80678,"_33198":80652,"_22654":136676,"_5":15607,"_29907":136616,"_3297":63647},[],{"_3844":80679,"_33198":80652,"_22654":136678,"_5":15607,"_29907":136616,"_3297":136679},[],"Omite la generación de la interfaz web con el valor `1`.",{"_3844":80680,"_33198":80652,"_22654":136681,"_5":15607,"_29907":136616,"_3297":63653},[],{"_3844":80681,"_33198":80652,"_22654":136683,"_5":15607,"_29907":136616,"_3297":136684},[],"Nombre de la imagen y si se publica. Las compilaciones multiplataforma requieren `PUSH=1`.",{"_3844":80682,"_33198":80652,"_22654":136686,"_5":15607,"_29907":136616,"_3297":136687},[],"Las etiquetas `pqc-*` son mutables y se han reconstruido sobre sí mismas, por lo que en entornos próximos a producción conviene fijar el digest.",{"_3844":80683,"_33198":80652,"_22654":136689,"_5":15607,"_29907":136616,"_3297":136690},[],"Las pruebas de selección del fork usan ML-DSA-65 puro junto con ECDSA P-256. La selección de un certificado composite depende de que la pila TLS del fork conozca la clave composite, algo que ocurre, pero el proxy no tiene ninguna prueba para ello.",{"_3844":80684,"_33198":80652,"_22654":136692,"_5":15607,"_29907":136616,"_3297":136693},[],"<Card title=\"Despliegue con el Helm chart\" description=\"Instalar el proxy delante de Envoy Gateway con el chart.\" href=\"/docs/platform/pqc/deployment\" />",{"_3844":80685,"_33198":80652,"_22654":136695,"_5":15607,"_29907":136616,"_3297":136696},[],"<Card title=\"Limitaciones conocidas\" description=\"Interoperabilidad y advertencias operativas.\" href=\"/docs/platform/pqc/limitations\" />",{"_3844":80686,"_33198":80686,"_5":16006,"_3297":136698,"_33604":136699,"_22654":136700,"_29907":80686},"Seguridad",[54402],[],{"_3844":80687,"_33198":80686,"_22654":136702,"_5":15607,"_29907":80686,"_3297":136703},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3844":80688,"_33198":80686,"_5":33601,"_22654":136705,"_29907":136706,"_3297":136707},[],"/docs/pr-preview/pr-58/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3844":80689,"_33198":80686,"_5":33601,"_22654":136709,"_29907":136710,"_3297":136711},[],"/docs/pr-preview/pr-58/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3844":80690,"_33198":80686,"_5":33601,"_22654":136713,"_29907":136714,"_3297":136715},[],"/docs/pr-preview/pr-58/es/security#versiones-soportadas","Versiones soportadas",{"_3844":80691,"_33198":80686,"_5":33601,"_22654":136717,"_29907":136718,"_3297":136719},[],"/docs/pr-preview/pr-58/es/security#divulgación-responsable","Divulgación responsable",{"_3844":80692,"_33198":80686,"_22654":136721,"_5":15607,"_29907":80686,"_3297":136722},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3844":80693,"_33198":80686,"_22654":136724,"_5":15607,"_29907":136706,"_3297":136725},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3844":80694,"_33198":80686,"_22654":136727,"_5":15607,"_29907":136706,"_3297":136728},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3844":80695,"_33198":80686,"_22654":136730,"_5":15607,"_29907":136706,"_3297":16334},[],{"_3844":80696,"_33198":80686,"_22654":136732,"_5":15607,"_29907":136706,"_3297":16270},[],{"_3844":80697,"_33198":80686,"_22654":136734,"_5":15607,"_29907":136706,"_3297":16327},[],{"_3844":80698,"_33198":80686,"_22654":136736,"_5":15607,"_29907":136706,"_3297":136737},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3844":80699,"_33198":80686,"_22654":136739,"_5":15607,"_29907":136706,"_3297":136740},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3844":80700,"_33198":80686,"_22654":136742,"_5":15607,"_29907":136710,"_3297":136743},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3844":80701,"_33198":80686,"_22654":136745,"_5":15607,"_29907":136710,"_3297":136746},[],"No incluyas en el reporte:",{"_3844":80702,"_33198":80686,"_22654":136748,"_5":15607,"_29907":136710,"_3297":136749},[],"Credenciales, tokens o claves privadas",{"_3844":80703,"_33198":80686,"_22654":136751,"_5":15607,"_29907":136710,"_3297":136752},[],"Datos de clientes o información identificable de clientes",{"_3844":80704,"_33198":80686,"_22654":136754,"_5":15607,"_29907":136710,"_3297":136755},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3844":80705,"_33198":80686,"_22654":136757,"_5":15607,"_29907":136714,"_3297":136758},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3844":80706,"_33198":80686,"_22654":136760,"_5":15607,"_29907":136714,"_3297":136761},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3844":80707,"_33198":80686,"_22654":136763,"_5":15607,"_29907":136718,"_3297":136764},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3844":80708,"_33198":80686,"_22654":136766,"_5":15607,"_29907":136718,"_3297":136767},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3844":80709,"_33198":80686,"_22654":136769,"_5":15607,"_29907":136718,"_3297":136770},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3844":80710,"_33198":80686,"_22654":136772,"_5":15607,"_29907":136718,"_3297":136773},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3844":80711,"_33198":80686,"_22654":136775,"_5":15607,"_29907":136718,"_3297":136776},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3844":80712,"_33198":80712,"_5":16006,"_3297":136778,"_33604":136779,"_22654":136781,"_29907":80712},"3.8.0 a 4.0.0",[54402,136780],"Actualizaciones",[],{"_3844":80713,"_33198":80712,"_22654":136783,"_5":15607,"_29907":80712,"_3297":136784},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3844":80714,"_33198":80712,"_5":33601,"_22654":136786,"_29907":136787,"_3297":136788},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3844":80715,"_33198":80712,"_5":33601,"_22654":136790,"_29907":136791,"_3297":136792},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3844":80716,"_33198":80712,"_5":33601,"_22654":136794,"_29907":136795,"_3297":136796},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3844":80717,"_33198":80712,"_5":33601,"_22654":136798,"_29907":136799,"_3297":136800},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3844":80718,"_33198":80712,"_5":33601,"_22654":136802,"_29907":136803,"_3297":136804},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3844":80719,"_33198":80712,"_5":33601,"_22654":136806,"_29907":136807,"_3297":136808},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3844":80720,"_33198":80712,"_5":33601,"_22654":136810,"_29907":136811,"_3297":63784},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3844":80721,"_33198":80712,"_5":33601,"_22654":136813,"_29907":136814,"_3297":136815},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3844":80722,"_33198":80712,"_5":33601,"_22654":136817,"_29907":136818,"_3297":136819},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3844":80723,"_33198":80712,"_5":33601,"_22654":136821,"_29907":136822,"_3297":136823},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3844":80724,"_33198":80712,"_5":33601,"_22654":136825,"_29907":136826,"_3297":136827},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3844":80725,"_33198":80712,"_5":33601,"_22654":136829,"_29907":136830,"_3297":136831},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3844":80726,"_33198":80712,"_5":33601,"_22654":136833,"_29907":136834,"_3297":136835},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3844":80727,"_33198":80712,"_5":33601,"_22654":136837,"_29907":136838,"_3297":136839},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3844":80728,"_33198":80712,"_5":33601,"_22654":136841,"_29907":136842,"_3297":136843},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3844":80729,"_33198":80712,"_5":33601,"_22654":136845,"_29907":136846,"_3297":136847},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3844":80730,"_33198":80712,"_5":33601,"_22654":136849,"_29907":136850,"_3297":136851},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3844":80731,"_33198":80712,"_5":33601,"_22654":136853,"_29907":136854,"_3297":136855},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3844":80732,"_33198":80712,"_5":33601,"_22654":136857,"_29907":136858,"_3297":136859},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3844":80733,"_33198":80712,"_5":33601,"_22654":136861,"_29907":136862,"_3297":136863},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-roles-va","Referencias entre certificados, claves y roles VA",{"_3844":80734,"_33198":80712,"_5":33601,"_22654":136865,"_29907":136866,"_3297":136867},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3844":80735,"_33198":80712,"_5":33601,"_22654":136869,"_29907":136870,"_3297":136871},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3844":80736,"_33198":80712,"_5":33601,"_22654":136873,"_29907":136874,"_3297":136875},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3844":80737,"_33198":80712,"_5":33601,"_22654":136877,"_29907":136878,"_3297":136879},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3844":80738,"_33198":80712,"_5":33601,"_22654":136881,"_29907":136882,"_3297":136883},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3844":80739,"_33198":80712,"_5":33601,"_22654":136885,"_29907":136886,"_3297":136887},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3844":80740,"_33198":80712,"_5":33601,"_22654":136889,"_29907":136890,"_3297":136891},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3844":80741,"_33198":80712,"_5":33601,"_22654":136893,"_29907":136894,"_3297":136895},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#campo-firmante-del-rol-va","Campo firmante del rol VA",{"_3844":80742,"_33198":80712,"_5":33601,"_22654":136897,"_29907":136898,"_3297":136899},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3844":80743,"_33198":80712,"_5":33601,"_22654":136901,"_29907":136902,"_3297":136903},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3844":80744,"_33198":80712,"_5":33601,"_22654":136905,"_29907":136906,"_3297":136907},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3844":80745,"_33198":80712,"_5":33601,"_22654":136909,"_29907":136910,"_3297":136911},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3844":80746,"_33198":80712,"_5":33601,"_22654":136913,"_29907":136914,"_3297":136915},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3844":80747,"_33198":80712,"_5":33601,"_22654":136917,"_29907":136918,"_3297":136919},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3844":80748,"_33198":80712,"_5":33601,"_22654":136921,"_29907":136922,"_3297":136923},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3844":80749,"_33198":80712,"_5":33601,"_22654":136925,"_29907":136926,"_3297":131667},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3844":80750,"_33198":80712,"_5":33601,"_22654":136928,"_29907":136929,"_3297":136930},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3844":80751,"_33198":80712,"_5":33601,"_22654":136932,"_29907":136933,"_3297":136934},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3844":80752,"_33198":80712,"_22654":136936,"_5":15607,"_29907":80712,"_3297":136937},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3844":80753,"_33198":80712,"_22654":136939,"_5":15607,"_29907":80712,"_3297":136940},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3844":80754,"_33198":80712,"_22654":136942,"_5":15607,"_29907":80712,"_3297":136943},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3844":80755,"_33198":80712,"_22654":136945,"_5":15607,"_29907":80712,"_3297":136946},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3844":80756,"_33198":80712,"_22654":136948,"_5":15607,"_29907":80712,"_3297":136949},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3844":80757,"_33198":80712,"_22654":136951,"_5":15607,"_29907":80712,"_3297":136952},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3844":80758,"_33198":80712,"_22654":136954,"_5":15607,"_29907":80712,"_3297":136955},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3844":80759,"_33198":80712,"_22654":136957,"_5":15607,"_29907":136791,"_3297":136958},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3844":80760,"_33198":80712,"_22654":136960,"_5":15607,"_29907":136791,"_3297":136961},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3844":80761,"_33198":80712,"_22654":136963,"_5":15607,"_29907":136795,"_3297":136964},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3844":80762,"_33198":80712,"_22654":136966,"_5":15607,"_29907":136795,"_3297":136967},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3844":80763,"_33198":80712,"_22654":136969,"_5":15607,"_29907":136799,"_3297":136970},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3844":80764,"_33198":80712,"_22654":136972,"_5":15607,"_29907":136803,"_3297":136973},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3844":80765,"_33198":80712,"_22654":136975,"_5":15607,"_29907":136803,"_3297":136976},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3844":80766,"_33198":80712,"_22654":136978,"_5":15607,"_29907":136803,"_3297":136979},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3844":80767,"_33198":80712,"_22654":136981,"_5":15607,"_29907":136803,"_3297":136982},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3844":80768,"_33198":80712,"_22654":136984,"_5":15607,"_29907":136803,"_3297":136985},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3844":80769,"_33198":80712,"_22654":136987,"_5":15607,"_29907":136807,"_3297":136988},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3844":80770,"_33198":80712,"_22654":136990,"_5":15607,"_29907":136807,"_3297":136991},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3844":80771,"_33198":80712,"_22654":136993,"_5":15607,"_29907":136807,"_3297":136994},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3844":80772,"_33198":80712,"_22654":136996,"_5":15607,"_29907":136807,"_3297":136997},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3844":80773,"_33198":80712,"_22654":136999,"_5":15607,"_29907":136807,"_3297":137000},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3844":80774,"_33198":80712,"_22654":137002,"_5":15607,"_29907":136811,"_3297":137003},[],"Cambio",{"_3844":80775,"_33198":80712,"_22654":137005,"_5":15607,"_29907":136811,"_3297":137006},[],"A quién afecta",{"_3844":80776,"_33198":80712,"_22654":137008,"_5":15607,"_29907":136811,"_3297":137009},[],"Gravedad",{"_3844":80777,"_33198":80712,"_22654":137011,"_5":15607,"_29907":136811,"_3297":134372},[],{"_3844":80778,"_33198":80712,"_22654":137013,"_5":15607,"_29907":136811,"_3297":136819},[],{"_3844":80779,"_33198":80712,"_22654":137015,"_5":15607,"_29907":136811,"_3297":137016},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3844":80780,"_33198":80712,"_22654":137018,"_5":15607,"_29907":136811,"_3297":137019},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3844":80781,"_33198":80712,"_22654":137021,"_5":15607,"_29907":136811,"_3297":137022},[],"Copiar los datos a los volúmenes nuevos",{"_3844":80782,"_33198":80712,"_22654":137024,"_5":15607,"_29907":136811,"_3297":136823},[],{"_3844":80783,"_33198":80712,"_22654":137026,"_5":15607,"_29907":136811,"_3297":137027},[],"Todas las releases de Helm",{"_3844":80784,"_33198":80712,"_22654":137029,"_5":15607,"_29907":136811,"_3297":137030},[],"Alta: `helm upgrade` falla",{"_3844":80785,"_33198":80712,"_22654":137032,"_5":15607,"_29907":136811,"_3297":137033},[],"Eliminar o renombrar las claves heredadas",{"_3844":80786,"_33198":80712,"_22654":137035,"_5":15607,"_29907":136811,"_3297":136827},[],{"_3844":80787,"_33198":80712,"_22654":137037,"_5":15607,"_29907":136811,"_3297":137038},[],"Todos los despliegues",{"_3844":80788,"_33198":80712,"_22654":137040,"_5":15607,"_29907":136811,"_3297":137041},[],"Alta: sin principal de bootstrap no hay administrador",{"_3844":80789,"_33198":80712,"_22654":137043,"_5":15607,"_29907":136811,"_3297":137044},[],"Configurar `services.authz`",{"_3844":80790,"_33198":80712,"_22654":137046,"_5":15607,"_29907":136811,"_3297":136831},[],{"_3844":80791,"_33198":80712,"_22654":137048,"_5":15607,"_29907":136811,"_3297":137027},[],{"_3844":80792,"_33198":80712,"_22654":137050,"_5":15607,"_29907":136811,"_3297":137051},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3844":80793,"_33198":80712,"_22654":137053,"_5":15607,"_29907":136811,"_3297":137054},[],"Mover JWKS y roles a `services.authz`",{"_3844":80794,"_33198":80712,"_22654":137056,"_5":15607,"_29907":136811,"_3297":136851},[],{"_3844":80795,"_33198":80712,"_22654":137058,"_5":15607,"_29907":136811,"_3297":137059},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3844":80796,"_33198":80712,"_22654":137061,"_5":15607,"_29907":136811,"_3297":137062},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3844":80797,"_33198":80712,"_22654":137064,"_5":15607,"_29907":136811,"_3297":137065},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3844":80798,"_33198":80712,"_22654":137067,"_5":15607,"_29907":136811,"_3297":136855},[],{"_3844":80799,"_33198":80712,"_22654":137069,"_5":15607,"_29907":136811,"_3297":137070},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3844":80800,"_33198":80712,"_22654":137072,"_5":15607,"_29907":136811,"_3297":137073},[],"Alta: el backend ya no arranca con ellos",{"_3844":80801,"_33198":80712,"_22654":137075,"_5":15607,"_29907":136811,"_3297":137076},[],"Pasar a PostgreSQL antes de actualizar",{"_3844":80802,"_33198":80712,"_22654":137078,"_5":15607,"_29907":136811,"_3297":137079},[],"Webhooks con referencias a archivos",{"_3844":80803,"_33198":80712,"_22654":137081,"_5":15607,"_29907":136811,"_3297":137082},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3844":80804,"_33198":80712,"_22654":137084,"_5":15607,"_29907":136811,"_3297":137085},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3844":80805,"_33198":80712,"_22654":137087,"_5":15607,"_29907":136811,"_3297":137088},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3844":80806,"_33198":80712,"_22654":137090,"_5":15607,"_29907":136811,"_3297":136835},[],{"_3844":80807,"_33198":80712,"_22654":137092,"_5":15607,"_29907":136811,"_3297":137093},[],"Releases con identidades por servicio o material de claves montado",{"_3844":80808,"_33198":80712,"_22654":137095,"_5":15607,"_29907":136811,"_3297":137096},[],"Media: los servicios no pueden leer sus archivos",{"_3844":80809,"_33198":80712,"_22654":137098,"_5":15607,"_29907":136811,"_3297":137099},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3844":80810,"_33198":80712,"_22654":137101,"_5":15607,"_29907":136811,"_3297":136839},[],{"_3844":80811,"_33198":80712,"_22654":137103,"_5":15607,"_29907":136811,"_3297":137104},[],"Releases que definen `amqp.tls`",{"_3844":80812,"_33198":80712,"_22654":137106,"_5":15607,"_29907":136811,"_3297":137107},[],"Media: los clientes se conectan al puerto equivocado",{"_3844":80813,"_33198":80712,"_22654":137109,"_5":15607,"_29907":136811,"_3297":137110},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3844":80814,"_33198":80712,"_22654":137112,"_5":15607,"_29907":136811,"_3297":136859},[],{"_3844":80815,"_33198":80712,"_22654":137114,"_5":15607,"_29907":136811,"_3297":137115},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3844":80816,"_33198":80712,"_22654":137117,"_5":15607,"_29907":136811,"_3297":137118},[],"Media: las claves de CA quedan sin gestionar",{"_3844":80817,"_33198":80712,"_22654":137120,"_5":15607,"_29907":136811,"_3297":137121},[],"Ejecutar la migración de CA a KMS",{"_3844":80818,"_33198":80712,"_22654":137123,"_5":15607,"_29907":136811,"_3297":137124},[],"Verificación del certificado del receptor",{"_3844":80819,"_33198":80712,"_22654":137126,"_5":15607,"_29907":136811,"_3297":137127},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3844":80820,"_33198":80712,"_22654":137129,"_5":15607,"_29907":136811,"_3297":137130},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3844":80821,"_33198":80712,"_22654":137132,"_5":15607,"_29907":136811,"_3297":137133},[],"Poner `insecure_skip_verify` a `false`",{"_3844":80822,"_33198":80712,"_22654":137135,"_5":15607,"_29907":136811,"_3297":136875},[],{"_3844":80823,"_33198":80712,"_22654":137137,"_5":15607,"_29907":136811,"_3297":137138},[],"Scripts y consolas que editan DMS por API",{"_3844":80824,"_33198":80712,"_22654":137140,"_5":15607,"_29907":136811,"_3297":137141},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3844":80825,"_33198":80712,"_22654":137143,"_5":15607,"_29907":136811,"_3297":137144},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3844":80826,"_33198":80712,"_22654":137146,"_5":15607,"_29907":136811,"_3297":136895},[],{"_3844":80827,"_33198":80712,"_22654":137148,"_5":15607,"_29907":136811,"_3297":137149},[],"Clientes que crean o actualizan roles VA por API",{"_3844":80828,"_33198":80712,"_22654":137151,"_5":15607,"_29907":136811,"_3297":137152},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3844":80829,"_33198":80712,"_22654":137154,"_5":15607,"_29907":136811,"_3297":137155},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_certificate_serial_number`",{"_3844":80830,"_33198":80712,"_22654":137157,"_5":15607,"_29907":136811,"_3297":136891},[],{"_3844":80831,"_33198":80712,"_22654":137159,"_5":15607,"_29907":136811,"_3297":137160},[],"Consumidores que leen el campo `events` del dispositivo",{"_3844":80832,"_33198":80712,"_22654":137162,"_5":15607,"_29907":136811,"_3297":137163},[],"Media: el campo desaparece",{"_3844":80833,"_33198":80712,"_22654":137165,"_5":15607,"_29907":136811,"_3297":137166},[],"Usar los nuevos endpoints de eventos",{"_3844":80834,"_33198":80712,"_22654":137168,"_5":15607,"_29907":136811,"_3297":136843},[],{"_3844":80835,"_33198":80712,"_22654":137170,"_5":15607,"_29907":136811,"_3297":137171},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3844":80836,"_33198":80712,"_22654":137173,"_5":15607,"_29907":136811,"_3297":137174},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3844":80837,"_33198":80712,"_22654":137176,"_5":15607,"_29907":136811,"_3297":137177},[],"Actualizar el archivo de values",{"_3844":80838,"_33198":80712,"_22654":137179,"_5":15607,"_29907":136811,"_3297":136883},[],{"_3844":80839,"_33198":80712,"_22654":137181,"_5":15607,"_29907":136811,"_3297":137182},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3844":80840,"_33198":80712,"_22654":137184,"_5":15607,"_29907":136811,"_3297":137185},[],"Baja: prevalece el ID de la URL",{"_3844":80841,"_33198":80712,"_22654":137187,"_5":15607,"_29907":136811,"_3297":137188},[],"Enviar el ID en la URL",{"_3844":80842,"_33198":80712,"_22654":137190,"_5":15607,"_29907":136811,"_3297":136887},[],{"_3844":80843,"_33198":80712,"_22654":137192,"_5":15607,"_29907":136811,"_3297":137193},[],"Consumidores que comparan el `type` del certificado",{"_3844":80844,"_33198":80712,"_22654":137195,"_5":15607,"_29907":136811,"_3297":137196},[],"Baja: dos valores cambian de nombre",{"_3844":80845,"_33198":80712,"_22654":137198,"_5":15607,"_29907":136811,"_3297":137199},[],"Adaptar los consumidores",{"_3844":80846,"_33198":80712,"_22654":137201,"_5":15607,"_29907":136811,"_3297":136879},[],{"_3844":80847,"_33198":80712,"_22654":137203,"_5":15607,"_29907":136811,"_3297":137204},[],"Cualquier DMS",{"_3844":80848,"_33198":80712,"_22654":137206,"_5":15607,"_29907":136811,"_3297":137207},[],"Baja: solo informativo",{"_3844":80849,"_33198":80712,"_22654":137209,"_5":15607,"_29907":136811,"_3297":137210},[],"Revisar ambos bloques antes de editar",{"_3844":80850,"_33198":80712,"_22654":137212,"_5":15607,"_29907":136818,"_3297":137213},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3844":80851,"_33198":80712,"_22654":137215,"_5":15607,"_29907":136818,"_3297":137216},[],"El paso 4 de la guía de migración copia los datos.",{"_3844":80852,"_33198":80712,"_22654":137218,"_5":15607,"_29907":136822,"_3297":137219},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3844":80853,"_33198":80712,"_22654":137221,"_5":15607,"_29907":136826,"_3297":137222},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3844":80854,"_33198":80712,"_22654":137224,"_5":15607,"_29907":136830,"_3297":137225},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3844":80855,"_33198":80712,"_22654":137227,"_5":15607,"_29907":136834,"_3297":137228},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3844":80856,"_33198":80712,"_22654":137230,"_5":15607,"_29907":136834,"_3297":137231},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3844":80857,"_33198":80712,"_22654":137233,"_5":15607,"_29907":136838,"_3297":137234},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3844":80858,"_33198":80712,"_22654":137236,"_5":15607,"_29907":136842,"_3297":137237},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3844":80859,"_33198":80712,"_22654":137239,"_5":15607,"_29907":136842,"_3297":137240},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3844":80860,"_33198":80712,"_22654":137242,"_5":15607,"_29907":136842,"_3297":137243},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3844":80861,"_33198":80712,"_22654":137245,"_5":15607,"_29907":136842,"_3297":137246},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3844":80862,"_33198":80712,"_22654":137248,"_5":15607,"_29907":136842,"_3297":137249},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3844":80863,"_33198":80712,"_22654":137251,"_5":15607,"_29907":136842,"_3297":137252},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3844":80864,"_33198":80712,"_22654":137254,"_5":15607,"_29907":136850,"_3297":137255},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3844":80865,"_33198":80712,"_22654":137257,"_5":15607,"_29907":136850,"_3297":137258},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3844":80866,"_33198":80712,"_22654":137260,"_5":15607,"_29907":136850,"_3297":137261},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3844":80867,"_33198":80712,"_22654":137263,"_5":15607,"_29907":136850,"_3297":137264},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3844":80868,"_33198":80712,"_22654":137266,"_5":15607,"_29907":136850,"_3297":137267},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3844":80869,"_33198":80712,"_22654":137269,"_5":15607,"_29907":136854,"_3297":137270},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3844":80870,"_33198":80712,"_22654":137272,"_5":15607,"_29907":136858,"_3297":137273},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3844":80871,"_33198":80712,"_22654":137275,"_5":15607,"_29907":136858,"_3297":137276},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3844":80872,"_33198":80712,"_22654":137278,"_5":15607,"_29907":136858,"_3297":137279},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3844":80873,"_33198":80712,"_22654":137281,"_5":15607,"_29907":136858,"_3297":137282},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3844":80874,"_33198":80712,"_22654":137284,"_5":15607,"_29907":136858,"_3297":137285},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3844":80875,"_33198":80712,"_22654":137287,"_5":15607,"_29907":136858,"_3297":137288},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3844":80876,"_33198":80712,"_22654":137290,"_5":15607,"_29907":136858,"_3297":137291},[],"Una vez registradas las claves heredadas, arrancar el KMS con la opción de configuración del backend `crypto_engines.migrate_keys_format` renombra las claves cuyo nombre no es el digest SHA-256 de la clave pública, conserva el nombre antiguo como alias y traslada consigo las referencias de certificados. Es seguro volver a ejecutarla y puede desactivarse después.",{"_3844":80877,"_33198":80712,"_22654":137293,"_5":15607,"_29907":136862,"_3297":137294},[],"Los certificados referencian ahora su clave del KMS, y los roles VA referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3844":80878,"_33198":80712,"_22654":137296,"_5":15607,"_29907":136870,"_3297":137297},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3844":80879,"_33198":80712,"_22654":137299,"_5":15607,"_29907":136870,"_3297":137300},[],"Campo en 3.8.0",{"_3844":80880,"_33198":80712,"_22654":137302,"_5":15607,"_29907":136870,"_3297":137303},[],"Campo en 4.0.0",{"_3844":80881,"_33198":80712,"_22654":137305,"_5":15607,"_29907":136870,"_3297":64279},[],{"_3844":80882,"_33198":80712,"_22654":137307,"_5":15607,"_29907":136870,"_3297":137308},[],"`insecure_skip_verify` (con el valor negado)",{"_3844":80883,"_33198":80712,"_22654":137310,"_5":15607,"_29907":136870,"_3297":64285},[],{"_3844":80884,"_33198":80712,"_22654":137312,"_5":15607,"_29907":136870,"_3297":64288},[],{"_3844":80885,"_33198":80712,"_22654":137314,"_5":15607,"_29907":136870,"_3297":64291},[],{"_3844":80886,"_33198":80712,"_22654":137316,"_5":15607,"_29907":136870,"_3297":64294},[],{"_3844":80887,"_33198":80712,"_22654":137318,"_5":15607,"_29907":136870,"_3297":64297},[],{"_3844":80888,"_33198":80712,"_22654":137320,"_5":15607,"_29907":136870,"_3297":64300},[],{"_3844":80889,"_33198":80712,"_22654":137322,"_5":15607,"_29907":136870,"_3297":137323},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3844":80890,"_33198":80712,"_22654":137325,"_5":15607,"_29907":136870,"_3297":137326},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3844":80891,"_33198":80712,"_22654":137328,"_5":15607,"_29907":136870,"_3297":137329},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3844":80892,"_33198":80712,"_22654":137331,"_5":15607,"_29907":136874,"_3297":137332},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3844":80893,"_33198":80712,"_22654":137334,"_5":15607,"_29907":136874,"_3297":137335},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3844":80894,"_33198":80712,"_22654":137337,"_5":15607,"_29907":136874,"_3297":137338},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3844":80895,"_33198":80712,"_22654":137340,"_5":15607,"_29907":136878,"_3297":137341},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3844":80896,"_33198":80712,"_22654":137343,"_5":15607,"_29907":136882,"_3297":137344},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3844":80897,"_33198":80712,"_22654":137346,"_5":15607,"_29907":136886,"_3297":137347},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3844":80898,"_33198":80712,"_22654":137349,"_5":15607,"_29907":136890,"_3297":137350},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3844":80899,"_33198":80712,"_22654":137352,"_5":15607,"_29907":136890,"_3297":137353},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3844":80900,"_33198":80712,"_22654":137355,"_5":15607,"_29907":136890,"_3297":137356},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3844":80901,"_33198":80712,"_22654":137358,"_5":15607,"_29907":136890,"_3297":137359},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3844":80902,"_33198":80712,"_22654":137361,"_5":15607,"_29907":136894,"_3297":137362},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_certificate_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de un rol nuevo es el número de serie del certificado actual de la CA. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. Las políticas de autorización personalizadas que filtran por el campo antiguo deben actualizarse: el filtro `crl_subject_key_id_signer` se renombra a `crl_signer_certificate_serial_number` y toma valores de número de serie.",{"_3844":80903,"_33198":80712,"_22654":137364,"_5":15607,"_29907":136898,"_3297":137365},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3844":80904,"_33198":80712,"_22654":137367,"_5":15607,"_29907":136902,"_3297":137368},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_3844":80905,"_33198":80712,"_22654":137370,"_5":15607,"_29907":136902,"_3297":137371},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3844":80906,"_33198":80712,"_22654":137373,"_5":15607,"_29907":136902,"_3297":137374},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3844":80907,"_33198":80712,"_22654":137376,"_5":15607,"_29907":136902,"_3297":137377},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3844":80908,"_33198":80712,"_22654":137379,"_5":15607,"_29907":136902,"_3297":137380},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3844":80909,"_33198":80712,"_22654":137382,"_5":15607,"_29907":136906,"_3297":137383},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3844":80910,"_33198":80712,"_22654":137385,"_5":15607,"_29907":136906,"_3297":137386},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3844":80911,"_33198":80712,"_22654":137388,"_5":15607,"_29907":136906,"_3297":137389},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3844":80912,"_33198":80712,"_22654":137391,"_5":15607,"_29907":136906,"_3297":137392},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3844":80913,"_33198":80712,"_22654":137394,"_5":15607,"_29907":136906,"_3297":137395},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3844":80914,"_33198":80712,"_22654":137397,"_5":15607,"_29907":136906,"_3297":137398},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3844":80915,"_33198":80712,"_22654":137400,"_5":15607,"_29907":136906,"_3297":137401},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3844":80916,"_33198":80712,"_22654":137403,"_5":15607,"_29907":136906,"_3297":137404},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3844":80917,"_33198":80712,"_22654":137406,"_5":15607,"_29907":136906,"_3297":137407},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3844":80918,"_33198":80712,"_22654":137409,"_5":15607,"_29907":136906,"_3297":137410},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3844":80919,"_33198":80712,"_22654":137412,"_5":15607,"_29907":136906,"_3297":137413},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3844":80920,"_33198":80712,"_22654":137415,"_5":15607,"_29907":136906,"_3297":137416},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3844":80921,"_33198":80712,"_22654":137418,"_5":15607,"_29907":136910,"_3297":137419},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3844":80922,"_33198":80712,"_22654":137421,"_5":15607,"_29907":136910,"_3297":137422},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3844":80923,"_33198":80712,"_22654":137424,"_5":15607,"_29907":136914,"_3297":137425},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3844":80924,"_33198":80712,"_22654":137427,"_5":15607,"_29907":136914,"_3297":137428},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3844":80925,"_33198":80712,"_22654":137430,"_5":15607,"_29907":136914,"_3297":137431},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3844":80926,"_33198":80712,"_22654":137433,"_5":15607,"_29907":136914,"_3297":137434},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3844":80927,"_33198":80712,"_22654":137436,"_5":15607,"_29907":136914,"_3297":137437},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3844":80928,"_33198":80712,"_22654":137439,"_5":15607,"_29907":136914,"_3297":137440},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3844":80929,"_33198":80712,"_22654":137442,"_5":15607,"_29907":136914,"_3297":137443},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3844":80930,"_33198":80712,"_22654":137445,"_5":15607,"_29907":136914,"_3297":137446},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3844":80931,"_33198":80712,"_22654":137448,"_5":15607,"_29907":136914,"_3297":137449},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3844":80932,"_33198":80712,"_22654":137451,"_5":15607,"_29907":136914,"_3297":137452},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3844":80933,"_33198":80712,"_22654":137454,"_5":15607,"_29907":136914,"_3297":137455},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3844":80934,"_33198":80712,"_22654":137457,"_5":15607,"_29907":136918,"_3297":137458},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3844":80935,"_33198":80712,"_22654":137460,"_5":15607,"_29907":136918,"_3297":137461},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3844":80936,"_33198":80712,"_22654":137463,"_5":15607,"_29907":136922,"_3297":137464},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3844":80937,"_33198":80712,"_22654":137466,"_5":15607,"_29907":136922,"_3297":137467},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3844":80938,"_33198":80712,"_22654":137469,"_5":15607,"_29907":136922,"_3297":137470},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Si tus servicios se conectan con un usuario distinto del que ejecutó las migraciones, concédele tras las migraciones `SELECT` sobre `ca.certificates_view`.",{"_3844":80939,"_33198":80712,"_22654":137472,"_5":15607,"_29907":136922,"_3297":137473},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3844":80940,"_33198":80712,"_22654":137475,"_5":15607,"_29907":136922,"_3297":137476},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3844":80941,"_33198":80712,"_22654":137478,"_5":15607,"_29907":136922,"_3297":137479},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3844":80942,"_33198":80712,"_22654":137481,"_5":15607,"_29907":136922,"_3297":137482},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3844":80943,"_33198":80712,"_22654":137484,"_5":15607,"_29907":136926,"_3297":137485},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3844":80944,"_33198":80712,"_22654":137487,"_5":15607,"_29907":136926,"_3297":137488},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3844":80945,"_33198":80712,"_22654":137490,"_5":15607,"_29907":136926,"_3297":137491},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3844":80946,"_33198":80712,"_22654":137493,"_5":15607,"_29907":136926,"_3297":137494},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3844":80947,"_33198":80712,"_22654":137496,"_5":15607,"_29907":136926,"_3297":137497},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_3844":80948,"_33198":80712,"_22654":137499,"_5":15607,"_29907":136926,"_3297":137500},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3844":80949,"_33198":80712,"_22654":137502,"_5":15607,"_29907":136926,"_3297":137503},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3844":80950,"_33198":80712,"_22654":137505,"_5":15607,"_29907":136926,"_3297":137506},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_3844":80951,"_33198":80712,"_22654":137508,"_5":15607,"_29907":136926,"_3297":137509},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3844":80952,"_33198":80712,"_22654":137511,"_5":15607,"_29907":136926,"_3297":137512},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_certificate_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3844":80953,"_33198":80712,"_22654":137514,"_5":15607,"_29907":136926,"_3297":137515},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_3844":80954,"_33198":80712,"_22654":137517,"_5":15607,"_29907":136929,"_3297":137518},[],"Tras la actualización, comprueba en este orden:",{"_3844":80955,"_33198":80712,"_22654":137520,"_5":15607,"_29907":136929,"_3297":137521},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3844":80956,"_33198":80712,"_22654":137523,"_5":15607,"_29907":136929,"_3297":137524},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3844":80957,"_33198":80712,"_22654":137526,"_5":15607,"_29907":136929,"_3297":137527},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3844":80958,"_33198":80712,"_22654":137529,"_5":15607,"_29907":136929,"_3297":137530},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_3844":80959,"_33198":80712,"_22654":137532,"_5":15607,"_29907":136929,"_3297":137533},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_3844":80960,"_33198":80712,"_22654":137535,"_5":15607,"_29907":136929,"_3297":137536},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3844":80961,"_33198":80712,"_22654":137538,"_5":15607,"_29907":136929,"_3297":137539},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3844":80962,"_33198":80712,"_22654":137541,"_5":15607,"_29907":136929,"_3297":137542},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3844":80963,"_33198":80712,"_22654":137544,"_5":15607,"_29907":136929,"_3297":137545},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3844":80964,"_33198":80712,"_22654":137547,"_5":15607,"_29907":136929,"_3297":137548},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3844":80965,"_33198":80712,"_22654":137550,"_5":15607,"_29907":136929,"_3297":137551},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3844":80966,"_33198":80712,"_22654":137553,"_5":15607,"_29907":136929,"_3297":137554},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3844":80967,"_33198":80712,"_22654":137556,"_5":15607,"_29907":136929,"_3297":137557},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3844":80968,"_33198":80712,"_22654":137559,"_5":15607,"_29907":136929,"_3297":137560},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3844":80969,"_33198":80712,"_22654":137562,"_5":15607,"_29907":136933,"_3297":137563},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3844":80970,"_33198":80712,"_22654":137565,"_5":15607,"_29907":136933,"_3297":137566},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3844":80971,"_33198":80712,"_22654":137568,"_5":15607,"_29907":136933,"_3297":137569},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3844":80972,"_33198":80712,"_22654":137571,"_5":15607,"_29907":136933,"_3297":137572},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3844":80973,"_33198":80712,"_22654":137574,"_5":15607,"_29907":136933,"_3297":137575},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_64558":137577,"_64559":137578,"_64561":137579,"_64563":137580,"_19603":3332,"_77690":3332},"spanish",[3297,33198,5,29907],{"_3297":27123,"_33198":27123,"_5":27123,"_29907":27123},{"_3297":