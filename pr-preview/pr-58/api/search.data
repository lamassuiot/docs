{"_4098":81914,"_34307":81908,"_5":34735,"_23429":134192,"_30870":134193,"_3543":134194},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_4098":81915,"_34307":81908,"_5":34735,"_23429":134196,"_30870":134197,"_3543":134198},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_4098":81916,"_34307":81908,"_5":34735,"_23429":134200,"_30870":134201,"_3543":134202},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_4098":81917,"_34307":81908,"_23429":134204,"_5":16198,"_30870":81908,"_3543":134205},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_4098":81918,"_34307":81908,"_23429":134207,"_5":16198,"_30870":134177,"_3543":134208},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_4098":81919,"_34307":81908,"_23429":134210,"_5":16198,"_30870":134177,"_3543":134211},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_4098":81920,"_34307":81908,"_23429":134213,"_5":16198,"_30870":134177,"_3543":134214},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_4098":81921,"_34307":81908,"_23429":134216,"_5":16198,"_30870":134181,"_3543":134217},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_4098":81922,"_34307":81908,"_23429":134219,"_5":16198,"_30870":134181,"_3543":134220},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_4098":81923,"_34307":81908,"_23429":134222,"_5":16198,"_30870":134181,"_3543":134223},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_4098":81924,"_34307":81908,"_23429":134225,"_5":16198,"_30870":134185,"_3543":134226},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_4098":81925,"_34307":81908,"_23429":134228,"_5":16198,"_30870":134189,"_3543":134229},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_4098":81926,"_34307":81908,"_23429":134231,"_5":16198,"_30870":134193,"_3543":134232},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_4098":81927,"_34307":81908,"_23429":134234,"_5":16198,"_30870":134197,"_3543":134235},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_4098":81928,"_34307":81908,"_23429":134237,"_5":16198,"_30870":134201,"_3543":134238},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_4098":81929,"_34307":81929,"_5":16596,"_3543":134240,"_34738":134241,"_23429":134242,"_30870":81929},"Despliega Lamassu",[56936,134169],[],{"_4098":81930,"_34307":81929,"_23429":134244,"_5":16198,"_30870":81929,"_3543":134245},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_4098":81931,"_34307":81929,"_5":34735,"_23429":134247,"_30870":134248,"_3543":134249},[],"/docs/pr-preview/pr-58/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_4098":81932,"_34307":81929,"_5":34735,"_23429":134251,"_30870":134252,"_3543":134253},[],"/docs/pr-preview/pr-58/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_4098":81933,"_34307":81929,"_5":34735,"_23429":134255,"_30870":134256,"_3543":134257},[],"/docs/pr-preview/pr-58/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_4098":81934,"_34307":81929,"_23429":134259,"_5":16198,"_30870":81929,"_3543":134260},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_4098":81935,"_34307":81929,"_23429":134262,"_5":16198,"_30870":134248,"_3543":134263},[],"Modelo",{"_4098":81936,"_34307":81929,"_23429":134265,"_5":16198,"_30870":134248,"_3543":134266},[],"Recomendado para",{"_4098":81937,"_34307":81929,"_23429":134268,"_5":16198,"_30870":134248,"_3543":134269},[],"Quién opera la infraestructura",{"_4098":81938,"_34307":81929,"_23429":134271,"_5":16198,"_30870":134248,"_3543":134272},[],"Punto de partida",{"_4098":81939,"_34307":81929,"_23429":134274,"_5":16198,"_30870":134248,"_3543":57043},[],{"_4098":81940,"_34307":81929,"_23429":134276,"_5":16198,"_30870":134248,"_3543":134277},[],"Producción, entornos regulados y despliegues personalizados",{"_4098":81941,"_34307":81929,"_23429":134279,"_5":16198,"_30870":134248,"_3543":134280},[],"Tu equipo",{"_4098":81942,"_34307":81929,"_23429":134282,"_5":16198,"_30870":134248,"_3543":134283},[],"Helm o Fastlane",{"_4098":81943,"_34307":81929,"_23429":134285,"_5":16198,"_30870":134248,"_3543":57055},[],{"_4098":81944,"_34307":81929,"_23429":134287,"_5":16198,"_30870":134248,"_3543":134288},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_4098":81945,"_34307":81929,"_23429":134290,"_5":16198,"_30870":134248,"_3543":134280},[],{"_4098":81946,"_34307":81929,"_23429":134292,"_5":16198,"_30870":134248,"_3543":134293},[],"Imagen preconfigurada en EC2",{"_4098":81947,"_34307":81929,"_23429":134295,"_5":16198,"_30870":134248,"_3543":57066},[],{"_4098":81948,"_34307":81929,"_23429":134297,"_5":16198,"_30870":134248,"_3543":134298},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_4098":81949,"_34307":81929,"_23429":134300,"_5":16198,"_30870":134248,"_3543":57072},[],{"_4098":81950,"_34307":81929,"_23429":134302,"_5":16198,"_30870":134248,"_3543":134303},[],"Suscripción gestionada",{"_4098":81951,"_34307":81929,"_23429":134305,"_5":16198,"_30870":134248,"_3543":134306},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_4098":81952,"_34307":81929,"_23429":134308,"_5":16198,"_30870":134248,"_3543":134309},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_4098":81953,"_34307":81929,"_23429":134311,"_5":16198,"_30870":134248,"_3543":134312},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_4098":81954,"_34307":81929,"_23429":134314,"_5":16198,"_30870":134252,"_3543":134315},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_4098":81955,"_34307":81929,"_23429":134317,"_5":16198,"_30870":134256,"_3543":134318},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_4098":81956,"_34307":81956,"_5":16596,"_3543":134320,"_34738":134321,"_23429":134322,"_30870":81956},"Utiliza Lamassu como SaaS",[56936,134169,134170],[],{"_4098":81957,"_34307":81956,"_23429":134324,"_5":16198,"_30870":81956,"_3543":134325},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_4098":81958,"_34307":81956,"_5":34735,"_23429":134327,"_30870":134328,"_3543":134329},[],"/docs/pr-preview/pr-58/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_4098":81959,"_34307":81956,"_5":34735,"_23429":134331,"_30870":134332,"_3543":134333},[],"/docs/pr-preview/pr-58/es/deployment/saas#planes","Planes",{"_4098":81960,"_34307":81956,"_5":34735,"_23429":134335,"_30870":134336,"_3543":134337},[],"/docs/pr-preview/pr-58/es/deployment/saas#solicita-acceso","Solicita acceso",{"_4098":81961,"_34307":81956,"_23429":134339,"_5":16198,"_30870":81956,"_3543":134340},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_4098":81962,"_34307":81956,"_23429":134342,"_5":16198,"_30870":134328,"_3543":134343},[],"Disponibilidad y mantenimiento de la plataforma.",{"_4098":81963,"_34307":81956,"_23429":134345,"_5":16198,"_30870":134328,"_3543":134346},[],"Copias de seguridad automáticas.",{"_4098":81964,"_34307":81956,"_23429":134348,"_5":16198,"_30870":134328,"_3543":134349},[],"Actualizaciones de versión.",{"_4098":81965,"_34307":81956,"_23429":134351,"_5":16198,"_30870":134328,"_3543":134352},[],"Soporte técnico y SLA según el plan contratado.",{"_4098":81966,"_34307":81956,"_23429":134354,"_5":16198,"_30870":134332,"_3543":57127},[],{"_4098":81967,"_34307":81956,"_23429":134356,"_5":16198,"_30870":134332,"_3543":134357},[],"Dispositivos",{"_4098":81968,"_34307":81956,"_23429":134359,"_5":16198,"_30870":134332,"_3543":134360},[],"Soporte",{"_4098":81969,"_34307":81956,"_23429":134362,"_5":16198,"_30870":134332,"_3543":57136},[],{"_4098":81970,"_34307":81956,"_23429":134364,"_5":16198,"_30870":134332,"_3543":57139},[],{"_4098":81971,"_34307":81956,"_23429":134366,"_5":16198,"_30870":134332,"_3543":134367},[],"Hasta 1.000",{"_4098":81972,"_34307":81956,"_23429":134369,"_5":16198,"_30870":134332,"_3543":57145},[],{"_4098":81973,"_34307":81956,"_23429":134371,"_5":16198,"_30870":134332,"_3543":134372},[],"99,5 %",{"_4098":81974,"_34307":81956,"_23429":134374,"_5":16198,"_30870":134332,"_3543":57151},[],{"_4098":81975,"_34307":81956,"_23429":134376,"_5":16198,"_30870":134332,"_3543":134377},[],"Hasta 10.000",{"_4098":81976,"_34307":81956,"_23429":134379,"_5":16198,"_30870":134332,"_3543":134380},[],"Email y chat",{"_4098":81977,"_34307":81956,"_23429":134382,"_5":16198,"_30870":134332,"_3543":134383},[],"99,9 %",{"_4098":81978,"_34307":81956,"_23429":134385,"_5":16198,"_30870":134332,"_3543":57163},[],{"_4098":81979,"_34307":81956,"_23429":134387,"_5":16198,"_30870":134332,"_3543":134388},[],"Ilimitados",{"_4098":81980,"_34307":81956,"_23429":134390,"_5":16198,"_30870":134332,"_3543":134391},[],"Dedicado",{"_4098":81981,"_34307":81956,"_23429":134393,"_5":16198,"_30870":134332,"_3543":134394},[],"99,99 %",{"_4098":81982,"_34307":81956,"_23429":134396,"_5":16198,"_30870":134336,"_3543":134397},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_4098":81983,"_34307":81956,"_23429":134399,"_5":16198,"_30870":134336,"_3543":134400},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_4098":81984,"_34307":81984,"_5":16596,"_3543":57180,"_34738":134402,"_23429":134404,"_30870":81984},[56936,134169,134403],"Kubernetes autogestionado",[],{"_4098":81985,"_34307":81984,"_23429":134406,"_5":16198,"_30870":81984,"_3543":134407},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_4098":81986,"_34307":81984,"_5":34735,"_23429":134409,"_30870":134410,"_3543":134411},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_4098":81987,"_34307":81984,"_5":34735,"_23429":134413,"_30870":134414,"_3543":134415},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_4098":81988,"_34307":81984,"_5":34735,"_23429":134417,"_30870":134418,"_3543":134419},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_4098":81989,"_34307":81984,"_5":34735,"_23429":134421,"_30870":134422,"_3543":134423},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_4098":81990,"_34307":81984,"_5":34735,"_23429":134425,"_30870":134426,"_3543":134427},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_4098":81991,"_34307":81984,"_5":34735,"_23429":134429,"_30870":134430,"_3543":134431},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_4098":81992,"_34307":81984,"_5":34735,"_23429":134433,"_30870":134434,"_3543":134435},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_4098":81993,"_34307":81984,"_5":34735,"_23429":134437,"_30870":134438,"_3543":134439},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_4098":81994,"_34307":81984,"_5":34735,"_23429":134441,"_30870":134442,"_3543":134443},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_4098":81995,"_34307":81984,"_5":34735,"_23429":134445,"_30870":134446,"_3543":134447},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_4098":81996,"_34307":81984,"_5":34735,"_23429":134449,"_30870":134450,"_3543":134451},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_4098":81997,"_34307":81984,"_23429":134453,"_5":16198,"_30870":134410,"_3543":134454},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_4098":81998,"_34307":81984,"_23429":134456,"_5":16198,"_30870":134410,"_3543":134457},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_4098":81999,"_34307":81984,"_23429":134459,"_5":16198,"_30870":134414,"_3543":134460},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_4098":82000,"_34307":81984,"_23429":134462,"_5":16198,"_30870":134414,"_3543":134463},[],"Fastlane instala o configura",{"_4098":82001,"_34307":81984,"_23429":134465,"_5":16198,"_30870":134414,"_3543":134466},[],"Tú sigues proporcionando",{"_4098":82002,"_34307":81984,"_23429":134468,"_5":16198,"_30870":134414,"_3543":134469},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_4098":82003,"_34307":81984,"_23429":134471,"_5":16198,"_30870":134414,"_3543":134472},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_4098":82004,"_34307":81984,"_23429":134474,"_5":16198,"_30870":134414,"_3543":134475},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_4098":82005,"_34307":81984,"_23429":134477,"_5":16198,"_30870":134414,"_3543":134478},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_4098":82006,"_34307":81984,"_23429":134480,"_5":16198,"_30870":134414,"_3543":134481},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_4098":82007,"_34307":81984,"_23429":134483,"_5":16198,"_30870":134414,"_3543":134484},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_4098":82008,"_34307":81984,"_23429":134486,"_5":16198,"_30870":134414,"_3543":134487},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_4098":82009,"_34307":81984,"_23429":134489,"_5":16198,"_30870":134414,"_3543":134490},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_4098":82010,"_34307":81984,"_23429":134492,"_5":16198,"_30870":134414,"_3543":134493},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_4098":82011,"_34307":81984,"_23429":134495,"_5":16198,"_30870":134418,"_3543":134496},[],"Necesitas:",{"_4098":82012,"_34307":81984,"_23429":134498,"_5":16198,"_30870":134418,"_3543":134499},[],"un clúster Kubernetes existente",{"_4098":82013,"_34307":81984,"_23429":134501,"_5":16198,"_30870":134418,"_3543":134502},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_4098":82014,"_34307":81984,"_23429":134504,"_5":16198,"_30870":134418,"_3543":57282},[],{"_4098":82015,"_34307":81984,"_23429":134506,"_5":16198,"_30870":134418,"_3543":26546},[],{"_4098":82016,"_34307":81984,"_23429":134508,"_5":16198,"_30870":134418,"_3543":134509},[],"`jq` solo si usas `--sample-data` o `--development`",{"_4098":82017,"_34307":81984,"_23429":134511,"_5":16198,"_30870":134418,"_3543":134512},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_4098":82018,"_34307":81984,"_23429":134514,"_5":16198,"_30870":134418,"_3543":134515},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_4098":82019,"_34307":81984,"_23429":134517,"_5":16198,"_30870":134418,"_3543":134518},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_4098":82020,"_34307":81984,"_23429":134520,"_5":16198,"_30870":134418,"_3543":134521},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_4098":82021,"_34307":81984,"_23429":134523,"_5":16198,"_30870":134422,"_3543":134524},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_4098":82022,"_34307":81984,"_23429":134526,"_5":16198,"_30870":134422,"_3543":134527},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_4098":82023,"_34307":81984,"_23429":134529,"_5":16198,"_30870":134426,"_3543":134530},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_4098":82024,"_34307":81984,"_23429":134532,"_5":16198,"_30870":134426,"_3543":134533},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_4098":82025,"_34307":81984,"_23429":134535,"_5":16198,"_30870":134426,"_3543":134536},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_4098":82026,"_34307":81984,"_23429":134538,"_5":16198,"_30870":134426,"_3543":134539},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_4098":82027,"_34307":81984,"_23429":134541,"_5":16198,"_30870":134430,"_3543":134542},[],"Opción",{"_4098":82028,"_34307":81984,"_23429":134544,"_5":16198,"_30870":134430,"_3543":134545},[],"Valor predeterminado",{"_4098":82029,"_34307":81984,"_23429":134547,"_5":16198,"_30870":134430,"_3543":134548},[],"Propósito",{"_4098":82030,"_34307":81984,"_23429":134550,"_5":16198,"_30870":134430,"_3543":57329},[],{"_4098":82031,"_34307":81984,"_23429":134552,"_5":16198,"_30870":134430,"_3543":57332},[],{"_4098":82032,"_34307":81984,"_23429":134554,"_5":16198,"_30870":134430,"_3543":134555},[],"Muestra la ayuda",{"_4098":82033,"_34307":81984,"_23429":134557,"_5":16198,"_30870":134430,"_3543":57338},[],{"_4098":82034,"_34307":81984,"_23429":134559,"_5":16198,"_30870":134430,"_3543":134560},[],"contexto actual",{"_4098":82035,"_34307":81984,"_23429":134562,"_5":16198,"_30870":134430,"_3543":134563},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_4098":82036,"_34307":81984,"_23429":134565,"_5":16198,"_30870":134430,"_3543":57347},[],{"_4098":82037,"_34307":81984,"_23429":134567,"_5":16198,"_30870":134430,"_3543":7434},[],{"_4098":82038,"_34307":81984,"_23429":134569,"_5":16198,"_30870":134430,"_3543":134570},[],"Omite prompts y genera credenciales para las dependencias",{"_4098":82039,"_34307":81984,"_23429":134572,"_5":16198,"_30870":134430,"_3543":57355},[],{"_4098":82040,"_34307":81984,"_23429":134574,"_5":16198,"_30870":134430,"_3543":57358},[],{"_4098":82041,"_34307":81984,"_23429":134576,"_5":16198,"_30870":134430,"_3543":134577},[],"Namespace de la instalación",{"_4098":82042,"_34307":81984,"_23429":134579,"_5":16198,"_30870":134430,"_3543":57364},[],{"_4098":82043,"_34307":81984,"_23429":134581,"_5":16198,"_30870":134430,"_3543":57367},[],{"_4098":82044,"_34307":81984,"_23429":134583,"_5":16198,"_30870":134430,"_3543":134584},[],"Dominio usado por la UI, OIDC y el certificado",{"_4098":82045,"_34307":81984,"_23429":134586,"_5":16198,"_30870":134430,"_3543":57373},[],{"_4098":82046,"_34307":81984,"_23429":134588,"_5":16198,"_30870":134430,"_3543":17031},[],{"_4098":82047,"_34307":81984,"_23429":134590,"_5":16198,"_30870":134430,"_3543":134591},[],"Versión del chart de Lamassu",{"_4098":82048,"_34307":81984,"_23429":134593,"_5":16198,"_30870":134430,"_3543":57381},[],{"_4098":82049,"_34307":81984,"_23429":134595,"_5":16198,"_30870":134430,"_3543":57384},[],{"_4098":82050,"_34307":81984,"_23429":134597,"_5":16198,"_30870":134430,"_3543":134598},[],"Puerto del listener HTTPS",{"_4098":82051,"_34307":81984,"_23429":134600,"_5":16198,"_30870":134430,"_3543":57390},[],{"_4098":82052,"_34307":81984,"_23429":134602,"_5":16198,"_30870":134430,"_3543":57393},[],{"_4098":82053,"_34307":81984,"_23429":134604,"_5":16198,"_30870":134430,"_3543":134605},[],"Puerto del listener HTTP",{"_4098":82054,"_34307":81984,"_23429":134607,"_5":16198,"_30870":134430,"_3543":57399},[],{"_4098":82055,"_34307":81984,"_23429":134609,"_5":16198,"_30870":134430,"_3543":57332},[],{"_4098":82056,"_34307":81984,"_23429":134611,"_5":16198,"_30870":134430,"_3543":134612},[],"Certificado PEM para TLS downstream",{"_4098":82057,"_34307":81984,"_23429":134614,"_5":16198,"_30870":134430,"_3543":57407},[],{"_4098":82058,"_34307":81984,"_23429":134616,"_5":16198,"_30870":134430,"_3543":57332},[],{"_4098":82059,"_34307":81984,"_23429":134618,"_5":16198,"_30870":134430,"_3543":134619},[],"Clave privada PEM para TLS downstream",{"_4098":82060,"_34307":81984,"_23429":134621,"_5":16198,"_30870":134430,"_3543":57415},[],{"_4098":82061,"_34307":81984,"_23429":134623,"_5":16198,"_30870":134430,"_3543":134624},[],"chart del repositorio",{"_4098":82062,"_34307":81984,"_23429":134626,"_5":16198,"_30870":134430,"_3543":134627},[],"Usa un chart local de Lamassu sin empaquetar",{"_4098":82063,"_34307":81984,"_23429":134629,"_5":16198,"_30870":134430,"_3543":57424},[],{"_4098":82064,"_34307":81984,"_23429":134631,"_5":16198,"_30870":134430,"_3543":134632},[],"detección automática",{"_4098":82065,"_34307":81984,"_23429":134634,"_5":16198,"_30870":134430,"_3543":134635},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_4098":82066,"_34307":81984,"_23429":134637,"_5":16198,"_30870":134430,"_3543":57432},[],{"_4098":82067,"_34307":81984,"_23429":134639,"_5":16198,"_30870":134430,"_3543":7434},[],{"_4098":82068,"_34307":81984,"_23429":134641,"_5":16198,"_30870":134430,"_3543":134642},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_4098":82069,"_34307":81984,"_23429":134644,"_5":16198,"_30870":134430,"_3543":57440},[],{"_4098":82070,"_34307":81984,"_23429":134646,"_5":16198,"_30870":134430,"_3543":7434},[],{"_4098":82071,"_34307":81984,"_23429":134648,"_5":16198,"_30870":134430,"_3543":134649},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_4098":82072,"_34307":81984,"_23429":134651,"_5":16198,"_30870":134430,"_3543":57448},[],{"_4098":82073,"_34307":81984,"_23429":134653,"_5":16198,"_30870":134430,"_3543":7434},[],{"_4098":82074,"_34307":81984,"_23429":134655,"_5":16198,"_30870":134430,"_3543":134656},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_4098":82075,"_34307":81984,"_23429":134658,"_5":16198,"_30870":134430,"_3543":57456},[],{"_4098":82076,"_34307":81984,"_23429":134660,"_5":16198,"_30870":134430,"_3543":7434},[],{"_4098":82077,"_34307":81984,"_23429":134662,"_5":16198,"_30870":134430,"_3543":134663},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_4098":82078,"_34307":81984,"_23429":134665,"_5":16198,"_30870":134430,"_3543":57464},[],{"_4098":82079,"_34307":81984,"_23429":134667,"_5":16198,"_30870":134430,"_3543":57467},[],{"_4098":82080,"_34307":81984,"_23429":134669,"_5":16198,"_30870":134430,"_3543":134670},[],"Usa otro chart local de SoftHSM",{"_4098":82081,"_34307":81984,"_23429":134672,"_5":16198,"_30870":134430,"_3543":134673},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_4098":82082,"_34307":81984,"_23429":134675,"_5":16198,"_30870":134434,"_3543":134676},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_4098":82083,"_34307":81984,"_23429":134678,"_5":16198,"_30870":134434,"_3543":134679},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_4098":82084,"_34307":81984,"_23429":134681,"_5":16198,"_30870":134434,"_3543":134682},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_4098":82085,"_34307":81984,"_23429":134684,"_5":16198,"_30870":134434,"_3543":134685},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_4098":82086,"_34307":81984,"_23429":134687,"_5":16198,"_30870":134434,"_3543":134688},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_4098":82087,"_34307":81984,"_23429":134690,"_5":16198,"_30870":134434,"_3543":134691},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_4098":82088,"_34307":81984,"_23429":134693,"_5":16198,"_30870":134438,"_3543":57494},[],{"_4098":82089,"_34307":81984,"_23429":134695,"_5":16198,"_30870":134438,"_3543":134696},[],"valida las herramientas locales y el clúster seleccionado",{"_4098":82090,"_34307":81984,"_23429":134698,"_5":16198,"_30870":134438,"_3543":134699},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_4098":82091,"_34307":81984,"_23429":134701,"_5":16198,"_30870":134438,"_3543":134702},[],"crea el namespace",{"_4098":82092,"_34307":81984,"_23429":134704,"_5":16198,"_30870":134438,"_3543":134705},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_4098":82093,"_34307":81984,"_23429":134707,"_5":16198,"_30870":134438,"_3543":134708},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_4098":82094,"_34307":81984,"_23429":134710,"_5":16198,"_30870":134438,"_3543":134711},[],"instala RabbitMQ",{"_4098":82095,"_34307":81984,"_23429":134713,"_5":16198,"_30870":134438,"_3543":134714},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_4098":82096,"_34307":81984,"_23429":134716,"_5":16198,"_30870":134438,"_3543":134717},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_4098":82097,"_34307":81984,"_23429":134719,"_5":16198,"_30870":134438,"_3543":134720},[],"carga datos de ejemplo opcionalmente",{"_4098":82098,"_34307":81984,"_23429":134722,"_5":16198,"_30870":134438,"_3543":134723},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_4098":82099,"_34307":81984,"_23429":134725,"_5":16198,"_30870":134442,"_3543":134726},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_4098":82100,"_34307":81984,"_23429":134728,"_5":16198,"_30870":134442,"_3543":134729},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_4098":82101,"_34307":81984,"_23429":134731,"_5":16198,"_30870":134446,"_3543":134732},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_4098":82102,"_34307":81984,"_23429":134734,"_5":16198,"_30870":134446,"_3543":134735},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_4098":82103,"_34307":81984,"_23429":134737,"_5":16198,"_30870":134446,"_3543":134738},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_4098":82104,"_34307":81984,"_23429":134740,"_5":16198,"_30870":134450,"_3543":134741},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_4098":82105,"_34307":82105,"_5":16596,"_3543":134743,"_34738":134744,"_23429":134745,"_30870":82105},"Instala con Helm",[56936,134169,134403],[],{"_4098":82106,"_34307":82105,"_23429":134747,"_5":16198,"_30870":82105,"_3543":134748},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_4098":82107,"_34307":82105,"_5":34735,"_23429":134750,"_30870":134751,"_3543":134752},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_4098":82108,"_34307":82105,"_5":34735,"_23429":134754,"_30870":134755,"_3543":134419},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#antes-de-comenzar",{"_4098":82109,"_34307":82105,"_5":34735,"_23429":134757,"_30870":134758,"_3543":134759},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_4098":82110,"_34307":82105,"_5":34735,"_23429":134761,"_30870":134762,"_3543":134763},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_4098":82111,"_34307":82105,"_5":34735,"_23429":134765,"_30870":134766,"_3543":134767},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_4098":82112,"_34307":82105,"_5":34735,"_23429":134769,"_30870":134770,"_3543":134771},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_4098":82113,"_34307":82105,"_5":34735,"_23429":134773,"_30870":134774,"_3543":134775},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_4098":82114,"_34307":82105,"_5":34735,"_23429":134777,"_30870":134778,"_3543":134779},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_4098":82115,"_34307":82105,"_5":34735,"_23429":134781,"_30870":134782,"_3543":134783},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_4098":82116,"_34307":82105,"_5":34735,"_23429":134785,"_30870":134786,"_3543":134787},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_4098":82117,"_34307":82105,"_5":34735,"_23429":134789,"_30870":134790,"_3543":134791},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_4098":82118,"_34307":82105,"_23429":134793,"_5":16198,"_30870":134751,"_3543":134794},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_4098":82119,"_34307":82105,"_23429":134796,"_5":16198,"_30870":134755,"_3543":134797},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_4098":82120,"_34307":82105,"_23429":134799,"_5":16198,"_30870":134755,"_3543":134800},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_4098":82121,"_34307":82105,"_23429":134802,"_5":16198,"_30870":134755,"_3543":134803},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_4098":82122,"_34307":82105,"_23429":134805,"_5":16198,"_30870":134755,"_3543":134806},[],"un broker RabbitMQ accesible y sus credenciales",{"_4098":82123,"_34307":82105,"_23429":134808,"_5":16198,"_30870":134755,"_3543":134809},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_4098":82124,"_34307":82105,"_23429":134811,"_5":16198,"_30870":134755,"_3543":134812},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_4098":82125,"_34307":82105,"_23429":134814,"_5":16198,"_30870":134755,"_3543":134815},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_4098":82126,"_34307":82105,"_23429":134817,"_5":16198,"_30870":134755,"_3543":134818},[],"una StorageClass y un diseño de tráfico externo",{"_4098":82127,"_34307":82105,"_23429":134820,"_5":16198,"_30870":134755,"_3543":134821},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_4098":82128,"_34307":82105,"_23429":134823,"_5":16198,"_30870":134755,"_3543":134824},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_4098":82129,"_34307":82105,"_23429":134826,"_5":16198,"_30870":134755,"_3543":134827},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_4098":82130,"_34307":82105,"_23429":134829,"_5":16198,"_30870":134758,"_3543":134830},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_4098":82131,"_34307":82105,"_23429":134832,"_5":16198,"_30870":134758,"_3543":134833},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_4098":82132,"_34307":82105,"_23429":134835,"_5":16198,"_30870":134758,"_3543":134836},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_4098":82133,"_34307":82105,"_23429":134838,"_5":16198,"_30870":134762,"_3543":134839},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_4098":82134,"_34307":82105,"_23429":134841,"_5":16198,"_30870":134762,"_3543":134842},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_4098":82135,"_34307":82105,"_23429":134844,"_5":16198,"_30870":134762,"_3543":134845},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_4098":82136,"_34307":82105,"_23429":134847,"_5":16198,"_30870":134762,"_3543":134848},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_4098":82137,"_34307":82105,"_23429":134850,"_5":16198,"_30870":134766,"_3543":134851},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_4098":82138,"_34307":82105,"_23429":134853,"_5":16198,"_30870":134770,"_3543":134854},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_4098":82139,"_34307":82105,"_23429":134856,"_5":16198,"_30870":134770,"_3543":134857},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_4098":82140,"_34307":82105,"_23429":134859,"_5":16198,"_30870":134770,"_3543":134860},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_4098":82141,"_34307":82105,"_23429":134862,"_5":16198,"_30870":134770,"_3543":134863},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_4098":82142,"_34307":82105,"_23429":134865,"_5":16198,"_30870":134770,"_3543":134866},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_4098":82143,"_34307":82105,"_23429":134868,"_5":16198,"_30870":134770,"_3543":134869},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_4098":82144,"_34307":82105,"_23429":134871,"_5":16198,"_30870":134770,"_3543":134872},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_4098":82145,"_34307":82105,"_23429":134874,"_5":16198,"_30870":134774,"_3543":134875},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_4098":82146,"_34307":82105,"_23429":134877,"_5":16198,"_30870":134774,"_3543":134878},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_4098":82147,"_34307":82105,"_23429":134880,"_5":16198,"_30870":134774,"_3543":134881},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_4098":82148,"_34307":82105,"_23429":134883,"_5":16198,"_30870":134774,"_3543":134884},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_4098":82149,"_34307":82105,"_23429":134886,"_5":16198,"_30870":134778,"_3543":134887},[],"Para instalar un checkout local:",{"_4098":82150,"_34307":82105,"_23429":134889,"_5":16198,"_30870":134782,"_3543":134890},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_4098":82151,"_34307":82105,"_23429":134892,"_5":16198,"_30870":134782,"_3543":134893},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_4098":82152,"_34307":82105,"_23429":134895,"_5":16198,"_30870":134786,"_3543":134896},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_4098":82153,"_34307":82105,"_23429":134898,"_5":16198,"_30870":134786,"_3543":134899},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_4098":82154,"_34307":82105,"_23429":134901,"_5":16198,"_30870":134786,"_3543":134902},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_4098":82155,"_34307":82105,"_23429":134904,"_5":16198,"_30870":134786,"_3543":134905},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_4098":82156,"_34307":82105,"_23429":134907,"_5":16198,"_30870":134786,"_3543":134908},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_4098":82157,"_34307":82105,"_23429":134910,"_5":16198,"_30870":134790,"_3543":134911},[],"Antes de pasar a producción, revisa:",{"_4098":82158,"_34307":82105,"_23429":134913,"_5":16198,"_30870":134790,"_3543":134914},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_4098":82159,"_34307":82105,"_23429":134916,"_5":16198,"_30870":134790,"_3543":134917},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_4098":82160,"_34307":82105,"_23429":134919,"_5":16198,"_30870":134790,"_3543":134920},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_4098":82161,"_34307":82105,"_23429":134922,"_5":16198,"_30870":134790,"_3543":134923},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_4098":82162,"_34307":82105,"_23429":134925,"_5":16198,"_30870":134790,"_3543":134926},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_4098":82163,"_34307":82105,"_23429":134928,"_5":16198,"_30870":134790,"_3543":134929},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_4098":82164,"_34307":82105,"_23429":134931,"_5":16198,"_30870":134790,"_3543":134932},[],"SMTP, observabilidad y entrega de alertas",{"_4098":82165,"_34307":82105,"_23429":134934,"_5":16198,"_30870":134790,"_3543":134935},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_4098":82166,"_34307":82105,"_23429":134937,"_5":16198,"_30870":134790,"_3543":134938},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_4098":82167,"_34307":82167,"_5":16596,"_3543":134940,"_34738":134941,"_23429":134942,"_30870":82167},"Expón el Gateway",[56936,134169,134403],[],{"_4098":82168,"_34307":82167,"_23429":134944,"_5":16198,"_30870":82167,"_3543":134945},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_4098":82169,"_34307":82167,"_5":34735,"_23429":134947,"_30870":134948,"_3543":134949},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_4098":82170,"_34307":82167,"_5":34735,"_23429":134951,"_30870":134952,"_3543":134953},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_4098":82171,"_34307":82167,"_5":34735,"_23429":134955,"_30870":134956,"_3543":134957},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_4098":82172,"_34307":82167,"_5":34735,"_23429":134959,"_30870":134960,"_3543":57762},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#k3s",{"_4098":82173,"_34307":82167,"_5":34735,"_23429":134962,"_30870":134963,"_3543":134964},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_4098":82174,"_34307":82167,"_5":34735,"_23429":134966,"_30870":134967,"_3543":134968},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_4098":82175,"_34307":82167,"_5":34735,"_23429":134970,"_30870":134971,"_3543":134972},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_4098":82176,"_34307":82167,"_5":34735,"_23429":134974,"_30870":134975,"_3543":134976},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_4098":82177,"_34307":82167,"_5":34735,"_23429":134978,"_30870":134979,"_3543":134980},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_4098":82178,"_34307":82167,"_5":34735,"_23429":134982,"_30870":134983,"_3543":134984},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_4098":82179,"_34307":82167,"_23429":134986,"_5":16198,"_30870":134948,"_3543":134987},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_4098":82180,"_34307":82167,"_23429":134989,"_5":16198,"_30870":134948,"_3543":134990},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_4098":82181,"_34307":82167,"_23429":134992,"_5":16198,"_30870":134952,"_3543":134993},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_4098":82182,"_34307":82167,"_23429":134995,"_5":16198,"_30870":134952,"_3543":134996},[],"Defínelo únicamente cuando:",{"_4098":82183,"_34307":82167,"_23429":134998,"_5":16198,"_30870":134952,"_3543":134999},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_4098":82184,"_34307":82167,"_23429":135001,"_5":16198,"_30870":134952,"_3543":135002},[],"esa dirección está asignada a este Gateway",{"_4098":82185,"_34307":82167,"_23429":135004,"_5":16198,"_30870":134952,"_3543":135005},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_4098":82186,"_34307":82167,"_23429":135007,"_5":16198,"_30870":134952,"_3543":135008},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_4098":82187,"_34307":82167,"_23429":135010,"_5":16198,"_30870":134952,"_3543":135011},[],"No confundas estos valores:",{"_4098":82188,"_34307":82167,"_23429":135013,"_5":16198,"_30870":134952,"_3543":135014},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_4098":82189,"_34307":82167,"_23429":135016,"_5":16198,"_30870":134952,"_3543":135017},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_4098":82190,"_34307":82167,"_23429":135019,"_5":16198,"_30870":134952,"_3543":135020},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_4098":82191,"_34307":82167,"_23429":135022,"_5":16198,"_30870":134956,"_3543":135023},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_4098":82192,"_34307":82167,"_23429":135025,"_5":16198,"_30870":134956,"_3543":135026},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_4098":82193,"_34307":82167,"_23429":135028,"_5":16198,"_30870":134960,"_3543":135029},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_4098":82194,"_34307":82167,"_23429":135031,"_5":16198,"_30870":134960,"_3543":135032},[],"Para el diseño recomendado:",{"_4098":82195,"_34307":82167,"_23429":135034,"_5":16198,"_30870":134960,"_3543":135035},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_4098":82196,"_34307":82167,"_23429":135037,"_5":16198,"_30870":134960,"_3543":135038},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_4098":82197,"_34307":82167,"_23429":135040,"_5":16198,"_30870":134960,"_3543":135041},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_4098":82198,"_34307":82167,"_23429":135043,"_5":16198,"_30870":134960,"_3543":135044},[],"Apunta DNS a la dirección accesible de la VM.",{"_4098":82199,"_34307":82167,"_23429":135046,"_5":16198,"_30870":134960,"_3543":135047},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_4098":82200,"_34307":82167,"_23429":135049,"_5":16198,"_30870":134963,"_3543":135050},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_4098":82201,"_34307":82167,"_23429":135052,"_5":16198,"_30870":134967,"_3543":135053},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_4098":82202,"_34307":82167,"_23429":135055,"_5":16198,"_30870":134967,"_3543":135056},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_4098":82203,"_34307":82167,"_23429":135058,"_5":16198,"_30870":134971,"_3543":135059},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_4098":82204,"_34307":82167,"_23429":135061,"_5":16198,"_30870":134971,"_3543":135062},[],"Requisito",{"_4098":82205,"_34307":82167,"_23429":135064,"_5":16198,"_30870":134971,"_3543":135065},[],"Diseño recomendado",{"_4098":82206,"_34307":82167,"_23429":135067,"_5":16198,"_30870":134971,"_3543":135068},[],"Consecuencia",{"_4098":82207,"_34307":82167,"_23429":135070,"_5":16198,"_30870":134971,"_3543":135071},[],"Varias URL o servicios de Lamassu",{"_4098":82208,"_34307":82167,"_23429":135073,"_5":16198,"_30870":134971,"_3543":135074},[],"Un Gateway con varias rutas",{"_4098":82209,"_34307":82167,"_23429":135076,"_5":16198,"_30870":134971,"_3543":135077},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_4098":82210,"_34307":82167,"_23429":135079,"_5":16198,"_30870":134971,"_3543":135080},[],"Gateways independientes e IP externas distintas",{"_4098":82211,"_34307":82167,"_23429":135082,"_5":16198,"_30870":134971,"_3543":135083},[],"Una VIP por Gateway",{"_4098":82212,"_34307":82167,"_23429":135085,"_5":16198,"_30870":134971,"_3543":135086},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_4098":82213,"_34307":82167,"_23429":135088,"_5":16198,"_30870":134971,"_3543":135089},[],"Gateways independientes, un nodo y una IP",{"_4098":82214,"_34307":82167,"_23429":135091,"_5":16198,"_30870":134971,"_3543":135092},[],"Puertos externos diferentes",{"_4098":82215,"_34307":82167,"_23429":135094,"_5":16198,"_30870":134971,"_3543":135095},[],"Los clientes deben indicar puertos no estándar",{"_4098":82216,"_34307":82167,"_23429":135097,"_5":16198,"_30870":134971,"_3543":135098},[],"Terminación TLS/mTLS separada detrás de una IP",{"_4098":82217,"_34307":82167,"_23429":135100,"_5":16198,"_30870":134971,"_3543":135101},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_4098":82218,"_34307":82167,"_23429":135103,"_5":16198,"_30870":134971,"_3543":135104},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_4098":82219,"_34307":82167,"_23429":135106,"_5":16198,"_30870":134971,"_3543":135107},[],"Recursos Gateway separados pero proxy compartido",{"_4098":82220,"_34307":82167,"_23429":135109,"_5":16198,"_30870":134971,"_3543":135110},[],"Modo merged Gateway de Envoy",{"_4098":82221,"_34307":82167,"_23429":135112,"_5":16198,"_30870":134971,"_3543":135113},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_4098":82222,"_34307":82167,"_23429":135115,"_5":16198,"_30870":134971,"_3543":135116},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_4098":82223,"_34307":82167,"_23429":135118,"_5":16198,"_30870":134971,"_3543":135119},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_4098":82224,"_34307":82167,"_23429":135121,"_5":16198,"_30870":134971,"_3543":135122},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_4098":82225,"_34307":82167,"_23429":135124,"_5":16198,"_30870":134971,"_3543":135125},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_4098":82226,"_34307":82167,"_23429":135127,"_5":16198,"_30870":134975,"_3543":135128},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_4098":82227,"_34307":82167,"_23429":135130,"_5":16198,"_30870":134975,"_3543":135131},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_4098":82228,"_34307":82167,"_23429":135133,"_5":16198,"_30870":134975,"_3543":135134},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_4098":82229,"_34307":82167,"_23429":135136,"_5":16198,"_30870":134975,"_3543":135137},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_4098":82230,"_34307":82167,"_23429":135139,"_5":16198,"_30870":134975,"_3543":135140},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_4098":82231,"_34307":82167,"_23429":135142,"_5":16198,"_30870":134979,"_3543":135143},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_4098":82232,"_34307":82167,"_23429":135145,"_5":16198,"_30870":134979,"_3543":135146},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_4098":82233,"_34307":82167,"_23429":135148,"_5":16198,"_30870":134983,"_3543":135149},[],"Comprueba, en orden:",{"_4098":82234,"_34307":82167,"_23429":135151,"_5":16198,"_30870":134983,"_3543":135152},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_4098":82235,"_34307":82167,"_23429":135154,"_5":16198,"_30870":134983,"_3543":135155},[],"Su estado contiene la dirección esperada.",{"_4098":82236,"_34307":82167,"_23429":135157,"_5":16198,"_30870":134983,"_3543":135158},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_4098":82237,"_34307":82167,"_23429":135160,"_5":16198,"_30870":134983,"_3543":135161},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_4098":82238,"_34307":82167,"_23429":135163,"_5":16198,"_30870":134983,"_3543":135164},[],"DNS resuelve al endpoint accesible externamente.",{"_4098":82239,"_34307":82167,"_23429":135166,"_5":16198,"_30870":134983,"_3543":135167},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_4098":82240,"_34307":82167,"_23429":135169,"_5":16198,"_30870":134983,"_3543":135170},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_4098":82241,"_34307":82241,"_5":16596,"_3543":57043,"_34738":135172,"_23429":135173,"_30870":82241},[56936,134169,134403],[],{"_4098":82242,"_34307":82241,"_23429":135175,"_5":16198,"_30870":82241,"_3543":135176},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_4098":82243,"_34307":82241,"_5":34735,"_23429":135178,"_30870":135179,"_3543":135180},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_4098":82244,"_34307":82241,"_5":34735,"_23429":135182,"_30870":135183,"_3543":135184},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_4098":82245,"_34307":82241,"_5":34735,"_23429":135186,"_30870":135187,"_3543":135188},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_4098":82246,"_34307":82241,"_5":34735,"_23429":135190,"_30870":135191,"_3543":135192},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_4098":82247,"_34307":82241,"_5":34735,"_23429":135194,"_30870":135195,"_3543":135196},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_4098":82248,"_34307":82241,"_5":34735,"_23429":135198,"_30870":135199,"_3543":135200},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_4098":82249,"_34307":82241,"_23429":135202,"_5":16198,"_30870":135179,"_3543":135203},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_4098":82250,"_34307":82241,"_23429":135205,"_5":16198,"_30870":135183,"_3543":135206},[],"Flujo",{"_4098":82251,"_34307":82241,"_23429":135208,"_5":16198,"_30870":135183,"_3543":135209},[],"Úsalo para",{"_4098":82252,"_34307":82241,"_23429":135211,"_5":16198,"_30870":135183,"_3543":135212},[],"Qué instala",{"_4098":82253,"_34307":82241,"_23429":135214,"_5":16198,"_30870":135183,"_3543":58017},[],{"_4098":82254,"_34307":82241,"_23429":135216,"_5":16198,"_30870":135183,"_3543":135217},[],"Producción y entornos controlados",{"_4098":82255,"_34307":82241,"_23429":135219,"_5":16198,"_30870":135183,"_3543":135220},[],"Servicios de Lamassu y recursos de Gateway API",{"_4098":82256,"_34307":82241,"_23429":135222,"_5":16198,"_30870":135183,"_3543":57180},[],{"_4098":82257,"_34307":82241,"_23429":135224,"_5":16198,"_30870":135183,"_3543":135225},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_4098":82258,"_34307":82241,"_23429":135227,"_5":16198,"_30870":135183,"_3543":135228},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_4098":82259,"_34307":82241,"_23429":135230,"_5":16198,"_30870":135187,"_3543":135231},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_4098":82260,"_34307":82241,"_23429":135233,"_5":16198,"_30870":135187,"_3543":135234},[],"Área",{"_4098":82261,"_34307":82241,"_23429":135236,"_5":16198,"_30870":135187,"_3543":135237},[],"El chart de Lamassu proporciona",{"_4098":82262,"_34307":82241,"_23429":135239,"_5":16198,"_30870":135187,"_3543":135240},[],"Tú proporcionas",{"_4098":82263,"_34307":82241,"_23429":135242,"_5":16198,"_30870":135187,"_3543":135243},[],"Aplicaciones Lamassu",{"_4098":82264,"_34307":82241,"_23429":135245,"_5":16198,"_30870":135187,"_3543":135246},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_4098":82265,"_34307":82241,"_23429":135248,"_5":16198,"_30870":135187,"_3543":135249},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_4098":82266,"_34307":82241,"_23429":135251,"_5":16198,"_30870":135187,"_3543":135252},[],"Datos PostgreSQL",{"_4098":82267,"_34307":82241,"_23429":135254,"_5":16198,"_30870":135187,"_3543":135255},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_4098":82268,"_34307":82241,"_23429":135257,"_5":16198,"_30870":135187,"_3543":135258},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_4098":82269,"_34307":82241,"_23429":135260,"_5":16198,"_30870":135187,"_3543":135261},[],"Mensajería",{"_4098":82270,"_34307":82241,"_23429":135263,"_5":16198,"_30870":135187,"_3543":135264},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_4098":82271,"_34307":82241,"_23429":135266,"_5":16198,"_30870":135187,"_3543":135267},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_4098":82272,"_34307":82241,"_23429":135269,"_5":16198,"_30870":135187,"_3543":135270},[],"Identidad",{"_4098":82273,"_34307":82241,"_23429":135272,"_5":16198,"_30870":135187,"_3543":135273},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_4098":82274,"_34307":82241,"_23429":135275,"_5":16198,"_30870":135187,"_3543":135276},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_4098":82275,"_34307":82241,"_23429":135278,"_5":16198,"_30870":135187,"_3543":135279},[],"Enrutamiento externo",{"_4098":82276,"_34307":82241,"_23429":135281,"_5":16198,"_30870":135187,"_3543":135282},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_4098":82277,"_34307":82241,"_23429":135284,"_5":16198,"_30870":135187,"_3543":135285},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_4098":82278,"_34307":82241,"_23429":135287,"_5":16198,"_30870":135187,"_3543":58091},[],{"_4098":82279,"_34307":82241,"_23429":135289,"_5":16198,"_30870":135187,"_3543":135290},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_4098":82280,"_34307":82241,"_23429":135292,"_5":16198,"_30870":135187,"_3543":135293},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_4098":82281,"_34307":82241,"_23429":135295,"_5":16198,"_30870":135187,"_3543":135296},[],"Datos persistentes de la aplicación",{"_4098":82282,"_34307":82241,"_23429":135298,"_5":16198,"_30870":135187,"_3543":135299},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_4098":82283,"_34307":82241,"_23429":135301,"_5":16198,"_30870":135187,"_3543":135302},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_4098":82284,"_34307":82241,"_23429":135304,"_5":16198,"_30870":135187,"_3543":135305},[],"Integraciones opcionales",{"_4098":82285,"_34307":82241,"_23429":135307,"_5":16198,"_30870":135187,"_3543":135308},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_4098":82286,"_34307":82241,"_23429":135310,"_5":16198,"_30870":135187,"_3543":135311},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_4098":82287,"_34307":82241,"_23429":135313,"_5":16198,"_30870":135187,"_3543":135314},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_4098":82288,"_34307":82241,"_23429":135316,"_5":16198,"_30870":135187,"_3543":135317},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_4098":82289,"_34307":82241,"_23429":135319,"_5":16198,"_30870":135191,"_3543":135320},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_4098":82290,"_34307":82241,"_23429":135322,"_5":16198,"_30870":135191,"_3543":135323},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_4098":82291,"_34307":82241,"_23429":135325,"_5":16198,"_30870":135195,"_3543":135326},[],"Kubernetes 1.24 o posterior",{"_4098":82292,"_34307":82241,"_23429":135328,"_5":16198,"_30870":135195,"_3543":135329},[],"Helm 3.2 o posterior",{"_4098":82293,"_34307":82241,"_23429":135331,"_5":16198,"_30870":135195,"_3543":135332},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_4098":82294,"_34307":82241,"_23429":135334,"_5":16198,"_30870":135195,"_3543":135335},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_4098":82295,"_34307":82241,"_23429":135337,"_5":16198,"_30870":135195,"_3543":135338},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_4098":82296,"_34307":82241,"_23429":135340,"_5":16198,"_30870":135195,"_3543":135341},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_4098":82297,"_34307":82241,"_23429":135343,"_5":16198,"_30870":135195,"_3543":135344},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_4098":82298,"_34307":82241,"_23429":135346,"_5":16198,"_30870":135199,"_3543":135347},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_4098":82299,"_34307":82241,"_23429":135349,"_5":16198,"_30870":135199,"_3543":135350},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_4098":82300,"_34307":82241,"_23429":135352,"_5":16198,"_30870":135199,"_3543":135353},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_4098":82301,"_34307":82241,"_23429":135355,"_5":16198,"_30870":135199,"_3543":135356},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_4098":82302,"_34307":82302,"_5":16596,"_3543":135358,"_34738":135359,"_23429":135361,"_30870":82302},"Resolución de problemas de despliegue",[56936,134169,135360],"Operación",[],{"_4098":82303,"_34307":82302,"_23429":135363,"_5":16198,"_30870":82302,"_3543":135364},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_4098":82304,"_34307":82302,"_5":34735,"_23429":135366,"_30870":135367,"_3543":135368},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_4098":82305,"_34307":82302,"_5":34735,"_23429":135370,"_30870":135371,"_3543":135372},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_4098":82306,"_34307":82302,"_5":34735,"_23429":135374,"_30870":135375,"_3543":135376},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_4098":82307,"_34307":82302,"_5":34735,"_23429":135378,"_30870":135379,"_3543":135380},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_4098":82308,"_34307":82302,"_5":34735,"_23429":135382,"_30870":135383,"_3543":135384},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_4098":82309,"_34307":82302,"_5":34735,"_23429":135386,"_30870":135387,"_3543":135388},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_4098":82310,"_34307":82302,"_5":34735,"_23429":135390,"_30870":135391,"_3543":135392},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_4098":82311,"_34307":82302,"_5":34735,"_23429":135394,"_30870":135395,"_3543":135396},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_4098":82312,"_34307":82302,"_5":34735,"_23429":135398,"_30870":135399,"_3543":135400},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_4098":82313,"_34307":82302,"_5":34735,"_23429":135402,"_30870":135403,"_3543":135404},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_4098":82314,"_34307":82302,"_5":34735,"_23429":135406,"_30870":135407,"_3543":135408},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_4098":82315,"_34307":82302,"_5":34735,"_23429":135410,"_30870":135411,"_3543":135412},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_4098":82316,"_34307":82302,"_5":34735,"_23429":135414,"_30870":135415,"_3543":135416},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_4098":82317,"_34307":82302,"_23429":135418,"_5":16198,"_30870":82302,"_3543":135419},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_4098":82318,"_34307":82302,"_23429":135421,"_5":16198,"_30870":135371,"_3543":135422},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_4098":82319,"_34307":82302,"_23429":135424,"_5":16198,"_30870":135375,"_3543":135425},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_4098":82320,"_34307":82302,"_23429":135427,"_5":16198,"_30870":135379,"_3543":135428},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_4098":82321,"_34307":82302,"_23429":135430,"_5":16198,"_30870":135383,"_3543":135431},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_4098":82322,"_34307":82302,"_23429":135433,"_5":16198,"_30870":135387,"_3543":135434},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_4098":82323,"_34307":82302,"_23429":135436,"_5":16198,"_30870":135391,"_3543":135437},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_4098":82324,"_34307":82302,"_23429":135439,"_5":16198,"_30870":135391,"_3543":135440},[],"Ejecuta también la prueba de conectividad del chart:",{"_4098":82325,"_34307":82302,"_23429":135442,"_5":16198,"_30870":135391,"_3543":135443},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_4098":82326,"_34307":82302,"_23429":135445,"_5":16198,"_30870":135391,"_3543":135446},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_4098":82327,"_34307":82302,"_23429":135448,"_5":16198,"_30870":135395,"_3543":135449},[],"Si recibes un 401:",{"_4098":82328,"_34307":82302,"_23429":135451,"_5":16198,"_30870":135395,"_3543":135452},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_4098":82329,"_34307":82302,"_23429":135454,"_5":16198,"_30870":135395,"_3543":135455},[],"verifica emisor, audiencia y expiración del token;",{"_4098":82330,"_34307":82302,"_23429":135457,"_5":16198,"_30870":135395,"_3543":135458},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_4098":82331,"_34307":82302,"_23429":135460,"_5":16198,"_30870":135395,"_3543":135461},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_4098":82332,"_34307":82302,"_23429":135463,"_5":16198,"_30870":135395,"_3543":135464},[],"Si el login termina pero las APIs devuelven 403:",{"_4098":82333,"_34307":82302,"_23429":135466,"_5":16198,"_30870":135395,"_3543":135467},[],"inspecciona los claims reales del token;",{"_4098":82334,"_34307":82302,"_23429":135469,"_5":16198,"_30870":135395,"_3543":135470},[],"confirma que coinciden con un principal activo;",{"_4098":82335,"_34307":82302,"_23429":135472,"_5":16198,"_30870":135395,"_3543":135473},[],"revisa las políticas concedidas al principal;",{"_4098":82336,"_34307":82302,"_23429":135475,"_5":16198,"_30870":135395,"_3543":135476},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_4098":82337,"_34307":82302,"_23429":135478,"_5":16198,"_30870":135395,"_3543":135479},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_4098":82338,"_34307":82302,"_23429":135481,"_5":16198,"_30870":135399,"_3543":135482},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_4098":82339,"_34307":82302,"_23429":135484,"_5":16198,"_30870":135399,"_3543":135485},[],"Localiza el pod y Service de authz.",{"_4098":82340,"_34307":82302,"_23429":135487,"_5":16198,"_30870":135399,"_3543":135488},[],"Comprueba /health, logs y conexión a su base de datos.",{"_4098":82341,"_34307":82302,"_23429":135490,"_5":16198,"_30870":135399,"_3543":135491},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_4098":82342,"_34307":82302,"_23429":135493,"_5":16198,"_30870":135399,"_3543":135494},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_4098":82343,"_34307":82302,"_23429":135496,"_5":16198,"_30870":135399,"_3543":135497},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_4098":82344,"_34307":82302,"_23429":135499,"_5":16198,"_30870":135403,"_3543":135500},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_4098":82345,"_34307":82302,"_23429":135502,"_5":16198,"_30870":135407,"_3543":135503},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_4098":82346,"_34307":82302,"_23429":135505,"_5":16198,"_30870":135407,"_3543":135506},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_4098":82347,"_34307":82302,"_23429":135508,"_5":16198,"_30870":135407,"_3543":135509},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_4098":82348,"_34307":82302,"_23429":135511,"_5":16198,"_30870":135407,"_3543":135512},[],"volumen persistente sin enlazar;",{"_4098":82349,"_34307":82302,"_23429":135514,"_5":16198,"_30870":135407,"_3543":135515},[],"imagen inaccesible o política de pull incorrecta;",{"_4098":82350,"_34307":82302,"_23429":135517,"_5":16198,"_30870":135407,"_3543":135518},[],"configuración inválida del motor criptográfico;",{"_4098":82351,"_34307":82302,"_23429":135520,"_5":16198,"_30870":135407,"_3543":135521},[],"límites de CPU o memoria demasiado bajos;",{"_4098":82352,"_34307":82302,"_23429":135523,"_5":16198,"_30870":135407,"_3543":135524},[],"migración previa incompleta.",{"_4098":82353,"_34307":82302,"_23429":135526,"_5":16198,"_30870":135407,"_3543":135527},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_4098":82354,"_34307":82302,"_23429":135529,"_5":16198,"_30870":135407,"_3543":135530},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_4098":82355,"_34307":82302,"_23429":135532,"_5":16198,"_30870":135407,"_3543":135533},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_4098":82356,"_34307":82302,"_23429":135535,"_5":16198,"_30870":135411,"_3543":135536},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_4098":82357,"_34307":82302,"_23429":135538,"_5":16198,"_30870":135411,"_3543":135539},[],"verifica que esté habilitado en el servicio emisor;",{"_4098":82358,"_34307":82302,"_23429":135541,"_5":16198,"_30870":135411,"_3543":135542},[],"comprueba conectividad y credenciales AMQP;",{"_4098":82359,"_34307":82302,"_23429":135544,"_5":16198,"_30870":135411,"_3543":135545},[],"revisa exchange, routing key, colas y consumidores;",{"_4098":82360,"_34307":82302,"_23429":135547,"_5":16198,"_30870":135411,"_3543":135548},[],"inspecciona dead-letter queues;",{"_4098":82361,"_34307":82302,"_23429":135550,"_5":16198,"_30870":135411,"_3543":135551},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_4098":82362,"_34307":82302,"_23429":135553,"_5":16198,"_30870":135411,"_3543":135554},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_4098":82363,"_34307":82302,"_23429":135556,"_5":16198,"_30870":135411,"_3543":135557},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_4098":82364,"_34307":82302,"_23429":135559,"_5":16198,"_30870":135411,"_3543":135560},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_4098":82365,"_34307":82302,"_23429":135562,"_5":16198,"_30870":135411,"_3543":135563},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_4098":82366,"_34307":82302,"_23429":135565,"_5":16198,"_30870":135411,"_3543":135566},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_4098":82367,"_34307":82302,"_23429":135568,"_5":16198,"_30870":135411,"_3543":135569},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_4098":82368,"_34307":82302,"_23429":135571,"_5":16198,"_30870":135411,"_3543":135572},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_4098":82369,"_34307":82302,"_23429":135574,"_5":16198,"_30870":135415,"_3543":135575},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_4098":82370,"_34307":82302,"_23429":135577,"_5":16198,"_30870":135415,"_3543":135578},[],"Antes de cerrar una incidencia, guarda:",{"_4098":82371,"_34307":82302,"_23429":135580,"_5":16198,"_30870":135415,"_3543":135581},[],"causa confirmada;",{"_4098":82372,"_34307":82302,"_23429":135583,"_5":16198,"_30870":135415,"_3543":135584},[],"alcance temporal y recursos afectados;",{"_4098":82373,"_34307":82302,"_23429":135586,"_5":16198,"_30870":135415,"_3543":135587},[],"comandos o consultas utilizados;",{"_4098":82374,"_34307":82302,"_23429":135589,"_5":16198,"_30870":135415,"_3543":135590},[],"cambio aplicado y forma de revertirlo;",{"_4098":82375,"_34307":82302,"_23429":135592,"_5":16198,"_30870":135415,"_3543":135593},[],"validación desde un consumidor;",{"_4098":82376,"_34307":82302,"_23429":135595,"_5":16198,"_30870":135415,"_3543":135596},[],"acción preventiva y propietario.",{"_4098":82377,"_34307":82377,"_5":16596,"_3543":135598,"_34738":135599,"_23429":135602,"_30870":82377},"Control de acceso",[56936,135600,135601],"Plataforma","Administración",[],{"_4098":82378,"_34307":82377,"_23429":135604,"_5":16198,"_30870":82377,"_3543":135605},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_4098":82379,"_34307":82377,"_5":34735,"_23429":135607,"_30870":135608,"_3543":135609},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_4098":82380,"_34307":82377,"_5":34735,"_23429":135611,"_30870":135612,"_3543":135613},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_4098":82381,"_34307":82377,"_5":34735,"_23429":135615,"_30870":135616,"_3543":135617},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_4098":82382,"_34307":82377,"_5":34735,"_23429":135619,"_30870":135620,"_3543":135621},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_4098":82383,"_34307":82377,"_5":34735,"_23429":135623,"_30870":135624,"_3543":135625},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_4098":82384,"_34307":82377,"_5":34735,"_23429":135627,"_30870":135628,"_3543":135629},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_4098":82385,"_34307":82377,"_5":34735,"_23429":135631,"_30870":135632,"_3543":135633},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_4098":82386,"_34307":82377,"_5":34735,"_23429":135635,"_30870":135636,"_3543":135637},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#principales-x509","Principales X.509",{"_4098":82387,"_34307":82377,"_5":34735,"_23429":135639,"_30870":135640,"_3543":135641},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_4098":82388,"_34307":82377,"_5":34735,"_23429":135643,"_30870":135644,"_3543":135645},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_4098":82389,"_34307":82377,"_5":34735,"_23429":135647,"_30870":135648,"_3543":135649},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_4098":82390,"_34307":82377,"_5":34735,"_23429":135651,"_30870":135652,"_3543":135653},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_4098":82391,"_34307":82377,"_5":34735,"_23429":135655,"_30870":135656,"_3543":135657},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_4098":82392,"_34307":82377,"_5":34735,"_23429":135659,"_30870":135660,"_3543":135661},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_4098":82393,"_34307":82377,"_5":34735,"_23429":135663,"_30870":135664,"_3543":135665},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_4098":82394,"_34307":82377,"_5":34735,"_23429":135667,"_30870":135668,"_3543":134775},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_4098":82395,"_34307":82377,"_5":34735,"_23429":135670,"_30870":135671,"_3543":135672},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_4098":82396,"_34307":82377,"_5":34735,"_23429":135674,"_30870":135675,"_3543":135676},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_4098":82397,"_34307":82377,"_5":34735,"_23429":135678,"_30870":135679,"_3543":135680},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_4098":82398,"_34307":82377,"_5":34735,"_23429":135682,"_30870":135683,"_3543":135684},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_4098":82399,"_34307":82377,"_5":34735,"_23429":135686,"_30870":135687,"_3543":135688},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_4098":82400,"_34307":82377,"_5":34735,"_23429":135690,"_30870":135691,"_3543":135692},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_4098":82401,"_34307":82377,"_5":34735,"_23429":135694,"_30870":135695,"_3543":135696},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_4098":82402,"_34307":82377,"_5":34735,"_23429":135698,"_30870":135699,"_3543":135700},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_4098":82403,"_34307":82377,"_5":34735,"_23429":135702,"_30870":135703,"_3543":135704},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_4098":82404,"_34307":82377,"_5":34735,"_23429":135706,"_30870":135707,"_3543":135708},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_4098":82405,"_34307":82377,"_5":34735,"_23429":135710,"_30870":135711,"_3543":135712},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_4098":82406,"_34307":82377,"_5":34735,"_23429":135714,"_30870":135715,"_3543":135716},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_4098":82407,"_34307":82377,"_5":34735,"_23429":135718,"_30870":135719,"_3543":135720},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_4098":82408,"_34307":82377,"_5":34735,"_23429":135722,"_30870":135723,"_3543":135724},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_4098":82409,"_34307":82377,"_5":34735,"_23429":135726,"_30870":135727,"_3543":135728},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_4098":82410,"_34307":82377,"_23429":135730,"_5":16198,"_30870":82377,"_3543":135731},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_4098":82411,"_34307":82377,"_23429":135733,"_5":16198,"_30870":82377,"_3543":135734},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_4098":82412,"_34307":82377,"_23429":135736,"_5":16198,"_30870":82377,"_3543":135737},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_4098":82413,"_34307":82377,"_23429":135739,"_5":16198,"_30870":135608,"_3543":135740},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_4098":82414,"_34307":82377,"_23429":135742,"_5":16198,"_30870":135608,"_3543":135743},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_4098":82415,"_34307":82377,"_23429":135745,"_5":16198,"_30870":135608,"_3543":135746},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_4098":82416,"_34307":82377,"_23429":135748,"_5":16198,"_30870":135608,"_3543":135749},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_4098":82417,"_34307":82377,"_23429":135751,"_5":16198,"_30870":135608,"_3543":135752},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_4098":82418,"_34307":82377,"_23429":135754,"_5":16198,"_30870":135608,"_3543":135755},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_4098":82419,"_34307":82377,"_23429":135757,"_5":16198,"_30870":135612,"_3543":135758},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_4098":82420,"_34307":82377,"_23429":135760,"_5":16198,"_30870":135612,"_3543":135761},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_4098":82421,"_34307":82377,"_23429":135763,"_5":16198,"_30870":135616,"_3543":135764},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_4098":82422,"_34307":82377,"_23429":135766,"_5":16198,"_30870":135616,"_3543":135767},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_4098":82423,"_34307":82377,"_23429":135769,"_5":16198,"_30870":135616,"_3543":135770},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_4098":82424,"_34307":82377,"_23429":135772,"_5":16198,"_30870":135616,"_3543":135773},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_4098":82425,"_34307":82377,"_23429":135775,"_5":16198,"_30870":135616,"_3543":135776},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_4098":82426,"_34307":82377,"_23429":135778,"_5":16198,"_30870":135616,"_3543":135779},[],"Carga por separado las políticas concedidas a cada principal.",{"_4098":82427,"_34307":82377,"_23429":135781,"_5":16198,"_30870":135616,"_3543":135782},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_4098":82428,"_34307":82377,"_23429":135784,"_5":16198,"_30870":135616,"_3543":135785},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_4098":82429,"_34307":82377,"_23429":135787,"_5":16198,"_30870":135616,"_3543":135788},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_4098":82430,"_34307":82377,"_23429":135790,"_5":16198,"_30870":135616,"_3543":135791},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_4098":82431,"_34307":82377,"_23429":135793,"_5":16198,"_30870":135616,"_3543":135794},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_4098":82432,"_34307":82377,"_23429":135796,"_5":16198,"_30870":135616,"_3543":135797},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_4098":82433,"_34307":82377,"_23429":135799,"_5":16198,"_30870":135620,"_3543":135800},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_4098":82434,"_34307":82377,"_23429":135802,"_5":16198,"_30870":135620,"_3543":135803},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_4098":82435,"_34307":82377,"_23429":135805,"_5":16198,"_30870":135620,"_3543":135806},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_4098":82436,"_34307":82377,"_23429":135808,"_5":16198,"_30870":135620,"_3543":135809},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_4098":82437,"_34307":82377,"_23429":135811,"_5":16198,"_30870":135620,"_3543":135812},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_4098":82438,"_34307":82377,"_23429":135814,"_5":16198,"_30870":135620,"_3543":135815},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_4098":82439,"_34307":82377,"_23429":135817,"_5":16198,"_30870":135620,"_3543":135818},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_4098":82440,"_34307":82377,"_23429":135820,"_5":16198,"_30870":135620,"_3543":135821},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_4098":82441,"_34307":82377,"_23429":135823,"_5":16198,"_30870":135624,"_3543":135824},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_4098":82442,"_34307":82377,"_23429":135826,"_5":16198,"_30870":135624,"_3543":135827},[],"La decisión se toma con el contexto de la operación de dominio:",{"_4098":82443,"_34307":82377,"_23429":135829,"_5":16198,"_30870":135624,"_3543":135830},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_4098":82444,"_34307":82377,"_23429":135832,"_5":16198,"_30870":135624,"_3543":135833},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_4098":82445,"_34307":82377,"_23429":135835,"_5":16198,"_30870":135624,"_3543":135836},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_4098":82446,"_34307":82377,"_23429":135838,"_5":16198,"_30870":135624,"_3543":135839},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_4098":82447,"_34307":82377,"_23429":135841,"_5":16198,"_30870":135624,"_3543":135842},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_4098":82448,"_34307":82377,"_23429":135844,"_5":16198,"_30870":135624,"_3543":135845},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_4098":82449,"_34307":82377,"_23429":135847,"_5":16198,"_30870":135624,"_3543":135848},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_4098":82450,"_34307":82377,"_23429":135850,"_5":16198,"_30870":135624,"_3543":135851},[],"Las acciones se dividen en dos grupos:",{"_4098":82451,"_34307":82377,"_23429":135853,"_5":16198,"_30870":135624,"_3543":135854},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_4098":82452,"_34307":82377,"_23429":135856,"_5":16198,"_30870":135624,"_3543":135857},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_4098":82453,"_34307":82377,"_23429":135859,"_5":16198,"_30870":135624,"_3543":135860},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_4098":82454,"_34307":82377,"_23429":135862,"_5":16198,"_30870":135628,"_3543":135863},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_4098":82455,"_34307":82377,"_23429":135865,"_5":16198,"_30870":135628,"_3543":135866},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_4098":82456,"_34307":82377,"_23429":135868,"_5":16198,"_30870":135628,"_3543":135869},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_4098":82457,"_34307":82377,"_23429":135871,"_5":16198,"_30870":135632,"_3543":135872},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_4098":82458,"_34307":82377,"_23429":135874,"_5":16198,"_30870":135632,"_3543":135875},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_4098":82459,"_34307":82377,"_23429":135877,"_5":16198,"_30870":135632,"_3543":135878},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_4098":82460,"_34307":82377,"_23429":135880,"_5":16198,"_30870":135632,"_3543":135881},[],"Los operadores implementados son:",{"_4098":82461,"_34307":82377,"_23429":135883,"_5":16198,"_30870":135632,"_3543":135884},[],"`equals`, para igualdad exacta;",{"_4098":82462,"_34307":82377,"_23429":135886,"_5":16198,"_30870":135632,"_3543":135887},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_4098":82463,"_34307":82377,"_23429":135889,"_5":16198,"_30870":135632,"_3543":135890},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_4098":82464,"_34307":82377,"_23429":135892,"_5":16198,"_30870":135632,"_3543":135893},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_4098":82465,"_34307":82377,"_23429":135895,"_5":16198,"_30870":135636,"_3543":135896},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_4098":82466,"_34307":82377,"_23429":135898,"_5":16198,"_30870":135636,"_3543":135899},[],"Los modos disponibles son:",{"_4098":82467,"_34307":82377,"_23429":135901,"_5":16198,"_30870":135636,"_3543":135902},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_4098":82468,"_34307":82377,"_23429":135904,"_5":16198,"_30870":135636,"_3543":135905},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_4098":82469,"_34307":82377,"_23429":135907,"_5":16198,"_30870":135636,"_3543":135908},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_4098":82470,"_34307":82377,"_23429":135910,"_5":16198,"_30870":135636,"_3543":135911},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_4098":82471,"_34307":82377,"_23429":135913,"_5":16198,"_30870":135636,"_3543":135914},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_4098":82472,"_34307":82377,"_23429":135916,"_5":16198,"_30870":135636,"_3543":135917},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_4098":82473,"_34307":82377,"_23429":135919,"_5":16198,"_30870":135640,"_3543":135920},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_4098":82474,"_34307":82377,"_23429":135922,"_5":16198,"_30870":135640,"_3543":135923},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_4098":82475,"_34307":82377,"_23429":135925,"_5":16198,"_30870":135640,"_3543":135926},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_4098":82476,"_34307":82377,"_23429":135928,"_5":16198,"_30870":135640,"_3543":135929},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_4098":82477,"_34307":82377,"_23429":135931,"_5":16198,"_30870":135648,"_3543":135932},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_4098":82478,"_34307":82377,"_23429":135934,"_5":16198,"_30870":135648,"_3543":135935},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_4098":82479,"_34307":82377,"_23429":135937,"_5":16198,"_30870":135652,"_3543":135938},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_4098":82480,"_34307":82377,"_23429":135940,"_5":16198,"_30870":135652,"_3543":135941},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_4098":82481,"_34307":82377,"_23429":135943,"_5":16198,"_30870":135656,"_3543":135944},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_4098":82482,"_34307":82377,"_23429":135946,"_5":16198,"_30870":135656,"_3543":135947},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_4098":82483,"_34307":82377,"_23429":135949,"_5":16198,"_30870":135656,"_3543":135950},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_4098":82484,"_34307":82377,"_23429":135952,"_5":16198,"_30870":135660,"_3543":135953},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_4098":82485,"_34307":82377,"_23429":135955,"_5":16198,"_30870":135660,"_3543":135956},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_4098":82486,"_34307":82377,"_23429":135958,"_5":16198,"_30870":135660,"_3543":135959},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_4098":82487,"_34307":82377,"_23429":135961,"_5":16198,"_30870":135660,"_3543":135962},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_4098":82488,"_34307":82377,"_23429":135964,"_5":16198,"_30870":135660,"_3543":135965},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_4098":82489,"_34307":82377,"_23429":135967,"_5":16198,"_30870":135660,"_3543":135968},[],"Ten en cuenta que:",{"_4098":82490,"_34307":82377,"_23429":135970,"_5":16198,"_30870":135660,"_3543":135971},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_4098":82491,"_34307":82377,"_23429":135973,"_5":16198,"_30870":135660,"_3543":135974},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_4098":82492,"_34307":82377,"_23429":135976,"_5":16198,"_30870":135660,"_3543":135977},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_4098":82493,"_34307":82377,"_23429":135979,"_5":16198,"_30870":135664,"_3543":135980},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_4098":82494,"_34307":82377,"_23429":135982,"_5":16198,"_30870":135664,"_3543":135983},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_4098":82495,"_34307":82377,"_23429":135985,"_5":16198,"_30870":135664,"_3543":135986},[],"acceso completo y de solo lectura a KMS;",{"_4098":82496,"_34307":82377,"_23429":135988,"_5":16198,"_30870":135664,"_3543":135989},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_4098":82497,"_34307":82377,"_23429":135991,"_5":16198,"_30870":135664,"_3543":135992},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_4098":82498,"_34307":82377,"_23429":135994,"_5":16198,"_30870":135664,"_3543":135995},[],"acceso a la interfaz;",{"_4098":82499,"_34307":82377,"_23429":135997,"_5":16198,"_30870":135664,"_3543":135998},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_4098":82500,"_34307":82377,"_23429":136000,"_5":16198,"_30870":135664,"_3543":136001},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_4098":82501,"_34307":82377,"_23429":136003,"_5":16198,"_30870":135664,"_3543":136004},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_4098":82502,"_34307":82377,"_23429":136006,"_5":16198,"_30870":135668,"_3543":136007},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_4098":82503,"_34307":82377,"_23429":136009,"_5":16198,"_30870":135668,"_3543":136010},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_4098":82504,"_34307":82377,"_23429":136012,"_5":16198,"_30870":135668,"_3543":136013},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_4098":82505,"_34307":82377,"_23429":136015,"_5":16198,"_30870":135671,"_3543":136016},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_4098":82506,"_34307":82377,"_23429":136018,"_5":16198,"_30870":135675,"_3543":136019},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_4098":82507,"_34307":82377,"_23429":136021,"_5":16198,"_30870":135675,"_3543":136022},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_4098":82508,"_34307":82377,"_23429":136024,"_5":16198,"_30870":135679,"_3543":136025},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_4098":82509,"_34307":82377,"_23429":136027,"_5":16198,"_30870":135683,"_3543":136028},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_4098":82510,"_34307":82377,"_23429":136030,"_5":16198,"_30870":135687,"_3543":136031},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_4098":82511,"_34307":82377,"_23429":136033,"_5":16198,"_30870":135691,"_3543":136034},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_4098":82512,"_34307":82377,"_23429":136036,"_5":16198,"_30870":135691,"_3543":136037},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_4098":82513,"_34307":82377,"_23429":136039,"_5":16198,"_30870":135695,"_3543":136040},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_4098":82514,"_34307":82377,"_23429":136042,"_5":16198,"_30870":135695,"_3543":136043},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_4098":82515,"_34307":82377,"_23429":136045,"_5":16198,"_30870":135695,"_3543":136046},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_4098":82516,"_34307":82377,"_23429":136048,"_5":16198,"_30870":135695,"_3543":136049},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_4098":82517,"_34307":82377,"_23429":136051,"_5":16198,"_30870":135695,"_3543":136052},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_4098":82518,"_34307":82377,"_23429":136054,"_5":16198,"_30870":135695,"_3543":136055},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_4098":82519,"_34307":82377,"_23429":136057,"_5":16198,"_30870":135695,"_3543":136058},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_4098":82520,"_34307":82377,"_23429":136060,"_5":16198,"_30870":135695,"_3543":136061},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_4098":82521,"_34307":82377,"_23429":136063,"_5":16198,"_30870":135699,"_3543":136064},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_4098":82522,"_34307":82377,"_23429":136066,"_5":16198,"_30870":135699,"_3543":136067},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_4098":82523,"_34307":82377,"_23429":136069,"_5":16198,"_30870":135699,"_3543":136070},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_4098":82524,"_34307":82377,"_23429":136072,"_5":16198,"_30870":135703,"_3543":136073},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_4098":82525,"_34307":82377,"_23429":136075,"_5":16198,"_30870":135703,"_3543":136076},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_4098":82526,"_34307":82377,"_23429":136078,"_5":16198,"_30870":135703,"_3543":136079},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_4098":82527,"_34307":82377,"_23429":136081,"_5":16198,"_30870":135703,"_3543":136082},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_4098":82528,"_34307":82377,"_23429":136084,"_5":16198,"_30870":135703,"_3543":136085},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_4098":82529,"_34307":82377,"_23429":136087,"_5":16198,"_30870":135703,"_3543":136088},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_4098":82530,"_34307":82377,"_23429":136090,"_5":16198,"_30870":135703,"_3543":136091},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_4098":82531,"_34307":82377,"_23429":136093,"_5":16198,"_30870":135703,"_3543":136094},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_4098":82532,"_34307":82377,"_23429":136096,"_5":16198,"_30870":135711,"_3543":136097},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_4098":82533,"_34307":82377,"_23429":136099,"_5":16198,"_30870":135715,"_3543":136100},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_4098":82534,"_34307":82377,"_23429":136102,"_5":16198,"_30870":135715,"_3543":136103},[],"que exista un principal activo del tipo correcto;",{"_4098":82535,"_34307":82377,"_23429":136105,"_5":16198,"_30870":135715,"_3543":136106},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_4098":82536,"_34307":82377,"_23429":136108,"_5":16198,"_30870":135715,"_3543":136109},[],"que todas las condiciones del principal se cumplan;",{"_4098":82537,"_34307":82377,"_23429":136111,"_5":16198,"_30870":135715,"_3543":136112},[],"que el principal tenga concedida la política esperada;",{"_4098":82538,"_34307":82377,"_23429":136114,"_5":16198,"_30870":135715,"_3543":136115},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_4098":82539,"_34307":82377,"_23429":136117,"_5":16198,"_30870":135715,"_3543":136118},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_4098":82540,"_34307":82377,"_23429":136120,"_5":16198,"_30870":135715,"_3543":136121},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_4098":82541,"_34307":82377,"_23429":136123,"_5":16198,"_30870":135719,"_3543":136124},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_4098":82542,"_34307":82377,"_23429":136126,"_5":16198,"_30870":135723,"_3543":136127},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_4098":82543,"_34307":82377,"_23429":136129,"_5":16198,"_30870":135727,"_3543":136130},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_4098":82544,"_34307":82377,"_23429":136132,"_5":16198,"_30870":135727,"_3543":136133},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_4098":82545,"_34307":82545,"_5":16596,"_3543":136135,"_34738":136136,"_23429":136137,"_30870":82545},"Alertas y suscripciones",[56936,135600,135601],[],{"_4098":82546,"_34307":82545,"_23429":136139,"_5":16198,"_30870":82545,"_3543":136140},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_4098":82547,"_34307":82545,"_5":34735,"_23429":136142,"_30870":136143,"_3543":136144},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_4098":82548,"_34307":82545,"_5":34735,"_23429":136146,"_30870":136147,"_3543":136148},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_4098":82549,"_34307":82545,"_5":34735,"_23429":136150,"_30870":136151,"_3543":136152},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_4098":82550,"_34307":82545,"_5":34735,"_23429":136154,"_30870":136155,"_3543":136156},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_4098":82551,"_34307":82545,"_5":34735,"_23429":136158,"_30870":136159,"_3543":136160},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_4098":82552,"_34307":82545,"_5":34735,"_23429":136162,"_30870":136163,"_3543":136164},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_4098":82553,"_34307":82545,"_5":34735,"_23429":136166,"_30870":136167,"_3543":136168},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_4098":82554,"_34307":82545,"_5":34735,"_23429":136170,"_30870":136171,"_3543":136172},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_4098":82555,"_34307":82545,"_5":34735,"_23429":136174,"_30870":136175,"_3543":136176},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_4098":82556,"_34307":82545,"_5":34735,"_23429":136178,"_30870":136179,"_3543":136180},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_4098":82557,"_34307":82545,"_5":34735,"_23429":136182,"_30870":136183,"_3543":136184},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_4098":82558,"_34307":82545,"_23429":136186,"_5":16198,"_30870":82545,"_3543":136187},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_4098":82559,"_34307":82545,"_23429":136189,"_5":16198,"_30870":136143,"_3543":136190},[],"Un servicio publica un evento de dominio.",{"_4098":82560,"_34307":82545,"_23429":136192,"_5":16198,"_30870":136143,"_3543":136193},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_4098":82561,"_34307":82545,"_23429":136195,"_5":16198,"_30870":136143,"_3543":136196},[],"El filtro de cada suscripción decide si debe notificarse.",{"_4098":82562,"_34307":82545,"_23429":136198,"_5":16198,"_30870":136143,"_3543":136199},[],"Lamassu entrega el evento al canal configurado.",{"_4098":82563,"_34307":82545,"_23429":136201,"_5":16198,"_30870":136143,"_3543":136202},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_4098":82564,"_34307":82545,"_23429":136204,"_5":16198,"_30870":136147,"_3543":136205},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_4098":82565,"_34307":82545,"_23429":136207,"_5":16198,"_30870":136147,"_3543":136208},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_4098":82566,"_34307":82545,"_23429":136210,"_5":16198,"_30870":136147,"_3543":136211},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_4098":82567,"_34307":82545,"_23429":136213,"_5":16198,"_30870":136147,"_3543":136214},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_4098":82568,"_34307":82545,"_23429":136216,"_5":16198,"_30870":136147,"_3543":136217},[],"`apikey_options` necesita `header` y `key`.",{"_4098":82569,"_34307":82545,"_23429":136219,"_5":16198,"_30870":136147,"_3543":136220},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_4098":82570,"_34307":82545,"_23429":136222,"_5":16198,"_30870":136147,"_3543":136223},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_4098":82571,"_34307":82545,"_23429":136225,"_5":16198,"_30870":136147,"_3543":136226},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_4098":82572,"_34307":82545,"_23429":136228,"_5":16198,"_30870":136155,"_3543":136229},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_4098":82573,"_34307":82545,"_23429":136231,"_5":16198,"_30870":136159,"_3543":136232},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_4098":82574,"_34307":82545,"_23429":136234,"_5":16198,"_30870":136163,"_3543":136235},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_4098":82575,"_34307":82545,"_23429":136237,"_5":16198,"_30870":136163,"_3543":136238},[],"**None** notifica todas las instancias del evento.",{"_4098":82576,"_34307":82545,"_23429":136240,"_5":16198,"_30870":136163,"_3543":136241},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_4098":82577,"_34307":82545,"_23429":136243,"_5":16198,"_30870":136163,"_3543":136244},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_4098":82578,"_34307":82545,"_23429":136246,"_5":16198,"_30870":136163,"_3543":136247},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_4098":82579,"_34307":82545,"_23429":136249,"_5":16198,"_30870":136163,"_3543":136250},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_4098":82580,"_34307":82545,"_23429":136252,"_5":16198,"_30870":136163,"_3543":136253},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_4098":82581,"_34307":82545,"_23429":136255,"_5":16198,"_30870":136167,"_3543":136256},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_4098":82582,"_34307":82545,"_23429":136258,"_5":16198,"_30870":136171,"_3543":136259},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_4098":82583,"_34307":82545,"_23429":136261,"_5":16198,"_30870":136171,"_3543":136262},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_4098":82584,"_34307":82545,"_23429":136264,"_5":16198,"_30870":136171,"_3543":136265},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_4098":82585,"_34307":82545,"_23429":136267,"_5":16198,"_30870":136171,"_3543":136268},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_4098":82586,"_34307":82545,"_23429":136270,"_5":16198,"_30870":136171,"_3543":136271},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_4098":82587,"_34307":82545,"_23429":136273,"_5":16198,"_30870":136171,"_3543":136274},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_4098":82588,"_34307":82545,"_23429":136276,"_5":16198,"_30870":136171,"_3543":136277},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_4098":82589,"_34307":82545,"_23429":136279,"_5":16198,"_30870":136171,"_3543":136280},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_4098":82590,"_34307":82545,"_23429":136282,"_5":16198,"_30870":136175,"_3543":136283},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_4098":82591,"_34307":82545,"_23429":136285,"_5":16198,"_30870":136175,"_3543":136286},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_4098":82592,"_34307":82545,"_23429":136288,"_5":16198,"_30870":136175,"_3543":136289},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_4098":82593,"_34307":82545,"_23429":136291,"_5":16198,"_30870":136175,"_3543":136292},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_4098":82594,"_34307":82545,"_23429":136294,"_5":16198,"_30870":136175,"_3543":136295},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_4098":82595,"_34307":82545,"_23429":136297,"_5":16198,"_30870":136175,"_3543":136298},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_4098":82596,"_34307":82545,"_23429":136300,"_5":16198,"_30870":136175,"_3543":136301},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_4098":82597,"_34307":82545,"_23429":136303,"_5":16198,"_30870":136175,"_3543":136304},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_4098":82598,"_34307":82545,"_23429":136306,"_5":16198,"_30870":136179,"_3543":136307},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_4098":82599,"_34307":82545,"_23429":136309,"_5":16198,"_30870":136179,"_3543":136310},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_4098":82600,"_34307":82545,"_23429":136312,"_5":16198,"_30870":136183,"_3543":136313},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_4098":82601,"_34307":82545,"_23429":136315,"_5":16198,"_30870":136183,"_3543":136316},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_4098":82602,"_34307":82545,"_23429":136318,"_5":16198,"_30870":136183,"_3543":136319},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_4098":82603,"_34307":82545,"_23429":136321,"_5":16198,"_30870":136183,"_3543":136322},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_4098":82604,"_34307":82545,"_23429":136324,"_5":16198,"_30870":136183,"_3543":136325},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_4098":82605,"_34307":82545,"_23429":136327,"_5":16198,"_30870":136183,"_3543":136328},[],"**Validación:** `va.role.crl.create`.",{"_4098":82606,"_34307":82545,"_23429":136330,"_5":16198,"_30870":136183,"_3543":136331},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_4098":82607,"_34307":82545,"_23429":136333,"_5":16198,"_30870":136183,"_3543":136334},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_4098":82608,"_34307":82608,"_5":16596,"_3543":136336,"_34738":136337,"_23429":136338,"_30870":82608},"Registros de auditoría",[56936,135600,135601],[],{"_4098":82609,"_34307":82608,"_23429":136340,"_5":16198,"_30870":82608,"_3543":136341},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_4098":82610,"_34307":82608,"_5":34735,"_23429":136343,"_30870":136344,"_3543":136345},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_4098":82611,"_34307":82608,"_5":34735,"_23429":136347,"_30870":136348,"_3543":136349},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#cobertura","Cobertura",{"_4098":82612,"_34307":82608,"_5":34735,"_23429":136351,"_30870":136352,"_3543":136353},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_4098":82613,"_34307":82608,"_5":34735,"_23429":136355,"_30870":136356,"_3543":136357},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_4098":82614,"_34307":82608,"_5":34735,"_23429":136359,"_30870":136360,"_3543":136361},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_4098":82615,"_34307":82608,"_5":34735,"_23429":136363,"_30870":136364,"_3543":136365},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_4098":82616,"_34307":82608,"_5":34735,"_23429":136367,"_30870":136368,"_3543":136369},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_4098":82617,"_34307":82608,"_5":34735,"_23429":136371,"_30870":136372,"_3543":136373},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_4098":82618,"_34307":82608,"_5":34735,"_23429":136375,"_30870":136376,"_3543":136377},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_4098":82619,"_34307":82608,"_5":34735,"_23429":136379,"_30870":136380,"_3543":136381},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_4098":82620,"_34307":82608,"_5":34735,"_23429":136383,"_30870":136384,"_3543":136385},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_4098":82621,"_34307":82608,"_23429":136387,"_5":16198,"_30870":82608,"_3543":136388},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_4098":82622,"_34307":82608,"_23429":136390,"_5":16198,"_30870":136344,"_3543":136391},[],"El cuerpo de auditoría incluye:",{"_4098":82623,"_34307":82608,"_23429":136393,"_5":16198,"_30870":136344,"_3543":136394},[],"input: datos recibidos por la operación;",{"_4098":82624,"_34307":82608,"_23429":136396,"_5":16198,"_30870":136344,"_3543":136397},[],"has\\_error: indica si el servicio devolvió un error;",{"_4098":82625,"_34307":82608,"_23429":136399,"_5":16198,"_30870":136344,"_3543":136400},[],"output: resultado producido o mensaje de error;",{"_4098":82626,"_34307":82608,"_23429":136402,"_5":16198,"_30870":136344,"_3543":136403},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_4098":82627,"_34307":82608,"_23429":136405,"_5":16198,"_30870":136344,"_3543":136406},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_4098":82628,"_34307":82608,"_23429":136408,"_5":16198,"_30870":136344,"_3543":136409},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_4098":82629,"_34307":82608,"_23429":136411,"_5":16198,"_30870":136348,"_3543":136412},[],"El backend aplica auditoría a mutaciones de:",{"_4098":82630,"_34307":82608,"_23429":136414,"_5":16198,"_30870":136348,"_3543":136415},[],"autoridades, certificados y perfiles de emisión;",{"_4098":82631,"_34307":82608,"_23429":136417,"_5":16198,"_30870":136348,"_3543":136418},[],"claves y motores KMS;",{"_4098":82632,"_34307":82608,"_23429":136420,"_5":16198,"_30870":136348,"_3543":136421},[],"dispositivos e identidades;",{"_4098":82633,"_34307":82608,"_23429":136423,"_5":16198,"_30870":136348,"_3543":136424},[],"DMS y operaciones de enrolamiento;",{"_4098":82634,"_34307":82608,"_23429":136426,"_5":16198,"_30870":136348,"_3543":136427},[],"funciones de validación y CRL;",{"_4098":82635,"_34307":82608,"_23429":136429,"_5":16198,"_30870":136348,"_3543":136430},[],"principales, políticas y concesiones de autorización.",{"_4098":82636,"_34307":82608,"_23429":136432,"_5":16198,"_30870":136348,"_3543":136433},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_4098":82637,"_34307":82608,"_23429":136435,"_5":16198,"_30870":136352,"_3543":136436},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_4098":82638,"_34307":82608,"_23429":136438,"_5":16198,"_30870":136352,"_3543":136439},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_4098":82639,"_34307":82608,"_23429":136441,"_5":16198,"_30870":136352,"_3543":136442},[],"Diseña el consumidor para:",{"_4098":82640,"_34307":82608,"_23429":136444,"_5":16198,"_30870":136352,"_3543":136445},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_4098":82641,"_34307":82608,"_23429":136447,"_5":16198,"_30870":136352,"_3543":136448},[],"conservar el CloudEvent completo sin modificar;",{"_4098":82642,"_34307":82608,"_23429":136450,"_5":16198,"_30870":136352,"_3543":136451},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_4098":82643,"_34307":82608,"_23429":136453,"_5":16198,"_30870":136352,"_3543":136454},[],"cifrar en tránsito y en reposo;",{"_4098":82644,"_34307":82608,"_23429":136456,"_5":16198,"_30870":136352,"_3543":136457},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_4098":82645,"_34307":82608,"_23429":136459,"_5":16198,"_30870":136352,"_3543":136460},[],"aplicar una política explícita de retención y legal hold;",{"_4098":82646,"_34307":82608,"_23429":136462,"_5":16198,"_30870":136352,"_3543":136463},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_4098":82647,"_34307":82608,"_23429":136465,"_5":16198,"_30870":136356,"_3543":136466},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_4098":82648,"_34307":82608,"_23429":136468,"_5":16198,"_30870":136356,"_3543":136469},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_4098":82649,"_34307":82608,"_23429":136471,"_5":16198,"_30870":136364,"_3543":136472},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_4098":82650,"_34307":82608,"_23429":136474,"_5":16198,"_30870":136368,"_3543":136475},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_4098":82651,"_34307":82608,"_23429":136477,"_5":16198,"_30870":136372,"_3543":136478},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_4098":82652,"_34307":82608,"_23429":136480,"_5":16198,"_30870":136376,"_3543":136481},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_4098":82653,"_34307":82608,"_23429":136483,"_5":16198,"_30870":136380,"_3543":136484},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_4098":82654,"_34307":82608,"_23429":136486,"_5":16198,"_30870":136384,"_3543":136487},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_4098":82655,"_34307":82608,"_23429":136489,"_5":16198,"_30870":136384,"_3543":136490},[],"aparece un evento de auditoría correcto;",{"_4098":82656,"_34307":82608,"_23429":136492,"_5":16198,"_30870":136384,"_3543":136493},[],"el principal coincide con la identidad utilizada;",{"_4098":82657,"_34307":82608,"_23429":136495,"_5":16198,"_30870":136384,"_3543":136496},[],"el consumidor lo persiste una sola vez;",{"_4098":82658,"_34307":82608,"_23429":136498,"_5":16198,"_30870":136384,"_3543":136499},[],"puede recuperarse por recurso, actor y periodo;",{"_4098":82659,"_34307":82608,"_23429":136501,"_5":16198,"_30870":136384,"_3543":136502},[],"una interrupción del consumidor produce una alerta.",{"_4098":82660,"_34307":82608,"_23429":136504,"_5":16198,"_30870":136384,"_3543":136505},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_4098":82661,"_34307":82661,"_5":16596,"_3543":136507,"_34738":136508,"_23429":136509,"_30870":82661},"Arquitectura de la plataforma",[56936,135600],[],{"_4098":82662,"_34307":82661,"_23429":136511,"_5":16198,"_30870":82661,"_3543":136512},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_4098":82663,"_34307":82661,"_5":34735,"_23429":136514,"_30870":136515,"_3543":136516},[],"/docs/pr-preview/pr-58/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_4098":82664,"_34307":82661,"_5":34735,"_23429":136518,"_30870":136519,"_3543":136520},[],"/docs/pr-preview/pr-58/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_4098":82665,"_34307":82661,"_5":34735,"_23429":136522,"_30870":136523,"_3543":136524},[],"/docs/pr-preview/pr-58/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_4098":82666,"_34307":82661,"_5":34735,"_23429":136526,"_30870":136527,"_3543":136528},[],"/docs/pr-preview/pr-58/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_4098":82667,"_34307":82661,"_5":34735,"_23429":136530,"_30870":136531,"_3543":136532},[],"/docs/pr-preview/pr-58/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_4098":82668,"_34307":82661,"_23429":136534,"_5":16198,"_30870":82661,"_3543":136535},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_4098":82669,"_34307":82661,"_23429":136537,"_5":16198,"_30870":82661,"_3543":136538},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_4098":82670,"_34307":82661,"_23429":136540,"_5":16198,"_30870":136515,"_3543":136541},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_4098":82671,"_34307":82661,"_23429":136543,"_5":16198,"_30870":136519,"_3543":136544},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_4098":82672,"_34307":82661,"_23429":136546,"_5":16198,"_30870":136523,"_3543":136547},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_4098":82673,"_34307":82661,"_23429":136549,"_5":16198,"_30870":136527,"_3543":136550},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_4098":82674,"_34307":82661,"_23429":136552,"_5":16198,"_30870":136531,"_3543":136553},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_4098":82675,"_34307":82675,"_5":16596,"_3543":136555,"_34738":136556,"_23429":136557,"_30870":82675},"Cómo funciona Lamassu",[56936,135600],[],{"_4098":82676,"_34307":82675,"_23429":136559,"_5":16198,"_30870":82675,"_3543":136560},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_4098":82677,"_34307":82675,"_5":34735,"_23429":136562,"_30870":136563,"_3543":136564},[],"/docs/pr-preview/pr-58/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_4098":82678,"_34307":82675,"_5":34735,"_23429":136566,"_30870":136567,"_3543":136568},[],"/docs/pr-preview/pr-58/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_4098":82679,"_34307":82675,"_23429":136570,"_5":16198,"_30870":82675,"_3543":136571},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_4098":82680,"_34307":82675,"_23429":136573,"_5":16198,"_30870":136563,"_3543":136574},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_4098":82681,"_34307":82675,"_23429":136576,"_5":16198,"_30870":136563,"_3543":136577},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_4098":82682,"_34307":82675,"_23429":136579,"_5":16198,"_30870":136563,"_3543":136580},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_4098":82683,"_34307":82675,"_23429":136582,"_5":16198,"_30870":136563,"_3543":136583},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_4098":82684,"_34307":82675,"_23429":136585,"_5":16198,"_30870":136563,"_3543":136586},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_4098":82685,"_34307":82675,"_23429":136588,"_5":16198,"_30870":136567,"_3543":136589},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_4098":82686,"_34307":82675,"_23429":136591,"_5":16198,"_30870":136567,"_3543":136592},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_4098":82687,"_34307":82675,"_23429":136594,"_5":16198,"_30870":136567,"_3543":136595},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_4098":82688,"_34307":82675,"_23429":136597,"_5":16198,"_30870":136567,"_3543":136598},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_4098":82689,"_34307":82675,"_23429":136600,"_5":16198,"_30870":136567,"_3543":136601},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_4098":82690,"_34307":82675,"_23429":136603,"_5":16198,"_30870":136567,"_3543":136604},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_4098":82691,"_34307":82675,"_23429":136606,"_5":16198,"_30870":136567,"_3543":136607},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_4098":82692,"_34307":82692,"_5":16596,"_3543":136609,"_34738":136610,"_23429":136611,"_30870":82692},"Dispositivos e identidades",[56936,135600,59415,136609],[],{"_4098":82693,"_34307":82692,"_23429":136613,"_5":16198,"_30870":82692,"_3543":136614},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_4098":82694,"_34307":82692,"_5":34735,"_23429":136616,"_30870":136617,"_3543":136618},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_4098":82695,"_34307":82692,"_5":34735,"_23429":136620,"_30870":136621,"_3543":136622},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_4098":82696,"_34307":82692,"_5":34735,"_23429":136624,"_30870":136625,"_3543":136626},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_4098":82697,"_34307":82692,"_5":34735,"_23429":136628,"_30870":136629,"_3543":136630},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_4098":82698,"_34307":82692,"_5":34735,"_23429":136632,"_30870":136633,"_3543":136634},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_4098":82699,"_34307":82692,"_5":34735,"_23429":136636,"_30870":136637,"_3543":136638},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_4098":82700,"_34307":82692,"_5":34735,"_23429":136640,"_30870":136641,"_3543":136642},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_4098":82701,"_34307":82692,"_5":34735,"_23429":136644,"_30870":136645,"_3543":136646},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_4098":82702,"_34307":82692,"_5":34735,"_23429":136648,"_30870":136649,"_3543":136650},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_4098":82703,"_34307":82692,"_5":34735,"_23429":136652,"_30870":136653,"_3543":136654},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_4098":82704,"_34307":82692,"_5":34735,"_23429":136656,"_30870":136657,"_3543":136658},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_4098":82705,"_34307":82692,"_23429":136660,"_5":16198,"_30870":82692,"_3543":136661},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_4098":82706,"_34307":82692,"_23429":136663,"_5":16198,"_30870":82692,"_3543":136664},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_4098":82707,"_34307":82692,"_23429":136666,"_5":16198,"_30870":136617,"_3543":136667},[],"Vista operativa",{"_4098":82708,"_34307":82692,"_23429":136669,"_5":16198,"_30870":136617,"_3543":136670},[],"Interpretación",{"_4098":82709,"_34307":82692,"_23429":136672,"_5":16198,"_30870":136617,"_3543":59478},[],{"_4098":82710,"_34307":82692,"_23429":136674,"_5":16198,"_30870":136617,"_3543":136675},[],"Hay registro, pero todavía no hay identidad asociada.",{"_4098":82711,"_34307":82692,"_23429":136677,"_5":16198,"_30870":136617,"_3543":59484},[],{"_4098":82712,"_34307":82692,"_23429":136679,"_5":16198,"_30870":136617,"_3543":136680},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_4098":82713,"_34307":82692,"_23429":136682,"_5":16198,"_30870":136617,"_3543":59490},[],{"_4098":82714,"_34307":82692,"_23429":136684,"_5":16198,"_30870":136617,"_3543":136685},[],"La identidad está en la ventana operativa de renovación.",{"_4098":82715,"_34307":82692,"_23429":136687,"_5":16198,"_30870":136617,"_3543":59496},[],{"_4098":82716,"_34307":82692,"_23429":136689,"_5":16198,"_30870":136617,"_3543":136690},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_4098":82717,"_34307":82692,"_23429":136692,"_5":16198,"_30870":136617,"_3543":59502},[],{"_4098":82718,"_34307":82692,"_23429":136694,"_5":16198,"_30870":136617,"_3543":136695},[],"La identidad ha vencido.",{"_4098":82719,"_34307":82692,"_23429":136697,"_5":16198,"_30870":136617,"_3543":59508},[],{"_4098":82720,"_34307":82692,"_23429":136699,"_5":16198,"_30870":136617,"_3543":136700},[],"La identidad está marcada como revocada.",{"_4098":82721,"_34307":82692,"_23429":136702,"_5":16198,"_30870":136617,"_3543":59514},[],{"_4098":82722,"_34307":82692,"_23429":136704,"_5":16198,"_30870":136617,"_3543":136705},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_4098":82723,"_34307":82692,"_23429":136707,"_5":16198,"_30870":136617,"_3543":136708},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_4098":82724,"_34307":82692,"_23429":136710,"_5":16198,"_30870":136621,"_3543":136711},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_4098":82725,"_34307":82692,"_23429":136713,"_5":16198,"_30870":136621,"_3543":136714},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_4098":82726,"_34307":82692,"_23429":136716,"_5":16198,"_30870":136621,"_3543":136717},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_4098":82727,"_34307":82692,"_23429":136719,"_5":16198,"_30870":136621,"_3543":136720},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_4098":82728,"_34307":82692,"_23429":136722,"_5":16198,"_30870":136625,"_3543":136723},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_4098":82729,"_34307":82692,"_23429":136725,"_5":16198,"_30870":136629,"_3543":136726},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_4098":82730,"_34307":82692,"_23429":136728,"_5":16198,"_30870":136633,"_3543":136729},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_4098":82731,"_34307":82692,"_23429":136731,"_5":16198,"_30870":136637,"_3543":136732},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_4098":82732,"_34307":82692,"_23429":136734,"_5":16198,"_30870":136641,"_3543":136735},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_4098":82733,"_34307":82692,"_23429":136737,"_5":16198,"_30870":136641,"_3543":136738},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_4098":82734,"_34307":82692,"_23429":136740,"_5":16198,"_30870":136645,"_3543":136741},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_4098":82735,"_34307":82692,"_23429":136743,"_5":16198,"_30870":136645,"_3543":136744},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_4098":82736,"_34307":82692,"_23429":136746,"_5":16198,"_30870":136645,"_3543":136747},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_4098":82737,"_34307":82692,"_23429":136749,"_5":16198,"_30870":136645,"_3543":136750},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_4098":82738,"_34307":82692,"_23429":136752,"_5":16198,"_30870":136645,"_3543":136753},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_4098":82739,"_34307":82692,"_23429":136755,"_5":16198,"_30870":136645,"_3543":136756},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_4098":82740,"_34307":82692,"_23429":136758,"_5":16198,"_30870":136649,"_3543":136759},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_4098":82741,"_34307":82692,"_23429":136761,"_5":16198,"_30870":136649,"_3543":136762},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_4098":82742,"_34307":82692,"_23429":136764,"_5":16198,"_30870":136653,"_3543":136765},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_4098":82743,"_34307":82692,"_23429":136767,"_5":16198,"_30870":136653,"_3543":136768},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_4098":82744,"_34307":82692,"_23429":136770,"_5":16198,"_30870":136653,"_3543":136771},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_4098":82745,"_34307":82692,"_23429":136773,"_5":16198,"_30870":136653,"_3543":136774},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_4098":82746,"_34307":82692,"_23429":136776,"_5":16198,"_30870":136657,"_3543":136777},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_4098":82747,"_34307":82692,"_23429":136779,"_5":16198,"_30870":136657,"_3543":136780},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_4098":82748,"_34307":82748,"_5":16596,"_3543":136782,"_34738":136783,"_23429":136785,"_30870":82748},"Identidad inicial y autenticación",[56936,135600,59415,136609,136784],"Enrolamiento con PKI",[],{"_4098":82749,"_34307":82748,"_23429":136787,"_5":16198,"_30870":82748,"_3543":136788},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_4098":82750,"_34307":82748,"_5":34735,"_23429":136790,"_30870":136791,"_3543":136792},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_4098":82751,"_34307":82748,"_5":34735,"_23429":136794,"_30870":136795,"_3543":136796},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_4098":82752,"_34307":82748,"_5":34735,"_23429":136798,"_30870":136799,"_3543":136800},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_4098":82753,"_34307":82748,"_5":34735,"_23429":136802,"_30870":136803,"_3543":136804},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_4098":82754,"_34307":82748,"_5":34735,"_23429":136806,"_30870":136807,"_3543":136808},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_4098":82755,"_34307":82748,"_23429":136810,"_5":16198,"_30870":82748,"_3543":136811},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_4098":82756,"_34307":82748,"_23429":136813,"_5":16198,"_30870":136791,"_3543":136814},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_4098":82757,"_34307":82748,"_23429":136816,"_5":16198,"_30870":136791,"_3543":136817},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_4098":82758,"_34307":82748,"_23429":136819,"_5":16198,"_30870":136795,"_3543":136820},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_4098":82759,"_34307":82748,"_23429":136822,"_5":16198,"_30870":136795,"_3543":136823},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_4098":82760,"_34307":82748,"_23429":136825,"_5":16198,"_30870":136795,"_3543":136826},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_4098":82761,"_34307":82748,"_23429":136828,"_5":16198,"_30870":136799,"_3543":136829},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_4098":82762,"_34307":82748,"_23429":136831,"_5":16198,"_30870":136799,"_3543":136832},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_4098":82763,"_34307":82748,"_23429":136834,"_5":16198,"_30870":136803,"_3543":136835},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_4098":82764,"_34307":82748,"_23429":136837,"_5":16198,"_30870":136803,"_3543":136838},[],"Ejemplo de cuerpo:",{"_4098":82765,"_34307":82748,"_23429":136840,"_5":16198,"_30870":136803,"_3543":136841},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_4098":82766,"_34307":82748,"_23429":136843,"_5":16198,"_30870":136803,"_3543":136844},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_4098":82767,"_34307":82748,"_23429":136846,"_5":16198,"_30870":136803,"_3543":136847},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_4098":82768,"_34307":82748,"_23429":136849,"_5":16198,"_30870":136803,"_3543":136850},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_4098":82769,"_34307":82748,"_23429":136852,"_5":16198,"_30870":136807,"_3543":136853},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_4098":82770,"_34307":82748,"_23429":136855,"_5":16198,"_30870":136807,"_3543":136856},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_4098":82771,"_34307":82771,"_5":16596,"_3543":136858,"_34738":136859,"_23429":136860,"_30870":82771},"Configura y opera el DMS",[56936,135600,59415,136609,136784],[],{"_4098":82772,"_34307":82771,"_23429":136862,"_5":16198,"_30870":82771,"_3543":136863},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_4098":82773,"_34307":82771,"_5":34735,"_23429":136865,"_30870":136866,"_3543":134178},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_4098":82774,"_34307":82771,"_5":34735,"_23429":136868,"_30870":136869,"_3543":136870},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_4098":82775,"_34307":82771,"_5":34735,"_23429":136872,"_30870":136873,"_3543":136874},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_4098":82776,"_34307":82771,"_5":34735,"_23429":136876,"_30870":136877,"_3543":136878},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_4098":82777,"_34307":82771,"_5":34735,"_23429":136880,"_30870":136881,"_3543":136882},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_4098":82778,"_34307":82771,"_5":34735,"_23429":136884,"_30870":136885,"_3543":136886},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_4098":82779,"_34307":82771,"_5":34735,"_23429":136888,"_30870":136889,"_3543":136890},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_4098":82780,"_34307":82771,"_5":34735,"_23429":136892,"_30870":136893,"_3543":136894},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_4098":82781,"_34307":82771,"_5":34735,"_23429":136896,"_30870":136897,"_3543":59710},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_4098":82782,"_34307":82771,"_5":34735,"_23429":136899,"_30870":136900,"_3543":59714},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_4098":82783,"_34307":82771,"_5":34735,"_23429":136902,"_30870":136903,"_3543":136904},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_4098":82784,"_34307":82771,"_5":34735,"_23429":136906,"_30870":136907,"_3543":136908},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_4098":82785,"_34307":82771,"_5":34735,"_23429":136910,"_30870":136911,"_3543":136912},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_4098":82786,"_34307":82771,"_5":34735,"_23429":136914,"_30870":136915,"_3543":136916},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_4098":82787,"_34307":82771,"_5":34735,"_23429":136918,"_30870":136919,"_3543":59734},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_4098":82788,"_34307":82771,"_5":34735,"_23429":136921,"_30870":136922,"_3543":136923},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_4098":82789,"_34307":82771,"_5":34735,"_23429":136925,"_30870":136926,"_3543":136927},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_4098":82790,"_34307":82771,"_5":34735,"_23429":136929,"_30870":136930,"_3543":136931},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_4098":82791,"_34307":82771,"_23429":136933,"_5":16198,"_30870":82771,"_3543":136934},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_4098":82792,"_34307":82771,"_23429":136936,"_5":16198,"_30870":136866,"_3543":136937},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_4098":82793,"_34307":82771,"_23429":136939,"_5":16198,"_30870":136866,"_3543":136940},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_4098":82794,"_34307":82771,"_23429":136942,"_5":16198,"_30870":136873,"_3543":136943},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_4098":82795,"_34307":82771,"_23429":136945,"_5":16198,"_30870":136877,"_3543":136946},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_4098":82796,"_34307":82771,"_23429":136948,"_5":16198,"_30870":136881,"_3543":136949},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_4098":82797,"_34307":82771,"_23429":136951,"_5":16198,"_30870":136885,"_3543":136952},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_4098":82798,"_34307":82771,"_23429":136954,"_5":16198,"_30870":136889,"_3543":136955},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_4098":82799,"_34307":82771,"_23429":136957,"_5":16198,"_30870":136897,"_3543":136958},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_4098":82800,"_34307":82771,"_23429":136960,"_5":16198,"_30870":136897,"_3543":136961},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_4098":82801,"_34307":82771,"_23429":136963,"_5":16198,"_30870":136900,"_3543":136964},[],"Campo de `settings.enrollment_settings`",{"_4098":82802,"_34307":82771,"_23429":136966,"_5":16198,"_30870":136900,"_3543":136967},[],"Decisión",{"_4098":82803,"_34307":82771,"_23429":136969,"_5":16198,"_30870":136900,"_3543":59785},[],{"_4098":82804,"_34307":82771,"_23429":136971,"_5":16198,"_30870":136900,"_3543":136972},[],"`EST_RFC7030` para estas operaciones.",{"_4098":82805,"_34307":82771,"_23429":136974,"_5":16198,"_30870":136900,"_3543":59791},[],{"_4098":82806,"_34307":82771,"_23429":136976,"_5":16198,"_30870":136900,"_3543":136977},[],"ID de la CA que firmará.",{"_4098":82807,"_34307":82771,"_23429":136979,"_5":16198,"_30870":136900,"_3543":59797},[],{"_4098":82808,"_34307":82771,"_23429":136981,"_5":16198,"_30870":136900,"_3543":136982},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_4098":82809,"_34307":82771,"_23429":136984,"_5":16198,"_30870":136900,"_3543":59803},[],{"_4098":82810,"_34307":82771,"_23429":136986,"_5":16198,"_30870":136900,"_3543":136987},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_4098":82811,"_34307":82771,"_23429":136989,"_5":16198,"_30870":136900,"_3543":59809},[],{"_4098":82812,"_34307":82771,"_23429":136991,"_5":16198,"_30870":136900,"_3543":136992},[],"Uno de los cuatro modos de autenticación.",{"_4098":82813,"_34307":82771,"_23429":136994,"_5":16198,"_30870":136900,"_3543":136995},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_4098":82814,"_34307":82771,"_23429":136997,"_5":16198,"_30870":136903,"_3543":136998},[],"Los bloques son independientes:",{"_4098":82815,"_34307":82771,"_23429":137000,"_5":16198,"_30870":136903,"_3543":137001},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_4098":82816,"_34307":82771,"_23429":137003,"_5":16198,"_30870":136903,"_3543":137004},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_4098":82817,"_34307":82771,"_23429":137006,"_5":16198,"_30870":136903,"_3543":59827},[],{"_4098":82818,"_34307":82771,"_23429":137008,"_5":16198,"_30870":136903,"_3543":137009},[],"Control aplicado en la operación configurada",{"_4098":82819,"_34307":82771,"_23429":137011,"_5":16198,"_30870":136903,"_3543":59833},[],{"_4098":82820,"_34307":82771,"_23429":137013,"_5":16198,"_30870":136903,"_3543":137014},[],"Validación del certificado presentado.",{"_4098":82821,"_34307":82771,"_23429":137016,"_5":16198,"_30870":136903,"_3543":59839},[],{"_4098":82822,"_34307":82771,"_23429":137018,"_5":16198,"_30870":136903,"_3543":137019},[],"Autorización del webhook configurado.",{"_4098":82823,"_34307":82771,"_23429":137021,"_5":16198,"_30870":136903,"_3543":59845},[],{"_4098":82824,"_34307":82771,"_23429":137023,"_5":16198,"_30870":136903,"_3543":137024},[],"Validación del certificado y, después, aprobación del webhook.",{"_4098":82825,"_34307":82771,"_23429":137026,"_5":16198,"_30870":136903,"_3543":59851},[],{"_4098":82826,"_34307":82771,"_23429":137028,"_5":16198,"_30870":136903,"_3543":137029},[],"Sin autenticación del solicitante por el DMS.",{"_4098":82827,"_34307":82771,"_23429":137031,"_5":16198,"_30870":136903,"_3543":137032},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_4098":82828,"_34307":82771,"_23429":137034,"_5":16198,"_30870":136903,"_3543":137035},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_4098":82829,"_34307":82771,"_23429":137037,"_5":16198,"_30870":136903,"_3543":137038},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_4098":82830,"_34307":82771,"_23429":137040,"_5":16198,"_30870":136903,"_3543":137041},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_4098":82831,"_34307":82771,"_23429":137043,"_5":16198,"_30870":136907,"_3543":137044},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_4098":82832,"_34307":82771,"_23429":137046,"_5":16198,"_30870":136907,"_3543":137047},[],"Campo de `external_webhook_settings`",{"_4098":82833,"_34307":82771,"_23429":137049,"_5":16198,"_30870":136907,"_3543":136967},[],{"_4098":82834,"_34307":82771,"_23429":137051,"_5":16198,"_30870":136907,"_3543":59877},[],{"_4098":82835,"_34307":82771,"_23429":137053,"_5":16198,"_30870":136907,"_3543":137054},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_4098":82836,"_34307":82771,"_23429":137056,"_5":16198,"_30870":136907,"_3543":59883},[],{"_4098":82837,"_34307":82771,"_23429":137058,"_5":16198,"_30870":136907,"_3543":137059},[],"`POST` o `PUT`; `POST` por defecto.",{"_4098":82838,"_34307":82771,"_23429":137061,"_5":16198,"_30870":136907,"_3543":59889},[],{"_4098":82839,"_34307":82771,"_23429":137063,"_5":16198,"_30870":136907,"_3543":137064},[],"Etiqueta usada en los logs del servicio.",{"_4098":82840,"_34307":82771,"_23429":137066,"_5":16198,"_30870":136907,"_3543":59895},[],{"_4098":82841,"_34307":82771,"_23429":137068,"_5":16198,"_30870":136907,"_3543":137069},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_4098":82842,"_34307":82771,"_23429":137071,"_5":16198,"_30870":136907,"_3543":59901},[],{"_4098":82843,"_34307":82771,"_23429":137073,"_5":16198,"_30870":136907,"_3543":137074},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_4098":82844,"_34307":82771,"_23429":137076,"_5":16198,"_30870":136907,"_3543":59907},[],{"_4098":82845,"_34307":82771,"_23429":137078,"_5":16198,"_30870":136907,"_3543":137079},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_4098":82846,"_34307":82771,"_23429":137081,"_5":16198,"_30870":136907,"_3543":59913},[],{"_4098":82847,"_34307":82771,"_23429":137083,"_5":16198,"_30870":136907,"_3543":137084},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_4098":82848,"_34307":82771,"_23429":137086,"_5":16198,"_30870":136907,"_3543":59919},[],{"_4098":82849,"_34307":82771,"_23429":137088,"_5":16198,"_30870":136907,"_3543":137089},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_4098":82850,"_34307":82771,"_23429":137091,"_5":16198,"_30870":136907,"_3543":59925},[],{"_4098":82851,"_34307":82771,"_23429":137093,"_5":16198,"_30870":136907,"_3543":137094},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_4098":82852,"_34307":82771,"_23429":137096,"_5":16198,"_30870":136907,"_3543":59931},[],{"_4098":82853,"_34307":82771,"_23429":137098,"_5":16198,"_30870":136907,"_3543":137099},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_4098":82854,"_34307":82771,"_23429":137101,"_5":16198,"_30870":136907,"_3543":137102},[],"Reglas de esa configuración:",{"_4098":82855,"_34307":82771,"_23429":137104,"_5":16198,"_30870":136907,"_3543":137105},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_4098":82856,"_34307":82771,"_23429":137107,"_5":16198,"_30870":136907,"_3543":137108},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_4098":82857,"_34307":82771,"_23429":137110,"_5":16198,"_30870":136907,"_3543":137111},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_4098":82858,"_34307":82771,"_23429":137113,"_5":16198,"_30870":136907,"_3543":137114},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_4098":82859,"_34307":82771,"_23429":137116,"_5":16198,"_30870":136907,"_3543":137117},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_4098":82860,"_34307":82771,"_23429":137119,"_5":16198,"_30870":136907,"_3543":137120},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_4098":82861,"_34307":82771,"_23429":137122,"_5":16198,"_30870":136907,"_3543":137123},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_4098":82862,"_34307":82771,"_23429":137125,"_5":16198,"_30870":136907,"_3543":137126},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_4098":82863,"_34307":82771,"_23429":137128,"_5":16198,"_30870":136907,"_3543":137129},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_4098":82864,"_34307":82771,"_23429":137131,"_5":16198,"_30870":136911,"_3543":137132},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_4098":82865,"_34307":82771,"_23429":137134,"_5":16198,"_30870":136915,"_3543":137135},[],"Campo de `settings.reenrollment_settings`",{"_4098":82866,"_34307":82771,"_23429":137137,"_5":16198,"_30870":136915,"_3543":137138},[],"Función",{"_4098":82867,"_34307":82771,"_23429":137140,"_5":16198,"_30870":136915,"_3543":59975},[],{"_4098":82868,"_34307":82771,"_23429":137142,"_5":16198,"_30870":136915,"_3543":137143},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_4098":82869,"_34307":82771,"_23429":137145,"_5":16198,"_30870":136915,"_3543":59981},[],{"_4098":82870,"_34307":82771,"_23429":137147,"_5":16198,"_30870":136915,"_3543":137148},[],"Umbral operativo preventivo de monitorización.",{"_4098":82871,"_34307":82771,"_23429":137150,"_5":16198,"_30870":136915,"_3543":59987},[],{"_4098":82872,"_34307":82771,"_23429":137152,"_5":16198,"_30870":136915,"_3543":137153},[],"Umbral operativo crítico de monitorización.",{"_4098":82873,"_34307":82771,"_23429":137155,"_5":16198,"_30870":136915,"_3543":59993},[],{"_4098":82874,"_34307":82771,"_23429":137157,"_5":16198,"_30870":136915,"_3543":137158},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_4098":82875,"_34307":82771,"_23429":137160,"_5":16198,"_30870":136915,"_3543":59999},[],{"_4098":82876,"_34307":82771,"_23429":137162,"_5":16198,"_30870":136915,"_3543":137163},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_4098":82877,"_34307":82771,"_23429":137165,"_5":16198,"_30870":136915,"_3543":60005},[],{"_4098":82878,"_34307":82771,"_23429":137167,"_5":16198,"_30870":136915,"_3543":137168},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_4098":82879,"_34307":82771,"_23429":137170,"_5":16198,"_30870":136915,"_3543":137171},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_4098":82880,"_34307":82771,"_23429":137173,"_5":16198,"_30870":136919,"_3543":137174},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_4098":82881,"_34307":82771,"_23429":137176,"_5":16198,"_30870":136922,"_3543":134542},[],{"_4098":82882,"_34307":82771,"_23429":137178,"_5":16198,"_30870":136922,"_3543":137179},[],"Qué publica",{"_4098":82883,"_34307":82771,"_23429":137181,"_5":16198,"_30870":136922,"_3543":60022},[],{"_4098":82884,"_34307":82771,"_23429":137183,"_5":16198,"_30870":136922,"_3543":137184},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_4098":82885,"_34307":82771,"_23429":137186,"_5":16198,"_30870":136922,"_3543":60028},[],{"_4098":82886,"_34307":82771,"_23429":137188,"_5":16198,"_30870":136922,"_3543":137189},[],"Certificado de la CA emisora seleccionada.",{"_4098":82887,"_34307":82771,"_23429":137191,"_5":16198,"_30870":136922,"_3543":60034},[],{"_4098":82888,"_34307":82771,"_23429":137193,"_5":16198,"_30870":136922,"_3543":137194},[],"Certificados de las CAs elegidas explícitamente.",{"_4098":82889,"_34307":82771,"_23429":137196,"_5":16198,"_30870":136922,"_3543":137197},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_4098":82890,"_34307":82771,"_23429":137199,"_5":16198,"_30870":136926,"_3543":137200},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_4098":82891,"_34307":82771,"_23429":137202,"_5":16198,"_30870":136926,"_3543":137203},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_4098":82892,"_34307":82771,"_23429":137205,"_5":16198,"_30870":136926,"_3543":137206},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_4098":82893,"_34307":82771,"_23429":137208,"_5":16198,"_30870":136930,"_3543":137209},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_4098":82894,"_34307":82894,"_5":16596,"_3543":137211,"_34738":137212,"_23429":137213,"_30870":82894},"Integra el cliente EST",[56936,135600,59415,136609,136784],[],{"_4098":82895,"_34307":82894,"_23429":137215,"_5":16198,"_30870":82894,"_3543":137216},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_4098":82896,"_34307":82894,"_5":34735,"_23429":137218,"_30870":137219,"_3543":134178},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_4098":82897,"_34307":82894,"_5":34735,"_23429":137221,"_30870":137222,"_3543":137223},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_4098":82898,"_34307":82894,"_5":34735,"_23429":137225,"_30870":137226,"_3543":137227},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_4098":82899,"_34307":82894,"_5":34735,"_23429":137229,"_30870":137230,"_3543":137231},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_4098":82900,"_34307":82894,"_5":34735,"_23429":137233,"_30870":137234,"_3543":137235},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_4098":82901,"_34307":82894,"_5":34735,"_23429":137237,"_30870":137238,"_3543":137239},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_4098":82902,"_34307":82894,"_23429":137241,"_5":16198,"_30870":82894,"_3543":137242},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_4098":82903,"_34307":82894,"_23429":137244,"_5":16198,"_30870":137219,"_3543":137245},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_4098":82904,"_34307":82894,"_23429":137247,"_5":16198,"_30870":137219,"_3543":137248},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_4098":82905,"_34307":82894,"_23429":137250,"_5":16198,"_30870":137219,"_3543":137251},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_4098":82906,"_34307":82894,"_23429":137253,"_5":16198,"_30870":137222,"_3543":137254},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_4098":82907,"_34307":82894,"_23429":137256,"_5":16198,"_30870":137222,"_3543":137257},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_4098":82908,"_34307":82894,"_23429":137259,"_5":16198,"_30870":137226,"_3543":137260},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_4098":82909,"_34307":82894,"_23429":137262,"_5":16198,"_30870":137226,"_3543":137263},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_4098":82910,"_34307":82894,"_23429":137265,"_5":16198,"_30870":137230,"_3543":137266},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_4098":82911,"_34307":82894,"_23429":137268,"_5":16198,"_30870":137230,"_3543":137269},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_4098":82912,"_34307":82894,"_23429":137271,"_5":16198,"_30870":137234,"_3543":137272},[],"Para el caso de una raíz que emite directamente:",{"_4098":82913,"_34307":82894,"_23429":137274,"_5":16198,"_30870":137234,"_3543":137275},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_4098":82914,"_34307":82894,"_23429":137277,"_5":16198,"_30870":137234,"_3543":137278},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_4098":82915,"_34307":82894,"_23429":137280,"_5":16198,"_30870":137238,"_3543":137281},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_4098":82916,"_34307":82916,"_5":16596,"_3543":137283,"_34738":137284,"_23429":137285,"_30870":82916},"Referencia EST",[56936,135600,59415,136609,136784],[],{"_4098":82917,"_34307":82916,"_23429":137287,"_5":16198,"_30870":82916,"_3543":137288},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_4098":82918,"_34307":82916,"_5":34735,"_23429":137290,"_30870":137291,"_3543":137292},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_4098":82919,"_34307":82916,"_5":34735,"_23429":137294,"_30870":137295,"_3543":25464},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_4098":82920,"_34307":82916,"_5":34735,"_23429":137297,"_30870":137298,"_3543":29201},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_4098":82921,"_34307":82916,"_5":34735,"_23429":137300,"_30870":137301,"_3543":29208},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_4098":82922,"_34307":82916,"_5":34735,"_23429":137303,"_30870":137304,"_3543":28427},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_4098":82923,"_34307":82916,"_5":34735,"_23429":137306,"_30870":137307,"_3543":137308},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_4098":82924,"_34307":82916,"_5":34735,"_23429":137310,"_30870":137311,"_3543":137312},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_4098":82925,"_34307":82916,"_5":34735,"_23429":137314,"_30870":137315,"_3543":137316},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_4098":82926,"_34307":82916,"_23429":137318,"_5":16198,"_30870":82916,"_3543":137319},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_4098":82927,"_34307":82916,"_23429":137321,"_5":16198,"_30870":137291,"_3543":137322},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_4098":82928,"_34307":82916,"_23429":137324,"_5":16198,"_30870":137291,"_3543":135360},[],{"_4098":82929,"_34307":82916,"_23429":137326,"_5":16198,"_30870":137291,"_3543":137327},[],"Método",{"_4098":82930,"_34307":82916,"_23429":137329,"_5":16198,"_30870":137291,"_3543":137330},[],"Autenticación y condición",{"_4098":82931,"_34307":82916,"_23429":137332,"_5":16198,"_30870":137291,"_3543":60177},[],{"_4098":82932,"_34307":82916,"_23429":137334,"_5":16198,"_30870":137291,"_3543":60180},[],{"_4098":82933,"_34307":82916,"_23429":137336,"_5":16198,"_30870":137291,"_3543":137337},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_4098":82934,"_34307":82916,"_23429":137339,"_5":16198,"_30870":137291,"_3543":60186},[],{"_4098":82935,"_34307":82916,"_23429":137341,"_5":16198,"_30870":137291,"_3543":60189},[],{"_4098":82936,"_34307":82916,"_23429":137343,"_5":16198,"_30870":137291,"_3543":137344},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_4098":82937,"_34307":82916,"_23429":137346,"_5":16198,"_30870":137291,"_3543":60195},[],{"_4098":82938,"_34307":82916,"_23429":137348,"_5":16198,"_30870":137291,"_3543":60189},[],{"_4098":82939,"_34307":82916,"_23429":137350,"_5":16198,"_30870":137291,"_3543":137351},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_4098":82940,"_34307":82916,"_23429":137353,"_5":16198,"_30870":137291,"_3543":60203},[],{"_4098":82941,"_34307":82916,"_23429":137355,"_5":16198,"_30870":137291,"_3543":60189},[],{"_4098":82942,"_34307":82916,"_23429":137357,"_5":16198,"_30870":137291,"_3543":137358},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_4098":82943,"_34307":82916,"_23429":137360,"_5":16198,"_30870":137291,"_3543":137361},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_4098":82944,"_34307":82916,"_23429":137363,"_5":16198,"_30870":137295,"_3543":137364},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_4098":82945,"_34307":82916,"_23429":137366,"_5":16198,"_30870":137295,"_3543":137367},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_4098":82946,"_34307":82916,"_23429":137369,"_5":16198,"_30870":137298,"_3543":137370},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_4098":82947,"_34307":82916,"_23429":137372,"_5":16198,"_30870":137298,"_3543":137373},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_4098":82948,"_34307":82916,"_23429":137375,"_5":16198,"_30870":137301,"_3543":137376},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_4098":82949,"_34307":82916,"_23429":137378,"_5":16198,"_30870":137301,"_3543":137379},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_4098":82950,"_34307":82916,"_23429":137381,"_5":16198,"_30870":137304,"_3543":137382},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_4098":82951,"_34307":82916,"_23429":137384,"_5":16198,"_30870":137304,"_3543":137385},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_4098":82952,"_34307":82916,"_23429":137387,"_5":16198,"_30870":137307,"_3543":137388},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_4098":82953,"_34307":82916,"_23429":137390,"_5":16198,"_30870":137307,"_3543":137391},[],"Parte",{"_4098":82954,"_34307":82916,"_23429":137393,"_5":16198,"_30870":137307,"_3543":137394},[],"Contenido tras decodificar su Base64",{"_4098":82955,"_34307":82916,"_23429":137396,"_5":16198,"_30870":137307,"_3543":60247},[],{"_4098":82956,"_34307":82916,"_23429":137398,"_5":16198,"_30870":137307,"_3543":137399},[],"Clave privada PKCS#8 DER sin cifrar.",{"_4098":82957,"_34307":82916,"_23429":137401,"_5":16198,"_30870":137307,"_3543":60253},[],{"_4098":82958,"_34307":82916,"_23429":137403,"_5":16198,"_30870":137307,"_3543":137404},[],"PKCS#7 DER con el certificado emitido.",{"_4098":82959,"_34307":82916,"_23429":137406,"_5":16198,"_30870":137307,"_3543":137407},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_4098":82960,"_34307":82916,"_23429":137409,"_5":16198,"_30870":137311,"_3543":137410},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_4098":82961,"_34307":82916,"_23429":137412,"_5":16198,"_30870":137311,"_3543":137413},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_4098":82962,"_34307":82916,"_23429":137415,"_5":16198,"_30870":137311,"_3543":137416},[],"Convierte y comprueba el resultado:",{"_4098":82963,"_34307":82916,"_23429":137418,"_5":16198,"_30870":137311,"_3543":137419},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_4098":82964,"_34307":82916,"_23429":137421,"_5":16198,"_30870":137315,"_3543":137422},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_4098":82965,"_34307":82916,"_23429":137424,"_5":16198,"_30870":137315,"_3543":137425},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_4098":82966,"_34307":82966,"_5":16596,"_3543":136784,"_34738":137427,"_23429":137428,"_30870":82966},[56936,135600,59415,136609,136784],[],{"_4098":82967,"_34307":82966,"_23429":137430,"_5":16198,"_30870":82966,"_3543":137431},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_4098":82968,"_34307":82966,"_5":34735,"_23429":137433,"_30870":137434,"_3543":137435},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_4098":82969,"_34307":82966,"_5":34735,"_23429":137437,"_30870":137438,"_3543":137439},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_4098":82970,"_34307":82966,"_5":34735,"_23429":137441,"_30870":137442,"_3543":137443},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_4098":82971,"_34307":82966,"_5":34735,"_23429":137445,"_30870":137446,"_3543":137447},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_4098":82972,"_34307":82966,"_23429":137449,"_5":16198,"_30870":82966,"_3543":137450},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_4098":82973,"_34307":82966,"_23429":137452,"_5":16198,"_30870":137434,"_3543":137453},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_4098":82974,"_34307":82966,"_23429":137455,"_5":16198,"_30870":137434,"_3543":137456},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_4098":82975,"_34307":82966,"_23429":137458,"_5":16198,"_30870":137434,"_3543":137459},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_4098":82976,"_34307":82966,"_23429":137461,"_5":16198,"_30870":137434,"_3543":137462},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_4098":82977,"_34307":82966,"_23429":137464,"_5":16198,"_30870":137434,"_3543":137465},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_4098":82978,"_34307":82966,"_23429":137467,"_5":16198,"_30870":137434,"_3543":137468},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_4098":82979,"_34307":82966,"_23429":137470,"_5":16198,"_30870":137438,"_3543":137471},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_4098":82980,"_34307":82966,"_23429":137473,"_5":16198,"_30870":137438,"_3543":137474},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_4098":82981,"_34307":82966,"_23429":137476,"_5":16198,"_30870":137438,"_3543":137477},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_4098":82982,"_34307":82966,"_23429":137479,"_5":16198,"_30870":137438,"_3543":137480},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_4098":82983,"_34307":82966,"_23429":137482,"_5":16198,"_30870":137442,"_3543":137483},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_4098":82984,"_34307":82966,"_23429":137485,"_5":16198,"_30870":137442,"_3543":137486},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_4098":82985,"_34307":82966,"_23429":137488,"_5":16198,"_30870":137442,"_3543":137489},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_4098":82986,"_34307":82966,"_23429":137491,"_5":16198,"_30870":137442,"_3543":137492},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_4098":82987,"_34307":82966,"_23429":137494,"_5":16198,"_30870":137446,"_3543":137495},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_4098":82988,"_34307":82966,"_23429":137497,"_5":16198,"_30870":137446,"_3543":137498},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_4098":82989,"_34307":82989,"_5":16596,"_3543":137500,"_34738":137501,"_23429":137502,"_30870":82989},"Estrategias de aprovisionamiento",[56936,135600,59415,136609,136784],[],{"_4098":82990,"_34307":82989,"_23429":137504,"_5":16198,"_30870":82989,"_3543":137505},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_4098":82991,"_34307":82989,"_5":34735,"_23429":137507,"_30870":137508,"_3543":137509},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_4098":82992,"_34307":82989,"_5":34735,"_23429":137511,"_30870":137512,"_3543":137513},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_4098":82993,"_34307":82989,"_5":34735,"_23429":137515,"_30870":137516,"_3543":137517},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_4098":82994,"_34307":82989,"_5":34735,"_23429":137519,"_30870":137520,"_3543":137521},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_4098":82995,"_34307":82989,"_5":34735,"_23429":137523,"_30870":137524,"_3543":137525},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_4098":82996,"_34307":82989,"_23429":137527,"_5":16198,"_30870":82989,"_3543":137528},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_4098":82997,"_34307":82989,"_23429":137530,"_5":16198,"_30870":137508,"_3543":137531},[],"Recorrido",{"_4098":82998,"_34307":82989,"_23429":137533,"_5":16198,"_30870":137508,"_3543":137534},[],"Cuándo existe el dispositivo",{"_4098":82999,"_34307":82989,"_23429":137536,"_5":16198,"_30870":137508,"_3543":137537},[],"Qué compruebas",{"_4098":83000,"_34307":82989,"_23429":137539,"_5":16198,"_30870":137508,"_3543":137540},[],"Asignación manual",{"_4098":83001,"_34307":82989,"_23429":137542,"_5":16198,"_30870":137508,"_3543":137543},[],"El operador lo crea antes de asociar un certificado.",{"_4098":83002,"_34307":82989,"_23429":137545,"_5":16198,"_30870":137508,"_3543":137546},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_4098":83003,"_34307":82989,"_23429":137548,"_5":16198,"_30870":137508,"_3543":137549},[],"EST con `JITP`",{"_4098":83004,"_34307":82989,"_23429":137551,"_5":16198,"_30870":137508,"_3543":137552},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_4098":83005,"_34307":82989,"_23429":137554,"_5":16198,"_30870":137508,"_3543":137555},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_4098":83006,"_34307":82989,"_23429":137557,"_5":16198,"_30870":137508,"_3543":137558},[],"EST con `PRE_REGISTRATION`",{"_4098":83007,"_34307":82989,"_23429":137560,"_5":16198,"_30870":137508,"_3543":137561},[],"Debe existir antes de `/simpleenroll`.",{"_4098":83008,"_34307":82989,"_23429":137563,"_5":16198,"_30870":137508,"_3543":137564},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_4098":83009,"_34307":82989,"_23429":137566,"_5":16198,"_30870":137508,"_3543":137567},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_4098":83010,"_34307":82989,"_23429":137569,"_5":16198,"_30870":137508,"_3543":137570},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_4098":83011,"_34307":82989,"_23429":137572,"_5":16198,"_30870":137512,"_3543":137573},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_4098":83012,"_34307":82989,"_23429":137575,"_5":16198,"_30870":137512,"_3543":137576},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_4098":83013,"_34307":82989,"_23429":137578,"_5":16198,"_30870":137512,"_3543":137579},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_4098":83014,"_34307":82989,"_23429":137581,"_5":16198,"_30870":137516,"_3543":137582},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_4098":83015,"_34307":82989,"_23429":137584,"_5":16198,"_30870":137516,"_3543":137585},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_4098":83016,"_34307":82989,"_23429":137587,"_5":16198,"_30870":137516,"_3543":137588},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_4098":83017,"_34307":82989,"_23429":137590,"_5":16198,"_30870":137516,"_3543":137591},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_4098":83018,"_34307":82989,"_23429":137593,"_5":16198,"_30870":137516,"_3543":137594},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_4098":83019,"_34307":82989,"_23429":137596,"_5":16198,"_30870":137516,"_3543":137597},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_4098":83020,"_34307":82989,"_23429":137599,"_5":16198,"_30870":137520,"_3543":134542},[],{"_4098":83021,"_34307":82989,"_23429":137601,"_5":16198,"_30870":137520,"_3543":137602},[],"Material que atraviesa EST",{"_4098":83022,"_34307":82989,"_23429":137604,"_5":16198,"_30870":137520,"_3543":137605},[],"Clave generada por el dispositivo",{"_4098":83023,"_34307":82989,"_23429":137607,"_5":16198,"_30870":137520,"_3543":137608},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_4098":83024,"_34307":82989,"_23429":137610,"_5":16198,"_30870":137520,"_3543":137611},[],"Clave ya disponible en el dispositivo",{"_4098":83025,"_34307":82989,"_23429":137613,"_5":16198,"_30870":137520,"_3543":137614},[],"CSR firmada con la clave existente y certificado nuevo.",{"_4098":83026,"_34307":82989,"_23429":137616,"_5":16198,"_30870":137520,"_3543":59734},[],{"_4098":83027,"_34307":82989,"_23429":137618,"_5":16198,"_30870":137520,"_3543":137619},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_4098":83028,"_34307":82989,"_23429":137621,"_5":16198,"_30870":137520,"_3543":137622},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_4098":83029,"_34307":82989,"_23429":137624,"_5":16198,"_30870":137524,"_3543":137625},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_4098":83030,"_34307":83030,"_5":16596,"_3543":137627,"_34738":137628,"_23429":137629,"_30870":83030},"Renovación y recuperación",[56936,135600,59415,136609,136784],[],{"_4098":83031,"_34307":83030,"_23429":137631,"_5":16198,"_30870":83030,"_3543":137632},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_4098":83032,"_34307":83030,"_5":34735,"_23429":137634,"_30870":137635,"_3543":137636},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_4098":83033,"_34307":83030,"_5":34735,"_23429":137638,"_30870":137639,"_3543":137640},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_4098":83034,"_34307":83030,"_5":34735,"_23429":137642,"_30870":137643,"_3543":137644},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_4098":83035,"_34307":83030,"_5":34735,"_23429":137646,"_30870":137647,"_3543":137648},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_4098":83036,"_34307":83030,"_5":34735,"_23429":137650,"_30870":137651,"_3543":137652},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_4098":83037,"_34307":83030,"_23429":137654,"_5":16198,"_30870":83030,"_3543":137655},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_4098":83038,"_34307":83030,"_23429":137657,"_5":16198,"_30870":137635,"_3543":137658},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_4098":83039,"_34307":83030,"_23429":137660,"_5":16198,"_30870":137635,"_3543":137661},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_4098":83040,"_34307":83030,"_23429":137663,"_5":16198,"_30870":137635,"_3543":137664},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_4098":83041,"_34307":83030,"_23429":137666,"_5":16198,"_30870":137635,"_3543":137667},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_4098":83042,"_34307":83030,"_23429":137669,"_5":16198,"_30870":137639,"_3543":137670},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_4098":83043,"_34307":83030,"_23429":137672,"_5":16198,"_30870":137639,"_3543":137673},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_4098":83044,"_34307":83030,"_23429":137675,"_5":16198,"_30870":137643,"_3543":137676},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_4098":83045,"_34307":83030,"_23429":137678,"_5":16198,"_30870":137643,"_3543":137679},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_4098":83046,"_34307":83030,"_23429":137681,"_5":16198,"_30870":137643,"_3543":137682},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_4098":83047,"_34307":83030,"_23429":137684,"_5":16198,"_30870":137647,"_3543":137685},[],"Situación",{"_4098":83048,"_34307":83030,"_23429":137687,"_5":16198,"_30870":137647,"_3543":137688},[],"Procedimiento",{"_4098":83049,"_34307":83030,"_23429":137690,"_5":16198,"_30870":137647,"_3543":137691},[],"Certificado vigente, fuera de ventana",{"_4098":83050,"_34307":83030,"_23429":137693,"_5":16198,"_30870":137647,"_3543":137694},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_4098":83051,"_34307":83030,"_23429":137696,"_5":16198,"_30870":137647,"_3543":137697},[],"Certificado vencido, clave disponible",{"_4098":83052,"_34307":83030,"_23429":137699,"_5":16198,"_30870":137647,"_3543":137700},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_4098":83053,"_34307":83030,"_23429":137702,"_5":16198,"_30870":137647,"_3543":137703},[],"Renovación por webhook o `NO_AUTH`",{"_4098":83054,"_34307":83030,"_23429":137705,"_5":16198,"_30870":137647,"_3543":137706},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_4098":83055,"_34307":83030,"_23429":137708,"_5":16198,"_30870":137647,"_3543":137709},[],"Clave perdida o inaccesible",{"_4098":83056,"_34307":83030,"_23429":137711,"_5":16198,"_30870":137647,"_3543":137712},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_4098":83057,"_34307":83030,"_23429":137714,"_5":16198,"_30870":137647,"_3543":137715},[],"Identidad actual revocada",{"_4098":83058,"_34307":83030,"_23429":137717,"_5":16198,"_30870":137647,"_3543":137718},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_4098":83059,"_34307":83030,"_23429":137720,"_5":16198,"_30870":137647,"_3543":137721},[],"Dispositivo sin identidad",{"_4098":83060,"_34307":83030,"_23429":137723,"_5":16198,"_30870":137647,"_3543":137724},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_4098":83061,"_34307":83030,"_23429":137726,"_5":16198,"_30870":137647,"_3543":137727},[],"Dispositivo retirado",{"_4098":83062,"_34307":83030,"_23429":137729,"_5":16198,"_30870":137647,"_3543":137730},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_4098":83063,"_34307":83030,"_23429":137732,"_5":16198,"_30870":137647,"_3543":137733},[],"Timeout, HTTP 500 o fallo de instalación",{"_4098":83064,"_34307":83030,"_23429":137735,"_5":16198,"_30870":137647,"_3543":137736},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_4098":83065,"_34307":83030,"_23429":137738,"_5":16198,"_30870":137651,"_3543":137739},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_4098":83066,"_34307":83030,"_23429":137741,"_5":16198,"_30870":137651,"_3543":137742},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_4098":83067,"_34307":83067,"_5":16596,"_3543":137744,"_34738":137745,"_23429":137746,"_30870":83067},"Diagnóstico de enrolamiento",[56936,135600,59415,136609,136784],[],{"_4098":83068,"_34307":83067,"_23429":137748,"_5":16198,"_30870":83067,"_3543":137749},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_4098":83069,"_34307":83067,"_5":34735,"_23429":137751,"_30870":137752,"_3543":137753},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_4098":83070,"_34307":83067,"_5":34735,"_23429":137755,"_30870":137756,"_3543":137757},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_4098":83071,"_34307":83067,"_5":34735,"_23429":137759,"_30870":137760,"_3543":137316},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_4098":83072,"_34307":83067,"_5":34735,"_23429":137762,"_30870":137763,"_3543":137764},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_4098":83073,"_34307":83067,"_23429":137766,"_5":16198,"_30870":83067,"_3543":137767},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_4098":83074,"_34307":83067,"_23429":137769,"_5":16198,"_30870":137756,"_3543":137770},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_4098":83075,"_34307":83067,"_23429":137772,"_5":16198,"_30870":137756,"_3543":137773},[],"Síntoma o mensaje",{"_4098":83076,"_34307":83067,"_23429":137775,"_5":16198,"_30870":137756,"_3543":137776},[],"Qué revisar",{"_4098":83077,"_34307":83067,"_23429":137778,"_5":16198,"_30870":137756,"_3543":137779},[],"curl rechaza TLS, nombre o emisor",{"_4098":83078,"_34307":83067,"_23429":137781,"_5":16198,"_30870":137756,"_3543":137782},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_4098":83079,"_34307":83067,"_23429":137784,"_5":16198,"_30870":137756,"_3543":137785},[],"404 o APS ausente",{"_4098":83080,"_34307":83067,"_23429":137787,"_5":16198,"_30870":137756,"_3543":137788},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_4098":83081,"_34307":83067,"_23429":137790,"_5":16198,"_30870":137756,"_3543":137791},[],"400, error de CSR o formato",{"_4098":83082,"_34307":83067,"_23429":137793,"_5":16198,"_30870":137756,"_3543":137794},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_4098":83083,"_34307":83067,"_23429":137796,"_5":16198,"_30870":137756,"_3543":137797},[],"Credencial ausente o certificado no válido",{"_4098":83084,"_34307":83067,"_23429":137799,"_5":16198,"_30870":137756,"_3543":137800},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_4098":83085,"_34307":83067,"_23429":137802,"_5":16198,"_30870":137756,"_3543":137803},[],"Webhook deniega, expira o responde sin autorización",{"_4098":83086,"_34307":83067,"_23429":137805,"_5":16198,"_30870":137756,"_3543":137806},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_4098":83087,"_34307":83067,"_23429":137808,"_5":16198,"_30870":137756,"_3543":60660},[],{"_4098":83088,"_34307":83067,"_23429":137810,"_5":16198,"_30870":137756,"_3543":137811},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_4098":83089,"_34307":83067,"_23429":137813,"_5":16198,"_30870":137756,"_3543":60666},[],{"_4098":83090,"_34307":83067,"_23429":137815,"_5":16198,"_30870":137756,"_3543":137816},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_4098":83091,"_34307":83067,"_23429":137818,"_5":16198,"_30870":137756,"_3543":60672},[],{"_4098":83092,"_34307":83067,"_23429":137820,"_5":16198,"_30870":137756,"_3543":137821},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_4098":83093,"_34307":83067,"_23429":137823,"_5":16198,"_30870":137756,"_3543":60678},[],{"_4098":83094,"_34307":83067,"_23429":137825,"_5":16198,"_30870":137756,"_3543":137826},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_4098":83095,"_34307":83067,"_23429":137828,"_5":16198,"_30870":137756,"_3543":60684},[],{"_4098":83096,"_34307":83067,"_23429":137830,"_5":16198,"_30870":137756,"_3543":137831},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_4098":83097,"_34307":83067,"_23429":137833,"_5":16198,"_30870":137756,"_3543":137834},[],"400 `struct validation error` al crear o actualizar un DMS",{"_4098":83098,"_34307":83067,"_23429":137836,"_5":16198,"_30870":137756,"_3543":137837},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_4098":83099,"_34307":83067,"_23429":137839,"_5":16198,"_30870":137756,"_3543":137840},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_4098":83100,"_34307":83067,"_23429":137842,"_5":16198,"_30870":137756,"_3543":137843},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_4098":83101,"_34307":83067,"_23429":137845,"_5":16198,"_30870":137756,"_3543":60702},[],{"_4098":83102,"_34307":83067,"_23429":137847,"_5":16198,"_30870":137756,"_3543":137848},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_4098":83103,"_34307":83067,"_23429":137850,"_5":16198,"_30870":137756,"_3543":60708},[],{"_4098":83104,"_34307":83067,"_23429":137852,"_5":16198,"_30870":137756,"_3543":137853},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_4098":83105,"_34307":83067,"_23429":137855,"_5":16198,"_30870":137756,"_3543":137856},[],"DMS propietario distinto",{"_4098":83106,"_34307":83067,"_23429":137858,"_5":16198,"_30870":137756,"_3543":137859},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_4098":83107,"_34307":83067,"_23429":137861,"_5":16198,"_30870":137756,"_3543":60720},[],{"_4098":83108,"_34307":83067,"_23429":137863,"_5":16198,"_30870":137756,"_3543":137864},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_4098":83109,"_34307":83067,"_23429":137866,"_5":16198,"_30870":137756,"_3543":60726},[],{"_4098":83110,"_34307":83067,"_23429":137868,"_5":16198,"_30870":137756,"_3543":137869},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_4098":83111,"_34307":83067,"_23429":137871,"_5":16198,"_30870":137756,"_3543":137872},[],"Certificado actual revocado",{"_4098":83112,"_34307":83067,"_23429":137874,"_5":16198,"_30870":137756,"_3543":137875},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_4098":83113,"_34307":83067,"_23429":137877,"_5":16198,"_30870":137756,"_3543":137878},[],"Error de CA, perfil o firma",{"_4098":83114,"_34307":83067,"_23429":137880,"_5":16198,"_30870":137756,"_3543":137881},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_4098":83115,"_34307":83067,"_23429":137883,"_5":16198,"_30870":137756,"_3543":137884},[],"HTTP 200 sin conexión del dispositivo",{"_4098":83116,"_34307":83067,"_23429":137886,"_5":16198,"_30870":137756,"_3543":137887},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_4098":83117,"_34307":83067,"_23429":137889,"_5":16198,"_30870":137756,"_3543":137890},[],"Timeout o error después de emitir",{"_4098":83118,"_34307":83067,"_23429":137892,"_5":16198,"_30870":137756,"_3543":137893},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_4098":83119,"_34307":83067,"_23429":137895,"_5":16198,"_30870":137760,"_3543":137896},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_4098":83120,"_34307":83067,"_23429":137898,"_5":16198,"_30870":137760,"_3543":137899},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_4098":83121,"_34307":83067,"_23429":137901,"_5":16198,"_30870":137763,"_3543":137902},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_4098":83122,"_34307":83067,"_23429":137904,"_5":16198,"_30870":137763,"_3543":137905},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_4098":83123,"_34307":83067,"_23429":137907,"_5":16198,"_30870":137763,"_3543":137908},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_4098":83124,"_34307":83067,"_23429":137910,"_5":16198,"_30870":137763,"_3543":137911},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_4098":83125,"_34307":83067,"_23429":137913,"_5":16198,"_30870":137763,"_3543":137914},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_4098":83126,"_34307":83067,"_23429":137916,"_5":16198,"_30870":137763,"_3543":137917},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_4098":83127,"_34307":83067,"_23429":137919,"_5":16198,"_30870":137763,"_3543":137920},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_4098":83128,"_34307":83128,"_5":16596,"_3543":137922,"_34738":137923,"_23429":137924,"_30870":83128},"Distribución y actualización de confianza",[56936,135600,59415,136609,136784],[],{"_4098":83129,"_34307":83128,"_23429":137926,"_5":16198,"_30870":83128,"_3543":137927},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_4098":83130,"_34307":83128,"_5":34735,"_23429":137929,"_30870":137930,"_3543":137931},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_4098":83131,"_34307":83128,"_5":34735,"_23429":137933,"_30870":137934,"_3543":137935},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_4098":83132,"_34307":83128,"_5":34735,"_23429":137937,"_30870":137938,"_3543":137939},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_4098":83133,"_34307":83128,"_5":34735,"_23429":137941,"_30870":137942,"_3543":137943},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_4098":83134,"_34307":83128,"_5":34735,"_23429":137945,"_30870":137946,"_3543":137947},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_4098":83135,"_34307":83128,"_23429":137949,"_5":16198,"_30870":83128,"_3543":137950},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_4098":83136,"_34307":83128,"_23429":137952,"_5":16198,"_30870":137930,"_3543":137953},[],"Relación",{"_4098":83137,"_34307":83128,"_23429":137955,"_5":16198,"_30870":137930,"_3543":137956},[],"Material que prepara el responsable",{"_4098":83138,"_34307":83128,"_23429":137958,"_5":16198,"_30870":137930,"_3543":137959},[],"Dispositivo → servidor EST",{"_4098":83139,"_34307":83128,"_23429":137961,"_5":16198,"_30870":137930,"_3543":137962},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_4098":83140,"_34307":83128,"_23429":137964,"_5":16198,"_30870":137930,"_3543":137965},[],"DMS → solicitante",{"_4098":83141,"_34307":83128,"_23429":137967,"_5":16198,"_30870":137930,"_3543":137968},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_4098":83142,"_34307":83128,"_23429":137970,"_5":16198,"_30870":137930,"_3543":137971},[],"Consumidor → dispositivo",{"_4098":83143,"_34307":83128,"_23429":137973,"_5":16198,"_30870":137930,"_3543":137974},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_4098":83144,"_34307":83128,"_23429":137976,"_5":16198,"_30870":137930,"_3543":137977},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_4098":83145,"_34307":83128,"_23429":137979,"_5":16198,"_30870":137934,"_3543":137980},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_4098":83146,"_34307":83128,"_23429":137982,"_5":16198,"_30870":137934,"_3543":137983},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_4098":83147,"_34307":83128,"_23429":137985,"_5":16198,"_30870":137938,"_3543":137986},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_4098":83148,"_34307":83128,"_23429":137988,"_5":16198,"_30870":137938,"_3543":137989},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_4098":83149,"_34307":83128,"_23429":137991,"_5":16198,"_30870":137938,"_3543":137992},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_4098":83150,"_34307":83128,"_23429":137994,"_5":16198,"_30870":137938,"_3543":137995},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_4098":83151,"_34307":83128,"_23429":137997,"_5":16198,"_30870":137938,"_3543":137998},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_4098":83152,"_34307":83128,"_23429":138000,"_5":16198,"_30870":137938,"_3543":138001},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_4098":83153,"_34307":83128,"_23429":138003,"_5":16198,"_30870":137942,"_3543":138004},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_4098":83154,"_34307":83128,"_23429":138006,"_5":16198,"_30870":137942,"_3543":138007},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_4098":83155,"_34307":83128,"_23429":138009,"_5":16198,"_30870":137942,"_3543":138010},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_4098":83156,"_34307":83128,"_23429":138012,"_5":16198,"_30870":137946,"_3543":138013},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_4098":83157,"_34307":83157,"_5":16596,"_3543":60875,"_34738":138015,"_23429":138017,"_30870":83157},[56936,135600,59415,136609,138016],"Integraciones",[],{"_4098":83158,"_34307":83157,"_23429":138019,"_5":16198,"_30870":83157,"_3543":138020},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_4098":83159,"_34307":83157,"_5":34735,"_23429":138022,"_30870":138023,"_3543":138024},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_4098":83160,"_34307":83157,"_5":34735,"_23429":138026,"_30870":138027,"_3543":138028},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_4098":83161,"_34307":83157,"_5":34735,"_23429":138030,"_30870":138031,"_3543":138032},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_4098":83162,"_34307":83157,"_5":34735,"_23429":138034,"_30870":138035,"_3543":138036},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_4098":83163,"_34307":83157,"_5":34735,"_23429":138038,"_30870":138039,"_3543":138040},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_4098":83164,"_34307":83157,"_5":34735,"_23429":138042,"_30870":138043,"_3543":138044},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_4098":83165,"_34307":83157,"_5":34735,"_23429":138046,"_30870":138047,"_3543":138048},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_4098":83166,"_34307":83157,"_5":34735,"_23429":138050,"_30870":138051,"_3543":138052},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_4098":83167,"_34307":83157,"_5":34735,"_23429":138054,"_30870":138055,"_3543":60917},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_4098":83168,"_34307":83157,"_5":34735,"_23429":138057,"_30870":138058,"_3543":60921},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_4098":83169,"_34307":83157,"_5":34735,"_23429":138060,"_30870":138061,"_3543":138062},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_4098":83170,"_34307":83157,"_5":34735,"_23429":138064,"_30870":138065,"_3543":138066},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_4098":83171,"_34307":83157,"_5":34735,"_23429":138068,"_30870":138069,"_3543":138070},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_4098":83172,"_34307":83157,"_5":34735,"_23429":138072,"_30870":138073,"_3543":138074},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_4098":83173,"_34307":83157,"_5":34735,"_23429":138076,"_30870":138077,"_3543":138078},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_4098":83174,"_34307":83157,"_5":34735,"_23429":138080,"_30870":138081,"_3543":138082},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_4098":83175,"_34307":83157,"_5":34735,"_23429":138084,"_30870":138085,"_3543":138086},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_4098":83176,"_34307":83157,"_5":34735,"_23429":138088,"_30870":138089,"_3543":138090},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_4098":83177,"_34307":83157,"_5":34735,"_23429":138092,"_30870":138093,"_3543":138094},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_4098":83178,"_34307":83157,"_5":34735,"_23429":138096,"_30870":138097,"_3543":138098},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_4098":83179,"_34307":83157,"_5":34735,"_23429":138100,"_30870":138101,"_3543":138102},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_4098":83180,"_34307":83157,"_5":34735,"_23429":138104,"_30870":138105,"_3543":138106},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_4098":83181,"_34307":83157,"_5":34735,"_23429":138108,"_30870":138109,"_3543":138110},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_4098":83182,"_34307":83157,"_5":34735,"_23429":138112,"_30870":138113,"_3543":138114},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_4098":83183,"_34307":83157,"_5":34735,"_23429":138116,"_30870":138117,"_3543":138118},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_4098":83184,"_34307":83157,"_23429":138120,"_5":16198,"_30870":83157,"_3543":138121},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_4098":83185,"_34307":83157,"_23429":138123,"_5":16198,"_30870":83157,"_3543":138124},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_4098":83186,"_34307":83157,"_23429":138126,"_5":16198,"_30870":83157,"_3543":138127},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_4098":83187,"_34307":83157,"_23429":138129,"_5":16198,"_30870":138023,"_3543":138130},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_4098":83188,"_34307":83157,"_23429":138132,"_5":16198,"_30870":138023,"_3543":138133},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_4098":83189,"_34307":83157,"_23429":138135,"_5":16198,"_30870":138023,"_3543":138136},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_4098":83190,"_34307":83157,"_23429":138138,"_5":16198,"_30870":138023,"_3543":138139},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_4098":83191,"_34307":83157,"_23429":138141,"_5":16198,"_30870":138027,"_3543":138142},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_4098":83192,"_34307":83157,"_23429":138144,"_5":16198,"_30870":138031,"_3543":138145},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_4098":83193,"_34307":83157,"_23429":138147,"_5":16198,"_30870":138031,"_3543":138148},[],"Acción IAM",{"_4098":83194,"_34307":83157,"_23429":138150,"_5":16198,"_30870":138031,"_3543":134548},[],{"_4098":83195,"_34307":83157,"_23429":138152,"_5":16198,"_30870":138031,"_3543":61016},[],{"_4098":83196,"_34307":83157,"_23429":138154,"_5":16198,"_30870":138031,"_3543":138155},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_4098":83197,"_34307":83157,"_23429":138157,"_5":16198,"_30870":138031,"_3543":61022},[],{"_4098":83198,"_34307":83157,"_23429":138159,"_5":16198,"_30870":138031,"_3543":138160},[],"Registrar la CA en AWS IoT",{"_4098":83199,"_34307":83157,"_23429":138162,"_5":16198,"_30870":138031,"_3543":61028},[],{"_4098":83200,"_34307":83157,"_23429":138164,"_5":16198,"_30870":138031,"_3543":138165},[],"Consultar el estado del registro de la CA",{"_4098":83201,"_34307":83157,"_23429":138167,"_5":16198,"_30870":138031,"_3543":61034},[],{"_4098":83202,"_34307":83157,"_23429":138169,"_5":16198,"_30870":138031,"_3543":138170},[],"Crear o actualizar Things en IoT Core",{"_4098":83203,"_34307":83157,"_23429":138172,"_5":16198,"_30870":138031,"_3543":61040},[],{"_4098":83204,"_34307":83157,"_23429":138174,"_5":16198,"_30870":138031,"_3543":138175},[],"Aprovisionar Things mediante plantilla",{"_4098":83205,"_34307":83157,"_23429":138177,"_5":16198,"_30870":138031,"_3543":61046},[],{"_4098":83206,"_34307":83157,"_23429":138179,"_5":16198,"_30870":138031,"_3543":138180},[],"Registrar certificados de dispositivo",{"_4098":83207,"_34307":83157,"_23429":138182,"_5":16198,"_30870":138031,"_3543":61052},[],{"_4098":83208,"_34307":83157,"_23429":138184,"_5":16198,"_30870":138031,"_3543":138185},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_4098":83209,"_34307":83157,"_23429":138187,"_5":16198,"_30870":138031,"_3543":61058},[],{"_4098":83210,"_34307":83157,"_23429":138189,"_5":16198,"_30870":138031,"_3543":138190},[],"Crear y adjuntar políticas IoT",{"_4098":83211,"_34307":83157,"_23429":138192,"_5":16198,"_30870":138031,"_3543":61064},[],{"_4098":83212,"_34307":83157,"_23429":138194,"_5":16198,"_30870":138031,"_3543":138195},[],"Gestionar grupos de Things",{"_4098":83213,"_34307":83157,"_23429":138197,"_5":16198,"_30870":138031,"_3543":61070},[],{"_4098":83214,"_34307":83157,"_23429":138199,"_5":16198,"_30870":138031,"_3543":138200},[],"Crear plantillas JITP",{"_4098":83215,"_34307":83157,"_23429":138202,"_5":16198,"_30870":138031,"_3543":61076},[],{"_4098":83216,"_34307":83157,"_23429":138204,"_5":16198,"_30870":138031,"_3543":138205},[],"Leer y escribir el Device Shadow",{"_4098":83217,"_34307":83157,"_23429":138207,"_5":16198,"_30870":138031,"_3543":138208},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_4098":83218,"_34307":83157,"_23429":138210,"_5":16198,"_30870":138035,"_3543":138211},[],"Parámetro",{"_4098":83219,"_34307":83157,"_23429":138213,"_5":16198,"_30870":138035,"_3543":138214},[],"Tipo",{"_4098":83220,"_34307":83157,"_23429":138216,"_5":16198,"_30870":138035,"_3543":138217},[],"Requerido",{"_4098":83221,"_34307":83157,"_23429":138219,"_5":16198,"_30870":138035,"_3543":138220},[],"Descripción",{"_4098":83222,"_34307":83157,"_23429":138222,"_5":16198,"_30870":138035,"_3543":61097},[],{"_4098":83223,"_34307":83157,"_23429":138224,"_5":16198,"_30870":138035,"_3543":28013},[],{"_4098":83224,"_34307":83157,"_23429":138226,"_5":16198,"_30870":138035,"_3543":138227},[],"Sí",{"_4098":83225,"_34307":83157,"_23429":138229,"_5":16198,"_30870":138035,"_3543":138230},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_4098":83226,"_34307":83157,"_23429":138232,"_5":16198,"_30870":138035,"_3543":61108},[],{"_4098":83227,"_34307":83157,"_23429":138234,"_5":16198,"_30870":138035,"_3543":28013},[],{"_4098":83228,"_34307":83157,"_23429":138236,"_5":16198,"_30870":138035,"_3543":138227},[],{"_4098":83229,"_34307":83157,"_23429":138238,"_5":16198,"_30870":138035,"_3543":138239},[],"Región AWS donde opera el conector.",{"_4098":83230,"_34307":83157,"_23429":138241,"_5":16198,"_30870":138035,"_3543":61118},[],{"_4098":83231,"_34307":83157,"_23429":138243,"_5":16198,"_30870":138035,"_3543":28013},[],{"_4098":83232,"_34307":83157,"_23429":138245,"_5":16198,"_30870":138035,"_3543":138227},[],{"_4098":83233,"_34307":83157,"_23429":138247,"_5":16198,"_30870":138035,"_3543":138248},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_4098":83234,"_34307":83157,"_23429":138250,"_5":16198,"_30870":138035,"_3543":61128},[],{"_4098":83235,"_34307":83157,"_23429":138252,"_5":16198,"_30870":138035,"_3543":28013},[],{"_4098":83236,"_34307":83157,"_23429":138254,"_5":16198,"_30870":138035,"_3543":138255},[],"Solo con `auth_method=static`",{"_4098":83237,"_34307":83157,"_23429":138257,"_5":16198,"_30870":138035,"_3543":138258},[],"Clave de acceso AWS.",{"_4098":83238,"_34307":83157,"_23429":138260,"_5":16198,"_30870":138035,"_3543":61139},[],{"_4098":83239,"_34307":83157,"_23429":138262,"_5":16198,"_30870":138035,"_3543":28013},[],{"_4098":83240,"_34307":83157,"_23429":138264,"_5":16198,"_30870":138035,"_3543":138255},[],{"_4098":83241,"_34307":83157,"_23429":138266,"_5":16198,"_30870":138035,"_3543":138267},[],"Clave secreta AWS.",{"_4098":83242,"_34307":83157,"_23429":138269,"_5":16198,"_30870":138035,"_3543":61149},[],{"_4098":83243,"_34307":83157,"_23429":138271,"_5":16198,"_30870":138035,"_3543":28013},[],{"_4098":83244,"_34307":83157,"_23429":138273,"_5":16198,"_30870":138035,"_3543":61154},[],{"_4098":83245,"_34307":83157,"_23429":138275,"_5":16198,"_30870":138035,"_3543":138276},[],"Token de sesión (con `auth_method=static`).",{"_4098":83246,"_34307":83157,"_23429":138278,"_5":16198,"_30870":138035,"_3543":61160},[],{"_4098":83247,"_34307":83157,"_23429":138280,"_5":16198,"_30870":138035,"_3543":28013},[],{"_4098":83248,"_34307":83157,"_23429":138282,"_5":16198,"_30870":138035,"_3543":138283},[],"Solo con `auth_method=role`",{"_4098":83249,"_34307":83157,"_23429":138285,"_5":16198,"_30870":138035,"_3543":138286},[],"ARN del rol a asumir.",{"_4098":83250,"_34307":83157,"_23429":138288,"_5":16198,"_30870":138035,"_3543":61171},[],{"_4098":83251,"_34307":83157,"_23429":138290,"_5":16198,"_30870":138035,"_3543":28013},[],{"_4098":83252,"_34307":83157,"_23429":138292,"_5":16198,"_30870":138035,"_3543":61154},[],{"_4098":83253,"_34307":83157,"_23429":138294,"_5":16198,"_30870":138035,"_3543":138295},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_4098":83254,"_34307":83157,"_23429":138297,"_5":16198,"_30870":138035,"_3543":61181},[],{"_4098":83255,"_34307":83157,"_23429":138299,"_5":16198,"_30870":138035,"_3543":103291},[],{"_4098":83256,"_34307":83157,"_23429":138301,"_5":16198,"_30870":138035,"_3543":138227},[],{"_4098":83257,"_34307":83157,"_23429":138303,"_5":16198,"_30870":138035,"_3543":138304},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_4098":83258,"_34307":83157,"_23429":138306,"_5":16198,"_30870":138035,"_3543":61191},[],{"_4098":83259,"_34307":83157,"_23429":138308,"_5":16198,"_30870":138035,"_3543":28013},[],{"_4098":83260,"_34307":83157,"_23429":138310,"_5":16198,"_30870":138035,"_3543":138227},[],{"_4098":83261,"_34307":83157,"_23429":138312,"_5":16198,"_30870":138035,"_3543":138313},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_4098":83262,"_34307":83157,"_23429":138315,"_5":16198,"_30870":138035,"_3543":61201},[],{"_4098":83263,"_34307":83157,"_23429":138317,"_5":16198,"_30870":138035,"_3543":28013},[],{"_4098":83264,"_34307":83157,"_23429":138319,"_5":16198,"_30870":138035,"_3543":138227},[],{"_4098":83265,"_34307":83157,"_23429":138321,"_5":16198,"_30870":138035,"_3543":138322},[],"URL HTTP del Device Manager de Lamassu.",{"_4098":83266,"_34307":83157,"_23429":138324,"_5":16198,"_30870":138035,"_3543":61211},[],{"_4098":83267,"_34307":83157,"_23429":138326,"_5":16198,"_30870":138035,"_3543":28013},[],{"_4098":83268,"_34307":83157,"_23429":138328,"_5":16198,"_30870":138035,"_3543":138227},[],{"_4098":83269,"_34307":83157,"_23429":138330,"_5":16198,"_30870":138035,"_3543":138331},[],"URL HTTP del servicio de CA de Lamassu.",{"_4098":83270,"_34307":83157,"_23429":138333,"_5":16198,"_30870":138039,"_3543":138334},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_4098":83271,"_34307":83157,"_23429":138336,"_5":16198,"_30870":138039,"_3543":138337},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_4098":83272,"_34307":83157,"_23429":138339,"_5":16198,"_30870":138039,"_3543":138340},[],"Tipo de CloudEvent",{"_4098":83273,"_34307":83157,"_23429":138342,"_5":16198,"_30870":138039,"_3543":138343},[],"Recurso en Lamassu",{"_4098":83274,"_34307":83157,"_23429":138345,"_5":16198,"_30870":138039,"_3543":138346},[],"Recurso AWS",{"_4098":83275,"_34307":83157,"_23429":138348,"_5":16198,"_30870":138039,"_3543":138349},[],"Acciones IAM",{"_4098":83276,"_34307":83157,"_23429":138351,"_5":16198,"_30870":138039,"_3543":138352},[],"Llamadas AWS y efecto",{"_4098":83277,"_34307":83157,"_23429":138354,"_5":16198,"_30870":138039,"_3543":138355},[],"Dónde en esta página",{"_4098":83278,"_34307":83157,"_23429":138357,"_5":16198,"_30870":138039,"_3543":61245},[],{"_4098":83279,"_34307":83157,"_23429":138359,"_5":16198,"_30870":138039,"_3543":61248},[],{"_4098":83280,"_34307":83157,"_23429":138361,"_5":16198,"_30870":138039,"_3543":61251},[],{"_4098":83281,"_34307":83157,"_23429":138363,"_5":16198,"_30870":138039,"_3543":61254},[],{"_4098":83282,"_34307":83157,"_23429":138365,"_5":16198,"_30870":138039,"_3543":138366},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_4098":83283,"_34307":83157,"_23429":138368,"_5":16198,"_30870":138039,"_3543":138052},[],{"_4098":83284,"_34307":83157,"_23429":138370,"_5":16198,"_30870":138039,"_3543":61262},[],{"_4098":83285,"_34307":83157,"_23429":138372,"_5":16198,"_30870":138039,"_3543":61265},[],{"_4098":83286,"_34307":83157,"_23429":138374,"_5":16198,"_30870":138039,"_3543":61268},[],{"_4098":83287,"_34307":83157,"_23429":138376,"_5":16198,"_30870":138039,"_3543":61271},[],{"_4098":83288,"_34307":83157,"_23429":138378,"_5":16198,"_30870":138039,"_3543":138379},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_4098":83289,"_34307":83157,"_23429":138381,"_5":16198,"_30870":138039,"_3543":138078},[],{"_4098":83290,"_34307":83157,"_23429":138383,"_5":16198,"_30870":138039,"_3543":61279},[],{"_4098":83291,"_34307":83157,"_23429":138385,"_5":16198,"_30870":138039,"_3543":138386},[],"Dispositivo",{"_4098":83292,"_34307":83157,"_23429":138388,"_5":16198,"_30870":138039,"_3543":61285},[],{"_4098":83293,"_34307":83157,"_23429":138390,"_5":16198,"_30870":138039,"_3543":61288},[],{"_4098":83294,"_34307":83157,"_23429":138392,"_5":16198,"_30870":138039,"_3543":138393},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_4098":83295,"_34307":83157,"_23429":138395,"_5":16198,"_30870":138039,"_3543":138086},[],{"_4098":83296,"_34307":83157,"_23429":138397,"_5":16198,"_30870":138039,"_3543":61296},[],{"_4098":83297,"_34307":83157,"_23429":138399,"_5":16198,"_30870":138039,"_3543":138400},[],"Certificado",{"_4098":83298,"_34307":83157,"_23429":138402,"_5":16198,"_30870":138039,"_3543":61302},[],{"_4098":83299,"_34307":83157,"_23429":138404,"_5":16198,"_30870":138039,"_3543":138405},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_4098":83300,"_34307":83157,"_23429":138407,"_5":16198,"_30870":138039,"_3543":138408},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_4098":83301,"_34307":83157,"_23429":138410,"_5":16198,"_30870":138039,"_3543":138098},[],{"_4098":83302,"_34307":83157,"_23429":138412,"_5":16198,"_30870":138039,"_3543":61313},[],{"_4098":83303,"_34307":83157,"_23429":138414,"_5":16198,"_30870":138039,"_3543":138415},[],"Certificado / Dispositivo",{"_4098":83304,"_34307":83157,"_23429":138417,"_5":16198,"_30870":138039,"_3543":61319},[],{"_4098":83305,"_34307":83157,"_23429":138419,"_5":16198,"_30870":138039,"_3543":57332},[],{"_4098":83306,"_34307":83157,"_23429":138421,"_5":16198,"_30870":138039,"_3543":138422},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_4098":83307,"_34307":83157,"_23429":138424,"_5":16198,"_30870":138039,"_3543":138106},[],{"_4098":83308,"_34307":83157,"_23429":138426,"_5":16198,"_30870":138043,"_3543":138427},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_4098":83309,"_34307":83157,"_23429":138429,"_5":16198,"_30870":138047,"_3543":138430},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_4098":83310,"_34307":83157,"_23429":138432,"_5":16198,"_30870":138047,"_3543":138433},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_4098":83311,"_34307":83157,"_23429":138435,"_5":16198,"_30870":138051,"_3543":138436},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_4098":83312,"_34307":83157,"_23429":138438,"_5":16198,"_30870":138051,"_3543":138439},[],"Transición",{"_4098":83313,"_34307":83157,"_23429":138441,"_5":16198,"_30870":138051,"_3543":138442},[],"Llamadas AWS",{"_4098":83314,"_34307":83157,"_23429":138444,"_5":16198,"_30870":138051,"_3543":138445},[],"`NoRegistrada` → `Solicitada`",{"_4098":83315,"_34307":83157,"_23429":138447,"_5":16198,"_30870":138051,"_3543":138448},[],"ninguna (solo escritura de metadatos)",{"_4098":83316,"_34307":83157,"_23429":138450,"_5":16198,"_30870":138051,"_3543":138451},[],"`Solicitada` → `Registrando`",{"_4098":83317,"_34307":83157,"_23429":138453,"_5":16198,"_30870":138051,"_3543":138454},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_4098":83318,"_34307":83157,"_23429":138456,"_5":16198,"_30870":138051,"_3543":138457},[],"`Registrando` → `Completada`",{"_4098":83319,"_34307":83157,"_23429":138459,"_5":16198,"_30870":138051,"_3543":138460},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_4098":83320,"_34307":83157,"_23429":138462,"_5":16198,"_30870":138051,"_3543":138463},[],"`Registrando` → `Fallida`",{"_4098":83321,"_34307":83157,"_23429":138465,"_5":16198,"_30870":138051,"_3543":138466},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_4098":83322,"_34307":83157,"_23429":138468,"_5":16198,"_30870":138051,"_3543":138469},[],"`Fallida` / `Completada` → `Solicitada`",{"_4098":83323,"_34307":83157,"_23429":138471,"_5":16198,"_30870":138051,"_3543":138472},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_4098":83324,"_34307":83157,"_23429":138474,"_5":16198,"_30870":138055,"_3543":138475},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_4098":83325,"_34307":83157,"_23429":138477,"_5":16198,"_30870":138055,"_3543":138478},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_4098":83326,"_34307":83157,"_23429":138480,"_5":16198,"_30870":138055,"_3543":138481},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_4098":83327,"_34307":83157,"_23429":138483,"_5":16198,"_30870":138055,"_3543":138484},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_4098":83328,"_34307":83157,"_23429":138486,"_5":16198,"_30870":138055,"_3543":138487},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_4098":83329,"_34307":83157,"_23429":138489,"_5":16198,"_30870":138055,"_3543":138490},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_4098":83330,"_34307":83157,"_23429":138492,"_5":16198,"_30870":138058,"_3543":138493},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_4098":83331,"_34307":83157,"_23429":138495,"_5":16198,"_30870":138061,"_3543":138496},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_4098":83332,"_34307":83157,"_23429":138498,"_5":16198,"_30870":138061,"_3543":138499},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_4098":83333,"_34307":83157,"_23429":138501,"_5":16198,"_30870":138065,"_3543":138502},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_4098":83334,"_34307":83157,"_23429":138504,"_5":16198,"_30870":138069,"_3543":138505},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_4098":83335,"_34307":83157,"_23429":138507,"_5":16198,"_30870":138069,"_3543":138508},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_4098":83336,"_34307":83157,"_23429":138510,"_5":16198,"_30870":138069,"_3543":138511},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_4098":83337,"_34307":83157,"_23429":138513,"_5":16198,"_30870":138069,"_3543":138514},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_4098":83338,"_34307":83157,"_23429":138516,"_5":16198,"_30870":138069,"_3543":138517},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_4098":83339,"_34307":83157,"_23429":138519,"_5":16198,"_30870":138069,"_3543":138520},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_4098":83340,"_34307":83157,"_23429":138522,"_5":16198,"_30870":138073,"_3543":138523},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_4098":83341,"_34307":83157,"_23429":138525,"_5":16198,"_30870":138073,"_3543":138526},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_4098":83342,"_34307":83157,"_23429":138528,"_5":16198,"_30870":138073,"_3543":138529},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_4098":83343,"_34307":83157,"_23429":138531,"_5":16198,"_30870":138073,"_3543":138532},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_4098":83344,"_34307":83157,"_23429":138534,"_5":16198,"_30870":138073,"_3543":138535},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_4098":83345,"_34307":83157,"_23429":138537,"_5":16198,"_30870":138077,"_3543":138538},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_4098":83346,"_34307":83157,"_23429":138540,"_5":16198,"_30870":138077,"_3543":138439},[],{"_4098":83347,"_34307":83157,"_23429":138542,"_5":16198,"_30870":138077,"_3543":138442},[],{"_4098":83348,"_34307":83157,"_23429":138544,"_5":16198,"_30870":138077,"_3543":138545},[],"`SinConfigurar` → `None` / `Auto`",{"_4098":83349,"_34307":83157,"_23429":138547,"_5":16198,"_30870":138077,"_3543":138548},[],"ninguna (solo configuración)",{"_4098":83350,"_34307":83157,"_23429":138550,"_5":16198,"_30870":138077,"_3543":61456},[],{"_4098":83351,"_34307":83157,"_23429":138552,"_5":16198,"_30870":138077,"_3543":138548},[],{"_4098":83352,"_34307":83157,"_23429":138554,"_5":16198,"_30870":138077,"_3543":138555},[],"Cualquiera → `Jitp`",{"_4098":83353,"_34307":83157,"_23429":138557,"_5":16198,"_30870":138077,"_3543":138558},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_4098":83354,"_34307":83157,"_23429":138560,"_5":16198,"_30870":138077,"_3543":61467},[],{"_4098":83355,"_34307":83157,"_23429":138562,"_5":16198,"_30870":138077,"_3543":138563},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_4098":83356,"_34307":83157,"_23429":138565,"_5":16198,"_30870":138081,"_3543":138566},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_4098":83357,"_34307":83157,"_23429":138568,"_5":16198,"_30870":138081,"_3543":138569},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_4098":83358,"_34307":83157,"_23429":138571,"_5":16198,"_30870":138081,"_3543":138572},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_4098":83359,"_34307":83157,"_23429":138574,"_5":16198,"_30870":138085,"_3543":138575},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_4098":83360,"_34307":83157,"_23429":138577,"_5":16198,"_30870":138085,"_3543":138439},[],{"_4098":83361,"_34307":83157,"_23429":138579,"_5":16198,"_30870":138085,"_3543":138442},[],{"_4098":83362,"_34307":83157,"_23429":138581,"_5":16198,"_30870":138085,"_3543":138582},[],"`Ausente` → `Aprovisionado`",{"_4098":83363,"_34307":83157,"_23429":138584,"_5":16198,"_30870":138085,"_3543":138585},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_4098":83364,"_34307":83157,"_23429":138587,"_5":16198,"_30870":138085,"_3543":138588},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_4098":83365,"_34307":83157,"_23429":138590,"_5":16198,"_30870":138085,"_3543":138591},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_4098":83366,"_34307":83157,"_23429":138593,"_5":16198,"_30870":138085,"_3543":138594},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_4098":83367,"_34307":83157,"_23429":138596,"_5":16198,"_30870":138089,"_3543":138597},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_4098":83368,"_34307":83157,"_23429":138599,"_5":16198,"_30870":138089,"_3543":138600},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_4098":83369,"_34307":83157,"_23429":138602,"_5":16198,"_30870":138089,"_3543":138603},[],"Para que el flujo JITP funcione correctamente:",{"_4098":83370,"_34307":83157,"_23429":138605,"_5":16198,"_30870":138089,"_3543":138606},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_4098":83371,"_34307":83157,"_23429":138608,"_5":16198,"_30870":138089,"_3543":138609},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_4098":83372,"_34307":83157,"_23429":138611,"_5":16198,"_30870":138089,"_3543":138612},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_4098":83373,"_34307":83157,"_23429":138614,"_5":16198,"_30870":138089,"_3543":138615},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_4098":83374,"_34307":83157,"_23429":138617,"_5":16198,"_30870":138093,"_3543":138618},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_4098":83375,"_34307":83157,"_23429":138620,"_5":16198,"_30870":138093,"_3543":138621},[],"Estado en Lamassu",{"_4098":83376,"_34307":83157,"_23429":138623,"_5":16198,"_30870":138093,"_3543":138624},[],"Razón de revocación",{"_4098":83377,"_34307":83157,"_23429":138626,"_5":16198,"_30870":138093,"_3543":138627},[],"Estado en AWS IoT Core",{"_4098":83378,"_34307":83157,"_23429":138629,"_5":16198,"_30870":138093,"_3543":61537},[],{"_4098":83379,"_34307":83157,"_23429":138631,"_5":16198,"_30870":138093,"_3543":138632},[],"Ninguna",{"_4098":83380,"_34307":83157,"_23429":138634,"_5":16198,"_30870":138093,"_3543":61543},[],{"_4098":83381,"_34307":83157,"_23429":138636,"_5":16198,"_30870":138093,"_3543":61546},[],{"_4098":83382,"_34307":83157,"_23429":138638,"_5":16198,"_30870":138093,"_3543":61549},[],{"_4098":83383,"_34307":83157,"_23429":138640,"_5":16198,"_30870":138093,"_3543":61552},[],{"_4098":83384,"_34307":83157,"_23429":138642,"_5":16198,"_30870":138093,"_3543":61546},[],{"_4098":83385,"_34307":83157,"_23429":138644,"_5":16198,"_30870":138093,"_3543":138645},[],"Cualquier otra razón",{"_4098":83386,"_34307":83157,"_23429":138647,"_5":16198,"_30870":138093,"_3543":61560},[],{"_4098":83387,"_34307":83157,"_23429":138649,"_5":16198,"_30870":138093,"_3543":138650},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_4098":83388,"_34307":83157,"_23429":138652,"_5":16198,"_30870":138097,"_3543":138653},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_4098":83389,"_34307":83157,"_23429":138655,"_5":16198,"_30870":138097,"_3543":138439},[],{"_4098":83390,"_34307":83157,"_23429":138657,"_5":16198,"_30870":138097,"_3543":138442},[],{"_4098":83391,"_34307":83157,"_23429":138659,"_5":16198,"_30870":138097,"_3543":138660},[],"`NoSincronizado` → `Active`",{"_4098":83392,"_34307":83157,"_23429":138662,"_5":16198,"_30870":138097,"_3543":61052},[],{"_4098":83393,"_34307":83157,"_23429":138664,"_5":16198,"_30870":138097,"_3543":61578},[],{"_4098":83394,"_34307":83157,"_23429":138666,"_5":16198,"_30870":138097,"_3543":138667},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_4098":83395,"_34307":83157,"_23429":138669,"_5":16198,"_30870":138097,"_3543":61584},[],{"_4098":83396,"_34307":83157,"_23429":138671,"_5":16198,"_30870":138097,"_3543":138667},[],{"_4098":83397,"_34307":83157,"_23429":138673,"_5":16198,"_30870":138097,"_3543":61589},[],{"_4098":83398,"_34307":83157,"_23429":138675,"_5":16198,"_30870":138097,"_3543":61052},[],{"_4098":83399,"_34307":83157,"_23429":138677,"_5":16198,"_30870":138097,"_3543":61594},[],{"_4098":83400,"_34307":83157,"_23429":138679,"_5":16198,"_30870":138097,"_3543":138680},[],"ninguna (estos estados no se sincronizan con AWS)",{"_4098":83401,"_34307":83157,"_23429":138682,"_5":16198,"_30870":138101,"_3543":138683},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_4098":83402,"_34307":83157,"_23429":138685,"_5":16198,"_30870":138101,"_3543":138686},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_4098":83403,"_34307":83157,"_23429":138688,"_5":16198,"_30870":138101,"_3543":138689},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_4098":83404,"_34307":83157,"_23429":138691,"_5":16198,"_30870":138105,"_3543":138692},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_4098":83405,"_34307":83157,"_23429":138694,"_5":16198,"_30870":138105,"_3543":138695},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_4098":83406,"_34307":83157,"_23429":138697,"_5":16198,"_30870":138109,"_3543":138698},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_4098":83407,"_34307":83157,"_23429":138700,"_5":16198,"_30870":138109,"_3543":138701},[],"Existen dos tipos de acciones:",{"_4098":83408,"_34307":83157,"_23429":138703,"_5":16198,"_30870":138109,"_3543":138704},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_4098":83409,"_34307":83157,"_23429":138706,"_5":16198,"_30870":138109,"_3543":138707},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_4098":83410,"_34307":83157,"_23429":138709,"_5":16198,"_30870":138109,"_3543":138710},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_4098":83411,"_34307":83157,"_23429":138712,"_5":16198,"_30870":138113,"_3543":138713},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_4098":83412,"_34307":83157,"_23429":138715,"_5":16198,"_30870":138113,"_3543":138716},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_4098":83413,"_34307":83157,"_23429":138718,"_5":16198,"_30870":138113,"_3543":138719},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_4098":83414,"_34307":83157,"_23429":138721,"_5":16198,"_30870":138117,"_3543":138722},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_4098":83415,"_34307":83157,"_23429":138724,"_5":16198,"_30870":138117,"_3543":138725},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_4098":83416,"_34307":83157,"_23429":138727,"_5":16198,"_30870":138117,"_3543":138728},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_4098":83417,"_34307":83157,"_23429":138730,"_5":16198,"_30870":138117,"_3543":138731},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_4098":83418,"_34307":83157,"_23429":138733,"_5":16198,"_30870":138117,"_3543":138734},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_4098":83419,"_34307":83157,"_23429":138736,"_5":16198,"_30870":138117,"_3543":138737},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_4098":83420,"_34307":83157,"_23429":138739,"_5":16198,"_30870":138117,"_3543":138740},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_4098":83421,"_34307":83157,"_23429":138742,"_5":16198,"_30870":138117,"_3543":138743},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_4098":83422,"_34307":83157,"_23429":138745,"_5":16198,"_30870":138117,"_3543":138746},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_4098":83423,"_34307":83157,"_23429":138748,"_5":16198,"_30870":138117,"_3543":138749},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_4098":83424,"_34307":83157,"_23429":138751,"_5":16198,"_30870":138117,"_3543":138752},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_4098":83425,"_34307":83157,"_23429":138754,"_5":16198,"_30870":138117,"_3543":138755},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_4098":83426,"_34307":83157,"_23429":138757,"_5":16198,"_30870":138117,"_3543":138758},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_4098":83427,"_34307":83157,"_23429":138760,"_5":16198,"_30870":138117,"_3543":138761},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_4098":83428,"_34307":83157,"_23429":138763,"_5":16198,"_30870":138117,"_3543":138764},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_4098":83429,"_34307":83157,"_23429":138766,"_5":16198,"_30870":138117,"_3543":138767},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_4098":83430,"_34307":83157,"_23429":138769,"_5":16198,"_30870":138117,"_3543":138770},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_4098":83431,"_34307":83157,"_23429":138772,"_5":16198,"_30870":138117,"_3543":138773},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_4098":83432,"_34307":83157,"_23429":138775,"_5":16198,"_30870":138117,"_3543":138776},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_4098":83433,"_34307":83157,"_23429":138778,"_5":16198,"_30870":138117,"_3543":138779},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_4098":83434,"_34307":83157,"_23429":138781,"_5":16198,"_30870":138117,"_3543":138782},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_4098":83435,"_34307":83157,"_23429":138784,"_5":16198,"_30870":138117,"_3543":138785},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_4098":83436,"_34307":83157,"_23429":138787,"_5":16198,"_30870":138117,"_3543":138788},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_4098":83437,"_34307":83157,"_23429":138790,"_5":16198,"_30870":138117,"_3543":138791},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_4098":83438,"_34307":83438,"_5":16596,"_3543":59415,"_34738":138793,"_23429":138794,"_30870":83438},[56936,135600,59415],[],{"_4098":83439,"_34307":83438,"_23429":138796,"_5":16198,"_30870":83438,"_3543":138797},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_4098":83440,"_34307":83438,"_5":34735,"_23429":138799,"_30870":138800,"_3543":138801},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_4098":83441,"_34307":83438,"_5":34735,"_23429":138803,"_30870":138804,"_3543":136609},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_4098":83442,"_34307":83438,"_5":34735,"_23429":138806,"_30870":138807,"_3543":136784},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_4098":83443,"_34307":83438,"_5":34735,"_23429":138809,"_30870":138810,"_3543":138016},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/overview#integraciones",{"_4098":83444,"_34307":83438,"_5":34735,"_23429":138812,"_30870":138813,"_3543":138814},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_4098":83445,"_34307":83438,"_23429":138816,"_5":16198,"_30870":83438,"_3543":138817},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_4098":83446,"_34307":83438,"_23429":138819,"_5":16198,"_30870":138800,"_3543":138820},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_4098":83447,"_34307":83438,"_23429":138822,"_5":16198,"_30870":138800,"_3543":138823},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_4098":83448,"_34307":83438,"_23429":138825,"_5":16198,"_30870":138804,"_3543":138826},[],"Recurso",{"_4098":83449,"_34307":83438,"_23429":138828,"_5":16198,"_30870":138804,"_3543":138829},[],"Qué representa",{"_4098":83450,"_34307":83438,"_23429":138831,"_5":16198,"_30870":138804,"_3543":138832},[],"**Dispositivo**",{"_4098":83451,"_34307":83438,"_23429":138834,"_5":16198,"_30870":138804,"_3543":138835},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_4098":83452,"_34307":83438,"_23429":138837,"_5":16198,"_30870":138804,"_3543":138838},[],"**Identidad**",{"_4098":83453,"_34307":83438,"_23429":138840,"_5":16198,"_30870":138804,"_3543":138841},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_4098":83454,"_34307":83438,"_23429":138843,"_5":16198,"_30870":138804,"_3543":61761},[],{"_4098":83455,"_34307":83438,"_23429":138845,"_5":16198,"_30870":138804,"_3543":138846},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_4098":83456,"_34307":83438,"_23429":138848,"_5":16198,"_30870":138804,"_3543":138849},[],"**Flota**",{"_4098":83457,"_34307":83438,"_23429":138851,"_5":16198,"_30870":138804,"_3543":138852},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_4098":83458,"_34307":83438,"_23429":138854,"_5":16198,"_30870":138804,"_3543":138855},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_4098":83459,"_34307":83438,"_23429":138857,"_5":16198,"_30870":138804,"_3543":138858},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_4098":83460,"_34307":83438,"_23429":138860,"_5":16198,"_30870":138807,"_3543":138861},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_4098":83461,"_34307":83438,"_23429":138863,"_5":16198,"_30870":138807,"_3543":138864},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_4098":83462,"_34307":83438,"_23429":138866,"_5":16198,"_30870":138807,"_3543":138867},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_4098":83463,"_34307":83438,"_23429":138869,"_5":16198,"_30870":138807,"_3543":138870},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_4098":83464,"_34307":83438,"_23429":138872,"_5":16198,"_30870":138807,"_3543":138873},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_4098":83465,"_34307":83438,"_23429":138875,"_5":16198,"_30870":138807,"_3543":138876},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_4098":83466,"_34307":83438,"_23429":138878,"_5":16198,"_30870":138807,"_3543":138879},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_4098":83467,"_34307":83438,"_23429":138881,"_5":16198,"_30870":138807,"_3543":138882},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_4098":83468,"_34307":83438,"_23429":138884,"_5":16198,"_30870":138810,"_3543":138885},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_4098":83469,"_34307":83438,"_23429":138887,"_5":16198,"_30870":138810,"_3543":138888},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_4098":83470,"_34307":83438,"_23429":138890,"_5":16198,"_30870":138813,"_3543":138891},[],"Participante",{"_4098":83471,"_34307":83438,"_23429":138893,"_5":16198,"_30870":138813,"_3543":138894},[],"Responsabilidad",{"_4098":83472,"_34307":83438,"_23429":138896,"_5":16198,"_30870":138813,"_3543":138897},[],"Administrador PKI",{"_4098":83473,"_34307":83438,"_23429":138899,"_5":16198,"_30870":138813,"_3543":138900},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_4098":83474,"_34307":83438,"_23429":138902,"_5":16198,"_30870":138813,"_3543":138903},[],"Administrador del aprovisionamiento",{"_4098":83475,"_34307":83438,"_23429":138905,"_5":16198,"_30870":138813,"_3543":138906},[],"DMS, admisión, autenticación por operación e inventario.",{"_4098":83476,"_34307":83438,"_23429":138908,"_5":16198,"_30870":138813,"_3543":138909},[],"Integrador del dispositivo",{"_4098":83477,"_34307":83438,"_23429":138911,"_5":16198,"_30870":138813,"_3543":138912},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_4098":83478,"_34307":83438,"_23429":138914,"_5":16198,"_30870":138813,"_3543":138915},[],"Integrador del consumidor",{"_4098":83479,"_34307":83438,"_23429":138917,"_5":16198,"_30870":138813,"_3543":138918},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_4098":83480,"_34307":83438,"_23429":138920,"_5":16198,"_30870":138813,"_3543":138921},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_4098":83481,"_34307":83481,"_5":16596,"_3543":138923,"_34738":138924,"_23429":138926,"_30870":83481},"Enrola y conecta tu primer dispositivo",[56936,135600,59415,138925],"Primeros pasos",[],{"_4098":83482,"_34307":83481,"_23429":138928,"_5":16198,"_30870":83481,"_3543":138929},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_4098":83483,"_34307":83481,"_5":34735,"_23429":138931,"_30870":138932,"_3543":134178},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_4098":83484,"_34307":83481,"_5":34735,"_23429":138934,"_30870":138935,"_3543":138936},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_4098":83485,"_34307":83481,"_5":34735,"_23429":138938,"_30870":138939,"_3543":138940},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_4098":83486,"_34307":83481,"_5":34735,"_23429":138942,"_30870":138943,"_3543":138944},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_4098":83487,"_34307":83481,"_5":34735,"_23429":138946,"_30870":138947,"_3543":138948},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_4098":83488,"_34307":83481,"_5":34735,"_23429":138950,"_30870":138951,"_3543":138952},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_4098":83489,"_34307":83481,"_5":34735,"_23429":138954,"_30870":138955,"_3543":138956},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_4098":83490,"_34307":83481,"_5":34735,"_23429":138958,"_30870":138959,"_3543":138960},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_4098":83491,"_34307":83481,"_23429":138962,"_5":16198,"_30870":83481,"_3543":138963},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_4098":83492,"_34307":83481,"_23429":138965,"_5":16198,"_30870":138932,"_3543":138966},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_4098":83493,"_34307":83481,"_23429":138968,"_5":16198,"_30870":138932,"_3543":138969},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_4098":83494,"_34307":83481,"_23429":138971,"_5":16198,"_30870":138932,"_3543":138972},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_4098":83495,"_34307":83481,"_23429":138974,"_5":16198,"_30870":138932,"_3543":138975},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_4098":83496,"_34307":83481,"_23429":138977,"_5":16198,"_30870":138932,"_3543":138978},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_4098":83497,"_34307":83481,"_23429":138980,"_5":16198,"_30870":138935,"_3543":138981},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_4098":83498,"_34307":83481,"_23429":138983,"_5":16198,"_30870":138935,"_3543":138984},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_4098":83499,"_34307":83481,"_23429":138986,"_5":16198,"_30870":138939,"_3543":138987},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_4098":83500,"_34307":83481,"_23429":138989,"_5":16198,"_30870":138939,"_3543":138990},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_4098":83501,"_34307":83481,"_23429":138992,"_5":16198,"_30870":138939,"_3543":138993},[],"Ajuste",{"_4098":83502,"_34307":83481,"_23429":138995,"_5":16198,"_30870":138939,"_3543":138996},[],"Valor de evaluación",{"_4098":83503,"_34307":83481,"_23429":138998,"_5":16198,"_30870":138939,"_3543":61917},[],{"_4098":83504,"_34307":83481,"_23429":139000,"_5":16198,"_30870":138939,"_3543":139001},[],"Raíz emisora de `device-root.pem`.",{"_4098":83505,"_34307":83481,"_23429":139003,"_5":16198,"_30870":138939,"_3543":136912},[],{"_4098":83506,"_34307":83481,"_23429":139005,"_5":16198,"_30870":138939,"_3543":139006},[],"Perfil final de 1 hora que acabas de preparar.",{"_4098":83507,"_34307":83481,"_23429":139008,"_5":16198,"_30870":138939,"_3543":61928},[],{"_4098":83508,"_34307":83481,"_23429":139010,"_5":16198,"_30870":138939,"_3543":61931},[],{"_4098":83509,"_34307":83481,"_23429":139012,"_5":16198,"_30870":138939,"_3543":61934},[],{"_4098":83510,"_34307":83481,"_23429":139014,"_5":16198,"_30870":138939,"_3543":139015},[],"Habilitado.",{"_4098":83511,"_34307":83481,"_23429":139017,"_5":16198,"_30870":138939,"_3543":61940},[],{"_4098":83512,"_34307":83481,"_23429":139019,"_5":16198,"_30870":138939,"_3543":139020},[],"Deshabilitado; el ID debe ser nuevo.",{"_4098":83513,"_34307":83481,"_23429":139022,"_5":16198,"_30870":138939,"_3543":139023},[],"Autenticación inicial",{"_4098":83514,"_34307":83481,"_23429":139025,"_5":16198,"_30870":138939,"_3543":139026},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_4098":83515,"_34307":83481,"_23429":139028,"_5":16198,"_30870":138939,"_3543":139029},[],"Autenticación de renovación",{"_4098":83516,"_34307":83481,"_23429":139031,"_5":16198,"_30870":138939,"_3543":139032},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_4098":83517,"_34307":83481,"_23429":139034,"_5":16198,"_30870":138939,"_3543":61958},[],{"_4098":83518,"_34307":83481,"_23429":139036,"_5":16198,"_30870":138939,"_3543":139037},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_4098":83519,"_34307":83481,"_23429":139039,"_5":16198,"_30870":138939,"_3543":61964},[],{"_4098":83520,"_34307":83481,"_23429":139041,"_5":16198,"_30870":138939,"_3543":139042},[],"1 hora.",{"_4098":83521,"_34307":83481,"_23429":139044,"_5":16198,"_30870":138939,"_3543":61970},[],{"_4098":83522,"_34307":83481,"_23429":139046,"_5":16198,"_30870":138939,"_3543":139047},[],"30 minutos / 10 minutos.",{"_4098":83523,"_34307":83481,"_23429":139049,"_5":16198,"_30870":138939,"_3543":61976},[],{"_4098":83524,"_34307":83481,"_23429":139051,"_5":16198,"_30870":138939,"_3543":139052},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_4098":83525,"_34307":83481,"_23429":139054,"_5":16198,"_30870":138939,"_3543":59734},[],{"_4098":83526,"_34307":83481,"_23429":139056,"_5":16198,"_30870":138939,"_3543":139057},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_4098":83527,"_34307":83481,"_23429":139059,"_5":16198,"_30870":138939,"_3543":61987},[],{"_4098":83528,"_34307":83481,"_23429":139061,"_5":16198,"_30870":138939,"_3543":139062},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_4098":83529,"_34307":83481,"_23429":139064,"_5":16198,"_30870":138939,"_3543":139065},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_4098":83530,"_34307":83481,"_23429":139067,"_5":16198,"_30870":138943,"_3543":139068},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_4098":83531,"_34307":83481,"_23429":139070,"_5":16198,"_30870":138943,"_3543":139071},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_4098":83532,"_34307":83481,"_23429":139073,"_5":16198,"_30870":138947,"_3543":139074},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_4098":83533,"_34307":83481,"_23429":139076,"_5":16198,"_30870":138947,"_3543":139077},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_4098":83534,"_34307":83481,"_23429":139079,"_5":16198,"_30870":138947,"_3543":139080},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_4098":83535,"_34307":83481,"_23429":139082,"_5":16198,"_30870":138951,"_3543":139083},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_4098":83536,"_34307":83481,"_23429":139085,"_5":16198,"_30870":138951,"_3543":139086},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_4098":83537,"_34307":83481,"_23429":139088,"_5":16198,"_30870":138955,"_3543":139089},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_4098":83538,"_34307":83481,"_23429":139091,"_5":16198,"_30870":138955,"_3543":139092},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_4098":83539,"_34307":83481,"_23429":139094,"_5":16198,"_30870":138955,"_3543":139095},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_4098":83540,"_34307":83481,"_23429":139097,"_5":16198,"_30870":138955,"_3543":139098},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_4098":83541,"_34307":83481,"_23429":139100,"_5":16198,"_30870":138955,"_3543":139101},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_4098":83542,"_34307":83481,"_23429":139103,"_5":16198,"_30870":138959,"_3543":139104},[],"Comprobación",{"_4098":83543,"_34307":83481,"_23429":139106,"_5":16198,"_30870":138959,"_3543":139107},[],"Resultado esperado",{"_4098":83544,"_34307":83481,"_23429":139109,"_5":16198,"_30870":138959,"_3543":139110},[],"Registro",{"_4098":83545,"_34307":83481,"_23429":139112,"_5":16198,"_30870":138959,"_3543":139113},[],"ID creado automáticamente y DMS correcto.",{"_4098":83546,"_34307":83481,"_23429":139115,"_5":16198,"_30870":138959,"_3543":138400},[],{"_4098":83547,"_34307":83481,"_23429":139117,"_5":16198,"_30870":138959,"_3543":139118},[],"CN, perfil, serie y clave verificados.",{"_4098":83548,"_34307":83481,"_23429":139120,"_5":16198,"_30870":138959,"_3543":139121},[],"Inventario",{"_4098":83549,"_34307":83481,"_23429":139123,"_5":16198,"_30870":138959,"_3543":139124},[],"Serie recibida visible como identidad actual y en el historial.",{"_4098":83550,"_34307":83481,"_23429":139126,"_5":16198,"_30870":138959,"_3543":139127},[],"Consumidor",{"_4098":83551,"_34307":83481,"_23429":139129,"_5":16198,"_30870":138959,"_3543":139130},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_4098":83552,"_34307":83481,"_23429":139132,"_5":16198,"_30870":138959,"_3543":139133},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_4098":83553,"_34307":83481,"_23429":139135,"_5":16198,"_30870":138959,"_3543":139136},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_4098":83554,"_34307":83554,"_5":16596,"_3543":136626,"_34738":139138,"_23429":139139,"_30870":83554},[56936,135600,59415,138925],[],{"_4098":83555,"_34307":83554,"_23429":139141,"_5":16198,"_30870":83554,"_3543":139142},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_4098":83556,"_34307":83554,"_5":34735,"_23429":139144,"_30870":139145,"_3543":134178},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_4098":83557,"_34307":83554,"_5":34735,"_23429":139147,"_30870":139148,"_3543":139149},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_4098":83558,"_34307":83554,"_5":34735,"_23429":139151,"_30870":139152,"_3543":139153},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_4098":83559,"_34307":83554,"_5":34735,"_23429":139155,"_30870":139156,"_3543":139157},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_4098":83560,"_34307":83554,"_5":34735,"_23429":139159,"_30870":139160,"_3543":139161},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_4098":83561,"_34307":83554,"_5":34735,"_23429":139163,"_30870":139164,"_3543":139165},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_4098":83562,"_34307":83554,"_5":34735,"_23429":139167,"_30870":139168,"_3543":139107},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_4098":83563,"_34307":83554,"_5":34735,"_23429":139170,"_30870":139171,"_3543":139172},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_4098":83564,"_34307":83554,"_5":34735,"_23429":139174,"_30870":139175,"_3543":139176},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_4098":83565,"_34307":83554,"_23429":139178,"_5":16198,"_30870":83554,"_3543":139179},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_4098":83566,"_34307":83554,"_23429":139181,"_5":16198,"_30870":83554,"_3543":139182},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_4098":83567,"_34307":83554,"_23429":139184,"_5":16198,"_30870":139145,"_3543":139185},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_4098":83568,"_34307":83554,"_23429":139187,"_5":16198,"_30870":139145,"_3543":139188},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_4098":83569,"_34307":83554,"_23429":139190,"_5":16198,"_30870":139145,"_3543":139191},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_4098":83570,"_34307":83554,"_23429":139193,"_5":16198,"_30870":139145,"_3543":139194},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_4098":83571,"_34307":83554,"_23429":139196,"_5":16198,"_30870":139148,"_3543":139197},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_4098":83572,"_34307":83554,"_23429":139199,"_5":16198,"_30870":139148,"_3543":139200},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_4098":83573,"_34307":83554,"_23429":139202,"_5":16198,"_30870":139148,"_3543":139203},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_4098":83574,"_34307":83554,"_23429":139205,"_5":16198,"_30870":139148,"_3543":139206},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_4098":83575,"_34307":83554,"_23429":139208,"_5":16198,"_30870":139148,"_3543":139209},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_4098":83576,"_34307":83554,"_23429":139211,"_5":16198,"_30870":139148,"_3543":139212},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_4098":83577,"_34307":83554,"_23429":139214,"_5":16198,"_30870":139148,"_3543":139215},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_4098":83578,"_34307":83554,"_23429":139217,"_5":16198,"_30870":139148,"_3543":139218},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_4098":83579,"_34307":83554,"_23429":139220,"_5":16198,"_30870":139152,"_3543":139221},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_4098":83580,"_34307":83554,"_23429":139223,"_5":16198,"_30870":139152,"_3543":62152},[],{"_4098":83581,"_34307":83554,"_23429":139225,"_5":16198,"_30870":139152,"_3543":139226},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_4098":83582,"_34307":83554,"_23429":139228,"_5":16198,"_30870":139152,"_3543":139229},[],"**Icon** y **Tags**: clasificación opcional.",{"_4098":83583,"_34307":83554,"_23429":139231,"_5":16198,"_30870":139152,"_3543":139232},[],"Confirma el registro.",{"_4098":83584,"_34307":83554,"_23429":139234,"_5":16198,"_30870":139156,"_3543":139235},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_4098":83585,"_34307":83554,"_23429":139237,"_5":16198,"_30870":139156,"_3543":139238},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_4098":83586,"_34307":83554,"_23429":139240,"_5":16198,"_30870":139160,"_3543":139241},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_4098":83587,"_34307":83554,"_23429":139243,"_5":16198,"_30870":139160,"_3543":139244},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_4098":83588,"_34307":83554,"_23429":139246,"_5":16198,"_30870":139164,"_3543":139247},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_4098":83589,"_34307":83554,"_23429":139249,"_5":16198,"_30870":139164,"_3543":139250},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_4098":83590,"_34307":83554,"_23429":139252,"_5":16198,"_30870":139168,"_3543":139104},[],{"_4098":83591,"_34307":83554,"_23429":139254,"_5":16198,"_30870":139168,"_3543":139255},[],"Resultado",{"_4098":83592,"_34307":83554,"_23429":139257,"_5":16198,"_30870":139168,"_3543":138386},[],{"_4098":83593,"_34307":83554,"_23429":139259,"_5":16198,"_30870":139168,"_3543":139260},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_4098":83594,"_34307":83554,"_23429":139262,"_5":16198,"_30870":139168,"_3543":139263},[],"Identidad actual",{"_4098":83595,"_34307":83554,"_23429":139265,"_5":16198,"_30870":139168,"_3543":139266},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_4098":83596,"_34307":83554,"_23429":139268,"_5":16198,"_30870":139168,"_3543":139269},[],"Historial",{"_4098":83597,"_34307":83554,"_23429":139271,"_5":16198,"_30870":139168,"_3543":139272},[],"La emisión asociada aparece con su número de serie y fechas.",{"_4098":83598,"_34307":83554,"_23429":139274,"_5":16198,"_30870":139168,"_3543":139275},[],"Clave y certificado",{"_4098":83599,"_34307":83554,"_23429":139277,"_5":16198,"_30870":139168,"_3543":139278},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_4098":83600,"_34307":83554,"_23429":139280,"_5":16198,"_30870":139171,"_3543":139281},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_4098":83601,"_34307":83554,"_23429":139283,"_5":16198,"_30870":139171,"_3543":139284},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_4098":83602,"_34307":83554,"_23429":139286,"_5":16198,"_30870":139171,"_3543":139287},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_4098":83603,"_34307":83554,"_23429":139289,"_5":16198,"_30870":139171,"_3543":139290},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_4098":83604,"_34307":83554,"_23429":139292,"_5":16198,"_30870":139175,"_3543":139293},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_4098":83605,"_34307":83554,"_23429":139295,"_5":16198,"_30870":139175,"_3543":139296},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_4098":83606,"_34307":83554,"_23429":139298,"_5":16198,"_30870":139175,"_3543":139299},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_4098":83607,"_34307":83607,"_5":16596,"_3543":139301,"_34738":139302,"_23429":139303,"_30870":83607},"Plataforma Lamassu IoT",[56936,135600],[],{"_4098":83608,"_34307":83607,"_23429":139305,"_5":16198,"_30870":83607,"_3543":139306},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_4098":83609,"_34307":83607,"_5":34735,"_23429":139308,"_30870":139309,"_3543":138801},[],"/docs/pr-preview/pr-58/es/platform/overview#empieza-aquí",{"_4098":83610,"_34307":83607,"_5":34735,"_23429":139311,"_30870":139312,"_3543":139313},[],"/docs/pr-preview/pr-58/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_4098":83611,"_34307":83607,"_5":34735,"_23429":139315,"_30870":139316,"_3543":139317},[],"/docs/pr-preview/pr-58/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_4098":83612,"_34307":83607,"_5":34735,"_23429":139319,"_30870":139320,"_3543":139321},[],"/docs/pr-preview/pr-58/es/platform/overview#capacidades-principales","Capacidades principales",{"_4098":83613,"_34307":83607,"_5":34735,"_23429":139323,"_30870":139324,"_3543":139325},[],"/docs/pr-preview/pr-58/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_4098":83614,"_34307":83607,"_5":34735,"_23429":139327,"_30870":139328,"_3543":139329},[],"/docs/pr-preview/pr-58/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_4098":83615,"_34307":83607,"_5":34735,"_23429":139331,"_30870":139332,"_3543":139333},[],"/docs/pr-preview/pr-58/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_4098":83616,"_34307":83607,"_5":34735,"_23429":139335,"_30870":139336,"_3543":139337},[],"/docs/pr-preview/pr-58/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_4098":83617,"_34307":83607,"_5":34735,"_23429":139339,"_30870":139340,"_3543":139341},[],"/docs/pr-preview/pr-58/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_4098":83618,"_34307":83607,"_5":34735,"_23429":139343,"_30870":139344,"_3543":139345},[],"/docs/pr-preview/pr-58/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_4098":83619,"_34307":83607,"_5":34735,"_23429":139347,"_30870":139348,"_3543":139349},[],"/docs/pr-preview/pr-58/es/platform/overview#referencia-operativa","Referencia operativa",{"_4098":83620,"_34307":83607,"_23429":139351,"_5":16198,"_30870":83607,"_3543":139352},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_4098":83621,"_34307":83607,"_23429":139354,"_5":16198,"_30870":139309,"_3543":139355},[],"Elige el resultado que necesitas obtener:",{"_4098":83622,"_34307":83607,"_23429":139357,"_5":16198,"_30870":139309,"_3543":139358},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_4098":83623,"_34307":83607,"_23429":139360,"_5":16198,"_30870":139309,"_3543":139361},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_4098":83624,"_34307":83607,"_23429":139363,"_5":16198,"_30870":139309,"_3543":139364},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_4098":83625,"_34307":83607,"_23429":139366,"_5":16198,"_30870":139312,"_3543":139367},[],"Bloque",{"_4098":83626,"_34307":83607,"_23429":139369,"_5":16198,"_30870":139312,"_3543":139370},[],"Qué gestionas",{"_4098":83627,"_34307":83607,"_23429":139372,"_5":16198,"_30870":139312,"_3543":139373},[],"Punto de entrada",{"_4098":83628,"_34307":83607,"_23429":139375,"_5":16198,"_30870":139312,"_3543":62305},[],{"_4098":83629,"_34307":83607,"_23429":139377,"_5":16198,"_30870":139312,"_3543":139378},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_4098":83630,"_34307":83607,"_23429":139380,"_5":16198,"_30870":139312,"_3543":139381},[],"Visión general de PKI",{"_4098":83631,"_34307":83607,"_23429":139383,"_5":16198,"_30870":139312,"_3543":62314},[],{"_4098":83632,"_34307":83607,"_23429":139385,"_5":16198,"_30870":139312,"_3543":139386},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_4098":83633,"_34307":83607,"_23429":139388,"_5":16198,"_30870":139312,"_3543":139389},[],"Visión general de IoT Fleets",{"_4098":83634,"_34307":83607,"_23429":139391,"_5":16198,"_30870":139312,"_3543":139392},[],"**Administración**",{"_4098":83635,"_34307":83607,"_23429":139394,"_5":16198,"_30870":139312,"_3543":139395},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_4098":83636,"_34307":83607,"_23429":139397,"_5":16198,"_30870":139312,"_3543":135598},[],{"_4098":83637,"_34307":83607,"_23429":139399,"_5":16198,"_30870":139312,"_3543":139400},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_4098":83638,"_34307":83607,"_23429":139402,"_5":16198,"_30870":139316,"_3543":139403},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_4098":83639,"_34307":83607,"_23429":139405,"_5":16198,"_30870":139316,"_3543":139406},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_4098":83640,"_34307":83607,"_23429":139408,"_5":16198,"_30870":139316,"_3543":139409},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_4098":83641,"_34307":83607,"_23429":139411,"_5":16198,"_30870":139316,"_3543":139412},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_4098":83642,"_34307":83607,"_23429":139414,"_5":16198,"_30870":139316,"_3543":139415},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_4098":83643,"_34307":83607,"_23429":139417,"_5":16198,"_30870":139316,"_3543":139418},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_4098":83644,"_34307":83607,"_23429":139420,"_5":16198,"_30870":139324,"_3543":139421},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_4098":83645,"_34307":83607,"_23429":139423,"_5":16198,"_30870":139328,"_3543":139424},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_4098":83646,"_34307":83607,"_23429":139426,"_5":16198,"_30870":139332,"_3543":139427},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_4098":83647,"_34307":83607,"_23429":139429,"_5":16198,"_30870":139336,"_3543":139430},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_4098":83648,"_34307":83607,"_23429":139432,"_5":16198,"_30870":139340,"_3543":139433},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_4098":83649,"_34307":83607,"_23429":139435,"_5":16198,"_30870":139344,"_3543":139436},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_4098":83650,"_34307":83607,"_23429":139438,"_5":16198,"_30870":139348,"_3543":138894},[],{"_4098":83651,"_34307":83607,"_23429":139440,"_5":16198,"_30870":139348,"_3543":139441},[],"Qué prepara o comprueba",{"_4098":83652,"_34307":83607,"_23429":139443,"_5":16198,"_30870":139348,"_3543":138897},[],{"_4098":83653,"_34307":83607,"_23429":139445,"_5":16198,"_30870":139348,"_3543":139446},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_4098":83654,"_34307":83607,"_23429":139448,"_5":16198,"_30870":139348,"_3543":139449},[],"Administrador de la flota",{"_4098":83655,"_34307":83607,"_23429":139451,"_5":16198,"_30870":139348,"_3543":139452},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_4098":83656,"_34307":83607,"_23429":139454,"_5":16198,"_30870":139348,"_3543":138909},[],{"_4098":83657,"_34307":83607,"_23429":139456,"_5":16198,"_30870":139348,"_3543":139457},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_4098":83658,"_34307":83607,"_23429":139459,"_5":16198,"_30870":139348,"_3543":138915},[],{"_4098":83659,"_34307":83607,"_23429":139461,"_5":16198,"_30870":139348,"_3543":139462},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_4098":83660,"_34307":83607,"_23429":139464,"_5":16198,"_30870":139348,"_3543":139465},[],"Operador de infraestructura",{"_4098":83661,"_34307":83607,"_23429":139467,"_5":16198,"_30870":139348,"_3543":139468},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_4098":83662,"_34307":83607,"_23429":139470,"_5":16198,"_30870":139348,"_3543":139471},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_4098":83663,"_34307":83663,"_5":16596,"_3543":139473,"_34738":139474,"_23429":139476,"_30870":83663},"Jerarquía y rotación de CAs",[56936,135600,62406,139475],"Claves, autoridades y certificados",[],{"_4098":83664,"_34307":83663,"_23429":139478,"_5":16198,"_30870":83663,"_3543":139479},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_4098":83665,"_34307":83663,"_5":34735,"_23429":139481,"_30870":139482,"_3543":139483},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_4098":83666,"_34307":83663,"_5":34735,"_23429":139485,"_30870":139486,"_3543":139487},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_4098":83667,"_34307":83663,"_5":34735,"_23429":139489,"_30870":139490,"_3543":139491},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_4098":83668,"_34307":83663,"_5":34735,"_23429":139493,"_30870":139494,"_3543":139495},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_4098":83669,"_34307":83663,"_5":34735,"_23429":139497,"_30870":139498,"_3543":139499},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_4098":83670,"_34307":83663,"_5":34735,"_23429":139501,"_30870":139502,"_3543":139503},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_4098":83671,"_34307":83663,"_5":34735,"_23429":139505,"_30870":139506,"_3543":139507},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_4098":83672,"_34307":83663,"_5":34735,"_23429":139509,"_30870":139510,"_3543":139511},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_4098":83673,"_34307":83663,"_5":34735,"_23429":139513,"_30870":139514,"_3543":139515},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_4098":83674,"_34307":83663,"_5":34735,"_23429":139517,"_30870":139518,"_3543":139519},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_4098":83675,"_34307":83663,"_5":34735,"_23429":139521,"_30870":139522,"_3543":139523},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_4098":83676,"_34307":83663,"_5":34735,"_23429":139525,"_30870":139526,"_3543":139527},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_4098":83677,"_34307":83663,"_23429":139529,"_5":16198,"_30870":83663,"_3543":139530},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_4098":83678,"_34307":83663,"_23429":139532,"_5":16198,"_30870":83663,"_3543":139533},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_4098":83679,"_34307":83663,"_23429":139535,"_5":16198,"_30870":139482,"_3543":139536},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_4098":83680,"_34307":83663,"_23429":139538,"_5":16198,"_30870":139482,"_3543":139539},[],"entorno, como producción y preproducción;",{"_4098":83681,"_34307":83663,"_23429":139541,"_5":16198,"_30870":139482,"_3543":139542},[],"propietario o equipo operador;",{"_4098":83682,"_34307":83663,"_23429":139544,"_5":16198,"_30870":139482,"_3543":139545},[],"familia de dispositivos o proceso de fabricación;",{"_4098":83683,"_34307":83663,"_23429":139547,"_5":16198,"_30870":139482,"_3543":139548},[],"región o requisito regulatorio;",{"_4098":83684,"_34307":83663,"_23429":139550,"_5":16198,"_30870":139482,"_3543":139551},[],"motor criptográfico o política de clave;",{"_4098":83685,"_34307":83663,"_23429":139553,"_5":16198,"_30870":139482,"_3543":139554},[],"ventana de mantenimiento y ritmo de renovación.",{"_4098":83686,"_34307":83663,"_23429":139556,"_5":16198,"_30870":139482,"_3543":139557},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_4098":83687,"_34307":83663,"_23429":139559,"_5":16198,"_30870":139482,"_3543":139560},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_4098":83688,"_34307":83663,"_23429":139562,"_5":16198,"_30870":139486,"_3543":139563},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_4098":83689,"_34307":83663,"_23429":139565,"_5":16198,"_30870":139486,"_3543":139566},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_4098":83690,"_34307":83663,"_23429":139568,"_5":16198,"_30870":139486,"_3543":139569},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_4098":83691,"_34307":83663,"_23429":139571,"_5":16198,"_30870":139490,"_3543":139572},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_4098":83692,"_34307":83663,"_23429":139574,"_5":16198,"_30870":139490,"_3543":139575},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_4098":83693,"_34307":83663,"_23429":139577,"_5":16198,"_30870":139490,"_3543":139578},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_4098":83694,"_34307":83663,"_23429":139580,"_5":16198,"_30870":139490,"_3543":139581},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_4098":83695,"_34307":83663,"_23429":139583,"_5":16198,"_30870":139498,"_3543":139584},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_4098":83696,"_34307":83663,"_23429":139586,"_5":16198,"_30870":139502,"_3543":139587},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_4098":83697,"_34307":83663,"_23429":139589,"_5":16198,"_30870":139506,"_3543":139590},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_4098":83698,"_34307":83663,"_23429":139592,"_5":16198,"_30870":139510,"_3543":139593},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_4098":83699,"_34307":83663,"_23429":139595,"_5":16198,"_30870":139514,"_3543":139596},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_4098":83700,"_34307":83663,"_23429":139598,"_5":16198,"_30870":139518,"_3543":139599},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_4098":83701,"_34307":83663,"_23429":139601,"_5":16198,"_30870":139522,"_3543":139602},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_4098":83702,"_34307":83663,"_23429":139604,"_5":16198,"_30870":139522,"_3543":139605},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_4098":83703,"_34307":83663,"_23429":139607,"_5":16198,"_30870":139522,"_3543":139608},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_4098":83704,"_34307":83663,"_23429":139610,"_5":16198,"_30870":139522,"_3543":139611},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_4098":83705,"_34307":83663,"_23429":139613,"_5":16198,"_30870":139526,"_3543":139614},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_4098":83706,"_34307":83663,"_23429":139616,"_5":16198,"_30870":139526,"_3543":139617},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_4098":83707,"_34307":83663,"_23429":139619,"_5":16198,"_30870":139526,"_3543":139620},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_4098":83708,"_34307":83663,"_23429":139622,"_5":16198,"_30870":139526,"_3543":139623},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_4098":83709,"_34307":83663,"_23429":139625,"_5":16198,"_30870":139526,"_3543":139626},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_4098":83710,"_34307":83663,"_23429":139628,"_5":16198,"_30870":139526,"_3543":139629},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_4098":83711,"_34307":83663,"_23429":139631,"_5":16198,"_30870":139526,"_3543":139632},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_4098":83712,"_34307":83712,"_5":16596,"_3543":139634,"_34738":139635,"_23429":139636,"_30870":83712},"Autoridades de certificación",[56936,135600,62406,139475],[],{"_4098":83713,"_34307":83712,"_23429":139638,"_5":16198,"_30870":83712,"_3543":139639},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_4098":83714,"_34307":83712,"_5":34735,"_23429":139641,"_30870":139642,"_3543":139643},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_4098":83715,"_34307":83712,"_5":34735,"_23429":139645,"_30870":139646,"_3543":139647},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_4098":83716,"_34307":83712,"_5":34735,"_23429":139649,"_30870":139650,"_3543":134178},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#antes-de-empezar",{"_4098":83717,"_34307":83712,"_5":34735,"_23429":139652,"_30870":139653,"_3543":139654},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_4098":83718,"_34307":83712,"_5":34735,"_23429":139656,"_30870":139657,"_3543":139658},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_4098":83719,"_34307":83712,"_5":34735,"_23429":139660,"_30870":139661,"_3543":139662},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_4098":83720,"_34307":83712,"_5":34735,"_23429":139664,"_30870":139665,"_3543":139666},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_4098":83721,"_34307":83712,"_5":34735,"_23429":139668,"_30870":139669,"_3543":139670},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_4098":83722,"_34307":83712,"_5":34735,"_23429":139672,"_30870":139673,"_3543":139674},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_4098":83723,"_34307":83712,"_5":34735,"_23429":139676,"_30870":139677,"_3543":139678},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_4098":83724,"_34307":83712,"_5":34735,"_23429":139680,"_30870":139681,"_3543":139682},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_4098":83725,"_34307":83712,"_5":34735,"_23429":139684,"_30870":139685,"_3543":139686},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_4098":83726,"_34307":83712,"_5":34735,"_23429":139688,"_30870":139689,"_3543":139690},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_4098":83727,"_34307":83712,"_5":34735,"_23429":139692,"_30870":139693,"_3543":139694},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_4098":83728,"_34307":83712,"_5":34735,"_23429":139696,"_30870":139697,"_3543":139698},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_4098":83729,"_34307":83712,"_5":34735,"_23429":139700,"_30870":139701,"_3543":139702},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_4098":83730,"_34307":83712,"_5":34735,"_23429":139704,"_30870":139705,"_3543":139706},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_4098":83731,"_34307":83712,"_5":34735,"_23429":139708,"_30870":139709,"_3543":139710},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_4098":83732,"_34307":83712,"_5":34735,"_23429":139712,"_30870":139713,"_3543":139714},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_4098":83733,"_34307":83712,"_5":34735,"_23429":139716,"_30870":139717,"_3543":139718},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_4098":83734,"_34307":83712,"_5":34735,"_23429":139720,"_30870":139721,"_3543":139722},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_4098":83735,"_34307":83712,"_5":34735,"_23429":139724,"_30870":139725,"_3543":139726},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_4098":83736,"_34307":83712,"_5":34735,"_23429":139728,"_30870":139729,"_3543":139730},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_4098":83737,"_34307":83712,"_23429":139732,"_5":16198,"_30870":83712,"_3543":139733},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_4098":83738,"_34307":83712,"_23429":139735,"_5":16198,"_30870":83712,"_3543":139736},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_4098":83739,"_34307":83712,"_23429":139738,"_5":16198,"_30870":83712,"_3543":139739},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_4098":83740,"_34307":83712,"_23429":139741,"_5":16198,"_30870":139642,"_3543":139742},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_4098":83741,"_34307":83712,"_23429":139744,"_5":16198,"_30870":139642,"_3543":139745},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_4098":83742,"_34307":83712,"_23429":139747,"_5":16198,"_30870":139642,"_3543":139748},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_4098":83743,"_34307":83712,"_23429":139750,"_5":16198,"_30870":139642,"_3543":139751},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_4098":83744,"_34307":83712,"_23429":139753,"_5":16198,"_30870":139642,"_3543":139754},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_4098":83745,"_34307":83712,"_23429":139756,"_5":16198,"_30870":139650,"_3543":139757},[],"Decide si la CA será raíz o intermedia.",{"_4098":83746,"_34307":83712,"_23429":139759,"_5":16198,"_30870":139650,"_3543":139760},[],"Elige el motor que custodiará la clave.",{"_4098":83747,"_34307":83712,"_23429":139762,"_5":16198,"_30870":139650,"_3543":139763},[],"Define una validez superior a la de los certificados que emitirá.",{"_4098":83748,"_34307":83712,"_23429":139765,"_5":16198,"_30870":139650,"_3543":139766},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_4098":83749,"_34307":83712,"_23429":139768,"_5":16198,"_30870":139653,"_3543":139769},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_4098":83750,"_34307":83712,"_23429":139771,"_5":16198,"_30870":139657,"_3543":139772},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_4098":83751,"_34307":83712,"_23429":139774,"_5":16198,"_30870":139657,"_3543":139775},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_4098":83752,"_34307":83712,"_23429":139777,"_5":16198,"_30870":139661,"_3543":139778},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_4098":83753,"_34307":83712,"_23429":139780,"_5":16198,"_30870":139665,"_3543":139781},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_4098":83754,"_34307":83712,"_23429":139783,"_5":16198,"_30870":139665,"_3543":139784},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_4098":83755,"_34307":83712,"_23429":139786,"_5":16198,"_30870":139665,"_3543":139787},[],"`ST`: estado o provincia.",{"_4098":83756,"_34307":83712,"_23429":139789,"_5":16198,"_30870":139665,"_3543":139790},[],"`L`: localidad.",{"_4098":83757,"_34307":83712,"_23429":139792,"_5":16198,"_30870":139665,"_3543":139793},[],"`O`: organización.",{"_4098":83758,"_34307":83712,"_23429":139795,"_5":16198,"_30870":139665,"_3543":139796},[],"`OU`: unidad organizativa.",{"_4098":83759,"_34307":83712,"_23429":139798,"_5":16198,"_30870":139665,"_3543":139799},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_4098":83760,"_34307":83712,"_23429":139801,"_5":16198,"_30870":139669,"_3543":139802},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_4098":83761,"_34307":83712,"_23429":139804,"_5":16198,"_30870":139669,"_3543":139805},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_4098":83762,"_34307":83712,"_23429":139807,"_5":16198,"_30870":139673,"_3543":139808},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_4098":83763,"_34307":83712,"_23429":139810,"_5":16198,"_30870":139673,"_3543":139811},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_4098":83764,"_34307":83712,"_23429":139813,"_5":16198,"_30870":139677,"_3543":139814},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_4098":83765,"_34307":83712,"_23429":139816,"_5":16198,"_30870":139677,"_3543":139817},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_4098":83766,"_34307":83712,"_23429":139819,"_5":16198,"_30870":139681,"_3543":139820},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_4098":83767,"_34307":83712,"_23429":139822,"_5":16198,"_30870":139681,"_3543":139823},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_4098":83768,"_34307":83712,"_23429":139825,"_5":16198,"_30870":139681,"_3543":139826},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_4098":83769,"_34307":83712,"_23429":139828,"_5":16198,"_30870":139685,"_3543":139829},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_4098":83770,"_34307":83712,"_23429":139831,"_5":16198,"_30870":139689,"_3543":139832},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_4098":83771,"_34307":83712,"_23429":139834,"_5":16198,"_30870":139693,"_3543":139835},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_4098":83772,"_34307":83712,"_23429":139837,"_5":16198,"_30870":139697,"_3543":139838},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_4098":83773,"_34307":83712,"_23429":139840,"_5":16198,"_30870":139697,"_3543":139841},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_4098":83774,"_34307":83712,"_23429":139843,"_5":16198,"_30870":139701,"_3543":139844},[],"Abre una CA desde el inventario para consultar:",{"_4098":83775,"_34307":83712,"_23429":139846,"_5":16198,"_30870":139701,"_3543":139847},[],"Estado y periodo de validez.",{"_4098":83776,"_34307":83712,"_23429":139849,"_5":16198,"_30870":139701,"_3543":139850},[],"Certificado y cadena en formato PEM.",{"_4098":83777,"_34307":83712,"_23429":139852,"_5":16198,"_30870":139701,"_3543":139853},[],"Número de certificados activos, expirados y revocados.",{"_4098":83778,"_34307":83712,"_23429":139855,"_5":16198,"_30870":139701,"_3543":139856},[],"Certificados emitidos en **Issued Certificates**.",{"_4098":83779,"_34307":83712,"_23429":139858,"_5":16198,"_30870":139701,"_3543":139859},[],"CRL vinculada a la autoridad.",{"_4098":83780,"_34307":83712,"_23429":139861,"_5":16198,"_30870":139701,"_3543":139862},[],"Metadatos y motor criptográfico asociado.",{"_4098":83781,"_34307":83712,"_23429":139864,"_5":16198,"_30870":139701,"_3543":139865},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_4098":83782,"_34307":83712,"_23429":139867,"_5":16198,"_30870":139705,"_3543":139868},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_4098":83783,"_34307":83712,"_23429":139870,"_5":16198,"_30870":139705,"_3543":139871},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_4098":83784,"_34307":83712,"_23429":139873,"_5":16198,"_30870":139705,"_3543":139874},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_4098":83785,"_34307":83712,"_23429":139876,"_5":16198,"_30870":139705,"_3543":139877},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_4098":83786,"_34307":83712,"_23429":139879,"_5":16198,"_30870":139709,"_3543":139880},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_4098":83787,"_34307":83712,"_23429":139882,"_5":16198,"_30870":139713,"_3543":139883},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_4098":83788,"_34307":83712,"_23429":139885,"_5":16198,"_30870":139717,"_3543":139886},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_4098":83789,"_34307":83712,"_23429":139888,"_5":16198,"_30870":139721,"_3543":139889},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_4098":83790,"_34307":83712,"_23429":139891,"_5":16198,"_30870":139725,"_3543":139892},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_4098":83791,"_34307":83712,"_23429":139894,"_5":16198,"_30870":139729,"_3543":139895},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_4098":83792,"_34307":83712,"_23429":139897,"_5":16198,"_30870":139729,"_3543":139898},[],"El rol VA de la CA se conserva. Si no queda otra CA con el mismo SKI, deja de ser editable (consulta CRL), así que ajusta antes su validez y su firmante. La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_4098":83793,"_34307":83712,"_23429":139900,"_5":16198,"_30870":139729,"_3543":139901},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. Si el certificado nuevo usa la misma clave, comparte el SKI con el rol VA retenido de la CA eliminada, cuyo firmante es el certificado antiguo: comprueba que la CRL se genera y, si no es así, asigna con `PUT` un firmante de la CA nueva (consulta CRL).",{"_4098":83794,"_34307":83794,"_5":16596,"_3543":139903,"_34738":139904,"_23429":139905,"_30870":83794},"Perfiles de certificado",[56936,135600,62406,139475],[],{"_4098":83795,"_34307":83794,"_23429":139907,"_5":16198,"_30870":83794,"_3543":139908},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_4098":83796,"_34307":83794,"_5":34735,"_23429":139910,"_30870":139911,"_3543":139912},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_4098":83797,"_34307":83794,"_5":34735,"_23429":139914,"_30870":139915,"_3543":139916},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#validez","Validez",{"_4098":83798,"_34307":83794,"_5":34735,"_23429":139918,"_30870":139919,"_3543":139920},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_4098":83799,"_34307":83794,"_5":34735,"_23429":139922,"_30870":139923,"_3543":139924},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_4098":83800,"_34307":83794,"_5":34735,"_23429":139926,"_30870":139927,"_3543":139928},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_4098":83801,"_34307":83794,"_5":34735,"_23429":139930,"_30870":139931,"_3543":139932},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_4098":83802,"_34307":83794,"_5":34735,"_23429":139934,"_30870":139935,"_3543":139936},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_4098":83803,"_34307":83794,"_5":34735,"_23429":139938,"_30870":139939,"_3543":139940},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_4098":83804,"_34307":83794,"_5":34735,"_23429":139942,"_30870":139943,"_3543":139944},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_4098":83805,"_34307":83794,"_5":34735,"_23429":139946,"_30870":139947,"_3543":139948},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_4098":83806,"_34307":83794,"_5":34735,"_23429":139950,"_30870":139951,"_3543":139952},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_4098":83807,"_34307":83794,"_5":34735,"_23429":139954,"_30870":139955,"_3543":139956},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_4098":83808,"_34307":83794,"_5":34735,"_23429":139958,"_30870":139959,"_3543":139960},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_4098":83809,"_34307":83794,"_5":34735,"_23429":139962,"_30870":139963,"_3543":139964},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_4098":83810,"_34307":83794,"_5":34735,"_23429":139966,"_30870":139967,"_3543":139968},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_4098":83811,"_34307":83794,"_5":34735,"_23429":139970,"_30870":139971,"_3543":139972},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_4098":83812,"_34307":83794,"_23429":139974,"_5":16198,"_30870":83794,"_3543":139975},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_4098":83813,"_34307":83794,"_23429":139977,"_5":16198,"_30870":83794,"_3543":139978},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_4098":83814,"_34307":83794,"_23429":139980,"_5":16198,"_30870":139915,"_3543":139981},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_4098":83815,"_34307":83794,"_23429":139983,"_5":16198,"_30870":139915,"_3543":139984},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_4098":83816,"_34307":83794,"_23429":139986,"_5":16198,"_30870":139919,"_3543":139987},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_4098":83817,"_34307":83794,"_23429":139989,"_5":16198,"_30870":139923,"_3543":139990},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_4098":83818,"_34307":83794,"_23429":139992,"_5":16198,"_30870":139923,"_3543":139993},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_4098":83819,"_34307":83794,"_23429":139995,"_5":16198,"_30870":139923,"_3543":139996},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_4098":83820,"_34307":83794,"_23429":139998,"_5":16198,"_30870":139927,"_3543":139999},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_4098":83821,"_34307":83794,"_23429":140001,"_5":16198,"_30870":139931,"_3543":140002},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_4098":83822,"_34307":83794,"_23429":140004,"_5":16198,"_30870":139931,"_3543":140005},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_4098":83823,"_34307":83794,"_23429":140007,"_5":16198,"_30870":139935,"_3543":140008},[],"La aplicación criptográfica puede:",{"_4098":83824,"_34307":83794,"_23429":140010,"_5":16198,"_30870":139935,"_3543":140011},[],"permitir o bloquear claves RSA;",{"_4098":83825,"_34307":83794,"_23429":140013,"_5":16198,"_30870":139935,"_3543":140014},[],"limitar los tamaños RSA admitidos;",{"_4098":83826,"_34307":83794,"_23429":140016,"_5":16198,"_30870":139935,"_3543":140017},[],"permitir o bloquear claves ECDSA;",{"_4098":83827,"_34307":83794,"_23429":140019,"_5":16198,"_30870":139935,"_3543":140020},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_4098":83828,"_34307":83794,"_23429":140022,"_5":16198,"_30870":139935,"_3543":140023},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_4098":83829,"_34307":83794,"_23429":140025,"_5":16198,"_30870":139939,"_3543":140026},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_4098":83830,"_34307":83794,"_23429":140028,"_5":16198,"_30870":139939,"_3543":135360},[],{"_4098":83831,"_34307":83794,"_23429":140030,"_5":16198,"_30870":139939,"_3543":140031},[],"Primera opción",{"_4098":83832,"_34307":83794,"_23429":140033,"_5":16198,"_30870":139939,"_3543":140034},[],"Segunda opción",{"_4098":83833,"_34307":83794,"_23429":140036,"_5":16198,"_30870":139939,"_3543":140037},[],"Si no hay ninguna",{"_4098":83834,"_34307":83794,"_23429":140039,"_5":16198,"_30870":139939,"_3543":140040},[],"Firma directa con una CA",{"_4098":83835,"_34307":83794,"_23429":140042,"_5":16198,"_30870":139939,"_3543":140043},[],"`issuance_profile` incluido en la solicitud",{"_4098":83836,"_34307":83794,"_23429":140045,"_5":16198,"_30870":139939,"_3543":140046},[],"`issuance_profile_id` de la solicitud",{"_4098":83837,"_34307":83794,"_23429":140048,"_5":16198,"_30870":139939,"_3543":140049},[],"Perfil predeterminado de la CA (`profile_id`).",{"_4098":83838,"_34307":83794,"_23429":140051,"_5":16198,"_30870":139939,"_3543":140052},[],"Emisión mediante DMS",{"_4098":83839,"_34307":83794,"_23429":140054,"_5":16198,"_30870":139939,"_3543":62987},[],{"_4098":83840,"_34307":83794,"_23429":140056,"_5":16198,"_30870":139939,"_3543":140057},[],"`settings.issuance_profile` incluido en el DMS",{"_4098":83841,"_34307":83794,"_23429":140059,"_5":16198,"_30870":139939,"_3543":140060},[],"Perfil predeterminado de la CA de enrolamiento.",{"_4098":83842,"_34307":83794,"_23429":140062,"_5":16198,"_30870":139939,"_3543":140063},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_4098":83843,"_34307":83794,"_23429":140065,"_5":16198,"_30870":139939,"_3543":140066},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_4098":83844,"_34307":83794,"_23429":140068,"_5":16198,"_30870":139947,"_3543":140069},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_4098":83845,"_34307":83794,"_23429":140071,"_5":16198,"_30870":139951,"_3543":140072},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_4098":83846,"_34307":83794,"_23429":140074,"_5":16198,"_30870":139955,"_3543":140075},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_4098":83847,"_34307":83794,"_23429":140077,"_5":16198,"_30870":139959,"_3543":140078},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_4098":83848,"_34307":83794,"_23429":140080,"_5":16198,"_30870":139963,"_3543":140081},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_4098":83849,"_34307":83794,"_23429":140083,"_5":16198,"_30870":139963,"_3543":140084},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_4098":83850,"_34307":83794,"_23429":140086,"_5":16198,"_30870":139967,"_3543":140087},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_4098":83851,"_34307":83794,"_23429":140089,"_5":16198,"_30870":139967,"_3543":140090},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_4098":83852,"_34307":83794,"_23429":140092,"_5":16198,"_30870":139967,"_3543":140093},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_4098":83853,"_34307":83794,"_23429":140095,"_5":16198,"_30870":139967,"_3543":140096},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_4098":83854,"_34307":83794,"_23429":140098,"_5":16198,"_30870":139971,"_3543":140099},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_4098":83855,"_34307":83794,"_23429":140101,"_5":16198,"_30870":139971,"_3543":140102},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_4098":83856,"_34307":83856,"_5":16596,"_3543":140104,"_34738":140105,"_23429":140107,"_30870":83856},"Validación de certificados",[56936,135600,62406,140106],"Validación",[],{"_4098":83857,"_34307":83856,"_23429":140109,"_5":16198,"_30870":83856,"_3543":140110},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_4098":83858,"_34307":83856,"_5":34735,"_23429":140112,"_30870":140113,"_3543":140114},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_4098":83859,"_34307":83856,"_5":34735,"_23429":140116,"_30870":140117,"_3543":140118},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_4098":83860,"_34307":83856,"_5":34735,"_23429":140120,"_30870":140121,"_3543":140122},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_4098":83861,"_34307":83856,"_23429":140124,"_5":16198,"_30870":83856,"_3543":140125},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_4098":83862,"_34307":83856,"_23429":140127,"_5":16198,"_30870":140113,"_3543":140128},[],"Verifica estos criterios juntos:",{"_4098":83863,"_34307":83856,"_23429":140130,"_5":16198,"_30870":140113,"_3543":139104},[],{"_4098":83864,"_34307":83856,"_23429":140132,"_5":16198,"_30870":140113,"_3543":140133},[],"Resultado necesario",{"_4098":83865,"_34307":83856,"_23429":140135,"_5":16198,"_30870":140113,"_3543":140136},[],"Cadena y firma",{"_4098":83866,"_34307":83856,"_23429":140138,"_5":16198,"_30870":140113,"_3543":140139},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_4098":83867,"_34307":83856,"_23429":140141,"_5":16198,"_30870":140113,"_3543":140142},[],"Fechas",{"_4098":83868,"_34307":83856,"_23429":140144,"_5":16198,"_30870":140113,"_3543":140145},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_4098":83869,"_34307":83856,"_23429":140147,"_5":16198,"_30870":140113,"_3543":135270},[],{"_4098":83870,"_34307":83856,"_23429":140149,"_5":16198,"_30870":140113,"_3543":140150},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_4098":83871,"_34307":83856,"_23429":140152,"_5":16198,"_30870":140113,"_3543":140153},[],"Uso",{"_4098":83872,"_34307":83856,"_23429":140155,"_5":16198,"_30870":140113,"_3543":140156},[],"KU, EKU y restricciones permiten la operación concreta.",{"_4098":83873,"_34307":83856,"_23429":140158,"_5":16198,"_30870":140113,"_3543":140159},[],"Revocación",{"_4098":83874,"_34307":83856,"_23429":140161,"_5":16198,"_30870":140113,"_3543":140162},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_4098":83875,"_34307":83856,"_23429":140164,"_5":16198,"_30870":140113,"_3543":140165},[],"Autorización",{"_4098":83876,"_34307":83856,"_23429":140167,"_5":16198,"_30870":140113,"_3543":140168},[],"La aplicación permite la acción a esa identidad.",{"_4098":83877,"_34307":83856,"_23429":140170,"_5":16198,"_30870":140113,"_3543":140171},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_4098":83878,"_34307":83856,"_23429":140173,"_5":16198,"_30870":140117,"_3543":140174},[],"Mecanismo",{"_4098":83879,"_34307":83856,"_23429":140176,"_5":16198,"_30870":140117,"_3543":140177},[],"Cuándo utilizarlo",{"_4098":83880,"_34307":83856,"_23429":140179,"_5":16198,"_30870":140117,"_3543":140180},[],"Qué debes mantener",{"_4098":83881,"_34307":83856,"_23429":140182,"_5":16198,"_30870":140117,"_3543":63115},[],{"_4098":83882,"_34307":83856,"_23429":140184,"_5":16198,"_30870":140117,"_3543":140185},[],"Consulta del estado de un certificado concreto.",{"_4098":83883,"_34307":83856,"_23429":140187,"_5":16198,"_30870":140117,"_3543":140188},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_4098":83884,"_34307":83856,"_23429":140190,"_5":16198,"_30870":140117,"_3543":63124},[],{"_4098":83885,"_34307":83856,"_23429":140192,"_5":16198,"_30870":140117,"_3543":140193},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_4098":83886,"_34307":83856,"_23429":140195,"_5":16198,"_30870":140117,"_3543":140196},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_4098":83887,"_34307":83856,"_23429":140198,"_5":16198,"_30870":140117,"_3543":140199},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_4098":83888,"_34307":83856,"_23429":140201,"_5":16198,"_30870":140117,"_3543":140202},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_4098":83889,"_34307":83856,"_23429":140204,"_5":16198,"_30870":140121,"_3543":140205},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_4098":83890,"_34307":83856,"_23429":140207,"_5":16198,"_30870":140121,"_3543":140208},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_4098":83891,"_34307":83856,"_23429":140210,"_5":16198,"_30870":140121,"_3543":140211},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_4098":83892,"_34307":83856,"_23429":140213,"_5":16198,"_30870":140121,"_3543":140214},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_4098":83893,"_34307":83856,"_23429":140216,"_5":16198,"_30870":140121,"_3543":140217},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_4098":83894,"_34307":83856,"_23429":140219,"_5":16198,"_30870":140121,"_3543":140220},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_4098":83895,"_34307":83856,"_23429":140222,"_5":16198,"_30870":140121,"_3543":140223},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_4098":83896,"_34307":83856,"_23429":140225,"_5":16198,"_30870":140121,"_3543":140226},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_4098":83897,"_34307":83856,"_23429":140228,"_5":16198,"_30870":140121,"_3543":140229},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_4098":83898,"_34307":83898,"_5":16596,"_3543":140231,"_34738":140232,"_23429":140233,"_30870":83898},"Certificados",[56936,135600,62406,139475],[],{"_4098":83899,"_34307":83898,"_23429":140235,"_5":16198,"_30870":83898,"_3543":140236},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_4098":83900,"_34307":83898,"_5":34735,"_23429":140238,"_30870":140239,"_3543":140240},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_4098":83901,"_34307":83898,"_5":34735,"_23429":140242,"_30870":140243,"_3543":140244},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_4098":83902,"_34307":83898,"_5":34735,"_23429":140246,"_30870":140247,"_3543":140248},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_4098":83903,"_34307":83898,"_5":34735,"_23429":140250,"_30870":140251,"_3543":140252},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_4098":83904,"_34307":83898,"_5":34735,"_23429":140254,"_30870":140255,"_3543":140256},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_4098":83905,"_34307":83898,"_5":34735,"_23429":140258,"_30870":140259,"_3543":140260},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_4098":83906,"_34307":83898,"_5":34735,"_23429":140262,"_30870":140263,"_3543":140264},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_4098":83907,"_34307":83898,"_5":34735,"_23429":140266,"_30870":140267,"_3543":140268},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_4098":83908,"_34307":83898,"_5":34735,"_23429":140270,"_30870":140271,"_3543":140272},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#continúa","Continúa",{"_4098":83909,"_34307":83898,"_23429":140274,"_5":16198,"_30870":83898,"_3543":140275},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_4098":83910,"_34307":83898,"_23429":140277,"_5":16198,"_30870":140239,"_3543":140278},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_4098":83911,"_34307":83898,"_23429":140280,"_5":16198,"_30870":140239,"_3543":140281},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_4098":83912,"_34307":83898,"_23429":140283,"_5":16198,"_30870":140239,"_3543":140284},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_4098":83913,"_34307":83898,"_23429":140286,"_5":16198,"_30870":140239,"_3543":140287},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_4098":83914,"_34307":83898,"_23429":140289,"_5":16198,"_30870":140239,"_3543":140290},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_4098":83915,"_34307":83898,"_23429":140292,"_5":16198,"_30870":140239,"_3543":140293},[],"Los detalles del certificado incluyen la referencia a la clave (`key_id`) y si la clave privada está gestionada (`has_private_key`); las listas de certificados pueden filtrarse por `has_private_key`.",{"_4098":83916,"_34307":83898,"_23429":140295,"_5":16198,"_30870":140239,"_3543":140296},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_4098":83917,"_34307":83898,"_23429":140298,"_5":16198,"_30870":140243,"_3543":140299},[],"Descarga el PEM e inspecciónalo:",{"_4098":83918,"_34307":83898,"_23429":140301,"_5":16198,"_30870":140243,"_3543":140302},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_4098":83919,"_34307":83898,"_23429":140304,"_5":16198,"_30870":140247,"_3543":140305},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_4098":83920,"_34307":83898,"_23429":140307,"_5":16198,"_30870":140247,"_3543":140308},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_4098":83921,"_34307":83898,"_23429":140310,"_5":16198,"_30870":140247,"_3543":140311},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_4098":83922,"_34307":83898,"_23429":140313,"_5":16198,"_30870":140247,"_3543":140314},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_4098":83923,"_34307":83898,"_23429":140316,"_5":16198,"_30870":140247,"_3543":140317},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_4098":83924,"_34307":83898,"_23429":140319,"_5":16198,"_30870":140247,"_3543":140320},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_4098":83925,"_34307":83898,"_23429":140322,"_5":16198,"_30870":140247,"_3543":140323},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_4098":83926,"_34307":83898,"_23429":140325,"_5":16198,"_30870":140251,"_3543":140326},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_4098":83927,"_34307":83898,"_23429":140328,"_5":16198,"_30870":140255,"_3543":140329},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_4098":83928,"_34307":83898,"_23429":140331,"_5":16198,"_30870":140259,"_3543":140332},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_4098":83929,"_34307":83898,"_23429":140334,"_5":16198,"_30870":140263,"_3543":140335},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_4098":83930,"_34307":83898,"_23429":140337,"_5":16198,"_30870":140263,"_3543":140338},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_4098":83931,"_34307":83898,"_23429":140340,"_5":16198,"_30870":140263,"_3543":140341},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_4098":83932,"_34307":83898,"_23429":140343,"_5":16198,"_30870":140267,"_3543":140344},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_4098":83933,"_34307":83898,"_23429":140346,"_5":16198,"_30870":140267,"_3543":140347},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_4098":83934,"_34307":83898,"_23429":140349,"_5":16198,"_30870":140267,"_3543":140350},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_4098":83935,"_34307":83898,"_23429":140352,"_5":16198,"_30870":140271,"_3543":140353},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_4098":83936,"_34307":83898,"_23429":140355,"_5":16198,"_30870":140271,"_3543":140356},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_4098":83937,"_34307":83937,"_5":16596,"_3543":140358,"_34738":140359,"_23429":140361,"_30870":83937},"Ciclo de vida de un certificado",[56936,135600,62406,140360],"Conceptos",[],{"_4098":83938,"_34307":83937,"_23429":140363,"_5":16198,"_30870":83937,"_3543":140364},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_4098":83939,"_34307":83937,"_5":34735,"_23429":140366,"_30870":140367,"_3543":140368},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_4098":83940,"_34307":83937,"_5":34735,"_23429":140370,"_30870":140371,"_3543":140372},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_4098":83941,"_34307":83937,"_5":34735,"_23429":140374,"_30870":140375,"_3543":140376},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_4098":83942,"_34307":83937,"_5":34735,"_23429":140378,"_30870":140379,"_3543":140380},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_4098":83943,"_34307":83937,"_5":34735,"_23429":140382,"_30870":140383,"_3543":140384},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_4098":83944,"_34307":83937,"_5":34735,"_23429":140386,"_30870":140387,"_3543":140388},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_4098":83945,"_34307":83937,"_5":34735,"_23429":140390,"_30870":140391,"_3543":138098},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_4098":83946,"_34307":83937,"_5":34735,"_23429":140393,"_30870":140394,"_3543":140395},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_4098":83947,"_34307":83937,"_5":34735,"_23429":140397,"_30870":140398,"_3543":140399},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_4098":83948,"_34307":83937,"_5":34735,"_23429":140401,"_30870":140402,"_3543":140403},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_4098":83949,"_34307":83937,"_23429":140405,"_5":16198,"_30870":83937,"_3543":140406},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_4098":83950,"_34307":83937,"_23429":140408,"_5":16198,"_30870":140371,"_3543":140409},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_4098":83951,"_34307":83937,"_23429":140411,"_5":16198,"_30870":140375,"_3543":140412},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_4098":83952,"_34307":83937,"_23429":140414,"_5":16198,"_30870":140379,"_3543":140415},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_4098":83953,"_34307":83937,"_23429":140417,"_5":16198,"_30870":140383,"_3543":140418},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_4098":83954,"_34307":83937,"_23429":140420,"_5":16198,"_30870":140387,"_3543":140421},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_4098":83955,"_34307":83937,"_23429":140423,"_5":16198,"_30870":140391,"_3543":140424},[],"Lamassu persiste cuatro estados X.509:",{"_4098":83956,"_34307":83937,"_23429":140426,"_5":16198,"_30870":140391,"_3543":140427},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_4098":83957,"_34307":83937,"_23429":140429,"_5":16198,"_30870":140391,"_3543":140430},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_4098":83958,"_34307":83937,"_23429":140432,"_5":16198,"_30870":140391,"_3543":140433},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_4098":83959,"_34307":83937,"_23429":140435,"_5":16198,"_30870":140391,"_3543":140436},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_4098":83960,"_34307":83937,"_23429":140438,"_5":16198,"_30870":140391,"_3543":140439},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_4098":83961,"_34307":83937,"_23429":140441,"_5":16198,"_30870":140394,"_3543":140442},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_4098":83962,"_34307":83937,"_23429":140444,"_5":16198,"_30870":140394,"_3543":140445},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_4098":83963,"_34307":83937,"_23429":140447,"_5":16198,"_30870":140394,"_3543":140448},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_4098":83964,"_34307":83937,"_23429":140450,"_5":16198,"_30870":140398,"_3543":140451},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_4098":83965,"_34307":83937,"_23429":140453,"_5":16198,"_30870":140398,"_3543":140454},[],"Antes de confirmar:",{"_4098":83966,"_34307":83937,"_23429":140456,"_5":16198,"_30870":140398,"_3543":140457},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_4098":83967,"_34307":83937,"_23429":140459,"_5":16198,"_30870":140398,"_3543":140460},[],"Distribuye la nueva cadena de confianza.",{"_4098":83968,"_34307":83937,"_23429":140462,"_5":16198,"_30870":140398,"_3543":140463},[],"Reemite las identidades necesarias.",{"_4098":83969,"_34307":83937,"_23429":140465,"_5":16198,"_30870":140398,"_3543":140466},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_4098":83970,"_34307":83937,"_23429":140468,"_5":16198,"_30870":140398,"_3543":140469},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_4098":83971,"_34307":83937,"_23429":140471,"_5":16198,"_30870":140398,"_3543":140472},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_4098":83972,"_34307":83937,"_23429":140474,"_5":16198,"_30870":140402,"_3543":140475},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_4098":83973,"_34307":83937,"_23429":140477,"_5":16198,"_30870":140402,"_3543":140478},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_4098":83974,"_34307":83937,"_23429":140480,"_5":16198,"_30870":140402,"_3543":140481},[],"Cambios de estado y razones de revocación.",{"_4098":83975,"_34307":83937,"_23429":140483,"_5":16198,"_30870":140402,"_3543":140484},[],"Publicación y vigencia de OCSP y CRLs.",{"_4098":83976,"_34307":83937,"_23429":140486,"_5":16198,"_30870":140402,"_3543":140487},[],"Dependencias que todavía presentan un certificado sustituido.",{"_4098":83977,"_34307":83937,"_23429":140489,"_5":16198,"_30870":140402,"_3543":140490},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_4098":83978,"_34307":83978,"_5":16596,"_3543":140492,"_34738":140493,"_23429":140494,"_30870":83978},"Modelo de confianza",[56936,135600,62406,140360],[],{"_4098":83979,"_34307":83978,"_23429":140496,"_5":16198,"_30870":83978,"_3543":140497},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_4098":83980,"_34307":83978,"_5":34735,"_23429":140499,"_30870":140500,"_3543":140501},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_4098":83981,"_34307":83978,"_5":34735,"_23429":140503,"_30870":140504,"_3543":140505},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_4098":83982,"_34307":83978,"_5":34735,"_23429":140507,"_30870":140508,"_3543":140509},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_4098":83983,"_34307":83978,"_5":34735,"_23429":140511,"_30870":140512,"_3543":140513},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_4098":83984,"_34307":83978,"_5":34735,"_23429":140515,"_30870":140516,"_3543":140517},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_4098":83985,"_34307":83978,"_5":34735,"_23429":140519,"_30870":140520,"_3543":140521},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_4098":83986,"_34307":83978,"_5":34735,"_23429":140523,"_30870":140524,"_3543":140525},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_4098":83987,"_34307":83978,"_5":34735,"_23429":140527,"_30870":140528,"_3543":140529},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_4098":83988,"_34307":83978,"_5":34735,"_23429":140531,"_30870":140532,"_3543":140533},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_4098":83989,"_34307":83978,"_5":34735,"_23429":140535,"_30870":140536,"_3543":140537},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_4098":83990,"_34307":83978,"_23429":140539,"_5":16198,"_30870":83978,"_3543":140540},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_4098":83991,"_34307":83978,"_23429":140542,"_5":16198,"_30870":140504,"_3543":140543},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_4098":83992,"_34307":83978,"_23429":140545,"_5":16198,"_30870":140508,"_3543":140546},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_4098":83993,"_34307":83978,"_23429":140548,"_5":16198,"_30870":140512,"_3543":140549},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_4098":83994,"_34307":83978,"_23429":140551,"_5":16198,"_30870":140516,"_3543":140552},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_4098":83995,"_34307":83978,"_23429":140554,"_5":16198,"_30870":140520,"_3543":140555},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_4098":83996,"_34307":83978,"_23429":140557,"_5":16198,"_30870":140520,"_3543":140558},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_4098":83997,"_34307":83978,"_23429":140560,"_5":16198,"_30870":140520,"_3543":140561},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_4098":83998,"_34307":83978,"_23429":140563,"_5":16198,"_30870":140520,"_3543":140564},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_4098":83999,"_34307":83978,"_23429":140566,"_5":16198,"_30870":140520,"_3543":140567},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_4098":84000,"_34307":83978,"_23429":140569,"_5":16198,"_30870":140520,"_3543":140570},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_4098":84001,"_34307":83978,"_23429":140572,"_5":16198,"_30870":140524,"_3543":140573},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_4098":84002,"_34307":83978,"_23429":140575,"_5":16198,"_30870":140524,"_3543":140576},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_4098":84003,"_34307":83978,"_23429":140578,"_5":16198,"_30870":140524,"_3543":140579},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_4098":84004,"_34307":83978,"_23429":140581,"_5":16198,"_30870":140524,"_3543":140582},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_4098":84005,"_34307":83978,"_23429":140584,"_5":16198,"_30870":140524,"_3543":140585},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_4098":84006,"_34307":83978,"_23429":140587,"_5":16198,"_30870":140528,"_3543":140588},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_4098":84007,"_34307":83978,"_23429":140590,"_5":16198,"_30870":140528,"_3543":140591},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_4098":84008,"_34307":83978,"_23429":140593,"_5":16198,"_30870":140528,"_3543":140594},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_4098":84009,"_34307":83978,"_23429":140596,"_5":16198,"_30870":140528,"_3543":140597},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_4098":84010,"_34307":83978,"_23429":140599,"_5":16198,"_30870":140528,"_3543":140600},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_4098":84011,"_34307":83978,"_23429":140602,"_5":16198,"_30870":140528,"_3543":140603},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_4098":84012,"_34307":83978,"_23429":140605,"_5":16198,"_30870":140528,"_3543":140606},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_4098":84013,"_34307":83978,"_23429":140608,"_5":16198,"_30870":140532,"_3543":140609},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_4098":84014,"_34307":83978,"_23429":140611,"_5":16198,"_30870":140536,"_3543":140612},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_4098":84015,"_34307":83978,"_23429":140614,"_5":16198,"_30870":140536,"_3543":140615},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_4098":84016,"_34307":83978,"_23429":140617,"_5":16198,"_30870":140536,"_3543":140618},[],"Asigna perfiles explícitos a cada caso de uso.",{"_4098":84017,"_34307":83978,"_23429":140620,"_5":16198,"_30870":140536,"_3543":140621},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_4098":84018,"_34307":83978,"_23429":140623,"_5":16198,"_30870":140536,"_3543":140624},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_4098":84019,"_34307":83978,"_23429":140626,"_5":16198,"_30870":140536,"_3543":140627},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_4098":84020,"_34307":83978,"_23429":140629,"_5":16198,"_30870":140536,"_3543":140630},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_4098":84021,"_34307":84021,"_5":16596,"_3543":140632,"_34738":140633,"_23429":140634,"_30870":84021},"Listas de revocación (CRL)",[56936,135600,62406,140106],[],{"_4098":84022,"_34307":84021,"_23429":140636,"_5":16198,"_30870":84021,"_3543":140637},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_4098":84023,"_34307":84021,"_5":34735,"_23429":140639,"_30870":140640,"_3543":140641},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_4098":84024,"_34307":84021,"_5":34735,"_23429":140643,"_30870":140644,"_3543":140645},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_4098":84025,"_34307":84021,"_5":34735,"_23429":140647,"_30870":140648,"_3543":140649},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_4098":84026,"_34307":84021,"_5":34735,"_23429":140651,"_30870":140652,"_3543":140653},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_4098":84027,"_34307":84021,"_5":34735,"_23429":140655,"_30870":140656,"_3543":140657},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_4098":84028,"_34307":84021,"_5":34735,"_23429":140659,"_30870":140660,"_3543":140661},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_4098":84029,"_34307":84021,"_5":34735,"_23429":140663,"_30870":140664,"_3543":140665},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#errores-frecuentes-del-rol-va","Errores frecuentes del rol VA",{"_4098":84030,"_34307":84021,"_5":34735,"_23429":140667,"_30870":140668,"_3543":140669},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_4098":84031,"_34307":84021,"_5":34735,"_23429":140671,"_30870":140672,"_3543":140673},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#referencias","Referencias",{"_4098":84032,"_34307":84021,"_23429":140675,"_5":16198,"_30870":84021,"_3543":140676},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_4098":84033,"_34307":84021,"_23429":140678,"_5":16198,"_30870":140640,"_3543":140679},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_4098":84034,"_34307":84021,"_23429":140681,"_5":16198,"_30870":140640,"_3543":140682},[],"Campo de `crl_options`",{"_4098":84035,"_34307":84021,"_23429":140684,"_5":16198,"_30870":140640,"_3543":137138},[],{"_4098":84036,"_34307":84021,"_23429":140686,"_5":16198,"_30870":140640,"_3543":140687},[],"Valor inicial del backend",{"_4098":84037,"_34307":84021,"_23429":140689,"_5":16198,"_30870":140640,"_3543":63625},[],{"_4098":84038,"_34307":84021,"_23429":140691,"_5":16198,"_30870":140640,"_3543":140692},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_4098":84039,"_34307":84021,"_23429":140694,"_5":16198,"_30870":140640,"_3543":140695},[],"7 días.",{"_4098":84040,"_34307":84021,"_23429":140697,"_5":16198,"_30870":140640,"_3543":63634},[],{"_4098":84041,"_34307":84021,"_23429":140699,"_5":16198,"_30870":140640,"_3543":140700},[],"Se guarda y se devuelve por la API, pero la VA no lo utiliza: la renovación programada no depende de él (consulta Regeneración periódica y automática).",{"_4098":84042,"_34307":84021,"_23429":140702,"_5":16198,"_30870":140640,"_3543":140703},[],"6 días y 23 horas.",{"_4098":84043,"_34307":84021,"_23429":140705,"_5":16198,"_30870":140640,"_3543":63643},[],{"_4098":84044,"_34307":84021,"_23429":140707,"_5":16198,"_30870":140640,"_3543":140708},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_4098":84045,"_34307":84021,"_23429":140710,"_5":16198,"_30870":140640,"_3543":63649},[],{"_4098":84046,"_34307":84021,"_23429":140712,"_5":16198,"_30870":140640,"_3543":63652},[],{"_4098":84047,"_34307":84021,"_23429":140714,"_5":16198,"_30870":140640,"_3543":140715},[],"Número de serie del certificado existente que firma la CRL.",{"_4098":84048,"_34307":84021,"_23429":140717,"_5":16198,"_30870":140640,"_3543":140718},[],"Número de serie del certificado actual de la CA.",{"_4098":84049,"_34307":84021,"_23429":140720,"_5":16198,"_30870":140640,"_3543":140721},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_4098":84050,"_34307":84021,"_23429":140723,"_5":16198,"_30870":140640,"_3543":140724},[],"Al reemitir una CA, el rol sigue apuntando al certificado anterior. Las CRL siguen siendo válidas porque ambos certificados comparten sujeto y clave, pero el certificado anterior no puede eliminarse mientras el rol lo use. Para retirarlo, actualiza el firmante del rol.",{"_4098":84051,"_34307":84021,"_23429":140726,"_5":16198,"_30870":140640,"_3543":140727},[],"Al eliminar una CA, su rol VA se conserva y no puede borrarse por API. Si no queda ninguna otra CA con el mismo SKI, el rol puede consultarse pero cualquier `PUT` devuelve 404, y el trabajo de renovación registra un aviso en cada ciclo porque ya no encuentra la CA. La API no ofrece salida; solo se corrige editando la base de datos. Si queda otra CA con ese SKI, el rol sigue siendo editable (consulta CAs que comparten clave). Ajusta validez y firmante antes de eliminar la CA.",{"_4098":84052,"_34307":84021,"_23429":140729,"_5":16198,"_30870":140640,"_3543":140730},[],"Una CA cuyo certificado no tiene `cRLSign` no puede generar su CRL ni editar su rol (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y asígnalo como firmante con `PUT`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original.",{"_4098":84053,"_34307":84021,"_23429":140732,"_5":16198,"_30870":140640,"_3543":140733},[],"El `PUT` valida siempre el firmante, aunque la petición no lo cambie. Si el firmante guardado ya no es válido, no se puede modificar ningún campo del rol, ni siquiera la validez, hasta asignar uno válido.",{"_4098":84054,"_34307":84021,"_23429":140735,"_5":16198,"_30870":140640,"_3543":140736},[],"Compartir una clave entre CA puede impedir la validación de las CRL. Consulta CAs que comparten clave.",{"_4098":84055,"_34307":84021,"_23429":140738,"_5":16198,"_30870":140640,"_3543":140739},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_4098":84056,"_34307":84021,"_23429":140741,"_5":16198,"_30870":140644,"_3543":140742},[],"La VA identifica cada CRL por el SKI de la CA, y el SKI se deriva de su clave. Dos CAs con la misma clave tienen el mismo SKI y comparten un único rol VA y una única CRL. Ocurre al crear una CA sobre una clave ya existente del KMS, o al importar una CA cuyo certificado declara un SKI en uso. Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. El rol lo crea la primera CA y las demás lo conservan.",{"_4098":84057,"_34307":84021,"_23429":140744,"_5":16198,"_30870":140644,"_3543":140745},[],"Los certificados de todas ellas apuntan a `/crl/{ski}`, pero la lista publicada tiene como emisor a la primera CA y solo incluye sus revocaciones. Un verificador compara el emisor de la CRL con el del certificado que valida (RFC 5280, §6.3.2) y rechaza la lista si no coinciden. Según su política, el certificado queda bloqueado (*hard-fail*) o se acepta aunque esté revocado (*soft-fail*). Las revocaciones de las CAs secundarias no aparecen en ninguna lista.",{"_4098":84058,"_34307":84021,"_23429":140747,"_5":16198,"_30870":140644,"_3543":140748},[],"Si la primera CA se elimina, la generación de CRL de la restante falla porque el firmante configurado ya no corresponde a una CA con ese nombre. Hasta que se actualice el firmante del rol a un certificado de la CA restante, se sigue sirviendo la última lista publicada hasta que venza (7 días por defecto).",{"_4098":84059,"_34307":84021,"_23429":140750,"_5":16198,"_30870":140644,"_3543":140751},[],"Antes de actualizar, revisa las CAs que comparten clave. Para detectar el problema, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos. Una CA importada con un SKI ya en uso no sustituye a la existente como emisora de la CRL, porque el emisor se resuelve a partir del firmante del rol. Sin embargo, sus propios certificados apuntan a esa misma URL y sus revocaciones no se publican. Hasta que Lamassu rechace estas importaciones, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión, así que tampoco reutilices claves entre CAs. Una CRL por CA y el rechazo de importaciones cuyo SKI colisiona con el de una CA existente están planteados en lamassuiot#834, y ninguno está implementado todavía.",{"_4098":84060,"_34307":84021,"_23429":140753,"_5":16198,"_30870":140648,"_3543":140754},[],"El trabajo programado de la VA revisa todos los roles en cada ejecución y solicita otra lista cuando a `latest_crl` le queda menos validez que el intervalo entre ejecuciones. La frecuencia se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. `refresh_interval` no interviene. Mantén `validity` claramente por encima del intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_4098":84061,"_34307":84021,"_23429":140756,"_5":16198,"_30870":140648,"_3543":140757},[],"Si la generación falla (por ejemplo, por un rol sin CA o un firmante inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ski>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_4098":84062,"_34307":84021,"_23429":140759,"_5":16198,"_30870":140648,"_3543":140760},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla (rol inexistente, firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_4098":84063,"_34307":84021,"_23429":140762,"_5":16198,"_30870":140648,"_3543":140763},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_4098":84064,"_34307":84021,"_23429":140765,"_5":16198,"_30870":140652,"_3543":140766},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_4098":84065,"_34307":84021,"_23429":140768,"_5":16198,"_30870":140652,"_3543":140769},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_4098":84066,"_34307":84021,"_23429":140771,"_5":16198,"_30870":140656,"_3543":140772},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_4098":84067,"_34307":84021,"_23429":140774,"_5":16198,"_30870":140656,"_3543":140775},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_4098":84068,"_34307":84021,"_23429":140777,"_5":16198,"_30870":140656,"_3543":140778},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando el rol apunta a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_4098":84069,"_34307":84021,"_23429":140780,"_5":16198,"_30870":140656,"_3543":140781},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_4098":84070,"_34307":84021,"_23429":140783,"_5":16198,"_30870":140656,"_3543":140784},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_4098":84071,"_34307":84021,"_23429":140786,"_5":16198,"_30870":140660,"_3543":140787},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_4098":84072,"_34307":84021,"_23429":140789,"_5":16198,"_30870":140660,"_3543":137327},[],{"_4098":84073,"_34307":84021,"_23429":140791,"_5":16198,"_30870":140660,"_3543":140792},[],"Path relativo",{"_4098":84074,"_34307":84021,"_23429":140794,"_5":16198,"_30870":140660,"_3543":135360},[],{"_4098":84075,"_34307":84021,"_23429":140796,"_5":16198,"_30870":140660,"_3543":63737},[],{"_4098":84076,"_34307":84021,"_23429":140798,"_5":16198,"_30870":140660,"_3543":63740},[],{"_4098":84077,"_34307":84021,"_23429":140800,"_5":16198,"_30870":140660,"_3543":140801},[],"Consultar `crl_options` y `latest_crl`.",{"_4098":84078,"_34307":84021,"_23429":140803,"_5":16198,"_30870":140660,"_3543":63746},[],{"_4098":84079,"_34307":84021,"_23429":140805,"_5":16198,"_30870":140660,"_3543":63740},[],{"_4098":84080,"_34307":84021,"_23429":140807,"_5":16198,"_30870":140660,"_3543":140808},[],"Sustituir la configuración de CRL.",{"_4098":84081,"_34307":84021,"_23429":140810,"_5":16198,"_30870":140660,"_3543":140811},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_4098":84082,"_34307":84021,"_23429":140813,"_5":16198,"_30870":140660,"_3543":140814},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_4098":84083,"_34307":84021,"_23429":140816,"_5":16198,"_30870":140664,"_3543":140817},[],"Síntoma",{"_4098":84084,"_34307":84021,"_23429":140819,"_5":16198,"_30870":140664,"_3543":140820},[],"Causa",{"_4098":84085,"_34307":84021,"_23429":140822,"_5":16198,"_30870":140664,"_3543":140823},[],"Acción",{"_4098":84086,"_34307":84021,"_23429":140825,"_5":16198,"_30870":140664,"_3543":140826},[],"`PUT /v1/roles/{ca-ski}` devuelve 404 y `GET` devuelve 200.",{"_4098":84087,"_34307":84021,"_23429":140828,"_5":16198,"_30870":140664,"_3543":140829},[],"Se eliminó la CA del rol y no queda otra con el mismo SKI.",{"_4098":84088,"_34307":84021,"_23429":140831,"_5":16198,"_30870":140664,"_3543":140832},[],"No hay salida por API; requiere intervención en la base de datos. Evítalo ajustando el rol antes de eliminar la CA.",{"_4098":84089,"_34307":84021,"_23429":140834,"_5":16198,"_30870":140664,"_3543":140835},[],"`PUT` devuelve 400.",{"_4098":84090,"_34307":84021,"_23429":140837,"_5":16198,"_30870":140664,"_3543":140838},[],"El firmante no tiene `cRLSign`, o su sujeto y su clave no coinciden con ninguna CA de ese SKI (por ejemplo, tras eliminar la primera de dos CAs que comparten clave).",{"_4098":84091,"_34307":84021,"_23429":140840,"_5":16198,"_30870":140664,"_3543":140841},[],"Asigna con `PUT` el número de serie de un certificado válido de la CA restante.",{"_4098":84092,"_34307":84021,"_23429":140843,"_5":16198,"_30870":140664,"_3543":140844},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_4098":84093,"_34307":84021,"_23429":140846,"_5":16198,"_30870":140664,"_3543":140847},[],"`crl_options.subject_key_id_signer` se sustituyó por `signer_certificate_serial_number`, que es obligatorio.",{"_4098":84094,"_34307":84021,"_23429":140849,"_5":16198,"_30870":140664,"_3543":140850},[],"Actualiza el cliente para enviar el campo nuevo.",{"_4098":84095,"_34307":84021,"_23429":140852,"_5":16198,"_30870":140664,"_3543":140853},[],"La CRL no cambia tras revocar un certificado.",{"_4098":84096,"_34307":84021,"_23429":140855,"_5":16198,"_30870":140664,"_3543":140856},[],"`regenerate_on_revoke` es `false`, o el evento falló por falta de rol o por un firmante inválido.",{"_4098":84097,"_34307":84021,"_23429":140858,"_5":16198,"_30870":140664,"_3543":140859},[],"Revisa los logs de la VA y la cola de eventos fallidos; corrige el firmante.",{"_4098":84098,"_34307":84021,"_23429":140861,"_5":16198,"_30870":140664,"_3543":140862},[],"Un verificador rechaza la CRL por el emisor.",{"_4098":84099,"_34307":84021,"_23429":140864,"_5":16198,"_30870":140664,"_3543":140865},[],"Varias CAs comparten SKI.",{"_4098":84100,"_34307":84021,"_23429":140867,"_5":16198,"_30870":140664,"_3543":140868},[],"Consulta CAs que comparten clave.",{"_4098":84101,"_34307":84021,"_23429":140870,"_5":16198,"_30870":140668,"_3543":140871},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Los ajustes VA de la CA también permiten seleccionar el firmante de la CRL: el selector de certificados solo ofrece certificados que tienen clave privada y el uso de clave `cRLSign`. Si el certificado de un firmante configurado no puede resolverse, la interfaz muestra `Unknown Certificate (Serial: X)` o `Certificate details unavailable (Serial: X)`. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_4098":84102,"_34307":84021,"_23429":140873,"_5":16198,"_30870":140672,"_3543":140874},[],"RFC 5280: perfil X.509 y CRL.",{"_4098":84103,"_34307":84021,"_23429":140876,"_5":16198,"_30870":140672,"_3543":63820},[],{"_4098":84104,"_34307":84021,"_23429":140878,"_5":16198,"_30870":140672,"_3543":63823},[],{"_4098":84105,"_34307":84021,"_23429":140880,"_5":16198,"_30870":140672,"_3543":140881},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_4098":84106,"_34307":84021,"_23429":140883,"_5":16198,"_30870":140672,"_3543":140884},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_4098":84107,"_34307":84107,"_5":16596,"_3543":140886,"_34738":140887,"_23429":140888,"_30870":84107},"Claves y motores criptográficos",[56936,135600,62406,139475],[],{"_4098":84108,"_34307":84107,"_23429":140890,"_5":16198,"_30870":84107,"_3543":140891},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_4098":84109,"_34307":84107,"_5":34735,"_23429":140893,"_30870":140894,"_3543":140895},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_4098":84110,"_34307":84107,"_5":34735,"_23429":140897,"_30870":140898,"_3543":140899},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_4098":84111,"_34307":84107,"_5":34735,"_23429":140901,"_30870":140902,"_3543":63848},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#file-system",{"_4098":84112,"_34307":84107,"_5":34735,"_23429":140904,"_30870":140905,"_3543":63852},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#hashicorp-vault",{"_4098":84113,"_34307":84107,"_5":34735,"_23429":140907,"_30870":140908,"_3543":63856},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#aws-secrets-manager",{"_4098":84114,"_34307":84107,"_5":34735,"_23429":140910,"_30870":140911,"_3543":63860},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#aws-kms",{"_4098":84115,"_34307":84107,"_5":34735,"_23429":140913,"_30870":140914,"_3543":63864},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#pkcs11",{"_4098":84116,"_34307":84107,"_5":34735,"_23429":140916,"_30870":140917,"_3543":63868},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#azure-key-vault",{"_4098":84117,"_34307":84107,"_5":34735,"_23429":140919,"_30870":140920,"_3543":140921},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_4098":84118,"_34307":84107,"_5":34735,"_23429":140923,"_30870":140924,"_3543":140925},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_4098":84119,"_34307":84107,"_5":34735,"_23429":140927,"_30870":140928,"_3543":140929},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_4098":84120,"_34307":84107,"_5":34735,"_23429":140931,"_30870":140932,"_3543":140933},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_4098":84121,"_34307":84107,"_5":34735,"_23429":140935,"_30870":140936,"_3543":140937},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_4098":84122,"_34307":84107,"_5":34735,"_23429":140939,"_30870":140940,"_3543":140941},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_4098":84123,"_34307":84107,"_5":34735,"_23429":140943,"_30870":140944,"_3543":140945},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_4098":84124,"_34307":84107,"_5":34735,"_23429":140947,"_30870":140948,"_3543":63900},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#sign",{"_4098":84125,"_34307":84107,"_5":34735,"_23429":140950,"_30870":140951,"_3543":63904},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#verify",{"_4098":84126,"_34307":84107,"_5":34735,"_23429":140953,"_30870":140954,"_3543":140955},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_4098":84127,"_34307":84107,"_5":34735,"_23429":140957,"_30870":140958,"_3543":140959},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_4098":84128,"_34307":84107,"_5":34735,"_23429":140961,"_30870":140962,"_3543":140963},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_4098":84129,"_34307":84107,"_23429":140965,"_5":16198,"_30870":84107,"_3543":140966},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_4098":84130,"_34307":84107,"_23429":140968,"_5":16198,"_30870":84107,"_3543":140969},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_4098":84131,"_34307":84107,"_23429":140971,"_5":16198,"_30870":140894,"_3543":140972},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_4098":84132,"_34307":84107,"_23429":140974,"_5":16198,"_30870":140894,"_3543":140975},[],"En la práctica, permite:",{"_4098":84133,"_34307":84107,"_23429":140977,"_5":16198,"_30870":140894,"_3543":140978},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_4098":84134,"_34307":84107,"_23429":140980,"_5":16198,"_30870":140894,"_3543":140981},[],"Importar claves creadas externamente.",{"_4098":84135,"_34307":84107,"_23429":140983,"_5":16198,"_30870":140894,"_3543":140984},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_4098":84136,"_34307":84107,"_23429":140986,"_5":16198,"_30870":140894,"_3543":140987},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_4098":84137,"_34307":84107,"_23429":140989,"_5":16198,"_30870":140898,"_3543":140990},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_4098":84138,"_34307":84107,"_23429":140992,"_5":16198,"_30870":140898,"_3543":140993},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_4098":84139,"_34307":84107,"_23429":140995,"_5":16198,"_30870":140898,"_3543":140996},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_4098":84140,"_34307":84107,"_23429":140998,"_5":16198,"_30870":140902,"_3543":140999},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_4098":84141,"_34307":84107,"_23429":141001,"_5":16198,"_30870":140905,"_3543":141002},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_4098":84142,"_34307":84107,"_23429":141004,"_5":16198,"_30870":140905,"_3543":141005},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_4098":84143,"_34307":84107,"_23429":141007,"_5":16198,"_30870":140908,"_3543":141008},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_4098":84144,"_34307":84107,"_23429":141010,"_5":16198,"_30870":140911,"_3543":141011},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_4098":84145,"_34307":84107,"_23429":141013,"_5":16198,"_30870":140914,"_3543":141014},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_4098":84146,"_34307":84107,"_23429":141016,"_5":16198,"_30870":140917,"_3543":141017},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_4098":84147,"_34307":84107,"_23429":141019,"_5":16198,"_30870":140917,"_3543":141020},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_4098":84148,"_34307":84107,"_23429":141022,"_5":16198,"_30870":140917,"_3543":141023},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_4098":84149,"_34307":84107,"_23429":141025,"_5":16198,"_30870":140917,"_3543":141026},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_4098":84150,"_34307":84107,"_23429":141028,"_5":16198,"_30870":140920,"_3543":141029},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_4098":84151,"_34307":84107,"_23429":141031,"_5":16198,"_30870":140920,"_3543":141032},[],"La tabla incluye los siguientes campos:",{"_4098":84152,"_34307":84107,"_23429":141034,"_5":16198,"_30870":140920,"_3543":141035},[],"**Name**: nombre descriptivo de la clave.",{"_4098":84153,"_34307":84107,"_23429":141037,"_5":16198,"_30870":140920,"_3543":141038},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_4098":84154,"_34307":84107,"_23429":141040,"_5":16198,"_30870":140920,"_3543":141041},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_4098":84155,"_34307":84107,"_23429":141043,"_5":16198,"_30870":140920,"_3543":141044},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_4098":84156,"_34307":84107,"_23429":141046,"_5":16198,"_30870":140920,"_3543":141047},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_4098":84157,"_34307":84107,"_23429":141049,"_5":16198,"_30870":140920,"_3543":141050},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_4098":84158,"_34307":84107,"_23429":141052,"_5":16198,"_30870":140920,"_3543":141053},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_4098":84159,"_34307":84107,"_23429":141055,"_5":16198,"_30870":140920,"_3543":141056},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_4098":84160,"_34307":84107,"_23429":141058,"_5":16198,"_30870":140920,"_3543":141059},[],"Desde esta vista también se accede a las acciones más habituales:",{"_4098":84161,"_34307":84107,"_23429":141061,"_5":16198,"_30870":140920,"_3543":141062},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_4098":84162,"_34307":84107,"_23429":141064,"_5":16198,"_30870":140920,"_3543":141065},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_4098":84163,"_34307":84107,"_23429":141067,"_5":16198,"_30870":140920,"_3543":141068},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_4098":84164,"_34307":84107,"_23429":141070,"_5":16198,"_30870":140920,"_3543":141071},[],"**Delete Key** para eliminar la clave del sistema.",{"_4098":84165,"_34307":84107,"_23429":141073,"_5":16198,"_30870":140924,"_3543":141074},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_4098":84166,"_34307":84107,"_23429":141076,"_5":16198,"_30870":140928,"_3543":141077},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_4098":84167,"_34307":84107,"_23429":141079,"_5":16198,"_30870":140928,"_3543":141080},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_4098":84168,"_34307":84107,"_23429":141082,"_5":16198,"_30870":140928,"_3543":141083},[],"**Key Name**: nombre único y descriptivo.",{"_4098":84169,"_34307":84107,"_23429":141085,"_5":16198,"_30870":140928,"_3543":141086},[],"**Crypto Engine**: motor que custodiará la clave.",{"_4098":84170,"_34307":84107,"_23429":141088,"_5":16198,"_30870":140928,"_3543":141089},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_4098":84171,"_34307":84107,"_23429":141091,"_5":16198,"_30870":140928,"_3543":141092},[],"**Tags**: metadatos para clasificar la clave.",{"_4098":84172,"_34307":84107,"_23429":141094,"_5":16198,"_30870":140928,"_3543":141095},[],"**Metadata**: información adicional para usos avanzados.",{"_4098":84173,"_34307":84107,"_23429":141097,"_5":16198,"_30870":140932,"_3543":141098},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_4098":84174,"_34307":84107,"_23429":141100,"_5":16198,"_30870":140932,"_3543":141101},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_4098":84175,"_34307":84107,"_23429":141103,"_5":16198,"_30870":140932,"_3543":141104},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_4098":84176,"_34307":84107,"_23429":141106,"_5":16198,"_30870":140932,"_3543":141107},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_4098":84177,"_34307":84107,"_23429":141109,"_5":16198,"_30870":140932,"_3543":141110},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_4098":84178,"_34307":84107,"_23429":141112,"_5":16198,"_30870":140932,"_3543":141113},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_4098":84179,"_34307":84107,"_23429":141115,"_5":16198,"_30870":140932,"_3543":141116},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_4098":84180,"_34307":84107,"_23429":141118,"_5":16198,"_30870":140932,"_3543":141119},[],"**Tags**: etiquetas para organización y búsqueda.",{"_4098":84181,"_34307":84107,"_23429":141121,"_5":16198,"_30870":140932,"_3543":141122},[],"**Metadata**: información adicional opcional.",{"_4098":84182,"_34307":84107,"_23429":141124,"_5":16198,"_30870":140932,"_3543":141125},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_4098":84183,"_34307":84107,"_23429":141127,"_5":16198,"_30870":140932,"_3543":141128},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_4098":84184,"_34307":84107,"_23429":141130,"_5":16198,"_30870":140936,"_3543":141131},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_4098":84185,"_34307":84107,"_23429":141133,"_5":16198,"_30870":140940,"_3543":141134},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_4098":84186,"_34307":84107,"_23429":141136,"_5":16198,"_30870":140940,"_3543":141137},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_4098":84187,"_34307":84107,"_23429":141139,"_5":16198,"_30870":140940,"_3543":141140},[],"**Key Name**: nombre descriptivo.",{"_4098":84188,"_34307":84107,"_23429":141142,"_5":16198,"_30870":140940,"_3543":141143},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_4098":84189,"_34307":84107,"_23429":141145,"_5":16198,"_30870":140940,"_3543":141146},[],"**Tags**: etiquetas asociadas.",{"_4098":84190,"_34307":84107,"_23429":141148,"_5":16198,"_30870":140940,"_3543":141149},[],"**Aliases**: nombres alternativos.",{"_4098":84191,"_34307":84107,"_23429":141151,"_5":16198,"_30870":140940,"_3543":141152},[],"**Crypto Engine**: motor en el que reside la clave.",{"_4098":84192,"_34307":84107,"_23429":141154,"_5":16198,"_30870":140940,"_3543":141155},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_4098":84193,"_34307":84107,"_23429":141157,"_5":16198,"_30870":140940,"_3543":141158},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_4098":84194,"_34307":84107,"_23429":141160,"_5":16198,"_30870":140940,"_3543":141161},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_4098":84195,"_34307":84107,"_23429":141163,"_5":16198,"_30870":140944,"_3543":141164},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_4098":84196,"_34307":84107,"_23429":141166,"_5":16198,"_30870":140944,"_3543":141167},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_4098":84197,"_34307":84107,"_23429":141169,"_5":16198,"_30870":140944,"_3543":141170},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_4098":84198,"_34307":84107,"_23429":141172,"_5":16198,"_30870":140948,"_3543":141173},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_4098":84199,"_34307":84107,"_23429":141175,"_5":16198,"_30870":140948,"_3543":141176},[],"Campos principales:",{"_4098":84200,"_34307":84107,"_23429":141178,"_5":16198,"_30870":140948,"_3543":141179},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_4098":84201,"_34307":84107,"_23429":141181,"_5":16198,"_30870":140948,"_3543":141182},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_4098":84202,"_34307":84107,"_23429":141184,"_5":16198,"_30870":140948,"_3543":141185},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_4098":84203,"_34307":84107,"_23429":141187,"_5":16198,"_30870":140948,"_3543":141188},[],"**Message**: contenido que se va a firmar.",{"_4098":84204,"_34307":84107,"_23429":141190,"_5":16198,"_30870":140948,"_3543":141191},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_4098":84205,"_34307":84107,"_23429":141193,"_5":16198,"_30870":140951,"_3543":141194},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_4098":84206,"_34307":84107,"_23429":141196,"_5":16198,"_30870":140951,"_3543":141176},[],{"_4098":84207,"_34307":84107,"_23429":141198,"_5":16198,"_30870":140951,"_3543":141199},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_4098":84208,"_34307":84107,"_23429":141201,"_5":16198,"_30870":140951,"_3543":141202},[],"**Message Type**: `Raw` o `Digest`.",{"_4098":84209,"_34307":84107,"_23429":141204,"_5":16198,"_30870":140951,"_3543":141205},[],"**Payload Encoding**: codificación del mensaje.",{"_4098":84210,"_34307":84107,"_23429":141207,"_5":16198,"_30870":140951,"_3543":141208},[],"**Message**: mensaje original o hash.",{"_4098":84211,"_34307":84107,"_23429":141210,"_5":16198,"_30870":140951,"_3543":141211},[],"**Signature**: firma que se desea comprobar.",{"_4098":84212,"_34307":84107,"_23429":141213,"_5":16198,"_30870":140951,"_3543":141214},[],"**Result**: indicador del resultado de la validación.",{"_4098":84213,"_34307":84107,"_23429":141216,"_5":16198,"_30870":140954,"_3543":141217},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_4098":84214,"_34307":84107,"_23429":141219,"_5":16198,"_30870":140954,"_3543":141220},[],"Este flujo es útil para:",{"_4098":84215,"_34307":84107,"_23429":141222,"_5":16198,"_30870":140954,"_3543":141223},[],"Solicitar certificados a una CA externa.",{"_4098":84216,"_34307":84107,"_23429":141225,"_5":16198,"_30870":140954,"_3543":141226},[],"Renovar una identidad manteniendo la misma clave.",{"_4098":84217,"_34307":84107,"_23429":141228,"_5":16198,"_30870":140954,"_3543":141229},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_4098":84218,"_34307":84107,"_23429":141231,"_5":16198,"_30870":140954,"_3543":141232},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_4098":84219,"_34307":84107,"_23429":141234,"_5":16198,"_30870":140954,"_3543":141235},[],"**Organization (O)**: organización o empresa.",{"_4098":84220,"_34307":84107,"_23429":141237,"_5":16198,"_30870":140954,"_3543":141238},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_4098":84221,"_34307":84107,"_23429":141240,"_5":16198,"_30870":140954,"_3543":141241},[],"**Country (C)**: código de país de dos letras.",{"_4098":84222,"_34307":84107,"_23429":141243,"_5":16198,"_30870":140954,"_3543":141244},[],"**State / Province (ST)**: estado o provincia.",{"_4098":84223,"_34307":84107,"_23429":141246,"_5":16198,"_30870":140954,"_3543":141247},[],"**Locality (L)**: ciudad o localidad.",{"_4098":84224,"_34307":84107,"_23429":141249,"_5":16198,"_30870":140954,"_3543":141250},[],"**Email Address**: correo de contacto.",{"_4098":84225,"_34307":84107,"_23429":141252,"_5":16198,"_30870":140954,"_3543":141253},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_4098":84226,"_34307":84107,"_23429":141255,"_5":16198,"_30870":140954,"_3543":141256},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_4098":84227,"_34307":84107,"_23429":141258,"_5":16198,"_30870":140958,"_3543":141259},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_4098":84228,"_34307":84107,"_23429":141261,"_5":16198,"_30870":140958,"_3543":141262},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_4098":84229,"_34307":84107,"_23429":141264,"_5":16198,"_30870":140962,"_3543":141265},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_4098":84230,"_34307":84107,"_23429":141267,"_5":16198,"_30870":140962,"_3543":141268},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves. La guía de actualización describe las referencias heredadas que conserva la migración.",{"_4098":84231,"_34307":84231,"_5":16596,"_3543":141270,"_34738":141271,"_23429":141272,"_30870":84231},"Validación online con OCSP",[56936,135600,62406,140106],[],{"_4098":84232,"_34307":84231,"_23429":141274,"_5":16198,"_30870":84231,"_3543":141275},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_4098":84233,"_34307":84231,"_5":34735,"_23429":141277,"_30870":141278,"_3543":141279},[],"/docs/pr-preview/pr-58/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_4098":84234,"_34307":84231,"_5":34735,"_23429":141281,"_30870":141282,"_3543":141283},[],"/docs/pr-preview/pr-58/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_4098":84235,"_34307":84231,"_5":34735,"_23429":141285,"_30870":141286,"_3543":141287},[],"/docs/pr-preview/pr-58/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_4098":84236,"_34307":84231,"_5":34735,"_23429":141289,"_30870":141290,"_3543":141291},[],"/docs/pr-preview/pr-58/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_4098":84237,"_34307":84231,"_5":34735,"_23429":141293,"_30870":141294,"_3543":141295},[],"/docs/pr-preview/pr-58/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_4098":84238,"_34307":84231,"_5":34735,"_23429":141297,"_30870":141298,"_3543":140673},[],"/docs/pr-preview/pr-58/es/platform/pki/ocsp#referencias",{"_4098":84239,"_34307":84231,"_23429":141300,"_5":16198,"_30870":84231,"_3543":141301},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_4098":84240,"_34307":84231,"_23429":141303,"_5":16198,"_30870":141278,"_3543":141304},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_4098":84241,"_34307":84231,"_23429":141306,"_5":16198,"_30870":141278,"_3543":141307},[],"Estado del registro",{"_4098":84242,"_34307":84231,"_23429":141309,"_5":16198,"_30870":141278,"_3543":141310},[],"Respuesta firmada",{"_4098":84243,"_34307":84231,"_23429":141312,"_5":16198,"_30870":141278,"_3543":61543},[],{"_4098":84244,"_34307":84231,"_23429":141314,"_5":16198,"_30870":141278,"_3543":64268},[],{"_4098":84245,"_34307":84231,"_23429":141316,"_5":16198,"_30870":141278,"_3543":61560},[],{"_4098":84246,"_34307":84231,"_23429":141318,"_5":16198,"_30870":141278,"_3543":141319},[],"`Revoked`, con razón y fecha de revocación.",{"_4098":84247,"_34307":84231,"_23429":141321,"_5":16198,"_30870":141278,"_3543":141322},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_4098":84248,"_34307":84231,"_23429":141324,"_5":16198,"_30870":141278,"_3543":141325},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_4098":84249,"_34307":84231,"_23429":141327,"_5":16198,"_30870":141278,"_3543":141328},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_4098":84250,"_34307":84231,"_23429":141330,"_5":16198,"_30870":141278,"_3543":141331},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_4098":84251,"_34307":84231,"_23429":141333,"_5":16198,"_30870":141278,"_3543":141334},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_4098":84252,"_34307":84231,"_23429":141336,"_5":16198,"_30870":141282,"_3543":141337},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_4098":84253,"_34307":84231,"_23429":141339,"_5":16198,"_30870":141282,"_3543":141340},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_4098":84254,"_34307":84231,"_23429":141342,"_5":16198,"_30870":141286,"_3543":141343},[],"El servicio acepta:",{"_4098":84255,"_34307":84231,"_23429":141345,"_5":16198,"_30870":141286,"_3543":137327},[],{"_4098":84256,"_34307":84231,"_23429":141347,"_5":16198,"_30870":141286,"_3543":141348},[],"Ruta del servicio VA",{"_4098":84257,"_34307":84231,"_23429":141350,"_5":16198,"_30870":141286,"_3543":141351},[],"Formato",{"_4098":84258,"_34307":84231,"_23429":141353,"_5":16198,"_30870":141286,"_3543":64308},[],{"_4098":84259,"_34307":84231,"_23429":141355,"_5":16198,"_30870":141286,"_3543":64311},[],{"_4098":84260,"_34307":84231,"_23429":141357,"_5":16198,"_30870":141286,"_3543":141358},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_4098":84261,"_34307":84231,"_23429":141360,"_5":16198,"_30870":141286,"_3543":63737},[],{"_4098":84262,"_34307":84231,"_23429":141362,"_5":16198,"_30870":141286,"_3543":64319},[],{"_4098":84263,"_34307":84231,"_23429":141364,"_5":16198,"_30870":141286,"_3543":141365},[],"Solicitud DER codificada en Base64 URL con padding.",{"_4098":84264,"_34307":84231,"_23429":141367,"_5":16198,"_30870":141286,"_3543":141368},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_4098":84265,"_34307":84231,"_23429":141370,"_5":16198,"_30870":141290,"_3543":141371},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_4098":84266,"_34307":84231,"_23429":141373,"_5":16198,"_30870":141290,"_3543":141374},[],"Genera la solicitud:",{"_4098":84267,"_34307":84231,"_23429":141376,"_5":16198,"_30870":141290,"_3543":141377},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_4098":84268,"_34307":84231,"_23429":141379,"_5":16198,"_30870":141290,"_3543":141380},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_4098":84269,"_34307":84231,"_23429":141382,"_5":16198,"_30870":141290,"_3543":141383},[],"Verifica el DER recibido:",{"_4098":84270,"_34307":84231,"_23429":141385,"_5":16198,"_30870":141290,"_3543":141386},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_4098":84271,"_34307":84231,"_23429":141388,"_5":16198,"_30870":141294,"_3543":141389},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_4098":84272,"_34307":84231,"_23429":141391,"_5":16198,"_30870":141294,"_3543":141392},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_4098":84273,"_34307":84231,"_23429":141394,"_5":16198,"_30870":141298,"_3543":64352},[],{"_4098":84274,"_34307":84231,"_23429":141396,"_5":16198,"_30870":141298,"_3543":64355},[],{"_4098":84275,"_34307":84231,"_23429":141398,"_5":16198,"_30870":141298,"_3543":141399},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_4098":84276,"_34307":84231,"_23429":141401,"_5":16198,"_30870":141298,"_3543":140884},[],{"_4098":84277,"_34307":84277,"_5":16596,"_3543":62406,"_34738":141403,"_23429":141404,"_30870":84277},[56936,135600,62406],[],{"_4098":84278,"_34307":84277,"_23429":141406,"_5":16198,"_30870":84277,"_3543":141407},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_4098":84279,"_34307":84277,"_5":34735,"_23429":141409,"_30870":141410,"_3543":138801},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#empieza-aquí",{"_4098":84280,"_34307":84277,"_5":34735,"_23429":141412,"_30870":141413,"_3543":141414},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_4098":84281,"_34307":84277,"_5":34735,"_23429":141416,"_30870":141417,"_3543":139321},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#capacidades-principales",{"_4098":84282,"_34307":84277,"_5":34735,"_23429":141419,"_30870":141420,"_3543":139325},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_4098":84283,"_34307":84277,"_5":34735,"_23429":141422,"_30870":141423,"_3543":139329},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#protege-las-claves-criptográficas",{"_4098":84284,"_34307":84277,"_5":34735,"_23429":141425,"_30870":141426,"_3543":139333},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#emite-y-controla-certificados",{"_4098":84285,"_34307":84277,"_5":34735,"_23429":141428,"_30870":141429,"_3543":139341},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#publica-el-estado-de-validación",{"_4098":84286,"_34307":84277,"_5":34735,"_23429":141431,"_30870":141432,"_3543":141433},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_4098":84287,"_34307":84277,"_5":34735,"_23429":141435,"_30870":141436,"_3543":140272},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#continúa",{"_4098":84288,"_34307":84277,"_23429":141438,"_5":16198,"_30870":84277,"_3543":141439},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_4098":84289,"_34307":84277,"_23429":141441,"_5":16198,"_30870":141410,"_3543":141442},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_4098":84290,"_34307":84277,"_23429":141444,"_5":16198,"_30870":141410,"_3543":141445},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_4098":84291,"_34307":84277,"_23429":141447,"_5":16198,"_30870":141413,"_3543":141448},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_4098":84292,"_34307":84277,"_23429":141450,"_5":16198,"_30870":141413,"_3543":141451},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_4098":84293,"_34307":84277,"_23429":141453,"_5":16198,"_30870":141413,"_3543":141454},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_4098":84294,"_34307":84277,"_23429":141456,"_5":16198,"_30870":141413,"_3543":141457},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_4098":84295,"_34307":84277,"_23429":141459,"_5":16198,"_30870":141413,"_3543":141460},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_4098":84296,"_34307":84277,"_23429":141462,"_5":16198,"_30870":141420,"_3543":141463},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_4098":84297,"_34307":84277,"_23429":141465,"_5":16198,"_30870":141423,"_3543":141466},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_4098":84298,"_34307":84277,"_23429":141468,"_5":16198,"_30870":141426,"_3543":141469},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_4098":84299,"_34307":84277,"_23429":141471,"_5":16198,"_30870":141429,"_3543":141472},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_4098":84300,"_34307":84277,"_23429":141474,"_5":16198,"_30870":141432,"_3543":141475},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_4098":84301,"_34307":84277,"_23429":141477,"_5":16198,"_30870":141432,"_3543":141478},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_4098":84302,"_34307":84277,"_23429":141480,"_5":16198,"_30870":141432,"_3543":141481},[],"su clave pública corresponda a la clave privada del cliente;",{"_4098":84303,"_34307":84277,"_23429":141483,"_5":16198,"_30870":141432,"_3543":141484},[],"su cadena alcance una raíz confiable para el consumidor;",{"_4098":84304,"_34307":84277,"_23429":141486,"_5":16198,"_30870":141432,"_3543":141487},[],"sus fechas y usos permitan la operación;",{"_4098":84305,"_34307":84277,"_23429":141489,"_5":16198,"_30870":141432,"_3543":141490},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_4098":84306,"_34307":84277,"_23429":141492,"_5":16198,"_30870":141432,"_3543":141493},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_4098":84307,"_34307":84277,"_23429":141495,"_5":16198,"_30870":141436,"_3543":141496},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_4098":84308,"_34307":84277,"_23429":141498,"_5":16198,"_30870":141436,"_3543":141499},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_4098":84309,"_34307":84277,"_23429":141501,"_5":16198,"_30870":141436,"_3543":141502},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_4098":84310,"_34307":84310,"_5":16596,"_3543":141504,"_34738":141505,"_23429":141506,"_30870":84310},"Crea tu primera CA",[56936,135600,62406,138925],[],{"_4098":84311,"_34307":84310,"_23429":141508,"_5":16198,"_30870":84310,"_3543":141509},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_4098":84312,"_34307":84310,"_5":34735,"_23429":141511,"_30870":141512,"_3543":134178},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_4098":84313,"_34307":84310,"_5":34735,"_23429":141514,"_30870":141515,"_3543":141516},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_4098":84314,"_34307":84310,"_5":34735,"_23429":141518,"_30870":141519,"_3543":141520},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_4098":84315,"_34307":84310,"_5":34735,"_23429":141522,"_30870":141523,"_3543":141524},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_4098":84316,"_34307":84310,"_5":34735,"_23429":141526,"_30870":141527,"_3543":141528},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_4098":84317,"_34307":84310,"_5":34735,"_23429":141530,"_30870":141531,"_3543":141532},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_4098":84318,"_34307":84310,"_5":34735,"_23429":141534,"_30870":141535,"_3543":141536},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_4098":84319,"_34307":84310,"_5":34735,"_23429":141538,"_30870":141539,"_3543":139172},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_4098":84320,"_34307":84310,"_5":34735,"_23429":141541,"_30870":141542,"_3543":134202},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_4098":84321,"_34307":84310,"_23429":141544,"_5":16198,"_30870":84310,"_3543":141545},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_4098":84322,"_34307":84310,"_23429":141547,"_5":16198,"_30870":141512,"_3543":141548},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_4098":84323,"_34307":84310,"_23429":141550,"_5":16198,"_30870":141512,"_3543":141551},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_4098":84324,"_34307":84310,"_23429":141553,"_5":16198,"_30870":141512,"_3543":141554},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_4098":84325,"_34307":84310,"_23429":141556,"_5":16198,"_30870":141512,"_3543":141557},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_4098":84326,"_34307":84310,"_23429":141559,"_5":16198,"_30870":141515,"_3543":141560},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_4098":84327,"_34307":84310,"_23429":141562,"_5":16198,"_30870":141515,"_3543":141563},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_4098":84328,"_34307":84310,"_23429":141565,"_5":16198,"_30870":141519,"_3543":141566},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_4098":84329,"_34307":84310,"_23429":141568,"_5":16198,"_30870":141519,"_3543":141569},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_4098":84330,"_34307":84310,"_23429":141571,"_5":16198,"_30870":141523,"_3543":141572},[],"Selecciona **Root CA** y completa:",{"_4098":84331,"_34307":84310,"_23429":141574,"_5":16198,"_30870":141523,"_3543":64534},[],{"_4098":84332,"_34307":84310,"_23429":141576,"_5":16198,"_30870":141523,"_3543":141577},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_4098":84333,"_34307":84310,"_23429":141579,"_5":16198,"_30870":141523,"_3543":141580},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_4098":84334,"_34307":84310,"_23429":141582,"_5":16198,"_30870":141523,"_3543":141583},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_4098":84335,"_34307":84310,"_23429":141585,"_5":16198,"_30870":141523,"_3543":141586},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_4098":84336,"_34307":84310,"_23429":141588,"_5":16198,"_30870":141527,"_3543":141589},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_4098":84337,"_34307":84310,"_23429":141591,"_5":16198,"_30870":141531,"_3543":141592},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_4098":84338,"_34307":84310,"_23429":141594,"_5":16198,"_30870":141531,"_3543":141595},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_4098":84339,"_34307":84310,"_23429":141597,"_5":16198,"_30870":141535,"_3543":141598},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_4098":84340,"_34307":84310,"_23429":141600,"_5":16198,"_30870":141535,"_3543":141601},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_4098":84341,"_34307":84310,"_23429":141603,"_5":16198,"_30870":141535,"_3543":141604},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_4098":84342,"_34307":84310,"_23429":141606,"_5":16198,"_30870":141539,"_3543":141607},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_4098":84343,"_34307":84310,"_23429":141609,"_5":16198,"_30870":141539,"_3543":141610},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_4098":84344,"_34307":84310,"_23429":141612,"_5":16198,"_30870":141539,"_3543":141613},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_4098":84345,"_34307":84310,"_23429":141615,"_5":16198,"_30870":141539,"_3543":141616},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_4098":84346,"_34307":84310,"_23429":141618,"_5":16198,"_30870":141542,"_3543":141619},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_4098":84347,"_34307":84347,"_5":16596,"_3543":141621,"_34738":141622,"_23429":141623,"_30870":84347},"Emite y verifica un certificado",[56936,135600,62406,138925],[],{"_4098":84348,"_34307":84347,"_23429":141625,"_5":16198,"_30870":84347,"_3543":141626},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_4098":84349,"_34307":84347,"_5":34735,"_23429":141628,"_30870":141629,"_3543":134178},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_4098":84350,"_34307":84347,"_5":34735,"_23429":141631,"_30870":141632,"_3543":141633},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_4098":84351,"_34307":84347,"_5":34735,"_23429":141635,"_30870":141636,"_3543":141637},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_4098":84352,"_34307":84347,"_5":34735,"_23429":141639,"_30870":141640,"_3543":141641},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_4098":84353,"_34307":84347,"_5":34735,"_23429":141643,"_30870":141644,"_3543":141645},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_4098":84354,"_34307":84347,"_5":34735,"_23429":141647,"_30870":141648,"_3543":141649},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_4098":84355,"_34307":84347,"_5":34735,"_23429":141651,"_30870":141652,"_3543":141653},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_4098":84356,"_34307":84347,"_5":34735,"_23429":141655,"_30870":141656,"_3543":141657},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_4098":84357,"_34307":84347,"_5":34735,"_23429":141659,"_30870":141660,"_3543":141661},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_4098":84358,"_34307":84347,"_5":34735,"_23429":141663,"_30870":141664,"_3543":141665},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_4098":84359,"_34307":84347,"_5":34735,"_23429":141667,"_30870":141668,"_3543":139172},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_4098":84360,"_34307":84347,"_5":34735,"_23429":141670,"_30870":141671,"_3543":134202},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_4098":84361,"_34307":84347,"_23429":141673,"_5":16198,"_30870":84347,"_3543":141674},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_4098":84362,"_34307":84347,"_23429":141676,"_5":16198,"_30870":141629,"_3543":141677},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_4098":84363,"_34307":84347,"_23429":141679,"_5":16198,"_30870":141629,"_3543":141680},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_4098":84364,"_34307":84347,"_23429":141682,"_5":16198,"_30870":141629,"_3543":141683},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_4098":84365,"_34307":84347,"_23429":141685,"_5":16198,"_30870":141629,"_3543":141686},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_4098":84366,"_34307":84347,"_23429":141688,"_5":16198,"_30870":141629,"_3543":141689},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_4098":84367,"_34307":84347,"_23429":141691,"_5":16198,"_30870":141632,"_3543":141692},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_4098":84368,"_34307":84347,"_23429":141694,"_5":16198,"_30870":141636,"_3543":141695},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_4098":84369,"_34307":84347,"_23429":141697,"_5":16198,"_30870":141636,"_3543":141698},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_4098":84370,"_34307":84347,"_23429":141700,"_5":16198,"_30870":141640,"_3543":141701},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_4098":84371,"_34307":84347,"_23429":141703,"_5":16198,"_30870":141640,"_3543":141704},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_4098":84372,"_34307":84347,"_23429":141706,"_5":16198,"_30870":141644,"_3543":141707},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_4098":84373,"_34307":84347,"_23429":141709,"_5":16198,"_30870":141644,"_3543":141710},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_4098":84374,"_34307":84347,"_23429":141712,"_5":16198,"_30870":141648,"_3543":141713},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_4098":84375,"_34307":84347,"_23429":141715,"_5":16198,"_30870":141652,"_3543":141716},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_4098":84376,"_34307":84347,"_23429":141718,"_5":16198,"_30870":141656,"_3543":141719},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_4098":84377,"_34307":84347,"_23429":141721,"_5":16198,"_30870":141660,"_3543":141722},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_4098":84378,"_34307":84347,"_23429":141724,"_5":16198,"_30870":141660,"_3543":141725},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_4098":84379,"_34307":84347,"_23429":141727,"_5":16198,"_30870":141660,"_3543":141728},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_4098":84380,"_34307":84347,"_23429":141730,"_5":16198,"_30870":141664,"_3543":141731},[],"En Bash, compara los dos resúmenes de clave pública:",{"_4098":84381,"_34307":84347,"_23429":141733,"_5":16198,"_30870":141664,"_3543":141734},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_4098":84382,"_34307":84347,"_23429":141736,"_5":16198,"_30870":141664,"_3543":141737},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_4098":84383,"_34307":84347,"_23429":141739,"_5":16198,"_30870":141668,"_3543":139255},[],{"_4098":84384,"_34307":84347,"_23429":141741,"_5":16198,"_30870":141668,"_3543":137776},[],{"_4098":84385,"_34307":84347,"_23429":141743,"_5":16198,"_30870":141668,"_3543":141744},[],"La CA rechaza la emisión",{"_4098":84386,"_34307":84347,"_23429":141746,"_5":16198,"_30870":141668,"_3543":141747},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_4098":84387,"_34307":84347,"_23429":141749,"_5":16198,"_30870":141668,"_3543":141750},[],"Sujeto o usos diferentes",{"_4098":84388,"_34307":84347,"_23429":141752,"_5":16198,"_30870":141668,"_3543":141753},[],"Perfil aplicado y valores solicitados.",{"_4098":84389,"_34307":84347,"_23429":141755,"_5":16198,"_30870":141668,"_3543":141756},[],"No se encuentra el emisor",{"_4098":84390,"_34307":84347,"_23429":141758,"_5":16198,"_30870":141668,"_3543":141759},[],"CA descargada y cadena intermedia necesaria.",{"_4098":84391,"_34307":84347,"_23429":141761,"_5":16198,"_30870":141668,"_3543":141762},[],"Falla la vigencia",{"_4098":84392,"_34307":84347,"_23429":141764,"_5":16198,"_30870":141668,"_3543":141765},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_4098":84393,"_34307":84347,"_23429":141767,"_5":16198,"_30870":141668,"_3543":141768},[],"Los resúmenes de clave difieren",{"_4098":84394,"_34307":84347,"_23429":141770,"_5":16198,"_30870":141668,"_3543":141771},[],"Archivos de certificado y clave de la misma emisión.",{"_4098":84395,"_34307":84347,"_23429":141773,"_5":16198,"_30870":141668,"_3543":141774},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_4098":84396,"_34307":84347,"_23429":141776,"_5":16198,"_30870":141671,"_3543":141777},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_4098":84397,"_34307":84347,"_23429":141779,"_5":16198,"_30870":141671,"_3543":141780},[],"Gestionar certificados para inspección, estado y revocación.",{"_4098":84398,"_34307":84347,"_23429":141782,"_5":16198,"_30870":141671,"_3543":141783},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_4098":84399,"_34307":84347,"_23429":141785,"_5":16198,"_30870":141671,"_3543":141786},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_4098":84400,"_34307":84347,"_23429":141788,"_5":16198,"_30870":141671,"_3543":141789},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_4098":84401,"_34307":84401,"_5":16596,"_3543":141791,"_34738":141792,"_23429":141793,"_30870":84401},"Primeros pasos de PKI",[56936,135600,62406,138925],[],{"_4098":84402,"_34307":84401,"_23429":141795,"_5":16198,"_30870":84401,"_3543":141796},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_4098":84403,"_34307":84401,"_5":34735,"_23429":141798,"_30870":141799,"_3543":134178},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_4098":84404,"_34307":84401,"_5":34735,"_23429":141801,"_30870":141802,"_3543":141803},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_4098":84405,"_34307":84401,"_5":34735,"_23429":141805,"_30870":141806,"_3543":139107},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/overview#resultado-esperado",{"_4098":84406,"_34307":84401,"_5":34735,"_23429":141808,"_30870":141809,"_3543":141810},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_4098":84407,"_34307":84401,"_23429":141812,"_5":16198,"_30870":84401,"_3543":141813},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_4098":84408,"_34307":84401,"_23429":141815,"_5":16198,"_30870":141799,"_3543":141816},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_4098":84409,"_34307":84401,"_23429":141818,"_5":16198,"_30870":141799,"_3543":141819},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_4098":84410,"_34307":84401,"_23429":141821,"_5":16198,"_30870":141799,"_3543":141822},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_4098":84411,"_34307":84401,"_23429":141824,"_5":16198,"_30870":141799,"_3543":141825},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_4098":84412,"_34307":84401,"_23429":141827,"_5":16198,"_30870":141799,"_3543":141828},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_4098":84413,"_34307":84401,"_23429":141830,"_5":16198,"_30870":141802,"_3543":141831},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_4098":84414,"_34307":84401,"_23429":141833,"_5":16198,"_30870":141802,"_3543":141834},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_4098":84415,"_34307":84401,"_23429":141836,"_5":16198,"_30870":141802,"_3543":141837},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_4098":84416,"_34307":84401,"_23429":141839,"_5":16198,"_30870":141802,"_3543":141840},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_4098":84417,"_34307":84401,"_23429":141842,"_5":16198,"_30870":141806,"_3543":141843},[],"Archivo o recurso",{"_4098":84418,"_34307":84401,"_23429":141845,"_5":16198,"_30870":141806,"_3543":139104},[],{"_4098":84419,"_34307":84401,"_23429":141847,"_5":16198,"_30870":141806,"_3543":141848},[],"CA raíz activa y `ca.pem`",{"_4098":84420,"_34307":84401,"_23429":141850,"_5":16198,"_30870":141806,"_3543":141851},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_4098":84421,"_34307":84401,"_23429":141853,"_5":16198,"_30870":141806,"_3543":141854},[],"Certificado final y `device.crt`",{"_4098":84422,"_34307":84401,"_23429":141856,"_5":16198,"_30870":141806,"_3543":141857},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_4098":84423,"_34307":84401,"_23429":141859,"_5":16198,"_30870":141806,"_3543":141860},[],"Clave privada `device.key`",{"_4098":84424,"_34307":84401,"_23429":141862,"_5":16198,"_30870":141806,"_3543":141863},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_4098":84425,"_34307":84401,"_23429":141865,"_5":16198,"_30870":141806,"_3543":141866},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_4098":84426,"_34307":84401,"_23429":141868,"_5":16198,"_30870":141809,"_3543":141869},[],"Para operar certificados, continúa con Certificados y Validación.",{"_4098":84427,"_34307":84401,"_23429":141871,"_5":16198,"_30870":141809,"_3543":141872},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_4098":84428,"_34307":84401,"_23429":141874,"_5":16198,"_30870":141809,"_3543":141875},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_4098":84429,"_34307":84429,"_5":16596,"_3543":141877,"_34738":141878,"_23429":141880,"_30870":84429},"Resolución de problemas PKI",[56936,135600,62406,141879],"Resolución de problemas",[],{"_4098":84430,"_34307":84429,"_23429":141882,"_5":16198,"_30870":84429,"_3543":141883},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_4098":84431,"_34307":84429,"_5":34735,"_23429":141885,"_30870":141886,"_3543":141887},[],"/docs/pr-preview/pr-58/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_4098":84432,"_34307":84429,"_5":34735,"_23429":141889,"_30870":141890,"_3543":141891},[],"/docs/pr-preview/pr-58/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_4098":84433,"_34307":84429,"_5":34735,"_23429":141893,"_30870":141894,"_3543":141895},[],"/docs/pr-preview/pr-58/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_4098":84434,"_34307":84429,"_23429":141897,"_5":16198,"_30870":84429,"_3543":141898},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_4098":84435,"_34307":84429,"_23429":141900,"_5":16198,"_30870":84429,"_3543":141901},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_4098":84436,"_34307":84429,"_23429":141903,"_5":16198,"_30870":141886,"_3543":139104},[],{"_4098":84437,"_34307":84429,"_23429":141905,"_5":16198,"_30870":141886,"_3543":137776},[],{"_4098":84438,"_34307":84429,"_23429":141907,"_5":16198,"_30870":141886,"_3543":134202},[],{"_4098":84439,"_34307":84429,"_23429":141909,"_5":16198,"_30870":141886,"_3543":61248},[],{"_4098":84440,"_34307":84429,"_23429":141911,"_5":16198,"_30870":141886,"_3543":141912},[],"Existe, está activa y sus fechas son utilizables.",{"_4098":84441,"_34307":84429,"_23429":141914,"_5":16198,"_30870":141886,"_3543":141915},[],"Autoridades.",{"_4098":84442,"_34307":84429,"_23429":141917,"_5":16198,"_30870":141886,"_3543":141918},[],"Clave",{"_4098":84443,"_34307":84429,"_23429":141920,"_5":16198,"_30870":141886,"_3543":141921},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_4098":84444,"_34307":84429,"_23429":141923,"_5":16198,"_30870":141886,"_3543":141924},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_4098":84445,"_34307":84429,"_23429":141926,"_5":16198,"_30870":141886,"_3543":64888},[],{"_4098":84446,"_34307":84429,"_23429":141928,"_5":16198,"_30870":141886,"_3543":141929},[],"PEM correcto y firma verificable.",{"_4098":84447,"_34307":84429,"_23429":141931,"_5":16198,"_30870":141886,"_3543":64894},[],{"_4098":84448,"_34307":84429,"_23429":141933,"_5":16198,"_30870":141886,"_3543":141934},[],"Perfil",{"_4098":84449,"_34307":84429,"_23429":141936,"_5":16198,"_30870":141886,"_3543":141937},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_4098":84450,"_34307":84429,"_23429":141939,"_5":16198,"_30870":141886,"_3543":141940},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_4098":84451,"_34307":84429,"_23429":141942,"_5":16198,"_30870":141886,"_3543":139255},[],{"_4098":84452,"_34307":84429,"_23429":141944,"_5":16198,"_30870":141886,"_3543":141945},[],"Sujeto, SAN, usos y fechas adecuados.",{"_4098":84453,"_34307":84429,"_23429":141947,"_5":16198,"_30870":141886,"_3543":141948},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_4098":84454,"_34307":84429,"_23429":141950,"_5":16198,"_30870":141886,"_3543":141951},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_4098":84455,"_34307":84429,"_23429":141953,"_5":16198,"_30870":141886,"_3543":141954},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_4098":84456,"_34307":84429,"_23429":141956,"_5":16198,"_30870":141890,"_3543":141957},[],"Revisa cada frontera por separado:",{"_4098":84457,"_34307":84429,"_23429":141959,"_5":16198,"_30870":141890,"_3543":141960},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_4098":84458,"_34307":84429,"_23429":141962,"_5":16198,"_30870":141890,"_3543":141963},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_4098":84459,"_34307":84429,"_23429":141965,"_5":16198,"_30870":141890,"_3543":141966},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_4098":84460,"_34307":84429,"_23429":141968,"_5":16198,"_30870":141890,"_3543":141969},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_4098":84461,"_34307":84429,"_23429":141971,"_5":16198,"_30870":141890,"_3543":141972},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_4098":84462,"_34307":84429,"_23429":141974,"_5":16198,"_30870":141890,"_3543":141975},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_4098":84463,"_34307":84429,"_23429":141977,"_5":16198,"_30870":141894,"_3543":141978},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_4098":84464,"_34307":84429,"_23429":141980,"_5":16198,"_30870":141894,"_3543":141981},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_4098":84465,"_34307":84465,"_5":16596,"_3543":141983,"_34738":141984,"_23429":141987,"_30870":84465},"Algoritmos",[56936,135600,141985,141986],"[Beta] Poscuántica (PQC)","Algoritmos y toolchain",[],{"_4098":84466,"_34307":84465,"_23429":141989,"_5":16198,"_30870":84465,"_3543":141990},[],"Los algoritmos de firma poscuánticos y composite que soporta Lamassu, cómo se identifica cada uno en las peticiones a la API y los estándares que siguen.",{"_4098":84467,"_34307":84465,"_5":34735,"_23429":141992,"_30870":141993,"_3543":141994},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#cómo-se-selecciona-un-algoritmo","Cómo se selecciona un algoritmo",{"_4098":84468,"_34307":84465,"_5":34735,"_23429":141996,"_30870":141997,"_3543":64961},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#ml-dsa",{"_4098":84469,"_34307":84465,"_5":34735,"_23429":141999,"_30870":142000,"_3543":64965},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#slh-dsa",{"_4098":84470,"_34307":84465,"_5":34735,"_23429":142002,"_30870":142003,"_3543":142004},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#ml-dsa-composite","ML-DSA composite",{"_4098":84471,"_34307":84465,"_5":34735,"_23429":142006,"_30870":142007,"_3543":64973},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#ed25519",{"_4098":84472,"_34307":84465,"_5":34735,"_23429":142009,"_30870":142010,"_3543":142011},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#elegir-un-algoritmo","Elegir un algoritmo",{"_4098":84473,"_34307":84465,"_5":34735,"_23429":142013,"_30870":142014,"_3543":142015},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#qué-no-se-cubre","Qué no se cubre",{"_4098":84474,"_34307":84465,"_23429":142017,"_5":16198,"_30870":84465,"_3543":142018},[],"Lamassu soporta cuatro grupos de algoritmos de firma además de RSA y ECDSA: ML-DSA, SLH-DSA, ML-DSA composite y Ed25519. Todos proceden del toolchain de Go PQC; el backend solo selecciona el algoritmo y delega la criptografía.",{"_4098":84475,"_34307":84465,"_23429":142020,"_5":16198,"_30870":141993,"_3543":142021},[],"Una clave o una CA se crea con un tipo de clave y un tamaño. En RSA y ECDSA el tamaño es una longitud en bits o una curva. En los algoritmos poscuánticos el mismo campo transporta un **identificador de conjunto de parámetros**, no un número de bits:",{"_4098":84476,"_34307":84465,"_23429":142023,"_5":16198,"_30870":141993,"_3543":142024},[],"Tipo de clave (`algorithm` / `type`)",{"_4098":84477,"_34307":84465,"_23429":142026,"_5":16198,"_30870":141993,"_3543":142027},[],"Valor de `size` / `bits`",{"_4098":84478,"_34307":84465,"_23429":142029,"_5":16198,"_30870":141993,"_3543":142030},[],"Significado",{"_4098":84479,"_34307":84465,"_23429":142032,"_5":16198,"_30870":141993,"_3543":64998},[],{"_4098":84480,"_34307":84465,"_23429":142034,"_5":16198,"_30870":141993,"_3543":65001},[],{"_4098":84481,"_34307":84465,"_23429":142036,"_5":16198,"_30870":141993,"_3543":142037},[],"Longitud del módulo en bits.",{"_4098":84482,"_34307":84465,"_23429":142039,"_5":16198,"_30870":141993,"_3543":65007},[],{"_4098":84483,"_34307":84465,"_23429":142041,"_5":16198,"_30870":141993,"_3543":65010},[],{"_4098":84484,"_34307":84465,"_23429":142043,"_5":16198,"_30870":141993,"_3543":142044},[],"Tamaño de la curva en bits (P-256, P-384, P-521).",{"_4098":84485,"_34307":84465,"_23429":142046,"_5":16198,"_30870":141993,"_3543":65016},[],{"_4098":84486,"_34307":84465,"_23429":142048,"_5":16198,"_30870":141993,"_3543":11864},[],{"_4098":84487,"_34307":84465,"_23429":142050,"_5":16198,"_30870":141993,"_3543":142051},[],"Fijo. Cualquier otro valor se sustituye por 256.",{"_4098":84488,"_34307":84465,"_23429":142053,"_5":16198,"_30870":141993,"_3543":65024},[],{"_4098":84489,"_34307":84465,"_23429":142055,"_5":16198,"_30870":141993,"_3543":65027},[],{"_4098":84490,"_34307":84465,"_23429":142057,"_5":16198,"_30870":141993,"_3543":142058},[],"Conjunto de parámetros de ML-DSA.",{"_4098":84491,"_34307":84465,"_23429":142060,"_5":16198,"_30870":141993,"_3543":65033},[],{"_4098":84492,"_34307":84465,"_23429":142062,"_5":16198,"_30870":141993,"_3543":142063},[],"1 a 12",{"_4098":84493,"_34307":84465,"_23429":142065,"_5":16198,"_30870":141993,"_3543":142066},[],"Conjunto de parámetros de SLH-DSA, en el orden de la tabla siguiente.",{"_4098":84494,"_34307":84465,"_23429":142068,"_5":16198,"_30870":141993,"_3543":65042},[],{"_4098":84495,"_34307":84465,"_23429":142070,"_5":16198,"_30870":141993,"_3543":142071},[],"1 a 8",{"_4098":84496,"_34307":84465,"_23429":142073,"_5":16198,"_30870":141993,"_3543":142074},[],"Variante composite con componente RSA.",{"_4098":84497,"_34307":84465,"_23429":142076,"_5":16198,"_30870":141993,"_3543":65051},[],{"_4098":84498,"_34307":84465,"_23429":142078,"_5":16198,"_30870":141993,"_3543":142079},[],"9 a 13",{"_4098":84499,"_34307":84465,"_23429":142081,"_5":16198,"_30870":141993,"_3543":142082},[],"Variante composite con componente ECDSA.",{"_4098":84500,"_34307":84465,"_23429":142084,"_5":16198,"_30870":141993,"_3543":65060},[],{"_4098":84501,"_34307":84465,"_23429":142086,"_5":16198,"_30870":141993,"_3543":142087},[],"14 y 15",{"_4098":84502,"_34307":84465,"_23429":142089,"_5":16198,"_30870":141993,"_3543":142090},[],"Variante composite con componente Ed25519.",{"_4098":84503,"_34307":84465,"_23429":142092,"_5":16198,"_30870":141993,"_3543":142093},[],"Una cadena de tipo de clave desconocida no se rechaza al interpretarla: se convierte en un tipo desconocido y falla más tarde. Deben usarse exactamente las cadenas anteriores.",{"_4098":84504,"_34307":84465,"_23429":142095,"_5":16198,"_30870":141997,"_3543":142096},[],"ML-DSA es el esquema de firma basado en retículos estandarizado en FIPS 204. Lamassu acepta los tres conjuntos de parámetros ML-DSA-44, ML-DSA-65 y ML-DSA-87, que se seleccionan con `size` 44, 65 o 87. La implementación es el paquete `crypto/mldsa` de Go 1.27, es decir, el código de la propia biblioteca estándar y no del fork. En los certificados, los identificadores de algoritmo son `2.16.840.1.101.3.4.3.17`, `.18` y `.19` para ML-DSA-44, -65 y -87.",{"_4098":84505,"_34307":84465,"_23429":142098,"_5":16198,"_30870":141997,"_3543":142099},[],"Conjunto de parámetros",{"_4098":84506,"_34307":84465,"_23429":142101,"_5":16198,"_30870":141997,"_3543":142102},[],"Categoría de seguridad NIST",{"_4098":84507,"_34307":84465,"_23429":142104,"_5":16198,"_30870":141997,"_3543":65081},[],{"_4098":84508,"_34307":84465,"_23429":142106,"_5":16198,"_30870":141997,"_3543":11806},[],{"_4098":84509,"_34307":84465,"_23429":142108,"_5":16198,"_30870":141997,"_3543":65086},[],{"_4098":84510,"_34307":84465,"_23429":142110,"_5":16198,"_30870":141997,"_3543":11743},[],{"_4098":84511,"_34307":84465,"_23429":142112,"_5":16198,"_30870":141997,"_3543":65091},[],{"_4098":84512,"_34307":84465,"_23429":142114,"_5":16198,"_30870":141997,"_3543":11935},[],{"_4098":84513,"_34307":84465,"_23429":142116,"_5":16198,"_30870":141997,"_3543":142117},[],"Una categoría más alta implica claves y firmas más grandes a cambio de mayor margen de seguridad.",{"_4098":84514,"_34307":84465,"_23429":142119,"_5":16198,"_30870":141997,"_3543":142120},[],"Go solo lee claves privadas ML-DSA en PKCS#8 cuando contienen únicamente la semilla de 32 bytes. Las claves que OpenSSL escribe por defecto en la forma semilla más clave expandida se rechazan, por lo que deben exportarse en la forma de solo semilla antes de importarlas.",{"_4098":84515,"_34307":84465,"_23429":142122,"_5":16198,"_30870":142000,"_3543":142123},[],"SLH-DSA es el esquema basado en funciones hash de FIPS 205. Ofrece doce conjuntos de parámetros que combinan una familia de hash (SHA-2 o SHAKE), el parámetro n de 128, 192 o 256 bits, que corresponde a las categorías de seguridad 1, 3 y 5 del NIST y un compromiso entre tamaño de firma y velocidad de firma (`s` para firmas pequeñas, `f` para firma rápida). El identificador que se escribe en `size` sigue el orden de la biblioteca subyacente:",{"_4098":84516,"_34307":84465,"_23429":142125,"_5":16198,"_30870":142000,"_3543":65105},[],{"_4098":84517,"_34307":84465,"_23429":142127,"_5":16198,"_30870":142000,"_3543":142099},[],{"_4098":84518,"_34307":84465,"_23429":142129,"_5":16198,"_30870":142000,"_3543":65105},[],{"_4098":84519,"_34307":84465,"_23429":142131,"_5":16198,"_30870":142000,"_3543":142099},[],{"_4098":84520,"_34307":84465,"_23429":142133,"_5":16198,"_30870":142000,"_3543":11645},[],{"_4098":84521,"_34307":84465,"_23429":142135,"_5":16198,"_30870":142000,"_3543":65116},[],{"_4098":84522,"_34307":84465,"_23429":142137,"_5":16198,"_30870":142000,"_3543":11636},[],{"_4098":84523,"_34307":84465,"_23429":142139,"_5":16198,"_30870":142000,"_3543":65121},[],{"_4098":84524,"_34307":84465,"_23429":142141,"_5":16198,"_30870":142000,"_3543":11806},[],{"_4098":84525,"_34307":84465,"_23429":142143,"_5":16198,"_30870":142000,"_3543":65126},[],{"_4098":84526,"_34307":84465,"_23429":142145,"_5":16198,"_30870":142000,"_3543":11617},[],{"_4098":84527,"_34307":84465,"_23429":142147,"_5":16198,"_30870":142000,"_3543":65131},[],{"_4098":84528,"_34307":84465,"_23429":142149,"_5":16198,"_30870":142000,"_3543":11743},[],{"_4098":84529,"_34307":84465,"_23429":142151,"_5":16198,"_30870":142000,"_3543":65136},[],{"_4098":84530,"_34307":84465,"_23429":142153,"_5":16198,"_30870":142000,"_3543":29450},[],{"_4098":84531,"_34307":84465,"_23429":142155,"_5":16198,"_30870":142000,"_3543":65141},[],{"_4098":84532,"_34307":84465,"_23429":142157,"_5":16198,"_30870":142000,"_3543":11596},[],{"_4098":84533,"_34307":84465,"_23429":142159,"_5":16198,"_30870":142000,"_3543":65146},[],{"_4098":84534,"_34307":84465,"_23429":142161,"_5":16198,"_30870":142000,"_3543":33356},[],{"_4098":84535,"_34307":84465,"_23429":142163,"_5":16198,"_30870":142000,"_3543":65151},[],{"_4098":84536,"_34307":84465,"_23429":142165,"_5":16198,"_30870":142000,"_3543":11935},[],{"_4098":84537,"_34307":84465,"_23429":142167,"_5":16198,"_30870":142000,"_3543":65156},[],{"_4098":84538,"_34307":84465,"_23429":142169,"_5":16198,"_30870":142000,"_3543":33390},[],{"_4098":84539,"_34307":84465,"_23429":142171,"_5":16198,"_30870":142000,"_3543":65161},[],{"_4098":84540,"_34307":84465,"_23429":142173,"_5":16198,"_30870":142000,"_3543":11605},[],{"_4098":84541,"_34307":84465,"_23429":142175,"_5":16198,"_30870":142000,"_3543":65166},[],{"_4098":84542,"_34307":84465,"_23429":142177,"_5":16198,"_30870":142000,"_3543":32852},[],{"_4098":84543,"_34307":84465,"_23429":142179,"_5":16198,"_30870":142000,"_3543":65171},[],{"_4098":84544,"_34307":84465,"_23429":142181,"_5":16198,"_30870":142000,"_3543":142182},[],"La implementación de SLH-DSA procede de la biblioteca CIRCL de Cloudflare, que el fork integra para poder usar claves SLH-DSA en certificados X.509. Los identificadores de objeto van de `2.16.840.1.101.3.4.3.20` a `.31`. Las firmas SLH-DSA son grandes, de entre unos 8 y 50 KB según el conjunto de parámetros, lo que importa en las cadenas de certificados y en cualquier transporte con un límite de tamaño. SLH-DSA está disponible para claves, CA y certificados, pero el fork no tiene esquema de firma TLS para él, por lo que un certificado SLH-DSA no puede autenticar una conexión TLS.",{"_4098":84545,"_34307":84465,"_23429":142184,"_5":16198,"_30870":142003,"_3543":142185},[],"Una clave composite empareja una clave ML-DSA con una clave tradicional. Una firma composite es la concatenación de la firma ML-DSA y la firma tradicional, ambas calculadas sobre un mensaje representativo que contiene un prefijo fijo, una etiqueta de algoritmo, un contexto opcional y un hash del mensaje; la verificación falla si falla cualquiera de los componentes. El componente ML-DSA es ML-DSA puro, con la etiqueta como contexto. Lamassu implementa los 15 algoritmos del RFC 10073 que dependen solo de algoritmos disponibles en Go. Los identificadores cuelgan del arco `1.3.6.1.5.5.7.6`.",{"_4098":84546,"_34307":84465,"_23429":142187,"_5":16198,"_30870":142003,"_3543":65180},[],{"_4098":84547,"_34307":84465,"_23429":142189,"_5":16198,"_30870":142003,"_3543":142190},[],"Algoritmo",{"_4098":84548,"_34307":84465,"_23429":142192,"_5":16198,"_30870":142003,"_3543":142193},[],"Último dígito del OID",{"_4098":84549,"_34307":84465,"_23429":142195,"_5":16198,"_30870":142003,"_3543":142196},[],"Familia",{"_4098":84550,"_34307":84465,"_23429":142198,"_5":16198,"_30870":142003,"_3543":11645},[],{"_4098":84551,"_34307":84465,"_23429":142200,"_5":16198,"_30870":142003,"_3543":65194},[],{"_4098":84552,"_34307":84465,"_23429":142202,"_5":16198,"_30870":142003,"_3543":34181},[],{"_4098":84553,"_34307":84465,"_23429":142204,"_5":16198,"_30870":142003,"_3543":65199},[],{"_4098":84554,"_34307":84465,"_23429":142206,"_5":16198,"_30870":142003,"_3543":11806},[],{"_4098":84555,"_34307":84465,"_23429":142208,"_5":16198,"_30870":142003,"_3543":65204},[],{"_4098":84556,"_34307":84465,"_23429":142210,"_5":16198,"_30870":142003,"_3543":34154},[],{"_4098":84557,"_34307":84465,"_23429":142212,"_5":16198,"_30870":142003,"_3543":65199},[],{"_4098":84558,"_34307":84465,"_23429":142214,"_5":16198,"_30870":142003,"_3543":11743},[],{"_4098":84559,"_34307":84465,"_23429":142216,"_5":16198,"_30870":142003,"_3543":65213},[],{"_4098":84560,"_34307":84465,"_23429":142218,"_5":16198,"_30870":142003,"_3543":32969},[],{"_4098":84561,"_34307":84465,"_23429":142220,"_5":16198,"_30870":142003,"_3543":65199},[],{"_4098":84562,"_34307":84465,"_23429":142222,"_5":16198,"_30870":142003,"_3543":11596},[],{"_4098":84563,"_34307":84465,"_23429":142224,"_5":16198,"_30870":142003,"_3543":65222},[],{"_4098":84564,"_34307":84465,"_23429":142226,"_5":16198,"_30870":142003,"_3543":32975},[],{"_4098":84565,"_34307":84465,"_23429":142228,"_5":16198,"_30870":142003,"_3543":65199},[],{"_4098":84566,"_34307":84465,"_23429":142230,"_5":16198,"_30870":142003,"_3543":11935},[],{"_4098":84567,"_34307":84465,"_23429":142232,"_5":16198,"_30870":142003,"_3543":65231},[],{"_4098":84568,"_34307":84465,"_23429":142234,"_5":16198,"_30870":142003,"_3543":32981},[],{"_4098":84569,"_34307":84465,"_23429":142236,"_5":16198,"_30870":142003,"_3543":65199},[],{"_4098":84570,"_34307":84465,"_23429":142238,"_5":16198,"_30870":142003,"_3543":11605},[],{"_4098":84571,"_34307":84465,"_23429":142240,"_5":16198,"_30870":142003,"_3543":65240},[],{"_4098":84572,"_34307":84465,"_23429":142242,"_5":16198,"_30870":142003,"_3543":11599},[],{"_4098":84573,"_34307":84465,"_23429":142244,"_5":16198,"_30870":142003,"_3543":65199},[],{"_4098":84574,"_34307":84465,"_23429":142246,"_5":16198,"_30870":142003,"_3543":11636},[],{"_4098":84575,"_34307":84465,"_23429":142248,"_5":16198,"_30870":142003,"_3543":65249},[],{"_4098":84576,"_34307":84465,"_23429":142250,"_5":16198,"_30870":142003,"_3543":32857},[],{"_4098":84577,"_34307":84465,"_23429":142252,"_5":16198,"_30870":142003,"_3543":65199},[],{"_4098":84578,"_34307":84465,"_23429":142254,"_5":16198,"_30870":142003,"_3543":11617},[],{"_4098":84579,"_34307":84465,"_23429":142256,"_5":16198,"_30870":142003,"_3543":65258},[],{"_4098":84580,"_34307":84465,"_23429":142258,"_5":16198,"_30870":142003,"_3543":32879},[],{"_4098":84581,"_34307":84465,"_23429":142260,"_5":16198,"_30870":142003,"_3543":65199},[],{"_4098":84582,"_34307":84465,"_23429":142262,"_5":16198,"_30870":142003,"_3543":29450},[],{"_4098":84583,"_34307":84465,"_23429":142264,"_5":16198,"_30870":142003,"_3543":65267},[],{"_4098":84584,"_34307":84465,"_23429":142266,"_5":16198,"_30870":142003,"_3543":32921},[],{"_4098":84585,"_34307":84465,"_23429":142268,"_5":16198,"_30870":142003,"_3543":65272},[],{"_4098":84586,"_34307":84465,"_23429":142270,"_5":16198,"_30870":142003,"_3543":33356},[],{"_4098":84587,"_34307":84465,"_23429":142272,"_5":16198,"_30870":142003,"_3543":65277},[],{"_4098":84588,"_34307":84465,"_23429":142274,"_5":16198,"_30870":142003,"_3543":32987},[],{"_4098":84589,"_34307":84465,"_23429":142276,"_5":16198,"_30870":142003,"_3543":65272},[],{"_4098":84590,"_34307":84465,"_23429":142278,"_5":16198,"_30870":142003,"_3543":33390},[],{"_4098":84591,"_34307":84465,"_23429":142280,"_5":16198,"_30870":142003,"_3543":65286},[],{"_4098":84592,"_34307":84465,"_23429":142282,"_5":16198,"_30870":142003,"_3543":32993},[],{"_4098":84593,"_34307":84465,"_23429":142284,"_5":16198,"_30870":142003,"_3543":65272},[],{"_4098":84594,"_34307":84465,"_23429":142286,"_5":16198,"_30870":142003,"_3543":32852},[],{"_4098":84595,"_34307":84465,"_23429":142288,"_5":16198,"_30870":142003,"_3543":65295},[],{"_4098":84596,"_34307":84465,"_23429":142290,"_5":16198,"_30870":142003,"_3543":32999},[],{"_4098":84597,"_34307":84465,"_23429":142292,"_5":16198,"_30870":142003,"_3543":65272},[],{"_4098":84598,"_34307":84465,"_23429":142294,"_5":16198,"_30870":142003,"_3543":33456},[],{"_4098":84599,"_34307":84465,"_23429":142296,"_5":16198,"_30870":142003,"_3543":65304},[],{"_4098":84600,"_34307":84465,"_23429":142298,"_5":16198,"_30870":142003,"_3543":32885},[],{"_4098":84601,"_34307":84465,"_23429":142300,"_5":16198,"_30870":142003,"_3543":65272},[],{"_4098":84602,"_34307":84465,"_23429":142302,"_5":16198,"_30870":142003,"_3543":33039},[],{"_4098":84603,"_34307":84465,"_23429":142304,"_5":16198,"_30870":142003,"_3543":65313},[],{"_4098":84604,"_34307":84465,"_23429":142306,"_5":16198,"_30870":142003,"_3543":34187},[],{"_4098":84605,"_34307":84465,"_23429":142308,"_5":16198,"_30870":142003,"_3543":64973},[],{"_4098":84606,"_34307":84465,"_23429":142310,"_5":16198,"_30870":142003,"_3543":33462},[],{"_4098":84607,"_34307":84465,"_23429":142312,"_5":16198,"_30870":142003,"_3543":65322},[],{"_4098":84608,"_34307":84465,"_23429":142314,"_5":16198,"_30870":142003,"_3543":32963},[],{"_4098":84609,"_34307":84465,"_23429":142316,"_5":16198,"_30870":142003,"_3543":64973},[],{"_4098":84610,"_34307":84465,"_23429":142318,"_5":16198,"_30870":142003,"_3543":142319},[],"El tipo de clave debe coincidir con la familia de la variante: crear una clave `Composite-ML-DSA-ECDSA` con `size` 3 falla con un error que indica que la variante no es válida para ese tipo de clave.",{"_4098":84611,"_34307":84465,"_23429":142321,"_5":16198,"_30870":142003,"_3543":142322},[],"La implementación se escribió contra el borrador 19 de la especificación, que después se publicó como RFC 10073, y se ha contrastado con el texto publicado. Los identificadores de objeto, el prefijo de separación de dominio, el hash que usa cada componente ECDSA y la codificación RFC 5915 de las claves privadas ECDSA coinciden con el RFC. Tres algoritmos de la especificación no están implementados porque Go no dispone de curvas Brainpool ni de Ed448: las dos variantes Brainpool (`MLDSA65-ECDSA-brainpoolP256r1` y `MLDSA87-ECDSA-brainpoolP384r1`, con su sufijo de hash) y la variante Ed448. El fork supera los vectores de prueba del Apéndice E del RFC 10073 para los 15 algoritmos que sí implementa, con firmas con y sin contexto. Estas comprobaciones cubren los vectores y los puntos indicados arriba; no son una evaluación completa de conformidad.",{"_4098":84612,"_34307":84465,"_23429":142324,"_5":16198,"_30870":142003,"_3543":142325},[],"Los parámetros de las claves y de las firmas composite deben estar ausentes en el `AlgorithmIdentifier`; los certificados que los incluyen se rechazan. Los componentes ECDSA deben usar un escalar privado con la longitud exacta de la curva.",{"_4098":84613,"_34307":84465,"_23429":142327,"_5":16198,"_30870":142007,"_3543":142328},[],"Ed25519 no es poscuántico, pero el soporte como tipo de clave de CA y de certificado se añadió en el mismo trabajo y se selecciona con el tipo de clave `Ed25519`. Se clasifica en la familia tradicional.",{"_4098":84614,"_34307":84465,"_23429":142330,"_5":16198,"_30870":142010,"_3543":142331},[],"**ML-DSA composite** es la opción más conservadora durante la transición, porque la firma solo es válida si ambos componentes se verifican y así mantiene la protección clásica si se encuentra un fallo en el algoritmo nuevo. Las claves y firmas son mayores que las clásicas.",{"_4098":84615,"_34307":84465,"_23429":142333,"_5":16198,"_30870":142010,"_3543":142334},[],"**ML-DSA** por sí solo ofrece protección poscuántica con tamaños moderados y operaciones rápidas.",{"_4098":84616,"_34307":84465,"_23429":142336,"_5":16198,"_30870":142010,"_3543":142337},[],"**SLH-DSA** es adecuado para anclas de confianza de larga vida donde se valora depender solo de funciones hash. Las firmas son considerablemente mayores y no puede autenticar conexiones TLS.",{"_4098":84617,"_34307":84465,"_23429":142339,"_5":16198,"_30870":142010,"_3543":142340},[],"**Ed25519** no es poscuántico; úsalo solo donde un algoritmo clásico sea aceptable.",{"_4098":84618,"_34307":84465,"_23429":142342,"_5":16198,"_30870":142014,"_3543":142343},[],"Lamassu no implementa intercambio de claves poscuántico propio. Los intercambios de claves híbridos que ofrece el endpoint TLS, como `X25519MLKEM768`, son los de la biblioteca estándar de Go 1.27. Los diseños de certificados Chameleon y delta que se exploraron en iteraciones anteriores se eliminaron y no forman parte de la implementación.",{"_4098":84619,"_34307":84465,"_23429":142345,"_5":16198,"_30870":142014,"_3543":142346},[],"<Card title=\"Toolchain de Go PQC\" description=\"El fork que implementa estos algoritmos y la API que añade.\" href=\"/docs/platform/pqc/go-toolchain\" />",{"_4098":84620,"_34307":84465,"_23429":142348,"_5":16198,"_30870":142014,"_3543":142349},[],"<Card title=\"Claves y autoridades de certificación\" description=\"Usar estos parámetros en las peticiones al KMS y a la CA.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_4098":84621,"_34307":84621,"_5":16596,"_3543":65361,"_34738":142351,"_23429":142353,"_30870":84621},[56936,135600,141985,142352],"Soporte en la plataforma",[],{"_4098":84622,"_34307":84621,"_23429":142355,"_5":16198,"_30870":84621,"_3543":142356},[],"Cómo expone la interfaz web los algoritmos poscuánticos al crear claves, CA y certificados, y cómo los muestra.",{"_4098":84623,"_34307":84621,"_5":34735,"_23429":142358,"_30870":142359,"_3543":142360},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#elegir-tipo-de-clave-y-especificación","Elegir tipo de clave y especificación",{"_4098":84624,"_34307":84621,"_5":34735,"_23429":142362,"_30870":142363,"_3543":142364},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#emitir-un-certificado-con-una-clave-generada-en-el-navegador","Emitir un certificado con una clave generada en el navegador",{"_4098":84625,"_34307":84621,"_5":34735,"_23429":142366,"_30870":142367,"_3543":142368},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#cómo-se-muestran-los-objetos","Cómo se muestran los objetos",{"_4098":84626,"_34307":84621,"_5":34735,"_23429":142370,"_30870":142371,"_3543":142372},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#certificados-relacionados","Certificados relacionados",{"_4098":84627,"_34307":84621,"_5":34735,"_23429":142374,"_30870":142375,"_3543":142376},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#crea-un-perfil-de-emisión-que-habilite-la-función","Crea un perfil de emisión que habilite la función",{"_4098":84628,"_34307":84621,"_5":34735,"_23429":142378,"_30870":142379,"_3543":142380},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#comprueba-qué-perfiles-la-permiten","Comprueba qué perfiles la permiten",{"_4098":84629,"_34307":84621,"_5":34735,"_23429":142382,"_30870":142383,"_3543":142384},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#solicita-el-certificado-vinculado","Solicita el certificado vinculado",{"_4098":84630,"_34307":84621,"_5":34735,"_23429":142386,"_30870":142387,"_3543":142388},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#comprueba-el-resultado","Comprueba el resultado",{"_4098":84631,"_34307":84621,"_5":34735,"_23429":142390,"_30870":142391,"_3543":142392},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#aspectos-a-tener-en-cuenta","Aspectos a tener en cuenta",{"_4098":84632,"_34307":84621,"_23429":142394,"_5":16198,"_30870":84621,"_3543":142395},[],"El dashboard (rama `feat/lamassu-q`) permite a un administrador crear e inspeccionar claves, autoridades de certificación y certificados poscuánticos sin escribir peticiones a la API. Añade las opciones de algoritmo, muestra la familia de algoritmo de cada objeto e interpreta los nuevos identificadores en los certificados. Todo lo que envía se describe en Claves y autoridades de certificación; esta página cubre lo que muestra la interfaz y dónde difiere su comportamiento entre pantallas.",{"_4098":84633,"_34307":84621,"_23429":142397,"_5":16198,"_30870":142359,"_3543":142398},[],"Crear una clave del KMS, una CA con una clave nueva y un certificado con clave generada en el servidor usan el mismo par de selectores. *Key type* está agrupado por familia y *Key specification* depende del tipo.",{"_4098":84634,"_34307":84621,"_23429":142400,"_5":16198,"_30870":142359,"_3543":142401},[],"Grupo",{"_4098":84635,"_34307":84621,"_23429":142403,"_5":16198,"_30870":142359,"_3543":142404},[],"Tipos de clave",{"_4098":84636,"_34307":84621,"_23429":142406,"_5":16198,"_30870":142359,"_3543":65418},[],{"_4098":84637,"_34307":84621,"_23429":142408,"_5":16198,"_30870":142359,"_3543":65421},[],{"_4098":84638,"_34307":84621,"_23429":142410,"_5":16198,"_30870":142359,"_3543":65424},[],{"_4098":84639,"_34307":84621,"_23429":142412,"_5":16198,"_30870":142359,"_3543":65427},[],{"_4098":84640,"_34307":84621,"_23429":142414,"_5":16198,"_30870":142359,"_3543":65430},[],{"_4098":84641,"_34307":84621,"_23429":142416,"_5":16198,"_30870":142359,"_3543":65433},[],{"_4098":84642,"_34307":84621,"_23429":142418,"_5":16198,"_30870":142359,"_3543":142419},[],"La lista de especificaciones muestra ML-DSA-44, -65 o -87, los doce conjuntos de parámetros de SLH-DSA (por ejemplo *4 - SHAKE\\_128f*) o las variantes composite por nombre. La interfaz envía como `size` el identificador del conjunto de parámetros, según se explica en Algoritmos, y muestra un indicador de fortaleza junto a cada opción. En las claves composite el indicador muestra dos barras, una para el componente clásico y otra para el poscuántico.",{"_4098":84643,"_34307":84621,"_23429":142421,"_5":16198,"_30870":142359,"_3543":142422},[],"Una vez creada, la lista de claves muestra el tipo de cada clave y su fortaleza. Una clave composite muestra dos indicadores, uno para su componente clásico (C) y otro para su componente poscuántico (PQ).",{"_4098":84644,"_34307":84621,"_23429":142424,"_5":16198,"_30870":142359,"_3543":142425},[],"Las opciones habilitadas dependen del motor criptográfico. Al crear una clave o una CA, la interfaz lista todos los algoritmos pero deshabilita los que el motor seleccionado no soporta, y pide seleccionar antes un motor. Al crear un certificado en el servidor, los tipos no soportados se ocultan en su lugar.",{"_4098":84645,"_34307":84621,"_23429":142427,"_5":16198,"_30870":142363,"_3543":142428},[],"Emitir un certificado desde una CA genera el par de claves en el navegador, construye la solicitud de certificado y la envía a la CA para su firma. Los tipos de clave que se ofrecen aquí son `RSA`, `ECDSA`, `Ed25519`, `ML-DSA`, `SLH-DSA` y una única entrada `Composite ML-DSA`, y se generan en el navegador: con las bibliotecas `@noble` para ML-DSA y SLH-DSA y con WebCrypto para los algoritmos clásicos.",{"_4098":84646,"_34307":84621,"_23429":142430,"_5":16198,"_30870":142363,"_3543":142431},[],"La generación de claves composite no está disponible en `@noble`. El equipo de Lamassu la ha implementado para el dashboard: combina la clave ML-DSA con una clave RSA, ECDSA o Ed25519 y firma el mensaje representativo composite tal como define la especificación, de modo que una solicitud de certificado composite puede crearse íntegramente en el navegador.",{"_4098":84647,"_34307":84621,"_23429":142433,"_5":16198,"_30870":142363,"_3543":142434},[],"La clave privada generada se muestra una sola vez al final del procedimiento, junto al certificado emitido, con una advertencia para guardarla de forma segura. Lamassu no la conserva, así que descárgala o cópiala antes de salir de la página.",{"_4098":84648,"_34307":84621,"_23429":142436,"_5":16198,"_30870":142363,"_3543":142437},[],"El navegador no verifica las firmas de las solicitudes ML-DSA, SLH-DSA, composite ni Ed25519; confía en el KMS.",{"_4098":84649,"_34307":84621,"_23429":142439,"_5":16198,"_30870":142367,"_3543":142440},[],"Las listas y las vistas de detalle muestran la familia del algoritmo. La tabla de CA tiene una columna *PQC* con T, PQ o PQ/T, las tarjetas de CA y el grafo de CA muestran una insignia *PQC*, las listas de claves muestran un icono cuántico, y el detalle de una CA o un certificado muestra el algoritmo, su fortaleza y la insignia de familia. La familia se calcula a partir del identificador de algoritmo del certificado interpretado.",{"_4098":84650,"_34307":84621,"_23429":142442,"_5":16198,"_30870":142367,"_3543":142443},[],"La lista de certificados tiene una columna *Algorithm* con las mismas etiquetas: en el ejemplo siguiente, un certificado tradicional (T), un certificado poscuántico puro (PQ) y la CA composite que los emitió (PQ/T).",{"_4098":84651,"_34307":84621,"_23429":142445,"_5":16198,"_30870":142367,"_3543":142446},[],"Los nombres de algoritmo se resuelven a partir de los identificadores de objeto. Los identificadores de ML-DSA, SLH-DSA, composite y Ed25519 se muestran como nombres con su conjunto de parámetros, por ejemplo *ML-DSA-65* o *Composite-Signature MLDSA65-ECDSA-P384-SHA512*, y para ellos no se muestra longitud en bits. Los algoritmos de firma RSA y ECDSA se muestran con etiquetas propias del dashboard, como *RSA PKCS#1 v1.5 SHA-256* y *ECDSA SHA-256*, en lugar de los nombres de OpenSSL `sha256WithRSAEncryption` y `ecdsa-with-SHA256`.",{"_4098":84652,"_34307":84621,"_23429":142448,"_5":16198,"_30870":142367,"_3543":142449},[],"La página de detalle de una clave puede firmar y verificar con una clave poscuántica y habilita únicamente el algoritmo de firma que le corresponde.",{"_4098":84653,"_34307":84621,"_23429":142451,"_5":16198,"_30870":142367,"_3543":142452},[],"El ejemplo siguiente firma un contenido con la clave de una CA composite, usando el algoritmo composite que corresponde a la clave.",{"_4098":84654,"_34307":84621,"_23429":142454,"_5":16198,"_30870":142371,"_3543":142455},[],"El dashboard cubre todo el flujo de certificados relacionados sin peticiones a la API: habilitar la función en un perfil de emisión, comprobar qué perfiles la tienen y solicitar el certificado vinculado. Los campos de configuración son los descritos en Configurar un perfil de emisión.",{"_4098":84655,"_34307":84621,"_23429":142457,"_5":16198,"_30870":142375,"_3543":142458},[],"Ve a **Issuance Profiles** y selecciona **Create New Profile**. En la sección *Related Certificates*, activa **Enable Related Certificates**. Con el interruptor desactivado, se rechaza una solicitud de certificado que lleve el atributo `relatedCertRequest`.",{"_4098":84656,"_34307":84621,"_23429":142460,"_5":16198,"_30870":142375,"_3543":142461},[],"**Allowed Hosts** lista un nombre de host por línea. El servidor descarga los certificados relacionados por `http` o `https` solo desde esos hosts, como se explica en Ubicaciones desde las que la CA puede descargar. Los certificados incluidos en la solicitud como URI `data:` se aceptan siempre.",{"_4098":84657,"_34307":84621,"_23429":142463,"_5":16198,"_30870":142375,"_3543":142464},[],"**Max Attribute Age** es la antigüedad máxima de la hora de solicitud del atributo. Usa las unidades `y`, `w`, `d`, `h`, `m` o `s`, por ejemplo `5m` o `1h`. Si lo dejas vacío, se aplica el valor por defecto de 5 minutos.",{"_4098":84658,"_34307":84621,"_23429":142466,"_5":16198,"_30870":142375,"_3543":142467},[],"Completa el resto del perfil como de costumbre, según se describe en Perfiles de certificado.",{"_4098":84659,"_34307":84621,"_23429":142469,"_5":16198,"_30870":142379,"_3543":142470},[],"La lista de perfiles de emisión muestra en cada tarjeta una fila *Related certs* con el valor **Enabled** o **Disabled**. Un perfil que la tiene habilitada muestra además sus hosts permitidos y su antigüedad máxima del atributo. En el ejemplo, el perfil por defecto tiene la función deshabilitada, y el segundo perfil la tiene habilitada con el host `certs.example.com` y una antigüedad máxima de una hora. Selecciona **Edit** para cambiar cualquiera de los dos ajustes más adelante.",{"_4098":84660,"_34307":84621,"_23429":142472,"_5":16198,"_30870":142379,"_3543":142473},[],"Solo un perfil guardado con la función habilitada permite solicitar un certificado vinculado. Si eliges un perfil que no la tiene, o un perfil en línea, el formulario explica por qué la opción no está disponible.",{"_4098":84661,"_34307":84621,"_23429":142475,"_5":16198,"_30870":142383,"_3543":142476},[],"Abre la CA que lo firmará, selecciona **Issue Certificate** y genera la clave en el navegador, según se describe en la sección anterior. En *Certificate Configuration*, elige **Reuse Existing** y selecciona el perfil del paso anterior. Después activa **Bind to a related certificate** en la sección *Related Certificate* y complétala:",{"_4098":84662,"_34307":84621,"_23429":142478,"_5":16198,"_30870":142383,"_3543":142479},[],"**Related certificate (PEM, optional).** Pega el certificado existente. Se usan su emisor y su número de serie exactos y los campos siguientes quedan bloqueados. Si no lo pegas, introduce el emisor, como campos de nombre o como DER sin procesar, y el número de serie en hexadecimal.",{"_4098":84663,"_34307":84621,"_23429":142481,"_5":16198,"_30870":142383,"_3543":142482},[],"**Location of the related certificate.** Una URI por línea: una URI `data:` con un PKCS#7 en base64 que contenga el certificado, o una URL `http` o `https` que apunte a un certificado DER simple en un host permitido.",{"_4098":84664,"_34307":84621,"_23429":142484,"_5":16198,"_30870":142383,"_3543":142485},[],"**Data to sign.** El formulario construye el emisor y el número de serie seguidos de la hora de solicitud, que estampa automáticamente. Cópialo como hex o base64. **Refresh** lo recalcula con la hora actual.",{"_4098":84665,"_34307":84621,"_23429":142487,"_5":16198,"_30870":142383,"_3543":142488},[],"**Signature.** Firma esos bytes con la clave privada del certificado relacionado, fuera del navegador, y pega la firma en hex o base64. Usa el algoritmo habitual de la clave: ECDSA con SHA-256, SHA-384 o SHA-512 según la curva, RSA PKCS#1 v1.5 con SHA-256, y Ed25519 o ML-DSA puros. Una firma ECDSA puede ser DER o `r||s` sin procesar.",{"_4098":84666,"_34307":84621,"_23429":142490,"_5":16198,"_30870":142383,"_3543":142491},[],"Para construir la URI `data:` a partir de un fichero de certificado, `cert.pem`, envuélvelo en una estructura PKCS#7 y codifícalo en base64:",{"_4098":84667,"_34307":84621,"_23429":142493,"_5":16198,"_30870":142383,"_3543":142494},[],"Pega la salida en una sola línea en el campo de ubicación. El servidor solo comprueba que la URI esté codificada en base64 y que el contenido sea una estructura PKCS#7 cuyo primer certificado sea el relacionado.",{"_4098":84668,"_34307":84621,"_23429":142496,"_5":16198,"_30870":142383,"_3543":142497},[],"La clave del certificado relacionado suele permanecer en el dispositivo o sistema que la posee, de modo que la firma se produce allí. Si esa clave está en Lamassu, usa **Sign / Verify** sobre la clave, según se describe en Claves y motores criptográficos.",{"_4098":84669,"_34307":84621,"_23429":142499,"_5":16198,"_30870":142383,"_3543":142500},[],"La CA solo acepta la solicitud si su hora está dentro de la antigüedad máxima del atributo del perfil, contada desde el momento en que recibe la solicitud. Firma y emite dentro de esa ventana, o selecciona **Refresh** y firma los datos nuevos. Después emite el certificado como de costumbre.",{"_4098":84670,"_34307":84621,"_23429":142502,"_5":16198,"_30870":142387,"_3543":142503},[],"Las páginas de detalle del nuevo certificado muestran una fila *Related Certificate* con el algoritmo de hash y el hash del certificado relacionado. Solo aparece en los certificados que llevan la extensión, de modo que un certificado emitido sin el vínculo no muestra esa fila.",{"_4098":84671,"_34307":84621,"_23429":142505,"_5":16198,"_30870":142387,"_3543":142506},[],"Para comprobar que el valor corresponde al certificado esperado, calcula el hash de su codificación DER con el mismo algoritmo y compáralo:",{"_4098":84672,"_34307":84621,"_23429":142508,"_5":16198,"_30870":142387,"_3543":142509},[],"El algoritmo es SHA-256, SHA-384 o SHA-512, el que indica la fila. Las reglas que debe cumplir el certificado vinculado están en Qué debe cumplir el certificado emitido.",{"_4098":84673,"_34307":84621,"_23429":142511,"_5":16198,"_30870":142391,"_3543":142512},[],"Los nombres de los tipos de clave no son idénticos en todas las pantallas. La creación de claves y de CA usa `Composite-ML-DSA-RSA`, `-ECDSA` y `-Ed25519`; el formulario de emisión de certificados usa un único `Composite-ML-DSA`; y el formulario de certificado en el servidor compara nombres en mayúsculas. Los nombres que el backend informa para una clave pueden diferir, por tanto, en mayúsculas y minúsculas de lo que envía la interfaz.",{"_4098":84674,"_34307":84621,"_23429":142514,"_5":16198,"_30870":142391,"_3543":142515},[],"La interfaz no incluye ningún aviso de carácter experimental para estos algoritmos y no está traducida: todos los textos están en inglés.",{"_4098":84675,"_34307":84621,"_23429":142517,"_5":16198,"_30870":142391,"_3543":142518},[],"La correspondencia entre el identificador del conjunto de parámetros de SLH-DSA y el algoritmo que usa el generador de claves del navegador no sigue el mismo orden que los identificadores que muestra el selector y que usa el backend, salvo en el identificador 1. Un certificado emitido por el flujo del navegador con un identificador SLH-DSA del 2 al 12 puede usar, por tanto, un conjunto de parámetros distinto del que nombra el selector. Hasta que se corrija, conviene crear las claves SLH-DSA con el KMS.",{"_4098":84676,"_34307":84621,"_23429":142520,"_5":16198,"_30870":142391,"_3543":142521},[],"<Card title=\"Claves y autoridades de certificación\" description=\"La API que hay detrás de estas pantallas.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_4098":84677,"_34307":84621,"_23429":142523,"_5":16198,"_30870":142391,"_3543":142524},[],"<Card title=\"Limitaciones conocidas\" description=\"Carencias de la interfaz y de la plataforma.\" href=\"/docs/platform/pqc/limitations\" />",{"_4098":84678,"_34307":84678,"_5":16596,"_3543":142526,"_34738":142527,"_23429":142528,"_30870":84678},"Despliegue con el Helm chart",[56936,135600,141985,134169],[],{"_4098":84679,"_34307":84678,"_23429":142530,"_5":16198,"_30870":84678,"_3543":142531},[],"Desplegar Lamassu con un proxy frontal Traefik que sirve certificados clásicos, poscuánticos y composite, mediante los valores del chart o el instalador fast-lane.",{"_4098":84680,"_34307":84678,"_5":34735,"_23429":142533,"_30870":142534,"_3543":142535},[],"/docs/pr-preview/pr-58/es/platform/pqc/deployment#topología","Topología",{"_4098":84681,"_34307":84678,"_5":34735,"_23429":142537,"_30870":142538,"_3543":142539},[],"/docs/pr-preview/pr-58/es/platform/pqc/deployment#valores-del-chart","Valores del chart",{"_4098":84682,"_34307":84678,"_5":34735,"_23429":142541,"_30870":142542,"_3543":142543},[],"/docs/pr-preview/pr-58/es/platform/pqc/deployment#el-instalador-fast-lane","El instalador fast-lane",{"_4098":84683,"_34307":84678,"_23429":142545,"_5":16198,"_30870":84678,"_3543":142546},[],"La rama `pqc` del Helm chart de Lamassu añade un proxy frontal: una instancia de Traefik compilada con el toolchain de Go PQC que termina el TLS de los dispositivos, los autentica y reenvía el tráfico a Envoy Gateway. Esta página describe la topología resultante, los valores que la controlan y el instalador que automatiza un despliegue de laboratorio.",{"_4098":84684,"_34307":84678,"_23429":142548,"_5":16198,"_30870":84678,"_3543":142549},[],"El chart y el instalador asumen un clúster de desarrollo. La imagen del proxy usa una etiqueta mutable, los certificados PQC no se renuevan automáticamente y el salto entre Traefik y Envoy no verifica certificados. Esta configuración no debe usarse tal cual en producción.",{"_4098":84685,"_34307":84678,"_23429":142551,"_5":16198,"_30870":142534,"_3543":142552},[],"Traefik es el borde público. Negocia el intercambio de claves, sirve el certificado y, si se solicita, recibe el certificado del cliente. Después abre una segunda conexión TLS hacia el servicio `envoy-gateway-proxy` de Envoy Gateway, que presenta el certificado clásico autofirmado del chart; Traefik está configurado para aceptarlo sin verificarlo. Envoy no llega a ver, por tanto, un handshake poscuántico, y la protección poscuántica cubre solo la conexión entre el cliente y Traefik. Traefik y Envoy Gateway se instalan una sola vez por clúster y se comparten entre espacios de nombres, mientras que los recursos del proxy frontal (el Gateway, la ruta, el middleware, el certificado y el reference grant) pertenecen a la release de Lamassu.",{"_4098":84686,"_34307":84678,"_23429":142554,"_5":16198,"_30870":142534,"_3543":142555},[],"Cuando el cliente ha enviado un certificado, el middleware `inject-client-cert` del chart lo añade, en formato PEM, a la cabecera `X-Forwarded-Tls-Client-Cert`, y se establece la cabecera `X-Forwarded-Proto: https` en la petición.",{"_4098":84687,"_34307":84678,"_23429":142557,"_5":16198,"_30870":142538,"_3543":142558},[],"Todos los valores nuevos están bajo `traefikFrontProxy` y los valida el esquema del chart, que rechaza claves desconocidas.",{"_4098":84688,"_34307":84678,"_23429":142560,"_5":16198,"_30870":142538,"_3543":142561},[],"Nombre",{"_4098":84689,"_34307":84678,"_23429":142563,"_5":16198,"_30870":142538,"_3543":138214},[],{"_4098":84690,"_34307":84678,"_23429":142565,"_5":16198,"_30870":142538,"_3543":142566},[],"Valor por defecto",{"_4098":84691,"_34307":84678,"_23429":142568,"_5":16198,"_30870":142538,"_3543":138220},[],{"_4098":84692,"_34307":84678,"_23429":142570,"_5":16198,"_30870":142538,"_3543":65587},[],{"_4098":84693,"_34307":84678,"_23429":142572,"_5":16198,"_30870":142538,"_3543":114099},[],{"_4098":84694,"_34307":84678,"_23429":142574,"_5":16198,"_30870":142538,"_3543":65592},[],{"_4098":84695,"_34307":84678,"_23429":142576,"_5":16198,"_30870":142538,"_3543":142577},[],"Despliega los recursos del proxy frontal.",{"_4098":84696,"_34307":84678,"_23429":142579,"_5":16198,"_30870":142538,"_3543":65598},[],{"_4098":84697,"_34307":84678,"_23429":142581,"_5":16198,"_30870":142538,"_3543":106411},[],{"_4098":84698,"_34307":84678,"_23429":142583,"_5":16198,"_30870":142538,"_3543":65603},[],{"_4098":84699,"_34307":84678,"_23429":142585,"_5":16198,"_30870":142538,"_3543":142586},[],"Nombre del certificado de borde y nombre de host de la ruta. Debe indicarse cuando el proxy está habilitado.",{"_4098":84700,"_34307":84678,"_23429":142588,"_5":16198,"_30870":142538,"_3543":65609},[],{"_4098":84701,"_34307":84678,"_23429":142590,"_5":16198,"_30870":142538,"_3543":91935},[],{"_4098":84702,"_34307":84678,"_23429":142592,"_5":16198,"_30870":142538,"_3543":65614},[],{"_4098":84703,"_34307":84678,"_23429":142594,"_5":16198,"_30870":142538,"_3543":142595},[],"Puerto del listener HTTPS; debe coincidir con el entry point `websecure` de Traefik.",{"_4098":84704,"_34307":84678,"_23429":142597,"_5":16198,"_30870":142538,"_3543":65620},[],{"_4098":84705,"_34307":84678,"_23429":142599,"_5":16198,"_30870":142538,"_3543":106411},[],{"_4098":84706,"_34307":84678,"_23429":142601,"_5":16198,"_30870":142538,"_3543":65625},[],{"_4098":84707,"_34307":84678,"_23429":142603,"_5":16198,"_30870":142538,"_3543":142604},[],"Origen del certificado clásico: `certManager`, `external` o `none`.",{"_4098":84708,"_34307":84678,"_23429":142606,"_5":16198,"_30870":142538,"_3543":65631},[],{"_4098":84709,"_34307":84678,"_23429":142608,"_5":16198,"_30870":142538,"_3543":99624},[],{"_4098":84710,"_34307":84678,"_23429":142610,"_5":16198,"_30870":142538,"_3543":65636},[],{"_4098":84711,"_34307":84678,"_23429":142612,"_5":16198,"_30870":142538,"_3543":142613},[],"Direcciones IP añadidas al certificado autofirmado.",{"_4098":84712,"_34307":84678,"_23429":142615,"_5":16198,"_30870":142538,"_3543":65642},[],{"_4098":84713,"_34307":84678,"_23429":142617,"_5":16198,"_30870":142538,"_3543":106411},[],{"_4098":84714,"_34307":84678,"_23429":142619,"_5":16198,"_30870":142538,"_3543":65603},[],{"_4098":84715,"_34307":84678,"_23429":142621,"_5":16198,"_30870":142538,"_3543":142622},[],"Secret con `tls.crt` y `tls.key` cuando el tipo es `external`.",{"_4098":84716,"_34307":84678,"_23429":142624,"_5":16198,"_30870":142538,"_3543":65652},[],{"_4098":84717,"_34307":84678,"_23429":142626,"_5":16198,"_30870":142538,"_3543":99624},[],{"_4098":84718,"_34307":84678,"_23429":142628,"_5":16198,"_30870":142538,"_3543":65636},[],{"_4098":84719,"_34307":84678,"_23429":142630,"_5":16198,"_30870":142538,"_3543":142631},[],"Secrets TLS adicionales, por ejemplo certificados ML-DSA o composite, que se sirven en el mismo listener.",{"_4098":84720,"_34307":84678,"_23429":142633,"_5":16198,"_30870":142538,"_3543":142634},[],"Con `certManager`, el chart solicita un certificado ECDSA P-256 válido durante 2160 horas a su propio emisor autofirmado y lo guarda en el secret `edge-cert`. Con `none`, solo se sirven los secrets adicionales, y el chart se detiene con un error si no hay ninguno. El proxy elige entre todos los certificados según el cliente, tal como describe Proxy TLS con Traefik. Los nombres de los recursos que crea el chart son fijos, por lo que solo se admite una release por espacio de nombres.",{"_4098":84721,"_34307":84678,"_23429":142636,"_5":16198,"_30870":142538,"_3543":142637},[],"El chart modifica además el servicio de Envoy Gateway para que su puerto HTTPS declare `appProtocol: https`, algo que las versiones recientes de Traefik necesitan para hablar TLS con él. Cuando `gateway.addresses` está vacío, el servicio de Envoy es de tipo `ClusterIP` en lugar de un balanceador de carga.",{"_4098":84722,"_34307":84678,"_23429":142639,"_5":16198,"_30870":142538,"_3543":142640},[],"El chart no despliega Traefik, ni la GatewayClass `traefik`, ni la opción TLS `default` en el espacio de nombres `traefik-system`; los crea el instalador. Sin ellos, el borde no tiene intercambio de claves poscuántico ni solicitud de certificado de cliente. Tampoco fija las imágenes de los servicios de Lamassu: los valores por defecto son las imágenes de desarrollo, y el instalador sustituye las de la interfaz, CA, KMS, VA, device manager, DMS manager, alertas y autorización por las etiquetas `:pqc` de `ghcr.io/lamassuiot`.",{"_4098":84723,"_34307":84678,"_23429":142642,"_5":16198,"_30870":142542,"_3543":142643},[],"`scripts/lamassu-fast-lane.sh` instala todo en un clúster: las definiciones de recursos personalizados de Gateway API (versión 1.6.3, canal experimental), Envoy Gateway 1.8.0, el chart de Traefik 41.0.2 con la imagen PQC, la opción TLS, PostgreSQL, Keycloak, RabbitMQ, opcionalmente observabilidad y SoftHSM, y por último la release de Lamassu. Los dos parámetros relevantes aquí seleccionan qué algoritmos se ofrecen.",{"_4098":84724,"_34307":84678,"_23429":142645,"_5":16198,"_30870":142542,"_3543":142646},[],"Ambos parámetros aceptan una lista separada por comas de `T`, `PQ` y `PQ/T`, y ambos toman por defecto los tres valores. En el intercambio de claves, `PQ/T` es un grupo híbrido que combina un intercambio clásico y uno ML-KEM (`X25519MLKEM768`, `SecP256r1MLKEM768` y `SecP384r1MLKEM1024`) y `PQ` es ML-KEM puro (`MLKEM1024`); en la autenticación, `PQ/T` es un certificado composite. `--tls-kex` rellena los `curvePreferences` de la opción TLS, y `--tls-auth` selecciona qué certificados se sirven:",{"_4098":84725,"_34307":84678,"_23429":142648,"_5":16198,"_30870":142542,"_3543":142649},[],"Valor",{"_4098":84726,"_34307":84678,"_23429":142651,"_5":16198,"_30870":142542,"_3543":142652},[],"Grupos de intercambio de claves",{"_4098":84727,"_34307":84678,"_23429":142654,"_5":16198,"_30870":142542,"_3543":138400},[],{"_4098":84728,"_34307":84678,"_23429":142656,"_5":16198,"_30870":142542,"_3543":65685},[],{"_4098":84729,"_34307":84678,"_23429":142658,"_5":16198,"_30870":142542,"_3543":65688},[],{"_4098":84730,"_34307":84678,"_23429":142660,"_5":16198,"_30870":142542,"_3543":142661},[],"ECDSA P-256 de cert-manager, o los ficheros indicados con `--tls-crt` y `--tls-key`, en el secret `edge-cert`.",{"_4098":84731,"_34307":84678,"_23429":142663,"_5":16198,"_30870":142542,"_3543":65694},[],{"_4098":84732,"_34307":84678,"_23429":142665,"_5":16198,"_30870":142542,"_3543":65697},[],{"_4098":84733,"_34307":84678,"_23429":142667,"_5":16198,"_30870":142542,"_3543":142668},[],"ML-DSA-65, en el secret `edge-cert-pq`.",{"_4098":84734,"_34307":84678,"_23429":142670,"_5":16198,"_30870":142542,"_3543":65703},[],{"_4098":84735,"_34307":84678,"_23429":142672,"_5":16198,"_30870":142542,"_3543":65706},[],{"_4098":84736,"_34307":84678,"_23429":142674,"_5":16198,"_30870":142542,"_3543":142675},[],"Composite `MLDSA65-RSA3072-PSS-SHA512`, en el secret `edge-cert-pqt`.",{"_4098":84737,"_34307":84678,"_23429":142677,"_5":16198,"_30870":142542,"_3543":142678},[],"La versión mínima de TLS es 1.3, salvo que ambos parámetros sean solo `T`, en cuyo caso es 1.2. cert-manager no puede emitir certificados poscuánticos, por lo que el instalador crea los certificados PQ y PQ/T localmente con OpenSSL 3.5 o posterior; el certificado composite necesita además el módulo `hybrid-provider`, que el script compila bajo demanda con `git`, `cmake` y un compilador de C. Las claves privadas ML-DSA se escriben en la forma de solo semilla que Go acepta, y los secrets se crean a partir de un manifiesto porque `kubectl create secret tls` rechaza claves ML-DSA. Los certificados duran 365 días y se conservan si el secret ya existe.",{"_4098":84738,"_34307":84678,"_23429":142680,"_5":16198,"_30870":142542,"_3543":142681},[],"El script requiere `yq`, `kubectl` y `helm`, y `jq` con `--sample-data`. Al terminar imprime cómo extraer la CA en la que deben confiar los dispositivos, por ejemplo `kubectl get secret edge-cert-pq -o jsonpath='{.data.ca\\.crt}'`.",{"_4098":84739,"_34307":84678,"_23429":142683,"_5":16198,"_30870":142542,"_3543":142684},[],"Los scripts complementarios para un broker MQTT detrás de Traefik (`scripts/emqx`), para exportar claves del KMS y para restaurar una copia de seguridad están presentes en el árbol de trabajo del chart, pero sin confirmar en el repositorio. Son solo para uso en laboratorio y no se describen más aquí.",{"_4098":84740,"_34307":84678,"_23429":142686,"_5":16198,"_30870":142542,"_3543":142687},[],"<Card title=\"Proxy TLS con Traefik\" description=\"Cómo elige certificado el proxy y cómo se compila.\" href=\"/docs/platform/pqc/tls-front-proxy\" />",{"_4098":84741,"_34307":84678,"_23429":142689,"_5":16198,"_30870":142542,"_3543":142690},[],"<Card title=\"Limitaciones conocidas\" description=\"Advertencias del despliegue de laboratorio.\" href=\"/docs/platform/pqc/limitations\" />",{"_4098":84742,"_34307":84742,"_5":16596,"_3543":142692,"_34738":142693,"_23429":142694,"_30870":84742},"Toolchain de Go PQC",[56936,135600,141985,141986],[],{"_4098":84743,"_34307":84742,"_23429":142696,"_5":16198,"_30870":84742,"_3543":142697},[],"El fork de Go que añade ML-DSA composite, SLH-DSA, certificados relacionados y esquemas de firma TLS composite, la API que expone y cómo se compila.",{"_4098":84744,"_34307":84742,"_5":34735,"_23429":142699,"_30870":142700,"_3543":142701},[],"/docs/pr-preview/pr-58/es/platform/pqc/go-toolchain#qué-añade-el-fork","Qué añade el fork",{"_4098":84745,"_34307":84742,"_5":34735,"_23429":142703,"_30870":142704,"_3543":142705},[],"/docs/pr-preview/pr-58/es/platform/pqc/go-toolchain#puntos-de-código-tls","Puntos de código TLS",{"_4098":84746,"_34307":84742,"_5":34735,"_23429":142707,"_30870":142708,"_3543":142709},[],"/docs/pr-preview/pr-58/es/platform/pqc/go-toolchain#un-ejemplo-mínimo","Un ejemplo mínimo",{"_4098":84747,"_34307":84742,"_5":34735,"_23429":142711,"_30870":142712,"_3543":142713},[],"/docs/pr-preview/pr-58/es/platform/pqc/go-toolchain#enfoques-descartados","Enfoques descartados",{"_4098":84748,"_34307":84742,"_5":34735,"_23429":142715,"_30870":142716,"_3543":142717},[],"/docs/pr-preview/pr-58/es/platform/pqc/go-toolchain#compilación-del-toolchain-y-de-las-imágenes","Compilación del toolchain y de las imágenes",{"_4098":84749,"_34307":84742,"_23429":142719,"_5":16198,"_30870":84742,"_3543":142720},[],"Go 1.27 incluye ML-DSA en `crypto/mldsa` y en X.509 y TLS, pero no tiene certificados composite ni SLH-DSA, ni certificados relacionados, ni esquemas de firma TLS composite. Por ello Lamassu compila su backend y su proxy TLS con un fork de Go, mantenido en la rama `release-branch.go1.27`. Esta página describe lo que añade el fork, para quienes compilan Lamassu o escriben un cliente que debe comunicarse con él.",{"_4098":84750,"_34307":84742,"_23429":142722,"_5":16198,"_30870":84742,"_3543":142723},[],"El fork expone APIs que no existen en la distribución oficial de Go. El código que las usa solo compila con este toolchain, y no debe suponerse que un binario construido con él cumple la promesa de compatibilidad de Go para esas APIs.",{"_4098":84751,"_34307":84742,"_23429":142725,"_5":16198,"_30870":142700,"_3543":142726},[],"**ML-DSA composite en X.509.** El paquete `x509` incorpora `CompositePublicKey` y `CompositePrivateKey`, que implementan `crypto.Signer`, y 15 valores `CompositeAlgorithm` (por ejemplo `x509.MLDSA65_ECDSA_P384_SHA512`) que permiten generar claves, firmar y verificar. Los certificados, las solicitudes de certificado y las listas de revocación firmados con estas claves se interpretan, se serializan y se verifican como cualquier otro. Se admite la codificación PKCS#8 de claves privadas composite. La página de algoritmos enumera los identificadores.",{"_4098":84752,"_34307":84742,"_23429":142728,"_5":16198,"_30870":142700,"_3543":142729},[],"**SLH-DSA en X.509.** El algoritmo de clave pública `x509.SLHDSA` y doce algoritmos de firma `PureSLHDSA...` están disponibles para interpretar y verificar certificados y claves. La implementación es la biblioteca `circl` de Cloudflare incorporada al fork. Es la parte menos probada: no tiene pruebas propias en x509 ni soporte TLS.",{"_4098":84753,"_34307":84742,"_23429":142731,"_5":16198,"_30870":142700,"_3543":142732},[],"**Certificados relacionados (RFC 9763).** El fork ofrece `x509.CreateBoundCertificate`, que añade a un certificado la extensión `id-pe-relatedCert` (`1.3.6.1.5.5.7.1.36`), `x509.VerifyRelatedCertificate` y las funciones para construir y comprobar el atributo `relatedCertRequest` de una solicitud de certificado (`1.2.840.113549.1.9.16.2.60`). `x509.CertificateRequest` incorpora el campo `ExtraAttributes` para transportarlo. Certificados relacionados explica cómo los usa Lamassu.",{"_4098":84754,"_34307":84742,"_23429":142734,"_5":16198,"_30870":142700,"_3543":142735},[],"**Esquemas de firma composite en TLS.** El paquete `tls` añade 15 constantes `SignatureScheme`, una por algoritmo composite, que se anuncian por defecto después de los esquemas ML-DSA nativos. Solo funcionan con TLS 1.3 y están probadas con autenticación mutua. Sus puntos de código se describen a continuación.",{"_4098":84755,"_34307":84742,"_23429":142737,"_5":16198,"_30870":142704,"_3543":142738},[],"IANA no ha asignado puntos de código a los esquemas de firma TLS composite, por lo que el fork usa el rango de uso privado `0xFE00` a `0xFE0E`, en el orden de la tabla composite: `0xFE00` es `MLDSA44-RSA2048-PSS-SHA256` y `0xFE0E` es `MLDSA65-Ed25519-SHA512`. Un cliente o un servidor construido con una biblioteca TLS estándar no los reconoce y recurrirá a otro esquema o fallará en el handshake. La interoperabilidad queda así limitada a pares construidos con este fork, o a los esquemas ML-DSA nativos (`0x0904` a `0x0906`) que implementa Go 1.27 estándar.",{"_4098":84756,"_34307":84742,"_23429":142740,"_5":16198,"_30870":142704,"_3543":142741},[],"Las tres variantes que usan RSA PKCS#1 v1.5 (`MLDSA44-RSA2048-PKCS15-SHA256`, `MLDSA65-RSA3072-PKCS15-SHA512` y `MLDSA65-RSA4096-PKCS15-SHA512`) se anuncian únicamente en la extensión `signature_algorithms_cert`, por lo que pueden aparecer en una cadena de certificados, pero un certificado hoja con una clave de ese tipo no puede firmar el handshake.",{"_4098":84757,"_34307":84742,"_23429":142743,"_5":16198,"_30870":142704,"_3543":142744},[],"Punto de código",{"_4098":84758,"_34307":84742,"_23429":142746,"_5":16198,"_30870":142704,"_3543":142190},[],{"_4098":84759,"_34307":84742,"_23429":142748,"_5":16198,"_30870":142704,"_3543":65783},[],{"_4098":84760,"_34307":84742,"_23429":142750,"_5":16198,"_30870":142704,"_3543":65194},[],{"_4098":84761,"_34307":84742,"_23429":142752,"_5":16198,"_30870":142704,"_3543":65788},[],{"_4098":84762,"_34307":84742,"_23429":142754,"_5":16198,"_30870":142704,"_3543":65204},[],{"_4098":84763,"_34307":84742,"_23429":142756,"_5":16198,"_30870":142704,"_3543":65793},[],{"_4098":84764,"_34307":84742,"_23429":142758,"_5":16198,"_30870":142704,"_3543":65213},[],{"_4098":84765,"_34307":84742,"_23429":142760,"_5":16198,"_30870":142704,"_3543":65798},[],{"_4098":84766,"_34307":84742,"_23429":142762,"_5":16198,"_30870":142704,"_3543":65222},[],{"_4098":84767,"_34307":84742,"_23429":142764,"_5":16198,"_30870":142704,"_3543":65803},[],{"_4098":84768,"_34307":84742,"_23429":142766,"_5":16198,"_30870":142704,"_3543":65231},[],{"_4098":84769,"_34307":84742,"_23429":142768,"_5":16198,"_30870":142704,"_3543":65808},[],{"_4098":84770,"_34307":84742,"_23429":142770,"_5":16198,"_30870":142704,"_3543":65240},[],{"_4098":84771,"_34307":84742,"_23429":142772,"_5":16198,"_30870":142704,"_3543":65813},[],{"_4098":84772,"_34307":84742,"_23429":142774,"_5":16198,"_30870":142704,"_3543":65249},[],{"_4098":84773,"_34307":84742,"_23429":142776,"_5":16198,"_30870":142704,"_3543":65818},[],{"_4098":84774,"_34307":84742,"_23429":142778,"_5":16198,"_30870":142704,"_3543":65258},[],{"_4098":84775,"_34307":84742,"_23429":142780,"_5":16198,"_30870":142704,"_3543":65823},[],{"_4098":84776,"_34307":84742,"_23429":142782,"_5":16198,"_30870":142704,"_3543":65267},[],{"_4098":84777,"_34307":84742,"_23429":142784,"_5":16198,"_30870":142704,"_3543":65828},[],{"_4098":84778,"_34307":84742,"_23429":142786,"_5":16198,"_30870":142704,"_3543":65277},[],{"_4098":84779,"_34307":84742,"_23429":142788,"_5":16198,"_30870":142704,"_3543":65833},[],{"_4098":84780,"_34307":84742,"_23429":142790,"_5":16198,"_30870":142704,"_3543":65286},[],{"_4098":84781,"_34307":84742,"_23429":142792,"_5":16198,"_30870":142704,"_3543":65838},[],{"_4098":84782,"_34307":84742,"_23429":142794,"_5":16198,"_30870":142704,"_3543":65295},[],{"_4098":84783,"_34307":84742,"_23429":142796,"_5":16198,"_30870":142704,"_3543":65843},[],{"_4098":84784,"_34307":84742,"_23429":142798,"_5":16198,"_30870":142704,"_3543":65304},[],{"_4098":84785,"_34307":84742,"_23429":142800,"_5":16198,"_30870":142704,"_3543":65848},[],{"_4098":84786,"_34307":84742,"_23429":142802,"_5":16198,"_30870":142704,"_3543":65313},[],{"_4098":84787,"_34307":84742,"_23429":142804,"_5":16198,"_30870":142704,"_3543":65853},[],{"_4098":84788,"_34307":84742,"_23429":142806,"_5":16198,"_30870":142704,"_3543":65322},[],{"_4098":84789,"_34307":84742,"_23429":142808,"_5":16198,"_30870":142704,"_3543":142809},[],"El intercambio de claves no cambia respecto a Go original. Los grupos híbridos como `X25519MLKEM768`, `SecP256r1MLKEM768`, `SecP384r1MLKEM1024` y el `MLKEM1024` puro son los de la biblioteca estándar de Go 1.27.",{"_4098":84790,"_34307":84742,"_23429":142811,"_5":16198,"_30870":142704,"_3543":142401},[],{"_4098":84791,"_34307":84742,"_23429":142813,"_5":16198,"_30870":142704,"_3543":142814},[],"Composición",{"_4098":84792,"_34307":84742,"_23429":142816,"_5":16198,"_30870":142704,"_3543":65866},[],{"_4098":84793,"_34307":84742,"_23429":142818,"_5":16198,"_30870":142704,"_3543":65869},[],{"_4098":84794,"_34307":84742,"_23429":142820,"_5":16198,"_30870":142704,"_3543":65872},[],{"_4098":84795,"_34307":84742,"_23429":142822,"_5":16198,"_30870":142704,"_3543":65875},[],{"_4098":84796,"_34307":84742,"_23429":142824,"_5":16198,"_30870":142704,"_3543":65878},[],{"_4098":84797,"_34307":84742,"_23429":142826,"_5":16198,"_30870":142704,"_3543":65881},[],{"_4098":84798,"_34307":84742,"_23429":142828,"_5":16198,"_30870":142704,"_3543":65697},[],{"_4098":84799,"_34307":84742,"_23429":142830,"_5":16198,"_30870":142704,"_3543":142831},[],"ML-KEM-1024 solo",{"_4098":84800,"_34307":84742,"_23429":142833,"_5":16198,"_30870":142704,"_3543":142834},[],"La conexión sigue protegida mientras al menos un componente de un grupo híbrido se mantenga seguro. El intercambio de claves es independiente del tipo de certificado: una conexión puede usar un certificado clásico y aun así tener un intercambio de claves poscuántico.",{"_4098":84801,"_34307":84742,"_23429":142836,"_5":16198,"_30870":142708,"_3543":142837},[],"El siguiente programa crea un certificado composite autofirmado y lo usa como certificado de servidor en una configuración TLS 1.3. Se omite la gestión de errores.",{"_4098":84802,"_34307":84742,"_23429":142839,"_5":16198,"_30870":142708,"_3543":142840},[],"Una clave composite también puede firmar directamente un mensaje, con un contexto opcional de como máximo 255 bytes:",{"_4098":84803,"_34307":84742,"_23429":142842,"_5":16198,"_30870":142712,"_3543":142843},[],"Las primeras iteraciones del fork implementaron certificados Chameleon, definidos en `draft-bonnell-lamps-chameleon-certs`. La idea es emparejar dos certificados del mismo sujeto, por ejemplo uno clásico y otro poscuántico, emitiendo el primero con una extensión que codifica solo las diferencias respecto al segundo. Quien confía en el certificado y entiende la extensión puede reconstruir el certificado emparejado a partir de ella y validar ese, de modo que un único certificado emitido lleva ambas identidades sin cambiar las reglas de validación de ruta del RFC 5280.",{"_4098":84804,"_34307":84742,"_23429":142845,"_5":16198,"_30870":142712,"_3543":142846},[],"El trabajo se descartó porque el borrador caducó sin llegar a ser un estándar y ya no se persigue, de modo que no había una especificación estable con la que interoperar. Nada en la implementación actual depende de él.",{"_4098":84805,"_34307":84742,"_23429":142848,"_5":16198,"_30870":142716,"_3543":142849},[],"El fork se compila en CI mediante un workflow que ejecuta la batería de pruebas de Go y después publica una imagen multiarquitectura, `ghcr.io/lamassuiot/golang-pqc`, con la etiqueta `go1.27` y, para la rama `release-branch.go1.27`, `latest`. La imagen contiene el toolchain en `/usr/local/go-pqc`, con `GOROOT` apuntando a esa ruta.",{"_4098":84806,"_34307":84742,"_23429":142851,"_5":16198,"_30870":142716,"_3543":142852},[],"Para compilar el toolchain desde el código fuente, usa la rama `release-branch.go1.27` y la compilación estándar de Go:",{"_4098":84807,"_34307":84742,"_23429":142854,"_5":16198,"_30870":142716,"_3543":142855},[],"El comando `bin/go` resultante se usa como cualquier otra cadena de herramientas de Go.",{"_4098":84808,"_34307":84742,"_23429":142857,"_5":16198,"_30870":142716,"_3543":142858},[],"Lamassu consume el toolchain de dos maneras. Las imágenes del backend (CA, KMS, VA, alertas, device manager, DMS manager y la compilación monolítica) usan `ghcr.io/lamassuiot/golang-pqc:latest` como imagen de compilación. El workflow de CI del backend instala el mismo toolchain mediante una acción de configuración propia, en lugar de `actions/setup-go`, y el backend exige `go 1.27.3` en su fichero de módulo. Traefik no se compila desde la imagen: su script `build.sh` espera una copia ya compilada del fork en un directorio vecino y genera el binario fuera de un contenedor. Véase Proxy TLS con Traefik.",{"_4098":84809,"_34307":84742,"_23429":142860,"_5":16198,"_30870":142716,"_3543":142861},[],"<Card title=\"Algoritmos\" description=\"Los identificadores y conjuntos de parámetros que hay detrás de estas constantes.\" href=\"/docs/platform/pqc/algorithms\" />",{"_4098":84810,"_34307":84742,"_23429":142863,"_5":16198,"_30870":142716,"_3543":142864},[],"<Card title=\"Proxy TLS con Traefik\" description=\"Cómo se usa el fork para terminar el TLS de los dispositivos.\" href=\"/docs/platform/pqc/tls-front-proxy\" />",{"_4098":84811,"_34307":84811,"_5":16596,"_3543":142866,"_34738":142867,"_23429":142869,"_30870":84811},"Pruebas de integración HTTPS",[56936,135600,141985,142868],"Pruebas de integración",[],{"_4098":84812,"_34307":84811,"_23429":142871,"_5":16198,"_30870":84811,"_3543":142872},[],"Resultados de probar un endpoint HTTPS de Lamassu con OpenSSL y curl usando intercambio de claves poscuántico y certificados poscuánticos y composite.",{"_4098":84813,"_34307":84811,"_5":34735,"_23429":142874,"_30870":142875,"_3543":142876},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/https#escenario","Escenario",{"_4098":84814,"_34307":84811,"_5":34735,"_23429":142878,"_30870":142879,"_3543":142880},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/https#resultados","Resultados",{"_4098":84815,"_34307":84811,"_5":34735,"_23429":142882,"_30870":142883,"_3543":142884},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/https#reproducir-un-caso","Reproducir un caso",{"_4098":84816,"_34307":84811,"_5":34735,"_23429":142886,"_30870":142887,"_3543":142888},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/https#conecta-ofreciendo-un-grupo-y-un-esquema-de-firma","Conecta ofreciendo un grupo y un esquema de firma",{"_4098":84817,"_34307":84811,"_5":34735,"_23429":142890,"_30870":142891,"_3543":142892},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/https#envía-una-petición","Envía una petición",{"_4098":84818,"_34307":84811,"_5":34735,"_23429":142894,"_30870":142895,"_3543":142896},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/https#comprueba-que-una-oferta-incorrecta-se-rechaza","Comprueba que una oferta incorrecta se rechaza",{"_4098":84819,"_34307":84811,"_23429":142898,"_5":16198,"_30870":84811,"_3543":142899},[],"Esta prueba conecta con un endpoint de la API de Lamassu por HTTPS desde un cliente OpenSSL y comprueba que el handshake poscuántico, la cadena de certificados y la petición de aplicación funcionan. El resumen explica los clientes, la matriz de pruebas y qué demuestra cada comprobación.",{"_4098":84820,"_34307":84811,"_23429":142901,"_5":16198,"_30870":142875,"_3543":142902},[],"El cliente solicita `GET /api/ca/health` a través del proxy Traefik, que la reenvía a Envoy Gateway y al servicio de CA. El certificado del servidor y la CA que lo firmó se crearon fuera de Lamassu y se cargaron en el proxy para cada caso. En cada caso el proxy se configuró con los grupos de intercambio de claves y el certificado de esa fila y columna de la matriz.",{"_4098":84821,"_34307":84811,"_23429":142904,"_5":16198,"_30870":142875,"_3543":142905},[],"Las CAs y los certificados son material de pruebas creado fuera de Lamassu, válido durante un periodo corto y con el nombre del servidor como nombre alternativo del sujeto. No los emite el servicio de CA de Lamassu.",{"_4098":84822,"_34307":84811,"_23429":142907,"_5":16198,"_30870":142879,"_3543":142908},[],"Las nueve combinaciones de intercambio de claves y certificado se superaron, igual que los tres certificados composite adicionales.",{"_4098":84823,"_34307":84811,"_23429":142910,"_5":16198,"_30870":142879,"_3543":142911},[],"Intercambio de claves ↓ / Certificado →",{"_4098":84824,"_34307":84811,"_23429":142913,"_5":16198,"_30870":142879,"_3543":65969},[],{"_4098":84825,"_34307":84811,"_23429":142915,"_5":16198,"_30870":142879,"_3543":65972},[],{"_4098":84826,"_34307":84811,"_23429":142917,"_5":16198,"_30870":142879,"_3543":65975},[],{"_4098":84827,"_34307":84811,"_23429":142919,"_5":16198,"_30870":142879,"_3543":65978},[],{"_4098":84828,"_34307":84811,"_23429":142921,"_5":16198,"_30870":142879,"_3543":65981},[],{"_4098":84829,"_34307":84811,"_23429":142923,"_5":16198,"_30870":142879,"_3543":65984},[],{"_4098":84830,"_34307":84811,"_23429":142925,"_5":16198,"_30870":142879,"_3543":65987},[],{"_4098":84831,"_34307":84811,"_23429":142927,"_5":16198,"_30870":142879,"_3543":65990},[],{"_4098":84832,"_34307":84811,"_23429":142929,"_5":16198,"_30870":142879,"_3543":65993},[],{"_4098":84833,"_34307":84811,"_23429":142931,"_5":16198,"_30870":142879,"_3543":65996},[],{"_4098":84834,"_34307":84811,"_23429":142933,"_5":16198,"_30870":142879,"_3543":65999},[],{"_4098":84835,"_34307":84811,"_23429":142935,"_5":16198,"_30870":142879,"_3543":66002},[],{"_4098":84836,"_34307":84811,"_23429":142937,"_5":16198,"_30870":142879,"_3543":66005},[],{"_4098":84837,"_34307":84811,"_23429":142939,"_5":16198,"_30870":142879,"_3543":66008},[],{"_4098":84838,"_34307":84811,"_23429":142941,"_5":16198,"_30870":142879,"_3543":66011},[],{"_4098":84839,"_34307":84811,"_23429":142943,"_5":16198,"_30870":142879,"_3543":142944},[],"Cada celda muestra el grupo negociado y el esquema de la firma del handshake. En todos los casos la cadena se verificó, la petición devolvió `200` y las dos comprobaciones negativas se rechazaron con `handshake_failure`.",{"_4098":84840,"_34307":84811,"_23429":142946,"_5":16198,"_30870":142879,"_3543":142947},[],"Composite adicional",{"_4098":84841,"_34307":84811,"_23429":142949,"_5":16198,"_30870":142879,"_3543":142950},[],"Esquema de firma",{"_4098":84842,"_34307":84811,"_23429":142952,"_5":16198,"_30870":142879,"_3543":139255},[],{"_4098":84843,"_34307":84811,"_23429":142954,"_5":16198,"_30870":142879,"_3543":66025},[],{"_4098":84844,"_34307":84811,"_23429":142956,"_5":16198,"_30870":142879,"_3543":66028},[],{"_4098":84845,"_34307":84811,"_23429":142958,"_5":16198,"_30870":142879,"_3543":142959},[],"✅ con `X25519MLKEM768`",{"_4098":84846,"_34307":84811,"_23429":142961,"_5":16198,"_30870":142879,"_3543":66034},[],{"_4098":84847,"_34307":84811,"_23429":142963,"_5":16198,"_30870":142879,"_3543":66037},[],{"_4098":84848,"_34307":84811,"_23429":142965,"_5":16198,"_30870":142879,"_3543":142959},[],{"_4098":84849,"_34307":84811,"_23429":142967,"_5":16198,"_30870":142879,"_3543":66042},[],{"_4098":84850,"_34307":84811,"_23429":142969,"_5":16198,"_30870":142879,"_3543":66045},[],{"_4098":84851,"_34307":84811,"_23429":142971,"_5":16198,"_30870":142879,"_3543":142959},[],{"_4098":84852,"_34307":84811,"_23429":142973,"_5":16198,"_30870":142879,"_3543":142974},[],"Con una única configuración de servidor que tiene a la vez los certificados ECDSA, ML-DSA-65 y composite y acepta las tres clases de intercambio de claves, un cliente que ofrecía un grupo y un esquema de firma negoció cada una de las nueve combinaciones. `curl` devolvió `200` cuando confiaba en las tres CAs.",{"_4098":84853,"_34307":84811,"_23429":142976,"_5":16198,"_30870":142879,"_3543":142977},[],"Un servidor con certificados de varias clases sirve el primero que coincide con la preferencia de firma del cliente. Un cliente OpenSSL 3.5 o posterior con la configuración por defecto prefiere ML-DSA, así que un cliente que solo confía en la CA ECDSA falla con `unable to get local issuer certificate`, aunque la conexión en sí haya funcionado. Da a los clientes las CAs de todas las clases que el servidor pueda presentar.",{"_4098":84854,"_34307":84811,"_23429":142979,"_5":16198,"_30870":142883,"_3543":142980},[],"Necesitas OpenSSL 3.5 o posterior. Para certificados composite, además el módulo `hybrid-provider` con puntos de código que coincidan con los del toolchain de Go PQC, cargado mediante `OPENSSL_CONF`. Usa el fichero de CA del caso como `ca.pem`.",{"_4098":84855,"_34307":84811,"_23429":142982,"_5":16198,"_30870":142887,"_3543":142983},[],"Este ejemplo prueba intercambio de claves PQ/T con el certificado composite e imprime los valores negociados:",{"_4098":84856,"_34307":84811,"_23429":142985,"_5":16198,"_30870":142887,"_3543":142986},[],"Salida esperada:",{"_4098":84857,"_34307":84811,"_23429":142988,"_5":16198,"_30870":142891,"_3543":142989},[],"Sustituye el `grep` por una petición HTTP para confirmar que la capa de aplicación funciona a través del proxy:",{"_4098":84858,"_34307":84811,"_23429":142991,"_5":16198,"_30870":142891,"_3543":142992},[],"La respuesta empieza por `HTTP/1.1 200 OK`. Con `curl` y un bundle que contenga las CAs de las clases que presenta el servidor, `curl --cacert ca-bundle.pem https://<LAMASSU_HOST>/api/ca/health` también devuelve `200`.",{"_4098":84859,"_34307":84811,"_23429":142994,"_5":16198,"_30870":142895,"_3543":142995},[],"Ofrece solo grupos clásicos a un servidor configurado para intercambio de claves PQ:",{"_4098":84860,"_34307":84811,"_23429":142997,"_5":16198,"_30870":142895,"_3543":142998},[],"El handshake falla con una alerta `handshake failure`. Ofrecer todos los esquemas de firma salvo el del certificado da el mismo resultado.",{"_4098":84861,"_34307":84811,"_23429":143000,"_5":16198,"_30870":142895,"_3543":143001},[],"<Card title=\"MQTTS\" description=\"Las mismas comprobaciones para un broker MQTT.\" href=\"/docs/platform/pqc/integration-tests/mqtts\" />",{"_4098":84862,"_34307":84811,"_23429":143003,"_5":16198,"_30870":142895,"_3543":143004},[],"<Card title=\"Proxy TLS con Traefik\" description=\"Cómo elige el proxy el certificado e impone el intercambio de claves.\" href=\"/docs/platform/pqc/tls-front-proxy\" />",{"_4098":84863,"_34307":84863,"_5":16596,"_3543":143006,"_34738":143007,"_23429":143008,"_30870":84863},"Pruebas de integración MQTTS",[56936,135600,141985,142868],[],{"_4098":84864,"_34307":84863,"_23429":143010,"_5":16198,"_30870":84863,"_3543":143011},[],"Resultados de probar un broker MQTT detrás del proxy TLS de Lamassu con mosquitto, usando intercambio de claves poscuántico y certificados poscuánticos y composite.",{"_4098":84865,"_34307":84863,"_5":34735,"_23429":143013,"_30870":143014,"_3543":142876},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/mqtts#escenario",{"_4098":84866,"_34307":84863,"_5":34735,"_23429":143016,"_30870":143017,"_3543":142880},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/mqtts#resultados",{"_4098":84867,"_34307":84863,"_5":34735,"_23429":143019,"_30870":143020,"_3543":142884},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/mqtts#reproducir-un-caso",{"_4098":84868,"_34307":84863,"_5":34735,"_23429":143022,"_30870":143023,"_3543":143024},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/mqtts#crea-la-configuración-de-openssl","Crea la configuración de OpenSSL",{"_4098":84869,"_34307":84863,"_5":34735,"_23429":143026,"_30870":143027,"_3543":143028},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/mqtts#suscríbete-y-publica","Suscríbete y publica",{"_4098":84870,"_34307":84863,"_5":34735,"_23429":143030,"_30870":143031,"_3543":142896},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/mqtts#comprueba-que-una-oferta-incorrecta-se-rechaza",{"_4098":84871,"_34307":84863,"_5":34735,"_23429":143033,"_30870":143034,"_3543":143035},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/mqtts#qué-debes-saber","Qué debes saber",{"_4098":84872,"_34307":84863,"_23429":143037,"_5":16198,"_30870":84863,"_3543":143038},[],"Esta prueba conecta `mosquitto_pub` y `mosquitto_sub` a un broker MQTT por TLS y comprueba que los mensajes lo atraviesan con intercambio de claves poscuántico y certificados de servidor poscuánticos o composite. El resumen explica los clientes, la matriz de pruebas y qué demuestra cada comprobación.",{"_4098":84873,"_34307":84863,"_23429":143040,"_5":16198,"_30870":143014,"_3543":143041},[],"El broker es EMQX 5.8.9. Escucha MQTT en claro dentro del clúster, y el proxy TLS de Lamassu (Proxy TLS con Traefik) termina el TLS por él en el puerto 8883 y reenvía el tráfico. El TLS es unidireccional: el endpoint del broker presenta su certificado y el cliente no presenta ninguno. El certificado del servidor y su CA se crearon fuera de Lamassu, y el proxy se configuró en cada caso con los grupos de intercambio de claves y el certificado de esa fila y columna de la matriz.",{"_4098":84874,"_34307":84863,"_23429":143043,"_5":16198,"_30870":143014,"_3543":143044},[],"Los clientes son `mosquitto_pub` y `mosquitto_sub` 2.1.2, con MQTT 3.1.1 sobre TLS 1.3 y enlazados con OpenSSL 4.1.0. Un caso se supera cuando el suscriptor recibe el mensaje que el publicador envió a través del broker, ambos clientes validan la cadena de certificados contra la CA del caso y el nombre del servidor, y las dos comprobaciones negativas se rechazan.",{"_4098":84875,"_34307":84863,"_23429":143046,"_5":16198,"_30870":143017,"_3543":143047},[],"Los doce casos se superaron. En cada uno, `mosquitto_sub` se suscribió a un tema, `mosquitto_pub` publicó un valor único y el suscriptor lo recibió. La prueba se ejecutó dos veces por caso: una con el cliente ofreciendo todos los grupos y esquemas de firma, y otra con el cliente ofreciendo solo el grupo y el esquema de firma esperados para el caso. La segunda ejecución demuestra que el endpoint del broker negoció exactamente ese grupo y ese esquema, porque el cliente no ofrecía nada más.",{"_4098":84876,"_34307":84863,"_23429":143049,"_5":16198,"_30870":143017,"_3543":142911},[],{"_4098":84877,"_34307":84863,"_23429":143051,"_5":16198,"_30870":143017,"_3543":65969},[],{"_4098":84878,"_34307":84863,"_23429":143053,"_5":16198,"_30870":143017,"_3543":65972},[],{"_4098":84879,"_34307":84863,"_23429":143055,"_5":16198,"_30870":143017,"_3543":65975},[],{"_4098":84880,"_34307":84863,"_23429":143057,"_5":16198,"_30870":143017,"_3543":65978},[],{"_4098":84881,"_34307":84863,"_23429":143059,"_5":16198,"_30870":143017,"_3543":65981},[],{"_4098":84882,"_34307":84863,"_23429":143061,"_5":16198,"_30870":143017,"_3543":65984},[],{"_4098":84883,"_34307":84863,"_23429":143063,"_5":16198,"_30870":143017,"_3543":65987},[],{"_4098":84884,"_34307":84863,"_23429":143065,"_5":16198,"_30870":143017,"_3543":65990},[],{"_4098":84885,"_34307":84863,"_23429":143067,"_5":16198,"_30870":143017,"_3543":65993},[],{"_4098":84886,"_34307":84863,"_23429":143069,"_5":16198,"_30870":143017,"_3543":65996},[],{"_4098":84887,"_34307":84863,"_23429":143071,"_5":16198,"_30870":143017,"_3543":65999},[],{"_4098":84888,"_34307":84863,"_23429":143073,"_5":16198,"_30870":143017,"_3543":66002},[],{"_4098":84889,"_34307":84863,"_23429":143075,"_5":16198,"_30870":143017,"_3543":66005},[],{"_4098":84890,"_34307":84863,"_23429":143077,"_5":16198,"_30870":143017,"_3543":66008},[],{"_4098":84891,"_34307":84863,"_23429":143079,"_5":16198,"_30870":143017,"_3543":66011},[],{"_4098":84892,"_34307":84863,"_23429":143081,"_5":16198,"_30870":143017,"_3543":143082},[],"Los certificados composite adicionales se comportan igual con intercambio de claves PQ/T.",{"_4098":84893,"_34307":84863,"_23429":143084,"_5":16198,"_30870":143017,"_3543":142947},[],{"_4098":84894,"_34307":84863,"_23429":143086,"_5":16198,"_30870":143017,"_3543":142950},[],{"_4098":84895,"_34307":84863,"_23429":143088,"_5":16198,"_30870":143017,"_3543":139255},[],{"_4098":84896,"_34307":84863,"_23429":143090,"_5":16198,"_30870":143017,"_3543":66025},[],{"_4098":84897,"_34307":84863,"_23429":143092,"_5":16198,"_30870":143017,"_3543":66028},[],{"_4098":84898,"_34307":84863,"_23429":143094,"_5":16198,"_30870":143017,"_3543":66170},[],{"_4098":84899,"_34307":84863,"_23429":143096,"_5":16198,"_30870":143017,"_3543":66034},[],{"_4098":84900,"_34307":84863,"_23429":143098,"_5":16198,"_30870":143017,"_3543":66037},[],{"_4098":84901,"_34307":84863,"_23429":143100,"_5":16198,"_30870":143017,"_3543":66170},[],{"_4098":84902,"_34307":84863,"_23429":143102,"_5":16198,"_30870":143017,"_3543":66042},[],{"_4098":84903,"_34307":84863,"_23429":143104,"_5":16198,"_30870":143017,"_3543":66045},[],{"_4098":84904,"_34307":84863,"_23429":143106,"_5":16198,"_30870":143017,"_3543":66170},[],{"_4098":84905,"_34307":84863,"_23429":143108,"_5":16198,"_30870":143017,"_3543":143109},[],"Cuando el cliente ofrecía todos los grupos salvo los de la clase del caso, o todos los esquemas de firma salvo el del certificado, el handshake TLS fallaba con una alerta `handshake failure` y el broker nunca enviaba un `CONNACK`. El resultado fue el mismo en los doce casos.",{"_4098":84906,"_34307":84863,"_23429":143111,"_5":16198,"_30870":143017,"_3543":143112},[],"Con una única configuración de servidor que tiene los certificados ECDSA, ML-DSA-65 y composite y acepta las tres clases de intercambio de claves, cada una de las nueve combinaciones conectó en el puerto 8883 cuando el cliente ofrecía un grupo y un esquema de firma. `mosquitto_pub` recibió `CONNACK (0)` en todas.",{"_4098":84907,"_34307":84863,"_23429":143114,"_5":16198,"_30870":143020,"_3543":143115},[],"mosquitto no tiene opciones para elegir grupos de intercambio de claves ni esquemas de firma, así que se fijan mediante un fichero de configuración de OpenSSL que `mosquitto_pub` y `mosquitto_sub` leen de la variable de entorno `OPENSSL_CONF`. Necesitas OpenSSL 3.5 o posterior; para certificados composite, además el módulo `hybrid-provider` con puntos de código que coincidan con los del toolchain de Go PQC.",{"_4098":84908,"_34307":84863,"_23429":143117,"_5":16198,"_30870":143023,"_3543":143118},[],"Este `pqc-client.cnf` hace que el cliente ofrezca solo `X25519MLKEM768` y el esquema de firma composite, y carga el provider composite:",{"_4098":84909,"_34307":84863,"_23429":143120,"_5":16198,"_30870":143023,"_3543":143121},[],"Elimina el provider `hybrid` y el módulo en un caso que use solo ML-DSA o ECDSA.",{"_4098":84910,"_34307":84863,"_23429":143123,"_5":16198,"_30870":143027,"_3543":143124},[],"Arranca el suscriptor en una terminal y el publicador en otra. Ambos validan el certificado del broker contra `ca.pem`, la CA del caso:",{"_4098":84911,"_34307":84863,"_23429":143126,"_5":16198,"_30870":143027,"_3543":143127},[],"El suscriptor imprime `hello over pqc` y termina. Añade `-d` para ver los paquetes `CONNECT`, `CONNACK (0)`, `SUBACK` y `PUBLISH`.",{"_4098":84912,"_34307":84863,"_23429":143129,"_5":16198,"_30870":143031,"_3543":143130},[],"Cambia `Groups` por una lista que no incluya el grupo que acepta el servidor, por ejemplo `Groups = X25519` frente a un servidor configurado para `MLKEM1024`, y repite la publicación. El cliente falla con `tls alert handshake failure` y no se recibe ningún `CONNACK`.",{"_4098":84913,"_34307":84863,"_23429":143132,"_5":16198,"_30870":143034,"_3543":143133},[],"**Nombre del host y certificado.** mosquitto usa el valor de `-h` como destino de la conexión, como nombre de servidor enviado en el handshake y como nombre que verifica. Los certificados de prueba llevan ese nombre como nombre alternativo del sujeto.",{"_4098":84914,"_34307":84863,"_23429":143135,"_5":16198,"_30870":143034,"_3543":143136},[],"**Un certificado por nombre.** El proxy TLS guarda sus certificados por nombre, no por puerto. Un endpoint MQTT que comparte nombre con el endpoint HTTPS sirve los mismos certificados, así que da al broker su propio nombre si necesita un certificado distinto.",{"_4098":84915,"_34307":84863,"_23429":143138,"_5":16198,"_30870":143034,"_3543":143139},[],"**No se probaron los valores por defecto sin fijar.** Todas las ejecuciones fijaron explícitamente la oferta de grupos y firmas, así que no se comprobó qué negocia mosquitto con la oferta por defecto de OpenSSL. Las pruebas HTTPS sí cubren un cliente OpenSSL por defecto: recibe el certificado ML-DSA si el servidor lo tiene.",{"_4098":84916,"_34307":84863,"_23429":143141,"_5":16198,"_30870":143034,"_3543":143142},[],"**Otros clientes en el mismo puerto.** Imponer TLS 1.3 o algoritmos poscuánticos en un puerto MQTT compartido afecta a todos los clientes que se conectan a él. Durante las pruebas el proxy registró intentos de conexión de otros clientes que solo admiten TLS 1.2 o anterior, o que no confiaban en el certificado. Identifícalos antes de dejar el ajuste de forma permanente.",{"_4098":84917,"_34307":84863,"_23429":143144,"_5":16198,"_30870":143034,"_3543":143145},[],"<Card title=\"HTTPS\" description=\"Las mismas comprobaciones para un endpoint HTTPS de Lamassu.\" href=\"/docs/platform/pqc/integration-tests/https\" />",{"_4098":84918,"_34307":84863,"_23429":143147,"_5":16198,"_30870":143034,"_3543":143148},[],"<Card title=\"Despliegue con el chart de Helm\" description=\"Despliega el proxy que termina el TLS.\" href=\"/docs/platform/pqc/deployment\" />",{"_4098":84919,"_34307":84919,"_5":16596,"_3543":143150,"_34738":143151,"_23429":143152,"_30870":84919},"Resumen de las pruebas de integración",[56936,135600,141985,142868],[],{"_4098":84920,"_34307":84919,"_23429":143154,"_5":16198,"_30870":84919,"_3543":143155},[],"Evidencia de que software ajeno a Lamassu negocia intercambio de claves poscuántico y verifica los certificados poscuánticos y composite que sirve Lamassu.",{"_4098":84921,"_34307":84919,"_5":34735,"_23429":143157,"_30870":143158,"_3543":143159},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/overview#qué-se-probó","Qué se probó",{"_4098":84922,"_34307":84919,"_5":34735,"_23429":143161,"_30870":143162,"_3543":143163},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/overview#la-matriz-de-pruebas","La matriz de pruebas",{"_4098":84923,"_34307":84919,"_5":34735,"_23429":143165,"_30870":143166,"_3543":143167},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/overview#qué-comprueba-cada-caso","Qué comprueba cada caso",{"_4098":84924,"_34307":84919,"_5":34735,"_23429":143169,"_30870":143170,"_3543":143171},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/overview#comportamiento-esperable","Comportamiento esperable",{"_4098":84925,"_34307":84919,"_23429":143173,"_5":16198,"_30870":84919,"_3543":143174},[],"Los certificados poscuánticos solo sirven si los sistemas que los consumen pueden usarlos. Estas pruebas de integración comprueban que clientes y brokers que no forman parte de Lamassu, construidos sobre otra biblioteca criptográfica, pueden conectarse a un endpoint TLS de Lamassu, negociar un intercambio de claves poscuántico y verificar certificados poscuánticos y composite. Se probaron dos protocolos: HTTPS y MQTTS.",{"_4098":84926,"_34307":84919,"_23429":143176,"_5":16198,"_30870":84919,"_3543":143177},[],"Los certificados y las CAs de las pruebas se generaron fuera de Lamassu, con herramientas estándar, para mostrar que el toolchain de Go PQC implementa los formatos X.509 y TLS de forma interoperable. Demuestran que los certificados creados externamente funcionan con el endpoint TLS de Lamassu y que software independiente los verifica. No prueban certificados emitidos por una CA de Lamassu.",{"_4098":84927,"_34307":84919,"_23429":143179,"_5":16198,"_30870":143158,"_3543":143180},[],"El servidor es el proxy Traefik que termina el TLS de los dispositivos en Lamassu (Proxy TLS con Traefik). Está compilado con el toolchain de Go PQC y se configuró en cada prueba con una clase de intercambio de claves y una clase de certificado.",{"_4098":84928,"_34307":84919,"_23429":143182,"_5":16198,"_30870":143158,"_3543":143183},[],"Los clientes son implementaciones independientes:",{"_4098":84929,"_34307":84919,"_23429":143185,"_5":16198,"_30870":143158,"_3543":143186},[],"**OpenSSL 4.0.3 y 4.1.0**, con el soporte nativo de ML-KEM y ML-DSA de OpenSSL 3.5 y posteriores.",{"_4098":84930,"_34307":84919,"_23429":143188,"_5":16198,"_30870":143158,"_3543":143189},[],"**El módulo `hybrid-provider` de OpenSSL**, para ML-DSA composite. La versión usada se escribió contra el borrador 19 de la especificación, que después se publicó como RFC 10073; los vectores de prueba de ambos son idénticos, pero el provider no se contrastó de otro modo con el texto final.",{"_4098":84931,"_34307":84919,"_23429":143191,"_5":16198,"_30870":143158,"_3543":143192},[],"**`curl`*&#x2A; para HTTPS y **`mosquitto_pub` y `mosquitto_sub` 2.1.2** para MQTTS, ambos enlazados con ese OpenSSL.",{"_4098":84932,"_34307":84919,"_23429":143194,"_5":16198,"_30870":143162,"_3543":143195},[],"Cada combinación de intercambio de claves y certificado se probó por separado, con las familias que Lamassu usa en el resto de la documentación (T, PQ y PQ/T, véase Algoritmos).",{"_4098":84933,"_34307":84919,"_23429":143197,"_5":16198,"_30870":143162,"_3543":143198},[],"Intercambio de claves",{"_4098":84934,"_34307":84919,"_23429":143200,"_5":16198,"_30870":143162,"_3543":143201},[],"Grupos que acepta el servidor",{"_4098":84935,"_34307":84919,"_23429":143203,"_5":16198,"_30870":143162,"_3543":65978},[],{"_4098":84936,"_34307":84919,"_23429":143205,"_5":16198,"_30870":143162,"_3543":65688},[],{"_4098":84937,"_34307":84919,"_23429":143207,"_5":16198,"_30870":143162,"_3543":65990},[],{"_4098":84938,"_34307":84919,"_23429":143209,"_5":16198,"_30870":143162,"_3543":65697},[],{"_4098":84939,"_34307":84919,"_23429":143211,"_5":16198,"_30870":143162,"_3543":66002},[],{"_4098":84940,"_34307":84919,"_23429":143213,"_5":16198,"_30870":143162,"_3543":65706},[],{"_4098":84941,"_34307":84919,"_23429":143215,"_5":16198,"_30870":143162,"_3543":138400},[],{"_4098":84942,"_34307":84919,"_23429":143217,"_5":16198,"_30870":143162,"_3543":143218},[],"Certificado del servidor",{"_4098":84943,"_34307":84919,"_23429":143220,"_5":16198,"_30870":143162,"_3543":65978},[],{"_4098":84944,"_34307":84919,"_23429":143222,"_5":16198,"_30870":143162,"_3543":66299},[],{"_4098":84945,"_34307":84919,"_23429":143224,"_5":16198,"_30870":143162,"_3543":65990},[],{"_4098":84946,"_34307":84919,"_23429":143226,"_5":16198,"_30870":143162,"_3543":65086},[],{"_4098":84947,"_34307":84919,"_23429":143228,"_5":16198,"_30870":143162,"_3543":66002},[],{"_4098":84948,"_34307":84919,"_23429":143230,"_5":16198,"_30870":143162,"_3543":66308},[],{"_4098":84949,"_34307":84919,"_23429":143232,"_5":16198,"_30870":143162,"_3543":143233},[],"Son nueve combinaciones. Se probaron además tres certificados composite con intercambio de claves PQ/T: `MLDSA44-ECDSA-P256-SHA256`, `MLDSA65-ECDSA-P256-SHA512` y `MLDSA65-Ed25519-SHA512`, hasta un total de doce casos. Cada certificado lo emitió una CA de pruebas con el mismo algoritmo que el certificado.",{"_4098":84950,"_34307":84919,"_23429":143235,"_5":16198,"_30870":143166,"_3543":143236},[],"Un caso se supera solo si se cumple todo lo siguiente:",{"_4098":84951,"_34307":84919,"_23429":143238,"_5":16198,"_30870":143166,"_3543":143239},[],"**Intercambio de claves.** El grupo negociado en el handshake es el esperado para el caso.",{"_4098":84952,"_34307":84919,"_23429":143241,"_5":16198,"_30870":143166,"_3543":143242},[],"**Firma.** El esquema de la firma del handshake del servidor es el esperado para el certificado.",{"_4098":84953,"_34307":84919,"_23429":143244,"_5":16198,"_30870":143166,"_3543":143245},[],"**Cadena.** El cliente verifica la cadena de certificados contra la CA del caso y el nombre del servidor, sin errores de verificación.",{"_4098":84954,"_34307":84919,"_23429":143247,"_5":16198,"_30870":143166,"_3543":143248},[],"**Tráfico de aplicación.** El protocolo funciona: una petición HTTP devuelve `200`, o un mensaje MQTT publicado en el broker llega a un suscriptor.",{"_4098":84955,"_34307":84919,"_23429":143250,"_5":16198,"_30870":143166,"_3543":143251},[],"**Se rechaza un intercambio de claves incorrecto.** Un cliente que ofrece todos los grupos salvo los de la clase del caso falla con la alerta TLS `handshake_failure`.",{"_4098":84956,"_34307":84919,"_23429":143253,"_5":16198,"_30870":143166,"_3543":143254},[],"**Se rechaza un esquema de certificado incorrecto.** Un cliente que ofrece todos los esquemas de firma salvo el del certificado falla con la misma alerta.",{"_4098":84957,"_34307":84919,"_23429":143256,"_5":16198,"_30870":143166,"_3543":143257},[],"Las dos últimas comprobaciones demuestran que el servidor impone su configuración, y no solo que acepta a un cliente compatible.",{"_4098":84958,"_34307":84919,"_23429":143259,"_5":16198,"_30870":143170,"_3543":143260},[],"**Hubo que alinear los puntos de código composite.** Los esquemas de firma TLS de los algoritmos composite usan puntos de código de uso privado. El `hybrid-provider` usa por defecto otros valores, así que para las pruebas se igualaron a los del toolchain de Go PQC. Un cliente que implemente TLS composite debe usar los mismos valores.",{"_4098":84959,"_34307":84919,"_23429":143262,"_5":16198,"_30870":143170,"_3543":143263},[],"**ML-DSA puro y ML-KEM no necesitan nada más.** Funcionan con OpenSSL 3.5 o posterior tal cual; solo los certificados composite necesitan el provider.",{"_4098":84960,"_34307":84919,"_23429":143265,"_5":16198,"_30870":143170,"_3543":143266},[],"**Algunos handshakes requieren un viaje de ida y vuelta adicional.** El cliente envía primero el key share de `X25519MLKEM768`. Cuando el servidor está configurado para una clase que no lo incluye (T y PQ), responde con un HelloRetryRequest y el handshake termina con el grupo que pide.",{"_4098":84961,"_34307":84919,"_23429":143268,"_5":16198,"_30870":143170,"_3543":143269},[],"**La preferencia de firma del cliente decide el certificado.** Cuando el servidor tiene certificados de varias clases para el mismo nombre, sirve el primero que coincide con la lista de esquemas de firma del cliente. Un cliente OpenSSL 3.5 o posterior con la configuración por defecto lista ML-DSA primero, de modo que recibe el certificado ML-DSA y debe confiar en esa CA.",{"_4098":84962,"_34307":84919,"_23429":143271,"_5":16198,"_30870":143170,"_3543":143272},[],"<Card title=\"HTTPS\" description=\"Un endpoint de la API de Lamassu probado con openssl y curl.\" href=\"/docs/platform/pqc/integration-tests/https\" />",{"_4098":84963,"_34307":84919,"_23429":143274,"_5":16198,"_30870":143170,"_3543":143275},[],"<Card title=\"MQTTS\" description=\"Un broker MQTT detrás del proxy TLS, probado con mosquitto.\" href=\"/docs/platform/pqc/integration-tests/mqtts\" />",{"_4098":84964,"_34307":84919,"_23429":143277,"_5":16198,"_30870":143170,"_3543":143278},[],"<Card title=\"Limitaciones conocidas\" description=\"Qué no cubren estas pruebas ni la plataforma.\" href=\"/docs/platform/pqc/limitations\" />",{"_4098":84965,"_34307":84965,"_5":16596,"_3543":143280,"_34738":143281,"_23429":143282,"_30870":84965},"Claves y autoridades de certificación",[56936,135600,141985,142352],[],{"_4098":84966,"_34307":84965,"_23429":143284,"_5":16198,"_30870":84965,"_3543":143285},[],"Crear claves y CA poscuánticas, firmar con ellas y emitir certificados, con el soporte de motores, los valores de la API y las restricciones aplicables.",{"_4098":84967,"_34307":84965,"_5":34735,"_23429":143287,"_30870":143288,"_3543":143289},[],"/docs/pr-preview/pr-58/es/platform/pqc/keys-and-cas#elegir-un-motor-criptográfico-compatible","Elegir un motor criptográfico compatible",{"_4098":84968,"_34307":84965,"_5":34735,"_23429":143291,"_30870":143292,"_3543":143293},[],"/docs/pr-preview/pr-58/es/platform/pqc/keys-and-cas#crear-una-clave","Crear una clave",{"_4098":84969,"_34307":84965,"_5":34735,"_23429":143295,"_30870":143296,"_3543":143297},[],"/docs/pr-preview/pr-58/es/platform/pqc/keys-and-cas#crear-una-autoridad-de-certificación","Crear una autoridad de certificación",{"_4098":84970,"_34307":84965,"_5":34735,"_23429":143299,"_30870":143300,"_3543":143301},[],"/docs/pr-preview/pr-58/es/platform/pqc/keys-and-cas#combinar-algoritmos-en-una-jerarquía","Combinar algoritmos en una jerarquía",{"_4098":84971,"_34307":84965,"_5":34735,"_23429":143303,"_30870":143304,"_3543":143305},[],"/docs/pr-preview/pr-58/es/platform/pqc/keys-and-cas#firmar-y-verificar-con-una-clave","Firmar y verificar con una clave",{"_4098":84972,"_34307":84965,"_5":34735,"_23429":143307,"_30870":143308,"_3543":143309},[],"/docs/pr-preview/pr-58/es/platform/pqc/keys-and-cas#restricciones-a-tener-en-cuenta","Restricciones a tener en cuenta",{"_4098":84973,"_34307":84965,"_23429":143311,"_5":16198,"_30870":84965,"_3543":143312},[],"El backend de Lamassu trata las claves poscuánticas como un tipo más de clave del servicio de gestión de claves (KMS). Una autoridad de certificación creada con una clave así firma certificados y listas de revocación por las mismas rutas que una CA RSA o ECDSA, porque la firma la realiza el fork de Go. Esta página explica qué enviar a la API, qué motores criptográficos pueden custodiar las claves y dónde difiere el comportamiento respecto a las claves clásicas. El backend debe compilarse con el toolchain de Go PQC.",{"_4098":84974,"_34307":84965,"_23429":143314,"_5":16198,"_30870":143288,"_3543":143315},[],"No todos los motores criptográficos pueden crear o custodiar claves poscuánticas. Solo pueden los motores que ejecutan la criptografía dentro del proceso de Lamassu.",{"_4098":84975,"_34307":84965,"_23429":143317,"_5":16198,"_30870":143288,"_3543":143318},[],"Motor",{"_4098":84976,"_34307":84965,"_23429":143320,"_5":16198,"_30870":143288,"_3543":66399},[],{"_4098":84977,"_34307":84965,"_23429":143322,"_5":16198,"_30870":143288,"_3543":66402},[],{"_4098":84978,"_34307":84965,"_23429":143324,"_5":16198,"_30870":143288,"_3543":143325},[],"Soportado",{"_4098":84979,"_34307":84965,"_23429":143327,"_5":16198,"_30870":143288,"_3543":66408},[],{"_4098":84980,"_34307":84965,"_23429":143329,"_5":16198,"_30870":143288,"_3543":143325},[],{"_4098":84981,"_34307":84965,"_23429":143331,"_5":16198,"_30870":143288,"_3543":66413},[],{"_4098":84982,"_34307":84965,"_23429":143333,"_5":16198,"_30870":143288,"_3543":143334},[],"No soportado",{"_4098":84983,"_34307":84965,"_23429":143336,"_5":16198,"_30870":143288,"_3543":63856},[],{"_4098":84984,"_34307":84965,"_23429":143338,"_5":16198,"_30870":143288,"_3543":143334},[],{"_4098":84985,"_34307":84965,"_23429":143340,"_5":16198,"_30870":143288,"_3543":63860},[],{"_4098":84986,"_34307":84965,"_23429":143342,"_5":16198,"_30870":143288,"_3543":143334},[],{"_4098":84987,"_34307":84965,"_23429":143344,"_5":16198,"_30870":143288,"_3543":143345},[],"Azure Key Vault y Azure Secrets",{"_4098":84988,"_34307":84965,"_23429":143347,"_5":16198,"_30870":143288,"_3543":143334},[],{"_4098":84989,"_34307":84965,"_23429":143349,"_5":16198,"_30870":143288,"_3543":66432},[],{"_4098":84990,"_34307":84965,"_23429":143351,"_5":16198,"_30870":143288,"_3543":143334},[],{"_4098":84991,"_34307":84965,"_23429":143353,"_5":16198,"_30870":143288,"_3543":143354},[],"En la práctica, las claves poscuánticas requieren por ahora el motor filesystem, que tiene nivel de seguridad 1. No hay claves con un nivel de garantía superior, en un módulo de seguridad hardware o en un KMS en la nube, para estos algoritmos.",{"_4098":84992,"_34307":84965,"_23429":143356,"_5":16198,"_30870":143288,"_3543":143357},[],"Los motores Vault KV2 y AWS Secrets Manager incluyen los tipos de clave poscuánticos entre los que dicen soportar, por lo que una petición supera la comprobación de compatibilidad. La creación falla después con un error `unsupported key type` del motor. Debe seleccionarse explícitamente un motor filesystem o software con `engine_id`.",{"_4098":84993,"_34307":84965,"_23429":143359,"_5":16198,"_30870":143292,"_3543":143360},[],"Una clave del KMS se crea con el algoritmo y el tamaño descritos en Algoritmos:",{"_4098":84994,"_34307":84965,"_23429":143362,"_5":16198,"_30870":143292,"_3543":143363},[],"Los parámetros inválidos se rechazan con un mensaje explícito: un tamaño de ML-DSA distinto de 44, 65 o 87, un identificador de SLH-DSA fuera del rango 1 a 12, una variante composite fuera del rango 1 a 15, o una variante composite que no pertenece a la familia solicitada. La importación de una clave privada en formato PKCS#8 detecta automáticamente el algoritmo y el conjunto de parámetros; admite claves ML-DSA, SLH-DSA, composite y Ed25519.",{"_4098":84995,"_34307":84965,"_23429":143365,"_5":16198,"_30870":143296,"_3543":143366},[],"Una CA con clave poscuántica usa la misma petición que cualquier otra CA, enviada a `POST /api/ca/v1/cas`. Solo cambia `key_metadata`, donde `bits` transporta el conjunto de parámetros. Una CA raíz con ML-DSA-65:",{"_4098":84996,"_34307":84965,"_23429":143368,"_5":16198,"_30870":143296,"_3543":143369},[],"Una CA raíz con clave composite de ML-DSA-44 y ECDSA P-256 usa `\"key_metadata\": { \"type\": \"Composite-ML-DSA-ECDSA\", \"bits\": 9 }`. Ed25519 usa `\"type\": \"Ed25519\", \"bits\": 256` y SLH-DSA usa `\"type\": \"SLH-DSA\", \"bits\": 1` para seleccionar SLH-DSA-SHA2-128s. Las CA subordinadas se crean del mismo modo: la subordinada firma su propia solicitud de certificado con la clave del KMS y la CA padre emite el certificado.",{"_4098":84997,"_34307":84965,"_23429":143371,"_5":16198,"_30870":143296,"_3543":143372},[],"Es posible importar CA existentes con una clave privada poscuántica en el caso de ML-DSA y Ed25519. La importación de una CA con clave SLH-DSA o composite no está soportada.",{"_4098":84998,"_34307":84965,"_23429":143374,"_5":16198,"_30870":143300,"_3543":143375},[],"El backend no impone restricciones sobre qué algoritmo emite a cuál. Una CA con clave ML-DSA puede emitir certificados a sujetos RSA, ECDSA, Ed25519 y ML-DSA, y una CA RSA o ECDSA puede emitir certificados a sujetos poscuánticos. La batería de pruebas cubre a través de la API la matriz completa de ML-DSA y Ed25519, y cubre CA y hojas SLH-DSA y composite a nivel del motor de certificados. Esto permite introducir una CA poscuántica bajo una raíz clásica, o a la inversa, pero la parte que confía debe poder verificar todos los algoritmos de la cadena. En TLS, las firmas de la cadena de certificados se comprueban frente a la extensión `signature_algorithms_cert` del cliente, por lo que una cadena firmada con ML-DSA o con un algoritmo composite necesita un cliente que lo anuncie ahí.",{"_4098":84999,"_34307":84965,"_23429":143377,"_5":16198,"_30870":143304,"_3543":143378},[],"El endpoint de firma del KMS acepta nuevos valores de `signature_algorithm`. El campo `message_type` se ignora en todos ellos. Los valores de ML-DSA, SLH-DSA y Ed25519 son «pure»: el mensaje se firma directamente, sin prehash (no son HashML-DSA, HashSLH-DSA ni Ed25519ph). Los valores composite calculan el hash del mensaje con el hash de la variante y firman un mensaje representativo que incluye una etiqueta fija y el contexto opcional.",{"_4098":85000,"_34307":84965,"_23429":143380,"_5":16198,"_30870":143304,"_3543":141918},[],{"_4098":85001,"_34307":84965,"_23429":143382,"_5":16198,"_30870":143304,"_3543":66466},[],{"_4098":85002,"_34307":84965,"_23429":143384,"_5":16198,"_30870":143304,"_3543":66469},[],{"_4098":85003,"_34307":84965,"_23429":143386,"_5":16198,"_30870":143304,"_3543":66472},[],{"_4098":85004,"_34307":84965,"_23429":143388,"_5":16198,"_30870":143304,"_3543":64965},[],{"_4098":85005,"_34307":84965,"_23429":143390,"_5":16198,"_30870":143304,"_3543":66477},[],{"_4098":85006,"_34307":84965,"_23429":143392,"_5":16198,"_30870":143304,"_3543":66480},[],{"_4098":85007,"_34307":84965,"_23429":143394,"_5":16198,"_30870":143304,"_3543":66483},[],{"_4098":85008,"_34307":84965,"_23429":143396,"_5":16198,"_30870":143304,"_3543":64973},[],{"_4098":85009,"_34307":84965,"_23429":143398,"_5":16198,"_30870":143304,"_3543":66488},[],{"_4098":85010,"_34307":84965,"_23429":143400,"_5":16198,"_30870":143304,"_3543":143401},[],"El backend no comprueba que el algoritmo coincida con la clave; debe elegirse el valor que corresponde al tipo de clave. Cuando una CA firma un certificado o una lista de revocación, el algoritmo se selecciona automáticamente.",{"_4098":85011,"_34307":84965,"_23429":143403,"_5":16198,"_30870":143308,"_3543":143404},[],"Varias partes de la plataforma aún no gestionan claves poscuánticas. Se reúnen en Limitaciones conocidas; las que afectan a la operación diaria son las siguientes.",{"_4098":85012,"_34307":84965,"_23429":143406,"_5":16198,"_30870":143308,"_3543":143407},[],"Los perfiles de emisión aplican restricciones de clave solo a RSA y ECDSA, mediante `allow_rsa_keys` y `allow_ecdsa_keys`. Un perfil con la aplicación de restricciones activada no bloquea las claves poscuánticas, y no dispone de un interruptor para permitirlas o denegarlas.",{"_4098":85013,"_34307":84965,"_23429":143409,"_5":16198,"_30870":143308,"_3543":143410},[],"La fortaleza de clave registrada para un certificado cuya clave es poscuántica o Ed25519 solo se calcula para RSA y ECDSA, por lo que esos certificados se almacenan con tipo y tamaño de clave desconocidos y fortaleza baja.",{"_4098":85014,"_34307":84965,"_23429":143412,"_5":16198,"_30870":143308,"_3543":143413},[],"Las respuestas OCSP se firman con la biblioteca `golang.org/x/crypto/ocsp`, que solo admite claves de firma RSA y ECDSA. No cabe esperar, por tanto, que una CA con clave poscuántica, Ed25519 o composite pueda firmar respuestas OCSP; las CRL se generan con el fork y no se ven afectadas por este límite, aunque no tienen pruebas.",{"_4098":85015,"_34307":84965,"_23429":143415,"_5":16198,"_30870":143308,"_3543":143416},[],"La generación de claves en el servidor del DMS (la operación `serverkeygen` de EST) genera únicamente claves RSA y ECDSA.",{"_4098":85016,"_34307":84965,"_23429":143418,"_5":16198,"_30870":143308,"_3543":143419},[],"<Card title=\"Certificados relacionados\" description=\"Vincular un certificado poscuántico a uno clásico existente.\" href=\"/docs/platform/pqc/related-certificates\" />",{"_4098":85017,"_34307":84965,"_23429":143421,"_5":16198,"_30870":143308,"_3543":143422},[],"<Card title=\"Dashboard\" description=\"Crear los mismos objetos desde la interfaz web.\" href=\"/docs/platform/pqc/dashboard\" />",{"_4098":85018,"_34307":85018,"_5":16596,"_3543":143424,"_34738":143425,"_23429":143427,"_30870":85018},"Limitaciones conocidas",[56936,135600,141985,143426],"Referencia",[],{"_4098":85019,"_34307":85018,"_23429":143429,"_5":16198,"_30870":85018,"_3543":143430},[],"Qué está incompleto, es no estándar o no está verificado en el soporte poscuántico de Lamassu, agrupado por componente.",{"_4098":85020,"_34307":85018,"_5":34735,"_23429":143432,"_30870":143433,"_3543":143434},[],"/docs/pr-preview/pr-58/es/platform/pqc/limitations#estándares-e-interoperabilidad","Estándares e interoperabilidad",{"_4098":85021,"_34307":85018,"_5":34735,"_23429":143436,"_30870":143437,"_3543":143438},[],"/docs/pr-preview/pr-58/es/platform/pqc/limitations#claves-y-motores","Claves y motores",{"_4098":85022,"_34307":85018,"_5":34735,"_23429":143440,"_30870":143441,"_3543":143442},[],"/docs/pr-preview/pr-58/es/platform/pqc/limitations#autoridad-de-certificación-y-validación","Autoridad de certificación y validación",{"_4098":85023,"_34307":85018,"_5":34735,"_23429":143444,"_30870":143445,"_3543":65361},[],"/docs/pr-preview/pr-58/es/platform/pqc/limitations#dashboard",{"_4098":85024,"_34307":85018,"_5":34735,"_23429":143447,"_30870":143448,"_3543":143449},[],"/docs/pr-preview/pr-58/es/platform/pqc/limitations#compilación-y-despliegue","Compilación y despliegue",{"_4098":85025,"_34307":85018,"_23429":143451,"_5":16198,"_30870":85018,"_3543":143452},[],"Esta página reúne los límites de la implementación actual para valorarlos antes de planificar un despliegue. Cada uno se ha observado en el código o en las pruebas de las ramas descritas en esta sección.",{"_4098":85026,"_34307":85018,"_23429":143454,"_5":16198,"_30870":143433,"_3543":143455},[],"Los certificados composite siguen el RFC 10073. La implementación se escribió contra el borrador 19 y supera los vectores de prueba del RFC, pero no ha pasado una evaluación completa de conformidad. Tres de sus algoritmos (las dos variantes Brainpool y Ed448) no están implementados. Los esquemas de firma composite en TLS usan puntos de código de uso privado de `0xFE00` a `0xFE0E` porque IANA no ha asignado ninguno, por lo que solo interoperan con pares construidos con el mismo fork de Go. Las variantes composite con RSA PKCS#1 v1.5 no pueden autenticar un handshake TLS. SLH-DSA no tiene esquema de firma TLS. El atributo de solicitud de certificado relacionado no se ha contrastado con otras implementaciones del RFC 9763.",{"_4098":85027,"_34307":85018,"_23429":143457,"_5":16198,"_30870":143437,"_3543":143458},[],"Las claves poscuánticas, composite y Ed25519 funcionan solo con los motores filesystem y software. Los motores Vault KV2 y AWS Secrets Manager anuncian soporte y después fallan en la creación, y AWS KMS, Azure y PKCS#11 no las soportan. No existe, por tanto, ninguna clave poscuántica respaldada por hardware o por un KMS en la nube. Algunos mensajes de error de los motores están copiados de otros motores y nombran el motor equivocado.",{"_4098":85028,"_34307":85018,"_23429":143460,"_5":16198,"_30870":143437,"_3543":143461},[],"La interfaz `CryptoEngine` ha incorporado métodos para crear e importar cada nuevo tipo de clave. Los motores desarrollados fuera del repositorio de Lamassu deben implementarlos.",{"_4098":85029,"_34307":85018,"_23429":143463,"_5":16198,"_30870":143441,"_3543":143464},[],"Una CA con clave poscuántica, Ed25519 o composite no puede firmar respuestas OCSP, porque la biblioteca de firma solo admite RSA y ECDSA. Se espera que la generación de CRL funcione, ya que usa la firma del fork, pero ni CRL ni OCSP tienen pruebas con estas claves.",{"_4098":85030,"_34307":85018,"_23429":143466,"_5":16198,"_30870":143441,"_3543":143467},[],"Los perfiles de emisión no pueden permitir ni denegar algoritmos poscuánticos; su aplicación de restricciones afecta solo a RSA y ECDSA. La fortaleza de clave de un certificado emitido solo se calcula para RSA y ECDSA, por lo que los demás certificados se almacenan con tipo y tamaño desconocidos y fortaleza baja. No está soportada la importación de una CA existente con clave SLH-DSA o composite.",{"_4098":85031,"_34307":85018,"_23429":143469,"_5":16198,"_30870":143441,"_3543":143470},[],"El DMS solo puede generar claves en el servidor para RSA y ECDSA, de modo que `serverkeygen` no puede devolver una clave poscuántica. Los flujos de enrolamiento por EST y por el device manager no tienen pruebas con claves poscuánticas.",{"_4098":85032,"_34307":85018,"_23429":143472,"_5":16198,"_30870":143441,"_3543":143473},[],"El backend no evalúa la extensión de certificado relacionado. Solo la emite.",{"_4098":85033,"_34307":85018,"_23429":143475,"_5":16198,"_30870":143445,"_3543":143476},[],"El generador de claves SLH-DSA del navegador asigna los identificadores de conjunto de parámetros de forma distinta al resto de la interfaz, según se describe en Dashboard. Los nombres de los tipos de clave no son uniformes entre pantallas, y la interfaz no incluye aviso de carácter experimental ni traducción.",{"_4098":85034,"_34307":85018,"_23429":143478,"_5":16198,"_30870":143448,"_3543":143479},[],"Todo depende de forks de Go y de Traefik que no son los proyectos originales, y la imagen del proxy tiene una etiqueta mutable. La especificación OpenAPI del KMS del backend sigue listando solo RSA, ECDSA y Ed25519 y no refleja los nuevos tipos de clave.",{"_4098":85035,"_34307":85018,"_23429":143481,"_5":16198,"_30870":143448,"_3543":143482},[],"El Helm chart usa nombres de recurso fijos, admite una sola release por espacio de nombres y envía el tráfico de Traefik a Envoy sin verificar certificados. Los certificados poscuánticos que crea el instalador son válidos durante 365 días y no se renuevan. El instalador necesita un host Linux y ejecuta una instalación de Helm, no una actualización.",{"_4098":85036,"_34307":85018,"_23429":143484,"_5":16198,"_30870":143448,"_3543":143485},[],"<Card title=\"Visión general de la criptografía poscuántica\" description=\"Volver al resumen de la sección.\" href=\"/docs/platform/pqc/overview\" />",{"_4098":85037,"_34307":85037,"_5":16596,"_3543":143487,"_34738":143488,"_23429":143489,"_30870":85037},"Visión general de la criptografía poscuántica",[56936,135600,141985],[],{"_4098":85038,"_34307":85037,"_23429":143491,"_5":16198,"_30870":85037,"_3543":143492},[],"Qué soporte poscuántico (PQC) añade Lamassu a las claves, las autoridades de certificación, el TLS de los dispositivos y el despliegue, y cómo encajan sus piezas.",{"_4098":85039,"_34307":85037,"_5":34735,"_23429":143494,"_30870":143495,"_3543":143496},[],"/docs/pr-preview/pr-58/es/platform/pqc/overview#por-qué-importa-en-flotas-de-dispositivos","Por qué importa en flotas de dispositivos",{"_4098":85040,"_34307":85037,"_5":34735,"_23429":143498,"_30870":143499,"_3543":143500},[],"/docs/pr-preview/pr-58/es/platform/pqc/overview#tres-familias-de-algoritmos","Tres familias de algoritmos",{"_4098":85041,"_34307":85037,"_5":34735,"_23429":143502,"_30870":143503,"_3543":143504},[],"/docs/pr-preview/pr-58/es/platform/pqc/overview#cómo-encajan-las-piezas","Cómo encajan las piezas",{"_4098":85042,"_34307":85037,"_5":34735,"_23429":143506,"_30870":143507,"_3543":143508},[],"/docs/pr-preview/pr-58/es/platform/pqc/overview#por-dónde-continuar","Por dónde continuar",{"_4098":85043,"_34307":85037,"_23429":143510,"_5":16198,"_30870":85037,"_3543":143511},[],"Lamassu puede crear claves, autoridades de certificación (CA) y certificados que usan algoritmos de firma poscuánticos, y puede servirlos y verificarlos por TLS. El trabajo abarca cinco bases de código que dependen unas de otras: un fork del toolchain de Go que implementa los algoritmos, el backend de Lamassu, el dashboard web, un fork del proxy Traefik que termina el TLS de los dispositivos y el Helm chart que despliega todo junto.",{"_4098":85044,"_34307":85037,"_23429":143513,"_5":16198,"_30870":85037,"_3543":143514},[],"El soporte PQC reside en ramas de desarrollo y en forks de Go y Traefik, no en los proyectos originales ni en las imágenes estándar de Lamassu. Los esquemas de firma TLS composite usan puntos de código de uso privado que ninguna otra pila TLS reconoce, y el formato de certificado composite sigue el RFC 10073, un estándar reciente con poca experiencia de despliegue todavía. Conviene planificar pilotos y despliegues de laboratorio, no flotas en producción. Limitaciones conocidas recoge lo que está incompleto.",{"_4098":85045,"_34307":85037,"_23429":143516,"_5":16198,"_30870":143495,"_3543":143517},[],"Los certificados emitidos a dispositivos suelen durar años, y los dispositivos que los almacenan son difíciles de sustituir. Un algoritmo de firma que un futuro ordenador cuántico llegase a romper obligaría a re-enrolar toda la flota. Emitir hoy certificados firmados con un algoritmo poscuántico o composite, y ofrecer un endpoint TLS que los acepte, permite validar la flota frente a ese riesgo antes de que sea urgente. Las firmas no están expuestas a ataques de tipo «almacenar ahora, descifrar después» como lo está un intercambio de claves, por lo que la urgencia depende de la vida útil de los certificados y de los dispositivos, no del tráfico registrado.",{"_4098":85046,"_34307":85037,"_23429":143519,"_5":16198,"_30870":143499,"_3543":143520},[],"Lamassu agrupa los algoritmos de firma en tres familias, con las mismas etiquetas que muestra el dashboard.",{"_4098":85047,"_34307":85037,"_23429":143522,"_5":16198,"_30870":143499,"_3543":143523},[],"Etiqueta",{"_4098":85048,"_34307":85037,"_23429":143525,"_5":16198,"_30870":143499,"_3543":142196},[],{"_4098":85049,"_34307":85037,"_23429":143527,"_5":16198,"_30870":143499,"_3543":141983},[],{"_4098":85050,"_34307":85037,"_23429":143529,"_5":16198,"_30870":143499,"_3543":65978},[],{"_4098":85051,"_34307":85037,"_23429":143531,"_5":16198,"_30870":143499,"_3543":143532},[],"Tradicional",{"_4098":85052,"_34307":85037,"_23429":143534,"_5":16198,"_30870":143499,"_3543":66625},[],{"_4098":85053,"_34307":85037,"_23429":143536,"_5":16198,"_30870":143499,"_3543":65990},[],{"_4098":85054,"_34307":85037,"_23429":143538,"_5":16198,"_30870":143499,"_3543":143539},[],"Poscuántica pura",{"_4098":85055,"_34307":85037,"_23429":143541,"_5":16198,"_30870":143499,"_3543":66633},[],{"_4098":85056,"_34307":85037,"_23429":143543,"_5":16198,"_30870":143499,"_3543":66002},[],{"_4098":85057,"_34307":85037,"_23429":143545,"_5":16198,"_30870":143499,"_3543":143546},[],"Híbrida (composite)",{"_4098":85058,"_34307":85037,"_23429":143548,"_5":16198,"_30870":143499,"_3543":143549},[],"ML-DSA combinado con RSA, ECDSA o Ed25519 en una única clave y una única firma",{"_4098":85059,"_34307":85037,"_23429":143551,"_5":16198,"_30870":143499,"_3543":143552},[],"Una firma composite solo es válida si se verifican sus dos componentes. Está pensada para que no sea falsificable mientras al menos uno de los dos algoritmos siga sin romperse, siempre que la parte que confía exija el composite y no recurra a un certificado clásico. En el intercambio de claves, `PQ/T` significa un grupo híbrido que combina un intercambio clásico y uno ML-KEM, y `PQ` significa ML-KEM puro. Algoritmos describe cada uno y los conjuntos de parámetros que Lamassu acepta.",{"_4098":85060,"_34307":85037,"_23429":143554,"_5":16198,"_30870":143503,"_3543":143555},[],"El fork de Go es la base: el backend y Traefik se compilan con él, porque el toolchain estándar de Go no incluye el soporte de certificados composite y SLH-DSA. El backend crea y custodia las claves, emite certificados y firma los datos de revocación. El dashboard usa la misma API REST. Los dispositivos llegan a la plataforma a través de Traefik, que negocia con ellos la autenticación y el intercambio de claves poscuánticos y después reenvía la petición a Envoy Gateway mediante TLS ordinario. La protección poscuántica se aplica, por tanto, solo al salto entre el dispositivo y Traefik.",{"_4098":85061,"_34307":85037,"_23429":143557,"_5":16198,"_30870":143507,"_3543":143558},[],"Conviene leer primero Algoritmos para conocer qué se soporta y cómo se escriben los conjuntos de parámetros en las peticiones a la API. Quien desarrolle un cliente de dispositivo debe seguir con Toolchain de Go PQC. Para crear una CA poscuántica, el camino es Claves y autoridades de certificación, y quien despliegue la plataforma consultará Despliegue con el Helm chart.",{"_4098":85062,"_34307":85037,"_23429":143560,"_5":16198,"_30870":143507,"_3543":143561},[],"<Card title=\"Algoritmos\" description=\"ML-DSA, SLH-DSA y los 15 algoritmos composite, con sus conjuntos de parámetros.\" href=\"/docs/platform/pqc/algorithms\" />",{"_4098":85063,"_34307":85037,"_23429":143563,"_5":16198,"_30870":143507,"_3543":143564},[],"<Card title=\"Claves y autoridades de certificación\" description=\"Crear claves y CA poscuánticas y emitir certificados mediante la API.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_4098":85064,"_34307":85037,"_23429":143566,"_5":16198,"_30870":143507,"_3543":143567},[],"<Card title=\"Despliegue con el Helm chart\" description=\"Instalar la plataforma con un proxy Traefik que sirve certificados PQC.\" href=\"/docs/platform/pqc/deployment\" />",{"_4098":85065,"_34307":85065,"_5":16596,"_3543":142372,"_34738":143569,"_23429":143570,"_30870":85065},[56936,135600,141985,142352],[],{"_4098":85066,"_34307":85065,"_23429":143572,"_5":16198,"_30870":85065,"_3543":143573},[],"Vincular un certificado con clave poscuántica a un certificado clásico existente del mismo dispositivo, según el RFC 9763, y cómo los emite y comprueba Lamassu.",{"_4098":85067,"_34307":85065,"_5":34735,"_23429":143575,"_30870":143576,"_3543":143577},[],"/docs/pr-preview/pr-58/es/platform/pqc/related-certificates#cómo-funciona-la-solicitud","Cómo funciona la solicitud",{"_4098":85068,"_34307":85065,"_5":34735,"_23429":143579,"_30870":143580,"_3543":143581},[],"/docs/pr-preview/pr-58/es/platform/pqc/related-certificates#ubicaciones-desde-las-que-la-ca-puede-descargar","Ubicaciones desde las que la CA puede descargar",{"_4098":85069,"_34307":85065,"_5":34735,"_23429":143583,"_30870":143584,"_3543":143585},[],"/docs/pr-preview/pr-58/es/platform/pqc/related-certificates#configurar-un-perfil-de-emisión","Configurar un perfil de emisión",{"_4098":85070,"_34307":85065,"_5":34735,"_23429":143587,"_30870":143588,"_3543":143589},[],"/docs/pr-preview/pr-58/es/platform/pqc/related-certificates#qué-debe-cumplir-el-certificado-emitido","Qué debe cumplir el certificado emitido",{"_4098":85071,"_34307":85065,"_5":34735,"_23429":143591,"_30870":143592,"_3543":143593},[],"/docs/pr-preview/pr-58/es/platform/pqc/related-certificates#desde-el-dashboard","Desde el dashboard",{"_4098":85072,"_34307":85065,"_23429":143595,"_5":16198,"_30870":85065,"_3543":143596},[],"Una flota que migra a algoritmos poscuánticos suele mantener durante un tiempo dos certificados por dispositivo: el clásico que ya se usa y uno nuevo con clave poscuántica. El RFC 9763 define una forma de enlazarlos. El certificado nuevo lleva la extensión `id-pe-relatedCert` (`1.3.6.1.5.5.7.1.36`), que contiene un hash del certificado clásico, de modo que una parte que confía puede comprobar que ambos identifican a la misma entidad. Lamassu implementa el lado emisor de este mecanismo.",{"_4098":85073,"_34307":85065,"_23429":143598,"_5":16198,"_30870":85065,"_3543":143599},[],"Esta opción encaja cuando:",{"_4098":85074,"_34307":85065,"_23429":143601,"_5":16198,"_30870":85065,"_3543":143602},[],"los consumidores aún no pueden validar cadenas poscuánticas o composite, por lo que el certificado clásico debe seguir siendo el que se usa;",{"_4098":85075,"_34307":85065,"_23429":143604,"_5":16198,"_30870":85065,"_3543":143605},[],"un dispositivo tiene que llevar ambos certificados y demostrar que van juntos, usando cada uno donde el interlocutor lo admita.",{"_4098":85076,"_34307":85065,"_23429":143607,"_5":16198,"_30870":85065,"_3543":143608},[],"El hash es SHA-256, SHA-384 o SHA-512, según el hash del algoritmo de firma del certificado relacionado, y SHA-256 si este no tiene ninguno.",{"_4098":85077,"_34307":85065,"_23429":143610,"_5":16198,"_30870":143576,"_3543":143611},[],"El dispositivo solicita el certificado vinculado con una solicitud PKCS#10 ordinaria que incluye un atributo adicional, `relatedCertRequest` (`1.2.840.113549.1.9.16.2.60`). El atributo identifica el certificado existente por emisor y número de serie, indica la hora de la solicitud, indica la ubicación desde la que puede descargarse el certificado y lleva una firma realizada con la clave privada de ese certificado existente. La firma cubre el emisor, el número de serie y la hora de la solicitud, no la ubicación, y demuestra que quien solicita controla la clave existente; la clave del nuevo certificado se prueba con la firma de la propia solicitud de certificado. Lamassu acepta una lista de ubicaciones, como en el módulo ASN.1 del RFC, y las prueba en orden.",{"_4098":85078,"_34307":85065,"_23429":143613,"_5":16198,"_30870":143576,"_3543":143614},[],"Cuando el servicio de CA recibe una solicitud así, sigue estos pasos:",{"_4098":85079,"_34307":85065,"_23429":143616,"_5":16198,"_30870":143576,"_3543":143617},[],"Comprueba que el perfil de emisión en uso habilita los certificados relacionados y, en caso contrario, rechaza la solicitud.",{"_4098":85080,"_34307":85065,"_23429":143619,"_5":16198,"_30870":143576,"_3543":143620},[],"Recorre en orden las ubicaciones del atributo y descarga el primer certificado que logra obtener.",{"_4098":85081,"_34307":85065,"_23429":143622,"_5":16198,"_30870":143576,"_3543":143623},[],"Verifica que el emisor y el número de serie coinciden, que la hora de la solicitud está dentro de la antigüedad permitida y que la firma es válida con la clave del certificado descargado.",{"_4098":85082,"_34307":85065,"_23429":143625,"_5":16198,"_30870":143576,"_3543":143626},[],"Emite el nuevo certificado con la extensión de certificado relacionado añadida.",{"_4098":85083,"_34307":85065,"_23429":143628,"_5":16198,"_30870":143576,"_3543":143629},[],"Una solicitud sin el atributo se procesa con normalidad, tanto si el perfil habilita la función como si no.",{"_4098":85084,"_34307":85065,"_23429":143631,"_5":16198,"_30870":143580,"_3543":143632},[],"Una ubicación es un URI `data:` o una URL `http` o `https`. Un URI `data:` debe estar codificado en base64 y contiene una estructura PKCS#7 cuyo primer certificado es el relacionado; no requiere acceso a la red y siempre se acepta cuando la función está habilitada. Una URL solo se descarga si su host figura en la lista de hosts permitidos del perfil. La CA no sigue redirecciones, aplica un tiempo de espera de diez segundos y rechaza respuestas de más de 1 MiB.",{"_4098":85085,"_34307":85065,"_23429":143634,"_5":16198,"_30870":143580,"_3543":143635},[],"Como la descarga la realiza el servidor, quien puede definir un perfil de emisión decide a qué hosts puede conectarse la CA. Conviene restringir ese permiso en consecuencia e incluir solo repositorios internos de certificados.",{"_4098":85086,"_34307":85065,"_23429":143637,"_5":16198,"_30870":143584,"_3543":143638},[],"La función se configura en el objeto `related_certificate` del perfil de emisión, que se almacena en columnas propias de la base de datos:",{"_4098":85087,"_34307":85065,"_23429":143640,"_5":16198,"_30870":143584,"_3543":142561},[],{"_4098":85088,"_34307":85065,"_23429":143642,"_5":16198,"_30870":143584,"_3543":138214},[],{"_4098":85089,"_34307":85065,"_23429":143644,"_5":16198,"_30870":143584,"_3543":142566},[],{"_4098":85090,"_34307":85065,"_23429":143646,"_5":16198,"_30870":143584,"_3543":138220},[],{"_4098":85091,"_34307":85065,"_23429":143648,"_5":16198,"_30870":143584,"_3543":66742},[],{"_4098":85092,"_34307":85065,"_23429":143650,"_5":16198,"_30870":143584,"_3543":114099},[],{"_4098":85093,"_34307":85065,"_23429":143652,"_5":16198,"_30870":143584,"_3543":65592},[],{"_4098":85094,"_34307":85065,"_23429":143654,"_5":16198,"_30870":143584,"_3543":143655},[],"Con `false`, se rechaza una solicitud que lleve el atributo.",{"_4098":85095,"_34307":85065,"_23429":143657,"_5":16198,"_30870":143584,"_3543":66752},[],{"_4098":85096,"_34307":85065,"_23429":143659,"_5":16198,"_30870":143584,"_3543":143660},[],"lista de cadenas",{"_4098":85097,"_34307":85065,"_23429":143662,"_5":16198,"_30870":143584,"_3543":143663},[],"vacía",{"_4098":85098,"_34307":85065,"_23429":143665,"_5":16198,"_30870":143584,"_3543":143666},[],"Hosts desde los que se pueden descargar ubicaciones `http` y `https`.",{"_4098":85099,"_34307":85065,"_23429":143668,"_5":16198,"_30870":143584,"_3543":66763},[],{"_4098":85100,"_34307":85065,"_23429":143670,"_5":16198,"_30870":143584,"_3543":143671},[],"duración",{"_4098":85101,"_34307":85065,"_23429":143673,"_5":16198,"_30870":143584,"_3543":66768},[],{"_4098":85102,"_34307":85065,"_23429":143675,"_5":16198,"_30870":143584,"_3543":143676},[],"Diferencia máxima entre la hora de la solicitud del atributo y el momento de la emisión.",{"_4098":85103,"_34307":85065,"_23429":143678,"_5":16198,"_30870":143588,"_3543":143679},[],"El fork se niega a vincular un certificado salvo que el nuevo sea compatible con el relacionado. Ninguno de los dos puede ser una CA. El certificado relacionado debe estar vigente en el momento de la emisión. Los usos de clave y los usos extendidos de clave solicitados para el nuevo certificado deben ser un subconjunto de los del certificado relacionado. La verificación posterior compara únicamente el hash, de modo que una parte que confía y comprueba el enlace averigua que la CA emisora vinculó el nuevo certificado a ese certificado concreto, no que el certificado relacionado siga siendo válido.",{"_4098":85104,"_34307":85065,"_23429":143681,"_5":16198,"_30870":143588,"_3543":143682},[],"La extensión es una prueba de relación, no una dependencia. Quien confía en ellos debe seguir validando cada certificado con su propia cadena y estado de revocación, y revocar el certificado clásico no revoca el vinculado.",{"_4098":85105,"_34307":85065,"_23429":143684,"_5":16198,"_30870":143592,"_3543":143685},[],"El dashboard cubre la función sin peticiones a la API. El formulario del perfil de emisión tiene un interruptor *Related Certificates* con los hosts permitidos y la antigüedad máxima, y el formulario de emisión ofrece *Bind to a related certificate* cuando el perfil seleccionado la habilita. Los detalles de certificados y CAs muestran una fila *Related Certificate* con el algoritmo de hash y su valor. Los pasos, con capturas, están en Dashboard.",{"_4098":85106,"_34307":85065,"_23429":143687,"_5":16198,"_30870":143592,"_3543":143688},[],"El certificado vinculado se crea con `CreateBoundCertificate` del fork, cuyas pruebas cubren una clave ML-DSA vinculada a certificados RSA, ECDSA y Ed25519. Las pruebas no usan claves composite. Solo el lado emisor está implementado en Lamassu: la plataforma no evalúa la extensión cuando valida certificados.",{"_4098":85107,"_34307":85065,"_23429":143690,"_5":16198,"_30870":143592,"_3543":143691},[],"<Card title=\"Claves y autoridades de certificación\" description=\"Crear la CA poscuántica que emite el certificado vinculado.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_4098":85108,"_34307":85065,"_23429":143693,"_5":16198,"_30870":143592,"_3543":143694},[],"<Card title=\"Limitaciones conocidas\" description=\"Lo que todavía no está cubierto.\" href=\"/docs/platform/pqc/limitations\" />",{"_4098":85109,"_34307":85109,"_5":16596,"_3543":143696,"_34738":143697,"_23429":143698,"_30870":85109},"Proxy TLS con Traefik",[56936,135600,141985,134169],[],{"_4098":85110,"_34307":85109,"_23429":143700,"_5":16198,"_30870":85109,"_3543":143701},[],"El fork de Traefik que termina el TLS de los dispositivos con certificados clásicos y poscuánticos para el mismo host, cómo elige certificado y cómo se compila.",{"_4098":85111,"_34307":85109,"_5":34735,"_23429":143703,"_30870":143704,"_3543":143705},[],"/docs/pr-preview/pr-58/es/platform/pqc/tls-front-proxy#varios-certificados-para-el-mismo-host","Varios certificados para el mismo host",{"_4098":85112,"_34307":85109,"_5":34735,"_23429":143707,"_30870":143708,"_3543":143709},[],"/docs/pr-preview/pr-58/es/platform/pqc/tls-front-proxy#opciones-tls-en-listeners-de-gateway-api","Opciones TLS en listeners de Gateway API",{"_4098":85113,"_34307":85109,"_5":34735,"_23429":143711,"_30870":143712,"_3543":143713},[],"/docs/pr-preview/pr-58/es/platform/pqc/tls-front-proxy#tls-mutuo","TLS mutuo",{"_4098":85114,"_34307":85109,"_5":34735,"_23429":143715,"_30870":143716,"_3543":143717},[],"/docs/pr-preview/pr-58/es/platform/pqc/tls-front-proxy#compilación-del-proxy","Compilación del proxy",{"_4098":85115,"_34307":85109,"_23429":143719,"_5":16198,"_30870":85109,"_3543":143720},[],"Los dispositivos se conectan a Lamassu por TLS, y el enrolamiento EST se apoya en TLS mutuo. Para aceptar un certificado poscuántico o composite en esa conexión, el endpoint TLS debe compilarse con el toolchain de Go PQC. Lamassu lo hace con un fork de Traefik, basado en Traefik 3.7.15, situado delante de Envoy Gateway. El fork añade dos comportamientos: puede servir varios certificados para el mismo host y elegir entre ellos según el cliente, y permite que un listener de Gateway API haga referencia a una opción TLS de Traefik.",{"_4098":85116,"_34307":85109,"_23429":143722,"_5":16198,"_30870":143704,"_3543":143723},[],"Traefik original conserva un certificado por conjunto de nombres. Si existen un certificado ECDSA clásico y un certificado ML-DSA para `lab.example.com`, solo se conserva el primero. El fork almacena cada certificado distinto (los duplicados se detectan comparando el certificado hoja) y elige uno en cada handshake.",{"_4098":85117,"_34307":85109,"_23429":143725,"_5":16198,"_30870":143704,"_3543":143726},[],"La elección sigue los algoritmos de firma que anuncia el cliente:",{"_4098":85118,"_34307":85109,"_23429":143728,"_5":16198,"_30870":143704,"_3543":143729},[],"Se normaliza el nombre de servidor del cliente y se reúnen los certificados cuyos nombres coinciden, con los nombres exactos por delante de los comodines. Un certificado con solo Common Name sigue coincidiendo.",{"_4098":85119,"_34307":85109,"_23429":143731,"_5":16198,"_30870":143704,"_3543":143732},[],"Si ningún certificado coincide, la conexión se cierra en modo SNI estricto, o se sirve el certificado por defecto.",{"_4098":85120,"_34307":85109,"_23429":143734,"_5":16198,"_30870":143704,"_3543":143735},[],"Si coincide exactamente un certificado, se sirve sin más comprobaciones.",{"_4098":85121,"_34307":85109,"_23429":143737,"_5":16198,"_30870":143704,"_3543":143738},[],"En otro caso, el proxy toma los esquemas de firma del cliente en el orden en que los envió y, para cada esquema, devuelve el primer certificado cuya clave permiten el esquema, la versión de TLS y el tipo de clave. Así se contrasta la clave hoja con `signature_algorithms`, los esquemas que el cliente acepta para la firma del handshake; las firmas del resto de la cadena son una comprobación distinta, frente a `signature_algorithms_cert`.",{"_4098":85122,"_34307":85109,"_23429":143740,"_5":16198,"_30870":143704,"_3543":143741},[],"Si el cliente no anuncia ningún esquema, se devuelve el primer certificado compatible. Si ninguno es compatible, se devuelve el primer candidato y el handshake falla con el error subyacente.",{"_4098":85123,"_34307":85109,"_23429":143743,"_5":16198,"_30870":143704,"_3543":143744},[],"Prevalece el orden de preferencia del cliente: un cliente que lista ML-DSA primero recibe el certificado poscuántico y uno que lista ECDSA primero recibe el clásico, aunque también soporte ML-DSA. Un cliente sin soporte poscuántico nunca anuncia esos esquemas y recibe el certificado clásico. TLS 1.2 nunca selecciona certificados ML-DSA ni composite. El servidor no puede configurarse con un orden de preferencia propio.",{"_4098":85124,"_34307":85109,"_23429":143746,"_5":16198,"_30870":143708,"_3543":143747},[],"Traefik lee su configuración de Gateway API desde Kubernetes. El fork lee la opción de listener `traefik.io/tls-options`, cuyo valor nombra la opción TLS que se aplica a ese listener: `default`, o un nombre cualificado como `traefik-system-pqc@kubernetescrd`. Funciona en listeners HTTPS y en listeners TLS en modo `Terminate` que sirven un `TLSRoute`. Se ignora en modo passthrough.",{"_4098":85125,"_34307":85109,"_23429":143749,"_5":16198,"_30870":143708,"_3543":143750},[],"En una opción TLS se establecen los grupos de intercambio de claves soportados y el modo de autenticación de cliente. Cuando varios listeners comparten un router padre y nombran opciones distintas, el proxy registra una advertencia y usa valores por defecto aislados para cada uno. Sin el fork, Traefik ignora la anotación, aplica sus propios valores por defecto y los ajustes no se pueden controlar; los dispositivos que necesitan TLS mutuo fallan entonces.",{"_4098":85126,"_34307":85109,"_23429":143752,"_5":16198,"_30870":143708,"_3543":143753},[],"El fork añade además `mlkem1024` a los nombres de grupo aceptados en `curvePreferences`, junto a los grupos híbridos que Traefik ya reconoce.",{"_4098":85127,"_34307":85109,"_23429":143755,"_5":16198,"_30870":143712,"_3543":143756},[],"La autenticación de cliente es el mecanismo estándar de Traefik, configurado en la opción TLS. Con `RequireAndVerifyClientCert` y un fichero de CA de cliente, el proxy valida la cadena, y la verificación de la firma del cliente la realiza la pila TLS del fork de Go, que se ha probado con certificados de cliente composite en un handshake TLS 1.3. Con `RequestClientCert`, que es lo que establece el chart de Lamassu en su opción por defecto, el proxy comprueba que el cliente posee la clave del certificado que presenta, pero no valida la cadena; la decisión se delega en el backend, que recibe el certificado en una cabecera (véase Despliegue con el Helm chart). Ninguna prueba de Traefik cubre el TLS mutuo poscuántico, y una cadena de cliente firmada por una CA composite o poscuántica depende del código x509 del fork.",{"_4098":85128,"_34307":85109,"_23429":143758,"_5":16198,"_30870":143716,"_3543":143759},[],"El fork no se compila desde la imagen de Go. El script `build.sh` exige una copia ya compilada del fork de Go, por defecto en `../go`, y comprueba que es el fork antes de forzar `GOROOT` y `GOTOOLCHAIN=local`. Compila el binario con `CGO_ENABLED=0`, genera la interfaz web salvo que se indique `SKIP_WEBUI=1` y empaqueta el binario en una imagen Alpine con `docker buildx`. La imagen por defecto es `ghcr.io/lamassuiot/traefik:pqc-3.7.15`.",{"_4098":85129,"_34307":85109,"_23429":143761,"_5":16198,"_30870":143716,"_3543":66857},[],{"_4098":85130,"_34307":85109,"_23429":143763,"_5":16198,"_30870":143716,"_3543":143764},[],"Finalidad",{"_4098":85131,"_34307":85109,"_23429":143766,"_5":16198,"_30870":143716,"_3543":66862},[],{"_4098":85132,"_34307":85109,"_23429":143768,"_5":16198,"_30870":143716,"_3543":143769},[],"Ubicación del fork de Go compilado.",{"_4098":85133,"_34307":85109,"_23429":143771,"_5":16198,"_30870":143716,"_3543":66868},[],{"_4098":85134,"_34307":85109,"_23429":143773,"_5":16198,"_30870":143716,"_3543":143774},[],"Plataformas de destino; por defecto `linux/amd64`.",{"_4098":85135,"_34307":85109,"_23429":143776,"_5":16198,"_30870":143716,"_3543":66874},[],{"_4098":85136,"_34307":85109,"_23429":143778,"_5":16198,"_30870":143716,"_3543":143779},[],"Omite la generación de la interfaz web con el valor `1`.",{"_4098":85137,"_34307":85109,"_23429":143781,"_5":16198,"_30870":143716,"_3543":66880},[],{"_4098":85138,"_34307":85109,"_23429":143783,"_5":16198,"_30870":143716,"_3543":143784},[],"Nombre de la imagen y si se publica. Las compilaciones multiplataforma requieren `PUSH=1`.",{"_4098":85139,"_34307":85109,"_23429":143786,"_5":16198,"_30870":143716,"_3543":143787},[],"Las etiquetas `pqc-*` son mutables y se han reconstruido sobre sí mismas, por lo que en entornos próximos a producción conviene fijar el digest.",{"_4098":85140,"_34307":85109,"_23429":143789,"_5":16198,"_30870":143716,"_3543":143790},[],"Las pruebas de selección del fork usan ML-DSA-65 puro junto con ECDSA P-256. La selección de un certificado composite depende de que la pila TLS del fork conozca la clave composite, algo que ocurre, pero el proxy no tiene ninguna prueba para ello.",{"_4098":85141,"_34307":85109,"_23429":143792,"_5":16198,"_30870":143716,"_3543":143793},[],"<Card title=\"Despliegue con el Helm chart\" description=\"Instalar el proxy delante de Envoy Gateway con el chart.\" href=\"/docs/platform/pqc/deployment\" />",{"_4098":85142,"_34307":85109,"_23429":143795,"_5":16198,"_30870":143716,"_3543":143796},[],"<Card title=\"Limitaciones conocidas\" description=\"Interoperabilidad y advertencias operativas.\" href=\"/docs/platform/pqc/limitations\" />",{"_4098":85143,"_34307":85143,"_5":16596,"_3543":143798,"_34738":143799,"_23429":143800,"_30870":85143},"Seguridad",[56936],[],{"_4098":85144,"_34307":85143,"_23429":143802,"_5":16198,"_30870":85143,"_3543":143803},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_4098":85145,"_34307":85143,"_5":34735,"_23429":143805,"_30870":143806,"_3543":143807},[],"/docs/pr-preview/pr-58/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_4098":85146,"_34307":85143,"_5":34735,"_23429":143809,"_30870":143810,"_3543":143811},[],"/docs/pr-preview/pr-58/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_4098":85147,"_34307":85143,"_5":34735,"_23429":143813,"_30870":143814,"_3543":143815},[],"/docs/pr-preview/pr-58/es/security#versiones-soportadas","Versiones soportadas",{"_4098":85148,"_34307":85143,"_5":34735,"_23429":143817,"_30870":143818,"_3543":143819},[],"/docs/pr-preview/pr-58/es/security#divulgación-responsable","Divulgación responsable",{"_4098":85149,"_34307":85143,"_23429":143821,"_5":16198,"_30870":85143,"_3543":143822},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_4098":85150,"_34307":85143,"_23429":143824,"_5":16198,"_30870":143806,"_3543":143825},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_4098":85151,"_34307":85143,"_23429":143827,"_5":16198,"_30870":143806,"_3543":143828},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_4098":85152,"_34307":85143,"_23429":143830,"_5":16198,"_30870":143806,"_3543":16951},[],{"_4098":85153,"_34307":85143,"_23429":143832,"_5":16198,"_30870":143806,"_3543":16887},[],{"_4098":85154,"_34307":85143,"_23429":143834,"_5":16198,"_30870":143806,"_3543":16944},[],{"_4098":85155,"_34307":85143,"_23429":143836,"_5":16198,"_30870":143806,"_3543":143837},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_4098":85156,"_34307":85143,"_23429":143839,"_5":16198,"_30870":143806,"_3543":143840},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_4098":85157,"_34307":85143,"_23429":143842,"_5":16198,"_30870":143810,"_3543":143843},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_4098":85158,"_34307":85143,"_23429":143845,"_5":16198,"_30870":143810,"_3543":143846},[],"No incluyas en el reporte:",{"_4098":85159,"_34307":85143,"_23429":143848,"_5":16198,"_30870":143810,"_3543":143849},[],"Credenciales, tokens o claves privadas",{"_4098":85160,"_34307":85143,"_23429":143851,"_5":16198,"_30870":143810,"_3543":143852},[],"Datos de clientes o información identificable de clientes",{"_4098":85161,"_34307":85143,"_23429":143854,"_5":16198,"_30870":143810,"_3543":143855},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_4098":85162,"_34307":85143,"_23429":143857,"_5":16198,"_30870":143814,"_3543":143858},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_4098":85163,"_34307":85143,"_23429":143860,"_5":16198,"_30870":143814,"_3543":143861},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_4098":85164,"_34307":85143,"_23429":143863,"_5":16198,"_30870":143818,"_3543":143864},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_4098":85165,"_34307":85143,"_23429":143866,"_5":16198,"_30870":143818,"_3543":143867},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_4098":85166,"_34307":85143,"_23429":143869,"_5":16198,"_30870":143818,"_3543":143870},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_4098":85167,"_34307":85143,"_23429":143872,"_5":16198,"_30870":143818,"_3543":143873},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_4098":85168,"_34307":85143,"_23429":143875,"_5":16198,"_30870":143818,"_3543":143876},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_4098":85169,"_34307":85169,"_5":16596,"_3543":143878,"_34738":143879,"_23429":143881,"_30870":85169},"3.8.0 a 4.0.0",[56936,143880],"Actualizaciones",[],{"_4098":85170,"_34307":85169,"_23429":143883,"_5":16198,"_30870":85169,"_3543":143884},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_4098":85171,"_34307":85169,"_5":34735,"_23429":143886,"_30870":143887,"_3543":143888},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_4098":85172,"_34307":85169,"_5":34735,"_23429":143890,"_30870":143891,"_3543":143892},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_4098":85173,"_34307":85169,"_5":34735,"_23429":143894,"_30870":143895,"_3543":143896},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_4098":85174,"_34307":85169,"_5":34735,"_23429":143898,"_30870":143899,"_3543":143900},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_4098":85175,"_34307":85169,"_5":34735,"_23429":143902,"_30870":143903,"_3543":143904},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_4098":85176,"_34307":85169,"_5":34735,"_23429":143906,"_30870":143907,"_3543":143908},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_4098":85177,"_34307":85169,"_5":34735,"_23429":143910,"_30870":143911,"_3543":67011},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_4098":85178,"_34307":85169,"_5":34735,"_23429":143913,"_30870":143914,"_3543":143915},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_4098":85179,"_34307":85169,"_5":34735,"_23429":143917,"_30870":143918,"_3543":143919},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_4098":85180,"_34307":85169,"_5":34735,"_23429":143921,"_30870":143922,"_3543":143923},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_4098":85181,"_34307":85169,"_5":34735,"_23429":143925,"_30870":143926,"_3543":143927},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_4098":85182,"_34307":85169,"_5":34735,"_23429":143929,"_30870":143930,"_3543":143931},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_4098":85183,"_34307":85169,"_5":34735,"_23429":143933,"_30870":143934,"_3543":143935},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_4098":85184,"_34307":85169,"_5":34735,"_23429":143937,"_30870":143938,"_3543":143939},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_4098":85185,"_34307":85169,"_5":34735,"_23429":143941,"_30870":143942,"_3543":143943},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_4098":85186,"_34307":85169,"_5":34735,"_23429":143945,"_30870":143946,"_3543":143947},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_4098":85187,"_34307":85169,"_5":34735,"_23429":143949,"_30870":143950,"_3543":143951},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_4098":85188,"_34307":85169,"_5":34735,"_23429":143953,"_30870":143954,"_3543":143955},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_4098":85189,"_34307":85169,"_5":34735,"_23429":143957,"_30870":143958,"_3543":143959},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_4098":85190,"_34307":85169,"_5":34735,"_23429":143961,"_30870":143962,"_3543":143963},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-roles-va","Referencias entre certificados, claves y roles VA",{"_4098":85191,"_34307":85169,"_5":34735,"_23429":143965,"_30870":143966,"_3543":143967},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_4098":85192,"_34307":85169,"_5":34735,"_23429":143969,"_30870":143970,"_3543":143971},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_4098":85193,"_34307":85169,"_5":34735,"_23429":143973,"_30870":143974,"_3543":143975},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_4098":85194,"_34307":85169,"_5":34735,"_23429":143977,"_30870":143978,"_3543":143979},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_4098":85195,"_34307":85169,"_5":34735,"_23429":143981,"_30870":143982,"_3543":143983},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_4098":85196,"_34307":85169,"_5":34735,"_23429":143985,"_30870":143986,"_3543":143987},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_4098":85197,"_34307":85169,"_5":34735,"_23429":143989,"_30870":143990,"_3543":143991},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_4098":85198,"_34307":85169,"_5":34735,"_23429":143993,"_30870":143994,"_3543":143995},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#campo-firmante-del-rol-va","Campo firmante del rol VA",{"_4098":85199,"_34307":85169,"_5":34735,"_23429":143997,"_30870":143998,"_3543":143999},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_4098":85200,"_34307":85169,"_5":34735,"_23429":144001,"_30870":144002,"_3543":144003},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_4098":85201,"_34307":85169,"_5":34735,"_23429":144005,"_30870":144006,"_3543":144007},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_4098":85202,"_34307":85169,"_5":34735,"_23429":144009,"_30870":144010,"_3543":144011},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_4098":85203,"_34307":85169,"_5":34735,"_23429":144013,"_30870":144014,"_3543":144015},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_4098":85204,"_34307":85169,"_5":34735,"_23429":144017,"_30870":144018,"_3543":144019},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_4098":85205,"_34307":85169,"_5":34735,"_23429":144021,"_30870":144022,"_3543":144023},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_4098":85206,"_34307":85169,"_5":34735,"_23429":144025,"_30870":144026,"_3543":138118},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_4098":85207,"_34307":85169,"_5":34735,"_23429":144028,"_30870":144029,"_3543":144030},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_4098":85208,"_34307":85169,"_5":34735,"_23429":144032,"_30870":144033,"_3543":144034},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_4098":85209,"_34307":85169,"_23429":144036,"_5":16198,"_30870":85169,"_3543":144037},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_4098":85210,"_34307":85169,"_23429":144039,"_5":16198,"_30870":85169,"_3543":144040},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_4098":85211,"_34307":85169,"_23429":144042,"_5":16198,"_30870":85169,"_3543":144043},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_4098":85212,"_34307":85169,"_23429":144045,"_5":16198,"_30870":85169,"_3543":144046},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_4098":85213,"_34307":85169,"_23429":144048,"_5":16198,"_30870":85169,"_3543":144049},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_4098":85214,"_34307":85169,"_23429":144051,"_5":16198,"_30870":85169,"_3543":144052},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_4098":85215,"_34307":85169,"_23429":144054,"_5":16198,"_30870":85169,"_3543":144055},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_4098":85216,"_34307":85169,"_23429":144057,"_5":16198,"_30870":143891,"_3543":144058},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_4098":85217,"_34307":85169,"_23429":144060,"_5":16198,"_30870":143891,"_3543":144061},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_4098":85218,"_34307":85169,"_23429":144063,"_5":16198,"_30870":143895,"_3543":144064},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_4098":85219,"_34307":85169,"_23429":144066,"_5":16198,"_30870":143895,"_3543":144067},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_4098":85220,"_34307":85169,"_23429":144069,"_5":16198,"_30870":143899,"_3543":144070},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_4098":85221,"_34307":85169,"_23429":144072,"_5":16198,"_30870":143903,"_3543":144073},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_4098":85222,"_34307":85169,"_23429":144075,"_5":16198,"_30870":143903,"_3543":144076},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_4098":85223,"_34307":85169,"_23429":144078,"_5":16198,"_30870":143903,"_3543":144079},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_4098":85224,"_34307":85169,"_23429":144081,"_5":16198,"_30870":143903,"_3543":144082},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_4098":85225,"_34307":85169,"_23429":144084,"_5":16198,"_30870":143903,"_3543":144085},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_4098":85226,"_34307":85169,"_23429":144087,"_5":16198,"_30870":143907,"_3543":144088},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_4098":85227,"_34307":85169,"_23429":144090,"_5":16198,"_30870":143907,"_3543":144091},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_4098":85228,"_34307":85169,"_23429":144093,"_5":16198,"_30870":143907,"_3543":144094},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_4098":85229,"_34307":85169,"_23429":144096,"_5":16198,"_30870":143907,"_3543":144097},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_4098":85230,"_34307":85169,"_23429":144099,"_5":16198,"_30870":143907,"_3543":144100},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_4098":85231,"_34307":85169,"_23429":144102,"_5":16198,"_30870":143911,"_3543":144103},[],"Cambio",{"_4098":85232,"_34307":85169,"_23429":144105,"_5":16198,"_30870":143911,"_3543":144106},[],"A quién afecta",{"_4098":85233,"_34307":85169,"_23429":144108,"_5":16198,"_30870":143911,"_3543":144109},[],"Gravedad",{"_4098":85234,"_34307":85169,"_23429":144111,"_5":16198,"_30870":143911,"_3543":140823},[],{"_4098":85235,"_34307":85169,"_23429":144113,"_5":16198,"_30870":143911,"_3543":143919},[],{"_4098":85236,"_34307":85169,"_23429":144115,"_5":16198,"_30870":143911,"_3543":144116},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_4098":85237,"_34307":85169,"_23429":144118,"_5":16198,"_30870":143911,"_3543":144119},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_4098":85238,"_34307":85169,"_23429":144121,"_5":16198,"_30870":143911,"_3543":144122},[],"Copiar los datos a los volúmenes nuevos",{"_4098":85239,"_34307":85169,"_23429":144124,"_5":16198,"_30870":143911,"_3543":143923},[],{"_4098":85240,"_34307":85169,"_23429":144126,"_5":16198,"_30870":143911,"_3543":144127},[],"Todas las releases de Helm",{"_4098":85241,"_34307":85169,"_23429":144129,"_5":16198,"_30870":143911,"_3543":144130},[],"Alta: `helm upgrade` falla",{"_4098":85242,"_34307":85169,"_23429":144132,"_5":16198,"_30870":143911,"_3543":144133},[],"Eliminar o renombrar las claves heredadas",{"_4098":85243,"_34307":85169,"_23429":144135,"_5":16198,"_30870":143911,"_3543":143927},[],{"_4098":85244,"_34307":85169,"_23429":144137,"_5":16198,"_30870":143911,"_3543":144138},[],"Todos los despliegues",{"_4098":85245,"_34307":85169,"_23429":144140,"_5":16198,"_30870":143911,"_3543":144141},[],"Alta: sin principal de bootstrap no hay administrador",{"_4098":85246,"_34307":85169,"_23429":144143,"_5":16198,"_30870":143911,"_3543":144144},[],"Configurar `services.authz`",{"_4098":85247,"_34307":85169,"_23429":144146,"_5":16198,"_30870":143911,"_3543":143931},[],{"_4098":85248,"_34307":85169,"_23429":144148,"_5":16198,"_30870":143911,"_3543":144127},[],{"_4098":85249,"_34307":85169,"_23429":144150,"_5":16198,"_30870":143911,"_3543":144151},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_4098":85250,"_34307":85169,"_23429":144153,"_5":16198,"_30870":143911,"_3543":144154},[],"Mover JWKS y roles a `services.authz`",{"_4098":85251,"_34307":85169,"_23429":144156,"_5":16198,"_30870":143911,"_3543":143951},[],{"_4098":85252,"_34307":85169,"_23429":144158,"_5":16198,"_30870":143911,"_3543":144159},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_4098":85253,"_34307":85169,"_23429":144161,"_5":16198,"_30870":143911,"_3543":144162},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_4098":85254,"_34307":85169,"_23429":144164,"_5":16198,"_30870":143911,"_3543":144165},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_4098":85255,"_34307":85169,"_23429":144167,"_5":16198,"_30870":143911,"_3543":143955},[],{"_4098":85256,"_34307":85169,"_23429":144169,"_5":16198,"_30870":143911,"_3543":144170},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_4098":85257,"_34307":85169,"_23429":144172,"_5":16198,"_30870":143911,"_3543":144173},[],"Alta: el backend ya no arranca con ellos",{"_4098":85258,"_34307":85169,"_23429":144175,"_5":16198,"_30870":143911,"_3543":144176},[],"Pasar a PostgreSQL antes de actualizar",{"_4098":85259,"_34307":85169,"_23429":144178,"_5":16198,"_30870":143911,"_3543":144179},[],"Webhooks con referencias a archivos",{"_4098":85260,"_34307":85169,"_23429":144181,"_5":16198,"_30870":143911,"_3543":144182},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_4098":85261,"_34307":85169,"_23429":144184,"_5":16198,"_30870":143911,"_3543":144185},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_4098":85262,"_34307":85169,"_23429":144187,"_5":16198,"_30870":143911,"_3543":144188},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_4098":85263,"_34307":85169,"_23429":144190,"_5":16198,"_30870":143911,"_3543":143935},[],{"_4098":85264,"_34307":85169,"_23429":144192,"_5":16198,"_30870":143911,"_3543":144193},[],"Releases con identidades por servicio o material de claves montado",{"_4098":85265,"_34307":85169,"_23429":144195,"_5":16198,"_30870":143911,"_3543":144196},[],"Media: los servicios no pueden leer sus archivos",{"_4098":85266,"_34307":85169,"_23429":144198,"_5":16198,"_30870":143911,"_3543":144199},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_4098":85267,"_34307":85169,"_23429":144201,"_5":16198,"_30870":143911,"_3543":143939},[],{"_4098":85268,"_34307":85169,"_23429":144203,"_5":16198,"_30870":143911,"_3543":144204},[],"Releases que definen `amqp.tls`",{"_4098":85269,"_34307":85169,"_23429":144206,"_5":16198,"_30870":143911,"_3543":144207},[],"Media: los clientes se conectan al puerto equivocado",{"_4098":85270,"_34307":85169,"_23429":144209,"_5":16198,"_30870":143911,"_3543":144210},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_4098":85271,"_34307":85169,"_23429":144212,"_5":16198,"_30870":143911,"_3543":143959},[],{"_4098":85272,"_34307":85169,"_23429":144214,"_5":16198,"_30870":143911,"_3543":144215},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_4098":85273,"_34307":85169,"_23429":144217,"_5":16198,"_30870":143911,"_3543":144218},[],"Media: las claves de CA quedan sin gestionar",{"_4098":85274,"_34307":85169,"_23429":144220,"_5":16198,"_30870":143911,"_3543":144221},[],"Ejecutar la migración de CA a KMS",{"_4098":85275,"_34307":85169,"_23429":144223,"_5":16198,"_30870":143911,"_3543":144224},[],"Verificación del certificado del receptor",{"_4098":85276,"_34307":85169,"_23429":144226,"_5":16198,"_30870":143911,"_3543":144227},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_4098":85277,"_34307":85169,"_23429":144229,"_5":16198,"_30870":143911,"_3543":144230},[],"Media: las credenciales viajan a un receptor sin verificar",{"_4098":85278,"_34307":85169,"_23429":144232,"_5":16198,"_30870":143911,"_3543":144233},[],"Poner `insecure_skip_verify` a `false`",{"_4098":85279,"_34307":85169,"_23429":144235,"_5":16198,"_30870":143911,"_3543":143975},[],{"_4098":85280,"_34307":85169,"_23429":144237,"_5":16198,"_30870":143911,"_3543":144238},[],"Scripts y consolas que editan DMS por API",{"_4098":85281,"_34307":85169,"_23429":144240,"_5":16198,"_30870":143911,"_3543":144241},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_4098":85282,"_34307":85169,"_23429":144243,"_5":16198,"_30870":143911,"_3543":144244},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_4098":85283,"_34307":85169,"_23429":144246,"_5":16198,"_30870":143911,"_3543":143995},[],{"_4098":85284,"_34307":85169,"_23429":144248,"_5":16198,"_30870":143911,"_3543":144249},[],"Clientes que crean o actualizan roles VA por API",{"_4098":85285,"_34307":85169,"_23429":144251,"_5":16198,"_30870":143911,"_3543":144252},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_4098":85286,"_34307":85169,"_23429":144254,"_5":16198,"_30870":143911,"_3543":144255},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_certificate_serial_number`",{"_4098":85287,"_34307":85169,"_23429":144257,"_5":16198,"_30870":143911,"_3543":143991},[],{"_4098":85288,"_34307":85169,"_23429":144259,"_5":16198,"_30870":143911,"_3543":144260},[],"Consumidores que leen el campo `events` del dispositivo",{"_4098":85289,"_34307":85169,"_23429":144262,"_5":16198,"_30870":143911,"_3543":144263},[],"Media: el campo desaparece",{"_4098":85290,"_34307":85169,"_23429":144265,"_5":16198,"_30870":143911,"_3543":144266},[],"Usar los nuevos endpoints de eventos",{"_4098":85291,"_34307":85169,"_23429":144268,"_5":16198,"_30870":143911,"_3543":143943},[],{"_4098":85292,"_34307":85169,"_23429":144270,"_5":16198,"_30870":143911,"_3543":144271},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_4098":85293,"_34307":85169,"_23429":144273,"_5":16198,"_30870":143911,"_3543":144274},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_4098":85294,"_34307":85169,"_23429":144276,"_5":16198,"_30870":143911,"_3543":144277},[],"Actualizar el archivo de values",{"_4098":85295,"_34307":85169,"_23429":144279,"_5":16198,"_30870":143911,"_3543":143983},[],{"_4098":85296,"_34307":85169,"_23429":144281,"_5":16198,"_30870":143911,"_3543":144282},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_4098":85297,"_34307":85169,"_23429":144284,"_5":16198,"_30870":143911,"_3543":144285},[],"Baja: prevalece el ID de la URL",{"_4098":85298,"_34307":85169,"_23429":144287,"_5":16198,"_30870":143911,"_3543":144288},[],"Enviar el ID en la URL",{"_4098":85299,"_34307":85169,"_23429":144290,"_5":16198,"_30870":143911,"_3543":143987},[],{"_4098":85300,"_34307":85169,"_23429":144292,"_5":16198,"_30870":143911,"_3543":144293},[],"Consumidores que comparan el `type` del certificado",{"_4098":85301,"_34307":85169,"_23429":144295,"_5":16198,"_30870":143911,"_3543":144296},[],"Baja: dos valores cambian de nombre",{"_4098":85302,"_34307":85169,"_23429":144298,"_5":16198,"_30870":143911,"_3543":144299},[],"Adaptar los consumidores",{"_4098":85303,"_34307":85169,"_23429":144301,"_5":16198,"_30870":143911,"_3543":143979},[],{"_4098":85304,"_34307":85169,"_23429":144303,"_5":16198,"_30870":143911,"_3543":144304},[],"Cualquier DMS",{"_4098":85305,"_34307":85169,"_23429":144306,"_5":16198,"_30870":143911,"_3543":144307},[],"Baja: solo informativo",{"_4098":85306,"_34307":85169,"_23429":144309,"_5":16198,"_30870":143911,"_3543":144310},[],"Revisar ambos bloques antes de editar",{"_4098":85307,"_34307":85169,"_23429":144312,"_5":16198,"_30870":143918,"_3543":144313},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_4098":85308,"_34307":85169,"_23429":144315,"_5":16198,"_30870":143918,"_3543":144316},[],"El paso 4 de la guía de migración copia los datos.",{"_4098":85309,"_34307":85169,"_23429":144318,"_5":16198,"_30870":143922,"_3543":144319},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_4098":85310,"_34307":85169,"_23429":144321,"_5":16198,"_30870":143926,"_3543":144322},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_4098":85311,"_34307":85169,"_23429":144324,"_5":16198,"_30870":143930,"_3543":144325},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_4098":85312,"_34307":85169,"_23429":144327,"_5":16198,"_30870":143934,"_3543":144328},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_4098":85313,"_34307":85169,"_23429":144330,"_5":16198,"_30870":143934,"_3543":144331},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_4098":85314,"_34307":85169,"_23429":144333,"_5":16198,"_30870":143938,"_3543":144334},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_4098":85315,"_34307":85169,"_23429":144336,"_5":16198,"_30870":143942,"_3543":144337},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_4098":85316,"_34307":85169,"_23429":144339,"_5":16198,"_30870":143942,"_3543":144340},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_4098":85317,"_34307":85169,"_23429":144342,"_5":16198,"_30870":143942,"_3543":144343},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_4098":85318,"_34307":85169,"_23429":144345,"_5":16198,"_30870":143942,"_3543":144346},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_4098":85319,"_34307":85169,"_23429":144348,"_5":16198,"_30870":143942,"_3543":144349},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_4098":85320,"_34307":85169,"_23429":144351,"_5":16198,"_30870":143942,"_3543":144352},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_4098":85321,"_34307":85169,"_23429":144354,"_5":16198,"_30870":143950,"_3543":144355},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_4098":85322,"_34307":85169,"_23429":144357,"_5":16198,"_30870":143950,"_3543":144358},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_4098":85323,"_34307":85169,"_23429":144360,"_5":16198,"_30870":143950,"_3543":144361},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_4098":85324,"_34307":85169,"_23429":144363,"_5":16198,"_30870":143950,"_3543":144364},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_4098":85325,"_34307":85169,"_23429":144366,"_5":16198,"_30870":143950,"_3543":144367},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_4098":85326,"_34307":85169,"_23429":144369,"_5":16198,"_30870":143954,"_3543":144370},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_4098":85327,"_34307":85169,"_23429":144372,"_5":16198,"_30870":143958,"_3543":144373},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_4098":85328,"_34307":85169,"_23429":144375,"_5":16198,"_30870":143958,"_3543":144376},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_4098":85329,"_34307":85169,"_23429":144378,"_5":16198,"_30870":143958,"_3543":144379},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_4098":85330,"_34307":85169,"_23429":144381,"_5":16198,"_30870":143958,"_3543":144382},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_4098":85331,"_34307":85169,"_23429":144384,"_5":16198,"_30870":143958,"_3543":144385},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_4098":85332,"_34307":85169,"_23429":144387,"_5":16198,"_30870":143958,"_3543":144388},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_4098":85333,"_34307":85169,"_23429":144390,"_5":16198,"_30870":143958,"_3543":144391},[],"Una vez registradas las claves heredadas, arrancar el KMS con la opción de configuración del backend `crypto_engines.migrate_keys_format` renombra las claves cuyo nombre no es el digest SHA-256 de la clave pública, conserva el nombre antiguo como alias y traslada consigo las referencias de certificados. Es seguro volver a ejecutarla y puede desactivarse después.",{"_4098":85334,"_34307":85169,"_23429":144393,"_5":16198,"_30870":143962,"_3543":144394},[],"Los certificados referencian ahora su clave del KMS, y los roles VA referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_4098":85335,"_34307":85169,"_23429":144396,"_5":16198,"_30870":143970,"_3543":144397},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_4098":85336,"_34307":85169,"_23429":144399,"_5":16198,"_30870":143970,"_3543":144400},[],"Campo en 3.8.0",{"_4098":85337,"_34307":85169,"_23429":144402,"_5":16198,"_30870":143970,"_3543":144403},[],"Campo en 4.0.0",{"_4098":85338,"_34307":85169,"_23429":144405,"_5":16198,"_30870":143970,"_3543":67506},[],{"_4098":85339,"_34307":85169,"_23429":144407,"_5":16198,"_30870":143970,"_3543":144408},[],"`insecure_skip_verify` (con el valor negado)",{"_4098":85340,"_34307":85169,"_23429":144410,"_5":16198,"_30870":143970,"_3543":67512},[],{"_4098":85341,"_34307":85169,"_23429":144412,"_5":16198,"_30870":143970,"_3543":67515},[],{"_4098":85342,"_34307":85169,"_23429":144414,"_5":16198,"_30870":143970,"_3543":67518},[],{"_4098":85343,"_34307":85169,"_23429":144416,"_5":16198,"_30870":143970,"_3543":67521},[],{"_4098":85344,"_34307":85169,"_23429":144418,"_5":16198,"_30870":143970,"_3543":67524},[],{"_4098":85345,"_34307":85169,"_23429":144420,"_5":16198,"_30870":143970,"_3543":67527},[],{"_4098":85346,"_34307":85169,"_23429":144422,"_5":16198,"_30870":143970,"_3543":144423},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_4098":85347,"_34307":85169,"_23429":144425,"_5":16198,"_30870":143970,"_3543":144426},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_4098":85348,"_34307":85169,"_23429":144428,"_5":16198,"_30870":143970,"_3543":144429},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_4098":85349,"_34307":85169,"_23429":144431,"_5":16198,"_30870":143974,"_3543":144432},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_4098":85350,"_34307":85169,"_23429":144434,"_5":16198,"_30870":143974,"_3543":144435},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_4098":85351,"_34307":85169,"_23429":144437,"_5":16198,"_30870":143974,"_3543":144438},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_4098":85352,"_34307":85169,"_23429":144440,"_5":16198,"_30870":143978,"_3543":144441},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_4098":85353,"_34307":85169,"_23429":144443,"_5":16198,"_30870":143982,"_3543":144444},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_4098":85354,"_34307":85169,"_23429":144446,"_5":16198,"_30870":143986,"_3543":144447},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_4098":85355,"_34307":85169,"_23429":144449,"_5":16198,"_30870":143990,"_3543":144450},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_4098":85356,"_34307":85169,"_23429":144452,"_5":16198,"_30870":143990,"_3543":144453},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_4098":85357,"_34307":85169,"_23429":144455,"_5":16198,"_30870":143990,"_3543":144456},[],"`POST /v1/devices/:id/events` crea un evento.",{"_4098":85358,"_34307":85169,"_23429":144458,"_5":16198,"_30870":143990,"_3543":144459},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_4098":85359,"_34307":85169,"_23429":144461,"_5":16198,"_30870":143994,"_3543":144462},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_certificate_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de un rol nuevo es el número de serie del certificado actual de la CA. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. Las políticas de autorización personalizadas que filtran por el campo antiguo deben actualizarse: el filtro `crl_subject_key_id_signer` se renombra a `crl_signer_certificate_serial_number` y toma valores de número de serie.",{"_4098":85360,"_34307":85169,"_23429":144464,"_5":16198,"_30870":143998,"_3543":144465},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_4098":85361,"_34307":85169,"_23429":144467,"_5":16198,"_30870":144002,"_3543":144468},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_4098":85362,"_34307":85169,"_23429":144470,"_5":16198,"_30870":144002,"_3543":144471},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_4098":85363,"_34307":85169,"_23429":144473,"_5":16198,"_30870":144002,"_3543":144474},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_4098":85364,"_34307":85169,"_23429":144476,"_5":16198,"_30870":144002,"_3543":144477},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_4098":85365,"_34307":85169,"_23429":144479,"_5":16198,"_30870":144002,"_3543":144480},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_4098":85366,"_34307":85169,"_23429":144482,"_5":16198,"_30870":144006,"_3543":144483},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_4098":85367,"_34307":85169,"_23429":144485,"_5":16198,"_30870":144006,"_3543":144486},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_4098":85368,"_34307":85169,"_23429":144488,"_5":16198,"_30870":144006,"_3543":144489},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_4098":85369,"_34307":85169,"_23429":144491,"_5":16198,"_30870":144006,"_3543":144492},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_4098":85370,"_34307":85169,"_23429":144494,"_5":16198,"_30870":144006,"_3543":144495},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_4098":85371,"_34307":85169,"_23429":144497,"_5":16198,"_30870":144006,"_3543":144498},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_4098":85372,"_34307":85169,"_23429":144500,"_5":16198,"_30870":144006,"_3543":144501},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_4098":85373,"_34307":85169,"_23429":144503,"_5":16198,"_30870":144006,"_3543":144504},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_4098":85374,"_34307":85169,"_23429":144506,"_5":16198,"_30870":144006,"_3543":144507},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_4098":85375,"_34307":85169,"_23429":144509,"_5":16198,"_30870":144006,"_3543":144510},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_4098":85376,"_34307":85169,"_23429":144512,"_5":16198,"_30870":144006,"_3543":144513},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_4098":85377,"_34307":85169,"_23429":144515,"_5":16198,"_30870":144006,"_3543":144516},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_4098":85378,"_34307":85169,"_23429":144518,"_5":16198,"_30870":144010,"_3543":144519},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_4098":85379,"_34307":85169,"_23429":144521,"_5":16198,"_30870":144010,"_3543":144522},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_4098":85380,"_34307":85169,"_23429":144524,"_5":16198,"_30870":144014,"_3543":144525},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_4098":85381,"_34307":85169,"_23429":144527,"_5":16198,"_30870":144014,"_3543":144528},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_4098":85382,"_34307":85169,"_23429":144530,"_5":16198,"_30870":144014,"_3543":144531},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_4098":85383,"_34307":85169,"_23429":144533,"_5":16198,"_30870":144014,"_3543":144534},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_4098":85384,"_34307":85169,"_23429":144536,"_5":16198,"_30870":144014,"_3543":144537},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_4098":85385,"_34307":85169,"_23429":144539,"_5":16198,"_30870":144014,"_3543":144540},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_4098":85386,"_34307":85169,"_23429":144542,"_5":16198,"_30870":144014,"_3543":144543},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_4098":85387,"_34307":85169,"_23429":144545,"_5":16198,"_30870":144014,"_3543":144546},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_4098":85388,"_34307":85169,"_23429":144548,"_5":16198,"_30870":144014,"_3543":144549},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_4098":85389,"_34307":85169,"_23429":144551,"_5":16198,"_30870":144014,"_3543":144552},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_4098":85390,"_34307":85169,"_23429":144554,"_5":16198,"_30870":144014,"_3543":144555},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_4098":85391,"_34307":85169,"_23429":144557,"_5":16198,"_30870":144018,"_3543":144558},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_4098":85392,"_34307":85169,"_23429":144560,"_5":16198,"_30870":144018,"_3543":144561},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_4098":85393,"_34307":85169,"_23429":144563,"_5":16198,"_30870":144022,"_3543":144564},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_4098":85394,"_34307":85169,"_23429":144566,"_5":16198,"_30870":144022,"_3543":144567},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_4098":85395,"_34307":85169,"_23429":144569,"_5":16198,"_30870":144022,"_3543":144570},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Si tus servicios se conectan con un usuario distinto del que ejecutó las migraciones, concédele tras las migraciones `SELECT` sobre `ca.certificates_view`.",{"_4098":85396,"_34307":85169,"_23429":144572,"_5":16198,"_30870":144022,"_3543":144573},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_4098":85397,"_34307":85169,"_23429":144575,"_5":16198,"_30870":144022,"_3543":144576},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_4098":85398,"_34307":85169,"_23429":144578,"_5":16198,"_30870":144022,"_3543":144579},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_4098":85399,"_34307":85169,"_23429":144581,"_5":16198,"_30870":144022,"_3543":144582},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_4098":85400,"_34307":85169,"_23429":144584,"_5":16198,"_30870":144026,"_3543":144585},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_4098":85401,"_34307":85169,"_23429":144587,"_5":16198,"_30870":144026,"_3543":144588},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_4098":85402,"_34307":85169,"_23429":144590,"_5":16198,"_30870":144026,"_3543":144591},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_4098":85403,"_34307":85169,"_23429":144593,"_5":16198,"_30870":144026,"_3543":144594},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_4098":85404,"_34307":85169,"_23429":144596,"_5":16198,"_30870":144026,"_3543":144597},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_4098":85405,"_34307":85169,"_23429":144599,"_5":16198,"_30870":144026,"_3543":144600},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_4098":85406,"_34307":85169,"_23429":144602,"_5":16198,"_30870":144026,"_3543":144603},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_4098":85407,"_34307":85169,"_23429":144605,"_5":16198,"_30870":144026,"_3543":144606},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_4098":85408,"_34307":85169,"_23429":144608,"_5":16198,"_30870":144026,"_3543":144609},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_4098":85409,"_34307":85169,"_23429":144611,"_5":16198,"_30870":144026,"_3543":144612},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_certificate_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_4098":85410,"_34307":85169,"_23429":144614,"_5":16198,"_30870":144026,"_3543":144615},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_4098":85411,"_34307":85169,"_23429":144617,"_5":16198,"_30870":144029,"_3543":144618},[],"Tras la actualización, comprueba en este orden:",{"_4098":85412,"_34307":85169,"_23429":144620,"_5":16198,"_30870":144029,"_3543":144621},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_4098":85413,"_34307":85169,"_23429":144623,"_5":16198,"_30870":144029,"_3543":144624},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_4098":85414,"_34307":85169,"_23429":144626,"_5":16198,"_30870":144029,"_3543":144627},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_4098":85415,"_34307":85169,"_23429":144629,"_5":16198,"_30870":144029,"_3543":144630},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_4098":85416,"_34307":85169,"_23429":144632,"_5":16198,"_30870":144029,"_3543":144633},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_4098":85417,"_34307":85169,"_23429":144635,"_5":16198,"_30870":144029,"_3543":144636},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_4098":85418,"_34307":85169,"_23429":144638,"_5":16198,"_30870":144029,"_3543":144639},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_4098":85419,"_34307":85169,"_23429":144641,"_5":16198,"_30870":144029,"_3543":144642},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_4098":85420,"_34307":85169,"_23429":144644,"_5":16198,"_30870":144029,"_3543":144645},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_4098":85421,"_34307":85169,"_23429":144647,"_5":16198,"_30870":144029,"_3543":144648},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_4098":85422,"_34307":85169,"_23429":144650,"_5":16198,"_30870":144029,"_3543":144651},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_4098":85423,"_34307":85169,"_23429":144653,"_5":16198,"_30870":144029,"_3543":144654},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_4098":85424,"_34307":85169,"_23429":144656,"_5":16198,"_30870":144029,"_3543":144657},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_4098":85425,"_34307":85169,"_23429":144659,"_5":16198,"_30870":144029,"_3543":144660},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_4098":85426,"_34307":85169,"_23429":144662,"_5":16198,"_30870":144033,"_3543":144663},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_4098":85427,"_34307":85169,"_23429":144665,"_5":16198,"_30870":144033,"_3543":144666},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_4098":85428,"_34307":85169,"_23429":144668,"_5":16198,"_30870":144033,"_3543":144669},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_4098":85429,"_34307":85169,"_23429":144671,"_5":16198,"_30870":144033,"_3543":144672},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_4098":85430,"_34307":85169,"_23429":144674,"_5":16198,"_30870":144033,"_3543":144675},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_67785":144677,"_67786":144678,"_67788":144679,"_67790":144680,"_20308":3560,"_81901":3560},"spanish",[3543,34307,5,30870],{"_3543":28013,"_34307":28013,"_5":28013,"_30870":28013},{"_3543":144681,"_34307":148207,"_5":151733,"_30870":155259},{"_5377":144682,"_67794":144683,"_5":28013},{"_11645":7533,"_11806":3923,"_11743":11020,"_11596":12647,"_11935":3822,"_11605":5272,"_11636":6839,"_11617":8609,"_29450":9273,"_33356":5102,"_33390":33464,"_32852":6433,"_33456":3667,"_33039":8470,"_33462":15768,"_33424":8091,"_33468":16857,"_33473":7496,"_33414":10156,"_34051":12