3":64391,"_44375":64394,"_44377":64397,"_44379":64400,"_44381":64403,"_44383":64406,"_44385":64409,"_44387":64412,"_44389":64415,"_44391":64418,"_44393":64421,"_44395":64424,"_44397":64427,"_44399":64430,"_44401":64433,"_44403":64436,"_44405":64439,"_44407":64442,"_44409":64445,"_44411":64448,"_44413":64451,"_44415":64454,"_44417":64457,"_44419":64460},{"_3839":15,"_33145":15,"_5":15996,"_3292":54322,"_33551":54323,"_22633":54327,"_29869":15},"Deploy from AWS Marketplace",[54324,54325,54326],"Docs","Deployment","Other models",[],{"_3839":16,"_33145":15,"_22633":54329,"_5":15597,"_29869":15,"_3292":54330},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3839":17,"_33145":15,"_5":33548,"_22633":54332,"_29869":54333,"_3292":54334},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3839":18,"_33145":15,"_5":33548,"_22633":54336,"_29869":54337,"_3292":54338},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3839":19,"_33145":15,"_5":33548,"_22633":54340,"_29869":54341,"_3292":54342},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3839":20,"_33145":15,"_5":33548,"_22633":54344,"_29869":54345,"_3292":54346},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3839":21,"_33145":15,"_5":33548,"_22633":54348,"_29869":54349,"_3292":54350},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3839":22,"_33145":15,"_5":33548,"_22633":54352,"_29869":54353,"_3292":54354},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3839":23,"_33145":15,"_5":33548,"_22633":54356,"_29869":54357,"_3292":54358},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#next-step","Next step",{"_3839":24,"_33145":15,"_22633":54360,"_5":15597,"_29869":15,"_3292":54361},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3839":25,"_33145":15,"_22633":54363,"_5":15597,"_29869":54333,"_3292":54364},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3839":26,"_33145":15,"_22633":54366,"_5":15597,"_29869":54333,"_3292":54367},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3839":27,"_33145":15,"_22633":54369,"_5":15597,"_29869":54333,"_3292":54370},[],"A security group allowing the necessary endpoints.",{"_3839":28,"_33145":15,"_22633":54372,"_5":15597,"_29869":54337,"_3292":54373},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3839":29,"_33145":15,"_22633":54375,"_5":15597,"_29869":54337,"_3292":54376},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3839":30,"_33145":15,"_22633":54378,"_5":15597,"_29869":54337,"_3292":54379},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3839":31,"_33145":15,"_22633":54381,"_5":15597,"_29869":54341,"_3292":54382},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3839":32,"_33145":15,"_22633":54384,"_5":15597,"_29869":54345,"_3292":54385},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3839":33,"_33145":15,"_22633":54387,"_5":15597,"_29869":54349,"_3292":54388},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3839":34,"_33145":15,"_22633":54390,"_5":15597,"_29869":54353,"_3292":54391},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3839":35,"_33145":15,"_22633":54393,"_5":15597,"_29869":54357,"_3292":54394},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3839":36,"_33145":36,"_5":15996,"_3292":54396,"_33551":54397,"_22633":54398,"_29869":36},"Deploy Lamassu",[54324,54325],[],{"_3839":37,"_33145":36,"_22633":54400,"_5":15597,"_29869":36,"_3292":54401},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3839":38,"_33145":36,"_5":33548,"_22633":54403,"_29869":54404,"_3292":54405},[],"/docs/pr-preview/pr-58/deployment/overview#choose-a-model","Choose a model",{"_3839":39,"_33145":36,"_5":33548,"_22633":54407,"_29869":54408,"_3292":54409},[],"/docs/pr-preview/pr-58/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3839":40,"_33145":36,"_5":33548,"_22633":54411,"_29869":54412,"_3292":54413},[],"/docs/pr-preview/pr-58/deployment/overview#after-deployment","After deployment",{"_3839":41,"_33145":36,"_22633":54415,"_5":15597,"_29869":36,"_3292":54416},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3839":42,"_33145":36,"_22633":54418,"_5":15597,"_29869":54404,"_3292":54419},[],"Model",{"_3839":43,"_33145":36,"_22633":54421,"_5":15597,"_29869":54404,"_3292":54422},[],"Recommended for",{"_3839":44,"_33145":36,"_22633":54424,"_5":15597,"_29869":54404,"_3292":54425},[],"Who operates the infrastructure",{"_3839":45,"_33145":36,"_22633":54427,"_5":15597,"_29869":54404,"_3292":54428},[],"Starting point",{"_3839":46,"_33145":36,"_22633":54430,"_5":15597,"_29869":54404,"_3292":54431},[],"Kubernetes self-managed",{"_3839":47,"_33145":36,"_22633":54433,"_5":15597,"_29869":54404,"_3292":54434},[],"Production, regulated environments and custom deployments",{"_3839":48,"_33145":36,"_22633":54436,"_5":15597,"_29869":54404,"_3292":54437},[],"Your team",{"_3839":49,"_33145":36,"_22633":54439,"_5":15597,"_29869":54404,"_3292":54440},[],"Helm or Fastlane",{"_3839":50,"_33145":36,"_22633":54442,"_5":15597,"_29869":54404,"_3292":54443},[],"AWS Marketplace",{"_3839":51,"_33145":36,"_22633":54445,"_5":15597,"_29869":54404,"_3292":54446},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3839":52,"_33145":36,"_22633":54448,"_5":15597,"_29869":54404,"_3292":54437},[],{"_3839":53,"_33145":36,"_22633":54450,"_5":15597,"_29869":54404,"_3292":54451},[],"Preconfigured image on EC2",{"_3839":54,"_33145":36,"_22633":54453,"_5":15597,"_29869":54404,"_3292":54454},[],"SaaS",{"_3839":55,"_33145":36,"_22633":54456,"_5":15597,"_29869":54404,"_3292":54457},[],"Teams that want to use the platform without operating it",{"_3839":56,"_33145":36,"_22633":54459,"_5":15597,"_29869":54404,"_3292":54460},[],"Lamassu",{"_3839":57,"_33145":36,"_22633":54462,"_5":15597,"_29869":54404,"_3292":54463},[],"Managed subscription",{"_3839":58,"_33145":36,"_22633":54465,"_5":15597,"_29869":54404,"_3292":54466},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3839":59,"_33145":36,"_22633":54468,"_5":15597,"_29869":54404,"_3292":54469},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3839":60,"_33145":36,"_22633":54471,"_5":15597,"_29869":54404,"_3292":54472},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3839":61,"_33145":36,"_22633":54474,"_5":15597,"_29869":54408,"_3292":54475},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3839":62,"_33145":36,"_22633":54477,"_5":15597,"_29869":54412,"_3292":54478},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3839":63,"_33145":63,"_5":15996,"_3292":54480,"_33551":54481,"_22633":54482,"_29869":63},"Use Lamassu as SaaS",[54324,54325,54326],[],{"_3839":64,"_33145":63,"_22633":54484,"_5":15597,"_29869":63,"_3292":54485},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3839":65,"_33145":63,"_5":33548,"_22633":54487,"_29869":54488,"_3292":54489},[],"/docs/pr-preview/pr-58/deployment/saas#what-the-service-manages","What the service manages",{"_3839":66,"_33145":63,"_5":33548,"_22633":54491,"_29869":54492,"_3292":54493},[],"/docs/pr-preview/pr-58/deployment/saas#plans","Plans",{"_3839":67,"_33145":63,"_5":33548,"_22633":54495,"_29869":54496,"_3292":54497},[],"/docs/pr-preview/pr-58/deployment/saas#request-access","Request access",{"_3839":68,"_33145":63,"_22633":54499,"_5":15597,"_29869":63,"_3292":54500},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3839":69,"_33145":63,"_22633":54502,"_5":15597,"_29869":54488,"_3292":54503},[],"Platform availability and maintenance.",{"_3839":70,"_33145":63,"_22633":54505,"_5":15597,"_29869":54488,"_3292":54506},[],"Automatic backups.",{"_3839":71,"_33145":63,"_22633":54508,"_5":15597,"_29869":54488,"_3292":54509},[],"Version upgrades.",{"_3839":72,"_33145":63,"_22633":54511,"_5":15597,"_29869":54488,"_3292":54512},[],"Technical support and SLA according to your plan.",{"_3839":73,"_33145":63,"_22633":54514,"_5":15597,"_29869":54492,"_3292":54515},[],"Plan",{"_3839":74,"_33145":63,"_22633":54517,"_5":15597,"_29869":54492,"_3292":54518},[],"Devices",{"_3839":75,"_33145":63,"_22633":54520,"_5":15597,"_29869":54492,"_3292":54521},[],"Support",{"_3839":76,"_33145":63,"_22633":54523,"_5":15597,"_29869":54492,"_3292":54524},[],"SLA",{"_3839":77,"_33145":63,"_22633":54526,"_5":15597,"_29869":54492,"_3292":54527},[],"Starter",{"_3839":78,"_33145":63,"_22633":54529,"_5":15597,"_29869":54492,"_3292":54530},[],"Up to 1,000",{"_3839":79,"_33145":63,"_22633":54532,"_5":15597,"_29869":54492,"_3292":54533},[],"Email",{"_3839":80,"_33145":63,"_22633":54535,"_5":15597,"_29869":54492,"_3292":54536},[],"99.5 %",{"_3839":81,"_33145":63,"_22633":54538,"_5":15597,"_29869":54492,"_3292":54539},[],"Professional",{"_3839":82,"_33145":63,"_22633":54541,"_5":15597,"_29869":54492,"_3292":54542},[],"Up to 10,000",{"_3839":83,"_33145":63,"_22633":54544,"_5":15597,"_29869":54492,"_3292":54545},[],"Email and chat",{"_3839":84,"_33145":63,"_22633":54547,"_5":15597,"_29869":54492,"_3292":54548},[],"99.9 %",{"_3839":85,"_33145":63,"_22633":54550,"_5":15597,"_29869":54492,"_3292":54551},[],"Enterprise",{"_3839":86,"_33145":63,"_22633":54553,"_5":15597,"_29869":54492,"_3292":54554},[],"Unlimited",{"_3839":87,"_33145":63,"_22633":54556,"_5":15597,"_29869":54492,"_3292":54557},[],"Dedicated",{"_3839":88,"_33145":63,"_22633":54559,"_5":15597,"_29869":54492,"_3292":54560},[],"99.99 %",{"_3839":89,"_33145":63,"_22633":54562,"_5":15597,"_29869":54496,"_3292":54563},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3839":90,"_33145":63,"_22633":54565,"_5":15597,"_29869":54496,"_3292":54566},[],"When you receive your instance's credentials, continue with Get started.",{"_3839":91,"_33145":91,"_5":15996,"_3292":54568,"_33551":54569,"_22633":54570,"_29869":91},"Fastlane",[54324,54325,54431],[],{"_3839":92,"_33145":91,"_22633":54572,"_5":15597,"_29869":91,"_3292":54573},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3839":93,"_33145":91,"_5":33548,"_22633":54575,"_29869":54576,"_3292":54577},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3839":94,"_33145":91,"_5":33548,"_22633":54579,"_29869":54580,"_3292":54581},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3839":95,"_33145":91,"_5":33548,"_22633":54583,"_29869":54584,"_3292":54334},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#before-you-begin",{"_3839":96,"_33145":91,"_5":33548,"_22633":54586,"_29869":54587,"_3292":54588},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3839":97,"_33145":91,"_5":33548,"_22633":54590,"_29869":54591,"_3292":54592},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3839":98,"_33145":91,"_5":33548,"_22633":54594,"_29869":54595,"_3292":54596},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3839":99,"_33145":91,"_5":33548,"_22633":54598,"_29869":54599,"_3292":54600},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3839":100,"_33145":91,"_5":33548,"_22633":54602,"_29869":54603,"_3292":54604},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3839":101,"_33145":91,"_5":33548,"_22633":54606,"_29869":54607,"_3292":54608},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3839":102,"_33145":91,"_5":33548,"_22633":54610,"_29869":54611,"_3292":54612},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3839":103,"_33145":91,"_5":33548,"_22633":54614,"_29869":54615,"_3292":54616},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3839":104,"_33145":91,"_22633":54618,"_5":15597,"_29869":54576,"_3292":54619},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3839":105,"_33145":91,"_22633":54621,"_5":15597,"_29869":54576,"_3292":54622},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3839":106,"_33145":91,"_22633":54624,"_5":15597,"_29869":54580,"_3292":54625},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3839":107,"_33145":91,"_22633":54627,"_5":15597,"_29869":54580,"_3292":54628},[],"Fastlane installs or configures",{"_3839":108,"_33145":91,"_22633":54630,"_5":15597,"_29869":54580,"_3292":54631},[],"You still provide",{"_3839":109,"_33145":91,"_22633":54633,"_5":15597,"_29869":54580,"_3292":54634},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3839":110,"_33145":91,"_22633":54636,"_5":15597,"_29869":54580,"_3292":54637},[],"The Kubernetes cluster, nodes and persistent storage",{"_3839":111,"_33145":91,"_22633":54639,"_5":15597,"_29869":54580,"_3292":54640},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3839":112,"_33145":91,"_22633":54642,"_5":15597,"_29869":54580,"_3292":54643},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3839":113,"_33145":91,"_22633":54645,"_5":15597,"_29869":54580,"_3292":54646},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3839":114,"_33145":91,"_22633":54648,"_5":15597,"_29869":54580,"_3292":54649},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3839":115,"_33145":91,"_22633":54651,"_5":15597,"_29869":54580,"_3292":54652},[],"Optional observability and lab HSM components",{"_3839":116,"_33145":91,"_22633":54654,"_5":15597,"_29869":54580,"_3292":54655},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3839":117,"_33145":91,"_22633":54657,"_5":15597,"_29869":54580,"_3292":54658},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3839":118,"_33145":91,"_22633":54660,"_5":15597,"_29869":54584,"_3292":54661},[],"You need:",{"_3839":119,"_33145":91,"_22633":54663,"_5":15597,"_29869":54584,"_3292":54664},[],"an existing Kubernetes cluster",{"_3839":120,"_33145":91,"_22633":54666,"_5":15597,"_29869":54584,"_3292":54667},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3839":121,"_33145":91,"_22633":54669,"_5":15597,"_29869":54584,"_3292":54670},[],"`yq`",{"_3839":122,"_33145":91,"_22633":54672,"_5":15597,"_29869":54584,"_3292":25674},[],{"_3839":123,"_33145":91,"_22633":54674,"_5":15597,"_29869":54584,"_3292":54675},[],"`jq` only when using `--sample-data` or `--development`",{"_3839":124,"_33145":91,"_22633":54677,"_5":15597,"_29869":54584,"_3292":54678},[],"`ssh-keygen` only when using `--with-hsm`",{"_3839":125,"_33145":91,"_22633":54680,"_5":15597,"_29869":54584,"_3292":54681},[],"free external ports 80 and 443 on a single-node K3s host",{"_3839":126,"_33145":91,"_22633":54683,"_5":15597,"_29869":54584,"_3292":54684},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3839":127,"_33145":91,"_22633":54686,"_5":15597,"_29869":54584,"_3292":54687},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3839":128,"_33145":91,"_22633":54689,"_5":15597,"_29869":54587,"_3292":54690},[],"Run the script from a clone of the Helm repository:",{"_3839":129,"_33145":91,"_22633":54692,"_5":15597,"_29869":54587,"_3292":54693},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3839":130,"_33145":91,"_22633":54695,"_5":15597,"_29869":54591,"_3292":54696},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3839":131,"_33145":91,"_22633":54698,"_5":15597,"_29869":54591,"_3292":54699},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3839":132,"_33145":91,"_22633":54701,"_5":15597,"_29869":54591,"_3292":54702},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3839":133,"_33145":91,"_22633":54704,"_5":15597,"_29869":54591,"_3292":54705},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3839":134,"_33145":91,"_22633":54707,"_5":15597,"_29869":54595,"_3292":54708},[],"Option",{"_3839":135,"_33145":91,"_22633":54710,"_5":15597,"_29869":54595,"_3292":54711},[],"Default",{"_3839":136,"_33145":91,"_22633":54713,"_5":15597,"_29869":54595,"_3292":54714},[],"Purpose",{"_3839":137,"_33145":91,"_22633":54716,"_5":15597,"_29869":54595,"_3292":54717},[],"`-h`, `--help`",{"_3839":138,"_33145":91,"_22633":54719,"_5":15597,"_29869":54595,"_3292":54720},[],"—",{"_3839":139,"_33145":91,"_22633":54722,"_5":15597,"_29869":54595,"_3292":54723},[],"Show help",{"_3839":140,"_33145":91,"_22633":54725,"_5":15597,"_29869":54595,"_3292":54726},[],"`-c`, `--context`",{"_3839":141,"_33145":91,"_22633":54728,"_5":15597,"_29869":54595,"_3292":54729},[],"current context",{"_3839":142,"_33145":91,"_22633":54731,"_5":15597,"_29869":54595,"_3292":54732},[],"Select the kubeconfig context for kubectl and Helm",{"_3839":143,"_33145":91,"_22633":54734,"_5":15597,"_29869":54595,"_3292":54735},[],"`-n`, `--non-interactive`",{"_3839":144,"_33145":91,"_22633":54737,"_5":15597,"_29869":54595,"_3292":7105},[],{"_3839":145,"_33145":91,"_22633":54739,"_5":15597,"_29869":54595,"_3292":54740},[],"Skip prompts and generate dependency credentials",{"_3839":146,"_33145":91,"_22633":54742,"_5":15597,"_29869":54595,"_3292":54743},[],"`-ns`, `--namespace`",{"_3839":147,"_33145":91,"_22633":54745,"_5":15597,"_29869":54595,"_3292":54746},[],"`lamassu-dev`",{"_3839":148,"_33145":91,"_22633":54748,"_5":15597,"_29869":54595,"_3292":54749},[],"Namespace for the installation",{"_3839":149,"_33145":91,"_22633":54751,"_5":15597,"_29869":54595,"_3292":54752},[],"`-d`, `--domain`",{"_3839":150,"_33145":91,"_22633":54754,"_5":15597,"_29869":54595,"_3292":54755},[],"`dev.lamassu.io`",{"_3839":151,"_33145":91,"_22633":54757,"_5":15597,"_29869":54595,"_3292":54758},[],"Domain used by the UI, OIDC and certificate",{"_3839":152,"_33145":91,"_22633":54760,"_5":15597,"_29869":54595,"_3292":54761},[],"`-v`, `--version`",{"_3839":153,"_33145":91,"_22633":54763,"_5":15597,"_29869":54595,"_3292":16393},[],{"_3839":154,"_33145":91,"_22633":54765,"_5":15597,"_29869":54595,"_3292":54766},[],"Lamassu chart version",{"_3839":155,"_33145":91,"_22633":54768,"_5":15597,"_29869":54595,"_3292":54769},[],"`--https-port`",{"_3839":156,"_33145":91,"_22633":54771,"_5":15597,"_29869":54595,"_3292":54772},[],"`443`",{"_3839":157,"_33145":91,"_22633":54774,"_5":15597,"_29869":54595,"_3292":54775},[],"Gateway HTTPS listener port",{"_3839":158,"_33145":91,"_22633":54777,"_5":15597,"_29869":54595,"_3292":54778},[],"`--http-port`",{"_3839":159,"_33145":91,"_22633":54780,"_5":15597,"_29869":54595,"_3292":54781},[],"`80`",{"_3839":160,"_33145":91,"_22633":54783,"_5":15597,"_29869":54595,"_3292":54784},[],"Gateway HTTP listener port",{"_3839":161,"_33145":91,"_22633":54786,"_5":15597,"_29869":54595,"_3292":54787},[],"`--tls-crt`",{"_3839":162,"_33145":91,"_22633":54789,"_5":15597,"_29869":54595,"_3292":54720},[],{"_3839":163,"_33145":91,"_22633":54791,"_5":15597,"_29869":54595,"_3292":54792},[],"PEM certificate for downstream TLS",{"_3839":164,"_33145":91,"_22633":54794,"_5":15597,"_29869":54595,"_3292":54795},[],"`--tls-key`",{"_3839":165,"_33145":91,"_22633":54797,"_5":15597,"_29869":54595,"_3292":54720},[],{"_3839":166,"_33145":91,"_22633":54799,"_5":15597,"_29869":54595,"_3292":54800},[],"PEM private key for downstream TLS",{"_3839":167,"_33145":91,"_22633":54802,"_5":15597,"_29869":54595,"_3292":54803},[],"`-l`, `--local-chart-path`",{"_3839":168,"_33145":91,"_22633":54805,"_5":15597,"_29869":54595,"_3292":54806},[],"repository chart",{"_3839":169,"_33145":91,"_22633":54808,"_5":15597,"_29869":54595,"_3292":54809},[],"Use an unpacked local Lamassu chart",{"_3839":170,"_33145":91,"_22633":54811,"_5":15597,"_29869":54595,"_3292":54812},[],"`-ip`, `--gateway-ip`",{"_3839":171,"_33145":91,"_22633":54814,"_5":15597,"_29869":54595,"_3292":9430},[],{"_3839":172,"_33145":91,"_22633":54816,"_5":15597,"_29869":54595,"_3292":54817},[],"Override the address written to `gateway.addresses`",{"_3839":173,"_33145":91,"_22633":54819,"_5":15597,"_29869":54595,"_3292":54820},[],"`--otel`",{"_3839":174,"_33145":91,"_22633":54822,"_5":15597,"_29869":54595,"_3292":7105},[],{"_3839":175,"_33145":91,"_22633":54824,"_5":15597,"_29869":54595,"_3292":54825},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3839":176,"_33145":91,"_22633":54827,"_5":15597,"_29869":54595,"_3292":54828},[],"`--development`",{"_3839":177,"_33145":91,"_22633":54830,"_5":15597,"_29869":54595,"_3292":7105},[],{"_3839":178,"_33145":91,"_22633":54832,"_5":15597,"_29869":54595,"_3292":54833},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3839":179,"_33145":91,"_22633":54835,"_5":15597,"_29869":54595,"_3292":54836},[],"`--sample-data`",{"_3839":180,"_33145":91,"_22633":54838,"_5":15597,"_29869":54595,"_3292":7105},[],{"_3839":181,"_33145":91,"_22633":54840,"_5":15597,"_29869":54595,"_3292":54841},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3839":182,"_33145":91,"_22633":54843,"_5":15597,"_29869":54595,"_3292":54844},[],"`--with-hsm`",{"_3839":183,"_33145":91,"_22633":54846,"_5":15597,"_29869":54595,"_3292":7105},[],{"_3839":184,"_33145":91,"_22633":54848,"_5":15597,"_29869":54595,"_3292":54849},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3839":185,"_33145":91,"_22633":54851,"_5":15597,"_29869":54595,"_3292":54852},[],"`--softhsm-chart-path`",{"_3839":186,"_33145":91,"_22633":54854,"_5":15597,"_29869":54595,"_3292":54855},[],"`./charts/softhsm`",{"_3839":187,"_33145":91,"_22633":54857,"_5":15597,"_29869":54595,"_3292":54858},[],"Use a different local SoftHSM chart",{"_3839":188,"_33145":91,"_22633":54860,"_5":15597,"_29869":54595,"_3292":54861},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3839":189,"_33145":91,"_22633":54863,"_5":15597,"_29869":54599,"_3292":54864},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3839":190,"_33145":91,"_22633":54866,"_5":15597,"_29869":54599,"_3292":54867},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3839":191,"_33145":91,"_22633":54869,"_5":15597,"_29869":54599,"_3292":54870},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3839":192,"_33145":91,"_22633":54872,"_5":15597,"_29869":54599,"_3292":54873},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3839":193,"_33145":91,"_22633":54875,"_5":15597,"_29869":54599,"_3292":54876},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3839":194,"_33145":91,"_22633":54878,"_5":15597,"_29869":54599,"_3292":54879},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3839":195,"_33145":91,"_22633":54881,"_5":15597,"_29869":54603,"_3292":54882},[],"Fastlane:",{"_3839":196,"_33145":91,"_22633":54884,"_5":15597,"_29869":54603,"_3292":54885},[],"validates local tools and the selected cluster",{"_3839":197,"_33145":91,"_22633":54887,"_5":15597,"_29869":54603,"_3292":54888},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3839":198,"_33145":91,"_22633":54890,"_5":15597,"_29869":54603,"_3292":54891},[],"creates the namespace",{"_3839":199,"_33145":91,"_22633":54893,"_5":15597,"_29869":54603,"_3292":54894},[],"installs PostgreSQL and creates the required databases",{"_3839":200,"_33145":91,"_22633":54896,"_5":15597,"_29869":54603,"_3292":54897},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3839":201,"_33145":91,"_22633":54899,"_5":15597,"_29869":54603,"_3292":54900},[],"installs RabbitMQ",{"_3839":202,"_33145":91,"_22633":54902,"_5":15597,"_29869":54603,"_3292":54903},[],"optionally installs observability and lab HSM components",{"_3839":203,"_33145":91,"_22633":54905,"_5":15597,"_29869":54603,"_3292":54906},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3839":204,"_33145":91,"_22633":54908,"_5":15597,"_29869":54603,"_3292":54909},[],"optionally loads sample data",{"_3839":205,"_33145":91,"_22633":54911,"_5":15597,"_29869":54603,"_3292":54912},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3839":206,"_33145":91,"_22633":54914,"_5":15597,"_29869":54607,"_3292":54915},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3839":207,"_33145":91,"_22633":54917,"_5":15597,"_29869":54607,"_3292":54918},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3839":208,"_33145":91,"_22633":54920,"_5":15597,"_29869":54611,"_3292":54921},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3839":209,"_33145":91,"_22633":54923,"_5":15597,"_29869":54611,"_3292":54924},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3839":210,"_33145":91,"_22633":54926,"_5":15597,"_29869":54611,"_3292":54927},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3839":211,"_33145":91,"_22633":54929,"_5":15597,"_29869":54615,"_3292":54930},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3839":212,"_33145":212,"_5":15996,"_3292":54932,"_33551":54933,"_22633":54934,"_29869":212},"Install with Helm",[54324,54325,54431],[],{"_3839":213,"_33145":212,"_22633":54936,"_5":15597,"_29869":212,"_3292":54937},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3839":214,"_33145":212,"_5":33548,"_22633":54939,"_29869":54940,"_3292":54941},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3839":215,"_33145":212,"_5":33548,"_22633":54943,"_29869":54944,"_3292":54334},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#before-you-begin",{"_3839":216,"_33145":212,"_5":33548,"_22633":54946,"_29869":54947,"_3292":54948},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3839":217,"_33145":212,"_5":33548,"_22633":54950,"_29869":54951,"_3292":54952},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3839":218,"_33145":212,"_5":33548,"_22633":54954,"_29869":54955,"_3292":54956},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3839":219,"_33145":212,"_5":33548,"_22633":54958,"_29869":54959,"_3292":54960},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3839":220,"_33145":212,"_5":33548,"_22633":54962,"_29869":54963,"_3292":54964},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3839":221,"_33145":212,"_5":33548,"_22633":54966,"_29869":54967,"_3292":54968},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3839":222,"_33145":212,"_5":33548,"_22633":54970,"_29869":54971,"_3292":54972},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3839":223,"_33145":212,"_5":33548,"_22633":54974,"_29869":54975,"_3292":54976},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3839":224,"_33145":212,"_5":33548,"_22633":54978,"_29869":54979,"_3292":54980},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3839":225,"_33145":212,"_22633":54982,"_5":15597,"_29869":54940,"_3292":54983},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3839":226,"_33145":212,"_22633":54985,"_5":15597,"_29869":54944,"_3292":54986},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3839":227,"_33145":212,"_22633":54988,"_5":15597,"_29869":54944,"_3292":54989},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3839":228,"_33145":212,"_22633":54991,"_5":15597,"_29869":54944,"_3292":54992},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3839":229,"_33145":212,"_22633":54994,"_5":15597,"_29869":54944,"_3292":54995},[],"a reachable RabbitMQ broker and credentials",{"_3839":230,"_33145":212,"_22633":54997,"_5":15597,"_29869":54944,"_3292":54998},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3839":231,"_33145":212,"_22633":55000,"_5":15597,"_29869":54944,"_3292":55001},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3839":232,"_33145":212,"_22633":55003,"_5":15597,"_29869":54944,"_3292":55004},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3839":233,"_33145":212,"_22633":55006,"_5":15597,"_29869":54944,"_3292":55007},[],"a StorageClass and an external traffic design",{"_3839":234,"_33145":212,"_22633":55009,"_5":15597,"_29869":54944,"_3292":55010},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3839":235,"_33145":212,"_22633":55012,"_5":15597,"_29869":54944,"_3292":55013},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3839":236,"_33145":212,"_22633":55015,"_5":15597,"_29869":54944,"_3292":55016},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3839":237,"_33145":212,"_22633":55018,"_5":15597,"_29869":54947,"_3292":55019},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3839":238,"_33145":212,"_22633":55021,"_5":15597,"_29869":54947,"_3292":55022},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3839":239,"_33145":212,"_22633":55024,"_5":15597,"_29869":54947,"_3292":55025},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3839":240,"_33145":212,"_22633":55027,"_5":15597,"_29869":54951,"_3292":55028},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3839":241,"_33145":212,"_22633":55030,"_5":15597,"_29869":54951,"_3292":55031},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3839":242,"_33145":212,"_22633":55033,"_5":15597,"_29869":54951,"_3292":55034},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3839":243,"_33145":212,"_22633":55036,"_5":15597,"_29869":54951,"_3292":55037},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3839":244,"_33145":212,"_22633":55039,"_5":15597,"_29869":54955,"_3292":55040},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3839":245,"_33145":212,"_22633":55042,"_5":15597,"_29869":54959,"_3292":55043},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3839":246,"_33145":212,"_22633":55045,"_5":15597,"_29869":54959,"_3292":55046},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3839":247,"_33145":212,"_22633":55048,"_5":15597,"_29869":54959,"_3292":55049},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3839":248,"_33145":212,"_22633":55051,"_5":15597,"_29869":54959,"_3292":55052},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3839":249,"_33145":212,"_22633":55054,"_5":15597,"_29869":54959,"_3292":55055},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3839":250,"_33145":212,"_22633":55057,"_5":15597,"_29869":54959,"_3292":55058},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3839":251,"_33145":212,"_22633":55060,"_5":15597,"_29869":54959,"_3292":55061},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3839":252,"_33145":212,"_22633":55063,"_5":15597,"_29869":54963,"_3292":55064},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3839":253,"_33145":212,"_22633":55066,"_5":15597,"_29869":54963,"_3292":55067},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3839":254,"_33145":212,"_22633":55069,"_5":15597,"_29869":54963,"_3292":55070},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3839":255,"_33145":212,"_22633":55072,"_5":15597,"_29869":54963,"_3292":55073},[],"See Access control for the principal and policy model.",{"_3839":256,"_33145":212,"_22633":55075,"_5":15597,"_29869":54967,"_3292":55076},[],"To install a local checkout instead:",{"_3839":257,"_33145":212,"_22633":55078,"_5":15597,"_29869":54971,"_3292":55079},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3839":258,"_33145":212,"_22633":55081,"_5":15597,"_29869":54971,"_3292":55082},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3839":259,"_33145":212,"_22633":55084,"_5":15597,"_29869":54975,"_3292":55085},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3839":260,"_33145":212,"_22633":55087,"_5":15597,"_29869":54975,"_3292":55088},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3839":261,"_33145":212,"_22633":55090,"_5":15597,"_29869":54975,"_3292":55091},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3839":262,"_33145":212,"_22633":55093,"_5":15597,"_29869":54975,"_3292":55094},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3839":263,"_33145":212,"_22633":55096,"_5":15597,"_29869":54975,"_3292":55097},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3839":264,"_33145":212,"_22633":55099,"_5":15597,"_29869":54979,"_3292":55100},[],"Before going live, review:",{"_3839":265,"_33145":212,"_22633":55102,"_5":15597,"_29869":54979,"_3292":55103},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3839":266,"_33145":212,"_22633":55105,"_5":15597,"_29869":54979,"_3292":55106},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3839":267,"_33145":212,"_22633":55108,"_5":15597,"_29869":54979,"_3292":55109},[],"shared VA storage before increasing VA replicas",{"_3839":268,"_33145":212,"_22633":55111,"_5":15597,"_29869":54979,"_3292":55112},[],"managed OIDC roles and removal of evaluation credentials",{"_3839":269,"_33145":212,"_22633":55114,"_5":15597,"_29869":54979,"_3292":55115},[],"a trusted TLS issuer or externally managed certificate",{"_3839":270,"_33145":212,"_22633":55117,"_5":15597,"_29869":54979,"_3292":55118},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3839":271,"_33145":212,"_22633":55120,"_5":15597,"_29869":54979,"_3292":55121},[],"SMTP, observability and alert delivery",{"_3839":272,"_33145":212,"_22633":55123,"_5":15597,"_29869":54979,"_3292":55124},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3839":273,"_33145":212,"_22633":55126,"_5":15597,"_29869":54979,"_3292":55127},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3839":274,"_33145":274,"_5":15996,"_3292":55129,"_33551":55130,"_22633":55131,"_29869":274},"Expose the Gateway",[54324,54325,54431],[],{"_3839":275,"_33145":274,"_22633":55133,"_5":15597,"_29869":274,"_3292":55134},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3839":276,"_33145":274,"_5":33548,"_22633":55136,"_29869":55137,"_3292":55138},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3839":277,"_33145":274,"_5":33548,"_22633":55140,"_29869":55141,"_3292":55142},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3839":278,"_33145":274,"_5":33548,"_22633":55144,"_29869":55145,"_3292":55146},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3839":279,"_33145":274,"_5":33548,"_22633":55148,"_29869":55149,"_3292":55150},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#k3s","K3s",{"_3839":280,"_33145":274,"_5":33548,"_22633":55152,"_29869":55153,"_3292":55154},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3839":281,"_33145":274,"_5":33548,"_22633":55156,"_29869":55157,"_3292":55158},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3839":282,"_33145":274,"_5":33548,"_22633":55160,"_29869":55161,"_3292":55162},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3839":283,"_33145":274,"_5":33548,"_22633":55164,"_29869":55165,"_3292":55166},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3839":284,"_33145":274,"_5":33548,"_22633":55168,"_29869":55169,"_3292":55170},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3839":285,"_33145":274,"_5":33548,"_22633":55172,"_29869":55173,"_3292":55174},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3839":286,"_33145":274,"_22633":55176,"_5":15597,"_29869":55137,"_3292":55177},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3839":287,"_33145":274,"_22633":55179,"_5":15597,"_29869":55137,"_3292":55180},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3839":288,"_33145":274,"_22633":55182,"_5":15597,"_29869":55141,"_3292":55183},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3839":289,"_33145":274,"_22633":55185,"_5":15597,"_29869":55141,"_3292":55186},[],"Set it only when:",{"_3839":290,"_33145":274,"_22633":55188,"_5":15597,"_29869":55141,"_3292":55189},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3839":291,"_33145":274,"_22633":55191,"_5":15597,"_29869":55141,"_3292":55192},[],"that address is allocated to this Gateway",{"_3839":292,"_33145":274,"_22633":55194,"_5":15597,"_29869":55141,"_3292":55195},[],"the surrounding network already routes traffic for it to the cluster",{"_3839":293,"_33145":274,"_22633":55197,"_5":15597,"_29869":55141,"_3292":55198},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3839":294,"_33145":274,"_22633":55200,"_5":15597,"_29869":55141,"_3292":55201},[],"Keep these two settings separate:",{"_3839":295,"_33145":274,"_22633":55203,"_5":15597,"_29869":55141,"_3292":55204},[],"`gateway.addresses` requests an address for the Gateway.",{"_3839":296,"_33145":274,"_22633":55206,"_5":15597,"_29869":55141,"_3292":55207},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3839":297,"_33145":274,"_22633":55209,"_5":15597,"_29869":55141,"_3292":55210},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3839":298,"_33145":274,"_22633":55212,"_5":15597,"_29869":55145,"_3292":55213},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3839":299,"_33145":274,"_22633":55215,"_5":15597,"_29869":55145,"_3292":55216},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3839":300,"_33145":274,"_22633":55218,"_5":15597,"_29869":55149,"_3292":55219},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3839":301,"_33145":274,"_22633":55221,"_5":15597,"_29869":55149,"_3292":55222},[],"For the recommended design:",{"_3839":302,"_33145":274,"_22633":55224,"_5":15597,"_29869":55149,"_3292":55225},[],"Use only one externally exposed Lamassu Gateway.",{"_3839":303,"_33145":274,"_22633":55227,"_5":15597,"_29869":55149,"_3292":55228},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3839":304,"_33145":274,"_22633":55230,"_5":15597,"_29869":55149,"_3292":55231},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3839":305,"_33145":274,"_22633":55233,"_5":15597,"_29869":55149,"_3292":55234},[],"Point DNS at the VM's reachable address.",{"_3839":306,"_33145":274,"_22633":55236,"_5":15597,"_29869":55149,"_3292":55237},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3839":307,"_33145":274,"_22633":55239,"_5":15597,"_29869":55153,"_3292":55240},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3839":308,"_33145":274,"_22633":55242,"_5":15597,"_29869":55157,"_3292":55243},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3839":309,"_33145":274,"_22633":55245,"_5":15597,"_29869":55157,"_3292":55246},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3839":310,"_33145":274,"_22633":55248,"_5":15597,"_29869":55161,"_3292":55249},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3839":311,"_33145":274,"_22633":55251,"_5":15597,"_29869":55161,"_3292":55252},[],"Requirement",{"_3839":312,"_33145":274,"_22633":55254,"_5":15597,"_29869":55161,"_3292":55255},[],"Recommended design",{"_3839":313,"_33145":274,"_22633":55257,"_5":15597,"_29869":55161,"_3292":55258},[],"Consequence",{"_3839":314,"_33145":274,"_22633":55260,"_5":15597,"_29869":55161,"_3292":55261},[],"Several Lamassu URLs or services",{"_3839":315,"_33145":274,"_22633":55263,"_5":15597,"_29869":55161,"_3292":55264},[],"One Gateway with multiple routes",{"_3839":316,"_33145":274,"_22633":55266,"_5":15597,"_29869":55161,"_3292":55267},[],"One IP and one proxy fleet; this is the chart default",{"_3839":317,"_33145":274,"_22633":55269,"_5":15597,"_29869":55161,"_3292":55270},[],"Independent Gateways and separate external IPs",{"_3839":318,"_33145":274,"_22633":55272,"_5":15597,"_29869":55161,"_3292":55273},[],"One VIP per Gateway",{"_3839":319,"_33145":274,"_22633":55275,"_5":15597,"_29869":55161,"_3292":55276},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3839":320,"_33145":274,"_22633":55278,"_5":15597,"_29869":55161,"_3292":55279},[],"Independent Gateways on one node and one IP",{"_3839":321,"_33145":274,"_22633":55281,"_5":15597,"_29869":55161,"_3292":55282},[],"Use different external ports",{"_3839":322,"_33145":274,"_22633":55284,"_5":15597,"_29869":55161,"_3292":55285},[],"Clients must include non-standard ports",{"_3839":323,"_33145":274,"_22633":55287,"_5":15597,"_29869":55161,"_3292":55288},[],"Separate TLS/mTLS termination behind one IP",{"_3839":324,"_33145":274,"_22633":55290,"_5":15597,"_29869":55161,"_3292":55291},[],"Front-door SNI routing to internal Gateways",{"_3839":325,"_33145":274,"_22633":55293,"_5":15597,"_29869":55161,"_3292":55294},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3839":326,"_33145":274,"_22633":55296,"_5":15597,"_29869":55161,"_3292":55297},[],"Separate Gateway resources but shared proxy infrastructure",{"_3839":327,"_33145":274,"_22633":55299,"_5":15597,"_29869":55161,"_3292":55300},[],"Envoy merged-Gateway mode",{"_3839":328,"_33145":274,"_22633":55302,"_5":15597,"_29869":55161,"_3292":55303},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3839":329,"_33145":274,"_22633":55305,"_5":15597,"_29869":55161,"_3292":55306},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3839":330,"_33145":274,"_22633":55308,"_5":15597,"_29869":55161,"_3292":55309},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3839":331,"_33145":274,"_22633":55311,"_5":15597,"_29869":55161,"_3292":55312},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3839":332,"_33145":274,"_22633":55314,"_5":15597,"_29869":55161,"_3292":55315},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3839":333,"_33145":274,"_22633":55317,"_5":15597,"_29869":55165,"_3292":55318},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3839":334,"_33145":274,"_22633":55320,"_5":15597,"_29869":55165,"_3292":55321},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3839":335,"_33145":274,"_22633":55323,"_5":15597,"_29869":55165,"_3292":55324},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3839":336,"_33145":274,"_22633":55326,"_5":15597,"_29869":55165,"_3292":55327},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3839":337,"_33145":274,"_22633":55329,"_5":15597,"_29869":55165,"_3292":55330},[],"If none of those are possible, use different external ports or change the external network design.",{"_3839":338,"_33145":274,"_22633":55332,"_5":15597,"_29869":55169,"_3292":55333},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3839":339,"_33145":274,"_22633":55335,"_5":15597,"_29869":55169,"_3292":55336},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3839":340,"_33145":274,"_22633":55338,"_5":15597,"_29869":55173,"_3292":55339},[],"Check, in order:",{"_3839":341,"_33145":274,"_22633":55341,"_5":15597,"_29869":55173,"_3292":55342},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3839":342,"_33145":274,"_22633":55344,"_5":15597,"_29869":55173,"_3292":55345},[],"Its status contains the expected address.",{"_3839":343,"_33145":274,"_22633":55347,"_5":15597,"_29869":55173,"_3292":55348},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3839":344,"_33145":274,"_22633":55350,"_5":15597,"_29869":55173,"_3292":55351},[],"Port 443 reaches that address from the client network.",{"_3839":345,"_33145":274,"_22633":55353,"_5":15597,"_29869":55173,"_3292":55354},[],"DNS resolves to the externally reachable endpoint.",{"_3839":346,"_33145":274,"_22633":55356,"_5":15597,"_29869":55173,"_3292":55357},[],"The certificate contains the DNS name or IP used by the client.",{"_3839":347,"_33145":274,"_22633":55359,"_5":15597,"_29869":55173,"_3292":55360},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3839":348,"_33145":348,"_5":15996,"_3292":54431,"_33551":55362,"_22633":55363,"_29869":348},[54324,54325,54431],[],{"_3839":349,"_33145":348,"_22633":55365,"_5":15597,"_29869":348,"_3292":55366},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3839":350,"_33145":348,"_5":33548,"_22633":55368,"_29869":55369,"_3292":55370},[],"/docs/pr-preview/pr-58/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3839":351,"_33145":348,"_5":33548,"_22633":55372,"_29869":55373,"_3292":55374},[],"/docs/pr-preview/pr-58/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3839":352,"_33145":348,"_5":33548,"_22633":55376,"_29869":55377,"_3292":55378},[],"/docs/pr-preview/pr-58/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3839":353,"_33145":348,"_5":33548,"_22633":55380,"_29869":55381,"_3292":55382},[],"/docs/pr-preview/pr-58/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3839":354,"_33145":348,"_5":33548,"_22633":55384,"_29869":55385,"_3292":55386},[],"/docs/pr-preview/pr-58/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3839":355,"_33145":348,"_5":33548,"_22633":55388,"_29869":55389,"_3292":55390},[],"/docs/pr-preview/pr-58/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3839":356,"_33145":348,"_22633":55392,"_5":15597,"_29869":55369,"_3292":55393},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3839":357,"_33145":348,"_22633":55395,"_5":15597,"_29869":55373,"_3292":55396},[],"Workflow",{"_3839":358,"_33145":348,"_22633":55398,"_5":15597,"_29869":55373,"_3292":55399},[],"Use it for",{"_3839":359,"_33145":348,"_22633":55401,"_5":15597,"_29869":55373,"_3292":55402},[],"What it installs",{"_3839":360,"_33145":348,"_22633":55404,"_5":15597,"_29869":55373,"_3292":55405},[],"Helm",{"_3839":361,"_33145":348,"_22633":55407,"_5":15597,"_29869":55373,"_3292":55408},[],"Production and controlled environments",{"_3839":362,"_33145":348,"_22633":55410,"_5":15597,"_29869":55373,"_3292":55411},[],"Lamassu services and Gateway API resources",{"_3839":363,"_33145":348,"_22633":55413,"_5":15597,"_29869":55373,"_3292":54568},[],{"_3839":364,"_33145":348,"_22633":55415,"_5":15597,"_29869":55373,"_3292":55416},[],"Evaluation, demos, CI and small lab clusters",{"_3839":365,"_33145":348,"_22633":55418,"_5":15597,"_29869":55373,"_3292":55419},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3839":366,"_33145":348,"_22633":55421,"_5":15597,"_29869":55377,"_3292":55422},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3839":367,"_33145":348,"_22633":55424,"_5":15597,"_29869":55377,"_3292":55425},[],"Area",{"_3839":368,"_33145":348,"_22633":55427,"_5":15597,"_29869":55377,"_3292":55428},[],"The Lamassu chart provides",{"_3839":369,"_33145":348,"_22633":55430,"_5":15597,"_29869":55377,"_3292":55431},[],"You provide",{"_3839":370,"_33145":348,"_22633":55433,"_5":15597,"_29869":55377,"_3292":55434},[],"Lamassu applications",{"_3839":371,"_33145":348,"_22633":55436,"_5":15597,"_29869":55377,"_3292":55437},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3839":372,"_33145":348,"_22633":55439,"_5":15597,"_29869":55377,"_3292":55440},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3839":373,"_33145":348,"_22633":55442,"_5":15597,"_29869":55377,"_3292":55443},[],"PostgreSQL data",{"_3839":374,"_33145":348,"_22633":55445,"_5":15597,"_29869":55377,"_3292":55446},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3839":375,"_33145":348,"_22633":55448,"_5":15597,"_29869":55377,"_3292":55449},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3839":376,"_33145":348,"_22633":55451,"_5":15597,"_29869":55377,"_3292":55452},[],"Messaging",{"_3839":377,"_33145":348,"_22633":55454,"_5":15597,"_29869":55377,"_3292":55455},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3839":378,"_33145":348,"_22633":55457,"_5":15597,"_29869":55377,"_3292":55458},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3839":379,"_33145":348,"_22633":55460,"_5":15597,"_29869":55377,"_3292":55461},[],"Identity",{"_3839":380,"_33145":348,"_22633":55463,"_5":15597,"_29869":55377,"_3292":55464},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3839":381,"_33145":348,"_22633":55466,"_5":15597,"_29869":55377,"_3292":55467},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3839":382,"_33145":348,"_22633":55469,"_5":15597,"_29869":55377,"_3292":55470},[],"External routing",{"_3839":383,"_33145":348,"_22633":55472,"_5":15597,"_29869":55377,"_3292":55473},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3839":384,"_33145":348,"_22633":55475,"_5":15597,"_29869":55377,"_3292":55476},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3839":385,"_33145":348,"_22633":55478,"_5":15597,"_29869":55377,"_3292":55479},[],"TLS",{"_3839":386,"_33145":348,"_22633":55481,"_5":15597,"_29869":55377,"_3292":55482},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3839":387,"_33145":348,"_22633":55484,"_5":15597,"_29869":55377,"_3292":55485},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3839":388,"_33145":348,"_22633":55487,"_5":15597,"_29869":55377,"_3292":55488},[],"Persistent application data",{"_3839":389,"_33145":348,"_22633":55490,"_5":15597,"_29869":55377,"_3292":55491},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3839":390,"_33145":348,"_22633":55493,"_5":15597,"_29869":55377,"_3292":55494},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3839":391,"_33145":348,"_22633":55496,"_5":15597,"_29869":55377,"_3292":55497},[],"Optional integrations",{"_3839":392,"_33145":348,"_22633":55499,"_5":15597,"_29869":55377,"_3292":55500},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3839":393,"_33145":348,"_22633":55502,"_5":15597,"_29869":55377,"_3292":55503},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3839":394,"_33145":348,"_22633":55505,"_5":15597,"_29869":55377,"_3292":55506},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3839":395,"_33145":348,"_22633":55508,"_5":15597,"_29869":55377,"_3292":55509},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3839":396,"_33145":348,"_22633":55511,"_5":15597,"_29869":55381,"_3292":55512},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3839":397,"_33145":348,"_22633":55514,"_5":15597,"_29869":55381,"_3292":55515},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3839":398,"_33145":348,"_22633":55517,"_5":15597,"_29869":55385,"_3292":55518},[],"Kubernetes 1.24 or newer",{"_3839":399,"_33145":348,"_22633":55520,"_5":15597,"_29869":55385,"_3292":55521},[],"Helm 3.2 or newer",{"_3839":400,"_33145":348,"_22633":55523,"_5":15597,"_29869":55385,"_3292":55524},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3839":401,"_33145":348,"_22633":55526,"_5":15597,"_29869":55385,"_3292":55527},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3839":402,"_33145":348,"_22633":55529,"_5":15597,"_29869":55385,"_3292":55530},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3839":403,"_33145":348,"_22633":55532,"_5":15597,"_29869":55385,"_3292":55533},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3839":404,"_33145":348,"_22633":55535,"_5":15597,"_29869":55385,"_3292":55536},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3839":405,"_33145":348,"_22633":55538,"_5":15597,"_29869":55389,"_3292":55539},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3839":406,"_33145":348,"_22633":55541,"_5":15597,"_29869":55389,"_3292":55542},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3839":407,"_33145":348,"_22633":55544,"_5":15597,"_29869":55389,"_3292":55545},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3839":408,"_33145":348,"_22633":55547,"_5":15597,"_29869":55389,"_3292":55548},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3839":409,"_33145":409,"_5":15996,"_3292":55550,"_33551":55551,"_22633":55553,"_29869":409},"Deployment troubleshooting",[54324,54325,55552],"Operations",[],{"_3839":410,"_33145":409,"_22633":55555,"_5":15597,"_29869":409,"_3292":55556},[],"Diagnose access, service health and infrastructure dependencies.",{"_3839":411,"_33145":409,"_5":33548,"_22633":55558,"_29869":55559,"_3292":55560},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3839":412,"_33145":409,"_5":33548,"_22633":55562,"_29869":55563,"_3292":55564},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3839":413,"_33145":409,"_5":33548,"_22633":55566,"_29869":55567,"_3292":55568},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3839":414,"_33145":409,"_5":33548,"_22633":55570,"_29869":55571,"_3292":55572},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3839":415,"_33145":409,"_5":33548,"_22633":55574,"_29869":55575,"_3292":55576},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3839":416,"_33145":409,"_5":33548,"_22633":55578,"_29869":55579,"_3292":55580},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3839":417,"_33145":409,"_5":33548,"_22633":55582,"_29869":55583,"_3292":55584},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3839":418,"_33145":409,"_5":33548,"_22633":55586,"_29869":55587,"_3292":55588},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3839":419,"_33145":409,"_5":33548,"_22633":55590,"_29869":55591,"_3292":55592},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3839":420,"_33145":409,"_5":33548,"_22633":55594,"_29869":55595,"_3292":55596},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3839":421,"_33145":409,"_5":33548,"_22633":55598,"_29869":55599,"_3292":55600},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3839":422,"_33145":409,"_5":33548,"_22633":55602,"_29869":55603,"_3292":55604},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3839":423,"_33145":409,"_5":33548,"_22633":55606,"_29869":55607,"_3292":55608},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#observability","Observability",{"_3839":424,"_33145":409,"_22633":55610,"_5":15597,"_29869":409,"_3292":55611},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3839":425,"_33145":409,"_22633":55613,"_5":15597,"_29869":55563,"_3292":55614},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3839":426,"_33145":409,"_22633":55616,"_5":15597,"_29869":55567,"_3292":55617},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3839":427,"_33145":409,"_22633":55619,"_5":15597,"_29869":55571,"_3292":55620},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3839":428,"_33145":409,"_22633":55622,"_5":15597,"_29869":55575,"_3292":55623},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3839":429,"_33145":409,"_22633":55625,"_5":15597,"_29869":55579,"_3292":55626},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3839":430,"_33145":409,"_22633":55628,"_5":15597,"_29869":55583,"_3292":55629},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3839":431,"_33145":409,"_22633":55631,"_5":15597,"_29869":55583,"_3292":55632},[],"Also run the chart's connectivity test:",{"_3839":432,"_33145":409,"_22633":55634,"_5":15597,"_29869":55583,"_3292":55635},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3839":433,"_33145":409,"_22633":55637,"_5":15597,"_29869":55583,"_3292":55638},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3839":434,"_33145":409,"_22633":55640,"_5":15597,"_29869":55587,"_3292":55641},[],"If you receive a 401:",{"_3839":435,"_33145":409,"_22633":55643,"_5":15597,"_29869":55587,"_3292":55644},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3839":436,"_33145":409,"_22633":55646,"_5":15597,"_29869":55587,"_3292":55647},[],"verify issuer, audience and expiration of the token;",{"_3839":437,"_33145":409,"_22633":55649,"_5":15597,"_29869":55587,"_3292":55650},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3839":438,"_33145":409,"_22633":55652,"_5":15597,"_29869":55587,"_3292":55653},[],"check that the provider's public and internal routes point to the same realm.",{"_3839":439,"_33145":409,"_22633":55655,"_5":15597,"_29869":55587,"_3292":55656},[],"If login succeeds but the APIs return 403:",{"_3839":440,"_33145":409,"_22633":55658,"_5":15597,"_29869":55587,"_3292":55659},[],"inspect the token's real claims;",{"_3839":441,"_33145":409,"_22633":55661,"_5":15597,"_29869":55587,"_3292":55662},[],"confirm they match an active principal;",{"_3839":442,"_33145":409,"_22633":55664,"_5":15597,"_29869":55587,"_3292":55665},[],"review the policies granted to that principal;",{"_3839":443,"_33145":409,"_22633":55667,"_5":15597,"_29869":55587,"_3292":55668},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3839":444,"_33145":409,"_22633":55670,"_5":15597,"_29869":55587,"_3292":55671},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3839":445,"_33145":409,"_22633":55673,"_5":15597,"_29869":55591,"_3292":55674},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3839":446,"_33145":409,"_22633":55676,"_5":15597,"_29869":55591,"_3292":55677},[],"Locate the authz pod and Service.",{"_3839":447,"_33145":409,"_22633":55679,"_5":15597,"_29869":55591,"_3292":55680},[],"Check /health, logs and its database connection.",{"_3839":448,"_33145":409,"_22633":55682,"_5":15597,"_29869":55591,"_3292":55683},[],"Verify the DNS and port configured in externalAuthorization.",{"_3839":449,"_33145":409,"_22633":55685,"_5":15597,"_29869":55591,"_3292":55686},[],"Check the check route is /v1/ext\\_authz/check.",{"_3839":450,"_33145":409,"_22633":55688,"_5":15597,"_29869":55591,"_3292":55689},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3839":451,"_33145":409,"_22633":55691,"_5":15597,"_29869":55595,"_3292":55692},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3839":452,"_33145":409,"_22633":55694,"_5":15597,"_29869":55599,"_3292":55695},[],"Review kubectl describe pod first. Common causes are:",{"_3839":453,"_33145":409,"_22633":55697,"_5":15597,"_29869":55599,"_3292":55698},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3839":454,"_33145":409,"_22633":55700,"_5":15597,"_29869":55599,"_3292":55701},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3839":455,"_33145":409,"_22633":55703,"_5":15597,"_29869":55599,"_3292":55704},[],"unbound persistent volume;",{"_3839":456,"_33145":409,"_22633":55706,"_5":15597,"_29869":55599,"_3292":55707},[],"inaccessible image or incorrect pull policy;",{"_3839":457,"_33145":409,"_22633":55709,"_5":15597,"_29869":55599,"_3292":55710},[],"invalid cryptographic engine configuration;",{"_3839":458,"_33145":409,"_22633":55712,"_5":15597,"_29869":55599,"_3292":55713},[],"CPU or memory limits set too low;",{"_3839":459,"_33145":409,"_22633":55715,"_5":15597,"_29869":55599,"_3292":55716},[],"an incomplete prior migration.",{"_3839":460,"_33145":409,"_22633":55718,"_5":15597,"_29869":55599,"_3292":55719},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3839":461,"_33145":409,"_22633":55721,"_5":15597,"_29869":55599,"_3292":55722},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3839":462,"_33145":409,"_22633":55724,"_5":15597,"_29869":55599,"_3292":55725},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3839":463,"_33145":409,"_22633":55727,"_5":15597,"_29869":55603,"_3292":55728},[],"Domain and audit events depend on the bus publisher:",{"_3839":464,"_33145":409,"_22633":55730,"_5":15597,"_29869":55603,"_3292":55731},[],"verify it is enabled in the emitting service;",{"_3839":465,"_33145":409,"_22633":55733,"_5":15597,"_29869":55603,"_3292":55734},[],"check AMQP connectivity and credentials;",{"_3839":466,"_33145":409,"_22633":55736,"_5":15597,"_29869":55603,"_3292":55737},[],"review exchange, routing key, queues and consumers;",{"_3839":467,"_33145":409,"_22633":55739,"_5":15597,"_29869":55603,"_3292":55740},[],"inspect dead-letter queues;",{"_3839":468,"_33145":409,"_22633":55742,"_5":15597,"_29869":55603,"_3292":55743},[],"alert on orphan durable queues and backlog growth.",{"_3839":469,"_33145":409,"_22633":55745,"_5":15597,"_29869":55603,"_3292":55746},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3839":470,"_33145":409,"_22633":55748,"_5":15597,"_29869":55603,"_3292":55749},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3839":471,"_33145":409,"_22633":55751,"_5":15597,"_29869":55603,"_3292":55752},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3839":472,"_33145":409,"_22633":55754,"_5":15597,"_29869":55603,"_3292":55755},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3839":473,"_33145":409,"_22633":55757,"_5":15597,"_29869":55603,"_3292":55758},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3839":474,"_33145":409,"_22633":55760,"_5":15597,"_29869":55603,"_3292":55761},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3839":475,"_33145":409,"_22633":55763,"_5":15597,"_29869":55603,"_3292":55764},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3839":476,"_33145":409,"_22633":55766,"_5":15597,"_29869":55607,"_3292":55767},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3839":477,"_33145":409,"_22633":55769,"_5":15597,"_29869":55607,"_3292":55770},[],"Before closing an incident, record:",{"_3839":478,"_33145":409,"_22633":55772,"_5":15597,"_29869":55607,"_3292":55773},[],"the confirmed cause;",{"_3839":479,"_33145":409,"_22633":55775,"_5":15597,"_29869":55607,"_3292":55776},[],"the time scope and affected resources;",{"_3839":480,"_33145":409,"_22633":55778,"_5":15597,"_29869":55607,"_3292":55779},[],"the commands or queries used;",{"_3839":481,"_33145":409,"_22633":55781,"_5":15597,"_29869":55607,"_3292":55782},[],"the applied change and how to revert it;",{"_3839":482,"_33145":409,"_22633":55784,"_5":15597,"_29869":55607,"_3292":55785},[],"validation from a consumer;",{"_3839":483,"_33145":409,"_22633":55787,"_5":15597,"_29869":55607,"_3292":55788},[],"the preventive action and its owner.",{"_3839":484,"_33145":484,"_5":15996,"_3292":55790,"_33551":55791,"_22633":55794,"_29869":484},"Access control",[54324,55792,55793],"Platform","Administration",[],{"_3839":485,"_33145":484,"_22633":55796,"_5":15597,"_29869":484,"_3292":55797},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3839":486,"_33145":484,"_5":33548,"_22633":55799,"_29869":55800,"_3292":55801},[],"/docs/pr-preview/pr-58/platform/administration/access-control#essential-concepts","Essential concepts",{"_3839":487,"_33145":484,"_5":33548,"_22633":55803,"_29869":55804,"_3292":55805},[],"/docs/pr-preview/pr-58/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3839":488,"_33145":484,"_5":33548,"_22633":55807,"_29869":55808,"_3292":55809},[],"/docs/pr-preview/pr-58/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3839":489,"_33145":484,"_5":33548,"_22633":55811,"_29869":55812,"_3292":55813},[],"/docs/pr-preview/pr-58/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3839":490,"_33145":484,"_5":33548,"_22633":55815,"_29869":55816,"_3292":55817},[],"/docs/pr-preview/pr-58/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3839":491,"_33145":484,"_5":33548,"_22633":55819,"_29869":55820,"_3292":55821},[],"/docs/pr-preview/pr-58/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3839":492,"_33145":484,"_5":33548,"_22633":55823,"_29869":55824,"_3292":55825},[],"/docs/pr-preview/pr-58/platform/administration/access-control#oidc-principals","OIDC principals",{"_3839":493,"_33145":484,"_5":33548,"_22633":55827,"_29869":55828,"_3292":55829},[],"/docs/pr-preview/pr-58/platform/administration/access-control#x509-principals","X.509 principals",{"_3839":494,"_33145":484,"_5":33548,"_22633":55831,"_29869":55832,"_3292":55833},[],"/docs/pr-preview/pr-58/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3839":495,"_33145":484,"_5":33548,"_22633":55835,"_29869":55836,"_3292":55837},[],"/docs/pr-preview/pr-58/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3839":496,"_33145":484,"_5":33548,"_22633":55839,"_29869":55840,"_3292":55841},[],"/docs/pr-preview/pr-58/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3839":497,"_33145":484,"_5":33548,"_22633":55843,"_29869":55844,"_3292":55845},[],"/docs/pr-preview/pr-58/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3839":498,"_33145":484,"_5":33548,"_22633":55847,"_29869":55848,"_3292":55849},[],"/docs/pr-preview/pr-58/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3839":499,"_33145":484,"_5":33548,"_22633":55851,"_29869":55852,"_3292":55853},[],"/docs/pr-preview/pr-58/platform/administration/access-control#http-rules","HTTP rules",{"_3839":500,"_33145":484,"_5":33548,"_22633":55855,"_29869":55856,"_3292":55857},[],"/docs/pr-preview/pr-58/platform/administration/access-control#included-policies","Included policies",{"_3839":501,"_33145":484,"_5":33548,"_22633":55859,"_29869":55860,"_3292":54964},[],"/docs/pr-preview/pr-58/platform/administration/access-control#provision-the-first-administrator",{"_3839":502,"_33145":484,"_5":33548,"_22633":55862,"_29869":55863,"_3292":55864},[],"/docs/pr-preview/pr-58/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3839":503,"_33145":484,"_5":33548,"_22633":55866,"_29869":55867,"_3292":55868},[],"/docs/pr-preview/pr-58/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3839":504,"_33145":484,"_5":33548,"_22633":55870,"_29869":55871,"_3292":55872},[],"/docs/pr-preview/pr-58/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3839":505,"_33145":484,"_5":33548,"_22633":55874,"_29869":55875,"_3292":55876},[],"/docs/pr-preview/pr-58/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3839":506,"_33145":484,"_5":33548,"_22633":55878,"_29869":55879,"_3292":55880},[],"/docs/pr-preview/pr-58/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3839":507,"_33145":484,"_5":33548,"_22633":55882,"_29869":55883,"_3292":55884},[],"/docs/pr-preview/pr-58/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3839":508,"_33145":484,"_5":33548,"_22633":55886,"_29869":55887,"_3292":55888},[],"/docs/pr-preview/pr-58/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3839":509,"_33145":484,"_5":33548,"_22633":55890,"_29869":55891,"_3292":55892},[],"/docs/pr-preview/pr-58/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3839":510,"_33145":484,"_5":33548,"_22633":55894,"_29869":55895,"_3292":55896},[],"/docs/pr-preview/pr-58/platform/administration/access-control#operational-checklist","Operational checklist",{"_3839":511,"_33145":484,"_5":33548,"_22633":55898,"_29869":55899,"_3292":55900},[],"/docs/pr-preview/pr-58/platform/administration/access-control#diagnostics","Diagnostics",{"_3839":512,"_33145":484,"_5":33548,"_22633":55902,"_29869":55903,"_3292":55904},[],"/docs/pr-preview/pr-58/platform/administration/access-control#the-response-is-401","The response is 401",{"_3839":513,"_33145":484,"_5":33548,"_22633":55906,"_29869":55907,"_3292":55908},[],"/docs/pr-preview/pr-58/platform/administration/access-control#the-response-is-403","The response is 403",{"_3839":514,"_33145":484,"_5":33548,"_22633":55910,"_29869":55911,"_3292":55912},[],"/docs/pr-preview/pr-58/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3839":515,"_33145":484,"_5":33548,"_22633":55914,"_29869":55915,"_3292":55916},[],"/docs/pr-preview/pr-58/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3839":516,"_33145":484,"_5":33548,"_22633":55918,"_29869":55919,"_3292":55920},[],"/docs/pr-preview/pr-58/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3839":517,"_33145":484,"_22633":55922,"_5":15597,"_29869":484,"_3292":55923},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3839":518,"_33145":484,"_22633":55925,"_5":15597,"_29869":484,"_3292":55926},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3839":519,"_33145":484,"_22633":55928,"_5":15597,"_29869":484,"_3292":55929},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3839":520,"_33145":484,"_22633":55931,"_5":15597,"_29869":55800,"_3292":55932},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3839":521,"_33145":484,"_22633":55934,"_5":15597,"_29869":55800,"_3292":55935},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3839":522,"_33145":484,"_22633":55937,"_5":15597,"_29869":55800,"_3292":55938},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3839":523,"_33145":484,"_22633":55940,"_5":15597,"_29869":55800,"_3292":55941},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3839":524,"_33145":484,"_22633":55943,"_5":15597,"_29869":55800,"_3292":55944},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3839":525,"_33145":484,"_22633":55946,"_5":15597,"_29869":55800,"_3292":55947},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3839":526,"_33145":484,"_22633":55949,"_5":15597,"_29869":55804,"_3292":55950},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3839":527,"_33145":484,"_22633":55952,"_5":15597,"_29869":55804,"_3292":55953},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3839":528,"_33145":484,"_22633":55955,"_5":15597,"_29869":55808,"_3292":55956},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3839":529,"_33145":484,"_22633":55958,"_5":15597,"_29869":55808,"_3292":55959},[],"The decision is made **before forwarding the request to the service**:",{"_3839":530,"_33145":484,"_22633":55961,"_5":15597,"_29869":55808,"_3292":55962},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3839":531,"_33145":484,"_22633":55964,"_5":15597,"_29869":55808,"_3292":55965},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3839":532,"_33145":484,"_22633":55967,"_5":15597,"_29869":55808,"_3292":55968},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3839":533,"_33145":484,"_22633":55970,"_5":15597,"_29869":55808,"_3292":55971},[],"It separately loads the policies granted to each principal.",{"_3839":534,"_33145":484,"_22633":55973,"_5":15597,"_29869":55808,"_3292":55974},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3839":535,"_33145":484,"_22633":55976,"_5":15597,"_29869":55808,"_3292":55977},[],"`authz` looks for an HTTP rule granting that action.",{"_3839":536,"_33145":484,"_22633":55979,"_5":15597,"_29869":55808,"_3292":55980},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3839":537,"_33145":484,"_22633":55982,"_5":15597,"_29869":55808,"_3292":55983},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3839":538,"_33145":484,"_22633":55985,"_5":15597,"_29869":55808,"_3292":55986},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3839":539,"_33145":484,"_22633":55988,"_5":15597,"_29869":55808,"_3292":55989},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3839":540,"_33145":484,"_22633":55991,"_5":15597,"_29869":55812,"_3292":55992},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3839":541,"_33145":484,"_22633":55994,"_5":15597,"_29869":55812,"_3292":55995},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3839":542,"_33145":484,"_22633":55997,"_5":15597,"_29869":55812,"_3292":55998},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3839":543,"_33145":484,"_22633":56000,"_5":15597,"_29869":55812,"_3292":56001},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3839":544,"_33145":484,"_22633":56003,"_5":15597,"_29869":55812,"_3292":56004},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3839":545,"_33145":484,"_22633":56006,"_5":15597,"_29869":55812,"_3292":56007},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3839":546,"_33145":484,"_22633":56009,"_5":15597,"_29869":55812,"_3292":56010},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3839":547,"_33145":484,"_22633":56012,"_5":15597,"_29869":55812,"_3292":56013},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3839":548,"_33145":484,"_22633":56015,"_5":15597,"_29869":55816,"_3292":56016},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3839":549,"_33145":484,"_22633":56018,"_5":15597,"_29869":55816,"_3292":56019},[],"The decision is made with the domain operation context:",{"_3839":550,"_33145":484,"_22633":56021,"_5":15597,"_29869":55816,"_3292":56022},[],"The middleware extracts the credential and resolves the matching principals.",{"_3839":551,"_33145":484,"_22633":56024,"_5":15597,"_29869":55816,"_3292":56025},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3839":552,"_33145":484,"_22633":56027,"_5":15597,"_29869":55816,"_3292":56028},[],"`authz` gathers the entity rules of the granted policies.",{"_3839":553,"_33145":484,"_22633":56030,"_5":15597,"_29869":55816,"_3292":56031},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3839":554,"_33145":484,"_22633":56033,"_5":15597,"_29869":55816,"_3292":56034},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3839":555,"_33145":484,"_22633":56036,"_5":15597,"_29869":55816,"_3292":56037},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3839":556,"_33145":484,"_22633":56039,"_5":15597,"_29869":55816,"_3292":56040},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3839":557,"_33145":484,"_22633":56042,"_5":15597,"_29869":55816,"_3292":56043},[],"Actions fall into two groups:",{"_3839":558,"_33145":484,"_22633":56045,"_5":15597,"_29869":55816,"_3292":56046},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3839":559,"_33145":484,"_22633":56048,"_5":15597,"_29869":55816,"_3292":56049},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3839":560,"_33145":484,"_22633":56051,"_5":15597,"_29869":55816,"_3292":56052},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3839":561,"_33145":484,"_22633":56054,"_5":15597,"_29869":55820,"_3292":56055},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3839":562,"_33145":484,"_22633":56057,"_5":15597,"_29869":55820,"_3292":56058},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3839":563,"_33145":484,"_22633":56060,"_5":15597,"_29869":55820,"_3292":56061},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3839":564,"_33145":484,"_22633":56063,"_5":15597,"_29869":55824,"_3292":56064},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3839":565,"_33145":484,"_22633":56066,"_5":15597,"_29869":55824,"_3292":56067},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3839":566,"_33145":484,"_22633":56069,"_5":15597,"_29869":55824,"_3292":56070},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3839":567,"_33145":484,"_22633":56072,"_5":15597,"_29869":55824,"_3292":56073},[],"The implemented operators are:",{"_3839":568,"_33145":484,"_22633":56075,"_5":15597,"_29869":55824,"_3292":56076},[],"`equals`, for exact equality;",{"_3839":569,"_33145":484,"_22633":56078,"_5":15597,"_29869":55824,"_3292":56079},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3839":570,"_33145":484,"_22633":56081,"_5":15597,"_29869":55824,"_3292":56082},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3839":571,"_33145":484,"_22633":56084,"_5":15597,"_29869":55824,"_3292":56085},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3839":572,"_33145":484,"_22633":56087,"_5":15597,"_29869":55828,"_3292":56088},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3839":573,"_33145":484,"_22633":56090,"_5":15597,"_29869":55828,"_3292":56091},[],"The available modes are:",{"_3839":574,"_33145":484,"_22633":56093,"_5":15597,"_29869":55828,"_3292":56094},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3839":575,"_33145":484,"_22633":56096,"_5":15597,"_29869":55828,"_3292":56097},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3839":576,"_33145":484,"_22633":56099,"_5":15597,"_29869":55828,"_3292":56100},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3839":577,"_33145":484,"_22633":56102,"_5":15597,"_29869":55828,"_3292":56103},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3839":578,"_33145":484,"_22633":56105,"_5":15597,"_29869":55828,"_3292":56106},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3839":579,"_33145":484,"_22633":56108,"_5":15597,"_29869":55828,"_3292":56109},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3839":580,"_33145":484,"_22633":56111,"_5":15597,"_29869":55832,"_3292":56112},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3839":581,"_33145":484,"_22633":56114,"_5":15597,"_29869":55832,"_3292":56115},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3839":582,"_33145":484,"_22633":56117,"_5":15597,"_29869":55832,"_3292":56118},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3839":583,"_33145":484,"_22633":56120,"_5":15597,"_29869":55832,"_3292":56121},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3839":584,"_33145":484,"_22633":56123,"_5":15597,"_29869":55840,"_3292":56124},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3839":585,"_33145":484,"_22633":56126,"_5":15597,"_29869":55840,"_3292":56127},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3839":586,"_33145":484,"_22633":56129,"_5":15597,"_29869":55844,"_3292":56130},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3839":587,"_33145":484,"_22633":56132,"_5":15597,"_29869":55844,"_3292":56133},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3839":588,"_33145":484,"_22633":56135,"_5":15597,"_29869":55848,"_3292":56136},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3839":589,"_33145":484,"_22633":56138,"_5":15597,"_29869":55848,"_3292":56139},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3839":590,"_33145":484,"_22633":56141,"_5":15597,"_29869":55848,"_3292":56142},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3839":591,"_33145":484,"_22633":56144,"_5":15597,"_29869":55852,"_3292":56145},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3839":592,"_33145":484,"_22633":56147,"_5":15597,"_29869":55852,"_3292":56148},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3839":593,"_33145":484,"_22633":56150,"_5":15597,"_29869":55852,"_3292":56151},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3839":594,"_33145":484,"_22633":56153,"_5":15597,"_29869":55852,"_3292":56154},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3839":595,"_33145":484,"_22633":56156,"_5":15597,"_29869":55852,"_3292":56157},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3839":596,"_33145":484,"_22633":56159,"_5":15597,"_29869":55852,"_3292":56160},[],"Note that:",{"_3839":597,"_33145":484,"_22633":56162,"_5":15597,"_29869":55852,"_3292":56163},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3839":598,"_33145":484,"_22633":56165,"_5":15597,"_29869":55852,"_3292":56166},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3839":599,"_33145":484,"_22633":56168,"_5":15597,"_29869":55852,"_3292":56169},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3839":600,"_33145":484,"_22633":56171,"_5":15597,"_29869":55856,"_3292":56172},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3839":601,"_33145":484,"_22633":56174,"_5":15597,"_29869":55856,"_3292":56175},[],"full and read-only access to certificates and authorities;",{"_3839":602,"_33145":484,"_22633":56177,"_5":15597,"_29869":55856,"_3292":56178},[],"full and read-only access to the KMS;",{"_3839":603,"_33145":484,"_22633":56180,"_5":15597,"_29869":55856,"_3292":56181},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3839":604,"_33145":484,"_22633":56183,"_5":15597,"_29869":55856,"_3292":56184},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3839":605,"_33145":484,"_22633":56186,"_5":15597,"_29869":55856,"_3292":56187},[],"console access;",{"_3839":606,"_33145":484,"_22633":56189,"_5":15597,"_29869":55856,"_3292":56190},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3839":607,"_33145":484,"_22633":56192,"_5":15597,"_29869":55856,"_3292":56193},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3839":608,"_33145":484,"_22633":56195,"_5":15597,"_29869":55856,"_3292":56196},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3839":609,"_33145":484,"_22633":56198,"_5":15597,"_29869":55860,"_3292":56199},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3839":610,"_33145":484,"_22633":56201,"_5":15597,"_29869":55860,"_3292":56202},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3839":611,"_33145":484,"_22633":56204,"_5":15597,"_29869":55860,"_3292":56205},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3839":612,"_33145":484,"_22633":56207,"_5":15597,"_29869":55863,"_3292":56208},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3839":613,"_33145":484,"_22633":56210,"_5":15597,"_29869":55867,"_3292":56211},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3839":614,"_33145":484,"_22633":56213,"_5":15597,"_29869":55867,"_3292":56214},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3839":615,"_33145":484,"_22633":56216,"_5":15597,"_29869":55871,"_3292":56217},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3839":616,"_33145":484,"_22633":56219,"_5":15597,"_29869":55875,"_3292":56220},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3839":617,"_33145":484,"_22633":56222,"_5":15597,"_29869":55879,"_3292":56223},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3839":618,"_33145":484,"_22633":56225,"_5":15597,"_29869":55883,"_3292":56226},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3839":619,"_33145":484,"_22633":56228,"_5":15597,"_29869":55883,"_3292":56229},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3839":620,"_33145":484,"_22633":56231,"_5":15597,"_29869":55887,"_3292":56232},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3839":621,"_33145":484,"_22633":56234,"_5":15597,"_29869":55887,"_3292":56235},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3839":622,"_33145":484,"_22633":56237,"_5":15597,"_29869":55887,"_3292":56238},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3839":623,"_33145":484,"_22633":56240,"_5":15597,"_29869":55887,"_3292":56241},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3839":624,"_33145":484,"_22633":56243,"_5":15597,"_29869":55887,"_3292":56244},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3839":625,"_33145":484,"_22633":56246,"_5":15597,"_29869":55887,"_3292":56247},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3839":626,"_33145":484,"_22633":56249,"_5":15597,"_29869":55887,"_3292":56250},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3839":627,"_33145":484,"_22633":56252,"_5":15597,"_29869":55887,"_3292":56253},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3839":628,"_33145":484,"_22633":56255,"_5":15597,"_29869":55891,"_3292":56256},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3839":629,"_33145":484,"_22633":56258,"_5":15597,"_29869":55891,"_3292":56259},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3839":630,"_33145":484,"_22633":56261,"_5":15597,"_29869":55891,"_3292":56262},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3839":631,"_33145":484,"_22633":56264,"_5":15597,"_29869":55895,"_3292":56265},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3839":632,"_33145":484,"_22633":56267,"_5":15597,"_29869":55895,"_3292":56268},[],"Use groups or stable roles for people and independent identities for automations.",{"_3839":633,"_33145":484,"_22633":56270,"_5":15597,"_29869":55895,"_3292":56271},[],"Keep at least two recovery administrators and test their access periodically.",{"_3839":634,"_33145":484,"_22633":56273,"_5":15597,"_29869":55895,"_3292":56274},[],"Review active principals, their matches and their grants after IdP changes.",{"_3839":635,"_33145":484,"_22633":56276,"_5":15597,"_29869":55895,"_3292":56277},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3839":636,"_33145":484,"_22633":56279,"_5":15597,"_29869":55895,"_3292":56280},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3839":637,"_33145":484,"_22633":56282,"_5":15597,"_29869":55895,"_3292":56283},[],"Always test one allowed and one denied operation for each role.",{"_3839":638,"_33145":484,"_22633":56285,"_5":15597,"_29869":55895,"_3292":56286},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3839":639,"_33145":484,"_22633":56288,"_5":15597,"_29869":55903,"_3292":56289},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3839":640,"_33145":484,"_22633":56291,"_5":15597,"_29869":55907,"_3292":56292},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3839":641,"_33145":484,"_22633":56294,"_5":15597,"_29869":55907,"_3292":56295},[],"that an active principal of the correct type exists;",{"_3839":642,"_33145":484,"_22633":56297,"_5":15597,"_29869":55907,"_3292":56298},[],"that the claim paths and values match the real token exactly;",{"_3839":643,"_33145":484,"_22633":56300,"_5":15597,"_29869":55907,"_3292":56301},[],"that all of the principal's conditions hold;",{"_3839":644,"_33145":484,"_22633":56303,"_5":15597,"_29869":55907,"_3292":56304},[],"that the principal has the expected policy granted;",{"_3839":645,"_33145":484,"_22633":56306,"_5":15597,"_29869":55907,"_3292":56307},[],"that the policy includes the action and the requested resource type or route;",{"_3839":646,"_33145":484,"_22633":56309,"_5":15597,"_29869":55907,"_3292":56310},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3839":647,"_33145":484,"_22633":56312,"_5":15597,"_29869":55907,"_3292":56313},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3839":648,"_33145":484,"_22633":56315,"_5":15597,"_29869":55911,"_3292":56316},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3839":649,"_33145":484,"_22633":56318,"_5":15597,"_29869":55915,"_3292":56319},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3839":650,"_33145":484,"_22633":56321,"_5":15597,"_29869":55919,"_3292":56322},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3839":651,"_33145":484,"_22633":56324,"_5":15597,"_29869":55919,"_3292":56325},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3839":652,"_33145":652,"_5":15996,"_3292":56327,"_33551":56328,"_22633":56329,"_29869":652},"Alerts and subscriptions",[54324,55792,55793],[],{"_3839":653,"_33145":652,"_22633":56331,"_5":15597,"_29869":652,"_3292":56332},[],"Send PKI events to people and external systems.",{"_3839":654,"_33145":652,"_5":33548,"_22633":56334,"_29869":56335,"_3292":56336},[],"/docs/pr-preview/pr-58/platform/administration/alerts#how-it-works","How it works",{"_3839":655,"_33145":652,"_5":33548,"_22633":56338,"_29869":56339,"_3292":56340},[],"/docs/pr-preview/pr-58/platform/administration/alerts#available-channels","Available channels",{"_3839":656,"_33145":652,"_5":33548,"_22633":56342,"_29869":56343,"_3292":56344},[],"/docs/pr-preview/pr-58/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3839":657,"_33145":652,"_5":33548,"_22633":56346,"_29869":56347,"_3292":56348},[],"/docs/pr-preview/pr-58/platform/administration/alerts#choose-the-event","Choose the event",{"_3839":658,"_33145":652,"_5":33548,"_22633":56350,"_29869":56351,"_3292":56352},[],"/docs/pr-preview/pr-58/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3839":659,"_33145":652,"_5":33548,"_22633":56354,"_29869":56355,"_3292":56356},[],"/docs/pr-preview/pr-58/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3839":660,"_33145":652,"_5":33548,"_22633":56358,"_29869":56359,"_3292":56360},[],"/docs/pr-preview/pr-58/platform/administration/alerts#review-and-activate","Review and activate",{"_3839":661,"_33145":652,"_5":33548,"_22633":56362,"_29869":56363,"_3292":56364},[],"/docs/pr-preview/pr-58/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3839":662,"_33145":652,"_5":33548,"_22633":56366,"_29869":56367,"_3292":56368},[],"/docs/pr-preview/pr-58/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3839":663,"_33145":652,"_5":33548,"_22633":56370,"_29869":56371,"_3292":56372},[],"/docs/pr-preview/pr-58/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3839":664,"_33145":652,"_5":33548,"_22633":56374,"_29869":56375,"_3292":56376},[],"/docs/pr-preview/pr-58/platform/administration/alerts#event-families","Event families",{"_3839":665,"_33145":652,"_22633":56378,"_5":15597,"_29869":652,"_3292":56379},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3839":666,"_33145":652,"_22633":56381,"_5":15597,"_29869":56335,"_3292":56382},[],"A service publishes a domain event.",{"_3839":667,"_33145":652,"_22633":56384,"_5":15597,"_29869":56335,"_3292":56385},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3839":668,"_33145":652,"_22633":56387,"_5":15597,"_29869":56335,"_3292":56388},[],"Each subscription's filter decides whether it should be notified.",{"_3839":669,"_33145":652,"_22633":56390,"_5":15597,"_29869":56335,"_3292":56391},[],"Lamassu delivers the event to the configured channel.",{"_3839":670,"_33145":652,"_22633":56393,"_5":15597,"_29869":56335,"_3292":56394},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3839":671,"_33145":652,"_22633":56396,"_5":15597,"_29869":56339,"_3292":56397},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3839":672,"_33145":652,"_22633":56399,"_5":15597,"_29869":56339,"_3292":56400},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3839":673,"_33145":652,"_22633":56402,"_5":15597,"_29869":56339,"_3292":56403},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3839":674,"_33145":652,"_22633":56405,"_5":15597,"_29869":56339,"_3292":56406},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3839":675,"_33145":652,"_22633":56408,"_5":15597,"_29869":56339,"_3292":56409},[],"`apikey_options` requires `header` and `key`.",{"_3839":676,"_33145":652,"_22633":56411,"_5":15597,"_29869":56339,"_3292":56412},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3839":677,"_33145":652,"_22633":56414,"_5":15597,"_29869":56339,"_3292":56415},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3839":678,"_33145":652,"_22633":56417,"_5":15597,"_29869":56339,"_3292":56418},[],"The alerts API reference documents the full `http_client` schema.",{"_3839":679,"_33145":652,"_22633":56420,"_5":15597,"_29869":56347,"_3292":56421},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3839":680,"_33145":652,"_22633":56423,"_5":15597,"_29869":56351,"_3292":56424},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3839":681,"_33145":652,"_22633":56426,"_5":15597,"_29869":56355,"_3292":56427},[],"Add a filter if you don't want to receive every instance of the event.",{"_3839":682,"_33145":652,"_22633":56429,"_5":15597,"_29869":56355,"_3292":56430},[],"**None** notifies all instances of the event.",{"_3839":683,"_33145":652,"_22633":56432,"_5":15597,"_29869":56355,"_3292":56433},[],"**JSON Path** evaluates one or more specific fields.",{"_3839":684,"_33145":652,"_22633":56435,"_5":15597,"_29869":56355,"_3292":56436},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3839":685,"_33145":652,"_22633":56438,"_5":15597,"_29869":56355,"_3292":56439},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3839":686,"_33145":652,"_22633":56441,"_5":15597,"_29869":56355,"_3292":56442},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3839":687,"_33145":652,"_22633":56444,"_5":15597,"_29869":56355,"_3292":56445},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3839":688,"_33145":652,"_22633":56447,"_5":15597,"_29869":56359,"_3292":56448},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3839":689,"_33145":652,"_22633":56450,"_5":15597,"_29869":56363,"_3292":56451},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3839":690,"_33145":652,"_22633":56453,"_5":15597,"_29869":56363,"_3292":56454},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3839":691,"_33145":652,"_22633":56456,"_5":15597,"_29869":56363,"_3292":56457},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3839":692,"_33145":652,"_22633":56459,"_5":15597,"_29869":56363,"_3292":56460},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3839":693,"_33145":652,"_22633":56462,"_5":15597,"_29869":56363,"_3292":56463},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3839":694,"_33145":652,"_22633":56465,"_5":15597,"_29869":56363,"_3292":56466},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3839":695,"_33145":652,"_22633":56468,"_5":15597,"_29869":56363,"_3292":56469},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3839":696,"_33145":652,"_22633":56471,"_5":15597,"_29869":56363,"_3292":56472},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3839":697,"_33145":652,"_22633":56474,"_5":15597,"_29869":56367,"_3292":56475},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3839":698,"_33145":652,"_22633":56477,"_5":15597,"_29869":56367,"_3292":56478},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3839":699,"_33145":652,"_22633":56480,"_5":15597,"_29869":56367,"_3292":56481},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3839":700,"_33145":652,"_22633":56483,"_5":15597,"_29869":56367,"_3292":56484},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3839":701,"_33145":652,"_22633":56486,"_5":15597,"_29869":56367,"_3292":56487},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3839":702,"_33145":652,"_22633":56489,"_5":15597,"_29869":56367,"_3292":56490},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3839":703,"_33145":652,"_22633":56492,"_5":15597,"_29869":56367,"_3292":56493},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3839":704,"_33145":652,"_22633":56495,"_5":15597,"_29869":56367,"_3292":56496},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3839":705,"_33145":652,"_22633":56498,"_5":15597,"_29869":56371,"_3292":56499},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3839":706,"_33145":652,"_22633":56501,"_5":15597,"_29869":56371,"_3292":56502},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3839":707,"_33145":652,"_22633":56504,"_5":15597,"_29869":56375,"_3292":56505},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3839":708,"_33145":652,"_22633":56507,"_5":15597,"_29869":56375,"_3292":56508},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3839":709,"_33145":652,"_22633":56510,"_5":15597,"_29869":56375,"_3292":56511},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3839":710,"_33145":652,"_22633":56513,"_5":15597,"_29869":56375,"_3292":56514},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3839":711,"_33145":652,"_22633":56516,"_5":15597,"_29869":56375,"_3292":56517},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3839":712,"_33145":652,"_22633":56519,"_5":15597,"_29869":56375,"_3292":56520},[],"**Validation:** `va.role.crl.create`.",{"_3839":713,"_33145":652,"_22633":56522,"_5":15597,"_29869":56375,"_3292":56523},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3839":714,"_33145":652,"_22633":56525,"_5":15597,"_29869":56375,"_3292":56526},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3839":715,"_33145":715,"_5":15996,"_3292":56528,"_33551":56529,"_22633":56530,"_29869":715},"Audit logs",[54324,55792,55793],[],{"_3839":716,"_33145":715,"_22633":56532,"_5":15597,"_29869":715,"_3292":56533},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3839":717,"_33145":715,"_5":33548,"_22633":56535,"_29869":56536,"_3292":56537},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3839":718,"_33145":715,"_5":33548,"_22633":56539,"_29869":56540,"_3292":56541},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#coverage","Coverage",{"_3839":719,"_33145":715,"_5":33548,"_22633":56543,"_29869":56544,"_3292":56545},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3839":720,"_33145":715,"_5":33548,"_22633":56547,"_29869":56548,"_3292":56549},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3839":721,"_33145":715,"_5":33548,"_22633":56551,"_29869":56552,"_3292":56553},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3839":722,"_33145":715,"_5":33548,"_22633":56555,"_29869":56556,"_3292":56557},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3839":723,"_33145":715,"_5":33548,"_22633":56559,"_29869":56560,"_3292":56561},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3839":724,"_33145":715,"_5":33548,"_22633":56563,"_29869":56564,"_3292":56565},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3839":725,"_33145":715,"_5":33548,"_22633":56567,"_29869":56568,"_3292":56569},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3839":726,"_33145":715,"_5":33548,"_22633":56571,"_29869":56572,"_3292":56573},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3839":727,"_33145":715,"_5":33548,"_22633":56575,"_29869":56576,"_3292":56577},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3839":728,"_33145":715,"_22633":56579,"_5":15597,"_29869":715,"_3292":56580},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3839":729,"_33145":715,"_22633":56582,"_5":15597,"_29869":56536,"_3292":56583},[],"The audit body includes:",{"_3839":730,"_33145":715,"_22633":56585,"_5":15597,"_29869":56536,"_3292":56586},[],"input: data received by the operation;",{"_3839":731,"_33145":715,"_22633":56588,"_5":15597,"_29869":56536,"_3292":56589},[],"has\\_error: whether the service returned an error;",{"_3839":732,"_33145":715,"_22633":56591,"_5":15597,"_29869":56536,"_3292":56592},[],"output: produced result or error message;",{"_3839":733,"_33145":715,"_22633":56594,"_5":15597,"_29869":56536,"_3292":56595},[],"principals: identifiers of the principals that matched the request.",{"_3839":734,"_33145":715,"_22633":56597,"_5":15597,"_29869":56536,"_3292":56598},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3839":735,"_33145":715,"_22633":56600,"_5":15597,"_29869":56536,"_3292":56601},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3839":736,"_33145":715,"_22633":56603,"_5":15597,"_29869":56540,"_3292":56604},[],"The backend applies auditing to mutations of:",{"_3839":737,"_33145":715,"_22633":56606,"_5":15597,"_29869":56540,"_3292":56607},[],"authorities, certificates and issuance profiles;",{"_3839":738,"_33145":715,"_22633":56609,"_5":15597,"_29869":56540,"_3292":56610},[],"keys and KMS engines;",{"_3839":739,"_33145":715,"_22633":56612,"_5":15597,"_29869":56540,"_3292":56613},[],"devices and identities;",{"_3839":740,"_33145":715,"_22633":56615,"_5":15597,"_29869":56540,"_3292":56616},[],"DMSs and enrollment operations;",{"_3839":741,"_33145":715,"_22633":56618,"_5":15597,"_29869":56540,"_3292":56619},[],"validation functions and CRL;",{"_3839":742,"_33145":715,"_22633":56621,"_5":15597,"_29869":56540,"_3292":56622},[],"principals, policies and authorization grants.",{"_3839":743,"_33145":715,"_22633":56624,"_5":15597,"_29869":56540,"_3292":56625},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3839":744,"_33145":715,"_22633":56627,"_5":15597,"_29869":56544,"_3292":56628},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3839":745,"_33145":715,"_22633":56630,"_5":15597,"_29869":56544,"_3292":56631},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3839":746,"_33145":715,"_22633":56633,"_5":15597,"_29869":56544,"_3292":56634},[],"Design the consumer to:",{"_3839":747,"_33145":715,"_22633":56636,"_5":15597,"_29869":56544,"_3292":56637},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3839":748,"_33145":715,"_22633":56639,"_5":15597,"_29869":56544,"_3292":56640},[],"keep the complete CloudEvent unmodified;",{"_3839":749,"_33145":715,"_22633":56642,"_5":15597,"_29869":56544,"_3292":56643},[],"record the ingestion time and detect duplicates by ID;",{"_3839":750,"_33145":715,"_22633":56645,"_5":15597,"_29869":56544,"_3292":56646},[],"encrypt in transit and at rest;",{"_3839":751,"_33145":715,"_22633":56648,"_5":15597,"_29869":56544,"_3292":56649},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3839":752,"_33145":715,"_22633":56651,"_5":15597,"_29869":56544,"_3292":56652},[],"apply an explicit retention and legal hold policy;",{"_3839":753,"_33145":715,"_22633":56654,"_5":15597,"_29869":56544,"_3292":56655},[],"alert if it stops consuming or the pending queue grows.",{"_3839":754,"_33145":715,"_22633":56657,"_5":15597,"_29869":56548,"_3292":56658},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3839":755,"_33145":715,"_22633":56660,"_5":15597,"_29869":56548,"_3292":56661},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3839":756,"_33145":715,"_22633":56663,"_5":15597,"_29869":56556,"_3292":56664},[],"Start from the reported time and normalize every source to UTC.",{"_3839":757,"_33145":715,"_22633":56666,"_5":15597,"_29869":56560,"_3292":56667},[],"Filter by event type, service source and resource identifier.",{"_3839":758,"_33145":715,"_22633":56669,"_5":15597,"_29869":56564,"_3292":56670},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3839":759,"_33145":715,"_22633":56672,"_5":15597,"_29869":56568,"_3292":56673},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3839":760,"_33145":715,"_22633":56675,"_5":15597,"_29869":56572,"_3292":56676},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3839":761,"_33145":715,"_22633":56678,"_5":15597,"_29869":56576,"_3292":56679},[],"Generate a controlled mutation in a test environment and check that:",{"_3839":762,"_33145":715,"_22633":56681,"_5":15597,"_29869":56576,"_3292":56682},[],"a successful audit event appears;",{"_3839":763,"_33145":715,"_22633":56684,"_5":15597,"_29869":56576,"_3292":56685},[],"the principal matches the identity used;",{"_3839":764,"_33145":715,"_22633":56687,"_5":15597,"_29869":56576,"_3292":56688},[],"the consumer persists it exactly once;",{"_3839":765,"_33145":715,"_22633":56690,"_5":15597,"_29869":56576,"_3292":56691},[],"it can be retrieved by resource, actor and period;",{"_3839":766,"_33145":715,"_22633":56693,"_5":15597,"_29869":56576,"_3292":56694},[],"a consumer outage raises an alert.",{"_3839":767,"_33145":715,"_22633":56696,"_5":15597,"_29869":56576,"_3292":56697},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3839":768,"_33145":768,"_5":15996,"_3292":56699,"_33551":56700,"_22633":56701,"_29869":768},"Platform architecture",[54324,55792],[],{"_3839":769,"_33145":768,"_22633":56703,"_5":15597,"_29869":768,"_3292":56704},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3839":770,"_33145":768,"_5":33548,"_22633":56706,"_29869":56707,"_3292":56708},[],"/docs/pr-preview/pr-58/platform/concepts/architecture#control-plane","Control plane",{"_3839":771,"_33145":768,"_5":33548,"_22633":56710,"_29869":56711,"_3292":56712},[],"/docs/pr-preview/pr-58/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3839":772,"_33145":768,"_5":33548,"_22633":56714,"_29869":56715,"_3292":56716},[],"/docs/pr-preview/pr-58/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3839":773,"_33145":768,"_5":33548,"_22633":56718,"_29869":56719,"_3292":56720},[],"/docs/pr-preview/pr-58/platform/concepts/architecture#status-and-validation","Status and validation",{"_3839":774,"_33145":768,"_5":33548,"_22633":56722,"_29869":56723,"_3292":56724},[],"/docs/pr-preview/pr-58/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3839":775,"_33145":768,"_22633":56726,"_5":15597,"_29869":768,"_3292":56727},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3839":776,"_33145":768,"_22633":56729,"_5":15597,"_29869":768,"_3292":56730},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3839":777,"_33145":768,"_22633":56732,"_5":15597,"_29869":56707,"_3292":56733},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3839":778,"_33145":768,"_22633":56735,"_5":15597,"_29869":56711,"_3292":56736},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3839":779,"_33145":768,"_22633":56738,"_5":15597,"_29869":56715,"_3292":56739},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3839":780,"_33145":768,"_22633":56741,"_5":15597,"_29869":56719,"_3292":56742},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3839":781,"_33145":768,"_22633":56744,"_5":15597,"_29869":56723,"_3292":56745},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3839":782,"_33145":782,"_5":15996,"_3292":56747,"_33551":56748,"_22633":56749,"_29869":782},"How Lamassu works",[54324,55792],[],{"_3839":783,"_33145":782,"_22633":56751,"_5":15597,"_29869":782,"_3292":56752},[],"The mental model of trust, keys, certificates and devices.",{"_3839":784,"_33145":782,"_5":33548,"_22633":56754,"_29869":56755,"_3292":56756},[],"/docs/pr-preview/pr-58/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3839":785,"_33145":782,"_5":33548,"_22633":56758,"_29869":56759,"_3292":56760},[],"/docs/pr-preview/pr-58/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3839":786,"_33145":782,"_22633":56762,"_5":15597,"_29869":782,"_3292":56763},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3839":787,"_33145":782,"_22633":56765,"_5":15597,"_29869":56755,"_3292":56766},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3839":788,"_33145":782,"_22633":56768,"_5":15597,"_29869":56755,"_3292":56769},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3839":789,"_33145":782,"_22633":56771,"_5":15597,"_29869":56755,"_3292":56772},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3839":790,"_33145":782,"_22633":56774,"_5":15597,"_29869":56755,"_3292":56775},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3839":791,"_33145":782,"_22633":56777,"_5":15597,"_29869":56755,"_3292":56778},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3839":792,"_33145":782,"_22633":56780,"_5":15597,"_29869":56759,"_3292":56781},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3839":793,"_33145":782,"_22633":56783,"_5":15597,"_29869":56759,"_3292":56784},[],"A DMS relates that CA to an enrollment policy.",{"_3839":794,"_33145":782,"_22633":56786,"_5":15597,"_29869":56759,"_3292":56787},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3839":795,"_33145":782,"_22633":56789,"_5":15597,"_29869":56759,"_3292":56790},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3839":796,"_33145":782,"_22633":56792,"_5":15597,"_29869":56759,"_3292":56793},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3839":797,"_33145":782,"_22633":56795,"_5":15597,"_29869":56759,"_3292":56796},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3839":798,"_33145":782,"_22633":56798,"_5":15597,"_29869":56759,"_3292":56799},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3839":799,"_33145":799,"_5":15996,"_3292":56801,"_33551":56802,"_22633":56804,"_29869":799},"Devices and identities",[54324,55792,56803,56801],"IoT Fleets",[],{"_3839":800,"_33145":799,"_22633":56806,"_5":15597,"_29869":799,"_3292":56807},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3839":801,"_33145":799,"_5":33548,"_22633":56809,"_29869":56810,"_3292":56811},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#device-states","Device states",{"_3839":802,"_33145":799,"_5":33548,"_22633":56813,"_29869":56814,"_3292":56815},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3839":803,"_33145":799,"_5":33548,"_22633":56817,"_29869":56818,"_3292":56819},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3839":804,"_33145":799,"_5":33548,"_22633":56821,"_29869":56822,"_3292":56823},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3839":805,"_33145":799,"_5":33548,"_22633":56825,"_29869":56826,"_3292":56827},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3839":806,"_33145":799,"_5":33548,"_22633":56829,"_29869":56830,"_3292":56831},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3839":807,"_33145":799,"_5":33548,"_22633":56833,"_29869":56834,"_3292":56835},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3839":808,"_33145":799,"_5":33548,"_22633":56837,"_29869":56838,"_3292":56839},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3839":809,"_33145":799,"_5":33548,"_22633":56841,"_29869":56842,"_3292":56843},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3839":810,"_33145":799,"_5":33548,"_22633":56845,"_29869":56846,"_3292":56847},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3839":811,"_33145":799,"_5":33548,"_22633":56849,"_29869":56850,"_3292":56851},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3839":812,"_33145":799,"_22633":56853,"_5":15597,"_29869":799,"_3292":56854},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3839":813,"_33145":799,"_22633":56856,"_5":15597,"_29869":799,"_3292":56857},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3839":814,"_33145":799,"_22633":56859,"_5":15597,"_29869":56810,"_3292":56860},[],"Operational view",{"_3839":815,"_33145":799,"_22633":56862,"_5":15597,"_29869":56810,"_3292":56863},[],"Meaning",{"_3839":816,"_33145":799,"_22633":56865,"_5":15597,"_29869":56810,"_3292":56866},[],"**No Identity**",{"_3839":817,"_33145":799,"_22633":56868,"_5":15597,"_29869":56810,"_3292":56869},[],"A record exists without an associated identity.",{"_3839":818,"_33145":799,"_22633":56871,"_5":15597,"_29869":56810,"_3292":56872},[],"**Active**",{"_3839":819,"_33145":799,"_22633":56874,"_5":15597,"_29869":56810,"_3292":56875},[],"The slot is active; also check certificate dates, status and usages.",{"_3839":820,"_33145":799,"_22633":56877,"_5":15597,"_29869":56810,"_3292":56878},[],"**Renewal Pending**",{"_3839":821,"_33145":799,"_22633":56880,"_5":15597,"_29869":56810,"_3292":56881},[],"The identity is in the operational renewal window.",{"_3839":822,"_33145":799,"_22633":56883,"_5":15597,"_29869":56810,"_3292":56884},[],"**Expiring Soon**",{"_3839":823,"_33145":799,"_22633":56886,"_5":15597,"_29869":56810,"_3292":56887},[],"Expiration is approaching according to configured thresholds.",{"_3839":824,"_33145":799,"_22633":56889,"_5":15597,"_29869":56810,"_3292":56890},[],"**Expired**",{"_3839":825,"_33145":799,"_22633":56892,"_5":15597,"_29869":56810,"_3292":56893},[],"The identity has expired.",{"_3839":826,"_33145":799,"_22633":56895,"_5":15597,"_29869":56810,"_3292":56896},[],"**Revoked**",{"_3839":827,"_33145":799,"_22633":56898,"_5":15597,"_29869":56810,"_3292":56899},[],"The identity is marked revoked.",{"_3839":828,"_33145":799,"_22633":56901,"_5":15597,"_29869":56810,"_3292":56902},[],"**Decommissioned**",{"_3839":829,"_33145":799,"_22633":56904,"_5":15597,"_29869":56810,"_3292":56905},[],"The record is retired and ordinary updates do not restore operation.",{"_3839":830,"_33145":799,"_22633":56907,"_5":15597,"_29869":56810,"_3292":56908},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3839":831,"_33145":799,"_22633":56910,"_5":15597,"_29869":56814,"_3292":56911},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3839":832,"_33145":799,"_22633":56913,"_5":15597,"_29869":56814,"_3292":56914},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3839":833,"_33145":799,"_22633":56916,"_5":15597,"_29869":56814,"_3292":56917},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3839":834,"_33145":799,"_22633":56919,"_5":15597,"_29869":56814,"_3292":56920},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3839":835,"_33145":799,"_22633":56922,"_5":15597,"_29869":56818,"_3292":56923},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3839":836,"_33145":799,"_22633":56925,"_5":15597,"_29869":56822,"_3292":56926},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3839":837,"_33145":799,"_22633":56928,"_5":15597,"_29869":56826,"_3292":56929},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3839":838,"_33145":799,"_22633":56931,"_5":15597,"_29869":56830,"_3292":56932},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3839":839,"_33145":799,"_22633":56934,"_5":15597,"_29869":56834,"_3292":56935},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3839":840,"_33145":799,"_22633":56937,"_5":15597,"_29869":56834,"_3292":56938},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3839":841,"_33145":799,"_22633":56940,"_5":15597,"_29869":56838,"_3292":56941},[],"From **No Identity**, use **Assign Identity**:",{"_3839":842,"_33145":799,"_22633":56943,"_5":15597,"_29869":56838,"_3292":56944},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3839":843,"_33145":799,"_22633":56946,"_5":15597,"_29869":56838,"_3292":56947},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3839":844,"_33145":799,"_22633":56949,"_5":15597,"_29869":56838,"_3292":56950},[],"Confirm and read the serial, active version and history again.",{"_3839":845,"_33145":799,"_22633":56952,"_5":15597,"_29869":56838,"_3292":56953},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3839":846,"_33145":799,"_22633":56955,"_5":15597,"_29869":56838,"_3292":56956},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3839":847,"_33145":799,"_22633":56958,"_5":15597,"_29869":56842,"_3292":56959},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3839":848,"_33145":799,"_22633":56961,"_5":15597,"_29869":56842,"_3292":56962},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3839":849,"_33145":799,"_22633":56964,"_5":15597,"_29869":56846,"_3292":56965},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3839":850,"_33145":799,"_22633":56967,"_5":15597,"_29869":56846,"_3292":56968},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3839":851,"_33145":799,"_22633":56970,"_5":15597,"_29869":56846,"_3292":56971},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3839":852,"_33145":799,"_22633":56973,"_5":15597,"_29869":56846,"_3292":56974},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3839":853,"_33145":799,"_22633":56976,"_5":15597,"_29869":56850,"_3292":56977},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3839":854,"_33145":799,"_22633":56979,"_5":15597,"_29869":56850,"_3292":56980},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3839":855,"_33145":855,"_5":15996,"_3292":56982,"_33551":56983,"_22633":56985,"_29869":855},"Bootstrap identity and authentication",[54324,55792,56803,56801,56984],"Enrollment with PKI",[],{"_3839":856,"_33145":855,"_22633":56987,"_5":15597,"_29869":855,"_3292":56988},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3839":857,"_33145":855,"_5":33548,"_22633":56990,"_29869":56991,"_3292":56992},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3839":858,"_33145":855,"_5":33548,"_22633":56994,"_29869":56995,"_3292":56996},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3839":859,"_33145":855,"_5":33548,"_22633":56998,"_29869":56999,"_3292":57000},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3839":860,"_33145":855,"_5":33548,"_22633":57002,"_29869":57003,"_3292":57004},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3839":861,"_33145":855,"_5":33548,"_22633":57006,"_29869":57007,"_3292":57008},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3839":862,"_33145":855,"_22633":57010,"_5":15597,"_29869":855,"_3292":57011},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3839":863,"_33145":855,"_22633":57013,"_5":15597,"_29869":56991,"_3292":57014},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3839":864,"_33145":855,"_22633":57016,"_5":15597,"_29869":56991,"_3292":57017},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3839":865,"_33145":855,"_22633":57019,"_5":15597,"_29869":56995,"_3292":57020},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3839":866,"_33145":855,"_22633":57022,"_5":15597,"_29869":56995,"_3292":57023},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3839":867,"_33145":855,"_22633":57025,"_5":15597,"_29869":56995,"_3292":57026},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3839":868,"_33145":855,"_22633":57028,"_5":15597,"_29869":56999,"_3292":57029},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3839":869,"_33145":855,"_22633":57031,"_5":15597,"_29869":56999,"_3292":57032},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3839":870,"_33145":855,"_22633":57034,"_5":15597,"_29869":57003,"_3292":57035},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3839":871,"_33145":855,"_22633":57037,"_5":15597,"_29869":57003,"_3292":57038},[],"Example body:",{"_3839":872,"_33145":855,"_22633":57040,"_5":15597,"_29869":57003,"_3292":57041},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3839":873,"_33145":855,"_22633":57043,"_5":15597,"_29869":57003,"_3292":57044},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3839":874,"_33145":855,"_22633":57046,"_5":15597,"_29869":57003,"_3292":57047},[],"Continuation requires a successful HTTP response and JSON:",{"_3839":875,"_33145":855,"_22633":57049,"_5":15597,"_29869":57003,"_3292":57050},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3839":876,"_33145":855,"_22633":57052,"_5":15597,"_29869":57007,"_3292":57053},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3839":877,"_33145":855,"_22633":57055,"_5":15597,"_29869":57007,"_3292":57056},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3839":878,"_33145":878,"_5":15996,"_3292":57058,"_33551":57059,"_22633":57060,"_29869":878},"Configure and operate the DMS",[54324,55792,56803,56801,56984],[],{"_3839":879,"_33145":878,"_22633":57062,"_5":15597,"_29869":878,"_3292":57063},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3839":880,"_33145":878,"_5":33548,"_22633":57065,"_29869":57066,"_3292":54334},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3839":881,"_33145":878,"_5":33548,"_22633":57068,"_29869":57069,"_3292":57070},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3839":882,"_33145":878,"_5":33548,"_22633":57072,"_29869":57073,"_3292":57074},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3839":883,"_33145":878,"_5":33548,"_22633":57076,"_29869":57077,"_3292":57078},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3839":884,"_33145":878,"_5":33548,"_22633":57080,"_29869":57081,"_3292":57082},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3839":885,"_33145":878,"_5":33548,"_22633":57084,"_29869":57085,"_3292":57086},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3839":886,"_33145":878,"_5":33548,"_22633":57088,"_29869":57089,"_3292":57090},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3839":887,"_33145":878,"_5":33548,"_22633":57092,"_29869":57093,"_3292":57094},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3839":888,"_33145":878,"_5":33548,"_22633":57096,"_29869":57097,"_3292":57098},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3839":889,"_33145":878,"_5":33548,"_22633":57100,"_29869":57101,"_3292":57102},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3839":890,"_33145":878,"_5":33548,"_22633":57104,"_29869":57105,"_3292":57106},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3839":891,"_33145":878,"_5":33548,"_22633":57108,"_29869":57109,"_3292":57110},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3839":892,"_33145":878,"_5":33548,"_22633":57112,"_29869":57113,"_3292":57114},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3839":893,"_33145":878,"_5":33548,"_22633":57116,"_29869":57117,"_3292":57118},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3839":894,"_33145":878,"_5":33548,"_22633":57120,"_29869":57121,"_3292":57122},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3839":895,"_33145":878,"_5":33548,"_22633":57124,"_29869":57125,"_3292":57126},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3839":896,"_33145":878,"_5":33548,"_22633":57128,"_29869":57129,"_3292":57130},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3839":897,"_33145":878,"_5":33548,"_22633":57132,"_29869":57133,"_3292":57134},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3839":898,"_33145":878,"_22633":57136,"_5":15597,"_29869":878,"_3292":57137},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3839":899,"_33145":878,"_22633":57139,"_5":15597,"_29869":57066,"_3292":57140},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3839":900,"_33145":878,"_22633":57142,"_5":15597,"_29869":57066,"_3292":57143},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3839":901,"_33145":878,"_22633":57145,"_5":15597,"_29869":57073,"_3292":57146},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3839":902,"_33145":878,"_22633":57148,"_5":15597,"_29869":57077,"_3292":57149},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3839":903,"_33145":878,"_22633":57151,"_5":15597,"_29869":57081,"_3292":57152},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3839":904,"_33145":878,"_22633":57154,"_5":15597,"_29869":57085,"_3292":57155},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3839":905,"_33145":878,"_22633":57157,"_5":15597,"_29869":57089,"_3292":57158},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3839":906,"_33145":878,"_22633":57160,"_5":15597,"_29869":57097,"_3292":57161},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3839":907,"_33145":878,"_22633":57163,"_5":15597,"_29869":57097,"_3292":57164},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3839":908,"_33145":878,"_22633":57166,"_5":15597,"_29869":57101,"_3292":57167},[],"`settings.enrollment_settings` field",{"_3839":909,"_33145":878,"_22633":57169,"_5":15597,"_29869":57101,"_3292":57170},[],"Decision",{"_3839":910,"_33145":878,"_22633":57172,"_5":15597,"_29869":57101,"_3292":57173},[],"`protocol`",{"_3839":911,"_33145":878,"_22633":57175,"_5":15597,"_29869":57101,"_3292":57176},[],"`EST_RFC7030` for these operations.",{"_3839":912,"_33145":878,"_22633":57178,"_5":15597,"_29869":57101,"_3292":57179},[],"`enrollment_ca`",{"_3839":913,"_33145":878,"_22633":57181,"_5":15597,"_29869":57101,"_3292":57182},[],"ID of the signing CA.",{"_3839":914,"_33145":878,"_22633":57184,"_5":15597,"_29869":57101,"_3292":57185},[],"`verify_csr_signature`",{"_3839":915,"_33145":878,"_22633":57187,"_5":15597,"_29869":57101,"_3292":57188},[],"Keep `true` to verify CSR key possession.",{"_3839":916,"_33145":878,"_22633":57190,"_5":15597,"_29869":57101,"_3292":57191},[],"`enable_replaceable_enrollment`",{"_3839":917,"_33145":878,"_22633":57193,"_5":15597,"_29869":57101,"_3292":57194},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3839":918,"_33145":878,"_22633":57196,"_5":15597,"_29869":57101,"_3292":57197},[],"`est_rfc7030_settings.auth_mode`",{"_3839":919,"_33145":878,"_22633":57199,"_5":15597,"_29869":57101,"_3292":57200},[],"One of the four authentication modes.",{"_3839":920,"_33145":878,"_22633":57202,"_5":15597,"_29869":57101,"_3292":57203},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3839":921,"_33145":878,"_22633":57205,"_5":15597,"_29869":57105,"_3292":57206},[],"The blocks are independent:",{"_3839":922,"_33145":878,"_22633":57208,"_5":15597,"_29869":57105,"_3292":57209},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3839":923,"_33145":878,"_22633":57211,"_5":15597,"_29869":57105,"_3292":57212},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3839":924,"_33145":878,"_22633":57214,"_5":15597,"_29869":57105,"_3292":57215},[],"`auth_mode`",{"_3839":925,"_33145":878,"_22633":57217,"_5":15597,"_29869":57105,"_3292":57218},[],"Control applied in the configured operation",{"_3839":926,"_33145":878,"_22633":57220,"_5":15597,"_29869":57105,"_3292":57221},[],"`CLIENT_CERTIFICATE`",{"_3839":927,"_33145":878,"_22633":57223,"_5":15597,"_29869":57105,"_3292":57224},[],"Presented certificate validation.",{"_3839":928,"_33145":878,"_22633":57226,"_5":15597,"_29869":57105,"_3292":57227},[],"`EXTERNAL_WEBHOOK`",{"_3839":929,"_33145":878,"_22633":57229,"_5":15597,"_29869":57105,"_3292":57230},[],"Configured webhook authorization.",{"_3839":930,"_33145":878,"_22633":57232,"_5":15597,"_29869":57105,"_3292":57233},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3839":931,"_33145":878,"_22633":57235,"_5":15597,"_29869":57105,"_3292":57236},[],"Certificate validation followed by webhook approval.",{"_3839":932,"_33145":878,"_22633":57238,"_5":15597,"_29869":57105,"_3292":57239},[],"`NO_AUTH`",{"_3839":933,"_33145":878,"_22633":57241,"_5":15597,"_29869":57105,"_3292":57242},[],"No DMS requester authentication.",{"_3839":934,"_33145":878,"_22633":57244,"_5":15597,"_29869":57105,"_3292":57245},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3839":935,"_33145":878,"_22633":57247,"_5":15597,"_29869":57105,"_3292":57248},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3839":936,"_33145":878,"_22633":57250,"_5":15597,"_29869":57105,"_3292":57251},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3839":937,"_33145":878,"_22633":57253,"_5":15597,"_29869":57105,"_3292":57254},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3839":938,"_33145":878,"_22633":57256,"_5":15597,"_29869":57109,"_3292":57257},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3839":939,"_33145":878,"_22633":57259,"_5":15597,"_29869":57109,"_3292":57260},[],"`external_webhook_settings` field",{"_3839":940,"_33145":878,"_22633":57262,"_5":15597,"_29869":57109,"_3292":57170},[],{"_3839":941,"_33145":878,"_22633":57264,"_5":15597,"_29869":57109,"_3292":57265},[],"`url`",{"_3839":942,"_33145":878,"_22633":57267,"_5":15597,"_29869":57109,"_3292":57268},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3839":943,"_33145":878,"_22633":57270,"_5":15597,"_29869":57109,"_3292":57271},[],"`method`",{"_3839":944,"_33145":878,"_22633":57273,"_5":15597,"_29869":57109,"_3292":57274},[],"`POST` or `PUT`; `POST` by default.",{"_3839":945,"_33145":878,"_22633":57276,"_5":15597,"_29869":57109,"_3292":57277},[],"`name`",{"_3839":946,"_33145":878,"_22633":57279,"_5":15597,"_29869":57109,"_3292":57280},[],"Label used in service logs.",{"_3839":947,"_33145":878,"_22633":57282,"_5":15597,"_29869":57109,"_3292":57283},[],"`config.auth_mode`",{"_3839":948,"_33145":878,"_22633":57285,"_5":15597,"_29869":57109,"_3292":57286},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3839":949,"_33145":878,"_22633":57288,"_5":15597,"_29869":57109,"_3292":57289},[],"`config.log_level`",{"_3839":950,"_33145":878,"_22633":57291,"_5":15597,"_29869":57109,"_3292":57292},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3839":951,"_33145":878,"_22633":57294,"_5":15597,"_29869":57109,"_3292":57295},[],"`config.apikey_options`",{"_3839":952,"_33145":878,"_22633":57297,"_5":15597,"_29869":57109,"_3292":57298},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3839":953,"_33145":878,"_22633":57300,"_5":15597,"_29869":57109,"_3292":57301},[],"`config.jwt_options`",{"_3839":954,"_33145":878,"_22633":57303,"_5":15597,"_29869":57109,"_3292":57304},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3839":955,"_33145":878,"_22633":57306,"_5":15597,"_29869":57109,"_3292":57307},[],"`config.mtls_options`",{"_3839":956,"_33145":878,"_22633":57309,"_5":15597,"_29869":57109,"_3292":57310},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3839":957,"_33145":878,"_22633":57312,"_5":15597,"_29869":57109,"_3292":57313},[],"`config.insecure_skip_verify`",{"_3839":958,"_33145":878,"_22633":57315,"_5":15597,"_29869":57109,"_3292":57316},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3839":959,"_33145":878,"_22633":57318,"_5":15597,"_29869":57109,"_3292":57319},[],"`config.call_timeout`",{"_3839":960,"_33145":878,"_22633":57321,"_5":15597,"_29869":57109,"_3292":57322},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3839":961,"_33145":878,"_22633":57324,"_5":15597,"_29869":57109,"_3292":57325},[],"Rules for that configuration:",{"_3839":962,"_33145":878,"_22633":57327,"_5":15597,"_29869":57109,"_3292":57328},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3839":963,"_33145":878,"_22633":57330,"_5":15597,"_29869":57109,"_3292":57331},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3839":964,"_33145":878,"_22633":57333,"_5":15597,"_29869":57109,"_3292":57334},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3839":965,"_33145":878,"_22633":57336,"_5":15597,"_29869":57109,"_3292":57337},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3839":966,"_33145":878,"_22633":57339,"_5":15597,"_29869":57109,"_3292":57340},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3839":967,"_33145":878,"_22633":57342,"_5":15597,"_29869":57109,"_3292":57343},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3839":968,"_33145":878,"_22633":57345,"_5":15597,"_29869":57109,"_3292":57346},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3839":969,"_33145":878,"_22633":57348,"_5":15597,"_29869":57109,"_3292":57349},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3839":970,"_33145":878,"_22633":57351,"_5":15597,"_29869":57109,"_3292":57352},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3839":971,"_33145":878,"_22633":57354,"_5":15597,"_29869":57113,"_3292":57355},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3839":972,"_33145":878,"_22633":57357,"_5":15597,"_29869":57117,"_3292":57358},[],"`settings.reenrollment_settings` field",{"_3839":973,"_33145":878,"_22633":57360,"_5":15597,"_29869":57117,"_3292":54714},[],{"_3839":974,"_33145":878,"_22633":57362,"_5":15597,"_29869":57117,"_3292":57363},[],"`reenrollment_delta`",{"_3839":975,"_33145":878,"_22633":57365,"_5":15597,"_29869":57117,"_3292":57366},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3839":976,"_33145":878,"_22633":57368,"_5":15597,"_29869":57117,"_3292":57369},[],"`preventive_delta`",{"_3839":977,"_33145":878,"_22633":57371,"_5":15597,"_29869":57117,"_3292":57372},[],"Preventive operational monitoring threshold.",{"_3839":978,"_33145":878,"_22633":57374,"_5":15597,"_29869":57117,"_3292":57375},[],"`critical_delta`",{"_3839":979,"_33145":878,"_22633":57377,"_5":15597,"_29869":57117,"_3292":57378},[],"Critical operational monitoring threshold.",{"_3839":980,"_33145":878,"_22633":57380,"_5":15597,"_29869":57117,"_3292":57381},[],"`enable_expired_renewal`",{"_3839":981,"_33145":878,"_22633":57383,"_5":15597,"_29869":57117,"_3292":57384},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3839":982,"_33145":878,"_22633":57386,"_5":15597,"_29869":57117,"_3292":57387},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3839":983,"_33145":878,"_22633":57389,"_5":15597,"_29869":57117,"_3292":57390},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3839":984,"_33145":878,"_22633":57392,"_5":15597,"_29869":57117,"_3292":57393},[],"`revoke_on_reenrollment`",{"_3839":985,"_33145":878,"_22633":57395,"_5":15597,"_29869":57117,"_3292":57396},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3839":986,"_33145":878,"_22633":57398,"_5":15597,"_29869":57117,"_3292":57399},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3839":987,"_33145":878,"_22633":57401,"_5":15597,"_29869":57121,"_3292":57402},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3839":988,"_33145":878,"_22633":57404,"_5":15597,"_29869":57125,"_3292":54708},[],{"_3839":989,"_33145":878,"_22633":57406,"_5":15597,"_29869":57125,"_3292":57407},[],"Published material",{"_3839":990,"_33145":878,"_22633":57409,"_5":15597,"_29869":57125,"_3292":57410},[],"**Include Lamassu System CA**",{"_3839":991,"_33145":878,"_22633":57412,"_5":15597,"_29869":57125,"_3292":57413},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3839":992,"_33145":878,"_22633":57415,"_5":15597,"_29869":57125,"_3292":57416},[],"**Include Enrollment CA**",{"_3839":993,"_33145":878,"_22633":57418,"_5":15597,"_29869":57125,"_3292":57419},[],"Selected issuing CA certificate.",{"_3839":994,"_33145":878,"_22633":57421,"_5":15597,"_29869":57125,"_3292":57422},[],"**Managed CAs**",{"_3839":995,"_33145":878,"_22633":57424,"_5":15597,"_29869":57125,"_3292":57425},[],"Explicitly selected CA certificates.",{"_3839":996,"_33145":878,"_22633":57427,"_5":15597,"_29869":57125,"_3292":57428},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3839":997,"_33145":878,"_22633":57430,"_5":15597,"_29869":57129,"_3292":57431},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3839":998,"_33145":878,"_22633":57433,"_5":15597,"_29869":57129,"_3292":57434},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3839":999,"_33145":878,"_22633":57436,"_5":15597,"_29869":57129,"_3292":57437},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3839":1000,"_33145":878,"_22633":57439,"_5":15597,"_29869":57133,"_3292":57440},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3839":1001,"_33145":1001,"_5":15996,"_3292":57442,"_33551":57443,"_22633":57444,"_29869":1001},"Integrate the EST client",[54324,55792,56803,56801,56984],[],{"_3839":1002,"_33145":1001,"_22633":57446,"_5":15597,"_29869":1001,"_3292":57447},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3839":1003,"_33145":1001,"_5":33548,"_22633":57449,"_29869":57450,"_3292":54334},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3839":1004,"_33145":1001,"_5":33548,"_22633":57452,"_29869":57453,"_3292":57454},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3839":1005,"_33145":1001,"_5":33548,"_22633":57456,"_29869":57457,"_3292":57458},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3839":1006,"_33145":1001,"_5":33548,"_22633":57460,"_29869":57461,"_3292":57462},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3839":1007,"_33145":1001,"_5":33548,"_22633":57464,"_29869":57465,"_3292":57466},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3839":1008,"_33145":1001,"_5":33548,"_22633":57468,"_29869":57469,"_3292":57470},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3839":1009,"_33145":1001,"_22633":57472,"_5":15597,"_29869":1001,"_3292":57473},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3839":1010,"_33145":1001,"_22633":57475,"_5":15597,"_29869":57450,"_3292":57476},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3839":1011,"_33145":1001,"_22633":57478,"_5":15597,"_29869":57450,"_3292":57479},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3839":1012,"_33145":1001,"_22633":57481,"_5":15597,"_29869":57450,"_3292":57482},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3839":1013,"_33145":1001,"_22633":57484,"_5":15597,"_29869":57453,"_3292":57485},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3839":1014,"_33145":1001,"_22633":57487,"_5":15597,"_29869":57453,"_3292":57488},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3839":1015,"_33145":1001,"_22633":57490,"_5":15597,"_29869":57457,"_3292":57491},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3839":1016,"_33145":1001,"_22633":57493,"_5":15597,"_29869":57457,"_3292":57494},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3839":1017,"_33145":1001,"_22633":57496,"_5":15597,"_29869":57461,"_3292":57497},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3839":1018,"_33145":1001,"_22633":57499,"_5":15597,"_29869":57461,"_3292":57500},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3839":1019,"_33145":1001,"_22633":57502,"_5":15597,"_29869":57465,"_3292":57503},[],"For a root that issues directly:",{"_3839":1020,"_33145":1001,"_22633":57505,"_5":15597,"_29869":57465,"_3292":57506},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3839":1021,"_33145":1001,"_22633":57508,"_5":15597,"_29869":57465,"_3292":57509},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3839":1022,"_33145":1001,"_22633":57511,"_5":15597,"_29869":57469,"_3292":57512},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3839":1023,"_33145":1023,"_5":15996,"_3292":57514,"_33551":57515,"_22633":57516,"_29869":1023},"EST reference",[54324,55792,56803,56801,56984],[],{"_3839":1024,"_33145":1023,"_22633":57518,"_5":15597,"_29869":1023,"_3292":57519},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3839":1025,"_33145":1023,"_5":33548,"_22633":57521,"_29869":57522,"_3292":57523},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3839":1026,"_33145":1023,"_5":33548,"_22633":57525,"_29869":57526,"_3292":24604},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3839":1027,"_33145":1023,"_5":33548,"_22633":57528,"_29869":57529,"_3292":28246},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3839":1028,"_33145":1023,"_5":33548,"_22633":57531,"_29869":57532,"_3292":28253},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3839":1029,"_33145":1023,"_5":33548,"_22633":57534,"_29869":57535,"_3292":27493},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3839":1030,"_33145":1023,"_5":33548,"_22633":57537,"_29869":57538,"_3292":57539},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3839":1031,"_33145":1023,"_5":33548,"_22633":57541,"_29869":57542,"_3292":57543},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3839":1032,"_33145":1023,"_5":33548,"_22633":57545,"_29869":57546,"_3292":57547},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3839":1033,"_33145":1023,"_22633":57549,"_5":15597,"_29869":1023,"_3292":57550},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3839":1034,"_33145":1023,"_22633":57552,"_5":15597,"_29869":57522,"_3292":57553},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3839":1035,"_33145":1023,"_22633":57555,"_5":15597,"_29869":57522,"_3292":57556},[],"Operation",{"_3839":1036,"_33145":1023,"_22633":57558,"_5":15597,"_29869":57522,"_3292":57559},[],"Method",{"_3839":1037,"_33145":1023,"_22633":57561,"_5":15597,"_29869":57522,"_3292":57562},[],"Authentication and condition",{"_3839":1038,"_33145":1023,"_22633":57564,"_5":15597,"_29869":57522,"_3292":57565},[],"`/cacerts`",{"_3839":1039,"_33145":1023,"_22633":57567,"_5":15597,"_29869":57522,"_3292":57568},[],"GET",{"_3839":1040,"_33145":1023,"_22633":57570,"_5":15597,"_29869":57522,"_3292":57571},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3839":1041,"_33145":1023,"_22633":57573,"_5":15597,"_29869":57522,"_3292":57574},[],"`/simpleenroll`",{"_3839":1042,"_33145":1023,"_22633":57576,"_5":15597,"_29869":57522,"_3292":57577},[],"POST",{"_3839":1043,"_33145":1023,"_22633":57579,"_5":15597,"_29869":57522,"_3292":57580},[],"Initial authentication and DMS registration/replacement policy.",{"_3839":1044,"_33145":1023,"_22633":57582,"_5":15597,"_29869":57522,"_3292":57583},[],"`/simplereenroll`",{"_3839":1045,"_33145":1023,"_22633":57585,"_5":15597,"_29869":57522,"_3292":57577},[],{"_3839":1046,"_33145":1023,"_22633":57587,"_5":15597,"_29869":57522,"_3292":57588},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3839":1047,"_33145":1023,"_22633":57590,"_5":15597,"_29869":57522,"_3292":57591},[],"`/serverkeygen`",{"_3839":1048,"_33145":1023,"_22633":57593,"_5":15597,"_29869":57522,"_3292":57577},[],{"_3839":1049,"_33145":1023,"_22633":57595,"_5":15597,"_29869":57522,"_3292":57596},[],"Initial authentication and admission; server generation enabled.",{"_3839":1050,"_33145":1023,"_22633":57598,"_5":15597,"_29869":57522,"_3292":57599},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3839":1051,"_33145":1023,"_22633":57601,"_5":15597,"_29869":57526,"_3292":57602},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3839":1052,"_33145":1023,"_22633":57604,"_5":15597,"_29869":57526,"_3292":57605},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3839":1053,"_33145":1023,"_22633":57607,"_5":15597,"_29869":57529,"_3292":57608},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3839":1054,"_33145":1023,"_22633":57610,"_5":15597,"_29869":57529,"_3292":57611},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3839":1055,"_33145":1023,"_22633":57613,"_5":15597,"_29869":57532,"_3292":57614},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3839":1056,"_33145":1023,"_22633":57616,"_5":15597,"_29869":57532,"_3292":57617},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3839":1057,"_33145":1023,"_22633":57619,"_5":15597,"_29869":57535,"_3292":57620},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3839":1058,"_33145":1023,"_22633":57622,"_5":15597,"_29869":57535,"_3292":57623},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3839":1059,"_33145":1023,"_22633":57625,"_5":15597,"_29869":57538,"_3292":57626},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3839":1060,"_33145":1023,"_22633":57628,"_5":15597,"_29869":57538,"_3292":57629},[],"Part",{"_3839":1061,"_33145":1023,"_22633":57631,"_5":15597,"_29869":57538,"_3292":57632},[],"Content after decoding its Base64",{"_3839":1062,"_33145":1023,"_22633":57634,"_5":15597,"_29869":57538,"_3292":57635},[],"`application/pkcs8`",{"_3839":1063,"_33145":1023,"_22633":57637,"_5":15597,"_29869":57538,"_3292":57638},[],"Unencrypted DER PKCS#8 private key.",{"_3839":1064,"_33145":1023,"_22633":57640,"_5":15597,"_29869":57538,"_3292":57641},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3839":1065,"_33145":1023,"_22633":57643,"_5":15597,"_29869":57538,"_3292":57644},[],"DER PKCS#7 containing the issued certificate.",{"_3839":1066,"_33145":1023,"_22633":57646,"_5":15597,"_29869":57538,"_3292":57647},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3839":1067,"_33145":1023,"_22633":57649,"_5":15597,"_29869":57542,"_3292":57650},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3839":1068,"_33145":1023,"_22633":57652,"_5":15597,"_29869":57542,"_3292":57653},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3839":1069,"_33145":1023,"_22633":57655,"_5":15597,"_29869":57542,"_3292":57656},[],"Convert and check the result:",{"_3839":1070,"_33145":1023,"_22633":57658,"_5":15597,"_29869":57542,"_3292":57659},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3839":1071,"_33145":1023,"_22633":57661,"_5":15597,"_29869":57546,"_3292":57662},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3839":1072,"_33145":1023,"_22633":57664,"_5":15597,"_29869":57546,"_3292":57665},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3839":1073,"_33145":1073,"_5":15996,"_3292":56984,"_33551":57667,"_22633":57668,"_29869":1073},[54324,55792,56803,56801,56984],[],{"_3839":1074,"_33145":1073,"_22633":57670,"_5":15597,"_29869":1073,"_3292":57671},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3839":1075,"_33145":1073,"_5":33548,"_22633":57673,"_29869":57674,"_3292":57675},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3839":1076,"_33145":1073,"_5":33548,"_22633":57677,"_29869":57678,"_3292":57679},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3839":1077,"_33145":1073,"_5":33548,"_22633":57681,"_29869":57682,"_3292":57683},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3839":1078,"_33145":1073,"_5":33548,"_22633":57685,"_29869":57686,"_3292":57687},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3839":1079,"_33145":1073,"_22633":57689,"_5":15597,"_29869":1073,"_3292":57690},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3839":1080,"_33145":1073,"_22633":57692,"_5":15597,"_29869":57674,"_3292":57693},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3839":1081,"_33145":1073,"_22633":57695,"_5":15597,"_29869":57674,"_3292":57696},[],"The integrator installs initial EST server trust and an admission credential.",{"_3839":1082,"_33145":1073,"_22633":57698,"_5":15597,"_29869":57674,"_3292":57699},[],"The client requests an identity for its `Device ID` through EST.",{"_3839":1083,"_33145":1073,"_22633":57701,"_5":15597,"_29869":57674,"_3292":57702},[],"Certificate, device binding and key/certificate installation are checked.",{"_3839":1084,"_33145":1073,"_22633":57704,"_5":15597,"_29869":57674,"_3292":57705},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3839":1085,"_33145":1073,"_22633":57707,"_5":15597,"_29869":57674,"_3292":57708},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3839":1086,"_33145":1073,"_22633":57710,"_5":15597,"_29869":57678,"_3292":57711},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3839":1087,"_33145":1073,"_22633":57713,"_5":15597,"_29869":57678,"_3292":57714},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3839":1088,"_33145":1073,"_22633":57716,"_5":15597,"_29869":57678,"_3292":57717},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3839":1089,"_33145":1073,"_22633":57719,"_5":15597,"_29869":57678,"_3292":57720},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3839":1090,"_33145":1073,"_22633":57722,"_5":15597,"_29869":57682,"_3292":57723},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3839":1091,"_33145":1073,"_22633":57725,"_5":15597,"_29869":57682,"_3292":57726},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3839":1092,"_33145":1073,"_22633":57728,"_5":15597,"_29869":57682,"_3292":57729},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3839":1093,"_33145":1073,"_22633":57731,"_5":15597,"_29869":57682,"_3292":57732},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3839":1094,"_33145":1073,"_22633":57734,"_5":15597,"_29869":57686,"_3292":57735},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3839":1095,"_33145":1073,"_22633":57737,"_5":15597,"_29869":57686,"_3292":57738},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3839":1096,"_33145":1096,"_5":15996,"_3292":57740,"_33551":57741,"_22633":57742,"_29869":1096},"Provisioning strategies",[54324,55792,56803,56801,56984],[],{"_3839":1097,"_33145":1096,"_22633":57744,"_5":15597,"_29869":1096,"_3292":57745},[],"Choose device registration, identity authorization and key generation.",{"_3839":1098,"_33145":1096,"_5":33548,"_22633":57747,"_29869":57748,"_3292":57749},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3839":1099,"_33145":1096,"_5":33548,"_22633":57751,"_29869":57752,"_3292":57753},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3839":1100,"_33145":1096,"_5":33548,"_22633":57755,"_29869":57756,"_3292":57757},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3839":1101,"_33145":1096,"_5":33548,"_22633":57759,"_29869":57760,"_3292":57761},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3839":1102,"_33145":1096,"_5":33548,"_22633":57763,"_29869":57764,"_3292":57765},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3839":1103,"_33145":1096,"_22633":57767,"_5":15597,"_29869":1096,"_3292":57768},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3839":1104,"_33145":1096,"_22633":57770,"_5":15597,"_29869":57748,"_3292":57771},[],"Path",{"_3839":1105,"_33145":1096,"_22633":57773,"_5":15597,"_29869":57748,"_3292":57774},[],"When the device exists",{"_3839":1106,"_33145":1096,"_22633":57776,"_5":15597,"_29869":57748,"_3292":57777},[],"What to check",{"_3839":1107,"_33145":1096,"_22633":57779,"_5":15597,"_29869":57748,"_3292":57780},[],"Manual assignment",{"_3839":1108,"_33145":1096,"_22633":57782,"_5":15597,"_29869":57748,"_3292":57783},[],"An operator creates it before associating a certificate.",{"_3839":1109,"_33145":1096,"_22633":57785,"_5":15597,"_29869":57748,"_3292":57786},[],"ID, owning DMS, certificate CN and bound serial.",{"_3839":1110,"_33145":1096,"_22633":57788,"_5":15597,"_29869":57748,"_3292":57789},[],"EST with `JITP`",{"_3839":1111,"_33145":1096,"_22633":57791,"_5":15597,"_29869":57748,"_3292":57792},[],"Created for an unknown CN during `/simpleenroll`.",{"_3839":1112,"_33145":1096,"_22633":57794,"_5":15597,"_29869":57748,"_3292":57795},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3839":1113,"_33145":1096,"_22633":57797,"_5":15597,"_29869":57748,"_3292":57798},[],"EST with `PRE_REGISTRATION`",{"_3839":1114,"_33145":1096,"_22633":57800,"_5":15597,"_29869":57748,"_3292":57801},[],"Must exist before `/simpleenroll`.",{"_3839":1115,"_33145":1096,"_22633":57803,"_5":15597,"_29869":57748,"_3292":57804},[],"Approved record, same DMS and replacement conditions for your version.",{"_3839":1116,"_33145":1096,"_22633":57806,"_5":15597,"_29869":57748,"_3292":57807},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3839":1117,"_33145":1096,"_22633":57809,"_5":15597,"_29869":57748,"_3292":57810},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3839":1118,"_33145":1096,"_22633":57812,"_5":15597,"_29869":57752,"_3292":57813},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3839":1119,"_33145":1096,"_22633":57815,"_5":15597,"_29869":57752,"_3292":57816},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3839":1120,"_33145":1096,"_22633":57818,"_5":15597,"_29869":57752,"_3292":57819},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3839":1121,"_33145":1096,"_22633":57821,"_5":15597,"_29869":57756,"_3292":57822},[],"Decide initial enrollment and re-enrollment separately:",{"_3839":1122,"_33145":1096,"_22633":57824,"_5":15597,"_29869":57756,"_3292":57825},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3839":1123,"_33145":1096,"_22633":57827,"_5":15597,"_29869":57756,"_3292":57828},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3839":1124,"_33145":1096,"_22633":57830,"_5":15597,"_29869":57756,"_3292":57831},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3839":1125,"_33145":1096,"_22633":57833,"_5":15597,"_29869":57756,"_3292":57834},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3839":1126,"_33145":1096,"_22633":57836,"_5":15597,"_29869":57756,"_3292":57837},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3839":1127,"_33145":1096,"_22633":57839,"_5":15597,"_29869":57760,"_3292":54708},[],{"_3839":1128,"_33145":1096,"_22633":57841,"_5":15597,"_29869":57760,"_3292":57842},[],"Material crossing EST",{"_3839":1129,"_33145":1096,"_22633":57844,"_5":15597,"_29869":57760,"_3292":57845},[],"Device-generated key",{"_3839":1130,"_33145":1096,"_22633":57847,"_5":15597,"_29869":57760,"_3292":57848},[],"Public CSR and certificate; the key stays on the client.",{"_3839":1131,"_33145":1096,"_22633":57850,"_5":15597,"_29869":57760,"_3292":57851},[],"Existing device key",{"_3839":1132,"_33145":1096,"_22633":57853,"_5":15597,"_29869":57760,"_3292":57854},[],"CSR signed with that key and a new certificate.",{"_3839":1133,"_33145":1096,"_22633":57856,"_5":15597,"_29869":57760,"_3292":57122},[],{"_3839":1134,"_33145":1096,"_22633":57858,"_5":15597,"_29869":57760,"_3292":57859},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3839":1135,"_33145":1096,"_22633":57861,"_5":15597,"_29869":57760,"_3292":57862},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3839":1136,"_33145":1096,"_22633":57864,"_5":15597,"_29869":57764,"_3292":57865},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3839":1137,"_33145":1137,"_5":15996,"_3292":57867,"_33551":57868,"_22633":57869,"_29869":1137},"Renewal and recovery",[54324,55792,56803,56801,56984],[],{"_3839":1138,"_33145":1137,"_22633":57871,"_5":15597,"_29869":1137,"_3292":57872},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3839":1139,"_33145":1137,"_5":33548,"_22633":57874,"_29869":57875,"_3292":57876},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3839":1140,"_33145":1137,"_5":33548,"_22633":57878,"_29869":57879,"_3292":57880},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3839":1141,"_33145":1137,"_5":33548,"_22633":57882,"_29869":57883,"_3292":57884},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3839":1142,"_33145":1137,"_5":33548,"_22633":57886,"_29869":57887,"_3292":57888},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3839":1143,"_33145":1137,"_5":33548,"_22633":57890,"_29869":57891,"_3292":57892},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3839":1144,"_33145":1137,"_22633":57894,"_5":15597,"_29869":1137,"_3292":57895},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3839":1145,"_33145":1137,"_22633":57897,"_5":15597,"_29869":57875,"_3292":57898},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3839":1146,"_33145":1137,"_22633":57900,"_5":15597,"_29869":57875,"_3292":57901},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3839":1147,"_33145":1137,"_22633":57903,"_5":15597,"_29869":57875,"_3292":57904},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3839":1148,"_33145":1137,"_22633":57906,"_5":15597,"_29869":57875,"_3292":57907},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3839":1149,"_33145":1137,"_22633":57909,"_5":15597,"_29869":57879,"_3292":57910},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3839":1150,"_33145":1137,"_22633":57912,"_5":15597,"_29869":57879,"_3292":57913},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3839":1151,"_33145":1137,"_22633":57915,"_5":15597,"_29869":57883,"_3292":57916},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3839":1152,"_33145":1137,"_22633":57918,"_5":15597,"_29869":57883,"_3292":57919},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3839":1153,"_33145":1137,"_22633":57921,"_5":15597,"_29869":57883,"_3292":57922},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3839":1154,"_33145":1137,"_22633":57924,"_5":15597,"_29869":57887,"_3292":57925},[],"Situation",{"_3839":1155,"_33145":1137,"_22633":57927,"_5":15597,"_29869":57887,"_3292":57928},[],"Procedure",{"_3839":1156,"_33145":1137,"_22633":57930,"_5":15597,"_29869":57887,"_3292":57931},[],"Valid certificate, outside the window",{"_3839":1157,"_33145":1137,"_22633":57933,"_5":15597,"_29869":57887,"_3292":57934},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3839":1158,"_33145":1137,"_22633":57936,"_5":15597,"_29869":57887,"_3292":57937},[],"Expired certificate, key available",{"_3839":1159,"_33145":1137,"_22633":57939,"_5":15597,"_29869":57887,"_3292":57940},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3839":1160,"_33145":1137,"_22633":57942,"_5":15597,"_29869":57887,"_3292":57943},[],"Renewal through webhook or `NO_AUTH`",{"_3839":1161,"_33145":1137,"_22633":57945,"_5":15597,"_29869":57887,"_3292":57946},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3839":1162,"_33145":1137,"_22633":57948,"_5":15597,"_29869":57887,"_3292":57949},[],"Lost or inaccessible key",{"_3839":1163,"_33145":1137,"_22633":57951,"_5":15597,"_29869":57887,"_3292":57952},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3839":1164,"_33145":1137,"_22633":57954,"_5":15597,"_29869":57887,"_3292":57955},[],"Current identity revoked",{"_3839":1165,"_33145":1137,"_22633":57957,"_5":15597,"_29869":57887,"_3292":57958},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3839":1166,"_33145":1137,"_22633":57960,"_5":15597,"_29869":57887,"_3292":57961},[],"Device without an identity",{"_3839":1167,"_33145":1137,"_22633":57963,"_5":15597,"_29869":57887,"_3292":57964},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3839":1168,"_33145":1137,"_22633":57966,"_5":15597,"_29869":57887,"_3292":57967},[],"Retired device",{"_3839":1169,"_33145":1137,"_22633":57969,"_5":15597,"_29869":57887,"_3292":57970},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3839":1170,"_33145":1137,"_22633":57972,"_5":15597,"_29869":57887,"_3292":57973},[],"Timeout, HTTP 500 or installation failure",{"_3839":1171,"_33145":1137,"_22633":57975,"_5":15597,"_29869":57887,"_3292":57976},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3839":1172,"_33145":1137,"_22633":57978,"_5":15597,"_29869":57891,"_3292":57979},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3839":1173,"_33145":1137,"_22633":57981,"_5":15597,"_29869":57891,"_3292":57982},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3839":1174,"_33145":1174,"_5":15996,"_3292":57984,"_33551":57985,"_22633":57986,"_29869":1174},"Enrollment troubleshooting",[54324,55792,56803,56801,56984],[],{"_3839":1175,"_33145":1174,"_22633":57988,"_5":15597,"_29869":1174,"_3292":57989},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3839":1176,"_33145":1174,"_5":33548,"_22633":57991,"_29869":57992,"_3292":57993},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3839":1177,"_33145":1174,"_5":33548,"_22633":57995,"_29869":57996,"_3292":57997},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3839":1178,"_33145":1174,"_5":33548,"_22633":57999,"_29869":58000,"_3292":57547},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3839":1179,"_33145":1174,"_5":33548,"_22633":58002,"_29869":58003,"_3292":58004},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3839":1180,"_33145":1174,"_22633":58006,"_5":15597,"_29869":1174,"_3292":58007},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3839":1181,"_33145":1174,"_22633":58009,"_5":15597,"_29869":57996,"_3292":58010},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3839":1182,"_33145":1174,"_22633":58012,"_5":15597,"_29869":57996,"_3292":58013},[],"Symptom or message",{"_3839":1183,"_33145":1174,"_22633":58015,"_5":15597,"_29869":57996,"_3292":57777},[],{"_3839":1184,"_33145":1174,"_22633":58017,"_5":15597,"_29869":57996,"_3292":58018},[],"curl rejects TLS, name or issuer",{"_3839":1185,"_33145":1174,"_22633":58020,"_5":15597,"_29869":57996,"_3292":58021},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3839":1186,"_33145":1174,"_22633":58023,"_5":15597,"_29869":57996,"_3292":58024},[],"404 or missing APS",{"_3839":1187,"_33145":1174,"_22633":58026,"_5":15597,"_29869":57996,"_3292":58027},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3839":1188,"_33145":1174,"_22633":58029,"_5":15597,"_29869":57996,"_3292":58030},[],"400, CSR or format error",{"_3839":1189,"_33145":1174,"_22633":58032,"_5":15597,"_29869":57996,"_3292":58033},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3839":1190,"_33145":1174,"_22633":58035,"_5":15597,"_29869":57996,"_3292":58036},[],"Missing credential or invalid certificate",{"_3839":1191,"_33145":1174,"_22633":58038,"_5":15597,"_29869":57996,"_3292":58039},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3839":1192,"_33145":1174,"_22633":58041,"_5":15597,"_29869":57996,"_3292":58042},[],"Webhook denies, times out or responds without authorization",{"_3839":1193,"_33145":1174,"_22633":58044,"_5":15597,"_29869":57996,"_3292":58045},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3839":1194,"_33145":1174,"_22633":58047,"_5":15597,"_29869":57996,"_3292":58048},[],"`unexpected status code: <n>: redirects are not followed`",{"_3839":1195,"_33145":1174,"_22633":58050,"_5":15597,"_29869":57996,"_3292":58051},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3839":1196,"_33145":1174,"_22633":58053,"_5":15597,"_29869":57996,"_3292":58054},[],"`webhook response exceeds 1048576 bytes`",{"_3839":1197,"_33145":1174,"_22633":58056,"_5":15597,"_29869":57996,"_3292":58057},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3839":1198,"_33145":1174,"_22633":58059,"_5":15597,"_29869":57996,"_3292":58060},[],"`webhook config must not reference files`",{"_3839":1199,"_33145":1174,"_22633":58062,"_5":15597,"_29869":57996,"_3292":58063},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3839":1200,"_33145":1174,"_22633":58065,"_5":15597,"_29869":57996,"_3292":58066},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3839":1201,"_33145":1174,"_22633":58068,"_5":15597,"_29869":57996,"_3292":58069},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3839":1202,"_33145":1174,"_22633":58071,"_5":15597,"_29869":57996,"_3292":58072},[],"`webhook mTLS certificate and key are invalid: …`",{"_3839":1203,"_33145":1174,"_22633":58074,"_5":15597,"_29869":57996,"_3292":58075},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3839":1204,"_33145":1174,"_22633":58077,"_5":15597,"_29869":57996,"_3292":58078},[],"400 `struct validation error` creating or updating a DMS",{"_3839":1205,"_33145":1174,"_22633":58080,"_5":15597,"_29869":57996,"_3292":58081},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3839":1206,"_33145":1174,"_22633":58083,"_5":15597,"_29869":57996,"_3292":58084},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3839":1207,"_33145":1174,"_22633":58086,"_5":15597,"_29869":57996,"_3292":58087},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3839":1208,"_33145":1174,"_22633":58089,"_5":15597,"_29869":57996,"_3292":58090},[],"`device not preregistered`",{"_3839":1209,"_33145":1174,"_22633":58092,"_5":15597,"_29869":57996,"_3292":58093},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3839":1210,"_33145":1174,"_22633":58095,"_5":15597,"_29869":57996,"_3292":58096},[],"`forbiddenNewEnrollment`",{"_3839":1211,"_33145":1174,"_22633":58098,"_5":15597,"_29869":57996,"_3292":58099},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3839":1212,"_33145":1174,"_22633":58101,"_5":15597,"_29869":57996,"_3292":58102},[],"Different owning DMS",{"_3839":1213,"_33145":1174,"_22633":58104,"_5":15597,"_29869":57996,"_3292":58105},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3839":1214,"_33145":1174,"_22633":58107,"_5":15597,"_29869":57996,"_3292":58108},[],"`invalid RawSubject bytes`",{"_3839":1215,"_33145":1174,"_22633":58110,"_5":15597,"_29869":57996,"_3292":58111},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3839":1216,"_33145":1174,"_22633":58113,"_5":15597,"_29869":57996,"_3292":58114},[],"`invalid reenroll window`",{"_3839":1217,"_33145":1174,"_22633":58116,"_5":15597,"_29869":57996,"_3292":58117},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3839":1218,"_33145":1174,"_22633":58119,"_5":15597,"_29869":57996,"_3292":58120},[],"Current certificate revoked",{"_3839":1219,"_33145":1174,"_22633":58122,"_5":15597,"_29869":57996,"_3292":58123},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3839":1220,"_33145":1174,"_22633":58125,"_5":15597,"_29869":57996,"_3292":58126},[],"CA, profile or signing error",{"_3839":1221,"_33145":1174,"_22633":58128,"_5":15597,"_29869":57996,"_3292":58129},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3839":1222,"_33145":1174,"_22633":58131,"_5":15597,"_29869":57996,"_3292":58132},[],"HTTP 200 without a device connection",{"_3839":1223,"_33145":1174,"_22633":58134,"_5":15597,"_29869":57996,"_3292":58135},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3839":1224,"_33145":1174,"_22633":58137,"_5":15597,"_29869":57996,"_3292":58138},[],"Timeout or error after issuance",{"_3839":1225,"_33145":1174,"_22633":58140,"_5":15597,"_29869":57996,"_3292":58141},[],"New certificates, current slot and previous identity's state before retrying.",{"_3839":1226,"_33145":1174,"_22633":58143,"_5":15597,"_29869":58000,"_3292":58144},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3839":1227,"_33145":1174,"_22633":58146,"_5":15597,"_29869":58000,"_3292":58147},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3839":1228,"_33145":1174,"_22633":58149,"_5":15597,"_29869":58003,"_3292":58150},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3839":1229,"_33145":1174,"_22633":58152,"_5":15597,"_29869":58003,"_3292":58153},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3839":1230,"_33145":1174,"_22633":58155,"_5":15597,"_29869":58003,"_3292":58156},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3839":1231,"_33145":1174,"_22633":58158,"_5":15597,"_29869":58003,"_3292":58159},[],"Make one request, save headers/body and query the device and certificates.",{"_3839":1232,"_33145":1174,"_22633":58161,"_5":15597,"_29869":58003,"_3292":58162},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3839":1233,"_33145":1174,"_22633":58164,"_5":15597,"_29869":58003,"_3292":58165},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3839":1234,"_33145":1174,"_22633":58167,"_5":15597,"_29869":58003,"_3292":58168},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3839":1235,"_33145":1235,"_5":15996,"_3292":58170,"_33551":58171,"_22633":58172,"_29869":1235},"Trust distribution and updates",[54324,55792,56803,56801,56984],[],{"_3839":1236,"_33145":1235,"_22633":58174,"_5":15597,"_29869":1235,"_3292":58175},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3839":1237,"_33145":1235,"_5":33548,"_22633":58177,"_29869":58178,"_3292":58179},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3839":1238,"_33145":1235,"_5":33548,"_22633":58181,"_29869":58182,"_3292":58183},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3839":1239,"_33145":1235,"_5":33548,"_22633":58185,"_29869":58186,"_3292":58187},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3839":1240,"_33145":1235,"_5":33548,"_22633":58189,"_29869":58190,"_3292":58191},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3839":1241,"_33145":1235,"_5":33548,"_22633":58193,"_29869":58194,"_3292":58195},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3839":1242,"_33145":1235,"_22633":58197,"_5":15597,"_29869":1235,"_3292":58198},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3839":1243,"_33145":1235,"_22633":58200,"_5":15597,"_29869":58178,"_3292":58201},[],"Relationship",{"_3839":1244,"_33145":1235,"_22633":58203,"_5":15597,"_29869":58178,"_3292":58204},[],"Material prepared by its owner",{"_3839":1245,"_33145":1235,"_22633":58206,"_5":15597,"_29869":58178,"_3292":58207},[],"Device → EST server",{"_3839":1246,"_33145":1235,"_22633":58209,"_5":15597,"_29869":58178,"_3292":58210},[],"Previously verified server root, chain or pin and TLS name.",{"_3839":1247,"_33145":1235,"_22633":58212,"_5":15597,"_29869":58178,"_3292":58213},[],"DMS → requester",{"_3839":1248,"_33145":1235,"_22633":58215,"_5":15597,"_29869":58178,"_3292":58216},[],"CAs and rules authorizing initial or renewal credentials.",{"_3839":1249,"_33145":1235,"_22633":58218,"_5":15597,"_29869":58178,"_3292":58219},[],"Consumer → device",{"_3839":1250,"_33145":1235,"_22633":58221,"_5":15597,"_29869":58178,"_3292":58222},[],"Operational identity roots, intermediates, validation and permissions.",{"_3839":1251,"_33145":1235,"_22633":58224,"_5":15597,"_29869":58178,"_3292":58225},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3839":1252,"_33145":1235,"_22633":58227,"_5":15597,"_29869":58182,"_3292":58228},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3839":1253,"_33145":1235,"_22633":58230,"_5":15597,"_29869":58182,"_3292":58231},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3839":1254,"_33145":1235,"_22633":58233,"_5":15597,"_29869":58186,"_3292":58234},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3839":1255,"_33145":1235,"_22633":58236,"_5":15597,"_29869":58186,"_3292":58237},[],"Select policy-approved roots as anchors.",{"_3839":1256,"_33145":1235,"_22633":58239,"_5":15597,"_29869":58186,"_3292":58240},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3839":1257,"_33145":1235,"_22633":58242,"_5":15597,"_29869":58186,"_3292":58243},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3839":1258,"_33145":1235,"_22633":58245,"_5":15597,"_29869":58186,"_3292":58246},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3839":1259,"_33145":1235,"_22633":58248,"_5":15597,"_29869":58186,"_3292":58249},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3839":1260,"_33145":1235,"_22633":58251,"_5":15597,"_29869":58190,"_3292":58252},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3839":1261,"_33145":1235,"_22633":58254,"_5":15597,"_29869":58190,"_3292":58255},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3839":1262,"_33145":1235,"_22633":58257,"_5":15597,"_29869":58190,"_3292":58258},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3839":1263,"_33145":1235,"_22633":58260,"_5":15597,"_29869":58194,"_3292":58261},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3839":1264,"_33145":1264,"_5":15996,"_3292":58263,"_33551":58264,"_22633":58266,"_29869":1264},"AWS IoT Core",[54324,55792,56803,56801,58265],"Integrations",[],{"_3839":1265,"_33145":1264,"_22633":58268,"_5":15597,"_29869":1264,"_3292":58269},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3839":1266,"_33145":1264,"_5":33548,"_22633":58271,"_29869":58272,"_3292":58273},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3839":1267,"_33145":1264,"_5":33548,"_22633":58275,"_29869":58276,"_3292":58277},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3839":1268,"_33145":1264,"_5":33548,"_22633":58279,"_29869":58280,"_3292":58281},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3839":1269,"_33145":1264,"_5":33548,"_22633":58283,"_29869":58284,"_3292":58285},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3839":1270,"_33145":1264,"_5":33548,"_22633":58287,"_29869":58288,"_3292":58289},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3839":1271,"_33145":1264,"_5":33548,"_22633":58291,"_29869":58292,"_3292":58293},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3839":1272,"_33145":1264,"_5":33548,"_22633":58295,"_29869":58296,"_3292":58297},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3839":1273,"_33145":1264,"_5":33548,"_22633":58299,"_29869":58300,"_3292":58301},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3839":1274,"_33145":1264,"_5":33548,"_22633":58303,"_29869":58304,"_3292":58305},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3839":1275,"_33145":1264,"_5":33548,"_22633":58307,"_29869":58308,"_3292":58309},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3839":1276,"_33145":1264,"_5":33548,"_22633":58311,"_29869":58312,"_3292":58313},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3839":1277,"_33145":1264,"_5":33548,"_22633":58315,"_29869":58316,"_3292":58317},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3839":1278,"_33145":1264,"_5":33548,"_22633":58319,"_29869":58320,"_3292":58321},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3839":1279,"_33145":1264,"_5":33548,"_22633":58323,"_29869":58324,"_3292":58325},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3839":1280,"_33145":1264,"_5":33548,"_22633":58327,"_29869":58328,"_3292":58329},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3839":1281,"_33145":1264,"_5":33548,"_22633":58331,"_29869":58332,"_3292":58333},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3839":1282,"_33145":1264,"_5":33548,"_22633":58335,"_29869":58336,"_3292":58337},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3839":1283,"_33145":1264,"_5":33548,"_22633":58339,"_29869":58340,"_3292":58341},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3839":1284,"_33145":1264,"_5":33548,"_22633":58343,"_29869":58344,"_3292":58345},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3839":1285,"_33145":1264,"_5":33548,"_22633":58347,"_29869":58348,"_3292":58349},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3839":1286,"_33145":1264,"_5":33548,"_22633":58351,"_29869":58352,"_3292":58353},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3839":1287,"_33145":1264,"_5":33548,"_22633":58355,"_29869":58356,"_3292":58357},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3839":1288,"_33145":1264,"_5":33548,"_22633":58359,"_29869":58360,"_3292":58361},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3839":1289,"_33145":1264,"_5":33548,"_22633":58363,"_29869":58364,"_3292":58365},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3839":1290,"_33145":1264,"_5":33548,"_22633":58367,"_29869":58368,"_3292":58369},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3839":1291,"_33145":1264,"_22633":58371,"_5":15597,"_29869":1264,"_3292":58372},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3839":1292,"_33145":1264,"_22633":58374,"_5":15597,"_29869":1264,"_3292":58375},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3839":1293,"_33145":1264,"_22633":58377,"_5":15597,"_29869":1264,"_3292":58378},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3839":1294,"_33145":1264,"_22633":58380,"_5":15597,"_29869":58272,"_3292":58381},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3839":1295,"_33145":1264,"_22633":58383,"_5":15597,"_29869":58272,"_3292":58384},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3839":1296,"_33145":1264,"_22633":58386,"_5":15597,"_29869":58272,"_3292":58387},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3839":1297,"_33145":1264,"_22633":58389,"_5":15597,"_29869":58272,"_3292":58390},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3839":1298,"_33145":1264,"_22633":58392,"_5":15597,"_29869":58276,"_3292":58393},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3839":1299,"_33145":1264,"_22633":58395,"_5":15597,"_29869":58280,"_3292":58396},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3839":1300,"_33145":1264,"_22633":58398,"_5":15597,"_29869":58280,"_3292":58399},[],"IAM action",{"_3839":1301,"_33145":1264,"_22633":58401,"_5":15597,"_29869":58280,"_3292":54714},[],{"_3839":1302,"_33145":1264,"_22633":58403,"_5":15597,"_29869":58280,"_3292":58404},[],"`iot:GetRegistrationCode`",{"_3839":1303,"_33145":1264,"_22633":58406,"_5":15597,"_29869":58280,"_3292":58407},[],"Obtain the verification code for CA registration in the Primary Account",{"_3839":1304,"_33145":1264,"_22633":58409,"_5":15597,"_29869":58280,"_3292":58410},[],"`iot:RegisterCACertificate`",{"_3839":1305,"_33145":1264,"_22633":58412,"_5":15597,"_29869":58280,"_3292":58413},[],"Register the CA in AWS IoT",{"_3839":1306,"_33145":1264,"_22633":58415,"_5":15597,"_29869":58280,"_3292":58416},[],"`iot:DescribeCACertificate`",{"_3839":1307,"_33145":1264,"_22633":58418,"_5":15597,"_29869":58280,"_3292":58419},[],"Check the CA registration status",{"_3839":1308,"_33145":1264,"_22633":58421,"_5":15597,"_29869":58280,"_3292":58422},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3839":1309,"_33145":1264,"_22633":58424,"_5":15597,"_29869":58280,"_3292":58425},[],"Create or update Things in IoT Core",{"_3839":1310,"_33145":1264,"_22633":58427,"_5":15597,"_29869":58280,"_3292":58428},[],"`iot:RegisterThing`",{"_3839":1311,"_33145":1264,"_22633":58430,"_5":15597,"_29869":58280,"_3292":58431},[],"Provision Things through a template",{"_3839":1312,"_33145":1264,"_22633":58433,"_5":15597,"_29869":58280,"_3292":58434},[],"`iot:RegisterCertificate`",{"_3839":1313,"_33145":1264,"_22633":58436,"_5":15597,"_29869":58280,"_3292":58437},[],"Register device certificates",{"_3839":1314,"_33145":1264,"_22633":58439,"_5":15597,"_29869":58280,"_3292":58440},[],"`iot:UpdateCertificate`",{"_3839":1315,"_33145":1264,"_22633":58442,"_5":15597,"_29869":58280,"_3292":58443},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3839":1316,"_33145":1264,"_22633":58445,"_5":15597,"_29869":58280,"_3292":58446},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3839":1317,"_33145":1264,"_22633":58448,"_5":15597,"_29869":58280,"_3292":58449},[],"Create and attach IoT policies",{"_3839":1318,"_33145":1264,"_22633":58451,"_5":15597,"_29869":58280,"_3292":58452},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3839":1319,"_33145":1264,"_22633":58454,"_5":15597,"_29869":58280,"_3292":58455},[],"Manage Thing groups",{"_3839":1320,"_33145":1264,"_22633":58457,"_5":15597,"_29869":58280,"_3292":58458},[],"`iot:CreateProvisioningTemplate`",{"_3839":1321,"_33145":1264,"_22633":58460,"_5":15597,"_29869":58280,"_3292":58461},[],"Create JITP templates",{"_3839":1322,"_33145":1264,"_22633":58463,"_5":15597,"_29869":58280,"_3292":58464},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3839":1323,"_33145":1264,"_22633":58466,"_5":15597,"_29869":58280,"_3292":58467},[],"Read and write the Device Shadow",{"_3839":1324,"_33145":1264,"_22633":58469,"_5":15597,"_29869":58280,"_3292":58470},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3839":1325,"_33145":1264,"_22633":58472,"_5":15597,"_29869":58284,"_3292":58473},[],"Parameter",{"_3839":1326,"_33145":1264,"_22633":58475,"_5":15597,"_29869":58284,"_3292":58476},[],"Type",{"_3839":1327,"_33145":1264,"_22633":58478,"_5":15597,"_29869":58284,"_3292":58479},[],"Required",{"_3839":1328,"_33145":1264,"_22633":58481,"_5":15597,"_29869":58284,"_3292":58482},[],"Description",{"_3839":1329,"_33145":1264,"_22633":58484,"_5":15597,"_29869":58284,"_3292":58485},[],"`connector_id`",{"_3839":1330,"_33145":1264,"_22633":58487,"_5":15597,"_29869":58284,"_3292":27097},[],{"_3839":1331,"_33145":1264,"_22633":58489,"_5":15597,"_29869":58284,"_3292":58490},[],"Yes",{"_3839":1332,"_33145":1264,"_22633":58492,"_5":15597,"_29869":58284,"_3292":58493},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3839":1333,"_33145":1264,"_22633":58495,"_5":15597,"_29869":58284,"_3292":58496},[],"`aws_config.region`",{"_3839":1334,"_33145":1264,"_22633":58498,"_5":15597,"_29869":58284,"_3292":27097},[],{"_3839":1335,"_33145":1264,"_22633":58500,"_5":15597,"_29869":58284,"_3292":58490},[],{"_3839":1336,"_33145":1264,"_22633":58502,"_5":15597,"_29869":58284,"_3292":58503},[],"AWS region where the connector operates.",{"_3839":1337,"_33145":1264,"_22633":58505,"_5":15597,"_29869":58284,"_3292":58506},[],"`aws_config.auth_method`",{"_3839":1338,"_33145":1264,"_22633":58508,"_5":15597,"_29869":58284,"_3292":27097},[],{"_3839":1339,"_33145":1264,"_22633":58510,"_5":15597,"_29869":58284,"_3292":58490},[],{"_3839":1340,"_33145":1264,"_22633":58512,"_5":15597,"_29869":58284,"_3292":58513},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3839":1341,"_33145":1264,"_22633":58515,"_5":15597,"_29869":58284,"_3292":58516},[],"`aws_config.access_key_id`",{"_3839":1342,"_33145":1264,"_22633":58518,"_5":15597,"_29869":58284,"_3292":27097},[],{"_3839":1343,"_33145":1264,"_22633":58520,"_5":15597,"_29869":58284,"_3292":58521},[],"Only with `auth_method=static`",{"_3839":1344,"_33145":1264,"_22633":58523,"_5":15597,"_29869":58284,"_3292":58524},[],"AWS access key.",{"_3839":1345,"_33145":1264,"_22633":58526,"_5":15597,"_29869":58284,"_3292":58527},[],"`aws_config.secret_access_key`",{"_3839":1346,"_33145":1264,"_22633":58529,"_5":15597,"_29869":58284,"_3292":27097},[],{"_3839":1347,"_33145":1264,"_22633":58531,"_5":15597,"_29869":58284,"_3292":58521},[],{"_3839":1348,"_33145":1264,"_22633":58533,"_5":15597,"_29869":58284,"_3292":58534},[],"AWS secret key.",{"_3839":1349,"_33145":1264,"_22633":58536,"_5":15597,"_29869":58284,"_3292":58537},[],"`aws_config.session_token`",{"_3839":1350,"_33145":1264,"_22633":58539,"_5":15597,"_29869":58284,"_3292":27097},[],{"_3839":1351,"_33145":1264,"_22633":58541,"_5":15597,"_29869":58284,"_3292":58542},[],"No",{"_3839":1352,"_33145":1264,"_22633":58544,"_5":15597,"_29869":58284,"_3292":58545},[],"Session token (with `auth_method=static`).",{"_3839":1353,"_33145":1264,"_22633":58547,"_5":15597,"_29869":58284,"_3292":58548},[],"`aws_config.role_arn`",{"_3839":1354,"_33145":1264,"_22633":58550,"_5":15597,"_29869":58284,"_3292":27097},[],{"_3839":1355,"_33145":1264,"_22633":58552,"_5":15597,"_29869":58284,"_3292":58553},[],"Only with `auth_method=role`",{"_3839":1356,"_33145":1264,"_22633":58555,"_5":15597,"_29869":58284,"_3292":58556},[],"ARN of the role to assume.",{"_3839":1357,"_33145":1264,"_22633":58558,"_5":15597,"_29869":58284,"_3292":58559},[],"`aws_config.endpoint_url`",{"_3839":1358,"_33145":1264,"_22633":58561,"_5":15597,"_29869":58284,"_3292":27097},[],{"_3839":1359,"_33145":1264,"_22633":58563,"_5":15597,"_29869":58284,"_3292":58542},[],{"_3839":1360,"_33145":1264,"_22633":58565,"_5":15597,"_29869":58284,"_3292":58566},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3839":1361,"_33145":1264,"_22633":58568,"_5":15597,"_29869":58284,"_3292":58569},[],"`subscriber_event_bus`",{"_3839":1362,"_33145":1264,"_22633":58571,"_5":15597,"_29869":58284,"_3292":19060},[],{"_3839":1363,"_33145":1264,"_22633":58573,"_5":15597,"_29869":58284,"_3292":58490},[],{"_3839":1364,"_33145":1264,"_22633":58575,"_5":15597,"_29869":58284,"_3292":58576},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3839":1365,"_33145":1264,"_22633":58578,"_5":15597,"_29869":58284,"_3292":58579},[],"`dms_manager_client`",{"_3839":1366,"_33145":1264,"_22633":58581,"_5":15597,"_29869":58284,"_3292":27097},[],{"_3839":1367,"_33145":1264,"_22633":58583,"_5":15597,"_29869":58284,"_3292":58490},[],{"_3839":1368,"_33145":1264,"_22633":58585,"_5":15597,"_29869":58284,"_3292":58586},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3839":1369,"_33145":1264,"_22633":58588,"_5":15597,"_29869":58284,"_3292":58589},[],"`device_manager_client`",{"_3839":1370,"_33145":1264,"_22633":58591,"_5":15597,"_29869":58284,"_3292":27097},[],{"_3839":1371,"_33145":1264,"_22633":58593,"_5":15597,"_29869":58284,"_3292":58490},[],{"_3839":1372,"_33145":1264,"_22633":58595,"_5":15597,"_29869":58284,"_3292":58596},[],"HTTP URL of Lamassu's Device Manager.",{"_3839":1373,"_33145":1264,"_22633":58598,"_5":15597,"_29869":58284,"_3292":58599},[],"`ca_client`",{"_3839":1374,"_33145":1264,"_22633":58601,"_5":15597,"_29869":58284,"_3292":27097},[],{"_3839":1375,"_33145":1264,"_22633":58603,"_5":15597,"_29869":58284,"_3292":58490},[],{"_3839":1376,"_33145":1264,"_22633":58605,"_5":15597,"_29869":58284,"_3292":58606},[],"HTTP URL of Lamassu's CA service.",{"_3839":1377,"_33145":1264,"_22633":58608,"_5":15597,"_29869":58288,"_3292":58609},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3839":1378,"_33145":1264,"_22633":58611,"_5":15597,"_29869":58288,"_3292":58612},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3839":1379,"_33145":1264,"_22633":58614,"_5":15597,"_29869":58288,"_3292":58615},[],"CloudEvent type",{"_3839":1380,"_33145":1264,"_22633":58617,"_5":15597,"_29869":58288,"_3292":58618},[],"Lamassu resource",{"_3839":1381,"_33145":1264,"_22633":58620,"_5":15597,"_29869":58288,"_3292":58621},[],"AWS Resource",{"_3839":1382,"_33145":1264,"_22633":58623,"_5":15597,"_29869":58288,"_3292":58624},[],"IAM actions",{"_3839":1383,"_33145":1264,"_22633":58626,"_5":15597,"_29869":58288,"_3292":58627},[],"AWS calls and effect",{"_3839":1384,"_33145":1264,"_22633":58629,"_5":15597,"_29869":58288,"_3292":58630},[],"Where in this page",{"_3839":1385,"_33145":1264,"_22633":58632,"_5":15597,"_29869":58288,"_3292":58633},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3839":1386,"_33145":1264,"_22633":58635,"_5":15597,"_29869":58288,"_3292":58636},[],"CA",{"_3839":1387,"_33145":1264,"_22633":58638,"_5":15597,"_29869":58288,"_3292":58639},[],"`IoTCore/CACertificate`",{"_3839":1388,"_33145":1264,"_22633":58641,"_5":15597,"_29869":58288,"_3292":58642},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3839":1389,"_33145":1264,"_22633":58644,"_5":15597,"_29869":58288,"_3292":58645},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3839":1390,"_33145":1264,"_22633":58647,"_5":15597,"_29869":58288,"_3292":58301},[],{"_3839":1391,"_33145":1264,"_22633":58649,"_5":15597,"_29869":58288,"_3292":58650},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3839":1392,"_33145":1264,"_22633":58652,"_5":15597,"_29869":58288,"_3292":58653},[],"DMS",{"_3839":1393,"_33145":1264,"_22633":58655,"_5":15597,"_29869":58288,"_3292":58656},[],"`IoTCore/ProvisioningTemplate`",{"_3839":1394,"_33145":1264,"_22633":58658,"_5":15597,"_29869":58288,"_3292":58659},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3839":1395,"_33145":1264,"_22633":58661,"_5":15597,"_29869":58288,"_3292":58662},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3839":1396,"_33145":1264,"_22633":58664,"_5":15597,"_29869":58288,"_3292":58329},[],{"_3839":1397,"_33145":1264,"_22633":58666,"_5":15597,"_29869":58288,"_3292":58667},[],"`EventBindDeviceIdentityKey`",{"_3839":1398,"_33145":1264,"_22633":58669,"_5":15597,"_29869":58288,"_3292":58670},[],"Device",{"_3839":1399,"_33145":1264,"_22633":58672,"_5":15597,"_29869":58288,"_3292":58673},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3839":1400,"_33145":1264,"_22633":58675,"_5":15597,"_29869":58288,"_3292":58676},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3839":1401,"_33145":1264,"_22633":58678,"_5":15597,"_29869":58288,"_3292":58679},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3839":1402,"_33145":1264,"_22633":58681,"_5":15597,"_29869":58288,"_3292":58337},[],{"_3839":1403,"_33145":1264,"_22633":58683,"_5":15597,"_29869":58288,"_3292":58684},[],"`EventUpdateCertificateStatusKey`",{"_3839":1404,"_33145":1264,"_22633":58686,"_5":15597,"_29869":58288,"_3292":58687},[],"Certificate",{"_3839":1405,"_33145":1264,"_22633":58689,"_5":15597,"_29869":58288,"_3292":58690},[],"`IoTCore/Certificate`",{"_3839":1406,"_33145":1264,"_22633":58692,"_5":15597,"_29869":58288,"_3292":58693},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3839":1407,"_33145":1264,"_22633":58695,"_5":15597,"_29869":58288,"_3292":58696},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3839":1408,"_33145":1264,"_22633":58698,"_5":15597,"_29869":58288,"_3292":58349},[],{"_3839":1409,"_33145":1264,"_22633":58700,"_5":15597,"_29869":58288,"_3292":58701},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3839":1410,"_33145":1264,"_22633":58703,"_5":15597,"_29869":58288,"_3292":58704},[],"Certificate / Device",{"_3839":1411,"_33145":1264,"_22633":58706,"_5":15597,"_29869":58288,"_3292":58707},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3839":1412,"_33145":1264,"_22633":58709,"_5":15597,"_29869":58288,"_3292":54720},[],{"_3839":1413,"_33145":1264,"_22633":58711,"_5":15597,"_29869":58288,"_3292":58712},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3839":1414,"_33145":1264,"_22633":58714,"_5":15597,"_29869":58288,"_3292":58357},[],{"_3839":1415,"_33145":1264,"_22633":58716,"_5":15597,"_29869":58292,"_3292":58717},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3839":1416,"_33145":1264,"_22633":58719,"_5":15597,"_29869":58296,"_3292":58720},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3839":1417,"_33145":1264,"_22633":58722,"_5":15597,"_29869":58296,"_3292":58723},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3839":1418,"_33145":1264,"_22633":58725,"_5":15597,"_29869":58300,"_3292":58726},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3839":1419,"_33145":1264,"_22633":58728,"_5":15597,"_29869":58300,"_3292":58729},[],"Transition",{"_3839":1420,"_33145":1264,"_22633":58731,"_5":15597,"_29869":58300,"_3292":58732},[],"AWS calls",{"_3839":1421,"_33145":1264,"_22633":58734,"_5":15597,"_29869":58300,"_3292":58735},[],"`NotRegistered` → `Requested`",{"_3839":1422,"_33145":1264,"_22633":58737,"_5":15597,"_29869":58300,"_3292":58738},[],"none (metadata write only)",{"_3839":1423,"_33145":1264,"_22633":58740,"_5":15597,"_29869":58300,"_3292":58741},[],"`Requested` → `Registering`",{"_3839":1424,"_33145":1264,"_22633":58743,"_5":15597,"_29869":58300,"_3292":58744},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3839":1425,"_33145":1264,"_22633":58746,"_5":15597,"_29869":58300,"_3292":58747},[],"`Registering` → `Succeeded`",{"_3839":1426,"_33145":1264,"_22633":58749,"_5":15597,"_29869":58300,"_3292":58750},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3839":1427,"_33145":1264,"_22633":58752,"_5":15597,"_29869":58300,"_3292":58753},[],"`Registering` → `Failed`",{"_3839":1428,"_33145":1264,"_22633":58755,"_5":15597,"_29869":58300,"_3292":58756},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3839":1429,"_33145":1264,"_22633":58758,"_5":15597,"_29869":58300,"_3292":58759},[],"`Failed` / `Succeeded` → `Requested`",{"_3839":1430,"_33145":1264,"_22633":58761,"_5":15597,"_29869":58300,"_3292":58762},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3839":1431,"_33145":1264,"_22633":58764,"_5":15597,"_29869":58304,"_3292":58765},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3839":1432,"_33145":1264,"_22633":58767,"_5":15597,"_29869":58304,"_3292":58768},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3839":1433,"_33145":1264,"_22633":58770,"_5":15597,"_29869":58304,"_3292":58771},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3839":1434,"_33145":1264,"_22633":58773,"_5":15597,"_29869":58304,"_3292":58774},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3839":1435,"_33145":1264,"_22633":58776,"_5":15597,"_29869":58304,"_3292":58777},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3839":1436,"_33145":1264,"_22633":58779,"_5":15597,"_29869":58304,"_3292":58780},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3839":1437,"_33145":1264,"_22633":58782,"_5":15597,"_29869":58308,"_3292":58783},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3839":1438,"_33145":1264,"_22633":58785,"_5":15597,"_29869":58312,"_3292":58786},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3839":1439,"_33145":1264,"_22633":58788,"_5":15597,"_29869":58312,"_3292":58789},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3839":1440,"_33145":1264,"_22633":58791,"_5":15597,"_29869":58316,"_3292":58792},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3839":1441,"_33145":1264,"_22633":58794,"_5":15597,"_29869":58320,"_3292":58795},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3839":1442,"_33145":1264,"_22633":58797,"_5":15597,"_29869":58320,"_3292":58798},[],"Creates or updates the IoT policies configured in the DMS.",{"_3839":1443,"_33145":1264,"_22633":58800,"_5":15597,"_29869":58320,"_3292":58801},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3839":1444,"_33145":1264,"_22633":58803,"_5":15597,"_29869":58320,"_3292":58804},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3839":1445,"_33145":1264,"_22633":58806,"_5":15597,"_29869":58320,"_3292":58807},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3839":1446,"_33145":1264,"_22633":58809,"_5":15597,"_29869":58320,"_3292":58810},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3839":1447,"_33145":1264,"_22633":58812,"_5":15597,"_29869":58320,"_3292":58813},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3839":1448,"_33145":1264,"_22633":58815,"_5":15597,"_29869":58324,"_3292":58816},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3839":1449,"_33145":1264,"_22633":58818,"_5":15597,"_29869":58324,"_3292":58819},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3839":1450,"_33145":1264,"_22633":58821,"_5":15597,"_29869":58324,"_3292":58822},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3839":1451,"_33145":1264,"_22633":58824,"_5":15597,"_29869":58324,"_3292":58825},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3839":1452,"_33145":1264,"_22633":58827,"_5":15597,"_29869":58324,"_3292":58828},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3839":1453,"_33145":1264,"_22633":58830,"_5":15597,"_29869":58328,"_3292":58831},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3839":1454,"_33145":1264,"_22633":58833,"_5":15597,"_29869":58328,"_3292":58729},[],{"_3839":1455,"_33145":1264,"_22633":58835,"_5":15597,"_29869":58328,"_3292":58732},[],{"_3839":1456,"_33145":1264,"_22633":58837,"_5":15597,"_29869":58328,"_3292":58838},[],"`Unconfigured` → `None` / `Auto`",{"_3839":1457,"_33145":1264,"_22633":58840,"_5":15597,"_29869":58328,"_3292":58841},[],"none (configuration only)",{"_3839":1458,"_33145":1264,"_22633":58843,"_5":15597,"_29869":58328,"_3292":58844},[],"`None` ↔ `Auto`",{"_3839":1459,"_33145":1264,"_22633":58846,"_5":15597,"_29869":58328,"_3292":58841},[],{"_3839":1460,"_33145":1264,"_22633":58848,"_5":15597,"_29869":58328,"_3292":58849},[],"Any → `Jitp`",{"_3839":1461,"_33145":1264,"_22633":58851,"_5":15597,"_29869":58328,"_3292":58852},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3839":1462,"_33145":1264,"_22633":58854,"_5":15597,"_29869":58328,"_3292":58855},[],"`Jitp` → `None` / `Auto`",{"_3839":1463,"_33145":1264,"_22633":58857,"_5":15597,"_29869":58328,"_3292":58858},[],"none (the template stays in the AWS account)",{"_3839":1464,"_33145":1264,"_22633":58860,"_5":15597,"_29869":58332,"_3292":58861},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3839":1465,"_33145":1264,"_22633":58863,"_5":15597,"_29869":58332,"_3292":58864},[],"The full flow from the device's perspective is:",{"_3839":1466,"_33145":1264,"_22633":58866,"_5":15597,"_29869":58332,"_3292":58867},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3839":1467,"_33145":1264,"_22633":58869,"_5":15597,"_29869":58336,"_3292":58870},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3839":1468,"_33145":1264,"_22633":58872,"_5":15597,"_29869":58336,"_3292":58729},[],{"_3839":1469,"_33145":1264,"_22633":58874,"_5":15597,"_29869":58336,"_3292":58732},[],{"_3839":1470,"_33145":1264,"_22633":58876,"_5":15597,"_29869":58336,"_3292":58877},[],"`Absent` → `Provisioned`",{"_3839":1471,"_33145":1264,"_22633":58879,"_5":15597,"_29869":58336,"_3292":58880},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3839":1472,"_33145":1264,"_22633":58882,"_5":15597,"_29869":58336,"_3292":58883},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3839":1473,"_33145":1264,"_22633":58885,"_5":15597,"_29869":58336,"_3292":58886},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3839":1474,"_33145":1264,"_22633":58888,"_5":15597,"_29869":58336,"_3292":58889},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3839":1475,"_33145":1264,"_22633":58891,"_5":15597,"_29869":58340,"_3292":58892},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3839":1476,"_33145":1264,"_22633":58894,"_5":15597,"_29869":58340,"_3292":58895},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3839":1477,"_33145":1264,"_22633":58897,"_5":15597,"_29869":58340,"_3292":58898},[],"For the JITP flow to work correctly:",{"_3839":1478,"_33145":1264,"_22633":58900,"_5":15597,"_29869":58340,"_3292":58901},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3839":1479,"_33145":1264,"_22633":58903,"_5":15597,"_29869":58340,"_3292":58904},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3839":1480,"_33145":1264,"_22633":58906,"_5":15597,"_29869":58340,"_3292":58907},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3839":1481,"_33145":1264,"_22633":58909,"_5":15597,"_29869":58340,"_3292":58910},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3839":1482,"_33145":1264,"_22633":58912,"_5":15597,"_29869":58344,"_3292":58913},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3839":1483,"_33145":1264,"_22633":58915,"_5":15597,"_29869":58344,"_3292":58916},[],"Status in Lamassu",{"_3839":1484,"_33145":1264,"_22633":58918,"_5":15597,"_29869":58344,"_3292":58919},[],"Revocation reason",{"_3839":1485,"_33145":1264,"_22633":58921,"_5":15597,"_29869":58344,"_3292":58922},[],"Status in AWS IoT Core",{"_3839":1486,"_33145":1264,"_22633":58924,"_5":15597,"_29869":58344,"_3292":58925},[],"`Active`",{"_3839":1487,"_33145":1264,"_22633":58927,"_5":15597,"_29869":58344,"_3292":58928},[],"None",{"_3839":1488,"_33145":1264,"_22633":58930,"_5":15597,"_29869":58344,"_3292":58931},[],"`ACTIVE`",{"_3839":1489,"_33145":1264,"_22633":58933,"_5":15597,"_29869":58344,"_3292":58934},[],"`Revoked`",{"_3839":1490,"_33145":1264,"_22633":58936,"_5":15597,"_29869":58344,"_3292":58937},[],"`certificateHold`",{"_3839":1491,"_33145":1264,"_22633":58939,"_5":15597,"_29869":58344,"_3292":58940},[],"`INACTIVE`",{"_3839":1492,"_33145":1264,"_22633":58942,"_5":15597,"_29869":58344,"_3292":58934},[],{"_3839":1493,"_33145":1264,"_22633":58944,"_5":15597,"_29869":58344,"_3292":58945},[],"Any other reason",{"_3839":1494,"_33145":1264,"_22633":58947,"_5":15597,"_29869":58344,"_3292":58948},[],"`REVOKED`",{"_3839":1495,"_33145":1264,"_22633":58950,"_5":15597,"_29869":58344,"_3292":58951},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3839":1496,"_33145":1264,"_22633":58953,"_5":15597,"_29869":58348,"_3292":58954},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3839":1497,"_33145":1264,"_22633":58956,"_5":15597,"_29869":58348,"_3292":58729},[],{"_3839":1498,"_33145":1264,"_22633":58958,"_5":15597,"_29869":58348,"_3292":58732},[],{"_3839":1499,"_33145":1264,"_22633":58960,"_5":15597,"_29869":58348,"_3292":58961},[],"`NotSynced` → `Active`",{"_3839":1500,"_33145":1264,"_22633":58963,"_5":15597,"_29869":58348,"_3292":58440},[],{"_3839":1501,"_33145":1264,"_22633":58965,"_5":15597,"_29869":58348,"_3292":58966},[],"`Active` → `Inactive`",{"_3839":1502,"_33145":1264,"_22633":58968,"_5":15597,"_29869":58348,"_3292":58969},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3839":1503,"_33145":1264,"_22633":58971,"_5":15597,"_29869":58348,"_3292":58972},[],"`Active` → `Revoked`",{"_3839":1504,"_33145":1264,"_22633":58974,"_5":15597,"_29869":58348,"_3292":58969},[],{"_3839":1505,"_33145":1264,"_22633":58976,"_5":15597,"_29869":58348,"_3292":58977},[],"`Inactive` / `Revoked` → `Active`",{"_3839":1506,"_33145":1264,"_22633":58979,"_5":15597,"_29869":58348,"_3292":58440},[],{"_3839":1507,"_33145":1264,"_22633":58981,"_5":15597,"_29869":58348,"_3292":58982},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3839":1508,"_33145":1264,"_22633":58984,"_5":15597,"_29869":58348,"_3292":58985},[],"none (these states are not synced to AWS)",{"_3839":1509,"_33145":1264,"_22633":58987,"_5":15597,"_29869":58352,"_3292":58988},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3839":1510,"_33145":1264,"_22633":58990,"_5":15597,"_29869":58352,"_3292":58991},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3839":1511,"_33145":1264,"_22633":58993,"_5":15597,"_29869":58352,"_3292":58994},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3839":1512,"_33145":1264,"_22633":58996,"_5":15597,"_29869":58356,"_3292":58997},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3839":1513,"_33145":1264,"_22633":58999,"_5":15597,"_29869":58356,"_3292":59000},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3839":1514,"_33145":1264,"_22633":59002,"_5":15597,"_29869":58360,"_3292":59003},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3839":1515,"_33145":1264,"_22633":59005,"_5":15597,"_29869":58360,"_3292":59006},[],"There are two action types:",{"_3839":1516,"_33145":1264,"_22633":59008,"_5":15597,"_29869":58360,"_3292":59009},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3839":1517,"_33145":1264,"_22633":59011,"_5":15597,"_29869":58360,"_3292":59012},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3839":1518,"_33145":1264,"_22633":59014,"_5":15597,"_29869":58360,"_3292":59015},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3839":1519,"_33145":1264,"_22633":59017,"_5":15597,"_29869":58364,"_3292":59018},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3839":1520,"_33145":1264,"_22633":59020,"_5":15597,"_29869":58364,"_3292":59021},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3839":1521,"_33145":1264,"_22633":59023,"_5":15597,"_29869":58364,"_3292":59024},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3839":1522,"_33145":1264,"_22633":59026,"_5":15597,"_29869":58368,"_3292":59027},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3839":1523,"_33145":1264,"_22633":59029,"_5":15597,"_29869":58368,"_3292":59030},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3839":1524,"_33145":1264,"_22633":59032,"_5":15597,"_29869":58368,"_3292":59033},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3839":1525,"_33145":1264,"_22633":59035,"_5":15597,"_29869":58368,"_3292":59036},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3839":1526,"_33145":1264,"_22633":59038,"_5":15597,"_29869":58368,"_3292":59039},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3839":1527,"_33145":1264,"_22633":59041,"_5":15597,"_29869":58368,"_3292":59042},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3839":1528,"_33145":1264,"_22633":59044,"_5":15597,"_29869":58368,"_3292":59045},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3839":1529,"_33145":1264,"_22633":59047,"_5":15597,"_29869":58368,"_3292":59048},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3839":1530,"_33145":1264,"_22633":59050,"_5":15597,"_29869":58368,"_3292":59051},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3839":1531,"_33145":1264,"_22633":59053,"_5":15597,"_29869":58368,"_3292":59054},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3839":1532,"_33145":1264,"_22633":59056,"_5":15597,"_29869":58368,"_3292":59057},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3839":1533,"_33145":1264,"_22633":59059,"_5":15597,"_29869":58368,"_3292":59060},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3839":1534,"_33145":1264,"_22633":59062,"_5":15597,"_29869":58368,"_3292":59063},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3839":1535,"_33145":1264,"_22633":59065,"_5":15597,"_29869":58368,"_3292":59066},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3839":1536,"_33145":1264,"_22633":59068,"_5":15597,"_29869":58368,"_3292":59069},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3839":1537,"_33145":1264,"_22633":59071,"_5":15597,"_29869":58368,"_3292":59072},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3839":1538,"_33145":1264,"_22633":59074,"_5":15597,"_29869":58368,"_3292":59075},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3839":1539,"_33145":1264,"_22633":59077,"_5":15597,"_29869":58368,"_3292":59078},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3839":1540,"_33145":1264,"_22633":59080,"_5":15597,"_29869":58368,"_3292":59081},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3839":1541,"_33145":1264,"_22633":59083,"_5":15597,"_29869":58368,"_3292":59084},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3839":1542,"_33145":1264,"_22633":59086,"_5":15597,"_29869":58368,"_3292":59087},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3839":1543,"_33145":1264,"_22633":59089,"_5":15597,"_29869":58368,"_3292":59090},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3839":1544,"_33145":1264,"_22633":59092,"_5":15597,"_29869":58368,"_3292":59093},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3839":1545,"_33145":1264,"_22633":59095,"_5":15597,"_29869":58368,"_3292":59096},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3839":1546,"_33145":1546,"_5":15996,"_3292":56803,"_33551":59098,"_22633":59099,"_29869":1546},[54324,55792,56803],[],{"_3839":1547,"_33145":1546,"_22633":59101,"_5":15597,"_29869":1546,"_3292":59102},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3839":1548,"_33145":1546,"_5":33548,"_22633":59104,"_29869":59105,"_3292":59106},[],"/docs/pr-preview/pr-58/platform/iot-fleets/overview#start-here","Start here",{"_3839":1549,"_33145":1546,"_5":33548,"_22633":59108,"_29869":59109,"_3292":56801},[],"/docs/pr-preview/pr-58/platform/iot-fleets/overview#devices-and-identities",{"_3839":1550,"_33145":1546,"_5":33548,"_22633":59111,"_29869":59112,"_3292":56984},[],"/docs/pr-preview/pr-58/platform/iot-fleets/overview#enrollment-with-pki",{"_3839":1551,"_33145":1546,"_5":33548,"_22633":59114,"_29869":59115,"_3292":58265},[],"/docs/pr-preview/pr-58/platform/iot-fleets/overview#integrations",{"_3839":1552,"_33145":1546,"_5":33548,"_22633":59117,"_29869":59118,"_3292":59119},[],"/docs/pr-preview/pr-58/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3839":1553,"_33145":1546,"_22633":59121,"_5":15597,"_29869":1546,"_3292":59122},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3839":1554,"_33145":1546,"_22633":59124,"_5":15597,"_29869":59105,"_3292":59125},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3839":1555,"_33145":1546,"_22633":59127,"_5":15597,"_29869":59105,"_3292":59128},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3839":1556,"_33145":1546,"_22633":59130,"_5":15597,"_29869":59109,"_3292":59131},[],"Resource",{"_3839":1557,"_33145":1546,"_22633":59133,"_5":15597,"_29869":59109,"_3292":59134},[],"What it represents",{"_3839":1558,"_33145":1546,"_22633":59136,"_5":15597,"_29869":59109,"_3292":59137},[],"**Device**",{"_3839":1559,"_33145":1546,"_22633":59139,"_5":15597,"_29869":59109,"_3292":59140},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3839":1560,"_33145":1546,"_22633":59142,"_5":15597,"_29869":59109,"_3292":59143},[],"**Identity**",{"_3839":1561,"_33145":1546,"_22633":59145,"_5":15597,"_29869":59109,"_3292":59146},[],"The device's association with its certificates: an active version and a history.",{"_3839":1562,"_33145":1546,"_22633":59148,"_5":15597,"_29869":59109,"_3292":59149},[],"**DMS**",{"_3839":1563,"_33145":1546,"_22633":59151,"_5":15597,"_29869":59109,"_3292":59152},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3839":1564,"_33145":1546,"_22633":59154,"_5":15597,"_29869":59109,"_3292":59155},[],"**Fleet**",{"_3839":1565,"_33145":1546,"_22633":59157,"_5":15597,"_29869":59109,"_3292":59158},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3839":1566,"_33145":1546,"_22633":59160,"_5":15597,"_29869":59109,"_3292":59161},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3839":1567,"_33145":1546,"_22633":59163,"_5":15597,"_29869":59109,"_3292":59164},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3839":1568,"_33145":1546,"_22633":59166,"_5":15597,"_29869":59112,"_3292":59167},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3839":1569,"_33145":1546,"_22633":59169,"_5":15597,"_29869":59112,"_3292":59170},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3839":1570,"_33145":1546,"_22633":59172,"_5":15597,"_29869":59112,"_3292":59173},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3839":1571,"_33145":1546,"_22633":59175,"_5":15597,"_29869":59112,"_3292":59176},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3839":1572,"_33145":1546,"_22633":59178,"_5":15597,"_29869":59112,"_3292":59179},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3839":1573,"_33145":1546,"_22633":59181,"_5":15597,"_29869":59112,"_3292":59182},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3839":1574,"_33145":1546,"_22633":59184,"_5":15597,"_29869":59112,"_3292":59185},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3839":1575,"_33145":1546,"_22633":59187,"_5":15597,"_29869":59112,"_3292":59188},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3839":1576,"_33145":1546,"_22633":59190,"_5":15597,"_29869":59115,"_3292":59191},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3839":1577,"_33145":1546,"_22633":59193,"_5":15597,"_29869":59115,"_3292":59194},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3839":1578,"_33145":1546,"_22633":59196,"_5":15597,"_29869":59118,"_3292":59197},[],"Participant",{"_3839":1579,"_33145":1546,"_22633":59199,"_5":15597,"_29869":59118,"_3292":59200},[],"Responsibility",{"_3839":1580,"_33145":1546,"_22633":59202,"_5":15597,"_29869":59118,"_3292":59203},[],"PKI administrator",{"_3839":1581,"_33145":1546,"_22633":59205,"_5":15597,"_29869":59118,"_3292":59206},[],"CA, issuance profile, chain and revocation publication.",{"_3839":1582,"_33145":1546,"_22633":59208,"_5":15597,"_29869":59118,"_3292":59209},[],"Provisioning administrator",{"_3839":1583,"_33145":1546,"_22633":59211,"_5":15597,"_29869":59118,"_3292":59212},[],"DMS, admission, authentication per operation and inventory.",{"_3839":1584,"_33145":1546,"_22633":59214,"_5":15597,"_29869":59118,"_3292":59215},[],"Device integrator",{"_3839":1585,"_33145":1546,"_22633":59217,"_5":15597,"_29869":59118,"_3292":59218},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3839":1586,"_33145":1546,"_22633":59220,"_5":15597,"_29869":59118,"_3292":59221},[],"Consumer integrator",{"_3839":1587,"_33145":1546,"_22633":59223,"_5":15597,"_29869":59118,"_3292":59224},[],"Trusted issuers, validation and device permissions in the destination.",{"_3839":1588,"_33145":1546,"_22633":59226,"_5":15597,"_29869":59118,"_3292":59227},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3839":1589,"_33145":1589,"_5":15996,"_3292":59229,"_33551":59230,"_22633":59232,"_29869":1589},"Enroll and connect your first device",[54324,55792,56803,59231],"Getting started",[],{"_3839":1590,"_33145":1589,"_22633":59234,"_5":15597,"_29869":1589,"_3292":59235},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3839":1591,"_33145":1589,"_5":33548,"_22633":59237,"_29869":59238,"_3292":54334},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3839":1592,"_33145":1589,"_5":33548,"_22633":59240,"_29869":59241,"_3292":59242},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3839":1593,"_33145":1589,"_5":33548,"_22633":59244,"_29869":59245,"_3292":59246},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3839":1594,"_33145":1589,"_5":33548,"_22633":59248,"_29869":59249,"_3292":59250},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3839":1595,"_33145":1589,"_5":33548,"_22633":59252,"_29869":59253,"_3292":59254},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3839":1596,"_33145":1589,"_5":33548,"_22633":59256,"_29869":59257,"_3292":59258},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3839":1597,"_33145":1589,"_5":33548,"_22633":59260,"_29869":59261,"_3292":59262},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3839":1598,"_33145":1589,"_5":33548,"_22633":59264,"_29869":59265,"_3292":59266},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3839":1599,"_33145":1589,"_22633":59268,"_5":15597,"_29869":1589,"_3292":59269},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3839":1600,"_33145":1589,"_22633":59271,"_5":15597,"_29869":59238,"_3292":59272},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3839":1601,"_33145":1589,"_22633":59274,"_5":15597,"_29869":59238,"_3292":59275},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3839":1602,"_33145":1589,"_22633":59277,"_5":15597,"_29869":59238,"_3292":59278},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3839":1603,"_33145":1589,"_22633":59280,"_5":15597,"_29869":59238,"_3292":59281},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3839":1604,"_33145":1589,"_22633":59283,"_5":15597,"_29869":59238,"_3292":59284},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3839":1605,"_33145":1589,"_22633":59286,"_5":15597,"_29869":59241,"_3292":59287},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3839":1606,"_33145":1589,"_22633":59289,"_5":15597,"_29869":59241,"_3292":59290},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3839":1607,"_33145":1589,"_22633":59292,"_5":15597,"_29869":59245,"_3292":59293},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3839":1608,"_33145":1589,"_22633":59295,"_5":15597,"_29869":59245,"_3292":59296},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3839":1609,"_33145":1589,"_22633":59298,"_5":15597,"_29869":59245,"_3292":59299},[],"Setting",{"_3839":1610,"_33145":1589,"_22633":59301,"_5":15597,"_29869":59245,"_3292":59302},[],"Evaluation value",{"_3839":1611,"_33145":1589,"_22633":59304,"_5":15597,"_29869":59245,"_3292":59305},[],"Enrollment CA",{"_3839":1612,"_33145":1589,"_22633":59307,"_5":15597,"_29869":59245,"_3292":59308},[],"Issuing root from `device-root.pem`.",{"_3839":1613,"_33145":1589,"_22633":59310,"_5":15597,"_29869":59245,"_3292":57114},[],{"_3839":1614,"_33145":1589,"_22633":59312,"_5":15597,"_29869":59245,"_3292":59313},[],"The 1-hour leaf profile you just prepared.",{"_3839":1615,"_33145":1589,"_22633":59315,"_5":15597,"_29869":59245,"_3292":59316},[],"Protocol / Registration Mode",{"_3839":1616,"_33145":1589,"_22633":59318,"_5":15597,"_29869":59245,"_3292":59319},[],"`EST_RFC7030` / `JITP`.",{"_3839":1617,"_33145":1589,"_22633":59321,"_5":15597,"_29869":59245,"_3292":59322},[],"Verify CSR Signature",{"_3839":1618,"_33145":1589,"_22633":59324,"_5":15597,"_29869":59245,"_3292":59325},[],"Enabled.",{"_3839":1619,"_33145":1589,"_22633":59327,"_5":15597,"_29869":59245,"_3292":59328},[],"Enable Replaceable Enrollment",{"_3839":1620,"_33145":1589,"_22633":59330,"_5":15597,"_29869":59245,"_3292":59331},[],"Disabled; the ID must be new.",{"_3839":1621,"_33145":1589,"_22633":59333,"_5":15597,"_29869":59245,"_3292":59334},[],"Initial authentication",{"_3839":1622,"_33145":1589,"_22633":59336,"_5":15597,"_29869":59245,"_3292":59337},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3839":1623,"_33145":1589,"_22633":59339,"_5":15597,"_29869":59245,"_3292":59340},[],"Renewal authentication",{"_3839":1624,"_33145":1589,"_22633":59342,"_5":15597,"_29869":59245,"_3292":59343},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3839":1625,"_33145":1589,"_22633":59345,"_5":15597,"_29869":59245,"_3292":59346},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3839":1626,"_33145":1589,"_22633":59348,"_5":15597,"_29869":59245,"_3292":59349},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3839":1627,"_33145":1589,"_22633":59351,"_5":15597,"_29869":59245,"_3292":59352},[],"Re-enrollment Delta",{"_3839":1628,"_33145":1589,"_22633":59354,"_5":15597,"_29869":59245,"_3292":59355},[],"1 hour.",{"_3839":1629,"_33145":1589,"_22633":59357,"_5":15597,"_29869":59245,"_3292":59358},[],"Preventive / Critical Delta",{"_3839":1630,"_33145":1589,"_22633":59360,"_5":15597,"_29869":59245,"_3292":59361},[],"30 minutes / 10 minutes.",{"_3839":1631,"_33145":1589,"_22633":59363,"_5":15597,"_29869":59245,"_3292":59364},[],"Revoke on Re-enrollment",{"_3839":1632,"_33145":1589,"_22633":59366,"_5":15597,"_29869":59245,"_3292":59367},[],"Disabled to test the successor before retiring the previous identity.",{"_3839":1633,"_33145":1589,"_22633":59369,"_5":15597,"_29869":59245,"_3292":57122},[],{"_3839":1634,"_33145":1589,"_22633":59371,"_5":15597,"_29869":59245,"_3292":59372},[],"Disabled; the operational key is generated in the client.",{"_3839":1635,"_33145":1589,"_22633":59374,"_5":15597,"_29869":59245,"_3292":59375},[],"CA Distribution",{"_3839":1636,"_33145":1589,"_22633":59377,"_5":15597,"_29869":59245,"_3292":59378},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3839":1637,"_33145":1589,"_22633":59380,"_5":15597,"_29869":59245,"_3292":59381},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3839":1638,"_33145":1589,"_22633":59383,"_5":15597,"_29869":59249,"_3292":59384},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3839":1639,"_33145":1589,"_22633":59386,"_5":15597,"_29869":59249,"_3292":59387},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3839":1640,"_33145":1589,"_22633":59389,"_5":15597,"_29869":59253,"_3292":59390},[],"Generate a new key and CSR with the selected identifier:",{"_3839":1641,"_33145":1589,"_22633":59392,"_5":15597,"_29869":59253,"_3292":59393},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3839":1642,"_33145":1589,"_22633":59395,"_5":15597,"_29869":59253,"_3292":59396},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3839":1643,"_33145":1589,"_22633":59398,"_5":15597,"_29869":59257,"_3292":59399},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3839":1644,"_33145":1589,"_22633":59401,"_5":15597,"_29869":59257,"_3292":59402},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3839":1645,"_33145":1589,"_22633":59404,"_5":15597,"_29869":59261,"_3292":59405},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3839":1646,"_33145":1589,"_22633":59407,"_5":15597,"_29869":59261,"_3292":59408},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3839":1647,"_33145":1589,"_22633":59410,"_5":15597,"_29869":59261,"_3292":59411},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3839":1648,"_33145":1589,"_22633":59413,"_5":15597,"_29869":59261,"_3292":59414},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3839":1649,"_33145":1589,"_22633":59416,"_5":15597,"_29869":59261,"_3292":59417},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3839":1650,"_33145":1589,"_22633":59419,"_5":15597,"_29869":59265,"_3292":59420},[],"Check",{"_3839":1651,"_33145":1589,"_22633":59422,"_5":15597,"_29869":59265,"_3292":59423},[],"Expected result",{"_3839":1652,"_33145":1589,"_22633":59425,"_5":15597,"_29869":59265,"_3292":59426},[],"Registration",{"_3839":1653,"_33145":1589,"_22633":59428,"_5":15597,"_29869":59265,"_3292":59429},[],"ID created automatically and correct DMS.",{"_3839":1654,"_33145":1589,"_22633":59431,"_5":15597,"_29869":59265,"_3292":58687},[],{"_3839":1655,"_33145":1589,"_22633":59433,"_5":15597,"_29869":59265,"_3292":59434},[],"CN, profile, serial and key verified.",{"_3839":1656,"_33145":1589,"_22633":59436,"_5":15597,"_29869":59265,"_3292":59437},[],"Inventory",{"_3839":1657,"_33145":1589,"_22633":59439,"_5":15597,"_29869":59265,"_3292":59440},[],"Received serial visible as the current identity and in history.",{"_3839":1658,"_33145":1589,"_22633":59442,"_5":15597,"_29869":59265,"_3292":59443},[],"Consumer",{"_3839":1659,"_33145":1589,"_22633":59445,"_5":15597,"_29869":59265,"_3292":59446},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3839":1660,"_33145":1589,"_22633":59448,"_5":15597,"_29869":59265,"_3292":59449},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3839":1661,"_33145":1589,"_22633":59451,"_5":15597,"_29869":59265,"_3292":59452},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3839":1662,"_33145":1662,"_5":15996,"_3292":56819,"_33551":59454,"_22633":59455,"_29869":1662},[54324,55792,56803,59231],[],{"_3839":1663,"_33145":1662,"_22633":59457,"_5":15597,"_29869":1662,"_3292":59458},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3839":1664,"_33145":1662,"_5":33548,"_22633":59460,"_29869":59461,"_3292":54334},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3839":1665,"_33145":1662,"_5":33548,"_22633":59463,"_29869":59464,"_3292":59465},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3839":1666,"_33145":1662,"_5":33548,"_22633":59467,"_29869":59468,"_3292":59469},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3839":1667,"_33145":1662,"_5":33548,"_22633":59471,"_29869":59472,"_3292":59473},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3839":1668,"_33145":1662,"_5":33548,"_22633":59475,"_29869":59476,"_3292":59477},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3839":1669,"_33145":1662,"_5":33548,"_22633":59479,"_29869":59480,"_3292":59481},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3839":1670,"_33145":1662,"_5":33548,"_22633":59483,"_29869":59484,"_3292":59423},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3839":1671,"_33145":1662,"_5":33548,"_22633":59486,"_29869":59487,"_3292":59488},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3839":1672,"_33145":1662,"_5":33548,"_22633":59490,"_29869":59491,"_3292":59492},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3839":1673,"_33145":1662,"_22633":59494,"_5":15597,"_29869":1662,"_3292":59495},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3839":1674,"_33145":1662,"_22633":59497,"_5":15597,"_29869":1662,"_3292":59498},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3839":1675,"_33145":1662,"_22633":59500,"_5":15597,"_29869":59461,"_3292":59501},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3839":1676,"_33145":1662,"_22633":59503,"_5":15597,"_29869":59461,"_3292":59504},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3839":1677,"_33145":1662,"_22633":59506,"_5":15597,"_29869":59461,"_3292":59507},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3839":1678,"_33145":1662,"_22633":59509,"_5":15597,"_29869":59461,"_3292":59510},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3839":1679,"_33145":1662,"_22633":59512,"_5":15597,"_29869":59464,"_3292":59513},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3839":1680,"_33145":1662,"_22633":59515,"_5":15597,"_29869":59464,"_3292":59516},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3839":1681,"_33145":1662,"_22633":59518,"_5":15597,"_29869":59464,"_3292":59519},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3839":1682,"_33145":1662,"_22633":59521,"_5":15597,"_29869":59464,"_3292":59522},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3839":1683,"_33145":1662,"_22633":59524,"_5":15597,"_29869":59464,"_3292":59525},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3839":1684,"_33145":1662,"_22633":59527,"_5":15597,"_29869":59464,"_3292":59528},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3839":1685,"_33145":1662,"_22633":59530,"_5":15597,"_29869":59464,"_3292":59531},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3839":1686,"_33145":1662,"_22633":59533,"_5":15597,"_29869":59464,"_3292":59534},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3839":1687,"_33145":1662,"_22633":59536,"_5":15597,"_29869":59468,"_3292":59537},[],"Open **Managed Devices** and the registration action. Complete:",{"_3839":1688,"_33145":1662,"_22633":59539,"_5":15597,"_29869":59468,"_3292":59540},[],"**Device ID**: `device-001`.",{"_3839":1689,"_33145":1662,"_22633":59542,"_5":15597,"_29869":59468,"_3292":59543},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3839":1690,"_33145":1662,"_22633":59545,"_5":15597,"_29869":59468,"_3292":59546},[],"**Icon** and **Tags**: optional classification.",{"_3839":1691,"_33145":1662,"_22633":59548,"_5":15597,"_29869":59468,"_3292":59549},[],"Confirm registration.",{"_3839":1692,"_33145":1662,"_22633":59551,"_5":15597,"_29869":59472,"_3292":59552},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3839":1693,"_33145":1662,"_22633":59554,"_5":15597,"_29869":59472,"_3292":59555},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3839":1694,"_33145":1662,"_22633":59557,"_5":15597,"_29869":59476,"_3292":59558},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3839":1695,"_33145":1662,"_22633":59560,"_5":15597,"_29869":59476,"_3292":59561},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3839":1696,"_33145":1662,"_22633":59563,"_5":15597,"_29869":59480,"_3292":59564},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3839":1697,"_33145":1662,"_22633":59566,"_5":15597,"_29869":59480,"_3292":59567},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3839":1698,"_33145":1662,"_22633":59569,"_5":15597,"_29869":59484,"_3292":59420},[],{"_3839":1699,"_33145":1662,"_22633":59571,"_5":15597,"_29869":59484,"_3292":59572},[],"Result",{"_3839":1700,"_33145":1662,"_22633":59574,"_5":15597,"_29869":59484,"_3292":58670},[],{"_3839":1701,"_33145":1662,"_22633":59576,"_5":15597,"_29869":59484,"_3292":59577},[],"`device-001` appears in inventory with the expected DMS.",{"_3839":1702,"_33145":1662,"_22633":59579,"_5":15597,"_29869":59484,"_3292":59580},[],"Current identity",{"_3839":1703,"_33145":1662,"_22633":59582,"_5":15597,"_29869":59484,"_3292":59583},[],"The associated certificate matches the one you verified in PKI.",{"_3839":1704,"_33145":1662,"_22633":59585,"_5":15597,"_29869":59484,"_3292":59586},[],"History",{"_3839":1705,"_33145":1662,"_22633":59588,"_5":15597,"_29869":59484,"_3292":59589},[],"The associated issuance appears with its serial number and dates.",{"_3839":1706,"_33145":1662,"_22633":59591,"_5":15597,"_29869":59484,"_3292":59592},[],"Key and certificate",{"_3839":1707,"_33145":1662,"_22633":59594,"_5":15597,"_29869":59484,"_3292":59595},[],"You have the verified pair ready to install on the device.",{"_3839":1708,"_33145":1662,"_22633":59597,"_5":15597,"_29869":59487,"_3292":59598},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3839":1709,"_33145":1662,"_22633":59600,"_5":15597,"_29869":59487,"_3292":59601},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3839":1710,"_33145":1662,"_22633":59603,"_5":15597,"_29869":59487,"_3292":59604},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3839":1711,"_33145":1662,"_22633":59606,"_5":15597,"_29869":59487,"_3292":59607},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3839":1712,"_33145":1662,"_22633":59609,"_5":15597,"_29869":59491,"_3292":59610},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3839":1713,"_33145":1662,"_22633":59612,"_5":15597,"_29869":59491,"_3292":59613},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3839":1714,"_33145":1662,"_22633":59615,"_5":15597,"_29869":59491,"_3292":59616},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3839":1715,"_33145":1715,"_5":15996,"_3292":59618,"_33551":59619,"_22633":59620,"_29869":1715},"Lamassu IoT Platform",[54324,55792],[],{"_3839":1716,"_33145":1715,"_22633":59622,"_5":15597,"_29869":1715,"_3292":59623},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3839":1717,"_33145":1715,"_5":33548,"_22633":59625,"_29869":59626,"_3292":59106},[],"/docs/pr-preview/pr-58/platform/overview#start-here",{"_3839":1718,"_33145":1715,"_5":33548,"_22633":59628,"_29869":59629,"_3292":59630},[],"/docs/pr-preview/pr-58/platform/overview#choose-your-path","Choose your path",{"_3839":1719,"_33145":1715,"_5":33548,"_22633":59632,"_29869":59633,"_3292":59634},[],"/docs/pr-preview/pr-58/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3839":1720,"_33145":1715,"_5":33548,"_22633":59636,"_29869":59637,"_3292":59638},[],"/docs/pr-preview/pr-58/platform/overview#core-capabilities","Core capabilities",{"_3839":1721,"_33145":1715,"_5":33548,"_22633":59640,"_29869":59641,"_3292":59642},[],"/docs/pr-preview/pr-58/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3839":1722,"_33145":1715,"_5":33548,"_22633":59644,"_29869":59645,"_3292":59646},[],"/docs/pr-preview/pr-58/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3839":1723,"_33145":1715,"_5":33548,"_22633":59648,"_29869":59649,"_3292":59650},[],"/docs/pr-preview/pr-58/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3839":1724,"_33145":1715,"_5":33548,"_22633":59652,"_29869":59653,"_3292":59654},[],"/docs/pr-preview/pr-58/platform/overview#automate-device-identities","Automate device identities",{"_3839":1725,"_33145":1715,"_5":33548,"_22633":59656,"_29869":59657,"_3292":59658},[],"/docs/pr-preview/pr-58/platform/overview#publish-validation-status","Publish validation status",{"_3839":1726,"_33145":1715,"_5":33548,"_22633":59660,"_29869":59661,"_3292":59662},[],"/docs/pr-preview/pr-58/platform/overview#react-to-events","React to events",{"_3839":1727,"_33145":1715,"_5":33548,"_22633":59664,"_29869":59665,"_3292":59666},[],"/docs/pr-preview/pr-58/platform/overview#operational-reference","Operational reference",{"_3839":1728,"_33145":1715,"_22633":59668,"_5":15597,"_29869":1715,"_3292":59669},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3839":1729,"_33145":1715,"_22633":59671,"_5":15597,"_29869":59626,"_3292":59672},[],"Choose the result you need:",{"_3839":1730,"_33145":1715,"_22633":59674,"_5":15597,"_29869":59626,"_3292":59675},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3839":1731,"_33145":1715,"_22633":59677,"_5":15597,"_29869":59626,"_3292":59678},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3839":1732,"_33145":1715,"_22633":59680,"_5":15597,"_29869":59626,"_3292":59681},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3839":1733,"_33145":1715,"_22633":59683,"_5":15597,"_29869":59629,"_3292":59684},[],"Section",{"_3839":1734,"_33145":1715,"_22633":59686,"_5":15597,"_29869":59629,"_3292":59687},[],"What you manage",{"_3839":1735,"_33145":1715,"_22633":59689,"_5":15597,"_29869":59629,"_3292":59690},[],"Entry point",{"_3839":1736,"_33145":1715,"_22633":59692,"_5":15597,"_29869":59629,"_3292":59693},[],"**PKI**",{"_3839":1737,"_33145":1715,"_22633":59695,"_5":15597,"_29869":59629,"_3292":59696},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3839":1738,"_33145":1715,"_22633":59698,"_5":15597,"_29869":59629,"_3292":59699},[],"PKI overview",{"_3839":1739,"_33145":1715,"_22633":59701,"_5":15597,"_29869":59629,"_3292":59702},[],"**IoT Fleets**",{"_3839":1740,"_33145":1715,"_22633":59704,"_5":15597,"_29869":59629,"_3292":59705},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3839":1741,"_33145":1715,"_22633":59707,"_5":15597,"_29869":59629,"_3292":59708},[],"IoT Fleets overview",{"_3839":1742,"_33145":1715,"_22633":59710,"_5":15597,"_29869":59629,"_3292":59711},[],"**Administration**",{"_3839":1743,"_33145":1715,"_22633":59713,"_5":15597,"_29869":59629,"_3292":59714},[],"Operator permissions, audit and event subscriptions.",{"_3839":1744,"_33145":1715,"_22633":59716,"_5":15597,"_29869":59629,"_3292":55790},[],{"_3839":1745,"_33145":1715,"_22633":59718,"_5":15597,"_29869":59629,"_3292":59719},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3839":1746,"_33145":1715,"_22633":59721,"_5":15597,"_29869":59633,"_3292":59722},[],"An identity's journey connects four responsibilities:",{"_3839":1747,"_33145":1715,"_22633":59724,"_5":15597,"_29869":59633,"_3292":59725},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3839":1748,"_33145":1715,"_22633":59727,"_5":15597,"_29869":59633,"_3292":59728},[],"The provisioning administrator configures the DMS and initial trust.",{"_3839":1749,"_33145":1715,"_22633":59730,"_5":15597,"_29869":59633,"_3292":59731},[],"The device client requests a certificate and installs it with the matching key.",{"_3839":1750,"_33145":1715,"_22633":59733,"_5":15597,"_29869":59633,"_3292":59734},[],"The consumer validates the identity and applies its access permissions.",{"_3839":1751,"_33145":1715,"_22633":59736,"_5":15597,"_29869":59633,"_3292":59737},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3839":1752,"_33145":1715,"_22633":59739,"_5":15597,"_29869":59641,"_3292":59740},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3839":1753,"_33145":1715,"_22633":59742,"_5":15597,"_29869":59645,"_3292":59743},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3839":1754,"_33145":1715,"_22633":59745,"_5":15597,"_29869":59649,"_3292":59746},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3839":1755,"_33145":1715,"_22633":59748,"_5":15597,"_29869":59653,"_3292":59749},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3839":1756,"_33145":1715,"_22633":59751,"_5":15597,"_29869":59657,"_3292":59752},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3839":1757,"_33145":1715,"_22633":59754,"_5":15597,"_29869":59661,"_3292":59755},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3839":1758,"_33145":1715,"_22633":59757,"_5":15597,"_29869":59665,"_3292":59200},[],{"_3839":1759,"_33145":1715,"_22633":59759,"_5":15597,"_29869":59665,"_3292":59760},[],"What it prepares or checks",{"_3839":1760,"_33145":1715,"_22633":59762,"_5":15597,"_29869":59665,"_3292":59203},[],{"_3839":1761,"_33145":1715,"_22633":59764,"_5":15597,"_29869":59665,"_3292":59765},[],"Key custody, CA hierarchy, profiles and validation.",{"_3839":1762,"_33145":1715,"_22633":59767,"_5":15597,"_29869":59665,"_3292":59768},[],"Fleet administrator",{"_3839":1763,"_33145":1715,"_22633":59770,"_5":15597,"_29869":59665,"_3292":59771},[],"DMS, device admission, renewal policy and inventory.",{"_3839":1764,"_33145":1715,"_22633":59773,"_5":15597,"_29869":59665,"_3292":59215},[],{"_3839":1765,"_33145":1715,"_22633":59775,"_5":15597,"_29869":59665,"_3292":59776},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3839":1766,"_33145":1715,"_22633":59778,"_5":15597,"_29869":59665,"_3292":59221},[],{"_3839":1767,"_33145":1715,"_22633":59780,"_5":15597,"_29869":59665,"_3292":59781},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3839":1768,"_33145":1715,"_22633":59783,"_5":15597,"_29869":59665,"_3292":59784},[],"Infrastructure operator",{"_3839":1769,"_33145":1715,"_22633":59786,"_5":15597,"_29869":59665,"_3292":59787},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3839":1770,"_33145":1715,"_22633":59789,"_5":15597,"_29869":59665,"_3292":59790},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3839":1771,"_33145":1771,"_5":15996,"_3292":59792,"_33551":59793,"_22633":59796,"_29869":1771},"CA hierarchy and rotation",[54324,55792,59794,59795],"PKI","Keys, authorities and certificates",[],{"_3839":1772,"_33145":1771,"_22633":59798,"_5":15597,"_29869":1771,"_3292":59799},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3839":1773,"_33145":1771,"_5":33548,"_22633":59801,"_29869":59802,"_3292":59803},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3839":1774,"_33145":1771,"_5":33548,"_22633":59805,"_29869":59806,"_3292":59807},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3839":1775,"_33145":1771,"_5":33548,"_22633":59809,"_29869":59810,"_3292":59811},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3839":1776,"_33145":1771,"_5":33548,"_22633":59813,"_29869":59814,"_3292":59815},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3839":1777,"_33145":1771,"_5":33548,"_22633":59817,"_29869":59818,"_3292":59819},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3839":1778,"_33145":1771,"_5":33548,"_22633":59821,"_29869":59822,"_3292":59823},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3839":1779,"_33145":1771,"_5":33548,"_22633":59825,"_29869":59826,"_3292":59827},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3839":1780,"_33145":1771,"_5":33548,"_22633":59829,"_29869":59830,"_3292":59831},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3839":1781,"_33145":1771,"_5":33548,"_22633":59833,"_29869":59834,"_3292":59835},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3839":1782,"_33145":1771,"_5":33548,"_22633":59837,"_29869":59838,"_3292":59839},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3839":1783,"_33145":1771,"_5":33548,"_22633":59841,"_29869":59842,"_3292":59843},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3839":1784,"_33145":1771,"_5":33548,"_22633":59845,"_29869":59846,"_3292":59847},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3839":1785,"_33145":1771,"_22633":59849,"_5":15597,"_29869":1771,"_3292":59850},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3839":1786,"_33145":1771,"_22633":59852,"_5":15597,"_29869":1771,"_3292":59853},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3839":1787,"_33145":1771,"_22633":59855,"_5":15597,"_29869":59802,"_3292":59856},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3839":1788,"_33145":1771,"_22633":59858,"_5":15597,"_29869":59802,"_3292":59859},[],"environment, such as production and preproduction;",{"_3839":1789,"_33145":1771,"_22633":59861,"_5":15597,"_29869":59802,"_3292":59862},[],"owner or operating team;",{"_3839":1790,"_33145":1771,"_22633":59864,"_5":15597,"_29869":59802,"_3292":59865},[],"device family or manufacturing process;",{"_3839":1791,"_33145":1771,"_22633":59867,"_5":15597,"_29869":59802,"_3292":59868},[],"region or regulatory requirement;",{"_3839":1792,"_33145":1771,"_22633":59870,"_5":15597,"_29869":59802,"_3292":59871},[],"cryptographic engine or key policy;",{"_3839":1793,"_33145":1771,"_22633":59873,"_5":15597,"_29869":59802,"_3292":59874},[],"maintenance window and renewal cadence.",{"_3839":1794,"_33145":1771,"_22633":59876,"_5":15597,"_29869":59802,"_3292":59877},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3839":1795,"_33145":1771,"_22633":59879,"_5":15597,"_29869":59802,"_3292":59880},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3839":1796,"_33145":1771,"_22633":59882,"_5":15597,"_29869":59806,"_3292":59883},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3839":1797,"_33145":1771,"_22633":59885,"_5":15597,"_29869":59806,"_3292":59886},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3839":1798,"_33145":1771,"_22633":59888,"_5":15597,"_29869":59806,"_3292":59889},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3839":1799,"_33145":1771,"_22633":59891,"_5":15597,"_29869":59810,"_3292":59892},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3839":1800,"_33145":1771,"_22633":59894,"_5":15597,"_29869":59810,"_3292":59895},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3839":1801,"_33145":1771,"_22633":59897,"_5":15597,"_29869":59810,"_3292":59898},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3839":1802,"_33145":1771,"_22633":59900,"_5":15597,"_29869":59810,"_3292":59901},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3839":1803,"_33145":1771,"_22633":59903,"_5":15597,"_29869":59818,"_3292":59904},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3839":1804,"_33145":1771,"_22633":59906,"_5":15597,"_29869":59822,"_3292":59907},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3839":1805,"_33145":1771,"_22633":59909,"_5":15597,"_29869":59826,"_3292":59910},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3839":1806,"_33145":1771,"_22633":59912,"_5":15597,"_29869":59830,"_3292":59913},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3839":1807,"_33145":1771,"_22633":59915,"_5":15597,"_29869":59834,"_3292":59916},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3839":1808,"_33145":1771,"_22633":59918,"_5":15597,"_29869":59838,"_3292":59919},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3839":1809,"_33145":1771,"_22633":59921,"_5":15597,"_29869":59842,"_3292":59922},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3839":1810,"_33145":1771,"_22633":59924,"_5":15597,"_29869":59842,"_3292":59925},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3839":1811,"_33145":1771,"_22633":59927,"_5":15597,"_29869":59842,"_3292":59928},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3839":1812,"_33145":1771,"_22633":59930,"_5":15597,"_29869":59842,"_3292":59931},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3839":1813,"_33145":1771,"_22633":59933,"_5":15597,"_29869":59846,"_3292":59934},[],"The new chain ends in an anchor installed by the consumer.",{"_3839":1814,"_33145":1771,"_22633":59936,"_5":15597,"_29869":59846,"_3292":59937},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3839":1815,"_33145":1771,"_22633":59939,"_5":15597,"_29869":59846,"_3292":59940},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3839":1816,"_33145":1771,"_22633":59942,"_5":15597,"_29869":59846,"_3292":59943},[],"Re-enrollment accepts the old identity during the planned period.",{"_3839":1817,"_33145":1771,"_22633":59945,"_5":15597,"_29869":59846,"_3292":59946},[],"OCSP and CRL respond for the authorities that remain active.",{"_3839":1818,"_33145":1771,"_22633":59948,"_5":15597,"_29869":59846,"_3292":59949},[],"No DMS is left accidentally issuing from the old CA.",{"_3839":1819,"_33145":1771,"_22633":59951,"_5":15597,"_29869":59846,"_3292":59952},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3839":1820,"_33145":1820,"_5":15996,"_3292":59954,"_33551":59955,"_22633":59956,"_29869":1820},"Certification authorities",[54324,55792,59794,59795],[],{"_3839":1821,"_33145":1820,"_22633":59958,"_5":15597,"_29869":1820,"_3292":59959},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3839":1822,"_33145":1820,"_5":33548,"_22633":59961,"_29869":59962,"_3292":59963},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3839":1823,"_33145":1820,"_5":33548,"_22633":59965,"_29869":59966,"_3292":59967},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3839":1824,"_33145":1820,"_5":33548,"_22633":59969,"_29869":59970,"_3292":54334},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#before-you-begin",{"_3839":1825,"_33145":1820,"_5":33548,"_22633":59972,"_29869":59973,"_3292":59974},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3839":1826,"_33145":1820,"_5":33548,"_22633":59976,"_29869":59977,"_3292":59978},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3839":1827,"_33145":1820,"_5":33548,"_22633":59980,"_29869":59981,"_3292":59982},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3839":1828,"_33145":1820,"_5":33548,"_22633":59984,"_29869":59985,"_3292":59986},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3839":1829,"_33145":1820,"_5":33548,"_22633":59988,"_29869":59989,"_3292":59990},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3839":1830,"_33145":1820,"_5":33548,"_22633":59992,"_29869":59993,"_3292":59994},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3839":1831,"_33145":1820,"_5":33548,"_22633":59996,"_29869":59997,"_3292":59998},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3839":1832,"_33145":1820,"_5":33548,"_22633":60000,"_29869":60001,"_3292":60002},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3839":1833,"_33145":1820,"_5":33548,"_22633":60004,"_29869":60005,"_3292":60006},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3839":1834,"_33145":1820,"_5":33548,"_22633":60008,"_29869":60009,"_3292":60010},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3839":1835,"_33145":1820,"_5":33548,"_22633":60012,"_29869":60013,"_3292":60014},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3839":1836,"_33145":1820,"_5":33548,"_22633":60016,"_29869":60017,"_3292":60018},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3839":1837,"_33145":1820,"_5":33548,"_22633":60020,"_29869":60021,"_3292":60022},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3839":1838,"_33145":1820,"_5":33548,"_22633":60024,"_29869":60025,"_3292":60026},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3839":1839,"_33145":1820,"_5":33548,"_22633":60028,"_29869":60029,"_3292":60030},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3839":1840,"_33145":1820,"_5":33548,"_22633":60032,"_29869":60033,"_3292":60034},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3839":1841,"_33145":1820,"_5":33548,"_22633":60036,"_29869":60037,"_3292":60038},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3839":1842,"_33145":1820,"_5":33548,"_22633":60040,"_29869":60041,"_3292":60042},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3839":1843,"_33145":1820,"_5":33548,"_22633":60044,"_29869":60045,"_3292":60046},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3839":1844,"_33145":1820,"_5":33548,"_22633":60048,"_29869":60049,"_3292":60050},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3839":1845,"_33145":1820,"_22633":60052,"_5":15597,"_29869":1820,"_3292":60053},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3839":1846,"_33145":1820,"_22633":60055,"_5":15597,"_29869":1820,"_3292":60056},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3839":1847,"_33145":1820,"_22633":60058,"_5":15597,"_29869":1820,"_3292":60059},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3839":1848,"_33145":1820,"_22633":60061,"_5":15597,"_29869":59962,"_3292":60062},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3839":1849,"_33145":1820,"_22633":60064,"_5":15597,"_29869":59962,"_3292":60065},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3839":1850,"_33145":1820,"_22633":60067,"_5":15597,"_29869":59962,"_3292":60068},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3839":1851,"_33145":1820,"_22633":60070,"_5":15597,"_29869":59962,"_3292":60071},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3839":1852,"_33145":1820,"_22633":60073,"_5":15597,"_29869":59962,"_3292":60074},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3839":1853,"_33145":1820,"_22633":60076,"_5":15597,"_29869":59970,"_3292":60077},[],"Decide whether the CA will be a root or an intermediate.",{"_3839":1854,"_33145":1820,"_22633":60079,"_5":15597,"_29869":59970,"_3292":60080},[],"Choose the engine that will keep the key.",{"_3839":1855,"_33145":1820,"_22633":60082,"_5":15597,"_29869":59970,"_3292":60083},[],"Define a validity longer than that of the certificates it will issue.",{"_3839":1856,"_33145":1820,"_22633":60085,"_5":15597,"_29869":59970,"_3292":60086},[],"For an intermediate CA, make sure the parent CA is active.",{"_3839":1857,"_33145":1820,"_22633":60088,"_5":15597,"_29869":59973,"_3292":60089},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3839":1858,"_33145":1820,"_22633":60091,"_5":15597,"_29869":59977,"_3292":60092},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3839":1859,"_33145":1820,"_22633":60094,"_5":15597,"_29869":59977,"_3292":60095},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3839":1860,"_33145":1820,"_22633":60097,"_5":15597,"_29869":59981,"_3292":60098},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3839":1861,"_33145":1820,"_22633":60100,"_5":15597,"_29869":59985,"_3292":60101},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3839":1862,"_33145":1820,"_22633":60103,"_5":15597,"_29869":59985,"_3292":60104},[],"`C`: two-letter ISO 3166-1 country code.",{"_3839":1863,"_33145":1820,"_22633":60106,"_5":15597,"_29869":59985,"_3292":60107},[],"`ST`: state or province.",{"_3839":1864,"_33145":1820,"_22633":60109,"_5":15597,"_29869":59985,"_3292":60110},[],"`L`: locality.",{"_3839":1865,"_33145":1820,"_22633":60112,"_5":15597,"_29869":59985,"_3292":60113},[],"`O`: organization.",{"_3839":1866,"_33145":1820,"_22633":60115,"_5":15597,"_29869":59985,"_3292":60116},[],"`OU`: organizational unit.",{"_3839":1867,"_33145":1820,"_22633":60118,"_5":15597,"_29869":59985,"_3292":60119},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3839":1868,"_33145":1820,"_22633":60121,"_5":15597,"_29869":59989,"_3292":60122},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3839":1869,"_33145":1820,"_22633":60124,"_5":15597,"_29869":59989,"_3292":60125},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3839":1870,"_33145":1820,"_22633":60127,"_5":15597,"_29869":59993,"_3292":60128},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3839":1871,"_33145":1820,"_22633":60130,"_5":15597,"_29869":59993,"_3292":60131},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3839":1872,"_33145":1820,"_22633":60133,"_5":15597,"_29869":59997,"_3292":60134},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3839":1873,"_33145":1820,"_22633":60136,"_5":15597,"_29869":59997,"_3292":60137},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3839":1874,"_33145":1820,"_22633":60139,"_5":15597,"_29869":60001,"_3292":60140},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3839":1875,"_33145":1820,"_22633":60142,"_5":15597,"_29869":60001,"_3292":60143},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3839":1876,"_33145":1820,"_22633":60145,"_5":15597,"_29869":60001,"_3292":60146},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3839":1877,"_33145":1820,"_22633":60148,"_5":15597,"_29869":60005,"_3292":60149},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3839":1878,"_33145":1820,"_22633":60151,"_5":15597,"_29869":60009,"_3292":60152},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3839":1879,"_33145":1820,"_22633":60154,"_5":15597,"_29869":60013,"_3292":60155},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3839":1880,"_33145":1820,"_22633":60157,"_5":15597,"_29869":60017,"_3292":60158},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3839":1881,"_33145":1820,"_22633":60160,"_5":15597,"_29869":60017,"_3292":60161},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3839":1882,"_33145":1820,"_22633":60163,"_5":15597,"_29869":60021,"_3292":60164},[],"Open a CA from the inventory to review:",{"_3839":1883,"_33145":1820,"_22633":60166,"_5":15597,"_29869":60021,"_3292":60167},[],"Status and validity period.",{"_3839":1884,"_33145":1820,"_22633":60169,"_5":15597,"_29869":60021,"_3292":60170},[],"Certificate and chain in PEM format.",{"_3839":1885,"_33145":1820,"_22633":60172,"_5":15597,"_29869":60021,"_3292":60173},[],"Number of active, expired and revoked certificates.",{"_3839":1886,"_33145":1820,"_22633":60175,"_5":15597,"_29869":60021,"_3292":60176},[],"Certificates issued in **Issued Certificates**.",{"_3839":1887,"_33145":1820,"_22633":60178,"_5":15597,"_29869":60021,"_3292":60179},[],"The CRL linked to the authority.",{"_3839":1888,"_33145":1820,"_22633":60181,"_5":15597,"_29869":60021,"_3292":60182},[],"Metadata and the associated cryptographic engine.",{"_3839":1889,"_33145":1820,"_22633":60184,"_5":15597,"_29869":60021,"_3292":60185},[],"You can filter the inventory by name, status and CA type.",{"_3839":1890,"_33145":1820,"_22633":60187,"_5":15597,"_29869":60025,"_3292":60188},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3839":1891,"_33145":1820,"_22633":60190,"_5":15597,"_29869":60025,"_3292":60191},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3839":1892,"_33145":1820,"_22633":60193,"_5":15597,"_29869":60025,"_3292":60194},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3839":1893,"_33145":1820,"_22633":60196,"_5":15597,"_29869":60025,"_3292":60197},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3839":1894,"_33145":1820,"_22633":60199,"_5":15597,"_29869":60029,"_3292":60200},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3839":1895,"_33145":1820,"_22633":60202,"_5":15597,"_29869":60033,"_3292":60203},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3839":1896,"_33145":1820,"_22633":60205,"_5":15597,"_29869":60037,"_3292":60206},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3839":1897,"_33145":1820,"_22633":60208,"_5":15597,"_29869":60041,"_3292":60209},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3839":1898,"_33145":1820,"_22633":60211,"_5":15597,"_29869":60045,"_3292":60212},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3839":1899,"_33145":1820,"_22633":60214,"_5":15597,"_29869":60049,"_3292":60215},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3839":1900,"_33145":1820,"_22633":60217,"_5":15597,"_29869":60049,"_3292":60218},[],"The CA’s VA role is kept. If no other CA with the same SKI remains, it can no longer be edited (see CRL), so adjust its validity and signer beforehand. The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3839":1901,"_33145":1820,"_22633":60220,"_5":15597,"_29869":60049,"_3292":60221},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. If the new certificate uses the same key, it shares the SKI with the retained VA role of the deleted CA, whose signer is the old certificate: check that the CRL is generated and, if it is not, use `PUT` to set a signer of the new CA (see CRL).",{"_3839":1902,"_33145":1902,"_5":15996,"_3292":60223,"_33551":60224,"_22633":60225,"_29869":1902},"Certificate profiles",[54324,55792,59794,59795],[],{"_3839":1903,"_33145":1902,"_22633":60227,"_5":15597,"_29869":1902,"_3292":60228},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3839":1904,"_33145":1902,"_5":33548,"_22633":60230,"_29869":60231,"_3292":60232},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3839":1905,"_33145":1902,"_5":33548,"_22633":60234,"_29869":60235,"_3292":60236},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#validity","Validity",{"_3839":1906,"_33145":1902,"_5":33548,"_22633":60238,"_29869":60239,"_3292":60240},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3839":1907,"_33145":1902,"_5":33548,"_22633":60242,"_29869":60243,"_3292":60244},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3839":1908,"_33145":1902,"_5":33548,"_22633":60246,"_29869":60247,"_3292":60248},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#subject","Subject",{"_3839":1909,"_33145":1902,"_5":33548,"_22633":60250,"_29869":60251,"_3292":60252},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3839":1910,"_33145":1902,"_5":33548,"_22633":60254,"_29869":60255,"_3292":60256},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3839":1911,"_33145":1902,"_5":33548,"_22633":60258,"_29869":60259,"_3292":60260},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3839":1912,"_33145":1902,"_5":33548,"_22633":60262,"_29869":60263,"_3292":60264},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3839":1913,"_33145":1902,"_5":33548,"_22633":60266,"_29869":60267,"_3292":60268},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3839":1914,"_33145":1902,"_5":33548,"_22633":60270,"_29869":60271,"_3292":60272},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3839":1915,"_33145":1902,"_5":33548,"_22633":60274,"_29869":60275,"_3292":60276},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3839":1916,"_33145":1902,"_5":33548,"_22633":60278,"_29869":60279,"_3292":60280},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3839":1917,"_33145":1902,"_5":33548,"_22633":60282,"_29869":60283,"_3292":60284},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3839":1918,"_33145":1902,"_5":33548,"_22633":60286,"_29869":60287,"_3292":60288},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#design-examples","Design examples",{"_3839":1919,"_33145":1902,"_5":33548,"_22633":60290,"_29869":60291,"_3292":60292},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3839":1920,"_33145":1902,"_22633":60294,"_5":15597,"_29869":1902,"_3292":60295},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3839":1921,"_33145":1902,"_22633":60297,"_5":15597,"_29869":1902,"_3292":60298},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3839":1922,"_33145":1902,"_22633":60300,"_5":15597,"_29869":60235,"_3292":60301},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3839":1923,"_33145":1902,"_22633":60303,"_5":15597,"_29869":60235,"_3292":60304},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3839":1924,"_33145":1902,"_22633":60306,"_5":15597,"_29869":60239,"_3292":60307},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3839":1925,"_33145":1902,"_22633":60309,"_5":15597,"_29869":60243,"_3292":60310},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3839":1926,"_33145":1902,"_22633":60312,"_5":15597,"_29869":60243,"_3292":60313},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3839":1927,"_33145":1902,"_22633":60315,"_5":15597,"_29869":60243,"_3292":60316},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3839":1928,"_33145":1902,"_22633":60318,"_5":15597,"_29869":60247,"_3292":60319},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3839":1929,"_33145":1902,"_22633":60321,"_5":15597,"_29869":60251,"_3292":60322},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3839":1930,"_33145":1902,"_22633":60324,"_5":15597,"_29869":60251,"_3292":60325},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3839":1931,"_33145":1902,"_22633":60327,"_5":15597,"_29869":60255,"_3292":60328},[],"The cryptographic enforcement can:",{"_3839":1932,"_33145":1902,"_22633":60330,"_5":15597,"_29869":60255,"_3292":60331},[],"allow or block RSA keys;",{"_3839":1933,"_33145":1902,"_22633":60333,"_5":15597,"_29869":60255,"_3292":60334},[],"limit the supported RSA sizes;",{"_3839":1934,"_33145":1902,"_22633":60336,"_5":15597,"_29869":60255,"_3292":60337},[],"allow or block ECDSA keys;",{"_3839":1935,"_33145":1902,"_22633":60339,"_5":15597,"_29869":60255,"_3292":60340},[],"limit the supported ECDSA sizes or curves.",{"_3839":1936,"_33145":1902,"_22633":60342,"_5":15597,"_29869":60255,"_3292":60343},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3839":1937,"_33145":1902,"_22633":60345,"_5":15597,"_29869":60259,"_3292":60346},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3839":1938,"_33145":1902,"_22633":60348,"_5":15597,"_29869":60259,"_3292":57556},[],{"_3839":1939,"_33145":1902,"_22633":60350,"_5":15597,"_29869":60259,"_3292":60351},[],"First choice",{"_3839":1940,"_33145":1902,"_22633":60353,"_5":15597,"_29869":60259,"_3292":60354},[],"Second choice",{"_3839":1941,"_33145":1902,"_22633":60356,"_5":15597,"_29869":60259,"_3292":60357},[],"If neither is supplied",{"_3839":1942,"_33145":1902,"_22633":60359,"_5":15597,"_29869":60259,"_3292":60360},[],"Direct signing with a CA",{"_3839":1943,"_33145":1902,"_22633":60362,"_5":15597,"_29869":60259,"_3292":60363},[],"`issuance_profile` embedded in the request",{"_3839":1944,"_33145":1902,"_22633":60365,"_5":15597,"_29869":60259,"_3292":60366},[],"Request `issuance_profile_id`",{"_3839":1945,"_33145":1902,"_22633":60368,"_5":15597,"_29869":60259,"_3292":60369},[],"CA default profile (`profile_id`).",{"_3839":1946,"_33145":1902,"_22633":60371,"_5":15597,"_29869":60259,"_3292":60372},[],"Issuance through a DMS",{"_3839":1947,"_33145":1902,"_22633":60374,"_5":15597,"_29869":60259,"_3292":60375},[],"`settings.issuance_profile_id`",{"_3839":1948,"_33145":1902,"_22633":60377,"_5":15597,"_29869":60259,"_3292":60378},[],"`settings.issuance_profile` embedded in the DMS",{"_3839":1949,"_33145":1902,"_22633":60380,"_5":15597,"_29869":60259,"_3292":60381},[],"Enrollment CA default profile.",{"_3839":1950,"_33145":1902,"_22633":60383,"_5":15597,"_29869":60259,"_3292":60384},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3839":1951,"_33145":1902,"_22633":60386,"_5":15597,"_29869":60259,"_3292":60387},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3839":1952,"_33145":1902,"_22633":60389,"_5":15597,"_29869":60267,"_3292":60390},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3839":1953,"_33145":1902,"_22633":60392,"_5":15597,"_29869":60271,"_3292":60393},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3839":1954,"_33145":1902,"_22633":60395,"_5":15597,"_29869":60275,"_3292":60396},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3839":1955,"_33145":1902,"_22633":60398,"_5":15597,"_29869":60279,"_3292":60399},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3839":1956,"_33145":1902,"_22633":60401,"_5":15597,"_29869":60283,"_3292":60402},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3839":1957,"_33145":1902,"_22633":60404,"_5":15597,"_29869":60283,"_3292":60405},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3839":1958,"_33145":1902,"_22633":60407,"_5":15597,"_29869":60287,"_3292":60408},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3839":1959,"_33145":1902,"_22633":60410,"_5":15597,"_29869":60287,"_3292":60411},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3839":1960,"_33145":1902,"_22633":60413,"_5":15597,"_29869":60287,"_3292":60414},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3839":1961,"_33145":1902,"_22633":60416,"_5":15597,"_29869":60287,"_3292":60417},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3839":1962,"_33145":1902,"_22633":60419,"_5":15597,"_29869":60291,"_3292":60420},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3839":1963,"_33145":1902,"_22633":60422,"_5":15597,"_29869":60291,"_3292":60423},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3839":1964,"_33145":1964,"_5":15996,"_3292":60425,"_33551":60426,"_22633":60428,"_29869":1964},"Certificate validation",[54324,55792,59794,60427],"Validation",[],{"_3839":1965,"_33145":1964,"_22633":60430,"_5":15597,"_29869":1964,"_3292":60431},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3839":1966,"_33145":1964,"_5":33548,"_22633":60433,"_29869":60434,"_3292":60435},[],"/docs/pr-preview/pr-58/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3839":1967,"_33145":1964,"_5":33548,"_22633":60437,"_29869":60438,"_3292":60439},[],"/docs/pr-preview/pr-58/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3839":1968,"_33145":1964,"_5":33548,"_22633":60441,"_29869":60442,"_3292":60443},[],"/docs/pr-preview/pr-58/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3839":1969,"_33145":1964,"_22633":60445,"_5":15597,"_29869":1964,"_3292":60446},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3839":1970,"_33145":1964,"_22633":60448,"_5":15597,"_29869":60434,"_3292":60449},[],"Verify these criteria together:",{"_3839":1971,"_33145":1964,"_22633":60451,"_5":15597,"_29869":60434,"_3292":59420},[],{"_3839":1972,"_33145":1964,"_22633":60453,"_5":15597,"_29869":60434,"_3292":60454},[],"Required result",{"_3839":1973,"_33145":1964,"_22633":60456,"_5":15597,"_29869":60434,"_3292":60457},[],"Chain and signature",{"_3839":1974,"_33145":1964,"_22633":60459,"_5":15597,"_29869":60434,"_3292":60460},[],"Valid chain to a root deliberately installed in the consumer.",{"_3839":1975,"_33145":1964,"_22633":60462,"_5":15597,"_29869":60434,"_3292":60463},[],"Dates",{"_3839":1976,"_33145":1964,"_22633":60465,"_5":15597,"_29869":60434,"_3292":60466},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3839":1977,"_33145":1964,"_22633":60468,"_5":15597,"_29869":60434,"_3292":55461},[],{"_3839":1978,"_33145":1964,"_22633":60470,"_5":15597,"_29869":60434,"_3292":60471},[],"Name, SAN or identifier matches the expected peer.",{"_3839":1979,"_33145":1964,"_22633":60473,"_5":15597,"_29869":60434,"_3292":54714},[],{"_3839":1980,"_33145":1964,"_22633":60475,"_5":15597,"_29869":60434,"_3292":60476},[],"KU, EKU and constraints permit the specific operation.",{"_3839":1981,"_33145":1964,"_22633":60478,"_5":15597,"_29869":60434,"_3292":60479},[],"Revocation",{"_3839":1982,"_33145":1964,"_22633":60481,"_5":15597,"_29869":60434,"_3292":60482},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3839":1983,"_33145":1964,"_22633":60484,"_5":15597,"_29869":60434,"_3292":60485},[],"Authorization",{"_3839":1984,"_33145":1964,"_22633":60487,"_5":15597,"_29869":60434,"_3292":60488},[],"The application permits that identity to perform the action.",{"_3839":1985,"_33145":1964,"_22633":60490,"_5":15597,"_29869":60434,"_3292":60491},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3839":1986,"_33145":1964,"_22633":60493,"_5":15597,"_29869":60438,"_3292":60494},[],"Mechanism",{"_3839":1987,"_33145":1964,"_22633":60496,"_5":15597,"_29869":60438,"_3292":60497},[],"When to use it",{"_3839":1988,"_33145":1964,"_22633":60499,"_5":15597,"_29869":60438,"_3292":60500},[],"What you must maintain",{"_3839":1989,"_33145":1964,"_22633":60502,"_5":15597,"_29869":60438,"_3292":60503},[],"OCSP",{"_3839":1990,"_33145":1964,"_22633":60505,"_5":15597,"_29869":60438,"_3292":60506},[],"Status query for a specific certificate.",{"_3839":1991,"_33145":1964,"_22633":60508,"_5":15597,"_29869":60438,"_3292":60509},[],"Responder access, signature verification and cache/freshness policy.",{"_3839":1992,"_33145":1964,"_22633":60511,"_5":15597,"_29869":60438,"_3292":60512},[],"CRL",{"_3839":1993,"_33145":1964,"_22633":60514,"_5":15597,"_29869":60438,"_3292":60515},[],"Local checks for many certificates or offline operation.",{"_3839":1994,"_33145":1964,"_22633":60517,"_5":15597,"_29869":60438,"_3292":60518},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3839":1995,"_33145":1964,"_22633":60520,"_5":15597,"_29869":60438,"_3292":60521},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3839":1996,"_33145":1964,"_22633":60523,"_5":15597,"_29869":60438,"_3292":60524},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3839":1997,"_33145":1964,"_22633":60526,"_5":15597,"_29869":60442,"_3292":60527},[],"Accept a current, authorized certificate with a known chain.",{"_3839":1998,"_33145":1964,"_22633":60529,"_5":15597,"_29869":60442,"_3292":60530},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3839":1999,"_33145":1964,"_22633":60532,"_5":15597,"_29869":60442,"_3292":60533},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3839":2000,"_33145":1964,"_22633":60535,"_5":15597,"_29869":60442,"_3292":60536},[],"Check that a new connection with that identity is rejected.",{"_3839":2001,"_33145":1964,"_22633":60538,"_5":15597,"_29869":60442,"_3292":60539},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3839":2002,"_33145":1964,"_22633":60541,"_5":15597,"_29869":60442,"_3292":60542},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3839":2003,"_33145":1964,"_22633":60544,"_5":15597,"_29869":60442,"_3292":60545},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3839":2004,"_33145":1964,"_22633":60547,"_5":15597,"_29869":60442,"_3292":60548},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3839":2005,"_33145":1964,"_22633":60550,"_5":15597,"_29869":60442,"_3292":60551},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3839":2006,"_33145":2006,"_5":15996,"_3292":60553,"_33551":60554,"_22633":60555,"_29869":2006},"Certificates",[54324,55792,59794,59795],[],{"_3839":2007,"_33145":2006,"_22633":60557,"_5":15597,"_29869":2006,"_3292":60558},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3839":2008,"_33145":2006,"_5":33548,"_22633":60560,"_29869":60561,"_3292":60562},[],"/docs/pr-preview/pr-58/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3839":2009,"_33145":2006,"_5":33548,"_22633":60564,"_29869":60565,"_3292":60566},[],"/docs/pr-preview/pr-58/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3839":2010,"_33145":2006,"_5":33548,"_22633":60568,"_29869":60569,"_3292":60570},[],"/docs/pr-preview/pr-58/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3839":2011,"_33145":2006,"_5":33548,"_22633":60572,"_29869":60573,"_3292":60574},[],"/docs/pr-preview/pr-58/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3839":2012,"_33145":2006,"_5":33548,"_22633":60576,"_29869":60577,"_3292":60578},[],"/docs/pr-preview/pr-58/platform/pki/certificates#open-the-action","Open the action",{"_3839":2013,"_33145":2006,"_5":33548,"_22633":60580,"_29869":60581,"_3292":60582},[],"/docs/pr-preview/pr-58/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3839":2014,"_33145":2006,"_5":33548,"_22633":60584,"_29869":60585,"_3292":60586},[],"/docs/pr-preview/pr-58/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3839":2015,"_33145":2006,"_5":33548,"_22633":60588,"_29869":60589,"_3292":60590},[],"/docs/pr-preview/pr-58/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3839":2016,"_33145":2006,"_5":33548,"_22633":60592,"_29869":60593,"_3292":60594},[],"/docs/pr-preview/pr-58/platform/pki/certificates#continue","Continue",{"_3839":2017,"_33145":2006,"_22633":60596,"_5":15597,"_29869":2006,"_3292":60597},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3839":2018,"_33145":2006,"_22633":60599,"_5":15597,"_29869":60561,"_3292":60600},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata. Certificate details include the key reference (`key_id`) and whether the private key is managed (`has_private_key`), and certificate lists can be filtered on `has_private_key`.",{"_3839":2019,"_33145":2006,"_22633":60602,"_5":15597,"_29869":60561,"_3292":60603},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3839":2020,"_33145":2006,"_22633":60605,"_5":15597,"_29869":60565,"_3292":60606},[],"Download the PEM and inspect it:",{"_3839":2021,"_33145":2006,"_22633":60608,"_5":15597,"_29869":60565,"_3292":60609},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3839":2022,"_33145":2006,"_22633":60611,"_5":15597,"_29869":60569,"_3292":60612},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3839":2023,"_33145":2006,"_22633":60614,"_5":15597,"_29869":60569,"_3292":60615},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3839":2024,"_33145":2006,"_22633":60617,"_5":15597,"_29869":60569,"_3292":60618},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3839":2025,"_33145":2006,"_22633":60620,"_5":15597,"_29869":60569,"_3292":60621},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3839":2026,"_33145":2006,"_22633":60623,"_5":15597,"_29869":60569,"_3292":60624},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3839":2027,"_33145":2006,"_22633":60626,"_5":15597,"_29869":60569,"_3292":60627},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3839":2028,"_33145":2006,"_22633":60629,"_5":15597,"_29869":60569,"_3292":60630},[],"For browser key generation, follow Issue your first certificate.",{"_3839":2029,"_33145":2006,"_22633":60632,"_5":15597,"_29869":60573,"_3292":60633},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3839":2030,"_33145":2006,"_22633":60635,"_5":15597,"_29869":60577,"_3292":60636},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3839":2031,"_33145":2006,"_22633":60638,"_5":15597,"_29869":60581,"_3292":60639},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3839":2032,"_33145":2006,"_22633":60641,"_5":15597,"_29869":60585,"_3292":60642},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3839":2033,"_33145":2006,"_22633":60644,"_5":15597,"_29869":60585,"_3292":60645},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3839":2034,"_33145":2006,"_22633":60647,"_5":15597,"_29869":60585,"_3292":60648},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3839":2035,"_33145":2006,"_22633":60650,"_5":15597,"_29869":60589,"_3292":60651},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3839":2036,"_33145":2006,"_22633":60653,"_5":15597,"_29869":60589,"_3292":60654},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3839":2037,"_33145":2006,"_22633":60656,"_5":15597,"_29869":60589,"_3292":60657},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3839":2038,"_33145":2006,"_22633":60659,"_5":15597,"_29869":60593,"_3292":60660},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3839":2039,"_33145":2006,"_22633":60662,"_5":15597,"_29869":60593,"_3292":60663},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3839":2040,"_33145":2040,"_5":15996,"_3292":60665,"_33551":60666,"_22633":60668,"_29869":2040},"Certificate lifecycle",[54324,55792,59794,60667],"Concepts",[],{"_3839":2041,"_33145":2040,"_22633":60670,"_5":15597,"_29869":2040,"_3292":60671},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3839":2042,"_33145":2040,"_5":33548,"_22633":60673,"_29869":60674,"_3292":60675},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3839":2043,"_33145":2040,"_5":33548,"_22633":60677,"_29869":60678,"_3292":60679},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3839":2044,"_33145":2040,"_5":33548,"_22633":60681,"_29869":60682,"_3292":60683},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3839":2045,"_33145":2040,"_5":33548,"_22633":60685,"_29869":60686,"_3292":60687},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3839":2046,"_33145":2040,"_5":33548,"_22633":60689,"_29869":60690,"_3292":60691},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3839":2047,"_33145":2040,"_5":33548,"_22633":60693,"_29869":60694,"_3292":60695},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3839":2048,"_33145":2040,"_5":33548,"_22633":60697,"_29869":60698,"_3292":60699},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3839":2049,"_33145":2040,"_5":33548,"_22633":60701,"_29869":60702,"_3292":60703},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3839":2050,"_33145":2040,"_5":33548,"_22633":60705,"_29869":60706,"_3292":60707},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3839":2051,"_33145":2040,"_5":33548,"_22633":60709,"_29869":60710,"_3292":60711},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3839":2052,"_33145":2040,"_22633":60713,"_5":15597,"_29869":2040,"_3292":60714},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3839":2053,"_33145":2040,"_22633":60716,"_5":15597,"_29869":60678,"_3292":60717},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3839":2054,"_33145":2040,"_22633":60719,"_5":15597,"_29869":60682,"_3292":60720},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3839":2055,"_33145":2040,"_22633":60722,"_5":15597,"_29869":60686,"_3292":60723},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3839":2056,"_33145":2040,"_22633":60725,"_5":15597,"_29869":60690,"_3292":60726},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3839":2057,"_33145":2040,"_22633":60728,"_5":15597,"_29869":60694,"_3292":60729},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3839":2058,"_33145":2040,"_22633":60731,"_5":15597,"_29869":60698,"_3292":60732},[],"Lamassu persists four X.509 states:",{"_3839":2059,"_33145":2040,"_22633":60734,"_5":15597,"_29869":60698,"_3292":60735},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3839":2060,"_33145":2040,"_22633":60737,"_5":15597,"_29869":60698,"_3292":60738},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3839":2061,"_33145":2040,"_22633":60740,"_5":15597,"_29869":60698,"_3292":60741},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3839":2062,"_33145":2040,"_22633":60743,"_5":15597,"_29869":60698,"_3292":60744},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3839":2063,"_33145":2040,"_22633":60746,"_5":15597,"_29869":60698,"_3292":60747},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3839":2064,"_33145":2040,"_22633":60749,"_5":15597,"_29869":60702,"_3292":60750},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3839":2065,"_33145":2040,"_22633":60752,"_5":15597,"_29869":60702,"_3292":60753},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3839":2066,"_33145":2040,"_22633":60755,"_5":15597,"_29869":60702,"_3292":60756},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3839":2067,"_33145":2040,"_22633":60758,"_5":15597,"_29869":60706,"_3292":60759},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3839":2068,"_33145":2040,"_22633":60761,"_5":15597,"_29869":60706,"_3292":60762},[],"Before confirming:",{"_3839":2069,"_33145":2040,"_22633":60764,"_5":15597,"_29869":60706,"_3292":60765},[],"Identify DMSs, devices and services that trust that chain.",{"_3839":2070,"_33145":2040,"_22633":60767,"_5":15597,"_29869":60706,"_3292":60768},[],"Distribute the new chain of trust.",{"_3839":2071,"_33145":2040,"_22633":60770,"_5":15597,"_29869":60706,"_3292":60771},[],"Reissue the necessary identities.",{"_3839":2072,"_33145":2040,"_22633":60773,"_5":15597,"_29869":60706,"_3292":60774},[],"Check OCSP and CRL from a real consumer.",{"_3839":2073,"_33145":2040,"_22633":60776,"_5":15597,"_29869":60706,"_3292":60777},[],"Revoke the old CA once no legitimate traffic remains.",{"_3839":2074,"_33145":2040,"_22633":60779,"_5":15597,"_29869":60706,"_3292":60780},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3839":2075,"_33145":2040,"_22633":60782,"_5":15597,"_29869":60710,"_3292":60783},[],"Certificates entering the preventive or critical renewal window.",{"_3839":2076,"_33145":2040,"_22633":60785,"_5":15597,"_29869":60710,"_3292":60786},[],"Repeated enrollment or re-enrollment failures.",{"_3839":2077,"_33145":2040,"_22633":60788,"_5":15597,"_29869":60710,"_3292":60789},[],"Status changes and revocation reasons.",{"_3839":2078,"_33145":2040,"_22633":60791,"_5":15597,"_29869":60710,"_3292":60792},[],"OCSP and CRL publication and validity.",{"_3839":2079,"_33145":2040,"_22633":60794,"_5":15597,"_29869":60710,"_3292":60795},[],"Dependencies still presenting a replaced certificate.",{"_3839":2080,"_33145":2040,"_22633":60797,"_5":15597,"_29869":60710,"_3292":60798},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3839":2081,"_33145":2081,"_5":15996,"_3292":60800,"_33551":60801,"_22633":60802,"_29869":2081},"Trust model",[54324,55792,59794,60667],[],{"_3839":2082,"_33145":2081,"_22633":60804,"_5":15597,"_29869":2081,"_3292":60805},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3839":2083,"_33145":2081,"_5":33548,"_22633":60807,"_29869":60808,"_3292":60809},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3839":2084,"_33145":2081,"_5":33548,"_22633":60811,"_29869":60812,"_3292":60813},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3839":2085,"_33145":2081,"_5":33548,"_22633":60815,"_29869":60816,"_3292":60817},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3839":2086,"_33145":2081,"_5":33548,"_22633":60819,"_29869":60820,"_3292":60821},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3839":2087,"_33145":2081,"_5":33548,"_22633":60823,"_29869":60824,"_3292":60825},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3839":2088,"_33145":2081,"_5":33548,"_22633":60827,"_29869":60828,"_3292":60829},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3839":2089,"_33145":2081,"_5":33548,"_22633":60831,"_29869":60832,"_3292":60833},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3839":2090,"_33145":2081,"_5":33548,"_22633":60835,"_29869":60836,"_3292":60837},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3839":2091,"_33145":2081,"_5":33548,"_22633":60839,"_29869":60840,"_3292":60841},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3839":2092,"_33145":2081,"_5":33548,"_22633":60843,"_29869":60844,"_3292":60845},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3839":2093,"_33145":2081,"_22633":60847,"_5":15597,"_29869":2081,"_3292":60848},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3839":2094,"_33145":2081,"_22633":60850,"_5":15597,"_29869":60812,"_3292":60851},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3839":2095,"_33145":2081,"_22633":60853,"_5":15597,"_29869":60816,"_3292":60854},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3839":2096,"_33145":2081,"_22633":60856,"_5":15597,"_29869":60820,"_3292":60857},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3839":2097,"_33145":2081,"_22633":60859,"_5":15597,"_29869":60824,"_3292":60860},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3839":2098,"_33145":2081,"_22633":60862,"_5":15597,"_29869":60828,"_3292":60863},[],"The device proves it can enroll according to the DMS policy.",{"_3839":2099,"_33145":2081,"_22633":60865,"_5":15597,"_29869":60828,"_3292":60866},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3839":2100,"_33145":2081,"_22633":60868,"_5":15597,"_29869":60828,"_3292":60869},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3839":2101,"_33145":2081,"_22633":60871,"_5":15597,"_29869":60828,"_3292":60872},[],"The device installs the certificate and the chain it needs.",{"_3839":2102,"_33145":2081,"_22633":60874,"_5":15597,"_29869":60828,"_3292":60875},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3839":2103,"_33145":2081,"_22633":60877,"_5":15597,"_29869":60828,"_3292":60878},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3839":2104,"_33145":2081,"_22633":60880,"_5":15597,"_29869":60832,"_3292":60881},[],"A DMS relates three sets that are worth designing separately:",{"_3839":2105,"_33145":2081,"_22633":60883,"_5":15597,"_29869":60832,"_3292":60884},[],"**Enrollment CA:** signs the new identities.",{"_3839":2106,"_33145":2081,"_22633":60886,"_5":15597,"_29869":60832,"_3292":60887},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3839":2107,"_33145":2081,"_22633":60889,"_5":15597,"_29869":60832,"_3292":60890},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3839":2108,"_33145":2081,"_22633":60892,"_5":15597,"_29869":60832,"_3292":60893},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3839":2109,"_33145":2081,"_22633":60895,"_5":15597,"_29869":60836,"_3292":60896},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3839":2110,"_33145":2081,"_22633":60898,"_5":15597,"_29869":60836,"_3292":60899},[],"that the current date is between `Not Before` and `Not After`;",{"_3839":2111,"_33145":2081,"_22633":60901,"_5":15597,"_29869":60836,"_3292":60902},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3839":2112,"_33145":2081,"_22633":60904,"_5":15597,"_29869":60836,"_3292":60905},[],"that names, SANs and subject match the expected identity;",{"_3839":2113,"_33145":2081,"_22633":60907,"_5":15597,"_29869":60836,"_3292":60908},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3839":2114,"_33145":2081,"_22633":60910,"_5":15597,"_29869":60836,"_3292":60911},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3839":2115,"_33145":2081,"_22633":60913,"_5":15597,"_29869":60836,"_3292":60914},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3839":2116,"_33145":2081,"_22633":60916,"_5":15597,"_29869":60840,"_3292":60917},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3839":2117,"_33145":2081,"_22633":60919,"_5":15597,"_29869":60844,"_3292":60920},[],"Keep the root out of daily operations, or with very restricted access.",{"_3839":2118,"_33145":2081,"_22633":60922,"_5":15597,"_29869":60844,"_3292":60923},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3839":2119,"_33145":2081,"_22633":60925,"_5":15597,"_29869":60844,"_3292":60926},[],"Assign explicit profiles to every use case.",{"_3839":2120,"_33145":2081,"_22633":60928,"_5":15597,"_29869":60844,"_3292":60929},[],"Distribute the new trust before starting a rotation.",{"_3839":2121,"_33145":2081,"_22633":60931,"_5":15597,"_29869":60844,"_3292":60932},[],"Keep enough overlap to renew a disconnected fleet.",{"_3839":2122,"_33145":2081,"_22633":60934,"_5":15597,"_29869":60844,"_3292":60935},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3839":2123,"_33145":2081,"_22633":60937,"_5":15597,"_29869":60844,"_3292":60938},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3839":2124,"_33145":2124,"_5":15996,"_3292":60940,"_33551":60941,"_22633":60942,"_29869":2124},"Revocation lists (CRL)",[54324,55792,59794,60427],[],{"_3839":2125,"_33145":2124,"_22633":60944,"_5":15597,"_29869":2124,"_3292":60945},[],"Generate and distribute signed lists to validate certificates offline.",{"_3839":2126,"_33145":2124,"_5":33548,"_22633":60947,"_29869":60948,"_3292":60949},[],"/docs/pr-preview/pr-58/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3839":2127,"_33145":2124,"_5":33548,"_22633":60951,"_29869":60952,"_3292":60953},[],"/docs/pr-preview/pr-58/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3839":2128,"_33145":2124,"_5":33548,"_22633":60955,"_29869":60956,"_3292":60957},[],"/docs/pr-preview/pr-58/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3839":2129,"_33145":2124,"_5":33548,"_22633":60959,"_29869":60960,"_3292":60961},[],"/docs/pr-preview/pr-58/platform/pki/crl#crl-contents","CRL contents",{"_3839":2130,"_33145":2124,"_5":33548,"_22633":60963,"_29869":60964,"_3292":60965},[],"/docs/pr-preview/pr-58/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3839":2131,"_33145":2124,"_5":33548,"_22633":60967,"_29869":60968,"_3292":60969},[],"/docs/pr-preview/pr-58/platform/pki/crl#va-role-management-api","VA role management API",{"_3839":2132,"_33145":2124,"_5":33548,"_22633":60971,"_29869":60972,"_3292":60973},[],"/docs/pr-preview/pr-58/platform/pki/crl#common-va-role-errors","Common VA role errors",{"_3839":2133,"_33145":2124,"_5":33548,"_22633":60975,"_29869":60976,"_3292":60977},[],"/docs/pr-preview/pr-58/platform/pki/crl#from-the-interface","From the interface",{"_3839":2134,"_33145":2124,"_5":33548,"_22633":60979,"_29869":60980,"_3292":60981},[],"/docs/pr-preview/pr-58/platform/pki/crl#references","References",{"_3839":2135,"_33145":2124,"_22633":60983,"_5":15597,"_29869":2124,"_3292":60984},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3839":2136,"_33145":2124,"_22633":60986,"_5":15597,"_29869":60948,"_3292":60987},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3839":2137,"_33145":2124,"_22633":60989,"_5":15597,"_29869":60948,"_3292":60990},[],"`crl_options` field",{"_3839":2138,"_33145":2124,"_22633":60992,"_5":15597,"_29869":60948,"_3292":54714},[],{"_3839":2139,"_33145":2124,"_22633":60994,"_5":15597,"_29869":60948,"_3292":60995},[],"Backend initial value",{"_3839":2140,"_33145":2124,"_22633":60997,"_5":15597,"_29869":60948,"_3292":60998},[],"`validity`",{"_3839":2141,"_33145":2124,"_22633":61000,"_5":15597,"_29869":60948,"_3292":61001},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3839":2142,"_33145":2124,"_22633":61003,"_5":15597,"_29869":60948,"_3292":61004},[],"7 days.",{"_3839":2143,"_33145":2124,"_22633":61006,"_5":15597,"_29869":60948,"_3292":61007},[],"`refresh_interval`",{"_3839":2144,"_33145":2124,"_22633":61009,"_5":15597,"_29869":60948,"_3292":61010},[],"Stored and returned by the API, but the VA does not use it: scheduled renewal does not depend on it (see Periodic and automatic regeneration).",{"_3839":2145,"_33145":2124,"_22633":61012,"_5":15597,"_29869":60948,"_3292":61013},[],"6 days and 23 hours.",{"_3839":2146,"_33145":2124,"_22633":61015,"_5":15597,"_29869":60948,"_3292":61016},[],"`regenerate_on_revoke`",{"_3839":2147,"_33145":2124,"_22633":61018,"_5":15597,"_29869":60948,"_3292":61019},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3839":2148,"_33145":2124,"_22633":61021,"_5":15597,"_29869":60948,"_3292":61022},[],"`true`.",{"_3839":2149,"_33145":2124,"_22633":61024,"_5":15597,"_29869":60948,"_3292":61025},[],"`signer_certificate_serial_number`",{"_3839":2150,"_33145":2124,"_22633":61027,"_5":15597,"_29869":60948,"_3292":61028},[],"Serial number of the existing certificate that signs the CRL.",{"_3839":2151,"_33145":2124,"_22633":61030,"_5":15597,"_29869":60948,"_3292":61031},[],"Serial number of the CA’s current certificate.",{"_3839":2152,"_33145":2124,"_22633":61033,"_5":15597,"_29869":60948,"_3292":61034},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3839":2153,"_33145":2124,"_22633":61036,"_5":15597,"_29869":60948,"_3292":61037},[],"When a CA is reissued, the role keeps pointing at the previous certificate. CRLs remain valid because both certificates share subject and key, but the previous certificate cannot be deleted while the role uses it. To retire it, update the role’s signer.",{"_3839":2154,"_33145":2124,"_22633":61039,"_5":15597,"_29869":60948,"_3292":61040},[],"When a CA is deleted, its VA role is kept and cannot be removed through the API. If no other CA with the same SKI remains, the role can be read but any `PUT` returns 404, and the renewal job logs a warning on every cycle because it no longer finds the CA. The API offers no way out; it can only be fixed by editing the database. If another CA with that SKI remains, the role is still editable (see CAs that share a key). Adjust validity and signer before deleting the CA.",{"_3839":2155,"_33145":2124,"_22633":61042,"_5":15597,"_29869":60948,"_3292":61043},[],"A CA whose certificate lacks `cRLSign` cannot generate its CRL or edit its role (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and set it as the signer with `PUT`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages.",{"_3839":2156,"_33145":2124,"_22633":61045,"_5":15597,"_29869":60948,"_3292":61046},[],"`PUT` always validates the signer, even when the request does not change it. If the stored signer is no longer valid, no field of the role can be modified, not even the validity, until a valid one is set.",{"_3839":2157,"_33145":2124,"_22633":61048,"_5":15597,"_29869":60948,"_3292":61049},[],"Sharing a key between CAs can prevent CRL validation. See CAs that share a key.",{"_3839":2158,"_33145":2124,"_22633":61051,"_5":15597,"_29869":60948,"_3292":61052},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3839":2159,"_33145":2124,"_22633":61054,"_5":15597,"_29869":60952,"_3292":61055},[],"The VA identifies each CRL by the CA’s SKI, and the SKI is derived from its key. Two CAs with the same key have the same SKI and share a single VA role and a single CRL. This happens when a CA is created on an existing KMS key, or when a CA is imported whose certificate declares an SKI already in use. Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. The first CA creates the role and the others keep it.",{"_3839":2160,"_33145":2124,"_22633":61057,"_5":15597,"_29869":60952,"_3292":61058},[],"The certificates of all of them point to `/crl/{ski}`, but the published list has the first CA as issuer and only includes its revocations. A verifier compares the CRL issuer with the issuer of the certificate it validates (RFC 5280, §6.3.2) and rejects the list if they differ. Depending on its policy, the certificate is blocked (*hard-fail*) or accepted even though it is revoked (*soft-fail*). Revocations of the secondary CAs do not appear in any list.",{"_3839":2161,"_33145":2124,"_22633":61060,"_5":15597,"_29869":60952,"_3292":61061},[],"If the first CA is deleted, CRL generation for the remaining one fails because the configured signer no longer matches a CA with that name. Until the role’s signer is updated to a certificate of the remaining CA, the last published list keeps being served until it expires (7 days by default).",{"_3839":2162,"_33145":2124,"_22633":61063,"_5":15597,"_29869":60952,"_3292":61064},[],"Before upgrading, review CAs that share a key. To detect the problem, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued. A CA imported with an SKI already in use does not replace the existing one as CRL issuer, because the issuer is resolved from the role’s signer. However, its own certificates point to that same URL and its revocations are not published. Until Lamassu rejects these imports, restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same collision, so also avoid reusing keys across CAs. A per-CA CRL and the rejection of imports whose SKI collides with an existing CA are both proposed in lamassuiot#834, and neither is implemented yet.",{"_3839":2163,"_33145":2124,"_22633":61066,"_5":15597,"_29869":60956,"_3292":61067},[],"The VA scheduled job checks every role on each run and requests another list when the remaining validity of `latest_crl` is less than the interval between runs. The frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. `refresh_interval` plays no part. Keep `validity` well above the interval: with a shorter validity, the list is regenerated on every cycle.",{"_3839":2164,"_33145":2124,"_22633":61069,"_5":15597,"_29869":60956,"_3292":61070},[],"If generation fails (for example, because of a role without a CA or an invalid signer), the job logs the warning `something went wrong while calculating CRL for CA <ski>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3839":2165,"_33145":2124,"_22633":61072,"_5":15597,"_29869":60956,"_3292":61073},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if it fails (missing role, invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3839":2166,"_33145":2124,"_22633":61075,"_5":15597,"_29869":60956,"_3292":61076},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3839":2167,"_33145":2124,"_22633":61078,"_5":15597,"_29869":60960,"_3292":61079},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3839":2168,"_33145":2124,"_22633":61081,"_5":15597,"_29869":60960,"_3292":61082},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3839":2169,"_33145":2124,"_22633":61084,"_5":15597,"_29869":60964,"_3292":61085},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3839":2170,"_33145":2124,"_22633":61087,"_5":15597,"_29869":60964,"_3292":61088},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3839":2171,"_33145":2124,"_22633":61090,"_5":15597,"_29869":60964,"_3292":61091},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3839":2172,"_33145":2124,"_22633":61093,"_5":15597,"_29869":60964,"_3292":61094},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3839":2173,"_33145":2124,"_22633":61096,"_5":15597,"_29869":60964,"_3292":61097},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3839":2174,"_33145":2124,"_22633":61099,"_5":15597,"_29869":60968,"_3292":61100},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3839":2175,"_33145":2124,"_22633":61102,"_5":15597,"_29869":60968,"_3292":57559},[],{"_3839":2176,"_33145":2124,"_22633":61104,"_5":15597,"_29869":60968,"_3292":61105},[],"Relative path",{"_3839":2177,"_33145":2124,"_22633":61107,"_5":15597,"_29869":60968,"_3292":57556},[],{"_3839":2178,"_33145":2124,"_22633":61109,"_5":15597,"_29869":60968,"_3292":61110},[],"`GET`",{"_3839":2179,"_33145":2124,"_22633":61112,"_5":15597,"_29869":60968,"_3292":61113},[],"`/v1/roles/{ca-ski}`",{"_3839":2180,"_33145":2124,"_22633":61115,"_5":15597,"_29869":60968,"_3292":61116},[],"Read `crl_options` and `latest_crl`.",{"_3839":2181,"_33145":2124,"_22633":61118,"_5":15597,"_29869":60968,"_3292":61119},[],"`PUT`",{"_3839":2182,"_33145":2124,"_22633":61121,"_5":15597,"_29869":60968,"_3292":61113},[],{"_3839":2183,"_33145":2124,"_22633":61123,"_5":15597,"_29869":60968,"_3292":61124},[],"Replace CRL configuration.",{"_3839":2184,"_33145":2124,"_22633":61126,"_5":15597,"_29869":60968,"_3292":61127},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3839":2185,"_33145":2124,"_22633":61129,"_5":15597,"_29869":60968,"_3292":61130},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3839":2186,"_33145":2124,"_22633":61132,"_5":15597,"_29869":60972,"_3292":61133},[],"Symptom",{"_3839":2187,"_33145":2124,"_22633":61135,"_5":15597,"_29869":60972,"_3292":61136},[],"Cause",{"_3839":2188,"_33145":2124,"_22633":61138,"_5":15597,"_29869":60972,"_3292":61139},[],"Action",{"_3839":2189,"_33145":2124,"_22633":61141,"_5":15597,"_29869":60972,"_3292":61142},[],"`PUT /v1/roles/{ca-ski}` returns 404 and `GET` returns 200.",{"_3839":2190,"_33145":2124,"_22633":61144,"_5":15597,"_29869":60972,"_3292":61145},[],"The role’s CA was deleted and no other CA with the same SKI remains.",{"_3839":2191,"_33145":2124,"_22633":61147,"_5":15597,"_29869":60972,"_3292":61148},[],"There is no API way out; it requires database intervention. Avoid it by adjusting the role before deleting the CA.",{"_3839":2192,"_33145":2124,"_22633":61150,"_5":15597,"_29869":60972,"_3292":61151},[],"`PUT` returns 400.",{"_3839":2193,"_33145":2124,"_22633":61153,"_5":15597,"_29869":60972,"_3292":61154},[],"The signer lacks `cRLSign`, or its subject and key match no CA with that SKI (for example, after deleting the first of two CAs that share a key).",{"_3839":2194,"_33145":2124,"_22633":61156,"_5":15597,"_29869":60972,"_3292":61157},[],"Use `PUT` to set the serial number of a valid certificate of the remaining CA.",{"_3839":2195,"_33145":2124,"_22633":61159,"_5":15597,"_29869":60972,"_3292":61160},[],"`PUT` returns 400 from a 3.x client.",{"_3839":2196,"_33145":2124,"_22633":61162,"_5":15597,"_29869":60972,"_3292":61163},[],"`crl_options.subject_key_id_signer` was replaced by `signer_certificate_serial_number`, which is required.",{"_3839":2197,"_33145":2124,"_22633":61165,"_5":15597,"_29869":60972,"_3292":61166},[],"Update the client to send the new field.",{"_3839":2198,"_33145":2124,"_22633":61168,"_5":15597,"_29869":60972,"_3292":61169},[],"The CRL does not change after revoking a certificate.",{"_3839":2199,"_33145":2124,"_22633":61171,"_5":15597,"_29869":60972,"_3292":61172},[],"`regenerate_on_revoke` is `false`, or the event failed because of a missing role or an invalid signer.",{"_3839":2200,"_33145":2124,"_22633":61174,"_5":15597,"_29869":60972,"_3292":61175},[],"Check the VA logs and the failed-events queue; fix the signer.",{"_3839":2201,"_33145":2124,"_22633":61177,"_5":15597,"_29869":60972,"_3292":61178},[],"A verifier rejects the CRL because of the issuer.",{"_3839":2202,"_33145":2124,"_22633":61180,"_5":15597,"_29869":60972,"_3292":61181},[],"Several CAs share an SKI.",{"_3839":2203,"_33145":2124,"_22633":61183,"_5":15597,"_29869":60972,"_3292":61184},[],"See CAs that share a key.",{"_3839":2204,"_33145":2124,"_22633":61186,"_5":15597,"_29869":60976,"_3292":61187},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_3839":2205,"_33145":2124,"_22633":61189,"_5":15597,"_29869":60980,"_3292":61190},[],"RFC 5280: X.509 and CRL profile.",{"_3839":2206,"_33145":2124,"_22633":61192,"_5":15597,"_29869":60980,"_3292":61193},[],"OpenSSL: openssl-crl.",{"_3839":2207,"_33145":2124,"_22633":61195,"_5":15597,"_29869":60980,"_3292":61196},[],"OpenSSL: openssl-verify.",{"_3839":2208,"_33145":2124,"_22633":61198,"_5":15597,"_29869":60980,"_3292":61199},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3839":2209,"_33145":2124,"_22633":61201,"_5":15597,"_29869":60980,"_3292":61202},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3839":2210,"_33145":2210,"_5":15996,"_3292":61204,"_33551":61205,"_22633":61206,"_29869":2210},"Keys and cryptographic engines",[54324,55792,59794,59795],[],{"_3839":2211,"_33145":2210,"_22633":61208,"_5":15597,"_29869":2210,"_3292":61209},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3839":2212,"_33145":2210,"_5":33548,"_22633":61211,"_29869":61212,"_3292":61213},[],"/docs/pr-preview/pr-58/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3839":2213,"_33145":2210,"_5":33548,"_22633":61215,"_29869":61216,"_3292":61217},[],"/docs/pr-preview/pr-58/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3839":2214,"_33145":2210,"_5":33548,"_22633":61219,"_29869":61220,"_3292":61221},[],"/docs/pr-preview/pr-58/platform/pki/key-management#file-system","File System",{"_3839":2215,"_33145":2210,"_5":33548,"_22633":61223,"_29869":61224,"_3292":61225},[],"/docs/pr-preview/pr-58/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3839":2216,"_33145":2210,"_5":33548,"_22633":61227,"_29869":61228,"_3292":61229},[],"/docs/pr-preview/pr-58/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3839":2217,"_33145":2210,"_5":33548,"_22633":61231,"_29869":61232,"_3292":61233},[],"/docs/pr-preview/pr-58/platform/pki/key-management#aws-kms","AWS KMS",{"_3839":2218,"_33145":2210,"_5":33548,"_22633":61235,"_29869":61236,"_3292":61237},[],"/docs/pr-preview/pr-58/platform/pki/key-management#pkcs11","PKCS#11",{"_3839":2219,"_33145":2210,"_5":33548,"_22633":61239,"_29869":61240,"_3292":61241},[],"/docs/pr-preview/pr-58/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3839":2220,"_33145":2210,"_5":33548,"_22633":61243,"_29869":61244,"_3292":61245},[],"/docs/pr-preview/pr-58/platform/pki/key-management#key-inventory","Key inventory",{"_3839":2221,"_33145":2210,"_5":33548,"_22633":61247,"_29869":61248,"_3292":61249},[],"/docs/pr-preview/pr-58/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3839":2222,"_33145":2210,"_5":33548,"_22633":61251,"_29869":61252,"_3292":61253},[],"/docs/pr-preview/pr-58/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3839":2223,"_33145":2210,"_5":33548,"_22633":61255,"_29869":61256,"_3292":61257},[],"/docs/pr-preview/pr-58/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3839":2224,"_33145":2210,"_5":33548,"_22633":61259,"_29869":61260,"_3292":61261},[],"/docs/pr-preview/pr-58/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3839":2225,"_33145":2210,"_5":33548,"_22633":61263,"_29869":61264,"_3292":61265},[],"/docs/pr-preview/pr-58/platform/pki/key-management#view-details","View details",{"_3839":2226,"_33145":2210,"_5":33548,"_22633":61267,"_29869":61268,"_3292":61269},[],"/docs/pr-preview/pr-58/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3839":2227,"_33145":2210,"_5":33548,"_22633":61271,"_29869":61272,"_3292":61273},[],"/docs/pr-preview/pr-58/platform/pki/key-management#sign","Sign",{"_3839":2228,"_33145":2210,"_5":33548,"_22633":61275,"_29869":61276,"_3292":61277},[],"/docs/pr-preview/pr-58/platform/pki/key-management#verify","Verify",{"_3839":2229,"_33145":2210,"_5":33548,"_22633":61279,"_29869":61280,"_3292":61281},[],"/docs/pr-preview/pr-58/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3839":2230,"_33145":2210,"_5":33548,"_22633":61283,"_29869":61284,"_3292":61285},[],"/docs/pr-preview/pr-58/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3839":2231,"_33145":2210,"_5":33548,"_22633":61287,"_29869":61288,"_3292":61289},[],"/docs/pr-preview/pr-58/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3839":2232,"_33145":2210,"_22633":61291,"_5":15597,"_29869":2210,"_3292":61292},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3839":2233,"_33145":2210,"_22633":61294,"_5":15597,"_29869":2210,"_3292":61295},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3839":2234,"_33145":2210,"_22633":61297,"_5":15597,"_29869":61212,"_3292":61298},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3839":2235,"_33145":2210,"_22633":61300,"_5":15597,"_29869":61212,"_3292":61301},[],"In practice, it lets you:",{"_3839":2236,"_33145":2210,"_22633":61303,"_5":15597,"_29869":61212,"_3292":61304},[],"Generate new key pairs from Lamassu IoT.",{"_3839":2237,"_33145":2210,"_22633":61306,"_5":15597,"_29869":61212,"_3292":61307},[],"Import keys created externally.",{"_3839":2238,"_33145":2210,"_22633":61309,"_5":15597,"_29869":61212,"_3292":61310},[],"Delegate custody and cryptographic operations to external engines.",{"_3839":2239,"_33145":2210,"_22633":61312,"_5":15597,"_29869":61212,"_3292":61313},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3839":2240,"_33145":2210,"_22633":61315,"_5":15597,"_29869":61216,"_3292":61316},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3839":2241,"_33145":2210,"_22633":61318,"_5":15597,"_29869":61216,"_3292":61319},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3839":2242,"_33145":2210,"_22633":61321,"_5":15597,"_29869":61216,"_3292":61322},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3839":2243,"_33145":2210,"_22633":61324,"_5":15597,"_29869":61220,"_3292":61325},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3839":2244,"_33145":2210,"_22633":61327,"_5":15597,"_29869":61224,"_3292":61328},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3839":2245,"_33145":2210,"_22633":61330,"_5":15597,"_29869":61224,"_3292":61331},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3839":2246,"_33145":2210,"_22633":61333,"_5":15597,"_29869":61228,"_3292":61334},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3839":2247,"_33145":2210,"_22633":61336,"_5":15597,"_29869":61232,"_3292":61337},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3839":2248,"_33145":2210,"_22633":61339,"_5":15597,"_29869":61236,"_3292":61340},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3839":2249,"_33145":2210,"_22633":61342,"_5":15597,"_29869":61240,"_3292":61343},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3839":2250,"_33145":2210,"_22633":61345,"_5":15597,"_29869":61240,"_3292":61346},[],"Lamassu shows the enabled engines in the console.",{"_3839":2251,"_33145":2210,"_22633":61348,"_5":15597,"_29869":61240,"_3292":61349},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3839":2252,"_33145":2210,"_22633":61351,"_5":15597,"_29869":61240,"_3292":61352},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3839":2253,"_33145":2210,"_22633":61354,"_5":15597,"_29869":61244,"_3292":61355},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3839":2254,"_33145":2210,"_22633":61357,"_5":15597,"_29869":61244,"_3292":61358},[],"The table includes the following fields:",{"_3839":2255,"_33145":2210,"_22633":61360,"_5":15597,"_29869":61244,"_3292":61361},[],"**Name**: descriptive name of the key.",{"_3839":2256,"_33145":2210,"_22633":61363,"_5":15597,"_29869":61244,"_3292":61364},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3839":2257,"_33145":2210,"_22633":61366,"_5":15597,"_29869":61244,"_3292":61367},[],"**Strength**: visual indicator of cryptographic strength.",{"_3839":2258,"_33145":2210,"_22633":61369,"_5":15597,"_29869":61244,"_3292":61370},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3839":2259,"_33145":2210,"_22633":61372,"_5":15597,"_29869":61244,"_3292":61373},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3839":2260,"_33145":2210,"_22633":61375,"_5":15597,"_29869":61244,"_3292":61376},[],"**Aliases**: alternative names associated with the key.",{"_3839":2261,"_33145":2210,"_22633":61378,"_5":15597,"_29869":61244,"_3292":61379},[],"**Tags**: labels for classification and search.",{"_3839":2262,"_33145":2210,"_22633":61381,"_5":15597,"_29869":61244,"_3292":61382},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3839":2263,"_33145":2210,"_22633":61384,"_5":15597,"_29869":61244,"_3292":61385},[],"From this view you also reach the most common actions:",{"_3839":2264,"_33145":2210,"_22633":61387,"_5":15597,"_29869":61244,"_3292":61388},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3839":2265,"_33145":2210,"_22633":61390,"_5":15597,"_29869":61244,"_3292":61391},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3839":2266,"_33145":2210,"_22633":61393,"_5":15597,"_29869":61244,"_3292":61394},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3839":2267,"_33145":2210,"_22633":61396,"_5":15597,"_29869":61244,"_3292":61397},[],"**Delete Key** to remove the key from the system.",{"_3839":2268,"_33145":2210,"_22633":61399,"_5":15597,"_29869":61248,"_3292":61400},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3839":2269,"_33145":2210,"_22633":61402,"_5":15597,"_29869":61252,"_3292":61403},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3839":2270,"_33145":2210,"_22633":61405,"_5":15597,"_29869":61252,"_3292":61406},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3839":2271,"_33145":2210,"_22633":61408,"_5":15597,"_29869":61252,"_3292":61409},[],"**Key Name**: unique and descriptive name.",{"_3839":2272,"_33145":2210,"_22633":61411,"_5":15597,"_29869":61252,"_3292":61412},[],"**Crypto Engine**: engine that will keep the key.",{"_3839":2273,"_33145":2210,"_22633":61414,"_5":15597,"_29869":61252,"_3292":61415},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3839":2274,"_33145":2210,"_22633":61417,"_5":15597,"_29869":61252,"_3292":61418},[],"**Tags**: metadata to classify the key.",{"_3839":2275,"_33145":2210,"_22633":61420,"_5":15597,"_29869":61252,"_3292":61421},[],"**Metadata**: additional information for advanced uses.",{"_3839":2276,"_33145":2210,"_22633":61423,"_5":15597,"_29869":61256,"_3292":61424},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3839":2277,"_33145":2210,"_22633":61426,"_5":15597,"_29869":61256,"_3292":61427},[],"When you have an exportable private key and the destination engine supports import.",{"_3839":2278,"_33145":2210,"_22633":61429,"_5":15597,"_29869":61256,"_3292":61430},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3839":2279,"_33145":2210,"_22633":61432,"_5":15597,"_29869":61256,"_3292":61433},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3839":2280,"_33145":2210,"_22633":61435,"_5":15597,"_29869":61256,"_3292":61436},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3839":2281,"_33145":2210,"_22633":61438,"_5":15597,"_29869":61256,"_3292":61439},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3839":2282,"_33145":2210,"_22633":61441,"_5":15597,"_29869":61256,"_3292":61442},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3839":2283,"_33145":2210,"_22633":61444,"_5":15597,"_29869":61256,"_3292":61445},[],"**Tags**: labels for organization and search.",{"_3839":2284,"_33145":2210,"_22633":61447,"_5":15597,"_29869":61256,"_3292":61448},[],"**Metadata**: additional optional information.",{"_3839":2285,"_33145":2210,"_22633":61450,"_5":15597,"_29869":61256,"_3292":61451},[],"**Private Key (PEM)**: private key in PEM format.",{"_3839":2286,"_33145":2210,"_22633":61453,"_5":15597,"_29869":61256,"_3292":61454},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3839":2287,"_33145":2210,"_22633":61456,"_5":15597,"_29869":61260,"_3292":61457},[],"Each registered key has a detail view and several operational actions.",{"_3839":2288,"_33145":2210,"_22633":61459,"_5":15597,"_29869":61264,"_3292":61460},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3839":2289,"_33145":2210,"_22633":61462,"_5":15597,"_29869":61264,"_3292":61463},[],"The **Overview** tab shows, among others, these fields:",{"_3839":2290,"_33145":2210,"_22633":61465,"_5":15597,"_29869":61264,"_3292":61466},[],"**Key Name**: descriptive name.",{"_3839":2291,"_33145":2210,"_22633":61468,"_5":15597,"_29869":61264,"_3292":61469},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3839":2292,"_33145":2210,"_22633":61471,"_5":15597,"_29869":61264,"_3292":61472},[],"**Tags**: associated labels.",{"_3839":2293,"_33145":2210,"_22633":61474,"_5":15597,"_29869":61264,"_3292":61475},[],"**Aliases**: alternative names.",{"_3839":2294,"_33145":2210,"_22633":61477,"_5":15597,"_29869":61264,"_3292":61478},[],"**Crypto Engine**: engine where the key resides.",{"_3839":2295,"_33145":2210,"_22633":61480,"_5":15597,"_29869":61264,"_3292":61481},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3839":2296,"_33145":2210,"_22633":61483,"_5":15597,"_29869":61264,"_3292":61484},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3839":2297,"_33145":2210,"_22633":61486,"_5":15597,"_29869":61264,"_3292":61487},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3839":2298,"_33145":2210,"_22633":61489,"_5":15597,"_29869":61268,"_3292":61490},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3839":2299,"_33145":2210,"_22633":61492,"_5":15597,"_29869":61268,"_3292":61493},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3839":2300,"_33145":2210,"_22633":61495,"_5":15597,"_29869":61268,"_3292":61496},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3839":2301,"_33145":2210,"_22633":61498,"_5":15597,"_29869":61272,"_3292":61499},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3839":2302,"_33145":2210,"_22633":61501,"_5":15597,"_29869":61272,"_3292":61502},[],"Main fields:",{"_3839":2303,"_33145":2210,"_22633":61504,"_5":15597,"_29869":61272,"_3292":61505},[],"**Algorithm**: signing algorithm available for the key type.",{"_3839":2304,"_33145":2210,"_22633":61507,"_5":15597,"_29869":61272,"_3292":61508},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3839":2305,"_33145":2210,"_22633":61510,"_5":15597,"_29869":61272,"_3292":61511},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3839":2306,"_33145":2210,"_22633":61513,"_5":15597,"_29869":61272,"_3292":61514},[],"**Message**: content to sign.",{"_3839":2307,"_33145":2210,"_22633":61516,"_5":15597,"_29869":61272,"_3292":61517},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3839":2308,"_33145":2210,"_22633":61519,"_5":15597,"_29869":61276,"_3292":61520},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3839":2309,"_33145":2210,"_22633":61522,"_5":15597,"_29869":61276,"_3292":61502},[],{"_3839":2310,"_33145":2210,"_22633":61524,"_5":15597,"_29869":61276,"_3292":61525},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3839":2311,"_33145":2210,"_22633":61527,"_5":15597,"_29869":61276,"_3292":61528},[],"**Message Type**: `Raw` or `Digest`.",{"_3839":2312,"_33145":2210,"_22633":61530,"_5":15597,"_29869":61276,"_3292":61531},[],"**Payload Encoding**: encoding of the message.",{"_3839":2313,"_33145":2210,"_22633":61533,"_5":15597,"_29869":61276,"_3292":61534},[],"**Message**: original message or hash.",{"_3839":2314,"_33145":2210,"_22633":61536,"_5":15597,"_29869":61276,"_3292":61537},[],"**Signature**: signature to check.",{"_3839":2315,"_33145":2210,"_22633":61539,"_5":15597,"_29869":61276,"_3292":61540},[],"**Result**: indicator of the validation result.",{"_3839":2316,"_33145":2210,"_22633":61542,"_5":15597,"_29869":61280,"_3292":61543},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3839":2317,"_33145":2210,"_22633":61545,"_5":15597,"_29869":61280,"_3292":61546},[],"This flow is useful for:",{"_3839":2318,"_33145":2210,"_22633":61548,"_5":15597,"_29869":61280,"_3292":61549},[],"Requesting certificates from an external CA.",{"_3839":2319,"_33145":2210,"_22633":61551,"_5":15597,"_29869":61280,"_3292":61552},[],"Renewing an identity while keeping the same key.",{"_3839":2320,"_33145":2210,"_22633":61554,"_5":15597,"_29869":61280,"_3292":61555},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3839":2321,"_33145":2210,"_22633":61557,"_5":15597,"_29869":61280,"_3292":61558},[],"**Common Name (CN)**: main name of the identity.",{"_3839":2322,"_33145":2210,"_22633":61560,"_5":15597,"_29869":61280,"_3292":61561},[],"**Organization (O)**: organization or company.",{"_3839":2323,"_33145":2210,"_22633":61563,"_5":15597,"_29869":61280,"_3292":61564},[],"**Organizational Unit (OU)**: department or unit.",{"_3839":2324,"_33145":2210,"_22633":61566,"_5":15597,"_29869":61280,"_3292":61567},[],"**Country (C)**: two-letter country code.",{"_3839":2325,"_33145":2210,"_22633":61569,"_5":15597,"_29869":61280,"_3292":61570},[],"**State / Province (ST)**: state or province.",{"_3839":2326,"_33145":2210,"_22633":61572,"_5":15597,"_29869":61280,"_3292":61573},[],"**Locality (L)**: city or locality.",{"_3839":2327,"_33145":2210,"_22633":61575,"_5":15597,"_29869":61280,"_3292":61576},[],"**Email Address**: contact email.",{"_3839":2328,"_33145":2210,"_22633":61578,"_5":15597,"_29869":61280,"_3292":61579},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3839":2329,"_33145":2210,"_22633":61581,"_5":15597,"_29869":61280,"_3292":61582},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3839":2330,"_33145":2210,"_22633":61584,"_5":15597,"_29869":61284,"_3292":61585},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3839":2331,"_33145":2210,"_22633":61587,"_5":15597,"_29869":61284,"_3292":61588},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3839":2332,"_33145":2210,"_22633":61590,"_5":15597,"_29869":61288,"_3292":61591},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3839":2333,"_33145":2210,"_22633":61593,"_5":15597,"_29869":61288,"_3292":61594},[],"The KMS refuses to delete a key that certificates still reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. Revoking certificates issued by the deleted CA does not release their own key references. Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3839":2334,"_33145":2334,"_5":15996,"_3292":61596,"_33551":61597,"_22633":61598,"_29869":2334},"Online validation with OCSP",[54324,55792,59794,60427],[],{"_3839":2335,"_33145":2334,"_22633":61600,"_5":15597,"_29869":2334,"_3292":61601},[],"Query signed status and verify the responder’s response.",{"_3839":2336,"_33145":2334,"_5":33548,"_22633":61603,"_29869":61604,"_3292":61605},[],"/docs/pr-preview/pr-58/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3839":2337,"_33145":2334,"_5":33548,"_22633":61607,"_29869":61608,"_3292":61609},[],"/docs/pr-preview/pr-58/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3839":2338,"_33145":2334,"_5":33548,"_22633":61611,"_29869":61612,"_3292":61613},[],"/docs/pr-preview/pr-58/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3839":2339,"_33145":2334,"_5":33548,"_22633":61615,"_29869":61616,"_3292":61617},[],"/docs/pr-preview/pr-58/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3839":2340,"_33145":2334,"_5":33548,"_22633":61619,"_29869":61620,"_3292":61621},[],"/docs/pr-preview/pr-58/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3839":2341,"_33145":2334,"_5":33548,"_22633":61623,"_29869":61624,"_3292":60981},[],"/docs/pr-preview/pr-58/platform/pki/ocsp#references",{"_3839":2342,"_33145":2334,"_22633":61626,"_5":15597,"_29869":2334,"_3292":61627},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3839":2343,"_33145":2334,"_22633":61629,"_5":15597,"_29869":61604,"_3292":61630},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3839":2344,"_33145":2334,"_22633":61632,"_5":15597,"_29869":61604,"_3292":61633},[],"Record status",{"_3839":2345,"_33145":2334,"_22633":61635,"_5":15597,"_29869":61604,"_3292":61636},[],"Signed response",{"_3839":2346,"_33145":2334,"_22633":61638,"_5":15597,"_29869":61604,"_3292":58931},[],{"_3839":2347,"_33145":2334,"_22633":61640,"_5":15597,"_29869":61604,"_3292":61641},[],"`Good`.",{"_3839":2348,"_33145":2334,"_22633":61643,"_5":15597,"_29869":61604,"_3292":58948},[],{"_3839":2349,"_33145":2334,"_22633":61645,"_5":15597,"_29869":61604,"_3292":61646},[],"`Revoked`, with revocation reason and timestamp.",{"_3839":2350,"_33145":2334,"_22633":61648,"_5":15597,"_29869":61604,"_3292":61649},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3839":2351,"_33145":2334,"_22633":61651,"_5":15597,"_29869":61604,"_3292":61652},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3839":2352,"_33145":2334,"_22633":61654,"_5":15597,"_29869":61604,"_3292":61655},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3839":2353,"_33145":2334,"_22633":61657,"_5":15597,"_29869":61604,"_3292":61658},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3839":2354,"_33145":2334,"_22633":61660,"_5":15597,"_29869":61604,"_3292":61661},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3839":2355,"_33145":2334,"_22633":61663,"_5":15597,"_29869":61608,"_3292":61664},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3839":2356,"_33145":2334,"_22633":61666,"_5":15597,"_29869":61608,"_3292":61667},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3839":2357,"_33145":2334,"_22633":61669,"_5":15597,"_29869":61612,"_3292":61670},[],"The service accepts:",{"_3839":2358,"_33145":2334,"_22633":61672,"_5":15597,"_29869":61612,"_3292":57559},[],{"_3839":2359,"_33145":2334,"_22633":61674,"_5":15597,"_29869":61612,"_3292":61675},[],"VA service path",{"_3839":2360,"_33145":2334,"_22633":61677,"_5":15597,"_29869":61612,"_3292":61678},[],"Format",{"_3839":2361,"_33145":2334,"_22633":61680,"_5":15597,"_29869":61612,"_3292":61681},[],"`POST`",{"_3839":2362,"_33145":2334,"_22633":61683,"_5":15597,"_29869":61612,"_3292":61684},[],"`/ocsp`",{"_3839":2363,"_33145":2334,"_22633":61686,"_5":15597,"_29869":61612,"_3292":61687},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3839":2364,"_33145":2334,"_22633":61689,"_5":15597,"_29869":61612,"_3292":61110},[],{"_3839":2365,"_33145":2334,"_22633":61691,"_5":15597,"_29869":61612,"_3292":61692},[],"`/ocsp/{ocsp_request}`",{"_3839":2366,"_33145":2334,"_22633":61694,"_5":15597,"_29869":61612,"_3292":61695},[],"DER request encoded using padded URL Base64.",{"_3839":2367,"_33145":2334,"_22633":61697,"_5":15597,"_29869":61612,"_3292":61698},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3839":2368,"_33145":2334,"_22633":61700,"_5":15597,"_29869":61616,"_3292":61701},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3839":2369,"_33145":2334,"_22633":61703,"_5":15597,"_29869":61616,"_3292":61704},[],"Generate the request:",{"_3839":2370,"_33145":2334,"_22633":61706,"_5":15597,"_29869":61616,"_3292":61707},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3839":2371,"_33145":2334,"_22633":61709,"_5":15597,"_29869":61616,"_3292":61710},[],"Replace the example URL with the inspected endpoint:",{"_3839":2372,"_33145":2334,"_22633":61712,"_5":15597,"_29869":61616,"_3292":61713},[],"Verify the returned DER:",{"_3839":2373,"_33145":2334,"_22633":61715,"_5":15597,"_29869":61616,"_3292":61716},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3839":2374,"_33145":2334,"_22633":61718,"_5":15597,"_29869":61620,"_3292":61719},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3839":2375,"_33145":2334,"_22633":61721,"_5":15597,"_29869":61620,"_3292":61722},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3839":2376,"_33145":2334,"_22633":61724,"_5":15597,"_29869":61624,"_3292":61725},[],"RFC 6960: OCSP.",{"_3839":2377,"_33145":2334,"_22633":61727,"_5":15597,"_29869":61624,"_3292":61728},[],"OpenSSL: openssl-ocsp.",{"_3839":2378,"_33145":2334,"_22633":61730,"_5":15597,"_29869":61624,"_3292":61731},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3839":2379,"_33145":2334,"_22633":61733,"_5":15597,"_29869":61624,"_3292":61202},[],{"_3839":2380,"_33145":2380,"_5":15996,"_3292":59794,"_33551":61735,"_22633":61736,"_29869":2380},[54324,55792,59794],[],{"_3839":2381,"_33145":2380,"_22633":61738,"_5":15597,"_29869":2380,"_3292":61739},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3839":2382,"_33145":2380,"_5":33548,"_22633":61741,"_29869":61742,"_3292":59106},[],"/docs/pr-preview/pr-58/platform/pki/overview#start-here",{"_3839":2383,"_33145":2380,"_5":33548,"_22633":61744,"_29869":61745,"_3292":61746},[],"/docs/pr-preview/pr-58/platform/pki/overview#what-you-need","What you need",{"_3839":2384,"_33145":2380,"_5":33548,"_22633":61748,"_29869":61749,"_3292":59638},[],"/docs/pr-preview/pr-58/platform/pki/overview#core-capabilities",{"_3839":2385,"_33145":2380,"_5":33548,"_22633":61751,"_29869":61752,"_3292":59642},[],"/docs/pr-preview/pr-58/platform/pki/overview#build-your-trust-hierarchy",{"_3839":2386,"_33145":2380,"_5":33548,"_22633":61754,"_29869":61755,"_3292":59646},[],"/docs/pr-preview/pr-58/platform/pki/overview#protect-cryptographic-keys",{"_3839":2387,"_33145":2380,"_5":33548,"_22633":61757,"_29869":61758,"_3292":59650},[],"/docs/pr-preview/pr-58/platform/pki/overview#issue-and-control-certificates",{"_3839":2388,"_33145":2380,"_5":33548,"_22633":61760,"_29869":61761,"_3292":59658},[],"/docs/pr-preview/pr-58/platform/pki/overview#publish-validation-status",{"_3839":2389,"_33145":2380,"_5":33548,"_22633":61763,"_29869":61764,"_3292":61765},[],"/docs/pr-preview/pr-58/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3839":2390,"_33145":2380,"_5":33548,"_22633":61767,"_29869":61768,"_3292":60594},[],"/docs/pr-preview/pr-58/platform/pki/overview#continue",{"_3839":2391,"_33145":2380,"_22633":61770,"_5":15597,"_29869":2380,"_3292":61771},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3839":2392,"_33145":2380,"_22633":61773,"_5":15597,"_29869":61742,"_3292":61774},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3839":2393,"_33145":2380,"_22633":61776,"_5":15597,"_29869":61742,"_3292":61777},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3839":2394,"_33145":2380,"_22633":61779,"_5":15597,"_29869":61745,"_3292":61780},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3839":2395,"_33145":2380,"_22633":61782,"_5":15597,"_29869":61745,"_3292":61783},[],"An available cryptographic engine to keep the authority's key.",{"_3839":2396,"_33145":2380,"_22633":61785,"_5":15597,"_29869":61745,"_3292":61786},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3839":2397,"_33145":2380,"_22633":61788,"_5":15597,"_29869":61745,"_3292":61789},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3839":2398,"_33145":2380,"_22633":61791,"_5":15597,"_29869":61745,"_3292":61792},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3839":2399,"_33145":2380,"_22633":61794,"_5":15597,"_29869":61752,"_3292":61795},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3839":2400,"_33145":2380,"_22633":61797,"_5":15597,"_29869":61755,"_3292":61798},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3839":2401,"_33145":2380,"_22633":61800,"_5":15597,"_29869":61758,"_3292":61801},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3839":2402,"_33145":2380,"_22633":61803,"_5":15597,"_29869":61761,"_3292":61804},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3839":2403,"_33145":2380,"_22633":61806,"_5":15597,"_29869":61764,"_3292":61807},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3839":2404,"_33145":2380,"_22633":61809,"_5":15597,"_29869":61764,"_3292":61810},[],"its subject and extensions identify the expected client;",{"_3839":2405,"_33145":2380,"_22633":61812,"_5":15597,"_29869":61764,"_3292":61813},[],"its public key matches the client's private key;",{"_3839":2406,"_33145":2380,"_22633":61815,"_5":15597,"_29869":61764,"_3292":61816},[],"its chain reaches a root trusted by the consumer;",{"_3839":2407,"_33145":2380,"_22633":61818,"_5":15597,"_29869":61764,"_3292":61819},[],"its dates and usages allow the operation;",{"_3839":2408,"_33145":2380,"_22633":61821,"_5":15597,"_29869":61764,"_3292":61822},[],"the consumer applies revocation checks and authorization.",{"_3839":2409,"_33145":2380,"_22633":61824,"_5":15597,"_29869":61764,"_3292":61825},[],"The issuance path includes the first independent checks.",{"_3839":2410,"_33145":2380,"_22633":61827,"_5":15597,"_29869":61768,"_3292":61828},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3839":2411,"_33145":2380,"_22633":61830,"_5":15597,"_29869":61768,"_3292":61831},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3839":2412,"_33145":2380,"_22633":61833,"_5":15597,"_29869":61768,"_3292":61834},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3839":2413,"_33145":2413,"_5":15996,"_3292":61836,"_33551":61837,"_22633":61838,"_29869":2413},"Create your first CA",[54324,55792,59794,59231],[],{"_3839":2414,"_33145":2413,"_22633":61840,"_5":15597,"_29869":2413,"_3292":61841},[],"Create an evaluation root and check its certificate before issuing.",{"_3839":2415,"_33145":2413,"_5":33548,"_22633":61843,"_29869":61844,"_3292":54334},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3839":2416,"_33145":2413,"_5":33548,"_22633":61846,"_29869":61847,"_3292":61848},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3839":2417,"_33145":2413,"_5":33548,"_22633":61850,"_29869":61851,"_3292":61852},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3839":2418,"_33145":2413,"_5":33548,"_22633":61854,"_29869":61855,"_3292":61856},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3839":2419,"_33145":2413,"_5":33548,"_22633":61858,"_29869":61859,"_3292":61860},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3839":2420,"_33145":2413,"_5":33548,"_22633":61862,"_29869":61863,"_3292":61864},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3839":2421,"_33145":2413,"_5":33548,"_22633":61866,"_29869":61867,"_3292":61868},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3839":2422,"_33145":2413,"_5":33548,"_22633":61870,"_29869":61871,"_3292":59488},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3839":2423,"_33145":2413,"_5":33548,"_22633":61873,"_29869":61874,"_3292":54358},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3839":2424,"_33145":2413,"_22633":61876,"_5":15597,"_29869":2413,"_3292":61877},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3839":2425,"_33145":2413,"_22633":61879,"_5":15597,"_29869":61844,"_3292":61880},[],"Console access and permission to create keys and authorities.",{"_3839":2426,"_33145":2413,"_22633":61882,"_5":15597,"_29869":61844,"_3292":61883},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3839":2427,"_33145":2413,"_22633":61885,"_5":15597,"_29869":61844,"_3292":61886},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3839":2428,"_33145":2413,"_22633":61888,"_5":15597,"_29869":61844,"_3292":61889},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3839":2429,"_33145":2413,"_22633":61891,"_5":15597,"_29869":61847,"_3292":61892},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3839":2430,"_33145":2413,"_22633":61894,"_5":15597,"_29869":61847,"_3292":61895},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3839":2431,"_33145":2413,"_22633":61897,"_5":15597,"_29869":61851,"_3292":61898},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3839":2432,"_33145":2413,"_22633":61900,"_5":15597,"_29869":61851,"_3292":61901},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3839":2433,"_33145":2413,"_22633":61903,"_5":15597,"_29869":61855,"_3292":61904},[],"Select **Root CA** and complete:",{"_3839":2434,"_33145":2413,"_22633":61906,"_5":15597,"_29869":61855,"_3292":61907},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3839":2435,"_33145":2413,"_22633":61909,"_5":15597,"_29869":61855,"_3292":61910},[],"**Subject**: organization and country details for your evaluation.",{"_3839":2436,"_33145":2413,"_22633":61912,"_5":15597,"_29869":61855,"_3292":61913},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3839":2437,"_33145":2413,"_22633":61915,"_5":15597,"_29869":61855,"_3292":61916},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3839":2438,"_33145":2413,"_22633":61918,"_5":15597,"_29869":61855,"_3292":61919},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3839":2439,"_33145":2413,"_22633":61921,"_5":15597,"_29869":61859,"_3292":61922},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3839":2440,"_33145":2413,"_22633":61924,"_5":15597,"_29869":61863,"_3292":61925},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3839":2441,"_33145":2413,"_22633":61927,"_5":15597,"_29869":61863,"_3292":61928},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3839":2442,"_33145":2413,"_22633":61930,"_5":15597,"_29869":61867,"_3292":61931},[],"Run from the directory where you saved `ca.pem`:",{"_3839":2443,"_33145":2413,"_22633":61933,"_5":15597,"_29869":61867,"_3292":61934},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3839":2444,"_33145":2413,"_22633":61936,"_5":15597,"_29869":61867,"_3292":61937},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3839":2445,"_33145":2413,"_22633":61939,"_5":15597,"_29869":61871,"_3292":61940},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3839":2446,"_33145":2413,"_22633":61942,"_5":15597,"_29869":61871,"_3292":61943},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3839":2447,"_33145":2413,"_22633":61945,"_5":15597,"_29869":61871,"_3292":61946},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3839":2448,"_33145":2413,"_22633":61948,"_5":15597,"_29869":61871,"_3292":61949},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3839":2449,"_33145":2413,"_22633":61951,"_5":15597,"_29869":61874,"_3292":61952},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3839":2450,"_33145":2450,"_5":15996,"_3292":61954,"_33551":61955,"_22633":61956,"_29869":2450},"Issue and verify a certificate",[54324,55792,59794,59231],[],{"_3839":2451,"_33145":2450,"_22633":61958,"_5":15597,"_29869":2450,"_3292":61959},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3839":2452,"_33145":2450,"_5":33548,"_22633":61961,"_29869":61962,"_3292":54334},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3839":2453,"_33145":2450,"_5":33548,"_22633":61964,"_29869":61965,"_3292":61966},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3839":2454,"_33145":2450,"_5":33548,"_22633":61968,"_29869":61969,"_3292":61970},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3839":2455,"_33145":2450,"_5":33548,"_22633":61972,"_29869":61973,"_3292":61974},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3839":2456,"_33145":2450,"_5":33548,"_22633":61976,"_29869":61977,"_3292":61978},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3839":2457,"_33145":2450,"_5":33548,"_22633":61980,"_29869":61981,"_3292":61982},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3839":2458,"_33145":2450,"_5":33548,"_22633":61984,"_29869":61985,"_3292":61986},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3839":2459,"_33145":2450,"_5":33548,"_22633":61988,"_29869":61989,"_3292":61990},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3839":2460,"_33145":2450,"_5":33548,"_22633":61992,"_29869":61993,"_3292":61994},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3839":2461,"_33145":2450,"_5":33548,"_22633":61996,"_29869":61997,"_3292":61998},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3839":2462,"_33145":2450,"_5":33548,"_22633":62000,"_29869":62001,"_3292":59488},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3839":2463,"_33145":2450,"_5":33548,"_22633":62003,"_29869":62004,"_3292":54358},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#next-step",{"_3839":2464,"_33145":2450,"_22633":62006,"_5":15597,"_29869":2450,"_3292":62007},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3839":2465,"_33145":2450,"_22633":62009,"_5":15597,"_29869":61962,"_3292":62010},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3839":2466,"_33145":2450,"_22633":62012,"_5":15597,"_29869":61962,"_3292":62013},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3839":2467,"_33145":2450,"_22633":62015,"_5":15597,"_29869":61962,"_3292":62016},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3839":2468,"_33145":2450,"_22633":62018,"_5":15597,"_29869":61962,"_3292":62019},[],"A client identifier: here we use `device-001`.",{"_3839":2469,"_33145":2450,"_22633":62021,"_5":15597,"_29869":61962,"_3292":62022},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3839":2470,"_33145":2450,"_22633":62024,"_5":15597,"_29869":61965,"_3292":62025},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3839":2471,"_33145":2450,"_22633":62027,"_5":15597,"_29869":61969,"_3292":62028},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3839":2472,"_33145":2450,"_22633":62030,"_5":15597,"_29869":61969,"_3292":62031},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3839":2473,"_33145":2450,"_22633":62033,"_5":15597,"_29869":61973,"_3292":62034},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3839":2474,"_33145":2450,"_22633":62036,"_5":15597,"_29869":61973,"_3292":62037},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3839":2475,"_33145":2450,"_22633":62039,"_5":15597,"_29869":61977,"_3292":62040},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3839":2476,"_33145":2450,"_22633":62042,"_5":15597,"_29869":61977,"_3292":62043},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3839":2477,"_33145":2450,"_22633":62045,"_5":15597,"_29869":61981,"_3292":62046},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3839":2478,"_33145":2450,"_22633":62048,"_5":15597,"_29869":61985,"_3292":62049},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3839":2479,"_33145":2450,"_22633":62051,"_5":15597,"_29869":61989,"_3292":62052},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3839":2480,"_33145":2450,"_22633":62054,"_5":15597,"_29869":61993,"_3292":62055},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3839":2481,"_33145":2450,"_22633":62057,"_5":15597,"_29869":61993,"_3292":62058},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3839":2482,"_33145":2450,"_22633":62060,"_5":15597,"_29869":61993,"_3292":62061},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3839":2483,"_33145":2450,"_22633":62063,"_5":15597,"_29869":61997,"_3292":62064},[],"In Bash, compare the two public-key digests:",{"_3839":2484,"_33145":2450,"_22633":62066,"_5":15597,"_29869":61997,"_3292":62067},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3839":2485,"_33145":2450,"_22633":62069,"_5":15597,"_29869":61997,"_3292":62070},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3839":2486,"_33145":2450,"_22633":62072,"_5":15597,"_29869":62001,"_3292":59572},[],{"_3839":2487,"_33145":2450,"_22633":62074,"_5":15597,"_29869":62001,"_3292":62075},[],"What to review",{"_3839":2488,"_33145":2450,"_22633":62077,"_5":15597,"_29869":62001,"_3292":62078},[],"The CA rejects issuance",{"_3839":2489,"_33145":2450,"_22633":62080,"_5":15597,"_29869":62001,"_3292":62081},[],"Permissions, CA state and key, algorithm and profile.",{"_3839":2490,"_33145":2450,"_22633":62083,"_5":15597,"_29869":62001,"_3292":62084},[],"Different subject or usages",{"_3839":2491,"_33145":2450,"_22633":62086,"_5":15597,"_29869":62001,"_3292":62087},[],"Applied profile and requested values.",{"_3839":2492,"_33145":2450,"_22633":62089,"_5":15597,"_29869":62001,"_3292":62090},[],"Issuer cannot be found",{"_3839":2493,"_33145":2450,"_22633":62092,"_5":15597,"_29869":62001,"_3292":62093},[],"Downloaded CA and required intermediate chain.",{"_3839":2494,"_33145":2450,"_22633":62095,"_5":15597,"_29869":62001,"_3292":62096},[],"Validity fails",{"_3839":2495,"_33145":2450,"_22633":62098,"_5":15597,"_29869":62001,"_3292":62099},[],"Certificate and CA dates, and the computer's clock.",{"_3839":2496,"_33145":2450,"_22633":62101,"_5":15597,"_29869":62001,"_3292":62102},[],"Public-key digests differ",{"_3839":2497,"_33145":2450,"_22633":62104,"_5":15597,"_29869":62001,"_3292":62105},[],"Certificate and key files from the same issuance.",{"_3839":2498,"_33145":2450,"_22633":62107,"_5":15597,"_29869":62001,"_3292":62108},[],"See PKI diagnostics to narrow an issuance failure.",{"_3839":2499,"_33145":2450,"_22633":62110,"_5":15597,"_29869":62004,"_3292":62111},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3839":2500,"_33145":2450,"_22633":62113,"_5":15597,"_29869":62004,"_3292":62114},[],"Manage certificates for inspection, status and revocation.",{"_3839":2501,"_33145":2450,"_22633":62116,"_5":15597,"_29869":62004,"_3292":62117},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3839":2502,"_33145":2450,"_22633":62119,"_5":15597,"_29869":62004,"_3292":62120},[],"Prepare EST for the device to request its next identities.",{"_3839":2503,"_33145":2450,"_22633":62122,"_5":15597,"_29869":62004,"_3292":62123},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3839":2504,"_33145":2504,"_5":15996,"_3292":62125,"_33551":62126,"_22633":62127,"_29869":2504},"PKI getting started",[54324,55792,59794,59231],[],{"_3839":2505,"_33145":2504,"_22633":62129,"_5":15597,"_29869":2504,"_3292":62130},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3839":2506,"_33145":2504,"_5":33548,"_22633":62132,"_29869":62133,"_3292":54334},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/overview#before-you-begin",{"_3839":2507,"_33145":2504,"_5":33548,"_22633":62135,"_29869":62136,"_3292":62137},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3839":2508,"_33145":2504,"_5":33548,"_22633":62139,"_29869":62140,"_3292":59423},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/overview#expected-result",{"_3839":2509,"_33145":2504,"_5":33548,"_22633":62142,"_29869":62143,"_3292":62144},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3839":2510,"_33145":2504,"_22633":62146,"_5":15597,"_29869":2504,"_3292":62147},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3839":2511,"_33145":2504,"_22633":62149,"_5":15597,"_29869":62133,"_3292":62150},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3839":2512,"_33145":2504,"_22633":62152,"_5":15597,"_29869":62133,"_3292":62153},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3839":2513,"_33145":2504,"_22633":62155,"_5":15597,"_29869":62133,"_3292":62156},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3839":2514,"_33145":2504,"_22633":62158,"_5":15597,"_29869":62133,"_3292":62159},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3839":2515,"_33145":2504,"_22633":62161,"_5":15597,"_29869":62133,"_3292":62162},[],"A working directory with restricted access for the downloaded key.",{"_3839":2516,"_33145":2504,"_22633":62164,"_5":15597,"_29869":62136,"_3292":62165},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3839":2517,"_33145":2504,"_22633":62167,"_5":15597,"_29869":62136,"_3292":62168},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3839":2518,"_33145":2504,"_22633":62170,"_5":15597,"_29869":62136,"_3292":62171},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3839":2519,"_33145":2504,"_22633":62173,"_5":15597,"_29869":62136,"_3292":62174},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3839":2520,"_33145":2504,"_22633":62176,"_5":15597,"_29869":62140,"_3292":62177},[],"File or resource",{"_3839":2521,"_33145":2504,"_22633":62179,"_5":15597,"_29869":62140,"_3292":59420},[],{"_3839":2522,"_33145":2504,"_22633":62181,"_5":15597,"_29869":62140,"_3292":62182},[],"Active root CA and `ca.pem`",{"_3839":2523,"_33145":2504,"_22633":62184,"_5":15597,"_29869":62140,"_3292":62185},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3839":2524,"_33145":2504,"_22633":62187,"_5":15597,"_29869":62140,"_3292":62188},[],"End-entity certificate and `device.crt`",{"_3839":2525,"_33145":2504,"_22633":62190,"_5":15597,"_29869":62140,"_3292":62191},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3839":2526,"_33145":2504,"_22633":62193,"_5":15597,"_29869":62140,"_3292":62194},[],"Private key `device.key`",{"_3839":2527,"_33145":2504,"_22633":62196,"_5":15597,"_29869":62140,"_3292":62197},[],"Its public key matches the one included in `device.crt`.",{"_3839":2528,"_33145":2504,"_22633":62199,"_5":15597,"_29869":62140,"_3292":62200},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3839":2529,"_33145":2504,"_22633":62202,"_5":15597,"_29869":62143,"_3292":62203},[],"To operate certificates, continue with Certificates and Validation.",{"_3839":2530,"_33145":2504,"_22633":62205,"_5":15597,"_29869":62143,"_3292":62206},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3839":2531,"_33145":2504,"_22633":62208,"_5":15597,"_29869":62143,"_3292":62209},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3839":2532,"_33145":2532,"_5":15996,"_3292":62211,"_33551":62212,"_22633":62213,"_29869":2532},"PKI troubleshooting",[54324,55792,59794,58369],[],{"_3839":2533,"_33145":2532,"_22633":62215,"_5":15597,"_29869":2532,"_3292":62216},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3839":2534,"_33145":2532,"_5":33548,"_22633":62218,"_29869":62219,"_3292":62220},[],"/docs/pr-preview/pr-58/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3839":2535,"_33145":2532,"_5":33548,"_22633":62222,"_29869":62223,"_3292":62224},[],"/docs/pr-preview/pr-58/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3839":2536,"_33145":2532,"_5":33548,"_22633":62226,"_29869":62227,"_3292":62228},[],"/docs/pr-preview/pr-58/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3839":2537,"_33145":2532,"_22633":62230,"_5":15597,"_29869":2532,"_3292":62231},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3839":2538,"_33145":2532,"_22633":62233,"_5":15597,"_29869":2532,"_3292":62234},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3839":2539,"_33145":2532,"_22633":62236,"_5":15597,"_29869":62219,"_3292":59420},[],{"_3839":2540,"_33145":2532,"_22633":62238,"_5":15597,"_29869":62219,"_3292":62239},[],"What to inspect",{"_3839":2541,"_33145":2532,"_22633":62241,"_5":15597,"_29869":62219,"_3292":54358},[],{"_3839":2542,"_33145":2532,"_22633":62243,"_5":15597,"_29869":62219,"_3292":58636},[],{"_3839":2543,"_33145":2532,"_22633":62245,"_5":15597,"_29869":62219,"_3292":62246},[],"Exists, is active and has usable dates.",{"_3839":2544,"_33145":2532,"_22633":62248,"_5":15597,"_29869":62219,"_3292":62249},[],"Authorities.",{"_3839":2545,"_33145":2532,"_22633":62251,"_5":15597,"_29869":62219,"_3292":62252},[],"Key",{"_3839":2546,"_33145":2532,"_22633":62254,"_5":15597,"_29869":62219,"_3292":62255},[],"The record has a usable private key and the engine can sign.",{"_3839":2547,"_33145":2532,"_22633":62257,"_5":15597,"_29869":62219,"_3292":62258},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3839":2548,"_33145":2532,"_22633":62260,"_5":15597,"_29869":62219,"_3292":62261},[],"CSR",{"_3839":2549,"_33145":2532,"_22633":62263,"_5":15597,"_29869":62219,"_3292":62264},[],"Correct PEM and verifiable signature.",{"_3839":2550,"_33145":2532,"_22633":62266,"_5":15597,"_29869":62219,"_3292":62267},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3839":2551,"_33145":2532,"_22633":62269,"_5":15597,"_29869":62219,"_3292":62270},[],"Profile",{"_3839":2552,"_33145":2532,"_22633":62272,"_5":15597,"_29869":62219,"_3292":62273},[],"Selected source, existing ID, allowed algorithm and size.",{"_3839":2553,"_33145":2532,"_22633":62275,"_5":15597,"_29869":62219,"_3292":62276},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3839":2554,"_33145":2532,"_22633":62278,"_5":15597,"_29869":62219,"_3292":59572},[],{"_3839":2555,"_33145":2532,"_22633":62280,"_5":15597,"_29869":62219,"_3292":62281},[],"Appropriate subject, SAN, usages and dates.",{"_3839":2556,"_33145":2532,"_22633":62283,"_5":15597,"_29869":62219,"_3292":62284},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3839":2557,"_33145":2532,"_22633":62286,"_5":15597,"_29869":62219,"_3292":62287},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3839":2558,"_33145":2532,"_22633":62289,"_5":15597,"_29869":62219,"_3292":62290},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3839":2559,"_33145":2532,"_22633":62292,"_5":15597,"_29869":62223,"_3292":62293},[],"Check each boundary independently:",{"_3839":2560,"_33145":2532,"_22633":62295,"_5":15597,"_29869":62223,"_3292":62296},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3839":2561,"_33145":2532,"_22633":62298,"_5":15597,"_29869":62223,"_3292":62299},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3839":2562,"_33145":2532,"_22633":62301,"_5":15597,"_29869":62223,"_3292":62302},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3839":2563,"_33145":2532,"_22633":62304,"_5":15597,"_29869":62223,"_3292":62305},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3839":2564,"_33145":2532,"_22633":62307,"_5":15597,"_29869":62223,"_3292":62308},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3839":2565,"_33145":2532,"_22633":62310,"_5":15597,"_29869":62223,"_3292":62311},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3839":2566,"_33145":2532,"_22633":62313,"_5":15597,"_29869":62227,"_3292":62314},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3839":2567,"_33145":2532,"_22633":62316,"_5":15597,"_29869":62227,"_3292":62317},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3839":2568,"_33145":2568,"_5":15996,"_3292":62319,"_33551":62320,"_22633":62323,"_29869":2568},"Algorithms",[54324,55792,62321,62322],"[Beta] Post-quantum (PQC)","Algorithms and toolchain",[],{"_3839":2569,"_33145":2568,"_22633":62325,"_5":15597,"_29869":2568,"_3292":62326},[],"The post-quantum and composite signature algorithms Lamassu supports, how each is identified in API requests, and the standards they follow.",{"_3839":2570,"_33145":2568,"_5":33548,"_22633":62328,"_29869":62329,"_3292":62330},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#how-an-algorithm-is-selected","How an algorithm is selected",{"_3839":2571,"_33145":2568,"_5":33548,"_22633":62332,"_29869":62333,"_3292":62334},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#ml-dsa","ML-DSA",{"_3839":2572,"_33145":2568,"_5":33548,"_22633":62336,"_29869":62337,"_3292":62338},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#slh-dsa","SLH-DSA",{"_3839":2573,"_33145":2568,"_5":33548,"_22633":62340,"_29869":62341,"_3292":62342},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#composite-ml-dsa","Composite ML-DSA",{"_3839":2574,"_33145":2568,"_5":33548,"_22633":62344,"_29869":62345,"_3292":62346},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#ed25519","Ed25519",{"_3839":2575,"_33145":2568,"_5":33548,"_22633":62348,"_29869":62349,"_3292":62350},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#what-is-not-covered","What is not covered",{"_3839":2576,"_33145":2568,"_22633":62352,"_5":15597,"_29869":2568,"_3292":62353},[],"Lamassu supports four groups of signature algorithms beyond RSA and ECDSA: ML-DSA, SLH-DSA, composite ML-DSA and Ed25519. All of them come from the Go PQC toolchain; the backend only selects the algorithm and delegates the cryptography.",{"_3839":2577,"_33145":2568,"_22633":62355,"_5":15597,"_29869":62329,"_3292":62356},[],"A key or CA is created with a key type and a size. For RSA and ECDSA the size is a bit length or a curve. For the post-quantum algorithms the same field carries a **parameter set identifier**, not a number of bits:",{"_3839":2578,"_33145":2568,"_22633":62358,"_5":15597,"_29869":62329,"_3292":62359},[],"Key type (`algorithm` / `type`)",{"_3839":2579,"_33145":2568,"_22633":62361,"_5":15597,"_29869":62329,"_3292":62362},[],"Value of `size` / `bits`",{"_3839":2580,"_33145":2568,"_22633":62364,"_5":15597,"_29869":62329,"_3292":56863},[],{"_3839":2581,"_33145":2568,"_22633":62366,"_5":15597,"_29869":62329,"_3292":62367},[],"`RSA`",{"_3839":2582,"_33145":2568,"_22633":62369,"_5":15597,"_29869":62329,"_3292":62370},[],"2048, 3072, 4096",{"_3839":2583,"_33145":2568,"_22633":62372,"_5":15597,"_29869":62329,"_3292":62373},[],"Modulus length in bits.",{"_3839":2584,"_33145":2568,"_22633":62375,"_5":15597,"_29869":62329,"_3292":62376},[],"`ECDSA`",{"_3839":2585,"_33145":2568,"_22633":62378,"_5":15597,"_29869":62329,"_3292":62379},[],"256, 384, 521",{"_3839":2586,"_33145":2568,"_22633":62381,"_5":15597,"_29869":62329,"_3292":62382},[],"Curve size in bits (P-256, P-384, P-521).",{"_3839":2587,"_33145":2568,"_22633":62384,"_5":15597,"_29869":62329,"_3292":62385},[],"`Ed25519`",{"_3839":2588,"_33145":2568,"_22633":62387,"_5":15597,"_29869":62329,"_3292":25551},[],{"_3839":2589,"_33145":2568,"_22633":62389,"_5":15597,"_29869":62329,"_3292":62390},[],"Fixed. Any other value is replaced by 256.",{"_3839":2590,"_33145":2568,"_22633":62392,"_5":15597,"_29869":62329,"_3292":62393},[],"`ML-DSA`",{"_3839":2591,"_33145":2568,"_22633":62395,"_5":15597,"_29869":62329,"_3292":62396},[],"44, 65, 87",{"_3839":2592,"_33145":2568,"_22633":62398,"_5":15597,"_29869":62329,"_3292":62399},[],"ML-DSA parameter set.",{"_3839":2593,"_33145":2568,"_22633":62401,"_5":15597,"_29869":62329,"_3292":62402},[],"`SLH-DSA`",{"_3839":2594,"_33145":2568,"_22633":62404,"_5":15597,"_29869":62329,"_3292":62405},[],"1 to 12",{"_3839":2595,"_33145":2568,"_22633":62407,"_5":15597,"_29869":62329,"_3292":62408},[],"SLH-DSA parameter set, in the order below.",{"_3839":2596,"_33145":2568,"_22633":62410,"_5":15597,"_29869":62329,"_3292":62411},[],"`Composite-ML-DSA-RSA`",{"_3839":2597,"_33145":2568,"_22633":62413,"_5":15597,"_29869":62329,"_3292":62414},[],"1 to 8",{"_3839":2598,"_33145":2568,"_22633":62416,"_5":15597,"_29869":62329,"_3292":62417},[],"Composite variant with an RSA component.",{"_3839":2599,"_33145":2568,"_22633":62419,"_5":15597,"_29869":62329,"_3292":62420},[],"`Composite-ML-DSA-ECDSA`",{"_3839":2600,"_33145":2568,"_22633":62422,"_5":15597,"_29869":62329,"_3292":62423},[],"9 to 13",{"_3839":2601,"_33145":2568,"_22633":62425,"_5":15597,"_29869":62329,"_3292":62426},[],"Composite variant with an ECDSA component.",{"_3839":2602,"_33145":2568,"_22633":62428,"_5":15597,"_29869":62329,"_3292":62429},[],"`Composite-ML-DSA-Ed25519`",{"_3839":2603,"_33145":2568,"_22633":62431,"_5":15597,"_29869":62329,"_3292":62432},[],"14 and 15",{"_3839":2604,"_33145":2568,"_22633":62434,"_5":15597,"_29869":62329,"_3292":62435},[],"Composite variant with an Ed25519 component.",{"_3839":2605,"_33145":2568,"_22633":62437,"_5":15597,"_29869":62329,"_3292":62438},[],"An unknown key type string is not rejected when it is parsed; it becomes an unknown type and fails later. Use the exact strings above.",{"_3839":2606,"_33145":2568,"_22633":62440,"_5":15597,"_29869":62333,"_3292":62441},[],"ML-DSA is the lattice-based signature scheme standardized in FIPS 204. Lamassu accepts the three parameter sets ML-DSA-44, ML-DSA-65 and ML-DSA-87, selected with `size` 44, 65 or 87. The implementation is the `crypto/mldsa` package of Go 1.27, so it is the standard library's own code and not part of the fork. In certificates the algorithm identifiers are `2.16.840.1.101.3.4.3.17`, `.18` and `.19` for ML-DSA-44, -65 and -87.",{"_3839":2607,"_33145":2568,"_22633":62443,"_5":15597,"_29869":62333,"_3292":62444},[],"Go reads ML-DSA private keys in PKCS#8 only when they contain the 32-byte seed. Keys written by OpenSSL in its default seed-plus-expanded form are rejected, so export them in the seed-only form before importing them.",{"_3839":2608,"_33145":2568,"_22633":62446,"_5":15597,"_29869":62337,"_3292":62447},[],"SLH-DSA is the hash-based scheme of FIPS 205. It offers twelve parameter sets that combine a hash family (SHA-2 or SHAKE), the parameter n of 128, 192 or 256 bits, which corresponds to NIST security categories 1, 3 and 5 and a trade-off between signature size and signing speed (`s` for small signatures, `f` for fast signing). The identifier written in `size` follows the order of the underlying library:",{"_3839":2609,"_33145":2568,"_22633":62449,"_5":15597,"_29869":62337,"_3292":62450},[],"ID",{"_3839":2610,"_33145":2568,"_22633":62452,"_5":15597,"_29869":62337,"_3292":62453},[],"Parameter set",{"_3839":2611,"_33145":2568,"_22633":62455,"_5":15597,"_29869":62337,"_3292":62450},[],{"_3839":2612,"_33145":2568,"_22633":62457,"_5":15597,"_29869":62337,"_3292":62453},[],{"_3839":2613,"_33145":2568,"_22633":62459,"_5":15597,"_29869":62337,"_3292":15684},[],{"_3839":2614,"_33145":2568,"_22633":62461,"_5":15597,"_29869":62337,"_3292":62462},[],"SLH-DSA-SHA2-128s",{"_3839":2615,"_33145":2568,"_22633":62464,"_5":15597,"_29869":62337,"_3292":15705},[],{"_3839":2616,"_33145":2568,"_22633":62466,"_5":15597,"_29869":62337,"_3292":62467},[],"SLH-DSA-SHA2-192f",{"_3839":2617,"_33145":2568,"_22633":62469,"_5":15597,"_29869":62337,"_3292":11291},[],{"_3839":2618,"_33145":2568,"_22633":62471,"_5":15597,"_29869":62337,"_3292":62472},[],"SLH-DSA-SHAKE-128s",{"_3839":2619,"_33145":2568,"_22633":62474,"_5":15597,"_29869":62337,"_3292":11156},[],{"_3839":2620,"_33145":2568,"_22633":62476,"_5":15597,"_29869":62337,"_3292":62477},[],"SLH-DSA-SHAKE-192f",{"_3839":2621,"_33145":2568,"_22633":62479,"_5":15597,"_29869":62337,"_3292":11235},[],{"_3839":2622,"_33145":2568,"_22633":62481,"_5":15597,"_29869":62337,"_3292":62482},[],"SLH-DSA-SHA2-128f",{"_3839":2623,"_33145":2568,"_22633":62484,"_5":15597,"_29869":62337,"_3292":28495},[],{"_3839":2624,"_33145":2568,"_22633":62486,"_5":15597,"_29869":62337,"_3292":62487},[],"SLH-DSA-SHA2-256s",{"_3839":2625,"_33145":2568,"_22633":62489,"_5":15597,"_29869":62337,"_3292":11140},[],{"_3839":2626,"_33145":2568,"_22633":62491,"_5":15597,"_29869":62337,"_3292":62492},[],"SLH-DSA-SHAKE-128f",{"_3839":2627,"_33145":2568,"_22633":62494,"_5":15597,"_29869":62337,"_3292":32288},[],{"_3839":2628,"_33145":2568,"_22633":62496,"_5":15597,"_29869":62337,"_3292":62497},[],"SLH-DSA-SHAKE-256s",{"_3839":2629,"_33145":2568,"_22633":62499,"_5":15597,"_29869":62337,"_3292":11366},[],{"_3839":2630,"_33145":2568,"_22633":62501,"_5":15597,"_29869":62337,"_3292":62502},[],"SLH-DSA-SHA2-192s",{"_3839":2631,"_33145":2568,"_22633":62504,"_5":15597,"_29869":62337,"_3292":32322},[],{"_3839":2632,"_33145":2568,"_22633":62506,"_5":15597,"_29869":62337,"_3292":62507},[],"SLH-DSA-SHA2-256f",{"_3839":2633,"_33145":2568,"_22633":62509,"_5":15597,"_29869":62337,"_3292":11148},[],{"_3839":2634,"_33145":2568,"_22633":62511,"_5":15597,"_29869":62337,"_3292":62512},[],"SLH-DSA-SHAKE-192s",{"_3839":2635,"_33145":2568,"_22633":62514,"_5":15597,"_29869":62337,"_3292":31796},[],{"_3839":2636,"_33145":2568,"_22633":62516,"_5":15597,"_29869":62337,"_3292":62517},[],"SLH-DSA-SHAKE-256f",{"_3839":2637,"_33145":2568,"_22633":62519,"_5":15597,"_29869":62337,"_3292":62520},[],"The object identifiers run from `2.16.840.1.101.3.4.3.20` to `.31`. SLH-DSA signatures are large, between about 8 and 50 KB depending on the parameter set, which matters for certificate chains and for any transport with a size limit. SLH-DSA is available for keys, CAs and certificates, but the fork has no TLS signature scheme for it, so an SLH-DSA certificate cannot authenticate a TLS connection.",{"_3839":2638,"_33145":2568,"_22633":62522,"_5":15597,"_29869":62341,"_3292":62523},[],"A composite key pairs an ML-DSA key with a traditional key. A composite signature is the concatenation of the ML-DSA signature and the traditional signature, both computed over a message representative that contains a fixed prefix, an algorithm label, an optional context and a hash of the message; verification fails if either component fails. The ML-DSA component is pure ML-DSA, with the label as its context. Lamassu implements the 15 algorithms of draft 19 of the IETF specification that rely only on algorithms available in Go. The identifiers sit under the arc `1.3.6.1.5.5.7.6`.",{"_3839":2639,"_33145":2568,"_22633":62525,"_5":15597,"_29869":62341,"_3292":62526},[],"`size`",{"_3839":2640,"_33145":2568,"_22633":62528,"_5":15597,"_29869":62341,"_3292":62529},[],"Algorithm",{"_3839":2641,"_33145":2568,"_22633":62531,"_5":15597,"_29869":62341,"_3292":62532},[],"Final OID digit",{"_3839":2642,"_33145":2568,"_22633":62534,"_5":15597,"_29869":62341,"_3292":62535},[],"Family",{"_3839":2643,"_33145":2568,"_22633":62537,"_5":15597,"_29869":62341,"_3292":15684},[],{"_3839":2644,"_33145":2568,"_22633":62539,"_5":15597,"_29869":62341,"_3292":62540},[],"MLDSA44-RSA2048-PSS-SHA256",{"_3839":2645,"_33145":2568,"_22633":62542,"_5":15597,"_29869":62341,"_3292":33019},[],{"_3839":2646,"_33145":2568,"_22633":62544,"_5":15597,"_29869":62341,"_3292":62545},[],"RSA",{"_3839":2647,"_33145":2568,"_22633":62547,"_5":15597,"_29869":62341,"_3292":11291},[],{"_3839":2648,"_33145":2568,"_22633":62549,"_5":15597,"_29869":62341,"_3292":62550},[],"MLDSA44-RSA2048-PKCS15-SHA256",{"_3839":2649,"_33145":2568,"_22633":62552,"_5":15597,"_29869":62341,"_3292":32992},[],{"_3839":2650,"_33145":2568,"_22633":62554,"_5":15597,"_29869":62341,"_3292":62545},[],{"_3839":2651,"_33145":2568,"_22633":62556,"_5":15597,"_29869":62341,"_3292":11235},[],{"_3839":2652,"_33145":2568,"_22633":62558,"_5":15597,"_29869":62341,"_3292":62559},[],"MLDSA65-RSA3072-PSS-SHA512",{"_3839":2653,"_33145":2568,"_22633":62561,"_5":15597,"_29869":62341,"_3292":31907},[],{"_3839":2654,"_33145":2568,"_22633":62563,"_5":15597,"_29869":62341,"_3292":62545},[],{"_3839":2655,"_33145":2568,"_22633":62565,"_5":15597,"_29869":62341,"_3292":11140},[],{"_3839":2656,"_33145":2568,"_22633":62567,"_5":15597,"_29869":62341,"_3292":62568},[],"MLDSA65-RSA3072-PKCS15-SHA512",{"_3839":2657,"_33145":2568,"_22633":62570,"_5":15597,"_29869":62341,"_3292":31913},[],{"_3839":2658,"_33145":2568,"_22633":62572,"_5":15597,"_29869":62341,"_3292":62545},[],{"_3839":2659,"_33145":2568,"_22633":62574,"_5":15597,"_29869":62341,"_3292":11366},[],{"_3839":2660,"_33145":2568,"_22633":62576,"_5":15597,"_29869":62341,"_3292":62577},[],"MLDSA65-RSA4096-PSS-SHA512",{"_3839":2661,"_33145":2568,"_22633":62579,"_5":15597,"_29869":62341,"_3292":31919},[],{"_3839":2662,"_33145":2568,"_22633":62581,"_5":15597,"_29869":62341,"_3292":62545},[],{"_3839":2663,"_33145":2568,"_22633":62583,"_5":15597,"_29869":62341,"_3292":11148},[],{"_3839":2664,"_33145":2568,"_22633":62585,"_5":15597,"_29869":62341,"_3292":62586},[],"MLDSA65-RSA4096-PKCS15-SHA512",{"_3839":2665,"_33145":2568,"_22633":62588,"_5":15597,"_29869":62341,"_3292":11143},[],{"_3839":2666,"_33145":2568,"_22633":62590,"_5":15597,"_29869":62341,"_3292":62545},[],{"_3839":2667,"_33145":2568,"_22633":62592,"_5":15597,"_29869":62341,"_3292":15705},[],{"_3839":2668,"_33145":2568,"_22633":62594,"_5":15597,"_29869":62341,"_3292":62595},[],"MLDSA87-RSA3072-PSS-SHA512",{"_3839":2669,"_33145":2568,"_22633":62597,"_5":15597,"_29869":62341,"_3292":31801},[],{"_3839":2670,"_33145":2568,"_22633":62599,"_5":15597,"_29869":62341,"_3292":62545},[],{"_3839":2671,"_33145":2568,"_22633":62601,"_5":15597,"_29869":62341,"_3292":11156},[],{"_3839":2672,"_33145":2568,"_22633":62603,"_5":15597,"_29869":62341,"_3292":62604},[],"MLDSA87-RSA4096-PSS-SHA512",{"_3839":2673,"_33145":2568,"_22633":62606,"_5":15597,"_29869":62341,"_3292":31823},[],{"_3839":2674,"_33145":2568,"_22633":62608,"_5":15597,"_29869":62341,"_3292":62545},[],{"_3839":2675,"_33145":2568,"_22633":62610,"_5":15597,"_29869":62341,"_3292":28495},[],{"_3839":2676,"_33145":2568,"_22633":62612,"_5":15597,"_29869":62341,"_3292":62613},[],"MLDSA44-ECDSA-P256-SHA256",{"_3839":2677,"_33145":2568,"_22633":62615,"_5":15597,"_29869":62341,"_3292":31859},[],{"_3839":2678,"_33145":2568,"_22633":62617,"_5":15597,"_29869":62341,"_3292":62618},[],"ECDSA",{"_3839":2679,"_33145":2568,"_22633":62620,"_5":15597,"_29869":62341,"_3292":32288},[],{"_3839":2680,"_33145":2568,"_22633":62622,"_5":15597,"_29869":62341,"_3292":62623},[],"MLDSA65-ECDSA-P256-SHA512",{"_3839":2681,"_33145":2568,"_22633":62625,"_5":15597,"_29869":62341,"_3292":31925},[],{"_3839":2682,"_33145":2568,"_22633":62627,"_5":15597,"_29869":62341,"_3292":62618},[],{"_3839":2683,"_33145":2568,"_22633":62629,"_5":15597,"_29869":62341,"_3292":32322},[],{"_3839":2684,"_33145":2568,"_22633":62631,"_5":15597,"_29869":62341,"_3292":62632},[],"MLDSA65-ECDSA-P384-SHA512",{"_3839":2685,"_33145":2568,"_22633":62634,"_5":15597,"_29869":62341,"_3292":31931},[],{"_3839":2686,"_33145":2568,"_22633":62636,"_5":15597,"_29869":62341,"_3292":62618},[],{"_3839":2687,"_33145":2568,"_22633":62638,"_5":15597,"_29869":62341,"_3292":31796},[],{"_3839":2688,"_33145":2568,"_22633":62640,"_5":15597,"_29869":62341,"_3292":62641},[],"MLDSA87-ECDSA-P384-SHA512",{"_3839":2689,"_33145":2568,"_22633":62643,"_5":15597,"_29869":62341,"_3292":31937},[],{"_3839":2690,"_33145":2568,"_22633":62645,"_5":15597,"_29869":62341,"_3292":62618},[],{"_3839":2691,"_33145":2568,"_22633":62647,"_5":15597,"_29869":62341,"_3292":32388},[],{"_3839":2692,"_33145":2568,"_22633":62649,"_5":15597,"_29869":62341,"_3292":62650},[],"MLDSA87-ECDSA-P521-SHA512",{"_3839":2693,"_33145":2568,"_22633":62652,"_5":15597,"_29869":62341,"_3292":31829},[],{"_3839":2694,"_33145":2568,"_22633":62654,"_5":15597,"_29869":62341,"_3292":62618},[],{"_3839":2695,"_33145":2568,"_22633":62656,"_5":15597,"_29869":62341,"_3292":31977},[],{"_3839":2696,"_33145":2568,"_22633":62658,"_5":15597,"_29869":62341,"_3292":62659},[],"MLDSA44-Ed25519-SHA512",{"_3839":2697,"_33145":2568,"_22633":62661,"_5":15597,"_29869":62341,"_3292":33025},[],{"_3839":2698,"_33145":2568,"_22633":62663,"_5":15597,"_29869":62341,"_3292":62346},[],{"_3839":2699,"_33145":2568,"_22633":62665,"_5":15597,"_29869":62341,"_3292":32394},[],{"_3839":2700,"_33145":2568,"_22633":62667,"_5":15597,"_29869":62341,"_3292":62668},[],"MLDSA65-Ed25519-SHA512",{"_3839":2701,"_33145":2568,"_22633":62670,"_5":15597,"_29869":62341,"_3292":31901},[],{"_3839":2702,"_33145":2568,"_22633":62672,"_5":15597,"_29869":62341,"_3292":62346},[],{"_3839":2703,"_33145":2568,"_22633":62674,"_5":15597,"_29869":62341,"_3292":62675},[],"The key type must match the family of the variant: creating a `Composite-ML-DSA-ECDSA` key with `size` 3 fails with an error saying that the variant is not valid for that key type.",{"_3839":2704,"_33145":2568,"_22633":62677,"_5":15597,"_29869":62341,"_3292":62678},[],"Draft 19 has since been published as RFC 10073. The object identifiers and the domain separator prefix checked against the RFC match this page, but the implementation was written and tested against the draft and has not been compared with the final text. Three algorithms of the specification are not implemented because Go has no Brainpool curves and no Ed448: the two Brainpool variants (`MLDSA65-ECDSA-brainpoolP256r1` and `MLDSA87-ECDSA-brainpoolP384r1`, with their hash suffix) and the Ed448 variant. The fork passes the official test vectors of draft 19 for the 15 algorithms it does implement.",{"_3839":2705,"_33145":2568,"_22633":62680,"_5":15597,"_29869":62341,"_3292":62681},[],"The composite parameters of keys and signatures must be absent from the `AlgorithmIdentifier`; certificates that carry them are rejected. ECDSA components must use a private scalar of the exact length of the curve.",{"_3839":2706,"_33145":2568,"_22633":62683,"_5":15597,"_29869":62345,"_3292":62684},[],"Ed25519 is not post-quantum, but support for it as a CA and certificate key type was added in the same work and is selected with the `Ed25519` key type. It is classified in the traditional family.",{"_3839":2707,"_33145":2568,"_22633":62686,"_5":15597,"_29869":62349,"_3292":62687},[],"Lamassu does not implement post-quantum key exchange of its own. The hybrid key exchanges offered by the TLS endpoint, such as `X25519MLKEM768`, are those of the Go 1.27 standard library. The Chameleon and delta-certificate designs explored in earlier iterations were removed and are not part of the implementation.",{"_3839":2708,"_33145":2568,"_22633":62689,"_5":15597,"_29869":62349,"_3292":62690},[],"<Card title=\"Go PQC toolchain\" description=\"The fork that implements these algorithms and the API it adds.\" href=\"/docs/platform/pqc/go-toolchain\" />",{"_3839":2709,"_33145":2568,"_22633":62692,"_5":15597,"_29869":62349,"_3292":62693},[],"<Card title=\"Keys and certificate authorities\" description=\"Use these parameters in KMS and CA requests.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_3839":2710,"_33145":2710,"_5":15996,"_3292":62695,"_33551":62696,"_22633":62698,"_29869":2710},"Dashboard",[54324,55792,62321,62697],"Platform support",[],{"_3839":2711,"_33145":2710,"_22633":62700,"_5":15597,"_29869":2710,"_3292":62701},[],"How the web interface exposes post-quantum algorithms when creating keys, CAs and certificates, and how it displays them.",{"_3839":2712,"_33145":2710,"_5":33548,"_22633":62703,"_29869":62704,"_3292":62705},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#choosing-a-key-type-and-specification","Choosing a key type and specification",{"_3839":2713,"_33145":2710,"_5":33548,"_22633":62707,"_29869":62708,"_3292":62709},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#issuing-a-certificate-with-a-browser-generated-key","Issuing a certificate with a browser-generated key",{"_3839":2714,"_33145":2710,"_5":33548,"_22633":62711,"_29869":62712,"_3292":62713},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#how-objects-are-displayed","How objects are displayed",{"_3839":2715,"_33145":2710,"_5":33548,"_22633":62715,"_29869":62716,"_3292":62717},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#related-certificates","Related certificates",{"_3839":2716,"_33145":2710,"_5":33548,"_22633":62719,"_29869":62720,"_3292":62721},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#things-to-know","Things to know",{"_3839":2717,"_33145":2710,"_22633":62723,"_5":15597,"_29869":2710,"_3292":62724},[],"The dashboard (branch `feat/lamassu-q`) lets an administrator create and inspect post-quantum keys, certificate authorities and certificates without writing API requests. It adds the algorithm choices, shows the algorithm family of every object and parses the new identifiers in certificates. Everything it sends is described in Keys and certificate authorities; this page covers what the interface shows and where its behaviour differs between screens.",{"_3839":2718,"_33145":2710,"_22633":62726,"_5":15597,"_29869":62704,"_3292":62727},[],"Creating a KMS key, a CA with a new key and a certificate with a server-generated key all use the same pair of selectors. *Key type* is grouped by family and *Key specification* depends on the type.",{"_3839":2719,"_33145":2710,"_22633":62729,"_5":15597,"_29869":62704,"_3292":62730},[],"Group",{"_3839":2720,"_33145":2710,"_22633":62732,"_5":15597,"_29869":62704,"_3292":62733},[],"Key types",{"_3839":2721,"_33145":2710,"_22633":62735,"_5":15597,"_29869":62704,"_3292":62736},[],"T (Traditional)",{"_3839":2722,"_33145":2710,"_22633":62738,"_5":15597,"_29869":62704,"_3292":62739},[],"`RSA`, `ECDSA`, `Ed25519`",{"_3839":2723,"_33145":2710,"_22633":62741,"_5":15597,"_29869":62704,"_3292":62742},[],"PQ (Pure PQC)",{"_3839":2724,"_33145":2710,"_22633":62744,"_5":15597,"_29869":62704,"_3292":62745},[],"`ML-DSA`, `SLH-DSA`",{"_3839":2725,"_33145":2710,"_22633":62747,"_5":15597,"_29869":62704,"_3292":62748},[],"PQ/T (Hybrid)",{"_3839":2726,"_33145":2710,"_22633":62750,"_5":15597,"_29869":62704,"_3292":62751},[],"`Composite-ML-DSA-RSA`, `Composite-ML-DSA-ECDSA`, `Composite-ML-DSA-Ed25519`",{"_3839":2727,"_33145":2710,"_22633":62753,"_5":15597,"_29869":62704,"_3292":62754},[],"The specification list shows ML-DSA-44, -65 or -87, the twelve SLH-DSA parameter sets (for example *4 - SHAKE\\_128f*) or the composite variants by name. The interface sends the identifier of the parameter set as `size`, as explained in Algorithms, and shows a strength indicator next to each option. For composite keys the indicator shows two bars, one for the classical component and one for the post-quantum component.",{"_3839":2728,"_33145":2710,"_22633":62756,"_5":15597,"_29869":62704,"_3292":62757},[],"Which options are enabled depends on the crypto engine. When creating a key or a CA, the interface lists every algorithm but disables those that the selected engine does not support, and asks to select an engine first. When creating a certificate on the server, unsupported types are hidden instead.",{"_3839":2729,"_33145":2710,"_22633":62759,"_5":15597,"_29869":62708,"_3292":62760},[],"Issuing a certificate from a CA generates the key pair in the browser, builds the certificate request and sends it to the CA for signing. The key types offered here are `RSA`, `ECDSA`, `Ed25519`, `ML-DSA`, `SLH-DSA` and a single `Composite ML-DSA` entry, and they are generated with the `@noble` libraries for the post-quantum and composite algorithms and with WebCrypto for the classical ones. The generated private key is shown once at the end of the procedure.",{"_3839":2730,"_33145":2710,"_22633":62762,"_5":15597,"_29869":62708,"_3292":62763},[],"The browser does not verify the signatures of ML-DSA, SLH-DSA, composite or Ed25519 requests; it relies on the KMS.",{"_3839":2731,"_33145":2710,"_22633":62765,"_5":15597,"_29869":62712,"_3292":62766},[],"Lists and detail views show the algorithm family. The CA table has a *PQC* column with T, PQ or PQ/T, CA cards and the CA graph show a *PQC* badge, key lists show a quantum icon, and the details of a CA or certificate show the algorithm, its strength and the family badge. The family is computed from the algorithm identifier in the parsed certificate.",{"_3839":2732,"_33145":2710,"_22633":62768,"_5":15597,"_29869":62712,"_3292":62769},[],"Algorithm names are resolved from the object identifiers. ML-DSA, SLH-DSA, composite and Ed25519 identifiers are shown as names with their parameter set, for example *ML-DSA-65* or *Composite-Signature MLDSA65-ECDSA-P384-SHA512*, and no bit length is shown for them. RSA and ECDSA signature algorithms are displayed with the dashboard's own labels, such as *RSA PKCS#1 v1.5 SHA-256* and *ECDSA SHA-256*, instead of the OpenSSL names `sha256WithRSAEncryption` and `ecdsa-with-SHA256`.",{"_3839":2733,"_33145":2710,"_22633":62771,"_5":15597,"_29869":62712,"_3292":62772},[],"The key detail page can sign and verify with a post-quantum key and enables only the signature algorithm that corresponds to it.",{"_3839":2734,"_33145":2710,"_22633":62774,"_5":15597,"_29869":62716,"_3292":62775},[],"The issuance profile form, the issue-certificate form and the detail pages include the related-certificate controls described in Related certificates.",{"_3839":2735,"_33145":2710,"_22633":62777,"_5":15597,"_29869":62720,"_3292":62778},[],"The key type names are not identical across all screens. Key and CA creation use `Composite-ML-DSA-RSA`, `-ECDSA` and `-Ed25519`; the issue-certificate form uses a single `Composite-ML-DSA`; and the server-side certificate form compares upper-case names. The names that the backend reports for a key may therefore differ in case from what the interface submits.",{"_3839":2736,"_33145":2710,"_22633":62780,"_5":15597,"_29869":62720,"_3292":62781},[],"The interface carries no experimental warning for these algorithms and has no translation: all texts are in English.",{"_3839":2737,"_33145":2710,"_22633":62783,"_5":15597,"_29869":62720,"_3292":62784},[],"The mapping from the SLH-DSA parameter set identifier to the algorithm used by the in-browser key generator does not follow the same order as the identifiers shown in the selector and used by the backend, except for identifier 1. A certificate issued through the browser flow with an SLH-DSA identifier from 2 to 12 may therefore use a different parameter set than the one named in the selector. Create SLH-DSA keys with the KMS until this is corrected.",{"_3839":2738,"_33145":2710,"_22633":62786,"_5":15597,"_29869":62720,"_3292":62787},[],"<Card title=\"Keys and certificate authorities\" description=\"The API behind these screens.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_3839":2739,"_33145":2710,"_22633":62789,"_5":15597,"_29869":62720,"_3292":62790},[],"<Card title=\"Known limitations\" description=\"Gaps in the interface and the platform.\" href=\"/docs/platform/pqc/limitations\" />",{"_3839":2740,"_33145":2740,"_5":15996,"_3292":62792,"_33551":62793,"_22633":62794,"_29869":2740},"Deployment with the Helm chart",[54324,55792,62321,54325],[],{"_3839":2741,"_33145":2740,"_22633":62796,"_5":15597,"_29869":2740,"_3292":62797},[],"Deploy Lamassu with a Traefik front proxy that serves classical, post-quantum and composite certificates, using the chart values or the fast-lane installer.",{"_3839":2742,"_33145":2740,"_5":33548,"_22633":62799,"_29869":62800,"_3292":62801},[],"/docs/pr-preview/pr-58/platform/pqc/deployment#topology","Topology",{"_3839":2743,"_33145":2740,"_5":33548,"_22633":62803,"_29869":62804,"_3292":62805},[],"/docs/pr-preview/pr-58/platform/pqc/deployment#chart-values","Chart values",{"_3839":2744,"_33145":2740,"_5":33548,"_22633":62807,"_29869":62808,"_3292":62809},[],"/docs/pr-preview/pr-58/platform/pqc/deployment#the-fast-lane-installer","The fast-lane installer",{"_3839":2745,"_33145":2740,"_22633":62811,"_5":15597,"_29869":2740,"_3292":62812},[],"The `pqc` branch of the Lamassu Helm chart adds a front proxy: a Traefik instance built with the Go PQC toolchain that terminates the devices' TLS, authenticates them and forwards the traffic to Envoy Gateway. This page describes the resulting topology, the values that control it and the installer that automates a laboratory deployment.",{"_3839":2746,"_33145":2740,"_22633":62814,"_5":15597,"_29869":2740,"_3292":62815},[],"The chart and the installer assume a development cluster. The proxy image uses a mutable tag, the PQC certificates are not renewed automatically and the hop between Traefik and Envoy does not verify certificates. Do not use this configuration as it is for production.",{"_3839":2747,"_33145":2740,"_22633":62817,"_5":15597,"_29869":62800,"_3292":62818},[],"Traefik is the public edge. It negotiates the key exchange, serves the certificate and, if requested, receives the client certificate. It then opens a second TLS connection to the `envoy-gateway-proxy` service of Envoy Gateway, which presents the chart's self-signed classical certificate; Traefik is configured to accept it without verifying it. Envoy therefore never sees a post-quantum handshake, and the post-quantum protection covers only the connection between the client and Traefik. Traefik and Envoy Gateway are installed once per cluster and shared across namespaces, whereas the front proxy resources (the Gateway, route, middleware, certificate and reference grant) belong to the Lamassu release.",{"_3839":2748,"_33145":2740,"_22633":62820,"_5":15597,"_29869":62800,"_3292":62821},[],"When the client sent a certificate, the `inject-client-cert` middleware of the chart adds it, in PEM form, to the `X-Forwarded-Tls-Client-Cert` header, and the `X-Forwarded-Proto: https` header is set on the request.",{"_3839":2749,"_33145":2740,"_22633":62823,"_5":15597,"_29869":62804,"_3292":62824},[],"All the new values are under `traefikFrontProxy` and are validated by the chart's schema, which rejects unknown keys.",{"_3839":2750,"_33145":2740,"_22633":62826,"_5":15597,"_29869":62804,"_3292":62827},[],"Name",{"_3839":2751,"_33145":2740,"_22633":62829,"_5":15597,"_29869":62804,"_3292":58476},[],{"_3839":2752,"_33145":2740,"_22633":62831,"_5":15597,"_29869":62804,"_3292":54711},[],{"_3839":2753,"_33145":2740,"_22633":62833,"_5":15597,"_29869":62804,"_3292":58482},[],{"_3839":2754,"_33145":2740,"_22633":62835,"_5":15597,"_29869":62804,"_3292":62836},[],"`traefikFrontProxy.enabled`",{"_3839":2755,"_33145":2740,"_22633":62838,"_5":15597,"_29869":62804,"_3292":21299},[],{"_3839":2756,"_33145":2740,"_22633":62840,"_5":15597,"_29869":62804,"_3292":62841},[],"`false`",{"_3839":2757,"_33145":2740,"_22633":62843,"_5":15597,"_29869":62804,"_3292":62844},[],"Deploys the front proxy resources.",{"_3839":2758,"_33145":2740,"_22633":62846,"_5":15597,"_29869":62804,"_3292":62847},[],"`traefikFrontProxy.domain`",{"_3839":2759,"_33145":2740,"_22633":62849,"_5":15597,"_29869":62804,"_3292":27097},[],{"_3839":2760,"_33145":2740,"_22633":62851,"_5":15597,"_29869":62804,"_3292":62852},[],"`\"\"`",{"_3839":2761,"_33145":2740,"_22633":62854,"_5":15597,"_29869":62804,"_3292":62855},[],"Name of the edge certificate and host name of the route. Set it when the proxy is enabled.",{"_3839":2762,"_33145":2740,"_22633":62857,"_5":15597,"_29869":62804,"_3292":62858},[],"`traefikFrontProxy.webSecurePort`",{"_3839":2763,"_33145":2740,"_22633":62860,"_5":15597,"_29869":62804,"_3292":17654},[],{"_3839":2764,"_33145":2740,"_22633":62862,"_5":15597,"_29869":62804,"_3292":62863},[],"`8443`",{"_3839":2765,"_33145":2740,"_22633":62865,"_5":15597,"_29869":62804,"_3292":62866},[],"Port of the HTTPS listener; it must match Traefik's `websecure` entry point.",{"_3839":2766,"_33145":2740,"_22633":62868,"_5":15597,"_29869":62804,"_3292":62869},[],"`traefikFrontProxy.tls.type`",{"_3839":2767,"_33145":2740,"_22633":62871,"_5":15597,"_29869":62804,"_3292":27097},[],{"_3839":2768,"_33145":2740,"_22633":62873,"_5":15597,"_29869":62804,"_3292":62874},[],"`certManager`",{"_3839":2769,"_33145":2740,"_22633":62876,"_5":15597,"_29869":62804,"_3292":62877},[],"Source of the classical certificate: `certManager`, `external` or `none`.",{"_3839":2770,"_33145":2740,"_22633":62879,"_5":15597,"_29869":62804,"_3292":62880},[],"`traefikFrontProxy.tls.certManagerOptions.addresses`",{"_3839":2771,"_33145":2740,"_22633":62882,"_5":15597,"_29869":62804,"_3292":16497},[],{"_3839":2772,"_33145":2740,"_22633":62884,"_5":15597,"_29869":62804,"_3292":62885},[],"`[]`",{"_3839":2773,"_33145":2740,"_22633":62887,"_5":15597,"_29869":62804,"_3292":62888},[],"IP addresses added to the self-signed certificate.",{"_3839":2774,"_33145":2740,"_22633":62890,"_5":15597,"_29869":62804,"_3292":62891},[],"`traefikFrontProxy.tls.externalOptions.secretName`",{"_3839":2775,"_33145":2740,"_22633":62893,"_5":15597,"_29869":62804,"_3292":27097},[],{"_3839":2776,"_33145":2740,"_22633":62895,"_5":15597,"_29869":62804,"_3292":62852},[],{"_3839":2777,"_33145":2740,"_22633":62897,"_5":15597,"_29869":62804,"_3292":62898},[],"Secret with `tls.crt` and `tls.key` when the type is `external`.",{"_3839":2778,"_33145":2740,"_22633":62900,"_5":15597,"_29869":62804,"_3292":62901},[],"`traefikFrontProxy.tls.additionalSecretNames`",{"_3839":2779,"_33145":2740,"_22633":62903,"_5":15597,"_29869":62804,"_3292":16497},[],{"_3839":2780,"_33145":2740,"_22633":62905,"_5":15597,"_29869":62804,"_3292":62885},[],{"_3839":2781,"_33145":2740,"_22633":62907,"_5":15597,"_29869":62804,"_3292":62908},[],"Extra TLS secrets, for example ML-DSA or composite certificates, served on the same listener.",{"_3839":2782,"_33145":2740,"_22633":62910,"_5":15597,"_29869":62804,"_3292":62911},[],"With `certManager`, the chart requests an ECDSA P-256 certificate valid for 2160 hours from its own self-signed issuer and stores it in the secret `edge-cert`. With `none`, only the additional secrets are served, and the chart stops with an error if there are none. The proxy chooses among all the certificates according to the client, as described in TLS front proxy with Traefik. The names of the resources the chart creates are fixed, so only one release per namespace is supported.",{"_3839":2783,"_33145":2740,"_22633":62913,"_5":15597,"_29869":62804,"_3292":62914},[],"The chart also changes the Envoy Gateway service so that its HTTPS port declares `appProtocol: https`, which recent Traefik versions require in order to speak TLS to it. When `gateway.addresses` is empty, the Envoy service is a `ClusterIP` instead of a load balancer.",{"_3839":2784,"_33145":2740,"_22633":62916,"_5":15597,"_29869":62804,"_3292":62917},[],"The chart does not deploy Traefik itself, the `traefik` GatewayClass, or the `default` TLS option in the `traefik-system` namespace; the installer creates them. Without them, the edge has no post-quantum key exchange and no client-certificate request. The chart also does not set the Lamassu service images: the defaults are the development images, and the installer overrides the UI, CA, KMS, VA, device manager, DMS manager, alerts and authorization images with the `:pqc` tags of `ghcr.io/lamassuiot`.",{"_3839":2785,"_33145":2740,"_22633":62919,"_5":15597,"_29869":62808,"_3292":62920},[],"`scripts/lamassu-fast-lane.sh` installs everything on a cluster: the Gateway API custom resource definitions (version 1.6.3, experimental channel), Envoy Gateway 1.8.0, the Traefik chart 41.0.2 with the PQC image, the TLS option, PostgreSQL, Keycloak, RabbitMQ, optionally observability and SoftHSM, and finally the Lamassu release. The two flags that matter here select which algorithms are offered.",{"_3839":2786,"_33145":2740,"_22633":62922,"_5":15597,"_29869":62808,"_3292":62923},[],"Both flags take a comma-separated list of `T`, `PQ` and `PQ/T`, and both default to all three. For the key exchange, `PQ/T` is a hybrid group that combines a classical and an ML-KEM exchange (`X25519MLKEM768`, `SecP256r1MLKEM768` and `SecP384r1MLKEM1024`) and `PQ` is pure ML-KEM (`MLKEM1024`); for authentication, `PQ/T` is a composite certificate. `--tls-kex` fills the `curvePreferences` of the TLS option, and `--tls-auth` selects which certificates are served:",{"_3839":2787,"_33145":2740,"_22633":62925,"_5":15597,"_29869":62808,"_3292":62926},[],"Value",{"_3839":2788,"_33145":2740,"_22633":62928,"_5":15597,"_29869":62808,"_3292":62929},[],"Key exchange groups",{"_3839":2789,"_33145":2740,"_22633":62931,"_5":15597,"_29869":62808,"_3292":58687},[],{"_3839":2790,"_33145":2740,"_22633":62933,"_5":15597,"_29869":62808,"_3292":62934},[],"`T`",{"_3839":2791,"_33145":2740,"_22633":62936,"_5":15597,"_29869":62808,"_3292":62937},[],"`X25519`, `CurveP256`, `CurveP384`",{"_3839":2792,"_33145":2740,"_22633":62939,"_5":15597,"_29869":62808,"_3292":62940},[],"cert-manager ECDSA P-256, or the files given with `--tls-crt` and `--tls-key`, in the secret `edge-cert`.",{"_3839":2793,"_33145":2740,"_22633":62942,"_5":15597,"_29869":62808,"_3292":62943},[],"`PQ`",{"_3839":2794,"_33145":2740,"_22633":62945,"_5":15597,"_29869":62808,"_3292":62946},[],"`MLKEM1024`",{"_3839":2795,"_33145":2740,"_22633":62948,"_5":15597,"_29869":62808,"_3292":62949},[],"ML-DSA-65, in the secret `edge-cert-pq`.",{"_3839":2796,"_33145":2740,"_22633":62951,"_5":15597,"_29869":62808,"_3292":62952},[],"`PQ/T`",{"_3839":2797,"_33145":2740,"_22633":62954,"_5":15597,"_29869":62808,"_3292":62955},[],"`X25519MLKEM768`, `SecP256r1MLKEM768`, `SecP384r1MLKEM1024`",{"_3839":2798,"_33145":2740,"_22633":62957,"_5":15597,"_29869":62808,"_3292":62958},[],"Composite `MLDSA65-RSA3072-PSS-SHA512`, in the secret `edge-cert-pqt`.",{"_3839":2799,"_33145":2740,"_22633":62960,"_5":15597,"_29869":62808,"_3292":62961},[],"The minimum TLS version is 1.3 unless both flags are only `T`, in which case it is 1.2. cert-manager cannot issue post-quantum certificates, so the installer creates the PQ and PQ/T certificates locally with OpenSSL 3.5 or later; the composite certificate also needs the `hybrid-provider` module, which the script builds on demand with `git`, `cmake` and a C compiler. The ML-DSA private keys are written in the seed-only form that Go accepts, and the secrets are created from a manifest because `kubectl create secret tls` rejects ML-DSA keys. The certificates last 365 days and are kept if the secret already exists.",{"_3839":2800,"_33145":2740,"_22633":62963,"_5":15597,"_29869":62808,"_3292":62964},[],"The script requires `yq`, `kubectl` and `helm`, and `jq` with `--sample-data`. At the end it prints how to extract the CA that devices must trust, for example `kubectl get secret edge-cert-pq -o jsonpath='{.data.ca\\.crt}'`.",{"_3839":2801,"_33145":2740,"_22633":62966,"_5":15597,"_29869":62808,"_3292":62967},[],"Companion scripts for an MQTT broker behind Traefik (`scripts/emqx`), for exporting KMS keys and for restoring a backup are present in the working tree of the chart but not committed. They are for laboratory use only and are not described further here.",{"_3839":2802,"_33145":2740,"_22633":62969,"_5":15597,"_29869":62808,"_3292":62970},[],"<Card title=\"TLS front proxy with Traefik\" description=\"How the proxy chooses a certificate and how it is built.\" href=\"/docs/platform/pqc/tls-front-proxy\" />",{"_3839":2803,"_33145":2740,"_22633":62972,"_5":15597,"_29869":62808,"_3292":62973},[],"<Card title=\"Known limitations\" description=\"Caveats of the laboratory deployment.\" href=\"/docs/platform/pqc/limitations\" />",{"_3839":2804,"_33145":2804,"_5":15996,"_3292":62975,"_33551":62976,"_22633":62977,"_29869":2804},"Go PQC toolchain",[54324,55792,62321,62322],[],{"_3839":2805,"_33145":2804,"_22633":62979,"_5":15597,"_29869":2804,"_3292":62980},[],"The fork of Go that adds composite ML-DSA, SLH-DSA, related certificates and composite TLS signature schemes, the API it exposes and how it is built.",{"_3839":2806,"_33145":2804,"_5":33548,"_22633":62982,"_29869":62983,"_3292":62984},[],"/docs/pr-preview/pr-58/platform/pqc/go-toolchain#what-the-fork-adds","What the fork adds",{"_3839":2807,"_33145":2804,"_5":33548,"_22633":62986,"_29869":62987,"_3292":62988},[],"/docs/pr-preview/pr-58/platform/pqc/go-toolchain#tls-code-points","TLS code points",{"_3839":2808,"_33145":2804,"_5":33548,"_22633":62990,"_29869":62991,"_3292":62992},[],"/docs/pr-preview/pr-58/platform/pqc/go-toolchain#a-minimal-example","A minimal example",{"_3839":2809,"_33145":2804,"_5":33548,"_22633":62994,"_29869":62995,"_3292":62996},[],"/docs/pr-preview/pr-58/platform/pqc/go-toolchain#what-was-removed","What was removed",{"_3839":2810,"_33145":2804,"_5":33548,"_22633":62998,"_29869":62999,"_3292":63000},[],"/docs/pr-preview/pr-58/platform/pqc/go-toolchain#building-the-toolchain-and-the-images","Building the toolchain and the images",{"_3839":2811,"_33145":2804,"_22633":63002,"_5":15597,"_29869":2804,"_3292":63003},[],"Go 1.27 includes ML-DSA in `crypto/mldsa` and in X.509 and TLS, but it has no composite or SLH-DSA certificates, no related certificates and no composite TLS signature schemes. Lamassu therefore builds its backend and its TLS proxy with a fork of Go, maintained on the `release-branch.go1.27` branch. This page describes what the fork adds, for developers who build Lamassu or write a client that must talk to it.",{"_3839":2812,"_33145":2804,"_22633":63005,"_5":15597,"_29869":2804,"_3292":63006},[],"The fork exposes APIs that do not exist in the official Go distribution. Code that uses them compiles only with this toolchain, and a binary built with it must not be assumed to follow the Go compatibility promise for those APIs.",{"_3839":2813,"_33145":2804,"_22633":63008,"_5":15597,"_29869":62983,"_3292":63009},[],"**Composite ML-DSA in X.509.** The `x509` package gains `CompositePublicKey` and `CompositePrivateKey`, which implement `crypto.Signer`, and 15 `CompositeAlgorithm` values (for example `x509.MLDSA65_ECDSA_P384_SHA512`) that can generate keys, sign and verify. Certificates, certificate requests and revocation lists signed with these keys parse, marshal and verify like any other. PKCS#8 encoding of composite private keys is supported. The algorithms page lists the identifiers.",{"_3839":2814,"_33145":2804,"_22633":63011,"_5":15597,"_29869":62983,"_3292":63012},[],"**SLH-DSA in X.509.** The `x509.SLHDSA` public key algorithm and twelve `PureSLHDSA...` signature algorithms are available for parsing and verifying certificates and keys. The implementation is the vendored `circl` library of Cloudflare. It is the least tested part of the fork: it has no x509 tests of its own and no TLS support.",{"_3839":2815,"_33145":2804,"_22633":63014,"_5":15597,"_29869":62983,"_3292":63015},[],"**Related certificates (RFC 9763).** The fork provides `x509.CreateBoundCertificate`, which adds the `id-pe-relatedCert` extension (`1.3.6.1.5.5.7.1.36`) to a certificate, `x509.VerifyRelatedCertificate`, and the helpers to build and check the `relatedCertRequest` attribute of a certificate request (`1.2.840.113549.1.9.16.2.60`). `x509.CertificateRequest` gains an `ExtraAttributes` field for carrying it. Related certificates explains how Lamassu uses them.",{"_3839":2816,"_33145":2804,"_22633":63017,"_5":15597,"_29869":62983,"_3292":63018},[],"**Composite signature schemes in TLS.** The `tls` package adds 15 `SignatureScheme` constants, one per composite algorithm, advertised by default after the native ML-DSA schemes. They work only with TLS 1.3 and are tested with mutual authentication. See below for their code points.",{"_3839":2817,"_33145":2804,"_22633":63020,"_5":15597,"_29869":62987,"_3292":63021},[],"IANA has assigned no code points to the composite TLS signature schemes, so the fork uses the private-use range `0xFE00` to `0xFE0E`, in the order of the composite table: `0xFE00` is `MLDSA44-RSA2048-PSS-SHA256` and `0xFE0E` is `MLDSA65-Ed25519-SHA512`. A client or server built with a standard TLS library does not recognize them and will fall back to another scheme or fail the handshake. Interoperability is therefore limited to peers built from this fork, or to the native ML-DSA schemes (`0x0904` to `0x0906`) that standard Go 1.27 implements.",{"_3839":2818,"_33145":2804,"_22633":63023,"_5":15597,"_29869":62987,"_3292":63024},[],"The three variants that use RSA PKCS#1 v1.5 (`MLDSA44-RSA2048-PKCS15-SHA256`, `MLDSA65-RSA3072-PKCS15-SHA512` and `MLDSA65-RSA4096-PKCS15-SHA512`) are announced only in the `signature_algorithms_cert` extension, so they can appear in a certificate chain but a leaf certificate with such a key cannot sign the handshake.",{"_3839":2819,"_33145":2804,"_22633":63026,"_5":15597,"_29869":62987,"_3292":63027},[],"The key exchange is unchanged from upstream Go. Hybrid groups such as `X25519MLKEM768`, `SecP256r1MLKEM768`, `SecP384r1MLKEM1024` and the pure `MLKEM1024` are those of the Go 1.27 standard library.",{"_3839":2820,"_33145":2804,"_22633":63029,"_5":15597,"_29869":62991,"_3292":63030},[],"The following program creates a self-signed composite certificate and uses it as the server certificate of a TLS 1.3 configuration. Error handling is omitted.",{"_3839":2821,"_33145":2804,"_22633":63032,"_5":15597,"_29869":62991,"_3292":63033},[],"A composite key can also sign a message directly, with an optional context of at most 255 bytes:",{"_3839":2822,"_33145":2804,"_22633":63035,"_5":15597,"_29869":62995,"_3292":63036},[],"Earlier iterations of the fork explored Chameleon certificates (`draft-bonnell-lamps-chameleon-certs`) and a delta-certificate construction. They were removed because they are no longer pursued. The related-certificate mechanism was later restored on its own, following RFC 9763.",{"_3839":2823,"_33145":2804,"_22633":63038,"_5":15597,"_29869":62999,"_3292":63039},[],"The fork is built in CI by a workflow that runs the Go test suite and then publishes a multi-architecture image, `ghcr.io/lamassuiot/golang-pqc`, tagged `go1.27` and, for the `release-branch.go1.27` branch, `latest`. The image contains the toolchain under `/usr/local/go-pqc` with `GOROOT` pointing at it.",{"_3839":2824,"_33145":2804,"_22633":63041,"_5":15597,"_29869":62999,"_3292":63042},[],"Lamassu consumes the toolchain in two ways. The backend images (CA, KMS, VA, alerts, device manager, DMS manager and the monolithic build) use `ghcr.io/lamassuiot/golang-pqc:latest` as their builder image. The backend CI workflow installs the same toolchain through a custom setup action in place of `actions/setup-go`, and the backend requires `go 1.27.3` in its module file. Traefik is not built from the image: its `build.sh` script expects a compiled checkout of the fork in a sibling directory and produces the binary outside a container. See TLS front proxy with Traefik.",{"_3839":2825,"_33145":2804,"_22633":63044,"_5":15597,"_29869":62999,"_3292":63045},[],"<Card title=\"Algorithms\" description=\"The identifiers and parameter sets behind these constants.\" href=\"/docs/platform/pqc/algorithms\" />",{"_3839":2826,"_33145":2804,"_22633":63047,"_5":15597,"_29869":62999,"_3292":63048},[],"<Card title=\"TLS front proxy with Traefik\" description=\"How the fork is used to terminate device TLS.\" href=\"/docs/platform/pqc/tls-front-proxy\" />",{"_3839":2827,"_33145":2827,"_5":15996,"_3292":63050,"_33551":63051,"_22633":63052,"_29869":2827},"Keys and certificate authorities",[54324,55792,62321,62697],[],{"_3839":2828,"_33145":2827,"_22633":63054,"_5":15597,"_29869":2827,"_3292":63055},[],"Create post-quantum keys and CAs, sign with them and issue certificates, with the engine support, API values and constraints that apply.",{"_3839":2829,"_33145":2827,"_5":33548,"_22633":63057,"_29869":63058,"_3292":63059},[],"/docs/pr-preview/pr-58/platform/pqc/keys-and-cas#choose-a-crypto-engine-that-supports-the-algorithm","Choose a crypto engine that supports the algorithm",{"_3839":2830,"_33145":2827,"_5":33548,"_22633":63061,"_29869":63062,"_3292":63063},[],"/docs/pr-preview/pr-58/platform/pqc/keys-and-cas#create-a-key","Create a key",{"_3839":2831,"_33145":2827,"_5":33548,"_22633":63065,"_29869":63066,"_3292":63067},[],"/docs/pr-preview/pr-58/platform/pqc/keys-and-cas#create-a-certificate-authority","Create a certificate authority",{"_3839":2832,"_33145":2827,"_5":33548,"_22633":63069,"_29869":63070,"_3292":63071},[],"/docs/pr-preview/pr-58/platform/pqc/keys-and-cas#mixing-algorithms-in-a-hierarchy","Mixing algorithms in a hierarchy",{"_3839":2833,"_33145":2827,"_5":33548,"_22633":63073,"_29869":63074,"_3292":63075},[],"/docs/pr-preview/pr-58/platform/pqc/keys-and-cas#signing-and-verifying-with-a-key","Signing and verifying with a key",{"_3839":2834,"_33145":2827,"_5":33548,"_22633":63077,"_29869":63078,"_3292":63079},[],"/docs/pr-preview/pr-58/platform/pqc/keys-and-cas#constraints-to-keep-in-mind","Constraints to keep in mind",{"_3839":2835,"_33145":2827,"_22633":63081,"_5":15597,"_29869":2827,"_3292":63082},[],"The Lamassu backend treats post-quantum keys as one more key type of the Key Management Service (KMS). A certificate authority created with such a key signs certificates and revocation lists through the same paths as an RSA or ECDSA CA, because the fork of Go performs the signing. This page explains what to send to the API, which crypto engines can hold the keys and where the behaviour differs from classical keys. The backend must be built with the Go PQC toolchain.",{"_3839":2836,"_33145":2827,"_22633":63084,"_5":15597,"_29869":63058,"_3292":63085},[],"Not every crypto engine can create or hold post-quantum keys. Only the engines that run the cryptography in the Lamassu process can.",{"_3839":2837,"_33145":2827,"_22633":63087,"_5":15597,"_29869":63058,"_3292":63088},[],"Engine",{"_3839":2838,"_33145":2827,"_22633":63090,"_5":15597,"_29869":63058,"_3292":63091},[],"ML-DSA, SLH-DSA, Composite, Ed25519",{"_3839":2839,"_33145":2827,"_22633":63093,"_5":15597,"_29869":63058,"_3292":63094},[],"Filesystem",{"_3839":2840,"_33145":2827,"_22633":63096,"_5":15597,"_29869":63058,"_3292":63097},[],"Supported",{"_3839":2841,"_33145":2827,"_22633":63099,"_5":15597,"_29869":63058,"_3292":63100},[],"Software (golang)",{"_3839":2842,"_33145":2827,"_22633":63102,"_5":15597,"_29869":63058,"_3292":63097},[],{"_3839":2843,"_33145":2827,"_22633":63104,"_5":15597,"_29869":63058,"_3292":63105},[],"HashiCorp Vault KV2",{"_3839":2844,"_33145":2827,"_22633":63107,"_5":15597,"_29869":63058,"_3292":63108},[],"Not supported",{"_3839":2845,"_33145":2827,"_22633":63110,"_5":15597,"_29869":63058,"_3292":61229},[],{"_3839":2846,"_33145":2827,"_22633":63112,"_5":15597,"_29869":63058,"_3292":63108},[],{"_3839":2847,"_33145":2827,"_22633":63114,"_5":15597,"_29869":63058,"_3292":61233},[],{"_3839":2848,"_33145":2827,"_22633":63116,"_5":15597,"_29869":63058,"_3292":63108},[],{"_3839":2849,"_33145":2827,"_22633":63118,"_5":15597,"_29869":63058,"_3292":63119},[],"Azure Key Vault and Azure Secrets",{"_3839":2850,"_33145":2827,"_22633":63121,"_5":15597,"_29869":63058,"_3292":63108},[],{"_3839":2851,"_33145":2827,"_22633":63123,"_5":15597,"_29869":63058,"_3292":63124},[],"PKCS#11 (HSM)",{"_3839":2852,"_33145":2827,"_22633":63126,"_5":15597,"_29869":63058,"_3292":63108},[],{"_3839":2853,"_33145":2827,"_22633":63128,"_5":15597,"_29869":63058,"_3292":63129},[],"In practice, post-quantum keys currently require the filesystem engine, which has security level 1. Keys with a higher assurance level, in a hardware security module or a cloud KMS, are not available for these algorithms.",{"_3839":2854,"_33145":2827,"_22633":63131,"_5":15597,"_29869":63058,"_3292":63132},[],"The Vault KV2 and AWS Secrets Manager engines list the post-quantum key types among the types they support, so a request passes the compatibility check. The creation then fails with an `unsupported key type` error from the engine. Select a filesystem or software engine explicitly with `engine_id`.",{"_3839":2855,"_33145":2827,"_22633":63134,"_5":15597,"_29869":63062,"_3292":63135},[],"A KMS key is created with the algorithm and size described in Algorithms:",{"_3839":2856,"_33145":2827,"_22633":63137,"_5":15597,"_29869":63062,"_3292":63138},[],"Invalid parameters are rejected with an explicit message: an ML-DSA size other than 44, 65 or 87, an SLH-DSA identifier outside 1 to 12, a composite variant outside 1 to 15, or a composite variant that does not belong to the requested family. Importing a private key in PKCS#8 form detects the algorithm and the parameter set automatically; the import accepts ML-DSA, SLH-DSA, composite and Ed25519 keys.",{"_3839":2857,"_33145":2827,"_22633":63140,"_5":15597,"_29869":63066,"_3292":63141},[],"A CA with a post-quantum key uses the same request as any other CA, sent to `POST /api/ca/v1/cas`. Only `key_metadata` changes, where `bits` carries the parameter set. A root CA with ML-DSA-65:",{"_3839":2858,"_33145":2827,"_22633":63143,"_5":15597,"_29869":63066,"_3292":63144},[],"A root CA with a composite key of ML-DSA-44 and ECDSA P-256 uses `\"key_metadata\": { \"type\": \"Composite-ML-DSA-ECDSA\", \"bits\": 9 }`. Ed25519 uses `\"type\": \"Ed25519\", \"bits\": 256` and SLH-DSA uses `\"type\": \"SLH-DSA\", \"bits\": 1` to select SLH-DSA-SHA2-128s. Subordinate CAs are created the same way: the subordinate signs its own certificate request with the KMS key and the parent CA issues the certificate.",{"_3839":2859,"_33145":2827,"_22633":63146,"_5":15597,"_29869":63066,"_3292":63147},[],"Existing CAs can be imported with a post-quantum private key for ML-DSA and Ed25519. Importing a CA with an SLH-DSA or composite key is not supported.",{"_3839":2860,"_33145":2827,"_22633":63149,"_5":15597,"_29869":63070,"_3292":63150},[],"The backend places no restriction on which algorithm issues which. A CA with an ML-DSA key can issue certificates to RSA, ECDSA, Ed25519 and ML-DSA subjects, and an RSA or ECDSA CA can issue certificates to post-quantum subjects. The test suite covers the full ML-DSA and Ed25519 matrix through the API, and covers SLH-DSA and composite CAs and leaves at the certificate engine level. This makes it possible to introduce a post-quantum CA beneath a classical root, or the reverse, but a relying party must be able to verify every algorithm in the chain. In TLS, the signatures in the certificate chain are checked against the client's `signature_algorithms_cert` extension, so a chain signed with ML-DSA or a composite algorithm needs a client that announces it there.",{"_3839":2861,"_33145":2827,"_22633":63152,"_5":15597,"_29869":63074,"_3292":63153},[],"The KMS signing endpoint accepts new `signature_algorithm` values. The `message_type` field is ignored for all of them. The ML-DSA, SLH-DSA and Ed25519 values are \"pure\": the message is signed directly, without pre-hashing (not HashML-DSA, HashSLH-DSA or Ed25519ph). The composite values hash the message with the hash of the variant and sign a message representative that includes a fixed label and the optional context.",{"_3839":2862,"_33145":2827,"_22633":63155,"_5":15597,"_29869":63074,"_3292":62252},[],{"_3839":2863,"_33145":2827,"_22633":63157,"_5":15597,"_29869":63074,"_3292":63158},[],"`signature_algorithm`",{"_3839":2864,"_33145":2827,"_22633":63160,"_5":15597,"_29869":63074,"_3292":63161},[],"ML-DSA-44, -65, -87",{"_3839":2865,"_33145":2827,"_22633":63163,"_5":15597,"_29869":63074,"_3292":63164},[],"`MLDSA_44_PURE`, `MLDSA_65_PURE`, `MLDSA_87_PURE`",{"_3839":2866,"_33145":2827,"_22633":63166,"_5":15597,"_29869":63074,"_3292":62338},[],{"_3839":2867,"_33145":2827,"_22633":63168,"_5":15597,"_29869":63074,"_3292":63169},[],"`SLHDSA_PURE`",{"_3839":2868,"_33145":2827,"_22633":63171,"_5":15597,"_29869":63074,"_3292":63172},[],"Composite",{"_3839":2869,"_33145":2827,"_22633":63174,"_5":15597,"_29869":63074,"_3292":63175},[],"`COMPOSITE_MLDSA_RSA_PURE`, `COMPOSITE_MLDSA_ECDSA_PURE`, `COMPOSITE_MLDSA_ED25519_PURE`",{"_3839":2870,"_33145":2827,"_22633":63177,"_5":15597,"_29869":63074,"_3292":62346},[],{"_3839":2871,"_33145":2827,"_22633":63179,"_5":15597,"_29869":63074,"_3292":63180},[],"`Ed25519_PURE`",{"_3839":2872,"_33145":2827,"_22633":63182,"_5":15597,"_29869":63074,"_3292":63183},[],"The backend does not check that the algorithm matches the key; choose the value that corresponds to the key type. When a CA signs a certificate or a revocation list, the algorithm is selected automatically.",{"_3839":2873,"_33145":2827,"_22633":63185,"_5":15597,"_29869":63078,"_3292":63186},[],"Several parts of the platform do not yet handle post-quantum keys. They are collected in Known limitations; the ones that affect daily operation are these.",{"_3839":2874,"_33145":2827,"_22633":63188,"_5":15597,"_29869":63078,"_3292":63189},[],"Issuance profiles enforce key restrictions only for RSA and ECDSA, through `allow_rsa_keys` and `allow_ecdsa_keys`. A profile with enforcement enabled does not block post-quantum keys, and has no switch to allow or deny them.",{"_3839":2875,"_33145":2827,"_22633":63191,"_5":15597,"_29869":63078,"_3292":63192},[],"The key strength recorded for a certificate whose key is post-quantum or Ed25519 is computed only for RSA and ECDSA, so those certificates are stored with an unknown key type and size and a low strength.",{"_3839":2876,"_33145":2827,"_22633":63194,"_5":15597,"_29869":63078,"_3292":63195},[],"OCSP responses are signed with the `golang.org/x/crypto/ocsp` library, which supports only RSA and ECDSA signing keys. A CA with a post-quantum, Ed25519 or composite key is therefore not expected to be able to sign OCSP responses; CRLs are produced with the fork and are not affected by this limit, although they are not covered by tests.",{"_3839":2877,"_33145":2827,"_22633":63197,"_5":15597,"_29869":63078,"_3292":63198},[],"Server-side key generation in the DMS (the EST `serverkeygen` operation) generates only RSA and ECDSA keys.",{"_3839":2878,"_33145":2827,"_22633":63200,"_5":15597,"_29869":63078,"_3292":63201},[],"<Card title=\"Related certificates\" description=\"Bind a post-quantum certificate to an existing classical one.\" href=\"/docs/platform/pqc/related-certificates\" />",{"_3839":2879,"_33145":2827,"_22633":63203,"_5":15597,"_29869":63078,"_3292":63204},[],"<Card title=\"Dashboard\" description=\"Create the same objects from the web interface.\" href=\"/docs/platform/pqc/dashboard\" />",{"_3839":2880,"_33145":2880,"_5":15996,"_3292":63206,"_33551":63207,"_22633":63209,"_29869":2880},"Known limitations",[54324,55792,62321,63208],"Reference",[],{"_3839":2881,"_33145":2880,"_22633":63211,"_5":15597,"_29869":2880,"_3292":63212},[],"What is incomplete, non-standard or unverified in Lamassu's post-quantum support, grouped by component.",{"_3839":2882,"_33145":2880,"_5":33548,"_22633":63214,"_29869":63215,"_3292":63216},[],"/docs/pr-preview/pr-58/platform/pqc/limitations#standards-and-interoperability","Standards and interoperability",{"_3839":2883,"_33145":2880,"_5":33548,"_22633":63218,"_29869":63219,"_3292":63220},[],"/docs/pr-preview/pr-58/platform/pqc/limitations#keys-and-engines","Keys and engines",{"_3839":2884,"_33145":2880,"_5":33548,"_22633":63222,"_29869":63223,"_3292":63224},[],"/docs/pr-preview/pr-58/platform/pqc/limitations#certificate-authority-and-validation","Certificate authority and validation",{"_3839":2885,"_33145":2880,"_5":33548,"_22633":63226,"_29869":63227,"_3292":62695},[],"/docs/pr-preview/pr-58/platform/pqc/limitations#dashboard",{"_3839":2886,"_33145":2880,"_5":33548,"_22633":63229,"_29869":63230,"_3292":63231},[],"/docs/pr-preview/pr-58/platform/pqc/limitations#build-and-deployment","Build and deployment",{"_3839":2887,"_33145":2880,"_22633":63233,"_5":15597,"_29869":2880,"_3292":63234},[],"This page collects the limits of the current implementation so they can be weighed before planning a deployment. Each one has been observed in the code or the tests of the branches described in this section.",{"_3839":2888,"_33145":2880,"_22633":63236,"_5":15597,"_29869":63215,"_3292":63237},[],"Composite certificates were implemented and tested against draft 19 of the IETF composite signatures specification, which has since been published as RFC 10073; the implementation has not been compared with the final text. Three of its algorithms (the two Brainpool variants and Ed448) are not implemented. The composite signature schemes in TLS use private-use code points in `0xFE00` to `0xFE0E` and no published draft or version is identified in the code, so they interoperate only with peers built from the same Go fork. Composite RSA-PKCS#1 v1.5 variants cannot authenticate a TLS handshake. SLH-DSA has no TLS signature scheme. The related-certificate request attribute has not been checked against other implementations of RFC 9763.",{"_3839":2889,"_33145":2880,"_22633":63239,"_5":15597,"_29869":63219,"_3292":63240},[],"Post-quantum, composite and Ed25519 keys work only with the filesystem and software engines. The Vault KV2 and AWS Secrets Manager engines announce support and then fail at creation, and AWS KMS, Azure and PKCS#11 do not support them. There is therefore no hardware-backed or cloud-KMS-backed post-quantum key. Some engine error messages are copied from other engines and name the wrong one.",{"_3839":2890,"_33145":2880,"_22633":63242,"_5":15597,"_29869":63219,"_3292":63243},[],"The `CryptoEngine` interface gained methods to create and import each new key type. Engines developed outside the Lamassu repository must implement them.",{"_3839":2891,"_33145":2880,"_22633":63245,"_5":15597,"_29869":63223,"_3292":63246},[],"OCSP responses cannot be signed by a CA with a post-quantum, Ed25519 or composite key, because the signing library supports only RSA and ECDSA. CRL generation uses the fork's signing and is expected to work, but neither CRL nor OCSP has tests with these keys.",{"_3839":2892,"_33145":2880,"_22633":63248,"_5":15597,"_29869":63223,"_3292":63249},[],"Issuance profiles cannot allow or deny post-quantum algorithms; their enforcement applies only to RSA and ECDSA. The key strength of an issued certificate is computed only for RSA and ECDSA, so other certificates are stored with unknown type and size and low strength. Importing an existing CA with an SLH-DSA or composite key is not supported.",{"_3839":2893,"_33145":2880,"_22633":63251,"_5":15597,"_29869":63223,"_3292":63252},[],"The DMS can generate keys on the server only for RSA and ECDSA, so `serverkeygen` cannot return a post-quantum key. The enrollment flows through EST and the device manager have no tests with post-quantum keys.",{"_3839":2894,"_33145":2880,"_22633":63254,"_5":15597,"_29869":63223,"_3292":63255},[],"The backend does not evaluate the related-certificate extension. It only issues it.",{"_3839":2895,"_33145":2880,"_22633":63257,"_5":15597,"_29869":63227,"_3292":63258},[],"The in-browser SLH-DSA key generator maps parameter set identifiers differently from the rest of the interface, as described in Dashboard. Key type names are not uniform between screens, and the interface has no experimental notice and no translation.",{"_3839":2896,"_33145":2880,"_22633":63260,"_5":15597,"_29869":63230,"_3292":63261},[],"Everything depends on forks of Go and Traefik that are not upstream, and the proxy image has a mutable tag. The backend's OpenAPI specification for the KMS still lists only RSA, ECDSA and Ed25519 and does not reflect the new key types.",{"_3839":2897,"_33145":2880,"_22633":63263,"_5":15597,"_29869":63230,"_3292":63264},[],"The Helm chart uses fixed resource names, supports one release per namespace and sends traffic from Traefik to Envoy without verifying certificates. The post-quantum certificates created by the installer are valid for 365 days and are not renewed. The installer needs a Linux host and runs a Helm install, not an upgrade.",{"_3839":2898,"_33145":2880,"_22633":63266,"_5":15597,"_29869":63230,"_3292":63267},[],"<Card title=\"Post-quantum cryptography overview\" description=\"Return to the summary of the section.\" href=\"/docs/platform/pqc/overview\" />",{"_3839":2899,"_33145":2899,"_5":15996,"_3292":63269,"_33551":63270,"_22633":63271,"_29869":2899},"Post-quantum cryptography overview",[54324,55792,62321],[],{"_3839":2900,"_33145":2899,"_22633":63273,"_5":15597,"_29869":2899,"_3292":63274},[],"What post-quantum (PQC) support Lamassu adds to keys, certificate authorities, device TLS and deployment, and how its pieces fit together.",{"_3839":2901,"_33145":2899,"_5":33548,"_22633":63276,"_29869":63277,"_3292":63278},[],"/docs/pr-preview/pr-58/platform/pqc/overview#why-it-matters-for-device-fleets","Why it matters for device fleets",{"_3839":2902,"_33145":2899,"_5":33548,"_22633":63280,"_29869":63281,"_3292":63282},[],"/docs/pr-preview/pr-58/platform/pqc/overview#three-families-of-algorithms","Three families of algorithms",{"_3839":2903,"_33145":2899,"_5":33548,"_22633":63284,"_29869":63285,"_3292":63286},[],"/docs/pr-preview/pr-58/platform/pqc/overview#how-the-pieces-fit","How the pieces fit",{"_3839":2904,"_33145":2899,"_5":33548,"_22633":63288,"_29869":63289,"_3292":63290},[],"/docs/pr-preview/pr-58/platform/pqc/overview#where-to-read-next","Where to read next",{"_3839":2905,"_33145":2899,"_22633":63292,"_5":15597,"_29869":2899,"_3292":63293},[],"Lamassu can create keys, certificate authorities (CAs) and certificates that use post-quantum signature algorithms, and it can serve and verify them over TLS. The work spans five codebases that depend on one another: a fork of the Go toolchain that implements the algorithms, the Lamassu backend, the web dashboard, a fork of the Traefik proxy that terminates TLS for devices, and the Helm chart that deploys all of it together.",{"_3839":2906,"_33145":2899,"_22633":63295,"_5":15597,"_29869":2899,"_3292":63296},[],"PQC support lives in development branches and in forks of Go and Traefik, not in the upstream projects or in the standard Lamassu images. The composite TLS signature schemes use private-use code points that no other TLS stack understands, and the composite certificate format follows an IETF draft that can still change. Plan pilots and laboratory deployments, not production fleets. Known limitations lists what is incomplete.",{"_3839":2907,"_33145":2899,"_22633":63298,"_5":15597,"_29869":63277,"_3292":63299},[],"Certificates issued to devices often live for years, and the devices that hold them are hard to replace. A signature algorithm that is broken by a future quantum computer would force a fleet-wide re-enrollment. Issuing devices a certificate signed with a post-quantum or composite algorithm today, and serving them a TLS endpoint that accepts it, lets a fleet be validated against that risk before it becomes urgent. Signatures are not exposed to \"harvest now, decrypt later\" attacks the way a key exchange is, so the urgency is about the lifetime of certificates and devices, not about recorded traffic.",{"_3839":2908,"_33145":2899,"_22633":63301,"_5":15597,"_29869":63281,"_3292":63302},[],"Lamassu groups signature algorithms in three families, the same labels the dashboard shows.",{"_3839":2909,"_33145":2899,"_22633":63304,"_5":15597,"_29869":63281,"_3292":63305},[],"Label",{"_3839":2910,"_33145":2899,"_22633":63307,"_5":15597,"_29869":63281,"_3292":62535},[],{"_3839":2911,"_33145":2899,"_22633":63309,"_5":15597,"_29869":63281,"_3292":62319},[],{"_3839":2912,"_33145":2899,"_22633":63311,"_5":15597,"_29869":63281,"_3292":63312},[],"**T**",{"_3839":2913,"_33145":2899,"_22633":63314,"_5":15597,"_29869":63281,"_3292":63315},[],"Traditional",{"_3839":2914,"_33145":2899,"_22633":63317,"_5":15597,"_29869":63281,"_3292":63318},[],"RSA, ECDSA, Ed25519",{"_3839":2915,"_33145":2899,"_22633":63320,"_5":15597,"_29869":63281,"_3292":63321},[],"**PQ**",{"_3839":2916,"_33145":2899,"_22633":63323,"_5":15597,"_29869":63281,"_3292":63324},[],"Pure post-quantum",{"_3839":2917,"_33145":2899,"_22633":63326,"_5":15597,"_29869":63281,"_3292":63327},[],"ML-DSA, SLH-DSA",{"_3839":2918,"_33145":2899,"_22633":63329,"_5":15597,"_29869":63281,"_3292":63330},[],"**PQ/T**",{"_3839":2919,"_33145":2899,"_22633":63332,"_5":15597,"_29869":63281,"_3292":63333},[],"Hybrid (composite)",{"_3839":2920,"_33145":2899,"_22633":63335,"_5":15597,"_29869":63281,"_3292":63336},[],"ML-DSA combined with RSA, ECDSA or Ed25519 in a single key and a single signature",{"_3839":2921,"_33145":2899,"_22633":63338,"_5":15597,"_29869":63281,"_3292":63339},[],"A composite signature is valid only if both of its components verify. Its unforgeability is intended to hold as long as at least one of the two algorithms remains unbroken, provided the relying party requires the composite and does not fall back to a classical certificate. In the key exchange, `PQ/T` means a hybrid group that combines a classical and an ML-KEM exchange, and `PQ` means pure ML-KEM. Algorithms describes each one and the parameter sets Lamassu accepts.",{"_3839":2922,"_33145":2899,"_22633":63341,"_5":15597,"_29869":63285,"_3292":63342},[],"The Go fork is the foundation: the backend and Traefik are compiled with it, because the standard Go toolchain does not provide the composite and SLH-DSA certificate support. The backend creates and holds the keys, issues certificates and signs revocation data. The dashboard drives the same REST API. Devices reach the platform through Traefik, which negotiates post-quantum authentication and key exchange with the device and then forwards the request to Envoy Gateway over ordinary TLS. Post-quantum protection therefore applies only to the hop between the device and Traefik.",{"_3839":2923,"_33145":2899,"_22633":63344,"_5":15597,"_29869":63289,"_3292":63345},[],"Read Algorithms first to learn what is supported and how parameter sets are written in API requests. Developers writing a device client should continue with Go PQC toolchain. Administrators who want to create a post-quantum CA follow Keys and certificate authorities, and those who deploy the platform go to Deployment with the Helm chart.",{"_3839":2924,"_33145":2899,"_22633":63347,"_5":15597,"_29869":63289,"_3292":63348},[],"<Card title=\"Algorithms\" description=\"ML-DSA, SLH-DSA and the 15 composite algorithms, with their parameter sets.\" href=\"/docs/platform/pqc/algorithms\" />",{"_3839":2925,"_33145":2899,"_22633":63350,"_5":15597,"_29869":63289,"_3292":63351},[],"<Card title=\"Keys and certificate authorities\" description=\"Create post-quantum keys and CAs and issue certificates through the API.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_3839":2926,"_33145":2899,"_22633":63353,"_5":15597,"_29869":63289,"_3292":63354},[],"<Card title=\"Deployment with the Helm chart\" description=\"Install the platform with a Traefik front proxy that serves PQC certificates.\" href=\"/docs/platform/pqc/deployment\" />",{"_3839":2927,"_33145":2927,"_5":15996,"_3292":62717,"_33551":63356,"_22633":63357,"_29869":2927},[54324,55792,62321,62697],[],{"_3839":2928,"_33145":2927,"_22633":63359,"_5":15597,"_29869":2927,"_3292":63360},[],"Bind a certificate with a post-quantum key to an existing classical certificate of the same device, following RFC 9763, and how Lamassu issues and checks them.",{"_3839":2929,"_33145":2927,"_5":33548,"_22633":63362,"_29869":63363,"_3292":63364},[],"/docs/pr-preview/pr-58/platform/pqc/related-certificates#how-the-request-works","How the request works",{"_3839":2930,"_33145":2927,"_5":33548,"_22633":63366,"_29869":63367,"_3292":63368},[],"/docs/pr-preview/pr-58/platform/pqc/related-certificates#locations-the-ca-may-fetch-from","Locations the CA may fetch from",{"_3839":2931,"_33145":2927,"_5":33548,"_22633":63370,"_29869":63371,"_3292":63372},[],"/docs/pr-preview/pr-58/platform/pqc/related-certificates#configure-an-issuance-profile","Configure an issuance profile",{"_3839":2932,"_33145":2927,"_5":33548,"_22633":63374,"_29869":63375,"_3292":63376},[],"/docs/pr-preview/pr-58/platform/pqc/related-certificates#what-the-issued-certificate-must-satisfy","What the issued certificate must satisfy",{"_3839":2933,"_33145":2927,"_5":33548,"_22633":63378,"_29869":63379,"_3292":63380},[],"/docs/pr-preview/pr-58/platform/pqc/related-certificates#from-the-dashboard","From the dashboard",{"_3839":2934,"_33145":2927,"_22633":63382,"_5":15597,"_29869":2927,"_3292":63383},[],"A fleet that is migrating to post-quantum algorithms usually holds two certificates per device for a while: the classical one already in use and a new one with a post-quantum key. RFC 9763 defines a way to link them. The new certificate carries the `id-pe-relatedCert` extension (`1.3.6.1.5.5.7.1.36`), which holds a hash of the classical certificate, so a relying party can see that both identify the same entity. Lamassu implements the issuing side of this mechanism.",{"_3839":2935,"_33145":2927,"_22633":63385,"_5":15597,"_29869":63363,"_3292":63386},[],"The device asks for the bound certificate with an ordinary PKCS#10 certificate request that carries one extra attribute, `relatedCertRequest` (`1.2.840.113549.1.9.16.2.60`). The attribute identifies the existing certificate by issuer and serial number, states the time of the request, gives the location from which the certificate can be downloaded and carries a signature made with the private key of that existing certificate. The signature covers the issuer, the serial number and the request time, not the location, and shows that the requester controls the existing key; the key of the new certificate is proven by the signature of the certificate request itself. Lamassu accepts a list of locations, as in the ASN.1 module of the RFC, and tries them in order.",{"_3839":2936,"_33145":2927,"_22633":63388,"_5":15597,"_29869":63363,"_3292":63389},[],"When the CA service receives such a request it follows these steps:",{"_3839":2937,"_33145":2927,"_22633":63391,"_5":15597,"_29869":63363,"_3292":63392},[],"It checks that the issuance profile in use enables related certificates, and rejects the request otherwise.",{"_3839":2938,"_33145":2927,"_22633":63394,"_5":15597,"_29869":63363,"_3292":63395},[],"It reads the locations in the attribute in order and downloads the first certificate it can retrieve.",{"_3839":2939,"_33145":2927,"_22633":63397,"_5":15597,"_29869":63363,"_3292":63398},[],"It verifies that the issuer and serial number match, that the request time is within the allowed age, and that the signature is valid with the downloaded certificate's key.",{"_3839":2940,"_33145":2927,"_22633":63400,"_5":15597,"_29869":63363,"_3292":63401},[],"It issues the new certificate with the related certificate extension added.",{"_3839":2941,"_33145":2927,"_22633":63403,"_5":15597,"_29869":63363,"_3292":63404},[],"A request without the attribute is processed as usual, whether or not the profile enables the feature.",{"_3839":2942,"_33145":2927,"_22633":63406,"_5":15597,"_29869":63367,"_3292":63407},[],"A location is either a `data:` URI or an `http` or `https` URL. A `data:` URI must be base64-encoded and contains a PKCS#7 structure whose first certificate is the related one; it needs no network access and is always accepted when the feature is enabled. A URL is retrieved only if its host appears in the profile's list of allowed hosts. The CA does not follow redirects, applies a ten-second timeout and rejects responses larger than 1 MiB.",{"_3839":2943,"_33145":2927,"_22633":63409,"_5":15597,"_29869":63367,"_3292":63410},[],"Because the server performs the download, whoever can define an issuance profile decides which hosts the CA is allowed to contact. Restrict that permission accordingly and list only internal certificate repositories.",{"_3839":2944,"_33145":2927,"_22633":63412,"_5":15597,"_29869":63371,"_3292":63413},[],"The feature is configured in the `related_certificate` object of the issuance profile, which is stored with its own database columns:",{"_3839":2945,"_33145":2927,"_22633":63415,"_5":15597,"_29869":63371,"_3292":63416},[],"Field",{"_3839":2946,"_33145":2927,"_22633":63418,"_5":15597,"_29869":63371,"_3292":58476},[],{"_3839":2947,"_33145":2927,"_22633":63420,"_5":15597,"_29869":63371,"_3292":54711},[],{"_3839":2948,"_33145":2927,"_22633":63422,"_5":15597,"_29869":63371,"_3292":58482},[],{"_3839":2949,"_33145":2927,"_22633":63424,"_5":15597,"_29869":63371,"_3292":63425},[],"`enabled`",{"_3839":2950,"_33145":2927,"_22633":63427,"_5":15597,"_29869":63371,"_3292":21299},[],{"_3839":2951,"_33145":2927,"_22633":63429,"_5":15597,"_29869":63371,"_3292":62841},[],{"_3839":2952,"_33145":2927,"_22633":63431,"_5":15597,"_29869":63371,"_3292":63432},[],"When `false`, a request that carries the attribute is rejected.",{"_3839":2953,"_33145":2927,"_22633":63434,"_5":15597,"_29869":63371,"_3292":63435},[],"`allowed_hosts`",{"_3839":2954,"_33145":2927,"_22633":63437,"_5":15597,"_29869":63371,"_3292":63438},[],"list of strings",{"_3839":2955,"_33145":2927,"_22633":63440,"_5":15597,"_29869":63371,"_3292":20582},[],{"_3839":2956,"_33145":2927,"_22633":63442,"_5":15597,"_29869":63371,"_3292":63443},[],"Hosts from which `http` and `https` locations may be downloaded.",{"_3839":2957,"_33145":2927,"_22633":63445,"_5":15597,"_29869":63371,"_3292":63446},[],"`max_age`",{"_3839":2958,"_33145":2927,"_22633":63448,"_5":15597,"_29869":63371,"_3292":6267},[],{"_3839":2959,"_33145":2927,"_22633":63450,"_5":15597,"_29869":63371,"_3292":63451},[],"`5m`",{"_3839":2960,"_33145":2927,"_22633":63453,"_5":15597,"_29869":63371,"_3292":63454},[],"Maximum difference between the request time in the attribute and the time of issuance.",{"_3839":2961,"_33145":2927,"_22633":63456,"_5":15597,"_29869":63375,"_3292":63457},[],"The fork refuses to bind a certificate unless the new one is compatible with the related one. Neither certificate may be a CA. The related certificate must be valid at the time of issuance. The key usages and extended key usages requested for the new certificate must be a subset of those of the related certificate. Verification later compares only the hash, so a relying party that checks the link learns that the issuing CA linked the new certificate to that specific certificate, not that the related certificate is still valid.",{"_3839":2962,"_33145":2927,"_22633":63459,"_5":15597,"_29869":63379,"_3292":63460},[],"The dashboard exposes the feature in two places. The issuance profile form has a *Related Certificates* section with a switch, the allowed hosts and the maximum age. When issuing a certificate from a CA with a browser-generated key and a profile that enables the feature, the form offers *Bind to a related certificate*: the user supplies the existing certificate, or its issuer and serial number, signs the data shown with the existing key outside the browser, and pastes the signature. Certificate and CA details show a *Related Certificate* row with the hash algorithm and value. See Dashboard.",{"_3839":2963,"_33145":2927,"_22633":63462,"_5":15597,"_29869":63379,"_3292":63463},[],"The bound certificate is created by the fork's `CreateBoundCertificate`, whose tests cover an ML-DSA key bound to RSA, ECDSA and Ed25519 certificates. The tests do not use composite keys. Only the issuing side is implemented in Lamassu: the platform does not evaluate the extension when it validates certificates.",{"_3839":2964,"_33145":2927,"_22633":63465,"_5":15597,"_29869":63379,"_3292":63466},[],"<Card title=\"Keys and certificate authorities\" description=\"Create the post-quantum CA that issues the bound certificate.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_3839":2965,"_33145":2927,"_22633":63468,"_5":15597,"_29869":63379,"_3292":63469},[],"<Card title=\"Known limitations\" description=\"What is not covered yet.\" href=\"/docs/platform/pqc/limitations\" />",{"_3839":2966,"_33145":2966,"_5":15996,"_3292":63471,"_33551":63472,"_22633":63473,"_29869":2966},"TLS front proxy with Traefik",[54324,55792,62321,54325],[],{"_3839":2967,"_33145":2966,"_22633":63475,"_5":15597,"_29869":2966,"_3292":63476},[],"The Traefik fork that terminates device TLS with classical and post-quantum certificates for the same host, how it picks a certificate and how it is built.",{"_3839":2968,"_33145":2966,"_5":33548,"_22633":63478,"_29869":63479,"_3292":63480},[],"/docs/pr-preview/pr-58/platform/pqc/tls-front-proxy#several-certificates-for-the-same-host","Several certificates for the same host",{"_3839":2969,"_33145":2966,"_5":33548,"_22633":63482,"_29869":63483,"_3292":63484},[],"/docs/pr-preview/pr-58/platform/pqc/tls-front-proxy#tls-options-on-gateway-api-listeners","TLS options on Gateway API listeners",{"_3839":2970,"_33145":2966,"_5":33548,"_22633":63486,"_29869":63487,"_3292":63488},[],"/docs/pr-preview/pr-58/platform/pqc/tls-front-proxy#mutual-tls","Mutual TLS",{"_3839":2971,"_33145":2966,"_5":33548,"_22633":63490,"_29869":63491,"_3292":63492},[],"/docs/pr-preview/pr-58/platform/pqc/tls-front-proxy#building-the-proxy","Building the proxy",{"_3839":2972,"_33145":2966,"_22633":63494,"_5":15597,"_29869":2966,"_3292":63495},[],"Devices connect to Lamassu over TLS, and EST enrollment relies on mutual TLS. To accept a post-quantum or composite certificate on that connection, the TLS endpoint must be built with the Go PQC toolchain. Lamassu does this with a fork of Traefik, based on Traefik 3.7.15, that sits in front of Envoy Gateway. The fork adds two behaviours: it can serve several certificates for the same host and chooses among them per client, and it lets a Gateway API listener reference a Traefik TLS option.",{"_3839":2973,"_33145":2966,"_22633":63497,"_5":15597,"_29869":63479,"_3292":63498},[],"Upstream Traefik keeps one certificate per set of names. If a classical ECDSA certificate and an ML-DSA certificate exist for `lab.example.com`, only the first is kept. The fork stores every distinct certificate (duplicates are detected by comparing the leaf certificate) and chooses one for each handshake.",{"_3839":2974,"_33145":2966,"_22633":63500,"_5":15597,"_29869":63479,"_3292":63501},[],"The choice follows the signature algorithms the client announces:",{"_3839":2975,"_33145":2966,"_22633":63503,"_5":15597,"_29869":63479,"_3292":63504},[],"The server name from the client is normalized and the certificates whose names match it are collected, with exact names ahead of wildcards. A common-name-only certificate still matches.",{"_3839":2976,"_33145":2966,"_22633":63506,"_5":15597,"_29869":63479,"_3292":63507},[],"If no certificate matches, the connection is closed in strict-SNI mode, or the default certificate is served.",{"_3839":2977,"_33145":2966,"_22633":63509,"_5":15597,"_29869":63479,"_3292":63510},[],"If exactly one certificate matches, it is served without further checks.",{"_3839":2978,"_33145":2966,"_22633":63512,"_5":15597,"_29869":63479,"_3292":63513},[],"Otherwise the proxy takes the client's signature schemes in the order the client sent them, and for each scheme returns the first certificate whose key the scheme, the TLS version and the key type allow. This matches the leaf key against `signature_algorithms`, the schemes the client accepts for the handshake signature; the signatures in the rest of the chain are a separate check against `signature_algorithms_cert`.",{"_3839":2979,"_33145":2966,"_22633":63515,"_5":15597,"_29869":63479,"_3292":63516},[],"If the client announces no scheme, the first compatible certificate is returned. If none is compatible, the first candidate is returned and the handshake fails with the underlying error.",{"_3839":2980,"_33145":2966,"_22633":63518,"_5":15597,"_29869":63479,"_3292":63519},[],"The client's order of preference prevails, so a client that lists ML-DSA first receives the post-quantum certificate and a client that lists ECDSA first receives the classical one, even if it also supports ML-DSA. A client with no post-quantum support never announces those schemes and receives the classical certificate. TLS 1.2 never selects ML-DSA or composite certificates. The server cannot be configured with its own order of preference.",{"_3839":2981,"_33145":2966,"_22633":63521,"_5":15597,"_29869":63483,"_3292":63522},[],"Traefik reads its Gateway API configuration from Kubernetes. The fork reads the listener option `traefik.io/tls-options`, whose value names the TLS option to apply to that listener: either `default`, or a qualified name such as `traefik-system-pqc@kubernetescrd`. This works for HTTPS listeners and for TLS listeners in `Terminate` mode that serve a `TLSRoute`. It is ignored in passthrough mode.",{"_3839":2982,"_33145":2966,"_22633":63524,"_5":15597,"_29869":63483,"_3292":63525},[],"A TLS option is where the supported key exchange groups and the client authentication mode are set. When several listeners share a parent router and name different options, the proxy logs a warning and uses isolated defaults for each. Without the fork, Traefik ignores the annotation, applies its own defaults and the settings cannot be controlled; devices that need mutual TLS then fail.",{"_3839":2983,"_33145":2966,"_22633":63527,"_5":15597,"_29869":63483,"_3292":63528},[],"The fork also adds `mlkem1024` to the group names accepted in `curvePreferences`, next to the hybrid groups that Traefik already maps.",{"_3839":2984,"_33145":2966,"_22633":63530,"_5":15597,"_29869":63487,"_3292":63531},[],"Client authentication is the standard Traefik mechanism, configured in the TLS option. With `RequireAndVerifyClientCert` and a client CA file the proxy validates the chain, and the verification of the client signature is done by the TLS stack of the Go fork, which has been tested with composite client certificates in a TLS 1.3 handshake. With `RequestClientCert`, which the Lamassu chart sets in its default option, the proxy checks that the client holds the key of the certificate it presents but does not validate the chain; the decision is delegated to the backend, which receives the certificate in a header (see Deployment with the Helm chart). No Traefik test covers post-quantum mutual TLS, and a client chain signed by a composite or post-quantum CA depends on the x509 code of the fork.",{"_3839":2985,"_33145":2966,"_22633":63533,"_5":15597,"_29869":63491,"_3292":63534},[],"The fork is not built from the Go image. The `build.sh` script requires an already compiled checkout of the Go fork, by default in `../go`, and checks that it is the fork before it forces `GOROOT` and `GOTOOLCHAIN=local`. It compiles the binary with `CGO_ENABLED=0`, builds the web UI unless `SKIP_WEBUI=1`, and packages the binary into an Alpine image with `docker buildx`. The default image is `ghcr.io/lamassuiot/traefik:pqc-3.7.15`.",{"_3839":2986,"_33145":2966,"_22633":63536,"_5":15597,"_29869":63491,"_3292":63537},[],"Variable",{"_3839":2987,"_33145":2966,"_22633":63539,"_5":15597,"_29869":63491,"_3292":54714},[],{"_3839":2988,"_33145":2966,"_22633":63541,"_5":15597,"_29869":63491,"_3292":63542},[],"`GO_FORK_ROOT`",{"_3839":2989,"_33145":2966,"_22633":63544,"_5":15597,"_29869":63491,"_3292":63545},[],"Location of the compiled Go fork.",{"_3839":2990,"_33145":2966,"_22633":63547,"_5":15597,"_29869":63491,"_3292":63548},[],"`PLATFORMS`",{"_3839":2991,"_33145":2966,"_22633":63550,"_5":15597,"_29869":63491,"_3292":63551},[],"Target platforms; the default is `linux/amd64`.",{"_3839":2992,"_33145":2966,"_22633":63553,"_5":15597,"_29869":63491,"_3292":63554},[],"`SKIP_WEBUI`",{"_3839":2993,"_33145":2966,"_22633":63556,"_5":15597,"_29869":63491,"_3292":63557},[],"Skip building the web UI when set to `1`.",{"_3839":2994,"_33145":2966,"_22633":63559,"_5":15597,"_29869":63491,"_3292":63560},[],"`IMAGE`, `PUSH`",{"_3839":2995,"_33145":2966,"_22633":63562,"_5":15597,"_29869":63491,"_3292":63563},[],"Name of the image and whether to push it. Multi-platform builds require `PUSH=1`.",{"_3839":2996,"_33145":2966,"_22633":63565,"_5":15597,"_29869":63491,"_3292":63566},[],"The `pqc-*` tags are mutable and have been rebuilt in place, so pin the digest in production-like environments.",{"_3839":2997,"_33145":2966,"_22633":63568,"_5":15597,"_29869":63491,"_3292":63569},[],"The selection tests of the fork use pure ML-DSA-65 together with ECDSA P-256. Selecting a composite certificate depends on the fork's TLS stack knowing the composite key, which it does, but the proxy has no test for it.",{"_3839":2998,"_33145":2966,"_22633":63571,"_5":15597,"_29869":63491,"_3292":63572},[],"<Card title=\"Deployment with the Helm chart\" description=\"Install the proxy in front of Envoy Gateway with the chart.\" href=\"/docs/platform/pqc/deployment\" />",{"_3839":2999,"_33145":2966,"_22633":63574,"_5":15597,"_29869":63491,"_3292":63575},[],"<Card title=\"Known limitations\" description=\"Interoperability and operational caveats.\" href=\"/docs/platform/pqc/limitations\" />",{"_3839":3000,"_33145":3000,"_5":15996,"_3292":63577,"_33551":63578,"_22633":63579,"_29869":3000},"Security",[54324],[],{"_3839":3001,"_33145":3000,"_22633":63581,"_5":15597,"_29869":3000,"_3292":63582},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3839":3002,"_33145":3000,"_5":33548,"_22633":63584,"_29869":63585,"_3292":63586},[],"/docs/pr-preview/pr-58/security#report-a-vulnerability","Report a vulnerability",{"_3839":3003,"_33145":3000,"_5":33548,"_22633":63588,"_29869":63589,"_3292":63590},[],"/docs/pr-preview/pr-58/security#what-to-include-in-a-report","What to include in a report",{"_3839":3004,"_33145":3000,"_5":33548,"_22633":63592,"_29869":63593,"_3292":63594},[],"/docs/pr-preview/pr-58/security#supported-versions","Supported versions",{"_3839":3005,"_33145":3000,"_5":33548,"_22633":63596,"_29869":63597,"_3292":63598},[],"/docs/pr-preview/pr-58/security#responsible-disclosure","Responsible disclosure",{"_3839":3006,"_33145":3000,"_22633":63600,"_5":15597,"_29869":3000,"_3292":63601},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3839":3007,"_33145":3000,"_22633":63603,"_5":15597,"_29869":63585,"_3292":63604},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3839":3008,"_33145":3000,"_22633":63606,"_5":15597,"_29869":63585,"_3292":63607},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3839":3009,"_33145":3000,"_22633":63609,"_5":15597,"_29869":63585,"_3292":16319},[],{"_3839":3010,"_33145":3000,"_22633":63611,"_5":15597,"_29869":63585,"_3292":16255},[],{"_3839":3011,"_33145":3000,"_22633":63613,"_5":15597,"_29869":63585,"_3292":16312},[],{"_3839":3012,"_33145":3000,"_22633":63615,"_5":15597,"_29869":63585,"_3292":63616},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3839":3013,"_33145":3000,"_22633":63618,"_5":15597,"_29869":63585,"_3292":63619},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3839":3014,"_33145":3000,"_22633":63621,"_5":15597,"_29869":63589,"_3292":63622},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3839":3015,"_33145":3000,"_22633":63624,"_5":15597,"_29869":63589,"_3292":63625},[],"Do not include in the report:",{"_3839":3016,"_33145":3000,"_22633":63627,"_5":15597,"_29869":63589,"_3292":63628},[],"Credentials, tokens, or private keys",{"_3839":3017,"_33145":3000,"_22633":63630,"_5":15597,"_29869":63589,"_3292":63631},[],"Customer data or customer-identifiable information",{"_3839":3018,"_33145":3000,"_22633":63633,"_5":15597,"_29869":63589,"_3292":63634},[],"Confidential architecture or internal infrastructure details",{"_3839":3019,"_33145":3000,"_22633":63636,"_5":15597,"_29869":63593,"_3292":63637},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3839":3020,"_33145":3000,"_22633":63639,"_5":15597,"_29869":63593,"_3292":63640},[],"For upgrade guidance, see Upgrades.",{"_3839":3021,"_33145":3000,"_22633":63642,"_5":15597,"_29869":63597,"_3292":63643},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3839":3022,"_33145":3000,"_22633":63645,"_5":15597,"_29869":63597,"_3292":63646},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3839":3023,"_33145":3000,"_22633":63648,"_5":15597,"_29869":63597,"_3292":63649},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3839":3024,"_33145":3000,"_22633":63651,"_5":15597,"_29869":63597,"_3292":63652},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3839":3025,"_33145":3000,"_22633":63654,"_5":15597,"_29869":63597,"_3292":63655},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3839":3026,"_33145":3026,"_5":15996,"_3292":63657,"_33551":63658,"_22633":63660,"_29869":3026},"3.8.0 to 4.0.0",[54324,63659],"Upgrades",[],{"_3839":3027,"_33145":3026,"_22633":63662,"_5":15597,"_29869":3026,"_3292":63663},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3839":3028,"_33145":3026,"_5":33548,"_22633":63665,"_29869":63666,"_3292":63667},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3839":3029,"_33145":3026,"_5":33548,"_22633":63669,"_29869":63670,"_3292":63671},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3839":3030,"_33145":3026,"_5":33548,"_22633":63673,"_29869":63674,"_3292":63675},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3839":3031,"_33145":3026,"_5":33548,"_22633":63677,"_29869":63678,"_3292":63679},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3839":3032,"_33145":3026,"_5":33548,"_22633":63681,"_29869":63682,"_3292":63683},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3839":3033,"_33145":3026,"_5":33548,"_22633":63685,"_29869":63686,"_3292":63687},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3839":3034,"_33145":3026,"_5":33548,"_22633":63689,"_29869":63690,"_3292":63691},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3839":3035,"_33145":3026,"_5":33548,"_22633":63693,"_29869":63694,"_3292":63695},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3839":3036,"_33145":3026,"_5":33548,"_22633":63697,"_29869":63698,"_3292":63699},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3839":3037,"_33145":3026,"_5":33548,"_22633":63701,"_29869":63702,"_3292":63703},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3839":3038,"_33145":3026,"_5":33548,"_22633":63705,"_29869":63706,"_3292":63707},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3839":3039,"_33145":3026,"_5":33548,"_22633":63709,"_29869":63710,"_3292":63711},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3839":3040,"_33145":3026,"_5":33548,"_22633":63713,"_29869":63714,"_3292":63715},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3839":3041,"_33145":3026,"_5":33548,"_22633":63717,"_29869":63718,"_3292":63719},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3839":3042,"_33145":3026,"_5":33548,"_22633":63721,"_29869":63722,"_3292":63723},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3839":3043,"_33145":3026,"_5":33548,"_22633":63725,"_29869":63726,"_3292":63727},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3839":3044,"_33145":3026,"_5":33548,"_22633":63729,"_29869":63730,"_3292":63731},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3839":3045,"_33145":3026,"_5":33548,"_22633":63733,"_29869":63734,"_3292":63735},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3839":3046,"_33145":3026,"_5":33548,"_22633":63737,"_29869":63738,"_3292":63739},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3839":3047,"_33145":3026,"_5":33548,"_22633":63741,"_29869":63742,"_3292":63743},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-va-roles","References between certificates, keys and VA roles",{"_3839":3048,"_33145":3026,"_5":33548,"_22633":63745,"_29869":63746,"_3292":63747},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3839":3049,"_33145":3026,"_5":33548,"_22633":63749,"_29869":63750,"_3292":63751},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3839":3050,"_33145":3026,"_5":33548,"_22633":63753,"_29869":63754,"_3292":63755},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3839":3051,"_33145":3026,"_5":33548,"_22633":63757,"_29869":63758,"_3292":63759},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3839":3052,"_33145":3026,"_5":33548,"_22633":63761,"_29869":63762,"_3292":63763},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3839":3053,"_33145":3026,"_5":33548,"_22633":63765,"_29869":63766,"_3292":63767},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3839":3054,"_33145":3026,"_5":33548,"_22633":63769,"_29869":63770,"_3292":63771},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3839":3055,"_33145":3026,"_5":33548,"_22633":63773,"_29869":63774,"_3292":63775},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#va-role-signer-field","VA role signer field",{"_3839":3056,"_33145":3026,"_5":33548,"_22633":63777,"_29869":63778,"_3292":63779},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3839":3057,"_33145":3026,"_5":33548,"_22633":63781,"_29869":63782,"_3292":63783},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3839":3058,"_33145":3026,"_5":33548,"_22633":63785,"_29869":63786,"_3292":63787},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3839":3059,"_33145":3026,"_5":33548,"_22633":63789,"_29869":63790,"_3292":63791},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3839":3060,"_33145":3026,"_5":33548,"_22633":63793,"_29869":63794,"_3292":63795},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3839":3061,"_33145":3026,"_5":33548,"_22633":63797,"_29869":63798,"_3292":63799},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3839":3062,"_33145":3026,"_5":33548,"_22633":63801,"_29869":63802,"_3292":63803},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3839":3063,"_33145":3026,"_5":33548,"_22633":63805,"_29869":63806,"_3292":58369},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3839":3064,"_33145":3026,"_5":33548,"_22633":63808,"_29869":63809,"_3292":63810},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3839":3065,"_33145":3026,"_5":33548,"_22633":63812,"_29869":63813,"_3292":63814},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3839":3066,"_33145":3026,"_22633":63816,"_5":15597,"_29869":3026,"_3292":63817},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3839":3067,"_33145":3026,"_22633":63819,"_5":15597,"_29869":3026,"_3292":63820},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3839":3068,"_33145":3026,"_22633":63822,"_5":15597,"_29869":3026,"_3292":63823},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3839":3069,"_33145":3026,"_22633":63825,"_5":15597,"_29869":3026,"_3292":63826},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3839":3070,"_33145":3026,"_22633":63828,"_5":15597,"_29869":3026,"_3292":63829},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3839":3071,"_33145":3026,"_22633":63831,"_5":15597,"_29869":3026,"_3292":63832},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3839":3072,"_33145":3026,"_22633":63834,"_5":15597,"_29869":3026,"_3292":63835},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3839":3073,"_33145":3026,"_22633":63837,"_5":15597,"_29869":63670,"_3292":63838},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3839":3074,"_33145":3026,"_22633":63840,"_5":15597,"_29869":63670,"_3292":63841},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3839":3075,"_33145":3026,"_22633":63843,"_5":15597,"_29869":63674,"_3292":63844},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3839":3076,"_33145":3026,"_22633":63846,"_5":15597,"_29869":63674,"_3292":63847},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3839":3077,"_33145":3026,"_22633":63849,"_5":15597,"_29869":63678,"_3292":63850},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3839":3078,"_33145":3026,"_22633":63852,"_5":15597,"_29869":63682,"_3292":63853},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3839":3079,"_33145":3026,"_22633":63855,"_5":15597,"_29869":63682,"_3292":63856},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3839":3080,"_33145":3026,"_22633":63858,"_5":15597,"_29869":63682,"_3292":63859},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3839":3081,"_33145":3026,"_22633":63861,"_5":15597,"_29869":63682,"_3292":63862},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3839":3082,"_33145":3026,"_22633":63864,"_5":15597,"_29869":63682,"_3292":63865},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3839":3083,"_33145":3026,"_22633":63867,"_5":15597,"_29869":63686,"_3292":63868},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3839":3084,"_33145":3026,"_22633":63870,"_5":15597,"_29869":63686,"_3292":63871},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3839":3085,"_33145":3026,"_22633":63873,"_5":15597,"_29869":63686,"_3292":63874},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3839":3086,"_33145":3026,"_22633":63876,"_5":15597,"_29869":63686,"_3292":63877},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3839":3087,"_33145":3026,"_22633":63879,"_5":15597,"_29869":63686,"_3292":63880},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3839":3088,"_33145":3026,"_22633":63882,"_5":15597,"_29869":63690,"_3292":63883},[],"Change",{"_3839":3089,"_33145":3026,"_22633":63885,"_5":15597,"_29869":63690,"_3292":63886},[],"Who is affected",{"_3839":3090,"_33145":3026,"_22633":63888,"_5":15597,"_29869":63690,"_3292":63889},[],"Severity",{"_3839":3091,"_33145":3026,"_22633":63891,"_5":15597,"_29869":63690,"_3292":61139},[],{"_3839":3092,"_33145":3026,"_22633":63893,"_5":15597,"_29869":63690,"_3292":63699},[],{"_3839":3093,"_33145":3026,"_22633":63895,"_5":15597,"_29869":63690,"_3292":63896},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3839":3094,"_33145":3026,"_22633":63898,"_5":15597,"_29869":63690,"_3292":63899},[],"High: KMS and VA start on empty volumes",{"_3839":3095,"_33145":3026,"_22633":63901,"_5":15597,"_29869":63690,"_3292":63902},[],"Copy the data into the new volumes",{"_3839":3096,"_33145":3026,"_22633":63904,"_5":15597,"_29869":63690,"_3292":63703},[],{"_3839":3097,"_33145":3026,"_22633":63906,"_5":15597,"_29869":63690,"_3292":63907},[],"Every Helm release",{"_3839":3098,"_33145":3026,"_22633":63909,"_5":15597,"_29869":63690,"_3292":63910},[],"High: `helm upgrade` fails",{"_3839":3099,"_33145":3026,"_22633":63912,"_5":15597,"_29869":63690,"_3292":63913},[],"Remove or rename legacy keys",{"_3839":3100,"_33145":3026,"_22633":63915,"_5":15597,"_29869":63690,"_3292":63707},[],{"_3839":3101,"_33145":3026,"_22633":63917,"_5":15597,"_29869":63690,"_3292":63918},[],"Every deployment",{"_3839":3102,"_33145":3026,"_22633":63920,"_5":15597,"_29869":63690,"_3292":63921},[],"High: without a bootstrap principal there is no administrator",{"_3839":3103,"_33145":3026,"_22633":63923,"_5":15597,"_29869":63690,"_3292":63924},[],"Configure `services.authz`",{"_3839":3104,"_33145":3026,"_22633":63926,"_5":15597,"_29869":63690,"_3292":63711},[],{"_3839":3105,"_33145":3026,"_22633":63928,"_5":15597,"_29869":63690,"_3292":63907},[],{"_3839":3106,"_33145":3026,"_22633":63930,"_5":15597,"_29869":63690,"_3292":63931},[],"High: `helm upgrade` fails on the old keys",{"_3839":3107,"_33145":3026,"_22633":63933,"_5":15597,"_29869":63690,"_3292":63934},[],"Move JWKS and roles into `services.authz`",{"_3839":3108,"_33145":3026,"_22633":63936,"_5":15597,"_29869":63690,"_3292":63731},[],{"_3839":3109,"_33145":3026,"_22633":63938,"_5":15597,"_29869":63690,"_3292":63939},[],"3.8.0 deployments with per-service databases",{"_3839":3110,"_33145":3026,"_22633":63941,"_5":15597,"_29869":63690,"_3292":63942},[],"High: services find no data, or a migration aborts",{"_3839":3111,"_33145":3026,"_22633":63944,"_5":15597,"_29869":63690,"_3292":63945},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3839":3112,"_33145":3026,"_22633":63947,"_5":15597,"_29869":63690,"_3292":63735},[],{"_3839":3113,"_33145":3026,"_22633":63949,"_5":15597,"_29869":63690,"_3292":63950},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3839":3114,"_33145":3026,"_22633":63952,"_5":15597,"_29869":63690,"_3292":63953},[],"High: the backend no longer starts with them",{"_3839":3115,"_33145":3026,"_22633":63955,"_5":15597,"_29869":63690,"_3292":63956},[],"Move to PostgreSQL before upgrading",{"_3839":3116,"_33145":3026,"_22633":63958,"_5":15597,"_29869":63690,"_3292":63959},[],"Webhooks with file references",{"_3839":3117,"_33145":3026,"_22633":63961,"_5":15597,"_29869":63690,"_3292":63962},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3839":3118,"_33145":3026,"_22633":63964,"_5":15597,"_29869":63690,"_3292":63965},[],"High: enrollments calling the webhook fail",{"_3839":3119,"_33145":3026,"_22633":63967,"_5":15597,"_29869":63690,"_3292":63968},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3839":3120,"_33145":3026,"_22633":63970,"_5":15597,"_29869":63690,"_3292":63715},[],{"_3839":3121,"_33145":3026,"_22633":63972,"_5":15597,"_29869":63690,"_3292":63973},[],"Releases with per-service identity overrides or mounted key material",{"_3839":3122,"_33145":3026,"_22633":63975,"_5":15597,"_29869":63690,"_3292":63976},[],"Medium: services cannot read their files",{"_3839":3123,"_33145":3026,"_22633":63978,"_5":15597,"_29869":63690,"_3292":63979},[],"Remove the overrides and fix volume ownership",{"_3839":3124,"_33145":3026,"_22633":63981,"_5":15597,"_29869":63690,"_3292":63719},[],{"_3839":3125,"_33145":3026,"_22633":63983,"_5":15597,"_29869":63690,"_3292":63984},[],"Releases that set `amqp.tls`",{"_3839":3126,"_33145":3026,"_22633":63986,"_5":15597,"_29869":63690,"_3292":63987},[],"Medium: clients connect to the wrong port",{"_3839":3127,"_33145":3026,"_22633":63989,"_5":15597,"_29869":63690,"_3292":63990},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3839":3128,"_33145":3026,"_22633":63992,"_5":15597,"_29869":63690,"_3292":63739},[],{"_3839":3129,"_33145":3026,"_22633":63994,"_5":15597,"_29869":63690,"_3292":63995},[],"Installations whose CA keys predate the KMS",{"_3839":3130,"_33145":3026,"_22633":63997,"_5":15597,"_29869":63690,"_3292":63998},[],"Medium: CA keys stay unmanaged",{"_3839":3131,"_33145":3026,"_22633":64000,"_5":15597,"_29869":63690,"_3292":64001},[],"Run the CA-to-KMS migration",{"_3839":3132,"_33145":3026,"_22633":64003,"_5":15597,"_29869":63690,"_3292":64004},[],"Receiver certificate verification",{"_3839":3133,"_33145":3026,"_22633":64006,"_5":15597,"_29869":63690,"_3292":64007},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3839":3134,"_33145":3026,"_22633":64009,"_5":15597,"_29869":63690,"_3292":64010},[],"Medium: credentials go to an unverified receiver",{"_3839":3135,"_33145":3026,"_22633":64012,"_5":15597,"_29869":63690,"_3292":64013},[],"Set `insecure_skip_verify` to `false`",{"_3839":3136,"_33145":3026,"_22633":64015,"_5":15597,"_29869":63690,"_3292":63755},[],{"_3839":3137,"_33145":3026,"_22633":64017,"_5":15597,"_29869":63690,"_3292":64018},[],"Scripts and consoles that edit DMSs through the API",{"_3839":3138,"_33145":3026,"_22633":64020,"_5":15597,"_29869":63690,"_3292":64021},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3839":3139,"_33145":3026,"_22633":64023,"_5":15597,"_29869":63690,"_3292":64024},[],"Read the DMS before editing and use the new field",{"_3839":3140,"_33145":3026,"_22633":64026,"_5":15597,"_29869":63690,"_3292":63775},[],{"_3839":3141,"_33145":3026,"_22633":64028,"_5":15597,"_29869":63690,"_3292":64029},[],"Clients that create or update VA roles through the API",{"_3839":3142,"_33145":3026,"_22633":64031,"_5":15597,"_29869":63690,"_3292":64032},[],"Medium: requests with the old field return an error",{"_3839":3143,"_33145":3026,"_22633":64034,"_5":15597,"_29869":63690,"_3292":64035},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_certificate_serial_number`",{"_3839":3144,"_33145":3026,"_22633":64037,"_5":15597,"_29869":63690,"_3292":63771},[],{"_3839":3145,"_33145":3026,"_22633":64039,"_5":15597,"_29869":63690,"_3292":64040},[],"Consumers that read the device `events` field",{"_3839":3146,"_33145":3026,"_22633":64042,"_5":15597,"_29869":63690,"_3292":64043},[],"Medium: the field disappears",{"_3839":3147,"_33145":3026,"_22633":64045,"_5":15597,"_29869":63690,"_3292":64046},[],"Use the new event endpoints",{"_3839":3148,"_33145":3026,"_22633":64048,"_5":15597,"_29869":63690,"_3292":63723},[],{"_3839":3149,"_33145":3026,"_22633":64050,"_5":15597,"_29869":63690,"_3292":64051},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3839":3150,"_33145":3026,"_22633":64053,"_5":15597,"_29869":63690,"_3292":64054},[],"Low to medium: validation errors or changed defaults",{"_3839":3151,"_33145":3026,"_22633":64056,"_5":15597,"_29869":63690,"_3292":64057},[],"Update the values file",{"_3839":3152,"_33145":3026,"_22633":64059,"_5":15597,"_29869":63690,"_3292":63763},[],{"_3839":3153,"_33145":3026,"_22633":64061,"_5":15597,"_29869":63690,"_3292":64062},[],"Clients that send the DMS ID in the update body",{"_3839":3154,"_33145":3026,"_22633":64064,"_5":15597,"_29869":63690,"_3292":64065},[],"Low: the ID in the URL wins",{"_3839":3155,"_33145":3026,"_22633":64067,"_5":15597,"_29869":63690,"_3292":64068},[],"Send the ID in the URL",{"_3839":3156,"_33145":3026,"_22633":64070,"_5":15597,"_29869":63690,"_3292":63767},[],{"_3839":3157,"_33145":3026,"_22633":64072,"_5":15597,"_29869":63690,"_3292":64073},[],"Consumers that match on certificate `type`",{"_3839":3158,"_33145":3026,"_22633":64075,"_5":15597,"_29869":63690,"_3292":64076},[],"Low: two values are renamed",{"_3839":3159,"_33145":3026,"_22633":64078,"_5":15597,"_29869":63690,"_3292":64079},[],"Adapt consumers",{"_3839":3160,"_33145":3026,"_22633":64081,"_5":15597,"_29869":63690,"_3292":63759},[],{"_3839":3161,"_33145":3026,"_22633":64083,"_5":15597,"_29869":63690,"_3292":64084},[],"Any DMS",{"_3839":3162,"_33145":3026,"_22633":64086,"_5":15597,"_29869":63690,"_3292":64087},[],"Low: informational",{"_3839":3163,"_33145":3026,"_22633":64089,"_5":15597,"_29869":63690,"_3292":64090},[],"Read both blocks before editing",{"_3839":3164,"_33145":3026,"_22633":64092,"_5":15597,"_29869":63698,"_3292":64093},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3839":3165,"_33145":3026,"_22633":64095,"_5":15597,"_29869":63698,"_3292":64096},[],"Step 4 of the migration guide copies the data.",{"_3839":3166,"_33145":3026,"_22633":64098,"_5":15597,"_29869":63702,"_3292":64099},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3839":3167,"_33145":3026,"_22633":64101,"_5":15597,"_29869":63706,"_3292":64102},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3839":3168,"_33145":3026,"_22633":64104,"_5":15597,"_29869":63710,"_3292":64105},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3839":3169,"_33145":3026,"_22633":64107,"_5":15597,"_29869":63714,"_3292":64108},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3839":3170,"_33145":3026,"_22633":64110,"_5":15597,"_29869":63714,"_3292":64111},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3839":3171,"_33145":3026,"_22633":64113,"_5":15597,"_29869":63718,"_3292":64114},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3839":3172,"_33145":3026,"_22633":64116,"_5":15597,"_29869":63722,"_3292":64117},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3839":3173,"_33145":3026,"_22633":64119,"_5":15597,"_29869":63722,"_3292":64120},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3839":3174,"_33145":3026,"_22633":64122,"_5":15597,"_29869":63722,"_3292":64123},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3839":3175,"_33145":3026,"_22633":64125,"_5":15597,"_29869":63722,"_3292":64126},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3839":3176,"_33145":3026,"_22633":64128,"_5":15597,"_29869":63722,"_3292":64129},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3839":3177,"_33145":3026,"_22633":64131,"_5":15597,"_29869":63722,"_3292":64132},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3839":3178,"_33145":3026,"_22633":64134,"_5":15597,"_29869":63730,"_3292":64135},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3839":3179,"_33145":3026,"_22633":64137,"_5":15597,"_29869":63730,"_3292":64138},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3839":3180,"_33145":3026,"_22633":64140,"_5":15597,"_29869":63730,"_3292":64141},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3839":3181,"_33145":3026,"_22633":64143,"_5":15597,"_29869":63730,"_3292":64144},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3839":3182,"_33145":3026,"_22633":64146,"_5":15597,"_29869":63730,"_3292":64147},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3839":3183,"_33145":3026,"_22633":64149,"_5":15597,"_29869":63734,"_3292":64150},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3839":3184,"_33145":3026,"_22633":64152,"_5":15597,"_29869":63738,"_3292":64153},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3839":3185,"_33145":3026,"_22633":64155,"_5":15597,"_29869":63738,"_3292":64156},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3839":3186,"_33145":3026,"_22633":64158,"_5":15597,"_29869":63738,"_3292":64159},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3839":3187,"_33145":3026,"_22633":64161,"_5":15597,"_29869":63738,"_3292":64162},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3839":3188,"_33145":3026,"_22633":64164,"_5":15597,"_29869":63738,"_3292":64165},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3839":3189,"_33145":3026,"_22633":64167,"_5":15597,"_29869":63738,"_3292":64168},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3839":3190,"_33145":3026,"_22633":64170,"_5":15597,"_29869":63738,"_3292":64171},[],"Once legacy keys are registered, starting the KMS with the backend configuration option `crypto_engines.migrate_keys_format` renames keys whose name is not the public-key SHA-256 digest, keeps the old name as an alias and moves certificate references along. It is safe to re-run and can be disabled afterwards.",{"_3839":3191,"_33145":3026,"_22633":64173,"_5":15597,"_29869":63742,"_3292":64174},[],"Certificates now reference their KMS key, and VA roles reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3839":3192,"_33145":3026,"_22633":64176,"_5":15597,"_29869":63750,"_3292":64177},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3839":3193,"_33145":3026,"_22633":64179,"_5":15597,"_29869":63750,"_3292":64180},[],"Field in 3.8.0",{"_3839":3194,"_33145":3026,"_22633":64182,"_5":15597,"_29869":63750,"_3292":64183},[],"Field in 4.0.0",{"_3839":3195,"_33145":3026,"_22633":64185,"_5":15597,"_29869":63750,"_3292":64186},[],"`validate_server_cert`",{"_3839":3196,"_33145":3026,"_22633":64188,"_5":15597,"_29869":63750,"_3292":64189},[],"`insecure_skip_verify` (value negated)",{"_3839":3197,"_33145":3026,"_22633":64191,"_5":15597,"_29869":63750,"_3292":64192},[],"`oidc`",{"_3839":3198,"_33145":3026,"_22633":64194,"_5":15597,"_29869":63750,"_3292":64195},[],"`jwt_options`",{"_3839":3199,"_33145":3026,"_22633":64197,"_5":15597,"_29869":63750,"_3292":64198},[],"`apikey`",{"_3839":3200,"_33145":3026,"_22633":64200,"_5":15597,"_29869":63750,"_3292":64201},[],"`apikey_options`",{"_3839":3201,"_33145":3026,"_22633":64203,"_5":15597,"_29869":63750,"_3292":64204},[],"`mtls`",{"_3839":3202,"_33145":3026,"_22633":64206,"_5":15597,"_29869":63750,"_3292":64207},[],"`mtls_options`",{"_3839":3203,"_33145":3026,"_22633":64209,"_5":15597,"_29869":63750,"_3292":64210},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3839":3204,"_33145":3026,"_22633":64212,"_5":15597,"_29869":63750,"_3292":64213},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3839":3205,"_33145":3026,"_22633":64215,"_5":15597,"_29869":63750,"_3292":64216},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3839":3206,"_33145":3026,"_22633":64218,"_5":15597,"_29869":63754,"_3292":64219},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3839":3207,"_33145":3026,"_22633":64221,"_5":15597,"_29869":63754,"_3292":64222},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3839":3208,"_33145":3026,"_22633":64224,"_5":15597,"_29869":63754,"_3292":64225},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3839":3209,"_33145":3026,"_22633":64227,"_5":15597,"_29869":63758,"_3292":64228},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3839":3210,"_33145":3026,"_22633":64230,"_5":15597,"_29869":63762,"_3292":64231},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3839":3211,"_33145":3026,"_22633":64233,"_5":15597,"_29869":63766,"_3292":64234},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3839":3212,"_33145":3026,"_22633":64236,"_5":15597,"_29869":63770,"_3292":64237},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3839":3213,"_33145":3026,"_22633":64239,"_5":15597,"_29869":63770,"_3292":64240},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3839":3214,"_33145":3026,"_22633":64242,"_5":15597,"_29869":63770,"_3292":64243},[],"`POST /v1/devices/:id/events` creates an event.",{"_3839":3215,"_33145":3026,"_22633":64245,"_5":15597,"_29869":63770,"_3292":64246},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3839":3216,"_33145":3026,"_22633":64248,"_5":15597,"_29869":63774,"_3292":64249},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_certificate_serial_number`, the serial number of the existing certificate that signs the CRL. A new role's initial value is the CA's current certificate serial number. Requests that still carry `subject_key_id_signer` return an error. Custom authorization policies that filter on the old field must be updated: the filter `crl_subject_key_id_signer` is renamed to `crl_signer_certificate_serial_number` and takes serial-number values.",{"_3839":3217,"_33145":3026,"_22633":64251,"_5":15597,"_29869":63778,"_3292":64252},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3839":3218,"_33145":3026,"_22633":64254,"_5":15597,"_29869":63782,"_3292":64255},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3839":3219,"_33145":3026,"_22633":64257,"_5":15597,"_29869":63782,"_3292":64258},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3839":3220,"_33145":3026,"_22633":64260,"_5":15597,"_29869":63782,"_3292":64261},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3839":3221,"_33145":3026,"_22633":64263,"_5":15597,"_29869":63782,"_3292":64264},[],"Record the names of your local-storage PVCs:",{"_3839":3222,"_33145":3026,"_22633":64266,"_5":15597,"_29869":63782,"_3292":64267},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3839":3223,"_33145":3026,"_22633":64269,"_5":15597,"_29869":63786,"_3292":64270},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3839":3224,"_33145":3026,"_22633":64272,"_5":15597,"_29869":63786,"_3292":64273},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3839":3225,"_33145":3026,"_22633":64275,"_5":15597,"_29869":63786,"_3292":64276},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3839":3226,"_33145":3026,"_22633":64278,"_5":15597,"_29869":63786,"_3292":64279},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3839":3227,"_33145":3026,"_22633":64281,"_5":15597,"_29869":63786,"_3292":64282},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3839":3228,"_33145":3026,"_22633":64284,"_5":15597,"_29869":63786,"_3292":64285},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3839":3229,"_33145":3026,"_22633":64287,"_5":15597,"_29869":63786,"_3292":64288},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3839":3230,"_33145":3026,"_22633":64290,"_5":15597,"_29869":63786,"_3292":64291},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3839":3231,"_33145":3026,"_22633":64293,"_5":15597,"_29869":63786,"_3292":64294},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3839":3232,"_33145":3026,"_22633":64296,"_5":15597,"_29869":63786,"_3292":64297},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3839":3233,"_33145":3026,"_22633":64299,"_5":15597,"_29869":63786,"_3292":64300},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3839":3234,"_33145":3026,"_22633":64302,"_5":15597,"_29869":63786,"_3292":64303},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3839":3235,"_33145":3026,"_22633":64305,"_5":15597,"_29869":63790,"_3292":64306},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3839":3236,"_33145":3026,"_22633":64308,"_5":15597,"_29869":63790,"_3292":64309},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3839":3237,"_33145":3026,"_22633":64311,"_5":15597,"_29869":63794,"_3292":64312},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3839":3238,"_33145":3026,"_22633":64314,"_5":15597,"_29869":63794,"_3292":64315},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3839":3239,"_33145":3026,"_22633":64317,"_5":15597,"_29869":63794,"_3292":64318},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3839":3240,"_33145":3026,"_22633":64320,"_5":15597,"_29869":63794,"_3292":64321},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3839":3241,"_33145":3026,"_22633":64323,"_5":15597,"_29869":63794,"_3292":64324},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3839":3242,"_33145":3026,"_22633":64326,"_5":15597,"_29869":63794,"_3292":64327},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3839":3243,"_33145":3026,"_22633":64329,"_5":15597,"_29869":63794,"_3292":64330},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3839":3244,"_33145":3026,"_22633":64332,"_5":15597,"_29869":63794,"_3292":64333},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3839":3245,"_33145":3026,"_22633":64335,"_5":15597,"_29869":63794,"_3292":64336},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3839":3246,"_33145":3026,"_22633":64338,"_5":15597,"_29869":63794,"_3292":64339},[],"**Remove the helper and restore the recorded replica counts:**",{"_3839":3247,"_33145":3026,"_22633":64341,"_5":15597,"_29869":63794,"_3292":64342},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3839":3248,"_33145":3026,"_22633":64344,"_5":15597,"_29869":63798,"_3292":64345},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3839":3249,"_33145":3026,"_22633":64347,"_5":15597,"_29869":63798,"_3292":64348},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3839":3250,"_33145":3026,"_22633":64350,"_5":15597,"_29869":63802,"_3292":64351},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3839":3251,"_33145":3026,"_22633":64353,"_5":15597,"_29869":63802,"_3292":64354},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3839":3252,"_33145":3026,"_22633":64356,"_5":15597,"_29869":63802,"_3292":64357},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates`. If your services connect with a different user than the one that ran the migrations, grant that user `SELECT` on `ca.certificates_view` after the migrations.",{"_3839":3253,"_33145":3026,"_22633":64359,"_5":15597,"_29869":63802,"_3292":64360},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3839":3254,"_33145":3026,"_22633":64362,"_5":15597,"_29869":63802,"_3292":64363},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3839":3255,"_33145":3026,"_22633":64365,"_5":15597,"_29869":63802,"_3292":64366},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3839":3256,"_33145":3026,"_22633":64368,"_5":15597,"_29869":63802,"_3292":64369},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3839":3257,"_33145":3026,"_22633":64371,"_5":15597,"_29869":63806,"_3292":64372},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3839":3258,"_33145":3026,"_22633":64374,"_5":15597,"_29869":63806,"_3292":64375},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3839":3259,"_33145":3026,"_22633":64377,"_5":15597,"_29869":63806,"_3292":64378},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3839":3260,"_33145":3026,"_22633":64380,"_5":15597,"_29869":63806,"_3292":64381},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3839":3261,"_33145":3026,"_22633":64383,"_5":15597,"_29869":63806,"_3292":64384},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3839":3262,"_33145":3026,"_22633":64386,"_5":15597,"_29869":63806,"_3292":64387},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3839":3263,"_33145":3026,"_22633":64389,"_5":15597,"_29869":63806,"_3292":64390},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3839":3264,"_33145":3026,"_22633":64392,"_5":15597,"_29869":63806,"_3292":64393},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` schema migration.",{"_3839":3265,"_33145":3026,"_22633":64395,"_5":15597,"_29869":63806,"_3292":64396},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3839":3266,"_33145":3026,"_22633":64398,"_5":15597,"_29869":63806,"_3292":64399},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_certificate_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3839":3267,"_33145":3026,"_22633":64401,"_5":15597,"_29869":63806,"_3292":64402},[],"**A migration or service fails with `permission denied for table ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped. Grant the missing privileges and re-run.",{"_3839":3268,"_33145":3026,"_22633":64404,"_5":15597,"_29869":63809,"_3292":64405},[],"After the upgrade, check in this order:",{"_3839":3269,"_33145":3026,"_22633":64407,"_5":15597,"_29869":63809,"_3292":64408},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3839":3270,"_33145":3026,"_22633":64410,"_5":15597,"_29869":63809,"_3292":64411},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3839":3271,"_33145":3026,"_22633":64413,"_5":15597,"_29869":63809,"_3292":64414},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3839":3272,"_33145":3026,"_22633":64416,"_5":15597,"_29869":63809,"_3292":64417},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3839":3273,"_33145":3026,"_22633":64419,"_5":15597,"_29869":63809,"_3292":64420},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_3839":3274,"_33145":3026,"_22633":64422,"_5":15597,"_29869":63809,"_3292":64423},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3839":3275,"_33145":3026,"_22633":64425,"_5":15597,"_29869":63809,"_3292":64426},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3839":3276,"_33145":3026,"_22633":64428,"_5":15597,"_29869":63809,"_3292":64429},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3839":3277,"_33145":3026,"_22633":64431,"_5":15597,"_29869":63809,"_3292":64432},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3839":3278,"_33145":3026,"_22633":64434,"_5":15597,"_29869":63809,"_3292":64435},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3839":3279,"_33145":3026,"_22633":64437,"_5":15597,"_29869":63809,"_3292":64438},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3839":3280,"_33145":3026,"_22633":64440,"_5":15597,"_29869":63809,"_3292":64441},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3839":3281,"_33145":3026,"_22633":64443,"_5":15597,"_29869":63809,"_3292":64444},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3839":3282,"_33145":3026,"_22633":64446,"_5":15597,"_29869":63809,"_3292":64447},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3839":3283,"_33145":3026,"_22633":64449,"_5":15597,"_29869":63813,"_3292":64450},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3839":3284,"_33145":3026,"_22633":64452,"_5":15597,"_29869":63813,"_3292":64453},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3839":3285,"_33145":3026,"_22633":64455,"_5":15597,"_29869":63813,"_3292":64456},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3839":3286,"_33145":3026,"_22633":64458,"_5":15597,"_29869":63813,"_3292":64459},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3839":3287,"_33145":3026,"_22633":64461,"_5":15597,"_29869":63813,"_3292":64462},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_64465":19469,"_64466":64467,"_64468":64469,"_64470":64471,"_19588":3327,"_77577":3327},"language","sortableProperties",[3292,33145,5,29869],"sortablePropertiesWithTypes",{"_3292":27097,"_33145":27097,"_5":27097,"_29869":27097},"sorts",{"_3292":64472,"_33145":67749,"_5":71025,"_29869":74301},{"_5095":64473,"_64474":64475,"_5":27097},{"_15684":7641,"_11291":3742,"_11235":5920,"_11140":4502,"_11366":8072,"_11148":10740,"_15705":16475,"_11156":19725,"_28495"