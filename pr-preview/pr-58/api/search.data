46067":143797,"_46069":143800,"_46071":143803,"_46073":143806,"_46075":143809,"_46077":143812,"_46080":143815,"_46082":143818,"_46084":143821},{"_4070":81465,"_34195":81465,"_5":16540,"_3518":133394,"_34626":133395,"_23354":133398,"_30763":81465},"Despliega desde AWS Marketplace",[56672,133396,133397],"Despliegue","Otros modelos",[],{"_4070":81466,"_34195":81465,"_23354":133400,"_5":16137,"_30763":81465,"_3518":133401},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_4070":81467,"_34195":81465,"_5":34623,"_23354":133403,"_30763":133404,"_3518":133405},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_4070":81468,"_34195":81465,"_5":34623,"_23354":133407,"_30763":133408,"_3518":133409},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_4070":81469,"_34195":81465,"_5":34623,"_23354":133411,"_30763":133412,"_3518":133413},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_4070":81470,"_34195":81465,"_5":34623,"_23354":133415,"_30763":133416,"_3518":133417},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_4070":81471,"_34195":81465,"_5":34623,"_23354":133419,"_30763":133420,"_3518":133421},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_4070":81472,"_34195":81465,"_5":34623,"_23354":133423,"_30763":133424,"_3518":133425},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_4070":81473,"_34195":81465,"_5":34623,"_23354":133427,"_30763":133428,"_3518":133429},[],"/docs/pr-preview/pr-58/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_4070":81474,"_34195":81465,"_23354":133431,"_5":16137,"_30763":81465,"_3518":133432},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_4070":81475,"_34195":81465,"_23354":133434,"_5":16137,"_30763":133404,"_3518":133435},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_4070":81476,"_34195":81465,"_23354":133437,"_5":16137,"_30763":133404,"_3518":133438},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_4070":81477,"_34195":81465,"_23354":133440,"_5":16137,"_30763":133404,"_3518":133441},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_4070":81478,"_34195":81465,"_23354":133443,"_5":16137,"_30763":133408,"_3518":133444},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_4070":81479,"_34195":81465,"_23354":133446,"_5":16137,"_30763":133408,"_3518":133447},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_4070":81480,"_34195":81465,"_23354":133449,"_5":16137,"_30763":133408,"_3518":133450},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_4070":81481,"_34195":81465,"_23354":133452,"_5":16137,"_30763":133412,"_3518":133453},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_4070":81482,"_34195":81465,"_23354":133455,"_5":16137,"_30763":133416,"_3518":133456},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_4070":81483,"_34195":81465,"_23354":133458,"_5":16137,"_30763":133420,"_3518":133459},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_4070":81484,"_34195":81465,"_23354":133461,"_5":16137,"_30763":133424,"_3518":133462},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_4070":81485,"_34195":81465,"_23354":133464,"_5":16137,"_30763":133428,"_3518":133465},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_4070":81486,"_34195":81486,"_5":16540,"_3518":133467,"_34626":133468,"_23354":133469,"_30763":81486},"Despliega Lamassu",[56672,133396],[],{"_4070":81487,"_34195":81486,"_23354":133471,"_5":16137,"_30763":81486,"_3518":133472},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_4070":81488,"_34195":81486,"_5":34623,"_23354":133474,"_30763":133475,"_3518":133476},[],"/docs/pr-preview/pr-58/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_4070":81489,"_34195":81486,"_5":34623,"_23354":133478,"_30763":133479,"_3518":133480},[],"/docs/pr-preview/pr-58/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_4070":81490,"_34195":81486,"_5":34623,"_23354":133482,"_30763":133483,"_3518":133484},[],"/docs/pr-preview/pr-58/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_4070":81491,"_34195":81486,"_23354":133486,"_5":16137,"_30763":81486,"_3518":133487},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_4070":81492,"_34195":81486,"_23354":133489,"_5":16137,"_30763":133475,"_3518":133490},[],"Modelo",{"_4070":81493,"_34195":81486,"_23354":133492,"_5":16137,"_30763":133475,"_3518":133493},[],"Recomendado para",{"_4070":81494,"_34195":81486,"_23354":133495,"_5":16137,"_30763":133475,"_3518":133496},[],"Quién opera la infraestructura",{"_4070":81495,"_34195":81486,"_23354":133498,"_5":16137,"_30763":133475,"_3518":133499},[],"Punto de partida",{"_4070":81496,"_34195":81486,"_23354":133501,"_5":16137,"_30763":133475,"_3518":56779},[],{"_4070":81497,"_34195":81486,"_23354":133503,"_5":16137,"_30763":133475,"_3518":133504},[],"Producción, entornos regulados y despliegues personalizados",{"_4070":81498,"_34195":81486,"_23354":133506,"_5":16137,"_30763":133475,"_3518":133507},[],"Tu equipo",{"_4070":81499,"_34195":81486,"_23354":133509,"_5":16137,"_30763":133475,"_3518":133510},[],"Helm o Fastlane",{"_4070":81500,"_34195":81486,"_23354":133512,"_5":16137,"_30763":133475,"_3518":56791},[],{"_4070":81501,"_34195":81486,"_23354":133514,"_5":16137,"_30763":133475,"_3518":133515},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_4070":81502,"_34195":81486,"_23354":133517,"_5":16137,"_30763":133475,"_3518":133507},[],{"_4070":81503,"_34195":81486,"_23354":133519,"_5":16137,"_30763":133475,"_3518":133520},[],"Imagen preconfigurada en EC2",{"_4070":81504,"_34195":81486,"_23354":133522,"_5":16137,"_30763":133475,"_3518":56802},[],{"_4070":81505,"_34195":81486,"_23354":133524,"_5":16137,"_30763":133475,"_3518":133525},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_4070":81506,"_34195":81486,"_23354":133527,"_5":16137,"_30763":133475,"_3518":56808},[],{"_4070":81507,"_34195":81486,"_23354":133529,"_5":16137,"_30763":133475,"_3518":133530},[],"Suscripción gestionada",{"_4070":81508,"_34195":81486,"_23354":133532,"_5":16137,"_30763":133475,"_3518":133533},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_4070":81509,"_34195":81486,"_23354":133535,"_5":16137,"_30763":133475,"_3518":133536},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_4070":81510,"_34195":81486,"_23354":133538,"_5":16137,"_30763":133475,"_3518":133539},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_4070":81511,"_34195":81486,"_23354":133541,"_5":16137,"_30763":133479,"_3518":133542},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_4070":81512,"_34195":81486,"_23354":133544,"_5":16137,"_30763":133483,"_3518":133545},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_4070":81513,"_34195":81513,"_5":16540,"_3518":133547,"_34626":133548,"_23354":133549,"_30763":81513},"Utiliza Lamassu como SaaS",[56672,133396,133397],[],{"_4070":81514,"_34195":81513,"_23354":133551,"_5":16137,"_30763":81513,"_3518":133552},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_4070":81515,"_34195":81513,"_5":34623,"_23354":133554,"_30763":133555,"_3518":133556},[],"/docs/pr-preview/pr-58/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_4070":81516,"_34195":81513,"_5":34623,"_23354":133558,"_30763":133559,"_3518":133560},[],"/docs/pr-preview/pr-58/es/deployment/saas#planes","Planes",{"_4070":81517,"_34195":81513,"_5":34623,"_23354":133562,"_30763":133563,"_3518":133564},[],"/docs/pr-preview/pr-58/es/deployment/saas#solicita-acceso","Solicita acceso",{"_4070":81518,"_34195":81513,"_23354":133566,"_5":16137,"_30763":81513,"_3518":133567},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_4070":81519,"_34195":81513,"_23354":133569,"_5":16137,"_30763":133555,"_3518":133570},[],"Disponibilidad y mantenimiento de la plataforma.",{"_4070":81520,"_34195":81513,"_23354":133572,"_5":16137,"_30763":133555,"_3518":133573},[],"Copias de seguridad automáticas.",{"_4070":81521,"_34195":81513,"_23354":133575,"_5":16137,"_30763":133555,"_3518":133576},[],"Actualizaciones de versión.",{"_4070":81522,"_34195":81513,"_23354":133578,"_5":16137,"_30763":133555,"_3518":133579},[],"Soporte técnico y SLA según el plan contratado.",{"_4070":81523,"_34195":81513,"_23354":133581,"_5":16137,"_30763":133559,"_3518":56863},[],{"_4070":81524,"_34195":81513,"_23354":133583,"_5":16137,"_30763":133559,"_3518":133584},[],"Dispositivos",{"_4070":81525,"_34195":81513,"_23354":133586,"_5":16137,"_30763":133559,"_3518":133587},[],"Soporte",{"_4070":81526,"_34195":81513,"_23354":133589,"_5":16137,"_30763":133559,"_3518":56872},[],{"_4070":81527,"_34195":81513,"_23354":133591,"_5":16137,"_30763":133559,"_3518":56875},[],{"_4070":81528,"_34195":81513,"_23354":133593,"_5":16137,"_30763":133559,"_3518":133594},[],"Hasta 1.000",{"_4070":81529,"_34195":81513,"_23354":133596,"_5":16137,"_30763":133559,"_3518":56881},[],{"_4070":81530,"_34195":81513,"_23354":133598,"_5":16137,"_30763":133559,"_3518":133599},[],"99,5 %",{"_4070":81531,"_34195":81513,"_23354":133601,"_5":16137,"_30763":133559,"_3518":56887},[],{"_4070":81532,"_34195":81513,"_23354":133603,"_5":16137,"_30763":133559,"_3518":133604},[],"Hasta 10.000",{"_4070":81533,"_34195":81513,"_23354":133606,"_5":16137,"_30763":133559,"_3518":133607},[],"Email y chat",{"_4070":81534,"_34195":81513,"_23354":133609,"_5":16137,"_30763":133559,"_3518":133610},[],"99,9 %",{"_4070":81535,"_34195":81513,"_23354":133612,"_5":16137,"_30763":133559,"_3518":56899},[],{"_4070":81536,"_34195":81513,"_23354":133614,"_5":16137,"_30763":133559,"_3518":133615},[],"Ilimitados",{"_4070":81537,"_34195":81513,"_23354":133617,"_5":16137,"_30763":133559,"_3518":133618},[],"Dedicado",{"_4070":81538,"_34195":81513,"_23354":133620,"_5":16137,"_30763":133559,"_3518":133621},[],"99,99 %",{"_4070":81539,"_34195":81513,"_23354":133623,"_5":16137,"_30763":133563,"_3518":133624},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_4070":81540,"_34195":81513,"_23354":133626,"_5":16137,"_30763":133563,"_3518":133627},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_4070":81541,"_34195":81541,"_5":16540,"_3518":56916,"_34626":133629,"_23354":133631,"_30763":81541},[56672,133396,133630],"Kubernetes autogestionado",[],{"_4070":81542,"_34195":81541,"_23354":133633,"_5":16137,"_30763":81541,"_3518":133634},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_4070":81543,"_34195":81541,"_5":34623,"_23354":133636,"_30763":133637,"_3518":133638},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_4070":81544,"_34195":81541,"_5":34623,"_23354":133640,"_30763":133641,"_3518":133642},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_4070":81545,"_34195":81541,"_5":34623,"_23354":133644,"_30763":133645,"_3518":133646},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_4070":81546,"_34195":81541,"_5":34623,"_23354":133648,"_30763":133649,"_3518":133650},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_4070":81547,"_34195":81541,"_5":34623,"_23354":133652,"_30763":133653,"_3518":133654},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_4070":81548,"_34195":81541,"_5":34623,"_23354":133656,"_30763":133657,"_3518":133658},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_4070":81549,"_34195":81541,"_5":34623,"_23354":133660,"_30763":133661,"_3518":133662},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_4070":81550,"_34195":81541,"_5":34623,"_23354":133664,"_30763":133665,"_3518":133666},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_4070":81551,"_34195":81541,"_5":34623,"_23354":133668,"_30763":133669,"_3518":133670},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_4070":81552,"_34195":81541,"_5":34623,"_23354":133672,"_30763":133673,"_3518":133674},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_4070":81553,"_34195":81541,"_5":34623,"_23354":133676,"_30763":133677,"_3518":133678},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_4070":81554,"_34195":81541,"_23354":133680,"_5":16137,"_30763":133637,"_3518":133681},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_4070":81555,"_34195":81541,"_23354":133683,"_5":16137,"_30763":133637,"_3518":133684},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_4070":81556,"_34195":81541,"_23354":133686,"_5":16137,"_30763":133641,"_3518":133687},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_4070":81557,"_34195":81541,"_23354":133689,"_5":16137,"_30763":133641,"_3518":133690},[],"Fastlane instala o configura",{"_4070":81558,"_34195":81541,"_23354":133692,"_5":16137,"_30763":133641,"_3518":133693},[],"Tú sigues proporcionando",{"_4070":81559,"_34195":81541,"_23354":133695,"_5":16137,"_30763":133641,"_3518":133696},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_4070":81560,"_34195":81541,"_23354":133698,"_5":16137,"_30763":133641,"_3518":133699},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_4070":81561,"_34195":81541,"_23354":133701,"_5":16137,"_30763":133641,"_3518":133702},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_4070":81562,"_34195":81541,"_23354":133704,"_5":16137,"_30763":133641,"_3518":133705},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_4070":81563,"_34195":81541,"_23354":133707,"_5":16137,"_30763":133641,"_3518":133708},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_4070":81564,"_34195":81541,"_23354":133710,"_5":16137,"_30763":133641,"_3518":133711},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_4070":81565,"_34195":81541,"_23354":133713,"_5":16137,"_30763":133641,"_3518":133714},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_4070":81566,"_34195":81541,"_23354":133716,"_5":16137,"_30763":133641,"_3518":133717},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_4070":81567,"_34195":81541,"_23354":133719,"_5":16137,"_30763":133641,"_3518":133720},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_4070":81568,"_34195":81541,"_23354":133722,"_5":16137,"_30763":133645,"_3518":133723},[],"Necesitas:",{"_4070":81569,"_34195":81541,"_23354":133725,"_5":16137,"_30763":133645,"_3518":133726},[],"un clúster Kubernetes existente",{"_4070":81570,"_34195":81541,"_23354":133728,"_5":16137,"_30763":133645,"_3518":133729},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_4070":81571,"_34195":81541,"_23354":133731,"_5":16137,"_30763":133645,"_3518":57018},[],{"_4070":81572,"_34195":81541,"_23354":133733,"_5":16137,"_30763":133645,"_3518":26466},[],{"_4070":81573,"_34195":81541,"_23354":133735,"_5":16137,"_30763":133645,"_3518":133736},[],"`jq` solo si usas `--sample-data` o `--development`",{"_4070":81574,"_34195":81541,"_23354":133738,"_5":16137,"_30763":133645,"_3518":133739},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_4070":81575,"_34195":81541,"_23354":133741,"_5":16137,"_30763":133645,"_3518":133742},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_4070":81576,"_34195":81541,"_23354":133744,"_5":16137,"_30763":133645,"_3518":133745},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_4070":81577,"_34195":81541,"_23354":133747,"_5":16137,"_30763":133645,"_3518":133748},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_4070":81578,"_34195":81541,"_23354":133750,"_5":16137,"_30763":133649,"_3518":133751},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_4070":81579,"_34195":81541,"_23354":133753,"_5":16137,"_30763":133649,"_3518":133754},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_4070":81580,"_34195":81541,"_23354":133756,"_5":16137,"_30763":133653,"_3518":133757},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_4070":81581,"_34195":81541,"_23354":133759,"_5":16137,"_30763":133653,"_3518":133760},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_4070":81582,"_34195":81541,"_23354":133762,"_5":16137,"_30763":133653,"_3518":133763},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_4070":81583,"_34195":81541,"_23354":133765,"_5":16137,"_30763":133653,"_3518":133766},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_4070":81584,"_34195":81541,"_23354":133768,"_5":16137,"_30763":133657,"_3518":133769},[],"Opción",{"_4070":81585,"_34195":81541,"_23354":133771,"_5":16137,"_30763":133657,"_3518":133772},[],"Valor predeterminado",{"_4070":81586,"_34195":81541,"_23354":133774,"_5":16137,"_30763":133657,"_3518":133775},[],"Propósito",{"_4070":81587,"_34195":81541,"_23354":133777,"_5":16137,"_30763":133657,"_3518":57065},[],{"_4070":81588,"_34195":81541,"_23354":133779,"_5":16137,"_30763":133657,"_3518":57068},[],{"_4070":81589,"_34195":81541,"_23354":133781,"_5":16137,"_30763":133657,"_3518":133782},[],"Muestra la ayuda",{"_4070":81590,"_34195":81541,"_23354":133784,"_5":16137,"_30763":133657,"_3518":57074},[],{"_4070":81591,"_34195":81541,"_23354":133786,"_5":16137,"_30763":133657,"_3518":133787},[],"contexto actual",{"_4070":81592,"_34195":81541,"_23354":133789,"_5":16137,"_30763":133657,"_3518":133790},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_4070":81593,"_34195":81541,"_23354":133792,"_5":16137,"_30763":133657,"_3518":57083},[],{"_4070":81594,"_34195":81541,"_23354":133794,"_5":16137,"_30763":133657,"_3518":7390},[],{"_4070":81595,"_34195":81541,"_23354":133796,"_5":16137,"_30763":133657,"_3518":133797},[],"Omite prompts y genera credenciales para las dependencias",{"_4070":81596,"_34195":81541,"_23354":133799,"_5":16137,"_30763":133657,"_3518":57091},[],{"_4070":81597,"_34195":81541,"_23354":133801,"_5":16137,"_30763":133657,"_3518":57094},[],{"_4070":81598,"_34195":81541,"_23354":133803,"_5":16137,"_30763":133657,"_3518":133804},[],"Namespace de la instalación",{"_4070":81599,"_34195":81541,"_23354":133806,"_5":16137,"_30763":133657,"_3518":57100},[],{"_4070":81600,"_34195":81541,"_23354":133808,"_5":16137,"_30763":133657,"_3518":57103},[],{"_4070":81601,"_34195":81541,"_23354":133810,"_5":16137,"_30763":133657,"_3518":133811},[],"Dominio usado por la UI, OIDC y el certificado",{"_4070":81602,"_34195":81541,"_23354":133813,"_5":16137,"_30763":133657,"_3518":57109},[],{"_4070":81603,"_34195":81541,"_23354":133815,"_5":16137,"_30763":133657,"_3518":16975},[],{"_4070":81604,"_34195":81541,"_23354":133817,"_5":16137,"_30763":133657,"_3518":133818},[],"Versión del chart de Lamassu",{"_4070":81605,"_34195":81541,"_23354":133820,"_5":16137,"_30763":133657,"_3518":57117},[],{"_4070":81606,"_34195":81541,"_23354":133822,"_5":16137,"_30763":133657,"_3518":57120},[],{"_4070":81607,"_34195":81541,"_23354":133824,"_5":16137,"_30763":133657,"_3518":133825},[],"Puerto del listener HTTPS",{"_4070":81608,"_34195":81541,"_23354":133827,"_5":16137,"_30763":133657,"_3518":57126},[],{"_4070":81609,"_34195":81541,"_23354":133829,"_5":16137,"_30763":133657,"_3518":57129},[],{"_4070":81610,"_34195":81541,"_23354":133831,"_5":16137,"_30763":133657,"_3518":133832},[],"Puerto del listener HTTP",{"_4070":81611,"_34195":81541,"_23354":133834,"_5":16137,"_30763":133657,"_3518":57135},[],{"_4070":81612,"_34195":81541,"_23354":133836,"_5":16137,"_30763":133657,"_3518":57068},[],{"_4070":81613,"_34195":81541,"_23354":133838,"_5":16137,"_30763":133657,"_3518":133839},[],"Certificado PEM para TLS downstream",{"_4070":81614,"_34195":81541,"_23354":133841,"_5":16137,"_30763":133657,"_3518":57143},[],{"_4070":81615,"_34195":81541,"_23354":133843,"_5":16137,"_30763":133657,"_3518":57068},[],{"_4070":81616,"_34195":81541,"_23354":133845,"_5":16137,"_30763":133657,"_3518":133846},[],"Clave privada PEM para TLS downstream",{"_4070":81617,"_34195":81541,"_23354":133848,"_5":16137,"_30763":133657,"_3518":57151},[],{"_4070":81618,"_34195":81541,"_23354":133850,"_5":16137,"_30763":133657,"_3518":133851},[],"chart del repositorio",{"_4070":81619,"_34195":81541,"_23354":133853,"_5":16137,"_30763":133657,"_3518":133854},[],"Usa un chart local de Lamassu sin empaquetar",{"_4070":81620,"_34195":81541,"_23354":133856,"_5":16137,"_30763":133657,"_3518":57160},[],{"_4070":81621,"_34195":81541,"_23354":133858,"_5":16137,"_30763":133657,"_3518":133859},[],"detección automática",{"_4070":81622,"_34195":81541,"_23354":133861,"_5":16137,"_30763":133657,"_3518":133862},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_4070":81623,"_34195":81541,"_23354":133864,"_5":16137,"_30763":133657,"_3518":57168},[],{"_4070":81624,"_34195":81541,"_23354":133866,"_5":16137,"_30763":133657,"_3518":7390},[],{"_4070":81625,"_34195":81541,"_23354":133868,"_5":16137,"_30763":133657,"_3518":133869},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_4070":81626,"_34195":81541,"_23354":133871,"_5":16137,"_30763":133657,"_3518":57176},[],{"_4070":81627,"_34195":81541,"_23354":133873,"_5":16137,"_30763":133657,"_3518":7390},[],{"_4070":81628,"_34195":81541,"_23354":133875,"_5":16137,"_30763":133657,"_3518":133876},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_4070":81629,"_34195":81541,"_23354":133878,"_5":16137,"_30763":133657,"_3518":57184},[],{"_4070":81630,"_34195":81541,"_23354":133880,"_5":16137,"_30763":133657,"_3518":7390},[],{"_4070":81631,"_34195":81541,"_23354":133882,"_5":16137,"_30763":133657,"_3518":133883},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_4070":81632,"_34195":81541,"_23354":133885,"_5":16137,"_30763":133657,"_3518":57192},[],{"_4070":81633,"_34195":81541,"_23354":133887,"_5":16137,"_30763":133657,"_3518":7390},[],{"_4070":81634,"_34195":81541,"_23354":133889,"_5":16137,"_30763":133657,"_3518":133890},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_4070":81635,"_34195":81541,"_23354":133892,"_5":16137,"_30763":133657,"_3518":57200},[],{"_4070":81636,"_34195":81541,"_23354":133894,"_5":16137,"_30763":133657,"_3518":57203},[],{"_4070":81637,"_34195":81541,"_23354":133896,"_5":16137,"_30763":133657,"_3518":133897},[],"Usa otro chart local de SoftHSM",{"_4070":81638,"_34195":81541,"_23354":133899,"_5":16137,"_30763":133657,"_3518":133900},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_4070":81639,"_34195":81541,"_23354":133902,"_5":16137,"_30763":133661,"_3518":133903},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_4070":81640,"_34195":81541,"_23354":133905,"_5":16137,"_30763":133661,"_3518":133906},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_4070":81641,"_34195":81541,"_23354":133908,"_5":16137,"_30763":133661,"_3518":133909},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_4070":81642,"_34195":81541,"_23354":133911,"_5":16137,"_30763":133661,"_3518":133912},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_4070":81643,"_34195":81541,"_23354":133914,"_5":16137,"_30763":133661,"_3518":133915},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_4070":81644,"_34195":81541,"_23354":133917,"_5":16137,"_30763":133661,"_3518":133918},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_4070":81645,"_34195":81541,"_23354":133920,"_5":16137,"_30763":133665,"_3518":57230},[],{"_4070":81646,"_34195":81541,"_23354":133922,"_5":16137,"_30763":133665,"_3518":133923},[],"valida las herramientas locales y el clúster seleccionado",{"_4070":81647,"_34195":81541,"_23354":133925,"_5":16137,"_30763":133665,"_3518":133926},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_4070":81648,"_34195":81541,"_23354":133928,"_5":16137,"_30763":133665,"_3518":133929},[],"crea el namespace",{"_4070":81649,"_34195":81541,"_23354":133931,"_5":16137,"_30763":133665,"_3518":133932},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_4070":81650,"_34195":81541,"_23354":133934,"_5":16137,"_30763":133665,"_3518":133935},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_4070":81651,"_34195":81541,"_23354":133937,"_5":16137,"_30763":133665,"_3518":133938},[],"instala RabbitMQ",{"_4070":81652,"_34195":81541,"_23354":133940,"_5":16137,"_30763":133665,"_3518":133941},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_4070":81653,"_34195":81541,"_23354":133943,"_5":16137,"_30763":133665,"_3518":133944},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_4070":81654,"_34195":81541,"_23354":133946,"_5":16137,"_30763":133665,"_3518":133947},[],"carga datos de ejemplo opcionalmente",{"_4070":81655,"_34195":81541,"_23354":133949,"_5":16137,"_30763":133665,"_3518":133950},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_4070":81656,"_34195":81541,"_23354":133952,"_5":16137,"_30763":133669,"_3518":133953},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_4070":81657,"_34195":81541,"_23354":133955,"_5":16137,"_30763":133669,"_3518":133956},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_4070":81658,"_34195":81541,"_23354":133958,"_5":16137,"_30763":133673,"_3518":133959},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_4070":81659,"_34195":81541,"_23354":133961,"_5":16137,"_30763":133673,"_3518":133962},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_4070":81660,"_34195":81541,"_23354":133964,"_5":16137,"_30763":133673,"_3518":133965},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_4070":81661,"_34195":81541,"_23354":133967,"_5":16137,"_30763":133677,"_3518":133968},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_4070":81662,"_34195":81662,"_5":16540,"_3518":133970,"_34626":133971,"_23354":133972,"_30763":81662},"Instala con Helm",[56672,133396,133630],[],{"_4070":81663,"_34195":81662,"_23354":133974,"_5":16137,"_30763":81662,"_3518":133975},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_4070":81664,"_34195":81662,"_5":34623,"_23354":133977,"_30763":133978,"_3518":133979},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_4070":81665,"_34195":81662,"_5":34623,"_23354":133981,"_30763":133982,"_3518":133646},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#antes-de-comenzar",{"_4070":81666,"_34195":81662,"_5":34623,"_23354":133984,"_30763":133985,"_3518":133986},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_4070":81667,"_34195":81662,"_5":34623,"_23354":133988,"_30763":133989,"_3518":133990},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_4070":81668,"_34195":81662,"_5":34623,"_23354":133992,"_30763":133993,"_3518":133994},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_4070":81669,"_34195":81662,"_5":34623,"_23354":133996,"_30763":133997,"_3518":133998},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_4070":81670,"_34195":81662,"_5":34623,"_23354":134000,"_30763":134001,"_3518":134002},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_4070":81671,"_34195":81662,"_5":34623,"_23354":134004,"_30763":134005,"_3518":134006},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_4070":81672,"_34195":81662,"_5":34623,"_23354":134008,"_30763":134009,"_3518":134010},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_4070":81673,"_34195":81662,"_5":34623,"_23354":134012,"_30763":134013,"_3518":134014},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_4070":81674,"_34195":81662,"_5":34623,"_23354":134016,"_30763":134017,"_3518":134018},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_4070":81675,"_34195":81662,"_23354":134020,"_5":16137,"_30763":133978,"_3518":134021},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_4070":81676,"_34195":81662,"_23354":134023,"_5":16137,"_30763":133982,"_3518":134024},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_4070":81677,"_34195":81662,"_23354":134026,"_5":16137,"_30763":133982,"_3518":134027},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_4070":81678,"_34195":81662,"_23354":134029,"_5":16137,"_30763":133982,"_3518":134030},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_4070":81679,"_34195":81662,"_23354":134032,"_5":16137,"_30763":133982,"_3518":134033},[],"un broker RabbitMQ accesible y sus credenciales",{"_4070":81680,"_34195":81662,"_23354":134035,"_5":16137,"_30763":133982,"_3518":134036},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_4070":81681,"_34195":81662,"_23354":134038,"_5":16137,"_30763":133982,"_3518":134039},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_4070":81682,"_34195":81662,"_23354":134041,"_5":16137,"_30763":133982,"_3518":134042},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_4070":81683,"_34195":81662,"_23354":134044,"_5":16137,"_30763":133982,"_3518":134045},[],"una StorageClass y un diseño de tráfico externo",{"_4070":81684,"_34195":81662,"_23354":134047,"_5":16137,"_30763":133982,"_3518":134048},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_4070":81685,"_34195":81662,"_23354":134050,"_5":16137,"_30763":133982,"_3518":134051},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_4070":81686,"_34195":81662,"_23354":134053,"_5":16137,"_30763":133982,"_3518":134054},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_4070":81687,"_34195":81662,"_23354":134056,"_5":16137,"_30763":133985,"_3518":134057},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_4070":81688,"_34195":81662,"_23354":134059,"_5":16137,"_30763":133985,"_3518":134060},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_4070":81689,"_34195":81662,"_23354":134062,"_5":16137,"_30763":133985,"_3518":134063},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_4070":81690,"_34195":81662,"_23354":134065,"_5":16137,"_30763":133989,"_3518":134066},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_4070":81691,"_34195":81662,"_23354":134068,"_5":16137,"_30763":133989,"_3518":134069},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_4070":81692,"_34195":81662,"_23354":134071,"_5":16137,"_30763":133989,"_3518":134072},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_4070":81693,"_34195":81662,"_23354":134074,"_5":16137,"_30763":133989,"_3518":134075},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_4070":81694,"_34195":81662,"_23354":134077,"_5":16137,"_30763":133993,"_3518":134078},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_4070":81695,"_34195":81662,"_23354":134080,"_5":16137,"_30763":133997,"_3518":134081},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_4070":81696,"_34195":81662,"_23354":134083,"_5":16137,"_30763":133997,"_3518":134084},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_4070":81697,"_34195":81662,"_23354":134086,"_5":16137,"_30763":133997,"_3518":134087},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_4070":81698,"_34195":81662,"_23354":134089,"_5":16137,"_30763":133997,"_3518":134090},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_4070":81699,"_34195":81662,"_23354":134092,"_5":16137,"_30763":133997,"_3518":134093},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_4070":81700,"_34195":81662,"_23354":134095,"_5":16137,"_30763":133997,"_3518":134096},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_4070":81701,"_34195":81662,"_23354":134098,"_5":16137,"_30763":133997,"_3518":134099},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_4070":81702,"_34195":81662,"_23354":134101,"_5":16137,"_30763":134001,"_3518":134102},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_4070":81703,"_34195":81662,"_23354":134104,"_5":16137,"_30763":134001,"_3518":134105},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_4070":81704,"_34195":81662,"_23354":134107,"_5":16137,"_30763":134001,"_3518":134108},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_4070":81705,"_34195":81662,"_23354":134110,"_5":16137,"_30763":134001,"_3518":134111},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_4070":81706,"_34195":81662,"_23354":134113,"_5":16137,"_30763":134005,"_3518":134114},[],"Para instalar un checkout local:",{"_4070":81707,"_34195":81662,"_23354":134116,"_5":16137,"_30763":134009,"_3518":134117},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_4070":81708,"_34195":81662,"_23354":134119,"_5":16137,"_30763":134009,"_3518":134120},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_4070":81709,"_34195":81662,"_23354":134122,"_5":16137,"_30763":134013,"_3518":134123},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_4070":81710,"_34195":81662,"_23354":134125,"_5":16137,"_30763":134013,"_3518":134126},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_4070":81711,"_34195":81662,"_23354":134128,"_5":16137,"_30763":134013,"_3518":134129},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_4070":81712,"_34195":81662,"_23354":134131,"_5":16137,"_30763":134013,"_3518":134132},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_4070":81713,"_34195":81662,"_23354":134134,"_5":16137,"_30763":134013,"_3518":134135},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_4070":81714,"_34195":81662,"_23354":134137,"_5":16137,"_30763":134017,"_3518":134138},[],"Antes de pasar a producción, revisa:",{"_4070":81715,"_34195":81662,"_23354":134140,"_5":16137,"_30763":134017,"_3518":134141},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_4070":81716,"_34195":81662,"_23354":134143,"_5":16137,"_30763":134017,"_3518":134144},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_4070":81717,"_34195":81662,"_23354":134146,"_5":16137,"_30763":134017,"_3518":134147},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_4070":81718,"_34195":81662,"_23354":134149,"_5":16137,"_30763":134017,"_3518":134150},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_4070":81719,"_34195":81662,"_23354":134152,"_5":16137,"_30763":134017,"_3518":134153},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_4070":81720,"_34195":81662,"_23354":134155,"_5":16137,"_30763":134017,"_3518":134156},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_4070":81721,"_34195":81662,"_23354":134158,"_5":16137,"_30763":134017,"_3518":134159},[],"SMTP, observabilidad y entrega de alertas",{"_4070":81722,"_34195":81662,"_23354":134161,"_5":16137,"_30763":134017,"_3518":134162},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_4070":81723,"_34195":81662,"_23354":134164,"_5":16137,"_30763":134017,"_3518":134165},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_4070":81724,"_34195":81724,"_5":16540,"_3518":134167,"_34626":134168,"_23354":134169,"_30763":81724},"Expón el Gateway",[56672,133396,133630],[],{"_4070":81725,"_34195":81724,"_23354":134171,"_5":16137,"_30763":81724,"_3518":134172},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_4070":81726,"_34195":81724,"_5":34623,"_23354":134174,"_30763":134175,"_3518":134176},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_4070":81727,"_34195":81724,"_5":34623,"_23354":134178,"_30763":134179,"_3518":134180},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_4070":81728,"_34195":81724,"_5":34623,"_23354":134182,"_30763":134183,"_3518":134184},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_4070":81729,"_34195":81724,"_5":34623,"_23354":134186,"_30763":134187,"_3518":57498},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#k3s",{"_4070":81730,"_34195":81724,"_5":34623,"_23354":134189,"_30763":134190,"_3518":134191},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_4070":81731,"_34195":81724,"_5":34623,"_23354":134193,"_30763":134194,"_3518":134195},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_4070":81732,"_34195":81724,"_5":34623,"_23354":134197,"_30763":134198,"_3518":134199},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_4070":81733,"_34195":81724,"_5":34623,"_23354":134201,"_30763":134202,"_3518":134203},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_4070":81734,"_34195":81724,"_5":34623,"_23354":134205,"_30763":134206,"_3518":134207},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_4070":81735,"_34195":81724,"_5":34623,"_23354":134209,"_30763":134210,"_3518":134211},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_4070":81736,"_34195":81724,"_23354":134213,"_5":16137,"_30763":134175,"_3518":134214},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_4070":81737,"_34195":81724,"_23354":134216,"_5":16137,"_30763":134175,"_3518":134217},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_4070":81738,"_34195":81724,"_23354":134219,"_5":16137,"_30763":134179,"_3518":134220},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_4070":81739,"_34195":81724,"_23354":134222,"_5":16137,"_30763":134179,"_3518":134223},[],"Defínelo únicamente cuando:",{"_4070":81740,"_34195":81724,"_23354":134225,"_5":16137,"_30763":134179,"_3518":134226},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_4070":81741,"_34195":81724,"_23354":134228,"_5":16137,"_30763":134179,"_3518":134229},[],"esa dirección está asignada a este Gateway",{"_4070":81742,"_34195":81724,"_23354":134231,"_5":16137,"_30763":134179,"_3518":134232},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_4070":81743,"_34195":81724,"_23354":134234,"_5":16137,"_30763":134179,"_3518":134235},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_4070":81744,"_34195":81724,"_23354":134237,"_5":16137,"_30763":134179,"_3518":134238},[],"No confundas estos valores:",{"_4070":81745,"_34195":81724,"_23354":134240,"_5":16137,"_30763":134179,"_3518":134241},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_4070":81746,"_34195":81724,"_23354":134243,"_5":16137,"_30763":134179,"_3518":134244},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_4070":81747,"_34195":81724,"_23354":134246,"_5":16137,"_30763":134179,"_3518":134247},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_4070":81748,"_34195":81724,"_23354":134249,"_5":16137,"_30763":134183,"_3518":134250},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_4070":81749,"_34195":81724,"_23354":134252,"_5":16137,"_30763":134183,"_3518":134253},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_4070":81750,"_34195":81724,"_23354":134255,"_5":16137,"_30763":134187,"_3518":134256},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_4070":81751,"_34195":81724,"_23354":134258,"_5":16137,"_30763":134187,"_3518":134259},[],"Para el diseño recomendado:",{"_4070":81752,"_34195":81724,"_23354":134261,"_5":16137,"_30763":134187,"_3518":134262},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_4070":81753,"_34195":81724,"_23354":134264,"_5":16137,"_30763":134187,"_3518":134265},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_4070":81754,"_34195":81724,"_23354":134267,"_5":16137,"_30763":134187,"_3518":134268},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_4070":81755,"_34195":81724,"_23354":134270,"_5":16137,"_30763":134187,"_3518":134271},[],"Apunta DNS a la dirección accesible de la VM.",{"_4070":81756,"_34195":81724,"_23354":134273,"_5":16137,"_30763":134187,"_3518":134274},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_4070":81757,"_34195":81724,"_23354":134276,"_5":16137,"_30763":134190,"_3518":134277},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_4070":81758,"_34195":81724,"_23354":134279,"_5":16137,"_30763":134194,"_3518":134280},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_4070":81759,"_34195":81724,"_23354":134282,"_5":16137,"_30763":134194,"_3518":134283},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_4070":81760,"_34195":81724,"_23354":134285,"_5":16137,"_30763":134198,"_3518":134286},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_4070":81761,"_34195":81724,"_23354":134288,"_5":16137,"_30763":134198,"_3518":134289},[],"Requisito",{"_4070":81762,"_34195":81724,"_23354":134291,"_5":16137,"_30763":134198,"_3518":134292},[],"Diseño recomendado",{"_4070":81763,"_34195":81724,"_23354":134294,"_5":16137,"_30763":134198,"_3518":134295},[],"Consecuencia",{"_4070":81764,"_34195":81724,"_23354":134297,"_5":16137,"_30763":134198,"_3518":134298},[],"Varias URL o servicios de Lamassu",{"_4070":81765,"_34195":81724,"_23354":134300,"_5":16137,"_30763":134198,"_3518":134301},[],"Un Gateway con varias rutas",{"_4070":81766,"_34195":81724,"_23354":134303,"_5":16137,"_30763":134198,"_3518":134304},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_4070":81767,"_34195":81724,"_23354":134306,"_5":16137,"_30763":134198,"_3518":134307},[],"Gateways independientes e IP externas distintas",{"_4070":81768,"_34195":81724,"_23354":134309,"_5":16137,"_30763":134198,"_3518":134310},[],"Una VIP por Gateway",{"_4070":81769,"_34195":81724,"_23354":134312,"_5":16137,"_30763":134198,"_3518":134313},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_4070":81770,"_34195":81724,"_23354":134315,"_5":16137,"_30763":134198,"_3518":134316},[],"Gateways independientes, un nodo y una IP",{"_4070":81771,"_34195":81724,"_23354":134318,"_5":16137,"_30763":134198,"_3518":134319},[],"Puertos externos diferentes",{"_4070":81772,"_34195":81724,"_23354":134321,"_5":16137,"_30763":134198,"_3518":134322},[],"Los clientes deben indicar puertos no estándar",{"_4070":81773,"_34195":81724,"_23354":134324,"_5":16137,"_30763":134198,"_3518":134325},[],"Terminación TLS/mTLS separada detrás de una IP",{"_4070":81774,"_34195":81724,"_23354":134327,"_5":16137,"_30763":134198,"_3518":134328},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_4070":81775,"_34195":81724,"_23354":134330,"_5":16137,"_30763":134198,"_3518":134331},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_4070":81776,"_34195":81724,"_23354":134333,"_5":16137,"_30763":134198,"_3518":134334},[],"Recursos Gateway separados pero proxy compartido",{"_4070":81777,"_34195":81724,"_23354":134336,"_5":16137,"_30763":134198,"_3518":134337},[],"Modo merged Gateway de Envoy",{"_4070":81778,"_34195":81724,"_23354":134339,"_5":16137,"_30763":134198,"_3518":134340},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_4070":81779,"_34195":81724,"_23354":134342,"_5":16137,"_30763":134198,"_3518":134343},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_4070":81780,"_34195":81724,"_23354":134345,"_5":16137,"_30763":134198,"_3518":134346},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_4070":81781,"_34195":81724,"_23354":134348,"_5":16137,"_30763":134198,"_3518":134349},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_4070":81782,"_34195":81724,"_23354":134351,"_5":16137,"_30763":134198,"_3518":134352},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_4070":81783,"_34195":81724,"_23354":134354,"_5":16137,"_30763":134202,"_3518":134355},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_4070":81784,"_34195":81724,"_23354":134357,"_5":16137,"_30763":134202,"_3518":134358},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_4070":81785,"_34195":81724,"_23354":134360,"_5":16137,"_30763":134202,"_3518":134361},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_4070":81786,"_34195":81724,"_23354":134363,"_5":16137,"_30763":134202,"_3518":134364},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_4070":81787,"_34195":81724,"_23354":134366,"_5":16137,"_30763":134202,"_3518":134367},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_4070":81788,"_34195":81724,"_23354":134369,"_5":16137,"_30763":134206,"_3518":134370},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_4070":81789,"_34195":81724,"_23354":134372,"_5":16137,"_30763":134206,"_3518":134373},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_4070":81790,"_34195":81724,"_23354":134375,"_5":16137,"_30763":134210,"_3518":134376},[],"Comprueba, en orden:",{"_4070":81791,"_34195":81724,"_23354":134378,"_5":16137,"_30763":134210,"_3518":134379},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_4070":81792,"_34195":81724,"_23354":134381,"_5":16137,"_30763":134210,"_3518":134382},[],"Su estado contiene la dirección esperada.",{"_4070":81793,"_34195":81724,"_23354":134384,"_5":16137,"_30763":134210,"_3518":134385},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_4070":81794,"_34195":81724,"_23354":134387,"_5":16137,"_30763":134210,"_3518":134388},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_4070":81795,"_34195":81724,"_23354":134390,"_5":16137,"_30763":134210,"_3518":134391},[],"DNS resuelve al endpoint accesible externamente.",{"_4070":81796,"_34195":81724,"_23354":134393,"_5":16137,"_30763":134210,"_3518":134394},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_4070":81797,"_34195":81724,"_23354":134396,"_5":16137,"_30763":134210,"_3518":134397},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_4070":81798,"_34195":81798,"_5":16540,"_3518":56779,"_34626":134399,"_23354":134400,"_30763":81798},[56672,133396,133630],[],{"_4070":81799,"_34195":81798,"_23354":134402,"_5":16137,"_30763":81798,"_3518":134403},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_4070":81800,"_34195":81798,"_5":34623,"_23354":134405,"_30763":134406,"_3518":134407},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_4070":81801,"_34195":81798,"_5":34623,"_23354":134409,"_30763":134410,"_3518":134411},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_4070":81802,"_34195":81798,"_5":34623,"_23354":134413,"_30763":134414,"_3518":134415},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_4070":81803,"_34195":81798,"_5":34623,"_23354":134417,"_30763":134418,"_3518":134419},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_4070":81804,"_34195":81798,"_5":34623,"_23354":134421,"_30763":134422,"_3518":134423},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_4070":81805,"_34195":81798,"_5":34623,"_23354":134425,"_30763":134426,"_3518":134427},[],"/docs/pr-preview/pr-58/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_4070":81806,"_34195":81798,"_23354":134429,"_5":16137,"_30763":134406,"_3518":134430},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_4070":81807,"_34195":81798,"_23354":134432,"_5":16137,"_30763":134410,"_3518":134433},[],"Flujo",{"_4070":81808,"_34195":81798,"_23354":134435,"_5":16137,"_30763":134410,"_3518":134436},[],"Úsalo para",{"_4070":81809,"_34195":81798,"_23354":134438,"_5":16137,"_30763":134410,"_3518":134439},[],"Qué instala",{"_4070":81810,"_34195":81798,"_23354":134441,"_5":16137,"_30763":134410,"_3518":57753},[],{"_4070":81811,"_34195":81798,"_23354":134443,"_5":16137,"_30763":134410,"_3518":134444},[],"Producción y entornos controlados",{"_4070":81812,"_34195":81798,"_23354":134446,"_5":16137,"_30763":134410,"_3518":134447},[],"Servicios de Lamassu y recursos de Gateway API",{"_4070":81813,"_34195":81798,"_23354":134449,"_5":16137,"_30763":134410,"_3518":56916},[],{"_4070":81814,"_34195":81798,"_23354":134451,"_5":16137,"_30763":134410,"_3518":134452},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_4070":81815,"_34195":81798,"_23354":134454,"_5":16137,"_30763":134410,"_3518":134455},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_4070":81816,"_34195":81798,"_23354":134457,"_5":16137,"_30763":134414,"_3518":134458},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_4070":81817,"_34195":81798,"_23354":134460,"_5":16137,"_30763":134414,"_3518":134461},[],"Área",{"_4070":81818,"_34195":81798,"_23354":134463,"_5":16137,"_30763":134414,"_3518":134464},[],"El chart de Lamassu proporciona",{"_4070":81819,"_34195":81798,"_23354":134466,"_5":16137,"_30763":134414,"_3518":134467},[],"Tú proporcionas",{"_4070":81820,"_34195":81798,"_23354":134469,"_5":16137,"_30763":134414,"_3518":134470},[],"Aplicaciones Lamassu",{"_4070":81821,"_34195":81798,"_23354":134472,"_5":16137,"_30763":134414,"_3518":134473},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_4070":81822,"_34195":81798,"_23354":134475,"_5":16137,"_30763":134414,"_3518":134476},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_4070":81823,"_34195":81798,"_23354":134478,"_5":16137,"_30763":134414,"_3518":134479},[],"Datos PostgreSQL",{"_4070":81824,"_34195":81798,"_23354":134481,"_5":16137,"_30763":134414,"_3518":134482},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_4070":81825,"_34195":81798,"_23354":134484,"_5":16137,"_30763":134414,"_3518":134485},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_4070":81826,"_34195":81798,"_23354":134487,"_5":16137,"_30763":134414,"_3518":134488},[],"Mensajería",{"_4070":81827,"_34195":81798,"_23354":134490,"_5":16137,"_30763":134414,"_3518":134491},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_4070":81828,"_34195":81798,"_23354":134493,"_5":16137,"_30763":134414,"_3518":134494},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_4070":81829,"_34195":81798,"_23354":134496,"_5":16137,"_30763":134414,"_3518":134497},[],"Identidad",{"_4070":81830,"_34195":81798,"_23354":134499,"_5":16137,"_30763":134414,"_3518":134500},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_4070":81831,"_34195":81798,"_23354":134502,"_5":16137,"_30763":134414,"_3518":134503},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_4070":81832,"_34195":81798,"_23354":134505,"_5":16137,"_30763":134414,"_3518":134506},[],"Enrutamiento externo",{"_4070":81833,"_34195":81798,"_23354":134508,"_5":16137,"_30763":134414,"_3518":134509},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_4070":81834,"_34195":81798,"_23354":134511,"_5":16137,"_30763":134414,"_3518":134512},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_4070":81835,"_34195":81798,"_23354":134514,"_5":16137,"_30763":134414,"_3518":57827},[],{"_4070":81836,"_34195":81798,"_23354":134516,"_5":16137,"_30763":134414,"_3518":134517},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_4070":81837,"_34195":81798,"_23354":134519,"_5":16137,"_30763":134414,"_3518":134520},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_4070":81838,"_34195":81798,"_23354":134522,"_5":16137,"_30763":134414,"_3518":134523},[],"Datos persistentes de la aplicación",{"_4070":81839,"_34195":81798,"_23354":134525,"_5":16137,"_30763":134414,"_3518":134526},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_4070":81840,"_34195":81798,"_23354":134528,"_5":16137,"_30763":134414,"_3518":134529},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_4070":81841,"_34195":81798,"_23354":134531,"_5":16137,"_30763":134414,"_3518":134532},[],"Integraciones opcionales",{"_4070":81842,"_34195":81798,"_23354":134534,"_5":16137,"_30763":134414,"_3518":134535},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_4070":81843,"_34195":81798,"_23354":134537,"_5":16137,"_30763":134414,"_3518":134538},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_4070":81844,"_34195":81798,"_23354":134540,"_5":16137,"_30763":134414,"_3518":134541},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_4070":81845,"_34195":81798,"_23354":134543,"_5":16137,"_30763":134414,"_3518":134544},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_4070":81846,"_34195":81798,"_23354":134546,"_5":16137,"_30763":134418,"_3518":134547},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_4070":81847,"_34195":81798,"_23354":134549,"_5":16137,"_30763":134418,"_3518":134550},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_4070":81848,"_34195":81798,"_23354":134552,"_5":16137,"_30763":134422,"_3518":134553},[],"Kubernetes 1.24 o posterior",{"_4070":81849,"_34195":81798,"_23354":134555,"_5":16137,"_30763":134422,"_3518":134556},[],"Helm 3.2 o posterior",{"_4070":81850,"_34195":81798,"_23354":134558,"_5":16137,"_30763":134422,"_3518":134559},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_4070":81851,"_34195":81798,"_23354":134561,"_5":16137,"_30763":134422,"_3518":134562},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_4070":81852,"_34195":81798,"_23354":134564,"_5":16137,"_30763":134422,"_3518":134565},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_4070":81853,"_34195":81798,"_23354":134567,"_5":16137,"_30763":134422,"_3518":134568},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_4070":81854,"_34195":81798,"_23354":134570,"_5":16137,"_30763":134422,"_3518":134571},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_4070":81855,"_34195":81798,"_23354":134573,"_5":16137,"_30763":134426,"_3518":134574},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_4070":81856,"_34195":81798,"_23354":134576,"_5":16137,"_30763":134426,"_3518":134577},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_4070":81857,"_34195":81798,"_23354":134579,"_5":16137,"_30763":134426,"_3518":134580},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_4070":81858,"_34195":81798,"_23354":134582,"_5":16137,"_30763":134426,"_3518":134583},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_4070":81859,"_34195":81859,"_5":16540,"_3518":134585,"_34626":134586,"_23354":134588,"_30763":81859},"Resolución de problemas de despliegue",[56672,133396,134587],"Operación",[],{"_4070":81860,"_34195":81859,"_23354":134590,"_5":16137,"_30763":81859,"_3518":134591},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_4070":81861,"_34195":81859,"_5":34623,"_23354":134593,"_30763":134594,"_3518":134595},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_4070":81862,"_34195":81859,"_5":34623,"_23354":134597,"_30763":134598,"_3518":134599},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_4070":81863,"_34195":81859,"_5":34623,"_23354":134601,"_30763":134602,"_3518":134603},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_4070":81864,"_34195":81859,"_5":34623,"_23354":134605,"_30763":134606,"_3518":134607},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_4070":81865,"_34195":81859,"_5":34623,"_23354":134609,"_30763":134610,"_3518":134611},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_4070":81866,"_34195":81859,"_5":34623,"_23354":134613,"_30763":134614,"_3518":134615},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_4070":81867,"_34195":81859,"_5":34623,"_23354":134617,"_30763":134618,"_3518":134619},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_4070":81868,"_34195":81859,"_5":34623,"_23354":134621,"_30763":134622,"_3518":134623},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_4070":81869,"_34195":81859,"_5":34623,"_23354":134625,"_30763":134626,"_3518":134627},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_4070":81870,"_34195":81859,"_5":34623,"_23354":134629,"_30763":134630,"_3518":134631},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_4070":81871,"_34195":81859,"_5":34623,"_23354":134633,"_30763":134634,"_3518":134635},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_4070":81872,"_34195":81859,"_5":34623,"_23354":134637,"_30763":134638,"_3518":134639},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_4070":81873,"_34195":81859,"_5":34623,"_23354":134641,"_30763":134642,"_3518":134643},[],"/docs/pr-preview/pr-58/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_4070":81874,"_34195":81859,"_23354":134645,"_5":16137,"_30763":81859,"_3518":134646},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_4070":81875,"_34195":81859,"_23354":134648,"_5":16137,"_30763":134598,"_3518":134649},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_4070":81876,"_34195":81859,"_23354":134651,"_5":16137,"_30763":134602,"_3518":134652},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_4070":81877,"_34195":81859,"_23354":134654,"_5":16137,"_30763":134606,"_3518":134655},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_4070":81878,"_34195":81859,"_23354":134657,"_5":16137,"_30763":134610,"_3518":134658},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_4070":81879,"_34195":81859,"_23354":134660,"_5":16137,"_30763":134614,"_3518":134661},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_4070":81880,"_34195":81859,"_23354":134663,"_5":16137,"_30763":134618,"_3518":134664},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_4070":81881,"_34195":81859,"_23354":134666,"_5":16137,"_30763":134618,"_3518":134667},[],"Ejecuta también la prueba de conectividad del chart:",{"_4070":81882,"_34195":81859,"_23354":134669,"_5":16137,"_30763":134618,"_3518":134670},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_4070":81883,"_34195":81859,"_23354":134672,"_5":16137,"_30763":134618,"_3518":134673},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_4070":81884,"_34195":81859,"_23354":134675,"_5":16137,"_30763":134622,"_3518":134676},[],"Si recibes un 401:",{"_4070":81885,"_34195":81859,"_23354":134678,"_5":16137,"_30763":134622,"_3518":134679},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_4070":81886,"_34195":81859,"_23354":134681,"_5":16137,"_30763":134622,"_3518":134682},[],"verifica emisor, audiencia y expiración del token;",{"_4070":81887,"_34195":81859,"_23354":134684,"_5":16137,"_30763":134622,"_3518":134685},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_4070":81888,"_34195":81859,"_23354":134687,"_5":16137,"_30763":134622,"_3518":134688},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_4070":81889,"_34195":81859,"_23354":134690,"_5":16137,"_30763":134622,"_3518":134691},[],"Si el login termina pero las APIs devuelven 403:",{"_4070":81890,"_34195":81859,"_23354":134693,"_5":16137,"_30763":134622,"_3518":134694},[],"inspecciona los claims reales del token;",{"_4070":81891,"_34195":81859,"_23354":134696,"_5":16137,"_30763":134622,"_3518":134697},[],"confirma que coinciden con un principal activo;",{"_4070":81892,"_34195":81859,"_23354":134699,"_5":16137,"_30763":134622,"_3518":134700},[],"revisa las políticas concedidas al principal;",{"_4070":81893,"_34195":81859,"_23354":134702,"_5":16137,"_30763":134622,"_3518":134703},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_4070":81894,"_34195":81859,"_23354":134705,"_5":16137,"_30763":134622,"_3518":134706},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_4070":81895,"_34195":81859,"_23354":134708,"_5":16137,"_30763":134626,"_3518":134709},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_4070":81896,"_34195":81859,"_23354":134711,"_5":16137,"_30763":134626,"_3518":134712},[],"Localiza el pod y Service de authz.",{"_4070":81897,"_34195":81859,"_23354":134714,"_5":16137,"_30763":134626,"_3518":134715},[],"Comprueba /health, logs y conexión a su base de datos.",{"_4070":81898,"_34195":81859,"_23354":134717,"_5":16137,"_30763":134626,"_3518":134718},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_4070":81899,"_34195":81859,"_23354":134720,"_5":16137,"_30763":134626,"_3518":134721},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_4070":81900,"_34195":81859,"_23354":134723,"_5":16137,"_30763":134626,"_3518":134724},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_4070":81901,"_34195":81859,"_23354":134726,"_5":16137,"_30763":134630,"_3518":134727},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_4070":81902,"_34195":81859,"_23354":134729,"_5":16137,"_30763":134634,"_3518":134730},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_4070":81903,"_34195":81859,"_23354":134732,"_5":16137,"_30763":134634,"_3518":134733},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_4070":81904,"_34195":81859,"_23354":134735,"_5":16137,"_30763":134634,"_3518":134736},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_4070":81905,"_34195":81859,"_23354":134738,"_5":16137,"_30763":134634,"_3518":134739},[],"volumen persistente sin enlazar;",{"_4070":81906,"_34195":81859,"_23354":134741,"_5":16137,"_30763":134634,"_3518":134742},[],"imagen inaccesible o política de pull incorrecta;",{"_4070":81907,"_34195":81859,"_23354":134744,"_5":16137,"_30763":134634,"_3518":134745},[],"configuración inválida del motor criptográfico;",{"_4070":81908,"_34195":81859,"_23354":134747,"_5":16137,"_30763":134634,"_3518":134748},[],"límites de CPU o memoria demasiado bajos;",{"_4070":81909,"_34195":81859,"_23354":134750,"_5":16137,"_30763":134634,"_3518":134751},[],"migración previa incompleta.",{"_4070":81910,"_34195":81859,"_23354":134753,"_5":16137,"_30763":134634,"_3518":134754},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_4070":81911,"_34195":81859,"_23354":134756,"_5":16137,"_30763":134634,"_3518":134757},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_4070":81912,"_34195":81859,"_23354":134759,"_5":16137,"_30763":134634,"_3518":134760},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_4070":81913,"_34195":81859,"_23354":134762,"_5":16137,"_30763":134638,"_3518":134763},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_4070":81914,"_34195":81859,"_23354":134765,"_5":16137,"_30763":134638,"_3518":134766},[],"verifica que esté habilitado en el servicio emisor;",{"_4070":81915,"_34195":81859,"_23354":134768,"_5":16137,"_30763":134638,"_3518":134769},[],"comprueba conectividad y credenciales AMQP;",{"_4070":81916,"_34195":81859,"_23354":134771,"_5":16137,"_30763":134638,"_3518":134772},[],"revisa exchange, routing key, colas y consumidores;",{"_4070":81917,"_34195":81859,"_23354":134774,"_5":16137,"_30763":134638,"_3518":134775},[],"inspecciona dead-letter queues;",{"_4070":81918,"_34195":81859,"_23354":134777,"_5":16137,"_30763":134638,"_3518":134778},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_4070":81919,"_34195":81859,"_23354":134780,"_5":16137,"_30763":134638,"_3518":134781},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_4070":81920,"_34195":81859,"_23354":134783,"_5":16137,"_30763":134638,"_3518":134784},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_4070":81921,"_34195":81859,"_23354":134786,"_5":16137,"_30763":134638,"_3518":134787},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_4070":81922,"_34195":81859,"_23354":134789,"_5":16137,"_30763":134638,"_3518":134790},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_4070":81923,"_34195":81859,"_23354":134792,"_5":16137,"_30763":134638,"_3518":134793},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_4070":81924,"_34195":81859,"_23354":134795,"_5":16137,"_30763":134638,"_3518":134796},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_4070":81925,"_34195":81859,"_23354":134798,"_5":16137,"_30763":134638,"_3518":134799},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_4070":81926,"_34195":81859,"_23354":134801,"_5":16137,"_30763":134642,"_3518":134802},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_4070":81927,"_34195":81859,"_23354":134804,"_5":16137,"_30763":134642,"_3518":134805},[],"Antes de cerrar una incidencia, guarda:",{"_4070":81928,"_34195":81859,"_23354":134807,"_5":16137,"_30763":134642,"_3518":134808},[],"causa confirmada;",{"_4070":81929,"_34195":81859,"_23354":134810,"_5":16137,"_30763":134642,"_3518":134811},[],"alcance temporal y recursos afectados;",{"_4070":81930,"_34195":81859,"_23354":134813,"_5":16137,"_30763":134642,"_3518":134814},[],"comandos o consultas utilizados;",{"_4070":81931,"_34195":81859,"_23354":134816,"_5":16137,"_30763":134642,"_3518":134817},[],"cambio aplicado y forma de revertirlo;",{"_4070":81932,"_34195":81859,"_23354":134819,"_5":16137,"_30763":134642,"_3518":134820},[],"validación desde un consumidor;",{"_4070":81933,"_34195":81859,"_23354":134822,"_5":16137,"_30763":134642,"_3518":134823},[],"acción preventiva y propietario.",{"_4070":81934,"_34195":81934,"_5":16540,"_3518":134825,"_34626":134826,"_23354":134829,"_30763":81934},"Control de acceso",[56672,134827,134828],"Plataforma","Administración",[],{"_4070":81935,"_34195":81934,"_23354":134831,"_5":16137,"_30763":81934,"_3518":134832},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_4070":81936,"_34195":81934,"_5":34623,"_23354":134834,"_30763":134835,"_3518":134836},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_4070":81937,"_34195":81934,"_5":34623,"_23354":134838,"_30763":134839,"_3518":134840},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_4070":81938,"_34195":81934,"_5":34623,"_23354":134842,"_30763":134843,"_3518":134844},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_4070":81939,"_34195":81934,"_5":34623,"_23354":134846,"_30763":134847,"_3518":134848},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_4070":81940,"_34195":81934,"_5":34623,"_23354":134850,"_30763":134851,"_3518":134852},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_4070":81941,"_34195":81934,"_5":34623,"_23354":134854,"_30763":134855,"_3518":134856},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_4070":81942,"_34195":81934,"_5":34623,"_23354":134858,"_30763":134859,"_3518":134860},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_4070":81943,"_34195":81934,"_5":34623,"_23354":134862,"_30763":134863,"_3518":134864},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#principales-x509","Principales X.509",{"_4070":81944,"_34195":81934,"_5":34623,"_23354":134866,"_30763":134867,"_3518":134868},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_4070":81945,"_34195":81934,"_5":34623,"_23354":134870,"_30763":134871,"_3518":134872},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_4070":81946,"_34195":81934,"_5":34623,"_23354":134874,"_30763":134875,"_3518":134876},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_4070":81947,"_34195":81934,"_5":34623,"_23354":134878,"_30763":134879,"_3518":134880},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_4070":81948,"_34195":81934,"_5":34623,"_23354":134882,"_30763":134883,"_3518":134884},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_4070":81949,"_34195":81934,"_5":34623,"_23354":134886,"_30763":134887,"_3518":134888},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_4070":81950,"_34195":81934,"_5":34623,"_23354":134890,"_30763":134891,"_3518":134892},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_4070":81951,"_34195":81934,"_5":34623,"_23354":134894,"_30763":134895,"_3518":134002},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_4070":81952,"_34195":81934,"_5":34623,"_23354":134897,"_30763":134898,"_3518":134899},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_4070":81953,"_34195":81934,"_5":34623,"_23354":134901,"_30763":134902,"_3518":134903},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_4070":81954,"_34195":81934,"_5":34623,"_23354":134905,"_30763":134906,"_3518":134907},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_4070":81955,"_34195":81934,"_5":34623,"_23354":134909,"_30763":134910,"_3518":134911},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_4070":81956,"_34195":81934,"_5":34623,"_23354":134913,"_30763":134914,"_3518":134915},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_4070":81957,"_34195":81934,"_5":34623,"_23354":134917,"_30763":134918,"_3518":134919},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_4070":81958,"_34195":81934,"_5":34623,"_23354":134921,"_30763":134922,"_3518":134923},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_4070":81959,"_34195":81934,"_5":34623,"_23354":134925,"_30763":134926,"_3518":134927},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_4070":81960,"_34195":81934,"_5":34623,"_23354":134929,"_30763":134930,"_3518":134931},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_4070":81961,"_34195":81934,"_5":34623,"_23354":134933,"_30763":134934,"_3518":134935},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_4070":81962,"_34195":81934,"_5":34623,"_23354":134937,"_30763":134938,"_3518":134939},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_4070":81963,"_34195":81934,"_5":34623,"_23354":134941,"_30763":134942,"_3518":134943},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_4070":81964,"_34195":81934,"_5":34623,"_23354":134945,"_30763":134946,"_3518":134947},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_4070":81965,"_34195":81934,"_5":34623,"_23354":134949,"_30763":134950,"_3518":134951},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_4070":81966,"_34195":81934,"_5":34623,"_23354":134953,"_30763":134954,"_3518":134955},[],"/docs/pr-preview/pr-58/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_4070":81967,"_34195":81934,"_23354":134957,"_5":16137,"_30763":81934,"_3518":134958},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_4070":81968,"_34195":81934,"_23354":134960,"_5":16137,"_30763":81934,"_3518":134961},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_4070":81969,"_34195":81934,"_23354":134963,"_5":16137,"_30763":81934,"_3518":134964},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_4070":81970,"_34195":81934,"_23354":134966,"_5":16137,"_30763":134835,"_3518":134967},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_4070":81971,"_34195":81934,"_23354":134969,"_5":16137,"_30763":134835,"_3518":134970},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_4070":81972,"_34195":81934,"_23354":134972,"_5":16137,"_30763":134835,"_3518":134973},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_4070":81973,"_34195":81934,"_23354":134975,"_5":16137,"_30763":134835,"_3518":134976},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_4070":81974,"_34195":81934,"_23354":134978,"_5":16137,"_30763":134835,"_3518":134979},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_4070":81975,"_34195":81934,"_23354":134981,"_5":16137,"_30763":134835,"_3518":134982},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_4070":81976,"_34195":81934,"_23354":134984,"_5":16137,"_30763":134839,"_3518":134985},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_4070":81977,"_34195":81934,"_23354":134987,"_5":16137,"_30763":134839,"_3518":134988},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_4070":81978,"_34195":81934,"_23354":134990,"_5":16137,"_30763":134843,"_3518":134991},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_4070":81979,"_34195":81934,"_23354":134993,"_5":16137,"_30763":134843,"_3518":134994},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_4070":81980,"_34195":81934,"_23354":134996,"_5":16137,"_30763":134843,"_3518":134997},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_4070":81981,"_34195":81934,"_23354":134999,"_5":16137,"_30763":134843,"_3518":135000},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_4070":81982,"_34195":81934,"_23354":135002,"_5":16137,"_30763":134843,"_3518":135003},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_4070":81983,"_34195":81934,"_23354":135005,"_5":16137,"_30763":134843,"_3518":135006},[],"Carga por separado las políticas concedidas a cada principal.",{"_4070":81984,"_34195":81934,"_23354":135008,"_5":16137,"_30763":134843,"_3518":135009},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_4070":81985,"_34195":81934,"_23354":135011,"_5":16137,"_30763":134843,"_3518":135012},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_4070":81986,"_34195":81934,"_23354":135014,"_5":16137,"_30763":134843,"_3518":135015},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_4070":81987,"_34195":81934,"_23354":135017,"_5":16137,"_30763":134843,"_3518":135018},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_4070":81988,"_34195":81934,"_23354":135020,"_5":16137,"_30763":134843,"_3518":135021},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_4070":81989,"_34195":81934,"_23354":135023,"_5":16137,"_30763":134843,"_3518":135024},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_4070":81990,"_34195":81934,"_23354":135026,"_5":16137,"_30763":134847,"_3518":135027},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_4070":81991,"_34195":81934,"_23354":135029,"_5":16137,"_30763":134847,"_3518":135030},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_4070":81992,"_34195":81934,"_23354":135032,"_5":16137,"_30763":134847,"_3518":135033},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_4070":81993,"_34195":81934,"_23354":135035,"_5":16137,"_30763":134847,"_3518":135036},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_4070":81994,"_34195":81934,"_23354":135038,"_5":16137,"_30763":134847,"_3518":135039},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_4070":81995,"_34195":81934,"_23354":135041,"_5":16137,"_30763":134847,"_3518":135042},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_4070":81996,"_34195":81934,"_23354":135044,"_5":16137,"_30763":134847,"_3518":135045},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_4070":81997,"_34195":81934,"_23354":135047,"_5":16137,"_30763":134847,"_3518":135048},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_4070":81998,"_34195":81934,"_23354":135050,"_5":16137,"_30763":134851,"_3518":135051},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_4070":81999,"_34195":81934,"_23354":135053,"_5":16137,"_30763":134851,"_3518":135054},[],"La decisión se toma con el contexto de la operación de dominio:",{"_4070":82000,"_34195":81934,"_23354":135056,"_5":16137,"_30763":134851,"_3518":135057},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_4070":82001,"_34195":81934,"_23354":135059,"_5":16137,"_30763":134851,"_3518":135060},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_4070":82002,"_34195":81934,"_23354":135062,"_5":16137,"_30763":134851,"_3518":135063},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_4070":82003,"_34195":81934,"_23354":135065,"_5":16137,"_30763":134851,"_3518":135066},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_4070":82004,"_34195":81934,"_23354":135068,"_5":16137,"_30763":134851,"_3518":135069},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_4070":82005,"_34195":81934,"_23354":135071,"_5":16137,"_30763":134851,"_3518":135072},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_4070":82006,"_34195":81934,"_23354":135074,"_5":16137,"_30763":134851,"_3518":135075},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_4070":82007,"_34195":81934,"_23354":135077,"_5":16137,"_30763":134851,"_3518":135078},[],"Las acciones se dividen en dos grupos:",{"_4070":82008,"_34195":81934,"_23354":135080,"_5":16137,"_30763":134851,"_3518":135081},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_4070":82009,"_34195":81934,"_23354":135083,"_5":16137,"_30763":134851,"_3518":135084},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_4070":82010,"_34195":81934,"_23354":135086,"_5":16137,"_30763":134851,"_3518":135087},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_4070":82011,"_34195":81934,"_23354":135089,"_5":16137,"_30763":134855,"_3518":135090},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_4070":82012,"_34195":81934,"_23354":135092,"_5":16137,"_30763":134855,"_3518":135093},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_4070":82013,"_34195":81934,"_23354":135095,"_5":16137,"_30763":134855,"_3518":135096},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_4070":82014,"_34195":81934,"_23354":135098,"_5":16137,"_30763":134859,"_3518":135099},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_4070":82015,"_34195":81934,"_23354":135101,"_5":16137,"_30763":134859,"_3518":135102},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_4070":82016,"_34195":81934,"_23354":135104,"_5":16137,"_30763":134859,"_3518":135105},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_4070":82017,"_34195":81934,"_23354":135107,"_5":16137,"_30763":134859,"_3518":135108},[],"Los operadores implementados son:",{"_4070":82018,"_34195":81934,"_23354":135110,"_5":16137,"_30763":134859,"_3518":135111},[],"`equals`, para igualdad exacta;",{"_4070":82019,"_34195":81934,"_23354":135113,"_5":16137,"_30763":134859,"_3518":135114},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_4070":82020,"_34195":81934,"_23354":135116,"_5":16137,"_30763":134859,"_3518":135117},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_4070":82021,"_34195":81934,"_23354":135119,"_5":16137,"_30763":134859,"_3518":135120},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_4070":82022,"_34195":81934,"_23354":135122,"_5":16137,"_30763":134863,"_3518":135123},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_4070":82023,"_34195":81934,"_23354":135125,"_5":16137,"_30763":134863,"_3518":135126},[],"Los modos disponibles son:",{"_4070":82024,"_34195":81934,"_23354":135128,"_5":16137,"_30763":134863,"_3518":135129},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_4070":82025,"_34195":81934,"_23354":135131,"_5":16137,"_30763":134863,"_3518":135132},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_4070":82026,"_34195":81934,"_23354":135134,"_5":16137,"_30763":134863,"_3518":135135},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_4070":82027,"_34195":81934,"_23354":135137,"_5":16137,"_30763":134863,"_3518":135138},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_4070":82028,"_34195":81934,"_23354":135140,"_5":16137,"_30763":134863,"_3518":135141},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_4070":82029,"_34195":81934,"_23354":135143,"_5":16137,"_30763":134863,"_3518":135144},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_4070":82030,"_34195":81934,"_23354":135146,"_5":16137,"_30763":134867,"_3518":135147},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_4070":82031,"_34195":81934,"_23354":135149,"_5":16137,"_30763":134867,"_3518":135150},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_4070":82032,"_34195":81934,"_23354":135152,"_5":16137,"_30763":134867,"_3518":135153},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_4070":82033,"_34195":81934,"_23354":135155,"_5":16137,"_30763":134867,"_3518":135156},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_4070":82034,"_34195":81934,"_23354":135158,"_5":16137,"_30763":134875,"_3518":135159},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_4070":82035,"_34195":81934,"_23354":135161,"_5":16137,"_30763":134875,"_3518":135162},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_4070":82036,"_34195":81934,"_23354":135164,"_5":16137,"_30763":134879,"_3518":135165},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_4070":82037,"_34195":81934,"_23354":135167,"_5":16137,"_30763":134879,"_3518":135168},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_4070":82038,"_34195":81934,"_23354":135170,"_5":16137,"_30763":134883,"_3518":135171},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_4070":82039,"_34195":81934,"_23354":135173,"_5":16137,"_30763":134883,"_3518":135174},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_4070":82040,"_34195":81934,"_23354":135176,"_5":16137,"_30763":134883,"_3518":135177},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_4070":82041,"_34195":81934,"_23354":135179,"_5":16137,"_30763":134887,"_3518":135180},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_4070":82042,"_34195":81934,"_23354":135182,"_5":16137,"_30763":134887,"_3518":135183},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_4070":82043,"_34195":81934,"_23354":135185,"_5":16137,"_30763":134887,"_3518":135186},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_4070":82044,"_34195":81934,"_23354":135188,"_5":16137,"_30763":134887,"_3518":135189},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_4070":82045,"_34195":81934,"_23354":135191,"_5":16137,"_30763":134887,"_3518":135192},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_4070":82046,"_34195":81934,"_23354":135194,"_5":16137,"_30763":134887,"_3518":135195},[],"Ten en cuenta que:",{"_4070":82047,"_34195":81934,"_23354":135197,"_5":16137,"_30763":134887,"_3518":135198},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_4070":82048,"_34195":81934,"_23354":135200,"_5":16137,"_30763":134887,"_3518":135201},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_4070":82049,"_34195":81934,"_23354":135203,"_5":16137,"_30763":134887,"_3518":135204},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_4070":82050,"_34195":81934,"_23354":135206,"_5":16137,"_30763":134891,"_3518":135207},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_4070":82051,"_34195":81934,"_23354":135209,"_5":16137,"_30763":134891,"_3518":135210},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_4070":82052,"_34195":81934,"_23354":135212,"_5":16137,"_30763":134891,"_3518":135213},[],"acceso completo y de solo lectura a KMS;",{"_4070":82053,"_34195":81934,"_23354":135215,"_5":16137,"_30763":134891,"_3518":135216},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_4070":82054,"_34195":81934,"_23354":135218,"_5":16137,"_30763":134891,"_3518":135219},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_4070":82055,"_34195":81934,"_23354":135221,"_5":16137,"_30763":134891,"_3518":135222},[],"acceso a la interfaz;",{"_4070":82056,"_34195":81934,"_23354":135224,"_5":16137,"_30763":134891,"_3518":135225},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_4070":82057,"_34195":81934,"_23354":135227,"_5":16137,"_30763":134891,"_3518":135228},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_4070":82058,"_34195":81934,"_23354":135230,"_5":16137,"_30763":134891,"_3518":135231},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_4070":82059,"_34195":81934,"_23354":135233,"_5":16137,"_30763":134895,"_3518":135234},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_4070":82060,"_34195":81934,"_23354":135236,"_5":16137,"_30763":134895,"_3518":135237},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_4070":82061,"_34195":81934,"_23354":135239,"_5":16137,"_30763":134895,"_3518":135240},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_4070":82062,"_34195":81934,"_23354":135242,"_5":16137,"_30763":134898,"_3518":135243},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_4070":82063,"_34195":81934,"_23354":135245,"_5":16137,"_30763":134902,"_3518":135246},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_4070":82064,"_34195":81934,"_23354":135248,"_5":16137,"_30763":134902,"_3518":135249},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_4070":82065,"_34195":81934,"_23354":135251,"_5":16137,"_30763":134906,"_3518":135252},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_4070":82066,"_34195":81934,"_23354":135254,"_5":16137,"_30763":134910,"_3518":135255},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_4070":82067,"_34195":81934,"_23354":135257,"_5":16137,"_30763":134914,"_3518":135258},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_4070":82068,"_34195":81934,"_23354":135260,"_5":16137,"_30763":134918,"_3518":135261},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_4070":82069,"_34195":81934,"_23354":135263,"_5":16137,"_30763":134918,"_3518":135264},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_4070":82070,"_34195":81934,"_23354":135266,"_5":16137,"_30763":134922,"_3518":135267},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_4070":82071,"_34195":81934,"_23354":135269,"_5":16137,"_30763":134922,"_3518":135270},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_4070":82072,"_34195":81934,"_23354":135272,"_5":16137,"_30763":134922,"_3518":135273},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_4070":82073,"_34195":81934,"_23354":135275,"_5":16137,"_30763":134922,"_3518":135276},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_4070":82074,"_34195":81934,"_23354":135278,"_5":16137,"_30763":134922,"_3518":135279},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_4070":82075,"_34195":81934,"_23354":135281,"_5":16137,"_30763":134922,"_3518":135282},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_4070":82076,"_34195":81934,"_23354":135284,"_5":16137,"_30763":134922,"_3518":135285},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_4070":82077,"_34195":81934,"_23354":135287,"_5":16137,"_30763":134922,"_3518":135288},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_4070":82078,"_34195":81934,"_23354":135290,"_5":16137,"_30763":134926,"_3518":135291},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_4070":82079,"_34195":81934,"_23354":135293,"_5":16137,"_30763":134926,"_3518":135294},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_4070":82080,"_34195":81934,"_23354":135296,"_5":16137,"_30763":134926,"_3518":135297},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_4070":82081,"_34195":81934,"_23354":135299,"_5":16137,"_30763":134930,"_3518":135300},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_4070":82082,"_34195":81934,"_23354":135302,"_5":16137,"_30763":134930,"_3518":135303},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_4070":82083,"_34195":81934,"_23354":135305,"_5":16137,"_30763":134930,"_3518":135306},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_4070":82084,"_34195":81934,"_23354":135308,"_5":16137,"_30763":134930,"_3518":135309},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_4070":82085,"_34195":81934,"_23354":135311,"_5":16137,"_30763":134930,"_3518":135312},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_4070":82086,"_34195":81934,"_23354":135314,"_5":16137,"_30763":134930,"_3518":135315},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_4070":82087,"_34195":81934,"_23354":135317,"_5":16137,"_30763":134930,"_3518":135318},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_4070":82088,"_34195":81934,"_23354":135320,"_5":16137,"_30763":134930,"_3518":135321},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_4070":82089,"_34195":81934,"_23354":135323,"_5":16137,"_30763":134938,"_3518":135324},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_4070":82090,"_34195":81934,"_23354":135326,"_5":16137,"_30763":134942,"_3518":135327},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_4070":82091,"_34195":81934,"_23354":135329,"_5":16137,"_30763":134942,"_3518":135330},[],"que exista un principal activo del tipo correcto;",{"_4070":82092,"_34195":81934,"_23354":135332,"_5":16137,"_30763":134942,"_3518":135333},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_4070":82093,"_34195":81934,"_23354":135335,"_5":16137,"_30763":134942,"_3518":135336},[],"que todas las condiciones del principal se cumplan;",{"_4070":82094,"_34195":81934,"_23354":135338,"_5":16137,"_30763":134942,"_3518":135339},[],"que el principal tenga concedida la política esperada;",{"_4070":82095,"_34195":81934,"_23354":135341,"_5":16137,"_30763":134942,"_3518":135342},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_4070":82096,"_34195":81934,"_23354":135344,"_5":16137,"_30763":134942,"_3518":135345},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_4070":82097,"_34195":81934,"_23354":135347,"_5":16137,"_30763":134942,"_3518":135348},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_4070":82098,"_34195":81934,"_23354":135350,"_5":16137,"_30763":134946,"_3518":135351},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_4070":82099,"_34195":81934,"_23354":135353,"_5":16137,"_30763":134950,"_3518":135354},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_4070":82100,"_34195":81934,"_23354":135356,"_5":16137,"_30763":134954,"_3518":135357},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_4070":82101,"_34195":81934,"_23354":135359,"_5":16137,"_30763":134954,"_3518":135360},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_4070":82102,"_34195":82102,"_5":16540,"_3518":135362,"_34626":135363,"_23354":135364,"_30763":82102},"Alertas y suscripciones",[56672,134827,134828],[],{"_4070":82103,"_34195":82102,"_23354":135366,"_5":16137,"_30763":82102,"_3518":135367},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_4070":82104,"_34195":82102,"_5":34623,"_23354":135369,"_30763":135370,"_3518":135371},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_4070":82105,"_34195":82102,"_5":34623,"_23354":135373,"_30763":135374,"_3518":135375},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_4070":82106,"_34195":82102,"_5":34623,"_23354":135377,"_30763":135378,"_3518":135379},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_4070":82107,"_34195":82102,"_5":34623,"_23354":135381,"_30763":135382,"_3518":135383},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_4070":82108,"_34195":82102,"_5":34623,"_23354":135385,"_30763":135386,"_3518":135387},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_4070":82109,"_34195":82102,"_5":34623,"_23354":135389,"_30763":135390,"_3518":135391},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_4070":82110,"_34195":82102,"_5":34623,"_23354":135393,"_30763":135394,"_3518":135395},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_4070":82111,"_34195":82102,"_5":34623,"_23354":135397,"_30763":135398,"_3518":135399},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_4070":82112,"_34195":82102,"_5":34623,"_23354":135401,"_30763":135402,"_3518":135403},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_4070":82113,"_34195":82102,"_5":34623,"_23354":135405,"_30763":135406,"_3518":135407},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_4070":82114,"_34195":82102,"_5":34623,"_23354":135409,"_30763":135410,"_3518":135411},[],"/docs/pr-preview/pr-58/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_4070":82115,"_34195":82102,"_23354":135413,"_5":16137,"_30763":82102,"_3518":135414},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_4070":82116,"_34195":82102,"_23354":135416,"_5":16137,"_30763":135370,"_3518":135417},[],"Un servicio publica un evento de dominio.",{"_4070":82117,"_34195":82102,"_23354":135419,"_5":16137,"_30763":135370,"_3518":135420},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_4070":82118,"_34195":82102,"_23354":135422,"_5":16137,"_30763":135370,"_3518":135423},[],"El filtro de cada suscripción decide si debe notificarse.",{"_4070":82119,"_34195":82102,"_23354":135425,"_5":16137,"_30763":135370,"_3518":135426},[],"Lamassu entrega el evento al canal configurado.",{"_4070":82120,"_34195":82102,"_23354":135428,"_5":16137,"_30763":135370,"_3518":135429},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_4070":82121,"_34195":82102,"_23354":135431,"_5":16137,"_30763":135374,"_3518":135432},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_4070":82122,"_34195":82102,"_23354":135434,"_5":16137,"_30763":135374,"_3518":135435},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_4070":82123,"_34195":82102,"_23354":135437,"_5":16137,"_30763":135374,"_3518":135438},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_4070":82124,"_34195":82102,"_23354":135440,"_5":16137,"_30763":135374,"_3518":135441},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_4070":82125,"_34195":82102,"_23354":135443,"_5":16137,"_30763":135374,"_3518":135444},[],"`apikey_options` necesita `header` y `key`.",{"_4070":82126,"_34195":82102,"_23354":135446,"_5":16137,"_30763":135374,"_3518":135447},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_4070":82127,"_34195":82102,"_23354":135449,"_5":16137,"_30763":135374,"_3518":135450},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_4070":82128,"_34195":82102,"_23354":135452,"_5":16137,"_30763":135374,"_3518":135453},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_4070":82129,"_34195":82102,"_23354":135455,"_5":16137,"_30763":135382,"_3518":135456},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_4070":82130,"_34195":82102,"_23354":135458,"_5":16137,"_30763":135386,"_3518":135459},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_4070":82131,"_34195":82102,"_23354":135461,"_5":16137,"_30763":135390,"_3518":135462},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_4070":82132,"_34195":82102,"_23354":135464,"_5":16137,"_30763":135390,"_3518":135465},[],"**None** notifica todas las instancias del evento.",{"_4070":82133,"_34195":82102,"_23354":135467,"_5":16137,"_30763":135390,"_3518":135468},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_4070":82134,"_34195":82102,"_23354":135470,"_5":16137,"_30763":135390,"_3518":135471},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_4070":82135,"_34195":82102,"_23354":135473,"_5":16137,"_30763":135390,"_3518":135474},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_4070":82136,"_34195":82102,"_23354":135476,"_5":16137,"_30763":135390,"_3518":135477},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_4070":82137,"_34195":82102,"_23354":135479,"_5":16137,"_30763":135390,"_3518":135480},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_4070":82138,"_34195":82102,"_23354":135482,"_5":16137,"_30763":135394,"_3518":135483},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_4070":82139,"_34195":82102,"_23354":135485,"_5":16137,"_30763":135398,"_3518":135486},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_4070":82140,"_34195":82102,"_23354":135488,"_5":16137,"_30763":135398,"_3518":135489},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_4070":82141,"_34195":82102,"_23354":135491,"_5":16137,"_30763":135398,"_3518":135492},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_4070":82142,"_34195":82102,"_23354":135494,"_5":16137,"_30763":135398,"_3518":135495},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_4070":82143,"_34195":82102,"_23354":135497,"_5":16137,"_30763":135398,"_3518":135498},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_4070":82144,"_34195":82102,"_23354":135500,"_5":16137,"_30763":135398,"_3518":135501},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_4070":82145,"_34195":82102,"_23354":135503,"_5":16137,"_30763":135398,"_3518":135504},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_4070":82146,"_34195":82102,"_23354":135506,"_5":16137,"_30763":135398,"_3518":135507},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_4070":82147,"_34195":82102,"_23354":135509,"_5":16137,"_30763":135402,"_3518":135510},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_4070":82148,"_34195":82102,"_23354":135512,"_5":16137,"_30763":135402,"_3518":135513},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_4070":82149,"_34195":82102,"_23354":135515,"_5":16137,"_30763":135402,"_3518":135516},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_4070":82150,"_34195":82102,"_23354":135518,"_5":16137,"_30763":135402,"_3518":135519},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_4070":82151,"_34195":82102,"_23354":135521,"_5":16137,"_30763":135402,"_3518":135522},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_4070":82152,"_34195":82102,"_23354":135524,"_5":16137,"_30763":135402,"_3518":135525},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_4070":82153,"_34195":82102,"_23354":135527,"_5":16137,"_30763":135402,"_3518":135528},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_4070":82154,"_34195":82102,"_23354":135530,"_5":16137,"_30763":135402,"_3518":135531},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_4070":82155,"_34195":82102,"_23354":135533,"_5":16137,"_30763":135406,"_3518":135534},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_4070":82156,"_34195":82102,"_23354":135536,"_5":16137,"_30763":135406,"_3518":135537},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_4070":82157,"_34195":82102,"_23354":135539,"_5":16137,"_30763":135410,"_3518":135540},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_4070":82158,"_34195":82102,"_23354":135542,"_5":16137,"_30763":135410,"_3518":135543},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_4070":82159,"_34195":82102,"_23354":135545,"_5":16137,"_30763":135410,"_3518":135546},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_4070":82160,"_34195":82102,"_23354":135548,"_5":16137,"_30763":135410,"_3518":135549},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_4070":82161,"_34195":82102,"_23354":135551,"_5":16137,"_30763":135410,"_3518":135552},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_4070":82162,"_34195":82102,"_23354":135554,"_5":16137,"_30763":135410,"_3518":135555},[],"**Validación:** `va.role.crl.create`.",{"_4070":82163,"_34195":82102,"_23354":135557,"_5":16137,"_30763":135410,"_3518":135558},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_4070":82164,"_34195":82102,"_23354":135560,"_5":16137,"_30763":135410,"_3518":135561},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_4070":82165,"_34195":82165,"_5":16540,"_3518":135563,"_34626":135564,"_23354":135565,"_30763":82165},"Registros de auditoría",[56672,134827,134828],[],{"_4070":82166,"_34195":82165,"_23354":135567,"_5":16137,"_30763":82165,"_3518":135568},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_4070":82167,"_34195":82165,"_5":34623,"_23354":135570,"_30763":135571,"_3518":135572},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_4070":82168,"_34195":82165,"_5":34623,"_23354":135574,"_30763":135575,"_3518":135576},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#cobertura","Cobertura",{"_4070":82169,"_34195":82165,"_5":34623,"_23354":135578,"_30763":135579,"_3518":135580},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_4070":82170,"_34195":82165,"_5":34623,"_23354":135582,"_30763":135583,"_3518":135584},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_4070":82171,"_34195":82165,"_5":34623,"_23354":135586,"_30763":135587,"_3518":135588},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_4070":82172,"_34195":82165,"_5":34623,"_23354":135590,"_30763":135591,"_3518":135592},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_4070":82173,"_34195":82165,"_5":34623,"_23354":135594,"_30763":135595,"_3518":135596},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_4070":82174,"_34195":82165,"_5":34623,"_23354":135598,"_30763":135599,"_3518":135600},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_4070":82175,"_34195":82165,"_5":34623,"_23354":135602,"_30763":135603,"_3518":135604},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_4070":82176,"_34195":82165,"_5":34623,"_23354":135606,"_30763":135607,"_3518":135608},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_4070":82177,"_34195":82165,"_5":34623,"_23354":135610,"_30763":135611,"_3518":135612},[],"/docs/pr-preview/pr-58/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_4070":82178,"_34195":82165,"_23354":135614,"_5":16137,"_30763":82165,"_3518":135615},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_4070":82179,"_34195":82165,"_23354":135617,"_5":16137,"_30763":135571,"_3518":135618},[],"El cuerpo de auditoría incluye:",{"_4070":82180,"_34195":82165,"_23354":135620,"_5":16137,"_30763":135571,"_3518":135621},[],"input: datos recibidos por la operación;",{"_4070":82181,"_34195":82165,"_23354":135623,"_5":16137,"_30763":135571,"_3518":135624},[],"has\\_error: indica si el servicio devolvió un error;",{"_4070":82182,"_34195":82165,"_23354":135626,"_5":16137,"_30763":135571,"_3518":135627},[],"output: resultado producido o mensaje de error;",{"_4070":82183,"_34195":82165,"_23354":135629,"_5":16137,"_30763":135571,"_3518":135630},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_4070":82184,"_34195":82165,"_23354":135632,"_5":16137,"_30763":135571,"_3518":135633},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_4070":82185,"_34195":82165,"_23354":135635,"_5":16137,"_30763":135571,"_3518":135636},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_4070":82186,"_34195":82165,"_23354":135638,"_5":16137,"_30763":135575,"_3518":135639},[],"El backend aplica auditoría a mutaciones de:",{"_4070":82187,"_34195":82165,"_23354":135641,"_5":16137,"_30763":135575,"_3518":135642},[],"autoridades, certificados y perfiles de emisión;",{"_4070":82188,"_34195":82165,"_23354":135644,"_5":16137,"_30763":135575,"_3518":135645},[],"claves y motores KMS;",{"_4070":82189,"_34195":82165,"_23354":135647,"_5":16137,"_30763":135575,"_3518":135648},[],"dispositivos e identidades;",{"_4070":82190,"_34195":82165,"_23354":135650,"_5":16137,"_30763":135575,"_3518":135651},[],"DMS y operaciones de enrolamiento;",{"_4070":82191,"_34195":82165,"_23354":135653,"_5":16137,"_30763":135575,"_3518":135654},[],"funciones de validación y CRL;",{"_4070":82192,"_34195":82165,"_23354":135656,"_5":16137,"_30763":135575,"_3518":135657},[],"principales, políticas y concesiones de autorización.",{"_4070":82193,"_34195":82165,"_23354":135659,"_5":16137,"_30763":135575,"_3518":135660},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_4070":82194,"_34195":82165,"_23354":135662,"_5":16137,"_30763":135579,"_3518":135663},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_4070":82195,"_34195":82165,"_23354":135665,"_5":16137,"_30763":135579,"_3518":135666},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_4070":82196,"_34195":82165,"_23354":135668,"_5":16137,"_30763":135579,"_3518":135669},[],"Diseña el consumidor para:",{"_4070":82197,"_34195":82165,"_23354":135671,"_5":16137,"_30763":135579,"_3518":135672},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_4070":82198,"_34195":82165,"_23354":135674,"_5":16137,"_30763":135579,"_3518":135675},[],"conservar el CloudEvent completo sin modificar;",{"_4070":82199,"_34195":82165,"_23354":135677,"_5":16137,"_30763":135579,"_3518":135678},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_4070":82200,"_34195":82165,"_23354":135680,"_5":16137,"_30763":135579,"_3518":135681},[],"cifrar en tránsito y en reposo;",{"_4070":82201,"_34195":82165,"_23354":135683,"_5":16137,"_30763":135579,"_3518":135684},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_4070":82202,"_34195":82165,"_23354":135686,"_5":16137,"_30763":135579,"_3518":135687},[],"aplicar una política explícita de retención y legal hold;",{"_4070":82203,"_34195":82165,"_23354":135689,"_5":16137,"_30763":135579,"_3518":135690},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_4070":82204,"_34195":82165,"_23354":135692,"_5":16137,"_30763":135583,"_3518":135693},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_4070":82205,"_34195":82165,"_23354":135695,"_5":16137,"_30763":135583,"_3518":135696},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_4070":82206,"_34195":82165,"_23354":135698,"_5":16137,"_30763":135591,"_3518":135699},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_4070":82207,"_34195":82165,"_23354":135701,"_5":16137,"_30763":135595,"_3518":135702},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_4070":82208,"_34195":82165,"_23354":135704,"_5":16137,"_30763":135599,"_3518":135705},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_4070":82209,"_34195":82165,"_23354":135707,"_5":16137,"_30763":135603,"_3518":135708},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_4070":82210,"_34195":82165,"_23354":135710,"_5":16137,"_30763":135607,"_3518":135711},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_4070":82211,"_34195":82165,"_23354":135713,"_5":16137,"_30763":135611,"_3518":135714},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_4070":82212,"_34195":82165,"_23354":135716,"_5":16137,"_30763":135611,"_3518":135717},[],"aparece un evento de auditoría correcto;",{"_4070":82213,"_34195":82165,"_23354":135719,"_5":16137,"_30763":135611,"_3518":135720},[],"el principal coincide con la identidad utilizada;",{"_4070":82214,"_34195":82165,"_23354":135722,"_5":16137,"_30763":135611,"_3518":135723},[],"el consumidor lo persiste una sola vez;",{"_4070":82215,"_34195":82165,"_23354":135725,"_5":16137,"_30763":135611,"_3518":135726},[],"puede recuperarse por recurso, actor y periodo;",{"_4070":82216,"_34195":82165,"_23354":135728,"_5":16137,"_30763":135611,"_3518":135729},[],"una interrupción del consumidor produce una alerta.",{"_4070":82217,"_34195":82165,"_23354":135731,"_5":16137,"_30763":135611,"_3518":135732},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_4070":82218,"_34195":82218,"_5":16540,"_3518":135734,"_34626":135735,"_23354":135736,"_30763":82218},"Arquitectura de la plataforma",[56672,134827],[],{"_4070":82219,"_34195":82218,"_23354":135738,"_5":16137,"_30763":82218,"_3518":135739},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_4070":82220,"_34195":82218,"_5":34623,"_23354":135741,"_30763":135742,"_3518":135743},[],"/docs/pr-preview/pr-58/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_4070":82221,"_34195":82218,"_5":34623,"_23354":135745,"_30763":135746,"_3518":135747},[],"/docs/pr-preview/pr-58/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_4070":82222,"_34195":82218,"_5":34623,"_23354":135749,"_30763":135750,"_3518":135751},[],"/docs/pr-preview/pr-58/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_4070":82223,"_34195":82218,"_5":34623,"_23354":135753,"_30763":135754,"_3518":135755},[],"/docs/pr-preview/pr-58/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_4070":82224,"_34195":82218,"_5":34623,"_23354":135757,"_30763":135758,"_3518":135759},[],"/docs/pr-preview/pr-58/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_4070":82225,"_34195":82218,"_23354":135761,"_5":16137,"_30763":82218,"_3518":135762},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_4070":82226,"_34195":82218,"_23354":135764,"_5":16137,"_30763":82218,"_3518":135765},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_4070":82227,"_34195":82218,"_23354":135767,"_5":16137,"_30763":135742,"_3518":135768},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_4070":82228,"_34195":82218,"_23354":135770,"_5":16137,"_30763":135746,"_3518":135771},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_4070":82229,"_34195":82218,"_23354":135773,"_5":16137,"_30763":135750,"_3518":135774},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_4070":82230,"_34195":82218,"_23354":135776,"_5":16137,"_30763":135754,"_3518":135777},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_4070":82231,"_34195":82218,"_23354":135779,"_5":16137,"_30763":135758,"_3518":135780},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_4070":82232,"_34195":82232,"_5":16540,"_3518":135782,"_34626":135783,"_23354":135784,"_30763":82232},"Cómo funciona Lamassu",[56672,134827],[],{"_4070":82233,"_34195":82232,"_23354":135786,"_5":16137,"_30763":82232,"_3518":135787},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_4070":82234,"_34195":82232,"_5":34623,"_23354":135789,"_30763":135790,"_3518":135791},[],"/docs/pr-preview/pr-58/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_4070":82235,"_34195":82232,"_5":34623,"_23354":135793,"_30763":135794,"_3518":135795},[],"/docs/pr-preview/pr-58/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_4070":82236,"_34195":82232,"_23354":135797,"_5":16137,"_30763":82232,"_3518":135798},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_4070":82237,"_34195":82232,"_23354":135800,"_5":16137,"_30763":135790,"_3518":135801},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_4070":82238,"_34195":82232,"_23354":135803,"_5":16137,"_30763":135790,"_3518":135804},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_4070":82239,"_34195":82232,"_23354":135806,"_5":16137,"_30763":135790,"_3518":135807},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_4070":82240,"_34195":82232,"_23354":135809,"_5":16137,"_30763":135790,"_3518":135810},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_4070":82241,"_34195":82232,"_23354":135812,"_5":16137,"_30763":135790,"_3518":135813},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_4070":82242,"_34195":82232,"_23354":135815,"_5":16137,"_30763":135794,"_3518":135816},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_4070":82243,"_34195":82232,"_23354":135818,"_5":16137,"_30763":135794,"_3518":135819},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_4070":82244,"_34195":82232,"_23354":135821,"_5":16137,"_30763":135794,"_3518":135822},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_4070":82245,"_34195":82232,"_23354":135824,"_5":16137,"_30763":135794,"_3518":135825},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_4070":82246,"_34195":82232,"_23354":135827,"_5":16137,"_30763":135794,"_3518":135828},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_4070":82247,"_34195":82232,"_23354":135830,"_5":16137,"_30763":135794,"_3518":135831},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_4070":82248,"_34195":82232,"_23354":135833,"_5":16137,"_30763":135794,"_3518":135834},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_4070":82249,"_34195":82249,"_5":16540,"_3518":135836,"_34626":135837,"_23354":135838,"_30763":82249},"Dispositivos e identidades",[56672,134827,59151,135836],[],{"_4070":82250,"_34195":82249,"_23354":135840,"_5":16137,"_30763":82249,"_3518":135841},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_4070":82251,"_34195":82249,"_5":34623,"_23354":135843,"_30763":135844,"_3518":135845},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_4070":82252,"_34195":82249,"_5":34623,"_23354":135847,"_30763":135848,"_3518":135849},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_4070":82253,"_34195":82249,"_5":34623,"_23354":135851,"_30763":135852,"_3518":135853},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_4070":82254,"_34195":82249,"_5":34623,"_23354":135855,"_30763":135856,"_3518":135857},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_4070":82255,"_34195":82249,"_5":34623,"_23354":135859,"_30763":135860,"_3518":135861},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_4070":82256,"_34195":82249,"_5":34623,"_23354":135863,"_30763":135864,"_3518":135865},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_4070":82257,"_34195":82249,"_5":34623,"_23354":135867,"_30763":135868,"_3518":135869},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_4070":82258,"_34195":82249,"_5":34623,"_23354":135871,"_30763":135872,"_3518":135873},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_4070":82259,"_34195":82249,"_5":34623,"_23354":135875,"_30763":135876,"_3518":135877},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_4070":82260,"_34195":82249,"_5":34623,"_23354":135879,"_30763":135880,"_3518":135881},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_4070":82261,"_34195":82249,"_5":34623,"_23354":135883,"_30763":135884,"_3518":135885},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_4070":82262,"_34195":82249,"_23354":135887,"_5":16137,"_30763":82249,"_3518":135888},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_4070":82263,"_34195":82249,"_23354":135890,"_5":16137,"_30763":82249,"_3518":135891},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_4070":82264,"_34195":82249,"_23354":135893,"_5":16137,"_30763":135844,"_3518":135894},[],"Vista operativa",{"_4070":82265,"_34195":82249,"_23354":135896,"_5":16137,"_30763":135844,"_3518":135897},[],"Interpretación",{"_4070":82266,"_34195":82249,"_23354":135899,"_5":16137,"_30763":135844,"_3518":59214},[],{"_4070":82267,"_34195":82249,"_23354":135901,"_5":16137,"_30763":135844,"_3518":135902},[],"Hay registro, pero todavía no hay identidad asociada.",{"_4070":82268,"_34195":82249,"_23354":135904,"_5":16137,"_30763":135844,"_3518":59220},[],{"_4070":82269,"_34195":82249,"_23354":135906,"_5":16137,"_30763":135844,"_3518":135907},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_4070":82270,"_34195":82249,"_23354":135909,"_5":16137,"_30763":135844,"_3518":59226},[],{"_4070":82271,"_34195":82249,"_23354":135911,"_5":16137,"_30763":135844,"_3518":135912},[],"La identidad está en la ventana operativa de renovación.",{"_4070":82272,"_34195":82249,"_23354":135914,"_5":16137,"_30763":135844,"_3518":59232},[],{"_4070":82273,"_34195":82249,"_23354":135916,"_5":16137,"_30763":135844,"_3518":135917},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_4070":82274,"_34195":82249,"_23354":135919,"_5":16137,"_30763":135844,"_3518":59238},[],{"_4070":82275,"_34195":82249,"_23354":135921,"_5":16137,"_30763":135844,"_3518":135922},[],"La identidad ha vencido.",{"_4070":82276,"_34195":82249,"_23354":135924,"_5":16137,"_30763":135844,"_3518":59244},[],{"_4070":82277,"_34195":82249,"_23354":135926,"_5":16137,"_30763":135844,"_3518":135927},[],"La identidad está marcada como revocada.",{"_4070":82278,"_34195":82249,"_23354":135929,"_5":16137,"_30763":135844,"_3518":59250},[],{"_4070":82279,"_34195":82249,"_23354":135931,"_5":16137,"_30763":135844,"_3518":135932},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_4070":82280,"_34195":82249,"_23354":135934,"_5":16137,"_30763":135844,"_3518":135935},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_4070":82281,"_34195":82249,"_23354":135937,"_5":16137,"_30763":135848,"_3518":135938},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_4070":82282,"_34195":82249,"_23354":135940,"_5":16137,"_30763":135848,"_3518":135941},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_4070":82283,"_34195":82249,"_23354":135943,"_5":16137,"_30763":135848,"_3518":135944},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_4070":82284,"_34195":82249,"_23354":135946,"_5":16137,"_30763":135848,"_3518":135947},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_4070":82285,"_34195":82249,"_23354":135949,"_5":16137,"_30763":135852,"_3518":135950},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_4070":82286,"_34195":82249,"_23354":135952,"_5":16137,"_30763":135856,"_3518":135953},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_4070":82287,"_34195":82249,"_23354":135955,"_5":16137,"_30763":135860,"_3518":135956},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_4070":82288,"_34195":82249,"_23354":135958,"_5":16137,"_30763":135864,"_3518":135959},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_4070":82289,"_34195":82249,"_23354":135961,"_5":16137,"_30763":135868,"_3518":135962},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_4070":82290,"_34195":82249,"_23354":135964,"_5":16137,"_30763":135868,"_3518":135965},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_4070":82291,"_34195":82249,"_23354":135967,"_5":16137,"_30763":135872,"_3518":135968},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_4070":82292,"_34195":82249,"_23354":135970,"_5":16137,"_30763":135872,"_3518":135971},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_4070":82293,"_34195":82249,"_23354":135973,"_5":16137,"_30763":135872,"_3518":135974},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_4070":82294,"_34195":82249,"_23354":135976,"_5":16137,"_30763":135872,"_3518":135977},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_4070":82295,"_34195":82249,"_23354":135979,"_5":16137,"_30763":135872,"_3518":135980},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_4070":82296,"_34195":82249,"_23354":135982,"_5":16137,"_30763":135872,"_3518":135983},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_4070":82297,"_34195":82249,"_23354":135985,"_5":16137,"_30763":135876,"_3518":135986},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_4070":82298,"_34195":82249,"_23354":135988,"_5":16137,"_30763":135876,"_3518":135989},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_4070":82299,"_34195":82249,"_23354":135991,"_5":16137,"_30763":135880,"_3518":135992},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_4070":82300,"_34195":82249,"_23354":135994,"_5":16137,"_30763":135880,"_3518":135995},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_4070":82301,"_34195":82249,"_23354":135997,"_5":16137,"_30763":135880,"_3518":135998},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_4070":82302,"_34195":82249,"_23354":136000,"_5":16137,"_30763":135880,"_3518":136001},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_4070":82303,"_34195":82249,"_23354":136003,"_5":16137,"_30763":135884,"_3518":136004},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_4070":82304,"_34195":82249,"_23354":136006,"_5":16137,"_30763":135884,"_3518":136007},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_4070":82305,"_34195":82305,"_5":16540,"_3518":136009,"_34626":136010,"_23354":136012,"_30763":82305},"Identidad inicial y autenticación",[56672,134827,59151,135836,136011],"Enrolamiento con PKI",[],{"_4070":82306,"_34195":82305,"_23354":136014,"_5":16137,"_30763":82305,"_3518":136015},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_4070":82307,"_34195":82305,"_5":34623,"_23354":136017,"_30763":136018,"_3518":136019},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_4070":82308,"_34195":82305,"_5":34623,"_23354":136021,"_30763":136022,"_3518":136023},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_4070":82309,"_34195":82305,"_5":34623,"_23354":136025,"_30763":136026,"_3518":136027},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_4070":82310,"_34195":82305,"_5":34623,"_23354":136029,"_30763":136030,"_3518":136031},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_4070":82311,"_34195":82305,"_5":34623,"_23354":136033,"_30763":136034,"_3518":136035},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_4070":82312,"_34195":82305,"_23354":136037,"_5":16137,"_30763":82305,"_3518":136038},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_4070":82313,"_34195":82305,"_23354":136040,"_5":16137,"_30763":136018,"_3518":136041},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_4070":82314,"_34195":82305,"_23354":136043,"_5":16137,"_30763":136018,"_3518":136044},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_4070":82315,"_34195":82305,"_23354":136046,"_5":16137,"_30763":136022,"_3518":136047},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_4070":82316,"_34195":82305,"_23354":136049,"_5":16137,"_30763":136022,"_3518":136050},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_4070":82317,"_34195":82305,"_23354":136052,"_5":16137,"_30763":136022,"_3518":136053},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_4070":82318,"_34195":82305,"_23354":136055,"_5":16137,"_30763":136026,"_3518":136056},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_4070":82319,"_34195":82305,"_23354":136058,"_5":16137,"_30763":136026,"_3518":136059},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_4070":82320,"_34195":82305,"_23354":136061,"_5":16137,"_30763":136030,"_3518":136062},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_4070":82321,"_34195":82305,"_23354":136064,"_5":16137,"_30763":136030,"_3518":136065},[],"Ejemplo de cuerpo:",{"_4070":82322,"_34195":82305,"_23354":136067,"_5":16137,"_30763":136030,"_3518":136068},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_4070":82323,"_34195":82305,"_23354":136070,"_5":16137,"_30763":136030,"_3518":136071},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_4070":82324,"_34195":82305,"_23354":136073,"_5":16137,"_30763":136030,"_3518":136074},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_4070":82325,"_34195":82305,"_23354":136076,"_5":16137,"_30763":136030,"_3518":136077},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_4070":82326,"_34195":82305,"_23354":136079,"_5":16137,"_30763":136034,"_3518":136080},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_4070":82327,"_34195":82305,"_23354":136082,"_5":16137,"_30763":136034,"_3518":136083},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_4070":82328,"_34195":82328,"_5":16540,"_3518":136085,"_34626":136086,"_23354":136087,"_30763":82328},"Configura y opera el DMS",[56672,134827,59151,135836,136011],[],{"_4070":82329,"_34195":82328,"_23354":136089,"_5":16137,"_30763":82328,"_3518":136090},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_4070":82330,"_34195":82328,"_5":34623,"_23354":136092,"_30763":136093,"_3518":133405},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_4070":82331,"_34195":82328,"_5":34623,"_23354":136095,"_30763":136096,"_3518":136097},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_4070":82332,"_34195":82328,"_5":34623,"_23354":136099,"_30763":136100,"_3518":136101},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_4070":82333,"_34195":82328,"_5":34623,"_23354":136103,"_30763":136104,"_3518":136105},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_4070":82334,"_34195":82328,"_5":34623,"_23354":136107,"_30763":136108,"_3518":136109},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_4070":82335,"_34195":82328,"_5":34623,"_23354":136111,"_30763":136112,"_3518":136113},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_4070":82336,"_34195":82328,"_5":34623,"_23354":136115,"_30763":136116,"_3518":136117},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_4070":82337,"_34195":82328,"_5":34623,"_23354":136119,"_30763":136120,"_3518":136121},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_4070":82338,"_34195":82328,"_5":34623,"_23354":136123,"_30763":136124,"_3518":59446},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_4070":82339,"_34195":82328,"_5":34623,"_23354":136126,"_30763":136127,"_3518":59450},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_4070":82340,"_34195":82328,"_5":34623,"_23354":136129,"_30763":136130,"_3518":136131},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_4070":82341,"_34195":82328,"_5":34623,"_23354":136133,"_30763":136134,"_3518":136135},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_4070":82342,"_34195":82328,"_5":34623,"_23354":136137,"_30763":136138,"_3518":136139},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_4070":82343,"_34195":82328,"_5":34623,"_23354":136141,"_30763":136142,"_3518":136143},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_4070":82344,"_34195":82328,"_5":34623,"_23354":136145,"_30763":136146,"_3518":59470},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_4070":82345,"_34195":82328,"_5":34623,"_23354":136148,"_30763":136149,"_3518":136150},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_4070":82346,"_34195":82328,"_5":34623,"_23354":136152,"_30763":136153,"_3518":136154},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_4070":82347,"_34195":82328,"_5":34623,"_23354":136156,"_30763":136157,"_3518":136158},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_4070":82348,"_34195":82328,"_23354":136160,"_5":16137,"_30763":82328,"_3518":136161},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_4070":82349,"_34195":82328,"_23354":136163,"_5":16137,"_30763":136093,"_3518":136164},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_4070":82350,"_34195":82328,"_23354":136166,"_5":16137,"_30763":136093,"_3518":136167},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_4070":82351,"_34195":82328,"_23354":136169,"_5":16137,"_30763":136100,"_3518":136170},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_4070":82352,"_34195":82328,"_23354":136172,"_5":16137,"_30763":136104,"_3518":136173},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_4070":82353,"_34195":82328,"_23354":136175,"_5":16137,"_30763":136108,"_3518":136176},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_4070":82354,"_34195":82328,"_23354":136178,"_5":16137,"_30763":136112,"_3518":136179},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_4070":82355,"_34195":82328,"_23354":136181,"_5":16137,"_30763":136116,"_3518":136182},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_4070":82356,"_34195":82328,"_23354":136184,"_5":16137,"_30763":136124,"_3518":136185},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_4070":82357,"_34195":82328,"_23354":136187,"_5":16137,"_30763":136124,"_3518":136188},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_4070":82358,"_34195":82328,"_23354":136190,"_5":16137,"_30763":136127,"_3518":136191},[],"Campo de `settings.enrollment_settings`",{"_4070":82359,"_34195":82328,"_23354":136193,"_5":16137,"_30763":136127,"_3518":136194},[],"Decisión",{"_4070":82360,"_34195":82328,"_23354":136196,"_5":16137,"_30763":136127,"_3518":59521},[],{"_4070":82361,"_34195":82328,"_23354":136198,"_5":16137,"_30763":136127,"_3518":136199},[],"`EST_RFC7030` para estas operaciones.",{"_4070":82362,"_34195":82328,"_23354":136201,"_5":16137,"_30763":136127,"_3518":59527},[],{"_4070":82363,"_34195":82328,"_23354":136203,"_5":16137,"_30763":136127,"_3518":136204},[],"ID de la CA que firmará.",{"_4070":82364,"_34195":82328,"_23354":136206,"_5":16137,"_30763":136127,"_3518":59533},[],{"_4070":82365,"_34195":82328,"_23354":136208,"_5":16137,"_30763":136127,"_3518":136209},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_4070":82366,"_34195":82328,"_23354":136211,"_5":16137,"_30763":136127,"_3518":59539},[],{"_4070":82367,"_34195":82328,"_23354":136213,"_5":16137,"_30763":136127,"_3518":136214},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_4070":82368,"_34195":82328,"_23354":136216,"_5":16137,"_30763":136127,"_3518":59545},[],{"_4070":82369,"_34195":82328,"_23354":136218,"_5":16137,"_30763":136127,"_3518":136219},[],"Uno de los cuatro modos de autenticación.",{"_4070":82370,"_34195":82328,"_23354":136221,"_5":16137,"_30763":136127,"_3518":136222},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_4070":82371,"_34195":82328,"_23354":136224,"_5":16137,"_30763":136130,"_3518":136225},[],"Los bloques son independientes:",{"_4070":82372,"_34195":82328,"_23354":136227,"_5":16137,"_30763":136130,"_3518":136228},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_4070":82373,"_34195":82328,"_23354":136230,"_5":16137,"_30763":136130,"_3518":136231},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_4070":82374,"_34195":82328,"_23354":136233,"_5":16137,"_30763":136130,"_3518":59563},[],{"_4070":82375,"_34195":82328,"_23354":136235,"_5":16137,"_30763":136130,"_3518":136236},[],"Control aplicado en la operación configurada",{"_4070":82376,"_34195":82328,"_23354":136238,"_5":16137,"_30763":136130,"_3518":59569},[],{"_4070":82377,"_34195":82328,"_23354":136240,"_5":16137,"_30763":136130,"_3518":136241},[],"Validación del certificado presentado.",{"_4070":82378,"_34195":82328,"_23354":136243,"_5":16137,"_30763":136130,"_3518":59575},[],{"_4070":82379,"_34195":82328,"_23354":136245,"_5":16137,"_30763":136130,"_3518":136246},[],"Autorización del webhook configurado.",{"_4070":82380,"_34195":82328,"_23354":136248,"_5":16137,"_30763":136130,"_3518":59581},[],{"_4070":82381,"_34195":82328,"_23354":136250,"_5":16137,"_30763":136130,"_3518":136251},[],"Validación del certificado y, después, aprobación del webhook.",{"_4070":82382,"_34195":82328,"_23354":136253,"_5":16137,"_30763":136130,"_3518":59587},[],{"_4070":82383,"_34195":82328,"_23354":136255,"_5":16137,"_30763":136130,"_3518":136256},[],"Sin autenticación del solicitante por el DMS.",{"_4070":82384,"_34195":82328,"_23354":136258,"_5":16137,"_30763":136130,"_3518":136259},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_4070":82385,"_34195":82328,"_23354":136261,"_5":16137,"_30763":136130,"_3518":136262},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_4070":82386,"_34195":82328,"_23354":136264,"_5":16137,"_30763":136130,"_3518":136265},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_4070":82387,"_34195":82328,"_23354":136267,"_5":16137,"_30763":136130,"_3518":136268},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_4070":82388,"_34195":82328,"_23354":136270,"_5":16137,"_30763":136134,"_3518":136271},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_4070":82389,"_34195":82328,"_23354":136273,"_5":16137,"_30763":136134,"_3518":136274},[],"Campo de `external_webhook_settings`",{"_4070":82390,"_34195":82328,"_23354":136276,"_5":16137,"_30763":136134,"_3518":136194},[],{"_4070":82391,"_34195":82328,"_23354":136278,"_5":16137,"_30763":136134,"_3518":59613},[],{"_4070":82392,"_34195":82328,"_23354":136280,"_5":16137,"_30763":136134,"_3518":136281},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_4070":82393,"_34195":82328,"_23354":136283,"_5":16137,"_30763":136134,"_3518":59619},[],{"_4070":82394,"_34195":82328,"_23354":136285,"_5":16137,"_30763":136134,"_3518":136286},[],"`POST` o `PUT`; `POST` por defecto.",{"_4070":82395,"_34195":82328,"_23354":136288,"_5":16137,"_30763":136134,"_3518":59625},[],{"_4070":82396,"_34195":82328,"_23354":136290,"_5":16137,"_30763":136134,"_3518":136291},[],"Etiqueta usada en los logs del servicio.",{"_4070":82397,"_34195":82328,"_23354":136293,"_5":16137,"_30763":136134,"_3518":59631},[],{"_4070":82398,"_34195":82328,"_23354":136295,"_5":16137,"_30763":136134,"_3518":136296},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_4070":82399,"_34195":82328,"_23354":136298,"_5":16137,"_30763":136134,"_3518":59637},[],{"_4070":82400,"_34195":82328,"_23354":136300,"_5":16137,"_30763":136134,"_3518":136301},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_4070":82401,"_34195":82328,"_23354":136303,"_5":16137,"_30763":136134,"_3518":59643},[],{"_4070":82402,"_34195":82328,"_23354":136305,"_5":16137,"_30763":136134,"_3518":136306},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_4070":82403,"_34195":82328,"_23354":136308,"_5":16137,"_30763":136134,"_3518":59649},[],{"_4070":82404,"_34195":82328,"_23354":136310,"_5":16137,"_30763":136134,"_3518":136311},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_4070":82405,"_34195":82328,"_23354":136313,"_5":16137,"_30763":136134,"_3518":59655},[],{"_4070":82406,"_34195":82328,"_23354":136315,"_5":16137,"_30763":136134,"_3518":136316},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_4070":82407,"_34195":82328,"_23354":136318,"_5":16137,"_30763":136134,"_3518":59661},[],{"_4070":82408,"_34195":82328,"_23354":136320,"_5":16137,"_30763":136134,"_3518":136321},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_4070":82409,"_34195":82328,"_23354":136323,"_5":16137,"_30763":136134,"_3518":59667},[],{"_4070":82410,"_34195":82328,"_23354":136325,"_5":16137,"_30763":136134,"_3518":136326},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_4070":82411,"_34195":82328,"_23354":136328,"_5":16137,"_30763":136134,"_3518":136329},[],"Reglas de esa configuración:",{"_4070":82412,"_34195":82328,"_23354":136331,"_5":16137,"_30763":136134,"_3518":136332},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_4070":82413,"_34195":82328,"_23354":136334,"_5":16137,"_30763":136134,"_3518":136335},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_4070":82414,"_34195":82328,"_23354":136337,"_5":16137,"_30763":136134,"_3518":136338},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_4070":82415,"_34195":82328,"_23354":136340,"_5":16137,"_30763":136134,"_3518":136341},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_4070":82416,"_34195":82328,"_23354":136343,"_5":16137,"_30763":136134,"_3518":136344},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_4070":82417,"_34195":82328,"_23354":136346,"_5":16137,"_30763":136134,"_3518":136347},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_4070":82418,"_34195":82328,"_23354":136349,"_5":16137,"_30763":136134,"_3518":136350},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_4070":82419,"_34195":82328,"_23354":136352,"_5":16137,"_30763":136134,"_3518":136353},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_4070":82420,"_34195":82328,"_23354":136355,"_5":16137,"_30763":136134,"_3518":136356},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_4070":82421,"_34195":82328,"_23354":136358,"_5":16137,"_30763":136138,"_3518":136359},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_4070":82422,"_34195":82328,"_23354":136361,"_5":16137,"_30763":136142,"_3518":136362},[],"Campo de `settings.reenrollment_settings`",{"_4070":82423,"_34195":82328,"_23354":136364,"_5":16137,"_30763":136142,"_3518":136365},[],"Función",{"_4070":82424,"_34195":82328,"_23354":136367,"_5":16137,"_30763":136142,"_3518":59711},[],{"_4070":82425,"_34195":82328,"_23354":136369,"_5":16137,"_30763":136142,"_3518":136370},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_4070":82426,"_34195":82328,"_23354":136372,"_5":16137,"_30763":136142,"_3518":59717},[],{"_4070":82427,"_34195":82328,"_23354":136374,"_5":16137,"_30763":136142,"_3518":136375},[],"Umbral operativo preventivo de monitorización.",{"_4070":82428,"_34195":82328,"_23354":136377,"_5":16137,"_30763":136142,"_3518":59723},[],{"_4070":82429,"_34195":82328,"_23354":136379,"_5":16137,"_30763":136142,"_3518":136380},[],"Umbral operativo crítico de monitorización.",{"_4070":82430,"_34195":82328,"_23354":136382,"_5":16137,"_30763":136142,"_3518":59729},[],{"_4070":82431,"_34195":82328,"_23354":136384,"_5":16137,"_30763":136142,"_3518":136385},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_4070":82432,"_34195":82328,"_23354":136387,"_5":16137,"_30763":136142,"_3518":59735},[],{"_4070":82433,"_34195":82328,"_23354":136389,"_5":16137,"_30763":136142,"_3518":136390},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_4070":82434,"_34195":82328,"_23354":136392,"_5":16137,"_30763":136142,"_3518":59741},[],{"_4070":82435,"_34195":82328,"_23354":136394,"_5":16137,"_30763":136142,"_3518":136395},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_4070":82436,"_34195":82328,"_23354":136397,"_5":16137,"_30763":136142,"_3518":136398},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_4070":82437,"_34195":82328,"_23354":136400,"_5":16137,"_30763":136146,"_3518":136401},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_4070":82438,"_34195":82328,"_23354":136403,"_5":16137,"_30763":136149,"_3518":133769},[],{"_4070":82439,"_34195":82328,"_23354":136405,"_5":16137,"_30763":136149,"_3518":136406},[],"Qué publica",{"_4070":82440,"_34195":82328,"_23354":136408,"_5":16137,"_30763":136149,"_3518":59758},[],{"_4070":82441,"_34195":82328,"_23354":136410,"_5":16137,"_30763":136149,"_3518":136411},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_4070":82442,"_34195":82328,"_23354":136413,"_5":16137,"_30763":136149,"_3518":59764},[],{"_4070":82443,"_34195":82328,"_23354":136415,"_5":16137,"_30763":136149,"_3518":136416},[],"Certificado de la CA emisora seleccionada.",{"_4070":82444,"_34195":82328,"_23354":136418,"_5":16137,"_30763":136149,"_3518":59770},[],{"_4070":82445,"_34195":82328,"_23354":136420,"_5":16137,"_30763":136149,"_3518":136421},[],"Certificados de las CAs elegidas explícitamente.",{"_4070":82446,"_34195":82328,"_23354":136423,"_5":16137,"_30763":136149,"_3518":136424},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_4070":82447,"_34195":82328,"_23354":136426,"_5":16137,"_30763":136153,"_3518":136427},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_4070":82448,"_34195":82328,"_23354":136429,"_5":16137,"_30763":136153,"_3518":136430},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_4070":82449,"_34195":82328,"_23354":136432,"_5":16137,"_30763":136153,"_3518":136433},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_4070":82450,"_34195":82328,"_23354":136435,"_5":16137,"_30763":136157,"_3518":136436},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_4070":82451,"_34195":82451,"_5":16540,"_3518":136438,"_34626":136439,"_23354":136440,"_30763":82451},"Integra el cliente EST",[56672,134827,59151,135836,136011],[],{"_4070":82452,"_34195":82451,"_23354":136442,"_5":16137,"_30763":82451,"_3518":136443},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_4070":82453,"_34195":82451,"_5":34623,"_23354":136445,"_30763":136446,"_3518":133405},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_4070":82454,"_34195":82451,"_5":34623,"_23354":136448,"_30763":136449,"_3518":136450},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_4070":82455,"_34195":82451,"_5":34623,"_23354":136452,"_30763":136453,"_3518":136454},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_4070":82456,"_34195":82451,"_5":34623,"_23354":136456,"_30763":136457,"_3518":136458},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_4070":82457,"_34195":82451,"_5":34623,"_23354":136460,"_30763":136461,"_3518":136462},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_4070":82458,"_34195":82451,"_5":34623,"_23354":136464,"_30763":136465,"_3518":136466},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_4070":82459,"_34195":82451,"_23354":136468,"_5":16137,"_30763":82451,"_3518":136469},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_4070":82460,"_34195":82451,"_23354":136471,"_5":16137,"_30763":136446,"_3518":136472},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_4070":82461,"_34195":82451,"_23354":136474,"_5":16137,"_30763":136446,"_3518":136475},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_4070":82462,"_34195":82451,"_23354":136477,"_5":16137,"_30763":136446,"_3518":136478},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_4070":82463,"_34195":82451,"_23354":136480,"_5":16137,"_30763":136449,"_3518":136481},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_4070":82464,"_34195":82451,"_23354":136483,"_5":16137,"_30763":136449,"_3518":136484},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_4070":82465,"_34195":82451,"_23354":136486,"_5":16137,"_30763":136453,"_3518":136487},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_4070":82466,"_34195":82451,"_23354":136489,"_5":16137,"_30763":136453,"_3518":136490},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_4070":82467,"_34195":82451,"_23354":136492,"_5":16137,"_30763":136457,"_3518":136493},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_4070":82468,"_34195":82451,"_23354":136495,"_5":16137,"_30763":136457,"_3518":136496},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_4070":82469,"_34195":82451,"_23354":136498,"_5":16137,"_30763":136461,"_3518":136499},[],"Para el caso de una raíz que emite directamente:",{"_4070":82470,"_34195":82451,"_23354":136501,"_5":16137,"_30763":136461,"_3518":136502},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_4070":82471,"_34195":82451,"_23354":136504,"_5":16137,"_30763":136461,"_3518":136505},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_4070":82472,"_34195":82451,"_23354":136507,"_5":16137,"_30763":136465,"_3518":136508},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_4070":82473,"_34195":82473,"_5":16540,"_3518":136510,"_34626":136511,"_23354":136512,"_30763":82473},"Referencia EST",[56672,134827,59151,135836,136011],[],{"_4070":82474,"_34195":82473,"_23354":136514,"_5":16137,"_30763":82473,"_3518":136515},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_4070":82475,"_34195":82473,"_5":34623,"_23354":136517,"_30763":136518,"_3518":136519},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_4070":82476,"_34195":82473,"_5":34623,"_23354":136521,"_30763":136522,"_3518":25384},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_4070":82477,"_34195":82473,"_5":34623,"_23354":136524,"_30763":136525,"_3518":29110},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_4070":82478,"_34195":82473,"_5":34623,"_23354":136527,"_30763":136528,"_3518":29117},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_4070":82479,"_34195":82473,"_5":34623,"_23354":136530,"_30763":136531,"_3518":28336},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_4070":82480,"_34195":82473,"_5":34623,"_23354":136533,"_30763":136534,"_3518":136535},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_4070":82481,"_34195":82473,"_5":34623,"_23354":136537,"_30763":136538,"_3518":136539},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_4070":82482,"_34195":82473,"_5":34623,"_23354":136541,"_30763":136542,"_3518":136543},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_4070":82483,"_34195":82473,"_23354":136545,"_5":16137,"_30763":82473,"_3518":136546},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_4070":82484,"_34195":82473,"_23354":136548,"_5":16137,"_30763":136518,"_3518":136549},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_4070":82485,"_34195":82473,"_23354":136551,"_5":16137,"_30763":136518,"_3518":134587},[],{"_4070":82486,"_34195":82473,"_23354":136553,"_5":16137,"_30763":136518,"_3518":136554},[],"Método",{"_4070":82487,"_34195":82473,"_23354":136556,"_5":16137,"_30763":136518,"_3518":136557},[],"Autenticación y condición",{"_4070":82488,"_34195":82473,"_23354":136559,"_5":16137,"_30763":136518,"_3518":59913},[],{"_4070":82489,"_34195":82473,"_23354":136561,"_5":16137,"_30763":136518,"_3518":59916},[],{"_4070":82490,"_34195":82473,"_23354":136563,"_5":16137,"_30763":136518,"_3518":136564},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_4070":82491,"_34195":82473,"_23354":136566,"_5":16137,"_30763":136518,"_3518":59922},[],{"_4070":82492,"_34195":82473,"_23354":136568,"_5":16137,"_30763":136518,"_3518":59925},[],{"_4070":82493,"_34195":82473,"_23354":136570,"_5":16137,"_30763":136518,"_3518":136571},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_4070":82494,"_34195":82473,"_23354":136573,"_5":16137,"_30763":136518,"_3518":59931},[],{"_4070":82495,"_34195":82473,"_23354":136575,"_5":16137,"_30763":136518,"_3518":59925},[],{"_4070":82496,"_34195":82473,"_23354":136577,"_5":16137,"_30763":136518,"_3518":136578},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_4070":82497,"_34195":82473,"_23354":136580,"_5":16137,"_30763":136518,"_3518":59939},[],{"_4070":82498,"_34195":82473,"_23354":136582,"_5":16137,"_30763":136518,"_3518":59925},[],{"_4070":82499,"_34195":82473,"_23354":136584,"_5":16137,"_30763":136518,"_3518":136585},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_4070":82500,"_34195":82473,"_23354":136587,"_5":16137,"_30763":136518,"_3518":136588},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_4070":82501,"_34195":82473,"_23354":136590,"_5":16137,"_30763":136522,"_3518":136591},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_4070":82502,"_34195":82473,"_23354":136593,"_5":16137,"_30763":136522,"_3518":136594},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_4070":82503,"_34195":82473,"_23354":136596,"_5":16137,"_30763":136525,"_3518":136597},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_4070":82504,"_34195":82473,"_23354":136599,"_5":16137,"_30763":136525,"_3518":136600},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_4070":82505,"_34195":82473,"_23354":136602,"_5":16137,"_30763":136528,"_3518":136603},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_4070":82506,"_34195":82473,"_23354":136605,"_5":16137,"_30763":136528,"_3518":136606},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_4070":82507,"_34195":82473,"_23354":136608,"_5":16137,"_30763":136531,"_3518":136609},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_4070":82508,"_34195":82473,"_23354":136611,"_5":16137,"_30763":136531,"_3518":136612},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_4070":82509,"_34195":82473,"_23354":136614,"_5":16137,"_30763":136534,"_3518":136615},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_4070":82510,"_34195":82473,"_23354":136617,"_5":16137,"_30763":136534,"_3518":136618},[],"Parte",{"_4070":82511,"_34195":82473,"_23354":136620,"_5":16137,"_30763":136534,"_3518":136621},[],"Contenido tras decodificar su Base64",{"_4070":82512,"_34195":82473,"_23354":136623,"_5":16137,"_30763":136534,"_3518":59983},[],{"_4070":82513,"_34195":82473,"_23354":136625,"_5":16137,"_30763":136534,"_3518":136626},[],"Clave privada PKCS#8 DER sin cifrar.",{"_4070":82514,"_34195":82473,"_23354":136628,"_5":16137,"_30763":136534,"_3518":59989},[],{"_4070":82515,"_34195":82473,"_23354":136630,"_5":16137,"_30763":136534,"_3518":136631},[],"PKCS#7 DER con el certificado emitido.",{"_4070":82516,"_34195":82473,"_23354":136633,"_5":16137,"_30763":136534,"_3518":136634},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_4070":82517,"_34195":82473,"_23354":136636,"_5":16137,"_30763":136538,"_3518":136637},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_4070":82518,"_34195":82473,"_23354":136639,"_5":16137,"_30763":136538,"_3518":136640},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_4070":82519,"_34195":82473,"_23354":136642,"_5":16137,"_30763":136538,"_3518":136643},[],"Convierte y comprueba el resultado:",{"_4070":82520,"_34195":82473,"_23354":136645,"_5":16137,"_30763":136538,"_3518":136646},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_4070":82521,"_34195":82473,"_23354":136648,"_5":16137,"_30763":136542,"_3518":136649},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_4070":82522,"_34195":82473,"_23354":136651,"_5":16137,"_30763":136542,"_3518":136652},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_4070":82523,"_34195":82523,"_5":16540,"_3518":136011,"_34626":136654,"_23354":136655,"_30763":82523},[56672,134827,59151,135836,136011],[],{"_4070":82524,"_34195":82523,"_23354":136657,"_5":16137,"_30763":82523,"_3518":136658},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_4070":82525,"_34195":82523,"_5":34623,"_23354":136660,"_30763":136661,"_3518":136662},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_4070":82526,"_34195":82523,"_5":34623,"_23354":136664,"_30763":136665,"_3518":136666},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_4070":82527,"_34195":82523,"_5":34623,"_23354":136668,"_30763":136669,"_3518":136670},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_4070":82528,"_34195":82523,"_5":34623,"_23354":136672,"_30763":136673,"_3518":136674},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_4070":82529,"_34195":82523,"_23354":136676,"_5":16137,"_30763":82523,"_3518":136677},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_4070":82530,"_34195":82523,"_23354":136679,"_5":16137,"_30763":136661,"_3518":136680},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_4070":82531,"_34195":82523,"_23354":136682,"_5":16137,"_30763":136661,"_3518":136683},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_4070":82532,"_34195":82523,"_23354":136685,"_5":16137,"_30763":136661,"_3518":136686},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_4070":82533,"_34195":82523,"_23354":136688,"_5":16137,"_30763":136661,"_3518":136689},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_4070":82534,"_34195":82523,"_23354":136691,"_5":16137,"_30763":136661,"_3518":136692},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_4070":82535,"_34195":82523,"_23354":136694,"_5":16137,"_30763":136661,"_3518":136695},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_4070":82536,"_34195":82523,"_23354":136697,"_5":16137,"_30763":136665,"_3518":136698},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_4070":82537,"_34195":82523,"_23354":136700,"_5":16137,"_30763":136665,"_3518":136701},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_4070":82538,"_34195":82523,"_23354":136703,"_5":16137,"_30763":136665,"_3518":136704},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_4070":82539,"_34195":82523,"_23354":136706,"_5":16137,"_30763":136665,"_3518":136707},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_4070":82540,"_34195":82523,"_23354":136709,"_5":16137,"_30763":136669,"_3518":136710},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_4070":82541,"_34195":82523,"_23354":136712,"_5":16137,"_30763":136669,"_3518":136713},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_4070":82542,"_34195":82523,"_23354":136715,"_5":16137,"_30763":136669,"_3518":136716},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_4070":82543,"_34195":82523,"_23354":136718,"_5":16137,"_30763":136669,"_3518":136719},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_4070":82544,"_34195":82523,"_23354":136721,"_5":16137,"_30763":136673,"_3518":136722},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_4070":82545,"_34195":82523,"_23354":136724,"_5":16137,"_30763":136673,"_3518":136725},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_4070":82546,"_34195":82546,"_5":16540,"_3518":136727,"_34626":136728,"_23354":136729,"_30763":82546},"Estrategias de aprovisionamiento",[56672,134827,59151,135836,136011],[],{"_4070":82547,"_34195":82546,"_23354":136731,"_5":16137,"_30763":82546,"_3518":136732},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_4070":82548,"_34195":82546,"_5":34623,"_23354":136734,"_30763":136735,"_3518":136736},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_4070":82549,"_34195":82546,"_5":34623,"_23354":136738,"_30763":136739,"_3518":136740},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_4070":82550,"_34195":82546,"_5":34623,"_23354":136742,"_30763":136743,"_3518":136744},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_4070":82551,"_34195":82546,"_5":34623,"_23354":136746,"_30763":136747,"_3518":136748},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_4070":82552,"_34195":82546,"_5":34623,"_23354":136750,"_30763":136751,"_3518":136752},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_4070":82553,"_34195":82546,"_23354":136754,"_5":16137,"_30763":82546,"_3518":136755},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_4070":82554,"_34195":82546,"_23354":136757,"_5":16137,"_30763":136735,"_3518":136758},[],"Recorrido",{"_4070":82555,"_34195":82546,"_23354":136760,"_5":16137,"_30763":136735,"_3518":136761},[],"Cuándo existe el dispositivo",{"_4070":82556,"_34195":82546,"_23354":136763,"_5":16137,"_30763":136735,"_3518":136764},[],"Qué compruebas",{"_4070":82557,"_34195":82546,"_23354":136766,"_5":16137,"_30763":136735,"_3518":136767},[],"Asignación manual",{"_4070":82558,"_34195":82546,"_23354":136769,"_5":16137,"_30763":136735,"_3518":136770},[],"El operador lo crea antes de asociar un certificado.",{"_4070":82559,"_34195":82546,"_23354":136772,"_5":16137,"_30763":136735,"_3518":136773},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_4070":82560,"_34195":82546,"_23354":136775,"_5":16137,"_30763":136735,"_3518":136776},[],"EST con `JITP`",{"_4070":82561,"_34195":82546,"_23354":136778,"_5":16137,"_30763":136735,"_3518":136779},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_4070":82562,"_34195":82546,"_23354":136781,"_5":16137,"_30763":136735,"_3518":136782},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_4070":82563,"_34195":82546,"_23354":136784,"_5":16137,"_30763":136735,"_3518":136785},[],"EST con `PRE_REGISTRATION`",{"_4070":82564,"_34195":82546,"_23354":136787,"_5":16137,"_30763":136735,"_3518":136788},[],"Debe existir antes de `/simpleenroll`.",{"_4070":82565,"_34195":82546,"_23354":136790,"_5":16137,"_30763":136735,"_3518":136791},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_4070":82566,"_34195":82546,"_23354":136793,"_5":16137,"_30763":136735,"_3518":136794},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_4070":82567,"_34195":82546,"_23354":136796,"_5":16137,"_30763":136735,"_3518":136797},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_4070":82568,"_34195":82546,"_23354":136799,"_5":16137,"_30763":136739,"_3518":136800},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_4070":82569,"_34195":82546,"_23354":136802,"_5":16137,"_30763":136739,"_3518":136803},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_4070":82570,"_34195":82546,"_23354":136805,"_5":16137,"_30763":136739,"_3518":136806},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_4070":82571,"_34195":82546,"_23354":136808,"_5":16137,"_30763":136743,"_3518":136809},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_4070":82572,"_34195":82546,"_23354":136811,"_5":16137,"_30763":136743,"_3518":136812},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_4070":82573,"_34195":82546,"_23354":136814,"_5":16137,"_30763":136743,"_3518":136815},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_4070":82574,"_34195":82546,"_23354":136817,"_5":16137,"_30763":136743,"_3518":136818},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_4070":82575,"_34195":82546,"_23354":136820,"_5":16137,"_30763":136743,"_3518":136821},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_4070":82576,"_34195":82546,"_23354":136823,"_5":16137,"_30763":136743,"_3518":136824},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_4070":82577,"_34195":82546,"_23354":136826,"_5":16137,"_30763":136747,"_3518":133769},[],{"_4070":82578,"_34195":82546,"_23354":136828,"_5":16137,"_30763":136747,"_3518":136829},[],"Material que atraviesa EST",{"_4070":82579,"_34195":82546,"_23354":136831,"_5":16137,"_30763":136747,"_3518":136832},[],"Clave generada por el dispositivo",{"_4070":82580,"_34195":82546,"_23354":136834,"_5":16137,"_30763":136747,"_3518":136835},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_4070":82581,"_34195":82546,"_23354":136837,"_5":16137,"_30763":136747,"_3518":136838},[],"Clave ya disponible en el dispositivo",{"_4070":82582,"_34195":82546,"_23354":136840,"_5":16137,"_30763":136747,"_3518":136841},[],"CSR firmada con la clave existente y certificado nuevo.",{"_4070":82583,"_34195":82546,"_23354":136843,"_5":16137,"_30763":136747,"_3518":59470},[],{"_4070":82584,"_34195":82546,"_23354":136845,"_5":16137,"_30763":136747,"_3518":136846},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_4070":82585,"_34195":82546,"_23354":136848,"_5":16137,"_30763":136747,"_3518":136849},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_4070":82586,"_34195":82546,"_23354":136851,"_5":16137,"_30763":136751,"_3518":136852},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_4070":82587,"_34195":82587,"_5":16540,"_3518":136854,"_34626":136855,"_23354":136856,"_30763":82587},"Renovación y recuperación",[56672,134827,59151,135836,136011],[],{"_4070":82588,"_34195":82587,"_23354":136858,"_5":16137,"_30763":82587,"_3518":136859},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_4070":82589,"_34195":82587,"_5":34623,"_23354":136861,"_30763":136862,"_3518":136863},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_4070":82590,"_34195":82587,"_5":34623,"_23354":136865,"_30763":136866,"_3518":136867},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_4070":82591,"_34195":82587,"_5":34623,"_23354":136869,"_30763":136870,"_3518":136871},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_4070":82592,"_34195":82587,"_5":34623,"_23354":136873,"_30763":136874,"_3518":136875},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_4070":82593,"_34195":82587,"_5":34623,"_23354":136877,"_30763":136878,"_3518":136879},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_4070":82594,"_34195":82587,"_23354":136881,"_5":16137,"_30763":82587,"_3518":136882},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_4070":82595,"_34195":82587,"_23354":136884,"_5":16137,"_30763":136862,"_3518":136885},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_4070":82596,"_34195":82587,"_23354":136887,"_5":16137,"_30763":136862,"_3518":136888},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_4070":82597,"_34195":82587,"_23354":136890,"_5":16137,"_30763":136862,"_3518":136891},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_4070":82598,"_34195":82587,"_23354":136893,"_5":16137,"_30763":136862,"_3518":136894},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_4070":82599,"_34195":82587,"_23354":136896,"_5":16137,"_30763":136866,"_3518":136897},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_4070":82600,"_34195":82587,"_23354":136899,"_5":16137,"_30763":136866,"_3518":136900},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_4070":82601,"_34195":82587,"_23354":136902,"_5":16137,"_30763":136870,"_3518":136903},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_4070":82602,"_34195":82587,"_23354":136905,"_5":16137,"_30763":136870,"_3518":136906},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_4070":82603,"_34195":82587,"_23354":136908,"_5":16137,"_30763":136870,"_3518":136909},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_4070":82604,"_34195":82587,"_23354":136911,"_5":16137,"_30763":136874,"_3518":136912},[],"Situación",{"_4070":82605,"_34195":82587,"_23354":136914,"_5":16137,"_30763":136874,"_3518":136915},[],"Procedimiento",{"_4070":82606,"_34195":82587,"_23354":136917,"_5":16137,"_30763":136874,"_3518":136918},[],"Certificado vigente, fuera de ventana",{"_4070":82607,"_34195":82587,"_23354":136920,"_5":16137,"_30763":136874,"_3518":136921},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_4070":82608,"_34195":82587,"_23354":136923,"_5":16137,"_30763":136874,"_3518":136924},[],"Certificado vencido, clave disponible",{"_4070":82609,"_34195":82587,"_23354":136926,"_5":16137,"_30763":136874,"_3518":136927},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_4070":82610,"_34195":82587,"_23354":136929,"_5":16137,"_30763":136874,"_3518":136930},[],"Renovación por webhook o `NO_AUTH`",{"_4070":82611,"_34195":82587,"_23354":136932,"_5":16137,"_30763":136874,"_3518":136933},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_4070":82612,"_34195":82587,"_23354":136935,"_5":16137,"_30763":136874,"_3518":136936},[],"Clave perdida o inaccesible",{"_4070":82613,"_34195":82587,"_23354":136938,"_5":16137,"_30763":136874,"_3518":136939},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_4070":82614,"_34195":82587,"_23354":136941,"_5":16137,"_30763":136874,"_3518":136942},[],"Identidad actual revocada",{"_4070":82615,"_34195":82587,"_23354":136944,"_5":16137,"_30763":136874,"_3518":136945},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_4070":82616,"_34195":82587,"_23354":136947,"_5":16137,"_30763":136874,"_3518":136948},[],"Dispositivo sin identidad",{"_4070":82617,"_34195":82587,"_23354":136950,"_5":16137,"_30763":136874,"_3518":136951},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_4070":82618,"_34195":82587,"_23354":136953,"_5":16137,"_30763":136874,"_3518":136954},[],"Dispositivo retirado",{"_4070":82619,"_34195":82587,"_23354":136956,"_5":16137,"_30763":136874,"_3518":136957},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_4070":82620,"_34195":82587,"_23354":136959,"_5":16137,"_30763":136874,"_3518":136960},[],"Timeout, HTTP 500 o fallo de instalación",{"_4070":82621,"_34195":82587,"_23354":136962,"_5":16137,"_30763":136874,"_3518":136963},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_4070":82622,"_34195":82587,"_23354":136965,"_5":16137,"_30763":136878,"_3518":136966},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_4070":82623,"_34195":82587,"_23354":136968,"_5":16137,"_30763":136878,"_3518":136969},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_4070":82624,"_34195":82624,"_5":16540,"_3518":136971,"_34626":136972,"_23354":136973,"_30763":82624},"Diagnóstico de enrolamiento",[56672,134827,59151,135836,136011],[],{"_4070":82625,"_34195":82624,"_23354":136975,"_5":16137,"_30763":82624,"_3518":136976},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_4070":82626,"_34195":82624,"_5":34623,"_23354":136978,"_30763":136979,"_3518":136980},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_4070":82627,"_34195":82624,"_5":34623,"_23354":136982,"_30763":136983,"_3518":136984},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_4070":82628,"_34195":82624,"_5":34623,"_23354":136986,"_30763":136987,"_3518":136543},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_4070":82629,"_34195":82624,"_5":34623,"_23354":136989,"_30763":136990,"_3518":136991},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_4070":82630,"_34195":82624,"_23354":136993,"_5":16137,"_30763":82624,"_3518":136994},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_4070":82631,"_34195":82624,"_23354":136996,"_5":16137,"_30763":136983,"_3518":136997},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_4070":82632,"_34195":82624,"_23354":136999,"_5":16137,"_30763":136983,"_3518":137000},[],"Síntoma o mensaje",{"_4070":82633,"_34195":82624,"_23354":137002,"_5":16137,"_30763":136983,"_3518":137003},[],"Qué revisar",{"_4070":82634,"_34195":82624,"_23354":137005,"_5":16137,"_30763":136983,"_3518":137006},[],"curl rechaza TLS, nombre o emisor",{"_4070":82635,"_34195":82624,"_23354":137008,"_5":16137,"_30763":136983,"_3518":137009},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_4070":82636,"_34195":82624,"_23354":137011,"_5":16137,"_30763":136983,"_3518":137012},[],"404 o APS ausente",{"_4070":82637,"_34195":82624,"_23354":137014,"_5":16137,"_30763":136983,"_3518":137015},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_4070":82638,"_34195":82624,"_23354":137017,"_5":16137,"_30763":136983,"_3518":137018},[],"400, error de CSR o formato",{"_4070":82639,"_34195":82624,"_23354":137020,"_5":16137,"_30763":136983,"_3518":137021},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_4070":82640,"_34195":82624,"_23354":137023,"_5":16137,"_30763":136983,"_3518":137024},[],"Credencial ausente o certificado no válido",{"_4070":82641,"_34195":82624,"_23354":137026,"_5":16137,"_30763":136983,"_3518":137027},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_4070":82642,"_34195":82624,"_23354":137029,"_5":16137,"_30763":136983,"_3518":137030},[],"Webhook deniega, expira o responde sin autorización",{"_4070":82643,"_34195":82624,"_23354":137032,"_5":16137,"_30763":136983,"_3518":137033},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_4070":82644,"_34195":82624,"_23354":137035,"_5":16137,"_30763":136983,"_3518":60396},[],{"_4070":82645,"_34195":82624,"_23354":137037,"_5":16137,"_30763":136983,"_3518":137038},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_4070":82646,"_34195":82624,"_23354":137040,"_5":16137,"_30763":136983,"_3518":60402},[],{"_4070":82647,"_34195":82624,"_23354":137042,"_5":16137,"_30763":136983,"_3518":137043},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_4070":82648,"_34195":82624,"_23354":137045,"_5":16137,"_30763":136983,"_3518":60408},[],{"_4070":82649,"_34195":82624,"_23354":137047,"_5":16137,"_30763":136983,"_3518":137048},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_4070":82650,"_34195":82624,"_23354":137050,"_5":16137,"_30763":136983,"_3518":60414},[],{"_4070":82651,"_34195":82624,"_23354":137052,"_5":16137,"_30763":136983,"_3518":137053},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_4070":82652,"_34195":82624,"_23354":137055,"_5":16137,"_30763":136983,"_3518":60420},[],{"_4070":82653,"_34195":82624,"_23354":137057,"_5":16137,"_30763":136983,"_3518":137058},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_4070":82654,"_34195":82624,"_23354":137060,"_5":16137,"_30763":136983,"_3518":137061},[],"400 `struct validation error` al crear o actualizar un DMS",{"_4070":82655,"_34195":82624,"_23354":137063,"_5":16137,"_30763":136983,"_3518":137064},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_4070":82656,"_34195":82624,"_23354":137066,"_5":16137,"_30763":136983,"_3518":137067},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_4070":82657,"_34195":82624,"_23354":137069,"_5":16137,"_30763":136983,"_3518":137070},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_4070":82658,"_34195":82624,"_23354":137072,"_5":16137,"_30763":136983,"_3518":60438},[],{"_4070":82659,"_34195":82624,"_23354":137074,"_5":16137,"_30763":136983,"_3518":137075},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_4070":82660,"_34195":82624,"_23354":137077,"_5":16137,"_30763":136983,"_3518":60444},[],{"_4070":82661,"_34195":82624,"_23354":137079,"_5":16137,"_30763":136983,"_3518":137080},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_4070":82662,"_34195":82624,"_23354":137082,"_5":16137,"_30763":136983,"_3518":137083},[],"DMS propietario distinto",{"_4070":82663,"_34195":82624,"_23354":137085,"_5":16137,"_30763":136983,"_3518":137086},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_4070":82664,"_34195":82624,"_23354":137088,"_5":16137,"_30763":136983,"_3518":60456},[],{"_4070":82665,"_34195":82624,"_23354":137090,"_5":16137,"_30763":136983,"_3518":137091},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_4070":82666,"_34195":82624,"_23354":137093,"_5":16137,"_30763":136983,"_3518":60462},[],{"_4070":82667,"_34195":82624,"_23354":137095,"_5":16137,"_30763":136983,"_3518":137096},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_4070":82668,"_34195":82624,"_23354":137098,"_5":16137,"_30763":136983,"_3518":137099},[],"Certificado actual revocado",{"_4070":82669,"_34195":82624,"_23354":137101,"_5":16137,"_30763":136983,"_3518":137102},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_4070":82670,"_34195":82624,"_23354":137104,"_5":16137,"_30763":136983,"_3518":137105},[],"Error de CA, perfil o firma",{"_4070":82671,"_34195":82624,"_23354":137107,"_5":16137,"_30763":136983,"_3518":137108},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_4070":82672,"_34195":82624,"_23354":137110,"_5":16137,"_30763":136983,"_3518":137111},[],"HTTP 200 sin conexión del dispositivo",{"_4070":82673,"_34195":82624,"_23354":137113,"_5":16137,"_30763":136983,"_3518":137114},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_4070":82674,"_34195":82624,"_23354":137116,"_5":16137,"_30763":136983,"_3518":137117},[],"Timeout o error después de emitir",{"_4070":82675,"_34195":82624,"_23354":137119,"_5":16137,"_30763":136983,"_3518":137120},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_4070":82676,"_34195":82624,"_23354":137122,"_5":16137,"_30763":136987,"_3518":137123},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_4070":82677,"_34195":82624,"_23354":137125,"_5":16137,"_30763":136987,"_3518":137126},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_4070":82678,"_34195":82624,"_23354":137128,"_5":16137,"_30763":136990,"_3518":137129},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_4070":82679,"_34195":82624,"_23354":137131,"_5":16137,"_30763":136990,"_3518":137132},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_4070":82680,"_34195":82624,"_23354":137134,"_5":16137,"_30763":136990,"_3518":137135},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_4070":82681,"_34195":82624,"_23354":137137,"_5":16137,"_30763":136990,"_3518":137138},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_4070":82682,"_34195":82624,"_23354":137140,"_5":16137,"_30763":136990,"_3518":137141},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_4070":82683,"_34195":82624,"_23354":137143,"_5":16137,"_30763":136990,"_3518":137144},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_4070":82684,"_34195":82624,"_23354":137146,"_5":16137,"_30763":136990,"_3518":137147},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_4070":82685,"_34195":82685,"_5":16540,"_3518":137149,"_34626":137150,"_23354":137151,"_30763":82685},"Distribución y actualización de confianza",[56672,134827,59151,135836,136011],[],{"_4070":82686,"_34195":82685,"_23354":137153,"_5":16137,"_30763":82685,"_3518":137154},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_4070":82687,"_34195":82685,"_5":34623,"_23354":137156,"_30763":137157,"_3518":137158},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_4070":82688,"_34195":82685,"_5":34623,"_23354":137160,"_30763":137161,"_3518":137162},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_4070":82689,"_34195":82685,"_5":34623,"_23354":137164,"_30763":137165,"_3518":137166},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_4070":82690,"_34195":82685,"_5":34623,"_23354":137168,"_30763":137169,"_3518":137170},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_4070":82691,"_34195":82685,"_5":34623,"_23354":137172,"_30763":137173,"_3518":137174},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_4070":82692,"_34195":82685,"_23354":137176,"_5":16137,"_30763":82685,"_3518":137177},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_4070":82693,"_34195":82685,"_23354":137179,"_5":16137,"_30763":137157,"_3518":137180},[],"Relación",{"_4070":82694,"_34195":82685,"_23354":137182,"_5":16137,"_30763":137157,"_3518":137183},[],"Material que prepara el responsable",{"_4070":82695,"_34195":82685,"_23354":137185,"_5":16137,"_30763":137157,"_3518":137186},[],"Dispositivo → servidor EST",{"_4070":82696,"_34195":82685,"_23354":137188,"_5":16137,"_30763":137157,"_3518":137189},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_4070":82697,"_34195":82685,"_23354":137191,"_5":16137,"_30763":137157,"_3518":137192},[],"DMS → solicitante",{"_4070":82698,"_34195":82685,"_23354":137194,"_5":16137,"_30763":137157,"_3518":137195},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_4070":82699,"_34195":82685,"_23354":137197,"_5":16137,"_30763":137157,"_3518":137198},[],"Consumidor → dispositivo",{"_4070":82700,"_34195":82685,"_23354":137200,"_5":16137,"_30763":137157,"_3518":137201},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_4070":82701,"_34195":82685,"_23354":137203,"_5":16137,"_30763":137157,"_3518":137204},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_4070":82702,"_34195":82685,"_23354":137206,"_5":16137,"_30763":137161,"_3518":137207},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_4070":82703,"_34195":82685,"_23354":137209,"_5":16137,"_30763":137161,"_3518":137210},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_4070":82704,"_34195":82685,"_23354":137212,"_5":16137,"_30763":137165,"_3518":137213},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_4070":82705,"_34195":82685,"_23354":137215,"_5":16137,"_30763":137165,"_3518":137216},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_4070":82706,"_34195":82685,"_23354":137218,"_5":16137,"_30763":137165,"_3518":137219},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_4070":82707,"_34195":82685,"_23354":137221,"_5":16137,"_30763":137165,"_3518":137222},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_4070":82708,"_34195":82685,"_23354":137224,"_5":16137,"_30763":137165,"_3518":137225},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_4070":82709,"_34195":82685,"_23354":137227,"_5":16137,"_30763":137165,"_3518":137228},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_4070":82710,"_34195":82685,"_23354":137230,"_5":16137,"_30763":137169,"_3518":137231},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_4070":82711,"_34195":82685,"_23354":137233,"_5":16137,"_30763":137169,"_3518":137234},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_4070":82712,"_34195":82685,"_23354":137236,"_5":16137,"_30763":137169,"_3518":137237},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_4070":82713,"_34195":82685,"_23354":137239,"_5":16137,"_30763":137173,"_3518":137240},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_4070":82714,"_34195":82714,"_5":16540,"_3518":60611,"_34626":137242,"_23354":137244,"_30763":82714},[56672,134827,59151,135836,137243],"Integraciones",[],{"_4070":82715,"_34195":82714,"_23354":137246,"_5":16137,"_30763":82714,"_3518":137247},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_4070":82716,"_34195":82714,"_5":34623,"_23354":137249,"_30763":137250,"_3518":137251},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_4070":82717,"_34195":82714,"_5":34623,"_23354":137253,"_30763":137254,"_3518":137255},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_4070":82718,"_34195":82714,"_5":34623,"_23354":137257,"_30763":137258,"_3518":137259},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_4070":82719,"_34195":82714,"_5":34623,"_23354":137261,"_30763":137262,"_3518":137263},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_4070":82720,"_34195":82714,"_5":34623,"_23354":137265,"_30763":137266,"_3518":137267},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_4070":82721,"_34195":82714,"_5":34623,"_23354":137269,"_30763":137270,"_3518":137271},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_4070":82722,"_34195":82714,"_5":34623,"_23354":137273,"_30763":137274,"_3518":137275},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_4070":82723,"_34195":82714,"_5":34623,"_23354":137277,"_30763":137278,"_3518":137279},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_4070":82724,"_34195":82714,"_5":34623,"_23354":137281,"_30763":137282,"_3518":60653},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_4070":82725,"_34195":82714,"_5":34623,"_23354":137284,"_30763":137285,"_3518":60657},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_4070":82726,"_34195":82714,"_5":34623,"_23354":137287,"_30763":137288,"_3518":137289},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_4070":82727,"_34195":82714,"_5":34623,"_23354":137291,"_30763":137292,"_3518":137293},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_4070":82728,"_34195":82714,"_5":34623,"_23354":137295,"_30763":137296,"_3518":137297},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_4070":82729,"_34195":82714,"_5":34623,"_23354":137299,"_30763":137300,"_3518":137301},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_4070":82730,"_34195":82714,"_5":34623,"_23354":137303,"_30763":137304,"_3518":137305},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_4070":82731,"_34195":82714,"_5":34623,"_23354":137307,"_30763":137308,"_3518":137309},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_4070":82732,"_34195":82714,"_5":34623,"_23354":137311,"_30763":137312,"_3518":137313},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_4070":82733,"_34195":82714,"_5":34623,"_23354":137315,"_30763":137316,"_3518":137317},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_4070":82734,"_34195":82714,"_5":34623,"_23354":137319,"_30763":137320,"_3518":137321},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_4070":82735,"_34195":82714,"_5":34623,"_23354":137323,"_30763":137324,"_3518":137325},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_4070":82736,"_34195":82714,"_5":34623,"_23354":137327,"_30763":137328,"_3518":137329},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_4070":82737,"_34195":82714,"_5":34623,"_23354":137331,"_30763":137332,"_3518":137333},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_4070":82738,"_34195":82714,"_5":34623,"_23354":137335,"_30763":137336,"_3518":137337},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_4070":82739,"_34195":82714,"_5":34623,"_23354":137339,"_30763":137340,"_3518":137341},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_4070":82740,"_34195":82714,"_5":34623,"_23354":137343,"_30763":137344,"_3518":137345},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_4070":82741,"_34195":82714,"_23354":137347,"_5":16137,"_30763":82714,"_3518":137348},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_4070":82742,"_34195":82714,"_23354":137350,"_5":16137,"_30763":82714,"_3518":137351},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_4070":82743,"_34195":82714,"_23354":137353,"_5":16137,"_30763":82714,"_3518":137354},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_4070":82744,"_34195":82714,"_23354":137356,"_5":16137,"_30763":137250,"_3518":137357},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_4070":82745,"_34195":82714,"_23354":137359,"_5":16137,"_30763":137250,"_3518":137360},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_4070":82746,"_34195":82714,"_23354":137362,"_5":16137,"_30763":137250,"_3518":137363},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_4070":82747,"_34195":82714,"_23354":137365,"_5":16137,"_30763":137250,"_3518":137366},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_4070":82748,"_34195":82714,"_23354":137368,"_5":16137,"_30763":137254,"_3518":137369},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_4070":82749,"_34195":82714,"_23354":137371,"_5":16137,"_30763":137258,"_3518":137372},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_4070":82750,"_34195":82714,"_23354":137374,"_5":16137,"_30763":137258,"_3518":137375},[],"Acción IAM",{"_4070":82751,"_34195":82714,"_23354":137377,"_5":16137,"_30763":137258,"_3518":133775},[],{"_4070":82752,"_34195":82714,"_23354":137379,"_5":16137,"_30763":137258,"_3518":60752},[],{"_4070":82753,"_34195":82714,"_23354":137381,"_5":16137,"_30763":137258,"_3518":137382},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_4070":82754,"_34195":82714,"_23354":137384,"_5":16137,"_30763":137258,"_3518":60758},[],{"_4070":82755,"_34195":82714,"_23354":137386,"_5":16137,"_30763":137258,"_3518":137387},[],"Registrar la CA en AWS IoT",{"_4070":82756,"_34195":82714,"_23354":137389,"_5":16137,"_30763":137258,"_3518":60764},[],{"_4070":82757,"_34195":82714,"_23354":137391,"_5":16137,"_30763":137258,"_3518":137392},[],"Consultar el estado del registro de la CA",{"_4070":82758,"_34195":82714,"_23354":137394,"_5":16137,"_30763":137258,"_3518":60770},[],{"_4070":82759,"_34195":82714,"_23354":137396,"_5":16137,"_30763":137258,"_3518":137397},[],"Crear o actualizar Things en IoT Core",{"_4070":82760,"_34195":82714,"_23354":137399,"_5":16137,"_30763":137258,"_3518":60776},[],{"_4070":82761,"_34195":82714,"_23354":137401,"_5":16137,"_30763":137258,"_3518":137402},[],"Aprovisionar Things mediante plantilla",{"_4070":82762,"_34195":82714,"_23354":137404,"_5":16137,"_30763":137258,"_3518":60782},[],{"_4070":82763,"_34195":82714,"_23354":137406,"_5":16137,"_30763":137258,"_3518":137407},[],"Registrar certificados de dispositivo",{"_4070":82764,"_34195":82714,"_23354":137409,"_5":16137,"_30763":137258,"_3518":60788},[],{"_4070":82765,"_34195":82714,"_23354":137411,"_5":16137,"_30763":137258,"_3518":137412},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_4070":82766,"_34195":82714,"_23354":137414,"_5":16137,"_30763":137258,"_3518":60794},[],{"_4070":82767,"_34195":82714,"_23354":137416,"_5":16137,"_30763":137258,"_3518":137417},[],"Crear y adjuntar políticas IoT",{"_4070":82768,"_34195":82714,"_23354":137419,"_5":16137,"_30763":137258,"_3518":60800},[],{"_4070":82769,"_34195":82714,"_23354":137421,"_5":16137,"_30763":137258,"_3518":137422},[],"Gestionar grupos de Things",{"_4070":82770,"_34195":82714,"_23354":137424,"_5":16137,"_30763":137258,"_3518":60806},[],{"_4070":82771,"_34195":82714,"_23354":137426,"_5":16137,"_30763":137258,"_3518":137427},[],"Crear plantillas JITP",{"_4070":82772,"_34195":82714,"_23354":137429,"_5":16137,"_30763":137258,"_3518":60812},[],{"_4070":82773,"_34195":82714,"_23354":137431,"_5":16137,"_30763":137258,"_3518":137432},[],"Leer y escribir el Device Shadow",{"_4070":82774,"_34195":82714,"_23354":137434,"_5":16137,"_30763":137258,"_3518":137435},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_4070":82775,"_34195":82714,"_23354":137437,"_5":16137,"_30763":137262,"_3518":137438},[],"Parámetro",{"_4070":82776,"_34195":82714,"_23354":137440,"_5":16137,"_30763":137262,"_3518":137441},[],"Tipo",{"_4070":82777,"_34195":82714,"_23354":137443,"_5":16137,"_30763":137262,"_3518":137444},[],"Requerido",{"_4070":82778,"_34195":82714,"_23354":137446,"_5":16137,"_30763":137262,"_3518":137447},[],"Descripción",{"_4070":82779,"_34195":82714,"_23354":137449,"_5":16137,"_30763":137262,"_3518":60833},[],{"_4070":82780,"_34195":82714,"_23354":137451,"_5":16137,"_30763":137262,"_3518":27927},[],{"_4070":82781,"_34195":82714,"_23354":137453,"_5":16137,"_30763":137262,"_3518":137454},[],"Sí",{"_4070":82782,"_34195":82714,"_23354":137456,"_5":16137,"_30763":137262,"_3518":137457},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_4070":82783,"_34195":82714,"_23354":137459,"_5":16137,"_30763":137262,"_3518":60844},[],{"_4070":82784,"_34195":82714,"_23354":137461,"_5":16137,"_30763":137262,"_3518":27927},[],{"_4070":82785,"_34195":82714,"_23354":137463,"_5":16137,"_30763":137262,"_3518":137454},[],{"_4070":82786,"_34195":82714,"_23354":137465,"_5":16137,"_30763":137262,"_3518":137466},[],"Región AWS donde opera el conector.",{"_4070":82787,"_34195":82714,"_23354":137468,"_5":16137,"_30763":137262,"_3518":60854},[],{"_4070":82788,"_34195":82714,"_23354":137470,"_5":16137,"_30763":137262,"_3518":27927},[],{"_4070":82789,"_34195":82714,"_23354":137472,"_5":16137,"_30763":137262,"_3518":137454},[],{"_4070":82790,"_34195":82714,"_23354":137474,"_5":16137,"_30763":137262,"_3518":137475},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_4070":82791,"_34195":82714,"_23354":137477,"_5":16137,"_30763":137262,"_3518":60864},[],{"_4070":82792,"_34195":82714,"_23354":137479,"_5":16137,"_30763":137262,"_3518":27927},[],{"_4070":82793,"_34195":82714,"_23354":137481,"_5":16137,"_30763":137262,"_3518":137482},[],"Solo con `auth_method=static`",{"_4070":82794,"_34195":82714,"_23354":137484,"_5":16137,"_30763":137262,"_3518":137485},[],"Clave de acceso AWS.",{"_4070":82795,"_34195":82714,"_23354":137487,"_5":16137,"_30763":137262,"_3518":60875},[],{"_4070":82796,"_34195":82714,"_23354":137489,"_5":16137,"_30763":137262,"_3518":27927},[],{"_4070":82797,"_34195":82714,"_23354":137491,"_5":16137,"_30763":137262,"_3518":137482},[],{"_4070":82798,"_34195":82714,"_23354":137493,"_5":16137,"_30763":137262,"_3518":137494},[],"Clave secreta AWS.",{"_4070":82799,"_34195":82714,"_23354":137496,"_5":16137,"_30763":137262,"_3518":60885},[],{"_4070":82800,"_34195":82714,"_23354":137498,"_5":16137,"_30763":137262,"_3518":27927},[],{"_4070":82801,"_34195":82714,"_23354":137500,"_5":16137,"_30763":137262,"_3518":60890},[],{"_4070":82802,"_34195":82714,"_23354":137502,"_5":16137,"_30763":137262,"_3518":137503},[],"Token de sesión (con `auth_method=static`).",{"_4070":82803,"_34195":82714,"_23354":137505,"_5":16137,"_30763":137262,"_3518":60896},[],{"_4070":82804,"_34195":82714,"_23354":137507,"_5":16137,"_30763":137262,"_3518":27927},[],{"_4070":82805,"_34195":82714,"_23354":137509,"_5":16137,"_30763":137262,"_3518":137510},[],"Solo con `auth_method=role`",{"_4070":82806,"_34195":82714,"_23354":137512,"_5":16137,"_30763":137262,"_3518":137513},[],"ARN del rol a asumir.",{"_4070":82807,"_34195":82714,"_23354":137515,"_5":16137,"_30763":137262,"_3518":60907},[],{"_4070":82808,"_34195":82714,"_23354":137517,"_5":16137,"_30763":137262,"_3518":27927},[],{"_4070":82809,"_34195":82714,"_23354":137519,"_5":16137,"_30763":137262,"_3518":60890},[],{"_4070":82810,"_34195":82714,"_23354":137521,"_5":16137,"_30763":137262,"_3518":137522},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_4070":82811,"_34195":82714,"_23354":137524,"_5":16137,"_30763":137262,"_3518":60917},[],{"_4070":82812,"_34195":82714,"_23354":137526,"_5":16137,"_30763":137262,"_3518":102726},[],{"_4070":82813,"_34195":82714,"_23354":137528,"_5":16137,"_30763":137262,"_3518":137454},[],{"_4070":82814,"_34195":82714,"_23354":137530,"_5":16137,"_30763":137262,"_3518":137531},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_4070":82815,"_34195":82714,"_23354":137533,"_5":16137,"_30763":137262,"_3518":60927},[],{"_4070":82816,"_34195":82714,"_23354":137535,"_5":16137,"_30763":137262,"_3518":27927},[],{"_4070":82817,"_34195":82714,"_23354":137537,"_5":16137,"_30763":137262,"_3518":137454},[],{"_4070":82818,"_34195":82714,"_23354":137539,"_5":16137,"_30763":137262,"_3518":137540},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_4070":82819,"_34195":82714,"_23354":137542,"_5":16137,"_30763":137262,"_3518":60937},[],{"_4070":82820,"_34195":82714,"_23354":137544,"_5":16137,"_30763":137262,"_3518":27927},[],{"_4070":82821,"_34195":82714,"_23354":137546,"_5":16137,"_30763":137262,"_3518":137454},[],{"_4070":82822,"_34195":82714,"_23354":137548,"_5":16137,"_30763":137262,"_3518":137549},[],"URL HTTP del Device Manager de Lamassu.",{"_4070":82823,"_34195":82714,"_23354":137551,"_5":16137,"_30763":137262,"_3518":60947},[],{"_4070":82824,"_34195":82714,"_23354":137553,"_5":16137,"_30763":137262,"_3518":27927},[],{"_4070":82825,"_34195":82714,"_23354":137555,"_5":16137,"_30763":137262,"_3518":137454},[],{"_4070":82826,"_34195":82714,"_23354":137557,"_5":16137,"_30763":137262,"_3518":137558},[],"URL HTTP del servicio de CA de Lamassu.",{"_4070":82827,"_34195":82714,"_23354":137560,"_5":16137,"_30763":137266,"_3518":137561},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_4070":82828,"_34195":82714,"_23354":137563,"_5":16137,"_30763":137266,"_3518":137564},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_4070":82829,"_34195":82714,"_23354":137566,"_5":16137,"_30763":137266,"_3518":137567},[],"Tipo de CloudEvent",{"_4070":82830,"_34195":82714,"_23354":137569,"_5":16137,"_30763":137266,"_3518":137570},[],"Recurso en Lamassu",{"_4070":82831,"_34195":82714,"_23354":137572,"_5":16137,"_30763":137266,"_3518":137573},[],"Recurso AWS",{"_4070":82832,"_34195":82714,"_23354":137575,"_5":16137,"_30763":137266,"_3518":137576},[],"Acciones IAM",{"_4070":82833,"_34195":82714,"_23354":137578,"_5":16137,"_30763":137266,"_3518":137579},[],"Llamadas AWS y efecto",{"_4070":82834,"_34195":82714,"_23354":137581,"_5":16137,"_30763":137266,"_3518":137582},[],"Dónde en esta página",{"_4070":82835,"_34195":82714,"_23354":137584,"_5":16137,"_30763":137266,"_3518":60981},[],{"_4070":82836,"_34195":82714,"_23354":137586,"_5":16137,"_30763":137266,"_3518":60984},[],{"_4070":82837,"_34195":82714,"_23354":137588,"_5":16137,"_30763":137266,"_3518":60987},[],{"_4070":82838,"_34195":82714,"_23354":137590,"_5":16137,"_30763":137266,"_3518":60990},[],{"_4070":82839,"_34195":82714,"_23354":137592,"_5":16137,"_30763":137266,"_3518":137593},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_4070":82840,"_34195":82714,"_23354":137595,"_5":16137,"_30763":137266,"_3518":137279},[],{"_4070":82841,"_34195":82714,"_23354":137597,"_5":16137,"_30763":137266,"_3518":60998},[],{"_4070":82842,"_34195":82714,"_23354":137599,"_5":16137,"_30763":137266,"_3518":61001},[],{"_4070":82843,"_34195":82714,"_23354":137601,"_5":16137,"_30763":137266,"_3518":61004},[],{"_4070":82844,"_34195":82714,"_23354":137603,"_5":16137,"_30763":137266,"_3518":61007},[],{"_4070":82845,"_34195":82714,"_23354":137605,"_5":16137,"_30763":137266,"_3518":137606},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_4070":82846,"_34195":82714,"_23354":137608,"_5":16137,"_30763":137266,"_3518":137305},[],{"_4070":82847,"_34195":82714,"_23354":137610,"_5":16137,"_30763":137266,"_3518":61015},[],{"_4070":82848,"_34195":82714,"_23354":137612,"_5":16137,"_30763":137266,"_3518":137613},[],"Dispositivo",{"_4070":82849,"_34195":82714,"_23354":137615,"_5":16137,"_30763":137266,"_3518":61021},[],{"_4070":82850,"_34195":82714,"_23354":137617,"_5":16137,"_30763":137266,"_3518":61024},[],{"_4070":82851,"_34195":82714,"_23354":137619,"_5":16137,"_30763":137266,"_3518":137620},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_4070":82852,"_34195":82714,"_23354":137622,"_5":16137,"_30763":137266,"_3518":137313},[],{"_4070":82853,"_34195":82714,"_23354":137624,"_5":16137,"_30763":137266,"_3518":61032},[],{"_4070":82854,"_34195":82714,"_23354":137626,"_5":16137,"_30763":137266,"_3518":137627},[],"Certificado",{"_4070":82855,"_34195":82714,"_23354":137629,"_5":16137,"_30763":137266,"_3518":61038},[],{"_4070":82856,"_34195":82714,"_23354":137631,"_5":16137,"_30763":137266,"_3518":137632},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_4070":82857,"_34195":82714,"_23354":137634,"_5":16137,"_30763":137266,"_3518":137635},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_4070":82858,"_34195":82714,"_23354":137637,"_5":16137,"_30763":137266,"_3518":137325},[],{"_4070":82859,"_34195":82714,"_23354":137639,"_5":16137,"_30763":137266,"_3518":61049},[],{"_4070":82860,"_34195":82714,"_23354":137641,"_5":16137,"_30763":137266,"_3518":137642},[],"Certificado / Dispositivo",{"_4070":82861,"_34195":82714,"_23354":137644,"_5":16137,"_30763":137266,"_3518":61055},[],{"_4070":82862,"_34195":82714,"_23354":137646,"_5":16137,"_30763":137266,"_3518":57068},[],{"_4070":82863,"_34195":82714,"_23354":137648,"_5":16137,"_30763":137266,"_3518":137649},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_4070":82864,"_34195":82714,"_23354":137651,"_5":16137,"_30763":137266,"_3518":137333},[],{"_4070":82865,"_34195":82714,"_23354":137653,"_5":16137,"_30763":137270,"_3518":137654},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_4070":82866,"_34195":82714,"_23354":137656,"_5":16137,"_30763":137274,"_3518":137657},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_4070":82867,"_34195":82714,"_23354":137659,"_5":16137,"_30763":137274,"_3518":137660},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_4070":82868,"_34195":82714,"_23354":137662,"_5":16137,"_30763":137278,"_3518":137663},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_4070":82869,"_34195":82714,"_23354":137665,"_5":16137,"_30763":137278,"_3518":137666},[],"Transición",{"_4070":82870,"_34195":82714,"_23354":137668,"_5":16137,"_30763":137278,"_3518":137669},[],"Llamadas AWS",{"_4070":82871,"_34195":82714,"_23354":137671,"_5":16137,"_30763":137278,"_3518":137672},[],"`NoRegistrada` → `Solicitada`",{"_4070":82872,"_34195":82714,"_23354":137674,"_5":16137,"_30763":137278,"_3518":137675},[],"ninguna (solo escritura de metadatos)",{"_4070":82873,"_34195":82714,"_23354":137677,"_5":16137,"_30763":137278,"_3518":137678},[],"`Solicitada` → `Registrando`",{"_4070":82874,"_34195":82714,"_23354":137680,"_5":16137,"_30763":137278,"_3518":137681},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_4070":82875,"_34195":82714,"_23354":137683,"_5":16137,"_30763":137278,"_3518":137684},[],"`Registrando` → `Completada`",{"_4070":82876,"_34195":82714,"_23354":137686,"_5":16137,"_30763":137278,"_3518":137687},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_4070":82877,"_34195":82714,"_23354":137689,"_5":16137,"_30763":137278,"_3518":137690},[],"`Registrando` → `Fallida`",{"_4070":82878,"_34195":82714,"_23354":137692,"_5":16137,"_30763":137278,"_3518":137693},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_4070":82879,"_34195":82714,"_23354":137695,"_5":16137,"_30763":137278,"_3518":137696},[],"`Fallida` / `Completada` → `Solicitada`",{"_4070":82880,"_34195":82714,"_23354":137698,"_5":16137,"_30763":137278,"_3518":137699},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_4070":82881,"_34195":82714,"_23354":137701,"_5":16137,"_30763":137282,"_3518":137702},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_4070":82882,"_34195":82714,"_23354":137704,"_5":16137,"_30763":137282,"_3518":137705},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_4070":82883,"_34195":82714,"_23354":137707,"_5":16137,"_30763":137282,"_3518":137708},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_4070":82884,"_34195":82714,"_23354":137710,"_5":16137,"_30763":137282,"_3518":137711},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_4070":82885,"_34195":82714,"_23354":137713,"_5":16137,"_30763":137282,"_3518":137714},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_4070":82886,"_34195":82714,"_23354":137716,"_5":16137,"_30763":137282,"_3518":137717},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_4070":82887,"_34195":82714,"_23354":137719,"_5":16137,"_30763":137285,"_3518":137720},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_4070":82888,"_34195":82714,"_23354":137722,"_5":16137,"_30763":137288,"_3518":137723},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_4070":82889,"_34195":82714,"_23354":137725,"_5":16137,"_30763":137288,"_3518":137726},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_4070":82890,"_34195":82714,"_23354":137728,"_5":16137,"_30763":137292,"_3518":137729},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_4070":82891,"_34195":82714,"_23354":137731,"_5":16137,"_30763":137296,"_3518":137732},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_4070":82892,"_34195":82714,"_23354":137734,"_5":16137,"_30763":137296,"_3518":137735},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_4070":82893,"_34195":82714,"_23354":137737,"_5":16137,"_30763":137296,"_3518":137738},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_4070":82894,"_34195":82714,"_23354":137740,"_5":16137,"_30763":137296,"_3518":137741},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_4070":82895,"_34195":82714,"_23354":137743,"_5":16137,"_30763":137296,"_3518":137744},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_4070":82896,"_34195":82714,"_23354":137746,"_5":16137,"_30763":137296,"_3518":137747},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_4070":82897,"_34195":82714,"_23354":137749,"_5":16137,"_30763":137300,"_3518":137750},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_4070":82898,"_34195":82714,"_23354":137752,"_5":16137,"_30763":137300,"_3518":137753},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_4070":82899,"_34195":82714,"_23354":137755,"_5":16137,"_30763":137300,"_3518":137756},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_4070":82900,"_34195":82714,"_23354":137758,"_5":16137,"_30763":137300,"_3518":137759},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_4070":82901,"_34195":82714,"_23354":137761,"_5":16137,"_30763":137300,"_3518":137762},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_4070":82902,"_34195":82714,"_23354":137764,"_5":16137,"_30763":137304,"_3518":137765},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_4070":82903,"_34195":82714,"_23354":137767,"_5":16137,"_30763":137304,"_3518":137666},[],{"_4070":82904,"_34195":82714,"_23354":137769,"_5":16137,"_30763":137304,"_3518":137669},[],{"_4070":82905,"_34195":82714,"_23354":137771,"_5":16137,"_30763":137304,"_3518":137772},[],"`SinConfigurar` → `None` / `Auto`",{"_4070":82906,"_34195":82714,"_23354":137774,"_5":16137,"_30763":137304,"_3518":137775},[],"ninguna (solo configuración)",{"_4070":82907,"_34195":82714,"_23354":137777,"_5":16137,"_30763":137304,"_3518":61192},[],{"_4070":82908,"_34195":82714,"_23354":137779,"_5":16137,"_30763":137304,"_3518":137775},[],{"_4070":82909,"_34195":82714,"_23354":137781,"_5":16137,"_30763":137304,"_3518":137782},[],"Cualquiera → `Jitp`",{"_4070":82910,"_34195":82714,"_23354":137784,"_5":16137,"_30763":137304,"_3518":137785},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_4070":82911,"_34195":82714,"_23354":137787,"_5":16137,"_30763":137304,"_3518":61203},[],{"_4070":82912,"_34195":82714,"_23354":137789,"_5":16137,"_30763":137304,"_3518":137790},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_4070":82913,"_34195":82714,"_23354":137792,"_5":16137,"_30763":137308,"_3518":137793},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_4070":82914,"_34195":82714,"_23354":137795,"_5":16137,"_30763":137308,"_3518":137796},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_4070":82915,"_34195":82714,"_23354":137798,"_5":16137,"_30763":137308,"_3518":137799},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_4070":82916,"_34195":82714,"_23354":137801,"_5":16137,"_30763":137312,"_3518":137802},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_4070":82917,"_34195":82714,"_23354":137804,"_5":16137,"_30763":137312,"_3518":137666},[],{"_4070":82918,"_34195":82714,"_23354":137806,"_5":16137,"_30763":137312,"_3518":137669},[],{"_4070":82919,"_34195":82714,"_23354":137808,"_5":16137,"_30763":137312,"_3518":137809},[],"`Ausente` → `Aprovisionado`",{"_4070":82920,"_34195":82714,"_23354":137811,"_5":16137,"_30763":137312,"_3518":137812},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_4070":82921,"_34195":82714,"_23354":137814,"_5":16137,"_30763":137312,"_3518":137815},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_4070":82922,"_34195":82714,"_23354":137817,"_5":16137,"_30763":137312,"_3518":137818},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_4070":82923,"_34195":82714,"_23354":137820,"_5":16137,"_30763":137312,"_3518":137821},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_4070":82924,"_34195":82714,"_23354":137823,"_5":16137,"_30763":137316,"_3518":137824},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_4070":82925,"_34195":82714,"_23354":137826,"_5":16137,"_30763":137316,"_3518":137827},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_4070":82926,"_34195":82714,"_23354":137829,"_5":16137,"_30763":137316,"_3518":137830},[],"Para que el flujo JITP funcione correctamente:",{"_4070":82927,"_34195":82714,"_23354":137832,"_5":16137,"_30763":137316,"_3518":137833},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_4070":82928,"_34195":82714,"_23354":137835,"_5":16137,"_30763":137316,"_3518":137836},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_4070":82929,"_34195":82714,"_23354":137838,"_5":16137,"_30763":137316,"_3518":137839},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_4070":82930,"_34195":82714,"_23354":137841,"_5":16137,"_30763":137316,"_3518":137842},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_4070":82931,"_34195":82714,"_23354":137844,"_5":16137,"_30763":137320,"_3518":137845},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_4070":82932,"_34195":82714,"_23354":137847,"_5":16137,"_30763":137320,"_3518":137848},[],"Estado en Lamassu",{"_4070":82933,"_34195":82714,"_23354":137850,"_5":16137,"_30763":137320,"_3518":137851},[],"Razón de revocación",{"_4070":82934,"_34195":82714,"_23354":137853,"_5":16137,"_30763":137320,"_3518":137854},[],"Estado en AWS IoT Core",{"_4070":82935,"_34195":82714,"_23354":137856,"_5":16137,"_30763":137320,"_3518":61273},[],{"_4070":82936,"_34195":82714,"_23354":137858,"_5":16137,"_30763":137320,"_3518":137859},[],"Ninguna",{"_4070":82937,"_34195":82714,"_23354":137861,"_5":16137,"_30763":137320,"_3518":61279},[],{"_4070":82938,"_34195":82714,"_23354":137863,"_5":16137,"_30763":137320,"_3518":61282},[],{"_4070":82939,"_34195":82714,"_23354":137865,"_5":16137,"_30763":137320,"_3518":61285},[],{"_4070":82940,"_34195":82714,"_23354":137867,"_5":16137,"_30763":137320,"_3518":61288},[],{"_4070":82941,"_34195":82714,"_23354":137869,"_5":16137,"_30763":137320,"_3518":61282},[],{"_4070":82942,"_34195":82714,"_23354":137871,"_5":16137,"_30763":137320,"_3518":137872},[],"Cualquier otra razón",{"_4070":82943,"_34195":82714,"_23354":137874,"_5":16137,"_30763":137320,"_3518":61296},[],{"_4070":82944,"_34195":82714,"_23354":137876,"_5":16137,"_30763":137320,"_3518":137877},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_4070":82945,"_34195":82714,"_23354":137879,"_5":16137,"_30763":137324,"_3518":137880},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_4070":82946,"_34195":82714,"_23354":137882,"_5":16137,"_30763":137324,"_3518":137666},[],{"_4070":82947,"_34195":82714,"_23354":137884,"_5":16137,"_30763":137324,"_3518":137669},[],{"_4070":82948,"_34195":82714,"_23354":137886,"_5":16137,"_30763":137324,"_3518":137887},[],"`NoSincronizado` → `Active`",{"_4070":82949,"_34195":82714,"_23354":137889,"_5":16137,"_30763":137324,"_3518":60788},[],{"_4070":82950,"_34195":82714,"_23354":137891,"_5":16137,"_30763":137324,"_3518":61314},[],{"_4070":82951,"_34195":82714,"_23354":137893,"_5":16137,"_30763":137324,"_3518":137894},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_4070":82952,"_34195":82714,"_23354":137896,"_5":16137,"_30763":137324,"_3518":61320},[],{"_4070":82953,"_34195":82714,"_23354":137898,"_5":16137,"_30763":137324,"_3518":137894},[],{"_4070":82954,"_34195":82714,"_23354":137900,"_5":16137,"_30763":137324,"_3518":61325},[],{"_4070":82955,"_34195":82714,"_23354":137902,"_5":16137,"_30763":137324,"_3518":60788},[],{"_4070":82956,"_34195":82714,"_23354":137904,"_5":16137,"_30763":137324,"_3518":61330},[],{"_4070":82957,"_34195":82714,"_23354":137906,"_5":16137,"_30763":137324,"_3518":137907},[],"ninguna (estos estados no se sincronizan con AWS)",{"_4070":82958,"_34195":82714,"_23354":137909,"_5":16137,"_30763":137328,"_3518":137910},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_4070":82959,"_34195":82714,"_23354":137912,"_5":16137,"_30763":137328,"_3518":137913},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_4070":82960,"_34195":82714,"_23354":137915,"_5":16137,"_30763":137328,"_3518":137916},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_4070":82961,"_34195":82714,"_23354":137918,"_5":16137,"_30763":137332,"_3518":137919},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_4070":82962,"_34195":82714,"_23354":137921,"_5":16137,"_30763":137332,"_3518":137922},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_4070":82963,"_34195":82714,"_23354":137924,"_5":16137,"_30763":137336,"_3518":137925},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_4070":82964,"_34195":82714,"_23354":137927,"_5":16137,"_30763":137336,"_3518":137928},[],"Existen dos tipos de acciones:",{"_4070":82965,"_34195":82714,"_23354":137930,"_5":16137,"_30763":137336,"_3518":137931},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_4070":82966,"_34195":82714,"_23354":137933,"_5":16137,"_30763":137336,"_3518":137934},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_4070":82967,"_34195":82714,"_23354":137936,"_5":16137,"_30763":137336,"_3518":137937},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_4070":82968,"_34195":82714,"_23354":137939,"_5":16137,"_30763":137340,"_3518":137940},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_4070":82969,"_34195":82714,"_23354":137942,"_5":16137,"_30763":137340,"_3518":137943},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_4070":82970,"_34195":82714,"_23354":137945,"_5":16137,"_30763":137340,"_3518":137946},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_4070":82971,"_34195":82714,"_23354":137948,"_5":16137,"_30763":137344,"_3518":137949},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_4070":82972,"_34195":82714,"_23354":137951,"_5":16137,"_30763":137344,"_3518":137952},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_4070":82973,"_34195":82714,"_23354":137954,"_5":16137,"_30763":137344,"_3518":137955},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_4070":82974,"_34195":82714,"_23354":137957,"_5":16137,"_30763":137344,"_3518":137958},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_4070":82975,"_34195":82714,"_23354":137960,"_5":16137,"_30763":137344,"_3518":137961},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_4070":82976,"_34195":82714,"_23354":137963,"_5":16137,"_30763":137344,"_3518":137964},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_4070":82977,"_34195":82714,"_23354":137966,"_5":16137,"_30763":137344,"_3518":137967},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_4070":82978,"_34195":82714,"_23354":137969,"_5":16137,"_30763":137344,"_3518":137970},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_4070":82979,"_34195":82714,"_23354":137972,"_5":16137,"_30763":137344,"_3518":137973},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_4070":82980,"_34195":82714,"_23354":137975,"_5":16137,"_30763":137344,"_3518":137976},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_4070":82981,"_34195":82714,"_23354":137978,"_5":16137,"_30763":137344,"_3518":137979},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_4070":82982,"_34195":82714,"_23354":137981,"_5":16137,"_30763":137344,"_3518":137982},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_4070":82983,"_34195":82714,"_23354":137984,"_5":16137,"_30763":137344,"_3518":137985},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_4070":82984,"_34195":82714,"_23354":137987,"_5":16137,"_30763":137344,"_3518":137988},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_4070":82985,"_34195":82714,"_23354":137990,"_5":16137,"_30763":137344,"_3518":137991},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_4070":82986,"_34195":82714,"_23354":137993,"_5":16137,"_30763":137344,"_3518":137994},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_4070":82987,"_34195":82714,"_23354":137996,"_5":16137,"_30763":137344,"_3518":137997},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_4070":82988,"_34195":82714,"_23354":137999,"_5":16137,"_30763":137344,"_3518":138000},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_4070":82989,"_34195":82714,"_23354":138002,"_5":16137,"_30763":137344,"_3518":138003},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_4070":82990,"_34195":82714,"_23354":138005,"_5":16137,"_30763":137344,"_3518":138006},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_4070":82991,"_34195":82714,"_23354":138008,"_5":16137,"_30763":137344,"_3518":138009},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_4070":82992,"_34195":82714,"_23354":138011,"_5":16137,"_30763":137344,"_3518":138012},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_4070":82993,"_34195":82714,"_23354":138014,"_5":16137,"_30763":137344,"_3518":138015},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_4070":82994,"_34195":82714,"_23354":138017,"_5":16137,"_30763":137344,"_3518":138018},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_4070":82995,"_34195":82995,"_5":16540,"_3518":59151,"_34626":138020,"_23354":138021,"_30763":82995},[56672,134827,59151],[],{"_4070":82996,"_34195":82995,"_23354":138023,"_5":16137,"_30763":82995,"_3518":138024},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_4070":82997,"_34195":82995,"_5":34623,"_23354":138026,"_30763":138027,"_3518":138028},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_4070":82998,"_34195":82995,"_5":34623,"_23354":138030,"_30763":138031,"_3518":135836},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_4070":82999,"_34195":82995,"_5":34623,"_23354":138033,"_30763":138034,"_3518":136011},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_4070":83000,"_34195":82995,"_5":34623,"_23354":138036,"_30763":138037,"_3518":137243},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/overview#integraciones",{"_4070":83001,"_34195":82995,"_5":34623,"_23354":138039,"_30763":138040,"_3518":138041},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_4070":83002,"_34195":82995,"_23354":138043,"_5":16137,"_30763":82995,"_3518":138044},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_4070":83003,"_34195":82995,"_23354":138046,"_5":16137,"_30763":138027,"_3518":138047},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_4070":83004,"_34195":82995,"_23354":138049,"_5":16137,"_30763":138027,"_3518":138050},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_4070":83005,"_34195":82995,"_23354":138052,"_5":16137,"_30763":138031,"_3518":138053},[],"Recurso",{"_4070":83006,"_34195":82995,"_23354":138055,"_5":16137,"_30763":138031,"_3518":138056},[],"Qué representa",{"_4070":83007,"_34195":82995,"_23354":138058,"_5":16137,"_30763":138031,"_3518":138059},[],"**Dispositivo**",{"_4070":83008,"_34195":82995,"_23354":138061,"_5":16137,"_30763":138031,"_3518":138062},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_4070":83009,"_34195":82995,"_23354":138064,"_5":16137,"_30763":138031,"_3518":138065},[],"**Identidad**",{"_4070":83010,"_34195":82995,"_23354":138067,"_5":16137,"_30763":138031,"_3518":138068},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_4070":83011,"_34195":82995,"_23354":138070,"_5":16137,"_30763":138031,"_3518":61497},[],{"_4070":83012,"_34195":82995,"_23354":138072,"_5":16137,"_30763":138031,"_3518":138073},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_4070":83013,"_34195":82995,"_23354":138075,"_5":16137,"_30763":138031,"_3518":138076},[],"**Flota**",{"_4070":83014,"_34195":82995,"_23354":138078,"_5":16137,"_30763":138031,"_3518":138079},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_4070":83015,"_34195":82995,"_23354":138081,"_5":16137,"_30763":138031,"_3518":138082},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_4070":83016,"_34195":82995,"_23354":138084,"_5":16137,"_30763":138031,"_3518":138085},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_4070":83017,"_34195":82995,"_23354":138087,"_5":16137,"_30763":138034,"_3518":138088},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_4070":83018,"_34195":82995,"_23354":138090,"_5":16137,"_30763":138034,"_3518":138091},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_4070":83019,"_34195":82995,"_23354":138093,"_5":16137,"_30763":138034,"_3518":138094},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_4070":83020,"_34195":82995,"_23354":138096,"_5":16137,"_30763":138034,"_3518":138097},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_4070":83021,"_34195":82995,"_23354":138099,"_5":16137,"_30763":138034,"_3518":138100},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_4070":83022,"_34195":82995,"_23354":138102,"_5":16137,"_30763":138034,"_3518":138103},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_4070":83023,"_34195":82995,"_23354":138105,"_5":16137,"_30763":138034,"_3518":138106},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_4070":83024,"_34195":82995,"_23354":138108,"_5":16137,"_30763":138034,"_3518":138109},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_4070":83025,"_34195":82995,"_23354":138111,"_5":16137,"_30763":138037,"_3518":138112},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_4070":83026,"_34195":82995,"_23354":138114,"_5":16137,"_30763":138037,"_3518":138115},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_4070":83027,"_34195":82995,"_23354":138117,"_5":16137,"_30763":138040,"_3518":138118},[],"Participante",{"_4070":83028,"_34195":82995,"_23354":138120,"_5":16137,"_30763":138040,"_3518":138121},[],"Responsabilidad",{"_4070":83029,"_34195":82995,"_23354":138123,"_5":16137,"_30763":138040,"_3518":138124},[],"Administrador PKI",{"_4070":83030,"_34195":82995,"_23354":138126,"_5":16137,"_30763":138040,"_3518":138127},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_4070":83031,"_34195":82995,"_23354":138129,"_5":16137,"_30763":138040,"_3518":138130},[],"Administrador del aprovisionamiento",{"_4070":83032,"_34195":82995,"_23354":138132,"_5":16137,"_30763":138040,"_3518":138133},[],"DMS, admisión, autenticación por operación e inventario.",{"_4070":83033,"_34195":82995,"_23354":138135,"_5":16137,"_30763":138040,"_3518":138136},[],"Integrador del dispositivo",{"_4070":83034,"_34195":82995,"_23354":138138,"_5":16137,"_30763":138040,"_3518":138139},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_4070":83035,"_34195":82995,"_23354":138141,"_5":16137,"_30763":138040,"_3518":138142},[],"Integrador del consumidor",{"_4070":83036,"_34195":82995,"_23354":138144,"_5":16137,"_30763":138040,"_3518":138145},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_4070":83037,"_34195":82995,"_23354":138147,"_5":16137,"_30763":138040,"_3518":138148},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_4070":83038,"_34195":83038,"_5":16540,"_3518":138150,"_34626":138151,"_23354":138153,"_30763":83038},"Enrola y conecta tu primer dispositivo",[56672,134827,59151,138152],"Primeros pasos",[],{"_4070":83039,"_34195":83038,"_23354":138155,"_5":16137,"_30763":83038,"_3518":138156},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_4070":83040,"_34195":83038,"_5":34623,"_23354":138158,"_30763":138159,"_3518":133405},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_4070":83041,"_34195":83038,"_5":34623,"_23354":138161,"_30763":138162,"_3518":138163},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_4070":83042,"_34195":83038,"_5":34623,"_23354":138165,"_30763":138166,"_3518":138167},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_4070":83043,"_34195":83038,"_5":34623,"_23354":138169,"_30763":138170,"_3518":138171},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_4070":83044,"_34195":83038,"_5":34623,"_23354":138173,"_30763":138174,"_3518":138175},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_4070":83045,"_34195":83038,"_5":34623,"_23354":138177,"_30763":138178,"_3518":138179},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_4070":83046,"_34195":83038,"_5":34623,"_23354":138181,"_30763":138182,"_3518":138183},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_4070":83047,"_34195":83038,"_5":34623,"_23354":138185,"_30763":138186,"_3518":138187},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_4070":83048,"_34195":83038,"_23354":138189,"_5":16137,"_30763":83038,"_3518":138190},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_4070":83049,"_34195":83038,"_23354":138192,"_5":16137,"_30763":138159,"_3518":138193},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_4070":83050,"_34195":83038,"_23354":138195,"_5":16137,"_30763":138159,"_3518":138196},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_4070":83051,"_34195":83038,"_23354":138198,"_5":16137,"_30763":138159,"_3518":138199},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_4070":83052,"_34195":83038,"_23354":138201,"_5":16137,"_30763":138159,"_3518":138202},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_4070":83053,"_34195":83038,"_23354":138204,"_5":16137,"_30763":138159,"_3518":138205},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_4070":83054,"_34195":83038,"_23354":138207,"_5":16137,"_30763":138162,"_3518":138208},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_4070":83055,"_34195":83038,"_23354":138210,"_5":16137,"_30763":138162,"_3518":138211},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_4070":83056,"_34195":83038,"_23354":138213,"_5":16137,"_30763":138166,"_3518":138214},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_4070":83057,"_34195":83038,"_23354":138216,"_5":16137,"_30763":138166,"_3518":138217},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_4070":83058,"_34195":83038,"_23354":138219,"_5":16137,"_30763":138166,"_3518":138220},[],"Ajuste",{"_4070":83059,"_34195":83038,"_23354":138222,"_5":16137,"_30763":138166,"_3518":138223},[],"Valor de evaluación",{"_4070":83060,"_34195":83038,"_23354":138225,"_5":16137,"_30763":138166,"_3518":61653},[],{"_4070":83061,"_34195":83038,"_23354":138227,"_5":16137,"_30763":138166,"_3518":138228},[],"Raíz emisora de `device-root.pem`.",{"_4070":83062,"_34195":83038,"_23354":138230,"_5":16137,"_30763":138166,"_3518":136139},[],{"_4070":83063,"_34195":83038,"_23354":138232,"_5":16137,"_30763":138166,"_3518":138233},[],"Perfil final de 1 hora que acabas de preparar.",{"_4070":83064,"_34195":83038,"_23354":138235,"_5":16137,"_30763":138166,"_3518":61664},[],{"_4070":83065,"_34195":83038,"_23354":138237,"_5":16137,"_30763":138166,"_3518":61667},[],{"_4070":83066,"_34195":83038,"_23354":138239,"_5":16137,"_30763":138166,"_3518":61670},[],{"_4070":83067,"_34195":83038,"_23354":138241,"_5":16137,"_30763":138166,"_3518":138242},[],"Habilitado.",{"_4070":83068,"_34195":83038,"_23354":138244,"_5":16137,"_30763":138166,"_3518":61676},[],{"_4070":83069,"_34195":83038,"_23354":138246,"_5":16137,"_30763":138166,"_3518":138247},[],"Deshabilitado; el ID debe ser nuevo.",{"_4070":83070,"_34195":83038,"_23354":138249,"_5":16137,"_30763":138166,"_3518":138250},[],"Autenticación inicial",{"_4070":83071,"_34195":83038,"_23354":138252,"_5":16137,"_30763":138166,"_3518":138253},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_4070":83072,"_34195":83038,"_23354":138255,"_5":16137,"_30763":138166,"_3518":138256},[],"Autenticación de renovación",{"_4070":83073,"_34195":83038,"_23354":138258,"_5":16137,"_30763":138166,"_3518":138259},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_4070":83074,"_34195":83038,"_23354":138261,"_5":16137,"_30763":138166,"_3518":61694},[],{"_4070":83075,"_34195":83038,"_23354":138263,"_5":16137,"_30763":138166,"_3518":138264},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_4070":83076,"_34195":83038,"_23354":138266,"_5":16137,"_30763":138166,"_3518":61700},[],{"_4070":83077,"_34195":83038,"_23354":138268,"_5":16137,"_30763":138166,"_3518":138269},[],"1 hora.",{"_4070":83078,"_34195":83038,"_23354":138271,"_5":16137,"_30763":138166,"_3518":61706},[],{"_4070":83079,"_34195":83038,"_23354":138273,"_5":16137,"_30763":138166,"_3518":138274},[],"30 minutos / 10 minutos.",{"_4070":83080,"_34195":83038,"_23354":138276,"_5":16137,"_30763":138166,"_3518":61712},[],{"_4070":83081,"_34195":83038,"_23354":138278,"_5":16137,"_30763":138166,"_3518":138279},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_4070":83082,"_34195":83038,"_23354":138281,"_5":16137,"_30763":138166,"_3518":59470},[],{"_4070":83083,"_34195":83038,"_23354":138283,"_5":16137,"_30763":138166,"_3518":138284},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_4070":83084,"_34195":83038,"_23354":138286,"_5":16137,"_30763":138166,"_3518":61723},[],{"_4070":83085,"_34195":83038,"_23354":138288,"_5":16137,"_30763":138166,"_3518":138289},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_4070":83086,"_34195":83038,"_23354":138291,"_5":16137,"_30763":138166,"_3518":138292},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_4070":83087,"_34195":83038,"_23354":138294,"_5":16137,"_30763":138170,"_3518":138295},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_4070":83088,"_34195":83038,"_23354":138297,"_5":16137,"_30763":138170,"_3518":138298},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_4070":83089,"_34195":83038,"_23354":138300,"_5":16137,"_30763":138174,"_3518":138301},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_4070":83090,"_34195":83038,"_23354":138303,"_5":16137,"_30763":138174,"_3518":138304},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_4070":83091,"_34195":83038,"_23354":138306,"_5":16137,"_30763":138174,"_3518":138307},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_4070":83092,"_34195":83038,"_23354":138309,"_5":16137,"_30763":138178,"_3518":138310},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_4070":83093,"_34195":83038,"_23354":138312,"_5":16137,"_30763":138178,"_3518":138313},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_4070":83094,"_34195":83038,"_23354":138315,"_5":16137,"_30763":138182,"_3518":138316},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_4070":83095,"_34195":83038,"_23354":138318,"_5":16137,"_30763":138182,"_3518":138319},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_4070":83096,"_34195":83038,"_23354":138321,"_5":16137,"_30763":138182,"_3518":138322},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_4070":83097,"_34195":83038,"_23354":138324,"_5":16137,"_30763":138182,"_3518":138325},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_4070":83098,"_34195":83038,"_23354":138327,"_5":16137,"_30763":138182,"_3518":138328},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_4070":83099,"_34195":83038,"_23354":138330,"_5":16137,"_30763":138186,"_3518":138331},[],"Comprobación",{"_4070":83100,"_34195":83038,"_23354":138333,"_5":16137,"_30763":138186,"_3518":138334},[],"Resultado esperado",{"_4070":83101,"_34195":83038,"_23354":138336,"_5":16137,"_30763":138186,"_3518":138337},[],"Registro",{"_4070":83102,"_34195":83038,"_23354":138339,"_5":16137,"_30763":138186,"_3518":138340},[],"ID creado automáticamente y DMS correcto.",{"_4070":83103,"_34195":83038,"_23354":138342,"_5":16137,"_30763":138186,"_3518":137627},[],{"_4070":83104,"_34195":83038,"_23354":138344,"_5":16137,"_30763":138186,"_3518":138345},[],"CN, perfil, serie y clave verificados.",{"_4070":83105,"_34195":83038,"_23354":138347,"_5":16137,"_30763":138186,"_3518":138348},[],"Inventario",{"_4070":83106,"_34195":83038,"_23354":138350,"_5":16137,"_30763":138186,"_3518":138351},[],"Serie recibida visible como identidad actual y en el historial.",{"_4070":83107,"_34195":83038,"_23354":138353,"_5":16137,"_30763":138186,"_3518":138354},[],"Consumidor",{"_4070":83108,"_34195":83038,"_23354":138356,"_5":16137,"_30763":138186,"_3518":138357},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_4070":83109,"_34195":83038,"_23354":138359,"_5":16137,"_30763":138186,"_3518":138360},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_4070":83110,"_34195":83038,"_23354":138362,"_5":16137,"_30763":138186,"_3518":138363},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_4070":83111,"_34195":83111,"_5":16540,"_3518":135853,"_34626":138365,"_23354":138366,"_30763":83111},[56672,134827,59151,138152],[],{"_4070":83112,"_34195":83111,"_23354":138368,"_5":16137,"_30763":83111,"_3518":138369},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_4070":83113,"_34195":83111,"_5":34623,"_23354":138371,"_30763":138372,"_3518":133405},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_4070":83114,"_34195":83111,"_5":34623,"_23354":138374,"_30763":138375,"_3518":138376},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_4070":83115,"_34195":83111,"_5":34623,"_23354":138378,"_30763":138379,"_3518":138380},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_4070":83116,"_34195":83111,"_5":34623,"_23354":138382,"_30763":138383,"_3518":138384},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_4070":83117,"_34195":83111,"_5":34623,"_23354":138386,"_30763":138387,"_3518":138388},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_4070":83118,"_34195":83111,"_5":34623,"_23354":138390,"_30763":138391,"_3518":138392},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_4070":83119,"_34195":83111,"_5":34623,"_23354":138394,"_30763":138395,"_3518":138334},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_4070":83120,"_34195":83111,"_5":34623,"_23354":138397,"_30763":138398,"_3518":138399},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_4070":83121,"_34195":83111,"_5":34623,"_23354":138401,"_30763":138402,"_3518":138403},[],"/docs/pr-preview/pr-58/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_4070":83122,"_34195":83111,"_23354":138405,"_5":16137,"_30763":83111,"_3518":138406},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_4070":83123,"_34195":83111,"_23354":138408,"_5":16137,"_30763":83111,"_3518":138409},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_4070":83124,"_34195":83111,"_23354":138411,"_5":16137,"_30763":138372,"_3518":138412},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_4070":83125,"_34195":83111,"_23354":138414,"_5":16137,"_30763":138372,"_3518":138415},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_4070":83126,"_34195":83111,"_23354":138417,"_5":16137,"_30763":138372,"_3518":138418},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_4070":83127,"_34195":83111,"_23354":138420,"_5":16137,"_30763":138372,"_3518":138421},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_4070":83128,"_34195":83111,"_23354":138423,"_5":16137,"_30763":138375,"_3518":138424},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_4070":83129,"_34195":83111,"_23354":138426,"_5":16137,"_30763":138375,"_3518":138427},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_4070":83130,"_34195":83111,"_23354":138429,"_5":16137,"_30763":138375,"_3518":138430},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_4070":83131,"_34195":83111,"_23354":138432,"_5":16137,"_30763":138375,"_3518":138433},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_4070":83132,"_34195":83111,"_23354":138435,"_5":16137,"_30763":138375,"_3518":138436},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_4070":83133,"_34195":83111,"_23354":138438,"_5":16137,"_30763":138375,"_3518":138439},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_4070":83134,"_34195":83111,"_23354":138441,"_5":16137,"_30763":138375,"_3518":138442},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_4070":83135,"_34195":83111,"_23354":138444,"_5":16137,"_30763":138375,"_3518":138445},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_4070":83136,"_34195":83111,"_23354":138447,"_5":16137,"_30763":138379,"_3518":138448},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_4070":83137,"_34195":83111,"_23354":138450,"_5":16137,"_30763":138379,"_3518":61888},[],{"_4070":83138,"_34195":83111,"_23354":138452,"_5":16137,"_30763":138379,"_3518":138453},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_4070":83139,"_34195":83111,"_23354":138455,"_5":16137,"_30763":138379,"_3518":138456},[],"**Icon** y **Tags**: clasificación opcional.",{"_4070":83140,"_34195":83111,"_23354":138458,"_5":16137,"_30763":138379,"_3518":138459},[],"Confirma el registro.",{"_4070":83141,"_34195":83111,"_23354":138461,"_5":16137,"_30763":138383,"_3518":138462},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_4070":83142,"_34195":83111,"_23354":138464,"_5":16137,"_30763":138383,"_3518":138465},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_4070":83143,"_34195":83111,"_23354":138467,"_5":16137,"_30763":138387,"_3518":138468},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_4070":83144,"_34195":83111,"_23354":138470,"_5":16137,"_30763":138387,"_3518":138471},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_4070":83145,"_34195":83111,"_23354":138473,"_5":16137,"_30763":138391,"_3518":138474},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_4070":83146,"_34195":83111,"_23354":138476,"_5":16137,"_30763":138391,"_3518":138477},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_4070":83147,"_34195":83111,"_23354":138479,"_5":16137,"_30763":138395,"_3518":138331},[],{"_4070":83148,"_34195":83111,"_23354":138481,"_5":16137,"_30763":138395,"_3518":138482},[],"Resultado",{"_4070":83149,"_34195":83111,"_23354":138484,"_5":16137,"_30763":138395,"_3518":137613},[],{"_4070":83150,"_34195":83111,"_23354":138486,"_5":16137,"_30763":138395,"_3518":138487},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_4070":83151,"_34195":83111,"_23354":138489,"_5":16137,"_30763":138395,"_3518":138490},[],"Identidad actual",{"_4070":83152,"_34195":83111,"_23354":138492,"_5":16137,"_30763":138395,"_3518":138493},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_4070":83153,"_34195":83111,"_23354":138495,"_5":16137,"_30763":138395,"_3518":138496},[],"Historial",{"_4070":83154,"_34195":83111,"_23354":138498,"_5":16137,"_30763":138395,"_3518":138499},[],"La emisión asociada aparece con su número de serie y fechas.",{"_4070":83155,"_34195":83111,"_23354":138501,"_5":16137,"_30763":138395,"_3518":138502},[],"Clave y certificado",{"_4070":83156,"_34195":83111,"_23354":138504,"_5":16137,"_30763":138395,"_3518":138505},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_4070":83157,"_34195":83111,"_23354":138507,"_5":16137,"_30763":138398,"_3518":138508},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_4070":83158,"_34195":83111,"_23354":138510,"_5":16137,"_30763":138398,"_3518":138511},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_4070":83159,"_34195":83111,"_23354":138513,"_5":16137,"_30763":138398,"_3518":138514},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_4070":83160,"_34195":83111,"_23354":138516,"_5":16137,"_30763":138398,"_3518":138517},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_4070":83161,"_34195":83111,"_23354":138519,"_5":16137,"_30763":138402,"_3518":138520},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_4070":83162,"_34195":83111,"_23354":138522,"_5":16137,"_30763":138402,"_3518":138523},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_4070":83163,"_34195":83111,"_23354":138525,"_5":16137,"_30763":138402,"_3518":138526},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_4070":83164,"_34195":83164,"_5":16540,"_3518":138528,"_34626":138529,"_23354":138530,"_30763":83164},"Plataforma Lamassu IoT",[56672,134827],[],{"_4070":83165,"_34195":83164,"_23354":138532,"_5":16137,"_30763":83164,"_3518":138533},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_4070":83166,"_34195":83164,"_5":34623,"_23354":138535,"_30763":138536,"_3518":138028},[],"/docs/pr-preview/pr-58/es/platform/overview#empieza-aquí",{"_4070":83167,"_34195":83164,"_5":34623,"_23354":138538,"_30763":138539,"_3518":138540},[],"/docs/pr-preview/pr-58/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_4070":83168,"_34195":83164,"_5":34623,"_23354":138542,"_30763":138543,"_3518":138544},[],"/docs/pr-preview/pr-58/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_4070":83169,"_34195":83164,"_5":34623,"_23354":138546,"_30763":138547,"_3518":138548},[],"/docs/pr-preview/pr-58/es/platform/overview#capacidades-principales","Capacidades principales",{"_4070":83170,"_34195":83164,"_5":34623,"_23354":138550,"_30763":138551,"_3518":138552},[],"/docs/pr-preview/pr-58/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_4070":83171,"_34195":83164,"_5":34623,"_23354":138554,"_30763":138555,"_3518":138556},[],"/docs/pr-preview/pr-58/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_4070":83172,"_34195":83164,"_5":34623,"_23354":138558,"_30763":138559,"_3518":138560},[],"/docs/pr-preview/pr-58/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_4070":83173,"_34195":83164,"_5":34623,"_23354":138562,"_30763":138563,"_3518":138564},[],"/docs/pr-preview/pr-58/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_4070":83174,"_34195":83164,"_5":34623,"_23354":138566,"_30763":138567,"_3518":138568},[],"/docs/pr-preview/pr-58/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_4070":83175,"_34195":83164,"_5":34623,"_23354":138570,"_30763":138571,"_3518":138572},[],"/docs/pr-preview/pr-58/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_4070":83176,"_34195":83164,"_5":34623,"_23354":138574,"_30763":138575,"_3518":138576},[],"/docs/pr-preview/pr-58/es/platform/overview#referencia-operativa","Referencia operativa",{"_4070":83177,"_34195":83164,"_23354":138578,"_5":16137,"_30763":83164,"_3518":138579},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_4070":83178,"_34195":83164,"_23354":138581,"_5":16137,"_30763":138536,"_3518":138582},[],"Elige el resultado que necesitas obtener:",{"_4070":83179,"_34195":83164,"_23354":138584,"_5":16137,"_30763":138536,"_3518":138585},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_4070":83180,"_34195":83164,"_23354":138587,"_5":16137,"_30763":138536,"_3518":138588},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_4070":83181,"_34195":83164,"_23354":138590,"_5":16137,"_30763":138536,"_3518":138591},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_4070":83182,"_34195":83164,"_23354":138593,"_5":16137,"_30763":138539,"_3518":138594},[],"Bloque",{"_4070":83183,"_34195":83164,"_23354":138596,"_5":16137,"_30763":138539,"_3518":138597},[],"Qué gestionas",{"_4070":83184,"_34195":83164,"_23354":138599,"_5":16137,"_30763":138539,"_3518":138600},[],"Punto de entrada",{"_4070":83185,"_34195":83164,"_23354":138602,"_5":16137,"_30763":138539,"_3518":62041},[],{"_4070":83186,"_34195":83164,"_23354":138604,"_5":16137,"_30763":138539,"_3518":138605},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_4070":83187,"_34195":83164,"_23354":138607,"_5":16137,"_30763":138539,"_3518":138608},[],"Visión general de PKI",{"_4070":83188,"_34195":83164,"_23354":138610,"_5":16137,"_30763":138539,"_3518":62050},[],{"_4070":83189,"_34195":83164,"_23354":138612,"_5":16137,"_30763":138539,"_3518":138613},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_4070":83190,"_34195":83164,"_23354":138615,"_5":16137,"_30763":138539,"_3518":138616},[],"Visión general de IoT Fleets",{"_4070":83191,"_34195":83164,"_23354":138618,"_5":16137,"_30763":138539,"_3518":138619},[],"**Administración**",{"_4070":83192,"_34195":83164,"_23354":138621,"_5":16137,"_30763":138539,"_3518":138622},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_4070":83193,"_34195":83164,"_23354":138624,"_5":16137,"_30763":138539,"_3518":134825},[],{"_4070":83194,"_34195":83164,"_23354":138626,"_5":16137,"_30763":138539,"_3518":138627},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_4070":83195,"_34195":83164,"_23354":138629,"_5":16137,"_30763":138543,"_3518":138630},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_4070":83196,"_34195":83164,"_23354":138632,"_5":16137,"_30763":138543,"_3518":138633},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_4070":83197,"_34195":83164,"_23354":138635,"_5":16137,"_30763":138543,"_3518":138636},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_4070":83198,"_34195":83164,"_23354":138638,"_5":16137,"_30763":138543,"_3518":138639},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_4070":83199,"_34195":83164,"_23354":138641,"_5":16137,"_30763":138543,"_3518":138642},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_4070":83200,"_34195":83164,"_23354":138644,"_5":16137,"_30763":138543,"_3518":138645},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_4070":83201,"_34195":83164,"_23354":138647,"_5":16137,"_30763":138551,"_3518":138648},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_4070":83202,"_34195":83164,"_23354":138650,"_5":16137,"_30763":138555,"_3518":138651},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_4070":83203,"_34195":83164,"_23354":138653,"_5":16137,"_30763":138559,"_3518":138654},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_4070":83204,"_34195":83164,"_23354":138656,"_5":16137,"_30763":138563,"_3518":138657},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_4070":83205,"_34195":83164,"_23354":138659,"_5":16137,"_30763":138567,"_3518":138660},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_4070":83206,"_34195":83164,"_23354":138662,"_5":16137,"_30763":138571,"_3518":138663},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_4070":83207,"_34195":83164,"_23354":138665,"_5":16137,"_30763":138575,"_3518":138121},[],{"_4070":83208,"_34195":83164,"_23354":138667,"_5":16137,"_30763":138575,"_3518":138668},[],"Qué prepara o comprueba",{"_4070":83209,"_34195":83164,"_23354":138670,"_5":16137,"_30763":138575,"_3518":138124},[],{"_4070":83210,"_34195":83164,"_23354":138672,"_5":16137,"_30763":138575,"_3518":138673},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_4070":83211,"_34195":83164,"_23354":138675,"_5":16137,"_30763":138575,"_3518":138676},[],"Administrador de la flota",{"_4070":83212,"_34195":83164,"_23354":138678,"_5":16137,"_30763":138575,"_3518":138679},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_4070":83213,"_34195":83164,"_23354":138681,"_5":16137,"_30763":138575,"_3518":138136},[],{"_4070":83214,"_34195":83164,"_23354":138683,"_5":16137,"_30763":138575,"_3518":138684},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_4070":83215,"_34195":83164,"_23354":138686,"_5":16137,"_30763":138575,"_3518":138142},[],{"_4070":83216,"_34195":83164,"_23354":138688,"_5":16137,"_30763":138575,"_3518":138689},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_4070":83217,"_34195":83164,"_23354":138691,"_5":16137,"_30763":138575,"_3518":138692},[],"Operador de infraestructura",{"_4070":83218,"_34195":83164,"_23354":138694,"_5":16137,"_30763":138575,"_3518":138695},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_4070":83219,"_34195":83164,"_23354":138697,"_5":16137,"_30763":138575,"_3518":138698},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_4070":83220,"_34195":83220,"_5":16540,"_3518":138700,"_34626":138701,"_23354":138703,"_30763":83220},"Jerarquía y rotación de CAs",[56672,134827,62142,138702],"Claves, autoridades y certificados",[],{"_4070":83221,"_34195":83220,"_23354":138705,"_5":16137,"_30763":83220,"_3518":138706},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_4070":83222,"_34195":83220,"_5":34623,"_23354":138708,"_30763":138709,"_3518":138710},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_4070":83223,"_34195":83220,"_5":34623,"_23354":138712,"_30763":138713,"_3518":138714},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_4070":83224,"_34195":83220,"_5":34623,"_23354":138716,"_30763":138717,"_3518":138718},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_4070":83225,"_34195":83220,"_5":34623,"_23354":138720,"_30763":138721,"_3518":138722},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_4070":83226,"_34195":83220,"_5":34623,"_23354":138724,"_30763":138725,"_3518":138726},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_4070":83227,"_34195":83220,"_5":34623,"_23354":138728,"_30763":138729,"_3518":138730},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_4070":83228,"_34195":83220,"_5":34623,"_23354":138732,"_30763":138733,"_3518":138734},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_4070":83229,"_34195":83220,"_5":34623,"_23354":138736,"_30763":138737,"_3518":138738},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_4070":83230,"_34195":83220,"_5":34623,"_23354":138740,"_30763":138741,"_3518":138742},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_4070":83231,"_34195":83220,"_5":34623,"_23354":138744,"_30763":138745,"_3518":138746},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_4070":83232,"_34195":83220,"_5":34623,"_23354":138748,"_30763":138749,"_3518":138750},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_4070":83233,"_34195":83220,"_5":34623,"_23354":138752,"_30763":138753,"_3518":138754},[],"/docs/pr-preview/pr-58/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_4070":83234,"_34195":83220,"_23354":138756,"_5":16137,"_30763":83220,"_3518":138757},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_4070":83235,"_34195":83220,"_23354":138759,"_5":16137,"_30763":83220,"_3518":138760},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_4070":83236,"_34195":83220,"_23354":138762,"_5":16137,"_30763":138709,"_3518":138763},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_4070":83237,"_34195":83220,"_23354":138765,"_5":16137,"_30763":138709,"_3518":138766},[],"entorno, como producción y preproducción;",{"_4070":83238,"_34195":83220,"_23354":138768,"_5":16137,"_30763":138709,"_3518":138769},[],"propietario o equipo operador;",{"_4070":83239,"_34195":83220,"_23354":138771,"_5":16137,"_30763":138709,"_3518":138772},[],"familia de dispositivos o proceso de fabricación;",{"_4070":83240,"_34195":83220,"_23354":138774,"_5":16137,"_30763":138709,"_3518":138775},[],"región o requisito regulatorio;",{"_4070":83241,"_34195":83220,"_23354":138777,"_5":16137,"_30763":138709,"_3518":138778},[],"motor criptográfico o política de clave;",{"_4070":83242,"_34195":83220,"_23354":138780,"_5":16137,"_30763":138709,"_3518":138781},[],"ventana de mantenimiento y ritmo de renovación.",{"_4070":83243,"_34195":83220,"_23354":138783,"_5":16137,"_30763":138709,"_3518":138784},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_4070":83244,"_34195":83220,"_23354":138786,"_5":16137,"_30763":138709,"_3518":138787},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_4070":83245,"_34195":83220,"_23354":138789,"_5":16137,"_30763":138713,"_3518":138790},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_4070":83246,"_34195":83220,"_23354":138792,"_5":16137,"_30763":138713,"_3518":138793},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_4070":83247,"_34195":83220,"_23354":138795,"_5":16137,"_30763":138713,"_3518":138796},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_4070":83248,"_34195":83220,"_23354":138798,"_5":16137,"_30763":138717,"_3518":138799},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_4070":83249,"_34195":83220,"_23354":138801,"_5":16137,"_30763":138717,"_3518":138802},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_4070":83250,"_34195":83220,"_23354":138804,"_5":16137,"_30763":138717,"_3518":138805},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_4070":83251,"_34195":83220,"_23354":138807,"_5":16137,"_30763":138717,"_3518":138808},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_4070":83252,"_34195":83220,"_23354":138810,"_5":16137,"_30763":138725,"_3518":138811},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_4070":83253,"_34195":83220,"_23354":138813,"_5":16137,"_30763":138729,"_3518":138814},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_4070":83254,"_34195":83220,"_23354":138816,"_5":16137,"_30763":138733,"_3518":138817},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_4070":83255,"_34195":83220,"_23354":138819,"_5":16137,"_30763":138737,"_3518":138820},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_4070":83256,"_34195":83220,"_23354":138822,"_5":16137,"_30763":138741,"_3518":138823},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_4070":83257,"_34195":83220,"_23354":138825,"_5":16137,"_30763":138745,"_3518":138826},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_4070":83258,"_34195":83220,"_23354":138828,"_5":16137,"_30763":138749,"_3518":138829},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_4070":83259,"_34195":83220,"_23354":138831,"_5":16137,"_30763":138749,"_3518":138832},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_4070":83260,"_34195":83220,"_23354":138834,"_5":16137,"_30763":138749,"_3518":138835},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_4070":83261,"_34195":83220,"_23354":138837,"_5":16137,"_30763":138749,"_3518":138838},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_4070":83262,"_34195":83220,"_23354":138840,"_5":16137,"_30763":138753,"_3518":138841},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_4070":83263,"_34195":83220,"_23354":138843,"_5":16137,"_30763":138753,"_3518":138844},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_4070":83264,"_34195":83220,"_23354":138846,"_5":16137,"_30763":138753,"_3518":138847},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_4070":83265,"_34195":83220,"_23354":138849,"_5":16137,"_30763":138753,"_3518":138850},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_4070":83266,"_34195":83220,"_23354":138852,"_5":16137,"_30763":138753,"_3518":138853},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_4070":83267,"_34195":83220,"_23354":138855,"_5":16137,"_30763":138753,"_3518":138856},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_4070":83268,"_34195":83220,"_23354":138858,"_5":16137,"_30763":138753,"_3518":138859},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_4070":83269,"_34195":83269,"_5":16540,"_3518":138861,"_34626":138862,"_23354":138863,"_30763":83269},"Autoridades de certificación",[56672,134827,62142,138702],[],{"_4070":83270,"_34195":83269,"_23354":138865,"_5":16137,"_30763":83269,"_3518":138866},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_4070":83271,"_34195":83269,"_5":34623,"_23354":138868,"_30763":138869,"_3518":138870},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_4070":83272,"_34195":83269,"_5":34623,"_23354":138872,"_30763":138873,"_3518":138874},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_4070":83273,"_34195":83269,"_5":34623,"_23354":138876,"_30763":138877,"_3518":133405},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#antes-de-empezar",{"_4070":83274,"_34195":83269,"_5":34623,"_23354":138879,"_30763":138880,"_3518":138881},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_4070":83275,"_34195":83269,"_5":34623,"_23354":138883,"_30763":138884,"_3518":138885},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_4070":83276,"_34195":83269,"_5":34623,"_23354":138887,"_30763":138888,"_3518":138889},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_4070":83277,"_34195":83269,"_5":34623,"_23354":138891,"_30763":138892,"_3518":138893},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_4070":83278,"_34195":83269,"_5":34623,"_23354":138895,"_30763":138896,"_3518":138897},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_4070":83279,"_34195":83269,"_5":34623,"_23354":138899,"_30763":138900,"_3518":138901},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_4070":83280,"_34195":83269,"_5":34623,"_23354":138903,"_30763":138904,"_3518":138905},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_4070":83281,"_34195":83269,"_5":34623,"_23354":138907,"_30763":138908,"_3518":138909},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_4070":83282,"_34195":83269,"_5":34623,"_23354":138911,"_30763":138912,"_3518":138913},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_4070":83283,"_34195":83269,"_5":34623,"_23354":138915,"_30763":138916,"_3518":138917},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_4070":83284,"_34195":83269,"_5":34623,"_23354":138919,"_30763":138920,"_3518":138921},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_4070":83285,"_34195":83269,"_5":34623,"_23354":138923,"_30763":138924,"_3518":138925},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_4070":83286,"_34195":83269,"_5":34623,"_23354":138927,"_30763":138928,"_3518":138929},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_4070":83287,"_34195":83269,"_5":34623,"_23354":138931,"_30763":138932,"_3518":138933},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_4070":83288,"_34195":83269,"_5":34623,"_23354":138935,"_30763":138936,"_3518":138937},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_4070":83289,"_34195":83269,"_5":34623,"_23354":138939,"_30763":138940,"_3518":138941},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_4070":83290,"_34195":83269,"_5":34623,"_23354":138943,"_30763":138944,"_3518":138945},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_4070":83291,"_34195":83269,"_5":34623,"_23354":138947,"_30763":138948,"_3518":138949},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_4070":83292,"_34195":83269,"_5":34623,"_23354":138951,"_30763":138952,"_3518":138953},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_4070":83293,"_34195":83269,"_5":34623,"_23354":138955,"_30763":138956,"_3518":138957},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_4070":83294,"_34195":83269,"_23354":138959,"_5":16137,"_30763":83269,"_3518":138960},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_4070":83295,"_34195":83269,"_23354":138962,"_5":16137,"_30763":83269,"_3518":138963},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_4070":83296,"_34195":83269,"_23354":138965,"_5":16137,"_30763":83269,"_3518":138966},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_4070":83297,"_34195":83269,"_23354":138968,"_5":16137,"_30763":138869,"_3518":138969},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_4070":83298,"_34195":83269,"_23354":138971,"_5":16137,"_30763":138869,"_3518":138972},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_4070":83299,"_34195":83269,"_23354":138974,"_5":16137,"_30763":138869,"_3518":138975},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_4070":83300,"_34195":83269,"_23354":138977,"_5":16137,"_30763":138869,"_3518":138978},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_4070":83301,"_34195":83269,"_23354":138980,"_5":16137,"_30763":138869,"_3518":138981},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_4070":83302,"_34195":83269,"_23354":138983,"_5":16137,"_30763":138877,"_3518":138984},[],"Decide si la CA será raíz o intermedia.",{"_4070":83303,"_34195":83269,"_23354":138986,"_5":16137,"_30763":138877,"_3518":138987},[],"Elige el motor que custodiará la clave.",{"_4070":83304,"_34195":83269,"_23354":138989,"_5":16137,"_30763":138877,"_3518":138990},[],"Define una validez superior a la de los certificados que emitirá.",{"_4070":83305,"_34195":83269,"_23354":138992,"_5":16137,"_30763":138877,"_3518":138993},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_4070":83306,"_34195":83269,"_23354":138995,"_5":16137,"_30763":138880,"_3518":138996},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_4070":83307,"_34195":83269,"_23354":138998,"_5":16137,"_30763":138884,"_3518":138999},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_4070":83308,"_34195":83269,"_23354":139001,"_5":16137,"_30763":138884,"_3518":139002},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_4070":83309,"_34195":83269,"_23354":139004,"_5":16137,"_30763":138888,"_3518":139005},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_4070":83310,"_34195":83269,"_23354":139007,"_5":16137,"_30763":138892,"_3518":139008},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_4070":83311,"_34195":83269,"_23354":139010,"_5":16137,"_30763":138892,"_3518":139011},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_4070":83312,"_34195":83269,"_23354":139013,"_5":16137,"_30763":138892,"_3518":139014},[],"`ST`: estado o provincia.",{"_4070":83313,"_34195":83269,"_23354":139016,"_5":16137,"_30763":138892,"_3518":139017},[],"`L`: localidad.",{"_4070":83314,"_34195":83269,"_23354":139019,"_5":16137,"_30763":138892,"_3518":139020},[],"`O`: organización.",{"_4070":83315,"_34195":83269,"_23354":139022,"_5":16137,"_30763":138892,"_3518":139023},[],"`OU`: unidad organizativa.",{"_4070":83316,"_34195":83269,"_23354":139025,"_5":16137,"_30763":138892,"_3518":139026},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_4070":83317,"_34195":83269,"_23354":139028,"_5":16137,"_30763":138896,"_3518":139029},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_4070":83318,"_34195":83269,"_23354":139031,"_5":16137,"_30763":138896,"_3518":139032},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_4070":83319,"_34195":83269,"_23354":139034,"_5":16137,"_30763":138900,"_3518":139035},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_4070":83320,"_34195":83269,"_23354":139037,"_5":16137,"_30763":138900,"_3518":139038},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_4070":83321,"_34195":83269,"_23354":139040,"_5":16137,"_30763":138904,"_3518":139041},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_4070":83322,"_34195":83269,"_23354":139043,"_5":16137,"_30763":138904,"_3518":139044},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_4070":83323,"_34195":83269,"_23354":139046,"_5":16137,"_30763":138908,"_3518":139047},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_4070":83324,"_34195":83269,"_23354":139049,"_5":16137,"_30763":138908,"_3518":139050},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_4070":83325,"_34195":83269,"_23354":139052,"_5":16137,"_30763":138908,"_3518":139053},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_4070":83326,"_34195":83269,"_23354":139055,"_5":16137,"_30763":138912,"_3518":139056},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_4070":83327,"_34195":83269,"_23354":139058,"_5":16137,"_30763":138916,"_3518":139059},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_4070":83328,"_34195":83269,"_23354":139061,"_5":16137,"_30763":138920,"_3518":139062},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_4070":83329,"_34195":83269,"_23354":139064,"_5":16137,"_30763":138924,"_3518":139065},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_4070":83330,"_34195":83269,"_23354":139067,"_5":16137,"_30763":138924,"_3518":139068},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_4070":83331,"_34195":83269,"_23354":139070,"_5":16137,"_30763":138928,"_3518":139071},[],"Abre una CA desde el inventario para consultar:",{"_4070":83332,"_34195":83269,"_23354":139073,"_5":16137,"_30763":138928,"_3518":139074},[],"Estado y periodo de validez.",{"_4070":83333,"_34195":83269,"_23354":139076,"_5":16137,"_30763":138928,"_3518":139077},[],"Certificado y cadena en formato PEM.",{"_4070":83334,"_34195":83269,"_23354":139079,"_5":16137,"_30763":138928,"_3518":139080},[],"Número de certificados activos, expirados y revocados.",{"_4070":83335,"_34195":83269,"_23354":139082,"_5":16137,"_30763":138928,"_3518":139083},[],"Certificados emitidos en **Issued Certificates**.",{"_4070":83336,"_34195":83269,"_23354":139085,"_5":16137,"_30763":138928,"_3518":139086},[],"CRL vinculada a la autoridad.",{"_4070":83337,"_34195":83269,"_23354":139088,"_5":16137,"_30763":138928,"_3518":139089},[],"Metadatos y motor criptográfico asociado.",{"_4070":83338,"_34195":83269,"_23354":139091,"_5":16137,"_30763":138928,"_3518":139092},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_4070":83339,"_34195":83269,"_23354":139094,"_5":16137,"_30763":138932,"_3518":139095},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_4070":83340,"_34195":83269,"_23354":139097,"_5":16137,"_30763":138932,"_3518":139098},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_4070":83341,"_34195":83269,"_23354":139100,"_5":16137,"_30763":138932,"_3518":139101},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_4070":83342,"_34195":83269,"_23354":139103,"_5":16137,"_30763":138932,"_3518":139104},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_4070":83343,"_34195":83269,"_23354":139106,"_5":16137,"_30763":138936,"_3518":139107},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_4070":83344,"_34195":83269,"_23354":139109,"_5":16137,"_30763":138940,"_3518":139110},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_4070":83345,"_34195":83269,"_23354":139112,"_5":16137,"_30763":138944,"_3518":139113},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_4070":83346,"_34195":83269,"_23354":139115,"_5":16137,"_30763":138948,"_3518":139116},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_4070":83347,"_34195":83269,"_23354":139118,"_5":16137,"_30763":138952,"_3518":139119},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_4070":83348,"_34195":83269,"_23354":139121,"_5":16137,"_30763":138956,"_3518":139122},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_4070":83349,"_34195":83269,"_23354":139124,"_5":16137,"_30763":138956,"_3518":139125},[],"El rol VA de la CA se conserva. Si no queda otra CA con el mismo SKI, deja de ser editable (consulta CRL), así que ajusta antes su validez y su firmante. La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_4070":83350,"_34195":83269,"_23354":139127,"_5":16137,"_30763":138956,"_3518":139128},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. Si el certificado nuevo usa la misma clave, comparte el SKI con el rol VA retenido de la CA eliminada, cuyo firmante es el certificado antiguo: comprueba que la CRL se genera y, si no es así, asigna con `PUT` un firmante de la CA nueva (consulta CRL).",{"_4070":83351,"_34195":83351,"_5":16540,"_3518":139130,"_34626":139131,"_23354":139132,"_30763":83351},"Perfiles de certificado",[56672,134827,62142,138702],[],{"_4070":83352,"_34195":83351,"_23354":139134,"_5":16137,"_30763":83351,"_3518":139135},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_4070":83353,"_34195":83351,"_5":34623,"_23354":139137,"_30763":139138,"_3518":139139},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_4070":83354,"_34195":83351,"_5":34623,"_23354":139141,"_30763":139142,"_3518":139143},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#validez","Validez",{"_4070":83355,"_34195":83351,"_5":34623,"_23354":139145,"_30763":139146,"_3518":139147},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_4070":83356,"_34195":83351,"_5":34623,"_23354":139149,"_30763":139150,"_3518":139151},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_4070":83357,"_34195":83351,"_5":34623,"_23354":139153,"_30763":139154,"_3518":139155},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_4070":83358,"_34195":83351,"_5":34623,"_23354":139157,"_30763":139158,"_3518":139159},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_4070":83359,"_34195":83351,"_5":34623,"_23354":139161,"_30763":139162,"_3518":139163},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_4070":83360,"_34195":83351,"_5":34623,"_23354":139165,"_30763":139166,"_3518":139167},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_4070":83361,"_34195":83351,"_5":34623,"_23354":139169,"_30763":139170,"_3518":139171},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_4070":83362,"_34195":83351,"_5":34623,"_23354":139173,"_30763":139174,"_3518":139175},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_4070":83363,"_34195":83351,"_5":34623,"_23354":139177,"_30763":139178,"_3518":139179},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_4070":83364,"_34195":83351,"_5":34623,"_23354":139181,"_30763":139182,"_3518":139183},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_4070":83365,"_34195":83351,"_5":34623,"_23354":139185,"_30763":139186,"_3518":139187},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_4070":83366,"_34195":83351,"_5":34623,"_23354":139189,"_30763":139190,"_3518":139191},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_4070":83367,"_34195":83351,"_5":34623,"_23354":139193,"_30763":139194,"_3518":139195},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_4070":83368,"_34195":83351,"_5":34623,"_23354":139197,"_30763":139198,"_3518":139199},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_4070":83369,"_34195":83351,"_23354":139201,"_5":16137,"_30763":83351,"_3518":139202},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_4070":83370,"_34195":83351,"_23354":139204,"_5":16137,"_30763":83351,"_3518":139205},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_4070":83371,"_34195":83351,"_23354":139207,"_5":16137,"_30763":139142,"_3518":139208},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_4070":83372,"_34195":83351,"_23354":139210,"_5":16137,"_30763":139142,"_3518":139211},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_4070":83373,"_34195":83351,"_23354":139213,"_5":16137,"_30763":139146,"_3518":139214},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_4070":83374,"_34195":83351,"_23354":139216,"_5":16137,"_30763":139150,"_3518":139217},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_4070":83375,"_34195":83351,"_23354":139219,"_5":16137,"_30763":139150,"_3518":139220},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_4070":83376,"_34195":83351,"_23354":139222,"_5":16137,"_30763":139150,"_3518":139223},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_4070":83377,"_34195":83351,"_23354":139225,"_5":16137,"_30763":139154,"_3518":139226},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_4070":83378,"_34195":83351,"_23354":139228,"_5":16137,"_30763":139158,"_3518":139229},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_4070":83379,"_34195":83351,"_23354":139231,"_5":16137,"_30763":139158,"_3518":139232},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_4070":83380,"_34195":83351,"_23354":139234,"_5":16137,"_30763":139162,"_3518":139235},[],"La aplicación criptográfica puede:",{"_4070":83381,"_34195":83351,"_23354":139237,"_5":16137,"_30763":139162,"_3518":139238},[],"permitir o bloquear claves RSA;",{"_4070":83382,"_34195":83351,"_23354":139240,"_5":16137,"_30763":139162,"_3518":139241},[],"limitar los tamaños RSA admitidos;",{"_4070":83383,"_34195":83351,"_23354":139243,"_5":16137,"_30763":139162,"_3518":139244},[],"permitir o bloquear claves ECDSA;",{"_4070":83384,"_34195":83351,"_23354":139246,"_5":16137,"_30763":139162,"_3518":139247},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_4070":83385,"_34195":83351,"_23354":139249,"_5":16137,"_30763":139162,"_3518":139250},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_4070":83386,"_34195":83351,"_23354":139252,"_5":16137,"_30763":139166,"_3518":139253},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_4070":83387,"_34195":83351,"_23354":139255,"_5":16137,"_30763":139166,"_3518":134587},[],{"_4070":83388,"_34195":83351,"_23354":139257,"_5":16137,"_30763":139166,"_3518":139258},[],"Primera opción",{"_4070":83389,"_34195":83351,"_23354":139260,"_5":16137,"_30763":139166,"_3518":139261},[],"Segunda opción",{"_4070":83390,"_34195":83351,"_23354":139263,"_5":16137,"_30763":139166,"_3518":139264},[],"Si no hay ninguna",{"_4070":83391,"_34195":83351,"_23354":139266,"_5":16137,"_30763":139166,"_3518":139267},[],"Firma directa con una CA",{"_4070":83392,"_34195":83351,"_23354":139269,"_5":16137,"_30763":139166,"_3518":139270},[],"`issuance_profile` incluido en la solicitud",{"_4070":83393,"_34195":83351,"_23354":139272,"_5":16137,"_30763":139166,"_3518":139273},[],"`issuance_profile_id` de la solicitud",{"_4070":83394,"_34195":83351,"_23354":139275,"_5":16137,"_30763":139166,"_3518":139276},[],"Perfil predeterminado de la CA (`profile_id`).",{"_4070":83395,"_34195":83351,"_23354":139278,"_5":16137,"_30763":139166,"_3518":139279},[],"Emisión mediante DMS",{"_4070":83396,"_34195":83351,"_23354":139281,"_5":16137,"_30763":139166,"_3518":62723},[],{"_4070":83397,"_34195":83351,"_23354":139283,"_5":16137,"_30763":139166,"_3518":139284},[],"`settings.issuance_profile` incluido en el DMS",{"_4070":83398,"_34195":83351,"_23354":139286,"_5":16137,"_30763":139166,"_3518":139287},[],"Perfil predeterminado de la CA de enrolamiento.",{"_4070":83399,"_34195":83351,"_23354":139289,"_5":16137,"_30763":139166,"_3518":139290},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_4070":83400,"_34195":83351,"_23354":139292,"_5":16137,"_30763":139166,"_3518":139293},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_4070":83401,"_34195":83351,"_23354":139295,"_5":16137,"_30763":139174,"_3518":139296},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_4070":83402,"_34195":83351,"_23354":139298,"_5":16137,"_30763":139178,"_3518":139299},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_4070":83403,"_34195":83351,"_23354":139301,"_5":16137,"_30763":139182,"_3518":139302},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_4070":83404,"_34195":83351,"_23354":139304,"_5":16137,"_30763":139186,"_3518":139305},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_4070":83405,"_34195":83351,"_23354":139307,"_5":16137,"_30763":139190,"_3518":139308},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_4070":83406,"_34195":83351,"_23354":139310,"_5":16137,"_30763":139190,"_3518":139311},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_4070":83407,"_34195":83351,"_23354":139313,"_5":16137,"_30763":139194,"_3518":139314},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_4070":83408,"_34195":83351,"_23354":139316,"_5":16137,"_30763":139194,"_3518":139317},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_4070":83409,"_34195":83351,"_23354":139319,"_5":16137,"_30763":139194,"_3518":139320},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_4070":83410,"_34195":83351,"_23354":139322,"_5":16137,"_30763":139194,"_3518":139323},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_4070":83411,"_34195":83351,"_23354":139325,"_5":16137,"_30763":139198,"_3518":139326},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_4070":83412,"_34195":83351,"_23354":139328,"_5":16137,"_30763":139198,"_3518":139329},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_4070":83413,"_34195":83413,"_5":16540,"_3518":139331,"_34626":139332,"_23354":139334,"_30763":83413},"Validación de certificados",[56672,134827,62142,139333],"Validación",[],{"_4070":83414,"_34195":83413,"_23354":139336,"_5":16137,"_30763":83413,"_3518":139337},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_4070":83415,"_34195":83413,"_5":34623,"_23354":139339,"_30763":139340,"_3518":139341},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_4070":83416,"_34195":83413,"_5":34623,"_23354":139343,"_30763":139344,"_3518":139345},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_4070":83417,"_34195":83413,"_5":34623,"_23354":139347,"_30763":139348,"_3518":139349},[],"/docs/pr-preview/pr-58/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_4070":83418,"_34195":83413,"_23354":139351,"_5":16137,"_30763":83413,"_3518":139352},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_4070":83419,"_34195":83413,"_23354":139354,"_5":16137,"_30763":139340,"_3518":139355},[],"Verifica estos criterios juntos:",{"_4070":83420,"_34195":83413,"_23354":139357,"_5":16137,"_30763":139340,"_3518":138331},[],{"_4070":83421,"_34195":83413,"_23354":139359,"_5":16137,"_30763":139340,"_3518":139360},[],"Resultado necesario",{"_4070":83422,"_34195":83413,"_23354":139362,"_5":16137,"_30763":139340,"_3518":139363},[],"Cadena y firma",{"_4070":83423,"_34195":83413,"_23354":139365,"_5":16137,"_30763":139340,"_3518":139366},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_4070":83424,"_34195":83413,"_23354":139368,"_5":16137,"_30763":139340,"_3518":139369},[],"Fechas",{"_4070":83425,"_34195":83413,"_23354":139371,"_5":16137,"_30763":139340,"_3518":139372},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_4070":83426,"_34195":83413,"_23354":139374,"_5":16137,"_30763":139340,"_3518":134497},[],{"_4070":83427,"_34195":83413,"_23354":139376,"_5":16137,"_30763":139340,"_3518":139377},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_4070":83428,"_34195":83413,"_23354":139379,"_5":16137,"_30763":139340,"_3518":139380},[],"Uso",{"_4070":83429,"_34195":83413,"_23354":139382,"_5":16137,"_30763":139340,"_3518":139383},[],"KU, EKU y restricciones permiten la operación concreta.",{"_4070":83430,"_34195":83413,"_23354":139385,"_5":16137,"_30763":139340,"_3518":139386},[],"Revocación",{"_4070":83431,"_34195":83413,"_23354":139388,"_5":16137,"_30763":139340,"_3518":139389},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_4070":83432,"_34195":83413,"_23354":139391,"_5":16137,"_30763":139340,"_3518":139392},[],"Autorización",{"_4070":83433,"_34195":83413,"_23354":139394,"_5":16137,"_30763":139340,"_3518":139395},[],"La aplicación permite la acción a esa identidad.",{"_4070":83434,"_34195":83413,"_23354":139397,"_5":16137,"_30763":139340,"_3518":139398},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_4070":83435,"_34195":83413,"_23354":139400,"_5":16137,"_30763":139344,"_3518":139401},[],"Mecanismo",{"_4070":83436,"_34195":83413,"_23354":139403,"_5":16137,"_30763":139344,"_3518":139404},[],"Cuándo utilizarlo",{"_4070":83437,"_34195":83413,"_23354":139406,"_5":16137,"_30763":139344,"_3518":139407},[],"Qué debes mantener",{"_4070":83438,"_34195":83413,"_23354":139409,"_5":16137,"_30763":139344,"_3518":62851},[],{"_4070":83439,"_34195":83413,"_23354":139411,"_5":16137,"_30763":139344,"_3518":139412},[],"Consulta del estado de un certificado concreto.",{"_4070":83440,"_34195":83413,"_23354":139414,"_5":16137,"_30763":139344,"_3518":139415},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_4070":83441,"_34195":83413,"_23354":139417,"_5":16137,"_30763":139344,"_3518":62860},[],{"_4070":83442,"_34195":83413,"_23354":139419,"_5":16137,"_30763":139344,"_3518":139420},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_4070":83443,"_34195":83413,"_23354":139422,"_5":16137,"_30763":139344,"_3518":139423},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_4070":83444,"_34195":83413,"_23354":139425,"_5":16137,"_30763":139344,"_3518":139426},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_4070":83445,"_34195":83413,"_23354":139428,"_5":16137,"_30763":139344,"_3518":139429},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_4070":83446,"_34195":83413,"_23354":139431,"_5":16137,"_30763":139348,"_3518":139432},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_4070":83447,"_34195":83413,"_23354":139434,"_5":16137,"_30763":139348,"_3518":139435},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_4070":83448,"_34195":83413,"_23354":139437,"_5":16137,"_30763":139348,"_3518":139438},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_4070":83449,"_34195":83413,"_23354":139440,"_5":16137,"_30763":139348,"_3518":139441},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_4070":83450,"_34195":83413,"_23354":139443,"_5":16137,"_30763":139348,"_3518":139444},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_4070":83451,"_34195":83413,"_23354":139446,"_5":16137,"_30763":139348,"_3518":139447},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_4070":83452,"_34195":83413,"_23354":139449,"_5":16137,"_30763":139348,"_3518":139450},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_4070":83453,"_34195":83413,"_23354":139452,"_5":16137,"_30763":139348,"_3518":139453},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_4070":83454,"_34195":83413,"_23354":139455,"_5":16137,"_30763":139348,"_3518":139456},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_4070":83455,"_34195":83455,"_5":16540,"_3518":139458,"_34626":139459,"_23354":139460,"_30763":83455},"Certificados",[56672,134827,62142,138702],[],{"_4070":83456,"_34195":83455,"_23354":139462,"_5":16137,"_30763":83455,"_3518":139463},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_4070":83457,"_34195":83455,"_5":34623,"_23354":139465,"_30763":139466,"_3518":139467},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_4070":83458,"_34195":83455,"_5":34623,"_23354":139469,"_30763":139470,"_3518":139471},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_4070":83459,"_34195":83455,"_5":34623,"_23354":139473,"_30763":139474,"_3518":139475},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_4070":83460,"_34195":83455,"_5":34623,"_23354":139477,"_30763":139478,"_3518":139479},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_4070":83461,"_34195":83455,"_5":34623,"_23354":139481,"_30763":139482,"_3518":139483},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_4070":83462,"_34195":83455,"_5":34623,"_23354":139485,"_30763":139486,"_3518":139487},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_4070":83463,"_34195":83455,"_5":34623,"_23354":139489,"_30763":139490,"_3518":139491},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_4070":83464,"_34195":83455,"_5":34623,"_23354":139493,"_30763":139494,"_3518":139495},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_4070":83465,"_34195":83455,"_5":34623,"_23354":139497,"_30763":139498,"_3518":139499},[],"/docs/pr-preview/pr-58/es/platform/pki/certificates#continúa","Continúa",{"_4070":83466,"_34195":83455,"_23354":139501,"_5":16137,"_30763":83455,"_3518":139502},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_4070":83467,"_34195":83455,"_23354":139504,"_5":16137,"_30763":139466,"_3518":139505},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_4070":83468,"_34195":83455,"_23354":139507,"_5":16137,"_30763":139466,"_3518":139508},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_4070":83469,"_34195":83455,"_23354":139510,"_5":16137,"_30763":139466,"_3518":139511},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_4070":83470,"_34195":83455,"_23354":139513,"_5":16137,"_30763":139466,"_3518":139514},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_4070":83471,"_34195":83455,"_23354":139516,"_5":16137,"_30763":139466,"_3518":139517},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_4070":83472,"_34195":83455,"_23354":139519,"_5":16137,"_30763":139466,"_3518":139520},[],"Los detalles del certificado incluyen la referencia a la clave (`key_id`) y si la clave privada está gestionada (`has_private_key`); las listas de certificados pueden filtrarse por `has_private_key`.",{"_4070":83473,"_34195":83455,"_23354":139522,"_5":16137,"_30763":139466,"_3518":139523},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_4070":83474,"_34195":83455,"_23354":139525,"_5":16137,"_30763":139470,"_3518":139526},[],"Descarga el PEM e inspecciónalo:",{"_4070":83475,"_34195":83455,"_23354":139528,"_5":16137,"_30763":139470,"_3518":139529},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_4070":83476,"_34195":83455,"_23354":139531,"_5":16137,"_30763":139474,"_3518":139532},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_4070":83477,"_34195":83455,"_23354":139534,"_5":16137,"_30763":139474,"_3518":139535},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_4070":83478,"_34195":83455,"_23354":139537,"_5":16137,"_30763":139474,"_3518":139538},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_4070":83479,"_34195":83455,"_23354":139540,"_5":16137,"_30763":139474,"_3518":139541},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_4070":83480,"_34195":83455,"_23354":139543,"_5":16137,"_30763":139474,"_3518":139544},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_4070":83481,"_34195":83455,"_23354":139546,"_5":16137,"_30763":139474,"_3518":139547},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_4070":83482,"_34195":83455,"_23354":139549,"_5":16137,"_30763":139474,"_3518":139550},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_4070":83483,"_34195":83455,"_23354":139552,"_5":16137,"_30763":139478,"_3518":139553},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_4070":83484,"_34195":83455,"_23354":139555,"_5":16137,"_30763":139482,"_3518":139556},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_4070":83485,"_34195":83455,"_23354":139558,"_5":16137,"_30763":139486,"_3518":139559},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_4070":83486,"_34195":83455,"_23354":139561,"_5":16137,"_30763":139490,"_3518":139562},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_4070":83487,"_34195":83455,"_23354":139564,"_5":16137,"_30763":139490,"_3518":139565},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_4070":83488,"_34195":83455,"_23354":139567,"_5":16137,"_30763":139490,"_3518":139568},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_4070":83489,"_34195":83455,"_23354":139570,"_5":16137,"_30763":139494,"_3518":139571},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_4070":83490,"_34195":83455,"_23354":139573,"_5":16137,"_30763":139494,"_3518":139574},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_4070":83491,"_34195":83455,"_23354":139576,"_5":16137,"_30763":139494,"_3518":139577},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_4070":83492,"_34195":83455,"_23354":139579,"_5":16137,"_30763":139498,"_3518":139580},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_4070":83493,"_34195":83455,"_23354":139582,"_5":16137,"_30763":139498,"_3518":139583},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_4070":83494,"_34195":83494,"_5":16540,"_3518":139585,"_34626":139586,"_23354":139588,"_30763":83494},"Ciclo de vida de un certificado",[56672,134827,62142,139587],"Conceptos",[],{"_4070":83495,"_34195":83494,"_23354":139590,"_5":16137,"_30763":83494,"_3518":139591},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_4070":83496,"_34195":83494,"_5":34623,"_23354":139593,"_30763":139594,"_3518":139595},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_4070":83497,"_34195":83494,"_5":34623,"_23354":139597,"_30763":139598,"_3518":139599},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_4070":83498,"_34195":83494,"_5":34623,"_23354":139601,"_30763":139602,"_3518":139603},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_4070":83499,"_34195":83494,"_5":34623,"_23354":139605,"_30763":139606,"_3518":139607},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_4070":83500,"_34195":83494,"_5":34623,"_23354":139609,"_30763":139610,"_3518":139611},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_4070":83501,"_34195":83494,"_5":34623,"_23354":139613,"_30763":139614,"_3518":139615},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_4070":83502,"_34195":83494,"_5":34623,"_23354":139617,"_30763":139618,"_3518":137325},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_4070":83503,"_34195":83494,"_5":34623,"_23354":139620,"_30763":139621,"_3518":139622},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_4070":83504,"_34195":83494,"_5":34623,"_23354":139624,"_30763":139625,"_3518":139626},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_4070":83505,"_34195":83494,"_5":34623,"_23354":139628,"_30763":139629,"_3518":139630},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_4070":83506,"_34195":83494,"_23354":139632,"_5":16137,"_30763":83494,"_3518":139633},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_4070":83507,"_34195":83494,"_23354":139635,"_5":16137,"_30763":139598,"_3518":139636},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_4070":83508,"_34195":83494,"_23354":139638,"_5":16137,"_30763":139602,"_3518":139639},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_4070":83509,"_34195":83494,"_23354":139641,"_5":16137,"_30763":139606,"_3518":139642},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_4070":83510,"_34195":83494,"_23354":139644,"_5":16137,"_30763":139610,"_3518":139645},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_4070":83511,"_34195":83494,"_23354":139647,"_5":16137,"_30763":139614,"_3518":139648},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_4070":83512,"_34195":83494,"_23354":139650,"_5":16137,"_30763":139618,"_3518":139651},[],"Lamassu persiste cuatro estados X.509:",{"_4070":83513,"_34195":83494,"_23354":139653,"_5":16137,"_30763":139618,"_3518":139654},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_4070":83514,"_34195":83494,"_23354":139656,"_5":16137,"_30763":139618,"_3518":139657},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_4070":83515,"_34195":83494,"_23354":139659,"_5":16137,"_30763":139618,"_3518":139660},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_4070":83516,"_34195":83494,"_23354":139662,"_5":16137,"_30763":139618,"_3518":139663},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_4070":83517,"_34195":83494,"_23354":139665,"_5":16137,"_30763":139618,"_3518":139666},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_4070":83518,"_34195":83494,"_23354":139668,"_5":16137,"_30763":139621,"_3518":139669},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_4070":83519,"_34195":83494,"_23354":139671,"_5":16137,"_30763":139621,"_3518":139672},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_4070":83520,"_34195":83494,"_23354":139674,"_5":16137,"_30763":139621,"_3518":139675},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_4070":83521,"_34195":83494,"_23354":139677,"_5":16137,"_30763":139625,"_3518":139678},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_4070":83522,"_34195":83494,"_23354":139680,"_5":16137,"_30763":139625,"_3518":139681},[],"Antes de confirmar:",{"_4070":83523,"_34195":83494,"_23354":139683,"_5":16137,"_30763":139625,"_3518":139684},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_4070":83524,"_34195":83494,"_23354":139686,"_5":16137,"_30763":139625,"_3518":139687},[],"Distribuye la nueva cadena de confianza.",{"_4070":83525,"_34195":83494,"_23354":139689,"_5":16137,"_30763":139625,"_3518":139690},[],"Reemite las identidades necesarias.",{"_4070":83526,"_34195":83494,"_23354":139692,"_5":16137,"_30763":139625,"_3518":139693},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_4070":83527,"_34195":83494,"_23354":139695,"_5":16137,"_30763":139625,"_3518":139696},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_4070":83528,"_34195":83494,"_23354":139698,"_5":16137,"_30763":139625,"_3518":139699},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_4070":83529,"_34195":83494,"_23354":139701,"_5":16137,"_30763":139629,"_3518":139702},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_4070":83530,"_34195":83494,"_23354":139704,"_5":16137,"_30763":139629,"_3518":139705},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_4070":83531,"_34195":83494,"_23354":139707,"_5":16137,"_30763":139629,"_3518":139708},[],"Cambios de estado y razones de revocación.",{"_4070":83532,"_34195":83494,"_23354":139710,"_5":16137,"_30763":139629,"_3518":139711},[],"Publicación y vigencia de OCSP y CRLs.",{"_4070":83533,"_34195":83494,"_23354":139713,"_5":16137,"_30763":139629,"_3518":139714},[],"Dependencias que todavía presentan un certificado sustituido.",{"_4070":83534,"_34195":83494,"_23354":139716,"_5":16137,"_30763":139629,"_3518":139717},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_4070":83535,"_34195":83535,"_5":16540,"_3518":139719,"_34626":139720,"_23354":139721,"_30763":83535},"Modelo de confianza",[56672,134827,62142,139587],[],{"_4070":83536,"_34195":83535,"_23354":139723,"_5":16137,"_30763":83535,"_3518":139724},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_4070":83537,"_34195":83535,"_5":34623,"_23354":139726,"_30763":139727,"_3518":139728},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_4070":83538,"_34195":83535,"_5":34623,"_23354":139730,"_30763":139731,"_3518":139732},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_4070":83539,"_34195":83535,"_5":34623,"_23354":139734,"_30763":139735,"_3518":139736},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_4070":83540,"_34195":83535,"_5":34623,"_23354":139738,"_30763":139739,"_3518":139740},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_4070":83541,"_34195":83535,"_5":34623,"_23354":139742,"_30763":139743,"_3518":139744},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_4070":83542,"_34195":83535,"_5":34623,"_23354":139746,"_30763":139747,"_3518":139748},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_4070":83543,"_34195":83535,"_5":34623,"_23354":139750,"_30763":139751,"_3518":139752},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_4070":83544,"_34195":83535,"_5":34623,"_23354":139754,"_30763":139755,"_3518":139756},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_4070":83545,"_34195":83535,"_5":34623,"_23354":139758,"_30763":139759,"_3518":139760},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_4070":83546,"_34195":83535,"_5":34623,"_23354":139762,"_30763":139763,"_3518":139764},[],"/docs/pr-preview/pr-58/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_4070":83547,"_34195":83535,"_23354":139766,"_5":16137,"_30763":83535,"_3518":139767},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_4070":83548,"_34195":83535,"_23354":139769,"_5":16137,"_30763":139731,"_3518":139770},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_4070":83549,"_34195":83535,"_23354":139772,"_5":16137,"_30763":139735,"_3518":139773},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_4070":83550,"_34195":83535,"_23354":139775,"_5":16137,"_30763":139739,"_3518":139776},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_4070":83551,"_34195":83535,"_23354":139778,"_5":16137,"_30763":139743,"_3518":139779},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_4070":83552,"_34195":83535,"_23354":139781,"_5":16137,"_30763":139747,"_3518":139782},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_4070":83553,"_34195":83535,"_23354":139784,"_5":16137,"_30763":139747,"_3518":139785},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_4070":83554,"_34195":83535,"_23354":139787,"_5":16137,"_30763":139747,"_3518":139788},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_4070":83555,"_34195":83535,"_23354":139790,"_5":16137,"_30763":139747,"_3518":139791},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_4070":83556,"_34195":83535,"_23354":139793,"_5":16137,"_30763":139747,"_3518":139794},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_4070":83557,"_34195":83535,"_23354":139796,"_5":16137,"_30763":139747,"_3518":139797},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_4070":83558,"_34195":83535,"_23354":139799,"_5":16137,"_30763":139751,"_3518":139800},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_4070":83559,"_34195":83535,"_23354":139802,"_5":16137,"_30763":139751,"_3518":139803},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_4070":83560,"_34195":83535,"_23354":139805,"_5":16137,"_30763":139751,"_3518":139806},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_4070":83561,"_34195":83535,"_23354":139808,"_5":16137,"_30763":139751,"_3518":139809},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_4070":83562,"_34195":83535,"_23354":139811,"_5":16137,"_30763":139751,"_3518":139812},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_4070":83563,"_34195":83535,"_23354":139814,"_5":16137,"_30763":139755,"_3518":139815},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_4070":83564,"_34195":83535,"_23354":139817,"_5":16137,"_30763":139755,"_3518":139818},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_4070":83565,"_34195":83535,"_23354":139820,"_5":16137,"_30763":139755,"_3518":139821},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_4070":83566,"_34195":83535,"_23354":139823,"_5":16137,"_30763":139755,"_3518":139824},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_4070":83567,"_34195":83535,"_23354":139826,"_5":16137,"_30763":139755,"_3518":139827},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_4070":83568,"_34195":83535,"_23354":139829,"_5":16137,"_30763":139755,"_3518":139830},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_4070":83569,"_34195":83535,"_23354":139832,"_5":16137,"_30763":139755,"_3518":139833},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_4070":83570,"_34195":83535,"_23354":139835,"_5":16137,"_30763":139759,"_3518":139836},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_4070":83571,"_34195":83535,"_23354":139838,"_5":16137,"_30763":139763,"_3518":139839},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_4070":83572,"_34195":83535,"_23354":139841,"_5":16137,"_30763":139763,"_3518":139842},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_4070":83573,"_34195":83535,"_23354":139844,"_5":16137,"_30763":139763,"_3518":139845},[],"Asigna perfiles explícitos a cada caso de uso.",{"_4070":83574,"_34195":83535,"_23354":139847,"_5":16137,"_30763":139763,"_3518":139848},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_4070":83575,"_34195":83535,"_23354":139850,"_5":16137,"_30763":139763,"_3518":139851},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_4070":83576,"_34195":83535,"_23354":139853,"_5":16137,"_30763":139763,"_3518":139854},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_4070":83577,"_34195":83535,"_23354":139856,"_5":16137,"_30763":139763,"_3518":139857},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_4070":83578,"_34195":83578,"_5":16540,"_3518":139859,"_34626":139860,"_23354":139861,"_30763":83578},"Listas de revocación (CRL)",[56672,134827,62142,139333],[],{"_4070":83579,"_34195":83578,"_23354":139863,"_5":16137,"_30763":83578,"_3518":139864},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_4070":83580,"_34195":83578,"_5":34623,"_23354":139866,"_30763":139867,"_3518":139868},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_4070":83581,"_34195":83578,"_5":34623,"_23354":139870,"_30763":139871,"_3518":139872},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_4070":83582,"_34195":83578,"_5":34623,"_23354":139874,"_30763":139875,"_3518":139876},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_4070":83583,"_34195":83578,"_5":34623,"_23354":139878,"_30763":139879,"_3518":139880},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_4070":83584,"_34195":83578,"_5":34623,"_23354":139882,"_30763":139883,"_3518":139884},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_4070":83585,"_34195":83578,"_5":34623,"_23354":139886,"_30763":139887,"_3518":139888},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_4070":83586,"_34195":83578,"_5":34623,"_23354":139890,"_30763":139891,"_3518":139892},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#errores-frecuentes-del-rol-va","Errores frecuentes del rol VA",{"_4070":83587,"_34195":83578,"_5":34623,"_23354":139894,"_30763":139895,"_3518":139896},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_4070":83588,"_34195":83578,"_5":34623,"_23354":139898,"_30763":139899,"_3518":139900},[],"/docs/pr-preview/pr-58/es/platform/pki/crl#referencias","Referencias",{"_4070":83589,"_34195":83578,"_23354":139902,"_5":16137,"_30763":83578,"_3518":139903},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_4070":83590,"_34195":83578,"_23354":139905,"_5":16137,"_30763":139867,"_3518":139906},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_4070":83591,"_34195":83578,"_23354":139908,"_5":16137,"_30763":139867,"_3518":139909},[],"Campo de `crl_options`",{"_4070":83592,"_34195":83578,"_23354":139911,"_5":16137,"_30763":139867,"_3518":136365},[],{"_4070":83593,"_34195":83578,"_23354":139913,"_5":16137,"_30763":139867,"_3518":139914},[],"Valor inicial del backend",{"_4070":83594,"_34195":83578,"_23354":139916,"_5":16137,"_30763":139867,"_3518":63361},[],{"_4070":83595,"_34195":83578,"_23354":139918,"_5":16137,"_30763":139867,"_3518":139919},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_4070":83596,"_34195":83578,"_23354":139921,"_5":16137,"_30763":139867,"_3518":139922},[],"7 días.",{"_4070":83597,"_34195":83578,"_23354":139924,"_5":16137,"_30763":139867,"_3518":63370},[],{"_4070":83598,"_34195":83578,"_23354":139926,"_5":16137,"_30763":139867,"_3518":139927},[],"Se guarda y se devuelve por la API, pero la VA no lo utiliza: la renovación programada no depende de él (consulta Regeneración periódica y automática).",{"_4070":83599,"_34195":83578,"_23354":139929,"_5":16137,"_30763":139867,"_3518":139930},[],"6 días y 23 horas.",{"_4070":83600,"_34195":83578,"_23354":139932,"_5":16137,"_30763":139867,"_3518":63379},[],{"_4070":83601,"_34195":83578,"_23354":139934,"_5":16137,"_30763":139867,"_3518":139935},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_4070":83602,"_34195":83578,"_23354":139937,"_5":16137,"_30763":139867,"_3518":63385},[],{"_4070":83603,"_34195":83578,"_23354":139939,"_5":16137,"_30763":139867,"_3518":63388},[],{"_4070":83604,"_34195":83578,"_23354":139941,"_5":16137,"_30763":139867,"_3518":139942},[],"Número de serie del certificado existente que firma la CRL.",{"_4070":83605,"_34195":83578,"_23354":139944,"_5":16137,"_30763":139867,"_3518":139945},[],"Número de serie del certificado actual de la CA.",{"_4070":83606,"_34195":83578,"_23354":139947,"_5":16137,"_30763":139867,"_3518":139948},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_4070":83607,"_34195":83578,"_23354":139950,"_5":16137,"_30763":139867,"_3518":139951},[],"Al reemitir una CA, el rol sigue apuntando al certificado anterior. Las CRL siguen siendo válidas porque ambos certificados comparten sujeto y clave, pero el certificado anterior no puede eliminarse mientras el rol lo use. Para retirarlo, actualiza el firmante del rol.",{"_4070":83608,"_34195":83578,"_23354":139953,"_5":16137,"_30763":139867,"_3518":139954},[],"Al eliminar una CA, su rol VA se conserva y no puede borrarse por API. Si no queda ninguna otra CA con el mismo SKI, el rol puede consultarse pero cualquier `PUT` devuelve 404, y el trabajo de renovación registra un aviso en cada ciclo porque ya no encuentra la CA. La API no ofrece salida; solo se corrige editando la base de datos. Si queda otra CA con ese SKI, el rol sigue siendo editable (consulta CAs que comparten clave). Ajusta validez y firmante antes de eliminar la CA.",{"_4070":83609,"_34195":83578,"_23354":139956,"_5":16137,"_30763":139867,"_3518":139957},[],"Una CA cuyo certificado no tiene `cRLSign` no puede generar su CRL ni editar su rol (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y asígnalo como firmante con `PUT`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original.",{"_4070":83610,"_34195":83578,"_23354":139959,"_5":16137,"_30763":139867,"_3518":139960},[],"El `PUT` valida siempre el firmante, aunque la petición no lo cambie. Si el firmante guardado ya no es válido, no se puede modificar ningún campo del rol, ni siquiera la validez, hasta asignar uno válido.",{"_4070":83611,"_34195":83578,"_23354":139962,"_5":16137,"_30763":139867,"_3518":139963},[],"Compartir una clave entre CA puede impedir la validación de las CRL. Consulta CAs que comparten clave.",{"_4070":83612,"_34195":83578,"_23354":139965,"_5":16137,"_30763":139867,"_3518":139966},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_4070":83613,"_34195":83578,"_23354":139968,"_5":16137,"_30763":139871,"_3518":139969},[],"La VA identifica cada CRL por el SKI de la CA, y el SKI se deriva de su clave. Dos CAs con la misma clave tienen el mismo SKI y comparten un único rol VA y una única CRL. Ocurre al crear una CA sobre una clave ya existente del KMS, o al importar una CA cuyo certificado declara un SKI en uso. Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. El rol lo crea la primera CA y las demás lo conservan.",{"_4070":83614,"_34195":83578,"_23354":139971,"_5":16137,"_30763":139871,"_3518":139972},[],"Los certificados de todas ellas apuntan a `/crl/{ski}`, pero la lista publicada tiene como emisor a la primera CA y solo incluye sus revocaciones. Un verificador compara el emisor de la CRL con el del certificado que valida (RFC 5280, §6.3.2) y rechaza la lista si no coinciden. Según su política, el certificado queda bloqueado (*hard-fail*) o se acepta aunque esté revocado (*soft-fail*). Las revocaciones de las CAs secundarias no aparecen en ninguna lista.",{"_4070":83615,"_34195":83578,"_23354":139974,"_5":16137,"_30763":139871,"_3518":139975},[],"Si la primera CA se elimina, la generación de CRL de la restante falla porque el firmante configurado ya no corresponde a una CA con ese nombre. Hasta que se actualice el firmante del rol a un certificado de la CA restante, se sigue sirviendo la última lista publicada hasta que venza (7 días por defecto).",{"_4070":83616,"_34195":83578,"_23354":139977,"_5":16137,"_30763":139871,"_3518":139978},[],"Antes de actualizar, revisa las CAs que comparten clave. Para detectar el problema, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos. Una CA importada con un SKI ya en uso no sustituye a la existente como emisora de la CRL, porque el emisor se resuelve a partir del firmante del rol. Sin embargo, sus propios certificados apuntan a esa misma URL y sus revocaciones no se publican. Hasta que Lamassu rechace estas importaciones, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión, así que tampoco reutilices claves entre CAs. Una CRL por CA y el rechazo de importaciones cuyo SKI colisiona con el de una CA existente están planteados en lamassuiot#834, y ninguno está implementado todavía.",{"_4070":83617,"_34195":83578,"_23354":139980,"_5":16137,"_30763":139875,"_3518":139981},[],"El trabajo programado de la VA revisa todos los roles en cada ejecución y solicita otra lista cuando a `latest_crl` le queda menos validez que el intervalo entre ejecuciones. La frecuencia se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. `refresh_interval` no interviene. Mantén `validity` claramente por encima del intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_4070":83618,"_34195":83578,"_23354":139983,"_5":16137,"_30763":139875,"_3518":139984},[],"Si la generación falla (por ejemplo, por un rol sin CA o un firmante inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ski>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_4070":83619,"_34195":83578,"_23354":139986,"_5":16137,"_30763":139875,"_3518":139987},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla (rol inexistente, firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_4070":83620,"_34195":83578,"_23354":139989,"_5":16137,"_30763":139875,"_3518":139990},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_4070":83621,"_34195":83578,"_23354":139992,"_5":16137,"_30763":139879,"_3518":139993},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_4070":83622,"_34195":83578,"_23354":139995,"_5":16137,"_30763":139879,"_3518":139996},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_4070":83623,"_34195":83578,"_23354":139998,"_5":16137,"_30763":139883,"_3518":139999},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_4070":83624,"_34195":83578,"_23354":140001,"_5":16137,"_30763":139883,"_3518":140002},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_4070":83625,"_34195":83578,"_23354":140004,"_5":16137,"_30763":139883,"_3518":140005},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando el rol apunta a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_4070":83626,"_34195":83578,"_23354":140007,"_5":16137,"_30763":139883,"_3518":140008},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_4070":83627,"_34195":83578,"_23354":140010,"_5":16137,"_30763":139883,"_3518":140011},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_4070":83628,"_34195":83578,"_23354":140013,"_5":16137,"_30763":139887,"_3518":140014},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_4070":83629,"_34195":83578,"_23354":140016,"_5":16137,"_30763":139887,"_3518":136554},[],{"_4070":83630,"_34195":83578,"_23354":140018,"_5":16137,"_30763":139887,"_3518":140019},[],"Path relativo",{"_4070":83631,"_34195":83578,"_23354":140021,"_5":16137,"_30763":139887,"_3518":134587},[],{"_4070":83632,"_34195":83578,"_23354":140023,"_5":16137,"_30763":139887,"_3518":63473},[],{"_4070":83633,"_34195":83578,"_23354":140025,"_5":16137,"_30763":139887,"_3518":63476},[],{"_4070":83634,"_34195":83578,"_23354":140027,"_5":16137,"_30763":139887,"_3518":140028},[],"Consultar `crl_options` y `latest_crl`.",{"_4070":83635,"_34195":83578,"_23354":140030,"_5":16137,"_30763":139887,"_3518":63482},[],{"_4070":83636,"_34195":83578,"_23354":140032,"_5":16137,"_30763":139887,"_3518":63476},[],{"_4070":83637,"_34195":83578,"_23354":140034,"_5":16137,"_30763":139887,"_3518":140035},[],"Sustituir la configuración de CRL.",{"_4070":83638,"_34195":83578,"_23354":140037,"_5":16137,"_30763":139887,"_3518":140038},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_4070":83639,"_34195":83578,"_23354":140040,"_5":16137,"_30763":139887,"_3518":140041},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_4070":83640,"_34195":83578,"_23354":140043,"_5":16137,"_30763":139891,"_3518":140044},[],"Síntoma",{"_4070":83641,"_34195":83578,"_23354":140046,"_5":16137,"_30763":139891,"_3518":140047},[],"Causa",{"_4070":83642,"_34195":83578,"_23354":140049,"_5":16137,"_30763":139891,"_3518":140050},[],"Acción",{"_4070":83643,"_34195":83578,"_23354":140052,"_5":16137,"_30763":139891,"_3518":140053},[],"`PUT /v1/roles/{ca-ski}` devuelve 404 y `GET` devuelve 200.",{"_4070":83644,"_34195":83578,"_23354":140055,"_5":16137,"_30763":139891,"_3518":140056},[],"Se eliminó la CA del rol y no queda otra con el mismo SKI.",{"_4070":83645,"_34195":83578,"_23354":140058,"_5":16137,"_30763":139891,"_3518":140059},[],"No hay salida por API; requiere intervención en la base de datos. Evítalo ajustando el rol antes de eliminar la CA.",{"_4070":83646,"_34195":83578,"_23354":140061,"_5":16137,"_30763":139891,"_3518":140062},[],"`PUT` devuelve 400.",{"_4070":83647,"_34195":83578,"_23354":140064,"_5":16137,"_30763":139891,"_3518":140065},[],"El firmante no tiene `cRLSign`, o su sujeto y su clave no coinciden con ninguna CA de ese SKI (por ejemplo, tras eliminar la primera de dos CAs que comparten clave).",{"_4070":83648,"_34195":83578,"_23354":140067,"_5":16137,"_30763":139891,"_3518":140068},[],"Asigna con `PUT` el número de serie de un certificado válido de la CA restante.",{"_4070":83649,"_34195":83578,"_23354":140070,"_5":16137,"_30763":139891,"_3518":140071},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_4070":83650,"_34195":83578,"_23354":140073,"_5":16137,"_30763":139891,"_3518":140074},[],"`crl_options.subject_key_id_signer` se sustituyó por `signer_certificate_serial_number`, que es obligatorio.",{"_4070":83651,"_34195":83578,"_23354":140076,"_5":16137,"_30763":139891,"_3518":140077},[],"Actualiza el cliente para enviar el campo nuevo.",{"_4070":83652,"_34195":83578,"_23354":140079,"_5":16137,"_30763":139891,"_3518":140080},[],"La CRL no cambia tras revocar un certificado.",{"_4070":83653,"_34195":83578,"_23354":140082,"_5":16137,"_30763":139891,"_3518":140083},[],"`regenerate_on_revoke` es `false`, o el evento falló por falta de rol o por un firmante inválido.",{"_4070":83654,"_34195":83578,"_23354":140085,"_5":16137,"_30763":139891,"_3518":140086},[],"Revisa los logs de la VA y la cola de eventos fallidos; corrige el firmante.",{"_4070":83655,"_34195":83578,"_23354":140088,"_5":16137,"_30763":139891,"_3518":140089},[],"Un verificador rechaza la CRL por el emisor.",{"_4070":83656,"_34195":83578,"_23354":140091,"_5":16137,"_30763":139891,"_3518":140092},[],"Varias CAs comparten SKI.",{"_4070":83657,"_34195":83578,"_23354":140094,"_5":16137,"_30763":139891,"_3518":140095},[],"Consulta CAs que comparten clave.",{"_4070":83658,"_34195":83578,"_23354":140097,"_5":16137,"_30763":139895,"_3518":140098},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Los ajustes VA de la CA también permiten seleccionar el firmante de la CRL: el selector de certificados solo ofrece certificados que tienen clave privada y el uso de clave `cRLSign`. Si el certificado de un firmante configurado no puede resolverse, la interfaz muestra `Unknown Certificate (Serial: X)` o `Certificate details unavailable (Serial: X)`. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_4070":83659,"_34195":83578,"_23354":140100,"_5":16137,"_30763":139899,"_3518":140101},[],"RFC 5280: perfil X.509 y CRL.",{"_4070":83660,"_34195":83578,"_23354":140103,"_5":16137,"_30763":139899,"_3518":63556},[],{"_4070":83661,"_34195":83578,"_23354":140105,"_5":16137,"_30763":139899,"_3518":63559},[],{"_4070":83662,"_34195":83578,"_23354":140107,"_5":16137,"_30763":139899,"_3518":140108},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_4070":83663,"_34195":83578,"_23354":140110,"_5":16137,"_30763":139899,"_3518":140111},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_4070":83664,"_34195":83664,"_5":16540,"_3518":140113,"_34626":140114,"_23354":140115,"_30763":83664},"Claves y motores criptográficos",[56672,134827,62142,138702],[],{"_4070":83665,"_34195":83664,"_23354":140117,"_5":16137,"_30763":83664,"_3518":140118},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_4070":83666,"_34195":83664,"_5":34623,"_23354":140120,"_30763":140121,"_3518":140122},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_4070":83667,"_34195":83664,"_5":34623,"_23354":140124,"_30763":140125,"_3518":140126},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_4070":83668,"_34195":83664,"_5":34623,"_23354":140128,"_30763":140129,"_3518":63584},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#file-system",{"_4070":83669,"_34195":83664,"_5":34623,"_23354":140131,"_30763":140132,"_3518":63588},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#hashicorp-vault",{"_4070":83670,"_34195":83664,"_5":34623,"_23354":140134,"_30763":140135,"_3518":63592},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#aws-secrets-manager",{"_4070":83671,"_34195":83664,"_5":34623,"_23354":140137,"_30763":140138,"_3518":63596},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#aws-kms",{"_4070":83672,"_34195":83664,"_5":34623,"_23354":140140,"_30763":140141,"_3518":63600},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#pkcs11",{"_4070":83673,"_34195":83664,"_5":34623,"_23354":140143,"_30763":140144,"_3518":63604},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#azure-key-vault",{"_4070":83674,"_34195":83664,"_5":34623,"_23354":140146,"_30763":140147,"_3518":140148},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_4070":83675,"_34195":83664,"_5":34623,"_23354":140150,"_30763":140151,"_3518":140152},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_4070":83676,"_34195":83664,"_5":34623,"_23354":140154,"_30763":140155,"_3518":140156},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_4070":83677,"_34195":83664,"_5":34623,"_23354":140158,"_30763":140159,"_3518":140160},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_4070":83678,"_34195":83664,"_5":34623,"_23354":140162,"_30763":140163,"_3518":140164},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_4070":83679,"_34195":83664,"_5":34623,"_23354":140166,"_30763":140167,"_3518":140168},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_4070":83680,"_34195":83664,"_5":34623,"_23354":140170,"_30763":140171,"_3518":140172},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_4070":83681,"_34195":83664,"_5":34623,"_23354":140174,"_30763":140175,"_3518":63636},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#sign",{"_4070":83682,"_34195":83664,"_5":34623,"_23354":140177,"_30763":140178,"_3518":63640},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#verify",{"_4070":83683,"_34195":83664,"_5":34623,"_23354":140180,"_30763":140181,"_3518":140182},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_4070":83684,"_34195":83664,"_5":34623,"_23354":140184,"_30763":140185,"_3518":140186},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_4070":83685,"_34195":83664,"_5":34623,"_23354":140188,"_30763":140189,"_3518":140190},[],"/docs/pr-preview/pr-58/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_4070":83686,"_34195":83664,"_23354":140192,"_5":16137,"_30763":83664,"_3518":140193},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_4070":83687,"_34195":83664,"_23354":140195,"_5":16137,"_30763":83664,"_3518":140196},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_4070":83688,"_34195":83664,"_23354":140198,"_5":16137,"_30763":140121,"_3518":140199},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_4070":83689,"_34195":83664,"_23354":140201,"_5":16137,"_30763":140121,"_3518":140202},[],"En la práctica, permite:",{"_4070":83690,"_34195":83664,"_23354":140204,"_5":16137,"_30763":140121,"_3518":140205},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_4070":83691,"_34195":83664,"_23354":140207,"_5":16137,"_30763":140121,"_3518":140208},[],"Importar claves creadas externamente.",{"_4070":83692,"_34195":83664,"_23354":140210,"_5":16137,"_30763":140121,"_3518":140211},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_4070":83693,"_34195":83664,"_23354":140213,"_5":16137,"_30763":140121,"_3518":140214},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_4070":83694,"_34195":83664,"_23354":140216,"_5":16137,"_30763":140125,"_3518":140217},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_4070":83695,"_34195":83664,"_23354":140219,"_5":16137,"_30763":140125,"_3518":140220},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_4070":83696,"_34195":83664,"_23354":140222,"_5":16137,"_30763":140125,"_3518":140223},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_4070":83697,"_34195":83664,"_23354":140225,"_5":16137,"_30763":140129,"_3518":140226},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_4070":83698,"_34195":83664,"_23354":140228,"_5":16137,"_30763":140132,"_3518":140229},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_4070":83699,"_34195":83664,"_23354":140231,"_5":16137,"_30763":140132,"_3518":140232},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_4070":83700,"_34195":83664,"_23354":140234,"_5":16137,"_30763":140135,"_3518":140235},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_4070":83701,"_34195":83664,"_23354":140237,"_5":16137,"_30763":140138,"_3518":140238},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_4070":83702,"_34195":83664,"_23354":140240,"_5":16137,"_30763":140141,"_3518":140241},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_4070":83703,"_34195":83664,"_23354":140243,"_5":16137,"_30763":140144,"_3518":140244},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_4070":83704,"_34195":83664,"_23354":140246,"_5":16137,"_30763":140144,"_3518":140247},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_4070":83705,"_34195":83664,"_23354":140249,"_5":16137,"_30763":140144,"_3518":140250},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_4070":83706,"_34195":83664,"_23354":140252,"_5":16137,"_30763":140144,"_3518":140253},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_4070":83707,"_34195":83664,"_23354":140255,"_5":16137,"_30763":140147,"_3518":140256},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_4070":83708,"_34195":83664,"_23354":140258,"_5":16137,"_30763":140147,"_3518":140259},[],"La tabla incluye los siguientes campos:",{"_4070":83709,"_34195":83664,"_23354":140261,"_5":16137,"_30763":140147,"_3518":140262},[],"**Name**: nombre descriptivo de la clave.",{"_4070":83710,"_34195":83664,"_23354":140264,"_5":16137,"_30763":140147,"_3518":140265},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_4070":83711,"_34195":83664,"_23354":140267,"_5":16137,"_30763":140147,"_3518":140268},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_4070":83712,"_34195":83664,"_23354":140270,"_5":16137,"_30763":140147,"_3518":140271},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_4070":83713,"_34195":83664,"_23354":140273,"_5":16137,"_30763":140147,"_3518":140274},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_4070":83714,"_34195":83664,"_23354":140276,"_5":16137,"_30763":140147,"_3518":140277},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_4070":83715,"_34195":83664,"_23354":140279,"_5":16137,"_30763":140147,"_3518":140280},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_4070":83716,"_34195":83664,"_23354":140282,"_5":16137,"_30763":140147,"_3518":140283},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_4070":83717,"_34195":83664,"_23354":140285,"_5":16137,"_30763":140147,"_3518":140286},[],"Desde esta vista también se accede a las acciones más habituales:",{"_4070":83718,"_34195":83664,"_23354":140288,"_5":16137,"_30763":140147,"_3518":140289},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_4070":83719,"_34195":83664,"_23354":140291,"_5":16137,"_30763":140147,"_3518":140292},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_4070":83720,"_34195":83664,"_23354":140294,"_5":16137,"_30763":140147,"_3518":140295},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_4070":83721,"_34195":83664,"_23354":140297,"_5":16137,"_30763":140147,"_3518":140298},[],"**Delete Key** para eliminar la clave del sistema.",{"_4070":83722,"_34195":83664,"_23354":140300,"_5":16137,"_30763":140151,"_3518":140301},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_4070":83723,"_34195":83664,"_23354":140303,"_5":16137,"_30763":140155,"_3518":140304},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_4070":83724,"_34195":83664,"_23354":140306,"_5":16137,"_30763":140155,"_3518":140307},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_4070":83725,"_34195":83664,"_23354":140309,"_5":16137,"_30763":140155,"_3518":140310},[],"**Key Name**: nombre único y descriptivo.",{"_4070":83726,"_34195":83664,"_23354":140312,"_5":16137,"_30763":140155,"_3518":140313},[],"**Crypto Engine**: motor que custodiará la clave.",{"_4070":83727,"_34195":83664,"_23354":140315,"_5":16137,"_30763":140155,"_3518":140316},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_4070":83728,"_34195":83664,"_23354":140318,"_5":16137,"_30763":140155,"_3518":140319},[],"**Tags**: metadatos para clasificar la clave.",{"_4070":83729,"_34195":83664,"_23354":140321,"_5":16137,"_30763":140155,"_3518":140322},[],"**Metadata**: información adicional para usos avanzados.",{"_4070":83730,"_34195":83664,"_23354":140324,"_5":16137,"_30763":140159,"_3518":140325},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_4070":83731,"_34195":83664,"_23354":140327,"_5":16137,"_30763":140159,"_3518":140328},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_4070":83732,"_34195":83664,"_23354":140330,"_5":16137,"_30763":140159,"_3518":140331},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_4070":83733,"_34195":83664,"_23354":140333,"_5":16137,"_30763":140159,"_3518":140334},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_4070":83734,"_34195":83664,"_23354":140336,"_5":16137,"_30763":140159,"_3518":140337},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_4070":83735,"_34195":83664,"_23354":140339,"_5":16137,"_30763":140159,"_3518":140340},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_4070":83736,"_34195":83664,"_23354":140342,"_5":16137,"_30763":140159,"_3518":140343},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_4070":83737,"_34195":83664,"_23354":140345,"_5":16137,"_30763":140159,"_3518":140346},[],"**Tags**: etiquetas para organización y búsqueda.",{"_4070":83738,"_34195":83664,"_23354":140348,"_5":16137,"_30763":140159,"_3518":140349},[],"**Metadata**: información adicional opcional.",{"_4070":83739,"_34195":83664,"_23354":140351,"_5":16137,"_30763":140159,"_3518":140352},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_4070":83740,"_34195":83664,"_23354":140354,"_5":16137,"_30763":140159,"_3518":140355},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_4070":83741,"_34195":83664,"_23354":140357,"_5":16137,"_30763":140163,"_3518":140358},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_4070":83742,"_34195":83664,"_23354":140360,"_5":16137,"_30763":140167,"_3518":140361},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_4070":83743,"_34195":83664,"_23354":140363,"_5":16137,"_30763":140167,"_3518":140364},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_4070":83744,"_34195":83664,"_23354":140366,"_5":16137,"_30763":140167,"_3518":140367},[],"**Key Name**: nombre descriptivo.",{"_4070":83745,"_34195":83664,"_23354":140369,"_5":16137,"_30763":140167,"_3518":140370},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_4070":83746,"_34195":83664,"_23354":140372,"_5":16137,"_30763":140167,"_3518":140373},[],"**Tags**: etiquetas asociadas.",{"_4070":83747,"_34195":83664,"_23354":140375,"_5":16137,"_30763":140167,"_3518":140376},[],"**Aliases**: nombres alternativos.",{"_4070":83748,"_34195":83664,"_23354":140378,"_5":16137,"_30763":140167,"_3518":140379},[],"**Crypto Engine**: motor en el que reside la clave.",{"_4070":83749,"_34195":83664,"_23354":140381,"_5":16137,"_30763":140167,"_3518":140382},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_4070":83750,"_34195":83664,"_23354":140384,"_5":16137,"_30763":140167,"_3518":140385},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_4070":83751,"_34195":83664,"_23354":140387,"_5":16137,"_30763":140167,"_3518":140388},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_4070":83752,"_34195":83664,"_23354":140390,"_5":16137,"_30763":140171,"_3518":140391},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_4070":83753,"_34195":83664,"_23354":140393,"_5":16137,"_30763":140171,"_3518":140394},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_4070":83754,"_34195":83664,"_23354":140396,"_5":16137,"_30763":140171,"_3518":140397},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_4070":83755,"_34195":83664,"_23354":140399,"_5":16137,"_30763":140175,"_3518":140400},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_4070":83756,"_34195":83664,"_23354":140402,"_5":16137,"_30763":140175,"_3518":140403},[],"Campos principales:",{"_4070":83757,"_34195":83664,"_23354":140405,"_5":16137,"_30763":140175,"_3518":140406},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_4070":83758,"_34195":83664,"_23354":140408,"_5":16137,"_30763":140175,"_3518":140409},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_4070":83759,"_34195":83664,"_23354":140411,"_5":16137,"_30763":140175,"_3518":140412},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_4070":83760,"_34195":83664,"_23354":140414,"_5":16137,"_30763":140175,"_3518":140415},[],"**Message**: contenido que se va a firmar.",{"_4070":83761,"_34195":83664,"_23354":140417,"_5":16137,"_30763":140175,"_3518":140418},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_4070":83762,"_34195":83664,"_23354":140420,"_5":16137,"_30763":140178,"_3518":140421},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_4070":83763,"_34195":83664,"_23354":140423,"_5":16137,"_30763":140178,"_3518":140403},[],{"_4070":83764,"_34195":83664,"_23354":140425,"_5":16137,"_30763":140178,"_3518":140426},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_4070":83765,"_34195":83664,"_23354":140428,"_5":16137,"_30763":140178,"_3518":140429},[],"**Message Type**: `Raw` o `Digest`.",{"_4070":83766,"_34195":83664,"_23354":140431,"_5":16137,"_30763":140178,"_3518":140432},[],"**Payload Encoding**: codificación del mensaje.",{"_4070":83767,"_34195":83664,"_23354":140434,"_5":16137,"_30763":140178,"_3518":140435},[],"**Message**: mensaje original o hash.",{"_4070":83768,"_34195":83664,"_23354":140437,"_5":16137,"_30763":140178,"_3518":140438},[],"**Signature**: firma que se desea comprobar.",{"_4070":83769,"_34195":83664,"_23354":140440,"_5":16137,"_30763":140178,"_3518":140441},[],"**Result**: indicador del resultado de la validación.",{"_4070":83770,"_34195":83664,"_23354":140443,"_5":16137,"_30763":140181,"_3518":140444},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_4070":83771,"_34195":83664,"_23354":140446,"_5":16137,"_30763":140181,"_3518":140447},[],"Este flujo es útil para:",{"_4070":83772,"_34195":83664,"_23354":140449,"_5":16137,"_30763":140181,"_3518":140450},[],"Solicitar certificados a una CA externa.",{"_4070":83773,"_34195":83664,"_23354":140452,"_5":16137,"_30763":140181,"_3518":140453},[],"Renovar una identidad manteniendo la misma clave.",{"_4070":83774,"_34195":83664,"_23354":140455,"_5":16137,"_30763":140181,"_3518":140456},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_4070":83775,"_34195":83664,"_23354":140458,"_5":16137,"_30763":140181,"_3518":140459},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_4070":83776,"_34195":83664,"_23354":140461,"_5":16137,"_30763":140181,"_3518":140462},[],"**Organization (O)**: organización o empresa.",{"_4070":83777,"_34195":83664,"_23354":140464,"_5":16137,"_30763":140181,"_3518":140465},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_4070":83778,"_34195":83664,"_23354":140467,"_5":16137,"_30763":140181,"_3518":140468},[],"**Country (C)**: código de país de dos letras.",{"_4070":83779,"_34195":83664,"_23354":140470,"_5":16137,"_30763":140181,"_3518":140471},[],"**State / Province (ST)**: estado o provincia.",{"_4070":83780,"_34195":83664,"_23354":140473,"_5":16137,"_30763":140181,"_3518":140474},[],"**Locality (L)**: ciudad o localidad.",{"_4070":83781,"_34195":83664,"_23354":140476,"_5":16137,"_30763":140181,"_3518":140477},[],"**Email Address**: correo de contacto.",{"_4070":83782,"_34195":83664,"_23354":140479,"_5":16137,"_30763":140181,"_3518":140480},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_4070":83783,"_34195":83664,"_23354":140482,"_5":16137,"_30763":140181,"_3518":140483},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_4070":83784,"_34195":83664,"_23354":140485,"_5":16137,"_30763":140185,"_3518":140486},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_4070":83785,"_34195":83664,"_23354":140488,"_5":16137,"_30763":140185,"_3518":140489},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_4070":83786,"_34195":83664,"_23354":140491,"_5":16137,"_30763":140189,"_3518":140492},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_4070":83787,"_34195":83664,"_23354":140494,"_5":16137,"_30763":140189,"_3518":140495},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves. La guía de actualización describe las referencias heredadas que conserva la migración.",{"_4070":83788,"_34195":83788,"_5":16540,"_3518":140497,"_34626":140498,"_23354":140499,"_30763":83788},"Validación online con OCSP",[56672,134827,62142,139333],[],{"_4070":83789,"_34195":83788,"_23354":140501,"_5":16137,"_30763":83788,"_3518":140502},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_4070":83790,"_34195":83788,"_5":34623,"_23354":140504,"_30763":140505,"_3518":140506},[],"/docs/pr-preview/pr-58/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_4070":83791,"_34195":83788,"_5":34623,"_23354":140508,"_30763":140509,"_3518":140510},[],"/docs/pr-preview/pr-58/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_4070":83792,"_34195":83788,"_5":34623,"_23354":140512,"_30763":140513,"_3518":140514},[],"/docs/pr-preview/pr-58/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_4070":83793,"_34195":83788,"_5":34623,"_23354":140516,"_30763":140517,"_3518":140518},[],"/docs/pr-preview/pr-58/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_4070":83794,"_34195":83788,"_5":34623,"_23354":140520,"_30763":140521,"_3518":140522},[],"/docs/pr-preview/pr-58/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_4070":83795,"_34195":83788,"_5":34623,"_23354":140524,"_30763":140525,"_3518":139900},[],"/docs/pr-preview/pr-58/es/platform/pki/ocsp#referencias",{"_4070":83796,"_34195":83788,"_23354":140527,"_5":16137,"_30763":83788,"_3518":140528},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_4070":83797,"_34195":83788,"_23354":140530,"_5":16137,"_30763":140505,"_3518":140531},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_4070":83798,"_34195":83788,"_23354":140533,"_5":16137,"_30763":140505,"_3518":140534},[],"Estado del registro",{"_4070":83799,"_34195":83788,"_23354":140536,"_5":16137,"_30763":140505,"_3518":140537},[],"Respuesta firmada",{"_4070":83800,"_34195":83788,"_23354":140539,"_5":16137,"_30763":140505,"_3518":61279},[],{"_4070":83801,"_34195":83788,"_23354":140541,"_5":16137,"_30763":140505,"_3518":64004},[],{"_4070":83802,"_34195":83788,"_23354":140543,"_5":16137,"_30763":140505,"_3518":61296},[],{"_4070":83803,"_34195":83788,"_23354":140545,"_5":16137,"_30763":140505,"_3518":140546},[],"`Revoked`, con razón y fecha de revocación.",{"_4070":83804,"_34195":83788,"_23354":140548,"_5":16137,"_30763":140505,"_3518":140549},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_4070":83805,"_34195":83788,"_23354":140551,"_5":16137,"_30763":140505,"_3518":140552},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_4070":83806,"_34195":83788,"_23354":140554,"_5":16137,"_30763":140505,"_3518":140555},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_4070":83807,"_34195":83788,"_23354":140557,"_5":16137,"_30763":140505,"_3518":140558},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_4070":83808,"_34195":83788,"_23354":140560,"_5":16137,"_30763":140505,"_3518":140561},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_4070":83809,"_34195":83788,"_23354":140563,"_5":16137,"_30763":140509,"_3518":140564},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_4070":83810,"_34195":83788,"_23354":140566,"_5":16137,"_30763":140509,"_3518":140567},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_4070":83811,"_34195":83788,"_23354":140569,"_5":16137,"_30763":140513,"_3518":140570},[],"El servicio acepta:",{"_4070":83812,"_34195":83788,"_23354":140572,"_5":16137,"_30763":140513,"_3518":136554},[],{"_4070":83813,"_34195":83788,"_23354":140574,"_5":16137,"_30763":140513,"_3518":140575},[],"Ruta del servicio VA",{"_4070":83814,"_34195":83788,"_23354":140577,"_5":16137,"_30763":140513,"_3518":140578},[],"Formato",{"_4070":83815,"_34195":83788,"_23354":140580,"_5":16137,"_30763":140513,"_3518":64044},[],{"_4070":83816,"_34195":83788,"_23354":140582,"_5":16137,"_30763":140513,"_3518":64047},[],{"_4070":83817,"_34195":83788,"_23354":140584,"_5":16137,"_30763":140513,"_3518":140585},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_4070":83818,"_34195":83788,"_23354":140587,"_5":16137,"_30763":140513,"_3518":63473},[],{"_4070":83819,"_34195":83788,"_23354":140589,"_5":16137,"_30763":140513,"_3518":64055},[],{"_4070":83820,"_34195":83788,"_23354":140591,"_5":16137,"_30763":140513,"_3518":140592},[],"Solicitud DER codificada en Base64 URL con padding.",{"_4070":83821,"_34195":83788,"_23354":140594,"_5":16137,"_30763":140513,"_3518":140595},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_4070":83822,"_34195":83788,"_23354":140597,"_5":16137,"_30763":140517,"_3518":140598},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_4070":83823,"_34195":83788,"_23354":140600,"_5":16137,"_30763":140517,"_3518":140601},[],"Genera la solicitud:",{"_4070":83824,"_34195":83788,"_23354":140603,"_5":16137,"_30763":140517,"_3518":140604},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_4070":83825,"_34195":83788,"_23354":140606,"_5":16137,"_30763":140517,"_3518":140607},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_4070":83826,"_34195":83788,"_23354":140609,"_5":16137,"_30763":140517,"_3518":140610},[],"Verifica el DER recibido:",{"_4070":83827,"_34195":83788,"_23354":140612,"_5":16137,"_30763":140517,"_3518":140613},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_4070":83828,"_34195":83788,"_23354":140615,"_5":16137,"_30763":140521,"_3518":140616},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_4070":83829,"_34195":83788,"_23354":140618,"_5":16137,"_30763":140521,"_3518":140619},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_4070":83830,"_34195":83788,"_23354":140621,"_5":16137,"_30763":140525,"_3518":64088},[],{"_4070":83831,"_34195":83788,"_23354":140623,"_5":16137,"_30763":140525,"_3518":64091},[],{"_4070":83832,"_34195":83788,"_23354":140625,"_5":16137,"_30763":140525,"_3518":140626},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_4070":83833,"_34195":83788,"_23354":140628,"_5":16137,"_30763":140525,"_3518":140111},[],{"_4070":83834,"_34195":83834,"_5":16540,"_3518":62142,"_34626":140630,"_23354":140631,"_30763":83834},[56672,134827,62142],[],{"_4070":83835,"_34195":83834,"_23354":140633,"_5":16137,"_30763":83834,"_3518":140634},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_4070":83836,"_34195":83834,"_5":34623,"_23354":140636,"_30763":140637,"_3518":138028},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#empieza-aquí",{"_4070":83837,"_34195":83834,"_5":34623,"_23354":140639,"_30763":140640,"_3518":140641},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_4070":83838,"_34195":83834,"_5":34623,"_23354":140643,"_30763":140644,"_3518":138548},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#capacidades-principales",{"_4070":83839,"_34195":83834,"_5":34623,"_23354":140646,"_30763":140647,"_3518":138552},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_4070":83840,"_34195":83834,"_5":34623,"_23354":140649,"_30763":140650,"_3518":138556},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#protege-las-claves-criptográficas",{"_4070":83841,"_34195":83834,"_5":34623,"_23354":140652,"_30763":140653,"_3518":138560},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#emite-y-controla-certificados",{"_4070":83842,"_34195":83834,"_5":34623,"_23354":140655,"_30763":140656,"_3518":138568},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#publica-el-estado-de-validación",{"_4070":83843,"_34195":83834,"_5":34623,"_23354":140658,"_30763":140659,"_3518":140660},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_4070":83844,"_34195":83834,"_5":34623,"_23354":140662,"_30763":140663,"_3518":139499},[],"/docs/pr-preview/pr-58/es/platform/pki/overview#continúa",{"_4070":83845,"_34195":83834,"_23354":140665,"_5":16137,"_30763":83834,"_3518":140666},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_4070":83846,"_34195":83834,"_23354":140668,"_5":16137,"_30763":140637,"_3518":140669},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_4070":83847,"_34195":83834,"_23354":140671,"_5":16137,"_30763":140637,"_3518":140672},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_4070":83848,"_34195":83834,"_23354":140674,"_5":16137,"_30763":140640,"_3518":140675},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_4070":83849,"_34195":83834,"_23354":140677,"_5":16137,"_30763":140640,"_3518":140678},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_4070":83850,"_34195":83834,"_23354":140680,"_5":16137,"_30763":140640,"_3518":140681},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_4070":83851,"_34195":83834,"_23354":140683,"_5":16137,"_30763":140640,"_3518":140684},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_4070":83852,"_34195":83834,"_23354":140686,"_5":16137,"_30763":140640,"_3518":140687},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_4070":83853,"_34195":83834,"_23354":140689,"_5":16137,"_30763":140647,"_3518":140690},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_4070":83854,"_34195":83834,"_23354":140692,"_5":16137,"_30763":140650,"_3518":140693},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_4070":83855,"_34195":83834,"_23354":140695,"_5":16137,"_30763":140653,"_3518":140696},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_4070":83856,"_34195":83834,"_23354":140698,"_5":16137,"_30763":140656,"_3518":140699},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_4070":83857,"_34195":83834,"_23354":140701,"_5":16137,"_30763":140659,"_3518":140702},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_4070":83858,"_34195":83834,"_23354":140704,"_5":16137,"_30763":140659,"_3518":140705},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_4070":83859,"_34195":83834,"_23354":140707,"_5":16137,"_30763":140659,"_3518":140708},[],"su clave pública corresponda a la clave privada del cliente;",{"_4070":83860,"_34195":83834,"_23354":140710,"_5":16137,"_30763":140659,"_3518":140711},[],"su cadena alcance una raíz confiable para el consumidor;",{"_4070":83861,"_34195":83834,"_23354":140713,"_5":16137,"_30763":140659,"_3518":140714},[],"sus fechas y usos permitan la operación;",{"_4070":83862,"_34195":83834,"_23354":140716,"_5":16137,"_30763":140659,"_3518":140717},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_4070":83863,"_34195":83834,"_23354":140719,"_5":16137,"_30763":140659,"_3518":140720},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_4070":83864,"_34195":83834,"_23354":140722,"_5":16137,"_30763":140663,"_3518":140723},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_4070":83865,"_34195":83834,"_23354":140725,"_5":16137,"_30763":140663,"_3518":140726},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_4070":83866,"_34195":83834,"_23354":140728,"_5":16137,"_30763":140663,"_3518":140729},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_4070":83867,"_34195":83867,"_5":16540,"_3518":140731,"_34626":140732,"_23354":140733,"_30763":83867},"Crea tu primera CA",[56672,134827,62142,138152],[],{"_4070":83868,"_34195":83867,"_23354":140735,"_5":16137,"_30763":83867,"_3518":140736},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_4070":83869,"_34195":83867,"_5":34623,"_23354":140738,"_30763":140739,"_3518":133405},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_4070":83870,"_34195":83867,"_5":34623,"_23354":140741,"_30763":140742,"_3518":140743},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_4070":83871,"_34195":83867,"_5":34623,"_23354":140745,"_30763":140746,"_3518":140747},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_4070":83872,"_34195":83867,"_5":34623,"_23354":140749,"_30763":140750,"_3518":140751},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_4070":83873,"_34195":83867,"_5":34623,"_23354":140753,"_30763":140754,"_3518":140755},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_4070":83874,"_34195":83867,"_5":34623,"_23354":140757,"_30763":140758,"_3518":140759},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_4070":83875,"_34195":83867,"_5":34623,"_23354":140761,"_30763":140762,"_3518":140763},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_4070":83876,"_34195":83867,"_5":34623,"_23354":140765,"_30763":140766,"_3518":138399},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_4070":83877,"_34195":83867,"_5":34623,"_23354":140768,"_30763":140769,"_3518":133429},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_4070":83878,"_34195":83867,"_23354":140771,"_5":16137,"_30763":83867,"_3518":140772},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_4070":83879,"_34195":83867,"_23354":140774,"_5":16137,"_30763":140739,"_3518":140775},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_4070":83880,"_34195":83867,"_23354":140777,"_5":16137,"_30763":140739,"_3518":140778},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_4070":83881,"_34195":83867,"_23354":140780,"_5":16137,"_30763":140739,"_3518":140781},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_4070":83882,"_34195":83867,"_23354":140783,"_5":16137,"_30763":140739,"_3518":140784},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_4070":83883,"_34195":83867,"_23354":140786,"_5":16137,"_30763":140742,"_3518":140787},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_4070":83884,"_34195":83867,"_23354":140789,"_5":16137,"_30763":140742,"_3518":140790},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_4070":83885,"_34195":83867,"_23354":140792,"_5":16137,"_30763":140746,"_3518":140793},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_4070":83886,"_34195":83867,"_23354":140795,"_5":16137,"_30763":140746,"_3518":140796},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_4070":83887,"_34195":83867,"_23354":140798,"_5":16137,"_30763":140750,"_3518":140799},[],"Selecciona **Root CA** y completa:",{"_4070":83888,"_34195":83867,"_23354":140801,"_5":16137,"_30763":140750,"_3518":64270},[],{"_4070":83889,"_34195":83867,"_23354":140803,"_5":16137,"_30763":140750,"_3518":140804},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_4070":83890,"_34195":83867,"_23354":140806,"_5":16137,"_30763":140750,"_3518":140807},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_4070":83891,"_34195":83867,"_23354":140809,"_5":16137,"_30763":140750,"_3518":140810},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_4070":83892,"_34195":83867,"_23354":140812,"_5":16137,"_30763":140750,"_3518":140813},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_4070":83893,"_34195":83867,"_23354":140815,"_5":16137,"_30763":140754,"_3518":140816},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_4070":83894,"_34195":83867,"_23354":140818,"_5":16137,"_30763":140758,"_3518":140819},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_4070":83895,"_34195":83867,"_23354":140821,"_5":16137,"_30763":140758,"_3518":140822},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_4070":83896,"_34195":83867,"_23354":140824,"_5":16137,"_30763":140762,"_3518":140825},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_4070":83897,"_34195":83867,"_23354":140827,"_5":16137,"_30763":140762,"_3518":140828},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_4070":83898,"_34195":83867,"_23354":140830,"_5":16137,"_30763":140762,"_3518":140831},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_4070":83899,"_34195":83867,"_23354":140833,"_5":16137,"_30763":140766,"_3518":140834},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_4070":83900,"_34195":83867,"_23354":140836,"_5":16137,"_30763":140766,"_3518":140837},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_4070":83901,"_34195":83867,"_23354":140839,"_5":16137,"_30763":140766,"_3518":140840},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_4070":83902,"_34195":83867,"_23354":140842,"_5":16137,"_30763":140766,"_3518":140843},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_4070":83903,"_34195":83867,"_23354":140845,"_5":16137,"_30763":140769,"_3518":140846},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_4070":83904,"_34195":83904,"_5":16540,"_3518":140848,"_34626":140849,"_23354":140850,"_30763":83904},"Emite y verifica un certificado",[56672,134827,62142,138152],[],{"_4070":83905,"_34195":83904,"_23354":140852,"_5":16137,"_30763":83904,"_3518":140853},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_4070":83906,"_34195":83904,"_5":34623,"_23354":140855,"_30763":140856,"_3518":133405},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_4070":83907,"_34195":83904,"_5":34623,"_23354":140858,"_30763":140859,"_3518":140860},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_4070":83908,"_34195":83904,"_5":34623,"_23354":140862,"_30763":140863,"_3518":140864},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_4070":83909,"_34195":83904,"_5":34623,"_23354":140866,"_30763":140867,"_3518":140868},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_4070":83910,"_34195":83904,"_5":34623,"_23354":140870,"_30763":140871,"_3518":140872},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_4070":83911,"_34195":83904,"_5":34623,"_23354":140874,"_30763":140875,"_3518":140876},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_4070":83912,"_34195":83904,"_5":34623,"_23354":140878,"_30763":140879,"_3518":140880},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_4070":83913,"_34195":83904,"_5":34623,"_23354":140882,"_30763":140883,"_3518":140884},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_4070":83914,"_34195":83904,"_5":34623,"_23354":140886,"_30763":140887,"_3518":140888},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_4070":83915,"_34195":83904,"_5":34623,"_23354":140890,"_30763":140891,"_3518":140892},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_4070":83916,"_34195":83904,"_5":34623,"_23354":140894,"_30763":140895,"_3518":138399},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_4070":83917,"_34195":83904,"_5":34623,"_23354":140897,"_30763":140898,"_3518":133429},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_4070":83918,"_34195":83904,"_23354":140900,"_5":16137,"_30763":83904,"_3518":140901},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_4070":83919,"_34195":83904,"_23354":140903,"_5":16137,"_30763":140856,"_3518":140904},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_4070":83920,"_34195":83904,"_23354":140906,"_5":16137,"_30763":140856,"_3518":140907},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_4070":83921,"_34195":83904,"_23354":140909,"_5":16137,"_30763":140856,"_3518":140910},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_4070":83922,"_34195":83904,"_23354":140912,"_5":16137,"_30763":140856,"_3518":140913},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_4070":83923,"_34195":83904,"_23354":140915,"_5":16137,"_30763":140856,"_3518":140916},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_4070":83924,"_34195":83904,"_23354":140918,"_5":16137,"_30763":140859,"_3518":140919},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_4070":83925,"_34195":83904,"_23354":140921,"_5":16137,"_30763":140863,"_3518":140922},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_4070":83926,"_34195":83904,"_23354":140924,"_5":16137,"_30763":140863,"_3518":140925},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_4070":83927,"_34195":83904,"_23354":140927,"_5":16137,"_30763":140867,"_3518":140928},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_4070":83928,"_34195":83904,"_23354":140930,"_5":16137,"_30763":140867,"_3518":140931},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_4070":83929,"_34195":83904,"_23354":140933,"_5":16137,"_30763":140871,"_3518":140934},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_4070":83930,"_34195":83904,"_23354":140936,"_5":16137,"_30763":140871,"_3518":140937},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_4070":83931,"_34195":83904,"_23354":140939,"_5":16137,"_30763":140875,"_3518":140940},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_4070":83932,"_34195":83904,"_23354":140942,"_5":16137,"_30763":140879,"_3518":140943},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_4070":83933,"_34195":83904,"_23354":140945,"_5":16137,"_30763":140883,"_3518":140946},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_4070":83934,"_34195":83904,"_23354":140948,"_5":16137,"_30763":140887,"_3518":140949},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_4070":83935,"_34195":83904,"_23354":140951,"_5":16137,"_30763":140887,"_3518":140952},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_4070":83936,"_34195":83904,"_23354":140954,"_5":16137,"_30763":140887,"_3518":140955},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_4070":83937,"_34195":83904,"_23354":140957,"_5":16137,"_30763":140891,"_3518":140958},[],"En Bash, compara los dos resúmenes de clave pública:",{"_4070":83938,"_34195":83904,"_23354":140960,"_5":16137,"_30763":140891,"_3518":140961},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_4070":83939,"_34195":83904,"_23354":140963,"_5":16137,"_30763":140891,"_3518":140964},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_4070":83940,"_34195":83904,"_23354":140966,"_5":16137,"_30763":140895,"_3518":138482},[],{"_4070":83941,"_34195":83904,"_23354":140968,"_5":16137,"_30763":140895,"_3518":137003},[],{"_4070":83942,"_34195":83904,"_23354":140970,"_5":16137,"_30763":140895,"_3518":140971},[],"La CA rechaza la emisión",{"_4070":83943,"_34195":83904,"_23354":140973,"_5":16137,"_30763":140895,"_3518":140974},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_4070":83944,"_34195":83904,"_23354":140976,"_5":16137,"_30763":140895,"_3518":140977},[],"Sujeto o usos diferentes",{"_4070":83945,"_34195":83904,"_23354":140979,"_5":16137,"_30763":140895,"_3518":140980},[],"Perfil aplicado y valores solicitados.",{"_4070":83946,"_34195":83904,"_23354":140982,"_5":16137,"_30763":140895,"_3518":140983},[],"No se encuentra el emisor",{"_4070":83947,"_34195":83904,"_23354":140985,"_5":16137,"_30763":140895,"_3518":140986},[],"CA descargada y cadena intermedia necesaria.",{"_4070":83948,"_34195":83904,"_23354":140988,"_5":16137,"_30763":140895,"_3518":140989},[],"Falla la vigencia",{"_4070":83949,"_34195":83904,"_23354":140991,"_5":16137,"_30763":140895,"_3518":140992},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_4070":83950,"_34195":83904,"_23354":140994,"_5":16137,"_30763":140895,"_3518":140995},[],"Los resúmenes de clave difieren",{"_4070":83951,"_34195":83904,"_23354":140997,"_5":16137,"_30763":140895,"_3518":140998},[],"Archivos de certificado y clave de la misma emisión.",{"_4070":83952,"_34195":83904,"_23354":141000,"_5":16137,"_30763":140895,"_3518":141001},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_4070":83953,"_34195":83904,"_23354":141003,"_5":16137,"_30763":140898,"_3518":141004},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_4070":83954,"_34195":83904,"_23354":141006,"_5":16137,"_30763":140898,"_3518":141007},[],"Gestionar certificados para inspección, estado y revocación.",{"_4070":83955,"_34195":83904,"_23354":141009,"_5":16137,"_30763":140898,"_3518":141010},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_4070":83956,"_34195":83904,"_23354":141012,"_5":16137,"_30763":140898,"_3518":141013},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_4070":83957,"_34195":83904,"_23354":141015,"_5":16137,"_30763":140898,"_3518":141016},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_4070":83958,"_34195":83958,"_5":16540,"_3518":141018,"_34626":141019,"_23354":141020,"_30763":83958},"Primeros pasos de PKI",[56672,134827,62142,138152],[],{"_4070":83959,"_34195":83958,"_23354":141022,"_5":16137,"_30763":83958,"_3518":141023},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_4070":83960,"_34195":83958,"_5":34623,"_23354":141025,"_30763":141026,"_3518":133405},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_4070":83961,"_34195":83958,"_5":34623,"_23354":141028,"_30763":141029,"_3518":141030},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_4070":83962,"_34195":83958,"_5":34623,"_23354":141032,"_30763":141033,"_3518":138334},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/overview#resultado-esperado",{"_4070":83963,"_34195":83958,"_5":34623,"_23354":141035,"_30763":141036,"_3518":141037},[],"/docs/pr-preview/pr-58/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_4070":83964,"_34195":83958,"_23354":141039,"_5":16137,"_30763":83958,"_3518":141040},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_4070":83965,"_34195":83958,"_23354":141042,"_5":16137,"_30763":141026,"_3518":141043},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_4070":83966,"_34195":83958,"_23354":141045,"_5":16137,"_30763":141026,"_3518":141046},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_4070":83967,"_34195":83958,"_23354":141048,"_5":16137,"_30763":141026,"_3518":141049},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_4070":83968,"_34195":83958,"_23354":141051,"_5":16137,"_30763":141026,"_3518":141052},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_4070":83969,"_34195":83958,"_23354":141054,"_5":16137,"_30763":141026,"_3518":141055},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_4070":83970,"_34195":83958,"_23354":141057,"_5":16137,"_30763":141029,"_3518":141058},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_4070":83971,"_34195":83958,"_23354":141060,"_5":16137,"_30763":141029,"_3518":141061},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_4070":83972,"_34195":83958,"_23354":141063,"_5":16137,"_30763":141029,"_3518":141064},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_4070":83973,"_34195":83958,"_23354":141066,"_5":16137,"_30763":141029,"_3518":141067},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_4070":83974,"_34195":83958,"_23354":141069,"_5":16137,"_30763":141033,"_3518":141070},[],"Archivo o recurso",{"_4070":83975,"_34195":83958,"_23354":141072,"_5":16137,"_30763":141033,"_3518":138331},[],{"_4070":83976,"_34195":83958,"_23354":141074,"_5":16137,"_30763":141033,"_3518":141075},[],"CA raíz activa y `ca.pem`",{"_4070":83977,"_34195":83958,"_23354":141077,"_5":16137,"_30763":141033,"_3518":141078},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_4070":83978,"_34195":83958,"_23354":141080,"_5":16137,"_30763":141033,"_3518":141081},[],"Certificado final y `device.crt`",{"_4070":83979,"_34195":83958,"_23354":141083,"_5":16137,"_30763":141033,"_3518":141084},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_4070":83980,"_34195":83958,"_23354":141086,"_5":16137,"_30763":141033,"_3518":141087},[],"Clave privada `device.key`",{"_4070":83981,"_34195":83958,"_23354":141089,"_5":16137,"_30763":141033,"_3518":141090},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_4070":83982,"_34195":83958,"_23354":141092,"_5":16137,"_30763":141033,"_3518":141093},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_4070":83983,"_34195":83958,"_23354":141095,"_5":16137,"_30763":141036,"_3518":141096},[],"Para operar certificados, continúa con Certificados y Validación.",{"_4070":83984,"_34195":83958,"_23354":141098,"_5":16137,"_30763":141036,"_3518":141099},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_4070":83985,"_34195":83958,"_23354":141101,"_5":16137,"_30763":141036,"_3518":141102},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_4070":83986,"_34195":83986,"_5":16540,"_3518":141104,"_34626":141105,"_23354":141107,"_30763":83986},"Resolución de problemas PKI",[56672,134827,62142,141106],"Resolución de problemas",[],{"_4070":83987,"_34195":83986,"_23354":141109,"_5":16137,"_30763":83986,"_3518":141110},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_4070":83988,"_34195":83986,"_5":34623,"_23354":141112,"_30763":141113,"_3518":141114},[],"/docs/pr-preview/pr-58/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_4070":83989,"_34195":83986,"_5":34623,"_23354":141116,"_30763":141117,"_3518":141118},[],"/docs/pr-preview/pr-58/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_4070":83990,"_34195":83986,"_5":34623,"_23354":141120,"_30763":141121,"_3518":141122},[],"/docs/pr-preview/pr-58/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_4070":83991,"_34195":83986,"_23354":141124,"_5":16137,"_30763":83986,"_3518":141125},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_4070":83992,"_34195":83986,"_23354":141127,"_5":16137,"_30763":83986,"_3518":141128},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_4070":83993,"_34195":83986,"_23354":141130,"_5":16137,"_30763":141113,"_3518":138331},[],{"_4070":83994,"_34195":83986,"_23354":141132,"_5":16137,"_30763":141113,"_3518":137003},[],{"_4070":83995,"_34195":83986,"_23354":141134,"_5":16137,"_30763":141113,"_3518":133429},[],{"_4070":83996,"_34195":83986,"_23354":141136,"_5":16137,"_30763":141113,"_3518":60984},[],{"_4070":83997,"_34195":83986,"_23354":141138,"_5":16137,"_30763":141113,"_3518":141139},[],"Existe, está activa y sus fechas son utilizables.",{"_4070":83998,"_34195":83986,"_23354":141141,"_5":16137,"_30763":141113,"_3518":141142},[],"Autoridades.",{"_4070":83999,"_34195":83986,"_23354":141144,"_5":16137,"_30763":141113,"_3518":141145},[],"Clave",{"_4070":84000,"_34195":83986,"_23354":141147,"_5":16137,"_30763":141113,"_3518":141148},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_4070":84001,"_34195":83986,"_23354":141150,"_5":16137,"_30763":141113,"_3518":141151},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_4070":84002,"_34195":83986,"_23354":141153,"_5":16137,"_30763":141113,"_3518":64624},[],{"_4070":84003,"_34195":83986,"_23354":141155,"_5":16137,"_30763":141113,"_3518":141156},[],"PEM correcto y firma verificable.",{"_4070":84004,"_34195":83986,"_23354":141158,"_5":16137,"_30763":141113,"_3518":64630},[],{"_4070":84005,"_34195":83986,"_23354":141160,"_5":16137,"_30763":141113,"_3518":141161},[],"Perfil",{"_4070":84006,"_34195":83986,"_23354":141163,"_5":16137,"_30763":141113,"_3518":141164},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_4070":84007,"_34195":83986,"_23354":141166,"_5":16137,"_30763":141113,"_3518":141167},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_4070":84008,"_34195":83986,"_23354":141169,"_5":16137,"_30763":141113,"_3518":138482},[],{"_4070":84009,"_34195":83986,"_23354":141171,"_5":16137,"_30763":141113,"_3518":141172},[],"Sujeto, SAN, usos y fechas adecuados.",{"_4070":84010,"_34195":83986,"_23354":141174,"_5":16137,"_30763":141113,"_3518":141175},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_4070":84011,"_34195":83986,"_23354":141177,"_5":16137,"_30763":141113,"_3518":141178},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_4070":84012,"_34195":83986,"_23354":141180,"_5":16137,"_30763":141113,"_3518":141181},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_4070":84013,"_34195":83986,"_23354":141183,"_5":16137,"_30763":141117,"_3518":141184},[],"Revisa cada frontera por separado:",{"_4070":84014,"_34195":83986,"_23354":141186,"_5":16137,"_30763":141117,"_3518":141187},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_4070":84015,"_34195":83986,"_23354":141189,"_5":16137,"_30763":141117,"_3518":141190},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_4070":84016,"_34195":83986,"_23354":141192,"_5":16137,"_30763":141117,"_3518":141193},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_4070":84017,"_34195":83986,"_23354":141195,"_5":16137,"_30763":141117,"_3518":141196},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_4070":84018,"_34195":83986,"_23354":141198,"_5":16137,"_30763":141117,"_3518":141199},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_4070":84019,"_34195":83986,"_23354":141201,"_5":16137,"_30763":141117,"_3518":141202},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_4070":84020,"_34195":83986,"_23354":141204,"_5":16137,"_30763":141121,"_3518":141205},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_4070":84021,"_34195":83986,"_23354":141207,"_5":16137,"_30763":141121,"_3518":141208},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_4070":84022,"_34195":84022,"_5":16540,"_3518":141210,"_34626":141211,"_23354":141214,"_30763":84022},"Algoritmos",[56672,134827,141212,141213],"[Beta] Poscuántica (PQC)","Algoritmos y toolchain",[],{"_4070":84023,"_34195":84022,"_23354":141216,"_5":16137,"_30763":84022,"_3518":141217},[],"Los algoritmos de firma poscuánticos y composite que soporta Lamassu, cómo se identifica cada uno en las peticiones a la API y los estándares que siguen.",{"_4070":84024,"_34195":84022,"_5":34623,"_23354":141219,"_30763":141220,"_3518":141221},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#cómo-se-selecciona-un-algoritmo","Cómo se selecciona un algoritmo",{"_4070":84025,"_34195":84022,"_5":34623,"_23354":141223,"_30763":141224,"_3518":64697},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#ml-dsa",{"_4070":84026,"_34195":84022,"_5":34623,"_23354":141226,"_30763":141227,"_3518":64701},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#slh-dsa",{"_4070":84027,"_34195":84022,"_5":34623,"_23354":141229,"_30763":141230,"_3518":141231},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#ml-dsa-composite","ML-DSA composite",{"_4070":84028,"_34195":84022,"_5":34623,"_23354":141233,"_30763":141234,"_3518":64709},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#ed25519",{"_4070":84029,"_34195":84022,"_5":34623,"_23354":141236,"_30763":141237,"_3518":141238},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#elegir-un-algoritmo","Elegir un algoritmo",{"_4070":84030,"_34195":84022,"_5":34623,"_23354":141240,"_30763":141241,"_3518":141242},[],"/docs/pr-preview/pr-58/es/platform/pqc/algorithms#qué-no-se-cubre","Qué no se cubre",{"_4070":84031,"_34195":84022,"_23354":141244,"_5":16137,"_30763":84022,"_3518":141245},[],"Lamassu soporta cuatro grupos de algoritmos de firma además de RSA y ECDSA: ML-DSA, SLH-DSA, ML-DSA composite y Ed25519. Todos proceden del toolchain de Go PQC; el backend solo selecciona el algoritmo y delega la criptografía.",{"_4070":84032,"_34195":84022,"_23354":141247,"_5":16137,"_30763":141220,"_3518":141248},[],"Una clave o una CA se crea con un tipo de clave y un tamaño. En RSA y ECDSA el tamaño es una longitud en bits o una curva. En los algoritmos poscuánticos el mismo campo transporta un **identificador de conjunto de parámetros**, no un número de bits:",{"_4070":84033,"_34195":84022,"_23354":141250,"_5":16137,"_30763":141220,"_3518":141251},[],"Tipo de clave (`algorithm` / `type`)",{"_4070":84034,"_34195":84022,"_23354":141253,"_5":16137,"_30763":141220,"_3518":141254},[],"Valor de `size` / `bits`",{"_4070":84035,"_34195":84022,"_23354":141256,"_5":16137,"_30763":141220,"_3518":141257},[],"Significado",{"_4070":84036,"_34195":84022,"_23354":141259,"_5":16137,"_30763":141220,"_3518":64734},[],{"_4070":84037,"_34195":84022,"_23354":141261,"_5":16137,"_30763":141220,"_3518":64737},[],{"_4070":84038,"_34195":84022,"_23354":141263,"_5":16137,"_30763":141220,"_3518":141264},[],"Longitud del módulo en bits.",{"_4070":84039,"_34195":84022,"_23354":141266,"_5":16137,"_30763":141220,"_3518":64743},[],{"_4070":84040,"_34195":84022,"_23354":141268,"_5":16137,"_30763":141220,"_3518":64746},[],{"_4070":84041,"_34195":84022,"_23354":141270,"_5":16137,"_30763":141220,"_3518":141271},[],"Tamaño de la curva en bits (P-256, P-384, P-521).",{"_4070":84042,"_34195":84022,"_23354":141273,"_5":16137,"_30763":141220,"_3518":64752},[],{"_4070":84043,"_34195":84022,"_23354":141275,"_5":16137,"_30763":141220,"_3518":11816},[],{"_4070":84044,"_34195":84022,"_23354":141277,"_5":16137,"_30763":141220,"_3518":141278},[],"Fijo. Cualquier otro valor se sustituye por 256.",{"_4070":84045,"_34195":84022,"_23354":141280,"_5":16137,"_30763":141220,"_3518":64760},[],{"_4070":84046,"_34195":84022,"_23354":141282,"_5":16137,"_30763":141220,"_3518":64763},[],{"_4070":84047,"_34195":84022,"_23354":141284,"_5":16137,"_30763":141220,"_3518":141285},[],"Conjunto de parámetros de ML-DSA.",{"_4070":84048,"_34195":84022,"_23354":141287,"_5":16137,"_30763":141220,"_3518":64769},[],{"_4070":84049,"_34195":84022,"_23354":141289,"_5":16137,"_30763":141220,"_3518":141290},[],"1 a 12",{"_4070":84050,"_34195":84022,"_23354":141292,"_5":16137,"_30763":141220,"_3518":141293},[],"Conjunto de parámetros de SLH-DSA, en el orden de la tabla siguiente.",{"_4070":84051,"_34195":84022,"_23354":141295,"_5":16137,"_30763":141220,"_3518":64778},[],{"_4070":84052,"_34195":84022,"_23354":141297,"_5":16137,"_30763":141220,"_3518":141298},[],"1 a 8",{"_4070":84053,"_34195":84022,"_23354":141300,"_5":16137,"_30763":141220,"_3518":141301},[],"Variante composite con componente RSA.",{"_4070":84054,"_34195":84022,"_23354":141303,"_5":16137,"_30763":141220,"_3518":64787},[],{"_4070":84055,"_34195":84022,"_23354":141305,"_5":16137,"_30763":141220,"_3518":141306},[],"9 a 13",{"_4070":84056,"_34195":84022,"_23354":141308,"_5":16137,"_30763":141220,"_3518":141309},[],"Variante composite con componente ECDSA.",{"_4070":84057,"_34195":84022,"_23354":141311,"_5":16137,"_30763":141220,"_3518":64796},[],{"_4070":84058,"_34195":84022,"_23354":141313,"_5":16137,"_30763":141220,"_3518":141314},[],"14 y 15",{"_4070":84059,"_34195":84022,"_23354":141316,"_5":16137,"_30763":141220,"_3518":141317},[],"Variante composite con componente Ed25519.",{"_4070":84060,"_34195":84022,"_23354":141319,"_5":16137,"_30763":141220,"_3518":141320},[],"Una cadena de tipo de clave desconocida no se rechaza al interpretarla: se convierte en un tipo desconocido y falla más tarde. Deben usarse exactamente las cadenas anteriores.",{"_4070":84061,"_34195":84022,"_23354":141322,"_5":16137,"_30763":141224,"_3518":141323},[],"ML-DSA es el esquema de firma basado en retículos estandarizado en FIPS 204. Lamassu acepta los tres conjuntos de parámetros ML-DSA-44, ML-DSA-65 y ML-DSA-87, que se seleccionan con `size` 44, 65 o 87. La implementación es el paquete `crypto/mldsa` de Go 1.27, es decir, el código de la propia biblioteca estándar y no del fork. En los certificados, los identificadores de algoritmo son `2.16.840.1.101.3.4.3.17`, `.18` y `.19` para ML-DSA-44, -65 y -87.",{"_4070":84062,"_34195":84022,"_23354":141325,"_5":16137,"_30763":141224,"_3518":141326},[],"Conjunto de parámetros",{"_4070":84063,"_34195":84022,"_23354":141328,"_5":16137,"_30763":141224,"_3518":141329},[],"Categoría de seguridad NIST",{"_4070":84064,"_34195":84022,"_23354":141331,"_5":16137,"_30763":141224,"_3518":64817},[],{"_4070":84065,"_34195":84022,"_23354":141333,"_5":16137,"_30763":141224,"_3518":11758},[],{"_4070":84066,"_34195":84022,"_23354":141335,"_5":16137,"_30763":141224,"_3518":64822},[],{"_4070":84067,"_34195":84022,"_23354":141337,"_5":16137,"_30763":141224,"_3518":11695},[],{"_4070":84068,"_34195":84022,"_23354":141339,"_5":16137,"_30763":141224,"_3518":64827},[],{"_4070":84069,"_34195":84022,"_23354":141341,"_5":16137,"_30763":141224,"_3518":11887},[],{"_4070":84070,"_34195":84022,"_23354":141343,"_5":16137,"_30763":141224,"_3518":141344},[],"Una categoría más alta implica claves y firmas más grandes a cambio de mayor margen de seguridad.",{"_4070":84071,"_34195":84022,"_23354":141346,"_5":16137,"_30763":141224,"_3518":141347},[],"Go solo lee claves privadas ML-DSA en PKCS#8 cuando contienen únicamente la semilla de 32 bytes. Las claves que OpenSSL escribe por defecto en la forma semilla más clave expandida se rechazan, por lo que deben exportarse en la forma de solo semilla antes de importarlas.",{"_4070":84072,"_34195":84022,"_23354":141349,"_5":16137,"_30763":141227,"_3518":141350},[],"SLH-DSA es el esquema basado en funciones hash de FIPS 205. Ofrece doce conjuntos de parámetros que combinan una familia de hash (SHA-2 o SHAKE), el parámetro n de 128, 192 o 256 bits, que corresponde a las categorías de seguridad 1, 3 y 5 del NIST y un compromiso entre tamaño de firma y velocidad de firma (`s` para firmas pequeñas, `f` para firma rápida). El identificador que se escribe en `size` sigue el orden de la biblioteca subyacente:",{"_4070":84073,"_34195":84022,"_23354":141352,"_5":16137,"_30763":141227,"_3518":64841},[],{"_4070":84074,"_34195":84022,"_23354":141354,"_5":16137,"_30763":141227,"_3518":141326},[],{"_4070":84075,"_34195":84022,"_23354":141356,"_5":16137,"_30763":141227,"_3518":64841},[],{"_4070":84076,"_34195":84022,"_23354":141358,"_5":16137,"_30763":141227,"_3518":141326},[],{"_4070":84077,"_34195":84022,"_23354":141360,"_5":16137,"_30763":141227,"_3518":11597},[],{"_4070":84078,"_34195":84022,"_23354":141362,"_5":16137,"_30763":141227,"_3518":64852},[],{"_4070":84079,"_34195":84022,"_23354":141364,"_5":16137,"_30763":141227,"_3518":11588},[],{"_4070":84080,"_34195":84022,"_23354":141366,"_5":16137,"_30763":141227,"_3518":64857},[],{"_4070":84081,"_34195":84022,"_23354":141368,"_5":16137,"_30763":141227,"_3518":11758},[],{"_4070":84082,"_34195":84022,"_23354":141370,"_5":16137,"_30763":141227,"_3518":64862},[],{"_4070":84083,"_34195":84022,"_23354":141372,"_5":16137,"_30763":141227,"_3518":11569},[],{"_4070":84084,"_34195":84022,"_23354":141374,"_5":16137,"_30763":141227,"_3518":64867},[],{"_4070":84085,"_34195":84022,"_23354":141376,"_5":16137,"_30763":141227,"_3518":11695},[],{"_4070":84086,"_34195":84022,"_23354":141378,"_5":16137,"_30763":141227,"_3518":64872},[],{"_4070":84087,"_34195":84022,"_23354":141380,"_5":16137,"_30763":141227,"_3518":29359},[],{"_4070":84088,"_34195":84022,"_23354":141382,"_5":16137,"_30763":141227,"_3518":64877},[],{"_4070":84089,"_34195":84022,"_23354":141384,"_5":16137,"_30763":141227,"_3518":11548},[],{"_4070":84090,"_34195":84022,"_23354":141386,"_5":16137,"_30763":141227,"_3518":64882},[],{"_4070":84091,"_34195":84022,"_23354":141388,"_5":16137,"_30763":141227,"_3518":33244},[],{"_4070":84092,"_34195":84022,"_23354":141390,"_5":16137,"_30763":141227,"_3518":64887},[],{"_4070":84093,"_34195":84022,"_23354":141392,"_5":16137,"_30763":141227,"_3518":11887},[],{"_4070":84094,"_34195":84022,"_23354":141394,"_5":16137,"_30763":141227,"_3518":64892},[],{"_4070":84095,"_34195":84022,"_23354":141396,"_5":16137,"_30763":141227,"_3518":33278},[],{"_4070":84096,"_34195":84022,"_23354":141398,"_5":16137,"_30763":141227,"_3518":64897},[],{"_4070":84097,"_34195":84022,"_23354":141400,"_5":16137,"_30763":141227,"_3518":11557},[],{"_4070":84098,"_34195":84022,"_23354":141402,"_5":16137,"_30763":141227,"_3518":64902},[],{"_4070":84099,"_34195":84022,"_23354":141404,"_5":16137,"_30763":141227,"_3518":32740},[],{"_4070":84100,"_34195":84022,"_23354":141406,"_5":16137,"_30763":141227,"_3518":64907},[],{"_4070":84101,"_34195":84022,"_23354":141408,"_5":16137,"_30763":141227,"_3518":141409},[],"La implementación de SLH-DSA procede de la biblioteca CIRCL de Cloudflare, que el fork integra para poder usar claves SLH-DSA en certificados X.509. Los identificadores de objeto van de `2.16.840.1.101.3.4.3.20` a `.31`. Las firmas SLH-DSA son grandes, de entre unos 8 y 50 KB según el conjunto de parámetros, lo que importa en las cadenas de certificados y en cualquier transporte con un límite de tamaño. SLH-DSA está disponible para claves, CA y certificados, pero el fork no tiene esquema de firma TLS para él, por lo que un certificado SLH-DSA no puede autenticar una conexión TLS.",{"_4070":84102,"_34195":84022,"_23354":141411,"_5":16137,"_30763":141230,"_3518":141412},[],"Una clave composite empareja una clave ML-DSA con una clave tradicional. Una firma composite es la concatenación de la firma ML-DSA y la firma tradicional, ambas calculadas sobre un mensaje representativo que contiene un prefijo fijo, una etiqueta de algoritmo, un contexto opcional y un hash del mensaje; la verificación falla si falla cualquiera de los componentes. El componente ML-DSA es ML-DSA puro, con la etiqueta como contexto. Lamassu implementa los 15 algoritmos del RFC 10073 que dependen solo de algoritmos disponibles en Go. Los identificadores cuelgan del arco `1.3.6.1.5.5.7.6`.",{"_4070":84103,"_34195":84022,"_23354":141414,"_5":16137,"_30763":141230,"_3518":64916},[],{"_4070":84104,"_34195":84022,"_23354":141416,"_5":16137,"_30763":141230,"_3518":141417},[],"Algoritmo",{"_4070":84105,"_34195":84022,"_23354":141419,"_5":16137,"_30763":141230,"_3518":141420},[],"Último dígito del OID",{"_4070":84106,"_34195":84022,"_23354":141422,"_5":16137,"_30763":141230,"_3518":141423},[],"Familia",{"_4070":84107,"_34195":84022,"_23354":141425,"_5":16137,"_30763":141230,"_3518":11597},[],{"_4070":84108,"_34195":84022,"_23354":141427,"_5":16137,"_30763":141230,"_3518":64930},[],{"_4070":84109,"_34195":84022,"_23354":141429,"_5":16137,"_30763":141230,"_3518":34069},[],{"_4070":84110,"_34195":84022,"_23354":141431,"_5":16137,"_30763":141230,"_3518":64935},[],{"_4070":84111,"_34195":84022,"_23354":141433,"_5":16137,"_30763":141230,"_3518":11758},[],{"_4070":84112,"_34195":84022,"_23354":141435,"_5":16137,"_30763":141230,"_3518":64940},[],{"_4070":84113,"_34195":84022,"_23354":141437,"_5":16137,"_30763":141230,"_3518":34042},[],{"_4070":84114,"_34195":84022,"_23354":141439,"_5":16137,"_30763":141230,"_3518":64935},[],{"_4070":84115,"_34195":84022,"_23354":141441,"_5":16137,"_30763":141230,"_3518":11695},[],{"_4070":84116,"_34195":84022,"_23354":141443,"_5":16137,"_30763":141230,"_3518":64949},[],{"_4070":84117,"_34195":84022,"_23354":141445,"_5":16137,"_30763":141230,"_3518":32857},[],{"_4070":84118,"_34195":84022,"_23354":141447,"_5":16137,"_30763":141230,"_3518":64935},[],{"_4070":84119,"_34195":84022,"_23354":141449,"_5":16137,"_30763":141230,"_3518":11548},[],{"_4070":84120,"_34195":84022,"_23354":141451,"_5":16137,"_30763":141230,"_3518":64958},[],{"_4070":84121,"_34195":84022,"_23354":141453,"_5":16137,"_30763":141230,"_3518":32863},[],{"_4070":84122,"_34195":84022,"_23354":141455,"_5":16137,"_30763":141230,"_3518":64935},[],{"_4070":84123,"_34195":84022,"_23354":141457,"_5":16137,"_30763":141230,"_3518":11887},[],{"_4070":84124,"_34195":84022,"_23354":141459,"_5":16137,"_30763":141230,"_3518":64967},[],{"_4070":84125,"_34195":84022,"_23354":141461,"_5":16137,"_30763":141230,"_3518":32869},[],{"_4070":84126,"_34195":84022,"_23354":141463,"_5":16137,"_30763":141230,"_3518":64935},[],{"_4070":84127,"_34195":84022,"_23354":141465,"_5":16137,"_30763":141230,"_3518":11557},[],{"_4070":84128,"_34195":84022,"_23354":141467,"_5":16137,"_30763":141230,"_3518":64976},[],{"_4070":84129,"_34195":84022,"_23354":141469,"_5":16137,"_30763":141230,"_3518":11551},[],{"_4070":84130,"_34195":84022,"_23354":141471,"_5":16137,"_30763":141230,"_3518":64935},[],{"_4070":84131,"_34195":84022,"_23354":141473,"_5":16137,"_30763":141230,"_3518":11588},[],{"_4070":84132,"_34195":84022,"_23354":141475,"_5":16137,"_30763":141230,"_3518":64985},[],{"_4070":84133,"_34195":84022,"_23354":141477,"_5":16137,"_30763":141230,"_3518":32745},[],{"_4070":84134,"_34195":84022,"_23354":141479,"_5":16137,"_30763":141230,"_3518":64935},[],{"_4070":84135,"_34195":84022,"_23354":141481,"_5":16137,"_30763":141230,"_3518":11569},[],{"_4070":84136,"_34195":84022,"_23354":141483,"_5":16137,"_30763":141230,"_3518":64994},[],{"_4070":84137,"_34195":84022,"_23354":141485,"_5":16137,"_30763":141230,"_3518":32767},[],{"_4070":84138,"_34195":84022,"_23354":141487,"_5":16137,"_30763":141230,"_3518":64935},[],{"_4070":84139,"_34195":84022,"_23354":141489,"_5":16137,"_30763":141230,"_3518":29359},[],{"_4070":84140,"_34195":84022,"_23354":141491,"_5":16137,"_30763":141230,"_3518":65003},[],{"_4070":84141,"_34195":84022,"_23354":141493,"_5":16137,"_30763":141230,"_3518":32809},[],{"_4070":84142,"_34195":84022,"_23354":141495,"_5":16137,"_30763":141230,"_3518":65008},[],{"_4070":84143,"_34195":84022,"_23354":141497,"_5":16137,"_30763":141230,"_3518":33244},[],{"_4070":84144,"_34195":84022,"_23354":141499,"_5":16137,"_30763":141230,"_3518":65013},[],{"_4070":84145,"_34195":84022,"_23354":141501,"_5":16137,"_30763":141230,"_3518":32875},[],{"_4070":84146,"_34195":84022,"_23354":141503,"_5":16137,"_30763":141230,"_3518":65008},[],{"_4070":84147,"_34195":84022,"_23354":141505,"_5":16137,"_30763":141230,"_3518":33278},[],{"_4070":84148,"_34195":84022,"_23354":141507,"_5":16137,"_30763":141230,"_3518":65022},[],{"_4070":84149,"_34195":84022,"_23354":141509,"_5":16137,"_30763":141230,"_3518":32881},[],{"_4070":84150,"_34195":84022,"_23354":141511,"_5":16137,"_30763":141230,"_3518":65008},[],{"_4070":84151,"_34195":84022,"_23354":141513,"_5":16137,"_30763":141230,"_3518":32740},[],{"_4070":84152,"_34195":84022,"_23354":141515,"_5":16137,"_30763":141230,"_3518":65031},[],{"_4070":84153,"_34195":84022,"_23354":141517,"_5":16137,"_30763":141230,"_3518":32887},[],{"_4070":84154,"_34195":84022,"_23354":141519,"_5":16137,"_30763":141230,"_3518":65008},[],{"_4070":84155,"_34195":84022,"_23354":141521,"_5":16137,"_30763":141230,"_3518":33344},[],{"_4070":84156,"_34195":84022,"_23354":141523,"_5":16137,"_30763":141230,"_3518":65040},[],{"_4070":84157,"_34195":84022,"_23354":141525,"_5":16137,"_30763":141230,"_3518":32773},[],{"_4070":84158,"_34195":84022,"_23354":141527,"_5":16137,"_30763":141230,"_3518":65008},[],{"_4070":84159,"_34195":84022,"_23354":141529,"_5":16137,"_30763":141230,"_3518":32927},[],{"_4070":84160,"_34195":84022,"_23354":141531,"_5":16137,"_30763":141230,"_3518":65049},[],{"_4070":84161,"_34195":84022,"_23354":141533,"_5":16137,"_30763":141230,"_3518":34075},[],{"_4070":84162,"_34195":84022,"_23354":141535,"_5":16137,"_30763":141230,"_3518":64709},[],{"_4070":84163,"_34195":84022,"_23354":141537,"_5":16137,"_30763":141230,"_3518":33350},[],{"_4070":84164,"_34195":84022,"_23354":141539,"_5":16137,"_30763":141230,"_3518":65058},[],{"_4070":84165,"_34195":84022,"_23354":141541,"_5":16137,"_30763":141230,"_3518":32851},[],{"_4070":84166,"_34195":84022,"_23354":141543,"_5":16137,"_30763":141230,"_3518":64709},[],{"_4070":84167,"_34195":84022,"_23354":141545,"_5":16137,"_30763":141230,"_3518":141546},[],"El tipo de clave debe coincidir con la familia de la variante: crear una clave `Composite-ML-DSA-ECDSA` con `size` 3 falla con un error que indica que la variante no es válida para ese tipo de clave.",{"_4070":84168,"_34195":84022,"_23354":141548,"_5":16137,"_30763":141230,"_3518":141549},[],"La implementación se escribió contra el borrador 19 de la especificación, que después se publicó como RFC 10073, y se ha contrastado con el texto publicado. Los identificadores de objeto, el prefijo de separación de dominio, el hash que usa cada componente ECDSA y la codificación RFC 5915 de las claves privadas ECDSA coinciden con el RFC. Tres algoritmos de la especificación no están implementados porque Go no dispone de curvas Brainpool ni de Ed448: las dos variantes Brainpool (`MLDSA65-ECDSA-brainpoolP256r1` y `MLDSA87-ECDSA-brainpoolP384r1`, con su sufijo de hash) y la variante Ed448. El fork supera los vectores de prueba del Apéndice E del RFC 10073 para los 15 algoritmos que sí implementa, con firmas con y sin contexto. Estas comprobaciones cubren los vectores y los puntos indicados arriba; no son una evaluación completa de conformidad.",{"_4070":84169,"_34195":84022,"_23354":141551,"_5":16137,"_30763":141230,"_3518":141552},[],"Los parámetros de las claves y de las firmas composite deben estar ausentes en el `AlgorithmIdentifier`; los certificados que los incluyen se rechazan. Los componentes ECDSA deben usar un escalar privado con la longitud exacta de la curva.",{"_4070":84170,"_34195":84022,"_23354":141554,"_5":16137,"_30763":141234,"_3518":141555},[],"Ed25519 no es poscuántico, pero el soporte como tipo de clave de CA y de certificado se añadió en el mismo trabajo y se selecciona con el tipo de clave `Ed25519`. Se clasifica en la familia tradicional.",{"_4070":84171,"_34195":84022,"_23354":141557,"_5":16137,"_30763":141237,"_3518":141558},[],"**ML-DSA composite** es la opción más conservadora durante la transición, porque la firma solo es válida si ambos componentes se verifican y así mantiene la protección clásica si se encuentra un fallo en el algoritmo nuevo. Las claves y firmas son mayores que las clásicas.",{"_4070":84172,"_34195":84022,"_23354":141560,"_5":16137,"_30763":141237,"_3518":141561},[],"**ML-DSA** por sí solo ofrece protección poscuántica con tamaños moderados y operaciones rápidas.",{"_4070":84173,"_34195":84022,"_23354":141563,"_5":16137,"_30763":141237,"_3518":141564},[],"**SLH-DSA** es adecuado para anclas de confianza de larga vida donde se valora depender solo de funciones hash. Las firmas son considerablemente mayores y no puede autenticar conexiones TLS.",{"_4070":84174,"_34195":84022,"_23354":141566,"_5":16137,"_30763":141237,"_3518":141567},[],"**Ed25519** no es poscuántico; úsalo solo donde un algoritmo clásico sea aceptable.",{"_4070":84175,"_34195":84022,"_23354":141569,"_5":16137,"_30763":141241,"_3518":141570},[],"Lamassu no implementa intercambio de claves poscuántico propio. Los intercambios de claves híbridos que ofrece el endpoint TLS, como `X25519MLKEM768`, son los de la biblioteca estándar de Go 1.27. Los diseños de certificados Chameleon y delta que se exploraron en iteraciones anteriores se eliminaron y no forman parte de la implementación.",{"_4070":84176,"_34195":84022,"_23354":141572,"_5":16137,"_30763":141241,"_3518":141573},[],"<Card title=\"Toolchain de Go PQC\" description=\"El fork que implementa estos algoritmos y la API que añade.\" href=\"/docs/platform/pqc/go-toolchain\" />",{"_4070":84177,"_34195":84022,"_23354":141575,"_5":16137,"_30763":141241,"_3518":141576},[],"<Card title=\"Claves y autoridades de certificación\" description=\"Usar estos parámetros en las peticiones al KMS y a la CA.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_4070":84178,"_34195":84178,"_5":16540,"_3518":65097,"_34626":141578,"_23354":141580,"_30763":84178},[56672,134827,141212,141579],"Soporte en la plataforma",[],{"_4070":84179,"_34195":84178,"_23354":141582,"_5":16137,"_30763":84178,"_3518":141583},[],"Cómo expone la interfaz web los algoritmos poscuánticos al crear claves, CA y certificados, y cómo los muestra.",{"_4070":84180,"_34195":84178,"_5":34623,"_23354":141585,"_30763":141586,"_3518":141587},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#elegir-tipo-de-clave-y-especificación","Elegir tipo de clave y especificación",{"_4070":84181,"_34195":84178,"_5":34623,"_23354":141589,"_30763":141590,"_3518":141591},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#emitir-un-certificado-con-una-clave-generada-en-el-navegador","Emitir un certificado con una clave generada en el navegador",{"_4070":84182,"_34195":84178,"_5":34623,"_23354":141593,"_30763":141594,"_3518":141595},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#cómo-se-muestran-los-objetos","Cómo se muestran los objetos",{"_4070":84183,"_34195":84178,"_5":34623,"_23354":141597,"_30763":141598,"_3518":141599},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#certificados-relacionados","Certificados relacionados",{"_4070":84184,"_34195":84178,"_5":34623,"_23354":141601,"_30763":141602,"_3518":141603},[],"/docs/pr-preview/pr-58/es/platform/pqc/dashboard#aspectos-a-tener-en-cuenta","Aspectos a tener en cuenta",{"_4070":84185,"_34195":84178,"_23354":141605,"_5":16137,"_30763":84178,"_3518":141606},[],"El dashboard (rama `feat/lamassu-q`) permite a un administrador crear e inspeccionar claves, autoridades de certificación y certificados poscuánticos sin escribir peticiones a la API. Añade las opciones de algoritmo, muestra la familia de algoritmo de cada objeto e interpreta los nuevos identificadores en los certificados. Todo lo que envía se describe en Claves y autoridades de certificación; esta página cubre lo que muestra la interfaz y dónde difiere su comportamiento entre pantallas.",{"_4070":84186,"_34195":84178,"_23354":141608,"_5":16137,"_30763":141586,"_3518":141609},[],"Crear una clave del KMS, una CA con una clave nueva y un certificado con clave generada en el servidor usan el mismo par de selectores. *Key type* está agrupado por familia y *Key specification* depende del tipo.",{"_4070":84187,"_34195":84178,"_23354":141611,"_5":16137,"_30763":141586,"_3518":141612},[],"Grupo",{"_4070":84188,"_34195":84178,"_23354":141614,"_5":16137,"_30763":141586,"_3518":141615},[],"Tipos de clave",{"_4070":84189,"_34195":84178,"_23354":141617,"_5":16137,"_30763":141586,"_3518":65138},[],{"_4070":84190,"_34195":84178,"_23354":141619,"_5":16137,"_30763":141586,"_3518":65141},[],{"_4070":84191,"_34195":84178,"_23354":141621,"_5":16137,"_30763":141586,"_3518":65144},[],{"_4070":84192,"_34195":84178,"_23354":141623,"_5":16137,"_30763":141586,"_3518":65147},[],{"_4070":84193,"_34195":84178,"_23354":141625,"_5":16137,"_30763":141586,"_3518":65150},[],{"_4070":84194,"_34195":84178,"_23354":141627,"_5":16137,"_30763":141586,"_3518":65153},[],{"_4070":84195,"_34195":84178,"_23354":141629,"_5":16137,"_30763":141586,"_3518":141630},[],"La lista de especificaciones muestra ML-DSA-44, -65 o -87, los doce conjuntos de parámetros de SLH-DSA (por ejemplo *4 - SHAKE\\_128f*) o las variantes composite por nombre. La interfaz envía como `size` el identificador del conjunto de parámetros, según se explica en Algoritmos, y muestra un indicador de fortaleza junto a cada opción. En las claves composite el indicador muestra dos barras, una para el componente clásico y otra para el poscuántico.",{"_4070":84196,"_34195":84178,"_23354":141632,"_5":16137,"_30763":141586,"_3518":141633},[],"Las opciones habilitadas dependen del motor criptográfico. Al crear una clave o una CA, la interfaz lista todos los algoritmos pero deshabilita los que el motor seleccionado no soporta, y pide seleccionar antes un motor. Al crear un certificado en el servidor, los tipos no soportados se ocultan en su lugar.",{"_4070":84197,"_34195":84178,"_23354":141635,"_5":16137,"_30763":141590,"_3518":141636},[],"Emitir un certificado desde una CA genera el par de claves en el navegador, construye la solicitud de certificado y la envía a la CA para su firma. Los tipos de clave que se ofrecen aquí son `RSA`, `ECDSA`, `Ed25519`, `ML-DSA`, `SLH-DSA` y una única entrada `Composite ML-DSA`, y se generan en el navegador: con las bibliotecas `@noble` para ML-DSA y SLH-DSA y con WebCrypto para los algoritmos clásicos.",{"_4070":84198,"_34195":84178,"_23354":141638,"_5":16137,"_30763":141590,"_3518":141639},[],"La generación de claves composite no está disponible en `@noble`. El equipo de Lamassu la ha implementado para el dashboard: combina la clave ML-DSA con una clave RSA, ECDSA o Ed25519 y firma el mensaje representativo composite tal como define la especificación, de modo que una solicitud de certificado composite puede crearse íntegramente en el navegador.",{"_4070":84199,"_34195":84178,"_23354":141641,"_5":16137,"_30763":141590,"_3518":141642},[],"La clave privada generada se muestra una sola vez al final del procedimiento.",{"_4070":84200,"_34195":84178,"_23354":141644,"_5":16137,"_30763":141590,"_3518":141645},[],"El navegador no verifica las firmas de las solicitudes ML-DSA, SLH-DSA, composite ni Ed25519; confía en el KMS.",{"_4070":84201,"_34195":84178,"_23354":141647,"_5":16137,"_30763":141594,"_3518":141648},[],"Las listas y las vistas de detalle muestran la familia del algoritmo. La tabla de CA tiene una columna *PQC* con T, PQ o PQ/T, las tarjetas de CA y el grafo de CA muestran una insignia *PQC*, las listas de claves muestran un icono cuántico, y el detalle de una CA o un certificado muestra el algoritmo, su fortaleza y la insignia de familia. La familia se calcula a partir del identificador de algoritmo del certificado interpretado.",{"_4070":84202,"_34195":84178,"_23354":141650,"_5":16137,"_30763":141594,"_3518":141651},[],"Los nombres de algoritmo se resuelven a partir de los identificadores de objeto. Los identificadores de ML-DSA, SLH-DSA, composite y Ed25519 se muestran como nombres con su conjunto de parámetros, por ejemplo *ML-DSA-65* o *Composite-Signature MLDSA65-ECDSA-P384-SHA512*, y para ellos no se muestra longitud en bits. Los algoritmos de firma RSA y ECDSA se muestran con etiquetas propias del dashboard, como *RSA PKCS#1 v1.5 SHA-256* y *ECDSA SHA-256*, en lugar de los nombres de OpenSSL `sha256WithRSAEncryption` y `ecdsa-with-SHA256`.",{"_4070":84203,"_34195":84178,"_23354":141653,"_5":16137,"_30763":141594,"_3518":141654},[],"La página de detalle de una clave puede firmar y verificar con una clave poscuántica y habilita únicamente el algoritmo de firma que le corresponde.",{"_4070":84204,"_34195":84178,"_23354":141656,"_5":16137,"_30763":141598,"_3518":141657},[],"El formulario del perfil de emisión, el formulario de emisión de certificados y las páginas de detalle incluyen los controles de certificados relacionados descritos en Certificados relacionados.",{"_4070":84205,"_34195":84178,"_23354":141659,"_5":16137,"_30763":141602,"_3518":141660},[],"Los nombres de los tipos de clave no son idénticos en todas las pantallas. La creación de claves y de CA usa `Composite-ML-DSA-RSA`, `-ECDSA` y `-Ed25519`; el formulario de emisión de certificados usa un único `Composite-ML-DSA`; y el formulario de certificado en el servidor compara nombres en mayúsculas. Los nombres que el backend informa para una clave pueden diferir, por tanto, en mayúsculas y minúsculas de lo que envía la interfaz.",{"_4070":84206,"_34195":84178,"_23354":141662,"_5":16137,"_30763":141602,"_3518":141663},[],"La interfaz no incluye ningún aviso de carácter experimental para estos algoritmos y no está traducida: todos los textos están en inglés.",{"_4070":84207,"_34195":84178,"_23354":141665,"_5":16137,"_30763":141602,"_3518":141666},[],"La correspondencia entre el identificador del conjunto de parámetros de SLH-DSA y el algoritmo que usa el generador de claves del navegador no sigue el mismo orden que los identificadores que muestra el selector y que usa el backend, salvo en el identificador 1. Un certificado emitido por el flujo del navegador con un identificador SLH-DSA del 2 al 12 puede usar, por tanto, un conjunto de parámetros distinto del que nombra el selector. Hasta que se corrija, conviene crear las claves SLH-DSA con el KMS.",{"_4070":84208,"_34195":84178,"_23354":141668,"_5":16137,"_30763":141602,"_3518":141669},[],"<Card title=\"Claves y autoridades de certificación\" description=\"La API que hay detrás de estas pantallas.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_4070":84209,"_34195":84178,"_23354":141671,"_5":16137,"_30763":141602,"_3518":141672},[],"<Card title=\"Limitaciones conocidas\" description=\"Carencias de la interfaz y de la plataforma.\" href=\"/docs/platform/pqc/limitations\" />",{"_4070":84210,"_34195":84210,"_5":16540,"_3518":141674,"_34626":141675,"_23354":141676,"_30763":84210},"Despliegue con el Helm chart",[56672,134827,141212,133396],[],{"_4070":84211,"_34195":84210,"_23354":141678,"_5":16137,"_30763":84210,"_3518":141679},[],"Desplegar Lamassu con un proxy frontal Traefik que sirve certificados clásicos, poscuánticos y composite, mediante los valores del chart o el instalador fast-lane.",{"_4070":84212,"_34195":84210,"_5":34623,"_23354":141681,"_30763":141682,"_3518":141683},[],"/docs/pr-preview/pr-58/es/platform/pqc/deployment#topología","Topología",{"_4070":84213,"_34195":84210,"_5":34623,"_23354":141685,"_30763":141686,"_3518":141687},[],"/docs/pr-preview/pr-58/es/platform/pqc/deployment#valores-del-chart","Valores del chart",{"_4070":84214,"_34195":84210,"_5":34623,"_23354":141689,"_30763":141690,"_3518":141691},[],"/docs/pr-preview/pr-58/es/platform/pqc/deployment#el-instalador-fast-lane","El instalador fast-lane",{"_4070":84215,"_34195":84210,"_23354":141693,"_5":16137,"_30763":84210,"_3518":141694},[],"La rama `pqc` del Helm chart de Lamassu añade un proxy frontal: una instancia de Traefik compilada con el toolchain de Go PQC que termina el TLS de los dispositivos, los autentica y reenvía el tráfico a Envoy Gateway. Esta página describe la topología resultante, los valores que la controlan y el instalador que automatiza un despliegue de laboratorio.",{"_4070":84216,"_34195":84210,"_23354":141696,"_5":16137,"_30763":84210,"_3518":141697},[],"El chart y el instalador asumen un clúster de desarrollo. La imagen del proxy usa una etiqueta mutable, los certificados PQC no se renuevan automáticamente y el salto entre Traefik y Envoy no verifica certificados. Esta configuración no debe usarse tal cual en producción.",{"_4070":84217,"_34195":84210,"_23354":141699,"_5":16137,"_30763":141682,"_3518":141700},[],"Traefik es el borde público. Negocia el intercambio de claves, sirve el certificado y, si se solicita, recibe el certificado del cliente. Después abre una segunda conexión TLS hacia el servicio `envoy-gateway-proxy` de Envoy Gateway, que presenta el certificado clásico autofirmado del chart; Traefik está configurado para aceptarlo sin verificarlo. Envoy no llega a ver, por tanto, un handshake poscuántico, y la protección poscuántica cubre solo la conexión entre el cliente y Traefik. Traefik y Envoy Gateway se instalan una sola vez por clúster y se comparten entre espacios de nombres, mientras que los recursos del proxy frontal (el Gateway, la ruta, el middleware, el certificado y el reference grant) pertenecen a la release de Lamassu.",{"_4070":84218,"_34195":84210,"_23354":141702,"_5":16137,"_30763":141682,"_3518":141703},[],"Cuando el cliente ha enviado un certificado, el middleware `inject-client-cert` del chart lo añade, en formato PEM, a la cabecera `X-Forwarded-Tls-Client-Cert`, y se establece la cabecera `X-Forwarded-Proto: https` en la petición.",{"_4070":84219,"_34195":84210,"_23354":141705,"_5":16137,"_30763":141686,"_3518":141706},[],"Todos los valores nuevos están bajo `traefikFrontProxy` y los valida el esquema del chart, que rechaza claves desconocidas.",{"_4070":84220,"_34195":84210,"_23354":141708,"_5":16137,"_30763":141686,"_3518":141709},[],"Nombre",{"_4070":84221,"_34195":84210,"_23354":141711,"_5":16137,"_30763":141686,"_3518":137441},[],{"_4070":84222,"_34195":84210,"_23354":141713,"_5":16137,"_30763":141686,"_3518":141714},[],"Valor por defecto",{"_4070":84223,"_34195":84210,"_23354":141716,"_5":16137,"_30763":141686,"_3518":137447},[],{"_4070":84224,"_34195":84210,"_23354":141718,"_5":16137,"_30763":141686,"_3518":65244},[],{"_4070":84225,"_34195":84210,"_23354":141720,"_5":16137,"_30763":141686,"_3518":113460},[],{"_4070":84226,"_34195":84210,"_23354":141722,"_5":16137,"_30763":141686,"_3518":65249},[],{"_4070":84227,"_34195":84210,"_23354":141724,"_5":16137,"_30763":141686,"_3518":141725},[],"Despliega los recursos del proxy frontal.",{"_4070":84228,"_34195":84210,"_23354":141727,"_5":16137,"_30763":141686,"_3518":65255},[],{"_4070":84229,"_34195":84210,"_23354":141729,"_5":16137,"_30763":141686,"_3518":105797},[],{"_4070":84230,"_34195":84210,"_23354":141731,"_5":16137,"_30763":141686,"_3518":65260},[],{"_4070":84231,"_34195":84210,"_23354":141733,"_5":16137,"_30763":141686,"_3518":141734},[],"Nombre del certificado de borde y nombre de host de la ruta. Debe indicarse cuando el proxy está habilitado.",{"_4070":84232,"_34195":84210,"_23354":141736,"_5":16137,"_30763":141686,"_3518":65266},[],{"_4070":84233,"_34195":84210,"_23354":141738,"_5":16137,"_30763":141686,"_3518":91431},[],{"_4070":84234,"_34195":84210,"_23354":141740,"_5":16137,"_30763":141686,"_3518":65271},[],{"_4070":84235,"_34195":84210,"_23354":141742,"_5":16137,"_30763":141686,"_3518":141743},[],"Puerto del listener HTTPS; debe coincidir con el entry point `websecure` de Traefik.",{"_4070":84236,"_34195":84210,"_23354":141745,"_5":16137,"_30763":141686,"_3518":65277},[],{"_4070":84237,"_34195":84210,"_23354":141747,"_5":16137,"_30763":141686,"_3518":105797},[],{"_4070":84238,"_34195":84210,"_23354":141749,"_5":16137,"_30763":141686,"_3518":65282},[],{"_4070":84239,"_34195":84210,"_23354":141751,"_5":16137,"_30763":141686,"_3518":141752},[],"Origen del certificado clásico: `certManager`, `external` o `none`.",{"_4070":84240,"_34195":84210,"_23354":141754,"_5":16137,"_30763":141686,"_3518":65288},[],{"_4070":84241,"_34195":84210,"_23354":141756,"_5":16137,"_30763":141686,"_3518":99079},[],{"_4070":84242,"_34195":84210,"_23354":141758,"_5":16137,"_30763":141686,"_3518":65293},[],{"_4070":84243,"_34195":84210,"_23354":141760,"_5":16137,"_30763":141686,"_3518":141761},[],"Direcciones IP añadidas al certificado autofirmado.",{"_4070":84244,"_34195":84210,"_23354":141763,"_5":16137,"_30763":141686,"_3518":65299},[],{"_4070":84245,"_34195":84210,"_23354":141765,"_5":16137,"_30763":141686,"_3518":105797},[],{"_4070":84246,"_34195":84210,"_23354":141767,"_5":16137,"_30763":141686,"_3518":65260},[],{"_4070":84247,"_34195":84210,"_23354":141769,"_5":16137,"_30763":141686,"_3518":141770},[],"Secret con `tls.crt` y `tls.key` cuando el tipo es `external`.",{"_4070":84248,"_34195":84210,"_23354":141772,"_5":16137,"_30763":141686,"_3518":65309},[],{"_4070":84249,"_34195":84210,"_23354":141774,"_5":16137,"_30763":141686,"_3518":99079},[],{"_4070":84250,"_34195":84210,"_23354":141776,"_5":16137,"_30763":141686,"_3518":65293},[],{"_4070":84251,"_34195":84210,"_23354":141778,"_5":16137,"_30763":141686,"_3518":141779},[],"Secrets TLS adicionales, por ejemplo certificados ML-DSA o composite, que se sirven en el mismo listener.",{"_4070":84252,"_34195":84210,"_23354":141781,"_5":16137,"_30763":141686,"_3518":141782},[],"Con `certManager`, el chart solicita un certificado ECDSA P-256 válido durante 2160 horas a su propio emisor autofirmado y lo guarda en el secret `edge-cert`. Con `none`, solo se sirven los secrets adicionales, y el chart se detiene con un error si no hay ninguno. El proxy elige entre todos los certificados según el cliente, tal como describe Proxy TLS con Traefik. Los nombres de los recursos que crea el chart son fijos, por lo que solo se admite una release por espacio de nombres.",{"_4070":84253,"_34195":84210,"_23354":141784,"_5":16137,"_30763":141686,"_3518":141785},[],"El chart modifica además el servicio de Envoy Gateway para que su puerto HTTPS declare `appProtocol: https`, algo que las versiones recientes de Traefik necesitan para hablar TLS con él. Cuando `gateway.addresses` está vacío, el servicio de Envoy es de tipo `ClusterIP` en lugar de un balanceador de carga.",{"_4070":84254,"_34195":84210,"_23354":141787,"_5":16137,"_30763":141686,"_3518":141788},[],"El chart no despliega Traefik, ni la GatewayClass `traefik`, ni la opción TLS `default` en el espacio de nombres `traefik-system`; los crea el instalador. Sin ellos, el borde no tiene intercambio de claves poscuántico ni solicitud de certificado de cliente. Tampoco fija las imágenes de los servicios de Lamassu: los valores por defecto son las imágenes de desarrollo, y el instalador sustituye las de la interfaz, CA, KMS, VA, device manager, DMS manager, alertas y autorización por las etiquetas `:pqc` de `ghcr.io/lamassuiot`.",{"_4070":84255,"_34195":84210,"_23354":141790,"_5":16137,"_30763":141690,"_3518":141791},[],"`scripts/lamassu-fast-lane.sh` instala todo en un clúster: las definiciones de recursos personalizados de Gateway API (versión 1.6.3, canal experimental), Envoy Gateway 1.8.0, el chart de Traefik 41.0.2 con la imagen PQC, la opción TLS, PostgreSQL, Keycloak, RabbitMQ, opcionalmente observabilidad y SoftHSM, y por último la release de Lamassu. Los dos parámetros relevantes aquí seleccionan qué algoritmos se ofrecen.",{"_4070":84256,"_34195":84210,"_23354":141793,"_5":16137,"_30763":141690,"_3518":141794},[],"Ambos parámetros aceptan una lista separada por comas de `T`, `PQ` y `PQ/T`, y ambos toman por defecto los tres valores. En el intercambio de claves, `PQ/T` es un grupo híbrido que combina un intercambio clásico y uno ML-KEM (`X25519MLKEM768`, `SecP256r1MLKEM768` y `SecP384r1MLKEM1024`) y `PQ` es ML-KEM puro (`MLKEM1024`); en la autenticación, `PQ/T` es un certificado composite. `--tls-kex` rellena los `curvePreferences` de la opción TLS, y `--tls-auth` selecciona qué certificados se sirven:",{"_4070":84257,"_34195":84210,"_23354":141796,"_5":16137,"_30763":141690,"_3518":141797},[],"Valor",{"_4070":84258,"_34195":84210,"_23354":141799,"_5":16137,"_30763":141690,"_3518":141800},[],"Grupos de intercambio de claves",{"_4070":84259,"_34195":84210,"_23354":141802,"_5":16137,"_30763":141690,"_3518":137627},[],{"_4070":84260,"_34195":84210,"_23354":141804,"_5":16137,"_30763":141690,"_3518":65342},[],{"_4070":84261,"_34195":84210,"_23354":141806,"_5":16137,"_30763":141690,"_3518":65345},[],{"_4070":84262,"_34195":84210,"_23354":141808,"_5":16137,"_30763":141690,"_3518":141809},[],"ECDSA P-256 de cert-manager, o los ficheros indicados con `--tls-crt` y `--tls-key`, en el secret `edge-cert`.",{"_4070":84263,"_34195":84210,"_23354":141811,"_5":16137,"_30763":141690,"_3518":65351},[],{"_4070":84264,"_34195":84210,"_23354":141813,"_5":16137,"_30763":141690,"_3518":65354},[],{"_4070":84265,"_34195":84210,"_23354":141815,"_5":16137,"_30763":141690,"_3518":141816},[],"ML-DSA-65, en el secret `edge-cert-pq`.",{"_4070":84266,"_34195":84210,"_23354":141818,"_5":16137,"_30763":141690,"_3518":65360},[],{"_4070":84267,"_34195":84210,"_23354":141820,"_5":16137,"_30763":141690,"_3518":65363},[],{"_4070":84268,"_34195":84210,"_23354":141822,"_5":16137,"_30763":141690,"_3518":141823},[],"Composite `MLDSA65-RSA3072-PSS-SHA512`, en el secret `edge-cert-pqt`.",{"_4070":84269,"_34195":84210,"_23354":141825,"_5":16137,"_30763":141690,"_3518":141826},[],"La versión mínima de TLS es 1.3, salvo que ambos parámetros sean solo `T`, en cuyo caso es 1.2. cert-manager no puede emitir certificados poscuánticos, por lo que el instalador crea los certificados PQ y PQ/T localmente con OpenSSL 3.5 o posterior; el certificado composite necesita además el módulo `hybrid-provider`, que el script compila bajo demanda con `git`, `cmake` y un compilador de C. Las claves privadas ML-DSA se escriben en la forma de solo semilla que Go acepta, y los secrets se crean a partir de un manifiesto porque `kubectl create secret tls` rechaza claves ML-DSA. Los certificados duran 365 días y se conservan si el secret ya existe.",{"_4070":84270,"_34195":84210,"_23354":141828,"_5":16137,"_30763":141690,"_3518":141829},[],"El script requiere `yq`, `kubectl` y `helm`, y `jq` con `--sample-data`. Al terminar imprime cómo extraer la CA en la que deben confiar los dispositivos, por ejemplo `kubectl get secret edge-cert-pq -o jsonpath='{.data.ca\\.crt}'`.",{"_4070":84271,"_34195":84210,"_23354":141831,"_5":16137,"_30763":141690,"_3518":141832},[],"Los scripts complementarios para un broker MQTT detrás de Traefik (`scripts/emqx`), para exportar claves del KMS y para restaurar una copia de seguridad están presentes en el árbol de trabajo del chart, pero sin confirmar en el repositorio. Son solo para uso en laboratorio y no se describen más aquí.",{"_4070":84272,"_34195":84210,"_23354":141834,"_5":16137,"_30763":141690,"_3518":141835},[],"<Card title=\"Proxy TLS con Traefik\" description=\"Cómo elige certificado el proxy y cómo se compila.\" href=\"/docs/platform/pqc/tls-front-proxy\" />",{"_4070":84273,"_34195":84210,"_23354":141837,"_5":16137,"_30763":141690,"_3518":141838},[],"<Card title=\"Limitaciones conocidas\" description=\"Advertencias del despliegue de laboratorio.\" href=\"/docs/platform/pqc/limitations\" />",{"_4070":84274,"_34195":84274,"_5":16540,"_3518":141840,"_34626":141841,"_23354":141842,"_30763":84274},"Toolchain de Go PQC",[56672,134827,141212,141213],[],{"_4070":84275,"_34195":84274,"_23354":141844,"_5":16137,"_30763":84274,"_3518":141845},[],"El fork de Go que añade ML-DSA composite, SLH-DSA, certificados relacionados y esquemas de firma TLS composite, la API que expone y cómo se compila.",{"_4070":84276,"_34195":84274,"_5":34623,"_23354":141847,"_30763":141848,"_3518":141849},[],"/docs/pr-preview/pr-58/es/platform/pqc/go-toolchain#qué-añade-el-fork","Qué añade el fork",{"_4070":84277,"_34195":84274,"_5":34623,"_23354":141851,"_30763":141852,"_3518":141853},[],"/docs/pr-preview/pr-58/es/platform/pqc/go-toolchain#puntos-de-código-tls","Puntos de código TLS",{"_4070":84278,"_34195":84274,"_5":34623,"_23354":141855,"_30763":141856,"_3518":141857},[],"/docs/pr-preview/pr-58/es/platform/pqc/go-toolchain#un-ejemplo-mínimo","Un ejemplo mínimo",{"_4070":84279,"_34195":84274,"_5":34623,"_23354":141859,"_30763":141860,"_3518":141861},[],"/docs/pr-preview/pr-58/es/platform/pqc/go-toolchain#enfoques-descartados","Enfoques descartados",{"_4070":84280,"_34195":84274,"_5":34623,"_23354":141863,"_30763":141864,"_3518":141865},[],"/docs/pr-preview/pr-58/es/platform/pqc/go-toolchain#compilación-del-toolchain-y-de-las-imágenes","Compilación del toolchain y de las imágenes",{"_4070":84281,"_34195":84274,"_23354":141867,"_5":16137,"_30763":84274,"_3518":141868},[],"Go 1.27 incluye ML-DSA en `crypto/mldsa` y en X.509 y TLS, pero no tiene certificados composite ni SLH-DSA, ni certificados relacionados, ni esquemas de firma TLS composite. Por ello Lamassu compila su backend y su proxy TLS con un fork de Go, mantenido en la rama `release-branch.go1.27`. Esta página describe lo que añade el fork, para quienes compilan Lamassu o escriben un cliente que debe comunicarse con él.",{"_4070":84282,"_34195":84274,"_23354":141870,"_5":16137,"_30763":84274,"_3518":141871},[],"El fork expone APIs que no existen en la distribución oficial de Go. El código que las usa solo compila con este toolchain, y no debe suponerse que un binario construido con él cumple la promesa de compatibilidad de Go para esas APIs.",{"_4070":84283,"_34195":84274,"_23354":141873,"_5":16137,"_30763":141848,"_3518":141874},[],"**ML-DSA composite en X.509.** El paquete `x509` incorpora `CompositePublicKey` y `CompositePrivateKey`, que implementan `crypto.Signer`, y 15 valores `CompositeAlgorithm` (por ejemplo `x509.MLDSA65_ECDSA_P384_SHA512`) que permiten generar claves, firmar y verificar. Los certificados, las solicitudes de certificado y las listas de revocación firmados con estas claves se interpretan, se serializan y se verifican como cualquier otro. Se admite la codificación PKCS#8 de claves privadas composite. La página de algoritmos enumera los identificadores.",{"_4070":84284,"_34195":84274,"_23354":141876,"_5":16137,"_30763":141848,"_3518":141877},[],"**SLH-DSA en X.509.** El algoritmo de clave pública `x509.SLHDSA` y doce algoritmos de firma `PureSLHDSA...` están disponibles para interpretar y verificar certificados y claves. La implementación es la biblioteca `circl` de Cloudflare incorporada al fork. Es la parte menos probada: no tiene pruebas propias en x509 ni soporte TLS.",{"_4070":84285,"_34195":84274,"_23354":141879,"_5":16137,"_30763":141848,"_3518":141880},[],"**Certificados relacionados (RFC 9763).** El fork ofrece `x509.CreateBoundCertificate`, que añade a un certificado la extensión `id-pe-relatedCert` (`1.3.6.1.5.5.7.1.36`), `x509.VerifyRelatedCertificate` y las funciones para construir y comprobar el atributo `relatedCertRequest` de una solicitud de certificado (`1.2.840.113549.1.9.16.2.60`). `x509.CertificateRequest` incorpora el campo `ExtraAttributes` para transportarlo. Certificados relacionados explica cómo los usa Lamassu.",{"_4070":84286,"_34195":84274,"_23354":141882,"_5":16137,"_30763":141848,"_3518":141883},[],"**Esquemas de firma composite en TLS.** El paquete `tls` añade 15 constantes `SignatureScheme`, una por algoritmo composite, que se anuncian por defecto después de los esquemas ML-DSA nativos. Solo funcionan con TLS 1.3 y están probadas con autenticación mutua. Sus puntos de código se describen a continuación.",{"_4070":84287,"_34195":84274,"_23354":141885,"_5":16137,"_30763":141852,"_3518":141886},[],"IANA no ha asignado puntos de código a los esquemas de firma TLS composite, por lo que el fork usa el rango de uso privado `0xFE00` a `0xFE0E`, en el orden de la tabla composite: `0xFE00` es `MLDSA44-RSA2048-PSS-SHA256` y `0xFE0E` es `MLDSA65-Ed25519-SHA512`. Un cliente o un servidor construido con una biblioteca TLS estándar no los reconoce y recurrirá a otro esquema o fallará en el handshake. La interoperabilidad queda así limitada a pares construidos con este fork, o a los esquemas ML-DSA nativos (`0x0904` a `0x0906`) que implementa Go 1.27 estándar.",{"_4070":84288,"_34195":84274,"_23354":141888,"_5":16137,"_30763":141852,"_3518":141889},[],"Las tres variantes que usan RSA PKCS#1 v1.5 (`MLDSA44-RSA2048-PKCS15-SHA256`, `MLDSA65-RSA3072-PKCS15-SHA512` y `MLDSA65-RSA4096-PKCS15-SHA512`) se anuncian únicamente en la extensión `signature_algorithms_cert`, por lo que pueden aparecer en una cadena de certificados, pero un certificado hoja con una clave de ese tipo no puede firmar el handshake.",{"_4070":84289,"_34195":84274,"_23354":141891,"_5":16137,"_30763":141852,"_3518":141892},[],"Punto de código",{"_4070":84290,"_34195":84274,"_23354":141894,"_5":16137,"_30763":141852,"_3518":141417},[],{"_4070":84291,"_34195":84274,"_23354":141896,"_5":16137,"_30763":141852,"_3518":65440},[],{"_4070":84292,"_34195":84274,"_23354":141898,"_5":16137,"_30763":141852,"_3518":64930},[],{"_4070":84293,"_34195":84274,"_23354":141900,"_5":16137,"_30763":141852,"_3518":65445},[],{"_4070":84294,"_34195":84274,"_23354":141902,"_5":16137,"_30763":141852,"_3518":64940},[],{"_4070":84295,"_34195":84274,"_23354":141904,"_5":16137,"_30763":141852,"_3518":65450},[],{"_4070":84296,"_34195":84274,"_23354":141906,"_5":16137,"_30763":141852,"_3518":64949},[],{"_4070":84297,"_34195":84274,"_23354":141908,"_5":16137,"_30763":141852,"_3518":65455},[],{"_4070":84298,"_34195":84274,"_23354":141910,"_5":16137,"_30763":141852,"_3518":64958},[],{"_4070":84299,"_34195":84274,"_23354":141912,"_5":16137,"_30763":141852,"_3518":65460},[],{"_4070":84300,"_34195":84274,"_23354":141914,"_5":16137,"_30763":141852,"_3518":64967},[],{"_4070":84301,"_34195":84274,"_23354":141916,"_5":16137,"_30763":141852,"_3518":65465},[],{"_4070":84302,"_34195":84274,"_23354":141918,"_5":16137,"_30763":141852,"_3518":64976},[],{"_4070":84303,"_34195":84274,"_23354":141920,"_5":16137,"_30763":141852,"_3518":65470},[],{"_4070":84304,"_34195":84274,"_23354":141922,"_5":16137,"_30763":141852,"_3518":64985},[],{"_4070":84305,"_34195":84274,"_23354":141924,"_5":16137,"_30763":141852,"_3518":65475},[],{"_4070":84306,"_34195":84274,"_23354":141926,"_5":16137,"_30763":141852,"_3518":64994},[],{"_4070":84307,"_34195":84274,"_23354":141928,"_5":16137,"_30763":141852,"_3518":65480},[],{"_4070":84308,"_34195":84274,"_23354":141930,"_5":16137,"_30763":141852,"_3518":65003},[],{"_4070":84309,"_34195":84274,"_23354":141932,"_5":16137,"_30763":141852,"_3518":65485},[],{"_4070":84310,"_34195":84274,"_23354":141934,"_5":16137,"_30763":141852,"_3518":65013},[],{"_4070":84311,"_34195":84274,"_23354":141936,"_5":16137,"_30763":141852,"_3518":65490},[],{"_4070":84312,"_34195":84274,"_23354":141938,"_5":16137,"_30763":141852,"_3518":65022},[],{"_4070":84313,"_34195":84274,"_23354":141940,"_5":16137,"_30763":141852,"_3518":65495},[],{"_4070":84314,"_34195":84274,"_23354":141942,"_5":16137,"_30763":141852,"_3518":65031},[],{"_4070":84315,"_34195":84274,"_23354":141944,"_5":16137,"_30763":141852,"_3518":65500},[],{"_4070":84316,"_34195":84274,"_23354":141946,"_5":16137,"_30763":141852,"_3518":65040},[],{"_4070":84317,"_34195":84274,"_23354":141948,"_5":16137,"_30763":141852,"_3518":65505},[],{"_4070":84318,"_34195":84274,"_23354":141950,"_5":16137,"_30763":141852,"_3518":65049},[],{"_4070":84319,"_34195":84274,"_23354":141952,"_5":16137,"_30763":141852,"_3518":65510},[],{"_4070":84320,"_34195":84274,"_23354":141954,"_5":16137,"_30763":141852,"_3518":65058},[],{"_4070":84321,"_34195":84274,"_23354":141956,"_5":16137,"_30763":141852,"_3518":141957},[],"El intercambio de claves no cambia respecto a Go original. Los grupos híbridos como `X25519MLKEM768`, `SecP256r1MLKEM768`, `SecP384r1MLKEM1024` y el `MLKEM1024` puro son los de la biblioteca estándar de Go 1.27.",{"_4070":84322,"_34195":84274,"_23354":141959,"_5":16137,"_30763":141852,"_3518":141612},[],{"_4070":84323,"_34195":84274,"_23354":141961,"_5":16137,"_30763":141852,"_3518":141962},[],"Composición",{"_4070":84324,"_34195":84274,"_23354":141964,"_5":16137,"_30763":141852,"_3518":65523},[],{"_4070":84325,"_34195":84274,"_23354":141966,"_5":16137,"_30763":141852,"_3518":65526},[],{"_4070":84326,"_34195":84274,"_23354":141968,"_5":16137,"_30763":141852,"_3518":65529},[],{"_4070":84327,"_34195":84274,"_23354":141970,"_5":16137,"_30763":141852,"_3518":65532},[],{"_4070":84328,"_34195":84274,"_23354":141972,"_5":16137,"_30763":141852,"_3518":65535},[],{"_4070":84329,"_34195":84274,"_23354":141974,"_5":16137,"_30763":141852,"_3518":65538},[],{"_4070":84330,"_34195":84274,"_23354":141976,"_5":16137,"_30763":141852,"_3518":65354},[],{"_4070":84331,"_34195":84274,"_23354":141978,"_5":16137,"_30763":141852,"_3518":141979},[],"ML-KEM-1024 solo",{"_4070":84332,"_34195":84274,"_23354":141981,"_5":16137,"_30763":141852,"_3518":141982},[],"La conexión sigue protegida mientras al menos un componente de un grupo híbrido se mantenga seguro. El intercambio de claves es independiente del tipo de certificado: una conexión puede usar un certificado clásico y aun así tener un intercambio de claves poscuántico.",{"_4070":84333,"_34195":84274,"_23354":141984,"_5":16137,"_30763":141856,"_3518":141985},[],"El siguiente programa crea un certificado composite autofirmado y lo usa como certificado de servidor en una configuración TLS 1.3. Se omite la gestión de errores.",{"_4070":84334,"_34195":84274,"_23354":141987,"_5":16137,"_30763":141856,"_3518":141988},[],"Una clave composite también puede firmar directamente un mensaje, con un contexto opcional de como máximo 255 bytes:",{"_4070":84335,"_34195":84274,"_23354":141990,"_5":16137,"_30763":141860,"_3518":141991},[],"Las primeras iteraciones del fork implementaron certificados Chameleon, definidos en `draft-bonnell-lamps-chameleon-certs`. La idea es emparejar dos certificados del mismo sujeto, por ejemplo uno clásico y otro poscuántico, emitiendo el primero con una extensión que codifica solo las diferencias respecto al segundo. Quien confía en el certificado y entiende la extensión puede reconstruir el certificado emparejado a partir de ella y validar ese, de modo que un único certificado emitido lleva ambas identidades sin cambiar las reglas de validación de ruta del RFC 5280.",{"_4070":84336,"_34195":84274,"_23354":141993,"_5":16137,"_30763":141860,"_3518":141994},[],"El trabajo se descartó porque el borrador caducó sin llegar a ser un estándar y ya no se persigue, de modo que no había una especificación estable con la que interoperar. Nada en la implementación actual depende de él.",{"_4070":84337,"_34195":84274,"_23354":141996,"_5":16137,"_30763":141864,"_3518":141997},[],"El fork se compila en CI mediante un workflow que ejecuta la batería de pruebas de Go y después publica una imagen multiarquitectura, `ghcr.io/lamassuiot/golang-pqc`, con la etiqueta `go1.27` y, para la rama `release-branch.go1.27`, `latest`. La imagen contiene el toolchain en `/usr/local/go-pqc`, con `GOROOT` apuntando a esa ruta.",{"_4070":84338,"_34195":84274,"_23354":141999,"_5":16137,"_30763":141864,"_3518":142000},[],"Para compilar el toolchain desde el código fuente, usa la rama `release-branch.go1.27` y la compilación estándar de Go:",{"_4070":84339,"_34195":84274,"_23354":142002,"_5":16137,"_30763":141864,"_3518":142003},[],"El comando `bin/go` resultante se usa como cualquier otra cadena de herramientas de Go.",{"_4070":84340,"_34195":84274,"_23354":142005,"_5":16137,"_30763":141864,"_3518":142006},[],"Lamassu consume el toolchain de dos maneras. Las imágenes del backend (CA, KMS, VA, alertas, device manager, DMS manager y la compilación monolítica) usan `ghcr.io/lamassuiot/golang-pqc:latest` como imagen de compilación. El workflow de CI del backend instala el mismo toolchain mediante una acción de configuración propia, en lugar de `actions/setup-go`, y el backend exige `go 1.27.3` en su fichero de módulo. Traefik no se compila desde la imagen: su script `build.sh` espera una copia ya compilada del fork en un directorio vecino y genera el binario fuera de un contenedor. Véase Proxy TLS con Traefik.",{"_4070":84341,"_34195":84274,"_23354":142008,"_5":16137,"_30763":141864,"_3518":142009},[],"<Card title=\"Algoritmos\" description=\"Los identificadores y conjuntos de parámetros que hay detrás de estas constantes.\" href=\"/docs/platform/pqc/algorithms\" />",{"_4070":84342,"_34195":84274,"_23354":142011,"_5":16137,"_30763":141864,"_3518":142012},[],"<Card title=\"Proxy TLS con Traefik\" description=\"Cómo se usa el fork para terminar el TLS de los dispositivos.\" href=\"/docs/platform/pqc/tls-front-proxy\" />",{"_4070":84343,"_34195":84343,"_5":16540,"_3518":142014,"_34626":142015,"_23354":142017,"_30763":84343},"Pruebas de integración HTTPS",[56672,134827,141212,142016],"Pruebas de integración",[],{"_4070":84344,"_34195":84343,"_23354":142019,"_5":16137,"_30763":84343,"_3518":142020},[],"Resultados de probar un endpoint HTTPS de Lamassu con OpenSSL y curl usando intercambio de claves poscuántico y certificados poscuánticos y composite.",{"_4070":84345,"_34195":84343,"_5":34623,"_23354":142022,"_30763":142023,"_3518":142024},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/https#escenario","Escenario",{"_4070":84346,"_34195":84343,"_5":34623,"_23354":142026,"_30763":142027,"_3518":142028},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/https#resultados","Resultados",{"_4070":84347,"_34195":84343,"_5":34623,"_23354":142030,"_30763":142031,"_3518":142032},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/https#reproducir-un-caso","Reproducir un caso",{"_4070":84348,"_34195":84343,"_5":34623,"_23354":142034,"_30763":142035,"_3518":142036},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/https#conecta-ofreciendo-un-grupo-y-un-esquema-de-firma","Conecta ofreciendo un grupo y un esquema de firma",{"_4070":84349,"_34195":84343,"_5":34623,"_23354":142038,"_30763":142039,"_3518":142040},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/https#envía-una-petición","Envía una petición",{"_4070":84350,"_34195":84343,"_5":34623,"_23354":142042,"_30763":142043,"_3518":142044},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/https#comprueba-que-una-oferta-incorrecta-se-rechaza","Comprueba que una oferta incorrecta se rechaza",{"_4070":84351,"_34195":84343,"_23354":142046,"_5":16137,"_30763":84343,"_3518":142047},[],"Esta prueba conecta con un endpoint de la API de Lamassu por HTTPS desde un cliente OpenSSL y comprueba que el handshake poscuántico, la cadena de certificados y la petición de aplicación funcionan. El resumen explica los clientes, la matriz de pruebas y qué demuestra cada comprobación.",{"_4070":84352,"_34195":84343,"_23354":142049,"_5":16137,"_30763":142023,"_3518":142050},[],"El cliente solicita `GET /api/ca/health` a través del proxy Traefik, que la reenvía a Envoy Gateway y al servicio de CA. El certificado del servidor y la CA que lo firmó se crearon fuera de Lamassu y se cargaron en el proxy para cada caso. En cada caso el proxy se configuró con los grupos de intercambio de claves y el certificado de esa fila y columna de la matriz.",{"_4070":84353,"_34195":84343,"_23354":142052,"_5":16137,"_30763":142023,"_3518":142053},[],"Las CAs y los certificados son material de pruebas creado fuera de Lamassu, válido durante un periodo corto y con el nombre del servidor como nombre alternativo del sujeto. No los emite el servicio de CA de Lamassu.",{"_4070":84354,"_34195":84343,"_23354":142055,"_5":16137,"_30763":142027,"_3518":142056},[],"Las nueve combinaciones de intercambio de claves y certificado se superaron, igual que los tres certificados composite adicionales.",{"_4070":84355,"_34195":84343,"_23354":142058,"_5":16137,"_30763":142027,"_3518":142059},[],"Intercambio de claves ↓ / Certificado →",{"_4070":84356,"_34195":84343,"_23354":142061,"_5":16137,"_30763":142027,"_3518":65626},[],{"_4070":84357,"_34195":84343,"_23354":142063,"_5":16137,"_30763":142027,"_3518":65629},[],{"_4070":84358,"_34195":84343,"_23354":142065,"_5":16137,"_30763":142027,"_3518":65632},[],{"_4070":84359,"_34195":84343,"_23354":142067,"_5":16137,"_30763":142027,"_3518":65635},[],{"_4070":84360,"_34195":84343,"_23354":142069,"_5":16137,"_30763":142027,"_3518":65638},[],{"_4070":84361,"_34195":84343,"_23354":142071,"_5":16137,"_30763":142027,"_3518":65641},[],{"_4070":84362,"_34195":84343,"_23354":142073,"_5":16137,"_30763":142027,"_3518":65644},[],{"_4070":84363,"_34195":84343,"_23354":142075,"_5":16137,"_30763":142027,"_3518":65647},[],{"_4070":84364,"_34195":84343,"_23354":142077,"_5":16137,"_30763":142027,"_3518":65650},[],{"_4070":84365,"_34195":84343,"_23354":142079,"_5":16137,"_30763":142027,"_3518":65653},[],{"_4070":84366,"_34195":84343,"_23354":142081,"_5":16137,"_30763":142027,"_3518":65656},[],{"_4070":84367,"_34195":84343,"_23354":142083,"_5":16137,"_30763":142027,"_3518":65659},[],{"_4070":84368,"_34195":84343,"_23354":142085,"_5":16137,"_30763":142027,"_3518":65662},[],{"_4070":84369,"_34195":84343,"_23354":142087,"_5":16137,"_30763":142027,"_3518":65665},[],{"_4070":84370,"_34195":84343,"_23354":142089,"_5":16137,"_30763":142027,"_3518":65668},[],{"_4070":84371,"_34195":84343,"_23354":142091,"_5":16137,"_30763":142027,"_3518":142092},[],"Cada celda muestra el grupo negociado y el esquema de la firma del handshake. En todos los casos la cadena se verificó, la petición devolvió `200` y las dos comprobaciones negativas se rechazaron con `handshake_failure`.",{"_4070":84372,"_34195":84343,"_23354":142094,"_5":16137,"_30763":142027,"_3518":142095},[],"Composite adicional",{"_4070":84373,"_34195":84343,"_23354":142097,"_5":16137,"_30763":142027,"_3518":142098},[],"Esquema de firma",{"_4070":84374,"_34195":84343,"_23354":142100,"_5":16137,"_30763":142027,"_3518":138482},[],{"_4070":84375,"_34195":84343,"_23354":142102,"_5":16137,"_30763":142027,"_3518":65682},[],{"_4070":84376,"_34195":84343,"_23354":142104,"_5":16137,"_30763":142027,"_3518":65685},[],{"_4070":84377,"_34195":84343,"_23354":142106,"_5":16137,"_30763":142027,"_3518":142107},[],"✅ con `X25519MLKEM768`",{"_4070":84378,"_34195":84343,"_23354":142109,"_5":16137,"_30763":142027,"_3518":65691},[],{"_4070":84379,"_34195":84343,"_23354":142111,"_5":16137,"_30763":142027,"_3518":65694},[],{"_4070":84380,"_34195":84343,"_23354":142113,"_5":16137,"_30763":142027,"_3518":142107},[],{"_4070":84381,"_34195":84343,"_23354":142115,"_5":16137,"_30763":142027,"_3518":65699},[],{"_4070":84382,"_34195":84343,"_23354":142117,"_5":16137,"_30763":142027,"_3518":65702},[],{"_4070":84383,"_34195":84343,"_23354":142119,"_5":16137,"_30763":142027,"_3518":142107},[],{"_4070":84384,"_34195":84343,"_23354":142121,"_5":16137,"_30763":142027,"_3518":142122},[],"Con una única configuración de servidor que tiene a la vez los certificados ECDSA, ML-DSA-65 y composite y acepta las tres clases de intercambio de claves, un cliente que ofrecía un grupo y un esquema de firma negoció cada una de las nueve combinaciones. `curl` devolvió `200` cuando confiaba en las tres CAs.",{"_4070":84385,"_34195":84343,"_23354":142124,"_5":16137,"_30763":142027,"_3518":142125},[],"Un servidor con certificados de varias clases sirve el primero que coincide con la preferencia de firma del cliente. Un cliente OpenSSL 3.5 o posterior con la configuración por defecto prefiere ML-DSA, así que un cliente que solo confía en la CA ECDSA falla con `unable to get local issuer certificate`, aunque la conexión en sí haya funcionado. Da a los clientes las CAs de todas las clases que el servidor pueda presentar.",{"_4070":84386,"_34195":84343,"_23354":142127,"_5":16137,"_30763":142031,"_3518":142128},[],"Necesitas OpenSSL 3.5 o posterior. Para certificados composite, además el módulo `hybrid-provider` con puntos de código que coincidan con los del toolchain de Go PQC, cargado mediante `OPENSSL_CONF`. Usa el fichero de CA del caso como `ca.pem`.",{"_4070":84387,"_34195":84343,"_23354":142130,"_5":16137,"_30763":142035,"_3518":142131},[],"Este ejemplo prueba intercambio de claves PQ/T con el certificado composite e imprime los valores negociados:",{"_4070":84388,"_34195":84343,"_23354":142133,"_5":16137,"_30763":142035,"_3518":142134},[],"Salida esperada:",{"_4070":84389,"_34195":84343,"_23354":142136,"_5":16137,"_30763":142039,"_3518":142137},[],"Sustituye el `grep` por una petición HTTP para confirmar que la capa de aplicación funciona a través del proxy:",{"_4070":84390,"_34195":84343,"_23354":142139,"_5":16137,"_30763":142039,"_3518":142140},[],"La respuesta empieza por `HTTP/1.1 200 OK`. Con `curl` y un bundle que contenga las CAs de las clases que presenta el servidor, `curl --cacert ca-bundle.pem https://<LAMASSU_HOST>/api/ca/health` también devuelve `200`.",{"_4070":84391,"_34195":84343,"_23354":142142,"_5":16137,"_30763":142043,"_3518":142143},[],"Ofrece solo grupos clásicos a un servidor configurado para intercambio de claves PQ:",{"_4070":84392,"_34195":84343,"_23354":142145,"_5":16137,"_30763":142043,"_3518":142146},[],"El handshake falla con una alerta `handshake failure`. Ofrecer todos los esquemas de firma salvo el del certificado da el mismo resultado.",{"_4070":84393,"_34195":84343,"_23354":142148,"_5":16137,"_30763":142043,"_3518":142149},[],"<Card title=\"MQTTS\" description=\"Las mismas comprobaciones para un broker MQTT.\" href=\"/docs/platform/pqc/integration-tests/mqtts\" />",{"_4070":84394,"_34195":84343,"_23354":142151,"_5":16137,"_30763":142043,"_3518":142152},[],"<Card title=\"Proxy TLS con Traefik\" description=\"Cómo elige el proxy el certificado e impone el intercambio de claves.\" href=\"/docs/platform/pqc/tls-front-proxy\" />",{"_4070":84395,"_34195":84395,"_5":16540,"_3518":142154,"_34626":142155,"_23354":142156,"_30763":84395},"Pruebas de integración MQTTS",[56672,134827,141212,142016],[],{"_4070":84396,"_34195":84395,"_23354":142158,"_5":16137,"_30763":84395,"_3518":142159},[],"Resultados de probar un broker MQTT detrás del proxy TLS de Lamassu con mosquitto, usando intercambio de claves poscuántico y certificados poscuánticos y composite.",{"_4070":84397,"_34195":84395,"_5":34623,"_23354":142161,"_30763":142162,"_3518":142024},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/mqtts#escenario",{"_4070":84398,"_34195":84395,"_5":34623,"_23354":142164,"_30763":142165,"_3518":142028},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/mqtts#resultados",{"_4070":84399,"_34195":84395,"_5":34623,"_23354":142167,"_30763":142168,"_3518":142032},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/mqtts#reproducir-un-caso",{"_4070":84400,"_34195":84395,"_5":34623,"_23354":142170,"_30763":142171,"_3518":142172},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/mqtts#crea-la-configuración-de-openssl","Crea la configuración de OpenSSL",{"_4070":84401,"_34195":84395,"_5":34623,"_23354":142174,"_30763":142175,"_3518":142176},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/mqtts#suscríbete-y-publica","Suscríbete y publica",{"_4070":84402,"_34195":84395,"_5":34623,"_23354":142178,"_30763":142179,"_3518":142044},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/mqtts#comprueba-que-una-oferta-incorrecta-se-rechaza",{"_4070":84403,"_34195":84395,"_5":34623,"_23354":142181,"_30763":142182,"_3518":142183},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/mqtts#qué-debes-saber","Qué debes saber",{"_4070":84404,"_34195":84395,"_23354":142185,"_5":16137,"_30763":84395,"_3518":142186},[],"Esta prueba conecta `mosquitto_pub` y `mosquitto_sub` a un broker MQTT por TLS y comprueba que los mensajes lo atraviesan con intercambio de claves poscuántico y certificados de servidor poscuánticos o composite. El resumen explica los clientes, la matriz de pruebas y qué demuestra cada comprobación.",{"_4070":84405,"_34195":84395,"_23354":142188,"_5":16137,"_30763":142162,"_3518":142189},[],"El broker es EMQX 5.8.9. Escucha MQTT en claro dentro del clúster, y el proxy TLS de Lamassu (Proxy TLS con Traefik) termina el TLS por él en el puerto 8883 y reenvía el tráfico. El TLS es unidireccional: el endpoint del broker presenta su certificado y el cliente no presenta ninguno. El certificado del servidor y su CA se crearon fuera de Lamassu, y el proxy se configuró en cada caso con los grupos de intercambio de claves y el certificado de esa fila y columna de la matriz.",{"_4070":84406,"_34195":84395,"_23354":142191,"_5":16137,"_30763":142162,"_3518":142192},[],"Los clientes son `mosquitto_pub` y `mosquitto_sub` 2.1.2, con MQTT 3.1.1 sobre TLS 1.3 y enlazados con OpenSSL 4.1.0. Un caso se supera cuando el suscriptor recibe el mensaje que el publicador envió a través del broker, ambos clientes validan la cadena de certificados contra la CA del caso y el nombre del servidor, y las dos comprobaciones negativas se rechazan.",{"_4070":84407,"_34195":84395,"_23354":142194,"_5":16137,"_30763":142165,"_3518":142195},[],"Los doce casos se superaron. En cada uno, `mosquitto_sub` se suscribió a un tema, `mosquitto_pub` publicó un valor único y el suscriptor lo recibió. La prueba se ejecutó dos veces por caso: una con el cliente ofreciendo todos los grupos y esquemas de firma, y otra con el cliente ofreciendo solo el grupo y el esquema de firma esperados para el caso. La segunda ejecución demuestra que el endpoint del broker negoció exactamente ese grupo y ese esquema, porque el cliente no ofrecía nada más.",{"_4070":84408,"_34195":84395,"_23354":142197,"_5":16137,"_30763":142165,"_3518":142059},[],{"_4070":84409,"_34195":84395,"_23354":142199,"_5":16137,"_30763":142165,"_3518":65626},[],{"_4070":84410,"_34195":84395,"_23354":142201,"_5":16137,"_30763":142165,"_3518":65629},[],{"_4070":84411,"_34195":84395,"_23354":142203,"_5":16137,"_30763":142165,"_3518":65632},[],{"_4070":84412,"_34195":84395,"_23354":142205,"_5":16137,"_30763":142165,"_3518":65635},[],{"_4070":84413,"_34195":84395,"_23354":142207,"_5":16137,"_30763":142165,"_3518":65638},[],{"_4070":84414,"_34195":84395,"_23354":142209,"_5":16137,"_30763":142165,"_3518":65641},[],{"_4070":84415,"_34195":84395,"_23354":142211,"_5":16137,"_30763":142165,"_3518":65644},[],{"_4070":84416,"_34195":84395,"_23354":142213,"_5":16137,"_30763":142165,"_3518":65647},[],{"_4070":84417,"_34195":84395,"_23354":142215,"_5":16137,"_30763":142165,"_3518":65650},[],{"_4070":84418,"_34195":84395,"_23354":142217,"_5":16137,"_30763":142165,"_3518":65653},[],{"_4070":84419,"_34195":84395,"_23354":142219,"_5":16137,"_30763":142165,"_3518":65656},[],{"_4070":84420,"_34195":84395,"_23354":142221,"_5":16137,"_30763":142165,"_3518":65659},[],{"_4070":84421,"_34195":84395,"_23354":142223,"_5":16137,"_30763":142165,"_3518":65662},[],{"_4070":84422,"_34195":84395,"_23354":142225,"_5":16137,"_30763":142165,"_3518":65665},[],{"_4070":84423,"_34195":84395,"_23354":142227,"_5":16137,"_30763":142165,"_3518":65668},[],{"_4070":84424,"_34195":84395,"_23354":142229,"_5":16137,"_30763":142165,"_3518":142230},[],"Los certificados composite adicionales se comportan igual con intercambio de claves PQ/T.",{"_4070":84425,"_34195":84395,"_23354":142232,"_5":16137,"_30763":142165,"_3518":142095},[],{"_4070":84426,"_34195":84395,"_23354":142234,"_5":16137,"_30763":142165,"_3518":142098},[],{"_4070":84427,"_34195":84395,"_23354":142236,"_5":16137,"_30763":142165,"_3518":138482},[],{"_4070":84428,"_34195":84395,"_23354":142238,"_5":16137,"_30763":142165,"_3518":65682},[],{"_4070":84429,"_34195":84395,"_23354":142240,"_5":16137,"_30763":142165,"_3518":65685},[],{"_4070":84430,"_34195":84395,"_23354":142242,"_5":16137,"_30763":142165,"_3518":65827},[],{"_4070":84431,"_34195":84395,"_23354":142244,"_5":16137,"_30763":142165,"_3518":65691},[],{"_4070":84432,"_34195":84395,"_23354":142246,"_5":16137,"_30763":142165,"_3518":65694},[],{"_4070":84433,"_34195":84395,"_23354":142248,"_5":16137,"_30763":142165,"_3518":65827},[],{"_4070":84434,"_34195":84395,"_23354":142250,"_5":16137,"_30763":142165,"_3518":65699},[],{"_4070":84435,"_34195":84395,"_23354":142252,"_5":16137,"_30763":142165,"_3518":65702},[],{"_4070":84436,"_34195":84395,"_23354":142254,"_5":16137,"_30763":142165,"_3518":65827},[],{"_4070":84437,"_34195":84395,"_23354":142256,"_5":16137,"_30763":142165,"_3518":142257},[],"Cuando el cliente ofrecía todos los grupos salvo los de la clase del caso, o todos los esquemas de firma salvo el del certificado, el handshake TLS fallaba con una alerta `handshake failure` y el broker nunca enviaba un `CONNACK`. El resultado fue el mismo en los doce casos.",{"_4070":84438,"_34195":84395,"_23354":142259,"_5":16137,"_30763":142165,"_3518":142260},[],"Con una única configuración de servidor que tiene los certificados ECDSA, ML-DSA-65 y composite y acepta las tres clases de intercambio de claves, cada una de las nueve combinaciones conectó en el puerto 8883 cuando el cliente ofrecía un grupo y un esquema de firma. `mosquitto_pub` recibió `CONNACK (0)` en todas.",{"_4070":84439,"_34195":84395,"_23354":142262,"_5":16137,"_30763":142168,"_3518":142263},[],"mosquitto no tiene opciones para elegir grupos de intercambio de claves ni esquemas de firma, así que se fijan mediante un fichero de configuración de OpenSSL que `mosquitto_pub` y `mosquitto_sub` leen de la variable de entorno `OPENSSL_CONF`. Necesitas OpenSSL 3.5 o posterior; para certificados composite, además el módulo `hybrid-provider` con puntos de código que coincidan con los del toolchain de Go PQC.",{"_4070":84440,"_34195":84395,"_23354":142265,"_5":16137,"_30763":142171,"_3518":142266},[],"Este `pqc-client.cnf` hace que el cliente ofrezca solo `X25519MLKEM768` y el esquema de firma composite, y carga el provider composite:",{"_4070":84441,"_34195":84395,"_23354":142268,"_5":16137,"_30763":142171,"_3518":142269},[],"Elimina el provider `hybrid` y el módulo en un caso que use solo ML-DSA o ECDSA.",{"_4070":84442,"_34195":84395,"_23354":142271,"_5":16137,"_30763":142175,"_3518":142272},[],"Arranca el suscriptor en una terminal y el publicador en otra. Ambos validan el certificado del broker contra `ca.pem`, la CA del caso:",{"_4070":84443,"_34195":84395,"_23354":142274,"_5":16137,"_30763":142175,"_3518":142275},[],"El suscriptor imprime `hello over pqc` y termina. Añade `-d` para ver los paquetes `CONNECT`, `CONNACK (0)`, `SUBACK` y `PUBLISH`.",{"_4070":84444,"_34195":84395,"_23354":142277,"_5":16137,"_30763":142179,"_3518":142278},[],"Cambia `Groups` por una lista que no incluya el grupo que acepta el servidor, por ejemplo `Groups = X25519` frente a un servidor configurado para `MLKEM1024`, y repite la publicación. El cliente falla con `tls alert handshake failure` y no se recibe ningún `CONNACK`.",{"_4070":84445,"_34195":84395,"_23354":142280,"_5":16137,"_30763":142182,"_3518":142281},[],"**Nombre del host y certificado.** mosquitto usa el valor de `-h` como destino de la conexión, como nombre de servidor enviado en el handshake y como nombre que verifica. Los certificados de prueba llevan ese nombre como nombre alternativo del sujeto.",{"_4070":84446,"_34195":84395,"_23354":142283,"_5":16137,"_30763":142182,"_3518":142284},[],"**Un certificado por nombre.** El proxy TLS guarda sus certificados por nombre, no por puerto. Un endpoint MQTT que comparte nombre con el endpoint HTTPS sirve los mismos certificados, así que da al broker su propio nombre si necesita un certificado distinto.",{"_4070":84447,"_34195":84395,"_23354":142286,"_5":16137,"_30763":142182,"_3518":142287},[],"**No se probaron los valores por defecto sin fijar.** Todas las ejecuciones fijaron explícitamente la oferta de grupos y firmas, así que no se comprobó qué negocia mosquitto con la oferta por defecto de OpenSSL. Las pruebas HTTPS sí cubren un cliente OpenSSL por defecto: recibe el certificado ML-DSA si el servidor lo tiene.",{"_4070":84448,"_34195":84395,"_23354":142289,"_5":16137,"_30763":142182,"_3518":142290},[],"**Otros clientes en el mismo puerto.** Imponer TLS 1.3 o algoritmos poscuánticos en un puerto MQTT compartido afecta a todos los clientes que se conectan a él. Durante las pruebas el proxy registró intentos de conexión de otros clientes que solo admiten TLS 1.2 o anterior, o que no confiaban en el certificado. Identifícalos antes de dejar el ajuste de forma permanente.",{"_4070":84449,"_34195":84395,"_23354":142292,"_5":16137,"_30763":142182,"_3518":142293},[],"<Card title=\"HTTPS\" description=\"Las mismas comprobaciones para un endpoint HTTPS de Lamassu.\" href=\"/docs/platform/pqc/integration-tests/https\" />",{"_4070":84450,"_34195":84395,"_23354":142295,"_5":16137,"_30763":142182,"_3518":142296},[],"<Card title=\"Despliegue con el chart de Helm\" description=\"Despliega el proxy que termina el TLS.\" href=\"/docs/platform/pqc/deployment\" />",{"_4070":84451,"_34195":84451,"_5":16540,"_3518":142298,"_34626":142299,"_23354":142300,"_30763":84451},"Resumen de las pruebas de integración",[56672,134827,141212,142016],[],{"_4070":84452,"_34195":84451,"_23354":142302,"_5":16137,"_30763":84451,"_3518":142303},[],"Evidencia de que software ajeno a Lamassu negocia intercambio de claves poscuántico y verifica los certificados poscuánticos y composite que sirve Lamassu.",{"_4070":84453,"_34195":84451,"_5":34623,"_23354":142305,"_30763":142306,"_3518":142307},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/overview#qué-se-probó","Qué se probó",{"_4070":84454,"_34195":84451,"_5":34623,"_23354":142309,"_30763":142310,"_3518":142311},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/overview#la-matriz-de-pruebas","La matriz de pruebas",{"_4070":84455,"_34195":84451,"_5":34623,"_23354":142313,"_30763":142314,"_3518":142315},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/overview#qué-comprueba-cada-caso","Qué comprueba cada caso",{"_4070":84456,"_34195":84451,"_5":34623,"_23354":142317,"_30763":142318,"_3518":142319},[],"/docs/pr-preview/pr-58/es/platform/pqc/integration-tests/overview#comportamiento-esperable","Comportamiento esperable",{"_4070":84457,"_34195":84451,"_23354":142321,"_5":16137,"_30763":84451,"_3518":142322},[],"Los certificados poscuánticos solo sirven si los sistemas que los consumen pueden usarlos. Estas pruebas de integración comprueban que clientes y brokers que no forman parte de Lamassu, construidos sobre otra biblioteca criptográfica, pueden conectarse a un endpoint TLS de Lamassu, negociar un intercambio de claves poscuántico y verificar certificados poscuánticos y composite. Se probaron dos protocolos: HTTPS y MQTTS.",{"_4070":84458,"_34195":84451,"_23354":142324,"_5":16137,"_30763":84451,"_3518":142325},[],"Los certificados y las CAs de las pruebas se generaron fuera de Lamassu, con herramientas estándar, para mostrar que el toolchain de Go PQC implementa los formatos X.509 y TLS de forma interoperable. Demuestran que los certificados creados externamente funcionan con el endpoint TLS de Lamassu y que software independiente los verifica. No prueban certificados emitidos por una CA de Lamassu.",{"_4070":84459,"_34195":84451,"_23354":142327,"_5":16137,"_30763":142306,"_3518":142328},[],"El servidor es el proxy Traefik que termina el TLS de los dispositivos en Lamassu (Proxy TLS con Traefik). Está compilado con el toolchain de Go PQC y se configuró en cada prueba con una clase de intercambio de claves y una clase de certificado.",{"_4070":84460,"_34195":84451,"_23354":142330,"_5":16137,"_30763":142306,"_3518":142331},[],"Los clientes son implementaciones independientes:",{"_4070":84461,"_34195":84451,"_23354":142333,"_5":16137,"_30763":142306,"_3518":142334},[],"**OpenSSL 4.0.3 y 4.1.0**, con el soporte nativo de ML-KEM y ML-DSA de OpenSSL 3.5 y posteriores.",{"_4070":84462,"_34195":84451,"_23354":142336,"_5":16137,"_30763":142306,"_3518":142337},[],"**El módulo `hybrid-provider` de OpenSSL**, para ML-DSA composite. La versión usada se escribió contra el borrador 19 de la especificación, que después se publicó como RFC 10073; los vectores de prueba de ambos son idénticos, pero el provider no se contrastó de otro modo con el texto final.",{"_4070":84463,"_34195":84451,"_23354":142339,"_5":16137,"_30763":142306,"_3518":142340},[],"**`curl`*&#x2A; para HTTPS y **`mosquitto_pub` y `mosquitto_sub` 2.1.2** para MQTTS, ambos enlazados con ese OpenSSL.",{"_4070":84464,"_34195":84451,"_23354":142342,"_5":16137,"_30763":142310,"_3518":142343},[],"Cada combinación de intercambio de claves y certificado se probó por separado, con las familias que Lamassu usa en el resto de la documentación (T, PQ y PQ/T, véase Algoritmos).",{"_4070":84465,"_34195":84451,"_23354":142345,"_5":16137,"_30763":142310,"_3518":142346},[],"Intercambio de claves",{"_4070":84466,"_34195":84451,"_23354":142348,"_5":16137,"_30763":142310,"_3518":142349},[],"Grupos que acepta el servidor",{"_4070":84467,"_34195":84451,"_23354":142351,"_5":16137,"_30763":142310,"_3518":65635},[],{"_4070":84468,"_34195":84451,"_23354":142353,"_5":16137,"_30763":142310,"_3518":65345},[],{"_4070":84469,"_34195":84451,"_23354":142355,"_5":16137,"_30763":142310,"_3518":65647},[],{"_4070":84470,"_34195":84451,"_23354":142357,"_5":16137,"_30763":142310,"_3518":65354},[],{"_4070":84471,"_34195":84451,"_23354":142359,"_5":16137,"_30763":142310,"_3518":65659},[],{"_4070":84472,"_34195":84451,"_23354":142361,"_5":16137,"_30763":142310,"_3518":65363},[],{"_4070":84473,"_34195":84451,"_23354":142363,"_5":16137,"_30763":142310,"_3518":137627},[],{"_4070":84474,"_34195":84451,"_23354":142365,"_5":16137,"_30763":142310,"_3518":142366},[],"Certificado del servidor",{"_4070":84475,"_34195":84451,"_23354":142368,"_5":16137,"_30763":142310,"_3518":65635},[],{"_4070":84476,"_34195":84451,"_23354":142370,"_5":16137,"_30763":142310,"_3518":65956},[],{"_4070":84477,"_34195":84451,"_23354":142372,"_5":16137,"_30763":142310,"_3518":65647},[],{"_4070":84478,"_34195":84451,"_23354":142374,"_5":16137,"_30763":142310,"_3518":64822},[],{"_4070":84479,"_34195":84451,"_23354":142376,"_5":16137,"_30763":142310,"_3518":65659},[],{"_4070":84480,"_34195":84451,"_23354":142378,"_5":16137,"_30763":142310,"_3518":65965},[],{"_4070":84481,"_34195":84451,"_23354":142380,"_5":16137,"_30763":142310,"_3518":142381},[],"Son nueve combinaciones. Se probaron además tres certificados composite con intercambio de claves PQ/T: `MLDSA44-ECDSA-P256-SHA256`, `MLDSA65-ECDSA-P256-SHA512` y `MLDSA65-Ed25519-SHA512`, hasta un total de doce casos. Cada certificado lo emitió una CA de pruebas con el mismo algoritmo que el certificado.",{"_4070":84482,"_34195":84451,"_23354":142383,"_5":16137,"_30763":142314,"_3518":142384},[],"Un caso se supera solo si se cumple todo lo siguiente:",{"_4070":84483,"_34195":84451,"_23354":142386,"_5":16137,"_30763":142314,"_3518":142387},[],"**Intercambio de claves.** El grupo negociado en el handshake es el esperado para el caso.",{"_4070":84484,"_34195":84451,"_23354":142389,"_5":16137,"_30763":142314,"_3518":142390},[],"**Firma.** El esquema de la firma del handshake del servidor es el esperado para el certificado.",{"_4070":84485,"_34195":84451,"_23354":142392,"_5":16137,"_30763":142314,"_3518":142393},[],"**Cadena.** El cliente verifica la cadena de certificados contra la CA del caso y el nombre del servidor, sin errores de verificación.",{"_4070":84486,"_34195":84451,"_23354":142395,"_5":16137,"_30763":142314,"_3518":142396},[],"**Tráfico de aplicación.** El protocolo funciona: una petición HTTP devuelve `200`, o un mensaje MQTT publicado en el broker llega a un suscriptor.",{"_4070":84487,"_34195":84451,"_23354":142398,"_5":16137,"_30763":142314,"_3518":142399},[],"**Se rechaza un intercambio de claves incorrecto.** Un cliente que ofrece todos los grupos salvo los de la clase del caso falla con la alerta TLS `handshake_failure`.",{"_4070":84488,"_34195":84451,"_23354":142401,"_5":16137,"_30763":142314,"_3518":142402},[],"**Se rechaza un esquema de certificado incorrecto.** Un cliente que ofrece todos los esquemas de firma salvo el del certificado falla con la misma alerta.",{"_4070":84489,"_34195":84451,"_23354":142404,"_5":16137,"_30763":142314,"_3518":142405},[],"Las dos últimas comprobaciones demuestran que el servidor impone su configuración, y no solo que acepta a un cliente compatible.",{"_4070":84490,"_34195":84451,"_23354":142407,"_5":16137,"_30763":142318,"_3518":142408},[],"**Hubo que alinear los puntos de código composite.** Los esquemas de firma TLS de los algoritmos composite usan puntos de código de uso privado. El `hybrid-provider` usa por defecto otros valores, así que para las pruebas se igualaron a los del toolchain de Go PQC. Un cliente que implemente TLS composite debe usar los mismos valores.",{"_4070":84491,"_34195":84451,"_23354":142410,"_5":16137,"_30763":142318,"_3518":142411},[],"**ML-DSA puro y ML-KEM no necesitan nada más.** Funcionan con OpenSSL 3.5 o posterior tal cual; solo los certificados composite necesitan el provider.",{"_4070":84492,"_34195":84451,"_23354":142413,"_5":16137,"_30763":142318,"_3518":142414},[],"**Algunos handshakes requieren un viaje de ida y vuelta adicional.** El cliente envía primero el key share de `X25519MLKEM768`. Cuando el servidor está configurado para una clase que no lo incluye (T y PQ), responde con un HelloRetryRequest y el handshake termina con el grupo que pide.",{"_4070":84493,"_34195":84451,"_23354":142416,"_5":16137,"_30763":142318,"_3518":142417},[],"**La preferencia de firma del cliente decide el certificado.** Cuando el servidor tiene certificados de varias clases para el mismo nombre, sirve el primero que coincide con la lista de esquemas de firma del cliente. Un cliente OpenSSL 3.5 o posterior con la configuración por defecto lista ML-DSA primero, de modo que recibe el certificado ML-DSA y debe confiar en esa CA.",{"_4070":84494,"_34195":84451,"_23354":142419,"_5":16137,"_30763":142318,"_3518":142420},[],"<Card title=\"HTTPS\" description=\"Un endpoint de la API de Lamassu probado con openssl y curl.\" href=\"/docs/platform/pqc/integration-tests/https\" />",{"_4070":84495,"_34195":84451,"_23354":142422,"_5":16137,"_30763":142318,"_3518":142423},[],"<Card title=\"MQTTS\" description=\"Un broker MQTT detrás del proxy TLS, probado con mosquitto.\" href=\"/docs/platform/pqc/integration-tests/mqtts\" />",{"_4070":84496,"_34195":84451,"_23354":142425,"_5":16137,"_30763":142318,"_3518":142426},[],"<Card title=\"Limitaciones conocidas\" description=\"Qué no cubren estas pruebas ni la plataforma.\" href=\"/docs/platform/pqc/limitations\" />",{"_4070":84497,"_34195":84497,"_5":16540,"_3518":142428,"_34626":142429,"_23354":142430,"_30763":84497},"Claves y autoridades de certificación",[56672,134827,141212,141579],[],{"_4070":84498,"_34195":84497,"_23354":142432,"_5":16137,"_30763":84497,"_3518":142433},[],"Crear claves y CA poscuánticas, firmar con ellas y emitir certificados, con el soporte de motores, los valores de la API y las restricciones aplicables.",{"_4070":84499,"_34195":84497,"_5":34623,"_23354":142435,"_30763":142436,"_3518":142437},[],"/docs/pr-preview/pr-58/es/platform/pqc/keys-and-cas#elegir-un-motor-criptográfico-compatible","Elegir un motor criptográfico compatible",{"_4070":84500,"_34195":84497,"_5":34623,"_23354":142439,"_30763":142440,"_3518":142441},[],"/docs/pr-preview/pr-58/es/platform/pqc/keys-and-cas#crear-una-clave","Crear una clave",{"_4070":84501,"_34195":84497,"_5":34623,"_23354":142443,"_30763":142444,"_3518":142445},[],"/docs/pr-preview/pr-58/es/platform/pqc/keys-and-cas#crear-una-autoridad-de-certificación","Crear una autoridad de certificación",{"_4070":84502,"_34195":84497,"_5":34623,"_23354":142447,"_30763":142448,"_3518":142449},[],"/docs/pr-preview/pr-58/es/platform/pqc/keys-and-cas#combinar-algoritmos-en-una-jerarquía","Combinar algoritmos en una jerarquía",{"_4070":84503,"_34195":84497,"_5":34623,"_23354":142451,"_30763":142452,"_3518":142453},[],"/docs/pr-preview/pr-58/es/platform/pqc/keys-and-cas#firmar-y-verificar-con-una-clave","Firmar y verificar con una clave",{"_4070":84504,"_34195":84497,"_5":34623,"_23354":142455,"_30763":142456,"_3518":142457},[],"/docs/pr-preview/pr-58/es/platform/pqc/keys-and-cas#restricciones-a-tener-en-cuenta","Restricciones a tener en cuenta",{"_4070":84505,"_34195":84497,"_23354":142459,"_5":16137,"_30763":84497,"_3518":142460},[],"El backend de Lamassu trata las claves poscuánticas como un tipo más de clave del servicio de gestión de claves (KMS). Una autoridad de certificación creada con una clave así firma certificados y listas de revocación por las mismas rutas que una CA RSA o ECDSA, porque la firma la realiza el fork de Go. Esta página explica qué enviar a la API, qué motores criptográficos pueden custodiar las claves y dónde difiere el comportamiento respecto a las claves clásicas. El backend debe compilarse con el toolchain de Go PQC.",{"_4070":84506,"_34195":84497,"_23354":142462,"_5":16137,"_30763":142436,"_3518":142463},[],"No todos los motores criptográficos pueden crear o custodiar claves poscuánticas. Solo pueden los motores que ejecutan la criptografía dentro del proceso de Lamassu.",{"_4070":84507,"_34195":84497,"_23354":142465,"_5":16137,"_30763":142436,"_3518":142466},[],"Motor",{"_4070":84508,"_34195":84497,"_23354":142468,"_5":16137,"_30763":142436,"_3518":66056},[],{"_4070":84509,"_34195":84497,"_23354":142470,"_5":16137,"_30763":142436,"_3518":66059},[],{"_4070":84510,"_34195":84497,"_23354":142472,"_5":16137,"_30763":142436,"_3518":142473},[],"Soportado",{"_4070":84511,"_34195":84497,"_23354":142475,"_5":16137,"_30763":142436,"_3518":66065},[],{"_4070":84512,"_34195":84497,"_23354":142477,"_5":16137,"_30763":142436,"_3518":142473},[],{"_4070":84513,"_34195":84497,"_23354":142479,"_5":16137,"_30763":142436,"_3518":66070},[],{"_4070":84514,"_34195":84497,"_23354":142481,"_5":16137,"_30763":142436,"_3518":142482},[],"No soportado",{"_4070":84515,"_34195":84497,"_23354":142484,"_5":16137,"_30763":142436,"_3518":63592},[],{"_4070":84516,"_34195":84497,"_23354":142486,"_5":16137,"_30763":142436,"_3518":142482},[],{"_4070":84517,"_34195":84497,"_23354":142488,"_5":16137,"_30763":142436,"_3518":63596},[],{"_4070":84518,"_34195":84497,"_23354":142490,"_5":16137,"_30763":142436,"_3518":142482},[],{"_4070":84519,"_34195":84497,"_23354":142492,"_5":16137,"_30763":142436,"_3518":142493},[],"Azure Key Vault y Azure Secrets",{"_4070":84520,"_34195":84497,"_23354":142495,"_5":16137,"_30763":142436,"_3518":142482},[],{"_4070":84521,"_34195":84497,"_23354":142497,"_5":16137,"_30763":142436,"_3518":66089},[],{"_4070":84522,"_34195":84497,"_23354":142499,"_5":16137,"_30763":142436,"_3518":142482},[],{"_4070":84523,"_34195":84497,"_23354":142501,"_5":16137,"_30763":142436,"_3518":142502},[],"En la práctica, las claves poscuánticas requieren por ahora el motor filesystem, que tiene nivel de seguridad 1. No hay claves con un nivel de garantía superior, en un módulo de seguridad hardware o en un KMS en la nube, para estos algoritmos.",{"_4070":84524,"_34195":84497,"_23354":142504,"_5":16137,"_30763":142436,"_3518":142505},[],"Los motores Vault KV2 y AWS Secrets Manager incluyen los tipos de clave poscuánticos entre los que dicen soportar, por lo que una petición supera la comprobación de compatibilidad. La creación falla después con un error `unsupported key type` del motor. Debe seleccionarse explícitamente un motor filesystem o software con `engine_id`.",{"_4070":84525,"_34195":84497,"_23354":142507,"_5":16137,"_30763":142440,"_3518":142508},[],"Una clave del KMS se crea con el algoritmo y el tamaño descritos en Algoritmos:",{"_4070":84526,"_34195":84497,"_23354":142510,"_5":16137,"_30763":142440,"_3518":142511},[],"Los parámetros inválidos se rechazan con un mensaje explícito: un tamaño de ML-DSA distinto de 44, 65 o 87, un identificador de SLH-DSA fuera del rango 1 a 12, una variante composite fuera del rango 1 a 15, o una variante composite que no pertenece a la familia solicitada. La importación de una clave privada en formato PKCS#8 detecta automáticamente el algoritmo y el conjunto de parámetros; admite claves ML-DSA, SLH-DSA, composite y Ed25519.",{"_4070":84527,"_34195":84497,"_23354":142513,"_5":16137,"_30763":142444,"_3518":142514},[],"Una CA con clave poscuántica usa la misma petición que cualquier otra CA, enviada a `POST /api/ca/v1/cas`. Solo cambia `key_metadata`, donde `bits` transporta el conjunto de parámetros. Una CA raíz con ML-DSA-65:",{"_4070":84528,"_34195":84497,"_23354":142516,"_5":16137,"_30763":142444,"_3518":142517},[],"Una CA raíz con clave composite de ML-DSA-44 y ECDSA P-256 usa `\"key_metadata\": { \"type\": \"Composite-ML-DSA-ECDSA\", \"bits\": 9 }`. Ed25519 usa `\"type\": \"Ed25519\", \"bits\": 256` y SLH-DSA usa `\"type\": \"SLH-DSA\", \"bits\": 1` para seleccionar SLH-DSA-SHA2-128s. Las CA subordinadas se crean del mismo modo: la subordinada firma su propia solicitud de certificado con la clave del KMS y la CA padre emite el certificado.",{"_4070":84529,"_34195":84497,"_23354":142519,"_5":16137,"_30763":142444,"_3518":142520},[],"Es posible importar CA existentes con una clave privada poscuántica en el caso de ML-DSA y Ed25519. La importación de una CA con clave SLH-DSA o composite no está soportada.",{"_4070":84530,"_34195":84497,"_23354":142522,"_5":16137,"_30763":142448,"_3518":142523},[],"El backend no impone restricciones sobre qué algoritmo emite a cuál. Una CA con clave ML-DSA puede emitir certificados a sujetos RSA, ECDSA, Ed25519 y ML-DSA, y una CA RSA o ECDSA puede emitir certificados a sujetos poscuánticos. La batería de pruebas cubre a través de la API la matriz completa de ML-DSA y Ed25519, y cubre CA y hojas SLH-DSA y composite a nivel del motor de certificados. Esto permite introducir una CA poscuántica bajo una raíz clásica, o a la inversa, pero la parte que confía debe poder verificar todos los algoritmos de la cadena. En TLS, las firmas de la cadena de certificados se comprueban frente a la extensión `signature_algorithms_cert` del cliente, por lo que una cadena firmada con ML-DSA o con un algoritmo composite necesita un cliente que lo anuncie ahí.",{"_4070":84531,"_34195":84497,"_23354":142525,"_5":16137,"_30763":142452,"_3518":142526},[],"El endpoint de firma del KMS acepta nuevos valores de `signature_algorithm`. El campo `message_type` se ignora en todos ellos. Los valores de ML-DSA, SLH-DSA y Ed25519 son «pure»: el mensaje se firma directamente, sin prehash (no son HashML-DSA, HashSLH-DSA ni Ed25519ph). Los valores composite calculan el hash del mensaje con el hash de la variante y firman un mensaje representativo que incluye una etiqueta fija y el contexto opcional.",{"_4070":84532,"_34195":84497,"_23354":142528,"_5":16137,"_30763":142452,"_3518":141145},[],{"_4070":84533,"_34195":84497,"_23354":142530,"_5":16137,"_30763":142452,"_3518":66123},[],{"_4070":84534,"_34195":84497,"_23354":142532,"_5":16137,"_30763":142452,"_3518":66126},[],{"_4070":84535,"_34195":84497,"_23354":142534,"_5":16137,"_30763":142452,"_3518":66129},[],{"_4070":84536,"_34195":84497,"_23354":142536,"_5":16137,"_30763":142452,"_3518":64701},[],{"_4070":84537,"_34195":84497,"_23354":142538,"_5":16137,"_30763":142452,"_3518":66134},[],{"_4070":84538,"_34195":84497,"_23354":142540,"_5":16137,"_30763":142452,"_3518":66137},[],{"_4070":84539,"_34195":84497,"_23354":142542,"_5":16137,"_30763":142452,"_3518":66140},[],{"_4070":84540,"_34195":84497,"_23354":142544,"_5":16137,"_30763":142452,"_3518":64709},[],{"_4070":84541,"_34195":84497,"_23354":142546,"_5":16137,"_30763":142452,"_3518":66145},[],{"_4070":84542,"_34195":84497,"_23354":142548,"_5":16137,"_30763":142452,"_3518":142549},[],"El backend no comprueba que el algoritmo coincida con la clave; debe elegirse el valor que corresponde al tipo de clave. Cuando una CA firma un certificado o una lista de revocación, el algoritmo se selecciona automáticamente.",{"_4070":84543,"_34195":84497,"_23354":142551,"_5":16137,"_30763":142456,"_3518":142552},[],"Varias partes de la plataforma aún no gestionan claves poscuánticas. Se reúnen en Limitaciones conocidas; las que afectan a la operación diaria son las siguientes.",{"_4070":84544,"_34195":84497,"_23354":142554,"_5":16137,"_30763":142456,"_3518":142555},[],"Los perfiles de emisión aplican restricciones de clave solo a RSA y ECDSA, mediante `allow_rsa_keys` y `allow_ecdsa_keys`. Un perfil con la aplicación de restricciones activada no bloquea las claves poscuánticas, y no dispone de un interruptor para permitirlas o denegarlas.",{"_4070":84545,"_34195":84497,"_23354":142557,"_5":16137,"_30763":142456,"_3518":142558},[],"La fortaleza de clave registrada para un certificado cuya clave es poscuántica o Ed25519 solo se calcula para RSA y ECDSA, por lo que esos certificados se almacenan con tipo y tamaño de clave desconocidos y fortaleza baja.",{"_4070":84546,"_34195":84497,"_23354":142560,"_5":16137,"_30763":142456,"_3518":142561},[],"Las respuestas OCSP se firman con la biblioteca `golang.org/x/crypto/ocsp`, que solo admite claves de firma RSA y ECDSA. No cabe esperar, por tanto, que una CA con clave poscuántica, Ed25519 o composite pueda firmar respuestas OCSP; las CRL se generan con el fork y no se ven afectadas por este límite, aunque no tienen pruebas.",{"_4070":84547,"_34195":84497,"_23354":142563,"_5":16137,"_30763":142456,"_3518":142564},[],"La generación de claves en el servidor del DMS (la operación `serverkeygen` de EST) genera únicamente claves RSA y ECDSA.",{"_4070":84548,"_34195":84497,"_23354":142566,"_5":16137,"_30763":142456,"_3518":142567},[],"<Card title=\"Certificados relacionados\" description=\"Vincular un certificado poscuántico a uno clásico existente.\" href=\"/docs/platform/pqc/related-certificates\" />",{"_4070":84549,"_34195":84497,"_23354":142569,"_5":16137,"_30763":142456,"_3518":142570},[],"<Card title=\"Dashboard\" description=\"Crear los mismos objetos desde la interfaz web.\" href=\"/docs/platform/pqc/dashboard\" />",{"_4070":84550,"_34195":84550,"_5":16540,"_3518":142572,"_34626":142573,"_23354":142575,"_30763":84550},"Limitaciones conocidas",[56672,134827,141212,142574],"Referencia",[],{"_4070":84551,"_34195":84550,"_23354":142577,"_5":16137,"_30763":84550,"_3518":142578},[],"Qué está incompleto, es no estándar o no está verificado en el soporte poscuántico de Lamassu, agrupado por componente.",{"_4070":84552,"_34195":84550,"_5":34623,"_23354":142580,"_30763":142581,"_3518":142582},[],"/docs/pr-preview/pr-58/es/platform/pqc/limitations#estándares-e-interoperabilidad","Estándares e interoperabilidad",{"_4070":84553,"_34195":84550,"_5":34623,"_23354":142584,"_30763":142585,"_3518":142586},[],"/docs/pr-preview/pr-58/es/platform/pqc/limitations#claves-y-motores","Claves y motores",{"_4070":84554,"_34195":84550,"_5":34623,"_23354":142588,"_30763":142589,"_3518":142590},[],"/docs/pr-preview/pr-58/es/platform/pqc/limitations#autoridad-de-certificación-y-validación","Autoridad de certificación y validación",{"_4070":84555,"_34195":84550,"_5":34623,"_23354":142592,"_30763":142593,"_3518":65097},[],"/docs/pr-preview/pr-58/es/platform/pqc/limitations#dashboard",{"_4070":84556,"_34195":84550,"_5":34623,"_23354":142595,"_30763":142596,"_3518":142597},[],"/docs/pr-preview/pr-58/es/platform/pqc/limitations#compilación-y-despliegue","Compilación y despliegue",{"_4070":84557,"_34195":84550,"_23354":142599,"_5":16137,"_30763":84550,"_3518":142600},[],"Esta página reúne los límites de la implementación actual para valorarlos antes de planificar un despliegue. Cada uno se ha observado en el código o en las pruebas de las ramas descritas en esta sección.",{"_4070":84558,"_34195":84550,"_23354":142602,"_5":16137,"_30763":142581,"_3518":142603},[],"Los certificados composite siguen el RFC 10073. La implementación se escribió contra el borrador 19 y supera los vectores de prueba del RFC, pero no ha pasado una evaluación completa de conformidad. Tres de sus algoritmos (las dos variantes Brainpool y Ed448) no están implementados. Los esquemas de firma composite en TLS usan puntos de código de uso privado de `0xFE00` a `0xFE0E` porque IANA no ha asignado ninguno, por lo que solo interoperan con pares construidos con el mismo fork de Go. Las variantes composite con RSA PKCS#1 v1.5 no pueden autenticar un handshake TLS. SLH-DSA no tiene esquema de firma TLS. El atributo de solicitud de certificado relacionado no se ha contrastado con otras implementaciones del RFC 9763.",{"_4070":84559,"_34195":84550,"_23354":142605,"_5":16137,"_30763":142585,"_3518":142606},[],"Las claves poscuánticas, composite y Ed25519 funcionan solo con los motores filesystem y software. Los motores Vault KV2 y AWS Secrets Manager anuncian soporte y después fallan en la creación, y AWS KMS, Azure y PKCS#11 no las soportan. No existe, por tanto, ninguna clave poscuántica respaldada por hardware o por un KMS en la nube. Algunos mensajes de error de los motores están copiados de otros motores y nombran el motor equivocado.",{"_4070":84560,"_34195":84550,"_23354":142608,"_5":16137,"_30763":142585,"_3518":142609},[],"La interfaz `CryptoEngine` ha incorporado métodos para crear e importar cada nuevo tipo de clave. Los motores desarrollados fuera del repositorio de Lamassu deben implementarlos.",{"_4070":84561,"_34195":84550,"_23354":142611,"_5":16137,"_30763":142589,"_3518":142612},[],"Una CA con clave poscuántica, Ed25519 o composite no puede firmar respuestas OCSP, porque la biblioteca de firma solo admite RSA y ECDSA. Se espera que la generación de CRL funcione, ya que usa la firma del fork, pero ni CRL ni OCSP tienen pruebas con estas claves.",{"_4070":84562,"_34195":84550,"_23354":142614,"_5":16137,"_30763":142589,"_3518":142615},[],"Los perfiles de emisión no pueden permitir ni denegar algoritmos poscuánticos; su aplicación de restricciones afecta solo a RSA y ECDSA. La fortaleza de clave de un certificado emitido solo se calcula para RSA y ECDSA, por lo que los demás certificados se almacenan con tipo y tamaño desconocidos y fortaleza baja. No está soportada la importación de una CA existente con clave SLH-DSA o composite.",{"_4070":84563,"_34195":84550,"_23354":142617,"_5":16137,"_30763":142589,"_3518":142618},[],"El DMS solo puede generar claves en el servidor para RSA y ECDSA, de modo que `serverkeygen` no puede devolver una clave poscuántica. Los flujos de enrolamiento por EST y por el device manager no tienen pruebas con claves poscuánticas.",{"_4070":84564,"_34195":84550,"_23354":142620,"_5":16137,"_30763":142589,"_3518":142621},[],"El backend no evalúa la extensión de certificado relacionado. Solo la emite.",{"_4070":84565,"_34195":84550,"_23354":142623,"_5":16137,"_30763":142593,"_3518":142624},[],"El generador de claves SLH-DSA del navegador asigna los identificadores de conjunto de parámetros de forma distinta al resto de la interfaz, según se describe en Dashboard. Los nombres de los tipos de clave no son uniformes entre pantallas, y la interfaz no incluye aviso de carácter experimental ni traducción.",{"_4070":84566,"_34195":84550,"_23354":142626,"_5":16137,"_30763":142596,"_3518":142627},[],"Todo depende de forks de Go y de Traefik que no son los proyectos originales, y la imagen del proxy tiene una etiqueta mutable. La especificación OpenAPI del KMS del backend sigue listando solo RSA, ECDSA y Ed25519 y no refleja los nuevos tipos de clave.",{"_4070":84567,"_34195":84550,"_23354":142629,"_5":16137,"_30763":142596,"_3518":142630},[],"El Helm chart usa nombres de recurso fijos, admite una sola release por espacio de nombres y envía el tráfico de Traefik a Envoy sin verificar certificados. Los certificados poscuánticos que crea el instalador son válidos durante 365 días y no se renuevan. El instalador necesita un host Linux y ejecuta una instalación de Helm, no una actualización.",{"_4070":84568,"_34195":84550,"_23354":142632,"_5":16137,"_30763":142596,"_3518":142633},[],"<Card title=\"Visión general de la criptografía poscuántica\" description=\"Volver al resumen de la sección.\" href=\"/docs/platform/pqc/overview\" />",{"_4070":84569,"_34195":84569,"_5":16540,"_3518":142635,"_34626":142636,"_23354":142637,"_30763":84569},"Visión general de la criptografía poscuántica",[56672,134827,141212],[],{"_4070":84570,"_34195":84569,"_23354":142639,"_5":16137,"_30763":84569,"_3518":142640},[],"Qué soporte poscuántico (PQC) añade Lamassu a las claves, las autoridades de certificación, el TLS de los dispositivos y el despliegue, y cómo encajan sus piezas.",{"_4070":84571,"_34195":84569,"_5":34623,"_23354":142642,"_30763":142643,"_3518":142644},[],"/docs/pr-preview/pr-58/es/platform/pqc/overview#por-qué-importa-en-flotas-de-dispositivos","Por qué importa en flotas de dispositivos",{"_4070":84572,"_34195":84569,"_5":34623,"_23354":142646,"_30763":142647,"_3518":142648},[],"/docs/pr-preview/pr-58/es/platform/pqc/overview#tres-familias-de-algoritmos","Tres familias de algoritmos",{"_4070":84573,"_34195":84569,"_5":34623,"_23354":142650,"_30763":142651,"_3518":142652},[],"/docs/pr-preview/pr-58/es/platform/pqc/overview#cómo-encajan-las-piezas","Cómo encajan las piezas",{"_4070":84574,"_34195":84569,"_5":34623,"_23354":142654,"_30763":142655,"_3518":142656},[],"/docs/pr-preview/pr-58/es/platform/pqc/overview#por-dónde-continuar","Por dónde continuar",{"_4070":84575,"_34195":84569,"_23354":142658,"_5":16137,"_30763":84569,"_3518":142659},[],"Lamassu puede crear claves, autoridades de certificación (CA) y certificados que usan algoritmos de firma poscuánticos, y puede servirlos y verificarlos por TLS. El trabajo abarca cinco bases de código que dependen unas de otras: un fork del toolchain de Go que implementa los algoritmos, el backend de Lamassu, el dashboard web, un fork del proxy Traefik que termina el TLS de los dispositivos y el Helm chart que despliega todo junto.",{"_4070":84576,"_34195":84569,"_23354":142661,"_5":16137,"_30763":84569,"_3518":142662},[],"El soporte PQC reside en ramas de desarrollo y en forks de Go y Traefik, no en los proyectos originales ni en las imágenes estándar de Lamassu. Los esquemas de firma TLS composite usan puntos de código de uso privado que ninguna otra pila TLS reconoce, y el formato de certificado composite sigue el RFC 10073, un estándar reciente con poca experiencia de despliegue todavía. Conviene planificar pilotos y despliegues de laboratorio, no flotas en producción. Limitaciones conocidas recoge lo que está incompleto.",{"_4070":84577,"_34195":84569,"_23354":142664,"_5":16137,"_30763":142643,"_3518":142665},[],"Los certificados emitidos a dispositivos suelen durar años, y los dispositivos que los almacenan son difíciles de sustituir. Un algoritmo de firma que un futuro ordenador cuántico llegase a romper obligaría a re-enrolar toda la flota. Emitir hoy certificados firmados con un algoritmo poscuántico o composite, y ofrecer un endpoint TLS que los acepte, permite validar la flota frente a ese riesgo antes de que sea urgente. Las firmas no están expuestas a ataques de tipo «almacenar ahora, descifrar después» como lo está un intercambio de claves, por lo que la urgencia depende de la vida útil de los certificados y de los dispositivos, no del tráfico registrado.",{"_4070":84578,"_34195":84569,"_23354":142667,"_5":16137,"_30763":142647,"_3518":142668},[],"Lamassu agrupa los algoritmos de firma en tres familias, con las mismas etiquetas que muestra el dashboard.",{"_4070":84579,"_34195":84569,"_23354":142670,"_5":16137,"_30763":142647,"_3518":142671},[],"Etiqueta",{"_4070":84580,"_34195":84569,"_23354":142673,"_5":16137,"_30763":142647,"_3518":141423},[],{"_4070":84581,"_34195":84569,"_23354":142675,"_5":16137,"_30763":142647,"_3518":141210},[],{"_4070":84582,"_34195":84569,"_23354":142677,"_5":16137,"_30763":142647,"_3518":65635},[],{"_4070":84583,"_34195":84569,"_23354":142679,"_5":16137,"_30763":142647,"_3518":142680},[],"Tradicional",{"_4070":84584,"_34195":84569,"_23354":142682,"_5":16137,"_30763":142647,"_3518":66282},[],{"_4070":84585,"_34195":84569,"_23354":142684,"_5":16137,"_30763":142647,"_3518":65647},[],{"_4070":84586,"_34195":84569,"_23354":142686,"_5":16137,"_30763":142647,"_3518":142687},[],"Poscuántica pura",{"_4070":84587,"_34195":84569,"_23354":142689,"_5":16137,"_30763":142647,"_3518":66290},[],{"_4070":84588,"_34195":84569,"_23354":142691,"_5":16137,"_30763":142647,"_3518":65659},[],{"_4070":84589,"_34195":84569,"_23354":142693,"_5":16137,"_30763":142647,"_3518":142694},[],"Híbrida (composite)",{"_4070":84590,"_34195":84569,"_23354":142696,"_5":16137,"_30763":142647,"_3518":142697},[],"ML-DSA combinado con RSA, ECDSA o Ed25519 en una única clave y una única firma",{"_4070":84591,"_34195":84569,"_23354":142699,"_5":16137,"_30763":142647,"_3518":142700},[],"Una firma composite solo es válida si se verifican sus dos componentes. Está pensada para que no sea falsificable mientras al menos uno de los dos algoritmos siga sin romperse, siempre que la parte que confía exija el composite y no recurra a un certificado clásico. En el intercambio de claves, `PQ/T` significa un grupo híbrido que combina un intercambio clásico y uno ML-KEM, y `PQ` significa ML-KEM puro. Algoritmos describe cada uno y los conjuntos de parámetros que Lamassu acepta.",{"_4070":84592,"_34195":84569,"_23354":142702,"_5":16137,"_30763":142651,"_3518":142703},[],"El fork de Go es la base: el backend y Traefik se compilan con él, porque el toolchain estándar de Go no incluye el soporte de certificados composite y SLH-DSA. El backend crea y custodia las claves, emite certificados y firma los datos de revocación. El dashboard usa la misma API REST. Los dispositivos llegan a la plataforma a través de Traefik, que negocia con ellos la autenticación y el intercambio de claves poscuánticos y después reenvía la petición a Envoy Gateway mediante TLS ordinario. La protección poscuántica se aplica, por tanto, solo al salto entre el dispositivo y Traefik.",{"_4070":84593,"_34195":84569,"_23354":142705,"_5":16137,"_30763":142655,"_3518":142706},[],"Conviene leer primero Algoritmos para conocer qué se soporta y cómo se escriben los conjuntos de parámetros en las peticiones a la API. Quien desarrolle un cliente de dispositivo debe seguir con Toolchain de Go PQC. Para crear una CA poscuántica, el camino es Claves y autoridades de certificación, y quien despliegue la plataforma consultará Despliegue con el Helm chart.",{"_4070":84594,"_34195":84569,"_23354":142708,"_5":16137,"_30763":142655,"_3518":142709},[],"<Card title=\"Algoritmos\" description=\"ML-DSA, SLH-DSA y los 15 algoritmos composite, con sus conjuntos de parámetros.\" href=\"/docs/platform/pqc/algorithms\" />",{"_4070":84595,"_34195":84569,"_23354":142711,"_5":16137,"_30763":142655,"_3518":142712},[],"<Card title=\"Claves y autoridades de certificación\" description=\"Crear claves y CA poscuánticas y emitir certificados mediante la API.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_4070":84596,"_34195":84569,"_23354":142714,"_5":16137,"_30763":142655,"_3518":142715},[],"<Card title=\"Despliegue con el Helm chart\" description=\"Instalar la plataforma con un proxy Traefik que sirve certificados PQC.\" href=\"/docs/platform/pqc/deployment\" />",{"_4070":84597,"_34195":84597,"_5":16540,"_3518":141599,"_34626":142717,"_23354":142718,"_30763":84597},[56672,134827,141212,141579],[],{"_4070":84598,"_34195":84597,"_23354":142720,"_5":16137,"_30763":84597,"_3518":142721},[],"Vincular un certificado con clave poscuántica a un certificado clásico existente del mismo dispositivo, según el RFC 9763, y cómo los emite y comprueba Lamassu.",{"_4070":84599,"_34195":84597,"_5":34623,"_23354":142723,"_30763":142724,"_3518":142725},[],"/docs/pr-preview/pr-58/es/platform/pqc/related-certificates#cómo-funciona-la-solicitud","Cómo funciona la solicitud",{"_4070":84600,"_34195":84597,"_5":34623,"_23354":142727,"_30763":142728,"_3518":142729},[],"/docs/pr-preview/pr-58/es/platform/pqc/related-certificates#ubicaciones-desde-las-que-la-ca-puede-descargar","Ubicaciones desde las que la CA puede descargar",{"_4070":84601,"_34195":84597,"_5":34623,"_23354":142731,"_30763":142732,"_3518":142733},[],"/docs/pr-preview/pr-58/es/platform/pqc/related-certificates#configurar-un-perfil-de-emisión","Configurar un perfil de emisión",{"_4070":84602,"_34195":84597,"_5":34623,"_23354":142735,"_30763":142736,"_3518":142737},[],"/docs/pr-preview/pr-58/es/platform/pqc/related-certificates#qué-debe-cumplir-el-certificado-emitido","Qué debe cumplir el certificado emitido",{"_4070":84603,"_34195":84597,"_5":34623,"_23354":142739,"_30763":142740,"_3518":142741},[],"/docs/pr-preview/pr-58/es/platform/pqc/related-certificates#desde-el-dashboard","Desde el dashboard",{"_4070":84604,"_34195":84597,"_23354":142743,"_5":16137,"_30763":84597,"_3518":142744},[],"Una flota que migra a algoritmos poscuánticos suele mantener durante un tiempo dos certificados por dispositivo: el clásico que ya se usa y uno nuevo con clave poscuántica. El RFC 9763 define una forma de enlazarlos. El certificado nuevo lleva la extensión `id-pe-relatedCert` (`1.3.6.1.5.5.7.1.36`), que contiene un hash del certificado clásico, de modo que una parte que confía puede comprobar que ambos identifican a la misma entidad. Lamassu implementa el lado emisor de este mecanismo.",{"_4070":84605,"_34195":84597,"_23354":142746,"_5":16137,"_30763":84597,"_3518":142747},[],"Esta opción encaja cuando:",{"_4070":84606,"_34195":84597,"_23354":142749,"_5":16137,"_30763":84597,"_3518":142750},[],"los consumidores aún no pueden validar cadenas poscuánticas o composite, por lo que el certificado clásico debe seguir siendo el que se usa;",{"_4070":84607,"_34195":84597,"_23354":142752,"_5":16137,"_30763":84597,"_3518":142753},[],"un dispositivo tiene que llevar ambos certificados y demostrar que van juntos, usando cada uno donde el interlocutor lo admita.",{"_4070":84608,"_34195":84597,"_23354":142755,"_5":16137,"_30763":84597,"_3518":142756},[],"El hash es SHA-256, SHA-384 o SHA-512, según el hash del algoritmo de firma del certificado relacionado, y SHA-256 si este no tiene ninguno.",{"_4070":84609,"_34195":84597,"_23354":142758,"_5":16137,"_30763":142724,"_3518":142759},[],"El dispositivo solicita el certificado vinculado con una solicitud PKCS#10 ordinaria que incluye un atributo adicional, `relatedCertRequest` (`1.2.840.113549.1.9.16.2.60`). El atributo identifica el certificado existente por emisor y número de serie, indica la hora de la solicitud, indica la ubicación desde la que puede descargarse el certificado y lleva una firma realizada con la clave privada de ese certificado existente. La firma cubre el emisor, el número de serie y la hora de la solicitud, no la ubicación, y demuestra que quien solicita controla la clave existente; la clave del nuevo certificado se prueba con la firma de la propia solicitud de certificado. Lamassu acepta una lista de ubicaciones, como en el módulo ASN.1 del RFC, y las prueba en orden.",{"_4070":84610,"_34195":84597,"_23354":142761,"_5":16137,"_30763":142724,"_3518":142762},[],"Cuando el servicio de CA recibe una solicitud así, sigue estos pasos:",{"_4070":84611,"_34195":84597,"_23354":142764,"_5":16137,"_30763":142724,"_3518":142765},[],"Comprueba que el perfil de emisión en uso habilita los certificados relacionados y, en caso contrario, rechaza la solicitud.",{"_4070":84612,"_34195":84597,"_23354":142767,"_5":16137,"_30763":142724,"_3518":142768},[],"Recorre en orden las ubicaciones del atributo y descarga el primer certificado que logra obtener.",{"_4070":84613,"_34195":84597,"_23354":142770,"_5":16137,"_30763":142724,"_3518":142771},[],"Verifica que el emisor y el número de serie coinciden, que la hora de la solicitud está dentro de la antigüedad permitida y que la firma es válida con la clave del certificado descargado.",{"_4070":84614,"_34195":84597,"_23354":142773,"_5":16137,"_30763":142724,"_3518":142774},[],"Emite el nuevo certificado con la extensión de certificado relacionado añadida.",{"_4070":84615,"_34195":84597,"_23354":142776,"_5":16137,"_30763":142724,"_3518":142777},[],"Una solicitud sin el atributo se procesa con normalidad, tanto si el perfil habilita la función como si no.",{"_4070":84616,"_34195":84597,"_23354":142779,"_5":16137,"_30763":142728,"_3518":142780},[],"Una ubicación es un URI `data:` o una URL `http` o `https`. Un URI `data:` debe estar codificado en base64 y contiene una estructura PKCS#7 cuyo primer certificado es el relacionado; no requiere acceso a la red y siempre se acepta cuando la función está habilitada. Una URL solo se descarga si su host figura en la lista de hosts permitidos del perfil. La CA no sigue redirecciones, aplica un tiempo de espera de diez segundos y rechaza respuestas de más de 1 MiB.",{"_4070":84617,"_34195":84597,"_23354":142782,"_5":16137,"_30763":142728,"_3518":142783},[],"Como la descarga la realiza el servidor, quien puede definir un perfil de emisión decide a qué hosts puede conectarse la CA. Conviene restringir ese permiso en consecuencia e incluir solo repositorios internos de certificados.",{"_4070":84618,"_34195":84597,"_23354":142785,"_5":16137,"_30763":142732,"_3518":142786},[],"La función se configura en el objeto `related_certificate` del perfil de emisión, que se almacena en columnas propias de la base de datos:",{"_4070":84619,"_34195":84597,"_23354":142788,"_5":16137,"_30763":142732,"_3518":141709},[],{"_4070":84620,"_34195":84597,"_23354":142790,"_5":16137,"_30763":142732,"_3518":137441},[],{"_4070":84621,"_34195":84597,"_23354":142792,"_5":16137,"_30763":142732,"_3518":141714},[],{"_4070":84622,"_34195":84597,"_23354":142794,"_5":16137,"_30763":142732,"_3518":137447},[],{"_4070":84623,"_34195":84597,"_23354":142796,"_5":16137,"_30763":142732,"_3518":66399},[],{"_4070":84624,"_34195":84597,"_23354":142798,"_5":16137,"_30763":142732,"_3518":113460},[],{"_4070":84625,"_34195":84597,"_23354":142800,"_5":16137,"_30763":142732,"_3518":65249},[],{"_4070":84626,"_34195":84597,"_23354":142802,"_5":16137,"_30763":142732,"_3518":142803},[],"Con `false`, se rechaza una solicitud que lleve el atributo.",{"_4070":84627,"_34195":84597,"_23354":142805,"_5":16137,"_30763":142732,"_3518":66409},[],{"_4070":84628,"_34195":84597,"_23354":142807,"_5":16137,"_30763":142732,"_3518":142808},[],"lista de cadenas",{"_4070":84629,"_34195":84597,"_23354":142810,"_5":16137,"_30763":142732,"_3518":142811},[],"vacía",{"_4070":84630,"_34195":84597,"_23354":142813,"_5":16137,"_30763":142732,"_3518":142814},[],"Hosts desde los que se pueden descargar ubicaciones `http` y `https`.",{"_4070":84631,"_34195":84597,"_23354":142816,"_5":16137,"_30763":142732,"_3518":66420},[],{"_4070":84632,"_34195":84597,"_23354":142818,"_5":16137,"_30763":142732,"_3518":142819},[],"duración",{"_4070":84633,"_34195":84597,"_23354":142821,"_5":16137,"_30763":142732,"_3518":66425},[],{"_4070":84634,"_34195":84597,"_23354":142823,"_5":16137,"_30763":142732,"_3518":142824},[],"Diferencia máxima entre la hora de la solicitud del atributo y el momento de la emisión.",{"_4070":84635,"_34195":84597,"_23354":142826,"_5":16137,"_30763":142736,"_3518":142827},[],"El fork se niega a vincular un certificado salvo que el nuevo sea compatible con el relacionado. Ninguno de los dos puede ser una CA. El certificado relacionado debe estar vigente en el momento de la emisión. Los usos de clave y los usos extendidos de clave solicitados para el nuevo certificado deben ser un subconjunto de los del certificado relacionado. La verificación posterior compara únicamente el hash, de modo que una parte que confía y comprueba el enlace averigua que la CA emisora vinculó el nuevo certificado a ese certificado concreto, no que el certificado relacionado siga siendo válido.",{"_4070":84636,"_34195":84597,"_23354":142829,"_5":16137,"_30763":142736,"_3518":142830},[],"La extensión es una prueba de relación, no una dependencia. Quien confía en ellos debe seguir validando cada certificado con su propia cadena y estado de revocación, y revocar el certificado clásico no revoca el vinculado.",{"_4070":84637,"_34195":84597,"_23354":142832,"_5":16137,"_30763":142740,"_3518":142833},[],"El dashboard expone la función en dos lugares. El formulario del perfil de emisión tiene una sección *Related Certificates* con un interruptor, los hosts permitidos y la antigüedad máxima. Al emitir un certificado desde una CA con una clave generada en el navegador y un perfil que habilita la función, el formulario ofrece *Bind to a related certificate*: quien emite aporta el certificado existente, o su emisor y número de serie, firma los datos mostrados con la clave existente fuera del navegador y pega la firma. Los detalles de certificados y CA muestran una fila *Related Certificate* con el algoritmo de hash y el valor. Véase Dashboard.",{"_4070":84638,"_34195":84597,"_23354":142835,"_5":16137,"_30763":142740,"_3518":142836},[],"El certificado vinculado se crea con `CreateBoundCertificate` del fork, cuyas pruebas cubren una clave ML-DSA vinculada a certificados RSA, ECDSA y Ed25519. Las pruebas no usan claves composite. Solo el lado emisor está implementado en Lamassu: la plataforma no evalúa la extensión cuando valida certificados.",{"_4070":84639,"_34195":84597,"_23354":142838,"_5":16137,"_30763":142740,"_3518":142839},[],"<Card title=\"Claves y autoridades de certificación\" description=\"Crear la CA poscuántica que emite el certificado vinculado.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_4070":84640,"_34195":84597,"_23354":142841,"_5":16137,"_30763":142740,"_3518":142842},[],"<Card title=\"Limitaciones conocidas\" description=\"Lo que todavía no está cubierto.\" href=\"/docs/platform/pqc/limitations\" />",{"_4070":84641,"_34195":84641,"_5":16540,"_3518":142844,"_34626":142845,"_23354":142846,"_30763":84641},"Proxy TLS con Traefik",[56672,134827,141212,133396],[],{"_4070":84642,"_34195":84641,"_23354":142848,"_5":16137,"_30763":84641,"_3518":142849},[],"El fork de Traefik que termina el TLS de los dispositivos con certificados clásicos y poscuánticos para el mismo host, cómo elige certificado y cómo se compila.",{"_4070":84643,"_34195":84641,"_5":34623,"_23354":142851,"_30763":142852,"_3518":142853},[],"/docs/pr-preview/pr-58/es/platform/pqc/tls-front-proxy#varios-certificados-para-el-mismo-host","Varios certificados para el mismo host",{"_4070":84644,"_34195":84641,"_5":34623,"_23354":142855,"_30763":142856,"_3518":142857},[],"/docs/pr-preview/pr-58/es/platform/pqc/tls-front-proxy#opciones-tls-en-listeners-de-gateway-api","Opciones TLS en listeners de Gateway API",{"_4070":84645,"_34195":84641,"_5":34623,"_23354":142859,"_30763":142860,"_3518":142861},[],"/docs/pr-preview/pr-58/es/platform/pqc/tls-front-proxy#tls-mutuo","TLS mutuo",{"_4070":84646,"_34195":84641,"_5":34623,"_23354":142863,"_30763":142864,"_3518":142865},[],"/docs/pr-preview/pr-58/es/platform/pqc/tls-front-proxy#compilación-del-proxy","Compilación del proxy",{"_4070":84647,"_34195":84641,"_23354":142867,"_5":16137,"_30763":84641,"_3518":142868},[],"Los dispositivos se conectan a Lamassu por TLS, y el enrolamiento EST se apoya en TLS mutuo. Para aceptar un certificado poscuántico o composite en esa conexión, el endpoint TLS debe compilarse con el toolchain de Go PQC. Lamassu lo hace con un fork de Traefik, basado en Traefik 3.7.15, situado delante de Envoy Gateway. El fork añade dos comportamientos: puede servir varios certificados para el mismo host y elegir entre ellos según el cliente, y permite que un listener de Gateway API haga referencia a una opción TLS de Traefik.",{"_4070":84648,"_34195":84641,"_23354":142870,"_5":16137,"_30763":142852,"_3518":142871},[],"Traefik original conserva un certificado por conjunto de nombres. Si existen un certificado ECDSA clásico y un certificado ML-DSA para `lab.example.com`, solo se conserva el primero. El fork almacena cada certificado distinto (los duplicados se detectan comparando el certificado hoja) y elige uno en cada handshake.",{"_4070":84649,"_34195":84641,"_23354":142873,"_5":16137,"_30763":142852,"_3518":142874},[],"La elección sigue los algoritmos de firma que anuncia el cliente:",{"_4070":84650,"_34195":84641,"_23354":142876,"_5":16137,"_30763":142852,"_3518":142877},[],"Se normaliza el nombre de servidor del cliente y se reúnen los certificados cuyos nombres coinciden, con los nombres exactos por delante de los comodines. Un certificado con solo Common Name sigue coincidiendo.",{"_4070":84651,"_34195":84641,"_23354":142879,"_5":16137,"_30763":142852,"_3518":142880},[],"Si ningún certificado coincide, la conexión se cierra en modo SNI estricto, o se sirve el certificado por defecto.",{"_4070":84652,"_34195":84641,"_23354":142882,"_5":16137,"_30763":142852,"_3518":142883},[],"Si coincide exactamente un certificado, se sirve sin más comprobaciones.",{"_4070":84653,"_34195":84641,"_23354":142885,"_5":16137,"_30763":142852,"_3518":142886},[],"En otro caso, el proxy toma los esquemas de firma del cliente en el orden en que los envió y, para cada esquema, devuelve el primer certificado cuya clave permiten el esquema, la versión de TLS y el tipo de clave. Así se contrasta la clave hoja con `signature_algorithms`, los esquemas que el cliente acepta para la firma del handshake; las firmas del resto de la cadena son una comprobación distinta, frente a `signature_algorithms_cert`.",{"_4070":84654,"_34195":84641,"_23354":142888,"_5":16137,"_30763":142852,"_3518":142889},[],"Si el cliente no anuncia ningún esquema, se devuelve el primer certificado compatible. Si ninguno es compatible, se devuelve el primer candidato y el handshake falla con el error subyacente.",{"_4070":84655,"_34195":84641,"_23354":142891,"_5":16137,"_30763":142852,"_3518":142892},[],"Prevalece el orden de preferencia del cliente: un cliente que lista ML-DSA primero recibe el certificado poscuántico y uno que lista ECDSA primero recibe el clásico, aunque también soporte ML-DSA. Un cliente sin soporte poscuántico nunca anuncia esos esquemas y recibe el certificado clásico. TLS 1.2 nunca selecciona certificados ML-DSA ni composite. El servidor no puede configurarse con un orden de preferencia propio.",{"_4070":84656,"_34195":84641,"_23354":142894,"_5":16137,"_30763":142856,"_3518":142895},[],"Traefik lee su configuración de Gateway API desde Kubernetes. El fork lee la opción de listener `traefik.io/tls-options`, cuyo valor nombra la opción TLS que se aplica a ese listener: `default`, o un nombre cualificado como `traefik-system-pqc@kubernetescrd`. Funciona en listeners HTTPS y en listeners TLS en modo `Terminate` que sirven un `TLSRoute`. Se ignora en modo passthrough.",{"_4070":84657,"_34195":84641,"_23354":142897,"_5":16137,"_30763":142856,"_3518":142898},[],"En una opción TLS se establecen los grupos de intercambio de claves soportados y el modo de autenticación de cliente. Cuando varios listeners comparten un router padre y nombran opciones distintas, el proxy registra una advertencia y usa valores por defecto aislados para cada uno. Sin el fork, Traefik ignora la anotación, aplica sus propios valores por defecto y los ajustes no se pueden controlar; los dispositivos que necesitan TLS mutuo fallan entonces.",{"_4070":84658,"_34195":84641,"_23354":142900,"_5":16137,"_30763":142856,"_3518":142901},[],"El fork añade además `mlkem1024` a los nombres de grupo aceptados en `curvePreferences`, junto a los grupos híbridos que Traefik ya reconoce.",{"_4070":84659,"_34195":84641,"_23354":142903,"_5":16137,"_30763":142860,"_3518":142904},[],"La autenticación de cliente es el mecanismo estándar de Traefik, configurado en la opción TLS. Con `RequireAndVerifyClientCert` y un fichero de CA de cliente, el proxy valida la cadena, y la verificación de la firma del cliente la realiza la pila TLS del fork de Go, que se ha probado con certificados de cliente composite en un handshake TLS 1.3. Con `RequestClientCert`, que es lo que establece el chart de Lamassu en su opción por defecto, el proxy comprueba que el cliente posee la clave del certificado que presenta, pero no valida la cadena; la decisión se delega en el backend, que recibe el certificado en una cabecera (véase Despliegue con el Helm chart). Ninguna prueba de Traefik cubre el TLS mutuo poscuántico, y una cadena de cliente firmada por una CA composite o poscuántica depende del código x509 del fork.",{"_4070":84660,"_34195":84641,"_23354":142906,"_5":16137,"_30763":142864,"_3518":142907},[],"El fork no se compila desde la imagen de Go. El script `build.sh` exige una copia ya compilada del fork de Go, por defecto en `../go`, y comprueba que es el fork antes de forzar `GOROOT` y `GOTOOLCHAIN=local`. Compila el binario con `CGO_ENABLED=0`, genera la interfaz web salvo que se indique `SKIP_WEBUI=1` y empaqueta el binario en una imagen Alpine con `docker buildx`. La imagen por defecto es `ghcr.io/lamassuiot/traefik:pqc-3.7.15`.",{"_4070":84661,"_34195":84641,"_23354":142909,"_5":16137,"_30763":142864,"_3518":66514},[],{"_4070":84662,"_34195":84641,"_23354":142911,"_5":16137,"_30763":142864,"_3518":142912},[],"Finalidad",{"_4070":84663,"_34195":84641,"_23354":142914,"_5":16137,"_30763":142864,"_3518":66519},[],{"_4070":84664,"_34195":84641,"_23354":142916,"_5":16137,"_30763":142864,"_3518":142917},[],"Ubicación del fork de Go compilado.",{"_4070":84665,"_34195":84641,"_23354":142919,"_5":16137,"_30763":142864,"_3518":66525},[],{"_4070":84666,"_34195":84641,"_23354":142921,"_5":16137,"_30763":142864,"_3518":142922},[],"Plataformas de destino; por defecto `linux/amd64`.",{"_4070":84667,"_34195":84641,"_23354":142924,"_5":16137,"_30763":142864,"_3518":66531},[],{"_4070":84668,"_34195":84641,"_23354":142926,"_5":16137,"_30763":142864,"_3518":142927},[],"Omite la generación de la interfaz web con el valor `1`.",{"_4070":84669,"_34195":84641,"_23354":142929,"_5":16137,"_30763":142864,"_3518":66537},[],{"_4070":84670,"_34195":84641,"_23354":142931,"_5":16137,"_30763":142864,"_3518":142932},[],"Nombre de la imagen y si se publica. Las compilaciones multiplataforma requieren `PUSH=1`.",{"_4070":84671,"_34195":84641,"_23354":142934,"_5":16137,"_30763":142864,"_3518":142935},[],"Las etiquetas `pqc-*` son mutables y se han reconstruido sobre sí mismas, por lo que en entornos próximos a producción conviene fijar el digest.",{"_4070":84672,"_34195":84641,"_23354":142937,"_5":16137,"_30763":142864,"_3518":142938},[],"Las pruebas de selección del fork usan ML-DSA-65 puro junto con ECDSA P-256. La selección de un certificado composite depende de que la pila TLS del fork conozca la clave composite, algo que ocurre, pero el proxy no tiene ninguna prueba para ello.",{"_4070":84673,"_34195":84641,"_23354":142940,"_5":16137,"_30763":142864,"_3518":142941},[],"<Card title=\"Despliegue con el Helm chart\" description=\"Instalar el proxy delante de Envoy Gateway con el chart.\" href=\"/docs/platform/pqc/deployment\" />",{"_4070":84674,"_34195":84641,"_23354":142943,"_5":16137,"_30763":142864,"_3518":142944},[],"<Card title=\"Limitaciones conocidas\" description=\"Interoperabilidad y advertencias operativas.\" href=\"/docs/platform/pqc/limitations\" />",{"_4070":84675,"_34195":84675,"_5":16540,"_3518":142946,"_34626":142947,"_23354":142948,"_30763":84675},"Seguridad",[56672],[],{"_4070":84676,"_34195":84675,"_23354":142950,"_5":16137,"_30763":84675,"_3518":142951},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_4070":84677,"_34195":84675,"_5":34623,"_23354":142953,"_30763":142954,"_3518":142955},[],"/docs/pr-preview/pr-58/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_4070":84678,"_34195":84675,"_5":34623,"_23354":142957,"_30763":142958,"_3518":142959},[],"/docs/pr-preview/pr-58/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_4070":84679,"_34195":84675,"_5":34623,"_23354":142961,"_30763":142962,"_3518":142963},[],"/docs/pr-preview/pr-58/es/security#versiones-soportadas","Versiones soportadas",{"_4070":84680,"_34195":84675,"_5":34623,"_23354":142965,"_30763":142966,"_3518":142967},[],"/docs/pr-preview/pr-58/es/security#divulgación-responsable","Divulgación responsable",{"_4070":84681,"_34195":84675,"_23354":142969,"_5":16137,"_30763":84675,"_3518":142970},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_4070":84682,"_34195":84675,"_23354":142972,"_5":16137,"_30763":142954,"_3518":142973},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_4070":84683,"_34195":84675,"_23354":142975,"_5":16137,"_30763":142954,"_3518":142976},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_4070":84684,"_34195":84675,"_23354":142978,"_5":16137,"_30763":142954,"_3518":16895},[],{"_4070":84685,"_34195":84675,"_23354":142980,"_5":16137,"_30763":142954,"_3518":16831},[],{"_4070":84686,"_34195":84675,"_23354":142982,"_5":16137,"_30763":142954,"_3518":16888},[],{"_4070":84687,"_34195":84675,"_23354":142984,"_5":16137,"_30763":142954,"_3518":142985},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_4070":84688,"_34195":84675,"_23354":142987,"_5":16137,"_30763":142954,"_3518":142988},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_4070":84689,"_34195":84675,"_23354":142990,"_5":16137,"_30763":142958,"_3518":142991},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_4070":84690,"_34195":84675,"_23354":142993,"_5":16137,"_30763":142958,"_3518":142994},[],"No incluyas en el reporte:",{"_4070":84691,"_34195":84675,"_23354":142996,"_5":16137,"_30763":142958,"_3518":142997},[],"Credenciales, tokens o claves privadas",{"_4070":84692,"_34195":84675,"_23354":142999,"_5":16137,"_30763":142958,"_3518":143000},[],"Datos de clientes o información identificable de clientes",{"_4070":84693,"_34195":84675,"_23354":143002,"_5":16137,"_30763":142958,"_3518":143003},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_4070":84694,"_34195":84675,"_23354":143005,"_5":16137,"_30763":142962,"_3518":143006},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_4070":84695,"_34195":84675,"_23354":143008,"_5":16137,"_30763":142962,"_3518":143009},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_4070":84696,"_34195":84675,"_23354":143011,"_5":16137,"_30763":142966,"_3518":143012},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_4070":84697,"_34195":84675,"_23354":143014,"_5":16137,"_30763":142966,"_3518":143015},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_4070":84698,"_34195":84675,"_23354":143017,"_5":16137,"_30763":142966,"_3518":143018},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_4070":84699,"_34195":84675,"_23354":143020,"_5":16137,"_30763":142966,"_3518":143021},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_4070":84700,"_34195":84675,"_23354":143023,"_5":16137,"_30763":142966,"_3518":143024},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_4070":84701,"_34195":84701,"_5":16540,"_3518":143026,"_34626":143027,"_23354":143029,"_30763":84701},"3.8.0 a 4.0.0",[56672,143028],"Actualizaciones",[],{"_4070":84702,"_34195":84701,"_23354":143031,"_5":16137,"_30763":84701,"_3518":143032},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_4070":84703,"_34195":84701,"_5":34623,"_23354":143034,"_30763":143035,"_3518":143036},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_4070":84704,"_34195":84701,"_5":34623,"_23354":143038,"_30763":143039,"_3518":143040},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_4070":84705,"_34195":84701,"_5":34623,"_23354":143042,"_30763":143043,"_3518":143044},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_4070":84706,"_34195":84701,"_5":34623,"_23354":143046,"_30763":143047,"_3518":143048},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_4070":84707,"_34195":84701,"_5":34623,"_23354":143050,"_30763":143051,"_3518":143052},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_4070":84708,"_34195":84701,"_5":34623,"_23354":143054,"_30763":143055,"_3518":143056},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_4070":84709,"_34195":84701,"_5":34623,"_23354":143058,"_30763":143059,"_3518":66668},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_4070":84710,"_34195":84701,"_5":34623,"_23354":143061,"_30763":143062,"_3518":143063},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_4070":84711,"_34195":84701,"_5":34623,"_23354":143065,"_30763":143066,"_3518":143067},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_4070":84712,"_34195":84701,"_5":34623,"_23354":143069,"_30763":143070,"_3518":143071},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_4070":84713,"_34195":84701,"_5":34623,"_23354":143073,"_30763":143074,"_3518":143075},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_4070":84714,"_34195":84701,"_5":34623,"_23354":143077,"_30763":143078,"_3518":143079},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_4070":84715,"_34195":84701,"_5":34623,"_23354":143081,"_30763":143082,"_3518":143083},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_4070":84716,"_34195":84701,"_5":34623,"_23354":143085,"_30763":143086,"_3518":143087},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_4070":84717,"_34195":84701,"_5":34623,"_23354":143089,"_30763":143090,"_3518":143091},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_4070":84718,"_34195":84701,"_5":34623,"_23354":143093,"_30763":143094,"_3518":143095},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_4070":84719,"_34195":84701,"_5":34623,"_23354":143097,"_30763":143098,"_3518":143099},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_4070":84720,"_34195":84701,"_5":34623,"_23354":143101,"_30763":143102,"_3518":143103},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_4070":84721,"_34195":84701,"_5":34623,"_23354":143105,"_30763":143106,"_3518":143107},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_4070":84722,"_34195":84701,"_5":34623,"_23354":143109,"_30763":143110,"_3518":143111},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-roles-va","Referencias entre certificados, claves y roles VA",{"_4070":84723,"_34195":84701,"_5":34623,"_23354":143113,"_30763":143114,"_3518":143115},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_4070":84724,"_34195":84701,"_5":34623,"_23354":143117,"_30763":143118,"_3518":143119},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_4070":84725,"_34195":84701,"_5":34623,"_23354":143121,"_30763":143122,"_3518":143123},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_4070":84726,"_34195":84701,"_5":34623,"_23354":143125,"_30763":143126,"_3518":143127},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_4070":84727,"_34195":84701,"_5":34623,"_23354":143129,"_30763":143130,"_3518":143131},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_4070":84728,"_34195":84701,"_5":34623,"_23354":143133,"_30763":143134,"_3518":143135},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_4070":84729,"_34195":84701,"_5":34623,"_23354":143137,"_30763":143138,"_3518":143139},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_4070":84730,"_34195":84701,"_5":34623,"_23354":143141,"_30763":143142,"_3518":143143},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#campo-firmante-del-rol-va","Campo firmante del rol VA",{"_4070":84731,"_34195":84701,"_5":34623,"_23354":143145,"_30763":143146,"_3518":143147},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_4070":84732,"_34195":84701,"_5":34623,"_23354":143149,"_30763":143150,"_3518":143151},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_4070":84733,"_34195":84701,"_5":34623,"_23354":143153,"_30763":143154,"_3518":143155},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_4070":84734,"_34195":84701,"_5":34623,"_23354":143157,"_30763":143158,"_3518":143159},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_4070":84735,"_34195":84701,"_5":34623,"_23354":143161,"_30763":143162,"_3518":143163},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_4070":84736,"_34195":84701,"_5":34623,"_23354":143165,"_30763":143166,"_3518":143167},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_4070":84737,"_34195":84701,"_5":34623,"_23354":143169,"_30763":143170,"_3518":143171},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_4070":84738,"_34195":84701,"_5":34623,"_23354":143173,"_30763":143174,"_3518":137345},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_4070":84739,"_34195":84701,"_5":34623,"_23354":143176,"_30763":143177,"_3518":143178},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_4070":84740,"_34195":84701,"_5":34623,"_23354":143180,"_30763":143181,"_3518":143182},[],"/docs/pr-preview/pr-58/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_4070":84741,"_34195":84701,"_23354":143184,"_5":16137,"_30763":84701,"_3518":143185},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_4070":84742,"_34195":84701,"_23354":143187,"_5":16137,"_30763":84701,"_3518":143188},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_4070":84743,"_34195":84701,"_23354":143190,"_5":16137,"_30763":84701,"_3518":143191},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_4070":84744,"_34195":84701,"_23354":143193,"_5":16137,"_30763":84701,"_3518":143194},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_4070":84745,"_34195":84701,"_23354":143196,"_5":16137,"_30763":84701,"_3518":143197},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_4070":84746,"_34195":84701,"_23354":143199,"_5":16137,"_30763":84701,"_3518":143200},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_4070":84747,"_34195":84701,"_23354":143202,"_5":16137,"_30763":84701,"_3518":143203},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_4070":84748,"_34195":84701,"_23354":143205,"_5":16137,"_30763":143039,"_3518":143206},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_4070":84749,"_34195":84701,"_23354":143208,"_5":16137,"_30763":143039,"_3518":143209},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_4070":84750,"_34195":84701,"_23354":143211,"_5":16137,"_30763":143043,"_3518":143212},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_4070":84751,"_34195":84701,"_23354":143214,"_5":16137,"_30763":143043,"_3518":143215},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_4070":84752,"_34195":84701,"_23354":143217,"_5":16137,"_30763":143047,"_3518":143218},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_4070":84753,"_34195":84701,"_23354":143220,"_5":16137,"_30763":143051,"_3518":143221},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_4070":84754,"_34195":84701,"_23354":143223,"_5":16137,"_30763":143051,"_3518":143224},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_4070":84755,"_34195":84701,"_23354":143226,"_5":16137,"_30763":143051,"_3518":143227},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_4070":84756,"_34195":84701,"_23354":143229,"_5":16137,"_30763":143051,"_3518":143230},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_4070":84757,"_34195":84701,"_23354":143232,"_5":16137,"_30763":143051,"_3518":143233},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_4070":84758,"_34195":84701,"_23354":143235,"_5":16137,"_30763":143055,"_3518":143236},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_4070":84759,"_34195":84701,"_23354":143238,"_5":16137,"_30763":143055,"_3518":143239},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_4070":84760,"_34195":84701,"_23354":143241,"_5":16137,"_30763":143055,"_3518":143242},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_4070":84761,"_34195":84701,"_23354":143244,"_5":16137,"_30763":143055,"_3518":143245},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_4070":84762,"_34195":84701,"_23354":143247,"_5":16137,"_30763":143055,"_3518":143248},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_4070":84763,"_34195":84701,"_23354":143250,"_5":16137,"_30763":143059,"_3518":143251},[],"Cambio",{"_4070":84764,"_34195":84701,"_23354":143253,"_5":16137,"_30763":143059,"_3518":143254},[],"A quién afecta",{"_4070":84765,"_34195":84701,"_23354":143256,"_5":16137,"_30763":143059,"_3518":143257},[],"Gravedad",{"_4070":84766,"_34195":84701,"_23354":143259,"_5":16137,"_30763":143059,"_3518":140050},[],{"_4070":84767,"_34195":84701,"_23354":143261,"_5":16137,"_30763":143059,"_3518":143067},[],{"_4070":84768,"_34195":84701,"_23354":143263,"_5":16137,"_30763":143059,"_3518":143264},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_4070":84769,"_34195":84701,"_23354":143266,"_5":16137,"_30763":143059,"_3518":143267},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_4070":84770,"_34195":84701,"_23354":143269,"_5":16137,"_30763":143059,"_3518":143270},[],"Copiar los datos a los volúmenes nuevos",{"_4070":84771,"_34195":84701,"_23354":143272,"_5":16137,"_30763":143059,"_3518":143071},[],{"_4070":84772,"_34195":84701,"_23354":143274,"_5":16137,"_30763":143059,"_3518":143275},[],"Todas las releases de Helm",{"_4070":84773,"_34195":84701,"_23354":143277,"_5":16137,"_30763":143059,"_3518":143278},[],"Alta: `helm upgrade` falla",{"_4070":84774,"_34195":84701,"_23354":143280,"_5":16137,"_30763":143059,"_3518":143281},[],"Eliminar o renombrar las claves heredadas",{"_4070":84775,"_34195":84701,"_23354":143283,"_5":16137,"_30763":143059,"_3518":143075},[],{"_4070":84776,"_34195":84701,"_23354":143285,"_5":16137,"_30763":143059,"_3518":143286},[],"Todos los despliegues",{"_4070":84777,"_34195":84701,"_23354":143288,"_5":16137,"_30763":143059,"_3518":143289},[],"Alta: sin principal de bootstrap no hay administrador",{"_4070":84778,"_34195":84701,"_23354":143291,"_5":16137,"_30763":143059,"_3518":143292},[],"Configurar `services.authz`",{"_4070":84779,"_34195":84701,"_23354":143294,"_5":16137,"_30763":143059,"_3518":143079},[],{"_4070":84780,"_34195":84701,"_23354":143296,"_5":16137,"_30763":143059,"_3518":143275},[],{"_4070":84781,"_34195":84701,"_23354":143298,"_5":16137,"_30763":143059,"_3518":143299},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_4070":84782,"_34195":84701,"_23354":143301,"_5":16137,"_30763":143059,"_3518":143302},[],"Mover JWKS y roles a `services.authz`",{"_4070":84783,"_34195":84701,"_23354":143304,"_5":16137,"_30763":143059,"_3518":143099},[],{"_4070":84784,"_34195":84701,"_23354":143306,"_5":16137,"_30763":143059,"_3518":143307},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_4070":84785,"_34195":84701,"_23354":143309,"_5":16137,"_30763":143059,"_3518":143310},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_4070":84786,"_34195":84701,"_23354":143312,"_5":16137,"_30763":143059,"_3518":143313},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_4070":84787,"_34195":84701,"_23354":143315,"_5":16137,"_30763":143059,"_3518":143103},[],{"_4070":84788,"_34195":84701,"_23354":143317,"_5":16137,"_30763":143059,"_3518":143318},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_4070":84789,"_34195":84701,"_23354":143320,"_5":16137,"_30763":143059,"_3518":143321},[],"Alta: el backend ya no arranca con ellos",{"_4070":84790,"_34195":84701,"_23354":143323,"_5":16137,"_30763":143059,"_3518":143324},[],"Pasar a PostgreSQL antes de actualizar",{"_4070":84791,"_34195":84701,"_23354":143326,"_5":16137,"_30763":143059,"_3518":143327},[],"Webhooks con referencias a archivos",{"_4070":84792,"_34195":84701,"_23354":143329,"_5":16137,"_30763":143059,"_3518":143330},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_4070":84793,"_34195":84701,"_23354":143332,"_5":16137,"_30763":143059,"_3518":143333},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_4070":84794,"_34195":84701,"_23354":143335,"_5":16137,"_30763":143059,"_3518":143336},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_4070":84795,"_34195":84701,"_23354":143338,"_5":16137,"_30763":143059,"_3518":143083},[],{"_4070":84796,"_34195":84701,"_23354":143340,"_5":16137,"_30763":143059,"_3518":143341},[],"Releases con identidades por servicio o material de claves montado",{"_4070":84797,"_34195":84701,"_23354":143343,"_5":16137,"_30763":143059,"_3518":143344},[],"Media: los servicios no pueden leer sus archivos",{"_4070":84798,"_34195":84701,"_23354":143346,"_5":16137,"_30763":143059,"_3518":143347},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_4070":84799,"_34195":84701,"_23354":143349,"_5":16137,"_30763":143059,"_3518":143087},[],{"_4070":84800,"_34195":84701,"_23354":143351,"_5":16137,"_30763":143059,"_3518":143352},[],"Releases que definen `amqp.tls`",{"_4070":84801,"_34195":84701,"_23354":143354,"_5":16137,"_30763":143059,"_3518":143355},[],"Media: los clientes se conectan al puerto equivocado",{"_4070":84802,"_34195":84701,"_23354":143357,"_5":16137,"_30763":143059,"_3518":143358},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_4070":84803,"_34195":84701,"_23354":143360,"_5":16137,"_30763":143059,"_3518":143107},[],{"_4070":84804,"_34195":84701,"_23354":143362,"_5":16137,"_30763":143059,"_3518":143363},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_4070":84805,"_34195":84701,"_23354":143365,"_5":16137,"_30763":143059,"_3518":143366},[],"Media: las claves de CA quedan sin gestionar",{"_4070":84806,"_34195":84701,"_23354":143368,"_5":16137,"_30763":143059,"_3518":143369},[],"Ejecutar la migración de CA a KMS",{"_4070":84807,"_34195":84701,"_23354":143371,"_5":16137,"_30763":143059,"_3518":143372},[],"Verificación del certificado del receptor",{"_4070":84808,"_34195":84701,"_23354":143374,"_5":16137,"_30763":143059,"_3518":143375},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_4070":84809,"_34195":84701,"_23354":143377,"_5":16137,"_30763":143059,"_3518":143378},[],"Media: las credenciales viajan a un receptor sin verificar",{"_4070":84810,"_34195":84701,"_23354":143380,"_5":16137,"_30763":143059,"_3518":143381},[],"Poner `insecure_skip_verify` a `false`",{"_4070":84811,"_34195":84701,"_23354":143383,"_5":16137,"_30763":143059,"_3518":143123},[],{"_4070":84812,"_34195":84701,"_23354":143385,"_5":16137,"_30763":143059,"_3518":143386},[],"Scripts y consolas que editan DMS por API",{"_4070":84813,"_34195":84701,"_23354":143388,"_5":16137,"_30763":143059,"_3518":143389},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_4070":84814,"_34195":84701,"_23354":143391,"_5":16137,"_30763":143059,"_3518":143392},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_4070":84815,"_34195":84701,"_23354":143394,"_5":16137,"_30763":143059,"_3518":143143},[],{"_4070":84816,"_34195":84701,"_23354":143396,"_5":16137,"_30763":143059,"_3518":143397},[],"Clientes que crean o actualizan roles VA por API",{"_4070":84817,"_34195":84701,"_23354":143399,"_5":16137,"_30763":143059,"_3518":143400},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_4070":84818,"_34195":84701,"_23354":143402,"_5":16137,"_30763":143059,"_3518":143403},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_certificate_serial_number`",{"_4070":84819,"_34195":84701,"_23354":143405,"_5":16137,"_30763":143059,"_3518":143139},[],{"_4070":84820,"_34195":84701,"_23354":143407,"_5":16137,"_30763":143059,"_3518":143408},[],"Consumidores que leen el campo `events` del dispositivo",{"_4070":84821,"_34195":84701,"_23354":143410,"_5":16137,"_30763":143059,"_3518":143411},[],"Media: el campo desaparece",{"_4070":84822,"_34195":84701,"_23354":143413,"_5":16137,"_30763":143059,"_3518":143414},[],"Usar los nuevos endpoints de eventos",{"_4070":84823,"_34195":84701,"_23354":143416,"_5":16137,"_30763":143059,"_3518":143091},[],{"_4070":84824,"_34195":84701,"_23354":143418,"_5":16137,"_30763":143059,"_3518":143419},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_4070":84825,"_34195":84701,"_23354":143421,"_5":16137,"_30763":143059,"_3518":143422},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_4070":84826,"_34195":84701,"_23354":143424,"_5":16137,"_30763":143059,"_3518":143425},[],"Actualizar el archivo de values",{"_4070":84827,"_34195":84701,"_23354":143427,"_5":16137,"_30763":143059,"_3518":143131},[],{"_4070":84828,"_34195":84701,"_23354":143429,"_5":16137,"_30763":143059,"_3518":143430},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_4070":84829,"_34195":84701,"_23354":143432,"_5":16137,"_30763":143059,"_3518":143433},[],"Baja: prevalece el ID de la URL",{"_4070":84830,"_34195":84701,"_23354":143435,"_5":16137,"_30763":143059,"_3518":143436},[],"Enviar el ID en la URL",{"_4070":84831,"_34195":84701,"_23354":143438,"_5":16137,"_30763":143059,"_3518":143135},[],{"_4070":84832,"_34195":84701,"_23354":143440,"_5":16137,"_30763":143059,"_3518":143441},[],"Consumidores que comparan el `type` del certificado",{"_4070":84833,"_34195":84701,"_23354":143443,"_5":16137,"_30763":143059,"_3518":143444},[],"Baja: dos valores cambian de nombre",{"_4070":84834,"_34195":84701,"_23354":143446,"_5":16137,"_30763":143059,"_3518":143447},[],"Adaptar los consumidores",{"_4070":84835,"_34195":84701,"_23354":143449,"_5":16137,"_30763":143059,"_3518":143127},[],{"_4070":84836,"_34195":84701,"_23354":143451,"_5":16137,"_30763":143059,"_3518":143452},[],"Cualquier DMS",{"_4070":84837,"_34195":84701,"_23354":143454,"_5":16137,"_30763":143059,"_3518":143455},[],"Baja: solo informativo",{"_4070":84838,"_34195":84701,"_23354":143457,"_5":16137,"_30763":143059,"_3518":143458},[],"Revisar ambos bloques antes de editar",{"_4070":84839,"_34195":84701,"_23354":143460,"_5":16137,"_30763":143066,"_3518":143461},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_4070":84840,"_34195":84701,"_23354":143463,"_5":16137,"_30763":143066,"_3518":143464},[],"El paso 4 de la guía de migración copia los datos.",{"_4070":84841,"_34195":84701,"_23354":143466,"_5":16137,"_30763":143070,"_3518":143467},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_4070":84842,"_34195":84701,"_23354":143469,"_5":16137,"_30763":143074,"_3518":143470},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_4070":84843,"_34195":84701,"_23354":143472,"_5":16137,"_30763":143078,"_3518":143473},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_4070":84844,"_34195":84701,"_23354":143475,"_5":16137,"_30763":143082,"_3518":143476},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_4070":84845,"_34195":84701,"_23354":143478,"_5":16137,"_30763":143082,"_3518":143479},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_4070":84846,"_34195":84701,"_23354":143481,"_5":16137,"_30763":143086,"_3518":143482},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_4070":84847,"_34195":84701,"_23354":143484,"_5":16137,"_30763":143090,"_3518":143485},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_4070":84848,"_34195":84701,"_23354":143487,"_5":16137,"_30763":143090,"_3518":143488},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_4070":84849,"_34195":84701,"_23354":143490,"_5":16137,"_30763":143090,"_3518":143491},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_4070":84850,"_34195":84701,"_23354":143493,"_5":16137,"_30763":143090,"_3518":143494},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_4070":84851,"_34195":84701,"_23354":143496,"_5":16137,"_30763":143090,"_3518":143497},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_4070":84852,"_34195":84701,"_23354":143499,"_5":16137,"_30763":143090,"_3518":143500},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_4070":84853,"_34195":84701,"_23354":143502,"_5":16137,"_30763":143098,"_3518":143503},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_4070":84854,"_34195":84701,"_23354":143505,"_5":16137,"_30763":143098,"_3518":143506},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_4070":84855,"_34195":84701,"_23354":143508,"_5":16137,"_30763":143098,"_3518":143509},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_4070":84856,"_34195":84701,"_23354":143511,"_5":16137,"_30763":143098,"_3518":143512},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_4070":84857,"_34195":84701,"_23354":143514,"_5":16137,"_30763":143098,"_3518":143515},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_4070":84858,"_34195":84701,"_23354":143517,"_5":16137,"_30763":143102,"_3518":143518},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_4070":84859,"_34195":84701,"_23354":143520,"_5":16137,"_30763":143106,"_3518":143521},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_4070":84860,"_34195":84701,"_23354":143523,"_5":16137,"_30763":143106,"_3518":143524},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_4070":84861,"_34195":84701,"_23354":143526,"_5":16137,"_30763":143106,"_3518":143527},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_4070":84862,"_34195":84701,"_23354":143529,"_5":16137,"_30763":143106,"_3518":143530},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_4070":84863,"_34195":84701,"_23354":143532,"_5":16137,"_30763":143106,"_3518":143533},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_4070":84864,"_34195":84701,"_23354":143535,"_5":16137,"_30763":143106,"_3518":143536},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_4070":84865,"_34195":84701,"_23354":143538,"_5":16137,"_30763":143106,"_3518":143539},[],"Una vez registradas las claves heredadas, arrancar el KMS con la opción de configuración del backend `crypto_engines.migrate_keys_format` renombra las claves cuyo nombre no es el digest SHA-256 de la clave pública, conserva el nombre antiguo como alias y traslada consigo las referencias de certificados. Es seguro volver a ejecutarla y puede desactivarse después.",{"_4070":84866,"_34195":84701,"_23354":143541,"_5":16137,"_30763":143110,"_3518":143542},[],"Los certificados referencian ahora su clave del KMS, y los roles VA referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_4070":84867,"_34195":84701,"_23354":143544,"_5":16137,"_30763":143118,"_3518":143545},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_4070":84868,"_34195":84701,"_23354":143547,"_5":16137,"_30763":143118,"_3518":143548},[],"Campo en 3.8.0",{"_4070":84869,"_34195":84701,"_23354":143550,"_5":16137,"_30763":143118,"_3518":143551},[],"Campo en 4.0.0",{"_4070":84870,"_34195":84701,"_23354":143553,"_5":16137,"_30763":143118,"_3518":67163},[],{"_4070":84871,"_34195":84701,"_23354":143555,"_5":16137,"_30763":143118,"_3518":143556},[],"`insecure_skip_verify` (con el valor negado)",{"_4070":84872,"_34195":84701,"_23354":143558,"_5":16137,"_30763":143118,"_3518":67169},[],{"_4070":84873,"_34195":84701,"_23354":143560,"_5":16137,"_30763":143118,"_3518":67172},[],{"_4070":84874,"_34195":84701,"_23354":143562,"_5":16137,"_30763":143118,"_3518":67175},[],{"_4070":84875,"_34195":84701,"_23354":143564,"_5":16137,"_30763":143118,"_3518":67178},[],{"_4070":84876,"_34195":84701,"_23354":143566,"_5":16137,"_30763":143118,"_3518":67181},[],{"_4070":84877,"_34195":84701,"_23354":143568,"_5":16137,"_30763":143118,"_3518":67184},[],{"_4070":84878,"_34195":84701,"_23354":143570,"_5":16137,"_30763":143118,"_3518":143571},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_4070":84879,"_34195":84701,"_23354":143573,"_5":16137,"_30763":143118,"_3518":143574},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_4070":84880,"_34195":84701,"_23354":143576,"_5":16137,"_30763":143118,"_3518":143577},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_4070":84881,"_34195":84701,"_23354":143579,"_5":16137,"_30763":143122,"_3518":143580},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_4070":84882,"_34195":84701,"_23354":143582,"_5":16137,"_30763":143122,"_3518":143583},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_4070":84883,"_34195":84701,"_23354":143585,"_5":16137,"_30763":143122,"_3518":143586},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_4070":84884,"_34195":84701,"_23354":143588,"_5":16137,"_30763":143126,"_3518":143589},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_4070":84885,"_34195":84701,"_23354":143591,"_5":16137,"_30763":143130,"_3518":143592},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_4070":84886,"_34195":84701,"_23354":143594,"_5":16137,"_30763":143134,"_3518":143595},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_4070":84887,"_34195":84701,"_23354":143597,"_5":16137,"_30763":143138,"_3518":143598},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_4070":84888,"_34195":84701,"_23354":143600,"_5":16137,"_30763":143138,"_3518":143601},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_4070":84889,"_34195":84701,"_23354":143603,"_5":16137,"_30763":143138,"_3518":143604},[],"`POST /v1/devices/:id/events` crea un evento.",{"_4070":84890,"_34195":84701,"_23354":143606,"_5":16137,"_30763":143138,"_3518":143607},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_4070":84891,"_34195":84701,"_23354":143609,"_5":16137,"_30763":143142,"_3518":143610},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_certificate_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de un rol nuevo es el número de serie del certificado actual de la CA. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. Las políticas de autorización personalizadas que filtran por el campo antiguo deben actualizarse: el filtro `crl_subject_key_id_signer` se renombra a `crl_signer_certificate_serial_number` y toma valores de número de serie.",{"_4070":84892,"_34195":84701,"_23354":143612,"_5":16137,"_30763":143146,"_3518":143613},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_4070":84893,"_34195":84701,"_23354":143615,"_5":16137,"_30763":143150,"_3518":143616},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_4070":84894,"_34195":84701,"_23354":143618,"_5":16137,"_30763":143150,"_3518":143619},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_4070":84895,"_34195":84701,"_23354":143621,"_5":16137,"_30763":143150,"_3518":143622},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_4070":84896,"_34195":84701,"_23354":143624,"_5":16137,"_30763":143150,"_3518":143625},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_4070":84897,"_34195":84701,"_23354":143627,"_5":16137,"_30763":143150,"_3518":143628},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_4070":84898,"_34195":84701,"_23354":143630,"_5":16137,"_30763":143154,"_3518":143631},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_4070":84899,"_34195":84701,"_23354":143633,"_5":16137,"_30763":143154,"_3518":143634},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_4070":84900,"_34195":84701,"_23354":143636,"_5":16137,"_30763":143154,"_3518":143637},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_4070":84901,"_34195":84701,"_23354":143639,"_5":16137,"_30763":143154,"_3518":143640},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_4070":84902,"_34195":84701,"_23354":143642,"_5":16137,"_30763":143154,"_3518":143643},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_4070":84903,"_34195":84701,"_23354":143645,"_5":16137,"_30763":143154,"_3518":143646},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_4070":84904,"_34195":84701,"_23354":143648,"_5":16137,"_30763":143154,"_3518":143649},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_4070":84905,"_34195":84701,"_23354":143651,"_5":16137,"_30763":143154,"_3518":143652},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_4070":84906,"_34195":84701,"_23354":143654,"_5":16137,"_30763":143154,"_3518":143655},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_4070":84907,"_34195":84701,"_23354":143657,"_5":16137,"_30763":143154,"_3518":143658},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_4070":84908,"_34195":84701,"_23354":143660,"_5":16137,"_30763":143154,"_3518":143661},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_4070":84909,"_34195":84701,"_23354":143663,"_5":16137,"_30763":143154,"_3518":143664},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_4070":84910,"_34195":84701,"_23354":143666,"_5":16137,"_30763":143158,"_3518":143667},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_4070":84911,"_34195":84701,"_23354":143669,"_5":16137,"_30763":143158,"_3518":143670},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_4070":84912,"_34195":84701,"_23354":143672,"_5":16137,"_30763":143162,"_3518":143673},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_4070":84913,"_34195":84701,"_23354":143675,"_5":16137,"_30763":143162,"_3518":143676},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_4070":84914,"_34195":84701,"_23354":143678,"_5":16137,"_30763":143162,"_3518":143679},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_4070":84915,"_34195":84701,"_23354":143681,"_5":16137,"_30763":143162,"_3518":143682},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_4070":84916,"_34195":84701,"_23354":143684,"_5":16137,"_30763":143162,"_3518":143685},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_4070":84917,"_34195":84701,"_23354":143687,"_5":16137,"_30763":143162,"_3518":143688},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_4070":84918,"_34195":84701,"_23354":143690,"_5":16137,"_30763":143162,"_3518":143691},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_4070":84919,"_34195":84701,"_23354":143693,"_5":16137,"_30763":143162,"_3518":143694},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_4070":84920,"_34195":84701,"_23354":143696,"_5":16137,"_30763":143162,"_3518":143697},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_4070":84921,"_34195":84701,"_23354":143699,"_5":16137,"_30763":143162,"_3518":143700},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_4070":84922,"_34195":84701,"_23354":143702,"_5":16137,"_30763":143162,"_3518":143703},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_4070":84923,"_34195":84701,"_23354":143705,"_5":16137,"_30763":143166,"_3518":143706},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_4070":84924,"_34195":84701,"_23354":143708,"_5":16137,"_30763":143166,"_3518":143709},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_4070":84925,"_34195":84701,"_23354":143711,"_5":16137,"_30763":143170,"_3518":143712},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_4070":84926,"_34195":84701,"_23354":143714,"_5":16137,"_30763":143170,"_3518":143715},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_4070":84927,"_34195":84701,"_23354":143717,"_5":16137,"_30763":143170,"_3518":143718},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Si tus servicios se conectan con un usuario distinto del que ejecutó las migraciones, concédele tras las migraciones `SELECT` sobre `ca.certificates_view`.",{"_4070":84928,"_34195":84701,"_23354":143720,"_5":16137,"_30763":143170,"_3518":143721},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_4070":84929,"_34195":84701,"_23354":143723,"_5":16137,"_30763":143170,"_3518":143724},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_4070":84930,"_34195":84701,"_23354":143726,"_5":16137,"_30763":143170,"_3518":143727},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_4070":84931,"_34195":84701,"_23354":143729,"_5":16137,"_30763":143170,"_3518":143730},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_4070":84932,"_34195":84701,"_23354":143732,"_5":16137,"_30763":143174,"_3518":143733},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_4070":84933,"_34195":84701,"_23354":143735,"_5":16137,"_30763":143174,"_3518":143736},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_4070":84934,"_34195":84701,"_23354":143738,"_5":16137,"_30763":143174,"_3518":143739},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_4070":84935,"_34195":84701,"_23354":143741,"_5":16137,"_30763":143174,"_3518":143742},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_4070":84936,"_34195":84701,"_23354":143744,"_5":16137,"_30763":143174,"_3518":143745},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_4070":84937,"_34195":84701,"_23354":143747,"_5":16137,"_30763":143174,"_3518":143748},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_4070":84938,"_34195":84701,"_23354":143750,"_5":16137,"_30763":143174,"_3518":143751},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_4070":84939,"_34195":84701,"_23354":143753,"_5":16137,"_30763":143174,"_3518":143754},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_4070":84940,"_34195":84701,"_23354":143756,"_5":16137,"_30763":143174,"_3518":143757},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_4070":84941,"_34195":84701,"_23354":143759,"_5":16137,"_30763":143174,"_3518":143760},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_certificate_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_4070":84942,"_34195":84701,"_23354":143762,"_5":16137,"_30763":143174,"_3518":143763},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_4070":84943,"_34195":84701,"_23354":143765,"_5":16137,"_30763":143177,"_3518":143766},[],"Tras la actualización, comprueba en este orden:",{"_4070":84944,"_34195":84701,"_23354":143768,"_5":16137,"_30763":143177,"_3518":143769},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_4070":84945,"_34195":84701,"_23354":143771,"_5":16137,"_30763":143177,"_3518":143772},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_4070":84946,"_34195":84701,"_23354":143774,"_5":16137,"_30763":143177,"_3518":143775},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_4070":84947,"_34195":84701,"_23354":143777,"_5":16137,"_30763":143177,"_3518":143778},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_4070":84948,"_34195":84701,"_23354":143780,"_5":16137,"_30763":143177,"_3518":143781},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_4070":84949,"_34195":84701,"_23354":143783,"_5":16137,"_30763":143177,"_3518":143784},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_4070":84950,"_34195":84701,"_23354":143786,"_5":16137,"_30763":143177,"_3518":143787},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_4070":84951,"_34195":84701,"_23354":143789,"_5":16137,"_30763":143177,"_3518":143790},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_4070":84952,"_34195":84701,"_23354":143792,"_5":16137,"_30763":143177,"_3518":143793},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_4070":84953,"_34195":84701,"_23354":143795,"_5":16137,"_30763":143177,"_3518":143796},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_4070":84954,"_34195":84701,"_23354":143798,"_5":16137,"_30763":143177,"_3518":143799},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_4070":84955,"_34195":84701,"_23354":143801,"_5":16137,"_30763":143177,"_3518":143802},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_4070":84956,"_34195":84701,"_23354":143804,"_5":16137,"_30763":143177,"_3518":143805},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_4070":84957,"_34195":84701,"_23354":143807,"_5":16137,"_30763":143177,"_3518":143808},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_4070":84958,"_34195":84701,"_23354":143810,"_5":16137,"_30763":143181,"_3518":143811},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_4070":84959,"_34195":84701,"_23354":143813,"_5":16137,"_30763":143181,"_3518":143814},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_4070":84960,"_34195":84701,"_23354":143816,"_5":16137,"_30763":143181,"_3518":143817},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_4070":84961,"_34195":84701,"_23354":143819,"_5":16137,"_30763":143181,"_3518":143820},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_4070":84962,"_34195":84701,"_23354":143822,"_5":16137,"_30763":143181,"_3518":143823},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_67442":143825,"_67443":143826,"_67445":143827,"_67447":143828,"_20232":3553,"_81458":3553},"spanish",[3518,34195,5,30763],{"_3518":27927,"_34195":27927,"_5":27927,"_30763":27927},{"_3518":143829,"_34195":147330,"_5":150831,"_30763":154332},{"_5342":143830,"_67451":143831,"_5":27927},{"_11597":5623,"_11758":3889,"_11695":5290,"_11548":11765,"_11887":8471,"_11557":7441,"_11588":23555,"_11569":6794,"_29359":16735,"_33244":7121,"_33278":19960,"_32740":4695,"_33344":9855,"_32927":22660,"_33350":17928,"_33312":21640,"_33356":3654,"_33361":8597,"_33302":6376,"_33939":12919,"_39146":5854,"_39148":7315,"_33983":3941,"_16699":8515,"_33963":8419,"_39154":13257,"_33992":8908,"_29343":5958,"_33934":33421,"_34010":33463,"_34052":21123,"_39161":13774,"_39163":3615,"_32944":5889,"_39166":5450,"_34081":26084,"_34069":14436,"_34042":14081,"_34075":6785,"_32809":22459,"_32857":6774,"_32863":6791,"_32869":3623,"_11551":6743,"_32875":8105,"_32881":6390,"_39180":3645,"_32851":27933,"_32887":10096,"_32699":5853,"_39186":4208,"_32745":33346,"_32767":23519,"_32773":6793,"_39192":3882,"_16689":10952,"_39195":4247,"_34265":4048,"_39199":19963,"_34113":19088,"_39202":15182,"_39204":8411,"_39206":456