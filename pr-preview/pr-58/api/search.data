:67251,"_45961":67254,"_45963":67257,"_45965":67260,"_45967":67263,"_45969":67266,"_45971":67269,"_45973":67272,"_45975":67275,"_45977":67278,"_45979":67281,"_45981":67284,"_45984":67287,"_45986":67290,"_45988":67293,"_45991":67296,"_45993":67299,"_45995":67302,"_45997":67305,"_45999":67308,"_46001":67311,"_46003":67314,"_46005":67317,"_46007":67320,"_46009":67323,"_46011":67326,"_46013":67329,"_46015":67332,"_46017":67335,"_46019":67338,"_46021":67341,"_46023":67344,"_46025":67347,"_46027":67350,"_46029":67353,"_46031":67356,"_46033":67359,"_46035":67362,"_46037":67365,"_46039":67368,"_46041":67371,"_46043":67374,"_46045":67377,"_46047":67380,"_46049":67383,"_46051":67386,"_46053":67389,"_46055":67392,"_46057":67395,"_46059":67398,"_46061":67401,"_46063":67404,"_46065":67407,"_46067":67410,"_46069":67413,"_46071":67416,"_46073":67419,"_46075":67422,"_46077":67425,"_46080":67428,"_46082":67431,"_46084":67434,"_46086":67437},{"_4070":15,"_34195":15,"_5":16540,"_3518":56670,"_34626":56671,"_23354":56675,"_30763":15},"Deploy from AWS Marketplace",[56672,56673,56674],"Docs","Deployment","Other models",[],{"_4070":16,"_34195":15,"_23354":56677,"_5":16137,"_30763":15,"_3518":56678},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_4070":17,"_34195":15,"_5":34623,"_23354":56680,"_30763":56681,"_3518":56682},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#before-you-begin","Before you begin",{"_4070":18,"_34195":15,"_5":34623,"_23354":56684,"_30763":56685,"_3518":56686},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_4070":19,"_34195":15,"_5":34623,"_23354":56688,"_30763":56689,"_3518":56690},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#open-the-offer","Open the offer",{"_4070":20,"_34195":15,"_5":34623,"_23354":56692,"_30763":56693,"_3518":56694},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_4070":21,"_34195":15,"_5":34623,"_23354":56696,"_30763":56697,"_3518":56698},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#limit-network-access","Limit network access",{"_4070":22,"_34195":15,"_5":34623,"_23354":56700,"_30763":56701,"_3518":56702},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_4070":23,"_34195":15,"_5":34623,"_23354":56704,"_30763":56705,"_3518":56706},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#next-step","Next step",{"_4070":24,"_34195":15,"_23354":56708,"_5":16137,"_30763":15,"_3518":56709},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_4070":25,"_34195":15,"_23354":56711,"_5":16137,"_30763":56681,"_3518":56712},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_4070":26,"_34195":15,"_23354":56714,"_5":16137,"_30763":56681,"_3518":56715},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_4070":27,"_34195":15,"_23354":56717,"_5":16137,"_30763":56681,"_3518":56718},[],"A security group allowing the necessary endpoints.",{"_4070":28,"_34195":15,"_23354":56720,"_5":16137,"_30763":56685,"_3518":56721},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_4070":29,"_34195":15,"_23354":56723,"_5":16137,"_30763":56685,"_3518":56724},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_4070":30,"_34195":15,"_23354":56726,"_5":16137,"_30763":56685,"_3518":56727},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_4070":31,"_34195":15,"_23354":56729,"_5":16137,"_30763":56689,"_3518":56730},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_4070":32,"_34195":15,"_23354":56732,"_5":16137,"_30763":56693,"_3518":56733},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_4070":33,"_34195":15,"_23354":56735,"_5":16137,"_30763":56697,"_3518":56736},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_4070":34,"_34195":15,"_23354":56738,"_5":16137,"_30763":56701,"_3518":56739},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_4070":35,"_34195":15,"_23354":56741,"_5":16137,"_30763":56705,"_3518":56742},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_4070":36,"_34195":36,"_5":16540,"_3518":56744,"_34626":56745,"_23354":56746,"_30763":36},"Deploy Lamassu",[56672,56673],[],{"_4070":37,"_34195":36,"_23354":56748,"_5":16137,"_30763":36,"_3518":56749},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_4070":38,"_34195":36,"_5":34623,"_23354":56751,"_30763":56752,"_3518":56753},[],"/docs/pr-preview/pr-58/deployment/overview#choose-a-model","Choose a model",{"_4070":39,"_34195":36,"_5":34623,"_23354":56755,"_30763":56756,"_3518":56757},[],"/docs/pr-preview/pr-58/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_4070":40,"_34195":36,"_5":34623,"_23354":56759,"_30763":56760,"_3518":56761},[],"/docs/pr-preview/pr-58/deployment/overview#after-deployment","After deployment",{"_4070":41,"_34195":36,"_23354":56763,"_5":16137,"_30763":36,"_3518":56764},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_4070":42,"_34195":36,"_23354":56766,"_5":16137,"_30763":56752,"_3518":56767},[],"Model",{"_4070":43,"_34195":36,"_23354":56769,"_5":16137,"_30763":56752,"_3518":56770},[],"Recommended for",{"_4070":44,"_34195":36,"_23354":56772,"_5":16137,"_30763":56752,"_3518":56773},[],"Who operates the infrastructure",{"_4070":45,"_34195":36,"_23354":56775,"_5":16137,"_30763":56752,"_3518":56776},[],"Starting point",{"_4070":46,"_34195":36,"_23354":56778,"_5":16137,"_30763":56752,"_3518":56779},[],"Kubernetes self-managed",{"_4070":47,"_34195":36,"_23354":56781,"_5":16137,"_30763":56752,"_3518":56782},[],"Production, regulated environments and custom deployments",{"_4070":48,"_34195":36,"_23354":56784,"_5":16137,"_30763":56752,"_3518":56785},[],"Your team",{"_4070":49,"_34195":36,"_23354":56787,"_5":16137,"_30763":56752,"_3518":56788},[],"Helm or Fastlane",{"_4070":50,"_34195":36,"_23354":56790,"_5":16137,"_30763":56752,"_3518":56791},[],"AWS Marketplace",{"_4070":51,"_34195":36,"_23354":56793,"_5":16137,"_30763":56752,"_3518":56794},[],"Evaluation or a dedicated deployment inside an AWS account",{"_4070":52,"_34195":36,"_23354":56796,"_5":16137,"_30763":56752,"_3518":56785},[],{"_4070":53,"_34195":36,"_23354":56798,"_5":16137,"_30763":56752,"_3518":56799},[],"Preconfigured image on EC2",{"_4070":54,"_34195":36,"_23354":56801,"_5":16137,"_30763":56752,"_3518":56802},[],"SaaS",{"_4070":55,"_34195":36,"_23354":56804,"_5":16137,"_30763":56752,"_3518":56805},[],"Teams that want to use the platform without operating it",{"_4070":56,"_34195":36,"_23354":56807,"_5":16137,"_30763":56752,"_3518":56808},[],"Lamassu",{"_4070":57,"_34195":36,"_23354":56810,"_5":16137,"_30763":56752,"_3518":56811},[],"Managed subscription",{"_4070":58,"_34195":36,"_23354":56813,"_5":16137,"_30763":56752,"_3518":56814},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_4070":59,"_34195":36,"_23354":56816,"_5":16137,"_30763":56752,"_3518":56817},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_4070":60,"_34195":36,"_23354":56819,"_5":16137,"_30763":56752,"_3518":56820},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_4070":61,"_34195":36,"_23354":56822,"_5":16137,"_30763":56756,"_3518":56823},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_4070":62,"_34195":36,"_23354":56825,"_5":16137,"_30763":56760,"_3518":56826},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_4070":63,"_34195":63,"_5":16540,"_3518":56828,"_34626":56829,"_23354":56830,"_30763":63},"Use Lamassu as SaaS",[56672,56673,56674],[],{"_4070":64,"_34195":63,"_23354":56832,"_5":16137,"_30763":63,"_3518":56833},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_4070":65,"_34195":63,"_5":34623,"_23354":56835,"_30763":56836,"_3518":56837},[],"/docs/pr-preview/pr-58/deployment/saas#what-the-service-manages","What the service manages",{"_4070":66,"_34195":63,"_5":34623,"_23354":56839,"_30763":56840,"_3518":56841},[],"/docs/pr-preview/pr-58/deployment/saas#plans","Plans",{"_4070":67,"_34195":63,"_5":34623,"_23354":56843,"_30763":56844,"_3518":56845},[],"/docs/pr-preview/pr-58/deployment/saas#request-access","Request access",{"_4070":68,"_34195":63,"_23354":56847,"_5":16137,"_30763":63,"_3518":56848},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_4070":69,"_34195":63,"_23354":56850,"_5":16137,"_30763":56836,"_3518":56851},[],"Platform availability and maintenance.",{"_4070":70,"_34195":63,"_23354":56853,"_5":16137,"_30763":56836,"_3518":56854},[],"Automatic backups.",{"_4070":71,"_34195":63,"_23354":56856,"_5":16137,"_30763":56836,"_3518":56857},[],"Version upgrades.",{"_4070":72,"_34195":63,"_23354":56859,"_5":16137,"_30763":56836,"_3518":56860},[],"Technical support and SLA according to your plan.",{"_4070":73,"_34195":63,"_23354":56862,"_5":16137,"_30763":56840,"_3518":56863},[],"Plan",{"_4070":74,"_34195":63,"_23354":56865,"_5":16137,"_30763":56840,"_3518":56866},[],"Devices",{"_4070":75,"_34195":63,"_23354":56868,"_5":16137,"_30763":56840,"_3518":56869},[],"Support",{"_4070":76,"_34195":63,"_23354":56871,"_5":16137,"_30763":56840,"_3518":56872},[],"SLA",{"_4070":77,"_34195":63,"_23354":56874,"_5":16137,"_30763":56840,"_3518":56875},[],"Starter",{"_4070":78,"_34195":63,"_23354":56877,"_5":16137,"_30763":56840,"_3518":56878},[],"Up to 1,000",{"_4070":79,"_34195":63,"_23354":56880,"_5":16137,"_30763":56840,"_3518":56881},[],"Email",{"_4070":80,"_34195":63,"_23354":56883,"_5":16137,"_30763":56840,"_3518":56884},[],"99.5 %",{"_4070":81,"_34195":63,"_23354":56886,"_5":16137,"_30763":56840,"_3518":56887},[],"Professional",{"_4070":82,"_34195":63,"_23354":56889,"_5":16137,"_30763":56840,"_3518":56890},[],"Up to 10,000",{"_4070":83,"_34195":63,"_23354":56892,"_5":16137,"_30763":56840,"_3518":56893},[],"Email and chat",{"_4070":84,"_34195":63,"_23354":56895,"_5":16137,"_30763":56840,"_3518":56896},[],"99.9 %",{"_4070":85,"_34195":63,"_23354":56898,"_5":16137,"_30763":56840,"_3518":56899},[],"Enterprise",{"_4070":86,"_34195":63,"_23354":56901,"_5":16137,"_30763":56840,"_3518":56902},[],"Unlimited",{"_4070":87,"_34195":63,"_23354":56904,"_5":16137,"_30763":56840,"_3518":56905},[],"Dedicated",{"_4070":88,"_34195":63,"_23354":56907,"_5":16137,"_30763":56840,"_3518":56908},[],"99.99 %",{"_4070":89,"_34195":63,"_23354":56910,"_5":16137,"_30763":56844,"_3518":56911},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_4070":90,"_34195":63,"_23354":56913,"_5":16137,"_30763":56844,"_3518":56914},[],"When you receive your instance's credentials, continue with Get started.",{"_4070":91,"_34195":91,"_5":16540,"_3518":56916,"_34626":56917,"_23354":56918,"_30763":91},"Fastlane",[56672,56673,56779],[],{"_4070":92,"_34195":91,"_23354":56920,"_5":16137,"_30763":91,"_3518":56921},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_4070":93,"_34195":91,"_5":34623,"_23354":56923,"_30763":56924,"_3518":56925},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_4070":94,"_34195":91,"_5":34623,"_23354":56927,"_30763":56928,"_3518":56929},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_4070":95,"_34195":91,"_5":34623,"_23354":56931,"_30763":56932,"_3518":56682},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#before-you-begin",{"_4070":96,"_34195":91,"_5":34623,"_23354":56934,"_30763":56935,"_3518":56936},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#quick-start","Quick start",{"_4070":97,"_34195":91,"_5":34623,"_23354":56938,"_30763":56939,"_3518":56940},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_4070":98,"_34195":91,"_5":34623,"_23354":56942,"_30763":56943,"_3518":56944},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_4070":99,"_34195":91,"_5":34623,"_23354":56946,"_30763":56947,"_3518":56948},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#development-mode","Development mode",{"_4070":100,"_34195":91,"_5":34623,"_23354":56950,"_30763":56951,"_3518":56952},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_4070":101,"_34195":91,"_5":34623,"_23354":56954,"_30763":56955,"_3518":56956},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_4070":102,"_34195":91,"_5":34623,"_23354":56958,"_30763":56959,"_3518":56960},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_4070":103,"_34195":91,"_5":34623,"_23354":56962,"_30763":56963,"_3518":56964},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_4070":104,"_34195":91,"_23354":56966,"_5":16137,"_30763":56924,"_3518":56967},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_4070":105,"_34195":91,"_23354":56969,"_5":16137,"_30763":56924,"_3518":56970},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_4070":106,"_34195":91,"_23354":56972,"_5":16137,"_30763":56928,"_3518":56973},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_4070":107,"_34195":91,"_23354":56975,"_5":16137,"_30763":56928,"_3518":56976},[],"Fastlane installs or configures",{"_4070":108,"_34195":91,"_23354":56978,"_5":16137,"_30763":56928,"_3518":56979},[],"You still provide",{"_4070":109,"_34195":91,"_23354":56981,"_5":16137,"_30763":56928,"_3518":56982},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_4070":110,"_34195":91,"_23354":56984,"_5":16137,"_30763":56928,"_3518":56985},[],"The Kubernetes cluster, nodes and persistent storage",{"_4070":111,"_34195":91,"_23354":56987,"_5":16137,"_30763":56928,"_3518":56988},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_4070":112,"_34195":91,"_23354":56990,"_5":16137,"_30763":56928,"_3518":56991},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_4070":113,"_34195":91,"_23354":56993,"_5":16137,"_30763":56928,"_3518":56994},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_4070":114,"_34195":91,"_23354":56996,"_5":16137,"_30763":56928,"_3518":56997},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_4070":115,"_34195":91,"_23354":56999,"_5":16137,"_30763":56928,"_3518":57000},[],"Optional observability and lab HSM components",{"_4070":116,"_34195":91,"_23354":57002,"_5":16137,"_30763":56928,"_3518":57003},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_4070":117,"_34195":91,"_23354":57005,"_5":16137,"_30763":56928,"_3518":57006},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_4070":118,"_34195":91,"_23354":57008,"_5":16137,"_30763":56932,"_3518":57009},[],"You need:",{"_4070":119,"_34195":91,"_23354":57011,"_5":16137,"_30763":56932,"_3518":57012},[],"an existing Kubernetes cluster",{"_4070":120,"_34195":91,"_23354":57014,"_5":16137,"_30763":56932,"_3518":57015},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_4070":121,"_34195":91,"_23354":57017,"_5":16137,"_30763":56932,"_3518":57018},[],"`yq`",{"_4070":122,"_34195":91,"_23354":57020,"_5":16137,"_30763":56932,"_3518":26466},[],{"_4070":123,"_34195":91,"_23354":57022,"_5":16137,"_30763":56932,"_3518":57023},[],"`jq` only when using `--sample-data` or `--development`",{"_4070":124,"_34195":91,"_23354":57025,"_5":16137,"_30763":56932,"_3518":57026},[],"`ssh-keygen` only when using `--with-hsm`",{"_4070":125,"_34195":91,"_23354":57028,"_5":16137,"_30763":56932,"_3518":57029},[],"free external ports 80 and 443 on a single-node K3s host",{"_4070":126,"_34195":91,"_23354":57031,"_5":16137,"_30763":56932,"_3518":57032},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_4070":127,"_34195":91,"_23354":57034,"_5":16137,"_30763":56932,"_3518":57035},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_4070":128,"_34195":91,"_23354":57037,"_5":16137,"_30763":56935,"_3518":57038},[],"Run the script from a clone of the Helm repository:",{"_4070":129,"_34195":91,"_23354":57040,"_5":16137,"_30763":56935,"_3518":57041},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_4070":130,"_34195":91,"_23354":57043,"_5":16137,"_30763":56939,"_3518":57044},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_4070":131,"_34195":91,"_23354":57046,"_5":16137,"_30763":56939,"_3518":57047},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_4070":132,"_34195":91,"_23354":57049,"_5":16137,"_30763":56939,"_3518":57050},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_4070":133,"_34195":91,"_23354":57052,"_5":16137,"_30763":56939,"_3518":57053},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_4070":134,"_34195":91,"_23354":57055,"_5":16137,"_30763":56943,"_3518":57056},[],"Option",{"_4070":135,"_34195":91,"_23354":57058,"_5":16137,"_30763":56943,"_3518":57059},[],"Default",{"_4070":136,"_34195":91,"_23354":57061,"_5":16137,"_30763":56943,"_3518":57062},[],"Purpose",{"_4070":137,"_34195":91,"_23354":57064,"_5":16137,"_30763":56943,"_3518":57065},[],"`-h`, `--help`",{"_4070":138,"_34195":91,"_23354":57067,"_5":16137,"_30763":56943,"_3518":57068},[],"—",{"_4070":139,"_34195":91,"_23354":57070,"_5":16137,"_30763":56943,"_3518":57071},[],"Show help",{"_4070":140,"_34195":91,"_23354":57073,"_5":16137,"_30763":56943,"_3518":57074},[],"`-c`, `--context`",{"_4070":141,"_34195":91,"_23354":57076,"_5":16137,"_30763":56943,"_3518":57077},[],"current context",{"_4070":142,"_34195":91,"_23354":57079,"_5":16137,"_30763":56943,"_3518":57080},[],"Select the kubeconfig context for kubectl and Helm",{"_4070":143,"_34195":91,"_23354":57082,"_5":16137,"_30763":56943,"_3518":57083},[],"`-n`, `--non-interactive`",{"_4070":144,"_34195":91,"_23354":57085,"_5":16137,"_30763":56943,"_3518":7390},[],{"_4070":145,"_34195":91,"_23354":57087,"_5":16137,"_30763":56943,"_3518":57088},[],"Skip prompts and generate dependency credentials",{"_4070":146,"_34195":91,"_23354":57090,"_5":16137,"_30763":56943,"_3518":57091},[],"`-ns`, `--namespace`",{"_4070":147,"_34195":91,"_23354":57093,"_5":16137,"_30763":56943,"_3518":57094},[],"`lamassu-dev`",{"_4070":148,"_34195":91,"_23354":57096,"_5":16137,"_30763":56943,"_3518":57097},[],"Namespace for the installation",{"_4070":149,"_34195":91,"_23354":57099,"_5":16137,"_30763":56943,"_3518":57100},[],"`-d`, `--domain`",{"_4070":150,"_34195":91,"_23354":57102,"_5":16137,"_30763":56943,"_3518":57103},[],"`dev.lamassu.io`",{"_4070":151,"_34195":91,"_23354":57105,"_5":16137,"_30763":56943,"_3518":57106},[],"Domain used by the UI, OIDC and certificate",{"_4070":152,"_34195":91,"_23354":57108,"_5":16137,"_30763":56943,"_3518":57109},[],"`-v`, `--version`",{"_4070":153,"_34195":91,"_23354":57111,"_5":16137,"_30763":56943,"_3518":16975},[],{"_4070":154,"_34195":91,"_23354":57113,"_5":16137,"_30763":56943,"_3518":57114},[],"Lamassu chart version",{"_4070":155,"_34195":91,"_23354":57116,"_5":16137,"_30763":56943,"_3518":57117},[],"`--https-port`",{"_4070":156,"_34195":91,"_23354":57119,"_5":16137,"_30763":56943,"_3518":57120},[],"`443`",{"_4070":157,"_34195":91,"_23354":57122,"_5":16137,"_30763":56943,"_3518":57123},[],"Gateway HTTPS listener port",{"_4070":158,"_34195":91,"_23354":57125,"_5":16137,"_30763":56943,"_3518":57126},[],"`--http-port`",{"_4070":159,"_34195":91,"_23354":57128,"_5":16137,"_30763":56943,"_3518":57129},[],"`80`",{"_4070":160,"_34195":91,"_23354":57131,"_5":16137,"_30763":56943,"_3518":57132},[],"Gateway HTTP listener port",{"_4070":161,"_34195":91,"_23354":57134,"_5":16137,"_30763":56943,"_3518":57135},[],"`--tls-crt`",{"_4070":162,"_34195":91,"_23354":57137,"_5":16137,"_30763":56943,"_3518":57068},[],{"_4070":163,"_34195":91,"_23354":57139,"_5":16137,"_30763":56943,"_3518":57140},[],"PEM certificate for downstream TLS",{"_4070":164,"_34195":91,"_23354":57142,"_5":16137,"_30763":56943,"_3518":57143},[],"`--tls-key`",{"_4070":165,"_34195":91,"_23354":57145,"_5":16137,"_30763":56943,"_3518":57068},[],{"_4070":166,"_34195":91,"_23354":57147,"_5":16137,"_30763":56943,"_3518":57148},[],"PEM private key for downstream TLS",{"_4070":167,"_34195":91,"_23354":57150,"_5":16137,"_30763":56943,"_3518":57151},[],"`-l`, `--local-chart-path`",{"_4070":168,"_34195":91,"_23354":57153,"_5":16137,"_30763":56943,"_3518":57154},[],"repository chart",{"_4070":169,"_34195":91,"_23354":57156,"_5":16137,"_30763":56943,"_3518":57157},[],"Use an unpacked local Lamassu chart",{"_4070":170,"_34195":91,"_23354":57159,"_5":16137,"_30763":56943,"_3518":57160},[],"`-ip`, `--gateway-ip`",{"_4070":171,"_34195":91,"_23354":57162,"_5":16137,"_30763":56943,"_3518":9775},[],{"_4070":172,"_34195":91,"_23354":57164,"_5":16137,"_30763":56943,"_3518":57165},[],"Override the address written to `gateway.addresses`",{"_4070":173,"_34195":91,"_23354":57167,"_5":16137,"_30763":56943,"_3518":57168},[],"`--otel`",{"_4070":174,"_34195":91,"_23354":57170,"_5":16137,"_30763":56943,"_3518":7390},[],{"_4070":175,"_34195":91,"_23354":57172,"_5":16137,"_30763":56943,"_3518":57173},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_4070":176,"_34195":91,"_23354":57175,"_5":16137,"_30763":56943,"_3518":57176},[],"`--development`",{"_4070":177,"_34195":91,"_23354":57178,"_5":16137,"_30763":56943,"_3518":7390},[],{"_4070":178,"_34195":91,"_23354":57180,"_5":16137,"_30763":56943,"_3518":57181},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_4070":179,"_34195":91,"_23354":57183,"_5":16137,"_30763":56943,"_3518":57184},[],"`--sample-data`",{"_4070":180,"_34195":91,"_23354":57186,"_5":16137,"_30763":56943,"_3518":7390},[],{"_4070":181,"_34195":91,"_23354":57188,"_5":16137,"_30763":56943,"_3518":57189},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_4070":182,"_34195":91,"_23354":57191,"_5":16137,"_30763":56943,"_3518":57192},[],"`--with-hsm`",{"_4070":183,"_34195":91,"_23354":57194,"_5":16137,"_30763":56943,"_3518":7390},[],{"_4070":184,"_34195":91,"_23354":57196,"_5":16137,"_30763":56943,"_3518":57197},[],"Install lab HSM components and configure KMS for PKCS#11",{"_4070":185,"_34195":91,"_23354":57199,"_5":16137,"_30763":56943,"_3518":57200},[],"`--softhsm-chart-path`",{"_4070":186,"_34195":91,"_23354":57202,"_5":16137,"_30763":56943,"_3518":57203},[],"`./charts/softhsm`",{"_4070":187,"_34195":91,"_23354":57205,"_5":16137,"_30763":56943,"_3518":57206},[],"Use a different local SoftHSM chart",{"_4070":188,"_34195":91,"_23354":57208,"_5":16137,"_30763":56943,"_3518":57209},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_4070":189,"_34195":91,"_23354":57211,"_5":16137,"_30763":56947,"_3518":57212},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_4070":190,"_34195":91,"_23354":57214,"_5":16137,"_30763":56947,"_3518":57215},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_4070":191,"_34195":91,"_23354":57217,"_5":16137,"_30763":56947,"_3518":57218},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_4070":192,"_34195":91,"_23354":57220,"_5":16137,"_30763":56947,"_3518":57221},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_4070":193,"_34195":91,"_23354":57223,"_5":16137,"_30763":56947,"_3518":57224},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_4070":194,"_34195":91,"_23354":57226,"_5":16137,"_30763":56947,"_3518":57227},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_4070":195,"_34195":91,"_23354":57229,"_5":16137,"_30763":56951,"_3518":57230},[],"Fastlane:",{"_4070":196,"_34195":91,"_23354":57232,"_5":16137,"_30763":56951,"_3518":57233},[],"validates local tools and the selected cluster",{"_4070":197,"_34195":91,"_23354":57235,"_5":16137,"_30763":56951,"_3518":57236},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_4070":198,"_34195":91,"_23354":57238,"_5":16137,"_30763":56951,"_3518":57239},[],"creates the namespace",{"_4070":199,"_34195":91,"_23354":57241,"_5":16137,"_30763":56951,"_3518":57242},[],"installs PostgreSQL and creates the required databases",{"_4070":200,"_34195":91,"_23354":57244,"_5":16137,"_30763":56951,"_3518":57245},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_4070":201,"_34195":91,"_23354":57247,"_5":16137,"_30763":56951,"_3518":57248},[],"installs RabbitMQ",{"_4070":202,"_34195":91,"_23354":57250,"_5":16137,"_30763":56951,"_3518":57251},[],"optionally installs observability and lab HSM components",{"_4070":203,"_34195":91,"_23354":57253,"_5":16137,"_30763":56951,"_3518":57254},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_4070":204,"_34195":91,"_23354":57256,"_5":16137,"_30763":56951,"_3518":57257},[],"optionally loads sample data",{"_4070":205,"_34195":91,"_23354":57259,"_5":16137,"_30763":56951,"_3518":57260},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_4070":206,"_34195":91,"_23354":57262,"_5":16137,"_30763":56955,"_3518":57263},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_4070":207,"_34195":91,"_23354":57265,"_5":16137,"_30763":56955,"_3518":57266},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_4070":208,"_34195":91,"_23354":57268,"_5":16137,"_30763":56959,"_3518":57269},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_4070":209,"_34195":91,"_23354":57271,"_5":16137,"_30763":56959,"_3518":57272},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_4070":210,"_34195":91,"_23354":57274,"_5":16137,"_30763":56959,"_3518":57275},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_4070":211,"_34195":91,"_23354":57277,"_5":16137,"_30763":56963,"_3518":57278},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_4070":212,"_34195":212,"_5":16540,"_3518":57280,"_34626":57281,"_23354":57282,"_30763":212},"Install with Helm",[56672,56673,56779],[],{"_4070":213,"_34195":212,"_23354":57284,"_5":16137,"_30763":212,"_3518":57285},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_4070":214,"_34195":212,"_5":34623,"_23354":57287,"_30763":57288,"_3518":57289},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_4070":215,"_34195":212,"_5":34623,"_23354":57291,"_30763":57292,"_3518":56682},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#before-you-begin",{"_4070":216,"_34195":212,"_5":34623,"_23354":57294,"_30763":57295,"_3518":57296},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_4070":217,"_34195":212,"_5":34623,"_23354":57298,"_30763":57299,"_3518":57300},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_4070":218,"_34195":212,"_5":34623,"_23354":57302,"_30763":57303,"_3518":57304},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_4070":219,"_34195":212,"_5":34623,"_23354":57306,"_30763":57307,"_3518":57308},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_4070":220,"_34195":212,"_5":34623,"_23354":57310,"_30763":57311,"_3518":57312},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_4070":221,"_34195":212,"_5":34623,"_23354":57314,"_30763":57315,"_3518":57316},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_4070":222,"_34195":212,"_5":34623,"_23354":57318,"_30763":57319,"_3518":57320},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_4070":223,"_34195":212,"_5":34623,"_23354":57322,"_30763":57323,"_3518":57324},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_4070":224,"_34195":212,"_5":34623,"_23354":57326,"_30763":57327,"_3518":57328},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#production-decisions","Production decisions",{"_4070":225,"_34195":212,"_23354":57330,"_5":16137,"_30763":57288,"_3518":57331},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_4070":226,"_34195":212,"_23354":57333,"_5":16137,"_30763":57292,"_3518":57334},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_4070":227,"_34195":212,"_23354":57336,"_5":16137,"_30763":57292,"_3518":57337},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_4070":228,"_34195":212,"_23354":57339,"_5":16137,"_30763":57292,"_3518":57340},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_4070":229,"_34195":212,"_23354":57342,"_5":16137,"_30763":57292,"_3518":57343},[],"a reachable RabbitMQ broker and credentials",{"_4070":230,"_34195":212,"_23354":57345,"_5":16137,"_30763":57292,"_3518":57346},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_4070":231,"_34195":212,"_23354":57348,"_5":16137,"_30763":57292,"_3518":57349},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_4070":232,"_34195":212,"_23354":57351,"_5":16137,"_30763":57292,"_3518":57352},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_4070":233,"_34195":212,"_23354":57354,"_5":16137,"_30763":57292,"_3518":57355},[],"a StorageClass and an external traffic design",{"_4070":234,"_34195":212,"_23354":57357,"_5":16137,"_30763":57292,"_3518":57358},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_4070":235,"_34195":212,"_23354":57360,"_5":16137,"_30763":57292,"_3518":57361},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_4070":236,"_34195":212,"_23354":57363,"_5":16137,"_30763":57292,"_3518":57364},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_4070":237,"_34195":212,"_23354":57366,"_5":16137,"_30763":57295,"_3518":57367},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_4070":238,"_34195":212,"_23354":57369,"_5":16137,"_30763":57295,"_3518":57370},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_4070":239,"_34195":212,"_23354":57372,"_5":16137,"_30763":57295,"_3518":57373},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_4070":240,"_34195":212,"_23354":57375,"_5":16137,"_30763":57299,"_3518":57376},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_4070":241,"_34195":212,"_23354":57378,"_5":16137,"_30763":57299,"_3518":57379},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_4070":242,"_34195":212,"_23354":57381,"_5":16137,"_30763":57299,"_3518":57382},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_4070":243,"_34195":212,"_23354":57384,"_5":16137,"_30763":57299,"_3518":57385},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_4070":244,"_34195":212,"_23354":57387,"_5":16137,"_30763":57303,"_3518":57388},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_4070":245,"_34195":212,"_23354":57390,"_5":16137,"_30763":57307,"_3518":57391},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_4070":246,"_34195":212,"_23354":57393,"_5":16137,"_30763":57307,"_3518":57394},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_4070":247,"_34195":212,"_23354":57396,"_5":16137,"_30763":57307,"_3518":57397},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_4070":248,"_34195":212,"_23354":57399,"_5":16137,"_30763":57307,"_3518":57400},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_4070":249,"_34195":212,"_23354":57402,"_5":16137,"_30763":57307,"_3518":57403},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_4070":250,"_34195":212,"_23354":57405,"_5":16137,"_30763":57307,"_3518":57406},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_4070":251,"_34195":212,"_23354":57408,"_5":16137,"_30763":57307,"_3518":57409},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_4070":252,"_34195":212,"_23354":57411,"_5":16137,"_30763":57311,"_3518":57412},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_4070":253,"_34195":212,"_23354":57414,"_5":16137,"_30763":57311,"_3518":57415},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_4070":254,"_34195":212,"_23354":57417,"_5":16137,"_30763":57311,"_3518":57418},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_4070":255,"_34195":212,"_23354":57420,"_5":16137,"_30763":57311,"_3518":57421},[],"See Access control for the principal and policy model.",{"_4070":256,"_34195":212,"_23354":57423,"_5":16137,"_30763":57315,"_3518":57424},[],"To install a local checkout instead:",{"_4070":257,"_34195":212,"_23354":57426,"_5":16137,"_30763":57319,"_3518":57427},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_4070":258,"_34195":212,"_23354":57429,"_5":16137,"_30763":57319,"_3518":57430},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_4070":259,"_34195":212,"_23354":57432,"_5":16137,"_30763":57323,"_3518":57433},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_4070":260,"_34195":212,"_23354":57435,"_5":16137,"_30763":57323,"_3518":57436},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_4070":261,"_34195":212,"_23354":57438,"_5":16137,"_30763":57323,"_3518":57439},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_4070":262,"_34195":212,"_23354":57441,"_5":16137,"_30763":57323,"_3518":57442},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_4070":263,"_34195":212,"_23354":57444,"_5":16137,"_30763":57323,"_3518":57445},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_4070":264,"_34195":212,"_23354":57447,"_5":16137,"_30763":57327,"_3518":57448},[],"Before going live, review:",{"_4070":265,"_34195":212,"_23354":57450,"_5":16137,"_30763":57327,"_3518":57451},[],"backup and recovery for PostgreSQL and persistent volumes",{"_4070":266,"_34195":212,"_23354":57453,"_5":16137,"_30763":57327,"_3518":57454},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_4070":267,"_34195":212,"_23354":57456,"_5":16137,"_30763":57327,"_3518":57457},[],"shared VA storage before increasing VA replicas",{"_4070":268,"_34195":212,"_23354":57459,"_5":16137,"_30763":57327,"_3518":57460},[],"managed OIDC roles and removal of evaluation credentials",{"_4070":269,"_34195":212,"_23354":57462,"_5":16137,"_30763":57327,"_3518":57463},[],"a trusted TLS issuer or externally managed certificate",{"_4070":270,"_34195":212,"_23354":57465,"_5":16137,"_30763":57327,"_3518":57466},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_4070":271,"_34195":212,"_23354":57468,"_5":16137,"_30763":57327,"_3518":57469},[],"SMTP, observability and alert delivery",{"_4070":272,"_34195":212,"_23354":57471,"_5":16137,"_30763":57327,"_3518":57472},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_4070":273,"_34195":212,"_23354":57474,"_5":16137,"_30763":57327,"_3518":57475},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_4070":274,"_34195":274,"_5":16540,"_3518":57477,"_34626":57478,"_23354":57479,"_30763":274},"Expose the Gateway",[56672,56673,56779],[],{"_4070":275,"_34195":274,"_23354":57481,"_5":16137,"_30763":274,"_3518":57482},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_4070":276,"_34195":274,"_5":34623,"_23354":57484,"_30763":57485,"_3518":57486},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_4070":277,"_34195":274,"_5":34623,"_23354":57488,"_30763":57489,"_3518":57490},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_4070":278,"_34195":274,"_5":34623,"_23354":57492,"_30763":57493,"_3518":57494},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_4070":279,"_34195":274,"_5":34623,"_23354":57496,"_30763":57497,"_3518":57498},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#k3s","K3s",{"_4070":280,"_34195":274,"_5":34623,"_23354":57500,"_30763":57501,"_3518":57502},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_4070":281,"_34195":274,"_5":34623,"_23354":57504,"_30763":57505,"_3518":57506},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_4070":282,"_34195":274,"_5":34623,"_23354":57508,"_30763":57509,"_3518":57510},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_4070":283,"_34195":274,"_5":34623,"_23354":57512,"_30763":57513,"_3518":57514},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#decision-guide","Decision guide",{"_4070":284,"_34195":274,"_5":34623,"_23354":57516,"_30763":57517,"_3518":57518},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_4070":285,"_34195":274,"_5":34623,"_23354":57520,"_30763":57521,"_3518":57522},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_4070":286,"_34195":274,"_23354":57524,"_5":16137,"_30763":57485,"_3518":57525},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_4070":287,"_34195":274,"_23354":57527,"_5":16137,"_30763":57485,"_3518":57528},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_4070":288,"_34195":274,"_23354":57530,"_5":16137,"_30763":57489,"_3518":57531},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_4070":289,"_34195":274,"_23354":57533,"_5":16137,"_30763":57489,"_3518":57534},[],"Set it only when:",{"_4070":290,"_34195":274,"_23354":57536,"_5":16137,"_30763":57489,"_3518":57537},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_4070":291,"_34195":274,"_23354":57539,"_5":16137,"_30763":57489,"_3518":57540},[],"that address is allocated to this Gateway",{"_4070":292,"_34195":274,"_23354":57542,"_5":16137,"_30763":57489,"_3518":57543},[],"the surrounding network already routes traffic for it to the cluster",{"_4070":293,"_34195":274,"_23354":57545,"_5":16137,"_30763":57489,"_3518":57546},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_4070":294,"_34195":274,"_23354":57548,"_5":16137,"_30763":57489,"_3518":57549},[],"Keep these two settings separate:",{"_4070":295,"_34195":274,"_23354":57551,"_5":16137,"_30763":57489,"_3518":57552},[],"`gateway.addresses` requests an address for the Gateway.",{"_4070":296,"_34195":274,"_23354":57554,"_5":16137,"_30763":57489,"_3518":57555},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_4070":297,"_34195":274,"_23354":57557,"_5":16137,"_30763":57489,"_3518":57558},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_4070":298,"_34195":274,"_23354":57560,"_5":16137,"_30763":57493,"_3518":57561},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_4070":299,"_34195":274,"_23354":57563,"_5":16137,"_30763":57493,"_3518":57564},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_4070":300,"_34195":274,"_23354":57566,"_5":16137,"_30763":57497,"_3518":57567},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_4070":301,"_34195":274,"_23354":57569,"_5":16137,"_30763":57497,"_3518":57570},[],"For the recommended design:",{"_4070":302,"_34195":274,"_23354":57572,"_5":16137,"_30763":57497,"_3518":57573},[],"Use only one externally exposed Lamassu Gateway.",{"_4070":303,"_34195":274,"_23354":57575,"_5":16137,"_30763":57497,"_3518":57576},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_4070":304,"_34195":274,"_23354":57578,"_5":16137,"_30763":57497,"_3518":57579},[],"Allow those ports through the VM firewall and any upstream security group.",{"_4070":305,"_34195":274,"_23354":57581,"_5":16137,"_30763":57497,"_3518":57582},[],"Point DNS at the VM's reachable address.",{"_4070":306,"_34195":274,"_23354":57584,"_5":16137,"_30763":57497,"_3518":57585},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_4070":307,"_34195":274,"_23354":57587,"_5":16137,"_30763":57501,"_3518":57588},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_4070":308,"_34195":274,"_23354":57590,"_5":16137,"_30763":57505,"_3518":57591},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_4070":309,"_34195":274,"_23354":57593,"_5":16137,"_30763":57505,"_3518":57594},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_4070":310,"_34195":274,"_23354":57596,"_5":16137,"_30763":57509,"_3518":57597},[],"First decide whether you need three independent data planes or only three hostnames.",{"_4070":311,"_34195":274,"_23354":57599,"_5":16137,"_30763":57509,"_3518":57600},[],"Requirement",{"_4070":312,"_34195":274,"_23354":57602,"_5":16137,"_30763":57509,"_3518":57603},[],"Recommended design",{"_4070":313,"_34195":274,"_23354":57605,"_5":16137,"_30763":57509,"_3518":57606},[],"Consequence",{"_4070":314,"_34195":274,"_23354":57608,"_5":16137,"_30763":57509,"_3518":57609},[],"Several Lamassu URLs or services",{"_4070":315,"_34195":274,"_23354":57611,"_5":16137,"_30763":57509,"_3518":57612},[],"One Gateway with multiple routes",{"_4070":316,"_34195":274,"_23354":57614,"_5":16137,"_30763":57509,"_3518":57615},[],"One IP and one proxy fleet; this is the chart default",{"_4070":317,"_34195":274,"_23354":57617,"_5":16137,"_30763":57509,"_3518":57618},[],"Independent Gateways and separate external IPs",{"_4070":318,"_34195":274,"_23354":57620,"_5":16137,"_30763":57509,"_3518":57621},[],"One VIP per Gateway",{"_4070":319,"_34195":274,"_23354":57623,"_5":16137,"_30763":57509,"_3518":57624},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_4070":320,"_34195":274,"_23354":57626,"_5":16137,"_30763":57509,"_3518":57627},[],"Independent Gateways on one node and one IP",{"_4070":321,"_34195":274,"_23354":57629,"_5":16137,"_30763":57509,"_3518":57630},[],"Use different external ports",{"_4070":322,"_34195":274,"_23354":57632,"_5":16137,"_30763":57509,"_3518":57633},[],"Clients must include non-standard ports",{"_4070":323,"_34195":274,"_23354":57635,"_5":16137,"_30763":57509,"_3518":57636},[],"Separate TLS/mTLS termination behind one IP",{"_4070":324,"_34195":274,"_23354":57638,"_5":16137,"_30763":57509,"_3518":57639},[],"Front-door SNI routing to internal Gateways",{"_4070":325,"_34195":274,"_23354":57641,"_5":16137,"_30763":57509,"_3518":57642},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_4070":326,"_34195":274,"_23354":57644,"_5":16137,"_30763":57509,"_3518":57645},[],"Separate Gateway resources but shared proxy infrastructure",{"_4070":327,"_34195":274,"_23354":57647,"_5":16137,"_30763":57509,"_3518":57648},[],"Envoy merged-Gateway mode",{"_4070":328,"_34195":274,"_23354":57650,"_5":16137,"_30763":57509,"_3518":57651},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_4070":329,"_34195":274,"_23354":57653,"_5":16137,"_30763":57509,"_3518":57654},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_4070":330,"_34195":274,"_23354":57656,"_5":16137,"_30763":57509,"_3518":57657},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_4070":331,"_34195":274,"_23354":57659,"_5":16137,"_30763":57509,"_3518":57660},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_4070":332,"_34195":274,"_23354":57662,"_5":16137,"_30763":57509,"_3518":57663},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_4070":333,"_34195":274,"_23354":57665,"_5":16137,"_30763":57513,"_3518":57666},[],"If one Gateway can own TLS and routing, use the chart default.",{"_4070":334,"_34195":274,"_23354":57668,"_5":16137,"_30763":57513,"_3518":57669},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_4070":335,"_34195":274,"_23354":57671,"_5":16137,"_30763":57513,"_3518":57672},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_4070":336,"_34195":274,"_23354":57674,"_5":16137,"_30763":57513,"_3518":57675},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_4070":337,"_34195":274,"_23354":57677,"_5":16137,"_30763":57513,"_3518":57678},[],"If none of those are possible, use different external ports or change the external network design.",{"_4070":338,"_34195":274,"_23354":57680,"_5":16137,"_30763":57517,"_3518":57681},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_4070":339,"_34195":274,"_23354":57683,"_5":16137,"_30763":57517,"_3518":57684},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_4070":340,"_34195":274,"_23354":57686,"_5":16137,"_30763":57521,"_3518":57687},[],"Check, in order:",{"_4070":341,"_34195":274,"_23354":57689,"_5":16137,"_30763":57521,"_3518":57690},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_4070":342,"_34195":274,"_23354":57692,"_5":16137,"_30763":57521,"_3518":57693},[],"Its status contains the expected address.",{"_4070":343,"_34195":274,"_23354":57695,"_5":16137,"_30763":57521,"_3518":57696},[],"The generated `LoadBalancer` Service has a usable external address.",{"_4070":344,"_34195":274,"_23354":57698,"_5":16137,"_30763":57521,"_3518":57699},[],"Port 443 reaches that address from the client network.",{"_4070":345,"_34195":274,"_23354":57701,"_5":16137,"_30763":57521,"_3518":57702},[],"DNS resolves to the externally reachable endpoint.",{"_4070":346,"_34195":274,"_23354":57704,"_5":16137,"_30763":57521,"_3518":57705},[],"The certificate contains the DNS name or IP used by the client.",{"_4070":347,"_34195":274,"_23354":57707,"_5":16137,"_30763":57521,"_3518":57708},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_4070":348,"_34195":348,"_5":16540,"_3518":56779,"_34626":57710,"_23354":57711,"_30763":348},[56672,56673,56779],[],{"_4070":349,"_34195":348,"_23354":57713,"_5":16137,"_30763":348,"_3518":57714},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_4070":350,"_34195":348,"_5":34623,"_23354":57716,"_30763":57717,"_3518":57718},[],"/docs/pr-preview/pr-58/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_4070":351,"_34195":348,"_5":34623,"_23354":57720,"_30763":57721,"_3518":57722},[],"/docs/pr-preview/pr-58/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_4070":352,"_34195":348,"_5":34623,"_23354":57724,"_30763":57725,"_3518":57726},[],"/docs/pr-preview/pr-58/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_4070":353,"_34195":348,"_5":34623,"_23354":57728,"_30763":57729,"_3518":57730},[],"/docs/pr-preview/pr-58/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_4070":354,"_34195":348,"_5":34623,"_23354":57732,"_30763":57733,"_3518":57734},[],"/docs/pr-preview/pr-58/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_4070":355,"_34195":348,"_5":34623,"_23354":57736,"_30763":57737,"_3518":57738},[],"/docs/pr-preview/pr-58/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_4070":356,"_34195":348,"_23354":57740,"_5":16137,"_30763":57717,"_3518":57741},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_4070":357,"_34195":348,"_23354":57743,"_5":16137,"_30763":57721,"_3518":57744},[],"Workflow",{"_4070":358,"_34195":348,"_23354":57746,"_5":16137,"_30763":57721,"_3518":57747},[],"Use it for",{"_4070":359,"_34195":348,"_23354":57749,"_5":16137,"_30763":57721,"_3518":57750},[],"What it installs",{"_4070":360,"_34195":348,"_23354":57752,"_5":16137,"_30763":57721,"_3518":57753},[],"Helm",{"_4070":361,"_34195":348,"_23354":57755,"_5":16137,"_30763":57721,"_3518":57756},[],"Production and controlled environments",{"_4070":362,"_34195":348,"_23354":57758,"_5":16137,"_30763":57721,"_3518":57759},[],"Lamassu services and Gateway API resources",{"_4070":363,"_34195":348,"_23354":57761,"_5":16137,"_30763":57721,"_3518":56916},[],{"_4070":364,"_34195":348,"_23354":57763,"_5":16137,"_30763":57721,"_3518":57764},[],"Evaluation, demos, CI and small lab clusters",{"_4070":365,"_34195":348,"_23354":57766,"_5":16137,"_30763":57721,"_3518":57767},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_4070":366,"_34195":348,"_23354":57769,"_5":16137,"_30763":57725,"_3518":57770},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_4070":367,"_34195":348,"_23354":57772,"_5":16137,"_30763":57725,"_3518":57773},[],"Area",{"_4070":368,"_34195":348,"_23354":57775,"_5":16137,"_30763":57725,"_3518":57776},[],"The Lamassu chart provides",{"_4070":369,"_34195":348,"_23354":57778,"_5":16137,"_30763":57725,"_3518":57779},[],"You provide",{"_4070":370,"_34195":348,"_23354":57781,"_5":16137,"_30763":57725,"_3518":57782},[],"Lamassu applications",{"_4070":371,"_34195":348,"_23354":57784,"_5":16137,"_30763":57725,"_3518":57785},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_4070":372,"_34195":348,"_23354":57787,"_5":16137,"_30763":57725,"_3518":57788},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_4070":373,"_34195":348,"_23354":57790,"_5":16137,"_30763":57725,"_3518":57791},[],"PostgreSQL data",{"_4070":374,"_34195":348,"_23354":57793,"_5":16137,"_30763":57725,"_3518":57794},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_4070":375,"_34195":348,"_23354":57796,"_5":16137,"_30763":57725,"_3518":57797},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_4070":376,"_34195":348,"_23354":57799,"_5":16137,"_30763":57725,"_3518":57800},[],"Messaging",{"_4070":377,"_34195":348,"_23354":57802,"_5":16137,"_30763":57725,"_3518":57803},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_4070":378,"_34195":348,"_23354":57805,"_5":16137,"_30763":57725,"_3518":57806},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_4070":379,"_34195":348,"_23354":57808,"_5":16137,"_30763":57725,"_3518":57809},[],"Identity",{"_4070":380,"_34195":348,"_23354":57811,"_5":16137,"_30763":57725,"_3518":57812},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_4070":381,"_34195":348,"_23354":57814,"_5":16137,"_30763":57725,"_3518":57815},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_4070":382,"_34195":348,"_23354":57817,"_5":16137,"_30763":57725,"_3518":57818},[],"External routing",{"_4070":383,"_34195":348,"_23354":57820,"_5":16137,"_30763":57725,"_3518":57821},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_4070":384,"_34195":348,"_23354":57823,"_5":16137,"_30763":57725,"_3518":57824},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_4070":385,"_34195":348,"_23354":57826,"_5":16137,"_30763":57725,"_3518":57827},[],"TLS",{"_4070":386,"_34195":348,"_23354":57829,"_5":16137,"_30763":57725,"_3518":57830},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_4070":387,"_34195":348,"_23354":57832,"_5":16137,"_30763":57725,"_3518":57833},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_4070":388,"_34195":348,"_23354":57835,"_5":16137,"_30763":57725,"_3518":57836},[],"Persistent application data",{"_4070":389,"_34195":348,"_23354":57838,"_5":16137,"_30763":57725,"_3518":57839},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_4070":390,"_34195":348,"_23354":57841,"_5":16137,"_30763":57725,"_3518":57842},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_4070":391,"_34195":348,"_23354":57844,"_5":16137,"_30763":57725,"_3518":57845},[],"Optional integrations",{"_4070":392,"_34195":348,"_23354":57847,"_5":16137,"_30763":57725,"_3518":57848},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_4070":393,"_34195":348,"_23354":57850,"_5":16137,"_30763":57725,"_3518":57851},[],"The observability backends, cloud credentials and production HSM or external key service",{"_4070":394,"_34195":348,"_23354":57853,"_5":16137,"_30763":57725,"_3518":57854},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_4070":395,"_34195":348,"_23354":57856,"_5":16137,"_30763":57725,"_3518":57857},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_4070":396,"_34195":348,"_23354":57859,"_5":16137,"_30763":57729,"_3518":57860},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_4070":397,"_34195":348,"_23354":57862,"_5":16137,"_30763":57729,"_3518":57863},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_4070":398,"_34195":348,"_23354":57865,"_5":16137,"_30763":57733,"_3518":57866},[],"Kubernetes 1.24 or newer",{"_4070":399,"_34195":348,"_23354":57868,"_5":16137,"_30763":57733,"_3518":57869},[],"Helm 3.2 or newer",{"_4070":400,"_34195":348,"_23354":57871,"_5":16137,"_30763":57733,"_3518":57872},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_4070":401,"_34195":348,"_23354":57874,"_5":16137,"_30763":57733,"_3518":57875},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_4070":402,"_34195":348,"_23354":57877,"_5":16137,"_30763":57733,"_3518":57878},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_4070":403,"_34195":348,"_23354":57880,"_5":16137,"_30763":57733,"_3518":57881},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_4070":404,"_34195":348,"_23354":57883,"_5":16137,"_30763":57733,"_3518":57884},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_4070":405,"_34195":348,"_23354":57886,"_5":16137,"_30763":57737,"_3518":57887},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_4070":406,"_34195":348,"_23354":57889,"_5":16137,"_30763":57737,"_3518":57890},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_4070":407,"_34195":348,"_23354":57892,"_5":16137,"_30763":57737,"_3518":57893},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_4070":408,"_34195":348,"_23354":57895,"_5":16137,"_30763":57737,"_3518":57896},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_4070":409,"_34195":409,"_5":16540,"_3518":57898,"_34626":57899,"_23354":57901,"_30763":409},"Deployment troubleshooting",[56672,56673,57900],"Operations",[],{"_4070":410,"_34195":409,"_23354":57903,"_5":16137,"_30763":409,"_3518":57904},[],"Diagnose access, service health and infrastructure dependencies.",{"_4070":411,"_34195":409,"_5":34623,"_23354":57906,"_30763":57907,"_3518":57908},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_4070":412,"_34195":409,"_5":34623,"_23354":57910,"_30763":57911,"_3518":57912},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_4070":413,"_34195":409,"_5":34623,"_23354":57914,"_30763":57915,"_3518":57916},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_4070":414,"_34195":409,"_5":34623,"_23354":57918,"_30763":57919,"_3518":57920},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_4070":415,"_34195":409,"_5":34623,"_23354":57922,"_30763":57923,"_3518":57924},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_4070":416,"_34195":409,"_5":34623,"_23354":57926,"_30763":57927,"_3518":57928},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_4070":417,"_34195":409,"_5":34623,"_23354":57930,"_30763":57931,"_3518":57932},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_4070":418,"_34195":409,"_5":34623,"_23354":57934,"_30763":57935,"_3518":57936},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_4070":419,"_34195":409,"_5":34623,"_23354":57938,"_30763":57939,"_3518":57940},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_4070":420,"_34195":409,"_5":34623,"_23354":57942,"_30763":57943,"_3518":57944},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#api-500-errors","API 500 errors",{"_4070":421,"_34195":409,"_5":34623,"_23354":57946,"_30763":57947,"_3518":57948},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_4070":422,"_34195":409,"_5":34623,"_23354":57950,"_30763":57951,"_3518":57952},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_4070":423,"_34195":409,"_5":34623,"_23354":57954,"_30763":57955,"_3518":57956},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#observability","Observability",{"_4070":424,"_34195":409,"_23354":57958,"_5":16137,"_30763":409,"_3518":57959},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_4070":425,"_34195":409,"_23354":57961,"_5":16137,"_30763":57911,"_3518":57962},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_4070":426,"_34195":409,"_23354":57964,"_5":16137,"_30763":57915,"_3518":57965},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_4070":427,"_34195":409,"_23354":57967,"_5":16137,"_30763":57919,"_3518":57968},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_4070":428,"_34195":409,"_23354":57970,"_5":16137,"_30763":57923,"_3518":57971},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_4070":429,"_34195":409,"_23354":57973,"_5":16137,"_30763":57927,"_3518":57974},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_4070":430,"_34195":409,"_23354":57976,"_5":16137,"_30763":57931,"_3518":57977},[],"Replace the placeholders with your real release, namespace and deployment.",{"_4070":431,"_34195":409,"_23354":57979,"_5":16137,"_30763":57931,"_3518":57980},[],"Also run the chart's connectivity test:",{"_4070":432,"_34195":409,"_23354":57982,"_5":16137,"_30763":57931,"_3518":57983},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_4070":433,"_34195":409,"_23354":57985,"_5":16137,"_30763":57931,"_3518":57986},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_4070":434,"_34195":409,"_23354":57988,"_5":16137,"_30763":57935,"_3518":57989},[],"If you receive a 401:",{"_4070":435,"_34195":409,"_23354":57991,"_5":16137,"_30763":57935,"_3518":57992},[],"check that the UI's OIDC authority is reachable from the browser;",{"_4070":436,"_34195":409,"_23354":57994,"_5":16137,"_30763":57935,"_3518":57995},[],"verify issuer, audience and expiration of the token;",{"_4070":437,"_34195":409,"_23354":57997,"_5":16137,"_30763":57935,"_3518":57998},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_4070":438,"_34195":409,"_23354":58000,"_5":16137,"_30763":57935,"_3518":58001},[],"check that the provider's public and internal routes point to the same realm.",{"_4070":439,"_34195":409,"_23354":58003,"_5":16137,"_30763":57935,"_3518":58004},[],"If login succeeds but the APIs return 403:",{"_4070":440,"_34195":409,"_23354":58006,"_5":16137,"_30763":57935,"_3518":58007},[],"inspect the token's real claims;",{"_4070":441,"_34195":409,"_23354":58009,"_5":16137,"_30763":57935,"_3518":58010},[],"confirm they match an active principal;",{"_4070":442,"_34195":409,"_23354":58012,"_5":16137,"_30763":57935,"_3518":58013},[],"review the policies granted to that principal;",{"_4070":443,"_34195":409,"_23354":58015,"_5":16137,"_30763":57935,"_3518":58016},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_4070":444,"_34195":409,"_23354":58018,"_5":16137,"_30763":57935,"_3518":58019},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_4070":445,"_34195":409,"_23354":58021,"_5":16137,"_30763":57939,"_3518":58022},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_4070":446,"_34195":409,"_23354":58024,"_5":16137,"_30763":57939,"_3518":58025},[],"Locate the authz pod and Service.",{"_4070":447,"_34195":409,"_23354":58027,"_5":16137,"_30763":57939,"_3518":58028},[],"Check /health, logs and its database connection.",{"_4070":448,"_34195":409,"_23354":58030,"_5":16137,"_30763":57939,"_3518":58031},[],"Verify the DNS and port configured in externalAuthorization.",{"_4070":449,"_34195":409,"_23354":58033,"_5":16137,"_30763":57939,"_3518":58034},[],"Check the check route is /v1/ext\\_authz/check.",{"_4070":450,"_34195":409,"_23354":58036,"_5":16137,"_30763":57939,"_3518":58037},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_4070":451,"_34195":409,"_23354":58039,"_5":16137,"_30763":57943,"_3518":58040},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_4070":452,"_34195":409,"_23354":58042,"_5":16137,"_30763":57947,"_3518":58043},[],"Review kubectl describe pod first. Common causes are:",{"_4070":453,"_34195":409,"_23354":58045,"_5":16137,"_30763":57947,"_3518":58046},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_4070":454,"_34195":409,"_23354":58048,"_5":16137,"_30763":57947,"_3518":58049},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_4070":455,"_34195":409,"_23354":58051,"_5":16137,"_30763":57947,"_3518":58052},[],"unbound persistent volume;",{"_4070":456,"_34195":409,"_23354":58054,"_5":16137,"_30763":57947,"_3518":58055},[],"inaccessible image or incorrect pull policy;",{"_4070":457,"_34195":409,"_23354":58057,"_5":16137,"_30763":57947,"_3518":58058},[],"invalid cryptographic engine configuration;",{"_4070":458,"_34195":409,"_23354":58060,"_5":16137,"_30763":57947,"_3518":58061},[],"CPU or memory limits set too low;",{"_4070":459,"_34195":409,"_23354":58063,"_5":16137,"_30763":57947,"_3518":58064},[],"an incomplete prior migration.",{"_4070":460,"_34195":409,"_23354":58066,"_5":16137,"_30763":57947,"_3518":58067},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_4070":461,"_34195":409,"_23354":58069,"_5":16137,"_30763":57947,"_3518":58070},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_4070":462,"_34195":409,"_23354":58072,"_5":16137,"_30763":57947,"_3518":58073},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_4070":463,"_34195":409,"_23354":58075,"_5":16137,"_30763":57951,"_3518":58076},[],"Domain and audit events depend on the bus publisher:",{"_4070":464,"_34195":409,"_23354":58078,"_5":16137,"_30763":57951,"_3518":58079},[],"verify it is enabled in the emitting service;",{"_4070":465,"_34195":409,"_23354":58081,"_5":16137,"_30763":57951,"_3518":58082},[],"check AMQP connectivity and credentials;",{"_4070":466,"_34195":409,"_23354":58084,"_5":16137,"_30763":57951,"_3518":58085},[],"review exchange, routing key, queues and consumers;",{"_4070":467,"_34195":409,"_23354":58087,"_5":16137,"_30763":57951,"_3518":58088},[],"inspect dead-letter queues;",{"_4070":468,"_34195":409,"_23354":58090,"_5":16137,"_30763":57951,"_3518":58091},[],"alert on orphan durable queues and backlog growth.",{"_4070":469,"_34195":409,"_23354":58093,"_5":16137,"_30763":57951,"_3518":58094},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_4070":470,"_34195":409,"_23354":58096,"_5":16137,"_30763":57951,"_3518":58097},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_4070":471,"_34195":409,"_23354":58099,"_5":16137,"_30763":57951,"_3518":58100},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_4070":472,"_34195":409,"_23354":58102,"_5":16137,"_30763":57951,"_3518":58103},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_4070":473,"_34195":409,"_23354":58105,"_5":16137,"_30763":57951,"_3518":58106},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_4070":474,"_34195":409,"_23354":58108,"_5":16137,"_30763":57951,"_3518":58109},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_4070":475,"_34195":409,"_23354":58111,"_5":16137,"_30763":57951,"_3518":58112},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_4070":476,"_34195":409,"_23354":58114,"_5":16137,"_30763":57955,"_3518":58115},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_4070":477,"_34195":409,"_23354":58117,"_5":16137,"_30763":57955,"_3518":58118},[],"Before closing an incident, record:",{"_4070":478,"_34195":409,"_23354":58120,"_5":16137,"_30763":57955,"_3518":58121},[],"the confirmed cause;",{"_4070":479,"_34195":409,"_23354":58123,"_5":16137,"_30763":57955,"_3518":58124},[],"the time scope and affected resources;",{"_4070":480,"_34195":409,"_23354":58126,"_5":16137,"_30763":57955,"_3518":58127},[],"the commands or queries used;",{"_4070":481,"_34195":409,"_23354":58129,"_5":16137,"_30763":57955,"_3518":58130},[],"the applied change and how to revert it;",{"_4070":482,"_34195":409,"_23354":58132,"_5":16137,"_30763":57955,"_3518":58133},[],"validation from a consumer;",{"_4070":483,"_34195":409,"_23354":58135,"_5":16137,"_30763":57955,"_3518":58136},[],"the preventive action and its owner.",{"_4070":484,"_34195":484,"_5":16540,"_3518":58138,"_34626":58139,"_23354":58142,"_30763":484},"Access control",[56672,58140,58141],"Platform","Administration",[],{"_4070":485,"_34195":484,"_23354":58144,"_5":16137,"_30763":484,"_3518":58145},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_4070":486,"_34195":484,"_5":34623,"_23354":58147,"_30763":58148,"_3518":58149},[],"/docs/pr-preview/pr-58/platform/administration/access-control#essential-concepts","Essential concepts",{"_4070":487,"_34195":484,"_5":34623,"_23354":58151,"_30763":58152,"_3518":58153},[],"/docs/pr-preview/pr-58/platform/administration/access-control#two-decision-systems","Two decision systems",{"_4070":488,"_34195":484,"_5":34623,"_23354":58155,"_30763":58156,"_3518":58157},[],"/docs/pr-preview/pr-58/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_4070":489,"_34195":484,"_5":34623,"_23354":58159,"_30763":58160,"_3518":58161},[],"/docs/pr-preview/pr-58/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_4070":490,"_34195":484,"_5":34623,"_23354":58163,"_30763":58164,"_3518":58165},[],"/docs/pr-preview/pr-58/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_4070":491,"_34195":484,"_5":34623,"_23354":58167,"_30763":58168,"_3518":58169},[],"/docs/pr-preview/pr-58/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_4070":492,"_34195":484,"_5":34623,"_23354":58171,"_30763":58172,"_3518":58173},[],"/docs/pr-preview/pr-58/platform/administration/access-control#oidc-principals","OIDC principals",{"_4070":493,"_34195":484,"_5":34623,"_23354":58175,"_30763":58176,"_3518":58177},[],"/docs/pr-preview/pr-58/platform/administration/access-control#x509-principals","X.509 principals",{"_4070":494,"_34195":484,"_5":34623,"_23354":58179,"_30763":58180,"_3518":58181},[],"/docs/pr-preview/pr-58/platform/administration/access-control#when-several-principals-match","When several principals match",{"_4070":495,"_34195":484,"_5":34623,"_23354":58183,"_30763":58184,"_3518":58185},[],"/docs/pr-preview/pr-58/platform/administration/access-control#how-policies-express-access","How policies express access",{"_4070":496,"_34195":484,"_5":34623,"_23354":58187,"_30763":58188,"_3518":58189},[],"/docs/pr-preview/pr-58/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_4070":497,"_34195":484,"_5":34623,"_23354":58191,"_30763":58192,"_3518":58193},[],"/docs/pr-preview/pr-58/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_4070":498,"_34195":484,"_5":34623,"_23354":58195,"_30763":58196,"_3518":58197},[],"/docs/pr-preview/pr-58/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_4070":499,"_34195":484,"_5":34623,"_23354":58199,"_30763":58200,"_3518":58201},[],"/docs/pr-preview/pr-58/platform/administration/access-control#http-rules","HTTP rules",{"_4070":500,"_34195":484,"_5":34623,"_23354":58203,"_30763":58204,"_3518":58205},[],"/docs/pr-preview/pr-58/platform/administration/access-control#included-policies","Included policies",{"_4070":501,"_34195":484,"_5":34623,"_23354":58207,"_30763":58208,"_3518":57312},[],"/docs/pr-preview/pr-58/platform/administration/access-control#provision-the-first-administrator",{"_4070":502,"_34195":484,"_5":34623,"_23354":58210,"_30763":58211,"_3518":58212},[],"/docs/pr-preview/pr-58/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_4070":503,"_34195":484,"_5":34623,"_23354":58214,"_30763":58215,"_3518":58216},[],"/docs/pr-preview/pr-58/platform/administration/access-control#configure-token-validation","Configure token validation",{"_4070":504,"_34195":484,"_5":34623,"_23354":58218,"_30763":58219,"_3518":58220},[],"/docs/pr-preview/pr-58/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_4070":505,"_34195":484,"_5":34623,"_23354":58222,"_30763":58223,"_3518":58224},[],"/docs/pr-preview/pr-58/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_4070":506,"_34195":484,"_5":34623,"_23354":58226,"_30763":58227,"_3518":58228},[],"/docs/pr-preview/pr-58/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_4070":507,"_34195":484,"_5":34623,"_23354":58230,"_30763":58231,"_3518":58232},[],"/docs/pr-preview/pr-58/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_4070":508,"_34195":484,"_5":34623,"_23354":58234,"_30763":58235,"_3518":58236},[],"/docs/pr-preview/pr-58/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_4070":509,"_34195":484,"_5":34623,"_23354":58238,"_30763":58239,"_3518":58240},[],"/docs/pr-preview/pr-58/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_4070":510,"_34195":484,"_5":34623,"_23354":58242,"_30763":58243,"_3518":58244},[],"/docs/pr-preview/pr-58/platform/administration/access-control#operational-checklist","Operational checklist",{"_4070":511,"_34195":484,"_5":34623,"_23354":58246,"_30763":58247,"_3518":58248},[],"/docs/pr-preview/pr-58/platform/administration/access-control#diagnostics","Diagnostics",{"_4070":512,"_34195":484,"_5":34623,"_23354":58250,"_30763":58251,"_3518":58252},[],"/docs/pr-preview/pr-58/platform/administration/access-control#the-response-is-401","The response is 401",{"_4070":513,"_34195":484,"_5":34623,"_23354":58254,"_30763":58255,"_3518":58256},[],"/docs/pr-preview/pr-58/platform/administration/access-control#the-response-is-403","The response is 403",{"_4070":514,"_34195":484,"_5":34623,"_23354":58258,"_30763":58259,"_3518":58260},[],"/docs/pr-preview/pr-58/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_4070":515,"_34195":484,"_5":34623,"_23354":58262,"_30763":58263,"_3518":58264},[],"/docs/pr-preview/pr-58/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_4070":516,"_34195":484,"_5":34623,"_23354":58266,"_30763":58267,"_3518":58268},[],"/docs/pr-preview/pr-58/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_4070":517,"_34195":484,"_23354":58270,"_5":16137,"_30763":484,"_3518":58271},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_4070":518,"_34195":484,"_23354":58273,"_5":16137,"_30763":484,"_3518":58274},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_4070":519,"_34195":484,"_23354":58276,"_5":16137,"_30763":484,"_3518":58277},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_4070":520,"_34195":484,"_23354":58279,"_5":16137,"_30763":58148,"_3518":58280},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_4070":521,"_34195":484,"_23354":58282,"_5":16137,"_30763":58148,"_3518":58283},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_4070":522,"_34195":484,"_23354":58285,"_5":16137,"_30763":58148,"_3518":58286},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_4070":523,"_34195":484,"_23354":58288,"_5":16137,"_30763":58148,"_3518":58289},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_4070":524,"_34195":484,"_23354":58291,"_5":16137,"_30763":58148,"_3518":58292},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_4070":525,"_34195":484,"_23354":58294,"_5":16137,"_30763":58148,"_3518":58295},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_4070":526,"_34195":484,"_23354":58297,"_5":16137,"_30763":58152,"_3518":58298},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_4070":527,"_34195":484,"_23354":58300,"_5":16137,"_30763":58152,"_3518":58301},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_4070":528,"_34195":484,"_23354":58303,"_5":16137,"_30763":58156,"_3518":58304},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_4070":529,"_34195":484,"_23354":58306,"_5":16137,"_30763":58156,"_3518":58307},[],"The decision is made **before forwarding the request to the service**:",{"_4070":530,"_34195":484,"_23354":58309,"_5":16137,"_30763":58156,"_3518":58310},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_4070":531,"_34195":484,"_23354":58312,"_5":16137,"_30763":58156,"_3518":58313},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_4070":532,"_34195":484,"_23354":58315,"_5":16137,"_30763":58156,"_3518":58316},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_4070":533,"_34195":484,"_23354":58318,"_5":16137,"_30763":58156,"_3518":58319},[],"It separately loads the policies granted to each principal.",{"_4070":534,"_34195":484,"_23354":58321,"_5":16137,"_30763":58156,"_3518":58322},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_4070":535,"_34195":484,"_23354":58324,"_5":16137,"_30763":58156,"_3518":58325},[],"`authz` looks for an HTTP rule granting that action.",{"_4070":536,"_34195":484,"_23354":58327,"_5":16137,"_30763":58156,"_3518":58328},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_4070":537,"_34195":484,"_23354":58330,"_5":16137,"_30763":58156,"_3518":58331},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_4070":538,"_34195":484,"_23354":58333,"_5":16137,"_30763":58156,"_3518":58334},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_4070":539,"_34195":484,"_23354":58336,"_5":16137,"_30763":58156,"_3518":58337},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_4070":540,"_34195":484,"_23354":58339,"_5":16137,"_30763":58160,"_3518":58340},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_4070":541,"_34195":484,"_23354":58342,"_5":16137,"_30763":58160,"_3518":58343},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_4070":542,"_34195":484,"_23354":58345,"_5":16137,"_30763":58160,"_3518":58346},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_4070":543,"_34195":484,"_23354":58348,"_5":16137,"_30763":58160,"_3518":58349},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_4070":544,"_34195":484,"_23354":58351,"_5":16137,"_30763":58160,"_3518":58352},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_4070":545,"_34195":484,"_23354":58354,"_5":16137,"_30763":58160,"_3518":58355},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_4070":546,"_34195":484,"_23354":58357,"_5":16137,"_30763":58160,"_3518":58358},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_4070":547,"_34195":484,"_23354":58360,"_5":16137,"_30763":58160,"_3518":58361},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_4070":548,"_34195":484,"_23354":58363,"_5":16137,"_30763":58164,"_3518":58364},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_4070":549,"_34195":484,"_23354":58366,"_5":16137,"_30763":58164,"_3518":58367},[],"The decision is made with the domain operation context:",{"_4070":550,"_34195":484,"_23354":58369,"_5":16137,"_30763":58164,"_3518":58370},[],"The middleware extracts the credential and resolves the matching principals.",{"_4070":551,"_34195":484,"_23354":58372,"_5":16137,"_30763":58164,"_3518":58373},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_4070":552,"_34195":484,"_23354":58375,"_5":16137,"_30763":58164,"_3518":58376},[],"`authz` gathers the entity rules of the granted policies.",{"_4070":553,"_34195":484,"_23354":58378,"_5":16137,"_30763":58164,"_3518":58379},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_4070":554,"_34195":484,"_23354":58381,"_5":16137,"_30763":58164,"_3518":58382},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_4070":555,"_34195":484,"_23354":58384,"_5":16137,"_30763":58164,"_3518":58385},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_4070":556,"_34195":484,"_23354":58387,"_5":16137,"_30763":58164,"_3518":58388},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_4070":557,"_34195":484,"_23354":58390,"_5":16137,"_30763":58164,"_3518":58391},[],"Actions fall into two groups:",{"_4070":558,"_34195":484,"_23354":58393,"_5":16137,"_30763":58164,"_3518":58394},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_4070":559,"_34195":484,"_23354":58396,"_5":16137,"_30763":58164,"_3518":58397},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_4070":560,"_34195":484,"_23354":58399,"_5":16137,"_30763":58164,"_3518":58400},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_4070":561,"_34195":484,"_23354":58402,"_5":16137,"_30763":58168,"_3518":58403},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_4070":562,"_34195":484,"_23354":58405,"_5":16137,"_30763":58168,"_3518":58406},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_4070":563,"_34195":484,"_23354":58408,"_5":16137,"_30763":58168,"_3518":58409},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_4070":564,"_34195":484,"_23354":58411,"_5":16137,"_30763":58172,"_3518":58412},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_4070":565,"_34195":484,"_23354":58414,"_5":16137,"_30763":58172,"_3518":58415},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_4070":566,"_34195":484,"_23354":58417,"_5":16137,"_30763":58172,"_3518":58418},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_4070":567,"_34195":484,"_23354":58420,"_5":16137,"_30763":58172,"_3518":58421},[],"The implemented operators are:",{"_4070":568,"_34195":484,"_23354":58423,"_5":16137,"_30763":58172,"_3518":58424},[],"`equals`, for exact equality;",{"_4070":569,"_34195":484,"_23354":58426,"_5":16137,"_30763":58172,"_3518":58427},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_4070":570,"_34195":484,"_23354":58429,"_5":16137,"_30763":58172,"_3518":58430},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_4070":571,"_34195":484,"_23354":58432,"_5":16137,"_30763":58172,"_3518":58433},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_4070":572,"_34195":484,"_23354":58435,"_5":16137,"_30763":58176,"_3518":58436},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_4070":573,"_34195":484,"_23354":58438,"_5":16137,"_30763":58176,"_3518":58439},[],"The available modes are:",{"_4070":574,"_34195":484,"_23354":58441,"_5":16137,"_30763":58176,"_3518":58442},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_4070":575,"_34195":484,"_23354":58444,"_5":16137,"_30763":58176,"_3518":58445},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_4070":576,"_34195":484,"_23354":58447,"_5":16137,"_30763":58176,"_3518":58448},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_4070":577,"_34195":484,"_23354":58450,"_5":16137,"_30763":58176,"_3518":58451},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_4070":578,"_34195":484,"_23354":58453,"_5":16137,"_30763":58176,"_3518":58454},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_4070":579,"_34195":484,"_23354":58456,"_5":16137,"_30763":58176,"_3518":58457},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_4070":580,"_34195":484,"_23354":58459,"_5":16137,"_30763":58180,"_3518":58460},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_4070":581,"_34195":484,"_23354":58462,"_5":16137,"_30763":58180,"_3518":58463},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_4070":582,"_34195":484,"_23354":58465,"_5":16137,"_30763":58180,"_3518":58466},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_4070":583,"_34195":484,"_23354":58468,"_5":16137,"_30763":58180,"_3518":58469},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_4070":584,"_34195":484,"_23354":58471,"_5":16137,"_30763":58188,"_3518":58472},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_4070":585,"_34195":484,"_23354":58474,"_5":16137,"_30763":58188,"_3518":58475},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_4070":586,"_34195":484,"_23354":58477,"_5":16137,"_30763":58192,"_3518":58478},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_4070":587,"_34195":484,"_23354":58480,"_5":16137,"_30763":58192,"_3518":58481},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_4070":588,"_34195":484,"_23354":58483,"_5":16137,"_30763":58196,"_3518":58484},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_4070":589,"_34195":484,"_23354":58486,"_5":16137,"_30763":58196,"_3518":58487},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_4070":590,"_34195":484,"_23354":58489,"_5":16137,"_30763":58196,"_3518":58490},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_4070":591,"_34195":484,"_23354":58492,"_5":16137,"_30763":58200,"_3518":58493},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_4070":592,"_34195":484,"_23354":58495,"_5":16137,"_30763":58200,"_3518":58496},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_4070":593,"_34195":484,"_23354":58498,"_5":16137,"_30763":58200,"_3518":58499},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_4070":594,"_34195":484,"_23354":58501,"_5":16137,"_30763":58200,"_3518":58502},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_4070":595,"_34195":484,"_23354":58504,"_5":16137,"_30763":58200,"_3518":58505},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_4070":596,"_34195":484,"_23354":58507,"_5":16137,"_30763":58200,"_3518":58508},[],"Note that:",{"_4070":597,"_34195":484,"_23354":58510,"_5":16137,"_30763":58200,"_3518":58511},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_4070":598,"_34195":484,"_23354":58513,"_5":16137,"_30763":58200,"_3518":58514},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_4070":599,"_34195":484,"_23354":58516,"_5":16137,"_30763":58200,"_3518":58517},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_4070":600,"_34195":484,"_23354":58519,"_5":16137,"_30763":58204,"_3518":58520},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_4070":601,"_34195":484,"_23354":58522,"_5":16137,"_30763":58204,"_3518":58523},[],"full and read-only access to certificates and authorities;",{"_4070":602,"_34195":484,"_23354":58525,"_5":16137,"_30763":58204,"_3518":58526},[],"full and read-only access to the KMS;",{"_4070":603,"_34195":484,"_23354":58528,"_5":16137,"_30763":58204,"_3518":58529},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_4070":604,"_34195":484,"_23354":58531,"_5":16137,"_30763":58204,"_3518":58532},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_4070":605,"_34195":484,"_23354":58534,"_5":16137,"_30763":58204,"_3518":58535},[],"console access;",{"_4070":606,"_34195":484,"_23354":58537,"_5":16137,"_30763":58204,"_3518":58538},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_4070":607,"_34195":484,"_23354":58540,"_5":16137,"_30763":58204,"_3518":58541},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_4070":608,"_34195":484,"_23354":58543,"_5":16137,"_30763":58204,"_3518":58544},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_4070":609,"_34195":484,"_23354":58546,"_5":16137,"_30763":58208,"_3518":58547},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_4070":610,"_34195":484,"_23354":58549,"_5":16137,"_30763":58208,"_3518":58550},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_4070":611,"_34195":484,"_23354":58552,"_5":16137,"_30763":58208,"_3518":58553},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_4070":612,"_34195":484,"_23354":58555,"_5":16137,"_30763":58211,"_3518":58556},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_4070":613,"_34195":484,"_23354":58558,"_5":16137,"_30763":58215,"_3518":58559},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_4070":614,"_34195":484,"_23354":58561,"_5":16137,"_30763":58215,"_3518":58562},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_4070":615,"_34195":484,"_23354":58564,"_5":16137,"_30763":58219,"_3518":58565},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_4070":616,"_34195":484,"_23354":58567,"_5":16137,"_30763":58223,"_3518":58568},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_4070":617,"_34195":484,"_23354":58570,"_5":16137,"_30763":58227,"_3518":58571},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_4070":618,"_34195":484,"_23354":58573,"_5":16137,"_30763":58231,"_3518":58574},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_4070":619,"_34195":484,"_23354":58576,"_5":16137,"_30763":58231,"_3518":58577},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_4070":620,"_34195":484,"_23354":58579,"_5":16137,"_30763":58235,"_3518":58580},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_4070":621,"_34195":484,"_23354":58582,"_5":16137,"_30763":58235,"_3518":58583},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_4070":622,"_34195":484,"_23354":58585,"_5":16137,"_30763":58235,"_3518":58586},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_4070":623,"_34195":484,"_23354":58588,"_5":16137,"_30763":58235,"_3518":58589},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_4070":624,"_34195":484,"_23354":58591,"_5":16137,"_30763":58235,"_3518":58592},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_4070":625,"_34195":484,"_23354":58594,"_5":16137,"_30763":58235,"_3518":58595},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_4070":626,"_34195":484,"_23354":58597,"_5":16137,"_30763":58235,"_3518":58598},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_4070":627,"_34195":484,"_23354":58600,"_5":16137,"_30763":58235,"_3518":58601},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_4070":628,"_34195":484,"_23354":58603,"_5":16137,"_30763":58239,"_3518":58604},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_4070":629,"_34195":484,"_23354":58606,"_5":16137,"_30763":58239,"_3518":58607},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_4070":630,"_34195":484,"_23354":58609,"_5":16137,"_30763":58239,"_3518":58610},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_4070":631,"_34195":484,"_23354":58612,"_5":16137,"_30763":58243,"_3518":58613},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_4070":632,"_34195":484,"_23354":58615,"_5":16137,"_30763":58243,"_3518":58616},[],"Use groups or stable roles for people and independent identities for automations.",{"_4070":633,"_34195":484,"_23354":58618,"_5":16137,"_30763":58243,"_3518":58619},[],"Keep at least two recovery administrators and test their access periodically.",{"_4070":634,"_34195":484,"_23354":58621,"_5":16137,"_30763":58243,"_3518":58622},[],"Review active principals, their matches and their grants after IdP changes.",{"_4070":635,"_34195":484,"_23354":58624,"_5":16137,"_30763":58243,"_3518":58625},[],"Search for wildcards in policies before upgrading Lamassu.",{"_4070":636,"_34195":484,"_23354":58627,"_5":16137,"_30763":58243,"_3518":58628},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_4070":637,"_34195":484,"_23354":58630,"_5":16137,"_30763":58243,"_3518":58631},[],"Always test one allowed and one denied operation for each role.",{"_4070":638,"_34195":484,"_23354":58633,"_5":16137,"_30763":58243,"_3518":58634},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_4070":639,"_34195":484,"_23354":58636,"_5":16137,"_30763":58251,"_3518":58637},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_4070":640,"_34195":484,"_23354":58639,"_5":16137,"_30763":58255,"_3518":58640},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_4070":641,"_34195":484,"_23354":58642,"_5":16137,"_30763":58255,"_3518":58643},[],"that an active principal of the correct type exists;",{"_4070":642,"_34195":484,"_23354":58645,"_5":16137,"_30763":58255,"_3518":58646},[],"that the claim paths and values match the real token exactly;",{"_4070":643,"_34195":484,"_23354":58648,"_5":16137,"_30763":58255,"_3518":58649},[],"that all of the principal's conditions hold;",{"_4070":644,"_34195":484,"_23354":58651,"_5":16137,"_30763":58255,"_3518":58652},[],"that the principal has the expected policy granted;",{"_4070":645,"_34195":484,"_23354":58654,"_5":16137,"_30763":58255,"_3518":58655},[],"that the policy includes the action and the requested resource type or route;",{"_4070":646,"_34195":484,"_23354":58657,"_5":16137,"_30763":58255,"_3518":58658},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_4070":647,"_34195":484,"_23354":58660,"_5":16137,"_30763":58255,"_3518":58661},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_4070":648,"_34195":484,"_23354":58663,"_5":16137,"_30763":58259,"_3518":58664},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_4070":649,"_34195":484,"_23354":58666,"_5":16137,"_30763":58263,"_3518":58667},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_4070":650,"_34195":484,"_23354":58669,"_5":16137,"_30763":58267,"_3518":58670},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_4070":651,"_34195":484,"_23354":58672,"_5":16137,"_30763":58267,"_3518":58673},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_4070":652,"_34195":652,"_5":16540,"_3518":58675,"_34626":58676,"_23354":58677,"_30763":652},"Alerts and subscriptions",[56672,58140,58141],[],{"_4070":653,"_34195":652,"_23354":58679,"_5":16137,"_30763":652,"_3518":58680},[],"Send PKI events to people and external systems.",{"_4070":654,"_34195":652,"_5":34623,"_23354":58682,"_30763":58683,"_3518":58684},[],"/docs/pr-preview/pr-58/platform/administration/alerts#how-it-works","How it works",{"_4070":655,"_34195":652,"_5":34623,"_23354":58686,"_30763":58687,"_3518":58688},[],"/docs/pr-preview/pr-58/platform/administration/alerts#available-channels","Available channels",{"_4070":656,"_34195":652,"_5":34623,"_23354":58690,"_30763":58691,"_3518":58692},[],"/docs/pr-preview/pr-58/platform/administration/alerts#create-a-subscription","Create a subscription",{"_4070":657,"_34195":652,"_5":34623,"_23354":58694,"_30763":58695,"_3518":58696},[],"/docs/pr-preview/pr-58/platform/administration/alerts#choose-the-event","Choose the event",{"_4070":658,"_34195":652,"_5":34623,"_23354":58698,"_30763":58699,"_3518":58700},[],"/docs/pr-preview/pr-58/platform/administration/alerts#configure-the-destination","Configure the destination",{"_4070":659,"_34195":652,"_5":34623,"_23354":58702,"_30763":58703,"_3518":58704},[],"/docs/pr-preview/pr-58/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_4070":660,"_34195":652,"_5":34623,"_23354":58706,"_30763":58707,"_3518":58708},[],"/docs/pr-preview/pr-58/platform/administration/alerts#review-and-activate","Review and activate",{"_4070":661,"_34195":652,"_5":34623,"_23354":58710,"_30763":58711,"_3518":58712},[],"/docs/pr-preview/pr-58/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_4070":662,"_34195":652,"_5":34623,"_23354":58714,"_30763":58715,"_3518":58716},[],"/docs/pr-preview/pr-58/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_4070":663,"_34195":652,"_5":34623,"_23354":58718,"_30763":58719,"_3518":58720},[],"/docs/pr-preview/pr-58/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_4070":664,"_34195":652,"_5":34623,"_23354":58722,"_30763":58723,"_3518":58724},[],"/docs/pr-preview/pr-58/platform/administration/alerts#event-families","Event families",{"_4070":665,"_34195":652,"_23354":58726,"_5":16137,"_30763":652,"_3518":58727},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_4070":666,"_34195":652,"_23354":58729,"_5":16137,"_30763":58683,"_3518":58730},[],"A service publishes a domain event.",{"_4070":667,"_34195":652,"_23354":58732,"_5":16137,"_30763":58683,"_3518":58733},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_4070":668,"_34195":652,"_23354":58735,"_5":16137,"_30763":58683,"_3518":58736},[],"Each subscription's filter decides whether it should be notified.",{"_4070":669,"_34195":652,"_23354":58738,"_5":16137,"_30763":58683,"_3518":58739},[],"Lamassu delivers the event to the configured channel.",{"_4070":670,"_34195":652,"_23354":58741,"_5":16137,"_30763":58683,"_3518":58742},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_4070":671,"_34195":652,"_23354":58744,"_5":16137,"_30763":58687,"_3518":58745},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_4070":672,"_34195":652,"_23354":58747,"_5":16137,"_30763":58687,"_3518":58748},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_4070":673,"_34195":652,"_23354":58750,"_5":16137,"_30763":58687,"_3518":58751},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_4070":674,"_34195":652,"_23354":58753,"_5":16137,"_30763":58687,"_3518":58754},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_4070":675,"_34195":652,"_23354":58756,"_5":16137,"_30763":58687,"_3518":58757},[],"`apikey_options` requires `header` and `key`.",{"_4070":676,"_34195":652,"_23354":58759,"_5":16137,"_30763":58687,"_3518":58760},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_4070":677,"_34195":652,"_23354":58762,"_5":16137,"_30763":58687,"_3518":58763},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_4070":678,"_34195":652,"_23354":58765,"_5":16137,"_30763":58687,"_3518":58766},[],"The alerts API reference documents the full `http_client` schema.",{"_4070":679,"_34195":652,"_23354":58768,"_5":16137,"_30763":58695,"_3518":58769},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_4070":680,"_34195":652,"_23354":58771,"_5":16137,"_30763":58699,"_3518":58772},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_4070":681,"_34195":652,"_23354":58774,"_5":16137,"_30763":58703,"_3518":58775},[],"Add a filter if you don't want to receive every instance of the event.",{"_4070":682,"_34195":652,"_23354":58777,"_5":16137,"_30763":58703,"_3518":58778},[],"**None** notifies all instances of the event.",{"_4070":683,"_34195":652,"_23354":58780,"_5":16137,"_30763":58703,"_3518":58781},[],"**JSON Path** evaluates one or more specific fields.",{"_4070":684,"_34195":652,"_23354":58783,"_5":16137,"_30763":58703,"_3518":58784},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_4070":685,"_34195":652,"_23354":58786,"_5":16137,"_30763":58703,"_3518":58787},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_4070":686,"_34195":652,"_23354":58789,"_5":16137,"_30763":58703,"_3518":58790},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_4070":687,"_34195":652,"_23354":58792,"_5":16137,"_30763":58703,"_3518":58793},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_4070":688,"_34195":652,"_23354":58795,"_5":16137,"_30763":58707,"_3518":58796},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_4070":689,"_34195":652,"_23354":58798,"_5":16137,"_30763":58711,"_3518":58799},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_4070":690,"_34195":652,"_23354":58801,"_5":16137,"_30763":58711,"_3518":58802},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_4070":691,"_34195":652,"_23354":58804,"_5":16137,"_30763":58711,"_3518":58805},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_4070":692,"_34195":652,"_23354":58807,"_5":16137,"_30763":58711,"_3518":58808},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_4070":693,"_34195":652,"_23354":58810,"_5":16137,"_30763":58711,"_3518":58811},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_4070":694,"_34195":652,"_23354":58813,"_5":16137,"_30763":58711,"_3518":58814},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_4070":695,"_34195":652,"_23354":58816,"_5":16137,"_30763":58711,"_3518":58817},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_4070":696,"_34195":652,"_23354":58819,"_5":16137,"_30763":58711,"_3518":58820},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_4070":697,"_34195":652,"_23354":58822,"_5":16137,"_30763":58715,"_3518":58823},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_4070":698,"_34195":652,"_23354":58825,"_5":16137,"_30763":58715,"_3518":58826},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_4070":699,"_34195":652,"_23354":58828,"_5":16137,"_30763":58715,"_3518":58829},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_4070":700,"_34195":652,"_23354":58831,"_5":16137,"_30763":58715,"_3518":58832},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_4070":701,"_34195":652,"_23354":58834,"_5":16137,"_30763":58715,"_3518":58835},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_4070":702,"_34195":652,"_23354":58837,"_5":16137,"_30763":58715,"_3518":58838},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_4070":703,"_34195":652,"_23354":58840,"_5":16137,"_30763":58715,"_3518":58841},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_4070":704,"_34195":652,"_23354":58843,"_5":16137,"_30763":58715,"_3518":58844},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_4070":705,"_34195":652,"_23354":58846,"_5":16137,"_30763":58719,"_3518":58847},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_4070":706,"_34195":652,"_23354":58849,"_5":16137,"_30763":58719,"_3518":58850},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_4070":707,"_34195":652,"_23354":58852,"_5":16137,"_30763":58723,"_3518":58853},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_4070":708,"_34195":652,"_23354":58855,"_5":16137,"_30763":58723,"_3518":58856},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_4070":709,"_34195":652,"_23354":58858,"_5":16137,"_30763":58723,"_3518":58859},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_4070":710,"_34195":652,"_23354":58861,"_5":16137,"_30763":58723,"_3518":58862},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_4070":711,"_34195":652,"_23354":58864,"_5":16137,"_30763":58723,"_3518":58865},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_4070":712,"_34195":652,"_23354":58867,"_5":16137,"_30763":58723,"_3518":58868},[],"**Validation:** `va.role.crl.create`.",{"_4070":713,"_34195":652,"_23354":58870,"_5":16137,"_30763":58723,"_3518":58871},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_4070":714,"_34195":652,"_23354":58873,"_5":16137,"_30763":58723,"_3518":58874},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_4070":715,"_34195":715,"_5":16540,"_3518":58876,"_34626":58877,"_23354":58878,"_30763":715},"Audit logs",[56672,58140,58141],[],{"_4070":716,"_34195":715,"_23354":58880,"_5":16137,"_30763":715,"_3518":58881},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_4070":717,"_34195":715,"_5":34623,"_23354":58883,"_30763":58884,"_3518":58885},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_4070":718,"_34195":715,"_5":34623,"_23354":58887,"_30763":58888,"_3518":58889},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#coverage","Coverage",{"_4070":719,"_34195":715,"_5":34623,"_23354":58891,"_30763":58892,"_3518":58893},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_4070":720,"_34195":715,"_5":34623,"_23354":58895,"_30763":58896,"_3518":58897},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_4070":721,"_34195":715,"_5":34623,"_23354":58899,"_30763":58900,"_3518":58901},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_4070":722,"_34195":715,"_5":34623,"_23354":58903,"_30763":58904,"_3518":58905},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_4070":723,"_34195":715,"_5":34623,"_23354":58907,"_30763":58908,"_3518":58909},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_4070":724,"_34195":715,"_5":34623,"_23354":58911,"_30763":58912,"_3518":58913},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_4070":725,"_34195":715,"_5":34623,"_23354":58915,"_30763":58916,"_3518":58917},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_4070":726,"_34195":715,"_5":34623,"_23354":58919,"_30763":58920,"_3518":58921},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_4070":727,"_34195":715,"_5":34623,"_23354":58923,"_30763":58924,"_3518":58925},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_4070":728,"_34195":715,"_23354":58927,"_5":16137,"_30763":715,"_3518":58928},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_4070":729,"_34195":715,"_23354":58930,"_5":16137,"_30763":58884,"_3518":58931},[],"The audit body includes:",{"_4070":730,"_34195":715,"_23354":58933,"_5":16137,"_30763":58884,"_3518":58934},[],"input: data received by the operation;",{"_4070":731,"_34195":715,"_23354":58936,"_5":16137,"_30763":58884,"_3518":58937},[],"has\\_error: whether the service returned an error;",{"_4070":732,"_34195":715,"_23354":58939,"_5":16137,"_30763":58884,"_3518":58940},[],"output: produced result or error message;",{"_4070":733,"_34195":715,"_23354":58942,"_5":16137,"_30763":58884,"_3518":58943},[],"principals: identifiers of the principals that matched the request.",{"_4070":734,"_34195":715,"_23354":58945,"_5":16137,"_30763":58884,"_3518":58946},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_4070":735,"_34195":715,"_23354":58948,"_5":16137,"_30763":58884,"_3518":58949},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_4070":736,"_34195":715,"_23354":58951,"_5":16137,"_30763":58888,"_3518":58952},[],"The backend applies auditing to mutations of:",{"_4070":737,"_34195":715,"_23354":58954,"_5":16137,"_30763":58888,"_3518":58955},[],"authorities, certificates and issuance profiles;",{"_4070":738,"_34195":715,"_23354":58957,"_5":16137,"_30763":58888,"_3518":58958},[],"keys and KMS engines;",{"_4070":739,"_34195":715,"_23354":58960,"_5":16137,"_30763":58888,"_3518":58961},[],"devices and identities;",{"_4070":740,"_34195":715,"_23354":58963,"_5":16137,"_30763":58888,"_3518":58964},[],"DMSs and enrollment operations;",{"_4070":741,"_34195":715,"_23354":58966,"_5":16137,"_30763":58888,"_3518":58967},[],"validation functions and CRL;",{"_4070":742,"_34195":715,"_23354":58969,"_5":16137,"_30763":58888,"_3518":58970},[],"principals, policies and authorization grants.",{"_4070":743,"_34195":715,"_23354":58972,"_5":16137,"_30763":58888,"_3518":58973},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_4070":744,"_34195":715,"_23354":58975,"_5":16137,"_30763":58892,"_3518":58976},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_4070":745,"_34195":715,"_23354":58978,"_5":16137,"_30763":58892,"_3518":58979},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_4070":746,"_34195":715,"_23354":58981,"_5":16137,"_30763":58892,"_3518":58982},[],"Design the consumer to:",{"_4070":747,"_34195":715,"_23354":58984,"_5":16137,"_30763":58892,"_3518":58985},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_4070":748,"_34195":715,"_23354":58987,"_5":16137,"_30763":58892,"_3518":58988},[],"keep the complete CloudEvent unmodified;",{"_4070":749,"_34195":715,"_23354":58990,"_5":16137,"_30763":58892,"_3518":58991},[],"record the ingestion time and detect duplicates by ID;",{"_4070":750,"_34195":715,"_23354":58993,"_5":16137,"_30763":58892,"_3518":58994},[],"encrypt in transit and at rest;",{"_4070":751,"_34195":715,"_23354":58996,"_5":16137,"_30763":58892,"_3518":58997},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_4070":752,"_34195":715,"_23354":58999,"_5":16137,"_30763":58892,"_3518":59000},[],"apply an explicit retention and legal hold policy;",{"_4070":753,"_34195":715,"_23354":59002,"_5":16137,"_30763":58892,"_3518":59003},[],"alert if it stops consuming or the pending queue grows.",{"_4070":754,"_34195":715,"_23354":59005,"_5":16137,"_30763":58896,"_3518":59006},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_4070":755,"_34195":715,"_23354":59008,"_5":16137,"_30763":58896,"_3518":59009},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_4070":756,"_34195":715,"_23354":59011,"_5":16137,"_30763":58904,"_3518":59012},[],"Start from the reported time and normalize every source to UTC.",{"_4070":757,"_34195":715,"_23354":59014,"_5":16137,"_30763":58908,"_3518":59015},[],"Filter by event type, service source and resource identifier.",{"_4070":758,"_34195":715,"_23354":59017,"_5":16137,"_30763":58912,"_3518":59018},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_4070":759,"_34195":715,"_23354":59020,"_5":16137,"_30763":58916,"_3518":59021},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_4070":760,"_34195":715,"_23354":59023,"_5":16137,"_30763":58920,"_3518":59024},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_4070":761,"_34195":715,"_23354":59026,"_5":16137,"_30763":58924,"_3518":59027},[],"Generate a controlled mutation in a test environment and check that:",{"_4070":762,"_34195":715,"_23354":59029,"_5":16137,"_30763":58924,"_3518":59030},[],"a successful audit event appears;",{"_4070":763,"_34195":715,"_23354":59032,"_5":16137,"_30763":58924,"_3518":59033},[],"the principal matches the identity used;",{"_4070":764,"_34195":715,"_23354":59035,"_5":16137,"_30763":58924,"_3518":59036},[],"the consumer persists it exactly once;",{"_4070":765,"_34195":715,"_23354":59038,"_5":16137,"_30763":58924,"_3518":59039},[],"it can be retrieved by resource, actor and period;",{"_4070":766,"_34195":715,"_23354":59041,"_5":16137,"_30763":58924,"_3518":59042},[],"a consumer outage raises an alert.",{"_4070":767,"_34195":715,"_23354":59044,"_5":16137,"_30763":58924,"_3518":59045},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_4070":768,"_34195":768,"_5":16540,"_3518":59047,"_34626":59048,"_23354":59049,"_30763":768},"Platform architecture",[56672,58140],[],{"_4070":769,"_34195":768,"_23354":59051,"_5":16137,"_30763":768,"_3518":59052},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_4070":770,"_34195":768,"_5":34623,"_23354":59054,"_30763":59055,"_3518":59056},[],"/docs/pr-preview/pr-58/platform/concepts/architecture#control-plane","Control plane",{"_4070":771,"_34195":768,"_5":34623,"_23354":59058,"_30763":59059,"_3518":59060},[],"/docs/pr-preview/pr-58/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_4070":772,"_34195":768,"_5":34623,"_23354":59062,"_30763":59063,"_3518":59064},[],"/docs/pr-preview/pr-58/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_4070":773,"_34195":768,"_5":34623,"_23354":59066,"_30763":59067,"_3518":59068},[],"/docs/pr-preview/pr-58/platform/concepts/architecture#status-and-validation","Status and validation",{"_4070":774,"_34195":768,"_5":34623,"_23354":59070,"_30763":59071,"_3518":59072},[],"/docs/pr-preview/pr-58/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_4070":775,"_34195":768,"_23354":59074,"_5":16137,"_30763":768,"_3518":59075},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_4070":776,"_34195":768,"_23354":59077,"_5":16137,"_30763":768,"_3518":59078},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_4070":777,"_34195":768,"_23354":59080,"_5":16137,"_30763":59055,"_3518":59081},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_4070":778,"_34195":768,"_23354":59083,"_5":16137,"_30763":59059,"_3518":59084},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_4070":779,"_34195":768,"_23354":59086,"_5":16137,"_30763":59063,"_3518":59087},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_4070":780,"_34195":768,"_23354":59089,"_5":16137,"_30763":59067,"_3518":59090},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_4070":781,"_34195":768,"_23354":59092,"_5":16137,"_30763":59071,"_3518":59093},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_4070":782,"_34195":782,"_5":16540,"_3518":59095,"_34626":59096,"_23354":59097,"_30763":782},"How Lamassu works",[56672,58140],[],{"_4070":783,"_34195":782,"_23354":59099,"_5":16137,"_30763":782,"_3518":59100},[],"The mental model of trust, keys, certificates and devices.",{"_4070":784,"_34195":782,"_5":34623,"_23354":59102,"_30763":59103,"_3518":59104},[],"/docs/pr-preview/pr-58/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_4070":785,"_34195":782,"_5":34623,"_23354":59106,"_30763":59107,"_3518":59108},[],"/docs/pr-preview/pr-58/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_4070":786,"_34195":782,"_23354":59110,"_5":16137,"_30763":782,"_3518":59111},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_4070":787,"_34195":782,"_23354":59113,"_5":16137,"_30763":59103,"_3518":59114},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_4070":788,"_34195":782,"_23354":59116,"_5":16137,"_30763":59103,"_3518":59117},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_4070":789,"_34195":782,"_23354":59119,"_5":16137,"_30763":59103,"_3518":59120},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_4070":790,"_34195":782,"_23354":59122,"_5":16137,"_30763":59103,"_3518":59123},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_4070":791,"_34195":782,"_23354":59125,"_5":16137,"_30763":59103,"_3518":59126},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_4070":792,"_34195":782,"_23354":59128,"_5":16137,"_30763":59107,"_3518":59129},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_4070":793,"_34195":782,"_23354":59131,"_5":16137,"_30763":59107,"_3518":59132},[],"A DMS relates that CA to an enrollment policy.",{"_4070":794,"_34195":782,"_23354":59134,"_5":16137,"_30763":59107,"_3518":59135},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_4070":795,"_34195":782,"_23354":59137,"_5":16137,"_30763":59107,"_3518":59138},[],"Lamassu keeps the inventory, history and status of the identity.",{"_4070":796,"_34195":782,"_23354":59140,"_5":16137,"_30763":59107,"_3518":59141},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_4070":797,"_34195":782,"_23354":59143,"_5":16137,"_30763":59107,"_3518":59144},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_4070":798,"_34195":782,"_23354":59146,"_5":16137,"_30763":59107,"_3518":59147},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_4070":799,"_34195":799,"_5":16540,"_3518":59149,"_34626":59150,"_23354":59152,"_30763":799},"Devices and identities",[56672,58140,59151,59149],"IoT Fleets",[],{"_4070":800,"_34195":799,"_23354":59154,"_5":16137,"_30763":799,"_3518":59155},[],"Register, inspect and retire devices while checking their current identity and history.",{"_4070":801,"_34195":799,"_5":34623,"_23354":59157,"_30763":59158,"_3518":59159},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#device-states","Device states",{"_4070":802,"_34195":799,"_5":34623,"_23354":59161,"_30763":59162,"_3518":59163},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_4070":803,"_34195":799,"_5":34623,"_23354":59165,"_30763":59166,"_3518":59167},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_4070":804,"_34195":799,"_5":34623,"_23354":59169,"_30763":59170,"_3518":59171},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#create-the-device","Create the device",{"_4070":805,"_34195":799,"_5":34623,"_23354":59173,"_30763":59174,"_3518":59175},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_4070":806,"_34195":799,"_5":34623,"_23354":59177,"_30763":59178,"_3518":59179},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_4070":807,"_34195":799,"_5":34623,"_23354":59181,"_30763":59182,"_3518":59183},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_4070":808,"_34195":799,"_5":34623,"_23354":59185,"_30763":59186,"_3518":59187},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_4070":809,"_34195":799,"_5":34623,"_23354":59189,"_30763":59190,"_3518":59191},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_4070":810,"_34195":799,"_5":34623,"_23354":59193,"_30763":59194,"_3518":59195},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_4070":811,"_34195":799,"_5":34623,"_23354":59197,"_30763":59198,"_3518":59199},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_4070":812,"_34195":799,"_23354":59201,"_5":16137,"_30763":799,"_3518":59202},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_4070":813,"_34195":799,"_23354":59204,"_5":16137,"_30763":799,"_3518":59205},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_4070":814,"_34195":799,"_23354":59207,"_5":16137,"_30763":59158,"_3518":59208},[],"Operational view",{"_4070":815,"_34195":799,"_23354":59210,"_5":16137,"_30763":59158,"_3518":59211},[],"Meaning",{"_4070":816,"_34195":799,"_23354":59213,"_5":16137,"_30763":59158,"_3518":59214},[],"**No Identity**",{"_4070":817,"_34195":799,"_23354":59216,"_5":16137,"_30763":59158,"_3518":59217},[],"A record exists without an associated identity.",{"_4070":818,"_34195":799,"_23354":59219,"_5":16137,"_30763":59158,"_3518":59220},[],"**Active**",{"_4070":819,"_34195":799,"_23354":59222,"_5":16137,"_30763":59158,"_3518":59223},[],"The slot is active; also check certificate dates, status and usages.",{"_4070":820,"_34195":799,"_23354":59225,"_5":16137,"_30763":59158,"_3518":59226},[],"**Renewal Pending**",{"_4070":821,"_34195":799,"_23354":59228,"_5":16137,"_30763":59158,"_3518":59229},[],"The identity is in the operational renewal window.",{"_4070":822,"_34195":799,"_23354":59231,"_5":16137,"_30763":59158,"_3518":59232},[],"**Expiring Soon**",{"_4070":823,"_34195":799,"_23354":59234,"_5":16137,"_30763":59158,"_3518":59235},[],"Expiration is approaching according to configured thresholds.",{"_4070":824,"_34195":799,"_23354":59237,"_5":16137,"_30763":59158,"_3518":59238},[],"**Expired**",{"_4070":825,"_34195":799,"_23354":59240,"_5":16137,"_30763":59158,"_3518":59241},[],"The identity has expired.",{"_4070":826,"_34195":799,"_23354":59243,"_5":16137,"_30763":59158,"_3518":59244},[],"**Revoked**",{"_4070":827,"_34195":799,"_23354":59246,"_5":16137,"_30763":59158,"_3518":59247},[],"The identity is marked revoked.",{"_4070":828,"_34195":799,"_23354":59249,"_5":16137,"_30763":59158,"_3518":59250},[],"**Decommissioned**",{"_4070":829,"_34195":799,"_23354":59252,"_5":16137,"_30763":59158,"_3518":59253},[],"The record is retired and ordinary updates do not restore operation.",{"_4070":830,"_34195":799,"_23354":59255,"_5":16137,"_30763":59158,"_3518":59256},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_4070":831,"_34195":799,"_23354":59258,"_5":16137,"_30763":59162,"_3518":59259},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_4070":832,"_34195":799,"_23354":59261,"_5":16137,"_30763":59162,"_3518":59262},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_4070":833,"_34195":799,"_23354":59264,"_5":16137,"_30763":59162,"_3518":59265},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_4070":834,"_34195":799,"_23354":59267,"_5":16137,"_30763":59162,"_3518":59268},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_4070":835,"_34195":799,"_23354":59270,"_5":16137,"_30763":59166,"_3518":59271},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_4070":836,"_34195":799,"_23354":59273,"_5":16137,"_30763":59170,"_3518":59274},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_4070":837,"_34195":799,"_23354":59276,"_5":16137,"_30763":59174,"_3518":59277},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_4070":838,"_34195":799,"_23354":59279,"_5":16137,"_30763":59178,"_3518":59280},[],"Add model, environment or location tags and an icon according to your inventory.",{"_4070":839,"_34195":799,"_23354":59282,"_5":16137,"_30763":59182,"_3518":59283},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_4070":840,"_34195":799,"_23354":59285,"_5":16137,"_30763":59182,"_3518":59286},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_4070":841,"_34195":799,"_23354":59288,"_5":16137,"_30763":59186,"_3518":59289},[],"From **No Identity**, use **Assign Identity**:",{"_4070":842,"_34195":799,"_23354":59291,"_5":16137,"_30763":59186,"_3518":59292},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_4070":843,"_34195":799,"_23354":59294,"_5":16137,"_30763":59186,"_3518":59295},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_4070":844,"_34195":799,"_23354":59297,"_5":16137,"_30763":59186,"_3518":59298},[],"Confirm and read the serial, active version and history again.",{"_4070":845,"_34195":799,"_23354":59300,"_5":16137,"_30763":59186,"_3518":59301},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_4070":846,"_34195":799,"_23354":59303,"_5":16137,"_30763":59186,"_3518":59304},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_4070":847,"_34195":799,"_23354":59306,"_5":16137,"_30763":59190,"_3518":59307},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_4070":848,"_34195":799,"_23354":59309,"_5":16137,"_30763":59190,"_3518":59310},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_4070":849,"_34195":799,"_23354":59312,"_5":16137,"_30763":59194,"_3518":59313},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_4070":850,"_34195":799,"_23354":59315,"_5":16137,"_30763":59194,"_3518":59316},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_4070":851,"_34195":799,"_23354":59318,"_5":16137,"_30763":59194,"_3518":59319},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_4070":852,"_34195":799,"_23354":59321,"_5":16137,"_30763":59194,"_3518":59322},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_4070":853,"_34195":799,"_23354":59324,"_5":16137,"_30763":59198,"_3518":59325},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_4070":854,"_34195":799,"_23354":59327,"_5":16137,"_30763":59198,"_3518":59328},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_4070":855,"_34195":855,"_5":16540,"_3518":59330,"_34626":59331,"_23354":59333,"_30763":855},"Bootstrap identity and authentication",[56672,58140,59151,59149,59332],"Enrollment with PKI",[],{"_4070":856,"_34195":855,"_23354":59335,"_5":16137,"_30763":855,"_3518":59336},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_4070":857,"_34195":855,"_5":34623,"_23354":59338,"_30763":59339,"_3518":59340},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_4070":858,"_34195":855,"_5":34623,"_23354":59342,"_30763":59343,"_3518":59344},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_4070":859,"_34195":855,"_5":34623,"_23354":59346,"_30763":59347,"_3518":59348},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_4070":860,"_34195":855,"_5":34623,"_23354":59350,"_30763":59351,"_3518":59352},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_4070":861,"_34195":855,"_5":34623,"_23354":59354,"_30763":59355,"_3518":59356},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_4070":862,"_34195":855,"_23354":59358,"_5":16137,"_30763":855,"_3518":59359},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_4070":863,"_34195":855,"_23354":59361,"_5":16137,"_30763":59339,"_3518":59362},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_4070":864,"_34195":855,"_23354":59364,"_5":16137,"_30763":59339,"_3518":59365},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_4070":865,"_34195":855,"_23354":59367,"_5":16137,"_30763":59343,"_3518":59368},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_4070":866,"_34195":855,"_23354":59370,"_5":16137,"_30763":59343,"_3518":59371},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_4070":867,"_34195":855,"_23354":59373,"_5":16137,"_30763":59343,"_3518":59374},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_4070":868,"_34195":855,"_23354":59376,"_5":16137,"_30763":59347,"_3518":59377},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_4070":869,"_34195":855,"_23354":59379,"_5":16137,"_30763":59347,"_3518":59380},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_4070":870,"_34195":855,"_23354":59382,"_5":16137,"_30763":59351,"_3518":59383},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_4070":871,"_34195":855,"_23354":59385,"_5":16137,"_30763":59351,"_3518":59386},[],"Example body:",{"_4070":872,"_34195":855,"_23354":59388,"_5":16137,"_30763":59351,"_3518":59389},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_4070":873,"_34195":855,"_23354":59391,"_5":16137,"_30763":59351,"_3518":59392},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_4070":874,"_34195":855,"_23354":59394,"_5":16137,"_30763":59351,"_3518":59395},[],"Continuation requires a successful HTTP response and JSON:",{"_4070":875,"_34195":855,"_23354":59397,"_5":16137,"_30763":59351,"_3518":59398},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_4070":876,"_34195":855,"_23354":59400,"_5":16137,"_30763":59355,"_3518":59401},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_4070":877,"_34195":855,"_23354":59403,"_5":16137,"_30763":59355,"_3518":59404},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_4070":878,"_34195":878,"_5":16540,"_3518":59406,"_34626":59407,"_23354":59408,"_30763":878},"Configure and operate the DMS",[56672,58140,59151,59149,59332],[],{"_4070":879,"_34195":878,"_23354":59410,"_5":16137,"_30763":878,"_3518":59411},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_4070":880,"_34195":878,"_5":34623,"_23354":59413,"_30763":59414,"_3518":56682},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#before-you-begin",{"_4070":881,"_34195":878,"_5":34623,"_23354":59416,"_30763":59417,"_3518":59418},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_4070":882,"_34195":878,"_5":34623,"_23354":59420,"_30763":59421,"_3518":59422},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_4070":883,"_34195":878,"_5":34623,"_23354":59424,"_30763":59425,"_3518":59426},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_4070":884,"_34195":878,"_5":34623,"_23354":59428,"_30763":59429,"_3518":59430},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_4070":885,"_34195":878,"_5":34623,"_23354":59432,"_30763":59433,"_3518":59434},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_4070":886,"_34195":878,"_5":34623,"_23354":59436,"_30763":59437,"_3518":59438},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_4070":887,"_34195":878,"_5":34623,"_23354":59440,"_30763":59441,"_3518":59442},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_4070":888,"_34195":878,"_5":34623,"_23354":59444,"_30763":59445,"_3518":59446},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_4070":889,"_34195":878,"_5":34623,"_23354":59448,"_30763":59449,"_3518":59450},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_4070":890,"_34195":878,"_5":34623,"_23354":59452,"_30763":59453,"_3518":59454},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_4070":891,"_34195":878,"_5":34623,"_23354":59456,"_30763":59457,"_3518":59458},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_4070":892,"_34195":878,"_5":34623,"_23354":59460,"_30763":59461,"_3518":59462},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_4070":893,"_34195":878,"_5":34623,"_23354":59464,"_30763":59465,"_3518":59466},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_4070":894,"_34195":878,"_5":34623,"_23354":59468,"_30763":59469,"_3518":59470},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_4070":895,"_34195":878,"_5":34623,"_23354":59472,"_30763":59473,"_3518":59474},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_4070":896,"_34195":878,"_5":34623,"_23354":59476,"_30763":59477,"_3518":59478},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_4070":897,"_34195":878,"_5":34623,"_23354":59480,"_30763":59481,"_3518":59482},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_4070":898,"_34195":878,"_23354":59484,"_5":16137,"_30763":878,"_3518":59485},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_4070":899,"_34195":878,"_23354":59487,"_5":16137,"_30763":59414,"_3518":59488},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_4070":900,"_34195":878,"_23354":59490,"_5":16137,"_30763":59414,"_3518":59491},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_4070":901,"_34195":878,"_23354":59493,"_5":16137,"_30763":59421,"_3518":59494},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_4070":902,"_34195":878,"_23354":59496,"_5":16137,"_30763":59425,"_3518":59497},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_4070":903,"_34195":878,"_23354":59499,"_5":16137,"_30763":59429,"_3518":59500},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_4070":904,"_34195":878,"_23354":59502,"_5":16137,"_30763":59433,"_3518":59503},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_4070":905,"_34195":878,"_23354":59505,"_5":16137,"_30763":59437,"_3518":59506},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_4070":906,"_34195":878,"_23354":59508,"_5":16137,"_30763":59445,"_3518":59509},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_4070":907,"_34195":878,"_23354":59511,"_5":16137,"_30763":59445,"_3518":59512},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_4070":908,"_34195":878,"_23354":59514,"_5":16137,"_30763":59449,"_3518":59515},[],"`settings.enrollment_settings` field",{"_4070":909,"_34195":878,"_23354":59517,"_5":16137,"_30763":59449,"_3518":59518},[],"Decision",{"_4070":910,"_34195":878,"_23354":59520,"_5":16137,"_30763":59449,"_3518":59521},[],"`protocol`",{"_4070":911,"_34195":878,"_23354":59523,"_5":16137,"_30763":59449,"_3518":59524},[],"`EST_RFC7030` for these operations.",{"_4070":912,"_34195":878,"_23354":59526,"_5":16137,"_30763":59449,"_3518":59527},[],"`enrollment_ca`",{"_4070":913,"_34195":878,"_23354":59529,"_5":16137,"_30763":59449,"_3518":59530},[],"ID of the signing CA.",{"_4070":914,"_34195":878,"_23354":59532,"_5":16137,"_30763":59449,"_3518":59533},[],"`verify_csr_signature`",{"_4070":915,"_34195":878,"_23354":59535,"_5":16137,"_30763":59449,"_3518":59536},[],"Keep `true` to verify CSR key possession.",{"_4070":916,"_34195":878,"_23354":59538,"_5":16137,"_30763":59449,"_3518":59539},[],"`enable_replaceable_enrollment`",{"_4070":917,"_34195":878,"_23354":59541,"_5":16137,"_30763":59449,"_3518":59542},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_4070":918,"_34195":878,"_23354":59544,"_5":16137,"_30763":59449,"_3518":59545},[],"`est_rfc7030_settings.auth_mode`",{"_4070":919,"_34195":878,"_23354":59547,"_5":16137,"_30763":59449,"_3518":59548},[],"One of the four authentication modes.",{"_4070":920,"_34195":878,"_23354":59550,"_5":16137,"_30763":59449,"_3518":59551},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_4070":921,"_34195":878,"_23354":59553,"_5":16137,"_30763":59453,"_3518":59554},[],"The blocks are independent:",{"_4070":922,"_34195":878,"_23354":59556,"_5":16137,"_30763":59453,"_3518":59557},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_4070":923,"_34195":878,"_23354":59559,"_5":16137,"_30763":59453,"_3518":59560},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_4070":924,"_34195":878,"_23354":59562,"_5":16137,"_30763":59453,"_3518":59563},[],"`auth_mode`",{"_4070":925,"_34195":878,"_23354":59565,"_5":16137,"_30763":59453,"_3518":59566},[],"Control applied in the configured operation",{"_4070":926,"_34195":878,"_23354":59568,"_5":16137,"_30763":59453,"_3518":59569},[],"`CLIENT_CERTIFICATE`",{"_4070":927,"_34195":878,"_23354":59571,"_5":16137,"_30763":59453,"_3518":59572},[],"Presented certificate validation.",{"_4070":928,"_34195":878,"_23354":59574,"_5":16137,"_30763":59453,"_3518":59575},[],"`EXTERNAL_WEBHOOK`",{"_4070":929,"_34195":878,"_23354":59577,"_5":16137,"_30763":59453,"_3518":59578},[],"Configured webhook authorization.",{"_4070":930,"_34195":878,"_23354":59580,"_5":16137,"_30763":59453,"_3518":59581},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_4070":931,"_34195":878,"_23354":59583,"_5":16137,"_30763":59453,"_3518":59584},[],"Certificate validation followed by webhook approval.",{"_4070":932,"_34195":878,"_23354":59586,"_5":16137,"_30763":59453,"_3518":59587},[],"`NO_AUTH`",{"_4070":933,"_34195":878,"_23354":59589,"_5":16137,"_30763":59453,"_3518":59590},[],"No DMS requester authentication.",{"_4070":934,"_34195":878,"_23354":59592,"_5":16137,"_30763":59453,"_3518":59593},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_4070":935,"_34195":878,"_23354":59595,"_5":16137,"_30763":59453,"_3518":59596},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_4070":936,"_34195":878,"_23354":59598,"_5":16137,"_30763":59453,"_3518":59599},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_4070":937,"_34195":878,"_23354":59601,"_5":16137,"_30763":59453,"_3518":59602},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_4070":938,"_34195":878,"_23354":59604,"_5":16137,"_30763":59457,"_3518":59605},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_4070":939,"_34195":878,"_23354":59607,"_5":16137,"_30763":59457,"_3518":59608},[],"`external_webhook_settings` field",{"_4070":940,"_34195":878,"_23354":59610,"_5":16137,"_30763":59457,"_3518":59518},[],{"_4070":941,"_34195":878,"_23354":59612,"_5":16137,"_30763":59457,"_3518":59613},[],"`url`",{"_4070":942,"_34195":878,"_23354":59615,"_5":16137,"_30763":59457,"_3518":59616},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_4070":943,"_34195":878,"_23354":59618,"_5":16137,"_30763":59457,"_3518":59619},[],"`method`",{"_4070":944,"_34195":878,"_23354":59621,"_5":16137,"_30763":59457,"_3518":59622},[],"`POST` or `PUT`; `POST` by default.",{"_4070":945,"_34195":878,"_23354":59624,"_5":16137,"_30763":59457,"_3518":59625},[],"`name`",{"_4070":946,"_34195":878,"_23354":59627,"_5":16137,"_30763":59457,"_3518":59628},[],"Label used in service logs.",{"_4070":947,"_34195":878,"_23354":59630,"_5":16137,"_30763":59457,"_3518":59631},[],"`config.auth_mode`",{"_4070":948,"_34195":878,"_23354":59633,"_5":16137,"_30763":59457,"_3518":59634},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_4070":949,"_34195":878,"_23354":59636,"_5":16137,"_30763":59457,"_3518":59637},[],"`config.log_level`",{"_4070":950,"_34195":878,"_23354":59639,"_5":16137,"_30763":59457,"_3518":59640},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_4070":951,"_34195":878,"_23354":59642,"_5":16137,"_30763":59457,"_3518":59643},[],"`config.apikey_options`",{"_4070":952,"_34195":878,"_23354":59645,"_5":16137,"_30763":59457,"_3518":59646},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_4070":953,"_34195":878,"_23354":59648,"_5":16137,"_30763":59457,"_3518":59649},[],"`config.jwt_options`",{"_4070":954,"_34195":878,"_23354":59651,"_5":16137,"_30763":59457,"_3518":59652},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_4070":955,"_34195":878,"_23354":59654,"_5":16137,"_30763":59457,"_3518":59655},[],"`config.mtls_options`",{"_4070":956,"_34195":878,"_23354":59657,"_5":16137,"_30763":59457,"_3518":59658},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_4070":957,"_34195":878,"_23354":59660,"_5":16137,"_30763":59457,"_3518":59661},[],"`config.insecure_skip_verify`",{"_4070":958,"_34195":878,"_23354":59663,"_5":16137,"_30763":59457,"_3518":59664},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_4070":959,"_34195":878,"_23354":59666,"_5":16137,"_30763":59457,"_3518":59667},[],"`config.call_timeout`",{"_4070":960,"_34195":878,"_23354":59669,"_5":16137,"_30763":59457,"_3518":59670},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_4070":961,"_34195":878,"_23354":59672,"_5":16137,"_30763":59457,"_3518":59673},[],"Rules for that configuration:",{"_4070":962,"_34195":878,"_23354":59675,"_5":16137,"_30763":59457,"_3518":59676},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_4070":963,"_34195":878,"_23354":59678,"_5":16137,"_30763":59457,"_3518":59679},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_4070":964,"_34195":878,"_23354":59681,"_5":16137,"_30763":59457,"_3518":59682},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_4070":965,"_34195":878,"_23354":59684,"_5":16137,"_30763":59457,"_3518":59685},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_4070":966,"_34195":878,"_23354":59687,"_5":16137,"_30763":59457,"_3518":59688},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_4070":967,"_34195":878,"_23354":59690,"_5":16137,"_30763":59457,"_3518":59691},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_4070":968,"_34195":878,"_23354":59693,"_5":16137,"_30763":59457,"_3518":59694},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_4070":969,"_34195":878,"_23354":59696,"_5":16137,"_30763":59457,"_3518":59697},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_4070":970,"_34195":878,"_23354":59699,"_5":16137,"_30763":59457,"_3518":59700},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_4070":971,"_34195":878,"_23354":59702,"_5":16137,"_30763":59461,"_3518":59703},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_4070":972,"_34195":878,"_23354":59705,"_5":16137,"_30763":59465,"_3518":59706},[],"`settings.reenrollment_settings` field",{"_4070":973,"_34195":878,"_23354":59708,"_5":16137,"_30763":59465,"_3518":57062},[],{"_4070":974,"_34195":878,"_23354":59710,"_5":16137,"_30763":59465,"_3518":59711},[],"`reenrollment_delta`",{"_4070":975,"_34195":878,"_23354":59713,"_5":16137,"_30763":59465,"_3518":59714},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_4070":976,"_34195":878,"_23354":59716,"_5":16137,"_30763":59465,"_3518":59717},[],"`preventive_delta`",{"_4070":977,"_34195":878,"_23354":59719,"_5":16137,"_30763":59465,"_3518":59720},[],"Preventive operational monitoring threshold.",{"_4070":978,"_34195":878,"_23354":59722,"_5":16137,"_30763":59465,"_3518":59723},[],"`critical_delta`",{"_4070":979,"_34195":878,"_23354":59725,"_5":16137,"_30763":59465,"_3518":59726},[],"Critical operational monitoring threshold.",{"_4070":980,"_34195":878,"_23354":59728,"_5":16137,"_30763":59465,"_3518":59729},[],"`enable_expired_renewal`",{"_4070":981,"_34195":878,"_23354":59731,"_5":16137,"_30763":59465,"_3518":59732},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_4070":982,"_34195":878,"_23354":59734,"_5":16137,"_30763":59465,"_3518":59735},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_4070":983,"_34195":878,"_23354":59737,"_5":16137,"_30763":59465,"_3518":59738},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_4070":984,"_34195":878,"_23354":59740,"_5":16137,"_30763":59465,"_3518":59741},[],"`revoke_on_reenrollment`",{"_4070":985,"_34195":878,"_23354":59743,"_5":16137,"_30763":59465,"_3518":59744},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_4070":986,"_34195":878,"_23354":59746,"_5":16137,"_30763":59465,"_3518":59747},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_4070":987,"_34195":878,"_23354":59749,"_5":16137,"_30763":59469,"_3518":59750},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_4070":988,"_34195":878,"_23354":59752,"_5":16137,"_30763":59473,"_3518":57056},[],{"_4070":989,"_34195":878,"_23354":59754,"_5":16137,"_30763":59473,"_3518":59755},[],"Published material",{"_4070":990,"_34195":878,"_23354":59757,"_5":16137,"_30763":59473,"_3518":59758},[],"**Include Lamassu System CA**",{"_4070":991,"_34195":878,"_23354":59760,"_5":16137,"_30763":59473,"_3518":59761},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_4070":992,"_34195":878,"_23354":59763,"_5":16137,"_30763":59473,"_3518":59764},[],"**Include Enrollment CA**",{"_4070":993,"_34195":878,"_23354":59766,"_5":16137,"_30763":59473,"_3518":59767},[],"Selected issuing CA certificate.",{"_4070":994,"_34195":878,"_23354":59769,"_5":16137,"_30763":59473,"_3518":59770},[],"**Managed CAs**",{"_4070":995,"_34195":878,"_23354":59772,"_5":16137,"_30763":59473,"_3518":59773},[],"Explicitly selected CA certificates.",{"_4070":996,"_34195":878,"_23354":59775,"_5":16137,"_30763":59473,"_3518":59776},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_4070":997,"_34195":878,"_23354":59778,"_5":16137,"_30763":59477,"_3518":59779},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_4070":998,"_34195":878,"_23354":59781,"_5":16137,"_30763":59477,"_3518":59782},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_4070":999,"_34195":878,"_23354":59784,"_5":16137,"_30763":59477,"_3518":59785},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_4070":1000,"_34195":878,"_23354":59787,"_5":16137,"_30763":59481,"_3518":59788},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_4070":1001,"_34195":1001,"_5":16540,"_3518":59790,"_34626":59791,"_23354":59792,"_30763":1001},"Integrate the EST client",[56672,58140,59151,59149,59332],[],{"_4070":1002,"_34195":1001,"_23354":59794,"_5":16137,"_30763":1001,"_3518":59795},[],"Prepare trust, send a CSR and check the identity you receive.",{"_4070":1003,"_34195":1001,"_5":34623,"_23354":59797,"_30763":59798,"_3518":56682},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_4070":1004,"_34195":1001,"_5":34623,"_23354":59800,"_30763":59801,"_3518":59802},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_4070":1005,"_34195":1001,"_5":34623,"_23354":59804,"_30763":59805,"_3518":59806},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_4070":1006,"_34195":1001,"_5":34623,"_23354":59808,"_30763":59809,"_3518":59810},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_4070":1007,"_34195":1001,"_5":34623,"_23354":59812,"_30763":59813,"_3518":59814},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_4070":1008,"_34195":1001,"_5":34623,"_23354":59816,"_30763":59817,"_3518":59818},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_4070":1009,"_34195":1001,"_23354":59820,"_5":16137,"_30763":1001,"_3518":59821},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_4070":1010,"_34195":1001,"_23354":59823,"_5":16137,"_30763":59798,"_3518":59824},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_4070":1011,"_34195":1001,"_23354":59826,"_5":16137,"_30763":59798,"_3518":59827},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_4070":1012,"_34195":1001,"_23354":59829,"_5":16137,"_30763":59798,"_3518":59830},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_4070":1013,"_34195":1001,"_23354":59832,"_5":16137,"_30763":59801,"_3518":59833},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_4070":1014,"_34195":1001,"_23354":59835,"_5":16137,"_30763":59801,"_3518":59836},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_4070":1015,"_34195":1001,"_23354":59838,"_5":16137,"_30763":59805,"_3518":59839},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_4070":1016,"_34195":1001,"_23354":59841,"_5":16137,"_30763":59805,"_3518":59842},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_4070":1017,"_34195":1001,"_23354":59844,"_5":16137,"_30763":59809,"_3518":59845},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_4070":1018,"_34195":1001,"_23354":59847,"_5":16137,"_30763":59809,"_3518":59848},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_4070":1019,"_34195":1001,"_23354":59850,"_5":16137,"_30763":59813,"_3518":59851},[],"For a root that issues directly:",{"_4070":1020,"_34195":1001,"_23354":59853,"_5":16137,"_30763":59813,"_3518":59854},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_4070":1021,"_34195":1001,"_23354":59856,"_5":16137,"_30763":59813,"_3518":59857},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_4070":1022,"_34195":1001,"_23354":59859,"_5":16137,"_30763":59817,"_3518":59860},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_4070":1023,"_34195":1023,"_5":16540,"_3518":59862,"_34626":59863,"_23354":59864,"_30763":1023},"EST reference",[56672,58140,59151,59149,59332],[],{"_4070":1024,"_34195":1023,"_23354":59866,"_5":16137,"_30763":1023,"_3518":59867},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_4070":1025,"_34195":1023,"_5":34623,"_23354":59869,"_30763":59870,"_3518":59871},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_4070":1026,"_34195":1023,"_5":34623,"_23354":59873,"_30763":59874,"_3518":25384},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#cacerts",{"_4070":1027,"_34195":1023,"_5":34623,"_23354":59876,"_30763":59877,"_3518":29110},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_4070":1028,"_34195":1023,"_5":34623,"_23354":59879,"_30763":59880,"_3518":29117},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_4070":1029,"_34195":1023,"_5":34623,"_23354":59882,"_30763":59883,"_3518":28336},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_4070":1030,"_34195":1023,"_5":34623,"_23354":59885,"_30763":59886,"_3518":59887},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_4070":1031,"_34195":1023,"_5":34623,"_23354":59889,"_30763":59890,"_3518":59891},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_4070":1032,"_34195":1023,"_5":34623,"_23354":59893,"_30763":59894,"_3518":59895},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_4070":1033,"_34195":1023,"_23354":59897,"_5":16137,"_30763":1023,"_3518":59898},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_4070":1034,"_34195":1023,"_23354":59900,"_5":16137,"_30763":59870,"_3518":59901},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_4070":1035,"_34195":1023,"_23354":59903,"_5":16137,"_30763":59870,"_3518":59904},[],"Operation",{"_4070":1036,"_34195":1023,"_23354":59906,"_5":16137,"_30763":59870,"_3518":59907},[],"Method",{"_4070":1037,"_34195":1023,"_23354":59909,"_5":16137,"_30763":59870,"_3518":59910},[],"Authentication and condition",{"_4070":1038,"_34195":1023,"_23354":59912,"_5":16137,"_30763":59870,"_3518":59913},[],"`/cacerts`",{"_4070":1039,"_34195":1023,"_23354":59915,"_5":16137,"_30763":59870,"_3518":59916},[],"GET",{"_4070":1040,"_34195":1023,"_23354":59918,"_5":16137,"_30763":59870,"_3518":59919},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_4070":1041,"_34195":1023,"_23354":59921,"_5":16137,"_30763":59870,"_3518":59922},[],"`/simpleenroll`",{"_4070":1042,"_34195":1023,"_23354":59924,"_5":16137,"_30763":59870,"_3518":59925},[],"POST",{"_4070":1043,"_34195":1023,"_23354":59927,"_5":16137,"_30763":59870,"_3518":59928},[],"Initial authentication and DMS registration/replacement policy.",{"_4070":1044,"_34195":1023,"_23354":59930,"_5":16137,"_30763":59870,"_3518":59931},[],"`/simplereenroll`",{"_4070":1045,"_34195":1023,"_23354":59933,"_5":16137,"_30763":59870,"_3518":59925},[],{"_4070":1046,"_34195":1023,"_23354":59935,"_5":16137,"_30763":59870,"_3518":59936},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_4070":1047,"_34195":1023,"_23354":59938,"_5":16137,"_30763":59870,"_3518":59939},[],"`/serverkeygen`",{"_4070":1048,"_34195":1023,"_23354":59941,"_5":16137,"_30763":59870,"_3518":59925},[],{"_4070":1049,"_34195":1023,"_23354":59943,"_5":16137,"_30763":59870,"_3518":59944},[],"Initial authentication and admission; server generation enabled.",{"_4070":1050,"_34195":1023,"_23354":59946,"_5":16137,"_30763":59870,"_3518":59947},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_4070":1051,"_34195":1023,"_23354":59949,"_5":16137,"_30763":59874,"_3518":59950},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_4070":1052,"_34195":1023,"_23354":59952,"_5":16137,"_30763":59874,"_3518":59953},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_4070":1053,"_34195":1023,"_23354":59955,"_5":16137,"_30763":59877,"_3518":59956},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_4070":1054,"_34195":1023,"_23354":59958,"_5":16137,"_30763":59877,"_3518":59959},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_4070":1055,"_34195":1023,"_23354":59961,"_5":16137,"_30763":59880,"_3518":59962},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_4070":1056,"_34195":1023,"_23354":59964,"_5":16137,"_30763":59880,"_3518":59965},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_4070":1057,"_34195":1023,"_23354":59967,"_5":16137,"_30763":59883,"_3518":59968},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_4070":1058,"_34195":1023,"_23354":59970,"_5":16137,"_30763":59883,"_3518":59971},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_4070":1059,"_34195":1023,"_23354":59973,"_5":16137,"_30763":59886,"_3518":59974},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_4070":1060,"_34195":1023,"_23354":59976,"_5":16137,"_30763":59886,"_3518":59977},[],"Part",{"_4070":1061,"_34195":1023,"_23354":59979,"_5":16137,"_30763":59886,"_3518":59980},[],"Content after decoding its Base64",{"_4070":1062,"_34195":1023,"_23354":59982,"_5":16137,"_30763":59886,"_3518":59983},[],"`application/pkcs8`",{"_4070":1063,"_34195":1023,"_23354":59985,"_5":16137,"_30763":59886,"_3518":59986},[],"Unencrypted DER PKCS#8 private key.",{"_4070":1064,"_34195":1023,"_23354":59988,"_5":16137,"_30763":59886,"_3518":59989},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_4070":1065,"_34195":1023,"_23354":59991,"_5":16137,"_30763":59886,"_3518":59992},[],"DER PKCS#7 containing the issued certificate.",{"_4070":1066,"_34195":1023,"_23354":59994,"_5":16137,"_30763":59886,"_3518":59995},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_4070":1067,"_34195":1023,"_23354":59997,"_5":16137,"_30763":59890,"_3518":59998},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_4070":1068,"_34195":1023,"_23354":60000,"_5":16137,"_30763":59890,"_3518":60001},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_4070":1069,"_34195":1023,"_23354":60003,"_5":16137,"_30763":59890,"_3518":60004},[],"Convert and check the result:",{"_4070":1070,"_34195":1023,"_23354":60006,"_5":16137,"_30763":59890,"_3518":60007},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_4070":1071,"_34195":1023,"_23354":60009,"_5":16137,"_30763":59894,"_3518":60010},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_4070":1072,"_34195":1023,"_23354":60012,"_5":16137,"_30763":59894,"_3518":60013},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_4070":1073,"_34195":1073,"_5":16540,"_3518":59332,"_34626":60015,"_23354":60016,"_30763":1073},[56672,58140,59151,59149,59332],[],{"_4070":1074,"_34195":1073,"_23354":60018,"_5":16137,"_30763":1073,"_3518":60019},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_4070":1075,"_34195":1073,"_5":34623,"_23354":60021,"_30763":60022,"_3518":60023},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_4070":1076,"_34195":1073,"_5":34623,"_23354":60025,"_30763":60026,"_3518":60027},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_4070":1077,"_34195":1073,"_5":34623,"_23354":60029,"_30763":60030,"_3518":60031},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_4070":1078,"_34195":1073,"_5":34623,"_23354":60033,"_30763":60034,"_3518":60035},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_4070":1079,"_34195":1073,"_23354":60037,"_5":16137,"_30763":1073,"_3518":60038},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_4070":1080,"_34195":1073,"_23354":60040,"_5":16137,"_30763":60022,"_3518":60041},[],"The administrator prepares the CA, issuance profile and DMS.",{"_4070":1081,"_34195":1073,"_23354":60043,"_5":16137,"_30763":60022,"_3518":60044},[],"The integrator installs initial EST server trust and an admission credential.",{"_4070":1082,"_34195":1073,"_23354":60046,"_5":16137,"_30763":60022,"_3518":60047},[],"The client requests an identity for its `Device ID` through EST.",{"_4070":1083,"_34195":1073,"_23354":60049,"_5":16137,"_30763":60022,"_3518":60050},[],"Certificate, device binding and key/certificate installation are checked.",{"_4070":1084,"_34195":1073,"_23354":60052,"_5":16137,"_30763":60022,"_3518":60053},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_4070":1085,"_34195":1073,"_23354":60055,"_5":16137,"_30763":60022,"_3518":60056},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_4070":1086,"_34195":1073,"_23354":60058,"_5":16137,"_30763":60026,"_3518":60059},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_4070":1087,"_34195":1073,"_23354":60061,"_5":16137,"_30763":60026,"_3518":60062},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_4070":1088,"_34195":1073,"_23354":60064,"_5":16137,"_30763":60026,"_3518":60065},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_4070":1089,"_34195":1073,"_23354":60067,"_5":16137,"_30763":60026,"_3518":60068},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_4070":1090,"_34195":1073,"_23354":60070,"_5":16137,"_30763":60030,"_3518":60071},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_4070":1091,"_34195":1073,"_23354":60073,"_5":16137,"_30763":60030,"_3518":60074},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_4070":1092,"_34195":1073,"_23354":60076,"_5":16137,"_30763":60030,"_3518":60077},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_4070":1093,"_34195":1073,"_23354":60079,"_5":16137,"_30763":60030,"_3518":60080},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_4070":1094,"_34195":1073,"_23354":60082,"_5":16137,"_30763":60034,"_3518":60083},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_4070":1095,"_34195":1073,"_23354":60085,"_5":16137,"_30763":60034,"_3518":60086},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_4070":1096,"_34195":1096,"_5":16540,"_3518":60088,"_34626":60089,"_23354":60090,"_30763":1096},"Provisioning strategies",[56672,58140,59151,59149,59332],[],{"_4070":1097,"_34195":1096,"_23354":60092,"_5":16137,"_30763":1096,"_3518":60093},[],"Choose device registration, identity authorization and key generation.",{"_4070":1098,"_34195":1096,"_5":34623,"_23354":60095,"_30763":60096,"_3518":60097},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_4070":1099,"_34195":1096,"_5":34623,"_23354":60099,"_30763":60100,"_3518":60101},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_4070":1100,"_34195":1096,"_5":34623,"_23354":60103,"_30763":60104,"_3518":60105},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_4070":1101,"_34195":1096,"_5":34623,"_23354":60107,"_30763":60108,"_3518":60109},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_4070":1102,"_34195":1096,"_5":34623,"_23354":60111,"_30763":60112,"_3518":60113},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_4070":1103,"_34195":1096,"_23354":60115,"_5":16137,"_30763":1096,"_3518":60116},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_4070":1104,"_34195":1096,"_23354":60118,"_5":16137,"_30763":60096,"_3518":60119},[],"Path",{"_4070":1105,"_34195":1096,"_23354":60121,"_5":16137,"_30763":60096,"_3518":60122},[],"When the device exists",{"_4070":1106,"_34195":1096,"_23354":60124,"_5":16137,"_30763":60096,"_3518":60125},[],"What to check",{"_4070":1107,"_34195":1096,"_23354":60127,"_5":16137,"_30763":60096,"_3518":60128},[],"Manual assignment",{"_4070":1108,"_34195":1096,"_23354":60130,"_5":16137,"_30763":60096,"_3518":60131},[],"An operator creates it before associating a certificate.",{"_4070":1109,"_34195":1096,"_23354":60133,"_5":16137,"_30763":60096,"_3518":60134},[],"ID, owning DMS, certificate CN and bound serial.",{"_4070":1110,"_34195":1096,"_23354":60136,"_5":16137,"_30763":60096,"_3518":60137},[],"EST with `JITP`",{"_4070":1111,"_34195":1096,"_23354":60139,"_5":16137,"_30763":60096,"_3518":60140},[],"Created for an unknown CN during `/simpleenroll`.",{"_4070":1112,"_34195":1096,"_23354":60142,"_5":16137,"_30763":60096,"_3518":60143},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_4070":1113,"_34195":1096,"_23354":60145,"_5":16137,"_30763":60096,"_3518":60146},[],"EST with `PRE_REGISTRATION`",{"_4070":1114,"_34195":1096,"_23354":60148,"_5":16137,"_30763":60096,"_3518":60149},[],"Must exist before `/simpleenroll`.",{"_4070":1115,"_34195":1096,"_23354":60151,"_5":16137,"_30763":60096,"_3518":60152},[],"Approved record, same DMS and replacement conditions for your version.",{"_4070":1116,"_34195":1096,"_23354":60154,"_5":16137,"_30763":60096,"_3518":60155},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_4070":1117,"_34195":1096,"_23354":60157,"_5":16137,"_30763":60096,"_3518":60158},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_4070":1118,"_34195":1096,"_23354":60160,"_5":16137,"_30763":60100,"_3518":60161},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_4070":1119,"_34195":1096,"_23354":60163,"_5":16137,"_30763":60100,"_3518":60164},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_4070":1120,"_34195":1096,"_23354":60166,"_5":16137,"_30763":60100,"_3518":60167},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_4070":1121,"_34195":1096,"_23354":60169,"_5":16137,"_30763":60104,"_3518":60170},[],"Decide initial enrollment and re-enrollment separately:",{"_4070":1122,"_34195":1096,"_23354":60172,"_5":16137,"_30763":60104,"_3518":60173},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_4070":1123,"_34195":1096,"_23354":60175,"_5":16137,"_30763":60104,"_3518":60176},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_4070":1124,"_34195":1096,"_23354":60178,"_5":16137,"_30763":60104,"_3518":60179},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_4070":1125,"_34195":1096,"_23354":60181,"_5":16137,"_30763":60104,"_3518":60182},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_4070":1126,"_34195":1096,"_23354":60184,"_5":16137,"_30763":60104,"_3518":60185},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_4070":1127,"_34195":1096,"_23354":60187,"_5":16137,"_30763":60108,"_3518":57056},[],{"_4070":1128,"_34195":1096,"_23354":60189,"_5":16137,"_30763":60108,"_3518":60190},[],"Material crossing EST",{"_4070":1129,"_34195":1096,"_23354":60192,"_5":16137,"_30763":60108,"_3518":60193},[],"Device-generated key",{"_4070":1130,"_34195":1096,"_23354":60195,"_5":16137,"_30763":60108,"_3518":60196},[],"Public CSR and certificate; the key stays on the client.",{"_4070":1131,"_34195":1096,"_23354":60198,"_5":16137,"_30763":60108,"_3518":60199},[],"Existing device key",{"_4070":1132,"_34195":1096,"_23354":60201,"_5":16137,"_30763":60108,"_3518":60202},[],"CSR signed with that key and a new certificate.",{"_4070":1133,"_34195":1096,"_23354":60204,"_5":16137,"_30763":60108,"_3518":59470},[],{"_4070":1134,"_34195":1096,"_23354":60206,"_5":16137,"_30763":60108,"_3518":60207},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_4070":1135,"_34195":1096,"_23354":60209,"_5":16137,"_30763":60108,"_3518":60210},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_4070":1136,"_34195":1096,"_23354":60212,"_5":16137,"_30763":60112,"_3518":60213},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_4070":1137,"_34195":1137,"_5":16540,"_3518":60215,"_34626":60216,"_23354":60217,"_30763":1137},"Renewal and recovery",[56672,58140,59151,59149,59332],[],{"_4070":1138,"_34195":1137,"_23354":60219,"_5":16137,"_30763":1137,"_3518":60220},[],"Renew without losing the identity and recover devices according to their actual state.",{"_4070":1139,"_34195":1137,"_5":34623,"_23354":60222,"_30763":60223,"_3518":60224},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_4070":1140,"_34195":1137,"_5":34623,"_23354":60226,"_30763":60227,"_3518":60228},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_4070":1141,"_34195":1137,"_5":34623,"_23354":60230,"_30763":60231,"_3518":60232},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_4070":1142,"_34195":1137,"_5":34623,"_23354":60234,"_30763":60235,"_3518":60236},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_4070":1143,"_34195":1137,"_5":34623,"_23354":60238,"_30763":60239,"_3518":60240},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_4070":1144,"_34195":1137,"_23354":60242,"_5":16137,"_30763":1137,"_3518":60243},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_4070":1145,"_34195":1137,"_23354":60245,"_5":16137,"_30763":60223,"_3518":60246},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_4070":1146,"_34195":1137,"_23354":60248,"_5":16137,"_30763":60223,"_3518":60249},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_4070":1147,"_34195":1137,"_23354":60251,"_5":16137,"_30763":60223,"_3518":60252},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_4070":1148,"_34195":1137,"_23354":60254,"_5":16137,"_30763":60223,"_3518":60255},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_4070":1149,"_34195":1137,"_23354":60257,"_5":16137,"_30763":60227,"_3518":60258},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_4070":1150,"_34195":1137,"_23354":60260,"_5":16137,"_30763":60227,"_3518":60261},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_4070":1151,"_34195":1137,"_23354":60263,"_5":16137,"_30763":60231,"_3518":60264},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_4070":1152,"_34195":1137,"_23354":60266,"_5":16137,"_30763":60231,"_3518":60267},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_4070":1153,"_34195":1137,"_23354":60269,"_5":16137,"_30763":60231,"_3518":60270},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_4070":1154,"_34195":1137,"_23354":60272,"_5":16137,"_30763":60235,"_3518":60273},[],"Situation",{"_4070":1155,"_34195":1137,"_23354":60275,"_5":16137,"_30763":60235,"_3518":60276},[],"Procedure",{"_4070":1156,"_34195":1137,"_23354":60278,"_5":16137,"_30763":60235,"_3518":60279},[],"Valid certificate, outside the window",{"_4070":1157,"_34195":1137,"_23354":60281,"_5":16137,"_30763":60235,"_3518":60282},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_4070":1158,"_34195":1137,"_23354":60284,"_5":16137,"_30763":60235,"_3518":60285},[],"Expired certificate, key available",{"_4070":1159,"_34195":1137,"_23354":60287,"_5":16137,"_30763":60235,"_3518":60288},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_4070":1160,"_34195":1137,"_23354":60290,"_5":16137,"_30763":60235,"_3518":60291},[],"Renewal through webhook or `NO_AUTH`",{"_4070":1161,"_34195":1137,"_23354":60293,"_5":16137,"_30763":60235,"_3518":60294},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_4070":1162,"_34195":1137,"_23354":60296,"_5":16137,"_30763":60235,"_3518":60297},[],"Lost or inaccessible key",{"_4070":1163,"_34195":1137,"_23354":60299,"_5":16137,"_30763":60235,"_3518":60300},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_4070":1164,"_34195":1137,"_23354":60302,"_5":16137,"_30763":60235,"_3518":60303},[],"Current identity revoked",{"_4070":1165,"_34195":1137,"_23354":60305,"_5":16137,"_30763":60235,"_3518":60306},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_4070":1166,"_34195":1137,"_23354":60308,"_5":16137,"_30763":60235,"_3518":60309},[],"Device without an identity",{"_4070":1167,"_34195":1137,"_23354":60311,"_5":16137,"_30763":60235,"_3518":60312},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_4070":1168,"_34195":1137,"_23354":60314,"_5":16137,"_30763":60235,"_3518":60315},[],"Retired device",{"_4070":1169,"_34195":1137,"_23354":60317,"_5":16137,"_30763":60235,"_3518":60318},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_4070":1170,"_34195":1137,"_23354":60320,"_5":16137,"_30763":60235,"_3518":60321},[],"Timeout, HTTP 500 or installation failure",{"_4070":1171,"_34195":1137,"_23354":60323,"_5":16137,"_30763":60235,"_3518":60324},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_4070":1172,"_34195":1137,"_23354":60326,"_5":16137,"_30763":60239,"_3518":60327},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_4070":1173,"_34195":1137,"_23354":60329,"_5":16137,"_30763":60239,"_3518":60330},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_4070":1174,"_34195":1174,"_5":16540,"_3518":60332,"_34626":60333,"_23354":60334,"_30763":1174},"Enrollment troubleshooting",[56672,58140,59151,59149,59332],[],{"_4070":1175,"_34195":1174,"_23354":60336,"_5":16137,"_30763":1174,"_3518":60337},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_4070":1176,"_34195":1174,"_5":34623,"_23354":60339,"_30763":60340,"_3518":60341},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_4070":1177,"_34195":1174,"_5":34623,"_23354":60343,"_30763":60344,"_3518":60345},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_4070":1178,"_34195":1174,"_5":34623,"_23354":60347,"_30763":60348,"_3518":59895},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_4070":1179,"_34195":1174,"_5":34623,"_23354":60350,"_30763":60351,"_3518":60352},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_4070":1180,"_34195":1174,"_23354":60354,"_5":16137,"_30763":1174,"_3518":60355},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_4070":1181,"_34195":1174,"_23354":60357,"_5":16137,"_30763":60344,"_3518":60358},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_4070":1182,"_34195":1174,"_23354":60360,"_5":16137,"_30763":60344,"_3518":60361},[],"Symptom or message",{"_4070":1183,"_34195":1174,"_23354":60363,"_5":16137,"_30763":60344,"_3518":60125},[],{"_4070":1184,"_34195":1174,"_23354":60365,"_5":16137,"_30763":60344,"_3518":60366},[],"curl rejects TLS, name or issuer",{"_4070":1185,"_34195":1174,"_23354":60368,"_5":16137,"_30763":60344,"_3518":60369},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_4070":1186,"_34195":1174,"_23354":60371,"_5":16137,"_30763":60344,"_3518":60372},[],"404 or missing APS",{"_4070":1187,"_34195":1174,"_23354":60374,"_5":16137,"_30763":60344,"_3518":60375},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_4070":1188,"_34195":1174,"_23354":60377,"_5":16137,"_30763":60344,"_3518":60378},[],"400, CSR or format error",{"_4070":1189,"_34195":1174,"_23354":60380,"_5":16137,"_30763":60344,"_3518":60381},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_4070":1190,"_34195":1174,"_23354":60383,"_5":16137,"_30763":60344,"_3518":60384},[],"Missing credential or invalid certificate",{"_4070":1191,"_34195":1174,"_23354":60386,"_5":16137,"_30763":60344,"_3518":60387},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_4070":1192,"_34195":1174,"_23354":60389,"_5":16137,"_30763":60344,"_3518":60390},[],"Webhook denies, times out or responds without authorization",{"_4070":1193,"_34195":1174,"_23354":60392,"_5":16137,"_30763":60344,"_3518":60393},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_4070":1194,"_34195":1174,"_23354":60395,"_5":16137,"_30763":60344,"_3518":60396},[],"`unexpected status code: <n>: redirects are not followed`",{"_4070":1195,"_34195":1174,"_23354":60398,"_5":16137,"_30763":60344,"_3518":60399},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_4070":1196,"_34195":1174,"_23354":60401,"_5":16137,"_30763":60344,"_3518":60402},[],"`webhook response exceeds 1048576 bytes`",{"_4070":1197,"_34195":1174,"_23354":60404,"_5":16137,"_30763":60344,"_3518":60405},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_4070":1198,"_34195":1174,"_23354":60407,"_5":16137,"_30763":60344,"_3518":60408},[],"`webhook config must not reference files`",{"_4070":1199,"_34195":1174,"_23354":60410,"_5":16137,"_30763":60344,"_3518":60411},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_4070":1200,"_34195":1174,"_23354":60413,"_5":16137,"_30763":60344,"_3518":60414},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_4070":1201,"_34195":1174,"_23354":60416,"_5":16137,"_30763":60344,"_3518":60417},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_4070":1202,"_34195":1174,"_23354":60419,"_5":16137,"_30763":60344,"_3518":60420},[],"`webhook mTLS certificate and key are invalid: …`",{"_4070":1203,"_34195":1174,"_23354":60422,"_5":16137,"_30763":60344,"_3518":60423},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_4070":1204,"_34195":1174,"_23354":60425,"_5":16137,"_30763":60344,"_3518":60426},[],"400 `struct validation error` creating or updating a DMS",{"_4070":1205,"_34195":1174,"_23354":60428,"_5":16137,"_30763":60344,"_3518":60429},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_4070":1206,"_34195":1174,"_23354":60431,"_5":16137,"_30763":60344,"_3518":60432},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_4070":1207,"_34195":1174,"_23354":60434,"_5":16137,"_30763":60344,"_3518":60435},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_4070":1208,"_34195":1174,"_23354":60437,"_5":16137,"_30763":60344,"_3518":60438},[],"`device not preregistered`",{"_4070":1209,"_34195":1174,"_23354":60440,"_5":16137,"_30763":60344,"_3518":60441},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_4070":1210,"_34195":1174,"_23354":60443,"_5":16137,"_30763":60344,"_3518":60444},[],"`forbiddenNewEnrollment`",{"_4070":1211,"_34195":1174,"_23354":60446,"_5":16137,"_30763":60344,"_3518":60447},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_4070":1212,"_34195":1174,"_23354":60449,"_5":16137,"_30763":60344,"_3518":60450},[],"Different owning DMS",{"_4070":1213,"_34195":1174,"_23354":60452,"_5":16137,"_30763":60344,"_3518":60453},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_4070":1214,"_34195":1174,"_23354":60455,"_5":16137,"_30763":60344,"_3518":60456},[],"`invalid RawSubject bytes`",{"_4070":1215,"_34195":1174,"_23354":60458,"_5":16137,"_30763":60344,"_3518":60459},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_4070":1216,"_34195":1174,"_23354":60461,"_5":16137,"_30763":60344,"_3518":60462},[],"`invalid reenroll window`",{"_4070":1217,"_34195":1174,"_23354":60464,"_5":16137,"_30763":60344,"_3518":60465},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_4070":1218,"_34195":1174,"_23354":60467,"_5":16137,"_30763":60344,"_3518":60468},[],"Current certificate revoked",{"_4070":1219,"_34195":1174,"_23354":60470,"_5":16137,"_30763":60344,"_3518":60471},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_4070":1220,"_34195":1174,"_23354":60473,"_5":16137,"_30763":60344,"_3518":60474},[],"CA, profile or signing error",{"_4070":1221,"_34195":1174,"_23354":60476,"_5":16137,"_30763":60344,"_3518":60477},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_4070":1222,"_34195":1174,"_23354":60479,"_5":16137,"_30763":60344,"_3518":60480},[],"HTTP 200 without a device connection",{"_4070":1223,"_34195":1174,"_23354":60482,"_5":16137,"_30763":60344,"_3518":60483},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_4070":1224,"_34195":1174,"_23354":60485,"_5":16137,"_30763":60344,"_3518":60486},[],"Timeout or error after issuance",{"_4070":1225,"_34195":1174,"_23354":60488,"_5":16137,"_30763":60344,"_3518":60489},[],"New certificates, current slot and previous identity's state before retrying.",{"_4070":1226,"_34195":1174,"_23354":60491,"_5":16137,"_30763":60348,"_3518":60492},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_4070":1227,"_34195":1174,"_23354":60494,"_5":16137,"_30763":60348,"_3518":60495},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_4070":1228,"_34195":1174,"_23354":60497,"_5":16137,"_30763":60351,"_3518":60498},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_4070":1229,"_34195":1174,"_23354":60500,"_5":16137,"_30763":60351,"_3518":60501},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_4070":1230,"_34195":1174,"_23354":60503,"_5":16137,"_30763":60351,"_3518":60504},[],"Verify the CSR locally and relate its CN to the inventory.",{"_4070":1231,"_34195":1174,"_23354":60506,"_5":16137,"_30763":60351,"_3518":60507},[],"Make one request, save headers/body and query the device and certificates.",{"_4070":1232,"_34195":1174,"_23354":60509,"_5":16137,"_30763":60351,"_3518":60510},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_4070":1233,"_34195":1174,"_23354":60512,"_5":16137,"_30763":60351,"_3518":60513},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_4070":1234,"_34195":1174,"_23354":60515,"_5":16137,"_30763":60351,"_3518":60516},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_4070":1235,"_34195":1235,"_5":16540,"_3518":60518,"_34626":60519,"_23354":60520,"_30763":1235},"Trust distribution and updates",[56672,58140,59151,59149,59332],[],{"_4070":1236,"_34195":1235,"_23354":60522,"_5":16137,"_30763":1235,"_3518":60523},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_4070":1237,"_34195":1235,"_5":34623,"_23354":60525,"_30763":60526,"_3518":60527},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_4070":1238,"_34195":1235,"_5":34623,"_23354":60529,"_30763":60530,"_3518":60531},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_4070":1239,"_34195":1235,"_5":34623,"_23354":60533,"_30763":60534,"_3518":60535},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_4070":1240,"_34195":1235,"_5":34623,"_23354":60537,"_30763":60538,"_3518":60539},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_4070":1241,"_34195":1235,"_5":34623,"_23354":60541,"_30763":60542,"_3518":60543},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_4070":1242,"_34195":1235,"_23354":60545,"_5":16137,"_30763":1235,"_3518":60546},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_4070":1243,"_34195":1235,"_23354":60548,"_5":16137,"_30763":60526,"_3518":60549},[],"Relationship",{"_4070":1244,"_34195":1235,"_23354":60551,"_5":16137,"_30763":60526,"_3518":60552},[],"Material prepared by its owner",{"_4070":1245,"_34195":1235,"_23354":60554,"_5":16137,"_30763":60526,"_3518":60555},[],"Device → EST server",{"_4070":1246,"_34195":1235,"_23354":60557,"_5":16137,"_30763":60526,"_3518":60558},[],"Previously verified server root, chain or pin and TLS name.",{"_4070":1247,"_34195":1235,"_23354":60560,"_5":16137,"_30763":60526,"_3518":60561},[],"DMS → requester",{"_4070":1248,"_34195":1235,"_23354":60563,"_5":16137,"_30763":60526,"_3518":60564},[],"CAs and rules authorizing initial or renewal credentials.",{"_4070":1249,"_34195":1235,"_23354":60566,"_5":16137,"_30763":60526,"_3518":60567},[],"Consumer → device",{"_4070":1250,"_34195":1235,"_23354":60569,"_5":16137,"_30763":60526,"_3518":60570},[],"Operational identity roots, intermediates, validation and permissions.",{"_4070":1251,"_34195":1235,"_23354":60572,"_5":16137,"_30763":60526,"_3518":60573},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_4070":1252,"_34195":1235,"_23354":60575,"_5":16137,"_30763":60530,"_3518":60576},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_4070":1253,"_34195":1235,"_23354":60578,"_5":16137,"_30763":60530,"_3518":60579},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_4070":1254,"_34195":1235,"_23354":60581,"_5":16137,"_30763":60534,"_3518":60582},[],"Keep initial EST server trust separate from identity consumer trust.",{"_4070":1255,"_34195":1235,"_23354":60584,"_5":16137,"_30763":60534,"_3518":60585},[],"Select policy-approved roots as anchors.",{"_4070":1256,"_34195":1235,"_23354":60587,"_5":16137,"_30763":60534,"_3518":60588},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_4070":1257,"_34195":1235,"_23354":60590,"_5":16137,"_30763":60534,"_3518":60591},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_4070":1258,"_34195":1235,"_23354":60593,"_5":16137,"_30763":60534,"_3518":60594},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_4070":1259,"_34195":1235,"_23354":60596,"_5":16137,"_30763":60534,"_3518":60597},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_4070":1260,"_34195":1235,"_23354":60599,"_5":16137,"_30763":60538,"_3518":60600},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_4070":1261,"_34195":1235,"_23354":60602,"_5":16137,"_30763":60538,"_3518":60603},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_4070":1262,"_34195":1235,"_23354":60605,"_5":16137,"_30763":60538,"_3518":60606},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_4070":1263,"_34195":1235,"_23354":60608,"_5":16137,"_30763":60542,"_3518":60609},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_4070":1264,"_34195":1264,"_5":16540,"_3518":60611,"_34626":60612,"_23354":60614,"_30763":1264},"AWS IoT Core",[56672,58140,59151,59149,60613],"Integrations",[],{"_4070":1265,"_34195":1264,"_23354":60616,"_5":16137,"_30763":1264,"_3518":60617},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_4070":1266,"_34195":1264,"_5":34623,"_23354":60619,"_30763":60620,"_3518":60621},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_4070":1267,"_34195":1264,"_5":34623,"_23354":60623,"_30763":60624,"_3518":60625},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_4070":1268,"_34195":1264,"_5":34623,"_23354":60627,"_30763":60628,"_3518":60629},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_4070":1269,"_34195":1264,"_5":34623,"_23354":60631,"_30763":60632,"_3518":60633},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_4070":1270,"_34195":1264,"_5":34623,"_23354":60635,"_30763":60636,"_3518":60637},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_4070":1271,"_34195":1264,"_5":34623,"_23354":60639,"_30763":60640,"_3518":60641},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_4070":1272,"_34195":1264,"_5":34623,"_23354":60643,"_30763":60644,"_3518":60645},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_4070":1273,"_34195":1264,"_5":34623,"_23354":60647,"_30763":60648,"_3518":60649},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_4070":1274,"_34195":1264,"_5":34623,"_23354":60651,"_30763":60652,"_3518":60653},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_4070":1275,"_34195":1264,"_5":34623,"_23354":60655,"_30763":60656,"_3518":60657},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_4070":1276,"_34195":1264,"_5":34623,"_23354":60659,"_30763":60660,"_3518":60661},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_4070":1277,"_34195":1264,"_5":34623,"_23354":60663,"_30763":60664,"_3518":60665},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_4070":1278,"_34195":1264,"_5":34623,"_23354":60667,"_30763":60668,"_3518":60669},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_4070":1279,"_34195":1264,"_5":34623,"_23354":60671,"_30763":60672,"_3518":60673},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_4070":1280,"_34195":1264,"_5":34623,"_23354":60675,"_30763":60676,"_3518":60677},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_4070":1281,"_34195":1264,"_5":34623,"_23354":60679,"_30763":60680,"_3518":60681},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_4070":1282,"_34195":1264,"_5":34623,"_23354":60683,"_30763":60684,"_3518":60685},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_4070":1283,"_34195":1264,"_5":34623,"_23354":60687,"_30763":60688,"_3518":60689},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_4070":1284,"_34195":1264,"_5":34623,"_23354":60691,"_30763":60692,"_3518":60693},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_4070":1285,"_34195":1264,"_5":34623,"_23354":60695,"_30763":60696,"_3518":60697},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_4070":1286,"_34195":1264,"_5":34623,"_23354":60699,"_30763":60700,"_3518":60701},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_4070":1287,"_34195":1264,"_5":34623,"_23354":60703,"_30763":60704,"_3518":60705},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_4070":1288,"_34195":1264,"_5":34623,"_23354":60707,"_30763":60708,"_3518":60709},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_4070":1289,"_34195":1264,"_5":34623,"_23354":60711,"_30763":60712,"_3518":60713},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_4070":1290,"_34195":1264,"_5":34623,"_23354":60715,"_30763":60716,"_3518":60717},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_4070":1291,"_34195":1264,"_23354":60719,"_5":16137,"_30763":1264,"_3518":60720},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_4070":1292,"_34195":1264,"_23354":60722,"_5":16137,"_30763":1264,"_3518":60723},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_4070":1293,"_34195":1264,"_23354":60725,"_5":16137,"_30763":1264,"_3518":60726},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_4070":1294,"_34195":1264,"_23354":60728,"_5":16137,"_30763":60620,"_3518":60729},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_4070":1295,"_34195":1264,"_23354":60731,"_5":16137,"_30763":60620,"_3518":60732},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_4070":1296,"_34195":1264,"_23354":60734,"_5":16137,"_30763":60620,"_3518":60735},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_4070":1297,"_34195":1264,"_23354":60737,"_5":16137,"_30763":60620,"_3518":60738},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_4070":1298,"_34195":1264,"_23354":60740,"_5":16137,"_30763":60624,"_3518":60741},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_4070":1299,"_34195":1264,"_23354":60743,"_5":16137,"_30763":60628,"_3518":60744},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_4070":1300,"_34195":1264,"_23354":60746,"_5":16137,"_30763":60628,"_3518":60747},[],"IAM action",{"_4070":1301,"_34195":1264,"_23354":60749,"_5":16137,"_30763":60628,"_3518":57062},[],{"_4070":1302,"_34195":1264,"_23354":60751,"_5":16137,"_30763":60628,"_3518":60752},[],"`iot:GetRegistrationCode`",{"_4070":1303,"_34195":1264,"_23354":60754,"_5":16137,"_30763":60628,"_3518":60755},[],"Obtain the verification code for CA registration in the Primary Account",{"_4070":1304,"_34195":1264,"_23354":60757,"_5":16137,"_30763":60628,"_3518":60758},[],"`iot:RegisterCACertificate`",{"_4070":1305,"_34195":1264,"_23354":60760,"_5":16137,"_30763":60628,"_3518":60761},[],"Register the CA in AWS IoT",{"_4070":1306,"_34195":1264,"_23354":60763,"_5":16137,"_30763":60628,"_3518":60764},[],"`iot:DescribeCACertificate`",{"_4070":1307,"_34195":1264,"_23354":60766,"_5":16137,"_30763":60628,"_3518":60767},[],"Check the CA registration status",{"_4070":1308,"_34195":1264,"_23354":60769,"_5":16137,"_30763":60628,"_3518":60770},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_4070":1309,"_34195":1264,"_23354":60772,"_5":16137,"_30763":60628,"_3518":60773},[],"Create or update Things in IoT Core",{"_4070":1310,"_34195":1264,"_23354":60775,"_5":16137,"_30763":60628,"_3518":60776},[],"`iot:RegisterThing`",{"_4070":1311,"_34195":1264,"_23354":60778,"_5":16137,"_30763":60628,"_3518":60779},[],"Provision Things through a template",{"_4070":1312,"_34195":1264,"_23354":60781,"_5":16137,"_30763":60628,"_3518":60782},[],"`iot:RegisterCertificate`",{"_4070":1313,"_34195":1264,"_23354":60784,"_5":16137,"_30763":60628,"_3518":60785},[],"Register device certificates",{"_4070":1314,"_34195":1264,"_23354":60787,"_5":16137,"_30763":60628,"_3518":60788},[],"`iot:UpdateCertificate`",{"_4070":1315,"_34195":1264,"_23354":60790,"_5":16137,"_30763":60628,"_3518":60791},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_4070":1316,"_34195":1264,"_23354":60793,"_5":16137,"_30763":60628,"_3518":60794},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_4070":1317,"_34195":1264,"_23354":60796,"_5":16137,"_30763":60628,"_3518":60797},[],"Create and attach IoT policies",{"_4070":1318,"_34195":1264,"_23354":60799,"_5":16137,"_30763":60628,"_3518":60800},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_4070":1319,"_34195":1264,"_23354":60802,"_5":16137,"_30763":60628,"_3518":60803},[],"Manage Thing groups",{"_4070":1320,"_34195":1264,"_23354":60805,"_5":16137,"_30763":60628,"_3518":60806},[],"`iot:CreateProvisioningTemplate`",{"_4070":1321,"_34195":1264,"_23354":60808,"_5":16137,"_30763":60628,"_3518":60809},[],"Create JITP templates",{"_4070":1322,"_34195":1264,"_23354":60811,"_5":16137,"_30763":60628,"_3518":60812},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_4070":1323,"_34195":1264,"_23354":60814,"_5":16137,"_30763":60628,"_3518":60815},[],"Read and write the Device Shadow",{"_4070":1324,"_34195":1264,"_23354":60817,"_5":16137,"_30763":60628,"_3518":60818},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_4070":1325,"_34195":1264,"_23354":60820,"_5":16137,"_30763":60632,"_3518":60821},[],"Parameter",{"_4070":1326,"_34195":1264,"_23354":60823,"_5":16137,"_30763":60632,"_3518":60824},[],"Type",{"_4070":1327,"_34195":1264,"_23354":60826,"_5":16137,"_30763":60632,"_3518":60827},[],"Required",{"_4070":1328,"_34195":1264,"_23354":60829,"_5":16137,"_30763":60632,"_3518":60830},[],"Description",{"_4070":1329,"_34195":1264,"_23354":60832,"_5":16137,"_30763":60632,"_3518":60833},[],"`connector_id`",{"_4070":1330,"_34195":1264,"_23354":60835,"_5":16137,"_30763":60632,"_3518":27927},[],{"_4070":1331,"_34195":1264,"_23354":60837,"_5":16137,"_30763":60632,"_3518":60838},[],"Yes",{"_4070":1332,"_34195":1264,"_23354":60840,"_5":16137,"_30763":60632,"_3518":60841},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_4070":1333,"_34195":1264,"_23354":60843,"_5":16137,"_30763":60632,"_3518":60844},[],"`aws_config.region`",{"_4070":1334,"_34195":1264,"_23354":60846,"_5":16137,"_30763":60632,"_3518":27927},[],{"_4070":1335,"_34195":1264,"_23354":60848,"_5":16137,"_30763":60632,"_3518":60838},[],{"_4070":1336,"_34195":1264,"_23354":60850,"_5":16137,"_30763":60632,"_3518":60851},[],"AWS region where the connector operates.",{"_4070":1337,"_34195":1264,"_23354":60853,"_5":16137,"_30763":60632,"_3518":60854},[],"`aws_config.auth_method`",{"_4070":1338,"_34195":1264,"_23354":60856,"_5":16137,"_30763":60632,"_3518":27927},[],{"_4070":1339,"_34195":1264,"_23354":60858,"_5":16137,"_30763":60632,"_3518":60838},[],{"_4070":1340,"_34195":1264,"_23354":60860,"_5":16137,"_30763":60632,"_3518":60861},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_4070":1341,"_34195":1264,"_23354":60863,"_5":16137,"_30763":60632,"_3518":60864},[],"`aws_config.access_key_id`",{"_4070":1342,"_34195":1264,"_23354":60866,"_5":16137,"_30763":60632,"_3518":27927},[],{"_4070":1343,"_34195":1264,"_23354":60868,"_5":16137,"_30763":60632,"_3518":60869},[],"Only with `auth_method=static`",{"_4070":1344,"_34195":1264,"_23354":60871,"_5":16137,"_30763":60632,"_3518":60872},[],"AWS access key.",{"_4070":1345,"_34195":1264,"_23354":60874,"_5":16137,"_30763":60632,"_3518":60875},[],"`aws_config.secret_access_key`",{"_4070":1346,"_34195":1264,"_23354":60877,"_5":16137,"_30763":60632,"_3518":27927},[],{"_4070":1347,"_34195":1264,"_23354":60879,"_5":16137,"_30763":60632,"_3518":60869},[],{"_4070":1348,"_34195":1264,"_23354":60881,"_5":16137,"_30763":60632,"_3518":60882},[],"AWS secret key.",{"_4070":1349,"_34195":1264,"_23354":60884,"_5":16137,"_30763":60632,"_3518":60885},[],"`aws_config.session_token`",{"_4070":1350,"_34195":1264,"_23354":60887,"_5":16137,"_30763":60632,"_3518":27927},[],{"_4070":1351,"_34195":1264,"_23354":60889,"_5":16137,"_30763":60632,"_3518":60890},[],"No",{"_4070":1352,"_34195":1264,"_23354":60892,"_5":16137,"_30763":60632,"_3518":60893},[],"Session token (with `auth_method=static`).",{"_4070":1353,"_34195":1264,"_23354":60895,"_5":16137,"_30763":60632,"_3518":60896},[],"`aws_config.role_arn`",{"_4070":1354,"_34195":1264,"_23354":60898,"_5":16137,"_30763":60632,"_3518":27927},[],{"_4070":1355,"_34195":1264,"_23354":60900,"_5":16137,"_30763":60632,"_3518":60901},[],"Only with `auth_method=role`",{"_4070":1356,"_34195":1264,"_23354":60903,"_5":16137,"_30763":60632,"_3518":60904},[],"ARN of the role to assume.",{"_4070":1357,"_34195":1264,"_23354":60906,"_5":16137,"_30763":60632,"_3518":60907},[],"`aws_config.endpoint_url`",{"_4070":1358,"_34195":1264,"_23354":60909,"_5":16137,"_30763":60632,"_3518":27927},[],{"_4070":1359,"_34195":1264,"_23354":60911,"_5":16137,"_30763":60632,"_3518":60890},[],{"_4070":1360,"_34195":1264,"_23354":60913,"_5":16137,"_30763":60632,"_3518":60914},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_4070":1361,"_34195":1264,"_23354":60916,"_5":16137,"_30763":60632,"_3518":60917},[],"`subscriber_event_bus`",{"_4070":1362,"_34195":1264,"_23354":60919,"_5":16137,"_30763":60632,"_3518":19693},[],{"_4070":1363,"_34195":1264,"_23354":60921,"_5":16137,"_30763":60632,"_3518":60838},[],{"_4070":1364,"_34195":1264,"_23354":60923,"_5":16137,"_30763":60632,"_3518":60924},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_4070":1365,"_34195":1264,"_23354":60926,"_5":16137,"_30763":60632,"_3518":60927},[],"`dms_manager_client`",{"_4070":1366,"_34195":1264,"_23354":60929,"_5":16137,"_30763":60632,"_3518":27927},[],{"_4070":1367,"_34195":1264,"_23354":60931,"_5":16137,"_30763":60632,"_3518":60838},[],{"_4070":1368,"_34195":1264,"_23354":60933,"_5":16137,"_30763":60632,"_3518":60934},[],"HTTP URL of Lamassu's DMS Manager service.",{"_4070":1369,"_34195":1264,"_23354":60936,"_5":16137,"_30763":60632,"_3518":60937},[],"`device_manager_client`",{"_4070":1370,"_34195":1264,"_23354":60939,"_5":16137,"_30763":60632,"_3518":27927},[],{"_4070":1371,"_34195":1264,"_23354":60941,"_5":16137,"_30763":60632,"_3518":60838},[],{"_4070":1372,"_34195":1264,"_23354":60943,"_5":16137,"_30763":60632,"_3518":60944},[],"HTTP URL of Lamassu's Device Manager.",{"_4070":1373,"_34195":1264,"_23354":60946,"_5":16137,"_30763":60632,"_3518":60947},[],"`ca_client`",{"_4070":1374,"_34195":1264,"_23354":60949,"_5":16137,"_30763":60632,"_3518":27927},[],{"_4070":1375,"_34195":1264,"_23354":60951,"_5":16137,"_30763":60632,"_3518":60838},[],{"_4070":1376,"_34195":1264,"_23354":60953,"_5":16137,"_30763":60632,"_3518":60954},[],"HTTP URL of Lamassu's CA service.",{"_4070":1377,"_34195":1264,"_23354":60956,"_5":16137,"_30763":60636,"_3518":60957},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_4070":1378,"_34195":1264,"_23354":60959,"_5":16137,"_30763":60636,"_3518":60960},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_4070":1379,"_34195":1264,"_23354":60962,"_5":16137,"_30763":60636,"_3518":60963},[],"CloudEvent type",{"_4070":1380,"_34195":1264,"_23354":60965,"_5":16137,"_30763":60636,"_3518":60966},[],"Lamassu resource",{"_4070":1381,"_34195":1264,"_23354":60968,"_5":16137,"_30763":60636,"_3518":60969},[],"AWS Resource",{"_4070":1382,"_34195":1264,"_23354":60971,"_5":16137,"_30763":60636,"_3518":60972},[],"IAM actions",{"_4070":1383,"_34195":1264,"_23354":60974,"_5":16137,"_30763":60636,"_3518":60975},[],"AWS calls and effect",{"_4070":1384,"_34195":1264,"_23354":60977,"_5":16137,"_30763":60636,"_3518":60978},[],"Where in this page",{"_4070":1385,"_34195":1264,"_23354":60980,"_5":16137,"_30763":60636,"_3518":60981},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_4070":1386,"_34195":1264,"_23354":60983,"_5":16137,"_30763":60636,"_3518":60984},[],"CA",{"_4070":1387,"_34195":1264,"_23354":60986,"_5":16137,"_30763":60636,"_3518":60987},[],"`IoTCore/CACertificate`",{"_4070":1388,"_34195":1264,"_23354":60989,"_5":16137,"_30763":60636,"_3518":60990},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_4070":1389,"_34195":1264,"_23354":60992,"_5":16137,"_30763":60636,"_3518":60993},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_4070":1390,"_34195":1264,"_23354":60995,"_5":16137,"_30763":60636,"_3518":60649},[],{"_4070":1391,"_34195":1264,"_23354":60997,"_5":16137,"_30763":60636,"_3518":60998},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_4070":1392,"_34195":1264,"_23354":61000,"_5":16137,"_30763":60636,"_3518":61001},[],"DMS",{"_4070":1393,"_34195":1264,"_23354":61003,"_5":16137,"_30763":60636,"_3518":61004},[],"`IoTCore/ProvisioningTemplate`",{"_4070":1394,"_34195":1264,"_23354":61006,"_5":16137,"_30763":60636,"_3518":61007},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_4070":1395,"_34195":1264,"_23354":61009,"_5":16137,"_30763":60636,"_3518":61010},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_4070":1396,"_34195":1264,"_23354":61012,"_5":16137,"_30763":60636,"_3518":60677},[],{"_4070":1397,"_34195":1264,"_23354":61014,"_5":16137,"_30763":60636,"_3518":61015},[],"`EventBindDeviceIdentityKey`",{"_4070":1398,"_34195":1264,"_23354":61017,"_5":16137,"_30763":60636,"_3518":61018},[],"Device",{"_4070":1399,"_34195":1264,"_23354":61020,"_5":16137,"_30763":60636,"_3518":61021},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_4070":1400,"_34195":1264,"_23354":61023,"_5":16137,"_30763":60636,"_3518":61024},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_4070":1401,"_34195":1264,"_23354":61026,"_5":16137,"_30763":60636,"_3518":61027},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_4070":1402,"_34195":1264,"_23354":61029,"_5":16137,"_30763":60636,"_3518":60685},[],{"_4070":1403,"_34195":1264,"_23354":61031,"_5":16137,"_30763":60636,"_3518":61032},[],"`EventUpdateCertificateStatusKey`",{"_4070":1404,"_34195":1264,"_23354":61034,"_5":16137,"_30763":60636,"_3518":61035},[],"Certificate",{"_4070":1405,"_34195":1264,"_23354":61037,"_5":16137,"_30763":60636,"_3518":61038},[],"`IoTCore/Certificate`",{"_4070":1406,"_34195":1264,"_23354":61040,"_5":16137,"_30763":60636,"_3518":61041},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_4070":1407,"_34195":1264,"_23354":61043,"_5":16137,"_30763":60636,"_3518":61044},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_4070":1408,"_34195":1264,"_23354":61046,"_5":16137,"_30763":60636,"_3518":60697},[],{"_4070":1409,"_34195":1264,"_23354":61048,"_5":16137,"_30763":60636,"_3518":61049},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_4070":1410,"_34195":1264,"_23354":61051,"_5":16137,"_30763":60636,"_3518":61052},[],"Certificate / Device",{"_4070":1411,"_34195":1264,"_23354":61054,"_5":16137,"_30763":60636,"_3518":61055},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_4070":1412,"_34195":1264,"_23354":61057,"_5":16137,"_30763":60636,"_3518":57068},[],{"_4070":1413,"_34195":1264,"_23354":61059,"_5":16137,"_30763":60636,"_3518":61060},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_4070":1414,"_34195":1264,"_23354":61062,"_5":16137,"_30763":60636,"_3518":60705},[],{"_4070":1415,"_34195":1264,"_23354":61064,"_5":16137,"_30763":60640,"_3518":61065},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_4070":1416,"_34195":1264,"_23354":61067,"_5":16137,"_30763":60644,"_3518":61068},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_4070":1417,"_34195":1264,"_23354":61070,"_5":16137,"_30763":60644,"_3518":61071},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_4070":1418,"_34195":1264,"_23354":61073,"_5":16137,"_30763":60648,"_3518":61074},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_4070":1419,"_34195":1264,"_23354":61076,"_5":16137,"_30763":60648,"_3518":61077},[],"Transition",{"_4070":1420,"_34195":1264,"_23354":61079,"_5":16137,"_30763":60648,"_3518":61080},[],"AWS calls",{"_4070":1421,"_34195":1264,"_23354":61082,"_5":16137,"_30763":60648,"_3518":61083},[],"`NotRegistered` → `Requested`",{"_4070":1422,"_34195":1264,"_23354":61085,"_5":16137,"_30763":60648,"_3518":61086},[],"none (metadata write only)",{"_4070":1423,"_34195":1264,"_23354":61088,"_5":16137,"_30763":60648,"_3518":61089},[],"`Requested` → `Registering`",{"_4070":1424,"_34195":1264,"_23354":61091,"_5":16137,"_30763":60648,"_3518":61092},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_4070":1425,"_34195":1264,"_23354":61094,"_5":16137,"_30763":60648,"_3518":61095},[],"`Registering` → `Succeeded`",{"_4070":1426,"_34195":1264,"_23354":61097,"_5":16137,"_30763":60648,"_3518":61098},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_4070":1427,"_34195":1264,"_23354":61100,"_5":16137,"_30763":60648,"_3518":61101},[],"`Registering` → `Failed`",{"_4070":1428,"_34195":1264,"_23354":61103,"_5":16137,"_30763":60648,"_3518":61104},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_4070":1429,"_34195":1264,"_23354":61106,"_5":16137,"_30763":60648,"_3518":61107},[],"`Failed` / `Succeeded` → `Requested`",{"_4070":1430,"_34195":1264,"_23354":61109,"_5":16137,"_30763":60648,"_3518":61110},[],"none (a new `REQUESTED` write re-runs the flow)",{"_4070":1431,"_34195":1264,"_23354":61112,"_5":16137,"_30763":60652,"_3518":61113},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_4070":1432,"_34195":1264,"_23354":61115,"_5":16137,"_30763":60652,"_3518":61116},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_4070":1433,"_34195":1264,"_23354":61118,"_5":16137,"_30763":60652,"_3518":61119},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_4070":1434,"_34195":1264,"_23354":61121,"_5":16137,"_30763":60652,"_3518":61122},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_4070":1435,"_34195":1264,"_23354":61124,"_5":16137,"_30763":60652,"_3518":61125},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_4070":1436,"_34195":1264,"_23354":61127,"_5":16137,"_30763":60652,"_3518":61128},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_4070":1437,"_34195":1264,"_23354":61130,"_5":16137,"_30763":60656,"_3518":61131},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_4070":1438,"_34195":1264,"_23354":61133,"_5":16137,"_30763":60660,"_3518":61134},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_4070":1439,"_34195":1264,"_23354":61136,"_5":16137,"_30763":60660,"_3518":61137},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_4070":1440,"_34195":1264,"_23354":61139,"_5":16137,"_30763":60664,"_3518":61140},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_4070":1441,"_34195":1264,"_23354":61142,"_5":16137,"_30763":60668,"_3518":61143},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_4070":1442,"_34195":1264,"_23354":61145,"_5":16137,"_30763":60668,"_3518":61146},[],"Creates or updates the IoT policies configured in the DMS.",{"_4070":1443,"_34195":1264,"_23354":61148,"_5":16137,"_30763":60668,"_3518":61149},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_4070":1444,"_34195":1264,"_23354":61151,"_5":16137,"_30763":60668,"_3518":61152},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_4070":1445,"_34195":1264,"_23354":61154,"_5":16137,"_30763":60668,"_3518":61155},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_4070":1446,"_34195":1264,"_23354":61157,"_5":16137,"_30763":60668,"_3518":61158},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_4070":1447,"_34195":1264,"_23354":61160,"_5":16137,"_30763":60668,"_3518":61161},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_4070":1448,"_34195":1264,"_23354":61163,"_5":16137,"_30763":60672,"_3518":61164},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_4070":1449,"_34195":1264,"_23354":61166,"_5":16137,"_30763":60672,"_3518":61167},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_4070":1450,"_34195":1264,"_23354":61169,"_5":16137,"_30763":60672,"_3518":61170},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_4070":1451,"_34195":1264,"_23354":61172,"_5":16137,"_30763":60672,"_3518":61173},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_4070":1452,"_34195":1264,"_23354":61175,"_5":16137,"_30763":60672,"_3518":61176},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_4070":1453,"_34195":1264,"_23354":61178,"_5":16137,"_30763":60676,"_3518":61179},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_4070":1454,"_34195":1264,"_23354":61181,"_5":16137,"_30763":60676,"_3518":61077},[],{"_4070":1455,"_34195":1264,"_23354":61183,"_5":16137,"_30763":60676,"_3518":61080},[],{"_4070":1456,"_34195":1264,"_23354":61185,"_5":16137,"_30763":60676,"_3518":61186},[],"`Unconfigured` → `None` / `Auto`",{"_4070":1457,"_34195":1264,"_23354":61188,"_5":16137,"_30763":60676,"_3518":61189},[],"none (configuration only)",{"_4070":1458,"_34195":1264,"_23354":61191,"_5":16137,"_30763":60676,"_3518":61192},[],"`None` ↔ `Auto`",{"_4070":1459,"_34195":1264,"_23354":61194,"_5":16137,"_30763":60676,"_3518":61189},[],{"_4070":1460,"_34195":1264,"_23354":61196,"_5":16137,"_30763":60676,"_3518":61197},[],"Any → `Jitp`",{"_4070":1461,"_34195":1264,"_23354":61199,"_5":16137,"_30763":60676,"_3518":61200},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_4070":1462,"_34195":1264,"_23354":61202,"_5":16137,"_30763":60676,"_3518":61203},[],"`Jitp` → `None` / `Auto`",{"_4070":1463,"_34195":1264,"_23354":61205,"_5":16137,"_30763":60676,"_3518":61206},[],"none (the template stays in the AWS account)",{"_4070":1464,"_34195":1264,"_23354":61208,"_5":16137,"_30763":60680,"_3518":61209},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_4070":1465,"_34195":1264,"_23354":61211,"_5":16137,"_30763":60680,"_3518":61212},[],"The full flow from the device's perspective is:",{"_4070":1466,"_34195":1264,"_23354":61214,"_5":16137,"_30763":60680,"_3518":61215},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_4070":1467,"_34195":1264,"_23354":61217,"_5":16137,"_30763":60684,"_3518":61218},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_4070":1468,"_34195":1264,"_23354":61220,"_5":16137,"_30763":60684,"_3518":61077},[],{"_4070":1469,"_34195":1264,"_23354":61222,"_5":16137,"_30763":60684,"_3518":61080},[],{"_4070":1470,"_34195":1264,"_23354":61224,"_5":16137,"_30763":60684,"_3518":61225},[],"`Absent` → `Provisioned`",{"_4070":1471,"_34195":1264,"_23354":61227,"_5":16137,"_30763":60684,"_3518":61228},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_4070":1472,"_34195":1264,"_23354":61230,"_5":16137,"_30763":60684,"_3518":61231},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_4070":1473,"_34195":1264,"_23354":61233,"_5":16137,"_30763":60684,"_3518":61234},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_4070":1474,"_34195":1264,"_23354":61236,"_5":16137,"_30763":60684,"_3518":61237},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_4070":1475,"_34195":1264,"_23354":61239,"_5":16137,"_30763":60688,"_3518":61240},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_4070":1476,"_34195":1264,"_23354":61242,"_5":16137,"_30763":60688,"_3518":61243},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_4070":1477,"_34195":1264,"_23354":61245,"_5":16137,"_30763":60688,"_3518":61246},[],"For the JITP flow to work correctly:",{"_4070":1478,"_34195":1264,"_23354":61248,"_5":16137,"_30763":60688,"_3518":61249},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_4070":1479,"_34195":1264,"_23354":61251,"_5":16137,"_30763":60688,"_3518":61252},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_4070":1480,"_34195":1264,"_23354":61254,"_5":16137,"_30763":60688,"_3518":61255},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_4070":1481,"_34195":1264,"_23354":61257,"_5":16137,"_30763":60688,"_3518":61258},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_4070":1482,"_34195":1264,"_23354":61260,"_5":16137,"_30763":60692,"_3518":61261},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_4070":1483,"_34195":1264,"_23354":61263,"_5":16137,"_30763":60692,"_3518":61264},[],"Status in Lamassu",{"_4070":1484,"_34195":1264,"_23354":61266,"_5":16137,"_30763":60692,"_3518":61267},[],"Revocation reason",{"_4070":1485,"_34195":1264,"_23354":61269,"_5":16137,"_30763":60692,"_3518":61270},[],"Status in AWS IoT Core",{"_4070":1486,"_34195":1264,"_23354":61272,"_5":16137,"_30763":60692,"_3518":61273},[],"`Active`",{"_4070":1487,"_34195":1264,"_23354":61275,"_5":16137,"_30763":60692,"_3518":61276},[],"None",{"_4070":1488,"_34195":1264,"_23354":61278,"_5":16137,"_30763":60692,"_3518":61279},[],"`ACTIVE`",{"_4070":1489,"_34195":1264,"_23354":61281,"_5":16137,"_30763":60692,"_3518":61282},[],"`Revoked`",{"_4070":1490,"_34195":1264,"_23354":61284,"_5":16137,"_30763":60692,"_3518":61285},[],"`certificateHold`",{"_4070":1491,"_34195":1264,"_23354":61287,"_5":16137,"_30763":60692,"_3518":61288},[],"`INACTIVE`",{"_4070":1492,"_34195":1264,"_23354":61290,"_5":16137,"_30763":60692,"_3518":61282},[],{"_4070":1493,"_34195":1264,"_23354":61292,"_5":16137,"_30763":60692,"_3518":61293},[],"Any other reason",{"_4070":1494,"_34195":1264,"_23354":61295,"_5":16137,"_30763":60692,"_3518":61296},[],"`REVOKED`",{"_4070":1495,"_34195":1264,"_23354":61298,"_5":16137,"_30763":60692,"_3518":61299},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_4070":1496,"_34195":1264,"_23354":61301,"_5":16137,"_30763":60696,"_3518":61302},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_4070":1497,"_34195":1264,"_23354":61304,"_5":16137,"_30763":60696,"_3518":61077},[],{"_4070":1498,"_34195":1264,"_23354":61306,"_5":16137,"_30763":60696,"_3518":61080},[],{"_4070":1499,"_34195":1264,"_23354":61308,"_5":16137,"_30763":60696,"_3518":61309},[],"`NotSynced` → `Active`",{"_4070":1500,"_34195":1264,"_23354":61311,"_5":16137,"_30763":60696,"_3518":60788},[],{"_4070":1501,"_34195":1264,"_23354":61313,"_5":16137,"_30763":60696,"_3518":61314},[],"`Active` → `Inactive`",{"_4070":1502,"_34195":1264,"_23354":61316,"_5":16137,"_30763":60696,"_3518":61317},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_4070":1503,"_34195":1264,"_23354":61319,"_5":16137,"_30763":60696,"_3518":61320},[],"`Active` → `Revoked`",{"_4070":1504,"_34195":1264,"_23354":61322,"_5":16137,"_30763":60696,"_3518":61317},[],{"_4070":1505,"_34195":1264,"_23354":61324,"_5":16137,"_30763":60696,"_3518":61325},[],"`Inactive` / `Revoked` → `Active`",{"_4070":1506,"_34195":1264,"_23354":61327,"_5":16137,"_30763":60696,"_3518":60788},[],{"_4070":1507,"_34195":1264,"_23354":61329,"_5":16137,"_30763":60696,"_3518":61330},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_4070":1508,"_34195":1264,"_23354":61332,"_5":16137,"_30763":60696,"_3518":61333},[],"none (these states are not synced to AWS)",{"_4070":1509,"_34195":1264,"_23354":61335,"_5":16137,"_30763":60700,"_3518":61336},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_4070":1510,"_34195":1264,"_23354":61338,"_5":16137,"_30763":60700,"_3518":61339},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_4070":1511,"_34195":1264,"_23354":61341,"_5":16137,"_30763":60700,"_3518":61342},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_4070":1512,"_34195":1264,"_23354":61344,"_5":16137,"_30763":60704,"_3518":61345},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_4070":1513,"_34195":1264,"_23354":61347,"_5":16137,"_30763":60704,"_3518":61348},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_4070":1514,"_34195":1264,"_23354":61350,"_5":16137,"_30763":60708,"_3518":61351},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_4070":1515,"_34195":1264,"_23354":61353,"_5":16137,"_30763":60708,"_3518":61354},[],"There are two action types:",{"_4070":1516,"_34195":1264,"_23354":61356,"_5":16137,"_30763":60708,"_3518":61357},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_4070":1517,"_34195":1264,"_23354":61359,"_5":16137,"_30763":60708,"_3518":61360},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_4070":1518,"_34195":1264,"_23354":61362,"_5":16137,"_30763":60708,"_3518":61363},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_4070":1519,"_34195":1264,"_23354":61365,"_5":16137,"_30763":60712,"_3518":61366},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_4070":1520,"_34195":1264,"_23354":61368,"_5":16137,"_30763":60712,"_3518":61369},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_4070":1521,"_34195":1264,"_23354":61371,"_5":16137,"_30763":60712,"_3518":61372},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_4070":1522,"_34195":1264,"_23354":61374,"_5":16137,"_30763":60716,"_3518":61375},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_4070":1523,"_34195":1264,"_23354":61377,"_5":16137,"_30763":60716,"_3518":61378},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_4070":1524,"_34195":1264,"_23354":61380,"_5":16137,"_30763":60716,"_3518":61381},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_4070":1525,"_34195":1264,"_23354":61383,"_5":16137,"_30763":60716,"_3518":61384},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_4070":1526,"_34195":1264,"_23354":61386,"_5":16137,"_30763":60716,"_3518":61387},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_4070":1527,"_34195":1264,"_23354":61389,"_5":16137,"_30763":60716,"_3518":61390},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_4070":1528,"_34195":1264,"_23354":61392,"_5":16137,"_30763":60716,"_3518":61393},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_4070":1529,"_34195":1264,"_23354":61395,"_5":16137,"_30763":60716,"_3518":61396},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_4070":1530,"_34195":1264,"_23354":61398,"_5":16137,"_30763":60716,"_3518":61399},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_4070":1531,"_34195":1264,"_23354":61401,"_5":16137,"_30763":60716,"_3518":61402},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_4070":1532,"_34195":1264,"_23354":61404,"_5":16137,"_30763":60716,"_3518":61405},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_4070":1533,"_34195":1264,"_23354":61407,"_5":16137,"_30763":60716,"_3518":61408},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_4070":1534,"_34195":1264,"_23354":61410,"_5":16137,"_30763":60716,"_3518":61411},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_4070":1535,"_34195":1264,"_23354":61413,"_5":16137,"_30763":60716,"_3518":61414},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_4070":1536,"_34195":1264,"_23354":61416,"_5":16137,"_30763":60716,"_3518":61417},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_4070":1537,"_34195":1264,"_23354":61419,"_5":16137,"_30763":60716,"_3518":61420},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_4070":1538,"_34195":1264,"_23354":61422,"_5":16137,"_30763":60716,"_3518":61423},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_4070":1539,"_34195":1264,"_23354":61425,"_5":16137,"_30763":60716,"_3518":61426},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_4070":1540,"_34195":1264,"_23354":61428,"_5":16137,"_30763":60716,"_3518":61429},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_4070":1541,"_34195":1264,"_23354":61431,"_5":16137,"_30763":60716,"_3518":61432},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_4070":1542,"_34195":1264,"_23354":61434,"_5":16137,"_30763":60716,"_3518":61435},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_4070":1543,"_34195":1264,"_23354":61437,"_5":16137,"_30763":60716,"_3518":61438},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_4070":1544,"_34195":1264,"_23354":61440,"_5":16137,"_30763":60716,"_3518":61441},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_4070":1545,"_34195":1264,"_23354":61443,"_5":16137,"_30763":60716,"_3518":61444},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_4070":1546,"_34195":1546,"_5":16540,"_3518":59151,"_34626":61446,"_23354":61447,"_30763":1546},[56672,58140,59151],[],{"_4070":1547,"_34195":1546,"_23354":61449,"_5":16137,"_30763":1546,"_3518":61450},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_4070":1548,"_34195":1546,"_5":34623,"_23354":61452,"_30763":61453,"_3518":61454},[],"/docs/pr-preview/pr-58/platform/iot-fleets/overview#start-here","Start here",{"_4070":1549,"_34195":1546,"_5":34623,"_23354":61456,"_30763":61457,"_3518":59149},[],"/docs/pr-preview/pr-58/platform/iot-fleets/overview#devices-and-identities",{"_4070":1550,"_34195":1546,"_5":34623,"_23354":61459,"_30763":61460,"_3518":59332},[],"/docs/pr-preview/pr-58/platform/iot-fleets/overview#enrollment-with-pki",{"_4070":1551,"_34195":1546,"_5":34623,"_23354":61462,"_30763":61463,"_3518":60613},[],"/docs/pr-preview/pr-58/platform/iot-fleets/overview#integrations",{"_4070":1552,"_34195":1546,"_5":34623,"_23354":61465,"_30763":61466,"_3518":61467},[],"/docs/pr-preview/pr-58/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_4070":1553,"_34195":1546,"_23354":61469,"_5":16137,"_30763":1546,"_3518":61470},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_4070":1554,"_34195":1546,"_23354":61472,"_5":16137,"_30763":61453,"_3518":61473},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_4070":1555,"_34195":1546,"_23354":61475,"_5":16137,"_30763":61453,"_3518":61476},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_4070":1556,"_34195":1546,"_23354":61478,"_5":16137,"_30763":61457,"_3518":61479},[],"Resource",{"_4070":1557,"_34195":1546,"_23354":61481,"_5":16137,"_30763":61457,"_3518":61482},[],"What it represents",{"_4070":1558,"_34195":1546,"_23354":61484,"_5":16137,"_30763":61457,"_3518":61485},[],"**Device**",{"_4070":1559,"_34195":1546,"_23354":61487,"_5":16137,"_30763":61457,"_3518":61488},[],"An inventory entry with an identifier, owning DMS and classification.",{"_4070":1560,"_34195":1546,"_23354":61490,"_5":16137,"_30763":61457,"_3518":61491},[],"**Identity**",{"_4070":1561,"_34195":1546,"_23354":61493,"_5":16137,"_30763":61457,"_3518":61494},[],"The device's association with its certificates: an active version and a history.",{"_4070":1562,"_34195":1546,"_23354":61496,"_5":16137,"_30763":61457,"_3518":61497},[],"**DMS**",{"_4070":1563,"_34195":1546,"_23354":61499,"_5":16137,"_30763":61457,"_3518":61500},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_4070":1564,"_34195":1546,"_23354":61502,"_5":16137,"_30763":61457,"_3518":61503},[],"**Fleet**",{"_4070":1565,"_34195":1546,"_23354":61505,"_5":16137,"_30763":61457,"_3518":61506},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_4070":1566,"_34195":1546,"_23354":61508,"_5":16137,"_30763":61457,"_3518":61509},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_4070":1567,"_34195":1546,"_23354":61511,"_5":16137,"_30763":61457,"_3518":61512},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_4070":1568,"_34195":1546,"_23354":61514,"_5":16137,"_30763":61460,"_3518":61515},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_4070":1569,"_34195":1546,"_23354":61517,"_5":16137,"_30763":61460,"_3518":61518},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_4070":1570,"_34195":1546,"_23354":61520,"_5":16137,"_30763":61460,"_3518":61521},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_4070":1571,"_34195":1546,"_23354":61523,"_5":16137,"_30763":61460,"_3518":61524},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_4070":1572,"_34195":1546,"_23354":61526,"_5":16137,"_30763":61460,"_3518":61527},[],"**Result:** request the certificate, install it and check its association with the device.",{"_4070":1573,"_34195":1546,"_23354":61529,"_5":16137,"_30763":61460,"_3518":61530},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_4070":1574,"_34195":1546,"_23354":61532,"_5":16137,"_30763":61460,"_3518":61533},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_4070":1575,"_34195":1546,"_23354":61535,"_5":16137,"_30763":61460,"_3518":61536},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_4070":1576,"_34195":1546,"_23354":61538,"_5":16137,"_30763":61463,"_3518":61539},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_4070":1577,"_34195":1546,"_23354":61541,"_5":16137,"_30763":61463,"_3518":61542},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_4070":1578,"_34195":1546,"_23354":61544,"_5":16137,"_30763":61466,"_3518":61545},[],"Participant",{"_4070":1579,"_34195":1546,"_23354":61547,"_5":16137,"_30763":61466,"_3518":61548},[],"Responsibility",{"_4070":1580,"_34195":1546,"_23354":61550,"_5":16137,"_30763":61466,"_3518":61551},[],"PKI administrator",{"_4070":1581,"_34195":1546,"_23354":61553,"_5":16137,"_30763":61466,"_3518":61554},[],"CA, issuance profile, chain and revocation publication.",{"_4070":1582,"_34195":1546,"_23354":61556,"_5":16137,"_30763":61466,"_3518":61557},[],"Provisioning administrator",{"_4070":1583,"_34195":1546,"_23354":61559,"_5":16137,"_30763":61466,"_3518":61560},[],"DMS, admission, authentication per operation and inventory.",{"_4070":1584,"_34195":1546,"_23354":61562,"_5":16137,"_30763":61466,"_3518":61563},[],"Device integrator",{"_4070":1585,"_34195":1546,"_23354":61565,"_5":16137,"_30763":61466,"_3518":61566},[],"Initial credential, key, EST client, trust and certificate installation.",{"_4070":1586,"_34195":1546,"_23354":61568,"_5":16137,"_30763":61466,"_3518":61569},[],"Consumer integrator",{"_4070":1587,"_34195":1546,"_23354":61571,"_5":16137,"_30763":61466,"_3518":61572},[],"Trusted issuers, validation and device permissions in the destination.",{"_4070":1588,"_34195":1546,"_23354":61574,"_5":16137,"_30763":61466,"_3518":61575},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_4070":1589,"_34195":1589,"_5":16540,"_3518":61577,"_34626":61578,"_23354":61580,"_30763":1589},"Enroll and connect your first device",[56672,58140,59151,61579],"Getting started",[],{"_4070":1590,"_34195":1589,"_23354":61582,"_5":16137,"_30763":1589,"_3518":61583},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_4070":1591,"_34195":1589,"_5":34623,"_23354":61585,"_30763":61586,"_3518":56682},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_4070":1592,"_34195":1589,"_5":34623,"_23354":61588,"_30763":61589,"_3518":61590},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_4070":1593,"_34195":1589,"_5":34623,"_23354":61592,"_30763":61593,"_3518":61594},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_4070":1594,"_34195":1589,"_5":34623,"_23354":61596,"_30763":61597,"_3518":61598},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_4070":1595,"_34195":1589,"_5":34623,"_23354":61600,"_30763":61601,"_3518":61602},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_4070":1596,"_34195":1589,"_5":34623,"_23354":61604,"_30763":61605,"_3518":61606},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_4070":1597,"_34195":1589,"_5":34623,"_23354":61608,"_30763":61609,"_3518":61610},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_4070":1598,"_34195":1589,"_5":34623,"_23354":61612,"_30763":61613,"_3518":61614},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_4070":1599,"_34195":1589,"_23354":61616,"_5":16137,"_30763":1589,"_3518":61617},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_4070":1600,"_34195":1589,"_23354":61619,"_5":16137,"_30763":61586,"_3518":61620},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_4070":1601,"_34195":1589,"_23354":61622,"_5":16137,"_30763":61586,"_3518":61623},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_4070":1602,"_34195":1589,"_23354":61625,"_5":16137,"_30763":61586,"_3518":61626},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_4070":1603,"_34195":1589,"_23354":61628,"_5":16137,"_30763":61586,"_3518":61629},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_4070":1604,"_34195":1589,"_23354":61631,"_5":16137,"_30763":61586,"_3518":61632},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_4070":1605,"_34195":1589,"_23354":61634,"_5":16137,"_30763":61589,"_3518":61635},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_4070":1606,"_34195":1589,"_23354":61637,"_5":16137,"_30763":61589,"_3518":61638},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_4070":1607,"_34195":1589,"_23354":61640,"_5":16137,"_30763":61593,"_3518":61641},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_4070":1608,"_34195":1589,"_23354":61643,"_5":16137,"_30763":61593,"_3518":61644},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_4070":1609,"_34195":1589,"_23354":61646,"_5":16137,"_30763":61593,"_3518":61647},[],"Setting",{"_4070":1610,"_34195":1589,"_23354":61649,"_5":16137,"_30763":61593,"_3518":61650},[],"Evaluation value",{"_4070":1611,"_34195":1589,"_23354":61652,"_5":16137,"_30763":61593,"_3518":61653},[],"Enrollment CA",{"_4070":1612,"_34195":1589,"_23354":61655,"_5":16137,"_30763":61593,"_3518":61656},[],"Issuing root from `device-root.pem`.",{"_4070":1613,"_34195":1589,"_23354":61658,"_5":16137,"_30763":61593,"_3518":59462},[],{"_4070":1614,"_34195":1589,"_23354":61660,"_5":16137,"_30763":61593,"_3518":61661},[],"The 1-hour leaf profile you just prepared.",{"_4070":1615,"_34195":1589,"_23354":61663,"_5":16137,"_30763":61593,"_3518":61664},[],"Protocol / Registration Mode",{"_4070":1616,"_34195":1589,"_23354":61666,"_5":16137,"_30763":61593,"_3518":61667},[],"`EST_RFC7030` / `JITP`.",{"_4070":1617,"_34195":1589,"_23354":61669,"_5":16137,"_30763":61593,"_3518":61670},[],"Verify CSR Signature",{"_4070":1618,"_34195":1589,"_23354":61672,"_5":16137,"_30763":61593,"_3518":61673},[],"Enabled.",{"_4070":1619,"_34195":1589,"_23354":61675,"_5":16137,"_30763":61593,"_3518":61676},[],"Enable Replaceable Enrollment",{"_4070":1620,"_34195":1589,"_23354":61678,"_5":16137,"_30763":61593,"_3518":61679},[],"Disabled; the ID must be new.",{"_4070":1621,"_34195":1589,"_23354":61681,"_5":16137,"_30763":61593,"_3518":61682},[],"Initial authentication",{"_4070":1622,"_34195":1589,"_23354":61684,"_5":16137,"_30763":61593,"_3518":61685},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_4070":1623,"_34195":1589,"_23354":61687,"_5":16137,"_30763":61593,"_3518":61688},[],"Renewal authentication",{"_4070":1624,"_34195":1589,"_23354":61690,"_5":16137,"_30763":61593,"_3518":61691},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_4070":1625,"_34195":1589,"_23354":61693,"_5":16137,"_30763":61593,"_3518":61694},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_4070":1626,"_34195":1589,"_23354":61696,"_5":16137,"_30763":61593,"_3518":61697},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_4070":1627,"_34195":1589,"_23354":61699,"_5":16137,"_30763":61593,"_3518":61700},[],"Re-enrollment Delta",{"_4070":1628,"_34195":1589,"_23354":61702,"_5":16137,"_30763":61593,"_3518":61703},[],"1 hour.",{"_4070":1629,"_34195":1589,"_23354":61705,"_5":16137,"_30763":61593,"_3518":61706},[],"Preventive / Critical Delta",{"_4070":1630,"_34195":1589,"_23354":61708,"_5":16137,"_30763":61593,"_3518":61709},[],"30 minutes / 10 minutes.",{"_4070":1631,"_34195":1589,"_23354":61711,"_5":16137,"_30763":61593,"_3518":61712},[],"Revoke on Re-enrollment",{"_4070":1632,"_34195":1589,"_23354":61714,"_5":16137,"_30763":61593,"_3518":61715},[],"Disabled to test the successor before retiring the previous identity.",{"_4070":1633,"_34195":1589,"_23354":61717,"_5":16137,"_30763":61593,"_3518":59470},[],{"_4070":1634,"_34195":1589,"_23354":61719,"_5":16137,"_30763":61593,"_3518":61720},[],"Disabled; the operational key is generated in the client.",{"_4070":1635,"_34195":1589,"_23354":61722,"_5":16137,"_30763":61593,"_3518":61723},[],"CA Distribution",{"_4070":1636,"_34195":1589,"_23354":61725,"_5":16137,"_30763":61593,"_3518":61726},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_4070":1637,"_34195":1589,"_23354":61728,"_5":16137,"_30763":61593,"_3518":61729},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_4070":1638,"_34195":1589,"_23354":61731,"_5":16137,"_30763":61597,"_3518":61732},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_4070":1639,"_34195":1589,"_23354":61734,"_5":16137,"_30763":61597,"_3518":61735},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_4070":1640,"_34195":1589,"_23354":61737,"_5":16137,"_30763":61601,"_3518":61738},[],"Generate a new key and CSR with the selected identifier:",{"_4070":1641,"_34195":1589,"_23354":61740,"_5":16137,"_30763":61601,"_3518":61741},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_4070":1642,"_34195":1589,"_23354":61743,"_5":16137,"_30763":61601,"_3518":61744},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_4070":1643,"_34195":1589,"_23354":61746,"_5":16137,"_30763":61605,"_3518":61747},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_4070":1644,"_34195":1589,"_23354":61749,"_5":16137,"_30763":61605,"_3518":61750},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_4070":1645,"_34195":1589,"_23354":61752,"_5":16137,"_30763":61609,"_3518":61753},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_4070":1646,"_34195":1589,"_23354":61755,"_5":16137,"_30763":61609,"_3518":61756},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_4070":1647,"_34195":1589,"_23354":61758,"_5":16137,"_30763":61609,"_3518":61759},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_4070":1648,"_34195":1589,"_23354":61761,"_5":16137,"_30763":61609,"_3518":61762},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_4070":1649,"_34195":1589,"_23354":61764,"_5":16137,"_30763":61609,"_3518":61765},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_4070":1650,"_34195":1589,"_23354":61767,"_5":16137,"_30763":61613,"_3518":61768},[],"Check",{"_4070":1651,"_34195":1589,"_23354":61770,"_5":16137,"_30763":61613,"_3518":61771},[],"Expected result",{"_4070":1652,"_34195":1589,"_23354":61773,"_5":16137,"_30763":61613,"_3518":61774},[],"Registration",{"_4070":1653,"_34195":1589,"_23354":61776,"_5":16137,"_30763":61613,"_3518":61777},[],"ID created automatically and correct DMS.",{"_4070":1654,"_34195":1589,"_23354":61779,"_5":16137,"_30763":61613,"_3518":61035},[],{"_4070":1655,"_34195":1589,"_23354":61781,"_5":16137,"_30763":61613,"_3518":61782},[],"CN, profile, serial and key verified.",{"_4070":1656,"_34195":1589,"_23354":61784,"_5":16137,"_30763":61613,"_3518":61785},[],"Inventory",{"_4070":1657,"_34195":1589,"_23354":61787,"_5":16137,"_30763":61613,"_3518":61788},[],"Received serial visible as the current identity and in history.",{"_4070":1658,"_34195":1589,"_23354":61790,"_5":16137,"_30763":61613,"_3518":61791},[],"Consumer",{"_4070":1659,"_34195":1589,"_23354":61793,"_5":16137,"_30763":61613,"_3518":61794},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_4070":1660,"_34195":1589,"_23354":61796,"_5":16137,"_30763":61613,"_3518":61797},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_4070":1661,"_34195":1589,"_23354":61799,"_5":16137,"_30763":61613,"_3518":61800},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_4070":1662,"_34195":1662,"_5":16540,"_3518":59167,"_34626":61802,"_23354":61803,"_30763":1662},[56672,58140,59151,61579],[],{"_4070":1663,"_34195":1662,"_23354":61805,"_5":16137,"_30763":1662,"_3518":61806},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_4070":1664,"_34195":1662,"_5":34623,"_23354":61808,"_30763":61809,"_3518":56682},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_4070":1665,"_34195":1662,"_5":34623,"_23354":61811,"_30763":61812,"_3518":61813},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_4070":1666,"_34195":1662,"_5":34623,"_23354":61815,"_30763":61816,"_3518":61817},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_4070":1667,"_34195":1662,"_5":34623,"_23354":61819,"_30763":61820,"_3518":61821},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_4070":1668,"_34195":1662,"_5":34623,"_23354":61823,"_30763":61824,"_3518":61825},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_4070":1669,"_34195":1662,"_5":34623,"_23354":61827,"_30763":61828,"_3518":61829},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_4070":1670,"_34195":1662,"_5":34623,"_23354":61831,"_30763":61832,"_3518":61771},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#expected-result",{"_4070":1671,"_34195":1662,"_5":34623,"_23354":61834,"_30763":61835,"_3518":61836},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_4070":1672,"_34195":1662,"_5":34623,"_23354":61838,"_30763":61839,"_3518":61840},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_4070":1673,"_34195":1662,"_23354":61842,"_5":16137,"_30763":1662,"_3518":61843},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_4070":1674,"_34195":1662,"_23354":61845,"_5":16137,"_30763":1662,"_3518":61846},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_4070":1675,"_34195":1662,"_23354":61848,"_5":16137,"_30763":61809,"_3518":61849},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_4070":1676,"_34195":1662,"_23354":61851,"_5":16137,"_30763":61809,"_3518":61852},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_4070":1677,"_34195":1662,"_23354":61854,"_5":16137,"_30763":61809,"_3518":61855},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_4070":1678,"_34195":1662,"_23354":61857,"_5":16137,"_30763":61809,"_3518":61858},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_4070":1679,"_34195":1662,"_23354":61860,"_5":16137,"_30763":61812,"_3518":61861},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_4070":1680,"_34195":1662,"_23354":61863,"_5":16137,"_30763":61812,"_3518":61864},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_4070":1681,"_34195":1662,"_23354":61866,"_5":16137,"_30763":61812,"_3518":61867},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_4070":1682,"_34195":1662,"_23354":61869,"_5":16137,"_30763":61812,"_3518":61870},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_4070":1683,"_34195":1662,"_23354":61872,"_5":16137,"_30763":61812,"_3518":61873},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_4070":1684,"_34195":1662,"_23354":61875,"_5":16137,"_30763":61812,"_3518":61876},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_4070":1685,"_34195":1662,"_23354":61878,"_5":16137,"_30763":61812,"_3518":61879},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_4070":1686,"_34195":1662,"_23354":61881,"_5":16137,"_30763":61812,"_3518":61882},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_4070":1687,"_34195":1662,"_23354":61884,"_5":16137,"_30763":61816,"_3518":61885},[],"Open **Managed Devices** and the registration action. Complete:",{"_4070":1688,"_34195":1662,"_23354":61887,"_5":16137,"_30763":61816,"_3518":61888},[],"**Device ID**: `device-001`.",{"_4070":1689,"_34195":1662,"_23354":61890,"_5":16137,"_30763":61816,"_3518":61891},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_4070":1690,"_34195":1662,"_23354":61893,"_5":16137,"_30763":61816,"_3518":61894},[],"**Icon** and **Tags**: optional classification.",{"_4070":1691,"_34195":1662,"_23354":61896,"_5":16137,"_30763":61816,"_3518":61897},[],"Confirm registration.",{"_4070":1692,"_34195":1662,"_23354":61899,"_5":16137,"_30763":61820,"_3518":61900},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_4070":1693,"_34195":1662,"_23354":61902,"_5":16137,"_30763":61820,"_3518":61903},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_4070":1694,"_34195":1662,"_23354":61905,"_5":16137,"_30763":61824,"_3518":61906},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_4070":1695,"_34195":1662,"_23354":61908,"_5":16137,"_30763":61824,"_3518":61909},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_4070":1696,"_34195":1662,"_23354":61911,"_5":16137,"_30763":61828,"_3518":61912},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_4070":1697,"_34195":1662,"_23354":61914,"_5":16137,"_30763":61828,"_3518":61915},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_4070":1698,"_34195":1662,"_23354":61917,"_5":16137,"_30763":61832,"_3518":61768},[],{"_4070":1699,"_34195":1662,"_23354":61919,"_5":16137,"_30763":61832,"_3518":61920},[],"Result",{"_4070":1700,"_34195":1662,"_23354":61922,"_5":16137,"_30763":61832,"_3518":61018},[],{"_4070":1701,"_34195":1662,"_23354":61924,"_5":16137,"_30763":61832,"_3518":61925},[],"`device-001` appears in inventory with the expected DMS.",{"_4070":1702,"_34195":1662,"_23354":61927,"_5":16137,"_30763":61832,"_3518":61928},[],"Current identity",{"_4070":1703,"_34195":1662,"_23354":61930,"_5":16137,"_30763":61832,"_3518":61931},[],"The associated certificate matches the one you verified in PKI.",{"_4070":1704,"_34195":1662,"_23354":61933,"_5":16137,"_30763":61832,"_3518":61934},[],"History",{"_4070":1705,"_34195":1662,"_23354":61936,"_5":16137,"_30763":61832,"_3518":61937},[],"The associated issuance appears with its serial number and dates.",{"_4070":1706,"_34195":1662,"_23354":61939,"_5":16137,"_30763":61832,"_3518":61940},[],"Key and certificate",{"_4070":1707,"_34195":1662,"_23354":61942,"_5":16137,"_30763":61832,"_3518":61943},[],"You have the verified pair ready to install on the device.",{"_4070":1708,"_34195":1662,"_23354":61945,"_5":16137,"_30763":61835,"_3518":61946},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_4070":1709,"_34195":1662,"_23354":61948,"_5":16137,"_30763":61835,"_3518":61949},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_4070":1710,"_34195":1662,"_23354":61951,"_5":16137,"_30763":61835,"_3518":61952},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_4070":1711,"_34195":1662,"_23354":61954,"_5":16137,"_30763":61835,"_3518":61955},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_4070":1712,"_34195":1662,"_23354":61957,"_5":16137,"_30763":61839,"_3518":61958},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_4070":1713,"_34195":1662,"_23354":61960,"_5":16137,"_30763":61839,"_3518":61961},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_4070":1714,"_34195":1662,"_23354":61963,"_5":16137,"_30763":61839,"_3518":61964},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_4070":1715,"_34195":1715,"_5":16540,"_3518":61966,"_34626":61967,"_23354":61968,"_30763":1715},"Lamassu IoT Platform",[56672,58140],[],{"_4070":1716,"_34195":1715,"_23354":61970,"_5":16137,"_30763":1715,"_3518":61971},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_4070":1717,"_34195":1715,"_5":34623,"_23354":61973,"_30763":61974,"_3518":61454},[],"/docs/pr-preview/pr-58/platform/overview#start-here",{"_4070":1718,"_34195":1715,"_5":34623,"_23354":61976,"_30763":61977,"_3518":61978},[],"/docs/pr-preview/pr-58/platform/overview#choose-your-path","Choose your path",{"_4070":1719,"_34195":1715,"_5":34623,"_23354":61980,"_30763":61981,"_3518":61982},[],"/docs/pr-preview/pr-58/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_4070":1720,"_34195":1715,"_5":34623,"_23354":61984,"_30763":61985,"_3518":61986},[],"/docs/pr-preview/pr-58/platform/overview#core-capabilities","Core capabilities",{"_4070":1721,"_34195":1715,"_5":34623,"_23354":61988,"_30763":61989,"_3518":61990},[],"/docs/pr-preview/pr-58/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_4070":1722,"_34195":1715,"_5":34623,"_23354":61992,"_30763":61993,"_3518":61994},[],"/docs/pr-preview/pr-58/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_4070":1723,"_34195":1715,"_5":34623,"_23354":61996,"_30763":61997,"_3518":61998},[],"/docs/pr-preview/pr-58/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_4070":1724,"_34195":1715,"_5":34623,"_23354":62000,"_30763":62001,"_3518":62002},[],"/docs/pr-preview/pr-58/platform/overview#automate-device-identities","Automate device identities",{"_4070":1725,"_34195":1715,"_5":34623,"_23354":62004,"_30763":62005,"_3518":62006},[],"/docs/pr-preview/pr-58/platform/overview#publish-validation-status","Publish validation status",{"_4070":1726,"_34195":1715,"_5":34623,"_23354":62008,"_30763":62009,"_3518":62010},[],"/docs/pr-preview/pr-58/platform/overview#react-to-events","React to events",{"_4070":1727,"_34195":1715,"_5":34623,"_23354":62012,"_30763":62013,"_3518":62014},[],"/docs/pr-preview/pr-58/platform/overview#operational-reference","Operational reference",{"_4070":1728,"_34195":1715,"_23354":62016,"_5":16137,"_30763":1715,"_3518":62017},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_4070":1729,"_34195":1715,"_23354":62019,"_5":16137,"_30763":61974,"_3518":62020},[],"Choose the result you need:",{"_4070":1730,"_34195":1715,"_23354":62022,"_5":16137,"_30763":61974,"_3518":62023},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_4070":1731,"_34195":1715,"_23354":62025,"_5":16137,"_30763":61974,"_3518":62026},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_4070":1732,"_34195":1715,"_23354":62028,"_5":16137,"_30763":61974,"_3518":62029},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_4070":1733,"_34195":1715,"_23354":62031,"_5":16137,"_30763":61977,"_3518":62032},[],"Section",{"_4070":1734,"_34195":1715,"_23354":62034,"_5":16137,"_30763":61977,"_3518":62035},[],"What you manage",{"_4070":1735,"_34195":1715,"_23354":62037,"_5":16137,"_30763":61977,"_3518":62038},[],"Entry point",{"_4070":1736,"_34195":1715,"_23354":62040,"_5":16137,"_30763":61977,"_3518":62041},[],"**PKI**",{"_4070":1737,"_34195":1715,"_23354":62043,"_5":16137,"_30763":61977,"_3518":62044},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_4070":1738,"_34195":1715,"_23354":62046,"_5":16137,"_30763":61977,"_3518":62047},[],"PKI overview",{"_4070":1739,"_34195":1715,"_23354":62049,"_5":16137,"_30763":61977,"_3518":62050},[],"**IoT Fleets**",{"_4070":1740,"_34195":1715,"_23354":62052,"_5":16137,"_30763":61977,"_3518":62053},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_4070":1741,"_34195":1715,"_23354":62055,"_5":16137,"_30763":61977,"_3518":62056},[],"IoT Fleets overview",{"_4070":1742,"_34195":1715,"_23354":62058,"_5":16137,"_30763":61977,"_3518":62059},[],"**Administration**",{"_4070":1743,"_34195":1715,"_23354":62061,"_5":16137,"_30763":61977,"_3518":62062},[],"Operator permissions, audit and event subscriptions.",{"_4070":1744,"_34195":1715,"_23354":62064,"_5":16137,"_30763":61977,"_3518":58138},[],{"_4070":1745,"_34195":1715,"_23354":62066,"_5":16137,"_30763":61977,"_3518":62067},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_4070":1746,"_34195":1715,"_23354":62069,"_5":16137,"_30763":61981,"_3518":62070},[],"An identity's journey connects four responsibilities:",{"_4070":1747,"_34195":1715,"_23354":62072,"_5":16137,"_30763":61981,"_3518":62073},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_4070":1748,"_34195":1715,"_23354":62075,"_5":16137,"_30763":61981,"_3518":62076},[],"The provisioning administrator configures the DMS and initial trust.",{"_4070":1749,"_34195":1715,"_23354":62078,"_5":16137,"_30763":61981,"_3518":62079},[],"The device client requests a certificate and installs it with the matching key.",{"_4070":1750,"_34195":1715,"_23354":62081,"_5":16137,"_30763":61981,"_3518":62082},[],"The consumer validates the identity and applies its access permissions.",{"_4070":1751,"_34195":1715,"_23354":62084,"_5":16137,"_30763":61981,"_3518":62085},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_4070":1752,"_34195":1715,"_23354":62087,"_5":16137,"_30763":61989,"_3518":62088},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_4070":1753,"_34195":1715,"_23354":62090,"_5":16137,"_30763":61993,"_3518":62091},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_4070":1754,"_34195":1715,"_23354":62093,"_5":16137,"_30763":61997,"_3518":62094},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_4070":1755,"_34195":1715,"_23354":62096,"_5":16137,"_30763":62001,"_3518":62097},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_4070":1756,"_34195":1715,"_23354":62099,"_5":16137,"_30763":62005,"_3518":62100},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_4070":1757,"_34195":1715,"_23354":62102,"_5":16137,"_30763":62009,"_3518":62103},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_4070":1758,"_34195":1715,"_23354":62105,"_5":16137,"_30763":62013,"_3518":61548},[],{"_4070":1759,"_34195":1715,"_23354":62107,"_5":16137,"_30763":62013,"_3518":62108},[],"What it prepares or checks",{"_4070":1760,"_34195":1715,"_23354":62110,"_5":16137,"_30763":62013,"_3518":61551},[],{"_4070":1761,"_34195":1715,"_23354":62112,"_5":16137,"_30763":62013,"_3518":62113},[],"Key custody, CA hierarchy, profiles and validation.",{"_4070":1762,"_34195":1715,"_23354":62115,"_5":16137,"_30763":62013,"_3518":62116},[],"Fleet administrator",{"_4070":1763,"_34195":1715,"_23354":62118,"_5":16137,"_30763":62013,"_3518":62119},[],"DMS, device admission, renewal policy and inventory.",{"_4070":1764,"_34195":1715,"_23354":62121,"_5":16137,"_30763":62013,"_3518":61563},[],{"_4070":1765,"_34195":1715,"_23354":62123,"_5":16137,"_30763":62013,"_3518":62124},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_4070":1766,"_34195":1715,"_23354":62126,"_5":16137,"_30763":62013,"_3518":61569},[],{"_4070":1767,"_34195":1715,"_23354":62128,"_5":16137,"_30763":62013,"_3518":62129},[],"Issuer trust, certificate validation and permissions in the destination.",{"_4070":1768,"_34195":1715,"_23354":62131,"_5":16137,"_30763":62013,"_3518":62132},[],"Infrastructure operator",{"_4070":1769,"_34195":1715,"_23354":62134,"_5":16137,"_30763":62013,"_3518":62135},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_4070":1770,"_34195":1715,"_23354":62137,"_5":16137,"_30763":62013,"_3518":62138},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_4070":1771,"_34195":1771,"_5":16540,"_3518":62140,"_34626":62141,"_23354":62144,"_30763":1771},"CA hierarchy and rotation",[56672,58140,62142,62143],"PKI","Keys, authorities and certificates",[],{"_4070":1772,"_34195":1771,"_23354":62146,"_5":16137,"_30763":1771,"_3518":62147},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_4070":1773,"_34195":1771,"_5":34623,"_23354":62149,"_30763":62150,"_3518":62151},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_4070":1774,"_34195":1771,"_5":34623,"_23354":62153,"_30763":62154,"_3518":62155},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_4070":1775,"_34195":1771,"_5":34623,"_23354":62157,"_30763":62158,"_3518":62159},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_4070":1776,"_34195":1771,"_5":34623,"_23354":62161,"_30763":62162,"_3518":62163},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_4070":1777,"_34195":1771,"_5":34623,"_23354":62165,"_30763":62166,"_3518":62167},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_4070":1778,"_34195":1771,"_5":34623,"_23354":62169,"_30763":62170,"_3518":62171},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_4070":1779,"_34195":1771,"_5":34623,"_23354":62173,"_30763":62174,"_3518":62175},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_4070":1780,"_34195":1771,"_5":34623,"_23354":62177,"_30763":62178,"_3518":62179},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_4070":1781,"_34195":1771,"_5":34623,"_23354":62181,"_30763":62182,"_3518":62183},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_4070":1782,"_34195":1771,"_5":34623,"_23354":62185,"_30763":62186,"_3518":62187},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_4070":1783,"_34195":1771,"_5":34623,"_23354":62189,"_30763":62190,"_3518":62191},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_4070":1784,"_34195":1771,"_5":34623,"_23354":62193,"_30763":62194,"_3518":62195},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_4070":1785,"_34195":1771,"_23354":62197,"_5":16137,"_30763":1771,"_3518":62198},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_4070":1786,"_34195":1771,"_23354":62200,"_5":16137,"_30763":1771,"_3518":62201},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_4070":1787,"_34195":1771,"_23354":62203,"_5":16137,"_30763":62150,"_3518":62204},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_4070":1788,"_34195":1771,"_23354":62206,"_5":16137,"_30763":62150,"_3518":62207},[],"environment, such as production and preproduction;",{"_4070":1789,"_34195":1771,"_23354":62209,"_5":16137,"_30763":62150,"_3518":62210},[],"owner or operating team;",{"_4070":1790,"_34195":1771,"_23354":62212,"_5":16137,"_30763":62150,"_3518":62213},[],"device family or manufacturing process;",{"_4070":1791,"_34195":1771,"_23354":62215,"_5":16137,"_30763":62150,"_3518":62216},[],"region or regulatory requirement;",{"_4070":1792,"_34195":1771,"_23354":62218,"_5":16137,"_30763":62150,"_3518":62219},[],"cryptographic engine or key policy;",{"_4070":1793,"_34195":1771,"_23354":62221,"_5":16137,"_30763":62150,"_3518":62222},[],"maintenance window and renewal cadence.",{"_4070":1794,"_34195":1771,"_23354":62224,"_5":16137,"_30763":62150,"_3518":62225},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_4070":1795,"_34195":1771,"_23354":62227,"_5":16137,"_30763":62150,"_3518":62228},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_4070":1796,"_34195":1771,"_23354":62230,"_5":16137,"_30763":62154,"_3518":62231},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_4070":1797,"_34195":1771,"_23354":62233,"_5":16137,"_30763":62154,"_3518":62234},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_4070":1798,"_34195":1771,"_23354":62236,"_5":16137,"_30763":62154,"_3518":62237},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_4070":1799,"_34195":1771,"_23354":62239,"_5":16137,"_30763":62158,"_3518":62240},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_4070":1800,"_34195":1771,"_23354":62242,"_5":16137,"_30763":62158,"_3518":62243},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_4070":1801,"_34195":1771,"_23354":62245,"_5":16137,"_30763":62158,"_3518":62246},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_4070":1802,"_34195":1771,"_23354":62248,"_5":16137,"_30763":62158,"_3518":62249},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_4070":1803,"_34195":1771,"_23354":62251,"_5":16137,"_30763":62166,"_3518":62252},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_4070":1804,"_34195":1771,"_23354":62254,"_5":16137,"_30763":62170,"_3518":62255},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_4070":1805,"_34195":1771,"_23354":62257,"_5":16137,"_30763":62174,"_3518":62258},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_4070":1806,"_34195":1771,"_23354":62260,"_5":16137,"_30763":62178,"_3518":62261},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_4070":1807,"_34195":1771,"_23354":62263,"_5":16137,"_30763":62182,"_3518":62264},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_4070":1808,"_34195":1771,"_23354":62266,"_5":16137,"_30763":62186,"_3518":62267},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_4070":1809,"_34195":1771,"_23354":62269,"_5":16137,"_30763":62190,"_3518":62270},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_4070":1810,"_34195":1771,"_23354":62272,"_5":16137,"_30763":62190,"_3518":62273},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_4070":1811,"_34195":1771,"_23354":62275,"_5":16137,"_30763":62190,"_3518":62276},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_4070":1812,"_34195":1771,"_23354":62278,"_5":16137,"_30763":62190,"_3518":62279},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_4070":1813,"_34195":1771,"_23354":62281,"_5":16137,"_30763":62194,"_3518":62282},[],"The new chain ends in an anchor installed by the consumer.",{"_4070":1814,"_34195":1771,"_23354":62284,"_5":16137,"_30763":62194,"_3518":62285},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_4070":1815,"_34195":1771,"_23354":62287,"_5":16137,"_30763":62194,"_3518":62288},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_4070":1816,"_34195":1771,"_23354":62290,"_5":16137,"_30763":62194,"_3518":62291},[],"Re-enrollment accepts the old identity during the planned period.",{"_4070":1817,"_34195":1771,"_23354":62293,"_5":16137,"_30763":62194,"_3518":62294},[],"OCSP and CRL respond for the authorities that remain active.",{"_4070":1818,"_34195":1771,"_23354":62296,"_5":16137,"_30763":62194,"_3518":62297},[],"No DMS is left accidentally issuing from the old CA.",{"_4070":1819,"_34195":1771,"_23354":62299,"_5":16137,"_30763":62194,"_3518":62300},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_4070":1820,"_34195":1820,"_5":16540,"_3518":62302,"_34626":62303,"_23354":62304,"_30763":1820},"Certification authorities",[56672,58140,62142,62143],[],{"_4070":1821,"_34195":1820,"_23354":62306,"_5":16137,"_30763":1820,"_3518":62307},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_4070":1822,"_34195":1820,"_5":34623,"_23354":62309,"_30763":62310,"_3518":62311},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_4070":1823,"_34195":1820,"_5":34623,"_23354":62313,"_30763":62314,"_3518":62315},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_4070":1824,"_34195":1820,"_5":34623,"_23354":62317,"_30763":62318,"_3518":56682},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#before-you-begin",{"_4070":1825,"_34195":1820,"_5":34623,"_23354":62320,"_30763":62321,"_3518":62322},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_4070":1826,"_34195":1820,"_5":34623,"_23354":62324,"_30763":62325,"_3518":62326},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_4070":1827,"_34195":1820,"_5":34623,"_23354":62328,"_30763":62329,"_3518":62330},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_4070":1828,"_34195":1820,"_5":34623,"_23354":62332,"_30763":62333,"_3518":62334},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_4070":1829,"_34195":1820,"_5":34623,"_23354":62336,"_30763":62337,"_3518":62338},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_4070":1830,"_34195":1820,"_5":34623,"_23354":62340,"_30763":62341,"_3518":62342},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_4070":1831,"_34195":1820,"_5":34623,"_23354":62344,"_30763":62345,"_3518":62346},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_4070":1832,"_34195":1820,"_5":34623,"_23354":62348,"_30763":62349,"_3518":62350},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_4070":1833,"_34195":1820,"_5":34623,"_23354":62352,"_30763":62353,"_3518":62354},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_4070":1834,"_34195":1820,"_5":34623,"_23354":62356,"_30763":62357,"_3518":62358},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#load-the-material","Load the material",{"_4070":1835,"_34195":1820,"_5":34623,"_23354":62360,"_30763":62361,"_3518":62362},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_4070":1836,"_34195":1820,"_5":34623,"_23354":62364,"_30763":62365,"_3518":62366},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_4070":1837,"_34195":1820,"_5":34623,"_23354":62368,"_30763":62369,"_3518":62370},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_4070":1838,"_34195":1820,"_5":34623,"_23354":62372,"_30763":62373,"_3518":62374},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_4070":1839,"_34195":1820,"_5":34623,"_23354":62376,"_30763":62377,"_3518":62378},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_4070":1840,"_34195":1820,"_5":34623,"_23354":62380,"_30763":62381,"_3518":62382},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_4070":1841,"_34195":1820,"_5":34623,"_23354":62384,"_30763":62385,"_3518":62386},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_4070":1842,"_34195":1820,"_5":34623,"_23354":62388,"_30763":62389,"_3518":62390},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_4070":1843,"_34195":1820,"_5":34623,"_23354":62392,"_30763":62393,"_3518":62394},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_4070":1844,"_34195":1820,"_5":34623,"_23354":62396,"_30763":62397,"_3518":62398},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_4070":1845,"_34195":1820,"_23354":62400,"_5":16137,"_30763":1820,"_3518":62401},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_4070":1846,"_34195":1820,"_23354":62403,"_5":16137,"_30763":1820,"_3518":62404},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_4070":1847,"_34195":1820,"_23354":62406,"_5":16137,"_30763":1820,"_3518":62407},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_4070":1848,"_34195":1820,"_23354":62409,"_5":16137,"_30763":62310,"_3518":62410},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_4070":1849,"_34195":1820,"_23354":62412,"_5":16137,"_30763":62310,"_3518":62413},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_4070":1850,"_34195":1820,"_23354":62415,"_5":16137,"_30763":62310,"_3518":62416},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_4070":1851,"_34195":1820,"_23354":62418,"_5":16137,"_30763":62310,"_3518":62419},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_4070":1852,"_34195":1820,"_23354":62421,"_5":16137,"_30763":62310,"_3518":62422},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_4070":1853,"_34195":1820,"_23354":62424,"_5":16137,"_30763":62318,"_3518":62425},[],"Decide whether the CA will be a root or an intermediate.",{"_4070":1854,"_34195":1820,"_23354":62427,"_5":16137,"_30763":62318,"_3518":62428},[],"Choose the engine that will keep the key.",{"_4070":1855,"_34195":1820,"_23354":62430,"_5":16137,"_30763":62318,"_3518":62431},[],"Define a validity longer than that of the certificates it will issue.",{"_4070":1856,"_34195":1820,"_23354":62433,"_5":16137,"_30763":62318,"_3518":62434},[],"For an intermediate CA, make sure the parent CA is active.",{"_4070":1857,"_34195":1820,"_23354":62436,"_5":16137,"_30763":62321,"_3518":62437},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_4070":1858,"_34195":1820,"_23354":62439,"_5":16137,"_30763":62325,"_3518":62440},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_4070":1859,"_34195":1820,"_23354":62442,"_5":16137,"_30763":62325,"_3518":62443},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_4070":1860,"_34195":1820,"_23354":62445,"_5":16137,"_30763":62329,"_3518":62446},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_4070":1861,"_34195":1820,"_23354":62448,"_5":16137,"_30763":62333,"_3518":62449},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_4070":1862,"_34195":1820,"_23354":62451,"_5":16137,"_30763":62333,"_3518":62452},[],"`C`: two-letter ISO 3166-1 country code.",{"_4070":1863,"_34195":1820,"_23354":62454,"_5":16137,"_30763":62333,"_3518":62455},[],"`ST`: state or province.",{"_4070":1864,"_34195":1820,"_23354":62457,"_5":16137,"_30763":62333,"_3518":62458},[],"`L`: locality.",{"_4070":1865,"_34195":1820,"_23354":62460,"_5":16137,"_30763":62333,"_3518":62461},[],"`O`: organization.",{"_4070":1866,"_34195":1820,"_23354":62463,"_5":16137,"_30763":62333,"_3518":62464},[],"`OU`: organizational unit.",{"_4070":1867,"_34195":1820,"_23354":62466,"_5":16137,"_30763":62333,"_3518":62467},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_4070":1868,"_34195":1820,"_23354":62469,"_5":16137,"_30763":62337,"_3518":62470},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_4070":1869,"_34195":1820,"_23354":62472,"_5":16137,"_30763":62337,"_3518":62473},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_4070":1870,"_34195":1820,"_23354":62475,"_5":16137,"_30763":62341,"_3518":62476},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_4070":1871,"_34195":1820,"_23354":62478,"_5":16137,"_30763":62341,"_3518":62479},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_4070":1872,"_34195":1820,"_23354":62481,"_5":16137,"_30763":62345,"_3518":62482},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_4070":1873,"_34195":1820,"_23354":62484,"_5":16137,"_30763":62345,"_3518":62485},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_4070":1874,"_34195":1820,"_23354":62487,"_5":16137,"_30763":62349,"_3518":62488},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_4070":1875,"_34195":1820,"_23354":62490,"_5":16137,"_30763":62349,"_3518":62491},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_4070":1876,"_34195":1820,"_23354":62493,"_5":16137,"_30763":62349,"_3518":62494},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_4070":1877,"_34195":1820,"_23354":62496,"_5":16137,"_30763":62353,"_3518":62497},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_4070":1878,"_34195":1820,"_23354":62499,"_5":16137,"_30763":62357,"_3518":62500},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_4070":1879,"_34195":1820,"_23354":62502,"_5":16137,"_30763":62361,"_3518":62503},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_4070":1880,"_34195":1820,"_23354":62505,"_5":16137,"_30763":62365,"_3518":62506},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_4070":1881,"_34195":1820,"_23354":62508,"_5":16137,"_30763":62365,"_3518":62509},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_4070":1882,"_34195":1820,"_23354":62511,"_5":16137,"_30763":62369,"_3518":62512},[],"Open a CA from the inventory to review:",{"_4070":1883,"_34195":1820,"_23354":62514,"_5":16137,"_30763":62369,"_3518":62515},[],"Status and validity period.",{"_4070":1884,"_34195":1820,"_23354":62517,"_5":16137,"_30763":62369,"_3518":62518},[],"Certificate and chain in PEM format.",{"_4070":1885,"_34195":1820,"_23354":62520,"_5":16137,"_30763":62369,"_3518":62521},[],"Number of active, expired and revoked certificates.",{"_4070":1886,"_34195":1820,"_23354":62523,"_5":16137,"_30763":62369,"_3518":62524},[],"Certificates issued in **Issued Certificates**.",{"_4070":1887,"_34195":1820,"_23354":62526,"_5":16137,"_30763":62369,"_3518":62527},[],"The CRL linked to the authority.",{"_4070":1888,"_34195":1820,"_23354":62529,"_5":16137,"_30763":62369,"_3518":62530},[],"Metadata and the associated cryptographic engine.",{"_4070":1889,"_34195":1820,"_23354":62532,"_5":16137,"_30763":62369,"_3518":62533},[],"You can filter the inventory by name, status and CA type.",{"_4070":1890,"_34195":1820,"_23354":62535,"_5":16137,"_30763":62373,"_3518":62536},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_4070":1891,"_34195":1820,"_23354":62538,"_5":16137,"_30763":62373,"_3518":62539},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_4070":1892,"_34195":1820,"_23354":62541,"_5":16137,"_30763":62373,"_3518":62542},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_4070":1893,"_34195":1820,"_23354":62544,"_5":16137,"_30763":62373,"_3518":62545},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_4070":1894,"_34195":1820,"_23354":62547,"_5":16137,"_30763":62377,"_3518":62548},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_4070":1895,"_34195":1820,"_23354":62550,"_5":16137,"_30763":62381,"_3518":62551},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_4070":1896,"_34195":1820,"_23354":62553,"_5":16137,"_30763":62385,"_3518":62554},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_4070":1897,"_34195":1820,"_23354":62556,"_5":16137,"_30763":62389,"_3518":62557},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_4070":1898,"_34195":1820,"_23354":62559,"_5":16137,"_30763":62393,"_3518":62560},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_4070":1899,"_34195":1820,"_23354":62562,"_5":16137,"_30763":62397,"_3518":62563},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_4070":1900,"_34195":1820,"_23354":62565,"_5":16137,"_30763":62397,"_3518":62566},[],"The CA’s VA role is kept. If no other CA with the same SKI remains, it can no longer be edited (see CRL), so adjust its validity and signer beforehand. The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_4070":1901,"_34195":1820,"_23354":62568,"_5":16137,"_30763":62397,"_3518":62569},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. If the new certificate uses the same key, it shares the SKI with the retained VA role of the deleted CA, whose signer is the old certificate: check that the CRL is generated and, if it is not, use `PUT` to set a signer of the new CA (see CRL).",{"_4070":1902,"_34195":1902,"_5":16540,"_3518":62571,"_34626":62572,"_23354":62573,"_30763":1902},"Certificate profiles",[56672,58140,62142,62143],[],{"_4070":1903,"_34195":1902,"_23354":62575,"_5":16137,"_30763":1902,"_3518":62576},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_4070":1904,"_34195":1902,"_5":34623,"_23354":62578,"_30763":62579,"_3518":62580},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_4070":1905,"_34195":1902,"_5":34623,"_23354":62582,"_30763":62583,"_3518":62584},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#validity","Validity",{"_4070":1906,"_34195":1902,"_5":34623,"_23354":62586,"_30763":62587,"_3518":62588},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_4070":1907,"_34195":1902,"_5":34623,"_23354":62590,"_30763":62591,"_3518":62592},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_4070":1908,"_34195":1902,"_5":34623,"_23354":62594,"_30763":62595,"_3518":62596},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#subject","Subject",{"_4070":1909,"_34195":1902,"_5":34623,"_23354":62598,"_30763":62599,"_3518":62600},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_4070":1910,"_34195":1902,"_5":34623,"_23354":62602,"_30763":62603,"_3518":62604},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_4070":1911,"_34195":1902,"_5":34623,"_23354":62606,"_30763":62607,"_3518":62608},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_4070":1912,"_34195":1902,"_5":34623,"_23354":62610,"_30763":62611,"_3518":62612},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_4070":1913,"_34195":1902,"_5":34623,"_23354":62614,"_30763":62615,"_3518":62616},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_4070":1914,"_34195":1902,"_5":34623,"_23354":62618,"_30763":62619,"_3518":62620},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_4070":1915,"_34195":1902,"_5":34623,"_23354":62622,"_30763":62623,"_3518":62624},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_4070":1916,"_34195":1902,"_5":34623,"_23354":62626,"_30763":62627,"_3518":62628},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_4070":1917,"_34195":1902,"_5":34623,"_23354":62630,"_30763":62631,"_3518":62632},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_4070":1918,"_34195":1902,"_5":34623,"_23354":62634,"_30763":62635,"_3518":62636},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#design-examples","Design examples",{"_4070":1919,"_34195":1902,"_5":34623,"_23354":62638,"_30763":62639,"_3518":62640},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_4070":1920,"_34195":1902,"_23354":62642,"_5":16137,"_30763":1902,"_3518":62643},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_4070":1921,"_34195":1902,"_23354":62645,"_5":16137,"_30763":1902,"_3518":62646},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_4070":1922,"_34195":1902,"_23354":62648,"_5":16137,"_30763":62583,"_3518":62649},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_4070":1923,"_34195":1902,"_23354":62651,"_5":16137,"_30763":62583,"_3518":62652},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_4070":1924,"_34195":1902,"_23354":62654,"_5":16137,"_30763":62587,"_3518":62655},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_4070":1925,"_34195":1902,"_23354":62657,"_5":16137,"_30763":62591,"_3518":62658},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_4070":1926,"_34195":1902,"_23354":62660,"_5":16137,"_30763":62591,"_3518":62661},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_4070":1927,"_34195":1902,"_23354":62663,"_5":16137,"_30763":62591,"_3518":62664},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_4070":1928,"_34195":1902,"_23354":62666,"_5":16137,"_30763":62595,"_3518":62667},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_4070":1929,"_34195":1902,"_23354":62669,"_5":16137,"_30763":62599,"_3518":62670},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_4070":1930,"_34195":1902,"_23354":62672,"_5":16137,"_30763":62599,"_3518":62673},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_4070":1931,"_34195":1902,"_23354":62675,"_5":16137,"_30763":62603,"_3518":62676},[],"The cryptographic enforcement can:",{"_4070":1932,"_34195":1902,"_23354":62678,"_5":16137,"_30763":62603,"_3518":62679},[],"allow or block RSA keys;",{"_4070":1933,"_34195":1902,"_23354":62681,"_5":16137,"_30763":62603,"_3518":62682},[],"limit the supported RSA sizes;",{"_4070":1934,"_34195":1902,"_23354":62684,"_5":16137,"_30763":62603,"_3518":62685},[],"allow or block ECDSA keys;",{"_4070":1935,"_34195":1902,"_23354":62687,"_5":16137,"_30763":62603,"_3518":62688},[],"limit the supported ECDSA sizes or curves.",{"_4070":1936,"_34195":1902,"_23354":62690,"_5":16137,"_30763":62603,"_3518":62691},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_4070":1937,"_34195":1902,"_23354":62693,"_5":16137,"_30763":62607,"_3518":62694},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_4070":1938,"_34195":1902,"_23354":62696,"_5":16137,"_30763":62607,"_3518":59904},[],{"_4070":1939,"_34195":1902,"_23354":62698,"_5":16137,"_30763":62607,"_3518":62699},[],"First choice",{"_4070":1940,"_34195":1902,"_23354":62701,"_5":16137,"_30763":62607,"_3518":62702},[],"Second choice",{"_4070":1941,"_34195":1902,"_23354":62704,"_5":16137,"_30763":62607,"_3518":62705},[],"If neither is supplied",{"_4070":1942,"_34195":1902,"_23354":62707,"_5":16137,"_30763":62607,"_3518":62708},[],"Direct signing with a CA",{"_4070":1943,"_34195":1902,"_23354":62710,"_5":16137,"_30763":62607,"_3518":62711},[],"`issuance_profile` embedded in the request",{"_4070":1944,"_34195":1902,"_23354":62713,"_5":16137,"_30763":62607,"_3518":62714},[],"Request `issuance_profile_id`",{"_4070":1945,"_34195":1902,"_23354":62716,"_5":16137,"_30763":62607,"_3518":62717},[],"CA default profile (`profile_id`).",{"_4070":1946,"_34195":1902,"_23354":62719,"_5":16137,"_30763":62607,"_3518":62720},[],"Issuance through a DMS",{"_4070":1947,"_34195":1902,"_23354":62722,"_5":16137,"_30763":62607,"_3518":62723},[],"`settings.issuance_profile_id`",{"_4070":1948,"_34195":1902,"_23354":62725,"_5":16137,"_30763":62607,"_3518":62726},[],"`settings.issuance_profile` embedded in the DMS",{"_4070":1949,"_34195":1902,"_23354":62728,"_5":16137,"_30763":62607,"_3518":62729},[],"Enrollment CA default profile.",{"_4070":1950,"_34195":1902,"_23354":62731,"_5":16137,"_30763":62607,"_3518":62732},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_4070":1951,"_34195":1902,"_23354":62734,"_5":16137,"_30763":62607,"_3518":62735},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_4070":1952,"_34195":1902,"_23354":62737,"_5":16137,"_30763":62615,"_3518":62738},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_4070":1953,"_34195":1902,"_23354":62740,"_5":16137,"_30763":62619,"_3518":62741},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_4070":1954,"_34195":1902,"_23354":62743,"_5":16137,"_30763":62623,"_3518":62744},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_4070":1955,"_34195":1902,"_23354":62746,"_5":16137,"_30763":62627,"_3518":62747},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_4070":1956,"_34195":1902,"_23354":62749,"_5":16137,"_30763":62631,"_3518":62750},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_4070":1957,"_34195":1902,"_23354":62752,"_5":16137,"_30763":62631,"_3518":62753},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_4070":1958,"_34195":1902,"_23354":62755,"_5":16137,"_30763":62635,"_3518":62756},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_4070":1959,"_34195":1902,"_23354":62758,"_5":16137,"_30763":62635,"_3518":62759},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_4070":1960,"_34195":1902,"_23354":62761,"_5":16137,"_30763":62635,"_3518":62762},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_4070":1961,"_34195":1902,"_23354":62764,"_5":16137,"_30763":62635,"_3518":62765},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_4070":1962,"_34195":1902,"_23354":62767,"_5":16137,"_30763":62639,"_3518":62768},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_4070":1963,"_34195":1902,"_23354":62770,"_5":16137,"_30763":62639,"_3518":62771},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_4070":1964,"_34195":1964,"_5":16540,"_3518":62773,"_34626":62774,"_23354":62776,"_30763":1964},"Certificate validation",[56672,58140,62142,62775],"Validation",[],{"_4070":1965,"_34195":1964,"_23354":62778,"_5":16137,"_30763":1964,"_3518":62779},[],"Check chain, identity, purpose and revocation from the consumer.",{"_4070":1966,"_34195":1964,"_5":34623,"_23354":62781,"_30763":62782,"_3518":62783},[],"/docs/pr-preview/pr-58/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_4070":1967,"_34195":1964,"_5":34623,"_23354":62785,"_30763":62786,"_3518":62787},[],"/docs/pr-preview/pr-58/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_4070":1968,"_34195":1964,"_5":34623,"_23354":62789,"_30763":62790,"_3518":62791},[],"/docs/pr-preview/pr-58/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_4070":1969,"_34195":1964,"_23354":62793,"_5":16137,"_30763":1964,"_3518":62794},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_4070":1970,"_34195":1964,"_23354":62796,"_5":16137,"_30763":62782,"_3518":62797},[],"Verify these criteria together:",{"_4070":1971,"_34195":1964,"_23354":62799,"_5":16137,"_30763":62782,"_3518":61768},[],{"_4070":1972,"_34195":1964,"_23354":62801,"_5":16137,"_30763":62782,"_3518":62802},[],"Required result",{"_4070":1973,"_34195":1964,"_23354":62804,"_5":16137,"_30763":62782,"_3518":62805},[],"Chain and signature",{"_4070":1974,"_34195":1964,"_23354":62807,"_5":16137,"_30763":62782,"_3518":62808},[],"Valid chain to a root deliberately installed in the consumer.",{"_4070":1975,"_34195":1964,"_23354":62810,"_5":16137,"_30763":62782,"_3518":62811},[],"Dates",{"_4070":1976,"_34195":1964,"_23354":62813,"_5":16137,"_30763":62782,"_3518":62814},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_4070":1977,"_34195":1964,"_23354":62816,"_5":16137,"_30763":62782,"_3518":57809},[],{"_4070":1978,"_34195":1964,"_23354":62818,"_5":16137,"_30763":62782,"_3518":62819},[],"Name, SAN or identifier matches the expected peer.",{"_4070":1979,"_34195":1964,"_23354":62821,"_5":16137,"_30763":62782,"_3518":57062},[],{"_4070":1980,"_34195":1964,"_23354":62823,"_5":16137,"_30763":62782,"_3518":62824},[],"KU, EKU and constraints permit the specific operation.",{"_4070":1981,"_34195":1964,"_23354":62826,"_5":16137,"_30763":62782,"_3518":62827},[],"Revocation",{"_4070":1982,"_34195":1964,"_23354":62829,"_5":16137,"_30763":62782,"_3518":62830},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_4070":1983,"_34195":1964,"_23354":62832,"_5":16137,"_30763":62782,"_3518":62833},[],"Authorization",{"_4070":1984,"_34195":1964,"_23354":62835,"_5":16137,"_30763":62782,"_3518":62836},[],"The application permits that identity to perform the action.",{"_4070":1985,"_34195":1964,"_23354":62838,"_5":16137,"_30763":62782,"_3518":62839},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_4070":1986,"_34195":1964,"_23354":62841,"_5":16137,"_30763":62786,"_3518":62842},[],"Mechanism",{"_4070":1987,"_34195":1964,"_23354":62844,"_5":16137,"_30763":62786,"_3518":62845},[],"When to use it",{"_4070":1988,"_34195":1964,"_23354":62847,"_5":16137,"_30763":62786,"_3518":62848},[],"What you must maintain",{"_4070":1989,"_34195":1964,"_23354":62850,"_5":16137,"_30763":62786,"_3518":62851},[],"OCSP",{"_4070":1990,"_34195":1964,"_23354":62853,"_5":16137,"_30763":62786,"_3518":62854},[],"Status query for a specific certificate.",{"_4070":1991,"_34195":1964,"_23354":62856,"_5":16137,"_30763":62786,"_3518":62857},[],"Responder access, signature verification and cache/freshness policy.",{"_4070":1992,"_34195":1964,"_23354":62859,"_5":16137,"_30763":62786,"_3518":62860},[],"CRL",{"_4070":1993,"_34195":1964,"_23354":62862,"_5":16137,"_30763":62786,"_3518":62863},[],"Local checks for many certificates or offline operation.",{"_4070":1994,"_34195":1964,"_23354":62865,"_5":16137,"_30763":62786,"_3518":62866},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_4070":1995,"_34195":1964,"_23354":62868,"_5":16137,"_30763":62786,"_3518":62869},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_4070":1996,"_34195":1964,"_23354":62871,"_5":16137,"_30763":62786,"_3518":62872},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_4070":1997,"_34195":1964,"_23354":62874,"_5":16137,"_30763":62790,"_3518":62875},[],"Accept a current, authorized certificate with a known chain.",{"_4070":1998,"_34195":1964,"_23354":62877,"_5":16137,"_30763":62790,"_3518":62878},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_4070":1999,"_34195":1964,"_23354":62880,"_5":16137,"_30763":62790,"_3518":62881},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_4070":2000,"_34195":1964,"_23354":62883,"_5":16137,"_30763":62790,"_3518":62884},[],"Check that a new connection with that identity is rejected.",{"_4070":2001,"_34195":1964,"_23354":62886,"_5":16137,"_30763":62790,"_3518":62887},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_4070":2002,"_34195":1964,"_23354":62889,"_5":16137,"_30763":62790,"_3518":62890},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_4070":2003,"_34195":1964,"_23354":62892,"_5":16137,"_30763":62790,"_3518":62893},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_4070":2004,"_34195":1964,"_23354":62895,"_5":16137,"_30763":62790,"_3518":62896},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_4070":2005,"_34195":1964,"_23354":62898,"_5":16137,"_30763":62790,"_3518":62899},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_4070":2006,"_34195":2006,"_5":16540,"_3518":62901,"_34626":62902,"_23354":62903,"_30763":2006},"Certificates",[56672,58140,62142,62143],[],{"_4070":2007,"_34195":2006,"_23354":62905,"_5":16137,"_30763":2006,"_3518":62906},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_4070":2008,"_34195":2006,"_5":34623,"_23354":62908,"_30763":62909,"_3518":62910},[],"/docs/pr-preview/pr-58/platform/pki/certificates#find-a-certificate","Find a certificate",{"_4070":2009,"_34195":2006,"_5":34623,"_23354":62912,"_30763":62913,"_3518":62914},[],"/docs/pr-preview/pr-58/platform/pki/certificates#download-the-certificate","Download the certificate",{"_4070":2010,"_34195":2006,"_5":34623,"_23354":62916,"_30763":62917,"_3518":62918},[],"/docs/pr-preview/pr-58/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_4070":2011,"_34195":2006,"_5":34623,"_23354":62920,"_30763":62921,"_3518":62922},[],"/docs/pr-preview/pr-58/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_4070":2012,"_34195":2006,"_5":34623,"_23354":62924,"_30763":62925,"_3518":62926},[],"/docs/pr-preview/pr-58/platform/pki/certificates#open-the-action","Open the action",{"_4070":2013,"_34195":2006,"_5":34623,"_23354":62928,"_30763":62929,"_3518":62930},[],"/docs/pr-preview/pr-58/platform/pki/certificates#choose-a-reason","Choose a reason",{"_4070":2014,"_34195":2006,"_5":34623,"_23354":62932,"_30763":62933,"_3518":62934},[],"/docs/pr-preview/pr-58/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_4070":2015,"_34195":2006,"_5":34623,"_23354":62936,"_30763":62937,"_3518":62938},[],"/docs/pr-preview/pr-58/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_4070":2016,"_34195":2006,"_5":34623,"_23354":62940,"_30763":62941,"_3518":62942},[],"/docs/pr-preview/pr-58/platform/pki/certificates#continue","Continue",{"_4070":2017,"_34195":2006,"_23354":62944,"_5":16137,"_30763":2006,"_3518":62945},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_4070":2018,"_34195":2006,"_23354":62947,"_5":16137,"_30763":62909,"_3518":62948},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_4070":2019,"_34195":2006,"_23354":62950,"_5":16137,"_30763":62909,"_3518":62951},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_4070":2020,"_34195":2006,"_23354":62953,"_5":16137,"_30763":62909,"_3518":62954},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_4070":2021,"_34195":2006,"_23354":62956,"_5":16137,"_30763":62909,"_3518":62957},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_4070":2022,"_34195":2006,"_23354":62959,"_5":16137,"_30763":62909,"_3518":62960},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_4070":2023,"_34195":2006,"_23354":62962,"_5":16137,"_30763":62909,"_3518":62963},[],"Certificate details include the key reference (`key_id`) and whether the private key is managed (`has_private_key`); certificate lists can be filtered on `has_private_key`.",{"_4070":2024,"_34195":2006,"_23354":62965,"_5":16137,"_30763":62909,"_3518":62966},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_4070":2025,"_34195":2006,"_23354":62968,"_5":16137,"_30763":62913,"_3518":62969},[],"Download the PEM and inspect it:",{"_4070":2026,"_34195":2006,"_23354":62971,"_5":16137,"_30763":62913,"_3518":62972},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_4070":2027,"_34195":2006,"_23354":62974,"_5":16137,"_30763":62917,"_3518":62975},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_4070":2028,"_34195":2006,"_23354":62977,"_5":16137,"_30763":62917,"_3518":62978},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_4070":2029,"_34195":2006,"_23354":62980,"_5":16137,"_30763":62917,"_3518":62981},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_4070":2030,"_34195":2006,"_23354":62983,"_5":16137,"_30763":62917,"_3518":62984},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_4070":2031,"_34195":2006,"_23354":62986,"_5":16137,"_30763":62917,"_3518":62987},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_4070":2032,"_34195":2006,"_23354":62989,"_5":16137,"_30763":62917,"_3518":62990},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_4070":2033,"_34195":2006,"_23354":62992,"_5":16137,"_30763":62917,"_3518":62993},[],"For browser key generation, follow Issue your first certificate.",{"_4070":2034,"_34195":2006,"_23354":62995,"_5":16137,"_30763":62921,"_3518":62996},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_4070":2035,"_34195":2006,"_23354":62998,"_5":16137,"_30763":62925,"_3518":62999},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_4070":2036,"_34195":2006,"_23354":63001,"_5":16137,"_30763":62929,"_3518":63002},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_4070":2037,"_34195":2006,"_23354":63004,"_5":16137,"_30763":62933,"_3518":63005},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_4070":2038,"_34195":2006,"_23354":63007,"_5":16137,"_30763":62933,"_3518":63008},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_4070":2039,"_34195":2006,"_23354":63010,"_5":16137,"_30763":62933,"_3518":63011},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_4070":2040,"_34195":2006,"_23354":63013,"_5":16137,"_30763":62937,"_3518":63014},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_4070":2041,"_34195":2006,"_23354":63016,"_5":16137,"_30763":62937,"_3518":63017},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_4070":2042,"_34195":2006,"_23354":63019,"_5":16137,"_30763":62937,"_3518":63020},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_4070":2043,"_34195":2006,"_23354":63022,"_5":16137,"_30763":62941,"_3518":63023},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_4070":2044,"_34195":2006,"_23354":63025,"_5":16137,"_30763":62941,"_3518":63026},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_4070":2045,"_34195":2045,"_5":16540,"_3518":63028,"_34626":63029,"_23354":63031,"_30763":2045},"Certificate lifecycle",[56672,58140,62142,63030],"Concepts",[],{"_4070":2046,"_34195":2045,"_23354":63033,"_5":16137,"_30763":2045,"_3518":63034},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_4070":2047,"_34195":2045,"_5":34623,"_23354":63036,"_30763":63037,"_3518":63038},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_4070":2048,"_34195":2045,"_5":34623,"_23354":63040,"_30763":63041,"_3518":63042},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#request","Request",{"_4070":2049,"_34195":2045,"_5":34623,"_23354":63044,"_30763":63045,"_3518":63046},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_4070":2050,"_34195":2045,"_5":34623,"_23354":63048,"_30763":63049,"_3518":63050},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_4070":2051,"_34195":2045,"_5":34623,"_23354":63052,"_30763":63053,"_3518":63054},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_4070":2052,"_34195":2045,"_5":34623,"_23354":63056,"_30763":63057,"_3518":63058},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_4070":2053,"_34195":2045,"_5":34623,"_23354":63060,"_30763":63061,"_3518":63062},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_4070":2054,"_34195":2045,"_5":34623,"_23354":63064,"_30763":63065,"_3518":63066},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_4070":2055,"_34195":2045,"_5":34623,"_23354":63068,"_30763":63069,"_3518":63070},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_4070":2056,"_34195":2045,"_5":34623,"_23354":63072,"_30763":63073,"_3518":63074},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_4070":2057,"_34195":2045,"_23354":63076,"_5":16137,"_30763":2045,"_3518":63077},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_4070":2058,"_34195":2045,"_23354":63079,"_5":16137,"_30763":63041,"_3518":63080},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_4070":2059,"_34195":2045,"_23354":63082,"_5":16137,"_30763":63045,"_3518":63083},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_4070":2060,"_34195":2045,"_23354":63085,"_5":16137,"_30763":63049,"_3518":63086},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_4070":2061,"_34195":2045,"_23354":63088,"_5":16137,"_30763":63053,"_3518":63089},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_4070":2062,"_34195":2045,"_23354":63091,"_5":16137,"_30763":63057,"_3518":63092},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_4070":2063,"_34195":2045,"_23354":63094,"_5":16137,"_30763":63061,"_3518":63095},[],"Lamassu persists four X.509 states:",{"_4070":2064,"_34195":2045,"_23354":63097,"_5":16137,"_30763":63061,"_3518":63098},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_4070":2065,"_34195":2045,"_23354":63100,"_5":16137,"_30763":63061,"_3518":63101},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_4070":2066,"_34195":2045,"_23354":63103,"_5":16137,"_30763":63061,"_3518":63104},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_4070":2067,"_34195":2045,"_23354":63106,"_5":16137,"_30763":63061,"_3518":63107},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_4070":2068,"_34195":2045,"_23354":63109,"_5":16137,"_30763":63061,"_3518":63110},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_4070":2069,"_34195":2045,"_23354":63112,"_5":16137,"_30763":63065,"_3518":63113},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_4070":2070,"_34195":2045,"_23354":63115,"_5":16137,"_30763":63065,"_3518":63116},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_4070":2071,"_34195":2045,"_23354":63118,"_5":16137,"_30763":63065,"_3518":63119},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_4070":2072,"_34195":2045,"_23354":63121,"_5":16137,"_30763":63069,"_3518":63122},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_4070":2073,"_34195":2045,"_23354":63124,"_5":16137,"_30763":63069,"_3518":63125},[],"Before confirming:",{"_4070":2074,"_34195":2045,"_23354":63127,"_5":16137,"_30763":63069,"_3518":63128},[],"Identify DMSs, devices and services that trust that chain.",{"_4070":2075,"_34195":2045,"_23354":63130,"_5":16137,"_30763":63069,"_3518":63131},[],"Distribute the new chain of trust.",{"_4070":2076,"_34195":2045,"_23354":63133,"_5":16137,"_30763":63069,"_3518":63134},[],"Reissue the necessary identities.",{"_4070":2077,"_34195":2045,"_23354":63136,"_5":16137,"_30763":63069,"_3518":63137},[],"Check OCSP and CRL from a real consumer.",{"_4070":2078,"_34195":2045,"_23354":63139,"_5":16137,"_30763":63069,"_3518":63140},[],"Revoke the old CA once no legitimate traffic remains.",{"_4070":2079,"_34195":2045,"_23354":63142,"_5":16137,"_30763":63069,"_3518":63143},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_4070":2080,"_34195":2045,"_23354":63145,"_5":16137,"_30763":63073,"_3518":63146},[],"Certificates entering the preventive or critical renewal window.",{"_4070":2081,"_34195":2045,"_23354":63148,"_5":16137,"_30763":63073,"_3518":63149},[],"Repeated enrollment or re-enrollment failures.",{"_4070":2082,"_34195":2045,"_23354":63151,"_5":16137,"_30763":63073,"_3518":63152},[],"Status changes and revocation reasons.",{"_4070":2083,"_34195":2045,"_23354":63154,"_5":16137,"_30763":63073,"_3518":63155},[],"OCSP and CRL publication and validity.",{"_4070":2084,"_34195":2045,"_23354":63157,"_5":16137,"_30763":63073,"_3518":63158},[],"Dependencies still presenting a replaced certificate.",{"_4070":2085,"_34195":2045,"_23354":63160,"_5":16137,"_30763":63073,"_3518":63161},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_4070":2086,"_34195":2086,"_5":16540,"_3518":63163,"_34626":63164,"_23354":63165,"_30763":2086},"Trust model",[56672,58140,62142,63030],[],{"_4070":2087,"_34195":2086,"_23354":63167,"_5":16137,"_30763":2086,"_3518":63168},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_4070":2088,"_34195":2086,"_5":34623,"_23354":63170,"_30763":63171,"_3518":63172},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_4070":2089,"_34195":2086,"_5":34623,"_23354":63174,"_30763":63175,"_3518":63176},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_4070":2090,"_34195":2086,"_5":34623,"_23354":63178,"_30763":63179,"_3518":63180},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_4070":2091,"_34195":2086,"_5":34623,"_23354":63182,"_30763":63183,"_3518":63184},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_4070":2092,"_34195":2086,"_5":34623,"_23354":63186,"_30763":63187,"_3518":63188},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_4070":2093,"_34195":2086,"_5":34623,"_23354":63190,"_30763":63191,"_3518":63192},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_4070":2094,"_34195":2086,"_5":34623,"_23354":63194,"_30763":63195,"_3518":63196},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_4070":2095,"_34195":2086,"_5":34623,"_23354":63198,"_30763":63199,"_3518":63200},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_4070":2096,"_34195":2086,"_5":34623,"_23354":63202,"_30763":63203,"_3518":63204},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_4070":2097,"_34195":2086,"_5":34623,"_23354":63206,"_30763":63207,"_3518":63208},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_4070":2098,"_34195":2086,"_23354":63210,"_5":16137,"_30763":2086,"_3518":63211},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_4070":2099,"_34195":2086,"_23354":63213,"_5":16137,"_30763":63175,"_3518":63214},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_4070":2100,"_34195":2086,"_23354":63216,"_5":16137,"_30763":63179,"_3518":63217},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_4070":2101,"_34195":2086,"_23354":63219,"_5":16137,"_30763":63183,"_3518":63220},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_4070":2102,"_34195":2086,"_23354":63222,"_5":16137,"_30763":63187,"_3518":63223},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_4070":2103,"_34195":2086,"_23354":63225,"_5":16137,"_30763":63191,"_3518":63226},[],"The device proves it can enroll according to the DMS policy.",{"_4070":2104,"_34195":2086,"_23354":63228,"_5":16137,"_30763":63191,"_3518":63229},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_4070":2105,"_34195":2086,"_23354":63231,"_5":16137,"_30763":63191,"_3518":63232},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_4070":2106,"_34195":2086,"_23354":63234,"_5":16137,"_30763":63191,"_3518":63235},[],"The device installs the certificate and the chain it needs.",{"_4070":2107,"_34195":2086,"_23354":63237,"_5":16137,"_30763":63191,"_3518":63238},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_4070":2108,"_34195":2086,"_23354":63240,"_5":16137,"_30763":63191,"_3518":63241},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_4070":2109,"_34195":2086,"_23354":63243,"_5":16137,"_30763":63195,"_3518":63244},[],"A DMS relates three sets that are worth designing separately:",{"_4070":2110,"_34195":2086,"_23354":63246,"_5":16137,"_30763":63195,"_3518":63247},[],"**Enrollment CA:** signs the new identities.",{"_4070":2111,"_34195":2086,"_23354":63249,"_5":16137,"_30763":63195,"_3518":63250},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_4070":2112,"_34195":2086,"_23354":63252,"_5":16137,"_30763":63195,"_3518":63253},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_4070":2113,"_34195":2086,"_23354":63255,"_5":16137,"_30763":63195,"_3518":63256},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_4070":2114,"_34195":2086,"_23354":63258,"_5":16137,"_30763":63199,"_3518":63259},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_4070":2115,"_34195":2086,"_23354":63261,"_5":16137,"_30763":63199,"_3518":63262},[],"that the current date is between `Not Before` and `Not After`;",{"_4070":2116,"_34195":2086,"_23354":63264,"_5":16137,"_30763":63199,"_3518":63265},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_4070":2117,"_34195":2086,"_23354":63267,"_5":16137,"_30763":63199,"_3518":63268},[],"that names, SANs and subject match the expected identity;",{"_4070":2118,"_34195":2086,"_23354":63270,"_5":16137,"_30763":63199,"_3518":63271},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_4070":2119,"_34195":2086,"_23354":63273,"_5":16137,"_30763":63199,"_3518":63274},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_4070":2120,"_34195":2086,"_23354":63276,"_5":16137,"_30763":63199,"_3518":63277},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_4070":2121,"_34195":2086,"_23354":63279,"_5":16137,"_30763":63203,"_3518":63280},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_4070":2122,"_34195":2086,"_23354":63282,"_5":16137,"_30763":63207,"_3518":63283},[],"Keep the root out of daily operations, or with very restricted access.",{"_4070":2123,"_34195":2086,"_23354":63285,"_5":16137,"_30763":63207,"_3518":63286},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_4070":2124,"_34195":2086,"_23354":63288,"_5":16137,"_30763":63207,"_3518":63289},[],"Assign explicit profiles to every use case.",{"_4070":2125,"_34195":2086,"_23354":63291,"_5":16137,"_30763":63207,"_3518":63292},[],"Distribute the new trust before starting a rotation.",{"_4070":2126,"_34195":2086,"_23354":63294,"_5":16137,"_30763":63207,"_3518":63295},[],"Keep enough overlap to renew a disconnected fleet.",{"_4070":2127,"_34195":2086,"_23354":63297,"_5":16137,"_30763":63207,"_3518":63298},[],"Validate from the consuming system, not only from the Lamassu console.",{"_4070":2128,"_34195":2086,"_23354":63300,"_5":16137,"_30763":63207,"_3518":63301},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_4070":2129,"_34195":2129,"_5":16540,"_3518":63303,"_34626":63304,"_23354":63305,"_30763":2129},"Revocation lists (CRL)",[56672,58140,62142,62775],[],{"_4070":2130,"_34195":2129,"_23354":63307,"_5":16137,"_30763":2129,"_3518":63308},[],"Generate and distribute signed lists to validate certificates offline.",{"_4070":2131,"_34195":2129,"_5":34623,"_23354":63310,"_30763":63311,"_3518":63312},[],"/docs/pr-preview/pr-58/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_4070":2132,"_34195":2129,"_5":34623,"_23354":63314,"_30763":63315,"_3518":63316},[],"/docs/pr-preview/pr-58/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_4070":2133,"_34195":2129,"_5":34623,"_23354":63318,"_30763":63319,"_3518":63320},[],"/docs/pr-preview/pr-58/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_4070":2134,"_34195":2129,"_5":34623,"_23354":63322,"_30763":63323,"_3518":63324},[],"/docs/pr-preview/pr-58/platform/pki/crl#crl-contents","CRL contents",{"_4070":2135,"_34195":2129,"_5":34623,"_23354":63326,"_30763":63327,"_3518":63328},[],"/docs/pr-preview/pr-58/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_4070":2136,"_34195":2129,"_5":34623,"_23354":63330,"_30763":63331,"_3518":63332},[],"/docs/pr-preview/pr-58/platform/pki/crl#va-role-management-api","VA role management API",{"_4070":2137,"_34195":2129,"_5":34623,"_23354":63334,"_30763":63335,"_3518":63336},[],"/docs/pr-preview/pr-58/platform/pki/crl#common-va-role-errors","Common VA role errors",{"_4070":2138,"_34195":2129,"_5":34623,"_23354":63338,"_30763":63339,"_3518":63340},[],"/docs/pr-preview/pr-58/platform/pki/crl#from-the-interface","From the interface",{"_4070":2139,"_34195":2129,"_5":34623,"_23354":63342,"_30763":63343,"_3518":63344},[],"/docs/pr-preview/pr-58/platform/pki/crl#references","References",{"_4070":2140,"_34195":2129,"_23354":63346,"_5":16137,"_30763":2129,"_3518":63347},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_4070":2141,"_34195":2129,"_23354":63349,"_5":16137,"_30763":63311,"_3518":63350},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_4070":2142,"_34195":2129,"_23354":63352,"_5":16137,"_30763":63311,"_3518":63353},[],"`crl_options` field",{"_4070":2143,"_34195":2129,"_23354":63355,"_5":16137,"_30763":63311,"_3518":57062},[],{"_4070":2144,"_34195":2129,"_23354":63357,"_5":16137,"_30763":63311,"_3518":63358},[],"Backend initial value",{"_4070":2145,"_34195":2129,"_23354":63360,"_5":16137,"_30763":63311,"_3518":63361},[],"`validity`",{"_4070":2146,"_34195":2129,"_23354":63363,"_5":16137,"_30763":63311,"_3518":63364},[],"Time from `thisUpdate` to `nextUpdate`.",{"_4070":2147,"_34195":2129,"_23354":63366,"_5":16137,"_30763":63311,"_3518":63367},[],"7 days.",{"_4070":2148,"_34195":2129,"_23354":63369,"_5":16137,"_30763":63311,"_3518":63370},[],"`refresh_interval`",{"_4070":2149,"_34195":2129,"_23354":63372,"_5":16137,"_30763":63311,"_3518":63373},[],"Stored and returned by the API, but the VA does not use it: scheduled renewal does not depend on it (see Periodic and automatic regeneration).",{"_4070":2150,"_34195":2129,"_23354":63375,"_5":16137,"_30763":63311,"_3518":63376},[],"6 days and 23 hours.",{"_4070":2151,"_34195":2129,"_23354":63378,"_5":16137,"_30763":63311,"_3518":63379},[],"`regenerate_on_revoke`",{"_4070":2152,"_34195":2129,"_23354":63381,"_5":16137,"_30763":63311,"_3518":63382},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_4070":2153,"_34195":2129,"_23354":63384,"_5":16137,"_30763":63311,"_3518":63385},[],"`true`.",{"_4070":2154,"_34195":2129,"_23354":63387,"_5":16137,"_30763":63311,"_3518":63388},[],"`signer_certificate_serial_number`",{"_4070":2155,"_34195":2129,"_23354":63390,"_5":16137,"_30763":63311,"_3518":63391},[],"Serial number of the existing certificate that signs the CRL.",{"_4070":2156,"_34195":2129,"_23354":63393,"_5":16137,"_30763":63311,"_3518":63394},[],"Serial number of the CA’s current certificate.",{"_4070":2157,"_34195":2129,"_23354":63396,"_5":16137,"_30763":63311,"_3518":63397},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_4070":2158,"_34195":2129,"_23354":63399,"_5":16137,"_30763":63311,"_3518":63400},[],"When a CA is reissued, the role keeps pointing at the previous certificate. CRLs remain valid because both certificates share subject and key, but the previous certificate cannot be deleted while the role uses it. To retire it, update the role’s signer.",{"_4070":2159,"_34195":2129,"_23354":63402,"_5":16137,"_30763":63311,"_3518":63403},[],"When a CA is deleted, its VA role is kept and cannot be removed through the API. If no other CA with the same SKI remains, the role can be read but any `PUT` returns 404, and the renewal job logs a warning on every cycle because it no longer finds the CA. The API offers no way out; it can only be fixed by editing the database. If another CA with that SKI remains, the role is still editable (see CAs that share a key). Adjust validity and signer before deleting the CA.",{"_4070":2160,"_34195":2129,"_23354":63405,"_5":16137,"_30763":63311,"_3518":63406},[],"A CA whose certificate lacks `cRLSign` cannot generate its CRL or edit its role (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and set it as the signer with `PUT`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages.",{"_4070":2161,"_34195":2129,"_23354":63408,"_5":16137,"_30763":63311,"_3518":63409},[],"`PUT` always validates the signer, even when the request does not change it. If the stored signer is no longer valid, no field of the role can be modified, not even the validity, until a valid one is set.",{"_4070":2162,"_34195":2129,"_23354":63411,"_5":16137,"_30763":63311,"_3518":63412},[],"Sharing a key between CAs can prevent CRL validation. See CAs that share a key.",{"_4070":2163,"_34195":2129,"_23354":63414,"_5":16137,"_30763":63311,"_3518":63415},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_4070":2164,"_34195":2129,"_23354":63417,"_5":16137,"_30763":63315,"_3518":63418},[],"The VA identifies each CRL by the CA’s SKI, and the SKI is derived from its key. Two CAs with the same key have the same SKI and share a single VA role and a single CRL. This happens when a CA is created on an existing KMS key, or when a CA is imported whose certificate declares an SKI already in use. Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. The first CA creates the role and the others keep it.",{"_4070":2165,"_34195":2129,"_23354":63420,"_5":16137,"_30763":63315,"_3518":63421},[],"The certificates of all of them point to `/crl/{ski}`, but the published list has the first CA as issuer and only includes its revocations. A verifier compares the CRL issuer with the issuer of the certificate it validates (RFC 5280, §6.3.2) and rejects the list if they differ. Depending on its policy, the certificate is blocked (*hard-fail*) or accepted even though it is revoked (*soft-fail*). Revocations of the secondary CAs do not appear in any list.",{"_4070":2166,"_34195":2129,"_23354":63423,"_5":16137,"_30763":63315,"_3518":63424},[],"If the first CA is deleted, CRL generation for the remaining one fails because the configured signer no longer matches a CA with that name. Until the role’s signer is updated to a certificate of the remaining CA, the last published list keeps being served until it expires (7 days by default).",{"_4070":2167,"_34195":2129,"_23354":63426,"_5":16137,"_30763":63315,"_3518":63427},[],"Before upgrading, review CAs that share a key. To detect the problem, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued. A CA imported with an SKI already in use does not replace the existing one as CRL issuer, because the issuer is resolved from the role’s signer. However, its own certificates point to that same URL and its revocations are not published. Until Lamassu rejects these imports, restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same collision, so also avoid reusing keys across CAs. A per-CA CRL and the rejection of imports whose SKI collides with an existing CA are both proposed in lamassuiot#834, and neither is implemented yet.",{"_4070":2168,"_34195":2129,"_23354":63429,"_5":16137,"_30763":63319,"_3518":63430},[],"The VA scheduled job checks every role on each run and requests another list when the remaining validity of `latest_crl` is less than the interval between runs. The frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. `refresh_interval` plays no part. Keep `validity` well above the interval: with a shorter validity, the list is regenerated on every cycle.",{"_4070":2169,"_34195":2129,"_23354":63432,"_5":16137,"_30763":63319,"_3518":63433},[],"If generation fails (for example, because of a role without a CA or an invalid signer), the job logs the warning `something went wrong while calculating CRL for CA <ski>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_4070":2170,"_34195":2129,"_23354":63435,"_5":16137,"_30763":63319,"_3518":63436},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if it fails (missing role, invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_4070":2171,"_34195":2129,"_23354":63438,"_5":16137,"_30763":63319,"_3518":63439},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_4070":2172,"_34195":2129,"_23354":63441,"_5":16137,"_30763":63323,"_3518":63442},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_4070":2173,"_34195":2129,"_23354":63444,"_5":16137,"_30763":63323,"_3518":63445},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_4070":2174,"_34195":2129,"_23354":63447,"_5":16137,"_30763":63327,"_3518":63448},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_4070":2175,"_34195":2129,"_23354":63450,"_5":16137,"_30763":63327,"_3518":63451},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_4070":2176,"_34195":2129,"_23354":63453,"_5":16137,"_30763":63327,"_3518":63454},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the role points to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_4070":2177,"_34195":2129,"_23354":63456,"_5":16137,"_30763":63327,"_3518":63457},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_4070":2178,"_34195":2129,"_23354":63459,"_5":16137,"_30763":63327,"_3518":63460},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_4070":2179,"_34195":2129,"_23354":63462,"_5":16137,"_30763":63331,"_3518":63463},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_4070":2180,"_34195":2129,"_23354":63465,"_5":16137,"_30763":63331,"_3518":59907},[],{"_4070":2181,"_34195":2129,"_23354":63467,"_5":16137,"_30763":63331,"_3518":63468},[],"Relative path",{"_4070":2182,"_34195":2129,"_23354":63470,"_5":16137,"_30763":63331,"_3518":59904},[],{"_4070":2183,"_34195":2129,"_23354":63472,"_5":16137,"_30763":63331,"_3518":63473},[],"`GET`",{"_4070":2184,"_34195":2129,"_23354":63475,"_5":16137,"_30763":63331,"_3518":63476},[],"`/v1/roles/{ca-ski}`",{"_4070":2185,"_34195":2129,"_23354":63478,"_5":16137,"_30763":63331,"_3518":63479},[],"Read `crl_options` and `latest_crl`.",{"_4070":2186,"_34195":2129,"_23354":63481,"_5":16137,"_30763":63331,"_3518":63482},[],"`PUT`",{"_4070":2187,"_34195":2129,"_23354":63484,"_5":16137,"_30763":63331,"_3518":63476},[],{"_4070":2188,"_34195":2129,"_23354":63486,"_5":16137,"_30763":63331,"_3518":63487},[],"Replace CRL configuration.",{"_4070":2189,"_34195":2129,"_23354":63489,"_5":16137,"_30763":63331,"_3518":63490},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_4070":2190,"_34195":2129,"_23354":63492,"_5":16137,"_30763":63331,"_3518":63493},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_4070":2191,"_34195":2129,"_23354":63495,"_5":16137,"_30763":63335,"_3518":63496},[],"Symptom",{"_4070":2192,"_34195":2129,"_23354":63498,"_5":16137,"_30763":63335,"_3518":63499},[],"Cause",{"_4070":2193,"_34195":2129,"_23354":63501,"_5":16137,"_30763":63335,"_3518":63502},[],"Action",{"_4070":2194,"_34195":2129,"_23354":63504,"_5":16137,"_30763":63335,"_3518":63505},[],"`PUT /v1/roles/{ca-ski}` returns 404 and `GET` returns 200.",{"_4070":2195,"_34195":2129,"_23354":63507,"_5":16137,"_30763":63335,"_3518":63508},[],"The role’s CA was deleted and no other CA with the same SKI remains.",{"_4070":2196,"_34195":2129,"_23354":63510,"_5":16137,"_30763":63335,"_3518":63511},[],"There is no API way out; it requires database intervention. Avoid it by adjusting the role before deleting the CA.",{"_4070":2197,"_34195":2129,"_23354":63513,"_5":16137,"_30763":63335,"_3518":63514},[],"`PUT` returns 400.",{"_4070":2198,"_34195":2129,"_23354":63516,"_5":16137,"_30763":63335,"_3518":63517},[],"The signer lacks `cRLSign`, or its subject and key match no CA with that SKI (for example, after deleting the first of two CAs that share a key).",{"_4070":2199,"_34195":2129,"_23354":63519,"_5":16137,"_30763":63335,"_3518":63520},[],"Use `PUT` to set the serial number of a valid certificate of the remaining CA.",{"_4070":2200,"_34195":2129,"_23354":63522,"_5":16137,"_30763":63335,"_3518":63523},[],"`PUT` returns 400 from a 3.x client.",{"_4070":2201,"_34195":2129,"_23354":63525,"_5":16137,"_30763":63335,"_3518":63526},[],"`crl_options.subject_key_id_signer` was replaced by `signer_certificate_serial_number`, which is required.",{"_4070":2202,"_34195":2129,"_23354":63528,"_5":16137,"_30763":63335,"_3518":63529},[],"Update the client to send the new field.",{"_4070":2203,"_34195":2129,"_23354":63531,"_5":16137,"_30763":63335,"_3518":63532},[],"The CRL does not change after revoking a certificate.",{"_4070":2204,"_34195":2129,"_23354":63534,"_5":16137,"_30763":63335,"_3518":63535},[],"`regenerate_on_revoke` is `false`, or the event failed because of a missing role or an invalid signer.",{"_4070":2205,"_34195":2129,"_23354":63537,"_5":16137,"_30763":63335,"_3518":63538},[],"Check the VA logs and the failed-events queue; fix the signer.",{"_4070":2206,"_34195":2129,"_23354":63540,"_5":16137,"_30763":63335,"_3518":63541},[],"A verifier rejects the CRL because of the issuer.",{"_4070":2207,"_34195":2129,"_23354":63543,"_5":16137,"_30763":63335,"_3518":63544},[],"Several CAs share an SKI.",{"_4070":2208,"_34195":2129,"_23354":63546,"_5":16137,"_30763":63335,"_3518":63547},[],"See CAs that share a key.",{"_4070":2209,"_34195":2129,"_23354":63549,"_5":16137,"_30763":63339,"_3518":63550},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. The CA’s VA settings also let you select the CRL signer: the certificate picker only offers certificates that have a private key and carry the `cRLSign` key usage. If a configured signer’s certificate cannot be resolved, the interface shows `Unknown Certificate (Serial: X)` or `Certificate details unavailable (Serial: X)`. Diagnose differences using PKI troubleshooting.",{"_4070":2210,"_34195":2129,"_23354":63552,"_5":16137,"_30763":63343,"_3518":63553},[],"RFC 5280: X.509 and CRL profile.",{"_4070":2211,"_34195":2129,"_23354":63555,"_5":16137,"_30763":63343,"_3518":63556},[],"OpenSSL: openssl-crl.",{"_4070":2212,"_34195":2129,"_23354":63558,"_5":16137,"_30763":63343,"_3518":63559},[],"OpenSSL: openssl-verify.",{"_4070":2213,"_34195":2129,"_23354":63561,"_5":16137,"_30763":63343,"_3518":63562},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_4070":2214,"_34195":2129,"_23354":63564,"_5":16137,"_30763":63343,"_3518":63565},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_4070":2215,"_34195":2215,"_5":16540,"_3518":63567,"_34626":63568,"_23354":63569,"_30763":2215},"Keys and cryptographic engines",[56672,58140,62142,62143],[],{"_4070":2216,"_34195":2215,"_23354":63571,"_5":16137,"_30763":2215,"_3518":63572},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_4070":2217,"_34195":2215,"_5":34623,"_23354":63574,"_30763":63575,"_3518":63576},[],"/docs/pr-preview/pr-58/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_4070":2218,"_34195":2215,"_5":34623,"_23354":63578,"_30763":63579,"_3518":63580},[],"/docs/pr-preview/pr-58/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_4070":2219,"_34195":2215,"_5":34623,"_23354":63582,"_30763":63583,"_3518":63584},[],"/docs/pr-preview/pr-58/platform/pki/key-management#file-system","File System",{"_4070":2220,"_34195":2215,"_5":34623,"_23354":63586,"_30763":63587,"_3518":63588},[],"/docs/pr-preview/pr-58/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_4070":2221,"_34195":2215,"_5":34623,"_23354":63590,"_30763":63591,"_3518":63592},[],"/docs/pr-preview/pr-58/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_4070":2222,"_34195":2215,"_5":34623,"_23354":63594,"_30763":63595,"_3518":63596},[],"/docs/pr-preview/pr-58/platform/pki/key-management#aws-kms","AWS KMS",{"_4070":2223,"_34195":2215,"_5":34623,"_23354":63598,"_30763":63599,"_3518":63600},[],"/docs/pr-preview/pr-58/platform/pki/key-management#pkcs11","PKCS#11",{"_4070":2224,"_34195":2215,"_5":34623,"_23354":63602,"_30763":63603,"_3518":63604},[],"/docs/pr-preview/pr-58/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_4070":2225,"_34195":2215,"_5":34623,"_23354":63606,"_30763":63607,"_3518":63608},[],"/docs/pr-preview/pr-58/platform/pki/key-management#key-inventory","Key inventory",{"_4070":2226,"_34195":2215,"_5":34623,"_23354":63610,"_30763":63611,"_3518":63612},[],"/docs/pr-preview/pr-58/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_4070":2227,"_34195":2215,"_5":34623,"_23354":63614,"_30763":63615,"_3518":63616},[],"/docs/pr-preview/pr-58/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_4070":2228,"_34195":2215,"_5":34623,"_23354":63618,"_30763":63619,"_3518":63620},[],"/docs/pr-preview/pr-58/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_4070":2229,"_34195":2215,"_5":34623,"_23354":63622,"_30763":63623,"_3518":63624},[],"/docs/pr-preview/pr-58/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_4070":2230,"_34195":2215,"_5":34623,"_23354":63626,"_30763":63627,"_3518":63628},[],"/docs/pr-preview/pr-58/platform/pki/key-management#view-details","View details",{"_4070":2231,"_34195":2215,"_5":34623,"_23354":63630,"_30763":63631,"_3518":63632},[],"/docs/pr-preview/pr-58/platform/pki/key-management#sign-and-verify","Sign and verify",{"_4070":2232,"_34195":2215,"_5":34623,"_23354":63634,"_30763":63635,"_3518":63636},[],"/docs/pr-preview/pr-58/platform/pki/key-management#sign","Sign",{"_4070":2233,"_34195":2215,"_5":34623,"_23354":63638,"_30763":63639,"_3518":63640},[],"/docs/pr-preview/pr-58/platform/pki/key-management#verify","Verify",{"_4070":2234,"_34195":2215,"_5":34623,"_23354":63642,"_30763":63643,"_3518":63644},[],"/docs/pr-preview/pr-58/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_4070":2235,"_34195":2215,"_5":34623,"_23354":63646,"_30763":63647,"_3518":63648},[],"/docs/pr-preview/pr-58/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_4070":2236,"_34195":2215,"_5":34623,"_23354":63650,"_30763":63651,"_3518":63652},[],"/docs/pr-preview/pr-58/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_4070":2237,"_34195":2215,"_23354":63654,"_5":16137,"_30763":2215,"_3518":63655},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_4070":2238,"_34195":2215,"_23354":63657,"_5":16137,"_30763":2215,"_3518":63658},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_4070":2239,"_34195":2215,"_23354":63660,"_5":16137,"_30763":63575,"_3518":63661},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_4070":2240,"_34195":2215,"_23354":63663,"_5":16137,"_30763":63575,"_3518":63664},[],"In practice, it lets you:",{"_4070":2241,"_34195":2215,"_23354":63666,"_5":16137,"_30763":63575,"_3518":63667},[],"Generate new key pairs from Lamassu IoT.",{"_4070":2242,"_34195":2215,"_23354":63669,"_5":16137,"_30763":63575,"_3518":63670},[],"Import keys created externally.",{"_4070":2243,"_34195":2215,"_23354":63672,"_5":16137,"_30763":63575,"_3518":63673},[],"Delegate custody and cryptographic operations to external engines.",{"_4070":2244,"_34195":2215,"_23354":63675,"_5":16137,"_30763":63575,"_3518":63676},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_4070":2245,"_34195":2215,"_23354":63678,"_5":16137,"_30763":63579,"_3518":63679},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_4070":2246,"_34195":2215,"_23354":63681,"_5":16137,"_30763":63579,"_3518":63682},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_4070":2247,"_34195":2215,"_23354":63684,"_5":16137,"_30763":63579,"_3518":63685},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_4070":2248,"_34195":2215,"_23354":63687,"_5":16137,"_30763":63583,"_3518":63688},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_4070":2249,"_34195":2215,"_23354":63690,"_5":16137,"_30763":63587,"_3518":63691},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_4070":2250,"_34195":2215,"_23354":63693,"_5":16137,"_30763":63587,"_3518":63694},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_4070":2251,"_34195":2215,"_23354":63696,"_5":16137,"_30763":63591,"_3518":63697},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_4070":2252,"_34195":2215,"_23354":63699,"_5":16137,"_30763":63595,"_3518":63700},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_4070":2253,"_34195":2215,"_23354":63702,"_5":16137,"_30763":63599,"_3518":63703},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_4070":2254,"_34195":2215,"_23354":63705,"_5":16137,"_30763":63603,"_3518":63706},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_4070":2255,"_34195":2215,"_23354":63708,"_5":16137,"_30763":63603,"_3518":63709},[],"Lamassu shows the enabled engines in the console.",{"_4070":2256,"_34195":2215,"_23354":63711,"_5":16137,"_30763":63603,"_3518":63712},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_4070":2257,"_34195":2215,"_23354":63714,"_5":16137,"_30763":63603,"_3518":63715},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_4070":2258,"_34195":2215,"_23354":63717,"_5":16137,"_30763":63607,"_3518":63718},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_4070":2259,"_34195":2215,"_23354":63720,"_5":16137,"_30763":63607,"_3518":63721},[],"The table includes the following fields:",{"_4070":2260,"_34195":2215,"_23354":63723,"_5":16137,"_30763":63607,"_3518":63724},[],"**Name**: descriptive name of the key.",{"_4070":2261,"_34195":2215,"_23354":63726,"_5":16137,"_30763":63607,"_3518":63727},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_4070":2262,"_34195":2215,"_23354":63729,"_5":16137,"_30763":63607,"_3518":63730},[],"**Strength**: visual indicator of cryptographic strength.",{"_4070":2263,"_34195":2215,"_23354":63732,"_5":16137,"_30763":63607,"_3518":63733},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_4070":2264,"_34195":2215,"_23354":63735,"_5":16137,"_30763":63607,"_3518":63736},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_4070":2265,"_34195":2215,"_23354":63738,"_5":16137,"_30763":63607,"_3518":63739},[],"**Aliases**: alternative names associated with the key.",{"_4070":2266,"_34195":2215,"_23354":63741,"_5":16137,"_30763":63607,"_3518":63742},[],"**Tags**: labels for classification and search.",{"_4070":2267,"_34195":2215,"_23354":63744,"_5":16137,"_30763":63607,"_3518":63745},[],"**Related Entities**: certificates or other entities linked to that key.",{"_4070":2268,"_34195":2215,"_23354":63747,"_5":16137,"_30763":63607,"_3518":63748},[],"From this view you also reach the most common actions:",{"_4070":2269,"_34195":2215,"_23354":63750,"_5":16137,"_30763":63607,"_3518":63751},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_4070":2270,"_34195":2215,"_23354":63753,"_5":16137,"_30763":63607,"_3518":63754},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_4070":2271,"_34195":2215,"_23354":63756,"_5":16137,"_30763":63607,"_3518":63757},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_4070":2272,"_34195":2215,"_23354":63759,"_5":16137,"_30763":63607,"_3518":63760},[],"**Delete Key** to remove the key from the system.",{"_4070":2273,"_34195":2215,"_23354":63762,"_5":16137,"_30763":63611,"_3518":63763},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_4070":2274,"_34195":2215,"_23354":63765,"_5":16137,"_30763":63615,"_3518":63766},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_4070":2275,"_34195":2215,"_23354":63768,"_5":16137,"_30763":63615,"_3518":63769},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_4070":2276,"_34195":2215,"_23354":63771,"_5":16137,"_30763":63615,"_3518":63772},[],"**Key Name**: unique and descriptive name.",{"_4070":2277,"_34195":2215,"_23354":63774,"_5":16137,"_30763":63615,"_3518":63775},[],"**Crypto Engine**: engine that will keep the key.",{"_4070":2278,"_34195":2215,"_23354":63777,"_5":16137,"_30763":63615,"_3518":63778},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_4070":2279,"_34195":2215,"_23354":63780,"_5":16137,"_30763":63615,"_3518":63781},[],"**Tags**: metadata to classify the key.",{"_4070":2280,"_34195":2215,"_23354":63783,"_5":16137,"_30763":63615,"_3518":63784},[],"**Metadata**: additional information for advanced uses.",{"_4070":2281,"_34195":2215,"_23354":63786,"_5":16137,"_30763":63619,"_3518":63787},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_4070":2282,"_34195":2215,"_23354":63789,"_5":16137,"_30763":63619,"_3518":63790},[],"When you have an exportable private key and the destination engine supports import.",{"_4070":2283,"_34195":2215,"_23354":63792,"_5":16137,"_30763":63619,"_3518":63793},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_4070":2284,"_34195":2215,"_23354":63795,"_5":16137,"_30763":63619,"_3518":63796},[],"When Lamassu must operate with a root of trust created by a third party.",{"_4070":2285,"_34195":2215,"_23354":63798,"_5":16137,"_30763":63619,"_3518":63799},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_4070":2286,"_34195":2215,"_23354":63801,"_5":16137,"_30763":63619,"_3518":63802},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_4070":2287,"_34195":2215,"_23354":63804,"_5":16137,"_30763":63619,"_3518":63805},[],"**Crypto Engine**: engine that will keep the imported key.",{"_4070":2288,"_34195":2215,"_23354":63807,"_5":16137,"_30763":63619,"_3518":63808},[],"**Tags**: labels for organization and search.",{"_4070":2289,"_34195":2215,"_23354":63810,"_5":16137,"_30763":63619,"_3518":63811},[],"**Metadata**: additional optional information.",{"_4070":2290,"_34195":2215,"_23354":63813,"_5":16137,"_30763":63619,"_3518":63814},[],"**Private Key (PEM)**: private key in PEM format.",{"_4070":2291,"_34195":2215,"_23354":63816,"_5":16137,"_30763":63619,"_3518":63817},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_4070":2292,"_34195":2215,"_23354":63819,"_5":16137,"_30763":63623,"_3518":63820},[],"Each registered key has a detail view and several operational actions.",{"_4070":2293,"_34195":2215,"_23354":63822,"_5":16137,"_30763":63627,"_3518":63823},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_4070":2294,"_34195":2215,"_23354":63825,"_5":16137,"_30763":63627,"_3518":63826},[],"The **Overview** tab shows, among others, these fields:",{"_4070":2295,"_34195":2215,"_23354":63828,"_5":16137,"_30763":63627,"_3518":63829},[],"**Key Name**: descriptive name.",{"_4070":2296,"_34195":2215,"_23354":63831,"_5":16137,"_30763":63627,"_3518":63832},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_4070":2297,"_34195":2215,"_23354":63834,"_5":16137,"_30763":63627,"_3518":63835},[],"**Tags**: associated labels.",{"_4070":2298,"_34195":2215,"_23354":63837,"_5":16137,"_30763":63627,"_3518":63838},[],"**Aliases**: alternative names.",{"_4070":2299,"_34195":2215,"_23354":63840,"_5":16137,"_30763":63627,"_3518":63841},[],"**Crypto Engine**: engine where the key resides.",{"_4070":2300,"_34195":2215,"_23354":63843,"_5":16137,"_30763":63627,"_3518":63844},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_4070":2301,"_34195":2215,"_23354":63846,"_5":16137,"_30763":63627,"_3518":63847},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_4070":2302,"_34195":2215,"_23354":63849,"_5":16137,"_30763":63627,"_3518":63850},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_4070":2303,"_34195":2215,"_23354":63852,"_5":16137,"_30763":63631,"_3518":63853},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_4070":2304,"_34195":2215,"_23354":63855,"_5":16137,"_30763":63631,"_3518":63856},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_4070":2305,"_34195":2215,"_23354":63858,"_5":16137,"_30763":63631,"_3518":63859},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_4070":2306,"_34195":2215,"_23354":63861,"_5":16137,"_30763":63635,"_3518":63862},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_4070":2307,"_34195":2215,"_23354":63864,"_5":16137,"_30763":63635,"_3518":63865},[],"Main fields:",{"_4070":2308,"_34195":2215,"_23354":63867,"_5":16137,"_30763":63635,"_3518":63868},[],"**Algorithm**: signing algorithm available for the key type.",{"_4070":2309,"_34195":2215,"_23354":63870,"_5":16137,"_30763":63635,"_3518":63871},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_4070":2310,"_34195":2215,"_23354":63873,"_5":16137,"_30763":63635,"_3518":63874},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_4070":2311,"_34195":2215,"_23354":63876,"_5":16137,"_30763":63635,"_3518":63877},[],"**Message**: content to sign.",{"_4070":2312,"_34195":2215,"_23354":63879,"_5":16137,"_30763":63635,"_3518":63880},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_4070":2313,"_34195":2215,"_23354":63882,"_5":16137,"_30763":63639,"_3518":63883},[],"This tab checks whether a signature corresponds to the associated public key.",{"_4070":2314,"_34195":2215,"_23354":63885,"_5":16137,"_30763":63639,"_3518":63865},[],{"_4070":2315,"_34195":2215,"_23354":63887,"_5":16137,"_30763":63639,"_3518":63888},[],"**Algorithm**: must match the algorithm used for the signature.",{"_4070":2316,"_34195":2215,"_23354":63890,"_5":16137,"_30763":63639,"_3518":63891},[],"**Message Type**: `Raw` or `Digest`.",{"_4070":2317,"_34195":2215,"_23354":63893,"_5":16137,"_30763":63639,"_3518":63894},[],"**Payload Encoding**: encoding of the message.",{"_4070":2318,"_34195":2215,"_23354":63896,"_5":16137,"_30763":63639,"_3518":63897},[],"**Message**: original message or hash.",{"_4070":2319,"_34195":2215,"_23354":63899,"_5":16137,"_30763":63639,"_3518":63900},[],"**Signature**: signature to check.",{"_4070":2320,"_34195":2215,"_23354":63902,"_5":16137,"_30763":63639,"_3518":63903},[],"**Result**: indicator of the validation result.",{"_4070":2321,"_34195":2215,"_23354":63905,"_5":16137,"_30763":63643,"_3518":63906},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_4070":2322,"_34195":2215,"_23354":63908,"_5":16137,"_30763":63643,"_3518":63909},[],"This flow is useful for:",{"_4070":2323,"_34195":2215,"_23354":63911,"_5":16137,"_30763":63643,"_3518":63912},[],"Requesting certificates from an external CA.",{"_4070":2324,"_34195":2215,"_23354":63914,"_5":16137,"_30763":63643,"_3518":63915},[],"Renewing an identity while keeping the same key.",{"_4070":2325,"_34195":2215,"_23354":63917,"_5":16137,"_30763":63643,"_3518":63918},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_4070":2326,"_34195":2215,"_23354":63920,"_5":16137,"_30763":63643,"_3518":63921},[],"**Common Name (CN)**: main name of the identity.",{"_4070":2327,"_34195":2215,"_23354":63923,"_5":16137,"_30763":63643,"_3518":63924},[],"**Organization (O)**: organization or company.",{"_4070":2328,"_34195":2215,"_23354":63926,"_5":16137,"_30763":63643,"_3518":63927},[],"**Organizational Unit (OU)**: department or unit.",{"_4070":2329,"_34195":2215,"_23354":63929,"_5":16137,"_30763":63643,"_3518":63930},[],"**Country (C)**: two-letter country code.",{"_4070":2330,"_34195":2215,"_23354":63932,"_5":16137,"_30763":63643,"_3518":63933},[],"**State / Province (ST)**: state or province.",{"_4070":2331,"_34195":2215,"_23354":63935,"_5":16137,"_30763":63643,"_3518":63936},[],"**Locality (L)**: city or locality.",{"_4070":2332,"_34195":2215,"_23354":63938,"_5":16137,"_30763":63643,"_3518":63939},[],"**Email Address**: contact email.",{"_4070":2333,"_34195":2215,"_23354":63941,"_5":16137,"_30763":63643,"_3518":63942},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_4070":2334,"_34195":2215,"_23354":63944,"_5":16137,"_30763":63643,"_3518":63945},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_4070":2335,"_34195":2215,"_23354":63947,"_5":16137,"_30763":63647,"_3518":63948},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_4070":2336,"_34195":2215,"_23354":63950,"_5":16137,"_30763":63647,"_3518":63951},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_4070":2337,"_34195":2215,"_23354":63953,"_5":16137,"_30763":63651,"_3518":63954},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_4070":2338,"_34195":2215,"_23354":63956,"_5":16137,"_30763":63651,"_3518":63957},[],"The KMS refuses to delete a key that certificates still reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. Revoking certificates issued by the deleted CA does not release their own key references. Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_4070":2339,"_34195":2339,"_5":16540,"_3518":63959,"_34626":63960,"_23354":63961,"_30763":2339},"Online validation with OCSP",[56672,58140,62142,62775],[],{"_4070":2340,"_34195":2339,"_23354":63963,"_5":16137,"_30763":2339,"_3518":63964},[],"Query signed status and verify the responder’s response.",{"_4070":2341,"_34195":2339,"_5":34623,"_23354":63966,"_30763":63967,"_3518":63968},[],"/docs/pr-preview/pr-58/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_4070":2342,"_34195":2339,"_5":34623,"_23354":63970,"_30763":63971,"_3518":63972},[],"/docs/pr-preview/pr-58/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_4070":2343,"_34195":2339,"_5":34623,"_23354":63974,"_30763":63975,"_3518":63976},[],"/docs/pr-preview/pr-58/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_4070":2344,"_34195":2339,"_5":34623,"_23354":63978,"_30763":63979,"_3518":63980},[],"/docs/pr-preview/pr-58/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_4070":2345,"_34195":2339,"_5":34623,"_23354":63982,"_30763":63983,"_3518":63984},[],"/docs/pr-preview/pr-58/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_4070":2346,"_34195":2339,"_5":34623,"_23354":63986,"_30763":63987,"_3518":63344},[],"/docs/pr-preview/pr-58/platform/pki/ocsp#references",{"_4070":2347,"_34195":2339,"_23354":63989,"_5":16137,"_30763":2339,"_3518":63990},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_4070":2348,"_34195":2339,"_23354":63992,"_5":16137,"_30763":63967,"_3518":63993},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_4070":2349,"_34195":2339,"_23354":63995,"_5":16137,"_30763":63967,"_3518":63996},[],"Record status",{"_4070":2350,"_34195":2339,"_23354":63998,"_5":16137,"_30763":63967,"_3518":63999},[],"Signed response",{"_4070":2351,"_34195":2339,"_23354":64001,"_5":16137,"_30763":63967,"_3518":61279},[],{"_4070":2352,"_34195":2339,"_23354":64003,"_5":16137,"_30763":63967,"_3518":64004},[],"`Good`.",{"_4070":2353,"_34195":2339,"_23354":64006,"_5":16137,"_30763":63967,"_3518":61296},[],{"_4070":2354,"_34195":2339,"_23354":64008,"_5":16137,"_30763":63967,"_3518":64009},[],"`Revoked`, with revocation reason and timestamp.",{"_4070":2355,"_34195":2339,"_23354":64011,"_5":16137,"_30763":63967,"_3518":64012},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_4070":2356,"_34195":2339,"_23354":64014,"_5":16137,"_30763":63967,"_3518":64015},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_4070":2357,"_34195":2339,"_23354":64017,"_5":16137,"_30763":63967,"_3518":64018},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_4070":2358,"_34195":2339,"_23354":64020,"_5":16137,"_30763":63967,"_3518":64021},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_4070":2359,"_34195":2339,"_23354":64023,"_5":16137,"_30763":63967,"_3518":64024},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_4070":2360,"_34195":2339,"_23354":64026,"_5":16137,"_30763":63971,"_3518":64027},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_4070":2361,"_34195":2339,"_23354":64029,"_5":16137,"_30763":63971,"_3518":64030},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_4070":2362,"_34195":2339,"_23354":64032,"_5":16137,"_30763":63975,"_3518":64033},[],"The service accepts:",{"_4070":2363,"_34195":2339,"_23354":64035,"_5":16137,"_30763":63975,"_3518":59907},[],{"_4070":2364,"_34195":2339,"_23354":64037,"_5":16137,"_30763":63975,"_3518":64038},[],"VA service path",{"_4070":2365,"_34195":2339,"_23354":64040,"_5":16137,"_30763":63975,"_3518":64041},[],"Format",{"_4070":2366,"_34195":2339,"_23354":64043,"_5":16137,"_30763":63975,"_3518":64044},[],"`POST`",{"_4070":2367,"_34195":2339,"_23354":64046,"_5":16137,"_30763":63975,"_3518":64047},[],"`/ocsp`",{"_4070":2368,"_34195":2339,"_23354":64049,"_5":16137,"_30763":63975,"_3518":64050},[],"DER request, `Content-Type: application/ocsp-request`.",{"_4070":2369,"_34195":2339,"_23354":64052,"_5":16137,"_30763":63975,"_3518":63473},[],{"_4070":2370,"_34195":2339,"_23354":64054,"_5":16137,"_30763":63975,"_3518":64055},[],"`/ocsp/{ocsp_request}`",{"_4070":2371,"_34195":2339,"_23354":64057,"_5":16137,"_30763":63975,"_3518":64058},[],"DER request encoded using padded URL Base64.",{"_4070":2372,"_34195":2339,"_23354":64060,"_5":16137,"_30763":63975,"_3518":64061},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_4070":2373,"_34195":2339,"_23354":64063,"_5":16137,"_30763":63979,"_3518":64064},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_4070":2374,"_34195":2339,"_23354":64066,"_5":16137,"_30763":63979,"_3518":64067},[],"Generate the request:",{"_4070":2375,"_34195":2339,"_23354":64069,"_5":16137,"_30763":63979,"_3518":64070},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_4070":2376,"_34195":2339,"_23354":64072,"_5":16137,"_30763":63979,"_3518":64073},[],"Replace the example URL with the inspected endpoint:",{"_4070":2377,"_34195":2339,"_23354":64075,"_5":16137,"_30763":63979,"_3518":64076},[],"Verify the returned DER:",{"_4070":2378,"_34195":2339,"_23354":64078,"_5":16137,"_30763":63979,"_3518":64079},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_4070":2379,"_34195":2339,"_23354":64081,"_5":16137,"_30763":63983,"_3518":64082},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_4070":2380,"_34195":2339,"_23354":64084,"_5":16137,"_30763":63983,"_3518":64085},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_4070":2381,"_34195":2339,"_23354":64087,"_5":16137,"_30763":63987,"_3518":64088},[],"RFC 6960: OCSP.",{"_4070":2382,"_34195":2339,"_23354":64090,"_5":16137,"_30763":63987,"_3518":64091},[],"OpenSSL: openssl-ocsp.",{"_4070":2383,"_34195":2339,"_23354":64093,"_5":16137,"_30763":63987,"_3518":64094},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_4070":2384,"_34195":2339,"_23354":64096,"_5":16137,"_30763":63987,"_3518":63565},[],{"_4070":2385,"_34195":2385,"_5":16540,"_3518":62142,"_34626":64098,"_23354":64099,"_30763":2385},[56672,58140,62142],[],{"_4070":2386,"_34195":2385,"_23354":64101,"_5":16137,"_30763":2385,"_3518":64102},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_4070":2387,"_34195":2385,"_5":34623,"_23354":64104,"_30763":64105,"_3518":61454},[],"/docs/pr-preview/pr-58/platform/pki/overview#start-here",{"_4070":2388,"_34195":2385,"_5":34623,"_23354":64107,"_30763":64108,"_3518":64109},[],"/docs/pr-preview/pr-58/platform/pki/overview#what-you-need","What you need",{"_4070":2389,"_34195":2385,"_5":34623,"_23354":64111,"_30763":64112,"_3518":61986},[],"/docs/pr-preview/pr-58/platform/pki/overview#core-capabilities",{"_4070":2390,"_34195":2385,"_5":34623,"_23354":64114,"_30763":64115,"_3518":61990},[],"/docs/pr-preview/pr-58/platform/pki/overview#build-your-trust-hierarchy",{"_4070":2391,"_34195":2385,"_5":34623,"_23354":64117,"_30763":64118,"_3518":61994},[],"/docs/pr-preview/pr-58/platform/pki/overview#protect-cryptographic-keys",{"_4070":2392,"_34195":2385,"_5":34623,"_23354":64120,"_30763":64121,"_3518":61998},[],"/docs/pr-preview/pr-58/platform/pki/overview#issue-and-control-certificates",{"_4070":2393,"_34195":2385,"_5":34623,"_23354":64123,"_30763":64124,"_3518":62006},[],"/docs/pr-preview/pr-58/platform/pki/overview#publish-validation-status",{"_4070":2394,"_34195":2385,"_5":34623,"_23354":64126,"_30763":64127,"_3518":64128},[],"/docs/pr-preview/pr-58/platform/pki/overview#how-to-check-the-result","How to check the result",{"_4070":2395,"_34195":2385,"_5":34623,"_23354":64130,"_30763":64131,"_3518":62942},[],"/docs/pr-preview/pr-58/platform/pki/overview#continue",{"_4070":2396,"_34195":2385,"_23354":64133,"_5":16137,"_30763":2385,"_3518":64134},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_4070":2397,"_34195":2385,"_23354":64136,"_5":16137,"_30763":64105,"_3518":64137},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_4070":2398,"_34195":2385,"_23354":64139,"_5":16137,"_30763":64105,"_3518":64140},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_4070":2399,"_34195":2385,"_23354":64142,"_5":16137,"_30763":64108,"_3518":64143},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_4070":2400,"_34195":2385,"_23354":64145,"_5":16137,"_30763":64108,"_3518":64146},[],"An available cryptographic engine to keep the authority's key.",{"_4070":2401,"_34195":2385,"_23354":64148,"_5":16137,"_30763":64108,"_3518":64149},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_4070":2402,"_34195":2385,"_23354":64151,"_5":16137,"_30763":64108,"_3518":64152},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_4070":2403,"_34195":2385,"_23354":64154,"_5":16137,"_30763":64108,"_3518":64155},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_4070":2404,"_34195":2385,"_23354":64157,"_5":16137,"_30763":64115,"_3518":64158},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_4070":2405,"_34195":2385,"_23354":64160,"_5":16137,"_30763":64118,"_3518":64161},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_4070":2406,"_34195":2385,"_23354":64163,"_5":16137,"_30763":64121,"_3518":64164},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_4070":2407,"_34195":2385,"_23354":64166,"_5":16137,"_30763":64124,"_3518":64167},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_4070":2408,"_34195":2385,"_23354":64169,"_5":16137,"_30763":64127,"_3518":64170},[],"An active certificate in the console is one part of the check. Also verify that:",{"_4070":2409,"_34195":2385,"_23354":64172,"_5":16137,"_30763":64127,"_3518":64173},[],"its subject and extensions identify the expected client;",{"_4070":2410,"_34195":2385,"_23354":64175,"_5":16137,"_30763":64127,"_3518":64176},[],"its public key matches the client's private key;",{"_4070":2411,"_34195":2385,"_23354":64178,"_5":16137,"_30763":64127,"_3518":64179},[],"its chain reaches a root trusted by the consumer;",{"_4070":2412,"_34195":2385,"_23354":64181,"_5":16137,"_30763":64127,"_3518":64182},[],"its dates and usages allow the operation;",{"_4070":2413,"_34195":2385,"_23354":64184,"_5":16137,"_30763":64127,"_3518":64185},[],"the consumer applies revocation checks and authorization.",{"_4070":2414,"_34195":2385,"_23354":64187,"_5":16137,"_30763":64127,"_3518":64188},[],"The issuance path includes the first independent checks.",{"_4070":2415,"_34195":2385,"_23354":64190,"_5":16137,"_30763":64131,"_3518":64191},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_4070":2416,"_34195":2385,"_23354":64193,"_5":16137,"_30763":64131,"_3518":64194},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_4070":2417,"_34195":2385,"_23354":64196,"_5":16137,"_30763":64131,"_3518":64197},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_4070":2418,"_34195":2418,"_5":16540,"_3518":64199,"_34626":64200,"_23354":64201,"_30763":2418},"Create your first CA",[56672,58140,62142,61579],[],{"_4070":2419,"_34195":2418,"_23354":64203,"_5":16137,"_30763":2418,"_3518":64204},[],"Create an evaluation root and check its certificate before issuing.",{"_4070":2420,"_34195":2418,"_5":34623,"_23354":64206,"_30763":64207,"_3518":56682},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_4070":2421,"_34195":2418,"_5":34623,"_23354":64209,"_30763":64210,"_3518":64211},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_4070":2422,"_34195":2418,"_5":34623,"_23354":64213,"_30763":64214,"_3518":64215},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_4070":2423,"_34195":2418,"_5":34623,"_23354":64217,"_30763":64218,"_3518":64219},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_4070":2424,"_34195":2418,"_5":34623,"_23354":64221,"_30763":64222,"_3518":64223},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_4070":2425,"_34195":2418,"_5":34623,"_23354":64225,"_30763":64226,"_3518":64227},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_4070":2426,"_34195":2418,"_5":34623,"_23354":64229,"_30763":64230,"_3518":64231},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_4070":2427,"_34195":2418,"_5":34623,"_23354":64233,"_30763":64234,"_3518":61836},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_4070":2428,"_34195":2418,"_5":34623,"_23354":64236,"_30763":64237,"_3518":56706},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#next-step",{"_4070":2429,"_34195":2418,"_23354":64239,"_5":16137,"_30763":2418,"_3518":64240},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_4070":2430,"_34195":2418,"_23354":64242,"_5":16137,"_30763":64207,"_3518":64243},[],"Console access and permission to create keys and authorities.",{"_4070":2431,"_34195":2418,"_23354":64245,"_5":16137,"_30763":64207,"_3518":64246},[],"An available cryptographic engine that supports the chosen algorithm.",{"_4070":2432,"_34195":2418,"_23354":64248,"_5":16137,"_30763":64207,"_3518":64249},[],"OpenSSL 3.x to check the downloaded certificate.",{"_4070":2433,"_34195":2418,"_23354":64251,"_5":16137,"_30763":64207,"_3518":64252},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_4070":2434,"_34195":2418,"_23354":64254,"_5":16137,"_30763":64210,"_3518":64255},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_4070":2435,"_34195":2418,"_23354":64257,"_5":16137,"_30763":64210,"_3518":64258},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_4070":2436,"_34195":2418,"_23354":64260,"_5":16137,"_30763":64214,"_3518":64261},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_4070":2437,"_34195":2418,"_23354":64263,"_5":16137,"_30763":64214,"_3518":64264},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_4070":2438,"_34195":2418,"_23354":64266,"_5":16137,"_30763":64218,"_3518":64267},[],"Select **Root CA** and complete:",{"_4070":2439,"_34195":2418,"_23354":64269,"_5":16137,"_30763":64218,"_3518":64270},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_4070":2440,"_34195":2418,"_23354":64272,"_5":16137,"_30763":64218,"_3518":64273},[],"**Subject**: organization and country details for your evaluation.",{"_4070":2441,"_34195":2418,"_23354":64275,"_5":16137,"_30763":64218,"_3518":64276},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_4070":2442,"_34195":2418,"_23354":64278,"_5":16137,"_30763":64218,"_3518":64279},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_4070":2443,"_34195":2418,"_23354":64281,"_5":16137,"_30763":64218,"_3518":64282},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_4070":2444,"_34195":2418,"_23354":64284,"_5":16137,"_30763":64222,"_3518":64285},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_4070":2445,"_34195":2418,"_23354":64287,"_5":16137,"_30763":64226,"_3518":64288},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_4070":2446,"_34195":2418,"_23354":64290,"_5":16137,"_30763":64226,"_3518":64291},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_4070":2447,"_34195":2418,"_23354":64293,"_5":16137,"_30763":64230,"_3518":64294},[],"Run from the directory where you saved `ca.pem`:",{"_4070":2448,"_34195":2418,"_23354":64296,"_5":16137,"_30763":64230,"_3518":64297},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_4070":2449,"_34195":2418,"_23354":64299,"_5":16137,"_30763":64230,"_3518":64300},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_4070":2450,"_34195":2418,"_23354":64302,"_5":16137,"_30763":64234,"_3518":64303},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_4070":2451,"_34195":2418,"_23354":64305,"_5":16137,"_30763":64234,"_3518":64306},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_4070":2452,"_34195":2418,"_23354":64308,"_5":16137,"_30763":64234,"_3518":64309},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_4070":2453,"_34195":2418,"_23354":64311,"_5":16137,"_30763":64234,"_3518":64312},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_4070":2454,"_34195":2418,"_23354":64314,"_5":16137,"_30763":64237,"_3518":64315},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_4070":2455,"_34195":2455,"_5":16540,"_3518":64317,"_34626":64318,"_23354":64319,"_30763":2455},"Issue and verify a certificate",[56672,58140,62142,61579],[],{"_4070":2456,"_34195":2455,"_23354":64321,"_5":16137,"_30763":2455,"_3518":64322},[],"Issue a client certificate and check content, chain and key correspondence.",{"_4070":2457,"_34195":2455,"_5":34623,"_23354":64324,"_30763":64325,"_3518":56682},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_4070":2458,"_34195":2455,"_5":34623,"_23354":64327,"_30763":64328,"_3518":64329},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_4070":2459,"_34195":2455,"_5":34623,"_23354":64331,"_30763":64332,"_3518":64333},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_4070":2460,"_34195":2455,"_5":34623,"_23354":64335,"_30763":64336,"_3518":64337},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_4070":2461,"_34195":2455,"_5":34623,"_23354":64339,"_30763":64340,"_3518":64341},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_4070":2462,"_34195":2455,"_5":34623,"_23354":64343,"_30763":64344,"_3518":64345},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_4070":2463,"_34195":2455,"_5":34623,"_23354":64347,"_30763":64348,"_3518":64349},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_4070":2464,"_34195":2455,"_5":34623,"_23354":64351,"_30763":64352,"_3518":64353},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_4070":2465,"_34195":2455,"_5":34623,"_23354":64355,"_30763":64356,"_3518":64357},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_4070":2466,"_34195":2455,"_5":34623,"_23354":64359,"_30763":64360,"_3518":64361},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_4070":2467,"_34195":2455,"_5":34623,"_23354":64363,"_30763":64364,"_3518":61836},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_4070":2468,"_34195":2455,"_5":34623,"_23354":64366,"_30763":64367,"_3518":56706},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#next-step",{"_4070":2469,"_34195":2455,"_23354":64369,"_5":16137,"_30763":2455,"_3518":64370},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_4070":2470,"_34195":2455,"_23354":64372,"_5":16137,"_30763":64325,"_3518":64373},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_4070":2471,"_34195":2455,"_23354":64375,"_5":16137,"_30763":64325,"_3518":64376},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_4070":2472,"_34195":2455,"_23354":64378,"_5":16137,"_30763":64325,"_3518":64379},[],"OpenSSL 3.x and a working directory with restricted access.",{"_4070":2473,"_34195":2455,"_23354":64381,"_5":16137,"_30763":64325,"_3518":64382},[],"A client identifier: here we use `device-001`.",{"_4070":2474,"_34195":2455,"_23354":64384,"_5":16137,"_30763":64325,"_3518":64385},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_4070":2475,"_34195":2455,"_23354":64387,"_5":16137,"_30763":64328,"_3518":64388},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_4070":2476,"_34195":2455,"_23354":64390,"_5":16137,"_30763":64332,"_3518":64391},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_4070":2477,"_34195":2455,"_23354":64393,"_5":16137,"_30763":64332,"_3518":64394},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_4070":2478,"_34195":2455,"_23354":64396,"_5":16137,"_30763":64336,"_3518":64397},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_4070":2479,"_34195":2455,"_23354":64399,"_5":16137,"_30763":64336,"_3518":64400},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_4070":2480,"_34195":2455,"_23354":64402,"_5":16137,"_30763":64340,"_3518":64403},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_4070":2481,"_34195":2455,"_23354":64405,"_5":16137,"_30763":64340,"_3518":64406},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_4070":2482,"_34195":2455,"_23354":64408,"_5":16137,"_30763":64344,"_3518":64409},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_4070":2483,"_34195":2455,"_23354":64411,"_5":16137,"_30763":64348,"_3518":64412},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_4070":2484,"_34195":2455,"_23354":64414,"_5":16137,"_30763":64352,"_3518":64415},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_4070":2485,"_34195":2455,"_23354":64417,"_5":16137,"_30763":64356,"_3518":64418},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_4070":2486,"_34195":2455,"_23354":64420,"_5":16137,"_30763":64356,"_3518":64421},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_4070":2487,"_34195":2455,"_23354":64423,"_5":16137,"_30763":64356,"_3518":64424},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_4070":2488,"_34195":2455,"_23354":64426,"_5":16137,"_30763":64360,"_3518":64427},[],"In Bash, compare the two public-key digests:",{"_4070":2489,"_34195":2455,"_23354":64429,"_5":16137,"_30763":64360,"_3518":64430},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_4070":2490,"_34195":2455,"_23354":64432,"_5":16137,"_30763":64360,"_3518":64433},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_4070":2491,"_34195":2455,"_23354":64435,"_5":16137,"_30763":64364,"_3518":61920},[],{"_4070":2492,"_34195":2455,"_23354":64437,"_5":16137,"_30763":64364,"_3518":64438},[],"What to review",{"_4070":2493,"_34195":2455,"_23354":64440,"_5":16137,"_30763":64364,"_3518":64441},[],"The CA rejects issuance",{"_4070":2494,"_34195":2455,"_23354":64443,"_5":16137,"_30763":64364,"_3518":64444},[],"Permissions, CA state and key, algorithm and profile.",{"_4070":2495,"_34195":2455,"_23354":64446,"_5":16137,"_30763":64364,"_3518":64447},[],"Different subject or usages",{"_4070":2496,"_34195":2455,"_23354":64449,"_5":16137,"_30763":64364,"_3518":64450},[],"Applied profile and requested values.",{"_4070":2497,"_34195":2455,"_23354":64452,"_5":16137,"_30763":64364,"_3518":64453},[],"Issuer cannot be found",{"_4070":2498,"_34195":2455,"_23354":64455,"_5":16137,"_30763":64364,"_3518":64456},[],"Downloaded CA and required intermediate chain.",{"_4070":2499,"_34195":2455,"_23354":64458,"_5":16137,"_30763":64364,"_3518":64459},[],"Validity fails",{"_4070":2500,"_34195":2455,"_23354":64461,"_5":16137,"_30763":64364,"_3518":64462},[],"Certificate and CA dates, and the computer's clock.",{"_4070":2501,"_34195":2455,"_23354":64464,"_5":16137,"_30763":64364,"_3518":64465},[],"Public-key digests differ",{"_4070":2502,"_34195":2455,"_23354":64467,"_5":16137,"_30763":64364,"_3518":64468},[],"Certificate and key files from the same issuance.",{"_4070":2503,"_34195":2455,"_23354":64470,"_5":16137,"_30763":64364,"_3518":64471},[],"See PKI diagnostics to narrow an issuance failure.",{"_4070":2504,"_34195":2455,"_23354":64473,"_5":16137,"_30763":64367,"_3518":64474},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_4070":2505,"_34195":2455,"_23354":64476,"_5":16137,"_30763":64367,"_3518":64477},[],"Manage certificates for inspection, status and revocation.",{"_4070":2506,"_34195":2455,"_23354":64479,"_5":16137,"_30763":64367,"_3518":64480},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_4070":2507,"_34195":2455,"_23354":64482,"_5":16137,"_30763":64367,"_3518":64483},[],"Prepare EST for the device to request its next identities.",{"_4070":2508,"_34195":2455,"_23354":64485,"_5":16137,"_30763":64367,"_3518":64486},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_4070":2509,"_34195":2509,"_5":16540,"_3518":64488,"_34626":64489,"_23354":64490,"_30763":2509},"PKI getting started",[56672,58140,62142,61579],[],{"_4070":2510,"_34195":2509,"_23354":64492,"_5":16137,"_30763":2509,"_3518":64493},[],"Create a CA, issue a client certificate and check its chain and key.",{"_4070":2511,"_34195":2509,"_5":34623,"_23354":64495,"_30763":64496,"_3518":56682},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/overview#before-you-begin",{"_4070":2512,"_34195":2509,"_5":34623,"_23354":64498,"_30763":64499,"_3518":64500},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_4070":2513,"_34195":2509,"_5":34623,"_23354":64502,"_30763":64503,"_3518":61771},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/overview#expected-result",{"_4070":2514,"_34195":2509,"_5":34623,"_23354":64505,"_30763":64506,"_3518":64507},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_4070":2515,"_34195":2509,"_23354":64509,"_5":16137,"_30763":2509,"_3518":64510},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_4070":2516,"_34195":2509,"_23354":64512,"_5":16137,"_30763":64496,"_3518":64513},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_4070":2517,"_34195":2509,"_23354":64515,"_5":16137,"_30763":64496,"_3518":64516},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_4070":2518,"_34195":2509,"_23354":64518,"_5":16137,"_30763":64496,"_3518":64519},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_4070":2519,"_34195":2509,"_23354":64521,"_5":16137,"_30763":64496,"_3518":64522},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_4070":2520,"_34195":2509,"_23354":64524,"_5":16137,"_30763":64496,"_3518":64525},[],"A working directory with restricted access for the downloaded key.",{"_4070":2521,"_34195":2509,"_23354":64527,"_5":16137,"_30763":64499,"_3518":64528},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_4070":2522,"_34195":2509,"_23354":64530,"_5":16137,"_30763":64499,"_3518":64531},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_4070":2523,"_34195":2509,"_23354":64533,"_5":16137,"_30763":64499,"_3518":64534},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_4070":2524,"_34195":2509,"_23354":64536,"_5":16137,"_30763":64499,"_3518":64537},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_4070":2525,"_34195":2509,"_23354":64539,"_5":16137,"_30763":64503,"_3518":64540},[],"File or resource",{"_4070":2526,"_34195":2509,"_23354":64542,"_5":16137,"_30763":64503,"_3518":61768},[],{"_4070":2527,"_34195":2509,"_23354":64544,"_5":16137,"_30763":64503,"_3518":64545},[],"Active root CA and `ca.pem`",{"_4070":2528,"_34195":2509,"_23354":64547,"_5":16137,"_30763":64503,"_3518":64548},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_4070":2529,"_34195":2509,"_23354":64550,"_5":16137,"_30763":64503,"_3518":64551},[],"End-entity certificate and `device.crt`",{"_4070":2530,"_34195":2509,"_23354":64553,"_5":16137,"_30763":64503,"_3518":64554},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_4070":2531,"_34195":2509,"_23354":64556,"_5":16137,"_30763":64503,"_3518":64557},[],"Private key `device.key`",{"_4070":2532,"_34195":2509,"_23354":64559,"_5":16137,"_30763":64503,"_3518":64560},[],"Its public key matches the one included in `device.crt`.",{"_4070":2533,"_34195":2509,"_23354":64562,"_5":16137,"_30763":64503,"_3518":64563},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_4070":2534,"_34195":2509,"_23354":64565,"_5":16137,"_30763":64506,"_3518":64566},[],"To operate certificates, continue with Certificates and Validation.",{"_4070":2535,"_34195":2509,"_23354":64568,"_5":16137,"_30763":64506,"_3518":64569},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_4070":2536,"_34195":2509,"_23354":64571,"_5":16137,"_30763":64506,"_3518":64572},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_4070":2537,"_34195":2537,"_5":16540,"_3518":64574,"_34626":64575,"_23354":64576,"_30763":2537},"PKI troubleshooting",[56672,58140,62142,60717],[],{"_4070":2538,"_34195":2537,"_23354":64578,"_5":16137,"_30763":2537,"_3518":64579},[],"Diagnose certificate issuance, OCSP and CRL.",{"_4070":2539,"_34195":2537,"_5":34623,"_23354":64581,"_30763":64582,"_3518":64583},[],"/docs/pr-preview/pr-58/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_4070":2540,"_34195":2537,"_5":34623,"_23354":64585,"_30763":64586,"_3518":64587},[],"/docs/pr-preview/pr-58/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_4070":2541,"_34195":2537,"_5":34623,"_23354":64589,"_30763":64590,"_3518":64591},[],"/docs/pr-preview/pr-58/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_4070":2542,"_34195":2537,"_23354":64593,"_5":16137,"_30763":2537,"_3518":64594},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_4070":2543,"_34195":2537,"_23354":64596,"_5":16137,"_30763":2537,"_3518":64597},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_4070":2544,"_34195":2537,"_23354":64599,"_5":16137,"_30763":64582,"_3518":61768},[],{"_4070":2545,"_34195":2537,"_23354":64601,"_5":16137,"_30763":64582,"_3518":64602},[],"What to inspect",{"_4070":2546,"_34195":2537,"_23354":64604,"_5":16137,"_30763":64582,"_3518":56706},[],{"_4070":2547,"_34195":2537,"_23354":64606,"_5":16137,"_30763":64582,"_3518":60984},[],{"_4070":2548,"_34195":2537,"_23354":64608,"_5":16137,"_30763":64582,"_3518":64609},[],"Exists, is active and has usable dates.",{"_4070":2549,"_34195":2537,"_23354":64611,"_5":16137,"_30763":64582,"_3518":64612},[],"Authorities.",{"_4070":2550,"_34195":2537,"_23354":64614,"_5":16137,"_30763":64582,"_3518":64615},[],"Key",{"_4070":2551,"_34195":2537,"_23354":64617,"_5":16137,"_30763":64582,"_3518":64618},[],"The record has a usable private key and the engine can sign.",{"_4070":2552,"_34195":2537,"_23354":64620,"_5":16137,"_30763":64582,"_3518":64621},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_4070":2553,"_34195":2537,"_23354":64623,"_5":16137,"_30763":64582,"_3518":64624},[],"CSR",{"_4070":2554,"_34195":2537,"_23354":64626,"_5":16137,"_30763":64582,"_3518":64627},[],"Correct PEM and verifiable signature.",{"_4070":2555,"_34195":2537,"_23354":64629,"_5":16137,"_30763":64582,"_3518":64630},[],"`openssl req -in request.csr -noout -verify -text`.",{"_4070":2556,"_34195":2537,"_23354":64632,"_5":16137,"_30763":64582,"_3518":64633},[],"Profile",{"_4070":2557,"_34195":2537,"_23354":64635,"_5":16137,"_30763":64582,"_3518":64636},[],"Selected source, existing ID, allowed algorithm and size.",{"_4070":2558,"_34195":2537,"_23354":64638,"_5":16137,"_30763":64582,"_3518":64639},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_4070":2559,"_34195":2537,"_23354":64641,"_5":16137,"_30763":64582,"_3518":61920},[],{"_4070":2560,"_34195":2537,"_23354":64643,"_5":16137,"_30763":64582,"_3518":64644},[],"Appropriate subject, SAN, usages and dates.",{"_4070":2561,"_34195":2537,"_23354":64646,"_5":16137,"_30763":64582,"_3518":64647},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_4070":2562,"_34195":2537,"_23354":64649,"_5":16137,"_30763":64582,"_3518":64650},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_4070":2563,"_34195":2537,"_23354":64652,"_5":16137,"_30763":64582,"_3518":64653},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_4070":2564,"_34195":2537,"_23354":64655,"_5":16137,"_30763":64586,"_3518":64656},[],"Check each boundary independently:",{"_4070":2565,"_34195":2537,"_23354":64658,"_5":16137,"_30763":64586,"_3518":64659},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_4070":2566,"_34195":2537,"_23354":64661,"_5":16137,"_30763":64586,"_3518":64662},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_4070":2567,"_34195":2537,"_23354":64664,"_5":16137,"_30763":64586,"_3518":64665},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_4070":2568,"_34195":2537,"_23354":64667,"_5":16137,"_30763":64586,"_3518":64668},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_4070":2569,"_34195":2537,"_23354":64670,"_5":16137,"_30763":64586,"_3518":64671},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_4070":2570,"_34195":2537,"_23354":64673,"_5":16137,"_30763":64586,"_3518":64674},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_4070":2571,"_34195":2537,"_23354":64676,"_5":16137,"_30763":64590,"_3518":64677},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_4070":2572,"_34195":2537,"_23354":64679,"_5":16137,"_30763":64590,"_3518":64680},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_4070":2573,"_34195":2573,"_5":16540,"_3518":64682,"_34626":64683,"_23354":64686,"_30763":2573},"Algorithms",[56672,58140,64684,64685],"[Beta] Post-quantum (PQC)","Algorithms and toolchain",[],{"_4070":2574,"_34195":2573,"_23354":64688,"_5":16137,"_30763":2573,"_3518":64689},[],"The post-quantum and composite signature algorithms Lamassu supports, how each is identified in API requests, and the standards they follow.",{"_4070":2575,"_34195":2573,"_5":34623,"_23354":64691,"_30763":64692,"_3518":64693},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#how-an-algorithm-is-selected","How an algorithm is selected",{"_4070":2576,"_34195":2573,"_5":34623,"_23354":64695,"_30763":64696,"_3518":64697},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#ml-dsa","ML-DSA",{"_4070":2577,"_34195":2573,"_5":34623,"_23354":64699,"_30763":64700,"_3518":64701},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#slh-dsa","SLH-DSA",{"_4070":2578,"_34195":2573,"_5":34623,"_23354":64703,"_30763":64704,"_3518":64705},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#composite-ml-dsa","Composite ML-DSA",{"_4070":2579,"_34195":2573,"_5":34623,"_23354":64707,"_30763":64708,"_3518":64709},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#ed25519","Ed25519",{"_4070":2580,"_34195":2573,"_5":34623,"_23354":64711,"_30763":64712,"_3518":64713},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#choosing-an-algorithm","Choosing an algorithm",{"_4070":2581,"_34195":2573,"_5":34623,"_23354":64715,"_30763":64716,"_3518":64717},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#what-is-not-covered","What is not covered",{"_4070":2582,"_34195":2573,"_23354":64719,"_5":16137,"_30763":2573,"_3518":64720},[],"Lamassu supports four groups of signature algorithms beyond RSA and ECDSA: ML-DSA, SLH-DSA, composite ML-DSA and Ed25519. All of them come from the Go PQC toolchain; the backend only selects the algorithm and delegates the cryptography.",{"_4070":2583,"_34195":2573,"_23354":64722,"_5":16137,"_30763":64692,"_3518":64723},[],"A key or CA is created with a key type and a size. For RSA and ECDSA the size is a bit length or a curve. For the post-quantum algorithms the same field carries a **parameter set identifier**, not a number of bits:",{"_4070":2584,"_34195":2573,"_23354":64725,"_5":16137,"_30763":64692,"_3518":64726},[],"Key type (`algorithm` / `type`)",{"_4070":2585,"_34195":2573,"_23354":64728,"_5":16137,"_30763":64692,"_3518":64729},[],"Value of `size` / `bits`",{"_4070":2586,"_34195":2573,"_23354":64731,"_5":16137,"_30763":64692,"_3518":59211},[],{"_4070":2587,"_34195":2573,"_23354":64733,"_5":16137,"_30763":64692,"_3518":64734},[],"`RSA`",{"_4070":2588,"_34195":2573,"_23354":64736,"_5":16137,"_30763":64692,"_3518":64737},[],"2048, 3072, 4096",{"_4070":2589,"_34195":2573,"_23354":64739,"_5":16137,"_30763":64692,"_3518":64740},[],"Modulus length in bits.",{"_4070":2590,"_34195":2573,"_23354":64742,"_5":16137,"_30763":64692,"_3518":64743},[],"`ECDSA`",{"_4070":2591,"_34195":2573,"_23354":64745,"_5":16137,"_30763":64692,"_3518":64746},[],"256, 384, 521",{"_4070":2592,"_34195":2573,"_23354":64748,"_5":16137,"_30763":64692,"_3518":64749},[],"Curve size in bits (P-256, P-384, P-521).",{"_4070":2593,"_34195":2573,"_23354":64751,"_5":16137,"_30763":64692,"_3518":64752},[],"`Ed25519`",{"_4070":2594,"_34195":2573,"_23354":64754,"_5":16137,"_30763":64692,"_3518":11816},[],{"_4070":2595,"_34195":2573,"_23354":64756,"_5":16137,"_30763":64692,"_3518":64757},[],"Fixed. Any other value is replaced by 256.",{"_4070":2596,"_34195":2573,"_23354":64759,"_5":16137,"_30763":64692,"_3518":64760},[],"`ML-DSA`",{"_4070":2597,"_34195":2573,"_23354":64762,"_5":16137,"_30763":64692,"_3518":64763},[],"44, 65, 87",{"_4070":2598,"_34195":2573,"_23354":64765,"_5":16137,"_30763":64692,"_3518":64766},[],"ML-DSA parameter set.",{"_4070":2599,"_34195":2573,"_23354":64768,"_5":16137,"_30763":64692,"_3518":64769},[],"`SLH-DSA`",{"_4070":2600,"_34195":2573,"_23354":64771,"_5":16137,"_30763":64692,"_3518":64772},[],"1 to 12",{"_4070":2601,"_34195":2573,"_23354":64774,"_5":16137,"_30763":64692,"_3518":64775},[],"SLH-DSA parameter set, in the order below.",{"_4070":2602,"_34195":2573,"_23354":64777,"_5":16137,"_30763":64692,"_3518":64778},[],"`Composite-ML-DSA-RSA`",{"_4070":2603,"_34195":2573,"_23354":64780,"_5":16137,"_30763":64692,"_3518":64781},[],"1 to 8",{"_4070":2604,"_34195":2573,"_23354":64783,"_5":16137,"_30763":64692,"_3518":64784},[],"Composite variant with an RSA component.",{"_4070":2605,"_34195":2573,"_23354":64786,"_5":16137,"_30763":64692,"_3518":64787},[],"`Composite-ML-DSA-ECDSA`",{"_4070":2606,"_34195":2573,"_23354":64789,"_5":16137,"_30763":64692,"_3518":64790},[],"9 to 13",{"_4070":2607,"_34195":2573,"_23354":64792,"_5":16137,"_30763":64692,"_3518":64793},[],"Composite variant with an ECDSA component.",{"_4070":2608,"_34195":2573,"_23354":64795,"_5":16137,"_30763":64692,"_3518":64796},[],"`Composite-ML-DSA-Ed25519`",{"_4070":2609,"_34195":2573,"_23354":64798,"_5":16137,"_30763":64692,"_3518":64799},[],"14 and 15",{"_4070":2610,"_34195":2573,"_23354":64801,"_5":16137,"_30763":64692,"_3518":64802},[],"Composite variant with an Ed25519 component.",{"_4070":2611,"_34195":2573,"_23354":64804,"_5":16137,"_30763":64692,"_3518":64805},[],"An unknown key type string is not rejected when it is parsed; it becomes an unknown type and fails later. Use the exact strings above.",{"_4070":2612,"_34195":2573,"_23354":64807,"_5":16137,"_30763":64696,"_3518":64808},[],"ML-DSA is the lattice-based signature scheme standardized in FIPS 204. Lamassu accepts the three parameter sets ML-DSA-44, ML-DSA-65 and ML-DSA-87, selected with `size` 44, 65 or 87. The implementation is the `crypto/mldsa` package of Go 1.27, so it is the standard library's own code and not part of the fork. In certificates the algorithm identifiers are `2.16.840.1.101.3.4.3.17`, `.18` and `.19` for ML-DSA-44, -65 and -87.",{"_4070":2613,"_34195":2573,"_23354":64810,"_5":16137,"_30763":64696,"_3518":64811},[],"Parameter set",{"_4070":2614,"_34195":2573,"_23354":64813,"_5":16137,"_30763":64696,"_3518":64814},[],"NIST security category",{"_4070":2615,"_34195":2573,"_23354":64816,"_5":16137,"_30763":64696,"_3518":64817},[],"ML-DSA-44",{"_4070":2616,"_34195":2573,"_23354":64819,"_5":16137,"_30763":64696,"_3518":11758},[],{"_4070":2617,"_34195":2573,"_23354":64821,"_5":16137,"_30763":64696,"_3518":64822},[],"ML-DSA-65",{"_4070":2618,"_34195":2573,"_23354":64824,"_5":16137,"_30763":64696,"_3518":11695},[],{"_4070":2619,"_34195":2573,"_23354":64826,"_5":16137,"_30763":64696,"_3518":64827},[],"ML-DSA-87",{"_4070":2620,"_34195":2573,"_23354":64829,"_5":16137,"_30763":64696,"_3518":11887},[],{"_4070":2621,"_34195":2573,"_23354":64831,"_5":16137,"_30763":64696,"_3518":64832},[],"A higher category means larger keys and signatures in exchange for more security margin.",{"_4070":2622,"_34195":2573,"_23354":64834,"_5":16137,"_30763":64696,"_3518":64835},[],"Go reads ML-DSA private keys in PKCS#8 only when they contain the 32-byte seed. Keys written by OpenSSL in its default seed-plus-expanded form are rejected, so export them in the seed-only form before importing them.",{"_4070":2623,"_34195":2573,"_23354":64837,"_5":16137,"_30763":64700,"_3518":64838},[],"SLH-DSA is the hash-based scheme of FIPS 205. It offers twelve parameter sets that combine a hash family (SHA-2 or SHAKE), the parameter n of 128, 192 or 256 bits, which corresponds to NIST security categories 1, 3 and 5 and a trade-off between signature size and signing speed (`s` for small signatures, `f` for fast signing). The identifier written in `size` follows the order of the underlying library:",{"_4070":2624,"_34195":2573,"_23354":64840,"_5":16137,"_30763":64700,"_3518":64841},[],"ID",{"_4070":2625,"_34195":2573,"_23354":64843,"_5":16137,"_30763":64700,"_3518":64811},[],{"_4070":2626,"_34195":2573,"_23354":64845,"_5":16137,"_30763":64700,"_3518":64841},[],{"_4070":2627,"_34195":2573,"_23354":64847,"_5":16137,"_30763":64700,"_3518":64811},[],{"_4070":2628,"_34195":2573,"_23354":64849,"_5":16137,"_30763":64700,"_3518":11597},[],{"_4070":2629,"_34195":2573,"_23354":64851,"_5":16137,"_30763":64700,"_3518":64852},[],"SLH-DSA-SHA2-128s",{"_4070":2630,"_34195":2573,"_23354":64854,"_5":16137,"_30763":64700,"_3518":11588},[],{"_4070":2631,"_34195":2573,"_23354":64856,"_5":16137,"_30763":64700,"_3518":64857},[],"SLH-DSA-SHA2-192f",{"_4070":2632,"_34195":2573,"_23354":64859,"_5":16137,"_30763":64700,"_3518":11758},[],{"_4070":2633,"_34195":2573,"_23354":64861,"_5":16137,"_30763":64700,"_3518":64862},[],"SLH-DSA-SHAKE-128s",{"_4070":2634,"_34195":2573,"_23354":64864,"_5":16137,"_30763":64700,"_3518":11569},[],{"_4070":2635,"_34195":2573,"_23354":64866,"_5":16137,"_30763":64700,"_3518":64867},[],"SLH-DSA-SHAKE-192f",{"_4070":2636,"_34195":2573,"_23354":64869,"_5":16137,"_30763":64700,"_3518":11695},[],{"_4070":2637,"_34195":2573,"_23354":64871,"_5":16137,"_30763":64700,"_3518":64872},[],"SLH-DSA-SHA2-128f",{"_4070":2638,"_34195":2573,"_23354":64874,"_5":16137,"_30763":64700,"_3518":29359},[],{"_4070":2639,"_34195":2573,"_23354":64876,"_5":16137,"_30763":64700,"_3518":64877},[],"SLH-DSA-SHA2-256s",{"_4070":2640,"_34195":2573,"_23354":64879,"_5":16137,"_30763":64700,"_3518":11548},[],{"_4070":2641,"_34195":2573,"_23354":64881,"_5":16137,"_30763":64700,"_3518":64882},[],"SLH-DSA-SHAKE-128f",{"_4070":2642,"_34195":2573,"_23354":64884,"_5":16137,"_30763":64700,"_3518":33244},[],{"_4070":2643,"_34195":2573,"_23354":64886,"_5":16137,"_30763":64700,"_3518":64887},[],"SLH-DSA-SHAKE-256s",{"_4070":2644,"_34195":2573,"_23354":64889,"_5":16137,"_30763":64700,"_3518":11887},[],{"_4070":2645,"_34195":2573,"_23354":64891,"_5":16137,"_30763":64700,"_3518":64892},[],"SLH-DSA-SHA2-192s",{"_4070":2646,"_34195":2573,"_23354":64894,"_5":16137,"_30763":64700,"_3518":33278},[],{"_4070":2647,"_34195":2573,"_23354":64896,"_5":16137,"_30763":64700,"_3518":64897},[],"SLH-DSA-SHA2-256f",{"_4070":2648,"_34195":2573,"_23354":64899,"_5":16137,"_30763":64700,"_3518":11557},[],{"_4070":2649,"_34195":2573,"_23354":64901,"_5":16137,"_30763":64700,"_3518":64902},[],"SLH-DSA-SHAKE-192s",{"_4070":2650,"_34195":2573,"_23354":64904,"_5":16137,"_30763":64700,"_3518":32740},[],{"_4070":2651,"_34195":2573,"_23354":64906,"_5":16137,"_30763":64700,"_3518":64907},[],"SLH-DSA-SHAKE-256f",{"_4070":2652,"_34195":2573,"_23354":64909,"_5":16137,"_30763":64700,"_3518":64910},[],"The SLH-DSA implementation is provided by Cloudflare's CIRCL library, which the fork integrates so that SLH-DSA keys can be used in X.509 certificates. The object identifiers run from `2.16.840.1.101.3.4.3.20` to `.31`. SLH-DSA signatures are large, between about 8 and 50 KB depending on the parameter set, which matters for certificate chains and for any transport with a size limit. SLH-DSA is available for keys, CAs and certificates, but the fork has no TLS signature scheme for it, so an SLH-DSA certificate cannot authenticate a TLS connection.",{"_4070":2653,"_34195":2573,"_23354":64912,"_5":16137,"_30763":64704,"_3518":64913},[],"A composite key pairs an ML-DSA key with a traditional key. A composite signature is the concatenation of the ML-DSA signature and the traditional signature, both computed over a message representative that contains a fixed prefix, an algorithm label, an optional context and a hash of the message; verification fails if either component fails. The ML-DSA component is pure ML-DSA, with the label as its context. Lamassu implements the 15 algorithms of RFC 10073 that rely only on algorithms available in Go. The identifiers sit under the arc `1.3.6.1.5.5.7.6`.",{"_4070":2654,"_34195":2573,"_23354":64915,"_5":16137,"_30763":64704,"_3518":64916},[],"`size`",{"_4070":2655,"_34195":2573,"_23354":64918,"_5":16137,"_30763":64704,"_3518":64919},[],"Algorithm",{"_4070":2656,"_34195":2573,"_23354":64921,"_5":16137,"_30763":64704,"_3518":64922},[],"Final OID digit",{"_4070":2657,"_34195":2573,"_23354":64924,"_5":16137,"_30763":64704,"_3518":64925},[],"Family",{"_4070":2658,"_34195":2573,"_23354":64927,"_5":16137,"_30763":64704,"_3518":11597},[],{"_4070":2659,"_34195":2573,"_23354":64929,"_5":16137,"_30763":64704,"_3518":64930},[],"MLDSA44-RSA2048-PSS-SHA256",{"_4070":2660,"_34195":2573,"_23354":64932,"_5":16137,"_30763":64704,"_3518":34069},[],{"_4070":2661,"_34195":2573,"_23354":64934,"_5":16137,"_30763":64704,"_3518":64935},[],"RSA",{"_4070":2662,"_34195":2573,"_23354":64937,"_5":16137,"_30763":64704,"_3518":11758},[],{"_4070":2663,"_34195":2573,"_23354":64939,"_5":16137,"_30763":64704,"_3518":64940},[],"MLDSA44-RSA2048-PKCS15-SHA256",{"_4070":2664,"_34195":2573,"_23354":64942,"_5":16137,"_30763":64704,"_3518":34042},[],{"_4070":2665,"_34195":2573,"_23354":64944,"_5":16137,"_30763":64704,"_3518":64935},[],{"_4070":2666,"_34195":2573,"_23354":64946,"_5":16137,"_30763":64704,"_3518":11695},[],{"_4070":2667,"_34195":2573,"_23354":64948,"_5":16137,"_30763":64704,"_3518":64949},[],"MLDSA65-RSA3072-PSS-SHA512",{"_4070":2668,"_34195":2573,"_23354":64951,"_5":16137,"_30763":64704,"_3518":32857},[],{"_4070":2669,"_34195":2573,"_23354":64953,"_5":16137,"_30763":64704,"_3518":64935},[],{"_4070":2670,"_34195":2573,"_23354":64955,"_5":16137,"_30763":64704,"_3518":11548},[],{"_4070":2671,"_34195":2573,"_23354":64957,"_5":16137,"_30763":64704,"_3518":64958},[],"MLDSA65-RSA3072-PKCS15-SHA512",{"_4070":2672,"_34195":2573,"_23354":64960,"_5":16137,"_30763":64704,"_3518":32863},[],{"_4070":2673,"_34195":2573,"_23354":64962,"_5":16137,"_30763":64704,"_3518":64935},[],{"_4070":2674,"_34195":2573,"_23354":64964,"_5":16137,"_30763":64704,"_3518":11887},[],{"_4070":2675,"_34195":2573,"_23354":64966,"_5":16137,"_30763":64704,"_3518":64967},[],"MLDSA65-RSA4096-PSS-SHA512",{"_4070":2676,"_34195":2573,"_23354":64969,"_5":16137,"_30763":64704,"_3518":32869},[],{"_4070":2677,"_34195":2573,"_23354":64971,"_5":16137,"_30763":64704,"_3518":64935},[],{"_4070":2678,"_34195":2573,"_23354":64973,"_5":16137,"_30763":64704,"_3518":11557},[],{"_4070":2679,"_34195":2573,"_23354":64975,"_5":16137,"_30763":64704,"_3518":64976},[],"MLDSA65-RSA4096-PKCS15-SHA512",{"_4070":2680,"_34195":2573,"_23354":64978,"_5":16137,"_30763":64704,"_3518":11551},[],{"_4070":2681,"_34195":2573,"_23354":64980,"_5":16137,"_30763":64704,"_3518":64935},[],{"_4070":2682,"_34195":2573,"_23354":64982,"_5":16137,"_30763":64704,"_3518":11588},[],{"_4070":2683,"_34195":2573,"_23354":64984,"_5":16137,"_30763":64704,"_3518":64985},[],"MLDSA87-RSA3072-PSS-SHA512",{"_4070":2684,"_34195":2573,"_23354":64987,"_5":16137,"_30763":64704,"_3518":32745},[],{"_4070":2685,"_34195":2573,"_23354":64989,"_5":16137,"_30763":64704,"_3518":64935},[],{"_4070":2686,"_34195":2573,"_23354":64991,"_5":16137,"_30763":64704,"_3518":11569},[],{"_4070":2687,"_34195":2573,"_23354":64993,"_5":16137,"_30763":64704,"_3518":64994},[],"MLDSA87-RSA4096-PSS-SHA512",{"_4070":2688,"_34195":2573,"_23354":64996,"_5":16137,"_30763":64704,"_3518":32767},[],{"_4070":2689,"_34195":2573,"_23354":64998,"_5":16137,"_30763":64704,"_3518":64935},[],{"_4070":2690,"_34195":2573,"_23354":65000,"_5":16137,"_30763":64704,"_3518":29359},[],{"_4070":2691,"_34195":2573,"_23354":65002,"_5":16137,"_30763":64704,"_3518":65003},[],"MLDSA44-ECDSA-P256-SHA256",{"_4070":2692,"_34195":2573,"_23354":65005,"_5":16137,"_30763":64704,"_3518":32809},[],{"_4070":2693,"_34195":2573,"_23354":65007,"_5":16137,"_30763":64704,"_3518":65008},[],"ECDSA",{"_4070":2694,"_34195":2573,"_23354":65010,"_5":16137,"_30763":64704,"_3518":33244},[],{"_4070":2695,"_34195":2573,"_23354":65012,"_5":16137,"_30763":64704,"_3518":65013},[],"MLDSA65-ECDSA-P256-SHA512",{"_4070":2696,"_34195":2573,"_23354":65015,"_5":16137,"_30763":64704,"_3518":32875},[],{"_4070":2697,"_34195":2573,"_23354":65017,"_5":16137,"_30763":64704,"_3518":65008},[],{"_4070":2698,"_34195":2573,"_23354":65019,"_5":16137,"_30763":64704,"_3518":33278},[],{"_4070":2699,"_34195":2573,"_23354":65021,"_5":16137,"_30763":64704,"_3518":65022},[],"MLDSA65-ECDSA-P384-SHA512",{"_4070":2700,"_34195":2573,"_23354":65024,"_5":16137,"_30763":64704,"_3518":32881},[],{"_4070":2701,"_34195":2573,"_23354":65026,"_5":16137,"_30763":64704,"_3518":65008},[],{"_4070":2702,"_34195":2573,"_23354":65028,"_5":16137,"_30763":64704,"_3518":32740},[],{"_4070":2703,"_34195":2573,"_23354":65030,"_5":16137,"_30763":64704,"_3518":65031},[],"MLDSA87-ECDSA-P384-SHA512",{"_4070":2704,"_34195":2573,"_23354":65033,"_5":16137,"_30763":64704,"_3518":32887},[],{"_4070":2705,"_34195":2573,"_23354":65035,"_5":16137,"_30763":64704,"_3518":65008},[],{"_4070":2706,"_34195":2573,"_23354":65037,"_5":16137,"_30763":64704,"_3518":33344},[],{"_4070":2707,"_34195":2573,"_23354":65039,"_5":16137,"_30763":64704,"_3518":65040},[],"MLDSA87-ECDSA-P521-SHA512",{"_4070":2708,"_34195":2573,"_23354":65042,"_5":16137,"_30763":64704,"_3518":32773},[],{"_4070":2709,"_34195":2573,"_23354":65044,"_5":16137,"_30763":64704,"_3518":65008},[],{"_4070":2710,"_34195":2573,"_23354":65046,"_5":16137,"_30763":64704,"_3518":32927},[],{"_4070":2711,"_34195":2573,"_23354":65048,"_5":16137,"_30763":64704,"_3518":65049},[],"MLDSA44-Ed25519-SHA512",{"_4070":2712,"_34195":2573,"_23354":65051,"_5":16137,"_30763":64704,"_3518":34075},[],{"_4070":2713,"_34195":2573,"_23354":65053,"_5":16137,"_30763":64704,"_3518":64709},[],{"_4070":2714,"_34195":2573,"_23354":65055,"_5":16137,"_30763":64704,"_3518":33350},[],{"_4070":2715,"_34195":2573,"_23354":65057,"_5":16137,"_30763":64704,"_3518":65058},[],"MLDSA65-Ed25519-SHA512",{"_4070":2716,"_34195":2573,"_23354":65060,"_5":16137,"_30763":64704,"_3518":32851},[],{"_4070":2717,"_34195":2573,"_23354":65062,"_5":16137,"_30763":64704,"_3518":64709},[],{"_4070":2718,"_34195":2573,"_23354":65064,"_5":16137,"_30763":64704,"_3518":65065},[],"The key type must match the family of the variant: creating a `Composite-ML-DSA-ECDSA` key with `size` 3 fails with an error saying that the variant is not valid for that key type.",{"_4070":2719,"_34195":2573,"_23354":65067,"_5":16137,"_30763":64704,"_3518":65068},[],"The implementation was written against draft 19 of the specification, which was later published as RFC 10073, and has been checked against the published text. The object identifiers, the domain separator prefix, the hash used for each ECDSA component and the RFC 5915 encoding of ECDSA private keys match the RFC. Three algorithms of the specification are not implemented because Go has no Brainpool curves and no Ed448: the two Brainpool variants (`MLDSA65-ECDSA-brainpoolP256r1` and `MLDSA87-ECDSA-brainpoolP384r1`, with their hash suffix) and the Ed448 variant. The fork passes the test vectors of RFC 10073 Appendix E for the 15 algorithms it does implement, including the signatures with and without context. These checks cover the vectors and the points listed above; they are not a full conformance assessment.",{"_4070":2720,"_34195":2573,"_23354":65070,"_5":16137,"_30763":64704,"_3518":65071},[],"The composite parameters of keys and signatures must be absent from the `AlgorithmIdentifier`; certificates that carry them are rejected. ECDSA components must use a private scalar of the exact length of the curve.",{"_4070":2721,"_34195":2573,"_23354":65073,"_5":16137,"_30763":64708,"_3518":65074},[],"Ed25519 is not post-quantum, but support for it as a CA and certificate key type was added in the same work and is selected with the `Ed25519` key type. It is classified in the traditional family.",{"_4070":2722,"_34195":2573,"_23354":65076,"_5":16137,"_30763":64712,"_3518":65077},[],"**Composite ML-DSA** is the most conservative option during the transition, because the signature stays valid only if both components verify and so keeps classical protection if a flaw is found in the new algorithm. Keys and signatures are larger than classical ones.",{"_4070":2723,"_34195":2573,"_23354":65079,"_5":16137,"_30763":64712,"_3518":65080},[],"**ML-DSA** alone gives post-quantum protection with moderate sizes and fast operations.",{"_4070":2724,"_34195":2573,"_23354":65082,"_5":16137,"_30763":64712,"_3518":65083},[],"**SLH-DSA** suits long-lived trust anchors where relying only on hash functions is valued. Signatures are considerably larger, and it cannot authenticate TLS connections.",{"_4070":2725,"_34195":2573,"_23354":65085,"_5":16137,"_30763":64712,"_3518":65086},[],"**Ed25519** is not post-quantum; use it only where a classical algorithm is acceptable.",{"_4070":2726,"_34195":2573,"_23354":65088,"_5":16137,"_30763":64716,"_3518":65089},[],"Lamassu does not implement post-quantum key exchange of its own. The hybrid key exchanges offered by the TLS endpoint, such as `X25519MLKEM768`, are those of the Go 1.27 standard library. The Chameleon and delta-certificate designs explored in earlier iterations were removed and are not part of the implementation.",{"_4070":2727,"_34195":2573,"_23354":65091,"_5":16137,"_30763":64716,"_3518":65092},[],"<Card title=\"Go PQC toolchain\" description=\"The fork that implements these algorithms and the API it adds.\" href=\"/docs/platform/pqc/go-toolchain\" />",{"_4070":2728,"_34195":2573,"_23354":65094,"_5":16137,"_30763":64716,"_3518":65095},[],"<Card title=\"Keys and certificate authorities\" description=\"Use these parameters in KMS and CA requests.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_4070":2729,"_34195":2729,"_5":16540,"_3518":65097,"_34626":65098,"_23354":65100,"_30763":2729},"Dashboard",[56672,58140,64684,65099],"Platform support",[],{"_4070":2730,"_34195":2729,"_23354":65102,"_5":16137,"_30763":2729,"_3518":65103},[],"How the web interface exposes post-quantum algorithms when creating keys, CAs and certificates, and how it displays them.",{"_4070":2731,"_34195":2729,"_5":34623,"_23354":65105,"_30763":65106,"_3518":65107},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#choosing-a-key-type-and-specification","Choosing a key type and specification",{"_4070":2732,"_34195":2729,"_5":34623,"_23354":65109,"_30763":65110,"_3518":65111},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#issuing-a-certificate-with-a-browser-generated-key","Issuing a certificate with a browser-generated key",{"_4070":2733,"_34195":2729,"_5":34623,"_23354":65113,"_30763":65114,"_3518":65115},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#how-objects-are-displayed","How objects are displayed",{"_4070":2734,"_34195":2729,"_5":34623,"_23354":65117,"_30763":65118,"_3518":65119},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#related-certificates","Related certificates",{"_4070":2735,"_34195":2729,"_5":34623,"_23354":65121,"_30763":65122,"_3518":65123},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#things-to-know","Things to know",{"_4070":2736,"_34195":2729,"_23354":65125,"_5":16137,"_30763":2729,"_3518":65126},[],"The dashboard (branch `feat/lamassu-q`) lets an administrator create and inspect post-quantum keys, certificate authorities and certificates without writing API requests. It adds the algorithm choices, shows the algorithm family of every object and parses the new identifiers in certificates. Everything it sends is described in Keys and certificate authorities; this page covers what the interface shows and where its behaviour differs between screens.",{"_4070":2737,"_34195":2729,"_23354":65128,"_5":16137,"_30763":65106,"_3518":65129},[],"Creating a KMS key, a CA with a new key and a certificate with a server-generated key all use the same pair of selectors. *Key type* is grouped by family and *Key specification* depends on the type.",{"_4070":2738,"_34195":2729,"_23354":65131,"_5":16137,"_30763":65106,"_3518":65132},[],"Group",{"_4070":2739,"_34195":2729,"_23354":65134,"_5":16137,"_30763":65106,"_3518":65135},[],"Key types",{"_4070":2740,"_34195":2729,"_23354":65137,"_5":16137,"_30763":65106,"_3518":65138},[],"T (Traditional)",{"_4070":2741,"_34195":2729,"_23354":65140,"_5":16137,"_30763":65106,"_3518":65141},[],"`RSA`, `ECDSA`, `Ed25519`",{"_4070":2742,"_34195":2729,"_23354":65143,"_5":16137,"_30763":65106,"_3518":65144},[],"PQ (Pure PQC)",{"_4070":2743,"_34195":2729,"_23354":65146,"_5":16137,"_30763":65106,"_3518":65147},[],"`ML-DSA`, `SLH-DSA`",{"_4070":2744,"_34195":2729,"_23354":65149,"_5":16137,"_30763":65106,"_3518":65150},[],"PQ/T (Hybrid)",{"_4070":2745,"_34195":2729,"_23354":65152,"_5":16137,"_30763":65106,"_3518":65153},[],"`Composite-ML-DSA-RSA`, `Composite-ML-DSA-ECDSA`, `Composite-ML-DSA-Ed25519`",{"_4070":2746,"_34195":2729,"_23354":65155,"_5":16137,"_30763":65106,"_3518":65156},[],"The specification list shows ML-DSA-44, -65 or -87, the twelve SLH-DSA parameter sets (for example *4 - SHAKE\\_128f*) or the composite variants by name. The interface sends the identifier of the parameter set as `size`, as explained in Algorithms, and shows a strength indicator next to each option. For composite keys the indicator shows two bars, one for the classical component and one for the post-quantum component.",{"_4070":2747,"_34195":2729,"_23354":65158,"_5":16137,"_30763":65106,"_3518":65159},[],"Which options are enabled depends on the crypto engine. When creating a key or a CA, the interface lists every algorithm but disables those that the selected engine does not support, and asks to select an engine first. When creating a certificate on the server, unsupported types are hidden instead.",{"_4070":2748,"_34195":2729,"_23354":65161,"_5":16137,"_30763":65110,"_3518":65162},[],"Issuing a certificate from a CA generates the key pair in the browser, builds the certificate request and sends it to the CA for signing. The key types offered here are `RSA`, `ECDSA`, `Ed25519`, `ML-DSA`, `SLH-DSA` and a single `Composite ML-DSA` entry, and they are generated in the browser: with the `@noble` libraries for ML-DSA and SLH-DSA and with WebCrypto for the classical algorithms.",{"_4070":2749,"_34195":2729,"_23354":65164,"_5":16137,"_30763":65110,"_3518":65165},[],"Composite key generation is not available in `@noble`. The Lamassu team implemented it for the dashboard, combining the ML-DSA key with an RSA, ECDSA or Ed25519 key and signing the composite message representative as the specification defines, so that a composite certificate request can be created entirely in the browser.",{"_4070":2750,"_34195":2729,"_23354":65167,"_5":16137,"_30763":65110,"_3518":65168},[],"The generated private key is shown once at the end of the procedure.",{"_4070":2751,"_34195":2729,"_23354":65170,"_5":16137,"_30763":65110,"_3518":65171},[],"The browser does not verify the signatures of ML-DSA, SLH-DSA, composite or Ed25519 requests; it relies on the KMS.",{"_4070":2752,"_34195":2729,"_23354":65173,"_5":16137,"_30763":65114,"_3518":65174},[],"Lists and detail views show the algorithm family. The CA table has a *PQC* column with T, PQ or PQ/T, CA cards and the CA graph show a *PQC* badge, key lists show a quantum icon, and the details of a CA or certificate show the algorithm, its strength and the family badge. The family is computed from the algorithm identifier in the parsed certificate.",{"_4070":2753,"_34195":2729,"_23354":65176,"_5":16137,"_30763":65114,"_3518":65177},[],"Algorithm names are resolved from the object identifiers. ML-DSA, SLH-DSA, composite and Ed25519 identifiers are shown as names with their parameter set, for example *ML-DSA-65* or *Composite-Signature MLDSA65-ECDSA-P384-SHA512*, and no bit length is shown for them. RSA and ECDSA signature algorithms are displayed with the dashboard's own labels, such as *RSA PKCS#1 v1.5 SHA-256* and *ECDSA SHA-256*, instead of the OpenSSL names `sha256WithRSAEncryption` and `ecdsa-with-SHA256`.",{"_4070":2754,"_34195":2729,"_23354":65179,"_5":16137,"_30763":65114,"_3518":65180},[],"The key detail page can sign and verify with a post-quantum key and enables only the signature algorithm that corresponds to it.",{"_4070":2755,"_34195":2729,"_23354":65182,"_5":16137,"_30763":65118,"_3518":65183},[],"The issuance profile form, the issue-certificate form and the detail pages include the related-certificate controls described in Related certificates.",{"_4070":2756,"_34195":2729,"_23354":65185,"_5":16137,"_30763":65122,"_3518":65186},[],"The key type names are not identical across all screens. Key and CA creation use `Composite-ML-DSA-RSA`, `-ECDSA` and `-Ed25519`; the issue-certificate form uses a single `Composite-ML-DSA`; and the server-side certificate form compares upper-case names. The names that the backend reports for a key may therefore differ in case from what the interface submits.",{"_4070":2757,"_34195":2729,"_23354":65188,"_5":16137,"_30763":65122,"_3518":65189},[],"The interface carries no experimental warning for these algorithms and has no translation: all texts are in English.",{"_4070":2758,"_34195":2729,"_23354":65191,"_5":16137,"_30763":65122,"_3518":65192},[],"The mapping from the SLH-DSA parameter set identifier to the algorithm used by the in-browser key generator does not follow the same order as the identifiers shown in the selector and used by the backend, except for identifier 1. A certificate issued through the browser flow with an SLH-DSA identifier from 2 to 12 may therefore use a different parameter set than the one named in the selector. Create SLH-DSA keys with the KMS until this is corrected.",{"_4070":2759,"_34195":2729,"_23354":65194,"_5":16137,"_30763":65122,"_3518":65195},[],"<Card title=\"Keys and certificate authorities\" description=\"The API behind these screens.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_4070":2760,"_34195":2729,"_23354":65197,"_5":16137,"_30763":65122,"_3518":65198},[],"<Card title=\"Known limitations\" description=\"Gaps in the interface and the platform.\" href=\"/docs/platform/pqc/limitations\" />",{"_4070":2761,"_34195":2761,"_5":16540,"_3518":65200,"_34626":65201,"_23354":65202,"_30763":2761},"Deployment with the Helm chart",[56672,58140,64684,56673],[],{"_4070":2762,"_34195":2761,"_23354":65204,"_5":16137,"_30763":2761,"_3518":65205},[],"Deploy Lamassu with a Traefik front proxy that serves classical, post-quantum and composite certificates, using the chart values or the fast-lane installer.",{"_4070":2763,"_34195":2761,"_5":34623,"_23354":65207,"_30763":65208,"_3518":65209},[],"/docs/pr-preview/pr-58/platform/pqc/deployment#topology","Topology",{"_4070":2764,"_34195":2761,"_5":34623,"_23354":65211,"_30763":65212,"_3518":65213},[],"/docs/pr-preview/pr-58/platform/pqc/deployment#chart-values","Chart values",{"_4070":2765,"_34195":2761,"_5":34623,"_23354":65215,"_30763":65216,"_3518":65217},[],"/docs/pr-preview/pr-58/platform/pqc/deployment#the-fast-lane-installer","The fast-lane installer",{"_4070":2766,"_34195":2761,"_23354":65219,"_5":16137,"_30763":2761,"_3518":65220},[],"The `pqc` branch of the Lamassu Helm chart adds a front proxy: a Traefik instance built with the Go PQC toolchain that terminates the devices' TLS, authenticates them and forwards the traffic to Envoy Gateway. This page describes the resulting topology, the values that control it and the installer that automates a laboratory deployment.",{"_4070":2767,"_34195":2761,"_23354":65222,"_5":16137,"_30763":2761,"_3518":65223},[],"The chart and the installer assume a development cluster. The proxy image uses a mutable tag, the PQC certificates are not renewed automatically and the hop between Traefik and Envoy does not verify certificates. Do not use this configuration as it is for production.",{"_4070":2768,"_34195":2761,"_23354":65225,"_5":16137,"_30763":65208,"_3518":65226},[],"Traefik is the public edge. It negotiates the key exchange, serves the certificate and, if requested, receives the client certificate. It then opens a second TLS connection to the `envoy-gateway-proxy` service of Envoy Gateway, which presents the chart's self-signed classical certificate; Traefik is configured to accept it without verifying it. Envoy therefore never sees a post-quantum handshake, and the post-quantum protection covers only the connection between the client and Traefik. Traefik and Envoy Gateway are installed once per cluster and shared across namespaces, whereas the front proxy resources (the Gateway, route, middleware, certificate and reference grant) belong to the Lamassu release.",{"_4070":2769,"_34195":2761,"_23354":65228,"_5":16137,"_30763":65208,"_3518":65229},[],"When the client sent a certificate, the `inject-client-cert` middleware of the chart adds it, in PEM form, to the `X-Forwarded-Tls-Client-Cert` header, and the `X-Forwarded-Proto: https` header is set on the request.",{"_4070":2770,"_34195":2761,"_23354":65231,"_5":16137,"_30763":65212,"_3518":65232},[],"All the new values are under `traefikFrontProxy` and are validated by the chart's schema, which rejects unknown keys.",{"_4070":2771,"_34195":2761,"_23354":65234,"_5":16137,"_30763":65212,"_3518":65235},[],"Name",{"_4070":2772,"_34195":2761,"_23354":65237,"_5":16137,"_30763":65212,"_3518":60824},[],{"_4070":2773,"_34195":2761,"_23354":65239,"_5":16137,"_30763":65212,"_3518":57059},[],{"_4070":2774,"_34195":2761,"_23354":65241,"_5":16137,"_30763":65212,"_3518":60830},[],{"_4070":2775,"_34195":2761,"_23354":65243,"_5":16137,"_30763":65212,"_3518":65244},[],"`traefikFrontProxy.enabled`",{"_4070":2776,"_34195":2761,"_23354":65246,"_5":16137,"_30763":65212,"_3518":21992},[],{"_4070":2777,"_34195":2761,"_23354":65248,"_5":16137,"_30763":65212,"_3518":65249},[],"`false`",{"_4070":2778,"_34195":2761,"_23354":65251,"_5":16137,"_30763":65212,"_3518":65252},[],"Deploys the front proxy resources.",{"_4070":2779,"_34195":2761,"_23354":65254,"_5":16137,"_30763":65212,"_3518":65255},[],"`traefikFrontProxy.domain`",{"_4070":2780,"_34195":2761,"_23354":65257,"_5":16137,"_30763":65212,"_3518":27927},[],{"_4070":2781,"_34195":2761,"_23354":65259,"_5":16137,"_30763":65212,"_3518":65260},[],"`\"\"`",{"_4070":2782,"_34195":2761,"_23354":65262,"_5":16137,"_30763":65212,"_3518":65263},[],"Name of the edge certificate and host name of the route. Set it when the proxy is enabled.",{"_4070":2783,"_34195":2761,"_23354":65265,"_5":16137,"_30763":65212,"_3518":65266},[],"`traefikFrontProxy.webSecurePort`",{"_4070":2784,"_34195":2761,"_23354":65268,"_5":16137,"_30763":65212,"_3518":18275},[],{"_4070":2785,"_34195":2761,"_23354":65270,"_5":16137,"_30763":65212,"_3518":65271},[],"`8443`",{"_4070":2786,"_34195":2761,"_23354":65273,"_5":16137,"_30763":65212,"_3518":65274},[],"Port of the HTTPS listener; it must match Traefik's `websecure` entry point.",{"_4070":2787,"_34195":2761,"_23354":65276,"_5":16137,"_30763":65212,"_3518":65277},[],"`traefikFrontProxy.tls.type`",{"_4070":2788,"_34195":2761,"_23354":65279,"_5":16137,"_30763":65212,"_3518":27927},[],{"_4070":2789,"_34195":2761,"_23354":65281,"_5":16137,"_30763":65212,"_3518":65282},[],"`certManager`",{"_4070":2790,"_34195":2761,"_23354":65284,"_5":16137,"_30763":65212,"_3518":65285},[],"Source of the classical certificate: `certManager`, `external` or `none`.",{"_4070":2791,"_34195":2761,"_23354":65287,"_5":16137,"_30763":65212,"_3518":65288},[],"`traefikFrontProxy.tls.certManagerOptions.addresses`",{"_4070":2792,"_34195":2761,"_23354":65290,"_5":16137,"_30763":65212,"_3518":17079},[],{"_4070":2793,"_34195":2761,"_23354":65292,"_5":16137,"_30763":65212,"_3518":65293},[],"`[]`",{"_4070":2794,"_34195":2761,"_23354":65295,"_5":16137,"_30763":65212,"_3518":65296},[],"IP addresses added to the self-signed certificate.",{"_4070":2795,"_34195":2761,"_23354":65298,"_5":16137,"_30763":65212,"_3518":65299},[],"`traefikFrontProxy.tls.externalOptions.secretName`",{"_4070":2796,"_34195":2761,"_23354":65301,"_5":16137,"_30763":65212,"_3518":27927},[],{"_4070":2797,"_34195":2761,"_23354":65303,"_5":16137,"_30763":65212,"_3518":65260},[],{"_4070":2798,"_34195":2761,"_23354":65305,"_5":16137,"_30763":65212,"_3518":65306},[],"Secret with `tls.crt` and `tls.key` when the type is `external`.",{"_4070":2799,"_34195":2761,"_23354":65308,"_5":16137,"_30763":65212,"_3518":65309},[],"`traefikFrontProxy.tls.additionalSecretNames`",{"_4070":2800,"_34195":2761,"_23354":65311,"_5":16137,"_30763":65212,"_3518":17079},[],{"_4070":2801,"_34195":2761,"_23354":65313,"_5":16137,"_30763":65212,"_3518":65293},[],{"_4070":2802,"_34195":2761,"_23354":65315,"_5":16137,"_30763":65212,"_3518":65316},[],"Extra TLS secrets, for example ML-DSA or composite certificates, served on the same listener.",{"_4070":2803,"_34195":2761,"_23354":65318,"_5":16137,"_30763":65212,"_3518":65319},[],"With `certManager`, the chart requests an ECDSA P-256 certificate valid for 2160 hours from its own self-signed issuer and stores it in the secret `edge-cert`. With `none`, only the additional secrets are served, and the chart stops with an error if there are none. The proxy chooses among all the certificates according to the client, as described in TLS front proxy with Traefik. The names of the resources the chart creates are fixed, so only one release per namespace is supported.",{"_4070":2804,"_34195":2761,"_23354":65321,"_5":16137,"_30763":65212,"_3518":65322},[],"The chart also changes the Envoy Gateway service so that its HTTPS port declares `appProtocol: https`, which recent Traefik versions require in order to speak TLS to it. When `gateway.addresses` is empty, the Envoy service is a `ClusterIP` instead of a load balancer.",{"_4070":2805,"_34195":2761,"_23354":65324,"_5":16137,"_30763":65212,"_3518":65325},[],"The chart does not deploy Traefik itself, the `traefik` GatewayClass, or the `default` TLS option in the `traefik-system` namespace; the installer creates them. Without them, the edge has no post-quantum key exchange and no client-certificate request. The chart also does not set the Lamassu service images: the defaults are the development images, and the installer overrides the UI, CA, KMS, VA, device manager, DMS manager, alerts and authorization images with the `:pqc` tags of `ghcr.io/lamassuiot`.",{"_4070":2806,"_34195":2761,"_23354":65327,"_5":16137,"_30763":65216,"_3518":65328},[],"`scripts/lamassu-fast-lane.sh` installs everything on a cluster: the Gateway API custom resource definitions (version 1.6.3, experimental channel), Envoy Gateway 1.8.0, the Traefik chart 41.0.2 with the PQC image, the TLS option, PostgreSQL, Keycloak, RabbitMQ, optionally observability and SoftHSM, and finally the Lamassu release. The two flags that matter here select which algorithms are offered.",{"_4070":2807,"_34195":2761,"_23354":65330,"_5":16137,"_30763":65216,"_3518":65331},[],"Both flags take a comma-separated list of `T`, `PQ` and `PQ/T`, and both default to all three. For the key exchange, `PQ/T` is a hybrid group that combines a classical and an ML-KEM exchange (`X25519MLKEM768`, `SecP256r1MLKEM768` and `SecP384r1MLKEM1024`) and `PQ` is pure ML-KEM (`MLKEM1024`); for authentication, `PQ/T` is a composite certificate. `--tls-kex` fills the `curvePreferences` of the TLS option, and `--tls-auth` selects which certificates are served:",{"_4070":2808,"_34195":2761,"_23354":65333,"_5":16137,"_30763":65216,"_3518":65334},[],"Value",{"_4070":2809,"_34195":2761,"_23354":65336,"_5":16137,"_30763":65216,"_3518":65337},[],"Key exchange groups",{"_4070":2810,"_34195":2761,"_23354":65339,"_5":16137,"_30763":65216,"_3518":61035},[],{"_4070":2811,"_34195":2761,"_23354":65341,"_5":16137,"_30763":65216,"_3518":65342},[],"`T`",{"_4070":2812,"_34195":2761,"_23354":65344,"_5":16137,"_30763":65216,"_3518":65345},[],"`X25519`, `CurveP256`, `CurveP384`",{"_4070":2813,"_34195":2761,"_23354":65347,"_5":16137,"_30763":65216,"_3518":65348},[],"cert-manager ECDSA P-256, or the files given with `--tls-crt` and `--tls-key`, in the secret `edge-cert`.",{"_4070":2814,"_34195":2761,"_23354":65350,"_5":16137,"_30763":65216,"_3518":65351},[],"`PQ`",{"_4070":2815,"_34195":2761,"_23354":65353,"_5":16137,"_30763":65216,"_3518":65354},[],"`MLKEM1024`",{"_4070":2816,"_34195":2761,"_23354":65356,"_5":16137,"_30763":65216,"_3518":65357},[],"ML-DSA-65, in the secret `edge-cert-pq`.",{"_4070":2817,"_34195":2761,"_23354":65359,"_5":16137,"_30763":65216,"_3518":65360},[],"`PQ/T`",{"_4070":2818,"_34195":2761,"_23354":65362,"_5":16137,"_30763":65216,"_3518":65363},[],"`X25519MLKEM768`, `SecP256r1MLKEM768`, `SecP384r1MLKEM1024`",{"_4070":2819,"_34195":2761,"_23354":65365,"_5":16137,"_30763":65216,"_3518":65366},[],"Composite `MLDSA65-RSA3072-PSS-SHA512`, in the secret `edge-cert-pqt`.",{"_4070":2820,"_34195":2761,"_23354":65368,"_5":16137,"_30763":65216,"_3518":65369},[],"The minimum TLS version is 1.3 unless both flags are only `T`, in which case it is 1.2. cert-manager cannot issue post-quantum certificates, so the installer creates the PQ and PQ/T certificates locally with OpenSSL 3.5 or later; the composite certificate also needs the `hybrid-provider` module, which the script builds on demand with `git`, `cmake` and a C compiler. The ML-DSA private keys are written in the seed-only form that Go accepts, and the secrets are created from a manifest because `kubectl create secret tls` rejects ML-DSA keys. The certificates last 365 days and are kept if the secret already exists.",{"_4070":2821,"_34195":2761,"_23354":65371,"_5":16137,"_30763":65216,"_3518":65372},[],"The script requires `yq`, `kubectl` and `helm`, and `jq` with `--sample-data`. At the end it prints how to extract the CA that devices must trust, for example `kubectl get secret edge-cert-pq -o jsonpath='{.data.ca\\.crt}'`.",{"_4070":2822,"_34195":2761,"_23354":65374,"_5":16137,"_30763":65216,"_3518":65375},[],"Companion scripts for an MQTT broker behind Traefik (`scripts/emqx`), for exporting KMS keys and for restoring a backup are present in the working tree of the chart but not committed. They are for laboratory use only and are not described further here.",{"_4070":2823,"_34195":2761,"_23354":65377,"_5":16137,"_30763":65216,"_3518":65378},[],"<Card title=\"TLS front proxy with Traefik\" description=\"How the proxy chooses a certificate and how it is built.\" href=\"/docs/platform/pqc/tls-front-proxy\" />",{"_4070":2824,"_34195":2761,"_23354":65380,"_5":16137,"_30763":65216,"_3518":65381},[],"<Card title=\"Known limitations\" description=\"Caveats of the laboratory deployment.\" href=\"/docs/platform/pqc/limitations\" />",{"_4070":2825,"_34195":2825,"_5":16540,"_3518":65383,"_34626":65384,"_23354":65385,"_30763":2825},"Go PQC toolchain",[56672,58140,64684,64685],[],{"_4070":2826,"_34195":2825,"_23354":65387,"_5":16137,"_30763":2825,"_3518":65388},[],"The fork of Go that adds composite ML-DSA, SLH-DSA, related certificates and composite TLS signature schemes, the API it exposes and how it is built.",{"_4070":2827,"_34195":2825,"_5":34623,"_23354":65390,"_30763":65391,"_3518":65392},[],"/docs/pr-preview/pr-58/platform/pqc/go-toolchain#what-the-fork-adds","What the fork adds",{"_4070":2828,"_34195":2825,"_5":34623,"_23354":65394,"_30763":65395,"_3518":65396},[],"/docs/pr-preview/pr-58/platform/pqc/go-toolchain#tls-code-points","TLS code points",{"_4070":2829,"_34195":2825,"_5":34623,"_23354":65398,"_30763":65399,"_3518":65400},[],"/docs/pr-preview/pr-58/platform/pqc/go-toolchain#a-minimal-example","A minimal example",{"_4070":2830,"_34195":2825,"_5":34623,"_23354":65402,"_30763":65403,"_3518":65404},[],"/docs/pr-preview/pr-58/platform/pqc/go-toolchain#discarded-approaches","Discarded approaches",{"_4070":2831,"_34195":2825,"_5":34623,"_23354":65406,"_30763":65407,"_3518":65408},[],"/docs/pr-preview/pr-58/platform/pqc/go-toolchain#building-the-toolchain-and-the-images","Building the toolchain and the images",{"_4070":2832,"_34195":2825,"_23354":65410,"_5":16137,"_30763":2825,"_3518":65411},[],"Go 1.27 includes ML-DSA in `crypto/mldsa` and in X.509 and TLS, but it has no composite or SLH-DSA certificates, no related certificates and no composite TLS signature schemes. Lamassu therefore builds its backend and its TLS proxy with a fork of Go, maintained on the `release-branch.go1.27` branch. This page describes what the fork adds, for developers who build Lamassu or write a client that must talk to it.",{"_4070":2833,"_34195":2825,"_23354":65413,"_5":16137,"_30763":2825,"_3518":65414},[],"The fork exposes APIs that do not exist in the official Go distribution. Code that uses them compiles only with this toolchain, and a binary built with it must not be assumed to follow the Go compatibility promise for those APIs.",{"_4070":2834,"_34195":2825,"_23354":65416,"_5":16137,"_30763":65391,"_3518":65417},[],"**Composite ML-DSA in X.509.** The `x509` package gains `CompositePublicKey` and `CompositePrivateKey`, which implement `crypto.Signer`, and 15 `CompositeAlgorithm` values (for example `x509.MLDSA65_ECDSA_P384_SHA512`) that can generate keys, sign and verify. Certificates, certificate requests and revocation lists signed with these keys parse, marshal and verify like any other. PKCS#8 encoding of composite private keys is supported. The algorithms page lists the identifiers.",{"_4070":2835,"_34195":2825,"_23354":65419,"_5":16137,"_30763":65391,"_3518":65420},[],"**SLH-DSA in X.509.** The `x509.SLHDSA` public key algorithm and twelve `PureSLHDSA...` signature algorithms are available for parsing and verifying certificates and keys. The implementation is the vendored `circl` library of Cloudflare. It is the least tested part of the fork: it has no x509 tests of its own and no TLS support.",{"_4070":2836,"_34195":2825,"_23354":65422,"_5":16137,"_30763":65391,"_3518":65423},[],"**Related certificates (RFC 9763).** The fork provides `x509.CreateBoundCertificate`, which adds the `id-pe-relatedCert` extension (`1.3.6.1.5.5.7.1.36`) to a certificate, `x509.VerifyRelatedCertificate`, and the helpers to build and check the `relatedCertRequest` attribute of a certificate request (`1.2.840.113549.1.9.16.2.60`). `x509.CertificateRequest` gains an `ExtraAttributes` field for carrying it. Related certificates explains how Lamassu uses them.",{"_4070":2837,"_34195":2825,"_23354":65425,"_5":16137,"_30763":65391,"_3518":65426},[],"**Composite signature schemes in TLS.** The `tls` package adds 15 `SignatureScheme` constants, one per composite algorithm, advertised by default after the native ML-DSA schemes. They work only with TLS 1.3 and are tested with mutual authentication. See below for their code points.",{"_4070":2838,"_34195":2825,"_23354":65428,"_5":16137,"_30763":65395,"_3518":65429},[],"IANA has assigned no code points to the composite TLS signature schemes, so the fork uses the private-use range `0xFE00` to `0xFE0E`, in the order of the composite table: `0xFE00` is `MLDSA44-RSA2048-PSS-SHA256` and `0xFE0E` is `MLDSA65-Ed25519-SHA512`. A client or server built with a standard TLS library does not recognize them and will fall back to another scheme or fail the handshake. Interoperability is therefore limited to peers built from this fork, or to the native ML-DSA schemes (`0x0904` to `0x0906`) that standard Go 1.27 implements.",{"_4070":2839,"_34195":2825,"_23354":65431,"_5":16137,"_30763":65395,"_3518":65432},[],"The three variants that use RSA PKCS#1 v1.5 (`MLDSA44-RSA2048-PKCS15-SHA256`, `MLDSA65-RSA3072-PKCS15-SHA512` and `MLDSA65-RSA4096-PKCS15-SHA512`) are announced only in the `signature_algorithms_cert` extension, so they can appear in a certificate chain but a leaf certificate with such a key cannot sign the handshake.",{"_4070":2840,"_34195":2825,"_23354":65434,"_5":16137,"_30763":65395,"_3518":65435},[],"Code point",{"_4070":2841,"_34195":2825,"_23354":65437,"_5":16137,"_30763":65395,"_3518":64919},[],{"_4070":2842,"_34195":2825,"_23354":65439,"_5":16137,"_30763":65395,"_3518":65440},[],"`0xFE00`",{"_4070":2843,"_34195":2825,"_23354":65442,"_5":16137,"_30763":65395,"_3518":64930},[],{"_4070":2844,"_34195":2825,"_23354":65444,"_5":16137,"_30763":65395,"_3518":65445},[],"`0xFE01`",{"_4070":2845,"_34195":2825,"_23354":65447,"_5":16137,"_30763":65395,"_3518":64940},[],{"_4070":2846,"_34195":2825,"_23354":65449,"_5":16137,"_30763":65395,"_3518":65450},[],"`0xFE02`",{"_4070":2847,"_34195":2825,"_23354":65452,"_5":16137,"_30763":65395,"_3518":64949},[],{"_4070":2848,"_34195":2825,"_23354":65454,"_5":16137,"_30763":65395,"_3518":65455},[],"`0xFE03`",{"_4070":2849,"_34195":2825,"_23354":65457,"_5":16137,"_30763":65395,"_3518":64958},[],{"_4070":2850,"_34195":2825,"_23354":65459,"_5":16137,"_30763":65395,"_3518":65460},[],"`0xFE04`",{"_4070":2851,"_34195":2825,"_23354":65462,"_5":16137,"_30763":65395,"_3518":64967},[],{"_4070":2852,"_34195":2825,"_23354":65464,"_5":16137,"_30763":65395,"_3518":65465},[],"`0xFE05`",{"_4070":2853,"_34195":2825,"_23354":65467,"_5":16137,"_30763":65395,"_3518":64976},[],{"_4070":2854,"_34195":2825,"_23354":65469,"_5":16137,"_30763":65395,"_3518":65470},[],"`0xFE06`",{"_4070":2855,"_34195":2825,"_23354":65472,"_5":16137,"_30763":65395,"_3518":64985},[],{"_4070":2856,"_34195":2825,"_23354":65474,"_5":16137,"_30763":65395,"_3518":65475},[],"`0xFE07`",{"_4070":2857,"_34195":2825,"_23354":65477,"_5":16137,"_30763":65395,"_3518":64994},[],{"_4070":2858,"_34195":2825,"_23354":65479,"_5":16137,"_30763":65395,"_3518":65480},[],"`0xFE08`",{"_4070":2859,"_34195":2825,"_23354":65482,"_5":16137,"_30763":65395,"_3518":65003},[],{"_4070":2860,"_34195":2825,"_23354":65484,"_5":16137,"_30763":65395,"_3518":65485},[],"`0xFE09`",{"_4070":2861,"_34195":2825,"_23354":65487,"_5":16137,"_30763":65395,"_3518":65013},[],{"_4070":2862,"_34195":2825,"_23354":65489,"_5":16137,"_30763":65395,"_3518":65490},[],"`0xFE0A`",{"_4070":2863,"_34195":2825,"_23354":65492,"_5":16137,"_30763":65395,"_3518":65022},[],{"_4070":2864,"_34195":2825,"_23354":65494,"_5":16137,"_30763":65395,"_3518":65495},[],"`0xFE0B`",{"_4070":2865,"_34195":2825,"_23354":65497,"_5":16137,"_30763":65395,"_3518":65031},[],{"_4070":2866,"_34195":2825,"_23354":65499,"_5":16137,"_30763":65395,"_3518":65500},[],"`0xFE0C`",{"_4070":2867,"_34195":2825,"_23354":65502,"_5":16137,"_30763":65395,"_3518":65040},[],{"_4070":2868,"_34195":2825,"_23354":65504,"_5":16137,"_30763":65395,"_3518":65505},[],"`0xFE0D`",{"_4070":2869,"_34195":2825,"_23354":65507,"_5":16137,"_30763":65395,"_3518":65049},[],{"_4070":2870,"_34195":2825,"_23354":65509,"_5":16137,"_30763":65395,"_3518":65510},[],"`0xFE0E`",{"_4070":2871,"_34195":2825,"_23354":65512,"_5":16137,"_30763":65395,"_3518":65058},[],{"_4070":2872,"_34195":2825,"_23354":65514,"_5":16137,"_30763":65395,"_3518":65515},[],"The key exchange is unchanged from upstream Go. Hybrid groups such as `X25519MLKEM768`, `SecP256r1MLKEM768`, `SecP384r1MLKEM1024` and the pure `MLKEM1024` are those of the Go 1.27 standard library.",{"_4070":2873,"_34195":2825,"_23354":65517,"_5":16137,"_30763":65395,"_3518":65132},[],{"_4070":2874,"_34195":2825,"_23354":65519,"_5":16137,"_30763":65395,"_3518":65520},[],"Composition",{"_4070":2875,"_34195":2825,"_23354":65522,"_5":16137,"_30763":65395,"_3518":65523},[],"`X25519MLKEM768`",{"_4070":2876,"_34195":2825,"_23354":65525,"_5":16137,"_30763":65395,"_3518":65526},[],"X25519 + ML-KEM-768",{"_4070":2877,"_34195":2825,"_23354":65528,"_5":16137,"_30763":65395,"_3518":65529},[],"`SecP256r1MLKEM768`",{"_4070":2878,"_34195":2825,"_23354":65531,"_5":16137,"_30763":65395,"_3518":65532},[],"P-256 + ML-KEM-768",{"_4070":2879,"_34195":2825,"_23354":65534,"_5":16137,"_30763":65395,"_3518":65535},[],"`SecP384r1MLKEM1024`",{"_4070":2880,"_34195":2825,"_23354":65537,"_5":16137,"_30763":65395,"_3518":65538},[],"P-384 + ML-KEM-1024",{"_4070":2881,"_34195":2825,"_23354":65540,"_5":16137,"_30763":65395,"_3518":65354},[],{"_4070":2882,"_34195":2825,"_23354":65542,"_5":16137,"_30763":65395,"_3518":65543},[],"ML-KEM-1024 alone",{"_4070":2883,"_34195":2825,"_23354":65545,"_5":16137,"_30763":65395,"_3518":65546},[],"The connection stays protected while at least one component of a hybrid group is secure. The key exchange is independent of the certificate type, so a connection can use a classical certificate and still have a post-quantum key exchange.",{"_4070":2884,"_34195":2825,"_23354":65548,"_5":16137,"_30763":65399,"_3518":65549},[],"The following program creates a self-signed composite certificate and uses it as the server certificate of a TLS 1.3 configuration. Error handling is omitted.",{"_4070":2885,"_34195":2825,"_23354":65551,"_5":16137,"_30763":65399,"_3518":65552},[],"A composite key can also sign a message directly, with an optional context of at most 255 bytes:",{"_4070":2886,"_34195":2825,"_23354":65554,"_5":16137,"_30763":65403,"_3518":65555},[],"The first iterations of the fork implemented Chameleon certificates, defined in `draft-bonnell-lamps-chameleon-certs`. The idea is to pair two certificates for the same subject, for example a classical one and a post-quantum one, by issuing the first with an extension that encodes only the differences to the second. A relying party that understands the extension can rebuild the paired certificate from it and validate that one, so a single issued certificate carries both identities without changing the path validation rules of RFC 5280.",{"_4070":2887,"_34195":2825,"_23354":65557,"_5":16137,"_30763":65403,"_3518":65558},[],"The work was dropped because the draft expired without becoming a standard and is no longer being pursued, so there was no stable specification to interoperate with. Nothing in the current implementation depends on it.",{"_4070":2888,"_34195":2825,"_23354":65560,"_5":16137,"_30763":65407,"_3518":65561},[],"The fork is built in CI by a workflow that runs the Go test suite and then publishes a multi-architecture image, `ghcr.io/lamassuiot/golang-pqc`, tagged `go1.27` and, for the `release-branch.go1.27` branch, `latest`. The image contains the toolchain under `/usr/local/go-pqc` with `GOROOT` pointing at it.",{"_4070":2889,"_34195":2825,"_23354":65563,"_5":16137,"_30763":65407,"_3518":65564},[],"To build the toolchain from source instead, use the `release-branch.go1.27` branch and the standard Go source build:",{"_4070":2890,"_34195":2825,"_23354":65566,"_5":16137,"_30763":65407,"_3518":65567},[],"The resulting `bin/go` command is used like any other Go toolchain.",{"_4070":2891,"_34195":2825,"_23354":65569,"_5":16137,"_30763":65407,"_3518":65570},[],"Lamassu consumes the toolchain in two ways. The backend images (CA, KMS, VA, alerts, device manager, DMS manager and the monolithic build) use `ghcr.io/lamassuiot/golang-pqc:latest` as their builder image. The backend CI workflow installs the same toolchain through a custom setup action in place of `actions/setup-go`, and the backend requires `go 1.27.3` in its module file. Traefik is not built from the image: its `build.sh` script expects a compiled checkout of the fork in a sibling directory and produces the binary outside a container. See TLS front proxy with Traefik.",{"_4070":2892,"_34195":2825,"_23354":65572,"_5":16137,"_30763":65407,"_3518":65573},[],"<Card title=\"Algorithms\" description=\"The identifiers and parameter sets behind these constants.\" href=\"/docs/platform/pqc/algorithms\" />",{"_4070":2893,"_34195":2825,"_23354":65575,"_5":16137,"_30763":65407,"_3518":65576},[],"<Card title=\"TLS front proxy with Traefik\" description=\"How the fork is used to terminate device TLS.\" href=\"/docs/platform/pqc/tls-front-proxy\" />",{"_4070":2894,"_34195":2894,"_5":16540,"_3518":65578,"_34626":65579,"_23354":65581,"_30763":2894},"HTTPS integration tests",[56672,58140,64684,65580],"Integration tests",[],{"_4070":2895,"_34195":2894,"_23354":65583,"_5":16137,"_30763":2894,"_3518":65584},[],"Results of testing a Lamassu HTTPS endpoint with OpenSSL and curl using post-quantum key exchange and post-quantum and composite certificates.",{"_4070":2896,"_34195":2894,"_5":34623,"_23354":65586,"_30763":65587,"_3518":65588},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/https#scenario","Scenario",{"_4070":2897,"_34195":2894,"_5":34623,"_23354":65590,"_30763":65591,"_3518":65592},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/https#results","Results",{"_4070":2898,"_34195":2894,"_5":34623,"_23354":65594,"_30763":65595,"_3518":65596},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/https#reproduce-a-case","Reproduce a case",{"_4070":2899,"_34195":2894,"_5":34623,"_23354":65598,"_30763":65599,"_3518":65600},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/https#connect-offering-one-group-and-one-signature-scheme","Connect offering one group and one signature scheme",{"_4070":2900,"_34195":2894,"_5":34623,"_23354":65602,"_30763":65603,"_3518":65604},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/https#send-a-request","Send a request",{"_4070":2901,"_34195":2894,"_5":34623,"_23354":65606,"_30763":65607,"_3518":65608},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/https#check-that-a-wrong-offer-is-rejected","Check that a wrong offer is rejected",{"_4070":2902,"_34195":2894,"_23354":65610,"_5":16137,"_30763":2894,"_3518":65611},[],"This test connects to a Lamassu API endpoint over HTTPS from an OpenSSL client and checks that the post-quantum handshake, the certificate chain and the application request all succeed. The overview explains the clients, the test matrix and what each check proves.",{"_4070":2903,"_34195":2894,"_23354":65613,"_5":16137,"_30763":65587,"_3518":65614},[],"The client requests `GET /api/ca/health` through the Traefik front proxy, which forwards it to Envoy Gateway and the CA service. The server certificate and the CA that signed it were created outside Lamassu and loaded into the front proxy for each case. For each case the proxy was configured with the key exchange groups and the certificate of that row and column of the matrix.",{"_4070":2904,"_34195":2894,"_23354":65616,"_5":16137,"_30763":65587,"_3518":65617},[],"The CAs and certificates are test material made outside Lamassu, valid for a short period and with the server name as their subject alternative name. They are not issued by the Lamassu CA service.",{"_4070":2905,"_34195":2894,"_23354":65619,"_5":16137,"_30763":65591,"_3518":65620},[],"All nine combinations of key exchange and certificate passed, and so did the three additional composite certificates.",{"_4070":2906,"_34195":2894,"_23354":65622,"_5":16137,"_30763":65591,"_3518":65623},[],"Key exchange ↓ / Certificate →",{"_4070":2907,"_34195":2894,"_23354":65625,"_5":16137,"_30763":65591,"_3518":65626},[],"**T**: ECDSA P-256",{"_4070":2908,"_34195":2894,"_23354":65628,"_5":16137,"_30763":65591,"_3518":65629},[],"**PQ**: ML-DSA-65",{"_4070":2909,"_34195":2894,"_23354":65631,"_5":16137,"_30763":65591,"_3518":65632},[],"**PQ/T**: `MLDSA65-RSA3072-PSS-SHA512`",{"_4070":2910,"_34195":2894,"_23354":65634,"_5":16137,"_30763":65591,"_3518":65635},[],"**T**",{"_4070":2911,"_34195":2894,"_23354":65637,"_5":16137,"_30763":65591,"_3518":65638},[],"✅ `X25519`, `ecdsa_secp256r1_sha256`",{"_4070":2912,"_34195":2894,"_23354":65640,"_5":16137,"_30763":65591,"_3518":65641},[],"✅ `X25519`, `mldsa65`",{"_4070":2913,"_34195":2894,"_23354":65643,"_5":16137,"_30763":65591,"_3518":65644},[],"✅ `X25519`, `mldsa65_rsa3072_pss`",{"_4070":2914,"_34195":2894,"_23354":65646,"_5":16137,"_30763":65591,"_3518":65647},[],"**PQ**",{"_4070":2915,"_34195":2894,"_23354":65649,"_5":16137,"_30763":65591,"_3518":65650},[],"✅ `MLKEM1024`, `ecdsa_secp256r1_sha256`",{"_4070":2916,"_34195":2894,"_23354":65652,"_5":16137,"_30763":65591,"_3518":65653},[],"✅ `MLKEM1024`, `mldsa65`",{"_4070":2917,"_34195":2894,"_23354":65655,"_5":16137,"_30763":65591,"_3518":65656},[],"✅ `MLKEM1024`, `mldsa65_rsa3072_pss`",{"_4070":2918,"_34195":2894,"_23354":65658,"_5":16137,"_30763":65591,"_3518":65659},[],"**PQ/T**",{"_4070":2919,"_34195":2894,"_23354":65661,"_5":16137,"_30763":65591,"_3518":65662},[],"✅ `X25519MLKEM768`, `ecdsa_secp256r1_sha256`",{"_4070":2920,"_34195":2894,"_23354":65664,"_5":16137,"_30763":65591,"_3518":65665},[],"✅ `X25519MLKEM768`, `mldsa65`",{"_4070":2921,"_34195":2894,"_23354":65667,"_5":16137,"_30763":65591,"_3518":65668},[],"✅ `X25519MLKEM768`, `mldsa65_rsa3072_pss`",{"_4070":2922,"_34195":2894,"_23354":65670,"_5":16137,"_30763":65591,"_3518":65671},[],"Each cell shows the negotiated group and the signature scheme of the handshake. In every case the chain verified, the request returned `200` and both negative checks were rejected with `handshake_failure`.",{"_4070":2923,"_34195":2894,"_23354":65673,"_5":16137,"_30763":65591,"_3518":65674},[],"Additional composite",{"_4070":2924,"_34195":2894,"_23354":65676,"_5":16137,"_30763":65591,"_3518":65677},[],"Signature scheme",{"_4070":2925,"_34195":2894,"_23354":65679,"_5":16137,"_30763":65591,"_3518":61920},[],{"_4070":2926,"_34195":2894,"_23354":65681,"_5":16137,"_30763":65591,"_3518":65682},[],"`MLDSA44-ECDSA-P256-SHA256`",{"_4070":2927,"_34195":2894,"_23354":65684,"_5":16137,"_30763":65591,"_3518":65685},[],"`mldsa44_ecdsa_p256`",{"_4070":2928,"_34195":2894,"_23354":65687,"_5":16137,"_30763":65591,"_3518":65688},[],"✅ with `X25519MLKEM768`",{"_4070":2929,"_34195":2894,"_23354":65690,"_5":16137,"_30763":65591,"_3518":65691},[],"`MLDSA65-ECDSA-P256-SHA512`",{"_4070":2930,"_34195":2894,"_23354":65693,"_5":16137,"_30763":65591,"_3518":65694},[],"`mldsa65_ecdsa_p256`",{"_4070":2931,"_34195":2894,"_23354":65696,"_5":16137,"_30763":65591,"_3518":65688},[],{"_4070":2932,"_34195":2894,"_23354":65698,"_5":16137,"_30763":65591,"_3518":65699},[],"`MLDSA65-Ed25519-SHA512`",{"_4070":2933,"_34195":2894,"_23354":65701,"_5":16137,"_30763":65591,"_3518":65702},[],"`mldsa65_ed25519`",{"_4070":2934,"_34195":2894,"_23354":65704,"_5":16137,"_30763":65591,"_3518":65688},[],{"_4070":2935,"_34195":2894,"_23354":65706,"_5":16137,"_30763":65591,"_3518":65707},[],"With a single server configuration that holds the ECDSA, ML-DSA-65 and composite certificates at once and accepts all three key exchange classes, a client that offered one group and one signature scheme negotiated each of the nine combinations. `curl` returned `200` when it trusted the three CAs.",{"_4070":2936,"_34195":2894,"_23354":65709,"_5":16137,"_30763":65591,"_3518":65710},[],"A server with certificates of several classes serves the first that matches the client's signature preference. A default OpenSSL 3.5 or later client prefers ML-DSA, so a client that trusts only the ECDSA CA fails with `unable to get local issuer certificate`, even though the connection itself worked. Give clients the CAs of every class the server may present.",{"_4070":2937,"_34195":2894,"_23354":65712,"_5":16137,"_30763":65595,"_3518":65713},[],"You need OpenSSL 3.5 or later. For composite certificates, also the `hybrid-provider` module with code points that match the Go PQC toolchain, loaded through `OPENSSL_CONF`. Use the CA file of the case as `ca.pem`.",{"_4070":2938,"_34195":2894,"_23354":65715,"_5":16137,"_30763":65599,"_3518":65716},[],"This example tests PQ/T key exchange with the composite certificate, and prints the negotiated values:",{"_4070":2939,"_34195":2894,"_23354":65718,"_5":16137,"_30763":65599,"_3518":65719},[],"Expected output:",{"_4070":2940,"_34195":2894,"_23354":65721,"_5":16137,"_30763":65603,"_3518":65722},[],"Replace the `grep` with an HTTP request to confirm that the application layer works through the proxy:",{"_4070":2941,"_34195":2894,"_23354":65724,"_5":16137,"_30763":65603,"_3518":65725},[],"The response starts with `HTTP/1.1 200 OK`. With `curl` and a bundle that contains the CAs of the classes the server presents, `curl --cacert ca-bundle.pem https://<LAMASSU_HOST>/api/ca/health` returns `200` as well.",{"_4070":2942,"_34195":2894,"_23354":65727,"_5":16137,"_30763":65607,"_3518":65728},[],"Offer only classical groups to a server configured for PQ key exchange:",{"_4070":2943,"_34195":2894,"_23354":65730,"_5":16137,"_30763":65607,"_3518":65731},[],"The handshake fails with a `handshake failure` alert. Offering every signature scheme except the certificate's gives the same result.",{"_4070":2944,"_34195":2894,"_23354":65733,"_5":16137,"_30763":65607,"_3518":65734},[],"<Card title=\"MQTTS\" description=\"The same checks for an MQTT broker.\" href=\"/docs/platform/pqc/integration-tests/mqtts\" />",{"_4070":2945,"_34195":2894,"_23354":65736,"_5":16137,"_30763":65607,"_3518":65737},[],"<Card title=\"TLS front proxy with Traefik\" description=\"How the proxy chooses a certificate and enforces key exchange.\" href=\"/docs/platform/pqc/tls-front-proxy\" />",{"_4070":2946,"_34195":2946,"_5":16540,"_3518":65739,"_34626":65740,"_23354":65741,"_30763":2946},"MQTTS integration tests",[56672,58140,64684,65580],[],{"_4070":2947,"_34195":2946,"_23354":65743,"_5":16137,"_30763":2946,"_3518":65744},[],"Results of testing an MQTT broker behind the Lamassu TLS front proxy with mosquitto, using post-quantum key exchange and post-quantum and composite certificates.",{"_4070":2948,"_34195":2946,"_5":34623,"_23354":65746,"_30763":65747,"_3518":65588},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/mqtts#scenario",{"_4070":2949,"_34195":2946,"_5":34623,"_23354":65749,"_30763":65750,"_3518":65592},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/mqtts#results",{"_4070":2950,"_34195":2946,"_5":34623,"_23354":65752,"_30763":65753,"_3518":65596},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/mqtts#reproduce-a-case",{"_4070":2951,"_34195":2946,"_5":34623,"_23354":65755,"_30763":65756,"_3518":65757},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/mqtts#create-the-openssl-configuration","Create the OpenSSL configuration",{"_4070":2952,"_34195":2946,"_5":34623,"_23354":65759,"_30763":65760,"_3518":65761},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/mqtts#subscribe-and-publish","Subscribe and publish",{"_4070":2953,"_34195":2946,"_5":34623,"_23354":65763,"_30763":65764,"_3518":65608},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/mqtts#check-that-a-wrong-offer-is-rejected",{"_4070":2954,"_34195":2946,"_5":34623,"_23354":65766,"_30763":65767,"_3518":65123},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/mqtts#things-to-know",{"_4070":2955,"_34195":2946,"_23354":65769,"_5":16137,"_30763":2946,"_3518":65770},[],"This test connects `mosquitto_pub` and `mosquitto_sub` to an MQTT broker over TLS and checks that messages travel through it with post-quantum key exchange and post-quantum or composite server certificates. The overview explains the clients, the test matrix and what each check proves.",{"_4070":2956,"_34195":2946,"_23354":65772,"_5":16137,"_30763":65747,"_3518":65773},[],"The broker is EMQX 5.8.9. It listens for MQTT in clear text inside the cluster, and the Lamassu TLS front proxy (TLS front proxy with Traefik) terminates TLS for it on port 8883 and forwards the traffic. The TLS is one-way: the broker's endpoint presents its certificate, and the client presents none. The server certificate and its CA were created outside Lamassu, and the proxy was configured for each case with the key exchange groups and certificate of that row and column of the matrix.",{"_4070":2957,"_34195":2946,"_23354":65775,"_5":16137,"_30763":65747,"_3518":65776},[],"The clients are `mosquitto_pub` and `mosquitto_sub` 2.1.2, using MQTT 3.1.1 over TLS 1.3 and linked against OpenSSL 4.1.0. A case passes when the subscriber receives the message that the publisher sent through the broker, both clients validate the certificate chain against the CA of the case and the server name, and the two negative checks are rejected.",{"_4070":2958,"_34195":2946,"_23354":65778,"_5":16137,"_30763":65750,"_3518":65779},[],"All twelve cases passed. In each one, `mosquitto_sub` subscribed to a topic, `mosquitto_pub` published a unique value, and the subscriber received it. The test ran twice per case: once with the client offering every group and signature scheme, and once with the client offering only the group and the signature scheme expected for the case. The second run shows that the broker's endpoint negotiated exactly that group and scheme, because the client offered nothing else.",{"_4070":2959,"_34195":2946,"_23354":65781,"_5":16137,"_30763":65750,"_3518":65623},[],{"_4070":2960,"_34195":2946,"_23354":65783,"_5":16137,"_30763":65750,"_3518":65626},[],{"_4070":2961,"_34195":2946,"_23354":65785,"_5":16137,"_30763":65750,"_3518":65629},[],{"_4070":2962,"_34195":2946,"_23354":65787,"_5":16137,"_30763":65750,"_3518":65632},[],{"_4070":2963,"_34195":2946,"_23354":65789,"_5":16137,"_30763":65750,"_3518":65635},[],{"_4070":2964,"_34195":2946,"_23354":65791,"_5":16137,"_30763":65750,"_3518":65638},[],{"_4070":2965,"_34195":2946,"_23354":65793,"_5":16137,"_30763":65750,"_3518":65641},[],{"_4070":2966,"_34195":2946,"_23354":65795,"_5":16137,"_30763":65750,"_3518":65644},[],{"_4070":2967,"_34195":2946,"_23354":65797,"_5":16137,"_30763":65750,"_3518":65647},[],{"_4070":2968,"_34195":2946,"_23354":65799,"_5":16137,"_30763":65750,"_3518":65650},[],{"_4070":2969,"_34195":2946,"_23354":65801,"_5":16137,"_30763":65750,"_3518":65653},[],{"_4070":2970,"_34195":2946,"_23354":65803,"_5":16137,"_30763":65750,"_3518":65656},[],{"_4070":2971,"_34195":2946,"_23354":65805,"_5":16137,"_30763":65750,"_3518":65659},[],{"_4070":2972,"_34195":2946,"_23354":65807,"_5":16137,"_30763":65750,"_3518":65662},[],{"_4070":2973,"_34195":2946,"_23354":65809,"_5":16137,"_30763":65750,"_3518":65665},[],{"_4070":2974,"_34195":2946,"_23354":65811,"_5":16137,"_30763":65750,"_3518":65668},[],{"_4070":2975,"_34195":2946,"_23354":65813,"_5":16137,"_30763":65750,"_3518":65814},[],"The additional composite certificates behave the same way with PQ/T key exchange.",{"_4070":2976,"_34195":2946,"_23354":65816,"_5":16137,"_30763":65750,"_3518":65674},[],{"_4070":2977,"_34195":2946,"_23354":65818,"_5":16137,"_30763":65750,"_3518":65677},[],{"_4070":2978,"_34195":2946,"_23354":65820,"_5":16137,"_30763":65750,"_3518":61920},[],{"_4070":2979,"_34195":2946,"_23354":65822,"_5":16137,"_30763":65750,"_3518":65682},[],{"_4070":2980,"_34195":2946,"_23354":65824,"_5":16137,"_30763":65750,"_3518":65685},[],{"_4070":2981,"_34195":2946,"_23354":65826,"_5":16137,"_30763":65750,"_3518":65827},[],"✅",{"_4070":2982,"_34195":2946,"_23354":65829,"_5":16137,"_30763":65750,"_3518":65691},[],{"_4070":2983,"_34195":2946,"_23354":65831,"_5":16137,"_30763":65750,"_3518":65694},[],{"_4070":2984,"_34195":2946,"_23354":65833,"_5":16137,"_30763":65750,"_3518":65827},[],{"_4070":2985,"_34195":2946,"_23354":65835,"_5":16137,"_30763":65750,"_3518":65699},[],{"_4070":2986,"_34195":2946,"_23354":65837,"_5":16137,"_30763":65750,"_3518":65702},[],{"_4070":2987,"_34195":2946,"_23354":65839,"_5":16137,"_30763":65750,"_3518":65827},[],{"_4070":2988,"_34195":2946,"_23354":65841,"_5":16137,"_30763":65750,"_3518":65842},[],"When the client offered every group except those of the case, or every signature scheme except the certificate's, the TLS handshake failed with a `handshake failure` alert and the broker never sent a `CONNACK`. The same result held in all twelve cases.",{"_4070":2989,"_34195":2946,"_23354":65844,"_5":16137,"_30763":65750,"_3518":65845},[],"With a single server configuration that holds the ECDSA, ML-DSA-65 and composite certificates and accepts all three key exchange classes, each of the nine combinations connected on port 8883 when the client offered one group and one signature scheme. `mosquitto_pub` received `CONNACK (0)` every time.",{"_4070":2990,"_34195":2946,"_23354":65847,"_5":16137,"_30763":65753,"_3518":65848},[],"mosquitto has no options to choose key exchange groups or signature schemes, so they are set through an OpenSSL configuration file that `mosquitto_pub` and `mosquitto_sub` read from the `OPENSSL_CONF` environment variable. You need OpenSSL 3.5 or later; for composite certificates, also the `hybrid-provider` module with code points that match the Go PQC toolchain.",{"_4070":2991,"_34195":2946,"_23354":65850,"_5":16137,"_30763":65756,"_3518":65851},[],"This `pqc-client.cnf` makes the client offer only `X25519MLKEM768` and the composite signature scheme, and loads the composite provider:",{"_4070":2992,"_34195":2946,"_23354":65853,"_5":16137,"_30763":65756,"_3518":65854},[],"Remove the `hybrid` provider and the module for a case that uses ML-DSA or ECDSA only.",{"_4070":2993,"_34195":2946,"_23354":65856,"_5":16137,"_30763":65760,"_3518":65857},[],"Start the subscriber in one terminal and the publisher in another. Both validate the broker's certificate against `ca.pem`, the CA of the case:",{"_4070":2994,"_34195":2946,"_23354":65859,"_5":16137,"_30763":65760,"_3518":65860},[],"The subscriber prints `hello over pqc` and exits. Add `-d` to see the `CONNECT`, `CONNACK (0)`, `SUBACK` and `PUBLISH` packets.",{"_4070":2995,"_34195":2946,"_23354":65862,"_5":16137,"_30763":65764,"_3518":65863},[],"Change `Groups` to a list that does not include the group the server accepts, for example `Groups = X25519` against a server configured for `MLKEM1024`, and repeat the publish. The client fails with `tls alert handshake failure` and no `CONNACK` is received.",{"_4070":2996,"_34195":2946,"_23354":65865,"_5":16137,"_30763":65767,"_3518":65866},[],"**Hostname and certificate.** mosquitto uses the `-h` value as the connection target, the server name sent in the handshake and the name it verifies. The test certificates carry that name as a subject alternative name.",{"_4070":2997,"_34195":2946,"_23354":65868,"_5":16137,"_30763":65767,"_3518":65869},[],"**One certificate per name.** The front proxy keeps its certificates by name, not by port. An MQTT endpoint that shares its name with the HTTPS endpoint serves the same certificates, so give the broker its own name if it needs a different certificate.",{"_4070":2998,"_34195":2946,"_23354":65871,"_5":16137,"_30763":65767,"_3518":65872},[],"**Unpinned defaults were not tested.** Every run set the group and signature offer explicitly, so what mosquitto negotiates with the default OpenSSL offer was not checked in this test. The HTTPS tests do cover a default OpenSSL client: it is served the ML-DSA certificate if the server holds one.",{"_4070":2999,"_34195":2946,"_23354":65874,"_5":16137,"_30763":65767,"_3518":65875},[],"**Other clients on the same port.** Enforcing TLS 1.3 or post-quantum algorithms on a shared MQTT port affects every client that connects to it. During the tests the proxy logged connection attempts from other clients that only support TLS 1.2 or earlier, or that did not trust the certificate. Identify them before making the setting permanent.",{"_4070":3000,"_34195":2946,"_23354":65877,"_5":16137,"_30763":65767,"_3518":65878},[],"<Card title=\"HTTPS\" description=\"The same checks for a Lamassu HTTPS endpoint.\" href=\"/docs/platform/pqc/integration-tests/https\" />",{"_4070":3001,"_34195":2946,"_23354":65880,"_5":16137,"_30763":65767,"_3518":65881},[],"<Card title=\"Deployment with the Helm chart\" description=\"Deploy the front proxy that terminates the TLS.\" href=\"/docs/platform/pqc/deployment\" />",{"_4070":3002,"_34195":3002,"_5":16540,"_3518":65883,"_34626":65884,"_23354":65885,"_30763":3002},"Integration tests overview",[56672,58140,64684,65580],[],{"_4070":3003,"_34195":3002,"_23354":65887,"_5":16137,"_30763":3002,"_3518":65888},[],"Evidence that software outside Lamassu negotiates post-quantum key exchange and verifies post-quantum and composite certificates served by Lamassu.",{"_4070":3004,"_34195":3002,"_5":34623,"_23354":65890,"_30763":65891,"_3518":65892},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/overview#what-was-tested","What was tested",{"_4070":3005,"_34195":3002,"_5":34623,"_23354":65894,"_30763":65895,"_3518":65896},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/overview#the-test-matrix","The test matrix",{"_4070":3006,"_34195":3002,"_5":34623,"_23354":65898,"_30763":65899,"_3518":65900},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/overview#what-each-case-checks","What each case checks",{"_4070":3007,"_34195":3002,"_5":34623,"_23354":65902,"_30763":65903,"_3518":65904},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/overview#behaviour-to-expect","Behaviour to expect",{"_4070":3008,"_34195":3002,"_23354":65906,"_5":16137,"_30763":3002,"_3518":65907},[],"Post-quantum certificates only help if the systems that consume them can use them. These integration tests check that clients and brokers that are not part of Lamassu, built on a different cryptographic library, can connect to a Lamassu TLS endpoint, negotiate post-quantum key exchange and verify post-quantum and composite certificates. Two protocols were tested: HTTPS and MQTTS.",{"_4070":3009,"_34195":3002,"_23354":65909,"_5":16137,"_30763":3002,"_3518":65910},[],"The certificates and CAs used in the tests were generated outside Lamassu, with standard tools, to show that the Go PQC toolchain implements the X.509 and TLS formats in an interoperable way. They show that certificates created externally work with Lamassu's TLS endpoint, and that independent software verifies them. They do not test certificates issued by a Lamassu CA.",{"_4070":3010,"_34195":3002,"_23354":65912,"_5":16137,"_30763":65891,"_3518":65913},[],"The server is the Traefik front proxy that terminates device TLS in Lamassu (TLS front proxy with Traefik). It is built with the Go PQC toolchain and was configured for each test with one key exchange class and one certificate class.",{"_4070":3011,"_34195":3002,"_23354":65915,"_5":16137,"_30763":65891,"_3518":65916},[],"The clients are independent implementations:",{"_4070":3012,"_34195":3002,"_23354":65918,"_5":16137,"_30763":65891,"_3518":65919},[],"**OpenSSL 4.0.3 and 4.1.0**, with the native ML-KEM and ML-DSA support of OpenSSL 3.5 and later.",{"_4070":3013,"_34195":3002,"_23354":65921,"_5":16137,"_30763":65891,"_3518":65922},[],"**The OpenSSL `hybrid-provider` module**, for composite ML-DSA. The build used was written against draft 19 of the specification, which was later published as RFC 10073; the test vectors of both are identical, but the provider was not otherwise checked against the final text.",{"_4070":3014,"_34195":3002,"_23354":65924,"_5":16137,"_30763":65891,"_3518":65925},[],"**`curl`*&#x2A; for HTTPS and **`mosquitto_pub` and `mosquitto_sub` 2.1.2** for MQTTS, both linked against that OpenSSL.",{"_4070":3015,"_34195":3002,"_23354":65927,"_5":16137,"_30763":65895,"_3518":65928},[],"Each combination of key exchange and certificate was tested separately, using the families that Lamassu uses elsewhere (T, PQ and PQ/T, see Algorithms).",{"_4070":3016,"_34195":3002,"_23354":65930,"_5":16137,"_30763":65895,"_3518":65931},[],"Key exchange",{"_4070":3017,"_34195":3002,"_23354":65933,"_5":16137,"_30763":65895,"_3518":65934},[],"Groups the server accepts",{"_4070":3018,"_34195":3002,"_23354":65936,"_5":16137,"_30763":65895,"_3518":65635},[],{"_4070":3019,"_34195":3002,"_23354":65938,"_5":16137,"_30763":65895,"_3518":65345},[],{"_4070":3020,"_34195":3002,"_23354":65940,"_5":16137,"_30763":65895,"_3518":65647},[],{"_4070":3021,"_34195":3002,"_23354":65942,"_5":16137,"_30763":65895,"_3518":65354},[],{"_4070":3022,"_34195":3002,"_23354":65944,"_5":16137,"_30763":65895,"_3518":65659},[],{"_4070":3023,"_34195":3002,"_23354":65946,"_5":16137,"_30763":65895,"_3518":65363},[],{"_4070":3024,"_34195":3002,"_23354":65948,"_5":16137,"_30763":65895,"_3518":61035},[],{"_4070":3025,"_34195":3002,"_23354":65950,"_5":16137,"_30763":65895,"_3518":65951},[],"Server certificate",{"_4070":3026,"_34195":3002,"_23354":65953,"_5":16137,"_30763":65895,"_3518":65635},[],{"_4070":3027,"_34195":3002,"_23354":65955,"_5":16137,"_30763":65895,"_3518":65956},[],"ECDSA P-256",{"_4070":3028,"_34195":3002,"_23354":65958,"_5":16137,"_30763":65895,"_3518":65647},[],{"_4070":3029,"_34195":3002,"_23354":65960,"_5":16137,"_30763":65895,"_3518":64822},[],{"_4070":3030,"_34195":3002,"_23354":65962,"_5":16137,"_30763":65895,"_3518":65659},[],{"_4070":3031,"_34195":3002,"_23354":65964,"_5":16137,"_30763":65895,"_3518":65965},[],"Composite `MLDSA65-RSA3072-PSS-SHA512`",{"_4070":3032,"_34195":3002,"_23354":65967,"_5":16137,"_30763":65895,"_3518":65968},[],"That gives nine combinations. Three more composite certificates were tested with PQ/T key exchange: `MLDSA44-ECDSA-P256-SHA256`, `MLDSA65-ECDSA-P256-SHA512` and `MLDSA65-Ed25519-SHA512`, for twelve cases in total. Every certificate was issued by a test CA with the same algorithm as the certificate.",{"_4070":3033,"_34195":3002,"_23354":65970,"_5":16137,"_30763":65899,"_3518":65971},[],"A case passes only if all of these hold:",{"_4070":3034,"_34195":3002,"_23354":65973,"_5":16137,"_30763":65899,"_3518":65974},[],"**Key exchange.** The group negotiated in the handshake is the one expected for the case.",{"_4070":3035,"_34195":3002,"_23354":65976,"_5":16137,"_30763":65899,"_3518":65977},[],"**Signature.** The signature scheme of the server's handshake signature is the one expected for the certificate.",{"_4070":3036,"_34195":3002,"_23354":65979,"_5":16137,"_30763":65899,"_3518":65980},[],"**Chain.** The client verifies the certificate chain against the CA of the case and the server name, with no verification error.",{"_4070":3037,"_34195":3002,"_23354":65982,"_5":16137,"_30763":65899,"_3518":65983},[],"**Application traffic.** The protocol works: an HTTP request returns `200`, or an MQTT message published to the broker reaches a subscriber.",{"_4070":3038,"_34195":3002,"_23354":65985,"_5":16137,"_30763":65899,"_3518":65986},[],"**Wrong key exchange is rejected.** A client that offers every group except those of the case's class fails with the TLS alert `handshake_failure`.",{"_4070":3039,"_34195":3002,"_23354":65988,"_5":16137,"_30763":65899,"_3518":65989},[],"**Wrong certificate scheme is rejected.** A client that offers every signature scheme except the certificate's fails with the same alert.",{"_4070":3040,"_34195":3002,"_23354":65991,"_5":16137,"_30763":65899,"_3518":65992},[],"The last two checks show that the server enforces its configuration, not just that it accepts a compatible client.",{"_4070":3041,"_34195":3002,"_23354":65994,"_5":16137,"_30763":65903,"_3518":65995},[],"**Composite code points had to be aligned.** The TLS signature schemes of composite algorithms use private-use code points. The `hybrid-provider` uses different values by default, so for the tests its code points were set to those of the Go PQC toolchain. A client that implements composite TLS must use the same values.",{"_4070":3042,"_34195":3002,"_23354":65997,"_5":16137,"_30763":65903,"_3518":65998},[],"**Pure ML-DSA and ML-KEM need nothing extra.** They work with OpenSSL 3.5 or later as it is; only composite certificates need the provider.",{"_4070":3043,"_34195":3002,"_23354":66000,"_5":16137,"_30763":65903,"_3518":66001},[],"**Some handshakes take an extra round trip.** A client sends the `X25519MLKEM768` key share first. When the server is configured for a class that does not include it (T and PQ), the server answers with a HelloRetryRequest and the handshake completes with the group it asks for.",{"_4070":3044,"_34195":3002,"_23354":66003,"_5":16137,"_30763":65903,"_3518":66004},[],"**The client's signature preference decides the certificate.** When the server holds certificates of several classes for the same name, it serves the first one that matches the client's list of signature schemes. A default OpenSSL 3.5 or later client lists ML-DSA first, so it is served the ML-DSA certificate and must trust that CA.",{"_4070":3045,"_34195":3002,"_23354":66006,"_5":16137,"_30763":65903,"_3518":66007},[],"<Card title=\"HTTPS\" description=\"A Lamassu API endpoint tested with openssl and curl.\" href=\"/docs/platform/pqc/integration-tests/https\" />",{"_4070":3046,"_34195":3002,"_23354":66009,"_5":16137,"_30763":65903,"_3518":66010},[],"<Card title=\"MQTTS\" description=\"An MQTT broker behind the TLS front proxy, tested with mosquitto.\" href=\"/docs/platform/pqc/integration-tests/mqtts\" />",{"_4070":3047,"_34195":3002,"_23354":66012,"_5":16137,"_30763":65903,"_3518":66013},[],"<Card title=\"Known limitations\" description=\"What is not covered by these tests or by the platform.\" href=\"/docs/platform/pqc/limitations\" />",{"_4070":3048,"_34195":3048,"_5":16540,"_3518":66015,"_34626":66016,"_23354":66017,"_30763":3048},"Keys and certificate authorities",[56672,58140,64684,65099],[],{"_4070":3049,"_34195":3048,"_23354":66019,"_5":16137,"_30763":3048,"_3518":66020},[],"Create post-quantum keys and CAs, sign with them and issue certificates, with the engine support, API values and constraints that apply.",{"_4070":3050,"_34195":3048,"_5":34623,"_23354":66022,"_30763":66023,"_3518":66024},[],"/docs/pr-preview/pr-58/platform/pqc/keys-and-cas#choose-a-crypto-engine-that-supports-the-algorithm","Choose a crypto engine that supports the algorithm",{"_4070":3051,"_34195":3048,"_5":34623,"_23354":66026,"_30763":66027,"_3518":66028},[],"/docs/pr-preview/pr-58/platform/pqc/keys-and-cas#create-a-key","Create a key",{"_4070":3052,"_34195":3048,"_5":34623,"_23354":66030,"_30763":66031,"_3518":66032},[],"/docs/pr-preview/pr-58/platform/pqc/keys-and-cas#create-a-certificate-authority","Create a certificate authority",{"_4070":3053,"_34195":3048,"_5":34623,"_23354":66034,"_30763":66035,"_3518":66036},[],"/docs/pr-preview/pr-58/platform/pqc/keys-and-cas#mixing-algorithms-in-a-hierarchy","Mixing algorithms in a hierarchy",{"_4070":3054,"_34195":3048,"_5":34623,"_23354":66038,"_30763":66039,"_3518":66040},[],"/docs/pr-preview/pr-58/platform/pqc/keys-and-cas#signing-and-verifying-with-a-key","Signing and verifying with a key",{"_4070":3055,"_34195":3048,"_5":34623,"_23354":66042,"_30763":66043,"_3518":66044},[],"/docs/pr-preview/pr-58/platform/pqc/keys-and-cas#constraints-to-keep-in-mind","Constraints to keep in mind",{"_4070":3056,"_34195":3048,"_23354":66046,"_5":16137,"_30763":3048,"_3518":66047},[],"The Lamassu backend treats post-quantum keys as one more key type of the Key Management Service (KMS). A certificate authority created with such a key signs certificates and revocation lists through the same paths as an RSA or ECDSA CA, because the fork of Go performs the signing. This page explains what to send to the API, which crypto engines can hold the keys and where the behaviour differs from classical keys. The backend must be built with the Go PQC toolchain.",{"_4070":3057,"_34195":3048,"_23354":66049,"_5":16137,"_30763":66023,"_3518":66050},[],"Not every crypto engine can create or hold post-quantum keys. Only the engines that run the cryptography in the Lamassu process can.",{"_4070":3058,"_34195":3048,"_23354":66052,"_5":16137,"_30763":66023,"_3518":66053},[],"Engine",{"_4070":3059,"_34195":3048,"_23354":66055,"_5":16137,"_30763":66023,"_3518":66056},[],"ML-DSA, SLH-DSA, Composite, Ed25519",{"_4070":3060,"_34195":3048,"_23354":66058,"_5":16137,"_30763":66023,"_3518":66059},[],"Filesystem",{"_4070":3061,"_34195":3048,"_23354":66061,"_5":16137,"_30763":66023,"_3518":66062},[],"Supported",{"_4070":3062,"_34195":3048,"_23354":66064,"_5":16137,"_30763":66023,"_3518":66065},[],"Software (golang)",{"_4070":3063,"_34195":3048,"_23354":66067,"_5":16137,"_30763":66023,"_3518":66062},[],{"_4070":3064,"_34195":3048,"_23354":66069,"_5":16137,"_30763":66023,"_3518":66070},[],"HashiCorp Vault KV2",{"_4070":3065,"_34195":3048,"_23354":66072,"_5":16137,"_30763":66023,"_3518":66073},[],"Not supported",{"_4070":3066,"_34195":3048,"_23354":66075,"_5":16137,"_30763":66023,"_3518":63592},[],{"_4070":3067,"_34195":3048,"_23354":66077,"_5":16137,"_30763":66023,"_3518":66073},[],{"_4070":3068,"_34195":3048,"_23354":66079,"_5":16137,"_30763":66023,"_3518":63596},[],{"_4070":3069,"_34195":3048,"_23354":66081,"_5":16137,"_30763":66023,"_3518":66073},[],{"_4070":3070,"_34195":3048,"_23354":66083,"_5":16137,"_30763":66023,"_3518":66084},[],"Azure Key Vault and Azure Secrets",{"_4070":3071,"_34195":3048,"_23354":66086,"_5":16137,"_30763":66023,"_3518":66073},[],{"_4070":3072,"_34195":3048,"_23354":66088,"_5":16137,"_30763":66023,"_3518":66089},[],"PKCS#11 (HSM)",{"_4070":3073,"_34195":3048,"_23354":66091,"_5":16137,"_30763":66023,"_3518":66073},[],{"_4070":3074,"_34195":3048,"_23354":66093,"_5":16137,"_30763":66023,"_3518":66094},[],"In practice, post-quantum keys currently require the filesystem engine, which has security level 1. Keys with a higher assurance level, in a hardware security module or a cloud KMS, are not available for these algorithms.",{"_4070":3075,"_34195":3048,"_23354":66096,"_5":16137,"_30763":66023,"_3518":66097},[],"The Vault KV2 and AWS Secrets Manager engines list the post-quantum key types among the types they support, so a request passes the compatibility check. The creation then fails with an `unsupported key type` error from the engine. Select a filesystem or software engine explicitly with `engine_id`.",{"_4070":3076,"_34195":3048,"_23354":66099,"_5":16137,"_30763":66027,"_3518":66100},[],"A KMS key is created with the algorithm and size described in Algorithms:",{"_4070":3077,"_34195":3048,"_23354":66102,"_5":16137,"_30763":66027,"_3518":66103},[],"Invalid parameters are rejected with an explicit message: an ML-DSA size other than 44, 65 or 87, an SLH-DSA identifier outside 1 to 12, a composite variant outside 1 to 15, or a composite variant that does not belong to the requested family. Importing a private key in PKCS#8 form detects the algorithm and the parameter set automatically; the import accepts ML-DSA, SLH-DSA, composite and Ed25519 keys.",{"_4070":3078,"_34195":3048,"_23354":66105,"_5":16137,"_30763":66031,"_3518":66106},[],"A CA with a post-quantum key uses the same request as any other CA, sent to `POST /api/ca/v1/cas`. Only `key_metadata` changes, where `bits` carries the parameter set. A root CA with ML-DSA-65:",{"_4070":3079,"_34195":3048,"_23354":66108,"_5":16137,"_30763":66031,"_3518":66109},[],"A root CA with a composite key of ML-DSA-44 and ECDSA P-256 uses `\"key_metadata\": { \"type\": \"Composite-ML-DSA-ECDSA\", \"bits\": 9 }`. Ed25519 uses `\"type\": \"Ed25519\", \"bits\": 256` and SLH-DSA uses `\"type\": \"SLH-DSA\", \"bits\": 1` to select SLH-DSA-SHA2-128s. Subordinate CAs are created the same way: the subordinate signs its own certificate request with the KMS key and the parent CA issues the certificate.",{"_4070":3080,"_34195":3048,"_23354":66111,"_5":16137,"_30763":66031,"_3518":66112},[],"Existing CAs can be imported with a post-quantum private key for ML-DSA and Ed25519. Importing a CA with an SLH-DSA or composite key is not supported.",{"_4070":3081,"_34195":3048,"_23354":66114,"_5":16137,"_30763":66035,"_3518":66115},[],"The backend places no restriction on which algorithm issues which. A CA with an ML-DSA key can issue certificates to RSA, ECDSA, Ed25519 and ML-DSA subjects, and an RSA or ECDSA CA can issue certificates to post-quantum subjects. The test suite covers the full ML-DSA and Ed25519 matrix through the API, and covers SLH-DSA and composite CAs and leaves at the certificate engine level. This makes it possible to introduce a post-quantum CA beneath a classical root, or the reverse, but a relying party must be able to verify every algorithm in the chain. In TLS, the signatures in the certificate chain are checked against the client's `signature_algorithms_cert` extension, so a chain signed with ML-DSA or a composite algorithm needs a client that announces it there.",{"_4070":3082,"_34195":3048,"_23354":66117,"_5":16137,"_30763":66039,"_3518":66118},[],"The KMS signing endpoint accepts new `signature_algorithm` values. The `message_type` field is ignored for all of them. The ML-DSA, SLH-DSA and Ed25519 values are \"pure\": the message is signed directly, without pre-hashing (not HashML-DSA, HashSLH-DSA or Ed25519ph). The composite values hash the message with the hash of the variant and sign a message representative that includes a fixed label and the optional context.",{"_4070":3083,"_34195":3048,"_23354":66120,"_5":16137,"_30763":66039,"_3518":64615},[],{"_4070":3084,"_34195":3048,"_23354":66122,"_5":16137,"_30763":66039,"_3518":66123},[],"`signature_algorithm`",{"_4070":3085,"_34195":3048,"_23354":66125,"_5":16137,"_30763":66039,"_3518":66126},[],"ML-DSA-44, -65, -87",{"_4070":3086,"_34195":3048,"_23354":66128,"_5":16137,"_30763":66039,"_3518":66129},[],"`MLDSA_44_PURE`, `MLDSA_65_PURE`, `MLDSA_87_PURE`",{"_4070":3087,"_34195":3048,"_23354":66131,"_5":16137,"_30763":66039,"_3518":64701},[],{"_4070":3088,"_34195":3048,"_23354":66133,"_5":16137,"_30763":66039,"_3518":66134},[],"`SLHDSA_PURE`",{"_4070":3089,"_34195":3048,"_23354":66136,"_5":16137,"_30763":66039,"_3518":66137},[],"Composite",{"_4070":3090,"_34195":3048,"_23354":66139,"_5":16137,"_30763":66039,"_3518":66140},[],"`COMPOSITE_MLDSA_RSA_PURE`, `COMPOSITE_MLDSA_ECDSA_PURE`, `COMPOSITE_MLDSA_ED25519_PURE`",{"_4070":3091,"_34195":3048,"_23354":66142,"_5":16137,"_30763":66039,"_3518":64709},[],{"_4070":3092,"_34195":3048,"_23354":66144,"_5":16137,"_30763":66039,"_3518":66145},[],"`Ed25519_PURE`",{"_4070":3093,"_34195":3048,"_23354":66147,"_5":16137,"_30763":66039,"_3518":66148},[],"The backend does not check that the algorithm matches the key; choose the value that corresponds to the key type. When a CA signs a certificate or a revocation list, the algorithm is selected automatically.",{"_4070":3094,"_34195":3048,"_23354":66150,"_5":16137,"_30763":66043,"_3518":66151},[],"Several parts of the platform do not yet handle post-quantum keys. They are collected in Known limitations; the ones that affect daily operation are these.",{"_4070":3095,"_34195":3048,"_23354":66153,"_5":16137,"_30763":66043,"_3518":66154},[],"Issuance profiles enforce key restrictions only for RSA and ECDSA, through `allow_rsa_keys` and `allow_ecdsa_keys`. A profile with enforcement enabled does not block post-quantum keys, and has no switch to allow or deny them.",{"_4070":3096,"_34195":3048,"_23354":66156,"_5":16137,"_30763":66043,"_3518":66157},[],"The key strength recorded for a certificate whose key is post-quantum or Ed25519 is computed only for RSA and ECDSA, so those certificates are stored with an unknown key type and size and a low strength.",{"_4070":3097,"_34195":3048,"_23354":66159,"_5":16137,"_30763":66043,"_3518":66160},[],"OCSP responses are signed with the `golang.org/x/crypto/ocsp` library, which supports only RSA and ECDSA signing keys. A CA with a post-quantum, Ed25519 or composite key is therefore not expected to be able to sign OCSP responses; CRLs are produced with the fork and are not affected by this limit, although they are not covered by tests.",{"_4070":3098,"_34195":3048,"_23354":66162,"_5":16137,"_30763":66043,"_3518":66163},[],"Server-side key generation in the DMS (the EST `serverkeygen` operation) generates only RSA and ECDSA keys.",{"_4070":3099,"_34195":3048,"_23354":66165,"_5":16137,"_30763":66043,"_3518":66166},[],"<Card title=\"Related certificates\" description=\"Bind a post-quantum certificate to an existing classical one.\" href=\"/docs/platform/pqc/related-certificates\" />",{"_4070":3100,"_34195":3048,"_23354":66168,"_5":16137,"_30763":66043,"_3518":66169},[],"<Card title=\"Dashboard\" description=\"Create the same objects from the web interface.\" href=\"/docs/platform/pqc/dashboard\" />",{"_4070":3101,"_34195":3101,"_5":16540,"_3518":66171,"_34626":66172,"_23354":66174,"_30763":3101},"Known limitations",[56672,58140,64684,66173],"Reference",[],{"_4070":3102,"_34195":3101,"_23354":66176,"_5":16137,"_30763":3101,"_3518":66177},[],"What is incomplete, non-standard or unverified in Lamassu's post-quantum support, grouped by component.",{"_4070":3103,"_34195":3101,"_5":34623,"_23354":66179,"_30763":66180,"_3518":66181},[],"/docs/pr-preview/pr-58/platform/pqc/limitations#standards-and-interoperability","Standards and interoperability",{"_4070":3104,"_34195":3101,"_5":34623,"_23354":66183,"_30763":66184,"_3518":66185},[],"/docs/pr-preview/pr-58/platform/pqc/limitations#keys-and-engines","Keys and engines",{"_4070":3105,"_34195":3101,"_5":34623,"_23354":66187,"_30763":66188,"_3518":66189},[],"/docs/pr-preview/pr-58/platform/pqc/limitations#certificate-authority-and-validation","Certificate authority and validation",{"_4070":3106,"_34195":3101,"_5":34623,"_23354":66191,"_30763":66192,"_3518":65097},[],"/docs/pr-preview/pr-58/platform/pqc/limitations#dashboard",{"_4070":3107,"_34195":3101,"_5":34623,"_23354":66194,"_30763":66195,"_3518":66196},[],"/docs/pr-preview/pr-58/platform/pqc/limitations#build-and-deployment","Build and deployment",{"_4070":3108,"_34195":3101,"_23354":66198,"_5":16137,"_30763":3101,"_3518":66199},[],"This page collects the limits of the current implementation so they can be weighed before planning a deployment. Each one has been observed in the code or the tests of the branches described in this section.",{"_4070":3109,"_34195":3101,"_23354":66201,"_5":16137,"_30763":66180,"_3518":66202},[],"Composite certificates follow RFC 10073. The implementation was written against draft 19 and passes the RFC's test vectors, but it has not had a full conformance assessment. Three of its algorithms (the two Brainpool variants and Ed448) are not implemented. The composite signature schemes in TLS use private-use code points in `0xFE00` to `0xFE0E` because IANA has assigned none, so they interoperate only with peers built from the same Go fork. Composite RSA-PKCS#1 v1.5 variants cannot authenticate a TLS handshake. SLH-DSA has no TLS signature scheme. The related-certificate request attribute has not been checked against other implementations of RFC 9763.",{"_4070":3110,"_34195":3101,"_23354":66204,"_5":16137,"_30763":66184,"_3518":66205},[],"Post-quantum, composite and Ed25519 keys work only with the filesystem and software engines. The Vault KV2 and AWS Secrets Manager engines announce support and then fail at creation, and AWS KMS, Azure and PKCS#11 do not support them. There is therefore no hardware-backed or cloud-KMS-backed post-quantum key. Some engine error messages are copied from other engines and name the wrong one.",{"_4070":3111,"_34195":3101,"_23354":66207,"_5":16137,"_30763":66184,"_3518":66208},[],"The `CryptoEngine` interface gained methods to create and import each new key type. Engines developed outside the Lamassu repository must implement them.",{"_4070":3112,"_34195":3101,"_23354":66210,"_5":16137,"_30763":66188,"_3518":66211},[],"OCSP responses cannot be signed by a CA with a post-quantum, Ed25519 or composite key, because the signing library supports only RSA and ECDSA. CRL generation uses the fork's signing and is expected to work, but neither CRL nor OCSP has tests with these keys.",{"_4070":3113,"_34195":3101,"_23354":66213,"_5":16137,"_30763":66188,"_3518":66214},[],"Issuance profiles cannot allow or deny post-quantum algorithms; their enforcement applies only to RSA and ECDSA. The key strength of an issued certificate is computed only for RSA and ECDSA, so other certificates are stored with unknown type and size and low strength. Importing an existing CA with an SLH-DSA or composite key is not supported.",{"_4070":3114,"_34195":3101,"_23354":66216,"_5":16137,"_30763":66188,"_3518":66217},[],"The DMS can generate keys on the server only for RSA and ECDSA, so `serverkeygen` cannot return a post-quantum key. The enrollment flows through EST and the device manager have no tests with post-quantum keys.",{"_4070":3115,"_34195":3101,"_23354":66219,"_5":16137,"_30763":66188,"_3518":66220},[],"The backend does not evaluate the related-certificate extension. It only issues it.",{"_4070":3116,"_34195":3101,"_23354":66222,"_5":16137,"_30763":66192,"_3518":66223},[],"The in-browser SLH-DSA key generator maps parameter set identifiers differently from the rest of the interface, as described in Dashboard. Key type names are not uniform between screens, and the interface has no experimental notice and no translation.",{"_4070":3117,"_34195":3101,"_23354":66225,"_5":16137,"_30763":66195,"_3518":66226},[],"Everything depends on forks of Go and Traefik that are not upstream, and the proxy image has a mutable tag. The backend's OpenAPI specification for the KMS still lists only RSA, ECDSA and Ed25519 and does not reflect the new key types.",{"_4070":3118,"_34195":3101,"_23354":66228,"_5":16137,"_30763":66195,"_3518":66229},[],"The Helm chart uses fixed resource names, supports one release per namespace and sends traffic from Traefik to Envoy without verifying certificates. The post-quantum certificates created by the installer are valid for 365 days and are not renewed. The installer needs a Linux host and runs a Helm install, not an upgrade.",{"_4070":3119,"_34195":3101,"_23354":66231,"_5":16137,"_30763":66195,"_3518":66232},[],"<Card title=\"Post-quantum cryptography overview\" description=\"Return to the summary of the section.\" href=\"/docs/platform/pqc/overview\" />",{"_4070":3120,"_34195":3120,"_5":16540,"_3518":66234,"_34626":66235,"_23354":66236,"_30763":3120},"Post-quantum cryptography overview",[56672,58140,64684],[],{"_4070":3121,"_34195":3120,"_23354":66238,"_5":16137,"_30763":3120,"_3518":66239},[],"What post-quantum (PQC) support Lamassu adds to keys, certificate authorities, device TLS and deployment, and how its pieces fit together.",{"_4070":3122,"_34195":3120,"_5":34623,"_23354":66241,"_30763":66242,"_3518":66243},[],"/docs/pr-preview/pr-58/platform/pqc/overview#why-it-matters-for-device-fleets","Why it matters for device fleets",{"_4070":3123,"_34195":3120,"_5":34623,"_23354":66245,"_30763":66246,"_3518":66247},[],"/docs/pr-preview/pr-58/platform/pqc/overview#three-families-of-algorithms","Three families of algorithms",{"_4070":3124,"_34195":3120,"_5":34623,"_23354":66249,"_30763":66250,"_3518":66251},[],"/docs/pr-preview/pr-58/platform/pqc/overview#how-the-pieces-fit","How the pieces fit",{"_4070":3125,"_34195":3120,"_5":34623,"_23354":66253,"_30763":66254,"_3518":66255},[],"/docs/pr-preview/pr-58/platform/pqc/overview#where-to-read-next","Where to read next",{"_4070":3126,"_34195":3120,"_23354":66257,"_5":16137,"_30763":3120,"_3518":66258},[],"Lamassu can create keys, certificate authorities (CAs) and certificates that use post-quantum signature algorithms, and it can serve and verify them over TLS. The work spans five codebases that depend on one another: a fork of the Go toolchain that implements the algorithms, the Lamassu backend, the web dashboard, a fork of the Traefik proxy that terminates TLS for devices, and the Helm chart that deploys all of it together.",{"_4070":3127,"_34195":3120,"_23354":66260,"_5":16137,"_30763":3120,"_3518":66261},[],"PQC support lives in development branches and in forks of Go and Traefik, not in the upstream projects or in the standard Lamassu images. The composite TLS signature schemes use private-use code points that no other TLS stack understands, and the composite certificate format follows RFC 10073, a recent standard that has little deployment experience yet. Plan pilots and laboratory deployments, not production fleets. Known limitations lists what is incomplete.",{"_4070":3128,"_34195":3120,"_23354":66263,"_5":16137,"_30763":66242,"_3518":66264},[],"Certificates issued to devices often live for years, and the devices that hold them are hard to replace. A signature algorithm that is broken by a future quantum computer would force a fleet-wide re-enrollment. Issuing devices a certificate signed with a post-quantum or composite algorithm today, and serving them a TLS endpoint that accepts it, lets a fleet be validated against that risk before it becomes urgent. Signatures are not exposed to \"harvest now, decrypt later\" attacks the way a key exchange is, so the urgency is about the lifetime of certificates and devices, not about recorded traffic.",{"_4070":3129,"_34195":3120,"_23354":66266,"_5":16137,"_30763":66246,"_3518":66267},[],"Lamassu groups signature algorithms in three families, the same labels the dashboard shows.",{"_4070":3130,"_34195":3120,"_23354":66269,"_5":16137,"_30763":66246,"_3518":66270},[],"Label",{"_4070":3131,"_34195":3120,"_23354":66272,"_5":16137,"_30763":66246,"_3518":64925},[],{"_4070":3132,"_34195":3120,"_23354":66274,"_5":16137,"_30763":66246,"_3518":64682},[],{"_4070":3133,"_34195":3120,"_23354":66276,"_5":16137,"_30763":66246,"_3518":65635},[],{"_4070":3134,"_34195":3120,"_23354":66278,"_5":16137,"_30763":66246,"_3518":66279},[],"Traditional",{"_4070":3135,"_34195":3120,"_23354":66281,"_5":16137,"_30763":66246,"_3518":66282},[],"RSA, ECDSA, Ed25519",{"_4070":3136,"_34195":3120,"_23354":66284,"_5":16137,"_30763":66246,"_3518":65647},[],{"_4070":3137,"_34195":3120,"_23354":66286,"_5":16137,"_30763":66246,"_3518":66287},[],"Pure post-quantum",{"_4070":3138,"_34195":3120,"_23354":66289,"_5":16137,"_30763":66246,"_3518":66290},[],"ML-DSA, SLH-DSA",{"_4070":3139,"_34195":3120,"_23354":66292,"_5":16137,"_30763":66246,"_3518":65659},[],{"_4070":3140,"_34195":3120,"_23354":66294,"_5":16137,"_30763":66246,"_3518":66295},[],"Hybrid (composite)",{"_4070":3141,"_34195":3120,"_23354":66297,"_5":16137,"_30763":66246,"_3518":66298},[],"ML-DSA combined with RSA, ECDSA or Ed25519 in a single key and a single signature",{"_4070":3142,"_34195":3120,"_23354":66300,"_5":16137,"_30763":66246,"_3518":66301},[],"A composite signature is valid only if both of its components verify. Its unforgeability is intended to hold as long as at least one of the two algorithms remains unbroken, provided the relying party requires the composite and does not fall back to a classical certificate. In the key exchange, `PQ/T` means a hybrid group that combines a classical and an ML-KEM exchange, and `PQ` means pure ML-KEM. Algorithms describes each one and the parameter sets Lamassu accepts.",{"_4070":3143,"_34195":3120,"_23354":66303,"_5":16137,"_30763":66250,"_3518":66304},[],"The Go fork is the foundation: the backend and Traefik are compiled with it, because the standard Go toolchain does not provide the composite and SLH-DSA certificate support. The backend creates and holds the keys, issues certificates and signs revocation data. The dashboard drives the same REST API. Devices reach the platform through Traefik, which negotiates post-quantum authentication and key exchange with the device and then forwards the request to Envoy Gateway over ordinary TLS. Post-quantum protection therefore applies only to the hop between the device and Traefik.",{"_4070":3144,"_34195":3120,"_23354":66306,"_5":16137,"_30763":66254,"_3518":66307},[],"Read Algorithms first to learn what is supported and how parameter sets are written in API requests. Developers writing a device client should continue with Go PQC toolchain. Administrators who want to create a post-quantum CA follow Keys and certificate authorities, and those who deploy the platform go to Deployment with the Helm chart.",{"_4070":3145,"_34195":3120,"_23354":66309,"_5":16137,"_30763":66254,"_3518":66310},[],"<Card title=\"Algorithms\" description=\"ML-DSA, SLH-DSA and the 15 composite algorithms, with their parameter sets.\" href=\"/docs/platform/pqc/algorithms\" />",{"_4070":3146,"_34195":3120,"_23354":66312,"_5":16137,"_30763":66254,"_3518":66313},[],"<Card title=\"Keys and certificate authorities\" description=\"Create post-quantum keys and CAs and issue certificates through the API.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_4070":3147,"_34195":3120,"_23354":66315,"_5":16137,"_30763":66254,"_3518":66316},[],"<Card title=\"Deployment with the Helm chart\" description=\"Install the platform with a Traefik front proxy that serves PQC certificates.\" href=\"/docs/platform/pqc/deployment\" />",{"_4070":3148,"_34195":3148,"_5":16540,"_3518":65119,"_34626":66318,"_23354":66319,"_30763":3148},[56672,58140,64684,65099],[],{"_4070":3149,"_34195":3148,"_23354":66321,"_5":16137,"_30763":3148,"_3518":66322},[],"Bind a certificate with a post-quantum key to an existing classical certificate of the same device, following RFC 9763, and how Lamassu issues and checks them.",{"_4070":3150,"_34195":3148,"_5":34623,"_23354":66324,"_30763":66325,"_3518":66326},[],"/docs/pr-preview/pr-58/platform/pqc/related-certificates#how-the-request-works","How the request works",{"_4070":3151,"_34195":3148,"_5":34623,"_23354":66328,"_30763":66329,"_3518":66330},[],"/docs/pr-preview/pr-58/platform/pqc/related-certificates#locations-the-ca-may-fetch-from","Locations the CA may fetch from",{"_4070":3152,"_34195":3148,"_5":34623,"_23354":66332,"_30763":66333,"_3518":66334},[],"/docs/pr-preview/pr-58/platform/pqc/related-certificates#configure-an-issuance-profile","Configure an issuance profile",{"_4070":3153,"_34195":3148,"_5":34623,"_23354":66336,"_30763":66337,"_3518":66338},[],"/docs/pr-preview/pr-58/platform/pqc/related-certificates#what-the-issued-certificate-must-satisfy","What the issued certificate must satisfy",{"_4070":3154,"_34195":3148,"_5":34623,"_23354":66340,"_30763":66341,"_3518":66342},[],"/docs/pr-preview/pr-58/platform/pqc/related-certificates#from-the-dashboard","From the dashboard",{"_4070":3155,"_34195":3148,"_23354":66344,"_5":16137,"_30763":3148,"_3518":66345},[],"A fleet that is migrating to post-quantum algorithms usually holds two certificates per device for a while: the classical one already in use and a new one with a post-quantum key. RFC 9763 defines a way to link them. The new certificate carries the `id-pe-relatedCert` extension (`1.3.6.1.5.5.7.1.36`), which holds a hash of the classical certificate, so a relying party can see that both identify the same entity. Lamassu implements the issuing side of this mechanism.",{"_4070":3156,"_34195":3148,"_23354":66347,"_5":16137,"_30763":3148,"_3518":66348},[],"This option fits when:",{"_4070":3157,"_34195":3148,"_23354":66350,"_5":16137,"_30763":3148,"_3518":66351},[],"the consumers cannot yet validate post-quantum or composite chains, so the classical certificate must remain the one in use;",{"_4070":3158,"_34195":3148,"_23354":66353,"_5":16137,"_30763":3148,"_3518":66354},[],"a device has to carry both certificates and show that they belong together, using each one where the peer supports it.",{"_4070":3159,"_34195":3148,"_23354":66356,"_5":16137,"_30763":3148,"_3518":66357},[],"The hash is SHA-256, SHA-384 or SHA-512, matching the hash of the related certificate's signature algorithm, and SHA-256 when it has none.",{"_4070":3160,"_34195":3148,"_23354":66359,"_5":16137,"_30763":66325,"_3518":66360},[],"The device asks for the bound certificate with an ordinary PKCS#10 certificate request that carries one extra attribute, `relatedCertRequest` (`1.2.840.113549.1.9.16.2.60`). The attribute identifies the existing certificate by issuer and serial number, states the time of the request, gives the location from which the certificate can be downloaded and carries a signature made with the private key of that existing certificate. The signature covers the issuer, the serial number and the request time, not the location, and shows that the requester controls the existing key; the key of the new certificate is proven by the signature of the certificate request itself. Lamassu accepts a list of locations, as in the ASN.1 module of the RFC, and tries them in order.",{"_4070":3161,"_34195":3148,"_23354":66362,"_5":16137,"_30763":66325,"_3518":66363},[],"When the CA service receives such a request it follows these steps:",{"_4070":3162,"_34195":3148,"_23354":66365,"_5":16137,"_30763":66325,"_3518":66366},[],"It checks that the issuance profile in use enables related certificates, and rejects the request otherwise.",{"_4070":3163,"_34195":3148,"_23354":66368,"_5":16137,"_30763":66325,"_3518":66369},[],"It reads the locations in the attribute in order and downloads the first certificate it can retrieve.",{"_4070":3164,"_34195":3148,"_23354":66371,"_5":16137,"_30763":66325,"_3518":66372},[],"It verifies that the issuer and serial number match, that the request time is within the allowed age, and that the signature is valid with the downloaded certificate's key.",{"_4070":3165,"_34195":3148,"_23354":66374,"_5":16137,"_30763":66325,"_3518":66375},[],"It issues the new certificate with the related certificate extension added.",{"_4070":3166,"_34195":3148,"_23354":66377,"_5":16137,"_30763":66325,"_3518":66378},[],"A request without the attribute is processed as usual, whether or not the profile enables the feature.",{"_4070":3167,"_34195":3148,"_23354":66380,"_5":16137,"_30763":66329,"_3518":66381},[],"A location is either a `data:` URI or an `http` or `https` URL. A `data:` URI must be base64-encoded and contains a PKCS#7 structure whose first certificate is the related one; it needs no network access and is always accepted when the feature is enabled. A URL is retrieved only if its host appears in the profile's list of allowed hosts. The CA does not follow redirects, applies a ten-second timeout and rejects responses larger than 1 MiB.",{"_4070":3168,"_34195":3148,"_23354":66383,"_5":16137,"_30763":66329,"_3518":66384},[],"Because the server performs the download, whoever can define an issuance profile decides which hosts the CA is allowed to contact. Restrict that permission accordingly and list only internal certificate repositories.",{"_4070":3169,"_34195":3148,"_23354":66386,"_5":16137,"_30763":66333,"_3518":66387},[],"The feature is configured in the `related_certificate` object of the issuance profile, which is stored with its own database columns:",{"_4070":3170,"_34195":3148,"_23354":66389,"_5":16137,"_30763":66333,"_3518":66390},[],"Field",{"_4070":3171,"_34195":3148,"_23354":66392,"_5":16137,"_30763":66333,"_3518":60824},[],{"_4070":3172,"_34195":3148,"_23354":66394,"_5":16137,"_30763":66333,"_3518":57059},[],{"_4070":3173,"_34195":3148,"_23354":66396,"_5":16137,"_30763":66333,"_3518":60830},[],{"_4070":3174,"_34195":3148,"_23354":66398,"_5":16137,"_30763":66333,"_3518":66399},[],"`enabled`",{"_4070":3175,"_34195":3148,"_23354":66401,"_5":16137,"_30763":66333,"_3518":21992},[],{"_4070":3176,"_34195":3148,"_23354":66403,"_5":16137,"_30763":66333,"_3518":65249},[],{"_4070":3177,"_34195":3148,"_23354":66405,"_5":16137,"_30763":66333,"_3518":66406},[],"When `false`, a request that carries the attribute is rejected.",{"_4070":3178,"_34195":3148,"_23354":66408,"_5":16137,"_30763":66333,"_3518":66409},[],"`allowed_hosts`",{"_4070":3179,"_34195":3148,"_23354":66411,"_5":16137,"_30763":66333,"_3518":66412},[],"list of strings",{"_4070":3180,"_34195":3148,"_23354":66414,"_5":16137,"_30763":66333,"_3518":21265},[],{"_4070":3181,"_34195":3148,"_23354":66416,"_5":16137,"_30763":66333,"_3518":66417},[],"Hosts from which `http` and `https` locations may be downloaded.",{"_4070":3182,"_34195":3148,"_23354":66419,"_5":16137,"_30763":66333,"_3518":66420},[],"`max_age`",{"_4070":3183,"_34195":3148,"_23354":66422,"_5":16137,"_30763":66333,"_3518":6532},[],{"_4070":3184,"_34195":3148,"_23354":66424,"_5":16137,"_30763":66333,"_3518":66425},[],"`5m`",{"_4070":3185,"_34195":3148,"_23354":66427,"_5":16137,"_30763":66333,"_3518":66428},[],"Maximum difference between the request time in the attribute and the time of issuance.",{"_4070":3186,"_34195":3148,"_23354":66430,"_5":16137,"_30763":66337,"_3518":66431},[],"The fork refuses to bind a certificate unless the new one is compatible with the related one. Neither certificate may be a CA. The related certificate must be valid at the time of issuance. The key usages and extended key usages requested for the new certificate must be a subset of those of the related certificate. Verification later compares only the hash, so a relying party that checks the link learns that the issuing CA linked the new certificate to that specific certificate, not that the related certificate is still valid.",{"_4070":3187,"_34195":3148,"_23354":66433,"_5":16137,"_30763":66337,"_3518":66434},[],"The extension is evidence of a relationship, not a dependency. A relying party must still validate each certificate against its own chain and revocation status, and revoking the classical certificate does not revoke the bound one.",{"_4070":3188,"_34195":3148,"_23354":66436,"_5":16137,"_30763":66341,"_3518":66437},[],"The dashboard exposes the feature in two places. The issuance profile form has a *Related Certificates* section with a switch, the allowed hosts and the maximum age. When issuing a certificate from a CA with a browser-generated key and a profile that enables the feature, the form offers *Bind to a related certificate*: the user supplies the existing certificate, or its issuer and serial number, signs the data shown with the existing key outside the browser, and pastes the signature. Certificate and CA details show a *Related Certificate* row with the hash algorithm and value. See Dashboard.",{"_4070":3189,"_34195":3148,"_23354":66439,"_5":16137,"_30763":66341,"_3518":66440},[],"The bound certificate is created by the fork's `CreateBoundCertificate`, whose tests cover an ML-DSA key bound to RSA, ECDSA and Ed25519 certificates. The tests do not use composite keys. Only the issuing side is implemented in Lamassu: the platform does not evaluate the extension when it validates certificates.",{"_4070":3190,"_34195":3148,"_23354":66442,"_5":16137,"_30763":66341,"_3518":66443},[],"<Card title=\"Keys and certificate authorities\" description=\"Create the post-quantum CA that issues the bound certificate.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_4070":3191,"_34195":3148,"_23354":66445,"_5":16137,"_30763":66341,"_3518":66446},[],"<Card title=\"Known limitations\" description=\"What is not covered yet.\" href=\"/docs/platform/pqc/limitations\" />",{"_4070":3192,"_34195":3192,"_5":16540,"_3518":66448,"_34626":66449,"_23354":66450,"_30763":3192},"TLS front proxy with Traefik",[56672,58140,64684,56673],[],{"_4070":3193,"_34195":3192,"_23354":66452,"_5":16137,"_30763":3192,"_3518":66453},[],"The Traefik fork that terminates device TLS with classical and post-quantum certificates for the same host, how it picks a certificate and how it is built.",{"_4070":3194,"_34195":3192,"_5":34623,"_23354":66455,"_30763":66456,"_3518":66457},[],"/docs/pr-preview/pr-58/platform/pqc/tls-front-proxy#several-certificates-for-the-same-host","Several certificates for the same host",{"_4070":3195,"_34195":3192,"_5":34623,"_23354":66459,"_30763":66460,"_3518":66461},[],"/docs/pr-preview/pr-58/platform/pqc/tls-front-proxy#tls-options-on-gateway-api-listeners","TLS options on Gateway API listeners",{"_4070":3196,"_34195":3192,"_5":34623,"_23354":66463,"_30763":66464,"_3518":66465},[],"/docs/pr-preview/pr-58/platform/pqc/tls-front-proxy#mutual-tls","Mutual TLS",{"_4070":3197,"_34195":3192,"_5":34623,"_23354":66467,"_30763":66468,"_3518":66469},[],"/docs/pr-preview/pr-58/platform/pqc/tls-front-proxy#building-the-proxy","Building the proxy",{"_4070":3198,"_34195":3192,"_23354":66471,"_5":16137,"_30763":3192,"_3518":66472},[],"Devices connect to Lamassu over TLS, and EST enrollment relies on mutual TLS. To accept a post-quantum or composite certificate on that connection, the TLS endpoint must be built with the Go PQC toolchain. Lamassu does this with a fork of Traefik, based on Traefik 3.7.15, that sits in front of Envoy Gateway. The fork adds two behaviours: it can serve several certificates for the same host and chooses among them per client, and it lets a Gateway API listener reference a Traefik TLS option.",{"_4070":3199,"_34195":3192,"_23354":66474,"_5":16137,"_30763":66456,"_3518":66475},[],"Upstream Traefik keeps one certificate per set of names. If a classical ECDSA certificate and an ML-DSA certificate exist for `lab.example.com`, only the first is kept. The fork stores every distinct certificate (duplicates are detected by comparing the leaf certificate) and chooses one for each handshake.",{"_4070":3200,"_34195":3192,"_23354":66477,"_5":16137,"_30763":66456,"_3518":66478},[],"The choice follows the signature algorithms the client announces:",{"_4070":3201,"_34195":3192,"_23354":66480,"_5":16137,"_30763":66456,"_3518":66481},[],"The server name from the client is normalized and the certificates whose names match it are collected, with exact names ahead of wildcards. A common-name-only certificate still matches.",{"_4070":3202,"_34195":3192,"_23354":66483,"_5":16137,"_30763":66456,"_3518":66484},[],"If no certificate matches, the connection is closed in strict-SNI mode, or the default certificate is served.",{"_4070":3203,"_34195":3192,"_23354":66486,"_5":16137,"_30763":66456,"_3518":66487},[],"If exactly one certificate matches, it is served without further checks.",{"_4070":3204,"_34195":3192,"_23354":66489,"_5":16137,"_30763":66456,"_3518":66490},[],"Otherwise the proxy takes the client's signature schemes in the order the client sent them, and for each scheme returns the first certificate whose key the scheme, the TLS version and the key type allow. This matches the leaf key against `signature_algorithms`, the schemes the client accepts for the handshake signature; the signatures in the rest of the chain are a separate check against `signature_algorithms_cert`.",{"_4070":3205,"_34195":3192,"_23354":66492,"_5":16137,"_30763":66456,"_3518":66493},[],"If the client announces no scheme, the first compatible certificate is returned. If none is compatible, the first candidate is returned and the handshake fails with the underlying error.",{"_4070":3206,"_34195":3192,"_23354":66495,"_5":16137,"_30763":66456,"_3518":66496},[],"The client's order of preference prevails, so a client that lists ML-DSA first receives the post-quantum certificate and a client that lists ECDSA first receives the classical one, even if it also supports ML-DSA. A client with no post-quantum support never announces those schemes and receives the classical certificate. TLS 1.2 never selects ML-DSA or composite certificates. The server cannot be configured with its own order of preference.",{"_4070":3207,"_34195":3192,"_23354":66498,"_5":16137,"_30763":66460,"_3518":66499},[],"Traefik reads its Gateway API configuration from Kubernetes. The fork reads the listener option `traefik.io/tls-options`, whose value names the TLS option to apply to that listener: either `default`, or a qualified name such as `traefik-system-pqc@kubernetescrd`. This works for HTTPS listeners and for TLS listeners in `Terminate` mode that serve a `TLSRoute`. It is ignored in passthrough mode.",{"_4070":3208,"_34195":3192,"_23354":66501,"_5":16137,"_30763":66460,"_3518":66502},[],"A TLS option is where the supported key exchange groups and the client authentication mode are set. When several listeners share a parent router and name different options, the proxy logs a warning and uses isolated defaults for each. Without the fork, Traefik ignores the annotation, applies its own defaults and the settings cannot be controlled; devices that need mutual TLS then fail.",{"_4070":3209,"_34195":3192,"_23354":66504,"_5":16137,"_30763":66460,"_3518":66505},[],"The fork also adds `mlkem1024` to the group names accepted in `curvePreferences`, next to the hybrid groups that Traefik already maps.",{"_4070":3210,"_34195":3192,"_23354":66507,"_5":16137,"_30763":66464,"_3518":66508},[],"Client authentication is the standard Traefik mechanism, configured in the TLS option. With `RequireAndVerifyClientCert` and a client CA file the proxy validates the chain, and the verification of the client signature is done by the TLS stack of the Go fork, which has been tested with composite client certificates in a TLS 1.3 handshake. With `RequestClientCert`, which the Lamassu chart sets in its default option, the proxy checks that the client holds the key of the certificate it presents but does not validate the chain; the decision is delegated to the backend, which receives the certificate in a header (see Deployment with the Helm chart). No Traefik test covers post-quantum mutual TLS, and a client chain signed by a composite or post-quantum CA depends on the x509 code of the fork.",{"_4070":3211,"_34195":3192,"_23354":66510,"_5":16137,"_30763":66468,"_3518":66511},[],"The fork is not built from the Go image. The `build.sh` script requires an already compiled checkout of the Go fork, by default in `../go`, and checks that it is the fork before it forces `GOROOT` and `GOTOOLCHAIN=local`. It compiles the binary with `CGO_ENABLED=0`, builds the web UI unless `SKIP_WEBUI=1`, and packages the binary into an Alpine image with `docker buildx`. The default image is `ghcr.io/lamassuiot/traefik:pqc-3.7.15`.",{"_4070":3212,"_34195":3192,"_23354":66513,"_5":16137,"_30763":66468,"_3518":66514},[],"Variable",{"_4070":3213,"_34195":3192,"_23354":66516,"_5":16137,"_30763":66468,"_3518":57062},[],{"_4070":3214,"_34195":3192,"_23354":66518,"_5":16137,"_30763":66468,"_3518":66519},[],"`GO_FORK_ROOT`",{"_4070":3215,"_34195":3192,"_23354":66521,"_5":16137,"_30763":66468,"_3518":66522},[],"Location of the compiled Go fork.",{"_4070":3216,"_34195":3192,"_23354":66524,"_5":16137,"_30763":66468,"_3518":66525},[],"`PLATFORMS`",{"_4070":3217,"_34195":3192,"_23354":66527,"_5":16137,"_30763":66468,"_3518":66528},[],"Target platforms; the default is `linux/amd64`.",{"_4070":3218,"_34195":3192,"_23354":66530,"_5":16137,"_30763":66468,"_3518":66531},[],"`SKIP_WEBUI`",{"_4070":3219,"_34195":3192,"_23354":66533,"_5":16137,"_30763":66468,"_3518":66534},[],"Skip building the web UI when set to `1`.",{"_4070":3220,"_34195":3192,"_23354":66536,"_5":16137,"_30763":66468,"_3518":66537},[],"`IMAGE`, `PUSH`",{"_4070":3221,"_34195":3192,"_23354":66539,"_5":16137,"_30763":66468,"_3518":66540},[],"Name of the image and whether to push it. Multi-platform builds require `PUSH=1`.",{"_4070":3222,"_34195":3192,"_23354":66542,"_5":16137,"_30763":66468,"_3518":66543},[],"The `pqc-*` tags are mutable and have been rebuilt in place, so pin the digest in production-like environments.",{"_4070":3223,"_34195":3192,"_23354":66545,"_5":16137,"_30763":66468,"_3518":66546},[],"The selection tests of the fork use pure ML-DSA-65 together with ECDSA P-256. Selecting a composite certificate depends on the fork's TLS stack knowing the composite key, which it does, but the proxy has no test for it.",{"_4070":3224,"_34195":3192,"_23354":66548,"_5":16137,"_30763":66468,"_3518":66549},[],"<Card title=\"Deployment with the Helm chart\" description=\"Install the proxy in front of Envoy Gateway with the chart.\" href=\"/docs/platform/pqc/deployment\" />",{"_4070":3225,"_34195":3192,"_23354":66551,"_5":16137,"_30763":66468,"_3518":66552},[],"<Card title=\"Known limitations\" description=\"Interoperability and operational caveats.\" href=\"/docs/platform/pqc/limitations\" />",{"_4070":3226,"_34195":3226,"_5":16540,"_3518":66554,"_34626":66555,"_23354":66556,"_30763":3226},"Security",[56672],[],{"_4070":3227,"_34195":3226,"_23354":66558,"_5":16137,"_30763":3226,"_3518":66559},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_4070":3228,"_34195":3226,"_5":34623,"_23354":66561,"_30763":66562,"_3518":66563},[],"/docs/pr-preview/pr-58/security#report-a-vulnerability","Report a vulnerability",{"_4070":3229,"_34195":3226,"_5":34623,"_23354":66565,"_30763":66566,"_3518":66567},[],"/docs/pr-preview/pr-58/security#what-to-include-in-a-report","What to include in a report",{"_4070":3230,"_34195":3226,"_5":34623,"_23354":66569,"_30763":66570,"_3518":66571},[],"/docs/pr-preview/pr-58/security#supported-versions","Supported versions",{"_4070":3231,"_34195":3226,"_5":34623,"_23354":66573,"_30763":66574,"_3518":66575},[],"/docs/pr-preview/pr-58/security#responsible-disclosure","Responsible disclosure",{"_4070":3232,"_34195":3226,"_23354":66577,"_5":16137,"_30763":3226,"_3518":66578},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_4070":3233,"_34195":3226,"_23354":66580,"_5":16137,"_30763":66562,"_3518":66581},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_4070":3234,"_34195":3226,"_23354":66583,"_5":16137,"_30763":66562,"_3518":66584},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_4070":3235,"_34195":3226,"_23354":66586,"_5":16137,"_30763":66562,"_3518":16895},[],{"_4070":3236,"_34195":3226,"_23354":66588,"_5":16137,"_30763":66562,"_3518":16831},[],{"_4070":3237,"_34195":3226,"_23354":66590,"_5":16137,"_30763":66562,"_3518":16888},[],{"_4070":3238,"_34195":3226,"_23354":66592,"_5":16137,"_30763":66562,"_3518":66593},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_4070":3239,"_34195":3226,"_23354":66595,"_5":16137,"_30763":66562,"_3518":66596},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_4070":3240,"_34195":3226,"_23354":66598,"_5":16137,"_30763":66566,"_3518":66599},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_4070":3241,"_34195":3226,"_23354":66601,"_5":16137,"_30763":66566,"_3518":66602},[],"Do not include in the report:",{"_4070":3242,"_34195":3226,"_23354":66604,"_5":16137,"_30763":66566,"_3518":66605},[],"Credentials, tokens, or private keys",{"_4070":3243,"_34195":3226,"_23354":66607,"_5":16137,"_30763":66566,"_3518":66608},[],"Customer data or customer-identifiable information",{"_4070":3244,"_34195":3226,"_23354":66610,"_5":16137,"_30763":66566,"_3518":66611},[],"Confidential architecture or internal infrastructure details",{"_4070":3245,"_34195":3226,"_23354":66613,"_5":16137,"_30763":66570,"_3518":66614},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_4070":3246,"_34195":3226,"_23354":66616,"_5":16137,"_30763":66570,"_3518":66617},[],"For upgrade guidance, see Upgrades.",{"_4070":3247,"_34195":3226,"_23354":66619,"_5":16137,"_30763":66574,"_3518":66620},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_4070":3248,"_34195":3226,"_23354":66622,"_5":16137,"_30763":66574,"_3518":66623},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_4070":3249,"_34195":3226,"_23354":66625,"_5":16137,"_30763":66574,"_3518":66626},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_4070":3250,"_34195":3226,"_23354":66628,"_5":16137,"_30763":66574,"_3518":66629},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_4070":3251,"_34195":3226,"_23354":66631,"_5":16137,"_30763":66574,"_3518":66632},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_4070":3252,"_34195":3252,"_5":16540,"_3518":66634,"_34626":66635,"_23354":66637,"_30763":3252},"3.8.0 to 4.0.0",[56672,66636],"Upgrades",[],{"_4070":3253,"_34195":3252,"_23354":66639,"_5":16137,"_30763":3252,"_3518":66640},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_4070":3254,"_34195":3252,"_5":34623,"_23354":66642,"_30763":66643,"_3518":66644},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_4070":3255,"_34195":3252,"_5":34623,"_23354":66646,"_30763":66647,"_3518":66648},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_4070":3256,"_34195":3252,"_5":34623,"_23354":66650,"_30763":66651,"_3518":66652},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_4070":3257,"_34195":3252,"_5":34623,"_23354":66654,"_30763":66655,"_3518":66656},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_4070":3258,"_34195":3252,"_5":34623,"_23354":66658,"_30763":66659,"_3518":66660},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_4070":3259,"_34195":3252,"_5":34623,"_23354":66662,"_30763":66663,"_3518":66664},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_4070":3260,"_34195":3252,"_5":34623,"_23354":66666,"_30763":66667,"_3518":66668},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_4070":3261,"_34195":3252,"_5":34623,"_23354":66670,"_30763":66671,"_3518":66672},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_4070":3262,"_34195":3252,"_5":34623,"_23354":66674,"_30763":66675,"_3518":66676},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_4070":3263,"_34195":3252,"_5":34623,"_23354":66678,"_30763":66679,"_3518":66680},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_4070":3264,"_34195":3252,"_5":34623,"_23354":66682,"_30763":66683,"_3518":66684},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_4070":3265,"_34195":3252,"_5":34623,"_23354":66686,"_30763":66687,"_3518":66688},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_4070":3266,"_34195":3252,"_5":34623,"_23354":66690,"_30763":66691,"_3518":66692},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_4070":3267,"_34195":3252,"_5":34623,"_23354":66694,"_30763":66695,"_3518":66696},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_4070":3268,"_34195":3252,"_5":34623,"_23354":66698,"_30763":66699,"_3518":66700},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_4070":3269,"_34195":3252,"_5":34623,"_23354":66702,"_30763":66703,"_3518":66704},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_4070":3270,"_34195":3252,"_5":34623,"_23354":66706,"_30763":66707,"_3518":66708},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_4070":3271,"_34195":3252,"_5":34623,"_23354":66710,"_30763":66711,"_3518":66712},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_4070":3272,"_34195":3252,"_5":34623,"_23354":66714,"_30763":66715,"_3518":66716},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_4070":3273,"_34195":3252,"_5":34623,"_23354":66718,"_30763":66719,"_3518":66720},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-va-roles","References between certificates, keys and VA roles",{"_4070":3274,"_34195":3252,"_5":34623,"_23354":66722,"_30763":66723,"_3518":66724},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_4070":3275,"_34195":3252,"_5":34623,"_23354":66726,"_30763":66727,"_3518":66728},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_4070":3276,"_34195":3252,"_5":34623,"_23354":66730,"_30763":66731,"_3518":66732},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_4070":3277,"_34195":3252,"_5":34623,"_23354":66734,"_30763":66735,"_3518":66736},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_4070":3278,"_34195":3252,"_5":34623,"_23354":66738,"_30763":66739,"_3518":66740},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_4070":3279,"_34195":3252,"_5":34623,"_23354":66742,"_30763":66743,"_3518":66744},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_4070":3280,"_34195":3252,"_5":34623,"_23354":66746,"_30763":66747,"_3518":66748},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_4070":3281,"_34195":3252,"_5":34623,"_23354":66750,"_30763":66751,"_3518":66752},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#va-role-signer-field","VA role signer field",{"_4070":3282,"_34195":3252,"_5":34623,"_23354":66754,"_30763":66755,"_3518":66756},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_4070":3283,"_34195":3252,"_5":34623,"_23354":66758,"_30763":66759,"_3518":66760},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_4070":3284,"_34195":3252,"_5":34623,"_23354":66762,"_30763":66763,"_3518":66764},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_4070":3285,"_34195":3252,"_5":34623,"_23354":66766,"_30763":66767,"_3518":66768},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_4070":3286,"_34195":3252,"_5":34623,"_23354":66770,"_30763":66771,"_3518":66772},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_4070":3287,"_34195":3252,"_5":34623,"_23354":66774,"_30763":66775,"_3518":66776},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_4070":3288,"_34195":3252,"_5":34623,"_23354":66778,"_30763":66779,"_3518":66780},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_4070":3289,"_34195":3252,"_5":34623,"_23354":66782,"_30763":66783,"_3518":60717},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_4070":3290,"_34195":3252,"_5":34623,"_23354":66785,"_30763":66786,"_3518":66787},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_4070":3291,"_34195":3252,"_5":34623,"_23354":66789,"_30763":66790,"_3518":66791},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_4070":3292,"_34195":3252,"_23354":66793,"_5":16137,"_30763":3252,"_3518":66794},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_4070":3293,"_34195":3252,"_23354":66796,"_5":16137,"_30763":3252,"_3518":66797},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_4070":3294,"_34195":3252,"_23354":66799,"_5":16137,"_30763":3252,"_3518":66800},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_4070":3295,"_34195":3252,"_23354":66802,"_5":16137,"_30763":3252,"_3518":66803},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_4070":3296,"_34195":3252,"_23354":66805,"_5":16137,"_30763":3252,"_3518":66806},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_4070":3297,"_34195":3252,"_23354":66808,"_5":16137,"_30763":3252,"_3518":66809},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_4070":3298,"_34195":3252,"_23354":66811,"_5":16137,"_30763":3252,"_3518":66812},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_4070":3299,"_34195":3252,"_23354":66814,"_5":16137,"_30763":66647,"_3518":66815},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_4070":3300,"_34195":3252,"_23354":66817,"_5":16137,"_30763":66647,"_3518":66818},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_4070":3301,"_34195":3252,"_23354":66820,"_5":16137,"_30763":66651,"_3518":66821},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_4070":3302,"_34195":3252,"_23354":66823,"_5":16137,"_30763":66651,"_3518":66824},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_4070":3303,"_34195":3252,"_23354":66826,"_5":16137,"_30763":66655,"_3518":66827},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_4070":3304,"_34195":3252,"_23354":66829,"_5":16137,"_30763":66659,"_3518":66830},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_4070":3305,"_34195":3252,"_23354":66832,"_5":16137,"_30763":66659,"_3518":66833},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_4070":3306,"_34195":3252,"_23354":66835,"_5":16137,"_30763":66659,"_3518":66836},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_4070":3307,"_34195":3252,"_23354":66838,"_5":16137,"_30763":66659,"_3518":66839},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_4070":3308,"_34195":3252,"_23354":66841,"_5":16137,"_30763":66659,"_3518":66842},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_4070":3309,"_34195":3252,"_23354":66844,"_5":16137,"_30763":66663,"_3518":66845},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_4070":3310,"_34195":3252,"_23354":66847,"_5":16137,"_30763":66663,"_3518":66848},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_4070":3311,"_34195":3252,"_23354":66850,"_5":16137,"_30763":66663,"_3518":66851},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_4070":3312,"_34195":3252,"_23354":66853,"_5":16137,"_30763":66663,"_3518":66854},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_4070":3313,"_34195":3252,"_23354":66856,"_5":16137,"_30763":66663,"_3518":66857},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_4070":3314,"_34195":3252,"_23354":66859,"_5":16137,"_30763":66667,"_3518":66860},[],"Change",{"_4070":3315,"_34195":3252,"_23354":66862,"_5":16137,"_30763":66667,"_3518":66863},[],"Who is affected",{"_4070":3316,"_34195":3252,"_23354":66865,"_5":16137,"_30763":66667,"_3518":66866},[],"Severity",{"_4070":3317,"_34195":3252,"_23354":66868,"_5":16137,"_30763":66667,"_3518":63502},[],{"_4070":3318,"_34195":3252,"_23354":66870,"_5":16137,"_30763":66667,"_3518":66676},[],{"_4070":3319,"_34195":3252,"_23354":66872,"_5":16137,"_30763":66667,"_3518":66873},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_4070":3320,"_34195":3252,"_23354":66875,"_5":16137,"_30763":66667,"_3518":66876},[],"High: KMS and VA start on empty volumes",{"_4070":3321,"_34195":3252,"_23354":66878,"_5":16137,"_30763":66667,"_3518":66879},[],"Copy the data into the new volumes",{"_4070":3322,"_34195":3252,"_23354":66881,"_5":16137,"_30763":66667,"_3518":66680},[],{"_4070":3323,"_34195":3252,"_23354":66883,"_5":16137,"_30763":66667,"_3518":66884},[],"Every Helm release",{"_4070":3324,"_34195":3252,"_23354":66886,"_5":16137,"_30763":66667,"_3518":66887},[],"High: `helm upgrade` fails",{"_4070":3325,"_34195":3252,"_23354":66889,"_5":16137,"_30763":66667,"_3518":66890},[],"Remove or rename legacy keys",{"_4070":3326,"_34195":3252,"_23354":66892,"_5":16137,"_30763":66667,"_3518":66684},[],{"_4070":3327,"_34195":3252,"_23354":66894,"_5":16137,"_30763":66667,"_3518":66895},[],"Every deployment",{"_4070":3328,"_34195":3252,"_23354":66897,"_5":16137,"_30763":66667,"_3518":66898},[],"High: without a bootstrap principal there is no administrator",{"_4070":3329,"_34195":3252,"_23354":66900,"_5":16137,"_30763":66667,"_3518":66901},[],"Configure `services.authz`",{"_4070":3330,"_34195":3252,"_23354":66903,"_5":16137,"_30763":66667,"_3518":66688},[],{"_4070":3331,"_34195":3252,"_23354":66905,"_5":16137,"_30763":66667,"_3518":66884},[],{"_4070":3332,"_34195":3252,"_23354":66907,"_5":16137,"_30763":66667,"_3518":66908},[],"High: `helm upgrade` fails on the old keys",{"_4070":3333,"_34195":3252,"_23354":66910,"_5":16137,"_30763":66667,"_3518":66911},[],"Move JWKS and roles into `services.authz`",{"_4070":3334,"_34195":3252,"_23354":66913,"_5":16137,"_30763":66667,"_3518":66708},[],{"_4070":3335,"_34195":3252,"_23354":66915,"_5":16137,"_30763":66667,"_3518":66916},[],"3.8.0 deployments with per-service databases",{"_4070":3336,"_34195":3252,"_23354":66918,"_5":16137,"_30763":66667,"_3518":66919},[],"High: services find no data, or a migration aborts",{"_4070":3337,"_34195":3252,"_23354":66921,"_5":16137,"_30763":66667,"_3518":66922},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_4070":3338,"_34195":3252,"_23354":66924,"_5":16137,"_30763":66667,"_3518":66712},[],{"_4070":3339,"_34195":3252,"_23354":66926,"_5":16137,"_30763":66667,"_3518":66927},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_4070":3340,"_34195":3252,"_23354":66929,"_5":16137,"_30763":66667,"_3518":66930},[],"High: the backend no longer starts with them",{"_4070":3341,"_34195":3252,"_23354":66932,"_5":16137,"_30763":66667,"_3518":66933},[],"Move to PostgreSQL before upgrading",{"_4070":3342,"_34195":3252,"_23354":66935,"_5":16137,"_30763":66667,"_3518":66936},[],"Webhooks with file references",{"_4070":3343,"_34195":3252,"_23354":66938,"_5":16137,"_30763":66667,"_3518":66939},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_4070":3344,"_34195":3252,"_23354":66941,"_5":16137,"_30763":66667,"_3518":66942},[],"High: enrollments calling the webhook fail",{"_4070":3345,"_34195":3252,"_23354":66944,"_5":16137,"_30763":66667,"_3518":66945},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_4070":3346,"_34195":3252,"_23354":66947,"_5":16137,"_30763":66667,"_3518":66692},[],{"_4070":3347,"_34195":3252,"_23354":66949,"_5":16137,"_30763":66667,"_3518":66950},[],"Releases with per-service identity overrides or mounted key material",{"_4070":3348,"_34195":3252,"_23354":66952,"_5":16137,"_30763":66667,"_3518":66953},[],"Medium: services cannot read their files",{"_4070":3349,"_34195":3252,"_23354":66955,"_5":16137,"_30763":66667,"_3518":66956},[],"Remove the overrides and fix volume ownership",{"_4070":3350,"_34195":3252,"_23354":66958,"_5":16137,"_30763":66667,"_3518":66696},[],{"_4070":3351,"_34195":3252,"_23354":66960,"_5":16137,"_30763":66667,"_3518":66961},[],"Releases that set `amqp.tls`",{"_4070":3352,"_34195":3252,"_23354":66963,"_5":16137,"_30763":66667,"_3518":66964},[],"Medium: clients connect to the wrong port",{"_4070":3353,"_34195":3252,"_23354":66966,"_5":16137,"_30763":66667,"_3518":66967},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_4070":3354,"_34195":3252,"_23354":66969,"_5":16137,"_30763":66667,"_3518":66716},[],{"_4070":3355,"_34195":3252,"_23354":66971,"_5":16137,"_30763":66667,"_3518":66972},[],"Installations whose CA keys predate the KMS",{"_4070":3356,"_34195":3252,"_23354":66974,"_5":16137,"_30763":66667,"_3518":66975},[],"Medium: CA keys stay unmanaged",{"_4070":3357,"_34195":3252,"_23354":66977,"_5":16137,"_30763":66667,"_3518":66978},[],"Run the CA-to-KMS migration",{"_4070":3358,"_34195":3252,"_23354":66980,"_5":16137,"_30763":66667,"_3518":66981},[],"Receiver certificate verification",{"_4070":3359,"_34195":3252,"_23354":66983,"_5":16137,"_30763":66667,"_3518":66984},[],"DMSs whose webhook had `validate_server_cert: false`",{"_4070":3360,"_34195":3252,"_23354":66986,"_5":16137,"_30763":66667,"_3518":66987},[],"Medium: credentials go to an unverified receiver",{"_4070":3361,"_34195":3252,"_23354":66989,"_5":16137,"_30763":66667,"_3518":66990},[],"Set `insecure_skip_verify` to `false`",{"_4070":3362,"_34195":3252,"_23354":66992,"_5":16137,"_30763":66667,"_3518":66732},[],{"_4070":3363,"_34195":3252,"_23354":66994,"_5":16137,"_30763":66667,"_3518":66995},[],"Scripts and consoles that edit DMSs through the API",{"_4070":3364,"_34195":3252,"_23354":66997,"_5":16137,"_30763":66667,"_3518":66998},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_4070":3365,"_34195":3252,"_23354":67000,"_5":16137,"_30763":66667,"_3518":67001},[],"Read the DMS before editing and use the new field",{"_4070":3366,"_34195":3252,"_23354":67003,"_5":16137,"_30763":66667,"_3518":66752},[],{"_4070":3367,"_34195":3252,"_23354":67005,"_5":16137,"_30763":66667,"_3518":67006},[],"Clients that create or update VA roles through the API",{"_4070":3368,"_34195":3252,"_23354":67008,"_5":16137,"_30763":66667,"_3518":67009},[],"Medium: requests with the old field return an error",{"_4070":3369,"_34195":3252,"_23354":67011,"_5":16137,"_30763":66667,"_3518":67012},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_certificate_serial_number`",{"_4070":3370,"_34195":3252,"_23354":67014,"_5":16137,"_30763":66667,"_3518":66748},[],{"_4070":3371,"_34195":3252,"_23354":67016,"_5":16137,"_30763":66667,"_3518":67017},[],"Consumers that read the device `events` field",{"_4070":3372,"_34195":3252,"_23354":67019,"_5":16137,"_30763":66667,"_3518":67020},[],"Medium: the field disappears",{"_4070":3373,"_34195":3252,"_23354":67022,"_5":16137,"_30763":66667,"_3518":67023},[],"Use the new event endpoints",{"_4070":3374,"_34195":3252,"_23354":67025,"_5":16137,"_30763":66667,"_3518":66700},[],{"_4070":3375,"_34195":3252,"_23354":67027,"_5":16137,"_30763":66667,"_3518":67028},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_4070":3376,"_34195":3252,"_23354":67030,"_5":16137,"_30763":66667,"_3518":67031},[],"Low to medium: validation errors or changed defaults",{"_4070":3377,"_34195":3252,"_23354":67033,"_5":16137,"_30763":66667,"_3518":67034},[],"Update the values file",{"_4070":3378,"_34195":3252,"_23354":67036,"_5":16137,"_30763":66667,"_3518":66740},[],{"_4070":3379,"_34195":3252,"_23354":67038,"_5":16137,"_30763":66667,"_3518":67039},[],"Clients that send the DMS ID in the update body",{"_4070":3380,"_34195":3252,"_23354":67041,"_5":16137,"_30763":66667,"_3518":67042},[],"Low: the ID in the URL wins",{"_4070":3381,"_34195":3252,"_23354":67044,"_5":16137,"_30763":66667,"_3518":67045},[],"Send the ID in the URL",{"_4070":3382,"_34195":3252,"_23354":67047,"_5":16137,"_30763":66667,"_3518":66744},[],{"_4070":3383,"_34195":3252,"_23354":67049,"_5":16137,"_30763":66667,"_3518":67050},[],"Consumers that match on certificate `type`",{"_4070":3384,"_34195":3252,"_23354":67052,"_5":16137,"_30763":66667,"_3518":67053},[],"Low: two values are renamed",{"_4070":3385,"_34195":3252,"_23354":67055,"_5":16137,"_30763":66667,"_3518":67056},[],"Adapt consumers",{"_4070":3386,"_34195":3252,"_23354":67058,"_5":16137,"_30763":66667,"_3518":66736},[],{"_4070":3387,"_34195":3252,"_23354":67060,"_5":16137,"_30763":66667,"_3518":67061},[],"Any DMS",{"_4070":3388,"_34195":3252,"_23354":67063,"_5":16137,"_30763":66667,"_3518":67064},[],"Low: informational",{"_4070":3389,"_34195":3252,"_23354":67066,"_5":16137,"_30763":66667,"_3518":67067},[],"Read both blocks before editing",{"_4070":3390,"_34195":3252,"_23354":67069,"_5":16137,"_30763":66675,"_3518":67070},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_4070":3391,"_34195":3252,"_23354":67072,"_5":16137,"_30763":66675,"_3518":67073},[],"Step 4 of the migration guide copies the data.",{"_4070":3392,"_34195":3252,"_23354":67075,"_5":16137,"_30763":66679,"_3518":67076},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_4070":3393,"_34195":3252,"_23354":67078,"_5":16137,"_30763":66683,"_3518":67079},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_4070":3394,"_34195":3252,"_23354":67081,"_5":16137,"_30763":66687,"_3518":67082},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_4070":3395,"_34195":3252,"_23354":67084,"_5":16137,"_30763":66691,"_3518":67085},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_4070":3396,"_34195":3252,"_23354":67087,"_5":16137,"_30763":66691,"_3518":67088},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_4070":3397,"_34195":3252,"_23354":67090,"_5":16137,"_30763":66695,"_3518":67091},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_4070":3398,"_34195":3252,"_23354":67093,"_5":16137,"_30763":66699,"_3518":67094},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_4070":3399,"_34195":3252,"_23354":67096,"_5":16137,"_30763":66699,"_3518":67097},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_4070":3400,"_34195":3252,"_23354":67099,"_5":16137,"_30763":66699,"_3518":67100},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_4070":3401,"_34195":3252,"_23354":67102,"_5":16137,"_30763":66699,"_3518":67103},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_4070":3402,"_34195":3252,"_23354":67105,"_5":16137,"_30763":66699,"_3518":67106},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_4070":3403,"_34195":3252,"_23354":67108,"_5":16137,"_30763":66699,"_3518":67109},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_4070":3404,"_34195":3252,"_23354":67111,"_5":16137,"_30763":66707,"_3518":67112},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_4070":3405,"_34195":3252,"_23354":67114,"_5":16137,"_30763":66707,"_3518":67115},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_4070":3406,"_34195":3252,"_23354":67117,"_5":16137,"_30763":66707,"_3518":67118},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_4070":3407,"_34195":3252,"_23354":67120,"_5":16137,"_30763":66707,"_3518":67121},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_4070":3408,"_34195":3252,"_23354":67123,"_5":16137,"_30763":66707,"_3518":67124},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_4070":3409,"_34195":3252,"_23354":67126,"_5":16137,"_30763":66711,"_3518":67127},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_4070":3410,"_34195":3252,"_23354":67129,"_5":16137,"_30763":66715,"_3518":67130},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_4070":3411,"_34195":3252,"_23354":67132,"_5":16137,"_30763":66715,"_3518":67133},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_4070":3412,"_34195":3252,"_23354":67135,"_5":16137,"_30763":66715,"_3518":67136},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_4070":3413,"_34195":3252,"_23354":67138,"_5":16137,"_30763":66715,"_3518":67139},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_4070":3414,"_34195":3252,"_23354":67141,"_5":16137,"_30763":66715,"_3518":67142},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_4070":3415,"_34195":3252,"_23354":67144,"_5":16137,"_30763":66715,"_3518":67145},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_4070":3416,"_34195":3252,"_23354":67147,"_5":16137,"_30763":66715,"_3518":67148},[],"Once legacy keys are registered, starting the KMS with the backend configuration option `crypto_engines.migrate_keys_format` renames keys whose name is not the public-key SHA-256 digest, keeps the old name as an alias and moves certificate references along. It is safe to re-run and can be disabled afterwards.",{"_4070":3417,"_34195":3252,"_23354":67150,"_5":16137,"_30763":66719,"_3518":67151},[],"Certificates now reference their KMS key, and VA roles reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_4070":3418,"_34195":3252,"_23354":67153,"_5":16137,"_30763":66727,"_3518":67154},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_4070":3419,"_34195":3252,"_23354":67156,"_5":16137,"_30763":66727,"_3518":67157},[],"Field in 3.8.0",{"_4070":3420,"_34195":3252,"_23354":67159,"_5":16137,"_30763":66727,"_3518":67160},[],"Field in 4.0.0",{"_4070":3421,"_34195":3252,"_23354":67162,"_5":16137,"_30763":66727,"_3518":67163},[],"`validate_server_cert`",{"_4070":3422,"_34195":3252,"_23354":67165,"_5":16137,"_30763":66727,"_3518":67166},[],"`insecure_skip_verify` (value negated)",{"_4070":3423,"_34195":3252,"_23354":67168,"_5":16137,"_30763":66727,"_3518":67169},[],"`oidc`",{"_4070":3424,"_34195":3252,"_23354":67171,"_5":16137,"_30763":66727,"_3518":67172},[],"`jwt_options`",{"_4070":3425,"_34195":3252,"_23354":67174,"_5":16137,"_30763":66727,"_3518":67175},[],"`apikey`",{"_4070":3426,"_34195":3252,"_23354":67177,"_5":16137,"_30763":66727,"_3518":67178},[],"`apikey_options`",{"_4070":3427,"_34195":3252,"_23354":67180,"_5":16137,"_30763":66727,"_3518":67181},[],"`mtls`",{"_4070":3428,"_34195":3252,"_23354":67183,"_5":16137,"_30763":66727,"_3518":67184},[],"`mtls_options`",{"_4070":3429,"_34195":3252,"_23354":67186,"_5":16137,"_30763":66727,"_3518":67187},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_4070":3430,"_34195":3252,"_23354":67189,"_5":16137,"_30763":66727,"_3518":67190},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_4070":3431,"_34195":3252,"_23354":67192,"_5":16137,"_30763":66727,"_3518":67193},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_4070":3432,"_34195":3252,"_23354":67195,"_5":16137,"_30763":66731,"_3518":67196},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_4070":3433,"_34195":3252,"_23354":67198,"_5":16137,"_30763":66731,"_3518":67199},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_4070":3434,"_34195":3252,"_23354":67201,"_5":16137,"_30763":66731,"_3518":67202},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_4070":3435,"_34195":3252,"_23354":67204,"_5":16137,"_30763":66735,"_3518":67205},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_4070":3436,"_34195":3252,"_23354":67207,"_5":16137,"_30763":66739,"_3518":67208},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_4070":3437,"_34195":3252,"_23354":67210,"_5":16137,"_30763":66743,"_3518":67211},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_4070":3438,"_34195":3252,"_23354":67213,"_5":16137,"_30763":66747,"_3518":67214},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_4070":3439,"_34195":3252,"_23354":67216,"_5":16137,"_30763":66747,"_3518":67217},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_4070":3440,"_34195":3252,"_23354":67219,"_5":16137,"_30763":66747,"_3518":67220},[],"`POST /v1/devices/:id/events` creates an event.",{"_4070":3441,"_34195":3252,"_23354":67222,"_5":16137,"_30763":66747,"_3518":67223},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_4070":3442,"_34195":3252,"_23354":67225,"_5":16137,"_30763":66751,"_3518":67226},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_certificate_serial_number`, the serial number of the existing certificate that signs the CRL. A new role's initial value is the CA's current certificate serial number. Requests that still carry `subject_key_id_signer` return an error. Custom authorization policies that filter on the old field must be updated: the filter `crl_subject_key_id_signer` is renamed to `crl_signer_certificate_serial_number` and takes serial-number values.",{"_4070":3443,"_34195":3252,"_23354":67228,"_5":16137,"_30763":66755,"_3518":67229},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_4070":3444,"_34195":3252,"_23354":67231,"_5":16137,"_30763":66759,"_3518":67232},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_4070":3445,"_34195":3252,"_23354":67234,"_5":16137,"_30763":66759,"_3518":67235},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_4070":3446,"_34195":3252,"_23354":67237,"_5":16137,"_30763":66759,"_3518":67238},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_4070":3447,"_34195":3252,"_23354":67240,"_5":16137,"_30763":66759,"_3518":67241},[],"Record the names of your local-storage PVCs:",{"_4070":3448,"_34195":3252,"_23354":67243,"_5":16137,"_30763":66759,"_3518":67244},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_4070":3449,"_34195":3252,"_23354":67246,"_5":16137,"_30763":66763,"_3518":67247},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_4070":3450,"_34195":3252,"_23354":67249,"_5":16137,"_30763":66763,"_3518":67250},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_4070":3451,"_34195":3252,"_23354":67252,"_5":16137,"_30763":66763,"_3518":67253},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_4070":3452,"_34195":3252,"_23354":67255,"_5":16137,"_30763":66763,"_3518":67256},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_4070":3453,"_34195":3252,"_23354":67258,"_5":16137,"_30763":66763,"_3518":67259},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_4070":3454,"_34195":3252,"_23354":67261,"_5":16137,"_30763":66763,"_3518":67262},[],"**Rename `toolbox` to `connectivityTest`:**",{"_4070":3455,"_34195":3252,"_23354":67264,"_5":16137,"_30763":66763,"_3518":67265},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_4070":3456,"_34195":3252,"_23354":67267,"_5":16137,"_30763":66763,"_3518":67268},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_4070":3457,"_34195":3252,"_23354":67270,"_5":16137,"_30763":66763,"_3518":67271},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_4070":3458,"_34195":3252,"_23354":67273,"_5":16137,"_30763":66763,"_3518":67274},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_4070":3459,"_34195":3252,"_23354":67276,"_5":16137,"_30763":66763,"_3518":67277},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_4070":3460,"_34195":3252,"_23354":67279,"_5":16137,"_30763":66763,"_3518":67280},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_4070":3461,"_34195":3252,"_23354":67282,"_5":16137,"_30763":66767,"_3518":67283},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_4070":3462,"_34195":3252,"_23354":67285,"_5":16137,"_30763":66767,"_3518":67286},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_4070":3463,"_34195":3252,"_23354":67288,"_5":16137,"_30763":66771,"_3518":67289},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_4070":3464,"_34195":3252,"_23354":67291,"_5":16137,"_30763":66771,"_3518":67292},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_4070":3465,"_34195":3252,"_23354":67294,"_5":16137,"_30763":66771,"_3518":67295},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_4070":3466,"_34195":3252,"_23354":67297,"_5":16137,"_30763":66771,"_3518":67298},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_4070":3467,"_34195":3252,"_23354":67300,"_5":16137,"_30763":66771,"_3518":67301},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_4070":3468,"_34195":3252,"_23354":67303,"_5":16137,"_30763":66771,"_3518":67304},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_4070":3469,"_34195":3252,"_23354":67306,"_5":16137,"_30763":66771,"_3518":67307},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_4070":3470,"_34195":3252,"_23354":67309,"_5":16137,"_30763":66771,"_3518":67310},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_4070":3471,"_34195":3252,"_23354":67312,"_5":16137,"_30763":66771,"_3518":67313},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_4070":3472,"_34195":3252,"_23354":67315,"_5":16137,"_30763":66771,"_3518":67316},[],"**Remove the helper and restore the recorded replica counts:**",{"_4070":3473,"_34195":3252,"_23354":67318,"_5":16137,"_30763":66771,"_3518":67319},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_4070":3474,"_34195":3252,"_23354":67321,"_5":16137,"_30763":66775,"_3518":67322},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_4070":3475,"_34195":3252,"_23354":67324,"_5":16137,"_30763":66775,"_3518":67325},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_4070":3476,"_34195":3252,"_23354":67327,"_5":16137,"_30763":66779,"_3518":67328},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_4070":3477,"_34195":3252,"_23354":67330,"_5":16137,"_30763":66779,"_3518":67331},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_4070":3478,"_34195":3252,"_23354":67333,"_5":16137,"_30763":66779,"_3518":67334},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates`. If your services connect with a different user than the one that ran the migrations, grant that user `SELECT` on `ca.certificates_view` after the migrations.",{"_4070":3479,"_34195":3252,"_23354":67336,"_5":16137,"_30763":66779,"_3518":67337},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_4070":3480,"_34195":3252,"_23354":67339,"_5":16137,"_30763":66779,"_3518":67340},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_4070":3481,"_34195":3252,"_23354":67342,"_5":16137,"_30763":66779,"_3518":67343},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_4070":3482,"_34195":3252,"_23354":67345,"_5":16137,"_30763":66779,"_3518":67346},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_4070":3483,"_34195":3252,"_23354":67348,"_5":16137,"_30763":66783,"_3518":67349},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_4070":3484,"_34195":3252,"_23354":67351,"_5":16137,"_30763":66783,"_3518":67352},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_4070":3485,"_34195":3252,"_23354":67354,"_5":16137,"_30763":66783,"_3518":67355},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_4070":3486,"_34195":3252,"_23354":67357,"_5":16137,"_30763":66783,"_3518":67358},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_4070":3487,"_34195":3252,"_23354":67360,"_5":16137,"_30763":66783,"_3518":67361},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_4070":3488,"_34195":3252,"_23354":67363,"_5":16137,"_30763":66783,"_3518":67364},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_4070":3489,"_34195":3252,"_23354":67366,"_5":16137,"_30763":66783,"_3518":67367},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_4070":3490,"_34195":3252,"_23354":67369,"_5":16137,"_30763":66783,"_3518":67370},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` schema migration.",{"_4070":3491,"_34195":3252,"_23354":67372,"_5":16137,"_30763":66783,"_3518":67373},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_4070":3492,"_34195":3252,"_23354":67375,"_5":16137,"_30763":66783,"_3518":67376},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_certificate_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_4070":3493,"_34195":3252,"_23354":67378,"_5":16137,"_30763":66783,"_3518":67379},[],"**A migration or service fails with `permission denied for table ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped. Grant the missing privileges and re-run.",{"_4070":3494,"_34195":3252,"_23354":67381,"_5":16137,"_30763":66786,"_3518":67382},[],"After the upgrade, check in this order:",{"_4070":3495,"_34195":3252,"_23354":67384,"_5":16137,"_30763":66786,"_3518":67385},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_4070":3496,"_34195":3252,"_23354":67387,"_5":16137,"_30763":66786,"_3518":67388},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_4070":3497,"_34195":3252,"_23354":67390,"_5":16137,"_30763":66786,"_3518":67391},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_4070":3498,"_34195":3252,"_23354":67393,"_5":16137,"_30763":66786,"_3518":67394},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_4070":3499,"_34195":3252,"_23354":67396,"_5":16137,"_30763":66786,"_3518":67397},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_4070":3500,"_34195":3252,"_23354":67399,"_5":16137,"_30763":66786,"_3518":67400},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_4070":3501,"_34195":3252,"_23354":67402,"_5":16137,"_30763":66786,"_3518":67403},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_4070":3502,"_34195":3252,"_23354":67405,"_5":16137,"_30763":66786,"_3518":67406},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_4070":3503,"_34195":3252,"_23354":67408,"_5":16137,"_30763":66786,"_3518":67409},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_4070":3504,"_34195":3252,"_23354":67411,"_5":16137,"_30763":66786,"_3518":67412},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_4070":3505,"_34195":3252,"_23354":67414,"_5":16137,"_30763":66786,"_3518":67415},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_4070":3506,"_34195":3252,"_23354":67417,"_5":16137,"_30763":66786,"_3518":67418},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_4070":3507,"_34195":3252,"_23354":67420,"_5":16137,"_30763":66786,"_3518":67421},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_4070":3508,"_34195":3252,"_23354":67423,"_5":16137,"_30763":66786,"_3518":67424},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_4070":3509,"_34195":3252,"_23354":67426,"_5":16137,"_30763":66790,"_3518":67427},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_4070":3510,"_34195":3252,"_23354":67429,"_5":16137,"_30763":66790,"_3518":67430},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_4070":3511,"_34195":3252,"_23354":67432,"_5":16137,"_30763":66790,"_3518":67433},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_4070":3512,"_34195":3252,"_23354":67435,"_5":16137,"_30763":66790,"_3518":67436},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_4070":3513,"_34195":3252,"_23354":67438,"_5":16137,"_30763":66790,"_3518":67439},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_67442":20113,"_67443":67444,"_67445":67446,"_67447":67448,"_20232":3553,"_81458":3553},"language","sortableProperties",[3518,34195,5,30763],"sortablePropertiesWithTypes",{"_3518":27927,"_34195":27927,"_5":27927,"_30763":27927},"sorts",{"_3518":67449,"_34195":70952,"_5":74454,"_30763":77956},{"_5342":67450,"_67451":67452,"_5":27927},{"_11597":15048,"_11758":29448,"_11695":4321,"_11548":5548,"_11887":6794,"_11557":22477,"_11588":13994,"_11569":4378,"_29359":12049,"_33244":7911,"_33278":19096,"_32740":8207,"_33344":20819,"_32927":29292,"_33350":3698,"_33312":33671,"_33356":15977,"_33361":14442,"_33302":13940,"_33939":27940,"_39146":26388,"_39148":17728,"_33983":6878,"_16699":7473,"_33963":19847,"_39154":3818,"_33992":5696,"_29343":31101,"_33934":4326,"_34010":5086,"_34052":22954,"_39161":6612,"_39163":21648,"_32944":3631,"_39166":8514,"_34081":10447,"_34069":3906,"_34042":4290,"_34075":4756,"_32809":29437,"_32857":7906,"_32863":6783,"_32869":6162,"_11551":5287,"_32875":6739,"_32881":4730,"_39180":3641,"_32851":6790,"_32887":8314,"_32699":14598,"_39186":3644,"_32745":5465,"_32767":30169,"_32773":4584,"_39192":4909,"_16689":11035,"_39195":20012,"_34265":15709,"_39199":8564,"_34113":3747,"_39202":6929,"_39204":4776,"_39206":10610,"_22174":5669,"_11560":3897,"_39210":15571,"_32719":19166,"_39213":7012,"_39215":12098,"_39217":8331,"_39219":4029,"_34026":5084,"_33257":22434,"_39223":7828,"_39225":5855,"_34177":5591,"_33397":20310,"_39229":19274,"_39231":5860,"_32757":5102,"_39234":3833,"_39236":3706,"_39238":12587,"_32899":3854,"_32921":7315,"_32068":8616,"_11572":6835,"_39244":27931,"_39246":5907,"_32982":9564,"_39250":4033,"_29362":14557,"_39254":13484,"_39256":5014,"_39258":6967,"_39260":7667,"_39262":14563,"_39264":6758,"_32971":18883,"_33251":7135,"_33273":12589,"_39269":8401,"_39271":26570,"_39274":4001,"_39276":20248,"_39278":8371,"_39280":7664,"_39282":