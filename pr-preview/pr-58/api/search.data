_46246":67738,"_46248":67741,"_46250":67744,"_46252":67747,"_46254":67750,"_46256":67753,"_46258":67756,"_46260":67759,"_46262":67762,"_46264":67765,"_46266":67768,"_46269":67771,"_46271":67774,"_46273":67777,"_46275":67780},{"_4098":15,"_34307":15,"_5":16596,"_3543":56934,"_34738":56935,"_23429":56939,"_30870":15},"Deploy from AWS Marketplace",[56936,56937,56938],"Docs","Deployment","Other models",[],{"_4098":16,"_34307":15,"_23429":56941,"_5":16198,"_30870":15,"_3543":56942},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_4098":17,"_34307":15,"_5":34735,"_23429":56944,"_30870":56945,"_3543":56946},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#before-you-begin","Before you begin",{"_4098":18,"_34307":15,"_5":34735,"_23429":56948,"_30870":56949,"_3543":56950},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_4098":19,"_34307":15,"_5":34735,"_23429":56952,"_30870":56953,"_3543":56954},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#open-the-offer","Open the offer",{"_4098":20,"_34307":15,"_5":34735,"_23429":56956,"_30870":56957,"_3543":56958},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_4098":21,"_34307":15,"_5":34735,"_23429":56960,"_30870":56961,"_3543":56962},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#limit-network-access","Limit network access",{"_4098":22,"_34307":15,"_5":34735,"_23429":56964,"_30870":56965,"_3543":56966},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_4098":23,"_34307":15,"_5":34735,"_23429":56968,"_30870":56969,"_3543":56970},[],"/docs/pr-preview/pr-58/deployment/aws-marketplace#next-step","Next step",{"_4098":24,"_34307":15,"_23429":56972,"_5":16198,"_30870":15,"_3543":56973},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_4098":25,"_34307":15,"_23429":56975,"_5":16198,"_30870":56945,"_3543":56976},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_4098":26,"_34307":15,"_23429":56978,"_5":16198,"_30870":56945,"_3543":56979},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_4098":27,"_34307":15,"_23429":56981,"_5":16198,"_30870":56945,"_3543":56982},[],"A security group allowing the necessary endpoints.",{"_4098":28,"_34307":15,"_23429":56984,"_5":16198,"_30870":56949,"_3543":56985},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_4098":29,"_34307":15,"_23429":56987,"_5":16198,"_30870":56949,"_3543":56988},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_4098":30,"_34307":15,"_23429":56990,"_5":16198,"_30870":56949,"_3543":56991},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_4098":31,"_34307":15,"_23429":56993,"_5":16198,"_30870":56953,"_3543":56994},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_4098":32,"_34307":15,"_23429":56996,"_5":16198,"_30870":56957,"_3543":56997},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_4098":33,"_34307":15,"_23429":56999,"_5":16198,"_30870":56961,"_3543":57000},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_4098":34,"_34307":15,"_23429":57002,"_5":16198,"_30870":56965,"_3543":57003},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_4098":35,"_34307":15,"_23429":57005,"_5":16198,"_30870":56969,"_3543":57006},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_4098":36,"_34307":36,"_5":16596,"_3543":57008,"_34738":57009,"_23429":57010,"_30870":36},"Deploy Lamassu",[56936,56937],[],{"_4098":37,"_34307":36,"_23429":57012,"_5":16198,"_30870":36,"_3543":57013},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_4098":38,"_34307":36,"_5":34735,"_23429":57015,"_30870":57016,"_3543":57017},[],"/docs/pr-preview/pr-58/deployment/overview#choose-a-model","Choose a model",{"_4098":39,"_34307":36,"_5":34735,"_23429":57019,"_30870":57020,"_3543":57021},[],"/docs/pr-preview/pr-58/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_4098":40,"_34307":36,"_5":34735,"_23429":57023,"_30870":57024,"_3543":57025},[],"/docs/pr-preview/pr-58/deployment/overview#after-deployment","After deployment",{"_4098":41,"_34307":36,"_23429":57027,"_5":16198,"_30870":36,"_3543":57028},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_4098":42,"_34307":36,"_23429":57030,"_5":16198,"_30870":57016,"_3543":57031},[],"Model",{"_4098":43,"_34307":36,"_23429":57033,"_5":16198,"_30870":57016,"_3543":57034},[],"Recommended for",{"_4098":44,"_34307":36,"_23429":57036,"_5":16198,"_30870":57016,"_3543":57037},[],"Who operates the infrastructure",{"_4098":45,"_34307":36,"_23429":57039,"_5":16198,"_30870":57016,"_3543":57040},[],"Starting point",{"_4098":46,"_34307":36,"_23429":57042,"_5":16198,"_30870":57016,"_3543":57043},[],"Kubernetes self-managed",{"_4098":47,"_34307":36,"_23429":57045,"_5":16198,"_30870":57016,"_3543":57046},[],"Production, regulated environments and custom deployments",{"_4098":48,"_34307":36,"_23429":57048,"_5":16198,"_30870":57016,"_3543":57049},[],"Your team",{"_4098":49,"_34307":36,"_23429":57051,"_5":16198,"_30870":57016,"_3543":57052},[],"Helm or Fastlane",{"_4098":50,"_34307":36,"_23429":57054,"_5":16198,"_30870":57016,"_3543":57055},[],"AWS Marketplace",{"_4098":51,"_34307":36,"_23429":57057,"_5":16198,"_30870":57016,"_3543":57058},[],"Evaluation or a dedicated deployment inside an AWS account",{"_4098":52,"_34307":36,"_23429":57060,"_5":16198,"_30870":57016,"_3543":57049},[],{"_4098":53,"_34307":36,"_23429":57062,"_5":16198,"_30870":57016,"_3543":57063},[],"Preconfigured image on EC2",{"_4098":54,"_34307":36,"_23429":57065,"_5":16198,"_30870":57016,"_3543":57066},[],"SaaS",{"_4098":55,"_34307":36,"_23429":57068,"_5":16198,"_30870":57016,"_3543":57069},[],"Teams that want to use the platform without operating it",{"_4098":56,"_34307":36,"_23429":57071,"_5":16198,"_30870":57016,"_3543":57072},[],"Lamassu",{"_4098":57,"_34307":36,"_23429":57074,"_5":16198,"_30870":57016,"_3543":57075},[],"Managed subscription",{"_4098":58,"_34307":36,"_23429":57077,"_5":16198,"_30870":57016,"_3543":57078},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_4098":59,"_34307":36,"_23429":57080,"_5":16198,"_30870":57016,"_3543":57081},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_4098":60,"_34307":36,"_23429":57083,"_5":16198,"_30870":57016,"_3543":57084},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_4098":61,"_34307":36,"_23429":57086,"_5":16198,"_30870":57020,"_3543":57087},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_4098":62,"_34307":36,"_23429":57089,"_5":16198,"_30870":57024,"_3543":57090},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_4098":63,"_34307":63,"_5":16596,"_3543":57092,"_34738":57093,"_23429":57094,"_30870":63},"Use Lamassu as SaaS",[56936,56937,56938],[],{"_4098":64,"_34307":63,"_23429":57096,"_5":16198,"_30870":63,"_3543":57097},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_4098":65,"_34307":63,"_5":34735,"_23429":57099,"_30870":57100,"_3543":57101},[],"/docs/pr-preview/pr-58/deployment/saas#what-the-service-manages","What the service manages",{"_4098":66,"_34307":63,"_5":34735,"_23429":57103,"_30870":57104,"_3543":57105},[],"/docs/pr-preview/pr-58/deployment/saas#plans","Plans",{"_4098":67,"_34307":63,"_5":34735,"_23429":57107,"_30870":57108,"_3543":57109},[],"/docs/pr-preview/pr-58/deployment/saas#request-access","Request access",{"_4098":68,"_34307":63,"_23429":57111,"_5":16198,"_30870":63,"_3543":57112},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_4098":69,"_34307":63,"_23429":57114,"_5":16198,"_30870":57100,"_3543":57115},[],"Platform availability and maintenance.",{"_4098":70,"_34307":63,"_23429":57117,"_5":16198,"_30870":57100,"_3543":57118},[],"Automatic backups.",{"_4098":71,"_34307":63,"_23429":57120,"_5":16198,"_30870":57100,"_3543":57121},[],"Version upgrades.",{"_4098":72,"_34307":63,"_23429":57123,"_5":16198,"_30870":57100,"_3543":57124},[],"Technical support and SLA according to your plan.",{"_4098":73,"_34307":63,"_23429":57126,"_5":16198,"_30870":57104,"_3543":57127},[],"Plan",{"_4098":74,"_34307":63,"_23429":57129,"_5":16198,"_30870":57104,"_3543":57130},[],"Devices",{"_4098":75,"_34307":63,"_23429":57132,"_5":16198,"_30870":57104,"_3543":57133},[],"Support",{"_4098":76,"_34307":63,"_23429":57135,"_5":16198,"_30870":57104,"_3543":57136},[],"SLA",{"_4098":77,"_34307":63,"_23429":57138,"_5":16198,"_30870":57104,"_3543":57139},[],"Starter",{"_4098":78,"_34307":63,"_23429":57141,"_5":16198,"_30870":57104,"_3543":57142},[],"Up to 1,000",{"_4098":79,"_34307":63,"_23429":57144,"_5":16198,"_30870":57104,"_3543":57145},[],"Email",{"_4098":80,"_34307":63,"_23429":57147,"_5":16198,"_30870":57104,"_3543":57148},[],"99.5 %",{"_4098":81,"_34307":63,"_23429":57150,"_5":16198,"_30870":57104,"_3543":57151},[],"Professional",{"_4098":82,"_34307":63,"_23429":57153,"_5":16198,"_30870":57104,"_3543":57154},[],"Up to 10,000",{"_4098":83,"_34307":63,"_23429":57156,"_5":16198,"_30870":57104,"_3543":57157},[],"Email and chat",{"_4098":84,"_34307":63,"_23429":57159,"_5":16198,"_30870":57104,"_3543":57160},[],"99.9 %",{"_4098":85,"_34307":63,"_23429":57162,"_5":16198,"_30870":57104,"_3543":57163},[],"Enterprise",{"_4098":86,"_34307":63,"_23429":57165,"_5":16198,"_30870":57104,"_3543":57166},[],"Unlimited",{"_4098":87,"_34307":63,"_23429":57168,"_5":16198,"_30870":57104,"_3543":57169},[],"Dedicated",{"_4098":88,"_34307":63,"_23429":57171,"_5":16198,"_30870":57104,"_3543":57172},[],"99.99 %",{"_4098":89,"_34307":63,"_23429":57174,"_5":16198,"_30870":57108,"_3543":57175},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_4098":90,"_34307":63,"_23429":57177,"_5":16198,"_30870":57108,"_3543":57178},[],"When you receive your instance's credentials, continue with Get started.",{"_4098":91,"_34307":91,"_5":16596,"_3543":57180,"_34738":57181,"_23429":57182,"_30870":91},"Fastlane",[56936,56937,57043],[],{"_4098":92,"_34307":91,"_23429":57184,"_5":16198,"_30870":91,"_3543":57185},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_4098":93,"_34307":91,"_5":34735,"_23429":57187,"_30870":57188,"_3543":57189},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_4098":94,"_34307":91,"_5":34735,"_23429":57191,"_30870":57192,"_3543":57193},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_4098":95,"_34307":91,"_5":34735,"_23429":57195,"_30870":57196,"_3543":56946},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#before-you-begin",{"_4098":96,"_34307":91,"_5":34735,"_23429":57198,"_30870":57199,"_3543":57200},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#quick-start","Quick start",{"_4098":97,"_34307":91,"_5":34735,"_23429":57202,"_30870":57203,"_3543":57204},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_4098":98,"_34307":91,"_5":34735,"_23429":57206,"_30870":57207,"_3543":57208},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_4098":99,"_34307":91,"_5":34735,"_23429":57210,"_30870":57211,"_3543":57212},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#development-mode","Development mode",{"_4098":100,"_34307":91,"_5":34735,"_23429":57214,"_30870":57215,"_3543":57216},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_4098":101,"_34307":91,"_5":34735,"_23429":57218,"_30870":57219,"_3543":57220},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_4098":102,"_34307":91,"_5":34735,"_23429":57222,"_30870":57223,"_3543":57224},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_4098":103,"_34307":91,"_5":34735,"_23429":57226,"_30870":57227,"_3543":57228},[],"/docs/pr-preview/pr-58/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_4098":104,"_34307":91,"_23429":57230,"_5":16198,"_30870":57188,"_3543":57231},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_4098":105,"_34307":91,"_23429":57233,"_5":16198,"_30870":57188,"_3543":57234},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_4098":106,"_34307":91,"_23429":57236,"_5":16198,"_30870":57192,"_3543":57237},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_4098":107,"_34307":91,"_23429":57239,"_5":16198,"_30870":57192,"_3543":57240},[],"Fastlane installs or configures",{"_4098":108,"_34307":91,"_23429":57242,"_5":16198,"_30870":57192,"_3543":57243},[],"You still provide",{"_4098":109,"_34307":91,"_23429":57245,"_5":16198,"_30870":57192,"_3543":57246},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_4098":110,"_34307":91,"_23429":57248,"_5":16198,"_30870":57192,"_3543":57249},[],"The Kubernetes cluster, nodes and persistent storage",{"_4098":111,"_34307":91,"_23429":57251,"_5":16198,"_30870":57192,"_3543":57252},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_4098":112,"_34307":91,"_23429":57254,"_5":16198,"_30870":57192,"_3543":57255},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_4098":113,"_34307":91,"_23429":57257,"_5":16198,"_30870":57192,"_3543":57258},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_4098":114,"_34307":91,"_23429":57260,"_5":16198,"_30870":57192,"_3543":57261},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_4098":115,"_34307":91,"_23429":57263,"_5":16198,"_30870":57192,"_3543":57264},[],"Optional observability and lab HSM components",{"_4098":116,"_34307":91,"_23429":57266,"_5":16198,"_30870":57192,"_3543":57267},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_4098":117,"_34307":91,"_23429":57269,"_5":16198,"_30870":57192,"_3543":57270},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_4098":118,"_34307":91,"_23429":57272,"_5":16198,"_30870":57196,"_3543":57273},[],"You need:",{"_4098":119,"_34307":91,"_23429":57275,"_5":16198,"_30870":57196,"_3543":57276},[],"an existing Kubernetes cluster",{"_4098":120,"_34307":91,"_23429":57278,"_5":16198,"_30870":57196,"_3543":57279},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_4098":121,"_34307":91,"_23429":57281,"_5":16198,"_30870":57196,"_3543":57282},[],"`yq`",{"_4098":122,"_34307":91,"_23429":57284,"_5":16198,"_30870":57196,"_3543":26546},[],{"_4098":123,"_34307":91,"_23429":57286,"_5":16198,"_30870":57196,"_3543":57287},[],"`jq` only when using `--sample-data` or `--development`",{"_4098":124,"_34307":91,"_23429":57289,"_5":16198,"_30870":57196,"_3543":57290},[],"`ssh-keygen` only when using `--with-hsm`",{"_4098":125,"_34307":91,"_23429":57292,"_5":16198,"_30870":57196,"_3543":57293},[],"free external ports 80 and 443 on a single-node K3s host",{"_4098":126,"_34307":91,"_23429":57295,"_5":16198,"_30870":57196,"_3543":57296},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_4098":127,"_34307":91,"_23429":57298,"_5":16198,"_30870":57196,"_3543":57299},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_4098":128,"_34307":91,"_23429":57301,"_5":16198,"_30870":57199,"_3543":57302},[],"Run the script from a clone of the Helm repository:",{"_4098":129,"_34307":91,"_23429":57304,"_5":16198,"_30870":57199,"_3543":57305},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_4098":130,"_34307":91,"_23429":57307,"_5":16198,"_30870":57203,"_3543":57308},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_4098":131,"_34307":91,"_23429":57310,"_5":16198,"_30870":57203,"_3543":57311},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_4098":132,"_34307":91,"_23429":57313,"_5":16198,"_30870":57203,"_3543":57314},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_4098":133,"_34307":91,"_23429":57316,"_5":16198,"_30870":57203,"_3543":57317},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_4098":134,"_34307":91,"_23429":57319,"_5":16198,"_30870":57207,"_3543":57320},[],"Option",{"_4098":135,"_34307":91,"_23429":57322,"_5":16198,"_30870":57207,"_3543":57323},[],"Default",{"_4098":136,"_34307":91,"_23429":57325,"_5":16198,"_30870":57207,"_3543":57326},[],"Purpose",{"_4098":137,"_34307":91,"_23429":57328,"_5":16198,"_30870":57207,"_3543":57329},[],"`-h`, `--help`",{"_4098":138,"_34307":91,"_23429":57331,"_5":16198,"_30870":57207,"_3543":57332},[],"—",{"_4098":139,"_34307":91,"_23429":57334,"_5":16198,"_30870":57207,"_3543":57335},[],"Show help",{"_4098":140,"_34307":91,"_23429":57337,"_5":16198,"_30870":57207,"_3543":57338},[],"`-c`, `--context`",{"_4098":141,"_34307":91,"_23429":57340,"_5":16198,"_30870":57207,"_3543":57341},[],"current context",{"_4098":142,"_34307":91,"_23429":57343,"_5":16198,"_30870":57207,"_3543":57344},[],"Select the kubeconfig context for kubectl and Helm",{"_4098":143,"_34307":91,"_23429":57346,"_5":16198,"_30870":57207,"_3543":57347},[],"`-n`, `--non-interactive`",{"_4098":144,"_34307":91,"_23429":57349,"_5":16198,"_30870":57207,"_3543":7434},[],{"_4098":145,"_34307":91,"_23429":57351,"_5":16198,"_30870":57207,"_3543":57352},[],"Skip prompts and generate dependency credentials",{"_4098":146,"_34307":91,"_23429":57354,"_5":16198,"_30870":57207,"_3543":57355},[],"`-ns`, `--namespace`",{"_4098":147,"_34307":91,"_23429":57357,"_5":16198,"_30870":57207,"_3543":57358},[],"`lamassu-dev`",{"_4098":148,"_34307":91,"_23429":57360,"_5":16198,"_30870":57207,"_3543":57361},[],"Namespace for the installation",{"_4098":149,"_34307":91,"_23429":57363,"_5":16198,"_30870":57207,"_3543":57364},[],"`-d`, `--domain`",{"_4098":150,"_34307":91,"_23429":57366,"_5":16198,"_30870":57207,"_3543":57367},[],"`dev.lamassu.io`",{"_4098":151,"_34307":91,"_23429":57369,"_5":16198,"_30870":57207,"_3543":57370},[],"Domain used by the UI, OIDC and certificate",{"_4098":152,"_34307":91,"_23429":57372,"_5":16198,"_30870":57207,"_3543":57373},[],"`-v`, `--version`",{"_4098":153,"_34307":91,"_23429":57375,"_5":16198,"_30870":57207,"_3543":17031},[],{"_4098":154,"_34307":91,"_23429":57377,"_5":16198,"_30870":57207,"_3543":57378},[],"Lamassu chart version",{"_4098":155,"_34307":91,"_23429":57380,"_5":16198,"_30870":57207,"_3543":57381},[],"`--https-port`",{"_4098":156,"_34307":91,"_23429":57383,"_5":16198,"_30870":57207,"_3543":57384},[],"`443`",{"_4098":157,"_34307":91,"_23429":57386,"_5":16198,"_30870":57207,"_3543":57387},[],"Gateway HTTPS listener port",{"_4098":158,"_34307":91,"_23429":57389,"_5":16198,"_30870":57207,"_3543":57390},[],"`--http-port`",{"_4098":159,"_34307":91,"_23429":57392,"_5":16198,"_30870":57207,"_3543":57393},[],"`80`",{"_4098":160,"_34307":91,"_23429":57395,"_5":16198,"_30870":57207,"_3543":57396},[],"Gateway HTTP listener port",{"_4098":161,"_34307":91,"_23429":57398,"_5":16198,"_30870":57207,"_3543":57399},[],"`--tls-crt`",{"_4098":162,"_34307":91,"_23429":57401,"_5":16198,"_30870":57207,"_3543":57332},[],{"_4098":163,"_34307":91,"_23429":57403,"_5":16198,"_30870":57207,"_3543":57404},[],"PEM certificate for downstream TLS",{"_4098":164,"_34307":91,"_23429":57406,"_5":16198,"_30870":57207,"_3543":57407},[],"`--tls-key`",{"_4098":165,"_34307":91,"_23429":57409,"_5":16198,"_30870":57207,"_3543":57332},[],{"_4098":166,"_34307":91,"_23429":57411,"_5":16198,"_30870":57207,"_3543":57412},[],"PEM private key for downstream TLS",{"_4098":167,"_34307":91,"_23429":57414,"_5":16198,"_30870":57207,"_3543":57415},[],"`-l`, `--local-chart-path`",{"_4098":168,"_34307":91,"_23429":57417,"_5":16198,"_30870":57207,"_3543":57418},[],"repository chart",{"_4098":169,"_34307":91,"_23429":57420,"_5":16198,"_30870":57207,"_3543":57421},[],"Use an unpacked local Lamassu chart",{"_4098":170,"_34307":91,"_23429":57423,"_5":16198,"_30870":57207,"_3543":57424},[],"`-ip`, `--gateway-ip`",{"_4098":171,"_34307":91,"_23429":57426,"_5":16198,"_30870":57207,"_3543":9823},[],{"_4098":172,"_34307":91,"_23429":57428,"_5":16198,"_30870":57207,"_3543":57429},[],"Override the address written to `gateway.addresses`",{"_4098":173,"_34307":91,"_23429":57431,"_5":16198,"_30870":57207,"_3543":57432},[],"`--otel`",{"_4098":174,"_34307":91,"_23429":57434,"_5":16198,"_30870":57207,"_3543":7434},[],{"_4098":175,"_34307":91,"_23429":57436,"_5":16198,"_30870":57207,"_3543":57437},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_4098":176,"_34307":91,"_23429":57439,"_5":16198,"_30870":57207,"_3543":57440},[],"`--development`",{"_4098":177,"_34307":91,"_23429":57442,"_5":16198,"_30870":57207,"_3543":7434},[],{"_4098":178,"_34307":91,"_23429":57444,"_5":16198,"_30870":57207,"_3543":57445},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_4098":179,"_34307":91,"_23429":57447,"_5":16198,"_30870":57207,"_3543":57448},[],"`--sample-data`",{"_4098":180,"_34307":91,"_23429":57450,"_5":16198,"_30870":57207,"_3543":7434},[],{"_4098":181,"_34307":91,"_23429":57452,"_5":16198,"_30870":57207,"_3543":57453},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_4098":182,"_34307":91,"_23429":57455,"_5":16198,"_30870":57207,"_3543":57456},[],"`--with-hsm`",{"_4098":183,"_34307":91,"_23429":57458,"_5":16198,"_30870":57207,"_3543":7434},[],{"_4098":184,"_34307":91,"_23429":57460,"_5":16198,"_30870":57207,"_3543":57461},[],"Install lab HSM components and configure KMS for PKCS#11",{"_4098":185,"_34307":91,"_23429":57463,"_5":16198,"_30870":57207,"_3543":57464},[],"`--softhsm-chart-path`",{"_4098":186,"_34307":91,"_23429":57466,"_5":16198,"_30870":57207,"_3543":57467},[],"`./charts/softhsm`",{"_4098":187,"_34307":91,"_23429":57469,"_5":16198,"_30870":57207,"_3543":57470},[],"Use a different local SoftHSM chart",{"_4098":188,"_34307":91,"_23429":57472,"_5":16198,"_30870":57207,"_3543":57473},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_4098":189,"_34307":91,"_23429":57475,"_5":16198,"_30870":57211,"_3543":57476},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_4098":190,"_34307":91,"_23429":57478,"_5":16198,"_30870":57211,"_3543":57479},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_4098":191,"_34307":91,"_23429":57481,"_5":16198,"_30870":57211,"_3543":57482},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_4098":192,"_34307":91,"_23429":57484,"_5":16198,"_30870":57211,"_3543":57485},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_4098":193,"_34307":91,"_23429":57487,"_5":16198,"_30870":57211,"_3543":57488},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_4098":194,"_34307":91,"_23429":57490,"_5":16198,"_30870":57211,"_3543":57491},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_4098":195,"_34307":91,"_23429":57493,"_5":16198,"_30870":57215,"_3543":57494},[],"Fastlane:",{"_4098":196,"_34307":91,"_23429":57496,"_5":16198,"_30870":57215,"_3543":57497},[],"validates local tools and the selected cluster",{"_4098":197,"_34307":91,"_23429":57499,"_5":16198,"_30870":57215,"_3543":57500},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_4098":198,"_34307":91,"_23429":57502,"_5":16198,"_30870":57215,"_3543":57503},[],"creates the namespace",{"_4098":199,"_34307":91,"_23429":57505,"_5":16198,"_30870":57215,"_3543":57506},[],"installs PostgreSQL and creates the required databases",{"_4098":200,"_34307":91,"_23429":57508,"_5":16198,"_30870":57215,"_3543":57509},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_4098":201,"_34307":91,"_23429":57511,"_5":16198,"_30870":57215,"_3543":57512},[],"installs RabbitMQ",{"_4098":202,"_34307":91,"_23429":57514,"_5":16198,"_30870":57215,"_3543":57515},[],"optionally installs observability and lab HSM components",{"_4098":203,"_34307":91,"_23429":57517,"_5":16198,"_30870":57215,"_3543":57518},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_4098":204,"_34307":91,"_23429":57520,"_5":16198,"_30870":57215,"_3543":57521},[],"optionally loads sample data",{"_4098":205,"_34307":91,"_23429":57523,"_5":16198,"_30870":57215,"_3543":57524},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_4098":206,"_34307":91,"_23429":57526,"_5":16198,"_30870":57219,"_3543":57527},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_4098":207,"_34307":91,"_23429":57529,"_5":16198,"_30870":57219,"_3543":57530},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_4098":208,"_34307":91,"_23429":57532,"_5":16198,"_30870":57223,"_3543":57533},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_4098":209,"_34307":91,"_23429":57535,"_5":16198,"_30870":57223,"_3543":57536},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_4098":210,"_34307":91,"_23429":57538,"_5":16198,"_30870":57223,"_3543":57539},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_4098":211,"_34307":91,"_23429":57541,"_5":16198,"_30870":57227,"_3543":57542},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_4098":212,"_34307":212,"_5":16596,"_3543":57544,"_34738":57545,"_23429":57546,"_30870":212},"Install with Helm",[56936,56937,57043],[],{"_4098":213,"_34307":212,"_23429":57548,"_5":16198,"_30870":212,"_3543":57549},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_4098":214,"_34307":212,"_5":34735,"_23429":57551,"_30870":57552,"_3543":57553},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_4098":215,"_34307":212,"_5":34735,"_23429":57555,"_30870":57556,"_3543":56946},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#before-you-begin",{"_4098":216,"_34307":212,"_5":34735,"_23429":57558,"_30870":57559,"_3543":57560},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_4098":217,"_34307":212,"_5":34735,"_23429":57562,"_30870":57563,"_3543":57564},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_4098":218,"_34307":212,"_5":34735,"_23429":57566,"_30870":57567,"_3543":57568},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_4098":219,"_34307":212,"_5":34735,"_23429":57570,"_30870":57571,"_3543":57572},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_4098":220,"_34307":212,"_5":34735,"_23429":57574,"_30870":57575,"_3543":57576},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_4098":221,"_34307":212,"_5":34735,"_23429":57578,"_30870":57579,"_3543":57580},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_4098":222,"_34307":212,"_5":34735,"_23429":57582,"_30870":57583,"_3543":57584},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_4098":223,"_34307":212,"_5":34735,"_23429":57586,"_30870":57587,"_3543":57588},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_4098":224,"_34307":212,"_5":34735,"_23429":57590,"_30870":57591,"_3543":57592},[],"/docs/pr-preview/pr-58/deployment/self-hosted/helm#production-decisions","Production decisions",{"_4098":225,"_34307":212,"_23429":57594,"_5":16198,"_30870":57552,"_3543":57595},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_4098":226,"_34307":212,"_23429":57597,"_5":16198,"_30870":57556,"_3543":57598},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_4098":227,"_34307":212,"_23429":57600,"_5":16198,"_30870":57556,"_3543":57601},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_4098":228,"_34307":212,"_23429":57603,"_5":16198,"_30870":57556,"_3543":57604},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_4098":229,"_34307":212,"_23429":57606,"_5":16198,"_30870":57556,"_3543":57607},[],"a reachable RabbitMQ broker and credentials",{"_4098":230,"_34307":212,"_23429":57609,"_5":16198,"_30870":57556,"_3543":57610},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_4098":231,"_34307":212,"_23429":57612,"_5":16198,"_30870":57556,"_3543":57613},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_4098":232,"_34307":212,"_23429":57615,"_5":16198,"_30870":57556,"_3543":57616},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_4098":233,"_34307":212,"_23429":57618,"_5":16198,"_30870":57556,"_3543":57619},[],"a StorageClass and an external traffic design",{"_4098":234,"_34307":212,"_23429":57621,"_5":16198,"_30870":57556,"_3543":57622},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_4098":235,"_34307":212,"_23429":57624,"_5":16198,"_30870":57556,"_3543":57625},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_4098":236,"_34307":212,"_23429":57627,"_5":16198,"_30870":57556,"_3543":57628},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_4098":237,"_34307":212,"_23429":57630,"_5":16198,"_30870":57559,"_3543":57631},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_4098":238,"_34307":212,"_23429":57633,"_5":16198,"_30870":57559,"_3543":57634},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_4098":239,"_34307":212,"_23429":57636,"_5":16198,"_30870":57559,"_3543":57637},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_4098":240,"_34307":212,"_23429":57639,"_5":16198,"_30870":57563,"_3543":57640},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_4098":241,"_34307":212,"_23429":57642,"_5":16198,"_30870":57563,"_3543":57643},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_4098":242,"_34307":212,"_23429":57645,"_5":16198,"_30870":57563,"_3543":57646},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_4098":243,"_34307":212,"_23429":57648,"_5":16198,"_30870":57563,"_3543":57649},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_4098":244,"_34307":212,"_23429":57651,"_5":16198,"_30870":57567,"_3543":57652},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_4098":245,"_34307":212,"_23429":57654,"_5":16198,"_30870":57571,"_3543":57655},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_4098":246,"_34307":212,"_23429":57657,"_5":16198,"_30870":57571,"_3543":57658},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_4098":247,"_34307":212,"_23429":57660,"_5":16198,"_30870":57571,"_3543":57661},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_4098":248,"_34307":212,"_23429":57663,"_5":16198,"_30870":57571,"_3543":57664},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_4098":249,"_34307":212,"_23429":57666,"_5":16198,"_30870":57571,"_3543":57667},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_4098":250,"_34307":212,"_23429":57669,"_5":16198,"_30870":57571,"_3543":57670},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_4098":251,"_34307":212,"_23429":57672,"_5":16198,"_30870":57571,"_3543":57673},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_4098":252,"_34307":212,"_23429":57675,"_5":16198,"_30870":57575,"_3543":57676},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_4098":253,"_34307":212,"_23429":57678,"_5":16198,"_30870":57575,"_3543":57679},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_4098":254,"_34307":212,"_23429":57681,"_5":16198,"_30870":57575,"_3543":57682},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_4098":255,"_34307":212,"_23429":57684,"_5":16198,"_30870":57575,"_3543":57685},[],"See Access control for the principal and policy model.",{"_4098":256,"_34307":212,"_23429":57687,"_5":16198,"_30870":57579,"_3543":57688},[],"To install a local checkout instead:",{"_4098":257,"_34307":212,"_23429":57690,"_5":16198,"_30870":57583,"_3543":57691},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_4098":258,"_34307":212,"_23429":57693,"_5":16198,"_30870":57583,"_3543":57694},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_4098":259,"_34307":212,"_23429":57696,"_5":16198,"_30870":57587,"_3543":57697},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_4098":260,"_34307":212,"_23429":57699,"_5":16198,"_30870":57587,"_3543":57700},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_4098":261,"_34307":212,"_23429":57702,"_5":16198,"_30870":57587,"_3543":57703},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_4098":262,"_34307":212,"_23429":57705,"_5":16198,"_30870":57587,"_3543":57706},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_4098":263,"_34307":212,"_23429":57708,"_5":16198,"_30870":57587,"_3543":57709},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_4098":264,"_34307":212,"_23429":57711,"_5":16198,"_30870":57591,"_3543":57712},[],"Before going live, review:",{"_4098":265,"_34307":212,"_23429":57714,"_5":16198,"_30870":57591,"_3543":57715},[],"backup and recovery for PostgreSQL and persistent volumes",{"_4098":266,"_34307":212,"_23429":57717,"_5":16198,"_30870":57591,"_3543":57718},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_4098":267,"_34307":212,"_23429":57720,"_5":16198,"_30870":57591,"_3543":57721},[],"shared VA storage before increasing VA replicas",{"_4098":268,"_34307":212,"_23429":57723,"_5":16198,"_30870":57591,"_3543":57724},[],"managed OIDC roles and removal of evaluation credentials",{"_4098":269,"_34307":212,"_23429":57726,"_5":16198,"_30870":57591,"_3543":57727},[],"a trusted TLS issuer or externally managed certificate",{"_4098":270,"_34307":212,"_23429":57729,"_5":16198,"_30870":57591,"_3543":57730},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_4098":271,"_34307":212,"_23429":57732,"_5":16198,"_30870":57591,"_3543":57733},[],"SMTP, observability and alert delivery",{"_4098":272,"_34307":212,"_23429":57735,"_5":16198,"_30870":57591,"_3543":57736},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_4098":273,"_34307":212,"_23429":57738,"_5":16198,"_30870":57591,"_3543":57739},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_4098":274,"_34307":274,"_5":16596,"_3543":57741,"_34738":57742,"_23429":57743,"_30870":274},"Expose the Gateway",[56936,56937,57043],[],{"_4098":275,"_34307":274,"_23429":57745,"_5":16198,"_30870":274,"_3543":57746},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_4098":276,"_34307":274,"_5":34735,"_23429":57748,"_30870":57749,"_3543":57750},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_4098":277,"_34307":274,"_5":34735,"_23429":57752,"_30870":57753,"_3543":57754},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_4098":278,"_34307":274,"_5":34735,"_23429":57756,"_30870":57757,"_3543":57758},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_4098":279,"_34307":274,"_5":34735,"_23429":57760,"_30870":57761,"_3543":57762},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#k3s","K3s",{"_4098":280,"_34307":274,"_5":34735,"_23429":57764,"_30870":57765,"_3543":57766},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_4098":281,"_34307":274,"_5":34735,"_23429":57768,"_30870":57769,"_3543":57770},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_4098":282,"_34307":274,"_5":34735,"_23429":57772,"_30870":57773,"_3543":57774},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_4098":283,"_34307":274,"_5":34735,"_23429":57776,"_30870":57777,"_3543":57778},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#decision-guide","Decision guide",{"_4098":284,"_34307":274,"_5":34735,"_23429":57780,"_30870":57781,"_3543":57782},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_4098":285,"_34307":274,"_5":34735,"_23429":57784,"_30870":57785,"_3543":57786},[],"/docs/pr-preview/pr-58/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_4098":286,"_34307":274,"_23429":57788,"_5":16198,"_30870":57749,"_3543":57789},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_4098":287,"_34307":274,"_23429":57791,"_5":16198,"_30870":57749,"_3543":57792},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_4098":288,"_34307":274,"_23429":57794,"_5":16198,"_30870":57753,"_3543":57795},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_4098":289,"_34307":274,"_23429":57797,"_5":16198,"_30870":57753,"_3543":57798},[],"Set it only when:",{"_4098":290,"_34307":274,"_23429":57800,"_5":16198,"_30870":57753,"_3543":57801},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_4098":291,"_34307":274,"_23429":57803,"_5":16198,"_30870":57753,"_3543":57804},[],"that address is allocated to this Gateway",{"_4098":292,"_34307":274,"_23429":57806,"_5":16198,"_30870":57753,"_3543":57807},[],"the surrounding network already routes traffic for it to the cluster",{"_4098":293,"_34307":274,"_23429":57809,"_5":16198,"_30870":57753,"_3543":57810},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_4098":294,"_34307":274,"_23429":57812,"_5":16198,"_30870":57753,"_3543":57813},[],"Keep these two settings separate:",{"_4098":295,"_34307":274,"_23429":57815,"_5":16198,"_30870":57753,"_3543":57816},[],"`gateway.addresses` requests an address for the Gateway.",{"_4098":296,"_34307":274,"_23429":57818,"_5":16198,"_30870":57753,"_3543":57819},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_4098":297,"_34307":274,"_23429":57821,"_5":16198,"_30870":57753,"_3543":57822},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_4098":298,"_34307":274,"_23429":57824,"_5":16198,"_30870":57757,"_3543":57825},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_4098":299,"_34307":274,"_23429":57827,"_5":16198,"_30870":57757,"_3543":57828},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_4098":300,"_34307":274,"_23429":57830,"_5":16198,"_30870":57761,"_3543":57831},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_4098":301,"_34307":274,"_23429":57833,"_5":16198,"_30870":57761,"_3543":57834},[],"For the recommended design:",{"_4098":302,"_34307":274,"_23429":57836,"_5":16198,"_30870":57761,"_3543":57837},[],"Use only one externally exposed Lamassu Gateway.",{"_4098":303,"_34307":274,"_23429":57839,"_5":16198,"_30870":57761,"_3543":57840},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_4098":304,"_34307":274,"_23429":57842,"_5":16198,"_30870":57761,"_3543":57843},[],"Allow those ports through the VM firewall and any upstream security group.",{"_4098":305,"_34307":274,"_23429":57845,"_5":16198,"_30870":57761,"_3543":57846},[],"Point DNS at the VM's reachable address.",{"_4098":306,"_34307":274,"_23429":57848,"_5":16198,"_30870":57761,"_3543":57849},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_4098":307,"_34307":274,"_23429":57851,"_5":16198,"_30870":57765,"_3543":57852},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_4098":308,"_34307":274,"_23429":57854,"_5":16198,"_30870":57769,"_3543":57855},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_4098":309,"_34307":274,"_23429":57857,"_5":16198,"_30870":57769,"_3543":57858},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_4098":310,"_34307":274,"_23429":57860,"_5":16198,"_30870":57773,"_3543":57861},[],"First decide whether you need three independent data planes or only three hostnames.",{"_4098":311,"_34307":274,"_23429":57863,"_5":16198,"_30870":57773,"_3543":57864},[],"Requirement",{"_4098":312,"_34307":274,"_23429":57866,"_5":16198,"_30870":57773,"_3543":57867},[],"Recommended design",{"_4098":313,"_34307":274,"_23429":57869,"_5":16198,"_30870":57773,"_3543":57870},[],"Consequence",{"_4098":314,"_34307":274,"_23429":57872,"_5":16198,"_30870":57773,"_3543":57873},[],"Several Lamassu URLs or services",{"_4098":315,"_34307":274,"_23429":57875,"_5":16198,"_30870":57773,"_3543":57876},[],"One Gateway with multiple routes",{"_4098":316,"_34307":274,"_23429":57878,"_5":16198,"_30870":57773,"_3543":57879},[],"One IP and one proxy fleet; this is the chart default",{"_4098":317,"_34307":274,"_23429":57881,"_5":16198,"_30870":57773,"_3543":57882},[],"Independent Gateways and separate external IPs",{"_4098":318,"_34307":274,"_23429":57884,"_5":16198,"_30870":57773,"_3543":57885},[],"One VIP per Gateway",{"_4098":319,"_34307":274,"_23429":57887,"_5":16198,"_30870":57773,"_3543":57888},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_4098":320,"_34307":274,"_23429":57890,"_5":16198,"_30870":57773,"_3543":57891},[],"Independent Gateways on one node and one IP",{"_4098":321,"_34307":274,"_23429":57893,"_5":16198,"_30870":57773,"_3543":57894},[],"Use different external ports",{"_4098":322,"_34307":274,"_23429":57896,"_5":16198,"_30870":57773,"_3543":57897},[],"Clients must include non-standard ports",{"_4098":323,"_34307":274,"_23429":57899,"_5":16198,"_30870":57773,"_3543":57900},[],"Separate TLS/mTLS termination behind one IP",{"_4098":324,"_34307":274,"_23429":57902,"_5":16198,"_30870":57773,"_3543":57903},[],"Front-door SNI routing to internal Gateways",{"_4098":325,"_34307":274,"_23429":57905,"_5":16198,"_30870":57773,"_3543":57906},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_4098":326,"_34307":274,"_23429":57908,"_5":16198,"_30870":57773,"_3543":57909},[],"Separate Gateway resources but shared proxy infrastructure",{"_4098":327,"_34307":274,"_23429":57911,"_5":16198,"_30870":57773,"_3543":57912},[],"Envoy merged-Gateway mode",{"_4098":328,"_34307":274,"_23429":57914,"_5":16198,"_30870":57773,"_3543":57915},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_4098":329,"_34307":274,"_23429":57917,"_5":16198,"_30870":57773,"_3543":57918},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_4098":330,"_34307":274,"_23429":57920,"_5":16198,"_30870":57773,"_3543":57921},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_4098":331,"_34307":274,"_23429":57923,"_5":16198,"_30870":57773,"_3543":57924},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_4098":332,"_34307":274,"_23429":57926,"_5":16198,"_30870":57773,"_3543":57927},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_4098":333,"_34307":274,"_23429":57929,"_5":16198,"_30870":57777,"_3543":57930},[],"If one Gateway can own TLS and routing, use the chart default.",{"_4098":334,"_34307":274,"_23429":57932,"_5":16198,"_30870":57777,"_3543":57933},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_4098":335,"_34307":274,"_23429":57935,"_5":16198,"_30870":57777,"_3543":57936},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_4098":336,"_34307":274,"_23429":57938,"_5":16198,"_30870":57777,"_3543":57939},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_4098":337,"_34307":274,"_23429":57941,"_5":16198,"_30870":57777,"_3543":57942},[],"If none of those are possible, use different external ports or change the external network design.",{"_4098":338,"_34307":274,"_23429":57944,"_5":16198,"_30870":57781,"_3543":57945},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_4098":339,"_34307":274,"_23429":57947,"_5":16198,"_30870":57781,"_3543":57948},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_4098":340,"_34307":274,"_23429":57950,"_5":16198,"_30870":57785,"_3543":57951},[],"Check, in order:",{"_4098":341,"_34307":274,"_23429":57953,"_5":16198,"_30870":57785,"_3543":57954},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_4098":342,"_34307":274,"_23429":57956,"_5":16198,"_30870":57785,"_3543":57957},[],"Its status contains the expected address.",{"_4098":343,"_34307":274,"_23429":57959,"_5":16198,"_30870":57785,"_3543":57960},[],"The generated `LoadBalancer` Service has a usable external address.",{"_4098":344,"_34307":274,"_23429":57962,"_5":16198,"_30870":57785,"_3543":57963},[],"Port 443 reaches that address from the client network.",{"_4098":345,"_34307":274,"_23429":57965,"_5":16198,"_30870":57785,"_3543":57966},[],"DNS resolves to the externally reachable endpoint.",{"_4098":346,"_34307":274,"_23429":57968,"_5":16198,"_30870":57785,"_3543":57969},[],"The certificate contains the DNS name or IP used by the client.",{"_4098":347,"_34307":274,"_23429":57971,"_5":16198,"_30870":57785,"_3543":57972},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_4098":348,"_34307":348,"_5":16596,"_3543":57043,"_34738":57974,"_23429":57975,"_30870":348},[56936,56937,57043],[],{"_4098":349,"_34307":348,"_23429":57977,"_5":16198,"_30870":348,"_3543":57978},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_4098":350,"_34307":348,"_5":34735,"_23429":57980,"_30870":57981,"_3543":57982},[],"/docs/pr-preview/pr-58/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_4098":351,"_34307":348,"_5":34735,"_23429":57984,"_30870":57985,"_3543":57986},[],"/docs/pr-preview/pr-58/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_4098":352,"_34307":348,"_5":34735,"_23429":57988,"_30870":57989,"_3543":57990},[],"/docs/pr-preview/pr-58/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_4098":353,"_34307":348,"_5":34735,"_23429":57992,"_30870":57993,"_3543":57994},[],"/docs/pr-preview/pr-58/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_4098":354,"_34307":348,"_5":34735,"_23429":57996,"_30870":57997,"_3543":57998},[],"/docs/pr-preview/pr-58/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_4098":355,"_34307":348,"_5":34735,"_23429":58000,"_30870":58001,"_3543":58002},[],"/docs/pr-preview/pr-58/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_4098":356,"_34307":348,"_23429":58004,"_5":16198,"_30870":57981,"_3543":58005},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_4098":357,"_34307":348,"_23429":58007,"_5":16198,"_30870":57985,"_3543":58008},[],"Workflow",{"_4098":358,"_34307":348,"_23429":58010,"_5":16198,"_30870":57985,"_3543":58011},[],"Use it for",{"_4098":359,"_34307":348,"_23429":58013,"_5":16198,"_30870":57985,"_3543":58014},[],"What it installs",{"_4098":360,"_34307":348,"_23429":58016,"_5":16198,"_30870":57985,"_3543":58017},[],"Helm",{"_4098":361,"_34307":348,"_23429":58019,"_5":16198,"_30870":57985,"_3543":58020},[],"Production and controlled environments",{"_4098":362,"_34307":348,"_23429":58022,"_5":16198,"_30870":57985,"_3543":58023},[],"Lamassu services and Gateway API resources",{"_4098":363,"_34307":348,"_23429":58025,"_5":16198,"_30870":57985,"_3543":57180},[],{"_4098":364,"_34307":348,"_23429":58027,"_5":16198,"_30870":57985,"_3543":58028},[],"Evaluation, demos, CI and small lab clusters",{"_4098":365,"_34307":348,"_23429":58030,"_5":16198,"_30870":57985,"_3543":58031},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_4098":366,"_34307":348,"_23429":58033,"_5":16198,"_30870":57989,"_3543":58034},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_4098":367,"_34307":348,"_23429":58036,"_5":16198,"_30870":57989,"_3543":58037},[],"Area",{"_4098":368,"_34307":348,"_23429":58039,"_5":16198,"_30870":57989,"_3543":58040},[],"The Lamassu chart provides",{"_4098":369,"_34307":348,"_23429":58042,"_5":16198,"_30870":57989,"_3543":58043},[],"You provide",{"_4098":370,"_34307":348,"_23429":58045,"_5":16198,"_30870":57989,"_3543":58046},[],"Lamassu applications",{"_4098":371,"_34307":348,"_23429":58048,"_5":16198,"_30870":57989,"_3543":58049},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_4098":372,"_34307":348,"_23429":58051,"_5":16198,"_30870":57989,"_3543":58052},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_4098":373,"_34307":348,"_23429":58054,"_5":16198,"_30870":57989,"_3543":58055},[],"PostgreSQL data",{"_4098":374,"_34307":348,"_23429":58057,"_5":16198,"_30870":57989,"_3543":58058},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_4098":375,"_34307":348,"_23429":58060,"_5":16198,"_30870":57989,"_3543":58061},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_4098":376,"_34307":348,"_23429":58063,"_5":16198,"_30870":57989,"_3543":58064},[],"Messaging",{"_4098":377,"_34307":348,"_23429":58066,"_5":16198,"_30870":57989,"_3543":58067},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_4098":378,"_34307":348,"_23429":58069,"_5":16198,"_30870":57989,"_3543":58070},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_4098":379,"_34307":348,"_23429":58072,"_5":16198,"_30870":57989,"_3543":58073},[],"Identity",{"_4098":380,"_34307":348,"_23429":58075,"_5":16198,"_30870":57989,"_3543":58076},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_4098":381,"_34307":348,"_23429":58078,"_5":16198,"_30870":57989,"_3543":58079},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_4098":382,"_34307":348,"_23429":58081,"_5":16198,"_30870":57989,"_3543":58082},[],"External routing",{"_4098":383,"_34307":348,"_23429":58084,"_5":16198,"_30870":57989,"_3543":58085},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_4098":384,"_34307":348,"_23429":58087,"_5":16198,"_30870":57989,"_3543":58088},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_4098":385,"_34307":348,"_23429":58090,"_5":16198,"_30870":57989,"_3543":58091},[],"TLS",{"_4098":386,"_34307":348,"_23429":58093,"_5":16198,"_30870":57989,"_3543":58094},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_4098":387,"_34307":348,"_23429":58096,"_5":16198,"_30870":57989,"_3543":58097},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_4098":388,"_34307":348,"_23429":58099,"_5":16198,"_30870":57989,"_3543":58100},[],"Persistent application data",{"_4098":389,"_34307":348,"_23429":58102,"_5":16198,"_30870":57989,"_3543":58103},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_4098":390,"_34307":348,"_23429":58105,"_5":16198,"_30870":57989,"_3543":58106},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_4098":391,"_34307":348,"_23429":58108,"_5":16198,"_30870":57989,"_3543":58109},[],"Optional integrations",{"_4098":392,"_34307":348,"_23429":58111,"_5":16198,"_30870":57989,"_3543":58112},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_4098":393,"_34307":348,"_23429":58114,"_5":16198,"_30870":57989,"_3543":58115},[],"The observability backends, cloud credentials and production HSM or external key service",{"_4098":394,"_34307":348,"_23429":58117,"_5":16198,"_30870":57989,"_3543":58118},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_4098":395,"_34307":348,"_23429":58120,"_5":16198,"_30870":57989,"_3543":58121},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_4098":396,"_34307":348,"_23429":58123,"_5":16198,"_30870":57993,"_3543":58124},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_4098":397,"_34307":348,"_23429":58126,"_5":16198,"_30870":57993,"_3543":58127},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_4098":398,"_34307":348,"_23429":58129,"_5":16198,"_30870":57997,"_3543":58130},[],"Kubernetes 1.24 or newer",{"_4098":399,"_34307":348,"_23429":58132,"_5":16198,"_30870":57997,"_3543":58133},[],"Helm 3.2 or newer",{"_4098":400,"_34307":348,"_23429":58135,"_5":16198,"_30870":57997,"_3543":58136},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_4098":401,"_34307":348,"_23429":58138,"_5":16198,"_30870":57997,"_3543":58139},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_4098":402,"_34307":348,"_23429":58141,"_5":16198,"_30870":57997,"_3543":58142},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_4098":403,"_34307":348,"_23429":58144,"_5":16198,"_30870":57997,"_3543":58145},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_4098":404,"_34307":348,"_23429":58147,"_5":16198,"_30870":57997,"_3543":58148},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_4098":405,"_34307":348,"_23429":58150,"_5":16198,"_30870":58001,"_3543":58151},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_4098":406,"_34307":348,"_23429":58153,"_5":16198,"_30870":58001,"_3543":58154},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_4098":407,"_34307":348,"_23429":58156,"_5":16198,"_30870":58001,"_3543":58157},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_4098":408,"_34307":348,"_23429":58159,"_5":16198,"_30870":58001,"_3543":58160},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_4098":409,"_34307":409,"_5":16596,"_3543":58162,"_34738":58163,"_23429":58165,"_30870":409},"Deployment troubleshooting",[56936,56937,58164],"Operations",[],{"_4098":410,"_34307":409,"_23429":58167,"_5":16198,"_30870":409,"_3543":58168},[],"Diagnose access, service health and infrastructure dependencies.",{"_4098":411,"_34307":409,"_5":34735,"_23429":58170,"_30870":58171,"_3543":58172},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_4098":412,"_34307":409,"_5":34735,"_23429":58174,"_30870":58175,"_3543":58176},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_4098":413,"_34307":409,"_5":34735,"_23429":58178,"_30870":58179,"_3543":58180},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_4098":414,"_34307":409,"_5":34735,"_23429":58182,"_30870":58183,"_3543":58184},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_4098":415,"_34307":409,"_5":34735,"_23429":58186,"_30870":58187,"_3543":58188},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_4098":416,"_34307":409,"_5":34735,"_23429":58190,"_30870":58191,"_3543":58192},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_4098":417,"_34307":409,"_5":34735,"_23429":58194,"_30870":58195,"_3543":58196},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_4098":418,"_34307":409,"_5":34735,"_23429":58198,"_30870":58199,"_3543":58200},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_4098":419,"_34307":409,"_5":34735,"_23429":58202,"_30870":58203,"_3543":58204},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_4098":420,"_34307":409,"_5":34735,"_23429":58206,"_30870":58207,"_3543":58208},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#api-500-errors","API 500 errors",{"_4098":421,"_34307":409,"_5":34735,"_23429":58210,"_30870":58211,"_3543":58212},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_4098":422,"_34307":409,"_5":34735,"_23429":58214,"_30870":58215,"_3543":58216},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_4098":423,"_34307":409,"_5":34735,"_23429":58218,"_30870":58219,"_3543":58220},[],"/docs/pr-preview/pr-58/deployment/troubleshooting#observability","Observability",{"_4098":424,"_34307":409,"_23429":58222,"_5":16198,"_30870":409,"_3543":58223},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_4098":425,"_34307":409,"_23429":58225,"_5":16198,"_30870":58175,"_3543":58226},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_4098":426,"_34307":409,"_23429":58228,"_5":16198,"_30870":58179,"_3543":58229},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_4098":427,"_34307":409,"_23429":58231,"_5":16198,"_30870":58183,"_3543":58232},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_4098":428,"_34307":409,"_23429":58234,"_5":16198,"_30870":58187,"_3543":58235},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_4098":429,"_34307":409,"_23429":58237,"_5":16198,"_30870":58191,"_3543":58238},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_4098":430,"_34307":409,"_23429":58240,"_5":16198,"_30870":58195,"_3543":58241},[],"Replace the placeholders with your real release, namespace and deployment.",{"_4098":431,"_34307":409,"_23429":58243,"_5":16198,"_30870":58195,"_3543":58244},[],"Also run the chart's connectivity test:",{"_4098":432,"_34307":409,"_23429":58246,"_5":16198,"_30870":58195,"_3543":58247},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_4098":433,"_34307":409,"_23429":58249,"_5":16198,"_30870":58195,"_3543":58250},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_4098":434,"_34307":409,"_23429":58252,"_5":16198,"_30870":58199,"_3543":58253},[],"If you receive a 401:",{"_4098":435,"_34307":409,"_23429":58255,"_5":16198,"_30870":58199,"_3543":58256},[],"check that the UI's OIDC authority is reachable from the browser;",{"_4098":436,"_34307":409,"_23429":58258,"_5":16198,"_30870":58199,"_3543":58259},[],"verify issuer, audience and expiration of the token;",{"_4098":437,"_34307":409,"_23429":58261,"_5":16198,"_30870":58199,"_3543":58262},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_4098":438,"_34307":409,"_23429":58264,"_5":16198,"_30870":58199,"_3543":58265},[],"check that the provider's public and internal routes point to the same realm.",{"_4098":439,"_34307":409,"_23429":58267,"_5":16198,"_30870":58199,"_3543":58268},[],"If login succeeds but the APIs return 403:",{"_4098":440,"_34307":409,"_23429":58270,"_5":16198,"_30870":58199,"_3543":58271},[],"inspect the token's real claims;",{"_4098":441,"_34307":409,"_23429":58273,"_5":16198,"_30870":58199,"_3543":58274},[],"confirm they match an active principal;",{"_4098":442,"_34307":409,"_23429":58276,"_5":16198,"_30870":58199,"_3543":58277},[],"review the policies granted to that principal;",{"_4098":443,"_34307":409,"_23429":58279,"_5":16198,"_30870":58199,"_3543":58280},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_4098":444,"_34307":409,"_23429":58282,"_5":16198,"_30870":58199,"_3543":58283},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_4098":445,"_34307":409,"_23429":58285,"_5":16198,"_30870":58203,"_3543":58286},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_4098":446,"_34307":409,"_23429":58288,"_5":16198,"_30870":58203,"_3543":58289},[],"Locate the authz pod and Service.",{"_4098":447,"_34307":409,"_23429":58291,"_5":16198,"_30870":58203,"_3543":58292},[],"Check /health, logs and its database connection.",{"_4098":448,"_34307":409,"_23429":58294,"_5":16198,"_30870":58203,"_3543":58295},[],"Verify the DNS and port configured in externalAuthorization.",{"_4098":449,"_34307":409,"_23429":58297,"_5":16198,"_30870":58203,"_3543":58298},[],"Check the check route is /v1/ext\\_authz/check.",{"_4098":450,"_34307":409,"_23429":58300,"_5":16198,"_30870":58203,"_3543":58301},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_4098":451,"_34307":409,"_23429":58303,"_5":16198,"_30870":58207,"_3543":58304},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_4098":452,"_34307":409,"_23429":58306,"_5":16198,"_30870":58211,"_3543":58307},[],"Review kubectl describe pod first. Common causes are:",{"_4098":453,"_34307":409,"_23429":58309,"_5":16198,"_30870":58211,"_3543":58310},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_4098":454,"_34307":409,"_23429":58312,"_5":16198,"_30870":58211,"_3543":58313},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_4098":455,"_34307":409,"_23429":58315,"_5":16198,"_30870":58211,"_3543":58316},[],"unbound persistent volume;",{"_4098":456,"_34307":409,"_23429":58318,"_5":16198,"_30870":58211,"_3543":58319},[],"inaccessible image or incorrect pull policy;",{"_4098":457,"_34307":409,"_23429":58321,"_5":16198,"_30870":58211,"_3543":58322},[],"invalid cryptographic engine configuration;",{"_4098":458,"_34307":409,"_23429":58324,"_5":16198,"_30870":58211,"_3543":58325},[],"CPU or memory limits set too low;",{"_4098":459,"_34307":409,"_23429":58327,"_5":16198,"_30870":58211,"_3543":58328},[],"an incomplete prior migration.",{"_4098":460,"_34307":409,"_23429":58330,"_5":16198,"_30870":58211,"_3543":58331},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_4098":461,"_34307":409,"_23429":58333,"_5":16198,"_30870":58211,"_3543":58334},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_4098":462,"_34307":409,"_23429":58336,"_5":16198,"_30870":58211,"_3543":58337},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_4098":463,"_34307":409,"_23429":58339,"_5":16198,"_30870":58215,"_3543":58340},[],"Domain and audit events depend on the bus publisher:",{"_4098":464,"_34307":409,"_23429":58342,"_5":16198,"_30870":58215,"_3543":58343},[],"verify it is enabled in the emitting service;",{"_4098":465,"_34307":409,"_23429":58345,"_5":16198,"_30870":58215,"_3543":58346},[],"check AMQP connectivity and credentials;",{"_4098":466,"_34307":409,"_23429":58348,"_5":16198,"_30870":58215,"_3543":58349},[],"review exchange, routing key, queues and consumers;",{"_4098":467,"_34307":409,"_23429":58351,"_5":16198,"_30870":58215,"_3543":58352},[],"inspect dead-letter queues;",{"_4098":468,"_34307":409,"_23429":58354,"_5":16198,"_30870":58215,"_3543":58355},[],"alert on orphan durable queues and backlog growth.",{"_4098":469,"_34307":409,"_23429":58357,"_5":16198,"_30870":58215,"_3543":58358},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_4098":470,"_34307":409,"_23429":58360,"_5":16198,"_30870":58215,"_3543":58361},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_4098":471,"_34307":409,"_23429":58363,"_5":16198,"_30870":58215,"_3543":58364},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_4098":472,"_34307":409,"_23429":58366,"_5":16198,"_30870":58215,"_3543":58367},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_4098":473,"_34307":409,"_23429":58369,"_5":16198,"_30870":58215,"_3543":58370},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_4098":474,"_34307":409,"_23429":58372,"_5":16198,"_30870":58215,"_3543":58373},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_4098":475,"_34307":409,"_23429":58375,"_5":16198,"_30870":58215,"_3543":58376},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_4098":476,"_34307":409,"_23429":58378,"_5":16198,"_30870":58219,"_3543":58379},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_4098":477,"_34307":409,"_23429":58381,"_5":16198,"_30870":58219,"_3543":58382},[],"Before closing an incident, record:",{"_4098":478,"_34307":409,"_23429":58384,"_5":16198,"_30870":58219,"_3543":58385},[],"the confirmed cause;",{"_4098":479,"_34307":409,"_23429":58387,"_5":16198,"_30870":58219,"_3543":58388},[],"the time scope and affected resources;",{"_4098":480,"_34307":409,"_23429":58390,"_5":16198,"_30870":58219,"_3543":58391},[],"the commands or queries used;",{"_4098":481,"_34307":409,"_23429":58393,"_5":16198,"_30870":58219,"_3543":58394},[],"the applied change and how to revert it;",{"_4098":482,"_34307":409,"_23429":58396,"_5":16198,"_30870":58219,"_3543":58397},[],"validation from a consumer;",{"_4098":483,"_34307":409,"_23429":58399,"_5":16198,"_30870":58219,"_3543":58400},[],"the preventive action and its owner.",{"_4098":484,"_34307":484,"_5":16596,"_3543":58402,"_34738":58403,"_23429":58406,"_30870":484},"Access control",[56936,58404,58405],"Platform","Administration",[],{"_4098":485,"_34307":484,"_23429":58408,"_5":16198,"_30870":484,"_3543":58409},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_4098":486,"_34307":484,"_5":34735,"_23429":58411,"_30870":58412,"_3543":58413},[],"/docs/pr-preview/pr-58/platform/administration/access-control#essential-concepts","Essential concepts",{"_4098":487,"_34307":484,"_5":34735,"_23429":58415,"_30870":58416,"_3543":58417},[],"/docs/pr-preview/pr-58/platform/administration/access-control#two-decision-systems","Two decision systems",{"_4098":488,"_34307":484,"_5":34735,"_23429":58419,"_30870":58420,"_3543":58421},[],"/docs/pr-preview/pr-58/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_4098":489,"_34307":484,"_5":34735,"_23429":58423,"_30870":58424,"_3543":58425},[],"/docs/pr-preview/pr-58/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_4098":490,"_34307":484,"_5":34735,"_23429":58427,"_30870":58428,"_3543":58429},[],"/docs/pr-preview/pr-58/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_4098":491,"_34307":484,"_5":34735,"_23429":58431,"_30870":58432,"_3543":58433},[],"/docs/pr-preview/pr-58/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_4098":492,"_34307":484,"_5":34735,"_23429":58435,"_30870":58436,"_3543":58437},[],"/docs/pr-preview/pr-58/platform/administration/access-control#oidc-principals","OIDC principals",{"_4098":493,"_34307":484,"_5":34735,"_23429":58439,"_30870":58440,"_3543":58441},[],"/docs/pr-preview/pr-58/platform/administration/access-control#x509-principals","X.509 principals",{"_4098":494,"_34307":484,"_5":34735,"_23429":58443,"_30870":58444,"_3543":58445},[],"/docs/pr-preview/pr-58/platform/administration/access-control#when-several-principals-match","When several principals match",{"_4098":495,"_34307":484,"_5":34735,"_23429":58447,"_30870":58448,"_3543":58449},[],"/docs/pr-preview/pr-58/platform/administration/access-control#how-policies-express-access","How policies express access",{"_4098":496,"_34307":484,"_5":34735,"_23429":58451,"_30870":58452,"_3543":58453},[],"/docs/pr-preview/pr-58/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_4098":497,"_34307":484,"_5":34735,"_23429":58455,"_30870":58456,"_3543":58457},[],"/docs/pr-preview/pr-58/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_4098":498,"_34307":484,"_5":34735,"_23429":58459,"_30870":58460,"_3543":58461},[],"/docs/pr-preview/pr-58/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_4098":499,"_34307":484,"_5":34735,"_23429":58463,"_30870":58464,"_3543":58465},[],"/docs/pr-preview/pr-58/platform/administration/access-control#http-rules","HTTP rules",{"_4098":500,"_34307":484,"_5":34735,"_23429":58467,"_30870":58468,"_3543":58469},[],"/docs/pr-preview/pr-58/platform/administration/access-control#included-policies","Included policies",{"_4098":501,"_34307":484,"_5":34735,"_23429":58471,"_30870":58472,"_3543":57576},[],"/docs/pr-preview/pr-58/platform/administration/access-control#provision-the-first-administrator",{"_4098":502,"_34307":484,"_5":34735,"_23429":58474,"_30870":58475,"_3543":58476},[],"/docs/pr-preview/pr-58/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_4098":503,"_34307":484,"_5":34735,"_23429":58478,"_30870":58479,"_3543":58480},[],"/docs/pr-preview/pr-58/platform/administration/access-control#configure-token-validation","Configure token validation",{"_4098":504,"_34307":484,"_5":34735,"_23429":58482,"_30870":58483,"_3543":58484},[],"/docs/pr-preview/pr-58/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_4098":505,"_34307":484,"_5":34735,"_23429":58486,"_30870":58487,"_3543":58488},[],"/docs/pr-preview/pr-58/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_4098":506,"_34307":484,"_5":34735,"_23429":58490,"_30870":58491,"_3543":58492},[],"/docs/pr-preview/pr-58/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_4098":507,"_34307":484,"_5":34735,"_23429":58494,"_30870":58495,"_3543":58496},[],"/docs/pr-preview/pr-58/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_4098":508,"_34307":484,"_5":34735,"_23429":58498,"_30870":58499,"_3543":58500},[],"/docs/pr-preview/pr-58/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_4098":509,"_34307":484,"_5":34735,"_23429":58502,"_30870":58503,"_3543":58504},[],"/docs/pr-preview/pr-58/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_4098":510,"_34307":484,"_5":34735,"_23429":58506,"_30870":58507,"_3543":58508},[],"/docs/pr-preview/pr-58/platform/administration/access-control#operational-checklist","Operational checklist",{"_4098":511,"_34307":484,"_5":34735,"_23429":58510,"_30870":58511,"_3543":58512},[],"/docs/pr-preview/pr-58/platform/administration/access-control#diagnostics","Diagnostics",{"_4098":512,"_34307":484,"_5":34735,"_23429":58514,"_30870":58515,"_3543":58516},[],"/docs/pr-preview/pr-58/platform/administration/access-control#the-response-is-401","The response is 401",{"_4098":513,"_34307":484,"_5":34735,"_23429":58518,"_30870":58519,"_3543":58520},[],"/docs/pr-preview/pr-58/platform/administration/access-control#the-response-is-403","The response is 403",{"_4098":514,"_34307":484,"_5":34735,"_23429":58522,"_30870":58523,"_3543":58524},[],"/docs/pr-preview/pr-58/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_4098":515,"_34307":484,"_5":34735,"_23429":58526,"_30870":58527,"_3543":58528},[],"/docs/pr-preview/pr-58/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_4098":516,"_34307":484,"_5":34735,"_23429":58530,"_30870":58531,"_3543":58532},[],"/docs/pr-preview/pr-58/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_4098":517,"_34307":484,"_23429":58534,"_5":16198,"_30870":484,"_3543":58535},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_4098":518,"_34307":484,"_23429":58537,"_5":16198,"_30870":484,"_3543":58538},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_4098":519,"_34307":484,"_23429":58540,"_5":16198,"_30870":484,"_3543":58541},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_4098":520,"_34307":484,"_23429":58543,"_5":16198,"_30870":58412,"_3543":58544},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_4098":521,"_34307":484,"_23429":58546,"_5":16198,"_30870":58412,"_3543":58547},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_4098":522,"_34307":484,"_23429":58549,"_5":16198,"_30870":58412,"_3543":58550},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_4098":523,"_34307":484,"_23429":58552,"_5":16198,"_30870":58412,"_3543":58553},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_4098":524,"_34307":484,"_23429":58555,"_5":16198,"_30870":58412,"_3543":58556},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_4098":525,"_34307":484,"_23429":58558,"_5":16198,"_30870":58412,"_3543":58559},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_4098":526,"_34307":484,"_23429":58561,"_5":16198,"_30870":58416,"_3543":58562},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_4098":527,"_34307":484,"_23429":58564,"_5":16198,"_30870":58416,"_3543":58565},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_4098":528,"_34307":484,"_23429":58567,"_5":16198,"_30870":58420,"_3543":58568},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_4098":529,"_34307":484,"_23429":58570,"_5":16198,"_30870":58420,"_3543":58571},[],"The decision is made **before forwarding the request to the service**:",{"_4098":530,"_34307":484,"_23429":58573,"_5":16198,"_30870":58420,"_3543":58574},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_4098":531,"_34307":484,"_23429":58576,"_5":16198,"_30870":58420,"_3543":58577},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_4098":532,"_34307":484,"_23429":58579,"_5":16198,"_30870":58420,"_3543":58580},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_4098":533,"_34307":484,"_23429":58582,"_5":16198,"_30870":58420,"_3543":58583},[],"It separately loads the policies granted to each principal.",{"_4098":534,"_34307":484,"_23429":58585,"_5":16198,"_30870":58420,"_3543":58586},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_4098":535,"_34307":484,"_23429":58588,"_5":16198,"_30870":58420,"_3543":58589},[],"`authz` looks for an HTTP rule granting that action.",{"_4098":536,"_34307":484,"_23429":58591,"_5":16198,"_30870":58420,"_3543":58592},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_4098":537,"_34307":484,"_23429":58594,"_5":16198,"_30870":58420,"_3543":58595},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_4098":538,"_34307":484,"_23429":58597,"_5":16198,"_30870":58420,"_3543":58598},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_4098":539,"_34307":484,"_23429":58600,"_5":16198,"_30870":58420,"_3543":58601},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_4098":540,"_34307":484,"_23429":58603,"_5":16198,"_30870":58424,"_3543":58604},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_4098":541,"_34307":484,"_23429":58606,"_5":16198,"_30870":58424,"_3543":58607},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_4098":542,"_34307":484,"_23429":58609,"_5":16198,"_30870":58424,"_3543":58610},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_4098":543,"_34307":484,"_23429":58612,"_5":16198,"_30870":58424,"_3543":58613},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_4098":544,"_34307":484,"_23429":58615,"_5":16198,"_30870":58424,"_3543":58616},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_4098":545,"_34307":484,"_23429":58618,"_5":16198,"_30870":58424,"_3543":58619},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_4098":546,"_34307":484,"_23429":58621,"_5":16198,"_30870":58424,"_3543":58622},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_4098":547,"_34307":484,"_23429":58624,"_5":16198,"_30870":58424,"_3543":58625},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_4098":548,"_34307":484,"_23429":58627,"_5":16198,"_30870":58428,"_3543":58628},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_4098":549,"_34307":484,"_23429":58630,"_5":16198,"_30870":58428,"_3543":58631},[],"The decision is made with the domain operation context:",{"_4098":550,"_34307":484,"_23429":58633,"_5":16198,"_30870":58428,"_3543":58634},[],"The middleware extracts the credential and resolves the matching principals.",{"_4098":551,"_34307":484,"_23429":58636,"_5":16198,"_30870":58428,"_3543":58637},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_4098":552,"_34307":484,"_23429":58639,"_5":16198,"_30870":58428,"_3543":58640},[],"`authz` gathers the entity rules of the granted policies.",{"_4098":553,"_34307":484,"_23429":58642,"_5":16198,"_30870":58428,"_3543":58643},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_4098":554,"_34307":484,"_23429":58645,"_5":16198,"_30870":58428,"_3543":58646},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_4098":555,"_34307":484,"_23429":58648,"_5":16198,"_30870":58428,"_3543":58649},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_4098":556,"_34307":484,"_23429":58651,"_5":16198,"_30870":58428,"_3543":58652},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_4098":557,"_34307":484,"_23429":58654,"_5":16198,"_30870":58428,"_3543":58655},[],"Actions fall into two groups:",{"_4098":558,"_34307":484,"_23429":58657,"_5":16198,"_30870":58428,"_3543":58658},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_4098":559,"_34307":484,"_23429":58660,"_5":16198,"_30870":58428,"_3543":58661},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_4098":560,"_34307":484,"_23429":58663,"_5":16198,"_30870":58428,"_3543":58664},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_4098":561,"_34307":484,"_23429":58666,"_5":16198,"_30870":58432,"_3543":58667},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_4098":562,"_34307":484,"_23429":58669,"_5":16198,"_30870":58432,"_3543":58670},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_4098":563,"_34307":484,"_23429":58672,"_5":16198,"_30870":58432,"_3543":58673},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_4098":564,"_34307":484,"_23429":58675,"_5":16198,"_30870":58436,"_3543":58676},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_4098":565,"_34307":484,"_23429":58678,"_5":16198,"_30870":58436,"_3543":58679},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_4098":566,"_34307":484,"_23429":58681,"_5":16198,"_30870":58436,"_3543":58682},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_4098":567,"_34307":484,"_23429":58684,"_5":16198,"_30870":58436,"_3543":58685},[],"The implemented operators are:",{"_4098":568,"_34307":484,"_23429":58687,"_5":16198,"_30870":58436,"_3543":58688},[],"`equals`, for exact equality;",{"_4098":569,"_34307":484,"_23429":58690,"_5":16198,"_30870":58436,"_3543":58691},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_4098":570,"_34307":484,"_23429":58693,"_5":16198,"_30870":58436,"_3543":58694},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_4098":571,"_34307":484,"_23429":58696,"_5":16198,"_30870":58436,"_3543":58697},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_4098":572,"_34307":484,"_23429":58699,"_5":16198,"_30870":58440,"_3543":58700},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_4098":573,"_34307":484,"_23429":58702,"_5":16198,"_30870":58440,"_3543":58703},[],"The available modes are:",{"_4098":574,"_34307":484,"_23429":58705,"_5":16198,"_30870":58440,"_3543":58706},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_4098":575,"_34307":484,"_23429":58708,"_5":16198,"_30870":58440,"_3543":58709},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_4098":576,"_34307":484,"_23429":58711,"_5":16198,"_30870":58440,"_3543":58712},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_4098":577,"_34307":484,"_23429":58714,"_5":16198,"_30870":58440,"_3543":58715},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_4098":578,"_34307":484,"_23429":58717,"_5":16198,"_30870":58440,"_3543":58718},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_4098":579,"_34307":484,"_23429":58720,"_5":16198,"_30870":58440,"_3543":58721},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_4098":580,"_34307":484,"_23429":58723,"_5":16198,"_30870":58444,"_3543":58724},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_4098":581,"_34307":484,"_23429":58726,"_5":16198,"_30870":58444,"_3543":58727},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_4098":582,"_34307":484,"_23429":58729,"_5":16198,"_30870":58444,"_3543":58730},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_4098":583,"_34307":484,"_23429":58732,"_5":16198,"_30870":58444,"_3543":58733},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_4098":584,"_34307":484,"_23429":58735,"_5":16198,"_30870":58452,"_3543":58736},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_4098":585,"_34307":484,"_23429":58738,"_5":16198,"_30870":58452,"_3543":58739},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_4098":586,"_34307":484,"_23429":58741,"_5":16198,"_30870":58456,"_3543":58742},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_4098":587,"_34307":484,"_23429":58744,"_5":16198,"_30870":58456,"_3543":58745},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_4098":588,"_34307":484,"_23429":58747,"_5":16198,"_30870":58460,"_3543":58748},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_4098":589,"_34307":484,"_23429":58750,"_5":16198,"_30870":58460,"_3543":58751},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_4098":590,"_34307":484,"_23429":58753,"_5":16198,"_30870":58460,"_3543":58754},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_4098":591,"_34307":484,"_23429":58756,"_5":16198,"_30870":58464,"_3543":58757},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_4098":592,"_34307":484,"_23429":58759,"_5":16198,"_30870":58464,"_3543":58760},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_4098":593,"_34307":484,"_23429":58762,"_5":16198,"_30870":58464,"_3543":58763},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_4098":594,"_34307":484,"_23429":58765,"_5":16198,"_30870":58464,"_3543":58766},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_4098":595,"_34307":484,"_23429":58768,"_5":16198,"_30870":58464,"_3543":58769},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_4098":596,"_34307":484,"_23429":58771,"_5":16198,"_30870":58464,"_3543":58772},[],"Note that:",{"_4098":597,"_34307":484,"_23429":58774,"_5":16198,"_30870":58464,"_3543":58775},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_4098":598,"_34307":484,"_23429":58777,"_5":16198,"_30870":58464,"_3543":58778},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_4098":599,"_34307":484,"_23429":58780,"_5":16198,"_30870":58464,"_3543":58781},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_4098":600,"_34307":484,"_23429":58783,"_5":16198,"_30870":58468,"_3543":58784},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_4098":601,"_34307":484,"_23429":58786,"_5":16198,"_30870":58468,"_3543":58787},[],"full and read-only access to certificates and authorities;",{"_4098":602,"_34307":484,"_23429":58789,"_5":16198,"_30870":58468,"_3543":58790},[],"full and read-only access to the KMS;",{"_4098":603,"_34307":484,"_23429":58792,"_5":16198,"_30870":58468,"_3543":58793},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_4098":604,"_34307":484,"_23429":58795,"_5":16198,"_30870":58468,"_3543":58796},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_4098":605,"_34307":484,"_23429":58798,"_5":16198,"_30870":58468,"_3543":58799},[],"console access;",{"_4098":606,"_34307":484,"_23429":58801,"_5":16198,"_30870":58468,"_3543":58802},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_4098":607,"_34307":484,"_23429":58804,"_5":16198,"_30870":58468,"_3543":58805},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_4098":608,"_34307":484,"_23429":58807,"_5":16198,"_30870":58468,"_3543":58808},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_4098":609,"_34307":484,"_23429":58810,"_5":16198,"_30870":58472,"_3543":58811},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_4098":610,"_34307":484,"_23429":58813,"_5":16198,"_30870":58472,"_3543":58814},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_4098":611,"_34307":484,"_23429":58816,"_5":16198,"_30870":58472,"_3543":58817},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_4098":612,"_34307":484,"_23429":58819,"_5":16198,"_30870":58475,"_3543":58820},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_4098":613,"_34307":484,"_23429":58822,"_5":16198,"_30870":58479,"_3543":58823},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_4098":614,"_34307":484,"_23429":58825,"_5":16198,"_30870":58479,"_3543":58826},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_4098":615,"_34307":484,"_23429":58828,"_5":16198,"_30870":58483,"_3543":58829},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_4098":616,"_34307":484,"_23429":58831,"_5":16198,"_30870":58487,"_3543":58832},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_4098":617,"_34307":484,"_23429":58834,"_5":16198,"_30870":58491,"_3543":58835},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_4098":618,"_34307":484,"_23429":58837,"_5":16198,"_30870":58495,"_3543":58838},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_4098":619,"_34307":484,"_23429":58840,"_5":16198,"_30870":58495,"_3543":58841},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_4098":620,"_34307":484,"_23429":58843,"_5":16198,"_30870":58499,"_3543":58844},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_4098":621,"_34307":484,"_23429":58846,"_5":16198,"_30870":58499,"_3543":58847},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_4098":622,"_34307":484,"_23429":58849,"_5":16198,"_30870":58499,"_3543":58850},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_4098":623,"_34307":484,"_23429":58852,"_5":16198,"_30870":58499,"_3543":58853},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_4098":624,"_34307":484,"_23429":58855,"_5":16198,"_30870":58499,"_3543":58856},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_4098":625,"_34307":484,"_23429":58858,"_5":16198,"_30870":58499,"_3543":58859},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_4098":626,"_34307":484,"_23429":58861,"_5":16198,"_30870":58499,"_3543":58862},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_4098":627,"_34307":484,"_23429":58864,"_5":16198,"_30870":58499,"_3543":58865},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_4098":628,"_34307":484,"_23429":58867,"_5":16198,"_30870":58503,"_3543":58868},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_4098":629,"_34307":484,"_23429":58870,"_5":16198,"_30870":58503,"_3543":58871},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_4098":630,"_34307":484,"_23429":58873,"_5":16198,"_30870":58503,"_3543":58874},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_4098":631,"_34307":484,"_23429":58876,"_5":16198,"_30870":58507,"_3543":58877},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_4098":632,"_34307":484,"_23429":58879,"_5":16198,"_30870":58507,"_3543":58880},[],"Use groups or stable roles for people and independent identities for automations.",{"_4098":633,"_34307":484,"_23429":58882,"_5":16198,"_30870":58507,"_3543":58883},[],"Keep at least two recovery administrators and test their access periodically.",{"_4098":634,"_34307":484,"_23429":58885,"_5":16198,"_30870":58507,"_3543":58886},[],"Review active principals, their matches and their grants after IdP changes.",{"_4098":635,"_34307":484,"_23429":58888,"_5":16198,"_30870":58507,"_3543":58889},[],"Search for wildcards in policies before upgrading Lamassu.",{"_4098":636,"_34307":484,"_23429":58891,"_5":16198,"_30870":58507,"_3543":58892},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_4098":637,"_34307":484,"_23429":58894,"_5":16198,"_30870":58507,"_3543":58895},[],"Always test one allowed and one denied operation for each role.",{"_4098":638,"_34307":484,"_23429":58897,"_5":16198,"_30870":58507,"_3543":58898},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_4098":639,"_34307":484,"_23429":58900,"_5":16198,"_30870":58515,"_3543":58901},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_4098":640,"_34307":484,"_23429":58903,"_5":16198,"_30870":58519,"_3543":58904},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_4098":641,"_34307":484,"_23429":58906,"_5":16198,"_30870":58519,"_3543":58907},[],"that an active principal of the correct type exists;",{"_4098":642,"_34307":484,"_23429":58909,"_5":16198,"_30870":58519,"_3543":58910},[],"that the claim paths and values match the real token exactly;",{"_4098":643,"_34307":484,"_23429":58912,"_5":16198,"_30870":58519,"_3543":58913},[],"that all of the principal's conditions hold;",{"_4098":644,"_34307":484,"_23429":58915,"_5":16198,"_30870":58519,"_3543":58916},[],"that the principal has the expected policy granted;",{"_4098":645,"_34307":484,"_23429":58918,"_5":16198,"_30870":58519,"_3543":58919},[],"that the policy includes the action and the requested resource type or route;",{"_4098":646,"_34307":484,"_23429":58921,"_5":16198,"_30870":58519,"_3543":58922},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_4098":647,"_34307":484,"_23429":58924,"_5":16198,"_30870":58519,"_3543":58925},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_4098":648,"_34307":484,"_23429":58927,"_5":16198,"_30870":58523,"_3543":58928},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_4098":649,"_34307":484,"_23429":58930,"_5":16198,"_30870":58527,"_3543":58931},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_4098":650,"_34307":484,"_23429":58933,"_5":16198,"_30870":58531,"_3543":58934},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_4098":651,"_34307":484,"_23429":58936,"_5":16198,"_30870":58531,"_3543":58937},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_4098":652,"_34307":652,"_5":16596,"_3543":58939,"_34738":58940,"_23429":58941,"_30870":652},"Alerts and subscriptions",[56936,58404,58405],[],{"_4098":653,"_34307":652,"_23429":58943,"_5":16198,"_30870":652,"_3543":58944},[],"Send PKI events to people and external systems.",{"_4098":654,"_34307":652,"_5":34735,"_23429":58946,"_30870":58947,"_3543":58948},[],"/docs/pr-preview/pr-58/platform/administration/alerts#how-it-works","How it works",{"_4098":655,"_34307":652,"_5":34735,"_23429":58950,"_30870":58951,"_3543":58952},[],"/docs/pr-preview/pr-58/platform/administration/alerts#available-channels","Available channels",{"_4098":656,"_34307":652,"_5":34735,"_23429":58954,"_30870":58955,"_3543":58956},[],"/docs/pr-preview/pr-58/platform/administration/alerts#create-a-subscription","Create a subscription",{"_4098":657,"_34307":652,"_5":34735,"_23429":58958,"_30870":58959,"_3543":58960},[],"/docs/pr-preview/pr-58/platform/administration/alerts#choose-the-event","Choose the event",{"_4098":658,"_34307":652,"_5":34735,"_23429":58962,"_30870":58963,"_3543":58964},[],"/docs/pr-preview/pr-58/platform/administration/alerts#configure-the-destination","Configure the destination",{"_4098":659,"_34307":652,"_5":34735,"_23429":58966,"_30870":58967,"_3543":58968},[],"/docs/pr-preview/pr-58/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_4098":660,"_34307":652,"_5":34735,"_23429":58970,"_30870":58971,"_3543":58972},[],"/docs/pr-preview/pr-58/platform/administration/alerts#review-and-activate","Review and activate",{"_4098":661,"_34307":652,"_5":34735,"_23429":58974,"_30870":58975,"_3543":58976},[],"/docs/pr-preview/pr-58/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_4098":662,"_34307":652,"_5":34735,"_23429":58978,"_30870":58979,"_3543":58980},[],"/docs/pr-preview/pr-58/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_4098":663,"_34307":652,"_5":34735,"_23429":58982,"_30870":58983,"_3543":58984},[],"/docs/pr-preview/pr-58/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_4098":664,"_34307":652,"_5":34735,"_23429":58986,"_30870":58987,"_3543":58988},[],"/docs/pr-preview/pr-58/platform/administration/alerts#event-families","Event families",{"_4098":665,"_34307":652,"_23429":58990,"_5":16198,"_30870":652,"_3543":58991},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_4098":666,"_34307":652,"_23429":58993,"_5":16198,"_30870":58947,"_3543":58994},[],"A service publishes a domain event.",{"_4098":667,"_34307":652,"_23429":58996,"_5":16198,"_30870":58947,"_3543":58997},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_4098":668,"_34307":652,"_23429":58999,"_5":16198,"_30870":58947,"_3543":59000},[],"Each subscription's filter decides whether it should be notified.",{"_4098":669,"_34307":652,"_23429":59002,"_5":16198,"_30870":58947,"_3543":59003},[],"Lamassu delivers the event to the configured channel.",{"_4098":670,"_34307":652,"_23429":59005,"_5":16198,"_30870":58947,"_3543":59006},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_4098":671,"_34307":652,"_23429":59008,"_5":16198,"_30870":58951,"_3543":59009},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_4098":672,"_34307":652,"_23429":59011,"_5":16198,"_30870":58951,"_3543":59012},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_4098":673,"_34307":652,"_23429":59014,"_5":16198,"_30870":58951,"_3543":59015},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_4098":674,"_34307":652,"_23429":59017,"_5":16198,"_30870":58951,"_3543":59018},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_4098":675,"_34307":652,"_23429":59020,"_5":16198,"_30870":58951,"_3543":59021},[],"`apikey_options` requires `header` and `key`.",{"_4098":676,"_34307":652,"_23429":59023,"_5":16198,"_30870":58951,"_3543":59024},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_4098":677,"_34307":652,"_23429":59026,"_5":16198,"_30870":58951,"_3543":59027},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_4098":678,"_34307":652,"_23429":59029,"_5":16198,"_30870":58951,"_3543":59030},[],"The alerts API reference documents the full `http_client` schema.",{"_4098":679,"_34307":652,"_23429":59032,"_5":16198,"_30870":58959,"_3543":59033},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_4098":680,"_34307":652,"_23429":59035,"_5":16198,"_30870":58963,"_3543":59036},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_4098":681,"_34307":652,"_23429":59038,"_5":16198,"_30870":58967,"_3543":59039},[],"Add a filter if you don't want to receive every instance of the event.",{"_4098":682,"_34307":652,"_23429":59041,"_5":16198,"_30870":58967,"_3543":59042},[],"**None** notifies all instances of the event.",{"_4098":683,"_34307":652,"_23429":59044,"_5":16198,"_30870":58967,"_3543":59045},[],"**JSON Path** evaluates one or more specific fields.",{"_4098":684,"_34307":652,"_23429":59047,"_5":16198,"_30870":58967,"_3543":59048},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_4098":685,"_34307":652,"_23429":59050,"_5":16198,"_30870":58967,"_3543":59051},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_4098":686,"_34307":652,"_23429":59053,"_5":16198,"_30870":58967,"_3543":59054},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_4098":687,"_34307":652,"_23429":59056,"_5":16198,"_30870":58967,"_3543":59057},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_4098":688,"_34307":652,"_23429":59059,"_5":16198,"_30870":58971,"_3543":59060},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_4098":689,"_34307":652,"_23429":59062,"_5":16198,"_30870":58975,"_3543":59063},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_4098":690,"_34307":652,"_23429":59065,"_5":16198,"_30870":58975,"_3543":59066},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_4098":691,"_34307":652,"_23429":59068,"_5":16198,"_30870":58975,"_3543":59069},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_4098":692,"_34307":652,"_23429":59071,"_5":16198,"_30870":58975,"_3543":59072},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_4098":693,"_34307":652,"_23429":59074,"_5":16198,"_30870":58975,"_3543":59075},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_4098":694,"_34307":652,"_23429":59077,"_5":16198,"_30870":58975,"_3543":59078},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_4098":695,"_34307":652,"_23429":59080,"_5":16198,"_30870":58975,"_3543":59081},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_4098":696,"_34307":652,"_23429":59083,"_5":16198,"_30870":58975,"_3543":59084},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_4098":697,"_34307":652,"_23429":59086,"_5":16198,"_30870":58979,"_3543":59087},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_4098":698,"_34307":652,"_23429":59089,"_5":16198,"_30870":58979,"_3543":59090},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_4098":699,"_34307":652,"_23429":59092,"_5":16198,"_30870":58979,"_3543":59093},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_4098":700,"_34307":652,"_23429":59095,"_5":16198,"_30870":58979,"_3543":59096},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_4098":701,"_34307":652,"_23429":59098,"_5":16198,"_30870":58979,"_3543":59099},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_4098":702,"_34307":652,"_23429":59101,"_5":16198,"_30870":58979,"_3543":59102},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_4098":703,"_34307":652,"_23429":59104,"_5":16198,"_30870":58979,"_3543":59105},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_4098":704,"_34307":652,"_23429":59107,"_5":16198,"_30870":58979,"_3543":59108},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_4098":705,"_34307":652,"_23429":59110,"_5":16198,"_30870":58983,"_3543":59111},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_4098":706,"_34307":652,"_23429":59113,"_5":16198,"_30870":58983,"_3543":59114},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_4098":707,"_34307":652,"_23429":59116,"_5":16198,"_30870":58987,"_3543":59117},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_4098":708,"_34307":652,"_23429":59119,"_5":16198,"_30870":58987,"_3543":59120},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_4098":709,"_34307":652,"_23429":59122,"_5":16198,"_30870":58987,"_3543":59123},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_4098":710,"_34307":652,"_23429":59125,"_5":16198,"_30870":58987,"_3543":59126},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_4098":711,"_34307":652,"_23429":59128,"_5":16198,"_30870":58987,"_3543":59129},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_4098":712,"_34307":652,"_23429":59131,"_5":16198,"_30870":58987,"_3543":59132},[],"**Validation:** `va.role.crl.create`.",{"_4098":713,"_34307":652,"_23429":59134,"_5":16198,"_30870":58987,"_3543":59135},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_4098":714,"_34307":652,"_23429":59137,"_5":16198,"_30870":58987,"_3543":59138},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_4098":715,"_34307":715,"_5":16596,"_3543":59140,"_34738":59141,"_23429":59142,"_30870":715},"Audit logs",[56936,58404,58405],[],{"_4098":716,"_34307":715,"_23429":59144,"_5":16198,"_30870":715,"_3543":59145},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_4098":717,"_34307":715,"_5":34735,"_23429":59147,"_30870":59148,"_3543":59149},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_4098":718,"_34307":715,"_5":34735,"_23429":59151,"_30870":59152,"_3543":59153},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#coverage","Coverage",{"_4098":719,"_34307":715,"_5":34735,"_23429":59155,"_30870":59156,"_3543":59157},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_4098":720,"_34307":715,"_5":34735,"_23429":59159,"_30870":59160,"_3543":59161},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_4098":721,"_34307":715,"_5":34735,"_23429":59163,"_30870":59164,"_3543":59165},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_4098":722,"_34307":715,"_5":34735,"_23429":59167,"_30870":59168,"_3543":59169},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_4098":723,"_34307":715,"_5":34735,"_23429":59171,"_30870":59172,"_3543":59173},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_4098":724,"_34307":715,"_5":34735,"_23429":59175,"_30870":59176,"_3543":59177},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_4098":725,"_34307":715,"_5":34735,"_23429":59179,"_30870":59180,"_3543":59181},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_4098":726,"_34307":715,"_5":34735,"_23429":59183,"_30870":59184,"_3543":59185},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_4098":727,"_34307":715,"_5":34735,"_23429":59187,"_30870":59188,"_3543":59189},[],"/docs/pr-preview/pr-58/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_4098":728,"_34307":715,"_23429":59191,"_5":16198,"_30870":715,"_3543":59192},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_4098":729,"_34307":715,"_23429":59194,"_5":16198,"_30870":59148,"_3543":59195},[],"The audit body includes:",{"_4098":730,"_34307":715,"_23429":59197,"_5":16198,"_30870":59148,"_3543":59198},[],"input: data received by the operation;",{"_4098":731,"_34307":715,"_23429":59200,"_5":16198,"_30870":59148,"_3543":59201},[],"has\\_error: whether the service returned an error;",{"_4098":732,"_34307":715,"_23429":59203,"_5":16198,"_30870":59148,"_3543":59204},[],"output: produced result or error message;",{"_4098":733,"_34307":715,"_23429":59206,"_5":16198,"_30870":59148,"_3543":59207},[],"principals: identifiers of the principals that matched the request.",{"_4098":734,"_34307":715,"_23429":59209,"_5":16198,"_30870":59148,"_3543":59210},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_4098":735,"_34307":715,"_23429":59212,"_5":16198,"_30870":59148,"_3543":59213},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_4098":736,"_34307":715,"_23429":59215,"_5":16198,"_30870":59152,"_3543":59216},[],"The backend applies auditing to mutations of:",{"_4098":737,"_34307":715,"_23429":59218,"_5":16198,"_30870":59152,"_3543":59219},[],"authorities, certificates and issuance profiles;",{"_4098":738,"_34307":715,"_23429":59221,"_5":16198,"_30870":59152,"_3543":59222},[],"keys and KMS engines;",{"_4098":739,"_34307":715,"_23429":59224,"_5":16198,"_30870":59152,"_3543":59225},[],"devices and identities;",{"_4098":740,"_34307":715,"_23429":59227,"_5":16198,"_30870":59152,"_3543":59228},[],"DMSs and enrollment operations;",{"_4098":741,"_34307":715,"_23429":59230,"_5":16198,"_30870":59152,"_3543":59231},[],"validation functions and CRL;",{"_4098":742,"_34307":715,"_23429":59233,"_5":16198,"_30870":59152,"_3543":59234},[],"principals, policies and authorization grants.",{"_4098":743,"_34307":715,"_23429":59236,"_5":16198,"_30870":59152,"_3543":59237},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_4098":744,"_34307":715,"_23429":59239,"_5":16198,"_30870":59156,"_3543":59240},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_4098":745,"_34307":715,"_23429":59242,"_5":16198,"_30870":59156,"_3543":59243},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_4098":746,"_34307":715,"_23429":59245,"_5":16198,"_30870":59156,"_3543":59246},[],"Design the consumer to:",{"_4098":747,"_34307":715,"_23429":59248,"_5":16198,"_30870":59156,"_3543":59249},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_4098":748,"_34307":715,"_23429":59251,"_5":16198,"_30870":59156,"_3543":59252},[],"keep the complete CloudEvent unmodified;",{"_4098":749,"_34307":715,"_23429":59254,"_5":16198,"_30870":59156,"_3543":59255},[],"record the ingestion time and detect duplicates by ID;",{"_4098":750,"_34307":715,"_23429":59257,"_5":16198,"_30870":59156,"_3543":59258},[],"encrypt in transit and at rest;",{"_4098":751,"_34307":715,"_23429":59260,"_5":16198,"_30870":59156,"_3543":59261},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_4098":752,"_34307":715,"_23429":59263,"_5":16198,"_30870":59156,"_3543":59264},[],"apply an explicit retention and legal hold policy;",{"_4098":753,"_34307":715,"_23429":59266,"_5":16198,"_30870":59156,"_3543":59267},[],"alert if it stops consuming or the pending queue grows.",{"_4098":754,"_34307":715,"_23429":59269,"_5":16198,"_30870":59160,"_3543":59270},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_4098":755,"_34307":715,"_23429":59272,"_5":16198,"_30870":59160,"_3543":59273},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_4098":756,"_34307":715,"_23429":59275,"_5":16198,"_30870":59168,"_3543":59276},[],"Start from the reported time and normalize every source to UTC.",{"_4098":757,"_34307":715,"_23429":59278,"_5":16198,"_30870":59172,"_3543":59279},[],"Filter by event type, service source and resource identifier.",{"_4098":758,"_34307":715,"_23429":59281,"_5":16198,"_30870":59176,"_3543":59282},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_4098":759,"_34307":715,"_23429":59284,"_5":16198,"_30870":59180,"_3543":59285},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_4098":760,"_34307":715,"_23429":59287,"_5":16198,"_30870":59184,"_3543":59288},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_4098":761,"_34307":715,"_23429":59290,"_5":16198,"_30870":59188,"_3543":59291},[],"Generate a controlled mutation in a test environment and check that:",{"_4098":762,"_34307":715,"_23429":59293,"_5":16198,"_30870":59188,"_3543":59294},[],"a successful audit event appears;",{"_4098":763,"_34307":715,"_23429":59296,"_5":16198,"_30870":59188,"_3543":59297},[],"the principal matches the identity used;",{"_4098":764,"_34307":715,"_23429":59299,"_5":16198,"_30870":59188,"_3543":59300},[],"the consumer persists it exactly once;",{"_4098":765,"_34307":715,"_23429":59302,"_5":16198,"_30870":59188,"_3543":59303},[],"it can be retrieved by resource, actor and period;",{"_4098":766,"_34307":715,"_23429":59305,"_5":16198,"_30870":59188,"_3543":59306},[],"a consumer outage raises an alert.",{"_4098":767,"_34307":715,"_23429":59308,"_5":16198,"_30870":59188,"_3543":59309},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_4098":768,"_34307":768,"_5":16596,"_3543":59311,"_34738":59312,"_23429":59313,"_30870":768},"Platform architecture",[56936,58404],[],{"_4098":769,"_34307":768,"_23429":59315,"_5":16198,"_30870":768,"_3543":59316},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_4098":770,"_34307":768,"_5":34735,"_23429":59318,"_30870":59319,"_3543":59320},[],"/docs/pr-preview/pr-58/platform/concepts/architecture#control-plane","Control plane",{"_4098":771,"_34307":768,"_5":34735,"_23429":59322,"_30870":59323,"_3543":59324},[],"/docs/pr-preview/pr-58/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_4098":772,"_34307":768,"_5":34735,"_23429":59326,"_30870":59327,"_3543":59328},[],"/docs/pr-preview/pr-58/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_4098":773,"_34307":768,"_5":34735,"_23429":59330,"_30870":59331,"_3543":59332},[],"/docs/pr-preview/pr-58/platform/concepts/architecture#status-and-validation","Status and validation",{"_4098":774,"_34307":768,"_5":34735,"_23429":59334,"_30870":59335,"_3543":59336},[],"/docs/pr-preview/pr-58/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_4098":775,"_34307":768,"_23429":59338,"_5":16198,"_30870":768,"_3543":59339},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_4098":776,"_34307":768,"_23429":59341,"_5":16198,"_30870":768,"_3543":59342},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_4098":777,"_34307":768,"_23429":59344,"_5":16198,"_30870":59319,"_3543":59345},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_4098":778,"_34307":768,"_23429":59347,"_5":16198,"_30870":59323,"_3543":59348},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_4098":779,"_34307":768,"_23429":59350,"_5":16198,"_30870":59327,"_3543":59351},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_4098":780,"_34307":768,"_23429":59353,"_5":16198,"_30870":59331,"_3543":59354},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_4098":781,"_34307":768,"_23429":59356,"_5":16198,"_30870":59335,"_3543":59357},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_4098":782,"_34307":782,"_5":16596,"_3543":59359,"_34738":59360,"_23429":59361,"_30870":782},"How Lamassu works",[56936,58404],[],{"_4098":783,"_34307":782,"_23429":59363,"_5":16198,"_30870":782,"_3543":59364},[],"The mental model of trust, keys, certificates and devices.",{"_4098":784,"_34307":782,"_5":34735,"_23429":59366,"_30870":59367,"_3543":59368},[],"/docs/pr-preview/pr-58/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_4098":785,"_34307":782,"_5":34735,"_23429":59370,"_30870":59371,"_3543":59372},[],"/docs/pr-preview/pr-58/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_4098":786,"_34307":782,"_23429":59374,"_5":16198,"_30870":782,"_3543":59375},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_4098":787,"_34307":782,"_23429":59377,"_5":16198,"_30870":59367,"_3543":59378},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_4098":788,"_34307":782,"_23429":59380,"_5":16198,"_30870":59367,"_3543":59381},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_4098":789,"_34307":782,"_23429":59383,"_5":16198,"_30870":59367,"_3543":59384},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_4098":790,"_34307":782,"_23429":59386,"_5":16198,"_30870":59367,"_3543":59387},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_4098":791,"_34307":782,"_23429":59389,"_5":16198,"_30870":59367,"_3543":59390},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_4098":792,"_34307":782,"_23429":59392,"_5":16198,"_30870":59371,"_3543":59393},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_4098":793,"_34307":782,"_23429":59395,"_5":16198,"_30870":59371,"_3543":59396},[],"A DMS relates that CA to an enrollment policy.",{"_4098":794,"_34307":782,"_23429":59398,"_5":16198,"_30870":59371,"_3543":59399},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_4098":795,"_34307":782,"_23429":59401,"_5":16198,"_30870":59371,"_3543":59402},[],"Lamassu keeps the inventory, history and status of the identity.",{"_4098":796,"_34307":782,"_23429":59404,"_5":16198,"_30870":59371,"_3543":59405},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_4098":797,"_34307":782,"_23429":59407,"_5":16198,"_30870":59371,"_3543":59408},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_4098":798,"_34307":782,"_23429":59410,"_5":16198,"_30870":59371,"_3543":59411},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_4098":799,"_34307":799,"_5":16596,"_3543":59413,"_34738":59414,"_23429":59416,"_30870":799},"Devices and identities",[56936,58404,59415,59413],"IoT Fleets",[],{"_4098":800,"_34307":799,"_23429":59418,"_5":16198,"_30870":799,"_3543":59419},[],"Register, inspect and retire devices while checking their current identity and history.",{"_4098":801,"_34307":799,"_5":34735,"_23429":59421,"_30870":59422,"_3543":59423},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#device-states","Device states",{"_4098":802,"_34307":799,"_5":34735,"_23429":59425,"_30870":59426,"_3543":59427},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_4098":803,"_34307":799,"_5":34735,"_23429":59429,"_30870":59430,"_3543":59431},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_4098":804,"_34307":799,"_5":34735,"_23429":59433,"_30870":59434,"_3543":59435},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#create-the-device","Create the device",{"_4098":805,"_34307":799,"_5":34735,"_23429":59437,"_30870":59438,"_3543":59439},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_4098":806,"_34307":799,"_5":34735,"_23429":59441,"_30870":59442,"_3543":59443},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_4098":807,"_34307":799,"_5":34735,"_23429":59445,"_30870":59446,"_3543":59447},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_4098":808,"_34307":799,"_5":34735,"_23429":59449,"_30870":59450,"_3543":59451},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_4098":809,"_34307":799,"_5":34735,"_23429":59453,"_30870":59454,"_3543":59455},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_4098":810,"_34307":799,"_5":34735,"_23429":59457,"_30870":59458,"_3543":59459},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_4098":811,"_34307":799,"_5":34735,"_23429":59461,"_30870":59462,"_3543":59463},[],"/docs/pr-preview/pr-58/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_4098":812,"_34307":799,"_23429":59465,"_5":16198,"_30870":799,"_3543":59466},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_4098":813,"_34307":799,"_23429":59468,"_5":16198,"_30870":799,"_3543":59469},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_4098":814,"_34307":799,"_23429":59471,"_5":16198,"_30870":59422,"_3543":59472},[],"Operational view",{"_4098":815,"_34307":799,"_23429":59474,"_5":16198,"_30870":59422,"_3543":59475},[],"Meaning",{"_4098":816,"_34307":799,"_23429":59477,"_5":16198,"_30870":59422,"_3543":59478},[],"**No Identity**",{"_4098":817,"_34307":799,"_23429":59480,"_5":16198,"_30870":59422,"_3543":59481},[],"A record exists without an associated identity.",{"_4098":818,"_34307":799,"_23429":59483,"_5":16198,"_30870":59422,"_3543":59484},[],"**Active**",{"_4098":819,"_34307":799,"_23429":59486,"_5":16198,"_30870":59422,"_3543":59487},[],"The slot is active; also check certificate dates, status and usages.",{"_4098":820,"_34307":799,"_23429":59489,"_5":16198,"_30870":59422,"_3543":59490},[],"**Renewal Pending**",{"_4098":821,"_34307":799,"_23429":59492,"_5":16198,"_30870":59422,"_3543":59493},[],"The identity is in the operational renewal window.",{"_4098":822,"_34307":799,"_23429":59495,"_5":16198,"_30870":59422,"_3543":59496},[],"**Expiring Soon**",{"_4098":823,"_34307":799,"_23429":59498,"_5":16198,"_30870":59422,"_3543":59499},[],"Expiration is approaching according to configured thresholds.",{"_4098":824,"_34307":799,"_23429":59501,"_5":16198,"_30870":59422,"_3543":59502},[],"**Expired**",{"_4098":825,"_34307":799,"_23429":59504,"_5":16198,"_30870":59422,"_3543":59505},[],"The identity has expired.",{"_4098":826,"_34307":799,"_23429":59507,"_5":16198,"_30870":59422,"_3543":59508},[],"**Revoked**",{"_4098":827,"_34307":799,"_23429":59510,"_5":16198,"_30870":59422,"_3543":59511},[],"The identity is marked revoked.",{"_4098":828,"_34307":799,"_23429":59513,"_5":16198,"_30870":59422,"_3543":59514},[],"**Decommissioned**",{"_4098":829,"_34307":799,"_23429":59516,"_5":16198,"_30870":59422,"_3543":59517},[],"The record is retired and ordinary updates do not restore operation.",{"_4098":830,"_34307":799,"_23429":59519,"_5":16198,"_30870":59422,"_3543":59520},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_4098":831,"_34307":799,"_23429":59522,"_5":16198,"_30870":59426,"_3543":59523},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_4098":832,"_34307":799,"_23429":59525,"_5":16198,"_30870":59426,"_3543":59526},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_4098":833,"_34307":799,"_23429":59528,"_5":16198,"_30870":59426,"_3543":59529},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_4098":834,"_34307":799,"_23429":59531,"_5":16198,"_30870":59426,"_3543":59532},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_4098":835,"_34307":799,"_23429":59534,"_5":16198,"_30870":59430,"_3543":59535},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_4098":836,"_34307":799,"_23429":59537,"_5":16198,"_30870":59434,"_3543":59538},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_4098":837,"_34307":799,"_23429":59540,"_5":16198,"_30870":59438,"_3543":59541},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_4098":838,"_34307":799,"_23429":59543,"_5":16198,"_30870":59442,"_3543":59544},[],"Add model, environment or location tags and an icon according to your inventory.",{"_4098":839,"_34307":799,"_23429":59546,"_5":16198,"_30870":59446,"_3543":59547},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_4098":840,"_34307":799,"_23429":59549,"_5":16198,"_30870":59446,"_3543":59550},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_4098":841,"_34307":799,"_23429":59552,"_5":16198,"_30870":59450,"_3543":59553},[],"From **No Identity**, use **Assign Identity**:",{"_4098":842,"_34307":799,"_23429":59555,"_5":16198,"_30870":59450,"_3543":59556},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_4098":843,"_34307":799,"_23429":59558,"_5":16198,"_30870":59450,"_3543":59559},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_4098":844,"_34307":799,"_23429":59561,"_5":16198,"_30870":59450,"_3543":59562},[],"Confirm and read the serial, active version and history again.",{"_4098":845,"_34307":799,"_23429":59564,"_5":16198,"_30870":59450,"_3543":59565},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_4098":846,"_34307":799,"_23429":59567,"_5":16198,"_30870":59450,"_3543":59568},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_4098":847,"_34307":799,"_23429":59570,"_5":16198,"_30870":59454,"_3543":59571},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_4098":848,"_34307":799,"_23429":59573,"_5":16198,"_30870":59454,"_3543":59574},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_4098":849,"_34307":799,"_23429":59576,"_5":16198,"_30870":59458,"_3543":59577},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_4098":850,"_34307":799,"_23429":59579,"_5":16198,"_30870":59458,"_3543":59580},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_4098":851,"_34307":799,"_23429":59582,"_5":16198,"_30870":59458,"_3543":59583},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_4098":852,"_34307":799,"_23429":59585,"_5":16198,"_30870":59458,"_3543":59586},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_4098":853,"_34307":799,"_23429":59588,"_5":16198,"_30870":59462,"_3543":59589},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_4098":854,"_34307":799,"_23429":59591,"_5":16198,"_30870":59462,"_3543":59592},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_4098":855,"_34307":855,"_5":16596,"_3543":59594,"_34738":59595,"_23429":59597,"_30870":855},"Bootstrap identity and authentication",[56936,58404,59415,59413,59596],"Enrollment with PKI",[],{"_4098":856,"_34307":855,"_23429":59599,"_5":16198,"_30870":855,"_3543":59600},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_4098":857,"_34307":855,"_5":34735,"_23429":59602,"_30870":59603,"_3543":59604},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_4098":858,"_34307":855,"_5":34735,"_23429":59606,"_30870":59607,"_3543":59608},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_4098":859,"_34307":855,"_5":34735,"_23429":59610,"_30870":59611,"_3543":59612},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_4098":860,"_34307":855,"_5":34735,"_23429":59614,"_30870":59615,"_3543":59616},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_4098":861,"_34307":855,"_5":34735,"_23429":59618,"_30870":59619,"_3543":59620},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_4098":862,"_34307":855,"_23429":59622,"_5":16198,"_30870":855,"_3543":59623},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_4098":863,"_34307":855,"_23429":59625,"_5":16198,"_30870":59603,"_3543":59626},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_4098":864,"_34307":855,"_23429":59628,"_5":16198,"_30870":59603,"_3543":59629},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_4098":865,"_34307":855,"_23429":59631,"_5":16198,"_30870":59607,"_3543":59632},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_4098":866,"_34307":855,"_23429":59634,"_5":16198,"_30870":59607,"_3543":59635},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_4098":867,"_34307":855,"_23429":59637,"_5":16198,"_30870":59607,"_3543":59638},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_4098":868,"_34307":855,"_23429":59640,"_5":16198,"_30870":59611,"_3543":59641},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_4098":869,"_34307":855,"_23429":59643,"_5":16198,"_30870":59611,"_3543":59644},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_4098":870,"_34307":855,"_23429":59646,"_5":16198,"_30870":59615,"_3543":59647},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_4098":871,"_34307":855,"_23429":59649,"_5":16198,"_30870":59615,"_3543":59650},[],"Example body:",{"_4098":872,"_34307":855,"_23429":59652,"_5":16198,"_30870":59615,"_3543":59653},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_4098":873,"_34307":855,"_23429":59655,"_5":16198,"_30870":59615,"_3543":59656},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_4098":874,"_34307":855,"_23429":59658,"_5":16198,"_30870":59615,"_3543":59659},[],"Continuation requires a successful HTTP response and JSON:",{"_4098":875,"_34307":855,"_23429":59661,"_5":16198,"_30870":59615,"_3543":59662},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_4098":876,"_34307":855,"_23429":59664,"_5":16198,"_30870":59619,"_3543":59665},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_4098":877,"_34307":855,"_23429":59667,"_5":16198,"_30870":59619,"_3543":59668},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_4098":878,"_34307":878,"_5":16596,"_3543":59670,"_34738":59671,"_23429":59672,"_30870":878},"Configure and operate the DMS",[56936,58404,59415,59413,59596],[],{"_4098":879,"_34307":878,"_23429":59674,"_5":16198,"_30870":878,"_3543":59675},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_4098":880,"_34307":878,"_5":34735,"_23429":59677,"_30870":59678,"_3543":56946},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#before-you-begin",{"_4098":881,"_34307":878,"_5":34735,"_23429":59680,"_30870":59681,"_3543":59682},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_4098":882,"_34307":878,"_5":34735,"_23429":59684,"_30870":59685,"_3543":59686},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_4098":883,"_34307":878,"_5":34735,"_23429":59688,"_30870":59689,"_3543":59690},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_4098":884,"_34307":878,"_5":34735,"_23429":59692,"_30870":59693,"_3543":59694},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_4098":885,"_34307":878,"_5":34735,"_23429":59696,"_30870":59697,"_3543":59698},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_4098":886,"_34307":878,"_5":34735,"_23429":59700,"_30870":59701,"_3543":59702},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_4098":887,"_34307":878,"_5":34735,"_23429":59704,"_30870":59705,"_3543":59706},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_4098":888,"_34307":878,"_5":34735,"_23429":59708,"_30870":59709,"_3543":59710},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_4098":889,"_34307":878,"_5":34735,"_23429":59712,"_30870":59713,"_3543":59714},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_4098":890,"_34307":878,"_5":34735,"_23429":59716,"_30870":59717,"_3543":59718},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_4098":891,"_34307":878,"_5":34735,"_23429":59720,"_30870":59721,"_3543":59722},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_4098":892,"_34307":878,"_5":34735,"_23429":59724,"_30870":59725,"_3543":59726},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_4098":893,"_34307":878,"_5":34735,"_23429":59728,"_30870":59729,"_3543":59730},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_4098":894,"_34307":878,"_5":34735,"_23429":59732,"_30870":59733,"_3543":59734},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_4098":895,"_34307":878,"_5":34735,"_23429":59736,"_30870":59737,"_3543":59738},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_4098":896,"_34307":878,"_5":34735,"_23429":59740,"_30870":59741,"_3543":59742},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_4098":897,"_34307":878,"_5":34735,"_23429":59744,"_30870":59745,"_3543":59746},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_4098":898,"_34307":878,"_23429":59748,"_5":16198,"_30870":878,"_3543":59749},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_4098":899,"_34307":878,"_23429":59751,"_5":16198,"_30870":59678,"_3543":59752},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_4098":900,"_34307":878,"_23429":59754,"_5":16198,"_30870":59678,"_3543":59755},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_4098":901,"_34307":878,"_23429":59757,"_5":16198,"_30870":59685,"_3543":59758},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_4098":902,"_34307":878,"_23429":59760,"_5":16198,"_30870":59689,"_3543":59761},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_4098":903,"_34307":878,"_23429":59763,"_5":16198,"_30870":59693,"_3543":59764},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_4098":904,"_34307":878,"_23429":59766,"_5":16198,"_30870":59697,"_3543":59767},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_4098":905,"_34307":878,"_23429":59769,"_5":16198,"_30870":59701,"_3543":59770},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_4098":906,"_34307":878,"_23429":59772,"_5":16198,"_30870":59709,"_3543":59773},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_4098":907,"_34307":878,"_23429":59775,"_5":16198,"_30870":59709,"_3543":59776},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_4098":908,"_34307":878,"_23429":59778,"_5":16198,"_30870":59713,"_3543":59779},[],"`settings.enrollment_settings` field",{"_4098":909,"_34307":878,"_23429":59781,"_5":16198,"_30870":59713,"_3543":59782},[],"Decision",{"_4098":910,"_34307":878,"_23429":59784,"_5":16198,"_30870":59713,"_3543":59785},[],"`protocol`",{"_4098":911,"_34307":878,"_23429":59787,"_5":16198,"_30870":59713,"_3543":59788},[],"`EST_RFC7030` for these operations.",{"_4098":912,"_34307":878,"_23429":59790,"_5":16198,"_30870":59713,"_3543":59791},[],"`enrollment_ca`",{"_4098":913,"_34307":878,"_23429":59793,"_5":16198,"_30870":59713,"_3543":59794},[],"ID of the signing CA.",{"_4098":914,"_34307":878,"_23429":59796,"_5":16198,"_30870":59713,"_3543":59797},[],"`verify_csr_signature`",{"_4098":915,"_34307":878,"_23429":59799,"_5":16198,"_30870":59713,"_3543":59800},[],"Keep `true` to verify CSR key possession.",{"_4098":916,"_34307":878,"_23429":59802,"_5":16198,"_30870":59713,"_3543":59803},[],"`enable_replaceable_enrollment`",{"_4098":917,"_34307":878,"_23429":59805,"_5":16198,"_30870":59713,"_3543":59806},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_4098":918,"_34307":878,"_23429":59808,"_5":16198,"_30870":59713,"_3543":59809},[],"`est_rfc7030_settings.auth_mode`",{"_4098":919,"_34307":878,"_23429":59811,"_5":16198,"_30870":59713,"_3543":59812},[],"One of the four authentication modes.",{"_4098":920,"_34307":878,"_23429":59814,"_5":16198,"_30870":59713,"_3543":59815},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_4098":921,"_34307":878,"_23429":59817,"_5":16198,"_30870":59717,"_3543":59818},[],"The blocks are independent:",{"_4098":922,"_34307":878,"_23429":59820,"_5":16198,"_30870":59717,"_3543":59821},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_4098":923,"_34307":878,"_23429":59823,"_5":16198,"_30870":59717,"_3543":59824},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_4098":924,"_34307":878,"_23429":59826,"_5":16198,"_30870":59717,"_3543":59827},[],"`auth_mode`",{"_4098":925,"_34307":878,"_23429":59829,"_5":16198,"_30870":59717,"_3543":59830},[],"Control applied in the configured operation",{"_4098":926,"_34307":878,"_23429":59832,"_5":16198,"_30870":59717,"_3543":59833},[],"`CLIENT_CERTIFICATE`",{"_4098":927,"_34307":878,"_23429":59835,"_5":16198,"_30870":59717,"_3543":59836},[],"Presented certificate validation.",{"_4098":928,"_34307":878,"_23429":59838,"_5":16198,"_30870":59717,"_3543":59839},[],"`EXTERNAL_WEBHOOK`",{"_4098":929,"_34307":878,"_23429":59841,"_5":16198,"_30870":59717,"_3543":59842},[],"Configured webhook authorization.",{"_4098":930,"_34307":878,"_23429":59844,"_5":16198,"_30870":59717,"_3543":59845},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_4098":931,"_34307":878,"_23429":59847,"_5":16198,"_30870":59717,"_3543":59848},[],"Certificate validation followed by webhook approval.",{"_4098":932,"_34307":878,"_23429":59850,"_5":16198,"_30870":59717,"_3543":59851},[],"`NO_AUTH`",{"_4098":933,"_34307":878,"_23429":59853,"_5":16198,"_30870":59717,"_3543":59854},[],"No DMS requester authentication.",{"_4098":934,"_34307":878,"_23429":59856,"_5":16198,"_30870":59717,"_3543":59857},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_4098":935,"_34307":878,"_23429":59859,"_5":16198,"_30870":59717,"_3543":59860},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_4098":936,"_34307":878,"_23429":59862,"_5":16198,"_30870":59717,"_3543":59863},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_4098":937,"_34307":878,"_23429":59865,"_5":16198,"_30870":59717,"_3543":59866},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_4098":938,"_34307":878,"_23429":59868,"_5":16198,"_30870":59721,"_3543":59869},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_4098":939,"_34307":878,"_23429":59871,"_5":16198,"_30870":59721,"_3543":59872},[],"`external_webhook_settings` field",{"_4098":940,"_34307":878,"_23429":59874,"_5":16198,"_30870":59721,"_3543":59782},[],{"_4098":941,"_34307":878,"_23429":59876,"_5":16198,"_30870":59721,"_3543":59877},[],"`url`",{"_4098":942,"_34307":878,"_23429":59879,"_5":16198,"_30870":59721,"_3543":59880},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_4098":943,"_34307":878,"_23429":59882,"_5":16198,"_30870":59721,"_3543":59883},[],"`method`",{"_4098":944,"_34307":878,"_23429":59885,"_5":16198,"_30870":59721,"_3543":59886},[],"`POST` or `PUT`; `POST` by default.",{"_4098":945,"_34307":878,"_23429":59888,"_5":16198,"_30870":59721,"_3543":59889},[],"`name`",{"_4098":946,"_34307":878,"_23429":59891,"_5":16198,"_30870":59721,"_3543":59892},[],"Label used in service logs.",{"_4098":947,"_34307":878,"_23429":59894,"_5":16198,"_30870":59721,"_3543":59895},[],"`config.auth_mode`",{"_4098":948,"_34307":878,"_23429":59897,"_5":16198,"_30870":59721,"_3543":59898},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_4098":949,"_34307":878,"_23429":59900,"_5":16198,"_30870":59721,"_3543":59901},[],"`config.log_level`",{"_4098":950,"_34307":878,"_23429":59903,"_5":16198,"_30870":59721,"_3543":59904},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_4098":951,"_34307":878,"_23429":59906,"_5":16198,"_30870":59721,"_3543":59907},[],"`config.apikey_options`",{"_4098":952,"_34307":878,"_23429":59909,"_5":16198,"_30870":59721,"_3543":59910},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_4098":953,"_34307":878,"_23429":59912,"_5":16198,"_30870":59721,"_3543":59913},[],"`config.jwt_options`",{"_4098":954,"_34307":878,"_23429":59915,"_5":16198,"_30870":59721,"_3543":59916},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_4098":955,"_34307":878,"_23429":59918,"_5":16198,"_30870":59721,"_3543":59919},[],"`config.mtls_options`",{"_4098":956,"_34307":878,"_23429":59921,"_5":16198,"_30870":59721,"_3543":59922},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_4098":957,"_34307":878,"_23429":59924,"_5":16198,"_30870":59721,"_3543":59925},[],"`config.insecure_skip_verify`",{"_4098":958,"_34307":878,"_23429":59927,"_5":16198,"_30870":59721,"_3543":59928},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_4098":959,"_34307":878,"_23429":59930,"_5":16198,"_30870":59721,"_3543":59931},[],"`config.call_timeout`",{"_4098":960,"_34307":878,"_23429":59933,"_5":16198,"_30870":59721,"_3543":59934},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_4098":961,"_34307":878,"_23429":59936,"_5":16198,"_30870":59721,"_3543":59937},[],"Rules for that configuration:",{"_4098":962,"_34307":878,"_23429":59939,"_5":16198,"_30870":59721,"_3543":59940},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_4098":963,"_34307":878,"_23429":59942,"_5":16198,"_30870":59721,"_3543":59943},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_4098":964,"_34307":878,"_23429":59945,"_5":16198,"_30870":59721,"_3543":59946},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_4098":965,"_34307":878,"_23429":59948,"_5":16198,"_30870":59721,"_3543":59949},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_4098":966,"_34307":878,"_23429":59951,"_5":16198,"_30870":59721,"_3543":59952},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_4098":967,"_34307":878,"_23429":59954,"_5":16198,"_30870":59721,"_3543":59955},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_4098":968,"_34307":878,"_23429":59957,"_5":16198,"_30870":59721,"_3543":59958},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_4098":969,"_34307":878,"_23429":59960,"_5":16198,"_30870":59721,"_3543":59961},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_4098":970,"_34307":878,"_23429":59963,"_5":16198,"_30870":59721,"_3543":59964},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_4098":971,"_34307":878,"_23429":59966,"_5":16198,"_30870":59725,"_3543":59967},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_4098":972,"_34307":878,"_23429":59969,"_5":16198,"_30870":59729,"_3543":59970},[],"`settings.reenrollment_settings` field",{"_4098":973,"_34307":878,"_23429":59972,"_5":16198,"_30870":59729,"_3543":57326},[],{"_4098":974,"_34307":878,"_23429":59974,"_5":16198,"_30870":59729,"_3543":59975},[],"`reenrollment_delta`",{"_4098":975,"_34307":878,"_23429":59977,"_5":16198,"_30870":59729,"_3543":59978},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_4098":976,"_34307":878,"_23429":59980,"_5":16198,"_30870":59729,"_3543":59981},[],"`preventive_delta`",{"_4098":977,"_34307":878,"_23429":59983,"_5":16198,"_30870":59729,"_3543":59984},[],"Preventive operational monitoring threshold.",{"_4098":978,"_34307":878,"_23429":59986,"_5":16198,"_30870":59729,"_3543":59987},[],"`critical_delta`",{"_4098":979,"_34307":878,"_23429":59989,"_5":16198,"_30870":59729,"_3543":59990},[],"Critical operational monitoring threshold.",{"_4098":980,"_34307":878,"_23429":59992,"_5":16198,"_30870":59729,"_3543":59993},[],"`enable_expired_renewal`",{"_4098":981,"_34307":878,"_23429":59995,"_5":16198,"_30870":59729,"_3543":59996},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_4098":982,"_34307":878,"_23429":59998,"_5":16198,"_30870":59729,"_3543":59999},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_4098":983,"_34307":878,"_23429":60001,"_5":16198,"_30870":59729,"_3543":60002},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_4098":984,"_34307":878,"_23429":60004,"_5":16198,"_30870":59729,"_3543":60005},[],"`revoke_on_reenrollment`",{"_4098":985,"_34307":878,"_23429":60007,"_5":16198,"_30870":59729,"_3543":60008},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_4098":986,"_34307":878,"_23429":60010,"_5":16198,"_30870":59729,"_3543":60011},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_4098":987,"_34307":878,"_23429":60013,"_5":16198,"_30870":59733,"_3543":60014},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_4098":988,"_34307":878,"_23429":60016,"_5":16198,"_30870":59737,"_3543":57320},[],{"_4098":989,"_34307":878,"_23429":60018,"_5":16198,"_30870":59737,"_3543":60019},[],"Published material",{"_4098":990,"_34307":878,"_23429":60021,"_5":16198,"_30870":59737,"_3543":60022},[],"**Include Lamassu System CA**",{"_4098":991,"_34307":878,"_23429":60024,"_5":16198,"_30870":59737,"_3543":60025},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_4098":992,"_34307":878,"_23429":60027,"_5":16198,"_30870":59737,"_3543":60028},[],"**Include Enrollment CA**",{"_4098":993,"_34307":878,"_23429":60030,"_5":16198,"_30870":59737,"_3543":60031},[],"Selected issuing CA certificate.",{"_4098":994,"_34307":878,"_23429":60033,"_5":16198,"_30870":59737,"_3543":60034},[],"**Managed CAs**",{"_4098":995,"_34307":878,"_23429":60036,"_5":16198,"_30870":59737,"_3543":60037},[],"Explicitly selected CA certificates.",{"_4098":996,"_34307":878,"_23429":60039,"_5":16198,"_30870":59737,"_3543":60040},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_4098":997,"_34307":878,"_23429":60042,"_5":16198,"_30870":59741,"_3543":60043},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_4098":998,"_34307":878,"_23429":60045,"_5":16198,"_30870":59741,"_3543":60046},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_4098":999,"_34307":878,"_23429":60048,"_5":16198,"_30870":59741,"_3543":60049},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_4098":1000,"_34307":878,"_23429":60051,"_5":16198,"_30870":59745,"_3543":60052},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_4098":1001,"_34307":1001,"_5":16596,"_3543":60054,"_34738":60055,"_23429":60056,"_30870":1001},"Integrate the EST client",[56936,58404,59415,59413,59596],[],{"_4098":1002,"_34307":1001,"_23429":60058,"_5":16198,"_30870":1001,"_3543":60059},[],"Prepare trust, send a CSR and check the identity you receive.",{"_4098":1003,"_34307":1001,"_5":34735,"_23429":60061,"_30870":60062,"_3543":56946},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_4098":1004,"_34307":1001,"_5":34735,"_23429":60064,"_30870":60065,"_3543":60066},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_4098":1005,"_34307":1001,"_5":34735,"_23429":60068,"_30870":60069,"_3543":60070},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_4098":1006,"_34307":1001,"_5":34735,"_23429":60072,"_30870":60073,"_3543":60074},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_4098":1007,"_34307":1001,"_5":34735,"_23429":60076,"_30870":60077,"_3543":60078},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_4098":1008,"_34307":1001,"_5":34735,"_23429":60080,"_30870":60081,"_3543":60082},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_4098":1009,"_34307":1001,"_23429":60084,"_5":16198,"_30870":1001,"_3543":60085},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_4098":1010,"_34307":1001,"_23429":60087,"_5":16198,"_30870":60062,"_3543":60088},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_4098":1011,"_34307":1001,"_23429":60090,"_5":16198,"_30870":60062,"_3543":60091},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_4098":1012,"_34307":1001,"_23429":60093,"_5":16198,"_30870":60062,"_3543":60094},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_4098":1013,"_34307":1001,"_23429":60096,"_5":16198,"_30870":60065,"_3543":60097},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_4098":1014,"_34307":1001,"_23429":60099,"_5":16198,"_30870":60065,"_3543":60100},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_4098":1015,"_34307":1001,"_23429":60102,"_5":16198,"_30870":60069,"_3543":60103},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_4098":1016,"_34307":1001,"_23429":60105,"_5":16198,"_30870":60069,"_3543":60106},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_4098":1017,"_34307":1001,"_23429":60108,"_5":16198,"_30870":60073,"_3543":60109},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_4098":1018,"_34307":1001,"_23429":60111,"_5":16198,"_30870":60073,"_3543":60112},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_4098":1019,"_34307":1001,"_23429":60114,"_5":16198,"_30870":60077,"_3543":60115},[],"For a root that issues directly:",{"_4098":1020,"_34307":1001,"_23429":60117,"_5":16198,"_30870":60077,"_3543":60118},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_4098":1021,"_34307":1001,"_23429":60120,"_5":16198,"_30870":60077,"_3543":60121},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_4098":1022,"_34307":1001,"_23429":60123,"_5":16198,"_30870":60081,"_3543":60124},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_4098":1023,"_34307":1023,"_5":16596,"_3543":60126,"_34738":60127,"_23429":60128,"_30870":1023},"EST reference",[56936,58404,59415,59413,59596],[],{"_4098":1024,"_34307":1023,"_23429":60130,"_5":16198,"_30870":1023,"_3543":60131},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_4098":1025,"_34307":1023,"_5":34735,"_23429":60133,"_30870":60134,"_3543":60135},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_4098":1026,"_34307":1023,"_5":34735,"_23429":60137,"_30870":60138,"_3543":25464},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#cacerts",{"_4098":1027,"_34307":1023,"_5":34735,"_23429":60140,"_30870":60141,"_3543":29201},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_4098":1028,"_34307":1023,"_5":34735,"_23429":60143,"_30870":60144,"_3543":29208},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_4098":1029,"_34307":1023,"_5":34735,"_23429":60146,"_30870":60147,"_3543":28427},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_4098":1030,"_34307":1023,"_5":34735,"_23429":60149,"_30870":60150,"_3543":60151},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_4098":1031,"_34307":1023,"_5":34735,"_23429":60153,"_30870":60154,"_3543":60155},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_4098":1032,"_34307":1023,"_5":34735,"_23429":60157,"_30870":60158,"_3543":60159},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_4098":1033,"_34307":1023,"_23429":60161,"_5":16198,"_30870":1023,"_3543":60162},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_4098":1034,"_34307":1023,"_23429":60164,"_5":16198,"_30870":60134,"_3543":60165},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_4098":1035,"_34307":1023,"_23429":60167,"_5":16198,"_30870":60134,"_3543":60168},[],"Operation",{"_4098":1036,"_34307":1023,"_23429":60170,"_5":16198,"_30870":60134,"_3543":60171},[],"Method",{"_4098":1037,"_34307":1023,"_23429":60173,"_5":16198,"_30870":60134,"_3543":60174},[],"Authentication and condition",{"_4098":1038,"_34307":1023,"_23429":60176,"_5":16198,"_30870":60134,"_3543":60177},[],"`/cacerts`",{"_4098":1039,"_34307":1023,"_23429":60179,"_5":16198,"_30870":60134,"_3543":60180},[],"GET",{"_4098":1040,"_34307":1023,"_23429":60182,"_5":16198,"_30870":60134,"_3543":60183},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_4098":1041,"_34307":1023,"_23429":60185,"_5":16198,"_30870":60134,"_3543":60186},[],"`/simpleenroll`",{"_4098":1042,"_34307":1023,"_23429":60188,"_5":16198,"_30870":60134,"_3543":60189},[],"POST",{"_4098":1043,"_34307":1023,"_23429":60191,"_5":16198,"_30870":60134,"_3543":60192},[],"Initial authentication and DMS registration/replacement policy.",{"_4098":1044,"_34307":1023,"_23429":60194,"_5":16198,"_30870":60134,"_3543":60195},[],"`/simplereenroll`",{"_4098":1045,"_34307":1023,"_23429":60197,"_5":16198,"_30870":60134,"_3543":60189},[],{"_4098":1046,"_34307":1023,"_23429":60199,"_5":16198,"_30870":60134,"_3543":60200},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_4098":1047,"_34307":1023,"_23429":60202,"_5":16198,"_30870":60134,"_3543":60203},[],"`/serverkeygen`",{"_4098":1048,"_34307":1023,"_23429":60205,"_5":16198,"_30870":60134,"_3543":60189},[],{"_4098":1049,"_34307":1023,"_23429":60207,"_5":16198,"_30870":60134,"_3543":60208},[],"Initial authentication and admission; server generation enabled.",{"_4098":1050,"_34307":1023,"_23429":60210,"_5":16198,"_30870":60134,"_3543":60211},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_4098":1051,"_34307":1023,"_23429":60213,"_5":16198,"_30870":60138,"_3543":60214},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_4098":1052,"_34307":1023,"_23429":60216,"_5":16198,"_30870":60138,"_3543":60217},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_4098":1053,"_34307":1023,"_23429":60219,"_5":16198,"_30870":60141,"_3543":60220},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_4098":1054,"_34307":1023,"_23429":60222,"_5":16198,"_30870":60141,"_3543":60223},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_4098":1055,"_34307":1023,"_23429":60225,"_5":16198,"_30870":60144,"_3543":60226},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_4098":1056,"_34307":1023,"_23429":60228,"_5":16198,"_30870":60144,"_3543":60229},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_4098":1057,"_34307":1023,"_23429":60231,"_5":16198,"_30870":60147,"_3543":60232},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_4098":1058,"_34307":1023,"_23429":60234,"_5":16198,"_30870":60147,"_3543":60235},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_4098":1059,"_34307":1023,"_23429":60237,"_5":16198,"_30870":60150,"_3543":60238},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_4098":1060,"_34307":1023,"_23429":60240,"_5":16198,"_30870":60150,"_3543":60241},[],"Part",{"_4098":1061,"_34307":1023,"_23429":60243,"_5":16198,"_30870":60150,"_3543":60244},[],"Content after decoding its Base64",{"_4098":1062,"_34307":1023,"_23429":60246,"_5":16198,"_30870":60150,"_3543":60247},[],"`application/pkcs8`",{"_4098":1063,"_34307":1023,"_23429":60249,"_5":16198,"_30870":60150,"_3543":60250},[],"Unencrypted DER PKCS#8 private key.",{"_4098":1064,"_34307":1023,"_23429":60252,"_5":16198,"_30870":60150,"_3543":60253},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_4098":1065,"_34307":1023,"_23429":60255,"_5":16198,"_30870":60150,"_3543":60256},[],"DER PKCS#7 containing the issued certificate.",{"_4098":1066,"_34307":1023,"_23429":60258,"_5":16198,"_30870":60150,"_3543":60259},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_4098":1067,"_34307":1023,"_23429":60261,"_5":16198,"_30870":60154,"_3543":60262},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_4098":1068,"_34307":1023,"_23429":60264,"_5":16198,"_30870":60154,"_3543":60265},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_4098":1069,"_34307":1023,"_23429":60267,"_5":16198,"_30870":60154,"_3543":60268},[],"Convert and check the result:",{"_4098":1070,"_34307":1023,"_23429":60270,"_5":16198,"_30870":60154,"_3543":60271},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_4098":1071,"_34307":1023,"_23429":60273,"_5":16198,"_30870":60158,"_3543":60274},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_4098":1072,"_34307":1023,"_23429":60276,"_5":16198,"_30870":60158,"_3543":60277},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_4098":1073,"_34307":1073,"_5":16596,"_3543":59596,"_34738":60279,"_23429":60280,"_30870":1073},[56936,58404,59415,59413,59596],[],{"_4098":1074,"_34307":1073,"_23429":60282,"_5":16198,"_30870":1073,"_3543":60283},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_4098":1075,"_34307":1073,"_5":34735,"_23429":60285,"_30870":60286,"_3543":60287},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_4098":1076,"_34307":1073,"_5":34735,"_23429":60289,"_30870":60290,"_3543":60291},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_4098":1077,"_34307":1073,"_5":34735,"_23429":60293,"_30870":60294,"_3543":60295},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_4098":1078,"_34307":1073,"_5":34735,"_23429":60297,"_30870":60298,"_3543":60299},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_4098":1079,"_34307":1073,"_23429":60301,"_5":16198,"_30870":1073,"_3543":60302},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_4098":1080,"_34307":1073,"_23429":60304,"_5":16198,"_30870":60286,"_3543":60305},[],"The administrator prepares the CA, issuance profile and DMS.",{"_4098":1081,"_34307":1073,"_23429":60307,"_5":16198,"_30870":60286,"_3543":60308},[],"The integrator installs initial EST server trust and an admission credential.",{"_4098":1082,"_34307":1073,"_23429":60310,"_5":16198,"_30870":60286,"_3543":60311},[],"The client requests an identity for its `Device ID` through EST.",{"_4098":1083,"_34307":1073,"_23429":60313,"_5":16198,"_30870":60286,"_3543":60314},[],"Certificate, device binding and key/certificate installation are checked.",{"_4098":1084,"_34307":1073,"_23429":60316,"_5":16198,"_30870":60286,"_3543":60317},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_4098":1085,"_34307":1073,"_23429":60319,"_5":16198,"_30870":60286,"_3543":60320},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_4098":1086,"_34307":1073,"_23429":60322,"_5":16198,"_30870":60290,"_3543":60323},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_4098":1087,"_34307":1073,"_23429":60325,"_5":16198,"_30870":60290,"_3543":60326},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_4098":1088,"_34307":1073,"_23429":60328,"_5":16198,"_30870":60290,"_3543":60329},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_4098":1089,"_34307":1073,"_23429":60331,"_5":16198,"_30870":60290,"_3543":60332},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_4098":1090,"_34307":1073,"_23429":60334,"_5":16198,"_30870":60294,"_3543":60335},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_4098":1091,"_34307":1073,"_23429":60337,"_5":16198,"_30870":60294,"_3543":60338},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_4098":1092,"_34307":1073,"_23429":60340,"_5":16198,"_30870":60294,"_3543":60341},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_4098":1093,"_34307":1073,"_23429":60343,"_5":16198,"_30870":60294,"_3543":60344},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_4098":1094,"_34307":1073,"_23429":60346,"_5":16198,"_30870":60298,"_3543":60347},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_4098":1095,"_34307":1073,"_23429":60349,"_5":16198,"_30870":60298,"_3543":60350},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_4098":1096,"_34307":1096,"_5":16596,"_3543":60352,"_34738":60353,"_23429":60354,"_30870":1096},"Provisioning strategies",[56936,58404,59415,59413,59596],[],{"_4098":1097,"_34307":1096,"_23429":60356,"_5":16198,"_30870":1096,"_3543":60357},[],"Choose device registration, identity authorization and key generation.",{"_4098":1098,"_34307":1096,"_5":34735,"_23429":60359,"_30870":60360,"_3543":60361},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_4098":1099,"_34307":1096,"_5":34735,"_23429":60363,"_30870":60364,"_3543":60365},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_4098":1100,"_34307":1096,"_5":34735,"_23429":60367,"_30870":60368,"_3543":60369},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_4098":1101,"_34307":1096,"_5":34735,"_23429":60371,"_30870":60372,"_3543":60373},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_4098":1102,"_34307":1096,"_5":34735,"_23429":60375,"_30870":60376,"_3543":60377},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_4098":1103,"_34307":1096,"_23429":60379,"_5":16198,"_30870":1096,"_3543":60380},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_4098":1104,"_34307":1096,"_23429":60382,"_5":16198,"_30870":60360,"_3543":60383},[],"Path",{"_4098":1105,"_34307":1096,"_23429":60385,"_5":16198,"_30870":60360,"_3543":60386},[],"When the device exists",{"_4098":1106,"_34307":1096,"_23429":60388,"_5":16198,"_30870":60360,"_3543":60389},[],"What to check",{"_4098":1107,"_34307":1096,"_23429":60391,"_5":16198,"_30870":60360,"_3543":60392},[],"Manual assignment",{"_4098":1108,"_34307":1096,"_23429":60394,"_5":16198,"_30870":60360,"_3543":60395},[],"An operator creates it before associating a certificate.",{"_4098":1109,"_34307":1096,"_23429":60397,"_5":16198,"_30870":60360,"_3543":60398},[],"ID, owning DMS, certificate CN and bound serial.",{"_4098":1110,"_34307":1096,"_23429":60400,"_5":16198,"_30870":60360,"_3543":60401},[],"EST with `JITP`",{"_4098":1111,"_34307":1096,"_23429":60403,"_5":16198,"_30870":60360,"_3543":60404},[],"Created for an unknown CN during `/simpleenroll`.",{"_4098":1112,"_34307":1096,"_23429":60406,"_5":16198,"_30870":60360,"_3543":60407},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_4098":1113,"_34307":1096,"_23429":60409,"_5":16198,"_30870":60360,"_3543":60410},[],"EST with `PRE_REGISTRATION`",{"_4098":1114,"_34307":1096,"_23429":60412,"_5":16198,"_30870":60360,"_3543":60413},[],"Must exist before `/simpleenroll`.",{"_4098":1115,"_34307":1096,"_23429":60415,"_5":16198,"_30870":60360,"_3543":60416},[],"Approved record, same DMS and replacement conditions for your version.",{"_4098":1116,"_34307":1096,"_23429":60418,"_5":16198,"_30870":60360,"_3543":60419},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_4098":1117,"_34307":1096,"_23429":60421,"_5":16198,"_30870":60360,"_3543":60422},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_4098":1118,"_34307":1096,"_23429":60424,"_5":16198,"_30870":60364,"_3543":60425},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_4098":1119,"_34307":1096,"_23429":60427,"_5":16198,"_30870":60364,"_3543":60428},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_4098":1120,"_34307":1096,"_23429":60430,"_5":16198,"_30870":60364,"_3543":60431},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_4098":1121,"_34307":1096,"_23429":60433,"_5":16198,"_30870":60368,"_3543":60434},[],"Decide initial enrollment and re-enrollment separately:",{"_4098":1122,"_34307":1096,"_23429":60436,"_5":16198,"_30870":60368,"_3543":60437},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_4098":1123,"_34307":1096,"_23429":60439,"_5":16198,"_30870":60368,"_3543":60440},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_4098":1124,"_34307":1096,"_23429":60442,"_5":16198,"_30870":60368,"_3543":60443},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_4098":1125,"_34307":1096,"_23429":60445,"_5":16198,"_30870":60368,"_3543":60446},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_4098":1126,"_34307":1096,"_23429":60448,"_5":16198,"_30870":60368,"_3543":60449},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_4098":1127,"_34307":1096,"_23429":60451,"_5":16198,"_30870":60372,"_3543":57320},[],{"_4098":1128,"_34307":1096,"_23429":60453,"_5":16198,"_30870":60372,"_3543":60454},[],"Material crossing EST",{"_4098":1129,"_34307":1096,"_23429":60456,"_5":16198,"_30870":60372,"_3543":60457},[],"Device-generated key",{"_4098":1130,"_34307":1096,"_23429":60459,"_5":16198,"_30870":60372,"_3543":60460},[],"Public CSR and certificate; the key stays on the client.",{"_4098":1131,"_34307":1096,"_23429":60462,"_5":16198,"_30870":60372,"_3543":60463},[],"Existing device key",{"_4098":1132,"_34307":1096,"_23429":60465,"_5":16198,"_30870":60372,"_3543":60466},[],"CSR signed with that key and a new certificate.",{"_4098":1133,"_34307":1096,"_23429":60468,"_5":16198,"_30870":60372,"_3543":59734},[],{"_4098":1134,"_34307":1096,"_23429":60470,"_5":16198,"_30870":60372,"_3543":60471},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_4098":1135,"_34307":1096,"_23429":60473,"_5":16198,"_30870":60372,"_3543":60474},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_4098":1136,"_34307":1096,"_23429":60476,"_5":16198,"_30870":60376,"_3543":60477},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_4098":1137,"_34307":1137,"_5":16596,"_3543":60479,"_34738":60480,"_23429":60481,"_30870":1137},"Renewal and recovery",[56936,58404,59415,59413,59596],[],{"_4098":1138,"_34307":1137,"_23429":60483,"_5":16198,"_30870":1137,"_3543":60484},[],"Renew without losing the identity and recover devices according to their actual state.",{"_4098":1139,"_34307":1137,"_5":34735,"_23429":60486,"_30870":60487,"_3543":60488},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_4098":1140,"_34307":1137,"_5":34735,"_23429":60490,"_30870":60491,"_3543":60492},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_4098":1141,"_34307":1137,"_5":34735,"_23429":60494,"_30870":60495,"_3543":60496},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_4098":1142,"_34307":1137,"_5":34735,"_23429":60498,"_30870":60499,"_3543":60500},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_4098":1143,"_34307":1137,"_5":34735,"_23429":60502,"_30870":60503,"_3543":60504},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_4098":1144,"_34307":1137,"_23429":60506,"_5":16198,"_30870":1137,"_3543":60507},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_4098":1145,"_34307":1137,"_23429":60509,"_5":16198,"_30870":60487,"_3543":60510},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_4098":1146,"_34307":1137,"_23429":60512,"_5":16198,"_30870":60487,"_3543":60513},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_4098":1147,"_34307":1137,"_23429":60515,"_5":16198,"_30870":60487,"_3543":60516},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_4098":1148,"_34307":1137,"_23429":60518,"_5":16198,"_30870":60487,"_3543":60519},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_4098":1149,"_34307":1137,"_23429":60521,"_5":16198,"_30870":60491,"_3543":60522},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_4098":1150,"_34307":1137,"_23429":60524,"_5":16198,"_30870":60491,"_3543":60525},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_4098":1151,"_34307":1137,"_23429":60527,"_5":16198,"_30870":60495,"_3543":60528},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_4098":1152,"_34307":1137,"_23429":60530,"_5":16198,"_30870":60495,"_3543":60531},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_4098":1153,"_34307":1137,"_23429":60533,"_5":16198,"_30870":60495,"_3543":60534},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_4098":1154,"_34307":1137,"_23429":60536,"_5":16198,"_30870":60499,"_3543":60537},[],"Situation",{"_4098":1155,"_34307":1137,"_23429":60539,"_5":16198,"_30870":60499,"_3543":60540},[],"Procedure",{"_4098":1156,"_34307":1137,"_23429":60542,"_5":16198,"_30870":60499,"_3543":60543},[],"Valid certificate, outside the window",{"_4098":1157,"_34307":1137,"_23429":60545,"_5":16198,"_30870":60499,"_3543":60546},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_4098":1158,"_34307":1137,"_23429":60548,"_5":16198,"_30870":60499,"_3543":60549},[],"Expired certificate, key available",{"_4098":1159,"_34307":1137,"_23429":60551,"_5":16198,"_30870":60499,"_3543":60552},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_4098":1160,"_34307":1137,"_23429":60554,"_5":16198,"_30870":60499,"_3543":60555},[],"Renewal through webhook or `NO_AUTH`",{"_4098":1161,"_34307":1137,"_23429":60557,"_5":16198,"_30870":60499,"_3543":60558},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_4098":1162,"_34307":1137,"_23429":60560,"_5":16198,"_30870":60499,"_3543":60561},[],"Lost or inaccessible key",{"_4098":1163,"_34307":1137,"_23429":60563,"_5":16198,"_30870":60499,"_3543":60564},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_4098":1164,"_34307":1137,"_23429":60566,"_5":16198,"_30870":60499,"_3543":60567},[],"Current identity revoked",{"_4098":1165,"_34307":1137,"_23429":60569,"_5":16198,"_30870":60499,"_3543":60570},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_4098":1166,"_34307":1137,"_23429":60572,"_5":16198,"_30870":60499,"_3543":60573},[],"Device without an identity",{"_4098":1167,"_34307":1137,"_23429":60575,"_5":16198,"_30870":60499,"_3543":60576},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_4098":1168,"_34307":1137,"_23429":60578,"_5":16198,"_30870":60499,"_3543":60579},[],"Retired device",{"_4098":1169,"_34307":1137,"_23429":60581,"_5":16198,"_30870":60499,"_3543":60582},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_4098":1170,"_34307":1137,"_23429":60584,"_5":16198,"_30870":60499,"_3543":60585},[],"Timeout, HTTP 500 or installation failure",{"_4098":1171,"_34307":1137,"_23429":60587,"_5":16198,"_30870":60499,"_3543":60588},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_4098":1172,"_34307":1137,"_23429":60590,"_5":16198,"_30870":60503,"_3543":60591},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_4098":1173,"_34307":1137,"_23429":60593,"_5":16198,"_30870":60503,"_3543":60594},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_4098":1174,"_34307":1174,"_5":16596,"_3543":60596,"_34738":60597,"_23429":60598,"_30870":1174},"Enrollment troubleshooting",[56936,58404,59415,59413,59596],[],{"_4098":1175,"_34307":1174,"_23429":60600,"_5":16198,"_30870":1174,"_3543":60601},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_4098":1176,"_34307":1174,"_5":34735,"_23429":60603,"_30870":60604,"_3543":60605},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_4098":1177,"_34307":1174,"_5":34735,"_23429":60607,"_30870":60608,"_3543":60609},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_4098":1178,"_34307":1174,"_5":34735,"_23429":60611,"_30870":60612,"_3543":60159},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_4098":1179,"_34307":1174,"_5":34735,"_23429":60614,"_30870":60615,"_3543":60616},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_4098":1180,"_34307":1174,"_23429":60618,"_5":16198,"_30870":1174,"_3543":60619},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_4098":1181,"_34307":1174,"_23429":60621,"_5":16198,"_30870":60608,"_3543":60622},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_4098":1182,"_34307":1174,"_23429":60624,"_5":16198,"_30870":60608,"_3543":60625},[],"Symptom or message",{"_4098":1183,"_34307":1174,"_23429":60627,"_5":16198,"_30870":60608,"_3543":60389},[],{"_4098":1184,"_34307":1174,"_23429":60629,"_5":16198,"_30870":60608,"_3543":60630},[],"curl rejects TLS, name or issuer",{"_4098":1185,"_34307":1174,"_23429":60632,"_5":16198,"_30870":60608,"_3543":60633},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_4098":1186,"_34307":1174,"_23429":60635,"_5":16198,"_30870":60608,"_3543":60636},[],"404 or missing APS",{"_4098":1187,"_34307":1174,"_23429":60638,"_5":16198,"_30870":60608,"_3543":60639},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_4098":1188,"_34307":1174,"_23429":60641,"_5":16198,"_30870":60608,"_3543":60642},[],"400, CSR or format error",{"_4098":1189,"_34307":1174,"_23429":60644,"_5":16198,"_30870":60608,"_3543":60645},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_4098":1190,"_34307":1174,"_23429":60647,"_5":16198,"_30870":60608,"_3543":60648},[],"Missing credential or invalid certificate",{"_4098":1191,"_34307":1174,"_23429":60650,"_5":16198,"_30870":60608,"_3543":60651},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_4098":1192,"_34307":1174,"_23429":60653,"_5":16198,"_30870":60608,"_3543":60654},[],"Webhook denies, times out or responds without authorization",{"_4098":1193,"_34307":1174,"_23429":60656,"_5":16198,"_30870":60608,"_3543":60657},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_4098":1194,"_34307":1174,"_23429":60659,"_5":16198,"_30870":60608,"_3543":60660},[],"`unexpected status code: <n>: redirects are not followed`",{"_4098":1195,"_34307":1174,"_23429":60662,"_5":16198,"_30870":60608,"_3543":60663},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_4098":1196,"_34307":1174,"_23429":60665,"_5":16198,"_30870":60608,"_3543":60666},[],"`webhook response exceeds 1048576 bytes`",{"_4098":1197,"_34307":1174,"_23429":60668,"_5":16198,"_30870":60608,"_3543":60669},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_4098":1198,"_34307":1174,"_23429":60671,"_5":16198,"_30870":60608,"_3543":60672},[],"`webhook config must not reference files`",{"_4098":1199,"_34307":1174,"_23429":60674,"_5":16198,"_30870":60608,"_3543":60675},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_4098":1200,"_34307":1174,"_23429":60677,"_5":16198,"_30870":60608,"_3543":60678},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_4098":1201,"_34307":1174,"_23429":60680,"_5":16198,"_30870":60608,"_3543":60681},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_4098":1202,"_34307":1174,"_23429":60683,"_5":16198,"_30870":60608,"_3543":60684},[],"`webhook mTLS certificate and key are invalid: …`",{"_4098":1203,"_34307":1174,"_23429":60686,"_5":16198,"_30870":60608,"_3543":60687},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_4098":1204,"_34307":1174,"_23429":60689,"_5":16198,"_30870":60608,"_3543":60690},[],"400 `struct validation error` creating or updating a DMS",{"_4098":1205,"_34307":1174,"_23429":60692,"_5":16198,"_30870":60608,"_3543":60693},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_4098":1206,"_34307":1174,"_23429":60695,"_5":16198,"_30870":60608,"_3543":60696},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_4098":1207,"_34307":1174,"_23429":60698,"_5":16198,"_30870":60608,"_3543":60699},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_4098":1208,"_34307":1174,"_23429":60701,"_5":16198,"_30870":60608,"_3543":60702},[],"`device not preregistered`",{"_4098":1209,"_34307":1174,"_23429":60704,"_5":16198,"_30870":60608,"_3543":60705},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_4098":1210,"_34307":1174,"_23429":60707,"_5":16198,"_30870":60608,"_3543":60708},[],"`forbiddenNewEnrollment`",{"_4098":1211,"_34307":1174,"_23429":60710,"_5":16198,"_30870":60608,"_3543":60711},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_4098":1212,"_34307":1174,"_23429":60713,"_5":16198,"_30870":60608,"_3543":60714},[],"Different owning DMS",{"_4098":1213,"_34307":1174,"_23429":60716,"_5":16198,"_30870":60608,"_3543":60717},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_4098":1214,"_34307":1174,"_23429":60719,"_5":16198,"_30870":60608,"_3543":60720},[],"`invalid RawSubject bytes`",{"_4098":1215,"_34307":1174,"_23429":60722,"_5":16198,"_30870":60608,"_3543":60723},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_4098":1216,"_34307":1174,"_23429":60725,"_5":16198,"_30870":60608,"_3543":60726},[],"`invalid reenroll window`",{"_4098":1217,"_34307":1174,"_23429":60728,"_5":16198,"_30870":60608,"_3543":60729},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_4098":1218,"_34307":1174,"_23429":60731,"_5":16198,"_30870":60608,"_3543":60732},[],"Current certificate revoked",{"_4098":1219,"_34307":1174,"_23429":60734,"_5":16198,"_30870":60608,"_3543":60735},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_4098":1220,"_34307":1174,"_23429":60737,"_5":16198,"_30870":60608,"_3543":60738},[],"CA, profile or signing error",{"_4098":1221,"_34307":1174,"_23429":60740,"_5":16198,"_30870":60608,"_3543":60741},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_4098":1222,"_34307":1174,"_23429":60743,"_5":16198,"_30870":60608,"_3543":60744},[],"HTTP 200 without a device connection",{"_4098":1223,"_34307":1174,"_23429":60746,"_5":16198,"_30870":60608,"_3543":60747},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_4098":1224,"_34307":1174,"_23429":60749,"_5":16198,"_30870":60608,"_3543":60750},[],"Timeout or error after issuance",{"_4098":1225,"_34307":1174,"_23429":60752,"_5":16198,"_30870":60608,"_3543":60753},[],"New certificates, current slot and previous identity's state before retrying.",{"_4098":1226,"_34307":1174,"_23429":60755,"_5":16198,"_30870":60612,"_3543":60756},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_4098":1227,"_34307":1174,"_23429":60758,"_5":16198,"_30870":60612,"_3543":60759},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_4098":1228,"_34307":1174,"_23429":60761,"_5":16198,"_30870":60615,"_3543":60762},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_4098":1229,"_34307":1174,"_23429":60764,"_5":16198,"_30870":60615,"_3543":60765},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_4098":1230,"_34307":1174,"_23429":60767,"_5":16198,"_30870":60615,"_3543":60768},[],"Verify the CSR locally and relate its CN to the inventory.",{"_4098":1231,"_34307":1174,"_23429":60770,"_5":16198,"_30870":60615,"_3543":60771},[],"Make one request, save headers/body and query the device and certificates.",{"_4098":1232,"_34307":1174,"_23429":60773,"_5":16198,"_30870":60615,"_3543":60774},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_4098":1233,"_34307":1174,"_23429":60776,"_5":16198,"_30870":60615,"_3543":60777},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_4098":1234,"_34307":1174,"_23429":60779,"_5":16198,"_30870":60615,"_3543":60780},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_4098":1235,"_34307":1235,"_5":16596,"_3543":60782,"_34738":60783,"_23429":60784,"_30870":1235},"Trust distribution and updates",[56936,58404,59415,59413,59596],[],{"_4098":1236,"_34307":1235,"_23429":60786,"_5":16198,"_30870":1235,"_3543":60787},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_4098":1237,"_34307":1235,"_5":34735,"_23429":60789,"_30870":60790,"_3543":60791},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_4098":1238,"_34307":1235,"_5":34735,"_23429":60793,"_30870":60794,"_3543":60795},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_4098":1239,"_34307":1235,"_5":34735,"_23429":60797,"_30870":60798,"_3543":60799},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_4098":1240,"_34307":1235,"_5":34735,"_23429":60801,"_30870":60802,"_3543":60803},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_4098":1241,"_34307":1235,"_5":34735,"_23429":60805,"_30870":60806,"_3543":60807},[],"/docs/pr-preview/pr-58/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_4098":1242,"_34307":1235,"_23429":60809,"_5":16198,"_30870":1235,"_3543":60810},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_4098":1243,"_34307":1235,"_23429":60812,"_5":16198,"_30870":60790,"_3543":60813},[],"Relationship",{"_4098":1244,"_34307":1235,"_23429":60815,"_5":16198,"_30870":60790,"_3543":60816},[],"Material prepared by its owner",{"_4098":1245,"_34307":1235,"_23429":60818,"_5":16198,"_30870":60790,"_3543":60819},[],"Device → EST server",{"_4098":1246,"_34307":1235,"_23429":60821,"_5":16198,"_30870":60790,"_3543":60822},[],"Previously verified server root, chain or pin and TLS name.",{"_4098":1247,"_34307":1235,"_23429":60824,"_5":16198,"_30870":60790,"_3543":60825},[],"DMS → requester",{"_4098":1248,"_34307":1235,"_23429":60827,"_5":16198,"_30870":60790,"_3543":60828},[],"CAs and rules authorizing initial or renewal credentials.",{"_4098":1249,"_34307":1235,"_23429":60830,"_5":16198,"_30870":60790,"_3543":60831},[],"Consumer → device",{"_4098":1250,"_34307":1235,"_23429":60833,"_5":16198,"_30870":60790,"_3543":60834},[],"Operational identity roots, intermediates, validation and permissions.",{"_4098":1251,"_34307":1235,"_23429":60836,"_5":16198,"_30870":60790,"_3543":60837},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_4098":1252,"_34307":1235,"_23429":60839,"_5":16198,"_30870":60794,"_3543":60840},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_4098":1253,"_34307":1235,"_23429":60842,"_5":16198,"_30870":60794,"_3543":60843},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_4098":1254,"_34307":1235,"_23429":60845,"_5":16198,"_30870":60798,"_3543":60846},[],"Keep initial EST server trust separate from identity consumer trust.",{"_4098":1255,"_34307":1235,"_23429":60848,"_5":16198,"_30870":60798,"_3543":60849},[],"Select policy-approved roots as anchors.",{"_4098":1256,"_34307":1235,"_23429":60851,"_5":16198,"_30870":60798,"_3543":60852},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_4098":1257,"_34307":1235,"_23429":60854,"_5":16198,"_30870":60798,"_3543":60855},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_4098":1258,"_34307":1235,"_23429":60857,"_5":16198,"_30870":60798,"_3543":60858},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_4098":1259,"_34307":1235,"_23429":60860,"_5":16198,"_30870":60798,"_3543":60861},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_4098":1260,"_34307":1235,"_23429":60863,"_5":16198,"_30870":60802,"_3543":60864},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_4098":1261,"_34307":1235,"_23429":60866,"_5":16198,"_30870":60802,"_3543":60867},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_4098":1262,"_34307":1235,"_23429":60869,"_5":16198,"_30870":60802,"_3543":60870},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_4098":1263,"_34307":1235,"_23429":60872,"_5":16198,"_30870":60806,"_3543":60873},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_4098":1264,"_34307":1264,"_5":16596,"_3543":60875,"_34738":60876,"_23429":60878,"_30870":1264},"AWS IoT Core",[56936,58404,59415,59413,60877],"Integrations",[],{"_4098":1265,"_34307":1264,"_23429":60880,"_5":16198,"_30870":1264,"_3543":60881},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_4098":1266,"_34307":1264,"_5":34735,"_23429":60883,"_30870":60884,"_3543":60885},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_4098":1267,"_34307":1264,"_5":34735,"_23429":60887,"_30870":60888,"_3543":60889},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_4098":1268,"_34307":1264,"_5":34735,"_23429":60891,"_30870":60892,"_3543":60893},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_4098":1269,"_34307":1264,"_5":34735,"_23429":60895,"_30870":60896,"_3543":60897},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_4098":1270,"_34307":1264,"_5":34735,"_23429":60899,"_30870":60900,"_3543":60901},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_4098":1271,"_34307":1264,"_5":34735,"_23429":60903,"_30870":60904,"_3543":60905},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_4098":1272,"_34307":1264,"_5":34735,"_23429":60907,"_30870":60908,"_3543":60909},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_4098":1273,"_34307":1264,"_5":34735,"_23429":60911,"_30870":60912,"_3543":60913},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_4098":1274,"_34307":1264,"_5":34735,"_23429":60915,"_30870":60916,"_3543":60917},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_4098":1275,"_34307":1264,"_5":34735,"_23429":60919,"_30870":60920,"_3543":60921},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_4098":1276,"_34307":1264,"_5":34735,"_23429":60923,"_30870":60924,"_3543":60925},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_4098":1277,"_34307":1264,"_5":34735,"_23429":60927,"_30870":60928,"_3543":60929},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_4098":1278,"_34307":1264,"_5":34735,"_23429":60931,"_30870":60932,"_3543":60933},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_4098":1279,"_34307":1264,"_5":34735,"_23429":60935,"_30870":60936,"_3543":60937},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_4098":1280,"_34307":1264,"_5":34735,"_23429":60939,"_30870":60940,"_3543":60941},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_4098":1281,"_34307":1264,"_5":34735,"_23429":60943,"_30870":60944,"_3543":60945},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_4098":1282,"_34307":1264,"_5":34735,"_23429":60947,"_30870":60948,"_3543":60949},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_4098":1283,"_34307":1264,"_5":34735,"_23429":60951,"_30870":60952,"_3543":60953},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_4098":1284,"_34307":1264,"_5":34735,"_23429":60955,"_30870":60956,"_3543":60957},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_4098":1285,"_34307":1264,"_5":34735,"_23429":60959,"_30870":60960,"_3543":60961},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_4098":1286,"_34307":1264,"_5":34735,"_23429":60963,"_30870":60964,"_3543":60965},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_4098":1287,"_34307":1264,"_5":34735,"_23429":60967,"_30870":60968,"_3543":60969},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_4098":1288,"_34307":1264,"_5":34735,"_23429":60971,"_30870":60972,"_3543":60973},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_4098":1289,"_34307":1264,"_5":34735,"_23429":60975,"_30870":60976,"_3543":60977},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_4098":1290,"_34307":1264,"_5":34735,"_23429":60979,"_30870":60980,"_3543":60981},[],"/docs/pr-preview/pr-58/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_4098":1291,"_34307":1264,"_23429":60983,"_5":16198,"_30870":1264,"_3543":60984},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_4098":1292,"_34307":1264,"_23429":60986,"_5":16198,"_30870":1264,"_3543":60987},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_4098":1293,"_34307":1264,"_23429":60989,"_5":16198,"_30870":1264,"_3543":60990},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_4098":1294,"_34307":1264,"_23429":60992,"_5":16198,"_30870":60884,"_3543":60993},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_4098":1295,"_34307":1264,"_23429":60995,"_5":16198,"_30870":60884,"_3543":60996},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_4098":1296,"_34307":1264,"_23429":60998,"_5":16198,"_30870":60884,"_3543":60999},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_4098":1297,"_34307":1264,"_23429":61001,"_5":16198,"_30870":60884,"_3543":61002},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_4098":1298,"_34307":1264,"_23429":61004,"_5":16198,"_30870":60888,"_3543":61005},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_4098":1299,"_34307":1264,"_23429":61007,"_5":16198,"_30870":60892,"_3543":61008},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_4098":1300,"_34307":1264,"_23429":61010,"_5":16198,"_30870":60892,"_3543":61011},[],"IAM action",{"_4098":1301,"_34307":1264,"_23429":61013,"_5":16198,"_30870":60892,"_3543":57326},[],{"_4098":1302,"_34307":1264,"_23429":61015,"_5":16198,"_30870":60892,"_3543":61016},[],"`iot:GetRegistrationCode`",{"_4098":1303,"_34307":1264,"_23429":61018,"_5":16198,"_30870":60892,"_3543":61019},[],"Obtain the verification code for CA registration in the Primary Account",{"_4098":1304,"_34307":1264,"_23429":61021,"_5":16198,"_30870":60892,"_3543":61022},[],"`iot:RegisterCACertificate`",{"_4098":1305,"_34307":1264,"_23429":61024,"_5":16198,"_30870":60892,"_3543":61025},[],"Register the CA in AWS IoT",{"_4098":1306,"_34307":1264,"_23429":61027,"_5":16198,"_30870":60892,"_3543":61028},[],"`iot:DescribeCACertificate`",{"_4098":1307,"_34307":1264,"_23429":61030,"_5":16198,"_30870":60892,"_3543":61031},[],"Check the CA registration status",{"_4098":1308,"_34307":1264,"_23429":61033,"_5":16198,"_30870":60892,"_3543":61034},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_4098":1309,"_34307":1264,"_23429":61036,"_5":16198,"_30870":60892,"_3543":61037},[],"Create or update Things in IoT Core",{"_4098":1310,"_34307":1264,"_23429":61039,"_5":16198,"_30870":60892,"_3543":61040},[],"`iot:RegisterThing`",{"_4098":1311,"_34307":1264,"_23429":61042,"_5":16198,"_30870":60892,"_3543":61043},[],"Provision Things through a template",{"_4098":1312,"_34307":1264,"_23429":61045,"_5":16198,"_30870":60892,"_3543":61046},[],"`iot:RegisterCertificate`",{"_4098":1313,"_34307":1264,"_23429":61048,"_5":16198,"_30870":60892,"_3543":61049},[],"Register device certificates",{"_4098":1314,"_34307":1264,"_23429":61051,"_5":16198,"_30870":60892,"_3543":61052},[],"`iot:UpdateCertificate`",{"_4098":1315,"_34307":1264,"_23429":61054,"_5":16198,"_30870":60892,"_3543":61055},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_4098":1316,"_34307":1264,"_23429":61057,"_5":16198,"_30870":60892,"_3543":61058},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_4098":1317,"_34307":1264,"_23429":61060,"_5":16198,"_30870":60892,"_3543":61061},[],"Create and attach IoT policies",{"_4098":1318,"_34307":1264,"_23429":61063,"_5":16198,"_30870":60892,"_3543":61064},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_4098":1319,"_34307":1264,"_23429":61066,"_5":16198,"_30870":60892,"_3543":61067},[],"Manage Thing groups",{"_4098":1320,"_34307":1264,"_23429":61069,"_5":16198,"_30870":60892,"_3543":61070},[],"`iot:CreateProvisioningTemplate`",{"_4098":1321,"_34307":1264,"_23429":61072,"_5":16198,"_30870":60892,"_3543":61073},[],"Create JITP templates",{"_4098":1322,"_34307":1264,"_23429":61075,"_5":16198,"_30870":60892,"_3543":61076},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_4098":1323,"_34307":1264,"_23429":61078,"_5":16198,"_30870":60892,"_3543":61079},[],"Read and write the Device Shadow",{"_4098":1324,"_34307":1264,"_23429":61081,"_5":16198,"_30870":60892,"_3543":61082},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_4098":1325,"_34307":1264,"_23429":61084,"_5":16198,"_30870":60896,"_3543":61085},[],"Parameter",{"_4098":1326,"_34307":1264,"_23429":61087,"_5":16198,"_30870":60896,"_3543":61088},[],"Type",{"_4098":1327,"_34307":1264,"_23429":61090,"_5":16198,"_30870":60896,"_3543":61091},[],"Required",{"_4098":1328,"_34307":1264,"_23429":61093,"_5":16198,"_30870":60896,"_3543":61094},[],"Description",{"_4098":1329,"_34307":1264,"_23429":61096,"_5":16198,"_30870":60896,"_3543":61097},[],"`connector_id`",{"_4098":1330,"_34307":1264,"_23429":61099,"_5":16198,"_30870":60896,"_3543":28013},[],{"_4098":1331,"_34307":1264,"_23429":61101,"_5":16198,"_30870":60896,"_3543":61102},[],"Yes",{"_4098":1332,"_34307":1264,"_23429":61104,"_5":16198,"_30870":60896,"_3543":61105},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_4098":1333,"_34307":1264,"_23429":61107,"_5":16198,"_30870":60896,"_3543":61108},[],"`aws_config.region`",{"_4098":1334,"_34307":1264,"_23429":61110,"_5":16198,"_30870":60896,"_3543":28013},[],{"_4098":1335,"_34307":1264,"_23429":61112,"_5":16198,"_30870":60896,"_3543":61102},[],{"_4098":1336,"_34307":1264,"_23429":61114,"_5":16198,"_30870":60896,"_3543":61115},[],"AWS region where the connector operates.",{"_4098":1337,"_34307":1264,"_23429":61117,"_5":16198,"_30870":60896,"_3543":61118},[],"`aws_config.auth_method`",{"_4098":1338,"_34307":1264,"_23429":61120,"_5":16198,"_30870":60896,"_3543":28013},[],{"_4098":1339,"_34307":1264,"_23429":61122,"_5":16198,"_30870":60896,"_3543":61102},[],{"_4098":1340,"_34307":1264,"_23429":61124,"_5":16198,"_30870":60896,"_3543":61125},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_4098":1341,"_34307":1264,"_23429":61127,"_5":16198,"_30870":60896,"_3543":61128},[],"`aws_config.access_key_id`",{"_4098":1342,"_34307":1264,"_23429":61130,"_5":16198,"_30870":60896,"_3543":28013},[],{"_4098":1343,"_34307":1264,"_23429":61132,"_5":16198,"_30870":60896,"_3543":61133},[],"Only with `auth_method=static`",{"_4098":1344,"_34307":1264,"_23429":61135,"_5":16198,"_30870":60896,"_3543":61136},[],"AWS access key.",{"_4098":1345,"_34307":1264,"_23429":61138,"_5":16198,"_30870":60896,"_3543":61139},[],"`aws_config.secret_access_key`",{"_4098":1346,"_34307":1264,"_23429":61141,"_5":16198,"_30870":60896,"_3543":28013},[],{"_4098":1347,"_34307":1264,"_23429":61143,"_5":16198,"_30870":60896,"_3543":61133},[],{"_4098":1348,"_34307":1264,"_23429":61145,"_5":16198,"_30870":60896,"_3543":61146},[],"AWS secret key.",{"_4098":1349,"_34307":1264,"_23429":61148,"_5":16198,"_30870":60896,"_3543":61149},[],"`aws_config.session_token`",{"_4098":1350,"_34307":1264,"_23429":61151,"_5":16198,"_30870":60896,"_3543":28013},[],{"_4098":1351,"_34307":1264,"_23429":61153,"_5":16198,"_30870":60896,"_3543":61154},[],"No",{"_4098":1352,"_34307":1264,"_23429":61156,"_5":16198,"_30870":60896,"_3543":61157},[],"Session token (with `auth_method=static`).",{"_4098":1353,"_34307":1264,"_23429":61159,"_5":16198,"_30870":60896,"_3543":61160},[],"`aws_config.role_arn`",{"_4098":1354,"_34307":1264,"_23429":61162,"_5":16198,"_30870":60896,"_3543":28013},[],{"_4098":1355,"_34307":1264,"_23429":61164,"_5":16198,"_30870":60896,"_3543":61165},[],"Only with `auth_method=role`",{"_4098":1356,"_34307":1264,"_23429":61167,"_5":16198,"_30870":60896,"_3543":61168},[],"ARN of the role to assume.",{"_4098":1357,"_34307":1264,"_23429":61170,"_5":16198,"_30870":60896,"_3543":61171},[],"`aws_config.endpoint_url`",{"_4098":1358,"_34307":1264,"_23429":61173,"_5":16198,"_30870":60896,"_3543":28013},[],{"_4098":1359,"_34307":1264,"_23429":61175,"_5":16198,"_30870":60896,"_3543":61154},[],{"_4098":1360,"_34307":1264,"_23429":61177,"_5":16198,"_30870":60896,"_3543":61178},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_4098":1361,"_34307":1264,"_23429":61180,"_5":16198,"_30870":60896,"_3543":61181},[],"`subscriber_event_bus`",{"_4098":1362,"_34307":1264,"_23429":61183,"_5":16198,"_30870":60896,"_3543":19769},[],{"_4098":1363,"_34307":1264,"_23429":61185,"_5":16198,"_30870":60896,"_3543":61102},[],{"_4098":1364,"_34307":1264,"_23429":61187,"_5":16198,"_30870":60896,"_3543":61188},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_4098":1365,"_34307":1264,"_23429":61190,"_5":16198,"_30870":60896,"_3543":61191},[],"`dms_manager_client`",{"_4098":1366,"_34307":1264,"_23429":61193,"_5":16198,"_30870":60896,"_3543":28013},[],{"_4098":1367,"_34307":1264,"_23429":61195,"_5":16198,"_30870":60896,"_3543":61102},[],{"_4098":1368,"_34307":1264,"_23429":61197,"_5":16198,"_30870":60896,"_3543":61198},[],"HTTP URL of Lamassu's DMS Manager service.",{"_4098":1369,"_34307":1264,"_23429":61200,"_5":16198,"_30870":60896,"_3543":61201},[],"`device_manager_client`",{"_4098":1370,"_34307":1264,"_23429":61203,"_5":16198,"_30870":60896,"_3543":28013},[],{"_4098":1371,"_34307":1264,"_23429":61205,"_5":16198,"_30870":60896,"_3543":61102},[],{"_4098":1372,"_34307":1264,"_23429":61207,"_5":16198,"_30870":60896,"_3543":61208},[],"HTTP URL of Lamassu's Device Manager.",{"_4098":1373,"_34307":1264,"_23429":61210,"_5":16198,"_30870":60896,"_3543":61211},[],"`ca_client`",{"_4098":1374,"_34307":1264,"_23429":61213,"_5":16198,"_30870":60896,"_3543":28013},[],{"_4098":1375,"_34307":1264,"_23429":61215,"_5":16198,"_30870":60896,"_3543":61102},[],{"_4098":1376,"_34307":1264,"_23429":61217,"_5":16198,"_30870":60896,"_3543":61218},[],"HTTP URL of Lamassu's CA service.",{"_4098":1377,"_34307":1264,"_23429":61220,"_5":16198,"_30870":60900,"_3543":61221},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_4098":1378,"_34307":1264,"_23429":61223,"_5":16198,"_30870":60900,"_3543":61224},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_4098":1379,"_34307":1264,"_23429":61226,"_5":16198,"_30870":60900,"_3543":61227},[],"CloudEvent type",{"_4098":1380,"_34307":1264,"_23429":61229,"_5":16198,"_30870":60900,"_3543":61230},[],"Lamassu resource",{"_4098":1381,"_34307":1264,"_23429":61232,"_5":16198,"_30870":60900,"_3543":61233},[],"AWS Resource",{"_4098":1382,"_34307":1264,"_23429":61235,"_5":16198,"_30870":60900,"_3543":61236},[],"IAM actions",{"_4098":1383,"_34307":1264,"_23429":61238,"_5":16198,"_30870":60900,"_3543":61239},[],"AWS calls and effect",{"_4098":1384,"_34307":1264,"_23429":61241,"_5":16198,"_30870":60900,"_3543":61242},[],"Where in this page",{"_4098":1385,"_34307":1264,"_23429":61244,"_5":16198,"_30870":60900,"_3543":61245},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_4098":1386,"_34307":1264,"_23429":61247,"_5":16198,"_30870":60900,"_3543":61248},[],"CA",{"_4098":1387,"_34307":1264,"_23429":61250,"_5":16198,"_30870":60900,"_3543":61251},[],"`IoTCore/CACertificate`",{"_4098":1388,"_34307":1264,"_23429":61253,"_5":16198,"_30870":60900,"_3543":61254},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_4098":1389,"_34307":1264,"_23429":61256,"_5":16198,"_30870":60900,"_3543":61257},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_4098":1390,"_34307":1264,"_23429":61259,"_5":16198,"_30870":60900,"_3543":60913},[],{"_4098":1391,"_34307":1264,"_23429":61261,"_5":16198,"_30870":60900,"_3543":61262},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_4098":1392,"_34307":1264,"_23429":61264,"_5":16198,"_30870":60900,"_3543":61265},[],"DMS",{"_4098":1393,"_34307":1264,"_23429":61267,"_5":16198,"_30870":60900,"_3543":61268},[],"`IoTCore/ProvisioningTemplate`",{"_4098":1394,"_34307":1264,"_23429":61270,"_5":16198,"_30870":60900,"_3543":61271},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_4098":1395,"_34307":1264,"_23429":61273,"_5":16198,"_30870":60900,"_3543":61274},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_4098":1396,"_34307":1264,"_23429":61276,"_5":16198,"_30870":60900,"_3543":60941},[],{"_4098":1397,"_34307":1264,"_23429":61278,"_5":16198,"_30870":60900,"_3543":61279},[],"`EventBindDeviceIdentityKey`",{"_4098":1398,"_34307":1264,"_23429":61281,"_5":16198,"_30870":60900,"_3543":61282},[],"Device",{"_4098":1399,"_34307":1264,"_23429":61284,"_5":16198,"_30870":60900,"_3543":61285},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_4098":1400,"_34307":1264,"_23429":61287,"_5":16198,"_30870":60900,"_3543":61288},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_4098":1401,"_34307":1264,"_23429":61290,"_5":16198,"_30870":60900,"_3543":61291},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_4098":1402,"_34307":1264,"_23429":61293,"_5":16198,"_30870":60900,"_3543":60949},[],{"_4098":1403,"_34307":1264,"_23429":61295,"_5":16198,"_30870":60900,"_3543":61296},[],"`EventUpdateCertificateStatusKey`",{"_4098":1404,"_34307":1264,"_23429":61298,"_5":16198,"_30870":60900,"_3543":61299},[],"Certificate",{"_4098":1405,"_34307":1264,"_23429":61301,"_5":16198,"_30870":60900,"_3543":61302},[],"`IoTCore/Certificate`",{"_4098":1406,"_34307":1264,"_23429":61304,"_5":16198,"_30870":60900,"_3543":61305},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_4098":1407,"_34307":1264,"_23429":61307,"_5":16198,"_30870":60900,"_3543":61308},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_4098":1408,"_34307":1264,"_23429":61310,"_5":16198,"_30870":60900,"_3543":60961},[],{"_4098":1409,"_34307":1264,"_23429":61312,"_5":16198,"_30870":60900,"_3543":61313},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_4098":1410,"_34307":1264,"_23429":61315,"_5":16198,"_30870":60900,"_3543":61316},[],"Certificate / Device",{"_4098":1411,"_34307":1264,"_23429":61318,"_5":16198,"_30870":60900,"_3543":61319},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_4098":1412,"_34307":1264,"_23429":61321,"_5":16198,"_30870":60900,"_3543":57332},[],{"_4098":1413,"_34307":1264,"_23429":61323,"_5":16198,"_30870":60900,"_3543":61324},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_4098":1414,"_34307":1264,"_23429":61326,"_5":16198,"_30870":60900,"_3543":60969},[],{"_4098":1415,"_34307":1264,"_23429":61328,"_5":16198,"_30870":60904,"_3543":61329},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_4098":1416,"_34307":1264,"_23429":61331,"_5":16198,"_30870":60908,"_3543":61332},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_4098":1417,"_34307":1264,"_23429":61334,"_5":16198,"_30870":60908,"_3543":61335},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_4098":1418,"_34307":1264,"_23429":61337,"_5":16198,"_30870":60912,"_3543":61338},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_4098":1419,"_34307":1264,"_23429":61340,"_5":16198,"_30870":60912,"_3543":61341},[],"Transition",{"_4098":1420,"_34307":1264,"_23429":61343,"_5":16198,"_30870":60912,"_3543":61344},[],"AWS calls",{"_4098":1421,"_34307":1264,"_23429":61346,"_5":16198,"_30870":60912,"_3543":61347},[],"`NotRegistered` → `Requested`",{"_4098":1422,"_34307":1264,"_23429":61349,"_5":16198,"_30870":60912,"_3543":61350},[],"none (metadata write only)",{"_4098":1423,"_34307":1264,"_23429":61352,"_5":16198,"_30870":60912,"_3543":61353},[],"`Requested` → `Registering`",{"_4098":1424,"_34307":1264,"_23429":61355,"_5":16198,"_30870":60912,"_3543":61356},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_4098":1425,"_34307":1264,"_23429":61358,"_5":16198,"_30870":60912,"_3543":61359},[],"`Registering` → `Succeeded`",{"_4098":1426,"_34307":1264,"_23429":61361,"_5":16198,"_30870":60912,"_3543":61362},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_4098":1427,"_34307":1264,"_23429":61364,"_5":16198,"_30870":60912,"_3543":61365},[],"`Registering` → `Failed`",{"_4098":1428,"_34307":1264,"_23429":61367,"_5":16198,"_30870":60912,"_3543":61368},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_4098":1429,"_34307":1264,"_23429":61370,"_5":16198,"_30870":60912,"_3543":61371},[],"`Failed` / `Succeeded` → `Requested`",{"_4098":1430,"_34307":1264,"_23429":61373,"_5":16198,"_30870":60912,"_3543":61374},[],"none (a new `REQUESTED` write re-runs the flow)",{"_4098":1431,"_34307":1264,"_23429":61376,"_5":16198,"_30870":60916,"_3543":61377},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_4098":1432,"_34307":1264,"_23429":61379,"_5":16198,"_30870":60916,"_3543":61380},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_4098":1433,"_34307":1264,"_23429":61382,"_5":16198,"_30870":60916,"_3543":61383},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_4098":1434,"_34307":1264,"_23429":61385,"_5":16198,"_30870":60916,"_3543":61386},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_4098":1435,"_34307":1264,"_23429":61388,"_5":16198,"_30870":60916,"_3543":61389},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_4098":1436,"_34307":1264,"_23429":61391,"_5":16198,"_30870":60916,"_3543":61392},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_4098":1437,"_34307":1264,"_23429":61394,"_5":16198,"_30870":60920,"_3543":61395},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_4098":1438,"_34307":1264,"_23429":61397,"_5":16198,"_30870":60924,"_3543":61398},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_4098":1439,"_34307":1264,"_23429":61400,"_5":16198,"_30870":60924,"_3543":61401},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_4098":1440,"_34307":1264,"_23429":61403,"_5":16198,"_30870":60928,"_3543":61404},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_4098":1441,"_34307":1264,"_23429":61406,"_5":16198,"_30870":60932,"_3543":61407},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_4098":1442,"_34307":1264,"_23429":61409,"_5":16198,"_30870":60932,"_3543":61410},[],"Creates or updates the IoT policies configured in the DMS.",{"_4098":1443,"_34307":1264,"_23429":61412,"_5":16198,"_30870":60932,"_3543":61413},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_4098":1444,"_34307":1264,"_23429":61415,"_5":16198,"_30870":60932,"_3543":61416},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_4098":1445,"_34307":1264,"_23429":61418,"_5":16198,"_30870":60932,"_3543":61419},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_4098":1446,"_34307":1264,"_23429":61421,"_5":16198,"_30870":60932,"_3543":61422},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_4098":1447,"_34307":1264,"_23429":61424,"_5":16198,"_30870":60932,"_3543":61425},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_4098":1448,"_34307":1264,"_23429":61427,"_5":16198,"_30870":60936,"_3543":61428},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_4098":1449,"_34307":1264,"_23429":61430,"_5":16198,"_30870":60936,"_3543":61431},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_4098":1450,"_34307":1264,"_23429":61433,"_5":16198,"_30870":60936,"_3543":61434},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_4098":1451,"_34307":1264,"_23429":61436,"_5":16198,"_30870":60936,"_3543":61437},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_4098":1452,"_34307":1264,"_23429":61439,"_5":16198,"_30870":60936,"_3543":61440},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_4098":1453,"_34307":1264,"_23429":61442,"_5":16198,"_30870":60940,"_3543":61443},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_4098":1454,"_34307":1264,"_23429":61445,"_5":16198,"_30870":60940,"_3543":61341},[],{"_4098":1455,"_34307":1264,"_23429":61447,"_5":16198,"_30870":60940,"_3543":61344},[],{"_4098":1456,"_34307":1264,"_23429":61449,"_5":16198,"_30870":60940,"_3543":61450},[],"`Unconfigured` → `None` / `Auto`",{"_4098":1457,"_34307":1264,"_23429":61452,"_5":16198,"_30870":60940,"_3543":61453},[],"none (configuration only)",{"_4098":1458,"_34307":1264,"_23429":61455,"_5":16198,"_30870":60940,"_3543":61456},[],"`None` ↔ `Auto`",{"_4098":1459,"_34307":1264,"_23429":61458,"_5":16198,"_30870":60940,"_3543":61453},[],{"_4098":1460,"_34307":1264,"_23429":61460,"_5":16198,"_30870":60940,"_3543":61461},[],"Any → `Jitp`",{"_4098":1461,"_34307":1264,"_23429":61463,"_5":16198,"_30870":60940,"_3543":61464},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_4098":1462,"_34307":1264,"_23429":61466,"_5":16198,"_30870":60940,"_3543":61467},[],"`Jitp` → `None` / `Auto`",{"_4098":1463,"_34307":1264,"_23429":61469,"_5":16198,"_30870":60940,"_3543":61470},[],"none (the template stays in the AWS account)",{"_4098":1464,"_34307":1264,"_23429":61472,"_5":16198,"_30870":60944,"_3543":61473},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_4098":1465,"_34307":1264,"_23429":61475,"_5":16198,"_30870":60944,"_3543":61476},[],"The full flow from the device's perspective is:",{"_4098":1466,"_34307":1264,"_23429":61478,"_5":16198,"_30870":60944,"_3543":61479},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_4098":1467,"_34307":1264,"_23429":61481,"_5":16198,"_30870":60948,"_3543":61482},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_4098":1468,"_34307":1264,"_23429":61484,"_5":16198,"_30870":60948,"_3543":61341},[],{"_4098":1469,"_34307":1264,"_23429":61486,"_5":16198,"_30870":60948,"_3543":61344},[],{"_4098":1470,"_34307":1264,"_23429":61488,"_5":16198,"_30870":60948,"_3543":61489},[],"`Absent` → `Provisioned`",{"_4098":1471,"_34307":1264,"_23429":61491,"_5":16198,"_30870":60948,"_3543":61492},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_4098":1472,"_34307":1264,"_23429":61494,"_5":16198,"_30870":60948,"_3543":61495},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_4098":1473,"_34307":1264,"_23429":61497,"_5":16198,"_30870":60948,"_3543":61498},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_4098":1474,"_34307":1264,"_23429":61500,"_5":16198,"_30870":60948,"_3543":61501},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_4098":1475,"_34307":1264,"_23429":61503,"_5":16198,"_30870":60952,"_3543":61504},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_4098":1476,"_34307":1264,"_23429":61506,"_5":16198,"_30870":60952,"_3543":61507},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_4098":1477,"_34307":1264,"_23429":61509,"_5":16198,"_30870":60952,"_3543":61510},[],"For the JITP flow to work correctly:",{"_4098":1478,"_34307":1264,"_23429":61512,"_5":16198,"_30870":60952,"_3543":61513},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_4098":1479,"_34307":1264,"_23429":61515,"_5":16198,"_30870":60952,"_3543":61516},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_4098":1480,"_34307":1264,"_23429":61518,"_5":16198,"_30870":60952,"_3543":61519},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_4098":1481,"_34307":1264,"_23429":61521,"_5":16198,"_30870":60952,"_3543":61522},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_4098":1482,"_34307":1264,"_23429":61524,"_5":16198,"_30870":60956,"_3543":61525},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_4098":1483,"_34307":1264,"_23429":61527,"_5":16198,"_30870":60956,"_3543":61528},[],"Status in Lamassu",{"_4098":1484,"_34307":1264,"_23429":61530,"_5":16198,"_30870":60956,"_3543":61531},[],"Revocation reason",{"_4098":1485,"_34307":1264,"_23429":61533,"_5":16198,"_30870":60956,"_3543":61534},[],"Status in AWS IoT Core",{"_4098":1486,"_34307":1264,"_23429":61536,"_5":16198,"_30870":60956,"_3543":61537},[],"`Active`",{"_4098":1487,"_34307":1264,"_23429":61539,"_5":16198,"_30870":60956,"_3543":61540},[],"None",{"_4098":1488,"_34307":1264,"_23429":61542,"_5":16198,"_30870":60956,"_3543":61543},[],"`ACTIVE`",{"_4098":1489,"_34307":1264,"_23429":61545,"_5":16198,"_30870":60956,"_3543":61546},[],"`Revoked`",{"_4098":1490,"_34307":1264,"_23429":61548,"_5":16198,"_30870":60956,"_3543":61549},[],"`certificateHold`",{"_4098":1491,"_34307":1264,"_23429":61551,"_5":16198,"_30870":60956,"_3543":61552},[],"`INACTIVE`",{"_4098":1492,"_34307":1264,"_23429":61554,"_5":16198,"_30870":60956,"_3543":61546},[],{"_4098":1493,"_34307":1264,"_23429":61556,"_5":16198,"_30870":60956,"_3543":61557},[],"Any other reason",{"_4098":1494,"_34307":1264,"_23429":61559,"_5":16198,"_30870":60956,"_3543":61560},[],"`REVOKED`",{"_4098":1495,"_34307":1264,"_23429":61562,"_5":16198,"_30870":60956,"_3543":61563},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_4098":1496,"_34307":1264,"_23429":61565,"_5":16198,"_30870":60960,"_3543":61566},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_4098":1497,"_34307":1264,"_23429":61568,"_5":16198,"_30870":60960,"_3543":61341},[],{"_4098":1498,"_34307":1264,"_23429":61570,"_5":16198,"_30870":60960,"_3543":61344},[],{"_4098":1499,"_34307":1264,"_23429":61572,"_5":16198,"_30870":60960,"_3543":61573},[],"`NotSynced` → `Active`",{"_4098":1500,"_34307":1264,"_23429":61575,"_5":16198,"_30870":60960,"_3543":61052},[],{"_4098":1501,"_34307":1264,"_23429":61577,"_5":16198,"_30870":60960,"_3543":61578},[],"`Active` → `Inactive`",{"_4098":1502,"_34307":1264,"_23429":61580,"_5":16198,"_30870":60960,"_3543":61581},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_4098":1503,"_34307":1264,"_23429":61583,"_5":16198,"_30870":60960,"_3543":61584},[],"`Active` → `Revoked`",{"_4098":1504,"_34307":1264,"_23429":61586,"_5":16198,"_30870":60960,"_3543":61581},[],{"_4098":1505,"_34307":1264,"_23429":61588,"_5":16198,"_30870":60960,"_3543":61589},[],"`Inactive` / `Revoked` → `Active`",{"_4098":1506,"_34307":1264,"_23429":61591,"_5":16198,"_30870":60960,"_3543":61052},[],{"_4098":1507,"_34307":1264,"_23429":61593,"_5":16198,"_30870":60960,"_3543":61594},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_4098":1508,"_34307":1264,"_23429":61596,"_5":16198,"_30870":60960,"_3543":61597},[],"none (these states are not synced to AWS)",{"_4098":1509,"_34307":1264,"_23429":61599,"_5":16198,"_30870":60964,"_3543":61600},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_4098":1510,"_34307":1264,"_23429":61602,"_5":16198,"_30870":60964,"_3543":61603},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_4098":1511,"_34307":1264,"_23429":61605,"_5":16198,"_30870":60964,"_3543":61606},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_4098":1512,"_34307":1264,"_23429":61608,"_5":16198,"_30870":60968,"_3543":61609},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_4098":1513,"_34307":1264,"_23429":61611,"_5":16198,"_30870":60968,"_3543":61612},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_4098":1514,"_34307":1264,"_23429":61614,"_5":16198,"_30870":60972,"_3543":61615},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_4098":1515,"_34307":1264,"_23429":61617,"_5":16198,"_30870":60972,"_3543":61618},[],"There are two action types:",{"_4098":1516,"_34307":1264,"_23429":61620,"_5":16198,"_30870":60972,"_3543":61621},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_4098":1517,"_34307":1264,"_23429":61623,"_5":16198,"_30870":60972,"_3543":61624},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_4098":1518,"_34307":1264,"_23429":61626,"_5":16198,"_30870":60972,"_3543":61627},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_4098":1519,"_34307":1264,"_23429":61629,"_5":16198,"_30870":60976,"_3543":61630},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_4098":1520,"_34307":1264,"_23429":61632,"_5":16198,"_30870":60976,"_3543":61633},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_4098":1521,"_34307":1264,"_23429":61635,"_5":16198,"_30870":60976,"_3543":61636},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_4098":1522,"_34307":1264,"_23429":61638,"_5":16198,"_30870":60980,"_3543":61639},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_4098":1523,"_34307":1264,"_23429":61641,"_5":16198,"_30870":60980,"_3543":61642},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_4098":1524,"_34307":1264,"_23429":61644,"_5":16198,"_30870":60980,"_3543":61645},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_4098":1525,"_34307":1264,"_23429":61647,"_5":16198,"_30870":60980,"_3543":61648},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_4098":1526,"_34307":1264,"_23429":61650,"_5":16198,"_30870":60980,"_3543":61651},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_4098":1527,"_34307":1264,"_23429":61653,"_5":16198,"_30870":60980,"_3543":61654},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_4098":1528,"_34307":1264,"_23429":61656,"_5":16198,"_30870":60980,"_3543":61657},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_4098":1529,"_34307":1264,"_23429":61659,"_5":16198,"_30870":60980,"_3543":61660},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_4098":1530,"_34307":1264,"_23429":61662,"_5":16198,"_30870":60980,"_3543":61663},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_4098":1531,"_34307":1264,"_23429":61665,"_5":16198,"_30870":60980,"_3543":61666},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_4098":1532,"_34307":1264,"_23429":61668,"_5":16198,"_30870":60980,"_3543":61669},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_4098":1533,"_34307":1264,"_23429":61671,"_5":16198,"_30870":60980,"_3543":61672},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_4098":1534,"_34307":1264,"_23429":61674,"_5":16198,"_30870":60980,"_3543":61675},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_4098":1535,"_34307":1264,"_23429":61677,"_5":16198,"_30870":60980,"_3543":61678},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_4098":1536,"_34307":1264,"_23429":61680,"_5":16198,"_30870":60980,"_3543":61681},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_4098":1537,"_34307":1264,"_23429":61683,"_5":16198,"_30870":60980,"_3543":61684},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_4098":1538,"_34307":1264,"_23429":61686,"_5":16198,"_30870":60980,"_3543":61687},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_4098":1539,"_34307":1264,"_23429":61689,"_5":16198,"_30870":60980,"_3543":61690},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_4098":1540,"_34307":1264,"_23429":61692,"_5":16198,"_30870":60980,"_3543":61693},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_4098":1541,"_34307":1264,"_23429":61695,"_5":16198,"_30870":60980,"_3543":61696},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_4098":1542,"_34307":1264,"_23429":61698,"_5":16198,"_30870":60980,"_3543":61699},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_4098":1543,"_34307":1264,"_23429":61701,"_5":16198,"_30870":60980,"_3543":61702},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_4098":1544,"_34307":1264,"_23429":61704,"_5":16198,"_30870":60980,"_3543":61705},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_4098":1545,"_34307":1264,"_23429":61707,"_5":16198,"_30870":60980,"_3543":61708},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_4098":1546,"_34307":1546,"_5":16596,"_3543":59415,"_34738":61710,"_23429":61711,"_30870":1546},[56936,58404,59415],[],{"_4098":1547,"_34307":1546,"_23429":61713,"_5":16198,"_30870":1546,"_3543":61714},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_4098":1548,"_34307":1546,"_5":34735,"_23429":61716,"_30870":61717,"_3543":61718},[],"/docs/pr-preview/pr-58/platform/iot-fleets/overview#start-here","Start here",{"_4098":1549,"_34307":1546,"_5":34735,"_23429":61720,"_30870":61721,"_3543":59413},[],"/docs/pr-preview/pr-58/platform/iot-fleets/overview#devices-and-identities",{"_4098":1550,"_34307":1546,"_5":34735,"_23429":61723,"_30870":61724,"_3543":59596},[],"/docs/pr-preview/pr-58/platform/iot-fleets/overview#enrollment-with-pki",{"_4098":1551,"_34307":1546,"_5":34735,"_23429":61726,"_30870":61727,"_3543":60877},[],"/docs/pr-preview/pr-58/platform/iot-fleets/overview#integrations",{"_4098":1552,"_34307":1546,"_5":34735,"_23429":61729,"_30870":61730,"_3543":61731},[],"/docs/pr-preview/pr-58/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_4098":1553,"_34307":1546,"_23429":61733,"_5":16198,"_30870":1546,"_3543":61734},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_4098":1554,"_34307":1546,"_23429":61736,"_5":16198,"_30870":61717,"_3543":61737},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_4098":1555,"_34307":1546,"_23429":61739,"_5":16198,"_30870":61717,"_3543":61740},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_4098":1556,"_34307":1546,"_23429":61742,"_5":16198,"_30870":61721,"_3543":61743},[],"Resource",{"_4098":1557,"_34307":1546,"_23429":61745,"_5":16198,"_30870":61721,"_3543":61746},[],"What it represents",{"_4098":1558,"_34307":1546,"_23429":61748,"_5":16198,"_30870":61721,"_3543":61749},[],"**Device**",{"_4098":1559,"_34307":1546,"_23429":61751,"_5":16198,"_30870":61721,"_3543":61752},[],"An inventory entry with an identifier, owning DMS and classification.",{"_4098":1560,"_34307":1546,"_23429":61754,"_5":16198,"_30870":61721,"_3543":61755},[],"**Identity**",{"_4098":1561,"_34307":1546,"_23429":61757,"_5":16198,"_30870":61721,"_3543":61758},[],"The device's association with its certificates: an active version and a history.",{"_4098":1562,"_34307":1546,"_23429":61760,"_5":16198,"_30870":61721,"_3543":61761},[],"**DMS**",{"_4098":1563,"_34307":1546,"_23429":61763,"_5":16198,"_30870":61721,"_3543":61764},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_4098":1564,"_34307":1546,"_23429":61766,"_5":16198,"_30870":61721,"_3543":61767},[],"**Fleet**",{"_4098":1565,"_34307":1546,"_23429":61769,"_5":16198,"_30870":61721,"_3543":61770},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_4098":1566,"_34307":1546,"_23429":61772,"_5":16198,"_30870":61721,"_3543":61773},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_4098":1567,"_34307":1546,"_23429":61775,"_5":16198,"_30870":61721,"_3543":61776},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_4098":1568,"_34307":1546,"_23429":61778,"_5":16198,"_30870":61724,"_3543":61779},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_4098":1569,"_34307":1546,"_23429":61781,"_5":16198,"_30870":61724,"_3543":61782},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_4098":1570,"_34307":1546,"_23429":61784,"_5":16198,"_30870":61724,"_3543":61785},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_4098":1571,"_34307":1546,"_23429":61787,"_5":16198,"_30870":61724,"_3543":61788},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_4098":1572,"_34307":1546,"_23429":61790,"_5":16198,"_30870":61724,"_3543":61791},[],"**Result:** request the certificate, install it and check its association with the device.",{"_4098":1573,"_34307":1546,"_23429":61793,"_5":16198,"_30870":61724,"_3543":61794},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_4098":1574,"_34307":1546,"_23429":61796,"_5":16198,"_30870":61724,"_3543":61797},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_4098":1575,"_34307":1546,"_23429":61799,"_5":16198,"_30870":61724,"_3543":61800},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_4098":1576,"_34307":1546,"_23429":61802,"_5":16198,"_30870":61727,"_3543":61803},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_4098":1577,"_34307":1546,"_23429":61805,"_5":16198,"_30870":61727,"_3543":61806},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_4098":1578,"_34307":1546,"_23429":61808,"_5":16198,"_30870":61730,"_3543":61809},[],"Participant",{"_4098":1579,"_34307":1546,"_23429":61811,"_5":16198,"_30870":61730,"_3543":61812},[],"Responsibility",{"_4098":1580,"_34307":1546,"_23429":61814,"_5":16198,"_30870":61730,"_3543":61815},[],"PKI administrator",{"_4098":1581,"_34307":1546,"_23429":61817,"_5":16198,"_30870":61730,"_3543":61818},[],"CA, issuance profile, chain and revocation publication.",{"_4098":1582,"_34307":1546,"_23429":61820,"_5":16198,"_30870":61730,"_3543":61821},[],"Provisioning administrator",{"_4098":1583,"_34307":1546,"_23429":61823,"_5":16198,"_30870":61730,"_3543":61824},[],"DMS, admission, authentication per operation and inventory.",{"_4098":1584,"_34307":1546,"_23429":61826,"_5":16198,"_30870":61730,"_3543":61827},[],"Device integrator",{"_4098":1585,"_34307":1546,"_23429":61829,"_5":16198,"_30870":61730,"_3543":61830},[],"Initial credential, key, EST client, trust and certificate installation.",{"_4098":1586,"_34307":1546,"_23429":61832,"_5":16198,"_30870":61730,"_3543":61833},[],"Consumer integrator",{"_4098":1587,"_34307":1546,"_23429":61835,"_5":16198,"_30870":61730,"_3543":61836},[],"Trusted issuers, validation and device permissions in the destination.",{"_4098":1588,"_34307":1546,"_23429":61838,"_5":16198,"_30870":61730,"_3543":61839},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_4098":1589,"_34307":1589,"_5":16596,"_3543":61841,"_34738":61842,"_23429":61844,"_30870":1589},"Enroll and connect your first device",[56936,58404,59415,61843],"Getting started",[],{"_4098":1590,"_34307":1589,"_23429":61846,"_5":16198,"_30870":1589,"_3543":61847},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_4098":1591,"_34307":1589,"_5":34735,"_23429":61849,"_30870":61850,"_3543":56946},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_4098":1592,"_34307":1589,"_5":34735,"_23429":61852,"_30870":61853,"_3543":61854},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_4098":1593,"_34307":1589,"_5":34735,"_23429":61856,"_30870":61857,"_3543":61858},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_4098":1594,"_34307":1589,"_5":34735,"_23429":61860,"_30870":61861,"_3543":61862},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_4098":1595,"_34307":1589,"_5":34735,"_23429":61864,"_30870":61865,"_3543":61866},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_4098":1596,"_34307":1589,"_5":34735,"_23429":61868,"_30870":61869,"_3543":61870},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_4098":1597,"_34307":1589,"_5":34735,"_23429":61872,"_30870":61873,"_3543":61874},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_4098":1598,"_34307":1589,"_5":34735,"_23429":61876,"_30870":61877,"_3543":61878},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_4098":1599,"_34307":1589,"_23429":61880,"_5":16198,"_30870":1589,"_3543":61881},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_4098":1600,"_34307":1589,"_23429":61883,"_5":16198,"_30870":61850,"_3543":61884},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_4098":1601,"_34307":1589,"_23429":61886,"_5":16198,"_30870":61850,"_3543":61887},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_4098":1602,"_34307":1589,"_23429":61889,"_5":16198,"_30870":61850,"_3543":61890},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_4098":1603,"_34307":1589,"_23429":61892,"_5":16198,"_30870":61850,"_3543":61893},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_4098":1604,"_34307":1589,"_23429":61895,"_5":16198,"_30870":61850,"_3543":61896},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_4098":1605,"_34307":1589,"_23429":61898,"_5":16198,"_30870":61853,"_3543":61899},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_4098":1606,"_34307":1589,"_23429":61901,"_5":16198,"_30870":61853,"_3543":61902},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_4098":1607,"_34307":1589,"_23429":61904,"_5":16198,"_30870":61857,"_3543":61905},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_4098":1608,"_34307":1589,"_23429":61907,"_5":16198,"_30870":61857,"_3543":61908},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_4098":1609,"_34307":1589,"_23429":61910,"_5":16198,"_30870":61857,"_3543":61911},[],"Setting",{"_4098":1610,"_34307":1589,"_23429":61913,"_5":16198,"_30870":61857,"_3543":61914},[],"Evaluation value",{"_4098":1611,"_34307":1589,"_23429":61916,"_5":16198,"_30870":61857,"_3543":61917},[],"Enrollment CA",{"_4098":1612,"_34307":1589,"_23429":61919,"_5":16198,"_30870":61857,"_3543":61920},[],"Issuing root from `device-root.pem`.",{"_4098":1613,"_34307":1589,"_23429":61922,"_5":16198,"_30870":61857,"_3543":59726},[],{"_4098":1614,"_34307":1589,"_23429":61924,"_5":16198,"_30870":61857,"_3543":61925},[],"The 1-hour leaf profile you just prepared.",{"_4098":1615,"_34307":1589,"_23429":61927,"_5":16198,"_30870":61857,"_3543":61928},[],"Protocol / Registration Mode",{"_4098":1616,"_34307":1589,"_23429":61930,"_5":16198,"_30870":61857,"_3543":61931},[],"`EST_RFC7030` / `JITP`.",{"_4098":1617,"_34307":1589,"_23429":61933,"_5":16198,"_30870":61857,"_3543":61934},[],"Verify CSR Signature",{"_4098":1618,"_34307":1589,"_23429":61936,"_5":16198,"_30870":61857,"_3543":61937},[],"Enabled.",{"_4098":1619,"_34307":1589,"_23429":61939,"_5":16198,"_30870":61857,"_3543":61940},[],"Enable Replaceable Enrollment",{"_4098":1620,"_34307":1589,"_23429":61942,"_5":16198,"_30870":61857,"_3543":61943},[],"Disabled; the ID must be new.",{"_4098":1621,"_34307":1589,"_23429":61945,"_5":16198,"_30870":61857,"_3543":61946},[],"Initial authentication",{"_4098":1622,"_34307":1589,"_23429":61948,"_5":16198,"_30870":61857,"_3543":61949},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_4098":1623,"_34307":1589,"_23429":61951,"_5":16198,"_30870":61857,"_3543":61952},[],"Renewal authentication",{"_4098":1624,"_34307":1589,"_23429":61954,"_5":16198,"_30870":61857,"_3543":61955},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_4098":1625,"_34307":1589,"_23429":61957,"_5":16198,"_30870":61857,"_3543":61958},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_4098":1626,"_34307":1589,"_23429":61960,"_5":16198,"_30870":61857,"_3543":61961},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_4098":1627,"_34307":1589,"_23429":61963,"_5":16198,"_30870":61857,"_3543":61964},[],"Re-enrollment Delta",{"_4098":1628,"_34307":1589,"_23429":61966,"_5":16198,"_30870":61857,"_3543":61967},[],"1 hour.",{"_4098":1629,"_34307":1589,"_23429":61969,"_5":16198,"_30870":61857,"_3543":61970},[],"Preventive / Critical Delta",{"_4098":1630,"_34307":1589,"_23429":61972,"_5":16198,"_30870":61857,"_3543":61973},[],"30 minutes / 10 minutes.",{"_4098":1631,"_34307":1589,"_23429":61975,"_5":16198,"_30870":61857,"_3543":61976},[],"Revoke on Re-enrollment",{"_4098":1632,"_34307":1589,"_23429":61978,"_5":16198,"_30870":61857,"_3543":61979},[],"Disabled to test the successor before retiring the previous identity.",{"_4098":1633,"_34307":1589,"_23429":61981,"_5":16198,"_30870":61857,"_3543":59734},[],{"_4098":1634,"_34307":1589,"_23429":61983,"_5":16198,"_30870":61857,"_3543":61984},[],"Disabled; the operational key is generated in the client.",{"_4098":1635,"_34307":1589,"_23429":61986,"_5":16198,"_30870":61857,"_3543":61987},[],"CA Distribution",{"_4098":1636,"_34307":1589,"_23429":61989,"_5":16198,"_30870":61857,"_3543":61990},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_4098":1637,"_34307":1589,"_23429":61992,"_5":16198,"_30870":61857,"_3543":61993},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_4098":1638,"_34307":1589,"_23429":61995,"_5":16198,"_30870":61861,"_3543":61996},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_4098":1639,"_34307":1589,"_23429":61998,"_5":16198,"_30870":61861,"_3543":61999},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_4098":1640,"_34307":1589,"_23429":62001,"_5":16198,"_30870":61865,"_3543":62002},[],"Generate a new key and CSR with the selected identifier:",{"_4098":1641,"_34307":1589,"_23429":62004,"_5":16198,"_30870":61865,"_3543":62005},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_4098":1642,"_34307":1589,"_23429":62007,"_5":16198,"_30870":61865,"_3543":62008},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_4098":1643,"_34307":1589,"_23429":62010,"_5":16198,"_30870":61869,"_3543":62011},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_4098":1644,"_34307":1589,"_23429":62013,"_5":16198,"_30870":61869,"_3543":62014},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_4098":1645,"_34307":1589,"_23429":62016,"_5":16198,"_30870":61873,"_3543":62017},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_4098":1646,"_34307":1589,"_23429":62019,"_5":16198,"_30870":61873,"_3543":62020},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_4098":1647,"_34307":1589,"_23429":62022,"_5":16198,"_30870":61873,"_3543":62023},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_4098":1648,"_34307":1589,"_23429":62025,"_5":16198,"_30870":61873,"_3543":62026},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_4098":1649,"_34307":1589,"_23429":62028,"_5":16198,"_30870":61873,"_3543":62029},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_4098":1650,"_34307":1589,"_23429":62031,"_5":16198,"_30870":61877,"_3543":62032},[],"Check",{"_4098":1651,"_34307":1589,"_23429":62034,"_5":16198,"_30870":61877,"_3543":62035},[],"Expected result",{"_4098":1652,"_34307":1589,"_23429":62037,"_5":16198,"_30870":61877,"_3543":62038},[],"Registration",{"_4098":1653,"_34307":1589,"_23429":62040,"_5":16198,"_30870":61877,"_3543":62041},[],"ID created automatically and correct DMS.",{"_4098":1654,"_34307":1589,"_23429":62043,"_5":16198,"_30870":61877,"_3543":61299},[],{"_4098":1655,"_34307":1589,"_23429":62045,"_5":16198,"_30870":61877,"_3543":62046},[],"CN, profile, serial and key verified.",{"_4098":1656,"_34307":1589,"_23429":62048,"_5":16198,"_30870":61877,"_3543":62049},[],"Inventory",{"_4098":1657,"_34307":1589,"_23429":62051,"_5":16198,"_30870":61877,"_3543":62052},[],"Received serial visible as the current identity and in history.",{"_4098":1658,"_34307":1589,"_23429":62054,"_5":16198,"_30870":61877,"_3543":62055},[],"Consumer",{"_4098":1659,"_34307":1589,"_23429":62057,"_5":16198,"_30870":61877,"_3543":62058},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_4098":1660,"_34307":1589,"_23429":62060,"_5":16198,"_30870":61877,"_3543":62061},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_4098":1661,"_34307":1589,"_23429":62063,"_5":16198,"_30870":61877,"_3543":62064},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_4098":1662,"_34307":1662,"_5":16596,"_3543":59431,"_34738":62066,"_23429":62067,"_30870":1662},[56936,58404,59415,61843],[],{"_4098":1663,"_34307":1662,"_23429":62069,"_5":16198,"_30870":1662,"_3543":62070},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_4098":1664,"_34307":1662,"_5":34735,"_23429":62072,"_30870":62073,"_3543":56946},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_4098":1665,"_34307":1662,"_5":34735,"_23429":62075,"_30870":62076,"_3543":62077},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_4098":1666,"_34307":1662,"_5":34735,"_23429":62079,"_30870":62080,"_3543":62081},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_4098":1667,"_34307":1662,"_5":34735,"_23429":62083,"_30870":62084,"_3543":62085},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_4098":1668,"_34307":1662,"_5":34735,"_23429":62087,"_30870":62088,"_3543":62089},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_4098":1669,"_34307":1662,"_5":34735,"_23429":62091,"_30870":62092,"_3543":62093},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_4098":1670,"_34307":1662,"_5":34735,"_23429":62095,"_30870":62096,"_3543":62035},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#expected-result",{"_4098":1671,"_34307":1662,"_5":34735,"_23429":62098,"_30870":62099,"_3543":62100},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_4098":1672,"_34307":1662,"_5":34735,"_23429":62102,"_30870":62103,"_3543":62104},[],"/docs/pr-preview/pr-58/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_4098":1673,"_34307":1662,"_23429":62106,"_5":16198,"_30870":1662,"_3543":62107},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_4098":1674,"_34307":1662,"_23429":62109,"_5":16198,"_30870":1662,"_3543":62110},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_4098":1675,"_34307":1662,"_23429":62112,"_5":16198,"_30870":62073,"_3543":62113},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_4098":1676,"_34307":1662,"_23429":62115,"_5":16198,"_30870":62073,"_3543":62116},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_4098":1677,"_34307":1662,"_23429":62118,"_5":16198,"_30870":62073,"_3543":62119},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_4098":1678,"_34307":1662,"_23429":62121,"_5":16198,"_30870":62073,"_3543":62122},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_4098":1679,"_34307":1662,"_23429":62124,"_5":16198,"_30870":62076,"_3543":62125},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_4098":1680,"_34307":1662,"_23429":62127,"_5":16198,"_30870":62076,"_3543":62128},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_4098":1681,"_34307":1662,"_23429":62130,"_5":16198,"_30870":62076,"_3543":62131},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_4098":1682,"_34307":1662,"_23429":62133,"_5":16198,"_30870":62076,"_3543":62134},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_4098":1683,"_34307":1662,"_23429":62136,"_5":16198,"_30870":62076,"_3543":62137},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_4098":1684,"_34307":1662,"_23429":62139,"_5":16198,"_30870":62076,"_3543":62140},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_4098":1685,"_34307":1662,"_23429":62142,"_5":16198,"_30870":62076,"_3543":62143},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_4098":1686,"_34307":1662,"_23429":62145,"_5":16198,"_30870":62076,"_3543":62146},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_4098":1687,"_34307":1662,"_23429":62148,"_5":16198,"_30870":62080,"_3543":62149},[],"Open **Managed Devices** and the registration action. Complete:",{"_4098":1688,"_34307":1662,"_23429":62151,"_5":16198,"_30870":62080,"_3543":62152},[],"**Device ID**: `device-001`.",{"_4098":1689,"_34307":1662,"_23429":62154,"_5":16198,"_30870":62080,"_3543":62155},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_4098":1690,"_34307":1662,"_23429":62157,"_5":16198,"_30870":62080,"_3543":62158},[],"**Icon** and **Tags**: optional classification.",{"_4098":1691,"_34307":1662,"_23429":62160,"_5":16198,"_30870":62080,"_3543":62161},[],"Confirm registration.",{"_4098":1692,"_34307":1662,"_23429":62163,"_5":16198,"_30870":62084,"_3543":62164},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_4098":1693,"_34307":1662,"_23429":62166,"_5":16198,"_30870":62084,"_3543":62167},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_4098":1694,"_34307":1662,"_23429":62169,"_5":16198,"_30870":62088,"_3543":62170},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_4098":1695,"_34307":1662,"_23429":62172,"_5":16198,"_30870":62088,"_3543":62173},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_4098":1696,"_34307":1662,"_23429":62175,"_5":16198,"_30870":62092,"_3543":62176},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_4098":1697,"_34307":1662,"_23429":62178,"_5":16198,"_30870":62092,"_3543":62179},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_4098":1698,"_34307":1662,"_23429":62181,"_5":16198,"_30870":62096,"_3543":62032},[],{"_4098":1699,"_34307":1662,"_23429":62183,"_5":16198,"_30870":62096,"_3543":62184},[],"Result",{"_4098":1700,"_34307":1662,"_23429":62186,"_5":16198,"_30870":62096,"_3543":61282},[],{"_4098":1701,"_34307":1662,"_23429":62188,"_5":16198,"_30870":62096,"_3543":62189},[],"`device-001` appears in inventory with the expected DMS.",{"_4098":1702,"_34307":1662,"_23429":62191,"_5":16198,"_30870":62096,"_3543":62192},[],"Current identity",{"_4098":1703,"_34307":1662,"_23429":62194,"_5":16198,"_30870":62096,"_3543":62195},[],"The associated certificate matches the one you verified in PKI.",{"_4098":1704,"_34307":1662,"_23429":62197,"_5":16198,"_30870":62096,"_3543":62198},[],"History",{"_4098":1705,"_34307":1662,"_23429":62200,"_5":16198,"_30870":62096,"_3543":62201},[],"The associated issuance appears with its serial number and dates.",{"_4098":1706,"_34307":1662,"_23429":62203,"_5":16198,"_30870":62096,"_3543":62204},[],"Key and certificate",{"_4098":1707,"_34307":1662,"_23429":62206,"_5":16198,"_30870":62096,"_3543":62207},[],"You have the verified pair ready to install on the device.",{"_4098":1708,"_34307":1662,"_23429":62209,"_5":16198,"_30870":62099,"_3543":62210},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_4098":1709,"_34307":1662,"_23429":62212,"_5":16198,"_30870":62099,"_3543":62213},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_4098":1710,"_34307":1662,"_23429":62215,"_5":16198,"_30870":62099,"_3543":62216},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_4098":1711,"_34307":1662,"_23429":62218,"_5":16198,"_30870":62099,"_3543":62219},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_4098":1712,"_34307":1662,"_23429":62221,"_5":16198,"_30870":62103,"_3543":62222},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_4098":1713,"_34307":1662,"_23429":62224,"_5":16198,"_30870":62103,"_3543":62225},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_4098":1714,"_34307":1662,"_23429":62227,"_5":16198,"_30870":62103,"_3543":62228},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_4098":1715,"_34307":1715,"_5":16596,"_3543":62230,"_34738":62231,"_23429":62232,"_30870":1715},"Lamassu IoT Platform",[56936,58404],[],{"_4098":1716,"_34307":1715,"_23429":62234,"_5":16198,"_30870":1715,"_3543":62235},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_4098":1717,"_34307":1715,"_5":34735,"_23429":62237,"_30870":62238,"_3543":61718},[],"/docs/pr-preview/pr-58/platform/overview#start-here",{"_4098":1718,"_34307":1715,"_5":34735,"_23429":62240,"_30870":62241,"_3543":62242},[],"/docs/pr-preview/pr-58/platform/overview#choose-your-path","Choose your path",{"_4098":1719,"_34307":1715,"_5":34735,"_23429":62244,"_30870":62245,"_3543":62246},[],"/docs/pr-preview/pr-58/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_4098":1720,"_34307":1715,"_5":34735,"_23429":62248,"_30870":62249,"_3543":62250},[],"/docs/pr-preview/pr-58/platform/overview#core-capabilities","Core capabilities",{"_4098":1721,"_34307":1715,"_5":34735,"_23429":62252,"_30870":62253,"_3543":62254},[],"/docs/pr-preview/pr-58/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_4098":1722,"_34307":1715,"_5":34735,"_23429":62256,"_30870":62257,"_3543":62258},[],"/docs/pr-preview/pr-58/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_4098":1723,"_34307":1715,"_5":34735,"_23429":62260,"_30870":62261,"_3543":62262},[],"/docs/pr-preview/pr-58/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_4098":1724,"_34307":1715,"_5":34735,"_23429":62264,"_30870":62265,"_3543":62266},[],"/docs/pr-preview/pr-58/platform/overview#automate-device-identities","Automate device identities",{"_4098":1725,"_34307":1715,"_5":34735,"_23429":62268,"_30870":62269,"_3543":62270},[],"/docs/pr-preview/pr-58/platform/overview#publish-validation-status","Publish validation status",{"_4098":1726,"_34307":1715,"_5":34735,"_23429":62272,"_30870":62273,"_3543":62274},[],"/docs/pr-preview/pr-58/platform/overview#react-to-events","React to events",{"_4098":1727,"_34307":1715,"_5":34735,"_23429":62276,"_30870":62277,"_3543":62278},[],"/docs/pr-preview/pr-58/platform/overview#operational-reference","Operational reference",{"_4098":1728,"_34307":1715,"_23429":62280,"_5":16198,"_30870":1715,"_3543":62281},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_4098":1729,"_34307":1715,"_23429":62283,"_5":16198,"_30870":62238,"_3543":62284},[],"Choose the result you need:",{"_4098":1730,"_34307":1715,"_23429":62286,"_5":16198,"_30870":62238,"_3543":62287},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_4098":1731,"_34307":1715,"_23429":62289,"_5":16198,"_30870":62238,"_3543":62290},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_4098":1732,"_34307":1715,"_23429":62292,"_5":16198,"_30870":62238,"_3543":62293},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_4098":1733,"_34307":1715,"_23429":62295,"_5":16198,"_30870":62241,"_3543":62296},[],"Section",{"_4098":1734,"_34307":1715,"_23429":62298,"_5":16198,"_30870":62241,"_3543":62299},[],"What you manage",{"_4098":1735,"_34307":1715,"_23429":62301,"_5":16198,"_30870":62241,"_3543":62302},[],"Entry point",{"_4098":1736,"_34307":1715,"_23429":62304,"_5":16198,"_30870":62241,"_3543":62305},[],"**PKI**",{"_4098":1737,"_34307":1715,"_23429":62307,"_5":16198,"_30870":62241,"_3543":62308},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_4098":1738,"_34307":1715,"_23429":62310,"_5":16198,"_30870":62241,"_3543":62311},[],"PKI overview",{"_4098":1739,"_34307":1715,"_23429":62313,"_5":16198,"_30870":62241,"_3543":62314},[],"**IoT Fleets**",{"_4098":1740,"_34307":1715,"_23429":62316,"_5":16198,"_30870":62241,"_3543":62317},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_4098":1741,"_34307":1715,"_23429":62319,"_5":16198,"_30870":62241,"_3543":62320},[],"IoT Fleets overview",{"_4098":1742,"_34307":1715,"_23429":62322,"_5":16198,"_30870":62241,"_3543":62323},[],"**Administration**",{"_4098":1743,"_34307":1715,"_23429":62325,"_5":16198,"_30870":62241,"_3543":62326},[],"Operator permissions, audit and event subscriptions.",{"_4098":1744,"_34307":1715,"_23429":62328,"_5":16198,"_30870":62241,"_3543":58402},[],{"_4098":1745,"_34307":1715,"_23429":62330,"_5":16198,"_30870":62241,"_3543":62331},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_4098":1746,"_34307":1715,"_23429":62333,"_5":16198,"_30870":62245,"_3543":62334},[],"An identity's journey connects four responsibilities:",{"_4098":1747,"_34307":1715,"_23429":62336,"_5":16198,"_30870":62245,"_3543":62337},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_4098":1748,"_34307":1715,"_23429":62339,"_5":16198,"_30870":62245,"_3543":62340},[],"The provisioning administrator configures the DMS and initial trust.",{"_4098":1749,"_34307":1715,"_23429":62342,"_5":16198,"_30870":62245,"_3543":62343},[],"The device client requests a certificate and installs it with the matching key.",{"_4098":1750,"_34307":1715,"_23429":62345,"_5":16198,"_30870":62245,"_3543":62346},[],"The consumer validates the identity and applies its access permissions.",{"_4098":1751,"_34307":1715,"_23429":62348,"_5":16198,"_30870":62245,"_3543":62349},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_4098":1752,"_34307":1715,"_23429":62351,"_5":16198,"_30870":62253,"_3543":62352},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_4098":1753,"_34307":1715,"_23429":62354,"_5":16198,"_30870":62257,"_3543":62355},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_4098":1754,"_34307":1715,"_23429":62357,"_5":16198,"_30870":62261,"_3543":62358},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_4098":1755,"_34307":1715,"_23429":62360,"_5":16198,"_30870":62265,"_3543":62361},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_4098":1756,"_34307":1715,"_23429":62363,"_5":16198,"_30870":62269,"_3543":62364},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_4098":1757,"_34307":1715,"_23429":62366,"_5":16198,"_30870":62273,"_3543":62367},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_4098":1758,"_34307":1715,"_23429":62369,"_5":16198,"_30870":62277,"_3543":61812},[],{"_4098":1759,"_34307":1715,"_23429":62371,"_5":16198,"_30870":62277,"_3543":62372},[],"What it prepares or checks",{"_4098":1760,"_34307":1715,"_23429":62374,"_5":16198,"_30870":62277,"_3543":61815},[],{"_4098":1761,"_34307":1715,"_23429":62376,"_5":16198,"_30870":62277,"_3543":62377},[],"Key custody, CA hierarchy, profiles and validation.",{"_4098":1762,"_34307":1715,"_23429":62379,"_5":16198,"_30870":62277,"_3543":62380},[],"Fleet administrator",{"_4098":1763,"_34307":1715,"_23429":62382,"_5":16198,"_30870":62277,"_3543":62383},[],"DMS, device admission, renewal policy and inventory.",{"_4098":1764,"_34307":1715,"_23429":62385,"_5":16198,"_30870":62277,"_3543":61827},[],{"_4098":1765,"_34307":1715,"_23429":62387,"_5":16198,"_30870":62277,"_3543":62388},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_4098":1766,"_34307":1715,"_23429":62390,"_5":16198,"_30870":62277,"_3543":61833},[],{"_4098":1767,"_34307":1715,"_23429":62392,"_5":16198,"_30870":62277,"_3543":62393},[],"Issuer trust, certificate validation and permissions in the destination.",{"_4098":1768,"_34307":1715,"_23429":62395,"_5":16198,"_30870":62277,"_3543":62396},[],"Infrastructure operator",{"_4098":1769,"_34307":1715,"_23429":62398,"_5":16198,"_30870":62277,"_3543":62399},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_4098":1770,"_34307":1715,"_23429":62401,"_5":16198,"_30870":62277,"_3543":62402},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_4098":1771,"_34307":1771,"_5":16596,"_3543":62404,"_34738":62405,"_23429":62408,"_30870":1771},"CA hierarchy and rotation",[56936,58404,62406,62407],"PKI","Keys, authorities and certificates",[],{"_4098":1772,"_34307":1771,"_23429":62410,"_5":16198,"_30870":1771,"_3543":62411},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_4098":1773,"_34307":1771,"_5":34735,"_23429":62413,"_30870":62414,"_3543":62415},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_4098":1774,"_34307":1771,"_5":34735,"_23429":62417,"_30870":62418,"_3543":62419},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_4098":1775,"_34307":1771,"_5":34735,"_23429":62421,"_30870":62422,"_3543":62423},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_4098":1776,"_34307":1771,"_5":34735,"_23429":62425,"_30870":62426,"_3543":62427},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_4098":1777,"_34307":1771,"_5":34735,"_23429":62429,"_30870":62430,"_3543":62431},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_4098":1778,"_34307":1771,"_5":34735,"_23429":62433,"_30870":62434,"_3543":62435},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_4098":1779,"_34307":1771,"_5":34735,"_23429":62437,"_30870":62438,"_3543":62439},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_4098":1780,"_34307":1771,"_5":34735,"_23429":62441,"_30870":62442,"_3543":62443},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_4098":1781,"_34307":1771,"_5":34735,"_23429":62445,"_30870":62446,"_3543":62447},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_4098":1782,"_34307":1771,"_5":34735,"_23429":62449,"_30870":62450,"_3543":62451},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_4098":1783,"_34307":1771,"_5":34735,"_23429":62453,"_30870":62454,"_3543":62455},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_4098":1784,"_34307":1771,"_5":34735,"_23429":62457,"_30870":62458,"_3543":62459},[],"/docs/pr-preview/pr-58/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_4098":1785,"_34307":1771,"_23429":62461,"_5":16198,"_30870":1771,"_3543":62462},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_4098":1786,"_34307":1771,"_23429":62464,"_5":16198,"_30870":1771,"_3543":62465},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_4098":1787,"_34307":1771,"_23429":62467,"_5":16198,"_30870":62414,"_3543":62468},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_4098":1788,"_34307":1771,"_23429":62470,"_5":16198,"_30870":62414,"_3543":62471},[],"environment, such as production and preproduction;",{"_4098":1789,"_34307":1771,"_23429":62473,"_5":16198,"_30870":62414,"_3543":62474},[],"owner or operating team;",{"_4098":1790,"_34307":1771,"_23429":62476,"_5":16198,"_30870":62414,"_3543":62477},[],"device family or manufacturing process;",{"_4098":1791,"_34307":1771,"_23429":62479,"_5":16198,"_30870":62414,"_3543":62480},[],"region or regulatory requirement;",{"_4098":1792,"_34307":1771,"_23429":62482,"_5":16198,"_30870":62414,"_3543":62483},[],"cryptographic engine or key policy;",{"_4098":1793,"_34307":1771,"_23429":62485,"_5":16198,"_30870":62414,"_3543":62486},[],"maintenance window and renewal cadence.",{"_4098":1794,"_34307":1771,"_23429":62488,"_5":16198,"_30870":62414,"_3543":62489},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_4098":1795,"_34307":1771,"_23429":62491,"_5":16198,"_30870":62414,"_3543":62492},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_4098":1796,"_34307":1771,"_23429":62494,"_5":16198,"_30870":62418,"_3543":62495},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_4098":1797,"_34307":1771,"_23429":62497,"_5":16198,"_30870":62418,"_3543":62498},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_4098":1798,"_34307":1771,"_23429":62500,"_5":16198,"_30870":62418,"_3543":62501},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_4098":1799,"_34307":1771,"_23429":62503,"_5":16198,"_30870":62422,"_3543":62504},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_4098":1800,"_34307":1771,"_23429":62506,"_5":16198,"_30870":62422,"_3543":62507},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_4098":1801,"_34307":1771,"_23429":62509,"_5":16198,"_30870":62422,"_3543":62510},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_4098":1802,"_34307":1771,"_23429":62512,"_5":16198,"_30870":62422,"_3543":62513},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_4098":1803,"_34307":1771,"_23429":62515,"_5":16198,"_30870":62430,"_3543":62516},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_4098":1804,"_34307":1771,"_23429":62518,"_5":16198,"_30870":62434,"_3543":62519},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_4098":1805,"_34307":1771,"_23429":62521,"_5":16198,"_30870":62438,"_3543":62522},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_4098":1806,"_34307":1771,"_23429":62524,"_5":16198,"_30870":62442,"_3543":62525},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_4098":1807,"_34307":1771,"_23429":62527,"_5":16198,"_30870":62446,"_3543":62528},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_4098":1808,"_34307":1771,"_23429":62530,"_5":16198,"_30870":62450,"_3543":62531},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_4098":1809,"_34307":1771,"_23429":62533,"_5":16198,"_30870":62454,"_3543":62534},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_4098":1810,"_34307":1771,"_23429":62536,"_5":16198,"_30870":62454,"_3543":62537},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_4098":1811,"_34307":1771,"_23429":62539,"_5":16198,"_30870":62454,"_3543":62540},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_4098":1812,"_34307":1771,"_23429":62542,"_5":16198,"_30870":62454,"_3543":62543},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_4098":1813,"_34307":1771,"_23429":62545,"_5":16198,"_30870":62458,"_3543":62546},[],"The new chain ends in an anchor installed by the consumer.",{"_4098":1814,"_34307":1771,"_23429":62548,"_5":16198,"_30870":62458,"_3543":62549},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_4098":1815,"_34307":1771,"_23429":62551,"_5":16198,"_30870":62458,"_3543":62552},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_4098":1816,"_34307":1771,"_23429":62554,"_5":16198,"_30870":62458,"_3543":62555},[],"Re-enrollment accepts the old identity during the planned period.",{"_4098":1817,"_34307":1771,"_23429":62557,"_5":16198,"_30870":62458,"_3543":62558},[],"OCSP and CRL respond for the authorities that remain active.",{"_4098":1818,"_34307":1771,"_23429":62560,"_5":16198,"_30870":62458,"_3543":62561},[],"No DMS is left accidentally issuing from the old CA.",{"_4098":1819,"_34307":1771,"_23429":62563,"_5":16198,"_30870":62458,"_3543":62564},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_4098":1820,"_34307":1820,"_5":16596,"_3543":62566,"_34738":62567,"_23429":62568,"_30870":1820},"Certification authorities",[56936,58404,62406,62407],[],{"_4098":1821,"_34307":1820,"_23429":62570,"_5":16198,"_30870":1820,"_3543":62571},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_4098":1822,"_34307":1820,"_5":34735,"_23429":62573,"_30870":62574,"_3543":62575},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_4098":1823,"_34307":1820,"_5":34735,"_23429":62577,"_30870":62578,"_3543":62579},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_4098":1824,"_34307":1820,"_5":34735,"_23429":62581,"_30870":62582,"_3543":56946},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#before-you-begin",{"_4098":1825,"_34307":1820,"_5":34735,"_23429":62584,"_30870":62585,"_3543":62586},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_4098":1826,"_34307":1820,"_5":34735,"_23429":62588,"_30870":62589,"_3543":62590},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_4098":1827,"_34307":1820,"_5":34735,"_23429":62592,"_30870":62593,"_3543":62594},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_4098":1828,"_34307":1820,"_5":34735,"_23429":62596,"_30870":62597,"_3543":62598},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_4098":1829,"_34307":1820,"_5":34735,"_23429":62600,"_30870":62601,"_3543":62602},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_4098":1830,"_34307":1820,"_5":34735,"_23429":62604,"_30870":62605,"_3543":62606},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_4098":1831,"_34307":1820,"_5":34735,"_23429":62608,"_30870":62609,"_3543":62610},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_4098":1832,"_34307":1820,"_5":34735,"_23429":62612,"_30870":62613,"_3543":62614},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_4098":1833,"_34307":1820,"_5":34735,"_23429":62616,"_30870":62617,"_3543":62618},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_4098":1834,"_34307":1820,"_5":34735,"_23429":62620,"_30870":62621,"_3543":62622},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#load-the-material","Load the material",{"_4098":1835,"_34307":1820,"_5":34735,"_23429":62624,"_30870":62625,"_3543":62626},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_4098":1836,"_34307":1820,"_5":34735,"_23429":62628,"_30870":62629,"_3543":62630},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_4098":1837,"_34307":1820,"_5":34735,"_23429":62632,"_30870":62633,"_3543":62634},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_4098":1838,"_34307":1820,"_5":34735,"_23429":62636,"_30870":62637,"_3543":62638},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_4098":1839,"_34307":1820,"_5":34735,"_23429":62640,"_30870":62641,"_3543":62642},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_4098":1840,"_34307":1820,"_5":34735,"_23429":62644,"_30870":62645,"_3543":62646},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_4098":1841,"_34307":1820,"_5":34735,"_23429":62648,"_30870":62649,"_3543":62650},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_4098":1842,"_34307":1820,"_5":34735,"_23429":62652,"_30870":62653,"_3543":62654},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_4098":1843,"_34307":1820,"_5":34735,"_23429":62656,"_30870":62657,"_3543":62658},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_4098":1844,"_34307":1820,"_5":34735,"_23429":62660,"_30870":62661,"_3543":62662},[],"/docs/pr-preview/pr-58/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_4098":1845,"_34307":1820,"_23429":62664,"_5":16198,"_30870":1820,"_3543":62665},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_4098":1846,"_34307":1820,"_23429":62667,"_5":16198,"_30870":1820,"_3543":62668},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_4098":1847,"_34307":1820,"_23429":62670,"_5":16198,"_30870":1820,"_3543":62671},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_4098":1848,"_34307":1820,"_23429":62673,"_5":16198,"_30870":62574,"_3543":62674},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_4098":1849,"_34307":1820,"_23429":62676,"_5":16198,"_30870":62574,"_3543":62677},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_4098":1850,"_34307":1820,"_23429":62679,"_5":16198,"_30870":62574,"_3543":62680},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_4098":1851,"_34307":1820,"_23429":62682,"_5":16198,"_30870":62574,"_3543":62683},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_4098":1852,"_34307":1820,"_23429":62685,"_5":16198,"_30870":62574,"_3543":62686},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_4098":1853,"_34307":1820,"_23429":62688,"_5":16198,"_30870":62582,"_3543":62689},[],"Decide whether the CA will be a root or an intermediate.",{"_4098":1854,"_34307":1820,"_23429":62691,"_5":16198,"_30870":62582,"_3543":62692},[],"Choose the engine that will keep the key.",{"_4098":1855,"_34307":1820,"_23429":62694,"_5":16198,"_30870":62582,"_3543":62695},[],"Define a validity longer than that of the certificates it will issue.",{"_4098":1856,"_34307":1820,"_23429":62697,"_5":16198,"_30870":62582,"_3543":62698},[],"For an intermediate CA, make sure the parent CA is active.",{"_4098":1857,"_34307":1820,"_23429":62700,"_5":16198,"_30870":62585,"_3543":62701},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_4098":1858,"_34307":1820,"_23429":62703,"_5":16198,"_30870":62589,"_3543":62704},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_4098":1859,"_34307":1820,"_23429":62706,"_5":16198,"_30870":62589,"_3543":62707},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_4098":1860,"_34307":1820,"_23429":62709,"_5":16198,"_30870":62593,"_3543":62710},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_4098":1861,"_34307":1820,"_23429":62712,"_5":16198,"_30870":62597,"_3543":62713},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_4098":1862,"_34307":1820,"_23429":62715,"_5":16198,"_30870":62597,"_3543":62716},[],"`C`: two-letter ISO 3166-1 country code.",{"_4098":1863,"_34307":1820,"_23429":62718,"_5":16198,"_30870":62597,"_3543":62719},[],"`ST`: state or province.",{"_4098":1864,"_34307":1820,"_23429":62721,"_5":16198,"_30870":62597,"_3543":62722},[],"`L`: locality.",{"_4098":1865,"_34307":1820,"_23429":62724,"_5":16198,"_30870":62597,"_3543":62725},[],"`O`: organization.",{"_4098":1866,"_34307":1820,"_23429":62727,"_5":16198,"_30870":62597,"_3543":62728},[],"`OU`: organizational unit.",{"_4098":1867,"_34307":1820,"_23429":62730,"_5":16198,"_30870":62597,"_3543":62731},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_4098":1868,"_34307":1820,"_23429":62733,"_5":16198,"_30870":62601,"_3543":62734},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_4098":1869,"_34307":1820,"_23429":62736,"_5":16198,"_30870":62601,"_3543":62737},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_4098":1870,"_34307":1820,"_23429":62739,"_5":16198,"_30870":62605,"_3543":62740},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_4098":1871,"_34307":1820,"_23429":62742,"_5":16198,"_30870":62605,"_3543":62743},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_4098":1872,"_34307":1820,"_23429":62745,"_5":16198,"_30870":62609,"_3543":62746},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_4098":1873,"_34307":1820,"_23429":62748,"_5":16198,"_30870":62609,"_3543":62749},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_4098":1874,"_34307":1820,"_23429":62751,"_5":16198,"_30870":62613,"_3543":62752},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_4098":1875,"_34307":1820,"_23429":62754,"_5":16198,"_30870":62613,"_3543":62755},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_4098":1876,"_34307":1820,"_23429":62757,"_5":16198,"_30870":62613,"_3543":62758},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_4098":1877,"_34307":1820,"_23429":62760,"_5":16198,"_30870":62617,"_3543":62761},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_4098":1878,"_34307":1820,"_23429":62763,"_5":16198,"_30870":62621,"_3543":62764},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_4098":1879,"_34307":1820,"_23429":62766,"_5":16198,"_30870":62625,"_3543":62767},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_4098":1880,"_34307":1820,"_23429":62769,"_5":16198,"_30870":62629,"_3543":62770},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_4098":1881,"_34307":1820,"_23429":62772,"_5":16198,"_30870":62629,"_3543":62773},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_4098":1882,"_34307":1820,"_23429":62775,"_5":16198,"_30870":62633,"_3543":62776},[],"Open a CA from the inventory to review:",{"_4098":1883,"_34307":1820,"_23429":62778,"_5":16198,"_30870":62633,"_3543":62779},[],"Status and validity period.",{"_4098":1884,"_34307":1820,"_23429":62781,"_5":16198,"_30870":62633,"_3543":62782},[],"Certificate and chain in PEM format.",{"_4098":1885,"_34307":1820,"_23429":62784,"_5":16198,"_30870":62633,"_3543":62785},[],"Number of active, expired and revoked certificates.",{"_4098":1886,"_34307":1820,"_23429":62787,"_5":16198,"_30870":62633,"_3543":62788},[],"Certificates issued in **Issued Certificates**.",{"_4098":1887,"_34307":1820,"_23429":62790,"_5":16198,"_30870":62633,"_3543":62791},[],"The CRL linked to the authority.",{"_4098":1888,"_34307":1820,"_23429":62793,"_5":16198,"_30870":62633,"_3543":62794},[],"Metadata and the associated cryptographic engine.",{"_4098":1889,"_34307":1820,"_23429":62796,"_5":16198,"_30870":62633,"_3543":62797},[],"You can filter the inventory by name, status and CA type.",{"_4098":1890,"_34307":1820,"_23429":62799,"_5":16198,"_30870":62637,"_3543":62800},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_4098":1891,"_34307":1820,"_23429":62802,"_5":16198,"_30870":62637,"_3543":62803},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_4098":1892,"_34307":1820,"_23429":62805,"_5":16198,"_30870":62637,"_3543":62806},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_4098":1893,"_34307":1820,"_23429":62808,"_5":16198,"_30870":62637,"_3543":62809},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_4098":1894,"_34307":1820,"_23429":62811,"_5":16198,"_30870":62641,"_3543":62812},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_4098":1895,"_34307":1820,"_23429":62814,"_5":16198,"_30870":62645,"_3543":62815},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_4098":1896,"_34307":1820,"_23429":62817,"_5":16198,"_30870":62649,"_3543":62818},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_4098":1897,"_34307":1820,"_23429":62820,"_5":16198,"_30870":62653,"_3543":62821},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_4098":1898,"_34307":1820,"_23429":62823,"_5":16198,"_30870":62657,"_3543":62824},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_4098":1899,"_34307":1820,"_23429":62826,"_5":16198,"_30870":62661,"_3543":62827},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_4098":1900,"_34307":1820,"_23429":62829,"_5":16198,"_30870":62661,"_3543":62830},[],"The CA’s VA role is kept. If no other CA with the same SKI remains, it can no longer be edited (see CRL), so adjust its validity and signer beforehand. The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_4098":1901,"_34307":1820,"_23429":62832,"_5":16198,"_30870":62661,"_3543":62833},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. If the new certificate uses the same key, it shares the SKI with the retained VA role of the deleted CA, whose signer is the old certificate: check that the CRL is generated and, if it is not, use `PUT` to set a signer of the new CA (see CRL).",{"_4098":1902,"_34307":1902,"_5":16596,"_3543":62835,"_34738":62836,"_23429":62837,"_30870":1902},"Certificate profiles",[56936,58404,62406,62407],[],{"_4098":1903,"_34307":1902,"_23429":62839,"_5":16198,"_30870":1902,"_3543":62840},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_4098":1904,"_34307":1902,"_5":34735,"_23429":62842,"_30870":62843,"_3543":62844},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_4098":1905,"_34307":1902,"_5":34735,"_23429":62846,"_30870":62847,"_3543":62848},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#validity","Validity",{"_4098":1906,"_34307":1902,"_5":34735,"_23429":62850,"_30870":62851,"_3543":62852},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_4098":1907,"_34307":1902,"_5":34735,"_23429":62854,"_30870":62855,"_3543":62856},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_4098":1908,"_34307":1902,"_5":34735,"_23429":62858,"_30870":62859,"_3543":62860},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#subject","Subject",{"_4098":1909,"_34307":1902,"_5":34735,"_23429":62862,"_30870":62863,"_3543":62864},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_4098":1910,"_34307":1902,"_5":34735,"_23429":62866,"_30870":62867,"_3543":62868},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_4098":1911,"_34307":1902,"_5":34735,"_23429":62870,"_30870":62871,"_3543":62872},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_4098":1912,"_34307":1902,"_5":34735,"_23429":62874,"_30870":62875,"_3543":62876},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_4098":1913,"_34307":1902,"_5":34735,"_23429":62878,"_30870":62879,"_3543":62880},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_4098":1914,"_34307":1902,"_5":34735,"_23429":62882,"_30870":62883,"_3543":62884},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_4098":1915,"_34307":1902,"_5":34735,"_23429":62886,"_30870":62887,"_3543":62888},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_4098":1916,"_34307":1902,"_5":34735,"_23429":62890,"_30870":62891,"_3543":62892},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_4098":1917,"_34307":1902,"_5":34735,"_23429":62894,"_30870":62895,"_3543":62896},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_4098":1918,"_34307":1902,"_5":34735,"_23429":62898,"_30870":62899,"_3543":62900},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#design-examples","Design examples",{"_4098":1919,"_34307":1902,"_5":34735,"_23429":62902,"_30870":62903,"_3543":62904},[],"/docs/pr-preview/pr-58/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_4098":1920,"_34307":1902,"_23429":62906,"_5":16198,"_30870":1902,"_3543":62907},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_4098":1921,"_34307":1902,"_23429":62909,"_5":16198,"_30870":1902,"_3543":62910},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_4098":1922,"_34307":1902,"_23429":62912,"_5":16198,"_30870":62847,"_3543":62913},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_4098":1923,"_34307":1902,"_23429":62915,"_5":16198,"_30870":62847,"_3543":62916},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_4098":1924,"_34307":1902,"_23429":62918,"_5":16198,"_30870":62851,"_3543":62919},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_4098":1925,"_34307":1902,"_23429":62921,"_5":16198,"_30870":62855,"_3543":62922},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_4098":1926,"_34307":1902,"_23429":62924,"_5":16198,"_30870":62855,"_3543":62925},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_4098":1927,"_34307":1902,"_23429":62927,"_5":16198,"_30870":62855,"_3543":62928},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_4098":1928,"_34307":1902,"_23429":62930,"_5":16198,"_30870":62859,"_3543":62931},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_4098":1929,"_34307":1902,"_23429":62933,"_5":16198,"_30870":62863,"_3543":62934},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_4098":1930,"_34307":1902,"_23429":62936,"_5":16198,"_30870":62863,"_3543":62937},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_4098":1931,"_34307":1902,"_23429":62939,"_5":16198,"_30870":62867,"_3543":62940},[],"The cryptographic enforcement can:",{"_4098":1932,"_34307":1902,"_23429":62942,"_5":16198,"_30870":62867,"_3543":62943},[],"allow or block RSA keys;",{"_4098":1933,"_34307":1902,"_23429":62945,"_5":16198,"_30870":62867,"_3543":62946},[],"limit the supported RSA sizes;",{"_4098":1934,"_34307":1902,"_23429":62948,"_5":16198,"_30870":62867,"_3543":62949},[],"allow or block ECDSA keys;",{"_4098":1935,"_34307":1902,"_23429":62951,"_5":16198,"_30870":62867,"_3543":62952},[],"limit the supported ECDSA sizes or curves.",{"_4098":1936,"_34307":1902,"_23429":62954,"_5":16198,"_30870":62867,"_3543":62955},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_4098":1937,"_34307":1902,"_23429":62957,"_5":16198,"_30870":62871,"_3543":62958},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_4098":1938,"_34307":1902,"_23429":62960,"_5":16198,"_30870":62871,"_3543":60168},[],{"_4098":1939,"_34307":1902,"_23429":62962,"_5":16198,"_30870":62871,"_3543":62963},[],"First choice",{"_4098":1940,"_34307":1902,"_23429":62965,"_5":16198,"_30870":62871,"_3543":62966},[],"Second choice",{"_4098":1941,"_34307":1902,"_23429":62968,"_5":16198,"_30870":62871,"_3543":62969},[],"If neither is supplied",{"_4098":1942,"_34307":1902,"_23429":62971,"_5":16198,"_30870":62871,"_3543":62972},[],"Direct signing with a CA",{"_4098":1943,"_34307":1902,"_23429":62974,"_5":16198,"_30870":62871,"_3543":62975},[],"`issuance_profile` embedded in the request",{"_4098":1944,"_34307":1902,"_23429":62977,"_5":16198,"_30870":62871,"_3543":62978},[],"Request `issuance_profile_id`",{"_4098":1945,"_34307":1902,"_23429":62980,"_5":16198,"_30870":62871,"_3543":62981},[],"CA default profile (`profile_id`).",{"_4098":1946,"_34307":1902,"_23429":62983,"_5":16198,"_30870":62871,"_3543":62984},[],"Issuance through a DMS",{"_4098":1947,"_34307":1902,"_23429":62986,"_5":16198,"_30870":62871,"_3543":62987},[],"`settings.issuance_profile_id`",{"_4098":1948,"_34307":1902,"_23429":62989,"_5":16198,"_30870":62871,"_3543":62990},[],"`settings.issuance_profile` embedded in the DMS",{"_4098":1949,"_34307":1902,"_23429":62992,"_5":16198,"_30870":62871,"_3543":62993},[],"Enrollment CA default profile.",{"_4098":1950,"_34307":1902,"_23429":62995,"_5":16198,"_30870":62871,"_3543":62996},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_4098":1951,"_34307":1902,"_23429":62998,"_5":16198,"_30870":62871,"_3543":62999},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_4098":1952,"_34307":1902,"_23429":63001,"_5":16198,"_30870":62879,"_3543":63002},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_4098":1953,"_34307":1902,"_23429":63004,"_5":16198,"_30870":62883,"_3543":63005},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_4098":1954,"_34307":1902,"_23429":63007,"_5":16198,"_30870":62887,"_3543":63008},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_4098":1955,"_34307":1902,"_23429":63010,"_5":16198,"_30870":62891,"_3543":63011},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_4098":1956,"_34307":1902,"_23429":63013,"_5":16198,"_30870":62895,"_3543":63014},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_4098":1957,"_34307":1902,"_23429":63016,"_5":16198,"_30870":62895,"_3543":63017},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_4098":1958,"_34307":1902,"_23429":63019,"_5":16198,"_30870":62899,"_3543":63020},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_4098":1959,"_34307":1902,"_23429":63022,"_5":16198,"_30870":62899,"_3543":63023},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_4098":1960,"_34307":1902,"_23429":63025,"_5":16198,"_30870":62899,"_3543":63026},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_4098":1961,"_34307":1902,"_23429":63028,"_5":16198,"_30870":62899,"_3543":63029},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_4098":1962,"_34307":1902,"_23429":63031,"_5":16198,"_30870":62903,"_3543":63032},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_4098":1963,"_34307":1902,"_23429":63034,"_5":16198,"_30870":62903,"_3543":63035},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_4098":1964,"_34307":1964,"_5":16596,"_3543":63037,"_34738":63038,"_23429":63040,"_30870":1964},"Certificate validation",[56936,58404,62406,63039],"Validation",[],{"_4098":1965,"_34307":1964,"_23429":63042,"_5":16198,"_30870":1964,"_3543":63043},[],"Check chain, identity, purpose and revocation from the consumer.",{"_4098":1966,"_34307":1964,"_5":34735,"_23429":63045,"_30870":63046,"_3543":63047},[],"/docs/pr-preview/pr-58/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_4098":1967,"_34307":1964,"_5":34735,"_23429":63049,"_30870":63050,"_3543":63051},[],"/docs/pr-preview/pr-58/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_4098":1968,"_34307":1964,"_5":34735,"_23429":63053,"_30870":63054,"_3543":63055},[],"/docs/pr-preview/pr-58/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_4098":1969,"_34307":1964,"_23429":63057,"_5":16198,"_30870":1964,"_3543":63058},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_4098":1970,"_34307":1964,"_23429":63060,"_5":16198,"_30870":63046,"_3543":63061},[],"Verify these criteria together:",{"_4098":1971,"_34307":1964,"_23429":63063,"_5":16198,"_30870":63046,"_3543":62032},[],{"_4098":1972,"_34307":1964,"_23429":63065,"_5":16198,"_30870":63046,"_3543":63066},[],"Required result",{"_4098":1973,"_34307":1964,"_23429":63068,"_5":16198,"_30870":63046,"_3543":63069},[],"Chain and signature",{"_4098":1974,"_34307":1964,"_23429":63071,"_5":16198,"_30870":63046,"_3543":63072},[],"Valid chain to a root deliberately installed in the consumer.",{"_4098":1975,"_34307":1964,"_23429":63074,"_5":16198,"_30870":63046,"_3543":63075},[],"Dates",{"_4098":1976,"_34307":1964,"_23429":63077,"_5":16198,"_30870":63046,"_3543":63078},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_4098":1977,"_34307":1964,"_23429":63080,"_5":16198,"_30870":63046,"_3543":58073},[],{"_4098":1978,"_34307":1964,"_23429":63082,"_5":16198,"_30870":63046,"_3543":63083},[],"Name, SAN or identifier matches the expected peer.",{"_4098":1979,"_34307":1964,"_23429":63085,"_5":16198,"_30870":63046,"_3543":57326},[],{"_4098":1980,"_34307":1964,"_23429":63087,"_5":16198,"_30870":63046,"_3543":63088},[],"KU, EKU and constraints permit the specific operation.",{"_4098":1981,"_34307":1964,"_23429":63090,"_5":16198,"_30870":63046,"_3543":63091},[],"Revocation",{"_4098":1982,"_34307":1964,"_23429":63093,"_5":16198,"_30870":63046,"_3543":63094},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_4098":1983,"_34307":1964,"_23429":63096,"_5":16198,"_30870":63046,"_3543":63097},[],"Authorization",{"_4098":1984,"_34307":1964,"_23429":63099,"_5":16198,"_30870":63046,"_3543":63100},[],"The application permits that identity to perform the action.",{"_4098":1985,"_34307":1964,"_23429":63102,"_5":16198,"_30870":63046,"_3543":63103},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_4098":1986,"_34307":1964,"_23429":63105,"_5":16198,"_30870":63050,"_3543":63106},[],"Mechanism",{"_4098":1987,"_34307":1964,"_23429":63108,"_5":16198,"_30870":63050,"_3543":63109},[],"When to use it",{"_4098":1988,"_34307":1964,"_23429":63111,"_5":16198,"_30870":63050,"_3543":63112},[],"What you must maintain",{"_4098":1989,"_34307":1964,"_23429":63114,"_5":16198,"_30870":63050,"_3543":63115},[],"OCSP",{"_4098":1990,"_34307":1964,"_23429":63117,"_5":16198,"_30870":63050,"_3543":63118},[],"Status query for a specific certificate.",{"_4098":1991,"_34307":1964,"_23429":63120,"_5":16198,"_30870":63050,"_3543":63121},[],"Responder access, signature verification and cache/freshness policy.",{"_4098":1992,"_34307":1964,"_23429":63123,"_5":16198,"_30870":63050,"_3543":63124},[],"CRL",{"_4098":1993,"_34307":1964,"_23429":63126,"_5":16198,"_30870":63050,"_3543":63127},[],"Local checks for many certificates or offline operation.",{"_4098":1994,"_34307":1964,"_23429":63129,"_5":16198,"_30870":63050,"_3543":63130},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_4098":1995,"_34307":1964,"_23429":63132,"_5":16198,"_30870":63050,"_3543":63133},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_4098":1996,"_34307":1964,"_23429":63135,"_5":16198,"_30870":63050,"_3543":63136},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_4098":1997,"_34307":1964,"_23429":63138,"_5":16198,"_30870":63054,"_3543":63139},[],"Accept a current, authorized certificate with a known chain.",{"_4098":1998,"_34307":1964,"_23429":63141,"_5":16198,"_30870":63054,"_3543":63142},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_4098":1999,"_34307":1964,"_23429":63144,"_5":16198,"_30870":63054,"_3543":63145},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_4098":2000,"_34307":1964,"_23429":63147,"_5":16198,"_30870":63054,"_3543":63148},[],"Check that a new connection with that identity is rejected.",{"_4098":2001,"_34307":1964,"_23429":63150,"_5":16198,"_30870":63054,"_3543":63151},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_4098":2002,"_34307":1964,"_23429":63153,"_5":16198,"_30870":63054,"_3543":63154},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_4098":2003,"_34307":1964,"_23429":63156,"_5":16198,"_30870":63054,"_3543":63157},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_4098":2004,"_34307":1964,"_23429":63159,"_5":16198,"_30870":63054,"_3543":63160},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_4098":2005,"_34307":1964,"_23429":63162,"_5":16198,"_30870":63054,"_3543":63163},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_4098":2006,"_34307":2006,"_5":16596,"_3543":63165,"_34738":63166,"_23429":63167,"_30870":2006},"Certificates",[56936,58404,62406,62407],[],{"_4098":2007,"_34307":2006,"_23429":63169,"_5":16198,"_30870":2006,"_3543":63170},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_4098":2008,"_34307":2006,"_5":34735,"_23429":63172,"_30870":63173,"_3543":63174},[],"/docs/pr-preview/pr-58/platform/pki/certificates#find-a-certificate","Find a certificate",{"_4098":2009,"_34307":2006,"_5":34735,"_23429":63176,"_30870":63177,"_3543":63178},[],"/docs/pr-preview/pr-58/platform/pki/certificates#download-the-certificate","Download the certificate",{"_4098":2010,"_34307":2006,"_5":34735,"_23429":63180,"_30870":63181,"_3543":63182},[],"/docs/pr-preview/pr-58/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_4098":2011,"_34307":2006,"_5":34735,"_23429":63184,"_30870":63185,"_3543":63186},[],"/docs/pr-preview/pr-58/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_4098":2012,"_34307":2006,"_5":34735,"_23429":63188,"_30870":63189,"_3543":63190},[],"/docs/pr-preview/pr-58/platform/pki/certificates#open-the-action","Open the action",{"_4098":2013,"_34307":2006,"_5":34735,"_23429":63192,"_30870":63193,"_3543":63194},[],"/docs/pr-preview/pr-58/platform/pki/certificates#choose-a-reason","Choose a reason",{"_4098":2014,"_34307":2006,"_5":34735,"_23429":63196,"_30870":63197,"_3543":63198},[],"/docs/pr-preview/pr-58/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_4098":2015,"_34307":2006,"_5":34735,"_23429":63200,"_30870":63201,"_3543":63202},[],"/docs/pr-preview/pr-58/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_4098":2016,"_34307":2006,"_5":34735,"_23429":63204,"_30870":63205,"_3543":63206},[],"/docs/pr-preview/pr-58/platform/pki/certificates#continue","Continue",{"_4098":2017,"_34307":2006,"_23429":63208,"_5":16198,"_30870":2006,"_3543":63209},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_4098":2018,"_34307":2006,"_23429":63211,"_5":16198,"_30870":63173,"_3543":63212},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_4098":2019,"_34307":2006,"_23429":63214,"_5":16198,"_30870":63173,"_3543":63215},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_4098":2020,"_34307":2006,"_23429":63217,"_5":16198,"_30870":63173,"_3543":63218},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_4098":2021,"_34307":2006,"_23429":63220,"_5":16198,"_30870":63173,"_3543":63221},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_4098":2022,"_34307":2006,"_23429":63223,"_5":16198,"_30870":63173,"_3543":63224},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_4098":2023,"_34307":2006,"_23429":63226,"_5":16198,"_30870":63173,"_3543":63227},[],"Certificate details include the key reference (`key_id`) and whether the private key is managed (`has_private_key`); certificate lists can be filtered on `has_private_key`.",{"_4098":2024,"_34307":2006,"_23429":63229,"_5":16198,"_30870":63173,"_3543":63230},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_4098":2025,"_34307":2006,"_23429":63232,"_5":16198,"_30870":63177,"_3543":63233},[],"Download the PEM and inspect it:",{"_4098":2026,"_34307":2006,"_23429":63235,"_5":16198,"_30870":63177,"_3543":63236},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_4098":2027,"_34307":2006,"_23429":63238,"_5":16198,"_30870":63181,"_3543":63239},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_4098":2028,"_34307":2006,"_23429":63241,"_5":16198,"_30870":63181,"_3543":63242},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_4098":2029,"_34307":2006,"_23429":63244,"_5":16198,"_30870":63181,"_3543":63245},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_4098":2030,"_34307":2006,"_23429":63247,"_5":16198,"_30870":63181,"_3543":63248},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_4098":2031,"_34307":2006,"_23429":63250,"_5":16198,"_30870":63181,"_3543":63251},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_4098":2032,"_34307":2006,"_23429":63253,"_5":16198,"_30870":63181,"_3543":63254},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_4098":2033,"_34307":2006,"_23429":63256,"_5":16198,"_30870":63181,"_3543":63257},[],"For browser key generation, follow Issue your first certificate.",{"_4098":2034,"_34307":2006,"_23429":63259,"_5":16198,"_30870":63185,"_3543":63260},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_4098":2035,"_34307":2006,"_23429":63262,"_5":16198,"_30870":63189,"_3543":63263},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_4098":2036,"_34307":2006,"_23429":63265,"_5":16198,"_30870":63193,"_3543":63266},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_4098":2037,"_34307":2006,"_23429":63268,"_5":16198,"_30870":63197,"_3543":63269},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_4098":2038,"_34307":2006,"_23429":63271,"_5":16198,"_30870":63197,"_3543":63272},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_4098":2039,"_34307":2006,"_23429":63274,"_5":16198,"_30870":63197,"_3543":63275},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_4098":2040,"_34307":2006,"_23429":63277,"_5":16198,"_30870":63201,"_3543":63278},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_4098":2041,"_34307":2006,"_23429":63280,"_5":16198,"_30870":63201,"_3543":63281},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_4098":2042,"_34307":2006,"_23429":63283,"_5":16198,"_30870":63201,"_3543":63284},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_4098":2043,"_34307":2006,"_23429":63286,"_5":16198,"_30870":63205,"_3543":63287},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_4098":2044,"_34307":2006,"_23429":63289,"_5":16198,"_30870":63205,"_3543":63290},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_4098":2045,"_34307":2045,"_5":16596,"_3543":63292,"_34738":63293,"_23429":63295,"_30870":2045},"Certificate lifecycle",[56936,58404,62406,63294],"Concepts",[],{"_4098":2046,"_34307":2045,"_23429":63297,"_5":16198,"_30870":2045,"_3543":63298},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_4098":2047,"_34307":2045,"_5":34735,"_23429":63300,"_30870":63301,"_3543":63302},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_4098":2048,"_34307":2045,"_5":34735,"_23429":63304,"_30870":63305,"_3543":63306},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#request","Request",{"_4098":2049,"_34307":2045,"_5":34735,"_23429":63308,"_30870":63309,"_3543":63310},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_4098":2050,"_34307":2045,"_5":34735,"_23429":63312,"_30870":63313,"_3543":63314},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_4098":2051,"_34307":2045,"_5":34735,"_23429":63316,"_30870":63317,"_3543":63318},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_4098":2052,"_34307":2045,"_5":34735,"_23429":63320,"_30870":63321,"_3543":63322},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_4098":2053,"_34307":2045,"_5":34735,"_23429":63324,"_30870":63325,"_3543":63326},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_4098":2054,"_34307":2045,"_5":34735,"_23429":63328,"_30870":63329,"_3543":63330},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_4098":2055,"_34307":2045,"_5":34735,"_23429":63332,"_30870":63333,"_3543":63334},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_4098":2056,"_34307":2045,"_5":34735,"_23429":63336,"_30870":63337,"_3543":63338},[],"/docs/pr-preview/pr-58/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_4098":2057,"_34307":2045,"_23429":63340,"_5":16198,"_30870":2045,"_3543":63341},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_4098":2058,"_34307":2045,"_23429":63343,"_5":16198,"_30870":63305,"_3543":63344},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_4098":2059,"_34307":2045,"_23429":63346,"_5":16198,"_30870":63309,"_3543":63347},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_4098":2060,"_34307":2045,"_23429":63349,"_5":16198,"_30870":63313,"_3543":63350},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_4098":2061,"_34307":2045,"_23429":63352,"_5":16198,"_30870":63317,"_3543":63353},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_4098":2062,"_34307":2045,"_23429":63355,"_5":16198,"_30870":63321,"_3543":63356},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_4098":2063,"_34307":2045,"_23429":63358,"_5":16198,"_30870":63325,"_3543":63359},[],"Lamassu persists four X.509 states:",{"_4098":2064,"_34307":2045,"_23429":63361,"_5":16198,"_30870":63325,"_3543":63362},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_4098":2065,"_34307":2045,"_23429":63364,"_5":16198,"_30870":63325,"_3543":63365},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_4098":2066,"_34307":2045,"_23429":63367,"_5":16198,"_30870":63325,"_3543":63368},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_4098":2067,"_34307":2045,"_23429":63370,"_5":16198,"_30870":63325,"_3543":63371},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_4098":2068,"_34307":2045,"_23429":63373,"_5":16198,"_30870":63325,"_3543":63374},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_4098":2069,"_34307":2045,"_23429":63376,"_5":16198,"_30870":63329,"_3543":63377},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_4098":2070,"_34307":2045,"_23429":63379,"_5":16198,"_30870":63329,"_3543":63380},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_4098":2071,"_34307":2045,"_23429":63382,"_5":16198,"_30870":63329,"_3543":63383},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_4098":2072,"_34307":2045,"_23429":63385,"_5":16198,"_30870":63333,"_3543":63386},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_4098":2073,"_34307":2045,"_23429":63388,"_5":16198,"_30870":63333,"_3543":63389},[],"Before confirming:",{"_4098":2074,"_34307":2045,"_23429":63391,"_5":16198,"_30870":63333,"_3543":63392},[],"Identify DMSs, devices and services that trust that chain.",{"_4098":2075,"_34307":2045,"_23429":63394,"_5":16198,"_30870":63333,"_3543":63395},[],"Distribute the new chain of trust.",{"_4098":2076,"_34307":2045,"_23429":63397,"_5":16198,"_30870":63333,"_3543":63398},[],"Reissue the necessary identities.",{"_4098":2077,"_34307":2045,"_23429":63400,"_5":16198,"_30870":63333,"_3543":63401},[],"Check OCSP and CRL from a real consumer.",{"_4098":2078,"_34307":2045,"_23429":63403,"_5":16198,"_30870":63333,"_3543":63404},[],"Revoke the old CA once no legitimate traffic remains.",{"_4098":2079,"_34307":2045,"_23429":63406,"_5":16198,"_30870":63333,"_3543":63407},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_4098":2080,"_34307":2045,"_23429":63409,"_5":16198,"_30870":63337,"_3543":63410},[],"Certificates entering the preventive or critical renewal window.",{"_4098":2081,"_34307":2045,"_23429":63412,"_5":16198,"_30870":63337,"_3543":63413},[],"Repeated enrollment or re-enrollment failures.",{"_4098":2082,"_34307":2045,"_23429":63415,"_5":16198,"_30870":63337,"_3543":63416},[],"Status changes and revocation reasons.",{"_4098":2083,"_34307":2045,"_23429":63418,"_5":16198,"_30870":63337,"_3543":63419},[],"OCSP and CRL publication and validity.",{"_4098":2084,"_34307":2045,"_23429":63421,"_5":16198,"_30870":63337,"_3543":63422},[],"Dependencies still presenting a replaced certificate.",{"_4098":2085,"_34307":2045,"_23429":63424,"_5":16198,"_30870":63337,"_3543":63425},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_4098":2086,"_34307":2086,"_5":16596,"_3543":63427,"_34738":63428,"_23429":63429,"_30870":2086},"Trust model",[56936,58404,62406,63294],[],{"_4098":2087,"_34307":2086,"_23429":63431,"_5":16198,"_30870":2086,"_3543":63432},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_4098":2088,"_34307":2086,"_5":34735,"_23429":63434,"_30870":63435,"_3543":63436},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_4098":2089,"_34307":2086,"_5":34735,"_23429":63438,"_30870":63439,"_3543":63440},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_4098":2090,"_34307":2086,"_5":34735,"_23429":63442,"_30870":63443,"_3543":63444},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_4098":2091,"_34307":2086,"_5":34735,"_23429":63446,"_30870":63447,"_3543":63448},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_4098":2092,"_34307":2086,"_5":34735,"_23429":63450,"_30870":63451,"_3543":63452},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_4098":2093,"_34307":2086,"_5":34735,"_23429":63454,"_30870":63455,"_3543":63456},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_4098":2094,"_34307":2086,"_5":34735,"_23429":63458,"_30870":63459,"_3543":63460},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_4098":2095,"_34307":2086,"_5":34735,"_23429":63462,"_30870":63463,"_3543":63464},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_4098":2096,"_34307":2086,"_5":34735,"_23429":63466,"_30870":63467,"_3543":63468},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_4098":2097,"_34307":2086,"_5":34735,"_23429":63470,"_30870":63471,"_3543":63472},[],"/docs/pr-preview/pr-58/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_4098":2098,"_34307":2086,"_23429":63474,"_5":16198,"_30870":2086,"_3543":63475},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_4098":2099,"_34307":2086,"_23429":63477,"_5":16198,"_30870":63439,"_3543":63478},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_4098":2100,"_34307":2086,"_23429":63480,"_5":16198,"_30870":63443,"_3543":63481},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_4098":2101,"_34307":2086,"_23429":63483,"_5":16198,"_30870":63447,"_3543":63484},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_4098":2102,"_34307":2086,"_23429":63486,"_5":16198,"_30870":63451,"_3543":63487},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_4098":2103,"_34307":2086,"_23429":63489,"_5":16198,"_30870":63455,"_3543":63490},[],"The device proves it can enroll according to the DMS policy.",{"_4098":2104,"_34307":2086,"_23429":63492,"_5":16198,"_30870":63455,"_3543":63493},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_4098":2105,"_34307":2086,"_23429":63495,"_5":16198,"_30870":63455,"_3543":63496},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_4098":2106,"_34307":2086,"_23429":63498,"_5":16198,"_30870":63455,"_3543":63499},[],"The device installs the certificate and the chain it needs.",{"_4098":2107,"_34307":2086,"_23429":63501,"_5":16198,"_30870":63455,"_3543":63502},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_4098":2108,"_34307":2086,"_23429":63504,"_5":16198,"_30870":63455,"_3543":63505},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_4098":2109,"_34307":2086,"_23429":63507,"_5":16198,"_30870":63459,"_3543":63508},[],"A DMS relates three sets that are worth designing separately:",{"_4098":2110,"_34307":2086,"_23429":63510,"_5":16198,"_30870":63459,"_3543":63511},[],"**Enrollment CA:** signs the new identities.",{"_4098":2111,"_34307":2086,"_23429":63513,"_5":16198,"_30870":63459,"_3543":63514},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_4098":2112,"_34307":2086,"_23429":63516,"_5":16198,"_30870":63459,"_3543":63517},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_4098":2113,"_34307":2086,"_23429":63519,"_5":16198,"_30870":63459,"_3543":63520},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_4098":2114,"_34307":2086,"_23429":63522,"_5":16198,"_30870":63463,"_3543":63523},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_4098":2115,"_34307":2086,"_23429":63525,"_5":16198,"_30870":63463,"_3543":63526},[],"that the current date is between `Not Before` and `Not After`;",{"_4098":2116,"_34307":2086,"_23429":63528,"_5":16198,"_30870":63463,"_3543":63529},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_4098":2117,"_34307":2086,"_23429":63531,"_5":16198,"_30870":63463,"_3543":63532},[],"that names, SANs and subject match the expected identity;",{"_4098":2118,"_34307":2086,"_23429":63534,"_5":16198,"_30870":63463,"_3543":63535},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_4098":2119,"_34307":2086,"_23429":63537,"_5":16198,"_30870":63463,"_3543":63538},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_4098":2120,"_34307":2086,"_23429":63540,"_5":16198,"_30870":63463,"_3543":63541},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_4098":2121,"_34307":2086,"_23429":63543,"_5":16198,"_30870":63467,"_3543":63544},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_4098":2122,"_34307":2086,"_23429":63546,"_5":16198,"_30870":63471,"_3543":63547},[],"Keep the root out of daily operations, or with very restricted access.",{"_4098":2123,"_34307":2086,"_23429":63549,"_5":16198,"_30870":63471,"_3543":63550},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_4098":2124,"_34307":2086,"_23429":63552,"_5":16198,"_30870":63471,"_3543":63553},[],"Assign explicit profiles to every use case.",{"_4098":2125,"_34307":2086,"_23429":63555,"_5":16198,"_30870":63471,"_3543":63556},[],"Distribute the new trust before starting a rotation.",{"_4098":2126,"_34307":2086,"_23429":63558,"_5":16198,"_30870":63471,"_3543":63559},[],"Keep enough overlap to renew a disconnected fleet.",{"_4098":2127,"_34307":2086,"_23429":63561,"_5":16198,"_30870":63471,"_3543":63562},[],"Validate from the consuming system, not only from the Lamassu console.",{"_4098":2128,"_34307":2086,"_23429":63564,"_5":16198,"_30870":63471,"_3543":63565},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_4098":2129,"_34307":2129,"_5":16596,"_3543":63567,"_34738":63568,"_23429":63569,"_30870":2129},"Revocation lists (CRL)",[56936,58404,62406,63039],[],{"_4098":2130,"_34307":2129,"_23429":63571,"_5":16198,"_30870":2129,"_3543":63572},[],"Generate and distribute signed lists to validate certificates offline.",{"_4098":2131,"_34307":2129,"_5":34735,"_23429":63574,"_30870":63575,"_3543":63576},[],"/docs/pr-preview/pr-58/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_4098":2132,"_34307":2129,"_5":34735,"_23429":63578,"_30870":63579,"_3543":63580},[],"/docs/pr-preview/pr-58/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_4098":2133,"_34307":2129,"_5":34735,"_23429":63582,"_30870":63583,"_3543":63584},[],"/docs/pr-preview/pr-58/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_4098":2134,"_34307":2129,"_5":34735,"_23429":63586,"_30870":63587,"_3543":63588},[],"/docs/pr-preview/pr-58/platform/pki/crl#crl-contents","CRL contents",{"_4098":2135,"_34307":2129,"_5":34735,"_23429":63590,"_30870":63591,"_3543":63592},[],"/docs/pr-preview/pr-58/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_4098":2136,"_34307":2129,"_5":34735,"_23429":63594,"_30870":63595,"_3543":63596},[],"/docs/pr-preview/pr-58/platform/pki/crl#va-role-management-api","VA role management API",{"_4098":2137,"_34307":2129,"_5":34735,"_23429":63598,"_30870":63599,"_3543":63600},[],"/docs/pr-preview/pr-58/platform/pki/crl#common-va-role-errors","Common VA role errors",{"_4098":2138,"_34307":2129,"_5":34735,"_23429":63602,"_30870":63603,"_3543":63604},[],"/docs/pr-preview/pr-58/platform/pki/crl#from-the-interface","From the interface",{"_4098":2139,"_34307":2129,"_5":34735,"_23429":63606,"_30870":63607,"_3543":63608},[],"/docs/pr-preview/pr-58/platform/pki/crl#references","References",{"_4098":2140,"_34307":2129,"_23429":63610,"_5":16198,"_30870":2129,"_3543":63611},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_4098":2141,"_34307":2129,"_23429":63613,"_5":16198,"_30870":63575,"_3543":63614},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_4098":2142,"_34307":2129,"_23429":63616,"_5":16198,"_30870":63575,"_3543":63617},[],"`crl_options` field",{"_4098":2143,"_34307":2129,"_23429":63619,"_5":16198,"_30870":63575,"_3543":57326},[],{"_4098":2144,"_34307":2129,"_23429":63621,"_5":16198,"_30870":63575,"_3543":63622},[],"Backend initial value",{"_4098":2145,"_34307":2129,"_23429":63624,"_5":16198,"_30870":63575,"_3543":63625},[],"`validity`",{"_4098":2146,"_34307":2129,"_23429":63627,"_5":16198,"_30870":63575,"_3543":63628},[],"Time from `thisUpdate` to `nextUpdate`.",{"_4098":2147,"_34307":2129,"_23429":63630,"_5":16198,"_30870":63575,"_3543":63631},[],"7 days.",{"_4098":2148,"_34307":2129,"_23429":63633,"_5":16198,"_30870":63575,"_3543":63634},[],"`refresh_interval`",{"_4098":2149,"_34307":2129,"_23429":63636,"_5":16198,"_30870":63575,"_3543":63637},[],"Stored and returned by the API, but the VA does not use it: scheduled renewal does not depend on it (see Periodic and automatic regeneration).",{"_4098":2150,"_34307":2129,"_23429":63639,"_5":16198,"_30870":63575,"_3543":63640},[],"6 days and 23 hours.",{"_4098":2151,"_34307":2129,"_23429":63642,"_5":16198,"_30870":63575,"_3543":63643},[],"`regenerate_on_revoke`",{"_4098":2152,"_34307":2129,"_23429":63645,"_5":16198,"_30870":63575,"_3543":63646},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_4098":2153,"_34307":2129,"_23429":63648,"_5":16198,"_30870":63575,"_3543":63649},[],"`true`.",{"_4098":2154,"_34307":2129,"_23429":63651,"_5":16198,"_30870":63575,"_3543":63652},[],"`signer_certificate_serial_number`",{"_4098":2155,"_34307":2129,"_23429":63654,"_5":16198,"_30870":63575,"_3543":63655},[],"Serial number of the existing certificate that signs the CRL.",{"_4098":2156,"_34307":2129,"_23429":63657,"_5":16198,"_30870":63575,"_3543":63658},[],"Serial number of the CA’s current certificate.",{"_4098":2157,"_34307":2129,"_23429":63660,"_5":16198,"_30870":63575,"_3543":63661},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_4098":2158,"_34307":2129,"_23429":63663,"_5":16198,"_30870":63575,"_3543":63664},[],"When a CA is reissued, the role keeps pointing at the previous certificate. CRLs remain valid because both certificates share subject and key, but the previous certificate cannot be deleted while the role uses it. To retire it, update the role’s signer.",{"_4098":2159,"_34307":2129,"_23429":63666,"_5":16198,"_30870":63575,"_3543":63667},[],"When a CA is deleted, its VA role is kept and cannot be removed through the API. If no other CA with the same SKI remains, the role can be read but any `PUT` returns 404, and the renewal job logs a warning on every cycle because it no longer finds the CA. The API offers no way out; it can only be fixed by editing the database. If another CA with that SKI remains, the role is still editable (see CAs that share a key). Adjust validity and signer before deleting the CA.",{"_4098":2160,"_34307":2129,"_23429":63669,"_5":16198,"_30870":63575,"_3543":63670},[],"A CA whose certificate lacks `cRLSign` cannot generate its CRL or edit its role (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and set it as the signer with `PUT`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages.",{"_4098":2161,"_34307":2129,"_23429":63672,"_5":16198,"_30870":63575,"_3543":63673},[],"`PUT` always validates the signer, even when the request does not change it. If the stored signer is no longer valid, no field of the role can be modified, not even the validity, until a valid one is set.",{"_4098":2162,"_34307":2129,"_23429":63675,"_5":16198,"_30870":63575,"_3543":63676},[],"Sharing a key between CAs can prevent CRL validation. See CAs that share a key.",{"_4098":2163,"_34307":2129,"_23429":63678,"_5":16198,"_30870":63575,"_3543":63679},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_4098":2164,"_34307":2129,"_23429":63681,"_5":16198,"_30870":63579,"_3543":63682},[],"The VA identifies each CRL by the CA’s SKI, and the SKI is derived from its key. Two CAs with the same key have the same SKI and share a single VA role and a single CRL. This happens when a CA is created on an existing KMS key, or when a CA is imported whose certificate declares an SKI already in use. Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. The first CA creates the role and the others keep it.",{"_4098":2165,"_34307":2129,"_23429":63684,"_5":16198,"_30870":63579,"_3543":63685},[],"The certificates of all of them point to `/crl/{ski}`, but the published list has the first CA as issuer and only includes its revocations. A verifier compares the CRL issuer with the issuer of the certificate it validates (RFC 5280, §6.3.2) and rejects the list if they differ. Depending on its policy, the certificate is blocked (*hard-fail*) or accepted even though it is revoked (*soft-fail*). Revocations of the secondary CAs do not appear in any list.",{"_4098":2166,"_34307":2129,"_23429":63687,"_5":16198,"_30870":63579,"_3543":63688},[],"If the first CA is deleted, CRL generation for the remaining one fails because the configured signer no longer matches a CA with that name. Until the role’s signer is updated to a certificate of the remaining CA, the last published list keeps being served until it expires (7 days by default).",{"_4098":2167,"_34307":2129,"_23429":63690,"_5":16198,"_30870":63579,"_3543":63691},[],"Before upgrading, review CAs that share a key. To detect the problem, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued. A CA imported with an SKI already in use does not replace the existing one as CRL issuer, because the issuer is resolved from the role’s signer. However, its own certificates point to that same URL and its revocations are not published. Until Lamassu rejects these imports, restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same collision, so also avoid reusing keys across CAs. A per-CA CRL and the rejection of imports whose SKI collides with an existing CA are both proposed in lamassuiot#834, and neither is implemented yet.",{"_4098":2168,"_34307":2129,"_23429":63693,"_5":16198,"_30870":63583,"_3543":63694},[],"The VA scheduled job checks every role on each run and requests another list when the remaining validity of `latest_crl` is less than the interval between runs. The frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. `refresh_interval` plays no part. Keep `validity` well above the interval: with a shorter validity, the list is regenerated on every cycle.",{"_4098":2169,"_34307":2129,"_23429":63696,"_5":16198,"_30870":63583,"_3543":63697},[],"If generation fails (for example, because of a role without a CA or an invalid signer), the job logs the warning `something went wrong while calculating CRL for CA <ski>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_4098":2170,"_34307":2129,"_23429":63699,"_5":16198,"_30870":63583,"_3543":63700},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if it fails (missing role, invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_4098":2171,"_34307":2129,"_23429":63702,"_5":16198,"_30870":63583,"_3543":63703},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_4098":2172,"_34307":2129,"_23429":63705,"_5":16198,"_30870":63587,"_3543":63706},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_4098":2173,"_34307":2129,"_23429":63708,"_5":16198,"_30870":63587,"_3543":63709},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_4098":2174,"_34307":2129,"_23429":63711,"_5":16198,"_30870":63591,"_3543":63712},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_4098":2175,"_34307":2129,"_23429":63714,"_5":16198,"_30870":63591,"_3543":63715},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_4098":2176,"_34307":2129,"_23429":63717,"_5":16198,"_30870":63591,"_3543":63718},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the role points to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_4098":2177,"_34307":2129,"_23429":63720,"_5":16198,"_30870":63591,"_3543":63721},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_4098":2178,"_34307":2129,"_23429":63723,"_5":16198,"_30870":63591,"_3543":63724},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_4098":2179,"_34307":2129,"_23429":63726,"_5":16198,"_30870":63595,"_3543":63727},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_4098":2180,"_34307":2129,"_23429":63729,"_5":16198,"_30870":63595,"_3543":60171},[],{"_4098":2181,"_34307":2129,"_23429":63731,"_5":16198,"_30870":63595,"_3543":63732},[],"Relative path",{"_4098":2182,"_34307":2129,"_23429":63734,"_5":16198,"_30870":63595,"_3543":60168},[],{"_4098":2183,"_34307":2129,"_23429":63736,"_5":16198,"_30870":63595,"_3543":63737},[],"`GET`",{"_4098":2184,"_34307":2129,"_23429":63739,"_5":16198,"_30870":63595,"_3543":63740},[],"`/v1/roles/{ca-ski}`",{"_4098":2185,"_34307":2129,"_23429":63742,"_5":16198,"_30870":63595,"_3543":63743},[],"Read `crl_options` and `latest_crl`.",{"_4098":2186,"_34307":2129,"_23429":63745,"_5":16198,"_30870":63595,"_3543":63746},[],"`PUT`",{"_4098":2187,"_34307":2129,"_23429":63748,"_5":16198,"_30870":63595,"_3543":63740},[],{"_4098":2188,"_34307":2129,"_23429":63750,"_5":16198,"_30870":63595,"_3543":63751},[],"Replace CRL configuration.",{"_4098":2189,"_34307":2129,"_23429":63753,"_5":16198,"_30870":63595,"_3543":63754},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_4098":2190,"_34307":2129,"_23429":63756,"_5":16198,"_30870":63595,"_3543":63757},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_4098":2191,"_34307":2129,"_23429":63759,"_5":16198,"_30870":63599,"_3543":63760},[],"Symptom",{"_4098":2192,"_34307":2129,"_23429":63762,"_5":16198,"_30870":63599,"_3543":63763},[],"Cause",{"_4098":2193,"_34307":2129,"_23429":63765,"_5":16198,"_30870":63599,"_3543":63766},[],"Action",{"_4098":2194,"_34307":2129,"_23429":63768,"_5":16198,"_30870":63599,"_3543":63769},[],"`PUT /v1/roles/{ca-ski}` returns 404 and `GET` returns 200.",{"_4098":2195,"_34307":2129,"_23429":63771,"_5":16198,"_30870":63599,"_3543":63772},[],"The role’s CA was deleted and no other CA with the same SKI remains.",{"_4098":2196,"_34307":2129,"_23429":63774,"_5":16198,"_30870":63599,"_3543":63775},[],"There is no API way out; it requires database intervention. Avoid it by adjusting the role before deleting the CA.",{"_4098":2197,"_34307":2129,"_23429":63777,"_5":16198,"_30870":63599,"_3543":63778},[],"`PUT` returns 400.",{"_4098":2198,"_34307":2129,"_23429":63780,"_5":16198,"_30870":63599,"_3543":63781},[],"The signer lacks `cRLSign`, or its subject and key match no CA with that SKI (for example, after deleting the first of two CAs that share a key).",{"_4098":2199,"_34307":2129,"_23429":63783,"_5":16198,"_30870":63599,"_3543":63784},[],"Use `PUT` to set the serial number of a valid certificate of the remaining CA.",{"_4098":2200,"_34307":2129,"_23429":63786,"_5":16198,"_30870":63599,"_3543":63787},[],"`PUT` returns 400 from a 3.x client.",{"_4098":2201,"_34307":2129,"_23429":63789,"_5":16198,"_30870":63599,"_3543":63790},[],"`crl_options.subject_key_id_signer` was replaced by `signer_certificate_serial_number`, which is required.",{"_4098":2202,"_34307":2129,"_23429":63792,"_5":16198,"_30870":63599,"_3543":63793},[],"Update the client to send the new field.",{"_4098":2203,"_34307":2129,"_23429":63795,"_5":16198,"_30870":63599,"_3543":63796},[],"The CRL does not change after revoking a certificate.",{"_4098":2204,"_34307":2129,"_23429":63798,"_5":16198,"_30870":63599,"_3543":63799},[],"`regenerate_on_revoke` is `false`, or the event failed because of a missing role or an invalid signer.",{"_4098":2205,"_34307":2129,"_23429":63801,"_5":16198,"_30870":63599,"_3543":63802},[],"Check the VA logs and the failed-events queue; fix the signer.",{"_4098":2206,"_34307":2129,"_23429":63804,"_5":16198,"_30870":63599,"_3543":63805},[],"A verifier rejects the CRL because of the issuer.",{"_4098":2207,"_34307":2129,"_23429":63807,"_5":16198,"_30870":63599,"_3543":63808},[],"Several CAs share an SKI.",{"_4098":2208,"_34307":2129,"_23429":63810,"_5":16198,"_30870":63599,"_3543":63811},[],"See CAs that share a key.",{"_4098":2209,"_34307":2129,"_23429":63813,"_5":16198,"_30870":63603,"_3543":63814},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. The CA’s VA settings also let you select the CRL signer: the certificate picker only offers certificates that have a private key and carry the `cRLSign` key usage. If a configured signer’s certificate cannot be resolved, the interface shows `Unknown Certificate (Serial: X)` or `Certificate details unavailable (Serial: X)`. Diagnose differences using PKI troubleshooting.",{"_4098":2210,"_34307":2129,"_23429":63816,"_5":16198,"_30870":63607,"_3543":63817},[],"RFC 5280: X.509 and CRL profile.",{"_4098":2211,"_34307":2129,"_23429":63819,"_5":16198,"_30870":63607,"_3543":63820},[],"OpenSSL: openssl-crl.",{"_4098":2212,"_34307":2129,"_23429":63822,"_5":16198,"_30870":63607,"_3543":63823},[],"OpenSSL: openssl-verify.",{"_4098":2213,"_34307":2129,"_23429":63825,"_5":16198,"_30870":63607,"_3543":63826},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_4098":2214,"_34307":2129,"_23429":63828,"_5":16198,"_30870":63607,"_3543":63829},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_4098":2215,"_34307":2215,"_5":16596,"_3543":63831,"_34738":63832,"_23429":63833,"_30870":2215},"Keys and cryptographic engines",[56936,58404,62406,62407],[],{"_4098":2216,"_34307":2215,"_23429":63835,"_5":16198,"_30870":2215,"_3543":63836},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_4098":2217,"_34307":2215,"_5":34735,"_23429":63838,"_30870":63839,"_3543":63840},[],"/docs/pr-preview/pr-58/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_4098":2218,"_34307":2215,"_5":34735,"_23429":63842,"_30870":63843,"_3543":63844},[],"/docs/pr-preview/pr-58/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_4098":2219,"_34307":2215,"_5":34735,"_23429":63846,"_30870":63847,"_3543":63848},[],"/docs/pr-preview/pr-58/platform/pki/key-management#file-system","File System",{"_4098":2220,"_34307":2215,"_5":34735,"_23429":63850,"_30870":63851,"_3543":63852},[],"/docs/pr-preview/pr-58/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_4098":2221,"_34307":2215,"_5":34735,"_23429":63854,"_30870":63855,"_3543":63856},[],"/docs/pr-preview/pr-58/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_4098":2222,"_34307":2215,"_5":34735,"_23429":63858,"_30870":63859,"_3543":63860},[],"/docs/pr-preview/pr-58/platform/pki/key-management#aws-kms","AWS KMS",{"_4098":2223,"_34307":2215,"_5":34735,"_23429":63862,"_30870":63863,"_3543":63864},[],"/docs/pr-preview/pr-58/platform/pki/key-management#pkcs11","PKCS#11",{"_4098":2224,"_34307":2215,"_5":34735,"_23429":63866,"_30870":63867,"_3543":63868},[],"/docs/pr-preview/pr-58/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_4098":2225,"_34307":2215,"_5":34735,"_23429":63870,"_30870":63871,"_3543":63872},[],"/docs/pr-preview/pr-58/platform/pki/key-management#key-inventory","Key inventory",{"_4098":2226,"_34307":2215,"_5":34735,"_23429":63874,"_30870":63875,"_3543":63876},[],"/docs/pr-preview/pr-58/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_4098":2227,"_34307":2215,"_5":34735,"_23429":63878,"_30870":63879,"_3543":63880},[],"/docs/pr-preview/pr-58/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_4098":2228,"_34307":2215,"_5":34735,"_23429":63882,"_30870":63883,"_3543":63884},[],"/docs/pr-preview/pr-58/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_4098":2229,"_34307":2215,"_5":34735,"_23429":63886,"_30870":63887,"_3543":63888},[],"/docs/pr-preview/pr-58/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_4098":2230,"_34307":2215,"_5":34735,"_23429":63890,"_30870":63891,"_3543":63892},[],"/docs/pr-preview/pr-58/platform/pki/key-management#view-details","View details",{"_4098":2231,"_34307":2215,"_5":34735,"_23429":63894,"_30870":63895,"_3543":63896},[],"/docs/pr-preview/pr-58/platform/pki/key-management#sign-and-verify","Sign and verify",{"_4098":2232,"_34307":2215,"_5":34735,"_23429":63898,"_30870":63899,"_3543":63900},[],"/docs/pr-preview/pr-58/platform/pki/key-management#sign","Sign",{"_4098":2233,"_34307":2215,"_5":34735,"_23429":63902,"_30870":63903,"_3543":63904},[],"/docs/pr-preview/pr-58/platform/pki/key-management#verify","Verify",{"_4098":2234,"_34307":2215,"_5":34735,"_23429":63906,"_30870":63907,"_3543":63908},[],"/docs/pr-preview/pr-58/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_4098":2235,"_34307":2215,"_5":34735,"_23429":63910,"_30870":63911,"_3543":63912},[],"/docs/pr-preview/pr-58/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_4098":2236,"_34307":2215,"_5":34735,"_23429":63914,"_30870":63915,"_3543":63916},[],"/docs/pr-preview/pr-58/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_4098":2237,"_34307":2215,"_23429":63918,"_5":16198,"_30870":2215,"_3543":63919},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_4098":2238,"_34307":2215,"_23429":63921,"_5":16198,"_30870":2215,"_3543":63922},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_4098":2239,"_34307":2215,"_23429":63924,"_5":16198,"_30870":63839,"_3543":63925},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_4098":2240,"_34307":2215,"_23429":63927,"_5":16198,"_30870":63839,"_3543":63928},[],"In practice, it lets you:",{"_4098":2241,"_34307":2215,"_23429":63930,"_5":16198,"_30870":63839,"_3543":63931},[],"Generate new key pairs from Lamassu IoT.",{"_4098":2242,"_34307":2215,"_23429":63933,"_5":16198,"_30870":63839,"_3543":63934},[],"Import keys created externally.",{"_4098":2243,"_34307":2215,"_23429":63936,"_5":16198,"_30870":63839,"_3543":63937},[],"Delegate custody and cryptographic operations to external engines.",{"_4098":2244,"_34307":2215,"_23429":63939,"_5":16198,"_30870":63839,"_3543":63940},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_4098":2245,"_34307":2215,"_23429":63942,"_5":16198,"_30870":63843,"_3543":63943},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_4098":2246,"_34307":2215,"_23429":63945,"_5":16198,"_30870":63843,"_3543":63946},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_4098":2247,"_34307":2215,"_23429":63948,"_5":16198,"_30870":63843,"_3543":63949},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_4098":2248,"_34307":2215,"_23429":63951,"_5":16198,"_30870":63847,"_3543":63952},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_4098":2249,"_34307":2215,"_23429":63954,"_5":16198,"_30870":63851,"_3543":63955},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_4098":2250,"_34307":2215,"_23429":63957,"_5":16198,"_30870":63851,"_3543":63958},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_4098":2251,"_34307":2215,"_23429":63960,"_5":16198,"_30870":63855,"_3543":63961},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_4098":2252,"_34307":2215,"_23429":63963,"_5":16198,"_30870":63859,"_3543":63964},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_4098":2253,"_34307":2215,"_23429":63966,"_5":16198,"_30870":63863,"_3543":63967},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_4098":2254,"_34307":2215,"_23429":63969,"_5":16198,"_30870":63867,"_3543":63970},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_4098":2255,"_34307":2215,"_23429":63972,"_5":16198,"_30870":63867,"_3543":63973},[],"Lamassu shows the enabled engines in the console.",{"_4098":2256,"_34307":2215,"_23429":63975,"_5":16198,"_30870":63867,"_3543":63976},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_4098":2257,"_34307":2215,"_23429":63978,"_5":16198,"_30870":63867,"_3543":63979},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_4098":2258,"_34307":2215,"_23429":63981,"_5":16198,"_30870":63871,"_3543":63982},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_4098":2259,"_34307":2215,"_23429":63984,"_5":16198,"_30870":63871,"_3543":63985},[],"The table includes the following fields:",{"_4098":2260,"_34307":2215,"_23429":63987,"_5":16198,"_30870":63871,"_3543":63988},[],"**Name**: descriptive name of the key.",{"_4098":2261,"_34307":2215,"_23429":63990,"_5":16198,"_30870":63871,"_3543":63991},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_4098":2262,"_34307":2215,"_23429":63993,"_5":16198,"_30870":63871,"_3543":63994},[],"**Strength**: visual indicator of cryptographic strength.",{"_4098":2263,"_34307":2215,"_23429":63996,"_5":16198,"_30870":63871,"_3543":63997},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_4098":2264,"_34307":2215,"_23429":63999,"_5":16198,"_30870":63871,"_3543":64000},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_4098":2265,"_34307":2215,"_23429":64002,"_5":16198,"_30870":63871,"_3543":64003},[],"**Aliases**: alternative names associated with the key.",{"_4098":2266,"_34307":2215,"_23429":64005,"_5":16198,"_30870":63871,"_3543":64006},[],"**Tags**: labels for classification and search.",{"_4098":2267,"_34307":2215,"_23429":64008,"_5":16198,"_30870":63871,"_3543":64009},[],"**Related Entities**: certificates or other entities linked to that key.",{"_4098":2268,"_34307":2215,"_23429":64011,"_5":16198,"_30870":63871,"_3543":64012},[],"From this view you also reach the most common actions:",{"_4098":2269,"_34307":2215,"_23429":64014,"_5":16198,"_30870":63871,"_3543":64015},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_4098":2270,"_34307":2215,"_23429":64017,"_5":16198,"_30870":63871,"_3543":64018},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_4098":2271,"_34307":2215,"_23429":64020,"_5":16198,"_30870":63871,"_3543":64021},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_4098":2272,"_34307":2215,"_23429":64023,"_5":16198,"_30870":63871,"_3543":64024},[],"**Delete Key** to remove the key from the system.",{"_4098":2273,"_34307":2215,"_23429":64026,"_5":16198,"_30870":63875,"_3543":64027},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_4098":2274,"_34307":2215,"_23429":64029,"_5":16198,"_30870":63879,"_3543":64030},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_4098":2275,"_34307":2215,"_23429":64032,"_5":16198,"_30870":63879,"_3543":64033},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_4098":2276,"_34307":2215,"_23429":64035,"_5":16198,"_30870":63879,"_3543":64036},[],"**Key Name**: unique and descriptive name.",{"_4098":2277,"_34307":2215,"_23429":64038,"_5":16198,"_30870":63879,"_3543":64039},[],"**Crypto Engine**: engine that will keep the key.",{"_4098":2278,"_34307":2215,"_23429":64041,"_5":16198,"_30870":63879,"_3543":64042},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_4098":2279,"_34307":2215,"_23429":64044,"_5":16198,"_30870":63879,"_3543":64045},[],"**Tags**: metadata to classify the key.",{"_4098":2280,"_34307":2215,"_23429":64047,"_5":16198,"_30870":63879,"_3543":64048},[],"**Metadata**: additional information for advanced uses.",{"_4098":2281,"_34307":2215,"_23429":64050,"_5":16198,"_30870":63883,"_3543":64051},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_4098":2282,"_34307":2215,"_23429":64053,"_5":16198,"_30870":63883,"_3543":64054},[],"When you have an exportable private key and the destination engine supports import.",{"_4098":2283,"_34307":2215,"_23429":64056,"_5":16198,"_30870":63883,"_3543":64057},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_4098":2284,"_34307":2215,"_23429":64059,"_5":16198,"_30870":63883,"_3543":64060},[],"When Lamassu must operate with a root of trust created by a third party.",{"_4098":2285,"_34307":2215,"_23429":64062,"_5":16198,"_30870":63883,"_3543":64063},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_4098":2286,"_34307":2215,"_23429":64065,"_5":16198,"_30870":63883,"_3543":64066},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_4098":2287,"_34307":2215,"_23429":64068,"_5":16198,"_30870":63883,"_3543":64069},[],"**Crypto Engine**: engine that will keep the imported key.",{"_4098":2288,"_34307":2215,"_23429":64071,"_5":16198,"_30870":63883,"_3543":64072},[],"**Tags**: labels for organization and search.",{"_4098":2289,"_34307":2215,"_23429":64074,"_5":16198,"_30870":63883,"_3543":64075},[],"**Metadata**: additional optional information.",{"_4098":2290,"_34307":2215,"_23429":64077,"_5":16198,"_30870":63883,"_3543":64078},[],"**Private Key (PEM)**: private key in PEM format.",{"_4098":2291,"_34307":2215,"_23429":64080,"_5":16198,"_30870":63883,"_3543":64081},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_4098":2292,"_34307":2215,"_23429":64083,"_5":16198,"_30870":63887,"_3543":64084},[],"Each registered key has a detail view and several operational actions.",{"_4098":2293,"_34307":2215,"_23429":64086,"_5":16198,"_30870":63891,"_3543":64087},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_4098":2294,"_34307":2215,"_23429":64089,"_5":16198,"_30870":63891,"_3543":64090},[],"The **Overview** tab shows, among others, these fields:",{"_4098":2295,"_34307":2215,"_23429":64092,"_5":16198,"_30870":63891,"_3543":64093},[],"**Key Name**: descriptive name.",{"_4098":2296,"_34307":2215,"_23429":64095,"_5":16198,"_30870":63891,"_3543":64096},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_4098":2297,"_34307":2215,"_23429":64098,"_5":16198,"_30870":63891,"_3543":64099},[],"**Tags**: associated labels.",{"_4098":2298,"_34307":2215,"_23429":64101,"_5":16198,"_30870":63891,"_3543":64102},[],"**Aliases**: alternative names.",{"_4098":2299,"_34307":2215,"_23429":64104,"_5":16198,"_30870":63891,"_3543":64105},[],"**Crypto Engine**: engine where the key resides.",{"_4098":2300,"_34307":2215,"_23429":64107,"_5":16198,"_30870":63891,"_3543":64108},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_4098":2301,"_34307":2215,"_23429":64110,"_5":16198,"_30870":63891,"_3543":64111},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_4098":2302,"_34307":2215,"_23429":64113,"_5":16198,"_30870":63891,"_3543":64114},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_4098":2303,"_34307":2215,"_23429":64116,"_5":16198,"_30870":63895,"_3543":64117},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_4098":2304,"_34307":2215,"_23429":64119,"_5":16198,"_30870":63895,"_3543":64120},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_4098":2305,"_34307":2215,"_23429":64122,"_5":16198,"_30870":63895,"_3543":64123},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_4098":2306,"_34307":2215,"_23429":64125,"_5":16198,"_30870":63899,"_3543":64126},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_4098":2307,"_34307":2215,"_23429":64128,"_5":16198,"_30870":63899,"_3543":64129},[],"Main fields:",{"_4098":2308,"_34307":2215,"_23429":64131,"_5":16198,"_30870":63899,"_3543":64132},[],"**Algorithm**: signing algorithm available for the key type.",{"_4098":2309,"_34307":2215,"_23429":64134,"_5":16198,"_30870":63899,"_3543":64135},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_4098":2310,"_34307":2215,"_23429":64137,"_5":16198,"_30870":63899,"_3543":64138},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_4098":2311,"_34307":2215,"_23429":64140,"_5":16198,"_30870":63899,"_3543":64141},[],"**Message**: content to sign.",{"_4098":2312,"_34307":2215,"_23429":64143,"_5":16198,"_30870":63899,"_3543":64144},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_4098":2313,"_34307":2215,"_23429":64146,"_5":16198,"_30870":63903,"_3543":64147},[],"This tab checks whether a signature corresponds to the associated public key.",{"_4098":2314,"_34307":2215,"_23429":64149,"_5":16198,"_30870":63903,"_3543":64129},[],{"_4098":2315,"_34307":2215,"_23429":64151,"_5":16198,"_30870":63903,"_3543":64152},[],"**Algorithm**: must match the algorithm used for the signature.",{"_4098":2316,"_34307":2215,"_23429":64154,"_5":16198,"_30870":63903,"_3543":64155},[],"**Message Type**: `Raw` or `Digest`.",{"_4098":2317,"_34307":2215,"_23429":64157,"_5":16198,"_30870":63903,"_3543":64158},[],"**Payload Encoding**: encoding of the message.",{"_4098":2318,"_34307":2215,"_23429":64160,"_5":16198,"_30870":63903,"_3543":64161},[],"**Message**: original message or hash.",{"_4098":2319,"_34307":2215,"_23429":64163,"_5":16198,"_30870":63903,"_3543":64164},[],"**Signature**: signature to check.",{"_4098":2320,"_34307":2215,"_23429":64166,"_5":16198,"_30870":63903,"_3543":64167},[],"**Result**: indicator of the validation result.",{"_4098":2321,"_34307":2215,"_23429":64169,"_5":16198,"_30870":63907,"_3543":64170},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_4098":2322,"_34307":2215,"_23429":64172,"_5":16198,"_30870":63907,"_3543":64173},[],"This flow is useful for:",{"_4098":2323,"_34307":2215,"_23429":64175,"_5":16198,"_30870":63907,"_3543":64176},[],"Requesting certificates from an external CA.",{"_4098":2324,"_34307":2215,"_23429":64178,"_5":16198,"_30870":63907,"_3543":64179},[],"Renewing an identity while keeping the same key.",{"_4098":2325,"_34307":2215,"_23429":64181,"_5":16198,"_30870":63907,"_3543":64182},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_4098":2326,"_34307":2215,"_23429":64184,"_5":16198,"_30870":63907,"_3543":64185},[],"**Common Name (CN)**: main name of the identity.",{"_4098":2327,"_34307":2215,"_23429":64187,"_5":16198,"_30870":63907,"_3543":64188},[],"**Organization (O)**: organization or company.",{"_4098":2328,"_34307":2215,"_23429":64190,"_5":16198,"_30870":63907,"_3543":64191},[],"**Organizational Unit (OU)**: department or unit.",{"_4098":2329,"_34307":2215,"_23429":64193,"_5":16198,"_30870":63907,"_3543":64194},[],"**Country (C)**: two-letter country code.",{"_4098":2330,"_34307":2215,"_23429":64196,"_5":16198,"_30870":63907,"_3543":64197},[],"**State / Province (ST)**: state or province.",{"_4098":2331,"_34307":2215,"_23429":64199,"_5":16198,"_30870":63907,"_3543":64200},[],"**Locality (L)**: city or locality.",{"_4098":2332,"_34307":2215,"_23429":64202,"_5":16198,"_30870":63907,"_3543":64203},[],"**Email Address**: contact email.",{"_4098":2333,"_34307":2215,"_23429":64205,"_5":16198,"_30870":63907,"_3543":64206},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_4098":2334,"_34307":2215,"_23429":64208,"_5":16198,"_30870":63907,"_3543":64209},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_4098":2335,"_34307":2215,"_23429":64211,"_5":16198,"_30870":63911,"_3543":64212},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_4098":2336,"_34307":2215,"_23429":64214,"_5":16198,"_30870":63911,"_3543":64215},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_4098":2337,"_34307":2215,"_23429":64217,"_5":16198,"_30870":63915,"_3543":64218},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_4098":2338,"_34307":2215,"_23429":64220,"_5":16198,"_30870":63915,"_3543":64221},[],"The KMS refuses to delete a key that certificates still reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. Revoking certificates issued by the deleted CA does not release their own key references. Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_4098":2339,"_34307":2339,"_5":16596,"_3543":64223,"_34738":64224,"_23429":64225,"_30870":2339},"Online validation with OCSP",[56936,58404,62406,63039],[],{"_4098":2340,"_34307":2339,"_23429":64227,"_5":16198,"_30870":2339,"_3543":64228},[],"Query signed status and verify the responder’s response.",{"_4098":2341,"_34307":2339,"_5":34735,"_23429":64230,"_30870":64231,"_3543":64232},[],"/docs/pr-preview/pr-58/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_4098":2342,"_34307":2339,"_5":34735,"_23429":64234,"_30870":64235,"_3543":64236},[],"/docs/pr-preview/pr-58/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_4098":2343,"_34307":2339,"_5":34735,"_23429":64238,"_30870":64239,"_3543":64240},[],"/docs/pr-preview/pr-58/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_4098":2344,"_34307":2339,"_5":34735,"_23429":64242,"_30870":64243,"_3543":64244},[],"/docs/pr-preview/pr-58/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_4098":2345,"_34307":2339,"_5":34735,"_23429":64246,"_30870":64247,"_3543":64248},[],"/docs/pr-preview/pr-58/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_4098":2346,"_34307":2339,"_5":34735,"_23429":64250,"_30870":64251,"_3543":63608},[],"/docs/pr-preview/pr-58/platform/pki/ocsp#references",{"_4098":2347,"_34307":2339,"_23429":64253,"_5":16198,"_30870":2339,"_3543":64254},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_4098":2348,"_34307":2339,"_23429":64256,"_5":16198,"_30870":64231,"_3543":64257},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_4098":2349,"_34307":2339,"_23429":64259,"_5":16198,"_30870":64231,"_3543":64260},[],"Record status",{"_4098":2350,"_34307":2339,"_23429":64262,"_5":16198,"_30870":64231,"_3543":64263},[],"Signed response",{"_4098":2351,"_34307":2339,"_23429":64265,"_5":16198,"_30870":64231,"_3543":61543},[],{"_4098":2352,"_34307":2339,"_23429":64267,"_5":16198,"_30870":64231,"_3543":64268},[],"`Good`.",{"_4098":2353,"_34307":2339,"_23429":64270,"_5":16198,"_30870":64231,"_3543":61560},[],{"_4098":2354,"_34307":2339,"_23429":64272,"_5":16198,"_30870":64231,"_3543":64273},[],"`Revoked`, with revocation reason and timestamp.",{"_4098":2355,"_34307":2339,"_23429":64275,"_5":16198,"_30870":64231,"_3543":64276},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_4098":2356,"_34307":2339,"_23429":64278,"_5":16198,"_30870":64231,"_3543":64279},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_4098":2357,"_34307":2339,"_23429":64281,"_5":16198,"_30870":64231,"_3543":64282},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_4098":2358,"_34307":2339,"_23429":64284,"_5":16198,"_30870":64231,"_3543":64285},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_4098":2359,"_34307":2339,"_23429":64287,"_5":16198,"_30870":64231,"_3543":64288},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_4098":2360,"_34307":2339,"_23429":64290,"_5":16198,"_30870":64235,"_3543":64291},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_4098":2361,"_34307":2339,"_23429":64293,"_5":16198,"_30870":64235,"_3543":64294},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_4098":2362,"_34307":2339,"_23429":64296,"_5":16198,"_30870":64239,"_3543":64297},[],"The service accepts:",{"_4098":2363,"_34307":2339,"_23429":64299,"_5":16198,"_30870":64239,"_3543":60171},[],{"_4098":2364,"_34307":2339,"_23429":64301,"_5":16198,"_30870":64239,"_3543":64302},[],"VA service path",{"_4098":2365,"_34307":2339,"_23429":64304,"_5":16198,"_30870":64239,"_3543":64305},[],"Format",{"_4098":2366,"_34307":2339,"_23429":64307,"_5":16198,"_30870":64239,"_3543":64308},[],"`POST`",{"_4098":2367,"_34307":2339,"_23429":64310,"_5":16198,"_30870":64239,"_3543":64311},[],"`/ocsp`",{"_4098":2368,"_34307":2339,"_23429":64313,"_5":16198,"_30870":64239,"_3543":64314},[],"DER request, `Content-Type: application/ocsp-request`.",{"_4098":2369,"_34307":2339,"_23429":64316,"_5":16198,"_30870":64239,"_3543":63737},[],{"_4098":2370,"_34307":2339,"_23429":64318,"_5":16198,"_30870":64239,"_3543":64319},[],"`/ocsp/{ocsp_request}`",{"_4098":2371,"_34307":2339,"_23429":64321,"_5":16198,"_30870":64239,"_3543":64322},[],"DER request encoded using padded URL Base64.",{"_4098":2372,"_34307":2339,"_23429":64324,"_5":16198,"_30870":64239,"_3543":64325},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_4098":2373,"_34307":2339,"_23429":64327,"_5":16198,"_30870":64243,"_3543":64328},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_4098":2374,"_34307":2339,"_23429":64330,"_5":16198,"_30870":64243,"_3543":64331},[],"Generate the request:",{"_4098":2375,"_34307":2339,"_23429":64333,"_5":16198,"_30870":64243,"_3543":64334},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_4098":2376,"_34307":2339,"_23429":64336,"_5":16198,"_30870":64243,"_3543":64337},[],"Replace the example URL with the inspected endpoint:",{"_4098":2377,"_34307":2339,"_23429":64339,"_5":16198,"_30870":64243,"_3543":64340},[],"Verify the returned DER:",{"_4098":2378,"_34307":2339,"_23429":64342,"_5":16198,"_30870":64243,"_3543":64343},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_4098":2379,"_34307":2339,"_23429":64345,"_5":16198,"_30870":64247,"_3543":64346},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_4098":2380,"_34307":2339,"_23429":64348,"_5":16198,"_30870":64247,"_3543":64349},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_4098":2381,"_34307":2339,"_23429":64351,"_5":16198,"_30870":64251,"_3543":64352},[],"RFC 6960: OCSP.",{"_4098":2382,"_34307":2339,"_23429":64354,"_5":16198,"_30870":64251,"_3543":64355},[],"OpenSSL: openssl-ocsp.",{"_4098":2383,"_34307":2339,"_23429":64357,"_5":16198,"_30870":64251,"_3543":64358},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_4098":2384,"_34307":2339,"_23429":64360,"_5":16198,"_30870":64251,"_3543":63829},[],{"_4098":2385,"_34307":2385,"_5":16596,"_3543":62406,"_34738":64362,"_23429":64363,"_30870":2385},[56936,58404,62406],[],{"_4098":2386,"_34307":2385,"_23429":64365,"_5":16198,"_30870":2385,"_3543":64366},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_4098":2387,"_34307":2385,"_5":34735,"_23429":64368,"_30870":64369,"_3543":61718},[],"/docs/pr-preview/pr-58/platform/pki/overview#start-here",{"_4098":2388,"_34307":2385,"_5":34735,"_23429":64371,"_30870":64372,"_3543":64373},[],"/docs/pr-preview/pr-58/platform/pki/overview#what-you-need","What you need",{"_4098":2389,"_34307":2385,"_5":34735,"_23429":64375,"_30870":64376,"_3543":62250},[],"/docs/pr-preview/pr-58/platform/pki/overview#core-capabilities",{"_4098":2390,"_34307":2385,"_5":34735,"_23429":64378,"_30870":64379,"_3543":62254},[],"/docs/pr-preview/pr-58/platform/pki/overview#build-your-trust-hierarchy",{"_4098":2391,"_34307":2385,"_5":34735,"_23429":64381,"_30870":64382,"_3543":62258},[],"/docs/pr-preview/pr-58/platform/pki/overview#protect-cryptographic-keys",{"_4098":2392,"_34307":2385,"_5":34735,"_23429":64384,"_30870":64385,"_3543":62262},[],"/docs/pr-preview/pr-58/platform/pki/overview#issue-and-control-certificates",{"_4098":2393,"_34307":2385,"_5":34735,"_23429":64387,"_30870":64388,"_3543":62270},[],"/docs/pr-preview/pr-58/platform/pki/overview#publish-validation-status",{"_4098":2394,"_34307":2385,"_5":34735,"_23429":64390,"_30870":64391,"_3543":64392},[],"/docs/pr-preview/pr-58/platform/pki/overview#how-to-check-the-result","How to check the result",{"_4098":2395,"_34307":2385,"_5":34735,"_23429":64394,"_30870":64395,"_3543":63206},[],"/docs/pr-preview/pr-58/platform/pki/overview#continue",{"_4098":2396,"_34307":2385,"_23429":64397,"_5":16198,"_30870":2385,"_3543":64398},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_4098":2397,"_34307":2385,"_23429":64400,"_5":16198,"_30870":64369,"_3543":64401},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_4098":2398,"_34307":2385,"_23429":64403,"_5":16198,"_30870":64369,"_3543":64404},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_4098":2399,"_34307":2385,"_23429":64406,"_5":16198,"_30870":64372,"_3543":64407},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_4098":2400,"_34307":2385,"_23429":64409,"_5":16198,"_30870":64372,"_3543":64410},[],"An available cryptographic engine to keep the authority's key.",{"_4098":2401,"_34307":2385,"_23429":64412,"_5":16198,"_30870":64372,"_3543":64413},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_4098":2402,"_34307":2385,"_23429":64415,"_5":16198,"_30870":64372,"_3543":64416},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_4098":2403,"_34307":2385,"_23429":64418,"_5":16198,"_30870":64372,"_3543":64419},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_4098":2404,"_34307":2385,"_23429":64421,"_5":16198,"_30870":64379,"_3543":64422},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_4098":2405,"_34307":2385,"_23429":64424,"_5":16198,"_30870":64382,"_3543":64425},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_4098":2406,"_34307":2385,"_23429":64427,"_5":16198,"_30870":64385,"_3543":64428},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_4098":2407,"_34307":2385,"_23429":64430,"_5":16198,"_30870":64388,"_3543":64431},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_4098":2408,"_34307":2385,"_23429":64433,"_5":16198,"_30870":64391,"_3543":64434},[],"An active certificate in the console is one part of the check. Also verify that:",{"_4098":2409,"_34307":2385,"_23429":64436,"_5":16198,"_30870":64391,"_3543":64437},[],"its subject and extensions identify the expected client;",{"_4098":2410,"_34307":2385,"_23429":64439,"_5":16198,"_30870":64391,"_3543":64440},[],"its public key matches the client's private key;",{"_4098":2411,"_34307":2385,"_23429":64442,"_5":16198,"_30870":64391,"_3543":64443},[],"its chain reaches a root trusted by the consumer;",{"_4098":2412,"_34307":2385,"_23429":64445,"_5":16198,"_30870":64391,"_3543":64446},[],"its dates and usages allow the operation;",{"_4098":2413,"_34307":2385,"_23429":64448,"_5":16198,"_30870":64391,"_3543":64449},[],"the consumer applies revocation checks and authorization.",{"_4098":2414,"_34307":2385,"_23429":64451,"_5":16198,"_30870":64391,"_3543":64452},[],"The issuance path includes the first independent checks.",{"_4098":2415,"_34307":2385,"_23429":64454,"_5":16198,"_30870":64395,"_3543":64455},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_4098":2416,"_34307":2385,"_23429":64457,"_5":16198,"_30870":64395,"_3543":64458},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_4098":2417,"_34307":2385,"_23429":64460,"_5":16198,"_30870":64395,"_3543":64461},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_4098":2418,"_34307":2418,"_5":16596,"_3543":64463,"_34738":64464,"_23429":64465,"_30870":2418},"Create your first CA",[56936,58404,62406,61843],[],{"_4098":2419,"_34307":2418,"_23429":64467,"_5":16198,"_30870":2418,"_3543":64468},[],"Create an evaluation root and check its certificate before issuing.",{"_4098":2420,"_34307":2418,"_5":34735,"_23429":64470,"_30870":64471,"_3543":56946},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_4098":2421,"_34307":2418,"_5":34735,"_23429":64473,"_30870":64474,"_3543":64475},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_4098":2422,"_34307":2418,"_5":34735,"_23429":64477,"_30870":64478,"_3543":64479},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_4098":2423,"_34307":2418,"_5":34735,"_23429":64481,"_30870":64482,"_3543":64483},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_4098":2424,"_34307":2418,"_5":34735,"_23429":64485,"_30870":64486,"_3543":64487},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_4098":2425,"_34307":2418,"_5":34735,"_23429":64489,"_30870":64490,"_3543":64491},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_4098":2426,"_34307":2418,"_5":34735,"_23429":64493,"_30870":64494,"_3543":64495},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_4098":2427,"_34307":2418,"_5":34735,"_23429":64497,"_30870":64498,"_3543":62100},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_4098":2428,"_34307":2418,"_5":34735,"_23429":64500,"_30870":64501,"_3543":56970},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/create-certificate-authority#next-step",{"_4098":2429,"_34307":2418,"_23429":64503,"_5":16198,"_30870":2418,"_3543":64504},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_4098":2430,"_34307":2418,"_23429":64506,"_5":16198,"_30870":64471,"_3543":64507},[],"Console access and permission to create keys and authorities.",{"_4098":2431,"_34307":2418,"_23429":64509,"_5":16198,"_30870":64471,"_3543":64510},[],"An available cryptographic engine that supports the chosen algorithm.",{"_4098":2432,"_34307":2418,"_23429":64512,"_5":16198,"_30870":64471,"_3543":64513},[],"OpenSSL 3.x to check the downloaded certificate.",{"_4098":2433,"_34307":2418,"_23429":64515,"_5":16198,"_30870":64471,"_3543":64516},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_4098":2434,"_34307":2418,"_23429":64518,"_5":16198,"_30870":64474,"_3543":64519},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_4098":2435,"_34307":2418,"_23429":64521,"_5":16198,"_30870":64474,"_3543":64522},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_4098":2436,"_34307":2418,"_23429":64524,"_5":16198,"_30870":64478,"_3543":64525},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_4098":2437,"_34307":2418,"_23429":64527,"_5":16198,"_30870":64478,"_3543":64528},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_4098":2438,"_34307":2418,"_23429":64530,"_5":16198,"_30870":64482,"_3543":64531},[],"Select **Root CA** and complete:",{"_4098":2439,"_34307":2418,"_23429":64533,"_5":16198,"_30870":64482,"_3543":64534},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_4098":2440,"_34307":2418,"_23429":64536,"_5":16198,"_30870":64482,"_3543":64537},[],"**Subject**: organization and country details for your evaluation.",{"_4098":2441,"_34307":2418,"_23429":64539,"_5":16198,"_30870":64482,"_3543":64540},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_4098":2442,"_34307":2418,"_23429":64542,"_5":16198,"_30870":64482,"_3543":64543},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_4098":2443,"_34307":2418,"_23429":64545,"_5":16198,"_30870":64482,"_3543":64546},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_4098":2444,"_34307":2418,"_23429":64548,"_5":16198,"_30870":64486,"_3543":64549},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_4098":2445,"_34307":2418,"_23429":64551,"_5":16198,"_30870":64490,"_3543":64552},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_4098":2446,"_34307":2418,"_23429":64554,"_5":16198,"_30870":64490,"_3543":64555},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_4098":2447,"_34307":2418,"_23429":64557,"_5":16198,"_30870":64494,"_3543":64558},[],"Run from the directory where you saved `ca.pem`:",{"_4098":2448,"_34307":2418,"_23429":64560,"_5":16198,"_30870":64494,"_3543":64561},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_4098":2449,"_34307":2418,"_23429":64563,"_5":16198,"_30870":64494,"_3543":64564},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_4098":2450,"_34307":2418,"_23429":64566,"_5":16198,"_30870":64498,"_3543":64567},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_4098":2451,"_34307":2418,"_23429":64569,"_5":16198,"_30870":64498,"_3543":64570},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_4098":2452,"_34307":2418,"_23429":64572,"_5":16198,"_30870":64498,"_3543":64573},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_4098":2453,"_34307":2418,"_23429":64575,"_5":16198,"_30870":64498,"_3543":64576},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_4098":2454,"_34307":2418,"_23429":64578,"_5":16198,"_30870":64501,"_3543":64579},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_4098":2455,"_34307":2455,"_5":16596,"_3543":64581,"_34738":64582,"_23429":64583,"_30870":2455},"Issue and verify a certificate",[56936,58404,62406,61843],[],{"_4098":2456,"_34307":2455,"_23429":64585,"_5":16198,"_30870":2455,"_3543":64586},[],"Issue a client certificate and check content, chain and key correspondence.",{"_4098":2457,"_34307":2455,"_5":34735,"_23429":64588,"_30870":64589,"_3543":56946},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_4098":2458,"_34307":2455,"_5":34735,"_23429":64591,"_30870":64592,"_3543":64593},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_4098":2459,"_34307":2455,"_5":34735,"_23429":64595,"_30870":64596,"_3543":64597},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_4098":2460,"_34307":2455,"_5":34735,"_23429":64599,"_30870":64600,"_3543":64601},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_4098":2461,"_34307":2455,"_5":34735,"_23429":64603,"_30870":64604,"_3543":64605},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_4098":2462,"_34307":2455,"_5":34735,"_23429":64607,"_30870":64608,"_3543":64609},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_4098":2463,"_34307":2455,"_5":34735,"_23429":64611,"_30870":64612,"_3543":64613},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_4098":2464,"_34307":2455,"_5":34735,"_23429":64615,"_30870":64616,"_3543":64617},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_4098":2465,"_34307":2455,"_5":34735,"_23429":64619,"_30870":64620,"_3543":64621},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_4098":2466,"_34307":2455,"_5":34735,"_23429":64623,"_30870":64624,"_3543":64625},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_4098":2467,"_34307":2455,"_5":34735,"_23429":64627,"_30870":64628,"_3543":62100},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_4098":2468,"_34307":2455,"_5":34735,"_23429":64630,"_30870":64631,"_3543":56970},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/issue-certificate#next-step",{"_4098":2469,"_34307":2455,"_23429":64633,"_5":16198,"_30870":2455,"_3543":64634},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_4098":2470,"_34307":2455,"_23429":64636,"_5":16198,"_30870":64589,"_3543":64637},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_4098":2471,"_34307":2455,"_23429":64639,"_5":16198,"_30870":64589,"_3543":64640},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_4098":2472,"_34307":2455,"_23429":64642,"_5":16198,"_30870":64589,"_3543":64643},[],"OpenSSL 3.x and a working directory with restricted access.",{"_4098":2473,"_34307":2455,"_23429":64645,"_5":16198,"_30870":64589,"_3543":64646},[],"A client identifier: here we use `device-001`.",{"_4098":2474,"_34307":2455,"_23429":64648,"_5":16198,"_30870":64589,"_3543":64649},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_4098":2475,"_34307":2455,"_23429":64651,"_5":16198,"_30870":64592,"_3543":64652},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_4098":2476,"_34307":2455,"_23429":64654,"_5":16198,"_30870":64596,"_3543":64655},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_4098":2477,"_34307":2455,"_23429":64657,"_5":16198,"_30870":64596,"_3543":64658},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_4098":2478,"_34307":2455,"_23429":64660,"_5":16198,"_30870":64600,"_3543":64661},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_4098":2479,"_34307":2455,"_23429":64663,"_5":16198,"_30870":64600,"_3543":64664},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_4098":2480,"_34307":2455,"_23429":64666,"_5":16198,"_30870":64604,"_3543":64667},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_4098":2481,"_34307":2455,"_23429":64669,"_5":16198,"_30870":64604,"_3543":64670},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_4098":2482,"_34307":2455,"_23429":64672,"_5":16198,"_30870":64608,"_3543":64673},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_4098":2483,"_34307":2455,"_23429":64675,"_5":16198,"_30870":64612,"_3543":64676},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_4098":2484,"_34307":2455,"_23429":64678,"_5":16198,"_30870":64616,"_3543":64679},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_4098":2485,"_34307":2455,"_23429":64681,"_5":16198,"_30870":64620,"_3543":64682},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_4098":2486,"_34307":2455,"_23429":64684,"_5":16198,"_30870":64620,"_3543":64685},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_4098":2487,"_34307":2455,"_23429":64687,"_5":16198,"_30870":64620,"_3543":64688},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_4098":2488,"_34307":2455,"_23429":64690,"_5":16198,"_30870":64624,"_3543":64691},[],"In Bash, compare the two public-key digests:",{"_4098":2489,"_34307":2455,"_23429":64693,"_5":16198,"_30870":64624,"_3543":64694},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_4098":2490,"_34307":2455,"_23429":64696,"_5":16198,"_30870":64624,"_3543":64697},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_4098":2491,"_34307":2455,"_23429":64699,"_5":16198,"_30870":64628,"_3543":62184},[],{"_4098":2492,"_34307":2455,"_23429":64701,"_5":16198,"_30870":64628,"_3543":64702},[],"What to review",{"_4098":2493,"_34307":2455,"_23429":64704,"_5":16198,"_30870":64628,"_3543":64705},[],"The CA rejects issuance",{"_4098":2494,"_34307":2455,"_23429":64707,"_5":16198,"_30870":64628,"_3543":64708},[],"Permissions, CA state and key, algorithm and profile.",{"_4098":2495,"_34307":2455,"_23429":64710,"_5":16198,"_30870":64628,"_3543":64711},[],"Different subject or usages",{"_4098":2496,"_34307":2455,"_23429":64713,"_5":16198,"_30870":64628,"_3543":64714},[],"Applied profile and requested values.",{"_4098":2497,"_34307":2455,"_23429":64716,"_5":16198,"_30870":64628,"_3543":64717},[],"Issuer cannot be found",{"_4098":2498,"_34307":2455,"_23429":64719,"_5":16198,"_30870":64628,"_3543":64720},[],"Downloaded CA and required intermediate chain.",{"_4098":2499,"_34307":2455,"_23429":64722,"_5":16198,"_30870":64628,"_3543":64723},[],"Validity fails",{"_4098":2500,"_34307":2455,"_23429":64725,"_5":16198,"_30870":64628,"_3543":64726},[],"Certificate and CA dates, and the computer's clock.",{"_4098":2501,"_34307":2455,"_23429":64728,"_5":16198,"_30870":64628,"_3543":64729},[],"Public-key digests differ",{"_4098":2502,"_34307":2455,"_23429":64731,"_5":16198,"_30870":64628,"_3543":64732},[],"Certificate and key files from the same issuance.",{"_4098":2503,"_34307":2455,"_23429":64734,"_5":16198,"_30870":64628,"_3543":64735},[],"See PKI diagnostics to narrow an issuance failure.",{"_4098":2504,"_34307":2455,"_23429":64737,"_5":16198,"_30870":64631,"_3543":64738},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_4098":2505,"_34307":2455,"_23429":64740,"_5":16198,"_30870":64631,"_3543":64741},[],"Manage certificates for inspection, status and revocation.",{"_4098":2506,"_34307":2455,"_23429":64743,"_5":16198,"_30870":64631,"_3543":64744},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_4098":2507,"_34307":2455,"_23429":64746,"_5":16198,"_30870":64631,"_3543":64747},[],"Prepare EST for the device to request its next identities.",{"_4098":2508,"_34307":2455,"_23429":64749,"_5":16198,"_30870":64631,"_3543":64750},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_4098":2509,"_34307":2509,"_5":16596,"_3543":64752,"_34738":64753,"_23429":64754,"_30870":2509},"PKI getting started",[56936,58404,62406,61843],[],{"_4098":2510,"_34307":2509,"_23429":64756,"_5":16198,"_30870":2509,"_3543":64757},[],"Create a CA, issue a client certificate and check its chain and key.",{"_4098":2511,"_34307":2509,"_5":34735,"_23429":64759,"_30870":64760,"_3543":56946},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/overview#before-you-begin",{"_4098":2512,"_34307":2509,"_5":34735,"_23429":64762,"_30870":64763,"_3543":64764},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_4098":2513,"_34307":2509,"_5":34735,"_23429":64766,"_30870":64767,"_3543":62035},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/overview#expected-result",{"_4098":2514,"_34307":2509,"_5":34735,"_23429":64769,"_30870":64770,"_3543":64771},[],"/docs/pr-preview/pr-58/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_4098":2515,"_34307":2509,"_23429":64773,"_5":16198,"_30870":2509,"_3543":64774},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_4098":2516,"_34307":2509,"_23429":64776,"_5":16198,"_30870":64760,"_3543":64777},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_4098":2517,"_34307":2509,"_23429":64779,"_5":16198,"_30870":64760,"_3543":64780},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_4098":2518,"_34307":2509,"_23429":64782,"_5":16198,"_30870":64760,"_3543":64783},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_4098":2519,"_34307":2509,"_23429":64785,"_5":16198,"_30870":64760,"_3543":64786},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_4098":2520,"_34307":2509,"_23429":64788,"_5":16198,"_30870":64760,"_3543":64789},[],"A working directory with restricted access for the downloaded key.",{"_4098":2521,"_34307":2509,"_23429":64791,"_5":16198,"_30870":64763,"_3543":64792},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_4098":2522,"_34307":2509,"_23429":64794,"_5":16198,"_30870":64763,"_3543":64795},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_4098":2523,"_34307":2509,"_23429":64797,"_5":16198,"_30870":64763,"_3543":64798},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_4098":2524,"_34307":2509,"_23429":64800,"_5":16198,"_30870":64763,"_3543":64801},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_4098":2525,"_34307":2509,"_23429":64803,"_5":16198,"_30870":64767,"_3543":64804},[],"File or resource",{"_4098":2526,"_34307":2509,"_23429":64806,"_5":16198,"_30870":64767,"_3543":62032},[],{"_4098":2527,"_34307":2509,"_23429":64808,"_5":16198,"_30870":64767,"_3543":64809},[],"Active root CA and `ca.pem`",{"_4098":2528,"_34307":2509,"_23429":64811,"_5":16198,"_30870":64767,"_3543":64812},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_4098":2529,"_34307":2509,"_23429":64814,"_5":16198,"_30870":64767,"_3543":64815},[],"End-entity certificate and `device.crt`",{"_4098":2530,"_34307":2509,"_23429":64817,"_5":16198,"_30870":64767,"_3543":64818},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_4098":2531,"_34307":2509,"_23429":64820,"_5":16198,"_30870":64767,"_3543":64821},[],"Private key `device.key`",{"_4098":2532,"_34307":2509,"_23429":64823,"_5":16198,"_30870":64767,"_3543":64824},[],"Its public key matches the one included in `device.crt`.",{"_4098":2533,"_34307":2509,"_23429":64826,"_5":16198,"_30870":64767,"_3543":64827},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_4098":2534,"_34307":2509,"_23429":64829,"_5":16198,"_30870":64770,"_3543":64830},[],"To operate certificates, continue with Certificates and Validation.",{"_4098":2535,"_34307":2509,"_23429":64832,"_5":16198,"_30870":64770,"_3543":64833},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_4098":2536,"_34307":2509,"_23429":64835,"_5":16198,"_30870":64770,"_3543":64836},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_4098":2537,"_34307":2537,"_5":16596,"_3543":64838,"_34738":64839,"_23429":64840,"_30870":2537},"PKI troubleshooting",[56936,58404,62406,60981],[],{"_4098":2538,"_34307":2537,"_23429":64842,"_5":16198,"_30870":2537,"_3543":64843},[],"Diagnose certificate issuance, OCSP and CRL.",{"_4098":2539,"_34307":2537,"_5":34735,"_23429":64845,"_30870":64846,"_3543":64847},[],"/docs/pr-preview/pr-58/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_4098":2540,"_34307":2537,"_5":34735,"_23429":64849,"_30870":64850,"_3543":64851},[],"/docs/pr-preview/pr-58/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_4098":2541,"_34307":2537,"_5":34735,"_23429":64853,"_30870":64854,"_3543":64855},[],"/docs/pr-preview/pr-58/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_4098":2542,"_34307":2537,"_23429":64857,"_5":16198,"_30870":2537,"_3543":64858},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_4098":2543,"_34307":2537,"_23429":64860,"_5":16198,"_30870":2537,"_3543":64861},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_4098":2544,"_34307":2537,"_23429":64863,"_5":16198,"_30870":64846,"_3543":62032},[],{"_4098":2545,"_34307":2537,"_23429":64865,"_5":16198,"_30870":64846,"_3543":64866},[],"What to inspect",{"_4098":2546,"_34307":2537,"_23429":64868,"_5":16198,"_30870":64846,"_3543":56970},[],{"_4098":2547,"_34307":2537,"_23429":64870,"_5":16198,"_30870":64846,"_3543":61248},[],{"_4098":2548,"_34307":2537,"_23429":64872,"_5":16198,"_30870":64846,"_3543":64873},[],"Exists, is active and has usable dates.",{"_4098":2549,"_34307":2537,"_23429":64875,"_5":16198,"_30870":64846,"_3543":64876},[],"Authorities.",{"_4098":2550,"_34307":2537,"_23429":64878,"_5":16198,"_30870":64846,"_3543":64879},[],"Key",{"_4098":2551,"_34307":2537,"_23429":64881,"_5":16198,"_30870":64846,"_3543":64882},[],"The record has a usable private key and the engine can sign.",{"_4098":2552,"_34307":2537,"_23429":64884,"_5":16198,"_30870":64846,"_3543":64885},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_4098":2553,"_34307":2537,"_23429":64887,"_5":16198,"_30870":64846,"_3543":64888},[],"CSR",{"_4098":2554,"_34307":2537,"_23429":64890,"_5":16198,"_30870":64846,"_3543":64891},[],"Correct PEM and verifiable signature.",{"_4098":2555,"_34307":2537,"_23429":64893,"_5":16198,"_30870":64846,"_3543":64894},[],"`openssl req -in request.csr -noout -verify -text`.",{"_4098":2556,"_34307":2537,"_23429":64896,"_5":16198,"_30870":64846,"_3543":64897},[],"Profile",{"_4098":2557,"_34307":2537,"_23429":64899,"_5":16198,"_30870":64846,"_3543":64900},[],"Selected source, existing ID, allowed algorithm and size.",{"_4098":2558,"_34307":2537,"_23429":64902,"_5":16198,"_30870":64846,"_3543":64903},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_4098":2559,"_34307":2537,"_23429":64905,"_5":16198,"_30870":64846,"_3543":62184},[],{"_4098":2560,"_34307":2537,"_23429":64907,"_5":16198,"_30870":64846,"_3543":64908},[],"Appropriate subject, SAN, usages and dates.",{"_4098":2561,"_34307":2537,"_23429":64910,"_5":16198,"_30870":64846,"_3543":64911},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_4098":2562,"_34307":2537,"_23429":64913,"_5":16198,"_30870":64846,"_3543":64914},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_4098":2563,"_34307":2537,"_23429":64916,"_5":16198,"_30870":64846,"_3543":64917},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_4098":2564,"_34307":2537,"_23429":64919,"_5":16198,"_30870":64850,"_3543":64920},[],"Check each boundary independently:",{"_4098":2565,"_34307":2537,"_23429":64922,"_5":16198,"_30870":64850,"_3543":64923},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_4098":2566,"_34307":2537,"_23429":64925,"_5":16198,"_30870":64850,"_3543":64926},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_4098":2567,"_34307":2537,"_23429":64928,"_5":16198,"_30870":64850,"_3543":64929},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_4098":2568,"_34307":2537,"_23429":64931,"_5":16198,"_30870":64850,"_3543":64932},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_4098":2569,"_34307":2537,"_23429":64934,"_5":16198,"_30870":64850,"_3543":64935},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_4098":2570,"_34307":2537,"_23429":64937,"_5":16198,"_30870":64850,"_3543":64938},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_4098":2571,"_34307":2537,"_23429":64940,"_5":16198,"_30870":64854,"_3543":64941},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_4098":2572,"_34307":2537,"_23429":64943,"_5":16198,"_30870":64854,"_3543":64944},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_4098":2573,"_34307":2573,"_5":16596,"_3543":64946,"_34738":64947,"_23429":64950,"_30870":2573},"Algorithms",[56936,58404,64948,64949],"[Beta] Post-quantum (PQC)","Algorithms and toolchain",[],{"_4098":2574,"_34307":2573,"_23429":64952,"_5":16198,"_30870":2573,"_3543":64953},[],"The post-quantum and composite signature algorithms Lamassu supports, how each is identified in API requests, and the standards they follow.",{"_4098":2575,"_34307":2573,"_5":34735,"_23429":64955,"_30870":64956,"_3543":64957},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#how-an-algorithm-is-selected","How an algorithm is selected",{"_4098":2576,"_34307":2573,"_5":34735,"_23429":64959,"_30870":64960,"_3543":64961},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#ml-dsa","ML-DSA",{"_4098":2577,"_34307":2573,"_5":34735,"_23429":64963,"_30870":64964,"_3543":64965},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#slh-dsa","SLH-DSA",{"_4098":2578,"_34307":2573,"_5":34735,"_23429":64967,"_30870":64968,"_3543":64969},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#composite-ml-dsa","Composite ML-DSA",{"_4098":2579,"_34307":2573,"_5":34735,"_23429":64971,"_30870":64972,"_3543":64973},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#ed25519","Ed25519",{"_4098":2580,"_34307":2573,"_5":34735,"_23429":64975,"_30870":64976,"_3543":64977},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#choosing-an-algorithm","Choosing an algorithm",{"_4098":2581,"_34307":2573,"_5":34735,"_23429":64979,"_30870":64980,"_3543":64981},[],"/docs/pr-preview/pr-58/platform/pqc/algorithms#what-is-not-covered","What is not covered",{"_4098":2582,"_34307":2573,"_23429":64983,"_5":16198,"_30870":2573,"_3543":64984},[],"Lamassu supports four groups of signature algorithms beyond RSA and ECDSA: ML-DSA, SLH-DSA, composite ML-DSA and Ed25519. All of them come from the Go PQC toolchain; the backend only selects the algorithm and delegates the cryptography.",{"_4098":2583,"_34307":2573,"_23429":64986,"_5":16198,"_30870":64956,"_3543":64987},[],"A key or CA is created with a key type and a size. For RSA and ECDSA the size is a bit length or a curve. For the post-quantum algorithms the same field carries a **parameter set identifier**, not a number of bits:",{"_4098":2584,"_34307":2573,"_23429":64989,"_5":16198,"_30870":64956,"_3543":64990},[],"Key type (`algorithm` / `type`)",{"_4098":2585,"_34307":2573,"_23429":64992,"_5":16198,"_30870":64956,"_3543":64993},[],"Value of `size` / `bits`",{"_4098":2586,"_34307":2573,"_23429":64995,"_5":16198,"_30870":64956,"_3543":59475},[],{"_4098":2587,"_34307":2573,"_23429":64997,"_5":16198,"_30870":64956,"_3543":64998},[],"`RSA`",{"_4098":2588,"_34307":2573,"_23429":65000,"_5":16198,"_30870":64956,"_3543":65001},[],"2048, 3072, 4096",{"_4098":2589,"_34307":2573,"_23429":65003,"_5":16198,"_30870":64956,"_3543":65004},[],"Modulus length in bits.",{"_4098":2590,"_34307":2573,"_23429":65006,"_5":16198,"_30870":64956,"_3543":65007},[],"`ECDSA`",{"_4098":2591,"_34307":2573,"_23429":65009,"_5":16198,"_30870":64956,"_3543":65010},[],"256, 384, 521",{"_4098":2592,"_34307":2573,"_23429":65012,"_5":16198,"_30870":64956,"_3543":65013},[],"Curve size in bits (P-256, P-384, P-521).",{"_4098":2593,"_34307":2573,"_23429":65015,"_5":16198,"_30870":64956,"_3543":65016},[],"`Ed25519`",{"_4098":2594,"_34307":2573,"_23429":65018,"_5":16198,"_30870":64956,"_3543":11864},[],{"_4098":2595,"_34307":2573,"_23429":65020,"_5":16198,"_30870":64956,"_3543":65021},[],"Fixed. Any other value is replaced by 256.",{"_4098":2596,"_34307":2573,"_23429":65023,"_5":16198,"_30870":64956,"_3543":65024},[],"`ML-DSA`",{"_4098":2597,"_34307":2573,"_23429":65026,"_5":16198,"_30870":64956,"_3543":65027},[],"44, 65, 87",{"_4098":2598,"_34307":2573,"_23429":65029,"_5":16198,"_30870":64956,"_3543":65030},[],"ML-DSA parameter set.",{"_4098":2599,"_34307":2573,"_23429":65032,"_5":16198,"_30870":64956,"_3543":65033},[],"`SLH-DSA`",{"_4098":2600,"_34307":2573,"_23429":65035,"_5":16198,"_30870":64956,"_3543":65036},[],"1 to 12",{"_4098":2601,"_34307":2573,"_23429":65038,"_5":16198,"_30870":64956,"_3543":65039},[],"SLH-DSA parameter set, in the order below.",{"_4098":2602,"_34307":2573,"_23429":65041,"_5":16198,"_30870":64956,"_3543":65042},[],"`Composite-ML-DSA-RSA`",{"_4098":2603,"_34307":2573,"_23429":65044,"_5":16198,"_30870":64956,"_3543":65045},[],"1 to 8",{"_4098":2604,"_34307":2573,"_23429":65047,"_5":16198,"_30870":64956,"_3543":65048},[],"Composite variant with an RSA component.",{"_4098":2605,"_34307":2573,"_23429":65050,"_5":16198,"_30870":64956,"_3543":65051},[],"`Composite-ML-DSA-ECDSA`",{"_4098":2606,"_34307":2573,"_23429":65053,"_5":16198,"_30870":64956,"_3543":65054},[],"9 to 13",{"_4098":2607,"_34307":2573,"_23429":65056,"_5":16198,"_30870":64956,"_3543":65057},[],"Composite variant with an ECDSA component.",{"_4098":2608,"_34307":2573,"_23429":65059,"_5":16198,"_30870":64956,"_3543":65060},[],"`Composite-ML-DSA-Ed25519`",{"_4098":2609,"_34307":2573,"_23429":65062,"_5":16198,"_30870":64956,"_3543":65063},[],"14 and 15",{"_4098":2610,"_34307":2573,"_23429":65065,"_5":16198,"_30870":64956,"_3543":65066},[],"Composite variant with an Ed25519 component.",{"_4098":2611,"_34307":2573,"_23429":65068,"_5":16198,"_30870":64956,"_3543":65069},[],"An unknown key type string is not rejected when it is parsed; it becomes an unknown type and fails later. Use the exact strings above.",{"_4098":2612,"_34307":2573,"_23429":65071,"_5":16198,"_30870":64960,"_3543":65072},[],"ML-DSA is the lattice-based signature scheme standardized in FIPS 204. Lamassu accepts the three parameter sets ML-DSA-44, ML-DSA-65 and ML-DSA-87, selected with `size` 44, 65 or 87. The implementation is the `crypto/mldsa` package of Go 1.27, so it is the standard library's own code and not part of the fork. In certificates the algorithm identifiers are `2.16.840.1.101.3.4.3.17`, `.18` and `.19` for ML-DSA-44, -65 and -87.",{"_4098":2613,"_34307":2573,"_23429":65074,"_5":16198,"_30870":64960,"_3543":65075},[],"Parameter set",{"_4098":2614,"_34307":2573,"_23429":65077,"_5":16198,"_30870":64960,"_3543":65078},[],"NIST security category",{"_4098":2615,"_34307":2573,"_23429":65080,"_5":16198,"_30870":64960,"_3543":65081},[],"ML-DSA-44",{"_4098":2616,"_34307":2573,"_23429":65083,"_5":16198,"_30870":64960,"_3543":11806},[],{"_4098":2617,"_34307":2573,"_23429":65085,"_5":16198,"_30870":64960,"_3543":65086},[],"ML-DSA-65",{"_4098":2618,"_34307":2573,"_23429":65088,"_5":16198,"_30870":64960,"_3543":11743},[],{"_4098":2619,"_34307":2573,"_23429":65090,"_5":16198,"_30870":64960,"_3543":65091},[],"ML-DSA-87",{"_4098":2620,"_34307":2573,"_23429":65093,"_5":16198,"_30870":64960,"_3543":11935},[],{"_4098":2621,"_34307":2573,"_23429":65095,"_5":16198,"_30870":64960,"_3543":65096},[],"A higher category means larger keys and signatures in exchange for more security margin.",{"_4098":2622,"_34307":2573,"_23429":65098,"_5":16198,"_30870":64960,"_3543":65099},[],"Go reads ML-DSA private keys in PKCS#8 only when they contain the 32-byte seed. Keys written by OpenSSL in its default seed-plus-expanded form are rejected, so export them in the seed-only form before importing them.",{"_4098":2623,"_34307":2573,"_23429":65101,"_5":16198,"_30870":64964,"_3543":65102},[],"SLH-DSA is the hash-based scheme of FIPS 205. It offers twelve parameter sets that combine a hash family (SHA-2 or SHAKE), the parameter n of 128, 192 or 256 bits, which corresponds to NIST security categories 1, 3 and 5 and a trade-off between signature size and signing speed (`s` for small signatures, `f` for fast signing). The identifier written in `size` follows the order of the underlying library:",{"_4098":2624,"_34307":2573,"_23429":65104,"_5":16198,"_30870":64964,"_3543":65105},[],"ID",{"_4098":2625,"_34307":2573,"_23429":65107,"_5":16198,"_30870":64964,"_3543":65075},[],{"_4098":2626,"_34307":2573,"_23429":65109,"_5":16198,"_30870":64964,"_3543":65105},[],{"_4098":2627,"_34307":2573,"_23429":65111,"_5":16198,"_30870":64964,"_3543":65075},[],{"_4098":2628,"_34307":2573,"_23429":65113,"_5":16198,"_30870":64964,"_3543":11645},[],{"_4098":2629,"_34307":2573,"_23429":65115,"_5":16198,"_30870":64964,"_3543":65116},[],"SLH-DSA-SHA2-128s",{"_4098":2630,"_34307":2573,"_23429":65118,"_5":16198,"_30870":64964,"_3543":11636},[],{"_4098":2631,"_34307":2573,"_23429":65120,"_5":16198,"_30870":64964,"_3543":65121},[],"SLH-DSA-SHA2-192f",{"_4098":2632,"_34307":2573,"_23429":65123,"_5":16198,"_30870":64964,"_3543":11806},[],{"_4098":2633,"_34307":2573,"_23429":65125,"_5":16198,"_30870":64964,"_3543":65126},[],"SLH-DSA-SHAKE-128s",{"_4098":2634,"_34307":2573,"_23429":65128,"_5":16198,"_30870":64964,"_3543":11617},[],{"_4098":2635,"_34307":2573,"_23429":65130,"_5":16198,"_30870":64964,"_3543":65131},[],"SLH-DSA-SHAKE-192f",{"_4098":2636,"_34307":2573,"_23429":65133,"_5":16198,"_30870":64964,"_3543":11743},[],{"_4098":2637,"_34307":2573,"_23429":65135,"_5":16198,"_30870":64964,"_3543":65136},[],"SLH-DSA-SHA2-128f",{"_4098":2638,"_34307":2573,"_23429":65138,"_5":16198,"_30870":64964,"_3543":29450},[],{"_4098":2639,"_34307":2573,"_23429":65140,"_5":16198,"_30870":64964,"_3543":65141},[],"SLH-DSA-SHA2-256s",{"_4098":2640,"_34307":2573,"_23429":65143,"_5":16198,"_30870":64964,"_3543":11596},[],{"_4098":2641,"_34307":2573,"_23429":65145,"_5":16198,"_30870":64964,"_3543":65146},[],"SLH-DSA-SHAKE-128f",{"_4098":2642,"_34307":2573,"_23429":65148,"_5":16198,"_30870":64964,"_3543":33356},[],{"_4098":2643,"_34307":2573,"_23429":65150,"_5":16198,"_30870":64964,"_3543":65151},[],"SLH-DSA-SHAKE-256s",{"_4098":2644,"_34307":2573,"_23429":65153,"_5":16198,"_30870":64964,"_3543":11935},[],{"_4098":2645,"_34307":2573,"_23429":65155,"_5":16198,"_30870":64964,"_3543":65156},[],"SLH-DSA-SHA2-192s",{"_4098":2646,"_34307":2573,"_23429":65158,"_5":16198,"_30870":64964,"_3543":33390},[],{"_4098":2647,"_34307":2573,"_23429":65160,"_5":16198,"_30870":64964,"_3543":65161},[],"SLH-DSA-SHA2-256f",{"_4098":2648,"_34307":2573,"_23429":65163,"_5":16198,"_30870":64964,"_3543":11605},[],{"_4098":2649,"_34307":2573,"_23429":65165,"_5":16198,"_30870":64964,"_3543":65166},[],"SLH-DSA-SHAKE-192s",{"_4098":2650,"_34307":2573,"_23429":65168,"_5":16198,"_30870":64964,"_3543":32852},[],{"_4098":2651,"_34307":2573,"_23429":65170,"_5":16198,"_30870":64964,"_3543":65171},[],"SLH-DSA-SHAKE-256f",{"_4098":2652,"_34307":2573,"_23429":65173,"_5":16198,"_30870":64964,"_3543":65174},[],"The SLH-DSA implementation is provided by Cloudflare's CIRCL library, which the fork integrates so that SLH-DSA keys can be used in X.509 certificates. The object identifiers run from `2.16.840.1.101.3.4.3.20` to `.31`. SLH-DSA signatures are large, between about 8 and 50 KB depending on the parameter set, which matters for certificate chains and for any transport with a size limit. SLH-DSA is available for keys, CAs and certificates, but the fork has no TLS signature scheme for it, so an SLH-DSA certificate cannot authenticate a TLS connection.",{"_4098":2653,"_34307":2573,"_23429":65176,"_5":16198,"_30870":64968,"_3543":65177},[],"A composite key pairs an ML-DSA key with a traditional key. A composite signature is the concatenation of the ML-DSA signature and the traditional signature, both computed over a message representative that contains a fixed prefix, an algorithm label, an optional context and a hash of the message; verification fails if either component fails. The ML-DSA component is pure ML-DSA, with the label as its context. Lamassu implements the 15 algorithms of RFC 10073 that rely only on algorithms available in Go. The identifiers sit under the arc `1.3.6.1.5.5.7.6`.",{"_4098":2654,"_34307":2573,"_23429":65179,"_5":16198,"_30870":64968,"_3543":65180},[],"`size`",{"_4098":2655,"_34307":2573,"_23429":65182,"_5":16198,"_30870":64968,"_3543":65183},[],"Algorithm",{"_4098":2656,"_34307":2573,"_23429":65185,"_5":16198,"_30870":64968,"_3543":65186},[],"Final OID digit",{"_4098":2657,"_34307":2573,"_23429":65188,"_5":16198,"_30870":64968,"_3543":65189},[],"Family",{"_4098":2658,"_34307":2573,"_23429":65191,"_5":16198,"_30870":64968,"_3543":11645},[],{"_4098":2659,"_34307":2573,"_23429":65193,"_5":16198,"_30870":64968,"_3543":65194},[],"MLDSA44-RSA2048-PSS-SHA256",{"_4098":2660,"_34307":2573,"_23429":65196,"_5":16198,"_30870":64968,"_3543":34181},[],{"_4098":2661,"_34307":2573,"_23429":65198,"_5":16198,"_30870":64968,"_3543":65199},[],"RSA",{"_4098":2662,"_34307":2573,"_23429":65201,"_5":16198,"_30870":64968,"_3543":11806},[],{"_4098":2663,"_34307":2573,"_23429":65203,"_5":16198,"_30870":64968,"_3543":65204},[],"MLDSA44-RSA2048-PKCS15-SHA256",{"_4098":2664,"_34307":2573,"_23429":65206,"_5":16198,"_30870":64968,"_3543":34154},[],{"_4098":2665,"_34307":2573,"_23429":65208,"_5":16198,"_30870":64968,"_3543":65199},[],{"_4098":2666,"_34307":2573,"_23429":65210,"_5":16198,"_30870":64968,"_3543":11743},[],{"_4098":2667,"_34307":2573,"_23429":65212,"_5":16198,"_30870":64968,"_3543":65213},[],"MLDSA65-RSA3072-PSS-SHA512",{"_4098":2668,"_34307":2573,"_23429":65215,"_5":16198,"_30870":64968,"_3543":32969},[],{"_4098":2669,"_34307":2573,"_23429":65217,"_5":16198,"_30870":64968,"_3543":65199},[],{"_4098":2670,"_34307":2573,"_23429":65219,"_5":16198,"_30870":64968,"_3543":11596},[],{"_4098":2671,"_34307":2573,"_23429":65221,"_5":16198,"_30870":64968,"_3543":65222},[],"MLDSA65-RSA3072-PKCS15-SHA512",{"_4098":2672,"_34307":2573,"_23429":65224,"_5":16198,"_30870":64968,"_3543":32975},[],{"_4098":2673,"_34307":2573,"_23429":65226,"_5":16198,"_30870":64968,"_3543":65199},[],{"_4098":2674,"_34307":2573,"_23429":65228,"_5":16198,"_30870":64968,"_3543":11935},[],{"_4098":2675,"_34307":2573,"_23429":65230,"_5":16198,"_30870":64968,"_3543":65231},[],"MLDSA65-RSA4096-PSS-SHA512",{"_4098":2676,"_34307":2573,"_23429":65233,"_5":16198,"_30870":64968,"_3543":32981},[],{"_4098":2677,"_34307":2573,"_23429":65235,"_5":16198,"_30870":64968,"_3543":65199},[],{"_4098":2678,"_34307":2573,"_23429":65237,"_5":16198,"_30870":64968,"_3543":11605},[],{"_4098":2679,"_34307":2573,"_23429":65239,"_5":16198,"_30870":64968,"_3543":65240},[],"MLDSA65-RSA4096-PKCS15-SHA512",{"_4098":2680,"_34307":2573,"_23429":65242,"_5":16198,"_30870":64968,"_3543":11599},[],{"_4098":2681,"_34307":2573,"_23429":65244,"_5":16198,"_30870":64968,"_3543":65199},[],{"_4098":2682,"_34307":2573,"_23429":65246,"_5":16198,"_30870":64968,"_3543":11636},[],{"_4098":2683,"_34307":2573,"_23429":65248,"_5":16198,"_30870":64968,"_3543":65249},[],"MLDSA87-RSA3072-PSS-SHA512",{"_4098":2684,"_34307":2573,"_23429":65251,"_5":16198,"_30870":64968,"_3543":32857},[],{"_4098":2685,"_34307":2573,"_23429":65253,"_5":16198,"_30870":64968,"_3543":65199},[],{"_4098":2686,"_34307":2573,"_23429":65255,"_5":16198,"_30870":64968,"_3543":11617},[],{"_4098":2687,"_34307":2573,"_23429":65257,"_5":16198,"_30870":64968,"_3543":65258},[],"MLDSA87-RSA4096-PSS-SHA512",{"_4098":2688,"_34307":2573,"_23429":65260,"_5":16198,"_30870":64968,"_3543":32879},[],{"_4098":2689,"_34307":2573,"_23429":65262,"_5":16198,"_30870":64968,"_3543":65199},[],{"_4098":2690,"_34307":2573,"_23429":65264,"_5":16198,"_30870":64968,"_3543":29450},[],{"_4098":2691,"_34307":2573,"_23429":65266,"_5":16198,"_30870":64968,"_3543":65267},[],"MLDSA44-ECDSA-P256-SHA256",{"_4098":2692,"_34307":2573,"_23429":65269,"_5":16198,"_30870":64968,"_3543":32921},[],{"_4098":2693,"_34307":2573,"_23429":65271,"_5":16198,"_30870":64968,"_3543":65272},[],"ECDSA",{"_4098":2694,"_34307":2573,"_23429":65274,"_5":16198,"_30870":64968,"_3543":33356},[],{"_4098":2695,"_34307":2573,"_23429":65276,"_5":16198,"_30870":64968,"_3543":65277},[],"MLDSA65-ECDSA-P256-SHA512",{"_4098":2696,"_34307":2573,"_23429":65279,"_5":16198,"_30870":64968,"_3543":32987},[],{"_4098":2697,"_34307":2573,"_23429":65281,"_5":16198,"_30870":64968,"_3543":65272},[],{"_4098":2698,"_34307":2573,"_23429":65283,"_5":16198,"_30870":64968,"_3543":33390},[],{"_4098":2699,"_34307":2573,"_23429":65285,"_5":16198,"_30870":64968,"_3543":65286},[],"MLDSA65-ECDSA-P384-SHA512",{"_4098":2700,"_34307":2573,"_23429":65288,"_5":16198,"_30870":64968,"_3543":32993},[],{"_4098":2701,"_34307":2573,"_23429":65290,"_5":16198,"_30870":64968,"_3543":65272},[],{"_4098":2702,"_34307":2573,"_23429":65292,"_5":16198,"_30870":64968,"_3543":32852},[],{"_4098":2703,"_34307":2573,"_23429":65294,"_5":16198,"_30870":64968,"_3543":65295},[],"MLDSA87-ECDSA-P384-SHA512",{"_4098":2704,"_34307":2573,"_23429":65297,"_5":16198,"_30870":64968,"_3543":32999},[],{"_4098":2705,"_34307":2573,"_23429":65299,"_5":16198,"_30870":64968,"_3543":65272},[],{"_4098":2706,"_34307":2573,"_23429":65301,"_5":16198,"_30870":64968,"_3543":33456},[],{"_4098":2707,"_34307":2573,"_23429":65303,"_5":16198,"_30870":64968,"_3543":65304},[],"MLDSA87-ECDSA-P521-SHA512",{"_4098":2708,"_34307":2573,"_23429":65306,"_5":16198,"_30870":64968,"_3543":32885},[],{"_4098":2709,"_34307":2573,"_23429":65308,"_5":16198,"_30870":64968,"_3543":65272},[],{"_4098":2710,"_34307":2573,"_23429":65310,"_5":16198,"_30870":64968,"_3543":33039},[],{"_4098":2711,"_34307":2573,"_23429":65312,"_5":16198,"_30870":64968,"_3543":65313},[],"MLDSA44-Ed25519-SHA512",{"_4098":2712,"_34307":2573,"_23429":65315,"_5":16198,"_30870":64968,"_3543":34187},[],{"_4098":2713,"_34307":2573,"_23429":65317,"_5":16198,"_30870":64968,"_3543":64973},[],{"_4098":2714,"_34307":2573,"_23429":65319,"_5":16198,"_30870":64968,"_3543":33462},[],{"_4098":2715,"_34307":2573,"_23429":65321,"_5":16198,"_30870":64968,"_3543":65322},[],"MLDSA65-Ed25519-SHA512",{"_4098":2716,"_34307":2573,"_23429":65324,"_5":16198,"_30870":64968,"_3543":32963},[],{"_4098":2717,"_34307":2573,"_23429":65326,"_5":16198,"_30870":64968,"_3543":64973},[],{"_4098":2718,"_34307":2573,"_23429":65328,"_5":16198,"_30870":64968,"_3543":65329},[],"The key type must match the family of the variant: creating a `Composite-ML-DSA-ECDSA` key with `size` 3 fails with an error saying that the variant is not valid for that key type.",{"_4098":2719,"_34307":2573,"_23429":65331,"_5":16198,"_30870":64968,"_3543":65332},[],"The implementation was written against draft 19 of the specification, which was later published as RFC 10073, and has been checked against the published text. The object identifiers, the domain separator prefix, the hash used for each ECDSA component and the RFC 5915 encoding of ECDSA private keys match the RFC. Three algorithms of the specification are not implemented because Go has no Brainpool curves and no Ed448: the two Brainpool variants (`MLDSA65-ECDSA-brainpoolP256r1` and `MLDSA87-ECDSA-brainpoolP384r1`, with their hash suffix) and the Ed448 variant. The fork passes the test vectors of RFC 10073 Appendix E for the 15 algorithms it does implement, including the signatures with and without context. These checks cover the vectors and the points listed above; they are not a full conformance assessment.",{"_4098":2720,"_34307":2573,"_23429":65334,"_5":16198,"_30870":64968,"_3543":65335},[],"The composite parameters of keys and signatures must be absent from the `AlgorithmIdentifier`; certificates that carry them are rejected. ECDSA components must use a private scalar of the exact length of the curve.",{"_4098":2721,"_34307":2573,"_23429":65337,"_5":16198,"_30870":64972,"_3543":65338},[],"Ed25519 is not post-quantum, but support for it as a CA and certificate key type was added in the same work and is selected with the `Ed25519` key type. It is classified in the traditional family.",{"_4098":2722,"_34307":2573,"_23429":65340,"_5":16198,"_30870":64976,"_3543":65341},[],"**Composite ML-DSA** is the most conservative option during the transition, because the signature stays valid only if both components verify and so keeps classical protection if a flaw is found in the new algorithm. Keys and signatures are larger than classical ones.",{"_4098":2723,"_34307":2573,"_23429":65343,"_5":16198,"_30870":64976,"_3543":65344},[],"**ML-DSA** alone gives post-quantum protection with moderate sizes and fast operations.",{"_4098":2724,"_34307":2573,"_23429":65346,"_5":16198,"_30870":64976,"_3543":65347},[],"**SLH-DSA** suits long-lived trust anchors where relying only on hash functions is valued. Signatures are considerably larger, and it cannot authenticate TLS connections.",{"_4098":2725,"_34307":2573,"_23429":65349,"_5":16198,"_30870":64976,"_3543":65350},[],"**Ed25519** is not post-quantum; use it only where a classical algorithm is acceptable.",{"_4098":2726,"_34307":2573,"_23429":65352,"_5":16198,"_30870":64980,"_3543":65353},[],"Lamassu does not implement post-quantum key exchange of its own. The hybrid key exchanges offered by the TLS endpoint, such as `X25519MLKEM768`, are those of the Go 1.27 standard library. The Chameleon and delta-certificate designs explored in earlier iterations were removed and are not part of the implementation.",{"_4098":2727,"_34307":2573,"_23429":65355,"_5":16198,"_30870":64980,"_3543":65356},[],"<Card title=\"Go PQC toolchain\" description=\"The fork that implements these algorithms and the API it adds.\" href=\"/docs/platform/pqc/go-toolchain\" />",{"_4098":2728,"_34307":2573,"_23429":65358,"_5":16198,"_30870":64980,"_3543":65359},[],"<Card title=\"Keys and certificate authorities\" description=\"Use these parameters in KMS and CA requests.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_4098":2729,"_34307":2729,"_5":16596,"_3543":65361,"_34738":65362,"_23429":65364,"_30870":2729},"Dashboard",[56936,58404,64948,65363],"Platform support",[],{"_4098":2730,"_34307":2729,"_23429":65366,"_5":16198,"_30870":2729,"_3543":65367},[],"How the web interface exposes post-quantum algorithms when creating keys, CAs and certificates, and how it displays them.",{"_4098":2731,"_34307":2729,"_5":34735,"_23429":65369,"_30870":65370,"_3543":65371},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#choosing-a-key-type-and-specification","Choosing a key type and specification",{"_4098":2732,"_34307":2729,"_5":34735,"_23429":65373,"_30870":65374,"_3543":65375},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#issuing-a-certificate-with-a-browser-generated-key","Issuing a certificate with a browser-generated key",{"_4098":2733,"_34307":2729,"_5":34735,"_23429":65377,"_30870":65378,"_3543":65379},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#how-objects-are-displayed","How objects are displayed",{"_4098":2734,"_34307":2729,"_5":34735,"_23429":65381,"_30870":65382,"_3543":65383},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#related-certificates","Related certificates",{"_4098":2735,"_34307":2729,"_5":34735,"_23429":65385,"_30870":65386,"_3543":65387},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#create-an-issuance-profile-that-enables-the-feature","Create an issuance profile that enables the feature",{"_4098":2736,"_34307":2729,"_5":34735,"_23429":65389,"_30870":65390,"_3543":65391},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#check-which-profiles-allow-it","Check which profiles allow it",{"_4098":2737,"_34307":2729,"_5":34735,"_23429":65393,"_30870":65394,"_3543":65395},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#request-the-bound-certificate","Request the bound certificate",{"_4098":2738,"_34307":2729,"_5":34735,"_23429":65397,"_30870":65398,"_3543":65399},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#check-the-result","Check the result",{"_4098":2739,"_34307":2729,"_5":34735,"_23429":65401,"_30870":65402,"_3543":65403},[],"/docs/pr-preview/pr-58/platform/pqc/dashboard#things-to-know","Things to know",{"_4098":2740,"_34307":2729,"_23429":65405,"_5":16198,"_30870":2729,"_3543":65406},[],"The dashboard (branch `feat/lamassu-q`) lets an administrator create and inspect post-quantum keys, certificate authorities and certificates without writing API requests. It adds the algorithm choices, shows the algorithm family of every object and parses the new identifiers in certificates. Everything it sends is described in Keys and certificate authorities; this page covers what the interface shows and where its behaviour differs between screens.",{"_4098":2741,"_34307":2729,"_23429":65408,"_5":16198,"_30870":65370,"_3543":65409},[],"Creating a KMS key, a CA with a new key and a certificate with a server-generated key all use the same pair of selectors. *Key type* is grouped by family and *Key specification* depends on the type.",{"_4098":2742,"_34307":2729,"_23429":65411,"_5":16198,"_30870":65370,"_3543":65412},[],"Group",{"_4098":2743,"_34307":2729,"_23429":65414,"_5":16198,"_30870":65370,"_3543":65415},[],"Key types",{"_4098":2744,"_34307":2729,"_23429":65417,"_5":16198,"_30870":65370,"_3543":65418},[],"T (Traditional)",{"_4098":2745,"_34307":2729,"_23429":65420,"_5":16198,"_30870":65370,"_3543":65421},[],"`RSA`, `ECDSA`, `Ed25519`",{"_4098":2746,"_34307":2729,"_23429":65423,"_5":16198,"_30870":65370,"_3543":65424},[],"PQ (Pure PQC)",{"_4098":2747,"_34307":2729,"_23429":65426,"_5":16198,"_30870":65370,"_3543":65427},[],"`ML-DSA`, `SLH-DSA`",{"_4098":2748,"_34307":2729,"_23429":65429,"_5":16198,"_30870":65370,"_3543":65430},[],"PQ/T (Hybrid)",{"_4098":2749,"_34307":2729,"_23429":65432,"_5":16198,"_30870":65370,"_3543":65433},[],"`Composite-ML-DSA-RSA`, `Composite-ML-DSA-ECDSA`, `Composite-ML-DSA-Ed25519`",{"_4098":2750,"_34307":2729,"_23429":65435,"_5":16198,"_30870":65370,"_3543":65436},[],"The specification list shows ML-DSA-44, -65 or -87, the twelve SLH-DSA parameter sets (for example *4 - SHAKE\\_128f*) or the composite variants by name. The interface sends the identifier of the parameter set as `size`, as explained in Algorithms, and shows a strength indicator next to each option. For composite keys the indicator shows two bars, one for the classical component and one for the post-quantum component.",{"_4098":2751,"_34307":2729,"_23429":65438,"_5":16198,"_30870":65370,"_3543":65439},[],"Once created, the key list shows the type of each key and its strength. A composite key shows two indicators, one for its classical component (C) and one for its post-quantum component (PQ).",{"_4098":2752,"_34307":2729,"_23429":65441,"_5":16198,"_30870":65370,"_3543":65442},[],"Which options are enabled depends on the crypto engine. When creating a key or a CA, the interface lists every algorithm but disables those that the selected engine does not support, and asks to select an engine first. When creating a certificate on the server, unsupported types are hidden instead.",{"_4098":2753,"_34307":2729,"_23429":65444,"_5":16198,"_30870":65374,"_3543":65445},[],"Issuing a certificate from a CA generates the key pair in the browser, builds the certificate request and sends it to the CA for signing. The key types offered here are `RSA`, `ECDSA`, `Ed25519`, `ML-DSA`, `SLH-DSA` and a single `Composite ML-DSA` entry, and they are generated in the browser: with the `@noble` libraries for ML-DSA and SLH-DSA and with WebCrypto for the classical algorithms.",{"_4098":2754,"_34307":2729,"_23429":65447,"_5":16198,"_30870":65374,"_3543":65448},[],"Composite key generation is not available in `@noble`. The Lamassu team implemented it for the dashboard, combining the ML-DSA key with an RSA, ECDSA or Ed25519 key and signing the composite message representative as the specification defines, so that a composite certificate request can be created entirely in the browser.",{"_4098":2755,"_34307":2729,"_23429":65450,"_5":16198,"_30870":65374,"_3543":65451},[],"The generated private key is shown once at the end of the procedure, next to the issued certificate, with a warning to store it securely. It is not kept by Lamassu, so download or copy it before leaving the page.",{"_4098":2756,"_34307":2729,"_23429":65453,"_5":16198,"_30870":65374,"_3543":65454},[],"The browser does not verify the signatures of ML-DSA, SLH-DSA, composite or Ed25519 requests; it relies on the KMS.",{"_4098":2757,"_34307":2729,"_23429":65456,"_5":16198,"_30870":65378,"_3543":65457},[],"Lists and detail views show the algorithm family. The CA table has a *PQC* column with T, PQ or PQ/T, CA cards and the CA graph show a *PQC* badge, key lists show a quantum icon, and the details of a CA or certificate show the algorithm, its strength and the family badge. The family is computed from the algorithm identifier in the parsed certificate.",{"_4098":2758,"_34307":2729,"_23429":65459,"_5":16198,"_30870":65378,"_3543":65460},[],"The Certificates list has an *Algorithm* column with the same labels: in the example below, a traditional certificate (T), a pure post-quantum certificate (PQ) and the composite CA that issued them (PQ/T).",{"_4098":2759,"_34307":2729,"_23429":65462,"_5":16198,"_30870":65378,"_3543":65463},[],"Algorithm names are resolved from the object identifiers. ML-DSA, SLH-DSA, composite and Ed25519 identifiers are shown as names with their parameter set, for example *ML-DSA-65* or *Composite-Signature MLDSA65-ECDSA-P384-SHA512*, and no bit length is shown for them. RSA and ECDSA signature algorithms are displayed with the dashboard's own labels, such as *RSA PKCS#1 v1.5 SHA-256* and *ECDSA SHA-256*, instead of the OpenSSL names `sha256WithRSAEncryption` and `ecdsa-with-SHA256`.",{"_4098":2760,"_34307":2729,"_23429":65465,"_5":16198,"_30870":65378,"_3543":65466},[],"The key detail page can sign and verify with a post-quantum key and enables only the signature algorithm that corresponds to it.",{"_4098":2761,"_34307":2729,"_23429":65468,"_5":16198,"_30870":65378,"_3543":65469},[],"The following example signs a payload with the key of a composite CA, using the composite algorithm that matches the key.",{"_4098":2762,"_34307":2729,"_23429":65471,"_5":16198,"_30870":65382,"_3543":65472},[],"The dashboard covers the whole related certificates flow without API requests: enable the feature in an issuance profile, check which profiles have it, and request the bound certificate. The configuration fields are those described in Configure an issuance profile.",{"_4098":2763,"_34307":2729,"_23429":65474,"_5":16198,"_30870":65386,"_3543":65475},[],"Go to **Issuance Profiles** and select **Create New Profile**. In the *Related Certificates* section, turn on **Enable Related Certificates**. With the switch off, a certificate request that carries the `relatedCertRequest` attribute is rejected.",{"_4098":2764,"_34307":2729,"_23429":65477,"_5":16198,"_30870":65386,"_3543":65478},[],"**Allowed Hosts** lists one host name per line. The server downloads related certificates over `http` or `https` only from these hosts, as explained in Locations the CA may fetch from. Certificates embedded in the request as `data:` URIs are always accepted.",{"_4098":2765,"_34307":2729,"_23429":65480,"_5":16198,"_30870":65386,"_3543":65481},[],"**Max Attribute Age** is the maximum age of the request time in the attribute. Use the units `y`, `w`, `d`, `h`, `m` or `s`, for example `5m` or `1h`. If you leave it empty, the default of 5 minutes applies.",{"_4098":2766,"_34307":2729,"_23429":65483,"_5":16198,"_30870":65386,"_3543":65484},[],"Complete the rest of the profile as usual, as described in Certificate profiles.",{"_4098":2767,"_34307":2729,"_23429":65486,"_5":16198,"_30870":65390,"_3543":65487},[],"The list of issuance profiles shows a *Related certs* row on every card, with the value **Enabled** or **Disabled**. A profile where it is enabled also shows its allowed hosts and its maximum attribute age. In the example, the default profile has the feature disabled, and the second profile has it enabled with the host `certs.example.com` and a maximum age of one hour. Select **Edit** to change either setting later.",{"_4098":2768,"_34307":2729,"_23429":65489,"_5":16198,"_30870":65390,"_3543":65490},[],"Only a stored profile with the feature enabled lets you request a bound certificate. If you choose a profile without it, or an inline profile, the form explains why the option is unavailable.",{"_4098":2769,"_34307":2729,"_23429":65492,"_5":16198,"_30870":65394,"_3543":65493},[],"Open the CA that will sign it, select **Issue Certificate** and generate the key in the browser, as described in the section above. Under *Certificate Configuration*, choose **Reuse Existing** and select the profile from the previous step. Then turn on **Bind to a related certificate** in the *Related Certificate* section and complete it:",{"_4098":2770,"_34307":2729,"_23429":65495,"_5":16198,"_30870":65394,"_3543":65496},[],"**Related certificate (PEM, optional).** Paste the existing certificate. Its exact issuer and serial number are used and the fields below are locked. If you do not paste it, enter the issuer, as name fields or as raw DER, and the serial number in hexadecimal.",{"_4098":2771,"_34307":2729,"_23429":65498,"_5":16198,"_30870":65394,"_3543":65499},[],"**Location of the related certificate.** One URI per line: a `data:` URI with a base64 PKCS#7 that contains the certificate, or an `http` or `https` URL that points to a plain DER certificate on an allowed host.",{"_4098":2772,"_34307":2729,"_23429":65501,"_5":16198,"_30870":65394,"_3543":65502},[],"**Data to sign.** The form builds the issuer and serial number followed by the request time, which it stamps automatically. Copy it as hex or base64. **Refresh** recomputes it with the current time.",{"_4098":2773,"_34307":2729,"_23429":65504,"_5":16198,"_30870":65394,"_3543":65505},[],"**Signature.** Sign those bytes with the private key of the related certificate, outside the browser, and paste the signature as hex or base64. Use the key's usual algorithm: ECDSA with SHA-256, SHA-384 or SHA-512 depending on the curve, RSA PKCS#1 v1.5 with SHA-256, and pure Ed25519 or ML-DSA. An ECDSA signature may be DER or raw `r||s`.",{"_4098":2774,"_34307":2729,"_23429":65507,"_5":16198,"_30870":65394,"_3543":65508},[],"To build the `data:` URI from a certificate file, `cert.pem`, wrap it in a PKCS#7 structure and encode it in base64:",{"_4098":2775,"_34307":2729,"_23429":65510,"_5":16198,"_30870":65394,"_3543":65511},[],"Paste the output as one line in the location field. The server only checks that the URI is base64 encoded and that the payload is a PKCS#7 structure whose first certificate is the related one.",{"_4098":2776,"_34307":2729,"_23429":65513,"_5":16198,"_30870":65394,"_3543":65514},[],"The key of the related certificate normally stays on the device or system that owns it, so the signature is produced there. If that key is held in Lamassu, use **Sign / Verify** on the key, as described in Keys and cryptographic engines.",{"_4098":2777,"_34307":2729,"_23429":65516,"_5":16198,"_30870":65394,"_3543":65517},[],"The CA accepts the request only if its time is within the maximum attribute age of the profile, counted from the moment it receives the request. Sign and issue within that window, or select **Refresh** and sign the new data. Then issue the certificate as usual.",{"_4098":2778,"_34307":2729,"_23429":65519,"_5":16198,"_30870":65398,"_3543":65520},[],"The detail pages of the new certificate show a *Related Certificate* row with the hash algorithm and the hash of the related certificate. It appears only on certificates that carry the extension, so a certificate issued without the binding shows no such row.",{"_4098":2779,"_34307":2729,"_23429":65522,"_5":16198,"_30870":65398,"_3543":65523},[],"To check that the value belongs to the certificate you expect, compute the hash of its DER encoding with the same algorithm and compare it:",{"_4098":2780,"_34307":2729,"_23429":65525,"_5":16198,"_30870":65398,"_3543":65526},[],"The algorithm is SHA-256, SHA-384 or SHA-512, as shown in the row. The rules the bound certificate must satisfy are in What the issued certificate must satisfy.",{"_4098":2781,"_34307":2729,"_23429":65528,"_5":16198,"_30870":65402,"_3543":65529},[],"The key type names are not identical across all screens. Key and CA creation use `Composite-ML-DSA-RSA`, `-ECDSA` and `-Ed25519`; the issue-certificate form uses a single `Composite-ML-DSA`; and the server-side certificate form compares upper-case names. The names that the backend reports for a key may therefore differ in case from what the interface submits.",{"_4098":2782,"_34307":2729,"_23429":65531,"_5":16198,"_30870":65402,"_3543":65532},[],"The interface carries no experimental warning for these algorithms and has no translation: all texts are in English.",{"_4098":2783,"_34307":2729,"_23429":65534,"_5":16198,"_30870":65402,"_3543":65535},[],"The mapping from the SLH-DSA parameter set identifier to the algorithm used by the in-browser key generator does not follow the same order as the identifiers shown in the selector and used by the backend, except for identifier 1. A certificate issued through the browser flow with an SLH-DSA identifier from 2 to 12 may therefore use a different parameter set than the one named in the selector. Create SLH-DSA keys with the KMS until this is corrected.",{"_4098":2784,"_34307":2729,"_23429":65537,"_5":16198,"_30870":65402,"_3543":65538},[],"<Card title=\"Keys and certificate authorities\" description=\"The API behind these screens.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_4098":2785,"_34307":2729,"_23429":65540,"_5":16198,"_30870":65402,"_3543":65541},[],"<Card title=\"Known limitations\" description=\"Gaps in the interface and the platform.\" href=\"/docs/platform/pqc/limitations\" />",{"_4098":2786,"_34307":2786,"_5":16596,"_3543":65543,"_34738":65544,"_23429":65545,"_30870":2786},"Deployment with the Helm chart",[56936,58404,64948,56937],[],{"_4098":2787,"_34307":2786,"_23429":65547,"_5":16198,"_30870":2786,"_3543":65548},[],"Deploy Lamassu with a Traefik front proxy that serves classical, post-quantum and composite certificates, using the chart values or the fast-lane installer.",{"_4098":2788,"_34307":2786,"_5":34735,"_23429":65550,"_30870":65551,"_3543":65552},[],"/docs/pr-preview/pr-58/platform/pqc/deployment#topology","Topology",{"_4098":2789,"_34307":2786,"_5":34735,"_23429":65554,"_30870":65555,"_3543":65556},[],"/docs/pr-preview/pr-58/platform/pqc/deployment#chart-values","Chart values",{"_4098":2790,"_34307":2786,"_5":34735,"_23429":65558,"_30870":65559,"_3543":65560},[],"/docs/pr-preview/pr-58/platform/pqc/deployment#the-fast-lane-installer","The fast-lane installer",{"_4098":2791,"_34307":2786,"_23429":65562,"_5":16198,"_30870":2786,"_3543":65563},[],"The `pqc` branch of the Lamassu Helm chart adds a front proxy: a Traefik instance built with the Go PQC toolchain that terminates the devices' TLS, authenticates them and forwards the traffic to Envoy Gateway. This page describes the resulting topology, the values that control it and the installer that automates a laboratory deployment.",{"_4098":2792,"_34307":2786,"_23429":65565,"_5":16198,"_30870":2786,"_3543":65566},[],"The chart and the installer assume a development cluster. The proxy image uses a mutable tag, the PQC certificates are not renewed automatically and the hop between Traefik and Envoy does not verify certificates. Do not use this configuration as it is for production.",{"_4098":2793,"_34307":2786,"_23429":65568,"_5":16198,"_30870":65551,"_3543":65569},[],"Traefik is the public edge. It negotiates the key exchange, serves the certificate and, if requested, receives the client certificate. It then opens a second TLS connection to the `envoy-gateway-proxy` service of Envoy Gateway, which presents the chart's self-signed classical certificate; Traefik is configured to accept it without verifying it. Envoy therefore never sees a post-quantum handshake, and the post-quantum protection covers only the connection between the client and Traefik. Traefik and Envoy Gateway are installed once per cluster and shared across namespaces, whereas the front proxy resources (the Gateway, route, middleware, certificate and reference grant) belong to the Lamassu release.",{"_4098":2794,"_34307":2786,"_23429":65571,"_5":16198,"_30870":65551,"_3543":65572},[],"When the client sent a certificate, the `inject-client-cert` middleware of the chart adds it, in PEM form, to the `X-Forwarded-Tls-Client-Cert` header, and the `X-Forwarded-Proto: https` header is set on the request.",{"_4098":2795,"_34307":2786,"_23429":65574,"_5":16198,"_30870":65555,"_3543":65575},[],"All the new values are under `traefikFrontProxy` and are validated by the chart's schema, which rejects unknown keys.",{"_4098":2796,"_34307":2786,"_23429":65577,"_5":16198,"_30870":65555,"_3543":65578},[],"Name",{"_4098":2797,"_34307":2786,"_23429":65580,"_5":16198,"_30870":65555,"_3543":61088},[],{"_4098":2798,"_34307":2786,"_23429":65582,"_5":16198,"_30870":65555,"_3543":57323},[],{"_4098":2799,"_34307":2786,"_23429":65584,"_5":16198,"_30870":65555,"_3543":61094},[],{"_4098":2800,"_34307":2786,"_23429":65586,"_5":16198,"_30870":65555,"_3543":65587},[],"`traefikFrontProxy.enabled`",{"_4098":2801,"_34307":2786,"_23429":65589,"_5":16198,"_30870":65555,"_3543":22068},[],{"_4098":2802,"_34307":2786,"_23429":65591,"_5":16198,"_30870":65555,"_3543":65592},[],"`false`",{"_4098":2803,"_34307":2786,"_23429":65594,"_5":16198,"_30870":65555,"_3543":65595},[],"Deploys the front proxy resources.",{"_4098":2804,"_34307":2786,"_23429":65597,"_5":16198,"_30870":65555,"_3543":65598},[],"`traefikFrontProxy.domain`",{"_4098":2805,"_34307":2786,"_23429":65600,"_5":16198,"_30870":65555,"_3543":28013},[],{"_4098":2806,"_34307":2786,"_23429":65602,"_5":16198,"_30870":65555,"_3543":65603},[],"`\"\"`",{"_4098":2807,"_34307":2786,"_23429":65605,"_5":16198,"_30870":65555,"_3543":65606},[],"Name of the edge certificate and host name of the route. Set it when the proxy is enabled.",{"_4098":2808,"_34307":2786,"_23429":65608,"_5":16198,"_30870":65555,"_3543":65609},[],"`traefikFrontProxy.webSecurePort`",{"_4098":2809,"_34307":2786,"_23429":65611,"_5":16198,"_30870":65555,"_3543":18347},[],{"_4098":2810,"_34307":2786,"_23429":65613,"_5":16198,"_30870":65555,"_3543":65614},[],"`8443`",{"_4098":2811,"_34307":2786,"_23429":65616,"_5":16198,"_30870":65555,"_3543":65617},[],"Port of the HTTPS listener; it must match Traefik's `websecure` entry point.",{"_4098":2812,"_34307":2786,"_23429":65619,"_5":16198,"_30870":65555,"_3543":65620},[],"`traefikFrontProxy.tls.type`",{"_4098":2813,"_34307":2786,"_23429":65622,"_5":16198,"_30870":65555,"_3543":28013},[],{"_4098":2814,"_34307":2786,"_23429":65624,"_5":16198,"_30870":65555,"_3543":65625},[],"`certManager`",{"_4098":2815,"_34307":2786,"_23429":65627,"_5":16198,"_30870":65555,"_3543":65628},[],"Source of the classical certificate: `certManager`, `external` or `none`.",{"_4098":2816,"_34307":2786,"_23429":65630,"_5":16198,"_30870":65555,"_3543":65631},[],"`traefikFrontProxy.tls.certManagerOptions.addresses`",{"_4098":2817,"_34307":2786,"_23429":65633,"_5":16198,"_30870":65555,"_3543":17135},[],{"_4098":2818,"_34307":2786,"_23429":65635,"_5":16198,"_30870":65555,"_3543":65636},[],"`[]`",{"_4098":2819,"_34307":2786,"_23429":65638,"_5":16198,"_30870":65555,"_3543":65639},[],"IP addresses added to the self-signed certificate.",{"_4098":2820,"_34307":2786,"_23429":65641,"_5":16198,"_30870":65555,"_3543":65642},[],"`traefikFrontProxy.tls.externalOptions.secretName`",{"_4098":2821,"_34307":2786,"_23429":65644,"_5":16198,"_30870":65555,"_3543":28013},[],{"_4098":2822,"_34307":2786,"_23429":65646,"_5":16198,"_30870":65555,"_3543":65603},[],{"_4098":2823,"_34307":2786,"_23429":65648,"_5":16198,"_30870":65555,"_3543":65649},[],"Secret with `tls.crt` and `tls.key` when the type is `external`.",{"_4098":2824,"_34307":2786,"_23429":65651,"_5":16198,"_30870":65555,"_3543":65652},[],"`traefikFrontProxy.tls.additionalSecretNames`",{"_4098":2825,"_34307":2786,"_23429":65654,"_5":16198,"_30870":65555,"_3543":17135},[],{"_4098":2826,"_34307":2786,"_23429":65656,"_5":16198,"_30870":65555,"_3543":65636},[],{"_4098":2827,"_34307":2786,"_23429":65658,"_5":16198,"_30870":65555,"_3543":65659},[],"Extra TLS secrets, for example ML-DSA or composite certificates, served on the same listener.",{"_4098":2828,"_34307":2786,"_23429":65661,"_5":16198,"_30870":65555,"_3543":65662},[],"With `certManager`, the chart requests an ECDSA P-256 certificate valid for 2160 hours from its own self-signed issuer and stores it in the secret `edge-cert`. With `none`, only the additional secrets are served, and the chart stops with an error if there are none. The proxy chooses among all the certificates according to the client, as described in TLS front proxy with Traefik. The names of the resources the chart creates are fixed, so only one release per namespace is supported.",{"_4098":2829,"_34307":2786,"_23429":65664,"_5":16198,"_30870":65555,"_3543":65665},[],"The chart also changes the Envoy Gateway service so that its HTTPS port declares `appProtocol: https`, which recent Traefik versions require in order to speak TLS to it. When `gateway.addresses` is empty, the Envoy service is a `ClusterIP` instead of a load balancer.",{"_4098":2830,"_34307":2786,"_23429":65667,"_5":16198,"_30870":65555,"_3543":65668},[],"The chart does not deploy Traefik itself, the `traefik` GatewayClass, or the `default` TLS option in the `traefik-system` namespace; the installer creates them. Without them, the edge has no post-quantum key exchange and no client-certificate request. The chart also does not set the Lamassu service images: the defaults are the development images, and the installer overrides the UI, CA, KMS, VA, device manager, DMS manager, alerts and authorization images with the `:pqc` tags of `ghcr.io/lamassuiot`.",{"_4098":2831,"_34307":2786,"_23429":65670,"_5":16198,"_30870":65559,"_3543":65671},[],"`scripts/lamassu-fast-lane.sh` installs everything on a cluster: the Gateway API custom resource definitions (version 1.6.3, experimental channel), Envoy Gateway 1.8.0, the Traefik chart 41.0.2 with the PQC image, the TLS option, PostgreSQL, Keycloak, RabbitMQ, optionally observability and SoftHSM, and finally the Lamassu release. The two flags that matter here select which algorithms are offered.",{"_4098":2832,"_34307":2786,"_23429":65673,"_5":16198,"_30870":65559,"_3543":65674},[],"Both flags take a comma-separated list of `T`, `PQ` and `PQ/T`, and both default to all three. For the key exchange, `PQ/T` is a hybrid group that combines a classical and an ML-KEM exchange (`X25519MLKEM768`, `SecP256r1MLKEM768` and `SecP384r1MLKEM1024`) and `PQ` is pure ML-KEM (`MLKEM1024`); for authentication, `PQ/T` is a composite certificate. `--tls-kex` fills the `curvePreferences` of the TLS option, and `--tls-auth` selects which certificates are served:",{"_4098":2833,"_34307":2786,"_23429":65676,"_5":16198,"_30870":65559,"_3543":65677},[],"Value",{"_4098":2834,"_34307":2786,"_23429":65679,"_5":16198,"_30870":65559,"_3543":65680},[],"Key exchange groups",{"_4098":2835,"_34307":2786,"_23429":65682,"_5":16198,"_30870":65559,"_3543":61299},[],{"_4098":2836,"_34307":2786,"_23429":65684,"_5":16198,"_30870":65559,"_3543":65685},[],"`T`",{"_4098":2837,"_34307":2786,"_23429":65687,"_5":16198,"_30870":65559,"_3543":65688},[],"`X25519`, `CurveP256`, `CurveP384`",{"_4098":2838,"_34307":2786,"_23429":65690,"_5":16198,"_30870":65559,"_3543":65691},[],"cert-manager ECDSA P-256, or the files given with `--tls-crt` and `--tls-key`, in the secret `edge-cert`.",{"_4098":2839,"_34307":2786,"_23429":65693,"_5":16198,"_30870":65559,"_3543":65694},[],"`PQ`",{"_4098":2840,"_34307":2786,"_23429":65696,"_5":16198,"_30870":65559,"_3543":65697},[],"`MLKEM1024`",{"_4098":2841,"_34307":2786,"_23429":65699,"_5":16198,"_30870":65559,"_3543":65700},[],"ML-DSA-65, in the secret `edge-cert-pq`.",{"_4098":2842,"_34307":2786,"_23429":65702,"_5":16198,"_30870":65559,"_3543":65703},[],"`PQ/T`",{"_4098":2843,"_34307":2786,"_23429":65705,"_5":16198,"_30870":65559,"_3543":65706},[],"`X25519MLKEM768`, `SecP256r1MLKEM768`, `SecP384r1MLKEM1024`",{"_4098":2844,"_34307":2786,"_23429":65708,"_5":16198,"_30870":65559,"_3543":65709},[],"Composite `MLDSA65-RSA3072-PSS-SHA512`, in the secret `edge-cert-pqt`.",{"_4098":2845,"_34307":2786,"_23429":65711,"_5":16198,"_30870":65559,"_3543":65712},[],"The minimum TLS version is 1.3 unless both flags are only `T`, in which case it is 1.2. cert-manager cannot issue post-quantum certificates, so the installer creates the PQ and PQ/T certificates locally with OpenSSL 3.5 or later; the composite certificate also needs the `hybrid-provider` module, which the script builds on demand with `git`, `cmake` and a C compiler. The ML-DSA private keys are written in the seed-only form that Go accepts, and the secrets are created from a manifest because `kubectl create secret tls` rejects ML-DSA keys. The certificates last 365 days and are kept if the secret already exists.",{"_4098":2846,"_34307":2786,"_23429":65714,"_5":16198,"_30870":65559,"_3543":65715},[],"The script requires `yq`, `kubectl` and `helm`, and `jq` with `--sample-data`. At the end it prints how to extract the CA that devices must trust, for example `kubectl get secret edge-cert-pq -o jsonpath='{.data.ca\\.crt}'`.",{"_4098":2847,"_34307":2786,"_23429":65717,"_5":16198,"_30870":65559,"_3543":65718},[],"Companion scripts for an MQTT broker behind Traefik (`scripts/emqx`), for exporting KMS keys and for restoring a backup are present in the working tree of the chart but not committed. They are for laboratory use only and are not described further here.",{"_4098":2848,"_34307":2786,"_23429":65720,"_5":16198,"_30870":65559,"_3543":65721},[],"<Card title=\"TLS front proxy with Traefik\" description=\"How the proxy chooses a certificate and how it is built.\" href=\"/docs/platform/pqc/tls-front-proxy\" />",{"_4098":2849,"_34307":2786,"_23429":65723,"_5":16198,"_30870":65559,"_3543":65724},[],"<Card title=\"Known limitations\" description=\"Caveats of the laboratory deployment.\" href=\"/docs/platform/pqc/limitations\" />",{"_4098":2850,"_34307":2850,"_5":16596,"_3543":65726,"_34738":65727,"_23429":65728,"_30870":2850},"Go PQC toolchain",[56936,58404,64948,64949],[],{"_4098":2851,"_34307":2850,"_23429":65730,"_5":16198,"_30870":2850,"_3543":65731},[],"The fork of Go that adds composite ML-DSA, SLH-DSA, related certificates and composite TLS signature schemes, the API it exposes and how it is built.",{"_4098":2852,"_34307":2850,"_5":34735,"_23429":65733,"_30870":65734,"_3543":65735},[],"/docs/pr-preview/pr-58/platform/pqc/go-toolchain#what-the-fork-adds","What the fork adds",{"_4098":2853,"_34307":2850,"_5":34735,"_23429":65737,"_30870":65738,"_3543":65739},[],"/docs/pr-preview/pr-58/platform/pqc/go-toolchain#tls-code-points","TLS code points",{"_4098":2854,"_34307":2850,"_5":34735,"_23429":65741,"_30870":65742,"_3543":65743},[],"/docs/pr-preview/pr-58/platform/pqc/go-toolchain#a-minimal-example","A minimal example",{"_4098":2855,"_34307":2850,"_5":34735,"_23429":65745,"_30870":65746,"_3543":65747},[],"/docs/pr-preview/pr-58/platform/pqc/go-toolchain#discarded-approaches","Discarded approaches",{"_4098":2856,"_34307":2850,"_5":34735,"_23429":65749,"_30870":65750,"_3543":65751},[],"/docs/pr-preview/pr-58/platform/pqc/go-toolchain#building-the-toolchain-and-the-images","Building the toolchain and the images",{"_4098":2857,"_34307":2850,"_23429":65753,"_5":16198,"_30870":2850,"_3543":65754},[],"Go 1.27 includes ML-DSA in `crypto/mldsa` and in X.509 and TLS, but it has no composite or SLH-DSA certificates, no related certificates and no composite TLS signature schemes. Lamassu therefore builds its backend and its TLS proxy with a fork of Go, maintained on the `release-branch.go1.27` branch. This page describes what the fork adds, for developers who build Lamassu or write a client that must talk to it.",{"_4098":2858,"_34307":2850,"_23429":65756,"_5":16198,"_30870":2850,"_3543":65757},[],"The fork exposes APIs that do not exist in the official Go distribution. Code that uses them compiles only with this toolchain, and a binary built with it must not be assumed to follow the Go compatibility promise for those APIs.",{"_4098":2859,"_34307":2850,"_23429":65759,"_5":16198,"_30870":65734,"_3543":65760},[],"**Composite ML-DSA in X.509.** The `x509` package gains `CompositePublicKey` and `CompositePrivateKey`, which implement `crypto.Signer`, and 15 `CompositeAlgorithm` values (for example `x509.MLDSA65_ECDSA_P384_SHA512`) that can generate keys, sign and verify. Certificates, certificate requests and revocation lists signed with these keys parse, marshal and verify like any other. PKCS#8 encoding of composite private keys is supported. The algorithms page lists the identifiers.",{"_4098":2860,"_34307":2850,"_23429":65762,"_5":16198,"_30870":65734,"_3543":65763},[],"**SLH-DSA in X.509.** The `x509.SLHDSA` public key algorithm and twelve `PureSLHDSA...` signature algorithms are available for parsing and verifying certificates and keys. The implementation is the vendored `circl` library of Cloudflare. It is the least tested part of the fork: it has no x509 tests of its own and no TLS support.",{"_4098":2861,"_34307":2850,"_23429":65765,"_5":16198,"_30870":65734,"_3543":65766},[],"**Related certificates (RFC 9763).** The fork provides `x509.CreateBoundCertificate`, which adds the `id-pe-relatedCert` extension (`1.3.6.1.5.5.7.1.36`) to a certificate, `x509.VerifyRelatedCertificate`, and the helpers to build and check the `relatedCertRequest` attribute of a certificate request (`1.2.840.113549.1.9.16.2.60`). `x509.CertificateRequest` gains an `ExtraAttributes` field for carrying it. Related certificates explains how Lamassu uses them.",{"_4098":2862,"_34307":2850,"_23429":65768,"_5":16198,"_30870":65734,"_3543":65769},[],"**Composite signature schemes in TLS.** The `tls` package adds 15 `SignatureScheme` constants, one per composite algorithm, advertised by default after the native ML-DSA schemes. They work only with TLS 1.3 and are tested with mutual authentication. See below for their code points.",{"_4098":2863,"_34307":2850,"_23429":65771,"_5":16198,"_30870":65738,"_3543":65772},[],"IANA has assigned no code points to the composite TLS signature schemes, so the fork uses the private-use range `0xFE00` to `0xFE0E`, in the order of the composite table: `0xFE00` is `MLDSA44-RSA2048-PSS-SHA256` and `0xFE0E` is `MLDSA65-Ed25519-SHA512`. A client or server built with a standard TLS library does not recognize them and will fall back to another scheme or fail the handshake. Interoperability is therefore limited to peers built from this fork, or to the native ML-DSA schemes (`0x0904` to `0x0906`) that standard Go 1.27 implements.",{"_4098":2864,"_34307":2850,"_23429":65774,"_5":16198,"_30870":65738,"_3543":65775},[],"The three variants that use RSA PKCS#1 v1.5 (`MLDSA44-RSA2048-PKCS15-SHA256`, `MLDSA65-RSA3072-PKCS15-SHA512` and `MLDSA65-RSA4096-PKCS15-SHA512`) are announced only in the `signature_algorithms_cert` extension, so they can appear in a certificate chain but a leaf certificate with such a key cannot sign the handshake.",{"_4098":2865,"_34307":2850,"_23429":65777,"_5":16198,"_30870":65738,"_3543":65778},[],"Code point",{"_4098":2866,"_34307":2850,"_23429":65780,"_5":16198,"_30870":65738,"_3543":65183},[],{"_4098":2867,"_34307":2850,"_23429":65782,"_5":16198,"_30870":65738,"_3543":65783},[],"`0xFE00`",{"_4098":2868,"_34307":2850,"_23429":65785,"_5":16198,"_30870":65738,"_3543":65194},[],{"_4098":2869,"_34307":2850,"_23429":65787,"_5":16198,"_30870":65738,"_3543":65788},[],"`0xFE01`",{"_4098":2870,"_34307":2850,"_23429":65790,"_5":16198,"_30870":65738,"_3543":65204},[],{"_4098":2871,"_34307":2850,"_23429":65792,"_5":16198,"_30870":65738,"_3543":65793},[],"`0xFE02`",{"_4098":2872,"_34307":2850,"_23429":65795,"_5":16198,"_30870":65738,"_3543":65213},[],{"_4098":2873,"_34307":2850,"_23429":65797,"_5":16198,"_30870":65738,"_3543":65798},[],"`0xFE03`",{"_4098":2874,"_34307":2850,"_23429":65800,"_5":16198,"_30870":65738,"_3543":65222},[],{"_4098":2875,"_34307":2850,"_23429":65802,"_5":16198,"_30870":65738,"_3543":65803},[],"`0xFE04`",{"_4098":2876,"_34307":2850,"_23429":65805,"_5":16198,"_30870":65738,"_3543":65231},[],{"_4098":2877,"_34307":2850,"_23429":65807,"_5":16198,"_30870":65738,"_3543":65808},[],"`0xFE05`",{"_4098":2878,"_34307":2850,"_23429":65810,"_5":16198,"_30870":65738,"_3543":65240},[],{"_4098":2879,"_34307":2850,"_23429":65812,"_5":16198,"_30870":65738,"_3543":65813},[],"`0xFE06`",{"_4098":2880,"_34307":2850,"_23429":65815,"_5":16198,"_30870":65738,"_3543":65249},[],{"_4098":2881,"_34307":2850,"_23429":65817,"_5":16198,"_30870":65738,"_3543":65818},[],"`0xFE07`",{"_4098":2882,"_34307":2850,"_23429":65820,"_5":16198,"_30870":65738,"_3543":65258},[],{"_4098":2883,"_34307":2850,"_23429":65822,"_5":16198,"_30870":65738,"_3543":65823},[],"`0xFE08`",{"_4098":2884,"_34307":2850,"_23429":65825,"_5":16198,"_30870":65738,"_3543":65267},[],{"_4098":2885,"_34307":2850,"_23429":65827,"_5":16198,"_30870":65738,"_3543":65828},[],"`0xFE09`",{"_4098":2886,"_34307":2850,"_23429":65830,"_5":16198,"_30870":65738,"_3543":65277},[],{"_4098":2887,"_34307":2850,"_23429":65832,"_5":16198,"_30870":65738,"_3543":65833},[],"`0xFE0A`",{"_4098":2888,"_34307":2850,"_23429":65835,"_5":16198,"_30870":65738,"_3543":65286},[],{"_4098":2889,"_34307":2850,"_23429":65837,"_5":16198,"_30870":65738,"_3543":65838},[],"`0xFE0B`",{"_4098":2890,"_34307":2850,"_23429":65840,"_5":16198,"_30870":65738,"_3543":65295},[],{"_4098":2891,"_34307":2850,"_23429":65842,"_5":16198,"_30870":65738,"_3543":65843},[],"`0xFE0C`",{"_4098":2892,"_34307":2850,"_23429":65845,"_5":16198,"_30870":65738,"_3543":65304},[],{"_4098":2893,"_34307":2850,"_23429":65847,"_5":16198,"_30870":65738,"_3543":65848},[],"`0xFE0D`",{"_4098":2894,"_34307":2850,"_23429":65850,"_5":16198,"_30870":65738,"_3543":65313},[],{"_4098":2895,"_34307":2850,"_23429":65852,"_5":16198,"_30870":65738,"_3543":65853},[],"`0xFE0E`",{"_4098":2896,"_34307":2850,"_23429":65855,"_5":16198,"_30870":65738,"_3543":65322},[],{"_4098":2897,"_34307":2850,"_23429":65857,"_5":16198,"_30870":65738,"_3543":65858},[],"The key exchange is unchanged from upstream Go. Hybrid groups such as `X25519MLKEM768`, `SecP256r1MLKEM768`, `SecP384r1MLKEM1024` and the pure `MLKEM1024` are those of the Go 1.27 standard library.",{"_4098":2898,"_34307":2850,"_23429":65860,"_5":16198,"_30870":65738,"_3543":65412},[],{"_4098":2899,"_34307":2850,"_23429":65862,"_5":16198,"_30870":65738,"_3543":65863},[],"Composition",{"_4098":2900,"_34307":2850,"_23429":65865,"_5":16198,"_30870":65738,"_3543":65866},[],"`X25519MLKEM768`",{"_4098":2901,"_34307":2850,"_23429":65868,"_5":16198,"_30870":65738,"_3543":65869},[],"X25519 + ML-KEM-768",{"_4098":2902,"_34307":2850,"_23429":65871,"_5":16198,"_30870":65738,"_3543":65872},[],"`SecP256r1MLKEM768`",{"_4098":2903,"_34307":2850,"_23429":65874,"_5":16198,"_30870":65738,"_3543":65875},[],"P-256 + ML-KEM-768",{"_4098":2904,"_34307":2850,"_23429":65877,"_5":16198,"_30870":65738,"_3543":65878},[],"`SecP384r1MLKEM1024`",{"_4098":2905,"_34307":2850,"_23429":65880,"_5":16198,"_30870":65738,"_3543":65881},[],"P-384 + ML-KEM-1024",{"_4098":2906,"_34307":2850,"_23429":65883,"_5":16198,"_30870":65738,"_3543":65697},[],{"_4098":2907,"_34307":2850,"_23429":65885,"_5":16198,"_30870":65738,"_3543":65886},[],"ML-KEM-1024 alone",{"_4098":2908,"_34307":2850,"_23429":65888,"_5":16198,"_30870":65738,"_3543":65889},[],"The connection stays protected while at least one component of a hybrid group is secure. The key exchange is independent of the certificate type, so a connection can use a classical certificate and still have a post-quantum key exchange.",{"_4098":2909,"_34307":2850,"_23429":65891,"_5":16198,"_30870":65742,"_3543":65892},[],"The following program creates a self-signed composite certificate and uses it as the server certificate of a TLS 1.3 configuration. Error handling is omitted.",{"_4098":2910,"_34307":2850,"_23429":65894,"_5":16198,"_30870":65742,"_3543":65895},[],"A composite key can also sign a message directly, with an optional context of at most 255 bytes:",{"_4098":2911,"_34307":2850,"_23429":65897,"_5":16198,"_30870":65746,"_3543":65898},[],"The first iterations of the fork implemented Chameleon certificates, defined in `draft-bonnell-lamps-chameleon-certs`. The idea is to pair two certificates for the same subject, for example a classical one and a post-quantum one, by issuing the first with an extension that encodes only the differences to the second. A relying party that understands the extension can rebuild the paired certificate from it and validate that one, so a single issued certificate carries both identities without changing the path validation rules of RFC 5280.",{"_4098":2912,"_34307":2850,"_23429":65900,"_5":16198,"_30870":65746,"_3543":65901},[],"The work was dropped because the draft expired without becoming a standard and is no longer being pursued, so there was no stable specification to interoperate with. Nothing in the current implementation depends on it.",{"_4098":2913,"_34307":2850,"_23429":65903,"_5":16198,"_30870":65750,"_3543":65904},[],"The fork is built in CI by a workflow that runs the Go test suite and then publishes a multi-architecture image, `ghcr.io/lamassuiot/golang-pqc`, tagged `go1.27` and, for the `release-branch.go1.27` branch, `latest`. The image contains the toolchain under `/usr/local/go-pqc` with `GOROOT` pointing at it.",{"_4098":2914,"_34307":2850,"_23429":65906,"_5":16198,"_30870":65750,"_3543":65907},[],"To build the toolchain from source instead, use the `release-branch.go1.27` branch and the standard Go source build:",{"_4098":2915,"_34307":2850,"_23429":65909,"_5":16198,"_30870":65750,"_3543":65910},[],"The resulting `bin/go` command is used like any other Go toolchain.",{"_4098":2916,"_34307":2850,"_23429":65912,"_5":16198,"_30870":65750,"_3543":65913},[],"Lamassu consumes the toolchain in two ways. The backend images (CA, KMS, VA, alerts, device manager, DMS manager and the monolithic build) use `ghcr.io/lamassuiot/golang-pqc:latest` as their builder image. The backend CI workflow installs the same toolchain through a custom setup action in place of `actions/setup-go`, and the backend requires `go 1.27.3` in its module file. Traefik is not built from the image: its `build.sh` script expects a compiled checkout of the fork in a sibling directory and produces the binary outside a container. See TLS front proxy with Traefik.",{"_4098":2917,"_34307":2850,"_23429":65915,"_5":16198,"_30870":65750,"_3543":65916},[],"<Card title=\"Algorithms\" description=\"The identifiers and parameter sets behind these constants.\" href=\"/docs/platform/pqc/algorithms\" />",{"_4098":2918,"_34307":2850,"_23429":65918,"_5":16198,"_30870":65750,"_3543":65919},[],"<Card title=\"TLS front proxy with Traefik\" description=\"How the fork is used to terminate device TLS.\" href=\"/docs/platform/pqc/tls-front-proxy\" />",{"_4098":2919,"_34307":2919,"_5":16596,"_3543":65921,"_34738":65922,"_23429":65924,"_30870":2919},"HTTPS integration tests",[56936,58404,64948,65923],"Integration tests",[],{"_4098":2920,"_34307":2919,"_23429":65926,"_5":16198,"_30870":2919,"_3543":65927},[],"Results of testing a Lamassu HTTPS endpoint with OpenSSL and curl using post-quantum key exchange and post-quantum and composite certificates.",{"_4098":2921,"_34307":2919,"_5":34735,"_23429":65929,"_30870":65930,"_3543":65931},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/https#scenario","Scenario",{"_4098":2922,"_34307":2919,"_5":34735,"_23429":65933,"_30870":65934,"_3543":65935},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/https#results","Results",{"_4098":2923,"_34307":2919,"_5":34735,"_23429":65937,"_30870":65938,"_3543":65939},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/https#reproduce-a-case","Reproduce a case",{"_4098":2924,"_34307":2919,"_5":34735,"_23429":65941,"_30870":65942,"_3543":65943},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/https#connect-offering-one-group-and-one-signature-scheme","Connect offering one group and one signature scheme",{"_4098":2925,"_34307":2919,"_5":34735,"_23429":65945,"_30870":65946,"_3543":65947},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/https#send-a-request","Send a request",{"_4098":2926,"_34307":2919,"_5":34735,"_23429":65949,"_30870":65950,"_3543":65951},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/https#check-that-a-wrong-offer-is-rejected","Check that a wrong offer is rejected",{"_4098":2927,"_34307":2919,"_23429":65953,"_5":16198,"_30870":2919,"_3543":65954},[],"This test connects to a Lamassu API endpoint over HTTPS from an OpenSSL client and checks that the post-quantum handshake, the certificate chain and the application request all succeed. The overview explains the clients, the test matrix and what each check proves.",{"_4098":2928,"_34307":2919,"_23429":65956,"_5":16198,"_30870":65930,"_3543":65957},[],"The client requests `GET /api/ca/health` through the Traefik front proxy, which forwards it to Envoy Gateway and the CA service. The server certificate and the CA that signed it were created outside Lamassu and loaded into the front proxy for each case. For each case the proxy was configured with the key exchange groups and the certificate of that row and column of the matrix.",{"_4098":2929,"_34307":2919,"_23429":65959,"_5":16198,"_30870":65930,"_3543":65960},[],"The CAs and certificates are test material made outside Lamassu, valid for a short period and with the server name as their subject alternative name. They are not issued by the Lamassu CA service.",{"_4098":2930,"_34307":2919,"_23429":65962,"_5":16198,"_30870":65934,"_3543":65963},[],"All nine combinations of key exchange and certificate passed, and so did the three additional composite certificates.",{"_4098":2931,"_34307":2919,"_23429":65965,"_5":16198,"_30870":65934,"_3543":65966},[],"Key exchange ↓ / Certificate →",{"_4098":2932,"_34307":2919,"_23429":65968,"_5":16198,"_30870":65934,"_3543":65969},[],"**T**: ECDSA P-256",{"_4098":2933,"_34307":2919,"_23429":65971,"_5":16198,"_30870":65934,"_3543":65972},[],"**PQ**: ML-DSA-65",{"_4098":2934,"_34307":2919,"_23429":65974,"_5":16198,"_30870":65934,"_3543":65975},[],"**PQ/T**: `MLDSA65-RSA3072-PSS-SHA512`",{"_4098":2935,"_34307":2919,"_23429":65977,"_5":16198,"_30870":65934,"_3543":65978},[],"**T**",{"_4098":2936,"_34307":2919,"_23429":65980,"_5":16198,"_30870":65934,"_3543":65981},[],"✅ `X25519`, `ecdsa_secp256r1_sha256`",{"_4098":2937,"_34307":2919,"_23429":65983,"_5":16198,"_30870":65934,"_3543":65984},[],"✅ `X25519`, `mldsa65`",{"_4098":2938,"_34307":2919,"_23429":65986,"_5":16198,"_30870":65934,"_3543":65987},[],"✅ `X25519`, `mldsa65_rsa3072_pss`",{"_4098":2939,"_34307":2919,"_23429":65989,"_5":16198,"_30870":65934,"_3543":65990},[],"**PQ**",{"_4098":2940,"_34307":2919,"_23429":65992,"_5":16198,"_30870":65934,"_3543":65993},[],"✅ `MLKEM1024`, `ecdsa_secp256r1_sha256`",{"_4098":2941,"_34307":2919,"_23429":65995,"_5":16198,"_30870":65934,"_3543":65996},[],"✅ `MLKEM1024`, `mldsa65`",{"_4098":2942,"_34307":2919,"_23429":65998,"_5":16198,"_30870":65934,"_3543":65999},[],"✅ `MLKEM1024`, `mldsa65_rsa3072_pss`",{"_4098":2943,"_34307":2919,"_23429":66001,"_5":16198,"_30870":65934,"_3543":66002},[],"**PQ/T**",{"_4098":2944,"_34307":2919,"_23429":66004,"_5":16198,"_30870":65934,"_3543":66005},[],"✅ `X25519MLKEM768`, `ecdsa_secp256r1_sha256`",{"_4098":2945,"_34307":2919,"_23429":66007,"_5":16198,"_30870":65934,"_3543":66008},[],"✅ `X25519MLKEM768`, `mldsa65`",{"_4098":2946,"_34307":2919,"_23429":66010,"_5":16198,"_30870":65934,"_3543":66011},[],"✅ `X25519MLKEM768`, `mldsa65_rsa3072_pss`",{"_4098":2947,"_34307":2919,"_23429":66013,"_5":16198,"_30870":65934,"_3543":66014},[],"Each cell shows the negotiated group and the signature scheme of the handshake. In every case the chain verified, the request returned `200` and both negative checks were rejected with `handshake_failure`.",{"_4098":2948,"_34307":2919,"_23429":66016,"_5":16198,"_30870":65934,"_3543":66017},[],"Additional composite",{"_4098":2949,"_34307":2919,"_23429":66019,"_5":16198,"_30870":65934,"_3543":66020},[],"Signature scheme",{"_4098":2950,"_34307":2919,"_23429":66022,"_5":16198,"_30870":65934,"_3543":62184},[],{"_4098":2951,"_34307":2919,"_23429":66024,"_5":16198,"_30870":65934,"_3543":66025},[],"`MLDSA44-ECDSA-P256-SHA256`",{"_4098":2952,"_34307":2919,"_23429":66027,"_5":16198,"_30870":65934,"_3543":66028},[],"`mldsa44_ecdsa_p256`",{"_4098":2953,"_34307":2919,"_23429":66030,"_5":16198,"_30870":65934,"_3543":66031},[],"✅ with `X25519MLKEM768`",{"_4098":2954,"_34307":2919,"_23429":66033,"_5":16198,"_30870":65934,"_3543":66034},[],"`MLDSA65-ECDSA-P256-SHA512`",{"_4098":2955,"_34307":2919,"_23429":66036,"_5":16198,"_30870":65934,"_3543":66037},[],"`mldsa65_ecdsa_p256`",{"_4098":2956,"_34307":2919,"_23429":66039,"_5":16198,"_30870":65934,"_3543":66031},[],{"_4098":2957,"_34307":2919,"_23429":66041,"_5":16198,"_30870":65934,"_3543":66042},[],"`MLDSA65-Ed25519-SHA512`",{"_4098":2958,"_34307":2919,"_23429":66044,"_5":16198,"_30870":65934,"_3543":66045},[],"`mldsa65_ed25519`",{"_4098":2959,"_34307":2919,"_23429":66047,"_5":16198,"_30870":65934,"_3543":66031},[],{"_4098":2960,"_34307":2919,"_23429":66049,"_5":16198,"_30870":65934,"_3543":66050},[],"With a single server configuration that holds the ECDSA, ML-DSA-65 and composite certificates at once and accepts all three key exchange classes, a client that offered one group and one signature scheme negotiated each of the nine combinations. `curl` returned `200` when it trusted the three CAs.",{"_4098":2961,"_34307":2919,"_23429":66052,"_5":16198,"_30870":65934,"_3543":66053},[],"A server with certificates of several classes serves the first that matches the client's signature preference. A default OpenSSL 3.5 or later client prefers ML-DSA, so a client that trusts only the ECDSA CA fails with `unable to get local issuer certificate`, even though the connection itself worked. Give clients the CAs of every class the server may present.",{"_4098":2962,"_34307":2919,"_23429":66055,"_5":16198,"_30870":65938,"_3543":66056},[],"You need OpenSSL 3.5 or later. For composite certificates, also the `hybrid-provider` module with code points that match the Go PQC toolchain, loaded through `OPENSSL_CONF`. Use the CA file of the case as `ca.pem`.",{"_4098":2963,"_34307":2919,"_23429":66058,"_5":16198,"_30870":65942,"_3543":66059},[],"This example tests PQ/T key exchange with the composite certificate, and prints the negotiated values:",{"_4098":2964,"_34307":2919,"_23429":66061,"_5":16198,"_30870":65942,"_3543":66062},[],"Expected output:",{"_4098":2965,"_34307":2919,"_23429":66064,"_5":16198,"_30870":65946,"_3543":66065},[],"Replace the `grep` with an HTTP request to confirm that the application layer works through the proxy:",{"_4098":2966,"_34307":2919,"_23429":66067,"_5":16198,"_30870":65946,"_3543":66068},[],"The response starts with `HTTP/1.1 200 OK`. With `curl` and a bundle that contains the CAs of the classes the server presents, `curl --cacert ca-bundle.pem https://<LAMASSU_HOST>/api/ca/health` returns `200` as well.",{"_4098":2967,"_34307":2919,"_23429":66070,"_5":16198,"_30870":65950,"_3543":66071},[],"Offer only classical groups to a server configured for PQ key exchange:",{"_4098":2968,"_34307":2919,"_23429":66073,"_5":16198,"_30870":65950,"_3543":66074},[],"The handshake fails with a `handshake failure` alert. Offering every signature scheme except the certificate's gives the same result.",{"_4098":2969,"_34307":2919,"_23429":66076,"_5":16198,"_30870":65950,"_3543":66077},[],"<Card title=\"MQTTS\" description=\"The same checks for an MQTT broker.\" href=\"/docs/platform/pqc/integration-tests/mqtts\" />",{"_4098":2970,"_34307":2919,"_23429":66079,"_5":16198,"_30870":65950,"_3543":66080},[],"<Card title=\"TLS front proxy with Traefik\" description=\"How the proxy chooses a certificate and enforces key exchange.\" href=\"/docs/platform/pqc/tls-front-proxy\" />",{"_4098":2971,"_34307":2971,"_5":16596,"_3543":66082,"_34738":66083,"_23429":66084,"_30870":2971},"MQTTS integration tests",[56936,58404,64948,65923],[],{"_4098":2972,"_34307":2971,"_23429":66086,"_5":16198,"_30870":2971,"_3543":66087},[],"Results of testing an MQTT broker behind the Lamassu TLS front proxy with mosquitto, using post-quantum key exchange and post-quantum and composite certificates.",{"_4098":2973,"_34307":2971,"_5":34735,"_23429":66089,"_30870":66090,"_3543":65931},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/mqtts#scenario",{"_4098":2974,"_34307":2971,"_5":34735,"_23429":66092,"_30870":66093,"_3543":65935},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/mqtts#results",{"_4098":2975,"_34307":2971,"_5":34735,"_23429":66095,"_30870":66096,"_3543":65939},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/mqtts#reproduce-a-case",{"_4098":2976,"_34307":2971,"_5":34735,"_23429":66098,"_30870":66099,"_3543":66100},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/mqtts#create-the-openssl-configuration","Create the OpenSSL configuration",{"_4098":2977,"_34307":2971,"_5":34735,"_23429":66102,"_30870":66103,"_3543":66104},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/mqtts#subscribe-and-publish","Subscribe and publish",{"_4098":2978,"_34307":2971,"_5":34735,"_23429":66106,"_30870":66107,"_3543":65951},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/mqtts#check-that-a-wrong-offer-is-rejected",{"_4098":2979,"_34307":2971,"_5":34735,"_23429":66109,"_30870":66110,"_3543":65403},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/mqtts#things-to-know",{"_4098":2980,"_34307":2971,"_23429":66112,"_5":16198,"_30870":2971,"_3543":66113},[],"This test connects `mosquitto_pub` and `mosquitto_sub` to an MQTT broker over TLS and checks that messages travel through it with post-quantum key exchange and post-quantum or composite server certificates. The overview explains the clients, the test matrix and what each check proves.",{"_4098":2981,"_34307":2971,"_23429":66115,"_5":16198,"_30870":66090,"_3543":66116},[],"The broker is EMQX 5.8.9. It listens for MQTT in clear text inside the cluster, and the Lamassu TLS front proxy (TLS front proxy with Traefik) terminates TLS for it on port 8883 and forwards the traffic. The TLS is one-way: the broker's endpoint presents its certificate, and the client presents none. The server certificate and its CA were created outside Lamassu, and the proxy was configured for each case with the key exchange groups and certificate of that row and column of the matrix.",{"_4098":2982,"_34307":2971,"_23429":66118,"_5":16198,"_30870":66090,"_3543":66119},[],"The clients are `mosquitto_pub` and `mosquitto_sub` 2.1.2, using MQTT 3.1.1 over TLS 1.3 and linked against OpenSSL 4.1.0. A case passes when the subscriber receives the message that the publisher sent through the broker, both clients validate the certificate chain against the CA of the case and the server name, and the two negative checks are rejected.",{"_4098":2983,"_34307":2971,"_23429":66121,"_5":16198,"_30870":66093,"_3543":66122},[],"All twelve cases passed. In each one, `mosquitto_sub` subscribed to a topic, `mosquitto_pub` published a unique value, and the subscriber received it. The test ran twice per case: once with the client offering every group and signature scheme, and once with the client offering only the group and the signature scheme expected for the case. The second run shows that the broker's endpoint negotiated exactly that group and scheme, because the client offered nothing else.",{"_4098":2984,"_34307":2971,"_23429":66124,"_5":16198,"_30870":66093,"_3543":65966},[],{"_4098":2985,"_34307":2971,"_23429":66126,"_5":16198,"_30870":66093,"_3543":65969},[],{"_4098":2986,"_34307":2971,"_23429":66128,"_5":16198,"_30870":66093,"_3543":65972},[],{"_4098":2987,"_34307":2971,"_23429":66130,"_5":16198,"_30870":66093,"_3543":65975},[],{"_4098":2988,"_34307":2971,"_23429":66132,"_5":16198,"_30870":66093,"_3543":65978},[],{"_4098":2989,"_34307":2971,"_23429":66134,"_5":16198,"_30870":66093,"_3543":65981},[],{"_4098":2990,"_34307":2971,"_23429":66136,"_5":16198,"_30870":66093,"_3543":65984},[],{"_4098":2991,"_34307":2971,"_23429":66138,"_5":16198,"_30870":66093,"_3543":65987},[],{"_4098":2992,"_34307":2971,"_23429":66140,"_5":16198,"_30870":66093,"_3543":65990},[],{"_4098":2993,"_34307":2971,"_23429":66142,"_5":16198,"_30870":66093,"_3543":65993},[],{"_4098":2994,"_34307":2971,"_23429":66144,"_5":16198,"_30870":66093,"_3543":65996},[],{"_4098":2995,"_34307":2971,"_23429":66146,"_5":16198,"_30870":66093,"_3543":65999},[],{"_4098":2996,"_34307":2971,"_23429":66148,"_5":16198,"_30870":66093,"_3543":66002},[],{"_4098":2997,"_34307":2971,"_23429":66150,"_5":16198,"_30870":66093,"_3543":66005},[],{"_4098":2998,"_34307":2971,"_23429":66152,"_5":16198,"_30870":66093,"_3543":66008},[],{"_4098":2999,"_34307":2971,"_23429":66154,"_5":16198,"_30870":66093,"_3543":66011},[],{"_4098":3000,"_34307":2971,"_23429":66156,"_5":16198,"_30870":66093,"_3543":66157},[],"The additional composite certificates behave the same way with PQ/T key exchange.",{"_4098":3001,"_34307":2971,"_23429":66159,"_5":16198,"_30870":66093,"_3543":66017},[],{"_4098":3002,"_34307":2971,"_23429":66161,"_5":16198,"_30870":66093,"_3543":66020},[],{"_4098":3003,"_34307":2971,"_23429":66163,"_5":16198,"_30870":66093,"_3543":62184},[],{"_4098":3004,"_34307":2971,"_23429":66165,"_5":16198,"_30870":66093,"_3543":66025},[],{"_4098":3005,"_34307":2971,"_23429":66167,"_5":16198,"_30870":66093,"_3543":66028},[],{"_4098":3006,"_34307":2971,"_23429":66169,"_5":16198,"_30870":66093,"_3543":66170},[],"✅",{"_4098":3007,"_34307":2971,"_23429":66172,"_5":16198,"_30870":66093,"_3543":66034},[],{"_4098":3008,"_34307":2971,"_23429":66174,"_5":16198,"_30870":66093,"_3543":66037},[],{"_4098":3009,"_34307":2971,"_23429":66176,"_5":16198,"_30870":66093,"_3543":66170},[],{"_4098":3010,"_34307":2971,"_23429":66178,"_5":16198,"_30870":66093,"_3543":66042},[],{"_4098":3011,"_34307":2971,"_23429":66180,"_5":16198,"_30870":66093,"_3543":66045},[],{"_4098":3012,"_34307":2971,"_23429":66182,"_5":16198,"_30870":66093,"_3543":66170},[],{"_4098":3013,"_34307":2971,"_23429":66184,"_5":16198,"_30870":66093,"_3543":66185},[],"When the client offered every group except those of the case, or every signature scheme except the certificate's, the TLS handshake failed with a `handshake failure` alert and the broker never sent a `CONNACK`. The same result held in all twelve cases.",{"_4098":3014,"_34307":2971,"_23429":66187,"_5":16198,"_30870":66093,"_3543":66188},[],"With a single server configuration that holds the ECDSA, ML-DSA-65 and composite certificates and accepts all three key exchange classes, each of the nine combinations connected on port 8883 when the client offered one group and one signature scheme. `mosquitto_pub` received `CONNACK (0)` every time.",{"_4098":3015,"_34307":2971,"_23429":66190,"_5":16198,"_30870":66096,"_3543":66191},[],"mosquitto has no options to choose key exchange groups or signature schemes, so they are set through an OpenSSL configuration file that `mosquitto_pub` and `mosquitto_sub` read from the `OPENSSL_CONF` environment variable. You need OpenSSL 3.5 or later; for composite certificates, also the `hybrid-provider` module with code points that match the Go PQC toolchain.",{"_4098":3016,"_34307":2971,"_23429":66193,"_5":16198,"_30870":66099,"_3543":66194},[],"This `pqc-client.cnf` makes the client offer only `X25519MLKEM768` and the composite signature scheme, and loads the composite provider:",{"_4098":3017,"_34307":2971,"_23429":66196,"_5":16198,"_30870":66099,"_3543":66197},[],"Remove the `hybrid` provider and the module for a case that uses ML-DSA or ECDSA only.",{"_4098":3018,"_34307":2971,"_23429":66199,"_5":16198,"_30870":66103,"_3543":66200},[],"Start the subscriber in one terminal and the publisher in another. Both validate the broker's certificate against `ca.pem`, the CA of the case:",{"_4098":3019,"_34307":2971,"_23429":66202,"_5":16198,"_30870":66103,"_3543":66203},[],"The subscriber prints `hello over pqc` and exits. Add `-d` to see the `CONNECT`, `CONNACK (0)`, `SUBACK` and `PUBLISH` packets.",{"_4098":3020,"_34307":2971,"_23429":66205,"_5":16198,"_30870":66107,"_3543":66206},[],"Change `Groups` to a list that does not include the group the server accepts, for example `Groups = X25519` against a server configured for `MLKEM1024`, and repeat the publish. The client fails with `tls alert handshake failure` and no `CONNACK` is received.",{"_4098":3021,"_34307":2971,"_23429":66208,"_5":16198,"_30870":66110,"_3543":66209},[],"**Hostname and certificate.** mosquitto uses the `-h` value as the connection target, the server name sent in the handshake and the name it verifies. The test certificates carry that name as a subject alternative name.",{"_4098":3022,"_34307":2971,"_23429":66211,"_5":16198,"_30870":66110,"_3543":66212},[],"**One certificate per name.** The front proxy keeps its certificates by name, not by port. An MQTT endpoint that shares its name with the HTTPS endpoint serves the same certificates, so give the broker its own name if it needs a different certificate.",{"_4098":3023,"_34307":2971,"_23429":66214,"_5":16198,"_30870":66110,"_3543":66215},[],"**Unpinned defaults were not tested.** Every run set the group and signature offer explicitly, so what mosquitto negotiates with the default OpenSSL offer was not checked in this test. The HTTPS tests do cover a default OpenSSL client: it is served the ML-DSA certificate if the server holds one.",{"_4098":3024,"_34307":2971,"_23429":66217,"_5":16198,"_30870":66110,"_3543":66218},[],"**Other clients on the same port.** Enforcing TLS 1.3 or post-quantum algorithms on a shared MQTT port affects every client that connects to it. During the tests the proxy logged connection attempts from other clients that only support TLS 1.2 or earlier, or that did not trust the certificate. Identify them before making the setting permanent.",{"_4098":3025,"_34307":2971,"_23429":66220,"_5":16198,"_30870":66110,"_3543":66221},[],"<Card title=\"HTTPS\" description=\"The same checks for a Lamassu HTTPS endpoint.\" href=\"/docs/platform/pqc/integration-tests/https\" />",{"_4098":3026,"_34307":2971,"_23429":66223,"_5":16198,"_30870":66110,"_3543":66224},[],"<Card title=\"Deployment with the Helm chart\" description=\"Deploy the front proxy that terminates the TLS.\" href=\"/docs/platform/pqc/deployment\" />",{"_4098":3027,"_34307":3027,"_5":16596,"_3543":66226,"_34738":66227,"_23429":66228,"_30870":3027},"Integration tests overview",[56936,58404,64948,65923],[],{"_4098":3028,"_34307":3027,"_23429":66230,"_5":16198,"_30870":3027,"_3543":66231},[],"Evidence that software outside Lamassu negotiates post-quantum key exchange and verifies post-quantum and composite certificates served by Lamassu.",{"_4098":3029,"_34307":3027,"_5":34735,"_23429":66233,"_30870":66234,"_3543":66235},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/overview#what-was-tested","What was tested",{"_4098":3030,"_34307":3027,"_5":34735,"_23429":66237,"_30870":66238,"_3543":66239},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/overview#the-test-matrix","The test matrix",{"_4098":3031,"_34307":3027,"_5":34735,"_23429":66241,"_30870":66242,"_3543":66243},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/overview#what-each-case-checks","What each case checks",{"_4098":3032,"_34307":3027,"_5":34735,"_23429":66245,"_30870":66246,"_3543":66247},[],"/docs/pr-preview/pr-58/platform/pqc/integration-tests/overview#behaviour-to-expect","Behaviour to expect",{"_4098":3033,"_34307":3027,"_23429":66249,"_5":16198,"_30870":3027,"_3543":66250},[],"Post-quantum certificates only help if the systems that consume them can use them. These integration tests check that clients and brokers that are not part of Lamassu, built on a different cryptographic library, can connect to a Lamassu TLS endpoint, negotiate post-quantum key exchange and verify post-quantum and composite certificates. Two protocols were tested: HTTPS and MQTTS.",{"_4098":3034,"_34307":3027,"_23429":66252,"_5":16198,"_30870":3027,"_3543":66253},[],"The certificates and CAs used in the tests were generated outside Lamassu, with standard tools, to show that the Go PQC toolchain implements the X.509 and TLS formats in an interoperable way. They show that certificates created externally work with Lamassu's TLS endpoint, and that independent software verifies them. They do not test certificates issued by a Lamassu CA.",{"_4098":3035,"_34307":3027,"_23429":66255,"_5":16198,"_30870":66234,"_3543":66256},[],"The server is the Traefik front proxy that terminates device TLS in Lamassu (TLS front proxy with Traefik). It is built with the Go PQC toolchain and was configured for each test with one key exchange class and one certificate class.",{"_4098":3036,"_34307":3027,"_23429":66258,"_5":16198,"_30870":66234,"_3543":66259},[],"The clients are independent implementations:",{"_4098":3037,"_34307":3027,"_23429":66261,"_5":16198,"_30870":66234,"_3543":66262},[],"**OpenSSL 4.0.3 and 4.1.0**, with the native ML-KEM and ML-DSA support of OpenSSL 3.5 and later.",{"_4098":3038,"_34307":3027,"_23429":66264,"_5":16198,"_30870":66234,"_3543":66265},[],"**The OpenSSL `hybrid-provider` module**, for composite ML-DSA. The build used was written against draft 19 of the specification, which was later published as RFC 10073; the test vectors of both are identical, but the provider was not otherwise checked against the final text.",{"_4098":3039,"_34307":3027,"_23429":66267,"_5":16198,"_30870":66234,"_3543":66268},[],"**`curl`*&#x2A; for HTTPS and **`mosquitto_pub` and `mosquitto_sub` 2.1.2** for MQTTS, both linked against that OpenSSL.",{"_4098":3040,"_34307":3027,"_23429":66270,"_5":16198,"_30870":66238,"_3543":66271},[],"Each combination of key exchange and certificate was tested separately, using the families that Lamassu uses elsewhere (T, PQ and PQ/T, see Algorithms).",{"_4098":3041,"_34307":3027,"_23429":66273,"_5":16198,"_30870":66238,"_3543":66274},[],"Key exchange",{"_4098":3042,"_34307":3027,"_23429":66276,"_5":16198,"_30870":66238,"_3543":66277},[],"Groups the server accepts",{"_4098":3043,"_34307":3027,"_23429":66279,"_5":16198,"_30870":66238,"_3543":65978},[],{"_4098":3044,"_34307":3027,"_23429":66281,"_5":16198,"_30870":66238,"_3543":65688},[],{"_4098":3045,"_34307":3027,"_23429":66283,"_5":16198,"_30870":66238,"_3543":65990},[],{"_4098":3046,"_34307":3027,"_23429":66285,"_5":16198,"_30870":66238,"_3543":65697},[],{"_4098":3047,"_34307":3027,"_23429":66287,"_5":16198,"_30870":66238,"_3543":66002},[],{"_4098":3048,"_34307":3027,"_23429":66289,"_5":16198,"_30870":66238,"_3543":65706},[],{"_4098":3049,"_34307":3027,"_23429":66291,"_5":16198,"_30870":66238,"_3543":61299},[],{"_4098":3050,"_34307":3027,"_23429":66293,"_5":16198,"_30870":66238,"_3543":66294},[],"Server certificate",{"_4098":3051,"_34307":3027,"_23429":66296,"_5":16198,"_30870":66238,"_3543":65978},[],{"_4098":3052,"_34307":3027,"_23429":66298,"_5":16198,"_30870":66238,"_3543":66299},[],"ECDSA P-256",{"_4098":3053,"_34307":3027,"_23429":66301,"_5":16198,"_30870":66238,"_3543":65990},[],{"_4098":3054,"_34307":3027,"_23429":66303,"_5":16198,"_30870":66238,"_3543":65086},[],{"_4098":3055,"_34307":3027,"_23429":66305,"_5":16198,"_30870":66238,"_3543":66002},[],{"_4098":3056,"_34307":3027,"_23429":66307,"_5":16198,"_30870":66238,"_3543":66308},[],"Composite `MLDSA65-RSA3072-PSS-SHA512`",{"_4098":3057,"_34307":3027,"_23429":66310,"_5":16198,"_30870":66238,"_3543":66311},[],"That gives nine combinations. Three more composite certificates were tested with PQ/T key exchange: `MLDSA44-ECDSA-P256-SHA256`, `MLDSA65-ECDSA-P256-SHA512` and `MLDSA65-Ed25519-SHA512`, for twelve cases in total. Every certificate was issued by a test CA with the same algorithm as the certificate.",{"_4098":3058,"_34307":3027,"_23429":66313,"_5":16198,"_30870":66242,"_3543":66314},[],"A case passes only if all of these hold:",{"_4098":3059,"_34307":3027,"_23429":66316,"_5":16198,"_30870":66242,"_3543":66317},[],"**Key exchange.** The group negotiated in the handshake is the one expected for the case.",{"_4098":3060,"_34307":3027,"_23429":66319,"_5":16198,"_30870":66242,"_3543":66320},[],"**Signature.** The signature scheme of the server's handshake signature is the one expected for the certificate.",{"_4098":3061,"_34307":3027,"_23429":66322,"_5":16198,"_30870":66242,"_3543":66323},[],"**Chain.** The client verifies the certificate chain against the CA of the case and the server name, with no verification error.",{"_4098":3062,"_34307":3027,"_23429":66325,"_5":16198,"_30870":66242,"_3543":66326},[],"**Application traffic.** The protocol works: an HTTP request returns `200`, or an MQTT message published to the broker reaches a subscriber.",{"_4098":3063,"_34307":3027,"_23429":66328,"_5":16198,"_30870":66242,"_3543":66329},[],"**Wrong key exchange is rejected.** A client that offers every group except those of the case's class fails with the TLS alert `handshake_failure`.",{"_4098":3064,"_34307":3027,"_23429":66331,"_5":16198,"_30870":66242,"_3543":66332},[],"**Wrong certificate scheme is rejected.** A client that offers every signature scheme except the certificate's fails with the same alert.",{"_4098":3065,"_34307":3027,"_23429":66334,"_5":16198,"_30870":66242,"_3543":66335},[],"The last two checks show that the server enforces its configuration, not just that it accepts a compatible client.",{"_4098":3066,"_34307":3027,"_23429":66337,"_5":16198,"_30870":66246,"_3543":66338},[],"**Composite code points had to be aligned.** The TLS signature schemes of composite algorithms use private-use code points. The `hybrid-provider` uses different values by default, so for the tests its code points were set to those of the Go PQC toolchain. A client that implements composite TLS must use the same values.",{"_4098":3067,"_34307":3027,"_23429":66340,"_5":16198,"_30870":66246,"_3543":66341},[],"**Pure ML-DSA and ML-KEM need nothing extra.** They work with OpenSSL 3.5 or later as it is; only composite certificates need the provider.",{"_4098":3068,"_34307":3027,"_23429":66343,"_5":16198,"_30870":66246,"_3543":66344},[],"**Some handshakes take an extra round trip.** A client sends the `X25519MLKEM768` key share first. When the server is configured for a class that does not include it (T and PQ), the server answers with a HelloRetryRequest and the handshake completes with the group it asks for.",{"_4098":3069,"_34307":3027,"_23429":66346,"_5":16198,"_30870":66246,"_3543":66347},[],"**The client's signature preference decides the certificate.** When the server holds certificates of several classes for the same name, it serves the first one that matches the client's list of signature schemes. A default OpenSSL 3.5 or later client lists ML-DSA first, so it is served the ML-DSA certificate and must trust that CA.",{"_4098":3070,"_34307":3027,"_23429":66349,"_5":16198,"_30870":66246,"_3543":66350},[],"<Card title=\"HTTPS\" description=\"A Lamassu API endpoint tested with openssl and curl.\" href=\"/docs/platform/pqc/integration-tests/https\" />",{"_4098":3071,"_34307":3027,"_23429":66352,"_5":16198,"_30870":66246,"_3543":66353},[],"<Card title=\"MQTTS\" description=\"An MQTT broker behind the TLS front proxy, tested with mosquitto.\" href=\"/docs/platform/pqc/integration-tests/mqtts\" />",{"_4098":3072,"_34307":3027,"_23429":66355,"_5":16198,"_30870":66246,"_3543":66356},[],"<Card title=\"Known limitations\" description=\"What is not covered by these tests or by the platform.\" href=\"/docs/platform/pqc/limitations\" />",{"_4098":3073,"_34307":3073,"_5":16596,"_3543":66358,"_34738":66359,"_23429":66360,"_30870":3073},"Keys and certificate authorities",[56936,58404,64948,65363],[],{"_4098":3074,"_34307":3073,"_23429":66362,"_5":16198,"_30870":3073,"_3543":66363},[],"Create post-quantum keys and CAs, sign with them and issue certificates, with the engine support, API values and constraints that apply.",{"_4098":3075,"_34307":3073,"_5":34735,"_23429":66365,"_30870":66366,"_3543":66367},[],"/docs/pr-preview/pr-58/platform/pqc/keys-and-cas#choose-a-crypto-engine-that-supports-the-algorithm","Choose a crypto engine that supports the algorithm",{"_4098":3076,"_34307":3073,"_5":34735,"_23429":66369,"_30870":66370,"_3543":66371},[],"/docs/pr-preview/pr-58/platform/pqc/keys-and-cas#create-a-key","Create a key",{"_4098":3077,"_34307":3073,"_5":34735,"_23429":66373,"_30870":66374,"_3543":66375},[],"/docs/pr-preview/pr-58/platform/pqc/keys-and-cas#create-a-certificate-authority","Create a certificate authority",{"_4098":3078,"_34307":3073,"_5":34735,"_23429":66377,"_30870":66378,"_3543":66379},[],"/docs/pr-preview/pr-58/platform/pqc/keys-and-cas#mixing-algorithms-in-a-hierarchy","Mixing algorithms in a hierarchy",{"_4098":3079,"_34307":3073,"_5":34735,"_23429":66381,"_30870":66382,"_3543":66383},[],"/docs/pr-preview/pr-58/platform/pqc/keys-and-cas#signing-and-verifying-with-a-key","Signing and verifying with a key",{"_4098":3080,"_34307":3073,"_5":34735,"_23429":66385,"_30870":66386,"_3543":66387},[],"/docs/pr-preview/pr-58/platform/pqc/keys-and-cas#constraints-to-keep-in-mind","Constraints to keep in mind",{"_4098":3081,"_34307":3073,"_23429":66389,"_5":16198,"_30870":3073,"_3543":66390},[],"The Lamassu backend treats post-quantum keys as one more key type of the Key Management Service (KMS). A certificate authority created with such a key signs certificates and revocation lists through the same paths as an RSA or ECDSA CA, because the fork of Go performs the signing. This page explains what to send to the API, which crypto engines can hold the keys and where the behaviour differs from classical keys. The backend must be built with the Go PQC toolchain.",{"_4098":3082,"_34307":3073,"_23429":66392,"_5":16198,"_30870":66366,"_3543":66393},[],"Not every crypto engine can create or hold post-quantum keys. Only the engines that run the cryptography in the Lamassu process can.",{"_4098":3083,"_34307":3073,"_23429":66395,"_5":16198,"_30870":66366,"_3543":66396},[],"Engine",{"_4098":3084,"_34307":3073,"_23429":66398,"_5":16198,"_30870":66366,"_3543":66399},[],"ML-DSA, SLH-DSA, Composite, Ed25519",{"_4098":3085,"_34307":3073,"_23429":66401,"_5":16198,"_30870":66366,"_3543":66402},[],"Filesystem",{"_4098":3086,"_34307":3073,"_23429":66404,"_5":16198,"_30870":66366,"_3543":66405},[],"Supported",{"_4098":3087,"_34307":3073,"_23429":66407,"_5":16198,"_30870":66366,"_3543":66408},[],"Software (golang)",{"_4098":3088,"_34307":3073,"_23429":66410,"_5":16198,"_30870":66366,"_3543":66405},[],{"_4098":3089,"_34307":3073,"_23429":66412,"_5":16198,"_30870":66366,"_3543":66413},[],"HashiCorp Vault KV2",{"_4098":3090,"_34307":3073,"_23429":66415,"_5":16198,"_30870":66366,"_3543":66416},[],"Not supported",{"_4098":3091,"_34307":3073,"_23429":66418,"_5":16198,"_30870":66366,"_3543":63856},[],{"_4098":3092,"_34307":3073,"_23429":66420,"_5":16198,"_30870":66366,"_3543":66416},[],{"_4098":3093,"_34307":3073,"_23429":66422,"_5":16198,"_30870":66366,"_3543":63860},[],{"_4098":3094,"_34307":3073,"_23429":66424,"_5":16198,"_30870":66366,"_3543":66416},[],{"_4098":3095,"_34307":3073,"_23429":66426,"_5":16198,"_30870":66366,"_3543":66427},[],"Azure Key Vault and Azure Secrets",{"_4098":3096,"_34307":3073,"_23429":66429,"_5":16198,"_30870":66366,"_3543":66416},[],{"_4098":3097,"_34307":3073,"_23429":66431,"_5":16198,"_30870":66366,"_3543":66432},[],"PKCS#11 (HSM)",{"_4098":3098,"_34307":3073,"_23429":66434,"_5":16198,"_30870":66366,"_3543":66416},[],{"_4098":3099,"_34307":3073,"_23429":66436,"_5":16198,"_30870":66366,"_3543":66437},[],"In practice, post-quantum keys currently require the filesystem engine, which has security level 1. Keys with a higher assurance level, in a hardware security module or a cloud KMS, are not available for these algorithms.",{"_4098":3100,"_34307":3073,"_23429":66439,"_5":16198,"_30870":66366,"_3543":66440},[],"The Vault KV2 and AWS Secrets Manager engines list the post-quantum key types among the types they support, so a request passes the compatibility check. The creation then fails with an `unsupported key type` error from the engine. Select a filesystem or software engine explicitly with `engine_id`.",{"_4098":3101,"_34307":3073,"_23429":66442,"_5":16198,"_30870":66370,"_3543":66443},[],"A KMS key is created with the algorithm and size described in Algorithms:",{"_4098":3102,"_34307":3073,"_23429":66445,"_5":16198,"_30870":66370,"_3543":66446},[],"Invalid parameters are rejected with an explicit message: an ML-DSA size other than 44, 65 or 87, an SLH-DSA identifier outside 1 to 12, a composite variant outside 1 to 15, or a composite variant that does not belong to the requested family. Importing a private key in PKCS#8 form detects the algorithm and the parameter set automatically; the import accepts ML-DSA, SLH-DSA, composite and Ed25519 keys.",{"_4098":3103,"_34307":3073,"_23429":66448,"_5":16198,"_30870":66374,"_3543":66449},[],"A CA with a post-quantum key uses the same request as any other CA, sent to `POST /api/ca/v1/cas`. Only `key_metadata` changes, where `bits` carries the parameter set. A root CA with ML-DSA-65:",{"_4098":3104,"_34307":3073,"_23429":66451,"_5":16198,"_30870":66374,"_3543":66452},[],"A root CA with a composite key of ML-DSA-44 and ECDSA P-256 uses `\"key_metadata\": { \"type\": \"Composite-ML-DSA-ECDSA\", \"bits\": 9 }`. Ed25519 uses `\"type\": \"Ed25519\", \"bits\": 256` and SLH-DSA uses `\"type\": \"SLH-DSA\", \"bits\": 1` to select SLH-DSA-SHA2-128s. Subordinate CAs are created the same way: the subordinate signs its own certificate request with the KMS key and the parent CA issues the certificate.",{"_4098":3105,"_34307":3073,"_23429":66454,"_5":16198,"_30870":66374,"_3543":66455},[],"Existing CAs can be imported with a post-quantum private key for ML-DSA and Ed25519. Importing a CA with an SLH-DSA or composite key is not supported.",{"_4098":3106,"_34307":3073,"_23429":66457,"_5":16198,"_30870":66378,"_3543":66458},[],"The backend places no restriction on which algorithm issues which. A CA with an ML-DSA key can issue certificates to RSA, ECDSA, Ed25519 and ML-DSA subjects, and an RSA or ECDSA CA can issue certificates to post-quantum subjects. The test suite covers the full ML-DSA and Ed25519 matrix through the API, and covers SLH-DSA and composite CAs and leaves at the certificate engine level. This makes it possible to introduce a post-quantum CA beneath a classical root, or the reverse, but a relying party must be able to verify every algorithm in the chain. In TLS, the signatures in the certificate chain are checked against the client's `signature_algorithms_cert` extension, so a chain signed with ML-DSA or a composite algorithm needs a client that announces it there.",{"_4098":3107,"_34307":3073,"_23429":66460,"_5":16198,"_30870":66382,"_3543":66461},[],"The KMS signing endpoint accepts new `signature_algorithm` values. The `message_type` field is ignored for all of them. The ML-DSA, SLH-DSA and Ed25519 values are \"pure\": the message is signed directly, without pre-hashing (not HashML-DSA, HashSLH-DSA or Ed25519ph). The composite values hash the message with the hash of the variant and sign a message representative that includes a fixed label and the optional context.",{"_4098":3108,"_34307":3073,"_23429":66463,"_5":16198,"_30870":66382,"_3543":64879},[],{"_4098":3109,"_34307":3073,"_23429":66465,"_5":16198,"_30870":66382,"_3543":66466},[],"`signature_algorithm`",{"_4098":3110,"_34307":3073,"_23429":66468,"_5":16198,"_30870":66382,"_3543":66469},[],"ML-DSA-44, -65, -87",{"_4098":3111,"_34307":3073,"_23429":66471,"_5":16198,"_30870":66382,"_3543":66472},[],"`MLDSA_44_PURE`, `MLDSA_65_PURE`, `MLDSA_87_PURE`",{"_4098":3112,"_34307":3073,"_23429":66474,"_5":16198,"_30870":66382,"_3543":64965},[],{"_4098":3113,"_34307":3073,"_23429":66476,"_5":16198,"_30870":66382,"_3543":66477},[],"`SLHDSA_PURE`",{"_4098":3114,"_34307":3073,"_23429":66479,"_5":16198,"_30870":66382,"_3543":66480},[],"Composite",{"_4098":3115,"_34307":3073,"_23429":66482,"_5":16198,"_30870":66382,"_3543":66483},[],"`COMPOSITE_MLDSA_RSA_PURE`, `COMPOSITE_MLDSA_ECDSA_PURE`, `COMPOSITE_MLDSA_ED25519_PURE`",{"_4098":3116,"_34307":3073,"_23429":66485,"_5":16198,"_30870":66382,"_3543":64973},[],{"_4098":3117,"_34307":3073,"_23429":66487,"_5":16198,"_30870":66382,"_3543":66488},[],"`Ed25519_PURE`",{"_4098":3118,"_34307":3073,"_23429":66490,"_5":16198,"_30870":66382,"_3543":66491},[],"The backend does not check that the algorithm matches the key; choose the value that corresponds to the key type. When a CA signs a certificate or a revocation list, the algorithm is selected automatically.",{"_4098":3119,"_34307":3073,"_23429":66493,"_5":16198,"_30870":66386,"_3543":66494},[],"Several parts of the platform do not yet handle post-quantum keys. They are collected in Known limitations; the ones that affect daily operation are these.",{"_4098":3120,"_34307":3073,"_23429":66496,"_5":16198,"_30870":66386,"_3543":66497},[],"Issuance profiles enforce key restrictions only for RSA and ECDSA, through `allow_rsa_keys` and `allow_ecdsa_keys`. A profile with enforcement enabled does not block post-quantum keys, and has no switch to allow or deny them.",{"_4098":3121,"_34307":3073,"_23429":66499,"_5":16198,"_30870":66386,"_3543":66500},[],"The key strength recorded for a certificate whose key is post-quantum or Ed25519 is computed only for RSA and ECDSA, so those certificates are stored with an unknown key type and size and a low strength.",{"_4098":3122,"_34307":3073,"_23429":66502,"_5":16198,"_30870":66386,"_3543":66503},[],"OCSP responses are signed with the `golang.org/x/crypto/ocsp` library, which supports only RSA and ECDSA signing keys. A CA with a post-quantum, Ed25519 or composite key is therefore not expected to be able to sign OCSP responses; CRLs are produced with the fork and are not affected by this limit, although they are not covered by tests.",{"_4098":3123,"_34307":3073,"_23429":66505,"_5":16198,"_30870":66386,"_3543":66506},[],"Server-side key generation in the DMS (the EST `serverkeygen` operation) generates only RSA and ECDSA keys.",{"_4098":3124,"_34307":3073,"_23429":66508,"_5":16198,"_30870":66386,"_3543":66509},[],"<Card title=\"Related certificates\" description=\"Bind a post-quantum certificate to an existing classical one.\" href=\"/docs/platform/pqc/related-certificates\" />",{"_4098":3125,"_34307":3073,"_23429":66511,"_5":16198,"_30870":66386,"_3543":66512},[],"<Card title=\"Dashboard\" description=\"Create the same objects from the web interface.\" href=\"/docs/platform/pqc/dashboard\" />",{"_4098":3126,"_34307":3126,"_5":16596,"_3543":66514,"_34738":66515,"_23429":66517,"_30870":3126},"Known limitations",[56936,58404,64948,66516],"Reference",[],{"_4098":3127,"_34307":3126,"_23429":66519,"_5":16198,"_30870":3126,"_3543":66520},[],"What is incomplete, non-standard or unverified in Lamassu's post-quantum support, grouped by component.",{"_4098":3128,"_34307":3126,"_5":34735,"_23429":66522,"_30870":66523,"_3543":66524},[],"/docs/pr-preview/pr-58/platform/pqc/limitations#standards-and-interoperability","Standards and interoperability",{"_4098":3129,"_34307":3126,"_5":34735,"_23429":66526,"_30870":66527,"_3543":66528},[],"/docs/pr-preview/pr-58/platform/pqc/limitations#keys-and-engines","Keys and engines",{"_4098":3130,"_34307":3126,"_5":34735,"_23429":66530,"_30870":66531,"_3543":66532},[],"/docs/pr-preview/pr-58/platform/pqc/limitations#certificate-authority-and-validation","Certificate authority and validation",{"_4098":3131,"_34307":3126,"_5":34735,"_23429":66534,"_30870":66535,"_3543":65361},[],"/docs/pr-preview/pr-58/platform/pqc/limitations#dashboard",{"_4098":3132,"_34307":3126,"_5":34735,"_23429":66537,"_30870":66538,"_3543":66539},[],"/docs/pr-preview/pr-58/platform/pqc/limitations#build-and-deployment","Build and deployment",{"_4098":3133,"_34307":3126,"_23429":66541,"_5":16198,"_30870":3126,"_3543":66542},[],"This page collects the limits of the current implementation so they can be weighed before planning a deployment. Each one has been observed in the code or the tests of the branches described in this section.",{"_4098":3134,"_34307":3126,"_23429":66544,"_5":16198,"_30870":66523,"_3543":66545},[],"Composite certificates follow RFC 10073. The implementation was written against draft 19 and passes the RFC's test vectors, but it has not had a full conformance assessment. Three of its algorithms (the two Brainpool variants and Ed448) are not implemented. The composite signature schemes in TLS use private-use code points in `0xFE00` to `0xFE0E` because IANA has assigned none, so they interoperate only with peers built from the same Go fork. Composite RSA-PKCS#1 v1.5 variants cannot authenticate a TLS handshake. SLH-DSA has no TLS signature scheme. The related-certificate request attribute has not been checked against other implementations of RFC 9763.",{"_4098":3135,"_34307":3126,"_23429":66547,"_5":16198,"_30870":66527,"_3543":66548},[],"Post-quantum, composite and Ed25519 keys work only with the filesystem and software engines. The Vault KV2 and AWS Secrets Manager engines announce support and then fail at creation, and AWS KMS, Azure and PKCS#11 do not support them. There is therefore no hardware-backed or cloud-KMS-backed post-quantum key. Some engine error messages are copied from other engines and name the wrong one.",{"_4098":3136,"_34307":3126,"_23429":66550,"_5":16198,"_30870":66527,"_3543":66551},[],"The `CryptoEngine` interface gained methods to create and import each new key type. Engines developed outside the Lamassu repository must implement them.",{"_4098":3137,"_34307":3126,"_23429":66553,"_5":16198,"_30870":66531,"_3543":66554},[],"OCSP responses cannot be signed by a CA with a post-quantum, Ed25519 or composite key, because the signing library supports only RSA and ECDSA. CRL generation uses the fork's signing and is expected to work, but neither CRL nor OCSP has tests with these keys.",{"_4098":3138,"_34307":3126,"_23429":66556,"_5":16198,"_30870":66531,"_3543":66557},[],"Issuance profiles cannot allow or deny post-quantum algorithms; their enforcement applies only to RSA and ECDSA. The key strength of an issued certificate is computed only for RSA and ECDSA, so other certificates are stored with unknown type and size and low strength. Importing an existing CA with an SLH-DSA or composite key is not supported.",{"_4098":3139,"_34307":3126,"_23429":66559,"_5":16198,"_30870":66531,"_3543":66560},[],"The DMS can generate keys on the server only for RSA and ECDSA, so `serverkeygen` cannot return a post-quantum key. The enrollment flows through EST and the device manager have no tests with post-quantum keys.",{"_4098":3140,"_34307":3126,"_23429":66562,"_5":16198,"_30870":66531,"_3543":66563},[],"The backend does not evaluate the related-certificate extension. It only issues it.",{"_4098":3141,"_34307":3126,"_23429":66565,"_5":16198,"_30870":66535,"_3543":66566},[],"The in-browser SLH-DSA key generator maps parameter set identifiers differently from the rest of the interface, as described in Dashboard. Key type names are not uniform between screens, and the interface has no experimental notice and no translation.",{"_4098":3142,"_34307":3126,"_23429":66568,"_5":16198,"_30870":66538,"_3543":66569},[],"Everything depends on forks of Go and Traefik that are not upstream, and the proxy image has a mutable tag. The backend's OpenAPI specification for the KMS still lists only RSA, ECDSA and Ed25519 and does not reflect the new key types.",{"_4098":3143,"_34307":3126,"_23429":66571,"_5":16198,"_30870":66538,"_3543":66572},[],"The Helm chart uses fixed resource names, supports one release per namespace and sends traffic from Traefik to Envoy without verifying certificates. The post-quantum certificates created by the installer are valid for 365 days and are not renewed. The installer needs a Linux host and runs a Helm install, not an upgrade.",{"_4098":3144,"_34307":3126,"_23429":66574,"_5":16198,"_30870":66538,"_3543":66575},[],"<Card title=\"Post-quantum cryptography overview\" description=\"Return to the summary of the section.\" href=\"/docs/platform/pqc/overview\" />",{"_4098":3145,"_34307":3145,"_5":16596,"_3543":66577,"_34738":66578,"_23429":66579,"_30870":3145},"Post-quantum cryptography overview",[56936,58404,64948],[],{"_4098":3146,"_34307":3145,"_23429":66581,"_5":16198,"_30870":3145,"_3543":66582},[],"What post-quantum (PQC) support Lamassu adds to keys, certificate authorities, device TLS and deployment, and how its pieces fit together.",{"_4098":3147,"_34307":3145,"_5":34735,"_23429":66584,"_30870":66585,"_3543":66586},[],"/docs/pr-preview/pr-58/platform/pqc/overview#why-it-matters-for-device-fleets","Why it matters for device fleets",{"_4098":3148,"_34307":3145,"_5":34735,"_23429":66588,"_30870":66589,"_3543":66590},[],"/docs/pr-preview/pr-58/platform/pqc/overview#three-families-of-algorithms","Three families of algorithms",{"_4098":3149,"_34307":3145,"_5":34735,"_23429":66592,"_30870":66593,"_3543":66594},[],"/docs/pr-preview/pr-58/platform/pqc/overview#how-the-pieces-fit","How the pieces fit",{"_4098":3150,"_34307":3145,"_5":34735,"_23429":66596,"_30870":66597,"_3543":66598},[],"/docs/pr-preview/pr-58/platform/pqc/overview#where-to-read-next","Where to read next",{"_4098":3151,"_34307":3145,"_23429":66600,"_5":16198,"_30870":3145,"_3543":66601},[],"Lamassu can create keys, certificate authorities (CAs) and certificates that use post-quantum signature algorithms, and it can serve and verify them over TLS. The work spans five codebases that depend on one another: a fork of the Go toolchain that implements the algorithms, the Lamassu backend, the web dashboard, a fork of the Traefik proxy that terminates TLS for devices, and the Helm chart that deploys all of it together.",{"_4098":3152,"_34307":3145,"_23429":66603,"_5":16198,"_30870":3145,"_3543":66604},[],"PQC support lives in development branches and in forks of Go and Traefik, not in the upstream projects or in the standard Lamassu images. The composite TLS signature schemes use private-use code points that no other TLS stack understands, and the composite certificate format follows RFC 10073, a recent standard that has little deployment experience yet. Plan pilots and laboratory deployments, not production fleets. Known limitations lists what is incomplete.",{"_4098":3153,"_34307":3145,"_23429":66606,"_5":16198,"_30870":66585,"_3543":66607},[],"Certificates issued to devices often live for years, and the devices that hold them are hard to replace. A signature algorithm that is broken by a future quantum computer would force a fleet-wide re-enrollment. Issuing devices a certificate signed with a post-quantum or composite algorithm today, and serving them a TLS endpoint that accepts it, lets a fleet be validated against that risk before it becomes urgent. Signatures are not exposed to \"harvest now, decrypt later\" attacks the way a key exchange is, so the urgency is about the lifetime of certificates and devices, not about recorded traffic.",{"_4098":3154,"_34307":3145,"_23429":66609,"_5":16198,"_30870":66589,"_3543":66610},[],"Lamassu groups signature algorithms in three families, the same labels the dashboard shows.",{"_4098":3155,"_34307":3145,"_23429":66612,"_5":16198,"_30870":66589,"_3543":66613},[],"Label",{"_4098":3156,"_34307":3145,"_23429":66615,"_5":16198,"_30870":66589,"_3543":65189},[],{"_4098":3157,"_34307":3145,"_23429":66617,"_5":16198,"_30870":66589,"_3543":64946},[],{"_4098":3158,"_34307":3145,"_23429":66619,"_5":16198,"_30870":66589,"_3543":65978},[],{"_4098":3159,"_34307":3145,"_23429":66621,"_5":16198,"_30870":66589,"_3543":66622},[],"Traditional",{"_4098":3160,"_34307":3145,"_23429":66624,"_5":16198,"_30870":66589,"_3543":66625},[],"RSA, ECDSA, Ed25519",{"_4098":3161,"_34307":3145,"_23429":66627,"_5":16198,"_30870":66589,"_3543":65990},[],{"_4098":3162,"_34307":3145,"_23429":66629,"_5":16198,"_30870":66589,"_3543":66630},[],"Pure post-quantum",{"_4098":3163,"_34307":3145,"_23429":66632,"_5":16198,"_30870":66589,"_3543":66633},[],"ML-DSA, SLH-DSA",{"_4098":3164,"_34307":3145,"_23429":66635,"_5":16198,"_30870":66589,"_3543":66002},[],{"_4098":3165,"_34307":3145,"_23429":66637,"_5":16198,"_30870":66589,"_3543":66638},[],"Hybrid (composite)",{"_4098":3166,"_34307":3145,"_23429":66640,"_5":16198,"_30870":66589,"_3543":66641},[],"ML-DSA combined with RSA, ECDSA or Ed25519 in a single key and a single signature",{"_4098":3167,"_34307":3145,"_23429":66643,"_5":16198,"_30870":66589,"_3543":66644},[],"A composite signature is valid only if both of its components verify. Its unforgeability is intended to hold as long as at least one of the two algorithms remains unbroken, provided the relying party requires the composite and does not fall back to a classical certificate. In the key exchange, `PQ/T` means a hybrid group that combines a classical and an ML-KEM exchange, and `PQ` means pure ML-KEM. Algorithms describes each one and the parameter sets Lamassu accepts.",{"_4098":3168,"_34307":3145,"_23429":66646,"_5":16198,"_30870":66593,"_3543":66647},[],"The Go fork is the foundation: the backend and Traefik are compiled with it, because the standard Go toolchain does not provide the composite and SLH-DSA certificate support. The backend creates and holds the keys, issues certificates and signs revocation data. The dashboard drives the same REST API. Devices reach the platform through Traefik, which negotiates post-quantum authentication and key exchange with the device and then forwards the request to Envoy Gateway over ordinary TLS. Post-quantum protection therefore applies only to the hop between the device and Traefik.",{"_4098":3169,"_34307":3145,"_23429":66649,"_5":16198,"_30870":66597,"_3543":66650},[],"Read Algorithms first to learn what is supported and how parameter sets are written in API requests. Developers writing a device client should continue with Go PQC toolchain. Administrators who want to create a post-quantum CA follow Keys and certificate authorities, and those who deploy the platform go to Deployment with the Helm chart.",{"_4098":3170,"_34307":3145,"_23429":66652,"_5":16198,"_30870":66597,"_3543":66653},[],"<Card title=\"Algorithms\" description=\"ML-DSA, SLH-DSA and the 15 composite algorithms, with their parameter sets.\" href=\"/docs/platform/pqc/algorithms\" />",{"_4098":3171,"_34307":3145,"_23429":66655,"_5":16198,"_30870":66597,"_3543":66656},[],"<Card title=\"Keys and certificate authorities\" description=\"Create post-quantum keys and CAs and issue certificates through the API.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_4098":3172,"_34307":3145,"_23429":66658,"_5":16198,"_30870":66597,"_3543":66659},[],"<Card title=\"Deployment with the Helm chart\" description=\"Install the platform with a Traefik front proxy that serves PQC certificates.\" href=\"/docs/platform/pqc/deployment\" />",{"_4098":3173,"_34307":3173,"_5":16596,"_3543":65383,"_34738":66661,"_23429":66662,"_30870":3173},[56936,58404,64948,65363],[],{"_4098":3174,"_34307":3173,"_23429":66664,"_5":16198,"_30870":3173,"_3543":66665},[],"Bind a certificate with a post-quantum key to an existing classical certificate of the same device, following RFC 9763, and how Lamassu issues and checks them.",{"_4098":3175,"_34307":3173,"_5":34735,"_23429":66667,"_30870":66668,"_3543":66669},[],"/docs/pr-preview/pr-58/platform/pqc/related-certificates#how-the-request-works","How the request works",{"_4098":3176,"_34307":3173,"_5":34735,"_23429":66671,"_30870":66672,"_3543":66673},[],"/docs/pr-preview/pr-58/platform/pqc/related-certificates#locations-the-ca-may-fetch-from","Locations the CA may fetch from",{"_4098":3177,"_34307":3173,"_5":34735,"_23429":66675,"_30870":66676,"_3543":66677},[],"/docs/pr-preview/pr-58/platform/pqc/related-certificates#configure-an-issuance-profile","Configure an issuance profile",{"_4098":3178,"_34307":3173,"_5":34735,"_23429":66679,"_30870":66680,"_3543":66681},[],"/docs/pr-preview/pr-58/platform/pqc/related-certificates#what-the-issued-certificate-must-satisfy","What the issued certificate must satisfy",{"_4098":3179,"_34307":3173,"_5":34735,"_23429":66683,"_30870":66684,"_3543":66685},[],"/docs/pr-preview/pr-58/platform/pqc/related-certificates#from-the-dashboard","From the dashboard",{"_4098":3180,"_34307":3173,"_23429":66687,"_5":16198,"_30870":3173,"_3543":66688},[],"A fleet that is migrating to post-quantum algorithms usually holds two certificates per device for a while: the classical one already in use and a new one with a post-quantum key. RFC 9763 defines a way to link them. The new certificate carries the `id-pe-relatedCert` extension (`1.3.6.1.5.5.7.1.36`), which holds a hash of the classical certificate, so a relying party can see that both identify the same entity. Lamassu implements the issuing side of this mechanism.",{"_4098":3181,"_34307":3173,"_23429":66690,"_5":16198,"_30870":3173,"_3543":66691},[],"This option fits when:",{"_4098":3182,"_34307":3173,"_23429":66693,"_5":16198,"_30870":3173,"_3543":66694},[],"the consumers cannot yet validate post-quantum or composite chains, so the classical certificate must remain the one in use;",{"_4098":3183,"_34307":3173,"_23429":66696,"_5":16198,"_30870":3173,"_3543":66697},[],"a device has to carry both certificates and show that they belong together, using each one where the peer supports it.",{"_4098":3184,"_34307":3173,"_23429":66699,"_5":16198,"_30870":3173,"_3543":66700},[],"The hash is SHA-256, SHA-384 or SHA-512, matching the hash of the related certificate's signature algorithm, and SHA-256 when it has none.",{"_4098":3185,"_34307":3173,"_23429":66702,"_5":16198,"_30870":66668,"_3543":66703},[],"The device asks for the bound certificate with an ordinary PKCS#10 certificate request that carries one extra attribute, `relatedCertRequest` (`1.2.840.113549.1.9.16.2.60`). The attribute identifies the existing certificate by issuer and serial number, states the time of the request, gives the location from which the certificate can be downloaded and carries a signature made with the private key of that existing certificate. The signature covers the issuer, the serial number and the request time, not the location, and shows that the requester controls the existing key; the key of the new certificate is proven by the signature of the certificate request itself. Lamassu accepts a list of locations, as in the ASN.1 module of the RFC, and tries them in order.",{"_4098":3186,"_34307":3173,"_23429":66705,"_5":16198,"_30870":66668,"_3543":66706},[],"When the CA service receives such a request it follows these steps:",{"_4098":3187,"_34307":3173,"_23429":66708,"_5":16198,"_30870":66668,"_3543":66709},[],"It checks that the issuance profile in use enables related certificates, and rejects the request otherwise.",{"_4098":3188,"_34307":3173,"_23429":66711,"_5":16198,"_30870":66668,"_3543":66712},[],"It reads the locations in the attribute in order and downloads the first certificate it can retrieve.",{"_4098":3189,"_34307":3173,"_23429":66714,"_5":16198,"_30870":66668,"_3543":66715},[],"It verifies that the issuer and serial number match, that the request time is within the allowed age, and that the signature is valid with the downloaded certificate's key.",{"_4098":3190,"_34307":3173,"_23429":66717,"_5":16198,"_30870":66668,"_3543":66718},[],"It issues the new certificate with the related certificate extension added.",{"_4098":3191,"_34307":3173,"_23429":66720,"_5":16198,"_30870":66668,"_3543":66721},[],"A request without the attribute is processed as usual, whether or not the profile enables the feature.",{"_4098":3192,"_34307":3173,"_23429":66723,"_5":16198,"_30870":66672,"_3543":66724},[],"A location is either a `data:` URI or an `http` or `https` URL. A `data:` URI must be base64-encoded and contains a PKCS#7 structure whose first certificate is the related one; it needs no network access and is always accepted when the feature is enabled. A URL is retrieved only if its host appears in the profile's list of allowed hosts. The CA does not follow redirects, applies a ten-second timeout and rejects responses larger than 1 MiB.",{"_4098":3193,"_34307":3173,"_23429":66726,"_5":16198,"_30870":66672,"_3543":66727},[],"Because the server performs the download, whoever can define an issuance profile decides which hosts the CA is allowed to contact. Restrict that permission accordingly and list only internal certificate repositories.",{"_4098":3194,"_34307":3173,"_23429":66729,"_5":16198,"_30870":66676,"_3543":66730},[],"The feature is configured in the `related_certificate` object of the issuance profile, which is stored with its own database columns:",{"_4098":3195,"_34307":3173,"_23429":66732,"_5":16198,"_30870":66676,"_3543":66733},[],"Field",{"_4098":3196,"_34307":3173,"_23429":66735,"_5":16198,"_30870":66676,"_3543":61088},[],{"_4098":3197,"_34307":3173,"_23429":66737,"_5":16198,"_30870":66676,"_3543":57323},[],{"_4098":3198,"_34307":3173,"_23429":66739,"_5":16198,"_30870":66676,"_3543":61094},[],{"_4098":3199,"_34307":3173,"_23429":66741,"_5":16198,"_30870":66676,"_3543":66742},[],"`enabled`",{"_4098":3200,"_34307":3173,"_23429":66744,"_5":16198,"_30870":66676,"_3543":22068},[],{"_4098":3201,"_34307":3173,"_23429":66746,"_5":16198,"_30870":66676,"_3543":65592},[],{"_4098":3202,"_34307":3173,"_23429":66748,"_5":16198,"_30870":66676,"_3543":66749},[],"When `false`, a request that carries the attribute is rejected.",{"_4098":3203,"_34307":3173,"_23429":66751,"_5":16198,"_30870":66676,"_3543":66752},[],"`allowed_hosts`",{"_4098":3204,"_34307":3173,"_23429":66754,"_5":16198,"_30870":66676,"_3543":66755},[],"list of strings",{"_4098":3205,"_34307":3173,"_23429":66757,"_5":16198,"_30870":66676,"_3543":21341},[],{"_4098":3206,"_34307":3173,"_23429":66759,"_5":16198,"_30870":66676,"_3543":66760},[],"Hosts from which `http` and `https` locations may be downloaded.",{"_4098":3207,"_34307":3173,"_23429":66762,"_5":16198,"_30870":66676,"_3543":66763},[],"`max_age`",{"_4098":3208,"_34307":3173,"_23429":66765,"_5":16198,"_30870":66676,"_3543":6572},[],{"_4098":3209,"_34307":3173,"_23429":66767,"_5":16198,"_30870":66676,"_3543":66768},[],"`5m`",{"_4098":3210,"_34307":3173,"_23429":66770,"_5":16198,"_30870":66676,"_3543":66771},[],"Maximum difference between the request time in the attribute and the time of issuance.",{"_4098":3211,"_34307":3173,"_23429":66773,"_5":16198,"_30870":66680,"_3543":66774},[],"The fork refuses to bind a certificate unless the new one is compatible with the related one. Neither certificate may be a CA. The related certificate must be valid at the time of issuance. The key usages and extended key usages requested for the new certificate must be a subset of those of the related certificate. Verification later compares only the hash, so a relying party that checks the link learns that the issuing CA linked the new certificate to that specific certificate, not that the related certificate is still valid.",{"_4098":3212,"_34307":3173,"_23429":66776,"_5":16198,"_30870":66680,"_3543":66777},[],"The extension is evidence of a relationship, not a dependency. A relying party must still validate each certificate against its own chain and revocation status, and revoking the classical certificate does not revoke the bound one.",{"_4098":3213,"_34307":3173,"_23429":66779,"_5":16198,"_30870":66684,"_3543":66780},[],"The dashboard covers the feature without API requests. The issuance profile form has a *Related Certificates* switch with the allowed hosts and the maximum age, and the issue-certificate form offers *Bind to a related certificate* when the selected profile enables it. Certificate and CA details show a *Related Certificate* row with the hash algorithm and value. The steps, with screenshots, are in Dashboard.",{"_4098":3214,"_34307":3173,"_23429":66782,"_5":16198,"_30870":66684,"_3543":66783},[],"The bound certificate is created by the fork's `CreateBoundCertificate`, whose tests cover an ML-DSA key bound to RSA, ECDSA and Ed25519 certificates. The tests do not use composite keys. Only the issuing side is implemented in Lamassu: the platform does not evaluate the extension when it validates certificates.",{"_4098":3215,"_34307":3173,"_23429":66785,"_5":16198,"_30870":66684,"_3543":66786},[],"<Card title=\"Keys and certificate authorities\" description=\"Create the post-quantum CA that issues the bound certificate.\" href=\"/docs/platform/pqc/keys-and-cas\" />",{"_4098":3216,"_34307":3173,"_23429":66788,"_5":16198,"_30870":66684,"_3543":66789},[],"<Card title=\"Known limitations\" description=\"What is not covered yet.\" href=\"/docs/platform/pqc/limitations\" />",{"_4098":3217,"_34307":3217,"_5":16596,"_3543":66791,"_34738":66792,"_23429":66793,"_30870":3217},"TLS front proxy with Traefik",[56936,58404,64948,56937],[],{"_4098":3218,"_34307":3217,"_23429":66795,"_5":16198,"_30870":3217,"_3543":66796},[],"The Traefik fork that terminates device TLS with classical and post-quantum certificates for the same host, how it picks a certificate and how it is built.",{"_4098":3219,"_34307":3217,"_5":34735,"_23429":66798,"_30870":66799,"_3543":66800},[],"/docs/pr-preview/pr-58/platform/pqc/tls-front-proxy#several-certificates-for-the-same-host","Several certificates for the same host",{"_4098":3220,"_34307":3217,"_5":34735,"_23429":66802,"_30870":66803,"_3543":66804},[],"/docs/pr-preview/pr-58/platform/pqc/tls-front-proxy#tls-options-on-gateway-api-listeners","TLS options on Gateway API listeners",{"_4098":3221,"_34307":3217,"_5":34735,"_23429":66806,"_30870":66807,"_3543":66808},[],"/docs/pr-preview/pr-58/platform/pqc/tls-front-proxy#mutual-tls","Mutual TLS",{"_4098":3222,"_34307":3217,"_5":34735,"_23429":66810,"_30870":66811,"_3543":66812},[],"/docs/pr-preview/pr-58/platform/pqc/tls-front-proxy#building-the-proxy","Building the proxy",{"_4098":3223,"_34307":3217,"_23429":66814,"_5":16198,"_30870":3217,"_3543":66815},[],"Devices connect to Lamassu over TLS, and EST enrollment relies on mutual TLS. To accept a post-quantum or composite certificate on that connection, the TLS endpoint must be built with the Go PQC toolchain. Lamassu does this with a fork of Traefik, based on Traefik 3.7.15, that sits in front of Envoy Gateway. The fork adds two behaviours: it can serve several certificates for the same host and chooses among them per client, and it lets a Gateway API listener reference a Traefik TLS option.",{"_4098":3224,"_34307":3217,"_23429":66817,"_5":16198,"_30870":66799,"_3543":66818},[],"Upstream Traefik keeps one certificate per set of names. If a classical ECDSA certificate and an ML-DSA certificate exist for `lab.example.com`, only the first is kept. The fork stores every distinct certificate (duplicates are detected by comparing the leaf certificate) and chooses one for each handshake.",{"_4098":3225,"_34307":3217,"_23429":66820,"_5":16198,"_30870":66799,"_3543":66821},[],"The choice follows the signature algorithms the client announces:",{"_4098":3226,"_34307":3217,"_23429":66823,"_5":16198,"_30870":66799,"_3543":66824},[],"The server name from the client is normalized and the certificates whose names match it are collected, with exact names ahead of wildcards. A common-name-only certificate still matches.",{"_4098":3227,"_34307":3217,"_23429":66826,"_5":16198,"_30870":66799,"_3543":66827},[],"If no certificate matches, the connection is closed in strict-SNI mode, or the default certificate is served.",{"_4098":3228,"_34307":3217,"_23429":66829,"_5":16198,"_30870":66799,"_3543":66830},[],"If exactly one certificate matches, it is served without further checks.",{"_4098":3229,"_34307":3217,"_23429":66832,"_5":16198,"_30870":66799,"_3543":66833},[],"Otherwise the proxy takes the client's signature schemes in the order the client sent them, and for each scheme returns the first certificate whose key the scheme, the TLS version and the key type allow. This matches the leaf key against `signature_algorithms`, the schemes the client accepts for the handshake signature; the signatures in the rest of the chain are a separate check against `signature_algorithms_cert`.",{"_4098":3230,"_34307":3217,"_23429":66835,"_5":16198,"_30870":66799,"_3543":66836},[],"If the client announces no scheme, the first compatible certificate is returned. If none is compatible, the first candidate is returned and the handshake fails with the underlying error.",{"_4098":3231,"_34307":3217,"_23429":66838,"_5":16198,"_30870":66799,"_3543":66839},[],"The client's order of preference prevails, so a client that lists ML-DSA first receives the post-quantum certificate and a client that lists ECDSA first receives the classical one, even if it also supports ML-DSA. A client with no post-quantum support never announces those schemes and receives the classical certificate. TLS 1.2 never selects ML-DSA or composite certificates. The server cannot be configured with its own order of preference.",{"_4098":3232,"_34307":3217,"_23429":66841,"_5":16198,"_30870":66803,"_3543":66842},[],"Traefik reads its Gateway API configuration from Kubernetes. The fork reads the listener option `traefik.io/tls-options`, whose value names the TLS option to apply to that listener: either `default`, or a qualified name such as `traefik-system-pqc@kubernetescrd`. This works for HTTPS listeners and for TLS listeners in `Terminate` mode that serve a `TLSRoute`. It is ignored in passthrough mode.",{"_4098":3233,"_34307":3217,"_23429":66844,"_5":16198,"_30870":66803,"_3543":66845},[],"A TLS option is where the supported key exchange groups and the client authentication mode are set. When several listeners share a parent router and name different options, the proxy logs a warning and uses isolated defaults for each. Without the fork, Traefik ignores the annotation, applies its own defaults and the settings cannot be controlled; devices that need mutual TLS then fail.",{"_4098":3234,"_34307":3217,"_23429":66847,"_5":16198,"_30870":66803,"_3543":66848},[],"The fork also adds `mlkem1024` to the group names accepted in `curvePreferences`, next to the hybrid groups that Traefik already maps.",{"_4098":3235,"_34307":3217,"_23429":66850,"_5":16198,"_30870":66807,"_3543":66851},[],"Client authentication is the standard Traefik mechanism, configured in the TLS option. With `RequireAndVerifyClientCert` and a client CA file the proxy validates the chain, and the verification of the client signature is done by the TLS stack of the Go fork, which has been tested with composite client certificates in a TLS 1.3 handshake. With `RequestClientCert`, which the Lamassu chart sets in its default option, the proxy checks that the client holds the key of the certificate it presents but does not validate the chain; the decision is delegated to the backend, which receives the certificate in a header (see Deployment with the Helm chart). No Traefik test covers post-quantum mutual TLS, and a client chain signed by a composite or post-quantum CA depends on the x509 code of the fork.",{"_4098":3236,"_34307":3217,"_23429":66853,"_5":16198,"_30870":66811,"_3543":66854},[],"The fork is not built from the Go image. The `build.sh` script requires an already compiled checkout of the Go fork, by default in `../go`, and checks that it is the fork before it forces `GOROOT` and `GOTOOLCHAIN=local`. It compiles the binary with `CGO_ENABLED=0`, builds the web UI unless `SKIP_WEBUI=1`, and packages the binary into an Alpine image with `docker buildx`. The default image is `ghcr.io/lamassuiot/traefik:pqc-3.7.15`.",{"_4098":3237,"_34307":3217,"_23429":66856,"_5":16198,"_30870":66811,"_3543":66857},[],"Variable",{"_4098":3238,"_34307":3217,"_23429":66859,"_5":16198,"_30870":66811,"_3543":57326},[],{"_4098":3239,"_34307":3217,"_23429":66861,"_5":16198,"_30870":66811,"_3543":66862},[],"`GO_FORK_ROOT`",{"_4098":3240,"_34307":3217,"_23429":66864,"_5":16198,"_30870":66811,"_3543":66865},[],"Location of the compiled Go fork.",{"_4098":3241,"_34307":3217,"_23429":66867,"_5":16198,"_30870":66811,"_3543":66868},[],"`PLATFORMS`",{"_4098":3242,"_34307":3217,"_23429":66870,"_5":16198,"_30870":66811,"_3543":66871},[],"Target platforms; the default is `linux/amd64`.",{"_4098":3243,"_34307":3217,"_23429":66873,"_5":16198,"_30870":66811,"_3543":66874},[],"`SKIP_WEBUI`",{"_4098":3244,"_34307":3217,"_23429":66876,"_5":16198,"_30870":66811,"_3543":66877},[],"Skip building the web UI when set to `1`.",{"_4098":3245,"_34307":3217,"_23429":66879,"_5":16198,"_30870":66811,"_3543":66880},[],"`IMAGE`, `PUSH`",{"_4098":3246,"_34307":3217,"_23429":66882,"_5":16198,"_30870":66811,"_3543":66883},[],"Name of the image and whether to push it. Multi-platform builds require `PUSH=1`.",{"_4098":3247,"_34307":3217,"_23429":66885,"_5":16198,"_30870":66811,"_3543":66886},[],"The `pqc-*` tags are mutable and have been rebuilt in place, so pin the digest in production-like environments.",{"_4098":3248,"_34307":3217,"_23429":66888,"_5":16198,"_30870":66811,"_3543":66889},[],"The selection tests of the fork use pure ML-DSA-65 together with ECDSA P-256. Selecting a composite certificate depends on the fork's TLS stack knowing the composite key, which it does, but the proxy has no test for it.",{"_4098":3249,"_34307":3217,"_23429":66891,"_5":16198,"_30870":66811,"_3543":66892},[],"<Card title=\"Deployment with the Helm chart\" description=\"Install the proxy in front of Envoy Gateway with the chart.\" href=\"/docs/platform/pqc/deployment\" />",{"_4098":3250,"_34307":3217,"_23429":66894,"_5":16198,"_30870":66811,"_3543":66895},[],"<Card title=\"Known limitations\" description=\"Interoperability and operational caveats.\" href=\"/docs/platform/pqc/limitations\" />",{"_4098":3251,"_34307":3251,"_5":16596,"_3543":66897,"_34738":66898,"_23429":66899,"_30870":3251},"Security",[56936],[],{"_4098":3252,"_34307":3251,"_23429":66901,"_5":16198,"_30870":3251,"_3543":66902},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_4098":3253,"_34307":3251,"_5":34735,"_23429":66904,"_30870":66905,"_3543":66906},[],"/docs/pr-preview/pr-58/security#report-a-vulnerability","Report a vulnerability",{"_4098":3254,"_34307":3251,"_5":34735,"_23429":66908,"_30870":66909,"_3543":66910},[],"/docs/pr-preview/pr-58/security#what-to-include-in-a-report","What to include in a report",{"_4098":3255,"_34307":3251,"_5":34735,"_23429":66912,"_30870":66913,"_3543":66914},[],"/docs/pr-preview/pr-58/security#supported-versions","Supported versions",{"_4098":3256,"_34307":3251,"_5":34735,"_23429":66916,"_30870":66917,"_3543":66918},[],"/docs/pr-preview/pr-58/security#responsible-disclosure","Responsible disclosure",{"_4098":3257,"_34307":3251,"_23429":66920,"_5":16198,"_30870":3251,"_3543":66921},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_4098":3258,"_34307":3251,"_23429":66923,"_5":16198,"_30870":66905,"_3543":66924},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_4098":3259,"_34307":3251,"_23429":66926,"_5":16198,"_30870":66905,"_3543":66927},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_4098":3260,"_34307":3251,"_23429":66929,"_5":16198,"_30870":66905,"_3543":16951},[],{"_4098":3261,"_34307":3251,"_23429":66931,"_5":16198,"_30870":66905,"_3543":16887},[],{"_4098":3262,"_34307":3251,"_23429":66933,"_5":16198,"_30870":66905,"_3543":16944},[],{"_4098":3263,"_34307":3251,"_23429":66935,"_5":16198,"_30870":66905,"_3543":66936},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_4098":3264,"_34307":3251,"_23429":66938,"_5":16198,"_30870":66905,"_3543":66939},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_4098":3265,"_34307":3251,"_23429":66941,"_5":16198,"_30870":66909,"_3543":66942},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_4098":3266,"_34307":3251,"_23429":66944,"_5":16198,"_30870":66909,"_3543":66945},[],"Do not include in the report:",{"_4098":3267,"_34307":3251,"_23429":66947,"_5":16198,"_30870":66909,"_3543":66948},[],"Credentials, tokens, or private keys",{"_4098":3268,"_34307":3251,"_23429":66950,"_5":16198,"_30870":66909,"_3543":66951},[],"Customer data or customer-identifiable information",{"_4098":3269,"_34307":3251,"_23429":66953,"_5":16198,"_30870":66909,"_3543":66954},[],"Confidential architecture or internal infrastructure details",{"_4098":3270,"_34307":3251,"_23429":66956,"_5":16198,"_30870":66913,"_3543":66957},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_4098":3271,"_34307":3251,"_23429":66959,"_5":16198,"_30870":66913,"_3543":66960},[],"For upgrade guidance, see Upgrades.",{"_4098":3272,"_34307":3251,"_23429":66962,"_5":16198,"_30870":66917,"_3543":66963},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_4098":3273,"_34307":3251,"_23429":66965,"_5":16198,"_30870":66917,"_3543":66966},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_4098":3274,"_34307":3251,"_23429":66968,"_5":16198,"_30870":66917,"_3543":66969},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_4098":3275,"_34307":3251,"_23429":66971,"_5":16198,"_30870":66917,"_3543":66972},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_4098":3276,"_34307":3251,"_23429":66974,"_5":16198,"_30870":66917,"_3543":66975},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_4098":3277,"_34307":3277,"_5":16596,"_3543":66977,"_34738":66978,"_23429":66980,"_30870":3277},"3.8.0 to 4.0.0",[56936,66979],"Upgrades",[],{"_4098":3278,"_34307":3277,"_23429":66982,"_5":16198,"_30870":3277,"_3543":66983},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_4098":3279,"_34307":3277,"_5":34735,"_23429":66985,"_30870":66986,"_3543":66987},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_4098":3280,"_34307":3277,"_5":34735,"_23429":66989,"_30870":66990,"_3543":66991},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_4098":3281,"_34307":3277,"_5":34735,"_23429":66993,"_30870":66994,"_3543":66995},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_4098":3282,"_34307":3277,"_5":34735,"_23429":66997,"_30870":66998,"_3543":66999},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_4098":3283,"_34307":3277,"_5":34735,"_23429":67001,"_30870":67002,"_3543":67003},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_4098":3284,"_34307":3277,"_5":34735,"_23429":67005,"_30870":67006,"_3543":67007},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_4098":3285,"_34307":3277,"_5":34735,"_23429":67009,"_30870":67010,"_3543":67011},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_4098":3286,"_34307":3277,"_5":34735,"_23429":67013,"_30870":67014,"_3543":67015},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_4098":3287,"_34307":3277,"_5":34735,"_23429":67017,"_30870":67018,"_3543":67019},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_4098":3288,"_34307":3277,"_5":34735,"_23429":67021,"_30870":67022,"_3543":67023},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_4098":3289,"_34307":3277,"_5":34735,"_23429":67025,"_30870":67026,"_3543":67027},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_4098":3290,"_34307":3277,"_5":34735,"_23429":67029,"_30870":67030,"_3543":67031},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_4098":3291,"_34307":3277,"_5":34735,"_23429":67033,"_30870":67034,"_3543":67035},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_4098":3292,"_34307":3277,"_5":34735,"_23429":67037,"_30870":67038,"_3543":67039},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_4098":3293,"_34307":3277,"_5":34735,"_23429":67041,"_30870":67042,"_3543":67043},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_4098":3294,"_34307":3277,"_5":34735,"_23429":67045,"_30870":67046,"_3543":67047},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_4098":3295,"_34307":3277,"_5":34735,"_23429":67049,"_30870":67050,"_3543":67051},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_4098":3296,"_34307":3277,"_5":34735,"_23429":67053,"_30870":67054,"_3543":67055},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_4098":3297,"_34307":3277,"_5":34735,"_23429":67057,"_30870":67058,"_3543":67059},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_4098":3298,"_34307":3277,"_5":34735,"_23429":67061,"_30870":67062,"_3543":67063},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-va-roles","References between certificates, keys and VA roles",{"_4098":3299,"_34307":3277,"_5":34735,"_23429":67065,"_30870":67066,"_3543":67067},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_4098":3300,"_34307":3277,"_5":34735,"_23429":67069,"_30870":67070,"_3543":67071},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_4098":3301,"_34307":3277,"_5":34735,"_23429":67073,"_30870":67074,"_3543":67075},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_4098":3302,"_34307":3277,"_5":34735,"_23429":67077,"_30870":67078,"_3543":67079},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_4098":3303,"_34307":3277,"_5":34735,"_23429":67081,"_30870":67082,"_3543":67083},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_4098":3304,"_34307":3277,"_5":34735,"_23429":67085,"_30870":67086,"_3543":67087},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_4098":3305,"_34307":3277,"_5":34735,"_23429":67089,"_30870":67090,"_3543":67091},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_4098":3306,"_34307":3277,"_5":34735,"_23429":67093,"_30870":67094,"_3543":67095},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#va-role-signer-field","VA role signer field",{"_4098":3307,"_34307":3277,"_5":34735,"_23429":67097,"_30870":67098,"_3543":67099},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_4098":3308,"_34307":3277,"_5":34735,"_23429":67101,"_30870":67102,"_3543":67103},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_4098":3309,"_34307":3277,"_5":34735,"_23429":67105,"_30870":67106,"_3543":67107},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_4098":3310,"_34307":3277,"_5":34735,"_23429":67109,"_30870":67110,"_3543":67111},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_4098":3311,"_34307":3277,"_5":34735,"_23429":67113,"_30870":67114,"_3543":67115},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_4098":3312,"_34307":3277,"_5":34735,"_23429":67117,"_30870":67118,"_3543":67119},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_4098":3313,"_34307":3277,"_5":34735,"_23429":67121,"_30870":67122,"_3543":67123},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_4098":3314,"_34307":3277,"_5":34735,"_23429":67125,"_30870":67126,"_3543":60981},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_4098":3315,"_34307":3277,"_5":34735,"_23429":67128,"_30870":67129,"_3543":67130},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_4098":3316,"_34307":3277,"_5":34735,"_23429":67132,"_30870":67133,"_3543":67134},[],"/docs/pr-preview/pr-58/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_4098":3317,"_34307":3277,"_23429":67136,"_5":16198,"_30870":3277,"_3543":67137},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_4098":3318,"_34307":3277,"_23429":67139,"_5":16198,"_30870":3277,"_3543":67140},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_4098":3319,"_34307":3277,"_23429":67142,"_5":16198,"_30870":3277,"_3543":67143},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_4098":3320,"_34307":3277,"_23429":67145,"_5":16198,"_30870":3277,"_3543":67146},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_4098":3321,"_34307":3277,"_23429":67148,"_5":16198,"_30870":3277,"_3543":67149},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_4098":3322,"_34307":3277,"_23429":67151,"_5":16198,"_30870":3277,"_3543":67152},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_4098":3323,"_34307":3277,"_23429":67154,"_5":16198,"_30870":3277,"_3543":67155},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_4098":3324,"_34307":3277,"_23429":67157,"_5":16198,"_30870":66990,"_3543":67158},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_4098":3325,"_34307":3277,"_23429":67160,"_5":16198,"_30870":66990,"_3543":67161},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_4098":3326,"_34307":3277,"_23429":67163,"_5":16198,"_30870":66994,"_3543":67164},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_4098":3327,"_34307":3277,"_23429":67166,"_5":16198,"_30870":66994,"_3543":67167},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_4098":3328,"_34307":3277,"_23429":67169,"_5":16198,"_30870":66998,"_3543":67170},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_4098":3329,"_34307":3277,"_23429":67172,"_5":16198,"_30870":67002,"_3543":67173},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_4098":3330,"_34307":3277,"_23429":67175,"_5":16198,"_30870":67002,"_3543":67176},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_4098":3331,"_34307":3277,"_23429":67178,"_5":16198,"_30870":67002,"_3543":67179},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_4098":3332,"_34307":3277,"_23429":67181,"_5":16198,"_30870":67002,"_3543":67182},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_4098":3333,"_34307":3277,"_23429":67184,"_5":16198,"_30870":67002,"_3543":67185},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_4098":3334,"_34307":3277,"_23429":67187,"_5":16198,"_30870":67006,"_3543":67188},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_4098":3335,"_34307":3277,"_23429":67190,"_5":16198,"_30870":67006,"_3543":67191},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_4098":3336,"_34307":3277,"_23429":67193,"_5":16198,"_30870":67006,"_3543":67194},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_4098":3337,"_34307":3277,"_23429":67196,"_5":16198,"_30870":67006,"_3543":67197},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_4098":3338,"_34307":3277,"_23429":67199,"_5":16198,"_30870":67006,"_3543":67200},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_4098":3339,"_34307":3277,"_23429":67202,"_5":16198,"_30870":67010,"_3543":67203},[],"Change",{"_4098":3340,"_34307":3277,"_23429":67205,"_5":16198,"_30870":67010,"_3543":67206},[],"Who is affected",{"_4098":3341,"_34307":3277,"_23429":67208,"_5":16198,"_30870":67010,"_3543":67209},[],"Severity",{"_4098":3342,"_34307":3277,"_23429":67211,"_5":16198,"_30870":67010,"_3543":63766},[],{"_4098":3343,"_34307":3277,"_23429":67213,"_5":16198,"_30870":67010,"_3543":67019},[],{"_4098":3344,"_34307":3277,"_23429":67215,"_5":16198,"_30870":67010,"_3543":67216},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_4098":3345,"_34307":3277,"_23429":67218,"_5":16198,"_30870":67010,"_3543":67219},[],"High: KMS and VA start on empty volumes",{"_4098":3346,"_34307":3277,"_23429":67221,"_5":16198,"_30870":67010,"_3543":67222},[],"Copy the data into the new volumes",{"_4098":3347,"_34307":3277,"_23429":67224,"_5":16198,"_30870":67010,"_3543":67023},[],{"_4098":3348,"_34307":3277,"_23429":67226,"_5":16198,"_30870":67010,"_3543":67227},[],"Every Helm release",{"_4098":3349,"_34307":3277,"_23429":67229,"_5":16198,"_30870":67010,"_3543":67230},[],"High: `helm upgrade` fails",{"_4098":3350,"_34307":3277,"_23429":67232,"_5":16198,"_30870":67010,"_3543":67233},[],"Remove or rename legacy keys",{"_4098":3351,"_34307":3277,"_23429":67235,"_5":16198,"_30870":67010,"_3543":67027},[],{"_4098":3352,"_34307":3277,"_23429":67237,"_5":16198,"_30870":67010,"_3543":67238},[],"Every deployment",{"_4098":3353,"_34307":3277,"_23429":67240,"_5":16198,"_30870":67010,"_3543":67241},[],"High: without a bootstrap principal there is no administrator",{"_4098":3354,"_34307":3277,"_23429":67243,"_5":16198,"_30870":67010,"_3543":67244},[],"Configure `services.authz`",{"_4098":3355,"_34307":3277,"_23429":67246,"_5":16198,"_30870":67010,"_3543":67031},[],{"_4098":3356,"_34307":3277,"_23429":67248,"_5":16198,"_30870":67010,"_3543":67227},[],{"_4098":3357,"_34307":3277,"_23429":67250,"_5":16198,"_30870":67010,"_3543":67251},[],"High: `helm upgrade` fails on the old keys",{"_4098":3358,"_34307":3277,"_23429":67253,"_5":16198,"_30870":67010,"_3543":67254},[],"Move JWKS and roles into `services.authz`",{"_4098":3359,"_34307":3277,"_23429":67256,"_5":16198,"_30870":67010,"_3543":67051},[],{"_4098":3360,"_34307":3277,"_23429":67258,"_5":16198,"_30870":67010,"_3543":67259},[],"3.8.0 deployments with per-service databases",{"_4098":3361,"_34307":3277,"_23429":67261,"_5":16198,"_30870":67010,"_3543":67262},[],"High: services find no data, or a migration aborts",{"_4098":3362,"_34307":3277,"_23429":67264,"_5":16198,"_30870":67010,"_3543":67265},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_4098":3363,"_34307":3277,"_23429":67267,"_5":16198,"_30870":67010,"_3543":67055},[],{"_4098":3364,"_34307":3277,"_23429":67269,"_5":16198,"_30870":67010,"_3543":67270},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_4098":3365,"_34307":3277,"_23429":67272,"_5":16198,"_30870":67010,"_3543":67273},[],"High: the backend no longer starts with them",{"_4098":3366,"_34307":3277,"_23429":67275,"_5":16198,"_30870":67010,"_3543":67276},[],"Move to PostgreSQL before upgrading",{"_4098":3367,"_34307":3277,"_23429":67278,"_5":16198,"_30870":67010,"_3543":67279},[],"Webhooks with file references",{"_4098":3368,"_34307":3277,"_23429":67281,"_5":16198,"_30870":67010,"_3543":67282},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_4098":3369,"_34307":3277,"_23429":67284,"_5":16198,"_30870":67010,"_3543":67285},[],"High: enrollments calling the webhook fail",{"_4098":3370,"_34307":3277,"_23429":67287,"_5":16198,"_30870":67010,"_3543":67288},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_4098":3371,"_34307":3277,"_23429":67290,"_5":16198,"_30870":67010,"_3543":67035},[],{"_4098":3372,"_34307":3277,"_23429":67292,"_5":16198,"_30870":67010,"_3543":67293},[],"Releases with per-service identity overrides or mounted key material",{"_4098":3373,"_34307":3277,"_23429":67295,"_5":16198,"_30870":67010,"_3543":67296},[],"Medium: services cannot read their files",{"_4098":3374,"_34307":3277,"_23429":67298,"_5":16198,"_30870":67010,"_3543":67299},[],"Remove the overrides and fix volume ownership",{"_4098":3375,"_34307":3277,"_23429":67301,"_5":16198,"_30870":67010,"_3543":67039},[],{"_4098":3376,"_34307":3277,"_23429":67303,"_5":16198,"_30870":67010,"_3543":67304},[],"Releases that set `amqp.tls`",{"_4098":3377,"_34307":3277,"_23429":67306,"_5":16198,"_30870":67010,"_3543":67307},[],"Medium: clients connect to the wrong port",{"_4098":3378,"_34307":3277,"_23429":67309,"_5":16198,"_30870":67010,"_3543":67310},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_4098":3379,"_34307":3277,"_23429":67312,"_5":16198,"_30870":67010,"_3543":67059},[],{"_4098":3380,"_34307":3277,"_23429":67314,"_5":16198,"_30870":67010,"_3543":67315},[],"Installations whose CA keys predate the KMS",{"_4098":3381,"_34307":3277,"_23429":67317,"_5":16198,"_30870":67010,"_3543":67318},[],"Medium: CA keys stay unmanaged",{"_4098":3382,"_34307":3277,"_23429":67320,"_5":16198,"_30870":67010,"_3543":67321},[],"Run the CA-to-KMS migration",{"_4098":3383,"_34307":3277,"_23429":67323,"_5":16198,"_30870":67010,"_3543":67324},[],"Receiver certificate verification",{"_4098":3384,"_34307":3277,"_23429":67326,"_5":16198,"_30870":67010,"_3543":67327},[],"DMSs whose webhook had `validate_server_cert: false`",{"_4098":3385,"_34307":3277,"_23429":67329,"_5":16198,"_30870":67010,"_3543":67330},[],"Medium: credentials go to an unverified receiver",{"_4098":3386,"_34307":3277,"_23429":67332,"_5":16198,"_30870":67010,"_3543":67333},[],"Set `insecure_skip_verify` to `false`",{"_4098":3387,"_34307":3277,"_23429":67335,"_5":16198,"_30870":67010,"_3543":67075},[],{"_4098":3388,"_34307":3277,"_23429":67337,"_5":16198,"_30870":67010,"_3543":67338},[],"Scripts and consoles that edit DMSs through the API",{"_4098":3389,"_34307":3277,"_23429":67340,"_5":16198,"_30870":67010,"_3543":67341},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_4098":3390,"_34307":3277,"_23429":67343,"_5":16198,"_30870":67010,"_3543":67344},[],"Read the DMS before editing and use the new field",{"_4098":3391,"_34307":3277,"_23429":67346,"_5":16198,"_30870":67010,"_3543":67095},[],{"_4098":3392,"_34307":3277,"_23429":67348,"_5":16198,"_30870":67010,"_3543":67349},[],"Clients that create or update VA roles through the API",{"_4098":3393,"_34307":3277,"_23429":67351,"_5":16198,"_30870":67010,"_3543":67352},[],"Medium: requests with the old field return an error",{"_4098":3394,"_34307":3277,"_23429":67354,"_5":16198,"_30870":67010,"_3543":67355},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_certificate_serial_number`",{"_4098":3395,"_34307":3277,"_23429":67357,"_5":16198,"_30870":67010,"_3543":67091},[],{"_4098":3396,"_34307":3277,"_23429":67359,"_5":16198,"_30870":67010,"_3543":67360},[],"Consumers that read the device `events` field",{"_4098":3397,"_34307":3277,"_23429":67362,"_5":16198,"_30870":67010,"_3543":67363},[],"Medium: the field disappears",{"_4098":3398,"_34307":3277,"_23429":67365,"_5":16198,"_30870":67010,"_3543":67366},[],"Use the new event endpoints",{"_4098":3399,"_34307":3277,"_23429":67368,"_5":16198,"_30870":67010,"_3543":67043},[],{"_4098":3400,"_34307":3277,"_23429":67370,"_5":16198,"_30870":67010,"_3543":67371},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_4098":3401,"_34307":3277,"_23429":67373,"_5":16198,"_30870":67010,"_3543":67374},[],"Low to medium: validation errors or changed defaults",{"_4098":3402,"_34307":3277,"_23429":67376,"_5":16198,"_30870":67010,"_3543":67377},[],"Update the values file",{"_4098":3403,"_34307":3277,"_23429":67379,"_5":16198,"_30870":67010,"_3543":67083},[],{"_4098":3404,"_34307":3277,"_23429":67381,"_5":16198,"_30870":67010,"_3543":67382},[],"Clients that send the DMS ID in the update body",{"_4098":3405,"_34307":3277,"_23429":67384,"_5":16198,"_30870":67010,"_3543":67385},[],"Low: the ID in the URL wins",{"_4098":3406,"_34307":3277,"_23429":67387,"_5":16198,"_30870":67010,"_3543":67388},[],"Send the ID in the URL",{"_4098":3407,"_34307":3277,"_23429":67390,"_5":16198,"_30870":67010,"_3543":67087},[],{"_4098":3408,"_34307":3277,"_23429":67392,"_5":16198,"_30870":67010,"_3543":67393},[],"Consumers that match on certificate `type`",{"_4098":3409,"_34307":3277,"_23429":67395,"_5":16198,"_30870":67010,"_3543":67396},[],"Low: two values are renamed",{"_4098":3410,"_34307":3277,"_23429":67398,"_5":16198,"_30870":67010,"_3543":67399},[],"Adapt consumers",{"_4098":3411,"_34307":3277,"_23429":67401,"_5":16198,"_30870":67010,"_3543":67079},[],{"_4098":3412,"_34307":3277,"_23429":67403,"_5":16198,"_30870":67010,"_3543":67404},[],"Any DMS",{"_4098":3413,"_34307":3277,"_23429":67406,"_5":16198,"_30870":67010,"_3543":67407},[],"Low: informational",{"_4098":3414,"_34307":3277,"_23429":67409,"_5":16198,"_30870":67010,"_3543":67410},[],"Read both blocks before editing",{"_4098":3415,"_34307":3277,"_23429":67412,"_5":16198,"_30870":67018,"_3543":67413},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_4098":3416,"_34307":3277,"_23429":67415,"_5":16198,"_30870":67018,"_3543":67416},[],"Step 4 of the migration guide copies the data.",{"_4098":3417,"_34307":3277,"_23429":67418,"_5":16198,"_30870":67022,"_3543":67419},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_4098":3418,"_34307":3277,"_23429":67421,"_5":16198,"_30870":67026,"_3543":67422},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_4098":3419,"_34307":3277,"_23429":67424,"_5":16198,"_30870":67030,"_3543":67425},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_4098":3420,"_34307":3277,"_23429":67427,"_5":16198,"_30870":67034,"_3543":67428},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_4098":3421,"_34307":3277,"_23429":67430,"_5":16198,"_30870":67034,"_3543":67431},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_4098":3422,"_34307":3277,"_23429":67433,"_5":16198,"_30870":67038,"_3543":67434},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_4098":3423,"_34307":3277,"_23429":67436,"_5":16198,"_30870":67042,"_3543":67437},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_4098":3424,"_34307":3277,"_23429":67439,"_5":16198,"_30870":67042,"_3543":67440},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_4098":3425,"_34307":3277,"_23429":67442,"_5":16198,"_30870":67042,"_3543":67443},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_4098":3426,"_34307":3277,"_23429":67445,"_5":16198,"_30870":67042,"_3543":67446},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_4098":3427,"_34307":3277,"_23429":67448,"_5":16198,"_30870":67042,"_3543":67449},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_4098":3428,"_34307":3277,"_23429":67451,"_5":16198,"_30870":67042,"_3543":67452},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_4098":3429,"_34307":3277,"_23429":67454,"_5":16198,"_30870":67050,"_3543":67455},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_4098":3430,"_34307":3277,"_23429":67457,"_5":16198,"_30870":67050,"_3543":67458},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_4098":3431,"_34307":3277,"_23429":67460,"_5":16198,"_30870":67050,"_3543":67461},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_4098":3432,"_34307":3277,"_23429":67463,"_5":16198,"_30870":67050,"_3543":67464},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_4098":3433,"_34307":3277,"_23429":67466,"_5":16198,"_30870":67050,"_3543":67467},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_4098":3434,"_34307":3277,"_23429":67469,"_5":16198,"_30870":67054,"_3543":67470},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_4098":3435,"_34307":3277,"_23429":67472,"_5":16198,"_30870":67058,"_3543":67473},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_4098":3436,"_34307":3277,"_23429":67475,"_5":16198,"_30870":67058,"_3543":67476},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_4098":3437,"_34307":3277,"_23429":67478,"_5":16198,"_30870":67058,"_3543":67479},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_4098":3438,"_34307":3277,"_23429":67481,"_5":16198,"_30870":67058,"_3543":67482},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_4098":3439,"_34307":3277,"_23429":67484,"_5":16198,"_30870":67058,"_3543":67485},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_4098":3440,"_34307":3277,"_23429":67487,"_5":16198,"_30870":67058,"_3543":67488},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_4098":3441,"_34307":3277,"_23429":67490,"_5":16198,"_30870":67058,"_3543":67491},[],"Once legacy keys are registered, starting the KMS with the backend configuration option `crypto_engines.migrate_keys_format` renames keys whose name is not the public-key SHA-256 digest, keeps the old name as an alias and moves certificate references along. It is safe to re-run and can be disabled afterwards.",{"_4098":3442,"_34307":3277,"_23429":67493,"_5":16198,"_30870":67062,"_3543":67494},[],"Certificates now reference their KMS key, and VA roles reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_4098":3443,"_34307":3277,"_23429":67496,"_5":16198,"_30870":67070,"_3543":67497},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_4098":3444,"_34307":3277,"_23429":67499,"_5":16198,"_30870":67070,"_3543":67500},[],"Field in 3.8.0",{"_4098":3445,"_34307":3277,"_23429":67502,"_5":16198,"_30870":67070,"_3543":67503},[],"Field in 4.0.0",{"_4098":3446,"_34307":3277,"_23429":67505,"_5":16198,"_30870":67070,"_3543":67506},[],"`validate_server_cert`",{"_4098":3447,"_34307":3277,"_23429":67508,"_5":16198,"_30870":67070,"_3543":67509},[],"`insecure_skip_verify` (value negated)",{"_4098":3448,"_34307":3277,"_23429":67511,"_5":16198,"_30870":67070,"_3543":67512},[],"`oidc`",{"_4098":3449,"_34307":3277,"_23429":67514,"_5":16198,"_30870":67070,"_3543":67515},[],"`jwt_options`",{"_4098":3450,"_34307":3277,"_23429":67517,"_5":16198,"_30870":67070,"_3543":67518},[],"`apikey`",{"_4098":3451,"_34307":3277,"_23429":67520,"_5":16198,"_30870":67070,"_3543":67521},[],"`apikey_options`",{"_4098":3452,"_34307":3277,"_23429":67523,"_5":16198,"_30870":67070,"_3543":67524},[],"`mtls`",{"_4098":3453,"_34307":3277,"_23429":67526,"_5":16198,"_30870":67070,"_3543":67527},[],"`mtls_options`",{"_4098":3454,"_34307":3277,"_23429":67529,"_5":16198,"_30870":67070,"_3543":67530},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_4098":3455,"_34307":3277,"_23429":67532,"_5":16198,"_30870":67070,"_3543":67533},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_4098":3456,"_34307":3277,"_23429":67535,"_5":16198,"_30870":67070,"_3543":67536},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_4098":3457,"_34307":3277,"_23429":67538,"_5":16198,"_30870":67074,"_3543":67539},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_4098":3458,"_34307":3277,"_23429":67541,"_5":16198,"_30870":67074,"_3543":67542},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_4098":3459,"_34307":3277,"_23429":67544,"_5":16198,"_30870":67074,"_3543":67545},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_4098":3460,"_34307":3277,"_23429":67547,"_5":16198,"_30870":67078,"_3543":67548},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_4098":3461,"_34307":3277,"_23429":67550,"_5":16198,"_30870":67082,"_3543":67551},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_4098":3462,"_34307":3277,"_23429":67553,"_5":16198,"_30870":67086,"_3543":67554},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_4098":3463,"_34307":3277,"_23429":67556,"_5":16198,"_30870":67090,"_3543":67557},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_4098":3464,"_34307":3277,"_23429":67559,"_5":16198,"_30870":67090,"_3543":67560},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_4098":3465,"_34307":3277,"_23429":67562,"_5":16198,"_30870":67090,"_3543":67563},[],"`POST /v1/devices/:id/events` creates an event.",{"_4098":3466,"_34307":3277,"_23429":67565,"_5":16198,"_30870":67090,"_3543":67566},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_4098":3467,"_34307":3277,"_23429":67568,"_5":16198,"_30870":67094,"_3543":67569},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_certificate_serial_number`, the serial number of the existing certificate that signs the CRL. A new role's initial value is the CA's current certificate serial number. Requests that still carry `subject_key_id_signer` return an error. Custom authorization policies that filter on the old field must be updated: the filter `crl_subject_key_id_signer` is renamed to `crl_signer_certificate_serial_number` and takes serial-number values.",{"_4098":3468,"_34307":3277,"_23429":67571,"_5":16198,"_30870":67098,"_3543":67572},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_4098":3469,"_34307":3277,"_23429":67574,"_5":16198,"_30870":67102,"_3543":67575},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_4098":3470,"_34307":3277,"_23429":67577,"_5":16198,"_30870":67102,"_3543":67578},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_4098":3471,"_34307":3277,"_23429":67580,"_5":16198,"_30870":67102,"_3543":67581},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_4098":3472,"_34307":3277,"_23429":67583,"_5":16198,"_30870":67102,"_3543":67584},[],"Record the names of your local-storage PVCs:",{"_4098":3473,"_34307":3277,"_23429":67586,"_5":16198,"_30870":67102,"_3543":67587},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_4098":3474,"_34307":3277,"_23429":67589,"_5":16198,"_30870":67106,"_3543":67590},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_4098":3475,"_34307":3277,"_23429":67592,"_5":16198,"_30870":67106,"_3543":67593},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_4098":3476,"_34307":3277,"_23429":67595,"_5":16198,"_30870":67106,"_3543":67596},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_4098":3477,"_34307":3277,"_23429":67598,"_5":16198,"_30870":67106,"_3543":67599},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_4098":3478,"_34307":3277,"_23429":67601,"_5":16198,"_30870":67106,"_3543":67602},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_4098":3479,"_34307":3277,"_23429":67604,"_5":16198,"_30870":67106,"_3543":67605},[],"**Rename `toolbox` to `connectivityTest`:**",{"_4098":3480,"_34307":3277,"_23429":67607,"_5":16198,"_30870":67106,"_3543":67608},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_4098":3481,"_34307":3277,"_23429":67610,"_5":16198,"_30870":67106,"_3543":67611},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_4098":3482,"_34307":3277,"_23429":67613,"_5":16198,"_30870":67106,"_3543":67614},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_4098":3483,"_34307":3277,"_23429":67616,"_5":16198,"_30870":67106,"_3543":67617},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_4098":3484,"_34307":3277,"_23429":67619,"_5":16198,"_30870":67106,"_3543":67620},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_4098":3485,"_34307":3277,"_23429":67622,"_5":16198,"_30870":67106,"_3543":67623},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_4098":3486,"_34307":3277,"_23429":67625,"_5":16198,"_30870":67110,"_3543":67626},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_4098":3487,"_34307":3277,"_23429":67628,"_5":16198,"_30870":67110,"_3543":67629},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_4098":3488,"_34307":3277,"_23429":67631,"_5":16198,"_30870":67114,"_3543":67632},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_4098":3489,"_34307":3277,"_23429":67634,"_5":16198,"_30870":67114,"_3543":67635},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_4098":3490,"_34307":3277,"_23429":67637,"_5":16198,"_30870":67114,"_3543":67638},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_4098":3491,"_34307":3277,"_23429":67640,"_5":16198,"_30870":67114,"_3543":67641},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_4098":3492,"_34307":3277,"_23429":67643,"_5":16198,"_30870":67114,"_3543":67644},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_4098":3493,"_34307":3277,"_23429":67646,"_5":16198,"_30870":67114,"_3543":67647},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_4098":3494,"_34307":3277,"_23429":67649,"_5":16198,"_30870":67114,"_3543":67650},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_4098":3495,"_34307":3277,"_23429":67652,"_5":16198,"_30870":67114,"_3543":67653},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_4098":3496,"_34307":3277,"_23429":67655,"_5":16198,"_30870":67114,"_3543":67656},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_4098":3497,"_34307":3277,"_23429":67658,"_5":16198,"_30870":67114,"_3543":67659},[],"**Remove the helper and restore the recorded replica counts:**",{"_4098":3498,"_34307":3277,"_23429":67661,"_5":16198,"_30870":67114,"_3543":67662},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_4098":3499,"_34307":3277,"_23429":67664,"_5":16198,"_30870":67118,"_3543":67665},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_4098":3500,"_34307":3277,"_23429":67667,"_5":16198,"_30870":67118,"_3543":67668},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_4098":3501,"_34307":3277,"_23429":67670,"_5":16198,"_30870":67122,"_3543":67671},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_4098":3502,"_34307":3277,"_23429":67673,"_5":16198,"_30870":67122,"_3543":67674},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_4098":3503,"_34307":3277,"_23429":67676,"_5":16198,"_30870":67122,"_3543":67677},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates`. If your services connect with a different user than the one that ran the migrations, grant that user `SELECT` on `ca.certificates_view` after the migrations.",{"_4098":3504,"_34307":3277,"_23429":67679,"_5":16198,"_30870":67122,"_3543":67680},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_4098":3505,"_34307":3277,"_23429":67682,"_5":16198,"_30870":67122,"_3543":67683},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_4098":3506,"_34307":3277,"_23429":67685,"_5":16198,"_30870":67122,"_3543":67686},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_4098":3507,"_34307":3277,"_23429":67688,"_5":16198,"_30870":67122,"_3543":67689},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_4098":3508,"_34307":3277,"_23429":67691,"_5":16198,"_30870":67126,"_3543":67692},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_4098":3509,"_34307":3277,"_23429":67694,"_5":16198,"_30870":67126,"_3543":67695},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_4098":3510,"_34307":3277,"_23429":67697,"_5":16198,"_30870":67126,"_3543":67698},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_4098":3511,"_34307":3277,"_23429":67700,"_5":16198,"_30870":67126,"_3543":67701},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_4098":3512,"_34307":3277,"_23429":67703,"_5":16198,"_30870":67126,"_3543":67704},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_4098":3513,"_34307":3277,"_23429":67706,"_5":16198,"_30870":67126,"_3543":67707},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_4098":3514,"_34307":3277,"_23429":67709,"_5":16198,"_30870":67126,"_3543":67710},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_4098":3515,"_34307":3277,"_23429":67712,"_5":16198,"_30870":67126,"_3543":67713},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` schema migration.",{"_4098":3516,"_34307":3277,"_23429":67715,"_5":16198,"_30870":67126,"_3543":67716},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_4098":3517,"_34307":3277,"_23429":67718,"_5":16198,"_30870":67126,"_3543":67719},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_certificate_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_4098":3518,"_34307":3277,"_23429":67721,"_5":16198,"_30870":67126,"_3543":67722},[],"**A migration or service fails with `permission denied for table ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped. Grant the missing privileges and re-run.",{"_4098":3519,"_34307":3277,"_23429":67724,"_5":16198,"_30870":67129,"_3543":67725},[],"After the upgrade, check in this order:",{"_4098":3520,"_34307":3277,"_23429":67727,"_5":16198,"_30870":67129,"_3543":67728},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_4098":3521,"_34307":3277,"_23429":67730,"_5":16198,"_30870":67129,"_3543":67731},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_4098":3522,"_34307":3277,"_23429":67733,"_5":16198,"_30870":67129,"_3543":67734},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_4098":3523,"_34307":3277,"_23429":67736,"_5":16198,"_30870":67129,"_3543":67737},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_4098":3524,"_34307":3277,"_23429":67739,"_5":16198,"_30870":67129,"_3543":67740},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_4098":3525,"_34307":3277,"_23429":67742,"_5":16198,"_30870":67129,"_3543":67743},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_4098":3526,"_34307":3277,"_23429":67745,"_5":16198,"_30870":67129,"_3543":67746},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_4098":3527,"_34307":3277,"_23429":67748,"_5":16198,"_30870":67129,"_3543":67749},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_4098":3528,"_34307":3277,"_23429":67751,"_5":16198,"_30870":67129,"_3543":67752},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_4098":3529,"_34307":3277,"_23429":67754,"_5":16198,"_30870":67129,"_3543":67755},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_4098":3530,"_34307":3277,"_23429":67757,"_5":16198,"_30870":67129,"_3543":67758},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_4098":3531,"_34307":3277,"_23429":67760,"_5":16198,"_30870":67129,"_3543":67761},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_4098":3532,"_34307":3277,"_23429":67763,"_5":16198,"_30870":67129,"_3543":67764},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_4098":3533,"_34307":3277,"_23429":67766,"_5":16198,"_30870":67129,"_3543":67767},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_4098":3534,"_34307":3277,"_23429":67769,"_5":16198,"_30870":67133,"_3543":67770},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_4098":3535,"_34307":3277,"_23429":67772,"_5":16198,"_30870":67133,"_3543":67773},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_4098":3536,"_34307":3277,"_23429":67775,"_5":16198,"_30870":67133,"_3543":67776},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_4098":3537,"_34307":3277,"_23429":67778,"_5":16198,"_30870":67133,"_3543":67779},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_4098":3538,"_34307":3277,"_23429":67781,"_5":16198,"_30870":67133,"_3543":67782},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_67785":20189,"_67786":67787,"_67788":67789,"_67790":67791,"_20308":3560,"_81901":3560},"language","sortableProperties",[3543,34307,5,30870],"sortablePropertiesWithTypes",{"_3543":28013,"_34307":28013,"_5":28013,"_30870":28013},"sorts",{"_3543":67792,"_34307":71320,"_5":74847,"_30870":78374},{"_5377":67793,"_67794":67795,"_5":28013},{"_11645":20671,"_11806":11678,"_11743":25466,"_11596":15021,"_11935":5498,"_11605":8547,"_11636":6210,"_11617":8595,"_29450":19266,"_33356":4011,"_33390":8611,"_32852":8311,"_33456":3835,"_33039":27825,"_33462":6624,"_33424":34322,"_33468":16249,"_33473":20036,"_33414":5458,"_34051":27203,"_39285":3895,"_39287":26470,"_34095":12743,"_16755":24601,"_34075":7912,"_39293":21113,"_34104":5736,"_29434":8602,"_34046":12884,"_34122":5118,"_34164":3681,"_39300":5352,"_39302":7615,"_33056":3657,"_39305":5922,"_34193":6929,"_34181":3939,"_34154":4318,"_34187":7933,"_32921":14500,"_32969":6097,"_32975":4292,"_32981":9423,"_11599":18641,"_32987":5208,"_32993":9933,"_39319":3667,"_32963":7927,"_32999":8361,"_32811":5895,"_39325":3670,"_32857":3781,"_32879":7777,"_32885":5805,"_39331":12122,"_16745":6550,"_39334":20088,"_34377":8633,"_39338":31209,"_34225":5462,"_3934